{
  "mode": "local",
  "local": {
    "board_dir": ".task-board"
  },
  "version_control": {
    "confirm": true,
    "desired_commit_time": "current real time; AX does not backdate commits"
  },
  "spawn": {
    "enabled": true,
    "max_parallel": 20,
    "ceilings": {
      "contract_version": "spawn-policy-v4",
      "codex": {
        "entries": [
          {
            "criterion": "equal",
            "model": "gpt-5.6-sol",
            "reasoning_effort": "high"
          }
        ],
        "resolution_model": "gpt-5.6-sol",
        "adjustment_confirmation": "none",
        "fast_mode": true
      }
    },
    "preferred_agentic_system": {
      "exclusive": "codex"
    },
    "workload_classes": {
      "unified": [
        {
          "runtime": "codex",
          "model": "gpt-5.6-sol",
          "reasoning_effort": "high"
        }
      ],
      "architecture": [
        {
          "runtime": "codex",
          "model": "gpt-5.6-sol",
          "reasoning_effort": "high"
        }
      ],
      "implementation": [
        {
          "runtime": "codex",
          "model": "gpt-5.6-sol",
          "reasoning_effort": "high"
        }
      ],
      "mechanical": [
        {
          "runtime": "codex",
          "model": "gpt-5.6-sol",
          "reasoning_effort": "high"
        }
      ],
      "debugging": [
        {
          "runtime": "codex",
          "model": "gpt-5.6-sol",
          "reasoning_effort": "high"
        }
      ],
      "testing": [
        {
          "runtime": "codex",
          "model": "gpt-5.6-sol",
          "reasoning_effort": "high"
        }
      ],
      "review": [
        {
          "runtime": "codex",
          "model": "gpt-5.6-sol",
          "reasoning_effort": "high"
        }
      ],
      "research": [
        {
          "runtime": "codex",
          "model": "gpt-5.6-sol",
          "reasoning_effort": "high"
        }
      ],
      "documentation": [
        {
          "runtime": "codex",
          "model": "gpt-5.6-sol",
          "reasoning_effort": "high"
        }
      ],
      "migration": [
        {
          "runtime": "codex",
          "model": "gpt-5.6-sol",
          "reasoning_effort": "high"
        }
      ],
      "operations": [
        {
          "runtime": "codex",
          "model": "gpt-5.6-sol",
          "reasoning_effort": "high"
        }
      ]
    },
    "worktree_isolation": {
      "validation": {
        "commands": [
          "test -z \"$(gofmt -l .)\"",
          "go build ./...",
          "go vet ./...",
          "go test ./... -count=1 -v",
          "go test ./... -race -count=1",
          "go test ./... -cover -count=1",
          "go run ./internal/traceability/cmd/tracecheck",
          "tmp=$(mktemp); cp internal/catalog/catalog_gen.go \"$tmp\"; go generate ./internal/catalog && diff -q \"$tmp\" internal/catalog/catalog_gen.go; rc=$?; rm -f \"$tmp\"; exit $rc",
          "GOOS=linux GOARCH=amd64 go build ./...",
          "GOOS=windows GOARCH=amd64 go build ./...",
          "git ls-files -z '*.json' | xargs -0 -n1 python3 -c 'import json,sys;json.load(open(sys.argv[1]))'",
          "task-board validate",
          "git diff --check"
        ]
      }
    }
  },
  "features": {
    "agent_context": {
      "enabled": true,
      "profile": "full"
    },
    "context_sharing": {
      "enabled": false
    },
    "primary_session_goals": {
      "enabled": true
    },
    "spawned_run_goals": {
      "enabled": true
    }
  }
}
