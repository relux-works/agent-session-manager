+// MembershipOf returns the currently indexed namespace for a digest, if any.
+func (index *Index) MembershipOf(id scalar.Digest) (string, bool) {
+	index.mu.RLock()
+	defer index.mu.RUnlock()
+	namespace, ok := index.locations[id.String()]
+	return namespace, ok
+}
