+type recordingSource struct {
+	index *Index
+	calls int
+}
+
+func (source *recordingSource) ObjectsGet(line []byte, namespace string, maxLineBytes uint64) ([]byte, error) {
+	source.calls++
+	return source.index.ObjectsGet(line, namespace, maxLineBytes)
+}
