+		{Epoch: 1, LeaseID: "bbbbbbbb-cccc-4ddd-8eee-ffffffffffff"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("LeaseHeadsForSession() = %#v, want both literal §5.3 tuples %#v", got, want)
