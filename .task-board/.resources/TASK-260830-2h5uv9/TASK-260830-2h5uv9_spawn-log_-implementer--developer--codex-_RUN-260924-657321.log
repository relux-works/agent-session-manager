diff --git a/internal/merkleinventory/sync_rework_test.go b/internal/merkleinventory/sync_rework_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..39997578c64b1d5184d9becfee9d07f2f7dba8e2
--- /dev/null
