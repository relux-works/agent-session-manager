diff --git a/internal/merkleinventory/sync_rework_test.go b/internal/merkleinventory/sync_rework_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..a5f575f6eaf62fc4e88f9224d1437116afc723bf
--- /dev/null
