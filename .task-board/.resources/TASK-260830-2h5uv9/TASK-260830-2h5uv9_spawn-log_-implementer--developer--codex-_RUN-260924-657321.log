	seedSyncPropertyMask(t, local, objects, (1<<len(objects))-1, order, false, 0, "partial local")
	seedSyncPropertyMask(t, peer, objects, 0b000101, order, false, 0, "partial peer")
	before := snapshotDurableStore(t, local.root)
