+func TestNoUnjustifiedTestSkips(t *testing.T) {
+	root := os.Getenv("MERKLE_TEST_SKIP_SCAN_DIR")
+	if root == "" {
+		root = "."
+	}
+	violations, err := unallowedTestSkips(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(violations) != 0 {
+		t.Fatalf("unallowlisted test skips: %s", strings.Join(violations, "; "))
+	}
+}
