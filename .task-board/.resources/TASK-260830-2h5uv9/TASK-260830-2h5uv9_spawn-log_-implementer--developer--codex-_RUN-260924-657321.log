+	}
 	for _, tc := range cases {
 		tc := tc
 		name := fmt.Sprintf("N%d/skew%d/order%03d/duplicate%t/gap%d/peer%02x", tc.size, tc.skew, tc.orderIndex, tc.duplicate, tc.gapTarget, tc.peerMask)
