+		{
+			name:     "WSL2 uses Linux layout",
+			platform: scalar.PlatformWSL2,
+			environment: map[string]string{
+				"XDG_RUNTIME_DIR": "/run/user/1000",
+			},
+			home:    "/home/test",
+			temp:    "/tmp",
