+	info, err := inputs.Stat(parent)
+	if err != nil {
+		if errors.Is(err, fs.ErrNotExist) {
+			return Snapshot{}, &Error{
+				Operation: "stat selected file parent",
+				Class:     ConfigFile,
+				Source:    selected.Source,
+				Err:       ErrConfigParentNotFound,
+			}
