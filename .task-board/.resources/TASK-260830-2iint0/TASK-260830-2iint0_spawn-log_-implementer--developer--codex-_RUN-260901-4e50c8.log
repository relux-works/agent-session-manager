+			Operation: "stat selected file parent",
+			Class:     ConfigFile,
+			Source:    selected.Source,
+			Err:       ErrConfigParentNotDirectory,
+		}
+	}
+	return Snapshot{
+		paths:         ResolvedPaths{values: paths.All()},
+		configPresent: false,
+	}, nil
