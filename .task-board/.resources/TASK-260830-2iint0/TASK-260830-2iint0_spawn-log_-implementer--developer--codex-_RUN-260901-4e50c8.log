+func loadAbsentConfig(inputs Inputs, paths ResolvedPaths, selected ResolvedPath) (Snapshot, error) {
+	parent, err := configParent(inputs.Platform, selected.Value.String())
+	if err != nil {
+		return Snapshot{}, &Error{
