+		t.Fatalf("run(-section 3.2) output = %q, want assigned_scopes=1", output.String())
+	}
+}
+
+func TestRunDoesNotOverclaimWholeConfigLoadingSection(t *testing.T) {
+	t.Parallel()
+
+	repositoryRoot := filepath.Join("..", "..", "..", "..")
+	var output bytes.Buffer
+	err := run([]string{"-root", repositoryRoot, "-section", "6.1"}, &output)
+	want := `assigned section "6.1" binding "section:6.1" has no scoped implementation owner`
+	if err == nil || !strings.Contains(err.Error(), want) || output.Len() != 0 {
+		t.Fatalf("run(-section 6.1) error = %v output = %q, want refusal %q", err, output.String(), want)
 	}
 }
 
