+#!/bin/zsh
+set -u
+
+script_dir="${0:A:h}"
+source_root="${script_dir:h:h}"
+run_root="$script_dir/mutant-rework"
+summary="$script_dir/mutation-rework-results.log"
+loader_source="$source_root/internal/config/loader.go"
+mutant_loader="$run_root/internal/config/loader.go"
+survivors=0
+
+rm -rf "$run_root"
+mkdir -p "$run_root"
+cp "$source_root/go.mod" "$run_root/go.mod"
+cp "$source_root/go.sum" "$run_root/go.sum"
+cp -R "$source_root/internal" "$run_root/internal"
+: > "$summary"
+
+reset_loader() {
+  cp "$loader_source" "$mutant_loader"
+}
+
+require_marker() {
+  local marker="$1"
+  if ! rg -F -q -- "$marker" "$mutant_loader"; then
+    print -r -- "HARNESS_ERROR marker missing: $marker" >> "$summary"
+    exit 2
+  fi
+}
+
+run_mutant() {
+  local name="$1"
+  local test_name="$2"
+  local log="$script_dir/mutant-${name}.log"
+  (
+    cd "$run_root" || exit 2
+    GOWORK=off go test ./internal/config -run "^${test_name}$" -count=1
+  ) > "$log" 2>&1
+  local exit_code=$?
+  if (( exit_code == 0 )); then
+	print -r -- "SURVIVED $name exit=$exit_code test=$test_name" >> "$summary"
+	survivors=$((survivors + 1))
+  else
+	print -r -- "KILLED $name exit=$exit_code test=$test_name" >> "$summary"
+  fi
+}
+
+for class in DataRoot StateRoot CacheRoot RuntimeRoot; do
+  reset_loader
+  perl -0pi -e "s/if specification\\.Class == ConfigFile \\{/if specification.Class == ConfigFile || specification.Class == $class {/" "$mutant_loader"
+  require_marker "specification.Class == ConfigFile || specification.Class == $class"
+  run_mutant "skip-${class:l}" "TestLoadRefusesWrongOrUnreadableRootKinds"
+done
+
+reset_loader
+perl -0pi -e 's/if !info\.Mode\(\)\.IsRegular\(\) \{/if info.Mode().IsDir() {/' "$mutant_loader"
+require_marker 'if info.Mode().IsDir() {'
+run_mutant "config-isdir-only" "TestLoadRefusesEveryNonRegularConfigKind"
+
+reset_loader
+perl -0pi -e 's/if _, err := scalar\.ParsePlatform\(platform\.String\(\)\); err != nil \{/if _, err := scalar.ParsePlatform(platform.String()); err != nil \&\& false {/' "$mutant_loader"
+require_marker 'err != nil && false'
+run_mutant "osinputs-platform-guard" "TestLoadOSRefusesInvalidRuntimePlatformBeforeReadingOS"
+
+reset_loader
+perl -0pi -e 's/return loadAbsentConfig\(inputs, paths, selected\)/return Snapshot{}, \&Error{Operation: "stat selected file", Class: ConfigFile, Source: selected.Source, Err: ErrConfigParentNotFound}/' "$mutant_loader"
+require_marker 'Operation: "stat selected file", Class: ConfigFile'
+run_mutant "absent-config-rejected" "TestLoadAcceptsAbsentConfigOnlyWhenParentDirectoryExists"
+
+reset_loader
+perl -0pi -e 's/if value := overrides\[specification\.Class\]; value != "" \{/if value, ok := overrides[specification.Class]; ok {/' "$mutant_loader"
+require_marker 'if value, ok := overrides[specification.Class]; ok {'
+run_mutant "empty-flag-set" "TestResolvePathsTreatsEmptyEnvironmentOverridesAsUnset"
+
+reset_loader
+perl -0pi -e 's/if inputs\.Stat == nil \|\| inputs\.ReadFile == nil \{/if inputs.ReadFile == nil {/' "$mutant_loader"
+require_marker 'if inputs.ReadFile == nil {'
+run_mutant "nil-stat-unguarded" "TestLoadRefusesMissingFilesystemFunctions"
+
+reset_loader
+perl -0pi -e 's/if inputs\.Stat == nil \|\| inputs\.ReadFile == nil \{/if inputs.Stat == nil {/' "$mutant_loader"
+require_marker 'if inputs.Stat == nil {'
+run_mutant "nil-readfile-unguarded" "TestLoadRefusesMissingFilesystemFunctions"
+
+reset_loader
+perl -0pi -e 's/Err:       ErrConfigParentNotFound,/Err:       ErrConfigRead,/' "$mutant_loader"
+require_marker 'Operation: "stat selected file parent"'
+run_mutant "missing-parent-collapsed" "TestLoadDistinguishesAbsenceFromReadFailureAndWrongKind"
+
+reset_loader
+perl -0pi -e 's/if !info\.IsDir\(\) \{/if false \&\& !info.IsDir() {/' "$mutant_loader"
+require_marker 'if false && !info.IsDir() {'
+run_mutant "parent-kind-disabled" "TestLoadDistinguishesAbsenceFromReadFailureAndWrongKind"
+
+reset_loader
+perl -0pi -e 's/configPresent: true,/configPresent: false,/' "$mutant_loader"
+require_marker 'document:      append([]byte(nil), document...),'
+run_mutant "existing-presence-lost" "TestLoadAppliesPathPrecedenceAtProductionEntry"
+
+reset_loader
+perl -0pi -e 's/configPresent: false,/configPresent: true,/' "$mutant_loader"
+require_marker 'configPresent: true,'
+run_mutant "absent-presence-forged" "TestLoadAcceptsAbsentConfigOnlyWhenParentDirectoryExists"
+
+reset_loader
+perl -0pi -e 's/case "\.\.":\n\s+if len\(segments\) == 0 \{\n\s+return "", ErrInvalidContext\n\s+\}/case "..":\n\t\t\tif len(segments) == 0 {\n\t\t\t\tcontinue\n\t\t\t}/' "$mutant_loader"
+require_marker $'\t\t\t\tcontinue'
+run_mutant "windows-above-root" "TestResolvePathsRefusesWindowsTraversalAboveRoot"
+
+print -r -- "survivors=$survivors total=15" >> "$summary"
+if (( survivors != 0 )); then
+  exit 1
+fi
