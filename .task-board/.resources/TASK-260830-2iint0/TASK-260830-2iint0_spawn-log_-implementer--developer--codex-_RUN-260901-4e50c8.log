+	}
+	if !reflect.DeepEqual(snapshot.Document(), wantDocument) {
+		t.Fatalf("LoadOS().Document() = %q, want %q", snapshot.Document(), wantDocument)
+	}
+	for _, specification := range OverrideRegistry() {
