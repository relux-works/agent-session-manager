+			test.setup(files)
+			inputs := fixtureInputs(scalar.PlatformMacOS, map[string]string{
+				"AX_CONFIG":      "/config/config.toml",
+				"AX_DATA_DIR":    "/data",
+				"AX_STATE_DIR":   "/state",
+				"AX_CACHE_DIR":   "/cache",
+				"AX_RUNTIME_DIR": "/runtime",
+			}, files)
+			_, err := Load(inputs, nil)
+			if !errors.Is(err, test.want) {
+				t.Fatalf("Load() error = %v, want %v", err, test.want)
+			}
+		})
+	}
+}
