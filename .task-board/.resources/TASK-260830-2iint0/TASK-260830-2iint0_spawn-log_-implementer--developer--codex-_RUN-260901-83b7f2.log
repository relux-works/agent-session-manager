+				files.regular["/data"] = []byte("not a directory")
+			},
+			want: ErrRootNotDirectory,
+		},
+		{
+			name: "root stat failure is not treated as absent",
+			setup: func(files *fakeFileSystem) {
+				files.statErrors["/state"] = fs.ErrPermission
+			},
+			want: ErrRootInspect,
+		},
+	}
+
+	for _, test := range tests {
+		test := test
+		t.Run(test.name, func(t *testing.T) {
