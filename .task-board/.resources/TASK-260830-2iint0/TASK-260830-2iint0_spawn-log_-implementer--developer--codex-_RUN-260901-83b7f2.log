+		},
+		{
+			name: "Linux runtime default unavailable",
+			inputs: Inputs{
+				Platform:   scalar.PlatformLinux,
+				HomeDir:    "/home/test",
+				TempDir:    "/tmp",
+				WorkingDir: "/work",
