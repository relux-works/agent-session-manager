+func TestLoadErrorsDoNotEchoSelectedPathValues(t *testing.T) {
+	t.Parallel()
+
+	files := newFakeFileSystem()
+	files.statErrors["/machine/private/config.toml"] = &fs.PathError{
+		Op:   "stat",
