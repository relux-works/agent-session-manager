+			_, err := Load(inputs, nil)
+			if !errors.Is(err, test.want) {
+				t.Fatalf("Load() error = %v, want %v", err, test.want)
+			}
+			if test.want != ErrConfigNotFound && errors.Is(err, ErrConfigNotFound) {
+				t.Fatalf("Load() collapsed %v into absence", test.want)
+			}
+		})
