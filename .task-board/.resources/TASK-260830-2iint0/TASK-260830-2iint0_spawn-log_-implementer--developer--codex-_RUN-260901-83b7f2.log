new file mode 100644
index 0000000000000000000000000000000000000000..b7493277ecb96f97c71dc6df294b325c3c229307
--- /dev/null
+++ b/internal/config/loader_test.go
@@ -0,0 +1,706 @@
+package config
+
+import (
+	"errors"
+	"io/fs"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/relux-works/agent-session-manager/internal/scalar"
+)
