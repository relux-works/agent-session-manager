+func TestResolvePathsRefusesUnknownClassesAndInvalidContext(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name   string
+		inputs Inputs
+		flags  Overrides
+		want   error
+	}{
+		{
+			name:   "unknown override class",
