+func TestResolvePathsNeverEnumeratesOrPassesThroughAmbientSecrets(t *testing.T) {
+	t.Parallel()
+
+	allowed := map[string]string{
+		"AX_CONFIG":      "/config/config.toml",
+		"AX_DATA_DIR":    "/data",
+		"AX_STATE_DIR":   "/state",
