+				DataRoot:    "C:\\Users\\test\\AppData\\Local\\ax\\data",
+				StateRoot:   "C:\\Users\\test\\AppData\\Local\\ax\\state",
+				CacheRoot:   "C:\\Users\\test\\AppData\\Local\\ax\\cache",
