{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5db","stream":{"kind":"session","id":"01a07a11-62cd-7c32-94ca-eb83f5233a55"},"sequence":328,"recorded_at":1780531400000651,"record_type":"event","durability":"durable","causation_id":"357c7038-eba4-4a96-b13f-85a78cd24f9a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"357c7038-eba4-4a96-b13f-85a78cd24f9a","run_stream":{"kind":"run","id":"357c7038-eba4-4a96-b13f-85a78cd24f9a"},"task_stream":{"kind":"task","id":"71f7ab7a-411f-42af-ba85-bd1191fef899"},"task_id":"71f7ab7a-411f-42af-ba85-bd1191fef899","event":{"kind":"output","task_id":"71f7ab7a-411f-42af-ba85-bd1191fef899","chunk":"{\n  \"chunk_id\": \"exec-18-1\",\n  \"command\": \"task-board worktree checkpoint --help 2>&1 | head -30; echo \\\"===\\\"; task-board worktree transaction --help 2>&1 | head -30\",\n  \"description\": \"Inspect checkpoint and transaction help\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Checkpoint an accepted Change Request revision.\\n\\nThe accepted candidate tree becomes one internal commit on the Story branch,\\ncreated under a compare-and-swap on the branch tip. The leaf remains integrating:\\nnothing is landed on trunk, and internal checkpoints only delimit later Task\\ndiffs and make the work recoverable before the final Story squash.\\n\\nA Change Request with repository_delta=empty creates no commit — its tree would\\nequal its parent's — and the leaf likewise remains integrating.\\n\\nOnly the tracked integration run bound to the accepted revision's producer role\\nand archetype may run this command. Reviewers, orchestrators, and other producer\\narchetypes are refused.\\n\\nUsage:\\n  task-board worktree checkpoint <ELEMENT-ID> [flags]\\n\\nFlags:\\n  -h, --help   help for checkpoint\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n===\\nThe operator disposition surface for an integration transaction that reached a\\nterminal phase.\\n\\nIt is the ONLY exit from transition_refused and integration_abandoned, and it is\\nforward-only: no command here undoes a landed commit or rewrites trunk.\\n\\nTwo of the three outcomes cannot be obtained by assertion at all. 'resolve\\n--resolution repaired' re-runs the recovery classifier and decides on that, never\\non the operator's claim; 'discharge' recomputes the transaction's own\\npostcondition. Neither --refusal nor the absent-TASK_BOARD_RUN_ID check\\nauthorizes anything — both are caller-supplied guardrails, exactly like\\ncommit_ack and the transition-lease token.\\n\\nUsage:\\n  task-board worktree transaction [command]\\n\\nAvailable Commands:\\n  discharge   Retire an abandoned transaction whose board state has since reached trunk\\n  resolve     Leave transition_refused, by re-verified repair or by explicit abandonment\\n  show        Print an integration transaction, its refusal and the digest to dispose of it\\n\\nFlags:\\n  -h, --help   help for transaction\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n\",\n  \"original_output_bytes\": 2894,\n  \"original_output_tokens\": 724,\n  \"truncated\": false\n}"}}}
