eeOID),\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\tmap[string]string{\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\t\\\\\\\\t\\\\\\\\\\\\\\\"element_id\\\\\\\\\\\\\\\":         req.ElementID,\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\t\\\\\\\\t\\\\\\\\\\\\\\\"evidence_tree_oid\\\\\\\\\\\\\\\":  req.Validation.TreeOID,\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\t\\\\\\\\t\\\\\\\\\\\\\\\"candidate_tree_oid\\\\\\\\\\\\\\\": req.Snapshot.CandidateTreeOID,\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\t})\\\\\\\\n\\\\\\\\t}\\\\\\\\n\\\\\\\\n\\\\\\\\tvar created *Record\\\\\\\\n\\\\\\\\terr := s.withElementLock(req.ElementID, func() error {\\\\\\\\n\\\\\\\\t\\\\\\\\tcurrent, err := s.currentRevisionLocked(req.ElementID)\\\\\\\\n\\\\\\\\t\\\\\\\\tif err != nil {\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\treturn err\\\\\\\\n\\\\\\\\t\\\\\\\\t}\\\\\\\\n\\\\\\\\t\\\\\\\\tif current != req.ExpectedRevision {\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\treturn newError(ErrorRevisionConflict,\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\t\\\\\\\\tfmt.Sprintf(\\\\\\\\\\\\\\\"Change Request CAS failed for %s: expected revision %d, current revision is %d\\\\\\\\\\\\\\\",\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\t\\\\\\\\t\\\\\\\\treq.ElementID, req.ExpectedRevision, current),\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\t\\\\\\\\tmap[string]string{\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\t\\\\\\\\t\\\\\\\\t\\\\\\\\\\\\\\\"element_id\\\\\\\\\\\\\\\":        req.ElementID,\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\t\\\\\\\\t\\\\\\\\t\\\\\\\\\\\\\\\"expected_revision\\\\\\\\\\\\\\\": strconv.Itoa(req.ExpectedRevision),\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\t\\\\\\\\t\\\\\\\\t\\\\\\\\\\\\\\\"current_revision\\\\\\\\\\\\\\\":  strconv.Itoa(current),\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\t\\\\\\\\t})\\\\\\\\n\\\\\\\\t\\\\\\\\t}\\\\\\\\n\\\\\\\\t\\\\\\\\tnext := current + 1\\\\\\\\n\\\\\\\\t\\\\\\\\tnow := s.stamp()\\\\\\\\n\\\\\\\\t\\\\\\\\tinitialState := StateReady\\\\\\\\n\\\\\\\\t\\\\\\\\tif req.Validation != nil && req.Validation.ExitStatus != 0 {\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\t// A known-fail