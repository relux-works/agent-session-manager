{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cfe9","stream":{"kind":"session","id":"01a079e0-55db-79f2-85b0-c8c2e4c1a43f"},"sequence":1615,"recorded_at":1780531400003225,"record_type":"event","durability":"durable","causation_id":"38173c32-e836-4324-8339-ee117e4249f1","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"38173c32-e836-4324-8339-ee117e4249f1","run_stream":{"kind":"run","id":"38173c32-e836-4324-8339-ee117e4249f1"},"task_stream":{"kind":"task","id":"971de8b5-94ac-4c91-88c1-34bca705f40f"},"task_id":"971de8b5-94ac-4c91-88c1-34bca705f40f","event":{"kind":"output","task_id":"971de8b5-94ac-4c91-88c1-34bca705f40f","chunk":"edited\nchanged lines: lines 1282-1385\n--- original\n+++ updated\n@@\n-func assertShadowedLookupsAreCovered(t *testing.T) {\n-\tt.Helper()\n-\n-\tfiles, fileSet := invcore.MustScanProduction(t, \".\")\n-\tmisses := shadowMissSites(t, files, fileSet)\n-\texacts := shadowExactChecks(t, files, fileSet)\n-\tcalls := shadowHelperCalls(files)\n-\n-\t// The miss enumeration and the arm derivation must agree exactly:\n-\t// a miss the analysis cannot see is a bound without a pin.\n-\tderivedLines := map[string]bool{}\n-\tfor _, arm := range deriveRefusalArms(t) {\n-\t\tif arm.detail != \"document members\" {\n-\t\t\tcontinue\n-\t\t}\n-\t\tderivedLines[arm.file+\":\"+strconv.Itoa(arm.line)] = true\n-\t}\n-\tmissLines := map[string]shadowMiss{}\n-\tfor _, miss := range misses {\n-\t\t// All document-members misses live in manifest.go except the\n-\t\t// attach entry's; the file is carried for the join key only.\n-\t\tfor _, production := range files {\n-\t\t\t_ = production\n-\t\t}\n-\t\tmissLines[miss.function+\":\"+strconv.Itoa(miss.line)] = miss\n-\t}\n-\t_ = missLines\n-\tbyLine := map[int]shadowMiss{}\n-\tfor _, miss := range misses {\n-\t\tbyLine[miss.line] = miss\n-\t}\n-\t// Join misses to derived arms by (function, line): every miss must\n-\t// be a derived arm and vice versa.\n-\tderivedByLine := map[string]refusalArm{}\n-\tfor _, arm := range deriveRefusalArms(t) {\n-\t\tif arm.detail != \"document members\" {\n-\t\t\tcontinue\n-\t\t}\n-\t\tderivedByLine[arm.function+\":\"+strconv.Itoa(arm.line)] = arm\n-\t}\n-\tfor _, miss := range misses {\n-\t\tkey := miss.function + \":\" + strconv.Itoa(miss.line)\n-\t\tif _, ok := derivedByLine[key]; !ok {\n-\t\t\tt.Errorf(\"shadow miss %s names no derived refusal arm; the cover analysis sees a site the inventory does not\", key)\n-\t\t}\n-\t}\n-\tfor key := range derivedByLine {\n-\t\tfound := false\n-\t\tfor _, miss := range misses {\n-\t\t\tif miss.function+\":\"+strconv.Itoa(miss.line) == key {\n-\t\t\t\tfound = true\n-\t\t\t}\n-\t\t}\n-\t\tif !found {\n-\t\t\tt.Errorf(\"derived refusal arm %s names no shadow miss; the inventory sees a site the cover analysis does not\", key)\n-\t\t}\n-\t}\n-\n-\t// Row linkage, both directions: covered misses carry bound rows,\n-\t// uncovered misses carry witnessed rows.\n-\trows := declaredRows()\n-\trowByKey := map[string]declaredRefusalArm{}\n-\tfor _, row := range rows {\n-\t\trowByKey[describeRow(row)] = row\n-\t}\n-\tcovered, uncovered := 0, 0\n-\tfor _, miss := range misses {\n-\t\tkey := miss.function + \":\" + strconv.Itoa(miss.line)\n-\t\tarm, ok := derivedByLine[key]\n-\t\tif !ok {\n-\t\t\tcontinue\n-\t\t}\n-\t\trow, known := rowByKey[describeArm(arm)]\n-\t\tif !known {\n-\t\t\tt.Errorf(\"shadow miss %s resolves to no declared row\", key)\n-\t\t\tcontinue\n-\t\t}\n-\t\tmembers := shadowMissMembers(t, files, miss, calls)\n-\t\tisCovered := len(members) > 0 && shadowMembersCovered(t, files, exacts, calls, miss, members, map[string]bool{})\n-\t\tif isCovered {\n-\t\t\tcovered++\n-\t\t\tif row.bound != boundShadowedLookup {\n-\t\t\t\tt.Errorf(\"shadow miss %s is covered but its row carries bound %q, want %q (or a witnessed row for a reachable arm)\",\n-\t\t\t\t\tkey, row.bound, boundShadowedLookup)\n-\t\t\t}\n-\t\t} else {\n-\t\t\tuncovered++\n-\t\t\tif row.bound != \"\" {\n-\t\t\t\tt.Errorf(\"shadow miss %s is uncovered but its row claims bound %q: the shadowing does not hold, witness the arm\",\n-\t\t\t\t\tkey, row.bound)\n-\t\t\t}\n-\t\t}\n-\t}\n-\tboundRows := 0\n-\tfor _, row := range rows {\n-\t\tif row.bound == boundShadowedLookup {\n-\t\t\tboundRows++\n-\t\t}\n-\t}\n-\tif covered != boundRows {\n-\t\tt.Errorf(\"cover analysis covers %d misses, want exactly the %d boundShadowedLookup rows\", covered, boundRows)\n-\t}\n-\tt.Logf(\"shadowed lookups: %d covered (bound), %d uncovered (witnessed)\", covered, uncovered)\n-}\n+func assertShadowedLookupsAreCovered(t *testing.T) {\n+\tt.Helper()\n+\n+\tfiles, fileSet := invcore.MustScanProduction(t, \".\")\n+\tmisses := shadowMissSites(t, files, fileSet)\n+\texacts := shadowExactChecks(t, files, fileSet)\n+\tcalls := shadowHelperCalls(files)\n+\n+\t// Join misses to derived arms by (file, function, line): every miss\n+\t// must be a derived arm and vice versa. A miss the analysis cannot\n+\t// see is a bound without a pin; an arm the analysis cannot see is a\n+\t// pin that proves nothing.\n+\tderivedByKey := map[string]refusalArm{}\n+\tfor _, arm := range deriveRefusalArms(t) {\n+\t\tif arm.detail != \"document members\" {\n+\t\t\tcontinue\n+\t\t}\n+\t\tderivedByKey[arm.file+\"|\"+arm.function+\":\"+strconv.Itoa(arm.line)] = arm\n+\t}\n+\tmissByKey := map[string]shadowMiss{}\n+\tfor _, miss := range misses {\n+\t\tkey := miss.file + \"|\" + miss.function + \":\" + strconv.Itoa(miss.line)\n+\t\tif _, duplicate := missByKey[key]; duplicate {\n+\t\t\tt.Errorf(\"shadow analysis derives %s twice\", key)\n+\t\t\tcontinue\n+\t\t}\n+\t\tmissByKey[key] = miss\n+\t\tif _, ok := derivedByKey[key]; !ok {\n+\t\t\tt.Errorf(\"shadow miss %s names no derived refusal arm; the cover analysis sees a site the inventory does not\", key)\n+\t\t}\n+\t}\n+\tfor key := range derivedByKey {\n+\t\tif _, ok := missByKey[key]; !ok {\n+\t\t\tt.Errorf(\"derived refusal arm %s names no shadow miss; the inventory sees a site the cover analysis does not\", key)\n+\t\t}\n+\t}\n+\n+\t// Row linkage, both directions: covered misses carry bound rows,\n+\t// uncovered misses carry witnessed rows.\n+\trows := declaredRows()\n+\trowByKey := map[string]declaredRefusalArm{}\n+\tfor _, row := range rows {\n+\t\trowByKey[describeRow(row)] = row\n+\t}\n+\tcovered, uncovered := 0, 0\n+\tfor key, miss := range missByKey {\n+\t\tarm, ok := derivedByKey[key]\n+\t\tif !ok {\n+\t\t\tcontinue\n+\t\t}\n+\t\trow, known := rowByKey[describeArm(arm)]\n+\t\tif !known {\n+\t\t\tt.Errorf(\"shadow miss %s resolves to no declared row\", key)\n+\t\t\tcontinue\n+\t\t}\n+\t\tmembers := shadowMissMembers(t, miss, calls)\n+\t\tisCovered := len(members) > 0 && shadowMembersCovered(files, exacts, calls, miss, members, map[string]bool{})\n+\t\tif isCovered {\n+\t\t\tcovered++\n+\t\t\tif row.bound != boundShadowedLookup {\n+\t\t\t\tt.Errorf(\"shadow miss %s is covered but its row carries bound %q, want %q\",\n+\t\t\t\t\tkey, row.bound, boundShadowedLookup)\n+\t\t\t}\n+\t\t} else {\n+\t\t\tuncovered++\n+\t\t\tif row.bound != \"\" {\n+\t\t\t\tt.Errorf(\"shadow miss %s is uncovered but its row claims bound %q: the shadowing does not hold, witness the arm\",\n+\t\t\t\t\tkey, row.bound)\n+\t\t\t}\n+\t\t}\n+\t}\n+\tboundRows := 0\n+\tfor _, row := range rows {\n+\t\tif row.bound == boundShadowedLookup {\n+\t\t\tboundRows++\n+\t\t}\n+\t}\n+\tif covered != boundRows {\n+\t\tt.Errorf(\"cover analysis covers %d misses, want exactly the %d boundShadowedLookup rows\", covered, boundRows)\n+\t}\n+\tt.Logf(\"shadowed lookups: %d covered (bound), %d uncovered (witnessed)\", covered, uncovered)\n+}\n"}}}
