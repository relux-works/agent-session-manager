{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c57f","stream":{"kind":"session","id":"01a079e0-55db-79f2-85b0-c8c2e4c1a43f"},"sequence":282,"recorded_at":1780531400000559,"record_type":"event","durability":"durable","causation_id":"38173c32-e836-4324-8339-ee117e4249f1","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"38173c32-e836-4324-8339-ee117e4249f1","run_stream":{"kind":"run","id":"38173c32-e836-4324-8339-ee117e4249f1"},"task_stream":{"kind":"task","id":"cae5e0df-d378-4a23-9503-c5f0e018dc70"},"task_id":"cae5e0df-d378-4a23-9503-c5f0e018dc70","event":{"kind":"output","task_id":"cae5e0df-d378-4a23-9503-c5f0e018dc70","chunk":"Read text file `internal/terminalbackend/refusal_arm_witnesses_test.go`.\n1|// Executed refusal-arm witnesses for the terminal backend packages.\n2|//\n3|// Every non-bound row of the white-box arm table\n4|// (refusal_arm_inventory_test.go) carries exactly one witness here,\n5|// keyed by the same identity the derivation uses. The harness runs each\n6|// witness through a PUBLIC production entry point and requires the exact\n7|// wire code at the exact static detail: a row that merely mentions the\n8|// detail in some test's source proves nothing and resolves nothing.\n9|//\n10|// Witness construction rule for shared-clause sites: several sites share\n11|// one (code, detail) clause (ten sites share \"document member type\").\n12|// Each prove documents the pass-earlier-sites construction — the input\n13|// passes every earlier same-clause site on its entry path and fails at\n14|// the named one — so the witness attributes the site, not just the\n15|// clause. Bound rows (defensive re-parses, unreachable vocabulary,\n16|// decoder-contract and canonical-plumbing branches, the kind gate, the\n17|// number walk) carry NO witness: no input refuses at their entry, and a\n18|// witness would resolve through a sibling. Their pins live white-box in\n19|// the pinned bound set.\n20|//\n21|// The both-direction harness runs in both packages: white-box proves\n22|// derived-arms against declared-rows, and TestDerivedArmsAreAllWitnessed\n23|// / TestWitnessedArmsAreAllDerived below prove declared-rows against\n24|// executed witnesses, so a truncated witness registry reddens instead of\n25|// passing vacuously.\n26|package terminalbackend_test\n27|\n28|import (\n29|\t\"fmt\"\n30|\t\"sort\"\n31|\t\"strings\"\n32|\t\"testing\"\n33|\t\"time\"\n34|\n35|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n36|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n37|)\n38|\n39|// armWitness proves one declared refusal arm at its public production\n40|// entry. Key equals terminalbackend.ArmKey over the row identity exactly:\n41|// TestWitnessedArmsAreAllDerived fails a witness that names nothing\n42|// production declares. Entry names the public entry the prove function\n43|// drives.\n44|type armWitness struct {\n45|\tkey   string\n46|\tentry string\n47|\tprove func(*testing.T)\n48|}\n49|\n50|// wkey renders one row identity in the shared witness key space,\n51|// matching terminalbackend.ArmKey exactly.\n52|func wkey(file, function, code, detail string, occurrence int) string {\n53|\treturn fmt.Sprintf(\"%s|%s|%s|%q#%d\", file, function, code, detail, occurrence)\n54|}\n55|\n56|// requireRegistryRefusal asserts err is a registry refusal satisfying\n57|// check with the exact static wantDetail clause.\n58|func requireRegistryRefusal(t *testing.T, err error, check func(error) bool, wantDetail string) {\n59|\tt.Helper()\n60|\tif !check(err) {\n61|\t\tt.Fatalf(\"error = %v, want a registry refusal at %q\", err, wantDetail)\n62|\t}\n63|\tif got := refusalDetail(t, err); got != wantDetail {\n64|\t\tt.Fatalf(\"refusal detail = %q, want %q\", got, wantDetail)\n65|\t}\n66|}\n67|\n68|// TestDerivedArmsAreAllWitnessed is the forward direction: every derived\n69|// non-bound arm carries an executed witness. A planted arm (a new\n70|// production site through an existing constructor) lands here as an\n71|// unwitnessed arm.\n72|func TestDerivedArmsAreAllWitnessed(t *testing.T) {\n73|\tt.Parallel()\n74|\n75|\tderived := terminalbackend.DerivedArmIdentities(t)\n76|\tdeclared := terminalbackend.DeclaredArmIdentities()\n77|\tbound := map[string]bool{}\n78|\tfor _, row := range declared {\n79|\t\tif row.Bound != \"\" {\n80|\t\t\tbound[terminalbackend.ArmKey(row)] = true\n81|\t\t}\n82|\t}\n83|\twitnessed := map[string]bool{}\n84|\tfor _, witness := range declaredArmWitnesses() {\n85|\t\twitnessed[witness.key] = true\n86|\t}\n87|\tvar missing []string\n88|\tfor _, arm := range derived {\n89|\t\tkey := terminalbackend.ArmKey(arm)\n90|\t\tif bound[key] {\n91|\t\t\tcontinue\n92|\t\t}\n93|\t\tif !witnessed[key] {\n94|\t\t\tmissing = append(missing, key)\n95|\t\t}\n96|\t}\n97|\tsort.Strings(missing)\n98|\tif len(missing) > 0 {\n99|\t\tt.Fatalf(\"derived refusal arm(s) with no executed witness at the production entry:\\n  %s\",\n100|\t\t\tstrings.Join(missing, \"\\n  \"))\n101|\t}\n102|\tt.Logf(\"refusal-arm witnesses: %d/%d derived arms executed\", len(derived)-len(missing)-len(bound), len(derived))\n103|}\n104|\n105|// TestWitnessedArmsAreAllDerived is the reverse direction: every witness\n106|// names a derived arm, and no witness names a bound arm (a bound arm has\n107|// no refusing input by construction; witnessing it would resolve through\n108|// a sibling). A deleted or narrowed production branch orphans its witness\n109|// and fails here, which is also what makes a truncated derivation fail\n110|// instead of passing vacuously.\n111|func TestWitnessedArmsAreAllDerived(t *testing.T) {\n112|\tt.Parallel()\n113|\n114|\tderived := map[string]bool{}\n115|\tfor _, arm := range terminalbackend.DerivedArmIdentities(t) {\n116|\t\tderived[terminalbackend.ArmKey(arm)] = true\n117|\t}\n118|\tbound := map[string]bool{}\n119|\tfor _, row := range terminalbackend.DeclaredArmIdentities() {\n120|\t\tif row.Bound != \"\" {\n121|\t\t\tbound[terminalbackend.ArmKey(row)] = true\n122|\t\t}\n123|\t}\n124|\tvar orphans []string\n125|\tfor _, witness := range declaredArmWitnesses() {\n126|\t\tif bound[witness.key] {\n127|\t\t\torphans = append(orphans, witness.key+\" (bound arm must not carry a witness)\")\n128|\t\t\tcontinue\n129|\t\t}\n130|\t\tif !derived[witness.key] {\n131|\t\t\torphans = append(orphans, witness.key+\" (\"+witness.entry+\")\")\n132|\t\t}\n133|\t}\n134|\tsort.Strings(orphans)\n135|\tif len(orphans) > 0 {\n136|\t\tt.Fatalf(\"witness(es) naming no derived production arm:\\n  %s\", strings.Join(orphans, \"\\n  \"))\n137|\t}\n138|}\n139|\n140|// TestEveryDeclaredArmRefusesAtItsEntry drives every witness through its\n141|// public production entry point and requires the attributed refusal.\n142|func TestEveryDeclaredArmRefusesAtItsEntry(t *testing.T) {\n143|\tt.Parallel()\n144|\n145|\tfor _, witness := range declaredArmWitnesses() {\n146|\t\tt.Run(witness.key, func(t *testing.T) {\n147|\t\t\tt.Parallel()\n148|\t\t\twitness.prove(t)\n149|\t\t})\n150|\t}\n151|}\n152|\n153|// conformanceWitnesses proves every non-bound conformance.go arm at its\n154|// public entry. Multi-occurrence groups use ordered inputs: each prove\n155|// passes the earlier same-clause sites and fails at the named one.\n156|func conformanceWitnesses() []armWitness {\n157|\treturn []armWitness{\n158|\t\t{\n159|\t\t\tkey:   wkey(\"conformance.go\", \"CheckAttachRequest\", \"CodeUnauthorized\", \"attach authorization binding\", 1),\n160|\t\t\tentry: \"CheckAttachRequest\",\n161|\t\t\tprove: func(t *testing.T) {\n162|\t\t\t\t// Wrong transport against a matching policy: the\n163|\t\t\t\t// transport parse passes, the binding comparison fires.\n164|\t\t\t\terr := terminalbackend.CheckAttachRequest(testAttachAuthorization(t), \"trusted_private_mesh\", true, conformanceNow())\n165|\t\t\t\trequireConformanceRefusal(t, err, \"terminal_backend_unauthorized\", \"attach authorization binding\")\n166|\t\t\t},\n167|\t\t},\n168|\t\t{\n169|\t\t\tkey:   wkey(\"conformance.go\", \"CheckAttachRequest\", \"CodeUnauthorized\", \"attach authorization expiry\", 1),\n170|\t\t\tentry: \"CheckAttachRequest\",\n171|\t\t\tprove: func(t *testing.T) {\n172|\t\t\t\t// Matching transport and input, instant past expiry: the\n173|\t\t\t\t// binding comparison passes, the expiry comparison fires.\n174|\t\t\t\texpired := conformanceNow().Add(48 * time.Hour)\n175|\t\t\t\terr := terminalbackend.CheckAttachRequest(testAttachAuthorization(t), \"local_only\", true, expired)\n176|\t\t\t\trequireConformanceRefusal(t, err, \"terminal_backend_unauthorized\", \"attach authorization expiry\")\n177|\t\t\t},\n178|\t\t},\n179|\t\t{\n180|\t\t\tkey:   wkey(\"conformance.go\", \"CheckAttachRequest\", \"CodeUnauthorized\", \"attach relay transport\", 1),\n181|\t\t\tentry: \"CheckAttachRequest\",\n182|\t\t\tprove: func(t *testing.T) {\n183|\t\t\t\t// A relay policy matches on transport and input, so only\n184|\t\t\t\t// the relay bar can refuse.\n185|\t\t\t\traw := `{\"policy_evidence_id\":\"` + testDigest + `\",` +\n186|\t\t\t\t\t`\"authorizing_host_id\":\"` + conformanceHost + `\",` +\n187|\t\t\t\t\t`\"transport\":\"third_party_relay\",` +\n188|\t\t\t\t\t`\"input_authorized\":false,` +\n189|\t\t\t\t\t`\"issued_at\":\"` + conformanceIssued + `\",` +\n190|\t\t\t\t\t`\"expires_at\":\"` + conformanceExpires + `\"}`\n191|\t\t\t\tauth, err := terminalbackend.ParseAttachAuthorization([]byte(raw))\n192|\t\t\t\tif err != nil {\n193|\t\t\t\t\tt.Fatalf(\"ParseAttachAuthorization(relay) error = %v\", err)\n194|\t\t\t\t}\n195|\t\t\t\terr = terminalbackend.CheckAttachRequest(auth, \"third_party_relay\", false, conformanceNow())\n196|\t\t\t\trequireConformanceRefusal(t, err, \"terminal_backend_unauthorized\", \"attach relay transport\")\n197|\t\t\t},\n198|\t\t},\n199|\t\t{\n200|\t\t\tkey:   wkey(\"conformance.go\", \"CheckAttachResult\", \"CodeUnauthorized\", \"attach input binding\", 1),\n201|\t\t\tentry: \"CheckAttachResult\",\n202|\t\t\tprove: func(t *testing.T) {\n203|\t\t\t\t// Result grants input the request withheld: the triple\n204|\t\t\t\t// equality fails on the result leg.\n205|\t\t\t\terr := terminalbackend.CheckAttachResult(false, true, testAttachAuthorization(t))\n206|\t\t\t\trequireConformanceRefusal(t, err, \"terminal_backend_unauthorized\", \"attach input binding\")\n207|\t\t\t},\n208|\t\t},\n209|\t\t{\n210|\t\t\tkey:   wkey(\"conformance.go\", \"CheckEntrypoint\", \"CodePreconditionFailed\", \"entrypoint argv\", 1),\n211|\t\t\tentry: \"CheckEntrypoint\",\n212|\t\t\tprove: func(t *testing.T) {\n213|\t\t\t\terr := terminalbackend.CheckEntrypoint([]string{\"codex\", conformanceSessionA}, conformanceSessionA)\n214|\t\t\t\trequireConformanceRefusal(t, err, \"local_precondition_failed\", \"entrypoint argv\")\n215|\t\t\t},\n216|\t\t},\n217|\t\t{\n218|\t\t\t// Occurrence order in CheckEntrypoint: #1 parses the session\n219|\t\t\t// ID, #2 parses argv[2], #3 compares the two. Each prove\n220|\t\t\t// passes the earlier parses.\n221|\t\t\tkey:   wkey(\"conformance.go\", \"CheckEntrypoint\", \"CodePreconditionFailed\", \"entrypoint session binding\", 1),\n222|\t\t\tentry: \"CheckEntrypoint\",\n223|\t\t\tprove: func(t *testing.T) {\n224|\t\t\t\t// Unparseable session ID: the argv shape passes, the\n225|\t\t\t\t// first session parse fires.\n226|\t\t\t\terr := terminalbackend.CheckEntrypoint([]string{\"ax\", \"pane\", conformanceSessionA}, \"bogus\")\n227|\t\t\t\trequireConformanceRefusal(t, err, \"local_precondition_failed\", \"entrypoint session binding\")\n228|\t\t\t},\n229|\t\t},\n230|\t\t{\n231|\t\t\tkey:   wkey(\"conformance.go\", \"CheckEntrypoint\", \"CodePreconditionFailed\", \"entrypoint session binding\", 2),\n232|\t\t\tentry: \"CheckEntrypoint\",\n233|\t\t\tprove: func(t *testing.T) {\n234|\t\t\t\t// Valid session ID, unparseable carried ID: #1 passes,\n235|\t\t\t\t// the second parse fires.\n236|\t\t\t\terr := terminalbackend.CheckEntrypoint([]string{\"ax\", \"pane\", \"bogus\"}, conformanceSessionA)\n237|\t\t\t\trequireConformanceRefusal(t, err, \"local_precondition_failed\", \"entrypoint session binding\")\n238|\t\t\t},\n239|\t\t},\n240|\t\t{\n241|\t\t\tkey:   wkey(\"conformance.go\", \"CheckEntrypoint\", \"CodePreconditionFailed\", \"entrypoint session binding\", 3),\n242|\t\t\tentry: \"CheckEntrypoint\",\n243|\t\t\tprove: func(t *testing.T) {\n244|\t\t\t\t// Two valid but differing IDs: both parses pass, the\n245|\t\t\t\t// comparison fires.\n246|\t\t\t\terr := terminalbackend.CheckEntrypoint([]string{\"ax\", \"pane\", conformanceSessionB}, conformanceSessionA)\n247|\t\t\t\trequireConformanceRefusal(t, err, \"local_precondition_failed\", \"entrypoint session binding\")\n248|\t\t\t},\n249|\t\t},\n250|\t\t{\n251|\t\t\tkey:   wkey(\"conformance.go\", \"CheckErrorAllowed\", \"CodeProtocolError\", \"operation error vocabulary\", 1),\n252|\t\t\tentry: \"CheckErrorAllowed\",\n253|\t\t\tprove: func(t *testing.T) {\n254|\t\t\t\t// A listed operation with an unlisted code: the operation\n255|\t\t\t\t// parse passes, the allowed-set lookup fires.\n256|\t\t\t\terr := terminalbackend.CheckErrorAllowed(\"create\", \"bogus_code\")\n257|\t\t\t\trequireConformanceRefusal(t, err, \"terminal_backend_protocol_error\", \"operation error vocabulary\")\n258|\t\t\t},\n259|\t\t},\n260|\t\t{\n261|\t\t\tkey:   wkey(\"conformance.go\", \"CheckReplicable\", \"CodeProtocolError\", \"replication exclusion\", 1),\n262|\t\t\tentry: \"CheckReplicable\",\n263|\t\t\tprove: func(t *testing.T) {\n264|\t\t\t\terr := terminalbackend.CheckReplicable([]string{\"manifest_id\", \"binding_id\"})\n265|\t\t\t\trequireConformanceRefusal(t, err, \"terminal_backend_protocol_error\", \"replication exclusion\")\n266|\t\t\t},\n267|\t\t},\n268|\t\t{\n269|\t\t\tkey:   wkey(\"conformance.go\", \"CheckStatusResult\", \"CodePreconditionFailed\", \"status attachability\", 1),\n270|\t\t\tentry: \"CheckStatusResult\",\n271|\t\t\tprove: func(t *testing.T) {\n272|\t\t\t\t// Evidenced attach capability outside parked/active: the\n273|\t\t\t\t// identity, observation, and state parses pass, the\n274|\t\t\t\t// two-state attachability rule fires.\n275|\t\t\t\tpresent := true\n276|\t\t\t\tlastOp := \"0198f4c8-8e50-7f66-8f70-1234567890ab\"\n277|\t\t\t\tlastEffect := terminalbackend.EffectWrapperStarted\n278|\t\t\t\tresult := terminalbackend.StatusResult{\n279|\t\t\t\t\tState: trueState(), IdentityMatch: true, WrapperPresent: true,\n280|\t\t\t\t\tProviderPresent: &present, Attachable: true,\n281|\t\t\t\t\tLastOperationID: &lastOp, LastEffect: &lastEffect,\n282|\t\t\t\t\tProviderRequested: true, ProviderEvidenced: true, AttachEvidenced: true,\n283|\t\t\t\t}\n284|\t\t\t\terr := terminalbackend.CheckStatusResult(true, result)\n285|\t\t\t\trequireConformanceRefusal(t, err, \"local_precondition_failed\", \"status attachability\")\n286|\t\t\t},\n287|\t\t},\n288|\t\t{\n289|\t\t\t// Occurrence order: #1 is the identityMatch contradiction\n290|\t\t\t// (false lookup, true report), #2 is the non-canonical false\n291|\t\t\t// form. #1's input fails the first comparison; #2's input\n292|\t\t\t// passes it (both false) and fails the form check.\n293|\t\t\tkey:   wkey(\"conformance.go\", \"CheckStatusResult\", \"CodeProtocolError\", \"status identity binding\", 1),\n294|\t\t\tentry: \"CheckStatusResult\",\n295|\t\t\tprove: func(t *testing.T) {\n296|\t\t\t\terr := terminalbackend.CheckStatusResult(false, terminalbackend.StatusResult{State: \"absent\", IdentityMatch: true})\n297|\t\t\t\trequireConformanceRefusal(t, err, \"terminal_backend_protocol_error\", \"status identity binding\")\n298|\t\t\t},\n299|\t\t},\n300|\t\t{\n301|\t\t\tkey:   wkey(\"conformance.go\", \"CheckStatusResult\", \"CodeProtocolError\", \"status identity binding\", 2),\n302|\t\t\tentry: \"CheckStatusResult\",\n303|\t\t\tprove: func(t *testing.T) {\n304|\t\t\t\terr := terminalbackend.CheckStatusResult(false, terminalbackend.StatusResult{State: \"active\"})\n305|\t\t\t\trequireConformanceRefusal(t, err, \"terminal_backend_protocol_error\", \"status identity binding\")\n306|\t\t\t},\n307|\t\t},\n308|\t\t{\n309|\t\t\tkey:   wkey(\"conformance.go\", \"CheckStatusResult\", \"CodeProtocolError\", \"status provider observation\", 1),\n310|\t\t\tentry: \"CheckStatusResult\",\n311|\t\t\tprove: func(t *testing.T) {\n312|\t\t\t\t// Provider observation carried without request: the\n313|\t\t\t\t// identity checks pass, the request-and-evidence\n314|\t\t\t\t// conjunction fires.\n315|\t\t\t\tpresent := true\n316|\t\t\t\tlastOp := \"0198f4c8-8e50-7f66-8f70-1234567890ab\"\n317|\t\t\t\tlastEffect := terminalbackend.EffectWrapperStarted\n318|\t\t\t\tresult := terminalbackend.StatusResult{\n319|\t\t\t\t\tState: trueState(), IdentityMatch: true, WrapperPresent: true,\n320|\t\t\t\t\tProviderPresent: &present, Attachable: false,\n321|\t\t\t\t\tLastOperationID: &lastOp, LastEffect: &lastEffect,\n322|\t\t\t\t\tProviderRequested: false, ProviderEvidenced: true, AttachEvidenced: false,\n323|\t\t\t\t}\n324|\t\t\t\terr := terminalbackend.CheckStatusResult(true, result)\n325|\t\t\t\trequireConformanceRefusal(t, err, \"terminal_backend_protocol_error\", \"status provider observation\")\n326|\t\t\t},\n327|\t\t},\n328|\t\t{\n329|\t\t\tkey:   wkey(\"conformance.go\", \"CheckTransition\", \"CodePreconditionFailed\", \"lifecycle instance scope\", 1),\n330|\t\t\tentry: \"CheckTransition\",\n331|\t\t\tprove: func(t *testing.T) {\n332|\t\t\t\t// manifest carries no instance: the operation parse\n333|\t\t\t\t// passes, the scope comparison fires.\n334|\t\t\t\t_, _, err := terminalbackend.CheckTransition(\"manifest\", \"active\", false)\n335|\t\t\t\trequireConformanceRefusal(t, err, \"local_precondition_failed\", \"lifecycle instance scope\")\n336|\t\t\t},\n337|\t\t},\n338|\t\t{\n339|\t\t\tkey:   wkey(\"conformance.go\", \"CheckTransition\", \"CodePreconditionFailed\", \"lifecycle transition\", 1),\n340|\t\t\tentry: \"CheckTransition\",\n341|\t\t\tprove: func(t *testing.T) {\n342|\t\t\t\t// attach from a known but disallowed source: operation,\n343|\t\t\t\t// scope, and state parses pass, the source-membership\n344|\t\t\t\t// comparison fires.\n345|\t\t\t\t_, _, err := terminalbackend.CheckTransition(\"attach\", \"stopped\", false)\n346|\t\t\t\trequireConformanceRefusal(t, err, \"local_precondition_failed\", \"lifecycle transition\")\n347|\t\t\t},\n348|\t\t},\n349|\t\t{\n350|\t\t\t// Occurrence order in IdempotencyKey: #1 is the empty-segment\n351|\t\t\t// loop, #2 the variable-count floor (status), #3 the exact\n352|\t\t\t// count. Each prove passes the earlier comparisons.\n353|\t\t\tkey:   wkey(\"conformance.go\", \"IdempotencyKey\", \"CodeProtocolError\", \"idempotency key shape\", 1),\n354|\t\t\tentry: \"IdempotencyKey\",\n355|\t\t\tprove: func(t *testing.T) {\n356|\t\t\t\t_, err := terminalbackend.IdempotencyKey(\"create\", \"\", \"bootstrap-1\")\n357|\t\t\t\trequireConformanceRefusal(t, err, \"terminal_backend_protocol_error\", \"idempotency key shape\")\n358|\t\t\t},\n359|\t\t},\n360|\t\t{\n361|\t\t\tkey:   wkey(\"conformance.go\", \"IdempotencyKey\", \"CodeProtocolError\", \"idempotency key shape\", 2),\n362|\t\t\tentry: \"IdempotencyKey\",\n363|\t\t\tprove: func(t *testing.T) {\n364|\t\t\t\t_, err := terminalbackend.IdempotencyKey(\"status\")\n365|\t\t\t\trequireConformanceRefusal(t, err, \"terminal_backend_protocol_error\", \"idempotency key shape\")\n366|\t\t\t},\n367|\t\t},\n368|\t\t{\n369|\t\t\tkey:   wkey(\"conformance.go\", \"IdempotencyKey\", \"CodeProtocolError\", \"idempotency key shape\", 3),\n370|\t\t\tentry: \"IdempotencyKey\",\n371|\t\t\tprove: func(t *testing.T) {\n372|\t\t\t\t_, err := terminalbackend.IdempotencyKey(\"manifest\")\n373|\t\t\t\trequireConformanceRefusal(t, err, \"terminal_backend_protocol_error\", \"idempotency key shape\")\n374|\t\t\t},\n375|\t\t},\n376|\t\t{\n377|\t\t\t// Occurrence order in ImportLedger: #1 is the line-count\n378|\t\t\t// shape, #2 the empty key/result shape, #3 the operation\n379|\t\t\t// parse. Each prove passes the earlier shapes.\n380|\t\t\tkey:   wkey(\"conformance.go\", \"ImportLedger\", \"CodeProtocolError\", \"idempotency ledger image\", 1),\n381|\t\t\tentry: \"ImportLedger\",\n382|\t\t\tprove: func(t *testing.T) {\n383|\t\t\t\t_, err := terminalbackend.ImportLedger([]byte(\"only-one-line\\n\"))\n384|\t\t\t\trequireConformanceRefusal(t, err, \"terminal_backend_protocol_error\", \"idempotency ledger image\")\n385|\t\t\t},\n386|\t\t},\n387|\t\t{\n388|\t\t\tkey:   wkey(\"conformance.go\", \"ImportLedger\", \"CodeProtocolError\", \"idempotency ledger image\", 2),\n389|\t\t\tentry: \"ImportLedger\",\n390|\t\t\tprove: func(t *testing.T) {\n391|\t\t\t\t_, err := terminalbackend.ImportLedger([]byte(\"key\\ncreate\\n\\n\"))\n392|\t\t\t\trequireConformanceRefusal(t, err, \"terminal_backend_protocol_error\", \"idempotency ledger image\")\n393|\t\t\t},\n394|\t\t},\n395|\t\t{\n396|\t\t\tkey:   wkey(\"conformance.go\", \"ImportLedger\", \"CodeProtocolError\", \"idempotency ledger image\", 3),\n397|\t\t\tentry: \"ImportLedger\",\n398|\t\t\tprove: func(t *testing.T) {\n399|\t\t\t\t_, err := terminalbackend.ImportLedger([]byte(\"key\\nlaunch\\nresult-1\\n\"))\n400|\t\t\t\trequireConformanceRefusal(t, err, \"terminal_backend_protocol_error\", \"idempotency ledger image\")\n401|\t\t\t},\n402|\t\t},\n403|\t\t{\n404|\t\t\tkey:   wkey(\"conformance.go\", \"ImportLedger\", \"CodeIdempotencyMismatch\", \"idempotency ledger image\", 1),\n405|\t\t\tentry: \"ImportLedger\",\n406|\t\t\tprove: func(t *testing.T) {\n407|\t\t\t\t_, err := terminalbackend.ImportLedger([]byte(\"key\\ncreate\\nresult-1\\nkey\\nrestore\\nresult-2\\n\"))\n408|\t\t\t\trequireConformanceRefusal(t, err, \"idempotency_mismatch\", \"idempotency ledger image\")\n409|\t\t\t},\n410|\t\t},\n411|\t\t{\n412|\t\t\tkey:   wkey(\"conformance.go\", \"Ledger.Bind\", \"CodeIdempotencyMismatch\", \"idempotency key conflict\", 1),\n413|\t\t\tentry: \"Bind\",\n414|\t\t\tprove: func(t *testing.T) {\n415|\t\t\t\tledger := terminalbackend.NewLedger()\n416|\t\t\t\tif _, err := ledger.Bind(\"session-1/bootstrap-1\", \"create\", \"result-1\"); err != nil {\n417|\t\t\t\t\tt.Fatalf(\"Bind() error = %v\", err)\n418|\t\t\t\t}\n419|\t\t\t\t_, err := ledger.Bind(\"session-1/bootstrap-1\", \"restore\", \"result-1\")\n420|\t\t\t\trequireConformanceRefusal(t, err, \"idempotency_mismatch\", \"idempotency key conflict\")\n421|\t\t\t},\n422|\t\t},\n423|\t\t{\n424|\t\t\tkey:   wkey(\"conformance.go\", \"Ledger.Bind\", \"CodeProtocolError\", \"idempotency key shape\", 1),\n425|\t\t\tentry: \"Bind\",\n426|\t\t\tprove: func(t *testing.T) {\n427|\t\t\t\t_, err := terminalbackend.NewLedger().Bind(\"\", \"create\", \"result-1\")\n428|\t\t\t\trequireConformanceRefusal(t, err, \"terminal_backend_protocol_error\", \"idempotency key shape\")\n429|\t\t\t},\n430|\t\t},\n431|\t\t{\n432|\t\t\tkey:   wkey(\"conformance.go\", \"Ledger.Bind\", \"CodeProtocolError\", \"idempotency ledger unavailable\", 1),\n433|\t\t\tentry: \"Bind\",\n434|\t\t\tprove: func(t *testing.T) {\n435|\t\t\t\tvar nilLedger *terminalbackend.Ledger\n436|\t\t\t\t_, err := nilLedger.Bind(\"session-1/bootstrap-1\", \"create\", \"result-1\")\n437|\t\t\t\trequireConformanceRefusal(t, err, \"terminal_backend_protocol_error\", \"idempotency ledger unavailable\")\n438|\t\t\t},\n439|\t\t},\n440|\t\t{\n441|\t\t\t// Occurrence order in ParseAttachAuthorization: #1 is the\n442|\t\t\t// host-ID grammar check, #2 the input-authorized type check.\n443|\t\t\t// #2's input carries a valid host ID, passing #1.\n444|\t\t\tkey:   wkey(\"conformance.go\", \"ParseAttachAuthorization\", \"CodeMismatch\", \"document member type\", 1),\n445|\t\t\tentry: \"ParseAttachAuthorization\",\n446|\t\t\tprove: func(t *testing.T) {\n447|\t\t\t\traw := `{\"policy_evidence_id\":\"` + testDigest + `\",` +\n448|\t\t\t\t\t`\"authorizing_host_id\":\"not-a-uuid\",` +\n449|\t\t\t\t\t`\"transport\":\"local_only\",` +\n450|\t\t\t\t\t`\"input_authorized\":true,` +\n451|\t\t\t\t\t`\"issued_at\":\"` + conformanceIssued + `\",` +\n452|\t\t\t\t\t`\"expires_at\":\"` + conformanceExpires + `\"}`\n453|\t\t\t\t_, err := terminalbackend.ParseAttachAuthorization([]byte(raw))\n454|\t\t\t\trequireConformanceRefusal(t, err, \"terminal_backend_manifest_probe_mismatch\", \"document member type\")\n455|\t\t\t},\n456|\t\t},\n457|\t\t{\n458|\t\t\tkey:   wkey(\"conformance.go\", \"ParseAttachAuthorization\", \"CodeMismatch\", \"document member type\", 2),\n459|\t\t\tentry: \"ParseAttachAuthorization\",\n460|\t\t\tprove: func(t *testing.T) {\n461|\t\t\t\traw := `{\"policy_evidence_id\":\"` + testDigest + `\",` +\n462|\t\t\t\t\t`\"authorizing_host_id\":\"` + conformanceHost + `\",` +\n463|\t\t\t\t\t`\"transport\":\"local_only\",` +\n464|\t\t\t\t\t`\"input_authorized\":\"yes\",` +\n465|\t\t\t\t\t`\"issued_at\":\"` + conformanceIssued + `\",` +\n466|\t\t\t\t\t`\"expires_at\":\"` + conformanceExpires + `\"}`\n467|\t\t\t\t_, err := terminalbackend.ParseAttachAuthorization([]byte(raw))\n468|\t\t\t\trequireConformanceRefusal(t, err, \"terminal_backend_manifest_probe_mismatch\", \"document member type\")\n469|\t\t\t},\n470|\t\t},\n471|\t\t{\n472|\t\t\tkey:   wkey(\"conformance.go\", \"ParseAttachAuthorization\", \"CodeUnauthorized\", \"attach authorization expiry\", 1),\n473|\t\t\tentry: \"ParseAttachAuthorization\",\n474|\t\t\tprove: func(t *testing.T) {\n475|\t\t\t\t// Expiry equal to issue: every member rule passes, the\n476|\t\t\t\t// strict-after comparison fires.\n477|\t\t\t\traw := `{\"policy_evidence_id\":\"` + testDigest + `\",` +\n478|\t\t\t\t\t`\"authorizing_host_id\":\"` + conformanceHost + `\",` +\n479|\t\t\t\t\t`\"transport\":\"local_only\",` +\n480|\t\t\t\t\t`\"input_authorized\":true,` +\n481|\t\t\t\t\t`\"issued_at\":\"` + conformanceIssued + `\",` +\n482|\t\t\t\t\t`\"expires_at\":\"` + conformanceIssued + `\"}`\n483|\t\t\t\t_, err := terminalbackend.ParseAttachAuthorization([]byte(raw))\n484|\t\t\t\trequireConformanceRefusal(t, err, \"terminal_backend_unauthorized\", \"attach authorization expiry\")\n485|\t\t\t},\n486|\t\t},\n487|\t\t{\n488|\t\t\tkey:   wkey(\"conformance.go\", \"ParseInstanceState\", \"CodeProtocolError\", \"lifecycle state vocabulary\", 1),\n489|\t\t\tentry: \"ParseInstanceState\",\n490|\t\t\tprove: func(t *testing.T) {\n491|\t\t\t\t_, err := terminalbackend.ParseInstanceState(\"running\")\n492|\t\t\t\trequireConformanceRefusal(t, err, \"terminal_backend_protocol_error\", \"lifecycle state vocabulary\")\n493|\t\t\t},\n494|\t\t},\n495|\t\t{\n496|\t\t\tkey:   wkey(\"conformance.go\", \"ParseOperation\", \"CodeProtocolError\", \"operation vocabulary\", 1),\n497|\t\t\tentry: \"ParseOperation\",\n498|\t\t\tprove: func(t *testing.T) {\n499|\t\t\t\t_, err := terminalbackend.ParseOperation(\"launch\")\n500|\t\t\t\trequireConformanceRefusal(t, err, \"terminal_backend_protocol_error\", \"operation vocabulary\")\n(more lines below)"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c581","stream":{"kind":"session","id":"01a079e0-55db-79f2-85b0-c8c2e4c1a43f"},"sequence":283,"recorded_at":1780531400000561,"record_type":"event","durability":"durable","causation_id":"38173c32-e836-4324-8339-ee117e4249f1","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"38173c32-e836-4324-8339-ee117e4249f1","run_stream":{"kind":"run","id":"38173c32-e836-4324-8339-ee117e4249f1"},"task_stream":{"kind":"task","id":"cae5e0df-d378-4a23-9503-c5f0e018dc70"},"task_id":"cae5e0df-d378-4a23-9503-c5f0e018dc70","event":{"kind":"completed","task_id":"cae5e0df-d378-4a23-9503-c5f0e018dc70"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c583","stream":{"kind":"session","id":"01a079e0-55db-79f2-85b0-c8c2e4c1a43f"},"sequence":284,"recorded_at":1780531400000563,"record_type":"event","durability":"durable","causation_id":"38173c32-e836-4324-8339-ee117e4249f1","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38173c32-e836-4324-8339-ee117e4249f1","run_stream":{"kind":"run","id":"38173c32-e836-4324-8339-ee117e4249f1"},"call_id":"call_01a079e0ebc67e52b571bcd40210af57","text":"Read text file `internal/terminalbackend/refusal_arm_witnesses_test.go`.\n1|// Executed refusal-arm witnesses for the terminal backend packages.\n2|//\n3|// Every non-bound row of the white-box arm table\n4|// (refusal_arm_inventory_test.go) carries exactly one witness here,\n5|// keyed by the same identity the derivation uses. The harness runs each\n6|// witness through a PUBLIC production entry point and requires the exact\n7|// wire code at the exact static detail: a row that merely mentions the\n8|// detail in some test's source proves nothing and resolves nothing.\n9|//\n10|// Witness construction rule for shared-clause sites: several sites share\n11|// one (code, detail) clause (ten sites share \"document member type\").\n12|// Each prove documents the pass-earlier-sites construction — the input\n13|// passes every earlier same-clause site on its entry path and fails at\n14|// the named one — so the witness attributes the site, not just the\n15|// clause. Bound rows (defensive re-parses, unreachable vocabulary,\n16|// decoder-contract and canonical-plumbing branches, the kind gate, the\n17|// number walk) carry NO witness: no input refuses at their entry, and a\n18|// witness would resolve through a sibling. Their pins live white-box in\n19|// the pinned bound set.\n20|//\n21|// The both-direction harness runs in both packages: white-box proves\n22|// derived-arms against declared-rows, and TestDerivedArmsAreAllWitnessed\n23|// / TestWitnessedArmsAreAllDerived below prove declared-rows against\n24|// executed witnesses, so a truncated witness registry reddens instead of\n25|// passing vacuously.\n26|package terminalbackend_test\n27|\n28|import (\n29|\t\"fmt\"\n30|\t\"sort\"\n31|\t\"strings\"\n32|\t\"testing\"\n33|\t\"time\"\n34|\n35|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n36|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n37|)\n38|\n39|// armWitness proves one declared refusal arm at its public production\n40|// entry. Key equals terminalbackend.ArmKey over the row identity exactly:\n41|// TestWitnessedArmsAreAllDerived fails a witness that names nothing\n42|// production declares. Entry names the public entry the prove function\n43|// drives.\n44|type armWitness struct {\n45|\tkey   string\n46|\tentry string\n47|\tprove func(*testing.T)\n48|}\n49|\n50|// wkey renders one row identity in the shared witness key space,\n51|// matching terminalbackend.ArmKey exactly.\n52|func wkey(file, function, code, detail string, occurrence int) string {\n53|\treturn fmt.Sprintf(\"%s|%s|%s|%q#%d\", file, function, code, detail, occurrence)\n54|}\n55|\n56|// requireRegistryRefusal asserts err is a registry refusal satisfying\n57|// check with the exact static wantDetail clause.\n58|func requireRegistryRefusal(t *testing.T, err error, check func(error) bool, wantDetail string) {\n59|\tt.Helper()\n60|\tif !check(err) {\n61|\t\tt.Fatalf(\"error = %v, want a registry refusal at %q\", err, wantDetail)\n62|\t}\n63|\tif got := refusalDetail(t, err); got != wantDetail {\n64|\t\tt.Fatalf(\"refusal detail = %q, want %q\", got, wantDetail)\n65|\t}\n66|}\n67|\n68|// TestDerivedArmsAreAllWitnessed is the forward direction: every derived\n69|// non-bound arm carries an executed witness. A planted arm (a new\n70|// production site through an existing constructor) lands here as an\n71|// unwitnessed arm.\n72|func TestDerivedArmsAreAllWitnessed(t *testing.T) {\n73|\tt.Parallel()\n74|\n75|\tderived := terminalbackend.DerivedArmIdentities(t)\n76|\tdeclared := terminalbackend.DeclaredArmIdentities()\n77|\tbound := map[string]bool{}\n78|\tfor _, row := range declared {\n79|\t\tif row.Bound != \"\" {\n80|\t\t\tbound[terminalbackend.ArmKey(row)] = true\n81|\t\t}\n82|\t}\n83|\twitnessed := map[string]bool{}\n84|\tfor _, witness := range declaredArmWitnesses() {\n85|\t\twitnessed[witness.key] = true\n86|\t}\n87|\tvar missing []string\n88|\tfor _, arm := range derived {\n89|\t\tkey := terminalbackend.ArmKey(arm)\n90|\t\tif bound[key] {\n91|\t\t\tcontinue\n92|\t\t}\n93|\t\tif !witnessed[key] {\n94|\t\t\tmissing = append(missing, key)\n95|\t\t}\n96|\t}\n97|\tsort.Strings(missing)\n98|\tif len(missing) > 0 {\n99|\t\tt.Fatalf(\"derived refusal arm(s) with no executed witness at the production entry:\\n  %s\",\n100|\t\t\tstrings.Join(missing, \"\\n  \"))\n101|\t}\n102|\tt.Logf(\"refusal-arm witnesses: %d/%d derived arms executed\", len(derived)-len(missing)-len(bound), len(derived))\n103|}\n104|\n105|// TestWitnessedArmsAreAllDerived is the reverse direction: every witness\n106|// names a derived arm, and no witness names a bound arm (a bound arm has\n107|// no refusing input by construction; witnessing it would resolve through\n108|// a sibling). A deleted or narrowed production branch orphans its witness\n109|// and fails here, which is also what makes a truncated derivation fail\n110|// instead of passing vacuously.\n111|func TestWitnessedArmsAreAllDerived(t *testing.T) {\n112|\tt.Parallel()\n113|\n114|\tderived := map[string]bool{}\n115|\tfor _, arm := range terminalbackend.DerivedArmIdentities(t) {\n116|\t\tderived[terminalbackend.ArmKey(arm)] = true\n117|\t}\n118|\tbound := map[string]bool{}\n119|\tfor _, row := range terminalbackend.DeclaredArmIdentities() {\n120|\t\tif row.Bound != \"\" {\n121|\t\t\tbound[terminalbackend.ArmKey(row)] = true\n122|\t\t}\n123|\t}\n124|\tvar orphans []string\n125|\tfor _, witness := range declaredArmWitnesses() {\n126|\t\tif bound[witness.key] {\n127|\t\t\torphans = append(orphans, witness.key+\" (bound arm must not carry a witness)\")\n128|\t\t\tcontinue\n129|\t\t}\n130|\t\tif !derived[witness.key] {\n131|\t\t\torphans = append(orphans, witness.key+\" (\"+witness.entry+\")\")\n132|\t\t}\n133|\t}\n134|\tsort.Strings(orphans)\n135|\tif len(orphans) > 0 {\n136|\t\tt.Fatalf(\"witness(es) naming no derived production arm:\\n  %s\", strings.Join(orphans, \"\\n  \"))\n137|\t}\n138|}\n139|\n140|// TestEveryDeclaredArmRefusesAtItsEntry drives every witness through its\n141|// public production entry point and requires the attributed refusal.\n142|func TestEveryDeclaredArmRefusesAtItsEntry(t *testing.T) {\n143|\tt.Parallel()\n144|\n145|\tfor _, witness := range declaredArmWitnesses() {\n146|\t\tt.Run(witness.key, func(t *testing.T) {\n147|\t\t\tt.Parallel()\n148|\t\t\twitness.prove(t)\n149|\t\t})\n150|\t}\n151|}\n152|\n153|// conformanceWitnesses proves every non-bound conformance.go arm at its\n154|// public entry. Multi-occurrence groups use ordered inputs: each prove\n155|// passes the earlier same-clause sites and fails at the named one.\n156|func conformanceWitnesses() []armWitness {\n157|\treturn []armWitness{\n158|\t\t{\n159|\t\t\tkey:   wkey(\"conformance.go\", \"CheckAttachRequest\", \"CodeUnauthorized\", \"attach authorization binding\", 1),\n160|\t\t\tentry: \"CheckAttachRequest\",\n161|\t\t\tprove: func(t *testing.T) {\n162|\t\t\t\t// Wrong transport against a matching policy: the\n163|\t\t\t\t// transport parse passes, the binding comparison fires.\n164|\t\t\t\terr := terminalbackend.CheckAttachRequest(testAttachAuthorization(t), \"trusted_private_mesh\", true, conformanceNow())\n165|\t\t\t\trequireConformanceRefusal(t, err, \"terminal_backend_unauthorized\", \"attach authorization binding\")\n166|\t\t\t},\n167|\t\t},\n168|\t\t{\n169|\t\t\tkey:   wkey(\"conformance.go\", \"CheckAttachRequest\", \"CodeUnauthorized\", \"attach authorization expiry\", 1),\n170|\t\t\tentry: \"CheckAttachRequest\",\n171|\t\t\tprove: func(t *testing.T) {\n172|\t\t\t\t// Matching transport and input, instant past expiry: the\n173|\t\t\t\t// binding comparison passes, the expiry comparison fires.\n174|\t\t\t\texpired := conformanceNow().Add(48 * time.Hour)\n175|\t\t\t\terr := terminalbackend.CheckAttachRequest(testAttachAuthorization(t), \"local_only\", true, expired)\n176|\t\t\t\trequireConformanceRefusal(t, err, \"terminal_backend_unauthorized\", \"attach authorization expiry\")\n177|\t\t\t},\n178|\t\t},\n179|\t\t{\n180|\t\t\tkey:   wkey(\"conformance.go\", \"CheckAttachRequest\", \"CodeUnauthorized\", \"attach relay transport\", 1),\n181|\t\t\tentry: \"CheckAttachRequest\",\n182|\t\t\tprove: func(t *testing.T) {\n183|\t\t\t\t// A relay policy matches on transport and input, so only\n184|\t\t\t\t// the relay bar can refuse.\n185|\t\t\t\traw := `{\"policy_evidence_id\":\"` + testDigest + `\",` +\n186|\t\t\t\t\t`\"authorizing_host_id\":\"` + conformanceHost + `\",` +\n187|\t\t\t\t\t`\"transport\":\"third_party_relay\",` +\n188|\t\t\t\t\t`\"input_authorized\":false,` +\n189|\t\t\t\t\t`\"issued_at\":\"` + conformanceIssued + `\",` +\n190|\t\t\t\t\t`\"expires_at\":\"` + conformanceExpires + `\"}`\n191|\t\t\t\tauth, err := terminalbackend.ParseAttachAuthorization([]byte(raw))\n192|\t\t\t\tif err != nil {\n193|\t\t\t\t\tt.Fatalf(\"ParseAttachAuthorization(relay) error = %v\", err)\n194|\t\t\t\t}\n195|\t\t\t\terr = terminalbackend.CheckAttachRequest(auth, \"third_party_relay\", false, conformanceNow())\n196|\t\t\t\trequireConformanceRefusal(t, err, \"terminal_backend_unauthorized\", \"attach relay transport\")\n197|\t\t\t},\n198|\t\t},\n199|\t\t{\n200|\t\t\tkey:   wkey(\"conformance.go\", \"CheckAttachResult\", \"CodeUnauthorized\", \"attach input binding\", 1),\n201|\t\t\tentry: \"CheckAttachResult\",\n202|\t\t\tprove: func(t *testing.T) {\n203|\t\t\t\t// Result grants input the request withheld: the triple\n204|\t\t\t\t// equality fails on the result leg.\n205|\t\t\t\terr := terminalbackend.CheckAttachResult(false, true, testAttachAuthorization(t))\n206|\t\t\t\trequireConformanceRefusal(t, err, \"terminal_backend_unauthorized\", \"attach input binding\")\n207|\t\t\t},\n208|\t\t},\n209|\t\t{\n210|\t\t\tkey:   wkey(\"conformance.go\", \"CheckEntrypoint\", \"CodePreconditionFailed\", \"entrypoint argv\", 1),\n211|\t\t\tentry: \"CheckEntrypoint\",\n212|\t\t\tprove: func(t *testing.T) {\n213|\t\t\t\terr := terminalbackend.CheckEntrypoint([]string{\"codex\", conformanceSessionA}, conformanceSessionA)\n214|\t\t\t\trequireConformanceRefusal(t, err, \"local_precondition_failed\", \"entrypoint argv\")\n215|\t\t\t},\n216|\t\t},\n217|\t\t{\n218|\t\t\t// Occurrence order in CheckEntrypoint: #1 parses the session\n219|\t\t\t// ID, #2 parses argv[2], #3 compares the two. Each prove\n220|\t\t\t// passes the earlier parses.\n221|\t\t\tkey:   wkey(\"conformance.go\", \"CheckEntrypoint\", \"CodePreconditionFailed\", \"entrypoint session binding\", 1),\n222|\t\t\tentry: \"CheckEntrypoint\",\n223|\t\t\tprove: func(t *testing.T) {\n224|\t\t\t\t// Unparseable session ID: the argv shape passes, the\n225|\t\t\t\t// first session parse fires.\n226|\t\t\t\terr := terminalbackend.CheckEntrypoint([]string{\"ax\", \"pane\", conformanceSessionA}, \"bogus\")\n227|\t\t\t\trequireConformanceRefusal(t, err, \"local_precondition_failed\", \"entrypoint session binding\")\n228|\t\t\t},\n229|\t\t},\n230|\t\t{\n231|\t\t\tkey:   wkey(\"conformance.go\", \"CheckEntrypoint\", \"CodePreconditionFailed\", \"entrypoint session binding\", 2),\n232|\t\t\tentry: \"CheckEntrypoint\",\n233|\t\t\tprove: func(t *testing.T) {\n234|\t\t\t\t// Valid session ID, unparseable carried ID: #1 passes,\n235|\t\t\t\t// the second parse fires.\n236|\t\t\t\terr := terminalbackend.CheckEntrypoint([]string{\"ax\", \"pane\", \"bogus\"}, conformanceSessionA)\n237|\t\t\t\trequireConformanceRefusal(t, err, \"local_precondition_failed\", \"entrypoint session binding\")\n238