{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c731","stream":{"kind":"session","id":"01a079e0-55db-79f2-85b0-c8c2e4c1a43f"},"sequence":499,"recorded_at":1780531400000993,"record_type":"event","durability":"durable","causation_id":"38173c32-e836-4324-8339-ee117e4249f1","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"38173c32-e836-4324-8339-ee117e4249f1","run_stream":{"kind":"run","id":"38173c32-e836-4324-8339-ee117e4249f1"},"task_stream":{"kind":"task","id":"74be01b0-e48f-47c6-8064-2d7e2a566780"},"task_id":"74be01b0-e48f-47c6-8064-2d7e2a566780","event":{"kind":"output","task_id":"74be01b0-e48f-47c6-8064-2d7e2a566780","chunk":"Read text file `internal/terminalbackend/refusal_arm_inventory_test.go`.\n(899 line(s) above)\n900|\t}\n901|\tfor _, row := range declaredRows() {\n902|\t\tif row.bound == \"\" {\n903|\t\t\tcontinue\n904|\t\t}\n905|\t\twantBound, pinned := want[describeRow(row)]\n906|\t\tif !pinned {\n907|\t\t\tt.Errorf(\"declared row %s claims a bound outside the pinned set; \"+\n908|\t\t\t\t\"a new defensive arm joins deliberately or not at all\", describeRow(row))\n909|\t\t\tcontinue\n910|\t\t}\n911|\t\tif row.bound != wantBound {\n912|\t\t\tt.Errorf(\"declared row %s carries bound %q, want the pinned %q\",\n913|\t\t\t\tdescribeRow(row), row.bound, wantBound)\n914|\t\t}\n915|\t}\n916|\tbound := 0\n917|\tfor _, row := range declaredRows() {\n918|\t\tif row.bound != \"\" {\n919|\t\t\tbound++\n920|\t\t}\n921|\t}\n922|\tif bound != len(want) {\n923|\t\tt.Errorf(\"declared %d bound rows, want exactly the pinned %d\", bound, len(want))\n924|\t}\n925|}\n926|\n927|// TestCheckTransitionOperationVocabularyIsUnreachable proves the bound on\n928|// CheckTransition's \"operation vocabulary\" arm: CheckTransition parses\n929|// its operation through ParseOperation first, so the lookupTransition\n930|// miss branch fires only for an operation ParseOperation admits that the\n931|// table does not cover. Every admitted operation resolves, so no input\n932|// reaches the arm; adding an operation to ParseOperation without a table\n933|// row fails here and promotes the row back to a witnessed arm.\n934|func TestCheckTransitionOperationVocabularyIsUnreachable(t *testing.T) {\n935|\tt.Parallel()\n936|\n937|\t// The admitted set is derived from ParseOperation's own switch, never\n938|\t// listed: an eleventh admitted operation without a table row fails\n939|\t// below and promotes the vocabulary row back to a witnessed arm.\n940|\tadmitted := parseOperationAdmittedSet(t)\n941|\tif len(admitted) != 10 {\n942|\t\tt.Fatalf(\"ParseOperation admits %d operations, want the ten closed operations; the pin must move with the vocabulary\", len(admitted))\n943|\t}\n944|\tfor _, operation := range admitted {\n945|\t\tif _, err := ParseOperation(operation); err != nil {\n946|\t\t\tt.Errorf(\"ParseOperation(%q) = %v, want admitted\", operation, err)\n947|\t\t}\n948|\t\tif _, known := lookupTransition(Operation(operation)); !known {\n949|\t\t\tt.Errorf(\"lookupTransition(%q) misses, so CheckTransition's vocabulary arm is reachable: witness it\", operation)\n950|\t\t}\n951|\t}\n952|}\n953|\n954|// parseOperationAdmittedSet derives the exact string set ParseOperation\n955|// admits from its production switch cases: the case clauses name the\n956|// Operation constants, whose values resolve from the production const\n957|// declarations in the same scan.\n958|func parseOperationAdmittedSet(t *testing.T) []string {\n959|\tt.Helper()\n960|\n961|\tfiles, _ := invcore.MustScanProduction(t, \".\")\n962|\tconstants := map[string]string{}\n963|\tfor _, production := range files {\n964|\t\tfor _, declaration := range production.Syntax.Decls {\n965|\t\t\tgeneral, ok := declaration.(*ast.GenDecl)\n966|\t\t\tif !ok || general.Tok != token.CONST {\n967|\t\t\t\tcontinue\n968|\t\t\t}\n969|\t\t\tfor _, specification := range general.Specs {\n970|\t\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n971|\t\t\t\tif !ok {\n972|\t\t\t\t\tcontinue\n973|\t\t\t\t}\n974|\t\t\t\tfor index, name := range value.Names {\n975|\t\t\t\t\tif index >= len(value.Values) {\n976|\t\t\t\t\t\tcontinue\n977|\t\t\t\t\t}\n978|\t\t\t\t\tliteral, ok := value.Values[index].(*ast.BasicLit)\n979|\t\t\t\t\tif !ok || literal.Kind != token.STRING {\n980|\t\t\t\t\t\tcontinue\n981|\t\t\t\t\t}\n982|\t\t\t\t\ttext, err := strconv.Unquote(literal.Value)\n983|\t\t\t\t\tif err != nil {\n984|\t\t\t\t\t\tt.Fatalf(\"unquote const %s: %v\", name.Name, err)\n985|\t\t\t\t\t}\n986|\t\t\t\t\tconstants[name.Name] = text\n987|\t\t\t\t}\n988|\t\t\t}\n989|\t\t}\n990|\t}\n991|\tvar admitted []string\n992|\tfor _, production := range files {\n993|\t\tif production.Name != \"conformance.go\" {\n994|\t\t\tcontinue\n995|\t\t}\n996|\t\tfor _, declaration := range production.Syntax.Decls {\n997|\t\t\tfunction, ok := declaration.(*ast.FuncDecl)\n998|\t\t\tif !ok || function.Name.Name != \"ParseOperation\" {\n999|\t\t\t\tcontinue\n1000|\t\t\t}\n1001|\t\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n1002|\t\t\t\tclause, ok := node.(*ast.CaseClause)\n1003|\t\t\t\tif !ok || clause.List == nil {\n1004|\t\t\t\t\treturn true\n1005|\t\t\t\t}\n1006|\t\t\t\tfor _, expression := range clause.List {\n1007|\t\t\t\t\tidentifier, ok := expression.(*ast.Ident)\n1008|\t\t\t\t\tif !ok {\n1009|\t\t\t\t\t\tt.Fatalf(\"ParseOperation admits a non-constant case; the pin cannot name what it cannot read\")\n1010|\t\t\t\t\t}\n1011|\t\t\t\t\ttext, known := constants[identifier.Name]\n1012|\t\t\t\t\tif !known {\n1013|\t\t\t\t\t\tt.Fatalf(\"ParseOperation admits unresolved constant %s\", identifier.Name)\n1014|\t\t\t\t\t}\n1015|\t\t\t\t\tadmitted = append(admitted, text)\n1016|\t\t\t\t}\n1017|\t\t\t\treturn true\n1018|\t\t\t})\n1019|\t\t}\n1020|\t}\n1021|\tif len(admitted) == 0 {\n1022|\t\tt.Fatal(\"derived zero admitted operations; the scanner is broken, not the package\")\n1023|\t}\n1024|\treturn admitted\n1025|}\n1026|\n1027|// TestDecodeCappedValueDefensiveSitesAreUnreachable pins the decoder\n1028|// contract boundDecoderContract relies on: encoding/json Token() errors\n1029|// on non-string object keys and on stray delimiters at value positions\n1030|// instead of yielding them, so decodeCappedValue's key-shape (#3) and\n1031|// stray-delimiter (#6) branches have no input. A Go release that yields\n1032|// either value fails here and promotes both rows back to witnessed arms.\n1033|func TestDecodeCappedValueDefensiveSitesAreUnreachable(t *testing.T) {\n1034|\tt.Parallel()\n1035|\n1036|\tnonStringKeys := []string{\n1037|\t\t`{1:2}`, `{true:1}`, `{null:1}`, `{[1]:2}`,\n1038|\t}\n1039|\tfor _, raw := range nonStringKeys {\n1040|\t\tdecoder := json.NewDecoder(bytes.NewReader([]byte(raw)))\n1041|\t\tif _, err := decoder.Token(); err != nil {\n1042|\t\t\tt.Fatalf(\"Token() opener at %q = %v, want the object delimiter\", raw, err)\n1043|\t\t}\n1044|\t\tif token, err := decoder.Token(); err == nil {\n1045|\t\t\tt.Errorf(\"Token() key at %q = %#v, want an error: a yielded key would reach the defensive branch\", raw, token)\n1046|\t\t}\n1047|\t\tif _, err := decodeCappedValue(json.NewDecoder(bytes.NewReader([]byte(raw))), 0); err == nil {\n1048|\t\t\tt.Errorf(\"decodeCappedValue(%q) = nil, want a document syntax refusal\", raw)\n1049|\t\t}\n1050|\t}\n1051|\tstrayDelimiters := []string{`]`, `}`, `{\"a\":}`, `[1,]`, `{\"a\":1,}`, `{\"a\" \"b\"}`}\n1052|\tfor _, raw := range strayDelimiters {\n1053|\t\tdecoder := json.NewDecoder(bytes.NewReader([]byte(raw)))\n1054|\t\tdecoder.Token()\n1055|\t\tif _, err := decodeCappedValue(json.NewDecoder(bytes.NewReader([]byte(raw))), 0); err == nil {\n1056|\t\t\tt.Errorf(\"decodeCappedValue(%q) = nil, want a document syntax refusal\", raw)\n1057|\t\t}\n1058|\t}\n1059|}\n1060|\n1061|// TestCanonicalPlumbingIsTotalOnDecodedMaps pins the totality\n1062|// boundCanonicalPlumbing relies on: objectIdentity succeeds over every\n1063|// JSON-decodable shape (nested, empty, unicode, boundary strings) and\n1064|// UnsignedEvidenceBytes succeeds over adversarial typed evidence, so the\n1065|// four Marshal/JCS error branches have no input in the reachable class.\n1066|// A new shape that breaks the plumbing fails here and promotes those\n1067|// rows back to witnessed arms.\n1068|func TestCanonicalPlumbingIsTotalOnDecodedMaps(t *testing.T) {\n1069|\tt.Parallel()\n1070|\n1071|\tadversarial := []map[string]any{\n1072|\t\t{},\n1073|\t\t{\"empty\": map[string]any{}, \"list\": []any{}, \"nothing\": nil},\n1074|\t\t{\"nested\": map[string]any{\"deeper\": map[string]any{\"deepest\": []any{\"a\", true, nil}}}},\n1075|\t\t{\"unicode\": \"é界🎉\", \"controls\": \"a\\x00b\\nc\\td\", \"empty\": \"\"},\n1076|\t\t{\"long\": strings.Repeat(\"g\", 100000)},\n1077|\t\t{\"bools\": []any{true, false}, \"mixed\": map[string]any{\"x\": \"y\"}},\n1078|\t}\n1079|\tfor index, object := range adversarial {\n1080|\t\tif _, err := objectIdentity(object, \"missing-self\"); err != nil {\n1081|\t\t\tt.Errorf(\"objectIdentity(adversarial[%d]) = %v, want success: the plumbing arms are dead on decoded maps\", index, err)\n1082|\t\t}\n1083|\t}\n1084|\tplatform, err := scalar.ParsePlatform(\"linux\")\n1085|\tif err != nil {\n1086|\t\tt.Fatalf(\"ParsePlatform() error = %v\", err)\n1087|\t}\n1088|\tobserved, err := scalar.ParseTimestamp(\"2026-01-15T12:00:00.000Z\")\n1089|\tif err != nil {\n1090|\t\tt.Fatalf(\"ParseTimestamp() error = %v\", err)\n1091|\t}\n1092|\tfor _, osVersion := range []string{\"\", strings.Repeat(\"é\", 1000), \"ok\\xffbad\", \"controls-\\x00\\n\\t\"} {\n1093|\t\tevidence := Evidence{\n1094|\t\t\tTerminalBackendID: \"com.example.term\", ImplementationVersion: \"1.2.3\",\n1095|\t\t\tProtocolVersion: \"1.0.0\", BackendGenerationDigest: \"sha256:00\",\n1096|\t\t\tCapability: \"graceful_stop\", Platform: platform, OSVersion: osVersion,\n1097|\t\t\tConformanceFixtureID: \"sha256:00\", ObservedAt: observed, ExpiresAt: observed,\n1098|\t\t\tIssuer: \"ax_local_probe\", IssuerID: \"sha256:00\",\n1099|\t\t\tFacts: []string{\"fixture_passed\", \"\", \"é\"},\n1100|\t\t}\n1101|\t\tif _, err := UnsignedEvidenceBytes(evidence); err != nil {\n1102|\t\t\tt.Errorf(\"UnsignedEvidenceBytes(os_version=%q) = %v, want success\", osVersion, err)\n1103|\t\t}\n1104|\t}\n1105|}\n1106|\n1107|// TestShadowedLookupsHaveNoInput pins boundShadowedLookup structurally:\n1108|// the member lists equal the exact expected slices, and every shadowed\n1109|// lookup names a member of its shadowing list. A list that loses a\n1110|// member may un-shadow its miss arm into a live one; a lookup of a\n1111|// member outside its shadowing list was never shadowed at all. Either\n1112|// change fails here and promotes the affected rows back to witnessed\n1113|// arms. The shadowing exact CALLS are pinned by the extra-member\n1114|// witnesses (one per entry), which fail if an exact call is removed.\n1115|func TestShadowedLookupsHaveNoInput(t *testing.T) {\n1116|\tt.Parallel()\n1117|\n1118|\tequalLists := func(name string, got, want []string) {\n1119|\t\tt.Helper()\n1120|\t\tif len(got) != len(want) {\n1121|\t\t\tt.Fatalf(\"%s = %v, want exactly %v: a lost member may un-shadow a bound miss arm\", name, got, want)\n1122|\t\t}\n1123|\t\tfor index := range want {\n1124|\t\t\tif got[index] != want[index] {\n1125|\t\t\t\tt.Fatalf(\"%s = %v, want exactly %v: a moved member may un-shadow a bound miss arm\", name, got, want)\n1126|\t\t\t}\n1127|\t\t}\n1128|\t}\n1129|\tequalLists(\"manifestMembers\", manifestMembers, []string{\n1130|\t\t\"schema\", \"schema_version\", \"manifest_id\", \"terminal_backend_id\",\n1131|\t\t\"implementation_version\", \"protocol_versions\", \"platforms\",\n1132|\t\t\"implementation_kind\", \"executable_digest\", \"static_capability_claims\",\n1133|\t\t\"conformance_fixture_id\", \"extensions\",\n1134|\t})\n1135|\tequalLists(\"probeMembers\", probeMembers, []string{\n1136|\t\t\"schema\", \"schema_version\", \"probe_id\", \"terminal_backend_id\",\n1137|\t\t\"implementation_version\", \"protocol_version\", \"implementation_kind\",\n1138|\t\t\"executable_digest\", \"platform\", \"os_version\", \"availability\",\n1139|\t\t\"backend_generation_digest\", \"capability_claims\", \"evidence_ids\",\n1140|\t\t\"probed_at\", \"extensions\",\n1141|\t})\n1142|\tequalLists(\"evidenceMembers\", evidenceMembers, []string{\n1143|\t\t\"schema\", \"schema_version\", \"evidence_id\", \"terminal_backend_id\",\n1144|\t\t\"implementation_version\", \"protocol_version\", \"backend_generation_digest\",\n1145|\t\t\"capability\", \"value\", \"platform\", \"os_version\", \"conformance_fixture_id\",\n1146|\t\t\"observed_at\", \"expires_at\", \"issuer\", \"issuer_id\",\n1147|\t\t\"attestation_signature\", \"facts\", \"terminal_binding_id\", \"provider_id\",\n1148|\t\t\"provider_build\", \"sentinel_result\", \"provider_auth_smoke_result\",\n1149|\t\t\"extensions\",\n1150|\t})\n1151|\tequalLists(\"attachAuthorizationMembers\", attachAuthorizationMembers, []string{\n1152|\t\t\"policy_evidence_id\", \"authorizing_host_id\", \"transport\",\n1153|\t\t\"input_authorized\", \"issued_at\", \"expires_at\",\n1154|\t})\n1155|\tcontains := func(list []string, member string) bool {\n1156|\t\tfor _, candidate := range list {\n1157|\t\t\tif candidate == member {\n1158|\t\t\t\treturn true\n1159|\t\t\t}\n1160|\t\t}\n1161|\t\treturn false\n1162|\t}\n1163|\t// Every shadowed lookup names a member of its shadowing list: the\n1164|\t// shadowing check passing implies the lookup succeeds.\n1165|\tshadowed := []struct {\n1166|\t\tlist   []string\n1167|\t\tmember string\n1168|\t}{\n1169|\t\t{attachAuthorizationMembers, \"input_authorized\"},\n1170|\t\t{manifestMembers, \"static_capability_claims\"},\n1171|\t\t{probeMembers, \"capability_claims\"},\n1172|\t\t{manifestMembers, \"executable_digest\"},\n1173|\t\t{probeMembers, \"executable_digest\"},\n1174|\t\t{evidenceMembers, \"terminal_binding_id\"},\n1175|\t\t{manifestMembers, \"protocol_versions\"},\n1176|\t\t{manifestMembers, \"platforms\"},\n1177|\t\t{probeMembers, \"evidence_ids\"},\n1178|\t\t{evidenceMembers, \"facts\"},\n1179|\t\t{manifestMembers, \"extensions\"},\n1180|\t\t{probeMembers, \"extensions\"},\n1181|\t\t{evidenceMembers, \"extensions\"},\n1182|\t\t{evidenceMembers, \"provider_id\"},\n1183|\t\t{evidenceMembers, \"provider_build\"},\n1184|\t\t{evidenceMembers, \"sentinel_result\"},\n1185|\t\t{evidenceMembers, \"provider_auth_smoke_result\"},\n1186|\t\t// parseClaim's inline claim-member list shadows the claim\n1187|\t\t// extractors (dependent_operations, evidence_requirements) the\n1188|\t\t// same way; the list itself is derived below, never listed.\n1189|\t\t{parseClaimMemberList(t), \"dependent_operations\"},\n1190|\t\t{parseClaimMemberList(t), \"evidence_requirements\"},\n1191|\t}\n1192|\tfor _, entry := range shadowed {\n1193|\t\tif !contains(entry.list, entry.member) {\n1194|\t\t\tt.Errorf(\"shadowed lookup of %q names no member of its shadowing list: it was never shadowed\", entry.member)\n1195|\t\t}\n1196|\t}\n1197|}\n1198|\n1199|// parseClaimMemberList derives parseClaim's inline exact-member list from\n1200|// the production AST: the slice literal passed to checkExactMembers\n1201|// inside parseClaim. A member removed from the call may un-shadow the\n1202|// claim extractors into live miss arms.\n1203|func parseClaimMemberList(t *testing.T) []string {\n1204|\tt.Helper()\n1205|\n1206|\tfiles, _ := invcore.MustScanProduction(t, \".\")\n1207|\tfor _, production := range files {\n1208|\t\tif production.Name != \"manifest.go\" {\n1209|\t\t\tcontinue\n1210|\t\t}\n1211|\t\tfor _, declaration := range production.Syntax.Decls {\n1212|\t\t\tfunction, ok := declaration.(*ast.FuncDecl)\n1213|\t\t\tif !ok || function.Name.Name != \"parseClaim\" {\n1214|\t\t\t\tcontinue\n1215|\t\t\t}\n1216|\t\t\tvar members []string\n1217|\t\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n1218|\t\t\t\tcall, ok := node.(*ast.CallExpr)\n1219|\t\t\t\tif !ok {\n1220|\t\t\t\t\treturn true\n1221|\t\t\t\t}\n1222|\t\t\t\tidentifier, ok := call.Fun.(*ast.Ident)\n1223|\t\t\t\tif !ok || identifier.Name != \"checkExactMembers\" || len(call.Args) != 2 {\n1224|\t\t\t\t\treturn true\n1225|\t\t\t\t}\n1226|\t\t\t\tliteral, ok := call.Args[1].(*ast.CompositeLit)\n1227|\t\t\t\tif !ok {\n1228|\t\t\t\t\tt.Fatalf(\"parseClaim checks members against a non-literal list; the pin cannot name it\")\n1229|\t\t\t\t}\n1230|\t\t\t\tfor _, element := range literal.Elts {\n1231|\t\t\t\t\tbasic, ok := element.(*ast.BasicLit)\n1232|\t\t\t\t\tif !ok || basic.Kind != token.STRING {\n1233|\t\t\t\t\t\tt.Fatalf(\"parseClaim member list holds a non-literal; the pin cannot name it\")\n1234|\t\t\t\t\t}\n1235|\t\t\t\t\ttext, err := strconv.Unquote(basic.Value)\n1236|\t\t\t\t\tif err != nil {\n1237|\t\t\t\t\t\tt.Fatalf(\"unquote claim member: %v\", err)\n1238|\t\t\t\t\t}\n1239|\t\t\t\t\tmembers = append(members, text)\n1240|\t\t\t\t}\n1241|\t\t\t\treturn true\n1242|\t\t\t})\n1243|\t\t\tif len(members) == 0 {\n1244|\t\t\t\tt.Fatal(\"derived zero parseClaim members; the scanner is broken, not the package\")\n1245|\t\t\t}\n1246|\t\t\twant := []string{\"capability\", \"origin\", \"value\", \"generation_variable\", \"dependent_operations\", \"evidence_requirements\"}\n1247|\t\t\tif len(members) != len(want) {\n1248|\t\t\t\tt.Fatalf(\"parseClaim checks %v, want exactly %v: a lost member may un-shadow a bound miss arm\", members, want)\n1249|\t\t\t}\n1250|\t\t\tfor index := range want {\n1251|\t\t\t\tif members[index] != want[index] {\n1252|\t\t\t\t\tt.Fatalf(\"parseClaim checks %v, want exactly %v: a moved member may un-shadow a bound miss arm\", members, want)\n1253|\t\t\t\t}\n1254|\t\t\t}\n1255|\t\t\treturn members\n1256|\t\t}\n1257|\t}\n1258|\tt.Fatal(\"production func parseClaim not found in manifest.go\")\n1259|\treturn nil\n1260|}\n1261|\n1262|// TestPlatformFunnelDetailsAreExactlyThese derives the error set of\n1263|// validatePlatforms from the production AST and requires it to equal the\n1264|// funneled set: a fourth platform error widens the funnel this test pins.\n1265|func TestPlatformFunnelDetailsAreExactlyThese(t *testing.T) {\n1266|\tt.Parallel()\n1267|\n1268|\t// Selection and fail-closed parsing are the shared core's; the\n1269|\t// relative path relies on the test working directory, as before.\n1270|\tsource, err := os.ReadFile(\"terminalbackend.go\")\n1271|\tif err != nil {\n1272|\t\tt.Fatalf(\"parse terminalbackend.go: %v\", err)\n1273|\t}\n1274|\tfile, _, failure := invcore.ParseBytes(\"terminalbackend.go\", source, 0)\n1275|\tif failure != \"\" {\n1276|\t\tt.Fatalf(\"parse terminalbackend.go: %s\", failure)\n1277|\t}\n1278|\tdetails := map[string]bool{}\n1279|\tfor _, declaration := range file.Decls {\n1280|\t\tfunction, ok := declaration.(*ast.FuncDecl)\n1281|\t\tif !ok || function.Name.Name != \"validatePlatforms\" {\n1282|\t\t\tcontinue\n1283|\t\t}\n1284|\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n1285|\t\t\tcall, ok := node.(*ast.CallExpr)\n1286|\t\t\tif !ok {\n1287|\t\t\t\treturn true\n1288|\t\t\t}\n1289|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n1290|\t\t\tif !ok || selector.Sel.Name != \"New\" {\n1291|\t\t\t\treturn true\n1292|\t\t\t}\n1293|\t\t\treceiver, ok := selector.X.(*ast.Ident)\n1294|\t\t\tif !ok || receiver.Name != \"errors\" || len(call.Args) != 1 {\n1295|\t\t\t\treturn true\n1296|\t\t\t}\n1297|\t\t\tliteral, ok := call.Args[0].(*ast.BasicLit)\n1298|\t\t\tif !ok || literal.Kind != token.STRING {\n1299|\t\t\t\tt.Fatalf(\"validatePlatforms error is not a static literal\")\n(more lines below)"}}}
