{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb21","stream":{"kind":"session","id":"01a079e0-55db-79f2-85b0-c8c2e4c1a43f"},"sequence":1003,"recorded_at":1780531400002001,"record_type":"event","durability":"durable","causation_id":"38173c32-e836-4324-8339-ee117e4249f1","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"38173c32-e836-4324-8339-ee117e4249f1","run_stream":{"kind":"run","id":"38173c32-e836-4324-8339-ee117e4249f1"},"task_stream":{"kind":"task","id":"440ec5d5-4265-469f-8e24-546b982d780a"},"task_id":"440ec5d5-4265-469f-8e24-546b982d780a","event":{"kind":"output","task_id":"440ec5d5-4265-469f-8e24-546b982d780a","chunk":"edited\nchanged lines: lines 311-319\n--- original\n+++ updated\n@@\n-\toccurrences := make(map[refusalArm]int)\n-\tfor index := range arms {\n-\t\tkey := arms[index]\n-\t\tkey.occurrence = 0\n-\t\toccurrences[key]++\n-\t\tarms[index].occurrence = occurrences[key]\n-\t}\n-\treturn arms\n-}\n+\toccurrences := make(map[refusalArm]int)\n+\tfor index := range arms {\n+\t\tkey := arms[index]\n+\t\tkey.occurrence = 0\n+\t\toccurrences[key]++\n+\t\tarms[index].occurrence = occurrences[key]\n+\t}\n+\t// One line attributes one arm. Two arms sharing a file:line would\n+\t// record the same exercised site, so a shadowed twin would hide\n+\t// behind its sibling exactly the way P8 did before the site audit\n+\t// existed. Keep one construction per line instead.\n+\tseenLines := make(map[string]string)\n+\tfor _, arm := range arms {\n+\t\tsite := arm.file + \":\" + strconv.Itoa(arm.line)\n+\t\tif first, duplicate := seenLines[site]; duplicate {\n+\t\t\tt.Fatalf(\"derived arms %s and %s share production line %s; \"+\n+\t\t\t\t\"one line cannot attribute two arms, split the constructions\",\n+\t\t\t\tfirst, describeArm(arm), site)\n+\t\t}\n+\t\tseenLines[site] = describeArm(arm)\n+\t}\n+\treturn arms\n+}\n"}}}
