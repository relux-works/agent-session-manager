hing [a-z][a-z0-9]*(?:[.-][a-z0-9]+)*. It admits the reserved ax.\n129|// namespace only for the two canonical built-ins; every other ax.-prefixed ID\n130|// is refused so a third party cannot mint a trusted-looking identity.\n131|func ParseID(value string) (string, error) {\n132|\tif !utf8.ValidString(value) || len(value) < 1 || len(value) > maxIDBytes {\n133|\t\treturn \"\", &Error{Code: CodeNotFound, Detail: \"terminal_backend_id bound\"}\n134|\t}\n135|\tif !idPattern.MatchString(value) {\n136|\t\treturn \"\", &Error{Code: CodeNotFound, BackendID: value, Detail: \"terminal_backend_id grammar\"}\n137|\t}\n138|\tif strings.HasPrefix(value, reservedNamespace) && value != BuiltinTmux && value != BuiltinConpty {\n139|\t\treturn \"\", &Error{Code: CodeNotFound, BackendID: value, Detail: \"terminal_backend_id reserved namespace\"}\n140|\t}\n141|\treturn value, nil\n142|}\n143|\n144|// mustParseID is the internal admission used where the caller already holds a\n145|// validated record. It duplicates the ParseID rule so a Registry can never\n146|// hold an identity its own grammar refuses.\n147|func mustParseID(value string) error {\n148|\t_, err := ParseID(value)\n149|\treturn err\n150|}\n151|\n152|// Kind is the Section 4.B implementation_kind vocabulary.\n153|type Kind string\n154|\n155|// Implementation kinds. Built-ins run inside the ax binary; externals arrive\n156|// as adapter executables over the Section 4.B argv/framing wire.\n157|const (\n158|\tKindBuiltinGo         Kind = \"builtin_go\"\n159|\tKindLocalProgram      Kind = \"local_program\"\n160|\tKindTrustedExecutable Kind = \"trusted_executable\"\n161|\tKindNativeRuntime     Kind = \"native_runtime\"\n162|)\n163|\n164|// parseKind admits exactly the closed Section 4.B vocabulary.\n165|func parseKind(value string) (Kind, error) {\n166|\tswitch Kind(value) {\n167|\tcase KindBuiltinGo, KindLocalProgram, KindTrustedExecutable, KindNativeRuntime:\n168|\t\treturn Kind(value), nil\n169|\tdefault:\n170|\t\treturn \"\", &Error{Code: CodeNotFound, Detail: \"implementation_kind vocabulary\"}\n171|\t}\n172|}\n173|\n174|// needsDigest reports whether the kind carries an executable digest. Section\n(more lines below)"}}}
