{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d0c1","stream":{"kind":"session","id":"01a079e0-55db-79f2-85b0-c8c2e4c1a43f"},"sequence":1723,"recorded_at":1780531400003441,"record_type":"event","durability":"durable","causation_id":"38173c32-e836-4324-8339-ee117e4249f1","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"38173c32-e836-4324-8339-ee117e4249f1","run_stream":{"kind":"run","id":"38173c32-e836-4324-8339-ee117e4249f1"},"task_stream":{"kind":"task","id":"3625c4c8-5e94-43d6-9ffa-797b17b73707"},"task_id":"3625c4c8-5e94-43d6-9ffa-797b17b73707","event":{"kind":"output","task_id":"3625c4c8-5e94-43d6-9ffa-797b17b73707","chunk":"edited\nchanged lines: lines 1697-1816\n--- original\n+++ updated\n@@\n-// shadowMissMembers resolves the full looked-up member set of one miss:\n-// its fixed literals plus, for a parameter lookup, every string literal\n-// passed for a name argument at any production call site of the miss's\n-// helper. A non-literal name argument fails the test: an unreadable\n-// member cannot prove cover.\n-func shadowMissMembers(t *testing.T, miss shadowMiss, calls map[string][]shadowCall) []string {\n-\tt.Helper()\n-\n-\tseen := map[string]bool{}\n-\tvar members []string\n-\tfor _, member := range miss.fixed {\n-\t\tif !seen[member] {\n-\t\t\tseen[member] = true\n-\t\t\tmembers = append(members, member)\n-\t\t}\n-\t}\n-\tif len(miss.fixed) > 0 {\n-\t\t// A fixed-literal miss names its members at the site; call-site\n-\t\t// arguments belong to other parameters (parseRealmProvider takes\n-\t\t// only the map) or other helpers.\n-\t\treturn members\n-\t}\n-\tfor _, call := range calls[miss.function] {\n-\t\tfor _, literal := range call.literals {\n-\t\t\tif !seen[literal] {\n-\t\t\t\tseen[literal] = true\n-\t\t\t\tmembers = append(members, literal)\n-\t\t\t}\n-\t\t}\n-\t\t// A name argument that is not a string literal leaves members\n-\t\t// the analysis cannot name: fail, neve