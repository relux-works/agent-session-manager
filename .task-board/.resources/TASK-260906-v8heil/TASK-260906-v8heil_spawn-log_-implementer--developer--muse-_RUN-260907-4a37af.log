{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c54b","stream":{"kind":"session","id":"01a079e0-55db-79f2-85b0-c8c2e4c1a43f"},"sequence":256,"recorded_at":1780531400000507,"record_type":"event","durability":"durable","causation_id":"38173c32-e836-4324-8339-ee117e4249f1","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38173c32-e836-4324-8339-ee117e4249f1","run_stream":{"kind":"run","id":"38173c32-e836-4324-8339-ee117e4249f1"},"call_id":"call_01a079e0e3477061b1939f7645dbd615","text":"Read text file `internal/invcore/invcore.go`.\n1|// Package invcore is the shared test-support core for production-derived\n2|// inventories: production-file selection, fail-closed parsing, and the\n3|// both-direction check harness.\n4|//\n5|// Every package inventory in this repository derives its denominator from\n6|// production source instead of listing it, in three historical\n7|// architectures for the same idea: terminalbackend resolves declared rows\n8|// textually and refuses constructor aliasing outright; provhost executes\n9|// every witness through the production entry point and keys on identifier\n10|// names behind a separate call-site audit; provider instruments constructor\n11|// vars at runtime in TestMain and audits the exercised file:line set\n12|// against AST-derived sites. The weaker bound was the real bound, so this\n13|// core carries the UNION of those directions, not the intersection:\n14|//\n15|//   - ScanProduction owns production-file selection: directory-derived,\n16|//     every *.go except *_test.go, sorted, so a new production file is\n17|//     scanned without anyone remembering it. Zero files is a failure,\n18|//     never a vacuous pass.\n19|//   - MustParse owns fail-closed parsing: an unparseable file fails, never\n20|//     skips. A file the derivation cannot read proves nothing.\n21|//   - DiffSets owns the both-direction harness: derived-without-row\n22|//     (unregistered site) AND row-without-site (orphan row) fail together.\n23|//     The forward direction alone passes vacuously on a truncated\n24|//     derivation.\n25|//   - AuditConstructorReferences owns the alias-bypass union: constructor\n26|//     references outside direct-call position fail outright\n27|//     (terminalbackend direction), import aliases and dot imports resolve\n28|//     against the imported path instead of the local spelling (the shape\n29|//     that walked through every identifier-keyed gate in this repository),\n30|//     and var bindings are references, not calls (provider direction made\n31|//     static). Anything the audit cannot classify — a dot import of a\n32|//     watched path, an unresolved shadowing — fails closed as\n33|//     unclassifiable, never pruned.\n34|//   - SiteRecorder owns the runtime direction (provider/provhost shape):\n35|//     instrumented constructor vars record the production file:line behind\n36|//     every exercised refusal, and the audit requires the exercised set to\n37|//     equal the derived site set in both directions.\n38|//\n39|// All checks come in two spellings: a pure func returning failures for\n40|// negative tests and control plants, and a Must wrapper that fails the\n41|// suite. A gate that can only fatal cannot be planted against, and a plant\n42|// that cannot run proves nothing.\n43|package invcore\n44|\n45|import (\n46|\t\"go/ast\"\n47|\t\"go/parser\"\n48|\t\"go/token\"\n49|\t\"os\"\n50|\t\"path/filepath\"\n51|\t\"sort\"\n52|\t\"strconv\"\n53|\t\"strings\"\n54|)\n55|\n56|// ProductionFile is one parsed production source: basename, full path,\n57|// raw bytes, and syntax parsed with a directory-shared FileSet.\n58|type ProductionFile struct {\n59|\tName   string\n60|\tPath   string\n61|\tSource []byte\n62|\tSyntax *ast.File\n63|\tFile   *token.File\n64|}\n65|\n66|// ScanProduction reads every production file of the directory at dir:\n67|// every *.go except *_test.go, in sorted order. It returns the parsed\n68|// files with their shared FileSet, plus a failure string for every\n69|// fail-closed condition: an unreadable directory, an unreadable file, an\n70|// unparseable file, or zero production files. An empty failure slice with\n71|// an empty file list is impossible by construction.\n72|func ScanProduction(dir string) ([]ProductionFile, *token.FileSet, []string) {\n73|\tentries, err := os.ReadDir(dir)\n74|\tif err != nil {\n75|\t\treturn nil, nil, []string{\"scan production files: read \" + dir + \": \" + err.Error()}\n76|\t}\n77|\tvar names []string\n78|\tfor _, entry := range entries {\n79|\t\tname := entry.Name()\n80|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n81|\t\t\tcontinue\n82|\t\t}\n83|\t\tnames = append(names, name)\n84|\t}\n85|\tsort.Strings(names)\n86|\tif len(names) == 0 {\n87|\t\treturn nil, nil, []string{\"scanned zero production files in \" + dir + \"; the scanner is broken, not the package\"}\n88|\t}\n89|\tfileSet := token.NewFileSet()\n90|\tvar files []ProductionFile\n91|\tvar failures []string\n92|\tfor _, name := range names {\n93|\t\tpath := filepath.Join(dir, name)\n94|\t\tsource, err := os.ReadFile(path)\n95|\t\tif err != nil {\n96|\t\t\tfailures = append(failures, \"scan production files: read \"+path+\": \"+err.Error())\n97|\t\t\tcontinue\n98|\t\t}\n99|\t\tsyntax, err := parser.ParseFile(fileSet, path, source, parser.ParseComments)\n100|\t\tif err != nil {\n101|\t\t\tfailures = append(failures, \"scan production files: parse \"+path+\": \"+err.Error()+\"; an unparseable derivation proves nothing\")\n102|\t\t\tcontinue\n103|\t\t}\n104|\t\tfiles = append(files, ProductionFile{\n105|\t\t\tName:   name,\n106|\t\t\tPath:   path,\n107|\t\t\tSource: source,\n108|\t\t\tSyntax: syntax,\n109|\t\t\tFile:   fileSet.File(syntax.Pos()),\n110|\t\t})\n111|\t}\n112|\tif len(files) == 0 && len(failures) == 0 {\n113|\t\tfailures = append(failures, \"derived zero parsed production files in \"+dir+\"; the scanner is broken, not the package\")\n114|\t}\n115|\treturn files, fileSet, failures\n116|}\n117|\n118|// ParseSource parses one synthetic source (control plants, classifier\n119|// unit probes) with fail-closed semantics: the failure string is empty on\n120|// success and names the cause otherwise.\n121|func ParseSource(filename string, source []byte) (*ast.File, *token.FileSet, string) {\n122|\treturn ParseBytes(filename, source, parser.ParseComments)\n123|}\n124|\n125|// ParseBytes parses one source with the given parser mode and fail-closed\n126|// semantics: the failure string is empty on success and names the cause\n127|// otherwise. Inventories with a non-standard traversal (recursive walk,\n128|// content prefilter, imports-only scan) keep their traversal and route\n129|// parsing here, so an unparseable file fails identically everywhere.\n130|func ParseBytes(filename string, source []byte, mode parser.Mode) (*ast.File, *token.FileSet, string) {\n131|\tfileSet := token.NewFileSet()\n132|\tsyntax, err := parser.ParseFile(fileSet, filename, source, mode)\n133|\tif err != nil {\n134|\t\treturn nil, nil, \"parse \" + filename + \": \" + err.Error() + \"; an unparseable derivation proves nothing\"\n135|\t}\n136|\treturn syntax, fileSet, \"\"\n137|}\n138|\n139|// DiffSets is the both-direction harness over string keys: every derived\n140|// key without a row is unregistered, every row without a derived key is\n141|// orphaned. Both lists are sorted. Empty derived input is itself a\n142|// failure: a domain that silently derives nothing is not a measurement,\n143|// and the forward check would otherwise pass vacuously.\n144|func DiffSets(derived, rows map[string]struct{}) (unregistered, orphaned, failures []string) {\n145|\tif len(derived) == 0 {\n146|\t\tfailures = append(failures, \"derived zero sites; the scanner is broken, not the package\")\n147|\t}\n148|\tfor key := range derived {\n149|\t\tif _, ok := rows[key]; !ok {\n150|\t\t\tunregistered = append(unregistered, key)\n151|\t\t}\n152|\t}\n153|\tfor key := range rows {\n154|\t\tif _, ok := derived[key]; !ok {\n155|\t\t\torphaned = append(orphaned, key)\n156|\t\t}\n157|\t}\n158|\tsort.Strings(unregistered)\n159|\tsort.Strings(orphaned)\n160|\treturn unregistered, orphaned, failures\n161|}\n162|\n163|// ConstructorSpec declares the refusal constructors one audit watches:\n164|// package-local bare identifiers (mismatchf) and qualified constructors\n165|// matched by IMPORT PATH and member name (errors.New), so an import alias\n166|// cannot change what the audit sees.\n167|type ConstructorSpec struct {\n168|\t// Local names package-local constructor identifiers.\n169|\tLocal map[string]bool\n170|\t// Qualified maps an import path to its watched member names:\n171|\t// {\"errors\": {\"New\": true}, \"fmt\": {\"Errorf\": true}}. A member name\n172|\t// with a trailing \"*\" matches by prefix (\"Errorf*\" covers Errorf\n173|\t// and its Errorf-prefixed kin).\n174|\tQualified map[string]map[string]bool\n175|}\n176|\n177|// qualifiedWatches reports whether member is watched under path,\n178|// honoring trailing-\"*\" prefix entries.\n179|func qualifiedWatches(spec ConstructorSpec, path, member string) bool {\n180|\tmembers, ok := spec.Qualified[path]\n181|\tif !ok {\n182|\t\treturn false\n183|\t}\n184|\tif members[member] {\n185|\t\treturn true\n186|\t}\n187|\tfor watched := range members {\n188|\t\tif strings.HasSuffix(watched, \"*\") && strings.HasPrefix(member, strings.TrimSuffix(watched, \"*\")) {\n189|\t\t\treturn true\n190|\t\t}\n191|\t}\n192|\treturn false\n193|}\n194|\n195|// AuditConstructorReferences fails every constructor reference outside\n196|// direct-call position: aliases, var bindings, arguments, struct fields,\n197|// and shadows. Import aliases resolve through the file's import specs, so\n198|// `import errs \"errors\"; errs.New(\"…\")` attributes to errors.New and\n199|// `alias := errs.New` fails like any other binding. A dot import of a\n200|// watched path or any other shape the audit cannot classify fails closed\n201|// as unclassifiable instead of passing silently. Direct calls and the\n202|// constructors' own declarations are the only allowed positions.\n203|func AuditConstructorReferences(syntax *ast.File, fileSet *token.FileSet, display string, spec ConstructorSpec) []string {\n204|\timports := resolveImports(syntax, spec)\n205|\tfor path := range spec.Qualified {\n206|\t\tif dot, ok := imports.dot[path]; ok && dot {\n207|\t\t\treturn []string{display + \": dot-imports watched path \" + strconv.Quote(path) + \"; the audit cannot attribute bare \" + constructorMembers(spec.Qualified[path]) + \", qualify the import or widen the audit\"}\n208|\t\t}\n209|\t}\n210|\tallowed := map[token.Pos]bool{}\n211|\tast.Inspect(syntax, func(node ast.Node) bool {\n212|\t\tdeclaration, ok := node.(*ast.FuncDecl)\n213|\t\tif ok && spec.Local[declaration.Name.Name] {\n214|\t\t\t// The declaration name itself is allowed, but the body\n215|\t\t\t// still scans: a direct call nested inside the funnel\n216|\t\t\t// body is attributable and must stay allowed.\n217|\t\t\tallowed[declaration.Name.Pos()] = true\n218|\t\t\treturn true\n219|\t\t}\n220|\t\tcall, ok := node.(*ast.CallExpr)\n221|\t\tif !ok {\n222|\t\t\treturn true\n223|\t\t}\n224|\t\tif ident, ok := call.Fun.(*ast.Ident); ok && spec.Local[ident.Name] {\n225|\t\t\tallowed[ident.Pos()] = true\n226|\t\t\treturn true\n227|\t\t}\n228|\t\tif selector, ok := call.Fun.(*ast.SelectorExpr); ok {\n229|\t\t\tif receiver, ok := selector.X.(*ast.Ident); ok {\n230|\t\t\t\tif qualifiedWatches(spec, imports.pathOf(receiver.Name), selector.Sel.Name) {\n231|\t\t\t\t\tallowed[selector.Sel.Pos()] = true\n232|\t\t\t\t}\n233|\t\t\t}\n234|\t\t}\n235|\t\treturn true\n236|\t})\n237|\tvar failures []string\n238|\tast.Inspect(syntax, func(node ast.Node) bool {\n239|\t\tdeclaration, ok := node.(*ast.FuncDecl)\n240|\t\tif ok && spec.Local[declaration.Name.Name] {\n241|\t\t\t// Descend: the declaration name is allowlisted by\n242|\t\t\t// position, but references nested in the funnel body\n243|\t\t\t// still audit.\n244|\t\t\treturn true\n245|\t\t}\n246|\t\tident, ok := node.(*ast.Ident)\n247|\t\tif !ok || allowed[ident.Pos()] {\n248|\t\t\treturn true\n249|\t\t}\n250|\t\tif spec.Local[ident.Name] {\n251|\t\t\tif _, declared := imports.names[ident.Name]; declared {\n252|\t\t\t\tfailures = append(failures, display+\":\"+positionOf(fileSet, ident.Pos())+\": constructor \"+strconv.Quote(ident.Name)+\" shadowed by an import or declaration the audit cannot classify; rename it or widen the audit\")\n253|\t\t\t\treturn true\n254|\t\t\t}\n255|\t\t\tfailures = append(failures, display+\":\"+positionOf(fileSet, ident.Pos())+\": constructor \"+strconv.Quote(ident.Name)+\" referenced outside direct-call position; an aliased refusal cannot be inventoried, call it directly\")\n256|\t\t\treturn true\n257|\t\t}\n258|\t\treturn true\n259|\t})\n260|\tast.Inspect(syntax, func(node ast.Node) bool {\n261|\t\tselector, ok := node.(*ast.SelectorExpr)\n262|\t\tif !ok || allowed[selector.Sel.Pos()] {\n263|\t\t\treturn true\n264|\t\t}\n265|\t\treceiver, ok := selector.X.(*ast.Ident)\n266|\t\tif !ok {\n267|\t\t\treturn true\n268|\t\t}\n269|\t\tif qualifiedWatches(spec, imports.pathOf(receiver.Name), selector.Sel.Name) {\n270|\t\t\tfailures = append(failures, display+\":\"+positionOf(fileSet, selector.Sel.Pos())+\": constructor \"+strconv.Quote(receiver.Name+\".\"+selector.Sel.Name)+\" referenced outside direct-call position; an aliased construction cannot be inventoried, call it directly\")\n271|\t\t}\n272|\t\treturn true\n273|\t})\n274|\tsort.Strings(failures)\n275|\treturn failures\n276|}\n277|\n278|// FunPosition reports the audited position of a call's function: the\n279|// identifier for bare calls, the selector member for qualified calls.\n280|// WatchedCallPositions keys on exactly these positions.\n281|func FunPosition(call *ast.CallExpr) (token.Pos, bool) {\n282|\tswitch fun := call.Fun.(type) {\n283|\tcase *ast.Ident:\n284|\t\treturn fun.Pos(), true\n285|\tcase *ast.SelectorExpr:\n286|\t\treturn fun.Sel.Pos(), true\n287|\tdefault:\n288|\t\treturn token.NoPos, false\n289|\t}\n290|}\n291|\n292|// WatchedCallPositions returns the audited positions of every direct\n293|// call to a watched constructor in syntax: the attribution set. Callers\n294|// use it to attribute each watched construction to its enclosing\n295|// function (an allowlist scan), while AuditConstructorReferences owns\n296|// the alias direction over the same spec.\n297|func WatchedCallPositions(syntax *ast.File, spec ConstructorSpec) map[token.Pos]bool {\n298|\timports := resolveImports(syntax, spec)\n299|\tpositions := map[token.Pos]bool{}\n300|\tast.Inspect(syntax, func(node ast.Node) bool {\n301|\t\tdeclaration, ok := node.(*ast.FuncDecl)\n302|\t\tif ok && spec.Local[declaration.Name.Name] {\n303|\t\t\treturn true\n304|\t\t}\n305|\t\tcall, ok := node.(*ast.CallExpr)\n306|\t\tif !ok {\n307|\t\t\treturn true\n308|\t\t}\n309|\t\tif ident, ok := call.Fun.(*ast.Ident); ok && spec.Local[ident.Name] {\n310|\t\t\tpositions[ident.Pos()] = true\n311|\t\t\treturn true\n312|\t\t}\n313|\t\tif selector, ok := call.Fun.(*ast.SelectorExpr); ok {\n314|\t\t\tif receiver, ok := selector.X.(*ast.Ident); ok {\n315|\t\t\t\tif qualifiedWatches(spec, imports.pathOf(receiver.Name), selector.Sel.Name) {\n316|\t\t\t\t\tpositions[selector.Sel.Pos()] = true\n317|\t\t\t\t}\n318|\t\t\t}\n319|\t\t}\n320|\t\treturn true\n321|\t})\n322|\treturn positions\n323|}\n324|\n325|// importResolution maps the file's local import names to paths.\n326|type importResolution struct {\n327|\tnames map[string]string\n328|\tdot   map[string]bool\n329|}\n330|\n331|func (resolution importResolution) pathOf(local string) string {\n332|\treturn resolution.names[local]\n333|}\n334|\n335|// resolveImports reads the file's import specs into local-name to path\n336|// bindings. Explicit aliases, blank imports, and default base names all\n337|// resolve; only dot imports are unresolvable, and the caller fails them\n338|// closed.\n339|func resolveImports(syntax *ast.File, spec ConstructorSpec) importResolution {\n340|\tresolution := importResolution{names: map[string]string{}, dot: map[string]bool{}}\n341|\tfor _, declaration := range syntax.Decls {\n342|\t\tgeneral, ok := declaration.(*ast.GenDecl)\n343|\t\tif !ok || general.Tok != token.IMPORT {\n344|\t\t\tcontinue\n345|\t\t}\n346|\t\tfor _, item := range general.Specs {\n347|\t\t\tloaded, ok := item.(*ast.ImportSpec)\n348|\t\t\tif !ok {\n349|\t\t\t\tcontinue\n350|\t\t\t}\n351|\t\t\tpath, err := strconv.Unquote(loaded.Path.Value)\n352|\t\t\tif err != nil {\n353|\t\t\t\tcontinue\n354|\t\t\t}\n355|\t\t\tif loaded.Name != nil && loaded.Name.Name == \".\" {\n356|\t\t\t\tresolution.dot[path] = true\n357|\t\t\t\tcontinue\n358|\t\t\t}\n359|\t\t\tlocal := importBaseName(path)\n360|\t\t\tif loaded.Name != nil {\n361|\t\t\t\tlocal = loaded.Name.Name\n362|\t\t\t}\n363|\t\t\tif local == \"_\" {\n364|\t\t\t\tcontinue\n365|\t\t\t}\n366|\t\t\tresolution.names[local] = path\n367|\t\t}\n368|\t}\n369|\tfor path := range spec.Qualified {\n370|\t\tif _, ok := resolution.names[importBaseName(path)]; !ok {\n371|\t\t\thasLocal := false\n372|\t\t\tfor _, bound := range resolution.names {\n373|\t\t\t\tif bound == path {\n374|\t\t\t\t\thasLocal = true\n375|\t\t\t\t}\n376|\t\t\t}\n377|\t\t\t_ = hasLocal\n378|\t\t}\n379|\t}\n380|\treturn resolution\n381|}\n382|\n383|// importBaseName renders the default local name of an import path.\n384|func importBaseName(path string) string {\n385|\tif index := strings.LastIndex(path, \"/\"); index >= 0 {\n386|\t\treturn path[index+1:]\n387|\t}\n388|\treturn path\n389|}\n390|\n391|// constructorMembers joins watched member names for diagnostics.\n392|func constructorMembers(members map[string]bool) string {\n393|\tvar names []string\n394|\tfor name := range members {\n395|\t\tnames = append(names, name)\n396|\t}\n397|\tsort.Strings(names)\n398|\treturn strings.Join(names, \", \")\n399|}\n400|\n401|// positionOf renders line:column for diagnostics; never empty.\n402|func positionOf(fileSet *token.FileSet, position token.Pos) string {\n403|\tlocated := fileSet.Position(position)\n404|\tif !located.IsValid() {\n405|\t\treturn \"?:?\"\n406|\t}\n407|\treturn strconv.Itoa(located.Line) + \":\" + strconv.Itoa(located.Column)\n408|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c54d","stream":{"kind":"session","id":"01a079e0-55db-79f2-85b0-c8c2e4c1a43f"},"sequence":257,"recorded_at":1780531400000509,"record_type":"event","durability":"durable","causation_id":"38173c32-e836-4324-8339-ee117e4249f1","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38173c32-e836-4324-8339-ee117e4249f1","run_stream":{"kind":"run","id":"38173c32-e836-4324-8339-ee117e4249f1"},"call_id":"call_01a079e0e3d17b409442bae3db1925ce","text":"Read text file `internal/invcore/must.go`.\n1|// Must wrappers and the runtime site recorder for Package invcore.\n2|//\n3|// The Must wrappers fail the suite on any returned failure: production\n4|// inventories call these, while negative tests and control plants call\n5|// the pure funcs in invcore.go directly and assert on the returned\n6|// failures. A gate that can only fatal cannot be planted against.\n7|\n8|package invcore\n9|\n10|import (\n11|\t\"fmt\"\n12|\t\"go/ast\"\n13|\t\"go/token\"\n14|\t\"path/filepath\"\n15|\t\"runtime\"\n16|\t\"sort\"\n17|\t\"strings\"\n18|\t\"sync\"\n19|\t\"testing\"\n20|)\n21|\n22|// MustScanProduction scans dir and fails the suite on any fail-closed\n23|// condition: zero files, unreadable files, unparseable files.\n24|func MustScanProduction(t *testing.T, dir string) ([]ProductionFile, *token.FileSet) {\n25|\tt.Helper()\n26|\tfiles, fileSet, failures := ScanProduction(dir)\n27|\tfor _, failure := range failures {\n28|\t\tt.Error(failure)\n29|\t}\n30|\tif len(failures) > 0 {\n31|\t\tt.FailNow()\n32|\t}\n33|\treturn files, fileSet\n34|}\n35|\n36|// MustCheckBothDirections fails the suite when the derived set and the\n37|// declared row set differ in either direction: unregistered derived sites\n38|// or orphaned rows. A zero derived set fails even when rows are empty.\n39|func MustCheckBothDirections(t *testing.T, what string, derived, rows map[string]struct{}) {\n40|\tt.Helper()\n41|\tunregistered, orphaned, failures := DiffSets(derived, rows)\n42|\tfor _, failure := range failures {\n43|\t\tt.Errorf(\"%s: %s\", what, failure)\n44|\t}\n45|\tfor _, key := range unregistered {\n46|\t\tt.Errorf(\"%s: unregistered site with no declaring row, so nothing witnesses it: %s\", what, key)\n47|\t}\n48|\tfor _, key := range orphaned {\n49|\t\tt.Errorf(\"%s: orphan row with no derived site; a row without a site is a witness without a guard: %s\", what, key)\n50|\t}\n51|}\n52|\n53|// MustAuditConstructorReferences fails the suite on any constructor\n54|// reference outside direct-call position, including import-aliased and\n55|// var-bound shapes, and on any shape the audit cannot classify.\n56|func MustAuditConstructorReferences(t *testing.T, syntax *ast.File, fileSet *token.FileSet, display string, spec ConstructorSpec) {\n57|\tt.Helper()\n58|\tfor _, failure := range AuditConstructorReferences(syntax, fileSet, display, spec) {\n59|\t\tt.Error(failure)\n60|\t}\n61|}\n62|\n63|// SiteRecorder is the runtime direction of the alias-bypass union\n64|// (provider/provhost shape): instrumented constructor vars record the\n65|// production file:line behind every exercised refusal plus the stable\n66|// codes those refusals carried. The audit requires the exercised site set\n67|// to equal the derived site set in both directions, and the observed code\n68|// set to equal the closed code set exactly, so a constructor call the\n69|// tests never exercise fails forward, and a truncated derivation fails in\n70|// reverse even though the forward check passes vacuously.\n71|type SiteRecorder struct {\n72|\tmu    sync.Mutex\n73|\tsites map[string]struct{}\n74|\tcodes map[string]struct{}\n75|}\n76|\n77|// NewSiteRecorder returns an empty recorder.\n78|func NewSiteRecorder() *SiteRecorder {\n79|\treturn &SiteRecorder{sites: map[string]struct{}{}, codes: map[string]struct{}{}}\n80|}\n81|\n82|// Record notes one exercised refusal carrying code, attributing it to\n83|// the production file:line at runtime.Caller(skip+1): skip counts every\n84|// frame between Record and the site, including Record's own caller. A\n85|// record helper called from the swapped constructor var passes skip=2\n86|// (helper frame plus wrapper frame), matching the historical sync.Map\n87|// recorders' runtime.Caller(2) exactly.\n88|func (recorder *SiteRecorder) Record(code string, skip int) {\n89|\trecorder.mu.Lock()\n90|\tdefer recorder.mu.Unlock()\n91|\trecorder.codes[code] = struct{}{}\n92|\tif _, file, line, ok := runtime.Caller(skip + 1); ok {\n93|\t\trecorder.sites[filepath.Base(file)+\":\"+fmt.Sprint(line)] = struct{}{}\n94|\t}\n95|}\n96|\n97|// Snapshot returns deep copies of the exercised site and code sets for\n98|// tests that record bystander sites and must remove them before\n99|// returning, keeping the reverse-direction audit exact.\n100|func (recorder *SiteRecorder) Snapshot() (sites map[string]struct{}, codes map[string]struct{}) {\n101|\trecorder.mu.Lock()\n102|\tdefer recorder.mu.Unlock()\n103|\tsites = make(map[string]struct{}, len(recorder.sites))\n104|\tfor site := range recorder.sites {\n105|\t\tsites[site] = struct{}{}\n106|\t}\n107|\tcodes = make(map[string]struct{}, len(recorder.codes))\n108|\tfor code := range recorder.codes {\n109|\t\tcodes[code] = struct{}{}\n110|\t}\n111|\treturn sites, codes\n112|}\n113|\n114|// Restore resets the recorder to a prior snapshot, dropping every site\n115|// and code recorded since.\n116|func (recorder *SiteRecorder) Restore(sites map[string]struct{}, codes map[string]struct{}) {\n117|\trecorder.mu.Lock()\n118|\tdefer recorder.mu.Unlock()\n119|\trecorder.sites = make(map[string]struct{}, len(sites))\n120|\tfor site := range sites {\n121|\t\trecorder.sites[site] = struct{}{}\n122|\t}\n123|\trecorder.codes = make(map[string]struct{}, len(codes))\n124|\tfor code := range codes {\n125|\t\trecorder.codes[code] = struct{}{}\n126|\t}\n127|}\n128|\n129|// Sites returns the exercised production file:line set.\n130|func (recorder *SiteRecorder) Sites() map[string]struct{} {\n131|\trecorder.mu.Lock()\n132|\tdefer recorder.mu.Unlock()\n133|\tduplicated := make(map[string]struct{}, len(recorder.sites))\n134|\tfor site := range recorder.sites {\n135|\t\tduplicated[site] = struct{}{}\n136|\t}\n137|\treturn duplicated\n138|}\n139|\n140|// Codes returns the observed stable code set.\n141|func (recorder *SiteRecorder) Codes() []string {\n142|\trecorder.mu.Lock()\n143|\tdefer recorder.mu.Unlock()\n144|\tvar codes []string\n145|\tfor code := range recorder.codes {\n146|\t\tcodes = append(codes, code)\n147|\t}\n148|\tsort.Strings(codes)\n149|\treturn codes\n150|}\n151|\n152|// AuditSites compares the exercised set against the derived site set in\n153|// both directions and the observed codes against the closed set, returning\n154|// one failure per violated direction. Empty scanned or derived input fails\n155|// closed: a blind scan is not a measurement.\n156|func (recorder *SiteRecorder) AuditSites(what string, scanned int, derived map[string]struct{}, wantCodes []string) []string {\n157|\tvar failures []string\n158|\tif scanned == 0 {\n159|\t\tfailures = append(failures, what+\": scanned no production sources; the check is blind\")\n160|\t}\n161|\tif len(derived) == 0 {\n162|\t\tfailures = append(failures, what+\": derived no refusal sites; the scan is blind\")\n163|\t}\n164|\texercised := recorder.Sites()\n165|\tvar outside []string\n166|\tfor site := range exercised {\n167|\t\tif _, ok := derived[site]; !ok {\n168|\t\t\toutside = append(outside, site)\n169|\t\t}\n170|\t}\n171|\tsort.Strings(outside)\n172|\tif len(outside) != 0 {\n173|\t\tfailures = append(failures, what+\": exercised refusal sites outside the derived inventory; the derivation is short: \"+strings.Join(outside, \", \"))\n174|\t}\n175|\tvar missing []string\n176|\tfor site := range derived {\n177|\t\tif _, ok := exercised[site]; !ok {\n178|\t\t\tmissing = append(missing, site)\n179|\t\t}\n180|\t}\n181|\tsort.Strings(missing)\n182|\tif len(missing) != 0 {\n183|\t\tfailures = append(failures, what+\": derived refusal sites without an exercised negative path: \"+strings.Join(missing, \", \"))\n184|\t}\n185|\tcodes := recorder.Codes()\n186|\tif fmt.Sprintf(\"%v\", codes) != fmt.Sprintf(\"%v\", wantCodes) {\n187|\t\tfailures = append(failures, fmt.Sprintf(\"%s: observed refusal codes = %v, want closed set %v\", what, codes, wantCodes))\n188|\t}\n189|\treturn failures\n190|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c54f","stream":{"kind":"session","id":"01a079e0-55db-79f2-85b0-c8c2e4c1a43f"},"sequence":258,"recorded_at":1780531400000511,"record_type":"event","durability":"durable","causation_id":"38173c32-e836-4324-8339-ee117e4249f1","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38173c32-e836-4324-8339-ee117e4249f1","run_stream":{"kind":"run","id":"38173c32-e836-4324-8339-ee117e4249f1"},"call_id":"call_01a079e0e4777f90ad582f100291bee6","text":"Read text file `internal/terminalbackend/refusal_arm_inventory_test.go`.\n1|// AST-derived refusal-arm inventory for the terminal backend packages.\n2|//\n3|// The failure this file exists to prevent: a brand-new production refusal\n4|// arm carrying a brand-new unasserted detail shipped while `gofmt`,\n5|// `go vet`, `go test ./...`, and `tracecheck` all stayed green. A\n6|// hand-maintained arm list cannot catch that; a derived one can, but only\n7|// if it is checked in BOTH directions. The forward direction alone passes\n8|// vacuously on a truncated derivation: every derived arm asserted is true\n9|// when the derivation silently dropped half the package. So this file\n10|// derives every refusal arm from the production AST, requires each to\n11|// resolve to exactly one declared row naming a real asserting test, and\n12|// requires every declared row to resolve to exactly one derived arm.\n13|//\n14|// Modelled on internal/canonicaljson/grammar_inventory_test.go: derivation\n15|// fails closed on an empty, short, or unparseable input, and the declared\n16|// table cannot move its own goalposts because the derivation never\n17|// consults it.\n18|//\n19|// Resolution is EXECUTED, not textual: every non-bound row carries a\n20|// witness executed through a public production entry point by\n21|// TestEveryDeclaredArmRefusesAtItsEntry (owns its proof in\n22|// refusal_arm_witnesses_test.go), which requires the exact wire code at\n23|// the exact static detail. A row that merely mentions the detail in some\n24|// test's source proves nothing and resolves nothing. Attribution drift\n25|// cannot survive that: a dead-by-construction arm has no input that\n26|// refuses at its entry, so it cannot carry a witness and must declare a\n27|// bound instead. Live example, closed by this port: CheckTransition's\n28|// \"operation vocabulary\" arm (conformance.go) is unreachable —\n29|// CheckTransition parses through ParseOperation first and\n30|// lookupTransition covers every admitted operation — so the row declares\n31|// boundUnreachableVocabulary, pinned by\n32|// TestCheckTransitionOperationVocabularyIsUnreachable, instead of\n33|// resolving through ParseOperation's sibling arm sharing the detail.\n34|// The five re-parse arms declare boundDefensiveReparse the same way, and\n35|// TestDefensiveBoundsAreExactlyThese pins the full bound set.\n36|//\n37|// Stated bounds (not inferred):\n38|//   - The inventory proves every arm is DECLARED and every non-bound arm\n39|//     is WITNESSED at a public entry with its exact code and detail.\n40|//     Bound arms (defensive re-parses, the unreachable vocabulary arm)\n41|//     are proved by their pinning tests, which fail closed when the\n42|//     production shape they assume changes.\n43|//   - Kill inflation: both inventory directions fail on ANY added or\n44|//     deleted production arm by construction, so an arm-deleting mutant\n45|//     elsewhere reads as killed by the inventory alone with no behavioral\n46|//     change. Mutation scores measured with this file present are NOT\n47|//     comparable to pre-inventory scores; review the failing-test list,\n48|//     not just the exit code.\n49|//   - errors.New/fmt.Errorf sites are not wire refusals and carry no arm.\n50|//     They live only in validatePlatforms (funneled into one *Error arm\n51|//     whose detail set is pinned exactly) and DigestFile (I/O errors that\n52|//     must never be *Error). Both properties are asserted below, in every\n53|//     FuncDecl body plus every package-level var initializer, and any\n54|//     reference to either constructor outside direct-call position\n55|//     (e.g. `newPlain := errors.New`) fails the suite, so an aliased\n56|//     construction cannot ship unattributed.\n57|//   - The DigestFile half of that allowlist is function-wide with no\n58|//     detail pin, unlike validatePlatforms' derived exact set: a new\n59|//     errors.New on any path inside DigestFile passes the gate (and the\n60|//     never-wire behavioral assertion, which only drives the current\n61|//     paths). Disclosed, not closed.\n62|//   - Custom error types outside the two recognised spellings (*Error,\n63|//     errors.New, fmt.Errorf) are outside both derivations: a bespoke\n64|//     error type smuggled as a refusal survives. Disclosed, not closed.\n65|//   - Constructor Details are single static literals by assertion: the\n66|//     derivation fatals on any mismatchf/integrityFailure call without\n67|//     exactly one string-literal argument, so format-verb interpolation\n68|//     cannot enter the table. Zero multi-argument sites today; go vet's\n69|//     printf analyzer independently refuses a non-constant format string.\n70|package terminalbackend\n71|\n72|import (\n73|\t\"bytes\"\n74|\t\"encoding/json\"\n75|\t\"errors\"\n76|\t\"go/ast\"\n77|\t\"go/token\"\n78|\t\"os\"\n79|\t\"path/filepath\"\n80|\t\"strconv\"\n81|\t\"strings\"\n82|\t\"testing\"\n83|\n84|\t\"github.com/relux-works/agent-session-manager/internal/invcore\"\n85|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n86|)\n87|\n88|// refusalArm is one derived production refusal: a wire-code *Error\n89|// construction site keyed by file, enclosing function (receiver-qualified\n90|// for methods), code symbol, static detail, and occurrence index within\n91|// that key. The index keeps two identical arms in one function distinct:\n92|// adding a second arm with an already-declared key fails on the missing\n93|// #2 row instead of hiding behind #1.\n94|type refusalArm struct {\n95|\tfile       string\n96|\tfunction   string\n97|\tcode       string\n98|\tdetail     string\n99|\toccurrence int\n100|}\n101|\n102|// constructorFunctions build refusals instead of issuing them. Their own\n103|// *Error sites are the funnel, not arms.\n104|var constructorFunctions = map[string]bool{\n105|\t\"mismatchf\":        true,\n106|\t\"integrityFailure\": true,\n107|}\n108|\n109|// passthroughDetail marks the single dynamic-detail funnel: Registration\n110|// validation wraps validatePlatforms errors via err.Error(). Every other\n111|// Detail expression must be a static string literal; a new dynamic detail\n112|// fails the derivation rather than entering the table silently.\n113|const passthroughDetail = \"passthrough:err.Error()\"\n114|\n115|// deriveRefusalArms walks every production file of this package (every\n116|// *.go except *_test.go, so a new production file is scanned without\n117|// anyone remembering it) and returns every refusal arm in source order.\n118|// It fails closed: an unparseable file, a non-static code or detail, and\n119|// an empty result are all fatal, never an empty table.\n120|//\n121|// Coverage is declaration-complete, not FuncDecl-complete: every FuncDecl\n122|// body (including nested func literals, methods, and init) plus every\n123|// package-level var initializer is scanned, so a refusal arm hiding in a\n124|// package-level `var f = func() *Error {...}` is derived like any other.\n125|// Constructor references outside direct-call position (`refuse :=\n126|// mismatchf`) are rejected outright by rejectConstructorAliases below:\n127|// an aliased refusal cannot be inventoried, so it fails the suite rather\n128|// than shipping silently.\n129|func deriveRefusalArms(t *testing.T) []refusalArm {\n130|\tt.Helper()\n131|\n132|\t// Production-file selection and fail-closed parsing are the shared\n133|\t// core's: a new production file is scanned without anyone\n134|\t// remembering it, and an unparseable file fails, never skips.\n135|\tfiles, fileSet := invcore.MustScanProduction(t, \".\")\n136|\n137|\tvar arms []refusalArm\n138|\tparsed := 0\n139|\tfor _, production := range files {\n140|\t\tfile, name := production.Syntax, production.Name\n141|\t\tparsed++\n142|\t\tcollect := func(functionName string, root ast.Node) {\n143|\t\t\tast.Inspect(root, func(node ast.Node) bool {\n144|\t\t\t\tswitch expression := node.(type) {\n145|\t\t\t\tcase *ast.UnaryExpr:\n146|\t\t\t\t\tif expression.Op != token.AND {\n147|\t\t\t\t\t\treturn true\n148|\t\t\t\t\t}\n149|\t\t\t\t\tliteral, ok := expression.X.(*ast.CompositeLit)\n150|\t\t\t\t\tif !ok {\n151|\t\t\t\t\t\treturn true\n152|\t\t\t\t\t}\n153|\t\t\t\t\tidentifier, ok := literal.Type.(*ast.Ident)\n154|\t\t\t\t\tif !ok || identifier.Name != \"Error\" {\n155|\t\t\t\t\t\treturn true\n156|\t\t\t\t\t}\n157|\t\t\t\t\tcode, detail := \"\", \"\"\n158|\t\t\t\t\tfor _, element := range literal.Elts {\n159|\t\t\t\t\t\tpair, ok := element.(*ast.KeyValueExpr)\n160|\t\t\t\t\t\tif !ok {\n161|\t\t\t\t\t\t\tcontinue\n162|\t\t\t\t\t\t}\n163|\t\t\t\t\t\tkey, ok := pair.Key.(*ast.Ident)\n164|\t\t\t\t\t\tif !ok {\n165|\t\t\t\t\t\t\tcontinue\n166|\t\t\t\t\t\t}\n167|\t\t\t\t\t\tswitch key.Name {\n168|\t\t\t\t\t\tcase \"Code\":\n169|\t\t\t\t\t\t\tsymbol, ok := pair.Value.(*ast.Ident)\n170|\t\t\t\t\t\t\tif !ok {\n171|\t\t\t\t\t\t\t\tt.Fatalf(\"%s: refusal code is not a static Code symbol; \"+\n172|\t\t\t\t\t\t\t\t\t\"a computed code cannot be inventoried\", functionName)\n173|\t\t\t\t\t\t\t}\n174|\t\t\t\t\t\t\tcode = symbol.Name\n175|\t\t\t\t\t\tcase \"Detail\":\n176|\t\t\t\t\t\t\tdetail = staticDetail(t, functionName, pair.Value)\n177|\t\t\t\t\t\t}\n178|\t\t\t\t\t}\n179|\t\t\t\t\tif code == \"\" || detail == \"\" {\n180|\t\t\t\t\t\tt.Fatalf(\"%s: refusal without a static code and detail; \"+\n181|\t\t\t\t\t\t\t\"the inventory cannot name what it cannot read\", functionName)\n182|\t\t\t\t\t}\n183|\t\t\t\t\tarms = append(arms, refusalArm{\n184|\t\t\t\t\t\tfile: name, function: functionName, code: code, detail: detail,\n185|\t\t\t\t\t})\n186|\t\t\t\tcase *ast.CallExpr:\n187|\t\t\t\t\tidentifier, ok := expression.Fun.(*ast.Ident)\n188|\t\t\t\t\tif !ok || !constructorFunctions[identifier.Name] {\n189|\t\t\t\t\t\treturn true\n190|\t\t\t\t\t}\n191|\t\t\t\t\tif len(expression.Args) != 1 {\n192|\t\t\t\t\t\tt.Fatalf(\"%s: %s with %d arguments; Detail must be a single \"+\n193|\t\t\t\t\t\t\t\"static literal and never interpolate local data, and a \"+\n194|\t\t\t\t\t\t\t\"variadic detail cannot be inventoried\",\n195|\t\t\t\t\t\t\tfunctionName, identifier.Name, len(expression.Args))\n196|\t\t\t\t\t}\n197|\t\t\t\t\tliteral, ok := expression.Args[0].(*ast.BasicLit)\n198|\t\t\t\t\tif !ok || literal.Kind != token.STRING {\n199|\t\t\t\t\t\tt.Fatalf(\"%s: %s detail is not a static string literal; \"+\n200|\t\t\t\t\t\t\t\"a computed detail cannot be inventoried\", functionName, identifier.Name)\n201|\t\t\t\t\t}\n202|\t\t\t\t\tdetail, err := strconv.Unquote(literal.Value)\n203|\t\t\t\t\tif err != nil {\n204|\t\t\t\t\t\tt.Fatalf(\"%s: unquote detail: %v\", functionName, err)\n205|\t\t\t\t\t}\n206|\t\t\t\t\tcode := \"CodeMismatch\"\n207|\t\t\t\t\tif identifier.Name == \"integrityFailure\" {\n208|\t\t\t\t\t\tcode = \"CodeIntegrityFailure\"\n209|\t\t\t\t\t}\n210|\t\t\t\t\tarms = append(arms, refusalArm{\n211|\t\t\t\t\t\tfile: name, function: functionName, code: code, detail: detail,\n212|\t\t\t\t\t})\n213|\t\t\t\t}\n214|\t\t\t\treturn true\n215|\t\t\t})\n216|\t\t}\n217|\t\tfor _, declaration := range file.Decls {\n218|\t\t\tswitch decl := declaration.(type) {\n219|\t\t\tcase *ast.FuncDecl:\n220|\t\t\t\tif decl.Body == nil {\n221|\t\t\t\t\tcontinue\n222|\t\t\t\t}\n223|\t\t\t\tif constructorFunctions[decl.Name.Name] {\n224|\t\t\t\t\tcontinue\n225|\t\t\t\t}\n226|\t\t\t\tfunctionName := decl.Name.Name\n227|\t\t\t\tif decl.Recv != nil && len(decl.Recv.List) > 0 {\n228|\t\t\t\t\tfunctionName = receiverTypeName(decl.Recv.List[0].Type) + \".\" + functionName\n229|\t\t\t\t}\n230|\t\t\t\tcollect(functionName, decl.Body)\n231|\t\t\tcase *ast.GenDecl:\n232|\t\t\t\t// Package-level initializers execute outside any FuncDecl,\n233|\t\t\t\t// so a func literal (or a bare &Error{}) assigned to a\n234|\t\t\t\t// package var would otherwise ship invisible. Attribute\n235|\t\t\t\t// its arms to the declared variable name.\n236|\t\t\t\tfor _, spec := range decl.Specs {\n237|\t\t\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n238|\t\t\t\t\tif !ok {\n239|\t\t\t\t\t\tcontinue\n240|\t\t\t\t\t}\n241|\t\t\t\t\tfunctionName := \"var\"\n242|\t\t\t\t\tif len(value.Names) > 0 {\n243|\t\t\t\t\t\tfunctionName = value.Names[0].Name\n244|\t\t\t\t\t}\n245|\t\t\t\t\tfor _, item := range value.Values {\n246|\t\t\t\t\t\tcollect(functionName, item)\n247|\t\t\t\t\t}\n248|\t\t\t\t}\n249|\t\t\t}\n250|\t\t}\n251|\t\tinvcore.MustAuditConstructorReferences(t, file, fileSet, name, refusalConstructorSpec())\n252|\t}\n253|\t_ = parsed\n254|\tif len(arms) == 0 {\n255|\t\tt.Fatal(\"derived zero refusal arms from the package sources; the scanner is broken, not the package\")\n256|\t}\n257|\toccurrences := make(map[refusalArm]int)\n258|\tfor index := range arms {\n259|\t\tkey := arms[index]\n260|\t\tkey.occurrence = 0\n261|\t\toccurrences[key]++\n262|\t\tarms[index].occurrence = occurrences[key]\n263|\t}\n264|\treturn arms\n265|}\n266|\n267|// refusalConstructorSpec is the core watch list for this package:\n268|// package-local refusal constructors plus the plain-error spellings by\n269|// import path, so an import alias cannot change what the audit sees. The\n270|// union keeps terminalbackend's outright refusal and resolves the\n271|// import-alias and var-binding shapes that walked through every\n272|// identifier-keyed gate in this repository.\n273|func refusalConstructorSpec() invcore.ConstructorSpec {\n274|\treturn invcore.ConstructorSpec{\n275|\t\tLocal: map[string]bool{\n276|\t\t\t\"mismatchf\":        true,\n277|\t\t\t\"integrityFailure\": true,\n278|\t\t},\n279|\t\tQualified: map[string]map[string]bool{\n280|\t\t\t\"errors\": {\"New\": true},\n281|\t\t\t\"fmt\":    {\"Errorf*\": true},\n282|\t\t},\n283|\t}\n284|}\n285|\n286|// receiverTypeName renders a method receiver type to its bare name.\n287|func receiverTypeName(expression ast.Expr) string {\n288|\tswitch typed := expression.(type) {\n289|\tcase *ast.Ident:\n290|\t\treturn typed.Name\n291|\tcase *ast.StarExpr:\n292|\t\treturn receiverTypeName(typed.X)\n293|\tdefault:\n294|\t\treturn \"unknown\"\n295|\t}\n296|}\n297|\n298|// staticDetail reads one Detail expression: a string literal, or the one\n299|// dynamic funnel. Anything else fails the derivation.\n300|func staticDetail(t *testing.T, function string, expression ast.Expr) string {\n301|\tt.Helper()\n302|\n303|\tif literal, ok := expression.(*ast.BasicLit); ok && literal.Kind == token.STRING {\n304|\t\tdetail, err := strconv.Unquote(literal.Value)\n305|\t\tif err != nil {\n306|\t\t\tt.Fatalf(\"%s: unquote detail: %v\", function, err)\n307|\t\t}\n308|\t\treturn detail\n309|\t}\n310|\tif call, ok := expression.(*ast.CallExpr); ok {\n311|\t\tif selector, ok := call.Fun.(*ast.SelectorExpr); ok && selector.Sel.Name == \"Error\" {\n312|\t\t\tif receiver, ok := selector.X.(*ast.Ident); ok && receiver.Name == \"err\" {\n313|\t\t\t\treturn passthroughDetail\n314|\t\t\t}\n315|\t\t}\n316|\t}\n317|\tt.Fatalf(\"%s: refusal Detail is not a static clause; Detail must never \"+\n318|\t\t\"interpolate local data, and a dynamic detail cannot be inventoried\", function)\n319|\treturn \"\"\n320|}\n321|\n322|// productionCodeSymbols resolves every Code symbol to its wire value from\n323|// the production const declarations, so the declared table cannot drift\n324|// from the codes production actually emits.\n325|func productionCodeSymbols(t *testing.T) map[string]string {\n326|\tt.Helper()\n327|\n328|\tsymbols := make(map[string]string)\n329|\tfiles, _ := invcore.MustScanProduction(t, \".\")\n330|\tfor _, production := range files {\n331|\t\tfile := production.Syntax\n332|\t\tfor _, declaration := range file.Decls {\n333|\t\t\tgeneral, ok := declaration.(*ast.GenDecl)\n334|\t\t\tif !ok || general.Tok != token.CONST {\n335|\t\t\t\tcontinue\n336|\t\t\t}\n337|\t\t\tfor _, specification := range general.Specs {\n338|\t\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n339|\t\t\t\tif !ok {\n340|\t\t\t\t\tcontinue\n341|\t\t\t\t}\n342|\t\t\t\tfor index, name := range value.Names {\n343|\t\t\t\t\tif !strings.HasPrefix(name.Name, \"Code\") || index >= len(value.Values) {\n344|\t\t\t\t\t\tcontinue\n345|\t\t\t\t\t}\n346|\t\t\t\t\tliteral, ok := value.Values[index].(*ast.BasicLit)\n347|\t\t\t\t\tif !ok || literal.Kind != token.STRING {\n348|\t\t\t\t\t\tt.Fatalf(\"code symbol %s is not a static string; \"+\n349|\t\t\t\t\t\t\t\"wire codes must be literals\", name.Name)\n350|\t\t\t\t\t}\n351|\t\t\t\t\twire, err := strconv.Unquote(literal.Value)\n352|\t\t\t\t\tif err != nil {\n353|\t\t\t\t\t\tt.Fatalf(\"unquote %s: %v\", name.Name, err)\n354|\t\t\t\t\t}\n355|\t\t\t\t\tsymbols[name.Name] = wire\n356|\t\t\t\t}\n357|\t\t\t}\n358|\t\t}\n359|\t}\n360|\tif len(symbols) == 0 {\n361|\t\tt.Fatal(\"resolved zero code symbols; the scanner is broken, not the package\")\n362|\t}\n363|\treturn symbols\n364|}\n365|\n366|// declaredRefusalArm is one inventoried arm: the derived key (file,\n367|// function, code symbol, static detail, occurrence), the public\n368|// production entry its witness drives, an optional stated bound for\n369|// arms no input can reach, and the funneled detail set (nil except the\n370|// funnel row). Non-bound rows are proved by the executed witness of the\n371|// same identity in refusal_arm_witnesses_test.go; bound rows are proved\n372|// by their pinning tests in the pinned set below.\n373|type declaredRefusalArm struct {\n374|\tfile       string\n375|\tfunction   string\n376|\tcode       string\n377|\tdetail     string\n378|\toccurrence int\n379|\tentry      string\n380|\tbound      string\n381|\t// detailSet carries the funneled detail set for the single\n382|\t// dynamic-detail row; it is empty for every literal row.\n383|\tdetailSet []string\n384|}\n385|\n386|// boundDefensiveReparse is the stated bound for re-parse arms after an\n387|// already-validated member: timestampMember validated the member, and the\n388|// Time re-parse cannot fail while scalar owns that contract. The arms\n389|// stay as fail-closed defense; the bound says why no document reaches\n390|// them, and TestDefensiveBoundsAreExactlyThese pins the set.\n391|const boundDefensiveReparse = \"defensive re-parse after validation; scalar owns the re-parse contract\"\n392|\n393|// boundUnreachableVocabulary is the stated bound for CheckTransition's\n394|// \"operation vocabulary\" arm: CheckTransition parses its operation\n395|// through ParseOperation first, and lookupTransition covers every\n396|// admitted operation, so the miss branch is unreachable by\n397|// construction. TestCheckTransitionOperationVocabularyIsUnreachable pins\n398|// the coverage; adding an operation to ParseOperation without a\n399|// transition-table row fails the pin and promotes this row back to a\n400|// witnessed arm.\n401|const boundUnreachableVocabulary = \"unreachable: ParseOperation admits exactly the tabled operations, so lookupTransition never misses\"\n402|\n403|// boundDecoderContract is the stated bound for decodeCappedValue's two\n404|// defensive syntax branches: a non-string object key (#3) and a stray\n405|// delimiter at a value position (#6). encoding/json Token() errors at\n406|// both positions instead of yielding those values, so neither branch has\n407|// an input. TestDecodeCappedValueDefensiveSitesAreUnreachable pins the\n408|// decoder contract; a Go release that yields either value fails the pin\n409|// and promotes both rows back to witnessed arms.\n410|const boundDecoderContract = \"unreachable: encoding/json Token() errors on non-string keys and stray delimiters, never yielding them\"\n411|\n412|// boundCanonicalPlumbing is the stated bound for the four Marshal/JCS\n413|// error branches in objectIdentity and UnsignedEvidenceBytes: their maps\n414|// are built from JSON-decoded values (numbers refused upstream by\n415|// refuseIdentityNumbers, encoding refused by the decode gate) or from\n416|// typed string-only structs, so json.Marshal cannot fail and jcs has no\n417|// numbers, duplicates, or malformed bytes to refuse.\n418|// TestCanonicalPlumbingIsTotalOnDecodedMaps pins totality over the\n419|// reachable input class; a new failing shape fails the pin and promotes\n420|// these rows back to witnessed arms.\n421|const boundCanonicalPlumbing = \"unreachable: json.Marshal and jcs.Transform cannot fail on number-free decoded maps\"\n422|\n423|// boundUnreachableKind is the stated bound for parseKind's vocabulary\n424|// arm: both document callers wrap its error in their own clause, and\n425|// RegisterExternal's external-kind gate fires first, so the arm's own\n426|// clause never surfaces at any public entry. TestParseKindAdmitsOnlyThe-\n427|// ClosedVocabulary pins the vocabulary white-box; TestRegisterExternal-\n428|// RefusesUnknownKindAsUntrusted pins the gate order, so removing the\n429|// gate fails there and promotes this row back to a witnessed arm.\n430|const boundUnreachableKind = \"unreachable: document callers wrap the error and the registry kind gate fires first\"\n431|\n432|// boundUnreachableNumbers is the stated bound for refuseIdentityNumbers'\n433|// arm: every parse entry validates member types before checkIdentity, so\n434|// a JSON number never reaches the walk; the walk holds that order for\n435|// callers that skip the member checks.\n436|// TestObjectIdentityRefusesNumbersBeforeCanonicalization pins the walk\n437|// white-box. A removed member check slides its witness input onto this\n438|// arm's identical clause, so the witness still refuses (no silent\n439|// admission) but cannot name the narrowed gate: that residual is stated\n440|// here and measured by the arm-deletion mutants in the battery, not\n441|// hidden by the bound.\n442|const boundUnreachableNumbers = \"unreachable: member-type validation runs before checkIdentity on every parse entry\"\n443|\n444|// boundUnreachableDigestNull is the stated bound for Registration.validate's\n445|// \"executable_digest must be null\" arm: RegisterExternal's external-kind\n446|// gate admits exactly the digest-carrying kinds, so validate never sees a\n447|// builtin-kind record with a digest at any public entry; New builds its\n448|// builtins without digests. TestValidateRefusesBuiltinKindWithDigest pins\n449|// the arm white-box by calling validate directly. Narrowing the kind gate\n450|// fails TestRegisterExternalRefusesUnknownKindAsUntrusted and promotes\n451|// this row back to a witnessed arm.\n452|const boundUnreachableDigestNull = \"unreachable: the registry kind gate admits exactly the digest-carrying kinds\"\n453|\n454|// boundShadowedLookup is the stated bound for the nine direct-miss arms\n455|// shadowed by a preceding checkExactMembers over the same member list:\n456|// when the exact check passes, the object keys equal the list exactly,\n457|// so the later lookup of a listed member cannot miss. Each bound row\n458|// names its shadowing check in TestShadowedLookupsHaveNoInput, which\n459|// pins the member lists exactly (a list that loses a member may un-\n460|// shadow its miss arm) alongside the extra-member witnesses that pin the\n461|// exact calls themselves (a removed exact call admits the extra member\n462|// and fails its witness).\n463|const boundShadowedLookup = \"unreachable: a preceding checkExactMembers over the same list fires first\"\n464|\n465|// declaredRefusalArms is the inventoried arm set. Field order is file,\n466|// function (receiver-qualified for methods), code symbol, static detail,\n467|// occurrence within that key, driven public entry, stated bound (empty\n468|// except for defensive arms), funneled detail set (nil except the funnel\n469|// row, which lives outside this table), and asserting tests.\n470|//\n471|// The table is generated from the derivation, never hand-enumerated:\n472|// every row must match exactly one derived arm and vice versa, so adding\n473|// a production arm without a row fails forward, and deleting one fails\n474|// in reverse.\n475|var declaredRefusalArms = []declaredRefusalArm{\n476|\t{\"conformance.go\", \"CheckAttachRequest\", \"CodeMismatch\", \"document timestamp\", 1, \"CheckAttachRequest\", boundDefensiveReparse, nil},\n477|\t{\"conformance.go\", \"CheckAttachRequest\", \"CodeUnauthorized\", \"attach authorization binding\", 1, \"CheckAttachRequest\", \"\", nil},\n478|\t{\"conformance.go\", \"CheckAttachRequest\", \"CodeUnauthorized\", \"attach authorization expiry\", 1, \"CheckAttachRequest\", \"\", nil},\n479|\t{\"conformance.go\", \"CheckAttachRequest\", \"CodeUnauthorized\", \"attach relay transport\", 1, \"CheckAttachRequest\", \"\", nil},\n480|\t{\"conformance.go\", \"CheckAttachResult\", \"CodeUnauthorized\", \"attach input binding\", 1, \"CheckAttachResult\", \"\", nil},\n481|\t{\"conformance.go\", \"CheckEntrypoint\", \"CodePreconditionFailed\", \"entrypoint argv\", 1, \"CheckEntrypoint\", \"\", nil},\n482|\t{\"conformance.go\", \"CheckEntrypoint\", \"CodePreconditionFailed\", \"entrypoint session binding\", 1, \"CheckEntrypoint\", \"\", nil},\n483|\t{\"conformance.go\", \"CheckEntrypoint\", \"CodePreconditionFailed\", \"entrypoint session binding\", 2, \"CheckEntrypoint\", \"\", nil},\n484|\t{\"conformance.go\", \"CheckEntrypoint\", \"CodePreconditionFailed\", \"entrypoint session binding\", 3, \"CheckEntrypoint\", \"\", nil},\n485|\t{\"conformance.go\", \"CheckErrorAllowed\", \"CodeProtocolError\", \"operation error vocabulary\", 1, \"CheckErrorAllowed\", \"\", nil},\n486|\t{\"conformance.go\", \"CheckReplicable\", \"CodeProtocolError\", \"replication exclusion\", 1, \"CheckReplicable\", \"\", nil},\n487|\t{\"conformance.go\", \"CheckStatusResult\", \"CodePreconditionFailed\", \"status attachability\", 1, \"CheckStatusResult\", \"\", nil},\n488|\t{\"conformance.go\", \"CheckStatusResult\", \"CodeProtocolError\", \"status identity binding\", 1, \"CheckStatusResult\", \"\", nil},\n489|\t{\"conformance.go\", \"CheckStatusResult\", \"CodeProtocolError\", \"status identity binding\", 2, \"CheckStatusResult\", \"\", nil},\n490|\t{\"conformance.go\", \"CheckStatusResult\", \"CodeProtocolError\", \"status provider observation\", 1, \"CheckStatusResult\", \"\", nil},\n491|\t{\"conformance.go\", \"CheckTransition\", \"CodePreconditionFailed\", \"lifecycle instance scope\", 1, \"CheckTransition\", \"\", nil},\n492|\t{\"conformance.go\", \"CheckTransition\", \"CodePreconditionFailed\", \"lifecycle transition\", 1, \"CheckTransition\", \"\", nil},\n493|\t{\"conformance.go\", \"CheckTransition\", \"CodeProtocolError\", \"operation vocabulary\", 1, \"CheckTransition\", boundUnreachableVocabulary, nil},\n494|\t{\"conformance.go\", \"IdempotencyKey\", \"CodeProtocolError\", \"idempotency key shape\", 1, \"IdempotencyKey\", \"\", nil},\n495|\t{\"conformance.go\", \"IdempotencyKey\", \"CodeProtocolError\", \"idempotency key shape\", 2, \"IdempotencyKey\", \"\", nil},\n496|\t{\"conformance.go\", \"IdempotencyKey\", \"CodeProtocolError\", \"idempotency key shape\", 3, \"IdempotencyKey\", \"\", nil},\n497|\t{\"conformance.go\", \"ImportLedger\", \"CodeIdempotencyMismatch\", \"idempotency ledger image\", 1, \"ImportLedger\", \"\", nil},\n498|\t{\"conformance.go\", \"ImportLedger\", \"CodeProtocolError\", \"idempotency ledger image\", 1, \"ImportLedger\", \"\", nil},\n499|\t{\"conformance.go\", \"ImportLedger\", \"CodeProtocolError\", \"idempotency ledger image\", 2, \"ImportLedger\", \"\", nil},\n500|\t{\"conformance.go\", \"ImportLedger\", \"CodeProtocolError\", \"idempotency ledger image\", 3, \"ImportLedger\", \"\", nil},\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
