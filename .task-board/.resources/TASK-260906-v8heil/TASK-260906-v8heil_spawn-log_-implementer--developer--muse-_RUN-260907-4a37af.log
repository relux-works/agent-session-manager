{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c665","stream":{"kind":"session","id":"01a079e0-55db-79f2-85b0-c8c2e4c1a43f"},"sequence":397,"recorded_at":1780531400000789,"record_type":"event","durability":"durable","causation_id":"38173c32-e836-4324-8339-ee117e4249f1","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"38173c32-e836-4324-8339-ee117e4249f1","run_stream":{"kind":"run","id":"38173c32-e836-4324-8339-ee117e4249f1"},"task_stream":{"kind":"task","id":"5c0f9803-e707-4c2d-85fc-ab7dc419a1f5"},"task_id":"5c0f9803-e707-4c2d-85fc-ab7dc419a1f5","event":{"kind":"output","task_id":"5c0f9803-e707-4c2d-85fc-ab7dc419a1f5","chunk":"Read text file `internal/provider/refusal_inventory_test.go`.\n1|package provider\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"flag\"\n6|\t\"fmt\"\n7|\t\"go/ast\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"sort\"\n11|\t\"strings\"\n12|\t\"testing\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/invcore\"\n15|)\n16|\n17|// refusalRecorder is the shared core's runtime direction: the production\n18|// file:line behind every instrumented refusal constructor call made\n19|// during the test run, plus the stable codes those refusals carried.\n20|// Constructor vars are swapped in TestMain, so an aliased constructor\n21|// still executes the swapped var and records its real production site:\n22|// the runtime direction of the alias-bypass union.\n23|var refusalRecorder = invcore.NewSiteRecorder()\n24|\n25|func recordRefusalSite(code string) {\n26|\trefusalRecorder.Record(code, 2)\n27|}\n28|\n29|func TestMain(main *testing.M) {\n30|\torigDuplicate, origInvalid, origPrecondition, origIntegrity := failDuplicate, failInvalid, failPrecondition, failIntegrity\n31|\tfailDuplicate = func(providerID, firstSource, secondSource string) Error {\n32|\t\terr := origDuplicate(providerID, firstSource, secondSource)\n33|\t\trecordRefusalSite(err.Code())\n34|\t\treturn err\n35|\t}\n36|\tfailInvalid = func(detail string) Error {\n37|\t\terr := origInvalid(detail)\n38|\t\trecordRefusalSite(err.Code())\n39|\t\treturn err\n40|\t}\n41|\tfailPrecondition = func(detail string, cause error) Error {\n42|\t\terr := origPrecondition(detail, cause)\n43|\t\trecordRefusalSite(err.Code())\n44|\t\treturn err\n45|\t}\n46|\tfailIntegrity = func(detail string, cause error) Error {\n47|\t\terr := origIntegrity(detail, cause)\n48|\t\trecordRefusalSite(err.Code())\n49|\t\treturn err\n50|\t}\n51|\tcode := main.Run()\n52|\tif code == 0 && fullPackageTestRun() {\n53|\t\tif failures := auditRefusalInventory(); len(failures) != 0 {\n54|\t\t\tfor _, failure := range failures {\n55|\t\t\t\tfmt.Fprintln(os.Stderr, failure)\n56|\t\t\t}\n57|\t\t\tcode = 1\n58|\t\t}\n59|\t}\n60|\tos.Exit(code)\n61|}\n62|\n63|func fullPackageTestRun() bool {\n64|\tselected := flag.Lookup(\"test.run\")\n65|\treturn selected == nil || selected.Value.String() == \"\"\n66|}\n67|\n68|// auditRefusalInventory derives the refusal inventory from package source,\n69|// never from memory: every production call to a refusal constructor must\n70|// have an exercised negative path, no Error value may be built outside the\n71|// four constructors, and the observed code set must equal the closed code\n72|// set exactly.\n73|func auditRefusalInventory() []string {\n74|\tdirectory, err := os.Getwd()\n75|\tif err != nil {\n76|\t\treturn []string{fmt.Sprintf(\"derive provider refusal inventory: %v\", err)}\n77|\t}\n78|\tinventory, err := deriveRefusalInventory(directory)\n79|\tif err != nil {\n80|\t\treturn []string{fmt.Sprintf(\"derive provider refusal inventory: %v\", err)}\n81|\t}\n82|\tvar failures []string\n83|\t// Floor: a derived domain that can silently derive nothing is not a\n84|\t// measurement. An empty or short derivation must fail closed, never\n85|\t// pass vacuously — the same \"the scan is blind\" floor the package's\n86|\t// other derived scans carry.\n87|\tif len(inventory.ScannedFiles) == 0 {\n88|\t\tfailures = append(failures, \"scanned no production sources; the check is blind\")\n89|\t}\n90|\tif len(inventory.Sites) == 0 {\n91|\t\tfailures = append(failures, \"derived no refusal sites; the scan is blind\")\n92|\t}\n93|\t// Reverse direction: every exercised refusal site must resolve to a\n94|\t// derived site. The exercised set is derived from the test run, not\n95|\t// hand-listed, so a truncated derivation (1 of N sites, provider.go\n96|\t// skipped, or an empty-but-successful read of the wrong directory)\n97|\t// reddens here even though the forward check passes vacuously.\n98|\tderived := map[string]struct{}{}\n99|\tfor _, site := range inventory.Sites {\n100|\t\tderived[site] = struct{}{}\n101|\t}\n102|\t// Both directions run through the shared harness: derived sites\n103|\t// without an exercised path (forward) and exercised sites outside\n104|\t// the derivation (reverse) fail together.\n105|\tmissing, outside, scanFailures := invcore.DiffSets(derived, refusalRecorder.Sites())\n106|\tfailures = append(failures, scanFailures...)\n107|\tif len(outside) != 0 {\n108|\t\tfailures = append(failures, \"exercised refusal sites outside the derived inventory; the derivation is short: \"+strings.Join(outside, \", \"))\n109|\t}\n110|\tif len(inventory.StrayLiterals) != 0 {\n111|\t\tsort.Strings(inventory.StrayLiterals)\n112|\t\tfailures = append(failures, \"provider refusals built outside an instrumented constructor: \"+strings.Join(inventory.StrayLiterals, \", \"))\n113|\t}\n114|\tif len(inventory.RawConstructors) != 0 {\n115|\t\tsort.Strings(inventory.RawConstructors)\n116|\t\tfailures = append(failures, \"provider raw error construction outside documented cause sites: \"+strings.Join(inventory.RawConstructors, \", \"))\n117|\t}\n118|\tif len(missing) != 0 {\n119|\t\tfailures = append(failures, \"provider refusal call sites without an exercised negative path: \"+strings.Join(missing, \", \"))\n120|\t}\n121|\tcodes := refusalRecorder.Codes()\n122|\twant := []string{codeIntegrityFailure, codeInvalidConfig, codeLocalPrecondition}\n123|\tif fmt.Sprintf(\"%v\", codes) != fmt.Sprintf(\"%v\", want) {\n124|\t\tfailures = append(failures, fmt.Sprintf(\"observed refusal codes = %v, want closed set %v\", codes, want))\n125|\t}\n126|\treturn failures\n127|}\n128|\n129|// refusalInventory is derived from package sources.\n130|type refusalInventory struct {\n131|\t// ScannedFiles are the production source basenames the derivation\n132|\t// parsed. The audit fails closed when this is empty: a successful\n133|\t// read of the wrong directory must not pass as a clean inventory.\n134|\tScannedFiles []string\n135|\t// Sites are file:line positions of production refusal constructor calls.\n136|\tSites []string\n137|\t// StrayLiterals are Error composite literals outside the constructors.\n138|\tStrayLiterals []string\n139|\t// RawConstructors are errors.New, fmt.Errorf, or panic calls outside\n140|\t// the documented owner-attestation cause sites.\n141|\tRawConstructors []string\n142|}\n143|\n144|var refusalConstructors = map[string]bool{\n145|\t\"failDuplicate\":    true,\n146|\t\"failInvalid\":      true,\n147|\t\"failPrecondition\": true,\n148|\t\"failIntegrity\":    true,\n149|}\n150|\n151|// causeSiteFiles are the only production files allowed to mint raw cause\n152|// errors: the platform owner-attestation seams whose failures production\n153|// code always wraps in a refusal constructor.\n154|var causeSiteFiles = map[string]bool{\n155|\t\"os_unix.go\":    true,\n156|\t\"os_windows.go\": true,\n157|}\n158|\n159|func deriveRefusalInventory(directory string) (refusalInventory, error) {\n160|\tscannedFiles, fileSet, failures := invcore.ScanProduction(directory)\n161|\tif len(failures) != 0 {\n162|\t\treturn refusalInventory{}, errors.New(strings.Join(failures, \"; \"))\n163|\t}\n164|\tvar inventory refusalInventory\n165|\tfor _, production := range scannedFiles {\n166|\t\tname, syntax := production.Name, production.Syntax\n167|\t\tinventory.ScannedFiles = append(inventory.ScannedFiles, name)\n168|\t\t// Map each constructor's own body span so literals inside it are\n169|\t\t// not mistaken for strays.\n170|\t\tconstructorBodies := map[*ast.FuncLit]bool{}\n171|\t\tfor _, decl := range syntax.Decls {\n172|\t\t\tgeneral, ok := decl.(*ast.GenDecl)\n173|\t\t\tif !ok {\n174|\t\t\t\tcontinue\n175|\t\t\t}\n176|\t\t\tfor _, spec := range general.Specs {\n177|\t\t\t\tvalues, ok := spec.(*ast.ValueSpec)\n178|\t\t\t\tif !ok {\n179|\t\t\t\t\tcontinue\n180|\t\t\t\t}\n181|\t\t\t\tfor i, ident := range values.Names {\n182|\t\t\t\t\tif !refusalConstructors[ident.Name] || i >= len(values.Values) {\n183|\t\t\t\t\t\tcontinue\n184|\t\t\t\t\t}\n185|\t\t\t\t\tif literal, ok := values.Values[i].(*ast.FuncLit); ok {\n186|\t\t\t\t\t\tconstructorBodies[literal] = true\n187|\t\t\t\t\t}\n188|\t\t\t\t}\n189|\t\t\t}\n190|\t\t}\n191|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n192|\t\t\tcall, ok := node.(*ast.CallExpr)\n193|\t\t\tif !ok {\n194|\t\t\t\treturn true\n195|\t\t\t}\n196|\t\t\tposition := fileSet.Position(call.Pos())\n197|\t\t\tsite := fmt.Sprintf(\"%s:%d\", filepath.Base(position.Filename), position.Line)\n198|\t\t\tif ident, ok := call.Fun.(*ast.Ident); ok {\n199|\t\t\t\tif refusalConstructors[ident.Name] {\n200|\t\t\t\t\tinventory.Sites = append(inventory.Sites, site)\n201|\t\t\t\t\treturn true\n202|\t\t\t\t}\n203|\t\t\t\tif ident.Name == \"panic\" {\n204|\t\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" panic\")\n205|\t\t\t\t\treturn true\n206|\t\t\t\t}\n207|\t\t\t}\n208|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n209|\t\t\tif !ok {\n210|\t\t\t\treturn true\n211|\t\t\t}\n212|\t\t\tif qualifier, ok := selector.X.(*ast.Ident); ok {\n213|\t\t\t\tqualified := qualifier.Name + \".\" + selector.Sel.Name\n214|\t\t\t\tif qualified == \"errors.New\" || qualified == \"fmt.Errorf\" {\n215|\t\t\t\t\tif !causeSiteFiles[name] {\n216|\t\t\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" \"+qualified)\n217|\t\t\t\t\t}\n218|\t\t\t\t\treturn true\n219|\t\t\t\t}\n220|\t\t\t}\n221|\t\t\tif selector.Sel.Name == \"panic\" {\n222|\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" panic\")\n223|\t\t\t}\n224|\t\t\treturn true\n225|\t\t})\n226|\t\t// Stray Error literals: composite literals of type Error outside\n227|\t\t// a constructor body. Bodies are matched by source span.\n228|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n229|\t\t\tliteral, ok := node.(*ast.CompositeLit)\n230|\t\t\tif !ok {\n231|\t\t\t\treturn true\n232|\t\t\t}\n233|\t\t\tident, ok := literal.Type.(*ast.Ident)\n234|\t\t\tif !ok || ident.Name != \"Error\" {\n235|\t\t\t\treturn true\n236|\t\t\t}\n237|\t\t\tfor body := range constructorBodies {\n238|\t\t\t\tif literal.Pos() >= body.Pos() && literal.End() <= body.End() {\n239|\t\t\t\t\treturn true\n240|\t\t\t\t}\n241|\t\t\t}\n242|\t\t\tposition := fileSet.Position(literal.Pos())\n243|\t\t\tinventory.StrayLiterals = append(inventory.StrayLiterals, fmt.Sprintf(\"%s:%d\", filepath.Base(position.Filename), position.Line))\n244|\t\t\treturn true\n245|\t\t})\n246|\t}\n247|\treturn inventory, nil\n248|}"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c667","stream":{"kind":"session","id":"01a079e0-55db-79f2-85b0-c8c2e4c1a43f"},"sequence":398,"recorded_at":1780531400000791,"record_type":"event","durability":"durable","causation_id":"38173c32-e836-4324-8339-ee117e4249f1","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"38173c32-e836-4324-8339-ee117e4249f1","run_stream":{"kind":"run","id":"38173c32-e836-4324-8339-ee117e4249f1"},"task_stream":{"kind":"task","id":"5c0f9803-e707-4c2d-85fc-ab7dc419a1f5"},"task_id":"5c0f9803-e707-4c2d-85fc-ab7dc419a1f5","event":{"kind":"completed","task_id":"5c0f9803-e707-4c2d-85fc-ab7dc419a1f5"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c669","stream":{"kind":"session","id":"01a079e0-55db-79f2-85b0-c8c2e4c1a43f"},"sequence":399,"recorded_at":1780531400000793,"record_type":"event","durability":"durable","causation_id":"38173c32-e836-4324-8339-ee117e4249f1","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"38173c32-e836-4324-8339-ee117e4249f1","run_stream":{"kind":"run","id":"38173c32-e836-4324-8339-ee117e4249f1"},"task_stream":{"kind":"task","id":"6db52922-4987-4f84-8c9c-65140ab342d3"},"task_id":"6db52922-4987-4f84-8c9c-65140ab342d3","event":{"kind":"output","task_id":"6db52922-4987-4f84-8c9c-65140ab342d3","chunk":"Read text file `internal/provhost/refusal_arm_inventory_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"fmt\"\n8|\t\"go/ast\"\n9|\t\"go/token\"\n10|\t\"os\"\n11|\t\"sort\"\n12|\t\"strconv\"\n13|\t\"strings\"\n14|\t\"testing\"\n15|\t\"time\"\n16|\n17|\t\"github.com/relux-works/agent-session-manager/internal/invcore\"\n18|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n19|)\n20|\n21|// This file is the derived refusal-arm inventory. It exists because the\n22|// constructor call-site audit in inventory_test.go enumerates constructor\n23|// call SITES, and every frameFault literal and every integrity(...) detail\n24|// funnels through a shared site: planting a new arm through an existing\n25|// site (a new &frameFault literal in checkResponseMembers, a new\n26|// integrity(...) detail in DecodeStatusOutcome) leaves the whole suite\n27|// green. Two review rounds each missed a row by hand, so the arm set is\n28|// derived from production source by parsing it, never by listing it.\n29|//\n30|// Derivation (deriveRefusalArms): every &frameFault{...} literal yields\n31|// frame|<detail>|<member source>; every integrity(...) call with a string\n32|// literal yields integrity|<detail>; the single wrapping site\n33|// integrity(\"status body is \"+fault.detail, ...) expands over the derived\n34|// frame detail set, so each wrapped refusal is its own obligation; every\n35|// rejection branch of parseMajor (a return 0, false) yields\n36|// parse|<enclosing condition source>; every literal first argument to one\n37|// of the six refusal constructors yields ctor|<constructor>|<detail>.\n38|// A non-literal frameFault detail or integrity argument lands as an\n39|// expr:<source> obligation rather than passing silently; a non-literal\n40|// constructor first argument is a fault conduit (fault.detail, a detail\n41|// variable) whose arms are the frame arms above, so it carries no\n42|// separate obligation by design. A missing parseMajor fails the\n43|// derivation outright.\n44|//\n45|// Both directions are checked: TestDerivedRefusalArmsAreAllWitnessed\n46|// (every derived arm carries a witness) and\n47|// TestWitnessedArmsAreAllDerived (every witness names a derived arm, so a\n48|// truncated derivation reddens on the orphaned witnesses instead of\n49|// passing vacuously). TestEveryArmWitnessRefusesAtTheProductionEntry\n50|// drives each witness through the production entry and requires the\n51|// refusal to come from the arm under test. Empty, single-file, or\n52|// unparseable derivations fail closed: a domain that silently derives\n53|// nothing is not a measurement.\n54|//\n55|// Stated bound: arms sharing one (constructor, detail) identity merge to\n56|// one obligation (the two timeout sites, the two empty-response sites,\n57|// the six identical \"not a JSON object\" sites). Deleting one of a merged\n58|// pair is a behavioral mutant the entry-point tests must catch, not this\n59|// inventory.\n60|\n61|// refusalArmCensusFloor is the derived arm count this test was written\n62|// against. It is a tripwire, not an enumeration: a derivation returning\n63|// fewer arms fails closed even when every surviving arm is witnessed,\n64|// which is what catches a silently truncated scan. Raising it is routine\n65|// when production gains a refusal; lowering it requires saying why.\n66|//\n67|// Raised 60 -> 162 by the operation-layer leaf (manifest, probe,\n68|// profile, quiescence, spawn, identity, idempotency decoders), each\n69|// new arm witnessed in declaredOperationWitnesses below, then 162 ->\n70|// 164 by the lone-surrogate gate and 164 -> 166 by the UTF-8 gate:\n71|// one frame arm in decodeStrictObject plus its status-body integrity\n72|// expansion each, every one witnessed above.\n73|const refusalArmCensusFloor = 166\n74|\n75|func deriveRefusalArms(t *testing.T) map[string]struct{} {\n76|\tt.Helper()\n77|\tdirectory, err := os.Getwd()\n78|\tif err != nil {\n79|\t\tt.Fatalf(\"derive refusal arms: %v\", err)\n80|\t}\n81|\tarms, scanned, err := refusalArmsIn(directory)\n82|\tif err != nil {\n83|\t\tt.Fatalf(\"derive refusal arms: %v\", err)\n84|\t}\n85|\tif len(scanned) == 0 {\n86|\t\tt.Fatal(\"derived refusal arms from zero production files; the scanner is broken, not the package\")\n87|\t}\n88|\tif len(arms) == 0 {\n89|\t\tt.Fatal(\"derived zero refusal arms from the package sources; the scanner is broken, not the package\")\n90|\t}\n91|\tif len(arms) < refusalArmCensusFloor {\n92|\t\tt.Fatalf(\"derived %d refusal arms, below the %d census floor; the derivation is short, not the package\", len(arms), refusalArmCensusFloor)\n93|\t}\n94|\tt.Logf(\"refusal arm coverage domain: %d derived arms across %d production files\", len(arms), len(scanned))\n95|\treturn arms\n96|}\n97|\n98|func refusalArmsIn(directory string) (map[string]struct{}, []string, error) {\n99|\t// Production-file selection and fail-closed parsing are the shared\n100|\t// core's; the derivation below only classifies.\n101|\tscannedFiles, fileSet, failures := invcore.ScanProduction(directory)\n102|\tif len(failures) != 0 {\n103|\t\treturn nil, nil, errors.New(strings.Join(failures, \"; \"))\n104|\t}\n105|\tarms := map[string]struct{}{}\n106|\tvar scanned []string\n107|\tparseBranches := 0\n108|\ttype productionFile struct {\n109|\t\tsyntax *ast.File\n110|\t\tsource []byte\n111|\t}\n112|\tvar files []productionFile\n113|\tfor _, production := range scannedFiles {\n114|\t\tscanned = append(scanned, production.Name)\n115|\t\tfiles = append(files, productionFile{syntax: production.Syntax, source: production.Source})\n116|\t}\n117|\t// First pass, package-wide: the decodeStrictObject fault detail\n118|\t// set, which the integrity wrapper site expands over. The wrapper\n119|\t// only wraps decodeStrictObject faults, so checkResponseMembers\n120|\t// arms (\"missing member\", \"unknown member\", ...) are not in this\n121|\t// set: expanding over every frameFault literal would invent arms\n122|\t// production can never emit. The pass must span files because the\n123|\t// literals live in protocol.go while the wrapper lives in status.go.\n124|\tvar strictDetails []string\n125|\tseenDetail := map[string]bool{}\n126|\tfor _, file := range files {\n127|\t\tfor _, decl := range file.syntax.Decls {\n128|\t\t\tfunction, ok := decl.(*ast.FuncDecl)\n129|\t\t\tif !ok || function.Name.Name != \"decodeStrictObject\" {\n130|\t\t\t\tcontinue\n131|\t\t\t}\n132|\t\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n133|\t\t\t\tliteral, ok := frameFaultLiteral(node)\n134|\t\t\t\tif !ok {\n135|\t\t\t\t\treturn true\n136|\t\t\t\t}\n137|\t\t\t\tdetail, ok := literalStringField(file.source, fileSet, literal, \"detail\")\n138|\t\t\t\tif !ok {\n139|\t\t\t\t\treturn true\n140|\t\t\t\t}\n141|\t\t\t\tif !seenDetail[detail] {\n142|\t\t\t\t\tseenDetail[detail] = true\n143|\t\t\t\t\tstrictDetails = append(strictDetails, detail)\n144|\t\t\t\t}\n145|\t\t\t\treturn true\n146|\t\t\t})\n147|\t\t}\n148|\t}\n149|\tfor _, file := range files {\n150|\t\tsource, syntax := file.source, file.syntax\n151|\t\tparseBranches += armParseBranches(source, fileSet, syntax, arms)\n152|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n153|\t\t\tif literal, ok := frameFaultLiteral(node); ok {\n154|\t\t\t\tdetail, ok := literalStringField(source, fileSet, literal, \"detail\")\n155|\t\t\t\tif !ok {\n156|\t\t\t\t\tarms[\"frame|expr:\"+nodeSource(source, fileSet, node)] = struct{}{}\n157|\t\t\t\t\treturn true\n158|\t\t\t\t}\n159|\t\t\t\tmember := \"\"\n160|\t\t\t\tif kv := literalField(literal, \"member\"); kv != nil {\n161|\t\t\t\t\tmember = nodeSource(source, fileSet, kv.Value)\n162|\t\t\t\t}\n163|\t\t\t\tarms[\"frame|\"+detail+\"|\"+member] = struct{}{}\n164|\t\t\t\treturn true\n165|\t\t\t}\n166|\t\t\tcall, ok := node.(*ast.CallExpr)\n167|\t\t\tif !ok {\n168|\t\t\t\treturn true\n169|\t\t\t}\n170|\t\t\tident, ok := call.Fun.(*ast.Ident)\n171|\t\t\tif !ok || len(call.Args) == 0 {\n172|\t\t\t\treturn true\n173|\t\t\t}\n174|\t\t\tswitch ident.Name {\n175|\t\t\tcase \"integrity\":\n176|\t\t\t\tif literal, ok := call.Args[0].(*ast.BasicLit); ok && literal.Kind == token.STRING {\n177|\t\t\t\t\tdetail, err := strconv.Unquote(literal.Value)\n178|\t\t\t\t\tif err != nil {\n179|\t\t\t\t\t\tarms[\"integrity|expr:\"+nodeSource(source, fileSet, call.Args[0])] = struct{}{}\n180|\t\t\t\t\t\treturn true\n181|\t\t\t\t\t}\n182|\t\t\t\t\tarms[\"integrity|\"+detail] = struct{}{}\n183|\t\t\t\t\treturn true\n184|\t\t\t\t}\n185|\t\t\t\tif prefix, ok := integrityPrefix(call.Args[0]); ok {\n186|\t\t\t\t\tif len(strictDetails) == 0 {\n187|\t\t\t\t\t\tarms[\"integrity|expr:\"+nodeSource(source, fileSet, call.Args[0])] = struct{}{}\n188|\t\t\t\t\t\treturn true\n189|\t\t\t\t\t}\n190|\t\t\t\t\tfor _, detail := range strictDetails {\n191|\t\t\t\t\t\tarms[\"integrity|\"+prefix+detail] = struct{}{}\n192|\t\t\t\t\t}\n193|\t\t\t\t\treturn true\n194|\t\t\t\t}\n195|\t\t\t\tarms[\"integrity|expr:\"+nodeSource(source, fileSet, call.Args[0])] = struct{}{}\n196|\t\t\tcase \"failInvalid\", \"failProtocol\", \"failMismatch\", \"failProcess\", \"failTimeout\":\n197|\t\t\t\tif literal, ok := call.Args[0].(*ast.BasicLit); ok && literal.Kind == token.STRING {\n198|\t\t\t\t\tdetail, err := strconv.Unquote(literal.Value)\n199|\t\t\t\t\tif err != nil {\n200|\t\t\t\t\t\treturn true\n201|\t\t\t\t\t}\n202|\t\t\t\t\tarms[\"ctor|\"+ident.Name+\"|\"+detail] = struct{}{}\n203|\t\t\t\t}\n204|\t\t\t\t// Non-literal first arguments are the fault conduits\n205|\t\t\t\t// (fault.detail, detail variables): the arms behind\n206|\t\t\t\t// them are the frame arms above, so there is no\n207|\t\t\t\t// separate obligation here.\n208|\t\t\t}\n209|\t\t\treturn true\n210|\t\t})\n211|\t}\n212|\tif parseBranches == 0 {\n213|\t\treturn nil, nil, fmt.Errorf(\"parseMajor carries no rejection branch anywhere; the classification-branch enumeration is blind\")\n214|\t}\n215|\tsort.Strings(scanned)\n216|\treturn arms, scanned, nil\n217|}\n218|\n219|// frameFaultLiteral reports whether node is a &frameFault{...} literal.\n220|func frameFaultLiteral(node ast.Node) (*ast.CompositeLit, bool) {\n221|\ttarget := node\n222|\tif unary, ok := node.(*ast.UnaryExpr); ok && unary.Op == token.AND {\n223|\t\ttarget = unary.X\n224|\t}\n225|\tliteral, ok := target.(*ast.CompositeLit)\n226|\tif !ok {\n227|\t\treturn nil, false\n228|\t}\n229|\tident, ok := literal.Type.(*ast.Ident)\n230|\tif !ok || ident.Name != \"frameFault\" {\n231|\t\treturn nil, false\n232|\t}\n233|\treturn literal, true\n234|}\n235|\n236|func literalField(literal *ast.CompositeLit, name string) *ast.KeyValueExpr {\n237|\tfor _, element := range literal.Elts {\n238|\t\tif kv, ok := element.(*ast.KeyValueExpr); ok {\n239|\t\t\tif ident, ok := kv.Key.(*ast.Ident); ok && ident.Name == name {\n240|\t\t\t\treturn kv\n241|\t\t\t}\n242|\t\t}\n243|\t}\n244|\treturn nil\n245|}\n246|\n247|func literalStringField(source []byte, fileSet *token.FileSet, literal *ast.CompositeLit, name string) (string, bool) {\n248|\tkv := literalField(literal, name)\n249|\tif kv == nil {\n250|\t\treturn \"\", false\n251|\t}\n252|\tbasic, ok := kv.Value.(*ast.BasicLit)\n253|\tif !ok || basic.Kind != token.STRING {\n254|\t\treturn \"\", false\n255|\t}\n256|\tdetail, err := strconv.Unquote(basic.Value)\n257|\tif err != nil {\n258|\t\treturn \"\", false\n259|\t}\n260|\treturn detail, true\n261|}\n262|\n263|// integrityPrefix matches \"prefix\" + <expr>, the wrapping shape whose\n264|// arms expand over the derived frame detail set.\n265|func integrityPrefix(arg ast.Expr) (string, bool) {\n266|\tbinary, ok := arg.(*ast.BinaryExpr)\n267|\tif !ok || binary.Op != token.ADD {\n268|\t\treturn \"\", false\n269|\t}\n270|\tprefix, ok := binary.X.(*ast.BasicLit)\n271|\tif !ok || prefix.Kind != token.STRING {\n272|\t\treturn \"\", false\n273|\t}\n274|\ttext, err := strconv.Unquote(prefix.Value)\n275|\tif err != nil {\n276|\t\treturn \"\", false\n277|\t}\n278|\treturn text, true\n279|}\n280|\n281|func nodeSource(source []byte, fileSet *token.FileSet, node ast.Node) string {\n282|\tstart := fileSet.Position(node.Pos()).Offset\n283|\tend := fileSet.Position(node.End()).Offset\n284|\tif start < 0 || end > len(source) || start >= end {\n285|\t\treturn \"?\"\n286|\t}\n287|\treturn strings.Join(strings.Fields(string(source[start:end])), \" \")\n288|}\n289|\n290|// armParseBranches derives one obligation per parseMajor rejection\n291|// branch in this file: every return 0, false inside parseMajor, keyed by\n292|// its innermost enclosing condition, and returns how many it derived. A\n293|// new branch adds a key no witness names; a deleted branch orphans its\n294|// witness; narrowing || to && rewrites the key and does both. The caller\n295|// fails closed when no file derives any branch.\n296|func armParseBranches(source []byte, fileSet *token.FileSet, syntax *ast.File, arms map[string]struct{}) int {\n297|\tvar body *ast.BlockStmt\n298|\tfor _, decl := range syntax.Decls {\n299|\t\tfunction, ok := decl.(*ast.FuncDecl)\n300|\t\tif ok && function.Name.Name == \"parseMajor\" {\n301|\t\t\tbody = function.Body\n302|\t\t}\n303|\t}\n304|\tif body == nil {\n305|\t\treturn 0\n306|\t}\n307|\tcount := 0\n308|\tvar conditions []string\n309|\tvar walk func(node ast.Node)\n310|\twalk = func(node ast.Node) {\n311|\t\tbranch, ok := node.(*ast.IfStmt)\n312|\t\tif !ok {\n313|\t\t\tfor _, child := range childNodes(node) {\n314|\t\t\t\twalk(child)\n315|\t\t\t}\n316|\t\t\treturn\n317|\t\t}\n318|\t\tconditions = append(conditions, nodeSource(source, fileSet, branch.Cond))\n319|\t\tfor _, stmt := range branch.Body.List {\n320|\t\t\tif ret, ok := stmt.(*ast.ReturnStmt); ok && isFalsePair(ret) {\n321|\t\t\t\tarms[\"parse|\"+conditions[len(conditions)-1]] = struct{}{}\n322|\t\t\t\tcount++\n323|\t\t\t}\n324|\t\t}\n325|\t\tfor _, child := range childNodes(node) {\n326|\t\t\twalk(child)\n327|\t\t}\n328|\t\tconditions = conditions[:len(conditions)-1]\n329|\t}\n330|\twalk(body)\n331|\treturn count\n332|}\n333|\n334|func isFalsePair(ret *ast.ReturnStmt) bool {\n335|\tif len(ret.Results) != 2 {\n336|\t\treturn false\n337|\t}\n338|\tzero, ok := ret.Results[0].(*ast.BasicLit)\n339|\tif !ok || zero.Kind != token.INT || zero.Value != \"0\" {\n340|\t\treturn false\n341|\t}\n342|\tno, ok := ret.Results[1].(*ast.Ident)\n343|\treturn ok && no.Name == \"false\"\n344|}\n345|\n346|func childNodes(node ast.Node) []ast.Node {\n347|\tvar children []ast.Node\n348|\tast.Inspect(node, func(child ast.Node) bool {\n349|\t\tif child == nil || child == node {\n350|\t\t\treturn true\n351|\t\t}\n352|\t\tchildren = append(children, child)\n353|\t\treturn false\n354|\t})\n355|\treturn children\n356|}\n357|\n358|// armWitness proves one derived refusal arm at the production entry.\n359|// The arm key must equal the derived key exactly: TestWitnessedArmsAreAllDerived\n360|// fails a witness that names nothing production declares, so a deleted or\n361|// narrowed production branch orphans its witness instead of passing\n362|// silently. The prove function must drive the production entry point and\n363|// require the refusal attributed to THIS arm, not merely any refusal.\n364|type armWitness struct {\n365|\tarm   string\n366|\tname  string\n367|\tprove func(*testing.T)\n368|}\n369|\n370|// requireIntegrityRefusal asserts the full identity of a status refusal:\n371|// the integrity_failure code, the rule detail, the status_state detail\n372|// every integrity arm carries (AS6: asserted on all 18 arms, not just\n373|// the unknown row), exit 9, and the non-retryable bit. It is separate\n374|// from requireLocalRefusal because that helper also serves codes with no\n375|// status_state detail.\n376|func requireIntegrityRefusal(t *testing.T, err error, detail, wantState string) {\n377|\tt.Helper()\n378|\trequireLocalRefusal(t, err, \"integrity_failure\", detail)\n379|\tstate, ok := failureObject(t, err).Detail(\"status_state\")\n380|\tif !ok || state != wantState {\n381|\t\tt.Fatalf(\"integrity refusal status_state = %v, want %q (%v)\", state, wantState, err)\n382|\t}\n383|\tif failureExit(t, err) != 9 {\n384|\t\tt.Fatalf(\"integrity refusal exit = %d, want 9\", failureExit(t, err))\n385|\t}\n386|}\n387|\n388|func armVersionFrame(version string) []byte {\n389|\treturn []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"` + version + `\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)\n390|}\n391|\n392|func armMemberFrame(members string) []byte {\n393|\treturn []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",` + members + `}`)\n394|}\n395|\n396|func armOversizeResponse(t *testing.T) []byte {\n397|\tt.Helper()\n398|\tbuild := func(pad int) []byte {\n399|\t\treturn successFrame(t, testRequestID, `{\"pad\":\"`+strings.Repeat(\"a\", pad)+`\"}`)\n400|\t}\n401|\tbase := len(build(0))\n402|\tover := build(specFrameLimitBytes - base + 1)\n403|\tif len(over) != specFrameLimitBytes+1 {\n404|\t\tt.Fatalf(\"oversize fixture is %d bytes, want exactly %d\", len(over), specFrameLimitBytes+1)\n405|\t}\n406|\treturn over\n407|}\n408|\n409|func declaredArmWitnesses() []armWitness {\n410|\treturn []armWitness{\n411|\t\t// decodeStrictObject frame arms, through DecodeResponse.\n412|\t\t{arm: `frame|not a JSON object|\"\"`, name: \"array is not an object\", prove: func(t *testing.T) {\n413|\t\t\t_, err := DecodeResponse([]byte(`[1,2]`), mustUUIDv7(t, testRequestID))\n414|\t\t\trequireFrameRefusal(t, err, \"\", \"not a JSON object\")\n415|\t\t}},\n416|\t\t{arm: `frame|not a JSON object|key`, name: \"truncated value names its member\", prove: func(t *testing.T) {\n417|\t\t\t_, err := DecodeResponse([]byte(`{\"protocol\":`), mustUUIDv7(t, testRequestID))\n418|\t\t\trequireFrameRefusal(t, err, \"protocol\", \"not a JSON object\")\n419|\t\t}},\n420|\t\t{arm: `frame|duplicate member|key`, name: \"repeated member\", prove: func(t *testing.T) {\n421|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)\n422|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n423|\t\t\trequireFrameRefusal(t, err, \"request_id\", \"duplicate member\")\n424|\t\t}},\n425|\t\t{arm: `frame|trailing data after the object|\"\"`, name: \"trailing byte\", prove: func(t *testing.T) {\n426|\t\t\t_, err := DecodeResponse(append(successFrame(t, testRequestID, `{\"provider_id\":\"pi\"}`), 'x'), mustUUIDv7(t, testRequestID))\n427|\t\t\trequireFrameRefusal(t, err, \"\", \"trailing data after the object\")\n428|\t\t}},\n429|\t\t{arm: `frame|lone surrogate escape|\"\"`, name: \"lone surrogate in body\", prove: func(t *testing.T) {\n430|\t\t\t_, err := DecodeResponse(successFrame(t, testRequestID, `{\"provider_id\":\"pi\",\"tag\":\"a\\ud800b\"}`), mustUUIDv7(t, testRequestID))\n431|\t\t\trequireFrameRefusal(t, err, \"\", \"lone surrogate escape\")\n432|\t\t}},\n433|\t\t{arm: `frame|not valid UTF-8|\"\"`, name: \"raw bytes in body\", prove: func(t *testing.T) {\n434|\t\t\terr := DecodeManifest([]byte(\"{\\\"note\\\":\\\"ab\\xffcd\\\"}\"))\n435|\t\t\trequireFrameRefusal(t, err, \"\", \"not valid UTF-8\")\n436|\t\t}},\n437|\t\t{arm: `frame|missing member|name`, name: \"missing protocol\", prove: func(t *testing.T) {\n438|\t\t\tframe := []byte(`{\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)\n439|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n440|\t\t\trequireFrameRefusal(t, err, \"protocol\", \"missing member\")\n441|\t\t}},\n442|\t\t{arm: `frame|missing member|\"body\"`, name: \"success without body\", prove: func(t *testing.T) {\n443|\t\t\t_, err := DecodeResponse(armMemberFrame(`\"ok\":true`), mustUUIDv7(t, testRequestID))\n444|\t\t\trequireFrameRefusal(t, err, \"body\", \"missing member\")\n445|\t\t}},\n446|\t\t{arm: `frame|success envelope carries error|\"error\"`, name: \"error on success\", prove: func(t *testing.T) {\n447|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{},\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.0.0\",\"code\":\"capability_unavailable\",\"message\":\"m\",\"exit_code\":6,\"retryable\":false,\"details\":{}}}`)\n448|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n449|\t\t\trequireFrameRefusal(t, err, \"error\", \"success envelope carries error\")\n450|\t\t}},\n451|\t\t{arm: `frame|missing member|\"error\"`, name: \"failure without error\", prove: func(t *testing.T) {\n452|\t\t\t_, err := DecodeResponse(armMemberFrame(`\"ok\":false`), mustUUIDv7(t, testRequestID))\n453|\t\t\trequireFrameRefusal(t, err, \"error\", \"missing member\")\n454|\t\t}},\n455|\t\t{arm: `frame|failure envelope carries body|\"body\"`, name: \"body on failure\", prove: func(t *testing.T) {\n456|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":false,\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.0.0\",\"code\":\"capability_unavailable\",\"message\":\"m\",\"exit_code\":6,\"retryable\":false,\"details\":{}},\"body\":{}}`)\n457|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n458|\t\t\trequireFrameRefusal(t, err, \"body\", \"failure envelope carries body\")\n459|\t\t}},\n460|\t\t{arm: `frame|unknown member|name`, name: \"diagnostics member\", prove: func(t *testing.T) {\n461|\t\t\t_, err := DecodeResponse(armMemberFrame(`\"ok\":true,\"body\":{},\"diagnostics\":[]`), mustUUIDv7(t, testRequestID))\n462|\t\t\trequireFrameRefusal(t, err, \"diagnostics\", \"unknown member\")\n463|\t\t}},\n464|\t\t// encodeFrame refusals, through EncodeRequest.\n465|\t\t{arm: `ctor|failInvalid|unknown operation`, name: \"unknown operation never frames\", prove: func(t *testing.T) {\n466|\t\t\treq := testRequest(t)\n467|\t\t\treq.Operation = \"reboot\"\n468|\t\t\t_, err := EncodeRequest(req, mustInstant(t, testNow))\n469|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"unknown operation\")\n470|\t\t}},\n471|\t\t{arm: `ctor|failInvalid|request_id is not a UUIDv7`, name: \"zero request id\", prove: func(t *testing.T) {\n472|\t\t\tbad := testRequest(t)\n473|\t\t\tvar zero scalar.UUIDv7\n474|\t\t\tbad.RequestID = zero\n475|\t\t\t_, err := EncodeRequest(bad, mustInstant(t, testNow))\n476|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"request_id is not a UUIDv7\")\n477|\t\t}},\n478|\t\t{arm: `ctor|failInvalid|deadline is not a timestamp`, name: \"zero deadline\", prove: func(t *testing.T) {\n479|\t\t\treq := testRequest(t)\n480|\t\t\treq.Deadline = mustTimestamp(t, testDeadline)\n481|\t\t\tvar zero scalar.Timestamp\n482|\t\t\treq.Deadline = zero\n483|\t\t\t_, err := EncodeRequest(req, mustInstant(t, testNow))\n484|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"deadline is not a timestamp\")\n485|\t\t}},\n486|\t\t{arm: `ctor|failInvalid|deadline is not in the future`, name: \"stale deadline\", prove: func(t *testing.T) {\n487|\t\t\treq := testRequest(t)\n488|\t\t\treq.Deadline = mustTimestamp(t, testNow)\n489|\t\t\t_, err := EncodeRequest(req, mustInstant(t, testNow))\n490|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"deadline is not in the future\")\n491|\t\t}},\n492|\t\t{arm: `ctor|failInvalid|body is not a JSON object`, name: \"array body\", prove: func(t *testing.T) {\n493|\t\t\treq := testRequest(t)\n494|\t\t\treq.Body = json.RawMessage(`[1,2]`)\n495|\t\t\t_, err := EncodeRequest(req, mustInstant(t, testNow))\n496|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"body is not a JSON object\")\n497|\t\t}},\n498|\t\t{arm: `ctor|failInvalid|request frame exceeds 8 MiB`, name: \"oversize request\", prove: func(t *testing.T) {\n499|\t\t\treq := testRequest(t)\n500|\t\t\treq.Body = json.RawMessage(`{\"pad\":\"` + strings.Repeat(\"a\", specFrameLimitBytes) + `\"}`)\n(more lines below)"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c66b","stream":{"kind":"session","id":"01a079e0-55db-79f2-85b0-c8c2e4c1a43f"},"sequence":400,"recorded_at":1780531400000795,"record_type":"event","durability":"durable","causation_id":"38173c32-e836-4324-8339-ee117e4249f1","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"38173c32-e836-4324-8339-ee117e4249f1","run_stream":{"kind":"run","id":"38173c32-e836-4324-8339-ee117e4249f1"},"task_stream":{"kind":"task","id":"6db52922-4987-4f84-8c9c-65140ab342d3"},"task_id":"6db52922-4987-4f84-8c9c-65140ab342d3","event":{"kind":"completed","task_id":"6db52922-4987-4f84-8c9c-65140ab342d3"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c66d","stream":{"kind":"session","id":"01a079e0-55db-79f2-85b0-c8c2e4c1a43f"},"sequence":401,"recorded_at":1780531400000797,"record_type":"event","durability":"durable","causation_id":"38173c32-e836-4324-8339-ee117e4249f1","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38173c32-e836-4324-8339-ee117e4249f1","run_stream":{"kind":"run","id":"38173c32-e836-4324-8339-ee117e4249f1"},"call_id":"call_01a079e1afd676509f80a84d2b7049ea","text":"Read text file `internal/provhost/refusal_arm_inventory_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"fmt\"\n8|\t\"go/ast\"\n9|\t\"go/token\"\n10|\t\"os\"\n11|\t\"sort\"\n12|\t\"strconv\"\n13|\t\"strings\"\n14|\t\"testing\"\n15|\t\"time\"\n16|\n17|\t\"github.com/relux-works/agent-session-manager/internal/invcore\"\n18|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n19|)\n20|\n21|// This file is the derived refusal-arm inventory. It exists because the\n22|// constructor call-site audit in inventory_test.go enumerates constructor\n23|// call SITES, and every frameFault literal and every integrity(...) detail\n24|// funnels through a shared site: planting a new arm through an existing\n25|// site (a new &frameFault literal in checkResponseMembers, a new\n26|// integrity(...) detail in DecodeStatusOutcome) leaves the whole suite\n27|// green. Two review rounds each missed a row by hand, so the arm set is\n28|// derived from production source by parsing it, never by listing it.\n29|//\n30|// Derivation (deriveRefusalArms): every &frameFault{...} literal yields\n31|// frame|<detail>|<member source>; every integrity(...) call with a string\n32|// literal yields integrity|<detail>; the single wrapping site\n33|// integrity(\"status body is \"+fault.detail, ...) expands over the derived\n34|// frame detail set, so each wrapped refusal is its own obligation; every\n35|// rejection branch of parseMajor (a return 0, false) yields\n36|// parse|<enclosing condition source>; every literal first argument to one\n37|// of the six refusal constructors yields ctor|<constructor>|<detail>.\n38|// A non-literal frameFault detail or integrity argument lands as an\n39|// expr:<source> obligation rather than passing silently; a non-literal\n40|// constructor first argument is a fault conduit (fault.detail, a detail\n41|// variable) whose arms are the frame arms above, so it carries no\n42|// separate obligation by design. A missing parseMajor fails the\n43|// derivation outright.\n44|//\n45|// Both directions are checked: TestDerivedRefusalArmsAreAllWitnessed\n46|// (every derived arm carries a witness) and\n47|// TestWitnessedArmsAreAllDerived (every witness names a derived arm, so a\n48|// truncated derivation reddens on the orphaned witnesses instead of\n49|// passing vacuously). TestEveryArmWitnessRefusesAtTheProductionEntry\n50|// drives each witness through the production entry and requires the\n51|// refusal to come from the arm under test. Empty, single-file, or\n52|// unparseable derivations fail closed: a domain that silently derives\n53|// nothing is not a measurement.\n54|//\n55|// Stated bound: arms sharing one (constructor, detail) identity merge to\n56|// one obligation (the two timeout sites, the two empty-response sites,\n57|// the six identical \"not a JSON object\" sites). Deleting one of a merged\n58|// pair is a behavioral mutant the entry-point tests must catch, not this\n59|// inventory.\n60|\n61|// refusalArmCensusFloor is the derived arm count this test was written\n62|// against. It is a tripwire, not an enumeration: a derivation returning\n63|// fewer arms fails closed even when every surviving arm is witnessed,\n64|// which is what catches a silently truncated scan. Raising it is routine\n65|// when production gains a refusal; lowering it requires saying why.\n66|//\n67|// Raised 60 -> 162 by the operation-layer leaf (manifest, probe,\n68|// profile, quiescence, spawn, identity, idempotency decoders), each\n69|// new arm witnessed in declaredOperationWitnesses below, then 162 ->\n70|// 164 by the lone-surrogate gate and 164 -> 166 by the UTF-8 gate:\n71|// one frame arm in decodeStrictObject plus its status-body integrity\n72|// expansion each, every one witnessed above.\n73|const refusalArmCensusFloor = 166\n74|\n75|func deriveRefusalArms(t *testing.T) map[string]struct{} {\n76|\tt.Helper()\n77|\tdirectory, err := os.Getwd()\n78|\tif err != nil {\n79|\t\tt.Fatalf(\"derive refusal arms: %v\", err)\n80|\t}\n81|\tarms, scanned, err := refusalArmsIn(directory)\n82|\tif err != nil {\n83|\t\tt.Fatalf(\"derive refusal arms: %v\", err)\n84|\t}\n85|\tif len(scanned) == 0 {\n86|\t\tt.Fatal(\"derived refusal arms from zero production files; the scanner is broken, not the package\")\n87|\t}\n88|\tif len(arms) == 0 {\n89|\t\tt.Fatal(\"derived zero refusal arms from the package sources; the scanner is broken, not the package\")\n90|\t}\n91|\tif len(arms) < refusalArmCensusFloor {\n92|\t\tt.Fatalf(\"derived %d refusal arms, below the %d census floor; the derivation is short, not the package\", len(arms), refusalArmCensusFloor)\n93|\t}\n94|\tt.Logf(\"refusal arm coverage domain: %d derived arms across %d production files\", len(arms), len(scanned))\n95|\treturn arms\n96|}\n97|\n98|func refusalArmsIn(directory string) (map[string]struct{}, []string, error) {\n99|\t// Production-file selection and fail-closed parsing are the shared\n100|\t// core's; the derivation below only classifies.\n101|\tscannedFiles, fileSet, failures := invcore.ScanProduction(directory)\n102|\tif len(failures) != 0 {\n103|\t\treturn nil, nil, errors.New(strings.Join(failures, \"; \"))\n104|\t}\n105|\tarms := map[string]struct{}{}\n106|\tvar scanned []string\n107|\tparseBranches := 0\n108|\ttype productionFile struct {\n109|\t\tsyntax *ast.File\n110|\t\tsource []byte\n111|\t}\n112|\tvar files []productionFile\n113|\tfor _, production := range scannedFiles {\n114|\t\tscanned = append(scanned, production.Name)\n115|\t\tfiles = append(files, productionFile{syntax: production.Syntax, source: production.Source})\n116|\t}\n117|\t// First pass, package-wide: the decodeStrictObject fault detail\n118|\t// set, which the integrity wrapper site expands over. The wrapper\n119|\t// only wraps decodeStrictObject faults, so checkResponseMembers\n120|\t// arms (\"missing member\", \"unknown member\", ...) are not in this\n121|\t// set: expanding over every frameFault literal would invent arms\n122|\t// production can never emit. The pass must span files because the\n123|\t// literals live in protocol.go while the wrapper lives in status.go.\n124|\tvar strictDetails []string\n125|\tseenDetail := map[string]bool{}\n126|\tfor _, file := range files {\n127|\t\tfor _, decl := range file.syntax.Decls {\n128|\t\t\tfunction, ok := decl.(*ast.FuncDecl)\n129|\t\t\tif !ok || function.Name.Name != \"decodeStrictObject\" {\n130|\t\t\t\tcontinue\n131|\t\t\t}\n132|\t\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n133|\t\t\t\tliteral, ok := frameFaultLiteral(node)\n134|\t\t\t\tif !ok {\n135|\t\t\t\t\treturn true\n136|\t\t\t\t}\n137|\t\t\t\tdetail, ok := literalStringField(file.source, fileSet, literal, \"detail\")\n138|\t\t\t\tif !ok {\n139|\t\t\t\t\treturn true\n140|\t\t\t\t}\n141|\t\t\t\tif !seenDetail[detail] {\n142|\t\t\t\t\tseenDetail[detail] = true\n143|\t\t\t\t\tstrictDetails = append(strictDetails, detail)\n144|\t\t\t\t}\n145|\t\t\t\treturn true\n146|\t\t\t})\n147|\t\t}\n148|\t}\n149|\tfor _, file := range files {\n150|\t\tsource, syntax := file.source, file.syntax\n151|\t\tparseBranches += armParseBranches(source, fileSet, syntax, arms)\n152|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n153|\t\t\tif literal, ok := frameFaultLiteral(node); ok {\n154|\t\t\t\tdetail, ok := literalStringField(source, fileSet, literal, \"detail\")\n155|\t\t\t\tif !ok {\n156|\t\t\t\t\tarms[\"frame|expr:\"+nodeSource(source, fileSet, node)] = struct{}{}\n157|\t\t\t\t\treturn true\n158|\t\t\t\t}\n159|\t\t\t\tmember := \"\"\n160|\t\t\t\tif kv := literalField(literal, \"member\"); kv != nil {\n161|\t\t\t\t\tmember = nodeSource(source, fileSet, kv.Value)\n162|\t\t\t\t}\n163|\t\t\t\tarms[\"frame|\"+detail+\"|\"+member] = struct{}{}\n164|\t\t\t\treturn true\n165|\t\t\t}\n166|\t\t\tcall, ok := node.(*ast.CallExpr)\n167|\t\t\tif !ok {\n168|\t\t\t\treturn true\n169|\t\t\t}\n170|\t\t\tident, ok := call.Fun.(*ast.Ident)\n171|\t\t\tif !ok || len(call.Args) == 0 {\n172|\t\t\t\treturn true\n173|\t\t\t}\n174|\t\t\tswitch ident.Name {\n175|\t\t\tcase \"integrity\":\n176|\t\t\t\tif literal, ok := call.Args[0].(*ast.BasicLit); ok && literal.Kind == token.STRING {\n177|\t\t\t\t\tdetail, err := strconv.Unquote(literal.Value)\n178|\t\t\t\t\tif err != nil {\n179|\t\t\t\t\t\tarms[\"integrity|expr:\"+nodeSource(source, fileSet, call.Args[0])] = struct{}{}\n180|\t\t\t\t\t\treturn true\n181|\t\t\t\t\t}\n182|\t\t\t\t\tarms[\"integrity|\"+detail] = struct{}{}\n183|\t\t\t\t\treturn true\n184|\t\t\t\t}\n185|\t\t\t\tif prefix, ok := integrityPrefix(call.Args[0]); ok {\n186|\t\t\t\t\tif len(strictDetails) == 0 {\n187|\t\t\t\t\t\tarms[\"integrity|expr:\"+nodeSource(source, fileSet, call.Args[0])] = struct{}{}\n188|\t\t\t\t\t\treturn true\n189|\t\t\t\t\t}\n190|\t\t\t\t\tfor _, detail := range strictDetails {\n191|\t\t\t\t\t\tarms[\"integrity|\"+prefix+detail] = struct{}{}\n192|\t\t\t\t\t}\n193|\t\t\t\t\treturn true\n194|\t\t\t\t}\n195|\t\t\t\tarms[\"integrity|expr:\"+nodeSource(source, fileSet, call.Args[0])] = struct{}{}\n196|\t\t\tcase \"failInvalid\", \"failProtocol\", \"failMismatch\", \"failProcess\", \"failTimeout\":\n197|\t\t\t\tif literal, ok := call.Args[0].(*ast.BasicLit); ok && literal.Kind == token.STRING {\n198|\t\t\t\t\tdetail, err := strconv.Unquote(literal.Value)\n199|\t\t\t\t\tif err != nil {\n200|\t\t\t\t\t\treturn true\n201|\t\t\t\t\t}\n202|\t\t\t\t\tarms[\"ctor|\"+ident.Name+\"|\"+detail] = struct{}{}\n203|\t\t\t\t}\n204|\t\t\t\t// Non-literal first arguments are the fault conduits\n205|\t\t\t\t// (fault.detail, detail variables): the arms behind\n206|\t\t\t\t// them are the frame arms above, so there is no\n207|\t\t\t\t// separate obligation here.\n208|\t\t\t}\n209|\t\t\treturn true\n210|\t\t})\n211|\t}\n212|\tif parseBranches == 0 {\n213|\t\treturn nil, nil, fmt.Errorf(\"parseMajor carries no rejection branch anywhere; the classification-branch enumeration is blind\")\n214|\t}\n215|\tsort.Strings(scanned)\n216|\treturn arms, scanned, nil\n217|}\n218|\n219|// frameFaultLiteral reports whether node is a &frameFault{...} literal.\n220|func frameFaultLiteral(node ast.Node) (*ast.CompositeLit, bool) {\n221|\ttarget := node\n222|\tif unary, ok := node.(*ast.UnaryExpr); ok && unary.Op == token.AND {\n223|\t\ttarget = unary.X\n224|\t}\n225|\tliteral, ok := target.(*ast.CompositeLit)\n226|\tif !ok {\n227|\t\treturn nil, false\n228|\t}\n229|\tident, ok := literal.Type.(*ast.Ident)\n230|\tif !ok || ident.Name != \"frameFault\" {\n231|\t\treturn nil, false\n232|\t}\n233|\treturn literal, true\n234|}\n235|\n236|func literalField(literal *ast.CompositeLit, name string) *ast.KeyValueExpr {\n237|\tfor _, element := range literal.Elts {\n238|\t\tif kv, ok := element.(*ast.KeyValueExpr); ok {\n239|\t\t\tif ident, ok := kv.Key.(*ast.Ident); ok && ident.Name == name {\n240|\t\t\t\treturn kv\n241|\t\t\t}\n242|\t\t}\n243|\t}\n244|\treturn nil\n245|}\n246|\n247|func literalStringField(source []byte, fileSet *token.FileSet, literal *ast.CompositeLit, name string) (string, bool) {\n248|\tkv := literalField(literal, name)\n249|\tif kv == nil {\n250|\t\treturn \"\", false\n251|\t}\n252|\tbasic, ok := kv.Value.(*ast.BasicLit)\n253|\tif !ok || basic.Kind != token.STRING {\n254|\t\treturn \"\", false\n255|\t}\n256|\tdetail, err := strconv.Unquote(basic.Value)\n257|\tif err != nil {\n258|\t\treturn \"\", false\n259|\t}\n260|\treturn detail, true\n261|}\n262|\n263|// integrityPrefix matches \"prefix\" + <expr>, the wrapping shape whose\n264|// arms expand over the derived frame detail set.\n265|func integrityPrefix(arg ast.Expr) (string, bool) {\n266|\tbinary, ok := arg.(*ast.BinaryExpr)\n267|\tif !ok || binary.Op != token.ADD {\n268|\t\treturn \"\", false\n269|\t}\n270|\tprefix, ok := binary.X.(*ast.BasicLit)\n271|\tif !ok || prefix.Kind != token.STRING {\n272|\t\treturn \"\", false\n273|\t}\n274|\ttext, err := strconv.Unquote(prefix.Value)\n275|\tif err != nil {\n276|\t\treturn \"\", false\n277|\t}\n278|\treturn text, true\n279|}\n280|\n281|func nodeSource(source []byte, fileSet *token.FileSet, node ast.Node) string {\n282|\tstart := fileSet.Position(node.Pos()).Offset\n283|\tend := fileSet.Position(node.End()).Offset\n284|\tif start < 0 || end > len(source) || start >= end {\n285|\t\treturn \"?\"\n286|\t}\n287|\treturn strings.Join(strings.Fields(string(source[start:end])), \" \")\n288|}\n289|\n290|// armParseBranches derives one obligation per parseMajor rejection\n291|// branch in this file: every return 0, false inside parseMajor, keyed by\n292|// its innermost enclosing condition, and returns how many it derived. A\n293|// new branch adds a key no witness names; a deleted branch orphans its\n294|// witness; narrowing || to && rewrites the key and does both. The caller\n295|// fails closed when no file derives any branch.\n296|func armParseBranches(source []byte, fileSet *token.FileSet, syntax *ast.File, arms map[string]struct{}) int {\n297|\tvar body *ast.BlockStmt\n298|\tfor _, decl := range syntax.Decls {\n299|\t\tfunction, ok := decl.(*ast.FuncDecl)\n300|\t\tif ok && function.Name.Name == \"parseMajor\" {\n301|\t\t\tbody = function.Body\n302|\t\t}\n303|\t}\n304|\tif body == nil {\n305|\t\treturn 0\n306|\t}\n307|\tcount := 0\n308|\tvar conditions []string\n309|\tvar walk func(node ast.Node)\n310|\twalk = func(node ast.Node) {\n311|\t\tbranch, ok := node.(*ast.IfStmt)\n312|\t\tif !ok {\n313|\t\t\tfor _, child := range childNodes(node) {\n314|\t\t\t\twalk(child)\n315|\t\t\t}\n316|\t\t\treturn\n317|\t\t}\n318|\t\tconditions = append(conditions, nodeSource(source, fileSet, branch.Cond))\n319|\t\tfor _, stmt := range branch.Body.List {\n320|\t\t\tif ret, ok := stmt.(*ast.ReturnStmt); ok && isFalsePair(ret) {\n321|\t\t\t\tarms[\"parse|\"+conditions[len(conditions)-1]] = struct{}{}\n322|\t\t\t\tcount++\n323|\t\t\t}\n324|\t\t}\n325|\t\tfor _, child := range childNodes(node) {\n326|\t\t\twalk(child)\n327|\t\t}\n328|\t\tconditions = conditions[:len(conditions)-1]\n329|\t}\n330|\twalk(body)\n331|\treturn count\n332|}\n333|\n334|func isFalsePair(ret *ast.ReturnStmt) bool {\n335|\tif len(ret.Results) != 2 {\n336|\t\treturn false\n337|\t}\n338|\tzero, ok := ret.Results[0].(*ast.BasicLit)\n339|\tif !ok || zero.Kind != token.INT || zero.Value != \"0\" {\n340|\t\treturn false\n341|\t}\n342|\tno, ok := ret.Results[1].(*ast.Ident)\n343|\treturn ok && no.Name == \"false\"\n344|}\n345|\n346|func childNodes(node ast.Node) []ast.Node {\n347|\tvar children []ast.Node\n348|\tast.Inspect(node, func(child ast.Node) bool {\n349|\t\tif child == nil || child == node {\n350|\t\t\treturn true\n351|\t\t}\n352|\t\tchildren = append(children, child)\n353|\t\treturn false\n354|\t})\n355|\treturn children\n356|}\n357|\n358|// armWitness proves one derived refusal arm at the production entry.\n359|// The arm key must equal the derived key exactly: TestWitnessedArmsAreAllDerived\n360|// fails a witness that names nothing production declares, so a deleted or\n361|// narrowed production branch orphans its witness instead of passing\n362|// silently. The prove function must drive the production entry point and\n363|// require the refusal attributed to THIS arm, not merely any refusal.\n364|type armWitness struct {\n365|\tarm   string\n366|\tname  string\n367|\tprove func(*testing.T)\n368|}\n369|\n370|// requireIntegrityRefusal asserts the full identity of a status refusal:\n371|// the integrity_failure code, the rule detail, the status_state detail\n372|// every integrity arm carries (AS6: asserted on all 18 arms, not just\n373|// the unknown row), exit 9, and the non-retryable bit. It is separate\n374|// from requireLocalRefusal because that helper also serves codes with no\n375|// status_state detail.\n376|func requireIntegrityRefusal(t *testing.T, err error, detail, wantState string) {\n377|\tt.Helper()\n378|\trequireLocalRefusal(t, err, \"integrity_failure\", detail)\n379|\tstate, ok := failureObject(t, err).Detail(\"status_state\")\n380|\tif !ok || state != wantState {\n381|\t\tt.Fatalf(\"integrity refusal status_state = %v, want %q (%v)\", state, wantState, err)\n382|\t}\n383|\tif failureExit(t, err) != 9 {\n384|\t\tt.Fatalf(\"integrity refusal exit = %d, want 9\", failureExit(t, err))\n385|\t}\n386|}\n387|\n388|func armVersionFrame(version string) []byte {\n389|\treturn []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"` + version + `\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)\n390|}\n391|\n392|func armMemberFrame(members string) []byte {\n393|\treturn []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",` + members + `}`)\n394|}\n395|\n396|func armOversizeResponse(t *testing.T) []byte {\n397|\tt.Helper()\n398|\tbuild := func(pad int) []byte {\n399|\t\treturn successFrame(t, testRequestID, `{\"pad\":\"`+strings.Repeat(\"a\", pad)+`\"}`)\n400|\t}\n401|\tbase := len(build(0))\n402|\tover := build(specFrameLimitBytes - base + 1)\n403|\tif len(over) != specFrameLimitBytes+1 {\n404|\t\tt.Fatalf(\"oversize fixture is %d bytes, want exactly %d\", len(over), specFrameLimitBytes+1)\n405|\t}\n406|\treturn over\n407|}\n408|\n409|func declaredArmWitnesses() []armWitness {\n410|\treturn []armWitness{\n411|\t\t// decodeStrictObject frame arms, through DecodeResponse.\n412|\t\t{arm: `frame|not a JSON object|\"\"`, name: \"array is not an object\", prove: func(t *testing.T) {\n413|\t\t\t_, err := DecodeResponse([]byte(`[1,2]`), mustUUIDv7(t, testRequestID))\n414|\t\t\trequireFrameRefusal(t, err, \"\", \"not a JSON object\")\n415|\t\t}},\n416|\t\t{arm: `frame|not a JSON object|key`, name: \"truncated value names its member\", prove: func(t *testing.T) {\n417|\t\t\t_, err := DecodeResponse([]byte(`{\"protocol\":`), mustUUIDv7(t, testRequestID))\n418|\t\t\trequireFrameRefusal(t, err, \"protocol\", \"not a JSON object\")\n419|\t\t}},\n420|\t\t{arm: `frame|duplicate member|key`, name: \"repeated member\", prove: func(t *testing.T) {\n421|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)\n422|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n423|\t\t\trequireFrameRefusal(t, err, \"request_id\", \"duplicate member\")\n424|\t\t}},\n425|\t\t{arm: `frame|trailing data after the object|\"\"`, name: \"trailing byte\", prove: func(t *testing.T) {\n426|\t\t\t_, err := DecodeResponse(append(successFrame(t, testRequestID, `{\"provider_id\":\"pi\"}`), 'x'), mustUUIDv7(t, testRequestID))\n427|\t\t\trequireFrameRefusal(t, err, \"\", \"trailing data after the object\")\n428|\t\t}},\n429|\t\t{arm: `frame|lone surrogate escape|\"\"`, name: \"lone surrogate in body\", prove: func(t *testing.T) {\n430|\t\t\t_, err := DecodeResponse(successFrame(t, testRequestID, `{\"provider_id\":\"pi\",\"tag\":\"a\\ud800b\"}`), mustUUIDv7(t, testRequestID))\n431|\t\t\trequireFrameRefusal(t, err, \"\", \"lone surrogate escape\")\n432|\t\t}},\n433|\t\t{arm: `frame|not valid UTF-8|\"\"`, name: \"raw bytes in body\", prove: func(t *testing.T) {\n434|\t\t\terr := DecodeManifest([]byte(\"{\\\"note\\\":\\\"ab\\xffcd\\\"}\"))\n435|\t\t\trequireFrameRefusal(t, err, \"\", \"not valid UTF-8\")\n436|\t\t}},\n437|\t\t{arm: `frame|missing member|name`, name: \"missing protocol\", prove: func(t *testing.T) {\n438|\t\t\tframe := []byte(`{\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)\n439|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n440|\t\t\trequireFrameRefusal(t, err, \"protocol\", \"missing member\")\n441|\t\t}},\n442|\t\t{arm: `frame|missing member|\"body\"`, name: \"success without body\", prove: func(t *testing.T) {\n443|\t\t\t_, err := DecodeResponse(armMemberFrame(`\"ok\":true`), mustUUIDv7(t, testRequestID))\n444|\t\t\trequireFrameRefusal(t, err, \"body\", \"missing member\")\n445|\t\t}},\n446|\t\t{arm: `frame|success envelope carries error|\"error\"`, name: \"error on success\", prove: func(t *testing.T) {\n447|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{},\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.0.0\",\"code\":\"capability_unavailable\",\"message\":\"m\",\"exit_code\":6,\"retryable\":false,\"details\":{}}}`)\n448|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n449|\t\t\trequireFrameRefusal(t, err, \"error\", \"success envelope carries error\")\n450|\t\t}},\n451|\t\t{arm: `frame|missing member|\"error\"`, name: \"failure without error\", prove: func(t *testing.T) {\n452|\t\t\t_, err := DecodeResponse(armMemberFrame(`\"ok\":false`), mustUUIDv7(t, testRequestID))\n453|\t\t\trequireFrameRefusal(t, err, \"error\", \"missing member\")\n454|\t\t}},\n455|\t\t{arm: `frame|failure envelope carries body|\"body\"`, name: \"body on failure\", prove: func(t *testing.T) {\n456|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":false,\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.0.0\",\"code\":\"capability_unavailable\",\"message\":\"m\",\"exit_code\":6,\"retryable\":false,\"details\":{}},\"body\":{}}`)\n457|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n458|\t\t\trequireFrameRefusal(t, err, \"body\", \"failure envelope carries body\")\n459|\t\t}},\n460|\t\t{arm: `frame|unknown member|name`, name: \"diagnostics member\", prove: func(t *testing.T) {\n461|\t\t\t_, err := DecodeResponse(armMemberFrame(`\"ok\":true,\"body\":{},\"diagnostics\":[]`), mustUUIDv7(t, testRequestID))\n462|\t\t\trequireFrameRefusal(t, err, \"diagnostics\", \"unknown member\")\n463|\t\t}},\n464|\t\t// encodeFrame refusals, through EncodeRequest.\n465|\t\t{arm: `ctor|failInvalid|unknown operation`, name: \"unknown operation never frames\", prove: func(t *testing.T) {\n466|\t\t\treq := testRequest(t)\n467|\t\t\treq.Operation = \"reboot\"\n468|\t\t\t_, err := EncodeRequest(req, mustInstant(t, testNow))\n469|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"unknown operation\")\n470|\t\t}},\n471|\t\t{arm: `ctor|failInvalid|request_id is not a UUIDv7`, name: \"zero request id\", prove: func(t *testing.T) {\n472|\t\t\tbad := testRequest(t)\n473|\t\t\tvar zero scalar.UUIDv7\n474|\t\t\tbad.RequestID = zero\n475|\t\t\t_, err := EncodeRequest(bad, mustInstant(t, testNow))\n476|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"request_id is not a UUIDv7\")\n477|\t\t}},\n478|\t\t{arm: `ctor|failInvalid|deadline is not a timestamp`, name: \"zero deadline\", prove: func(t *testing.T) {\n479|\t\t\treq := testRequest(t)\n480|\t\t\treq.Deadline = mustTimestamp(t, testDeadline)\n481|\t\t\tvar zero scalar.Timestamp\n482|\t\t\treq.Deadline = zero\n483|\t\t\t_, err := EncodeRequest(req, mustInstant(t, testNow))\n484|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"deadline is not a timestamp\")\n485|\t\t}},\n486|\t\t{arm: `ctor|failInvalid|deadline is not in the future`, name: \"stale deadline\", prove: func(t *testing.T) {\n487|\t\t\treq := testRequest(t)\n488|\t\t\treq.Deadline = mustTimestamp(t, testNow)\n489|\t\t\t_, err := EncodeRequest(req, mustInstant(t, testNow))\n490|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"deadline is not in the future\")\n491|\t\t}},\n492|\t\t{arm: `ctor|failInvalid|body is not a JSON object`, name: \"array body\", prove: func(t *testing.T) {\n493|\t\t\treq := testRequest(t)\n494|\t\t\treq.Body = json.RawMessage(`[1,2]`)\n495|\t\t\t_, err := EncodeRequest(req, mustInstant(t, testNow))\n496|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"body is not a JSON object\")\n497|\t\t}},\n498|\t\t{arm: `ctor|failInvalid|request frame exceeds 8 MiB`, name: \"oversize request\", prove: func(t *testing.T) {\n499|\t\t\treq := testRequest(t)\n500|\t\t\treq.Body = json.RawMessage(`{\"pad\":\"` + strings.Repeat(\"a\", specFrameLimitBytes) + `\"}`)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c66f","stream":{"kind":"session","id":"01a079e0-55db-79f2-85b0-c8c2e4c1a43f"},"sequence":402,"recorded_at":1780531400000799,"record_type":"event","durability":"durable","causation_id":"38173c32-e836-4324-8339-ee117e4249f1","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38173c32-e836-4324-8339-ee117e4249f1","run_stream":{"kind":"run","id":"38173c32-e836-4324-8339-ee117e4249f1"},"call_id":"call_01a079e1b0877be3a105af1ec025edf6","text":"Read text file `internal/provider/refusal_inventory_test.go`.\n1|package provider\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"flag\"\n6|\t\"fmt\"\n7|\t\"go/ast\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"sort\"\n11|\t\"strings\"\n12|\t\"testing\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/invcore\"\n15|)\n16|\n17|// refusalRecorder is the shared core's runtime direction: the production\n18|// file:line behind every instrumented refusal constructor call made\n19|// during the test run, plus the stable codes those refusals carried.\n20|// Constructor vars are swapped in TestMain, so an aliased constructor\n21|// still executes the swapped var and records its real production site:\n22|// the runtime direction of the alias-bypass union.\n23|var refusalRecorder = invcore.NewSiteRecorder()\n24|\n25|func recordRefusalSite(code string) {\n26|\trefusalRecorder.Record(code, 2)\n27|}\n28|\n29|func TestMain(main *testing.M) {\n30|\torigDuplicate, origInvalid, origPrecondition, origIntegrity := failDuplicate, failInvalid, failPrecondition, failIntegrity\n31|\tfailDuplicate = func(providerID, firstSource, secondSource string) Error {\n32|\t\terr := origDuplicate(providerID, firstSource, secondSource)\n33|\t\trecordRefusalSite(err.Code())\n34|\t\treturn err\n35|\t}\n36|\tfailInvalid = func(detail string) Error {\n37|\t\terr := origInvalid(detail)\n38|\t\trecordRefusalSite(err.Code())\n39|\t\treturn err\n40|\t}\n41|\tfailPrecondition = func(detail string, cause error) Error {\n42|\t\terr := origPrecondition(detail, cause)\n43|\t\trecordRefusalSite(err.Code())\n44|\t\treturn err\n45|\t}\n46|\tfailIntegrity = func(detail string, cause error) Error {\n47|\t\terr := origIntegrity(detail, cause)\n48|\t\trecordRefusalSite(err.Code())\n49|\t\treturn err\n50|\t}\n51|\tcode := main.Run()\n52|\tif code == 0 && fullPackageTestRun() {\n53|\t\tif failures := auditRefusalInventory(); len(failures) != 0 {\n54|\t\t\tfor _, failure := range failures {\n55|\t\t\t\tfmt.Fprintln(os.Stderr, failure)\n56|\t\t\t}\n57|\t\t\tcode = 1\n58|\t\t}\n59|\t}\n60|\tos.Exit(code)\n61|}\n62|\n63|func fullPackageTestRun() bool {\n64|\tselected := flag.Lookup(\"test.run\")\n65|\treturn selected == nil || selected.Value.String() == \"\"\n66|}\n67|\n68|// auditRefusalInventory derives the refusal inventory from package source,\n69|// never from memory: every production call to a refusal constructor must\n70|// have an exercised negative path, no Error value may be built outside the\n71|// four constructors, and the observed code set must equal the closed code\n72|// set exactly.\n73|func auditRefusalInventory() []string {\n74|\tdirectory, err := os.Getwd()\n75|\tif err != nil {\n76|\t\treturn []string{fmt.Sprintf(\"derive provider refusal inventory: %v\", err)}\n77|\t}\n78|\tinventory, err := deriveRefusalInventory(directory)\n79|\tif err != nil {\n80|\t\treturn []string{fmt.Sprintf(\"derive provider refusal inventory: %v\", err)}\n81|\t}\n82|\tvar failures []string\n83|\t// Floor: a derived domain that can silently derive nothing is not a\n84|\t// measurement. An empty or short derivation must fail closed, never\n85|\t// pass vacuously — the same \"the scan is blind\" floor the package's\n86|\t// other derived scans carry.\n87|\tif len(inventory.ScannedFiles) == 0 {\n88|\t\tfailures = append(failures, \"scanned no production sources; the check is blind\")\n89|\t}\n90|\tif len(inventory.Sites) == 0 {\n91|\t\tfailures = append(failures, \"derived no refusal sites; the scan is blind\")\n92|\t}\n93|\t// Reverse direction: every exercised refusal site must resolve to a\n94|\t// derived site. The exercised set is derived from the test run, not\n95|\t// hand-listed, so a truncated derivation (1 of N sites, provider.go\n96|\t// skipped, or an empty-but-successful read of the wrong directory)\n97|\t// reddens here even though the forward check passes vacuously.\n98|\tderived := map[string]struct{}{}\n99|\tfor _, site := range inventory.Sites {\n100|\t\tderived[site] = struct{}{}\n101|\t}\n102|\t// Both directions run through the shared harness: derived sites\n103|\t// without an exercised path (forward) and exercised sites outside\n104|\t// the derivation (reverse) fail together.\n105|\tmissing, outside, scanFailures := invcore.DiffSets(derived, refusalRecorder.Sites())\n106|\tfailures = append(failures, scanFailures...)\n107|\tif len(outside) != 0 {\n108|\t\tfailures = append(failures, \"exercised refusal sites outside the derived inventory; the derivation is short: \"+strings.Join(outside, \", \"))\n109|\t}\n110|\tif len(inventory.StrayLiterals) != 0 {\n111|\t\tsort.Strings(inventory.StrayLiterals)\n112|\t\tfailures = append(failures, \"provider refusals built outside an instrumented constructor: \"+strings.Join(inventory.StrayLiterals, \", \"))\n113|\t}\n114|\tif len(inventory.RawConstructors) != 0 {\n115|\t\tsort.Strings(inventory.RawConstructors)\n116|\t\tfailures = append(failures, \"provider raw error construction outside documented cause sites: \"+strings.Join(inventory.RawConstructors, \", \"))\n117|\t}\n118|\tif len(missing) != 0 {\n119|\t\tfailures = append(failures, \"provider refusal call sites without an exercised negative path: \"+strings.Join(missing, \", \"))\n120|\t}\n121|\tcodes := refusalRecorder.Codes()\n122|\twant := []string{codeIntegrityFailure, codeInvalidConfig, codeLocalPrecondition}\n123|\tif fmt.Sprintf(\"%v\", codes) != fmt.Sprintf(\"%v\", want) {\n124|\t\tfailures = append(failures, fmt.Sprintf(\"observed refusal codes = %v, want closed set %v\", codes, want))\n125|\t}\n126|\treturn failures\n127|}\n128|\n129|// refusalInventory is derived from package sources.\n130|type refusalInventory struct {\n131|\t// ScannedFiles are the production source basenames the derivation\n132|\t// parsed. The audit fails closed when this is empty: a successful\n133|\t// read of the wrong directory must not pass as a clean inventory.\n134|\tScannedFiles []string\n135|\t// Sites are file:line positions of production refusal constructor calls.\n136|\tSites []string\n137|\t// StrayLiterals are Error composite literals outside the constructors.\n138|\tStrayLiterals []string\n139|\t// RawConstructors are errors.New, fmt.Errorf, or panic calls outside\n140|\t// the documented owner-attestation cause sites.\n141|\tRawConstructors []string\n142|}\n143|\n144|var refusalConstructors = map[string]bool{\n145|\t\"failDuplicate\":    true,\n146|\t\"failInvalid\":      true,\n147|\t\"failPrecondition\": true,\n148|\t\"failIntegrity\":    true,\n149|}\n150|\n151|// causeSiteFiles are the only production files allowed to mint raw cause\n152|// errors: the platform owner-attestation seams whose failures production\n153|// code always wraps in a refusal constructor.\n154|var causeSiteFiles = map[string]bool{\n155|\t\"os_unix.go\":    true,\n156|\t\"os_windows.go\": true,\n157|}\n158|\n159|func deriveRefusalInventory(directory string) (refusalInventory, error) {\n160|\tscannedFiles, fileSet, failures := invcore.ScanProduction(directory)\n161|\tif len(failures) != 0 {\n162|\t\treturn refusalInventory{}, errors.New(strings.Join(failures, \"; \"))\n163|\t}\n164|\tvar inventory refusalInventory\n165|\tfor _, production := range scannedFiles {\n166|\t\tname, syntax := production.Name, production.Syntax\n167|\t\tinventory.ScannedFiles = append(inventory.ScannedFiles, name)\n168|\t\t// Map each constructor's own body span so literals inside it are\n169|\t\t// not mistaken for strays.\n170|\t\tconstructorBodies := map[*ast.FuncLit]bool{}\n171|\t\tfor _, decl := range syntax.Decls {\n172|\t\t\tgeneral, ok := decl.(*ast.GenDecl)\n173|\t\t\tif !ok {\n174|\t\t\t\tcontinue\n175|\t\t\t}\n176|\t\t\tfor _, spec := range general.Specs {\n177|\t\t\t\tvalues, ok := spec.(*ast.ValueSpec)\n178|\t\t\t\tif !ok {\n179|\t\t\t\t\tcontinue\n180|\t\t\t\t}\n181|\t\t\t\tfor i, ident := range values.Names {\n182|\t\t\t\t\tif !refusalConstructors[ident.Name] || i >= len(values.Values) {\n183|\t\t\t\t\t\tcontinue\n184|\t\t\t\t\t}\n185|\t\t\t\t\tif literal, ok := values.Values[i].(*ast.FuncLit); ok {\n186|\t\t\t\t\t\tconstructorBodies[literal] = true\n187|\t\t\t\t\t}\n188|\t\t\t\t}\n189|\t\t\t}\n190|\t\t}\n191|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n192|\t\t\tcall, ok := node.(*ast.CallExpr)\n193|\t\t\tif !ok {\n194|\t\t\t\treturn true\n195|\t\t\t}\n196|\t\t\tposition := fileSet.Position(call.Pos())\n197|\t\t\tsite := fmt.Sprintf(\"%s:%d\", filepath.Base(position.Filename), position.Line)\n198|\t\t\tif ident, ok := call.Fun.(*ast.Ident); ok {\n199|\t\t\t\tif refusalConstructors[ident.Name] {\n200|\t\t\t\t\tinventory.Sites = append(inventory.Sites, site)\n201|\t\t\t\t\treturn true\n202|\t\t\t\t}\n203|\t\t\t\tif ident.Name == \"panic\" {\n204|\t\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" panic\")\n205|\t\t\t\t\treturn true\n206|\t\t\t\t}\n207|\t\t\t}\n208|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n209|\t\t\tif !ok {\n210|\t\t\t\treturn true\n211|\t\t\t}\n212|\t\t\tif qualifier, ok := selector.X.(*ast.Ident); ok {\n213|\t\t\t\tqualified := qualifier.Name + \".\" + selector.Sel.Name\n214|\t\t\t\tif qualified == \"errors.New\" || qualified == \"fmt.Errorf\" {\n215|\t\t\t\t\tif !causeSiteFiles[name] {\n216|\t\t\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" \"+qualified)\n217|\t\t\t\t\t}\n218|\t\t\t\t\treturn true\n219|\t\t\t\t}\n220|\t\t\t}\n221|\t\t\tif selector.Sel.Name == \"panic\" {\n222|\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" panic\")\n223|\t\t\t}\n224|\t\t\treturn true\n225|\t\t})\n226|\t\t// Stray Error literals: composite literals of type Error outside\n227|\t\t// a constructor body. Bodies are matched by source span.\n228|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n229|\t\t\tliteral, ok := node.(*ast.CompositeLit)\n230|\t\t\tif !ok {\n231|\t\t\t\treturn true\n232|\t\t\t}\n233|\t\t\tident, ok := literal.Type.(*ast.Ident)\n234|\t\t\tif !ok || ident.Name != \"Error\" {\n235|\t\t\t\treturn true\n236|\t\t\t}\n237|\t\t\tfor body := range constructorBodies {\n238|\t\t\t\tif literal.Pos() >= body.Pos() && literal.End() <= body.End() {\n239|\t\t\t\t\treturn true\n240|\t\t\t\t}\n241|\t\t\t}\n242|\t\t\tposition := fileSet.Position(literal.Pos())\n243|\t\t\tinventory.StrayLiterals = append(inventory.StrayLiterals, fmt.Sprintf(\"%s:%d\", filepath.Base(position.Filename), position.Line))\n244|\t\t\treturn true\n245|\t\t})\n246|\t}\n247|\treturn inventory, nil\n248|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
