{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c759","stream":{"kind":"session","id":"01a079e0-55db-79f2-85b0-c8c2e4c1a43f"},"sequence":519,"recorded_at":1780531400001033,"record_type":"event","durability":"durable","causation_id":"38173c32-e836-4324-8339-ee117e4249f1","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38173c32-e836-4324-8339-ee117e4249f1","run_stream":{"kind":"run","id":"38173c32-e836-4324-8339-ee117e4249f1"},"call_id":"call_01a079e311747d41916a9ffd19786692","text":"Read text file `internal/terminalbackend/refusal_arm_inventory_test.go`.\n(1299 line(s) above)\n1300|\t\t\t\treturn true\n1301|\t\t\t}\n1302|\t\t\tdetail, err := strconv.Unquote(literal.Value)\n1303|\t\t\tif err != nil {\n1304|\t\t\t\tt.Fatalf(\"unquote platform error: %v\", err)\n1305|\t\t\t}\n1306|\t\t\tdetails[detail] = true\n1307|\t\t\treturn true\n1308|\t\t})\n1309|\t}\n1310|\tif len(details) == 0 {\n1311|\t\tt.Fatal(\"derived zero platform errors; the scanner is broken, not the package\")\n1312|\t}\n1313|\tfor _, want := range funneledPlatformDetails {\n1314|\t\tif !details[want] {\n1315|\t\t\tt.Errorf(\"funneled detail %q no longer derives from validatePlatforms\", want)\n1316|\t\t}\n1317|\t}\n1318|\tfor detail := range details {\n1319|\t\tknown := false\n1320|\t\tfor _, want := range funneledPlatformDetails {\n1321|\t\t\tif detail == want {\n1322|\t\t\t\tknown = true\n1323|\t\t\t}\n1324|\t\t}\n1325|\t\tif !known {\n1326|\t\t\tt.Errorf(\"validatePlatforms derives %q, outside the funneled set; \"+\n1327|\t\t\t\t\"a fourth platform error widens the funnel\", detail)\n1328|\t\t}\n1329|\t}\n1330|}\n1331|\n1332|// TestPlainErrorsLiveOnlyInTheirTwoFunctions closes the smuggling hole:\n1333|// a non-wire error constructed anywhere but validatePlatforms (the\n1334|// pinned funnel) or DigestFile (I/O) fails, so a refusal wearing a plain\n1335|// error's clothes cannot ship unwitnessed.\n1336|//\n1337|// Coverage is declaration-complete like deriveRefusalArms above: every\n1338|// FuncDecl body (receiver-qualified for methods) plus every package-level\n1339|// var initializer is scanned, so a plain error hiding in a package-level\n1340|// `var errPlanted = errors.New(…)` or a `var f = func() error {…}`\n1341|// literal is caught like any other. An unused package-level plain error\n1342|// still fails: its initializer runs at package init, so the construction\n1343|// is real whether or not any caller returns it. An alias\n1344|// (`newPlain := errors.New`) is rejected outright by\n1345|// rejectPlainErrorAliases below: the allowlist scan matches only direct\n1346|// selector calls, so an aliased construction would ship unattributed.\n1347|// Custom error types outside the two recognised spellings are a stated\n1348|// bound above, not covered here.\n1349|func TestPlainErrorsLiveOnlyInTheirTwoFunctions(t *testing.T) {\n1350|\tt.Parallel()\n1351|\n1352|\t// The alias direction is the core's over the same spec, so an\n1353|\t// import-aliased (`errs \"errors\"`) or var-bound construction fails\n1354|\t// there; the allowlist below attributes every watched direct call —\n1355|\t// import aliases resolved — to its enclosing function.\n1356|\tspec := plainErrorSpec()\n1357|\tfiles, fileSet := invcore.MustScanProduction(t, \".\")\n1358|\tfor _, production := range files {\n1359|\t\tfile, name := production.Syntax, production.Name\n1360|\t\tinvcore.MustAuditConstructorReferences(t, file, fileSet, name, spec)\n1361|\t\twatched := invcore.WatchedCallPositions(file, spec)\n1362|\t\tcheck := func(functionName string, root ast.Node) {\n1363|\t\t\tast.Inspect(root, func(node ast.Node) bool {\n1364|\t\t\t\tcall, ok := node.(*ast.CallExpr)\n1365|\t\t\t\tif !ok {\n1366|\t\t\t\t\treturn true\n1367|\t\t\t\t}\n1368|\t\t\t\tposition, ok := invcore.FunPosition(call)\n1369|\t\t\t\tif !ok || !watched[position] {\n1370|\t\t\t\t\treturn true\n1371|\t\t\t\t}\n1372|\t\t\t\tif !plainErrorFunctions[functionName] {\n1373|\t\t\t\t\tt.Errorf(\"%s constructs a non-wire error in %s, outside the two allowlisted functions; \"+\n1374|\t\t\t\t\t\t\"a refusal wearing a plain error's clothes ships unwitnessed\", name, functionName)\n1375|\t\t\t\t}\n1376|\t\t\t\treturn true\n1377|\t\t\t})\n1378|\t\t}\n1379|\t\tfor _, declaration := range file.Decls {\n1380|\t\t\tswitch decl := declaration.(type) {\n1381|\t\t\tcase *ast.FuncDecl:\n1382|\t\t\t\tif decl.Body == nil {\n1383|\t\t\t\t\tcontinue\n1384|\t\t\t\t}\n1385|\t\t\t\tfunctionName := decl.Name.Name\n1386|\t\t\t\tif decl.Recv != nil && len(decl.Recv.List) > 0 {\n1387|\t\t\t\t\tfunctionName = receiverTypeName(decl.Recv.List[0].Type) + \".\" + functionName\n1388|\t\t\t\t}\n1389|\t\t\t\tcheck(functionName, decl.Body)\n1390|\t\t\tcase *ast.GenDecl:\n1391|\t\t\t\t// Package-level initializers execute outside any FuncDecl,\n1392|\t\t\t\t// so a plain error assigned to a package var would\n1393|\t\t\t\t// otherwise ship invisible. Attribute its constructions\n1394|\t\t\t\t// to the declared variable name.\n1395|\t\t\t\tfor _, spec := range decl.Specs {\n1396|\t\t\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n1397|\t\t\t\t\tif !ok {\n1398|\t\t\t\t\t\tcontinue\n1399|\t\t\t\t\t}\n1400|\t\t\t\t\tfunctionName := \"var\"\n1401|\t\t\t\t\tif len(value.Names) > 0 {\n1402|\t\t\t\t\t\tfunctionName = value.Names[0].Name\n1403|\t\t\t\t\t}\n1404|\t\t\t\t\tfor _, item := range value.Values {\n1405|\t\t\t\t\t\tcheck(functionName, item)\n1406|\t\t\t\t\t}\n1407|\t\t\t\t}\n1408|\t\t\t}\n1409|\t\t}\n1410|\t}\n1411|}\n1412|\n1413|// plainErrorSpec watches the two recognised plain-error spellings by\n1414|// import path: errors.New and fmt.Errorf (any Errorf-prefixed\n1415|// constructor). Custom error types outside these spellings are a stated\n1416|// bound above, not covered here.\n1417|func plainErrorSpec() invcore.ConstructorSpec {\n1418|\treturn invcore.ConstructorSpec{\n1419|\t\tQualified: map[string]map[string]bool{\n1420|\t\t\t\"errors\": {\"New\": true},\n1421|\t\t\t\"fmt\":    {\"Errorf*\": true},\n1422|\t\t},\n1423|\t}\n1424|}\n1425|\n1426|// TestDigestFileRefusalsAreNeverWireErrors pins the allowlist's other\n1427|// half behaviorally: DigestFile failures are I/O errors, never *Error,\n1428|// so no caller can mistake them for a registry refusal.\n1429|func TestDigestFileRefusalsAreNeverWireErrors(t *testing.T) {\n1430|\tt.Parallel()\n1431|\n1432|\tfor _, path := range []string{\n1433|\t\tfilepath.Join(\"testdata\", \"no-such-executable\"),\n1434|\t\t\"\",\n1435|\t} {\n1436|\t\t_, err := DigestFile(path)\n1437|\t\tif err == nil {\n1438|\t\t\tt.Errorf(\"DigestFile(%q) = nil, want an I/O error\", path)\n1439|\t\t\tcontinue\n1440|\t\t}\n1441|\t\tvar refusal *Error\n1442|\t\tif errors.As(err, &refusal) {\n1443|\t\t\tt.Errorf(\"DigestFile(%q) error = %v, want a plain I/O error, never a wire refusal\", path, err)\n1444|\t\t}\n1445|\t}\n1446|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
