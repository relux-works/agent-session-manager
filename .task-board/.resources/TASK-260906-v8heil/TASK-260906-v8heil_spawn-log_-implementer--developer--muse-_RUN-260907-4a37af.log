otocolError\", \"lifecycle state vocabulary\", 1),\n489|\t\t\tentry: \"ParseInstanceState\",\n490|\t\t\tprove: func(t *testing.T) {\n491|\t\t\t\t_, err := terminalbackend.ParseInstanceState(\"running\")\n492|\t\t\t\trequireConformanceRefusal(t, err, \"terminal_backend_protocol_error\", \"lifecycle state vocabulary\")\n493|\t\t\t},\n494|\t\t},\n495|\t\t{\n496|\t\t\tkey:   wkey(\"conformance.go\", \"ParseOperation\", \"CodeProtocolError\", \"operation vocabulary\", 1),\n497|\t\t\tentry: \"ParseOperation\",\n498|\t\t\tprove: func(t *testing.T) {\n499|\t\t\t\t_, err := terminalbackend.ParseOperation(\"launch\")\n500|\t\t\t\trequireConformanceRefusal(t, err, \"terminal_backend_protocol_error\", \"operation vocabulary\")\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c585","stream":{"kind":"session","id":"01a079e0-55db-79f2-85b0-c8c2e4c1a43f"},"sequence":285,"recorded_at":1780531400000565,"record_type":"event","durability":"durable","causation_id":"38173c32-e836-4324-8339-ee117e4249f1","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38173c32-e836-4324-8339-ee117e4249f1","run_stream":{"kind":"run","id":"38173c32-e836-4324-8339-ee117e4249f1"},"call_id":"call_01a079e0ec5c7590a0a19c39c6024b64","text":"Read text file `internal/terminalbackend/digit_guard_census_test.go`.\n1|// Derived digit-guard census over the provider-protocol leaf.\n2|//\n3|// The failure this file exists to prevent: a digit-parsing gate added,\n4|// narrowed, or widened anywhere in this leaf while the suite stays\n5|// green. It happened four rounds in a row — a saturation guard\n6|// witnessed far from its own edge, an exponent bound witnessed 44\n7|// bytes above its true edge, an uncensused semverMajor, and finally a\n8|// pre-multiply guard (`value > 100` in descriptorGeometry) whose\n9|// narrowing to its own arithmetic edge (`value > 922337203685477580`)\n10|// admitted a 37-digit literal as 1 while every shipped vector still\n11|// refused. Each round closed one site with one hand-written row while\n12|// the census listed its own sites, so the next site was invisible by\n13|// construction.\n14|//\n15|// This census derives its denominator from production instead of\n16|// listing it: it parses every production file of internal/\n17|// terminalbackend and internal/provhost (directory-derived, so a new\n18|// file is scanned without anyone remembering it) and enumerates both\n19|// digit-guard shapes in one pass:\n20|//\n21|//   - char: an ordering comparison against a decimal digit rune\n22|//     (`c < '0' || c > '9'` and its spellings, refuse-form or\n23|//     accept-form, including the digit case of a hex decoder);\n24|//   - bound: an ordering comparison against a decimal accumulator —\n25|//     an identifier the same function accumulates through `* 10`\n26|//     (`value > N` / `major > N`, before or after the multiply).\n27|//\n28|// Every derived site carries exactly one declared row: a char row\n29|// names its reachable rejected class, a bound row names its\n30|// arithmetic-edge threshold and its witness. The census fails closed\n31|// in three directions: a derived site with no row, a row with no\n32|// derived site, and a site the classifier cannot place (an equality\n33|// against a digit rune, a chain mixing digit and accumulator\n34|// comparisons, a chain mixing either with unrelated comparisons, or\n35|// a comparison with accumulators on both sides). A zero-file scan, a\n36|// zero-site derivation, an unparseable file, a row with an empty\n37|// claim, and a row naming a test that does not exist are fatal too.\n38|//\n39|// The derivation keys on structure, never on identifier names: rune\n40|// literals and `* 10` accumulations survive renaming, var bindings,\n41|// and import aliases. Control plants prove it (see the battery\n42|// record): a fourth digit gate through a var binding and one through\n43|// an import-aliased file both fail as unregistered sites.\n44|//\n45|// Stated bounds (not inferred):\n46|//   - Non-digit rune guards (`== '.'`, `!= '\\\\'`, `!= 'u'`, the\n47|//     `0xed`/`0xa0` byte ranges) are a different class and invisible\n48|//     to this enumerator. A digit-rune novelty (`== '0'`, `!= '9'`)\n49|//     is derived and fails as unclassifiable.\n50|//   - Digit spellings outside the classifier, completed per review\n51|//     N-R1 (three semantically identical spellings measured green at\n52|//     9/9 with no such site in either package, reviewer-grepped):\n53|//     1. integer code points (`c < 0x30`, `c > 57`) are ENUMERATED:\n54|//     digitGuardDigitRune admits token.INT 48..57 in every base,\n55|//     pinned by TestDigitGuardDigitRuneAdmitsCodePointSpellings;\n56|//     2. named rune constants (`const zero = '0'; c < zero`) are\n57|//     OUTSIDE: an identifier is not a literal, so the comparison\n58|//     classifies as other and the chain prunes. No such site\n59|//     exists in either package today;\n60|//     3. strconv-delegated admission (`strconv.Atoi` + error branch)\n61|//     is OUTSIDE: it is not a comparison at all, so there is no\n62|//     chain to classify. No such site exists in either package\n63|//     today. A new site in either spelling must widen the\n64|//     classifier (named constants) or the census shape\n65|//     (delegation) instead of passing silently; the census still\n66|//     fails closed on every comparison it CAN see.\n67|//   - The hex letter cases (`>= 'a'`, `<= 'F'`) carry no digit rune\n68|//     and are invisible; only the digit case of each hex decoder is\n69|//     rowed. The decoder's exactness across all three cases rests\n70|//     with the canonical-JSON agreement sweeps the hex rows name.\n71|//   - An accumulator with no guard has no bound to row: a missing\n72|//     guard is caught by the overflow-vector tests, not here.\n73|//   - Shadowing an accumulator name inside its own function would\n74|//     misattribute the comparison; no such shadowing exists today.\n75|package terminalbackend_test\n76|\n77|import (\n78|\t\"bytes\"\n79|\t\"github.com/relux-works/agent-session-manager/internal/invcore\"\n80|\t\"go/ast\"\n81|\t\"go/printer\"\n82|\t\"go/token\"\n83|\t\"os\"\n84|\t\"path/filepath\"\n85|\t\"sort\"\n86|\t\"strconv\"\n87|\t\"strings\"\n88|\t\"testing\"\n89|\n90|\tterminalbackend \"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n91|)\n92|\n93|// digitGuardSite is one derived production guard: a maximal ||/&&\n94|// chain of comparisons (or one lone comparison) mentioning a digit\n95|// rune or a decimal accumulator, keyed by package directory, file,\n96|// enclosing function, shape, and printer-normalized expression. Two\n97|// identical guards in one function share a key and fail the census\n98|// until they are disambiguated: hiding behind a sibling row is a\n99|// silent admit.\n100|type digitGuardSite struct {\n101|\tdir      string\n102|\tfunction string\n103|\tfile     string\n104|\tkind     string\n105|\texpr     string\n106|}\n107|\n108|// digitGuardRow is the declared counterpart of one site. A char row\n109|// states the reachable rejected class; a bound row states the\n110|// arithmetic-edge threshold and the witness literal that pins it.\n111|// Tests names the driving tests, which must exist.\n112|type digitGuardRow struct {\n113|\tdir       string\n114|\tfile      string\n115|\tfunction  string\n116|\tkind      string\n117|\texpr      string\n118|\trejected  string\n119|\tthreshold string\n120|\twitness   string\n121|\ttests     []string\n122|}\n123|\n124|// digitGuardRows declares every digit guard in the leaf. The expr\n125|// column is the printer-normalized chain text the derivation\n126|// computes; it is exact on purpose, so editing a bound orphans its\n127|// row instead of passing silently.\n128|var digitGuardRows = []digitGuardRow{\n129|\t{\n130|\t\tdir: \"terminalbackend\", file: \"descriptor.go\", function: \"descriptorGeometry\",\n131|\t\tkind: \"char\", expr: `digit < '0' || digit > '9'`,\n132|\t\trejected: \"reachable {-, +, ., e, E}: json.Number literals spell only [0-9.+eE-], so / (0x2F) and : (0x3A) die in the strict decoder before the gate runs (pinned by TestDigitCensusAdjacentsNeverReachGeometryGate); + is equivalent by reachability, legal only after e/E which refuse first\",\n133|\t\ttests:    []string{\"TestParseProviderDescriptorValueRefusals\", \"TestDigitCensusAdjacentsNeverReachGeometryGate\"},\n134|\t},\n135|\t{\n136|\t\tdir: \"terminalbackend\", file: \"manifest.go\", function: \"readUTF16EscapeUnit\",\n137|\t\tkind: \"char\", expr: `digit >= '0' && digit <= '9'`,\n138|\t\trejected: \"the digit case of the three-case hex decoder: bytes outside 0-9a-fA-F reach the refuse arm (return false, refused as a document syntax/surrogate escape); the case admits exactly 0-9\",\n139|\t\ttests:    []string{\"TestDocumentSurrogateEscapeRefused\", \"TestSurrogateGateAgreesWithCanonicalJSON\", \"TestDocumentHexEscapeDigitBoundaryRefused\"},\n140|\t},\n141|\t{\n142|\t\tdir: \"provhost\", file: \"protocol.go\", function: \"parseMajor\",\n143|\t\tkind: \"char\", expr: `digit < '0' || digit > '9'`,\n144|\t\trejected: \"every non-digit byte in the major component (JSON string domain, so any byte is reachable): adjacents / and : witnessed in major position\",\n145|\t\ttests:    []string{\"TestParseMajorDigitBoundariesRefuseAtEntry\"},\n146|\t},\n147|\t{\n148|\t\tdir: \"provhost\", file: \"protocol.go\", function: \"parseMajor\",\n149|\t\tkind: \"char\", expr: `rest[i] < '0' || rest[i] > '9'`,\n150|\t\trejected: \"every non-digit byte in each rest component: adjacents / and : witnessed in both minor and patch positions\",\n151|\t\ttests:    []string{\"TestParseMajorDigitBoundariesRefuseAtEntry\"},\n152|\t},\n153|\t{\n154|\t\tdir: \"provhost\", file: \"surrogate.go\", function: \"readHexUnit\",\n155|\t\tkind: \"char\", expr: `b >= '0' && b <= '9'`,\n156|\t\trejected: \"the digit branch of the hex if-chain: bytes outside 0-9a-fA-F reach the refuse arm (return false, refused as a lone surrogate escape); the branch admits exactly 0-9\",\n157|\t\ttests:    []string{\"TestProductionEntriesRefuseLoneSurrogateEscapes\", \"TestSurrogateGateDerivedSweepAgreesWithCanonicalJSON\", \"TestProductionEntriesRefuseHexDigitBoundaryEscapes\"},\n158|\t},\n159|\t{\n160|\t\tdir: \"terminalbackend\", file: \"descriptor.go\", function: \"descriptorGeometry\",\n161|\t\tkind: \"bound\", expr: `value > 100`,\n162|\t\tthreshold: \"100: refuse on the first digit past the bound, before the multiply; value is at most 100 here so value*10+9 cannot wrap on any platform\",\n163|\t\twitness:   \"9223372036854775808000000000000000001 (37 digits): admitted as 1 when the guard narrows to floor(MaxInt/10) = 922337203685477580, refused by every threshold at or below 92233720368547758\",\n164|\t\ttests:     []string{\"TestParseProviderDescriptorGeometryOverflowVectors\"},\n165|\t},\n166|\t{\n167|\t\tdir: \"terminalbackend\", file: \"descriptor.go\", function: \"descriptorGeometry\",\n168|\t\tkind: \"bound\", expr: `value < 1 || value > 1000`,\n169|\t\tthreshold: \"lower 1 / upper 1000: the post-accumulation range deciding the 1..1000 bound after the loop\",\n170|\t\twitness:   \"boundary pair 0/1 and 1000/1001, plus 65535\",\n171|\t\ttests:     []string{\"TestParseProviderDescriptorValueRefusals\", \"TestParseProviderDescriptorGeometryBounds\"},\n172|\t},\n173|\t{\n174|\t\tdir: \"terminalbackend\", file: \"terminalbackend.go\", function: \"semverMajor\",\n175|\t\tkind: \"bound\", expr: `major > (math.MaxInt-digit)/10`,\n176|\t\tthreshold: \"floor((MaxInt-digit)/10): saturate to MaxInt, never wrap; largest admitted 9223372036854775807, MaxInt+1 saturates\",\n177|\t\twitness:   \"922337203685477580801.0.0 with neighbours 800/802: walks the accumulator to MaxInt/10 and aliases native major 1 when the guard narrows to MaxInt/10\",\n178|\t\ttests:     []string{\"TestSemverMajorSaturationEdge\"},\n179|\t},\n180|\t{\n181|\t\tdir: \"provhost\", file: \"protocol.go\", function: \"parseMajor\",\n182|\t\tkind: \"bound\", expr: `major > (math.MaxInt-step)/10`,\n183|\t\tthreshold: \"floor((MaxInt-step)/10): saturate to MaxInt, never wrap; largest admitted 9223372036854775807, MaxInt+1 saturates\",\n184|\t\twitness:   \"922337203685477580802.0.0 with neighbours 801/803: walks the accumulator to MaxInt/10 and aliases native major 2 when the guard narrows to MaxInt/10\",\n185|\t\ttests:     []string{\"TestParseMajorSaturationEdge\", \"TestParseMajorNeverWraps\"},\n186|\t},\n187|}\n188|\n189|// digitGuardKey identifies one site or row in both directions.\n190|func digitGuardKey(dir, file, function, kind, expr string) string {\n191|\treturn dir + \"|\" + file + \"|\" + function + \"|\" + kind + \"|\" + expr\n192|}\n193|\n194|// TestDigitCensusCoversEveryLeafGuard derives every digit guard from\n195|// leaf production source and requires each to resolve to exactly one\n196|// declared row naming a real test, and every declared row to resolve\n197|// to exactly one derived guard.\n198|func TestDigitCensusCoversEveryLeafGuard(t *testing.T) {\n199|\tt.Parallel()\n200|\n201|\tsites, unclassifiable, files := deriveDigitGuardSites(t)\n202|\tif len(unclassifiable) > 0 {\n203|\t\tsort.Strings(unclassifiable)\n204|\t\tt.Fatalf(\"unclassifiable digit-guard shapes (%d), classify them before the suite passes:\\n%s\",\n205|\t\t\tlen(unclassifiable), strings.Join(unclassifiable, \"\\n\"))\n206|\t}\n207|\tseen := map[string]int{}\n208|\tfor _, site := range sites {\n209|\t\tseen[digitGuardKey(site.dir, site.file, site.function, site.kind, site.expr)]++\n210|\t}\n211|\tfor key, count := range seen {\n212|\t\tif count > 1 {\n213|\t\t\tt.Fatalf(\"derived digit guard %q occurs %d times; disambiguate the rows instead of hiding behind a sibling\", key, count)\n214|\t\t}\n215|\t}\n216|\tbyKey := map[string]digitGuardSite{}\n217|\tfor _, site := range sites {\n218|\t\tbyKey[digitGuardKey(site.dir, site.file, site.function, site.kind, site.expr)] = site\n219|\t}\n220|\ttests := digitCensusTestNames(t)\n221|\tvar unregistered []string\n222|\tfor _, site := range sites {\n223|\t\tkey := digitGuardKey(site.dir, site.file, site.function, site.kind, site.expr)\n224|\t\tfound := false\n225|\t\tfor _, row := range digitGuardRows {\n226|\t\t\tif digitGuardKey(row.dir, row.file, row.function, row.kind, row.expr) == key {\n227|\t\t\t\tfound = true\n228|\t\t\t\tbreak\n229|\t\t\t}\n230|\t\t}\n231|\t\tif !found {\n232|\t\t\tunregistered = append(unregistered, \"unregistered \"+site.kind+\" site \"+key)\n233|\t\t}\n234|\t}\n235|\tvar orphan []string\n236|\tfor _, row := range digitGuardRows {\n237|\t\tkey := digitGuardKey(row.dir, row.file, row.function, row.kind, row.expr)\n238|\t\tif _, ok := byKey[key]; !ok {\n239|\t\t\torphan = append(orphan, \"orphan row \"+key)\n240|\t\t\tcontinue\n241|\t\t}\n242|\t\tswitch row.kind {\n243|\t\tcase \"char\":\n244|\t\t\tif row.rejected == \"\" {\n245|\t\t\t\torphan = append(orphan, \"char row \"+key+\" declares no rejected class\")\n246|\t\t\t}\n247|\t\t\tif row.threshold != \"\" || row.witness != \"\" {\n248|\t\t\t\torphan = append(orphan, \"char row \"+key+\" carries bound fields\")\n249|\t\t\t}\n250|\t\tcase \"bound\":\n251|\t\t\tif row.threshold == \"\" || row.witness == \"\" {\n252|\t\t\t\torphan = append(orphan, \"bound row \"+key+\" declares no threshold or witness\")\n253|\t\t\t}\n254|\t\t\tif row.rejected != \"\" {\n255|\t\t\t\torphan = append(orphan, \"bound row \"+key+\" carries a rejected class\")\n256|\t\t\t}\n257|\t\tdefault:\n258|\t\t\torphan = append(orphan, \"row \"+key+\" has unknown kind \"+row.kind)\n259|\t\t}\n260|\t\tif len(row.tests) == 0 {\n261|\t\t\torphan = append(orphan, \"row \"+key+\" names no driving test\")\n262|\t\t}\n263|\t\tfor _, name := range row.tests {\n264|\t\t\tif !tests[name] {\n265|\t\t\t\torphan = append(orphan, \"row \"+key+\" names missing test \"+name)\n266|\t\t\t}\n267|\t\t}\n268|\t}\n269|\tif len(unregistered) > 0 || len(orphan) > 0 {\n270|\t\tsort.Strings(unregistered)\n271|\t\tsort.Strings(orphan)\n272|\t\tt.Fatalf(\"digit-guard census mismatch:\\n%s\\n%s\",\n273|\t\t\tstrings.Join(unregistered, \"\\n\"), strings.Join(orphan, \"\\n\"))\n274|\t}\n275|\tt.Logf(\"digit-guard census: %d/%d derived sites rowed across %d production files\",\n276|\t\tlen(sites), len(digitGuardRows), files)\n277|}\n278|\n279|// TestDigitCensusAdjacentsNeverReachGeometryGate proves `/` (0x2F) and\n280|// `:` (0x3A) — the characters adjacent to the digit range — never reach\n281|// the descriptorGeometry gate: neither spells inside a JSON number, so\n282|// the strict decoder refuses first with the document syntax arm. A gate\n283|// mutant shifting either bound (`digit > ':'`, `digit < '/'`) or\n284|// skipping either character token-preservingly changes no disposition\n285|// here; the rows exist so the census claim \"unreachable\" is measured,\n286|// not asserted. Both members are driven because the geometry site is\n287|// shared and the decoder runs before either call.\n288|func TestDigitCensusAdjacentsNeverReachGeometryGate(t *testing.T) {\n289|\tt.Parallel()\n290|\n291|\tfor _, member := range []string{\"columns\", \"rows\"} {\n292|\t\tfor _, literal := range []string{`1/2`, `1:2`} {\n293|\t\t\t_, err := terminalbackend.ParseProviderDescriptor(setDescriptorMember(t, member, literal))\n294|\t\t\tif err == nil || !terminalbackend.IsMismatch(err) {\n295|\t\t\t\tt.Fatalf(\"ParseProviderDescriptor(%s=%s) error = %v, want a document mismatch refusal\", member, literal, err)\n296|\t\t\t}\n297|\t\t\tif got := refusalDetail(t, err); got != \"document syntax\" {\n298|\t\t\t\tt.Fatalf(\"ParseProviderDescriptor(%s=%s) detail = %q, want document syntax\", member, literal, got)\n299|\t\t\t}\n300|\t\t}\n301|\t}\n302|}\n303|\n304|// deriveDigitGuardSites parses every production file of the two leaf\n305|// packages and returns every digit-guard site in source order, every\n306|// unclassifiable shape, and the scanned file count. The file set is\n307|// directory-derived: a new production file is scanned without anyone\n308|// remembering it.\n309|func deriveDigitGuardSites(t *testing.T) (sites []digitGuardSite, unclassifiable []string, files int) {\n310|\tt.Helper()\n311|\n312|\troot, err := os.Getwd()\n313|\tif err != nil {\n314|\t\tt.Fatalf(\"derive digit guards: %v\", err)\n315|\t}\n316|\tdirs := []struct {\n317|\t\tlabel string\n318|\t\tpath  string\n319|\t}{\n320|\t\t{\"terminalbackend\", root},\n321|\t\t{\"provhost\", filepath.Join(root, \"..\", \"provhost\")},\n322|\t}\n323|\tfor _, dir := range dirs {\n324|\t\t// Selection and fail-closed parsing are the shared core's;\n325|\t\t// the core returns names sorted, preserving source order.\n326|\t\tproductions, _ := invcore.MustScanProduction(t, dir.path)\n327|\t\tfiles += len(productions)\n328|\t\tfor _, production := range productions {\n329|\t\t\tname, syntax := production.Name, production.Syntax\n330|\t\t\tfor _, decl := range syntax.Decls {\n331|\t\t\t\tswitch decl := decl.(type) {\n332|\t\t\t\tcase *ast.FuncDecl:\n333|\t\t\t\t\tif decl.Body == nil {\n334|\t\t\t\t\t\tcontinue\n335|\t\t\t\t\t}\n336|\t\t\t\t\tfunction := decl.Name.Name\n337|\t\t\t\t\tif decl.Recv != nil && len(decl.Recv.List) > 0 {\n338|\t\t\t\t\t\tfunction = digitGuardReceiver(decl.Recv.List[0].Type) + \".\" + function\n339|\t\t\t\t\t}\n340|\t\t\t\t\tmore, bad := digitGuardSitesInBody(dir.label, name, function, decl.Body)\n341|\t\t\t\t\tsites = append(sites, more...)\n342|\t\t\t\t\tunclassifiable = append(unclassifiable, bad...)\n343|\t\t\t\tcase *ast.GenDecl:\n344|\t\t\t\t\tmore, bad := digitGuardSitesInInit(dir.label, name, decl)\n345|\t\t\t\t\tsites = append(sites, more...)\n346|\t\t\t\t\tunclassifiable = append(unclassifiable, bad...)\n347|\t\t\t\t}\n348|\t\t\t}\n349|\t\t}\n350|\t}\n351|\tif files == 0 {\n352|\t\tt.Fatal(\"derived digit guards from zero production files; the scanner is broken, not the leaf\")\n353|\t}\n354|\tif len(sites) == 0 {\n355|\t\tt.Fatal(\"derived zero digit guards from the leaf sources; the scanner is broken, not the leaf\")\n356|\t}\n357|\treturn sites, unclassifiable, files\n358|}\n359|\n360|// digitGuardReceiver names the receiver type of a method for the site\n361|// key: value and pointer receivers share the key space.\n362|func digitGuardReceiver(expr ast.Expr) string {\n363|\texpr = digitGuardUnparen(expr)\n364|\tif star, ok := expr.(*ast.StarExpr); ok {\n365|\t\treturn digitGuardReceiver(star.X)\n366|\t}\n367|\tif ident, ok := expr.(*ast.Ident); ok {\n368|\t\treturn ident.Name\n369|\t}\n370|\treturn \"recv\"\n371|}\n372|\n373|// digitGuardUnparen strips parentheses.\n374|func digitGuardUnparen(expr ast.Expr) ast.Expr {\n375|\tfor {\n376|\t\tparen, ok := expr.(*ast.ParenExpr)\n377|\t\tif !ok {\n378|\t\t\treturn expr\n379|\t\t}\n380|\t\texpr = paren.X\n381|\t}\n382|}\n383|\n384|// digitGuardSitesInInit scans one package-level declaration with no\n385|// accumulator in scope: only char chains can appear here, and any\n386|// accumulator-shaped comparison fails as unclassifiable rather than\n387|// entering silently.\n388|func digitGuardSitesInInit(dir, file string, decl *ast.GenDecl) ([]digitGuardSite, []string) {\n389|\tvar sites []digitGuardSite\n390|\tvar bad []string\n391|\tast.Inspect(decl, func(node ast.Node) bool {\n392|\t\texpr, ok := node.(ast.Expr)\n393|\t\tif !ok {\n394|\t\t\treturn true\n395|\t\t}\n396|\t\tsite, failure, done := digitGuardClassifyRoot(dir, file, \"(package initializer)\", expr, map[string]bool{})\n397|\t\tif done {\n398|\t\t\tif failure != \"\" {\n399|\t\t\t\tbad = append(bad, failure)\n400|\t\t\t} else if site != nil {\n401|\t\t\t\tsites = append(sites, *site)\n402|\t\t\t}\n403|\t\t\treturn false\n404|\t\t}\n405|\t\treturn true\n406|\t})\n407|\treturn sites, bad\n408|}\n409|\n410|// digitGuardSitesInBody scans one function body. Accumulators are\n411|// collected first so a guard comparison resolves against the\n412|// function's own accumulation steps, never against a name list.\n413|func digitGuardSitesInBody(dir, file, function string, body *ast.BlockStmt) ([]digitGuardSite, []string) {\n414|\taccumulators := digitGuardAccumulators(body)\n415|\tvar sites []digitGuardSite\n416|\tvar bad []string\n417|\tast.Inspect(body, func(node ast.Node) bool {\n418|\t\texpr, ok := node.(ast.Expr)\n419|\t\tif !ok {\n420|\t\t\treturn true\n421|\t\t}\n422|\t\tsite, failure, done := digitGuardClassifyRoot(dir, file, function, expr, accumulators)\n423|\t\tif done {\n424|\t\t\tif failure != \"\" {\n425|\t\t\t\tbad = append(bad, failure)\n426|\t\t\t} else if site != nil {\n427|\t\t\t\tsites = append(sites, *site)\n428|\t\t\t}\n429|\t\t\treturn false\n430|\t\t}\n431|\t\treturn true\n432|\t})\n433|\treturn sites, bad\n434|}\n435|\n436|// digitGuardClassifyRoot decides whether expr is a chain root worth\n437|// classifying: a ||/&& whose parent the Inspect walk already consumed\n438|// is part of the outer chain, and a comparison inside any ||/&&\n439|// chain belongs to its root. Non-root nodes report done=false so the\n440|// walk descends. A root with no digit or accumulator content reports\n441|// done=true with no site, pruning the walk below it.\n442|func digitGuardClassifyRoot(dir, file, function string, expr ast.Expr, accumulators map[string]bool) (*digitGuardSite, string, bool) {\n443|\tbinary, ok := expr.(*ast.BinaryExpr)\n444|\tif !ok {\n445|\t\treturn nil, \"\", false\n446|\t}\n447|\tif binary.Op == token.LOR || binary.Op == token.LAND {\n448|\t\treturn digitGuardClassifyChain(dir, file, function, binary, accumulators)\n449|\t}\n450|\tif digitGuardIsComparison(binary.Op) {\n451|\t\tleaf := digitGuardClassifyLeaf(binary, accumulators)\n452|\t\tswitch leaf {\n453|\t\tcase digitLeafChar:\n454|\t\t\treturn &digitGuardSite{dir: dir, file: file, function: function, kind: \"char\", expr: digitGuardCanon(binary)}, \"\", true\n455|\t\tcase digitLeafBound:\n456|\t\t\treturn &digitGuardSite{dir: dir, file: file, function: function, kind: \"bound\", expr: digitGuardCanon(binary)}, \"\", true\n457|\t\tcase digitLeafBad:\n458|\t\t\treturn nil, \"unclassifiable guard in \" + file + \" (\" + function + \"): \" + digitGuardCanon(binary), true\n459|\t\tdefault:\n460|\t\t\treturn nil, \"\", false\n461|\t\t}\n462|\t}\n463|\treturn nil, \"\", false\n464|}\n465|\n466|// digitGuardClassifyChain gathers the leaves of one maximal ||/&&\n467|// chain and places the chain: pure digit chains are char sites,\n468|// pure accumulator chains are bound sites, anything mixed or\n469|// degenerate is unclassifiable, and chains with no digit or\n470|// accumulator content are pruned.\n471|func digitGuardClassifyChain(dir, file, function string, root *ast.BinaryExpr, accumulators map[string]bool) (*digitGuardSite, string, bool) {\n472|\tvar chars, bounds, other, bad int\n473|\tvar visit func(expr ast.Expr)\n474|\tvisit = func(expr ast.Expr) {\n475|\t\texpr = digitGuardUnparen(expr)\n476|\t\tif inner, ok := expr.(*ast.BinaryExpr); ok && (inner.Op == token.LOR || inner.Op == token.LAND) {\n477|\t\t\tvisit(inner.X)\n478|\t\t\tvisit(inner.Y)\n479|\t\t\treturn\n480|\t\t}\n481|\t\tif negated, ok := expr.(*ast.UnaryExpr); ok && negated.Op == token.NOT {\n482|\t\t\tif digitGuardMentionsDigitOrAccumulator(negated.X, accumulators) {\n483|\t\t\t\tbad++\n484|\t\t\t} else {\n485|\t\t\t\tother++\n486|\t\t\t}\n487|\t\t\treturn\n488|\t\t}\n489|\t\tif comparison, ok := expr.(*ast.BinaryExpr); ok && digitGuardIsComparison(comparison.Op) {\n490|\t\t\tswitch digitGuardClassifyLeaf(comparison, accumulators) {\n491|\t\t\tcase digitLeafChar:\n492|\t\t\t\tchars++\n493|\t\t\tcase digitLeafBound:\n494|\t\t\t\tbounds++\n495|\t\t\tcase digitLeafBad:\n496|\t\t\t\tbad++\n497|\t\t\tdefault:\n498|\t\t\t\tother++\n499|\t\t\t}\n500|\t\t\treturn\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
