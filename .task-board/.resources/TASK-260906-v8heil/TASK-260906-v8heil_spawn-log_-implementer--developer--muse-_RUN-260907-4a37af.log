{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d589","stream":{"kind":"session","id":"01a079e0-55db-79f2-85b0-c8c2e4c1a43f"},"sequence":2335,"recorded_at":1780531400004665,"record_type":"event","durability":"durable","causation_id":"38173c32-e836-4324-8339-ee117e4249f1","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"38173c32-e836-4324-8339-ee117e4249f1","run_stream":{"kind":"run","id":"38173c32-e836-4324-8339-ee117e4249f1"},"task_stream":{"kind":"task","id":"f01212dc-2035-46cc-a233-ca2f23d3c67b"},"task_id":"f01212dc-2035-46cc-a233-ca2f23d3c67b","event":{"kind":"output","task_id":"f01212dc-2035-46cc-a233-ca2f23d3c67b","chunk":"edited\nchanged lines: lines 65-72\n--- original\n+++ updated\n@@\n-        census = run_mask(mut.get(\"census_pkg\", pkg), mut[\"census_run\"])\n-        behav = run_mask(mut.get(\"behav_pkg\", pkg), mut[\"behav_run\"])\n-        killers = [name for name, res in ((\"census\", census), (\"behav\", behav))\n-                   if res[\"verdict\"] == \"KILLED\"]\n-        return {\"id\": mut[\"id\"], \"class\": mut[\"class\"],\n-                \"verdict\": \"KILLED\" if killers else \"SURVIVED\",\n-                \"killers\": killers, \"expect\": mut.get(\"expect\"),\n-                \"census\": census, \"behav\": behav}\n+        census = run_mask(mut.get(\"census_pkg\", pkg), mut[\"census_run\"])\n+        behav = run_mask(mut.get(\"behav_pkg\", pkg), mut[\"behav_run\"])\n+        masks = [(\"census\", census), (\"behav\", behav)]\n+        record = {\"id\": mut[\"id\"], \"class\": mut[\"class\"],\n+                  \"expect\": mut.get(\"expect\"),\n+                  \"census\": census, \"behav\": behav}\n+        # Audit mask (round 2): a full-package run whose TestMain audit\n+        # compares the exercised site set against the derivation. Scoped\n+        # census/behav masks skip that audit by construction, so a mutant\n+        # the derivation cannot see and the witnesses cannot feel (the\n+        # P8 sibling-swallow shape) is green on both and red here.\n+        if \"audit_run\" in mut or \"audit_pkg\" in mut:\n+            audit = run_mask(mut.get(\"audit_pkg\", pkg), mut.get(\"audit_run\", \"\"))\n+            masks.append((\"audit\", audit))\n+            record[\"audit\"] = audit\n+        killers = [name for name, res in masks if res[\"verdict\"] == \"KILLED\"]\n+        record[\"verdict\"] = \"KILLED\" if killers else \"SURVIVED\"\n+        record[\"killers\"] = killers\n+        return record\n"}}}
