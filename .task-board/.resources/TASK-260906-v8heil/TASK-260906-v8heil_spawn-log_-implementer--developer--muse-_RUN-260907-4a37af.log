{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5ed","stream":{"kind":"session","id":"01a079e0-55db-79f2-85b0-c8c2e4c1a43f"},"sequence":337,"recorded_at":1780531400000669,"record_type":"event","durability":"durable","causation_id":"38173c32-e836-4324-8339-ee117e4249f1","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38173c32-e836-4324-8339-ee117e4249f1","run_stream":{"kind":"run","id":"38173c32-e836-4324-8339-ee117e4249f1"},"call_id":"call_01a079e1009175a08803e14ba1199d37","text":"Read text file `internal/terminalbackend/terminalbackend.go`.\n1|// Package terminalbackend implements the TerminalBackend registry: canonical\n2|// backend identities, implementation/protocol version tuples, external\n3|// executable trust admission, and duplicate or drift refusal.\n4|//\n5|// Normative scope is relux-works/agent-session-manager-spec@v0.5.0 §4.B\n6|// (registry, identity, discovery, trust), §4.1 (backend interface versions),\n7|// §6.5 (Configuration 3.0.0 TerminalBackend extension), and §7.A (Provider\n8|// Protocol 3.0.0 Terminal Instance binding). Manifest/Probe schemas,\n9|// capability evidence, and generation-bound admission are defined in\n10|// manifest.go; lifecycle operations and legacy v0.4.3 translation belong to\n11|// the sibling story tasks and are deliberately not defined here.\n12|package terminalbackend\n13|\n14|import (\n15|\t\"crypto/sha256\"\n16|\t\"encoding/hex\"\n17|\t\"errors\"\n18|\t\"fmt\"\n19|\t\"math\"\n20|\t\"os\"\n21|\t\"path/filepath\"\n22|\t\"regexp\"\n23|\t\"sort\"\n24|\t\"strings\"\n25|\t\"sync\"\n26|\t\"unicode/utf8\"\n27|\n28|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n29|)\n30|\n31|// Wire error codes are the exact Section 15.3 codes the registry may report.\n32|// They are a subset of the pinned catalog error vocabulary; no other code is\n33|// emitted by this package.\n34|const (\n35|\t// CodeNotFound reports an unknown or malformed backend identity. A failed\n36|\t// read is never absence: callers must not treat this as \"no backend\".\n37|\tCodeNotFound = \"terminal_backend_not_found\"\n38|\t// CodeAmbiguous reports a duplicate or ambiguous backend ID. Re-registering\n39|\t// an identical record is still refused: identity registration is not\n40|\t// idempotent.\n41|\tCodeAmbiguous = \"terminal_backend_ambiguous\"\n42|\t// CodeUntrusted reports a disabled, unresolvable, or digest-mismatched\n43|\t// external executable. Trust is established before any probe.\n44|\tCodeUntrusted = \"terminal_backend_untrusted\"\n45|\t// CodeDrift reports a re-registration whose version tuple, kind,\n46|\t// platforms, or executable digest differs from the admitted record.\n47|\tCodeDrift = \"terminal_backend_implementation_drift\"\n48|\t// CodeRestoreMismatch reports an attempt to substitute the configured\n49|\t// default for the exact prior binding on restore or resume.\n50|\tCodeRestoreMismatch = \"terminal_backend_restore_mismatch\"\n51|\t// CodeStaleGeneration reports a generation that is out of bound or does\n52|\t// not match the validated binding.\n53|\tCodeStaleGeneration = \"terminal_backend_stale_generation\"\n54|)\n55|\n56|// Canonical built-in backend identities. The ax. namespace is reserved (§4.B);\n57|// no third-party registration may use it.\n58|const (\n59|\tBuiltinTmux   = \"ax.tmux\"\n60|\tBuiltinConpty = \"ax.conpty\"\n61|)\n62|\n63|// reservedNamespace is the only namespace this implementation may mint.\n64|const reservedNamespace = \"ax.\"\n65|\n66|// maxIDBytes is the Section 4.B bound: 1-128 ASCII bytes.\n67|const maxIDBytes = 128\n68|\n69|// maxGenerationRunes is the Section 4.B/7.A bound: string[1..256] counts\n70|// UTF-8 characters (SPEC.md:321), not bytes; terminal_backend_id is the\n71|// only member of this package still bounded in ASCII bytes.\n72|const maxGenerationRunes = 256\n73|\n74|// maxProtocolVersions is the Section 4.B bound: sorted unique semver[1..32].\n75|const maxProtocolVersions = 32\n76|\n77|var (\n78|\tidPattern = regexp.MustCompile(`^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$`)\n79|\t// semverPattern implements Semantic Versioning 2.0.0 in full, matching the\n80|\t// grammar the canonical and config packages enforce for the same members.\n81|\tsemverPattern = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n82|)\n83|\n84|// Error is a registry refusal. Code is always one of the Code* constants;\n85|// BackendID names the identity at issue when there is one. Detail is a static\n86|// clause: it never echoes paths, digests, generations, or other local data.\n87|type Error struct {\n88|\tCode      string\n89|\tBackendID string\n90|\tDetail    string\n91|}\n92|\n93|func (err *Error) Error() string {\n94|\tif err.BackendID == \"\" {\n95|\t\treturn \"terminal backend refused: \" + err.Code + \" at \" + err.Detail\n96|\t}\n97|\treturn \"terminal backend refused: \" + err.Code + \" for \" + err.BackendID + \" at \" + err.Detail\n98|}\n99|\n100|// errorCode reports whether err carries the given wire code.\n101|func errorCode(err error, code string) bool {\n102|\tvar refusal *Error\n103|\tif !errors.As(err, &refusal) {\n104|\t\treturn false\n105|\t}\n106|\treturn refusal.Code == code\n107|}\n108|\n109|// IsNotFound reports CodeNotFound refusals.\n110|func IsNotFound(err error) bool { return errorCode(err, CodeNotFound) }\n111|\n112|// IsAmbiguous reports CodeAmbiguous refusals.\n113|func IsAmbiguous(err error) bool { return errorCode(err, CodeAmbiguous) }\n114|\n115|// IsUntrusted reports CodeUntrusted refusals.\n116|func IsUntrusted(err error) bool { return errorCode(err, CodeUntrusted) }\n117|\n118|// IsDrift reports CodeDrift refusals.\n119|func IsDrift(err error) bool { return errorCode(err, CodeDrift) }\n120|\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5ef","stream":{"kind":"session","id":"01a079e0-55db-79f2-85b0-c8c2e4c1a43f"},"sequence":338,"recorded_at":1780531400000671,"record_type":"event","durability":"durable","causation_id":"38173c32-e836-4324-8339-ee117e4249f1","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38173c32-e836-4324-8339-ee117e4249f1","run_stream":{"kind":"run","id":"38173c32-e836-4324-8339-ee117e4249f1"},"call_id":"call_01a079e1016377f08ba9cad570616ad3","text":"Read text file `internal/terminalbackend/conformance.go`.\n1|// Lifecycle, attach, entrypoint, replication, and historical-translation\n2|// conformance for the TerminalBackend registry.\n3|//\n4|// Normative scope is relux-works/agent-session-manager-spec@v0.5.0 §4.A\n5|// (authority: attach changes no ownership; every backend-created runtime\n6|// executes exactly `ax pane SESSION_ID`), §4.C (lifecycle state machine,\n7|// transition/authorization/idempotency table), §4.D (attach authorization\n8|// neutrality and capability dependencies, enforced by manifest.go), §4.E\n9|// (replication classification and v0.4.3 historical translation), §4.1\n10|// (backend interface operations and the idempotent bootstrap binding), §6.5\n11|// (platform defaults select only new activation), and §7.A (provider-side\n12|// descriptor binding, enforced by CheckProviderDescriptor in\n13|// terminalbackend.go).\n14|//\n15|// Section 4.B names this deliverable: \"M0 exposes only an internal semantic\n16|// interface and conformance harness\". This file is that harness: it proves\n17|// the semantics over admitted registry state but performs no I/O, launches\n18|// no backend, and holds no authority beyond refusing contract violations.\n19|// Capability gating stays in manifest.go (CheckOperation, Reconcile); trust\n20|// stays in terminalbackend.go (RegisterExternal, DigestFile). A refusal here\n21|// is an *Error with a wire code from the pinned catalog error vocabulary\n22|// and a static Detail clause, following the package convention.\n23|package terminalbackend\n24|\n25|import (\n26|\t\"sort\"\n27|\t\"strings\"\n28|\t\"sync\"\n29|\t\"time\"\n30|\n31|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n32|)\n33|\n34|// Wire error codes this file may report. Each is a member of the pinned\n35|// catalog error vocabulary; TestWireCodesAreCatalogued proves no other code\n36|// is advertised.\n37|const (\n38|\t// CodeProtocolError reports an unknown operation, state, or member, a\n39|\t// body variant outside the closed §4.C matrix, or an error code the\n40|\t// backend MUST NOT emit for the operation (§4.B, §4.C). AX-local\n41|\t// parsing may additionally emit it for a syntactically valid request\n42|\t// the matrix does not cover.\n43|\tCodeProtocolError = \"terminal_backend_protocol_error\"\n44|\t// CodeUnauthorized reports an expired, mismatched, or otherwise\n45|\t// unsatisfiable attach authorization (§4.C attach row).\n46|\tCodeUnauthorized = \"terminal_backend_unauthorized\"\n47|\t// CodeUnavailable reports a backend that cannot serve the operation.\n48|\t// It appears here only inside the allowed-error sets: no conformance\n49|\t// refusal in this file emits it, so it carries no arm of its own.\n50|\tCodeUnavailable = \"terminal_backend_unavailable\"\n51|\t// CodePreconditionFailed reports a legal request against an illegal\n52|\t// source state, a non-conforming stable entrypoint, or any other\n53|\t// unmet local precondition (§4.C per-operation rows, §4.1).\n54|\tCodePreconditionFailed = \"local_precondition_failed\"\n55|\t// CodeIdempotencyMismatch reports a changed operation inside an\n56|\t// established idempotency window (§4.C, §4.1).\n57|\tCodeIdempotencyMismatch = \"idempotency_mismatch\"\n58|\t// CodeIncompatibleSchema reports a legacy identity with no canonical\n59|\t// projection, or a canonical identity with no legacy projection\n60|\t// (§4.E). It never falls back.\n61|\tCodeIncompatibleSchema = \"incompatible_schema\"\n62|)\n63|\n64|// IsProtocolError reports CodeProtocolError refusals.\n65|func IsProtocolError(err error) bool { return errorCode(err, CodeProtocolError) }\n66|\n67|// IsUnauthorized reports CodeUnauthorized refusals.\n68|func IsUnauthorized(err error) bool { return errorCode(err, CodeUnauthorized) }\n69|\n70|// IsPreconditionFailed reports CodePreconditionFailed refusals.\n71|func IsPreconditionFailed(err error) bool { return errorCode(err, CodePreconditionFailed) }\n72|\n73|// IsIdempotencyMismatch reports CodeIdempotencyMismatch refusals.\n74|func IsIdempotencyMismatch(err error) bool { return errorCode(err, CodeIdempotencyMismatch) }\n75|\n76|// IsIncompatibleSchema reports CodeIncompatibleSchema refusals.\n77|func IsIncompatibleSchema(err error) bool { return errorCode(err, CodeIncompatibleSchema) }\n78|\n79|// InstanceState is the closed §4.C TerminalInstanceState enum: local\n80|// hosting only, never a second ownership state machine.\n81|type InstanceState string\n82|\n83|// Terminal Instance states.\n84|const (\n85|\tStateAbsent      InstanceState = \"absent\"\n86|\tStateCreating    InstanceState = \"creating\"\n87|\tStateParked      InstanceState = \"parked\"\n88|\tStateActive      InstanceState = \"active\"\n89|\tStateQuiescing   InstanceState = \"quiescing\"\n90|\tStateStopped     InstanceState = \"stopped\"\n91|\tStateStaleFenced InstanceState = \"stale_fenced\"\n92|\tStateUnavailable InstanceState = \"unavailable\"\n93|)\n94|\n95|// ParseInstanceState admits exactly the eight §4.C states.\n96|func ParseInstanceState(value string) (InstanceState, error) {\n97|\tswitch InstanceState(value) {\n98|\tcase StateAbsent, StateCreating, StateParked, StateActive,\n99|\t\tStateQuiescing, StateStopped, StateStaleFenced, StateUnavailable:\n100|\t\treturn InstanceState(value), nil\n101|\tdefault:\n102|\t\treturn \"\", &Error{Code: CodeProtocolError, Detail: \"lifecycle state vocabulary\"}\n103|\t}\n104|}\n105|\n106|// Operation is the closed §4.D TerminalBackendOperation enum.\n107|type Operation string\n108|\n109|// Terminal backend operations.\n110|const (\n111|\tOperationManifest         Operation = \"manifest\"\n112|\tOperationProbe            Operation = \"probe\"\n113|\tOperationCreate           Operation = \"create\"\n114|\tOperationAttach           Operation = \"attach\"\n115|\tOperationStatus           Operation = \"status\"\n116|\tOperationQuiesceInput     Operation = \"quiesce-input\"\n117|\tOperationWaitSafeBoundary Operation = \"wait-safe-boundary\"\n118|\tOperationRequestStop      Operation = \"request-stop\"\n119|\tOperationTerminateStale   Operation = \"terminate-stale\"\n120|\tOperationRestore          Operation = \"restore\"\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5f1","stream":{"kind":"session","id":"01a079e0-55db-79f2-85b0-c8c2e4c1a43f"},"sequence":339,"recorded_at":1780531400000673,"record_type":"event","durability":"durable","causation_id":"38173c32-e836-4324-8339-ee117e4249f1","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38173c32-e836-4324-8339-ee117e4249f1","run_stream":{"kind":"run","id":"38173c32-e836-4324-8339-ee117e4249f1"},"call_id":"call_01a079e1020e7bc1aa80ec97bca08321","text":"Read text file `internal/terminalbackend/manifest.go`.\n1|// Manifest, Probe, and Capability Evidence admission for the\n2|// TerminalBackend registry.\n3|//\n4|// Normative scope is relux-works/agent-session-manager-spec@v0.5.0 §4.B\n5|// (Manifest/Probe closed schemas, generation digest, reconciliation,\n6|// identity rule), §4.D (closed capability registry, claim rows, evidence\n7|// schema, fact mapping), §6.5 (trust established before any probe;\n8|// configuration admission), and §7.A (generation-bound descriptor binding).\n9|// Lifecycle operations other than admission (create, attach, status, and\n10|// friends) belong to the sibling lifecycle task; this file gates only which\n11|// capabilities an operation may rely on, never the operations themselves.\n12|//\n13|// Fail-closed conventions shared with the registry half of this package:\n14|// every refusal is an *Error with a wire code from the pinned catalog error\n15|// vocabulary and a static Detail clause that never echoes paths, digests,\n16|// generations, or other local data. A partial, malformed, stale, or failed\n17|// Manifest, Probe, or evidence read is an error, never absence or\n18|// availability, so callers must not fall back to a default or to PATH\n19|// discovery.\n20|package terminalbackend\n21|\n22|import (\n23|\t\"bytes\"\n24|\t\"crypto/sha256\"\n25|\t\"encoding/base64\"\n26|\t\"encoding/hex\"\n27|\t\"encoding/json\"\n28|\t\"fmt\"\n29|\t\"strings\"\n30|\t\"time\"\n31|\t\"unicode/utf8\"\n32|\n33|\t\"github.com/gowebpki/jcs\"\n34|\n35|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n36|)\n37|\n38|// Wire error codes this file may report. They extend the registry-half codes\n39|// with the exact Section 15.3 codes for manifest/probe disagreement,\n40|// unevidenced capability use, and integrity failure; every one is a member of\n41|// the pinned catalog error vocabulary.\n42|const (\n43|\t// CodeMismatch reports any failed Manifest/Probe equality, membership,\n44|\t// keyed claim relation, evidence binding, or evidence coverage rule\n45|\t// (§4.B). Malformed Manifest, Probe, or evidence documents also report\n46|\t// this code: a malformed read is an error, never absence.\n47|\tCodeMismatch = \"terminal_backend_manifest_probe_mismatch\"\n48|\t// CodeCapabilityUnproven reports an operation gate evaluated against an\n49|\t// admitted capability set that confers no true capability for the\n50|\t// requested operation (§4.C capability dependencies).\n51|\tCodeCapabilityUnproven = \"terminal_backend_capability_unproven\"\n52|\t// CodeIntegrityFailure reports a missing, malformed, unknown-key, or\n53|\t// invalid capability-evidence signature, or a signature verification\n54|\t// subsystem that is unavailable (§4.D). It fails before capability\n55|\t// admission.\n56|\tCodeIntegrityFailure = \"terminal_backend_integrity_failure\"\n57|)\n58|\n59|// IsMismatch reports CodeMismatch refusals.\n60|func IsMismatch(err error) bool { return errorCode(err, CodeMismatch) }\n61|\n62|// IsCapabilityUnproven reports CodeCapabilityUnproven refusals.\n63|func IsCapabilityUnproven(err error) bool { return errorCode(err, CodeCapabilityUnproven) }\n64|\n65|// IsIntegrityFailure reports CodeIntegrityFailure refusals.\n66|func IsIntegrityFailure(err error) bool { return errorCode(err, CodeIntegrityFailure) }\n67|\n68|// Closed schema literals (§4.B, §4.D). No other schema or version is\n69|// admitted by this file.\n70|const (\n71|\t// SchemaManifest is the Terminal Backend Manifest 1.0.0 schema URN.\n72|\tSchemaManifest = \"urn:ax:schema:terminal-backend-manifest\"\n73|\t// SchemaProbe is the Terminal Backend Probe 1.0.0 schema URN.\n74|\tSchemaProbe = \"urn:ax:schema:terminal-backend-probe\"\n75|\t// SchemaCapabilityEvidence is the Capability Evidence 1.0.0 schema URN.\n76|\tSchemaCapabilityEvidence = \"urn:ax:schema:terminal-capability-evidence\"\n77|\t// SchemaVersion100 is the only contract version this file implements.\n78|\tSchemaVersion100 = \"1.0.0\"\n79|)\n80|\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
