\\n\\ndef sha(path):\\n    with open(path, \\\"rb\\\") as handle:\\n        return hashlib.sha256(handle.read()).hexdigest()\\n\\n\\ndef run_mask(pkg, run):\\n    # Empty run selects the whole package (no -run flag): provider's\\n    # TestMain audit only runs unscoped, so a scoped census mask would\\n    # pass vacuously. Non-empty masks stay scoped.\\n    cmd = [\\\"go\\\", \\\"test\\\", pkg, \\\"-count=1\\\", \\\"-v\\\"]\\n    if run:\\n        cmd += [\\\"-run\\\", run]\\n    res = subprocess.run(cmd, cwd=ROOT, capture_output=True, text=True)\\n    out = res.stdout + res.stderr\\n    ran = out.count(\\\"--- PASS\\\") + out.count(\\\"--- FAIL\\\")\\n    verdict = \\\"KILLED\\\" if res.returncode != 0 else \\\"SURVIVED\\\"\\n    evidence = [line for line in out.splitlines()\\n                if \\\"FAIL\\\" in line or \\\"want\\\" in line][:4]\\n    return {\\\"verdict\\\": verdict, \\\"ran\\\": ran, \\\"evidence\\\": evidence}\\n\\n\\ndef run(mut):\\n    path = ROOT + \\\"/\\\" + mut[\\\"file\\\"]\\n    with open(path, \\\"r\\\", encoding=\\\"utf-8\\\") as handle:\\n        original = handle.read()\\n    before = hashlib.sha256(original.encode()).hexdigest()\\n    old, new = mut[\\\"old\\\"], mut[\\\"new\\\"]\\n    count = original.count(old)\\n    if count != 1:\\n        return {\\\"id\\\": mut[\\\"id\\\"], \\\"class\\\": mut[\\\"class\\\"],\\n                \\\"verdict\\\": \\\"NOT_APPLIED\\\",\\n                \\\"detail\\\": \\\"anchor occurs %d times\\\" % count}\\n    try:\\n        with open(path, \\\"w\\\", encoding=\\\"utf-8\\\") as handle:\\n            handle.write(original.replace(old, new, 1))\\n        pkg = \\\"./\\\" + mut[\\\"file\\\"].split(\\\"/\\\")[0] + \\\"/\\\" + mut[\\\"file\\\"].split(\\\"/\\\")[1] + \\\"/\\\"\\n        vet = subprocess.run([\\\"go\\\", \\\"vet\\\", pkg], cwd=ROOT,\\n                             capture_output=True, text=True)\\n        if vet.returncode != 0:\\n            return {\\\"id\\\": mut[\\\"id\\\"], \\\"class\\\": mut[\\\"class\\\"],\\n                    \\\"verdict\\\": \\\"COMPILE_FAIL\\\",\\n                    \\\"detail\\\": vet.stderr.strip().splitlines()[:3]}\\n        census = run_mask(mut.get(\\\"census_pkg\\\", pkg), mut[\\\"census_run\\\"])\\n        behav = run_mask(mut.get(\\\"behav_pkg\\\", pkg), mut[\\\"behav_run\\\"])\\n        killers = [name for name, res in ((\\\"census\\\", census), (\\\"behav\\\", behav))\\n                   if res[\\\"verdict\\\"] == \\\"KILLED\\\"]\\n        return {\\\"id\\\": mut[\\\"id\\\"], \\\"class\\\": mut[\\\"class\\\"],\\n                \\\"verdict\\\": \\\"KILLED\\\" if killers else \\\"SURVIVED\\\",\\n                \\\"killers\\\": killers, \\\"expect\\\": mut.get(\\\"expect\\\"),\\n                \\\"census\\\": census, \\\"behav\\\": behav}\\n    finally:\\n        with open(path, \\\"w\\\", encoding=\\\"utf-8\\\") as handle:\\n            handle.write(original)\\n        if sha(path) != before:\\n            print(\\\"!!! RESTORE FAILED for %s\\\" % path, file=sys.stderr)\\n            sys.exit(2)\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    muts = json.load(open(sys.argv[1]))\\n    out = []\\n    for item in muts:\\n        record = run(item)\\n        out.append(record)\\n        print(json.dumps(record), flush=True)\\n    summary = {v: sum(1 for r in out if r[\\\"verdict\\\"] == v)\\n               for v in (\\\"KILLED\\\", \\\"SURVIVED\\\", \\\"NOT_APPLIED\\\", \\\"COMPILE_FAIL\\\")}\\n    print(\\\"SUMMARY \\\" + json.dumps(summary), flush=True)\\n    with open(sys.argv[2], \\\"w\\\") as handle:\\n        json.dump({\\\"results\\\": out, \\\"summary\\\": summary}, handle, indent=2)\\n=== muts_tb ===\\n[\\n    {\\n        \\\"behav_run\\\": \\\"TestEveryDeclaredArmRefusesAtItsEntry\\\",\\n        \\\"census_run\\\": \\\"TestDerivedRefusalArmsAreAllDeclared|TestDeclaredRefusalArmsAreAllDerived\\\",\\n        \\\"class\\\": \\\"arm-deletion\\\",\\n        \\\"expect\\\": \\\"both kill: row orphaned and entry witness fails\\\",\\n        \\\"file\\\": \\\"internal/terminalbackend/terminalbackend.go\\\",\\n        \\\"id\\\": \\\"D-tb-resolve\\\",\\n        \\\"new\\\": \\\"\\\\t\\\\treturn Registration{}, nil\\\",\\n        \\\"old\\\": \\\"\\\\t\\\\treturn Registration{}, &Error{Code: CodeNotFound, BackendID: id, Detail: \\\\\\\"unregistered terminal_backend_id\\\\\\\"}\\\"\\n    },\\n    {\\n        \\\"behav_run\\\": \\\"TestEveryDeclaredArmRefusesAtItsEntry\\\",\\n        \\\"census_run\\\": \\\"TestDerivedRefusalArmsAreAllDeclared|TestDeclaredRefusalArmsAreAllDerived\\\",\\n        \\\"class\\\": \\\"narrowing\\\",\\n        \\\"expect\\\": \\\"census kills (integrityFailure arms leave the derivation); behav passes (production intact)\\\",\\n        \\\"file\\\": \\\"internal/terminalbackend/refusal_arm_inventory_test.go\\\",\\n        \\\"id\\\": \\\"N-tb-ctor\\\",\\n        \\\"new\\\": \\\"var constructorFunctions = map[string]bool{\\\\n\\\\t\\\\\\\"mismatchf\\\\\\\": true,\\\\n}\\\",\\n        \\\"old\\\": \\\"var constructorFunctions = map[string]bool{\\\\n\\\\t\\\\\\\"mismatchf\\\\\\\":        true,\\\\n\\\\t\\\\\\\"integrityFailure\\\\\\\": true,\\\\n}\\\"\\n    },\\n    {\\n        \\\"behav_run\\\": \\\"TestParseProviderDescriptorGeometryBounds|TestParseProviderDescriptorGeometryOverflowVectors\\\",\\n        \\\"census_run\\\": \\\"TestDigitGuard\\\",\\n        \\\"class\\\": \\\"narrowing\\\",\\n        \\\"expect\\\": \\\"census kills via the code-point pin; behav passes (classifier is static-only)\\\",\\n        \\\"file\\\": \\\"internal/terminalbackend/digit_guard_census_test.go\\\",\\n        \\\"id\\\": \\\"N-digit-int-spelling\\\",\\n        \\\"new\\\": \\\"\\\\tcase token.INT:\\\\n\\\\t\\\\treturn 0, false\\\",\\n        \\\"old\\\": \\\"\\\\tcase token.INT:\\\\n\\\\t\\\\tvalue, err := strconv.ParseInt(lit.Value, 0, 32)\\\\n\\\\t\\\\tif err != nil {\\\\n\\\\t\\\\t\\\\treturn 0, false\\\\n\\\\t\\\\t}\\\\n\\\\t\\\\tif value < '0' || value > '9' {\\\\n\\\\t\\\\t\\\\treturn 0, false\\\\n\\\\t\\\\t}\\\\n\\\\t\\\\treturn rune(value), true\\\"\\n    },\\n    {\\n        \\\"behav_run\\\": \\\"TestEveryDeclaredArmRefusesAtItsEntry\\\",\\n        \\\"census_run\\\": \\\"TestDerivedRefusalArmsAreAllDeclared|TestDeclaredRefusalArmsAreAllDerived\\\",\\n        \\\"class\\\": \\\"census-only\\\",\\n        \\\"expect\\\": \\\"census kills (undeclared derived arm); behav passes (dead code never runs)\\\",\\n        \\\"file\\\": \\\"internal/terminalbackend/terminalbackend.go\\\",\\n        \\\"id\\\": \\\"C-tb-dead-arm\\\",\\n        \\\"new\\\": \\\"\\\\tsum := sha256.Sum256(raw)\\\\n\\\\treturn \\\\\\\"sha256:\\\\\\\" + hex.EncodeToString(sum[:]), nil\\\\n}\\\\n\\\\nfunc deadArmProbe() *Error {\\\\n\\\\tif false {\\\\n\\\\t\\\\treturn &Error{Code: CodeNotFound, Detail: \\\\\\\"dead arm probe\\\\\\\"}\\\\n\\\\t}\\\\n\\\\treturn nil\\\\n}\\\",\\n        \\\"old\\\": \\\"\\\\tsum := sha256.Sum256(raw)\\\\n\\\\treturn \\\\\\\"sha256:\\\\\\\" + hex.EncodeToString(sum[:]), nil\\\\n}\\\"\\n    },\\n    {\\n        \\\"behav_run\\\": \\\"TestParseProviderDescriptorGeometryBounds|TestParseProviderDescriptorGeometryOverflowVectors\\\",\\n        \\\"census_run\\\": \\\"TestDigitGuard\\\",\\n        \\\"class\\\": \\\"token-preserving\\\",\\n        \\\"expect\\\": \\\"census passes (same digit tokens, same site key); behav kills (geometry values shift, bound arm rejects valid 1000)\\\",\\n        \\\"file\\\": \\\"internal/terminalbackend/descriptor.go\\\",\\n        \\\"id\\\": \\\"T-guard-accumulator\\\",\\n        \\\"new\\\": \\\"\\\\t\\\\tvalue = value*10 + int(digit-'0') + 1\\\",\\n        \\\"old\\\": \\\"\\\\t\\\\tvalue = value*10 + int(digit-'0')\\\"\\n    }\\n]\\n\",\n  \"original_output_bytes\": 7165,\n  \"original_output_tokens\": 1792,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
