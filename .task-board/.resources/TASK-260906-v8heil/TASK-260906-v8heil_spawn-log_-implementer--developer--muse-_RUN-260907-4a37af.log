position token.Pos) int {\n153|\t\t\treturn fileSet.Position(position).Line\n154|\t\t}\n155|\t\t// errorLiteral reads one &Error{Code:, Detail:} literal into its\n156|\t\t// static code symbol and detail. Anything else fails the\n157|\t\t// derivation: a refusal the inventory cannot name is a refusal it\n158|\t\t// cannot witness.\n159|\t\terrorLiteral := func(functionName string, literal *ast.CompositeLit) (string, string) {\n160|\t\t\tidentifier, ok := literal.Type.(*ast.Ident)\n161|\t\t\tif !ok || identifier.Name != \"Error\" {\n162|\t\t\t\tt.Fatalf(\"%s: refuse wraps a non-Error literal; only &Error literals route through refuse\", functionName)\n163|\t\t\t}\n164|\t\t\tcode, detail := \"\", \"\"\n165|\t\t\tfor _, element := range literal.Elts {\n166|\t\t\t\tpair, ok := element.(*ast.KeyValueExpr)\n167|\t\t\t\tif !ok {\n168|\t\t\t\t\tcontinue\n169|\t\t\t\t}\n170|\t\t\t\tkey, ok := pair.Key.(*ast.Ident)\n171|\t\t\t\tif !ok {\n172|\t\t\t\t\tcontinue\n173|\t\t\t\t}\n174|\t\t\t\tswitch key.Name {\n175|\t\t\t\tcase \"Code\":\n176|\t\t\t\t\tsymbol, ok := pair.Value.(*ast.Ident)\n177|\t\t\t\t\tif !ok {\n178|\t\t\t\t\t\tt.Fatalf(\"%s: refusal code is not a static Code symbol; \"+\n179|\t\t\t\t\t\t\t\"a computed code cannot be inventoried\", functionName)\n180|\t\t\t\t\t}\n181|\t\t\t\t\tcode = symbol.Name\n182|\t\t\t\tcase \"Detail\":\n183|\t\t\t\t\tdetail = staticDetail(t, functionName, pair.Value)\n184|\t\t\t\t}\n185|\t\t\t}\n186|\t\t\tif code == \"\" || detail == \"\" {\n187|\t\t\t\tt.Fatalf(\"%s: refusal without a static code and detail; \"+\n188|\t\t\t\t\t\"the inventory cannot name what it cannot read\", functionName)\n189|\t\t\t}\n190|\t\t\treturn code, detail\n191|\t\t}\n192|\t\tcollect := func(functionName string, root ast.Node) {\n193|\t\t\tast.Inspect(root, func(node ast.Node) bool {\n(more lines below)"}}}
