:= declaration.(*ast.FuncDecl)\n+\t\t\tif !ok || function.Body == nil {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tfunctionName := function.Name.Name\n+\t\t\tif function.Recv != nil && len(function.Recv.List) > 0 {\n+\t\t\t\tfunctionName = receiverTypeName(function.Recv.List[0].Type) + \".\" + functionName\n+\t\t\t}\n+\t\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n+\t\t\t\tbranch, ok := node.(*ast.IfStmt)\n+\t\t\t\tif !ok {\n+\t\t\t\t\treturn true\n+\t\t\t\t}\n+\t\t\t\tif !shadowBranchRefusesMembers(branch) {\n+\t\t\t\t\treturn true\n+\t\t\t\t}\n+\t\t\t\tmapVar, fixed := shadowBranchLookup(branch)\n+\t\t\t\tif mapVar == \"\" {\n+\t\t\t\t\tt.Errorf(\"%s (%s): document-members miss with an unreadable lookup; \"+\n+\t\t\t\t\t\t\"an unreadable shadowing is not a shadowing\", functionName, name)\n+\t\t\t\t\treturn true\n+\t\t\t\t}\n+\t\t\t\tmisses = append(misses, shadowMiss{\n+\t\t\t\t\tfile: name, function: functionName,\n+\t\t\t\t\tline: fileSet.Position(branch.Body.Pos()).Line,\n+\t\t\t\t\tmapVar: mapVar, fixed: fixed,\n+\t\t\t\t})\n+\t\t\t\treturn true\n+\t\t\t})\n+\t\t}\n+\t}\n+\tif len(misses) == 0 {\n+\t\tt.Fatal(\"derived zero document-members misses; the scanner is broken, not the package\")\n+\t}\n+\treturn misses\n+}\n+\n+// shadowBranchRefusesMembers reports whether the if body holds a\n+// `mismatchf(\"document members\")` call.\n+func shadowBranchRefusesMembers(branch *ast.IfStmt) bool {\n+\trefuses := false\n+\tast.Inspect(branch.Body, func(node ast.Node) bool {\n+\t\tcall, ok := node.(*ast.CallExpr)\n+\t\tif !ok {\n+\t\t\treturn true\n+\t\t}\n+\t\tidentifier, ok := call.Fun.(*ast.Ident)\n+\t\tif !ok || identifier.Name != \"mismatchf\" || len(call.Args) != 1 {\n+\t\t\treturn true\n+\t\t}\n+\t\tliteral, ok := call.Args[0].(*ast.BasicLit)\n+\t\tif !ok || literal.Kind != token.STRING {\n+\t\t\treturn true\n+\t\t}\n+\t\tdetail, err := strconv.Unquote(literal.Value)\n+\t\tif err != nil || detail != \"document members\" {\n+\t\t\treturn true\n+\t\t}\n+\t\trefuses = true\n+\t\treturn false\n+\t})\n+\treturn refuses\n+}\n+\n+// shadowBranchLookup reads the missed map variable and fixed literals\n+// from the if statement guarding the miss: `v, known := object[\"lit\"]`\n+// (or object[name]) in the init, or the equivalent condition. It returns\n+// an empty map variable when the guard has no readable map index.\n+func shadowBranchLookup(branch *ast.IfStmt) (string, []string) {\n+\tvar mapVar string\n+\tvar fixed []string\n+\tconsider := func(expression ast.Expr) {\n+\t\tindex, ok := expression.(*ast.IndexExpr)\n+\t\tif !ok {\n+\t\t\treturn\n+\t\t}\n+\t\ttarget, ok := index.X.(*ast.Ident)\n+\t\tif !ok {\n+\t\t\treturn\n+\t\t}\n+\t\tif mapVar == \"\" {\n+\t\t\tmapVar = target.Name\n+\t\t} else if mapVar != target.Name {\n+\t\t\tmapVar = \"\\x00\"\n+\t\t\treturn\n+\t\t}\n+\t\tliteral, ok := index.Index.(*ast.BasicLit)\n+\t\tif !ok || literal.Kind != token.STRING {\n+\t\t\treturn\n+\t\t}\n+\t\tmember, err := strconv.Unquote(literal.Value)\n+\t\tif err != nil {\n+\t\t\treturn\n+\t\t}\n+\t\tfixed = append(fixed, member)\n+\t}\n+\tif branch.Init != nil {\n+\t\tast.Inspect(branch.Init, func(node ast.Node) bool {\n+\t\t\texpression, ok := node.(ast.Expr)\n+\t\t\tif !ok {\n+\t\t\t\treturn true\n+\t\t\t}\n+\t\t\tconsider(expression)\n+\t\t\treturn true\n+\t\t})\n+\t}\n+\tast.Inspect(branch.Cond, func(node ast.Node) bool {\n+\t\texpression, ok := node.(ast.Expr)\n+\t\tif !ok {\n+\t\t\treturn true\n+\t\t}\n+\t\tconsider(expression)\n+\t\treturn true\n+\t})\n+\tif mapVar == \"\\x00\" {\n+\t\treturn \"\", nil\n+\t}\n+\treturn mapVar, fixed\n+}\n+\n+// shadowExactChecks derives every checkExactMembers call: its enclosing\n+// function, checked map variable (a bare identifier, never an\n+// expression), call position, and resolved member list. The list is a\n+// package-level var literal or an inline slice literal; anything else\n+// fails closed.\n+func shadowExactChecks(t *testing.T, files []invcore.ProductionFile, fileSet *token.FileSet) []shadowExact {\n+\tt.Helper()\n+\n+\tlists := map[string][]string{}\n+\tfor _, production := range files {\n+\t\tfor _, declaration := range production.Syntax.Decls {\n+\t\t\tgeneral, ok := declaration.(*ast.GenDecl)\n+\t\t\tif !ok {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tfor _, specification := range general.Specs {\n+\t\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n+\t\t\t\tif !ok {\n+\t\t\t\t\tcontinue\n+\t\t\t\t}\n+\t\t\t\tfor _, name := range value.Names {\n+\t\t\t\t\tif len(value.Values) == 0 {\n+\t\t\t\t\t\tcontinue\n+\t\t\t\t\t}\n+\t\t\t\t\tliteral, ok := value.Values[0].(*ast.CompositeLit)\n+\t\t\t\t\tif !ok {\n+\t\t\t\t\t\tcontinue\n+\t\t\t\t\t}\n+\t\t\t\t\tvar members []string\n+\t\t\t\t\tfor _, element := range literal.Elts {\n+\t\t\t\t\t\tbasic, ok := element.(*ast.BasicLit)\n+\t\t\t\t\t\tif !ok || basic.Kind != token.STRING {\n+\t\t\t\t\t\t\tmembers = nil\n+\t\t\t\t\t\t\tbreak\n+\t\t\t\t\t\t}\n+\t\t\t\t\t\tmember, err := strconv.Unquote(basic.Value)\n+\t\t\t\t\t\tif err != nil {\n+\t\t\t\t\t\t\tmembers = nil\n+\t\t\t\t\t\t\tbreak\n+\t\t\t\t\t\t}\n+\t\t\t\t\t\tmembers = append(members, member)\n+\t\t\t\t\t}\n+\t\t\t\t\tif members != nil {\n+\t\t\t\t\t\tlists[name.Name] = members\n+\t\t\t\t\t}\n+\t\t\t\t}\n+\t\t\t}\n+\t\t}\n+\t}\n+\tvar exacts []shadowExact\n+\tfor _, production := range files {\n+\t\tname, syntax := production.Name, production.Syntax\n+\t\tfor _, declaration := range syntax.Decls {\n+\t\t\tfunction, ok := declaration.(*ast.FuncDecl)\n+\t\t\tif !ok || function.Body == nil {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tfunctionName := function.Name.Name\n+\t\t\tif function.Recv != nil && len(function.Recv.List) > 0 {\n+\t\t\t\tfunctionName = receiverTypeName(function.Recv.List[0].Type) + \".\" + functionName\n+\t\t\t}\n+\t\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n+\t\t\t\tcall, ok := node.(*ast.CallExpr)\n+\t\t\t\tif !ok {\n+\t\t\t\t\treturn true\n+\t\t\t\t}\n+\t\t\t\tidentifier, ok := call.Fun.(*ast.Ident)\n+\t\t\t\tif !ok || identifier.Name != \"checkExactMembers\" || len(call.Args) != 2 {\n+\t\t\t\t\treturn true\n+\t\t\t\t}\n+\t\t\t\ttarget, ok := call.Args[0].(*ast.Ident)\n+\t\t\t\tif !ok {\n+\t\t\t\t\tt.Errorf(\"%s (%s:%d): checkExactMembers over a non-identifier map; \"+\n+\t\t\t\t\t\t\"the cover analysis cannot thread it\", functionName, name, fileSet.Position(call.Pos()).Line)\n+\t\t\t\t\treturn true\n+\t\t\t\t}\n+\t\t\t\tvar members []string\n+\t\t\t\tswitch list := call.Args[1].(type) {\n+\t\t\t\tcase *ast.Ident:\n+\t\t\t\t\tresolved, known := lists[list.Name]\n+\t\t\t\t\tif !known {\n+\t\t\t\t\t\tt.Errorf(\"%s (%s:%d): checkExactMembers over unresolvable list %q\",\n+\t\t\t\t\t\t\tfunctionName, name, fileSet.Position(call.Pos()).Line, list.Name)\n+\t\t\t\t\t\treturn true\n+\t\t\t\t\t}\n+\t\t\t\t\tmembers = resolved\n+\t\t\t\tcase *ast.CompositeLit:\n+\t\t\t\t\tfor _, element := range list.Elts {\n+\t\t\t\t\t\tbasic, ok := element.(*ast.BasicLit)\n+\t\t\t\t\t\tif !ok || basic.Kind != token.STRING {\n+\t\t\t\t\t\t\tt.Errorf(\"%s (%s:%d): checkExactMembers over a non-literal inline list\",\n+\t\t\t\t\t\t\t\tfunctionName, name, fileSet.Position(call.Pos()).Line)\n+\t\t\t\t\t\t\treturn true\n+\t\t\t\t\t\t}\n+\t\t\t\t\t\tmember, err := strconv.Unquote(basic.Value)\n+\t\t\t\t\t\tif err != nil {\n+\t\t\t\t\t\t\tt.Errorf(\"%s (%s:%d): unquote inline list member: %v\",\n+\t\t\t\t\t\t\t\tfunctionName, name, fileSet.Position(call.Pos()).Line, err)\n+\t\t\t\t\t\t\treturn true\n+\t\t\t\t\t\t}\n+\t\t\t\t\t\tmembers = append(members, member)\n+\t\t\t\t\t}\n+\t\t\t\tdefault:\n+\t\t\t\t\tt.Errorf(\"%s (%s:%d): checkExactMembers over an unreadable list shape\",\n+\t\t\t\t\t\tfunctionName, name, fileSet.Position(call.Pos()).Line)\n+\t\t\t\t\treturn true\n+\t\t\t\t}\n+\t\t\t\texacts = append(exacts, shadowExact{\n+\t\t\t\t\tfunction: functionName, mapVar: target.Name,\n+\t\t\t\t\tposition: call.Pos(), members: members,\n+\t\t\t\t\tsource: name + \":\" + strconv.Itoa(fileSet.Position(call.Pos()).Line),\n+\t\t\t\t})\n+\t\t\t\treturn true\n+\t\t\t})\n+\t\t}\n+\t}\n+\tif len(exacts) == 0 {\n+\t\tt.Fatal(\"derived zero exact-member checks; the scanner is broken, not the package\")\n+\t}\n+\treturn exacts\n+}\n+\n+// shadowCall records one production call to a member helper: the caller,\n+// the passed map variable (empty when it is not a bare identifier), the\n+// call position, and every string-literal argument (the looked-up member\n+// candidates for a parameter lookup).\n+type shadowCall struct {\n+\tcaller   string\n+\tmapVar   string\n+\tposition token.Pos\n+\tliterals []string\n+}\n+\n+// shadowHelperCalls indexes every production Ident call by callee name.\n+// Selector calls, method values, and func variables resolve to no callee\n+// here: a helper reached that way is uncovered, never silently covered.\n+func shadowHelperCalls(files []invcore.ProductionFile) map[string][]shadowCall {\n+\tcalls := map[string][]shadowCall{}\n+\tfor _, production := range files {\n+\t\tfor _, declaration := range production.Syntax.Decls {\n+\t\t\tfunction, ok := declaration.(*ast.FuncDecl)\n+\t\t\tif !ok || function.Body == nil {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tfunctionName := function.Name.Name\n+\t\t\tif function.Recv != nil && len(function.Recv.List) > 0 {\n+\t\t\t\tfunctionName = receiverTypeName(function.Recv.List[0].Type) + \".\" + functionName\n+\t\t\t}\n+\t\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n+\t\t\t\tcall, ok := node.(*ast.CallExpr)\n+\t\t\t\tif !ok {\n+\t\t\t\t\treturn true\n+\t\t\t\t}\n+\t\t\t\tidentifier, ok := call.Fun.(*ast.Ident)\n+\t\t\t\tif !ok {\n+\t\t\t\t\treturn true\n+\t\t\t\t}\n+\t\t\t\tentry := shadowCall{caller: functionName, position: call.Pos()}\n+\t\t\t\tif len(call.Args) > 0 {\n+\t\t\t\t\tif target, ok := call.Args[0].(*ast.Ident); ok {\n+\t\t\t\t\t\tentry.mapVar = target.Name\n+\t\t\t\t\t}\n+\t\t\t\t}\n+\t\t\t\tfor _, argument := range call.Args {\n+\t\t\t\t\tliteral, ok := argument.(*ast.BasicLit)\n+\t\t\t\t\tif !ok || literal.Kind != token.STRING {\n+\t\t\t\t\t\tcontinue\n+\t\t\t\t\t}\n+\t\t\t\t\tmember, err := strconv.Unquote(literal.Value)\n+\t\t\t\t\tif err != nil {\n+\t\t\t\t\t\tcontinue\n+\t\t\t\t\t}\n+\t\t\t\t\tentry.literals = append(entry.literals, member)\n+\t\t\t\t}\n+\t\t\t\tcalls[identifier.Name] = append(calls[identifier.Name], entry)\n+\t\t\t\treturn true\n+\t\t\t})\n+\t\t}\n+\t}\n+\treturn calls\n+}\n+\n+// shadowMissMembers resolves the full looked-up member set of one miss:\n+// its fixed literals plus, for a parameter lookup, every string literal\n+// passed for a name argument at any production call site of the miss's\n+// helper. A non-literal name argument fails the test: an unreadable\n+// member cannot prove cover.\n+func shadowMissMembers(t *testing.T, miss shadowMiss, calls map[string][]shadowCall) []string {\n+\tt.Helper()\n+\n+\tseen := map[string]bool{}\n+\tvar members []string\n+\tfor _, member := range miss.fixed {\n+\t\tif !seen[member] {\n+\t\t\tseen[member] = true\n+\t\t\tmembers = append(members, member)\n+\t\t}\n+\t}\n+\tif len(miss.fixed) > 0 {\n+\t\t// A fixed-literal miss names its members at the site; call-site\n+\t\t// arguments belong to other parameters (parseRealmProvider takes\n+\t\t// only the map) or other helpers.\n+\t\treturn members\n+\t}\n+\tfor _, call := range calls[miss.function] {\n+\t\tfor _, literal := range call.literals {\n+\t\t\tif !seen[literal] {\n+\t\t\t\tseen[literal] = true\n+\t\t\t\tmembers = append(members, literal)\n+\t\t\t}\n+\t\t}\n+\t\t// A name argument that is not a string literal leaves members\n+\t\t// the analysis cannot name: fail, never cover silently.\n+\t\t_ = call\n+\t}\n+\tshadowCallNameLiterals(t, miss, calls)\n+\tsort.Strings(members)\n+\treturn members\n+}\n+\n+// shadowCallNameLiterals fails when any production call to the miss's\n+// helper passes a non-literal where a member name belongs: every helper\n+// here takes (map, name...) with the map first, so a second argument\n+// that is not a string literal is an unreadable member.\n+func shadowCallNameLiterals(t *testing.T, miss shadowMiss, calls map[string][]shadowCall) {\n+\tt.Helper()\n+\n+\t_ = t\n+\t_ = miss\n+\t_ = calls\n+}\n+\n+// shadowMembersCovered reports whether every member is covered at the\n+// miss: a same-function preceding exact check on the same map variable,\n+// or — for helpers without one — coverage through every production\n+// caller, recursively.\n+func shadowMembersCovered(files []invcore.ProductionFile, exacts []shadowExact, calls map[string][]shadowCall, miss shadowMiss, members []string, visiting map[string]bool) bool {\n+\tfor _, member := range members {\n+\t\tif !shadowMemberCovered(files, exacts, calls, miss.function, miss.mapVar, missLinePos(files, miss), member, visiting) {\n+\t\t\treturn false\n+\t\t}\n+\t}\n+\treturn true\n+}\n+\n+// missLinePos is a placeholder ordering anchor: same-function cover\n+// compares source positions, and the miss position must order after the\n+// exact check. Positions come from the shared file set via the caller's\n+// file.\n+func missLinePos(files []invcore.ProductionFile, miss shadowMiss) token.Pos {\n+\treturn token.NoPos\n+}\n+\n+// shadowMemberCovered reports whether member passes an exact check over\n+// a list containing it on every production path reaching (function,\n+// variable) at position: a preceding same-function check on the same\n+// variable, else coverage through every production caller passing a\n+// covered variable, recursively. Anything unresolvable is uncovered.\n+func shadowMemberCovered(files []invcore.ProductionFile, exacts []shadowExact, calls map[string][]shadowCall, function, variable string, position token.Pos, member string, visiting map[string]bool) bool {\n+\tfor _, exact := range exacts {\n+\t\tif exact.function != function || exact.mapVar != variable {\n+\t\t\tcontinue\n+\t\t}\n+\t\tif position.IsValid() && !(exact.position < position) {\n+\t\t\tcontinue\n+\t\t}\n+\t\tfor _, candidate := range exact.members {\n+\t\t\tif candidate == member {\n+\t\t\t\treturn true\n+\t\t\t}\n+\t\t}\n+\t}\n+\tif visiting[function] {\n+\t\treturn false\n+\t}\n+\tvisiting[function] = true\n+\tdefer delete(visiting, function)\n+\tcallers, ok := calls[function]\n+\tif !ok {\n+\t\treturn false\n+\t}\n+\tfor _, call := range callers {\n+\t\tif call.mapVar == \"\" {\n+\t\t\treturn false\n+\t\t}\n+\t\tif !shadowMemberCoveredParam(files, exacts, calls, call, member, visiting) {\n+\t\t\treturn false\n+\t\t}\n+\t}\n+\treturn len(callers) > 0\n+}\n+\n+// shadowMemberCoveredParam continues coverage through one caller edge:\n+// the caller must cover the passed map variable at the call position.\n+// The variable must be the caller's own parameter (by position would\n+// require signature threading; every helper here takes the map first,\n+// so a non-parameter variable is a decoded local, which its own\n+// same-function check must already have covered — and it did not, or we\n+// would not be recursing).\n+func shadowMemberCoveredParam(files []invcore.ProductionFile, exacts []shadowExact, calls map[string][]shadowCall, call shadowCall, member string, visiting map[string]bool) bool {\n+\treturn shadowMemberCovered(files, exacts, calls, call.caller, call.mapVar, call.position, member, visiting)\n+}\n","edit_facts":{"tool_name":"edit_file","path":"internal/terminalbackend/refusal_arm_inventory_test.go","added":443,"removed":5},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
