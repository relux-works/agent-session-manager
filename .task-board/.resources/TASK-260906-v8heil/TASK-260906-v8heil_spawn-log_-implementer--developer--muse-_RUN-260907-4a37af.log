olError\", \"descriptor member set\", 2, \"ParseProviderDescriptor\", \"\", nil},\n675|\t{\"descriptor.go\", \"ParseProviderDescriptor\", \"CodeProtocolError\", \"descriptor digest\", 1, \"ParseProviderDescriptor\", \"\", nil},\n676|\t{\"descriptor.go\", \"ParseProviderDescriptor\", \"CodeProtocolError\", \"descriptor instance\", 1, \"ParseProviderDescriptor\", \"\", nil},\n677|\t{\"descriptor.go\", \"ParseProviderDescriptor\", \"CodeProtocolError\", \"descriptor implementation version\", 1, \"ParseProviderDescriptor\", \"\", nil},\n678|\t{\"descriptor.go\", \"ParseProviderDescriptor\", \"CodeProtocolError\", \"descriptor protocol version\", 1, \"ParseProviderDescriptor\", \"\", nil},\n679|\t{\"descriptor.go\", \"ParseProviderDescriptor\", \"CodeProtocolError\", \"descriptor interactive\", 1, \"ParseProviderDescriptor\", \"\", nil},\n680|\t{\"descriptor.go\", \"descriptorText\", \"CodeProtocolError\", \"descriptor member type\", 1, \"ParseProviderDescriptor\", \"\", nil},\n681|\t{\"descriptor.go\", \"descriptorGeometry\", \"CodeProtocolError\", \"descriptor geometry type\", 1, \"ParseProviderDescriptor\", \"\", nil},\n682|\t{\"descriptor.go\", \"descriptorGeometry\", \"CodeProtocolError\", \"descriptor geometry digits\", 1, \"ParseProviderDescriptor\", \"\", nil},\n683|\t{\"descriptor.go\", \"descriptorGeometry\", \"CodeProtocolError\", \"descriptor geometry bound\", 1, \"ParseProviderDescriptor\", \"\", nil},\n684|\t{\"descriptor.go\", \"descriptorGeometry\", \"CodeProtocolError\", \"descriptor geometry bound\", 2, \"ParseProviderDescriptor\", \"\", nil},\n685|}\n686|\n687|// funneledPlatformDetails is the exact error set validatePlatforms can\n688|// produce, funneled through the single Registration.validate arm below.\n689|// TestPlatformFunnelDetailsAreExactlyThese derives the set from the\n690|// production AST and requires equality, so a fourth platform error is a\n691|// red rather than a silently widened funnel.\n692|var funneledPlatformDetails = []string{\n693|\t\"platforms bound\",\n694|\t\"platforms vocabulary\",\n695|\t\"platforms sorted unique\",\n696|}\n697|\n698|// funneledPlatformArm declares the single dynamic-detail arm. Its tests\n699|// must mention every funneled detail, not just one of them.\n700|var funneledPlatformArm = declaredRefusalArm{\n701|\tfile: \"terminalbackend.go\", function: \"Registration.validate\",\n702|\tcode: \"CodeNotFound\", detail: passthroughDetail, occurrence: 1,\n703|\tentry: \"RegisterExternal\",\n704|}\n705|\n706|// armlessCodes names wire codes with no refusal arm by design.\n707|// CodeUnavailable appears only inside the allowed-error sets; no\n708|// conformance refusal emits it, so it carries no arm of its own.\n709|var armlessCodes = map[string]bool{\n710|\t\"CodeUnavailable\": true,\n711|}\n712|\n713|// plainErrorFunctions names the only production functions allowed to\n714|// construct non-wire errors. validatePlatforms feeds the pinned funnel;\n715|// DigestFile reports I/O failures that must never be wire errors.\n716|var plainErrorFunctions = map[string]bool{\n717|\t\"validatePlatforms\": true,\n718|\t\"DigestFile\":        true,\n719|}\n720|\n721|// armInventoryKeys renders derived arms and declared rows into one shared\n722|// key space for the core both-direction harness.\n723|func armInventoryKeys(derived []refusalArm, rows []declaredRefusalArm) (map[string]struct{}, map[string]struct{}) {\n724|\tderivedKeys := make(map[string]struct{}, len(derived))\n725|\tfor _, arm := range derived {\n726|\t\tderivedKeys[describeArm(arm)] = struct{}{}\n727|\t}\n728|\trowKeys := make(map[string]struct{}, len(rows))\n729|\tfor _, row := range rows {\n730|\t\tkey := describeRow(row)\n731|\t\tif _, duplicate := rowKeys[key]; duplicate {\n732|\t\t\trowKeys[\"DUPLICATE-ROW:\"+key] = struct{}{}\n733|\t\t}\n734|\t\trowKeys[key] = struct{}{}\n735|\t}\n736|\treturn derivedKeys, rowKeys\n737|}\n738|\n739|// TestDerivedRefusalArmsAreAllDeclared is the forward direction: every\n740|// arm the production AST derives resolves to exactly one declared row.\n741|// A brand-new arm with a brand-new detail fails here until its witness\n742|// is recorded.\n743|func TestDerivedRefusalArmsAreAllDeclared(t *testing.T) {\n744|\tt.Parallel()\n745|\n746|\tderived, rows := armInventoryKeys(deriveRefusalArms(t), declaredRows())\n747|\tinvcore.MustCheckBothDirections(t, \"refusal-arm inventory\", derived, rows)\n748|}\n749|\n750|// TestDeclaredRefusalArmsAreAllDerived is the reverse direction: every\n751|// declared row resolves to exactly one derived arm. Without it the\n752|// forward direction passes vacuously on a truncated derivation, and a\n753|// deleted production guard lingers as a row pointing at nothing.\n754|func TestDeclaredRefusalArmsAreAllDerived(t *testing.T) {\n755|\tt.Parallel()\n756|\n757|\tderived, rows := armInventoryKeys(deriveRefusalArms(t), declaredRows())\n758|\tinvcore.MustCheckBothDirections(t, \"refusal-arm inventory\", derived, rows)\n759|}\n760|\n761|func armMatchesRow(arm refusalArm, row declaredRefusalArm) bool {\n762|\treturn arm.file == row.file && arm.function == row.function &&\n763|\t\tarm.code == row.code && arm.detail == row.detail &&\n764|\t\tarm.occurrence == row.occurrence\n765|}\n766|\n767|func describeArm(arm refusalArm) string {\n768|\treturn arm.file + \" \" + arm.function + \" \" + arm.code + \" \" +\n769|\t\tstrconv.Quote(arm.detail) + \" #\" + strconv.Itoa(arm.occurrence)\n770|}\n771|\n772|func describeRow(row declaredRefusalArm) string {\n773|\treturn row.file + \" \" + row.function + \" \" + row.code + \" \" +\n774|\t\tstrconv.Quote(row.detail) + \" #\" + strconv.Itoa(row.occurrence)\n775|}\n776|\n777|// declaredRows returns the table plus the funnel row.\n778|func declaredRows() []declaredRefusalArm {\n779|\trows := append([]declaredRefusalArm(nil), declaredRefusalArms...)\n780|\tfunnel := funneledPlatformArm\n781|\tfunnel.detailSet = funneledPlatformDetails\n782|\treturn append(rows, funnel)\n783|}\n784|\n785|// ArmIdentity is the export bridge to the executed-witness registry in\n786|// refusal_arm_witnesses_test.go (package terminalbackend_test): one row\n787|// identity with the entry its witness drives, its bound (empty except\n788|// for arms no input can reach), and the funneled detail set for the\n789|// single dynamic-detail row.\n790|type ArmIdentity struct {\n791|\tFile       string\n792|\tFunction   string\n793|\tCode       string\n794|\tDetail     string\n795|\tOccurrence int\n796|\tEntry      string\n797|\tBound      string\n798|\tDetailSet  []string\n799|}\n800|\n801|// DeclaredArmIdentities exports every declared row identity for the\n802|// witness registry's reverse direction.\n803|func DeclaredArmIdentities() []ArmIdentity {\n804|\trows := declaredRows()\n805|\tidentities := make([]ArmIdentity, 0, len(rows))\n806|\tfor _, row := range rows {\n807|\t\tidentities = append(identities, ArmIdentity{\n808|\t\t\tFile: row.file, Function: row.function, Code: row.code,\n809|\t\t\tDetail: row.detail, Occurrence: row.occurrence,\n810|\t\t\tEntry: row.entry, Bound: row.bound, DetailSet: row.detailSet,\n811|\t\t})\n812|\t}\n813|\treturn identities\n814|}\n815|\n816|// DerivedArmIdentities exports every derived arm identity for the\n817|// witness registry's forward direction.\n818|func DerivedArmIdentities(t *testing.T) []ArmIdentity {\n819|\tt.Helper()\n820|\tderived := deriveRefusalArms(t)\n821|\tidentities := make([]ArmIdentity, 0, len(derived))\n822|\tfor _, arm := range derived {\n823|\t\tidentities = append(identities, ArmIdentity{\n824|\t\t\tFile: arm.file, Function: arm.function, Code: arm.code,\n825|\t\t\tDetail: arm.detail, Occurrence: arm.occurrence,\n826|\t\t})\n827|\t}\n828|\treturn identities\n829|}\n830|\n831|// ArmKey renders one identity in the shared witness key space.\n832|func ArmKey(identity ArmIdentity) string {\n833|\treturn identity.File + \"|\" + identity.Function + \"|\" + identity.Code + \"|\" +\n834|\t\tstrconv.Quote(identity.Detail) + \"#\" + strconv.Itoa(identity.Occurrence)\n835|}\n836|\n837|// TestDeclaredRefusalWiresMatchProductionConsts binds the table to the\n838|// production const values two ways: every row's code resolves to the\n839|// wire its test asserts, and every Code symbol except the named armless\n840|// one appears in at least one row, so a code nobody refuses is a red\n841|// rather than a quiet gap.\n842|func TestDeclaredRefusalWiresMatchProductionConsts(t *testing.T) {\n843|\tt.Parallel()\n844|\n845|\tsymbols := productionCodeSymbols(t)\n846|\tcovered := make(map[string]bool)\n847|\tfor _, row := range declaredRows() {\n848|\t\twire, known := symbols[row.code]\n849|\t\tif !known {\n850|\t\t\tt.Errorf(\"declared row %s names unknown code symbol %q\",\n851|\t\t\t\tdescribeRow(row), row.code)\n852|\t\t\tcontinue\n853|\t\t}\n854|\t\tcovered[row.code] = true\n855|\t\t_ = wire\n856|\t}\n857|\tfor symbol := range symbols {\n858|\t\tif armlessCodes[symbol] {\n859|\t\t\tcontinue\n860|\t\t}\n861|\t\tif !covered[symbol] {\n862|\t\t\tt.Errorf(\"code symbol %s has no refusal arm; a wire code nothing refuses is unwitnessed\", symbol)\n863|\t\t}\n864|\t}\n865|}\n866|\n867|// TestDefensiveBoundsAreExactlyThese pins the set of bound rows: a new\n868|// defensive arm must join this set deliberately, with its bound stated,\n869|// rather than slipping in as an ordinary row whose test cannot reach it.\n870|func TestDefensiveBoundsAreExactlyThese(t *testing.T) {\n871|\tt.Parallel()\n872|\n873|\twant := map[string]string{\n874|\t\t\"conformance.go ParseAttachAuthorization CodeMismatch \\\"document timestamp\\\" #1\":           boundDefensiveReparse,\n875|\t\t\"conformance.go ParseAttachAuthorization CodeMismatch \\\"document timestamp\\\" #2\":           boundDefensiveReparse,\n876|\t\t\"conformance.go CheckAttachRequest CodeMismatch \\\"document timestamp\\\" #1\":                 boundDefensiveReparse,\n877|\t\t\"manifest.go ParseEvidence CodeMismatch \\\"document timestamp\\\" #1\":                    