rsion\\\"] = \\\"1.2.0\\\"\\n\\t\\t\\t\\t\\t\\tfinalizeEvidence(t, universe.key, object)\\n\\t\\t\\t\\t\\t}\\n\\t\\t\\t\\t\\tfinalizeProbeIDs(t, universe)\\n\\t\\t\\t\\t}, codeMismatch, \\\"probe protocol membership\\\")''')\\nrep('''universe.probe[\\\"platform\\\"] = \\\"wsl2\\\"\\n\\t\\t\\t\\t\\tfinalizeProbeIDs(t, universe)\\n\\t\\t\\t\\t}, codeMismatch, \\\"probe platform membership\\\")''',\\n'''universe.probe[\\\"platform\\\"] = \\\"windows\\\"\\n\\t\\t\\t\\t\\tfor _, object := range universe.evidenceByCap {\\n\\t\\t\\t\\t\\t\\tobject[\\\"platform\\\"] = \\\"windows\\\"\\n\\t\\t\\t\\t\\t\\tfinalizeEvidence(t, universe.key, object)\\n\\t\\t\\t\\t\\t}\\n\\t\\t\\t\\t\\tfinalizeProbeIDs(t, universe)\\n\\t\\t\\t\\t}, codeMismatch, \\\"probe platform membership\\\")''')\\n\\n# tuple: drift the evidence generation, re-signing (probe drift hits generation first)\\nrep('''universe.probe[\\\"backend_generation_digest\\\"] = testSeedDigest(0xB0)\\n\\t\\t\\t\\t\\tfinalizeProbeIDs(t, universe)\\n\\t\\t\\t\\t}, codeMismatch, \\\"evidence tuple binding\\\")''',\\n'''object := universe.evidenceByCap[\\\"graceful_stop\\\"]\\n\\t\\t\\t\\t\\tobject[\\\"backend_generation_digest\\\"] = testSeedDigest(0x99)\\n\\t\\t\\t\\t\\tfinalizeEvidence(t, universe.key, object)\\n\\t\\t\\t\\t\\tfinalizeProbeIDs(t, universe)\\n\\t\\t\\t\\t}, codeMismatch, \\\"evidence tuple binding\\\")''')\\n\\n# claim binding: mint local_attach evidence (re-stamping IDs alone breaks attestation first)\\nrep('''finalizeProbeIDs(t, universe)\\n\\t\\t\\t\\t\\tfor _, evidence := range universe.evidenceByCap {\\n\\t\\t\\t\\t\\t\\tevidence[\\\"capability\\\"] = \\\"graceful_stop\\\"\\n\\t\\t\\t\\t\\t\\tevidence[\\\"value\\\"] = true\\n\\t\\t\\t\\t\\t\\tevidence[\\\"evidence_id\\\"] = testIdentity(t, evidence, \\\"evidence_id\\\")\\n\\t\\t\\t\\t\\t}\\n\\t\\t\\t\\t}, codeMismatch, \\\"evidence claim binding\\\")''',\\n'''object := universe.evidenceMap(\\\"local_attach\\\", []any{\\\"fixture_passed\\\", \\\"policy_checked\\\", \\\"runtime_probe_passed\\\"})\\n\\t\\t\\t\\t\\tfinalizeEvidence(t, universe.key, object)\\n\\t\\t\\t\\t\\tuniverse.evidenceByCap[\\\"local_attach\\\"] = object\\n\\t\\t\\t\\t\\tfinalizeProbeIDs(t, universe)\\n\\t\\t\\t\\t}, codeMismatch, \\\"evidence claim binding\\\")''')\\n\\n# liveness: move both instants + re-sign (expiry alone breaks identity first)\\nrep('''for _, evidence := range universe.evidenceByCap {\\n\\t\\t\\t\\t\\t\\tevidence[\\\"expires_at\\\"] = \\\"2026-01-01T00:00:00.000Z\\\"\\n\\t\\t\\t\\t\\t}\\n\\t\\t\\t\\t\\tfinalizeProbeIDs(t, universe)\\n\\t\\t\\t\\t}, codeMismatch, \\\"evidence liveness\\\")''',\\n'''object := universe.evidenceByCap[\\\"graceful_stop\\\"]\\n\\t\\t\\t\\t\\tobject[\\\"observed_at\\\"] = \\\"2024-01-01T00:00:00.000Z\\\"\\n\\t\\t\\t\\t\\tobject[\\\"expires_at\\\"] = \\\"2025-01-01T00:00:00.000Z\\\"\\n\\t\\t\\t\\t\\tfinalizeEvidence(t, universe.key, object)\\n\\t\\t\\t\\t\\tfinalizeProbeIDs(t, universe)\\n\\t\\t\\t\\t}, codeMismatch, \\\"evidence liveness\\\")''')\\n\\n# parse-level expiry: expire before the universe observed instant\\nrep('''object[\\\"expires_at\\\"] = \\\"2026-01-01T00:00:00.000Z\\\"\\n\\t\\t\\t\\t}, \\\"evidence expiry\\\")''',\\n'''object[\\\"expires_at\\\"] = \\\"2024-01-01T00:00:00.000Z\\\"\\n\\t\\t\\t\\t}, \\\"evidence expiry\\\")''')\\n\\n# checkSortedUnique ordering: unsorted operations (reordering claims hits claim ordering first)\\nrep('''claims := object[\\\"static_capability_claims\\\"].([]any)\\n\\t\\t\\t\\t\\tobject[\\\"static_capability_claims\\\"] = []any{claims[2], claims[1], claims[0]}\\n\\t\\t\\t\\t}, \\\"document ordering\\\")''',\\n'''claims := object[\\\"static_capability_claims\\\"].([]any)\\n\\t\\t\\t\\t\\tclaims[0].(map[string]any)[\\\"dependent_operations\\\"] = []any{\\\"status\\\", \\\"create\\\"}\\n\\t\\t\\t\\t}, \\\"document ordering\\\")''')\\n\\nopen(p, 'w').write(s)\\nprint('reconcile proves fixed')\\nPYEOF\",\n  \"description\": \"Fix reconcile fixture mistakes\",\n 