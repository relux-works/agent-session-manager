{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7df","stream":{"kind":"session","id":"01a0798e-8ce3-71d2-82cf-4115ffc6a2dc"},"sequence":586,"recorded_at":1780531400001167,"record_type":"event","durability":"durable","causation_id":"f7e88212-ef87-40d2-a1db-8797ebe2238a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f7e88212-ef87-40d2-a1db-8797ebe2238a","run_stream":{"kind":"run","id":"f7e88212-ef87-40d2-a1db-8797ebe2238a"},"call_id":"call_01a07990c5c075e08ff857ea99398d98","text":"Read text file `internal/terminalbackend/digit_guard_census_test.go`.\n(499 line(s) above)\n500|\t\t\t\tother++\n501|\t\t\t}\n502|\t\t\treturn\n503|\t\t}\n504|\t\tother++\n505|\t}\n506|\tvisit(root)\n507|\tcanon := digitGuardCanon(root)\n508|\twhere := \"unclassifiable guard in \" + file + \" (\" + function + \"): \" + canon\n509|\tswitch {\n510|\tcase bad > 0:\n511|\t\treturn nil, where, true\n512|\tcase chars > 0 && bounds > 0:\n513|\t\treturn nil, where + \" (mixes digit and accumulator comparisons)\", true\n514|\tcase chars > 0 && other > 0:\n515|\t\treturn nil, where + \" (mixes digit comparisons with unrelated comparisons)\", true\n516|\tcase bounds > 0 && other > 0:\n517|\t\treturn nil, where + \" (mixes accumulator comparisons with unrelated comparisons)\", true\n518|\tcase chars > 0:\n519|\t\treturn &digitGuardSite{dir: dir, file: file, function: function, kind: \"char\", expr: canon}, \"\", true\n520|\tcase bounds > 0:\n521|\t\treturn &digitGuardSite{dir: dir, file: file, function: function, kind: \"bound\", expr: canon}, \"\", true\n522|\tdefault:\n523|\t\treturn nil, \"\", true\n524|\t}\n525|}\n526|\n527|// digit leaf classes.\n528|const (\n529|\tdigitLeafOther = iota\n530|\tdigitLeafChar\n531|\tdigitLeafBound\n532|\tdigitLeafBad\n533|)\n534|\n535|// digitGuardIsComparison reports whether op is a comparison,\n536|// including the equality operators the classifier refuses.\n537|func digitGuardIsComparison(op token.Token) bool {\n538|\tswitch op {\n539|\tcase token.LSS, token.GTR, token.LEQ, token.GEQ, token.EQL, token.NEQ:\n540|\t\treturn true\n541|\tdefault:\n542|\t\treturn false\n543|\t}\n544|}\n545|\n546|// digitGuardClassifyLeaf places one comparison: an ordering against\n547|// a digit rune is char, an ordering with exactly one accumulator\n548|// side is bound, an equality against a digit rune and every\n549|// degenerate shape (digit against accumulator, accumulators on both\n550|// sides) is bad, and everything else is other.\n551|func digitGuardClassifyLeaf(comparison *ast.BinaryExpr, accumulators map[string]bool) int {\n552|\t_, xDigit := digitGuardDigitRune(comparison.X)\n553|\t_, yDigit := digitGuardDigitRune(comparison.Y)\n554|\txAcc := digitGuardIsAccumulator(comparison.X, accumulators)\n555|\tyAcc := digitGuardIsAccumulator(comparison.Y, accumulators)\n556|\tswitch comparison.Op {\n557|\tcase token.LSS, token.GTR, token.LEQ, token.GEQ:\n558|\t\tswitch {\n559|\t\tcase (xDigit || yDigit) && (xAcc || yAcc):\n560|\t\t\treturn digitLeafBad\n561|\t\tcase xDigit || yDigit:\n562|\t\t\treturn digitLeafChar\n563|\t\tcase xAcc && yAcc:\n564|\t\t\treturn digitLeafBad\n565|\t\tcase xAcc || yAcc:\n566|\t\t\treturn digitLeafBound\n567|\t\tdefault:\n568|\t\t\treturn digitLeafOther\n569|\t\t}\n570|\tcase token.EQL, token.NEQ:\n571|\t\tif xDigit || yDigit {\n572|\t\t\treturn digitLeafBad\n573|\t\t}\n574|\t\treturn digitLeafOther\n575|\tdefault:\n576|\t\treturn digitLeafOther\n577|\t}\n578|}\n579|\n580|// digitGuardMentionsDigitOrAccumulator reports whether expr contains\n581|// a digit rune or a decimal accumulator: a negation over either is\n582|// unclassifiable, over neither is unrelated.\n583|func digitGuardMentionsDigitOrAccumulator(expr ast.Expr, accumulators map[string]bool) bool {\n584|\tmentions := false\n585|\tast.Inspect(expr, func(node ast.Node) bool {\n586|\t\tswitch node := node.(type) {\n587|\t\tcase *ast.BasicLit:\n588|\t\t\tif _, ok := digitGuardDigitRune(node); ok {\n589|\t\t\t\tmentions = true\n590|\t\t\t\treturn false\n591|\t\t\t}\n592|\t\tcase *ast.Ident:\n593|\t\t\tif accumulators[node.Name] {\n594|\t\t\t\tmentions = true\n595|\t\t\t\treturn false\n596|\t\t\t}\n597|\t\tcase *ast.BinaryExpr:\n598|\t\t\tif node.Op == token.MUL {\n599|\t\t\t\tif id, ok := digitGuardUnparen(node.X).(*ast.Ident); ok && accumulators[id.Name] {\n600|\t\t\t\t\tif lit, ok := digitGuardUnparen(node.Y).(*ast.BasicLit); ok && lit.Kind == token.INT && lit.Value == \"10\" {\n601|\t\t\t\t\t\tmentions = true\n602|\t\t\t\t\t\treturn false\n603|\t\t\t\t\t}\n604|\t\t\t\t}\n605|\t\t\t\tif id, ok := digitGuardUnparen(node.Y).(*ast.Ident); ok && accumulators[id.Name] {\n606|\t\t\t\t\tif lit, ok := digitGuardUnparen(node.X).(*ast.BasicLit); ok && lit.Kind == token.INT && lit.Value == \"10\" {\n607|\t\t\t\t\t\tmentions = true\n608|\t\t\t\t\t\treturn false\n609|\t\t\t\t\t}\n610|\t\t\t\t}\n611|\t\t\t}\n612|\t\t}\n613|\t\treturn true\n614|\t})\n615|\treturn mentions\n616|}\n617|\n618|// digitGuardDigitRune reports whether expr is a decimal digit rune\n619|// literal. Escaped spellings of the same code points count: the\n620|// gate sees the value, not the spelling.\n621|func digitGuardDigitRune(expr ast.Expr) (rune, bool) {\n622|\tlit, ok := digitGuardUnparen(expr).(*ast.BasicLit)\n623|\tif !ok || lit.Kind != token.CHAR {\n624|\t\treturn 0, false\n625|\t}\n626|\tinner := strings.TrimPrefix(strings.TrimSuffix(lit.Value, \"'\"), \"'\")\n627|\tvalue, _, _, err := strconv.UnquoteChar(inner, '\\'')\n628|\tif err != nil {\n629|\t\treturn 0, false\n630|\t}\n631|\tif value < '0' || value > '9' {\n632|\t\treturn 0, false\n633|\t}\n634|\treturn value, true\n635|}\n636|\n637|// digitGuardIsAccumulator reports whether expr is a bare reference\n638|// to a decimal accumulator of the enclosing function.\n639|func digitGuardIsAccumulator(expr ast.Expr, accumulators map[string]bool) bool {\n640|\tident, ok := digitGuardUnparen(expr).(*ast.Ident)\n641|\treturn ok && accumulators[ident.Name]\n642|}\n643|\n644|// digitGuardAccumulators collects the decimal accumulators of one\n645|// function: identifiers assigned from an expression multiplying the\n646|// identifier itself by the integer literal 10. The name is never\n647|// matched against a list; a renamed accumulator is derived like any\n648|// other.\n649|func digitGuardAccumulators(body *ast.BlockStmt) map[string]bool {\n650|\taccumulators := map[string]bool{}\n651|\tast.Inspect(body, func(node ast.Node) bool {\n652|\t\tassign, ok := node.(*ast.AssignStmt)\n653|\t\tif !ok || len(assign.Lhs) != 1 {\n654|\t\t\treturn true\n655|\t\t}\n656|\t\ttarget, ok := assign.Lhs[0].(*ast.Ident)\n657|\t\tif !ok {\n658|\t\t\treturn true\n659|\t\t}\n660|\t\tfor _, rhs := range assign.Rhs {\n661|\t\t\tif digitGuardMultipliesByTen(rhs, target.Name) {\n662|\t\t\t\taccumulators[target.Name] = true\n663|\t\t\t}\n664|\t\t}\n665|\t\treturn true\n666|\t})\n667|\treturn accumulators\n668|}\n669|\n670|// digitGuardMultipliesByTen reports whether expr contains the\n671|// identifier multiplying itself by ten, in either operand order.\n672|func digitGuardMultipliesByTen(expr ast.Expr, name string) bool {\n673|\tfound := false\n674|\tast.Inspect(expr, func(node ast.Node) bool {\n675|\t\tproduct, ok := node.(*ast.BinaryExpr)\n676|\t\tif !ok || product.Op != token.MUL {\n677|\t\t\treturn true\n678|\t\t}\n679|\t\tif digitGuardIsTenTimes(product.X, product.Y, name) || digitGuardIsTenTimes(product.Y, product.X, name) {\n680|\t\t\tfound = true\n681|\t\t\treturn false\n682|\t\t}\n683|\t\treturn true\n684|\t})\n685|\treturn found\n686|}\n687|\n688|// digitGuardIsTenTimes reports whether factor is the identifier and\n689|// scale is the integer literal 10.\n690|func digitGuardIsTenTimes(factor, scale ast.Expr, name string) bool {\n691|\tident, ok := digitGuardUnparen(factor).(*ast.Ident)\n692|\tif !ok || ident.Name != name {\n693|\t\treturn false\n694|\t}\n695|\tlit, ok := digitGuardUnparen(scale).(*ast.BasicLit)\n696|\treturn ok && lit.Kind == token.INT && lit.Value == \"10\"\n697|}\n698|\n699|// digitGuardCanon renders the printer-normalized chain text the rows\n700|// declare: positions never enter the key, so moving a guard keeps\n701|// its row while editing it orphans it.\n702|func digitGuardCanon(expr ast.Expr) string {\n703|\tvar rendered bytes.Buffer\n704|\tif err := printer.Fprint(&rendered, token.NewFileSet(), expr); err != nil {\n705|\t\treturn \"\"\n706|\t}\n707|\treturn rendered.String()\n708|}\n709|\n710|// digitCensusTestNames collects every test function defined in the\n711|// leaf test files, so a row cannot name a test that does not exist.\n712|func digitCensusTestNames(t *testing.T) map[string]bool {\n713|\tt.Helper()\n714|\n715|\troot, err := os.Getwd()\n716|\tif err != nil {\n717|\t\tt.Fatalf(\"collect leaf test names: %v\", err)\n718|\t}\n719|\tnames := map[string]bool{}\n720|\tfileSet := token.NewFileSet()\n721|\tfor _, dir := range []string{root, filepath.Join(root, \"..\", \"provhost\")} {\n722|\t\tentries, err := os.ReadDir(dir)\n723|\t\tif err != nil {\n724|\t\t\tt.Fatalf(\"collect leaf test names: read %s: %v\", dir, err)\n725|\t\t}\n726|\t\tfor _, entry := range entries {\n727|\t\t\tname := entry.Name()\n728|\t\t\tif entry.IsDir() || !strings.HasSuffix(name, \"_test.go\") {\n729|\t\t\t\tcontinue\n730|\t\t\t}\n731|\t\t\tpath := filepath.Join(dir, name)\n732|\t\t\tsource, err := os.ReadFile(path)\n733|\t\t\tif err != nil {\n734|\t\t\t\tt.Fatalf(\"collect leaf test names: read %s: %v\", path, err)\n735|\t\t\t}\n736|\t\t\tsyntax, err := parser.ParseFile(fileSet, path, source, 0)\n737|\t\t\tif err != nil {\n738|\t\t\t\tt.Fatalf(\"collect leaf test names: parse %s: %v\", path, err)\n739|\t\t\t}\n740|\t\t\tfor _, decl := range syntax.Decls {\n741|\t\t\t\tfunction, ok := decl.(*ast.FuncDecl)\n742|\t\t\t\tif !ok || function.Recv != nil || !strings.HasPrefix(function.Name.Name, \"Test\") {\n743|\t\t\t\t\tcontinue\n744|\t\t\t\t}\n745|\t\t\t\tnames[function.Name.Name] = true\n746|\t\t\t}\n747|\t\t}\n748|\t}\n749|\tif len(names) == 0 {\n750|\t\tt.Fatal(\"collected zero leaf test names; the scanner is broken, not the leaf\")\n751|\t}\n752|\treturn names\n753|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
