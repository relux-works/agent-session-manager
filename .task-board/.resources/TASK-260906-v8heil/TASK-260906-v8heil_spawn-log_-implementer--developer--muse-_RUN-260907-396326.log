ng]bool) {\\n440:\\t\\t\\tt.Errorf(\\\"unregistered grammar copy %q: one language means one definition site per package at most\\\", key)\\n444:\\t\\tt.Errorf(\\\"unregistered grammar copy under a fresh name %q: a second copy is a second copy even when the symbol is new\\\", key)\\n=== internal/environ/shape_census_test.go ===\\n24:// here as an unregistered site.\\n93:// semantics. An unregistered hit fails the census; an orphaned\\n141:// unregistered copy fails as a unification violation, and a row\\n143:// as orphaned.\\n148:\\t\\t\\tt.Errorf(\\\"unregistered shared-rule copy %q: add one canonical implementation in internal/environ instead, or register the shape with its agreement battery\\\", key)\\n153:\\t\\t\\tt.Errorf(\\\"orphaned shape row %q (%s): production no longer derives it\\\", key, rationale)\\n160:func deriveShapeSites(t *testing.T) map[string]bool {\\n640:// exactly, and whose every derived site must be unregistered —\\n848:// derived sets, with every derived site unregistered: the proof\\n887:// report it as a copy of that class with an unregistered key:\\n=== internal/dirnode/census_test.go ===\\n63:// on the orphaned witnesses instead of passing vacuously).\\n91://     a ninth constructor fails as unregistered.\\n196:func deriveRefusalArms(t *testing.T) armDerivation {\\n852:// orphaned witnesses instead of passing vacuously.\\n859:\\tvar orphaned []string\\n862:\\t\\t\\torphaned = append(orphaned, arm)\\n867:\\t\\t\\torphaned = append(orphaned, arm+\\\" (defensive)\\\")\\n870:\\tsort.Strings(orphaned)\\n871:\\tif len(orphaned) > 0 {\\n872:\\t\\tt.Fatalf(\\\"orphaned witness rows:\\\\n  %s\\\", strings.Join(orphaned, \\\"\\\\n  \\\"))\\n=== internal/dirnode/bound_census_test.go ===\\n21:// removed bound orphans its row and fails too. A helper alias\\n125:// per site, so an unrostered helper surfaces as unregistered\\n653:// An unregistered site fails as unrostered; an orphaned\\n696:\\tvar unregistered []string\\n699:\\t\\t\\tunregistered = append(unregistered, id)\\n702:\\tvar orphaned []string\\n705:\\t\\t\\torphaned = append(orphaned, id)\\n708:\\tsort.Strings(unregistered)\\n709:\\tsort.Strings(orphaned)\\n710:\\tif len(unregistered) > 0 {\\n=== internal/sessadapter/census_test.go ===\\n41:// table; a chain is an unregistered union and fails here.\\n174:\\tvar unregistered []string\\n178:\\t\\t\\tunregistered = append(unregistered, name)\\n185:\\tsort.Strings(unregistered)\\n186:\\tif len(unregistered) > 0 {\\n187:\\t\\tt.Fatalf(\\\"production vocabulary table(s) with no census registration:\\\\n  %s\\\", strings.Join(unregistered, \\\"\\\\n  \\\"))\\n189:\\tvar orphaned []string\\n199:\\t\\t\\torphaned = append(orphaned, name)\\n202:\\tsort.Strings(orphaned)\\n203:\\tif len(orphaned) > 0 {\\n=== internal/sessadapter/bound_census_test.go ===\\n27:// bound orphans its row and fails too. A helper alias\\n134:// per site, so an unrostered helper surfaces as unregistered\\n724:// An unregistered site fails as unrostered; an orphaned\\n767:\\tvar unregistered []string\\n770:\\t\\t\\tunregistered = append(unregistered, id)\\n773:\\tvar orphaned []string\\n776:\\t\\t\\torphaned = append(orphaned, id)\\n779:\\tsort.Strings(unregistered)\\n780:\\tsort.Strings(orphaned)\\n781:\\tif len(unregistered) > 0 {\\n=== internal/secprim/census_test.go ===\\n56:func deriveSecretSites(t *testing.T) map[string]bool {\\n275:// a site production no longer derives fails as orphaned.\\n447:\\t\\t\\t\\tt.Fatalf(\\\"orphaned census row site %q: production derives no such site\\\", site)\\n542:// and removing a live token orphans its sites in the roster above.\\n=== internal/provhost/closed_vocabulary_census_test.go ===\\n619:func deriveMembershipVocabularies(t *testing.T) map[string]struct{} {\\n818:// a derived vocabulary, so a truncated scan reddens on the orphaned\\n821:func TestClosedVocabularyCensusCoversEveryMembershipVocabulary(t *testing.T) {\\n\",\n  \"original_output_bytes\": 4300,\n  \"original_output_tokens\": 1075,\