et, path, source, parser.ParseComments)\n125|\t\tif err != nil {\n126|\t\t\treturn nil, nil, err\n127|\t\t}\n128|\t\tfiles = append(files, productionFile{syntax: syntax, source: source})\n129|\t}\n130|\t// First pass, package-wide: the decodeStrictObject fault detail\n131|\t// set, which the integrity wrapper site expands over. The wrapper\n132|\t// only wraps decodeStrictObject faults, so checkResponseMembers\n133|\t// arms (\"missing member\", \"unknown member\", ...) are not in this\n134|\t// set: expanding over every frameFault literal would invent arms\n135|\t// production can never emit. The pass must span files because the\n136|\t// literals live in protocol.go while the wrapper lives in status.go.\n137|\tvar strictDetails []string\n138|\tseenDetail := map[string]bool{}\n139|\tfor _, file := range files {\n140|\t\tfor _, decl := range file.syntax.Decls {\n141|\t\t\tfunction, ok := decl.(*ast.FuncDecl)\n142|\t\t\tif !ok || function.Name.Name != \"decodeStrictObject\" {\n143|\t\t\t\tcontinue\n144|\t\t\t}\n145|\t\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n146|\t\t\t\tliteral, ok := frameFaultLiteral(node)\n147|\t\t\t\tif !ok {\n148|\t\t\t\t\treturn true\n149|\t\t\t\t}\n150|\t\t\t\tdetail, ok := literalStringField(file.source, fileSet, literal, \"detail\")\n151|\t\t\t\tif !ok {\n152|\t\t\t\t\treturn true\n153|\t\t\t\t}\n154|\t\t\t\tif !seenDetail[detail] {\n155|\t\t\t\t\tseenDetail[detail] = true\n156|\t\t\t\t\tstrictDetails = append(strictDetails, detail)\n157|\t\t\t\t}\n158|\t\t\t\treturn true\n159|\t\t\t})\n160|\t\t}\n161|\t}\n162|\tfor _, file := range files {\n163|\t\tsource, syntax := file.source, file.syntax\n164|\t\tparseBranches += armParseBranches(source, fileSet, syntax, arms)\n165|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n166|\t\t\tif literal, ok := frameFaultLiteral(node); ok {\n167|\t\t\t\tdetail, ok := literalStringField(source, fileSet, literal, \"detail\")\n168|\t\t\t\tif !ok {\n169|\t\t\t\t\tarms[\"frame|expr:\"+nodeSource(source, fileSet, node)] = struct{}{}\n170|\t\t\t\t\treturn true\n171|\t\t\t\t}\n172|\t\t\t\tmember := \"\"\n173|\t\t\t\tif kv := literalField(literal, \"member\"); kv != nil {\n174|\t\t\t\t\tmember = nodeSource(source, fileSet, kv.Value)\n175|\t\t\t\t}\n176|\t\t\t\tarms[\"frame|\"+detail+\"|\"+member] = struct{}{}\n177|\t\t\t\treturn true\n178|\t\t\t}\n179|\t\t\tcall, ok := node.(*ast.CallExpr)\n180|\t\t\tif !ok {\n181|\t\t\t\treturn true\n182|\t\t\t}\n183|\t\t\tident, ok := call.Fun.(*ast.Ident)\n184|\t\t\tif !ok || len(call.Args) == 0 {\n185|\t\t\t\treturn true\n186|\t\t\t}\n187|\t\t\tswitch ident.Name {\n188|\t\t\tcase \"integrity\":\n189|\t\t\t\tif literal, ok := call.Args[0].(*ast.BasicLit); ok && literal.Kind == token.STRING {\n190|\t\t\t\t\tdetail, err := strconv.Unquote(literal.Value)\n191|\t\t\t\t\tif err != nil {\n192|\t\t\t\t\t\tarms[\"integrity|expr:\"+nodeSource(source, fileSet, call.Args[0])] = struct{}{}\n193|\t\t\t\t\t\treturn true\n194|\t\t\t\t\t}\n195|\t\t\t\t\tarms[\"integrity|\"+detail] = struct{}{}\n196|\t\t\t\t\treturn true\n197|\t\t\t\t}\n198|\t\t\t\tif prefix, ok := integrityPrefix(call.Args[0]); ok {\n199|\t\t\t\t\tif len(strictDetails) == 0 {\n200|\t\t\t\t\t\tarms[\"integrity|expr:\"+nodeSource(source, fileSet, call.Args[0])] = struct{}{}\n201|\t\t\t\t\t\treturn true\n202|\t\t\t\t\t}\n203|\t\t\t\t\tfor _, detail := range strictDetails {\n204|\t\t\t\t\t\tarms[\"integrity|\"+prefix+detail] = struct{}{}\n205|\t\t\t\t\t}\n206|\t\t\t\t\treturn true\n207|\t\t\t\t}\n208|\t\t\t\tarms[\"integrity|expr:\"+nodeSource(source, fileSet, call.Args[0])] = struct{}{}\n209|\t\t\tcase \"failInvalid\", \"failProtocol\", \"failMismatch\", \"failProcess\", \"failTimeout\":\n210|\t\t\t\tif literal, ok := call.Args[0].(*ast.BasicLit); ok && literal.Kind == token.STRING {\n211|\t\t\t\t\tdetail, err := strconv.Unquote(literal.Value)\n212|\t\t\t\t\tif err != nil {\n213|\t\t\t\t\t\treturn true\n214|\t\t\t\t\t}\n215|\t\t\t\t\tarms[\"ctor|\"+ident.Name+\"|\"+detail] = struct{}{}\n216|\t\t\t\t}\n217|\t\t\t\t// Non-literal first arguments are the fault conduits\n218|\t\t\t\t// (fault.detail, detail variables): the arms behind\n219|\t\t\t\t// them are the frame arms above, so there is no\n220|\t\t\t\t// separate obligation here.\n221|\t\t\t}\n222|\t\t\treturn true\n223|\t\t})\n224|\t}\n225|\tif parseBranches == 0 {\n226|\t\treturn nil, nil, fmt.Errorf(\"parseMajor carries no rejection branch anywhere; the classification-branch enumeration is blind\")\n227|\t}\n228|\tsort.Strings(scanned)\n229|\treturn arms, scanned, nil\n230|}\n231|\n232|// frameFaultLiteral reports whether node is a &frameFault{...} literal.\n233|func frameFaultLiteral(node ast.Node) (*ast.CompositeLit, bool) {\n234|\ttarget := node\n235|\tif unary, ok := node.(*ast.UnaryExpr); ok && unary.Op == token.AND {\n236|\t\ttarget = unary.X\n237|\t}\n238|\tliteral, ok := target.(*ast.CompositeLit)\n239|\tif !ok {\n240|\t\treturn nil, false\n241|\t}\n242|\tident, ok := literal.Type.(*ast.Ident)\n243|\tif !ok || ident.Name != \"frameFault\" {\n244|\t\treturn nil, false\n245|\t}\n246|\treturn literal, true\n247|}\n248|\n249|func literalField(literal *ast.CompositeLit, name string) *ast.KeyValueExpr {\n250|\tfor _, element := range literal.Elts {\n251|\t\tif kv, ok := element.(*ast.KeyValueExpr); ok {\n252|\t\t\tif ident, ok := kv.Key.(*ast.Ident); ok && ident.Name == name {\n253|\t\t\t\treturn kv\n254|\t\t\t}\n255|\t\t}\n256|\t}\n257|\treturn nil\n258|}\n259|\n260|func literalStringField(source []byte, fileSet *token.FileSet, literal *ast.CompositeLit, name string) (string, bool) {\n261|\tkv := literalField(literal, name)\n262|\tif kv == nil {\n263|\t\treturn \"\", false\n264|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
