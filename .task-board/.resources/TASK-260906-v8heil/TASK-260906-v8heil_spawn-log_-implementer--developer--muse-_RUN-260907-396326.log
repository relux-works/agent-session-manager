{"schema_version":1,"id":"018f0000-0000-7000-8000-00000001029f","stream":{"kind":"session","id":"01a0798e-8ce3-71d2-82cf-4115ffc6a2dc"},"sequence":8106,"recorded_at":1780531400016207,"record_type":"event","durability":"durable","causation_id":"f7e88212-ef87-40d2-a1db-8797ebe2238a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f7e88212-ef87-40d2-a1db-8797ebe2238a","run_stream":{"kind":"run","id":"f7e88212-ef87-40d2-a1db-8797ebe2238a"},"task_stream":{"kind":"task","id":"9fc1239f-1895-40cb-945d-3d7ce6e01f80"},"task_id":"9fc1239f-1895-40cb-945d-3d7ce6e01f80","event":{"kind":"output","task_id":"9fc1239f-1895-40cb-945d-3d7ce6e01f80","chunk":"{\n  \"chunk_id\": \"exec-365-1\",\n  \"command\": \"task-board resource --help 2>&1 | head -n 25; echo ===; task-board handoff --help 2>&1 | head -n 30\",\n  \"description\": \"Board resource and handoff syntax\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Manage attached resources such as screenshots, docs, logs, and other files.\\n\\nUse \\\"task-board resource add\\\" to create a new attached resource, \\\"task-board\\nresource adopt\\\" to register an orphaned local payload, \\\"task-board resource\\nupdate\\\" to replace an existing one, \\\"task-board resource delete\\\" to remove it,\\nand \\\"task-board resource get\\\" to materialize a resource back to the local\\nfilesystem for inspection.\\n\\nUsage:\\n  task-board resource [command]\\n\\nAvailable Commands:\\n  add         Attach a new file resource to an element\\n  adopt       Register an existing unreferenced local resource payload\\n  delete      Delete a resource from an element (requires --confirm)\\n  get         Download a resource to the local filesystem\\n  update      Replace an existing file resource on an element\\n\\nFlags:\\n  -h, --help   help for resource\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n===\\nResolve the configured role end status, verify every checklist item and\\nat least one stored task-scoped outcome resource, and apply the ordinary\\ncascading status transition under one mutation lock.\\n\\nThe command fails closed with all missing evidence and does not change status.\\nAttach or update the outcome with the resource or mutation CLI before handoff.\\n\\nUsage:\\n  task-board handoff <ELEMENT-ID> [flags]\\n\\nFlags:\\n      --commit-ack string   Mover acknowledgement for an enforced done transition\\n      --format string       Output format: compact or json (default \\\"compact\\\")\\n  -h, --help                help for handoff\\n      --role string         Role whose configured end_status must be applied\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\",\n  \"original_output_bytes\": 2456,\n  \"original_output_tokens\": 614,\n  \"truncated\": false\n}"}}}
