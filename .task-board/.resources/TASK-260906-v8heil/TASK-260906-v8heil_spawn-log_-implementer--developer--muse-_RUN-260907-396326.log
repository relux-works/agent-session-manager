n, match)\\n\\t\\t}\\n\\t}\\n\\tif len(production) == 0 {\\n\\t\\tt.Fatal(\\\"derived zero production files; the scanner is broken, not the package\\\")\\n\\t}\\n\\n\\tvar arms []refusalArm\\n\\tparsed := 0\\n\\tfor _, name := range production {\\n\\t\\tfileSet := token.NewFileSet()\\n\\t\\tfile, err := parser.ParseFile(fileSet, name, nil, 0)\\n\\t\\tif err != nil {\\n\\t\\t\\tt.Fatalf(\\\"parse %s: %v; an unparseable derivation proves nothing\\\", name, err)\\n\\t\\t}\\n\\t\\tparsed++\\n''', '''func deriveRefusalArms(t *testing.T) []refusalArm {\\n\\tt.Helper()\\n\\n\\t// Production-file selection and fail-closed parsing are the shared\\n\\t// core's: a new production file is scanned without anyone\\n\\t// remembering it, and an unparseable file fails, never skips.\\n\\tfiles, _ := invcore.MustScanProduction(t, \\\".\\\")\\n\\n\\tvar arms []refusalArm\\n\\tparsed := 0\\n\\tfor _, production := range files {\\n\\t\\tfile, name := production.Syntax, production.Name\\n\\t\\tparsed++\\n''')\\nopen(p, 'w').write(s)\\nprint('ok')\\nPYEOF\\ngrep -n \\\"rejectConstructorAliases(t, file, name)\\\" internal/terminalbackend/refusal_arm_inventory_test.go\",\n  \"description\": \"Migrate derivation prelude to core\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"ok\\n248:\\t\\trejectConstructorAliases(t, file, name)\\n\",\n  \"original_output_bytes\": 49,\n  \"original_output_tokens\": 13,\n  \"truncated\": false\n}"}}}
