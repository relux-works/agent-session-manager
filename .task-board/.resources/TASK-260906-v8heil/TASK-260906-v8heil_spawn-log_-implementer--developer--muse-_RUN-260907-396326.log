\\", \\\"ParseEvidence\\\", \\\"CodeMismatch\\\", \\\"evidence issuer\\\", 1),')\\nrep('''proveEvidenceDoc(t, func(object map[string]any) {\\n\\t\\t\\t\\t\\tobject[\\\"issuer\\\"] = \\\"evil.example.com\\\"\\n\\t\\t\\t\\t}, \\\"evidence issuer identity\\\")''',\\n    '''proveEvidenceDoc(t, func(object map[string]any) {\\n\\t\\t\\t\\t\\tobject[\\\"issuer\\\"] = \\\"self\\\"\\n\\t\\t\\t\\t}, \\\"evidence issuer\\\")''')\\n\\n# 2b. platform vocabulary -> platform\\nrep('key:   wkey(\\\"manifest.go\\\", \\\"ParseEvidence\\\", \\\"CodeMismatch\\\", \\\"evidence platform vocabulary\\\", 1),',\\n    'key:   wkey(\\\"manifest.go\\\", \\\"ParseEvidence\\\", \\\"CodeMismatch\\\", \\\"evidence platform\\\", 1),')\\nrep('''object[\\\"platform\\\"] = \\\"plan9\\\"\\n\\t\\t\\t\\t}, \\\"evidence platform vocabulary\\\")''',\\n    '''object[\\\"platform\\\"] = \\\"plan9\\\"\\n\\t\\t\\t\\t}, \\\"evidence platform\\\")''')\\n\\n# 2c. protocol version -> protocol major 1\\nrep('key:   wkey(\\\"manifest.go\\\", \\\"ParseEvidence\\\", \\\"CodeMismatch\\\", \\\"evidence protocol version\\\", 1),',\\n    'key:   wkey(\\\"manifest.go\\\", \\\"ParseEvidence\\\", \\\"CodeMismatch\\\", \\\"evidence protocol major 1\\\", 1),')\\nrep('''object[\\\"protocol_version\\\"] = \\\"2.0.0\\\"\\n\\t\\t\\t\\t}, \\\"evidence protocol version\\\")''',\\n    '''object[\\\"protocol_version\\\"] = \\\"2.0.0\\\"\\n\\t\\t\\t\\t}, \\\"evidence protocol major 1\\\")''')\\n\\n# 2d. value truth -> value\\nrep('key:   wkey(\\\"manifest.go\\\", \\\"ParseEvidence\\\", \\\"CodeMismatch\\\", \\\"evidence value truth\\\", 1),',\\n    'key:   wkey(\\\"manifest.go\\\", \\\"ParseEvidence\\\", \\\"CodeMismatch\\\", \\\"evidence value\\\", 1),')\\nrep('''object[\\\"value\\\"] = \\\"maybe\\\"\\n\\t\\t\\t\\t}, \\\"evidence value truth\\\")''',\\n    '''object[\\\"value\\\"] = \\\"maybe\\\"\\n\\t\\t\\t\\t}, \\\"evidence value\\\")''')\\n\\n# 3. verifier code\\nrep('key:   wkey(\\\"manifest.go\\\", \\\"Reconcile\\\", \\\"CodeCapabilityUnproven\\\", \\\"evidence signature verifier\\\", 1),',\\n    'key:   wkey(\\\"manifest.go\\\", \\\"Reconcile\\\", \\\"CodeIntegrityFailure\\\", \\\"evidence signature verifier\\\", 1),')\\nrep('''_, err := terminalbackend.Reconcile(manifest, probe, evidence, universe.rawGeneration, universe.now, nil)\\n\\t\\t\\t\\trequireRefusal(t, err, codeCapabilityUnproven, \\\"evidence signature verifier\\\")''',\\n    '''_, err := terminalbackend.Reconcile(manifest, probe, evidence, universe.rawGeneration, universe.now, nil)\\n\\t\\t\\t\\trequireRefusal(t, err, codeIntegrityFailure, \\\"evidence signature verifier\\\")''')\\n\\n# 4. claim without manifest -> static claim without manifest\\nrep('key:   wkey(\\\"manifest.go\\\", \\\"checkClaimRelation\\\", \\\"CodeMismatch\\\", \\\"probe claim without manifest\\\", 1),',\\n    'key:   wkey(\\\"manifest.go\\\", \\\"checkClaimRelation\\\", \\\"CodeMismatch\\\", \\\"probe static claim without manifest\\\", 1),')\\nrep('}, codeMismatch, \\\"probe claim without manifest\\\")', '}, codeMismatch, \\\"probe static claim without manifest\\\")')\\n\\n# 5. coverage code\\nrep('key:   wkey(\\\"manifest.go\\\", \\\"checkEvidenceCoverage\\\", \\\"CodeCapabilityUnproven\\\", \\\"evidence requirement coverage\\\", 1),',\\n    'key:   wkey(\\\"manifest.go\\\", \\\"checkEvidenceCoverage\\\", \\\"CodeMismatch\\\", \\\"evidence requirement coverage\\\", 1),')\\nrep('}, codeCapabilityUnproven, \\\"evidence requirement coverage\\\")', '}, codeMismatch, \\\"evidence requirement coverage\\\")')\\n\\n# 6. generation function\\nrep('key:   wkey(\\\"manifest.go\\\", \\\"checkProbeMembership\\\", \\\"CodeStaleGeneration\\\", \\\"probe generation binding\\\", 1),',\\n    'key:   wkey(\\\"manifest.go\\\", \\\"checkProbeGeneration\\\", \\\"CodeStaleGeneration\\\", \\\"probe generation binding\\\", 1),')\\n\\n# 7. signature scheme/encoding details\\nrep('\\\"evidence attestation encoding\\\", 1)', '\\\"evidence signature encoding\\\", 1)')\\nrep('}, \\\"evidence attestation encoding\\\")', '}, \\\"evidence signature encoding\\\")')\\nrep('\\\"evidence attestation scheme\\\", 1)', '\\\"evidence signature scheme\\\", 1)')\\nrep('}, \\\"evidence attestation scheme\\\")', '}, \\\"evidence signature scheme\\\")')\\n\\n# 8. protocol versions details\\nrep('\\\"document protocol bound\\\", 1)', '\\\"protocol versions bound\\\", 1)')\\nrep('}, \\\"document protocol bound\\\")', '}, \\\"protocol versions bound\\\")')\\nrep('\\\"document protocol major 1\\\", 1)', '\\\"protocol versions major 1\\\", 1)')\\nrep('}, \\\"document protocol major 1\\\")', '}, \\\"protocol versions major 1\\\")')\\nrep('\\\"document protocol ordering\\\", 1)', '\\\"protocol versions ordering\\\", 1)')\\nrep('}, \\\"document protocol ordering\\\")', '}, \\\"protocol versions ordering\\\")')\\n\\n# 9. admit nil registry file\\nrep('key:   wkey(\\\"terminalbackend.go\\\", \\\"Registry.AdmitProbe\\\", \\\"CodeNotFound\\\", \\\"registry unavailable\\\", 1),',\\n    'key:   wkey(\\\"manifest.go\\\", \\\"Registry.AdmitProbe\\\", \\\"CodeNotFound\\\", \\\"registry unavailable\\\", 1),')\\n\\nopen(p, 'w').write(s)\\nprint('keys fixed, delta:', len(s) - orig_len)\\nPYEOF\",\n  \"description\": \"Fix witness keys and codes\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"keys fixed, delta: -126\\n\",\n  \"original_output_bytes\": 24,\n  \"original_output_tokens\": 6,\n  \"truncated\": false\n}"}}}
