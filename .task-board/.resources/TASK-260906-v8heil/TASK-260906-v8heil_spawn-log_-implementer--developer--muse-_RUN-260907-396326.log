{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000fa73","stream":{"kind":"session","id":"01a0798e-8ce3-71d2-82cf-4115ffc6a2dc"},"sequence":7060,"recorded_at":1780531400014115,"record_type":"event","durability":"durable","causation_id":"f7e88212-ef87-40d2-a1db-8797ebe2238a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f7e88212-ef87-40d2-a1db-8797ebe2238a","run_stream":{"kind":"run","id":"f7e88212-ef87-40d2-a1db-8797ebe2238a"},"task_stream":{"kind":"task","id":"ec5ae4e2-73ff-4b6c-a7aa-86af70820b7e"},"task_id":"ec5ae4e2-73ff-4b6c-a7aa-86af70820b7e","event":{"kind":"output","task_id":"ec5ae4e2-73ff-4b6c-a7aa-86af70820b7e","chunk":"{\n  \"chunk_id\": \"exec-310-1\",\n  \"command\": \"cd /Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree && rm -rf .temp/TASK-260906-v8heil/base && head -n 80 .temp/TASK-260906-vmzk0y/mutate.py\",\n  \"description\": \"Remove shadow, inspect prior mutate harness\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"#!/usr/bin/env python3\\n\\\"\\\"\\\"Reviewer mutation harness: apply one textual mutant, run a named test\\nmask, restore the file byte-for-byte, report the verdict.\\n\\nVerdicts:\\n  KILLED       mutant applied, named test suite FAILED\\n  SURVIVED     mutant applied, named test suite PASSED  <-- finding\\n  NOT_APPLIED  anchor not found exactly once (control)\\n  COMPILE_FAIL build/vet broke (control)\\n\\\"\\\"\\\"\\nimport hashlib, json, subprocess, sys, os\\n\\nROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\\n\\ndef sha(p):\\n    return hashlib.sha256(open(p, 'rb').read()).hexdigest()\\n\\ndef run(mut):\\n    path = os.path.join(ROOT, mut['file'])\\n    original = open(path, 'r', encoding='utf-8').read()\\n    before = hashlib.sha256(original.encode()).hexdigest()\\n    old, new = mut['old'], mut['new']\\n    n = original.count(old)\\n    if n != 1:\\n        return {'id': mut['id'], 'verdict': 'NOT_APPLIED', 'detail': f'anchor occurs {n} times'}\\n    mutated = original.replace(old, new, 1)\\n    try:\\n        open(path, 'w', encoding='utf-8').write(mutated)\\n        vet = subprocess.run(['go', 'vet', './' + os.path.dirname(mut['file']) + '/'],\\n                             cwd=ROOT, capture_output=True, text=True)\\n        if vet.returncode != 0:\\n            return {'id': mut['id'], 'verdict': 'COMPILE_FAIL',\\n                    'detail': vet.stderr.strip().splitlines()[:3]}\\n        cmd = ['go', 'test', mut['pkg'], '-run', mut['run'], '-count=1']\\n        res = subprocess.run(cmd, cwd=ROOT, capture_output=True, text=True)\\n        ran = res.stdout.count('--- FAIL') + res.stdout.count('--- PASS')\\n        verdict = 'KILLED' if res.returncode != 0 else 'SURVIVED'\\n        lines = [l for l in (res.stdout + res.stderr).splitlines()\\n                 if 'FAIL' in l or 'want' in l or 'got' in l]\\n        return {'id': mut['id'], 'verdict': verdict, 'class': mut['class'],\\n                'test': mut['run'], 'evidence': lines[:4]}\\n    finally:\\n        open(path, 'w', encoding='utf-8').write(original)\\n        after = sha(path)\\n        if after != before:\\n            print(f'!!! RESTORE FAILED for {path}', file=sys.stderr)\\n            sys.exit(2)\\n\\nif __name__ == '__main__':\\n    muts = json.load(open(sys.argv[1]))\\n    out = []\\n    for m in muts:\\n        r = run(m)\\n        out.append(r)\\n        print(json.dumps(r), flush=True)\\n    print('SUMMARY ' + json.dumps({v: sum(1 for r in out if r['verdict'] == v)\\n          for v in ('KILLED', 'SURVIVED', 'NOT_APPLIED', 'COMPILE_FAIL')}))\\n\",\n  \"original_output_bytes\": 2478,\n  \"original_output_tokens\": 620,\n  \"truncated\": false\n}"}}}
