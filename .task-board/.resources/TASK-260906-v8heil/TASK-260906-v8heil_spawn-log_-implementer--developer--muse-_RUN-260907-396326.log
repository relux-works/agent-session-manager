{{file: \"terminalbackend_test.go\", test: \"TestRegisterExternalRefusals\"}}},\n733|\t{\"terminalbackend.go\", \"checkGeneration\", \"CodeStaleGeneration\", \"backend_generation bound\", 1, \"CheckProviderDescriptor\", \"\", nil, []refusalTestRef{{file: \"terminalbackend_test.go\", test: \"TestCheckProviderDescriptorGenerationBounds\"}}},\n734|\t{\"terminalbackend.go\", \"parseKind\", \"CodeNotFound\", \"implementation_kind vocabulary\", 1, \"parseKind\", \"\", nil, []refusalTestRef{{file: \"internal_pin_test.go\", test: \"TestParseKindAdmitsOnlyTheClosedVocabulary\"}}},\n735|\t{\"terminalbackend.go\", \"validateProtocolVersions\", \"CodeDrift\", \"protocol_versions bound\", 1, \"New\", \"\", nil, []refusalTestRef{{file: \"terminalbackend_test.go\", test: \"TestNewRefusesBadVersionTuples\"}}},\n736|\t{\"terminalbackend.go\", \"validateProtocolVersions\", \"CodeDrift\", \"protocol_versions major 1\", 1, \"RegisterExternal\", \"\", nil, []refusalTestRef{{file: \"terminalbackend_test.go\", test: \"TestRegisterExternalRefusals\"}}},\n737|\t{\"terminalbackend.go\", \"validateProtocolVersions\", \"CodeDrift\", \"protocol_versions sorted unique\", 1, \"New\", \"\", nil, []refusalTestRef{{file: \"terminalbackend_test.go\", test: \"TestNewRefusesBadVersionTuples\"}}},\n738|\t{\"descriptor.go\", \"ParseProviderDescriptor\", \"CodeProtocolError\", \"descriptor member set\", 1, \"ParseProviderDescriptor\", \"\", nil, []refusalTestRef{{file: \"descriptor_test.go\", test: \"TestParseProviderDescriptorMemberSet\"}}},\n739|\t{\"descriptor.go\", \"ParseProviderDescriptor\", \"CodeProtocolError\", \"descriptor member set\", 2, \"ParseProviderDescriptor\", \"\", nil, []refusalTestRef{{file: \"descriptor_test.go\", test: \"TestParseProviderDescriptorMemberSet\"}}},\n740|\t{\"descriptor.go\", \"ParseProviderDescriptor\", \"CodeProtocolError\", \"descriptor digest\", 1, \"ParseProviderDescriptor\", \"\", nil, []refusalTestRef{{file: \"descriptor_test.go\", test: \"TestParseProviderDescriptorValueRefusals\"}}},\n741|\t{\"descriptor.go\", \"ParseProviderDescriptor\", \"CodeProtocolError\", \"descriptor instance\", 1, \"ParseProviderDescriptor\", \"\", nil, []refusalTestRef{{file: \"descriptor_test.go\", test: \"TestParseProviderDescriptorValueRefusals\"}}},\n742|\t{\"descriptor.go\", \"ParseProviderDescriptor\", \"CodeProtocolError\", \"descriptor implementation version\", 1, \"ParseProviderDescriptor\", \"\", nil, []refusalTestRef{{file: \"descriptor_test.go\", test: \"TestParseProviderDescriptorValueRefusals\"}}},\n743|\t{\"descriptor.go\", \"ParseProviderDescriptor\", \"CodeProtocolError\", \"descriptor protocol version\", 1, \"ParseProviderDescriptor\", \"\", nil, []refusalTestRef{{file: \"descriptor_test.go\", test: \"TestParseProviderDescriptorValueRefusals\"}}},\n744|\t{\"descriptor.go\", \"ParseProviderDescriptor\", \"CodeProtocolError\", \"descriptor interactive\", 1, \"ParseProviderDescriptor\", \"\", nil, []refusalTestRef{{file: \"descriptor_test.go\", test: \"TestParseProviderDescriptorValueRefusals\"}}},\n745|\t{\"descriptor.go\", \"descriptorText\", \"CodeProtocolError\", \"descriptor member type\", 1, \"ParseProviderDescriptor\", \"\", nil, []refusalTestRef{{file: \"descriptor_test.go\", test: \"TestParseProviderDescriptorMemberType\"}}},\n746|\t{\"descriptor.go\", \"descriptorGeometry\", \"CodeProtocolError\", \"descriptor geometry type\", 1, \"ParseProviderDescriptor\", \"\", nil, []refusalTestRef{{file: \"descriptor_test.go\", test: \"TestParseProviderDescriptorValueRefusals\"}}},\n747|\t{\"descriptor.go\", \"descriptorGeometry\", \"CodeProtocolError\", \"descriptor geometry digits\", 1, \"ParseProviderDescriptor\", \"\", nil, []refusalTestRef{{file: \"descriptor_test.go\", test: \"TestParseProviderDescriptorValueRefusals\"}}},\n748|\t{\"descriptor.go\", \"descriptorGeometry\", \"CodeProtocolError\", \"descriptor geometry bound\", 1, \"ParseProviderDescriptor\", \"\", nil, []refusalTestRef{{file: \"descriptor_test.go\", test: \"TestParseProviderDescriptorGeometryOverflowVectors\"}, {file: \"descriptor_test.go\", test: \"TestParseProviderDescriptorValueRefusals\"}}},\n749|\t{\"descriptor.go\", \"descriptorGeometry\", \"CodeProtocolError\", \"descriptor geometry bound\", 2, \"ParseProviderDescriptor\", \"\", nil, []refusalTestRef{{file: \"descriptor_test.go\", test: \"TestParseProviderDescriptorValueRefusals\"}, {file: \"descriptor_test.go\", test: \"TestParseProviderDescriptorGeometryOverflowVectors\"}}},\n750|}\n751|\n752|// funneledPlatformDetails is the exact error set validatePlatforms can\n753|// produce, funneled through the single Registration.validate arm below.\n754|// TestPlatformFunnelDetailsAreExactlyThese derives the set from the\n755|// production AST and requires equality, so a fourth platform error is a\n756|// red rather than a silently widened funnel.\n757|var funneledPlatformDetails = []string{\n758|\t\"platforms bound\",\n759|\t\"platforms vocabulary\",\n760|\t\"platforms sorted unique\",\n761|}\n762|\n763|// funneledPlatformArm declares the single dynamic-detail arm. Its tests\n764|// must mention every funneled detail, not just one of them.\n765|var funneledPlatformArm = declaredRefusalArm{\n766|\tfile: \"terminalbackend.go\", function: \"Registration.validate\",\n767|\tcode: \"CodeNotFound\", detail: passthroughDetail, occurrence: 1,\n768|\tentry: \"RegisterExternal\",\n769|\ttests: []refusalTestRef{{file: \"terminalbackend_test.go\", test: \"TestRegisterExternalRefusesPlatformViolations\"}},\n770|}\n771|\n772|// armlessCodes names wire codes with no refusal arm by design.\n773|// CodeUnavailable appears only inside the allowed-error sets; no\n774|// conformance refusal emits it, so it carries no arm of its own.\n775|var armlessCodes = map[string]bool{\n776|\t\"CodeUnavailable\": true,\n777|}\n778|\n779|// plainErrorFunctions names the only production functions allowed to\n780|// construct non-wire errors. validatePlatforms feeds the pinned funnel;\n781|// DigestFile reports I/O failures that must never be wire errors.\n782|var plainErrorFunctions = map[string]bool{\n783|\t\"validatePlatforms\": true,\n784|\t\"DigestFile\":        true,\n785|}\n786|\n787|// TestDerivedRefusalArmsAreAllDeclared is the forward direction: every\n788|// arm the production AST derives resolves to exactly one declared row.\n789|// A brand-new arm with a brand-new detail fails here until its witness\n790|// is recorded.\n791|func TestDerivedRefusalArmsAreAllDeclared(t *testing.T) {\n792|\tt.Parallel()\n793|\n794|\tderived := deriveRefusalArms(t)\n795|\trows := declaredRows()\n796|\tmatched := make([]bool, len(derived))\n797|\tfor _, row := range rows {\n798|\t\tmatches := []int{}\n799|\t\tfor index, arm := range derived {\n800|\t\t\tif armMatchesRow(arm, row) {\n801|\t\t\t\tmatches = append(matches, index)\n802|\t\t\t}\n803|\t\t}\n804|\t\tif len(matches) != 1 {\n805|\t\t\tt.Errorf(\"declared row %s resolves to %d derived arms, want exactly one\",\n806|\t\t\t\tdescribeRow(row), len(matches))\n807|\t\t\tcontinue\n808|\t\t}\n809|\t\tif matched[matches[0]] {\n810|\t\t\tt.Errorf(\"declared row %s claims an arm an earlier row already claimed: %s\",\n811|\t\t\t\tdescribeRow(row), describeArm(derived[matches[0]]))\n812|\t\t\tcontinue\n813|\t\t}\n814|\t\tmatched[matches[0]] = true\n815|\t}\n816|\tfor index, claimed := range matched {\n817|\t\tif !claimed {\n818|\t\t\tt.Errorf(\"derived arm has no declaring row, so nothing witnesses it: %s\",\n819|\t\t\t\tdescribeArm(derived[index]))\n820|\t\t}\n821|\t}\n822|}\n823|\n824|// TestDeclaredRefusalArmsAreAllDerived is the reverse direction: every\n825|// declared row resolves to exactly one derived arm. Without it the\n826|// forward direction passes vacuously on a truncated derivation, and a\n827|// deleted production guard lingers as a row pointing at nothing.\n828|func TestDeclaredRefusalArmsAreAllDerived(t *testing.T) {\n829|\tt.Parallel()\n830|\n831|\tderived := deriveRefusalArms(t)\n832|\tfor _, row := range declaredRows() {\n833|\t\tmatches := 0\n834|\t\tfor _, arm := range derived {\n835|\t\t\tif armMatchesRow(arm, row) {\n836|\t\t\t\tmatches++\n837|\t\t\t}\n838|\t\t}\n839|\t\tif matches != 1 {\n840|\t\t\tt.Errorf(\"declared row %s matches %d derived arms, want exactly one; \"+\n841|\t\t\t\t\"a row without an arm is a witness without a guard\", describeRow(row), matches)\n842|\t\t}\n843|\t}\n844|\tif len(derived) != len(declaredRows()) {\n845|\t\tt.Errorf(\"derived %d arms but declared %d rows; the table is not a bijection\",\n846|\t\t\tlen(derived), len(declaredRows()))\n847|\t}\n848|}\n849|\n850|func armMatchesRow(arm refusalArm, row declaredRefusalArm) bool {\n851|\treturn arm.file == row.file && arm.function == row.function &&\n852|\t\tarm.code == row.code && arm.detail == row.detail &&\n853|\t\tarm.occurrence == row.occurrence\n854|}\n855|\n856|func describeArm(arm refusalArm) string {\n857|\treturn arm.file + \" \" + arm.function + \" \" + arm.code + \" \" +\n858|\t\tstrconv.Quote(arm.detail) + \" #\" + strconv.Itoa(arm.occurrence)\n859|}\n860|\n861|func describeRow(row declaredRefusalArm) string {\n862|\treturn row.file + \" \" + row.function + \" \" + row.code + \" \" +\n863|\t\tstrconv.Quote(row.detail) + \" #\" + strconv.Itoa(row.occurrence)\n864|}\n865|\n866|// declaredRows returns the table plus the funnel row.\n867|func declaredRows() []declaredRefusalArm {\n868|\trows := append([]declaredRefusalArm(nil), declaredRefusalArms...)\n869|\tfunnel := funneledPlatformArm\n870|\tfunnel.detailSet = funneledPlatformDetails\n871|\treturn append(rows, funnel)\n872|}\n873|\n874|// TestDeclaredRefusalWiresMatchProductionConsts binds the table to the\n875|// production const values two ways: every row's code resolves to the\n876|// wire its test asserts, and every Code symbol except the named armless\n877|// one appears in at least one row, so a code nobody refuses is a red\n878|// rather than a quiet gap.\n879|func TestDeclaredRefusalWiresMatchProductionConsts(t *testing.T) {\n880|\tt.Parallel()\n881|\n882|\tsymbols := productionCodeSymbols(t)\n883|\tcovered := make(map[string]bool)\n884|\tfor _, row := range declaredRows() {\n885|\t\twire, known := symbols[row.code]\n886|\t\tif !known {\n887|\t\t\tt.Errorf(\"declared row %s names unknown code symbol %q\",\n888|\t\t\t\tdescribeRow(row), row.code)\n889|\t\t\tcontinue\n890|\t\t}\n891|\t\tcovered[row.code] = true\n892|\t\t_ = wire\n893|\t}\n894|\tfor symbol := range symbols {\n895|\t\tif armlessCodes[symbol] {\n896|\t\t\tcontinue\n897|\t\t}\n898|\t\tif !covered[symbol] {\n899|\t\t\tt.Errorf(\"code symbol %s has no refusal arm; a wire code nothing refuses is unwitnessed\", symbol)\n900|\t\t}\n901|\t}\n902|}\n903|\n904|// TestDeclaredRefusalTestsResolve requires every row to name real tests\n905|// that textually touch the arm: the detail literal, or the driven entry\n906|// plus the wire code (or its verified predicate). Bound rows name a test\n907|// driving the entry; the bound itself says why no document reaches them.\n908|func TestDeclaredRefusalTestsResolve(t *testing.T) {\n909|\tt.Parallel()\n910|\n911|\tbodies := testBodies(t)\n912|\tpredicates := predicateCodes(t)\n913|\tsymbols := productionCodeSymbols(t)\n914|\tfor _, row := range declaredRows() {\n915|\t\tif len(row.tests) == 0 {\n916|\t\t\tt.Errorf(\"declared row %s names no test, so nothing measures it\", describeRow(row))\n917|\t\t\tcontinue\n918|\t\t}\n919|\t\tresolved := false\n920|\t\tfor _, reference := range row.tests {\n921|\t\t\tbody, declared := bodies[reference.file+\"\\n\"+reference.test]\n922|\t\t\tif !declared {\n923|\t\t\t\tt.Errorf(\"declared row %s names %s in %s, which is not declared\",\n924|\t\t\t\t\tdescribeRow(row), reference.test, reference.file)\n925|\t\t\t\tcontinue\n926|\t\t\t}\n927|\t\t\tif rowResolves(row, body, predicates, symbols) {\n928|\t\t\t\tresolved = true\n929|\t\t\t}\n930|\t\t}\n931|\t\tif !resolved {\n932|\t\t\tt.Errorf(\"declared row %s names no test touching it: want the detail %q or the entry %q \"+\n933|\t\t\t\t\"with its wire code in %v\", describeRow(row), row.detail, row.entry, row.tests)\n934|\t\t}\n935|\t}\n936|}\n937|\n938|// rowResolves reports whether one test body touches one row.\n939|func rowResolves(row declaredRefusalArm, body string, predicates map[string]string, symbols map[string]string) bool {\n940|\tif row.detail == passthroughDetail {\n941|\t\tfor _, detail := range row.detailSet {\n942|\t\t\tif !strings.Contains(body, detail) {\n943|\t\t\t\treturn false\n944|\t\t\t}\n945|\t\t}\n946|\t\treturn strings.Contains(body, row.entry)\n947|\t}\n948|\tif strings.Contains(body, row.detail) {\n949|\t\treturn true\n950|\t}\n951|\tif row.bound != \"\" {\n952|\t\treturn strings.Contains(body, row.entry)\n953|\t}\n954|\tif !strings.Contains(body, row.entry) {\n955|\t\treturn false\n956|\t}\n957|\tif strings.Contains(body, symbols[row.code]) {\n958|\t\treturn true\n959|\t}\n960|\tfor predicate, code := range predicates {\n961|\t\tif code == row.code && strings.Contains(body, predicate) {\n962|\t\t\treturn true\n963|\t\t}\n964|\t}\n965|\treturn false\n966|}\n967|\n968|// TestDefensiveBoundsAreExactlyThese pins the set of bound rows: a new\n969|// defensive arm must join this set deliberately, with its bound stated,\n970|// rather than slipping in as an ordinary row whose test cannot reach it.\n971|func TestDefensiveBoundsAreExactlyThese(t *testing.T) {\n972|\tt.Parallel()\n973|\n974|\twant := map[string]bool{\n975|\t\t\"conformance.go ParseAttachAuthorization CodeMismatch \\\"document timestamp\\\" #1\": true,\n976|\t\t\"conformance.go ParseAttachAuthorization CodeMismatch \\\"document timestamp\\\" #2\": true,\n977|\t\t\"conformance.go CheckAttachRequest CodeMismatch \\\"document timestamp\\\" #1\":       true,\n978|\t\t\"manifest.go checkEvidenceLiveness CodeMismatch \\\"document timestamp\\\" #1\":       true,\n979|\t\t\"manifest.go checkEvidenceLiveness CodeMismatch \\\"document timestamp\\\" #2\":       true,\n980|\t}\n981|\tfor _, row := range declaredRows() {\n982|\t\tif row.bound == \"\" {\n983|\t\t\tcontinue\n984|\t\t}\n985|\t\tif row.bound != boundDefensiveReparse {\n986|\t\t\tt.Errorf(\"declared row %s carries an unrecognized bound %q\",\n987|\t\t\t\tdescribeRow(row), row.bound)\n988|\t\t\tcontinue\n989|\t\t}\n990|\t\tif !want[describeRow(row)] {\n991|\t\t\tt.Errorf(\"declared row %s claims a bound outside the pinned set; \"+\n992|\t\t\t\t\"a new defensive arm joins deliberately or not at all\", describeRow(row))\n993|\t\t}\n994|\t}\n995|\tbound := 0\n996|\tfor _, row := range declaredRows() {\n997|\t\tif row.bound != \"\" {\n998|\t\t\tbound++\n999|\t\t}\n1000|\t}\n1001|\tif bound != len(want) {\n1002|\t\tt.Errorf(\"declared %d bound rows, want exactly the pinned %d\", bound, len(want))\n1003|\t}\n1004|}\n1005|\n1006|// TestPlatformFunnelDetailsAreExactlyThese derives the error set of\n1007|// validatePlatforms from the production AST and requires it to equal the\n1008|// funneled set: a fourth platform error widens the funnel this test pins.\n1009|func TestPlatformFunnelDetailsAreExactlyThese(t *testing.T) {\n1010|\tt.Parallel()\n1011|\n1012|\tfileSet := token.NewFileSet()\n1013|\tfile, err := parser.ParseFile(fileSet, \"terminalbackend.go\", nil, 0)\n1014|\tif err != nil {\n1015|\t\tt.Fatalf(\"parse terminalbackend.go: %v\", err)\n1016|\t}\n1017|\tdetails := map[string]bool{}\n1018|\tfor _, declaration := range file.Decls {\n1019|\t\tfunction, ok := declaration.(*ast.FuncDecl)\n1020|\t\tif !ok || function.Name.Name != \"validatePlatforms\" {\n1021|\t\t\tcontinue\n1022|\t\t}\n1023|\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n1024|\t\t\tcall, ok := node.(*ast.CallExpr)\n1025|\t\t\tif !ok {\n1026|\t\t\t\treturn true\n1027|\t\t\t}\n1028|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n1029|\t\t\tif !ok || selector.Sel.Name != \"New\" {\n1030|\t\t\t\treturn true\n1031|\t\t\t}\n1032|\t\t\treceiver, ok := selector.X.(*ast.Ident)\n1033|\t\t\tif !ok || receiver.Name != \"errors\" || len(call.Args) != 1 {\n1034|\t\t\t\treturn true\n1035|\t\t\t}\n1036|\t\t\tliteral, ok := call.Args[0].(*ast.BasicLit)\n1037|\t\t\tif !ok || literal.Kind != token.STRING {\n1038|\t\t\t\tt.Fatalf(\"validatePlatforms error is not a static literal\")\n1039|\t\t\t\treturn true\n1040|\t\t\t}\n1041|\t\t\tdetail, err := strconv.Unquote(literal.Value)\n1042|\t\t\tif err != nil {\n1043|\t\t\t\tt.Fatalf(\"unquote platform error: %v\", err)\n1044|\t\t\t}\n1045|\t\t\tdetails[detail] = true\n1046|\t\t\treturn true\n1047|\t\t})\n1048|\t}\n1049|\tif len(details) == 0 {\n1050|\t\tt.Fatal(\"derived zero platform errors; the scanner is broken, not the package\")\n1051|\t}\n1052|\tfor _, want := range funneledPlatformDetails {\n1053|\t\tif !details[want] {\n1054|\t\t\tt.Errorf(\"funneled detail %q no longer derives from validatePlatforms\", want)\n1055|\t\t}\n1056|\t}\n1057|\tfor detail := range details {\n1058|\t\tknown := false\n1059|\t\tfor _, want := range funneledPlatformDetails {\n1060|\t\t\tif detail == want {\n1061|\t\t\t\tknown = true\n1062|\t\t\t}\n1063|\t\t}\n1064|\t\tif !known {\n1065|\t\t\tt.Errorf(\"validatePlatforms derives %q, outside the funneled set; \"+\n1066|\t\t\t\t\"a fourth platform error widens the funnel\", detail)\n1067|\t\t}\n1068|\t}\n1069|}\n1070|\n1071|// TestPlainErrorsLiveOnlyInTheirTwoFunctions closes the smuggling hole:\n1072|// a non-wire error constructed anywhere but validatePlatforms (the\n1073|// pinned funnel) or DigestFile (I/O) fails, so a refusal wearing a plain\n1074|// error's clothes cannot ship unwitnessed.\n1075|//\n1076|// Coverage is declaration-complete like deriveRefusalArms above: every\n1077|// FuncDecl body (receiver-qualified for methods) plus every package-level\n1078|// var initializer is scanned, so a plain error hiding in a package-level\n1079|// `var errPlanted = errors.New(…)` or a `var f = func() error {…}`\n1080|// literal is caught like any other. An unused package-level plain error\n1081|// still fails: its initializer runs at package init, so the construction\n1082|// is real whether or not any caller returns it. An alias\n1083|// (`newPlain := errors.New`) is rejected outright by\n1084|// rejectPlainErrorAliases below: the allowlist scan matches only direct\n1085|// selector calls, so an aliased construction would ship unattributed.\n1086|// Custom error types outside the two recognised spellings are a stated\n1087|// bound above, not covered here.\n1088|func TestPlainErrorsLiveOnlyInTheirTwoFunctions(t *testing.T) {\n1089|\tt.Parallel()\n1090|\n1091|\tmatches, err := filepath.Glob(\"*.go\")\n1092|\tif err != nil {\n1093|\t\tt.Fatalf(\"glob production files: %v\", err)\n1094|\t}\n1095|\tfor _, name := range matches {\n1096|\t\tif strings.HasSuffix(name, \"_test.go\") {\n1097|\t\t\tcontinue\n1098|\t\t}\n1099|\t\tfileSet := token.NewFileSet()\n1100|\t\tfile, err := parser.ParseFile(fileSet, name, nil, 0)\n1101|\t\tif err != nil {\n1102|\t\t\tt.Fatalf(\"parse %s: %v\", name, err)\n1103|\t\t}\n1104|\t\trejectPlainErrorAliases(t, file, name)\n1105|\t\tcheck := func(functionName string, root ast.Node) {\n1106|\t\t\tast.Inspect(root, func(node ast.Node) bool {\n1107|\t\t\t\tcall, ok := node.(*ast.CallExpr)\n1108|\t\t\t\tif !ok {\n1109|\t\t\t\t\treturn true\n1110|\t\t\t\t}\n1111|\t\t\t\tif isPlainErrorConstruction(call) && !plainErrorFunctions[functionName] {\n1112|\t\t\t\t\tt.Errorf(\"%s constructs a non-wire error in %s, outside the two allowlisted functions; \"+\n1113|\t\t\t\t\t\t\"a refusal wearing a plain error's clothes ships unwitnessed\", name, functionName)\n1114|\t\t\t\t}\n1115|\t\t\t\treturn true\n1116|\t\t\t})\n1117|\t\t}\n1118|\t\tfor _, declaration := range file.Decls {\n1119|\t\t\tswitch decl := declaration.(type) {\n1120|\t\t\tcase *ast.FuncDecl:\n1121|\t\t\t\tif decl.Body == nil {\n1122|\t\t\t\t\tcontinue\n1123|\t\t\t\t}\n1124|\t\t\t\tfunctionName := decl.Name.Name\n1125|\t\t\t\tif decl.Recv != nil && len(decl.Recv.List) > 0 {\n1126|\t\t\t\t\tfunctionName = receiverTypeName(decl.Recv.List[0].Type) + \".\" + functionName\n1127|\t\t\t\t}\n1128|\t\t\t\tcheck(functionName, decl.Body)\n1129|\t\t\tcase *ast.GenDecl:\n1130|\t\t\t\t// Package-level initializers execute outside any FuncDecl,\n1131|\t\t\t\t// so a plain error assigned to a package var would\n1132|\t\t\t\t// otherwise ship invisible. Attribute its constructions\n1133|\t\t\t\t// to the declared variable name.\n1134|\t\t\t\tfor _, spec := range decl.Specs {\n1135|\t\t\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n1136|\t\t\t\t\tif !ok {\n1137|\t\t\t\t\t\tcontinue\n1138|\t\t\t\t\t}\n1139|\t\t\t\t\tfunctionName := \"var\"\n1140|\t\t\t\t\tif len(value.Names) > 0 {\n1141|\t\t\t\t\t\tfunctionName = value.Names[0].Name\n1142|\t\t\t\t\t}\n1143|\t\t\t\t\tfor _, item := range value.Values {\n1144|\t\t\t\t\t\tcheck(functionName, item)\n1145|\t\t\t\t\t}\n1146|\t\t\t\t}\n1147|\t\t\t}\n1148|\t\t}\n1149|\t}\n1150|}\n1151|\n1152|// isPlainErrorConstruction reports the two recognised plain-error\n1153|// spellings: errors.New and fmt.Errorf (any Errorf-prefixed constructor).\n1154|func isPlainErrorConstruction(call *ast.CallExpr) bool {\n1155|\tselector, ok := call.Fun.(*ast.SelectorExpr)\n1156|\tif !ok {\n1157|\t\treturn false\n1158|\t}\n1159|\treturn isPlainErrorSelector(selector)\n1160|}\n1161|\n1162|// isPlainErrorSelector reports the selector half of the two recognised\n1163|// plain-error spellings, mirroring isPlainErrorConstruction without\n1164|// requiring call position.\n1165|func isPlainErrorSelector(selector *ast.SelectorExpr) bool {\n1166|\treceiver, ok := selector.X.(*ast.Ident)\n1167|\tif !ok {\n1168|\t\treturn false\n1169|\t}\n1170|\tif receiver.Name == \"errors\" && selector.Sel.Name == \"New\" {\n1171|\t\treturn true\n1172|\t}\n1173|\treturn receiver.Name == \"fmt\" && strings.HasPrefix(selector.Sel.Name, \"Errorf\")\n1174|}\n1175|\n1176|// rejectPlainErrorAliases fails the suite when a plain-error constructor\n1177|// (errors.New, fmt.Errorf and its Errorf-prefixed kin) is referenced\n1178|// outside direct-call position. `newPlain := errors.New; newPlain(\"…\")`\n1179|// ships a reachable construction the allowlist scan above cannot attribute\n1180|// to a static call site — isPlainErrorConstruction matches only direct\n1181|// selector calls — so the reference itself is the violation: call the\n1182|// constructor directly. The alias is rejected in every function, including\n1183|// the two allowlisted ones, because an aliased construction inside\n1184|// validatePlatforms would bypass the funneled detail pin.\n1185|func rejectPlainErrorAliases(t *testing.T, file *ast.File, name string) {\n1186|\tt.Helper()\n1187|\n1188|\tallowed := map[token.Pos]bool{}\n1189|\tast.Inspect(file, func(node ast.Node) bool {\n1190|\t\tcall, ok := node.(*ast.CallExpr)\n1191|\t\tif !ok || !isPlainErrorConstruction(call) {\n1192|\t\t\treturn true\n1193|\t\t}\n1194|\t\tif selector, ok := call.Fun.(*ast.SelectorExpr); ok {\n1195|\t\t\tallowed[selector.Sel.Pos()] = true\n1196|\t\t}\n1197|\t\treturn true\n1198|\t})\n1199|\tast.Inspect(file, func(node ast.Node) bool {\n1200|\t\tselector, ok := node.(*ast.SelectorExpr)\n1201|\t\tif !ok || !isPlainErrorSelector(selector) || allowed[selector.Sel.Pos()] {\n1202|\t\t\treturn true\n1203|\t\t}\n1204|\t\tt.Fatalf(\"%s: plain-error constructor %q referenced outside direct-call position; \"+\n1205|\t\t\t\"an aliased plain error cannot be allowlisted, call it directly\", name, selector.Sel.Name)\n1206|\t\treturn true\n1207|\t})\n1208|}\n1209|\n1210|// TestDigestFileRefusalsAreNeverWireErrors pins the allowlist's other\n1211|// half behaviorally: DigestFile failures are I/O errors, never *Error,\n1212|// so no caller can mistake them for a registry refusal.\n1213|func TestDigestFileRefusalsAreNeverWireErrors(t *testing.T) {\n1214|\tt.Parallel()\n1215|\n1216|\tfor _, path := range []string{\n1217|\t\tfilepath.Join(\"testdata\", \"no-such-executable\"),\n1218|\t\t\"\",\n1219|\t} {\n1220|\t\t_, err := DigestFile(path)\n1221|\t\tif err == nil {\n1222|\t\t\tt.Errorf(\"DigestFile(%q) = nil, want an I/O error\", path)\n1223|\t\t\tcontinue\n1224|\t\t}\n1225|\t\tvar refusal *Error\n1226|\t\tif errors.As(err, &refusal) {\n1227|\t\t\tt.Errorf(\"DigestFile(%q) error = %v, want a plain I/O error, never a wire refusal\", path, err)\n1228|\t\t}\n1229|\t}\n(more lines below)"}}}
