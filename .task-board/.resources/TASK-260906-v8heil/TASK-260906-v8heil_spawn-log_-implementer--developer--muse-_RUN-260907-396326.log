{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ce81","stream":{"kind":"session","id":"01a0798e-8ce3-71d2-82cf-4115ffc6a2dc"},"sequence":1435,"recorded_at":1780531400002865,"record_type":"event","durability":"durable","causation_id":"f7e88212-ef87-40d2-a1db-8797ebe2238a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f7e88212-ef87-40d2-a1db-8797ebe2238a","run_stream":{"kind":"run","id":"f7e88212-ef87-40d2-a1db-8797ebe2238a"},"task_stream":{"kind":"task","id":"3fb16afe-09b9-4e69-933b-88bdcffcd49b"},"task_id":"3fb16afe-09b9-4e69-933b-88bdcffcd49b","event":{"kind":"output","task_id":"3fb16afe-09b9-4e69-933b-88bdcffcd49b","chunk":"Read text file `internal/terminalbackend/refusal_arm_inventory_test.go`.\n(199 line(s) above)\n200|\t\t\t\t\tif err != nil {\n201|\t\t\t\t\t\tt.Fatalf(\"%s: unquote detail: %v\", functionName, err)\n202|\t\t\t\t\t}\n203|\t\t\t\t\tcode := \"CodeMismatch\"\n204|\t\t\t\t\tif identifier.Name == \"integrityFailure\" {\n205|\t\t\t\t\t\tcode = \"CodeIntegrityFailure\"\n206|\t\t\t\t\t}\n207|\t\t\t\t\tarms = append(arms, refusalArm{\n208|\t\t\t\t\t\tfile: name, function: functionName, code: code, detail: detail,\n209|\t\t\t\t\t})\n210|\t\t\t\t}\n211|\t\t\t\treturn true\n212|\t\t\t})\n213|\t\t}\n214|\t\tfor _, declaration := range file.Decls {\n215|\t\t\tswitch decl := declaration.(type) {\n216|\t\t\tcase *ast.FuncDecl:\n217|\t\t\t\tif decl.Body == nil {\n218|\t\t\t\t\tcontinue\n219|\t\t\t\t}\n220|\t\t\t\tif constructorFunctions[decl.Name.Name] {\n221|\t\t\t\t\tcontinue\n222|\t\t\t\t}\n223|\t\t\t\tfunctionName := decl.Name.Name\n224|\t\t\t\tif decl.Recv != nil && len(decl.Recv.List) > 0 {\n225|\t\t\t\t\tfunctionName = receiverTypeName(decl.Recv.List[0].Type) + \".\" + functionName\n226|\t\t\t\t}\n227|\t\t\t\tcollect(functionName, decl.Body)\n228|\t\t\tcase *ast.GenDecl:\n229|\t\t\t\t// Package-level initializers execute outside any FuncDecl,\n230|\t\t\t\t// so a func literal (or a bare &Error{}) assigned to a\n231|\t\t\t\t// package var would otherwise ship invisible. Attribute\n232|\t\t\t\t// its arms to the declared variable name.\n233|\t\t\t\tfor _, spec := range decl.Specs {\n234|\t\t\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n235|\t\t\t\t\tif !ok {\n236|\t\t\t\t\t\tcontinue\n237|\t\t\t\t\t}\n238|\t\t\t\t\tfunctionName := \"var\"\n239|\t\t\t\t\tif len(value.Names) > 0 {\n240|\t\t\t\t\t\tfunctionName = value.Names[0].Name\n241|\t\t\t\t\t}\n242|\t\t\t\t\tfor _, item := range value.Values {\n243|\t\t\t\t\t\tcollect(functionName, item)\n244|\t\t\t\t\t}\n245|\t\t\t\t}\n246|\t\t\t}\n247|\t\t}\n248|\t\trejectConstructorAliases(t, file, name)\n249|\t}\n250|\t_ = parsed\n251|\tif len(arms) == 0 {\n252|\t\tt.Fatal(\"derived zero refusal arms from the package sources; the scanner is broken, not the package\")\n253|\t}\n254|\toccurrences := make(map[refusalArm]int)\n255|\tfor index := range arms {\n256|\t\tkey := arms[index]\n257|\t\tkey.occurrence = 0\n258|\t\toccurrences[key]++\n259|\t\tarms[index].occurrence = occurrences[key]\n260|\t}\n261|\treturn arms\n262|}\n263|\n264|// rejectConstructorAliases fails the suite when a refusal constructor\n265|// (mismatchf, integrityFailure) is referenced outside direct-call\n266|// position. `refuse := mismatchf; refuse(\"…\")` ships a reachable arm the\n267|// arm derivation above cannot attribute to a static call site, so the\n268|// reference itself is the violation: call the constructor directly.\n269|// The constructors' own declarations are excluded; their bodies are the\n270|// funnel, not arms. Any other use — alias, argument, field, shadow —\n271|// fails closed, because no legitimate production shape needs it.\n272|func rejectConstructorAliases(t *testing.T, file *ast.File, name string) {\n273|\tt.Helper()\n274|\n275|\tallowed := map[token.Pos]bool{}\n276|\tast.Inspect(file, func(node ast.Node) bool {\n277|\t\tdeclaration, ok := node.(*ast.FuncDecl)\n278|\t\tif !ok {\n279|\t\t\tif call, ok := node.(*ast.CallExpr); ok {\n280|\t\t\t\tif identifier, ok := call.Fun.(*ast.Ident); ok && constructorFunctions[identifier.Name] {\n281|\t\t\t\t\tallowed[identifier.Pos()] = true\n282|\t\t\t\t}\n283|\t\t\t}\n284|\t\t\treturn true\n285|\t\t}\n286|\t\tif constructorFunctions[declaration.Name.Name] {\n287|\t\t\tallowed[declaration.Name.Pos()] = true\n288|\t\t\treturn false\n289|\t\t}\n290|\t\treturn true\n291|\t})\n292|\tast.Inspect(file, func(node ast.Node) bool {\n293|\t\tdeclaration, ok := node.(*ast.FuncDecl)\n294|\t\tif ok && constructorFunctions[declaration.Name.Name] {\n295|\t\t\treturn false\n296|\t\t}\n297|\t\tidentifier, ok := node.(*ast.Ident)\n298|\t\tif !ok || !constructorFunctions[identifier.Name] || allowed[identifier.Pos()] {\n299|\t\t\treturn true\n300|\t\t}\n301|\t\tt.Fatalf(\"%s: constructor %q referenced outside direct-call position; \"+\n302|\t\t\t\"an aliased refusal cannot be inventoried, call it directly\", name, identifier.Name)\n303|\t\treturn true\n304|\t})\n305|}\n306|\n307|// receiverTypeName renders a method receiver type to its bare name.\n308|func receiverTypeName(expression ast.Expr) string {\n309|\tswitch typed := expression.(type) {\n310|\tcase *ast.Ident:\n311|\t\treturn typed.Name\n312|\tcase *ast.StarExpr:\n313|\t\treturn receiverTypeName(typed.X)\n314|\tdefault:\n(more lines below)"}}}
