{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5a1","stream":{"kind":"session","id":"01a0798e-8ce3-71d2-82cf-4115ffc6a2dc"},"sequence":299,"recorded_at":1780531400000593,"record_type":"event","durability":"durable","causation_id":"f7e88212-ef87-40d2-a1db-8797ebe2238a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f7e88212-ef87-40d2-a1db-8797ebe2238a","run_stream":{"kind":"run","id":"f7e88212-ef87-40d2-a1db-8797ebe2238a"},"task_stream":{"kind":"task","id":"4658f1b1-d222-485a-b5b4-02c13191e7af"},"task_id":"4658f1b1-d222-485a-b5b4-02c13191e7af","event":{"kind":"output","task_id":"4658f1b1-d222-485a-b5b4-02c13191e7af","chunk":"Read text file `internal/provider/source_inventory_test.go`.\n1|package provider\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"go/ast\"\n6|\t\"go/parser\"\n7|\t\"go/token\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"sort\"\n11|\t\"strings\"\n12|\t\"testing\"\n13|)\n14|\n15|// discoverSourceSites are the external-discovery call sites derived from\n16|// the production Discover body: every directory enumeration must flow\n17|// through collectDirectory, and no external Candidate may be built inline.\n18|type discoverSourceSites struct {\n19|\t// collectClasses are the source-label classes of the collectDirectory\n20|\t// call sites: \"plugin_dirs\" or \"path\".\n21|\tcollectClasses []string\n22|\t// directReads counts system.ReadDir calls inside Discover itself.\n23|\tdirectReads int\n24|\t// directNameParses counts externalID calls inside Discover itself.\n25|\tdirectNameParses int\n26|\t// inlineExternals counts KindExternal Candidate literals inside\n27|\t// Discover itself.\n28|\tinlineExternals int\n29|\t// inlineBuiltins counts KindBuiltin Candidate literals inside\n30|\t// Discover itself.\n31|\tinlineBuiltins int\n32|}\n33|\n34|// deriveDiscoverSourceSites parses the production Discover function out of\n35|// provider.go, never from memory: a discovery source added to production\n36|// without flowing through collectDirectory changes these counts and\n37|// reddens the inventory test below.\n38|func deriveDiscoverSourceSites(t *testing.T) discoverSourceSites {\n39|\tt.Helper()\n40|\tpath := filepath.Join(mustProviderDir(t), \"provider.go\")\n41|\tsource, err := os.ReadFile(path)\n42|\tif err != nil {\n43|\t\tt.Fatalf(\"read provider.go: %v\", err)\n44|\t}\n45|\tfileSet := token.NewFileSet()\n46|\tsyntax, err := parser.ParseFile(fileSet, path, source, 0)\n47|\tif err != nil {\n48|\t\tt.Fatalf(\"parse provider.go: %v\", err)\n49|\t}\n50|\tvar body *ast.BlockStmt\n51|\tfor _, decl := range syntax.Decls {\n52|\t\tfn, ok := decl.(*ast.FuncDecl)\n53|\t\tif ok && fn.Name.Name == \"Discover\" && fn.Recv == nil {\n54|\t\t\tbody = fn.Body\n55|\t\t}\n56|\t}\n57|\tif body == nil {\n58|\t\tt.Fatal(\"production func Discover not found in provider.go\")\n59|\t}\n60|\t// Resolve the source-label variables assigned inside Discover (the\n61|\t// plugin loop builds `source := fmt.Sprintf(\"plugin_dirs[%d]\", index)`\n62|\t// and passes the variable): each such assignment maps a name to its\n63|\t// class so call-site arguments written as identifiers stay classified.\n64|\tassigned := map[string]string{}\n65|\tast.Inspect(body, func(node ast.Node) bool {\n66|\t\tswitch stmt := node.(type) {\n67|\t\tcase *ast.AssignStmt:\n68|\t\t\tfor i, lhs := range stmt.Lhs {\n69|\t\t\t\tif ident, ok := lhs.(*ast.Ident); ok && i < len(stmt.Rhs) {\n70|\t\t\t\t\tif class, ok := sprintfSourceClass(stmt.Rhs[i]); ok {\n71|\t\t\t\t\t\tassigned[ident.Name] = class\n72|\t\t\t\t\t}\n73|\t\t\t\t}\n74|\t\t\t}\n75|\t\tcase *ast.ValueSpec:\n76|\t\t\tfor i, name := range stmt.Names {\n77|\t\t\t\tif i < len(stmt.Values) {\n78|\t\t\t\t\tif class, ok := sprintfSourceClass(stmt.Values[i]); ok {\n79|\t\t\t\t\t\tassigned[name.Name] = class\n80|\t\t\t\t\t}\n81|\t\t\t\t}\n82|\t\t\t}\n83|\t\t}\n84|\t\treturn true\n85|\t})\n86|\tvar sites discoverSourceSites\n87|\tast.Inspect(body, func(node ast.Node) bool {\n88|\t\tif literal, ok := node.(*ast.CompositeLit); ok {\n89|\t\t\tif ident, ok := literal.Type.(*ast.Ident); ok && ident.Name == \"Candidate\" {\n90|\t\t\t\tfor _, elt := range literal.Elts {\n91|\t\t\t\t\tfield, ok := elt.(*ast.KeyValueExpr)\n92|\t\t\t\t\tif !ok {\n93|\t\t\t\t\t\tcontinue\n94|\t\t\t\t\t}\n95|\t\t\t\t\tkey, ok := field.Key.(*ast.Ident)\n96|\t\t\t\t\tif !ok || key.Name != \"kind\" {\n97|\t\t\t\t\t\tcontinue\n98|\t\t\t\t\t}\n99|\t\t\t\t\tif value, ok := field.Value.(*ast.Ident); ok {\n100|\t\t\t\t\t\tswitch value.Name {\n101|\t\t\t\t\t\tcase \"KindExternal\":\n102|\t\t\t\t\t\t\tsites.inlineExternals++\n103|\t\t\t\t\t\tcase \"KindBuiltin\":\n104|\t\t\t\t\t\t\tsites.inlineBuiltins++\n105|\t\t\t\t\t\t}\n106|\t\t\t\t\t}\n107|\t\t\t\t}\n108|\t\t\t}\n109|\t\t\treturn true\n110|\t\t}\n111|\t\tcall, ok := node.(*ast.CallExpr)\n112|\t\tif !ok {\n113|\t\t\treturn true\n114|\t\t}\n115|\t\tswitch fun := call.Fun.(type) {\n116|\t\tcase *ast.Ident:\n117|\t\t\tswitch fun.Name {\n118|\t\t\tcase \"collectDirectory\":\n119|\t\t\t\tif len(call.Args) < 4 {\n120|\t\t\t\t\tt.Fatalf(\"collectDirectory call has %d args, want >= 4\", len(call.Args))\n(more lines below)"}}}
