{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ce39","stream":{"kind":"session","id":"01a0798e-8ce3-71d2-82cf-4115ffc6a2dc"},"sequence":1399,"recorded_at":1780531400002793,"record_type":"event","durability":"durable","causation_id":"f7e88212-ef87-40d2-a1db-8797ebe2238a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f7e88212-ef87-40d2-a1db-8797ebe2238a","run_stream":{"kind":"run","id":"f7e88212-ef87-40d2-a1db-8797ebe2238a"},"task_stream":{"kind":"task","id":"0045fe27-f470-48ac-a724-6cbbf64c1405"},"task_id":"0045fe27-f470-48ac-a724-6cbbf64c1405","event":{"kind":"output","task_id":"0045fe27-f470-48ac-a724-6cbbf64c1405","chunk":"Read text file `internal/terminalbackend/refusal_arm_inventory_test.go`.\n(61 line(s) above)\n62|//   - Custom error types outside the two recognised spellings (*Error,\n63|//     errors.New, fmt.Errorf) are outside both derivations: a bespoke\n64|//     error type smuggled as a refusal survives. Disclosed, not closed.\n65|//   - Constructor Details are single static literals by assertion: the\n66|//     derivation fatals on any mismatchf/integrityFailure call without\n67|//     exactly one string-literal argument, so format-verb interpolation\n68|//     cannot enter the table. Zero multi-argument sites today; go vet's\n69|//     printf analyzer independently refuses a non-constant format string.\n70|package terminalbackend\n71|\n72|import (\n73|\t\"errors\"\n74|\t\"go/ast\"\n75|\t\"go/parser\"\n76|\t\"go/token\"\n77|\t\"os\"\n78|\t\"path/filepath\"\n79|\t\"strconv\"\n80|\t\"strings\"\n81|\t\"testing\"\n82|)\n83|\n84|// refusalArm is one derived production refusal: a wire-code *Error\n85|// construction site keyed by file, enclosing function (receiver-qualified\n86|// for methods), code symbol, static detail, and occurrence index within\n87|// that key. The index keeps two identical arms in one function distinct:\n88|// adding a second arm with an already-declared key fails on the missing\n89|// #2 row instead of hiding behind #1.\n90|type refusalArm struct {\n91|\tfile       string\n92|\tfunction   string\n93|\tcode       string\n94|\tdetail     string\n95|\toccurrence int\n96|}\n97|\n98|// constructorFunctions build refusals instead of issuing them. Their own\n99|// *Error sites are the funnel, not arms.\n100|var constructorFunctions = map[string]bool{\n101|\t\"mismatchf\":        true,\n102|\t\"integrityFailure\": true,\n103|}\n104|\n105|// passthroughDetail marks the single dynamic-detail funnel: Registration\n106|// validation wraps validatePlatforms errors via err.Error(). Every other\n107|// Detail expression must be a static string literal; a new dynamic detail\n108|// fails the derivation rather than entering the table silently.\n109|const passthroughDetail = \"passthrough:err.Error()\"\n110|\n111|// deriveRefusalArms walks every production file of this package (every\n112|// *.go except *_test.go, so a new production file is scanned without\n113|// anyone remembering it) and returns every refusal arm in source order.\n114|// It fails closed: an unparseable file, a non-static code or detail, and\n115|// an empty result are all fatal, never an empty table.\n116|//\n117|// Coverage is declaration-complete, not FuncDecl-complete: every FuncDecl\n118|// body (including nested func literals, methods, and init) plus every\n119|// package-level var initializer is scanned, so a refusal arm hiding in a\n120|// package-level `var f = func() *Error {...}` is derived like any other.\n121|// Constructor references outside direct-call position (`refuse :=\n122|// mismatchf`) are rejected outright by rejectConstructorAliases below:\n123|// an aliased refusal cannot be inventoried, so it fails the suite rather\n124|// than shipping silently.\n125|func deriveRefusalArms(t *testing.T) []refusalArm {\n126|\tt.Helper()\n127|\n128|\tmatches, err := filepath.Glob(\"*.go\")\n129|\tif err != nil {\n130|\t\tt.Fatalf(\"glob production files: %v\", err)\n131|\t}\n132|\tvar production []string\n133|\tfor _, match := range matches {\n134|\t\tif !strings.HasSuffix(match, \"_test.go\") {\n135|\t\t\tproduction = append(production, match)\n136|\t\t}\n137|\t}\n138|\tif len(production) == 0 {\n139|\t\tt.Fatal(\"derived zero production files; the scanner is broken, not the package\")\n140|\t}\n141|\n142|\tvar arms []refusalArm\n143|\tparsed := 0\n144|\tfor _, name := range production {\n145|\t\tfileSet := token.NewFileSet()\n146|\t\tfile, err := parser.ParseFile(fileSet, name, nil, 0)\n147|\t\tif err != nil {\n148|\t\t\tt.Fatalf(\"parse %s: %v; an unparseable derivation proves nothing\", name, err)\n149|\t\t}\n150|\t\tparsed++\n151|\t\tcollect := func(functionName string, root ast.Node) {\n152|\t\t\tast.Inspect(root, func(node ast.Node) bool {\n153|\t\t\t\tswitch expression := node.(type) {\n154|\t\t\t\tcase *ast.UnaryExpr:\n155|\t\t\t\t\tif expression.Op != token.AND {\n156|\t\t\t\t\t\treturn true\n157|\t\t\t\t\t}\n158|\t\t\t\t\tliteral, ok := expression.X.(*ast.CompositeLit)\n159|\t\t\t\t\tif !ok {\n160|\t\t\t\t\t\treturn true\n161|\t\t\t\t\t}\n162|\t\t\t\t\tidentifier, ok := literal.Type.(*ast.Ident)\n163|\t\t\t\t\tif !ok || identifier.Name != \"Error\" {\n164|\t\t\t\t\t\treturn true\n165|\t\t\t\t\t}\n166|\t\t\t\t\tcode, detail := \"\", \"\"\n167|\t\t\t\t\tfor _, element := range literal.Elts {\n168|\t\t\t\t\t\tpair, ok := element.(*ast.KeyValueExpr)\n169|\t\t\t\t\t\tif !ok {\n170|\t\t\t\t\t\t\tcontinue\n171|\t\t\t\t\t\t}\n172|\t\t\t\t\t\tkey, ok := pair.Key.(*ast.Ident)\n173|\t\t\t\t\t\tif !ok {\n174|\t\t\t\t\t\t\tcontinue\n175|\t\t\t\t\t\t}\n176|\t\t\t\t\t\tswitch key.Name {\n177|\t\t\t\t\t\tcase \"Code\":\n178|\t\t\t\t\t\t\tsymbol, ok := pair.Value.(*ast.Ident)\n179|\t\t\t\t\t\t\tif !ok {\n180|\t\t\t\t\t\t\t\tt.Fatalf(\"%s: refusal code is not a static Code symbol; \"+\n181|\t\t\t\t\t\t\t\t\t\"a computed code cannot be inventoried\", functionName)\n182|\t\t\t\t\t\t\t}\n183|\t\t\t\t\t\t\tcode = symbol.Name\n184|\t\t\t\t\t\tcase \"Detail\":\n185|\t\t\t\t\t\t\tdetail = staticDetail(t, functionName, pair.Value)\n186|\t\t\t\t\t\t}\n187|\t\t\t\t\t}\n188|\t\t\t\t\tif code == \"\" || detail == \"\" {\n189|\t\t\t\t\t\tt.Fatalf(\"%s: refusal without a static code and detail; \"+\n190|\t\t\t\t\t\t\t\"the inventory cannot name what it cannot read\", functionName)\n191|\t\t\t\t\t}\n(more lines below)"}}}
