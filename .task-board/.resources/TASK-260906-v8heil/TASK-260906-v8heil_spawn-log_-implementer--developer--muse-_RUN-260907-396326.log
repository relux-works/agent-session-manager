{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cae7","stream":{"kind":"session","id":"01a0798e-8ce3-71d2-82cf-4115ffc6a2dc"},"sequence":974,"recorded_at":1780531400001943,"record_type":"event","durability":"durable","causation_id":"f7e88212-ef87-40d2-a1db-8797ebe2238a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f7e88212-ef87-40d2-a1db-8797ebe2238a","run_stream":{"kind":"run","id":"f7e88212-ef87-40d2-a1db-8797ebe2238a"},"task_stream":{"kind":"task","id":"ca17929e-7cd4-4c0b-aa89-7ca977280f69"},"task_id":"ca17929e-7cd4-4c0b-aa89-7ca977280f69","event":{"kind":"output","task_id":"ca17929e-7cd4-4c0b-aa89-7ca977280f69","chunk":"edited\nchanged lines: lines 618-635\n--- original\n+++ updated\n@@\n-// digitGuardDigitRune reports whether expr is a decimal digit rune\n-// literal. Escaped spellings of the same code points count: the\n-// gate sees the value, not the spelling.\n-func digitGuardDigitRune(expr ast.Expr) (rune, bool) {\n-\tlit, ok := digitGuardUnparen(expr).(*ast.BasicLit)\n-\tif !ok || lit.Kind != token.CHAR {\n-\t\treturn 0, false\n-\t}\n-\tinner := strings.TrimPrefix(strings.TrimSuffix(lit.Value, \"'\"), \"'\")\n-\tvalue, _, _, err := strconv.UnquoteChar(inner, '\\'')\n-\tif err != nil {\n-\t\treturn 0, false\n-\t}\n-\tif value < '0' || value > '9' {\n-\t\treturn 0, false\n-\t}\n-\treturn value, true\n-}\n+// digitGuardDigitRune reports whether expr spells a decimal digit code\n+// point. Rune literals count in every spelling (the gate sees the value,\n+// not the spelling: '0', '\\x30', '\\u0030'), as do integer code points in\n+// every base (48, 0x30, 0o60, 0X30, 48 with underscores): a gate written\n+// `c < 0x30 || c > 0x39` is the same gate. Named rune constants and\n+// strconv-delegated admission are explicitly OUTSIDE this classifier (see\n+// the stated bounds above): an identifier is not a literal, and an\n+// error-branch gate is not a comparison.\n+func digitGuardDigitRune(expr ast.Expr) (rune, bool) {\n+\tlit, ok := digitGuardUnparen(expr).(*ast.BasicLit)\n+\tif !ok {\n+\t\treturn 0, false\n+\t}\n+\tswitch lit.Kind {\n+\tcase token.CHAR:\n+\t\tinner := strings.TrimPrefix(strings.TrimSuffix(lit.Value, \"'\"), \"'\")\n+\t\tvalue, _, _, err := strconv.UnquoteChar(inner, '\\'')\n+\t\tif err != nil {\n+\t\t\treturn 0, false\n+\t\t}\n+\t\tif value < '0' || value > '9' {\n+\t\t\treturn 0, false\n+\t\t}\n+\t\treturn value, true\n+\tcase token.INT:\n+\t\tvalue, err := strconv.ParseInt(lit.Value, 0, 32)\n+\t\tif err != nil {\n+\t\t\treturn 0, false\n+\t\t}\n+\t\tif value < '0' || value > '9' {\n+\t\t\treturn 0, false\n+\t\t}\n+\t\treturn rune(value), true\n+\tdefault:\n+\t\treturn 0, false\n+\t}\n+}\n"}}}
