n          open('.temp/TASK-260906-v8heil/muts_pv.json', 'w'), indent=1)\\nprint('ok')\\nPYEOF\\npython3 .temp/TASK-260906-v8heil/mutate2.py .temp/TASK-260906-v8heil/muts_pv.json .temp/TASK-260906-v8heil/battery_pv.json 2>&1 | python3 -c \\\"\\nimport sys, json\\nfor line in sys.stdin:\\n    line = line.strip()\\n    if line.startswith('SUMMARY'): print(line); continue\\n    r = json.loads(line)\\n    print(r['id'], r['verdict'], r.get('killers'), 'census_ran=', r.get('census',{}).get('ran'), 'behav_ran=', r.get('behav',{}).get('ran'))\\n    for e in (r.get('census',{}).get('evidence',[])[:2]): print('   census:', e)\\n\\\"\",\n  \"description\": \"Fix full-run mask, rerun provider split\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"ok\\nD-pv-malformed-name KILLED ['census', 'behav'] census_ran= 102 behav_ran= 1\\n   census:     discovery_test.go:210: Discover(\\\"ax-provider-ABC\\\") returned 6 candidates alongside a refusal, want no partial set\\n   census: --- FAIL: TestDiscoverRefusesMalformedNames (0.00s)\\nN-pv-ctor KILLED ['census'] census_ran= 102 behav_ran= 49\\n   census: FAIL\\tgithub.com/relux-works/agent-session-manager/internal/provider\\t0.362s\\n   census: FAIL\\nSUMMARY {\\\"KILLED\\\": 2, \\\"SURVIVED\\\": 0, \\\"NOT_APPLIED\\\": 0, \\\"COMPILE_FAIL\\\": 0}\\n\",\n  \"original_output_bytes\": 505,\n  \"original_output_tokens\": 127,\n  \"truncated\": false\n}"}}}
