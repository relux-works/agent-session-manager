{"schema_version":1,"id":"018f0000-0000-7000-8000-000000010583","stream":{"kind":"session","id":"01a0798e-8ce3-71d2-82cf-4115ffc6a2dc"},"sequence":8476,"recorded_at":1780531400016947,"record_type":"event","durability":"durable","causation_id":"f7e88212-ef87-40d2-a1db-8797ebe2238a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f7e88212-ef87-40d2-a1db-8797ebe2238a","run_stream":{"kind":"run","id":"f7e88212-ef87-40d2-a1db-8797ebe2238a"},"task_stream":{"kind":"task","id":"a7cd2bdb-8c95-4d04-9816-050b4983de12"},"task_id":"a7cd2bdb-8c95-4d04-9816-050b4983de12","event":{"kind":"output","task_id":"a7cd2bdb-8c95-4d04-9816-050b4983de12","chunk":"{\n  \"chunk_id\": \"exec-382-1\",\n  \"command\": \"task-board resource add --help 2>&1 | head -n 20; echo ===; task-board m --help 2>&1 | head -n 30\",\n  \"description\": \"Resource add and mutation syntax\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Attach a new file resource to a board element.\\n\\nSOURCE may be:\\n  - a local filesystem path\\n  - a file:// URL\\n  - an http:// or https:// URL\\n\\nExamples:\\n  task-board resource add TASK-260311-abc ./screenshot.png --type precondition\\n  task-board resource add TASK-260311-abc file:///tmp/report.pdf --name ui-report.pdf\\n  task-board resource add TASK-260311-abc ./report.md --name reports/review/report.md\\n  task-board resource add TASK-260311-abc https://example.com/spec.pdf --type outcome\\n\\nUsage:\\n  task-board resource add <ELEMENT-ID> <SOURCE> [flags]\\n\\nFlags:\\n  -d, --description string   Optional one-line description\\n  -h, --help                 help for add\\n      --name string          Override stored resource filename\\n===\\nExecute a write operation against the board using the DSL.\\n\\nMutations:\\n  set_status(ID, status=..., commit_ack=scope_committed?)\\n                                        Change status; acknowledge enforced done transitions\\n  normalize_legacy_status(ID, expected_raw=..., status=...)\\n                                        Repair one exact unparseable raw status (local boards)\\n  handoff(ID, role=..., status=...)     Verify checklist/outcome evidence and change status\\n  set_estimate(ID, estimate=..., ...)  Set Task/Bug story-point estimate\\n  create(type=..., name=..., ...)      Create element\\n  set_details(ID, title=..., ...)      Update README fields\\n  rename(ID, name=...)                 Rename element name/slug\\n  delete(ID)                           Delete element (destructive)\\n  assign(ID, agent=...)                Assign agent\\n  unassign(ID)                         Remove assignment\\n  link(ID, blocked_by=...)             Add dependency\\n  unlink(ID, blocked_by=...)           Remove dependency\\n  check_item(ID, item=N)              Check checklist item\\n  uncheck_item(ID, item=N)            Uncheck checklist item\\n  add_checklist_item(ID, text=...)     Add checklist item\\n  remove_checklist_item(ID, item=N)    Remove obsolete checklist item (destructive)\\n  set_notes(ID, text=..., set=bool?)   Append/set notes\\n  set_parent(ID, parent=...)           Move to new parent\\n  accept_cr(ID, revision=N, evidence=...) Record a reviewer acceptance of a Change Request revision (local board only)\\n  add_resource(ID, name=..., content=..., type=..., description=...)\\n  update_resource(ID, name=..., content=..., type=..., description=...)\\n  delete_resource(ID, name=...)        Delete resource (destructive)\\n  correct_activity(ID, target_event_id=..., kind=..., reason=...)\\n                                        Privileged append-only correction (destructive)\\n\\n\",\n  \"original_output_bytes\": 2596,\n  \"original_output_tokens\": 649,\n  \"truncated\": false\n}"}}}
