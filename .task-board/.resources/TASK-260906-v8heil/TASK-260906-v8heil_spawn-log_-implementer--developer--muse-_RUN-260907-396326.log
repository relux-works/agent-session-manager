{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cdf1","stream":{"kind":"session","id":"01a0798e-8ce3-71d2-82cf-4115ffc6a2dc"},"sequence":1363,"recorded_at":1780531400002721,"record_type":"event","durability":"durable","causation_id":"f7e88212-ef87-40d2-a1db-8797ebe2238a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f7e88212-ef87-40d2-a1db-8797ebe2238a","run_stream":{"kind":"run","id":"f7e88212-ef87-40d2-a1db-8797ebe2238a"},"task_stream":{"kind":"task","id":"d2271f57-474e-4556-8492-df8796f49943"},"task_id":"d2271f57-474e-4556-8492-df8796f49943","event":{"kind":"output","task_id":"d2271f57-474e-4556-8492-df8796f49943","chunk":"Read text file `internal/terminalbackend/refusal_arm_inventory_test.go`.\n(404 line(s) above)\n405|\t}\n406|\treturn symbols\n407|}\n408|\n409|// testBodies indexes every test declaration in this package by file and\n410|// name to its body source. A duplicate test name across files fails: row\n411|// references would be ambiguous.\n412|func testBodies(t *testing.T) map[string]string {\n413|\tt.Helper()\n414|\n415|\tbodies := make(map[string]string)\n416|\tmatches, err := filepath.Glob(\"*_test.go\")\n417|\tif err != nil {\n418|\t\tt.Fatalf(\"glob test files: %v\", err)\n419|\t}\n420|\tif len(matches) == 0 {\n421|\t\tt.Fatal(\"found zero test files; the scanner is broken, not the package\")\n422|\t}\n423|\tfor _, name := range matches {\n424|\t\traw, err := os.ReadFile(name)\n425|\t\tif err != nil {\n426|\t\t\tt.Fatalf(\"read %s: %v\", name, err)\n427|\t\t}\n428|\t\tfileSet := token.NewFileSet()\n429|\t\tfile, err := parser.ParseFile(fileSet, name, nil, 0)\n430|\t\tif err != nil {\n431|\t\t\tt.Fatalf(\"parse %s: %v\", name, err)\n432|\t\t}\n433|\t\tfor _, declaration := range file.Decls {\n434|\t\t\tfunction, ok := declaration.(*ast.FuncDecl)\n435|\t\t\tif !ok || !strings.HasPrefix(function.Name.Name, \"Test\") {\n436|\t\t\t\tcontinue\n437|\t\t\t}\n438|\t\t\tstart := fileSet.Position(function.Body.Pos()).Offset\n439|\t\t\tend := fileSet.Position(function.Body.End()).Offset\n440|\t\t\tkey := name + \"\\n\" + function.Name.Name\n441|\t\t\tif _, duplicate := bodies[key]; duplicate {\n442|\t\t\t\tt.Fatalf(\"test %s is declared twice; row references would be ambiguous\", key)\n443|\t\t\t}\n444|\t\t\tbodies[key] = string(raw[start:end])\n445|\t\t}\n446|\t}\n447|\tif len(bodies) == 0 {\n448|\t\tt.Fatal(\"indexed zero test declarations, so every row below would resolve vacuously\")\n449|\t}\n450|\treturn bodies\n451|}\n452|\n453|// predicateCodes resolves every Is predicate to the code symbol it\n454|// reports, verifying the shape: a single return of errorCode(err, Code).\n455|// A predicate in any other shape fails: the inventory leans on these to\n456|// resolve code-only assertions, so an unrecognized shape proves nothing.\n457|func predicateCodes(t *testing.T) map[string]string {\n458|\tt.Helper()\n459|\n460|\tpredicates := make(map[string]string)\n461|\tmatches, err := filepath.Glob(\"*.go\")\n462|\tif err != nil {\n463|\t\tt.Fatalf(\"glob production files: %v\", err)\n464|\t}\n465|\tfor _, name := range matches {\n466|\t\tif strings.HasSuffix(name, \"_test.go\") {\n467|\t\t\tcontinue\n468|\t\t}\n469|\t\tfileSet := token.NewFileSet()\n470|\t\tfile, err := parser.ParseFile(fileSet, name, nil, 0)\n471|\t\tif err != nil {\n472|\t\t\tt.Fatalf(\"parse %s: %v\", name, err)\n473|\t\t}\n474|\t\tfor _, declaration := range file.Decls {\n475|\t\t\tfunction, ok := declaration.(*ast.FuncDecl)\n476|\t\t\tif !ok || !strings.HasPrefix(function.Name.Name, \"Is\") || function.Body == nil {\n477|\t\t\t\tcontinue\n478|\t\t\t}\n479|\t\t\tif len(function.Body.List) != 1 {\n480|\t\t\t\tt.Fatalf(\"predicate %s is not a single return; the inventory cannot resolve it\",\n481|\t\t\t\t\tfunction.Name.Name)\n482|\t\t\t}\n483|\t\t\treturned, ok := function.Body.List[0].(*ast.ReturnStmt)\n484|\t\t\tif !ok || len(returned.Results) != 1 {\n485|\t\t\t\tt.Fatalf(\"predicate %s is not a single return; the inventory cannot resolve it\",\n486|\t\t\t\t\tfunction.Name.Name)\n487|\t\t\t}\n488|\t\t\tcall, ok := returned.Results[0].(*ast.CallExpr)\n489|\t\t\tif !ok || len(call.Args) != 2 {\n490|\t\t\t\tt.Fatalf(\"predicate %s does not call errorCode(err, Code); \"+\n491|\t\t\t\t\t\"the inventory cannot resolve it\", function.Name.Name)\n492|\t\t\t}\n493|\t\t\tcode, ok := call.Args[1].(*ast.Ident)\n494|\t\t\tif !ok {\n495|\t\t\t\tt.Fatalf(\"predicate %s reports a non-static code; the inventory cannot resolve it\",\n496|\t\t\t\t\tfunction.Name.Name)\n497|\t\t\t}\n498|\t\t\tpredicates[function.Name.Name] = code.Name\n499|\t\t}\n500|\t}\n501|\tif len(predicates) == 0 {\n502|\t\tt.Fatal(\"resolved zero predicates; the scanner is broken, not the package\")\n503|\t}\n504|\treturn predicates\n505|}\n506|\n507|// declaredRefusalArm is one inventoried arm: the derived key (file,\n508|// function, code symbol, static detail, occurrence), the public\n509|// production entry its witness drives, an optional stated bound for\n(more lines below)"}}}
