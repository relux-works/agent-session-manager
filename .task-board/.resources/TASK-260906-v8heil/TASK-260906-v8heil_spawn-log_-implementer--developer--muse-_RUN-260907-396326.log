{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5d1","stream":{"kind":"session","id":"01a0798e-8ce3-71d2-82cf-4115ffc6a2dc"},"sequence":323,"recorded_at":1780531400000641,"record_type":"event","durability":"durable","causation_id":"f7e88212-ef87-40d2-a1db-8797ebe2238a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f7e88212-ef87-40d2-a1db-8797ebe2238a","run_stream":{"kind":"run","id":"f7e88212-ef87-40d2-a1db-8797ebe2238a"},"call_id":"call_01a0798f36177b129255449f8567ba8f","text":"Read text file `internal/terminalbackend/refusal_arm_inventory_test.go`.\n(499 line(s) above)\n500|type refusalTestRef struct {\n501|\tfile string\n502|\ttest string\n503|}\n504|\n505|// declaredRefusalArm is one inventoried arm: the derived key (file,\n506|// function, code symbol, static detail, occurrence), the public\n507|// production entry its test drives, an optional stated bound for\n508|// defensive arms no document can reach, and the tests asserting it.\n509|type declaredRefusalArm struct {\n510|\tfile       string\n511|\tfunction   string\n512|\tcode       string\n513|\tdetail     string\n514|\toccurrence int\n515|\tentry      string\n516|\tbound      string\n517|\t// detailSet carries the funneled detail set for the single\n518|\t// dynamic-detail row; it is empty for every literal row.\n519|\tdetailSet []string\n520|\ttests     []refusalTestRef\n521|}\n522|\n523|// boundDefensiveReparse is the stated bound for re-parse arms after an\n524|// already-validated member: timestampMember validated the member, and the\n525|// Time re-parse cannot fail while scalar owns that contract. The arms\n526|// stay as fail-closed defense; the bound says why no document reaches\n527|// them, and TestDefensiveBoundsAreExactlyThese pins the set.\n528|const boundDefensiveReparse = \"defensive re-parse after validation; scalar owns the re-parse contract\"\n529|\n530|// declaredRefusalArms is the inventoried arm set. Field order is file,\n531|// function (receiver-qualified for methods), code symbol, static detail,\n532|// occurrence within that key, driven public entry, stated bound (empty\n533|// except for defensive arms), funneled detail set (nil except the funnel\n534|// row, which lives outside this table), and asserting tests.\n535|//\n536|// The table is generated from the derivation, never hand-enumerated:\n537|// every row must match exactly one derived arm and vice versa, so adding\n538|// a production arm without a row fails forward, and deleting one fails\n539|// in reverse.\n540|var declaredRefusalArms = []declaredRefusalArm{\n541|\t{\"conformance.go\", \"CheckAttachRequest\", \"CodeMismatch\", \"document timestamp\", 1, \"CheckAttachRequest\", boundDefensiveReparse, nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckAttachRequestBindsTransportInputAndExpiry\"}}},\n542|\t{\"conformance.go\", \"CheckAttachRequest\", \"CodeUnauthorized\", \"attach authorization binding\", 1, \"CheckAttachRequest\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckAttachRequestBindsTransportInputAndExpiry\"}}},\n543|\t{\"conformance.go\", \"CheckAttachRequest\", \"CodeUnauthorized\", \"attach authorization expiry\", 1, \"CheckAttachRequest\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckAttachRequestBindsTransportInputAndExpiry\"}}},\n544|\t{\"conformance.go\", \"CheckAttachRequest\", \"CodeUnauthorized\", \"attach relay transport\", 1, \"CheckAttachRequest\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckAttachRequestBindsTransportInputAndExpiry\"}}},\n545|\t{\"conformance.go\", \"CheckAttachResult\", \"CodeUnauthorized\", \"attach input binding\", 1, \"CheckAttachResult\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckAttachResultRequiresTripleEquality\"}}},\n546|\t{\"conformance.go\", \"CheckEntrypoint\", \"CodePreconditionFailed\", \"entrypoint argv\", 1, \"CheckEntrypoint\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckEntrypointNamesItsArm\"}}},\n547|\t{\"conformance.go\", \"CheckEntrypoint\", \"CodePreconditionFailed\", \"entrypoint session binding\", 1, \"CheckEntrypoint\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckEntrypointNamesItsArm\"}}},\n548|\t{\"conformance.go\", \"CheckEntrypoint\", \"CodePreconditionFailed\", \"entrypoint session binding\", 2, \"CheckEntrypoint\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckEntrypointNamesItsArm\"}}},\n549|\t{\"conformance.go\", \"CheckEntrypoint\", \"CodePreconditionFailed\", \"entrypoint session binding\", 3, \"CheckEntrypoint\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckEntrypointNamesItsArm\"}}},\n550|\t{\"conformance.go\", \"CheckErrorAllowed\", \"CodeProtocolError\", \"operation error vocabulary\", 1, \"CheckErrorAllowed\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckErrorAllowedRefusesEveryUnlistedCode\"}}},\n551|\t{\"conformance.go\", \"CheckReplicable\", \"CodeProtocolError\", \"replication exclusion\", 1, \"CheckReplicable\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckReplicableRefusesEveryNonSafeClass\"}}},\n552|\t{\"conformance.go\", \"CheckStatusResult\", \"CodePreconditionFailed\", \"status attachability\", 1, \"CheckStatusResult\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckStatusResultEnforcesLookupRules\"}}},\n553|\t{\"conformance.go\", \"CheckStatusResult\", \"CodeProtocolError\", \"status identity binding\", 1, \"CheckStatusResult\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckStatusResultEnforcesLookupRules\"}}},\n554|\t{\"conformance.go\", \"CheckStatusResult\", \"CodeProtocolError\", \"status identity binding\", 2, \"CheckStatusResult\", \"\", nil, []refusalTestRef{{file: \"conformance_te