\\t\\t}\\n\\t\\tif _, duplicate := ledger.receipts[key]; duplicate {\\n\\t\\t\\treturn nil, &Error{Code: CodeIdempotencyMismatch, Detail: \\\"idempotency ledger image\\\"}\\n\\t\\t}\\n\\t\\tledger.receipts[key] = Receipt{Key: key, Operation: parsed, ResultID: resultID}\\n\\t}\\n\\treturn ledger, nil\\n}\\n\\n// ClassifyReplication reports the §4.E persistence class of one wire\\n// member. An unlisted member reports false: the table is closed, and an\\n// unknown member is refused rather than defaulted into any class.\\nfunc ClassifyReplication(member string) (ReplicationClass, bool) {\\n504:func (ledger *Ledger) Bind(key string, operation Operation, resultID string) (Receipt, error) {\\n505-\\tif ledger == nil {\\n506-\\t\\treturn Receipt{}, &Error{Code: CodeProtocolError, Detail: \\\"idempotency ledger unavailable\\\"}\\n507-\\t}\\n508-\\tif key == \\\"\\\" || resultID == \\\"\\\" {\\n509-\\t\\treturn Receipt{}, &Error{Code: CodeProtocolError, Detail: \\\"idempotency key shape\\\"}\\n510-\\t}\\n511-\\tif _, err := ParseOperation(string(operation)); err != nil {\\n512-\\t\\treturn Receipt{}, err\\n513-\\t}\\n514-\\tledger.mutex.Lock()\\n515-\\tdefer ledger.mutex.Unlock()\\n516-\\tif stored, known := ledger.receipts[key]; known {\\n517-\\t\\tif stored.Operation != operation || stored.ResultID != resultID {\\n518-\\t\\t\\treturn Receipt{}, &Error{Code: CodeIdempotencyMismatch, Detail: \\\"idempotency key conflict\\\"}\\n519-\\t\\t}\\n520-\\t\\treturn stored, nil\\n521-\\t}\\n522-\\treceipt := Receipt{Key: key, Operation: operation, ResultID: resultID}\\n523-\\tledger.receipts[key] = receipt\\n524-\\treturn receipt, nil\\n525-}\\n526-\\n527-// Replay returns the stored receipt for a key. A lost result replays the\\n528-// receipt; absence of a receipt proves nothing and reports false, so the\\n529-// caller must consult status before any start retry.\\n530-func (ledger *Ledger) Replay(key string) (Receipt, bool) {\\n531-\\tif ledger == nil {\\n532-\\t\\treturn Receipt{}, false\\n533-\\t}\\n534-\\tledger.mutex.Lock()\\n535-\\tdefer ledger.mutex.Unlock()\\n536-\\treceipt, known := ledger.receipts[key]\\n537-\\treturn receipt, known\\n538-}\\n539-\\n540-// Export renders the table as stable bytes: receipts sorted by key, one\\n541-// per line as key, operation, and result fields. Import refuses a\\n542-// malformed image or one binding the same key twice instead of admitting\\n543-// a half-read table.\\n544-func (ledger *Ledger) Export() []byte {\\n\",\n  \"original_output_bytes\": 2951,\n  \"original_output_tokens\": 738,\n  \"truncated\": false\n}"}}}
