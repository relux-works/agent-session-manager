{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5a5","stream":{"kind":"session","id":"01a0798e-8ce3-71d2-82cf-4115ffc6a2dc"},"sequence":301,"recorded_at":1780531400000597,"record_type":"event","durability":"durable","causation_id":"f7e88212-ef87-40d2-a1db-8797ebe2238a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f7e88212-ef87-40d2-a1db-8797ebe2238a","run_stream":{"kind":"run","id":"f7e88212-ef87-40d2-a1db-8797ebe2238a"},"task_stream":{"kind":"task","id":"c5777cc3-777b-4b49-aef3-5defdaeca399"},"task_id":"c5777cc3-777b-4b49-aef3-5defdaeca399","event":{"kind":"output","task_id":"c5777cc3-777b-4b49-aef3-5defdaeca399","chunk":"Read text file `internal/provhost/inventory_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"flag\"\n5|\t\"fmt\"\n6|\t\"go/ast\"\n7|\t\"go/parser\"\n8|\t\"go/token\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\t\"regexp\"\n12|\t\"runtime\"\n13|\t\"sort\"\n14|\t\"strings\"\n15|\t\"sync\"\n16|\t\"testing\"\n17|\n18|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n19|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n20|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n21|)\n22|\n23|// exercisedRefusalSites records the production file:line that constructed\n24|// a refusal, for every instrumented refusal constructor call made during\n25|// the test run. observedCodes records every stable code those refusals\n26|// carried.\n27|var exercisedRefusalSites sync.Map\n28|var observedCodes sync.Map\n29|\n30|func recordRefusalSite(code string) {\n31|\tobservedCodes.Store(code, struct{}{})\n32|\tif _, file, line, ok := runtime.Caller(2); ok {\n33|\t\texercisedRefusalSites.Store(fmt.Sprintf(\"%s:%d\", filepath.Base(file), line), struct{}{})\n34|\t}\n35|}\n36|\n37|func TestMain(main *testing.M) {\n38|\t// Helper-process gate for the ExecRunner environment tests: when the\n39|\t// marker is set this binary prints its observed environment and\n40|\t// exits before the suite or the refusal audit runs. It sits first so\n41|\t// the child never re-enters the audit or spawns grandchildren.\n42|\tif os.Getenv(\"SECPROBE_HELPER_PROCESS\") == \"1\" {\n43|\t\trunExecRunnerHelper()\n44|\t}\n45|\torigInvalid, origProtocol, origMismatch := failInvalid, failProtocol, failMismatch\n46|\torigProcess, origTimeout, origIntegrity := failProcess, failTimeout, failIntegrity\n47|\tfailInvalid = func(detail string) (*axerror.Error, error) {\n48|\t\tfailure, err := origInvalid(detail)\n49|\t\tif err == nil {\n50|\t\t\trecordRefusalSite(string(failure.Code()))\n51|\t\t}\n52|\t\treturn failure, err\n53|\t}\n54|\tfailProtocol = func(detail, member string) (*axerror.Error, error) {\n55|\t\tfailure, err := origProtocol(detail, member)\n56|\t\tif err == nil {\n57|\t\t\trecordRefusalSite(string(failure.Code()))\n58|\t\t}\n59|\t\treturn failure, err\n60|\t}\n61|\tfailMismatch = func(detail, observed string) (*axerror.Error, error) {\n62|\t\tfailure, err := origMismatch(detail, observed)\n63|\t\tif err == nil {\n64|\t\t\trecordRefusalSite(string(failure.Code()))\n65|\t\t}\n66|\t\treturn failure, err\n67|\t}\n68|\tfailProcess = func(detail string, cause error) (*axerror.Error, error) {\n69|\t\tfailure, err := origProcess(detail, cause)\n70|\t\tif err == nil {\n71|\t\t\trecordRefusalSite(string(failure.Code()))\n72|\t\t}\n73|\t\treturn failure, err\n74|\t}\n75|\tfailTimeout = func(millisDetail string, millis int64) (*axerror.Error, error) {\n76|\t\tfailure, err := origTimeout(millisDetail, millis)\n77|\t\tif err == nil {\n78|\t\t\trecordRefusalSite(string(failure.Code()))\n79|\t\t}\n80|\t\treturn failure, err\n81|\t}\n82|\tfailIntegrity = func(detail, statusState, materializationID, transactionID string) (*axerror.Error, error) {\n83|\t\tfailure, err := origIntegrity(detail, statusState, materializationID, transactionID)\n84|\t\tif err == nil {\n85|\t\t\trecordRefusalSite(string(failure.Code()))\n86|\t\t}\n87|\t\treturn failure, err\n88|\t}\n89|\tcode := main.Run()\n90|\tif code == 0 && fullPackageTestRun() {\n91|\t\tif failures := auditRefusalInventory(); len(failures) != 0 {\n92|\t\t\tfor _, failure := range failures {\n93|\t\t\t\tfmt.Fprintln(os.Stderr, failure)\n94|\t\t\t}\n95|\t\t\tcode = 1\n96|\t\t}\n97|\t}\n98|\tos.Exit(code)\n99|}\n100|\n101|func fullPackageTestRun() bool {\n102|\tselected := flag.Lookup(\"test.run\")\n103|\treturn selected == nil || selected.Value.String() == \"\"\n104|}\n105|\n106|// auditRefusalInventory derives the refusal inventory from package\n107|// source, never from memory: every production call to a refusal\n108|// constructor must have an exercised negative path, no Structured Error\n109|// may be built outside the six constructors, no raw error may be minted,\n110|// and the observed code set must equal the closed code set exactly.\n111|func auditRefusalInventory() []string {\n112|\tdirectory, err := os.Getwd()\n113|\tif err != nil {\n114|\t\treturn []string{fmt.Sprintf(\"derive provhost refusal inventory: %v\", err)}\n115|\t}\n116|\tinventory, err := deriveRefusalInventory(directory)\n117|\tif err != nil {\n118|\t\treturn []string{fmt.Sprintf(\"derive provhost refusal inventory: %v\", err)}\n119|\t}\n120|\tvar failures []string\n(more lines below)"}}}
