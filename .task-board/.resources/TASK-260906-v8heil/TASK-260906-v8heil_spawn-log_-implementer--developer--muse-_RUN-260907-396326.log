{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cfc5","stream":{"kind":"session","id":"01a0798e-8ce3-71d2-82cf-4115ffc6a2dc"},"sequence":1597,"recorded_at":1780531400003189,"record_type":"event","durability":"durable","causation_id":"f7e88212-ef87-40d2-a1db-8797ebe2238a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f7e88212-ef87-40d2-a1db-8797ebe2238a","run_stream":{"kind":"run","id":"f7e88212-ef87-40d2-a1db-8797ebe2238a"},"task_stream":{"kind":"task","id":"adb8c54d-ab75-4e8e-9005-8e3fec3ad1d6"},"task_id":"adb8c54d-ab75-4e8e-9005-8e3fec3ad1d6","event":{"kind":"output","task_id":"adb8c54d-ab75-4e8e-9005-8e3fec3ad1d6","chunk":"{\n  \"chunk_id\": \"exec-54-1\",\n  \"command\": \"cd /Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree && python3 - <<'PYEOF'\\np = 'internal/terminalbackend/refusal_arm_inventory_test.go'\\ns = open(p).read()\\n\\n# productionCodeSymbols through the core\\ns = s.replace('''\\tsymbols := make(map[string]string)\\n\\tmatches, err := filepath.Glob(\\\"*.go\\\")\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"glob production files: %v\\\", err)\\n\\t}\\n\\tfor _, name := range matches {\\n\\t\\tif strings.HasSuffix(name, \\\"_test.go\\\") {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tfileSet := token.NewFileSet()\\n\\t\\tfile, err := parser.ParseFile(fileSet, name, nil, 0)\\n\\t\\tif err != nil {\\n\\t\\t\\tt.Fatalf(\\\"parse %s: %v\\\", name, err)\\n\\t\\t}\\n\\t\\tfor _, declaration := range file.Decls {''', '''\\tsymbols := make(map[string]string)\\n\\tfiles, _ := invcore.MustScanProduction(t, \\\".\\\")\\n\\tfor _, production := range files {\\n\\t\\tfile := production.Syntax\\n\\t\\tfor _, declaration := range file.Decls {''')\\nopen(p, 'w').write(s)\\nprint('wire migrated')\\nPYEOF\\ngrep -n \\\"TestPlainErrorsLiveOnlyInTheirTwoFunctions\\\" -A 75 internal/terminalbackend/refusal_arm_inventory_test.go | head -n 90\",\n  \"description\": \"Migrate wire symbols, view plain-error test\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"wire migrated\\n1007:// TestPlainErrorsLiveOnlyInTheirTwoFunctions closes the smuggling hole:\\n1008-// a non-wire error constructed anywhere but validatePlatforms (the\\n1009-// pinned funnel) or DigestFile (I/O) fails, so a refusal wearing a plain\\n1010-// error's clothes cannot ship unwitnessed.\\n1011-//\\n1012-// Coverage is declaration-complete like deriveRefusalArms above: every\\n1013-// FuncDecl body (receiver-qualified for methods) plus every package-level\\n1014-// var initializer is scanned, so a plain error hiding in a package-level\\n1015-// `var errPlanted = errors.New(…)` or a `var f = func() error {…}`\\n1016-// literal is caught like any other. An unused package-level plain error\\n1017-// still fails: its initializer runs at package init, so the construction\\n1018-// is real whether or not any caller returns it. An alias\\n1019-// (`newPlain := errors.New`) is rejected outright by\\n1020-// rejectPlainErrorAliases below: the allowlist scan matches only direct\\n1021-// selector calls, so an aliased construction would ship unattributed.\\n1022-// Custom error types outside the two recognised spellings are a stated\\n1023-// bound above, not covered here.\\n1024:func TestPlainErrorsLiveOnlyInTheirTwoFunctions(t *testing.T) {\\n1025-\\tt.Parallel()\\n1026-\\n1027-\\tmatches, err := filepath.Glob(\\\"*.go\\\")\\n1028-\\tif err != nil {\\n1029-\\t\\tt.Fatalf(\\\"glob production files: %v\\\", err)\\n1030-\\t}\\n1031-\\tfor _, name := range matches {\\n1032-\\t\\tif strings.HasSuffix(name, \\\"_test.go\\\") {\\n1033-\\t\\t\\tcontinue\\n1034-\\t\\t}\\n1035-\\t\\tfileSet := token.NewFileSet()\\n1036-\\t\\tfile, err := parser.ParseFile(fileSet, name, nil, 0)\\n1037-\\t\\tif err != nil {\\n1038-\\t\\t\\tt.Fatalf(\\\"parse %s: %v\\\", name, err)\\n1039-\\t\\t}\\n1040-\\t\\trejectPlainErrorAliases(t, file, name)\\n1041-\\t\\tcheck := func(functionName string, root ast.Node) {\\n1042-\\t\\t\\tast.Inspect(root, func(node ast.Node) bool {\\n1043-\\t\\t\\t\\tcall, ok := node.(*ast.CallExpr)\\n1044-\\t\\t\\t\\tif !ok {\\n1045-\\t\\t\\t\\t\\treturn true\\n1046-\\t\\t\\t\\t}\\n1047-\\t\\t\\t\\tif isPlainErrorConstruction(call) && !plainErrorFunctions[functionName] {\\n1048-\\t\\t\\t\\t\\tt.Errorf(\\\"%s constructs a non-wire error in %s, outside the two allowlisted functions; \\\"+\\n1049-\\t\\t\\t\\t\\t\\t\\\"a refusal wearing a plain error's clothes ships unwitnessed\\\", name, functionName)\\n1050-\\t\\t\\t\\t}\\n1051-\\t\\t\\t\\treturn true\\n1052-\\t\\t\\t})\\n1053-\\t\\t}\\n1054-\\t\\tfor _, declaration := range file.Decls {\\n1055-\\t\\t\\tswitch decl := declaration.(type) {\\n1056-\\t\\t\\tcase *ast.FuncDecl:\\n1057-\\t\\t\\t\\tif decl.Body == nil {\\n1058-\\t\\t\\t\\t\\tcontinue\\n1059-\\t\\t\\t\\t}\\n1060-\\t\\t\\t\\tfunctionName := decl.Name.Name\\n1061-\\t\\t\\t\\tif decl.Recv != nil && len(decl.Recv.List) > 0 {\\n1062-\\t\\t\\t\\t\\tfunctionName = receiverTypeName(decl.Recv.List[0].Type) + \\\".\\\" + functionName\\n1063-\\t\\t\\t\\t}\\n1064-\\t\\t\\t\\tcheck(functionName, decl.Body)\\n1065-\\t\\t\\tcase *ast.GenDecl:\\n1066-\\t\\t\\t\\t// Package-level initializers execute outside any FuncDecl,\\n1067-\\t\\t\\t\\t// so a plain error assigned to a package var would\\n1068-\\t\\t\\t\\t// otherwise ship invisible. Attribute its constructions\\n1069-\\t\\t\\t\\t// to the declared variable name.\\n1070-\\t\\t\\t\\tfor _, spec := range decl.Specs {\\n1071-\\t\\t\\t\\t\\tvalue, ok := spec.(*ast.ValueSpec)\\n1072-\\t\\t\\t\\t\\tif !ok {\\n1073-\\t\\t\\t\\t\\t\\tcontinue\\n1074-\\t\\t\\t\\t\\t}\\n1075-\\t\\t\\t\\t\\tfunctionName := \\\"var\\\"\\n1076-\\t\\t\\t\\t\\tif len(value.Names) > 0 {\\n1077-\\t\\t\\t\\t\\t\\tfunctionName = value.Names[0].Name\\n1078-\\t\\t\\t\\t\\t}\\n1079-\\t\\t\\t\\t\\tfor _, item := range value.Values {\\n1080-\\t\\t\\t\\t\\t\\tcheck(functionName, item)\\n1081-\\t\\t\\t\\t\\t}\\n1082-\\t\\t\\t\\t}\\n1083-\\t\\t\\t}\\n1084-\\t\\t}\\n1085-\\t}\\n1086-}\\n1087-\\n1088-// isPlainErrorConstruction reports the two recognised plain-error\\n1089-// spellings: errors.New and fmt.Errorf (any Errorf-prefixed constructor).\\n1090-func isPlainErrorConstruction(call *ast.CallExpr) bool {\\n1091-\\tselector, ok := call.Fun.(*ast.SelectorExpr)\\n1092-\\tif !ok {\\n1093-\\t\\treturn false\\n1094-\\t}\\n1095-\\treturn isPlainErrorSelector(selector)\\n1096-}\\n\",\n  \"original_output_bytes\": 3698,\n  \"original_output_tokens\": 925,\n  \"truncated\": false\n}"}}}
