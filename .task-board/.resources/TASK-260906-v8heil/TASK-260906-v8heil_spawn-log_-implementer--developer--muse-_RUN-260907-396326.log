{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cd61","stream":{"kind":"session","id":"01a0798e-8ce3-71d2-82cf-4115ffc6a2dc"},"sequence":1291,"recorded_at":1780531400002577,"record_type":"event","durability":"durable","causation_id":"f7e88212-ef87-40d2-a1db-8797ebe2238a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f7e88212-ef87-40d2-a1db-8797ebe2238a","run_stream":{"kind":"run","id":"f7e88212-ef87-40d2-a1db-8797ebe2238a"},"task_stream":{"kind":"task","id":"bdc54746-5ddf-43c3-8d53-f526a00cecf6"},"task_id":"bdc54746-5ddf-43c3-8d53-f526a00cecf6","event":{"kind":"output","task_id":"bdc54746-5ddf-43c3-8d53-f526a00cecf6","chunk":"Read text file `internal/terminalbackend/refusal_arm_inventory_test.go`.\n(789 line(s) above)\n790|}\n791|\n792|// plainErrorFunctions names the only production functions allowed to\n793|// construct non-wire errors. validatePlatforms feeds the pinned funnel;\n794|// DigestFile reports I/O failures that must never be wire errors.\n795|var plainErrorFunctions = map[string]bool{\n796|\t\"validatePlatforms\": true,\n797|\t\"DigestFile\":        true,\n798|}\n799|\n800|// TestDerivedRefusalArmsAreAllDeclared is the forward direction: every\n801|// arm the production AST derives resolves to exactly one declared row.\n802|// A brand-new arm with a brand-new detail fails here until its witness\n803|// is recorded.\n804|func TestDerivedRefusalArmsAreAllDeclared(t *testing.T) {\n805|\tt.Parallel()\n806|\n807|\tderived := deriveRefusalArms(t)\n808|\trows := declaredRows()\n809|\tmatched := make([]bool, len(derived))\n810|\tfor _, row := range rows {\n811|\t\tmatches := []int{}\n812|\t\tfor index, arm := range derived {\n813|\t\t\tif armMatchesRow(arm, row) {\n814|\t\t\t\tmatches = append(matches, index)\n815|\t\t\t}\n816|\t\t}\n817|\t\tif len(matches) != 1 {\n818|\t\t\tt.Errorf(\"declared row %s resolves to %d derived arms, want exactly one\",\n819|\t\t\t\tdescribeRow(row), len(matches))\n820|\t\t\tcontinue\n821|\t\t}\n822|\t\tif matched[matches[0]] {\n823|\t\t\tt.Errorf(\"declared row %s claims an arm an earlier row already claimed: %s\",\n824|\t\t\t\tdescribeRow(row), describeArm(derived[matches[0]]))\n825|\t\t\tcontinue\n826|\t\t}\n827|\t\tmatched[matches[0]] = true\n828|\t}\n829|\tfor index, claimed := range matched {\n830|\t\tif !claimed {\n831|\t\t\tt.Errorf(\"derived arm has no declaring row, so nothing witnesses it: %s\",\n832|\t\t\t\tdescribeArm(derived[index]))\n833|\t\t}\n834|\t}\n835|}\n836|\n837|// TestDeclaredRefusalArmsAreAllDerived is the reverse direction: every\n838|// declared row resolves to exactly one derived arm. Without it the\n839|// forward direction passes vacuously on a truncated derivation, and a\n840|// deleted production guard lingers as a row pointing at nothing.\n841|func TestDeclaredRefusalArmsAreAllDerived(t *testing.T) {\n842|\tt.Parallel()\n843|\n844|\tderived := deriveRefusalArms(t)\n845|\tfor _, row := range declaredRows() {\n846|\t\tmatches := 0\n847|\t\tfor _, arm := range derived {\n848|\t\t\tif armMatchesRow(arm, row) {\n849|\t\t\t\tmatches++\n850|\t\t\t}\n851|\t\t}\n852|\t\tif matches != 1 {\n853|\t\t\tt.Errorf(\"declared row %s matches %d derived arms, want exactly one; \"+\n854|\t\t\t\t\"a row without an arm is a witness without a guard\", describeRow(row), matches)\n855|\t\t}\n856|\t}\n857|\tif len(derived) != len(declaredRows()) {\n858|\t\tt.Errorf(\"derived %d arms but declared %d rows; the table is not a bijection\",\n859|\t\t\tlen(derived), len(declaredRows()))\n860|\t}\n861|}\n862|\n863|func armMatchesRow(arm refusalArm, row declaredRefusalArm) bool {\n864|\treturn arm.file == row.file && arm.function == row.function &&\n865|\t\tarm.code == row.code && arm.detail == row.detail &&\n866|\t\tarm.occurrence == row.occurrence\n867|}\n868|\n869|func describeArm(arm refusalArm) string {\n870|\treturn arm.file + \" \" + arm.function + \" \" + arm.code + \" \" +\n871|\t\tstrconv.Quote(arm.detail) + \" #\" + strconv.Itoa(arm.occurrence)\n872|}\n873|\n874|func describeRow(row declaredRefusalArm) string {\n875|\treturn row.file + \" \" + row.function + \" \" + row.code + \" \" +\n876|\t\tstrconv.Quote(row.detail) + \" #\" + strconv.Itoa(row.occurrence)\n877|}\n878|\n879|// declaredRows returns the table plus the funnel row.\n880|func declaredRows() []declaredRefusalArm {\n881|\trows := append([]declaredRefusalArm(nil), declaredRefusalArms...)\n882|\tfunnel := funneledPlatformArm\n883|\tfunnel.detailSet = funneledPlatformDetails\n884|\treturn append(rows, funnel)\n885|}\n886|\n887|// TestDeclaredRefusalWiresMatchProductionConsts binds the table to the\n888|// production const values two ways: every row's code resolves to the\n889|// wire its test asserts, and every Code symbol except the named armless\n890|// one appears in at least one row, so a code nobody refuses is a red\n891|// rather than a quiet gap.\n892|func TestDeclaredRefusalWiresMatchProductionConsts(t *testing.T) {\n893|\tt.Parallel()\n894|\n895|\tsymbols := productionCodeSymbols(t)\n896|\tcovered := make(map[string]bool)\n897|\tfor _, row := range declaredRows() {\n898|\t\twire, known := symbols[row.code]\n899|\t\tif !known {\n900|\t\t\tt.Errorf(\"declared row %s names unknown code symbol %q\",\n901|\t\t\t\tdescribeRow(row), row.code)\n902|\t\t\tcontinue\n903|\t\t}\n904|\t\tcovered[row.code] = true\n905|\t\t_ = wire\n906|\t}\n907|\tfor symbol := range symbols {\n908|\t\tif armlessCodes[symbol] {\n909|\t\t\tcontinue\n910|\t\t}\n911|\t\tif !covered[symbol] {\n912|\t\t\tt.Errorf(\"code symbol %s has no refusal arm; a wire code nothing refuses is unwitnessed\", symbol)\n913|\t\t}\n914|\t}\n915|}\n916|\n917|// TestDeclaredRefusalTestsResolve requires every row to name real tests\n918|// that textually touch the arm: the detail literal, or the driven entry\n919|// plus the wire code (or its verified predicate). Bound rows name a test\n(more lines below)"}}}
