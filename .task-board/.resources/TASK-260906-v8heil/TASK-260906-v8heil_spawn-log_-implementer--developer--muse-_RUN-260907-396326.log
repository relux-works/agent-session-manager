{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cd85","stream":{"kind":"session","id":"01a0798e-8ce3-71d2-82cf-4115ffc6a2dc"},"sequence":1309,"recorded_at":1780531400002613,"record_type":"event","durability":"durable","causation_id":"f7e88212-ef87-40d2-a1db-8797ebe2238a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f7e88212-ef87-40d2-a1db-8797ebe2238a","run_stream":{"kind":"run","id":"f7e88212-ef87-40d2-a1db-8797ebe2238a"},"task_stream":{"kind":"task","id":"adda0181-bda1-42e3-bdd1-a6d012fe22cc"},"task_id":"adda0181-bda1-42e3-bdd1-a6d012fe22cc","event":{"kind":"output","task_id":"adda0181-bda1-42e3-bdd1-a6d012fe22cc","chunk":"Read text file `internal/terminalbackend/refusal_arm_inventory_test.go`.\n(918 line(s) above)\n919|// plus the wire code (or its verified predicate). Bound rows name a test\n920|// driving the entry; the bound itself says why no document reaches them.\n921|func TestDeclaredRefusalTestsResolve(t *testing.T) {\n922|\tt.Parallel()\n923|\n924|\tbodies := testBodies(t)\n925|\tpredicates := predicateCodes(t)\n926|\tsymbols := productionCodeSymbols(t)\n927|\tfor _, row := range declaredRows() {\n928|\t\tif len(row.tests) == 0 {\n929|\t\t\tt.Errorf(\"declared row %s names no test, so nothing measures it\", describeRow(row))\n930|\t\t\tcontinue\n931|\t\t}\n932|\t\tresolved := false\n933|\t\tfor _, reference := range row.tests {\n934|\t\t\tbody, declared := bodies[reference.file+\"\\n\"+reference.test]\n935|\t\t\tif !declared {\n936|\t\t\t\tt.Errorf(\"declared row %s names %s in %s, which is not declared\",\n937|\t\t\t\t\tdescribeRow(row), reference.test, reference.file)\n938|\t\t\t\tcontinue\n939|\t\t\t}\n940|\t\t\tif rowResolves(row, body, predicates, symbols) {\n941|\t\t\t\tresolved = true\n942|\t\t\t}\n943|\t\t}\n944|\t\tif !resolved {\n945|\t\t\tt.Errorf(\"declared row %s names no test touching it: want the detail %q or the entry %q \"+\n946|\t\t\t\t\"with its wire code in %v\", describeRow(row), row.detail, row.entry, row.tests)\n947|\t\t}\n948|\t}\n949|}\n950|\n951|// rowResolves reports whether one test body touches one row.\n952|func rowResolves(row declaredRefusalArm, body string, predicates map[string]string, symbols map[string]string) bool {\n953|\tif row.detail == passthroughDetail {\n954|\t\tfor _, detail := range row.detailSet {\n955|\t\t\tif !strings.Contains(body, detail) {\n956|\t\t\t\treturn false\n957|\t\t\t}\n958|\t\t}\n959|\t\treturn strings.Contains(body, row.entry)\n960|\t}\n961|\tif strings.Contains(body, row.detail) {\n962|\t\treturn true\n963|\t}\n964|\tif row.bound != \"\" {\n965|\t\treturn strings.Contains(body, row.entry)\n966|\t}\n967|\tif !strings.Contains(body, row.entry) {\n968|\t\treturn false\n969|\t}\n970|\tif strings.Contains(body, symbols[row.code]) {\n971|\t\treturn true\n972|\t}\n973|\tfor predicate, code := range predicates {\n974|\t\tif code == row.code && strings.Contains(body, predicate) {\n975|\t\t\treturn true\n976|\t\t}\n977|\t}\n978|\treturn false\n979|}\n980|\n981|// TestDefensiveBoundsAreExactlyThese pins the set of bound rows: a new\n982|// defensive arm must join this set deliberately, with its bound stated,\n983|// rather than slipping in as an ordinary row whose test cannot reach it.\n984|func TestDefensiveBoundsAreExactlyThese(t *testing.T) {\n985|\tt.Parallel()\n986|\n987|\twant := map[string]bool{\n988|\t\t\"conformance.go ParseAttachAuthorization CodeMismatch \\\"document timestamp\\\" #1\": true,\n989|\t\t\"conformance.go ParseAttachAuthorization CodeMismatch \\\"document timestamp\\\" #2\": true,\n990|\t\t\"conformance.go CheckAttachRequest CodeMismatch \\\"document timestamp\\\" #1\":       true,\n991|\t\t\"manifest.go checkEvidenceLiveness CodeMismatch \\\"document timestamp\\\" #1\":       true,\n992|\t\t\"manifest.go checkEvidenceLiveness CodeMismatch \\\"document timestamp\\\" #2\":       true,\n993|\t}\n994|\tfor _, row := range declaredRows() {\n995|\t\tif row.bound == \"\" {\n996|\t\t\tcontinue\n997|\t\t}\n998|\t\tif row.bound != boundDefensiveReparse {\n999|\t\t\tt.Errorf(\"declared row %s carries an unrecognized bound %q\",\n1000|\t\t\t\tdescribeRow(row), row.bound)\n1001|\t\t\tcontinue\n1002|\t\t}\n1003|\t\tif !want[describeRow(row)] {\n1004|\t\t\tt.Errorf(\"declared row %s claims a bound outside the pinned set; \"+\n1005|\t\t\t\t\"a new defensive arm joins deliberately or not at all\", describeRow(row))\n1006|\t\t}\n1007|\t}\n1008|\tbound := 0\n1009|\tfor _, row := range declaredRows() {\n1010|\t\tif row.bound != \"\" {\n1011|\t\t\tbound++\n1012|\t\t}\n1013|\t}\n1014|\tif bound != len(want) {\n1015|\t\tt.Errorf(\"declared %d bound rows, want exactly the pinned %d\", bound, len(want))\n1016|\t}\n1017|}\n1018|\n1019|// TestPlatformFunnelDetailsAreExactlyThese derives the error set of\n1020|// validatePlatforms from the production AST and requires it to equal the\n1021|// funneled set: a fourth platform error widens the funnel this test pins.\n1022|func TestPlatformFunnelDetailsAreExactlyThese(t *testing.T) {\n1023|\tt.Parallel()\n1024|\n1025|\tfileSet := token.NewFileSet()\n1026|\tfile, err := parser.ParseFile(fileSet, \"terminalbackend.go\", nil, 0)\n1027|\tif err != nil {\n1028|\t\tt.Fatalf(\"parse terminalbackend.go: %v\", err)\n1029|\t}\n1030|\tdetails := map[string]bool{}\n1031|\tfor _, declaration := range file.Decls {\n1032|\t\tfunction, ok := declaration.(*ast.FuncDecl)\n1033|\t\tif !ok || function.Name.Name != \"validatePlatforms\" {\n1034|\t\t\tcontinue\n1035|\t\t}\n1036|\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n1037|\t\t\tcall, ok := node.(*ast.CallExpr)\n1038|\t\t\tif !ok {\n(more lines below)"}}}
