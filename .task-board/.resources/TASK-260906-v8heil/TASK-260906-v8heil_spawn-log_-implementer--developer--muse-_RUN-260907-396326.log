string, cause error) Error {\n44|\t\terr := origPrecondition(detail, cause)\n45|\t\trecordRefusalSite(err.Code())\n46|\t\treturn err\n47|\t}\n48|\tfailIntegrity = func(detail string, cause error) Error {\n49|\t\terr := origIntegrity(detail, cause)\n50|\t\trecordRefusalSite(err.Code())\n51|\t\treturn err\n52|\t}\n53|\tcode := main.Run()\n54|\tif code == 0 && fullPackageTestRun() {\n55|\t\tif failures := auditRefusalInventory(); len(failures) != 0 {\n56|\t\t\tfor _, failure := range failures {\n57|\t\t\t\tfmt.Fprintln(os.Stderr, failure)\n58|\t\t\t}\n59|\t\t\tcode = 1\n60|\t\t}\n61|\t}\n62|\tos.Exit(code)\n63|}\n64|\n65|func fullPackageTestRun() bool {\n66|\tselected := flag.Lookup(\"test.run\")\n67|\treturn selected == nil || selected.Value.String() == \"\"\n68|}\n69|\n70|// auditRefusalInventory derives the refusal inventory from package source,\n71|// never from memory: every production call to a refusal constructor must\n72|// have an exercised negative path, no Error value may be built outside the\n73|// four constructors, and the observed code set must equal the closed code\n74|// set exactly.\n75|func auditRefusalInventory() []string {\n76|\tdirectory, err := os.Getwd()\n77|\tif err != nil {\n78|\t\treturn []string{fmt.Sprintf(\"derive provider refusal inventory: %v\", err)}\n79|\t}\n80|\tinventory, err := deriveRefusalInventory(directory)\n81|\tif err != nil {\n82|\t\treturn []string{fmt.Sprintf(\"derive provider refusal inventory: %v\", err)}\n83|\t}\n84|\tvar failures []string\n85|\t// Floor: a derived domain that can silently derive nothing is not a\n86|\t// measurement. An empty or short derivation must fail closed, never\n87|\t// pass vacuously — the same \"the scan is blind\" floor the package's\n88|\t// other derived scans carry.\n89|\tif len(inventory.ScannedFiles) == 0 {\n90|\t\tfailures = append(failures, \"scanned no production sources; the check is blind\")\n91|\t}\n92|\tif len(inventory.Sites) == 0 {\n93|\t\tfailures = append(failures, \"derived no refusal sites; the scan is blind\")\n94|\t}\n95|\t// Reverse direction: every exercised refusal site must resolve to a\n96|\t// derived site. The exercised set is derived from the test run, not\n97|\t// hand-listed, so a truncated derivation (1 of N sites, provider.go\n98|\t// skipped, or an empty-but-successful read of the wrong directory)\n99|\t// reddens here even though the forward check passes vacuously.\n100|\tderived := map[string]bool{}\n101|\tfor _, site := range inventory.Sites {\n102|\t\tderived[site] = true\n103|\t}\n104|\tvar outside []string\n105|\texercisedRefusalSites.Range(func(key, _ any) bool {\n106|\t\tsite := key.(string)\n107|\t\tif !derived[site] {\n108|\t\t\toutside = append(outside, site)\n109|\t\t}\n110|\t\treturn true\n111|\t})\n112|\tsort.Strings(outside)\n113|\tif len(outside) != 0 {\n114|\t\tfailures = append(failures, \"exercised refusal sites outside the derived inventory; the derivation is short: \"+strings.Join(outside, \", \"))\n115|\t}\n116|\tif len(inventory.StrayLiterals) != 0 {\n117|\t\tsort.Strings(inventory.StrayLiterals)\n118|\t\tfailures = append(failures, \"provider refusals built outside an instrumented constructor: \"+strings.Join(inventory.StrayLiterals, \", \"))\n119|\t}\n120|\tif len(inventory.RawConstructors) != 0 {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
