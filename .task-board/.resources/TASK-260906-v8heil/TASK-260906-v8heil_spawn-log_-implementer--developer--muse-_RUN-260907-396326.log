tions[ident.Pos()] = true\n+\t\t\treturn true\n+\t\t}\n+\t\tif selector, ok := call.Fun.(*ast.SelectorExpr); ok {\n+\t\t\tif receiver, ok := selector.X.(*ast.Ident); ok {\n+\t\t\t\tif qualifiedWatches(spec, imports.pathOf(receiver.Name), selector.Sel.Name) {\n+\t\t\t\t\tpositions[selector.Sel.Pos()] = true\n+\t\t\t\t}\n+\t\t\t}\n+\t\t}\n+\t\treturn true\n+\t})\n+\treturn positions\n+}\n+\n+// importResolution maps the file's local import names to paths.\n","edit_facts":{"tool_name":"edit_file","path":"internal/invcore/invcore.go","added":48,"removed":1},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
