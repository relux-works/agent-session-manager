 != nil {\\n\\t\\t\\tt.Fatalf(\\\"derive digit guards: read %s: %v\\\", dir.path, err)\\n\\t\\t}\\n\\t\\tnames := []string{}\\n\\t\\tfor _, entry := range entries {\\n\\t\\t\\tname := entry.Name()\\n\\t\\t\\tif entry.IsDir() || !strings.HasSuffix(name, \\\".go\\\") || strings.HasSuffix(name, \\\"_test.go\\\") {\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\t}\\n\\t\\t\\tnames = append(names, name)\\n\\t\\t}\\n\\t\\tsort.Strings(names)\\n\\t\\tfor _, name := range names {\\n\\t\\t\\tpath := filepath.Join(dir.path, name)\\n\\t\\t\\tsource, err := os.ReadFile(path)\\n\\t\\t\\tif err != nil {\\n\\t\\t\\t\\tt.Fatalf(\\\"derive digit guards: read %s: %v\\\", path, err)\\n\\t\\t\\t}\\n\\t\\t\\tsyntax, err := parser.ParseFile(fileSet, path, source, 0)\\n\\t\\t\\tif err != nil {\\n\\t\\t\\t\\tt.Fatalf(\\\"derive digit guards: parse %s: %v\\\", path, err)\\n\\t\\t\\t}\\n\\t\\t\\tfiles++''',\\n'''\\tfor _, dir := range dirs {\\n\\t\\t// Selection and fail-closed parsing are the shared core's;\\n\\t\\t// the core returns names sorted, preserving source order.\\n\\t\\tproductions, _ := invcore.MustScanProduction(t, dir.path)\\n\\t\\tfiles += len(productions)\\n\\t\\tfor _, production := range productions {\\n\\t\\t\\tname, syntax := production.Name, production.Syntax''')\\nPYEOF\\necho ok\",\n  \"description\": \"Migrate identity and digit-guard walkers\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"migrated internal/provhost/identity_test.go\\nmigrated internal/provhost/identity_test.go\\nmigrated internal/terminalbackend/digit_guard_census_test.go\\nok\\n\",\n  \"original_output_bytes\": 152,\n  \"original_output_tokens\": 38,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
