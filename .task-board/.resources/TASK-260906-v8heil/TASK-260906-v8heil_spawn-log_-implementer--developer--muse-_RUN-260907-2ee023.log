       elementID,\\n\\t\\t\\tChangeRequestID:    record.ID,\\n\\t\\t\\tRevision:           record.Revision,\\n\\t\\t\\tFailedCommandIndex: validation.FailedCommandIndex,\\n\\t\\t\\tTotalCommands:      validation.TotalCommands,\\n\\t\\t\\tExitCode:           validation.ExitStatus,\\n\\t\\t\\tLogResource:        validation.LogResource,\\n\\t\\t\\tRetryStep:          \\\"fix the failure and complete the producer again; the configured suite will rerun automatically\\\",\\n\\t\\t}\\n\\t\\tif record.State == changerequest.StateReady {\\n\\t\\t\\t// Compatibility for injected/legacy publishers. Production Store.Create\\n\\t\\t\\t// publishes a failing revision atomically as changes_requested, but the\\n\\t\\t\\t// completion authority still narrows a ready result before returning.\\n\\t\\t\\ttransitioned, transitionErr := r.changeRequests().Transition(\\n\\t\\t\\t\\tcontrolRoot, elementID, record.Revision,\\n\\t\\t\\t\\tchangerequest.StateChangesRequested,\\n\\t\\t\\t\\t[]changerequest.State{changerequest.StateReady},\\n\\t\\t\\t\\tmanifest.ID, validationFailure.Error(),\\n\\t\\t\\t)\\n\\t\\t\\tif transitionErr != nil {\\n\\t\\t\\t\\treturn &changeRequestPublication{Record: record}, fmt.Errorf(\\n\\t\\t\\t\\t\\t\\\"preventing failed validation from leaving Change Request %s ready: %w\\\", record.ID, transitionErr)\\n\\t\\t\\t}\\n\\t\\t\\trecord = transitioned\\n\\t\\t} else if record.State != changerequest.StateChangesRequested {\\n\\t\\t\\treturn &changeRequestPublication{Record: record}, fmt.Errorf(\\n\\t\\t\\t\\t\\\"failed validation published Change Request %s in unexpected state %s\\\", record.ID, record.State)\\n\\t\\t}\\n\\t}\\n\\n\\tif writer, ok := r.completionActions.(ChangeRequestArtifactWriter); ok && record.DiffResourceName != \\\"\\\" {\\n\\t\\tdescription := fmt.Sprintf(\\\"Change Request %s revision %d candidate patch (repository_delta=%s, %d changed paths)\\\",\\n\\t\\t\\trecord.ID, record.Revision, record.RepositoryDelta, len(record.ChangedPaths))\\n\\t\\tif err := writer.AttachChangeRequestPatch(elementID, record.DiffResourceName, published.Patch, description); err != nil {\\n\\t\\t\\treturn &changeRequestPublication{Record: record}, fmt.Errorf(\\\"attaching the Change Request patch for %s: %w\\\", elementID, err)\\n\\t\\t}\\n\\t\\tif record.Validation != nil && record.Validation.LogResource != \\\"\\\" {\\n\\t\\t\\tdescription := fmt.Sprintf(\\\"Change Request %s revision %d bounded validation log\\\", record.ID, record.Revision)\\n\\t\\t\\tif err := writer.AttachChangeRequestValidationLog(elementID, record.Validation.LogResource, published.ValidationLog, description); err != nil {\\n\\t\\t\\t\\treturn &changeRequestPublication{Record: record}, fmt.Errorf(\\\"attaching the Change Request validation log for %s: %w\\\", elementID, err)\\n\\t\\t\\t}\\n\\t\\t}\\n\\t} else if record.Validation != nil && record.Validation.LogResource != \\\"\\\" {\\n\\t\\treturn &changeRequestPublication{Record: record}, fmt.Errorf(\\n\\t\\t\\t\\\"persisting validation evidence for %s requires a Change Request artifact writer\\\", elementID)\\n\\t}\\n\\tif validationFailure != nil {\\n\\t\\treturn &changeRequestPublication{Record: record}, validationFailure\\n\\t}\\n\\treturn &changeRequestPublication{Record: record}, nil\\n}\\n\\n// convergeStoryFinalBaseAuthority is the last authority boundary before the\\n// validation suite, Change Request store, patch resources, and reviewer routing.\\n// It repairs only one proven recovery shape: a non-empty CurrentBaseOID lagging\\n// the freshly selected authority while the durable checkpoint, managed branch,\\n// and checked-out HEAD all agree and descend from that authority. Every other\\n// disagreement refuses before Publish can validate or persist anything.\\nfunc convergeStoryFinalBaseAuthority(controlRoot, executionRoot, elementID string, ref *worktree.Ref) (string, error) {\\n\\tif ref == nil {\\n\\t\\treturn \\\"\\\", fmt.Errorf(\\\"change_request_base_authority_mismatch: the managed workspace record is missing\\\")\\n\\t}\\n\\tstoryID := strings.TrimSpace(ref.StoryID)\\n\\tselected := strings.TrimSpace(ref.SelectedBaseOID)\\n\\tcurrent := strings.TrimSpace(ref.CurrentBaseOID)\\n\\tcheckpoint := strings.TrimSpace(ref.CheckpointOID)\\n\\tbranchRef := strings.TrimSpace(ref.BranchRef)\\n\\tif current == \\\"\\\" {\\n\\t\\treturn \\\"\\\", fmt.Errorf(\\\"change_request_base_authority_mismatch: the %s workspace record has no current base OID for story_final Change Request construction\\\", storyID)\\n\\t}\\n\\tif selected == \\\"\\\" || checkpoint == \\\"\\\" || branchRef == \\\"\\\" {\\n\\t\\treturn \\\"\\\", fmt.Errorf(\\n\\t\\t\\t\\\"change_request_base_authority_mismatch: the %s workspace authority is incomplete (selected=%q current=%q checkpoint=%q branch=%q)\\\",\\n\\t\\t\\tstoryID, selected, current, checkpoint, branchRef)\\n\\t}\\n\\tupstream := strings.TrimSpace(ref.UpstreamOID)\\n\\tif strings.TrimSpace(ref.UpstreamRef) != \\\"\\\" || upstream != \\\"\\\" || strings.EqualFold(strings.TrimSpace(ref.AuthoritySource), \\\"fetched_upstream\\\") {\\n\\t\\tif upstream == \\\"\\\" || upstream != selected {\\n\\t\\t\\treturn \\\"\\\", fmt.Errorf(\\n\\t\\t\\t\\t\\\"change_request_base_authority_mismatch: the %s workspace selected base %s disagrees with upstream %s\\\",\\n\\t\\t\\t\\tstoryID, selected, upstream)\\n\\t\\t}\\n\\t}\\n\\t// A workspace cut before a sibling Story landed on trunk sits strictly\\n\\t// behind the authority this Story must publish against, and none of the\\n\\t// provenance checks below can make it publishable — they can only name the\\n\\t// disagreement. Converge it first, and only for the one shape a convergence\\n\\t// is safe in: the checkpoint is contained in the selected authority, so the\\n\",\n  \"original_output_bytes\": 11458,\n  \"original_output_tokens\": 2865,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
