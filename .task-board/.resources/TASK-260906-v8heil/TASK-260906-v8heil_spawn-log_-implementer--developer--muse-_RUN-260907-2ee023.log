truction and\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/goal_acceptance.go:289:// A read that FAILS (producerCompletionHandedOff returning a non-nil error)\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/goal_acceptance.go:299:\\thandedOff, why, err := r.producerCompletionHandedOff(manifest, goal)\\n===\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go:428:func (r *Runtime) producerCompletionHandedOff(manifest *spawnRunManifest, goal *pkgboard.GoalContract) (bool, string, error) {\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-429-\\tif r.completionActions == nil {\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-430-\\t\\treturn false, \\\"this runtime has no completion actions, so the handoff could not be established at all\\\", nil\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-431-\\t}\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-432-\\tendStatus := strings.TrimSpace(manifest.EndStatus)\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-433-\\tif goal != nil && goal.Kind == pkgboard.GoalKindRoleHandoff {\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-434-\\t\\tif fromGoal := strings.TrimSpace(goal.RolePolicy.HandoffEndStatus); fromGoal != \\\"\\\" {\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-435-\\t\\t\\tendStatus = fromGoal\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-436-\\t\\t}\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-437-\\t}\\n/Users/iv/.agents/sk