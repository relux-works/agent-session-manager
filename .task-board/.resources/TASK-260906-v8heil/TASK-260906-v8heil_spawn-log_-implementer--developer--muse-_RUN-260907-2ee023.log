implementation, rooted in the control\\n// root's local Change Request store.\\n//\\n// There is no remote variant and none is emulated: §9.1 scopes the managed\\n// workspace path to a local authoritative board, and the CLI refuses the CR and\\n// accept_cr surfaces before either transport when the resolved board is remote.\\ntype fileChangeRequests struct{}\\n\\nfunc (fileChangeRequests) Current(controlRoot, elementID string) (*changerequest.Record, error) {\\n\\treturn changerequest.NewStore(controlRoot).Current(elementID)\\n}\\n\\nfunc (fileChangeRequests) Publish(req ChangeRequestPublishRequest) (*ChangeRequestPublishResult, error) {\\n\\tif strings.TrimSpace(req.ProducerRunID) == \\\"\\\" || strings.TrimSpace(req.ProducerRole) == \\\"\\\" || strings.TrimSpace(req.ProducerArchetype) == \\\"\\\" {\\n\\t\\treturn nil, fmt.Errorf(\\\"publishing a Change Request requires the originating producer run, role, and archetype\\\")\\n\\t}\\n\\ttake := func() (*changerequest.Snapshot, error) {\\n\\t\\treturn changerequest.Take(changerequest.SnapshotRequest{\\n\\t\\t\\tControlRoot:  req.ControlRoot,\\n\\t\\t\\tWorktreePath: req.WorktreePath,\\n\\t\\t\\tBaseOID:      req.BaseOID,\\n\\t\\t\\tElementID:    req.ElementID,\\n\\t\\t})\\n\\t}\\n\\tsnapshot, err := take()\\n\\tif err != nil {\\n\\t\\treturn nil, err\\n\\t}\\n\\n\\t// §6.2.1: \\\"The producer runs the suite in the Story worktree at CR build and\\n\\t// records tree_oid = candidate_tree_oid.\\\"\\n\\t//\\n\\t// The suite runs against the WORKTREE, and the evidence claims a TREE. Those\\n\\t// are the same thing only if the worktree did not move while the suite ran,\\n\\t// so the candidate is recomputed afterwards and the two are compared. A\\n\\t// worktree that moved yields NO evidence rather than evidence keyed to a tree\\n\\t// the suite never saw — which `integrate` then refuses with\\n\\t// validation_not_bound_to_tree, before any ref moves. §4 step 7's drift check\\n\\t// catches the same movement later; this is the earlier, cheaper answer that\\n\\t// keeps the recorded evidence honest in the first place.\\n\\tvar validation *changerequest.Validation\\n\\tvar validationLog []byte\\n\\tif req.Suite.Configured {\\n\\t\\tresult, err := changerequest.RunSuite(changerequest.SuiteRunRequest{\\n\\t\\t\\tDir:       req.WorktreePath,\\n\\t\\t\\tTreeOID:   snapshot.CandidateTreeOID,\\n\\t\\t\\tSuite:     req.Suite,\\n\\t\\t\\tRunID:     req.ProducerRunID,\\n\\t\\t\\tOnCommand: req.OnSuiteCommand,\\n\\t\\t})\\n\\t\\tif err != nil {\\n\\t\\t\\treturn nil, err\\n\\t\\t}\\n\\t\\tafter, err := take()\\n\\t\\tif err != nil {\\n\\t\\t\\treturn nil, err\\n\\t\\t}\\n\\t\\tif after.CandidateTreeOID == snapshot.CandidateTreeOID {\\n\\t\\t\\tvalidation = result.Validation\\n\\t\\t\\tvalidationLog = changerequest.BoundValidationLog(result.Log)\\n\\t\\t\\tif validation != nil {\\n\\t\\t\\t\\tvalidation.LogResource = changerequest.ValidationLogResourceName(req.ElementID, req.ExpectedRevision+1)\\n\\t\\t\\t}\\n\\t\\t}\\n\\t}\\n\\n\\trecord, err := changerequest.NewStore(req.ControlRoot).Create(changerequest.CreateRequest{\\n\\t\\tElementID:          req.ElementID,\\n\\t\\tIntegrationScopeID: req.IntegrationScopeID,\\n\\t\\tWorkspaceID:        req.WorkspaceID,\\n\\t\\tKind:               req.Kind,\\n\\t\\tBranchRef:          req.BranchRef,\\n\\t\\tBaseOID:            req.BaseOID,\\n\\t\\tProducerRunID:      req.ProducerRunID,\\n\\t\\tProducerRole:       req.ProducerRole,\\n\\t\\tProducerArchetype:  req.ProducerArchetype,\\n\\t\\tExpectedRevision:   req.ExpectedRevision,\\n\\t\\tSnapshot:           snapshot,\\n\\t\\tValidation:         validation,\\n\\t\\tDiffResourceName:   changerequest.DiffResourceName(req.ElementID, req.ExpectedRevision+1),\\n\\t})\\n\\tif err != nil {\\n\\t\\treturn nil, err\\n\\t}\\n\\treturn &ChangeRequestPublishResult{Record: record, Patch: snapshot.Patch, ValidationLog: validationLog}, nil\\n}\\n\\nfunc (fileChangeRequests) Transition(controlRoot, elementID string, expectedRevision int, to changerequest.State, from []changerequest.State, runID, summary string) (*changerequest.Record, error) {\\n\\treturn changerequest.NewStore(controlRoot).Transition(changerequest.TransitionRequest{\\n\",\n  \"original_output_bytes\": 4630,\n  \"original_output_tokens\": 1158,\n  \"truncated\": false\n}"}}}
