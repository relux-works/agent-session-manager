trolRoot, elementID, manifest.Workspace != nil)\\n\\t}\\n\\n\\thandedOff, why, err := r.producerCompletionHandedOff(manifest, goal)\\n\\tif err != nil {\\n\\t\\treturn nil, err\\n\\t}\\n\\tif !handedOff {\\n\\t\\treturn changeRequestSkip(ChangeRequestSkipHandoffUnsatisfied, why), nil\\n\\t}\\n\\n\\tref, err := worktree.LoadRef(controlRoot, storyID)\\n\\tif err != nil {\\n\\t\\treturn nil, fmt.Errorf(\\\"loading the %s workspace record for Change Request construction: %w\\\", storyID, err)\\n\\t}\\n\\tif ref == nil {\\n\\t\\t// The run says it ran in a managed workspace and the registry says there\\n\\t\\t// is none. That is a contradiction, not an absence to route around: a\\n\\t\\t// snapshot taken against a guessed base would attest to the wrong thing.\\n\\t\\treturn nil, fmt.Errorf(\\\"run %s records the %s managed workspace but no workspace record exists\\\", manifest.ID, storyID)\\n\\t}\\n\\n\\tbranchRef := strings.TrimSpace(ref.BranchRef)\\n\\n\\t// §5 \\\"Final unresolved leaf\\\". The kind is DERIVED from the board, not\\n\\t// declared: this leaf's Change Request is the Story's integration unit\\n\\t// exactly when closing it would also close the Story.\\n\\tkind, err := r.resolveChangeRequestKind(elementID, storyID)\\n\\tif err != nil {\\n\\t\\treturn nil, err\\n\\t}\\n\\n\\t// The base follows from the kind, and it has to: a story_final patch covers\\n\\t// trunk to the complete Story candidate tree, while a task_delta covers the\\n\\t// Story branch tip to this leaf's addition. See changerequest.StoryFinalBase.\\n\\tbase := \\\"\\\"\\n\\tif kind == changerequest.KindStoryFinal {\\n\\t\\t// Provisioning already resolved and fetched the authoritative base and\\n\\t\\t// persisted the exact selected OID. Recomputing the fork through\\n\\t\\t// IntegrationBaseRef here is unsound: that ref is the control root's\\n\\t\\t// local branch and may still be behind its freshly fetched upstream. A\\n\\t\\t// story_final CR must bind to the recorded current base so it