ard q 'schema(operation=project_config)'\\n\",\n  \"original_output_bytes\": 3068,\n  \"original_output_tokens\": 767,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
