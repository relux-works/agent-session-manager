{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7f7","stream":{"kind":"session","id":"01a079c9-a389-7b22-a682-8d880628647c"},"sequence":598,"recorded_at":1780531400001191,"record_type":"event","durability":"durable","causation_id":"15fbab40-2656-4b01-9f2b-97bf36f3de82","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"15fbab40-2656-4b01-9f2b-97bf36f3de82","run_stream":{"kind":"run","id":"15fbab40-2656-4b01-9f2b-97bf36f3de82"},"task_stream":{"kind":"task","id":"eebdb83b-fcd5-4dcd-8808-6d17670fe5b8"},"task_id":"eebdb83b-fcd5-4dcd-8808-6d17670fe5b8","event":{"kind":"output","task_id":"eebdb83b-fcd5-4dcd-8808-6d17670fe5b8","chunk":"{\n  \"chunk_id\": \"exec-31-1\",\n  \"command\": \"sed -n '230,400p' /Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/goal_acceptance.go\",\n  \"description\": \"Read completion artifact guard behavior\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"\\t\\treturn pkgboard.GoalReviewerVerdictChangesNeeded, nil\\n\\tcase pkgboard.StatusBlocked:\\n\\t\\treturn pkgboard.GoalReviewerVerdictStopTheLine, nil\\n\\tdefault:\\n\\t\\treturn \\\"\\\", fmt.Errorf(\\\"reviewer run has no verdict branch while %s is %s\\\", manifest.TaskID, element.Status)\\n\\t}\\n}\\n\\n// evaluateReviewerBranchPresence is the goal-less counterpart to\\n// evaluateReviewerGoalVerdict below. An ordinary\\n// `task-board spawn TASK --role reviewer --background` carries no goal\\n// contract, so nothing on the completion path ever asked whether the reviewer\\n// recorded a verdict — a zero exit with the element still `reviewing` read as\\n// an unconditional success. This applies the same reviewerVerdictBranch rule\\n// without requiring the run to be goal-bound, and without asserting anything\\n// about evidence or allowed-verdict policy: those remain goal-contract\\n// concerns and are deliberately not re-implemented here.\\nfunc (r *Runtime) evaluateReviewerBranchPresence(manifest *spawnRunManifest) error {\\n\\tif manifest == nil {\\n\\t\\treturn nil\\n\\t}\\n\\tif r.completionActions == nil {\\n\\t\\treturn fmt.Errorf(\\\"reviewer branch presence for %s could not be established: this runtime has no completion actions\\\", manifest.TaskID)\\n\\t}\\n\\tloader, ok := r.completionActions.(GoalBoardLoader)\\n\\tif !ok {\\n\\t\\treturn fmt.Errorf(\\\"reviewer branch presence for %s could not be established: no board loader is wired\\\", manifest.TaskID)\\n\\t}\\n\\tboardModel, err := loader.LoadGoalBoard()\\n\\tif err != nil {\\n\\t\\treturn fmt.Errorf(\\\"reviewer branch presence for %s could not be established: the board could not be read: %w\\\", manifest.TaskID, err)\\n\\t}\\n\\telement := boardModel.FindByID(manifest.TaskID)\\n\\tif element == nil {\\n\\t\\treturn fmt.Errorf(\\\"reviewer task %s is missing from the board\\\", manifest.TaskID)\\n\\t}\\n\\t_, err = r.reviewerVerdictBranch(manifest, element)\\n\\treturn err\\n}\\n\\n// evaluateProducerBranchPresence is the goal-less (or non-role-handoff-goal)\\n// counterpart to evaluateRoleHandoff, for a producer-archetype completion.\\n//\\n// A `task-board spawn TASK --role developer --background` run that never\\n// binds a role-handoff goal used to have no equivalent check anywhere on the\\n// completion path: a zero exit that left the element parked at its start\\n// status (development), published no Change Request and reached no handoff,\\n// still fell through to spawnRunStatusCompleted. This reuses\\n// producerCompletionHandedOff — the same rule Change Request construction and\\n// the goal-bound role-handoff evaluation above already apply to a producer's\\n// completion — without requiring the run to be goal-bound or to claim a\\n// managed workspace.\\n//\\n// It is a no-op unless the run itself declared a terminal handoff obligation\\n// (RequireOutcomeArtifact and a non-empty EndStatus): a run that promised\\n// neither has nothing this check can hold it to, and completion.go's own\\n// pre-existing guard is silent on exactly the same condition for the same\\n// reason.\\n//\\n// A read that FAILS (producerCompletionHandedOff returning a non-nil error)\\n// is returned as-is, never folded into \\\"not handed off\\\": an unreadable board\\n// is not evidence that the producer left nothing behind.\\nfunc (r *Runtime) evaluateProducerBranchPresence(manifest *spawnRunManifest, goal *pkgboard.GoalContract) error {\\n\\tif manifest == nil {\\n\\t\\treturn nil\\n\\t}\\n\\tif !manifest.RequireOutcomeArtifact || strings.TrimSpace(manifest.EndStatus) == \\\"\\\" {\\n\\t\\treturn nil\\n\\t}\\n\\thandedOff, why, err := r.producerCompletionHandedOff(manifest, goal)\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tif handedOff {\\n\\t\\treturn nil\\n\\t}\\n\\tif r.completionActions == nil {\\n\\t\\treturn fmt.Errorf(\\\"producer branch presence for %s could not be established: this runtime has no completion actions\\\", manifest.TaskID)\\n\\t}\\n\\tloader, ok := r.completionActions.(GoalBoardLoader)\\n\\tif !ok {\\n\\t\\treturn fmt.Errorf(\\\"producer branch presence for %s could not be established: no board loader is wired\\\", manifest.TaskID)\\n\\t}\\n\\tboardModel, err := loader.LoadGoalBoard()\\n\\tif err != nil {\\n\\t\\treturn fmt.Errorf(\\\"producer branch presence for %s could not be established: the board could not be read: %w\\\", manifest.TaskID, err)\\n\\t}\\n\\telement := boardModel.FindByID(manifest.TaskID)\\n\\tif element == nil {\\n\\t\\treturn fmt.Errorf(\\\"producer task %s is missing from the board\\\", manifest.TaskID)\\n\\t}\\n\\treturn fmt.Errorf(\\\"producer run %s published no Change Request and reached no handoff branch while %s is %s: %s\\\",\\n\\t\\tmanifest.ID, manifest.TaskID, element.Status, why)\\n}\\n\\n// isReviewableProducerHandoff identifies the producer revision a reviewer can\\n// accept. A later producer-bound integration run is also a role-handoff goal,\\n// but it consumes that accepted revision and stays at integrating; treating it\\n// as a new producer candidate would require a reviewer verdict after landing\\n// and make every required/light delivery goal permanently unsatisfiable.\\nfunc isReviewableProducerHandoff(manifest *spawnRunManifest) bool {\\n\\tif manifest == nil || manifest.LaunchGoal == nil || manifest.LaunchGoal.Kind != pkgboard.GoalKindRoleHandoff {\\n\\t\\treturn false\\n\\t}\\n\\tif strings.EqualFold(strings.TrimSpace(manifest.RoleArchetype), \\\"reviewer\\\") {\\n\\t\\treturn false\\n\\t}\\n\\treturn strings.EqualFold(strings.TrimSpace(manifest.EndStatus), string(pkgboard.StatusToReview)) &&\\n\\t\\t!strings.EqualFold(strings.TrimSpace(manifest.StartStatus), string(pkgboard.StatusIntegrating))\\n}\\n\\nfunc (r *Runtime) evaluateReviewerGoalVerdict(manifest *spawnRunManifest, goal *pkgboard.GoalContract) (*GoalReviewerVerdictRecord, error) {\\n\\tif manifest == nil || goal == nil || goal.Kind != pkgboard.GoalKindReviewerVerdict {\\n\\t\\treturn nil, fmt.Errorf(\\\"reviewer verdict goal is required\\\")\\n\\t}\\n\\tloader, ok := r.completionActions.(GoalBoardLoader)\\n\\tif !ok {\\n\\t\\treturn nil, fmt.Errorf(\\\"reviewer verdict requires a board loader\\\")\\n\\t}\\n\\tboardModel, err := loader.LoadGoalBoard()\\n\\tif err != nil {\\n\\t\\treturn nil, fmt.Errorf(\\\"loading board for reviewer verdict: %w\\\", err)\\n\\t}\\n\\telement := boardModel.FindByID(manifest.TaskID)\\n\\tif element == nil {\\n\\t\\treturn nil, fmt.Errorf(\\\"reviewer task %s is missing from the board\\\", manifest.TaskID)\\n\\t}\\n\\tbranch, err := r.reviewerVerdictBranch(manifest, element)\\n\\tif err != nil {\\n\\t\\treturn nil, err\\n\\t}\\n\\tallowed := false\\n\\tfor _, candidate := range goal.RolePolicy.AllowedReviewerVerdicts {\\n\\t\\tif candidate == branch {\\n\\t\\t\\tallowed = true\\n\\t\\t\\tbreak\\n\\t\\t}\\n\\t}\\n\\tif !allowed {\\n\\t\\treturn nil, fmt.Errorf(\\\"reviewer verdict %s is not allowed by goal %s\\\", branch, goal.ID)\\n\\t}\\n\\tstatusMatches, hasEvidence, err := r.completionActions.CheckOutcomeEvidence(\\n\\t\\tmanifest.TaskID,\\n\\t\\tstring(element.Status),\\n\\t\\tcloneSpawnOutcomeDigests(manifest.InitialOutcomeDigests),\\n\\t\\tspawnOutcomeNameSet(manifest.InitialOutcomeNames),\\n\\t)\\n\\tif err != nil {\\n\\t\\treturn nil, fmt.Errorf(\\\"checking reviewer verdict evidence: %w\\\", err)\\n\\t}\\n\\tif !statusMatches || !hasEvidence {\\n\\t\\treturn nil, fmt.Errorf(\\\"reviewer verdict %s requires new or updated task-scoped evidence at board status %s\\\", branch, element.Status)\\n\\t}\\n\\treturn &GoalReviewerVerdictRecord{Branch: branch, BoardStatus: element.Status, Evidence: true, RecordedAt: r.now().UTC().Format(time.RFC3339Nano)}, nil\\n}\\n\\nfunc (r *Runtime) evaluateRoleHandoff(manifest *spawnRunManifest, goal *pkgboard.GoalContract) error {\\n\\tif manifest == nil || goal == nil || goal.Kind != pkgboard.GoalKindRoleHandoff {\\n\\t\\treturn fmt.Errorf(\\\"role handoff goal is required\\\")\\n\\t}\\n\\tif r.completionActions == nil {\\n\\t\\treturn fmt.Errorf(\\\"role handoff requires completion actions\\\")\\n\\t}\\n\\tendStatus := strings.TrimSpace(goal.RolePolicy.HandoffEndStatus)\\n\\tif endStatus == \\\"\\\" {\\n\\t\\treturn fmt.Errorf(\\\"role handoff goal %s has no immutable end status\\\", goal.ID)\\n\\t}\\n\\tif !manifest.RequireOutcomeArtifact {\\n\\t\\treturn fmt.Errorf(\\\"role handoff run %s does not require task-scoped outcome evidence\\\", manifest.ID)\\n\\t}\\n\\tstatusMatches, hasEvidence, err := r.completionActions.CheckOutcomeEvidence(\\n\",\n  \"original_output_bytes\": 7755,\n  \"original_output_tokens\": 1939,\n  \"truncated\": false\n}"}}}
