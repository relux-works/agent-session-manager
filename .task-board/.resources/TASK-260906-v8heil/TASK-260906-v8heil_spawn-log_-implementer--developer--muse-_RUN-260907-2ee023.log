 is the\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-465-// point: managed workspace activation is not goal-gated, so the half of the\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-466-// feature that makes the worktree reviewable must not be either.\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-467-//\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-468-// Ordering is the rest of the point. This runs *after* the spawn completion\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-469-// artifact guard has already had its say — the guard is inside the launch hook —\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-470-// and the handoff precondition below re-establishes the same two facts the guard\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-471-// checks, so a run that attached nothing skips with a stated reason and never\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-472-// leaves a CR record. §4 is explicit that the produced-nothing case belongs to\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-473-// that guard, on stronger evidence, and is not re-implemented here.\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-474-//\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-475-// A zero-delta candidate is published like any other. There is no branch here\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-476-// that inspects changed_paths and routes back to the producer: deciding whether\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-477-// \\\"this producer changed no repository file\\\" is correct requires judging intent\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-478-// against delivery, which is the reviewer's job.\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-479-func (r *Runtime) publishChangeRequestForProducer(manifest *spawnRunManifest, goal *pkgboard.GoalContract) (*changeRequestPublication, error) {\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-480-\\tif manifest == nil {\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-481-\\t\\treturn changeRequestSkip(ChangeRequestSkipNotAProducer, \\\"there is no run manifest to construct a candidate from\\\"), nil\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-482-\\t}\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-483-\\tif strings.EqualFold(strings.TrimSpace(manifest.RoleArchetype), \\\"reviewer\\\") {\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-484-\\t\\treturn changeRequestSkip(ChangeRequestSkipNotAProducer,\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-485-\\t\\t\\t\\\"this is a reviewer-archetype run; a reviewer judges a candidate rather than publishing one\\\"), nil\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-486-\\t}\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-487-\\tif strings.EqualFold(strings.TrimSpace(manifest.StartStatus), string(pkgboard.StatusIntegrating)) {\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-488-\\t\\t// This producer is consuming the immutable accepted revision, not\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-489-\\t\\t// publishing a replacement candidate. The integration transaction owns\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-490-\\t\\t// the terminal board transition.\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-491-\\t\\treturn changeRequestSkip(ChangeRequestSkipNotAProducer,\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-492-\\t\\t\\t\\\"this is the accepted revision's producer-bound integration run\\\"), nil\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-493-\\t}\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-494-\\tif !manifestClaimsManagedWorkspace(manifest) {\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-495-\\t\\t// The ordinary un-isolated spawn. There is no worktree to snapshot, and\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-496-\\t\\t// §9.1 is not consulted: a run that constructs nothing has no local-board\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-497-\\t\\t// requirement to meet, and refusing it would break every remote spawn\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-498-\\t\\t// that never asked for a workspace.\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-499-\\t\\treturn changeRequestSkip(ChangeRequestSkipNoManagedWorkspace,\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-500-\\t\\t\\t\\\"this run claims no managed Story workspace, so there is no candidate worktree to snapshot\\\"), nil\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-501-\\t}\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-502-\\t// §9.1 (design matrix row 13i), at the construction surface and before\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-503-\\t// anything is written.\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-504-\\t//\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-505-\\t// The other half of this rule lives on accept_cr. Both are needed: a remote\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-506-\\t// launch leaves Workspace nil today, so the absence of a CR record on that\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-507-\\t// path is an accident of provisioning rather than a refusal, and a board\\n/Users/iv/.agents/skills/project-management/tools/board-cli/internal/spawnruntime/changerequest.go-508-\\t// mode that flips between launch and completion would sail straight through\\n\",\n  \"original_output_bytes\": 13817,\n  \"original_output_tokens\": 3455,\n  \"truncated\": false\n}"}}}
