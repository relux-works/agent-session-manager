+		literal(token.INT, "48"), literal(token.INT, "57"),
+		literal(token.INT, "0x30"), literal(token.INT, "0x39"),
+		literal(token.INT, "0X30"), literal(token.INT, "0o60"),
+		literal(token.INT, "060"), literal(token.INT, "4_8"),
