{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c469","stream":{"kind":"session","id":"01a06e75-bbc6-7500-a9cb-f70149b63e89"},"sequence":143,"recorded_at":1780531400000281,"record_type":"event","durability":"durable","causation_id":"4e2efeb9-af88-4b92-82e3-c4ef7a43be2c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4e2efeb9-af88-4b92-82e3-c4ef7a43be2c","run_stream":{"kind":"run","id":"4e2efeb9-af88-4b92-82e3-c4ef7a43be2c"},"task_stream":{"kind":"task","id":"b16b6d14-fd42-44bc-ad36-423022306898"},"task_id":"b16b6d14-fd42-44bc-ad36-423022306898","event":{"kind":"output","task_id":"b16b6d14-fd42-44bc-ad36-423022306898","chunk":"Read text file `internal/terminalbackend/terminalbackend_test.go`.\n(499 line(s) above)\n500|\t\t\tif !terminalbackend.IsDrift(err) {\n501|\t\t\t\tt.Errorf(\"CheckVersionTuple() error = %v, want terminal_backend_implementation_drift\", err)\n502|\t\t\t}\n503|\t\t})\n504|\t}\n505|}\n506|\n507|// TestCheckProviderDescriptor drives the Section 7.A production rule: the\n508|// provider rejects a descriptor that does not match the validated binding.\n509|func TestCheckProviderDescriptor(t *testing.T) {\n510|\tt.Parallel()\n511|\n512|\tbinding := terminalbackend.InstanceBinding{\n513|\t\tBackendID:             \"com.example.term\",\n514|\t\tImplementationVersion: \"1.2.3\",\n515|\t\tProtocolVersion:       \"1.0.0\",\n516|\t\tGeneration:            \"generation-1\",\n517|\t}\n518|\tif err := terminalbackend.CheckProviderDescriptor(binding, binding); err != nil {\n519|\t\tt.Errorf(\"CheckProviderDescriptor(match) error = %v, want admission\", err)\n520|\t}\n521|\n522|\tversionDrift := binding\n523|\tversionDrift.ImplementationVersion = \"1.2.4\"\n524|\tif err := terminalbackend.CheckProviderDescriptor(versionDrift, binding); !terminalbackend.IsDrift(err) {\n525|\t\tt.Errorf(\"CheckProviderDescriptor(version drift) error = %v, want terminal_backend_implementation_drift\", err)\n526|\t}\n527|\tprotoDrift := binding\n528|\tprotoDrift.ProtocolVersion = \"1.1.0\"\n529|\tif err := terminalbackend.CheckProviderDescriptor(protoDrift, binding); !terminalbackend.IsDrift(err) {\n530|\t\tt.Errorf(\"CheckProviderDescriptor(protocol drift) error = %v, want terminal_backend_implementation_drift\", err)\n531|\t}\n532|\tidMismatch := binding\n533|\tidMismatch.BackendID = \"com.example.other\"\n534|\tif err := terminalbackend.CheckProviderDescriptor(idMismatch, binding); !terminalbackend.IsNotFound(err) {\n535|\t\tt.Errorf(\"CheckProviderDescriptor(ID mismatch) error = %v, want terminal_backend_not_found\", err)\n536|\t}\n537|\tstale := binding\n538|\tstale.Generation = \"generation-2\"\n539|\tif err := terminalbackend.CheckProviderDescriptor(stale, binding); !terminalbackend.IsStaleGeneration(err) {\n540|\t\tt.Errorf(\"CheckProviderDescriptor(stale generation) error = %v, want terminal_backend_stale_generation\", err)\n541|\t}\n542|}\n543|\n544|// TestCheckProviderDescriptorGenerationBounds proves the 1..256 bound in both\n545|// directions against the number the specification declares: 256 accepted, 0\n546|// and 257 refused, on either side of the comparison.\n547|func TestCheckProviderDescriptorGenerationBounds(t *testing.T) {\n548|\tt.Parallel()\n549|\n550|\tatLimit := strings.Repeat(\"g\", 256)\n551|\toverLimit := strings.Repeat(\"g\", 257)\n552|\tbase := terminalbackend.InstanceBinding{\n553|\t\tBackendID:             \"com.example.term\",\n554|\t\tImplementationVersion: \"1.2.3\",\n555|\t\tProtocolVersion:       \"1.0.0\",\n556|\t\tGeneration:            atLimit,\n557|\t}\n558|\tif err := terminalbackend.CheckProviderDescriptor(base, base); err != nil {\n559|\t\tt.Errorf(\"CheckProviderDescriptor(256-byte generation) error = %v, want admission\", err)\n560|\t}\n561|\tmutate := func(binding terminalbackend.InstanceBinding, mutate func(*terminalbackend.InstanceBinding)) terminalbackend.InstanceBinding {\n562|\t\tmutate(&binding)\n563|\t\treturn binding\n564|\t}\n565|\trefused := []struct {\n566|\t\tname       string\n567|\t\tdescriptor terminalbackend.InstanceBinding\n568|\t\tbinding    terminalbackend.InstanceBinding\n569|\t}{\n570|\t\t{\"empty descriptor generation\", mutate(base, func(b *terminalbackend.InstanceBinding) { b.Generation = \"\" }), base},\n571|\t\t{\"257-byte descriptor generation\", mutate(base, func(b *terminalbackend.InstanceBinding) { b.Generation = overLimit }), base},\n572|\t\t{\"empty binding generation\", base, mutate(base, func(b *terminalbackend.InstanceBinding) { b.Generation = \"\" })},\n573|\t\t{\"257-byte binding generation\", base, mutate(base, func(b *terminalbackend.InstanceBinding) { b.Generation = overLimit })},\n574|\t}\n575|\tfor _, testCase := range refused {\n576|\t\tt.Run(testCase.name, func(t *testing.T) {\n577|\t\t\tt.Parallel()\n578|\t\t\terr := terminalbackend.CheckProviderDescriptor(testCase.descriptor, testCase.binding)\n579|\t\t\tif !terminalbackend.IsStaleGeneration(err) {\n580|\t\t\t\tt.Errorf(\"CheckProviderDescriptor() error = %v, want terminal_backend_stale_generation\", err)\n581|\t\t\t}\n582|\t\t})\n583|\t}\n584|}\n585|\n586|// TestDigestFile binds trust to bytes: the digest of a real file verifies,\n587|// symlinks resolve to their target, and non-files or missing paths fail\n588|// without producing a digest.\n589|func TestDigestFile(t *testing.T) {\n590|\tt.Parallel()\n591|\n592|\tpayload := []byte(\"#!/bin/sh\\nexec ax-backend-term \\\"$@\\\"\\n\")\n593|\tpath := filepath.Join(t.TempDir(), \"ax-backend-term\")\n594|\tif err := os.WriteFile(path, payload, 0o755); err != nil {\n595|\t\tt.Fatalf(\"WriteFile() error = %v\", err)\n596|\t}\n597|\tsum := sha256.Sum256(payload)\n598|\twant := \"sha256:\" + hex.EncodeToString(sum[:])\n599|\tgot, err := terminalbackend.DigestFile(path)\n600|\tif err != nil {\n601|\t\tt.Fatalf(\"DigestFile() error = %v\", err)\n602|\t}\n603|\tif got != want {\n604|\t\tt.Errorf(\"DigestFile() = %q, want %q\", got, want)\n605|\t}\n606|\tlink := filepath.Join(t.TempDir(), \"link-backend-term\")\n607|\tif err := os.Symlink(path, link); err != nil {\n608|\t\tt.Fatalf(\"Symlink() error = %v\", err)\n609|\t}\n610|\tgotLink, err := terminalbackend.DigestFile(link)\n611|\tif err != nil {\n612|\t\tt.Fatalf(\"DigestFile(symlink) error = %v\", err)\n613|\t}\n614|\tif gotLink != want {\n615|\t\tt.Errorf(\"DigestFile(symlink) = %q, want %q\", gotLink, want)\n616|\t}\n617|\tif _, err := terminalbackend.DigestFile(filepath.Join(t.TempDir(), \"absent\")); err == nil {\n618|\t\tt.Error(\"DigestFile(absent) error = nil, want a failed read\")\n619|\t}\n620|\tif _, err := terminalbackend.DigestFile(t.TempDir()); err == nil {\n621|\t\tt.Error(\"DigestFile(directory) error = nil, want refusal for a non-regular file\")\n622|\t}\n623|}\n624|\n625|// TestErrorPredicatesAreExclusive guards the negative-evidence contract: a\n626|// refusal carries exactly one wire code, so a passing negative test cannot be\n627|// explained by overlapping predicates.\n628|func TestErrorPredicatesAreExclusive(t *testing.T) {\n629|\tt.Parallel()\n630|\n631|\tregistry := testRegistry(t)\n632|\tmustRegisterExternal(t, registry, \"com.example.term\")\n633|\n634|\tcases := []struct {\n635|\t\tname string\n636|\t\terr  error\n637|\t\twant func(error) bool\n638|\t}{\n639|\t\t{\"unknown\", func() error { _, err := registry.Resolve(\"com.example.gone\"); return err }(), terminalbackend.IsNotFound},\n640|\t\t{\"duplicate\", func() error {\n641|\t\t\treturn registry.RegisterExternal(scalar.PlatformLinux, testTrustEntry(\"com.example.term\"), testExternalRecord(\"com.example.term\"))\n642|\t\t}(), terminalbackend.IsAmbiguous},\n643|\t\t{\"drift\", func() error {\n644|\t\t\tdrifted := testExternalRecord(\"com.example.term\")\n645|\t\t\tdrifted.ImplementationVersion = \"9.9.9\"\n646|\t\t\treturn registry.RegisterExternal(scalar.PlatformLinux, testTrustEntry(\"com.example.term\"), drifted)\n647|\t\t}(), terminalbackend.IsDrift},\n648|\t\t{\"untrusted\", func() error {\n649|\t\t\tentry := testTrustEntry(\"com.example.fresh\")\n650|\t\t\tentry.Enabled = false\n651|\t\t\treturn registry.RegisterExternal(scalar.PlatformLinux, entry, testExternalRecord(\"com.example.fresh\"))\n652|\t\t}(), terminalbackend.IsUntrusted},\n653|\t\t{\"restore mismatch\", func() error {\n654|\t\t\t_, err := registry.RequireRestoreBinding(\"com.example.term\", terminalbackend.BuiltinTmux)\n655|\t\t\treturn err\n656|\t\t}(), terminalbackend.IsRestoreMismatch},\n657|\t\t{\"stale generation\", func() error {\n658|\t\t\tbinding := terminalbackend.InstanceBinding{BackendID: \"com.example.term\", ImplementationVersion: \"1.2.3\", ProtocolVersion: \"1.0.0\", Generation: \"a\"}\n659|\t\t\tstale := binding\n660|\t\t\tstale.Generation = \"b\"\n661|\t\t\treturn terminalbackend.CheckProviderDescriptor(stale, binding)\n662|\t\t}(), terminalbackend.IsStaleGeneration},\n663|\t}\n664|\tpredicates := map[string]func(error) bool{\n665|\t\t\"not found\": terminalbackend.IsNotFound, \"ambiguous\": terminalbackend.IsAmbiguous,\n666|\t\t\"untrusted\": terminalbackend.IsUntrusted, \"drift\": terminalbackend.IsDrift,\n667|\t\t\"restore mismatch\": terminalbackend.IsRestoreMismatch, \"stale\": terminalbackend.IsStaleGeneration,\n668|\t}\n669|\tfor _, testCase := range cases {\n670|\t\tt.Run(testCase.name, func(t *testing.T) {\n671|\t\t\tt.Parallel()\n672|\t\t\tif testCase.err == nil {\n673|\t\t\t\tt.Fatalf(\"expected a refusal, got nil\")\n674|\t\t\t}\n675|\t\t\tmatched := 0\n676|\t\t\tfor name, predicate := range predicates {\n677|\t\t\t\tif predicate(testCase.err) {\n678|\t\t\t\t\tmatched++\n679|\t\t\t\t\tif !testCase.want(testCase.err) {\n680|\t\t\t\t\t\tt.Errorf(\"refusal %v unexpectedly matches %q\", testCase.err, name)\n681|\t\t\t\t\t}\n682|\t\t\t\t}\n683|\t\t\t}\n684|\t\t\tif matched != 1 {\n685|\t\t\t\tt.Errorf(\"refusal %v matches %d predicates, want exactly 1\", testCase.err, matched)\n686|\t\t\t}\n687|\t\t})\n688|\t}\n689|}"}}}
