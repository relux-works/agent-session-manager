figError(\"terminal.graceful_stop_timeout_seconds\", ErrConfigValidation)\n668|\t}\n669|\tif err := validateSortedUniqueClosed(terminal.RequiredCapabilities, terminalCapabilitySet); err != nil {\n670|\t\treturn configError(\"terminal.required_capabilities\", err)\n671|\t}\n672|\tif !terminal.RequiredCapabilitiesExplicit && len(terminal.RequiredCapabilities) != 0 {\n673|\t\treturn configError(\"terminal.required_capabilities default provenance\", ErrConfigValidation)\n674|\t}\n675|\tif !oneOf(terminal.MultipleInputPolicy, \"deny\", \"explicit_allow\") {\n676|\t\treturn configError(\"terminal.multiple_input_policy\", ErrConfigValidation)\n677|\t}\n678|\tif err := validateSortedUniqueClosed(terminal.TransportPolicy, map[string]struct{}{\"local_only\": {}, \"trusted_private_mesh\": {}}); err != nil {\n679|\t\treturn configError(\"terminal.transport_policy\", err)\n680|\t}\n681|\tif !terminal.TransportPolicyExplicit && !equalStrings(terminal.TransportPolicy, []string{\"local_only\", \"trusted_private_mesh\"}) {\n682|\t\treturn configError(\"terminal.transport_policy default provenance\", ErrConfigValidation)\n683|\t}\n684|\tif terminal.BackendID == \"ax.tmux\" && configuration.Platform == scalar.PlatformWindows {\n685|\t\treturn configError(\"terminal.backend_id unsupported platform\", ErrConfigValidation)\n686|\t}\n687|\tif terminal.BackendID == \"ax.conpty\" && configuration.Platform != scalar.PlatformWindows {\n688|\t\treturn configError(\"terminal.backend_id unsupported platform\", ErrConfigValidation)\n689|\t}\n690|\tregistered := map[string]struct{}{\"ax.tmux\": {}, \"ax.conpty\": {}}\n691|\ttrustIDs := map[string]struct{}{}\n692|\tfor index, entry := range terminal.ExternalTrust {\n693|\t\tprefix := fmt.Sprintf(\"terminal.external_trust[%d]\", index)\n694|\t\tif _, err := terminalbackend.ParseID(entry.BackendID); err != nil {\n695|\t\t\treturn configError(prefix+\".backend_id\", ErrConfigValidation)\n696|\t\t}\n697|\t\t// The ax. namespace is reserved for the canonical built-ins. An\n698|\t\t// external trust entry claiming any ax. ID is ambiguous with the\n699|\t\t// built-in candidate and fails closed before any probe.\n700|\t\tif strings.HasPrefix(entry.BackendID, \"ax.\") {\n701|\t\t\treturn configError(prefix+\".backend_id\", ErrConfigValidation)\n702|\t\t}\n703|\t\tif _, exists := trustIDs[entry.BackendID]; exists {\n704|\t\t\treturn configError(\"terminal.external_trust duplicate backend_id\", ErrConfigValidation)\n705|\t\t}\n706|\t\ttrustIDs[entry.BackendID] = struct{}{}\n707|\t\tif entry.Enabled {\n708|\t\t\tregistered[entry.BackendID] = struct{}{}\n709|\t\t}\n710|\t\tif _, err := scalar.ParseAbsolutePath(configuration.Platform, entry.ExecutablePath); err != nil {\n711|\t\t\treturn configError(prefix+\".executable_path\", errors.Join(ErrConfigValidation, err))\n712|\t\t}\n713|\t\tif _, err := scalar.ParseDigest(entry.ExecutableDigest); err != nil {\n714|\t\t\treturn configError(prefix+\".executable_digest\", errors.Join(ErrConfigValidation, err))\n715|\t\t}\n716|\t}\n717|\tif _, ok := registered[terminal.BackendID]; !ok {\n718|\t\treturn configError(\"terminal.backend_id is not registered\", ErrConfigValidation)\n719|\t}\n720|\tconfigIDs := map[string]struct{}{}\n721|\tfor index, entry := range terminal.BackendConfig {\n722|\t\tprefix := fmt.Sprintf(\"terminal.backend_config[%d]\", index)\n723|\t\tif _, ok := registered[entry.BackendID]; !ok {\n724|\t\t\treturn configError(prefix+\".backend_id is not registered\", ErrConfigValidation)\n725|\t\t}\n726|\t\tif _, exists := configIDs[entry.BackendID]; exists {\n727|\t\t\treturn configError(\"terminal.backend_config duplicate backend_id\", ErrConfigValidation)\n728|\t\t}\n729|\t\tconfigIDs[entry.BackendID] = struct{}{}\n730|\t\tif !semverPattern.MatchString(entry.ConfigVersion) {\n731|\t\t\treturn configError(prefix+\".config_version\", ErrConfigValidation)\n732|\t\t}\n733|\t\tif entry.Settings == nil {\n734|\t\t\treturn configError(prefix+\".settings\", ErrConfigValidation)\n735|\t\t}\n736|\t\tif context.BackendSettings == nil {\n737|\t\t\treturn configError(prefix+\" has no registered settings schema\", ErrConfigValidation)\n738|\t\t}\n739|\t\tif err := context.BackendSettings.ValidateBackendSettings(entry.BackendID, entry.ConfigVersion, cloneAnyMap(entry.Settings)); err != nil {\n740|\t\t\treturn configError(prefix+\".settings\", errors.Join(ErrConfigValidation, err))\n741|\t\t}\n742|\t}\n743|\treturn nil\n744|}\n745|\n746|func validateExtensions(extensions map[string]any) error {\n747|\tif extensions == nil {\n748|\t\treturn ErrConfigValidation\n749|\t}\n750|\tif len(extensions) > 64 {\n751|\t\treturn ErrConfigValidation\n752|\t}\n753|\tfor key, value := range extensions {\n754|\t\t// SPEC.md:345-347 defines an extension key as exactly this grammar:\n755|\t\t// \"A reverse-DNS key is 3-253 lowercase ASCII characters, contains at\n756|\t\t// least one dot, and has dot-separated labels matching\n757|\t\t// [a-z][a-z0-9-]{0,62}\". It declares no reserved or forbidden label,\n758|\t\t// so no name is refused beyond that grammar and the byte bound.\n759|\t\t// reverseDNSPattern itself makes a.b the shortest accepted namespace,\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c69d","stream":{"kind":"session","id":"01a06e75-bbc6-7500-a9cb-f70149b63e89"},"sequence":425,"recorded_at":1780531400000845,"record_type":"event","durability":"durable","causation_id":"4e2efeb9-af88-4b92-82e3-c4ef7a43be2c","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4e2efeb9-af88-4b92-82e3-c4ef7a43be2c","run_stream":{"kind":"run","id":"4e2efeb9-af88-4b92-82e3-c4ef7a43be2c"},"call_id":"call_01a06e76c2fe70339b96fbcde55b9dd2","text":"Read text file `internal/config/terminal_registry_wiring_test.go`.\n1|package config\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|)\n9|\n10|// TestEncodeCurrentRefusesReservedBackendNamespace proves the terminal backend\n11|// registry is a live production call site of configuration validation: an\n12|// ax.-namespaced ID outside the two canonical built-ins is refused at the\n13|// exact clause, while the built-ins and vendor namespaces keep working.\n14|func TestEncodeCurrentRefusesReservedBackendNamespace(t *testing.T) {\n15|\tt.Parallel()\n16|\n17|\tt.Run(\"selected reserved ID\", func(t *testing.T) {\n18|\t\tt.Parallel()\n19|\t\tconfiguration := validCurrentConfiguration()\n20|\t\tconfiguration.Terminal.BackendID = \"ax.evil\"\n21|\t\t_, err := EncodeCurrent(configuration, DecodeContext{RuntimePlatform: scalar.PlatformMacOS})\n22|\t\trequireConfigClause(t, err, \"terminal.backend_id\")\n23|\t})\n24|\n25|\tt.Run(\"external trust reserved ID\", func(t *testing.T) {\n26|\t\tt.Parallel()\n27|\t\tconfiguration := validCurrentConfiguration()\n28|\t\tconfiguration.Terminal.ExternalTrust = []ExternalExecutableTrust{{\n29|\t\t\tBackendID:        \"ax.evil\",\n30|\t\t\tExecutablePath:   \"/opt/vendor/bin/ax-backend-evil\",\n31|\t\t\tExecutableDigest: testDigest,\n32|\t\t\tEnabled:          true,\n33|\t\t}}\n34|\t\t_, err := EncodeCurrent(configuration, DecodeContext{RuntimePlatform: scalar.PlatformMacOS})\n35|\t\trequireConfigClause(t, err, \"terminal.external_trust[0].backend_id\")\n36|\t})\n37|\n38|\tt.Run(\"external trust claiming a built-in ID is ambiguous\", func(t *testing.T) {\n39|\t\tt.Parallel()\n40|\t\tconfiguration := validCurrentConfiguration()\n41|\t\tconfiguration.Terminal.ExternalTrust = []ExternalExecutableTrust{{\n42|\t\t\tBackendID:        \"ax.tmux\",\n43|\t\t\tExecutablePath:   \"/opt/vendor/bin/ax-backend-tmux\",\n44|\t\t\tExecutableDigest: testDigest,\n45|\t\t\tEnabled:          true,\n46|\t\t}}\n47|\t\t_, err := EncodeCurrent(configuration, DecodeContext{RuntimePlatform: scalar.PlatformMacOS})\n48|\t\trequireConfigClause(t, err, \"terminal.external_trust[0].backend_id\")\n49|\t})\n50|\n51|\tt.Run(\"canonical built-ins still admitted\", func(t *testing.T) {\n52|\t\tt.Parallel()\n53|\t\tconfiguration := validCurrentConfiguration()\n54|\t\tconfiguration.Terminal.BackendID = \"ax.tmux\"\n55|\t\tif _, err := EncodeCurrent(configuration, DecodeContext{RuntimePlatform: scalar.PlatformMacOS}); err != nil {\n56|\t\t\tt.Fatalf(\"EncodeCurrent(ax.tmux) error = %v\", err)\n57|\t\t}\n58|\t})\n59|}\n60|\n61|// TestDecodeRefusesNonConptyBackendOnNativeWindows pins the Section 6.2\n62|// sentence \"On native Windows, ... terminal backend MUST be conpty\"\n63|// (SPEC.md:2415-2418) through the legacy translation path: a v1 document\n64|// naming tmux on Windows refuses at the production load entry, while conpty\n65|// loads. The v3 lane split is pinned separately by the \"built-in backend\n66|// unsupported on platform\" Decode case and the \"conpty platform\" refusal\n67|// case; this test closes the legacy arm without extending the rule to\n68|// third-party registered IDs, which Section 6.5 admits as valid.\n69|func TestDecodeRefusesNonConptyBackendOnNativeWindows(t *testing.T) {\n70|\tt.Parallel()\n71|\n72|\ttmux := append(minimalValidConfigVersion(scalar.PlatformWindows, Version1), []byte(\"\\n[terminal]\\nbackend = \\\"tmux\\\"\\n\")...)\n73|\tif _, err := Decode(tmux, DecodeContext{RuntimePlatform: scalar.PlatformWindows}); err == nil {\n74|\t\tt.Fatal(\"Decode(v1 backend=tmux on Windows) error = nil, want refusal\")\n75|\t} else if !errors.Is(err, ErrConfigValidation) {\n76|\t\tt.Fatalf(\"Decode(v1 backend=tmux on Windows) error = %v, want ErrConfigValidation\", err)\n77|\t}\n78|\n79|\tconpty := append(minimalValidConfigVersion(scalar.PlatformWindows, Version1), []byte(\"\\n[terminal]\\nbackend = \\\"conpty\\\"\\n\")...)\n80|\tloaded, err := Decode(conpty, DecodeContext{RuntimePlatform: scalar.PlatformWindows})\n81|\tif err != nil {\n82|\t\tt.Fatalf(\"Decode(v1 backend=conpty on Windows) error = %v\", err)\n83|\t}\n84|\tif loaded.Value.Terminal.BackendID != \"ax.conpty\" {\n85|\t\tt.Fatalf(\"migrated terminal backend = %q, want ax.conpty\", loaded.Value.Terminal.BackendID)\n86|\t}\n87|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
