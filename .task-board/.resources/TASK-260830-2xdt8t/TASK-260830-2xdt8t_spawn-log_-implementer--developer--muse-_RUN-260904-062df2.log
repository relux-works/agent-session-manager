{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9cb","stream":{"kind":"session","id":"01a06e75-bbc6-7500-a9cb-f70149b63e89"},"sequence":832,"recorded_at":1780531400001659,"record_type":"event","durability":"durable","causation_id":"4e2efeb9-af88-4b92-82e3-c4ef7a43be2c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4e2efeb9-af88-4b92-82e3-c4ef7a43be2c","run_stream":{"kind":"run","id":"4e2efeb9-af88-4b92-82e3-c4ef7a43be2c"},"task_stream":{"kind":"task","id":"a6d7a7ab-7625-4081-9bfd-a01373ebaa9e"},"task_id":"a6d7a7ab-7625-4081-9bfd-a01373ebaa9e","event":{"kind":"output","task_id":"a6d7a7ab-7625-4081-9bfd-a01373ebaa9e","chunk":"edited\nchanged lines: lines 644-684\n--- original\n+++ updated\n@@\n-// TestCheckProviderDescriptorGenerationBounds proves the 1..256 bound in both\n-// directions against the number the specification declares: 256 accepted, 0\n-// and 257 refused, on either side of the comparison.\n-func TestCheckProviderDescriptorGenerationBounds(t *testing.T) {\n-\tt.Parallel()\n-\n-\tatLimit := strings.Repeat(\"g\", 256)\n-\toverLimit := strings.Repeat(\"g\", 257)\n-\tbase := terminalbackend.InstanceBinding{\n-\t\tBackendID:             \"com.example.term\",\n-\t\tImplementationVersion: \"1.2.3\",\n-\t\tProtocolVersion:       \"1.0.0\",\n-\t\tGeneration:            atLimit,\n-\t}\n-\tif err := terminalbackend.CheckProviderDescriptor(base, base); err != nil {\n-\t\tt.Errorf(\"CheckProviderDescriptor(256-byte generation) error = %v, want admission\", err)\n-\t}\n-\tmutate := func(binding terminalbackend.InstanceBinding, mutate func(*terminalbackend.InstanceBinding)) terminalbackend.InstanceBinding {\n-\t\tmutate(&binding)\n-\t\treturn binding\n-\t}\n-\trefused := []struct {\n-\t\tname       string\n-\t\tdescriptor terminalbackend.InstanceBinding\n-\t\tbinding    terminalbackend.InstanceBinding\n-\t}{\n-\t\t{\"empty descriptor generation\", mutate(base, func(b *terminalbackend.InstanceBinding) { b.Generation = \"\" }), base},\n-\t\t{\"257-byte descriptor generation\", mutate(base, func(b *terminalbackend.InstanceBinding) { b.Generation = overLimit }), base},\n-\t\t{\"empty binding generation\", base, mutate(base, func(b *terminalbackend.InstanceBinding) { b.Generation = \"\" })},\n-\t\t{\"257-byte binding generation\", base, mutate(base, func(b *terminalbackend.InstanceBinding) { b.Generation = overLimit })},\n-\t}\n-\tfor _, testCase := range refused {\n-\t\tt.Run(testCase.name, func(t *testing.T) {\n-\t\t\tt.Parallel()\n-\t\t\terr := terminalbackend.CheckProviderDescriptor(testCase.descriptor, testCase.binding)\n-\t\t\tif !terminalbackend.IsStaleGeneration(err) {\n-\t\t\t\tt.Errorf(\"CheckProviderDescriptor() error = %v, want terminal_backend_stale_generation\", err)\n-\t\t\t}\n-\t\t})\n-\t}\n-}\n+// TestCheckProviderDescriptorGenerationBounds proves the Section 7.A\n+// string[1..256] bound itself, not the generation mismatch: every refusal\n+// case carries the SAME generation on both sides, so the mismatch comparison\n+// cannot fire and only the bound can refuse. (Pitting a mutated generation\n+// against a fixed one proves nothing about the bound — the inequality alone\n+// returns terminal_backend_stale_generation.)\n+func TestCheckProviderDescriptorGenerationBounds(t *testing.T) {\n+\tt.Parallel()\n+\n+\twithGeneration := func(generation string) terminalbackend.InstanceBinding {\n+\t\treturn terminalbackend.InstanceBinding{\n+\t\t\tBackendID:             \"com.example.term\",\n+\t\t\tImplementationVersion: \"1.2.3\",\n+\t\t\tProtocolVersion:       \"1.0.0\",\n+\t\t\tGeneration:            generation,\n+\t\t}\n+\t}\n+\tadmitted := []struct {\n+\t\tname       string\n+\t\tgeneration string\n+\t}{\n+\t\t{\"one byte\", \"g\"},\n+\t\t{\"256 bytes\", strings.Repeat(\"g\", 256)},\n+\t}\n+\tfor _, testCase := range admitted {\n+\t\tt.Run(testCase.name, func(t *testing.T) {\n+\t\t\tt.Parallel()\n+\t\t\tbinding := withGeneration(testCase.generation)\n+\t\t\tif err := terminalbackend.CheckProviderDescriptor(binding, binding); err != nil {\n+\t\t\t\tt.Errorf(\"CheckProviderDescriptor(%d-byte generation, equal) error = %v, want admission\",\n+\t\t\t\t\tlen(testCase.generation), err)\n+\t\t\t}\n+\t\t})\n+\t}\n+\trefused := []struct {\n+\t\tname       string\n+\t\tgeneration string\n+\t}{\n+\t\t{\"empty\", \"\"},\n+\t\t{\"257 bytes\", strings.Repeat(\"g\", 257)},\n+\t}\n+\tfor _, testCase := range refused {\n+\t\tt.Run(testCase.name, func(t *testing.T) {\n+\t\t\tt.Parallel()\n+\t\t\tbinding := withGeneration(testCase.generation)\n+\t\t\terr := terminalbackend.CheckProviderDescriptor(binding, binding)\n+\t\t\tif !terminalbackend.IsStaleGeneration(err) {\n+\t\t\t\tt.Errorf(\"CheckProviderDescriptor(%d-byte generation, equal) error = %v, want terminal_backend_stale_generation\",\n+\t\t\t\t\tlen(testCase.generation), err)\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n+\n+// TestCheckProviderDescriptorGenerationMismatch keeps the mismatch arm pinned\n+// separately: differing valid generations refuse even though each side is\n+// within the bound.\n+func TestCheckProviderDescriptorGenerationMismatch(t *testing.T) {\n+\tt.Parallel()\n+\n+\tbinding := terminalbackend.InstanceBinding{\n+\t\tBackendID:             \"com.example.term\",\n+\t\tImplementationVersion: \"1.2.3\",\n+\t\tProtocolVersion:       \"1.0.0\",\n+\t\tGeneration:            \"generation-1\",\n+\t}\n+\tstale := binding\n+\tstale.Generation = \"generation-2\"\n+\tif err := terminalbackend.CheckProviderDescriptor(stale, binding); !terminalbackend.IsStaleGeneration(err) {\n+\t\tt.Errorf(\"CheckProviderDescriptor(stale generation) error = %v, want terminal_backend_stale_generation\", err)\n+\t}\n+}\n"}}}
