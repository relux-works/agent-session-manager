invalid; 256 is accepted.\n526|func CheckProviderDescriptor(descriptor, binding InstanceBinding) error {\n527|\tif err := checkGeneration(descriptor.Generation); err != nil {\n528|\t\treturn err\n529|\t}\n530|\tif err := checkGeneration(binding.Generation); err != nil {\n531|\t\treturn err\n532|\t}\n533|\tif _, err := ParseID(descriptor.BackendID); err != nil {\n534|\t\treturn err\n535|\t}\n536|\tif descriptor.BackendID != binding.BackendID {\n537|\t\treturn &Error{Code: CodeNotFound, BackendID: descriptor.BackendID, Detail: \"descriptor backend binding\"}\n538|\t}\n539|\tif descriptor.ImplementationVersion != binding.ImplementationVersion ||\n540|\t\tdescriptor.ProtocolVersion != binding.ProtocolVersion {\n541|\t\treturn &Error{Code: CodeDrift, BackendID: descriptor.BackendID, Detail: \"descriptor version binding\"}\n542|\t}\n543|\tif descriptor.Generation != binding.Generation {\n544|\t\treturn &Error{Code: CodeStaleGeneration, BackendID: descriptor.BackendID, Detail: \"descriptor generation binding\"}\n545|\t}\n546|\treturn nil\n547|}\n548|\n549|// checkGeneration enforces string[1..256] measured in bytes over valid UTF-8.\n550|func checkGeneration(generation string) error {\n551|\tif !utf8.ValidString(generation) || len(generation) < 1 || len(generation) > maxGenerationBytes {\n552|\t\treturn &Error{Code: CodeStaleGeneration, Detail: \"backend_generation bound\"}\n553|\t}\n554|\treturn nil\n555|}\n556|\n557|// DigestFile returns the sha256: digest of the executable at path after\n558|// resolving symlinks. The target must be a regular file; anything else (or a\n559|// read failure) is an error, never a digest. It distinguishes a failed read\n560|// from an absent trust entry: callers must not fall back to PATH discovery.\n561|func DigestFile(path string) (string, error) {\n562|\tresolved, err := filepath.EvalSymlinks(path)\n563|\tif err != nil {\n564|\t\treturn \"\", fmt.Errorf(\"terminal backend executable: %w\", err)\n565|\t}\n566|\tinfo, err := os.Stat(resolved)\n567|\tif err != nil {\n568|\t\treturn \"\", fmt.Errorf(\"terminal backend executable: %w\", err)\n569|\t}\n570|\tif !info.Mode().IsRegular() {\n571|\t\treturn \"\", fmt.Errorf(\"terminal backend executable %s: not a regular file\", resolved)\n572|\t}\n573|\traw, err := os.ReadFile(resolved)\n574|\tif err != nil {\n575|\t\treturn \"\", fmt.Errorf(\"terminal backend executable: %w\", err)\n576|\t}\n577|\tsum := sha256.Sum256(raw)\n578|\treturn \"sha256:\" + hex.EncodeToString(sum[:]), nil\n579|}"}}}
