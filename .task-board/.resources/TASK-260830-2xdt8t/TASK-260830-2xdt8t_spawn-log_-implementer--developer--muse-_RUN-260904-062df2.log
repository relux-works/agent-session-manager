guration uses Linux paths and <code>platform = \\\\\\\"wsl2\\\\\\\"</code>.\\\",\\n          \\\"acceptance_cases\\\": [\\n            \\\"config-versioned-readers\\\"\\n          ]\\n        }\\n      ]\\n    },\\n    {\\n      \\\"kind\\\": \\\"section_binding\\\",\\n      \\\"keys\\\": [\\n        \\\"section:6.3\\\"\\n      ],\\n      \\\"production\\\": {\\n        \\\"path\\\": \\\"internal/config/validation.go\\\",\\n        \\\"declaration\\\": \\\"validateConfiguration\\\"\\n      },\\n      \\\"acceptance_cases\\\": [\\n        \\\"config-versioned-readers\\\",\\n        \\\"config-current-writer\\\"\\n      ],\\n      \\\"coverage\\\": \\\"unevidenced\\\",\\n      \\\"gap\\\": \\\"validateConfiguration enforces many Section 6.3 field constraints, but no clause of Section 6.3 is enumerated against an acceptance case, so the registry makes no clause-level claim about its obligations.\\\"\\n    },\\n    {\\n      \\\"kind\\\": \\\"section_binding\\\",\\n      \\\"keys\\\": [\\n        \\\"section:6.4\\\"\\n      ],\\n      \\\"production\\\": {\\n        \\\"path\\\": \\\"internal/config/migration.go\\\",\\n        \\\"declaration\\\": \\\"Migrate\\\"\\n      },\\n      \\\"acceptance_cases\\\": [\\n        \\\"config-versioned-readers\\\",\\n        \\\"config-durable-migration\\\",\\n        \\\"config-durable-migration-os-entry\\\"\\n      ],\\n      \\\"coverage\\\": \\\"unevidenced\\\",\\n      \\\"gap\\\": \\\"Migrate writes the Section 6.4 durable migration with an owner-only backup and atomic replacement, but no clause of Section 6.4 is enumerated against an acceptance case.\\\"\\n    },\\n    {\\n      \\\"kind\\\": \\\"section_binding\\\",\\n      \\\"keys\\\": [\\n        \\\"section:6.5\\\"\\n      ],\\n      \\\"production\\\": {\\n\",\n  \"original_output_bytes\": 2261,\n  \"original_output_tokens\": 566,\n  \"truncated\": false\n}"}}}
