rrConfigValidation)\n663|\t}\n664|\tif !between(terminal.GracefulStopTimeoutSeconds, 1, 600) {\n665|\t\treturn configError(\"terminal.graceful_stop_timeout_seconds\", ErrConfigValidation)\n666|\t}\n667|\tif err := validateSortedUniqueClosed(terminal.RequiredCapabilities, terminalCapabilitySet); err != nil {\n668|\t\treturn configError(\"terminal.required_capabilities\", err)\n669|\t}\n670|\tif !terminal.RequiredCapabilitiesExplicit && len(terminal.RequiredCapabilities) != 0 {\n671|\t\treturn configError(\"terminal.required_capabilities default provenance\", ErrConfigValidation)\n672|\t}\n673|\tif !oneOf(terminal.MultipleInputPolicy, \"deny\", \"explicit_allow\") {\n674|\t\treturn configError(\"terminal.multiple_input_policy\", ErrConfigValidation)\n675|\t}\n676|\tif err := validateSortedUniqueClosed(terminal.TransportPolicy, map[string]struct{}{\"local_only\": {}, \"trusted_private_mesh\": {}}); err != nil {\n677|\t\treturn configError(\"terminal.transport_policy\", err)\n678|\t}\n679|\tif !terminal.TransportPolicyExplicit && !equalStrings(terminal.TransportPolicy, []string{\"local_only\", \"trusted_private_mesh\"}) {\n680|\t\treturn configError(\"terminal.transport_policy default provenance\", ErrConfigValidation)\n681|\t}\n682|\tif terminal.BackendID == \"ax.tmux\" && configuration.Platform == scalar.PlatformWindows {\n683|\t\treturn configError(\"terminal.backend_id unsupported platform\", ErrConfigValidation)\n684|\t}\n685|\tif terminal.BackendID == \"ax.conpty\" && configuration.Platform != scalar.PlatformWindows {\n686|\t\treturn configError(\"terminal.backend_id unsupported platform\", ErrConfigValidation)\n687|\t}\n688|\tregistered := map[string]struct{}{\"ax.tmux\": {}, \"ax.conpty\": {}}\n689|\ttrustIDs := map[string]struct{}{}\n690|\tfor index, entry := range terminal.ExternalTrust {\n691|\t\tprefix := fmt.Sprintf(\"terminal.external_trust[%d]\", index)\n692|\t\tif !terminalBackendIDPattern.MatchString(entry.BackendID) || len(entry.BackendID) > 128 {\n693|\t\t\treturn configError(prefix+\".backend_id\", ErrConfigValidation)\n694|\t\t}\n695|\t\tif _, exists := trustIDs[entry.BackendID]; exists {\n696|\t\t\treturn configError(\"terminal.external_trust duplicate backend_id\", ErrConfigValidation)\n697|\t\t}\n698|\t\ttrustIDs[entry.BackendID] = struct{}{}\n699|\t\tif entry.Enabled {\n700|\t\t\tregistered[entry.BackendID] = struct{}{}\n701|\t\t}\n702|\t\tif _, err := scalar.ParseAbsolutePath(configuration.Platform, entry.ExecutablePath); err != nil {\n703|\t\t\treturn configError(prefix+\".executable_path\", errors.Join(ErrConfigValidation, err))\n704|\t\t}\n705|\t\tif _, err := scalar.ParseDigest(entry.ExecutableDigest); err != nil {\n706|\t\t\treturn configError(prefix+\".executable_digest\", errors.Join(ErrConfigValidation, err))\n707|\t\t}\n708|\t}\n709|\tif _, ok := registered[terminal.BackendID]; !ok {\n710|\t\treturn configError(\"terminal.backend_id is not registered\", ErrConfigValidation)\n711|\t}\n712|\tconfigIDs := map[string]struct{}{}\n713|\tfor index, entry := range terminal.BackendConfig {\n714|\t\tprefix := fmt.Sprintf(\"terminal.backend_config[%d]\", index)\n715|\t\tif _, ok := registered[entry.BackendID]; !ok {\n716|\t\t\treturn configError(prefix+\".backend_id is not registered\", ErrConfigValidation)\n717|\t\t}\n718|\t\tif _, exists := configIDs[entry.BackendID]; exists {\n719|\t\t\treturn configError(\"terminal.backend_config duplicate backend_id\", ErrConfigValidation)\n720|\t\t}\n721|\t\tconfigIDs[entry.BackendID] = struct{}{}\n722|\t\tif !semverPattern.MatchString(entry.ConfigVersion) {\n723|\t\t\treturn configError(prefix+\".config_version\", ErrConfigValidation)\n724|\t\t}\n725|\t\tif entry.Settings == nil {\n726|\t\t\treturn configError(prefix+\".settings\", ErrConfigValidation)\n727|\t\t}\n728|\t\tif context.BackendSettings == nil {\n729|\t\t\treturn configError(prefix+\" has no registered settings schema\", ErrConfigValidation)\n730|\t\t}\n731|\t\tif err := context.BackendSettings.ValidateBackendSettings(entry.BackendID, entry.ConfigVersion, cloneAnyMap(entry.Settings)); err != nil {\n732|\t\t\treturn configError(prefix+\".settings\", errors.Join(ErrConfigValidation, err))\n733|\t\t}\n734|\t}\n735|\treturn nil\n736|}\n737|\n738|func validateExtensions(extensions map[string]any) error {\n739|\tif extensions == nil {\n740|\t\treturn ErrConfigValidation\n741|\t}\n742|\tif len(extensions) > 64 {\n743|\t\treturn ErrConfigValidation\n744|\t}\n745|\tfor key, value := range extensions {\n746|\t\t// SPEC.md:345-347 defines an extension key as exactly this grammar:\n747|\t\t// \"A reverse-DNS key is 3-253 lowercase ASCII characters, contains at\n748|\t\t// least one dot, and has dot-separated labels matching\n749|\t\t// [a-z][a-z0-9-]{0,62}\". It declares no reserved or forbidden label,\n750|\t\t// so no name is refused beyond that grammar and the byte bound.\n751|\t\t// reverseDNSPattern itself makes a.b the shortest accepted namespace,\n752|\t\t// so the three-byte minimum is structurally subsumed by that grammar.\n753|\t\tif len(key) > 253 || !reverseDNSPattern.MatchString(key) {\n754|\t\t\treturn ErrConfigValidation\n755|\t\t}\n756|\t\tif err := validateExtensionValue(value, 0); err != nil {\n757|\t\t\treturn err\n758|\t\t}\n759|\t}\n760|\t// The bound is on canonical bytes, so it is measured through the one shared\n761|\t// canonical measurement rather than through Go's HTML-escaped encoding. See\n762|\t// canonicaljson.CanonicalByteLength.\n763|\tcanonicalBytes, err := canonicaljson.CanonicalByteLength(extensions)\n764|\tif err != nil || canonicalBytes > maxConfigExtensionBytes {\n765|\t\treturn ErrConfigValidation\n766|\t}\n767|\treturn nil\n768|}\n769|\n770|func validateExtensionValue(value any, depth int) error {\n771|\tswitch typed := value.(type) {\n772|\tcase nil, bool, string:\n773|\t\treturn nil\n774|\tcase int64:\n775|\t\tif typed < -scalar.MaxSafeInteger || typed > scalar.MaxSafeInteger {\n776|\t\t\treturn ErrConfigValidation\n777|\t\t}\n778|\t\treturn nil\n779|\tcase uint64:\n780|\t\tif typed > scalar.MaxUint53 {\n781|\t\t\treturn ErrConfigValidation\n782|\t\t}\n783|\t\treturn nil\n784|\tcase float64, float32:\n785|\t\treturn ErrConfigValidation\n786|\tcase []any:\n787|\t\tif depth >= 4 {\n788|\t\t\treturn ErrConfigValidation\n789|\t\t}\n790|\t\tfor _, item := range typed {\n791|\t\t\tif err := validateExtensionValue(item, depth+1); err != nil {\n792|\t\t\t\treturn err\n793|\t\t\t}\n794|\t\t}\n795|\t\treturn nil\n796|\tcase map[string]any:\n797|\t\tif depth >= 4 {\n798|\t\t\treturn ErrConfigValidation\n799|\t\t}\n800|\t\t// SPEC.md:347-349 constrains an ExtensionValue object only as\n801|\t\t// \"string-keyed object with maximum nesting depth 4\". The pinned spec\n802|\t\t// imposes no naming rule inside an extension value, so nested keys are\n803|\t\t// admitted as data and only the depth bound is enforced here.\n804|\t\tfor _, item := range typed {\n805|\t\t\tif err := validateExtensionValue(item, depth+1); err != nil {\n806|\t\t\t\treturn err\n807|\t\t\t}\n808|\t\t}\n809|\t\treturn nil\n810|\tdefault:\n811|\t\treturn ErrConfigValidation\n812|\t}\n813|}\n814|\n815|func validateSortedUniqueDigests(values []string, min, max int) error {\n816|\tif len(values) < min || len(values) > max {\n817|\t\treturn ErrConfigValidation\n818|\t}\n819|\tfor index, value := range values {\n820|\t\tif _, err := scalar.ParseDigest(value); err != nil {\n821|\t\t\treturn errors.Join(ErrConfigValidation, err)\n822|\t\t}\n823|\t\tif index > 0 && values[index-1] >= value {\n824|\t\t\treturn ErrConfigValidation\n825|\t\t}\n826|\t}\n827|\treturn nil\n828|}\n829|\n830|func validateSortedUniqueClosed(values []string, allowed map[string]struct{}) error {\n831|\tfor index, value := range values {\n832|\t\tif _, ok := allowed[value]; !ok {\n833|\t\t\treturn ErrConfigValidation\n834|\t\t}\n835|\t\tif index > 0 && values[index-1] >= value {\n836|\t\t\treturn ErrConfigValidation\n837|\t\t}\n838|\t}\n839|\treturn nil\n840|}\n841|\n842|func validatePrintableCharacters(value string, min, max int) error {\n843|\tif !utf8.ValidString(value) {\n844|\t\treturn ErrConfigValidation\n845|\t}\n846|\tcount := utf8.RuneCountInString(value)\n847|\tif count < min || count > max {\n848|\t\treturn ErrConfigValidation\n849|\t}\n850|\tfor _, character := range value {\n851|\t\tif unicode.IsControl(character) || !unicode.IsPrint(character) {\n852|\t\t\treturn ErrConfigValidation\n853|\t\t}\n854|\t}\n855|\treturn nil\n856|}\n857|\n858|func metadataPolicy(value string) bool {\n859|\treturn oneOf(value, \"local_only\", \"mesh_sanitized\", \"reference_only\")\n860|}\n861|func oneOf(value string, allowed ...string) bool {\n862|\tfor _, candidate := range allowed {\n863|\t\tif value == candidate {\n864|\t\t\treturn true\n865|\t\t}\n866|\t}\n867|\treturn false\n868|}\n869|func between(value, min, max uint64) bool { return value >= min && value <= max }\n870|func legacyBackendDefault(platform scalar.Platform) string {\n871|\tif platform == scalar.PlatformWindows {\n872|\t\treturn \"conpty\"\n873|\t}\n874|\treturn \"tmux\"\n875|}\n876|func currentBackendDefault(platform scalar.Platform) string {\n877|\tif platform == scalar.PlatformWindows {\n878|\t\treturn \"ax.conpty\"\n879|\t}\n880|\treturn \"ax.tmux\"\n881|}\n882|func valueOr[T any](value *T, fallback T) T {\n883|\tif value == nil {\n884|\t\treturn fallback\n885|\t}\n886|\treturn *value\n887|}\n888|func cloneStrings(values []string) []string { return append([]string(nil), values...) }\n889|\n890|func equalStrings(left, right []string) bool {\n891|\tif len(left) != len(right) {\n892|\t\treturn false\n893|\t}\n894|\tfor index := range left {\n895|\t\tif left[index] != right[index] {\n896|\t\t\treturn false\n897|\t\t}\n898|\t}\n899|\treturn true\n900|}\n901|\n902|func cloneAnyMap(value map[string]any) map[string]any {\n903|\tif value == nil {\n904|\t\treturn nil\n905|\t}\n906|\tcloned := make(map[string]any, len(value))\n907|\tfor key, item := range value {\n908|\t\tcloned[key] = cloneAny(item)\n909|\t}\n910|\treturn cloned\n911|}\n912|\n913|func cloneAny(value any) any {\n914|\tswitch typed := value.(type) {\n915|\tcase map[string]any:\n916|\t\treturn cloneAnyMap(typed)\n917|\tcase []any:\n918|\t\tcloned := make([]any, len(typed))\n919|\t\tfor index, item := range typed {\n920|\t\t\tcloned[index] = cloneAny(item)\n921|\t\t}\n922|\t\treturn cloned\n923|\tcase []string:\n924|\t\treturn cloneStrings(typed)\n925|\tdefault:\n926|\t\treturn typed\n927|\t}\n928|}\n929|\n930|func cloneConfiguration(value Configuration) Configuration {\n931|\tcloned := value\n932|\tcloned.WorkspaceRoots = append([]WorkspaceRoot(nil), value.WorkspaceRoots...)\n933|\tcloned.Providers.PluginDirs = cloneStrings(value.Providers.PluginDirs)\n934|\tcloned.Mesh.Peers = make([]Peer, len(value.Mesh.Peers))\n935|\tfor index, peer := range value.Mesh.Peers {\n936|\t\tcloned.Mesh.Peers[index] = peer\n937|\t\tcloned.Mesh.Peers[index].SSHArgs = cloneStrings(peer.SSHArgs)\n938|\t\tcloned.Mesh.Peers[index].WorkspaceRoots = append([]WorkspaceRoot(nil), peer.WorkspaceRoots...)\n939|\t}\n(more lines below)"}}}
