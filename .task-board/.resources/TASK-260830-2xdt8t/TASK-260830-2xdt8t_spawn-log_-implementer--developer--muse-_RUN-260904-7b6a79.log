{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c427","stream":{"kind":"session","id":"01a06e93-d53a-7932-a386-31af1b4e3b11"},"sequence":110,"recorded_at":1780531400000215,"record_type":"event","durability":"durable","causation_id":"f7bd976d-81ef-4282-860e-ea272a043469","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f7bd976d-81ef-4282-860e-ea272a043469","run_stream":{"kind":"run","id":"f7bd976d-81ef-4282-860e-ea272a043469"},"task_stream":{"kind":"task","id":"7212f4fc-931b-4cc1-ab3d-c661e81eb75f"},"task_id":"7212f4fc-931b-4cc1-ab3d-c661e81eb75f","event":{"kind":"output","task_id":"7212f4fc-931b-4cc1-ab3d-c661e81eb75f","chunk":"Read text file `internal/terminalbackend/terminalbackend.go`.\n1|// Package terminalbackend implements the TerminalBackend registry: canonical\n2|// backend identities, implementation/protocol version tuples, external\n3|// executable trust admission, and duplicate or drift refusal.\n4|//\n5|// Normative scope is relux-works/agent-session-manager-spec@v0.5.0 §4.B\n6|// (registry, identity, discovery, trust), §4.1 (backend interface versions),\n7|// §6.5 (Configuration 3.0.0 TerminalBackend extension), and §7.A (Provider\n8|// Protocol 3.0.0 Terminal Instance binding). Manifest/Probe schemas,\n9|// capability evidence, lifecycle operations, and legacy v0.4.3 translation\n10|// belong to the sibling story tasks and are deliberately not defined here.\n11|package terminalbackend\n12|\n13|import (\n14|\t\"crypto/sha256\"\n15|\t\"encoding/hex\"\n16|\t\"errors\"\n17|\t\"fmt\"\n18|\t\"os\"\n19|\t\"path/filepath\"\n20|\t\"regexp\"\n21|\t\"sort\"\n22|\t\"strings\"\n23|\t\"sync\"\n24|\t\"unicode/utf8\"\n25|\n26|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n27|)\n28|\n29|// Wire error codes are the exact Section 15.3 codes the registry may report.\n30|// They are a subset of the pinned catalog error vocabulary; no other code is\n31|// emitted by this package.\n32|const (\n33|\t// CodeNotFound reports an unknown or malformed backend identity. A failed\n34|\t// read is never absence: callers must not treat this as \"no backend\".\n35|\tCodeNotFound = \"terminal_backend_not_found\"\n36|\t// CodeAmbiguous reports a duplicate or ambiguous backend ID. Re-registering\n37|\t// an identical record is still refused: identity registration is not\n38|\t// idempotent.\n39|\tCodeAmbiguous = \"terminal_backend_ambiguous\"\n40|\t// CodeUntrusted reports a disabled, unresolvable, or digest-mismatched\n41|\t// external executable. Trust is established before any probe.\n42|\tCodeUntrusted = \"terminal_backend_untrusted\"\n43|\t// CodeDrift reports a re-registration whose version tuple, kind,\n44|\t// platforms, or executable digest differs from the admitted record.\n45|\tCodeDrift = \"terminal_backend_implementation_drift\"\n46|\t// CodeRestoreMismatch reports an attempt to substitute the configured\n47|\t// default for the exact prior binding on restore or resume.\n48|\tCodeRestoreMismatch = \"terminal_backend_restore_mismatch\"\n49|\t// CodeStaleGeneration reports a generation that is out of bound or does\n50|\t// not match the validated binding.\n51|\tCodeStaleGeneration = \"terminal_backend_stale_generation\"\n52|)\n53|\n54|// Canonical built-in backend identities. The ax. namespace is reserved (§4.B);\n55|// no third-party registration may use it.\n56|const (\n57|\tBuiltinTmux   = \"ax.tmux\"\n58|\tBuiltinConpty = \"ax.conpty\"\n59|)\n60|\n61|// reservedNamespace is the only namespace this implementation may mint.\n62|const reservedNamespace = \"ax.\"\n63|\n64|// maxIDBytes is the Section 4.B bound: 1-128 ASCII bytes.\n65|const maxIDBytes = 128\n66|\n67|// maxGenerationBytes is the Section 4.B/7.A bound: string[1..256].\n68|const maxGenerationBytes = 256\n69|\n70|// maxProtocolVersions is the Section 4.B bound: sorted unique semver[1..32].\n71|const maxProtocolVersions = 32\n72|\n73|var (\n74|\tidPattern = regexp.MustCompile(`^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$`)\n75|\t// semverPattern implements Semantic Versioning 2.0.0 in full, matching the\n76|\t// grammar the canonical and config packages enforce for the same members.\n77|\tsemverPattern = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n78|)\n79|\n80|// Error is a registry refusal. Code is always one of the Code* constants;\n81|// BackendID names the identity at issue when there is one. Detail is a static\n82|// clause: it never echoes paths, digests, generations, or other local data.\n83|type Error struct {\n84|\tCode      string\n85|\tBackendID string\n86|\tDetail    string\n87|}\n88|\n89|func (err *Error) Error() string {\n90|\tif err.BackendID == \"\" {\n91|\t\treturn \"terminal backend refused: \" + err.Code + \" at \" + err.Detail\n92|\t}\n93|\treturn \"terminal backend refused: \" + err.Code + \" for \" + err.BackendID + \" at \" + err.Detail\n94|}\n95|\n96|// errorCode reports whether err carries the given wire code.\n97|func errorCode(err error, code string) bool {\n98|\tvar refusal *Error\n99|\tif !errors.As(err, &refusal) {\n100|\t\treturn false\n101|\t}\n102|\treturn refusal.Code == code\n103|}\n104|\n105|// IsNotFound reports CodeNotFound refusals.\n106|func IsNotFound(err error) bool { return errorCode(err, CodeNotFound) }\n107|\n108|// IsAmbiguous reports CodeAmbiguous refusals.\n109|func IsAmbiguous(err error) bool { return errorCode(err, CodeAmbiguous) }\n110|\n111|// IsUntrusted reports CodeUntrusted refusals.\n112|func IsUntrusted(err error) bool { return errorCode(err, CodeUntrusted) }\n113|\n114|// IsDrift reports CodeDrift refusals.\n115|func IsDrift(err error) bool { return errorCode(err, CodeDrift) }\n116|\n117|// IsRestoreMismatch reports CodeRestoreMismatch refusals.\n118|func IsRestoreMismatch(err error) bool { return errorCode(err, CodeRestoreMismatch) }\n119|\n120|// IsStaleGeneration reports CodeStaleGeneration refusals.\n121|func IsStaleGeneration(err error) bool { return errorCode(err, CodeStaleGeneration) }\n122|\n123|// ParseID validates a canonical terminal backend identity: 1-128 ASCII bytes\n124|// matching [a-z][a-z0-9]*(?:[.-][a-z0-9]+)*. It admits the reserved ax.\n125|// namespace only for the two canonical built-ins; every other ax.-prefixed ID\n126|// is refused so a third party cannot mint a trusted-looking identity.\n127|func ParseID(value string) (string, error) {\n128|\tif !utf8.ValidString(value) || len(value) < 1 || len(value) > maxIDBytes {\n129|\t\treturn \"\", &Error{Code: CodeNotFound, Detail: \"terminal_backend_id bound\"}\n130|\t}\n131|\tif !idPattern.MatchString(value) {\n132|\t\treturn \"\", &Error{Code: CodeNotFound, BackendID: value, Detail: \"terminal_backend_id grammar\"}\n133|\t}\n134|\tif strings.HasPrefix(value, reservedNamespace) && value != BuiltinTmux && value != BuiltinConpty {\n135|\t\treturn \"\", &Error{Code: CodeNotFound, BackendID: value, Detail: \"terminal_backend_id reserved namespace\"}\n136|\t}\n137|\treturn value, nil\n138|}\n139|\n140|// mustParseID is the internal admission used where the caller already holds a\n141|// validated record. It duplicates the ParseID rule so a Registry can never\n142|// hold an identity its own grammar refuses.\n143|func mustParseID(value string) error {\n144|\t_, err := ParseID(value)\n145|\treturn err\n146|}\n147|\n148|// Kind is the Section 4.B implementation_kind vocabulary.\n149|type Kind string\n150|\n151|// Implementation kinds. Built-ins run inside the ax binary; externals arrive\n152|// as adapter executables over the Section 4.B argv/framing wire.\n153|const (\n154|\tKindBuiltinGo         Kind = \"builtin_go\"\n155|\tKindLocalProgram      Kind = \"local_program\"\n156|\tKindTrustedExecutable Kind = \"trusted_executable\"\n157|\tKindNativeRuntime     Kind = \"native_runtime\"\n158|)\n159|\n160|// parseKind admits exactly the closed Section 4.B vocabulary.\n161|func parseKind(value string) (Kind, error) {\n162|\tswitch Kind(value) {\n163|\tcase KindBuiltinGo, KindLocalProgram, KindTrustedExecutable, KindNativeRuntime:\n164|\t\treturn Kind(value), nil\n165|\tdefault:\n166|\t\treturn \"\", &Error{Code: CodeNotFound, Detail: \"implementation_kind vocabulary\"}\n167|\t}\n168|}\n169|\n170|// needsDigest reports whether the kind carries an executable digest. Section\n171|// 4.B: digest for local_program or trusted_executable; null otherwise.\n172|func needsDigest(kind Kind) bool {\n173|\treturn kind == KindLocalProgram || kind == KindTrustedExecutable\n174|}\n175|\n176|// Registration is one admitted backend identity with its exact version tuple,\n177|// platform set, and trust binding. It is the registry half of the Section 4.B\n178|// Manifest identity: the Manifest/Probe objects themselves belong to the\n179|// sibling manifest task.\n180|type Registration struct {\n181|\t// ID is the canonical terminal_backend_id.\n182|\tID string\n183|\t// Kind is the closed implementation_kind.\n184|\tKind Kind\n185|\t// ImplementationVersion is the exact admitted semver.\n186|\tImplementationVersion string\n187|\t// ProtocolVersions are the sorted unique semver members in Terminal\n188|\t// Backend Protocol major 1.\n189|\tProtocolVersions []string\n190|\t// Platforms is the sorted unique non-empty platform subset.\n191|\tPlatforms []scalar.Platform\n192|\t// ExecutableDigest is the sha256: digest for external kinds and empty\n193|\t// (null) for built-in kinds.\n194|\tExecutableDigest string\n195|}\n196|\n197|// validate enforces every closed Section 4.B/6.5 rule on one record.\n198|func (record Registration) validate() error {\n199|\tif err := mustParseID(record.ID); err != nil {\n200|\t\treturn err\n201|\t}\n202|\tif _, err := parseKind(string(record.Kind)); err != nil {\n203|\t\treturn err\n204|\t}\n205|\tif !semverPattern.MatchString(record.ImplementationVersion) {\n206|\t\treturn &Error{Code: CodeDrift, BackendID: record.ID, Detail: \"implementation_version semver\"}\n207|\t}\n208|\tif err := validateProtocolVersions(record.ID, record.ProtocolVersions); err != nil {\n209|\t\treturn err\n210|\t}\n211|\tif err := validatePlatforms(record.Platforms); err != nil {\n212|\t\treturn &Error{Code: CodeNotFound, BackendID: record.ID, Detail: err.Error()}\n213|\t}\n214|\tif needsDigest(record.Kind) {\n215|\t\tif _, err := scalar.ParseDigest(record.ExecutableDigest); err != nil {\n216|\t\t\treturn &Error{Code: CodeUntrusted, BackendID: record.ID, Detail: \"executable_digest\"}\n217|\t\t}\n218|\t} else if record.ExecutableDigest != \"\" {\n219|\t\treturn &Error{Code: CodeDrift, BackendID: record.ID, Detail: \"executable_digest must be null\"}\n220|\t}\n221|\treturn nil\n222|}\n223|\n224|// validateProtocolVersions enforces sorted unique semver[1..32], each in\n225|// Terminal Backend Protocol major 1.\n226|func validateProtocolVersions(backendID string, versions []string) error {\n227|\tif len(versions) < 1 || len(versions) > maxProtocolVersions {\n228|\t\treturn &Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_versions bound\"}\n229|\t}\n230|\tfor index, version := range versions {\n231|\t\tif !semverPattern.MatchString(version) || semverMajor(version) != 1 {\n232|\t\t\treturn &Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_versions major 1\"}\n233|\t\t}\n234|\t\tif index > 0 && versions[index-1] >= version {\n235|\t\t\treturn &Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_versions sorted unique\"}\n236|\t\t}\n237|\t}\n238|\treturn nil\n239|}\n240|\n241|// semverMajor returns the major number of a validated semver string.\n242|func semverMajor(version string) int {\n243|\tmajor := 0\n244|\tfor i := 0; i < len(version); i++ {\n245|\t\tif version[i] == '.' {\n246|\t\t\tbreak\n247|\t\t}\n248|\t\tmajor = major*10 + int(version[i]-'0')\n249|\t}\n250|\treturn major\n251|}\n252|\n253|// validatePlatforms enforces a sorted unique non-empty subset of the closed\n254|// macos|linux|wsl2|windows vocabulary.\n255|func validatePlatforms(platforms []scalar.Platform) error {\n256|\tif len(platforms) == 0 || len(platforms) > 4 {\n257|\t\treturn errors.New(\"platforms bound\")\n258|\t}\n259|\tprevious := \"\"\n260|\tfor _, platform := range platforms {\n261|\t\tif _, err := scalar.ParsePlatform(platform.String()); err != nil {\n262|\t\t\treturn errors.New(\"platforms vocabulary\")\n263|\t\t}\n264|\t\tif previous >= platform.String() {\n265|\t\t\treturn errors.New(\"platforms sorted unique\")\n266|\t\t}\n267|\t\tprevious = platform.String()\n268|\t}\n269|\treturn nil\n270|}\n271|\n272|// cloneStrings deep-copies a version list so the registry never shares a\n273|// backing array with its caller. Registration carries slices; a struct copy\n274|// duplicates only the header, so every ingress and egress point must clone.\n275|func cloneStrings(values []string) []string {\n276|\tif values == nil {\n277|\t\treturn nil\n278|\t}\n279|\tcloned := make([]string, len(values))\n280|\tcopy(cloned, values)\n281|\treturn cloned\n282|}\n283|\n284|// clonePlatforms deep-copies a platform set for the same reason as\n285|// cloneStrings: without it a caller holding a resolved record keeps a live\n286|// handle on admitted registry state and can convert drift into a duplicate.\n287|func clonePlatforms(values []scalar.Platform) []scalar.Platform {\n288|\tif values == nil {\n289|\t\treturn nil\n290|\t}\n291|\tcloned := make([]scalar.Platform, len(values))\n292|\tcopy(cloned, values)\n293|\treturn cloned\n294|}\n295|\n296|// cloneRecord deep-copies every slice member of a record.\n297|func cloneRecord(record Registration) Registration {\n298|\trecord.ProtocolVersions = cloneStrings(record.ProtocolVersions)\n299|\trecord.Platforms = clonePlatforms(record.Platforms)\n300|\treturn record\n301|}\n302|\n303|// equalRecord reports whether two validated records are member-for-member\n304|// identical. Any difference is drift, never a compatible update.\n305|func equalRecord(left, right Registration) bool {\n306|\tif left.ID != right.ID || left.Kind != right.Kind ||\n307|\t\tleft.ImplementationVersion != right.ImplementationVersion ||\n308|\t\tleft.ExecutableDigest != right.ExecutableDigest {\n309|\t\treturn false\n310|\t}\n311|\tif len(left.ProtocolVersions) != len(right.ProtocolVersions) {\n312|\t\treturn false\n313|\t}\n314|\tfor i := range left.ProtocolVersions {\n315|\t\tif left.ProtocolVersions[i] != right.ProtocolVersions[i] {\n316|\t\t\treturn false\n317|\t\t}\n318|\t}\n319|\tif len(left.Platforms) != len(right.Platforms) {\n320|\t\treturn false\n321|\t}\n322|\tfor i := range left.Platforms {\n323|\t\tif left.Platforms[i] != right.Platforms[i] {\n324|\t\t\treturn false\n325|\t\t}\n326|\t}\n327|\treturn true\n328|}\n329|\n330|// TrustEntry is one Configuration 3.0.0 external_trust entry (§6.5): exactly a\n331|// backend ID, an absolute executable path, an executable digest, and enabled.\n332|type TrustEntry struct {\n333|\tBackendID        string\n334|\tExecutablePath   string\n335|\tExecutableDigest string\n336|\tEnabled          bool\n337|}\n338|\n339|// validateTrust enforces the Section 6.5 trust admission: grammar plus the\n340|// reserved-namespace bar (third parties use a vendor-owned namespace),\n341|// absolute path only (PATH-only discovery fails), and a well-formed digest.\n342|// A disabled entry is not an error here; registration treats it as untrusted.\n343|func (entry TrustEntry) validate(platform scalar.Platform) error {\n344|\tif err := mustParseID(entry.BackendID); err != nil {\n345|\t\treturn err\n346|\t}\n347|\tif strings.HasPrefix(entry.BackendID, reservedNamespace) {\n348|\t\treturn &Error{Code: CodeAmbiguous, BackendID: entry.BackendID, Detail: \"external_trust reserved namespace\"}\n349|\t}\n350|\tif _, err := scalar.ParseAbsolutePath(platform, entry.ExecutablePath); err != nil {\n351|\t\treturn &Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"external_trust executable_path\"}\n352|\t}\n353|\tif _, err := scalar.ParseDigest(entry.ExecutableDigest); err != nil {\n354|\t\treturn &Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"external_trust executable_digest\"}\n355|\t}\n356|\treturn nil\n357|}\n358|\n359|// Registry is the process-local TerminalBackend registry. It opens with the\n360|// two canonical built-ins admitted and accepts external adapters only through\n361|// RegisterExternal with a validated trust entry. The zero value is unusable;\n362|// construct with New.\n363|type Registry struct {\n364|\tmutex   sync.RWMutex\n365|\trecords map[string]Registration\n366|}\n367|\n368|// New admits the canonical built-ins ax.tmux (macos, linux, wsl2) and\n369|// ax.conpty (windows) at the given implementation version with the given\n370|// Terminal Backend Protocol versions. Both are builtin_go without an\n371|// executable digest. Unknown members or a non-major-1 protocol list fail\n372|// before either built-in is admitted.\n373|func New(implementationVersion string, protocolVersions []string) (*Registry, error) {\n374|\tif !semverPattern.MatchString(implementationVersion) {\n375|\t\treturn nil, &Error{Code: CodeDrift, Detail: \"implementation_version semver\"}\n376|\t}\n377|\tprotocols := append([]string(nil), protocolVersions...)\n378|\tsort.Strings(protocols)\n379|\tif err := validateProtocolVersions(BuiltinTmux, protocols); err != nil {\n380|\t\treturn nil, err\n381|\t}\n382|\tregistry := &Registry{records: make(map[string]Registration, 4)}\n383|\tbuiltins := []Registration{\n384|\t\t{\n385|\t\t\tID:                    BuiltinTmux,\n386|\t\t\tKind:                  KindBuiltinGo,\n387|\t\t\tImplementationVersion: implementationVersion,\n388|\t\t\t// Each built-in gets its own copy: sharing one backing array\n389|\t\t\t// would let a caller holding one record mutate the other.\n390|\t\t\tProtocolVersions: cloneStrings(protocols),\n391|\t\t\tPlatforms:        []scalar.Platform{scalar.PlatformLinux, scalar.PlatformMacOS, scalar.PlatformWSL2},\n392|\t\t\t// Platforms literal above is already sorted: linux < macos < wsl2.\n393|\t\t},\n394|\t\t{\n395|\t\t\tID:                    BuiltinConpty,\n396|\t\t\tKind:                  KindBuiltinGo,\n397|\t\t\tImplementationVersion: implementationVersion,\n398|\t\t\tProtocolVersions:      cloneStrings(protocols),\n399|\t\t\tPlatforms:             []scalar.Platform{scalar.PlatformWindows},\n400|\t\t},\n401|\t}\n402|\tfor _, record := range builtins {\n403|\t\tif err := record.validate(); err != nil {\n404|\t\t\treturn nil, err\n405|\t\t}\n406|\t\tregistry.records[record.ID] = record\n407|\t}\n408|\treturn registry, nil\n409|}\n410|\n411|// RegisterExternal admits one external adapter (§4.B discovery before\n412|// activation, §6.5 trust). The trust entry must be enabled and name an\n413|// absolute executable whose digest exactly equals the observed record digest;\n414|// a mismatch fails before any probe. The observed record must use an external\n415|// kind, carry the same ID, and pass full record validation. Registering an\n416|// already-known ID fails closed: an identical record is CodeAmbiguous\n417|// (registration is not idempotent) and any difference is CodeDrift.\n418|func (registry *Registry) RegisterExternal(platform scalar.Platform, entry TrustEntry, observed Registration) error {\n419|\tif registry == nil {\n420|\t\treturn &Error{Code: CodeNotFound, Detail: \"registry unavailable\"}\n421|\t}\n422|\tif err := entry.validate(platform); err != nil {\n423|\t\treturn err\n424|\t}\n425|\tif !entry.Enabled {\n426|\t\treturn &Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"external_trust disabled\"}\n427|\t}\n428|\tif observed.ID != entry.BackendID {\n429|\t\treturn &Error{Code: CodeAmbiguous, BackendID: entry.BackendID, Detail: \"external_trust identity binding\"}\n430|\t}\n431|\tif observed.Kind != KindLocalProgram && observed.Kind != KindTrustedExecutable {\n432|\t\treturn &Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"external implementation_kind\"}\n433|\t}\n434|\tif err := observed.validate(); err != nil {\n435|\t\treturn err\n436|\t}\n437|\tif observed.ExecutableDigest != entry.ExecutableDigest {\n438|\t\treturn &Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"executable substitution\"}\n439|\t}\n440|\tregistry.mutex.Lock()\n441|\tdefer registry.mutex.Unlock()\n442|\texisting, known := registry.records[observed.ID]\n443|\tif !known {\n444|\t\t// Store a copy: the caller keeps its own record, and retaining\n445|\t\t// the slices verbatim would leave the admitted record mutable\n446|\t\t// without passing any gate.\n447|\t\tregistry.records[observed.ID] = cloneRecord(observed)\n448|\t\treturn nil\n449|\t}\n450|\tif equalRecord(existing, observed) {\n451|\t\treturn &Error{Code: CodeAmbiguous, BackendID: observed.ID, Detail: \"duplicate backend_id\"}\n452|\t}\n453|\treturn &Error{Code: CodeDrift, BackendID: observed.ID, Detail: \"implementation drift\"}\n454|}\n455|\n456|// Resolve returns the admitted record for a canonical ID. An unknown,\n457|// malformed, or never-admitted ID is CodeNotFound: a registry read failure is\n458|// never absence, and callers must not fall back to a default.\n459|func (registry *Registry) Resolve(backendID string) (Registration, error) {\n460|\tif registry == nil {\n461|\t\treturn Registration{}, &Error{Code: CodeNotFound, Detail: \"registry unavailable\"}\n462|\t}\n463|\tid, err := ParseID(backendID)\n464|\tif err != nil {\n465|\t\treturn Registration{}, err\n466|\t}\n467|\tregistry.mutex.RLock()\n468|\tdefer registry.mutex.RUnlock()\n469|\trecord, known := registry.records[id]\n470|\tif !known {\n471|\t\treturn Registration{}, &Error{Code: CodeNotFound, BackendID: id, Detail: \"unregistered terminal_backend_id\"}\n472|\t}\n473|\t// Hand back a copy: the struct header copy shares the backing arrays,\n474|\t// so returning the stored record would hand out live interior state.\n475|\treturn cloneRecord(record), nil\n476|}\n477|\n478|// IDs returns the sorted admitted identities. It reports membership only,\n479|// never availability.\n480|func (registry *Registry) IDs() []string {\n481|\tif registry == nil {\n482|\t\treturn nil\n483|\t}\n484|\tregistry.mutex.RLock()\n485|\tdefer registry.mutex.RUnlock()\n486|\tids := make([]string, 0, len(registry.records))\n487|\tfor id := range registry.records {\n488|\t\tids = append(ids, id)\n489|\t}\n490|\tsort.Strings(ids)\n491|\treturn ids\n492|}\n493|\n494|// DefaultForPlatform returns the platform default for new activation (§6.5):\n495|// ax.tmux on macos/linux/wsl2 and ax.conpty on windows. Defaults select only\n496|// a new Terminal Instance; restore and resume must use RequireRestoreBinding.\n497|func DefaultForPlatform(platform scalar.Platform) (string, error) {\n498|\tswitch platform {\n499|\tcase scalar.PlatformMacOS, scalar.PlatformLinux, scalar.PlatformWSL2:\n500|\t\treturn BuiltinTmux, nil\n(more lines below)"}}}
