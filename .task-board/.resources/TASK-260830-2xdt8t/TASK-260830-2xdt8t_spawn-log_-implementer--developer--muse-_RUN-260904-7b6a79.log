{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c461","stream":{"kind":"session","id":"01a06e93-d53a-7932-a386-31af1b4e3b11"},"sequence":139,"recorded_at":1780531400000273,"record_type":"event","durability":"durable","causation_id":"f7bd976d-81ef-4282-860e-ea272a043469","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f7bd976d-81ef-4282-860e-ea272a043469","run_stream":{"kind":"run","id":"f7bd976d-81ef-4282-860e-ea272a043469"},"task_stream":{"kind":"task","id":"3b6a3f05-288e-46ff-b272-fd937156112c"},"task_id":"3b6a3f05-288e-46ff-b272-fd937156112c","event":{"kind":"output","task_id":"3b6a3f05-288e-46ff-b272-fd937156112c","chunk":"Read text file `internal/terminalbackend/terminalbackend_test.go`.\n(499 line(s) above)\n500|\t\t\t\tconpty.ProtocolVersions, testProto)\n501|\t\t}\n502|\t})\n503|\n504|\tt.Run(\"in-place mutation no longer converts drift to duplicate\", func(t *testing.T) {\n505|\t\tt.Parallel()\n506|\t\tregistry := testRegistry(t)\n507|\t\tmustRegisterExternal(t, registry, \"com.example.term\")\n508|\t\tmutated, err := registry.Resolve(\"com.example.term\")\n509|\t\tif err != nil {\n510|\t\t\tt.Fatalf(\"Resolve() error = %v\", err)\n511|\t\t}\n512|\t\tmutated.ProtocolVersions[0] = \"1.4.0\"\n513|\t\terr = registry.RegisterExternal(scalar.PlatformLinux, testTrustEntry(\"com.example.term\"), mutated)\n514|\t\tif !terminalbackend.IsDrift(err) {\n515|\t\t\tt.Fatalf(\"RegisterExternal(mutated) error = %v, want terminal_backend_implementation_drift\", err)\n516|\t\t}\n517|\t\tadmitted, err := registry.Resolve(\"com.example.term\")\n518|\t\tif err != nil {\n519|\t\t\tt.Fatalf(\"Resolve() error = %v\", err)\n520|\t\t}\n521|\t\tif len(admitted.ProtocolVersions) != 1 || admitted.ProtocolVersions[0] != testProto {\n522|\t\t\tt.Errorf(\"registry adopted the mutation: protocols=%v, want [%q]\",\n523|\t\t\t\tadmitted.ProtocolVersions, testProto)\n524|\t\t}\n525|\t})\n526|}\n527|\n528|// refusalDetail extracts the static clause of a registry refusal. The code\n529|// alone cannot discriminate precedence between two guards reporting the same\n530|// wire code, so the bound-precedence pins below assert the clause.\n531|func refusalDetail(t *testing.T, err error) string {\n532|\tt.Helper()\n533|\tvar refusal *terminalbackend.Error\n534|\tif !errors.As(err, &refusal) {\n535|\t\tt.Fatalf(\"error %v is not a *terminalbackend.Error\", err)\n536|\t}\n537|\treturn refusal.Detail\n538|}\n539|\n540|// TestRegisterExternalRefusesPlatformViolations narrows the platform-set\n541|// gate member by member: each case breaks exactly one of the sorted-unique,\n542|// non-empty, vocabulary, or upper-bound rules at the production admission\n543|// entry point.\n544|func TestRegisterExternalRefusesPlatformViolations(t *testing.T) {\n545|\tt.Parallel()\n546|\n547|\tcases := []struct {\n548|\t\tname      string\n549|\t\tplatforms []scalar.Platform\n550|\t\tdetail    string\n551|\t}{\n552|\t\t{\"duplicate platform\", []scalar.Platform{scalar.PlatformLinux, scalar.PlatformLinux}, \"platforms sorted unique\"},\n553|\t\t{\"empty platform set\", nil, \"platforms bound\"},\n554|\t\t{\"unknown platform member\", []scalar.Platform{scalar.PlatformLinux, scalar.Platform(\"plan9\")}, \"platforms vocabulary\"},\n555|\t\t// Five members from a four-member vocabulary must contain a repeat\n556|\t\t// or an outsider, so only the bound check fires first: assert the\n557|\t\t// clause to prove the length arm ran rather than a later rule.\n558|\t\t{\"five platform members\", []scalar.Platform{\n559|\t\t\tscalar.PlatformLinux, scalar.PlatformLinux,\n560|\t\t\tscalar.PlatformMacOS, scalar.PlatformWindows, scalar.PlatformWSL2,\n561|\t\t}, \"platforms bound\"},\n562|\t}\n563|\tfor _, testCase := range cases {\n564|\t\tt.Run(testCase.name, func(t *testing.T) {\n565|\t\t\tt.Parallel()\n566|\t\t\tregistry := testRegistry(t)\n567|\t\t\trecord := testExternalRecord(\"com.example.term\")\n568|\t\t\trecord.Platforms = testCase.platforms\n569|\t\t\terr := registry.RegisterExternal(scalar.PlatformLinux, testTrustEntry(\"com.example.term\"), record)\n570|\t\t\tif !terminalbackend.IsNotFound(err) {\n571|\t\t\t\tt.Fatalf(\"RegisterExternal() error = %v, want terminal_backend_not_found\", err)\n572|\t\t\t}\n573|\t\t\tif got := refusalDetail(t, err); got != testCase.detail {\n574|\t\t\t\tt.Errorf(\"refusal detail = %q, want %q\", got, testCase.detail)\n575|\t\t\t}\n576|\t\t\tif _, resolveErr := registry.Resolve(\"com.example.term\"); !terminalbackend.IsNotFound(resolveErr) {\n577|\t\t\t\tt.Errorf(\"Resolve() after refused registration = %v, want terminal_backend_not_found\", resolveErr)\n578|\t\t\t}\n579|\t\t})\n580|\t}\n581|}\n582|\n583|// TestRegisterExternalRefusesUnknownKindAsUntrusted pins the guard order at\n584|// the production entry point: a non-external kind (including one outside the\n585|// closed vocabulary) is a trust failure before record validation runs. The\n586|// closed implementation_kind vocabulary in parseKind is therefore unreachable\n587|// through this entry point by construction, and is pinned white-box in\n588|// internal_pin_test.go instead.\n589|func TestRegisterExternalRefusesUnknownKindAsUntrusted(t *testing.T) {\n590|\tt.Parallel()\n591|\n592|\tregistry := testRegistry(t)\n593|\trecord := testExternalRecord(\"com.example.term\")\n594|\trecord.Kind = terminalbackend.Kind(\"bogus_kind\")\n595|\terr := registry.RegisterExternal(scalar.PlatformLinux, testTrustEntry(\"com.example.term\"), record)\n596|\tif !terminalbackend.IsUntrusted(err) {\n597|\t\tt.Fatalf(\"RegisterExternal(bogus kind) error = %v, want terminal_backend_untrusted\", err)\n598|\t}\n599|}\n600|\n601|// TestResolveUnknownIsNeverAbsence proves unknown and malformed identities\n602|// fail closed instead of resolving to a default or an empty record.\n603|func TestResolveUnknownIsNeverAbsence(t *testing.T) {\n604|\tt.Parallel()\n605|\n606|\tregistry := testRegistry(t)\n607|\tfor _, id := range []string{\"com.example.unknown\", \"INVALID_ID\", \"\", \"ax.evil\"} {\n608|\t\tif _, err := registry.Resolve(id); !terminalbackend.IsNotFound(err) {\n609|\t\t\tt.Errorf(\"Resolve(%q) error = %v, want terminal_backend_not_found\", id, err)\n610|\t\t}\n611|\t}\n612|\tvar nilRegistry *terminalbackend.Registry\n613|\tif _, err := nilRegistry.Resolve(terminalbackend.BuiltinTmux); !terminalbackend.IsNotFound(err) {\n614|\t\tt.Errorf(\"nil Resolve() error = %v, want terminal_backend_not_found\", err)\n615|\t}\n616|\tif err := nilRegistry.RegisterExternal(scalar.PlatformLinux, testTrustEntry(\"com.example.term\"), testExternalRecord(\"com.example.term\")); !terminalbackend.IsNotFound(err) {\n617|\t\tt.Errorf(\"nil RegisterExternal() error = %v, want terminal_backend_not_found\", err)\n618|\t}\n619|}\n620|\n621|// TestDefaultForPlatform pins the Section 6.5 platform defaults for new\n622|// activation only: they must never be used as a restore fallback.\n623|func TestDefaultForPlatform(t *testing.T) {\n624|\tt.Parallel()\n625|\n626|\tcases := []struct {\n627|\t\tplatform scalar.Platform\n628|\t\twant     string\n629|\t}{\n630|\t\t{scalar.PlatformMacOS, terminalbackend.BuiltinTmux},\n631|\t\t{scalar.PlatformLinux, terminalbackend.BuiltinTmux},\n632|\t\t{scalar.PlatformWSL2, terminalbackend.BuiltinTmux},\n633|\t\t{scalar.PlatformWindows, terminalbackend.BuiltinConpty},\n634|\t}\n635|\tfor _, testCase := range cases {\n636|\t\tif got, err := terminalbackend.DefaultForPlatform(testCase.platform); err != nil || got != testCase.want {\n637|\t\t\tt.Errorf(\"DefaultForPlatform(%q) = %q, %v; want %q\", testCase.platform, got, err, testCase.want)\n638|\t\t}\n639|\t}\n640|\tif _, err := terminalbackend.DefaultForPlatform(scalar.Platform(\"plan9\")); !terminalbackend.IsNotFound(err) {\n641|\t\tt.Errorf(\"DefaultForPlatform(plan9) error = %v, want terminal_backend_not_found\", err)\n642|\t}\n643|}\n644|\n645|// TestRequireRestoreBinding proves restore uses the exact prior binding: the\n646|// configured default is refused when it differs, and an unregistered bound ID\n647|// cannot activate.\n648|func TestRequireRestoreBinding(t *testing.T) {\n649|\tt.Parallel()\n650|\n651|\tregistry := testRegistry(t)\n652|\tmustRegisterExternal(t, registry, \"com.example.term\")\n653|\n654|\trecord, err := registry.RequireRestoreBinding(\"com.example.term\", \"com.example.term\")\n655|\tif err != nil {\n656|\t\tt.Fatalf(\"RequireRestoreBinding(exact) error = %v\", err)\n657|\t}\n658|\tif record.ID != \"com.example.term\" {\n659|\t\tt.Errorf(\"RequireRestoreBinding(exact) ID = %q, want com.example.term\", record.ID)\n660|\t}\n661|\tif _, err := registry.RequireRestoreBinding(\"com.example.term\", terminalbackend.BuiltinTmux); !terminalbackend.IsRestoreMismatch(err) {\n662|\t\tt.Errorf(\"RequireRestoreBinding(default substitution) error = %v, want terminal_backend_restore_mismatch\", err)\n663|\t}\n664|\tif _, err := registry.RequireRestoreBinding(\"com.example.gone\", \"com.example.gone\"); !terminalbackend.IsNotFound(err) {\n665|\t\tt.Errorf(\"RequireRestoreBinding(unknown) error = %v, want terminal_backend_not_found\", err)\n666|\t}\n667|\tif _, err := registry.RequireRestoreBinding(\"com.example.term\", \"INVALID_ID\"); !terminalbackend.IsNotFound(err) {\n668|\t\tt.Errorf(\"RequireRestoreBinding(malformed candidate) error = %v, want terminal_backend_not_found\", err)\n669|\t}\n670|}\n671|\n672|// TestCheckVersionTuple narrows version admission to membership: the accepted\n673|// protocol must be exactly one list member in major 1.\n674|func TestCheckVersionTuple(t *testing.T) {\n675|\tt.Parallel()\n676|\n677|\tif err := terminalbackend.CheckVersionTuple(\"com.example.term\", \"1.2.3\", \"1.0.0\", []string{\"1.0.0\", \"1.1.0\"}); err != nil {\n678|\t\tt.Errorf(\"CheckVersionTuple(member) error = %v, want admission\", err)\n679|\t}\n680|\tcases := []struct {\n681|\t\tname  string\n682|\t\timpl  string\n683|\t\tproto string\n684|\t\tlist  []string\n685|\t}{\n686|\t\t{\"non-semver implementation\", \"v1\", \"1.0.0\", []string{\"1.0.0\"}},\n687|\t\t{\"protocol major 2\", \"1.2.3\", \"2.0.0\", []string{\"2.0.0\"}},\n688|\t\t{\"protocol not a member\", \"1.2.3\", \"1.1.0\", []string{\"1.0.0\"}},\n689|\t\t{\"protocol major 1 but unlisted\", \"1.2.3\", \"1.0.0\", []string{\"1.1.0\"}},\n690|\t\t{\"non-semver protocol\", \"1.2.3\", \"one\", []string{\"one\"}},\n691|\t\t{\"empty list\", \"1.2.3\", \"1.0.0\", nil},\n692|\t}\n693|\tfor _, testCase := range cases {\n694|\t\tt.Run(testCase.name, func(t *testing.T) {\n695|\t\t\tt.Parallel()\n696|\t\t\terr := terminalbackend.CheckVersionTuple(\"com.example.term\", testCase.impl, testCase.proto, testCase.list)\n697|\t\t\tif !terminalbackend.IsDrift(err) {\n698|\t\t\t\tt.Errorf(\"CheckVersionTuple() error = %v, want terminal_backend_implementation_drift\", err)\n699|\t\t\t}\n700|\t\t})\n701|\t}\n702|}\n703|\n704|// TestCheckProviderDescriptor drives the Section 7.A production rule: the\n705|// provider rejects a descriptor that does not match the validated binding.\n706|func TestCheckProviderDescriptor(t *testing.T) {\n707|\tt.Parallel()\n708|\n709|\tbinding := terminalbackend.InstanceBinding{\n710|\t\tBackendID:             \"com.example.term\",\n711|\t\tImplementationVersion: \"1.2.3\",\n712|\t\tProtocolVersion:       \"1.0.0\",\n713|\t\tGeneration:            \"generation-1\",\n714|\t}\n715|\tif err := terminalbackend.CheckProviderDescriptor(binding, binding); err != nil {\n716|\t\tt.Errorf(\"CheckProviderDescriptor(match) error = %v, want admission\", err)\n717|\t}\n718|\n719|\tversionDrift := binding\n720|\tversionDrift.ImplementationVersion = \"1.2.4\"\n721|\tif err := terminalbackend.CheckProviderDescriptor(versionDrift, binding); !terminalbackend.IsDrift(err) {\n722|\t\tt.Errorf(\"CheckProviderDescriptor(version drift) error = %v, want terminal_backend_implementation_drift\", err)\n723|\t}\n724|\tprotoDrift := binding\n725|\tprotoDrift.ProtocolVersion = \"1.1.0\"\n726|\tif err := terminalbackend.CheckProviderDescriptor(protoDrift, binding); !terminalbackend.IsDrift(err) {\n727|\t\tt.Errorf(\"CheckProviderDescriptor(protocol drift) error = %v, want terminal_backend_implementation_drift\", err)\n728|\t}\n729|\tidMismatch := binding\n730|\tidMismatch.BackendID = \"com.example.other\"\n731|\tif err := terminalbackend.CheckProviderDescriptor(idMismatch, binding); !terminalbackend.IsNotFound(err) {\n732|\t\tt.Errorf(\"CheckProviderDescriptor(ID mismatch) error = %v, want terminal_backend_not_found\", err)\n733|\t}\n734|\t// The stale-generation arm lives in TestCheckProviderDescriptorGenerationMismatch.\n735|}\n736|\n737|// TestCheckProviderDescriptorGenerationBounds proves the Section 7.A\n738|// string[1..256] bound itself, not the generation mismatch: every refusal\n739|// case carries the SAME generation on both sides, so the mismatch comparison\n740|// cannot fire and only the bound can refuse. (Pitting a mutated generation\n741|// against a fixed one proves nothing about the bound — the inequality alone\n742|// returns terminal_backend_stale_generation.)\n743|func TestCheckProviderDescriptorGenerationBounds(t *testing.T) {\n744|\tt.Parallel()\n745|\n746|\twithGeneration := func(generation string) terminalbackend.InstanceBinding {\n747|\t\treturn terminalbackend.InstanceBinding{\n748|\t\t\tBackendID:             \"com.example.term\",\n749|\t\t\tImplementationVersion: \"1.2.3\",\n750|\t\t\tProtocolVersion:       \"1.0.0\",\n751|\t\t\tGeneration:            generation,\n752|\t\t}\n753|\t}\n754|\tadmitted := []struct {\n755|\t\tname       string\n756|\t\tgeneration string\n757|\t}{\n758|\t\t{\"one byte\", \"g\"},\n759|\t\t{\"256 bytes\", strings.Repeat(\"g\", 256)},\n760|\t}\n761|\tfor _, testCase := range admitted {\n762|\t\tt.Run(testCase.name, func(t *testing.T) {\n763|\t\t\tt.Parallel()\n764|\t\t\tbinding := withGeneration(testCase.generation)\n765|\t\t\tif err := terminalbackend.CheckProviderDescriptor(binding, binding); err != nil {\n766|\t\t\t\tt.Errorf(\"CheckProviderDescriptor(%d-byte generation, equal) error = %v, want admission\",\n767|\t\t\t\t\tlen(testCase.generation), err)\n768|\t\t\t}\n769|\t\t})\n770|\t}\n771|\trefused := []struct {\n772|\t\tname       string\n773|\t\tgeneration string\n774|\t}{\n775|\t\t{\"empty\", \"\"},\n776|\t\t{\"257 bytes\", strings.Repeat(\"g\", 257)},\n777|\t}\n778|\tfor _, testCase := range refused {\n779|\t\tt.Run(testCase.name, func(t *testing.T) {\n780|\t\t\tt.Parallel()\n781|\t\t\tbinding := withGeneration(testCase.generation)\n782|\t\t\terr := terminalbackend.CheckProviderDescriptor(binding, binding)\n783|\t\t\tif !terminalbackend.IsStaleGeneration(err) {\n784|\t\t\t\tt.Errorf(\"CheckProviderDescriptor(%d-byte generation, equal) error = %v, want terminal_backend_stale_generation\",\n785|\t\t\t\t\tlen(testCase.generation), err)\n786|\t\t\t}\n787|\t\t})\n788|\t}\n789|}\n790|\n791|// TestCheckProviderDescriptorGenerationMismatch keeps the mismatch arm pinned\n792|// separately: differing valid generations refuse even though each side is\n793|// within the bound.\n794|func TestCheckProviderDescriptorGenerationMismatch(t *testing.T) {\n795|\tt.Parallel()\n796|\n797|\tbinding := terminalbackend.InstanceBinding{\n798|\t\tBackendID:             \"com.example.term\",\n799|\t\tImplementationVersion: \"1.2.3\",\n800|\t\tProtocolVersion:       \"1.0.0\",\n801|\t\tGeneration:            \"generation-1\",\n802|\t}\n803|\tstale := binding\n804|\tstale.Generation = \"generation-2\"\n805|\tif err := terminalbackend.CheckProviderDescriptor(stale, binding); !terminalbackend.IsStaleGeneration(err) {\n806|\t\tt.Errorf(\"CheckProviderDescriptor(stale generation) error = %v, want terminal_backend_stale_generation\", err)\n807|\t}\n808|}\n809|\n810|// TestDigestFile binds trust to bytes: the digest of a real file verifies,\n811|// symlinks resolve to their target, and non-files or missing paths fail\n812|// without producing a digest.\n813|func TestDigestFile(t *testing.T) {\n814|\tt.Parallel()\n815|\n816|\tpayload := []byte(\"#!/bin/sh\\nexec ax-backend-term \\\"$@\\\"\\n\")\n817|\tpath := filepath.Join(t.TempDir(), \"ax-backend-term\")\n818|\tif err := os.WriteFile(path, payload, 0o755); err != nil {\n819|\t\tt.Fatalf(\"WriteFile() error = %v\", err)\n820|\t}\n821|\tsum := sha256.Sum256(payload)\n822|\twant := \"sha256:\" + hex.EncodeToString(sum[:])\n823|\tgot, err := terminalbackend.DigestFile(path)\n824|\tif err != nil {\n825|\t\tt.Fatalf(\"DigestFile() error = %v\", err)\n826|\t}\n827|\tif got != want {\n828|\t\tt.Errorf(\"DigestFile() = %q, want %q\", got, want)\n829|\t}\n830|\tlink := filepath.Join(t.TempDir(), \"link-backend-term\")\n831|\tif err := os.Symlink(path, link); err != nil {\n832|\t\tt.Fatalf(\"Symlink() error = %v\", err)\n833|\t}\n834|\tgotLink, err := terminalbackend.DigestFile(link)\n835|\tif err != nil {\n836|\t\tt.Fatalf(\"DigestFile(symlink) error = %v\", err)\n837|\t}\n838|\tif gotLink != want {\n839|\t\tt.Errorf(\"DigestFile(symlink) = %q, want %q\", gotLink, want)\n840|\t}\n841|\tif _, err := terminalbackend.DigestFile(filepath.Join(t.TempDir(), \"absent\")); err == nil {\n842|\t\tt.Error(\"DigestFile(absent) error = nil, want a failed read\")\n843|\t}\n844|\tif _, err := terminalbackend.DigestFile(t.TempDir()); err == nil {\n845|\t\tt.Error(\"DigestFile(directory) error = nil, want refusal for a non-regular file\")\n846|\t}\n847|\t// A FIFO pins the regular-file guard itself: the directory case above\n848|\t// would still fail with the guard removed, because os.ReadFile rejects\n849|\t// directories (EISDIR) on its own. A FIFO is the documented hazard\n850|\t// (README: os.Open blocks indefinitely on a FIFO), and only the\n851|\t// Mode().IsRegular check refuses it without blocking.\n852|\tfifo := filepath.Join(t.TempDir(), \"backend-fifo\")\n853|\tif err := syscall.Mkfifo(fifo, 0o600); err != nil {\n854|\t\tt.Fatalf(\"Mkfifo() error = %v\", err)\n855|\t}\n856|\tif _, err := terminalbackend.DigestFile(fifo); err == nil {\n857|\t\tt.Error(\"DigestFile(fifo) error = nil, want refusal for a non-regular file\")\n858|\t}\n859|}\n860|\n861|// TestErrorPredicatesAreExclusive guards the negative-evidence contract: a\n862|// refusal carries exactly one wire code, so a passing negative test cannot be\n863|// explained by overlapping predicates.\n864|func TestErrorPredicatesAreExclusive(t *testing.T) {\n865|\tt.Parallel()\n866|\n867|\tregistry := testRegistry(t)\n868|\tmustRegisterExternal(t, registry, \"com.example.term\")\n869|\n870|\tcases := []struct {\n871|\t\tname string\n872|\t\terr  error\n873|\t\twant func(error) bool\n874|\t}{\n875|\t\t{\"unknown\", func() error { _, err := registry.Resolve(\"com.example.gone\"); return err }(), terminalbackend.IsNotFound},\n876|\t\t{\"duplicate\", func() error {\n877|\t\t\treturn registry.RegisterExternal(scalar.PlatformLinux, testTrustEntry(\"com.example.term\"), testExternalRecord(\"com.example.term\"))\n878|\t\t}(), terminalbackend.IsAmbiguous},\n879|\t\t{\"drift\", func() error {\n880|\t\t\tdrifted := testExternalRecord(\"com.example.term\")\n881|\t\t\tdrifted.ImplementationVersion = \"9.9.9\"\n882|\t\t\treturn registry.RegisterExternal(scalar.PlatformLinux, testTrustEntry(\"com.example.term\"), drifted)\n883|\t\t}(), terminalbackend.IsDrift},\n884|\t\t{\"untrusted\", func() error {\n885|\t\t\tentry := testTrustEntry(\"com.example.fresh\")\n886|\t\t\tentry.Enabled = false\n887|\t\t\treturn registry.RegisterExternal(scalar.PlatformLinux, entry, testExternalRecord(\"com.example.fresh\"))\n888|\t\t}(), terminalbackend.IsUntrusted},\n889|\t\t{\"restore mismatch\", func() error {\n890|\t\t\t_, err := registry.RequireRestoreBinding(\"com.example.term\", terminalbackend.BuiltinTmux)\n891|\t\t\treturn err\n892|\t\t}(), terminalbackend.IsRestoreMismatch},\n893|\t\t{\"stale generation\", func() error {\n894|\t\t\tbinding := terminalbackend.InstanceBinding{BackendID: \"com.example.term\", ImplementationVersion: \"1.2.3\", ProtocolVersion: \"1.0.0\", Generation: \"a\"}\n895|\t\t\tstale := binding\n896|\t\t\tstale.Generation = \"b\"\n897|\t\t\treturn terminalbackend.CheckProviderDescriptor(stale, binding)\n898|\t\t}(), terminalbackend.IsStaleGeneration},\n899|\t}\n900|\tpredicates := map[string]func(error) bool{\n901|\t\t\"not found\": terminalbackend.IsNotFound, \"ambiguous\": terminalbackend.IsAmbiguous,\n902|\t\t\"untrusted\": terminalbackend.IsUntrusted, \"drift\": terminalbackend.IsDrift,\n903|\t\t\"restore mismatch\": terminalbackend.IsRestoreMismatch, \"stale\": terminalbackend.IsStaleGeneration,\n904|\t}\n905|\tfor _, testCase := range cases {\n906|\t\tt.Run(testCase.name, func(t *testing.T) {\n907|\t\t\tt.Parallel()\n908|\t\t\tif testCase.err == nil {\n909|\t\t\t\tt.Fatalf(\"expected a refusal, got nil\")\n910|\t\t\t}\n911|\t\t\tmatched := 0\n912|\t\t\tfor name, predicate := range predicates {\n913|\t\t\t\tif predicate(testCase.err) {\n914|\t\t\t\t\tmatched++\n915|\t\t\t\t\tif !testCase.want(testCase.err) {\n916|\t\t\t\t\t\tt.Errorf(\"refusal %v unexpectedly matches %q\", testCase.err, name)\n917|\t\t\t\t\t}\n918|\t\t\t\t}\n919|\t\t\t}\n920|\t\t\tif matched != 1 {\n921|\t\t\t\tt.Errorf(\"refusal %v matches %d predicates, want exactly 1\", testCase.err, matched)\n922|\t\t\t}\n923|\t\t})\n924|\t}\n925|}"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c463","stream":{"kind":"session","id":"01a06e93-d53a-7932-a386-31af1b4e3b11"},"sequence":140,"recorded_at":1780531400000275,"record_type":"event","durability":"durable","causation_id":"f7bd976d-81ef-4282-860e-ea272a043469","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f7bd976d-81ef-4282-860e-ea272a043469","run_stream":{"kind":"run","id":"f7bd976d-81ef-4282-860e-ea272a043469"},"task_stream":{"kind":"task","id":"3b6a3f05-288e-46ff-b272-fd937156112c"},"task_id":"3b6a3f05-288e-46ff-b272-fd937156112c","event":{"kind":"completed","task_id":"3b6a3f05-288e-46ff-b272-fd937156112c"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c465","stream":{"kind":"session","id":"01a06e93-d53a-7932-a386-31af1b4e3b11"},"sequence":141,"recorded_at":1780531400000277,"record_type":"event","durability":"durable","causation_id":"f7bd976d-81ef-4282-860e-ea272a043469","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f7bd976d-81ef-4282-860e-ea272a043469","run_stream":{"kind":"run","id":"f7bd976d-81ef-4282-860e-ea272a043469"},"call_id":"call_01a06e9443187ac09430038b54204477","text":"Read text file `internal/terminalbackend/terminalbackend.go`.\n(499 line(s) above)\n500|\t\treturn BuiltinTmux, nil\n501|\tcase scalar.PlatformWindows:\n502|\t\treturn BuiltinConpty, nil\n503|\tdefault:\n504|\t\treturn \"\", &Error{Code: CodeNotFound, Detail: \"platform vocabulary\"}\n505|\t}\n506|}\n507|\n508|// RequireRestoreBinding resolves the exact prior binding for restore or\n509|// resume (§4.B, §6.5). The candidate must equal the bound backend ID; using\n510|// the current configured default instead is CodeRestoreMismatch. The bound ID\n511|// must be registered: unknown or unsupported IDs remain visible but cannot\n512|// activate.\n513|func (registry *Registry) RequireRestoreBinding(boundBackendID, candidateBackendID string) (Registration, error) {\n514|\tif registry == nil {\n515|\t\treturn Registration{}, &Error{Code: CodeNotFound, Detail: \"registry unavailable\"}\n516|\t}\n517|\tbound, err := ParseID(boundBackendID)\n518|\tif err != nil {\n519|\t\treturn Registration{}, err\n520|\t}\n521|\tcandidate, err := ParseID(candidateBackendID)\n522|\tif err != nil {\n523|\t\treturn Registration{}, err\n524|\t}\n525|\tif candidate != bound {\n526|\t\treturn Registration{}, &Error{Code: CodeRestoreMismatch, BackendID: candidate, Detail: \"restore requires the prior binding\"}\n527|\t}\n528|\treturn registry.Resolve(bound)\n529|}\n530|\n531|// CheckVersionTuple admits one (implementation_version, protocol_version)\n532|// pair against the admitted protocol list: the implementation must be\n533|// semver, the protocol must be semver in Terminal Backend Protocol major 1\n534|// and exactly one member of the list. Array-to-scalar selection is\n535|// membership, not aggregate equality (§4.B).\n536|func CheckVersionTuple(backendID, implementationVersion, protocolVersion string, protocolVersions []string) error {\n537|\tif !semverPattern.MatchString(implementationVersion) {\n538|\t\treturn &Error{Code: CodeDrift, BackendID: backendID, Detail: \"implementation_version semver\"}\n539|\t}\n540|\tif !semverPattern.MatchString(protocolVersion) || semverMajor(protocolVersion) != 1 {\n541|\t\treturn &Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_version major 1\"}\n542|\t}\n543|\tfor _, member := range protocolVersions {\n544|\t\tif protocolVersion == member {\n545|\t\t\treturn nil\n546|\t\t}\n547|\t}\n548|\treturn &Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_version membership\"}\n549|}\n550|\n551|// InstanceBinding is the validated host-local binding subset a §7.A provider\n552|// descriptor must match: backend ID, versions, and generation.\n553|type InstanceBinding struct {\n554|\tBackendID             string\n555|\tImplementationVersion string\n556|\tProtocolVersion       string\n557|\tGeneration            string\n558|}\n559|\n560|// CheckProviderDescriptor enforces the Section 7.A rule: the provider rejects\n561|// a descriptor whose backend ID, versions, or generation do not match the\n562|// AX-validated host-local binding before launching or observing a provider\n563|// process. Generation lengths 0 and over 256 are invalid; 256 is accepted.\n564|func CheckProviderDescriptor(descriptor, binding InstanceBinding) error {\n565|\tif err := checkGeneration(descriptor.Generation); err != nil {\n566|\t\treturn err\n567|\t}\n568|\tif err := checkGeneration(binding.Generation); err != nil {\n569|\t\treturn err\n570|\t}\n571|\tif _, err := ParseID(descriptor.BackendID); err != nil {\n572|\t\treturn err\n573|\t}\n574|\tif descriptor.BackendID != binding.BackendID {\n575|\t\treturn &Error{Code: CodeNotFound, BackendID: descriptor.BackendID, Detail: \"descriptor backend binding\"}\n576|\t}\n577|\tif descriptor.ImplementationVersion != binding.ImplementationVersion ||\n578|\t\tdescriptor.ProtocolVersion != binding.ProtocolVersion {\n579|\t\treturn &Error{Code: CodeDrift, BackendID: descriptor.BackendID, Detail: \"descriptor version binding\"}\n580|\t}\n581|\tif descriptor.Generation != binding.Generation {\n582|\t\treturn &Error{Code: CodeStaleGeneration, BackendID: descriptor.BackendID, Detail: \"descriptor generation binding\"}\n583|\t}\n584|\treturn nil\n585|}\n586|\n587|// checkGeneration enforces string[1..256] measured in bytes over valid UTF-8.\n588|func checkGeneration(generation string) error {\n589|\tif !utf8.ValidString(generation) || len(generation) < 1 || len(generation) > maxGenerationBytes {\n590|\t\treturn &Error{Code: CodeStaleGeneration, Detail: \"backend_generation bound\"}\n591|\t}\n592|\treturn nil\n593|}\n594|\n595|// DigestFile returns the sha256: digest of the executable at path after\n596|// resolving symlinks. The target must be a regular file; anything else (or a\n597|// read failure) is an error, never a digest. It distinguishes a failed read\n598|// from an absent trust entry: callers must not fall back to PATH discovery.\n599|func DigestFile(path string) (string, error) {\n600|\tresolved, err := filepath.EvalSymlinks(path)\n601|\tif err != nil {\n602|\t\treturn \"\", fmt.Errorf(\"terminal backend executable: %w\", err)\n603|\t}\n604|\tinfo, err := os.Stat(resolved)\n605|\tif err != nil {\n606|\t\treturn \"\", fmt.Errorf(\"terminal backend executable: %w\", err)\n607|\t}\n608|\tif !info.Mode().IsRegular() {\n609|\t\treturn \"\", fmt.Errorf(\"terminal backend executable %s: not a regular file\", resolved)\n610|\t}\n611|\traw, err := os.ReadFile(resolved)\n612|\tif err != nil {\n613|\t\treturn \"\", fmt.Errorf(\"terminal backend executable: %w\", err)\n614|\t}\n615|\tsum := sha256.Sum256(raw)\n616|\treturn \"sha256:\" + hex.EncodeToString(sum[:]), nil\n617|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c467","stream":{"kind":"session","id":"01a06e93-d53a-7932-a386-31af1b4e3b11"},"sequence":142,"recorded_at":1780531400000279,"record_type":"event","durability":"durable","causation_id":"f7bd976d-81ef-4282-860e-ea272a043469","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f7bd976d-81ef-4282-860e-ea272a043469","run_stream":{"kind":"run","id":"f7bd976d-81ef-4282-860e-ea272a043469"},"call_id":"call_01a06e9444317d53a73f81fae085920e","text":"Read text file `internal/terminalbackend/terminalbackend_test.go`.\n(499 line(s) above)\n500|\t\t\t\tconpty.ProtocolVersions, testProto)\n501|\t\t}\n502|\t})\n503|\n504|\tt.Run(\"in-place mutation no longer converts drift to duplicate\", func(t *testing.T) {\n505|\t\tt.Parallel()\n506|\t\tregistry := testRegistry(t)\n507|\t\tmustRegisterExternal(t, registry, \"com.example.term\")\n508|\t\tmutated, err := registry.Resolve(\"com.example.term\")\n509|\t\tif err != nil {\n510|\t\t\tt.Fatalf(\"Resolve() error = %v\", err)\n511|\t\t}\n512|\t\tmutated.ProtocolVersions[0] = \"1.4.0\"\n513|\t\terr = registry.RegisterExternal(scalar.PlatformLinux, testTrustEntry(\"com.example.term\"), mutated)\n514|\t\tif !terminalbackend.IsDrift(err) {\n515|\t\t\tt.Fatalf(\"RegisterExternal(mutated) error = %v, want terminal_backend_implementation_drift\", err)\n516|\t\t}\n517|\t\tadmitted, err := registry.Resolve(\"com.example.term\")\n518|\t\tif err != nil {\n519|\t\t\tt.Fatalf(\"Resolve() error = %v\", err)\n520|\t\t}\n521|\t\tif len(admitted.ProtocolVersions) != 1 || admitted.ProtocolVersions[0] != testProto {\n522|\t\t\tt.Errorf(\"registry adopted the mutation: protocols=%v, want [%q]\",\n523|\t\t\t\tadmitted.ProtocolVersions, testProto)\n524|\t\t}\n525|\t})\n526|}\n527|\n528|// refusalDetail extracts the static clause of a registry refusal. The code\n529|// alone cannot discriminate precedence between two guards reporting the same\n530|// wire code, so the bound-precedence pins below assert the clause.\n531|func refusalDetail(t *testing.T, err error) string {\n532|\tt.Helper()\n533|\tvar refusal *terminalbackend.Error\n534|\tif !errors.As(err, &refusal) {\n535|\t\tt.Fatalf(\"error %v is not a *terminalbackend.Error\", err)\n536|\t}\n537|\treturn refusal.Detail\n538|}\n539|\n540|// TestRegisterExternalRefusesPlatformViolations narrows the platform-set\n541|// gate member by member: each case breaks exactly one of the sorted-unique,\n542|// non-empty, vocabulary, or upper-bound rules at the production admission\n543|// entry point.\n544|func TestRegisterExternalRefusesPlatformViolations(t *testing.T) {\n545|\tt.Parallel()\n546|\n547|\tcases := []struct {\n548|\t\tname      string\n549|\t\tplatforms []scalar.Platform\n550|\t\tdetail    string\n551|\t}{\n552|\t\t{\"duplicate platform\", []scalar.Platform{scalar.PlatformLinux, scalar.PlatformLinux}, \"platforms sorted unique\"},\n553|\t\t{\"empty platform set\", nil, \"platforms bound\"},\n554|\t\t{\"unknown platform member\", []scalar.Platform{scalar.PlatformLinux, scalar.Platform(\"plan9\")}, \"platforms vocabulary\"},\n555|\t\t// Five members from a four-member vocabulary must contain a repeat\n556|\t\t// or an outsider, so only the bound check fires first: assert the\n557|\t\t// clause to prove the length arm ran rather than a later rule.\n558|\t\t{\"five platform members\", []scalar.Platform{\n559|\t\t\tscalar.PlatformLinux, scalar.PlatformLinux,\n560|\t\t\tscalar.PlatformMacOS, scalar.PlatformWindows, scalar.PlatformWSL2,\n561|\t\t}, \"platforms bound\"},\n562|\t}\n563|\tfor _, testCase := range cases {\n564|\t\tt.Run(testCase.name, func(t *testing.T) {\n565|\t\t\tt.Parallel()\n566|\t\t\tregistry := testRegistry(t)\n567|\t\t\trecord := testExternalRecord(\"com.example.term\")\n568|\t\t\trecord.Platforms = testCase.platforms\n569|\t\t\terr := registry.RegisterExternal(scalar.PlatformLinux, testTrustEntry(\"com.example.term\"), record)\n570|\t\t\tif !terminalbackend.IsNotFound(err) {\n571|\t\t\t\tt.Fatalf(\"RegisterExternal() error = %v, want terminal_backend_not_found\", err)\n572|\t\t\t}\n573|\t\t\tif got := refusalDetail(t, err); got != testCase.detail {\n574|\t\t\t\tt.Errorf(\"refusal detail = %q, want %q\", got, testCase.detail)\n575|\t\t\t}\n576|\t\t\tif _, resolveErr := registry.Resolve(\"com.example.term\"); !terminalbackend.IsNotFound(resolveErr) {\n577|\t\t\t\tt.Errorf(\"Resolve() after refused registration = %v, want terminal_backend_not_found\", resolveErr)\n578|\t\t\t}\n579|\t\t})\n580|\t}\n581|}\n582|\n583|// TestRegisterExternalRefusesUnknownKindAsUntrusted pins the guard order at\n584|// the production entry point: a non-external kind (including one outside the\n585|// closed vocabulary) is a trust failure before record validation runs. The\n586|// closed implementation_kind vocabulary in parseKind is therefore unreachable\n587|// through this entry point by construction, and is pinned white-box in\n588|// internal_pin_test.go instead.\n589|func TestRegisterExternalRefusesUnknownKindAsUntrusted(t *testing.T) {\n590|\tt.Parallel()\n591|\n592|\tregistry := testRegistry(t)\n593|\trecord := testExternalRecord(\"com.example.term\")\n594|\trecord.Kind = terminalbackend.Kind(\"bogus_kind\")\n595|\terr := registry.RegisterExternal(scalar.PlatformLinux, testTrustEntry(\"com.example.term\"), record)\n596|\tif !terminalbackend.IsUntrusted(err) {\n597|\t\tt.Fatalf(\"RegisterExternal(bogus kind) error = %v, want terminal_backend_untrusted\", err)\n598|\t}\n599|}\n600|\n601|// TestResolveUnknownIsNeverAbsence proves unknown and malformed identities\n602|// fail closed instead of resolving to a default or an empty record.\n603|func TestResolveUnknownIsNeverAbsence(t *testing.T) {\n604|\tt.Parallel()\n605|\n606|\tregistry := testRegistry(t)\n607|\tfor _, id := range []string{\"com.example.unknown\", \"INVALID_ID\", \"\", \"ax.evil\"} {\n608|\t\tif _, err := registry.Resolve(id); !terminalbackend.IsNotFound(err) {\n609|\t\t\tt.Errorf(\"Resolve(%q) error = %v, want terminal_backend_not_found\", id, err)\n610|\t\t}\n611|\t}\n612|\tvar nilRegistry *terminalbackend.Registry\n613|\tif _, err := nilRegistry.Resolve(terminalbackend.BuiltinTmux); !terminalbackend.IsNotFound(err) {\n614|\t\tt.Errorf(\"nil Resolve() error = %v, want terminal_backend_not_found\", err)\n615|\t}\n616|\tif err := nilRegistry.RegisterExternal(scalar.PlatformLinux, testTrustEntry(\"com.example.term\"), testExternalRecord(\"com.example.term\")); !terminalbackend.IsNotFound(err) {\n617|\t\tt.Errorf(\"nil RegisterExternal() error = %v, want terminal_backend_not_found\", err)\n618|\t}\n619|}\n620|\n621|// TestDefaultForPlatform pins the Section 6.5 platform defaults for new\n622|// activation only: they must never be used as a restore fallback.\n623|func TestDefaultForPlatform(t *testing.T) {\n624|\tt.Parallel()\n625|\n626|\tcases := []struct {\n627|\t\tplatform scalar.Platform\n628|\t\twant     string\n629|\t}{\n630|\t\t{scalar.PlatformMacOS, terminalbackend.BuiltinTmux},\n631|\t\t{scalar.PlatformLinux, terminalbackend.BuiltinTmux},\n632|\t\t{scalar.PlatformWSL2, terminalbackend.BuiltinTmux},\n633|\t\t{scalar.PlatformWindows, terminalbackend.BuiltinConpty},\n634|\t}\n635|\tfor _, testCase := range cases {\n636|\t\tif got, err := terminalbackend.DefaultForPlatform(testCase.platform); err != nil || got != testCase.want {\n637|\t\t\tt.Errorf(\"DefaultForPlatform(%q) = %q, %v; want %q\", testCase.platform, got, err, testCase.want)\n638|\t\t}\n639|\t}\n640|\tif _, err := terminalbackend.DefaultForPlatform(scalar.Platform(\"plan9\")); !terminalbackend.IsNotFound(err) {\n641|\t\tt.Errorf(\"DefaultForPlatform(plan9) error = %v, want terminal_backend_not_found\", err)\n642|\t}\n643|}\n644|\n645|// TestRequireRestoreBinding proves restore uses the exact prior binding: the\n646|// configured default is refused when it differs, and an unregistered bound ID\n647|// cannot activate.\n648|func TestRequireRestoreBinding(t *testing.T) {\n649|\tt.Parallel()\n650|\n651|\tregistry := testRegistry(t)\n652|\tmustRegisterExternal(t, registry, \"com.example.term\")\n653|\n654|\trecord, err := registry.RequireRestoreBinding(\"com.example.term\", \"com.example.term\")\n655|\tif err != nil {\n656|\t\tt.Fatalf(\"RequireRestoreBinding(exact) error = %v\", err)\n657|\t}\n658|\tif record.ID != \"com.example.term\" {\n659|\t\tt.Errorf(\"RequireRestoreBinding(exact) ID = %q, want com.example.term\", record.ID)\n660|\t}\n661|\tif _, err := registry.RequireRestoreBinding(\"com.example.term\", terminalbackend.BuiltinTmux); !terminalbackend.IsRestoreMismatch(err) {\n662|\t\tt.Errorf(\"RequireRestoreBinding(default substitution) error = %v, want terminal_backend_restore_mismatch\", err)\n663|\t}\n664|\tif _, err := registry.RequireRestoreBinding(\"com.example.gone\", \"com.example.gone\"); !terminalbackend.IsNotFound(err) {\n665|\t\tt.Errorf(\"RequireRestoreBinding(unknown) error = %v, want terminal_backend_not_found\", err)\n666|\t}\n667|\tif _, err := registry.RequireRestoreBinding(\"com.example.term\", \"INVALID_ID\"); !terminalbackend.IsNotFound(err) {\n668|\t\tt.Errorf(\"RequireRestoreBinding(malformed candidate) error = %v, want terminal_backend_not_found\", err)\n669|\t}\n670|}\n671|\n672|// TestCheckVersionTuple narrows version admission to membership: the accepted\n673|// protocol must be exactly one list member in major 1.\n674|func TestCheckVersionTuple(t *testing.T) {\n675|\tt.Parallel()\n676|\n677|\tif err := terminalbackend.CheckVersionTuple(\"com.example.term\", \"1.2.3\", \"1.0.0\", []string{\"1.0.0\", \"1.1.0\"}); err != nil {\n678|\t\tt.Errorf(\"CheckVersionTuple(member) error = %v, want admission\", err)\n679|\t}\n680|\tcases := []struct {\n681|\t\tname  string\n682|\t\timpl  string\n683|\t\tproto string\n684|\t\tlist  []string\n685|\t}{\n686|\t\t{\"non-semver implementation\", \"v1\", \"1.0.0\", []string{\"1.0.0\"}},\n687|\t\t{\"protocol major 2\", \"1.2.3\", \"2.0.0\", []string{\"2.0.0\"}},\n688|\t\t{\"protocol not a member\", \"1.2.3\", \"1.1.0\", []string{\"1.0.0\"}},\n689|\t\t{\"protocol major 1 but unlisted\", \"1.2.3\", \"1.0.0\", []string{\"1.1.0\"}},\n690|\t\t{\"non-semver protocol\", \"1.2.3\", \"one\", []string{\"one\"}},\n691|\t\t{\"empty list\", \"1.2.3\", \"1.0.0\", nil},\n692|\t}\n693|\tfor _, testCase := range cases {\n694|\t\tt.Run(testCase.name, func(t *testing.T) {\n695|\t\t\tt.Parallel()\n696|\t\t\terr := terminalbackend.CheckVersionTuple(\"com.example.term\", testCase.impl, testCase.proto, testCase.list)\n697|\t\t\tif !terminalbackend.IsDrift(err) {\n698|\t\t\t\tt.Errorf(\"CheckVersionTuple() error = %v, want terminal_backend_implementation_drift\", err)\n699|\t\t\t}\n700|\t\t})\n701|\t}\n702|}\n703|\n704|// TestCheckProviderDescriptor drives the Section 7.A production rule: the\n705|// provider rejects a descriptor that does not match the validated binding.\n706|func TestCheckProviderDescriptor(t *testing.T) {\n707|\tt.Parallel()\n708|\n709|\tbinding := terminalbackend.InstanceBinding{\n710|\t\tBackendID:             \"com.example.term\",\n711|\t\tImplementationVersion: \"1.2.3\",\n712|\t\tProtocolVersion:       \"1.0.0\",\n713|\t\tGeneration:            \"generation-1\",\n714|\t}\n715|\tif err := terminalbackend.CheckProviderDescriptor(binding, binding); err != nil {\n716|\t\tt.Errorf(\"CheckProviderDescriptor(match) error = %v, want admission\", err)\n717|\t}\n718|\n719|\tversionDrift := binding\n720|\tversionDrift.ImplementationVersion = \"1.2.4\"\n721|\tif err := terminalbackend.CheckProviderDescriptor(versionDrift, binding); !terminalbackend.IsDrift(err) {\n722|\t\tt.Errorf(\"CheckProviderDescriptor(version drift) error = %v, want terminal_backend_implementation_drift\", err)\n723|\t}\n724|\tprotoDrift := binding\n725|\tprotoDrift.ProtocolVersion = \"1.1.0\"\n726|\tif err := terminalbackend.CheckProviderDescriptor(protoDrift, binding); !terminalbackend.IsDrift(err) {\n727|\t\tt.Errorf(\"CheckProviderDescriptor(protocol drift) error = %v, want terminal_backend_implementation_drift\", err)\n728|\t}\n729|\tidMismatch := binding\n730|\tidMismatch.BackendID = \"com.example.other\"\n731|\tif err := terminalbackend.CheckProviderDescriptor(idMismatch, binding); !terminalbackend.IsNotFound(err) {\n732|\t\tt.Errorf(\"CheckProviderDescriptor(ID mismatch) error = %v, want terminal_backend_not_found\", err)\n733|\t}\n734|\t// The stale-generation arm lives in TestCheckProviderDescriptorGenerationMismatch.\n735|}\n736|\n737|// TestCheckProviderDescriptorGenerationBounds proves the Section 7.A\n738|// string[1..256] bound itself, not the generation mismatch: every refusal\n739|// case carries the SAME generation on both sides, so the mismatch comparison\n740|// cannot fire and only the bound can refuse. (Pitting a mutated generation\n741|// against a fixed one proves nothing about the bound — the inequality alone\n742|// returns terminal_backend_stale_generation.)\n743|func TestCheckProviderDescriptorGenerationBounds(t *testing.T) {\n744|\tt.Parallel()\n745|\n746|\twithGeneration := func(generation string) terminalbackend.InstanceBinding {\n747|\t\treturn terminalbackend.InstanceBinding{\n748|\t\t\tBackendID:             \"com.example.term\",\n749|\t\t\tImplementationVersion: \"1.2.3\",\n750|\t\t\tProtocolVersion:       \"1.0.0\",\n751|\t\t\tGeneration:            generation,\n752|\t\t}\n753|\t}\n754|\tadmitted := []struct {\n755|\t\tname       string\n756|\t\tgeneration string\n757|\t}{\n758|\t\t{\"one byte\", \"g\"},\n759|\t\t{\"256 bytes\", strings.Repeat(\"g\", 256)},\n760|\t}\n761|\tfor _, testCase := range admitted {\n762|\t\tt.Run(testCase.name, func(t *testing.T) {\n763|\t\t\tt.Parallel()\n764|\t\t\tbinding := withGeneration(testCase.generation)\n765|\t\t\tif err := terminalbackend.CheckProviderDescriptor(binding, binding); err != nil {\n766|\t\t\t\tt.Errorf(\"CheckProviderDescriptor(%d-byte generation, equal) error = %v, want admission\",\n767|\t\t\t\t\tlen(testCase.generation), err)\n768|\t\t\t}\n769|\t\t})\n770|\t}\n771|\trefused := []struct {\n772|\t\tname       string\n773|\t\tgeneration string\n774|\t}{\n775|\t\t{\"empty\", \"\"},\n776|\t\t{\"257 bytes\", strings.Repeat(\"g\", 257)},\n777|\t}\n778|\tfor _, testCase := range refused {\n779|\t\tt.Run(testCase.name, func(t *testing.T) {\n780|\t\t\tt.Parallel()\n781|\t\t\tbinding := withGeneration(testCase.generation)\n782|\t\t\terr := terminalbackend.CheckProviderDescriptor(binding, binding)\n783|\t\t\tif !terminalbackend.IsStaleGeneration(err) {\n784|\t\t\t\tt.Errorf(\"CheckProviderDescriptor(%d-byte generation, equal) error = %v, want terminal_backend_stale_generation\",\n785|\t\t\t\t\tlen(testCase.generation), err)\n786|\t\t\t}\n787|\t\t})\n788|\t}\n789|}\n790|\n791|// TestCheckProviderDescriptorGenerationMismatch keeps the mismatch arm pinned\n792|// separately: differing valid generations refuse even though each side is\n793|// within the bound.\n794|func TestCheckProviderDescriptorGenerationMismatch(t *testing.T) {\n795|\tt.Parallel()\n796|\n797|\tbinding := terminalbackend.InstanceBinding{\n798|\t\tBackendID:             \"com.example.term\",\n799|\t\tImplementationVersion: \"1.2.3\",\n800|\t\tProtocolVersion:       \"1.0.0\",\n801|\t\tGeneration:            \"generation-1\",\n802|\t}\n803|\tstale := binding\n804|\tstale.Generation = \"generation-2\"\n805|\tif err := terminalbackend.CheckProviderDescriptor(stale, binding); !terminalbackend.IsStaleGeneration(err) {\n806|\t\tt.Errorf(\"CheckProviderDescriptor(stale generation) error = %v, want terminal_backend_stale_generation\", err)\n807|\t}\n808|}\n809|\n810|// TestDigestFile binds trust to bytes: the digest of a real file verifies,\n811|// symlinks resolve to their target, and non-files or missing paths fail\n812|// without producing a digest.\n813|func TestDigestFile(t *testing.T) {\n814|\tt.Parallel()\n815|\n816|\tpayload := []byte(\"#!/bin/sh\\nexec ax-backend-term \\\"$@\\\"\\n\")\n817|\tpath := filepath.Join(t.TempDir(), \"ax-backend-term\")\n818|\tif err := os.WriteFile(path, payload, 0o755); err != nil {\n819|\t\tt.Fatalf(\"WriteFile() error = %v\", err)\n820|\t}\n821|\tsum := sha256.Sum256(payload)\n822|\twant := \"sha256:\" + hex.EncodeToString(sum[:])\n823|\tgot, err := terminalbackend.DigestFile(path)\n824|\tif err != nil {\n825|\t\tt.Fatalf(\"DigestFile() error = %v\", err)\n826|\t}\n827|\tif got != want {\n828|\t\tt.Errorf(\"DigestFile() = %q, want %q\", got, want)\n829|\t}\n830|\tlink := filepath.Join(t.TempDir(), \"link-backend-term\")\n831|\tif err := os.Symlink(path, link); err != nil {\n832|\t\tt.Fatalf(\"Symlink() error = %v\", err)\n833|\t}\n834|\tgotLink, err := terminalbackend.DigestFile(link)\n835|\tif err != nil {\n836|\t\tt.Fatalf(\"DigestFile(symlink) error = %v\", err)\n837|\t}\n838|\tif gotLink != want {\n839|\t\tt.Errorf(\"DigestFile(symlink) = %q, want %q\", gotLink, want)\n840|\t}\n841|\tif _, err := terminalbackend.DigestFile(filepath.Join(t.TempDir(), \"absent\")); err == nil {\n842|\t\tt.Error(\"DigestFile(absent) error = nil, want a failed read\")\n843|\t}\n844|\tif _, err := terminalbackend.DigestFile(t.TempDir()); err == nil {\n845|\t\tt.Error(\"DigestFile(directory) error = nil, want refusal for a non-regular file\")\n846|\t}\n847|\t// A FIFO pins the regular-file guard itself: the directory case above\n848|\t// would still fail with the guard removed, because os.ReadFile rejects\n849|\t// directories (EISDIR) on its own. A FIFO is the documented hazard\n850|\t// (README: os.Open blocks indefinitely on a FIFO), and only the\n851|\t// Mode().IsRegular check refuses it without blocking.\n852|\tfifo := filepath.Join(t.TempDir(), \"backend-fifo\")\n853|\tif err := syscall.Mkfifo(fifo, 0o600); err != nil {\n854|\t\tt.Fatalf(\"Mkfifo() error = %v\", err)\n855|\t}\n856|\tif _, err := terminalbackend.DigestFile(fifo); err == nil {\n857|\t\tt.Error(\"DigestFile(fifo) error = nil, want refusal for a non-regular file\")\n858|\t}\n859|}\n860|\n861|// TestErrorPredicatesAreExclusive guards the negative-evidence contract: a\n862|// refusal carries exactly one wire code, so a passing negative test cannot be\n863|// explained by overlapping predicates.\n864|func TestErrorPredicatesAreExclusive(t *testing.T) {\n865|\tt.Parallel()\n866|\n867|\tregistry := testRegistry(t)\n868|\tmustRegisterExternal(t, registry, \"com.example.term\")\n869|\n870|\tcases := []struct {\n871|\t\tname string\n872|\t\terr  error\n873|\t\twant func(error) bool\n874|\t}{\n875|\t\t{\"unknown\", func() error { _, err := registry.Resolve(\"com.example.gone\"); return err }(), terminalbackend.IsNotFound},\n876|\t\t{\"duplicate\", func() error {\n877|\t\t\treturn registry.RegisterExternal(scalar.PlatformLinux, testTrustEntry(\"com.example.term\"), testExternalRecord(\"com.example.term\"))\n878|\t\t}(), terminalbackend.IsAmbiguous},\n879|\t\t{\"drift\", func() error {\n880|\t\t\tdrifted := testExternalRecord(\"com.example.term\")\n881|\t\t\tdrifted.ImplementationVersion = \"9.9.9\"\n882|\t\t\treturn registry.RegisterExternal(scalar.PlatformLinux, testTrustEntry(\"com.example.term\"), drifted)\n883|\t\t}(), terminalbackend.IsDrift},\n884|\t\t{\"untrusted\", func() error {\n885|\t\t\tentry := testTrustEntry(\"com.example.fresh\")\n886|\t\t\tentry.Enabled = false\n887|\t\t\treturn registry.RegisterExternal(scalar.PlatformLinux, entry, testExternalRecord(\"com.example.fresh\"))\n888|\t\t}(), terminalbackend.IsUntrusted},\n889|\t\t{\"restore mismatch\", func() error {\n890|\t\t\t_, err := registry.RequireRestoreBinding(\"com.example.term\", terminalbackend.BuiltinTmux)\n891|\t\t\treturn err\n892|\t\t}(), terminalbackend.IsRestoreMismatch},\n893|\t\t{\"stale generation\", func() error {\n894|\t\t\tbinding := terminalbackend.InstanceBinding{BackendID: \"com.example.term\", ImplementationVersion: \"1.2.3\", ProtocolVersion: \"1.0.0\", Generation: \"a\"}\n895|\t\t\tstale := binding\n896|\t\t\tstale.Generation = \"b\"\n897|\t\t\treturn terminalbackend.CheckProviderDescriptor(stale, binding)\n898|\t\t}(), terminalbackend.IsStaleGeneration},\n899|\t}\n900|\tpredicates := map[string]func(error) bool{\n901|\t\t\"not found\": terminalbackend.IsNotFound, \"ambiguous\": terminalbackend.IsAmbiguous,\n902|\t\t\"untrusted\": terminalbackend.IsUntrusted, \"drift\": terminalbackend.IsDrift,\n903|\t\t\"restore mismatch\": terminalbackend.IsRestoreMismatch, \"stale\": terminalbackend.IsStaleGeneration,\n904|\t}\n905|\tfor _, testCase := range cases {\n906|\t\tt.Run(testCase.name, func(t *testing.T) {\n907|\t\t\tt.Parallel()\n908|\t\t\tif testCase.err == nil {\n909|\t\t\t\tt.Fatalf(\"expected a refusal, got nil\")\n910|\t\t\t}\n911|\t\t\tmatched := 0\n912|\t\t\tfor name, predicate := range predicates {\n913|\t\t\t\tif predicate(testCase.err) {\n914|\t\t\t\t\tmatched++\n915|\t\t\t\t\tif !testCase.want(testCase.err) {\n916|\t\t\t\t\t\tt.Errorf(\"refusal %v unexpectedly matches %q\", testCase.err, name)\n917|\t\t\t\t\t}\n918|\t\t\t\t}\n919|\t\t\t}\n920|\t\t\tif matched != 1 {\n921|\t\t\t\tt.Errorf(\"refusal %v matches %d predicates, want exactly 1\", testCase.err, matched)\n922|\t\t\t}\n923|\t\t})\n924|\t}\n925|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
