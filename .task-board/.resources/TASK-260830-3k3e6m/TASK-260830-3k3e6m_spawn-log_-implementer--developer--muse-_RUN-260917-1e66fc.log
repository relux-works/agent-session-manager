{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d563","stream":{"kind":"session","id":"01a0adcc-09d6-79d1-9b97-6e93479b8dc1"},"sequence":2316,"recorded_at":1780531400004627,"record_type":"event","durability":"durable","causation_id":"410e85d5-c650-4a55-ae65-44f1be1f0a3d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"410e85d5-c650-4a55-ae65-44f1be1f0a3d","run_stream":{"kind":"run","id":"410e85d5-c650-4a55-ae65-44f1be1f0a3d"},"task_stream":{"kind":"task","id":"01a0addb-8d82-7f41-8559-11e97ec51ed5"},"task_id":"01a0addb-8d82-7f41-8559-11e97ec51ed5","event":{"kind":"output","task_id":"01a0addb-8d82-7f41-8559-11e97ec51ed5","chunk":"edited\nchanged lines: lines 594-605\n--- original\n+++ updated\n@@\n-\tif journal.Phase == PhaseCommitting && assessment.commitProvable() {\n-\t\tif journal.TaskBoard != nil && journal.TaskBoard.State == BoardOpened &&\n-\t\t\tjournal.TaskBoard.ActivationMode == ModeDormantReplica && assessment.dormantProvable() {\n-\t\t\tif err := assessment.applyDormantFinalize(); err != nil {\n-\t\t\t\treturn true, \"\", Evidence{}, err\n-\t\t\t}\n-\t\t}\n-\t\tif err := assessment.applyCommit(); err != nil {\n-\t\t\treturn true, \"\", Evidence{}, err\n-\t\t}\n-\t\treturn true, assessment.completeSafeRetry(\"committing journal completed to committed on exact status plus destination evidence\")\n-\t}\n+\tif journal.Phase == PhaseCommitting {\n+\t\tprovable, contradictory := assessment.commitProvable()\n+\t\tif contradictory {\n+\t\t\treturn true, assessment.park(\"integrity_failure\", \"destination marker evidence contradicts the valid-match probe\",\n+\t\t\t\t\"reconcile the marker bytes against the journal and plan, then re-run recovery\")\n+\t\t}\n+\t\tif provable {\n+\t\t\tif journal.TaskBoard != nil && journal.TaskBoard.State == BoardOpened &&\n+\t\t\t\tjournal.TaskBoard.ActivationMode == ModeDormantReplica && assessment.dormantProvable() {\n+\t\t\t\tif err := assessment.apply