{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb49","stream":{"kind":"session","id":"01a0adcc-09d6-79d1-9b97-6e93479b8dc1"},"sequence":1023,"recorded_at":1780531400002041,"record_type":"event","durability":"durable","causation_id":"410e85d5-c650-4a55-ae65-44f1be1f0a3d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"410e85d5-c650-4a55-ae65-44f1be1f0a3d","run_stream":{"kind":"run","id":"410e85d5-c650-4a55-ae65-44f1be1f0a3d"},"task_stream":{"kind":"task","id":"01a0adcf-137c-7300-a512-3ebecbc0aded"},"task_id":"01a0adcf-137c-7300-a512-3ebecbc0aded","event":{"kind":"output","task_id":"01a0adcf-137c-7300-a512-3ebecbc0aded","chunk":"Read text file `internal/sessckpt/crash_test.go`.\n1|package sessckpt\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/secconftest\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n11|)\n12|\n13|// wireCrashPoints connects a store's write boundaries to the\n14|// owner's crash injector: BeforeWrite fires PointPrepareEnter\n15|// (before any durable byte) with the safe_retry outcome. The\n16|// interior and post-commit boundaries return plain test faults:\n17|// their recovery is proved by the store's own replay semantics\n18|// below, not by borrowing a mismatched injector label.\n19|func wireCrashPoints(store *Store, injector *secconftest.Injector) {\n20|\tstore.BeforeWrite = func() error {\n21|\t\treturn injector.MaybeFail(secconftest.PointPrepareEnter)\n22|\t}\n23|}\n24|\n25|// mustCrashFault fails unless err is the injected fault for the\n26|// armed point carrying the expected outcome.\n27|func mustCrashFault(t *testing.T, err error, point string, outcome secconftest.Outcome, what string) {\n28|\tt.Helper()\n29|\tif err == nil {\n30|\t\tt.Fatalf(\"%s error = nil, want injected fault at %s\", what, point)\n31|\t}\n32|\tvar fault *secconftest.Fault\n33|\tif !errors.As(err, &fault) {\n34|\t\tt.Fatalf(\"%s error = %v, want *secconftest.Fault\", what, err)\n35|\t}\n36|\tif fault.Point() != point {\n37|\t\tt.Fatalf(\"%s point = %q, want %q\", what, fault.Point(), point)\n38|\t}\n39|\tif fault.Outcome() != outcome {\n40|\t\tt.Fatalf(\"%s outcome = %q, want %q\", what, fault.Outcome(), outcome)\n41|\t}\n42|}\n43|\n44|// countFiles counts installed blobs and receipts.\n45|func countFiles(t *testing.T, store *Store) (blobs, receipts int) {\n46|\tt.Helper()\n47|\tentries, err := os.ReadDir(store.root)\n48|\tif err != nil {\n49|\t\tt.Fatal(err)\n50|\t}\n51|\tfor _, entry := range entries {\n52|\t\tif !entry.IsDir() {\n53|\t\t\tblobs++\n54|\t\t}\n55|\t}\n56|\treceiptsEntries, err := os.ReadDir(filepath.Join(store.root, \"operations\"))\n57|\tif err != nil {\n58|\t\tt.Fatal(err)\n59|\t}\n60|\treturn blobs, len(receiptsEntries)\n61|}\n62|\n63|// everyFileVerifies fails when any installed blob does not attest\n64|// through the canonical owner: an interrupted capture must leave\n65|// no partial record behind.\n66|func everyFileVerifies(t *testing.T, store *Store) {\n67|\tt.Helper()\n68|\tentries, err := os.ReadDir(store.root)\n69|\tif err != nil {\n70|\t\tt.Fatal(err)\n71|\t}\n72|\tfor _, entry := range entries {\n73|\t\tif entry.IsDir() {\n74|\t\t\tcontinue\n75|\t\t}\n76|\t\traw, err := os.ReadFile(filepath.Join(store.root, entry.Name()))\n77|\t\tif err != nil {\n78|\t\t\tt.Fatal(err)\n79|\t\t}\n80|\t\tif _, _, err := sessrepo.AttestCheckpointRecord(raw); err != nil {\n81|\t\t\tt.Fatalf(\"installed file %s does not attest: %v\", entry.Name(), err)\n82|\t\t}\n83|\t}\n84|}\n85|\n86|func TestCrashBeforeDurableWriteIsSafeRetry(t *testing.T) {\n87|\tchain, created := chainFixture(t)\n88|\tstore := openTestStore(t)\n89|\tinjector := &secconftest.Injector{}\n90|\twireCrashPoints(store, injector)\n91|\tinjector.Arm(secconftest.PointPrepareEnter)\n92|\t_, _, err := store.Capture(chain, testInputs([]string{created}, testOpA))\n93|\tmustCrashFault(t, err, secconftest.PointPrepareEnter, secconftest.OutcomeSafeRetry, \"Capture(prepare fault)\")\n94|\t// Nothing mutated: no blob and no receipt exist.\n95|\tif blobs, receipts := countFiles(t, store); blobs != 0 || receipts != 0 {\n96|\t\tt.Fatalf(\"after prepare fault: blobs = %d, receipts = %d, want 0, 0\", blobs, receipts)\n97|\t}\n98|\t// The identical retry is safe and succeeds.\n99|\tinjector.Disarm()\n100|\tref, raw, err := store.Capture(chain, testInputs([]string{created}, testOpA))\n101|\tif err != nil {\n102|\t\tt.Fatalf(\"retry Capture error = %v\", err)\n103|\t}\n104|\tif _, _, err := sessrepo.AttestCheckpointRecord(raw); err != nil {\n105|\t\tt.Fatalf(\"retry bytes do not attest: %v\", err)\n106|\t}\n107|\tif ref.OperationID != testOpA {\n108|\t\tt.Fatalf(\"retry OperationID = %q\", ref.OperationID)\n109|\t}\n110|}\n111|\n112|func TestCrashBetweenBlobAndReceiptResumes(t *testing.T) {\n113|\tchain, created := chainFixture(t)\n114|\tstore := openTestStore(t)\n115|\tinterrupted := errors.New(\"crash after blob before receipt\")\n116|\tstore.AfterBlob = func() error { return interrupted }\n117|\t_, _, err := store.Capture(chain, testInputs([]string{created}, testOpA))\n118|\tif !errors.Is(err, interrupted) {\n119|\t\tt.Fatalf(\"Capture(blob fault) = %v, want the interior fault\", err)\n120|\t}\n121|\t// The blob is complete and verifies (never a torn prefix),\n122|\t// but no receipt exists, so the operation never committed.\n123|\tif blobs, receipts := countFiles(t, store); blobs != 1 || receipts != 0 {\n124|\t\tt.Fatalf(\"after blob fault: blobs = %d, receipts = %d, want 1, 0\", blobs, receipts)\n125|\t}\n126|\teveryFileVerifies(t, store)\n127|\t// The identical retry reuses the installed bytes, completes\n128|\t// the receipt, and mints no second checkpoint identity.\n129|\tstore.AfterBlob = nil\n130|\tref, _, err := store.Capture(chain, testInputs([]string{created}, testOpA))\n131|\tif err != nil {\n132|\t\tt.Fatalf(\"retry Capture error = %v\", err)\n133|\t}\n134|\tif blobs, receipts := countFiles(t, store); blobs != 1 || receipts != 1 {\n135|\t\tt.Fatalf(\"after retry: blobs = %d, receipts = %d, want 1, 1\", blobs, receipts)\n136|\t}\n137|\tagain, _, err := store.Capture(chain, testInputs([]string{created}, testOpA))\n138|\tif err != nil {\n139|\t\tt.Fatalf(\"replay Capture error = %v\", err)\n140|\t}\n141|\tif again != ref {\n142|\t\tt.Fatalf(\"replay ref = %+v, want %+v\", again, ref)\n143|\t}\n144|}\n145|\n146|func TestCrashAfterReceiptReplaysRecordedResult(t *testing.T) {\n147|\tchain, created := chainFixture(t)\n148|\tstore := openTestStore(t)\n149|\tcommitted := errors.New(\"crash after receipt before return\")\n150|\tstore.AfterCommit = func() error { return committed }\n151|\t_, _, err := store.Capture(chain, testInputs([]string{created}, testOpA))\n152|\tif !errors.Is(err, committed) {\n153|\t\tt.Fatalf(\"Capture(commit fault) = %v, want the post-commit fault\", err)\n154|\t}\n155|\t// Blob and receipt are both durable: the operation committed\n156|\t// even though the caller never saw the result.\n157|\tif blobs, receipts := countFiles(t, store); blobs != 1 || receipts != 1 {\n158|\t\tt.Fatalf(\"after commit fault: blobs = %d, receipts = %d, want 1, 1\", blobs, receipts)\n159|\t}\n160|\teveryFileVerifies(t, store)\n161|\t// The identical retry returns the recorded result without\n162|\t// writing: safe_retry through the receipt replay.\n163|\tstore.AfterCommit = nil\n164|\tfirst, firstRaw, err := store.Capture(chain, testInputs([]string{created}, testOpA))\n165|\tif err != nil {\n166|\t\tt.Fatalf(\"retry Capture error = %v\", err)\n167|\t}\n168|\tsecond, secondRaw, err := store.Capture(chain, testInputs([]string{created}, testOpA))\n169|\tif err != nil {\n170|\t\tt.Fatalf(\"replay Capture error = %v\", err)\n171|\t}\n172|\tif first != second || string(firstRaw) != string(secondRaw) {\n173|\t\tt.Fatalf(\"receipt replay diverged: %+v vs %+v\", first, second)\n174|\t}\n175|\tif blobs, receipts := countFiles(t, store); blobs != 1 || receipts != 1 {\n176|\t\tt.Fatalf(\"after replay: blobs = %d, receipts = %d, want 1, 1\", blobs, receipts)\n177|\t}\n178|}\n179|\n180|func TestCaptureWithMovedInputsRefuses(t *testing.T) {\n181|\tchain, created := chainFixture(t)\n182|\tstore := openTestStore(t)\n183|\tif _, _, err := store.Capture(chain, testInputs([]string{created}, testOpA)); err != nil {\n184|\t\tt.Fatal(err)\n185|\t}\n186|\t// The same operation retried with moved inputs refuses\n187|\t// idempotency_mismatch and writes nothing: no second root is\n188|\t// created for a changed body.\n189|\tmoved := testInputs([]string{created}, testOpA)\n190|\tmoved.WorkspaceManifestID = testOtherManifest\n191|\t_, _, err := store.Capture(chain, moved)\n192|\tif !errors.Is(err, ErrCheckpointConflict) {\n193|\t\tt.Fatalf(\"Capture(moved inputs) = %v, want ErrCheckpointConflict\", err)\n194|\t}\n195|\tif errors.Is(err, ErrInvalidCheckpoint) {\n196|\t\tt.Fatalf(\"Capture(moved inputs) = %v, want the conflict class, not the invalid-closure class\", err)\n197|\t}\n198|\tif blobs, receipts := countFiles(t, store); blobs != 1 || receipts != 1 {\n199|\t\tt.Fatalf(\"after refused retry: blobs = %d, receipts = %d, want 1, 1\", blobs, receipts)\n200|\t}\n201|\t// The same moved closure under a fresh operation is a new\n202|\t// capture, not a conflict.\n203|\tmoved.OperationID = testOpB\n204|\tif _, _, err := store.Capture(chain, moved); err != nil {\n205|\t\tt.Fatalf(\"Capture(moved inputs, fresh operation) error = %v\", err)\n206|\t}\n207|\tif blobs, receipts := countFiles(t, store); blobs != 2 || receipts != 2 {\n208|\t\tt.Fatalf(\"after fresh capture: blobs = %d, receipts = %d, want 2, 2\", blobs, receipts)\n209|\t}\n210|}\n211|\n212|func TestCaptureRefusesDisagreeingDigestPath(t *testing.T) {\n213|\tchain, created := chainFixture(t)\n214|\tstore := openTestStore(t)\n215|\tref, _ := mustCapture(t, store, chain, testInputs([]string{created}, testOpA))\n216|\t// Foreign bytes at the digest path: the store is torn, so the\n217|\t// identical-bytes install must refuse instead of versioning\n218|\t// an immutable record.\n219|\tif err := os.WriteFile(store.blobPath(ref.CheckpointID), []byte(`\"foreign\"`), 0o600); err != nil {\n220|\t\tt.Fatal(err)\n221|\t}\n222|\t_, _, err := store.Capture(chain, testInputs([]string{created}, testOpB))\n223|\tif !errors.Is(err, ErrCheckpointConflict) {\n224|\t\tt.Fatalf(\"Capture(disagreeing path) = %v, want ErrCheckpointConflict\", err)\n225|\t}\n226|}","final_result":true}}}
