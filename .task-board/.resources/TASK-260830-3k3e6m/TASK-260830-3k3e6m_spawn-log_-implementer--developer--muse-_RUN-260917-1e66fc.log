{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c85d","stream":{"kind":"session","id":"01a0adcc-09d6-79d1-9b97-6e93479b8dc1"},"sequence":649,"recorded_at":1780531400001293,"record_type":"event","durability":"durable","causation_id":"410e85d5-c650-4a55-ae65-44f1be1f0a3d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"410e85d5-c650-4a55-ae65-44f1be1f0a3d","run_stream":{"kind":"run","id":"410e85d5-c650-4a55-ae65-44f1be1f0a3d"},"task_stream":{"kind":"task","id":"01a0adcd-a5fd-72c0-918f-4ed82e858f98"},"task_id":"01a0adcd-a5fd-72c0-918f-4ed82e858f98","event":{"kind":"output","task_id":"01a0adcd-a5fd-72c0-918f-4ed82e858f98","chunk":"Read text file `internal/sessckpt/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for internal/sessckpt (TASK-260830-14yo67).\n3|\n4|Each plant weakens exactly one production gate so it admits one\n5|member of the class the gate must reject; the named killer test\n6|must then FAIL (mutant KILLED). A delete-only mutant proves only\n7|that the gate exists and is never accepted as evidence, so every\n8|plant here preserves the gate and narrows it. The evidence-enum\n9|plant additionally preserves every searched-for token while\n10|changing behavior.\n11|\n12|One harmless SURVIVED control (a comment-only edit) proves the\n13|harness reports survival instead of silently passing.\n14|\n15|Usage (from the repository root):\n16|\n17|    PYTHONDONTWRITEBYTECODE=1 python3 internal/sessckpt/mutant_harness.py \\\n18|        --log-dir .temp/TASK-260830-14yo67/mutants\n19|\n20|For every plant the harness writes the raw per-plant subprocess\n21|log to <log-dir>/<name>.log (command, return code, full output)\n22|plus <log-dir>/summary.json. A plant whose anchor occurs zero or\n23|multiple times is reported NOT_APPLIED; a plant that breaks the\n24|build or matches no test is reported COMPILE_OR_HARNESS_FAILURE.\n25|Both stay outside the killed numerator. The process exits nonzero\n26|unless every killed-expectation is KILLED and every\n27|survived-expectation SURVIVED.\n28|\"\"\"\n29|\n30|import argparse\n31|import json\n32|import os\n33|import subprocess\n34|import sys\n35|\n36|PACKAGE = \"./internal/sessckpt/\"\n37|\n38|PLANTS = [\n39|    {\n40|        \"name\": \"N-bg-idle\",\n41|        \"gate\": \"quiescence (safe_boundary.background_idle)\",\n42|        \"file\": \"internal/sessckpt/capture.go\",\n43|        \"old\": \"\\tif !boundary.BackgroundIdle {\",\n44|        \"new\": \"\\tif !boundary.BackgroundIdle && boundary.OpenProcesses != 0 {\",\n45|        \"run\": \"TestCaptureRefusesNonQuiescentBoundary/cp_n1_background_idle_false\",\n46|        \"expect\": \"killed\",\n47|    },\n48|    {\n49|        \"name\": \"N-both-present\",\n50|        \"gate\": \"variant presence (exactly one persistence leg)\",\n51|        \"file\": \"internal/sessckpt/capture.go\",\n52|        \"old\": \"\\tif hasProvider == hasBoard {\",\n53|        \"new\": \"\\tif !hasProvider && !hasBoard {\",\n54|        \"run\": \"TestCaptureRefusesBadPersistenceVariant/cp_n3_both_present\",\n55|        \"expect\": \"killed\",\n56|    },\n57|    {\n58|        \"name\": \"N-swapped-direct\",\n59|        \"gate\": \"kind-selected variant (direct takes provider)\",\n60|        \"file\": \"internal/sessckpt/capture.go\",\n61|        \"old\": \"\\t\\tif !hasProvider || hasBoard {\",\n62|        \"new\": \"\\t\\tif !hasProvider && !hasBoard {\",\n63|        \"run\": \"TestCaptureRefusesBadPersistenceVariant/swapped_direct_takes_bundle\",\n64|        \"expect\": \"killed\",\n65|    },\n66|    {\n67|        \"name\": \"N-duplicate-heads\",\n68|        \"gate\": \"event-head sorted-unique order\",\n69|        \"file\": \"internal/sessckpt/capture.go\",\n70|        \"old\": \"\\t\\tif len(out) > 0 && name <= previous {\",\n71|        \"new\": \"\\t\\tif len(out) > 0 && name < previous {\",\n72|        \"run\": \"TestCaptureRefusesMalformedHeads/duplicated\",\n73|        \"expect\": \"killed\",\n74|    },\n75|    {\n76|        \"name\": \"N-later-epoch-head\",\n77|        \"gate\": \"event-head at-or-before owning lease (epoch arm)\",\n78|        \"file\": \"internal/sessckpt/capture.go\",\n79|        \"old\": \"\\t\\tif summary.LeaseEpoch > inputs.LeaseEpoch {\",\n80|        \"new\": \"\\t\\tif summary.LeaseEpoch > inputs.LeaseEpoch+1 {\",\n81|        \"run\": \"TestCaptureRefusesLaterLeaseHead\",\n82|        \"expect\": \"killed\",\n83|    },\n84|    {\n85|        \"name\": \"N-idempotency-session\",\n86|        \"gate\": \"same-operation moved-inputs conflict\",\n87|        \"file\": \"internal/sessckpt/capture.go\",\n88|        \"old\": (\n89|            \"\\t\\tif recorded.InputDigest != inputDigest {\\n\"\n90|            '\\t\\t\\treturn CheckpointRef{}, nil, fmt.Errorf(\"%w: operation %s captured different inputs (idempotency_mismatch)\",\\n'\n91|        ),\n92|        \"new\": (\n93|            \"\\t\\tif recorded.InputDigest != inputDigest && recorded.SessionID != session {\\n\"\n94|            '\\t\\t\\treturn CheckpointRef{}, nil, fmt.Errorf(\"%w: operation %s captured different inputs (idempotency_mismatch)\",\\n'\n95|        ),\n96|        \"run\": \"TestCaptureWithMovedInputsRefuses\",\n97|        \"expect\": \"killed\",\n98|    },\n99|    {\n100|        \"name\": \"N-evidence-enum\",\n101|        \"gate\": \"safe_boundary evidence closed enum (token-preserving)\",\n102|        \"file\": \"internal/sessckpt/capture.go\",\n103|        \"old\": \"\\tcase EvidenceProviderAPI, EvidenceProviderEvent, EvidenceManagedPTY, EvidenceTaskBoardBridge, EvidenceAcceptedTest:\",\n104|        \"new\": '\\tcase EvidenceProviderAPI, EvidenceProviderEvent, EvidenceManagedPTY, EvidenceTaskBoardBridge, EvidenceAcceptedTest, \"provider_gossip\":',\n105|        \"run\": \"TestCaptureRefusesMalformedClosureMembers/bad_evidence\",\n106|        \"expect\": \"killed\",\n107|    },\n108|    {\n109|        \"name\": \"C-harmless-comment\",\n110|        \"gate\": \"control: comment-only edit, behavior unchanged\",\n111|        \"file\": \"internal/sessckpt/doc.go\",\n112|        \"old\": \"// Authority: relux-works/agent-session-manager-spec@v0.6.0, Sections 5.4\",\n113|        \"new\": \"// Authority: relux-works/agent-session-manager-spec@v0.6.0; Sections 5.4\",\n114|        \"run\": \"TestCaptureDirectInstallsAttestedRecord\",\n115|        \"expect\": \"survived\",\n116|    },\n117|]\n118|\n119|\n120|def run_plant(root, log_dir, plant):\n121|    path = os.path.join(root, plant[\"file\"])\n122|    with open(path, \"r\", encoding=\"utf-8\") as handle:\n123|        original = handle.read()\n124|    occurrences = original.count(plant[\"old\"])\n125|    record = {\n126|        \"name\": plant[\"name\"],\n127|        \"gate\": plant[\"gate\"],\n128|        \"file\": plant[\"file\"],\n129|        \"run\": plant[\"run\"],\n130|        \"expect\": plant[\"expect\"],\n131|    }\n132|    log_path = os.path.join(log_dir, plant[\"name\"] + \".log\")\n133|    if occurrences != 1:\n134|        record[\"verdict\"] = \"NOT_APPLIED\"\n135|        record[\"detail\"] = \"anchor occurs %d times, want exactly 1\" % occurrences\n136|        with open(log_path, \"w\", encoding=\"utf-8\") as handle:\n137|            handle.write(\"NOT_APPLIED: %s\\n\" % record[\"detail\"])\n138|        return record\n139|    mutated = original.replace(plant[\"old\"], plant[\"new\"], 1)\n140|    with open(path, \"w\", encoding=\"utf-8\") as handle:\n141|        handle.write(mutated)\n142|    try:\n143|        command = [\"go\", \"test\", PACKAGE, \"-run\", plant[\"run\"], \"-count=1\"]\n144|        completed = subprocess.run(\n145|            command,\n146|            cwd=root,\n147|            stdout=subprocess.PIPE,\n148|            stderr=subprocess.STDOUT,\n149|            text=True,\n150|            timeout=300,\n151|        )\n152|        output = completed.stdout\n153|        with open(log_path, \"w\", encoding=\"utf-8\") as handle:\n154|            handle.write(\"$ %s\\n\" % \" \".join(command))\n155|            handle.write(\"returncode: %d\\n\" % completed.returncode)\n156|            handle.write(output)\n157|        record[\"returncode\"] = completed.returncode\n158|        record[\"log\"] = log_path\n159|        if \"no tests to run\" in output or \"no test files\" in output:\n160|            record[\"verdict\"] = \"COMPILE_OR_HARNESS_FAILURE\"\n161|            record[\"detail\"] = \"killer matched no test\"\n162|        elif \"build failed\" in output:\n163|            record[\"verdict\"] = \"COMPILE_OR_HARNESS_FAILURE\"\n164|            record[\"detail\"] = \"plant broke compilation\"\n165|        elif completed.returncode != 0:\n166|            record[\"verdict\"] = \"KILLED\"\n167|            record[\"detail\"] = \"killer test failed under the plant\"\n168|        else:\n169|            record[\"verdict\"] = \"SURVIVED\"\n170|            record[\"detail\"] = \"killer test passed under the plant\"\n171|    except subprocess.TimeoutExpired:\n172|        record[\"verdict\"] = \"COMPILE_OR_HARNESS_FAILURE\"\n173|        record[\"detail\"] = \"subprocess timed out\"\n174|        with open(log_path, \"w\", encoding=\"utf-8\") as handle:\n175|            handle.write(\"TIMEOUT\\n\")\n176|    finally:\n177|        with open(path, \"w\", encoding=\"utf-8\") as handle:\n178|            handle.write(original)\n179|    return record\n180|\n181|\n182|def main():\n183|    parser = argparse.ArgumentParser(description=\"sessckpt narrowing-mutant harness\")\n184|    parser.add_argument(\"--log-dir\", required=True, help=\"directory for per-plant raw logs\")\n185|    parser.add_argument(\"--root\", default=\".\", help=\"repository root\")\n186|    args = parser.parse_args()\n187|    root = os.path.abspath(args.root)\n188|    log_dir = args.log_dir if os.path.isabs(args.log_dir) else os.path.join(root, args.log_dir)\n189|    os.makedirs(log_dir, exist_ok=True)\n190|    results = [run_plant(root, log_dir, plant) for plant in PLANTS]\n191|    summary = {\"plants\": results}\n192|    killed = sum(1 for r in results if r[\"verdict\"] == \"KILLED\" and r[\"expect\"] == \"killed\")\n193|    narrowed = sum(1 for r in results if r[\"expect\"] == \"killed\")\n194|    survived_ok = sum(1 for r in results if r[\"verdict\"] == \"SURVIVED\" and r[\"expect\"] == \"survived\")\n195|    survived_total = sum(1 for r in results if r[\"expect\"] == \"survived\")\n196|    not_applied = sum(1 for r in results if r[\"verdict\"] == \"NOT_APPLIED\")\n197|    harness_fail = sum(1 for r in results if r[\"verdict\"] == \"COMPILE_OR_HARNESS_FAILURE\")\n198|    summary[\"numerator\"] = \"%d of %d narrowing mutants killed\" % (killed, narrowed)\n199|    summary[\"control\"] = \"%d of %d survived controls applied\" % (survived_ok, survived_total)\n200|    summary[\"not_applied\"] = not_applied\n201|    summary[\"compile_or_harness_failure\"] = harness_fail\n202|    expectations_met = all(\n203|        (r[\"verdict\"] == \"KILLED\") if r[\"expect\"] == \"killed\" else (r[\"verdict\"] == \"SURVIVED\")\n204|        for r in results\n205|    )\n206|    summary[\"expectations_met\"] = expectations_met\n207|    with open(os.path.join(log_dir, \"summary.json\"), \"w\", encoding=\"utf-8\") as handle:\n208|        json.dump(summary, handle, indent=2, sort_keys=True)\n209|        handle.write(\"\\n\")\n210|    print(\"narrowing: %s | control: %s | not_applied: %d | harness_failure: %d\" % (\n211|        summary[\"numerator\"], summary[\"control\"], not_applied, harness_fail))\n212|    for record in results:\n213|        print(\"%-22s %-28s expect=%-8s detail=%s\" % (\n214|            record[\"name\"], record[\"verdict\"], record[\"expect\"], record.get(\"detail\", \"\")))\n215|    return 0 if expectations_met else 1\n216|\n217|\n218|if __name__ == \"__main__\":\n219|    sys.exit(main())","final_result":true}}}
