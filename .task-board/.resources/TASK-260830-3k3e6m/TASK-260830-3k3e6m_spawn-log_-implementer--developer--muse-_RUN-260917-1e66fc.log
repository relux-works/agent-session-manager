{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc2b","stream":{"kind":"session","id":"01a0adcc-09d6-79d1-9b97-6e93479b8dc1"},"sequence":1136,"recorded_at":1780531400002267,"record_type":"event","durability":"durable","causation_id":"410e85d5-c650-4a55-ae65-44f1be1f0a3d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"410e85d5-c650-4a55-ae65-44f1be1f0a3d","run_stream":{"kind":"run","id":"410e85d5-c650-4a55-ae65-44f1be1f0a3d"},"call_id":"call_01a0adcf5d0574c292ce2b6d8309135e","text":"Read text file `internal/axerror/registry.go`.\n1|package axerror\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|\t\"regexp\"\n7|\t\"sort\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n10|)\n11|\n12|// Schema is the exact Structured Error schema identifier of Section 15.1.\n13|const Schema = \"urn:ax:schema:error\"\n14|\n15|// Version is one registered Structured Error version. The set is closed: the\n16|// pinned Section 1.5 registry lists exactly these four, and a value outside it\n17|// is refused rather than coerced to the nearest neighbour.\n18|type Version string\n19|\n20|const (\n21|\t// Version100 is bound by Provider protocol 2.x, task-board bridge 1.x,\n22|\t// Mesh RPC 2.x, and CLI Result 1.0.0.\n23|\tVersion100 Version = \"1.0.0\"\n24|\t// Version110 is bound by Session Adapter 1.0, session.clone.*, and\n25|\t// CLI Result 2.0.0.\n26|\tVersion110 Version = \"1.1.0\"\n27|\t// Version120 is bound by Directory Node 1 and 2, Mesh RPC 3, CLI Result 3,\n28|\t// and Directory Query 1.\n29|\tVersion120 Version = \"1.2.0\"\n30|\t// Version130 is bound by Terminal Backend Protocol 1.0.0, Provider Protocol\n31|\t// 3.0.0, Mesh RPC 4.0.0, and CLI Result 4.0.0.\n32|\tVersion130 Version = \"1.3.0\"\n33|)\n34|\n35|// Code is one stable lower-snake-case Structured Error code.\n36|type Code string\n37|\n38|var (\n39|\t// ErrUnsupportedVersion reports a Structured Error version outside the\n40|\t// pinned registry, including any major other than 1.\n41|\tErrUnsupportedVersion = errors.New(\"unsupported structured error version\")\n42|\n43|\t// ErrUnregisteredCode reports a code that the requested version does not\n44|\t// register. A writer may never mint one; see RetryabilityRefusal and\n45|\t// Decode for the reader's separate tolerance rule.\n46|\tErrUnregisteredCode = errors.New(\"unregistered structured error code\")\n47|\n48|\t// ErrUnregisteredExit reports an exit status outside the closed Section\n49|\t// 15.2 registry, or the success status 0 in a failure object.\n50|\tErrUnregisteredExit = errors.New(\"unregistered structured error exit code\")\n51|)\n52|\n53|// versionOrder is the registry order of the four registered versions. Index\n54|// position is the only ordering used; the strings are never compared\n55|// lexically, because \"1.10.0\" would sort before \"1.2.0\" if they were.\n56|var versionOrder = []Version{Version100, Version110, Version120, Version130}\n57|\n58|// codePattern is the Section 15.1 constraint on code, verbatim: \"string[1..128]\n59|// | Stable lower-snake-case registry value\".\n60|var codePattern = regexp.MustCompile(`^[a-z][a-z0-9_]*$`)\n61|\n62|const maxCodeLength = 128\n63|\n64|// exitMeanings is the Section 15.2 exit-code registry, closed. The table is\n65|// stated in the pinned document without RFC 2119 keywords, so no clause-level\n66|// coverage is claimed for it; it is reproduced here because every code-to-exit\n67|// mapping in Section 15.3 has to resolve against it.\n68|//\n69|// The row count is deliberately not written here in words.\n70|// TestExitStatusRegistryMatchesThePinnedTableRowForRow measures it from\n71|// internal/specdoc and compares the statuses row for row, because the previous\n72|// comment said \"nineteen\" against a table with eighteen body rows and that\n73|// number was copied into README prose and a landed traceability comment before\n74|// anything compared the word to the table.\n75|var exitMeanings = map[int]string{\n76|\t0:   \"Requested operation succeeded\",\n77|\t2:   \"Usage, invalid flag, or interactive choice required\",\n78|\t3:   \"Configuration or local precondition invalid\",\n79|\t4:   \"Session, checkpoint, peer, provider, or task-board identity not found\",\n80|\t5:   \"Workspace/native-store conflict; no silent overwrite\",\n81|\t6:   \"Capability unsupported, unknown, conditional, or incompatible\",\n82|\t7:   \"Authentication/authorization/allowlist failure\",\n83|\t8:   \"SSH/RPC transport failure; staging can be resumable\",\n84|\t9:   \"Integrity, schema, hash, or unsafe-path failure\",\n85|\t10:  \"Ownership/lease/fencing failure\",\n86|\t11:  \"Busy, quiesce timeout, or graceful stop timeout\",\n87|\t12:  \"Staging/materialization/rollback failure\",\n88|\t13:  \"Provider plugin/process failure\",\n89|\t14:  \"Task-board bridge/bundle/validation failure\",\n90|\t15:  \"Partial success: immutable sync succeeded but a requested materialization or peer did not\",\n91|\t16:  \"Explicit policy refusal, including missing destructive confirmation\",\n92|\t17:  \"Contract/schema migration required\",\n93|\t130: \"Interrupted by operator signal before a clean response; inspect authority before retry\",\n94|}\n95|\n96|// successExit is the one registered status that is not a failure class. A\n97|// Structured Error is a failure object, so it can never carry it.\n98|const successExit = 0\n99|\n100|type registryEntry struct {\n101|\texitCode int\n102|\tversions map[Version]struct{}\n103|}\n104|\n105|// codeRegistry is derived from the reviewed catalog rather than retyped here,\n106|// so a code added to the pinned registry cannot exist in one place only.\n107|var codeRegistry = mustBuildCodeRegistry(catalog.Current().Errors)\n108|\n109|func mustBuildCodeRegistry(rows []catalog.ErrorCode) map[Code]registryEntry {\n110|\tbuilt, err := buildCodeRegistry(rows)\n111|\tif err != nil {\n112|\t\tpanic(fmt.Sprintf(\"structured error registry is invalid: %v\", err))\n113|\t}\n114|\treturn built\n115|}\n116|\n117|// buildCodeRegistry projects the catalog error rows into the code-to-exit\n118|// registry. It refuses a row that does not belong to the Structured Error\n119|// contract, names an exit status outside Section 15.2, claims success, carries\n120|// no version, names an unregistered version, or repeats a code, so a drifted\n121|// catalog fails at load rather than silently widening the admitted set.\n122|func buildCodeRegistry(rows []catalog.ErrorCode) (map[Code]registryEntry, error) {\n123|\tif len(rows) == 0 {\n124|\t\treturn nil, fmt.Errorf(\"catalog carries no Structured Error rows\")\n125|\t}\n126|\tregistry := make(map[Code]registryEntry, len(rows))\n127|\tfor _, row := range rows {\n128|\t\tcode := Code(row.Code)\n129|\t\tif string(row.ContractID) != Schema {\n130|\t\t\treturn nil, fmt.Errorf(\"code %q belongs to contract %q, not %s\", code, row.ContractID, Schema)\n131|\t\t}\n132|\t\tif err := validateCodeGrammar(code); err != nil {\n133|\t\t\treturn nil, err\n134|\t\t}\n135|\t\tif _, ok := exitMeanings[row.ExitCode]; !ok {\n136|\t\t\treturn nil, fmt.Errorf(\"code %q maps to exit %d, which Section 15.2 does not register\", code, row.ExitCode)\n137|\t\t}\n138|\t\tif row.ExitCode == successExit {\n139|\t\t\treturn nil, fmt.Errorf(\"code %q maps to the success exit status\", code)\n140|\t\t}\n141|\t\tif len(row.ContractVersions) == 0 {\n142|\t\t\treturn nil, fmt.Errorf(\"code %q registers no Structured Error version\", code)\n143|\t\t}\n144|\t\tversions := make(map[Version]struct{}, len(row.ContractVersions))\n145|\t\tfor _, raw := range row.ContractVersions {\n146|\t\t\tversion := Version(raw)\n147|\t\t\tif !isRegisteredVersion(version) {\n148|\t\t\t\treturn nil, fmt.Errorf(\"code %q names unregistered version %q\", code, raw)\n149|\t\t\t}\n150|\t\t\tversions[version] = struct{}{}\n151|\t\t}\n152|\t\tif _, duplicate := registry[code]; duplicate {\n153|\t\t\treturn nil, fmt.Errorf(\"code %q is registered twice\", code)\n154|\t\t}\n155|\t\tregistry[code] = registryEntry{exitCode: row.ExitCode, versions: versions}\n156|\t}\n157|\treturn registry, nil\n158|}\n159|\n160|func validateCodeGrammar(code Code) error {\n161|\tif len(code) == 0 || len(code) > maxCodeLength {\n162|\t\treturn fmt.Errorf(\"%w: code %q is not 1..%d bytes\", ErrUnregisteredCode, code, maxCodeLength)\n163|\t}\n164|\tif !codePattern.MatchString(string(code)) {\n165|\t\treturn fmt.Errorf(\"%w: code %q is not lower snake case\", ErrUnregisteredCode, code)\n166|\t}\n167|\treturn nil\n168|}\n169|\n170|func isRegisteredVersion(version Version) bool {\n171|\tfor _, candidate := range versionOrder {\n172|\t\tif candidate == version {\n173|\t\t\treturn true\n174|\t\t}\n175|\t}\n176|\treturn false\n177|}\n178|\n179|// Versions returns the registered Structured Error versions in registry order.\n180|func Versions() []Version {\n181|\treturn append([]Version(nil), versionOrder...)\n182|}\n183|\n184|// ExitCodeFor returns the exact Section 15.2 exit status that version assigns\n185|// to code. It refuses an unregistered version, a code the pinned registry does\n186|// not carry, and a code that a later version added but the requested one does\n187|// not register, so a 1.3.0-only TerminalBackend code cannot be emitted inside a\n188|// 1.0.0 envelope.\n189|func ExitCodeFor(version Version, code Code) (int, error) {\n190|\tif !isRegisteredVersion(version) {\n191|\t\treturn 0, fmt.Errorf(\"%w: %q\", ErrUnsupportedVersion, version)\n192|\t}\n193|\tentry, known := codeRegistry[code]\n194|\tif !known {\n195|\t\treturn 0, fmt.Errorf(\"%w: %q is not a Structured Error code\", ErrUnregisteredCode, code)\n196|\t}\n197|\tif _, admitted := entry.versions[version]; !admitted {\n198|\t\treturn 0, fmt.Errorf(\"%w: %q is not registered by Structured Error %s\", ErrUnregisteredCode, code, version)\n199|\t}\n200|\treturn entry.exitCode, nil\n201|}\n202|\n203|// ExitStatusMeaning returns the Section 15.2 meaning of a registered exit\n204|// status. The second result is false for any status the registry does not\n205|// carry, so an unregistered status is reported as unknown rather than given a\n206|// plausible meaning.\n207|func ExitStatusMeaning(status int) (string, bool) {\n208|\tmeaning, ok := exitMeanings[status]\n209|\treturn meaning, ok\n210|}\n211|\n212|// IsFailureExitStatus reports whether status is a registered Section 15.2\n213|// status other than success. Every Structured Error carries one of these.\n214|func IsFailureExitStatus(status int) bool {\n215|\tif status == successExit {\n216|\t\treturn false\n217|\t}\n218|\t_, ok := exitMeanings[status]\n219|\treturn ok\n220|}\n221|\n222|// CodesFor returns every code the given version registers, sorted. It is the\n223|// measured denominator of this package's registry coverage; callers that want\n224|// a prose summary instead have to state the ratio themselves.\n225|func CodesFor(version Version) ([]Code, error) {\n226|\tif !isRegisteredVersion(version) {\n227|\t\treturn nil, fmt.Errorf(\"%w: %q\", ErrUnsupportedVersion, version)\n228|\t}\n229|\tvar result []Code\n230|\tfor code, entry := range codeRegistry {\n231|\t\tif _, ok := entry.versions[version]; ok {\n232|\t\t\tresult = append(result, code)\n233|\t\t}\n234|\t}\n235|\tsort.Slice(result, func(left, right int) bool { return result[left] < result[right] })\n236|\treturn result, nil\n237|}\n238|\n239|// CodesByExitStatus groups a version's registered codes by the Section 15.2\n240|// status they map to, each group sorted.\n241|//\n242|// It exists to make one compatibility fact measurable instead of asserted: the\n243|// mapping from code to exit status is many-to-one, so the status a process\n244|// exits with narrows a failure to a class and never identifies it. A client\n245|// that branches on the status alone is choosing between the codes in one of\n246|// these groups without evidence, and the group sizes say how many. Callers that\n247|// want a prose summary have to state the ratio themselves.\n248|//\n249|// A status the version registers no code for is absent from the result rather\n250|// than present and empty: \"no code maps here\" is a fact about the registry, and\n251|// an empty group would read as one the caller could still branch on.\n252|func CodesByExitStatus(version Version) (map[int][]Code, error) {\n253|\tcodes, err := CodesFor(version)\n254|\tif err != nil {\n255|\t\treturn nil, err\n256|\t}\n257|\tresult := make(map[int][]Code)\n258|\tfor _, code := range codes {\n259|\t\texitStatus, err := ExitCodeFor(version, code)\n260|\t\tif err != nil {\n261|\t\t\treturn nil, err\n262|\t\t}\n263|\t\tresult[exitStatus] = append(result[exitStatus], code)\n264|\t}\n265|\treturn result, nil\n266|}\n267|\n268|// retryabilityRefusalsByExitStatus records the exit classes whose whole meaning\n269|// contradicts the Section 15.1 definition of retryable: \"True only when the\n270|// identical request may safely be retried without new authority or\n271|// confirmation\". Each entry quotes the Section 15.2 row that licenses it.\n272|var retryabilityRefusalsByExitStatus = map[int]string{\n273|\t7:   `exit 7 is \"Authentication/authorization/allowlist failure\"; the identical request cannot succeed without new authority`,\n274|\t16:  `exit 16 is \"Explicit policy refusal, including missing destructive confirmation\"; the identical request cannot succeed without new confirmation`,\n275|\t130: `exit 130 is \"Interrupted by operator signal before a clean response; inspect authority before retry\"`,\n276|}\n277|\n278|// retryabilityRefusalsByCode records the three codes the pinned document\n279|// disqualifies individually, each with the sentence that disqualifies it.\n280|// These are quoted, not inferred: no code is added here because retrying it\n281|// merely looks unwise.\n282|var retryabilityRefusalsByCode = map[Code]string{\n283|\t\"operation_uncertain\":               `Section 15.3: \"operation_uncertain is not retry permission: status/recovery inspection is mandatory\"`,\n284|\t\"terminal_backend_stale_generation\": `Section 15.3: terminal_backend_stale_generation \"requires status/recovery before retry and is never retryable solely because the caller can submit the same bytes\"`,\n285|\t\"transaction_unknown\":               `Section 15.1: \"Transaction unknown is a parked ambiguous effect, never success or absence\"`,\n286|}\n287|\n288|// RetryabilityRefusal reports why retryable = true is forbidden for a code, and\n289|// whether such a refusal exists. Both the code and its exit status are\n290|// consulted: an unknown code still retains its envelope's exit class, so a\n291|// reader that cannot resolve the code can still refuse a forged retry claim on\n292|// an authorization, refusal, or interrupt class.\n293|//\n294|// The complement is deliberately not a permission. This function never reports\n295|// that retrying is safe; it reports only where the pinned document forbids the\n296|// claim. Every other code carries whatever the constructing call site declared,\n297|// and this package makes no assertion about it.\n298|func RetryabilityRefusal(code Code, exitStatus int) (string, bool) {\n299|\tif reason, forbidden := retryabilityRefusalsByCode[code]; forbidden {\n300|\t\treturn reason, true\n301|\t}\n302|\tif reason, forbidden := retryabilityRefusalsByExitStatus[exitStatus]; forbidden {\n303|\t\treturn reason, true\n304|\t}\n305|\treturn \"\", false\n306|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
