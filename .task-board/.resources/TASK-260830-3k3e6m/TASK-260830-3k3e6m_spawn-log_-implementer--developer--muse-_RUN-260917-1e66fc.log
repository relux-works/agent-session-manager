{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c899","stream":{"kind":"session","id":"01a0adcc-09d6-79d1-9b97-6e93479b8dc1"},"sequence":679,"recorded_at":1780531400001353,"record_type":"event","durability":"durable","causation_id":"410e85d5-c650-4a55-ae65-44f1be1f0a3d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"410e85d5-c650-4a55-ae65-44f1be1f0a3d","run_stream":{"kind":"run","id":"410e85d5-c650-4a55-ae65-44f1be1f0a3d"},"call_id":"call_01a0adcdaf2a7478aa05f6f6c6e6ba0c","text":"Read text file `internal/sessckpt/capture.go`.\n(497 line(s) above)\n498|// checkHeads validates the source-head shape leg: 1..64 sorted\n499|// unique digests. Resolution against the session chain belongs to\n500|// checkHeadBinding; grammar alone never admits authority.\n501|func checkHeads(heads []string) ([]string, error) {\n502|\tif len(heads) < 1 || len(heads) > 64 {\n503|\t\treturn nil, invalid(\"event_heads requires 1..64 entries, got %d\", len(heads))\n504|\t}\n505|\tprevious := \"\"\n506|\tout := make([]string, 0, len(heads))\n507|\tfor _, head := range heads {\n508|\t\tdigest, err := scalar.ParseDigest(head)\n509|\t\tif err != nil {\n510|\t\t\treturn nil, invalid(\"event head %q: %v\", head, err)\n511|\t\t}\n512|\t\tname := digest.String()\n513|\t\tif len(out) > 0 && name <= previous {\n514|\t\t\treturn nil, invalid(\"event_heads must be sorted unique\")\n515|\t\t}\n516|\t\tprevious = name\n517|\t\tout = append(out, name)\n518|\t}\n519|\treturn out, nil\n520|}\n521|\n522|// checkHeadBinding resolves every head of the typed closure\n523|// against the winning source chain for its session (SPEC Section\n524|// 5.4 event-head closure). Each head must name a chained event\n525|// for the same session at or before the owning lease: a head\n526|// naming an absent event propagates the owner's unknown-event\n527|// refusal, and a head under a later lease (a greater epoch, or\n528|// the same epoch under a different fencing token) refuses as an\n529|// unpublishable closure, because the checkpoint cannot fix\n530|// authority over events that postdate it. Historical heads stay\n531|// admissible and are never required to equal the current tail. A\n532|// nil chain refuses closed rather than skipping the gate.\n533|func checkHeadBinding(chain *sessrepo.Repository, inputs Inputs) error {\n534|\tif chain == nil {\n535|\t\treturn invalid(\"no winning source chain binds checkpoint event heads\")\n536|\t}\n537|\tevents, err := chain.ListEvents(inputs.SessionID)\n538|\tif err != nil {\n539|\t\treturn fmt.Errorf(\"bind checkpoint event heads: %w\", err)\n540|\t}\n541|\tbyID := make(map[string]sessrepo.EventSummary, len(events))\n542|\tfor _, summary := range events {\n543|\t\tbyID[summary.EventID] = summary\n544|\t}\n545|\t// The owning tuple is compared in canonical form, the same\n546|\t// rendering buildCandidate stamps into the record, so a\n547|\t// grammar-valid non-canonical spelling cannot split the\n548|\t// binding check from the published bytes.\n549|\tlease, err := scalar.ParseUUIDv4(inputs.LeaseID)\n550|\tif err != nil {\n551|\t\treturn invalid(\"lease id %q: %v\", inputs.LeaseID, err)\n552|\t}\n553|\tfor _, head := range inputs.EventHeads {\n554|\t\t// Grammar already passed in checkHeads (buildCandidate runs\n555|\t\t// first); the canonical rendering keys the chain lookup.\n556|\t\tdigest, err := scalar.ParseDigest(head)\n557|\t\tif err != nil {\n558|\t\t\treturn invalid(\"event head %q: %v\", head, err)\n559|\t\t}\n560|\t\tsummary, ok := byID[digest.String()]\n561|\t\tif !ok {\n562|\t\t\treturn fmt.Errorf(\"bind checkpoint event head %s: %w\", digest.String(), sessrepo.ErrUnknownEvent)\n563|\t\t}\n564|\t\tif summary.LeaseEpoch > inputs.LeaseEpoch {\n565|\t\t\treturn invalid(\"checkpoint event head %s sits under later lease epoch %d past owning epoch %d\",\n566|\t\t\t\tdigest.String(), summary.LeaseEpoch, inputs.LeaseEpoch)\n567|\t\t}\n568|\t\tif summary.LeaseEpoch == inputs.LeaseEpoch && summary.LeaseID != lease.String() {\n569|\t\t\treturn invalid(\"checkpoint event head %s sits under lease %s past owning lease %s at epoch %d\",\n570|\t\t\t\tdigest.String(), summary.LeaseID, lease.String(), inputs.LeaseEpoch)\n571|\t\t}\n572|\t}\n573|\treturn nil\n574|}\n575|\n576|// checkRawHeadBinding is the raw-admission half of the head gate:\n577|// the same at-or-before-owning-lease rule over the members the\n578|// owner already attested. A nil chain refuses closed.\n579|func checkRawHeadBinding(chain *sessrepo.Repository, admitted admittedMembers) error {\n580|\tif chain == nil {\n581|\t\treturn invalid(\"no winning source chain binds checkpoint event heads\")\n582|\t}\n583|\tevents, err := chain.ListEvents(admitted.sessionID)\n584|\tif err != nil {\n585|\t\treturn fmt.Errorf(\"bind checkpoint event heads: %w\", err)\n586|\t}\n587|\tbyID := make(map[string]sessrepo.EventSummary, len(events))\n588|\tfor _, summary := range events {\n589|\t\tbyID[summary.EventID] = summary\n590|\t}\n591|\tfor _, head := range admitted.heads {\n592|\t\tsummary, ok := byID[head]\n593|\t\tif !ok {\n594|\t\t\treturn fmt.Errorf(\"bind checkpoint event head %s: %w\", head, sessrepo.ErrUnknownEvent)\n595|\t\t}\n596|\t\tif summary.LeaseEpoch > admitted.leaseEpoch {\n597|\t\t\treturn invalid(\"checkpoint event head %s sits under later lease epoch %d past owning epoch %d\",\n598|\t\t\t\thead, summary.LeaseEpoch, admitted.leaseEpoch)\n599|\t\t}\n600|\t\tif summary.LeaseEpoch == admitted.leaseEpoch && summary.LeaseID != admitted.leaseID {\n601|\t\t\treturn invalid(\"checkpoint event head %s sits under lease %s past owning lease %s at epoch %d\",\n602|\t\t\t\thead, summary.LeaseID, admitted.leaseID, admitted.leaseEpoch)\n603|\t\t}\n604|\t}\n605|\treturn nil\n606|}\n607|\n608|// checkOperationID admits the caller-stable idempotency key.\n609|func checkOperationID(operationID string) (string, error) {\n610|\tid, err := scalar.ParseUUIDv7(operationID)\n611|\tif err != nil {\n612|\t\treturn \"\", invalid(\"operation id %q: %v\", operationID, err)\n613|\t}\n614|\treturn id.String(), nil\n615|}\n616|\n617|// checkSessionID admits the checkpoint subject session.\n618|func checkSessionID(sessionID string) (string, error) {\n619|\tid, err := scalar.ParseUUIDv7(sessionID)\n620|\tif err != nil {\n621|\t\treturn \"\", invalid(\"session id %q: %v\", sessionID, err)\n622|\t}\n623|\treturn id.String(), nil\n624|}\n625|\n626|// checkLeaseEpoch admits the owning lease epoch: greater than\n627|// zero, inside the AX safe-integer ceiling.\n628|func checkLeaseEpoch(epoch uint64) (uint64, error) {\n629|\tif epoch < 1 || epoch > uint53Max {\n630|\t\treturn 0, invalid(\"lease epoch %d is outside 1..2^53-1\", epoch)\n631|\t}\n632|\treturn epoch, nil\n633|}\n634|\n635|// checkLeaseID admits the owning lease fencing token.\n636|func checkLeaseID(leaseID string) (string, error) {\n637|\tid, err := scalar.ParseUUIDv4(leaseID)\n638|\tif err != nil {\n639|\t\treturn \"\", invalid(\"lease id %q: %v\", leaseID, err)\n640|\t}\n641|\treturn id.String(), nil\n642|}\n643|\n644|// checkCreator admits the creating host: the consumer binds it to\n645|// the owning lease holder at admission, so capture records exactly\n646|// what the caller declares and never substitutes another host.\n647|func checkCreator(creator string) (string, error) {\n648|\tid, err := scalar.ParseUUIDv7(creator)\n649|\tif err != nil {\n650|\t\treturn \"\", invalid(\"created_by_host id %q: %v\", creator, err)\n651|\t}\n652|\treturn id.String(), nil\n653|}\n654|\n655|// checkDigestMember admits a required manifest digest leg.\n656|func checkDigestMember(value, name string) (string, error) {\n657|\tdigest, err := scalar.ParseDigest(value)\n658|\tif err != nil {\n659|\t\treturn \"\", invalid(\"%s %q: %v\", name, value, err)\n660|\t}\n661|\treturn digest.String(), nil\n662|}\n663|\n664|// checkNullableDigest admits one persistence leg: empty binds\n665|// null, anything else must parse as a canonical digest.\n666|func checkNullableDigest(value, name string) (any, bool, error) {\n667|\tif value == \"\" {\n668|\t\treturn nil, false, nil\n669|\t}\n670|\tdigest, err := scalar.ParseDigest(value)\n671|\tif err != nil {\n672|\t\treturn nil, false, invalid(\"%s %q: %v\", name, value, err)\n673|\t}\n674|\treturn digest.String(), true, nil\n675|}\n676|\n677|// checkCreatedAt admits the diagnostic creation instant. The\n678|// instant is diagnostic only and never confers authority, but its\n679|// grammar is still closed: a malformed timestamp is refused\n680|// before publication.\n681|func checkCreatedAt(createdAt string) (string, error) {\n682|\tinstant, err := scalar.ParseTimestamp(createdAt)\n683|\tif err != nil {\n684|\t\treturn \"\", invalid(\"created_at %q: %v\", createdAt, err)\n685|\t}\n686|\treturn instant.String(), nil\n687|}\n688|\n689|// checkExtensions admits the extension object: reverse-DNS keys\n690|// only, at most the owner's 64 members. A nil map binds the empty\n691|// object, never null. Extensions never add operations,\n692|// capabilities, or trust facts.\n693|func checkExtensions(extensions map[string]string) (map[string]any, error) {\n694|\tif extensions == nil {\n695|\t\textensions = map[string]string{}\n696|\t}\n697|\tout := make(map[string]any, len(extensions))\n698|\tfor key, value := range extensions {\n699|\t\tout[key] = value\n700|\t}\n701|\tif len(out) > 64 {\n702|\t\treturn nil, invalid(\"extensions contains %d members, maximum is 64\", len(out))\n703|\t}\n704|\tframed, err := json.Marshal(out)\n705|\tif err != nil {\n706|\t\treturn nil, invalid(\"encode checkpoint extensions: %v\", err)\n707|\t}\n708|\tif !environ.CheckExtensions(framed) {\n709|\t\treturn nil, invalid(\"checkpoint extensions keys must be 3..253 character lowercase reverse-DNS names\")\n710|\t}\n711|\treturn out, nil\n712|}\n713|\n714|// stringMember reads a required string member from a strictly\n715|// decoded frame.\n716|func stringMember(members map[string]json.RawMessage, name string) (string, error) {\n717|\traw, ok := members[name]\n718|\tif !ok {\n719|\t\treturn \"\", fmt.Errorf(\"member %q is absent\", name)\n720|\t}\n721|\tvar value string\n722|\tif err := json.Unmarshal(raw, &value); err != nil {\n723|\t\treturn \"\", fmt.Errorf(\"member %q is not a string: %v\", name, err)\n724|\t}\n725|\treturn value, nil\n726|}\n727|\n728|// runeCount measures provider_version in Unicode characters, the\n729|// unit the closed shape declares for its 1..128 bound.\n730|func runeCount(value string) int {\n731|\treturn len([]rune(value))\n732|}\n733|\n734|// install is the shared durable tail of Capture and Admit: replay\n735|// the recorded checkpoint when the same operation already\n736|// committed identical inputs, refuse the moved-input retry, and\n737|// otherwise install the blob before the receipt it names. The\n738|// blob-first order keeps an interrupted capture resuming: the\n739|// identical retry finds its bytes already installed and completes\n740|// the receipt, so no second checkpoint identity is ever minted\n741|// for one operation.\n742|func (store *Store) install(operation, session, digest, inputDigest string, raw []byte) (CheckpointRef, []byte, error) {\n743|\tstore.mutex.Lock()\n744|\tdefer store.mutex.Unlock()\n745|\tif recorded, ok, err := store.readReceiptLocked(operation); err != nil {\n746|\t\treturn CheckpointRef{}, nil, err\n747|\t} else if ok {\n748|\t\tif recorded.InputDigest != inputDigest {\n749|\t\t\treturn CheckpointRef{}, nil, fmt.Errorf(\"%w: operation %s captured different inputs (idempotency_mismatch)\",\n750|\t\t\t\tErrCheckpointConflict, operation)\n751|\t\t}\n752|\t\treplayed, err := readBlob(store.blobPath(recorded.CheckpointID))\n753|\t\tif err != nil {\n754|\t\t\treturn CheckpointRef{}, nil, err\n755|\t\t}\n756|\t\treturn CheckpointRef{CheckpointID: recorded.CheckpointID, OperationID: operation}, replayed, nil\n757|\t}\n758|\tif store.BeforeWrite != nil {\n759|\t\tif err := store.BeforeWrite(); err != nil {\n760|\t\t\treturn CheckpointRef{}, nil, err\n761|\t\t}\n762|\t}\n763|\tif err := installBlob(store.blobPath(digest), raw); err != nil {\n764|\t\treturn CheckpointRef{}, nil, err\n765|\t}\n766|\tif store.AfterBlob != nil {\n767|\t\tif err := store.AfterBlob(); err != nil {\n768|\t\t\treturn CheckpointRef{}, nil, err\n769|\t\t}\n770|\t}\n771|\tcommitted := receipt{OperationID: operation, CheckpointID: digest, InputDigest: inputDigest, SessionID: session}\n772|\tif err := store.writeReceiptLocked(committed); err != nil {\n773|\t\tif conflict, ok, readErr := store.rereadReceiptLocked(operation, inputDigest); readErr != nil {\n774|\t\t\treturn CheckpointRef{}, nil, readErr\n775|\t\t} else if ok {\n776|\t\t\treplayed, err := readBlob(store.blobPath(conflict.CheckpointID))\n777|\t\t\tif err != nil {\n778|\t\t\t\treturn CheckpointRef{}, nil, err\n779|\t\t\t}\n780|\t\t\treturn conflict, replayed, nil\n781|\t\t}\n782|\t\treturn CheckpointRef{}, nil, err\n783|\t}\n784|\tif store.AfterCommit != nil {\n785|\t\tif err := store.AfterCommit(); err != nil {\n786|\t\t\treturn CheckpointRef{}, nil, err\n787|\t\t}\n788|\t}\n789|\treturn CheckpointRef{CheckpointID: digest, OperationID: operation}, append([]byte(nil), raw...), nil\n790|}\n791|\n792|// rereadReceiptLocked resolves a receipt-install race: a\n793|// concurrent capture committed the same operation first. An\n794|// identical-inputs winner replays; moved inputs refuse.\n795|func (store *Store) rereadReceiptLocked(operation, inputDigest string) (CheckpointRef, bool, error) {\n796|\trecorded, ok, err := store.readReceiptLocked(operation)\n797|\tif err != nil {\n798|\t\treturn CheckpointRef{}, false, err\n799|\t}\n800|\tif !ok {\n801|\t\treturn CheckpointRef{}, false, nil\n802|\t}\n803|\tif recorded.InputDigest != inputDigest {\n804|\t\treturn CheckpointRef{}, false, fmt.Errorf(\"%w: operation %s captured different inputs (idempotency_mismatch)\",\n805|\t\t\tErrCheckpointConflict, operation)\n806|\t}\n807|\treturn CheckpointRef{CheckpointID: recorded.CheckpointID, OperationID: operation}, true, nil\n808|}\n809|\n810|// blobPath names the content-addressed blob for one checkpoint\n811|// digest. Callers hold the store mutex.\n812|func (store *Store) blobPath(digest string) string {\n813|\treturn store.root + \"/\" + checkpointFileName(digest)\n814|}\n815|\n816|// receiptPath names the operation receipt for one operation UUID.\n817|// Callers hold the store mutex.\n818|func (store *Store) receiptPath(operation string) string {\n819|\treturn store.root + \"/operations/\" + operationFileName(operation)\n820|}\n821|\n822|// readReceiptLocked returns the committed receipt for one\n823|// operation, validated by strict decode plus grammar on every\n824|// read. Callers hold the store mutex.\n825|func (store *Store) readReceiptLocked(operation string) (receipt, bool, error) {\n826|\tframed, err := readBlob(store.receiptPath(operation))\n827|\tif err != nil {\n828|\t\tif os.IsNotExist(err) {\n829|\t\t\treturn receipt{}, false, nil\n830|\t\t}\n831|\t\treturn receipt{}, false, err\n832|\t}\n833|\tmembers, fault := environ.DecodeStrictObject(framed)\n834|\tif fault != nil {\n835|\t\treturn receipt{}, false, fmt.Errorf(\"decode checkpoint operation receipt: %v\", fault)\n836|\t}\n837|\t// Receipt grammar is checked with the scalar owner directly and\n838|\t// reported as plain operational errors: a damaged\n839|\t// machine-local receipt is torn recovery state, never an\n840|\t// unpublishable closure, so the invalid-closure sentinel must\n841|\t// not classify it.\n842|\tvar recorded receipt\n843|\tfor _, leg := range []struct {\n844|\t\tname   string\n845|\t\ttarget *string\n846|\t}{\n847|\t\t{\"operation_id\", &recorded.OperationID},\n848|\t\t{\"checkpoint_id\", &recorded.CheckpointID},\n849|\t\t{\"input_digest\", &recorded.InputDigest},\n850|\t\t{\"session_id\", &recorded.SessionID},\n851|\t} {\n852|\t\tvalue, err := stringMember(members, leg.name)\n853|\t\tif err != nil {\n854|\t\t\treturn receipt{}, false, fmt.Errorf(\"decode checkpoint operation receipt: %v\", err)\n855|\t\t}\n856|\t\t*leg.target = value\n857|\t}\n858|\tif _, err := scalar.ParseUUIDv7(recorded.OperationID); err != nil {\n859|\t\treturn receipt{}, false, fmt.Errorf(\"decode checkpoint operation receipt operation_id: %v\", err)\n860|\t}\n861|\tfor _, leg := range []struct {\n862|\t\tname  string\n863|\t\tvalue string\n864|\t}{\n865|\t\t{\"checkpoint_id\", recorded.CheckpointID},\n866|\t\t{\"input_digest\", recorded.InputDigest},\n867|\t} {\n868|\t\tif _, err := scalar.ParseDigest(leg.value); err != nil {\n869|\t\t\treturn receipt{}, false, fmt.Errorf(\"decode checkpoint operation receipt %s: %v\", leg.name, err)\n870|\t\t}\n871|\t}\n872|\tif _, err := scalar.ParseUUIDv7(recorded.SessionID); err != nil {\n873|\t\treturn receipt{}, false, fmt.Errorf(\"decode checkpoint operation receipt session_id: %v\", err)\n874|\t}\n875|\tif recorded.OperationID != operation {\n876|\t\treturn receipt{}, false, fmt.Errorf(\"checkpoint operation receipt names %s, want %s\", recorded.OperationID, operation)\n877|\t}\n878|\treturn recorded, true, nil\n879|}\n880|\n881|// writeReceiptLocked installs one operation receipt no-replace:\n882|// the first committer wins and every later retry replays or\n883|// refuses against it. Callers hold the store mutex.\n884|func (store *Store) writeReceiptLocked(committed receipt) error {\n885|\tframed, err := json.Marshal(committed)\n886|\tif err != nil {\n887|\t\treturn fmt.Errorf(\"encode checkpoint operation receipt: %w\", err)\n888|\t}\n889|\t// An EEXIST loser is not a failure: install() rereads the\n890|\t// winner's receipt and replays or refuses against it. The raw\n891|\t// error is returned unwrapped so os.IsExist keeps working for\n892|\t// any future caller that branches on it.\n893|\tif err := writeExclusive(store.receiptPath(committed.OperationID), framed); err != nil {\n894|\t\treturn err\n895|\t}\n896|\treturn syncDirectory(store.root + \"/operations\")\n897|}\n898|\n899|// readBlob reads one installed file verbatim.\n900|func readBlob(path string) ([]byte, error) {\n901|\traw, err := os.ReadFile(path)\n902|\tif err != nil {\n903|\t\treturn nil, err\n904|\t}\n905|\treturn bytes.Clone(raw), nil\n906|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
