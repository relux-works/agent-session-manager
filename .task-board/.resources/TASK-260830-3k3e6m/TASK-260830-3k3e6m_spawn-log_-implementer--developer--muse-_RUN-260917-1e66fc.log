n\\\\t\\\\tinput.Provider.State = ProviderUnknown\\\\n\\\\t\\\\tinput.Bridge.State = \\\\\\\"stopped\\\\\\\"\\\",\\n     \\\"\\\\t\\\\tinput.Boundary = BoundaryAfterActivation\\\\n\\\\t\\\\tinput.Bridge.State = \\\\\\\"stopped\\\\\\\"\\\"),\\n]\\nfor old, new in targets:\\n    n = s.count(old)\\n    print(n, repr(old[:60]))\\n    s = s.replace(old, new)\\nopen(p, 'w').write(s)\\nEOF\",\n  \"description\": \"Remove unknown overrides in bridge tests\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"1 '\\\\t\\\\tinput.Boundary = BoundaryAfterPrepareOp\\\\n\\\\t\\\\tinput.Provider.S'\\n1 '\\\\t\\\\tinput.Boundary = BoundaryAfterOpen\\\\n\\\\t\\\\tinput.Provider.State '\\n1 '\\\\t\\\\tinput.Boundary = BoundaryAfterActivation\\\\n\\\\t\\\\tinput.Provider.'\\n1 '\\\\t\\\\tinput.Boundary = BoundaryAfterActivation\\\\n\\\\t\\\\tinput.Provider.'\\n\",\n  \"original_output_bytes\": 280,\n  \"original_output_tokens\": 70,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
