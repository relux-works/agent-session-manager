|\tcandidate[\"checkpoint_id\"] = calculated.String()\n384|\traw, err := json.Marshal(candidate)\n385|\tif err != nil {\n386|\t\treturn nil, \"\", invalid(\"encode identified checkpoint: %v\", err)\n387|\t}\n388|\tattested, _, err := sessrepo.AttestCheckpointRecord(raw)\n389|\tif err != nil {\n390|\t\treturn nil, \"\", invalid(\"verify checkpoint record identity: %v\", err)\n391|\t}\n392|\tif attested != calculated {\n393|\t\treturn nil, \"\", invalid(\"checkpoint identity drifted between calculation and attestation\")\n394|\t}\n395|\treturn raw, calculated.String(), nil\n396|}\n397|\n398|// digestInputs binds the idempotency receipt to the exact closure:\n399|// the canonical bytes of the candidate with the placeholder\n400|// identity, so equal closures share one input digest and any moved\n401|// leg changes it.\n402|func digestInputs(candidate map[string]any) (string, error) {\n403|\tframed, err := json.Marshal(candidate)\n404|\tif err != nil {\n(more lines below)","final_result":true}}}
