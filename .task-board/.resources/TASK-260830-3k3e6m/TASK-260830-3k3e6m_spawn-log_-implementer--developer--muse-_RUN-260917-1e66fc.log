{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cadd","stream":{"kind":"session","id":"01a0adcc-09d6-79d1-9b97-6e93479b8dc1"},"sequence":969,"recorded_at":1780531400001933,"record_type":"event","durability":"durable","causation_id":"410e85d5-c650-4a55-ae65-44f1be1f0a3d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"410e85d5-c650-4a55-ae65-44f1be1f0a3d","run_stream":{"kind":"run","id":"410e85d5-c650-4a55-ae65-44f1be1f0a3d"},"task_stream":{"kind":"task","id":"01a0adce-e84b-7980-b537-38ca6b793c27"},"task_id":"01a0adce-e84b-7980-b537-38ca6b793c27","event":{"kind":"output","task_id":"01a0adce-e84b-7980-b537-38ca6b793c27","chunk":"Read text file `internal/sessckpt/refusal_test.go`.\n1|package sessckpt\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"os\"\n7|\t\"strings\"\n8|\t\"testing\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n11|)\n12|\n13|// mutate Raw takes captured bytes, applies one decoded-map mutation,\n14|// and re-marshals without re-identifying. The stale digest is part\n15|// of the vector: the production entry must refuse it, and the\n16|// paired control (re-identify a benign mutation, admit with a\n17|// fresh operation) proves the refusal tracks the mutation rather\n18|// than staleness itself.\n19|func mutateRaw(t *testing.T, raw []byte, mutate func(map[string]any)) []byte {\n20|\tt.Helper()\n21|\tvar value map[string]any\n22|\tif err := json.Unmarshal(raw, &value); err != nil {\n23|\t\tt.Fatal(err)\n24|\t}\n25|\tmutate(value)\n26|\tout, err := json.Marshal(value)\n27|\tif err != nil {\n28|\t\tt.Fatal(err)\n29|\t}\n30|\treturn out\n31|}\n32|\n33|func TestCaptureRefusesNonQuiescentBoundary(t *testing.T) {\n34|\tchain, created := chainFixture(t)\n35|\tcases := []struct {\n36|\t\tname   string\n37|\t\tmutate func(*SafeBoundary)\n38|\t}{\n39|\t\t{\"cp_n1_background_idle_false\", func(b *SafeBoundary) { b.BackgroundIdle = false }},\n40|\t\t{\"input_blocked_false\", func(b *SafeBoundary) { b.InputBlocked = false }},\n41|\t\t{\"foreground_idle_false\", func(b *SafeBoundary) { b.ForegroundIdle = false }},\n42|\t\t{\"open_processes_nonzero\", func(b *SafeBoundary) { b.OpenProcesses = 1 }},\n43|\t\t{\"open_database_handles_nonzero\", func(b *SafeBoundary) { b.OpenDatabaseHandles = 2 }},\n44|\t}\n45|\tfor _, tc := range cases {\n46|\t\tt.Run(tc.name, func(t *testing.T) {\n47|\t\t\tstore := openTestStore(t)\n48|\t\t\tinputs := testInputs([]string{created}, testOpA)\n49|\t\t\ttc.mutate(&inputs.Boundary)\n50|\t\t\t_, _, err := store.Capture(chain, inputs)\n51|\t\t\tmustInvalid(t, err, \"Capture(non-quiescent)\")\n52|\t\t\tif !strings.Contains(err.Error(), \"safe_boundary\") {\n53|\t\t\t\tt.Fatalf(\"error = %v, want the safe_boundary leg named\", err)\n54|\t\t\t}\n55|\t\t})\n56|\t}\n57|}\n58|\n59|func TestCaptureRefusesBadPersistenceVariant(t *testing.T) {\n60|\tchain, created := chainFixture(t)\n61|\tcases := []struct {\n62|\t\tname      string\n63|\t\tkind      string\n64|\t\tprovider  string\n65|\t\tbundle    string\n66|\t\twantNamed string\n67|\t}{\n68|\t\t// CP-N2: a direct Session Record with a null provider manifest.\n69|\t\t{\"cp_n2_direct_null_provider\", SessionKindDirect, \"\", \"\", \"provider_manifest_id\"},\n70|\t\t// CP-N3: both persistence IDs non-null.\n71|\t\t{\"cp_n3_both_present\", SessionKindDirect, testProviderManifest, testBoardBundle, \"provider_manifest_id\"},\n72|\t\t{\"both_absent_task_board\", SessionKindTaskBoard, \"\", \"\", \"task_board_bundle_id\"},\n73|\t\t// Swapped variants: valid shapes no session of that kind admits.\n74|\t\t{\"swapped_direct_takes_bundle\", SessionKindDirect, \"\", testBoardBundle, \"task-board\"},\n75|\t\t{\"swapped_task_board_takes_provider\", SessionKindTaskBoard, testProviderManifest, \"\", \"provider\"},\n76|\t}\n77|\tfor _, tc := range cases {\n78|\t\tt.Run(tc.name, func(t *testing.T) {\n79|\t\t\tstore := openTestStore(t)\n80|\t\t\tinputs := testInputs([]string{created}, testOpA)\n81|\t\t\tinputs.SessionKind = tc.kind\n82|\t\t\tinputs.ProviderManifestID = tc.provider\n83|\t\t\tinputs.TaskBoardBundleID = tc.bundle\n84|\t\t\t_, _, err := store.Capture(chain, inputs)\n85|\t\t\tmustInvalid(t, err, \"Capture(variant)\")\n86|\t\t\tif !strings.Contains(err.Error(), tc.wantNamed) {\n87|\t\t\t\tt.Fatalf(\"error = %v, want %q named\", err, tc.wantNamed)\n88|\t\t\t}\n89|\t\t})\n90|\t}\n91|}\n92|\n93|func TestAdmitRefusesUnknownSafeBoundaryMember(t *testing.T) {\n94|\tchain, created := chainFixture(t)\n95|\tstore := openTestStore(t)\n96|\t_, raw := mustCapture(t, store, chain, testInputs([]string{created}, testOpA))\n97|\t// CP-N4: an unknown safe_boundary.pid member. The mutated\n98|\t// bytes keep the stale digest; the control below proves the\n99|\t// refusal tracks the member, not staleness.\n100|\tmutated := mutateRaw(t, raw, func(value map[string]any) {\n101|\t\tvalue[\"safe_boundary\"].(map[string]any)[\"pid\"] = float64(4242)\n102|\t})\n103|\tif _, err := store.Admit(chain, mutated, testOpB, SessionKindDirect); err == nil {\n104|\t\tt.Fatalf(\"Admit(cp_n4) error = nil, want invalid checkpoint closure\")\n105|\t} else {\n106|\t\tmustInvalid(t, err, \"Admit(cp_n4)\")\n107|\t}\n108|\t// Control: a benign mutation (diagnostic instant), properly\n109|\t// re-identified, admits under a fresh operation.\n110|\tbenign := mutateRaw(t, raw, func(value map[string]any) {\n111|\t\tvalue[\"created_at\"] = \"2026-08-19T04:10:30.000Z\"\n112|\t})\n113|\tvar framed map[string]any\n114|\tif err := json.Unmarshal(benign, &framed); err != nil {\n115|\t\tt.Fatal(err)\n116|\t}\n117|\tif _, err := store.Admit(chain, identify(t, framed, \"checkpoint_id\"), testOpB, SessionKindDirect); err != nil {\n118|\t\tt.Fatalf(\"Admit(benign re-identified) error = %v\", err)\n119|\t}\n120|}\n121|\n122|func TestCaptureRefusesUnknownSessionAndHead(t *testing.T) {\n123|\tchain, created := chainFixture(t)\n124|\tstore := openTestStore(t)\n125|\t// Unknown session: the chain read propagates the owner's\n126|\t// unknown-session refusal.\n127|\tinputs := testInputs([]string{created}, testOpA)\n128|\tinputs.SessionID = \"0198f4c8-3e70-7a11-8a2b-1234567890ff\"\n129|\tif _, _, err := store.Capture(chain, inputs); !errors.Is(err, sessrepo.ErrUnknownSession) {\n130|\t\tt.Fatalf(\"Capture(unknown session) = %v, want unknown session\", err)\n131|\t}\n132|\t// Unknown head: the digest is well-formed but names no\n133|\t// chained event, so the owner's unknown-event refusal\n134|\t// propagates.\n135|\tinputs = testInputs([]string{testOtherManifest}, testOpA)\n136|\tif _, _, err := store.Capture(chain, inputs); !errors.Is(err, sessrepo.ErrUnknownEvent) {\n137|\t\tt.Fatalf(\"Capture(unknown head) = %v, want unknown session event\", err)\n138|\t}\n139|\t// Nil chain refuses closed instead of skipping the gate.\n140|\tif _, _, err := store.Capture(nil, testInputs([]string{created}, testOpA)); err == nil {\n141|\t\tt.Fatalf(\"Capture(nil chain) error = nil, want refusal\")\n142|\t} else {\n143|\t\tmustInvalid(t, err, \"Capture(nil chain)\")\n144|\t}\n145|\tif _, err := store.Admit(nil, []byte(specCheckpointExample), testOpA, SessionKindDirect); err == nil {\n146|\t\tt.Fatalf(\"Admit(nil chain) error = nil, want refusal\")\n147|\t} else {\n148|\t\tmustInvalid(t, err, \"Admit(nil chain)\")\n149|\t}\n150|}\n151|\n152|func TestCaptureRefusesLaterLeaseHead(t *testing.T) {\n153|\tchain, created := chainFixture(t)\n154|\t// A second-epoch event under a different fencing token.\n155|\tsecond := appendChainEvent(t, chain, \"lease.transferred\", 2, testLeaseB, 1, created, map[string]any{\n156|\t\t\"operation_id\": testHostB, \"from_host_id\": testHostA, \"to_host_id\": testHostA,\n157|\t\t\"predecessor_lease_id\": testLease, \"new_lease_id\": testLeaseB,\n158|\t})\n159|\tstore := openTestStore(t)\n160|\t// A greater epoch postdates the owning lease.\n161|\tinputs := testInputs([]string{second}, testOpA)\n162|\tif _, _, err := store.Capture(chain, inputs); err == nil {\n163|\t\tt.Fatalf(\"Capture(later-epoch head) error = nil, want refusal\")\n164|\t} else {\n165|\t\tmustInvalid(t, err, \"Capture(later-epoch head)\")\n166|\t}\n167|\t// The same epoch under a different fencing token postdates\n168|\t// the owning lease too.\n169|\tinputs = testInputs([]string{second}, testOpA)\n170|\tinputs.LeaseEpoch = 2\n171|\tif _, _, err := store.Capture(chain, inputs); err == nil {\n172|\t\tt.Fatalf(\"Capture(foreign-lease head) error = nil, want refusal\")\n173|\t} else {\n174|\t\tmustInvalid(t, err, \"Capture(foreign-lease head)\")\n175|\t}\n176|}\n177|\n178|func TestCaptureRefusesMalformedHeads(t *testing.T) {\n179|\tchain, created := chainFixture(t)\n180|\tother := testOtherManifest\n181|\tcases := []struct {\n182|\t\tname  string\n183|\t\theads []string\n184|\t\t// wantOwn gates the attribution: the capture entry's own\n185|\t\t// order check must fire before the owner's backstop, so a\n186|\t\t// mutant weakening it fails here even though the owner\n187|\t\t// still refuses (with different text).\n188|\t\twantOwn string\n189|\t}{\n190|\t\t{\"empty\", nil, \"\"},\n191|\t\t{\"malformed_digest\", []string{\"not-a-digest\"}, \"\"},\n192|\t\t{\"unsorted\", []string{other, created}, \"sorted unique\"},\n193|\t\t{\"duplicated\", []string{created, created}, \"sorted unique\"},\n194|\t}\n195|\tfor _, tc := range cases {\n196|\t\tt.Run(tc.name, func(t *testing.T) {\n197|\t\t\tstore := openTestStore(t)\n198|\t\t\t// The unsorted pair needs both heads chained; the\n199|\t\t\t// others refuse on grammar or order alone.\n200|\t\t\theads := tc.heads\n201|\t\t\tif tc.name == \"unsorted\" {\n202|\t\t\t\tif created > other {\n203|\t\t\t\t\theads = []string{created, other}\n204|\t\t\t\t}\n205|\t\t\t}\n206|\t\t\t_, _, err := store.Capture(chain, testInputs(heads, testOpA))\n207|\t\t\tmustInvalid(t, err, \"Capture(heads)\")\n208|\t\t\tif tc.wantOwn != \"\" && !strings.Contains(err.Error(), tc.wantOwn) {\n209|\t\t\t\tt.Fatalf(\"error = %v, want the capture order gate named (%q)\", err, tc.wantOwn)\n210|\t\t\t}\n211|\t\t})\n212|\t}\n213|\t// Sixty-five heads exceed the 1..64 bound even when every\n214|\t// entry is well-formed.\n215|\tt.Run(\"too_many\", func(t *testing.T) {\n216|\t\tstore := openTestStore(t)\n217|\t\theads := make([]string, 0, 65)\n218|\t\tfor i := 0; i < 65; i++ {\n219|\t\t\theads = append(heads, created)\n220|\t\t}\n221|\t\t_, _, err := store.Capture(chain, testInputs(heads, testOpA))\n222|\t\tmustInvalid(t, err, \"Capture(65 heads)\")\n223|\t})\n224|}\n225|\n226|func TestCaptureRefusesMalformedClosureMembers(t *testing.T) {\n227|\tchain, created := chainFixture(t)\n228|\theads := []string{created}\n229|\tcases := []struct {\n230|\t\tname   string\n231|\t\tmutate func(*Inputs)\n232|\t\t// wantOwn pins the capture entry's own gate attribution\n233|\t\t// ahead of the owner's backstop (see the heads table).\n234|\t\twantOwn string\n235|\t}{\n236|\t\t{\"bad_operation\", func(i *Inputs) { i.OperationID = \"not-a-uuid\" }, \"\"},\n237|\t\t{\"bad_session\", func(i *Inputs) { i.SessionID = \"not-a-uuid\" }, \"\"},\n238|\t\t{\"bad_kind\", func(i *Inputs) { i.SessionKind = \"replica\" }, \"\"},\n239|\t\t{\"zero_epoch\", func(i *Inputs) { i.LeaseEpoch = 0 }, \"\"},\n240|\t\t{\"bad_lease\", func(i *Inputs) { i.LeaseID = \"not-a-uuid\" }, \"\"},\n241|\t\t{\"bad_creator\", func(i *Inputs) { i.CreatorHostID = \"not-a-uuid\" }, \"\"},\n242|\t\t{\"bad_workspace_manifest\", func(i *Inputs) { i.WorkspaceManifestID = \"sha256:zzz\" }, \"\"},\n243|\t\t{\"bad_provider_manifest\", func(i *Inputs) { i.ProviderManifestID = \"sha256:zzz\" }, \"\"},\n244|\t\t{\"bad_bundle\", func(i *Inputs) { i.TaskBoardBundleID = \"sha256:zzz\" }, \"\"},\n245|\t\t{\"bad_provider_id\", func(i *Inputs) { i.Boundary.ProviderID = \"Codex!\" }, \"\"},\n246|\t\t{\"empty_provider_version\", func(i *Inputs) { i.Boundary.ProviderVersion = \"\" }, \"\"},\n247|\t\t{\"bad_evidence\", func(i *Inputs) { i.Boundary.Evidence = \"provider_gossip\" }, \"safe_boundary\"},\n248|\t\t{\"bad_created_at\", func(i *Inputs) { i.CreatedAt = \"2026-08-19 04:09:30\" }, \"\"},\n249|\t\t{\"bad_extension_key\", func(i *Inputs) { i.Extensions = map[string]string{\"pid\": \"4242\"} }, \"\"},\n250|\t}\n251|\tfor _, tc := range cases {\n252|\t\tt.Run(tc.name, func(t *testing.T) {\n253|\t\t\tstore := openTestStore(t)\n254|\t\t\tinputs := testInputs(heads, testOpA)\n255|\t\t\ttc.mutate(&inputs)\n256|\t\t\t_, _, err := store.Capture(chain, inputs)\n257|\t\t\tmustInvalid(t, err, \"Capture(member)\")\n258|\t\t\tif tc.wantOwn != \"\" && !strings.Contains(err.Error(), tc.wantOwn) {\n259|\t\t\t\tt.Fatalf(\"error = %v, want the capture gate named (%q)\", err, tc.wantOwn)\n260|\t\t\t}\n261|\t\t})\n262|\t}\n263|\t// Sixty-five extensions exceed the owner bound.\n264|\tt.Run(\"too_many_extensions\", func(t *testing.T) {\n265|\t\tstore := openTestStore(t)\n266|\t\tinputs := testInputs(heads, testOpA)\n267|\t\tinputs.Extensions = map[string]string{}\n268|\t\tfor i := 0; i < 65; i++ {\n269|\t\t\tinputs.Extensions[\"works.relux.ax.test.\"+string(rune('a'+i/26))+string(rune('a'+i%26))] = \"x\"\n270|\t\t}\n271|\t\t_, _, err := store.Capture(chain, inputs)\n272|\t\tmustInvalid(t, err, \"Capture(65 extensions)\")\n273|\t})\n274|}\n275|\n276|func TestAdmitRefusesMalformedFrames(t *testing.T) {\n277|\tchain, created := chainFixture(t)\n278|\tstore := openTestStore(t)\n279|\t// Not JSON at all.\n280|\tif _, err := store.Admit(chain, []byte(\"{\"), testOpA, SessionKindDirect); err == nil {\n281|\t\tt.Fatalf(\"Admit(truncated) error = nil, want refusal\")\n282|\t} else {\n283|\t\tmustInvalid(t, err, \"Admit(truncated)\")\n284|\t}\n285|\t// Wrong schema.\n286|\t_, raw := mustCapture(t, store, chain, testInputs([]string{created}, testOpA))\n287|\twrong := mutateRaw(t, raw, func(value map[string]any) {\n288|\t\tvalue[\"schema\"] = \"urn:ax:schema:lease\"\n289|\t})\n290|\tif _, err := store.Admit(chain, wrong, testOpB, SessionKindDirect); err == nil {\n291|\t\tt.Fatalf(\"Admit(wrong schema) error = nil, want refusal\")\n292|\t} else {\n293|\t\tmustInvalid(t, err, \"Admit(wrong schema)\")\n294|\t}\n295|\t// Tampered bytes under a fresh operation: the digest claim no\n296|\t// longer matches recomputation.\n297|\ttampered := mutateRaw(t, raw, func(value map[string]any) {\n298|\t\tvalue[\"lease_epoch\"] = float64(2)\n299|\t})\n300|\tif _, err := store.Admit(chain, tampered, testOpB, SessionKindDirect); err == nil {\n301|\t\tt.Fatalf(\"Admit(tampered) error = nil, want refusal\")\n302|\t} else {\n303|\t\tmustInvalid(t, err, \"Admit(tampered)\")\n304|\t}\n305|\t// Unknown session kind selects no variant.\n306|\tif _, err := store.Admit(chain, raw, testOpB, \"replica\"); err == nil {\n307|\t\tt.Fatalf(\"Admit(bad kind) error = nil, want refusal\")\n308|\t} else {\n309|\t\tmustInvalid(t, err, \"Admit(bad kind)\")\n310|\t}\n311|\t// Malformed operation identity.\n312|\tif _, err := store.Admit(chain, raw, \"not-a-uuid\", SessionKindDirect); err == nil {\n313|\t\tt.Fatalf(\"Admit(bad operation) error = nil, want refusal\")\n314|\t} else {\n315|\t\tmustInvalid(t, err, \"Admit(bad operation)\")\n316|\t}\n317|}\n318|\n319|func TestGetRefusesUnknownAndTorn(t *testing.T) {\n320|\tchain, created := chainFixture(t)\n321|\tstore := openTestStore(t)\n322|\tref, _ := mustCapture(t, store, chain, testInputs([]string{created}, testOpA))\n323|\t// Malformed digest.\n324|\tif _, err := store.Get(\"not-a-digest\"); err == nil {\n325|\t\tt.Fatalf(\"Get(malformed) error = nil, want refusal\")\n326|\t} else {\n327|\t\tmustInvalid(t, err, \"Get(malformed)\")\n328|\t}\n329|\t// Well-formed but absent digest: operational, never an\n330|\t// attested record.\n331|\tif _, err := store.Get(testOtherManifest); err == nil {\n332|\t\tt.Fatalf(\"Get(absent) error = nil, want refusal\")\n333|\t} else if errors.Is(err, ErrInvalidCheckpoint) {\n334|\t\tt.Fatalf(\"Get(absent) = %v, want an operational error, not the invalid-closure class\", err)\n335|\t}\n336|\t// A torn blob at a real digest path refuses attestation:\n337|\t// every visible byte still passes through the owner, so torn\n338|\t// state is a refusal, never an admission.\n339|\tif err := os.WriteFile(store.blobPath(ref.CheckpointID), []byte(`{\"schema\":\"urn:ax:schema:checkpoint\"}`), 0o600); err != nil {\n340|\t\tt.Fatal(err)\n341|\t}\n342|\tif _, err := store.Get(ref.CheckpointID); err == nil {\n343|\t\tt.Fatalf(\"Get(torn) error = nil, want refusal\")\n344|\t} else {\n345|\t\tmustInvalid(t, err, \"Get(torn)\")\n346|\t}\n347|}","final_result":true}}}
