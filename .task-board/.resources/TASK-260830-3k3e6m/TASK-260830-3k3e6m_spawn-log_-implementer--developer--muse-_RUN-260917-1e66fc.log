    \"codex\",\n133|\t\tProviderVersion:     \"0.147.0\",\n134|\t\tEvidence:            EvidenceAcceptedTest,\n135|\t\tInputBlocked:        true,\n136|\t\tForegroundIdle:      true,\n137|\t\tBackgroundIdle:      true,\n138|\t\tOpenProcesses:       0,\n139|\t\tOpenDatabaseHandles: 0,\n140|\t}\n141|}\n142|\n143|// testInputs returns the direct-kind closure over the given heads\n144|// and operation.\n145|func testInputs(heads []string, operation string) Inputs {\n146|\treturn Inputs{\n147|\t\tOperationID:         operation,\n148|\t\tSessionID:           testSessionID,\n149|\t\tSessionKind:         SessionKindDirect,\n150|\t\tLeaseEpoch:          1,\n151|\t\tLeaseID:             testLease,\n152|\t\tCreatorHostID:       testHostA,\n153|\t\tWorkspaceManifestID: testWorkspaceManifest,\n154|\t\tProviderManifestID:  testProviderManifest,\n155|\t\tTaskBoardBundleID:   \"\",\n156|\t\tBoundary:            testBoundary(),\n157|\t\tEventHeads:          heads,\n158|\t\tCreatedAt:           testCreatedAt,\n159|\t\tExtensions:          map[string]string{},\n160|\t}\n161|}\n162|\n163|// openTestStore binds an empty checkpoint store in a temp dir.\n164|func openTestStore(t *testing.T) *Store {\n165|\tt.Helper()\n166|\tstore, err := Open(t.TempDir())\n167|\tif err != nil {\n168|\t\tt.Fatal(err)\n169|\t}\n170|\treturn store\n171|}\n172|\n173|// chainFixture persists a session with its bootstrap event and\n174|// returns the repository with the created event digest.\n175|func chainFixture(t *testing.T) (*sessrepo.Repository, string) {\n176|\tt.Helper()\n177|\trepo, err := sessrepo.Open(t.TempDir())\n178|\tif err != nil {\n179|\t\tt.Fatal(err)\n180|\t}\n181|\trecord := decodeObject(t, specSessionRecord)\n182|\trecord[\"session_id\"], record[\"subject_id\"], record[\"name\"] = testSessionID, testSessionID, \"alpha\"\n183|\tref, err := repo.CreateSession(identify(t, record, \"record_id\"))\n184|\tif err != nil {\n185|\t\tt.Fatal(err)\n186|\t}\n187|\tcreated := appendChainEvent(t, repo, \"session.created\", 1, testLease, 1, ref.RecordID, map[string]any{\n188|\t\t\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": testHostA, \"first_checkpoint_operation_id\": testHostB,\n189|\t})\n190|\treturn repo, created\n191|}\n192|\n193|// appendChainEvent chains one session event under an explicit\n194|// envelope lease and returns its digest.\n195|func appendChainEvent(t *testing.T, repo *sessrepo.Repository, typ string, epoch uint64, leaseID string, sequence int, predecessor string, payload map[string]any) string {\n196|\tt.Helper()\n197|\tvalue := map[string]any{\n198|\t\t\"schema\": \"urn:ax:schema:session-event\", \"schema_version\": \"1.0.0\", \"event_id\": zeroDigest,\n199|\t\t\"subject_id\": testSessionID, \"session_id\": testSessionID, \"event_type\": typ, \"created_by_host_id\": testHostA,\n200|\t\t\"lease_epoch\": epoch, \"lease_id\": leaseID, \"lease_sequence\": sequence, \"predecessors\": []string{predecessor},\n201|\t\t\"created_at\": \"2026-08-19T04:00:00.000Z\", \"payload\": payload, \"extensions\": map[string]any{},\n202|\t}\n203|\tref, err := repo.AppendEvent(testSessionID, identify(t, value, \"event_id\"))\n204|\tif err != nil {\n205|\t\tt.Fatal(err)\n206|\t}\n207|\treturn ref.EventID\n208|}\n209|\n210|// leaseRecordBytes builds one epoch-1 lease naming the given\n211|// checkpoint, identified through the canonical owner.\n212|func leaseRecordBytes(t *testing.T, leaseID, holder, checkpoint string) []byte {\n213|\tt.Helper()\n214|\tvalue := map[string]any{\n215|\t\t\"schema\": \"urn:ax:schema:lease\", \"schema_version\": \"1.0.0\", \"record_id\": zeroDigest,\n216|\t\t\"subject_id\": testSessionID, \"session_id\": testSessionID, \"lease_id\": leaseID, \"epoch\": float64(1),\n217|\t\t\"holder_host_id\": holder, \"predecessor_lease_id\": nil, \"reason\": \"recovery\",\n218|\t\t\"checkpoint_id\": checkpoint, \"issued_by_host_id\": holder, \"created_by_host_id\": holder,\n219|\t\t\"created_at\": \"2026-08-19T04:09:00.000Z\", \"extensions\": map[string]any{},\n220|\t}\n221|\treturn identify(t, value, \"record_id\")\n222|}\n223|\n224|// mustCapture captures through the production entry or fails.\n225|func mustCapture(t *testing.T, store *Store, chain *sessrepo.Repository, inputs Inputs) (CheckpointRef, []byte) {\n226|\tt.Helper()\n227|\tref, raw, err := store.Capture(chain, inputs)\n228|\tif err != nil {\n229|\t\tt.Fatalf(\"Capture error = %v\", err)\n230|\t}\n231|\treturn ref, raw\n232|}\n233|\n234|// mustInvalid asserts the incompatible_schema refusal class on\n235|// both layers: the package sentinel and the owner sentinel the\n236|// SPEC CP-N1..CP-N4 language requires.\n237|func mustInvalid(t *testing.T, err error, what string) {\n238|\tt.Helper()\n239|\tif err == nil {\n240|\t\tt.Fatalf(\"%s error = nil, want invalid checkpoint closure\", what)\n241|\t}\n242|\tif !errors.Is(err, ErrInvalidCheckpoint) {\n243|\t\tt.Fatalf(\"%s error = %v, want ErrInvalidCheckpoint\", what, err)\n244|\t}\n245|\tif !errors.Is(err, canonicaljson.ErrInvalidIdentity) {\n246|\t\tt.Fatalf(\"%s error = %v, want incompatible_schema (ErrInvalidIdentity)\", what, err)\n247|\t}\n248|}\n249|\n250|func TestCaptureDirectInstallsAttestedRecord(t *testing.T) {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
