{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c56d","stream":{"kind":"session","id":"01a0adcc-09d6-79d1-9b97-6e93479b8dc1"},"sequence":273,"recorded_at":1780531400000541,"record_type":"event","durability":"durable","causation_id":"410e85d5-c650-4a55-ae65-44f1be1f0a3d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"410e85d5-c650-4a55-ae65-44f1be1f0a3d","run_stream":{"kind":"run","id":"410e85d5-c650-4a55-ae65-44f1be1f0a3d"},"task_stream":{"kind":"task","id":"01a0adcc-a92f-7830-af61-ec8555375a34"},"task_id":"01a0adcc-a92f-7830-af61-ec8555375a34","event":{"kind":"output","task_id":"01a0adcc-a92f-7830-af61-ec8555375a34","chunk":"Read text file `internal/sessckpt/store.go`.\n1|package sessckpt\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"runtime\"\n9|\t\"sync\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// ErrInvalidCheckpoint reports a checkpoint closure that must be\n15|// refused before publication. It always wraps\n16|// canonicaljson.ErrInvalidIdentity, so errors.Is proves the SPEC\n17|// Section 5.4 incompatible_schema class for every unpublishable\n18|// closure, including the CP-N1..CP-N4 fixtures.\n19|var ErrInvalidCheckpoint = errors.New(\"invalid checkpoint closure\")\n20|\n21|// ErrCheckpointConflict reports the idempotency boundary: the same\n22|// capture operation retried with moved inputs\n23|// (idempotency_mismatch), or a digest path holding bytes that\n24|// disagree with the installing candidate (a torn store, never a\n25|// second version of an immutable record).\n26|var ErrCheckpointConflict = errors.New(\"checkpoint capture conflict\")\n27|\n28|// Store durably installs Checkpoint Records and their operation\n29|// receipts under one data root. Checkpoint blobs are\n30|// content-addressed and installed no-replace, so capture is\n31|// append-only by construction and there is no update or delete\n32|// entry to test.\n33|//\n34|// BeforeWrite fires after validation and before the first durable\n35|// byte; AfterBlob fires after the checkpoint blob is durable and\n36|// before the operation receipt; AfterCommit fires after the receipt\n37|// is durable. All three are nil in normal operation. Tests connect\n38|// them to a secconftest Injector firing the owner's own points: a\n39|// fault before any durable byte carries safe_retry, a fault past\n40|// any durable step carries recoverable_parked_state until the\n41|// identical retry replays the recorded result, and a fault past\n42|// the receipt carries safe_retry through the replayed receipt.\n43|type Store struct {\n44|\troot        string\n45|\tmutex       sync.Mutex\n46|\tBeforeWrite func() error\n47|\tAfterBlob   func() error\n48|\tAfterCommit func() error\n49|}\n50|\n51|// Open binds a checkpoint store to the checkpoints namespace beneath\n52|// dataRoot, creating it owner-only when absent. The root must be\n53|// absolute.\n54|func Open(dataRoot string) (*Store, error) {\n55|\tif !filepath.IsAbs(dataRoot) {\n56|\t\treturn nil, fmt.Errorf(\"%w: data root %q is not absolute\", ErrInvalidCheckpoint, dataRoot)\n57|\t}\n58|\troot := filepath.Join(dataRoot, \"checkpoints\")\n59|\tif err := os.MkdirAll(root, 0o700); err != nil {\n60|\t\treturn nil, fmt.Errorf(\"create checkpoints root %q: %w\", root, err)\n61|\t}\n62|\t// The operations namespace shares the root so one data-root\n63|\t// fsync discipline covers blobs and receipts together.\n64|\tif err := os.MkdirAll(filepath.Join(root, \"operations\"), 0o700); err != nil {\n65|\t\treturn nil, fmt.Errorf(\"create checkpoint operations root: %w\", err)\n66|\t}\n67|\treturn &Store{root: root}, nil\n68|}\n69|\n70|// CheckpointRef names one durably installed Checkpoint Record: its\n71|// canonical digest and the operation receipt that installed it.\n72|type CheckpointRef struct {\n73|\tCheckpointID string\n74|\tOperationID  string\n75|}\n76|\n77|// checkpointFileName maps a validated checkpoint digest to its blob\n78|// file name. The digest passed scalar grammar before install;\n79|// invalid input maps to a sentinel name that can never collide\n80|// with a real blob.\n81|func checkpointFileName(checkpointID string) string {\n82|\tdigest, err := scalar.ParseDigest(checkpointID)\n83|\tif err != nil {\n84|\t\treturn \"invalid.json\"\n85|\t}\n86|\treturn digest.Hex() + \".json\"\n87|}\n88|\n89|// operationFileName maps a validated operation UUID to its receipt\n90|// file name. UUIDv7 grammar keeps the file name an exact,\n91|// case-stable rendering of the operation identity.\n92|func operationFileName(operationID string) string {\n93|\tid, err := scalar.ParseUUIDv7(operationID)\n94|\tif err != nil {\n95|\t\treturn \"invalid.json\"\n96|\t}\n97|\treturn id.String() + \".json\"\n98|}\n99|\n100|// installBlob installs one content-addressed blob idempotently\n101|// through the no-replace open first: a fresh path is created\n102|// atomically, and only an EEXIST loser falls back to comparing\n103|// against the winner's bytes — identical bytes are reused,\n104|// disagreeing bytes report the torn store for refusal. Leading\n105|// with the exclusive create (instead of stat-then-act) keeps the\n106|// no-replace property a filesystem fact under a second process,\n107|// not a check-then-act race the store mutex cannot see: the mutex\n108|// serializes one process, while O_EXCL serializes all of them.\n109|func installBlob(path string, data []byte) error {\n110|\tif err := writeExclusive(path, data); err == nil {\n111|\t\treturn syncDirectory(filepath.Dir(path))\n112|\t} else if !os.IsExist(err) {\n113|\t\treturn fmt.Errorf(\"install checkpoint blob: %w\", err)\n114|\t}\n115|\texisting, readErr := os.ReadFile(path)\n116|\tif readErr != nil {\n117|\t\treturn fmt.Errorf(\"read checkpoint blob for compare: %w\", readErr)\n118|\t}\n119|\tif string(existing) != string(data) {\n120|\t\treturn fmt.Errorf(\"%w: digest path holds disagreeing bytes\", ErrCheckpointConflict)\n121|\t}\n122|\treturn nil\n123|}\n124|\n125|// writeExclusive installs bytes at a path that must not exist. The\n126|// no-replace open makes append-only a filesystem property, not a\n127|// convention. Bytes fsync before close so a crash never leaves a\n128|// torn prefix behind.\n129|func writeExclusive(path string, data []byte) error {\n130|\tfile, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)\n131|\tif err != nil {\n132|\t\treturn err\n133|\t}\n134|\tif _, err := file.Write(data); err != nil {\n135|\t\t_ = file.Close()\n136|\t\treturn fmt.Errorf(\"write exclusive file: %w\", err)\n137|\t}\n138|\tif err := file.Sync(); err != nil {\n139|\t\t_ = file.Close()\n140|\t\treturn fmt.Errorf(\"fsync exclusive file: %w\", err)\n141|\t}\n142|\tif err := file.Close(); err != nil {\n143|\t\treturn fmt.Errorf(\"close exclusive file: %w\", err)\n144|\t}\n145|\treturn nil\n146|}\n147|\n148|// syncDirectory fsyncs a directory so an install inside it survives\n149|// a crash. Opening a directory fails on Windows, where the install\n150|// itself is the durability boundary; there the sync is skipped,\n151|// never faked.\n152|func syncDirectory(path string) error {\n153|\tif runtime.GOOS == \"windows\" {\n154|\t\treturn nil\n155|\t}\n156|\tdirectory, err := os.Open(path)\n157|\tif err != nil {\n158|\t\treturn fmt.Errorf(\"open directory for fsync: %w\", err)\n159|\t}\n160|\tdefer func() { _ = directory.Close() }()\n161|\tif err := directory.Sync(); err != nil {\n162|\t\treturn fmt.Errorf(\"fsync directory: %w\", err)\n163|\t}\n164|\treturn nil\n165|}","final_result":true}}}
