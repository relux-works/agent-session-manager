{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6c9","stream":{"kind":"session","id":"01a0ae11-990a-7e72-a802-0a0580c41ec6"},"sequence":447,"recorded_at":1780531400000889,"record_type":"event","durability":"durable","causation_id":"46e4ecbd-d202-41f9-9d18-3e98ef6b52fc","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"46e4ecbd-d202-41f9-9d18-3e98ef6b52fc","run_stream":{"kind":"run","id":"46e4ecbd-d202-41f9-9d18-3e98ef6b52fc"},"call_id":"call_01a0ae12ebf9775f9bd365199c985775","text":"Read text file `internal/matjournal/journal.go`.\n1|package matjournal\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/base64\"\n6|\t\"encoding/json\"\n7|\t\"errors\"\n8|\t\"fmt\"\n9|\t\"regexp\"\n10|\t\"sort\"\n11|\t\"strings\"\n12|\t\"unicode/utf8\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n17|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n18|)\n19|\n20|// Journal schema identity the store binds.\n21|const (\n22|\tjournalSchema     = \"urn:ax:schema:materialization-journal\"\n23|\tjournalVersion    = \"2.0.0\"\n24|\tjournalKind       = \"journal\"\n25|\tmarkerKind        = \"managed_replica_marker\"\n26|\textensionsMaximum = 64\n27|\t// lastErrorVersion is the Structured Error version journal\n28|\t// failures encode: 1.2.0 is the earliest version registering\n29|\t// every code recovery emits (operation_uncertain, the parked-\n30|\t// ambiguity code, registers at 1.2.0 and not below).\n31|\tlastErrorVersion = axerror.Version120\n32|)\n33|\n34|// Journal phases (SPEC Section 10.6). The task text predates the pinned\n35|// revision and omits failed; the pinned phase enum carries it, and the\n36|// store implements all eight values.\n37|const (\n38|\tPhaseStaging     = \"staging\"\n39|\tPhaseValidating  = \"validating\"\n40|\tPhasePrepared    = \"prepared\"\n41|\tPhaseCommitting  = \"committing\"\n42|\tPhaseRollingBack = \"rolling_back\"\n43|\tPhaseRolledBack  = \"rolled_back\"\n44|\tPhaseCommitted   = \"committed\"\n45|\tPhaseFailed      = \"failed\"\n46|)\n47|\n48|// Provider transaction states (SPEC Section 10.6).\n49|const (\n50|\tProviderUnknown    = \"unknown\"\n51|\tProviderPrepared   = \"prepared\"\n52|\tProviderCommitted  = \"committed\"\n53|\tProviderRolledBack = \"rolled_back\"\n54|)\n55|\n56|// Task-board transaction states (SPEC Section 10.6).\n57|const (\n58|\tBoardNotStarted       = \"not_started\"\n59|\tBoardImported         = \"imported\"\n60|\tBoardOpened           = \"opened\"\n61|\tBoardAdopted          = \"adopted\"\n62|\tBoardResumed          = \"resumed\"\n63|\tBoardDormantFinalized = \"dormant_finalized\"\n64|\tBoardRolledBack       = \"rolled_back\"\n65|\tBoardFailed           = \"failed\"\n66|)\n67|\n68|// Task-board activation modes (SPEC Section 10.6).\n69|const (\n70|\tModeDormantReplica    = \"dormant_replica\"\n71|\tModeOwnerResume       = \"owner_resume\"\n72|\tModeOwnershipTransfer = \"ownership_transfer\"\n73|\tModeFork              = \"fork\"\n74|)\n75|\n76|// Authority states (SPEC Section 10.6).\n77|const (\n78|\tAuthorityStaging    = \"staging\"\n79|\tAuthorityPrepared   = \"prepared\"\n80|\tAuthorityCommitted  = \"committed\"\n81|\tAuthorityRolledBack = \"rolled_back\"\n82|)\n83|\n84|// Plan authority kinds (SPEC Section 10.5 RootAuthority union).\n85|const (\n86|\tPlanKindWorkspace        = \"workspace\"\n87|\tPlanKindProviderStore    = \"provider_store\"\n88|\tPlanKindTaskBoardStaging = \"task_board_staging\"\n89|)\n90|\n91|// Provider transaction authority literals (SPEC Section 7.5).\n92|const (\n93|\ttxAuthorityID     = \"provider_transaction\"\n94|\ttxAuthorityKind   = \"provider_transaction\"\n95|\ttxAuthorityLayout = \"provider_transaction_v1\"\n96|\ttxAuthorityAccess = \"read_write\"\n97|)\n98|\n99|// Journal cardinality bounds (SPEC Section 10.6).\n100|const (\n101|\tmaxAuthorities       = 512\n102|\tmaxBlobs             = 65536\n103|\tmaxChunksPerBlob     = 32768\n104|\tmaxVerifiedBlobs     = 65536\n105|\tmaxSequences         = 65536\n106|\tmaxSameFilesystemIDs = 32\n107|\tminSameFilesystemIDs = 1\n108|)\n109|\n110|// Token bounds: base64url-256+ encodes 32..512 bytes (SPEC Section 1.6).\n111|const (\n112|\tminTokenBytes = 32\n113|\tmaxTokenBytes = 512\n114|)\n115|\n116|// uint53Max is the AX safe-integer ceiling (SPEC Section 1.6).\n117|const uint53Max = uint64(1<<53 - 1)\n118|\n119|// ErrInvalidJournal reports a journal shape or transition the Section 10.6\n120|// contract refuses.\n121|var ErrInvalidJournal = errors.New(\"invalid materialization journal\")\n122|\n123|// ErrJournalConflict reports the idempotency boundary: the same operation\n124|// retried with a byte-unequal body (idempotency_mismatch), or a digest\n125|// path holding disagreeing bytes (a torn store, never a second version\n126|// of an immutable sidecar).\n127|var ErrJournalConflict = errors.New(\"materialization journal conflict\")\n128|\n129|// ErrUnknownJournal reports a materialization with no journal: absence,\n130|// never torn state.\n131|var ErrUnknownJournal = errors.New(\"unknown materialization journal\")\n132|\n133|// Journal is the typed Materialization Journal 2.0.0 document: the exact\n134|// closed 22-member object of SPEC Section 10.6. Nullable members use\n135|// pointers so null round-trips exactly; LastError is nil for null and\n136|// otherwise the exact Section 15.1 object bytes.\n137|type Journal struct {\n138|\tSchema                    string                    `json:\"schema\"`\n139|\tSchemaVersion             string                    `json:\"schema_version\"`\n140|\tDocumentKind              string                    `json:\"document_kind\"`\n141|\tMaterializationID         string                    `json:\"materialization_id\"`\n142|\tPrepareOperationID        string                    `json:\"prepare_operation_id\"`\n143|\tPrepareRequestDigest      string                    `json:\"prepare_request_digest\"`\n144|\tTransferID                *string                   `json:\"transfer_id\"`\n145|\tPlanID                    string                    `json:\"plan_id\"`\n146|\tSourceCheckpointID        string                    `json:\"source_checkpoint_id\"`\n147|\tManagedReplicaID          *string                   `json:\"managed_replica_id\"`\n148|\tAuthorityStates           map[string]AuthorityState `json:\"authority_states\"`\n149|\tExpectedPriorCheckpointID *string                   `json:\"expected_prior_checkpoint_id\"`\n150|\tCompletedBlobChunks       map[string][]uint32       `json:\"completed_blob_chunks\"`\n151|\tVerifiedBlobIDs           []string                  `json:\"verified_blob_ids\"`\n152|\tPhase                     string                    `json:\"phase\"`\n153|\tProvider                  *ProviderTransaction      `json:\"provider_transaction\"`\n154|\tTaskBoard                 *TaskBoardTransaction     `json:\"task_board_transaction\"`\n155|\tDestinationMarkerID       *string                   `json:\"destination_marker_id\"`\n156|\tLastError                 json.RawMessage           `json:\"last_error\"`\n157|\tStartedAt                 string                    `json:\"started_at\"`\n158|\tUpdatedAt                 string                    `json:\"updated_at\"`\n159|\tExtensions                map[string]any            `json:\"extensions\"`\n160|}\n161|\n162|// ProviderTransaction is the closed Provider Journal Transaction object.\n163|type ProviderTransaction struct {\n164|\tOperationID   string               `json:\"operation_id\"`\n165|\tTransactionID string               `json:\"transaction_id\"`\n166|\tState         string               `json:\"state\"`\n167|\tRollbackToken *string              `json:\"rollback_token\"`\n168|\tAuthority     TransactionAuthority `json:\"transaction_authority\"`\n169|\tLastStatusAt  string               `json:\"last_status_at\"`\n170|}\n171|\n172|// TransactionAuthority is the closed ProviderTransactionAuthority object\n173|// (SPEC Section 7.5).\n174|type TransactionAuthority struct {\n175|\tAuthorityID                        string   `json:\"authority_id\"`\n176|\tKind                               string   `json:\"kind\"`\n177|\tRootPath                           string   `json:\"root_path\"`\n178|\tLayout                             string   `json:\"layout\"`\n179|\tAccess                             string   `json:\"access\"`\n180|\tMaterializationID                  string   `json:\"materialization_id\"`\n181|\tProviderID                         string   `json:\"provider_id\"`\n182|\tTransactionID                      string   `json:\"transaction_id\"`\n183|\tPlanID                             string   `json:\"plan_id\"`\n184|\tSameFilesystemProviderAuthorityIDs []string `json:\"same_filesystem_provider_authority_ids\"`\n185|}\n186|\n187|// TaskBoardTransaction is the closed Task-board Journal Transaction\n188|// object: the exact 19-member shape of SPEC Section 10.6.\n189|type TaskBoardTransaction struct {\n190|\tBundleID          string     `json:\"bundle_id\"`\n191|\tActivationMode    string     `json:\"activation_mode\"`\n192|\tImportOperationID string     `json:\"import_operation_id\"`\n193|\tOpenOperationID   string     `json:\"open_operation_id\"`\n194|\tAdoptOperationID  string     `json:\"adopt_operation_id\"`\n195|\tResumeOperationID string     `json:\"resume_operation_id\"`\n196|\tState             string     `json:\"state\"`\n197|\tImportToken       *string    `json:\"import_token\"`\n198|\tStagedManagerRef  *string    `json:\"staged_manager_ref\"`\n199|\tImportExpiresAt   *string    `json:\"import_expires_at\"`\n200|\tOpenToken         *string    `json:\"open_token\"`\n201|\tDormantManagerRef *string    `json:\"dormant_manager_ref\"`\n202|\tOpenExpiresAt     *string    `json:\"open_expires_at\"`\n203|\tManagerSessionRef *string    `json:\"manager_session_ref\"`\n204|\tAxBinding         *AxBinding `json:\"ax_binding\"`\n205|\tLastBridgeState   *string    `json:\"last_bridge_state\"`\n206|\tLastStatusAt      *string    `json:\"last_status_at\"`\n207|\tCleanupState      string     `json:\"cleanup_state\"`\n208|\tCleanupAfter      *string    `json:\"cleanup_after\"`\n209|}\n210|\n211|// AxBinding is the exact closed bridge shape.\n212|type AxBinding struct {\n213|\tAxSessionID string `json:\"ax_session_id\"`\n214|\tLeaseEpoch  uint64 `json:\"lease_epoch\"`\n215|\tLeaseID     string `json:\"lease_id\"`\n216|}\n217|\n218|// AuthorityState is the closed Authority Journal State object.\n219|type AuthorityState struct {\n220|\tRootPath            string   `json:\"root_path\"`\n221|\tCompletedSequences  []uint64 `json:\"completed_sequences\"`\n222|\tObservedPriorDigest *string  `json:\"observed_prior_digest\"`\n223|\tRollbackRoot        *string  `json:\"rollback_root\"`\n224|\tState               string   `json:\"state\"`\n225|}\n226|\n227|// PlanAuthority is the routing view of one plan RootAuthority (SPEC\n228|// Section 10.5): the kind, platform, and root path the journal\n229|// cross-checks its authority states against. The full plan stays an\n230|// opaque digest input owned by the shape owner; this view carries only\n231|// the routing facts the journal rules name.\n232|type PlanAuthority struct {\n233|\tID       string\n234|\tKind     string\n235|\tPlatform string\n236|\tRootPath string\n237|}\n238|\n239|// planView is the durably installed routing view: the executing host\n240|// platform, one entry per plan RootAuthority, and the bound bridge\n241|// operation keys when a bridge participates.\n242|type planView struct {\n243|\tHostPlatform string                   `json:\"host_platform\"`\n244|\tAuthorities  map[string]PlanAuthority `json:\"authorities\"`\n245|\tBridge       *bridgeIDs               `json:\"bridge_operation_ids\"`\n246|}\n247|\n248|// CreateInputs is the typed materialize.prepare closure: caller-stable\n249|// IDs allocated before the first request, the complete canonical\n250|// request body, the plan/checkpoint digests, the plan authority routing\n251|// view, and the bridge key set (allocated with the materialization ID\n252|// when a task-board bridge participates, empty otherwise).\n253|type CreateInputs struct {\n254|\tMaterializationID         string\n255|\tPrepareOperationID        string\n256|\tRequestBody               []byte\n257|\tTransferID                string\n258|\tPlanID                    string\n259|\tSourceCheckpointID        string\n260|\tManagedReplicaID          string\n261|\tPlan                      []PlanAuthority\n262|\tHostPlatform              string\n263|\tExpectedPriorCheckpointID string\n264|\tBundleID                  string\n265|\tActivationMode            string\n266|\tImportOperationID         string\n267|\tOpenOperationID           string\n268|\tAdoptOperationID          string\n269|\tResumeOperationID         string\n270|\tExtensions                map[string]string\n271|}\n272|\n273|// invalid refuses a journal shape or transition with the package\n274|// sentinel. It is a function, not a method, so every gate site reads\n275|// identically.\n276|func invalid(format string, arguments ...any) error {\n277|\treturn fmt.Errorf(\"%w: %s\", ErrInvalidJournal, fmt.Sprintf(format, arguments...))\n278|}\n279|\n280|// conflict refuses an idempotency-boundary violation with the package\n281|// conflict sentinel.\n282|func conflict(format string, arguments ...any) error {\n283|\treturn fmt.Errorf(\"%w: %s\", ErrJournalConflict, fmt.Sprintf(format, arguments...))\n284|}\n285|\n286|// rootIDPattern is the Section 7.5 root-id grammar.\n287|var rootIDPattern = regexp.MustCompile(`^[a-z][a-z0-9_-]{0,63}$`)\n288|\n289|// checkRootID admits one authority routing label.\n290|func checkRootID(value string) (string, error) {\n291|\tif !rootIDPattern.MatchString(value) {\n292|\t\treturn \"\", invalid(\"authority id %q is outside the root-id grammar\", value)\n293|\t}\n294|\treturn value, nil\n295|}\n296|\n297|// checkUUIDv7 admits one caller-stable identity.\n298|func checkUUIDv7(value, name string) (string, error) {\n299|\tid, err := scalar.ParseUUIDv7(value)\n300|\tif err != nil {\n301|\t\treturn \"\", invalid(\"%s %q: %v\", name, value, err)\n302|\t}\n303|\treturn id.String(), nil\n304|}\n305|\n306|// checkDigest admits one content digest.\n307|func checkDigest(value, name string) (string, error) {\n308|\tdigest, err := scalar.ParseDigest(value)\n309|\tif err != nil {\n310|\t\treturn \"\", invalid(\"%s %q: %v\", name, value, err)\n311|\t}\n312|\treturn digest.String(), nil\n313|}\n314|\n315|// checkNullableDigest admits an empty-equals-null digest leg.\n316|func checkNullableDigest(value, name string) (*string, error) {\n317|\tif value == \"\" {\n318|\t\treturn nil, nil\n319|\t}\n320|\tdigest, err := scalar.ParseDigest(value)\n321|\tif err != nil {\n322|\t\treturn nil, invalid(\"%s %q: %v\", name, value, err)\n323|\t}\n324|\tout := digest.String()\n325|\treturn &out, nil\n326|}\n327|\n328|// checkNullableUUIDv7 admits an empty-equals-null UUIDv7 leg.\n329|func checkNullableUUIDv7(value, name string) (*string, error) {\n330|\tif value == \"\" {\n331|\t\treturn nil, nil\n332|\t}\n333|\tid, err := scalar.ParseUUIDv7(value)\n334|\tif err != nil {\n335|\t\treturn nil, invalid(\"%s %q: %v\", name, value, err)\n336|\t}\n337|\tout := id.String()\n338|\treturn &out, nil\n339|}\n340|\n341|// checkTimestamp admits one diagnostic instant. Instants never confer\n342|// authority, but their grammar is still closed.\n343|func checkTimestamp(value, name string) (string, error) {\n344|\tinstant, err := scalar.ParseTimestamp(value)\n345|\tif err != nil {\n346|\t\treturn \"\", invalid(\"%s %q: %v\", name, value, err)\n347|\t}\n348|\treturn instant.String(), nil\n349|}\n350|\n351|// checkPlatform admits one executing-host platform name.\n352|func checkPlatform(value, name string) (string, error) {\n353|\tplatform, err := scalar.ParsePlatform(value)\n354|\tif err != nil {\n355|\t\treturn \"\", invalid(\"%s %q: %v\", name, value, err)\n356|\t}\n357|\treturn platform.String(), nil\n358|}\n359|\n360|// checkAbsolutePath admits one machine-local absolute path under the\n361|// named platform.\n362|func checkAbsolutePath(platform scalar.Platform, value, name string) (string, error) {\n363|\tpath, err := scalar.ParseAbsolutePath(platform, value)\n364|\tif err != nil {\n365|\t\treturn \"\", invalid(\"%s %q: %v\", name, value, err)\n366|\t}\n367|\treturn path.String(), nil\n368|}\n369|\n370|// checkToken admits one base64url-256+ control token: the canonical\n371|// RFC 4648 URL-safe alphabet with no padding or whitespace, a\n372|// decode-then-re-encode fixpoint, and 32..512 decoded bytes.\n373|func checkToken(value, name string) (string, error) {\n374|\traw, err := base64.RawURLEncoding.DecodeString(value)\n375|\tif err != nil {\n376|\t\treturn \"\", invalid(\"%s is not unpadded base64url: %v\", name, err)\n377|\t}\n378|\tif base64.RawURLEncoding.EncodeToString(raw) != value {\n379|\t\treturn \"\", invalid(\"%s is not canonical base64url\", name)\n380|\t}\n381|\tif len(raw) < minTokenBytes || len(raw) > maxTokenBytes {\n382|\t\treturn \"\", invalid(\"%s decodes to %d bytes, want %d..%d\", name, len(raw), minTokenBytes, maxTokenBytes)\n383|\t}\n384|\treturn value, nil\n385|}\n386|\n387|// checkManagerRef admits one bridge manager reference: 1..512\n388|// characters of non-control UTF-8.\n389|func checkManagerRef(value, name string) (string, error) {\n390|\tif !utf8.ValidString(value) {\n391|\t\treturn \"\", invalid(\"%s is not valid UTF-8\", name)\n392|\t}\n393|\tif length := utf8.RuneCountInString(value); length < 1 || length > 512 {\n394|\t\treturn \"\", invalid(\"%s must contain 1..512 characters\", name)\n395|\t}\n396|\tfor _, character := range value {\n397|\t\tif character < 0x20 || character == 0x7f {\n398|\t\t\treturn \"\", invalid(\"%s must contain no control characters\", name)\n399|\t\t}\n400|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
