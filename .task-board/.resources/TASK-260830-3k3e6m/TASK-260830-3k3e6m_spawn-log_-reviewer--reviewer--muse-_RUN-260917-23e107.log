ll at prepared)\\\")\\n\\tif !strings.Contains(evidence.Reason, \\\"disk full\\\") {\\n\\t\\tt.Fatalf(\\\"reason = %q, want the disk-full row\\\", evidence.Reason)\\n\\t}\\n\\tloaded, _, err := store.Get(testMatID)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tif loaded.Phase != PhasePrepared {\\n\\t\\tt.Fatalf(\\\"phase = %q, want the preserved prepared journal\\\", loaded.Phase)\\n\\t}\\n}\\nEOF\\ncd /tmp/rev3k3e6m/cand && go test ./internal/matjournal/ -count=1 -run 'TestOwnDiskFullAtPreparedParks' -v 2>&1 | grep -E \\\"^(--- |ok|FAIL)\\\"\",\n  \"description\": \"Add and run disk-full row plant\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"--- PASS: TestOwnDiskFullAtPreparedParks (0.12s)\\nok  \\tgithub.com/relux-works/agent-session-manager/internal/matjournal\\t0.455s\\n\",\n  \"original_output_bytes\": 126,\n  \"original_output_tokens\": 32,\n  \"truncated\": false\n}","final_result":true}}}
