=32 compatibility_contracts=55 assigned_scopes=1\\\\n\\\" +\\ninternal/traceability/cmd/tracecheck/main_test.go:59:\\t\\t\\\"section coverage: bindings=59 full=1 partial=3 sliver=1 unevidenced=50 unmeasured=4 unowned=12 clauses_discharged=17/489\\\\n\\\"\\ninternal/traceability/cmd/tracecheck/main_test.go:558:\\tconst assignment = `reviewedOwnershipCanonicalSHA256 = \\\"`\\n\",\n  \"original_output_bytes\": 2957,\n  \"original_output_tokens\": 740,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
