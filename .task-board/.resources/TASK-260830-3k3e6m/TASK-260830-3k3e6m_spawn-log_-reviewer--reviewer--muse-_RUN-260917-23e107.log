\\tif string(existing) != string(data) {\\n\\t\\treturn fmt.Errorf(\\\"%w: sidecar path holds disagreeing bytes\\\", ErrJournalConflict)\\n\\t}\\n\\treturn nil\\n}\\n\\n// writeExclusive installs bytes at a path that must not exist. Bytes\\n===\\ninternal/matjournal/journal_test.go:209:func testProvider() ProviderTransaction {\\ninternal/matjournal/journal_test.go:232:func testBoardImported() TaskBoardTransaction {\\ninternal/matjournal/journal_test.go:252:func testBoardOpened() TaskBoardTransaction {\\ninternal/matjournal/journal_test.go:271:func testBoardAdopted() TaskBoardTransaction {\\ninternal/matjournal/journal_test.go:756:func testMarker(t *testing.T) []byte {\\n\",\n  \"original_output_bytes\": 5083,\n  \"original_output_tokens\": 1271,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
