+// mustFrame marshals one Structured Error to its wire bytes.
+func mustFrame(t *testing.T, failure *axerror.Error) json.RawMessage {
+	t.Helper()
+	framed, err := failure.MarshalJSON()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return framed
