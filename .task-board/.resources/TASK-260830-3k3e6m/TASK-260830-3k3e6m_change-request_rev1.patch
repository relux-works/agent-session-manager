+	// Cleanup consumes the rollback root before the committed
+	// terminal state.
+	if _, err := store.UpdateAuthority(testMatID, "board_staging", AuthorityState{
+		RootPath:            testStagingRoot,
+		CompletedSequences:  []uint64{1},
+		ObservedPriorDigest: nil,
