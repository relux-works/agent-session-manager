+// TestCaptureLiveHeadModes covers detached and unborn HEAD through the
+// production entry.
+func TestCaptureLiveHeadModes(t *testing.T) {
+	t.Parallel()
+	dir := initLiveRepo(t)
+
+	detached := captureLive(t, dir)
+	_ = detached
+
+	gitRun(t, dir, "checkout", "-q", "--detach", "HEAD")
+	snapshot := captureLive(t, dir)
