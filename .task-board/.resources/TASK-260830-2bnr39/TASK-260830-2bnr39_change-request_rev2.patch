+// TestCaptureLiveIndexFlags stages the worktree flags the grammar
+// admits: skip-worktree and intent-to-add alongside clear entries.
+func TestCaptureLiveIndexFlags(t *testing.T) {
+	t.Parallel()
+	dir := initLiveRepo(t)
