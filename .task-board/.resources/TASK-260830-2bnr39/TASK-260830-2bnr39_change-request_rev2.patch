+		byPath[entry.Path] = entry
+	}
+	agents, ok := byPath["AGENTS.md"]
+	if !ok || !agents.SkipWorktree || agents.AssumeUnchanged || agents.IntentToAdd {
+		t.Errorf("AGENTS.md entry = %+v, want only skip-worktree", agents)
