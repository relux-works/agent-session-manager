  status=('NEUTRAL_PASS' if c==0 else 'NEUTRAL_FAILED') if expect=='survive' else ('BEHAVIOR_KILL' if c and all(x in failing for x in fails) and p in (None,0) else 'SURVIVED_OR_WRONG_FAILURE')
