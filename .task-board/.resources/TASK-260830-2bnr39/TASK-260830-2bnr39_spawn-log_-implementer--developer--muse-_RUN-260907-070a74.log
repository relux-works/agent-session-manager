\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/canonicaljson/closed_shapes.go\\\",\\n  \\\"declaration\\\": \\\"validateImmutableObjectShape\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"scalar-digest-validation\\\",\\n  \\\"scalar-timestamp-validation\\\",\\n  \\\"scalar-uuid-validation\\\",\\n  \\\"canonical-object-identity\\\",\\n  \\\"canonical-identity-refusal\\\",\\n  \\\"core-record-identity-validation\\\",\\n  \\\"localstore-immutable-blob-install\\\"\\n ],\\n \\\"coverage\\\": \\\"unevidenced\\\",\\n \\\"gap\\\": \\\"validateImmutableObjectShape enforces the Section 10.1 common envelope, but the digest-derived storage path clause and the quarantine-and-stop clause are implemented in internal/localstore rather than by this binding, and no clause of Section 10.1 is enumerated.\\\"\\n}\\n---\\n{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:10.2\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/canonicaljson/closed_shapes.go\\\",\\n  \\\"declaration\\\": \\\"validateBlobDescriptor\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"scalar-digest-validation\\\",\\n  \\\"scalar-bounded-integer-validation\\\",\\n  \\\"canonical-jcs-rfc8785\\\",\\n  \\\"canonical-object-identity\\\",\\n  \\\"canonical-identity-refusal\\\",\\n  \\\"localstore-digest-path-v1\\\",\\n  \\\"localstore-immutable-blob-install\\\",\\n  \\\"localstore-sqlite-projection\\\"\\n ],\\n \\\"coverage\\\": \\\"unevidenced\\\",\\n \\\"gap\\\": \\\"validateBlobDescriptor validates the Section 10.2 Blob Descriptor shape, but no clause of Section 10.2 is enumerated against an acceptance case, so the registry makes no clause-level claim about its obligations.\\\"\\n}\\n---\\n{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:10.3\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/canonicaljson/closed_shapes.go\\\",\\n  \\\"declaration\\\": \\\"validateBlobDescriptor\\\"\\n },\\n \\\"acceptance_c