id</code>, and\n5012|<code>GitSubmodule.gitlink_oid</code> and\n5013|<code>GitSubmodule.head.oid</code> MUST name the same checked-out commit present\n5014|in the child pack inventory for this clean-pointer fixture. The child commit is\n5015|not present in the parent pack inventory.\n5016|\n5017|Normative workspace-group root fixture:\n5018|\n5019|~~~json\n5020|{\n5021|  \"schema\": \"urn:ax:schema:transfer-manifest\",\n5022|  \"schema_version\": \"1.0.0\",\n5023|  \"manifest_id\": \"sha256:a98ca90522b4de30e4aaaf9bf50529d09e15a817ffa67f94552fb313d1a1ad2e\",\n5024|  \"kind\": \"workspace_group\",\n5025|  \"subject_id\": \"0198f4c8-5b20-7c33-8c4d-1234567890ab\",\n5026|  \"base_checkpoint_id\": \"sha256:2222222222222222222222222222222222222222222222222222222222222222\",\n5027|  \"entries\": [],\n5028|  \"child_manifest_ids\": [\n5029|    \"sha256:7cff7402aa5a31ba0cd7ff9bf49a9dc166b961c9f2b647d1c1084d3e70ce5db8\",\n5030|    \"sha256:88d93f20f978b92e75d35e67ebd5a41b90ff1afe106363b05c0f7b08614eb4cf\",\n5031|    \"sha256:8dc15e881e026e7cf59482395baaa8c47341e6bad6d87f44312a9d0b360aacd5\"\n5032|  ],\n5033|  \"workspace_snapshot\": {\n5034|    \"workspace_group_id\": \"0198f4c8-5b20-7c33-8c4d-1234567890ab\",\n5035|    \"members\": [\n5036|      {\n5037|        \"workspace_id\": \"0198f4c8-6c30-7d44-8d5e-1234567890ab\",\n5038|        \"kind\": \"git\",\n5039|        \"group_relative_path\": \"payments-api\",\n5040|        \"repository_identity\": \"relux/payments-api\",\n5041|        \"remotes\": [\n5042|          {\"name\":\"origin\",\"fetch_url\":\"ssh://git@github.com/relux/payments-api.git\",\"push_url\":null}\n5043|        ],\n5044|        \"head\": {\"mode\":\"branch\",\"oid\":\"sha1:602548b4fd46332c934667db9992b8bb00318c88\",\"ref\":\"refs/heads/feature/ax\"},\n5045|        \"upstream_ref\": \"refs/remotes/origin/feature/ax\",\n5046|        \"object_pack\": {\n5047|          \"format\": \"git_pack_v2\",\n5048|          \"object_format\": \"sha1\",\n5049|          \"blob