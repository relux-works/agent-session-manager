a256:7cff7402aa5a31ba0cd7ff9bf49a9dc166b961c9f2b647d1c1084d3e70ce5db8\",\n5102|            \"submodules\": [],\n5103|            \"features\": {\n5104|              \"object_format\": \"sha1\",\n5105|              \"filemode\": true,\n5106|              \"symlinks\": true,\n5107|              \"case_sensitive\": true,\n5108|              \"precompose_unicode\": false,\n5109|              \"sparse_checkout\": false,\n5110|              \"sparse_patterns_blob_id\": null,\n5111|              \"sparse_patterns_blob_descriptor_id\": null,\n5112|              \"required_filter_names\": [],\n5113|              \"lfs_required\": false\n5114|            },\n5115|            \"repo_relative_cwd\": \".\",\n5116|            \"agent_project_config_paths\": []\n5117|          }\n5118|        ],\n5119|        \"features\": {\n5120|          \"object_format\": \"sha1\",\n5121|          \"filemode\": true,\n5122|          \"symlinks\": true,\n5123|          \"case_sensitive\": true,\n5124|          \"precompose_unicode\": false,\n5125|          \"sparse_checkout\": false,\n5126|          \"sparse_patterns_blob_id\": null,\n5127|          \"sparse_patterns_blob_descriptor_id\": null,\n5128|          \"required_filter_names\": [],\n5129|          \"lfs_required\": false\n5130|        },\n5131|        \"repo_relative_cwd\": \"src\",\n5132|        \"agent_project_config_paths\": [\"AGENTS.md\"],\n5133|        \"materialization_policy\": \"separate_worktree\"\n5134|      },\n5135|      {\n5136|        \"workspace_id\": \"0198f4c8-7d40-7e55-8e6f-2234567890ab\",\n5137|        \"kind\": \"managed_tree\",\n5138|        \"group_relative_path\": \"design-notes\",\n5139|        \"tree_identity\": \"relux/design-notes\",\n5140|        \"tree_manifest_id\": \"sha256:8dc15e881e026e7cf59482395baaa8c47341e6bad6d87f44312a9d0b360aacd5\",\n5141|        \"repo_relative_cwd\": \"drafts\",\n5142|        \"agent_project_config_paths\": [\"AGENTS.md\"],\n5143|        \"materialization_policy\": \"separate_copy\"\n5144|      }\n5145|    ]\n5146|  },\n5147|  \"provider_identity_record_id\": null,\n5148|  \"task_board_bundle_id\": null,\n5149|  \"excluded_classes\": [\"credential\",\"live_pid\",\"machine_auth\",\"socket\",\"transient_lock\"],\n5150|  \"created_by_host_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890ab\",\n5151|  \"created_at\": \"2026-08-19T04:15:00.000Z\",\n5152|  \"extensions\": {}\n5153|}\n5154|~~~\n5155|\n5156|The <code>WS-GIT-ROUNDTRIP-1</code> fixture represented above has branch\n5157|<code>refs/heads/feature/ax</code>, a staged <code>README.md</code> blob OID\n5158|<code>sha1:19d9cc8584ac2c7dcf57d2680375e80f099dc481</code>, working bytes\n5159|<code>working\\n</code>, untracked bytes <code>notes\\n</code>, an initialized\n5160|detached submodule, cwd <code>src</code>, and project config\n5161|<code>AGENTS.md</code>. A round trip MUST reproduce all those facts, byte-for-\n5162|byte index semantics, and zero network fetch. The\n5163|<code>WS-TREE-ROUNDTRIP-1</code> member must reproduce <code>AGENTS.md</code>,\n5164|the <code>drafts</code> directory, <code>drafts/note.md</code>, its cwd, modes,\n5165|and policy. HEAD-only, index-only, or working-tree-only equality is a failure.\n5166|\n5167|The submodule-pointer fixtures use the ordered triple\n5168|<code>(head_tree_gitlink_oid, GitSubmodule.gitlink_oid,\n5169|GitSubmodule.head.oid)</code>:\n5170|\n5171|| Fixture | Relationship | Meaning/result |\n5172|| --- | --- | --- |\n5173|| <code>WS-SUBMODULE-CLEAN</code> | <code>(A,A,A)</code> | No staged or unstaged submodule pointer change |\n5174|| <code>WS-SUBMODULE-STAGED</code> | <code>(A,B,B)</code> | Parent index stages B while the child checkout matches the staged pointer |\n5175|| <code>WS-SUBMODULE-UNSTAGED</code> | <code>(A,A,B)</code> | Parent index remains A while the checked-out child moved to B |\n5176|| <code>WS-SUBMODULE-BOTH</code> | <code>(A,B,C)</code> | Staged pointer B and further unstaged child movement C are both preserved |\n5177|\n5178|For every row, A is extracted as the mode-160000 entry from the superproject\n5179|HEAD tree that resolves in the isolated parent pack; A names a child commit but\n5180|that child commit object is not required or permitted merely to satisfy the\n5181|parent-pack closure. B and C MUST resolve as commits in the isolated child\n5182|pack. When A equals B or C, that equal OID is still object-resolved only in the\n5183|child repository. Capture and materialization MUST retain the exact triple and\n5184|MUST NOT normalize the index to the checked-out child or copy a child commit\n5185|into the parent object database.\n5186|\n5187|Normative negative fixtures are:\n5188|\n5189|| Fixture | Mutation | Required result |\n5190|| --- | --- | --- |\n5191|| <code>TM-ENTRY-DIR-N1</code> | Add <code>blob_id</code> to a directory | Reject unknown/forbidden variant member |\n5192|| <code>TM-ENTRY-FILE-N1</code> | Descriptor size differs from file size | <code>integrity_failure</code> |\n5193|| <code>TM-ENTRY-SYM-N1</code> | Target escapes with <code>../</code> | <code>unsafe_path</code> |\n5194|| <code>TM-ENTRY-HARD-N1</code> | Target is later or not a file | <code>incompatible_schema</code> |\n5195|| <code>TM-GIT-N1</code> | Omit raw index or logical entries | <code>incompatible_schema</code> |\n5196|| <code>TM-GIT-N2</code> | Set entry count to a different length or stage to 4 | <code>incompatible_schema</code> |\n5197|| <code>TM-GIT-N3</code> | Detached HEAD carries a ref | <code>incompatible_schema</code> |\n5198|| <code>TM-GIT-N4</code> | Working-tree manifest or project config is outside child closure | <code>integrity_failure</code> |\n5199|| <code>TM-GIT-N5</code> | Initialized submodule omits its recursive manifest | <code>incompatible_schema</code> |\n5200|| <code>TM-GIT-N6</code> | <code>gitlink_oid</code> differs from the parent stage-0 mode-160000 index entry | <code>integrity_failure</code> |\n5201|| <code>TM-GIT-N7</code> | Child HEAD is checked only after parent and child packs are co-mingled | Reject the validation evidence; each pack must pass in an isolated object database |\n5202|| <code>TM-TREE-N1</code> | Managed-tree member carries any Git field | Reject unknown/forbidden variant member |\n5203|| <code>TM-ROOT-N1</code> | Workspace root has entries or omits a member child | <code>incompatible_schema</code> |\n5204|\n5205|An encoded identity-addressed JSON/CBOR object MUST NOT exceed 5,242,880 bytes.\n5206|A larger entry or index list MUST be partitioned into path-disjoint child\n5207|manifests; every child and root independently obey the size limit. Devices,\n5208|FIFOs, sockets, reparse points, alternate data streams, and unknown special\n5209|files are unsupported and MUST fail unless an explicit exclusion applies.\n5210|\n5211|Mode preserves Unix executable and ordinary read/write bits. ACLs, ownership,\n5212|code-signing metadata, quarantine flags, arbitrary xattrs, NTFS alternate\n5213|streams, and resource forks are not portable in v0.3.0. If one is required for\n5214|a provider or workspace, that provider/platform cell MUST be conditional or\n5215|unsupported rather than silently dropping it.\n5216|\n5217|### 10.5 Materialization Plan\n5218|\n5219|Materialization Plan schema\n5220|<code>urn:ax:schema:materialization-plan</code> version <code>1.0.0</code> is\n5221|immutable and authorizes only the exact staged changes it lists. It is not an\n5222|ownership grant.\n5223|\n5224|Its top-level object is closed and contains exactly:\n5225|\n5226|| Field | Type | Constraint |\n5227|| --- | --- | --- |\n5228|| <code>schema</code> | string | Exact Materialization Plan schema identifier |\n5229|| <code>schema_version</code> | semver | Exact <code>1.0.0</code> |\n5230|| <code>plan_id</code> | digest | Canonical object digest |\n5231|| <code>kind</code> | enum | <code>workspace</code>, <code>provider</code>, <code>task_board</code>, or <code>composite</code> |\n5232|| <code>intent</code> | enum | <code>passive_replica</code>, <code>owner_resume</code>, <code>ownership_transfer</code>, or <code>fork</code> |\n5233|| <code>subject_id</code> | UUIDv7 | Logical session for provider/task-board/composite; Workspace Group for workspace-only |\n5234|| <code>source_checkpoint_id</code> | digest | Validated immutable recovery base |\n5235|| <code>source_manifest_ids</code> | sorted unique digest[1..1024] | Complete source-checkpoint manifest/bundle inputs |\n5236|| <code>derived_manifest_ids</code> | sorted unique digest[0..1024] | Empty except for exact fork projections |\n5237|| <code>fork_projection</code> | Fork Workspace Projection or null | Non-null exactly for <code>intent = fork</code> |\n5238|| <code>prepared_for_host_id</code> | UUIDv7 | Only this allowlisted host may execute the plan |\n5239|| <code>source_lease_epoch</code> | uint53 | Greater than zero; exact source checkpoint lease |\n5240|| <code>source_lease_id</code> | UUIDv4 | Exact source checkpoint fencing token |\n5241|| <code>authorities</code> | RootAuthority[0..512] | Empty only for the provider backend-identity validation-only variant; otherwise closed destination-local roots defined below |\n5242|| <code>expected_prior_checkpoint_id</code> | digest or null | Null only when destination is classified absent or empty |\n5243|| <code>operations</code> | PlanOperation[0..65536] | Consecutive sequence beginning at 1 when non-empty |\n5244|| <code>exclusions</code> | sorted unique exclusion-class[0..128] | Exact capture/materialization policy classes |\n5245|| <code>validations</code> | sorted unique validation-name[1..6] | Required pre-commit checks from the closed registry below |\n5246|| <code>commit_strategy</code> | enum | <code>validation_only</code>, <code>atomic_directory_rename</code>, <code>atomic_file_merge</code>, <code>single_root_transaction</code>, or <code>two_phase_multi_root</code> |\n5247|| <code>rollback_required</code> | boolean | MUST be true in 1.0.0 |\n5248|| <code>created_by_host_id</code> | UUIDv7 | Plan author; normally destination host |\n5249|| <code>created_at</code> | timestamp | Diagnostic only |\n5250|| <code>extensions</code> | object | Reverse-DNS keys only |\n5251|\n5252|<code>RootAuthority</code> is a closed tagged union, sorted by\n5253|<code>authority_id</code>. IDs use the Section 7.5 <code>root-id</code> grammar,\n5254|are unique in the plan, and are routing labels rather than cross-host\n5255|identities:\n5256|\n5257|| Tag | Exact members |\n5258|| --- | --- |\n5259|| <code>kind = workspace</code> | <code>authority_id:root-id</code>, <code>kind:workspace</code>, <code>platform:macos&#124;linux&#124;wsl2&#124;windows</code>, <code>root_path:absolute-path</code>, <code>logical_root:string[1..64]</code>, <code>workspace_group_id:UUIDv7</code>, <code>write_policy:managed_replace&#124;managed_copy&#124;managed_worktree</code> |\n5260|| <code>kind = provider_store</code> | <code>authority_id:root-id</code>, <code>kind:provider_store</code>, <code>platform:macos&#124;linux&#124;wsl2&#124;windows</code>, <code>root_path:absolute-path</code>, <code>provider_id:provider-id</code>, <code>root_role:durable_store&#124;durable_index&#124;derived_cache</code>, <code>write_policy:managed_merge</code> |\n5261|| <code>kind = task_board_staging</code> | <code>authority_id:root-id</code>, <code>kind:task_board_staging</code>, <code>platform:macos&#124;linux&#124;wsl2&#124;windows</code>, <code>root_path:absolute-path</code>, <code>bridge_protocol_version:semver</code>, <code>staging_operation_id:UUIDv7</code>, <code>write_policy:staged_install</code> |\n5262|\n5263|A workspace authority's logical root MUST exist in destination configuration,\n5264|its root path MUST equal that resolved mapping, and its group ID MUST equal the\n5265|referenced workspace manifest. A provider-store authority is valid only when\n5266|returned by the exact destination adapter's materialize plan and independently\n5267|accepted by the Section 7.5 root/exclusion checks. A task-board staging root\n5268|MUST be a fresh owner-only child of the resolved ax state root and MUST contain\n5269|no pre-existing manager state. Authorities MUST be pairwise path-disjoint;\n5270|neither a symlink nor a reparse point may make them overlap. Ax data, cache,\n5271|runtime, credential, authentication, SSH, and live manager roots are forbidden\n5272|except for the exact fresh task-board staging child.\n5273|\n5274|<code>ForkWorkspaceProjection</code> is a closed object containing exactly:\n5275|\n5276|| Field | Type | Constraint |\n5277|| --- | --- | --- |\n5278|| <code>projection_version</code> | enum | Literal <code>workspace_fork_v1</code> |\n5279|| <code>source_session_id</code> | UUIDv7 | Session whose checkpoint is the immutable source |\n5280|| <code>source_workspace_group_id</code> | UUIDv7 | Source group named by the checkpoint closure |\n5281|| <code>source_workspace_group_record_id</code> | digest | Exact source topology record |\n5282|| <code>source_workspace_manifest_id</code> | digest | Exact source workspace-group Transfer Manifest |\n5283|| <code>destination_session_id</code> | UUIDv7 | Newly allocated fork session |\n5284|| <code>destination_workspace_group_id</code> | UUIDv7 | Fresh group identity |\n5285|| <code>destination_workspace_group_record_id</code> | digest | Exact derived Workspace Group Record identity |\n5286|| <code>destination_display_name</code> | string[1..128] | New topology display name |\n5287|| <code>destination_created_by_host_id</code> | UUIDv7 | Destination record author |\n5288|| <code>destination_created_at</code> | timestamp | Destination record creation time |\n5289|| <code>destination_extensions</code> | object | Reverse-DNS Workspace Group Record extensions |\n5290|| <code>member_mappings</code> | ForkMemberMapping[1..256] | Sorted by source workspace ID; one-to-one and onto destination members |\n5291|| <code>manifest_mappings</code> | ForkManifestMapping[1..1024] | Sorted by source manifest ID; complete bottom-up re-identification map |\n5292|\n5293|<code>ForkMemberMapping</code> contains exactly\n5294|<code>source_workspace_id:UUIDv7</code>,\n5295|<code>destination_workspace_id:UUIDv7</code>, and\n5296|<code>group_relative_path:path</code>. The relative path MUST equal the path in\n5297|both topology records; every destination ID is fresh and unique. The complete\n5298|destination Workspace Group Record is constructed with the fixed schema and\n5299|version, record/subject/group IDs from these projection fields, the displayed\n5300|name/creation/extensions fields, and the source record's member objects in\n5301|source workspace-ID order after replacing only each workspace ID according to\n5302|<code>member_mappings</code>. Its recomputed record ID MUST equal\n5303|<code>destination_workspace_group_record_id</code> before persistence.\n5304|<code>ForkManifestMapping</code> contains exactly\n5305|<code>kind:workspace_group|workspace_tree</code>,\n5306|<code>source_manifest_id:digest</code>,\n5307|<code>destination_manifest_id:digest</code>,\n5308|<code>source_subject_id:UUIDv7</code>, and\n5309|<code>destination_subject_id:UUIDv7</code>. Ax derives a destination manifest\n5310|by copying every non-identity field, entry, descriptor, and blob reference from\n5311|the source; replacing the subject, group, member, and child-manifest identities\n5312|according to the two maps; and recomputing child identities before parent\n5313|identities. It MUST persist the destination topology and all destination\n5314|manifests before publishing the fork Session Record. Source objects and bytes\n5315|remain unchanged. <code>derived_manifest_ids</code> MUST equal exactly the\n5316|destination IDs in <code>manifest_mappings</code> and MUST NOT occur in\n5317|<code>source_manifest_ids</code>.\n5318|\n5319|The following table is the complete major-v1 plan-kind tagged-union contract.\n5320|Anything not explicitly allowed in its row is forbidden:\n5321|\n5322|| <code>kind</code> | Subject and source inputs | Required authority/action set | Required validations | Legal commit strategies |\n5323|| --- | --- | --- | --- | --- |\n5324|| <code>workspace</code> | Subject is the destination Workspace Group. Exactly one workspace-group Transfer Manifest, plus its closed child manifests, is selected from <code>source_manifest_ids</code> or, for a fork, <code>derived_manifest_ids</code>. | One or more <code>workspace</code> authorities; only <code>install_workspace_group</code>, <code>install_workspace_tree</code>, <code>delete_managed_path</code>, or <code>replace_managed_replica</code>. At least one install operation is required. | Exactly <code>manifest_closure</code> and <code>workspace_state</code> | <code>atomic_directory_rename</code> for one directory boundary; <code>atomic_file_merge</code> for one authority with file boundaries only; otherwise <code>two_phase_multi_root</code> |\n5325|| <code>provider</code> | Subject is one Session. Exactly one provider Transfer Manifest is selected. A backend-resolved provider with <code>portable_store=false</code> uses the required zero-entry provider manifest that references its Provider Identity Record. | For a portable store, one or more <code>provider_store</code> authorities and only <code>merge_provider_store</code>. For a backend-resolved identity, no authorities and no operations. | <code>manifest_closure</code> plus exactly one of <code>provider_native_discovery</code> or <code>backend_identity</code> | <code>validation_only</code> only for the zero-operation backend path; <code>atomic_file_merge</code> for file boundaries; <code>single_root_transaction</code> for one provider-store authority with any directory boundary; otherwise <code>two_phase_multi_root</code> |\n5326|| <code>task_board</code> | Subject is one Session. Exactly one Task-board Bundle is selected. | Exactly one <code>task_board_staging</code> authority and exactly one <code>install_task_board_bundle</code> operation at <code>authority_root</code>. | <code>manifest_closure</code>, <code>task_board_bundle</code>, and <code>task_board_validate</code> exactly when the projected board kind is <code>local</code> | <code>single_root_transaction</code> |\n5327|| <code>composite</code> | Subject is one Session. Exactly one workspace-group manifest and exactly one provider manifest or Task-board Bundle are selected; never both provider and task-board branches. Fork-derived workspace manifests are allowed only with <code>intent=fork</code>. | The disjoint union of the corresponding workspace row and exactly one provider or task-board row. | Exact union of the component rows | <code>two_phase_multi_root</code> when both components mutate; when the provider component is <code>validation_only</code>, use the workspace row's one-root strategy because only workspace bytes mutate |\n5328|\n5329|<code>intent=fork</code> requires non-null <code>fork_projection</code> and a\n5330|non-empty <code>derived_manifest_ids</code>; every other intent requires null\n5331|and an empty array. For a fork plan, <code>subject_id</code> is the destination\n5332|session for provider, task-board, or composite kinds and is the destination\n5333|group for workspace kind. A plan MUST reject a source ID that is not in the\n5334|validated checkpoint closure, a derived ID that is not produced by the exact\n5335|projection, or an authority/action/validation/strategy combination outside its\n5336|row.\n5337|\n5338|Despite the historical member name, <code>source_manifest_ids</code> contains\n5339|Task-board Bundle IDs directly in the task-board row; it never contains raw\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
