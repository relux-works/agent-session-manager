{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca2b","stream":{"kind":"session","id":"01a06f78-0ca7-7650-b043-6178918d4030"},"sequence":880,"recorded_at":1780531400001755,"record_type":"event","durability":"durable","causation_id":"09066c51-cf5e-4ab0-8fb1-8339d1838d54","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"09066c51-cf5e-4ab0-8fb1-8339d1838d54","run_stream":{"kind":"run","id":"09066c51-cf5e-4ab0-8fb1-8339d1838d54"},"task_stream":{"kind":"task","id":"2179b03e-bbec-4c76-bf22-6e53cab1dac1"},"task_id":"2179b03e-bbec-4c76-bf22-6e53cab1dac1","event":{"kind":"output","task_id":"2179b03e-bbec-4c76-bf22-6e53cab1dac1","chunk":"Read text file `internal/terminalbackend/conformance.go`.\n(279 line(s) above)\n280|}\n281|\n282|// lookupTransition returns the table row for one operation.\n283|func lookupTransition(operation Operation) (Transition, bool) {\n284|\tfor _, row := range transitionTable {\n285|\t\tif row.Operation == operation {\n286|\t\t\treturn row, true\n287|\t\t}\n288|\t}\n289|\treturn Transition{}, false\n290|}\n291|\n292|// CheckTransition enforces the §4.C transition matrix. It returns the\n293|// success target state and the exact side effects. create resolves its\n294|// target from interactive: active when interactive, otherwise parked. A\n295|// state reached only by AX fencing observation (stale_fenced) is never\n296|// entered here: no backend operation targets it, so a row naming it as a\n297|// target cannot exist and CheckTransition cannot return it except as a\n298|// status observation of the source itself.\n299|//\n300|// An unknown operation or state is a protocol error; a known operation\n301|// against a disallowed source is a failed local precondition. Only\n302|// quiesce-input enters quiescing, and creating is never a success target:\n303|// it exists only between the idempotency receipt and the first side\n304|// effect, which the Ledger below owns.\n305|func CheckTransition(operation, source string, interactive bool) (InstanceState, []SideEffect, error) {\n306|\tparsedOperation, err := ParseOperation(operation)\n307|\tif err != nil {\n308|\t\treturn \"\", nil, err\n309|\t}\n310|\trow, known := lookupTransition(parsedOperation)\n311|\tif !known {\n312|\t\treturn \"\", nil, &Error{Code: CodeProtocolError, Detail: \"operation vocabulary\"}\n313|\t}\n314|\tif !row.InstanceScoped {\n315|\t\tif source != \"\" {\n316|\t\t\treturn \"\", nil, &Error{Code: CodePreconditionFailed, Detail: \"lifecycle instance scope\"}\n317|\t\t}\n318|\t\treturn \"\", nil, nil\n319|\t}\n320|\tparsedSource, err := ParseInstanceState(source)\n321|\tif err != nil {\n322|\t\treturn \"\", nil, err\n323|\t}\n324|\tallowed := false\n325|\tfor _, candidate := range row.Sources {\n326|\t\tif candidate == parsedSource {\n327|\t\t\tallowed = true\n328|\t\t\tbreak\n329|\t\t}\n330|\t}\n331|\tif !allowed {\n332|\t\treturn \"\", nil, &Error{Code: CodePreconditionFailed, Detail: \"lifecycle transition\"}\n333|\t}\n334|\tif row.SameState {\n335|\t\treturn parsedSource, nil, nil\n336|\t}\n337|\tif parsedOperation == OperationCreate && !interactive {\n338|\t\treturn StateParked, append([]SideEffect(nil), row.Effects...), nil\n339|\t}\n340|\treturn row.Target, append([]SideEffect(nil), row.Effects...), nil\n341|}\n342|\n343|// allowedOperationErrors is the exact §4.C \"Allowed error codes\" column.\n344|// An error not listed for an operation MUST NOT be emitted by the backend\n(more lines below)"}}}
