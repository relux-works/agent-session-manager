{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c787","stream":{"kind":"session","id":"01a06f78-0ca7-7650-b043-6178918d4030"},"sequence":542,"recorded_at":1780531400001079,"record_type":"event","durability":"durable","causation_id":"09066c51-cf5e-4ab0-8fb1-8339d1838d54","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"09066c51-cf5e-4ab0-8fb1-8339d1838d54","run_stream":{"kind":"run","id":"09066c51-cf5e-4ab0-8fb1-8339d1838d54"},"task_stream":{"kind":"task","id":"e0e931b6-630c-4be2-9fa0-fe345ed507aa"},"task_id":"e0e931b6-630c-4be2-9fa0-fe345ed507aa","event":{"kind":"output","task_id":"e0e931b6-630c-4be2-9fa0-fe345ed507aa","chunk":"Read text file `internal/terminalbackend/conformance.go`.\n(659 line(s) above)\n660|// the authorized ones; a relay transport is refused even when authorized\n661|// on paper, because current AX admits only local and trusted-mesh\n662|// presentation (§4.E). Expiry is checked against now: an expired policy\n663|// authorizes nothing, and a lease-shaped bypass cannot exist because the\n664|// policy has no lease member to consult.\n665|func CheckAttachRequest(auth AttachAuthorization, transport string, inputAuthorized bool, now time.Time) error {\n666|\trequested, err := parseTransport(transport)\n667|\tif err != nil {\n668|\t\treturn err\n669|\t}\n670|\tif requested != auth.Transport || inputAuthorized != auth.InputAuthorized {\n671|\t\treturn &Error{Code: CodeUnauthorized, Detail: \"attach authorization binding\"}\n672|\t}\n673|\tif requested == TransportThirdPartyRelay {\n674|\t\treturn &Error{Code: CodeUnauthorized, Detail: \"attach relay transport\"}\n675|\t}\n676|\texpires, err := auth.ExpiresAt.Time()\n677|\tif err != nil {\n678|\t\treturn mismatchf(\"document timestamp\")\n679|\t}\n680|\tif !now.Before(expires) {\n681|\t\treturn &Error{Code: CodeUnauthorized, Detail: \"attach authorization expiry\"}\n682|\t}\n683|\treturn nil\n684|}\n685|\n686|// CheckAttachResult enforces the §4.C attach result rule: the result\n687|// input boolean MUST equal both the request and the AttachAuthorization.\n688|// A backend reporting input the policy did not authorize is refused even\n689|// when the request itself was authorized.\n690|func CheckAttachResult(requestInputAuthorized, resultInputAuthorized bool, auth AttachAuthorization) error {\n691|\tif resultInputAuthorized != requestInputAuthorized || resultInputAuthorized != auth.InputAuthorized {\n692|\t\treturn &Error{Code: CodeUnauthorized, Detail: \"attach input binding\"}\n693|\t}\n694|\treturn nil\n695|}\n696|\n697|// CheckEntrypoint enforces the §4.A stable entrypoint rule: every\n698|// backend-created runtime ultimately executes exactly\n699|// `ax pane SESSION_ID`, and a raw provider command is forbidden as a\n700|// durable entry point. argv must be exactly the three literals ax, pane,\n701|// and the canonical request Session UUIDv7 string, and the carried\n702|// session must equal the session under creation.\n703|func CheckEntrypoint(argv []string, sessionID string) error {\n704|\tif len(argv) != 3 || argv[0] != \"ax\" || argv[1] != \"pane\" {\n705|\t\treturn &Error{Code: CodePreconditionFailed, Detail: \"entrypoint argv\"}\n706|\t}\n707|\tsession, err := scalar.ParseUUIDv7(sessionID)\n708|\tif err != nil {\n709|\t\treturn &Error{Code: CodePreconditionFailed, Detail: \"entrypoint session binding\"}\n(more lines below)"}}}
