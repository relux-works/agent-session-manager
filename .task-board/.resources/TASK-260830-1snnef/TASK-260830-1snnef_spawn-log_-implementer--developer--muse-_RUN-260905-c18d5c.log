{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c583","stream":{"kind":"session","id":"01a06f78-0ca7-7650-b043-6178918d4030"},"sequence":284,"recorded_at":1780531400000563,"record_type":"event","durability":"durable","causation_id":"09066c51-cf5e-4ab0-8fb1-8339d1838d54","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"09066c51-cf5e-4ab0-8fb1-8339d1838d54","run_stream":{"kind":"run","id":"09066c51-cf5e-4ab0-8fb1-8339d1838d54"},"task_stream":{"kind":"task","id":"774e1c3b-dec4-45ef-bc8b-71b36fe38c11"},"task_id":"774e1c3b-dec4-45ef-bc8b-71b36fe38c11","event":{"kind":"output","task_id":"774e1c3b-dec4-45ef-bc8b-71b36fe38c11","chunk":"Read text file `internal/terminalbackend/refusal_arm_inventory_test.go`.\n1|// AST-derived refusal-arm inventory for the terminal backend packages.\n2|//\n3|// The failure this file exists to prevent: a brand-new production refusal\n4|// arm carrying a brand-new unasserted detail shipped while `gofmt`,\n5|// `go vet`, `go test ./...`, and `tracecheck` all stayed green. A\n6|// hand-maintained arm list cannot catch that; a derived one can, but only\n7|// if it is checked in BOTH directions. The forward direction alone passes\n8|// vacuously on a truncated derivation: every derived arm asserted is true\n9|// when the derivation silently dropped half the package. So this file\n10|// derives every refusal arm from the production AST, requires each to\n11|// resolve to exactly one declared row naming a real asserting test, and\n12|// requires every declared row to resolve to exactly one derived arm.\n13|//\n14|// Modelled on internal/canonicaljson/grammar_inventory_test.go: derivation\n15|// fails closed on an empty, short, or unparseable input, and the declared\n16|// table cannot move its own goalposts because the derivation never\n17|// consults it.\n18|//\n19|// Stated bounds (not inferred):\n20|//   - The inventory proves every arm is DECLARED with a resolving test.\n21|//     Execution and decision proof is each row's named test, measured by\n22|//     this package's suite. A row resolves textually (detail mention, or\n23|//     entry-plus-code/predicate mention); a wrongly attributed row that\n24|//     still resolves is a review finding, not a green light.\n25|//   - errors.New/fmt.Errorf sites are not wire refusals and carry no arm.\n26|//     They live only in validatePlatforms (funneled into one *Error arm\n27|//     whose detail set is pinned exactly) and DigestFile (I/O errors that\n28|//     must never be *Error). Both properties are asserted below.\n29|package terminalbackend\n30|\n31|import (\n32|\t\"errors\"\n33|\t\"go/ast\"\n34|\t\"go/parser\"\n35|\t\"go/token\"\n36|\t\"os\"\n37|\t\"path/filepath\"\n38|\t\"strconv\"\n39|\t\"strings\"\n40|\t\"testing\"\n41|)\n42|\n43|// refusalArm is one derived production refusal: a wire-code *Error\n44|// construction site keyed by file, enclosing function (receiver-qualified\n45|// for methods), code symbol, static detail, and occurrence index within\n46|// that key. The index keeps two identical arms in one function distinct:\n47|// adding a second arm with an already-declared key fails on the missing\n48|// #2 row instead of hiding behind #1.\n49|type refusalArm struct {\n50|\tfile       string\n51|\tfunction   string\n52|\tcode       string\n53|\tdetail     string\n54|\toccurrence int\n55|}\n56|\n57|// constructorFunctions build refusals instead of issuing them. Their own\n58|// *Error sites are the funnel, not arms.\n59|var constructorFunctions = map[string]bool{\n60|\t\"mismatchf\":        true,\n61|\t\"integrityFailure\": true,\n62|}\n63|\n64|// passthroughDetail marks the single dynamic-detail funnel: Registration\n65|// validation wraps validatePlatforms errors via err.Error(). Every other\n66|// Detail expression must be a static string literal; a new dynamic detail\n67|// fails the derivation rather than entering the table silently.\n68|const passthroughDetail = \"passthrough:err.Error()\"\n69|\n70|// deriveRefusalArms walks every production file of this package (every\n71|// *.go except *_test.go, so a new production file is scanned without\n72|// anyone remembering it) and returns every refusal arm in source order.\n73|// It fails closed: an unparseable file, a non-static code or detail, and\n74|// an empty result are all fatal, never an empty table.\n75|func deriveRefusalArms(t *testing.T) []refusalArm {\n76|\tt.Helper()\n77|\n78|\tmatches, err := filepath.Glob(\"*.go\")\n79|\tif err != nil {\n80|\t\tt.Fatalf(\"glob production files: %v\", err)\n81|\t}\n82|\tvar production []string\n83|\tfor _, match := range matches {\n84|\t\tif !strings.HasSuffix(match, \"_test.go\") {\n85|\t\t\tproduction = append(production, match)\n86|\t\t}\n87|\t}\n88|\tif len(production) == 0 {\n89|\t\tt.Fatal(\"derived zero production files; the scanner is broken, not the package\")\n90|\t}\n91|\n92|\tvar arms []refusalArm\n93|\tparsed := 0\n94|\tfor _, name := range production {\n95|\t\tfileSet := token.NewFileSet()\n96|\t\tfile, err := parser.ParseFile(fileSet, name, nil, 0)\n97|\t\tif err != nil {\n98|\t\t\tt.Fatalf(\"parse %s: %v; an unparseable derivation proves nothing\", name, err)\n99|\t\t}\n100|\t\tparsed++\n101|\t\tfor _, declaration := range file.Decls {\n102|\t\t\tfunction, ok := declaration.(*ast.FuncDecl)\n103|\t\t\tif !ok || function.Body == nil {\n104|\t\t\t\tcontinue\n105|\t\t\t}\n106|\t\t\tif constructorFunctions[function.Name.Name] {\n107|\t\t\t\tcontinue\n108|\t\t\t}\n109|\t\t\tfunctionName := function.Name.Name\n110|\t\t\tif function.Recv != nil && len(function.Recv.List) > 0 {\n111|\t\t\t\tfunctionName = receiverTypeName(function.Recv.List[0].Type) + \".\" + functionName\n112|\t\t\t}\n113|\t\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n114|\t\t\t\tswitch expression := node.(type) {\n115|\t\t\t\tcase *ast.UnaryExpr:\n116|\t\t\t\t\tif expression.Op != token.AND {\n117|\t\t\t\t\t\treturn true\n118|\t\t\t\t\t}\n119|\t\t\t\t\tliteral, ok := expression.X.(*ast.CompositeLit)\n120|\t\t\t\t\tif !ok {\n121|\t\t\t\t\t\treturn true\n122|\t\t\t\t\t}\n123|\t\t\t\t\tidentifier, ok := literal.Type.(*ast.Ident)\n124|\t\t\t\t\tif !ok || identifier.Name != \"Error\" {\n125|\t\t\t\t\t\treturn true\n126|\t\t\t\t\t}\n127|\t\t\t\t\tcode, detail := \"\", \"\"\n128|\t\t\t\t\tfor _, element := range literal.Elts {\n129|\t\t\t\t\t\tpair, ok := element.(*ast.KeyValueExpr)\n130|\t\t\t\t\t\tif !ok {\n131|\t\t\t\t\t\t\tcontinue\n132|\t\t\t\t\t\t}\n133|\t\t\t\t\t\tkey, ok := pair.Key.(*ast.Ident)\n134|\t\t\t\t\t\tif !ok {\n135|\t\t\t\t\t\t\tcontinue\n136|\t\t\t\t\t\t}\n137|\t\t\t\t\t\tswitch key.Name {\n138|\t\t\t\t\t\tcase \"Code\":\n139|\t\t\t\t\t\t\tsymbol, ok := pair.Value.(*ast.Ident)\n140|\t\t\t\t\t\t\tif !ok {\n141|\t\t\t\t\t\t\t\tt.Fatalf(\"%s: refusal code is not a static Code symbol; \"+\n142|\t\t\t\t\t\t\t\t\t\"a computed code cannot be inventoried\", functionName)\n143|\t\t\t\t\t\t\t}\n144|\t\t\t\t\t\t\tcode = symbol.Name\n145|\t\t\t\t\t\tcase \"Detail\":\n146|\t\t\t\t\t\t\tdetail = staticDetail(t, functionName, pair.Value)\n147|\t\t\t\t\t\t}\n148|\t\t\t\t\t}\n149|\t\t\t\t\tif code == \"\" || detail == \"\" {\n150|\t\t\t\t\t\tt.Fatalf(\"%s: refusal without a static code and detail; \"+\n151|\t\t\t\t\t\t\t\"the inventory cannot name what it cannot read\", functionName)\n152|\t\t\t\t\t}\n153|\t\t\t\t\tarms = append(arms, refusalArm{\n154|\t\t\t\t\t\tfile: name, function: functionName, code: code, detail: detail,\n155|\t\t\t\t\t})\n156|\t\t\t\tcase *ast.CallExpr:\n157|\t\t\t\t\tidentifier, ok := expression.Fun.(*ast.Ident)\n158|\t\t\t\t\tif !ok || (identifier.Name != \"mismatchf\" && identifier.Name != \"integrityFailure\") {\n159|\t\t\t\t\t\treturn true\n160|\t\t\t\t\t}\n161|\t\t\t\t\tif len(expression.Args) == 0 {\n162|\t\t\t\t\t\tt.Fatalf(\"%s: %s without arguments; the derivation cannot name its detail\",\n163|\t\t\t\t\t\t\tfunctionName, identifier.Name)\n164|\t\t\t\t\t}\n165|\t\t\t\t\tliteral, ok := expression.Args[0].(*ast.BasicLit)\n166|\t\t\t\t\tif !ok || literal.Kind != token.STRING {\n167|\t\t\t\t\t\tt.Fatalf(\"%s: %s detail is not a static string literal; \"+\n168|\t\t\t\t\t\t\t\"a computed detail cannot be inventoried\", functionName, identifier.Name)\n169|\t\t\t\t\t}\n170|\t\t\t\t\tdetail, err := strconv.Unquote(literal.Value)\n171|\t\t\t\t\tif err != nil {\n172|\t\t\t\t\t\tt.Fatalf(\"%s: unquote detail: %v\", functionName, err)\n173|\t\t\t\t\t}\n174|\t\t\t\t\tcode := \"CodeMismatch\"\n175|\t\t\t\t\tif identifier.Name == \"integrityFailure\" {\n176|\t\t\t\t\t\tcode = \"CodeIntegrityFailure\"\n177|\t\t\t\t\t}\n178|\t\t\t\t\tarms = append(arms, refusalArm{\n179|\t\t\t\t\t\tfile: name, function: functionName, code: code, detail: detail,\n180|\t\t\t\t\t})\n181|\t\t\t\t}\n182|\t\t\t\treturn true\n183|\t\t\t})\n184|\t\t}\n185|\t}\n186|\t_ = parsed\n187|\tif len(arms) == 0 {\n188|\t\tt.Fatal(\"derived zero refusal arms from the package sources; the scanner is broken, not the package\")\n189|\t}\n190|\toccurrences := make(map[refusalArm]int)\n191|\tfor index := range arms {\n192|\t\tkey := arms[index]\n193|\t\tkey.occurrence = 0\n194|\t\toccurrences[key]++\n195|\t\tarms[index].occurrence = occurrences[key]\n196|\t}\n197|\treturn arms\n198|}\n199|\n200|// receiverTypeName renders a method receiver type to its bare name.\n201|func receiverTypeName(expression ast.Expr) string {\n202|\tswitch typed := expression.(type) {\n203|\tcase *ast.Ident:\n204|\t\treturn typed.Name\n205|\tcase *ast.StarExpr:\n206|\t\treturn receiverTypeName(typed.X)\n207|\tdefault:\n208|\t\treturn \"unknown\"\n209|\t}\n210|}\n211|\n212|// staticDetail reads one Detail expression: a string literal, or the one\n213|// dynamic funnel. Anything else fails the derivation.\n214|func staticDetail(t *testing.T, function string, expression ast.Expr) string {\n215|\tt.Helper()\n216|\n217|\tif literal, ok := expression.(*ast.BasicLit); ok && literal.Kind == token.STRING {\n218|\t\tdetail, err := strconv.Unquote(literal.Value)\n219|\t\tif err != nil {\n220|\t\t\tt.Fatalf(\"%s: unquote detail: %v\", function, err)\n221|\t\t}\n222|\t\treturn detail\n223|\t}\n224|\tif call, ok := expression.(*ast.CallExpr); ok {\n225|\t\tif selector, ok := call.Fun.(*ast.SelectorExpr); ok && selector.Sel.Name == \"Error\" {\n226|\t\t\tif receiver, ok := selector.X.(*ast.Ident); ok && receiver.Name == \"err\" {\n227|\t\t\t\treturn passthroughDetail\n228|\t\t\t}\n229|\t\t}\n230|\t}\n231|\tt.Fatalf(\"%s: refusal Detail is not a static clause; Detail must never \"+\n232|\t\t\"interpolate local data, and a dynamic detail cannot be inventoried\", function)\n233|\treturn \"\"\n234|}\n235|\n236|// productionCodeSymbols resolves every Code symbol to its wire value from\n237|// the production const declarations, so the declared table cannot drift\n238|// from the codes production actually emits.\n239|func productionCodeSymbols(t *testing.T) map[string]string {\n240|\tt.Helper()\n241|\n242|\tsymbols := make(map[string]string)\n243|\tmatches, err := filepath.Glob(\"*.go\")\n244|\tif err != nil {\n245|\t\tt.Fatalf(\"glob production files: %v\", err)\n246|\t}\n247|\tfor _, name := range matches {\n248|\t\tif strings.HasSuffix(name, \"_test.go\") {\n249|\t\t\tcontinue\n250|\t\t}\n251|\t\tfileSet := token.NewFileSet()\n252|\t\tfile, err := parser.ParseFile(fileSet, name, nil, 0)\n253|\t\tif err != nil {\n254|\t\t\tt.Fatalf(\"parse %s: %v\", name, err)\n255|\t\t}\n256|\t\tfor _, declaration := range file.Decls {\n257|\t\t\tgeneral, ok := declaration.(*ast.GenDecl)\n258|\t\t\tif !ok || general.Tok != token.CONST {\n259|\t\t\t\tcontinue\n260|\t\t\t}\n261|\t\t\tfor _, specification := range general.Specs {\n262|\t\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n263|\t\t\t\tif !ok {\n264|\t\t\t\t\tcontinue\n265|\t\t\t\t}\n266|\t\t\t\tfor index, name := range value.Names {\n267|\t\t\t\t\tif !strings.HasPrefix(name.Name, \"Code\") || index >= len(value.Values) {\n268|\t\t\t\t\t\tcontinue\n269|\t\t\t\t\t}\n270|\t\t\t\t\tliteral, ok := value.Values[index].(*ast.BasicLit)\n271|\t\t\t\t\tif !ok || literal.Kind != token.STRING {\n272|\t\t\t\t\t\tt.Fatalf(\"code symbol %s is not a static string; \"+\n273|\t\t\t\t\t\t\t\"wire codes must be literals\", name.Name)\n274|\t\t\t\t\t}\n275|\t\t\t\t\twire, err := strconv.Unquote(literal.Value)\n276|\t\t\t\t\tif err != nil {\n277|\t\t\t\t\t\tt.Fatalf(\"unquote %s: %v\", name.Name, err)\n278|\t\t\t\t\t}\n279|\t\t\t\t\tsymbols[name.Name] = wire\n280|\t\t\t\t}\n281|\t\t\t}\n282|\t\t}\n283|\t}\n284|\tif len(symbols) == 0 {\n285|\t\tt.Fatal(\"resolved zero code symbols; the scanner is broken, not the package\")\n286|\t}\n287|\treturn symbols\n288|}\n289|\n290|// testBodies indexes every test declaration in this package by file and\n291|// name to its body source. A duplicate test name across files fails: row\n292|// references would be ambiguous.\n293|func testBodies(t *testing.T) map[string]string {\n294|\tt.Helper()\n295|\n296|\tbodies := make(map[string]string)\n297|\tmatches, err := filepath.Glob(\"*_test.go\")\n298|\tif err != nil {\n299|\t\tt.Fatalf(\"glob test files: %v\", err)\n300|\t}\n301|\tif len(matches) == 0 {\n302|\t\tt.Fatal(\"found zero test files; the scanner is broken, not the package\")\n303|\t}\n304|\tfor _, name := range matches {\n305|\t\traw, err := os.ReadFile(name)\n306|\t\tif err != nil {\n307|\t\t\tt.Fatalf(\"read %s: %v\", name, err)\n308|\t\t}\n309|\t\tfileSet := token.NewFileSet()\n310|\t\tfile, err := parser.ParseFile(fileSet, name, nil, 0)\n311|\t\tif err != nil {\n312|\t\t\tt.Fatalf(\"parse %s: %v\", name, err)\n313|\t\t}\n314|\t\tfor _, declaration := range file.Decls {\n315|\t\t\tfunction, ok := declaration.(*ast.FuncDecl)\n316|\t\t\tif !ok || !strings.HasPrefix(function.Name.Name, \"Test\") {\n317|\t\t\t\tcontinue\n318|\t\t\t}\n319|\t\t\tstart := fileSet.Position(function.Body.Pos()).Offset\n320|\t\t\tend := fileSet.Position(function.Body.End()).Offset\n321|\t\t\tkey := name + \"\\n\" + function.Name.Name\n322|\t\t\tif _, duplicate := bodies[key]; duplicate {\n323|\t\t\t\tt.Fatalf(\"test %s is declared twice; row references would be ambiguous\", key)\n324|\t\t\t}\n325|\t\t\tbodies[key] = string(raw[start:end])\n326|\t\t}\n327|\t}\n328|\tif len(bodies) == 0 {\n329|\t\tt.Fatal(\"indexed zero test declarations, so every row below would resolve vacuously\")\n330|\t}\n331|\treturn bodies\n332|}\n333|\n334|// predicateCodes resolves every Is predicate to the code symbol it\n335|// reports, verifying the shape: a single return of errorCode(err, Code).\n336|// A predicate in any other shape fails: the inventory leans on these to\n337|// resolve code-only assertions, so an unrecognized shape proves nothing.\n338|func predicateCodes(t *testing.T) map[string]string {\n339|\tt.Helper()\n340|\n341|\tpredicates := make(map[string]string)\n342|\tmatches, err := filepath.Glob(\"*.go\")\n343|\tif err != nil {\n344|\t\tt.Fatalf(\"glob production files: %v\", err)\n345|\t}\n346|\tfor _, name := range matches {\n347|\t\tif strings.HasSuffix(name, \"_test.go\") {\n348|\t\t\tcontinue\n349|\t\t}\n350|\t\tfileSet := token.NewFileSet()\n351|\t\tfile, err := parser.ParseFile(fileSet, name, nil, 0)\n352|\t\tif err != nil {\n353|\t\t\tt.Fatalf(\"parse %s: %v\", name, err)\n354|\t\t}\n355|\t\tfor _, declaration := range file.Decls {\n356|\t\t\tfunction, ok := declaration.(*ast.FuncDecl)\n357|\t\t\tif !ok || !strings.HasPrefix(function.Name.Name, \"Is\") || function.Body == nil {\n358|\t\t\t\tcontinue\n359|\t\t\t}\n360|\t\t\tif len(function.Body.List) != 1 {\n361|\t\t\t\tt.Fatalf(\"predicate %s is not a single return; the inventory cannot resolve it\",\n362|\t\t\t\t\tfunction.Name.Name)\n363|\t\t\t}\n364|\t\t\treturned, ok := function.Body.List[0].(*ast.ReturnStmt)\n365|\t\t\tif !ok || len(returned.Results) != 1 {\n366|\t\t\t\tt.Fatalf(\"predicate %s is not a single return; the inventory cannot resolve it\",\n367|\t\t\t\t\tfunction.Name.Name)\n368|\t\t\t}\n369|\t\t\tcall, ok := returned.Results[0].(*ast.CallExpr)\n370|\t\t\tif !ok || len(call.Args) != 2 {\n371|\t\t\t\tt.Fatalf(\"predicate %s does not call errorCode(err, Code); \"+\n372|\t\t\t\t\t\"the inventory cannot resolve it\", function.Name.Name)\n373|\t\t\t}\n374|\t\t\tcode, ok := call.Args[1].(*ast.Ident)\n375|\t\t\tif !ok {\n376|\t\t\t\tt.Fatalf(\"predicate %s reports a non-static code; the inventory cannot resolve it\",\n377|\t\t\t\t\tfunction.Name.Name)\n378|\t\t\t}\n379|\t\t\tpredicates[function.Name.Name] = code.Name\n380|\t\t}\n381|\t}\n382|\tif len(predicates) == 0 {\n383|\t\tt.Fatal(\"resolved zero predicates; the scanner is broken, not the package\")\n384|\t}\n385|\treturn predicates\n386|}\n387|\n388|// refusalTestRef names one asserting test by file and declaration name.\n389|type refusalTestRef struct {\n390|\tfile string\n391|\ttest string\n392|}\n393|\n394|// declaredRefusalArm is one inventoried arm: the derived key (file,\n395|// function, code symbol, static detail, occurrence), the public\n396|// production entry its test drives, an optional stated bound for\n397|// defensive arms no document can reach, and the tests asserting it.\n398|type declaredRefusalArm struct {\n399|\tfile       string\n400|\tfunction   string\n401|\tcode       string\n402|\tdetail     string\n403|\toccurrence int\n404|\tentry      string\n405|\tbound      string\n406|\t// detailSet carries the funneled detail set for the single\n407|\t// dynamic-detail row; it is empty for every literal row.\n408|\tdetailSet []string\n409|\ttests     []refusalTestRef\n410|}\n411|\n412|// boundDefensiveReparse is the stated bound for re-parse arms after an\n413|// already-validated member: timestampMember validated the member, and the\n414|// Time re-parse cannot fail while scalar owns that contract. The arms\n415|// stay as fail-closed defense; the bound says why no document reaches\n416|// them, and TestDefensiveBoundsAreExactlyThese pins the set.\n417|const boundDefensiveReparse = \"defensive re-parse after validation; scalar owns the re-parse contract\"\n418|\n419|// declaredRefusalArms is the inventoried arm set. Field order is file,\n420|// function (receiver-qualified for methods), code symbol, static detail,\n421|// occurrence within that key, driven public entry, stated bound (empty\n422|// except for defensive arms), funneled detail set (nil except the funnel\n423|// row, which lives outside this table), and asserting tests.\n424|//\n425|// The table is generated from the derivation, never hand-enumerated:\n426|// every row must match exactly one derived arm and vice versa, so adding\n427|// a production arm without a row fails forward, and deleting one fails\n428|// in reverse.\n429|var declaredRefusalArms = []declaredRefusalArm{\n430|\t{\"conformance.go\", \"CheckAttachRequest\", \"CodeMismatch\", \"document timestamp\", 1, \"CheckAttachRequest\", boundDefensiveReparse, nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckAttachRequestBindsTransportInputAndExpiry\"}}},\n431|\t{\"conformance.go\", \"CheckAttachRequest\", \"CodeUnauthorized\", \"attach authorization binding\", 1, \"CheckAttachRequest\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckAttachRequestBindsTransportInputAndExpiry\"}}},\n432|\t{\"conformance.go\", \"CheckAttachRequest\", \"CodeUnauthorized\", \"attach authorization expiry\", 1, \"CheckAttachRequest\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckAttachRequestBindsTransportInputAndExpiry\"}}},\n433|\t{\"conformance.go\", \"CheckAttachRequest\", \"CodeUnauthorized\", \"attach relay transport\", 1, \"CheckAttachRequest\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckAttachRequestBindsTransportInputAndExpiry\"}}},\n434|\t{\"conformance.go\", \"CheckAttachResult\", \"CodeUnauthorized\", \"attach input binding\", 1, \"CheckAttachResult\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckAttachResultRequiresTripleEquality\"}}},\n435|\t{\"conformance.go\", \"CheckEntrypoint\", \"CodePreconditionFailed\", \"entrypoint argv\", 1, \"CheckEntrypoint\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckEntrypointNamesItsArm\"}}},\n436|\t{\"conformance.go\", \"CheckEntrypoint\", \"CodePreconditionFailed\", \"entrypoint session binding\", 1, \"CheckEntrypoint\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckEntrypointNamesItsArm\"}}},\n437|\t{\"conformance.go\", \"CheckEntrypoint\", \"CodePreconditionFailed\", \"entrypoint session binding\", 2, \"CheckEntrypoint\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckEntrypointNamesItsArm\"}}},\n438|\t{\"conformance.go\", \"CheckEntrypoint\", \"CodePreconditionFailed\", \"entrypoint session binding\", 3, \"CheckEntrypoint\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckEntrypointNamesItsArm\"}}},\n439|\t{\"conformance.go\", \"CheckErrorAllowed\", \"CodeProtocolError\", \"operation error vocabulary\", 1, \"CheckErrorAllowed\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckErrorAllowedRefusesEveryUnlistedCode\"}}},\n440|\t{\"conformance.go\", \"CheckReplicable\", \"CodeProtocolError\", \"replication exclusion\", 1, \"CheckReplicable\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckReplicableRefusesEveryNonSafeClass\"}}},\n441|\t{\"conformance.go\", \"CheckStatusResult\", \"CodePreconditionFailed\", \"status attachability\", 1, \"CheckStatusResult\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckStatusResultEnforcesLookupRules\"}}},\n442|\t{\"conformance.go\", \"CheckStatusResult\", \"CodeProtocolError\", \"status identity binding\", 1, \"CheckStatusResult\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckStatusResultEnforcesLookupRules\"}}},\n443|\t{\"conformance.go\", \"CheckStatusResult\", \"CodeProtocolError\", \"status identity binding\", 2, \"CheckStatusResult\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckStatusResultEnforcesLookupRules\"}}},\n444|\t{\"conformance.go\", \"CheckStatusResult\", \"CodeProtocolError\", \"status provider observation\", 1, \"CheckStatusResult\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckStatusResultEnforcesLookupRules\"}}},\n445|\t{\"conformance.go\", \"CheckTransition\", \"CodePreconditionFailed\", \"lifecycle instance scope\", 1, \"CheckTransition\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckTransitionRefusesEveryIllegalSource\"}}},\n446|\t{\"conformance.go\", \"CheckTransition\", \"CodePreconditionFailed\", \"lifecycle transition\", 1, \"CheckTransition\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestCheckTransitionRefusesEveryIllegalSource\"}}},\n447|\t{\"conformance.go\", \"CheckTransition\", \"CodeProtocolError\", \"operation vocabulary\", 1, \"ParseOperation\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestParseOperationAdmitsOnlyTheTenClosedOperations\"}}},\n448|\t{\"conformance.go\", \"IdempotencyKey\", \"CodeProtocolError\", \"idempotency key shape\", 1, \"IdempotencyKey\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestIdempotencyKeyRefusesWrongShapes\"}}},\n449|\t{\"conformance.go\", \"IdempotencyKey\", \"CodeProtocolError\", \"idempotency key shape\", 2, \"IdempotencyKey\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestIdempotencyKeyRefusesWrongShapes\"}}},\n450|\t{\"conformance.go\", \"IdempotencyKey\", \"CodeProtocolError\", \"idempotency key shape\", 3, \"IdempotencyKey\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestIdempotencyKeyRefusesWrongShapes\"}}},\n451|\t{\"conformance.go\", \"ImportLedger\", \"CodeIdempotencyMismatch\", \"idempotency ledger image\", 1, \"ImportLedger\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestLedgerSurvivesControllerCrashViaExportImport\"}}},\n452|\t{\"conformance.go\", \"ImportLedger\", \"CodeProtocolError\", \"idempotency ledger image\", 1, \"ImportLedger\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestLedgerSurvivesControllerCrashViaExportImport\"}}},\n453|\t{\"conformance.go\", \"ImportLedger\", \"CodeProtocolError\", \"idempotency ledger image\", 2, \"ImportLedger\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestLedgerSurvivesControllerCrashViaExportImport\"}}},\n454|\t{\"conformance.go\", \"ImportLedger\", \"CodeProtocolError\", \"idempotency ledger image\", 3, \"ImportLedger\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestLedgerSurvivesControllerCrashViaExportImport\"}}},\n455|\t{\"conformance.go\", \"Ledger.Bind\", \"CodeIdempotencyMismatch\", \"idempotency key conflict\", 1, \"Bind\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestLedgerBindsReplaysAndRefusesMismatch\"}}},\n456|\t{\"conformance.go\", \"Ledger.Bind\", \"CodeProtocolError\", \"idempotency key shape\", 1, \"Bind\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestLedgerBindsReplaysAndRefusesMismatch\"}}},\n457|\t{\"conformance.go\", \"Ledger.Bind\", \"CodeProtocolError\", \"idempotency ledger unavailable\", 1, \"Bind\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestLedgerBindsReplaysAndRefusesMismatch\"}}},\n458|\t{\"conformance.go\", \"ParseAttachAuthorization\", \"CodeMismatch\", \"document member type\", 1, \"ParseAttachAuthorization\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestParseAttachAuthorizationRefusesNonNeutralPolicy\"}}},\n459|\t{\"conformance.go\", \"ParseAttachAuthorization\", \"CodeMismatch\", \"document member type\", 2, \"ParseAttachAuthorization\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestParseAttachAuthorizationRefusesNonNeutralPolicy\"}}},\n460|\t{\"conformance.go\", \"ParseAttachAuthorization\", \"CodeMismatch\", \"document members\", 1, \"ParseAttachAuthorization\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestParseAttachAuthorizationRefusesNonNeutralPolicy\"}}},\n461|\t{\"conformance.go\", \"ParseAttachAuthorization\", \"CodeMismatch\", \"document timestamp\", 1, \"ParseAttachAuthorization\", boundDefensiveReparse, nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestParseAttachAuthorizationRefusesNonNeutralPolicy\"}}},\n462|\t{\"conformance.go\", \"ParseAttachAuthorization\", \"CodeMismatch\", \"document timestamp\", 2, \"ParseAttachAuthorization\", boundDefensiveReparse, nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestParseAttachAuthorizationRefusesNonNeutralPolicy\"}}},\n463|\t{\"conformance.go\", \"ParseAttachAuthorization\", \"CodeUnauthorized\", \"attach authorization expiry\", 1, \"ParseAttachAuthorization\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestParseAttachAuthorizationRefusesNonNeutralPolicy\"}}},\n464|\t{\"conformance.go\", \"ParseInstanceState\", \"CodeProtocolError\", \"lifecycle state vocabulary\", 1, \"ParseInstanceState\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestParseInstanceStateAdmitsOnlyTheEightClosedStates\"}}},\n465|\t{\"conformance.go\", \"ParseOperation\", \"CodeProtocolError\", \"operation vocabulary\", 1, \"ParseOperation\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestParseOperationAdmitsOnlyTheTenClosedOperations\"}}},\n466|\t{\"conformance.go\", \"ParseSideEffect\", \"CodeProtocolError\", \"side effect vocabulary\", 1, \"ParseSideEffect\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestParseSideEffectAdmitsOnlyTheTenClosedEffects\"}}},\n467|\t{\"conformance.go\", \"ProjectToLegacy\", \"CodeIncompatibleSchema\", \"legacy reverse projection\", 1, \"ProjectToLegacy\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestLegacyReverseProjectionExistsOnlyForThePair\"}}},\n468|\t{\"conformance.go\", \"TranslateLegacyBackend\", \"CodeIncompatibleSchema\", \"legacy backend identity\", 1, \"TranslateLegacyBackend\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestHistoricalTranslationMapsOnlyTheImmutablePair\"}}},\n469|\t{\"conformance.go\", \"parseTransport\", \"CodeProtocolError\", \"presentation transport vocabulary\", 1, \"ParseAttachAuthorization\", \"\", nil, []refusalTestRef{{file: \"conformance_test.go\", test: \"TestParseAttachAuthorizationRefusesNonNeutralPolicy\"}}},\n470|\t{\"manifest.go\", \"CapabilitiesForOperation\", \"CodeMismatch\", \"operation vocabulary\", 1, \"CapabilitiesForOperation\", \"\", nil, []refusalTestRef{{file: \"manifest_test.go\", test: \"TestCapabilitiesForOperation\"}}},\n471|\t{\"manifest.go\", \"CheckOperation\", \"CodeMismatch\", \"operation vocabulary\", 1, \"CheckOperation\", \"\", nil, []refusalTestRef{{file: \"manifest_test.go\", test: \"TestCapabilitiesForOperation\"}}},\n472|\t{\"manifest.go\", \"CheckOperation\", \"CodeCapabilityUnproven\", \"operation capability dependency\", 1, \"CheckOperation\", \"\", nil, []refusalTestRef{{file: \"manifest_test.go\", test: \"TestReconcileAdmitsCoherentTuple\"}}},\n473|\t{\"manifest.go\", \"GenerationDigest\", \"CodeStaleGeneration\", \"backend_generation bound\", 1, \"GenerationDigest\", \"\", nil, []refusalTestRef{{file: \"manifest_test.go\", test: \"TestGenerationDigestBounds\"}}},\n474|\t{\"manifest.go\", \"ParseEvidence\", \"CodeMismatch\", \"capability vocabulary\", 1, \"ParseManifest\", \"\", nil, []refusalTestRef{{file: \"manifest_test.go\", test: \"TestManifestDocumentRefusals\"}}},\n475|\t{\"manifest.go\", \"ParseEvidence\", \"CodeMismatch\", \"document timestamp\", 1, \"ParseEvidence\", \"\", nil, []refusalTestRef{{file: \"manifest_test.go\", test: \"TestEvidenceDocumentRefusals\"}}},\n476|\t{\"manifest.go\", \"ParseEvidence\", \"CodeMismatch\", \"document timestamp\", 2, \"ParseEvidence\", \"\", nil, []refusalTestRef{{file: \"manifest_test.go\", test: \"TestEvidenceDocumentRefusals\"}}},\n477|\t{\"manifest.go\", \"ParseEvidence\", \"CodeMismatch\", \"evidence backend identity\", 1, \"ParseEvidence\", \"\", nil, []refusalTestRef{{file: \"manifest_test.go\", test: \"TestEvidenceDocumentRefusals\"}}},\n478|\t{\"manifest.go\", \"ParseEvidence\", \"CodeMismatch\", \"evidence expiry\", 1, \"ParseEvidence\", \"\", nil, []refusalTestRef{{file: \"manifest_test.go\", test: \"TestEvidenceDocumentRefusals\"}}},\n479|\t{\"manifest.go\", \"ParseEvidence\", \"CodeMismatch\", \"evidence issuer\", 1, \"ParseEvidence\", \"\", nil, []refusalTestRef{{file: \"manifest_test.go\", test: \"TestEvidenceDocumentRefusals\"}}},\n480|\t{\"manifest.go\", \"ParseEvidence\", \"CodeMismatch\", \"evidence platform\", 1, \"ParseEvidence\", \"\", nil, []refusalTestRef{{file: \"manifest_test.go\", test: \"TestEvidenceDocumentRefusals\"}}},\n481|\t{\"manifest.go\", \"ParseEvidence\", \"CodeMismatch\", \"evidence protocol major 1\", 1, \"ParseEvidence\", \"\", nil, []refusalTestRef{{file: \"manifest_test.go\", test: \"TestEvidenceDocumentRefusals\"}}},\n482|\t{\"manifest.go\", \"ParseEvidence\", \"CodeMismatch\", \"evidence schema\", 1, \"ParseEvidence\", \"\", nil, []refusalTestRef{{file: \"manifest_test.go\", test: \"TestEvidenceDocumentRefusals\"}}},\n483|\t{\"manifest.go\", \"ParseEvidence\", \"CodeMismatch\", \"evidence schema version\", 1, \"ParseEvidence\", \"\", nil, []refusalTestRef{{file: \"manifest_test.go\", test: \"TestEvidenceDocumentRefusals\"}}},\n484|\t{\"manifest.go\", \"ParseEvidence\", \"CodeMismatch\", \"evidence value\", 1, \"ParseEvidence\", \"\", nil, []refusalTestRef{{file: \"manifest_test.go\", test: \"TestEvidenceDocumentRefusals\"}}},\n485|\t{\"manifest.go\", \"ParseProbe\", \"CodeMismatch\", \"document digest\", 1, \"ParseManifest\", \"\", nil, []refusalTestRef{{file: \"manifest_test.go\", test: \"TestManifestDocumentRefusals\"}}},\n486|\t{\"manifest.go\", \"ParseProbe\", \"CodeMismatch\", \"document members\", 1, \"ParseManifest\", \"\", nil, []refusalTestRef{{file: \"manifest_test.go\", test: \"TestManifestDocumentRefusals\"}}},\n487|\t{\"manifest.go\", \"ParseProbe\", \"CodeMismatch\", \"evidence list bound\", 1, \"ParseProbe\", \"\", nil, []refusalTestRef{{file: \"manifest_test.go\", test: \"TestProbeDocumentRefusals\"}}},\n488|\t{\"manifest.go\", \"ParseProbe\", \"CodeMismatch\", \"probe availability\", 1, \"ParseProbe\", \"\", nil, []refusalTestRef{{file: \"manifest_test.go\", test: \"TestProbeDocumentRefusals\"}}},\n489|\t{\"manifest.go\", \"ParseProbe\", \"CodeMismatch\", \"probe backend identity\", 1, \"ParseProbe\", \"\", nil, []refusalTestRef{{file: \"manifest_test.go\", test: \"TestProbeDocumentRefusals\"}}},\n490|\t{\"manifest.go\", \"ParseProbe\", \"CodeMismatch\", \"probe executable digest\", 1, \"ParseProbe\", \"\", nil, []refusalTestRef{{file: \"manifest_test.go\", test: \"TestProbeDocumentRefusals\"}}},\n491|\t{\"manifest.go\", \"ParseProbe\", \"CodeMismatch\", \"probe implementation kind\", 1, \"ParseProbe\", \"\", nil, []refusalTestRef{{file: \"manifest_test.go\", test: \"TestProbeDocumentRefusals\"}}},\n492|\t{\"manifest.go\", \"ParseProbe\", \"CodeMismatch\", \"probe platform\", 1, \"ParseProbe\", \"\", nil, []refusalTestRef{{file: \"manifest_test.go\", test: \"TestProbeDocumentRefusals\"}}},\n493|\t{\"manifest.go\", \"ParseProbe\", \"CodeMismatch\", \"probe protocol major 1\", 1, \"ParseProbe\", \"\", nil, []refusalTestRef{{file: \"manifest_test.go\", test: \"TestProbeDocumentRefusals\"}}},\n494|\t{\"manifest.go\", \"ParseProbe\", \"CodeMismatch\", \"probe schema\", 1, \"ParseProbe\", \"\", nil, []refusalTestRef{{file: \"manifest_test.go\", test: \"TestProbeDocumentRefusals\"}}},\n495|\t{\"manifest.go\", \"ParseProbe\", \"CodeMismatch\", \"probe schema version\", 1, \"ParseProbe\", \"\