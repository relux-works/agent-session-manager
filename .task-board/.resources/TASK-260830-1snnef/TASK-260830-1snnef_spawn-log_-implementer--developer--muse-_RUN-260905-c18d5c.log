{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7b3","stream":{"kind":"session","id":"01a06f78-0ca7-7650-b043-6178918d4030"},"sequence":564,"recorded_at":1780531400001123,"record_type":"event","durability":"durable","causation_id":"09066c51-cf5e-4ab0-8fb1-8339d1838d54","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"09066c51-cf5e-4ab0-8fb1-8339d1838d54","run_stream":{"kind":"run","id":"09066c51-cf5e-4ab0-8fb1-8339d1838d54"},"task_stream":{"kind":"task","id":"f7c13511-e08d-4a3b-a0df-af907f7a7560"},"task_id":"f7c13511-e08d-4a3b-a0df-af907f7a7560","event":{"kind":"output","task_id":"f7c13511-e08d-4a3b-a0df-af907f7a7560","chunk":"Read text file `internal/terminalbackend/conformance_test.go`.\n(940 line(s) above)\n941|// TestCheckAttachRequestBindsTransportInputAndExpiry proves the attach\n942|// row at the production entry: the request must equal the authorized\n943|// transport and input boolean, a relay transport is refused even when\n944|// named, and an expired policy authorizes nothing.\n945|func TestCheckAttachRequestBindsTransportInputAndExpiry(t *testing.T) {\n946|\tt.Parallel()\n947|\n948|\tauth := testAttachAuthorization(t)\n949|\tif err := terminalbackend.CheckAttachRequest(auth, \"local_only\", true, conformanceNow()); err != nil {\n950|\t\tt.Errorf(\"CheckAttachRequest() error = %v, want admission\", err)\n951|\t}\n952|\n953|\tmismatched, err := terminalbackend.ParseAttachAuthorization([]byte(\n954|\t\t`{\"policy_evidence_id\":\"` + testDigest + `\",` +\n955|\t\t\t`\"authorizing_host_id\":\"` + conformanceHost + `\",` +\n956|\t\t\t`\"transport\":\"trusted_private_mesh\",` +\n957|\t\t\t`\"input_authorized\":false,` +\n958|\t\t\t`\"issued_at\":\"` + conformanceIssued + `\",` +\n959|\t\t\t`\"expires_at\":\"` + conformanceExpires + `\"}`))\n960|\tif err != nil {\n961|\t\tt.Fatalf(\"ParseAttachAuthorization() error = %v\", err)\n962|\t}\n963|\tif err := terminalbackend.CheckAttachRequest(\n964|\t\tmismatched, \"trusted_private_mesh\", false, conformanceNow()); err != nil {\n965|\t\tt.Errorf(\"CheckAttachRequest(mesh, false) error = %v, want admission\", err)\n966|\t}\n967|\n968|\twrongTransport := terminalbackend.CheckAttachRequest(auth, \"trusted_private_mesh\", true, conformanceNow())\n969|\trequireConformanceRefusal(t, wrongTransport,\n970|\t\t\"terminal_backend_unauthorized\", \"attach authorization binding\")\n971|\twrongInput := terminalbackend.CheckAttachRequest(auth, \"local_only\", false, conformanceNow())\n972|\trequireConformanceRefusal(t, wrongInput,\n973|\t\t\"terminal_backend_unauthorized\", \"attach authorization binding\")\n974|\tunknownTransport := terminalbackend.CheckAttachRequest(auth, \"courier_pigeon\", true, conformanceNow())\n975|\trequireConformanceRefusal(t, unknownTransport,\n976|\t\t\"terminal_backend_protocol_error\", \"presentation transport vocabulary\")\n977|\n978|\texpired := conformanceNow().Add(48 * time.Hour)\n979|\trequireConformanceRefusal(t,\n980|\t\tterminalbackend.CheckAttachRequest(auth, \"local_only\", true, expired),\n981|\t\t\"terminal_backend_unauthorized\", \"attach authorization expiry\")\n982|\n983|\trelayAuth, err := terminalbackend.ParseAttachAuthorization([]byte(\n984|\t\t`{\"policy_evidence_id\":\"` + testDigest + `\",` +\n985|\t\t\t`\"authorizing_host_id\":\"` + conformanceHost + `\",` +\n986|\t\t\t`\"transport\":\"third_party_relay\",` +\n987|\t\t\t`\"input_authorized\":false,` +\n988|\t\t\t`\"issued_at\":\"` + conformanceIssued + `\",` +\n989|\t\t\t`\"expires_at\":\"` + conformanceExpires + `\"}`))\n990|\tif err != nil {\n991|\t\tt.Fatalf(\"ParseAttachAuthorization(relay) error = %v\", err)\n992|\t}\n993|\trequireConformanceRefusal(t,\n994|\t\tterminalbackend.CheckAttachRequest(relayAuth, \"third_party_relay\", false, conformanceNow()),\n995|\t\t\"terminal_backend_unauthorized\", \"attach relay transport\")\n996|}\n997|\n998|// TestCheckAttachResultRequiresTripleEquality proves the result rule: the\n999|// reported input boolean must equal both the request and the policy. A\n1000|// backend granting input the policy withheld is refused even when the\n1001|// request itself was authorized.\n1002|func TestCheckAttachResultRequiresTripleEquality(t *testing.T) {\n1003|\tt.Parallel()\n1004|\n1005|\tauth := testAttachAuthorization(t)\n1006|\tif err := terminalbackend.CheckAttachResult(true, true, auth); err != nil {\n1007|\t\tt.Errorf(\"CheckAttachResult(true, true) error = %v, want admission\", err)\n1008|\t}\n1009|\n1010|\tgranted := terminalbackend.CheckAttachResult(false, true, auth)\n1011|\trequireConformanceRefusal(t, granted,\n1012|\t\t\"terminal_backend_unauthorized\", \"attach input binding\")\n1013|\trevoked := terminalbackend.CheckAttachResult(true, false, auth)\n1014|\trequireConformanceRefusal(t, revoked,\n1015|\t\t\"terminal_backend_unauthorized\", \"attach input binding\")\n1016|}\n1017|\n1018|// TestCheckEntrypointAdmitsOnlyAxPane proves the §4.A stable entrypoint:\n1019|// exactly ax, pane, and the canonical session string. A raw provider\n1020|// command, a reordered argv, or a session that is not the one under\n1021|// creation cannot serve as the durable entry point.\n1022|func TestCheckEntrypointAdmitsOnlyAxPane(t *testing.T) {\n1023|\tt.Parallel()\n1024|\n1025|\tif err := terminalbackend.CheckEntrypoint(\n1026|\t\t[]string{\"ax\", \"pane\", conformanceSessionA}, conformanceSessionA); err != nil {\n1027|\t\tt.Errorf(\"CheckEntrypoint() error = %v, want admission\", err)\n1028|\t}\n1029|\n1030|\trefused := []struct {\n1031|\t\tname    string\n1032|\t\targv    []string\n1033|\t\tsession string\n1034|\t}{\n1035|\t\t{\"raw provider command\", []string{\"codex\", \"--session\", conformanceSessionA}, conformanceSessionA},\n1036|\t\t{\"provider binary with pane\", []string{\"codex\", \"pane\", conformanceSessionA}, conformanceSessionA},\n1037|\t\t{\"reordered argv\", []string{\"pane\", \"ax\", conformanceSessionA}, conformanceSessionA},\n1038|\t\t{\"uppercase binary\", []string{\"AX\", \"pane\", conformanceSessionA}, conformanceSessionA},\n1039|\t\t{\"missing session\", []string{\"ax\", \"pane\"}, conformanceSessionA},\n1040|\t\t{\"extra argv\", []string{\"ax\", \"pane\", conformanceSessionA, \"--extra\"}, conformanceSessionA},\n1041|\t\t{\"empty argv\", nil, conformanceSessionA},\n1042|\t\t{\"wrong session\", []string{\"ax\", \"pane\", conformanceSessionB}, conformanceSessionA},\n1043|\t\t{\"non-uuid session\", []string{\"ax\", \"pane\", \"not-a-session\"}, \"not-a-session\"},\n1044|\t\t{\"uuidv4 session\", []string{\"ax\", \"pane\", \"0198f4c8-8e50-4f66-8f70-1234567890ab\"},\n1045|\t\t\t\"0198f4c8-8e50-4f66-8f70-1234567890ab\"},\n1046|\t}\n1047|\tfor _, tc := range refused {\n1048|\t\terr := terminalbackend.CheckEntrypoint(tc.argv, tc.session)\n1049|\t\tif err == nil {\n1050|\t\t\tt.Errorf(\"CheckEntrypoint(%q, %q) = nil, want refusal\", tc.argv, tc.session)\n1051|\t\t\tcontinue\n1052|\t\t}\n1053|\t\tvar refusal *terminalbackend.Error\n1054|\t\tif !errors.As(err, &refusal) || refusal.Code != \"local_precondition_failed\" {\n1055|\t\t\tt.Errorf(\"CheckEntrypoint(%q, %q) = %v, want local_precondition_failed\",\n1056|\t\t\t\ttc.argv, tc.session, err)\n1057|\t\t\tcontinue\n1058|\t\t}\n1059|\t\tif refusal.Detail != \"entrypoint argv\" && refusal.Detail != \"entrypoint session binding\" {\n1060|\t\t\tt.Errorf(\"CheckEntrypoint(%q, %q) detail = %q, want an entrypoint clause\",\n(more lines below)"}}}
