ed catalog error vocabulary\n22|// and a static Detail clause, following the package convention.\n23|package terminalbackend\n24|\n25|import (\n26|\t\"sort\"\n27|\t\"strings\"\n28|\t\"sync\"\n29|\t\"time\"\n30|\n31|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n32|)\n33|\n34|// Wire error codes this file may report. Each is a member of the pinned\n35|// catalog error vocabulary; TestWireCodesAreCatalogued proves no other code\n36|// is advertised.\n37|const (\n38|\t// CodeProtocolError reports an unknown operation, state, or member, a\n39|\t// body variant outside the closed §4.C matrix, or an error code the\n40|\t// backend MUST NOT emit for the operation (§4.B, §4.C). AX-local\n41|\t// parsing may additionally emit it for a syntactically valid request\n42|\t// the matrix does not cover.\n43|\tCodeProtocolError = \"terminal_backend_protocol_error\"\n44|\t// CodeUnauthorized reports an expired, mismatched, or otherwise\n45|\t// unsatisfiable attach authorization (§4.C attach row).\n46|\tCodeUnauthorized = \"terminal_backend_unauthorized\"\n47|\t// CodeUnavailable reports a backend that cannot serve the operation.\n48|\t// It appears here only inside the allowed-error sets: no conformance\n49|\t// refusal in this file emits it, so it carries no arm of its own.\n50|\tCodeUnavailable = \"terminal_backend_unavailable\"\n51|\t// CodePreconditionFailed reports a legal request against an illegal\n52|\t// source state, a non-conforming stable entrypoint, or any other\n53|\t// unmet local precondition (§4.C per-operation rows, §4.1).\n54|\tCodePreconditionFailed = \"local_precondition_failed\"\n55|\t// CodeIdempotencyMismatch reports a changed operation inside an\n56|\t// established idempotency window (§4.C, §4.1).\n57|\tCodeIdempotencyMismatch = \"idempotency_mismatch\"\n58|\t// CodeIncompatibleSchema reports a legacy identity with no canonical\n59|\t// projection, or a canonical identity with no legacy projection\n60|\t// (§4.E). It never falls back.\n61|\tCodeIncompatibleSchema = \"incompatible_schema\"\n62|)\n63|\n64|// IsProtocolError reports CodeProtocolError refusals.\n65|func IsProtocolError(err error) bool { return errorCode(err, CodeProtocolError) }\n66|\n67|// IsUnauthorized reports CodeUnauthorized refusals.\n68|func IsUnauthorized(err error) bool { return errorCode(err, CodeUnauthorized) }\n69|\n70|// IsPreconditionFailed reports CodePreconditionFailed refusals.\n71|func IsPreconditionFailed(err error) bool { return errorCode(err, CodePreconditionFailed) }\n72|\n73|// IsIdempotencyMismatch reports CodeIdempotencyMismatch refusals.\n74|func IsIdempotencyMismatch(err error) bool { return errorCode(err, CodeIdempotencyMismatch) }\n75|\n76|// IsIncompatibleSchema reports CodeIncompatibleSchema refusals.\n77|func IsIncompatibleSchema(err error) bool { return errorCode(err, CodeIncompatibleSchema) }\n78|\n79|// InstanceState is the closed §4.C TerminalInstanceState enum: local\n80|// hosting only, never a second ownership state machine.\n81|type InstanceState string\n82|\n83|// Terminal Instance states.\n84|const (\n85|\tStateAbsent      InstanceState = \"absent\"\n86|\tStateCreating    InstanceState = \"creating\"\n87|\tStateParked      InstanceState = \"parked\"\n88|\tStateActive      InstanceState = \"active\"\n89|\tStateQuiescing   InstanceState = \"quiescing\"\n90|\tStateStopped     InstanceState = \"stopped\"\n91|\tStateStaleFenced InstanceState = \"stale_fenced\"\n92|\tStateUnavailable InstanceState = \"unavailable\"\n93|)\n94|\n95|// ParseInstanceState admits exactly the eight §4.C states.\n96|func ParseInstanceState(value string) (InstanceState, error) {\n97|\tswitch InstanceState(value) {\n98|\tcase StateAbsent, StateCreating, StateParked, StateActive,\n99|\t\tStateQuiescing, StateStopped, StateStaleFenced, StateUnavailable:\n100|\t\treturn InstanceState(value), nil\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
