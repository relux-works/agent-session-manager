n185|// Current returns an isolated v0.5.0 catalog.\n186|func Current() Catalog {\n187|\tcatalog, err := ForRelease(ReleaseV050)\n188|\tif err != nil {\n189|\t\tpanic(fmt.Sprintf(\"generated current catalog is invalid: %v\", err))\n190|\t}\n191|\treturn catalog\n192|}\n193|\n194|// ForRelease returns an isolated exact catalog projection for a represented\n195|// release. It never coerces or guesses an unsupported release.\n196|func ForRelease(release Release) (Catalog, error) {\n197|\tcontracts, ok := generatedDefinition.Contracts[release]\n198|\tif !ok {\n199|\t\treturn Catalog{}, fmt.Errorf(\"%w: %s\", ErrUnsupportedRelease, release)\n200|\t}\n201|\n202|\tallowedVersions := make(map[ContractID]map[string]struct{}, len(contracts))\n203|\tfor _, contract := range contracts {\n204|\t\tversions := allowedVersions[contract.ID]\n205|\t\tif versions == nil {\n206|\t\t\tversions = make(map[string]struct{}, len(contract.Versions))\n207|\t\t\tallowedVersions[contract.ID] = versions\n208|\t\t}\n209|\t\tfor _, version := range contract.Versions {\n210|\t\t\tversions[version] = struct{}{}\n211|\t\t}\n212|\t}\n213|\n214|\tresult := Catalog{\n215|\t\tSource:         cloneSource(generatedDefinition.Source),\n216|\t\tRelease:        release,\n217|\t\tMetadataSHA256: generatedDefinition.MetadataSHA256,\n218|\t\tContracts:      cloneContracts(contracts),\n219|\t}\n(more lines below)"}}}
