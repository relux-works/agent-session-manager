{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c67f","stream":{"kind":"session","id":"01a06f78-0ca7-7650-b043-6178918d4030"},"sequence":410,"recorded_at":1780531400000815,"record_type":"event","durability":"durable","causation_id":"09066c51-cf5e-4ab0-8fb1-8339d1838d54","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"09066c51-cf5e-4ab0-8fb1-8339d1838d54","run_stream":{"kind":"run","id":"09066c51-cf5e-4ab0-8fb1-8339d1838d54"},"task_stream":{"kind":"task","id":"c5aed789-447b-4790-b090-44376a382c68"},"task_id":"c5aed789-447b-4790-b090-44376a382c68","event":{"kind":"output","task_id":"c5aed789-447b-4790-b090-44376a382c68","chunk":"Read text file `internal/terminalbackend/conformance_test.go`.\n(359 line(s) above)\n360|}\n361|\n362|// TestOnlyQuiesceInputEntersQuiescing proves the §4.C exclusivity rule:\n363|// entering quiescing from any other state happens only through\n364|// quiesce-input. wait-safe-boundary stays in quiescing without entering\n365|// it, and status only observes, so both are excluded by the\n366|// target-differs-from-source condition rather than by name.\n367|func TestOnlyQuiesceInputEntersQuiescing(t *testing.T) {\n368|\tt.Parallel()\n369|\n370|\toperations := []string{\n371|\t\t\"create\", \"attach\", \"status\",\n372|\t\t\"wait-safe-boundary\", \"request-stop\", \"terminate-stale\", \"restore\",\n373|\t}\n374|\tsources := []string{\n375|\t\t\"absent\", \"creating\", \"parked\", \"active\",\n376|\t\t\"quiescing\", \"stopped\", \"stale_fenced\", \"unavailable\",\n377|\t}\n378|\tfor _, operation := range operations {\n379|\t\tfor _, source := range sources {\n380|\t\t\tfor _, interactive := range []bool{false, true} {\n381|\t\t\t\ttarget, _, err := terminalbackend.CheckTransition(operation, source, interactive)\n382|\t\t\t\tif err != nil {\n383|\t\t\t\t\tcontinue\n384|\t\t\t\t}\n385|\t\t\t\tif target == \"quiescing\" && source != \"quiescing\" {\n386|\t\t\t\t\tt.Errorf(\"CheckTransition(%q, %q) enters quiescing: \"+\n387|\t\t\t\t\t\t\"only quiesce-input enters it\", operation, source)\n388|\t\t\t\t}\n389|\t\t\t}\n390|\t\t}\n391|\t}\n392|}\n393|\n394|// TestCheckErrorAllowedAdmitsEverySpecRowCode drives one listed code per\n395|// operation from the §4.C \"Allowed error codes\" column through the\n396|// production gate: the exact per-operation sets, including the restore\n397|// mismatch that belongs only to restore and the quiesce/stop timeouts\n398|// that belong only to their rows.\n399|func TestCheckErrorAllowedAdmitsEverySpecRowCode(t *testing.T) {\n400|\tt.Parallel()\n401|\n402|\tadmitted := map[string][]string{\n403|\t\t\"manifest\": {\n404|\t\t\t\"terminal_backend_protocol_error\",\n405|\t\t\t\"terminal_backend_protocol_incompatible\",\n406|\t\t\t\"terminal_backend_process_failed\",\n407|\t\t\t\"terminal_backend_timeout\",\n408|\t\t\t\"terminal_backend_integrity_failure\",\n409|\t\t},\n410|\t\t\"probe\": {\n411|\t\t\t\"terminal_backend_untrusted\",\n412|\t\t\t\"terminal_backend_manifest_probe_mismatch\",\n413|\t\t\t\"terminal_backend_implementation_drift\",\n414|\t\t},\n415|\t\t\"create\": {\n416|\t\t\t\"idempotency_mismatch\",\n417|\t\t\t\"local_precondition_failed\",\n418|\t\t\t\"terminal_backend_unauthorized\",\n419|\t\t\t\"terminal_backend_stale_generation\",\n420|\t\t\t\"terminal_backend_capability_unproven\",\n421|\t\t\t\"terminal_backend_unavailable\",\n422|\t\t},\n423|\t\t\"attach\": {\n424|\t\t\t\"idempotency_mismatch\",\n425|\t\t\t\"terminal_backend_unauthorized\",\n426|\t\t\t\"terminal_backend_stale_generation\",\n427|\t\t},\n428|\t\t\"status\": {\n429|\t\t\t\"terminal_backend_stale_generation\",\n430|\t\t\t\"terminal_backend_capability_unproven\",\n431|\t\t\t\"terminal_backend_unavailable\",\n432|\t\t},\n433|\t\t\"quiesce-input\": {\n434|\t\t\t\"idempotency_mismatch\",\n435|\t\t\t\"terminal_backend_unauthorized\",\n436|\t\t\t\"terminal_backend_timeout\",\n437|\t\t},\n438|\t\t\"wait-safe-boundary\": {\n439|\t\t\t\"quiesce_timeout\",\n440|\t\t},\n441|\t\t\"request-stop\": {\n442|\t\t\t\"stop_timeout\",\n443|\t\t\t\"terminal_backend_process_failed\",\n444|\t\t},\n445|\t\t\"terminate-stale\": {\n446|\t\t\t\"idempotency_mismatch\",\n447|\t\t\t\"terminal_backend_process_failed\",\n448|\t\t},\n449|\t\t\"restore\": {\n450|\t\t\t\"terminal_backend_restore_mismatch\",\n451|\t\t\t\"terminal_backend_unavailable\",\n452|\t\t},\n453|\t}\n454|\tfor operation, codes := range admitted {\n455|\t\tfor _, code := range codes {\n456|\t\t\tif err := terminalbackend.CheckErrorAllowed(operation, code); err != nil {\n457|\t\t\t\tt.Errorf(\"CheckErrorAllowed(%q, %q) error = %v, want admission\",\n458|\t\t\t\t\toperation, code, err)\n459|\t\t\t}\n460|\t\t}\n461|\t}\n462|}\n463|\n464|// TestCheckErrorAllowedRefusesEveryUnlistedCode is the narrowing arm of\n465|// the error mapping: codes that belong to neighbouring rows are refused\n466|// when reported for the wrong operation, so a widened row reddens here.\n467|// restore_mismatch belongs only to restore, the quiesce/stop timeouts\n468|// only to their rows, and drift/mismatch only to probe admission.\n469|func TestCheckErrorAllowedRefusesEveryUnlistedCode(t *testing.T) {\n470|\tt.Parallel()\n471|\n472|\trefused := map[string][]string{\n473|\t\t\"manifest\": {\n474|\t\t\t\"terminal_backend_restore_mismatch\",\n475|\t\t\t\"terminal_backend_unauthorized\",\n476|\t\t\t\"idempotency_mismatch\",\n477|\t\t\t\"local_precondition_failed\",\n478|\t\t\t\"quiesce_timeout\",\n479|\t\t},\n480|\t\t\"probe\": {\n481|\t\t\t\"terminal_backend_restore_mismatch\",\n482|\t\t\t\"terminal_backend_unauthorized\",\n483|\t\t\t\"idempotency_mismatch\",\n484|\t\t\t\"quiesce_timeout\",\n485|\t\t},\n486|\t\t\"create\": {\n487|\t\t\t\"terminal_backend_restore_mismatch\",\n488|\t\t\t\"terminal_backend_manifest_probe_mismatch\",\n489|\t\t\t\"terminal_backend_implementation_drift\",\n490|\t\t\t\"quiesce_timeout\",\n491|\t\t\t\"stop_timeout\",\n492|\t\t},\n493|\t\t\"attach\": {\n494|\t\t\t\"terminal_backend_restore_mismatch\",\n495|\t\t\t\"terminal_backend_manifest_probe_mismatch\",\n496|\t\t\t\"quiesce_timeout\",\n497|\t\t\t\"stop_timeout\",\n498|\t\t},\n499|\t\t\"status\": {\n500|\t\t\t\"idempotency_mismatch\",\n501|\t\t\t\"local_precondition_failed\",\n502|\t\t\t\"terminal_backend_unauthorized\",\n503|\t\t\t\"terminal_backend_restore_mismatch\",\n504|\t\t\t\"terminal_backend_manifest_probe_mismatch\",\n505|\t\t},\n506|\t\t\"quiesce-input\": {\n507|\t\t\t\"terminal_backend_restore_mismatch\",\n508|\t\t\t\"quiesce_timeout\",\n509|\t\t\t\"stop_timeout\",\n510|\t\t},\n511|\t\t\"wait-safe-boundary\": {\n512|\t\t\t\"stop_timeout\",\n513|\t\t\t\"terminal_backend_timeout\",\n514|\t\t\t\"terminal_backend_restore_mismatch\",\n515|\t\t},\n516|\t\t\"request-stop\": {\n517|\t\t\t\"quiesce_timeout\",\n518|\t\t\t\"terminal_backend_timeout\",\n519|\t\t\t\"terminal_backend_restore_mismatch\",\n520|\t\t},\n521|\t\t\"terminate-stale\": {\n522|\t\t\t\"terminal_backend_restore_mismatch\",\n523|\t\t\t\"quiesce_timeout\",\n524|\t\t\t\"stop_timeout\",\n525|\t\t},\n526|\t\t\"restore\": {\n527|\t\t\t\"terminal_backend_manifest_probe_mismatch\",\n528|\t\t\t\"terminal_backend_implementation_drift\",\n529|\t\t\t\"quiesce_timeout\",\n530|\t\t\t\"stop_timeout\",\n531|\t\t},\n532|\t}\n533|\tfor operation, codes := range refused {\n534|\t\tfor _, code := range codes {\n535|\t\t\terr := terminalbackend.CheckErrorAllowed(operation, code)\n536|\t\t\trequireConformanceRefusal(t, err,\n537|\t\t\t\t\"terminal_backend_protocol_error\", \"operation error vocabulary\")\n538|\t\t}\n539|\t}\n540|\n541|\tif err := terminalbackend.CheckErrorAllowed(\"launch\", \"terminal_backend_timeout\"); err == nil {\n542|\t\tt.Errorf(\"CheckErrorAllowed(launch, ...) = nil, want operation vocabulary refusal\")\n543|\t} else {\n544|\t\trequireConformanceRefusal(t, err,\n545|\t\t\t\"terminal_backend_protocol_error\", \"operation vocabulary\")\n546|\t}\n547|}\n548|\n549|// TestIdempotencyKeyDerivesCanonicalForms proves the per-operation key\n550|// shapes of §4.C and §4.1: the key is derived, never caller-chosen free\n551|// text, and the segment order is fixed.\n552|func TestIdempotencyKeyDerivesCanonicalForms(t *testing.T) {\n553|\tt.Parallel()\n554|\n555|\tcases := []struct {\n556|\t\toperation string\n557|\t\tsegments  []string\n558|\t\twant      string\n559|\t}{\n560|\t\t{\"manifest\", []string{\"req-1\"}, \"req-1\"},\n561|\t\t{\"probe\", []string{\"req-2\"}, \"req-2\"},\n562|\t\t{\"create\", []string{conformanceSessionA, \"bootstrap-1\"},\n563|\t\t\tconformanceSessionA + \"/bootstrap-1\"},\n564|\t\t{\"restore\", []string{conformanceSessionA, \"bootstrap-2\"},\n565|\t\t\tconformanceSessionA + \"/bootstrap-2\"},\n566|\t\t{\"attach\", []string{\"instance-1\", \"client-1\"}, \"instance-1/client-1\"},\n567|\t\t{\"quiesce-input\", []string{\"instance-1\", \"quiesce\", \"gen-1\"},\n568|\t\t\t\"instance-1/quiesce/gen-1\"},\n569|\t\t{\"wait-safe-boundary\",\n570|\t\t\t[]string{\"instance-1\", \"boundary\", \"gen-1\", \"provider_quiescence\"},\n571|\t\t\t\"instance-1/boundary/gen-1/provider_quiescence\"},\n572|\t\t{\"request-stop\", []string{\"instance-1\", \"stop\", \"sha256:abc\"},\n573|\t\t\t\"instance-1/stop/sha256:abc\"},\n574|\t\t{\"terminate-stale\",\n575|\t\t\t[]string{\"instance-1\", \"terminate\", \"lease-1\", \"41\"},\n576|\t\t\t\"instance-1/terminate/lease-1/41\"},\n577|\t\t{\"status\", []string{conformanceSessionA}, conformanceSessionA},\n578|\t\t{\"status\",\n579|\t\t\t[]string{conformanceSessionA, \"instance-1\", \"ax.tmux\", \"1.2.3\", \"1.0.0\", \"gen-1\"},\n(more lines below)"}}}
