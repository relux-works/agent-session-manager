{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5ef","stream":{"kind":"session","id":"01a06f78-0ca7-7650-b043-6178918d4030"},"sequence":338,"recorded_at":1780531400000671,"record_type":"event","durability":"durable","causation_id":"09066c51-cf5e-4ab0-8fb1-8339d1838d54","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"09066c51-cf5e-4ab0-8fb1-8339d1838d54","run_stream":{"kind":"run","id":"09066c51-cf5e-4ab0-8fb1-8339d1838d54"},"task_stream":{"kind":"task","id":"aa942261-b69a-4cc9-9344-9fa5b4e7d2f3"},"task_id":"aa942261-b69a-4cc9-9344-9fa5b4e7d2f3","event":{"kind":"output","task_id":"aa942261-b69a-4cc9-9344-9fa5b4e7d2f3","chunk":"Read text file `internal/terminalbackend/conformance.go`.\n(329 line(s) above)\n330|\t}\n331|\tif !allowed {\n332|\t\treturn \"\", nil, &Error{Code: CodePreconditionFailed, Detail: \"lifecycle transition\"}\n333|\t}\n334|\tif row.SameState {\n335|\t\treturn parsedSource, nil, nil\n336|\t}\n337|\tif parsedOperation == OperationCreate && !interactive {\n338|\t\treturn StateParked, append([]SideEffect(nil), row.Effects...), nil\n339|\t}\n340|\treturn row.Target, append([]SideEffect(nil), row.Effects...), nil\n341|}\n342|\n343|// allowedOperationErrors is the exact §4.C \"Allowed error codes\" column.\n344|// An error not listed for an operation MUST NOT be emitted by the backend\n345|// for a syntactically valid request; AX-local parsing may additionally\n346|// emit terminal_backend_protocol_error, which every row therefore carries.\n347|var allowedOperationErrors = map[Operation][]string{\n348|\tOperationManifest: {\n349|\t\tCodeProtocolError, \"terminal_backend_protocol_incompatible\",\n350|\t\t\"terminal_backend_process_failed\", \"terminal_backend_timeout\",\n351|\t\tCodeIntegrityFailure,\n352|\t},\n353|\tOperationProbe: {\n354|\t\tCodeUntrusted, CodeMismatch, CodeDrift,\n355|\t\tCodeProtocolError, \"terminal_backend_process_failed\", \"terminal_backend_timeout\",\n356|\t\tCodeIntegrityFailure,\n357|\t},\n358|\tOperationCreate: {\n359|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n360|\t\tCodeStaleGeneration, CodeCapabilityUnproven, CodeUnavailable,\n361|\t\t\"terminal_backend_timeout\", \"terminal_backend_process_failed\",\n362|\t\tCodeIntegrityFailure, CodeProtocolError,\n363|\t},\n364|\tOperationAttach: {\n365|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n366|\t\tCodeStaleGeneration, CodeCapabilityUnproven, CodeUnavailable,\n367|\t\t\"terminal_backend_timeout\", \"terminal_backend_process_failed\",\n368|\t\tCodeIntegrityFailure, CodeProtocolError,\n369|\t},\n370|\tOperationStatus: {\n371|\t\tCodeStaleGeneration, CodeCapabilityUnproven, CodeUnavailable,\n372|\t\t\"terminal_backend_timeout\", CodeIntegrityFailure, CodeProtocolError,\n373|\t},\n374|\tOperationQuiesceInput: {\n375|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n376|\t\tCodeStaleGeneration, CodeCapabilityUnproven,\n377|\t\t\"terminal_backend_timeout\", CodeIntegrityFailure, CodeProtocolError,\n378|\t},\n379|\tOperationWaitSafeBoundary: {\n380|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n381|\t\tCodeStaleGeneration, CodeCapabilityUnproven,\n382|\t\t\"quiesce_timeout\", CodeIntegrityFailure, CodeProtocolError,\n383|\t},\n384|\tOperationRequestStop: {\n385|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n386|\t\tCodeStaleGeneration, CodeCapabilityUnproven,\n387|\t\t\"stop_timeout\", \"terminal_backend_process_failed\",\n388|\t\tCodeIntegrityFailure, CodeProtocolError,\n389|\t},\n390|\tOperationTerminateStale: {\n391|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n392|\t\tCodeStaleGeneration, CodeCapabilityUnproven,\n393|\t\t\"terminal_backend_timeout\", \"terminal_backend_process_failed\",\n394|\t\tCodeIntegrityFailure, CodeProtocolError,\n395|\t},\n396|\tOperationRestore: {\n397|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n398|\t\tCodeStaleGeneration, CodeCapabilityUnproven, CodeRestoreMismatch,\n399|\t\tCodeUnavailable, \"terminal_backend_timeout\", \"terminal_backend_process_failed\",\n400|\t\tCodeIntegrityFailure, CodeProtocolError,\n401|\t},\n402|}\n403|\n404|// CheckErrorAllowed enforces the §4.C error mapping: a backend reporting a\n405|// code outside the operation's allowed set violates the contract, and the\n406|// report itself is refused as a protocol error. It names the production\n407|// reporting site, not the underlying failure.\n408|func CheckErrorAllowed(operation, code string) error {\n409|\tparsedOperation, err := ParseOperation(operation)\n410|\tif err != nil {\n411|\t\treturn err\n412|\t}\n413|\tfor _, allowed := range allowedOperationErrors[parsedOperation] {\n414|\t\tif code == allowed {\n415|\t\t\treturn nil\n416|\t\t}\n417|\t}\n418|\treturn &Error{Code: CodeProtocolError, Detail: \"operation error vocabulary\"}\n419|}\n420|\n421|// IdempotencyKey derives the canonical UTF-8 idempotency key for one\n422|// operation from its identity segments (§4.C authorization and idempotency\n423|// column, §4.1 bootstrap binding). The key is never caller-chosen free\n424|// text: the segment count and order are fixed per operation, and every\n425|// segment must be non-empty.\n426|//\n427|// The per-operation forms are: manifest and probe take the request ID\n428|// alone; create and restore take session_id + bootstrap_operation_id;\n429|// attach takes terminal_instance_id + client_id; quiesce-input takes\n430|// terminal_instance_id + \"quiesce\" + quiescence_generation;\n431|// wait-safe-boundary takes terminal_instance_id + \"boundary\" +\n432|// quiescence_generation + provider_proof_kind; request-stop takes\n433|// terminal_instance_id + \"stop\" + safe_boundary_evidence_id;\n434|// terminate-stale takes terminal_instance_id + \"terminate\" +\n435|// stale_lease_id + decimal stale_epoch; status takes its full queried\n436|// identity tuple, of at least one segment.\n437|func IdempotencyKey(operation string, segments ...string) (string, error) {\n438|\tparsedOperation, err := ParseOperation(operation)\n439|\tif err != nil {\n440|\t\treturn \"\", err\n441|\t}\n442|\tfor _, segment := range segments {\n443|\t\tif segment == \"\" {\n444|\t\t\treturn \"\", &Error{Code: CodeProtocolError, Detail: \"idempotency key shape\"}\n445|\t\t}\n446|\t}\n447|\twant := idempotencyKeySegments[parsedOperation]\n448|\tif want < 0 {\n449|\t\tif len(segments) < 1 {\n450|\t\t\treturn \"\", &Error{Code: CodeProtocolError, Detail: \"idempotency key shape\"}\n451|\t\t}\n452|\t} else if len(segments) != want {\n453|\t\treturn \"\", &Error{Code: CodeProtocolError, Detail: \"idempotency key shape\"}\n454|\t}\n455|\treturn strings.Join(segments, \"/\"), nil\n456|}\n457|\n458|// idempotencyKeySegments is the fixed per-operation segment count. status\n459|// carries its full queried identity tuple, so its count varies and only\n(more lines below)"}}}
