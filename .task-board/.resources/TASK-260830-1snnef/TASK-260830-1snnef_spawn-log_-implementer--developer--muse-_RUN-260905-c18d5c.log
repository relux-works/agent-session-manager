terExternal\", \"\", nil, []refusalTestRef{{file: \"terminalbackend_test.go\", test: \"TestRegisterExternalRefusals\"}}},\n608|\t{\"terminalbackend.go\", \"Registry.RegisterExternal\", \"CodeUntrusted\", \"external implementation_kind\", 1, \"RegisterExternal\", \"\", nil, []refusalTestRef{{file: \"terminalbackend_test.go\", test: \"TestRegisterExternalRefusesUnknownKindAsUntrusted\"}}},\n609|\t{\"terminalbackend.go\", \"Registry.RegisterExternal\", \"CodeUntrusted\", \"external_trust disabled\", 1, \"RegisterExternal\", \"\", nil, []refusalTestRef{{file: \"terminalbackend_test.go\", test: \"TestRegisterExternalRefusals\"}}},\n610|\t{\"terminalbackend.go\", \"Registry.RequireRestoreBinding\", \"CodeNotFound\", \"registry unavailable\", 1, \"RequireRestoreBinding\", \"\", nil, []refusalTestRef{{file: \"terminalbackend_test.go\", test: \"TestRequireRestoreBinding\"}}},\n611|\t{\"terminalbackend.go\", \"Registry.RequireRestoreBinding\", \"CodeRestoreMismatch\", \"restore requires the prior binding\", 1, \"RequireRestoreBinding\", \"\", nil, []refusalTestRef{{file: \"terminalbackend_test.go\", test: \"TestRequireRestoreBinding\"}}},\n612|\t{\"terminalbackend.go\", \"Registry.Resolve\", \"CodeNotFound\", \"registry unavailable\", 1, \"Resolve\", \"\", nil, []refusalTestRef{{file: \"terminalbackend_test.go\", test: \"TestResolveUnknownIsNeverAbsence\"}}},\n613|\t{\"terminalbackend.go\", \"Registry.Resolve\", \"CodeNotFound\", \"unregistered terminal_backend_id\", 1, \"Resolve\", \"\", nil, []refusalTestRef{{file: \"terminalbackend_test.go\", test: \"TestResolveUnknownIsNeverAbsence\"}}},\n614|\t{\"terminalbackend.go\", \"TrustEntry.validate\", \"CodeAmbiguous\", \"external_trust reserved namespace\", 1, \"RegisterExternal\", \"\", nil, []refusalTestRef{{file: \"terminalbackend_test.go\", test: \"TestRegisterExternalRefusesReservedNamespaceDistinguishingValue\"}}},\n615|\t{\"terminalbackend.go\", \"TrustEntry.validate\", \"CodeUntrusted\", \"external_trust executable_digest\", 1, \"RegisterExternal\", \"\", nil, []refusalTestRef{{file: \"terminalbackend_test.go\", test: \"TestRegisterExternalRefusals\"}}},\n616|\t{\"terminalbackend.go\", \"TrustEntry.validate\", \"CodeUntrusted\", \"external_trust executable_path\", 1, \"RegisterExternal\", \"\", nil, []refusalTestRef{{file: \"terminalbackend_test.go\", test: \"TestRegisterExternalRefusals\"}}},\n617|\t{\"terminalbackend.go\", \"checkGeneration\", \"CodeStaleGeneration\", \"backend_generation bound\", 1, \"CheckProviderDescriptor\", \"\", nil, []refusalTestRef{{file: \"terminalbackend_test.go\", test: \"TestCheckProviderDescriptorGenerationBounds\"}}},\n618|\t{\"terminalbackend.go\", \"parseKind\", \"CodeNotFound\", \"implementation_kind vocabulary\", 1, \"parseKind\", \"\", nil, []refusalTestRef{{file: \"internal_pin_test.go\", test: \"TestParseKindAdmitsOnlyTheClosedVocabulary\"}}},\n619|\t{\"terminalbackend.go\", \"validateProtocolVersions\", \"CodeDrift\", \"protocol_versions bound\", 1, \"New\", \"\", nil, []refusalTestRef{{file: \"terminalbackend_test.go\", test: \"TestNewRefusesBadVersionTuples\"}}},\n620|\t{\"terminalbackend.go\", \"validateProtocolVersions\", \"CodeDrift\", \"protocol_versions major 1\", 1, \"RegisterExternal\", \"\", nil, []refusalTestRef{{file: \"terminalbackend_test.go\", test: \"TestRegisterExternalRefusals\"}}},\n621|\t{\"terminalbackend.go\", \"validateProtocolVersions\", \"CodeDrift\", \"protocol_versions sorted unique\", 1, \"New\", \"\", nil, []refusalTestRef{{file: \"terminalbackend_test.go\", test: \"TestNewRefusesBadVersionTuples\"}}},\n622|}\n623|\n624|// funneledPlatformDetails is the exact error set validatePlatforms can\n625|// produce, funneled through the single Registration.validate arm below.\n626|// TestPlatformFunnelDetailsAreExactlyThese derives the set from the\n627|// production AST and requires equality, so a fourth platform error is a\n628|// red rather than a silently widened funnel.\n629|var funneledPlatformDetails = []string{\n630|\t\"platforms bound\",\n631|\t\"platforms vocabulary\",\n632|\t\"platforms sorted unique\",\n633|}\n634|\n635|// funneledPlatformArm declares the single dynamic-detail arm. Its tests\n636|// must mention every funneled detail, not just one of them.\n637|var funneledPlatformArm = declaredRefusalArm{\n638|\tfile: \"terminalbackend.go\", function: \"Registration.validate\",\n639|\tcode: \"CodeNotFound\", detail: passthroughDetail, occurrence: 1,\n640|\tentry: \"RegisterExternal\",\n641|\ttests: []refusalTestRef{{file: \"terminalbackend_test.go\", test: \"TestRegisterExternalRefusesPlatformViolations\"}},\n642|}\n643|\n644|// armlessCodes names wire codes with no refusal arm by design.\n645|// CodeUnavailable appears only inside the allowed-error sets; no\n646|// conformance refusal emits it, so it carries no arm of its own.\n647|var armlessCodes = map[string]bool{\n648|\t\"CodeUnavailable\": true,\n649|}\n650|\n651|// plainErrorFunctions names the only production functions allowed to\n652|// construct non-wire errors. validatePlatforms feeds the pinned funnel;\n653|// DigestFile reports I/O failures that must never be wire errors.\n654|var plainErrorFunctions = map[string]bool{\n655|\t\"validatePlatforms\": true,\n656|\t\"DigestFile\":        true,\n657|}\n658|\n659|// TestDerivedRefusalArmsAreAllDeclared is the forward direction: every\n660|// arm the production AST derives resolves to exactly one declared row.\n661|// A brand-new arm with a brand-new detail fails here until its witness\n662|// is recorded.\n663|func TestDerivedRefusalArmsAreAllDeclared(t *testing.T) {\n664|\tt.Parallel()\n665|\n666|\tderived := deriveRefusalArms(t)\n667|\trows := declaredRows()\n668|\tmatched := make([]bool, len(derived))\n669|\tfor _, row := range rows {\n670|\t\tmatches := []int{}\n671|\t\tfor index, arm := range derived {\n672|\t\t\tif armMatchesRow(arm, row) {\n673|\t\t\t\tmatches = append(matches, index)\n674|\t\t\t}\n675|\t\t}\n676|\t\tif len(matches) != 1 {\n677|\t\t\tt.Errorf(\"declared row %s resolves to %d derived arms, want exactly one\",\n678|\t\t\t\tdescribeRow(row), len(matches))\n679|\t\t\tcontinue\n680|\t\t}\n681|\t\tif matched[matches[0]] {\n682|\t\t\tt.Errorf(\"declared row %s claims an arm an earlier row already claimed: %s\",\n683|\t\t\t\tdescribeRow(row), describeArm(derived[matches[0]]))\n684|\t\t\tcontinue\n685|\t\t}\n686|\t\tmatched[matches[0]] = true\n687|\t}\n688|\tfor index, claimed := range matched {\n689|\t\tif !claimed {\n690|\t\t\tt.Errorf(\"derived arm has no declaring row, so nothing witnesses it: %s\",\n691|\t\t\t\tdescribeArm(derived[index]))\n692|\t\t}\n693|\t}\n694|}\n695|\n696|// TestDeclaredRefusalArmsAreAllDerived is the reverse direction: every\n697|// declared row resolves to exactly one derived arm. Without it the\n698|// forward direction passes vacuously on a truncated derivation, and a\n699|// deleted production guard lingers as a row pointing at nothing.\n700|func TestDeclaredRefusalArmsAreAllDerived(t *testing.T) {\n701|\tt.Parallel()\n702|\n703|\tderived := deriveRefusalArms(t)\n704|\tfor _, row := range declaredRows() {\n705|\t\tmatches := 0\n706|\t\tfor _, arm := range derived {\n707|\t\t\tif armMatchesRow(arm, row) {\n708|\t\t\t\tmatches++\n709|\t\t\t}\n710|\t\t}\n711|\t\tif matches != 1 {\n712|\t\t\tt.Errorf(\"declared row %s matches %d derived arms, want exactly one; \"+\n713|\t\t\t\t\"a row without an arm is a witness without a guard\", describeRow(row), matches)\n714|\t\t}\n715|\t}\n716|\tif len(derived) != len(declaredRows()) {\n717|\t\tt.Errorf(\"derived %d arms but declared %d rows; the table is not a bijection\",\n718|\t\t\tlen(derived), len(declaredRows()))\n719|\t}\n720|}\n721|\n722|func armMatchesRow(arm refusalArm, row declaredRefusalArm) bool {\n723|\treturn arm.file == row.file && arm.function == row.function &&\n724|\t\tarm.code == row.code && arm.detail == row.detail &&\n725|\t\tarm.occurrence == row.occurrence\n726|}\n727|\n728|func describeArm(arm refusalArm) string {\n729|\treturn arm.file + \" \" + arm.function + \" \" + arm.code + \" \" +\n730|\t\tstrconv.Quote(arm.detail) + \" #\" + strconv.Itoa(arm.occurrence)\n731|}\n732|\n733|func describeRow(row declaredRefusalArm) string {\n734|\treturn row.file + \" \" + row.function + \" \" + row.code + \" \" +\n735|\t\tstrconv.Quote(row.detail) + \" #\" + strconv.Itoa(row.occurrence)\n736|}\n737|\n738|// declaredRows returns the table plus the funnel row.\n739|func declaredRows() []declaredRefusalArm {\n740|\trows := append([]declaredRefusalArm(nil), declaredRefusalArms...)\n741|\tfunnel := funneledPlatformArm\n742|\tfunnel.detailSet = funneledPlatformDetails\n743|\treturn append(rows, funnel)\n744|}\n745|\n746|// TestDeclaredRefusalWiresMatchProductionConsts binds the table to the\n747|// production const values two ways: every row's code resolves to the\n748|// wire its test asserts, and every Code symbol except the named armless\n749|// one appears in at least one row, so a code nobody refuses is a red\n750|// rather than a quiet gap.\n751|func TestDeclaredRefusalWiresMatchProductionConsts(t *testing.T) {\n752|\tt.Parallel()\n753|\n754|\tsymbols := productionCodeSymbols(t)\n755|\tcovered := make(map[string]bool)\n756|\tfor _, row := range declaredRows() {\n757|\t\twire, known := symbols[row.code]\n758|\t\tif !known {\n759|\t\t\tt.Errorf(\"declared row %s names unknown code symbol %q\",\n760|\t\t\t\tdescribeRow(row), row.code)\n761|\t\t\tcontinue\n762|\t\t}\n763|\t\tcovered[row.code] = true\n764|\t\t_ = wire\n765|\t}\n766|\tfor symbol := range symbols {\n767|\t\tif armlessCodes[symbol] {\n768|\t\t\tcontinue\n769|\t\t}\n770|\t\tif !covered[symbol] {\n771|\t\t\tt.Errorf(\"code symbol %s has no refusal arm; a wire code nothing refuses is unwitnessed\", symbol)\n772|\t\t}\n773|\t}\n774|}\n775|\n776|// TestDeclaredRefusalTestsResolve requires every row to name real tests\n777|// that textually touch the arm: the detail literal, or the driven entry\n778|// plus the wire code (or its verified predicate). Bound rows name a test\n779|// driving the entry; the bound itself says why no document reaches them.\n780|func TestDeclaredRefusalTestsResolve(t *testing.T) {\n781|\tt.Parallel()\n782|\n783|\tbodies := testBodies(t)\n784|\tpredicates := predicateCodes(t)\n785|\tsymbols := productionCodeSymbols(t)\n786|\tfor _, row := range declaredRows() {\n787|\t\tif len(row.tests) == 0 {\n788|\t\t\tt.Errorf(\"declared row %s names no test, so nothing measures it\", describeRow(row))\n789|\t\t\tcontinue\n790|\t\t}\n791|\t\tresolved := false\n792|\t\tfor _, reference := range row.tests {\n793|\t\t\tbody, declared := bodies[reference.file+\"\\n\"+reference.test]\n794|\t\t\tif !declared {\n795|\t\t\t\tt.Errorf(\"declared row %s names %s in %s, which is not declared\",\n796|\t\t\t\t\tdescribeRow(row), reference.test, reference.file)\n797|\t\t\t\tcontinue\n798|\t\t\t}\n799|\t\t\tif rowResolves(row, body, predicates, symbols) {\n800|\t\t\t\tresolved = true\n801|\t\t\t}\n802|\t\t}\n803|\t\tif !resolved {\n804|\t\t\tt.Errorf(\"declared row %s names no test touching it: want the detail %q or the entry %q \"+\n805|\t\t\t\t\"with its wire code in %v\", describeRow(row), row.detail, row.entry, row.tests)\n806|\t\t}\n807|\t}\n808|}\n809|\n810|// rowResolves reports whether one test body touches one row.\n811|func rowResolves(row declaredRefusalArm, body string, predicates map[string]string, symbols map[string]string) bool {\n812|\tif row.detail == passthroughDetail {\n813|\t\tfor _, detail := range row.detailSet {\n814|\t\t\tif !strings.Contains(body, detail) {\n815|\t\t\t\treturn false\n816|\t\t\t}\n817|\t\t}\n818|\t\treturn strings.Contains(body, row.entry)\n819|\t}\n820|\tif strings.Contains(body, row.detail) {\n821|\t\treturn true\n822|\t}\n823|\tif row.bound != \"\" {\n824|\t\treturn strings.Contains(body, row.entry)\n825|\t}\n826|\tif !strings.Contains(body, row.entry) {\n827|\t\treturn false\n828|\t}\n829|\tif strings.Contains(body, symbols[row.code]) {\n830|\t\treturn true\n831|\t}\n832|\tfor predicate, code := range predicates {\n833|\t\tif code == row.code && strings.Contains(body, predicate) {\n834|\t\t\treturn true\n835|\t\t}\n836|\t}\n837|\treturn false\n838|}\n839|\n840|// TestDefensiveBoundsAreExactlyThese pins the set of bound rows: a new\n841|// defensive arm must join this set deliberately, with its bound stated,\n842|// rather than slipping in as an ordinary row whose test cannot reach it.\n843|func TestDefensiveBoundsAreExactlyThese(t *testing.T) {\n844|\tt.Parallel()\n845|\n846|\twant := map[string]bool{\n847|\t\t\"conformance.go ParseAttachAuthorization CodeMismatch \\\"document timestamp\\\" #1\": true,\n848|\t\t\"conformance.go ParseAttachAuthorization CodeMismatch \\\"document timestamp\\\" #2\": true,\n849|\t\t\"conformance.go CheckAttachRequest CodeMismatch \\\"document timestamp\\\" #1\":       true,\n850|\t\t\"manifest.go checkEvidenceLiveness CodeMismatch \\\"document timestamp\\\" #1\":       true,\n851|\t\t\"manifest.go checkEvidenceLiveness CodeMismatch \\\"document timestamp\\\" #2\":       true,\n852|\t}\n853|\tfor _, row := range declaredRows() {\n854|\t\tif row.bound == \"\" {\n855|\t\t\tcontinue\n856|\t\t}\n857|\t\tif row.bound != boundDefensiveReparse {\n858|\t\t\tt.Errorf(\"declared row %s carries an unrecognized bound %q\",\n859|\t\t\t\tdescribeRow(row), row.bound)\n860|\t\t\tcontinue\n861|\t\t}\n862|\t\tif !want[describeRow(row)] {\n863|\t\t\tt.Errorf(\"declared row %s claims a bound outside the pinned set; \"+\n864|\t\t\t\t\"a new defensive arm joins deliberately or not at all\", describeRow(row))\n865|\t\t}\n866|\t}\n867|\tbound := 0\n868|\tfor _, row := range declaredRows() {\n869|\t\tif row.bound != \"\" {\n870|\t\t\tbound++\n871|\t\t}\n872|\t}\n873|\tif bound != len(want) {\n874|\t\tt.Errorf(\"declared %d bound rows, want exactly the pinned %d\", bound, len(want))\n875|\t}\n876|}\n877|\n878|// TestPlatformFunnelDetailsAreExactlyThese derives the error set of\n879|// validatePlatforms from the production AST and requires it to equal the\n880|// funneled set: a fourth platform error widens the funnel this test pins.\n881|func TestPlatformFunnelDetailsAreExactlyThese(t *testing.T) {\n882|\tt.Parallel()\n883|\n884|\tfileSet := token.NewFileSet()\n885|\tfile, err := parser.ParseFile(fileSet, \"terminalbackend.go\", nil, 0)\n886|\tif err != nil {\n887|\t\tt.Fatalf(\"parse terminalbackend.go: %v\", err)\n888|\t}\n889|\tdetails := map[string]bool{}\n890|\tfor _, declaration := range file.Decls {\n891|\t\tfunction, ok := declaration.(*ast.FuncDecl)\n892|\t\tif !ok || function.Name.Name != \"validatePlatforms\" {\n893|\t\t\tcontinue\n894|\t\t}\n895|\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n896|\t\t\tcall, ok := node.(*ast.CallExpr)\n897|\t\t\tif !ok {\n898|\t\t\t\treturn true\n899|\t\t\t}\n900|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n901|\t\t\tif !ok || selector.Sel.Name != \"New\" {\n902|\t\t\t\treturn true\n903|\t\t\t}\n904|\t\t\treceiver, ok := selector.X.(*ast.Ident)\n905|\t\t\tif !ok || receiver.Name != \"errors\" || len(call.Args) != 1 {\n906|\t\t\t\treturn true\n907|\t\t\t}\n908|\t\t\tliteral, ok := call.Args[0].(*ast.BasicLit)\n909|\t\t\tif !ok || literal.Kind != token.STRING {\n910|\t\t\t\tt.Fatalf(\"validatePlatforms error is not a static literal\")\n911|\t\t\t\treturn true\n912|\t\t\t}\n913|\t\t\tdetail, err := strconv.Unquote(literal.Value)\n914|\t\t\tif err != nil {\n915|\t\t\t\tt.Fatalf(\"unquote platform error: %v\", err)\n916|\t\t\t}\n917|\t\t\tdetails[detail] = true\n918|\t\t\treturn true\n919|\t\t})\n920|\t}\n921|\tif len(details) == 0 {\n922|\t\tt.Fatal(\"derived zero platform errors; the scanner is broken, not the package\")\n923|\t}\n924|\tfor _, want := range funneledPlatformDetails {\n925|\t\tif !details[want] {\n926|\t\t\tt.Errorf(\"funneled detail %q no longer derives from validatePlatforms\", want)\n927|\t\t}\n928|\t}\n929|\tfor detail := range details {\n930|\t\tknown := false\n931|\t\tfor _, want := range funneledPlatformDetails {\n932|\t\t\tif detail == want {\n933|\t\t\t\tknown = true\n934|\t\t\t}\n935|\t\t}\n936|\t\tif !known {\n937|\t\t\tt.Errorf(\"validatePlatforms derives %q, outside the funneled set; \"+\n938|\t\t\t\t\"a fourth platform error widens the funnel\", detail)\n939|\t\t}\n940|\t}\n941|}\n942|\n943|// TestPlainErrorsLiveOnlyInTheirTwoFunctions closes the smuggling hole:\n944|// a non-wire error constructed anywhere but validatePlatforms (the\n945|// pinned funnel) or DigestFile (I/O) fails, so a refusal wearing a plain\n946|// error's clothes cannot ship unwitnessed.\n947|func TestPlainErrorsLiveOnlyInTheirTwoFunctions(t *testing.T) {\n948|\tt.Parallel()\n949|\n950|\tmatches, err := filepath.Glob(\"*.go\")\n951|\tif err != nil {\n952|\t\tt.Fatalf(\"glob production files: %v\", err)\n953|\t}\n954|\tfor _, name := range matches {\n955|\t\tif strings.HasSuffix(name, \"_test.go\") {\n956|\t\t\tcontinue\n957|\t\t}\n958|\t\tfileSet := token.NewFileSet()\n959|\t\tfile, err := parser.ParseFile(fileSet, name, nil, 0)\n960|\t\tif err != nil {\n961|\t\t\tt.Fatalf(\"parse %s: %v\", name, err)\n962|\t\t}\n963|\t\tfor _, declaration := range file.Decls {\n964|\t\t\tfunction, ok := declaration.(*ast.FuncDecl)\n965|\t\t\tif !ok || function.Body == nil {\n966|\t\t\t\tcontinue\n967|\t\t\t}\n968|\t\t\tfunctionName := function.Name.Name\n969|\t\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n970|\t\t\t\tcall, ok := node.(*ast.CallExpr)\n971|\t\t\t\tif !ok {\n972|\t\t\t\t\treturn true\n973|\t\t\t\t}\n974|\t\t\t\tplain := false\n975|\t\t\t\tif selector, ok := call.Fun.(*ast.SelectorExpr); ok {\n976|\t\t\t\t\tif receiver, ok := selector.X.(*ast.Ident); ok {\n977|\t\t\t\t\t\tif receiver.Name == \"errors\" && selector.Sel.Name == \"New\" {\n978|\t\t\t\t\t\t\tplain = true\n979|\t\t\t\t\t\t}\n980|\t\t\t\t\t\tif receiver.Name == \"fmt\" && strings.HasPrefix(selector.Sel.Name, \"Errorf\") {\n981|\t\t\t\t\t\t\tplain = true\n982|\t\t\t\t\t\t}\n983|\t\t\t\t\t}\n984|\t\t\t\t}\n985|\t\t\t\tif plain && !plainErrorFunctions[functionName] {\n986|\t\t\t\t\tt.Errorf(\"%s constructs a non-wire error in %s, outside the two allowlisted functions; \"+\n987|\t\t\t\t\t\t\"a refusal wearing a plain error's clothes ships unwitnessed\", name, functionName)\n988|\t\t\t\t}\n989|\t\t\t\treturn true\n990|\t\t\t})\n991|\t\t}\n992|\t}\n993|}\n994|\n995|// TestDigestFileRefusalsAreNeverWireErrors pins the allowlist's other\n996|// half behaviorally: DigestFile failures are I/O errors, never *Error,\n997|// so no caller can mistake them for a registry refusal.\n998|func TestDigestFileRefusalsAreNeverWireErrors(t *testing.T) {\n999|\tt.Parallel()\n1000|\n1001|\tfor _, path := range []string{\n1002|\t\tfilepath.Join(\"testdata\", \"no-such-executable\"),\n1003|\t\t\"\",\n1004|\t} {\n1005|\t\t_, err := DigestFile(path)\n1006|\t\tif err == nil {\n1007|\t\t\tt.Errorf(\"DigestFile(%q) = nil, want an I/O error\", path)\n1008|\t\t\tcontinue\n1009|\t\t}\n1010|\t\tvar refusal *Error\n1011|\t\tif errors.As(err, &refusal) {\n1012|\t\t\tt.Errorf(\"DigestFile(%q) error = %v, want a plain I/O error, never a wire refusal\", path, err)\n1013|\t\t}\n1014|\t}\n1015|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
