{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c49b","stream":{"kind":"session","id":"01a070a7-9081-7d73-bd3a-2f4da2eb7b1c"},"sequence":168,"recorded_at":1780531400000331,"record_type":"event","durability":"durable","causation_id":"5d1923f0-6c67-41a3-89b5-230e3cfe396c","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5d1923f0-6c67-41a3-89b5-230e3cfe396c","run_stream":{"kind":"run","id":"5d1923f0-6c67-41a3-89b5-230e3cfe396c"},"call_id":"call_01a070a7edd075d1a343d91ed4e683d9","text":"Read text file `internal/terminalbackend/terminalbackend_test.go`.\n(751 line(s) above)\n752|// TestCheckProviderDescriptor drives the Section 7.A production rule: the\n753|// provider rejects a descriptor that does not match the validated binding.\n754|func TestCheckProviderDescriptor(t *testing.T) {\n755|\tt.Parallel()\n756|\n757|\tbinding := terminalbackend.InstanceBinding{\n758|\t\tBackendID:             \"com.example.term\",\n759|\t\tImplementationVersion: \"1.2.3\",\n760|\t\tProtocolVersion:       \"1.0.0\",\n761|\t\tGeneration:            \"generation-1\",\n762|\t\tTerminalBindingID:     testDigest,\n763|\t}\n764|\tif err := terminalbackend.CheckProviderDescriptor(binding, binding); err != nil {\n765|\t\tt.Errorf(\"CheckProviderDescriptor(match) error = %v, want admission\", err)\n766|\t}\n767|\n768|\tversionDrift := binding\n769|\tversionDrift.ImplementationVersion = \"1.2.4\"\n770|\tif err := terminalbackend.CheckProviderDescriptor(versionDrift, binding); !terminalbackend.IsDrift(err) {\n771|\t\tt.Errorf(\"CheckProviderDescriptor(version drift) error = %v, want terminal_backend_implementation_drift\", err)\n772|\t}\n773|\tprotoDrift := binding\n774|\tprotoDrift.ProtocolVersion = \"1.1.0\"\n775|\tif err := terminalbackend.CheckProviderDescriptor(protoDrift, binding); !terminalbackend.IsDrift(err) {\n776|\t\tt.Errorf(\"CheckProviderDescriptor(protocol drift) error = %v, want terminal_backend_implementation_drift\", err)\n777|\t}\n778|\tidMismatch := binding\n779|\tidMismatch.BackendID = \"com.example.other\"\n780|\tif err := terminalbackend.CheckProviderDescriptor(idMismatch, binding); !terminalbackend.IsNotFound(err) {\n781|\t\tt.Errorf(\"CheckProviderDescriptor(ID mismatch) error = %v, want terminal_backend_not_found\", err)\n782|\t}\n783|\t// The stale-generation arm lives in TestCheckProviderDescriptorGenerationMismatch.\n784|}\n785|\n786|// TestCheckProviderDescriptorGenerationBounds proves the Section 7.A\n787|// string[1..256] bound itself, not the generation mismatch: every refusal\n788|// case carries the SAME generation on both sides, so the mismatch comparison\n789|// cannot fire and only the bound can refuse. (Pitting a mutated generation\n790|// against a fixed one proves nothing about the bound — the inequality alone\n791|// returns terminal_backend_stale_generation.)\n792|func TestCheckProviderDescriptorGenerationBounds(t *testing.T) {\n793|\tt.Parallel()\n794|\n795|\twithGeneration := func(generation string) terminalbackend.InstanceBinding {\n796|\t\treturn terminalbackend.InstanceBinding{\n797|\t\t\tBackendID:             \"com.example.term\",\n798|\t\t\tImplementationVersion: \"1.2.3\",\n799|\t\t\tProtocolVersion:       \"1.0.0\",\n800|\t\t\tGeneration:            generation,\n801|\t\t\tTerminalBindingID:     testDigest,\n802|\t\t}\n803|\t}\n804|\t// string[1..256] bounds UTF-8 characters (SPEC.md:321), so the boundary\n805|\t// is proved twice: once in ASCII bytes where bytes and runes coincide,\n806|\t// once in two-byte runes where they do not.\n807|\tadmitted := []struct {\n808|\t\tname       string\n809|\t\tgeneration string\n810|\t}{\n811|\t\t{\"one byte\", \"g\"},\n812|\t\t{\"256 bytes\", strings.Repeat(\"g\", 256)},\n813|\t\t{\"256 two-byte runes\", strings.Repeat(\"é\", 256)},\n814|\t}\n815|\tfor _, testCase := range admitted {\n816|\t\tt.Run(testCase.name, func(t *testing.T) {\n817|\t\t\tt.Parallel()\n818|\t\t\tbinding := withGeneration(testCase.generation)\n819|\t\t\tif err := terminalbackend.CheckProviderDescriptor(binding, binding); err != nil {\n820|\t\t\t\tt.Errorf(\"CheckProviderDescriptor(%q generation, equal) error = %v, want admission\",\n821|\t\t\t\t\ttestCase.name, err)\n822|\t\t\t}\n823|\t\t})\n824|\t}\n825|\trefused := []struct {\n826|\t\tname       string\n827|\t\tgeneration string\n828|\t}{\n829|\t\t{\"empty\", \"\"},\n830|\t\t{\"257 bytes\", strings.Repeat(\"g\", 257)},\n831|\t\t{\"257 two-byte runes\", strings.Repeat(\"é\", 257)},\n832|\t}\n833|\tfor _, testCase := range refused {\n834|\t\tt.Run(testCase.name, func(t *testing.T) {\n835|\t\t\tt.Parallel()\n836|\t\t\tbinding := withGeneration(testCase.generation)\n837|\t\t\terr := terminalbackend.CheckProviderDescriptor(binding, binding)\n838|\t\t\tif !terminalbackend.IsStaleGeneration(err) {\n839|\t\t\t\tt.Errorf(\"CheckProviderDescriptor(%q generation, equal) error = %v, want terminal_backend_stale_generation\",\n840|\t\t\t\t\ttestCase.name, err)\n841|\t\t\t}\n842|\t\t\tif got := refusalDetail(t, err); got != \"backend_generation bound\" {\n843|\t\t\t\tt.Errorf(\"refusal detail = %q, want %q\", got, \"backend_generation bound\")\n844|\t\t\t}\n845|\t\t})\n846|\t}\n847|}\n848|\n849|// TestCheckProviderDescriptorGenerationMismatch keeps the mismatch arm pinned\n850|// separately: differing valid generations refuse even though each side is\n851|// within the bound.\n852|func TestCheckProviderDescriptorGenerationMismatch(t *testing.T) {\n853|\tt.Parallel()\n854|\n855|\tbinding := terminalbackend.InstanceBinding{\n856|\t\tBackendID:             \"com.example.term\",\n857|\t\tImplementationVersion: \"1.2.3\",\n858|\t\tProtocolVersion:       \"1.0.0\",\n859|\t\tGeneration:            \"generation-1\",\n860|\t\tTerminalBindingID:     testDigest,\n861|\t}\n862|\tstale := binding\n863|\tstale.Generation = \"generation-2\"\n864|\tif err := terminalbackend.CheckProviderDescriptor(stale, binding); !terminalbackend.IsStaleGeneration(err) {\n865|\t\tt.Errorf(\"CheckProviderDescriptor(stale generation) error = %v, want terminal_backend_stale_generation\", err)\n866|\t}\n867|}\n868|\n869|// TestCheckProviderDescriptorBindingDigestMismatch proves the fourth §7.A\n870|// match dimension: a descriptor whose terminal_binding_id is malformed or\n871|// differs from the AX-validated host-local binding is refused with the\n872|// descriptor binding digest arm, even when ID, versions, and generation all\n873|// match. Both arms share the clause; the shape case and the mismatch case\n874|// below hit arm #1 and arm #2 respectively.\n875|func TestCheckProviderDescriptorBindingDigestMismatch(t *testing.T) {\n876|\tt.Parallel()\n877|\n878|\tbinding := terminalbackend.InstanceBinding{\n879|\t\tBackendID:             \"com.example.term\",\n880|\t\tImplementationVersion: \"1.2.3\",\n881|\t\tProtocolVersion:       \"1.0.0\",\n882|\t\tGeneration:            \"generation-1\",\n883|\t\tTerminalBindingID:     testDigest,\n884|\t}\n885|\tcases := []struct {\n886|\t\tname      string\n887|\t\tbindingID string\n888|\t}{\n889|\t\t{\"malformed digest\", \"not-a-digest\"},\n890|\t\t{\"empty digest\", \"\"},\n891|\t\t{\"foreign binding digest\", testDigestOther},\n892|\t}\n893|\tfor _, testCase := range cases {\n894|\t\tt.Run(testCase.name, func(t *testing.T) {\n895|\t\t\tt.Parallel()\n896|\t\t\tdescriptor := binding\n897|\t\t\tdescriptor.TerminalBindingID = testCase.bindingID\n898|\t\t\terr := terminalbackend.CheckProviderDescriptor(descriptor, binding)\n899|\t\t\tif !terminalbackend.IsNotFound(err) {\n900|\t\t\t\tt.Errorf(\"CheckProviderDescriptor(%s) error = %v, want terminal_backend_not_found\", testCase.name, err)\n901|\t\t\t}\n902|\t\t\tif got := refusalDetail(t, err); got != \"descriptor binding digest\" {\n903|\t\t\t\tt.Errorf(\"refusal detail = %q, want %q\", got, \"descriptor binding digest\")\n904|\t\t\t}\n905|\t\t})\n906|\t}\n907|}\n908|\n909|// TestDigestFile binds trust to bytes: the digest of a real file verifies,\n910|// symlinks resolve to their target, and non-files or missing paths fail\n911|// without producing a digest.\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
