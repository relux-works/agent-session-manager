{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c491","stream":{"kind":"session","id":"01a070a7-9081-7d73-bd3a-2f4da2eb7b1c"},"sequence":163,"recorded_at":1780531400000321,"record_type":"event","durability":"durable","causation_id":"5d1923f0-6c67-41a3-89b5-230e3cfe396c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5d1923f0-6c67-41a3-89b5-230e3cfe396c","run_stream":{"kind":"run","id":"5d1923f0-6c67-41a3-89b5-230e3cfe396c"},"task_stream":{"kind":"task","id":"5a2cf780-8cc6-420f-9d11-8b773ec7579c"},"task_id":"5a2cf780-8cc6-420f-9d11-8b773ec7579c","event":{"kind":"output","task_id":"5a2cf780-8cc6-420f-9d11-8b773ec7579c","chunk":"Read text file `internal/terminalbackend/terminalbackend.go`.\n(559 line(s) above)\n560|// Instance Binding 1.0.0 carried as terminal_binding_id (SPEC.md:3461).\n561|type InstanceBinding struct {\n562|\tBackendID             string\n563|\tImplementationVersion string\n564|\tProtocolVersion       string\n565|\tGeneration            string\n566|\tTerminalBindingID     string\n567|}\n568|\n569|// CheckProviderDescriptor enforces the Section 7.A rule: the provider rejects\n570|// a descriptor whose binding digest, backend ID, versions, or generation does\n571|// not match the AX-validated host-local binding before launching or observing\n572|// a provider process. Generation lengths 0 and over 256 UTF-8 characters are\n573|// invalid; 256 is accepted.\n574|func CheckProviderDescriptor(descriptor, binding InstanceBinding) error {\n575|\tif err := checkGeneration(descriptor.Generation); err != nil {\n576|\t\treturn err\n577|\t}\n578|\tif err := checkGeneration(binding.Generation); err != nil {\n579|\t\treturn err\n580|\t}\n581|\tif _, err := ParseID(descriptor.BackendID); err != nil {\n582|\t\treturn err\n583|\t}\n584|\tif descriptor.BackendID != binding.BackendID {\n585|\t\treturn &Error{Code: CodeNotFound, BackendID: descriptor.BackendID, Detail: \"descriptor backend binding\"}\n586|\t}\n587|\tif _, err := scalar.ParseDigest(descriptor.TerminalBindingID); err != nil {\n588|\t\treturn &Error{Code: CodeNotFound, BackendID: descriptor.BackendID, Detail: \"descriptor binding digest\"}\n589|\t}\n590|\tif descriptor.TerminalBindingID != binding.TerminalBindingID {\n591|\t\treturn &Error{Code: CodeNotFound, BackendID: descriptor.BackendID, Detail: \"descriptor binding digest\"}\n592|\t}\n593|\tif descriptor.ImplementationVersion != binding.ImplementationVersion ||\n594|\t\tdescriptor.ProtocolVersion != binding.ProtocolVersion {\n595|\t\treturn &Error{Code: CodeDrift, BackendID: descriptor.BackendID, Detail: \"descriptor version binding\"}\n596|\t}\n597|\tif descriptor.Generation != binding.Generation {\n598|\t\treturn &Error{Code: CodeStaleGeneration, BackendID: descriptor.BackendID, Detail: \"descriptor generation binding\"}\n599|\t}\n600|\treturn nil\n601|}\n602|\n603|// checkGeneration enforces string[1..256] measured in UTF-8 characters over\n604|// valid UTF-8 (SPEC.md:321).\n605|func checkGeneration(generation string) error {\n606|\tif !utf8.ValidString(generation) || utf8.RuneCountInString(generation) < 1 || utf8.RuneCountInString(generation) > maxGenerationRunes {\n607|\t\treturn &Error{Code: CodeStaleGeneration, Detail: \"backend_generation bound\"}\n608|\t}\n609|\treturn nil\n610|}\n611|\n612|// DigestFile returns the sha256: digest of the executable at path after\n613|// resolving symlinks. The target must be a regular file; anything else (or a\n614|// read failure) is an error, never a digest. It distinguishes a failed read\n615|// from an absent trust entry: callers must not fall back to PATH discovery.\n616|func DigestFile(path string) (string, error) {\n617|\tresolved, err := filepath.EvalSymlinks(path)\n618|\tif err != nil {\n619|\t\treturn \"\", fmt.Errorf(\"terminal backend executable: %w\", err)\n(more lines below)"}}}
