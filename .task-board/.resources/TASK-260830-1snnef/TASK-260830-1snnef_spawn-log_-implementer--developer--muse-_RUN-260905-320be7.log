nated JSON string\\\")\\n\\tstringComplete:\\n\\t}\\n\\treturn nil\\n}\\n\\nfunc readUTF16Escape(input []byte, start int) (uint16, int, error) {\\n\\tif start < 0 || start+6 > len(input) || input[start] != '\\\\\\\\' || input[start+1] != 'u' {\\n===\\ninternal/terminalbackend/refusal_arm_inventory_test.go:700:\\t{\\\"terminalbackend.go\\\", \\\"CheckProviderDescriptor\\\", \\\"CodeDrift\\\", \\\"descriptor version binding\\\", 1, \\\"CheckProviderDescriptor\\\", \\\"\\\", nil, []refusalTestRef{{file: \\\"terminalbackend_test.go\\\", test: \\\"TestCheckProviderDescriptor\\\"}}},\\ninternal/terminalbackend/refusal_arm_inventory_test.go:701:\\t{\\\"terminalbackend.go\\\", \\\"CheckProviderDescriptor\\\", \\\"CodeNotFound\\\", \\\"descriptor backend binding\\\", 1, \\\"CheckProviderDescriptor\\\", \\\"\\\", nil, []refusalTestRef{{file: \\\"terminalbackend_test.go\\\", test: \\\"TestCheckProviderDescriptor\\\"}}},\\ninternal/terminalbackend/refusal_arm_inventory_test.go:702:\\t{\\\"terminalbackend.go\\\", \\\"CheckProviderDescriptor\\\", \\\"CodeStaleGeneration\\\", \\\"descriptor generation binding\\\", 1, \\\"CheckProviderDescriptor\\\", \\\"\\\", nil, []refusalTestRef{{file: \\\"terminalbackend_test.go\\\", test: \\\"TestCheckProviderDescriptorGenerationMismatch\\\"}}},\\ninternal/terminalbackend/refusal_arm_inventory_test.go:728:\\t{\\\"terminalbackend.go\\\", \\\"checkGeneration\\\", \\\"CodeStaleGeneration\\\", \\\"backend_generation bound\\\", 1, \\\"CheckProviderDescriptor\\\", \\\"\\\", nil, []refusalTestRef{{file: \\\"terminalbackend_test.go\\\", test: \\\"TestCheckProviderDescriptorGenerationBounds\\\"}}},\\ninternal/terminalbackend/terminalbackend_test.go:752:// TestCheckProviderDescriptor drives the Section 7.A production rule: the\\ninternal/terminalbackend/terminalbackend_test.go:754:func TestCheckProviderDescriptor(t *testing.T) {\\ninternal/terminalbackend/terminalbackend_test.go:757:\\tbinding := terminalbackend.InstanceBinding{\\ninternal/terminalbacke