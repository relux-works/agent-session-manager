 err, codeStaleGeneration, \"backend_generation bound\")\n+\t}\n+\tfor _, raw := range []string{strings.Repeat(\"g\", 256), strings.Repeat(\"é\", 256)} {\n+\t\tif _, err := terminalbackend.GenerationDigest(raw); err != nil {\n+\t\t\tt.Errorf(\"GenerationDigest(%d runes) error = %v, want admission\", len([]rune(raw)), err)\n+\t\t}\n+\t}\n+}\n","edit_facts":{"tool_name":"edit_file","path":"internal/terminalbackend/manifest_test.go","added":19,"removed":14},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
