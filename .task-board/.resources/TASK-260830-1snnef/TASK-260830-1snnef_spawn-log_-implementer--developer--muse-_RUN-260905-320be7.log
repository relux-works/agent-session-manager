t\t\t\tif !ok {\n-\t\t\t\t\treturn mismatchf(\"document surrogate escape\")\n-\t\t\t\t}\n-\t\t\t\tindex = end - 1\n-\t\t\t\tswitch {\n-\t\t\t\tcase unit >= 0xd800 && unit <= 0xdbff:\n-\t\t\t\t\tsecond, secondEnd, ok := readUTF16EscapeUnit(raw, end)\n-\t\t\t\t\tif !ok || second < 0xdc00 || second > 0xdfff {\n-\t\t\t\t\t\treturn mismatchf(\"document surrogate escape\")\n-\t\t\t\t\t}\n-\t\t\t\t\tindex = secondEnd - 1\n-\t\t\t\tcase unit >= 0xdc00 && unit <= 0xdfff:\n-\t\t\t\t\treturn mismatchf(\"document surrogate escape\")\n-\t\t\t\t}\n-\t\t\tcase 0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,\n-\t\t\t\t0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,\n-\t\t\t\t0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,\n-\t\t\t\t0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f:\n-\t\t\t\treturn mismatchf(\"document surrogate escape\")\n-\t\t\t}\n-\t\t}\n-\t\treturn mismatchf(\"document surrogate escape\")\n-\tstringComplete:\n-\t}\n-\treturn nil\n-}\n+// hasLoneSurrogateEscape reports whether raw JSON carries a lone surrogate\n+// code point escape inside any string literal. It answers only the surrogate\n+// question: malformed escapes, unescaped control characters, and unterminated\n+// strings are left for the decoder's syntax arm, which refuses them with its\n+// own detail. The scan mirrors internal/canonicaljson\n+// validateSurrogateEscapes without importing it: canonicaljson is\n+// byte-identical across stories and must not be edited at integration, so\n+// the two copies are pinned equal by\n+// TestSurrogateGateAgreesWithCanonicalJSON instead of shared.\n+func hasLoneSurrogateEscape(raw []byte) bool {\n+\tfor index := 0; index < len(raw); index++ {\n+\t\tif raw[index] != '\"' {\n+\t\t\tcontinue\n+\t\t}\n+\t\tfor index++; index < len(raw); index++ {\n+\t\t\tswitch raw[index] {\n+\t\t\tcase '\"':\n+\t\t\t\tgoto stringComplete\n+\t\t\tcase '\\\\':\n+\t\t\t\tindex++\n+\t\t\t\tif index >= len(raw) {\n+\t\t\t\t\treturn false\n+\t\t\t\t}\n+\t\t\t\tif raw[index] != 'u' {\n+\t\t