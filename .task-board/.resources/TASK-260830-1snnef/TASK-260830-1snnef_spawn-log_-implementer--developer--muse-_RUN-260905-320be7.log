{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c587","stream":{"kind":"session","id":"01a07060-3ba0-76b0-a9bc-e69817f2ed3c"},"sequence":286,"recorded_at":1780531400000567,"record_type":"event","durability":"durable","causation_id":"0593c7a9-44fe-4750-9d96-383be578e087","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0593c7a9-44fe-4750-9d96-383be578e087","run_stream":{"kind":"run","id":"0593c7a9-44fe-4750-9d96-383be578e087"},"task_stream":{"kind":"task","id":"7766bd29-ac73-4cb6-8cd8-8540bfc49707"},"task_id":"7766bd29-ac73-4cb6-8cd8-8540bfc49707","event":{"kind":"output","task_id":"7766bd29-ac73-4cb6-8cd8-8540bfc49707","chunk":"{\n  \"chunk_id\": \"exec-11-1\",\n  \"command\": \"grep -n \\\"InstanceBinding{\\\" internal/terminalbackend/*_test.go; echo ===; sed -n '430,470p' internal/terminalbackend/manifest_test.go; echo ===; grep -n \\\"os_version\\\" internal/terminalbackend/manifest_test.go | head -20; echo ===; sed -n '222,260p' internal/canonicaljson/canonical.go\",\n  \"description\": \"Find binding constructions, osversion fixtures, Canonicalize entry\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"internal/terminalbackend/terminalbackend_test.go:757:\\tbinding := terminalbackend.InstanceBinding{\\ninternal/terminalbackend/terminalbackend_test.go:795:\\t\\treturn terminalbackend.InstanceBinding{\\ninternal/terminalbackend/terminalbackend_test.go:845:\\tbinding := terminalbackend.InstanceBinding{\\ninternal/terminalbackend/terminalbackend_test.go:942:\\t\\t\\tbinding := terminalbackend.InstanceBinding{BackendID: \\\"com.example.term\\\", ImplementationVersion: \\\"1.2.3\\\", ProtocolVersion: \\\"1.0.0\\\", Generation: \\\"a\\\"}\\n===\\n\\t}\\n}\\n\\n// TestGenerationDigestGolden pins the domain-separated recipe: SHA-256 over\\n// UTF-8 \\\"ax-terminal-backend-generation-v1\\\" + NUL + raw generation bytes.\\n// The expected value was computed with an independent SHA-256 oracle, so a\\n// separator change fails here rather than hiding behind agreement.\\nfunc TestGenerationDigestGolden(t *testing.T) {\\n\\tt.Parallel()\\n\\n\\tdigest, err := terminalbackend.GenerationDigest(\\\"generation-alpha\\\")\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"GenerationDigest() error = %v\\\", err)\\n\\t}\\n\\tconst want = \\\"sha256:ad089bdcf1a41853068645fec63a0ec8e40b95c3e3a103bc326a70e8c479eab7\\\"\\n\\tif digest != want {\\n\\t\\tt.Errorf(\\\"GenerationDigest() = %q, want %q\\\", digest, want)\\n\\t}\\n}\\n\\n// TestGenerationDigestBounds proves the raw generation domain fails closed:\\n// empty (which would make every backend share one digest), over-long, and\\n// invalid UTF-8 derive nothing.\\nfunc TestGenerationDigestBounds(t *testing.T) {\\n\\tt.Parallel()\\n\\n\\tfor _, raw := range []string{\\\"\\\", strings.Repeat(\\\"g\\\", 257), \\\"ok\\\\xffbad\\\", strings.Repeat(\\\"g\\\", 0)} {\\n\\t\\t_, err := terminalbackend.GenerationDigest(raw)\\n\\t\\trequireRefusal(t, err, codeStaleGeneration, \\\"backend_generation bound\\\")\\n\\t}\\n\\tif _, err := terminalbackend.GenerationDigest(strings.Repeat(\\\"g\\\", 256)); err != nil {\\n\\t\\tt.Errorf(\\\"GenerationDigest(256 bytes) error = %v, want admission\\\", err)\\n\\t}\\n}\\n\\n// TestReconcileAdmitsCoherentTuple is the positive admission: static echo,\\n// same-value override, differing override, false claim, and probed addition\\n// reconcile to exactly the true evidenced claims.\\nfunc TestReconcileAdmitsCoherentTuple(t *testing.T) {\\n\\tt.Parallel()\\n\\n===\\n285:\\t\\t\\\"os_version\\\":                \\\"14.5\\\",\\n334:\\t\\t\\\"os_version\\\":                 \\\"14.5\\\",\\n842:\\t\\t\\t\\tobject[\\\"os_version\\\"] = \\\"\\\"\\n1112:\\t\\t\\t\\tobject[\\\"os_version\\\"] = strings.Repeat(\\\"o\\\", 257)\\n1768:\\t\\t\\\"os_version\\\":                \\\"6.8\\\",\\n1790:\\t\\t\\\"os_version\\\":                 \\\"6.8\\\",\\n===\\nfunc Canonicalize(input []byte) ([]byte, error) {\\n\\tvalue, err := decodeStrict(input)\\n\\tif err != nil {\\n\\t\\treturn nil, err\\n\\t}\\n\\t// Re-encode the parsed logical value before the JCS transform. This removes\\n\\t// leading/trailing whitespace around primitive top-level values without\\n\\t// changing json.Number tokens or string data.\\n\\tnormalized, err := json.Marshal(value)\\n\\tif err != nil {\\n\\t\\treturn nil, invalidJSON(\\\"serialize logical JSON value: %v\\\", err)\\n\\t}\\n\\tcanonical, err := jcs.Transform(normalized)\\n\\tif err != nil {\\n\\t\\treturn nil, invalidJSON(\\\"canonicalize RFC 8785 value: %v\\\", err)\\n\\t}\\n\\treturn canonical, nil\\n}\\n\\n// CalculateObjectIdentity validates the AX common logical number model,\\n// resolves the one self field from the object's trusted schema/version\\n// contract, omits that field, applies RFC 8785 JCS, and returns the SHA-256\\n// identity. Callers cannot select an arbitrary field to omit, which prevents\\n// self inclusion and digest cycles.\\n//\\n// This is where the AX safe-integer refusal lives, not in Canonicalize: a\\n// literal at or beyond 2^53, or any floating-point literal, is refused here\\n// with ErrInvalidIdentity before canonical bytes are produced. See the DIVISION\\n// OF GUARANTEES note on Canonicalize.\\nfunc CalculateObjectIdentity(input []byte) (scalar.Digest, SelfField, error) {\\n\\tobject, selfField, _, err := prepareObjectIdentity(input)\\n\\tif err != nil {\\n\\t\\treturn scalar.Digest{}, \\\"\\\", err\\n\\t}\\n\\treturn calculatePreparedObjectIdentity(object, selfField)\\n}\\n\\nfunc prepareObjectIdentity(input []byte) (map[string]any, SelfField, scalar.Digest, error) {\\n\\tif len(input) > 5_242_880 {\\n\",\n  \"original_output_bytes\": 3961,\n  \"original_output_tokens\": 991,\n  \"truncated\": false\n}"}}}
