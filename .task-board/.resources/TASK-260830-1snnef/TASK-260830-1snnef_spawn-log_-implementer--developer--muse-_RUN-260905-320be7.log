{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3df","stream":{"kind":"session","id":"01a07060-3ba0-76b0-a9bc-e69817f2ed3c"},"sequence":74,"recorded_at":1780531400000143,"record_type":"event","durability":"durable","causation_id":"0593c7a9-44fe-4750-9d96-383be578e087","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0593c7a9-44fe-4750-9d96-383be578e087","run_stream":{"kind":"run","id":"0593c7a9-44fe-4750-9d96-383be578e087"},"task_stream":{"kind":"task","id":"cf21450c-bd4e-42a6-b43a-3c270b09d2fb"},"task_id":"cf21450c-bd4e-42a6-b43a-3c270b09d2fb","event":{"kind":"output","task_id":"cf21450c-bd4e-42a6-b43a-3c270b09d2fb","chunk":"Read text file `internal/terminalbackend/manifest.go`.\n(259 line(s) above)\n260|)\n261|\n262|// mismatchf refuses with CodeMismatch and a static detail clause. The clause\n263|// must never interpolate local data: paths, digests, generations, and\n264|// document bytes stay out of errors.\n265|func mismatchf(format string, arguments ...any) *Error {\n266|\treturn &Error{Code: CodeMismatch, Detail: fmt.Sprintf(format, arguments...)}\n267|}\n268|\n269|// decodeStrictObject decodes one JSON object with duplicate-key refusal,\n270|// invalid-UTF-8 refusal, a nesting cap, and trailing-data refusal. Numbers\n271|// decode as json.Number so member validators can refuse them explicitly:\n272|// none of the three closed schemas has a numeric member.\n273|func decodeStrictObject(raw []byte) (map[string]any, error) {\n274|\tif !utf8.Valid(raw) {\n275|\t\treturn nil, mismatchf(\"document encoding\")\n276|\t}\n277|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n278|\tdecoder.UseNumber()\n279|\tvalue, err := decodeCappedValue(decoder, 0)\n280|\tif err != nil {\n281|\t\treturn nil, err\n282|\t}\n283|\tif decoder.More() {\n284|\t\treturn nil, mismatchf(\"document trailing data\")\n285|\t}\n286|\tobject, ok := value.(map[string]any)\n287|\tif !ok {\n288|\t\treturn nil, mismatchf(\"document shape\")\n289|\t}\n290|\treturn object, nil\n291|}\n292|\n293|// decodeCappedValue decodes one JSON value with an explicit depth bound. The\n294|// bound is far above the deepest legitimate nesting (object, claims array,\n295|// claim object, member array) and fails closed below any decoder-stack risk.\n296|func decodeCappedValue(decoder *json.Decoder, depth int) (any, error) {\n297|\tif depth > maxJSONDepth {\n298|\t\treturn nil, mismatchf(\"document nesting\")\n299|\t}\n300|\ttoken, err := decoder.Token()\n301|\tif err != nil {\n302|\t\treturn nil, mismatchf(\"document syntax\")\n303|\t}\n304|\tif delimiter, ok := token.(json.Delim); ok {\n305|\t\tswitch delimiter {\n306|\t\tcase '{':\n307|\t\t\tobject := make(map[string]any)\n308|\t\t\tfor decoder.More() {\n309|\t\t\t\tkeyToken, err := decoder.Token()\n310|\t\t\t\tif err != nil {\n311|\t\t\t\t\treturn nil, mismatchf(\"document syntax\")\n312|\t\t\t\t}\n313|\t\t\t\tkey, ok := keyToken.(string)\n314|\t\t\t\tif !ok {\n315|\t\t\t\t\treturn nil, mismatchf(\"document syntax\")\n316|\t\t\t\t}\n317|\t\t\t\tif _, duplicate := object[key]; duplicate {\n318|\t\t\t\t\treturn nil, mismatchf(\"document duplicate member\")\n319|\t\t\t\t}\n320|\t\t\t\tmember, err := decodeCappedValue(decoder, depth+1)\n321|\t\t\t\tif err != nil {\n322|\t\t\t\t\treturn nil, err\n323|\t\t\t\t}\n324|\t\t\t\tobject[key] = member\n325|\t\t\t}\n326|\t\t\tif _, err := decoder.Token(); err != nil {\n327|\t\t\t\treturn nil, mismatchf(\"document syntax\")\n328|\t\t\t}\n329|\t\t\treturn object, nil\n330|\t\tcase '[':\n331|\t\t\t// Non-nil initialization: an empty wire array must round-trip\n332|\t\t\t// as [] rather than null, or identity recomputation over an\n333|\t\t\t// empty claim or evidence list diverges from the signer.\n334|\t\t\tarray := []any{}\n335|\t\t\tfor decoder.More() {\n336|\t\t\t\tmember, err := decodeCappedValue(decoder, depth+1)\n337|\t\t\t\tif err != nil {\n338|\t\t\t\t\treturn nil, err\n339|\t\t\t\t}\n340|\t\t\t\tarray = append(array, member)\n341|\t\t\t}\n342|\t\t\tif _, err := decoder.Token(); err != nil {\n343|\t\t\t\treturn nil, mismatchf(\"document syntax\")\n344|\t\t\t}\n345|\t\t\treturn array, nil\n346|\t\tdefault:\n347|\t\t\treturn nil, mismatchf(\"document syntax\")\n348|\t\t}\n349|\t}\n350|\treturn token, nil\n351|}\n352|\n353|// checkExactMembers refuses any deviation from the closed member set: an\n354|// unknown member and a missing member are both malformed.\n355|func checkExactMembers(object map[string]any, members []string) error {\n356|\tif len(object) != len(members) {\n357|\t\treturn mismatchf(\"document members\")\n358|\t}\n359|\tfor _, member := range members {\n360|\t\tif _, known := object[member]; !known {\n361|\t\t\treturn mismatchf(\"document members\")\n362|\t\t}\n363|\t}\n364|\treturn nil\n365|}\n366|\n367|// stringMember extracts a required string member. Numbers, booleans, nulls,\n368|// arrays, and objects are refused: no member of these schemas takes them.\n369|func stringMember(object map[string]any, name string) (string, error) {\n370|\tvalue, ok := object[name].(string)\n371|\tif !ok {\n372|\t\treturn \"\", mismatchf(\"document member type\")\n373|\t}\n374|\treturn value, nil\n375|}\n376|\n377|// boundedStringMember extracts a required string[1..256] measured in bytes\n378|// over valid UTF-8, the canonical bound in every containing contract.\n379|func boundedStringMember(object map[string]any, name string) (string, error) {\n380|\tvalue, err := stringMember(object, name)\n381|\tif err != nil {\n382|\t\treturn \"\", err\n383|\t}\n384|\tif !utf8.ValidString(value) || len(value) < 1 || len(value) > maxOpaqueString {\n385|\t\treturn \"\", mismatchf(\"document string bound\")\n386|\t}\n387|\treturn value, nil\n388|}\n389|\n390|// digestMember extracts a required sha256: digest member.\n391|func digestMember(object map[string]any, name string) (string, error) {\n392|\tvalue, err := stringMember(object, name)\n393|\tif err != nil {\n394|\t\treturn \"\", err\n395|\t}\n396|\tif _, err := scalar.ParseDigest(value); err != nil {\n397|\t\treturn \"\", mismatchf(\"document digest\")\n398|\t}\n399|\treturn value, nil\n(more lines below)"}}}
