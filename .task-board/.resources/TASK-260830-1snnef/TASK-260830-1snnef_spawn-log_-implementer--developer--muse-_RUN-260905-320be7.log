{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c725","stream":{"kind":"session","id":"01a07060-3ba0-76b0-a9bc-e69817f2ed3c"},"sequence":493,"recorded_at":1780531400000981,"record_type":"event","durability":"durable","causation_id":"0593c7a9-44fe-4750-9d96-383be578e087","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0593c7a9-44fe-4750-9d96-383be578e087","run_stream":{"kind":"run","id":"0593c7a9-44fe-4750-9d96-383be578e087"},"task_stream":{"kind":"task","id":"9479997a-023b-4f25-80e8-8f5569344fbb"},"task_id":"9479997a-023b-4f25-80e8-8f5569344fbb","event":{"kind":"output","task_id":"9479997a-023b-4f25-80e8-8f5569344fbb","chunk":"edited\nchanged lines: lines 269-276\n--- original\n+++ updated\n@@\n-// decodeStrictObject decodes one JSON object with duplicate-key refusal,\n-// invalid-UTF-8 refusal, a nesting cap, and trailing-data refusal. Numbers\n-// decode as json.Number so member validators can refuse them explicitly:\n-// none of the three closed schemas has a numeric member.\n-func decodeStrictObject(raw []byte) (map[string]any, error) {\n-\tif !utf8.Valid(raw) {\n-\t\treturn nil, mismatchf(\"document encoding\")\n-\t}\n+// rejectSurrogateEscapes refuses raw JSON carrying a lone surrogate code\n+// point escape before any canonicalization (SPEC.md:289: decoders MUST\n+// reject lone surrogate code points before canonicalization). Go's\n+// encoding/json silently replaces a lone \\ud800 with U+FFFD, so the decode\n+// below cannot see the violation; the scan must run on the raw bytes first.\n+// The scan mirrors internal/canonicaljson validateSurrogateEscapes without\n+// importing it: canonicaljson is byte-identical across stories and must not\n+// be edited at integration, so the two copies are pinned equal by\n+// TestSurrogateGateAgreesWithCanonicalJSON instead of shared.\n+func rejectSurrogateEscapes(raw []byte) error {\n+\tfor index := 0; index < len(raw); index++ {\n+\t\tif raw[index] != '\"' {\n+\t\t\tcontinue\n+\t\t}\n+\t\tfor index++; index < len(raw); index++ {\n+\t\t\tswitch raw[index] {\n+\t\t\tcase '\"':\n+\t\t\t\tgoto stringComplete\n+\t\t\tcase '\\\\':\n+\t\t\t\tindex++\n+\t\t\t\tif index >= len(raw) {\n+\t\t\t\t\treturn mismatchf(\"document surrogate escape\")\n+\t\t\t\t}\n+\t\t\t\tif raw[index] != 'u' {\n+\t\t\t\t\tcontinue\n+\t\t\t\t}\n+\t\t\t\tunit, end, ok := readUTF16EscapeUnit(raw, index-1)\n+\t\t\t\tif !ok {\n+\t\t\t\t\treturn mismatchf(\"document surrogate escape\")\n+\t\t\t\t}\n+\t\t\t\tindex = end - 1\n+\t\t\t\tswitch {\n+\t\t\t\tcase unit >= 0xd800 && unit <= 0xdbff:\n+\t\t\t\t\tsecond, secondEnd, ok := readUTF16EscapeUnit(raw, end)\n+\t\t\t\t\tif !ok || second < 0xdc00 || second > 0xdfff {\n+\t\t\t\t\t\treturn mismatchf(\"document surrogate escape\")\n+\t\t\t\t\t}\n+\t\t\t\t\tindex = secondEnd - 1\n+\t\t\t\tcase unit >= 0xdc00 && unit <= 0xdfff:\n+\t\t\t\t\treturn mismatchf(\"document surrogate escape\")\n+\t\t\t\t}\n+\t\t\tcase 0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,\n+\t\t\t\t0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,\n+\t\t\t\t0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,\n+\t\t\t\t0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f:\n+\t\t\t\treturn mismatchf(\"document surrogate escape\")\n+\t\t\t}\n+\t\t}\n+\t\treturn mismatchf(\"document surrogate escape\")\n+\tstringComplete:\n+\t}\n+\treturn nil\n+}\n+\n+// readUTF16EscapeUnit reads one \\uXXXX escape at raw[start] (which must be\n+// the backslash). It reports false when the escape is absent or malformed;\n+// malformed escapes are refused by the decoder's syntax arm, so this gate\n+// only needs to stay silent on them rather than diagnose them.\n+func readUTF16EscapeUnit(raw []byte, start int) (uint16, int, bool) {\n+\tif start < 0 || start+6 > len(raw) || raw[start] != '\\\\' || raw[start+1] != 'u' {\n+\t\treturn 0, start, false\n+\t}\n+\tvar unit uint16\n+\tfor _, digit := range raw[start+2 : start+6] {\n+\t\tunit <<= 4\n+\t\tswitch {\n+\t\tcase digit >= '0' && digit <= '9':\n+\t\t\tunit |= uint16(digit - '0')\n+\t\tcase digit >= 'a' && digit <= 'f':\n+\t\t\tunit |= uint16(digit-'a') + 10\n+\t\tcase digit >= 'A' && digit <= 'F':\n+\t\t\tunit |= uint16(digit-'A') + 10\n+\t\tdefault:\n+\t\t\treturn 0, start, false\n+\t\t}\n+\t}\n+\treturn unit, start + 6, true\n+}\n+\n+// decodeStrictObject decodes one JSON object with duplicate-key refusal,\n+// invalid-UTF-8 refusal, lone-surrogate-escape refusal, a nesting cap, and\n+// trailing-data refusal. Numbers\n+// decode as json.Number so member validators can refuse them explicitly:\n+// none of the three closed schemas has a numeric member.\n+func decodeStrictObject(raw []byte) (map[string]any, error) {\n+\tif !utf8.Valid(raw) {\n+\t\treturn nil, mismatchf(\"document encoding\")\n+\t}\n+\tif err := rejectSurrogateEscapes(raw); err != nil {\n+\t\treturn nil, err\n+\t}\n"}}}
