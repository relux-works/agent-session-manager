{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c455","stream":{"kind":"session","id":"01a07060-3ba0-76b0-a9bc-e69817f2ed3c"},"sequence":133,"recorded_at":1780531400000261,"record_type":"event","durability":"durable","causation_id":"0593c7a9-44fe-4750-9d96-383be578e087","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"0593c7a9-44fe-4750-9d96-383be578e087","run_stream":{"kind":"run","id":"0593c7a9-44fe-4750-9d96-383be578e087"},"call_id":"call_01a07060743c7882830b65e4843efd98","text":"Read text file `internal/terminalbackend/terminalbackend.go`.\n1|// Package terminalbackend implements the TerminalBackend registry: canonical\n2|// backend identities, implementation/protocol version tuples, external\n3|// executable trust admission, and duplicate or drift refusal.\n4|//\n5|// Normative scope is relux-works/agent-session-manager-spec@v0.5.0 §4.B\n6|// (registry, identity, discovery, trust), §4.1 (backend interface versions),\n7|// §6.5 (Configuration 3.0.0 TerminalBackend extension), and §7.A (Provider\n8|// Protocol 3.0.0 Terminal Instance binding). Manifest/Probe schemas,\n9|// capability evidence, and generation-bound admission are defined in\n10|// manifest.go; lifecycle operations and legacy v0.4.3 translation belong to\n11|// the sibling story tasks and are deliberately not defined here.\n12|package terminalbackend\n13|\n14|import (\n15|\t\"crypto/sha256\"\n16|\t\"encoding/hex\"\n17|\t\"errors\"\n18|\t\"fmt\"\n19|\t\"os\"\n20|\t\"path/filepath\"\n21|\t\"regexp\"\n22|\t\"sort\"\n23|\t\"strings\"\n24|\t\"sync\"\n25|\t\"unicode/utf8\"\n26|\n27|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n28|)\n29|\n30|// Wire error codes are the exact Section 15.3 codes the registry may report.\n31|// They are a subset of the pinned catalog error vocabulary; no other code is\n32|// emitted by this package.\n33|const (\n34|\t// CodeNotFound reports an unknown or malformed backend identity. A failed\n35|\t// read is never absence: callers must not treat this as \"no backend\".\n36|\tCodeNotFound = \"terminal_backend_not_found\"\n37|\t// CodeAmbiguous reports a duplicate or ambiguous backend ID. Re-registering\n38|\t// an identical record is still refused: identity registration is not\n39|\t// idempotent.\n40|\tCodeAmbiguous = \"terminal_backend_ambiguous\"\n41|\t// CodeUntrusted reports a disabled, unresolvable, or digest-mismatched\n42|\t// external executable. Trust is established before any probe.\n43|\tCodeUntrusted = \"terminal_backend_untrusted\"\n44|\t// CodeDrift reports a re-registration whose version tuple, kind,\n45|\t// platforms, or executable digest differs from the admitted record.\n46|\tCodeDrift = \"terminal_backend_implementation_drift\"\n47|\t// CodeRestoreMismatch reports an attempt to substitute the configured\n48|\t// default for the exact prior binding on restore or resume.\n49|\tCodeRestoreMismatch = \"terminal_backend_restore_mismatch\"\n50|\t// CodeStaleGeneration reports a generation that is out of bound or does\n51|\t// not match the validated binding.\n52|\tCodeStaleGeneration = \"terminal_backend_stale_generation\"\n53|)\n54|\n55|// Canonical built-in backend identities. The ax. namespace is reserved (§4.B);\n56|// no third-party registration may use it.\n57|const (\n58|\tBuiltinTmux   = \"ax.tmux\"\n59|\tBuiltinConpty = \"ax.conpty\"\n60|)\n61|\n62|// reservedNamespace is the only namespace this implementation may mint.\n63|const reservedNamespace = \"ax.\"\n64|\n65|// maxIDBytes is the Section 4.B bound: 1-128 ASCII bytes.\n66|const maxIDBytes = 128\n67|\n68|// maxGenerationBytes is the Section 4.B/7.A bound: string[1..256].\n69|const maxGenerationBytes = 256\n70|\n71|// maxProtocolVersions is the Section 4.B bound: sorted unique semver[1..32].\n72|const maxProtocolVersions = 32\n73|\n74|var (\n75|\tidPattern = regexp.MustCompile(`^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$`)\n76|\t// semverPattern implements Semantic Versioning 2.0.0 in full, matching the\n77|\t// grammar the canonical and config packages enforce for the same members.\n78|\tsemverPattern = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n79|)\n80|\n81|// Error is a registry refusal. Code is always one of the Code* constants;\n82|// BackendID names the identity at issue when there is one. Detail is a static\n83|// clause: it never echoes paths, digests, generations, or other local data.\n84|type Error struct {\n85|\tCode      string\n86|\tBackendID string\n87|\tDetail    string\n88|}\n89|\n90|func (err *Error) Error() string {\n91|\tif err.BackendID == \"\" {\n92|\t\treturn \"terminal backend refused: \" + err.Code + \" at \" + err.Detail\n93|\t}\n94|\treturn \"terminal backend refused: \" + err.Code + \" for \" + err.BackendID + \" at \" + err.Detail\n95|}\n96|\n97|// errorCode reports whether err carries the given wire code.\n98|func errorCode(err error, code string) bool {\n99|\tvar refusal *Error\n100|\tif !errors.As(err, &refusal) {\n101|\t\treturn false\n102|\t}\n103|\treturn refusal.Code == code\n104|}\n105|\n106|// IsNotFound reports CodeNotFound refusals.\n107|func IsNotFound(err error) bool { return errorCode(err, CodeNotFound) }\n108|\n109|// IsAmbiguous reports CodeAmbiguous refusals.\n110|func IsAmbiguous(err error) bool { return errorCode(err, CodeAmbiguous) }\n111|\n112|// IsUntrusted reports CodeUntrusted refusals.\n113|func IsUntrusted(err error) bool { return errorCode(err, CodeUntrusted) }\n114|\n115|// IsDrift reports CodeDrift refusals.\n116|func IsDrift(err error) bool { return errorCode(err, CodeDrift) }\n117|\n118|// IsRestoreMismatch reports CodeRestoreMismatch refusals.\n119|func IsRestoreMismatch(err error) bool { return errorCode(err, CodeRestoreMismatch) }\n120|\n121|// IsStaleGeneration reports CodeStaleGeneration refusals.\n122|func IsStaleGeneration(err error) bool { return errorCode(err, CodeStaleGeneration) }\n123|\n124|// ParseID validates a canonical terminal backend identity: 1-128 ASCII bytes\n125|// matching [a-z][a-z0-9]*(?:[.-][a-z0-9]+)*. It admits the reserved ax.\n126|// namespace only for the two canonical built-ins; every other ax.-prefixed ID\n127|// is refused so a third party cannot mint a trusted-looking identity.\n128|func ParseID(value string) (string, error) {\n129|\tif !utf8.ValidString(value) || len(value) < 1 || len(value) > maxIDBytes {\n130|\t\treturn \"\", &Error{Code: CodeNotFound, Detail: \"terminal_backend_id bound\"}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
