{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c449","stream":{"kind":"session","id":"01a07060-3ba0-76b0-a9bc-e69817f2ed3c"},"sequence":127,"recorded_at":1780531400000249,"record_type":"event","durability":"durable","causation_id":"0593c7a9-44fe-4750-9d96-383be578e087","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0593c7a9-44fe-4750-9d96-383be578e087","run_stream":{"kind":"run","id":"0593c7a9-44fe-4750-9d96-383be578e087"},"task_stream":{"kind":"task","id":"2db22efc-e342-4128-9dc4-1a560fb48666"},"task_id":"2db22efc-e342-4128-9dc4-1a560fb48666","event":{"kind":"output","task_id":"2db22efc-e342-4128-9dc4-1a560fb48666","chunk":"Read text file `internal/terminalbackend/manifest.go`.\n(239 line(s) above)\n240|\t\"policy_authorization\": true,\n241|}\n242|\n243|// Closed CapabilityEvidenceFact vocabulary (§4.D).\n244|var evidenceFactVocabulary = map[string]bool{\n245|\t\"fixture_passed\": true, \"runtime_probe_passed\": true,\n246|\t\"sentinel_passed\": true, \"provider_auth_passed\": true,\n247|\t\"policy_checked\": true, \"ui_absent\": true, \"prompt_absent\": true,\n248|}\n249|\n250|// Document bounds shared by the three closed schemas.\n251|const (\n252|\tmaxClaims          = 16\n253|\tmaxEvidenceIDs     = 256\n254|\tmaxOperations      = 10\n255|\tmaxRequirements    = 5\n256|\tmaxFacts           = 7\n257|\tmaxOpaqueString    = 256\n258|\tmaxJSONDepth       = 32\n259|\tmaxNativeReference = 512\n260|)\n261|\n262|// mismatchf refuses with CodeMismatch and a static detail clause. The clause\n263|// must never interpolate local data: paths, digests, generations, and\n264|// document bytes stay out of errors.\n265|func mismatchf(format string, arguments ...any) *Error {\n266|\treturn &Error{Code: CodeMismatch, Detail: fmt.Sprintf(format, arguments...)}\n267|}\n268|\n269|// decodeStrictObject decodes one JSON object with duplicate-key refusal,\n270|// invalid-UTF-8 refusal, a nesting cap, and trailing-data refusal. Numbers\n271|// decode as json.Number so member validators can refuse them explicitly:\n272|// none of the three closed schemas has a numeric member.\n273|func decodeStrictObject(raw []byte) (map[string]any, error) {\n274|\tif !utf8.Valid(raw) {\n275|\t\treturn nil, mismatchf(\"document encoding\")\n276|\t}\n277|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n278|\tdecoder.UseNumber()\n279|\tvalue, err := decodeCappedValue(decoder, 0)\n(more lines below)"}}}
