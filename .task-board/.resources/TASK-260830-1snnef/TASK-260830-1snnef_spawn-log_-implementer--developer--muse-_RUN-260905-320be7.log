|func checkGeneration(generation string) error {\n593|\tif !utf8.ValidString(generation) || len(generation) < 1 || len(generation) > maxGenerationBytes {\n594|\t\treturn &Error{Code: CodeStaleGeneration, Detail: \"backend_generation bound\"}\n595|\t}\n596|\treturn nil\n597|}\n598|\n599|// DigestFile returns the sha256: digest of the executable at path after\n600|// resolving symlinks. The target must be a regular file; anything else (or a\n601|// read failure) is an error, never a digest. It distinguishes a failed read\n602|// from an absent trust entry: callers must not fall back to PATH discovery.\n603|func DigestFile(path string) (string, error) {\n604|\tresolved, err := filepath.EvalSymlinks(path)\n605|\tif err != nil {\n606|\t\treturn \"\", fmt.Errorf(\"terminal backend executable: %w\", err)\n607|\t}\n608|\tinfo, err := os.Stat(resolved)\n609|\tif err != nil {\n610|\t\treturn \"\", fmt.Errorf(\"terminal backend executable: %w\", err)\n611|\t}\n612|\tif !info.Mode().IsRegular() {\n613|\t\treturn \"\", fmt.Errorf(\"terminal backend executable %s: not a regular file\", resolved)\n614|\t}\n615|\traw, err := os.ReadFile(resolved)\n616|\tif err != nil {\n617|\t\treturn \"\", fmt.Errorf(\"terminal backend executable: %w\", err)\n618|\t}\n619|\tsum := sha256.Sum256(raw)\n620|\treturn \"sha256:\" + hex.EncodeToString(sum[:]), nil\n621|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
