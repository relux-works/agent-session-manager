{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3e3","stream":{"kind":"session","id":"01a07060-3ba0-76b0-a9bc-e69817f2ed3c"},"sequence":76,"recorded_at":1780531400000147,"record_type":"event","durability":"durable","causation_id":"0593c7a9-44fe-4750-9d96-383be578e087","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0593c7a9-44fe-4750-9d96-383be578e087","run_stream":{"kind":"run","id":"0593c7a9-44fe-4750-9d96-383be578e087"},"task_stream":{"kind":"task","id":"510c5b61-2a4f-4dbd-8350-a494b1f000ae"},"task_id":"510c5b61-2a4f-4dbd-8350-a494b1f000ae","event":{"kind":"output","task_id":"510c5b61-2a4f-4dbd-8350-a494b1f000ae","chunk":"Read text file `internal/terminalbackend/terminalbackend.go`.\n(519 line(s) above)\n520|\t}\n521|\tbound, err := ParseID(boundBackendID)\n522|\tif err != nil {\n523|\t\treturn Registration{}, err\n524|\t}\n525|\tcandidate, err := ParseID(candidateBackendID)\n526|\tif err != nil {\n527|\t\treturn Registration{}, err\n528|\t}\n529|\tif candidate != bound {\n530|\t\treturn Registration{}, &Error{Code: CodeRestoreMismatch, BackendID: candidate, Detail: \"restore requires the prior binding\"}\n531|\t}\n532|\treturn registry.Resolve(bound)\n533|}\n534|\n535|// CheckVersionTuple admits one (implementation_version, protocol_version)\n536|// pair against the admitted protocol list: the implementation must be\n537|// semver, the protocol must be semver in Terminal Backend Protocol major 1\n538|// and exactly one member of the list. Array-to-scalar selection is\n539|// membership, not aggregate equality (§4.B).\n540|func CheckVersionTuple(backendID, implementationVersion, protocolVersion string, protocolVersions []string) error {\n541|\tif !semverPattern.MatchString(implementationVersion) {\n542|\t\treturn &Error{Code: CodeDrift, BackendID: backendID, Detail: \"implementation_version semver\"}\n543|\t}\n544|\tif !semverPattern.MatchString(protocolVersion) || semverMajor(protocolVersion) != 1 {\n545|\t\treturn &Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_version major 1\"}\n546|\t}\n547|\tfor _, member := range protocolVersions {\n548|\t\tif protocolVersion == member {\n549|\t\t\treturn nil\n550|\t\t}\n551|\t}\n552|\treturn &Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_version membership\"}\n553|}\n554|\n555|// InstanceBinding is the validated host-local binding subset a §7.A provider\n556|// descriptor must match: backend ID, versions, and generation.\n557|type InstanceBinding struct {\n558|\tBackendID             string\n559|\tImplementationVersion string\n560|\tProtocolVersion       string\n561|\tGeneration            string\n562|}\n563|\n564|// CheckProviderDescriptor enforces the Section 7.A rule: the provider rejects\n565|// a descriptor whose backend ID, versions, or generation do not match the\n566|// AX-validated host-local binding before launching or observing a provider\n567|// process. Generation lengths 0 and over 256 are invalid; 256 is accepted.\n568|func CheckProviderDescriptor(descriptor, binding InstanceBinding) error {\n569|\tif err := checkGeneration(descriptor.Generation); err != nil {\n570|\t\treturn err\n571|\t}\n572|\tif err := checkGeneration(binding.Generation); err != nil {\n573|\t\treturn err\n574|\t}\n575|\tif _, err := ParseID(descriptor.BackendID); err != nil {\n576|\t\treturn err\n577|\t}\n578|\tif descriptor.BackendID != binding.BackendID {\n579|\t\treturn &Error{Code: CodeNotFound, BackendID: descriptor.BackendID, Detail: \"descriptor backend binding\"}\n580|\t}\n581|\tif descriptor.ImplementationVersion != binding.ImplementationVersion ||\n582|\t\tdescriptor.ProtocolVersion != binding.ProtocolVersion {\n583|\t\treturn &Error{Code: CodeDrift, BackendID: descriptor.BackendID, Detail: \"descriptor version binding\"}\n584|\t}\n585|\tif descriptor.Generation != binding.Generation {\n586|\t\treturn &Error{Code: CodeStaleGeneration, BackendID: descriptor.BackendID, Detail: \"descriptor generation binding\"}\n587|\t}\n588|\treturn nil\n589|}\n590|\n591|// checkGeneration enforces string[1..256] measured in bytes over valid UTF-8.\n592|func checkGeneration(generation string) error {\n593|\tif !utf8.ValidString(generation) || len(generation) < 1 || len(generation) > maxGenerationBytes {\n594|\t\treturn &Error{Code: CodeStaleGeneration, Detail: \"backend_generation bound\"}\n595|\t}\n596|\treturn nil\n597|}\n598|\n599|// DigestFile returns the sha256: digest of the executable at path after\n600|// resolving symlinks. The target must be a regular file; anything else (or a\n601|// read failure) is an error, never a digest. It distinguishes a failed read\n602|// from an absent trust entry: callers must not fall back to PATH discovery.\n603|func DigestFile(path string) (string, error) {\n604|\tresolved, err := filepath.EvalSymlinks(path)\n605|\tif err != nil {\n606|\t\treturn \"\", fmt.Errorf(\"terminal backend executable: %w\", err)\n607|\t}\n608|\tinfo, err := os.Stat(resolved)\n609|\tif err != nil {\n610|\t\treturn \"\", fmt.Errorf(\"terminal backend executable: %w\", err)\n611|\t}\n612|\tif !info.Mode().IsRegular() {\n613|\t\treturn \"\", fmt.Errorf(\"terminal backend executable %s: not a regular file\", resolved)\n614|\t}\n615|\traw, err := os.ReadFile(resolved)\n616|\tif err != nil {\n617|\t\treturn \"\", fmt.Errorf(\"terminal backend executable: %w\", err)\n618|\t}\n619|\tsum := sha256.Sum256(raw)\n620|\treturn \"sha256:\" + hex.EncodeToString(sum[:]), nil\n621|}"}}}
