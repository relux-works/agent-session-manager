{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c619","stream":{"kind":"session","id":"01a06fb4-3612-7082-aba0-c5e534814a47"},"sequence":359,"recorded_at":1780531400000713,"record_type":"event","durability":"durable","causation_id":"eabad717-3e00-45d4-b352-a95943b57e50","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"eabad717-3e00-45d4-b352-a95943b57e50","run_stream":{"kind":"run","id":"eabad717-3e00-45d4-b352-a95943b57e50"},"call_id":"call_01a06fb5fef6772091a96120b5773c94","text":"Read text file `internal/terminalbackend/conformance_test.go`.\n(1079 line(s) above)\n1080|func TestCheckAttachResultRequiresTripleEquality(t *testing.T) {\n1081|\tt.Parallel()\n1082|\n1083|\tauth := testAttachAuthorization(t)\n1084|\tif err := terminalbackend.CheckAttachResult(true, true, auth); err != nil {\n1085|\t\tt.Errorf(\"CheckAttachResult(true, true) error = %v, want admission\", err)\n1086|\t}\n1087|\n1088|\tgranted := terminalbackend.CheckAttachResult(false, true, auth)\n1089|\trequireConformanceRefusal(t, granted,\n1090|\t\t\"terminal_backend_unauthorized\", \"attach input binding\")\n1091|\trevoked := terminalbackend.CheckAttachResult(true, false, auth)\n1092|\trequireConformanceRefusal(t, revoked,\n1093|\t\t\"terminal_backend_unauthorized\", \"attach input binding\")\n1094|\t// Only the auth conjunct catches this one: request and result agree\n1095|\t// (both false) but the policy authorized input, so dropping the\n1096|\t// resultInputAuthorized != auth.InputAuthorized leg admits it.\n1097|\twithheld := terminalbackend.CheckAttachResult(false, false, auth)\n1098|\trequireConformanceRefusal(t, withheld,\n1099|\t\t\"terminal_backend_unauthorized\", \"attach input binding\")\n1100|}\n1101|\n1102|// TestCheckEntrypointAdmitsOnlyAxPane proves the §4.A stable entrypoint:\n1103|// exactly ax, pane, and the canonical session string. A raw provider\n1104|// command, a reordered argv, or a session that is not the one under\n1105|// creation cannot serve as the durable entry point.\n1106|func TestCheckEntrypointAdmitsOnlyAxPane(t *testing.T) {\n1107|\tt.Parallel()\n1108|\n1109|\tif err := terminalbackend.CheckEntrypoint(\n1110|\t\t[]string{\"ax\", \"pane\", conformanceSessionA}, conformanceSessionA); err != nil {\n1111|\t\tt.Errorf(\"CheckEntrypoint() error = %v, want admission\", err)\n1112|\t}\n1113|\n1114|\trefused := []struct {\n1115|\t\tname    string\n1116|\t\targv    []string\n1117|\t\tsession string\n1118|\t}{\n1119|\t\t{\"raw provider command\", []string{\"codex\", \"--session\", conformanceSessionA}, conformanceSessionA},\n1120|\t\t{\"provider binary with pane\", []string{\"codex\", \"pane\", conformanceSessionA}, conformanceSessionA},\n1121|\t\t{\"reordered argv\", []string{\"pane\", \"ax\", conformanceSessionA}, conformanceSessionA},\n1122|\t\t{\"uppercase binary\", []string{\"AX\", \"pane\", conformanceSessionA}, conformanceSessionA},\n1123|\t\t{\"missing session\", []string{\"ax\", \"pane\"}, conformanceSessionA},\n1124|\t\t{\"extra argv\", []string{\"ax\", \"pane\", conformanceSessionA, \"--extra\"}, conformanceSessionA},\n1125|\t\t{\"empty argv\", nil, conformanceSessionA},\n1126|\t\t{\"wrong session\", []string{\"ax\", \"pane\", conformanceSessionB}, conformanceSessionA},\n1127|\t\t{\"non-uuid session\", []string{\"ax\", \"pane\", \"not-a-session\"}, \"not-a-session\"},\n1128|\t\t{\"uuidv4 session\", []string{\"ax\", \"pane\", \"0198f4c8-8e50-4f66-8f70-1234567890ab\"},\n1129|\t\t\t\"0198f4c8-8e50-4f66-8f70-1234567890ab\"},\n1130|\t}\n1131|\tfor _, tc := range refused {\n1132|\t\terr := terminalbackend.CheckEntrypoint(tc.argv, tc.session)\n1133|\t\tif err == nil {\n1134|\t\t\tt.Errorf(\"CheckEntrypoint(%q, %q) = nil, want refusal\", tc.argv, tc.session)\n1135|\t\t\tcontinue\n1136|\t\t}\n1137|\t\tvar refusal *terminalbackend.Error\n1138|\t\tif !errors.As(err, &refusal) || refusal.Code != \"local_precondition_failed\" {\n1139|\t\t\tt.Errorf(\"CheckEntrypoint(%q, %q) = %v, want local_precondition_failed\",\n1140|\t\t\t\ttc.argv, tc.session, err)\n1141|\t\t\tcontinue\n1142|\t\t}\n1143|\t\tif refusal.Detail != \"entrypoint argv\" && refusal.Detail != \"entrypoint session binding\" {\n1144|\t\t\tt.Errorf(\"CheckEntrypoint(%q, %q) detail = %q, want an entrypoint clause\",\n1145|\t\t\t\ttc.argv, tc.session, refusal.Detail)\n1146|\t\t}\n1147|\t}\n1148|}\n1149|\n1150|// TestCheckEntrypointNamesItsArm pins the two refusal clauses separately:\n1151|// an argv-shape violation and a session-binding violation are distinct\n1152|// arms, so merging them reddens here.\n1153|func TestCheckEntrypointNamesItsArm(t *testing.T) {\n1154|\tt.Parallel()\n1155|\n1156|\terr := terminalbackend.CheckEntrypoint(\n1157|\t\t[]string{\"codex\", conformanceSessionA}, conformanceSessionA)\n1158|\trequireConformanceRefusal(t, err, \"local_precondition_failed\", \"entrypoint argv\")\n1159|\n1160|\terr = terminalbackend.CheckEntrypoint(\n1161|\t\t[]string{\"ax\", \"pane\", conformanceSessionB}, conformanceSessionA)\n1162|\trequireConformanceRefusal(t, err, \"local_precondition_failed\", \"entrypoint session binding\")\n1163|}\n1164|\n1165|// TestCheckStatusResultEnforcesLookupRules proves the §4.C status result\n1166|// contract: the canonical false form on non-match with no fallback, null\n1167|// provider observation unless requested and evidenced, and attachability\n1168|// only in parked or active with evidenced attach capability.\n1169|func TestCheckStatusResultEnforcesLookupRules(t *testing.T) {\n1170|\tt.Parallel()\n1171|\n1172|\tpresent := true\n1173|\tlastOp := \"0198f4c8-8e50-7f66-8f70-1234567890ab\"\n1174|\tlastEffect := terminalbackend.EffectWrapperStarted\n1175|\tmatched := terminalbackend.StatusResult{\n1176|\t\tState:             \"active\",\n1177|\t\tIdentityMatch:     true,\n1178|\t\tWrapperPresent:    true,\n1179|\t\tProviderPresent:   &present,\n1180|\t\tAttachable:        true,\n1181|\t\tLastOperationID:   &lastOp,\n1182|\t\tLastEffect:        &lastEffect,\n1183|\t\tProviderRequested: true,\n1184|\t\tProviderEvidenced: true,\n1185|\t\tAttachEvidenced:   true,\n1186|\t}\n1187|\tif err := terminalbackend.CheckStatusResult(true, matched); err != nil {\n1188|\t\tt.Errorf(\"CheckStatusResult(match) error = %v, want admission\", err)\n1189|\t}\n1190|\n1191|\t// The canonical false form is admitted and authorizes no fallback.\n1192|\tcanonical := terminalbackend.StatusResult{State: \"absent\"}\n1193|\tif err := terminalbackend.CheckStatusResult(false, canonical); err != nil {\n1194|\t\tt.Errorf(\"CheckStatusResult(canonical false) error = %v, want admission\", err)\n1195|\t}\n1196|\n1197|\t// Every deviation from the false form is refused.\n1198|\tnonCanonical := []terminalbackend.StatusResult{\n1199|\t\t{State: \"active\"},\n1200|\t\t{State: \"absent\", IdentityMatch: true},\n1201|\t\t{State: \"absent\", WrapperPresent: true},\n1202|\t\t{State: \"absent\", ProviderPresent: &present},\n1203|\t\t{State: \"absent\", Attachable: true},\n1204|\t\t{State: \"absent\", LastOperationID: &lastOp},\n1205|\t\t{State: \"absent\", LastEffect: &lastEffect},\n1206|\t}\n1207|\tfor _, result := range nonCanonical {\n1208|\t\terr := terminalbackend.CheckStatusResult(false, result)\n1209|\t\trequireConformanceRefusal(t, err,\n1210|\t\t\t\"terminal_backend_protocol_error\", \"status identity binding\")\n1211|\t}\n1212|\n1213|\t// provider_present without request, or without evidence, is refused.\n1214|\tunrequested := matched\n1215|\tunrequested.ProviderRequested = false\n1216|\trequireConformanceRefusal(t,\n1217|\t\tterminalbackend.CheckStatusResult(true, unrequested),\n1218|\t\t\"terminal_backend_protocol_error\", \"status provider observation\")\n1219|\tunevidenced := matched\n1220|\tunevidenced.ProviderEvidenced = false\n1221|\trequireConformanceRefusal(t,\n1222|\t\tterminalbackend.CheckStatusResult(true, unevidenced),\n1223|\t\t\"terminal_backend_protocol_error\", \"status provider observation\")\n1224|\n1225|\t// attachable outside parked/active, or without evidenced attach\n1226|\t// capability, is refused.\n1227|\tstopped := matched\n1228|\tstopped.State = \"stopped\"\n1229|\trequireConformanceRefusal(t,\n1230|\t\tterminalbackend.CheckStatusResult(true, stopped),\n1231|\t\t\"local_precondition_failed\", \"status attachability\")\n1232|\tparked := matched\n1233|\tparked.State = \"parked\"\n1234|\tparked.ProviderPresent = nil\n1235|\tparked.ProviderRequested = false\n1236|\tparked.ProviderEvidenced = false\n1237|\tif err := terminalbackend.CheckStatusResult(true, parked); err != nil {\n1238|\t\tt.Errorf(\"CheckStatusResult(parked, evidenced) error = %v, want admission\", err)\n1239|\t}\n1240|\tunproven := matched\n1241|\tunproven.AttachEvidenced = false\n1242|\trequireConformanceRefusal(t,\n1243|\t\tterminalbackend.CheckStatusResult(true, unproven),\n1244|\t\t\"local_precondition_failed\", \"status attachability\")\n1245|\n1246|\t// An unknown state or effect is a vocabulary refusal, never a pass.\n1247|\tbogus := matched\n1248|\tbogus.State = \"running\"\n1249|\trequireConformanceRefusal(t,\n1250|\t\tterminalbackend.CheckStatusResult(true, bogus),\n1251|\t\t\"terminal_backend_protocol_error\", \"lifecycle state vocabulary\")\n1252|\tbogusEffect := terminalbackend.SideEffect(\"side_effect_unknown\")\n1253|\tbogus = matched\n1254|\tbogus.LastEffect = &bogusEffect\n1255|\trequireConformanceRefusal(t,\n1256|\t\tterminalbackend.CheckStatusResult(true, bogus),\n1257|\t\t\"terminal_backend_protocol_error\", \"side effect vocabulary\")\n1258|}\n1259|\n1260|// TestReplicationClassificationIsClosed pins the whole §4.E table: every\n1261|// listed member classifies exactly once, and the classes are disjoint.\n1262|// Moving one member between classes reddens here before any replication\n1263|// decision can silently change.\n1264|func TestReplicationClassificationIsClosed(t *testing.T) {\n1265|\tt.Parallel()\n1266|\n1267|\twant := map[string]terminalbackend.ReplicationClass{\n1268|\t\t\"manifest_id\": \"safe_evidence\", \"probe_id\": \"safe_evidence\",\n1269|\t\t\"evidence_id\":               \"safe_evidence\",\n1270|\t\t\"terminal_backend_id\":       \"safe_evidence\",\n1271|\t\t\"implementation_version\":    \"safe_evidence\",\n1272|\t\t\"protocol_version\":          \"safe_evidence\",\n1273|\t\t\"protocol_versions\":         \"safe_evidence\",\n1274|\t\t\"platform\":                  \"safe_evidence\",\n1275|\t\t\"platforms\":                 \"safe_evidence\",\n1276|\t\t\"os_version\":                \"safe_evidence\",\n1277|\t\t\"conformance_fixture_id\":    \"safe_evidence\",\n1278|\t\t\"capability_claims\":         \"safe_evidence\",\n1279|\t\t\"evidence_ids\":              \"safe_evidence\",\n1280|\t\t\"backend_generation_digest\": \"safe_evidence\",\n1281|\t\t\"capability\":                \"safe_evidence\",\n1282|\t\t\"dependent_operations\":      \"safe_evidence\",\n1283|\t\t\"evidence_requirements\":     \"safe_evidence\",\n1284|\t\t\"facts\":                     \"safe_evidence\",\n1285|\t\t\"issuer\":                    \"safe_evidence\",\n1286|\t\t\"issuer_id\":                 \"safe_evidence\",\n1287|\t\t\"observed_at\":               \"safe_evidence\",\n1288|\t\t\"expires_at\":                \"safe_evidence\",\n1289|\n1290|\t\t\"binding_id\": \"host_local\", \"terminal_instance_id\": \"host_local\",\n1291|\t\t\"session_id\": \"host_local\", \"host_id\": \"host_local\",\n1292|\t\t\"host_incarnation_id\":   \"host_local\",\n1293|\t\t\"backend_generation\":    \"host_local\",\n1294|\t\t\"native_reference\":      \"host_local\",\n1295|\t\t\"idempotency_receipt\":   \"host_local\",\n1296|\t\t\"last_effect\":           \"host_local\",\n1297|\t\t\"last_operation_id\":     \"host_local\",\n1298|\t\t\"supersedes_binding_id\": \"host_local\",\n1299|\t\t\"created_at\":            \"host_local\",\n1300|\n1301|\t\t\"availability\": \"derived_cache\", \"attachable\": \"derived_cache\",\n1302|\t\t\"wrapper_present\": \"derived_cache\", \"provider_present\": \"derived_cache\",\n1303|\t\t\"identity_match\": \"derived_cache\", \"state\": \"derived_cache\",\n1304|\t\t\"probed_at\": \"derived_cache\",\n1305|\n1306|\t\t\"attach_descriptor\":   \"sensitive_owner_only\",\n1307|\t\t\"ipc_handle\":          \"sensitive_owner_only\",\n1308|\t\t\"tmux_socket\":         \"sensitive_owner_only\",\n1309|\t\t\"named_pipe\":          \"sensitive_owner_only\",\n1310|\t\t\"attach_credential\":   \"sensitive_owner_only\",\n1311|\t\t\"relay_credential\":    \"sensitive_owner_only\",\n1312|\t\t\"backend_auth\":        \"sensitive_owner_only\",\n1313|\t\t\"auth_database\":       \"sensitive_owner_only\",\n1314|\t\t\"gui_attestation\":     \"sensitive_owner_only\",\n1315|\t\t\"login_attestation\":   \"sensitive_owner_only\",\n1316|\t\t\"provider_credential\": \"sensitive_owner_only\",\n1317|\t\t\"evidence_secret\":     \"sensitive_owner_only\",\n1318|\t\t\"environment_values\":  \"sensitive_owner_only\",\n1319|\n1320|\t\t\"native_pid\": \"forbidden\", \"process_handle\": \"forbidden\",\n1321|\t\t\"endpoint\": \"forbidden\", \"token\": \"forbidden\",\n1322|\t\t\"terminal_output\": \"forbidden\", \"scrollback\": \"forbidden\",\n1323|\t\t\"unrestricted_environment\": \"forbidden\",\n1324|\t\t\"credential_detail\":        \"forbidden\",\n1325|\t\t\"live_process_fact\":        \"forbidden\",\n1326|\t\t\"raw_native_reference\":     \"forbidden\",\n1327|\t}\n1328|\tfor member, class := range want {\n1329|\t\tgot, known := terminalbackend.ClassifyReplication(member)\n1330|\t\tif !known {\n1331|\t\t\tt.Errorf(\"ClassifyReplication(%q) unknown, want %q\", member, class)\n1332|\t\t\tcontinue\n1333|\t\t}\n1334|\t\tif got != class {\n1335|\t\t\tt.Errorf(\"ClassifyReplication(%q) = %q, want %q\", member, got, class)\n1336|\t\t}\n1337|\t}\n1338|\tfor _, unknown := range []string{\"\", \"session_record\", \"MANIFEST_ID\", \"manifest_id \"} {\n1339|\t\tif _, known := terminalbackend.ClassifyReplication(unknown); known {\n1340|\t\t\tt.Errorf(\"ClassifyReplication(%q) known: unknown members must not classify\", unknown)\n1341|\t\t}\n1342|\t}\n1343|}\n1344|\n1345|// TestCheckReplicableRefusesEveryNonSafeClass proves the exclusion at the\n1346|// production entry: one witness from each non-safe class plus an unknown\n1347|// member is refused, while a safe-evidence set (and the empty set, which\n1348|// replicates nothing) is admitted.\n1349|func TestCheckReplicableRefusesEveryNonSafeClass(t *testing.T) {\n1350|\tt.Parallel()\n1351|\n1352|\tsafe := []string{\n1353|\t\t\"manifest_id\", \"probe_id\", \"evidence_id\",\n1354|\t\t\"terminal_backend_id\", \"implementation_version\", \"protocol_version\",\n1355|\t\t\"platform\", \"conformance_fixture_id\", \"capability_claims\",\n1356|\t\t\"backend_generation_digest\", \"facts\", \"issuer_id\",\n1357|\t}\n1358|\tif err := terminalbackend.CheckReplicable(safe); err != nil {\n1359|\t\tt.Errorf(\"CheckReplicable(safe) error = %v, want admission\", err)\n1360|\t}\n1361|\tif err := terminalbackend.CheckReplicable(nil); err != nil {\n1362|\t\tt.Errorf(\"CheckReplicable(nil) error = %v, want admission\", err)\n1363|\t}\n1364|\n1365|\tfor _, member := range []string{\n1366|\t\t\"binding_id\", \"terminal_instance_id\", \"backend_generation\",\n1367|\t\t\"attachable\", \"availability\", \"probed_at\",\n1368|\t\t\"attach_descriptor\", \"tmux_socket\", \"provider_credential\",\n1369|\t\t\"native_pid\", \"terminal_output\", \"scrollback\", \"token\",\n1370|\t\t\"credential_detail\", \"live_process_fact\",\n1371|\t\t\"tomorrow_s_exclusion\",\n1372|\t} {\n1373|\t\terr := terminalbackend.CheckReplicable([]string{\"manifest_id\", member})\n1374|\t\trequireConformanceRefusal(t, err,\n1375|\t\t\t\"terminal_backend_protocol_error\", \"replication exclusion\")\n1376|\t}\n1377|}\n1378|\n1379|// TestHistoricalTranslationMapsOnlyTheImmutablePair proves the §4.E\n1380|// translation: the two immutable v0.4.3 values map forward with\n1381|// legacy_unreported version and generation, and everything else is\n1382|// incompatible, never fallback.\n1383|func TestHistoricalTranslationMapsOnlyTheImmutablePair(t *testing.T) {\n1384|\tt.Parallel()\n1385|\n1386|\tfor _, tc := range []struct {\n1387|\t\tlegacy string\n1388|\t\twantID string\n1389|\t}{\n1390|\t\t{\"tmux\", terminalbackend.BuiltinTmux},\n1391|\t\t{\"conpty\", terminalbackend.BuiltinConpty},\n1392|\t} {\n1393|\t\tbinding, err := terminalbackend.TranslateLegacyBackend(tc.legacy)\n1394|\t\tif err != nil {\n1395|\t\t\tt.Errorf(\"TranslateLegacyBackend(%q) error = %v, want admission\", tc.legacy, err)\n1396|\t\t\tcontinue\n1397|\t\t}\n1398|\t\tif binding.BackendID != tc.wantID {\n1399|\t\t\tt.Errorf(\"TranslateLegacyBackend(%q).BackendID = %q, want %q\",\n1400|\t\t\t\ttc.legacy, binding.BackendID, tc.wantID)\n1401|\t\t}\n1402|\t\tif binding.ImplementationVersion != terminalbackend.LegacyUnreported ||\n1403|\t\t\tbinding.Generation != terminalbackend.LegacyUnreported {\n1404|\t\t\tt.Errorf(\"TranslateLegacyBackend(%q) = %+v, want legacy_unreported version and generation\",\n1405|\t\t\t\ttc.legacy, binding)\n1406|\t\t}\n1407|\t}\n1408|\n1409|\tfor _, legacy := range []string{\n1410|\t\t\"\", \"TMUX\", \"Tmux\", \"tmux \", \" conpty\",\n1411|\t\t\"ax.tmux\", \"ax.conpty\", \"superlogical\", \"ghostty\", \"wezterm\",\n1412|\t} {\n1413|\t\t_, err := terminalbackend.TranslateLegacyBackend(legacy)\n1414|\t\trequireConformanceRefusal(t, err,\n1415|\t\t\t\"incompatible_schema\", \"legacy backend identity\")\n1416|\t}\n1417|}\n1418|\n1419|// TestLegacyReverseProjectionExistsOnlyForThePair proves the reverse\n1420|// direction: the two canonical built-ins project back, every other valid\n1421|// ID is incompatible rather than fallback, and a malformed identity is\n1422|// refused by the registry grammar first.\n1423|func TestLegacyReverseProjectionExistsOnlyForThePair(t *testing.T) {\n1424|\tt.Parallel()\n1425|\n1426|\tlegacy, err := terminalbackend.ProjectToLegacy(terminalbackend.BuiltinTmux)\n1427|\tif err != nil || legacy != \"tmux\" {\n1428|\t\tt.Errorf(\"ProjectToLegacy(ax.tmux) = %q, %v, want tmux, nil\", legacy, err)\n1429|\t}\n1430|\tlegacy, err = terminalbackend.ProjectToLegacy(terminalbackend.BuiltinConpty)\n1431|\tif err != nil || legacy != \"conpty\" {\n1432|\t\tt.Errorf(\"ProjectToLegacy(ax.conpty) = %q, %v, want conpty, nil\", legacy, err)\n1433|\t}\n1434|\n1435|\t_, err = terminalbackend.ProjectToLegacy(\"vendor.term\")\n1436|\trequireConformanceRefusal(t, err, \"incompatible_schema\", \"legacy reverse projection\")\n1437|\n1438|\t// A reserved-namespace squat is not an ID at all: the registry\n1439|\t// grammar refuses it before projection can consider it.\n1440|\t_, err = terminalbackend.ProjectToLegacy(\"ax.tmuxx\")\n1441|\trequireConformanceRefusal(t, err,\n1442|\t\t\"terminal_backend_not_found\", \"terminal_backend_id reserved namespace\")\n1443|\n1444|\t_, err = terminalbackend.ProjectToLegacy(\"TMUX\")\n1445|\trequireConformanceRefusal(t, err,\n1446|\t\t\"terminal_backend_not_found\", \"terminal_backend_id grammar\")\n1447|}\n1448|\n1449|// TestLegacyBindingCarriesNoCapabilities is the structural proof that\n1450|// translation infers nothing: the binding has exactly three fields and\n1451|// none of them names a capability, claim, or evidence set. Forward and\n1452|// reverse round-trip without touching history: the argument is unchanged\n1453|// by construction of a pure function.\n1454|func TestLegacyBindingCarriesNoCapabilities(t *testing.T) {\n1455|\tt.Parallel()\n1456|\n1457|\tbindingType := reflect.TypeOf(terminalbackend.LegacyBinding{})\n1458|\tif bindingType.NumField() != 3 {\n1459|\t\tt.Errorf(\"LegacyBinding has %d fields, want 3: \"+\n1460|\t\t\t\"translation carries no inferred capabilities\", bindingType.NumField())\n1461|\t}\n1462|\tfor index := 0; index < bindingType.NumField(); index++ {\n1463|\t\tname := bindingType.Field(index).Name\n1464|\t\tfor _, forbidden := range []string{\"Capabilit\", \"Claim\", \"Evidence\", \"Probe\", \"Manifest\"} {\n1465|\t\t\tif strings.Contains(name, forbidden) {\n1466|\t\t\t\tt.Errorf(\"LegacyBinding.%s names %q: translation infers no capabilities\",\n1467|\t\t\t\t\tname, forbidden)\n1468|\t\t\t}\n1469|\t\t}\n1470|\t}\n1471|\n1472|\tfor _, legacy := range []string{\"tmux\", \"conpty\"} {\n1473|\t\tbefore := legacy\n1474|\t\tbinding, err := terminalbackend.TranslateLegacyBackend(legacy)\n1475|\t\tif err != nil {\n1476|\t\t\tt.Fatalf(\"TranslateLegacyBackend(%q) error = %v\", legacy, err)\n1477|\t\t}\n1478|\t\tif legacy != before {\n1479|\t\t\tt.Errorf(\"TranslateLegacyBackend mutated its argument\")\n1480|\t\t}\n1481|\t\tback, err := terminalbackend.ProjectToLegacy(binding.BackendID)\n1482|\t\tif err != nil {\n1483|\t\t\tt.Fatalf(\"ProjectToLegacy(%q) error = %v\", binding.BackendID, err)\n1484|\t\t}\n1485|\t\tif back != legacy {\n1486|\t\t\tt.Errorf(\"round trip %q -> %q -> %q, want identity\", legacy, binding.BackendID, back)\n1487|\t\t}\n1488|\t}\n1489|}\n1490|\n1491|// TestAdmitProbeRefusesNilRegistry closes a gap the refusal-arm\n1492|// derivation exposed: no test drove the nil-registry arm of AdmitProbe.\n1493|// The nil check runs before any parsing, so no document fixture is\n1494|// needed to reach it.\n1495|func TestAdmitProbeRefusesNilRegistry(t *testing.T) {\n1496|\tt.Parallel()\n1497|\n1498|\tvar nilRegistry *terminalbackend.Registry\n1499|\t_, err := nilRegistry.AdmitProbe(nil, nil, nil, \"\", time.Now().UTC(), nil)\n1500|\trequireConformanceRefusal(t, err,\n1501|\t\t\"terminal_backend_not_found\", \"registry unavailable\")\n1502|}\n1503|\n1504|// TestUnsignedEvidenceBytesNeverFailsOnSchemaAdmittedInput states the\n1505|// bound the two \"evidence canonical bytes\" arms carry: UnsignedEvidenceBytes\n1506|// serializes a fixed map of strings, booleans, and nulls built from typed\n1507|// Evidence, so neither encoding/json (which fails only on channels,\n1508|// functions, or Marshaler errors) nor the JCS transform (which fails only\n1509|// on malformed input, and Marshal output is always well-formed) can fail\n1510|// on schema-admitted input. The arms stay as fail-closed defense; this\n1511|// test proves the bound by driving the nastiest strings the schema\n1512|// admits — invalid UTF-8, empty, and maximal — and requiring success.\n1513|// If Evidence ever gains a field type outside string/bool/null, this\n1514|// bound must be re-proven, not assumed.\n1515|func TestUnsignedEvidenceBytesNeverFailsOnSchemaAdmittedInput(t *testing.T) {\n1516|\tt.Parallel()\n1517|\n1518|\tplatform, err := scalar.ParsePlatform(\"linux\")\n1519|\tif err != nil {\n1520|\t\tt.Fatalf(\"ParsePlatform() error = %v\", err)\n1521|\t}\n1522|\tobserved, err := scalar.ParseTimestamp(conformanceIssued)\n1523|\tif err != nil {\n1524|\t\tt.Fatalf(\"ParseTimestamp() error = %v\", err)\n1525|\t}\n1526|\texpires, err := scalar.ParseTimestamp(conformanceExpires)\n1527|\tif err != nil {\n1528|\t\tt.Fatalf(\"ParseTimestamp() error = %v\", err)\n1529|\t}\n1530|\tfor _, osVersion := range []string{\n1531|\t\t\"15.6.1\",\n1532|\t\t\"\",\n1533|\t\tstrings.Repeat(\"v\", 256),\n1534|\t\t\"invalid-utf8-\\xff\\xfe-lone-surrogate-\\xed\\xa0\\x80\",\n1535|\t\t\"controls-\\x00\\x01\\x02-newline-\\n-tab-\\t\",\n1536|\t} {\n1537|\t\tevidence := terminalbackend.Evidence{\n1538|\t\t\tTerminalBackendID:       \"com.example.term\",\n1539|\t\t\tImplementationVersion:   \"1.2.3\",\n1540|\t\t\tProtocolVersion:         \"1.0.0\",\n1541|\t\t\tBackendGenerationDigest: testDigest,\n1542|\t\t\tCapability:              \"graceful_stop\",\n1543|\t\t\tPlatform:                platform,\n1544|\t\t\tOSVersion:               osVersion,\n1545|\t\t\tConformanceFixtureID:    testDigest,\n1546|\t\t\tObservedAt:              observed,\n1547|\t\t\tExpiresAt:               expires,\n1548|\t\t\tIssuer:                  \"ax_local_probe\",\n1549|\t\t\tIssuerID:                testDigest,\n1550|\t\t\tFacts:                   []string{\"fixture_passed\", \"runtime_probe_passed\"},\n1551|\t\t}\n1552|\t\tunsigned, err := terminalbackend.UnsignedEvidenceBytes(evidence)\n1553|\t\tif err != nil {\n1554|\t\t\tt.Errorf(\"UnsignedEvidenceBytes(os_version=%q) error = %v, want success: \"+\n1555|\t\t\t\t\"the evidence canonical bytes arms are dead on schema-admitted input\", osVersion, err)\n1556|\t\t\tcontinue\n1557|\t\t}\n1558|\t\tif len(unsigned) == 0 {\n1559|\t\t\tt.Errorf(\"UnsignedEvidenceBytes(os_version=%q) returned no bytes\", osVersion)\n1560|\t\t}\n1561|\t}\n1562|}\n1563|\n1564|// TestParseSideEffectAdmitsOnlyTheTenClosedEffects sweeps the last\n1565|// vocabulary the harness parses.\n1566|func TestParseSideEffectAdmitsOnlyTheTenClosedEffects(t *testing.T) {\n1567|\tt.Parallel()\n1568|\n1569|\tfor _, effect := range []string{\n1570|\t\t\"binding_persisted\", \"wrapper_started\", \"attach_client_created\",\n1571|\t\t\"input_closed\", \"safe_boundary_observed\", \"graceful_stop_requested\",\n1572|\t\t\"process_closed\", \"backend_store_closed\",\n1573|\t\t\"stale_incarnation_terminated\", \"wrapper_restored\",\n1574|\t} {\n1575|\t\tif _, err := terminalbackend.ParseSideEffect(effect); err != nil {\n1576|\t\t\tt.Errorf(\"ParseSideEffect(%q) error = %v, want admission\", effect, err)\n1577|\t\t}\n1578|\t}\n1579|\tfor _, effect := range []string{\"\", \"wrapper_started \", \"process-closed\", \"pane_started\"} {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
