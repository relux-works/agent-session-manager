n233|\t\treturn plantedPlain()\n234|\t}\n235|\tfor _, member := range members {''')],\n236|    newfiles=[(\"planted_plain.go\", '''package terminalbackend\n237|\n238|import \"errors\"\n239|\n240|func plantedPlain() error { return errors.New(\"planted plain refusal in a new file\") }\n241|''')]))\n242|\n243|# W13: custom error type (neither *Error nor errors.New/fmt.Errorf).\n244|results.append(probe(\"W13\", \"custom error type smuggled as a refusal (no *Error, no errors.New/fmt.Errorf)\",\n245|    [(CONF, ANCHOR, '''type plantedErr struct{}\n246|\n247|func (plantedErr) Error() string { return \"planted custom refusal\" }\n248|\n249|func CheckReplicable(members []string) error {\n250|\tif len(members) == 7777 {\n251|\t\treturn plantedErr{}\n252|\t}\n253|\tfor _, member := range members {''')]))\n254|\n255|# W14 (control): delete an existing arm — reverse direction.\n256|results.append(probe(\"W14\", \"CONTROL: delete an existing arm (reverse direction)\",\n257|    [(CONF, '''\t\t\treturn &Error{Code: CodeProtocolError, Detail: \"replication exclusion\"}''',\n258|      '''\t\t\treturn &Error{Code: CodeProtocolError, Detail: \"replication exclusion\"} // keep\n259|\t\t}\n260|\t\tif false {''')]))\n261|\n262|restore()\n263|json.dump(results, open(\".temp/TASK-260830-1snnef-r2/ga2-results.json\", \"w\"), indent=1)\n264|import sys, json\n265|sys.path.insert(0, \".temp/TASK-260830-1snnef-r2\")\n266|from probe import probe, restore\n267|\n268|CONF = \"internal/terminalbackend/conformance.go\"\n269|TB   = \"internal/terminalbackend/terminalbackend.go\"\n270|ANCHOR = '''func CheckReplicable(members []string) error {\n271|\tfor _, member := range members {'''\n272|TBANCHOR = '''func validateProtocolVersions(backendID string, versions []string) error {'''\n273|results = []\n274|\n275|# W14b: honest control — actually DELETE an existing arm.\n276|results.append(probe(\"W14b\", \"CONTROL: actually delete the CheckReplicable arm (reverse direction)\",\n277|    [(CONF, '''\t\tif class, known := replicationMembers[member]; !known || class != ReplicationSafeEvidence {\n278|\t\t\treturn &Error{Code: CodeProtocolError, Detail: \"replication exclusion\"}\n279|\t\t}''',\n280|      '''\t\tif class, known := replicationMembers[member]; !known || class != ReplicationSafeEvidence {\n281|\t\t\t_ = class\n282|\t\t}''')]))\n283|\n284|# W15: CONTROL for W5b — the same errors.New, but inside a FuncDecl body.\n285|results.append(probe(\"W15\", \"CONTROL for W5b: identical errors.New refusal inside a FuncDecl body\",\n286|    [(TB, TBANCHOR, '''func validateProtocolVersions(backendID string, versions []string) error {\n287|\tif len(versions) == 7777 {\n288|\t\treturn errors.New(\"planted plain refusal\")\n289|\t}''')]))\n290|\n291|# W16: plain error inside a func literal assigned to a package-level var.\n292|results.append(probe(\"W16\", \"plain error inside a package-level `var f = func() error { errors.New(...) }`\",\n293|    [(TB, TBANCHOR, '''var plantedFn = func() error { return errors.New(\"planted plain refusal in a var func literal\") }\n294|\n295|func validateProtocolVersions(backendID string, versions []string) error {\n296|\tif len(versions) == 7777 {\n297|\t\treturn plantedFn()\n298|\t}''')]))\n299|\n300|# W17: *Error arm inside a nested func literal in a FuncDecl (round-1 A4 re-verify).\n301|results.append(probe(\"W17\", \"RE-VERIFY A4: *Error arm inside a nested func literal in a FuncDecl body\",\n302|    [(CONF, ANCHOR, '''func CheckReplicable(members []string) error {\n303|\tcheck := func() *Error { return mismatchf(\"planted nested literal refusal\") }\n304|\tif len(members) == 7777 {\n305|\t\treturn check()\n306|\t}\n307|\tfor _, member := range members {''')]))\n308|\n309|# W18: sanity — does a package-level errors.New var that is NEVER used still pass?\n310|results.append(probe(\"W18\", \"package-level errors.New var declared but never returned\",\n311|    [(TB, TBANCHOR, '''var errUnusedPlant = errors.New(\"planted unused plain refusal\"