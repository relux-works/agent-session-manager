{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c681","stream":{"kind":"session","id":"01a06fb4-3612-7082-aba0-c5e534814a47"},"sequence":411,"recorded_at":1780531400000817,"record_type":"event","durability":"durable","causation_id":"eabad717-3e00-45d4-b352-a95943b57e50","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eabad717-3e00-45d4-b352-a95943b57e50","run_stream":{"kind":"run","id":"eabad717-3e00-45d4-b352-a95943b57e50"},"task_stream":{"kind":"task","id":"055c6328-cfc8-4294-b2c1-df39c536f0ef"},"task_id":"055c6328-cfc8-4294-b2c1-df39c536f0ef","event":{"kind":"output","task_id":"055c6328-cfc8-4294-b2c1-df39c536f0ef","chunk":"Read text file `internal/terminalbackend/conformance.go`.\n(74 line(s) above)\n75|\n76|// IsIncompatibleSchema reports CodeIncompatibleSchema refusals.\n77|func IsIncompatibleSchema(err error) bool { return errorCode(err, CodeIncompatibleSchema) }\n78|\n79|// InstanceState is the closed §4.C TerminalInstanceState enum: local\n80|// hosting only, never a second ownership state machine.\n81|type InstanceState string\n82|\n83|// Terminal Instance states.\n84|const (\n85|\tStateAbsent      InstanceState = \"absent\"\n86|\tStateCreating    InstanceState = \"creating\"\n87|\tStateParked      InstanceState = \"parked\"\n88|\tStateActive      InstanceState = \"active\"\n89|\tStateQuiescing   InstanceState = \"quiescing\"\n90|\tStateStopped     InstanceState = \"stopped\"\n91|\tStateStaleFenced InstanceState = \"stale_fenced\"\n92|\tStateUnavailable InstanceState = \"unavailable\"\n93|)\n94|\n95|// ParseInstanceState admits exactly the eight §4.C states.\n96|func ParseInstanceState(value string) (InstanceState, error) {\n97|\tswitch InstanceState(value) {\n98|\tcase StateAbsent, StateCreating, StateParked, StateActive,\n99|\t\tStateQuiescing, StateStopped, StateStaleFenced, StateUnavailable:\n100|\t\treturn InstanceState(value), nil\n101|\tdefault:\n102|\t\treturn \"\", &Error{Code: CodeProtocolError, Detail: \"lifecycle state vocabulary\"}\n103|\t}\n104|}\n105|\n106|// Operation is the closed §4.D TerminalBackendOperation enum.\n107|type Operation string\n108|\n109|// Terminal backend operations.\n110|const (\n111|\tOperationManifest         Operation = \"manifest\"\n112|\tOperationProbe            Operation = \"probe\"\n113|\tOperationCreate           Operation = \"create\"\n114|\tOperationAttach           Operation = \"attach\"\n115|\tOperationStatus           Operation = \"status\"\n116|\tOperationQuiesceInput     Operation = \"quiesce-input\"\n117|\tOperationWaitSafeBoundary Operation = \"wait-safe-boundary\"\n118|\tOperationRequestStop      Operation = \"request-stop\"\n119|\tOperationTerminateStale   Operation = \"terminate-stale\"\n120|\tOperationRestore          Operation = \"restore\"\n121|)\n122|\n123|// ParseOperation admits exactly the ten §4.D operations.\n124|func ParseOperation(value string) (Operation, error) {\n125|\tswitch Operation(value) {\n126|\tcase OperationManifest, OperationProbe, OperationCreate, OperationAttach,\n127|\t\tOperationStatus, OperationQuiesceInput, OperationWaitSafeBoundary,\n128|\t\tOperationRequestStop, OperationTerminateStale, OperationRestore:\n129|\t\treturn Operation(value), nil\n130|\tdefault:\n131|\t\treturn \"\", &Error{Code: CodeProtocolError, Detail: \"operation vocabulary\"}\n132|\t}\n133|}\n134|\n135|// SideEffect is the closed §4.C TerminalBackendSideEffect enum.\n136|type SideEffect string\n137|\n138|// Terminal backend side effects.\n139|const (\n140|\tEffectBindingPersisted           SideEffect = \"binding_persisted\"\n141|\tEffectWrapperStarted             SideEffect = \"wrapper_started\"\n142|\tEffectAttachClientCreated        SideEffect = \"attach_client_created\"\n143|\tEffectInputClosed                SideEffect = \"input_closed\"\n144|\tEffectSafeBoundaryObserved       SideEffect = \"safe_boundary_observed\"\n145|\tEffectGracefulStopRequested      SideEffect = \"graceful_stop_requested\"\n146|\tEffectProcessClosed              SideEffect = \"process_closed\"\n147|\tEffectBackendStoreClosed         SideEffect = \"backend_store_closed\"\n148|\tEffectStaleIncarnationTerminated SideEffect = \"stale_incarnation_terminated\"\n149|\tEffectWrapperRestored            SideEffect = \"wrapper_restored\"\n150|)\n151|\n152|// PresentationTransport is the closed §4.E presentation transport enum.\n153|// Only the first two are admittable; a relay-required backend is\n154|// unavailable pending explicit future product/contract approval, so no\n155|// constructor admits it here.\n156|type PresentationTransport string\n157|\n158|// Presentation transports.\n159|const (\n160|\tTransportLocalOnly          PresentationTransport = \"local_only\"\n161|\tTransportTrustedPrivateMesh PresentationTransport = \"trusted_private_mesh\"\n162|\tTransportThirdPartyRelay    PresentationTransport = \"third_party_relay\"\n163|)\n164|\n165|// parseTransport admits exactly the closed transport vocabulary. The relay\n166|// member parses so a request naming it is classified rather than\n167|// misreported, but CheckAttachRequest refuses it: current AX admits only\n168|// the first two.\n169|func parseTransport(value string) (PresentationTransport, error) {\n170|\tswitch PresentationTransport(value) {\n171|\tcase TransportLocalOnly, TransportTrustedPrivateMesh, TransportThirdPartyRelay:\n172|\t\treturn PresentationTransport(value), nil\n173|\tdefault:\n174|\t\treturn \"\", &Error{Code: CodeProtocolError, Detail: \"presentation transport vocabulary\"}\n175|\t}\n176|}\n177|\n178|// Authorization kinds carried by the transition table. \"attach\" names the\n179|// ownership-neutral AttachAuthorization below; every other mutating kind\n180|// names an AXAuthorization lease tuple, which this harness does not mint\n181|// (no lease implementation exists here) but does name so the table stays\n182|// exact.\n183|const (\n184|\tauthorizationNone       = \"none\"\n185|\tauthorizationCreate     = \"create\"\n186|\tauthorizationAttach     = \"attach\"\n187|\tauthorizationControl    = \"control\"\n188|\tauthorizationForceStale = \"force_stale\"\n189|\tauthorizationRestore    = \"restore\"\n190|)\n191|\n192|// Transition is one exact §4.C table row: the allowed sources, the success\n193|// target, and the exact side effects for one operation.\n194|type Transition struct {\n195|\tOperation     Operation\n196|\tSources       []InstanceState\n197|\tTarget        InstanceState\n198|\tTargetParked  bool\n199|\tEffects       []SideEffect\n200|\tAuthorization string\n201|\t// InstanceScoped is false for manifest and probe, which carry no\n202|\t// Terminal Instance source or target and no side effects.\n203|\tInstanceScoped bool\n204|\t// SameState marks status: every source is allowed and the success\n205|\t// state is the source itself, with no side effect.\n206|\tSameState bool\n207|}\n208|\n209|// transitionTable is the exact §4.C transition matrix. create carries two\n210|// targets: active when interactive, otherwise parked.\n211|var transitionTable = []Transition{\n212|\t{Operation: OperationManifest, InstanceScoped: false, Authorization: authorizationNone},\n213|\t{Operation: OperationProbe, InstanceScoped: false, Authorization: authorizationNone},\n214|\t{\n215|\t\tOperation: OperationCreate,\n216|\t\tSources:   []InstanceState{StateAbsent, StateStopped},\n217|\t\tTarget:    StateActive, TargetParked: true,\n218|\t\tEffects:        []SideEffect{EffectBindingPersisted, EffectWrapperStarted},\n219|\t\tAuthorization:  authorizationCreate,\n220|\t\tInstanceScoped: true,\n221|\t},\n222|\t{\n223|\t\tOperation:      OperationAttach,\n224|\t\tSources:        []InstanceState{StateParked, StateActive},\n225|\t\tTarget:         StateActive,\n226|\t\tEffects:        []SideEffect{EffectAttachClientCreated},\n227|\t\tAuthorization:  authorizationAttach,\n228|\t\tInstanceScoped: true,\n229|\t},\n230|\t{\n231|\t\tOperation: OperationStatus,\n232|\t\tSources: []InstanceState{\n233|\t\t\tStateAbsent, StateCreating, StateParked, StateActive,\n234|\t\t\tStateQuiescing, StateStopped, StateStaleFenced, StateUnavailable,\n235|\t\t},\n236|\t\tSameState:      true,\n237|\t\tAuthorization:  authorizationNone,\n238|\t\tInstanceScoped: true,\n239|\t},\n240|\t{\n241|\t\tOperation:      OperationQuiesceInput,\n242|\t\tSources:        []InstanceState{StateActive, StateParked},\n243|\t\tTarget:         StateQuiescing,\n244|\t\tEffects:        []SideEffect{EffectInputClosed},\n245|\t\tAuthorization:  authorizationControl,\n246|\t\tInstanceScoped: true,\n247|\t},\n248|\t{\n249|\t\tOperation:      OperationWaitSafeBoundary,\n250|\t\tSources:        []InstanceState{StateQuiescing},\n251|\t\tTarget:         StateQuiescing,\n252|\t\tEffects:        []SideEffect{EffectSafeBoundaryObserved},\n253|\t\tAuthorization:  authorizationControl,\n254|\t\tInstanceScoped: true,\n255|\t},\n256|\t{\n257|\t\tOperation:      OperationRequestStop,\n258|\t\tSources:        []InstanceState{StateQuiescing},\n259|\t\tTarget:         StateStopped,\n260|\t\tEffects:        []SideEffect{EffectGracefulStopRequested, EffectProcessClosed, EffectBackendStoreClosed},\n261|\t\tAuthorization:  authorizationControl,\n262|\t\tInstanceScoped: true,\n263|\t},\n264|\t{\n265|\t\tOperation:      OperationTerminateStale,\n266|\t\tSources:        []InstanceState{StateStaleFenced, StateUnavailable},\n267|\t\tTarget:         StateStopped,\n268|\t\tEffects:        []SideEffect{EffectStaleIncarnationTerminated, EffectProcessClosed},\n269|\t\tAuthorization:  authorizationForceStale,\n270|\t\tInstanceScoped: true,\n271|\t},\n272|\t{\n273|\t\tOperation:      OperationRestore,\n274|\t\tSources:        []InstanceState{StateAbsent, StateStopped, StateUnavailable},\n275|\t\tTarget:         StateParked,\n276|\t\tEffects:        []SideEffect{EffectBindingPersisted, EffectWrapperRestored},\n277|\t\tAuthorization:  authorizationRestore,\n278|\t\tInstanceScoped: true,\n279|\t},\n280|}\n281|\n282|// lookupTransition returns the table row for one operation.\n283|func lookupTransition(operation Operation) (Transition, bool) {\n284|\tfor _, row := range transitionTable {\n285|\t\tif row.Operation == operation {\n286|\t\t\treturn row, true\n287|\t\t}\n288|\t}\n289|\treturn Transition{}, false\n290|}\n291|\n292|// CheckTransition enforces the §4.C transition matrix. It returns the\n293|// success target state and the exact side effects. create resolves its\n294|// target from interactive: active when interactive, otherwise parked. A\n295|// state reached only by AX fencing observation (stale_fenced) is never\n296|// entered here: no backend operation targets it, so a row naming it as a\n297|// target cannot exist and CheckTransition cannot return it except as a\n298|// status observation of the source itself.\n299|//\n300|// An unknown operation or state is a protocol error; a known operation\n301|// against a disallowed source is a failed local precondition. Only\n302|// quiesce-input enters quiescing, and creating is never a success target:\n303|// it exists only between the idempotency receipt and the first side\n304|// effect, which the Ledger below owns.\n305|func CheckTransition(operation, source string, interactive bool) (InstanceState, []SideEffect, error) {\n306|\tparsedOperation, err := ParseOperation(operation)\n307|\tif err != nil {\n308|\t\treturn \"\", nil, err\n309|\t}\n310|\trow, known := lookupTransition(parsedOperation)\n311|\tif !known {\n312|\t\treturn \"\", nil, &Error{Code: CodeProtocolError, Detail: \"operation vocabulary\"}\n313|\t}\n314|\tif !row.InstanceScoped {\n(more lines below)"}}}
