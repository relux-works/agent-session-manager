urn refuseFrame()\n72|\t}\n73|\tfor _, member := range members {''')]))\n74|\n75|# W2: wrapper taking the detail as a parameter (the shape the sibling reviewer named).\n76|results.append(probe(\"W2\", \"wrapper refuseFrame(detail string) -> mismatchf(detail), caller passes a literal\",\n77|    [(CONF, ANCHOR, '''func refuseFrame(detail string) *Error { return mismatchf(detail) }\n78|\n79|func CheckReplicable(members []string) error {\n80|\tif len(members) == 7777 {\n81|\t\treturn refuseFrame(\"planted parametric refusal\")\n82|\t}\n83|\tfor _, member := range members {''')]))\n84|\n85|# W3: wrapper building &Error{} with a parameterised detail.\n86|results.append(probe(\"W3\", \"wrapper returning &Error{Detail: detail} with a parameterised detail\",\n87|    [(CONF, ANCHOR, '''func refuseFrame(detail string) *Error { return &Error{Code: CodeProtocolError, Detail: detail} }\n88|\n89|func CheckReplicable(members []string) error {\n90|\tif len(members) == 7777 {\n91|\t\treturn refuseFrame(\"planted parametric literal refusal\")\n92|\t}\n93|\tfor _, member := range members {''')]))\n94|\n95|# W4: package-level var holding a prebuilt refusal, returned from a switch.\n96|results.append(probe(\"W4\", \"package-level `var plantedRefusal = &Error{...}` returned from a switch\",\n97|    [(CONF, ANCHOR, '''var plantedRefusal = &Error{Code: CodeProtocolError, Detail: \"planted package var refusal\"}\n98|\n99|func CheckReplicable(members []string) error {\n100|\tswitch len(members) {\n101|\tcase 7777:\n102|\t\treturn plantedRefusal\n103|\t}\n104|\tfor _, member := range members {''')]))\n105|\n106|# W5: plain error smuggled through a PACKAGE-LEVEL var (GenDecl), reaching a caller.\n107|results.append(probe(\"W5\", \"package-level `var errPlanted = errors.New(...)` returned from production\",\n108|    [(CONF, ANCHOR, '''var errPlanted = errors.New(\"planted plain refusal\")\n109|\n110|func CheckReplicable(members []string) error {\n111|\tif len(members) == 7777 {\n112|\t\treturn errPlanted\n113|\t}\n114|\tfor _, member := range members {''')]))\n115|\n116|# W6: method on a new type, reached through a package-level method value.\n117|results.append(probe(\"W6\", \"refusal on a method of a new type, reached via a package-level method value\",\n118|    [(CONF, ANCHOR, '''type plantedGuard struct{}\n119|\n120|func (plantedGuard) refuse() *Error { return mismatchf(\"planted method value refusal\") }\n121|\n122|var plantedMethodValue = plantedGuard{}.refuse\n123|\n124|func CheckReplicable(members []string) error {\n125|\tif len(members) == 7777 {\n126|\t\treturn plantedMethodValue()\n127|\t}\n128|\tfor _, member := range members {''')]))\n129|\n130|# W7: arm in a NEW production file carrying a build tag for this platform.\n131|results.append(probe(\"W7\", \"arm in a NEW build-tagged production file (//go:build darwin)\",\n132|    [(CONF, ANCHOR, '''func CheckReplicable(members []string) error {\n133|\tif len(members) == 7777 {\n134|\t\treturn plantedTagged()\n135|\t}\n136|\tfor _, member := range members {''')],\n137|    newfiles=[(\"planted_tagged.go\", '''//go:build darwin\n138|\n139|package terminalbackend\n140|\n141|func plantedTagged() *Error { return mismatchf(\"planted build-tagged refusal\") }\n142|''')]))\n143|\n144|# W8: arm in a NEW production file excluded from THIS build (//go:build linux).\n145|results.append(probe(\"W8\", \"arm in a NEW production file excluded from this build (//go:build linux)\",\n146|    [],\n147|    newfiles=[(\"planted_linux.go\", '''//go:build linux\n148|\n149|package terminalbackend\n150|\n151|func plantedLinuxOnly() *Error { return mismatchf(\"planted excluded-build refusal\") }\n152|''')]))\n153|\n154|# W9: fmt.Errorf smuggled through a package-level var.\n155|results.append(probe(\"W9\", \"package-level `var errPlanted2 = fmt.Errorf(...)` returned from production\",\n156|    [(CONF, ANCHOR, '''var errPlanted2 = fmt.Errorf(\"planted fmt refusal\")\n157|\n158|func CheckReplicable(members []string) error {\n159|\tif len(members) == 7777 {\n160|\t\treturn errPlanted2\n161|\t}\n162|\tfor _, member := range members {''')]))\n163|\n164|# W10: formatted mismatchf — static format string, interpolated local data.\n165|results.append(probe(\"W10\", \"mismatchf with a format verb interpolating local data (existing detail as format)\",\n166|    [(CONF, '''\t\tif class, known := replicationMembers[member]; !known || class != ReplicationSafeEvidence {\n167|\t\t\treturn &Error{Code: CodeProtocolError, Detail: \"replication exclusion\"}''',\n168|      '''\t\tif class, known := replicationMembers[member]; !known || class != ReplicationSafeEvidence {\n169|\t\t\t_ = mismatchf(\"replication exclusion %s\", member)\n170|\t\t\treturn &Error{Code: CodeProtocolError, Detail: \"replication exclusion\"}''')]))\n171|\n172|restore()\n173|json.dump(results, open(\".temp/TASK-260830-1snnef-r2/ga-results.json\", \"w\"), indent=1)\n174|import sys, json\n175|sys.path.insert(0, \".temp/TASK-260830-1snnef-r2\")\n176|from probe import probe, restore\n177|\n178|CONF = \"internal/terminalbackend/conformance.go\"\n179|TB   = \"internal/terminalbackend/terminalbackend.go\"\n180|ANCHOR = '''func CheckReplicable(members []string) error {\n181|\tfor _, member := range members {'''\n182|TBANCHOR = '''func validateProtocolVersions(backendID string, versions []string) error {'''\n183|\n184|results = []\n185|\n186|# W2b: parametric wrapper fronting integrityFailure (plain string arg, no printf vet).\n187|results.append(probe(\"W2b\", \"wrapper refuseFrame(detail string) -> integrityFailure(detail), caller passes a literal\",\n188|    [(CONF, ANCHOR, '''func refuseFrame(detail string) *Error { return integrityFailure(detail) }\n189|\n190|func CheckReplicable(members []string) error {\n191|\tif len(members) == 7777 {\n192|\t\treturn refuseFrame(\"planted parametric refusal\")\n193|\t}\n194|\tfor _, member := range members {''')]))\n195|\n196|# W2c: same wrapper, but the caller's literal reuses an EXISTING declared d