{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb11","stream":{"kind":"session","id":"01a06fb4-3612-7082-aba0-c5e534814a47"},"sequence":995,"recorded_at":1780531400001985,"record_type":"event","durability":"durable","causation_id":"eabad717-3e00-45d4-b352-a95943b57e50","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eabad717-3e00-45d4-b352-a95943b57e50","run_stream":{"kind":"run","id":"eabad717-3e00-45d4-b352-a95943b57e50"},"task_stream":{"kind":"task","id":"fd0df086-942c-4d6e-9507-f689c63ca98d"},"task_id":"fd0df086-942c-4d6e-9507-f689c63ca98d","event":{"kind":"output","task_id":"fd0df086-942c-4d6e-9507-f689c63ca98d","chunk":"edited\nchanged lines: lines 1246-1271\n--- original\n+++ updated\n@@\n-\t// Attachability is a two-state rule over the closed eight-state enum:\n-\t// attachable is admitted only in parked or active with an evidenced\n-\t// attach capability, and refused in each of the other six states, so\n-\t// widening the admitted set by one member reddens here. The enum is\n-\t// restated in full — a sample naming one excluded state would prove\n-\t// the shape, not the rule.\n-\tfor _, state := range []string{\n-\t\t\"absent\", \"creating\", \"quiescing\",\n-\t\t\"stopped\", \"stale_fenced\", \"unavailable\",\n-\t} {\n-\t\texcluded := matched\n-\t\texcluded.State = terminalbackend.InstanceState(state)\n-\t\trequireConformanceRefusal(t,\n-\t\t\tterminalbackend.CheckStatusResult(true, excluded),\n-\t\t\t\"local_precondition_failed\", \"status attachability\")\n-\t}\n-\tfor _, state := range []string{\"parked\", \"active\"} {\n-\t\tadmitted := matched\n-\t\tadmitted.State = terminalbackend.InstanceState(state)\n-\t\tadmitted.ProviderPresent = nil\n-\t\tadmitted.ProviderRequested = false\n-\t\tadmitted.ProviderEvidenced = false\n-\t\tif err := terminalbackend.CheckStatusResult(true, admitted); err != nil {\n-\t\t\tt.Errorf(\"CheckStatusResult(%s, evidenced) error = %v, want admission\", state, err)\n-\t\t}\n-\t}\n+\t// Attachability is a two-state rule over the closed state enum, and\n+\t// the complement is derived, not sampled: every state the production\n+\t// parser admits (derived from its switch-case list, pinned by\n+\t// TestDerivedVocabulariesAreExactlyTheAdmittedSets) outside\n+\t// parked/active is refused with evidenced attach capability held, so\n+\t// widening the admitted set by one member reddens here. A sample\n+\t// naming one excluded state would prove the shape, not the rule.\n+\tstates := derivedParserVocabulary(t, \"conformance.go\", \"ParseInstanceState\")\n+\tif len(states) != 8 {\n+\t\tt.Fatalf(\"derived %d instance states, want the closed eight; \"+\n+\t\t\t\"the attachability complement cannot be derived\", len(states))\n+\t}\n+\tfor _, state := range states {\n+\t\tprobe := matched\n+\t\tprobe.State = terminalbackend.InstanceState(state)\n+\t\tswitch state {\n+\t\tcase \"parked\", \"active\":\n+\t\t\tprobe.ProviderPresent = nil\n+\t\t\tprobe.ProviderRequested = false\n+\t\t\tprobe.ProviderEvidenced = false\n+\t\t\tif err := terminalbackend.CheckStatusResult(true, probe); err != nil {\n+\t\t\t\tt.Errorf(\"CheckStatusResult(%s, evidenced) error = %v, want admission\", state, err)\n+\t\t\t}\n+\t\tdefault:\n+\t\t\trequireConformanceRefusal(t,\n+\t\t\t\tterminalbackend.CheckStatusResult(true, probe),\n+\t\t\t\t\"local_precondition_failed\", \"status attachability\")\n+\t\t}\n+\t}\n"}}}
