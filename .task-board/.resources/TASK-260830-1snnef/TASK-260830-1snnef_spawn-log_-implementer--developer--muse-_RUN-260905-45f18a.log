{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5f1","stream":{"kind":"session","id":"01a06fb4-3612-7082-aba0-c5e534814a47"},"sequence":339,"recorded_at":1780531400000673,"record_type":"event","durability":"durable","causation_id":"eabad717-3e00-45d4-b352-a95943b57e50","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eabad717-3e00-45d4-b352-a95943b57e50","run_stream":{"kind":"run","id":"eabad717-3e00-45d4-b352-a95943b57e50"},"task_stream":{"kind":"task","id":"fbba09cf-ab9d-4c98-92de-062638446025"},"task_id":"fbba09cf-ab9d-4c98-92de-062638446025","event":{"kind":"output","task_id":"fbba09cf-ab9d-4c98-92de-062638446025","chunk":"Read text file `internal/terminalbackend/conformance_test.go`.\n(523 line(s) above)\n524|func TestCheckErrorAllowedAdmitsEverySpecRowCode(t *testing.T) {\n525|\tt.Parallel()\n526|\n527|\tif len(allowedErrorCodesByOperation) != len(conformanceOperations) {\n528|\t\tt.Fatalf(\"mirror covers %d operations, want all %d; a missing row admits vacuously\",\n529|\t\t\tlen(allowedErrorCodesByOperation), len(conformanceOperations))\n530|\t}\n531|\tfor _, operation := range conformanceOperations {\n532|\t\tcodes, known := allowedErrorCodesByOperation[operation]\n533|\t\tif !known || len(codes) == 0 {\n534|\t\t\tt.Fatalf(\"mirror has no row for operation %q; a missing row admits vacuously\", operation)\n535|\t\t}\n536|\t\tfor _, code := range codes {\n537|\t\t\tif err := terminalbackend.CheckErrorAllowed(operation, code); err != nil {\n538|\t\t\t\tt.Errorf(\"CheckErrorAllowed(%q, %q) error = %v, want admission\",\n539|\t\t\t\t\toperation, code, err)\n540|\t\t\t}\n541|\t\t}\n542|\t}\n543|}\n544|\n545|// TestCheckErrorAllowedRefusesEveryUnlistedCode is the narrowing arm of\n546|// the error mapping, derived as the complement — not a sample. For every\n547|// operation, every code in the pinned catalog error vocabulary\n548|// (catalog.Current().Errors) that the mirror row withholds must be\n549|// refused with the operation-vocabulary arm, so a widened production row\n550|// reddens here. In particular terminal_backend_unavailable is refused for\n551|// quiesce-input, wait-safe-boundary, request-stop, and terminate-stale,\n552|// the four rows that withhold it.\n553|func TestCheckErrorAllowedRefusesEveryUnlistedCode(t *testing.T) {\n554|\tt.Parallel()\n555|\n556|\tvar catalogued []string\n557|\tcataloguedSet := map[string]bool{}\n558|\tfor _, entry := range catalog.Current().Errors {\n559|\t\tcode := string(entry.Code)\n560|\t\tcatalogued = append(catalogued, code)\n561|\t\tcataloguedSet[code] = true\n562|\t}\n563|\tif len(catalogued) == 0 {\n564|\t\tt.Fatal(\"pinned catalog carries zero error codes; the complement proves nothing\")\n565|\t}\n566|\t// The mirror must live inside the catalog: a mirror code outside the\n567|\t// pinned vocabulary would be admitted without ever entering the\n568|\t// complement domain, and the bijection below would prove nothing.\n569|\tfor _, operation := range conformanceOperations {\n570|\t\tfor _, code := range allowedErrorCodesByOperation[operation] {\n571|\t\t\tif !cataloguedSet[code] {\n572|\t\t\t\tt.Errorf(\"mirror row %q admits %q, outside the pinned catalog vocabulary; \"+\n573|\t\t\t\t\t\"the complement cannot pin what it cannot name\", operation, code)\n574|\t\t\t}\n575|\t\t}\n576|\t}\n577|\n578|\tfor _, operation := range conformanceOperations {\n579|\t\tallowed := map[string]bool{}\n580|\t\tfor _, code := range allowedErrorCodesByOperation[operation] {\n581|\t\t\tallowed[code] = true\n582|\t\t}\n583|\t\tfor _, code := range catalogued {\n584|\t\t\tif allowed[code] {\n585|\t\t\t\tcontinue\n586|\t\t\t}\n587|\t\t\terr := terminalbackend.CheckErrorAllowed(operation, code)\n588|\t\t\trequireConformanceRefusal(t, err,\n589|\t\t\t\t\"terminal_backend_protocol_error\", \"operation error vocabulary\")\n590|\t\t}\n591|\t}\n592|\n593|\t// Codes outside any vocabulary are an unbounded string domain, so no\n594|\t// test can close them; these probes pin the shape (unknown strings\n595|\t// refuse) without claiming the closure the catalog complement gives.\n596|\tfor _, operation := range conformanceOperations {\n597|\t\tfor _, code := range []string{\"\", \"bogus_code\", \"terminal_backend_bogus\"} {\n598|\t\t\terr := terminalbackend.CheckErrorAllowed(operation, code)\n599|\t\t\trequireConformanceRefusal(t, err,\n600|\t\t\t\t\"terminal_backend_protocol_error\", \"operation error vocabulary\")\n601|\t\t}\n602|\t}\n603|\n604|\tif err := terminalbackend.CheckErrorAllowed(\"launch\", \"terminal_backend_timeout\"); err == nil {\n605|\t\tt.Errorf(\"CheckErrorAllowed(launch, ...) = nil, want operation vocabulary refusal\")\n606|\t} else {\n607|\t\trequireConformanceRefusal(t, err,\n608|\t\t\t\"terminal_backend_protocol_error\", \"operation vocabulary\")\n609|\t}\n610|}\n611|\n612|// TestIdempotencyKeyDerivesCanonicalForms proves the per-operation key\n613|// shapes of §4.C and §4.1: the key is derived, never caller-chosen free\n614|// text, and the segment order is fixed.\n615|func TestIdempotencyKeyDerivesCanonicalForms(t *testing.T) {\n616|\tt.Parallel()\n617|\n618|\tcases := []struct {\n619|\t\toperation string\n620|\t\tsegments  []string\n621|\t\twant      string\n622|\t}{\n623|\t\t{\"manifest\", []string{\"req-1\"}, \"req-1\"},\n624|\t\t{\"probe\", []string{\"req-2\"}, \"req-2\"},\n625|\t\t{\"create\", []string{conformanceSessionA, \"bootstrap-1\"},\n626|\t\t\tconformanceSessionA + \"/bootstrap-1\"},\n627|\t\t{\"restore\", []string{conformanceSessionA, \"bootstrap-2\"},\n628|\t\t\tconformanceSessionA + \"/bootstrap-2\"},\n629|\t\t{\"attach\", []string{\"instance-1\", \"client-1\"}, \"instance-1/client-1\"},\n630|\t\t{\"quiesce-input\", []string{\"instance-1\", \"quiesce\", \"gen-1\"},\n631|\t\t\t\"instance-1/quiesce/gen-1\"},\n632|\t\t{\"wait-safe-boundary\",\n633|\t\t\t[]string{\"instance-1\", \"boundary\", \"gen-1\", \"provider_quiescence\"},\n634|\t\t\t\"instance-1/boundary/gen-1/provider_quiescence\"},\n635|\t\t{\"request-stop\", []string{\"instance-1\", \"stop\", \"sha256:abc\"},\n636|\t\t\t\"instance-1/stop/sha256:abc\"},\n637|\t\t{\"terminate-stale\",\n638|\t\t\t[]string{\"instance-1\", \"terminate\", \"lease-1\", \"41\"},\n639|\t\t\t\"instance-1/terminate/lease-1/41\"},\n640|\t\t{\"status\", []string{conformanceSessionA}, conformanceSessionA},\n641|\t\t{\"status\",\n642|\t\t\t[]string{conformanceSessionA, \"instance-1\", \"ax.tmux\", \"1.2.3\", \"1.0.0\", \"gen-1\"},\n643|\t\t\tconformanceSessionA + \"/instance-1/ax.tmux/1.2.3/1.0.0/gen-1\"},\n644|\t}\n645|\tfor _, tc := range cases {\n646|\t\tgot, err := terminalbackend.IdempotencyKey(tc.operation, tc.segments...)\n647|\t\tif err != nil {\n648|\t\t\tt.Errorf(\"IdempotencyKey(%q, %v) error = %v, want admission\",\n649|\t\t\t\ttc.operation, tc.segments, err)\n650|\t\t\tcontinue\n651|\t\t}\n652|\t\tif got != tc.want {\n653|\t\t\tt.Errorf(\"IdempotencyKey(%q, %v) = %q, want %q\",\n654|\t\t\t\ttc.operation, tc.segments, got, tc.want)\n655|\t\t}\n656|\t}\n657|}\n658|\n659|// TestIdempotencyKeyRefusesWrongShapes narrows the key gate: a wrong\n660|// segment count or an empty segment is a protocol error, so a key that\n661|// collapses two windows into one cannot be derived.\n662|func TestIdempotencyKeyRefusesWrongShapes(t *testing.T) {\n663|\tt.Parallel()\n664|\n665|\tcases := []struct {\n666|\t\toperation string\n667|\t\tsegments  []string\n668|\t}{\n669|\t\t{\"manifest\", nil},\n670|\t\t{\"manifest\", []string{\"a\", \"b\"}},\n671|\t\t{\"probe\", nil},\n672|\t\t{\"create\", []string{\"only-session\"}},\n673|\t\t{\"create\", []string{\"a\", \"b\", \"c\"}},\n674|\t\t{\"restore\", []string{\"only-session\"}},\n675|\t\t{\"attach\", []string{\"only-instance\"}},\n676|\t\t{\"attach\", []string{\"a\", \"b\", \"c\"}},\n677|\t\t{\"quiesce-input\", []string{\"instance-1\", \"quiesce\"}},\n678|\t\t{\"request-stop\", []string{\"instance-1\", \"stop\"}},\n679|\t\t{\"wait-safe-boundary\", []string{\"instance-1\", \"boundary\", \"gen-1\"}},\n680|\t\t{\"terminate-stale\", []string{\"instance-1\", \"terminate\", \"lease-1\"}},\n681|\t\t{\"status\", nil},\n682|\t\t{\"create\", []string{\"\", \"bootstrap-1\"}},\n683|\t\t{\"attach\", []string{\"instance-1\", \"\"}},\n(more lines below)"}}}
