(true, admitted); err != nil {\n1248|\t\t\tt.Errorf(\"CheckStatusResult(%s, evidenced) error = %v, want admission\", state, err)\n1249|\t\t}\n1250|\t}\n1251|\tparked := matched\n1252|\tparked.State = \"parked\"\n1253|\tparked.ProviderPresent = nil\n1254|\tparked.ProviderRequested = false\n1255|\tparked.ProviderEvidenced = false\n1256|\tif err := terminalbackend.CheckStatusResult(true, parked); err != nil {\n1257|\t\tt.Errorf(\"CheckStatusResult(parked, evidenced) error = %v, want admission\", err)\n1258|\t}\n1259|\tunproven := matched\n1260|\tunproven.AttachEvidenced = false\n1261|\trequireConformanceRefusal(t,\n1262|\t\tterminalbackend.CheckStatusResult(true, unproven),\n1263|\t\t\"local_precondition_failed\", \"status attachability\")\n1264|\n1265|\t// An unknown state or effect is a vocabulary refusal, never a pass.\n1266|\tbogus := matched\n1267|\tbogus.State = \"running\"\n1268|\trequireConformanceRefusal(t,\n1269|\t\tterminalbackend.CheckStatusResult(true, bogus),\n1270|\t\t\"terminal_backend_protocol_error\", \"lifecycle state vocabulary\")\n1271|\tbogusEffect := terminalbackend.SideEffect(\"side_effect_unknown\")\n1272|\tbogus = matched\n1273|\tbogus.LastEffect = &bogusEffect\n1274|\trequireConformanceRefusal(t,\n1275|\t\tterminalbackend.CheckStatusResult(true, bogus),\n1276|\t\t\"terminal_backend_protocol_error\", \"side effect vocabulary\")\n1277|}\n1278|\n1279|// TestReplicationClassificationIsClosed pins the whole §4.E table: every\n1280|// listed member classifies exactly once, and the classes are disjoint.\n1281|// Moving one member between classes reddens here before any replication\n1282|// decision can silently change.\n1283|func TestReplicationClassificationIsClosed(t *testing.T) {\n1284|\tt.Parallel()\n(more lines below)"}}}
