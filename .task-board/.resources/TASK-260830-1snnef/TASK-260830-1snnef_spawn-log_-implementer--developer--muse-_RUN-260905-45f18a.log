{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6a9","stream":{"kind":"session","id":"01a06fb4-3612-7082-aba0-c5e534814a47"},"sequence":431,"recorded_at":1780531400000857,"record_type":"event","durability":"durable","causation_id":"eabad717-3e00-45d4-b352-a95943b57e50","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"eabad717-3e00-45d4-b352-a95943b57e50","run_stream":{"kind":"run","id":"eabad717-3e00-45d4-b352-a95943b57e50"},"call_id":"call_01a06fb6a95d75e0900c421ee5678759","text":"Read text file `internal/terminalbackend/conformance.go`.\n(739 line(s) above)\n740|// provider null, attachable false, and both last fields null, and does\n741|// not authorize fallback: any deviation from that canonical false form\n742|// is refused. provider_present is null unless provider observation was\n743|// requested and evidenced. attachable is true only in parked or active\n744|// with a currently evidenced matching attach capability. A timeout or\n745|// read failure is unknown, never absent: this check validates reported\n746|// results and never synthesizes absence from a missing read.\n747|func CheckStatusResult(identityMatch bool, result StatusResult) error {\n748|\tif _, err := ParseInstanceState(string(result.State)); err != nil {\n749|\t\treturn err\n750|\t}\n751|\tif result.LastEffect != nil {\n752|\t\tif _, err := ParseSideEffect(string(*result.LastEffect)); err != nil {\n753|\t\t\treturn err\n754|\t\t}\n755|\t}\n756|\tif !identityMatch || !result.IdentityMatch {\n757|\t\tif result.IdentityMatch {\n758|\t\t\treturn &Error{Code: CodeProtocolError, Detail: \"status identity binding\"}\n759|\t\t}\n760|\t\tif result.State != StateAbsent || result.WrapperPresent ||\n761|\t\t\tresult.ProviderPresent != nil || result.Attachable ||\n762|\t\t\tresult.LastOperationID != nil || result.LastEffect != nil {\n763|\t\t\treturn &Error{Code: CodeProtocolError, Detail: \"status identity binding\"}\n764|\t\t}\n765|\t\treturn nil\n766|\t}\n767|\tif result.ProviderPresent != nil && !(result.ProviderRequested && result.ProviderEvidenced) {\n768|\t\treturn &Error{Code: CodeProtocolError, Detail: \"status provider observation\"}\n769|\t}\n770|\tif result.Attachable && !((result.State == StateParked || result.State == StateActive) && result.AttachEvidenced) {\n771|\t\treturn &Error{Code: CodePreconditionFailed, Detail: \"status attachability\"}\n772|\t}\n773|\treturn nil\n774|}\n775|\n776|// ParseSideEffect admits exactly the ten §4.C side effects.\n777|func ParseSideEffect(value string) (SideEffect, error) {\n778|\tswitch SideEffect(value) {\n779|\tcase EffectBindingPersisted, EffectWrapperStarted, EffectAttachClientCreated,\n780|\t\tEffectInputClosed, EffectSafeBoundaryObserved, EffectGracefulStopRequested,\n781|\t\tEffectProcessClosed, EffectBackendStoreClosed,\n782|\t\tEffectStaleIncarnationTerminated, EffectWrapperRestored:\n783|\t\treturn SideEffect(value), nil\n784|\tdefault:\n785|\t\treturn \"\", &Error{Code: CodeProtocolError, Detail: \"side effect vocabulary\"}\n786|\t}\n787|}\n788|\n789|// ReplicationClass is the §4.E persistence classification. Only\n790|// safe_evidence MAY persist and replicate after validation; every other\n791|// class is host-local, rebuildable, owner-only, or forbidden.\n792|type ReplicationClass string\n793|\n794|// Replication classes.\n795|const (\n796|\tReplicationSafeEvidence       ReplicationClass = \"safe_evidence\"\n797|\tReplicationHostLocal          ReplicationClass = \"host_local\"\n798|\tReplicationDerivedCache       ReplicationClass = \"derived_cache\"\n799|\tReplicationSensitiveOwnerOnly ReplicationClass = \"sensitive_owner_only\"\n800|\tReplicationForbidden          ReplicationClass = \"forbidden\"\n801|)\n802|\n803|// replicationMembers is the closed §4.E classification table. Member\n804|// names are wire vocabulary, never local data: classifying a member the\n805|// table does not know is refused rather than defaulted.\n806|var replicationMembers = buildReplicationMembers()\n807|\n808|// buildReplicationMembers assembles the closed §4.E classification table.\n809|// Member names are wire vocabulary, never local data: classifying a member\n810|// the table does not know is refused rather than defaulted.\n811|func buildReplicationMembers() map[string]ReplicationClass {\n812|\t// Safe immutable evidence: sanitized backend identity, versions,\n813|\t// platform, conformance, and capability evidence MAY persist and\n814|\t// replicate after validation.\n815|\tsafe := []string{\n816|\t\t\"manifest_id\", \"probe_id\", \"evidence_id\",\n817|\t\t\"terminal_backend_id\", \"implementation_version\",\n818|\t\t\"protocol_version\", \"protocol_versions\",\n819|\t\t\"platform\", \"platforms\", \"os_version\",\n820|\t\t\"conformance_fixture_id\", \"capability_claims\", \"evidence_ids\",\n821|\t\t\"backend_generation_digest\", \"capability\", \"dependent_operations\",\n822|\t\t\"evidence_requirements\", \"facts\", \"issuer\", \"issuer_id\",\n823|\t\t\"observed_at\", \"expires_at\",\n824|\t}\n825|\t// Host-local durable metadata: instance/binding IDs, sanitized native\n826|\t// reference, generation, idempotency receipt, last effect.\n827|\thostLocal := []string{\n828|\t\t\"binding_id\", \"terminal_instance_id\", \"session_id\",\n829|\t\t\"host_id\", \"host_incarnation_id\", \"backend_generation\",\n830|\t\t\"native_reference\", \"idempotency_receipt\", \"last_effect\",\n831|\t\t\"last_operation_id\", \"supersedes_binding_id\", \"created_at\",\n832|\t}\n833|\t// Derived cache: discovery, availability, attachability, and process\n834|\t// observations with probe views; rebuildable, non-authoritative.\n835|\tderived := []string{\n836|\t\t\"availability\", \"attachable\", \"wrapper_present\", \"provider_present\",\n837|\t\t\"identity_match\", \"state\", \"probed_at\",\n838|\t}\n839|\t// Sensitive runtime state: IPC, sockets, pipes, attach/relay\n840|\t// credentials, backend auth and live databases, GUI/login\n841|\t// attestations, provider credentials; owner-only, non-replicable.\n842|\tsensitive := []string{\n843|\t\t\"attach_descriptor\", \"ipc_handle\", \"tmux_socket\",\n844|\t\t\"named_pipe\", \"attach_credential\", \"relay_credential\",\n845|\t\t\"backend_auth\", \"auth_database\", \"gui_attestation\",\n846|\t\t\"login_attestation\", \"provider_credential\", \"evidence_secret\",\n847|\t\t\"environment_values\",\n848|\t}\n849|\t// Forbidden: raw native reference, PID/handle, endpoint/token,\n850|\t// terminal output/scrollback, unrestricted environment, credential\n851|\t// detail, and live-process facts MUST NOT replicate.\n852|\tforbidden := []string{\n853|\t\t\"native_pid\", \"process_handle\", \"endpoint\", \"token\",\n854|\t\t\"terminal_output\", \"scrollback\", \"unrestricted_environment\",\n855|\t\t\"credential_detail\", \"live_process_fact\", \"raw_native_reference\",\n856|\t}\n857|\ttable := make(map[string]ReplicationClass,\n858|\t\tlen(safe)+len(hostLocal)+len(derived)+len(sensitive)+len(forbidden))\n859|\tfor _, member := range safe {\n860|\t\ttable[member] = ReplicationSafeEvidence\n861|\t}\n862|\tfor _, member := range hostLocal {\n863|\t\ttable[member] = ReplicationHostLocal\n864|\t}\n865|\tfor _, member := range derived {\n866|\t\ttable[member] = ReplicationDerivedCache\n867|\t}\n868|\tfor _, member := range sensitive {\n869|\t\ttable[member] = ReplicationSensitiveOwnerOnly\n870|\t}\n871|\tfor _, member := range forbidden {\n872|\t\ttable[member] = ReplicationForbidden\n873|\t}\n874|\treturn table\n875|}\n876|\n877|// Import rebuilds a ledger from Export bytes. A truncated, malformed, or\n878|// ambiguous image is an error, never an empty table, so a failed read\n879|// cannot masquerade as proven absence. An empty image rebuilds the empty\n880|// table, which is exactly what Export of a fresh ledger produces.\n881|func ImportLedger(image []byte) (*Ledger, error) {\n882|\tlines := strings.Split(string(image), \"\\n\")\n883|\tif len(lines) > 0 && lines[len(lines)-1] == \"\" {\n884|\t\tlines = lines[:len(lines)-1]\n885|\t}\n886|\tif len(lines)%3 != 0 {\n887|\t\treturn nil, &Error{Code: CodeProtocolError, Detail: \"idempotency ledger image\"}\n888|\t}\n889|\tledger := NewLedger()\n890|\tfor index := 0; index < len(lines); index += 3 {\n891|\t\tkey, operation, resultID := lines[index], lines[index+1], lines[index+2]\n892|\t\tif key == \"\" || resultID == \"\" {\n893|\t\t\treturn nil, &Error{Code: CodeProtocolError, Detail: \"idempotency ledger image\"}\n894|\t\t}\n895|\t\tparsed, err := ParseOperation(operation)\n896|\t\tif err != nil {\n897|\t\t\treturn nil, &Error{Code: CodeProtocolError, Detail: \"idempotency ledger image\"}\n898|\t\t}\n899|\t\tif _, duplicate := ledger.receipts[key]; duplicate {\n900|\t\t\treturn nil, &Error{Code: CodeIdempotencyMismatch, Detail: \"idempotency ledger image\"}\n901|\t\t}\n902|\t\tledger.receipts[key] = Receipt{Key: key, Operation: parsed, ResultID: resultID}\n903|\t}\n904|\treturn ledger, nil\n905|}\n906|\n907|// ClassifyReplication reports the §4.E persistence class of one wire\n908|// member. An unlisted member reports false: the table is closed, and an\n909|// unknown member is refused rather than defaulted into any class.\n910|func ClassifyReplication(member string) (ReplicationClass, bool) {\n911|\tclass, known := replicationMembers[member]\n912|\treturn class, known\n913|}\n914|\n915|// CheckReplicable refuses a replication set carrying any member outside\n916|// the safe immutable evidence class, or any member the closed table does\n917|// not know. Host-local metadata, derived cache, sensitive runtime state,\n918|// and forbidden members MUST NOT replicate; unknown members fail the\n919|// same way, because an unclassified member replicating by default would\n920|// silently widen the §4.E exclusion. An empty set replicates nothing and\n921|// is admitted. The refusal is a protocol error: the set is a body\n922|// variant the replication contract does not cover.\n923|func CheckReplicable(members []string) error {\n924|\tfor _, member := range members {\n925|\t\tif class, known := replicationMembers[member]; !known || class != ReplicationSafeEvidence {\n926|\t\t\treturn &Error{Code: CodeProtocolError, Detail: \"replication exclusion\"}\n927|\t\t}\n928|\t}\n929|\treturn nil\n930|}\n931|\n932|// LegacyUnreported is the version and generation a historical v0.4.3\n933|// translation carries. The past reported no versions and no generation,\n934|// so the translation says exactly that instead of inferring values no\n935|// observation supports.\n936|const LegacyUnreported = \"legacy_unreported\"\n937|\n938|// LegacyBinding is the §4.E forward translation of one historical v0.4.3\n939|// backend identity: the canonical backend ID with unreported version and\n940|// generation. It carries no capability field of any kind: a translation\n941|// MUST NOT infer capabilities the historical record never evidenced, and\n942|// a struct that cannot name them cannot smuggle them. The field count is\n943|// pinned by TestLegacyBindingCarriesNoCapabilities.\n944|type LegacyBinding struct {\n945|\tBackendID             string\n946|\tImplementationVersion string\n947|\tGeneration            string\n948|}\n949|\n950|// legacyForward is the exact §4.E forward map. Only the two immutable\n951|// v0.4.3 values translate; anything else is incompatible, never fallback.\n952|var legacyForward = map[string]string{\n953|\t\"tmux\":   BuiltinTmux,\n954|\t\"conpty\": BuiltinConpty,\n955|}\n956|\n957|// TranslateLegacyBackend deterministically maps a historical v0.4.3\n958|// backend name to its canonical binding. Version and generation are\n959|// legacy_unreported and no capabilities are inferred. Translation is a\n960|// pure function over its argument: it never rewrites or re-digests\n961|// history, and the input is unchanged by construction.\n962|func TranslateLegacyBackend(legacy string) (LegacyBinding, error) {\n963|\tcanonical, known := legacyForward[legacy]\n964|\tif !known {\n965|\t\treturn LegacyBinding{}, &Error{Code: CodeIncompatibleSchema, Detail: \"legacy backend identity\"}\n966|\t}\n967|\treturn LegacyBinding{\n968|\t\tBackendID:             canonical,\n969|\t\tImplementationVersion: LegacyUnreported,\n970|\t\tGeneration:            LegacyUnreported,\n971|\t}, nil\n972|}\n973|\n974|// ProjectToLegacy is the §4.E reverse projection. It exists only for the\n975|// two canonical built-ins; every other backend ID, including a\n976|// well-formed third-party ID, returns incompatible_schema, never a\n977|// fallback. A malformed identity is not an ID at all and is refused by\n978|// the registry grammar first.\n979|func ProjectToLegacy(backendID string) (string, error) {\n980|\tif _, err := ParseID(backendID); err != nil {\n981|\t\treturn \"\", err\n982|\t}\n983|\tfor legacy, canonical := range legacyForward {\n984|\t\tif backendID == canonical {\n985|\t\t\treturn legacy, nil\n986|\t\t}\n987|\t}\n988|\treturn \"\", &Error{Code: CodeIncompatibleSchema, Detail: \"legacy reverse projection\"}\n989|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
