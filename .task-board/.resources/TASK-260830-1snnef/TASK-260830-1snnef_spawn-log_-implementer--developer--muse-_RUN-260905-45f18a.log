Generation\", \"CodeStaleGeneration\", \"backend_generation bound\", 1, \"CheckProviderDescriptor\", \"\", nil, []refusalTestRef{{file: \"terminalbackend_test.go\", test: \"TestCheckProviderDescriptorGenerationBounds\"}}},\n710|\t{\"terminalbackend.go\", \"parseKind\", \"CodeNotFound\", \"implementation_kind vocabulary\", 1, \"parseKind\", \"\", nil, []refusalTestRef{{file: \"internal_pin_test.go\", test: \"TestParseKindAdmitsOnlyTheClosedVocabulary\"}}},\n711|\t{\"terminalbackend.go\", \"validateProtocolVersions\", \"CodeDrift\", \"protocol_versions bound\", 1, \"New\", \"\", nil, []refusalTestRef{{file: \"terminalbackend_test.go\", test: \"TestNewRefusesBadVersionTuples\"}}},\n712|\t{\"terminalbackend.go\", \"validateProtocolVersions\", \"CodeDrift\", \"protocol_versions major 1\", 1, \"RegisterExternal\", \"\", nil, []refusalTestRef{{file: \"terminalbackend_test.go\", test: \"TestRegisterExternalRefusals\"}}},\n713|\t{\"terminalbackend.go\", \"validateProtocolVersions\", \"CodeDrift\", \"protocol_versions sorted unique\", 1, \"New\", \"\", nil, []refusalTestRef{{file: \"terminalbackend_test.go\", test: \"TestNewRefusesBadVersionTuples\"}}},\n714|}\n715|\n716|// funneledPlatformDetails is the exact error set validatePlatforms can\n717|// produce, funneled through the single Registration.validate arm below.\n718|// TestPlatformFunnelDetailsAreExactlyThese derives the set from the\n719|// production AST and requires equality, so a fourth platform error is a\n720|// red rather than a silently widened funnel.\n721|var funneledPlatformDetails = []string{\n722|\t\"platforms bound\",\n723|\t\"platforms vocabulary\",\n724|\t\"platforms sorted unique\",\n725|}\n726|\n727|// funneledPlatformArm declares the single dynamic-detail arm. Its tests\n728|// must mention every funneled detail, not just one of them.\n729|var funneledPlatformArm = declaredRefusalArm{\n730|\tfile: \"terminalbackend.go\", function: \"Registration.validate\",\n731|\tcode: \"CodeNotFound\", detail: passthroughDetail, occurrence: 1,\n732|\tentry: \"RegisterExternal\",\n733|\ttests: []refusalTestRef{{file: \"terminalbackend_test.go\", test: \"TestRegisterExternalRefusesPlatformViolations\"}},\n734|}\n735|\n736|// armlessCodes names wire codes with no refusal arm by design.\n737|// CodeUnavailable appears only inside the allowed-error sets; no\n738|// conformance refusal emits it, so it carries no arm of its own.\n739|var armlessCodes = map[string]bool{\n740|\t\"CodeUnavailable\": true,\n741|}\n742|\n743|// plainErrorFunctions names the only production functions allowed to\n744|// construct non-wire errors. validatePlatforms feeds the pinned funnel;\n745|// DigestFile reports I/O failures that must never be wire errors.\n746|var plainErrorFunctions = map[string]bool{\n747|\t\"validatePlatforms\": true,\n748|\t\"DigestFile\":        true,\n749|}\n750|\n751|// TestDerivedRefusalArmsAreAllDeclared is the forward direction: every\n752|// arm the production AST derives resolves to exactly one declared row.\n753|// A brand-new arm with a brand-new detail fails here until its witness\n754|// is recorded.\n755|func TestDerivedRefusalArmsAreAllDeclared(t *testing.T) {\n756|\tt.Parallel()\n757|\n758|\tderived := deriveRefusalArms(t)\n759|\trows := declaredRows()\n760|\tmatched := make([]bool, len(derived))\n761|\tfor _, row := range rows {\n762|\t\tmatches := []int{}\n763|\t\tfor index, arm := range derived {\n764|\t\t\tif armMatchesRow(arm, row) {\n765|\t\t\t\tmatches = append(matches, index)\n766|\t\t\t}\n767|\t\t}\n768|\t\tif len(matches) != 1 {\n769|\t\t\tt.Errorf(\"declared row %s resolves to %d derived arms, want exactly one\",\n770|\t\t\t\tdescribeRow(row), len(matches))\n771|\t\t\tcontinue\n772|\t\t}\n773|\t\tif matched[matches[0]] {\n774|\t\t\tt.Errorf(\"declared row %s claims an arm an earlier row already claimed: %s\",\n775|\t\t\t\tdescribeRow(row), describeArm(derived[matches[0]]))\n776|\t\t\tcontinue\n777|\t\t}\n778|\t\tmatched[matches[0]] = true\n779|\t}\n780|\tfor index, claimed := range matched {\n781|\t\tif !claimed {\n782|\t\t\tt.Errorf(\"derived arm has no declaring row, so nothing witnesses it: %s\",\n783|\t\t\t\tdescribeArm(derived[index]))\n784|\t\t}\n785|\t}\n786|}\n787|\n788|// TestDeclaredRefusalArmsAreAllDerived is the reverse direction: every\n789|// declared row resolves to exactly one derived arm. Without it the\n790|// forward direction passes vacuously on a truncated derivation, and a\n791|// deleted production guard lingers as a row pointing at nothing.\n792|func TestDeclaredRefusalArmsAreAllDerived(t *testing.T) {\n793|\tt.Parallel()\n794|\n795|\tderived := deriveRefusalArms(t)\n796|\tfor _, row := range declaredRows() {\n797|\t\tmatches := 0\n798|\t\tfor _, arm := range derived {\n799|\t\t\tif armMatchesRow(arm, row) {\n800|\t\t\t\tmatches++\n801|\t\t\t}\n802|\t\t}\n803|\t\tif matches != 1 {\n804|\t\t\tt.Errorf(\"declared row %s matches %d derived arms, want exactly one; \"+\n805|\t\t\t\t\"a row without an arm is a witness without a guard\", describeRow(row), matches)\n806|\t\t}\n807|\t}\n808|\tif len(derived) != len(declaredRows()) {\n809|\t\tt.Errorf(\"derived %d arms but declared %d rows; the table is not a bijection\",\n810|\t\t\tlen(derived), len(declaredRows()))\n811|\t}\n812|}\n813|\n814|func armMatchesRow(arm refusalArm, row declaredRefusalArm) bool {\n815|\treturn arm.file == row.file && arm.function == row.function &&\n816|\t\tarm.code == row.code && arm.detail == row.detail &&\n817|\t\tarm.occurrence == row.occurrence\n818|}\n819|\n820|func describeArm(arm refusalArm) string {\n821|\treturn arm.file + \" \" + arm.function + \" \" + arm.code + \" \" +\n822|\t\tstrconv.Quote(arm.detail) + \" #\" + strconv.Itoa(arm.occurrence)\n823|}\n824|\n825|func describeRow(row declaredRefusalArm) string {\n826|\treturn row.file + \" \" + row.function + \" \" + row.code + \" \" +\n827|\t\tstrconv.Quote(row.detail) + \" #\" + strconv.Itoa(row.occurrence)\n828|}\n829|\n830|// declaredRows returns the table plus the funnel row.\n831|func declaredRows() []declaredRefusalArm {\n832|\trows := append([]declaredRefusalArm(nil), declaredRefusalArms...)\n833|\tfunnel := funneledPlatformArm\n834|\tfunnel.detailSet = funneledPlatformDetails\n835|\treturn append(rows, funnel)\n836|}\n837|\n838|// TestDeclaredRefusalWiresMatchProductionConsts binds the table to the\n839|// production const values two ways: every row's code resolves to the\n840|// wire its test asserts, and every Code symbol except the named armless\n841|// one appears in at least one row, so a code nobody refuses is a red\n842|// rather than a quiet gap.\n843|func TestDeclaredRefusalWiresMatchProductionConsts(t *testing.T) {\n844|\tt.Parallel()\n845|\n846|\tsymbols := productionCodeSymbols(t)\n847|\tcovered := make(map[string]bool)\n848|\tfor _, row := range declaredRows() {\n849|\t\twire, known := symbols[row.code]\n850|\t\tif !known {\n851|\t\t\tt.Errorf(\"declared row %s names unknown code symbol %q\",\n852|\t\t\t\tdescribeRow(row), row.code)\n853|\t\t\tcontinue\n854|\t\t}\n855|\t\tcovered[row.code] = true\n856|\t\t_ = wire\n857|\t}\n858|\tfor symbol := range symbols {\n859|\t\tif armlessCodes[symbol] {\n860|\t\t\tcontinue\n861|\t\t}\n862|\t\tif !covered[symbol] {\n863|\t\t\tt.Errorf(\"code symbol %s has no refusal arm; a wire code nothing refuses is unwitnessed\", symbol)\n864|\t\t}\n865|\t}\n866|}\n867|\n868|// TestDeclaredRefusalTestsResolve requires every row to name real tests\n869|// that textually touch the arm: the detail literal, or the driven entry\n870|// plus the wire code (or its verified predicate). Bound rows name a test\n871|// driving the entry; the bound itself says why no document reaches them.\n872|func TestDeclaredRefusalTestsResolve(t *testing.T) {\n873|\tt.Parallel()\n874|\n875|\tbodies := testBodies(t)\n876|\tpredicates := predicateCodes(t)\n877|\tsymbols := productionCodeSymbols(t)\n878|\tfor _, row := range declaredRows() {\n879|\t\tif len(row.tests) == 0 {\n880|\t\t\tt.Errorf(\"declared row %s names no test, so nothing measures it\", describeRow(row))\n881|\t\t\tcontinue\n882|\t\t}\n883|\t\tresolved := false\n884|\t\tfor _, reference := range row.tests {\n885|\t\t\tbody, declared := bodies[reference.file+\"\\n\"+reference.test]\n886|\t\t\tif !declared {\n887|\t\t\t\tt.Errorf(\"declared row %s names %s in %s, which is not declared\",\n888|\t\t\t\t\tdescribeRow(row), reference.test, reference.file)\n889|\t\t\t\tcontinue\n890|\t\t\t}\n891|\t\t\tif rowResolves(row, body, predicates, symbols) {\n892|\t\t\t\tresolved = true\n893|\t\t\t}\n894|\t\t}\n895|\t\tif !resolved {\n896|\t\t\tt.Errorf(\"declared row %s names no test touching it: want the detail %q or the entry %q \"+\n897|\t\t\t\t\"with its wire code in %v\", describeRow(row), row.detail, row.entry, row.tests)\n898|\t\t}\n899|\t}\n900|}\n901|\n902|// rowResolves reports whether one test body touches one row.\n903|func rowResolves(row declaredRefusalArm, body string, predicates map[string]string, symbols map[string]string) bool {\n904|\tif row.detail == passthroughDetail {\n905|\t\tfor _, detail := range row.detailSet {\n906|\t\t\tif !strings.Contains(body, detail) {\n907|\t\t\t\treturn false\n908|\t\t\t}\n909|\t\t}\n910|\t\treturn strings.Contains(body, row.entry)\n911|\t}\n912|\tif strings.Contains(body, row.detail) {\n913|\t\treturn true\n914|\t}\n915|\tif row.bound != \"\" {\n916|\t\treturn strings.Contains(body, row.entry)\n917|\t}\n918|\tif !strings.Contains(body, row.entry) {\n919|\t\treturn false\n920|\t}\n921|\tif strings.Contains(body, symbols[row.code]) {\n922|\t\treturn true\n923|\t}\n924|\tfor predicate, code := range predicates {\n925|\t\tif code == row.code && strings.Contains(body, predicate) {\n926|\t\t\treturn true\n927|\t\t}\n928|\t}\n929|\treturn false\n930|}\n931|\n932|// TestDefensiveBoundsAreExactlyThese pins the set of bound rows: a new\n933|// defensive arm must join this set deliberately, with its bound stated,\n934|// rather than slipping in as an ordinary row whose test cannot reach it.\n935|func TestDefensiveBoundsAreExactlyThese(t *testing.T) {\n936|\tt.Parallel()\n937|\n938|\twant := map[string]bool{\n939|\t\t\"conformance.go ParseAttachAuthorization CodeMismatch \\\"document timestamp\\\" #1\": true,\n940|\t\t\"conformance.go ParseAttachAuthorization CodeMismatch \\\"document timestamp\\\" #2\": true,\n941|\t\t\"conformance.go CheckAttachRequest CodeMismatch \\\"document timestamp\\\" #1\":       true,\n942|\t\t\"manifest.go checkEvidenceLiveness CodeMismatch \\\"document timestamp\\\" #1\":       true,\n943|\t\t\"manifest.go checkEvidenceLiveness CodeMismatch \\\"document timestamp\\\" #2\":       true,\n944|\t}\n945|\tfor _, row := range declaredRows() {\n946|\t\tif row.bound == \"\" {\n947|\t\t\tcontinue\n948|\t\t}\n949|\t\tif row.bound != boundDefensiveReparse {\n950|\t\t\tt.Errorf(\"declared row %s carries an unrecognized bound %q\",\n951|\t\t\t\tdescribeRow(row), row.bound)\n952|\t\t\tcontinue\n953|\t\t}\n954|\t\tif !want[describeRow(row)] {\n955|\t\t\tt.Errorf(\"declared row %s claims a bound outside the pinned set; \"+\n956|\t\t\t\t\"a new defensive arm joins deliberately or not at all\", describeRow(row))\n957|\t\t}\n958|\t}\n959|\tbound := 0\n960|\tfor _, row := range declaredRows() {\n961|\t\tif row.bound != \"\" {\n962|\t\t\tbound++\n963|\t\t}\n964|\t}\n965|\tif bound != len(want) {\n966|\t\tt.Errorf(\"declared %d bound rows, want exactly the pinned %d\", bound, len(want))\n967|\t}\n968|}\n969|\n970|// TestPlatformFunnelDetailsAreExactlyThese derives the error set of\n971|// validatePlatforms from the production AST and requires it to equal the\n972|// funneled set: a fourth platform error widens the funnel this test pins.\n973|func TestPlatformFunnelDetailsAreExactlyThese(t *testing.T) {\n974|\tt.Parallel()\n975|\n976|\tfileSet := token.NewFileSet()\n977|\tfile, err := parser.ParseFile(fileSet, \"terminalbackend.go\", nil, 0)\n978|\tif err != nil {\n979|\t\tt.Fatalf(\"parse terminalbackend.go: %v\", err)\n980|\t}\n981|\tdetails := map[string]bool{}\n982|\tfor _, declaration := range file.Decls {\n983|\t\tfunction, ok := declaration.(*ast.FuncDecl)\n984|\t\tif !ok || function.Name.Name != \"validatePlatforms\" {\n985|\t\t\tcontinue\n986|\t\t}\n987|\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n988|\t\t\tcall, ok := node.(*ast.CallExpr)\n989|\t\t\tif !ok {\n990|\t\t\t\treturn true\n991|\t\t\t}\n992|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n993|\t\t\tif !ok || selector.Sel.Name != \"New\" {\n994|\t\t\t\treturn true\n995|\t\t\t}\n996|\t\t\treceiver, ok := selector.X.(*ast.Ident)\n997|\t\t\tif !ok || receiver.Name != \"errors\" || len(call.Args) != 1 {\n998|\t\t\t\treturn true\n999|\t\t\t}\n1000|\t\t\tliteral, ok := call.Args[0].(*ast.BasicLit)\n1001|\t\t\tif !ok || literal.Kind != token.STRING {\n1002|\t\t\t\tt.Fatalf(\"validatePlatforms error is not a static literal\")\n1003|\t\t\t\treturn true\n1004|\t\t\t}\n1005|\t\t\tdetail, err := strconv.Unquote(literal.Value)\n1006|\t\t\tif err != nil {\n1007|\t\t\t\tt.Fatalf(\"unquote platform error: %v\", err)\n1008|\t\t\t}\n1009|\t\t\tdetails[detail] = true\n1010|\t\t\treturn true\n1011|\t\t})\n1012|\t}\n1013|\tif len(details) == 0 {\n1014|\t\tt.Fatal(\"derived zero platform errors; the scanner is broken, not the package\")\n1015|\t}\n1016|\tfor _, want := range funneledPlatformDetails {\n1017|\t\tif !details[want] {\n1018|\t\t\tt.Errorf(\"funneled detail %q no longer derives from validatePlatforms\", want)\n1019|\t\t}\n1020|\t}\n1021|\tfor detail := range details {\n1022|\t\tknown := false\n1023|\t\tfor _, want := range funneledPlatformDetails {\n1024|\t\t\tif detail == want {\n1025|\t\t\t\tknown = true\n1026|\t\t\t}\n1027|\t\t}\n1028|\t\tif !known {\n1029|\t\t\tt.Errorf(\"validatePlatforms derives %q, outside the funneled set; \"+\n1030|\t\t\t\t\"a fourth platform error widens the funnel\", detail)\n1031|\t\t}\n1032|\t}\n1033|}\n1034|\n1035|// TestPlainErrorsLiveOnlyInTheirTwoFunctions closes the smuggling hole:\n1036|// a non-wire error constructed anywhere but validatePlatforms (the\n1037|// pinned funnel) or DigestFile (I/O) fails, so a refusal wearing a plain\n1038|// error's clothes cannot ship unwitnessed.\n1039|func TestPlainErrorsLiveOnlyInTheirTwoFunctions(t *testing.T) {\n1040|\tt.Parallel()\n1041|\n1042|\tmatches, err := filepath.Glob(\"*.go\")\n1043|\tif err != nil {\n1044|\t\tt.Fatalf(\"glob production files: %v\", err)\n1045|\t}\n1046|\tfor _, name := range matches {\n1047|\t\tif strings.HasSuffix(name, \"_test.go\") {\n1048|\t\t\tcontinue\n1049|\t\t}\n1050|\t\tfileSet := token.NewFileSet()\n1051|\t\tfile, err := parser.ParseFile(fileSet, name, nil, 0)\n1052|\t\tif err != nil {\n1053|\t\t\tt.Fatalf(\"parse %s: %v\", name, err)\n1054|\t\t}\n1055|\t\tfor _, declaration := range file.Decls {\n1056|\t\t\tfunction, ok := declaration.(*ast.FuncDecl)\n1057|\t\t\tif !ok || function.Body == nil {\n1058|\t\t\t\tcontinue\n1059|\t\t\t}\n1060|\t\t\tfunctionName := function.Name.Name\n1061|\t\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n1062|\t\t\t\tcall, ok := node.(*ast.CallExpr)\n1063|\t\t\t\tif !ok {\n1064|\t\t\t\t\treturn true\n1065|\t\t\t\t}\n1066|\t\t\t\tplain := false\n1067|\t\t\t\tif selector, ok := call.Fun.(*ast.SelectorExpr); ok {\n1068|\t\t\t\t\tif receiver, ok := selector.X.(*ast.Ident); ok {\n1069|\t\t\t\t\t\tif receiver.Name == \"errors\" && selector.Sel.Name == \"New\" {\n1070|\t\t\t\t\t\t\tplain = true\n1071|\t\t\t\t\t\t}\n1072|\t\t\t\t\t\tif receiver.Name == \"fmt\" && strings.HasPrefix(selector.Sel.Name, \"Errorf\") {\n1073|\t\t\t\t\t\t\tplain = true\n1074|\t\t\t\t\t\t}\n1075|\t\t\t\t\t}\n1076|\t\t\t\t}\n1077|\t\t\t\tif plain && !plainErrorFunctions[functionName] {\n1078|\t\t\t\t\tt.Errorf(\"%s constructs a non-wire error in %s, outside the two allowlisted functions; \"+\n1079|\t\t\t\t\t\t\"a refusal wearing a plain error's clothes ships unwitnessed\", name, functionName)\n1080|\t\t\t\t}\n1081|\t\t\t\treturn true\n1082|\t\t\t})\n1083|\t\t}\n1084|\t}\n1085|}\n1086|\n1087|// TestDigestFileRefusalsAreNeverWireErrors pins the allowlist's other\n1088|// half behaviorally: DigestFile failures are I/O errors, never *Error,\n1089|// so no caller can mistake them for a registry refusal.\n1090|func TestDigestFileRefusalsAreNeverWireErrors(t *testing.T) {\n1091|\tt.Parallel()\n1092|\n1093|\tfor _, path := range []string{\n1094|\t\tfilepath.Join(\"testdata\", \"no-such-executable\"),\n1095|\t\t\"\",\n1096|\t} {\n1097|\t\t_, err := DigestFile(path)\n1098|\t\tif err == nil {\n1099|\t\t\tt.Errorf(\"DigestFile(%q) = nil, want an I/O error\", path)\n1100|\t\t\tcontinue\n1101|\t\t}\n1102|\t\tvar refusal *Error\n1103|\t\tif errors.As(err, &refusal) {\n1104|\t\t\tt.Errorf(\"DigestFile(%q) error = %v, want a plain I/O error, never a wire refusal\", path, err)\n1105|\t\t}\n1106|\t}\n1107|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
