{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7df","stream":{"kind":"session","id":"01a06fb4-3612-7082-aba0-c5e534814a47"},"sequence":586,"recorded_at":1780531400001167,"record_type":"event","durability":"durable","causation_id":"eabad717-3e00-45d4-b352-a95943b57e50","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eabad717-3e00-45d4-b352-a95943b57e50","run_stream":{"kind":"run","id":"eabad717-3e00-45d4-b352-a95943b57e50"},"task_stream":{"kind":"task","id":"445cca28-cb84-4643-ba26-df5c3f58180d"},"task_id":"445cca28-cb84-4643-ba26-df5c3f58180d","event":{"kind":"output","task_id":"445cca28-cb84-4643-ba26-df5c3f58180d","chunk":"Read text file `.temp/TASK-260830-1snnef-r2/runner.py`.\n1|import json, os, re, subprocess, sys, hashlib, shutil\n2|\n3|ROOT = os.getcwd()\n4|FILES = ['internal/terminalbackend/manifest.go',\n5|         'internal/terminalbackend/terminalbackend.go',\n6|         'internal/terminalbackend/conformance.go',\n7|         'internal/config/validation.go']\n8|ORIG = {f: open(f).read() for f in FILES if os.path.exists(f)}\n9|SUMS = {f: hashlib.sha256(v.encode()).hexdigest() for f, v in ORIG.items()}\n10|\n11|def restore():\n12|    for f, v in ORIG.items():\n13|        open(f, 'w').write(v)\n14|    for f, v in ORIG.items():\n15|        assert hashlib.sha256(open(f).read().encode()).hexdigest() == SUMS[f], f\n16|\n17|def load_py_battery(path, default_src):\n18|    src = open(path).read()\n19|    ns = {}\n20|    m = re.search(r\"^SRC\\s*=\\s*(.+)$\", src, re.M)\n21|    srcfile = eval(m.group(1)) if m else default_src\n22|    body = re.search(r\"MUTANTS\\s*=\\s*\\[(.*?)\\n\\]\", src, re.S)\n23|    items = eval(\"[\" + body.group(1) + \"\\n]\", {}, ns)\n24|    out = []\n25|    for it in items:\n26|        mid, kind, old, new = it[0], it[1], it[2], it[3]\n27|        out.append({\"id\": mid, \"desc\": kind, \"edits\": [{\"file\": srcfile, \"old\": old, \"new\": new}]})\n28|    return out\n29|\n30|def load_json_battery(path):\n31|    return json.load(open(path))\n32|\n33|def run(mutants, label, pkgs):\n34|    killed, survived, missing = [], [], []\n35|    for m in mutants:\n36|        restore()\n37|        ok = True\n38|        for e in m[\"edits\"]:\n39|            f = e[\"file\"]\n40|            s = open(f).read()\n41|            if e[\"old\"] not in s:\n42|                ok = False\n43|                break\n44|            open(f, 'w').write(s.replace(e[\"old\"], e[\"new\"], 1))\n45|        if not ok:\n46|            missing.append(m[\"id\"])\n47|            restore()\n48|            continue\n49|        r = subprocess.run([\"go\", \"test\"] + pkgs + [\"-count=1\"],\n50|                           capture_output=True, text=True)\n51|        if r.returncode != 0:\n52|            killed.append(m[\"id\"])\n53|        else:\n54|            survived.append(m[\"id\"])\n55|        restore()\n56|    print(f\"[{label}] total={len(mutants)} killed={len(killed)} survived={len(survived)} anchor_missing={len(missing)}\")\n57|    if survived: print(f\"  SURVIVED: {survived}\")\n58|    if missing:  print(f\"  ANCHOR MISSING: {missing}\")\n59|    return {\"label\": label, \"killed\": killed, \"survived\": survived, \"missing\": missing}\n60|\n61|if __name__ == \"__main__\":\n62|    which = sys.argv[1]\n63|    lo, hi = int(sys.argv[2]), int(sys.argv[3])\n64|    D = \".temp/TASK-260830-1snnef/evidence/\"\n65|    if which == \"leaf1r3\":\n66|        ms = load_json_battery(D + \"TASK-260830-2xdt8t_review3-mutant-definitions.json\")\n67|        pkgs = [\"./internal/terminalbackend/\", \"./internal/config/\"]\n68|    elif which == \"leaf1r2\":\n69|        ms = load_json_battery(D + \"TASK-260830-2xdt8t_review2-mutant-definitions.json\")\n70|        pkgs = [\"./internal/terminalbackend/\", \"./internal/config/\"]\n71|    elif which == \"leaf2b1\":\n72|        ms = load_py_battery(D + \"TASK-260830-1zvmw7_review-mutant-battery-1.py\", FILES[0])\n73|        pkgs = [\"./internal/terminalbackend/\"]\n74|    elif which == \"leaf2b2\":\n75|        ms = load_py_battery(D + \"TASK-260830-1zvmw7_review-mutant-battery-2.py\", FILES[0])\n76|        pkgs = [\"./internal/terminalbackend/\"]\n77|    res = run(ms[lo:hi], f\"{which}[{lo}:{hi}]\", pkgs)\n78|    json.dump(res, open(f\".temp/TASK-260830-1snnef-r2/res-{which}-{lo}-{hi}.json\", \"w\"))"}}}
