{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9a9","stream":{"kind":"session","id":"01a06fb4-3612-7082-aba0-c5e534814a47"},"sequence":815,"recorded_at":1780531400001625,"record_type":"event","durability":"durable","causation_id":"eabad717-3e00-45d4-b352-a95943b57e50","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eabad717-3e00-45d4-b352-a95943b57e50","run_stream":{"kind":"run","id":"eabad717-3e00-45d4-b352-a95943b57e50"},"task_stream":{"kind":"task","id":"7f60732f-5989-43dd-ab66-85b96dd97a6a"},"task_id":"7f60732f-5989-43dd-ab66-85b96dd97a6a","event":{"kind":"output","task_id":"7f60732f-5989-43dd-ab66-85b96dd97a6a","chunk":"Read text file `internal/terminalbackend/conformance_test.go`.\n(903 line(s) above)\n904|}\n905|\n906|// TestParseAttachAuthorizationRefusesNonNeutralPolicy is the attack the\n907|// neutrality rule exists for: a lease tuple smuggled into an attach\n908|// policy, whether under its AXAuthorization names or any other unknown\n909|// member, is refused as an unknown member before any other check runs.\n910|// Missing members, mistyped members, and an expiry that is not strictly\n911|// after issue are refused alongside.\n912|func TestParseAttachAuthorizationRefusesNonNeutralPolicy(t *testing.T) {\n913|\tt.Parallel()\n914|\n915|\tbase := map[string]string{\n916|\t\t\"policy_evidence_id\":  `\"` + testDigest + `\"`,\n917|\t\t\"authorizing_host_id\": `\"` + conformanceHost + `\"`,\n918|\t\t\"transport\":           `\"local_only\"`,\n919|\t\t\"input_authorized\":    `true`,\n920|\t\t\"issued_at\":           `\"` + conformanceIssued + `\"`,\n921|\t\t\"expires_at\":          `\"` + conformanceExpires + `\"`,\n922|\t}\n923|\tbuild := func(override map[string]string, extra string) []byte {\n924|\t\tmembers := []string{}\n925|\t\tfor _, name := range []string{\n926|\t\t\t\"policy_evidence_id\", \"authorizing_host_id\", \"transport\",\n927|\t\t\t\"input_authorized\", \"issued_at\", \"expires_at\",\n928|\t\t} {\n929|\t\t\tvalue := base[name]\n930|\t\t\tif replacement, ok := override[name]; ok {\n931|\t\t\t\tif replacement == \"\" {\n932|\t\t\t\t\tcontinue\n933|\t\t\t\t}\n934|\t\t\t\tvalue = replacement\n935|\t\t\t}\n936|\t\t\tmembers = append(members, `\"`+name+`\":`+value)\n937|\t\t}\n938|\t\tif extra != \"\" {\n939|\t\t\tmembers = append(members, extra)\n940|\t\t}\n941|\t\treturn []byte(\"{\" + strings.Join(members, \",\") + \"}\")\n942|\t}\n943|\n944|\t// Every lease-shaped smuggling attempt, refused as an unknown member.\n945|\tfor _, extra := range []string{\n946|\t\t`\"lease_id\":\"0198f4c8-8e50-4f66-8f70-1234567890ab\"`,\n947|\t\t`\"lease_epoch\":41`,\n948|\t\t`\"holder_host_id\":\"` + conformanceHost + `\"`,\n949|\t\t`\"authorization_kind\":\"control\"`,\n950|\t\t`\"authorization_evidence_id\":\"` + testDigest + `\"`,\n951|\t\t`\"owner\":\"` + conformanceHost + `\"`,\n952|\t} {\n953|\t\t_, err := terminalbackend.ParseAttachAuthorization(build(nil, extra))\n954|\t\trequireConformanceRefusal(t, err,\n955|\t\t\t\"terminal_backend_manifest_probe_mismatch\", \"document members\")\n956|\t}\n957|\n958|\t// Missing and mistyped members.\n959|\t_, err := terminalbackend.ParseAttachAuthorization(build(map[string]string{\"transport\": \"\"}, \"\"))\n960|\trequireConformanceRefusal(t, err,\n961|\t\t\"terminal_backend_manifest_probe_mismatch\", \"document members\")\n962|\t_, err = terminalbackend.ParseAttachAuthorization(\n963|\t\tbuild(map[string]string{\"input_authorized\": `\"yes\"`}, \"\"))\n964|\trequireConformanceRefusal(t, err,\n965|\t\t\"terminal_backend_manifest_probe_mismatch\", \"document member type\")\n966|\t_, err = terminalbackend.ParseAttachAuthorization(\n967|\t\tbuild(map[string]string{\"transport\": `\"courier_pigeon\"`}, \"\"))\n968|\trequireConformanceRefusal(t, err,\n969|\t\t\"terminal_backend_protocol_error\", \"presentation transport vocabulary\")\n970|\t_, err = terminalbackend.ParseAttachAuthorization(\n971|\t\tbuild(map[string]string{\"policy_evidence_id\": `\"not-a-digest\"`}, \"\"))\n972|\trequireConformanceRefusal(t, err,\n973|\t\t\"terminal_backend_manifest_probe_mismatch\", \"document digest\")\n974|\t_, err = terminalbackend.ParseAttachAuthorization(\n975|\t\tbuild(map[string]string{\"authorizing_host_id\": `\"not-a-uuid\"`}, \"\"))\n976|\trequireConformanceRefusal(t, err,\n977|\t\t\"terminal_backend_manifest_probe_mismatch\", \"document member type\")\n978|\n979|\t// Expiry equal to or before issue authorizes nothing.\n980|\t_, err = terminalbackend.ParseAttachAuthorization(\n981|\t\tbuild(map[string]string{\"expires_at\": `\"` + conformanceIssued + `\"`}, \"\"))\n982|\trequireConformanceRefusal(t, err,\n983|\t\t\"terminal_backend_unauthorized\", \"attach authorization expiry\")\n984|\t_, err = terminalbackend.ParseAttachAuthorization(\n985|\t\tbuild(map[string]string{\n986|\t\t\t\"issued_at\":  `\"` + conformanceExpires + `\"`,\n987|\t\t\t\"expires_at\": `\"` + conformanceIssued + `\"`,\n988|\t\t}, \"\"))\n989|\trequireConformanceRefusal(t, err,\n990|\t\t\"terminal_backend_unauthorized\", \"attach authorization expiry\")\n991|\n992|\t// A malformed read is an error, never an absent policy.\n993|\tfor _, raw := range [][]byte{\n994|\t\t[]byte(`not json`),\n995|\t\t[]byte(`[1,2,3]`),\n996|\t\t[]byte(`{\"policy_evidence_id\":\"` + testDigest + `\"}`),\n997|\t} {\n998|\t\tif _, err := terminalbackend.ParseAttachAuthorization(raw); err == nil {\n999|\t\t\tt.Errorf(\"ParseAttachAuthorization(%q) = nil, want refusal\", raw)\n1000|\t\t}\n1001|\t}\n1002|}\n1003|\n1004|// TestCheckAttachRequestBindsTransportInputAndExpiry proves the attach\n1005|// row at the production entry: the request must equal the authorized\n1006|// transport and input boolean, a relay transport is refused even when\n1007|// named, and an expired policy authorizes nothing.\n1008|func TestCheckAttachRequestBindsTransportInputAndExpiry(t *testing.T) {\n(more lines below)"}}}
