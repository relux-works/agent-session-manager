|\t\t\"local_precondition_failed\",\n474|\t\t\"terminal_backend_unauthorized\",\n475|\t\t\"terminal_backend_stale_generation\",\n476|\t\t\"terminal_backend_capability_unproven\",\n477|\t\t\"stop_timeout\",\n478|\t\t\"terminal_backend_process_failed\",\n479|\t\t\"terminal_backend_integrity_failure\",\n480|\t\t\"terminal_backend_protocol_error\",\n481|\t},\n482|\t\"terminate-stale\": {\n483|\t\t\"idempotency_mismatch\",\n484|\t\t\"local_precondition_failed\",\n485|\t\t\"terminal_backend_unauthorized\",\n486|\t\t\"terminal_backend_stale_generation\",\n487|\t\t\"terminal_backend_capability_unproven\",\n488|\t\t\"terminal_backend_timeout\",\n489|\t\t\"terminal_backend_process_failed\",\n490|\t\t\"terminal_backend_integrity_failure\",\n491|\t\t\"terminal_backend_protocol_error\",\n492|\t},\n493|\t\"restore\": {\n494|\t\t\"idempotency_mismatch\",\n495|\t\t\"local_precondition_failed\",\n496|\t\t\"terminal_backend_unauthorized\",\n497|\t\t\"terminal_backend_stale_generation\",\n498|\t\t\"terminal_backend_capability_unproven\",\n499|\t\t\"terminal_backend_restore_mismatch\",\n500|\t\t\"terminal_backend_unavailable\",\n501|\t\t\"terminal_backend_timeout\",\n502|\t\t\"terminal_backend_process_failed\",\n503|\t\t\"terminal_backend_integrity_failure\",\n504|\t\t\"terminal_backend_protocol_error\",\n505|\t},\n506|}\n507|\n508|// conformanceOperations is the ten-operation vocabulary the error mapping\n509|// is defined over, matching the ten operations ParseOperation admits\n510|// (pinned by TestParseOperationAdmitsOnlyTheTenClosedOperations). Both\n511|// direction tests iterate it, so a mirror row can never silently cover\n512|// nine operations while the suite claims ten.\n513|var conformanceOperations = []string{\n514|\t\"manifest\", \"probe\", \"create\", \"attach\", \"status\",\n515|\t\"quiesce-input\", \"wait-safe-boundary\", \"request-stop\",\n516|\t\"terminate-stale\", \"restore\",\n517|}\n518|\n519|// TestCheckErrorAllowedAdmitsEverySpecRowCode drives every code of ever