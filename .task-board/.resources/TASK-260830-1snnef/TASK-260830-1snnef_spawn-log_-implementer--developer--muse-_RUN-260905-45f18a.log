\":true,` +\n38|\t\t`\"issued_at\":\"` + conformanceIssued + `\",` +\n39|\t\t`\"expires_at\":\"` + conformanceExpires + `\"}`\n40|\n41|\tauth, err := terminalbackend.ParseAttachAuthorization([]byte(raw))\n42|\tif err != nil {\n43|\t\tt.Fatalf(\"ParseAttachAuthorization() error = %v\", err)\n44|\t}\n45|\treturn auth\n46|}\n47|\n48|func requireConformanceRefusal(t *testing.T, err error, wantCode, wantDetail string) {\n49|\tt.Helper()\n50|\n51|\tvar refusal *terminalbackend.Error\n52|\tif !errors.As(err, &refusal) {\n53|\t\tt.Fatalf(\"error = %v, want *Error with code %q at %q\", err, wantCode, wantDetail)\n54|\t}\n55|\tif refusal.Code != wantCode || refusal.Detail != wantDetail {\n56|\t\tt.Errorf(\"refusal = %q at %q, want %q at %q\", refusal.Code, refusal.Detail, wantCode, wantDetail)\n57|\t}\n58|}\n59|\n60|// TestParseInstanceStateAdmitsOnlyTheEightClosedStates sweeps the state\n61|// domain at the production entry: every member outside the §4.C enum is\n62|// refused as a protocol error rather than mapped onto a near neighbour.\n63|func TestParseInstanceStateAdmitsOnlyTheEightClosedStates(t *testing.T) {\n64|\tt.Parallel()\n65|\n66|\tfor _, state := range []string{\n67|\t\t\"absent\", \"creating\", \"parked\", \"active\",\n68|\t\t\"quiescing\", \"stopped\", \"stale_fenced\", \"unavailable\",\n69|\t} {\n70|\t\tif _, err := terminalbackend.ParseInstanceState(state); err != nil {\n71|\t\t\tt.Errorf(\"ParseInstanceState(%q) error = %v, want admission\", state, err)\n72|\t\t}\n73|\t}\n74|\tfor _, state := range []string{\n75|\t\t\"\", \"Absent\", \"ACTIVE\", \"running\", \"stale-fenced\",\n76|\t\t\"parked \", \" parked\", \"absent\\x00\", \"creating\\n\",\n77|\t\tstrings.Repeat(\"a\", 1024),\n78|\t} {\n79|\t\t_, err := terminalbackend.ParseInstanceState(state)\n80|\t\trequireConformanceRefusal(t, err,\n81|\t\t\t\"terminal_backend_protocol_error\", \"lifecycle state vocabulary\")\n82|\t}\n83|}\n84|\n85|// TestParseOperationAdmitsOnlyTheTenClosedOperations sweeps the operation\n86|// domain the same way: no eleventh operation is admittable.\n87|func TestParseOperationAdmitsOnlyTheTenClosedOperations(t *testing.T) {\n88|\tt.Parallel()\n89|\n90|\tfor _, operation := range []string{\n91|\t\t\"manifest\", \"probe\", \"create\", \"attach\", \"status\",\n92|\t\t\"quiesce-input\", \"wait-safe-boundary\", \"request-stop\",\n93|\t\t\"terminate-stale\", \"restore\",\n94|\t} {\n95|\t\tif _, err := terminalbackend.ParseOperation(operation); err != nil {\n96|\t\t\tt.Errorf(\"ParseOperation(%q) error = %v, want admission\", operation, err)\n97|\t\t}\n98|\t}\n99|\tfor _, operation := range []string{\n100|\t\t\"\", \"Create\", \"ATTACH\", \"quiesce_input\", \"quiesce\",\n101|\t\t\"status \", \" create\", \"terminate_stale\", \"delete\",\n102|\t\tstrings.Repeat(\"a\", 1024),\n103|\t} {\n104|\t\t_, err := terminalbackend.ParseOperation(operation)\n105|\t\trequireConformanceRefusal(t, err,\n106|\t\t\t\"terminal_backend_protocol_error\", \"operation vocabulary\")\n107|\t}\n108|}\n109|\n110|// transitionFixture is one exact §4.C table row restated as an expectation:\n111|// every allowed source of one operation with its success target and exact\n112|// side effects.\n113|type transitionFixture struct {\n114|\toperation   string\n115|\tsource      string\n116|\tinteractive bool\n117|\ttarget      string\n118|\teffects     []string\n119|}\n120|\n121|// TestCheckTransitionAdmitsEveryTableRow drives the whole §4.C matrix\n122|// through the production entry: 8 status observations, both create\n123|// targets, both attach sources, and every other row with its exact side\n124|// effects. manifest and probe carry no instance source or target.\n125|func TestCheckTransitionAdmitsEveryTableRow(t *testing.T) {\n126|\tt.Parallel()\n127|\n128|\tstatusSources := []string{\n129|\t\t\"absent\", \"creating\", \"parked\", \"active\",\n130|\t\t\"quiescing\", \"stopped\", \"stale_fenced\", \"unavailable\",\n(more lines below)"}}}
