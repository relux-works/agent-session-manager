{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8fd","stream":{"kind":"session","id":"01a06f2d-c4fb-70c0-8c5e-603ce37ec5f8"},"sequence":729,"recorded_at":1780531400001453,"record_type":"event","durability":"durable","causation_id":"02902741-1c1c-40bd-a4a2-4bcb4871f93c","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"02902741-1c1c-40bd-a4a2-4bcb4871f93c","run_stream":{"kind":"run","id":"02902741-1c1c-40bd-a4a2-4bcb4871f93c"},"call_id":"call_01a06f30357777e1a76b41c5048708d9","text":"Read text file `internal/canonicaljson/grammar_inventory_test.go`.\n(799 line(s) above)\n800|\t\t\tt.Errorf(\"witness %s carries no value\", key)\n801|\t\t}\n802|\t\tswitch site.kind {\n803|\t\tcase grammarQuantifierMax:\n804|\t\t\tif witness.specBound != site.maximum {\n805|\t\t\t\tt.Errorf(\n806|\t\t\t\t\t\"witness %s asserts the pinned maximum %d but production declares %d; a bound must be asserted \"+\n807|\t\t\t\t\t\t\"against the specification literal, never against the constant it derives from\",\n808|\t\t\t\t\tkey, witness.specBound, site.maximum)\n809|\t\t\t}\n810|\t\tcase grammarQuantifierMin:\n811|\t\t\tif witness.specBound != site.minimum {\n812|\t\t\t\tt.Errorf(\"witness %s asserts the pinned minimum %d but production declares %d\", key, witness.specBound, site.minimum)\n813|\t\t\t}\n814|\t\t}\n815|\t}\n816|\n817|\tvar missing []string\n818|\tfor key := range obligations {\n819|\t\tif witnessed[key] > 0 {\n820|\t\t\tif _, subsumed := subsumedGrammarDimensions[key]; subsumed {\n821|\t\t\t\tt.Errorf(\"dimension %s is disclosed as subsumed but also carries a witness; remove one\", key)\n822|\t\t\t}\n823|\t\t\tcontinue\n824|\t\t}\n825|\t\tif subsumption, subsumed := subsumedGrammarDimensions[key]; subsumed {\n826|\t\t\tif _, exists := names[subsumption.provingTest]; !exists {\n827|\t\t\t\tt.Errorf(\"subsumed dimension %s names %s, which does not exist in this package\", key, subsumption.provingTest)\n828|\t\t\t}\n829|\t\t\tcontinue\n830|\t\t}\n831|\t\tmissing = append(missing, key)\n832|\t}\n833|\tsort.Strings(missing)\n834|\tif len(missing) > 0 {\n835|\t\tt.Errorf(\n836|\t\t\t\"declared grammar dimension(s) with no widening witness. A grammar with an unproven dimension is \"+\n837|\t\t\t\t\"pinned only against deletion; widening it leaves the whole suite green:\\n  %s\",\n838|\t\t\tstrings.Join(missing, \"\\n  \"))\n839|\t}\n840|}\n841|\n842|// deriveGrammarObligations returns every dimension that carries a risky\n843|// mutation, keyed as pattern|dimension.\n844|//\n845|// For an admission matcher every dimension is risky, because each one can be\n846|// widened to admit more. For a refusal matcher only the character classes are:\n847|// dropping its anchor or relaxing a quantifier makes it match MORE inputs, which\n848|// refuses more and cannot admit anything new.\n849|func deriveGrammarObligations(t *testing.T) map[string]grammarSite {\n850|\tt.Helper()\n851|\n852|\tobligations := make(map[string]grammarSite)\n853|\tfor name, pattern := range deriveGrammarPatterns(t) {\n854|\t\t// Dimensions are derived from the PINNED REFERENCE, not from the\n855|\t\t// production source, so a widened production pattern cannot delete its\n856|\t\t// own obligation. TestEveryCompiledGrammarMatchesItsPinnedReference is\n857|\t\t// what keeps the two identical.\n858|\t\tfor _, site := range deriveGrammarSites(name, declaredGrammars[name].reference) {\n859|\t\t\tif !pattern.admitting && site.kind != grammarClass {\n860|\t\t\t\tcontinue\n861|\t\t\t}\n862|\t\t\tobligations[name+\"|\"+site.dimension] = site\n863|\t\t}\n864|\t}\n865|\tif len(obligations) == 0 {\n866|\t\tt.Fatal(\"derived zero grammar dimensions; the scanner is broken, not the package\")\n867|\t}\n868|\treturn obligations\n869|}\n870|\n871|// TestEveryGrammarWitnessIsAdmittedByItsOwnWideningOnly is the derivation's\n872|// self-check, and it is what makes the witness table more than decoration.\n873|//\n874|// For an admission matcher it proves, mechanically, that the production pattern\n875|// REFUSES the witness while the pattern with exactly that one dimension widened\n876|// ADMITS it. A witness that would also pass against the widened grammar - the\n877|// \"grammar inventory that cannot fail when a pattern is widened\" this Story was\n878|// rejected for - fails here.\n879|//\n880|// For a refusal matcher it proves the mirror image: production MATCHES the\n881|// witness, and narrowing that character class to its first or last declared item\n882|// stops matching it, so the value would be admitted.\n883|func TestEveryGrammarWitnessIsAdmittedByItsOwnWideningOnly(t *testing.T) {\n884|\tt.Parallel()\n885|\n886|\tpatterns := deriveGrammarPatterns(t)\n887|\tobligations := deriveGrammarObligations(t)\n888|\tfor _, witness := range declaredGrammarWitnesses() {\n889|\t\tkey := witness.pattern + \"|\" + witness.dimension\n890|\t\tsite, ok := obligations[key]\n891|\t\tif !ok {\n892|\t\t\tcontinue\n893|\t\t}\n894|\t\tpattern := patterns[witness.pattern]\n895|\t\tproduction := referenceGrammar(t, witness.pattern)\n896|\t\tif pattern.admitting {\n897|\t\t\twidened := regexp.MustCompile(widenGrammarSource(declaredGrammars[witness.pattern].reference, site))\n898|\t\t\tfor _, value := range witness.values {\n899|\t\t\t\tif production.MatchString(value) {\n900|\t\t\t\t\tt.Errorf(\"witness %s value %q is admitted by the production grammar; it proves nothing\", key, value)\n901|\t\t\t\t}\n902|\t\t\t\tif !widened.MatchString(value) {\n903|\t\t\t\t\tt.Errorf(\n904|\t\t\t\t\t\t\"witness %s value %q is refused even by the widened grammar %q, so widening %s cannot make \"+\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
