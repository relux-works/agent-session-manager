{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4d3","stream":{"kind":"session","id":"01a06f2d-c4fb-70c0-8c5e-603ce37ec5f8"},"sequence":196,"recorded_at":1780531400000387,"record_type":"event","durability":"durable","causation_id":"02902741-1c1c-40bd-a4a2-4bcb4871f93c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"02902741-1c1c-40bd-a4a2-4bcb4871f93c","run_stream":{"kind":"run","id":"02902741-1c1c-40bd-a4a2-4bcb4871f93c"},"task_stream":{"kind":"task","id":"33e962cc-ce8c-4dfb-8d10-b438ebcb4762"},"task_id":"33e962cc-ce8c-4dfb-8d10-b438ebcb4762","event":{"kind":"output","task_id":"33e962cc-ce8c-4dfb-8d10-b438ebcb4762","chunk":"Read text file `internal/canonicaljson/grammar_inventory_test.go`.\n1|package canonicaljson\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"go/ast\"\n6|\t\"go/token\"\n7|\t\"regexp\"\n8|\t\"sort\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|)\n13|\n14|// This file pins the SEMANTICS of every declared grammar this package compiles.\n15|//\n16|// The failure it exists to prevent: a regular expression is a matcher, and a\n17|// test that refuses one value outside it proves the matcher is REACHABLE, not\n18|// that the admitted language is the declared one. A derived sweep confirmed the\n19|// gap: widening observationNamePattern from {1,7} to {1,8} segments, from {1,7}\n20|// to {0,7} so a bare single-segment name is admitted, and adding a hyphen to its\n21|// character class each left `go test ./...`, every seeded fuzz corpus,\n22|// tracecheck, the declared-bounds gate and the closed-vocabulary pin green.\n23|// boardLogicalIDPattern survived the same treatment at {0,127} -> {0,128}.\n24|//\n25|// The obligation is therefore derived from the pattern source itself: every\n26|// anchor, every character class, every counted quantifier bound and every\n27|// one-or-more quantifier in every production regexp is one dimension that must\n28|// carry a witness which the UNwidened pattern refuses. Adding a pattern, or\n29|// adding a class or a quantifier to an existing one, fails at derivation until\n30|// its witness exists.\n31|\n32|// grammarPattern is one compiled production grammar with the polarity of its\n33|// use, derived from whether the production condition negates the match.\n34|type grammarPattern struct {\n35|\tname   string\n36|\tsource string\n37|\t// admitting is true when production refuses on !MatchString, so the risky\n38|\t// mutation is a WIDENING. It is false when production refuses on a match, so\n39|\t// the risky mutation is a NARROWING. Either way the witness below must be\n40|\t// refused, so both polarities assert the same way.\n41|\tadmitting bool\n42|}\n43|\n44|// deriveGrammarPatterns returns every regexp compiled in the package production\n45|// sources, with the polarity derived from its use rather than assumed.\n46|func deriveGrammarPatterns(t *testing.T) map[string]grammarPattern {\n47|\tt.Helper()\n48|\n49|\t_, files := packageProductionAST(t)\n50|\tpatterns := make(map[string]grammarPattern)\n51|\tfor _, file := range files {\n52|\t\tfor _, declaration := range file.Decls {\n53|\t\t\tgeneral, ok := declaration.(*ast.GenDecl)\n54|\t\t\tif !ok || general.Tok != token.VAR {\n55|\t\t\t\tcontinue\n56|\t\t\t}\n57|\t\t\tfor _, specification := range general.Specs {\n58|\t\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n59|\t\t\t\tif !ok {\n60|\t\t\t\t\tcontinue\n61|\t\t\t\t}\n62|\t\t\t\tfor index, name := range value.Names {\n63|\t\t\t\t\tif index >= len(value.Values) {\n64|\t\t\t\t\t\tcontinue\n65|\t\t\t\t\t}\n66|\t\t\t\t\tsource, ok := compiledRegexpSource(value.Values[index])\n67|\t\t\t\t\tif !ok {\n68|\t\t\t\t\t\tcontinue\n69|\t\t\t\t\t}\n70|\t\t\t\t\tpatterns[name.Name] = grammarPattern{name: name.Name, source: source}\n71|\t\t\t\t}\n72|\t\t\t}\n73|\t\t}\n74|\t}\n75|\tif len(patterns) == 0 {\n76|\t\tt.Fatal(\"derived zero compiled grammars from the package sources; the scanner is broken, not the package\")\n77|\t}\n78|\tfor name, pattern := range patterns {\n79|\t\tpattern.admitting = grammarIsUsedAsAdmission(t, files, name)\n80|\t\tpatterns[name] = pattern\n81|\t}\n82|\treturn patterns\n83|}\n84|\n85|func compiledRegexpSource(expression ast.Expr) (string, bool) {\n86|\tcall, ok := expression.(*ast.CallExpr)\n87|\tif !ok || len(call.Args) != 1 {\n88|\t\treturn \"\", false\n89|\t}\n90|\tselector, ok := call.Fun.(*ast.SelectorExpr)\n91|\tif !ok || selector.Sel.Name != \"MustCompile\" {\n92|\t\treturn \"\", false\n93|\t}\n94|\tif package_, ok := selector.X.(*ast.Ident); !ok || package_.Name != \"regexp\" {\n95|\t\treturn \"\", false\n96|\t}\n97|\tliteral, ok := call.Args[0].(*ast.BasicLit)\n98|\tif !ok || literal.Kind != token.STRING {\n99|\t\treturn \"\", false\n100|\t}\n101|\tsource, err := strconv.Unquote(literal.Value)\n102|\tif err != nil {\n103|\t\treturn \"\", false\n104|\t}\n105|\treturn source, true\n106|}\n107|\n108|// grammarIsUsedAsAdmission reports whether every production use of a pattern\n109|// refuses on a negated match, which makes widening the risky direction.\n110|func grammarIsUsedAsAdmission(t *testing.T, files []*ast.File, name string) bool {\n111|\tt.Helper()\n112|\n113|\tnegated, total := 0, 0\n114|\tfor _, file := range files {\n115|\t\tast.Inspect(file, func(node ast.Node) bool {\n116|\t\t\tcall, ok := node.(*ast.CallExpr)\n117|\t\t\tif !ok {\n118|\t\t\t\treturn true\n119|\t\t\t}\n120|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n121|\t\t\tif !ok || selector.Sel.Name != \"MatchString\" {\n122|\t\t\t\treturn true\n123|\t\t\t}\n124|\t\t\treceiver, ok := selector.X.(*ast.Ident)\n125|\t\t\tif !ok || receiver.Name != name {\n126|\t\t\t\treturn true\n127|\t\t\t}\n128|\t\t\ttotal++\n129|\t\t\treturn true\n130|\t\t})\n131|\t\tast.Inspect(file, func(node ast.Node) bool {\n132|\t\t\tunary, ok := node.(*ast.UnaryExpr)\n133|\t\t\tif !ok || unary.Op != token.NOT {\n134|\t\t\t\treturn true\n135|\t\t\t}\n136|\t\t\tcall, ok := unary.X.(*ast.CallExpr)\n137|\t\t\tif !ok {\n138|\t\t\t\treturn true\n139|\t\t\t}\n140|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n141|\t\t\tif !ok || selector.Sel.Name != \"MatchString\" {\n142|\t\t\t\treturn true\n143|\t\t\t}\n144|\t\t\tif receiver, ok := selector.X.(*ast.Ident); ok && receiver.Name == name {\n145|\t\t\t\tnegated++\n146|\t\t\t}\n147|\t\t\treturn true\n148|\t\t})\n149|\t}\n150|\tif total == 0 {\n151|\t\tt.Fatalf(\"grammar %s is compiled but never matched against; it declares a language nothing enforces\", name)\n152|\t}\n153|\treturn negated == total\n154|}\n155|\n156|// grammarSite is one widenable decision inside a pattern source, located by\n157|// byte range so the mutation that widens it can be applied mechanically.\n158|type grammarSite struct {\n159|\tdimension string\n160|\tkind      string\n161|\tstart     int\n162|\tend       int // exclusive\n163|\tminimum   int\n164|\tmaximum   int\n165|}\n166|\n167|const (\n168|\tgrammarAnchorStart   = \"anchor.start\"\n169|\tgrammarAnchorEnd     = \"anchor.end\"\n170|\tgrammarClass         = \"class\"\n171|\tgrammarQuantifierMax = \"quantifier.max\"\n172|\tgrammarQuantifierMin = \"quantifier.min\"\n173|\tgrammarOneOrMore     = \"one-or-more\"\n174|)\n175|\n176|// deriveGrammarSites returns the widenable decisions of a pattern source.\n177|//\n178|// Anchors, character classes, counted quantifier bounds and one-or-more\n179|// quantifiers are enumerated positionally, so inserting a class or a bound\n180|// shifts nothing that already exists and adds exactly one new obligation. The\n181|// derived label for a counted bound carries the IMPLEMENTATION number; the\n182|// witness carries the number the pinned specification declares, and the coverage\n183|// test requires them to agree, so widening a bound in production changes the\n184|// obligation key and fails before any case runs.\n185|func deriveGrammarSites(name, source string) []grammarSite {\n186|\tvar sites []grammarSite\n187|\tadd := func(label, kind string, start, end, minimum, maximum int) {\n188|\t\tsites = append(sites, grammarSite{dimension: label, kind: kind, start: start, end: end, minimum: minimum, maximum: maximum})\n189|\t}\n190|\tif strings.HasPrefix(source, \"^\") {\n191|\t\tadd(grammarAnchorStart, grammarAnchorStart, 0, 1, 0, 0)\n192|\t}\n193|\tif strings.HasSuffix(source, \"$\") {\n194|\t\tadd(grammarAnchorEnd, grammarAnchorEnd, len(source)-1, len(source), 0, 0)\n195|\t}\n196|\tclasses, quantifiers, plusses := 0, 0, 0\n197|\tfor index := 0; index < len(source); index++ {\n198|\t\tswitch source[index] {\n199|\t\tcase '\\\\':\n200|\t\t\tindex++\n201|\t\tcase '[':\n202|\t\t\tclasses++\n203|\t\t\tend := endOfCharacterClass(source, index)\n204|\t\t\tadd(fmt.Sprintf(\"class#%d\", classes), grammarClass, index, end+1, 0, 0)\n205|\t\t\tindex = end\n206|\t\tcase '{':\n207|\t\t\tclosing := strings.IndexByte(source[index:], '}')\n208|\t\t\tif closing < 0 {\n209|\t\t\t\tcontinue\n210|\t\t\t}\n211|\t\t\tminimum, maximum, ok := parseCountedQuantifier(source[index+1 : index+closing])\n212|\t\t\tif !ok {\n213|\t\t\t\tcontinue\n214|\t\t\t}\n215|\t\t\tquantifiers++\n216|\t\t\tif maximum >= 0 {\n217|\t\t\t\tadd(fmt.Sprintf(\"quantifier#%d.max=%d\", quantifiers, maximum), grammarQuantifierMax,\n218|\t\t\t\t\tindex, index+closing+1, minimum, maximum)\n219|\t\t\t}\n220|\t\t\tif minimum >= 1 {\n221|\t\t\t\tadd(fmt.Sprintf(\"quantifier#%d.min=%d\", quantifiers, minimum), grammarQuantifierMin,\n222|\t\t\t\t\tindex, index+closing+1, minimum, maximum)\n223|\t\t\t}\n224|\t\t\tindex += closing\n225|\t\tcase '+':\n226|\t\t\tplusses++\n227|\t\t\tadd(fmt.Sprintf(\"one-or-more#%d\", plusses), grammarOneOrMore, index, index+1, 0, 0)\n228|\t\t}\n229|\t}\n230|\tsort.SliceStable(sites, func(first, second int) bool { return sites[first].dimension < sites[second].dimension })\n231|\treturn sites\n232|}\n233|\n234|func endOfCharacterClass(source string, start int) int {\n235|\tindex := start + 1\n236|\tif index < len(source) && source[index] == '^' {\n237|\t\tindex++\n238|\t}\n239|\tif index < len(source) && source[index] == ']' {\n240|\t\tindex++\n241|\t}\n242|\tfor ; index < len(source); index++ {\n243|\t\tif source[index] == '\\\\' {\n244|\t\t\tindex++\n245|\t\t\tcontinue\n246|\t\t}\n247|\t\tif source[index] == ']' {\n248|\t\t\treturn index\n249|\t\t}\n250|\t}\n251|\treturn len(source) - 1\n252|}\n253|\n254|func parseCountedQuantifier(body string) (int, int, bool) {\n255|\tparts := strings.SplitN(body, \",\", 2)\n256|\tminimum, err := strconv.Atoi(strings.TrimSpace(parts[0]))\n257|\tif err != nil {\n258|\t\treturn 0, 0, false\n259|\t}\n260|\tif len(parts) == 1 {\n261|\t\treturn minimum, minimum, true\n262|\t}\n263|\trest := strings.TrimSpace(parts[1])\n264|\tif rest == \"\" {\n265|\t\treturn minimum, -1, true\n266|\t}\n267|\tmaximum, err := strconv.Atoi(rest)\n268|\tif err != nil {\n269|\t\treturn 0, 0, false\n270|\t}\n271|\treturn minimum, maximum, true\n272|}\n273|\n274|// widenGrammarSource applies the mechanical widening of one dimension: an anchor\n275|// is dropped, a character class becomes any character, a counted maximum gains\n276|// one, a counted minimum loses one, and a one-or-more becomes zero-or-more.\n277|func widenGrammarSource(source string, site grammarSite) string {\n278|\tswitch site.kind {\n279|\tcase grammarAnchorStart, grammarAnchorEnd:\n280|\t\treturn source[:site.start] + source[site.end:]\n281|\tcase grammarClass:\n282|\t\treturn source[:site.start] + \"(?s:.)\" + source[site.end:]\n283|\tcase grammarQuantifierMax:\n284|\t\treturn source[:site.start] + fmt.Sprintf(\"{%d,%d}\", site.minimum, site.maximum+1) + source[site.end:]\n285|\tcase grammarQuantifierMin:\n286|\t\treturn source[:site.start] + fmt.Sprintf(\"{%d,%d}\", site.minimum-1, site.maximum) + source[site.end:]\n287|\tcase grammarOneOrMore:\n288|\t\treturn source[:site.start] + \"*\" + source[site.end:]\n289|\t}\n290|\treturn source\n291|}\n292|\n293|// narrowGrammarSource applies the mechanical narrowing of one character class:\n294|// only its first declared item survives. A refusal-polarity grammar is dangerous\n295|// when it matches LESS, so this is the mutation its witnesses must defeat.\n296|func narrowGrammarSource(source string, site grammarSite) string {\n297|\tif site.kind != grammarClass {\n298|\t\treturn source\n299|\t}\n300|\tbody := source[site.start+1 : site.end-1]\n301|\tfirst := firstCharacterClassItem(body)\n302|\tif first == \"\" {\n303|\t\treturn source\n304|\t}\n305|\treturn source[:site.start] + \"[\" + first + \"]\" + source[site.end:]\n306|}\n307|\n308|func firstCharacterClassItem(body string) string {\n309|\tif body == \"\" {\n310|\t\treturn \"\"\n311|\t}\n312|\tindex := 0\n313|\tif body[index] == '\\\\' && index+1 < len(body) {\n314|\t\tindex += 2\n315|\t} else {\n316|\t\tindex++\n317|\t}\n318|\tif index+1 < len(body) && body[index] == '-' {\n319|\t\tindex += 2\n320|\t}\n321|\treturn body[:index]\n322|}\n323|\n324|// declaredGrammar records what the pinned specification says about one compiled\n325|// grammar, and the production refusal that grammar emits.\n326|//\n327|// refusal is a substring of the message the production call site produces, so\n328|// every witness below is attributed to THIS clause instead of passing on any\n329|// refusal that happens to fire first.\n330|type declaredGrammar struct {\n331|\t// reference is the grammar this package is required to implement, written\n332|\t// here independently of the production source. It is the oracle every\n333|\t// neighbour sweep below consults, so a widened production pattern cannot\n334|\t// move its own goalposts: TestEveryCompiledGrammarMatchesItsPinnedReference\n335|\t// requires the two to be identical, and every other test in this file reads\n336|\t// the reference.\n337|\treference string\n338|\t// composition explains a reference the pinned document declares in more than\n339|\t// one clause, so composing them is disclosed instead of read as a citation.\n340|\tcomposition string\n341|\t// spec is the pinned SPEC declaration, quoted. Empty is not allowed:\n342|\t// implementationDefined records the reason instead.\n343|\tspec string\n344|\t// implementationDefined explains a grammar the pinned document does not\n345|\t// spell out. It is the honest alternative to inventing a citation.\n346|\timplementationDefined string\n347|\trefusal               string\n348|\t// probe is a value that reaches the refusal, used to locate the fixture\n349|\t// positions this grammar governs. Empty selects the universal probe, which\n350|\t// violates every admitting grammar in the package.\n351|\tprobe string\n352|}\n353|\n354|// universalGrammarProbe violates every admitting grammar in this package: it is\n355|// not lowercase, contains a space and a control byte, and starts with neither a\n356|// letter nor a digit. It is used only to LOCATE the fixture positions a grammar\n357|// governs; the witnesses that follow are what prove the grammar's dimensions.\n358|const universalGrammarProbe = \"\\x01 INVALID PROBE \\x02\"\n359|\n360|// declaredGrammars is asserted to cover exactly the derived pattern set by\n361|// TestEveryCompiledGrammarIsDeclaredAndReachable, so a new regexp in production\n362|// fails here until its specification provenance and refusal are recorded.\n363|var declaredGrammars = map[string]declaredGrammar{\n364|\t\"sessionNamePattern\": {\n365|\t\treference: `^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$`,\n366|\t\tspec:      \"Session name | A mesh-unique human alias of 1-64 characters matching [A-Za-z0-9][A-Za-z0-9._-]{0,63}.\",\n367|\t\trefusal:   \"Session Record name must match\",\n368|\t},\n369|\t\"boardLogicalIDPattern\": {\n370|\t\treference: `^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$`,\n371|\t\tspec:      \"logical_id (1-128 characters matching [A-Za-z0-9][A-Za-z0-9._:-]{0,127})\",\n372|\t\trefusal:   \"Board Identity logical_id has invalid grammar\",\n373|\t},\n374|\t\"environmentNamePattern\": {\n375|\t\treference: `^[A-Za-z_][A-Za-z0-9_]{0,127}$`,\n376|\t\tspec:      \"env_names | array<string>[0..64] | Sorted, unique names matching [A-Za-z_][A-Za-z0-9_]{0,127}\",\n377|\t\trefusal:   \"environment-name grammar\",\n378|\t},\n379|\t\"environmentIDPattern\": {\n380|\t\treference: `^[a-z][a-z0-9.-]{0,63}$`,\n381|\t\tspec:      \"environment_id | [a-z][a-z0-9.-]{0,63}; one semantic native environment\",\n382|\t\trefusal:   \"environment_id must match\",\n383|\t},\n384|\t\"providerIdentityKeyPattern\": {\n385|\t\treference: `^[a-z][a-z0-9_.-]{0,63}$`,\n386|\t\tspec:      \"A provider-identity key matches [a-z][a-z0-9_.-]{0,63}.\",\n387|\t\trefusal:   \"opaque_identity key\",\n388|\t},\n389|\t\"reverseDNSPattern\": {\n390|\t\treference: `^[a-z][a-z0-9-]{0,62}(\\.[a-z][a-z0-9-]{0,62})+$`,\n391|\t\tcomposition: \"the pinned clause declares the label grammar and the at-least-one-dot rule in one sentence but \" +\n392|\t\t\t\"spells only the label as a regular expression; the reference composes the two\",\n393|\t\tspec:    \"A reverse-DNS key is 3-253 lowercase ASCII characters, contains at least one dot, and has dot-separated labels matching [a-z][a-z0-9-]{0,62}.\",\n394|\t\trefusal: \"is not a 3..253 character lowercase reverse-DNS name\",\n395|\t},\n396|\t\"mediaTypePattern\": {\n397|\t\treference: \"^[a-z0-9!#$&^_.+%'*`|~-]+/[a-z0-9!#$&^_.+%'*`|~-]+$\",\n398|\t\timplementationDefined: \"the pinned clause says only that \\\"media_type is a lowercase ASCII type/subtype \" +\n399|\t\t\t\"without parameters\\\" and types it string[1..255]; it spells out no character class, so the restricted-name \" +\n400|\t\t\t\"set below is the implementation's reading rather than a citation\",\n401|\t\trefusal: \"media_type must be lowercase ASCII type/subtype without parameters\",\n402|\t},\n403|\t\"observationNamePattern\": {\n404|\t\treference: `^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,7}$`,\n405|\t\tspec:      \"event | observation-name | [a-z][a-z0-9_]*(\\\\.[a-z][a-z0-9_]*){1,7}, 3-128 characters\",\n406|\t\trefusal:   \"Observation Event event must match\",\n407|\t},\n408|\t\"terminalBackendIDPattern\": {\n409|\t\treference: `^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$`,\n410|\t\tspec:      \"terminal_backend_id is 1-128 ASCII bytes matching [a-z][a-z0-9]*(?:[.-][a-z0-9]+)*.\",\n411|\t\trefusal:   \"must match the terminal-backend-id grammar\",\n412|\t},\n413|\t\"lowerSnakePattern\": {\n414|\t\treference: `^[a-z][a-z0-9_]*$`,\n415|\t\t// The pinned table types phase as string[1..128] and describes the case\n416|\t\t// in prose. It declares no character class and no anchoring, so the\n417|\t\t// implementation chooses the grammar; the prose is quoted rather than a\n418|\t\t// regex the document does not contain.\n419|\t\timplementationDefined: \"the pinned table types the member `phase | string[1..128] or null` and describes the \" +\n420|\t\t\t\"case only in prose - \\\"Stable lower-snake-case phase or null\\\" - declaring no character class and no \" +\n421|\t\t\t\"anchoring, so this reference is the implementation's reading of that prose rather than a citation\",\n422|\t\trefusal: \"phase must use lower_snake_case\",\n423|\t},\n424|\t\"semverPattern\": {\n425|\t\treference: `^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`,\n426|\t\t// The pinned document types these members `semver` and states that\n427|\t\t// \"Every independently consumed contract has an independent Semantic\n428|\t\t// Version\". It spells out no regular expression for one, so the\n429|\t\t// production below is the implementation's reading of Semantic\n430|\t\t// Versioning 2.0.0 and is recorded as such rather than cited. The\n431|\t\t// reading is deliberately the WHOLE standard: prerelease and build\n432|\t\t// metadata are part of a valid Semantic Version, so a core-triple-only\n433|\t\t// grammar would refuse `1.2.3-rc.1` on a constraint neither the\n434|\t\t// standard nor the pinned document states.\n435|\t\timplementationDefined: \"the pinned document types the member `semver` and names Semantic Version, but declares no grammar literal for it; the production implements Semantic Versioning 2.0.0 in full, including optional prerelease and build metadata\",\n436|\t\trefusal:               \"must be canonical semver\",\n437|\t},\n438|\t\"windowsAbsolutePathPattern\": {\n439|\t\treference: `^[A-Za-z]:[\\\\/]`,\n440|\t\t// A refusal matcher, not an admission matcher: it exists to catch a\n441|\t\t// Windows drive-absolute path in a member the document requires to be a\n442|\t\t// logical identity. Its risky mutation is NARROWING.\n443|\t\timplementationDefined: \"the pinned clause states only that \\\"An absolute path is machine-local routing data \" +\n444|\t\t\t\"and never a logical identity\\\"; it declares no grammar for a drive-absolute prefix, so this reference \" +\n445|\t\t\t\"is the implementation's Windows drive/UNC detection rather than a citation\",\n446|\t\trefusal: \"must be a logical identity, not an absolute path\",\n447|\t\tprobe:   \"C:/logical\",\n448|\t},\n449|}\n450|\n451|// grammarWitness proves one dimension of one grammar at the production entry.\n452|//\n453|// Every value must be refused there, and the self-check below proves each value\n454|// is admitted by the mechanical mutation of exactly its own dimension, so the\n455|// witness cannot drift into a case that would pass against a widened pattern.\n456|//\n457|// specBound is the bound the PINNED SPECIFICATION declares for a counted\n458|// quantifier, never the implementation constant the derived key carries. The\n459|// coverage test compares the two.\n460|type grammarWitness struct {\n461|\tpattern   string\n462|\tdimension string\n463|\tspecBound int\n464|\tvalues    []string\n465|}\n466|\n467|// subsumedGrammarDimensions records a dimension whose widening cannot change the\n468|// admitted set because an earlier production refusal always fires first. The\n469|// subsuming refusal is named and pinned by the named test, so \"subsumed\" cannot\n470|// be used to wave a dimension through.\n471|var subsumedGrammarDimensions = map[string]struct {\n472|\tsubsumingRefusal string\n473|\tprovingTest      string\n474|}{\n475|\t\"boardLogicalIDPattern|quantifier#1.max=127\": {\n476|\t\tsubsumingRefusal: \"member logical_id must contain 1..128 Unicode characters\",\n477|\t\tprovingTest:      \"TestBoardLogicalIDLengthIsSubsumedByItsDeclaredStringBound\",\n478|\t},\n479|}\n480|\n481|func declaredGrammarWitnesses() []grammarWitness {\n482|\treturn []grammarWitness{\n483|\t\t// Session name: [A-Za-z0-9][A-Za-z0-9._-]{0,63}, 1-64 characters.\n484|\t\t{pattern: \"sessionNamePattern\", dimension: \"anchor.start\", values: []string{\"!Aa\"}},\n485|\t\t{pattern: \"sessionNamePattern\", dimension: \"anchor.end\", values: []string{\"Aa!\"}},\n486|\t\t{pattern: \"sessionNamePattern\", dimension: \"class#1\", values: []string{\"_ab\"}},\n487|\t\t{pattern: \"sessionNamePattern\", dimension: \"class#2\", values: []string{\"Aa b\"}},\n488|\t\t{pattern: \"sessionNamePattern\", dimension: \"quantifier#1.max=63\", specBound: 63,\n489|\t\t\tvalues: []string{\"A\" + strings.Repeat(\"a\", 64)}},\n490|\n491|\t\t// Board logical_id: [A-Za-z0-9][A-Za-z0-9._:-]{0,127}, 1-128 characters.\n492|\t\t{pattern: \"boardLogicalIDPattern\", dimension: \"anchor.start\", values: []string{\"!ab\"}},\n493|\t\t{pattern: \"boardLogicalIDPattern\", dimension: \"anchor.end\", values: []string{\"ab!\"}},\n494|\t\t{pattern: \"boardLogicalIDPattern\", dimension: \"class#1\", values: []string{\"_ab\"}},\n495|\t\t{pattern: \"boardLogicalIDPattern\", dimension: \"class#2\", values: []string{\"ab c\"}},\n496|\n497|\t\t// env_names: [A-Za-z_][A-Za-z0-9_]{0,127}.\n498|\t\t{pattern: \"environmentNamePattern\", dimension: \"anchor.start\", values: []string{\"!AB\"}},\n499|\t\t{pattern: \"environmentNamePattern\", dimension: \"anchor.end\", values: []string{\"AB!\"}},\n500|\t\t{pattern: \"environmentNamePattern\", dimension: \"class#1\", values: []string{\"0AB\"}},\n(more lines below)"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4d5","stream":{"kind":"session","id":"01a06f2d-c4fb-70c0-8c5e-603ce37ec5f8"},"sequence":197,"recorded_at":1780531400000389,"record_type":"event","durability":"durable","causation_id":"02902741-1c1c-40bd-a4a2-4bcb4871f93c","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"02902741-1c1c-40bd-a4a2-4bcb4871f93c","run_stream":{"kind":"run","id":"02902741-1c1c-40bd-a4a2-4bcb4871f93c"},"task_stream":{"kind":"task","id":"33e962cc-ce8c-4dfb-8d10-b438ebcb4762"},"task_id":"33e962cc-ce8c-4dfb-8d10-b438ebcb4762","event":{"kind":"completed","task_id":"33e962cc-ce8c-4dfb-8d10-b438ebcb4762"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4d7","stream":{"kind":"session","id":"01a06f2d-c4fb-70c0-8c5e-603ce37ec5f8"},"sequence":198,"recorded_at":1780531400000391,"record_type":"event","durability":"durable","causation_id":"02902741-1c1c-40bd-a4a2-4bcb4871f93c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"02902741-1c1c-40bd-a4a2-4bcb4871f93c","run_stream":{"kind":"run","id":"02902741-1c1c-40bd-a4a2-4bcb4871f93c"},"task_stream":{"kind":"task","id":"34763ac9-abc9-4f7d-971f-9d48650db401"},"task_id":"34763ac9-abc9-4f7d-971f-9d48650db401","event":{"kind":"output","task_id":"34763ac9-abc9-4f7d-971f-9d48650db401","chunk":"Read text file `internal/terminalbackend/manifest.go`.\n1|// Manifest, Probe, and Capability Evidence admission for the\n2|// TerminalBackend registry.\n3|//\n4|// Normative scope is relux-works/agent-session-manager-spec@v0.5.0 §4.B\n5|// (Manifest/Probe closed schemas, generation digest, reconciliation,\n6|// identity rule), §4.D (closed capability registry, claim rows, evidence\n7|// schema, fact mapping), §6.5 (trust established before any probe;\n8|// configuration admission), and §7.A (generation-bound descriptor binding).\n9|// Lifecycle operations other than admission (create, attach, status, and\n10|// friends) belong to the sibling lifecycle task; this file gates only which\n11|// capabilities an operation may rely on, never the operations themselves.\n12|//\n13|// Fail-closed conventions shared with the registry half of this package:\n14|// every refusal is an *Error with a wire code from the pinned catalog error\n15|// vocabulary and a static Detail clause that never echoes paths, digests,\n16|// generations, or other local data. A partial, malformed, stale, or failed\n17|// Manifest, Probe, or evidence read is an error, never absence or\n18|// availability, so callers must not fall back to a default or to PATH\n19|// discovery.\n20|package terminalbackend\n21|\n22|import (\n23|\t\"bytes\"\n24|\t\"crypto/sha256\"\n25|\t\"encoding/base64\"\n26|\t\"encoding/hex\"\n27|\t\"encoding/json\"\n28|\t\"fmt\"\n29|\t\"strings\"\n30|\t\"time\"\n31|\t\"unicode/utf8\"\n32|\n33|\t\"github.com/gowebpki/jcs\"\n34|\n35|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n36|)\n37|\n38|// Wire error codes this file may report. They extend the registry-half codes\n39|// with the exact Section 15.3 codes for manifest/probe disagreement,\n40|// unevidenced capability use, and integrity failure; every one is a member of\n41|// the pinned catalog error vocabulary.\n42|const (\n43|\t// CodeMismatch reports any failed Manifest/Probe equality, membership,\n44|\t// keyed claim relation, evidence binding, or evidence coverage rule\n45|\t// (§4.B). Malformed Manifest, Probe, or evidence documents also report\n46|\t// this code: a malformed read is an error, never absence.\n47|\tCodeMismatch = \"terminal_backend_manifest_probe_mismatch\"\n48|\t// CodeCapabilityUnproven reports an operation gate evaluated against an\n49|\t// admitted capability set that confers no true capability for the\n50|\t// requested operation (§4.C capability dependencies).\n51|\tCodeCapabilityUnproven = \"terminal_backend_capability_unproven\"\n52|\t// CodeIntegrityFailure reports a missing, malformed, unknown-key, or\n53|\t// invalid capability-evidence signature, or a signature verification\n54|\t// subsystem that is unavailable (§4.D). It fails before capability\n55|\t// admission.\n56|\tCodeIntegrityFailure = \"terminal_backend_integrity_failure\"\n57|)\n58|\n59|// IsMismatch reports CodeMismatch refusals.\n60|func IsMismatch(err error) bool { return errorCode(err, CodeMismatch) }\n61|\n62|// IsCapabilityUnproven reports CodeCapabilityUnproven refusals.\n63|func IsCapabilityUnproven(err error) bool { return errorCode(err, CodeCapabilityUnproven) }\n64|\n65|// IsIntegrityFailure reports CodeIntegrityFailure refusals.\n66|func IsIntegrityFailure(err error) bool { return errorCode(err, CodeIntegrityFailure) }\n67|\n68|// Closed schema literals (§4.B, §4.D). No other schema or version is\n69|// admitted by this file.\n70|const (\n71|\t// SchemaManifest is the Terminal Backend Manifest 1.0.0 schema URN.\n72|\tSchemaManifest = \"urn:ax:schema:terminal-backend-manifest\"\n73|\t// SchemaProbe is the Terminal Backend Probe 1.0.0 schema URN.\n74|\tSchemaProbe = \"urn:ax:schema:terminal-backend-probe\"\n75|\t// SchemaCapabilityEvidence is the Capability Evidence 1.0.0 schema URN.\n76|\tSchemaCapabilityEvidence = \"urn:ax:schema:terminal-capability-evidence\"\n77|\t// SchemaVersion100 is the only contract version this file implements.\n78|\tSchemaVersion100 = \"1.0.0\"\n79|)\n80|\n81|// Closed small vocabularies (§4.B, §4.D).\n82|const (\n83|\t// OriginStatic marks a static manifest echo claim.\n84|\tOriginStatic = \"static\"\n85|\t// OriginProbed marks a live probe observation claim.\n86|\tOriginProbed = \"probed\"\n87|\n88|\t// AvailabilityAvailable marks a ready backend.\n89|\tAvailabilityAvailable = \"available\"\n90|\t// AvailabilityConditional marks a backend that needs operator action.\n91|\tAvailabilityConditional = \"conditional\"\n92|\t// AvailabilityUnavailable marks a backend that cannot serve.\n93|\tAvailabilityUnavailable = \"unavailable\"\n94|\t// AvailabilityUnknown marks a backend whose readiness is not established.\n95|\tAvailabilityUnknown = \"unknown\"\n96|\n97|\t// IssuerRelease marks release-signed capability evidence.\n98|\tIssuerRelease = \"ax_release\"\n99|\t// IssuerLocalProbe marks host-incarnation-signed capability evidence.\n100|\tIssuerLocalProbe = \"ax_local_probe\"\n101|)\n102|\n103|// signatureSchemePrefix is the literal attestation_signature scheme (§4.D).\n104|const signatureSchemePrefix = \"rsa-sha256:\"\n105|\n106|// generationDigestDomain is the UTF-8 domain separator prepended to the\n107|// backend's host-local raw generation bytes before SHA-256 (§4.B). It\n108|// neither reveals nor reconstructs that generation.\n109|const generationDigestDomain = \"ax-terminal-backend-generation-v1\\x00\"\n110|\n111|// evidenceSignatureDomain is the ASCII domain separator prepended to the\n112|// canonical evidence bytes before signing (§4.D).\n113|const evidenceSignatureDomain = \"ax-terminal-capability-evidence-v1\"\n114|\n115|// Closed TerminalBackendCapability registry (§4.D). The map key is the\n116|// capability name; the row carries the exact registry members a Manifest or\n117|// Probe claim must repeat verbatim.\n118|type capabilityRow struct {\n119|\tgenerationVariable   bool\n120|\tdependentOperations  []string\n121|\tevidenceRequirements []string\n122|}\n123|\n124|// capabilityRegistry is the exact 16-value Section 4.D table. Dependent\n125|// operations and evidence requirements are stored sorted as the wire\n126|// requires, so row comparison is element-wise.\n127|var capabilityRegistry = map[string]capabilityRow{\n128|\t\"durable_disconnect\": {\n129|\t\tgenerationVariable:   false,\n130|\t\tdependentOperations:  []string{\"create\", \"status\"},\n131|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n132|\t},\n133|\t\"local_attach\": {\n134|\t\tgenerationVariable:   true,\n135|\t\tdependentOperations:  []string{\"attach\"},\n136|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n137|\t},\n138|\t\"remote_attach\": {\n139|\t\tgenerationVariable:   true,\n140|\t\tdependentOperations:  []string{\"attach\"},\n141|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n142|\t},\n143|\t\"web_attach\": {\n144|\t\tgenerationVariable:   true,\n145|\t\tdependentOperations:  []string{\"attach\"},\n146|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n147|\t},\n148|\t\"multi_attach\": {\n149|\t\tgenerationVariable:   true,\n150|\t\tdependentOperations:  []string{\"attach\"},\n151|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n152|\t},\n153|\t\"headless_creation\": {\n154|\t\tgenerationVariable:   true,\n155|\t\tdependentOperations:  []string{\"create\"},\n156|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n157|\t},\n158|\t\"reboot_restoration\": {\n159|\t\tgenerationVariable:   true,\n160|\t\tdependentOperations:  []string{\"restore\"},\n161|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n162|\t},\n163|\t\"input_quiescence\": {\n164|\t\tgenerationVariable:   true,\n165|\t\tdependentOperations:  []string{\"quiesce-input\"},\n166|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n167|\t},\n168|\t\"safe_boundary_observation\": {\n169|\t\tgenerationVariable:   true,\n170|\t\tdependentOperations:  []string{\"wait-safe-boundary\"},\n171|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n172|\t},\n173|\t\"provider_process_observation\": {\n174|\t\tgenerationVariable:   true,\n175|\t\tdependentOperations:  []string{\"status\", \"terminate-stale\", \"wait-safe-boundary\"},\n176|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n177|\t},\n178|\t\"graceful_stop\": {\n179|\t\tgenerationVariable:   true,\n180|\t\tdependentOperations:  []string{\"request-stop\"},\n181|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n182|\t},\n183|\t\"stale_process_termination\": {\n184|\t\tgenerationVariable:   true,\n185|\t\tdependentOperations:  []string{\"terminate-stale\"},\n186|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n187|\t},\n188|\t\"terminal_state_retention\": {\n189|\t\tgenerationVariable:   true,\n190|\t\tdependentOperations:  []string{\"create\", \"restore\", \"status\"},\n191|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n192|\t},\n193|\t\"scrollback_retention\": {\n194|\t\tgenerationVariable:   true,\n195|\t\tdependentOperations:  []string{\"create\", \"restore\", \"status\"},\n196|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n197|\t},\n198|\t\"credential_capable_execution_realm\": {\n199|\t\tgenerationVariable:  true,\n200|\t\tdependentOperations: []string{\"create\", \"restore\"},\n201|\t\tevidenceRequirements: []string{\n202|\t\t\t\"conformance_fixture\", \"credential_sentinel\", \"provider_auth_smoke\", \"runtime_probe\",\n203|\t\t},\n204|\t},\n205|\t\"multiple_input_clients\": {\n206|\t\tgenerationVariable:   true,\n207|\t\tdependentOperations:  []string{\"attach\"},\n208|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n209|\t},\n210|}\n211|\n212|// credentialRealmCapability is the one capability whose evidence carries the\n213|// terminal-binding, provider, sentinel, and smoke members (§4.D). Every other\n214|// capability's evidence must leave those members null.\n215|const credentialRealmCapability = \"credential_capable_execution_realm\"\n216|\n217|// requirementFact maps every CapabilityEvidenceRequirement to the\n218|// CapabilityEvidenceFact that satisfies it (§4.D). ui_absent and\n219|// prompt_absent are supplementary facts with no requirement mapping: they\n220|// may accompany evidence but never satisfy a requirement alone.\n221|var requirementFact = map[string]string{\n222|\t\"conformance_fixture\":  \"fixture_passed\",\n223|\t\"runtime_probe\":        \"runtime_probe_passed\",\n224|\t\"credential_sentinel\":  \"sentinel_passed\",\n225|\t\"provider_auth_smoke\":  \"provider_auth_passed\",\n226|\t\"policy_authorization\": \"policy_checked\",\n227|}\n228|\n229|// Closed TerminalBackendOperation vocabulary (§4.D).\n230|var operationVocabulary = map[string]bool{\n231|\t\"manifest\": true, \"probe\": true, \"create\": true, \"attach\": true,\n232|\t\"status\": true, \"quiesce-input\": true, \"wait-safe-boundary\": true,\n233|\t\"request-stop\": true, \"terminate-stale\": true, \"restore\": true,\n234|}\n235|\n236|// Closed CapabilityEvidenceRequirement vocabulary (§4.D).\n237|var evidenceRequirementVocabulary = map[string]bool{\n238|\t\"conformance_fixture\": true, \"runtime_probe\": true,\n239|\t\"credential_sentinel\": true, \"provider_auth_smoke\": true,\n240|\t\"policy_authorization\": true,\n241|}\n242|\n243|// Closed CapabilityEvidenceFact vocabulary (§4.D).\n244|var evidenceFactVocabulary = map[string]bool{\n245|\t\"fixture_passed\": true, \"runtime_probe_passed\": true,\n246|\t\"sentinel_passed\": true, \"provider_auth_passed\": true,\n247|\t\"policy_checked\": true, \"ui_absent\": true, \"prompt_absent\": true,\n248|}\n249|\n250|// Document bounds shared by the three closed schemas.\n251|const (\n252|\tmaxClaims          = 16\n253|\tmaxEvidenceIDs     = 256\n254|\tmaxOperations      = 10\n255|\tmaxRequirements    = 5\n256|\tmaxFacts           = 7\n257|\tmaxOpaqueString    = 256\n258|\tmaxJSONDepth       = 32\n259|\tmaxNativeReference = 512\n260|)\n261|\n262|// mismatchf refuses with CodeMismatch and a static detail clause. The clause\n263|// must never interpolate local data: paths, digests, generations, and\n264|// document bytes stay out of errors.\n265|func mismatchf(format string, arguments ...any) *Error {\n266|\treturn &Error{Code: CodeMismatch, Detail: fmt.Sprintf(format, arguments...)}\n267|}\n268|\n269|// decodeStrictObject decodes one JSON object with duplicate-key refusal,\n270|// invalid-UTF-8 refusal, a nesting cap, and trailing-data refusal. Numbers\n271|// decode as json.Number so member validators can refuse them explicitly:\n272|// none of the three closed schemas has a numeric member.\n273|func decodeStrictObject(raw []byte) (map[string]any, error) {\n274|\tif !utf8.Valid(raw) {\n275|\t\treturn nil, mismatchf(\"document encoding\")\n276|\t}\n277|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n278|\tdecoder.UseNumber()\n279|\tvalue, err := decodeCappedValue(decoder, 0)\n280|\tif err != nil {\n281|\t\treturn nil, err\n282|\t}\n283|\tif decoder.More() {\n284|\t\treturn nil, mismatchf(\"document trailing data\")\n285|\t}\n286|\tobject, ok := value.(map[string]any)\n287|\tif !ok {\n288|\t\treturn nil, mismatchf(\"document shape\")\n289|\t}\n290|\treturn object, nil\n291|}\n292|\n293|// decodeCappedValue decodes one JSON value with an explicit depth bound. The\n294|// bound is far above the deepest legitimate nesting (object, claims array,\n295|// claim object, member array) and fails closed below any decoder-stack risk.\n296|func decodeCappedValue(decoder *json.Decoder, depth int) (any, error) {\n297|\tif depth > maxJSONDepth {\n298|\t\treturn nil, mismatchf(\"document nesting\")\n299|\t}\n300|\ttoken, err := decoder.Token()\n301|\tif err != nil {\n302|\t\treturn nil, mismatchf(\"document syntax\")\n303|\t}\n304|\tif delimiter, ok := token.(json.Delim); ok {\n305|\t\tswitch delimiter {\n306|\t\tcase '{':\n307|\t\t\tobject := make(map[string]any)\n308|\t\t\tfor decoder.More() {\n309|\t\t\t\tkeyToken, err := decoder.Token()\n310|\t\t\t\tif err != nil {\n311|\t\t\t\t\treturn nil, mismatchf(\"document syntax\")\n312|\t\t\t\t}\n313|\t\t\t\tkey, ok := keyToken.(string)\n314|\t\t\t\tif !ok {\n315|\t\t\t\t\treturn nil, mismatchf(\"document syntax\")\n316|\t\t\t\t}\n317|\t\t\t\tif _, duplicate := object[key]; duplicate {\n318|\t\t\t\t\treturn nil, mismatchf(\"document duplicate member\")\n319|\t\t\t\t}\n320|\t\t\t\tmember, err := decodeCappedValue(decoder, depth+1)\n321|\t\t\t\tif err != nil {\n322|\t\t\t\t\treturn nil, err\n323|\t\t\t\t}\n324|\t\t\t\tobject[key] = member\n325|\t\t\t}\n326|\t\t\tif _, err := decoder.Token(); err != nil {\n327|\t\t\t\treturn nil, mismatchf(\"document syntax\")\n328|\t\t\t}\n329|\t\t\treturn object, nil\n330|\t\tcase '[':\n331|\t\t\t// Non-nil initialization: an empty wire array must round-trip\n332|\t\t\t// as [] rather than null, or identity recomputation over an\n333|\t\t\t// empty claim or evidence list diverges from the signer.\n334|\t\t\tarray := []any{}\n335|\t\t\tfor decoder.More() {\n336|\t\t\t\tmember, err := decodeCappedValue(decoder, depth+1)\n337|\t\t\t\tif err != nil {\n338|\t\t\t\t\treturn nil, err\n339|\t\t\t\t}\n340|\t\t\t\tarray = append(array, member)\n341|\t\t\t}\n342|\t\t\tif _, err := decoder.Token(); err != nil {\n343|\t\t\t\treturn nil, mismatchf(\"document syntax\")\n344|\t\t\t}\n345|\t\t\treturn array, nil\n346|\t\tdefault:\n347|\t\t\treturn nil, mismatchf(\"document syntax\")\n348|\t\t}\n349|\t}\n350|\treturn token, nil\n351|}\n352|\n353|// checkExactMembers refuses any deviation from the closed member set: an\n354|// unknown member and a missing member are both malformed.\n355|func checkExactMembers(object map[string]any, members []string) error {\n356|\tif len(object) != len(members) {\n357|\t\treturn mismatchf(\"document members\")\n358|\t}\n359|\tfor _, member := range members {\n360|\t\tif _, known := object[member]; !known {\n361|\t\t\treturn mismatchf(\"document members\")\n362|\t\t}\n363|\t}\n364|\treturn nil\n365|}\n366|\n367|// stringMember extracts a required string member. Numbers, booleans, nulls,\n368|// arrays, and objects are refused: no member of these schemas takes them.\n369|func stringMember(object map[string]any, name string) (string, error) {\n370|\tvalue, ok := object[name].(string)\n371|\tif !ok {\n372|\t\treturn \"\", mismatchf(\"document member type\")\n373|\t}\n374|\treturn value, nil\n375|}\n376|\n377|// boundedStringMember extracts a required string[1..256] measured in bytes\n378|// over valid UTF-8, the canonical bound in every containing contract.\n379|func boundedStringMember(object map[string]any, name string) (string, error) {\n380|\tvalue, err := stringMember(object, name)\n381|\tif err != nil {\n382|\t\treturn \"\", err\n383|\t}\n384|\tif !utf8.ValidString(value) || len(value) < 1 || len(value) > maxOpaqueString {\n385|\t\treturn \"\", mismatchf(\"document string bound\")\n386|\t}\n387|\treturn value, nil\n388|}\n389|\n390|// digestMember extracts a required sha256: digest member.\n391|func digestMember(object map[string]any, name string) (string, error) {\n392|\tvalue, err := stringMember(object, name)\n393|\tif err != nil {\n394|\t\treturn \"\", err\n395|\t}\n396|\tif _, err := scalar.ParseDigest(value); err != nil {\n397|\t\treturn \"\", mismatchf(\"document digest\")\n398|\t}\n399|\treturn value, nil\n400|}\n401|\n402|// digestOrNullMember extracts a digest|null member: present and either a\n403|// valid digest or JSON null. Absence is malformed, not null.\n404|func digestOrNullMember(object map[string]any, name string) (string, error) {\n405|\traw, known := object[name]\n406|\tif !known {\n407|\t\treturn \"\", mismatchf(\"document members\")\n408|\t}\n409|\tif raw == nil {\n410|\t\treturn \"\", nil\n411|\t}\n412|\tvalue, ok := raw.(string)\n413|\tif !ok {\n414|\t\treturn \"\", mismatchf(\"document member type\")\n415|\t}\n416|\tif _, err := scalar.ParseDigest(value); err != nil {\n417|\t\treturn \"\", mismatchf(\"document digest\")\n418|\t}\n419|\treturn value, nil\n420|}\n421|\n422|// semverMember extracts a required semver member.\n423|func semverMember(object map[string]any, name string) (string, error) {\n424|\tvalue, err := stringMember(object, name)\n425|\tif err != nil {\n426|\t\treturn \"\", err\n427|\t}\n428|\tif !semverPattern.MatchString(value) {\n429|\t\treturn \"\", mismatchf(\"document semver\")\n430|\t}\n431|\treturn value, nil\n432|}\n433|\n434|// timestampMember extracts a required timestamp member.\n435|func timestampMember(object map[string]any, name string) (scalar.Timestamp, error) {\n436|\tvalue, err := stringMember(object, name)\n437|\tif err != nil {\n438|\t\treturn scalar.Timestamp{}, err\n439|\t}\n440|\tparsed, err := scalar.ParseTimestamp(value)\n441|\tif err != nil {\n442|\t\treturn scalar.Timestamp{}, mismatchf(\"document timestamp\")\n443|\t}\n444|\treturn parsed, nil\n445|}\n446|\n447|// checkExtensions admits exactly the empty object {}. A non-empty extensions\n448|// object requires a later contract version, and absence is malformed.\n449|func checkExtensions(object map[string]any) error {\n450|\traw, known := object[\"extensions\"]\n451|\tif !known {\n452|\t\treturn mismatchf(\"document members\")\n453|\t}\n454|\textensions, ok := raw.(map[string]any)\n455|\tif !ok || len(extensions) != 0 {\n456|\t\treturn mismatchf(\"document extensions\")\n457|\t}\n458|\treturn nil\n459|}\n460|\n461|// stringArrayMember extracts a required array of strings, refusing numbers,\n462|// booleans, nulls, and nested values element-wise.\n463|func stringArrayMember(object map[string]any, name string) ([]string, error) {\n464|\traw, known := object[name]\n465|\tif !known {\n466|\t\treturn nil, mismatchf(\"document members\")\n467|\t}\n468|\tarray, ok := raw.([]any)\n469|\tif !ok {\n470|\t\treturn nil, mismatchf(\"document member type\")\n471|\t}\n472|\tvalues := make([]string, 0, len(array))\n473|\tfor _, member := range array {\n474|\t\tvalue, ok := member.(string)\n475|\t\tif !ok {\n476|\t\t\treturn nil, mismatchf(\"document member type\")\n477|\t\t}\n478|\t\tvalues = append(values, value)\n479|\t}\n480|\treturn values, nil\n481|}\n482|\n483|// checkSortedUnique refuses an unsorted or duplicated string list. Bytewise\n484|// order matches the wire's sorted-unique rule over lowercase ASCII members.\n485|func checkSortedUnique(values []string) error {\n486|\tfor index := range values {\n487|\t\tif index > 0 && values[index-1] >= values[index] {\n488|\t\t\treturn mismatchf(\"document ordering\")\n489|\t\t}\n490|\t}\n491|\treturn nil\n492|}\n493|\n494|// checkClosedList enforces the sorted-unique closed-vocabulary list shape:\n495|// every member in vocabulary, sorted unique, within the inclusive item\n496|// bound. The bound admits zero so [0..N] lists stay usable; [1..N] lists\n497|// are enforced by requiring at least one member.\n498|func checkClosedList(values []string, vocabulary map[string]bool, max int, requireNonEmpty bool) error {\n499|\tif len(values) > max || (requireNonEmpty && len(values) == 0) {\n500|\t\treturn mismatchf(\"document list bound\")\n(more lines below)"}}}
