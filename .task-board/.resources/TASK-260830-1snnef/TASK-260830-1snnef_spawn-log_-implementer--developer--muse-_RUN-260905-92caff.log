{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d341","stream":{"kind":"session","id":"01a06f2d-c4fb-70c0-8c5e-603ce37ec5f8"},"sequence":2043,"recorded_at":1780531400004081,"record_type":"event","durability":"durable","causation_id":"02902741-1c1c-40bd-a4a2-4bcb4871f93c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"02902741-1c1c-40bd-a4a2-4bcb4871f93c","run_stream":{"kind":"run","id":"02902741-1c1c-40bd-a4a2-4bcb4871f93c"},"task_stream":{"kind":"task","id":"1d68fc2f-bd66-4e84-99c1-b83298da9aa2"},"task_id":"1d68fc2f-bd66-4e84-99c1-b83298da9aa2","event":{"kind":"output","task_id":"1d68fc2f-bd66-4e84-99c1-b83298da9aa2","chunk":"Read text file `internal/terminalbackend/manifest.go`.\n(1864 line(s) above)\n1865|// Trust is established before any probe: registration-time trust admission\n1866|// owns executables, and this gate additionally refuses executable\n1867|// substitution as untrusted and any other identity drift as drift.\n1868|//\n1869|// rawGeneration is the AX-known current raw generation for the backend;\n1870|// now is the admission instant; verify authenticates evidence through the\n1871|// trusted key registry and must be non-nil.\n1872|func (registry *Registry) AdmitProbe(manifestRaw, probeRaw []byte, evidenceRaws [][]byte, rawGeneration string, now time.Time, verify SignatureVerifier) (Admitted, error) {\n1873|\tif registry == nil {\n1874|\t\treturn Admitted{}, &Error{Code: CodeNotFound, Detail: \"registry unavailable\"}\n1875|\t}\n1876|\tmanifest, err := ParseManifest(manifestRaw)\n1877|\tif err != nil {\n1878|\t\treturn Admitted{}, err\n1879|\t}\n1880|\trecord, err := registry.Resolve(manifest.TerminalBackendID)\n1881|\tif err != nil {\n1882|\t\treturn Admitted{}, err\n1883|\t}\n1884|\tif err := checkManifestRecordBinding(manifest, record); err != nil {\n1885|\t\treturn Admitted{}, err\n1886|\t}\n1887|\tprobe, err := ParseProbe(probeRaw)\n1888|\tif err != nil {\n1889|\t\treturn Admitted{}, err\n1890|\t}\n1891|\tevidence := make([]Evidence, 0, len(evidenceRaws))\n1892|\tfor _, raw := range evidenceRaws {\n1893|\t\tobject, err := ParseEvidence(raw)\n1894|\t\tif err != nil {\n1895|\t\t\treturn Admitted{}, err\n1896|\t\t}\n1897|\t\tevidence = append(evidence, object)\n1898|\t}\n1899|\treturn Reconcile(manifest, probe, evidence, rawGeneration, now, verify)\n1900|}\n1901|\n1902|// checkManifestRecordBinding binds the Manifest identity tuple to the\n1903|// admitted registry record: implementation version, protocol set, platform\n1904|// set, and kind must match member-for-member, and the executable digest\n(more lines below)"}}}
