 {occ} || {\\\"; \\\".join(hits[:8])}')\\nEOF\\npython3 /tmp/armprobe/map.py > /tmp/armmap.txt; grep -c \\\"\\\" /tmp/armmap.txt; awk -F'\\\\\\\\|\\\\\\\\|' '{print $2}' /tmp/armmap.txt | grep -c \\\"Test\\\" ; grep \\\"|| $\\\" /tmp/armmap.txt | head -n 30\",\n  \"description\": \"Map arms to candidate asserting tests\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"193\\n167\\nmanifest.go | AdmitProbe | ident:CodeNotFound | registry unavailable | #1 || \\nmanifest.go | UnsignedEvidenceBytes | CodeIntegrityFailure | evidence canonical bytes | #1 || \\nmanifest.go | UnsignedEvidenceBytes | CodeIntegrityFailure | evidence canonical bytes | #2 || \\nterminalbackend.go | CheckProviderDescriptor | ident:CodeDrift | descriptor version binding | #1 || \\nterminalbackend.go | CheckProviderDescriptor | ident:CodeNotFound | descriptor backend binding | #1 || \\nterminalbackend.go | CheckProviderDescriptor | ident:CodeStaleGeneration | descriptor generation binding | #1 || \\nterminalbackend.go | CheckVersionTuple | ident:CodeDrift | implementation_version semver | #1 || \\nterminalbackend.go | CheckVersionTuple | ident:CodeDrift | protocol_version major 1 | #1 || \\nterminalbackend.go | CheckVersionTuple | ident:CodeDrift | protocol_version membership | #1 || \\nterminalbackend.go | New | ident:CodeDrift | implementation_version semver | #1 || \\nterminalbackend.go | ParseID | ident:CodeNotFound | terminal_backend_id bound | #1 || \\nterminalbackend.go | RegisterExternal | ident:CodeAmbiguous | duplicate backend_id | #1 || \\nterminalbackend.go | RegisterExternal | ident:CodeAmbiguous | external_trust identity binding | #1 || \\nterminalbackend.go | RegisterExternal | ident:CodeNotFound | registry unavailable | #1 || \\nterminalbackend.go | RegisterExternal | ident:CodeUntrusted | external implementation_kind | #1 || \\nterminalbackend.go | RegisterExternal | ident:CodeUntrusted | external_trust disabled | #1 || \\nterminalbackend.go | RequireR