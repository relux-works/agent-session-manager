albackend.BuiltinConpty,\n97|\t\t\"a\",\n98|\t\t\"tmux\",\n99|\t\t\"ax-tmux\",\n100|\t\t\"vendor.backend-1\",\n101|\t\t\"a0.b1-c2.d3\",\n102|\t\t\"example.terminal-backend\",\n103|\t\t\"a\" + strings.Repeat(\"0\", 127),\n104|\t}\n105|\tfor _, id := range accepted {\n106|\t\tif _, err := terminalbackend.ParseID(id); err != nil {\n107|\t\t\tt.Errorf(\"ParseID(%q) error = %v, want admission\", id, err)\n108|\t\t}\n109|\t}\n110|}\n111|\n112|// TestParseIDRefusesWidenedGrammar narrows the gate instead of only deleting\n113|// it: every case widens exactly one part of the declared character class,\n114|// separator rule, or byte bound, so admitting any of them means the pattern\n115|// was widened rather than merely removed.\n116|func TestParseIDRefusesWidenedGrammar(t *testing.T) {\n117|\tt.Parallel()\n118|\n119|\tcases := []struct {\n120|\t\tname  string\n121|\t\tvalue string\n122|\t}{\n123|\t\t{\"empty\", \"\"},\n124|\t\t{\"one byte past the bound\", strings.Repeat(\"a\", 129)},\n125|\t\t{\"far past the bound\", strings.Repeat(\"a\", 5000)},\n126|\t\t{\"uppercase\", \"AX.TMUX\"},\n127|\t\t{\"mixed case\", \"Ax.Tmux\"},\n128|\t\t{\"leading digit\", \"1ax\"},\n129|\t\t{\"underscore separator\", \"ax_tmux\"},\n130|\t\t{\"space\", \"ax tmux\"},\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
