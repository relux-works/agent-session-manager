{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cf3d","stream":{"kind":"session","id":"01a06f2d-c4fb-70c0-8c5e-603ce37ec5f8"},"sequence":1529,"recorded_at":1780531400003053,"record_type":"event","durability":"durable","causation_id":"02902741-1c1c-40bd-a4a2-4bcb4871f93c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"02902741-1c1c-40bd-a4a2-4bcb4871f93c","run_stream":{"kind":"run","id":"02902741-1c1c-40bd-a4a2-4bcb4871f93c"},"task_stream":{"kind":"task","id":"b3546a31-8f59-4941-b565-940de8182cd1"},"task_id":"b3546a31-8f59-4941-b565-940de8182cd1","event":{"kind":"output","task_id":"b3546a31-8f59-4941-b565-940de8182cd1","chunk":"edited\nchanged lines: lines 353-381\n--- original\n+++ updated\n@@\n-// TestOnlyQuiesceInputEntersQuiescing proves the §4.C exclusivity rule:\n-// across the whole matrix, quiescing is reachable only through\n-// quiesce-input.\n-func TestOnlyQuiesceInputEntersQuiescing(t *testing.T) {\n-\tt.Parallel()\n-\n-\toperations := []string{\n-\t\t\"manifest\", \"probe\", \"create\", \"attach\", \"status\",\n-\t\t\"wait-safe-boundary\", \"request-stop\", \"terminate-stale\", \"restore\",\n-\t}\n-\tsources := []string{\n-\t\t\"\", \"absent\", \"creating\", \"parked\", \"active\",\n-\t\t\"quiescing\", \"stopped\", \"stale_fenced\", \"unavailable\",\n-\t}\n-\tfor _, operation := range operations {\n-\t\tfor _, source := range sources {\n-\t\t\tfor _, interactive := range []bool{false, true} {\n-\t\t\t\ttarget, _, err := terminalbackend.CheckTransition(operation, source, interactive)\n-\t\t\t\tif err != nil {\n-\t\t\t\t\tcontinue\n-\t\t\t\t}\n-\t\t\t\tif target == \"quiescing\" {\n-\t\t\t\t\tt.Errorf(\"CheckTransition(%q, %q) enters quiescing: \"+\n-\t\t\t\t\t\t\"only quiesce-input enters it\", operation, source)\n-\t\t\t\t}\n-\t\t\t}\n-\t\t}\n-\t}\n-}\n+// TestOnlyQuiesceInputEntersQuiescing proves the §4.C exclusivity rule:\n+// entering quiescing from any other state happens only through\n+// quiesce-input. wait-safe-boundary stays in quiescing without entering\n+// it, and status only observes, so both are excluded by the\n+// target-differs-from-source condition rather than by name.\n+func TestOnlyQuiesceInputEntersQuiescing(t *testing.T) {\n+\tt.Parallel()\n+\n+\toperations := []string{\n+\t\t\"create\", \"attach\", \"status\",\n+\t\t\"wait-safe-boundary\", \"request-stop\", \"terminate-stale\", \"restore\",\n+\t}\n+\tsources := []string{\n+\t\t\"absent\", \"creating\", \"parked\", \"active\",\n+\t\t\"quiescing\", \"stopped\", \"stale_fenced\", \"unavailable\",\n+\t}\n+\tfor _, operation := range operations {\n+\t\tfor _, source := range sources {\n+\t\t\tfor _, interactive := range []bool{false, true} {\n+\t\t\t\ttarget, _, err := terminalbackend.CheckTransition(operation, source, interactive)\n+\t\t\t\tif err != nil {\n+\t\t\t\t\tcontinue\n+\t\t\t\t}\n+\t\t\t\tif target == \"quiescing\" && source != \"quiescing\" {\n+\t\t\t\t\tt.Errorf(\"CheckTransition(%q, %q) enters quiescing: \"+\n+\t\t\t\t\t\t\"only quiesce-input enters it\", operation, source)\n+\t\t\t\t}\n+\t\t\t}\n+\t\t}\n+\t}\n+}\n"}}}
