c decodeStrictObject(raw []byte) (map[string]any, error) {\\n296:func decodeCappedValue(decoder *json.Decoder, depth int) (any, error) {\\n355:func checkExactMembers(object map[string]any, members []string) error {\\n369:func stringMember(object map[string]any, name string) (string, error) {\\n379:func boundedStringMember(object map[string]any, name string) (string, error) {\\n391:func digestMember(object map[string]any, name string) (string, error) {\\n404:func digestOrNullMember(object map[string]any, name string) (string, error) {\\n423:func semverMember(object map[string]any, name string) (string, error) {\\n435:func timestampMember(object map[string]any, name string) (scalar.Timestamp, error) {\\n449:func checkExtensions(object map[string]any) error {\\n463:func stringArrayMember(object map[string]any, name string) ([]string, error) {\\n485:func checkSortedUnique(values []string) error {\\n498:func checkClosedList(values []string, vocabulary map[string]bool, max int, requireNonEmpty bool) error {\\n515:func objectIdentity(object map[string]any, selfField string) (string, error) {\\n537:func checkIdentity(object map[string]any, selfField, claimed string) error {\\n555:type Claim struct {\\n575:func parseClaim(raw any, allowProbed bool) (Claim, error) {\\n644:func parseClaimList(raw any, allowProbed bool) ([]Claim, error) {\\n669:func equalClaim(left, right Claim) bool {\\n679:func equalStrings(left, right []string) bool {\\n694:type Manifest struct {\\n720:type Probe struct {\\n755:type Evidence struct {\\n807:var manifestMembers = []string{\\n818:func ParseManifest(raw []byte) (Manifest, error) {\\n829:func parseManifestObject(object map[string]any) (Manifest, error) {\\n913:func validateProtocolList(versions []string) error {\\n929:func parsePlatformList(object map[string]any) ([]scalar.Platform, error) {\\n956:var probeMembers = []string{\\n968:func ParseProbe(raw []byte) (Probe, error) {\\n1095:var evidenceMembers = []string{\\n1111:func ParseEvidence(raw []