{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8d5","stream":{"kind":"session","id":"01a06f2d-c4fb-70c0-8c5e-603ce37ec5f8"},"sequence":709,"recorded_at":1780531400001413,"record_type":"event","durability":"durable","causation_id":"02902741-1c1c-40bd-a4a2-4bcb4871f93c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"02902741-1c1c-40bd-a4a2-4bcb4871f93c","run_stream":{"kind":"run","id":"02902741-1c1c-40bd-a4a2-4bcb4871f93c"},"task_stream":{"kind":"task","id":"cafeeb2c-3616-4a24-bf25-d1b0cb4892f1"},"task_id":"cafeeb2c-3616-4a24-bf25-d1b0cb4892f1","event":{"kind":"output","task_id":"cafeeb2c-3616-4a24-bf25-d1b0cb4892f1","chunk":"Read text file `internal/canonicaljson/grammar_inventory_test.go`.\n(907 line(s) above)\n908|\t\t\t}\n909|\t\t\tcontinue\n910|\t\t}\n911|\t\tdefeated := 0\n912|\t\tfor _, narrowed := range narrowedGrammarVariants(declaredGrammars[witness.pattern].reference, site) {\n913|\t\t\tcompiled := regexp.MustCompile(narrowed)\n914|\t\t\tfor _, value := range witness.values {\n915|\t\t\t\tif !production.MatchString(value) {\n916|\t\t\t\t\tt.Errorf(\"witness %s value %q is not matched by the refusal grammar; it proves nothing\", key, value)\n917|\t\t\t\t}\n918|\t\t\t\tif !compiled.MatchString(value) {\n919|\t\t\t\t\tdefeated++\n920|\t\t\t\t}\n921|\t\t\t}\n922|\t\t}\n923|\t\tif defeated < 2 {\n924|\t\t\tt.Errorf(\n925|\t\t\t\t\"witness %s does not defeat both narrowings of its character class, so narrowing the class would \"+\n926|\t\t\t\t\t\"silently admit an absolute path\", key)\n927|\t\t}\n928|\t}\n929|}\n930|\n931|// narrowedGrammarVariants returns the first-item and last-item narrowings of a\n932|// character class, which are the two ways a declared class can lose members at\n933|// its edges.\n934|func narrowedGrammarVariants(source string, site grammarSite) []string {\n935|\tif site.kind != grammarClass {\n936|\t\treturn nil\n937|\t}\n938|\tbody := source[site.start+1 : site.end-1]\n939|\titems := characterClassItems(body)\n940|\tif len(items) < 2 {\n941|\t\treturn nil\n942|\t}\n943|\treturn []string{\n944|\t\tsource[:site.start] + \"[\" + items[0] + \"]\" + source[site.end:],\n945|\t\tsource[:site.start] + \"[\" + items[len(items)-1] + \"]\" + source[site.end:],\n946|\t}\n947|}\n948|\n949|func characterClassItems(body string) []string {\n950|\tvar items []string\n951|\tfor index := 0; index < len(body); {\n952|\t\tstart := index\n953|\t\tif body[index] == '\\\\' && index+1 < len(body) {\n954|\t\t\tindex += 2\n955|\t\t} else {\n956|\t\t\tindex++\n957|\t\t}\n958|\t\tif index+1 < len(body) && body[index] == '-' {\n959|\t\t\tindex += 2\n960|\t\t}\n961|\t\titems = append(items, body[start:index])\n962|\t}\n963|\treturn items\n964|}\n965|\n966|// TestEveryDeclaredGrammarDimensionIsRefusedAtTheProductionEntry drives every\n967|// witness through CalculateObjectIdentity and VerifyObjectIdentity, or\n968|// ValidateObservationEvent for Section 18.1 objects, at a position located by\n969|// probing rather than hand-wired, and requires the refusal to come from the\n970|// grammar under test rather than from any clause that happens to fire first.\n971|func TestEveryDeclaredGrammarDimensionIsRefusedAtTheProductionEntry(t *testing.T) {\n972|\tpatterns := deriveGrammarPatterns(t)\n973|\tlocated := locateGrammarPositions(t, patterns)\n974|\n975|\tvar admitted, misattributed []string\n976|\tfor _, witness := range declaredGrammarWitnesses() {\n977|\t\tpositions := located[witness.pattern]\n978|\t\tif len(positions) == 0 {\n979|\t\t\tcontinue // reported by TestEveryCompiledGrammarIsDeclaredAndReachable\n980|\t\t}\n981|\t\tposition := positions[0]\n982|\t\tfor _, value := range witness.values {\n983|\t\t\tcandidate := cloneJSONObject(t, position.fixture.object)\n984|\t\t\tif position.key != \"\" {\n985|\t\t\t\trenameObjectKey(t, candidate, position.path, position.key, value)\n986|\t\t\t} else {\n987|\t\t\t\tsetJSONValueAtPath(t, candidate, position.path, value)\n988|\t\t\t}\n989|\t\t\treason := fixtureRefusalReason(t, position.fixture, candidate)\n990|\t\t\tlabel := fmt.Sprintf(\"%s|%s %q at %s\", witness.pattern, witness.dimension, value, position.describe())\n991|\t\t\tif reason == \"\" {\n992|\t\t\t\tadmitted = append(admitted, label)\n993|\t\t\t\tcontinue\n994|\t\t\t}\n995|\t\t\tif !strings.Contains(reason, declaredGrammars[witness.pattern].refusal) {\n996|\t\t\t\tmisattributed = append(misattributed, label+\" refused by another clause: \"+reason)\n997|\t\t\t}\n998|\t\t}\n999|\t}\n1000|\n1001|\tsort.Strings(admitted)\n1002|\tsort.Strings(misattributed)\n1003|\tif len(admitted) > 0 {\n1004|\t\tt.Errorf(\n1005|\t\t\t\"the production entry ADMITTED and attested a value outside a declared grammar:\\n  %s\",\n1006|\t\t\tstrings.Join(admitted, \"\\n  \"))\n1007|\t}\n1008|\tif len(misattributed) > 0 {\n1009|\t\tt.Errorf(\n1010|\t\t\t\"witness(es) refused by a clause other than the grammar under test, so they pin nothing about that \"+\n1011|\t\t\t\t\"grammar:\\n  %s\", strings.Join(misattributed, \"\\n  \"))\n1012|\t}\n1013|}\n1014|\n1015|// TestBoardLogicalIDLengthIsSubsumedByItsDeclaredStringBound pins the one\n1016|// subsumption the grammar inventory claims. Board Identity logical_id is read\n1017|// through requireBoundedString(1, 128) before boardLogicalIDPattern sees it, so\n1018|// the pattern's own {0,127} repetition can never decide a 129-character value:\n1019|// the string bound refuses it first. Widening the repetition to {0,128} is\n1020|// therefore unobservable, and this test proves the ordering rather than assuming\n1021|// it.\n1022|func TestBoardLogicalIDLengthIsSubsumedByItsDeclaredStringBound(t *testing.T) {\n1023|\tconst declaredMaximum = 128\n1024|\n1025|\tatMaximum := \"A\" + strings.Repeat(\"b\", declaredMaximum-1)\n1026|\tpastMaximum := atMaximum + \"c\"\n1027|\tif len(atMaximum) != declaredMaximum {\n1028|\t\tt.Fatalf(\"bound fixture is %d characters, want %d\", len(atMaximum), declaredMaximum)\n1029|\t}\n1030|\n1031|\taccepted := taskBoardSessionRecord(\"TASK-260830-8x76g1\")\n1032|\tsetJSONValueAtPath(t, accepted, []string{\"task_board\", \"board\", \"logical_id\"}, atMaximum)\n1033|\tassertIdentityEntriesAcceptShape(t, mustJSON(t, accepted), SelfRecordID)\n1034|\n1035|\trefused := taskBoardSessionRecord(\"TASK-260830-8x76g1\")\n1036|\tsetJSONValueAtPath(t, refused, []string{\"task_board\", \"board\", \"logical_id\"}, pastMaximum)\n1037|\tassertIdentityEntriesRefuseWithReason(t, mustJSON(t, refused), SelfRecordID,\n1038|\t\tsubsumedGrammarDimensions[\"boardLogicalIDPattern|quantifier#1.max=127\"].subsumingRefusal)\n1039|}\n1040|\n1041|// grammarNeighbourFamilies are the character families a declared grammar can be\n1042|// widened by. They are chosen so that every widening a reviewer would actually\n1043|// write - \"admit uppercase too\", \"allow a hyphen\", \"allow a dot\" - moves at\n1044|// least one generated neighbour from refused to admitted.\n1045|var grammarNeighbourFamilies = []struct {\n1046|\tname      string\n1047|\tcharacter rune\n1048|}{\n1049|\t{\"uppercase\", 'Q'},\n1050|\t{\"lowercase\", 'q'},\n1051|\t{\"digit\", '7'},\n1052|\t{\"underscore\", '_'},\n1053|\t{\"hyphen\", '-'},\n1054|\t{\"dot\", '.'},\n1055|\t{\"colon\", ':'},\n1056|\t{\"slash\", '/'},\n1057|\t{\"space\", ' '},\n1058|\t{\"newline\", '\\n'},\n1059|\t{\"NUL\", '\\x00'},\n1060|\t{\"non-ASCII\", 'é'},\n1061|}\n1062|\n1063|// TestEveryDeclaredGrammarRefusesEveryOneCharacterNeighbourAtTheProductionEntry\n1064|// is the part of the inventory with real killing power, and it hand-writes\n1065|// nothing at all.\n1066|//\n1067|// The dimension witnesses above prove each STRUCTURAL feature with an attributed\n1068|// case, but a single witness per character class is admitted by the maximal\n1069|// widening of that class and says nothing about a narrower one: a mutant that\n1070|// widens [a-z] to [A-Za-z] survives a witness that used a digit. That gap is\n1071|// real - it survived a control mutant on providerIdentityKeyPattern.\n1072|//\n1073|// So this test starts from the value the fixture already carries at the located\n1074|// position, which is by construction a valid member of the declared language,\n1075|// and drives every one-character neighbour of it through the production entry:\n1076|// each position substituted by each character family, each family inserted at\n1077|// each position, and each position deleted. Every neighbour the grammar itself\n1078|// refuses must be refused at the entry. Widening a class by ANY family, dropping\n1079|// an anchor, or relaxing a quantifier moves at least one neighbour into the\n1080|// admitted set and fails here.\n1081|func TestEveryDeclaredGrammarRefusesEveryOneCharacterNeighbourAtTheProductionEntry(t *testing.T) {\n1082|\tpatterns := deriveGrammarPatterns(t)\n1083|\tlocated := locateGrammarPositions(t, patterns)\n1084|\n1085|\texercised := make(map[string]int)\n1086|\tvar admitted []string\n1087|\tfor name, pattern := range patterns {\n1088|\t\tif !pattern.admitting {\n1089|\t\t\t// A refusal matcher has no valid template: its dangerous direction is\n1090|\t\t\t// narrowing, proven by the witness table above.\n1091|\t\t\tcontinue\n1092|\t\t}\n1093|\t\tpositions := located[name]\n1094|\t\tif len(positions) == 0 {\n1095|\t\t\tcontinue // reported by TestEveryCompiledGrammarIsDeclaredAndReachable\n1096|\t\t}\n1097|\t\tposition := positions[0]\n1098|\t\ttemplate := position.key\n1099|\t\tif template == \"\" {\n1100|\t\t\tvalue, ok := jsonValueAtPath(t, position.fixture.object, position.path).(string)\n1101|\t\t\tif !ok {\n1102|\t\t\t\tt.Fatalf(\"located position for %s does not carry a string\", name)\n1103|\t\t\t}\n1104|\t\t\ttemplate = value\n1105|\t\t}\n1106|\t\tproduction := referenceGrammar(t, name)\n1107|\t\tif !production.MatchString(template) {\n1108|\t\t\tt.Fatalf(\n1109|\t\t\t\t\"located template %q for %s is not admitted by the grammar itself, so every neighbour of it is \"+\n1110|\t\t\t\t\t\"vacuous\", template, name)\n1111|\t\t}\n1112|\t\tfor _, neighbour := range oneCharacterNeighbours(template) {\n1113|\t\t\tif production.MatchString(neighbour.value) {\n1114|\t\t\t\tcontinue\n1115|\t\t\t}\n1116|\t\t\tcandidate := cloneJSONObject(t, position.fixture.object)\n1117|\t\t\tif position.key != \"\" {\n1118|\t\t\t\trenameObjectKey(t, candidate, position.path, position.key, neighbour.value)\n1119|\t\t\t} else {\n1120|\t\t\t\tsetJSONValueAtPath(t, candidate, position.path, neighbour.value)\n1121|\t\t\t}\n1122|\t\t\texercised[name]++\n1123|\t\t\tif !fixtureEntriesRefuse(t, position.fixture, candidate) {\n1124|\t\t\t\tadmitted = append(admitted, fmt.Sprintf(\n1125|\t\t\t\t\t\"%s: %s of %q produced %q, which the declared grammar refuses and the production entry attested (%s)\",\n1126|\t\t\t\t\tname, neighbour.description, template, neighbour.value, position.describe()))\n1127|\t\t\t}\n1128|\t\t}\n1129|\t}\n1130|\n1131|\tfor name, pattern := range patterns {\n1132|\t\tif !pattern.admitting || len(located[name]) == 0 {\n1133|\t\t\tcontinue\n1134|\t\t}\n1135|\t\tif exercised[name] == 0 {\n1136|\t\t\tt.Errorf(\"no neighbour of the located template exercised %s; the sweep covers it vacuously\", name)\n1137|\t\t}\n1138|\t}\n1139|\tsort.Strings(admitted)\n1140|\tif len(admitted) > 0 {\n1141|\t\tt.Errorf(\n1142|\t\t\t\"the production entry ADMITTED and attested value(s) outside a declared grammar:\\n  %s\",\n1143|\t\t\tstrings.Join(admitted, \"\\n  \"))\n1144|\t}\n1145|}\n1146|\n1147|type grammarNeighbour struct {\n1148|\tdescription string\n1149|\tvalue       string\n1150|}\n1151|\n1152|// oneCharacterNeighbours returns every value one edit away from a valid one:\n1153|// each position substituted by each family representative, each representative\n1154|// inserted at each boundary, and each position deleted.\n1155|func oneCharacterNeighbours(template string) []grammarNeighbour {\n1156|\trunes := []rune(template)\n1157|\tvar neighbours []grammarNeighbour\n1158|\tfor _, family := range grammarNeighbourFamilies {\n1159|\t\tfor index := range runes {\n1160|\t\t\tmutated := append([]rune{}, runes...)\n1161|\t\t\tmutated[index] = family.character\n1162|\t\t\tneighbours = append(neighbours, grammarNeighbour{\n1163|\t\t\t\tdescription: fmt.Sprintf(\"%s substituted at %d\", family.name, index),\n1164|\t\t\t\tvalue:       string(mutated),\n1165|\t\t\t})\n1166|\t\t}\n1167|\t\tfor index := 0; index <= len(runes); index++ {\n1168|\t\t\tmutated := append([]rune{}, runes[:index]...)\n1169|\t\t\tmutated = append(mutated, family.character)\n1170|\t\t\tmutated = append(mutated, runes[index:]...)\n1171|\t\t\tneighbours = append(neighbours, grammarNeighbour{\n1172|\t\t\t\tdescription: fmt.Sprintf(\"%s inserted at %d\", family.name, index),\n1173|\t\t\t\tvalue:       string(mutated),\n1174|\t\t\t})\n1175|\t\t}\n1176|\t}\n1177|\tfor index := range runes {\n1178|\t\tmutated := append([]rune{}, runes[:index]...)\n1179|\t\tmutated = append(mutated, runes[index+1:]...)\n1180|\t\tneighbours = append(neighbours, grammarNeighbour{\n1181|\t\t\tdescription: fmt.Sprintf(\"character deleted at %d\", index),\n1182|\t\t\tvalue:       string(mutated),\n1183|\t\t})\n1184|\t}\n1185|\treturn neighbours\n1186|}\n1187|\n1188|// referenceGrammar compiles the pinned reference for a declared grammar. Every\n1189|// oracle in this file reads it rather than the production source, so a widened\n1190|// production pattern cannot make its own neighbours look admissible.\n1191|func referenceGrammar(t *testing.T, name string) *regexp.Regexp {\n1192|\tt.Helper()\n1193|\n1194|\tdeclared, ok := declaredGrammars[name]\n1195|\tif !ok || declared.reference == \"\" {\n1196|\t\tt.Fatalf(\"%s has no pinned reference grammar\", name)\n1197|\t}\n1198|\treturn regexp.MustCompile(declared.reference)\n1199|}\n1200|\n1201|// TestEveryCompiledGrammarMatchesItsPinnedReference is the pin that makes every\n1202|// other test in this file mutation-proof.\n1203|//\n1204|// A regular expression IS its language, so pinning the source pins the admitted\n1205|// set exactly - unlike a vocabulary argument list, which pins the members and\n1206|// leaves the comparison free. Widening any production grammar in any dimension\n1207|// fails here immediately; the neighbour sweeps then prove separately that the\n1208|// pinned grammar is actually REACHED and enforced at the production entry,\n1209|// because a pattern pinned but never called promises nothing.\n1210|func TestEveryCompiledGrammarMatchesItsPinnedReference(t *testing.T) {\n1211|\tt.Parallel()\n1212|\n1213|\tfor name, pattern := range deriveGrammarPatterns(t) {\n1214|\t\tdeclared, ok := declaredGrammars[name]\n1215|\t\tif !ok {\n1216|\t\t\tcontinue // reported by TestEveryCompiledGrammarIsDeclaredAndReachable\n1217|\t\t}\n1218|\t\tif declared.reference != pattern.source {\n1219|\t\t\tt.Errorf(\n1220|\t\t\t\t\"production grammar %s is %q but its pinned reference is %q. Widening or narrowing a declared \"+\n1221|\t\t\t\t\t\"grammar is a change to the admitted set and must be reviewed against the pinned specification, \"+\n1222|\t\t\t\t\t\"not made in passing.\",\n1223|\t\t\t\tname, pattern.source, declared.reference)\n1224|\t\t}\n1225|\t}\n1226|}\n1227|\n1228|// TestEveryPinnedGrammarReferenceQuotesItsSpecDeclaration keeps the reference\n1229|// column honest. A reference whose core appears verbatim inside the quoted\n1230|// pinned declaration is checkable against the document; one that does not must\n1231|// say either that the document declares no grammar for it, or which clauses the\n1232|// reference composes.\n1233|func TestEveryPinnedGrammarReferenceQuotesItsSpecDeclaration(t *testing.T) {\n1234|\tt.Parallel()\n1235|\n1236|\tfor name, declared := range declaredGrammars {\n1237|\t\tif declared.spec == \"\" {\n1238|\t\t\tif declared.implementationDefined == \"\" {\n1239|\t\t\t\tt.Errorf(\"%s records neither a pinned SPEC declaration nor an implementation-defined reason\", name)\n1240|\t\t\t}\n1241|\t\t\tcontinue\n1242|\t\t}\n1243|\t\tcore := strings.TrimSuffix(strings.TrimPrefix(declared.reference, \"^\"), \"$\")\n1244|\t\tif strings.Contains(declared.spec, core) {\n1245|\t\t\tif declared.composition != \"\" {\n1246|\t\t\t\tt.Errorf(\"%s discloses a composition but its reference appears verbatim in the quoted declaration\", name)\n1247|\t\t\t}\n1248|\t\t\tcontinue\n1249|\t\t}\n1250|\t\tif declared.composition == \"\" {\n1251|\t\t\tt.Errorf(\n1252|\t\t\t\t\"pinned reference %q for %s does not appear in its quoted declaration %q. Quote the clause that \"+\n1253|\t\t\t\t\t\"declares it, or disclose which clauses the reference composes; do not cite a grammar the \"+\n1254|\t\t\t\t\t\"document does not contain.\",\n1255|\t\t\t\tdeclared.reference, name, declared.spec)\n1256|\t\t}\n1257|\t}\n1258|}\n1259|\n1260|// TestOneCharacterNeighbourGeneratorCoversEveryEditForm is the neighbour sweep's\n1261|// own completeness proof. The sweep's killing power is the SHAPE of the corpus\n1262|// it generates, so silently generating fewer neighbours - dropping insertions,\n1263|// stopping before the final boundary, or skipping deletions - would weaken every\n1264|// grammar in the package while leaving the sweep green. The counts are asserted\n1265|// exactly, and the three edit forms are asserted by value.\n1266|func TestOneCharacterNeighbourGeneratorCoversEveryEditForm(t *testing.T) {\n1267|\tt.Parallel()\n1268|\n1269|\tconst template = \"ab\"\n1270|\tfamilies := len(grammarNeighbourFamilies)\n1271|\trunes := len([]rune(template))\n1272|\n1273|\tneighbours := oneCharacterNeighbours(template)\n1274|\twant := runes*families + (runes+1)*families + runes\n1275|\tif len(neighbours) != want {\n1276|\t\tt.Errorf(\"generated %d neighbours of %q, want %d substitutions, insertions and deletions\",\n1277|\t\t\tlen(neighbours), template, want)\n1278|\t}\n1279|\n1280|\tvalues := make(map[string]bool, len(neighbours))\n1281|\tforms := make(map[string]int)\n1282|\tfor _, neighbour := range neighbours {\n1283|\t\tvalues[neighbour.value] = true\n1284|\t\tswitch {\n1285|\t\tcase strings.Contains(neighbour.description, \"substituted\"):\n1286|\t\t\tforms[\"substituted\"]++\n1287|\t\tcase strings.Contains(neighbour.description, \"inserted\"):\n1288|\t\t\tforms[\"inserted\"]++\n1289|\t\tcase strings.Contains(neighbour.description, \"deleted\"):\n1290|\t\t\tforms[\"deleted\"]++\n1291|\t\t}\n1292|\t}\n1293|\tif forms[\"substituted\"] != runes*families {\n1294|\t\tt.Errorf(\"generated %d substitutions, want %d\", forms[\"substituted\"], runes*families)\n1295|\t}\n1296|\tif forms[\"inserted\"] != (runes+1)*families {\n1297|\t\tt.Errorf(\"generated %d insertions, want %d; an insertion at every boundary is what proves the anchors\",\n1298|\t\t\tforms[\"inserted\"], (runes+1)*families)\n1299|\t}\n1300|\tif forms[\"deleted\"] != runes {\n1301|\t\tt.Errorf(\"generated %d deletions, want %d; deletion is what proves a one-or-more quantifier\", forms[\"deleted\"], runes)\n1302|\t}\n1303|\tfor _, required := range []string{\"Qb\", \"aQ\", \"Qab\", \"aQb\", \"abQ\", \"a\", \"b\"} {\n1304|\t\tif !values[required] {\n1305|\t\t\tt.Errorf(\"the neighbour corpus of %q does not contain %q, so an edit form is missing\", template, required)\n1306|\t\t}\n1307|\t}\n(more lines below)"}}}
