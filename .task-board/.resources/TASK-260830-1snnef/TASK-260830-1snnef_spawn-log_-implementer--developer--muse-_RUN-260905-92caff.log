{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c749","stream":{"kind":"session","id":"01a06f2d-c4fb-70c0-8c5e-603ce37ec5f8"},"sequence":511,"recorded_at":1780531400001017,"record_type":"event","durability":"durable","causation_id":"02902741-1c1c-40bd-a4a2-4bcb4871f93c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"02902741-1c1c-40bd-a4a2-4bcb4871f93c","run_stream":{"kind":"run","id":"02902741-1c1c-40bd-a4a2-4bcb4871f93c"},"task_stream":{"kind":"task","id":"38973646-e3a8-451e-969e-55ddc6538ec5"},"task_id":"38973646-e3a8-451e-969e-55ddc6538ec5","event":{"kind":"output","task_id":"38973646-e3a8-451e-969e-55ddc6538ec5","chunk":"Read text file `internal/cliresult/guard_inventory_test.go`.\n1|package cliresult\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n14|)\n15|\n16|// readerSourceFile is the one production file this leaf added in full, and the\n17|// file the inventory below is derived from exhaustively.\n18|const readerSourceFile = \"client.go\"\n19|\n20|// guardInventoryAnchor is the README heading whose two tables this test pins. It\n21|// is matched exactly, so renaming the heading reddens here instead of silently\n22|// exempting the inventory from measurement.\n23|const guardInventoryAnchor = \"### Refusal guard inventory\"\n24|\n25|// evidenceClasses is the closed vocabulary a row's domain-evidence cell must\n26|// open with. A cell that opened with anything else would be prose again.\n27|var evidenceClasses = []string{\"measured\", \"stated bound\", \"declared subsumed\"}\n28|\n29|// refusalSite is one place the reader refuses, derived from the source rather\n30|// than named by hand: an fmt.Errorf call wrapping one of this package's\n31|// sentinels, identified by the function it sits in and the format literal it\n32|// carries.\n33|type refusalSite struct {\n34|\tfunction string\n35|\tsentinel string\n36|\tformat   string\n37|}\n38|\n39|// derivedRefusalSites walks the reader source and returns every refusal site in\n40|// it. This is the forced traversal: it does not consult the inventory, so a\n41|// guard added to the file appears here whether or not anybody remembered it.\n42|func derivedRefusalSites(t *testing.T) []refusalSite {\n43|\tt.Helper()\n44|\n45|\tfileSet := token.NewFileSet()\n46|\tparsed, err := parser.ParseFile(fileSet, readerSourceFile, nil, 0)\n47|\tif err != nil {\n48|\t\tt.Fatalf(\"parse %s: %v\", readerSourceFile, err)\n49|\t}\n50|\n51|\tvar sites []refusalSite\n52|\tfor _, declaration := range parsed.Decls {\n53|\t\tfunction, isFunction := declaration.(*ast.FuncDecl)\n54|\t\tif !isFunction || function.Body == nil {\n55|\t\t\tcontinue\n56|\t\t}\n57|\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n58|\t\t\tcall, isCall := node.(*ast.CallExpr)\n59|\t\t\tif !isCall {\n60|\t\t\t\treturn true\n61|\t\t\t}\n62|\t\t\tselector, isSelector := call.Fun.(*ast.SelectorExpr)\n63|\t\t\tif !isSelector || selector.Sel.Name != \"Errorf\" {\n64|\t\t\t\treturn true\n65|\t\t\t}\n66|\t\t\tif pkg, isIdent := selector.X.(*ast.Ident); !isIdent || pkg.Name != \"fmt\" {\n67|\t\t\t\treturn true\n68|\t\t\t}\n69|\t\t\tformat, sentinel := \"\", \"\"\n70|\t\t\tfor index, argument := range call.Args {\n71|\t\t\t\tif index == 0 {\n72|\t\t\t\t\tformat = concatenatedStringLiteral(t, argument)\n73|\t\t\t\t\tcontinue\n74|\t\t\t\t}\n75|\t\t\t\tif identifier, isIdent := argument.(*ast.Ident); isIdent &&\n76|\t\t\t\t\tstrings.HasPrefix(identifier.Name, \"Err\") && sentinel == \"\" {\n77|\t\t\t\t\tsentinel = identifier.Name\n78|\t\t\t\t}\n79|\t\t\t}\n80|\t\t\tif sentinel == \"\" {\n81|\t\t\t\tt.Fatalf(\"%s: fmt.Errorf in %s at %s wraps no Err sentinel; the inventory cannot \"+\n82|\t\t\t\t\t\"classify a refusal it cannot name\", readerSourceFile, function.Name.Name,\n83|\t\t\t\t\tfileSet.Position(call.Pos()))\n84|\t\t\t}\n85|\t\t\tif !strings.HasPrefix(format, \"%w\") {\n86|\t\t\t\tt.Fatalf(\"%s: fmt.Errorf in %s at %s does not wrap its sentinel first: %q\",\n87|\t\t\t\t\treaderSourceFile, function.Name.Name, fileSet.Position(call.Pos()), format)\n88|\t\t\t}\n89|\t\t\tsites = append(sites, refusalSite{function: function.Name.Name, sentinel: sentinel, format: format})\n90|\t\t\treturn true\n91|\t\t})\n92|\t}\n93|\tif len(sites) == 0 {\n94|\t\tt.Fatalf(\"derived no refusal site from %s, so this pin measures nothing\", readerSourceFile)\n95|\t}\n96|\treturn sites\n97|}\n98|\n99|// concatenatedStringLiteral flattens `\"a\" + \"b\"` into its text. A format built\n100|// from concatenated literals is common here and must not silently derive as an\n101|// empty marker.\n102|func concatenatedStringLiteral(t *testing.T, expression ast.Expr) string {\n103|\tt.Helper()\n104|\tswitch typed := expression.(type) {\n105|\tcase *ast.BasicLit:\n106|\t\tif typed.Kind != token.STRING {\n107|\t\t\treturn \"\"\n108|\t\t}\n109|\t\tunquoted, err := strconv.Unquote(typed.Value)\n110|\t\tif err != nil {\n111|\t\t\tt.Fatalf(\"unquote %s: %v\", typed.Value, err)\n112|\t\t}\n113|\t\treturn unquoted\n114|\tcase *ast.BinaryExpr:\n115|\t\tif typed.Op != token.ADD {\n116|\t\t\treturn \"\"\n117|\t\t}\n118|\t\treturn concatenatedStringLiteral(t, typed.X) + concatenatedStringLiteral(t, typed.Y)\n119|\tdefault:\n120|\t\treturn \"\"\n121|\t}\n122|}\n123|\n124|// inventoryRow is one row of the README's derived table.\n125|type inventoryRow struct {\n126|\tnumber   string\n127|\tguard    string\n128|\tsentinel string\n129|\tmarker   string\n130|\tevidence string\n131|\ttests    []string\n132|\tline     int\n133|}\n134|\n135|// siblingRow is one row of the README's enumerated table of guards this leaf\n136|// added or reordered outside the reader source.\n137|type siblingRow struct {\n138|\tguard    string\n139|\tfile     string\n140|\tfunction string\n141|\ttests    []string\n142|\tline     int\n143|}\n144|\n145|// readmeInventory locates the two tables under the anchor and parses them. It\n146|// refuses a heading it cannot locate exactly once rather than skipping the\n147|// comparison, which is how a published figure drifts while a suite stays green.\n148|func readmeInventory(t *testing.T) ([]inventoryRow, []siblingRow) {\n149|\tt.Helper()\n150|\n151|\treadme, err := os.ReadFile(filepath.Join(\"..\", \"..\", \"README.md\"))\n152|\tif err != nil {\n153|\t\tt.Fatalf(\"read README.md: %v\", err)\n154|\t}\n155|\tlines := strings.Split(string(readme), \"\\n\")\n156|\tanchor := -1\n157|\tfor index, line := range lines {\n158|\t\tif strings.TrimSpace(line) != guardInventoryAnchor {\n159|\t\t\tcontinue\n160|\t\t}\n161|\t\tif anchor >= 0 {\n162|\t\t\tt.Fatalf(\"README carries the heading %q twice, at lines %d and %d\", guardInventoryAnchor, anchor+1, index+1)\n163|\t\t}\n164|\t\tanchor = index\n165|\t}\n166|\tif anchor < 0 {\n167|\t\tt.Fatalf(\"README carries no heading %q, so the inventory this test pins is not published\", guardInventoryAnchor)\n168|\t}\n169|\n170|\tvar derived []inventoryRow\n171|\tvar siblings []siblingRow\n172|\tfor index := anchor + 1; index < len(lines); index++ {\n173|\t\tline := strings.TrimSpace(lines[index])\n174|\t\tif strings.HasPrefix(line, \"## \") {\n175|\t\t\tbreak\n176|\t\t}\n177|\t\tif !strings.HasPrefix(line, \"|\") {\n178|\t\t\tcontinue\n179|\t\t}\n180|\t\tcells := tableCells(line)\n181|\t\tswitch {\n182|\t\tcase len(cells) == 6 && cells[0] != \"#\" && !strings.HasPrefix(cells[0], \"---\"):\n183|\t\t\tderived = append(derived, inventoryRow{\n184|\t\t\t\tnumber:   cells[0],\n185|\t\t\t\tguard:    cells[1],\n186|\t\t\t\tsentinel: strings.Trim(cells[2], \"`\"),\n187|\t\t\t\tmarker:   strings.Trim(cells[3], \"`\"),\n188|\t\t\t\tevidence: cells[4],\n189|\t\t\t\ttests:    backtickedNames(cells[5]),\n190|\t\t\t\tline:     index + 1,\n191|\t\t\t})\n192|\t\tcase len(cells) == 4 && cells[0] != \"Guard\" && !strings.HasPrefix(cells[0], \"---\"):\n193|\t\t\tsiblings = append(siblings, siblingRow{\n194|\t\t\t\tguard:    cells[0],\n195|\t\t\t\tfile:     strings.Trim(cells[1], \"`\"),\n196|\t\t\t\tfunction: strings.Trim(cells[2], \"`\"),\n197|\t\t\t\ttests:    backtickedNames(cells[3]),\n198|\t\t\t\tline:     index + 1,\n199|\t\t\t})\n200|\t\t}\n201|\t}\n202|\tif len(derived) == 0 || len(siblings) == 0 {\n203|\t\tt.Fatalf(\"parsed %d derived rows and %d sibling rows out of the inventory section\",\n204|\t\t\tlen(derived), len(siblings))\n205|\t}\n206|\treturn derived, siblings\n207|}\n208|\n209|func tableCells(line string) []string {\n210|\ttrimmed := strings.Trim(line, \"|\")\n211|\tparts := strings.Split(trimmed, \"|\")\n212|\tcells := make([]string, 0, len(parts))\n213|\tfor _, part := range parts {\n214|\t\tcells = append(cells, strings.TrimSpace(part))\n215|\t}\n216|\treturn cells\n217|}\n218|\n219|func backtickedNames(cell string) []string {\n220|\tvar names []string\n221|\tfor _, part := range strings.Split(cell, \"`\") {\n222|\t\tif strings.HasPrefix(part, \"Test\") {\n223|\t\t\tnames = append(names, part)\n224|\t\t}\n225|\t}\n226|\treturn names\n227|}\n228|\n229|// declaredTests indexes every test declaration in the repository by name,\n230|// mapping each to the files that declare it. A row naming a test that does not\n231|// exist, or that was renamed, is then a red rather than a row pointing at\n232|// nothing.\n233|func declaredTests(t *testing.T) map[string][]string {\n234|\tt.Helper()\n235|\n236|\tdeclarations := make(map[string][]string)\n237|\troot := filepath.Join(\"..\", \"..\", \"internal\")\n238|\terr := filepath.WalkDir(root, func(path string, entry os.DirEntry, err error) error {\n239|\t\tif err != nil {\n240|\t\t\treturn err\n241|\t\t}\n242|\t\tif entry.IsDir() || !strings.HasSuffix(path, \"_test.go\") {\n243|\t\t\treturn nil\n244|\t\t}\n245|\t\tfileSet := token.NewFileSet()\n246|\t\tparsed, parseErr := parser.ParseFile(fileSet, path, nil, 0)\n247|\t\tif parseErr != nil {\n248|\t\t\treturn parseErr\n249|\t\t}\n250|\t\tfor _, declaration := range parsed.Decls {\n251|\t\t\tfunction, isFunction := declaration.(*ast.FuncDecl)\n252|\t\t\tif !isFunction || !strings.HasPrefix(function.Name.Name, \"Test\") {\n253|\t\t\t\tcontinue\n254|\t\t\t}\n255|\t\t\tdeclarations[function.Name.Name] = append(declarations[function.Name.Name], path)\n256|\t\t}\n257|\t\treturn nil\n258|\t})\n259|\tif err != nil {\n260|\t\tt.Fatalf(\"walk %s: %v\", root, err)\n261|\t}\n262|\tif len(declarations) == 0 {\n263|\t\tt.Fatal(\"indexed no test declarations, so every row below would resolve vacuously\")\n264|\t}\n265|\treturn declarations\n266|}\n267|\n268|// TestTheRefusalGuardInventoryIsDerivedFromTheReaderSource is the mechanism that\n269|// exists because six rounds of review closed one guard at a time and the seventh\n270|// found the twin of the sixth one file away.\n271|//\n272|// The reviewer's round-6 finding was that the ErrUnregisteredExitStatus gate in\n273|// Read was proven at four sampled points while its twin, decodeExitStatus, had\n274|// been swept over the same domain one round earlier. The pattern was applied to\n275|// one of the two because the fix worked from memory rather than from a list.\n276|// This test is that list, and it is derived rather than written: the rows are\n277|// required to be in bijection with the refusal sites the reader source actually\n278|// contains, so a guard added without a row reddens here before a reviewer has to\n279|// find it.\n280|//\n281|// It does not measure whether a guard is well covered - that is each row's own\n282|// named test. It measures that no guard is missing from the traversal, and that\n283|// every row resolves to a real site, a real sentinel and a real test.\n284|func TestTheRefusalGuardInventoryIsDerivedFromTheReaderSource(t *testing.T) {\n285|\tt.Parallel()\n286|\n287|\tsites := derivedRefusalSites(t)\n288|\trows, siblings := readmeInventory(t)\n289|\ttests := declaredTests(t)\n290|\n291|\t// Every row resolves to exactly one derived site.\n292|\tmatchedSite := make([]bool, len(sites))\n293|\tfor _, row := range rows {\n294|\t\tmatches := []int{}\n295|\t\tfor index, site := range sites {\n296|\t\t\tif site.function == row.guardFunction() && site.sentinel == row.sentinel &&\n297|\t\t\t\tstrings.Contains(site.format, row.marker) {\n298|\t\t\t\tmatches = append(matches, index)\n299|\t\t\t}\n300|\t\t}\n301|\t\tif len(matches) != 1 {\n302|\t\t\tt.Fatalf(\"README:%d row %s resolves to %d refusal sites in %s; a row must name exactly one \"+\n303|\t\t\t\t\"(function %q, sentinel %q, marker %q)\",\n304|\t\t\t\trow.line, row.number, len(matches), readerSourceFile,\n305|\t\t\t\trow.guardFunction(), row.sentinel, row.marker)\n306|\t\t}\n307|\t\tif matchedSite[matches[0]] {\n308|\t\t\tt.Fatalf(\"README:%d row %s resolves to a refusal site an earlier row already claimed\",\n309|\t\t\t\trow.line, row.number)\n310|\t\t}\n311|\t\tmatchedSite[matches[0]] = true\n312|\n313|\t\tclassified := false\n314|\t\tfor _, class := range evidenceClasses {\n315|\t\t\tif strings.HasPrefix(row.evidence, class) {\n316|\t\t\t\tclassified = true\n317|\t\t\t}\n318|\t\t}\n319|\t\tif !classified {\n320|\t\t\tt.Fatalf(\"README:%d row %s opens its domain-evidence cell with %q, which is not one of %v\",\n321|\t\t\t\trow.line, row.number, firstWords(row.evidence), evidenceClasses)\n322|\t\t}\n323|\t\tif len(row.tests) == 0 {\n324|\t\t\tt.Fatalf(\"README:%d row %s names no test, so nothing measures it\", row.line, row.number)\n325|\t\t}\n326|\t\tfor _, name := range row.tests {\n327|\t\t\tif _, declared := tests[name]; !declared {\n328|\t\t\t\tt.Fatalf(\"README:%d row %s names %s, which is not declared anywhere under internal/\",\n329|\t\t\t\t\trow.line, row.number, name)\n330|\t\t\t}\n331|\t\t}\n332|\t}\n333|\n334|\t// Every derived site is claimed by a row. This is the direction that would\n335|\t// have caught the round-7 finding: the gate existed in the source and no\n336|\t// row stated what measured it.\n337|\tfor index, claimed := range matchedSite {\n338|\t\tif !claimed {\n339|\t\t\tt.Fatalf(\"%s carries a refusal in %s wrapping %s with the format %q, and no inventory row \"+\n340|\t\t\t\t\"claims it; a guard without a row is a guard nobody traversed\",\n341|\t\t\t\treaderSourceFile, sites[index].function, sites[index].sentinel, sites[index].format)\n342|\t\t}\n343|\t}\n344|\tif len(rows) != len(sites) {\n345|\t\tt.Fatalf(\"the inventory publishes %d rows for %d derived refusal sites\", len(rows), len(sites))\n346|\t}\n347|\n348|\t// The sibling table is enumerated rather than derived, so its pin is\n349|\t// resolution: each named function must be declared in its named file, and\n350|\t// each named test must exist.\n351|\ttwin := false\n352|\tfor _, sibling := range siblings {\n353|\t\tif !declaresFunction(t, filepath.Join(\"..\", \"..\", sibling.file), sibling.function) {\n354|\t\t\tt.Fatalf(\"README:%d names %s in %s, which does not declare it\",\n355|\t\t\t\tsibling.line, sibling.function, sibling.file)\n356|\t\t}\n357|\t\tif len(sibling.tests) == 0 {\n358|\t\t\tt.Fatalf(\"README:%d sibling row %q names no test\", sibling.line, sibling.guard)\n359|\t\t}\n360|\t\tfor _, name := range sibling.tests {\n361|\t\t\tif _, declared := tests[name]; !declared {\n362|\t\t\t\tt.Fatalf(\"README:%d sibling row names %s, which is not declared anywhere under internal/\",\n363|\t\t\t\t\tsibling.line, name)\n364|\t\t\t}\n365|\t\t}\n366|\t\tif sibling.function == \"decodeExitStatus\" {\n367|\t\t\ttwin = true\n368|\t\t}\n369|\t}\n370|\t// The twin is required by name. The whole point of the second table is that\n371|\t// the gate one file away sits next to its counterpart; a table that quietly\n372|\t// dropped it would satisfy every count above.\n373|\tif !twin {\n374|\t\tt.Fatal(\"the sibling table does not carry decodeExitStatus, which is the twin of row 1 and \" +\n375|\t\t\t\"the reason this inventory exists\")\n376|\t}\n377|}\n378|\n379|// guardFunction extracts the function name a derived row names. It is the first\n380|// backticked token of the guard cell, which is the convention the table follows.\n381|func (row inventoryRow) guardFunction() string {\n382|\tfor _, part := range strings.Split(row.guard, \"`\") {\n383|\t\tif part != \"\" && !strings.Contains(part, \" \") {\n384|\t\t\treturn part\n385|\t\t}\n386|\t}\n387|\treturn \"\"\n388|}\n389|\n390|func firstWords(text string) string {\n391|\tif len(text) > 40 {\n392|\t\treturn text[:40]\n393|\t}\n394|\treturn text\n395|}\n396|\n397|func declaresFunction(t *testing.T, path, name string) bool {\n398|\tt.Helper()\n399|\tfileSet := token.NewFileSet()\n400|\tparsed, err := parser.ParseFile(fileSet, path, nil, 0)\n401|\tif err != nil {\n402|\t\tt.Fatalf(\"parse %s: %v\", path, err)\n403|\t}\n404|\tfor _, declaration := range parsed.Decls {\n405|\t\tif function, isFunction := declaration.(*ast.FuncDecl); isFunction && function.Name.Name == name {\n406|\t\t\treturn true\n407|\t\t}\n408|\t}\n409|\treturn false\n410|}\n411|\n412|// TestTheFanInSentenceCannotReportAMapMissAsAMeasurement settles the question\n413|// the round-6 review left open: whether exitStatusIsNotEnough should distinguish\n414|// \"this status carries no registered code\" from \"this status is not in the\n415|// table\".\n416|//\n417|// It computes len(fanIn[status]) with no membership check, so for a status\n418|// outside the Section 15.2 table it would report 0 in the sentence README\n419|// publishes as a measured count - a map miss dressed as a measurement.\n420|//\n421|// The answer is not a defensive branch. A branch no production path can take\n422|// promises nothing and is never measured; what makes the sentence honest is that\n423|// the input it fabricates on cannot reach it, and that is a property to prove\n424|// rather than to comment. This test proves it structurally and numerically:\n425|//\n426|//   - documentSchema, which is the only caller of exitStatusIsNotEnough, has\n427|//     exactly one caller itself, and that caller is Read;\n428|//   - inside Read the ErrUnregisteredExitStatus gate precedes the documentSchema\n429|//     call, so a status outside the table never reaches the sentence; and\n430|//   - for every registered failure status of every registered error version the\n431|//     measured count is at least one, so a 0 in that sentence could only ever\n432|//     have been a map miss.\n433|//\n434|// Reordering the gate behind documentSchema reddens the third bullet of\n435|// TestTheReadLevelExitStatusAdmissionIsSweptOverTheWholeDomain and the position\n436|// assertion here.\n437|func TestTheFanInSentenceCannotReportAMapMissAsAMeasurement(t *testing.T) {\n438|\tt.Parallel()\n439|\n440|\tfileSet := token.NewFileSet()\n441|\tparsed, err := parser.ParseFile(fileSet, readerSourceFile, nil, 0)\n442|\tif err != nil {\n443|\t\tt.Fatalf(\"parse %s: %v\", readerSourceFile, err)\n444|\t}\n445|\n446|\tcallers := make(map[string][]string)\n447|\tpositions := make(map[string]map[string]token.Pos)\n448|\tfor _, declaration := range parsed.Decls {\n449|\t\tfunction, isFunction := declaration.(*ast.FuncDecl)\n450|\t\tif !isFunction || function.Body == nil {\n451|\t\t\tcontinue\n452|\t\t}\n453|\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n454|\t\t\tcall, isCall := node.(*ast.CallExpr)\n455|\t\t\tif !isCall {\n456|\t\t\t\treturn true\n457|\t\t\t}\n458|\t\t\tidentifier, isIdent := call.Fun.(*ast.Ident)\n459|\t\t\tif !isIdent {\n460|\t\t\t\treturn true\n461|\t\t\t}\n462|\t\t\tcallers[identifier.Name] = append(callers[identifier.Name], function.Name.Name)\n463|\t\t\tif positions[function.Name.Name] == nil {\n464|\t\t\t\tpositions[function.Name.Name] = make(map[string]token.Pos)\n465|\t\t\t}\n466|\t\t\tif _, seen := positions[function.Name.Name][identifier.Name]; !seen {\n467|\t\t\t\tpositions[function.Name.Name][identifier.Name] = call.Pos()\n468|\t\t\t}\n469|\t\t\treturn true\n470|\t\t})\n471|\t}\n472|\n473|\tif got := callers[\"documentSchema\"]; len(got) != 1 || got[0] != \"Read\" {\n474|\t\tt.Fatalf(\"documentSchema is called from %v, want exactly [Read]; the fan-in sentence is \"+\n475|\t\t\t\"honest only while every path to it runs through Read's gate\", got)\n476|\t}\n477|\tfor _, caller := range callers[\"exitStatusIsNotEnough\"] {\n478|\t\tif caller != \"documentSchema\" {\n479|\t\t\tt.Fatalf(\"exitStatusIsNotEnough is called from %q, and only documentSchema sits behind \"+\n480|\t\t\t\t\"Read's gate\", caller)\n481|\t\t}\n482|\t}\n483|\tif len(callers[\"exitStatusIsNotEnough\"]) == 0 {\n484|\t\tt.Fatal(\"exitStatusIsNotEnough has no caller in the reader source, so this pin measures nothing\")\n485|\t}\n486|\n487|\t// The gate must precede the call. Its position is taken from the sentinel\n488|\t// reference inside Read, which is the gate's only mention there.\n489|\tvar gate token.Pos\n490|\tfor _, declaration := range parsed.Decls {\n491|\t\tfunction, isFunction := declaration.(*ast.FuncDecl)\n492|\t\tif !isFunction || function.Name.Name != \"Read\" {\n493|\t\t\tcontinue\n494|\t\t}\n495|\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n496|\t\t\tidentifier, isIdent := node.(*ast.Ident)\n497|\t\t\tif isIdent && identifier.Name == \"ErrUnregisteredExitStatus\" && gate == token.NoPos {\n498|\t\t\t\tgate = identifier.Pos()\n499|\t\t\t}\n500|\t\t\treturn true\n(more lines below)"}}}
