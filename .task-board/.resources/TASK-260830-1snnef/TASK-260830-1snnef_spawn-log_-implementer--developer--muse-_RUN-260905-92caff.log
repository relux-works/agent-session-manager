:                     evidence.Issuer,\n1371|\t\t\"issuer_id\":                  evidence.IssuerID,\n1372|\t\t\"facts\":                      stringsToValues(evidence.Facts),\n1373|\t\t\"terminal_binding_id\":        nullableDigest(evidence.TerminalBindingID),\n1374|\t\t\"provider_id\":                nullableString(evidence.ProviderID),\n1375|\t\t\"provider_build\":             nullableString(evidence.ProviderBuild),\n1376|\t\t\"sentinel_result\":            nullableString(evidence.SentinelResult),\n1377|\t\t\"provider_auth_smoke_result\": nullableString(evidence.ProviderAuthSmokeResult),\n1378|\t\t\"extensions\":                 map[string]any{},\n1379|\t}\n1380|\tserialized, err := json.Marshal(object)\n1381|\tif err != nil {\n1382|\t\treturn nil, integrityFailure(\"evidence canonical bytes\")\n1383|\t}\n1384|\tcanonical, err := jcs.Transform(serialized)\n1385|\tif err != nil {\n1386|\t\treturn nil, integrityFailure(\"evidence canonical bytes\")\n1387|\t}\n1388|\tmessage := append([]byte(evidenceSignatureDomain), 0x00)\n1389|\treturn append(message, canonical...), nil\n1390|}\n1391|\n1392|// stringsToValues converts a string list to JSON values.\n1393|func stringsToValues(values []string) []any {\n1394|\tmembers := make([]any, 0, len(values))\n1395|\tfor _, value := range values {\n1396|\t\tmembers = append(members, value)\n1397|\t}\n1398|\treturn members\n1399|}\n1400|\n1401|// nullableDigest renders an empty digest as JSON null.\n1402|func nullableDigest(value string) any {\n1403|\tif value == \"\" {\n1404|\t\treturn nil\n1405|\t}\n1406|\treturn value\n1407|}\n1408|\n1409|// nullableString renders an empty string as JSON null.\n1410|func nullableString(value string) any {\n1411|\tif value == \"\" {\n1412|\t\treturn nil\n1413|\t}\n1414|\treturn value\n1415|}\n1416|\n(more lines below)"}}}
