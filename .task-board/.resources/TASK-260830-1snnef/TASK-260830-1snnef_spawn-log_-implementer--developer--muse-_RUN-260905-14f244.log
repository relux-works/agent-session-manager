{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c715","stream":{"kind":"session","id":"01a071e0-fd9d-7f63-93c7-0936cc7c93be"},"sequence":485,"recorded_at":1780531400000965,"record_type":"event","durability":"durable","causation_id":"96f19a54-66b9-47e5-b9f8-d199deceb070","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"96f19a54-66b9-47e5-b9f8-d199deceb070","run_stream":{"kind":"run","id":"96f19a54-66b9-47e5-b9f8-d199deceb070"},"task_stream":{"kind":"task","id":"940ba846-8952-446e-b7dc-c3df60da422a"},"task_id":"940ba846-8952-446e-b7dc-c3df60da422a","event":{"kind":"output","task_id":"940ba846-8952-446e-b7dc-c3df60da422a","chunk":"{\n  \"chunk_id\": \"exec-23-1\",\n  \"command\": \"head -100 /Users/iv/.claude/skills/project-management/tools/board-cli/cmd/change_request.go\",\n  \"description\": \"Read change request command usage\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"package cmd\\n\\nimport (\\n\\t\\\"context\\\"\\n\\t\\\"errors\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"io/fs\\\"\\n\\t\\\"os\\\"\\n\\t\\\"strconv\\\"\\n\\t\\\"strings\\\"\\n\\n\\t\\\"github.com/aagrigore/task-board/internal/changerequest\\\"\\n\\t\\\"github.com/aagrigore/task-board/internal/spawnruntime\\\"\\n\\t\\\"github.com/aagrigore/task-board/internal/worktree\\\"\\n\\t\\\"github.com/relux-works/skill-agent-facing-api/agentquery\\\"\\n\\tpkgboard \\\"github.com/relux-works/skill-project-management/pkg/board\\\"\\n\\t\\\"github.com/relux-works/skill-project-management/pkg/board/query\\\"\\n\\t\\\"github.com/relux-works/skill-project-management/pkg/remoteconfig\\\"\\n)\\n\\n// changeRequestMutations are the mutations whose persistence is local-only.\\n//\\n// §9.1 scopes the whole managed workspace path to a local authoritative board,\\n// and this is the list the CLI-side refusal is keyed to. It is a var so a test\\n// can assert the exact membership rather than restating it.\\nvar changeRequestMutations = map[string]struct{}{\\n\\t\\\"accept_cr\\\": {},\\n}\\n\\n// MutationRequiresLocalBoard reports whether a mutation name is one of the\\n// Change Request mutations that has no remote persistence path.\\nfunc MutationRequiresLocalBoard(name string) bool {\\n\\t_, ok := changeRequestMutations[strings.ToLower(strings.TrimSpace(name))]\\n\\treturn ok\\n}\\n\\n// rejectRemoteChangeRequestMutation is the §9.1 precondition on the accept_cr\\n// surface (design matrix row 13i).\\n//\\n// It runs in `m`'s validation phase, BEFORE the remote passthrough and before\\n// any local execution, so a refusal writes no CR record, uploads no diff\\n// resource, and mutates no element field. There is no remote Change Request\\n// persistence path: the record lives under the control root and the board-state\\n// commit it feeds has no referent on a server-side board.\\nfunc rejectRemoteChangeRequestMutation(ast *agentquery.Query) error {\\n\\tif ast == nil {\\n\\t\\treturn nil\\n\\t}\\n\\tnamed := \\\"\\\"\\n\\tfor _, statement := range ast.Statements {\\n\\t\\tif MutationRequiresLocalBoard(statement.Operation) {\\n\\t\\t\\tnamed = strings.ToLower(strings.TrimSpace(statement.Operation))\\n\\t\\t\\tbreak\\n\\t\\t}\\n\\t}\\n\\tif named == \\\"\\\" {\\n\\t\\treturn nil\\n\\t}\\n\\tif err := requireWorktreeCapability(); err != nil {\\n\\t\\treturn fmt.Errorf(\\\"%s requires a local authoritative board: %w\\\", named, err)\\n\\t}\\n\\treturn nil\\n}\\n\\n// RegisterChangeRequestMutations registers the Change Request mutations on a\\n// local schema.\\n//\\n// They live here rather than in pkg/board/query for a structural reason, not a\\n// stylistic one: the Change Request store is a control-root filesystem record,\\n// and pkg/board is the library board-server also links. Registering accept_cr\\n// there would put a mutation on the server's surface that the server cannot\\n// implement.\\nfunc RegisterChangeRequestMutations(s *agentquery.Schema[query.BoardItem]) {\\n\\ts.MutationWithMetadata(\\\"accept_cr\\\", func(ctx agentquery.MutationContext[query.BoardItem]) (any, error) {\\n\\t\\treturn runAcceptChangeRequest(ctx)\\n\\t}, agentquery.MutationMetadata{\\n\\t\\tDescription: \\\"Record an evidence-backed reviewer acceptance and route the element to integrating\\\",\\n\\t\\tParameters: []agentquery.ParameterDef{\\n\\t\\t\\t{Name: \\\"id\\\", Type: \\\"string\\\", Required: true, Description: \\\"Element ID carrying the Change Request\\\"},\\n\\t\\t\\t{Name: \\\"revision\\\", Type: \\\"int\\\", Required: true, Description: \\\"Change Request revision being accepted (expected-revision CAS)\\\"},\\n\\t\\t\\t{Name: \\\"evidence\\\", Type: \\\"string\\\", Required: true, Description: \\\"Task-scoped outcome resource name carrying the verdict evidence\\\"},\\n\\t\\t\\t// There is deliberately no commit_ack parameter. A reviewer archetype\\n\\t\\t\\t// must not acknowledge a commit, and acceptance is not a done\\n\\t\\t\\t// transition: the element enters integrating until its bound producer\\n\\t\\t\\t// archetype checkpoints and lands it.\\n\\t\\t},\\n\\t\\tExamples: []string{\\n\\t\\t\\t\\\"accept_cr(TASK-260803-323q82, revision=2, evidence=TASK-260803-323q82_review-verdict.md)\\\",\\n\\t\\t},\\n\\t\\tIdempotent: false,\\n\\t})\\n}\\n\\nfunc runAcceptChangeRequest(ctx agentquery.MutationContext[query.BoardItem]) (any, error) {\\n\\t// §9.1 again, at the mutation itself. The `m` command already refuses before\\n\\t// either transport; this second evaluation is what makes the refusal true of\\n\\t// the mutation rather than only of one command that happens to call it.\\n\\tif err := requireWorktreeCapability(); err != nil {\\n\\t\\treturn nil, fmt.Errorf(\\\"accept_cr requires a local authoritative board: %w\\\", err)\\n\\t}\\n\",\n  \"original_output_bytes\": 4219,\n  \"original_output_tokens\": 1055,\n  \"truncated\": false\n}"}}}
