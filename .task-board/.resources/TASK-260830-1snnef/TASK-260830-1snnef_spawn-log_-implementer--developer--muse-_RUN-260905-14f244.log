{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb05","stream":{"kind":"session","id":"01a071e0-fd9d-7f63-93c7-0936cc7c93be"},"sequence":989,"recorded_at":1780531400001973,"record_type":"event","durability":"durable","causation_id":"96f19a54-66b9-47e5-b9f8-d199deceb070","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"96f19a54-66b9-47e5-b9f8-d199deceb070","run_stream":{"kind":"run","id":"96f19a54-66b9-47e5-b9f8-d199deceb070"},"task_stream":{"kind":"task","id":"1c207ae4-9615-4545-8cf0-2c46c0b70b51"},"task_id":"1c207ae4-9615-4545-8cf0-2c46c0b70b51","event":{"kind":"output","task_id":"1c207ae4-9615-4545-8cf0-2c46c0b70b51","chunk":"{\n  \"chunk_id\": \"exec-49-1\",\n  \"command\": \"task-board m 'check_item(TASK-260830-1snnef, item=16)' && task-board m 'check_item(TASK-260830-1snnef, item=17)' && task-board m 'check_item(TASK-260830-1snnef, item=18)'\",\n  \"description\": \"Check AC-ratio and mutant-evidence items\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"TASK-260830-1snnef\\\",\\\"item\\\":16,\\\"text\\\":\\\"Every command, message, state, or refusal named in the AC is driven through the production entry point by a named committed test, or is declared a stated bound. Report coverage as a ratio — `n of m AC rows driven` — and name the production call site for each. Prose in place of the ratio is not evidence.\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"TASK-260830-1snnef\\\",\\\"item\\\":17,\\\"text\\\":\\\"Every gate ships at least one NARROWING mutant — the gate stays present and is weakened to admit exactly one member of the class it must reject, and a named test must fail. A delete-only mutant proves only that the gate exists and is not accepted as evidence.\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"TASK-260830-1snnef\\\",\\\"item\\\":18,\\\"text\\\":\\\"A gate that inspects source text is additionally attacked by a mutant that PRESERVES the searched-for token and changes behavior, and the mutant harness executes the behavioral suite, not only the static checker.\\\"}}\\n\",\n  \"original_output_bytes\": 1033,\n  \"original_output_tokens\": 259,\n  \"truncated\": false\n}"}}}
