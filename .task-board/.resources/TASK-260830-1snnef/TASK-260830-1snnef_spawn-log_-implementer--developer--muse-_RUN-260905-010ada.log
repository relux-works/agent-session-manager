8|\t\t\t\t\tt.Errorf(\"%s constructs a non-wire error in %s, outside the two allowlisted functions; \"+\n1089|\t\t\t\t\t\t\"a refusal wearing a plain error's clothes ships unwitnessed\", name, functionName)\n1090|\t\t\t\t}\n1091|\t\t\t\treturn true\n1092|\t\t\t})\n1093|\t\t}\n1094|\t\tfor _, declaration := range file.Decls {\n1095|\t\t\tswitch decl := declaration.(type) {\n1096|\t\t\tcase *ast.FuncDecl:\n1097|\t\t\t\tif decl.Body == nil {\n1098|\t\t\t\t\tcontinue\n1099|\t\t\t\t}\n1100|\t\t\t\tfunctionName := decl.Name.Name\n1101|\t\t\t\tif decl.Recv != nil && len(decl.Recv.List) > 0 {\n1102|\t\t\t\t\tfunctionName = receiverTypeName(decl.Recv.List[0].Type) + \".\" + functionName\n1103|\t\t\t\t}\n1104|\t\t\t\tcheck(functionName, decl.Body)\n1105|\t\t\tcase *ast.GenDecl:\n1106|\t\t\t\t// Package-level initializers execute outside any FuncDecl,\n1107|\t\t\t\t// so a plain error assigned to a package var would\n1108|\t\t\t\t// otherwise ship invisible. Attribute its constructions\n1109|\t\t\t\t// to the declared variable name.\n1110|\t\t\t\tfor _, spec := range decl.Specs {\n1111|\t\t\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n1112|\t\t\t\t\tif !ok {\n1113|\t\t\t\t\t\tcontinue\n1114|\t\t\t\t\t}\n1115|\t\t\t\t\tfunctionName := \"var\"\n1116|\t\t\t\t\tif len(value.Names) > 0 {\n1117|\t\t\t\t\t\tfunctionName = value.Names[0].Name\n1118|\t\t\t\t\t}\n1119|\t\t\t\t\tfor _, item := range value.Values {\n1120|\t\t\t\t\t\tcheck(functionName, item)\n1121|\t\t\t\t\t}\n1122|\t\t\t\t}\n1123|\t\t\t}\n1124|\t\t}\n1125|\t}\n1126|}\n1127|\n1128|// isPlainErrorConstruction reports the two recognised plain-error\n1129|// spellings: errors.New and fmt.Errorf (any Errorf-prefixed constructor).\n1130|func isPlainErrorConstruction(call *ast.CallExpr) bool {\n1131|\tselector, ok := call.Fun.(*ast.SelectorExpr)\n1132|\tif !ok {\n1133|\t\treturn false\n1134|\t}\n1135|\treceiver, ok := selector.X.(*ast.Ident)\n1136|\tif !ok {\n1137|\t\treturn false\n1138|\t}\n1139|\tif receiver.Name == \"errors\" && selector.Sel.Name == \"New\" {\n1140|\t\treturn true\n1141|\t}\n1142|\treturn receiver.Name == \"fmt\" && strings.HasPrefix(selector.Sel.Name, \"Errorf\")\n1143|}\n1144|\n1145|// TestDigestFileRefusalsAreNeverWireErrors pins the allowlist's other\n1146|// half behaviorally: DigestFile failures are I/O errors, never *Error,\n1147|// so no caller can mistake them for a registry refusal.\n1148|func TestDigestFileRefusalsAreNeverWireErrors(t *testing.T) {\n1149|\tt.Parallel()\n1150|\n1151|\tfor _, path := range []string{\n1152|\t\tfilepath.Join(\"testdata\", \"no-such-executable\"),\n1153|\t\t\"\",\n1154|\t} {\n1155|\t\t_, err := DigestFile(path)\n1156|\t\tif err == nil {\n1157|\t\t\tt.Errorf(\"DigestFile(%q) = nil, want an I/O error\", path)\n1158|\t\t\tcontinue\n1159|\t\t}\n1160|\t\tvar refusal *Error\n1161|\t\tif errors.As(err, &refusal) {\n1162|\t\t\tt.Errorf(\"DigestFile(%q) error = %v, want a plain I/O error, never a wire refusal\", path, err)\n1163|\t\t}\n1164|\t}\n1165|}"}}}
