{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c551","stream":{"kind":"session","id":"01a06ff2-73b2-7750-92a2-8ff950295c9d"},"sequence":259,"recorded_at":1780531400000513,"record_type":"event","durability":"durable","causation_id":"1b11d441-f4bd-4331-a485-e0ecf0af0397","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1b11d441-f4bd-4331-a485-e0ecf0af0397","run_stream":{"kind":"run","id":"1b11d441-f4bd-4331-a485-e0ecf0af0397"},"task_stream":{"kind":"task","id":"5f017aee-bed6-423f-81ef-5eed5e3d4e84"},"task_id":"5f017aee-bed6-423f-81ef-5eed5e3d4e84","event":{"kind":"output","task_id":"5f017aee-bed6-423f-81ef-5eed5e3d4e84","chunk":"Read text file `internal/terminalbackend/refusal_arm_inventory_test.go`.\n(909 line(s) above)\n910|\t\t}\n911|\t\tif !resolved {\n912|\t\t\tt.Errorf(\"declared row %s names no test touching it: want the detail %q or the entry %q \"+\n913|\t\t\t\t\"with its wire code in %v\", describeRow(row), row.detail, row.entry, row.tests)\n914|\t\t}\n915|\t}\n916|}\n917|\n918|// rowResolves reports whether one test body touches one row.\n919|func rowResolves(row declaredRefusalArm, body string, predicates map[string]string, symbols map[string]string) bool {\n920|\tif row.detail == passthroughDetail {\n921|\t\tfor _, detail := range row.detailSet {\n922|\t\t\tif !strings.Contains(body, detail) {\n923|\t\t\t\treturn false\n924|\t\t\t}\n925|\t\t}\n926|\t\treturn strings.Contains(body, row.entry)\n927|\t}\n928|\tif strings.Contains(body, row.detail) {\n929|\t\treturn true\n930|\t}\n931|\tif row.bound != \"\" {\n932|\t\treturn strings.Contains(body, row.entry)\n933|\t}\n934|\tif !strings.Contains(body, row.entry) {\n935|\t\treturn false\n936|\t}\n937|\tif strings.Contains(body, symbols[row.code]) {\n938|\t\treturn true\n939|\t}\n940|\tfor predicate, code := range predicates {\n941|\t\tif code == row.code && strings.Contains(body, predicate) {\n942|\t\t\treturn true\n943|\t\t}\n944|\t}\n945|\treturn false\n946|}\n947|\n948|// TestDefensiveBoundsAreExactlyThese pins the set of bound rows: a new\n949|// defensive arm must join this set deliberately, with its bound stated,\n950|// rather than slipping in as an ordinary row whose test cannot reach it.\n951|func TestDefensiveBoundsAreExactlyThese(t *testing.T) {\n952|\tt.Parallel()\n953|\n954|\twant := map[string]bool{\n955|\t\t\"conformance.go ParseAttachAuthorization CodeMismatch \\\"document timestamp\\\" #1\": true,\n956|\t\t\"conformance.go ParseAttachAuthorization CodeMismatch \\\"document timestamp\\\" #2\": true,\n957|\t\t\"conformance.go CheckAttachRequest CodeMismatch \\\"document timestamp\\\" #1\":       true,\n958|\t\t\"manifest.go checkEvidenceLiveness CodeMismatch \\\"document timestamp\\\" #1\":       true,\n959|\t\t\"manifest.go checkEvidenceLiveness CodeMismatch \\\"document timestamp\\\" #2\":       true,\n960|\t}\n961|\tfor _, row := range declaredRows() {\n962|\t\tif row.bound == \"\" {\n963|\t\t\tcontinue\n964|\t\t}\n965|\t\tif row.bound != boundDefensiveReparse {\n966|\t\t\tt.Errorf(\"declared row %s carries an unrecognized bound %q\",\n967|\t\t\t\tdescribeRow(row), row.bound)\n968|\t\t\tcontinue\n969|\t\t}\n970|\t\tif !want[describeRow(row)] {\n971|\t\t\tt.Errorf(\"declared row %s claims a bound outside the pinned set; \"+\n972|\t\t\t\t\"a new defensive arm joins deliberately or not at all\", describeRow(row))\n973|\t\t}\n974|\t}\n975|\tbound := 0\n976|\tfor _, row := range declaredRows() {\n977|\t\tif row.bound != \"\" {\n978|\t\t\tbound++\n979|\t\t}\n980|\t}\n981|\tif bound != len(want) {\n982|\t\tt.Errorf(\"declared %d bound rows, want exactly the pinned %d\", bound, len(want))\n983|\t}\n984|}\n985|\n986|// TestPlatformFunnelDetailsAreExactlyThese derives the error set of\n987|// validatePlatforms from the production AST and requires it to equal the\n988|// funneled set: a fourth platform error widens the funnel this test pins.\n989|func TestPlatformFunnelDetailsAreExactlyThese(t *testing.T) {\n990|\tt.Parallel()\n991|\n992|\tfileSet := token.NewFileSet()\n993|\tfile, err := parser.ParseFile(fileSet, \"terminalbackend.go\", nil, 0)\n994|\tif err != nil {\n995|\t\tt.Fatalf(\"parse terminalbackend.go: %v\", err)\n996|\t}\n997|\tdetails := map[string]bool{}\n998|\tfor _, declaration := range file.Decls {\n999|\t\tfunction, ok := declaration.(*ast.FuncDecl)\n1000|\t\tif !ok || function.Name.Name != \"validatePlatforms\" {\n1001|\t\t\tcontinue\n1002|\t\t}\n1003|\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n1004|\t\t\tcall, ok := node.(*ast.CallExpr)\n1005|\t\t\tif !ok {\n1006|\t\t\t\treturn true\n1007|\t\t\t}\n1008|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n1009|\t\t\tif !ok || selector.Sel.Name != \"New\" {\n1010|\t\t\t\treturn true\n1011|\t\t\t}\n1012|\t\t\treceiver, ok := selector.X.(*ast.Ident)\n1013|\t\t\tif !ok || receiver.Name != \"errors\" || len(call.Args) != 1 {\n1014|\t\t\t\treturn true\n1015|\t\t\t}\n1016|\t\t\tliteral, ok := call.Args[0].(*ast.BasicLit)\n1017|\t\t\tif !ok || literal.Kind != token.STRING {\n1018|\t\t\t\tt.Fatalf(\"validatePlatforms error is not a static literal\")\n1019|\t\t\t\treturn true\n1020|\t\t\t}\n1021|\t\t\tdetail, err := strconv.Unquote(literal.Value)\n1022|\t\t\tif err != nil {\n1023|\t\t\t\tt.Fatalf(\"unquote platform error: %v\", err)\n1024|\t\t\t}\n1025|\t\t\tdetails[detail] = true\n1026|\t\t\treturn true\n1027|\t\t})\n1028|\t}\n1029|\tif len(details) == 0 {\n1030|\t\tt.Fatal(\"derived zero platform errors; the scanner is broken, not the package\")\n1031|\t}\n1032|\tfor _, want := range funneledPlatformDetails {\n1033|\t\tif !details[want] {\n1034|\t\t\tt.Errorf(\"funneled detail %q no longer derives from validatePlatforms\", want)\n1035|\t\t}\n1036|\t}\n1037|\tfor detail := range details {\n1038|\t\tknown := false\n1039|\t\tfor _, want := range funneledPlatformDetails {\n1040|\t\t\tif detail == want {\n1041|\t\t\t\tknown = true\n1042|\t\t\t}\n1043|\t\t}\n1044|\t\tif !known {\n1