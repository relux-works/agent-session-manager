{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3cf","stream":{"kind":"session","id":"01a06ff2-73b2-7750-92a2-8ff950295c9d"},"sequence":66,"recorded_at":1780531400000127,"record_type":"event","durability":"durable","causation_id":"1b11d441-f4bd-4331-a485-e0ecf0af0397","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1b11d441-f4bd-4331-a485-e0ecf0af0397","run_stream":{"kind":"run","id":"1b11d441-f4bd-4331-a485-e0ecf0af0397"},"task_stream":{"kind":"task","id":"76b63a05-0331-4500-852d-d86e949f5b4b"},"task_id":"76b63a05-0331-4500-852d-d86e949f5b4b","event":{"kind":"output","task_id":"76b63a05-0331-4500-852d-d86e949f5b4b","chunk":"Read text file `internal/terminalbackend/conformance_test.go`.\n1|package terminalbackend_test\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"go/ast\"\n6|\t\"go/parser\"\n7|\t\"go/token\"\n8|\t\"reflect\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\t\"time\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n16|\tterminalbackend \"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n17|)\n18|\n19|const (\n20|\tconformanceSessionA = \"0198f4c8-8e50-7f66-8f70-1234567890ab\"\n21|\tconformanceSessionB = \"0198f4c8-8e50-7f66-8f70-1234567890ac\"\n22|\tconformanceHost     = \"0198f4c8-8e50-7f66-8f70-aaaaaaaaaaa1\"\n23|\tconformanceIssued   = \"2026-09-01T00:00:00.000Z\"\n24|\tconformanceExpires  = \"2026-09-02T00:00:00.000Z\"\n25|)\n26|\n27|func conformanceNow() time.Time {\n28|\tnow, err := time.Parse(time.RFC3339Nano, \"2026-09-01T12:00:00.000Z\")\n29|\tif err != nil {\n30|\t\tpanic(err)\n31|\t}\n32|\treturn now\n33|}\n34|\n35|func testAttachAuthorization(t *testing.T) terminalbackend.AttachAuthorization {\n36|\tt.Helper()\n37|\n38|\traw := `{\"policy_evidence_id\":\"` + testDigest + `\",` +\n39|\t\t`\"authorizing_host_id\":\"` + conformanceHost + `\",` +\n40|\t\t`\"transport\":\"local_only\",` +\n41|\t\t`\"input_authorized\":true,` +\n42|\t\t`\"issued_at\":\"` + conformanceIssued + `\",` +\n43|\t\t`\"expires_at\":\"` + conformanceExpires + `\"}`\n44|\n45|\tauth, err := terminalbackend.ParseAttachAuthorization([]byte(raw))\n46|\tif err != nil {\n47|\t\tt.Fatalf(\"ParseAttachAuthorization() error = %v\", err)\n48|\t}\n49|\treturn auth\n50|}\n51|\n52|func requireConformanceRefusal(t *testing.T, err error, wantCode, wantDetail string) {\n53|\tt.Helper()\n54|\n55|\tvar refusal *terminalbackend.Error\n56|\tif !errors.As(err, &refusal) {\n57|\t\tt.Fatalf(\"error = %v, want *Error with code %q at %q\", err, wantCode, wantDetail)\n58|\t}\n59|\tif refusal.Code != wantCode || refusal.Detail != wantDetail {\n60|\t\tt.Errorf(\"refusal = %q at %q, want %q at %q\", refusal.Code, refusal.Detail, wantCode, wantDetail)\n61|\t}\n62|}\n63|\n64|// TestParseInstanceStateAdmitsOnlyTheEightClosedStates drives the state\n65|// domain at the production entry: every member of the §4.C enum is\n66|// admitted, and refused samples are refused as a protocol error rather\n67|// than mapped onto a near neighbour. The refused list is a sampling\n68|// bound over an unbounded string domain, not a closure — it pins the\n69|// refusal shape. The closure is derived: the admitted set must equal the\n70|// parser's switch-case list exactly (pinned by\n71|// TestDerivedVocabulariesAreExactlyTheAdmittedSets), so a ninth admitted\n72|// state reddens there even though no refused sample names it.\n73|func TestParseInstanceStateAdmitsOnlyTheEightClosedStates(t *testing.T) {\n74|\tt.Parallel()\n75|\n76|\tfor _, state := range []string{\n77|\t\t\"absent\", \"creating\", \"parked\", \"active\",\n78|\t\t\"quiescing\", \"stopped\", \"stale_fenced\", \"unavailable\",\n79|\t} {\n80|\t\tif _, err := terminalbackend.ParseInstanceState(state); err != nil {\n81|\t\t\tt.Errorf(\"ParseInstanceState(%q) error = %v, want admission\", state, err)\n82|\t\t}\n83|\t}\n84|\tfor _, state := range []string{\n85|\t\t\"\", \"Absent\", \"ACTIVE\", \"running\", \"detached\", \"stale-fenced\",\n86|\t\t\"parked \", \" parked\", \"absent\\x00\", \"creating\\n\",\n87|\t\tstrings.Repeat(\"a\", 1024),\n88|\t} {\n89|\t\t_, err := terminalbackend.ParseInstanceState(state)\n90|\t\trequireConformanceRefusal(t, err,\n91|\t\t\t\"terminal_backend_protocol_error\", \"lifecycle state vocabulary\")\n92|\t}\n93|}\n94|\n95|// TestParseOperationAdmitsOnlyTheTenClosedOperations drives the operation\n96|// domain at the production entry: every member of the §4.D enum is\n97|// admitted. The refused list is a sampling bound over an unbounded\n98|// string domain, not a closure — it pins the refusal shape. The closure\n99|// is derived: the admitted set must equal the parser's switch-case list\n100|// exactly (pinned by TestDerivedVocabulariesAreExactlyTheAdmittedSets),\n101|// so an eleventh admitted operation reddens there even though no refused\n102|// sample names it.\n103|func TestParseOperationAdmitsOnlyTheTenClosedOperations(t *testing.T) {\n104|\tt.Parallel()\n105|\n106|\tfor _, operation := range []string{\n107|\t\t\"manifest\", \"probe\", \"create\", \"attach\", \"status\",\n108|\t\t\"quiesce-input\", \"wait-safe-boundary\", \"request-stop\",\n109|\t\t\"terminate-stale\", \"restore\",\n110|\t} {\n111|\t\tif _, err := terminalbackend.ParseOperation(operation); err != nil {\n112|\t\t\tt.Errorf(\"ParseOperation(%q) error = %v, want admission\", operation, err)\n113|\t\t}\n114|\t}\n115|\tfor _, operation := range []string{\n116|\t\t\"\", \"Create\", \"ATTACH\", \"quiesce_input\", \"quiesce\", \"detach\",\n117|\t\t\"status \", \" create\", \"terminate_stale\", \"delete\",\n118|\t\tstrings.Repeat(\"a\", 1024),\n119|\t} {\n120|\t\t_, err := terminalbackend.ParseOperation(operation)\n121|\t\trequireConformanceRefusal(t, err,\n122|\t\t\t\"terminal_backend_protocol_error\", \"operation vocabulary\")\n123|\t}\n124|}\n125|\n126|// transitionFixture is one exact §4.C table row restated as an expectation:\n127|// every allowed source of one operation with its success target and exact\n128|// side effects.\n129|type transitionFixture struct {\n130|\toperation   string\n131|\tsource      string\n132|\tinteractive bool\n133|\ttarget      string\n134|\teffects     []string\n135|}\n136|\n137|// TestCheckTransitionAdmitsEveryTableRow drives the whole §4.C matrix\n138|// through the production entry: 8 status observations, both create\n139|// targets, both attach sources, and every other row with its exact side\n140|// effects. manifest and probe carry no instance source or target.\n141|func TestCheckTransitionAdmitsEveryTableRow(t *testing.T) {\n142|\tt.Parallel()\n143|\n144|\tstatusSources := []string{\n145|\t\t\"absent\", \"creating\", \"parked\", \"active\",\n146|\t\t\"quiescing\", \"stopped\", \"stale_fenced\", \"unavailable\",\n147|\t}\n148|\tvar fixtures []transitionFixture\n149|\tfor _, source := range statusSources {\n150|\t\tfixtures = append(fixtures, transitionFixture{\n151|\t\t\toperation: \"status\", source: source, target: source,\n152|\t\t})\n153|\t}\n154|\tfixtures = append(fixtures,\n155|\t\ttransitionFixture{\n156|\t\t\toperation: \"create\", source: \"absent\", interactive: true,\n157|\t\t\ttarget:  \"active\",\n158|\t\t\teffects: []string{\"binding_persisted\", \"wrapper_started\"},\n159|\t\t},\n160|\t\ttransitionFixture{\n161|\t\t\toperation: \"create\", source: \"stopped\", interactive: true,\n162|\t\t\ttarget:  \"active\",\n163|\t\t\teffects: []string{\"binding_persisted\", \"wrapper_started\"},\n164|\t\t},\n165|\t\ttransitionFixture{\n166|\t\t\toperation: \"create\", source: \"absent\", interactive: false,\n167|\t\t\ttarget:  \"parked\",\n168|\t\t\teffects: []string{\"binding_persisted\", \"wrapper_started\"},\n169|\t\t},\n170|\t\ttransitionFixture{\n171|\t\t\toperation: \"create\", source: \"stopped\", interactive: false,\n172|\t\t\ttarget:  \"parked\",\n173|\t\t\teffects: []string{\"binding_persisted\", \"wrapper_started\"},\n174|\t\t},\n175|\t\ttransitionFixture{\n176|\t\t\toperation: \"attach\", source: \"parked\", target: \"active\",\n177|\t\t\teffects: []string{\"attach_client_created\"},\n178|\t\t},\n179|\t\ttransitionFixture{\n180|\t\t\toperation: \"attach\", source: \"active\", target: \"active\",\n181|\t\t\teffects: []string{\"attach_client_created\"},\n182|\t\t},\n183|\t\ttransitionFixture{\n184|\t\t\toperation: \"quiesce-input\", source: \"active\", target: \"quiescing\",\n185|\t\t\teffects: []string{\"input_closed\"},\n186|\t\t},\n187|\t\ttransitionFixture{\n188|\t\t\toperation: \"quiesce-input\", source: \"parked\", target: \"quiescing\",\n189|\t\t\teffects: []string{\"input_closed\"},\n190|\t\t},\n191|\t\ttransitionFixture{\n192|\t\t\toperation: \"wait-safe-boundary\", source: \"quiescing\", target: \"quiescing\",\n193|\t\t\teffects: []string{\"safe_boundary_observed\"},\n194|\t\t},\n195|\t\ttransitionFixture{\n196|\t\t\toperation: \"request-stop\", source: \"quiescing\", target: \"stopped\",\n197|\t\t\teffects: []string{\n198|\t\t\t\t\"graceful_stop_requested\", \"process_closed\", \"backend_store_closed\",\n199|\t\t\t},\n200|\t\t},\n201|\t\ttransitionFixture{\n202|\t\t\toperation: \"terminate-stale\", source: \"stale_fenced\", target: \"stopped\",\n203|\t\t\teffects: []string{\"stale_incarnation_terminated\", \"process_closed\"},\n204|\t\t},\n205|\t\ttransitionFixture{\n206|\t\t\toperation: \"terminate-stale\", source: \"unavailable\", target: \"stopped\",\n207|\t\t\teffects: []string{\"stale_incarnation_terminated\", \"process_closed\"},\n208|\t\t},\n209|\t\ttransitionFixture{\n210|\t\t\toperation: \"restore\", source: \"absent\", target: \"parked\",\n211|\t\t\teffects: []string{\"binding_persisted\", \"wrapper_restored\"},\n212|\t\t},\n213|\t\ttransitionFixture{\n214|\t\t\toperation: \"restore\", source: \"stopped\", target: \"parked\",\n215|\t\t\teffects: []string{\"binding_persisted\", \"wrapper_restored\"},\n216|\t\t},\n217|\t\ttransitionFixture{\n218|\t\t\toperation: \"restore\", source: \"unavailable\", target: \"parked\",\n219|\t\t\teffects: []string{\"binding_persisted\", \"wrapper_restored\"},\n220|\t\t},\n221|\t)\n222|\n223|\tfor _, fixture := range fixtures {\n224|\t\ttarget, effects, err := terminalbackend.CheckTransition(\n225|\t\t\tfixture.operation, fixture.source, fixture.interactive)\n226|\t\tif err != nil {\n227|\t\t\tt.Errorf(\"CheckTransition(%q, %q, interactive=%v) error = %v\",\n228|\t\t\t\tfixture.operation, fixture.source, fixture.interactive, err)\n229|\t\t\tcontinue\n230|\t\t}\n231|\t\tif string(target) != fixture.target {\n232|\t\t\tt.Errorf(\"CheckTransition(%q, %q, interactive=%v) target = %q, want %q\",\n233|\t\t\t\tfixture.operation, fixture.source, fixture.interactive, target, fixture.target)\n234|\t\t}\n235|\t\tvar got []string\n236|\t\tfor _, effect := range effects {\n237|\t\t\tgot = append(got, string(effect))\n238|\t\t}\n239|\t\tif len(got) != len(fixture.effects) {\n240|\t\t\tt.Errorf(\"CheckTransition(%q, %q) effects = %v, want %v\",\n241|\t\t\t\tfixture.operation, fixture.source, got, fixture.effects)\n242|\t\t\tcontinue\n243|\t\t}\n244|\t\tfor index := range got {\n245|\t\t\tif got[index] != fixture.effects[index] {\n246|\t\t\t\tt.Errorf(\"CheckTransition(%q, %q) effects = %v, want %v\",\n247|\t\t\t\t\tfixture.operation, fixture.source, got, fixture.effects)\n248|\t\t\t\tbreak\n249|\t\t\t}\n250|\t\t}\n251|\t}\n252|\n253|\tfor _, operation := range []string{\"manifest\", \"probe\"} {\n254|\t\ttarget, effects, err := terminalbackend.CheckTransition(operation, \"\", false)\n255|\t\tif err != nil {\n256|\t\t\tt.Errorf(\"CheckTransition(%q, %q) error = %v, want admission\", operation, \"\", err)\n257|\t\t\tcontinue\n258|\t\t}\n259|\t\tif target != \"\" || len(effects) != 0 {\n260|\t\t\tt.Errorf(\"CheckTransition(%q, %q) = (%q, %v), want no instance target or effect\",\n261|\t\t\t\toperation, \"\", target, effects)\n262|\t\t}\n263|\t}\n264|}\n265|\n266|// TestCheckTransitionRefusesEveryIllegalSource drives the full negative\n267|// matrix: every operation against every source it does not admit,\n268|// including unknown operations and states. A known operation against a\n269|// disallowed source fails its local precondition; an unknown member is a\n270|// protocol error. manifest and probe refuse any instance source at all.\n271|func TestCheckTransitionRefusesEveryIllegalSource(t *testing.T) {\n272|\tt.Parallel()\n273|\n274|\tsources := []string{\n275|\t\t\"\", \"absent\", \"creating\", \"parked\", \"active\",\n276|\t\t\"quiescing\", \"stopped\", \"stale_fenced\", \"unavailable\",\n277|\t}\n278|\tadmitted := map[string]map[string]bool{\n279|\t\t\"manifest\": {\"\": true}, \"probe\": {\"\": true},\n280|\t\t\"create\":             {\"absent\": true, \"stopped\": true},\n281|\t\t\"attach\":             {\"parked\": true, \"active\": true},\n282|\t\t\"status\":             {},\n283|\t\t\"quiesce-input\":      {\"active\": true, \"parked\": true},\n284|\t\t\"wait-safe-boundary\": {\"quiescing\": true},\n285|\t\t\"request-stop\":       {\"quiescing\": true},\n286|\t\t\"terminate-stale\":    {\"stale_fenced\": true, \"unavailable\": true},\n287|\t\t\"restore\":            {\"absent\": true, \"stopped\": true, \"unavailable\": true},\n288|\t}\n289|\tfor _, source := range sources {\n290|\t\tadmitted[\"status\"][source] = source != \"\"\n291|\t}\n292|\n293|\toperations := []string{\n294|\t\t\"manifest\", \"probe\", \"create\", \"attach\", \"status\",\n295|\t\t\"quiesce-input\", \"wait-safe-boundary\", \"request-stop\",\n296|\t\t\"terminate-stale\", \"restore\",\n297|\t}\n298|\tfor _, operation := range operations {\n299|\t\tfor _, source := range sources {\n300|\t\t\tif admitted[operation][source] {\n301|\t\t\t\tcontinue\n302|\t\t\t}\n303|\t\t\t// An empty source names no state at all: the state\n304|\t\t\t// member is unknown, not merely disallowed.\n305|\t\t\tif source == \"\" {\n306|\t\t\t\t_, _, err := terminalbackend.CheckTransition(operation, source, false)\n307|\t\t\t\trequireConformanceRefusal(t, err,\n308|\t\t\t\t\t\"terminal_backend_protocol_error\", \"lifecycle state vocabulary\")\n309|\t\t\t\tcontinue\n310|\t\t\t}\n311|\t\t\t// manifest and probe carry no instance at all: any\n312|\t\t\t// source violates their scope, not a transition.\n313|\t\t\tif operation == \"manifest\" || operation == \"probe\" {\n314|\t\t\t\t_, _, err := terminalbackend.CheckTransition(operation, source, false)\n315|\t\t\t\trequireConformanceRefusal(t, err,\n316|\t\t\t\t\t\"local_precondition_failed\", \"lifecycle instance scope\")\n317|\t\t\t\tcontinue\n318|\t\t\t}\n319|\t\t\tfor _, interactive := range []bool{false, true} {\n320|\t\t\t\t_, _, err := terminalbackend.CheckTransition(operation, source, interactive)\n321|\t\t\t\trequireConformanceRefusal(t, err,\n322|\t\t\t\t\t\"local_precondition_failed\", \"lifecycle transition\")\n323|\t\t\t}\n324|\t\t}\n325|\t}\n326|\n327|\tfor _, operation := range []string{\"\", \"delete\", \"CREATE\", \"launch\"} {\n328|\t\t_, _, err := terminalbackend.CheckTransition(operation, \"active\", false)\n329|\t\trequireConformanceRefusal(t, err,\n330|\t\t\t\"terminal_backend_protocol_error\", \"operation vocabulary\")\n331|\t}\n332|\tfor _, source := range []string{\"running\", \"ACTIVE\", \"parked \", \"bogus\"} {\n333|\t\t_, _, err := terminalbackend.CheckTransition(\"attach\", source, false)\n334|\t\trequireConformanceRefusal(t, err,\n335|\t\t\t\"terminal_backend_protocol_error\", \"lifecycle state vocabulary\")\n336|\t}\n337|}\n338|\n339|// TestCheckTransitionNeverEntersFencingOrBootstrapStates proves the two\n340|// §4.C entry rules structurally: no backend operation enters\n341|// stale_fenced (AX fencing observation does), and creating is never a\n342|// success target (it exists only between the receipt and the first side\n343|// effect). The sweep covers every transitioning operation, every source,\n344|// and both create modes, so a row added with either target reddens here.\n345|// status is excluded by name: it observes the source rather than\n346|// entering anything, so status-of-creating reports creating without\n347|// entering it.\n348|func TestCheckTransitionNeverEntersFencingOrBootstrapStates(t *testing.T) {\n349|\tt.Parallel()\n350|\n351|\toperations := []string{\n352|\t\t\"create\", \"attach\", \"quiesce-input\", \"wait-safe-boundary\",\n353|\t\t\"request-stop\", \"terminate-stale\", \"restore\",\n354|\t}\n355|\tsources := []string{\n356|\t\t\"absent\", \"creating\", \"parked\", \"active\",\n357|\t\t\"quiescing\", \"stopped\", \"stale_fenced\", \"unavailable\",\n358|\t}\n359|\tfor _, operation := range operations {\n360|\t\tfor _, source := range sources {\n361|\t\t\tfor _, interactive := range []bool{false, true} {\n362|\t\t\t\ttarget, _, err := terminalbackend.CheckTransition(operation, source, interactive)\n363|\t\t\t\tif err != nil {\n364|\t\t\t\t\tcontinue\n365|\t\t\t\t}\n366|\t\t\t\tif target == \"stale_fenced\" {\n367|\t\t\t\t\tt.Errorf(\"CheckTransition(%q, %q) enters stale_fenced: \"+\n368|\t\t\t\t\t\t\"no backend operation enters the fencing state\", operation, source)\n369|\t\t\t\t}\n370|\t\t\t\tif target == \"creating\" {\n371|\t\t\t\t\tt.Errorf(\"CheckTransition(%q, %q) targets creating: \"+\n372|\t\t\t\t\t\t\"the bootstrap state is never a success target\", operation, source)\n373|\t\t\t\t}\n374|\t\t\t}\n375|\t\t}\n376|\t}\n377|}\n378|\n379|// TestOnlyQuiesceInputEntersQuiescing proves the §4.C exclusivity rule:\n380|// entering quiescing from any other state happens only through\n381|// quiesce-input. wait-safe-boundary stays in quiescing without entering\n382|// it, and status only observes, so both are excluded by the\n383|// target-differs-from-source condition rather than by name.\n384|func TestOnlyQuiesceInputEntersQuiescing(t *testing.T) {\n385|\tt.Parallel()\n386|\n387|\toperations := []string{\n388|\t\t\"create\", \"attach\", \"status\",\n389|\t\t\"wait-safe-boundary\", \"request-stop\", \"terminate-stale\", \"restore\",\n390|\t}\n391|\tsources := []string{\n392|\t\t\"absent\", \"creating\", \"parked\", \"active\",\n393|\t\t\"quiescing\", \"stopped\", \"stale_fenced\", \"unavailable\",\n394|\t}\n395|\tfor _, operation := range operations {\n396|\t\tfor _, source := range sources {\n397|\t\t\tfor _, interactive := range []bool{false, true} {\n398|\t\t\t\ttarget, _, err := terminalbackend.CheckTransition(operation, source, interactive)\n399|\t\t\t\tif err != nil {\n400|\t\t\t\t\tcontinue\n401|\t\t\t\t}\n402|\t\t\t\tif target == \"quiescing\" && source != \"quiescing\" {\n403|\t\t\t\t\tt.Errorf(\"CheckTransition(%q, %q) enters quiescing: \"+\n404|\t\t\t\t\t\t\"only quiesce-input enters it\", operation, source)\n405|\t\t\t\t}\n406|\t\t\t}\n407|\t\t}\n408|\t}\n409|}\n410|\n411|// allowedErrorCodesByOperation mirrors the production §4.C \"Allowed error\n412|// codes\" table (allowedOperationErrors in conformance.go) exactly, one\n413|// full row per operation — not a sample. The admit test below proves the\n414|// mirror admits nothing production refuses; the complement test proves\n415|// production admits nothing the mirror withholds from the pinned catalog.\n416|// Together they pin every row exactly: a widened production row reddens\n417|// the complement test, a narrowed one reddens the admit test.\n418|var allowedErrorCodesByOperation = map[string][]string{\n419|\t\"manifest\": {\n420|\t\t\"terminal_backend_protocol_error\",\n421|\t\t\"terminal_backend_protocol_incompatible\",\n422|\t\t\"terminal_backend_process_failed\",\n423|\t\t\"terminal_backend_timeout\",\n424|\t\t\"terminal_backend_integrity_failure\",\n425|\t},\n426|\t\"probe\": {\n427|\t\t\"terminal_backend_untrusted\",\n428|\t\t\"terminal_backend_manifest_probe_mismatch\",\n429|\t\t\"terminal_backend_implementation_drift\",\n430|\t\t\"terminal_backend_protocol_error\",\n431|\t\t\"terminal_backend_process_failed\",\n432|\t\t\"terminal_backend_timeout\",\n433|\t\t\"terminal_backend_integrity_failure\",\n434|\t},\n435|\t\"create\": {\n436|\t\t\"idempotency_mismatch\",\n437|\t\t\"local_precondition_failed\",\n438|\t\t\"terminal_backend_unauthorized\",\n439|\t\t\"terminal_backend_stale_generation\",\n440|\t\t\"terminal_backend_capability_unproven\",\n441|\t\t\"terminal_backend_unavailable\",\n442|\t\t\"terminal_backend_timeout\",\n443|\t\t\"terminal_backend_process_failed\",\n444|\t\t\"terminal_backend_integrity_failure\",\n445|\t\t\"terminal_backend_protocol_error\",\n446|\t},\n447|\t\"attach\": {\n448|\t\t\"idempotency_mismatch\",\n449|\t\t\"local_precondition_failed\",\n450|\t\t\"terminal_backend_unauthorized\",\n451|\t\t\"terminal_backend_stale_generation\",\n452|\t\t\"terminal_backend_capability_unproven\",\n453|\t\t\"terminal_backend_unavailable\",\n454|\t\t\"terminal_backend_timeout\",\n455|\t\t\"terminal_backend_process_failed\",\n456|\t\t\"terminal_backend_integrity_failure\",\n457|\t\t\"terminal_backend_protocol_error\",\n458|\t},\n459|\t\"status\": {\n460|\t\t\"terminal_backend_stale_generation\",\n461|\t\t\"terminal_backend_capability_unproven\",\n462|\t\t\"terminal_backend_unavailable\",\n463|\t\t\"terminal_backend_timeout\",\n464|\t\t\"terminal_backend_integrity_failure\",\n465|\t\t\"terminal_backend_protocol_error\",\n466|\t},\n467|\t\"quiesce-input\": {\n468|\t\t\"idempotency_mismatch\",\n469|\t\t\"local_precondition_failed\",\n470|\t\t\"terminal_backend_unauthorized\",\n471|\t\t\"terminal_backend_stale_generation\",\n472|\t\t\"terminal_backend_capability_unproven\",\n473|\t\t\"terminal_backend_timeout\",\n474|\t\t\"terminal_backend_integrity_failure\",\n475|\t\t\"terminal_backend_protocol_error\",\n476|\t},\n477|\t\"wait-safe-boundary\": {\n478|\t\t\"idempotency_mismatch\",\n479|\t\t\"local_precondition_failed\",\n480|\t\t\"terminal_backend_unauthorized\",\n481|\t\t\"terminal_backend_stale_generation\",\n482|\t\t\"terminal_backend_capability_unproven\",\n483|\t\t\"quiesce_timeout\",\n484|\t\t\"terminal_backend_integrity_failure\",\n485|\t\t\"terminal_backend_protocol_error\",\n486|\t},\n487|\t\"request-stop\": {\n488|\t\t\"idempotency_mismatch\",\n489|\t\t\"local_precondition_failed\",\n490|\t\t\"terminal_backend_unauthorized\",\n491|\t\t\"terminal_backend_stale_generation\",\n492|\t\t\"terminal_backend_capability_unproven\",\n493|\t\t\"stop_timeout\",\n494|\t\t\"terminal_backend_process_failed\",\n495|\t\t\"terminal_backend_integrity_failure\",\n496|\t\t\"terminal_backend_protocol_error\",\n497|\t},\n498|\t\"terminate-stale\": {\n499|\t\t\"idempotency_mismatch\",\n500|\t\t\"local_precondition_failed\",\n(more lines below)"}}}
