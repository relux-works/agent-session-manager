{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c52d","stream":{"kind":"session","id":"01a06ff2-73b2-7750-92a2-8ff950295c9d"},"sequence":241,"recorded_at":1780531400000477,"record_type":"event","durability":"durable","causation_id":"1b11d441-f4bd-4331-a485-e0ecf0af0397","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1b11d441-f4bd-4331-a485-e0ecf0af0397","run_stream":{"kind":"run","id":"1b11d441-f4bd-4331-a485-e0ecf0af0397"},"task_stream":{"kind":"task","id":"e0b46eae-9402-42e2-8ddd-e512f6e0e05a"},"task_id":"e0b46eae-9402-42e2-8ddd-e512f6e0e05a","event":{"kind":"output","task_id":"e0b46eae-9402-42e2-8ddd-e512f6e0e05a","chunk":"Read text file `internal/terminalbackend/refusal_arm_inventory_test.go`.\n(749 line(s) above)\n750|}\n751|\n752|// armlessCodes names wire codes with no refusal arm by design.\n753|// CodeUnavailable appears only inside the allowed-error sets; no\n754|// conformance refusal emits it, so it carries no arm of its own.\n755|var armlessCodes = map[string]bool{\n756|\t\"CodeUnavailable\": true,\n757|}\n758|\n759|// plainErrorFunctions names the only production functions allowed to\n760|// construct non-wire errors. validatePlatforms feeds the pinned funnel;\n761|// DigestFile reports I/O failures that must never be wire errors.\n762|var plainErrorFunctions = map[string]bool{\n763|\t\"validatePlatforms\": true,\n764|\t\"DigestFile\":        true,\n765|}\n766|\n767|// TestDerivedRefusalArmsAreAllDeclared is the forward direction: every\n768|// arm the production AST derives resolves to exactly one declared row.\n769|// A brand-new arm with a brand-new detail fails here until its witness\n770|// is recorded.\n771|func TestDerivedRefusalArmsAreAllDeclared(t *testing.T) {\n772|\tt.Parallel()\n773|\n774|\tderived := deriveRefusalArms(t)\n775|\trows := declaredRows()\n776|\tmatched := make([]bool, len(derived))\n777|\tfor _, row := range rows {\n778|\t\tmatches := []int{}\n779|\t\tfor index, arm := range derived {\n780|\t\t\tif armMatchesRow(arm, row) {\n781|\t\t\t\tmatches = append(matches, index)\n782|\t\t\t}\n783|\t\t}\n784|\t\tif len(matches) != 1 {\n785|\t\t\tt.Errorf(\"declared row %s resolves to %d derived arms, want exactly one\",\n786|\t\t\t\tdescribeRow(row), len(matches))\n787|\t\t\tcontinue\n788|\t\t}\n789|\t\tif matched[matches[0]] {\n790|\t\t\tt.Errorf(\"declared row %s claims an arm an earlier row already claimed: %s\",\n791|\t\t\t\tdescribeRow(row), describeArm(derived[matches[0]]))\n792|\t\t\tcontinue\n793|\t\t}\n794|\t\tmatched[matches[0]] = true\n795|\t}\n796|\tfor index, claimed := range matched {\n797|\t\tif !claimed {\n798|\t\t\tt.Errorf(\"derived arm has no declaring row, so nothing witnesses it: %s\",\n799|\t\t\t\tdescribeArm(derived[index]))\n800|\t\t}\n801|\t}\n802|}\n803|\n804|// TestDeclaredRefusalArmsAreAllDerived is the reverse direction: every\n805|// declared row resolves to exactly one derived arm. Without it the\n806|// forward direction passes vacuously on a truncated derivation, and a\n807|// deleted production guard lingers as a row pointing at nothing.\n808|func TestDeclaredRefusalArmsAreAllDerived(t *testing.T) {\n809|\tt.Parallel()\n810|\n811|\tderived := deriveRefusalArms(t)\n812|\tfor _, row := range declaredRows() {\n813|\t\tmatches := 0\n814|\t\tfor _, arm := range derived {\n815|\t\t\tif armMatchesRow(arm, row) {\n816|\t\t\t\tmatches++\n817|\t\t\t}\n818|\t\t}\n819|\t\tif matches != 1 {\n820|\t\t\tt.Errorf(\"declared row %s matches %d derived arms, want exactly one; \"+\n821|\t\t\t\t\"a row without an arm is a witness without a guard\", describeRow(row), matches)\n822|\t\t}\n823|\t}\n824|\tif len(derived) != len(declaredRows()) {\n825|\t\tt.Errorf(\"derived %d arms but declared %d rows; the table is not a bijection\",\n826|\t\t\tlen(derived), len(declaredRows()))\n827|\t}\n828|}\n829|\n830|func armMatchesRow(arm refusalArm, row declaredRefusalArm) bool {\n831|\treturn arm.file == row.file && arm.function == row.function &&\n832|\t\tarm.code == row.code && arm.detail == row.detail &&\n833|\t\tarm.occurrence == row.occurrence\n834|}\n835|\n836|func describeArm(arm refusalArm) string {\n837|\treturn arm.file + \" \" + arm.function + \" \" + arm.code + \" \" +\n838|\t\tstrconv.Quote(arm.detail) + \" #\" + strconv.Itoa(arm.occurrence)\n839|}\n840|\n841|func describeRow(row declaredRefusalArm) string {\n842|\treturn row.file + \" \" + row.function + \" \" + row.code + \" \" +\n843|\t\tstrconv.Quote(row.detail) + \" #\" + strconv.Itoa(row.occurrence)\n844|}\n845|\n846|// declaredRows returns the table plus the funnel row.\n847|func declaredRows() []declaredRefusalArm {\n848|\trows := append([]declaredRefusalArm(nil), declaredRefusalArms...)\n849|\tfunnel := funneledPlatformArm\n850|\tfunnel.detailSet = funneledPlatformDetails\n851|\treturn append(rows, funnel)\n852|}\n853|\n854|// TestDeclaredRefusalWiresMatchProductionConsts binds the table to the\n855|// production const values two ways: every row's code resolves to the\n856|// wire its test asserts, and every Code symbol except the named armless\n857|// one appears in at least one row, so a code nobody refuses is a red\n858|// rather than a quiet gap.\n859|func TestDeclaredRefusalWiresMatchProductionConsts(t *testing.T) {\n860|\tt.Parallel()\n861|\n862|\tsymbols := productionCodeSymbols(t)\n863|\tcovered := make(map[string]bool)\n864|\tfor _, row := range declaredRows() {\n865|\t\twire, known := symbols[row.code]\n866|\t\tif !known {\n867|\t\t\tt.Errorf(\"declared row %s names unknown code symbol %q\",\n868|\t\t\t\tdescribeRow(row), row.code)\n869|\t\t\tcontinue\n870|\t\t}\n871|\t\tcovered[row.code] = true\n872|\t\t_ = wire\n873|\t}\n874|\tfor symbol := range symbols {\n875|\t\tif armlessCodes[symbol] {\n876|\t\t\tcontinue\n877|\t\t}\n878|\t\tif !covered[symbol] {\n879|\t\t\tt.Errorf(\"code symbol %s has no refusal arm; a wire code nothing refuses is unwitnessed\", symbol)\n880|\t\t}\n881|\t}\n882|}\n883|\n884|// TestDeclaredRefusalTestsResolve requires every row to name real tests\n885|// that textually touch the arm: the detail literal, or the driven entry\n886|// plus the wire code (or its verified predicate). Bound rows name a test\n887|// driving the entry; the bound itself says why no document reaches them.\n888|func TestDeclaredRefusalTestsResolve(t *testing.T) {\n889|\tt.Parallel()\n890|\n891|\tbodies := testBodies(t)\n892|\tpredicates := predicateCodes(t)\n893|\tsymbols := productionCodeSymbols(t)\n894|\tfor _, row := range declaredRows() {\n895|\t\tif len(row.tests) == 0 {\n896|\t\t\tt.Errorf(\"declared row %s names no test, so nothing measures it\", describeRow(row))\n897|\t\t\tcontinue\n898|\t\t}\n899|\t\tresolved := false\n900|\t\tfor _, reference := range row.tests {\n901|\t\t\tbody, declared := bodies[reference.file+\"\\n\"+reference.test]\n902|\t\t\tif !declared {\n903|\t\t\t\tt.Errorf(\"declared row %s names %s in %s, which is not declared\",\n904|\t\t\t\t\tdescribeRow(row), reference.test, reference.file)\n905|\t\t\t\tcontinue\n906|\t\t\t}\n907|\t\t\tif rowResolves(row, body, predicates, symbols) {\n908|\t\t\t\tresolved = true\n909|\t\t\t}\n(more lines below)"}}}
