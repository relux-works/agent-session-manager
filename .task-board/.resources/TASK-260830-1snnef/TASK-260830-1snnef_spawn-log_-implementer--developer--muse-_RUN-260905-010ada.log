me colliding on BuiltinTmux (injectivity probe)\\nnewC20 = '\\\\t\\\"tmux\\\":   BuiltinTmux,\\\\n\\\\t\\\"conpty\\\": BuiltinConpty,\\\\n\\\\t\\\"screen\\\": BuiltinTmux,'\\nopen(C,\\\"w\\\").write(orig_c.replace(old,newC20))\\nr = run([\\\"-run\\\",\\\"TestLegacy|TestHistorical\\\"],12)\\nprint(\\\"C20 x12:\\\", r, \\\"RED=%d\\\"%r.count(\\\"RED\\\"))\\nrestore()\\n# H2: plain-error alias inside a FuncDecl (use a temp prod file to avoid touching existing)\\nalias_src = 'package terminalbackend\\\\n\\\\nimport \\\"errors\\\"\\\\n\\\\nvar newPlain = errors.New\\\\n\\\\nfunc plainAliasProbe() error { return newPlain(\\\"smuggled\\\") }\\\\n'\\nopen(\\\"internal/terminalbackend/zz_plain_alias_probe.go\\\",\\\"w\\\").write(alias_src)\\nr = run([\\\"-run\\\",\\\"TestPlainErrors\\\"],3)\\nprint(\\\"H2-alias x3:\\\", r, \\\"RED=%d\\\"%r.count(\\\"RED\\\"))\\nimport os; os.remove(\\\"internal/terminalbackend/zz_plain_alias_probe.go\\\")\\nrestore()\\nprint(\\\"tree restored:\\\", open(C).read()==orig_c and open(I).read()==orig_i)\\nEOF\\npython3 /tmp/probe_r3.py\",\n  \"description\": \"Probe L3, C20, H2 mutants repeatedly\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"L3 x12: ['RED', 'RED', 'RED', 'RED', 'RED', 'RED', 'RED', 'RED', 'RED', 'RED', 'RED', 'RED'] RED=12\\nC20 x12: ['RED', 'RED', 'RED', 'RED', 'RED', 'RED', 'RED', 'RED', 'RED', 'RED', 'RED', 'RED'] RED=12\\nH2-alias x3: ['RED', 'RED', 'RED'] RED=3\\ntree restored: True\\n\",\n  \"original_output_bytes\": 262,\n  \"original_output_tokens\": 66,\n  \"truncated\": false\n}"}}}
