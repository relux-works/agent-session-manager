+// pinRealmClaim returns one credential-realm claim map.
+func pinRealmClaim(origin string) map[string]any {
+	return map[string]any{
+		"capability":            credentialRealmCapability,
+		"origin":                origin,
+		"value":                 true,
+		"generation_variable":   true,
