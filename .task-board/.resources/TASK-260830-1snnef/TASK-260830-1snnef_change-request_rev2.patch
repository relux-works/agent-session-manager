+		"facts":                      []any{"fixture_passed", "provider_auth_passed", "runtime_probe_passed", "sentinel_passed"},
+		"terminal_binding_id":        digest,
+		"provider_id":                "codex",
+		"provider_build":             "1.2.3",
+		"sentinel_result":            "passed",
