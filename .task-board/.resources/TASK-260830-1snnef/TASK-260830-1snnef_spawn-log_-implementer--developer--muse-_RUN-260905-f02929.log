{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4c9","stream":{"kind":"session","id":"01a070b0-22c9-7f91-ad93-24f3d289098d"},"sequence":191,"recorded_at":1780531400000377,"record_type":"event","durability":"durable","causation_id":"f9c11a89-ee4c-4cfe-aa7e-08a834791d50","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f9c11a89-ee4c-4cfe-aa7e-08a834791d50","run_stream":{"kind":"run","id":"f9c11a89-ee4c-4cfe-aa7e-08a834791d50"},"task_stream":{"kind":"task","id":"9c88d01f-fd12-4e2a-9880-cc5df9f7d6d7"},"task_id":"9c88d01f-fd12-4e2a-9880-cc5df9f7d6d7","event":{"kind":"output","task_id":"9c88d01f-fd12-4e2a-9880-cc5df9f7d6d7","chunk":"Read text file `internal/terminalbackend/manifest_test.go`.\n(469 line(s) above)\n470|\n471|// TestMultibyteStringBounds proves string[1..256] counts UTF-8 characters\n472|// (SPEC.md:321) at the document gates: a 256-rune os_version (512 bytes)\n473|// and provider_build admit, while 257-rune values refuse with the document\n474|// string bound. Admit cases re-seal the document identity (and re-sign\n475|// evidence) after mutation so only the bound can decide.\n476|func TestMultibyteStringBounds(t *testing.T) {\n477|\tt.Parallel()\n478|\n479|\tuniverse := testUniverse(t)\n480|\tuniverse.probe[\"os_version\"] = strings.Repeat(\"é\", 256)\n481|\tfinalizeDocument(t, universe.probe, \"probe_id\")\n482|\tif _, err := terminalbackend.ParseProbe(mustMarshal(t, universe.probe)); err != nil {\n483|\t\tt.Errorf(\"ParseProbe(256-rune os_version) error = %v, want admission\", err)\n484|\t}\n485|\n486|\toverlong := testUniverse(t)\n487|\toverlong.probe[\"os_version\"] = strings.Repeat(\"é\", 257)\n488|\tfinalizeDocument(t, overlong.probe, \"probe_id\")\n489|\t_, err := terminalbackend.ParseProbe(mustMarshal(t, overlong.probe))\n490|\trequireRefusal(t, err, codeMismatch, \"document string bound\")\n491|\n492|\trealm := universe.evidenceMap(\"credential_capable_execution_realm\",\n493|\t\t[]any{\"fixture_passed\", \"provider_auth_passed\", \"runtime_probe_passed\", \"sentinel_passed\"})\n494|\trealm[\"terminal_binding_id\"] = testSeedDigest(0xB1)\n495|\trealm[\"provider_id\"] = \"codex\"\n496|\trealm[\"provider_build\"] = strings.Repeat(\"é\", 256)\n497|\trealm[\"sentinel_result\"] = \"passed\"\n498|\trealm[\"provider_auth_smoke_result\"] = \"passed\"\n499|\tfinalizeEvidence(t, universe.key, realm)\n500|\tif _, err := terminalbackend.ParseEvidence(mustMarshal(t, realm)); err != nil {\n501|\t\tt.Errorf(\"ParseEvidence(256-rune provider_build) error = %v, want admission\", err)\n502|\t}\n503|\n504|\trealm[\"provider_build\"] = strings.Repeat(\"é\", 257)\n505|\tfinalizeEvidence(t, universe.key, realm)\n506|\t_, err = terminalbackend.ParseEvidence(mustMarshal(t, realm))\n507|\trequireRefusal(t, err, codeMismatch, \"document string bound\")\n508|}\n509|\n510|// TestDocumentSurrogateEscapeRefused proves SPEC.md:289 at every production\n511|// document entry: a lone-surrogate escape is refused with the document\n512|// surrogate escape arm before any canonicalization, even though Go's\n513|// encoding/json would silently decode it to U+FFFD and every later member\n514|// check would then see valid UTF-8. The injection mutates the marshaled\n515|// bytes (not the map) so the escape reaches the raw-byte scan; the broken\n516|// identity that results is unreachable behind the decode gate.\n517|func TestDocumentSurrogateEscapeRefused(t *testing.T) {\n518|\tt.Parallel()\n519|\n520|\t// The lone-surrogate escape is assembled from byte values: no literal\n521|\t// in this file spells the escape directly.\n522|\tslash := string([]byte{92})\n523|\tinject := func(raw []byte, anchor, value string) []byte {\n524|\t\told := []byte(`\"` + anchor + `\"` + `:` + `\"` + value + `\"`)\n525|\t\tescaped := append([]byte(`\"`+anchor+`\"`+`:`+`\"`), slash...)\n526|\t\tescaped = append(escaped, \"ud800abc\"...)\n527|\t\tescaped = append(escaped, '\"')\n528|\t\treturn bytes.Replace(raw, old, escaped, 1)\n529|\t}\n530|\n531|\tuniverse := testUniverse(t)\n532|\t_, err := terminalbackend.ParseProbe(inject(mustMarshal(t, universe.probe), \"os_version\", \"14.5\"))\n533|\trequireRefusal(t, err, codeMismatch, \"document surrogate escape\")\n534|\n535|\t_, err = terminalbackend.ParseManifest(inject(mustMarshal(t, universe.manifest), \"implementation_kind\", \"builtin_go\"))\n536|\trequireRefusal(t, err, codeMismatch, \"document surrogate escape\")\n537|\n538|\t_, err = terminalbackend.ParseEvidence(inject(mustMarshal(t, universe.evidenceByCap[\"durable_disconnect\"]), \"os_version\", \"14.5\"))\n539|\trequireRefusal(t, err, codeMismatch, \"document surrogate escape\")\n540|}\n541|\n542|// TestReconcileAdmitsCoherentTuple is the positive admission: static echo,\n543|// same-value override, differing override, false claim, and probed addition\n544|// reconcile to exactly the true evidenced claims.\n545|func TestReconcileAdmitsCoherentTuple(t *testing.T) {\n546|\tt.Parallel()\n547|\n548|\tuniverse := testUniverse(t)\n549|\tmanifest, probe, evidence := universe.parsed(t)\n550|\tadmitted, err := terminalbackend.Reconcile(manifest, probe, evidence, universe.rawGeneration, universe.now, testVerifier(universe.key))\n551|\tif err != nil {\n552|\t\tt.Fatalf(\"Reconcile() error = %v\", err)\n553|\t}\n554|\twant := []string{\"durable_disconnect\", \"graceful_stop\", \"headless_creation\"}\n555|\tif fmt.Sprint(admitted.Capabilities) != fmt.Sprint(want) {\n556|\t\tt.Errorf(\"Capabilities = %v, want %v\", admitted.Capabilities, want)\n557|\t}\n558|\tif len(admitted.EvidenceIDs) != 3 {\n559|\t\tt.Errorf(\"EvidenceIDs = %v, want 3 proved IDs\", admitted.EvidenceIDs)\n560|\t}\n561|\tif !admitted.Has(\"headless_creation\") || admitted.Has(\"local_attach\") {\n562|\t\tt.Errorf(\"Has() over %v misreports overrides\", admitted.Capabilities)\n563|\t}\n564|\tif !admitted.HasOperation(\"create\") || admitted.HasOperation(\"attach\") {\n565|\t\tt.Errorf(\"HasOperation() over %v misreports dependencies\", admitted.Capabilities)\n566|\t}\n567|\tif err := terminalbackend.CheckOperation(\"create\", admitted); err != nil {\n568|\t\tt.Errorf(\"CheckOperation(create) error = %v, want admission\", err)\n569|\t}\n570|\trequireRefusal(t, terminalbackend.CheckOperation(\"attach\", admitted), codeCapabilityUnproven, \"operation capability dependency\")\n571|}\n572|\n573|// TestManifestDocumentRefusals narrows the closed-schema gate: each case\n574|// widens exactly one member class and must fail at its own clause, not\n575|// merely with the shared wire code.\n576|func TestManifestDocumentRefusals(t *testing.T) {\n577|\tt.Parallel()\n578|\n579|\tcases := map[string]struct {\n580|\t\tmutate func(t *testing.T, object map[string]any)\n581|\t\tdetail string\n582|\t}{\n583|\t\t\"unknown member\": {\n584|\t\t\tmutate: func(t *testing.T, object map[string]any) {\n585|\t\t\t\tobject[\"sponsor\"] = \"evil\"\n586|\t\t\t},\n587|\t\t\tdetail: \"document members\",\n588|\t\t},\n589|\t\t\"missing member\": {\n(more lines below)"}}}
