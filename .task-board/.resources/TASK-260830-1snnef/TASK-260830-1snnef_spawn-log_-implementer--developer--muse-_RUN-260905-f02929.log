t_test.go-843-\ninternal/terminalbackend/manifest_test.go-844-\t\t\t_, err := terminalbackend.ParseManifest(tc.raw)\ninternal/terminalbackend/manifest_test.go-845-\t\t\trequireRefusal(t, err, codeMismatch, tc.detail)\ninternal/terminalbackend/manifest_test.go-846-\t\t})\ninternal/terminalbackend/manifest_test.go-847-\t}\ninternal/terminalbackend/manifest_test.go-848-}\ninternal/terminalbackend/manifest_test.go-849-\ninternal/terminalbackend/manifest_test.go-850-// TestManifestIdentityMismatch proves the reader recomputes the ID: a valid\ninternal/terminalbackend/manifest_test.go-851-// shape with a foreign digest is refused.\ninternal/terminalbackend/manifest_test.go-852-func TestManifestIdentityMismatch(t *testing.T) {\ninternal/terminalbackend/manifest_test.go-853-\tt.Parallel()\ninternal/terminalbackend/manifest_test.go-854-\ninternal/terminalbackend/manifest_test.go-855-\tuniverse := testUniverse(t)\ninternal/terminalbackend/manifest_test.go-856-\tobject := cloneMap(t, universe.manifest)\ninternal/terminalbackend/manifest_test.go-857-\tobject[\"manifest_id\"] = testSeedDigest(0xDD)\ninternal/terminalbackend/manifest_test.go-858-\t_, err := terminalbackend.ParseManifest(mustMarshal(t, object))"}}}
