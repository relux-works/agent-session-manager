tead of shared.\\n+func hasLoneSurrogateEscape(raw []byte) bool {\\n+\\tfor index := 0; index < len(raw); index++ {\\n+\\t\\tif raw[index] != '\\\"' {\\n+\\t\\t\\tcontinue\\n+\\t\\t}\\n+\\t\\tfor index++; index < len(raw); index++ {\\n+\\t\\t\\tswitch raw[index] {\\n+\\t\\t\\tcase '\\\"':\\n+\\t\\t\\t\\tgoto stringComplete\\n+\\t\\t\\tcase '\\\\\\\\':\\n+\\t\\t\\t\\tindex++\\n+\\t\\t\\t\\tif index >= len(raw) {\\n+\\t\\t\\t\\t\\treturn false\\n+\\t\\t\\t\\t}\\n+\\t\\t\\t\\tif raw[index] != 'u' {\\n+\\t\\t\\t\\t\\tcontinue\\n+\\t\\t\\t\\t}\\n+\\t\\t\\t\\tunit, end, ok := readUTF16EscapeUnit(raw, index-1)\\n+\\t\\t\\t\\tif !ok {\\n+\\t\\t\\t\\t\\tcontinue\\n+\\t\\t\\t\\t}\\n+\\t\\t\\t\\tindex = end - 1\\n+\\t\\t\\t\\tswitch {\\n+\\t\\t\\t\\tcase unit >= 0xd800 && unit <= 0xdbff:\\n+\\t\\t\\t\\t\\tsecond, secondEnd, ok := readUTF16EscapeUnit(raw, end)\\n+\\t\\t\\t\\t\\tif !ok || second < 0xdc00 || second > 0xdfff {\\n+\\t\\t\\t\\t\\t\\treturn true\\n+\\t\\t\\t\\t\\t}\\n+\\t\\t\\t\\t\\tindex = secondEnd - 1\\n+\\t\\t\\t\\tcase unit >= 0xdc00 && unit <= 0xdfff:\\n+\\t\\t\\t\\t\\treturn true\\n+\\t\\t\\t\\t}\\n+\\t\\t\\t}\\n+\\t\\t}\\n+\\tstringComplete:\\n+\\t}\\n+\\treturn false\\n+}\\n+\\n+// readUTF16EscapeUnit reads one \\\\uXXXX escape at raw[start] (which must be\\n+// the backslash). It reports false when the escape is absent or malformed;\\n+// malformed escapes are refused by the decoder's syntax arm, so this gate\\n+// only needs to stay silent on them rather than diagnose them.\\n---\\n README.md                                          |  7 +-\\n internal/terminalbackend/internal_pin_test.go      | 45 ++++++++++\\n internal/terminalbackend/manifest.go               | 99 ++++++++++++++++++++--\\n internal/terminalbackend/manifest_test.go          | 85 ++++++++++++++++++-\\n .../terminalbackend/refusal_arm_inventory_test.go  |  3 +\\n internal/terminalbackend/terminalbackend.go        | 29 +++++--\\n internal/terminalbackend/terminalbackend_test.go   | 81 ++++++++++++++++--\\n internal/traceability/cmd/tracecheck/main_test.go  |  4 +-\\n internal/traceability/ownership.v0.5.0.json        | 25 ++++++\\n internal/traceability/traceability.go              |  2 +-\\n internal/traceability/traceability_test.go         |  2 +-\\n 11 files changed, 349 insertions(+), 33 deletions(-)\\n\",\n  \"original_output_bytes\": 2907,\n  \"original_output_tokens\": 727,\n  \"truncated\": false\n}"}}}
