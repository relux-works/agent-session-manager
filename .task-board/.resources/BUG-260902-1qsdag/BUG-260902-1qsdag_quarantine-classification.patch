+func (store *ObjectStore) resolveExistingConflict(result PutResult, verdict existingVerdict, existingErr error,
+	expected scalar.Digest, stagedPath, target string, raced bool) (PutResult, error) {
+	label := "existing"
+	if raced {
+		label = "raced existing"
+	}
+	// An inspection that did not complete proves neither a hash mismatch nor a
+	// representation disagreement, so it authorizes no quarantine at all. The
+	// occupant stays in the immutable namespace and the caller sees a
+	// durability failure; the staged candidate is removed by the deferred
