index 0000000..cffe6f2
--- /dev/null
+++ b/internal/localstore/object_store_quarantine_proof_test.go
@@ -0,0 +1,333 @@
+package localstore
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"runtime"
+	"testing"
+
+	"github.com/relux-works/agent-session-manager/internal/scalar"
+)
+
+// errTransientRead stands for the class of faults that make a read stop part
+// way through without saying anything about the bytes on disk: EMFILE, EIO, a
+// severed network filesystem. None of them is a hash mismatch.
+var errTransientRead = errors.New("injected transient read failure")
+
+// failingReader fails after handing back a prefix, so the copy has genuinely
+// started and cannot be dismissed as an open that never happened.
+type failingReader struct {
+	prefix    []byte
+	delivered bool
+}
+
+func (reader *failingReader) Read(destination []byte) (int, error) {
+	if !reader.delivered && len(reader.prefix) > 0 {
+		reader.delivered = true
+		return copy(destination, reader.prefix), nil
+	}
+	return 0, errTransientRead
+}
+
+func (reader *failingReader) Close() error { return nil }
+
+// TestPutBlobReportsTransientInspectionReadFailureWithoutQuarantining is the
+// negative case for the SPEC.md section 3.2 quarantine bound: quarantine is
+// authorized by a proven hash mismatch or representation disagreement, and a
+// read that did not complete proves neither.
+//
+// It drives the production entry point ObjectStore.PutBlob. Collapsing the
+// existingUnreadable classification back into the quarantine branch of
+// resolveExistingConflict reddens it, because the valid occupant is then moved
+// out of the immutable namespace on a fault that proved nothing about it.
+func TestPutBlobReportsTransientInspectionReadFailureWithoutQuarantining(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("native Windows owner-DACL implementation is a later platform task")
+	}
+
+	content := []byte("valid immutable object")
+	tests := []struct {
+		name        string
+		openForRead func(string) (io.ReadCloser, error)
+	}{
+		{
+			name: "open fails",
+			openForRead: func(string) (io.ReadCloser, error) {
+				return nil, errTransientRead
+			},
+		},
+		{
+			name: "read fails part way through",
+			openForRead: func(string) (io.ReadCloser, error) {
+				return &failingReader{prefix: content[:4]}, nil
+			},
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			store := openTestStore(t)
+			digest := scalar.SHA256Digest(content)
+
+			// Install the valid object through the production path first, so
+			// what the retry finds is a genuinely published immutable object
+			// and not a hand-placed fixture.
+			if _, err := store.PutBlob(digest, uint64(len(content)), bytes.NewReader(content)); err != nil {
+				t.Fatalf("PutBlob(first install) error = %v", err)
+			}
+			target, err := nativeDigestPath(store.objects, digest)
+			if err != nil {
+				t.Fatal(err)
+			}
+			before := statSnapshot(t, target)
+
+			store.operations.openForRead = test.openForRead
+			result, err := store.PutBlob(digest, uint64(len(content)), bytes.NewReader(content))
+
+			if !errors.Is(err, ErrDurability) {
+				t.Fatalf("PutBlob(transient inspection read failure) error = %v, want %v", err, ErrDurability)
+			}
+			if errors.Is(err, ErrImmutableConflict) || errors.Is(err, ErrIntegrityMismatch) {
+				t.Fatalf("PutBlob(transient inspection read failure) error = %v, want a durability failure and not a mismatch verdict", err)
+			}
+			if result.QuarantinePath != "" || result.ExistingQuarantinePath != "" {
+				t.Fatalf("PutBlob(transient inspection read failure) result = %+v, want no quarantine path", result)
+			}
+			if result.Installed {
+				t.Fatalf("PutBlob(transient inspection read failure) reported an install: %+v", result)
+			}
+
+			// The object must still be the same inode with the same bytes and
+			// the same mode: nothing was moved, replaced, or truncated.
+			assertFileBytes(t, target, content)
+			assertUnmovedFile(t, target, before)
+			assertQuarantineRootEmpty(t, store.quarantine)
+			assertNoStagedFiles(t, filepath.Dir(target))
+		})
+	}
+}
+
+// TestInspectExistingClassifiesEveryFaultItCanReach pins the classification
+// itself, so a future edit cannot quietly widen existingDisagrees. Only a
+// completed read whose bytes differ may return existingDisagrees, because that
+// is the only verdict resolveExistingConflict is allowed to quarantine on.
+func TestInspectExistingClassifiesEveryFaultItCanReach(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("native Windows owner-DACL implementation is a later platform task")
+	}
+
+	content := []byte("classified")
+	digest := scalar.SHA256Digest(content)
+
+	tests := []struct {
+		name     string
+		occupant func(t *testing.T, store *ObjectStore, target string)
+		want     existingVerdict
+	}{
+		{
+			name:     "absent",
+			occupant: func(*testing.T, *ObjectStore, string) {},
+			want:     existingAbsent,
+		},
+		{
+			name: "identical bytes",
+			occupant: func(t *testing.T, _ *ObjectStore, target string) {
+				writeOccupant(t, target, content, 0o600)
+			},
+			want: existingMatches,
+		},
+		{
+			name: "different bytes at the same size",
+			occupant: func(t *testing.T, _ *ObjectStore, target string) {
+				writeOccupant(t, target, []byte("classifieD"), 0o600)
+			},
+			want: existingDisagrees,
+		},
+		{
+			name: "group readable mode",
+			occupant: func(t *testing.T, _ *ObjectStore, target string) {
+				writeOccupant(t, target, content, 0o640)
+			},
+			want: existingUnsafe,
+		},
+		{
+			name: "directory in the digest path",
+			occupant: func(t *testing.T, _ *ObjectStore, target string) {
+				if err := os.MkdirAll(target, 0o700); err != nil {
+					t.Fatal(err)
+				}
+			},
+			want: existingUnsafe,
+		},
+		{
+			name: "read stops part way through",
+			occupant: func(t *testing.T, store *ObjectStore, target string) {
+				writeOccupant(t, target, content, 0o600)
+				store.operations.openForRead = func(string) (io.ReadCloser, error) {
+					return &failingReader{prefix: content[:4]}, nil
+				}
+			},
+			want: existingUnreadable,
+		},
+		{
+			name: "open fails",
+			occupant: func(t *testing.T, store *ObjectStore, target string) {
+				writeOccupant(t, target, content, 0o600)
+				store.operations.openForRead = func(string) (io.ReadCloser, error) {
+					return nil, errTransientRead
+				}
+			},
+			want: existingUnreadable,
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			store := openTestStore(t)
+			target, err := nativeDigestPath(store.objects, digest)
+			if err != nil {
+				t.Fatal(err)
+			}
+			test.occupant(t, store, target)
+
+			got, inspectErr := store.inspectExisting(target, digest, uint64(len(content)))
+			if got != test.want {
+				t.Fatalf("inspectExisting() verdict = %v, want %v (error = %v)", got, test.want, inspectErr)
+			}
+			if test.want == existingDisagrees && inspectErr == nil {
+				t.Fatal("inspectExisting() proved a mismatch without reporting why")
+			}
+		})
+	}
+}
+
+// TestObjectStoreAndProjectionAgreeThatAFailedReadIsNotAMismatch asserts the
+// agreement between the two paths that read the authoritative object namespace
+// instead of assuming it. Both are driven through their production entry
+// points, PutBlob and openProjection, over the same data root and the same
+// class of fault: a read that does not complete.
+//
+// The shared obligation is that a failed read is reported as a failure and
+// never treated as a proven mismatch, so no object leaves the immutable
+// namespace and the quarantine root stays empty.
+func TestObjectStoreAndProjectionAgreeThatAFailedReadIsNotAMismatch(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("native Windows owner-DACL implementation is a later platform task")
+	}
+
+	content := []byte("agreed authoritative bytes")
+	digest := scalar.SHA256Digest(content)
+
+	tests := []struct {
+		name string
+		// drive induces a read failure in one production path and returns the
+		// error that path reported.
+		drive func(t *testing.T, store *ObjectStore, target string) error
+	}{
+		{
+			name: "object store PutBlob",
+			drive: func(t *testing.T, store *ObjectStore, _ string) error {
+				store.operations.openForRead = func(string) (io.ReadCloser, error) {
+					return &failingReader{prefix: content[:4]}, nil
+				}
+				result, err := store.PutBlob(digest, uint64(len(content)), bytes.NewReader(content))
+				if result.QuarantinePath != "" || result.ExistingQuarantinePath != "" {
+					t.Fatalf("PutBlob quarantined on a failed read: %+v", result)
+				}
+				return err
+			},
+		},
+		{
+			name: "projection openProjection",
+			drive: func(t *testing.T, store *ObjectStore, _ string) error {
+				_, _, err := openProjection(context.Background(), store.resolvedPathsForTest(t), projectionHooks{
+					afterBlobStat: func(string) error { return errTransientRead },
+				})
+				return err
+			},
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			store := openTestStore(t)
+			if _, err := store.PutBlob(digest, uint64(len(content)), bytes.NewReader(content)); err != nil {
+				t.Fatalf("PutBlob(first install) error = %v", err)
+			}
+			target, err := nativeDigestPath(store.objects, digest)
+			if err != nil {
+				t.Fatal(err)
+			}
+			before := statSnapshot(t, target)
+
+			err = test.drive(t, store, target)
+
+			if err == nil {
+				t.Fatal("a read that did not complete was reported as success")
+			}
+			// Neither path may report a failed read as a proven mismatch.
+			if errors.Is(err, ErrIntegrityMismatch) || errors.Is(err, ErrImmutableConflict) {
+				t.Fatalf("failed read reported as a mismatch verdict: %v", err)
+			}
+			assertFileBytes(t, target, content)
+			assertUnmovedFile(t, target, before)
+			assertQuarantineRootEmpty(t, store.quarantine)
+		})
+	}
+}
+
+func writeOccupant(t *testing.T, target string, content []byte, mode os.FileMode) {
+	t.Helper()
+	if err := os.MkdirAll(filepath.Dir(target), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(target, content, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chmod(target, mode); err != nil {
+		t.Fatal(err)
+	}
+}
+
+type fileIdentity struct {
+	mode    os.FileMode
+	size    int64
+	modTime int64
+}
+
+func statSnapshot(t *testing.T, path string) fileIdentity {
+	t.Helper()
+	info, err := os.Lstat(path)
+	if err != nil {
+		t.Fatalf("Lstat(%q) error = %v", path, err)
+	}
+	return fileIdentity{mode: info.Mode(), size: info.Size(), modTime: info.ModTime().UnixNano()}
+}
+
+func assertUnmovedFile(t *testing.T, path string, before fileIdentity) {
+	t.Helper()
+	after := statSnapshot(t, path)
+	if after != before {
+		t.Fatalf("object at %q changed: %+v, want %+v", path, after, before)
+	}
+}
+
+// assertQuarantineRootEmpty proves the negative directly: no quarantine
+// destination was created anywhere beneath the quarantine root.
+func assertQuarantineRootEmpty(t *testing.T, quarantineRoot string) {
+	t.Helper()
+	err := filepath.WalkDir(quarantineRoot, func(path string, entry fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if !entry.IsDir() {
+			t.Errorf("quarantine root holds %q after a read failure that proved no mismatch", path)
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatalf("walk quarantine root error = %v", err)
+	}
+}
