+			ExpectedDispos:    "exact",
+			ReasonCodes:       []string{},
+			Extensions:        map[string]any{},
+		}},
+		TargetOperations: []cloneplan.TargetOperationInput{{
+			Sequence:           1,
+			Action:             "write_blob",
