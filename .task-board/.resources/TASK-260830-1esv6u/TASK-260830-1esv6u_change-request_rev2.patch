+		"max_total_bytes":         limits.MaxTotalBytes,
+		"max_single_object_bytes": limits.MaxSingleObjectBytes,
+		"max_events":              limits.MaxEvents,
+		"max_target_resources":    limits.MaxTargetResources,
+	}
+}
