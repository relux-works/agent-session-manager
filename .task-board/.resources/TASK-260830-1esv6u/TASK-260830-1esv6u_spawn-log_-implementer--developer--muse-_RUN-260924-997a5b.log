"result\\\":{\\\"id\\\":\\\"TASK-260830-1esv6u\\\",\\\"name\\\":\\\"TASK-260830-1esv6u_recovery-rev2.md\\\",\\\"type\\\":\\\"outcome\\\",\\\"uri\\\":\\\"file://TASK-260830-1esv6u/TASK-260830-1esv6u_recovery-rev2.md\\\"}}\\n\",\n  \"original_output_bytes\": 181,\n  \"original_output_tokens\": 46,\n  \"truncated\": false\n}","final_result":true}}}
