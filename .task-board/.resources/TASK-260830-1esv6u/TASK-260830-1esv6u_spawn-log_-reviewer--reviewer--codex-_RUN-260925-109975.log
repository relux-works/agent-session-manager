		FidelityReport:   fidelityBytes,
		FidelityID:       fidelity.ReportID.String(),
		ValidationReport: validationBytes,
		Valid:            valid,
		Candidates:       len(input.Candidates),
		RawItems:         len(rawSet),
		CanonicalItems:   len(canonicalSet),
		Rows:             len(fidelity.Rows),
	}, nil
}

