t\tt.Fatalf(\"read dir: %v\", err)\n41|\t}\n42|\tfiles := make(map[string]*ast.File)\n43|\tfor _, entry := range entries {\n44|\t\tname := entry.Name()\n45|\t\tif !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n46|\t\t\tcontinue\n47|\t\t}\n48|\t\tsource, err := os.ReadFile(filepath.Join(dir, name))\n49|\t\tif err != nil {\n50|\t\t\tt.Fatalf(\"read %s: %v\", name, err)\n51|\t\t}\n52|\t\tparsed, err := parser.ParseFile(token.NewFileSet(), name, source, 0)\n53|\t\tif err != nil {\n54|\t\t\tt.Fatalf(\"parse %s: %v\", name, err)\n55|\t\t}\n56|\t\tfiles[name] = parsed\n57|\t}\n58|\treturn files\n59|}\n60|\n61|// TestEntryCensus pins the exported production entry set: exactly\n62|// ReadBackHistory and Reconcile. A new entry fails here until its\n63|// owner edges are censused below.\n64|func TestEntryCensus(t *testing.T) {\n65|\tfiles := productionFiles(t, packageDir(t))\n66|\tvar entries []string\n67|\tfor _, file := range files {\n68|\t\tfor _, decl := range file.Decls {\n69|\t\t\tfn, ok := decl.(*ast.FuncDecl)\n70|\t\t\tif !ok || fn.Recv != nil || !ast.IsExported(fn.Name.Name) {\n71|\t\t\t\tcontinue\n72|\t\t\t}\n73|\t\t\tentries = append(entries, fn.Name.Name)\n74|\t\t}\n75|\t}\n76|\tsort.Strings(entries)\n77|\twant := []string{\"ReadBackHistory\", \"Reconcile\"}\n78|\tif strings.Join(entries, \",\") != strings.Join(want, \",\") {\n79|\t\tt.Fatalf(\"exported entries = %q, want %q\", entries, want)\n80|\t}\n81|}\n82|\n83|// callEdges maps each package-level function to the qualified\n84|// selectors and bare identifiers it calls.\n85|func callEdges(files map[string]*ast.File) map[string][]string {\n86|\tedges := make(map[string][]string)\n87|\tfor _, file := range files {\n88|\t\tfor _, decl := range file.Decls {\n89|\t\t\tfn, ok := decl.(*ast.FuncDecl)\n90|\t\t\tif !ok {\n91|\t\t\t\tcontinue\n92|\t\t\t}\n93|\t\t\tvar calls []string\n94|\t\t\tast.Inspect(fn.Body, func(node ast.Node) bool {\n95|\t\t\t\tcall, ok := node.(*ast.CallExpr)\n96|\t\t\t\tif !ok {\n97|\t\t\t\t\treturn true\n98|\t\t\t\t}\n99|\t\t\t\tswitch fun := call.Fun.(type) {\n100|\t\t\t\tcase *ast.SelectorExpr:\n101|\t\t\t\t\tif ident, ok := fun.X.(*ast.Ident); ok {\n102|\t\t\t\t\t\tcalls = append(calls, ident.Name+\".\"+fun.Sel.Name)\n103|\t\t\t\t\t}\n104|\t\t\t\tcase *ast.Ident:\n105|\t\t\t\t\tcalls = append(calls, fun.Name)\n106|\t\t\t\t}\n107|\t\t\t\treturn true\n108|\t\t\t})\n109|\t\t\tedges[fn.Name.Name] = calls\n110|\t\t}\n111|\t}\n112|\treturn edges\n113|}\n114|\n115|// reachableOwners returns the transitive owner-qualified selectors\n116|// reachable from entry through package-level calls.\n117|func reachableOwners(entry string, edges map[string][]string) map[string]bool {\n118|\treached := make(map[string]bool)\n119|\tvar visit func(name string)\n120|\tvisit = func(name string) {\n121|\t\tfor _, callee := range edges[name] {\n122|\t\t\tif strings.Contains(callee, \".\") {\n123|\t\t\t\treached[callee] = true\n124|\t\t\t\tcontinue\n125|\t\t\t}\n126|\t\t\tif _, seen := edges[callee]; seen {\n127|\t\t\t\tif !reached[\"func:\"+callee] {\n128|\t\t\t\t\treached[\"func:\"+callee] = true\n129|\t\t\t\t\tvisit(callee)\n130|\t\t\t\t}\n131|\t\t\t}\n132|\t\t}\n133|\t}\n134|\tvisit(entry)\n135|\treturn reached\n136|}\n137|\n138|// TestEntryOwnerReachability pins that every production entry\n139|// reaches its required owner validators on the static call graph:\n140|// read-back history decodes only through the read-back owner, and\n141|// reconciliation derives the fidelity report, plan/projected\n142|// inputs, and validation report only through their owners.\n143|func TestEntryOwnerReachability(t *testing.T) {\n144|\tedges := callEdges(productionFiles(t, packageDir(t)))\n145|\trequired := map[string][]string{\n146|\t\t\"ReadBackHistory\": {\"clonereadback.DecodeReadBackEvidenceManifest\"},\n147|\t\t\"Reconcile\": {\n148|\t\t\t\"clonefidelity.BuildFidelityReport\",\n149|\t\t\t\"clonefidelity.DecodeFidelityReport\",\n150|\t\t\t\"cloneplan.DecodeProjectionPlan\",\n151|\t\t\t\"cloneplan.DecodeProjectedObjectManifest\",\n152|\t\t\t\"clonereadback.BuildValidationReport\",\n153|\t\t},\n154|\t}\n155|\tfor entry, owners := range required {\n156|\t\treached := reachableOwners(entry, edges)\n157|\t\tfor _, owner := range owners {\n158|\t\t\tif !reached[owner] {\n159|\t\t\t\tt.Errorf(\"entry %s does not reach owner %s on the call graph\", entry, owner)\n160|\t\t\t}\n161|\t\t}\n162|\t}\n163|}\n164|\n165|// TestOwnerReachabilityControlPlant proves the reachability checker\n166|// bites: an entry that never calls the owner is reported.\n167|func TestOwnerReachabilityControlPlant(t *testing.T) {\n168|\tplant := `\n169|package planted\n170|func Reconcile() {}\n171|`\n172|\tparsed, err := parser.ParseFile(token.NewFileSet(), \"plant.go\", plant, 0)\n173|\tif err != nil {\n174|\t\tt.Fatalf(\"parse plant: %v\", err)\n175|\t}\n176|\treached := reachableOwners(\"Reconcile\", callEdges(map[string]*ast.File{\"plant.go\": parsed}))\n177|\tif reached[\"clonefidelity.BuildFidelityReport\"] {\n178|\t\tt.Fatalf(\"control plant reached the owner without calling it\")\n179|\t}\n180|}\n181|\n182|// forbiddenReimplementations are owner-rule tokens no production\n183|// file may carry: shape parsing/rendering, digest/UUID/tuple\n184|// decoding, JCS, vocabulary re-checks, and the read-back seal.\n185|var forbiddenReimplementations = []string{\n186|\t\"urn:ax:schema:\",\n187|\t\"json.Marshal\",\n188|\t\"json.Unmarshal\",\n189|\t\"sha256.\",\n190|\t\"jcs.\",\n191|\t\"Canonicalize\",\n192|\t\"ParseUUID\",\n193|\t\"DecodeStrictObject\",\n194|\t\"CheckDigest\",\n195|\t\"CheckUUIDv7\",\n196|\t\"CheckStringBounds\",\n197|\t\"CheckUint53Bounds\",\n198|\t\"ValidReadBackMode\",\n199|\t\"ValidEvidenceKind\",\n200|\t\"ValidDisposition(\",\n201|\t\"ValidCaptureClass(\",\n202|\t\"sealReadBack\",\n203|\t\"decideValid\",\n204|\t\"ValidatedReadBack{\",\n205|}\n206|\n207|// allowedOwnerPredicates are the two vocabulary predicates\n208|// production legitimately calls (tier-1 exclusions, tier-2\n209|// normalizations); every other vocabulary token above is a fork.\n210|var allowedOwnerPredicates = []string{\n211|\t\"clonebundle.ValidCaptureClass(\",\n212|\t\"clonefidelity.ValidDisposition(\",\n213|}\n214|\n215|// guardReimplementation scans one source for forked owner rules.\n216|func guardReimplementation(source string) []string {\n217|\tvar hits []string\n218|\tfor _, token := range forbiddenReimplementations {\n219|\t\tallowed := false\n220|\t\tfor _, predicate := range allowedOwnerPredicates {\n221|\t\t\tif strings.Contains(predicate, token) {\n222|\t\t\t\tallowed = true\n223|\t\t\t\tbreak\n224|\t\t\t}\n225|\t\t}\n226|\t\tfor _, line := range strings.Split(source, \"\\n\") {\n227|\t\t\ttrimmed := strings.TrimSpace(line)\n228|\t\t\tif strings.HasPrefix(trimmed, \"//\") {\n229|\t\t\t\tcontinue\n230|\t\t\t}\n231|\t\t\tif !strings.Contains(line, token) {\n232|\t\t\t\tcontinue\n233|\t\t\t}\n234|\t\t\tif allowed {\n235|\t\t\t\trest := line\n236|\t\t\t\tfor _, predicate := range allowedOwnerPredicates {\n237|\t\t\t\t\trest = strings.ReplaceAll(rest, predicate, \"\")\n238|\t\t\t\t}\n239|\t\t\t\tif !strings.Contains(rest, token) {\n240|\t\t\t\t\tcontinue\n241|\t\t\t\t}\n242|\t\t\t}\n243|\t\t\thits = append(hits, token)\n244|\t\t\tbreak\n245|\t\t}\n246|\t}\n247|\treturn hits\n248|}\n249|\n250|// TestNoOwnerReimplementation pins that production never\n251|// re-implements an owner rule: no shape URNs, no JSON\n252|// marshal/unmarshal, no digest/UUID/tuple decoding outside the\n253|// delegated scalar/tuple calls, no vocabulary re-checks beyond the\n254|// two allowlisted predicates, and no read-back seal construction.\n255|func TestNoOwnerReimplementation(t *testing.T) {\n256|\tdir := packageDir(t)\n257|\tentries, err := os.ReadDir(dir)\n258|\tif err != nil {\n259|\t\tt.Fatalf(\"read dir: %v\", err)\n260|\t}\n261|\tfor _, entry := range entries {\n262|\t\tname := entry.Name()\n263|\t\tif !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n264|\t\t\tcontinue\n265|\t\t}\n266|\t\tsource, err := os.ReadFile(filepath.Join(dir, name))\n267|\t\tif err != nil {\n268|\t\t\tt.Fatalf(\"read %s: %v\", name, err)\n269|\t\t}\n270|\t\tif hits := guardReimplementation(string(source)); len(hits) > 0 {\n271|\t\t\tt.Errorf(\"%s re-implements owner rules: %q\", name, hits)\n272|\t\t}\n273|\t}\n274|}\n275|\n276|// TestNoOwnerReimplementationControlPlant proves the guard bites: a\n277|// planted local digest check and a planted seal literal are both\n278|// reported, while the allowlisted predicates pass.\n279|func TestNoOwnerReimplementationControlPlant(t *testing.T) {\n280|\tplant := `\n281|package planted\n282|import \"crypto/sha256\"\n283|func check(input string) bool {\n284|\tsum := sha256.Sum256([]byte(input))\n285|\t_ = sum\n286|\treturn true\n287|}\n288|var _ = \"urn:ax:schema:clone-validation-report\"\n289|`\n290|\tif hits := guardReimplementation(plant); len(hits) != 2 {\n291|\t\tt.Fatalf(\"control plant hits = %q, want the sha256 and URN tokens\", hits)\n292|\t}\n293|\tclean := `\n294|package planted\n295|func check(class, disposition string) bool {\n296|\treturn clonebundle.ValidCaptureClass(class) && clonefidelity.ValidDisposition(disposition)\n297|}\n298|`\n299|\tif hits := guardReimplementation(clean); len(hits) != 0 {\n300|\t\tt.Fatalf(\"allowlisted predicates hit = %q, want none\", hits)\n301|\t}\n302|}\n303|\n304|// TestSealedReadsNeverMinted pins that production never constructs\n305|// a ValidatedReadBack composite literal: seals arrive only from\n306|// the read-back owner's entries.\n307|func TestSealedReadsNeverMinted(t *testing.T) {\n308|\t// Enforced by TestNoOwnerReimplementation (ValidatedReadBack{\n309|\t// is a forbidden token); this test pins the positive shape:\n310|\t// History flows from ReadBackHistory into Reconcile.\n311|\tdocs := sealSharedWorldDocs(t)\n312|\tinput := gateBaseline(t, docs)\n313|\tif input.History.Staged.Mode() != \"staged\" || input.History.Live.Mode() != \"live\" {\n314|\t\tt.Fatalf(\"baseline history modes = %q/%q\", input.History.Staged.Mode(), input.History.Live.Mode())\n315|\t}\n316|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
