int, len(bindings))\n529|\tfor key, group := range bindings {\n530|\t\tif len(group.Clauses) == 0 {\n531|\t\t\tcontinue\n532|\t\t}\n533|\t\tinventory, err := sectionClauseInventory(document, key)\n534|\t\tif err != nil {\n535|\t\t\tt.Fatalf(\"%s binding %q inventory: %v\", tag, key, err)\n536|\t\t}\n537|\t\tlines := make(map[string]int, len(inventory))\n538|\t\tfor _, clause := range inventory {\n539|\t\t\tlines[clause.ID] = clause.Line\n540|\t\t}\n541|\t\tfor _, discharged := range group.Clauses {\n542|\t\t\tif _, ok := lines[discharged.ID]; !ok {\n543|\t\t\t\tt.Fatalf(\"%s binding %q clause %s is not a measured clause of its section\", tag, key, discharged.ID)\n544|\t\t\t}\n545|\t\t\tif !quoteBeginsAtLine(document, discharged.Excerpt, discharged.Line) {\n546|\t\t\t\tt.Fatalf(\"%s binding %q clause %s excerpt does not begin at line %d\", tag, key, discharged.ID, discharged.Line)\n547|\t\t\t}\n548|\t\t}\n549|\t\tresult[key] = lines\n550|\t}\n551|\treturn result\n552|}\n553|\n554|func assertAcceptanceCasesRederive(t *testing.T, previous, current ownershipRegistry) {\n555|\tt.Helper()\n556|\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
