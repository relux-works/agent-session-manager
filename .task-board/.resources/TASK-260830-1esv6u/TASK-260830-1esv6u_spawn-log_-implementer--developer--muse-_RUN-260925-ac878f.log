ndidates),\n219|\t\tRawItems:         len(rawSet),\n220|\t\tCanonicalItems:   len(canonicalSet),\n221|\t\tRows:             len(fidelity.Rows),\n222|\t}, nil\n223|}\n224|\n225|// checkCandidates enforces the tier-1 census domain: candidate keys\n226|// are unique valid-UTF-8 strings of 1..512 characters. Character\n227|// measure delegates to environ.StringLength.\n228|func checkCandidates(candidates []string) error {\n229|\tseen := make(map[string]bool, len(candidates))\n230|\tfor _, candidate := range candidates {\n231|\t\tif !utf8.ValidString(candidate) {\n232|\t\t\treturn refuse(\"candidate key is not valid UTF-8\")\n233|\t\t}\n234|\t\tif length := environ.StringLength(candidate); length < 1 || length > 512 {\n235|\t\t\treturn refuse(\"candidate key is not a string[1..512]\")\n236|\t\t}\n237|\t\tif seen[candidate] {\n238|\t\t\treturn refuse(\"candidates carry duplicate %q\", candidate)\n239|\t\t}\n240|\t\tseen[candidate] = true\n241|\t}\n242|\treturn nil\n243|}\n244|\n245|// checkTier1 enforces \"every captured candidate reconciles once to\n246|// raw evidence or exclusion\": the links cover the declared\n247|// candidates exactly, each link carries exactly one arm, raw\n248|// digests parse through the scalar owner and are claimed once, and\n249|// exclusions name capture classes through the clonebundle owner. It\n250|// returns the included candidates and the raw-evidence set the next\n251|// tiers close over.\n252|func checkTier1(candidates []string, links []CandidateLink) (map[string]bool, map[string]bool, map[string]string, error) {\n253|\tif err := checkCandidates(candidates); err != nil {\n254|\t\treturn nil, nil, nil, err\n255|\t}\n256|\tdeclared := make(map[string]bool, len(candidates))\n257|\tfor _, candidate := range candidates {\n258|\t\tdeclared[candidate] = true\n259|\t}\n260|\tlinked := make(map[string]bool, len(links))\n261|\tincluded := make(map[string]bool)\n262|\trawSet := make(map[string]bool)\n263|\trawByCandidate := make(map[string]string)\n264|\tfor _, link := range links {\n265|\t\tif !declared[link.Candidate] {\n266|\t\t\treturn nil, nil, nil, refuse(\"tier-1 link names undeclared candidate %q\", link.Candidate)\n267|\t\t}\n268|\t\tif linked[link.Candidate] {\n269|\t\t\treturn nil, nil, nil, refuse(\"tier-1 candidate %q reconciles twice\", link.Candidate)\n270|\t\t}\n271|\t\tlinked[link.Candidate] = true\n272|\t\tswitch {\n273|\t\tcase link.Raw != \"\" && link.Exclusion != \"\":\n274|\t\t\treturn nil, nil, nil, refuse(\"tier-1 candidate %q claims both raw evidence and exclusion\", link.Candidate)\n275|\t\tcase link.Raw == \"\" && link.Exclusion == \"\":\n276|\t\t\treturn nil, nil, nil, refuse(\"tier-1 candidate %q has neither raw evidence nor exclusion\", link.Candidate)\n277|\t\tcase link.Raw != \"\":\n278|\t\t\traw, err := scalar.ParseDigest(link.Raw)\n279|\t\t\tif err != nil {\n280|\t\t\t\treturn nil, nil, nil, refuse(\"tier-1 raw evidence %q is not a digest: %v\", link.Raw, err)\n281|\t\t\t}\n282|\t\t\tif rawSet[raw.String()] {\n283|\t\t\t\treturn nil, nil, nil, refuse(\"tier-1 raw evidence %q is claimed twice\", raw.String())\n284|\t\t\t}\n285|\t\t\trawSet[raw.String()] = true\n286|\t\t\tincluded[link.Candidate] = true\n287|\t\t\trawByCandidate[link.Candidate] = raw.String()\n288|\t\tdefault:\n289|\t\t\tif !clonebundle.ValidCaptureClass(link.Exclusion) {\n290|\t\t\t\treturn nil, nil, nil, refuse(\"tier-1 exclusion %q is outside the capture classes\", link.Exclusion)\n291|\t\t\t}\n292|\t\t}\n293|\t}\n294|\tfor _, candidate := range candidates {\n295|\t\tif !linked[candidate] {\n296|\t\t\treturn nil, nil, nil, refuse(\"tier-1 candidate %q has no link to raw evidence or exclusion\", candidate)\n297|\t\t}\n298|\t}\n299|\treturn included, rawSet, rawByCandidate, nil\n300|}\n301|\n302|// checkTier2 enforces \"every raw item to a canonical item or\n303|// normalization disposition\": the links cover the tier-1 raw set\n304|// exactly, each link carries exactly one arm, canonical digests\n305|// parse through the scalar owner and are claimed once (the tiers\n306|// compose into an injective chain, because two raws sharing one\n307|// canonical could not each sit in exactly one row), and\n308|// normalizations name non-synthesized dispositions through the\n309|// fidelity owner (a raw item cannot normalize into a synthesized\n310|// canonical, which is sourceless by owner rule). It returns the\n311|// canonical set and the normalized raw set tier 3 closes over.\n312|func checkTier2(rawSet map[string]bool, links []RawLink) (map[string]bool, map[string]bool, map[string]string, error) {\n313|\tlinked := make(map[string]bool, len(links))\n314|\tcanonicalSet := make(map[string]bool)\n315|\tnormalized := make(map[string]bool)\n316|\tcanonicalByRaw := make(map[string]string)\n317|\tfor _, link := range links {\n318|\t\traw, err := scalar.ParseDigest(link.Raw)\n319|\t\tif err != nil {\n320|\t\t\treturn nil, nil, nil, refuse(\"tier-2 raw item %q is not a digest: %v\", link.Raw, err)\n321|\t\t}\n322|\t\tif !rawSet[raw.String()] {\n323|\t\t\treturn nil, nil, nil, refuse(\"tier-2 link names unreconciled raw item %q\", raw.String())\n324|\t\t}\n325|\t\tif linked[raw.String()] {\n326|\t\t\treturn nil, nil, nil, refuse(\"tier-2 raw item %q reconciles twice\", raw.String())\n327|\t\t}\n328|\t\tlinked[raw.String()] = true\n329|\t\tswitch {\n330|\t\tcase link.Canonical != \"\" && link.Normalization != \"\":\n331|\t\t\treturn nil, nil, nil, refuse(\"tier-2 raw item %q claims both a canonical item and a normalization disposition\", raw.String())\n332|\t\tcase link.Canonical == \"\" && link.Normalization == \"\":\n333|\t\t\treturn nil, nil, nil, refuse(\"tier-2 raw item %q has neither a canonical item nor a normalization disposition\", raw.String())\n334|\t\tcase link.Canonical != \"\":\n335|\t\t\tcanonical, err := scalar.ParseDigest(link.Canonical)\n336|\t\t\tif err != nil {\n337|\t\t\t\treturn nil, nil, nil, refuse(\"tier-2 canonical item %q is not a digest: %v\", link.Canonical, err)\n338|\t\t\t}\n339|\t\t\tif canonicalSet[canonical.String()] {\n340|\t\t\t\treturn nil, nil, nil, refuse(\"tier-2 canonical item %q is claimed twice\", canonical.String())\n341|\t\t\t}\n342|\t\t\tcanonicalSet[canonical.String()] = true\n343|\t\t\tcanonicalByRaw[raw.String()] = canonical.String()\n344|\t\tdefault:\n345|\t\t\tif !clonefidelity.ValidDisposition(link.Normalization) {\n346|\t\t\t\treturn nil, nil, nil, refuse(\"tier-2 normalization %q is outside the dispositions\", link.Normalization)\n347|\t\t\t}\n348|\t\t\tif link.Normalization == \"synthesized\" {\n349|\t\t\t\treturn nil, nil, nil, refuse(\"tier-2 raw item %q normalizes to synthesized, which is sourceless\", raw.String())\n350|\t\t\t}\n351|\t\t\tnormalized[raw.String()] = true\n352|\t\t}\n353|\t}\n354|\tvar missing []string\n355|\tfor raw := range rawSet {\n356|\t\tif !linked[raw] {\n357|\t\t\tmissing = append(missing, raw)\n358|\t\t}\n359|\t}\n360|\tsort.Strings(missing)\n361|\tif len(missing) > 0 {\n362|\t\treturn nil, nil, nil, refuse(\"tier-2 raw item %q has no link to a canonical item or normalization disposition\", missing[0])\n363|\t}\n364|\treturn canonicalSet, normalized, canonicalByRaw, nil\n365|}\n366|\n367|// isLossDisposition reports whether a disposition is explicit\n368|// target loss: omitted or unrecoverable. Loss rows carry a target\n369|// disposition instead of target evidence; every other\n370|// non-synthesized row must resolve staged and live evidence into\n371|// the sealed reads.\n372|func isLossDisposition(disposition string) bool {\n373|\treturn disposition == \"omitted\" || disposition == \"unrecoverable\"\n374|}\n375|\n376|// checkTier3 enforces \"every canonical item to staged/live target\n377|// evidence or a target disposition\" over the owner-decoded fidelity\n378|// rows: every included candidate and every canonical item occurs in\n379|// exactly one non-synthesized row, excluded candidates take no row,\n380|// each row's canonical agrees with the tier-1/tier-2 chain,\n381|// synthesized rows never claim captured source evidence, and every\n382|// claimed evidence ID resolves into the sealed read of its side.\n383|func checkTier3(\n384|\tincluded map[string]bool,\n385|\trawByCandidate map[string]string,\n386|\tcanonicalByRaw map[string]string,\n387|\trawSet map[string]bool,\n388|\trows []clonefidelity.DispositionRecord,\n389|\thistory History,\n390|) error {\n391|\tstagedBlobs := make(map[string]bool)\n392|\tfor _, row := range history.Staged.Manifest().EvidenceObjects {\n393|\t\tstagedBlobs[row.BlobID.String()] = true\n394|\t}\n395|\tliveBlobs := make(map[string]bool)\n396|\tfor _, row := range history.Live.Manifest().EvidenceObjects {\n397|\t\tliveBlobs[row.BlobID.String()] = true\n398|\t}\n399|\tcoveredCandidates := make(map[string]bool)\n(more lines below)","final_result":true}}}
