{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c74d","stream":{"kind":"session","id":"01a0d602-12a6-7cb3-99d1-8d1cf4fb003f"},"sequence":513,"recorded_at":1780531400001021,"record_type":"event","durability":"durable","causation_id":"8384434d-9d62-45ba-bafd-be548807fde7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"8384434d-9d62-45ba-bafd-be548807fde7","run_stream":{"kind":"run","id":"8384434d-9d62-45ba-bafd-be548807fde7"},"call_id":"call_01a0d6034676758d8b9f1894bdb5ad24","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/clonereconcile/fixtures_test.go`.\n1|package clonereconcile_test\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"encoding/json\"\n7|\t\"errors\"\n8|\t\"sort\"\n9|\t\"strings\"\n10|\t\"testing\"\n11|\n12|\t\"github.com/gowebpki/jcs\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/clonefidelity\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/cloneplan\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/clonereadback\"\n17|\tclonereconcile \"github.com/relux-works/agent-session-manager/internal/clonereconcile\"\n18|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n19|)\n20|\n21|// Shared fixtures for the clonereconcile suite. Every literal is\n22|// hand-written and independent of production constants: verdicts\n23|// always come from production; vectors never do. Owner-shaped\n24|// documents (tuple, binding, findings, plan, projected, reads,\n25|// fidelity rows) are built through the same owner entries\n26|// production calls, so the baseline is valid by construction and\n27|// each test mutates exactly one gate.\n28|\n29|// fixtureDigest renders a deterministic pinned-form digest for one\n30|// seed.\n31|func fixtureDigest(seed string) string {\n32|\tsum := sha256.Sum256([]byte(\"clonereconcile:\" + seed))\n33|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n34|}\n35|\n36|// fixtureOperationID renders a deterministic lowercase UUIDv7.\n37|func fixtureOperationID(seed string) string {\n38|\tsum := sha256.Sum256([]byte(\"clonereconcile-operation:\" + seed))\n39|\thexed := hex.EncodeToString(sum[:])\n40|\ttimeField := hexed[:12]\n41|\trandA := hexed[12:15]\n42|\trandB := hexed[16:28]\n43|\treturn timeField[:8] + \"-\" + timeField[8:12] + \"-7\" + randA + \"-8\" + randB[:3] + \"-\" + randB[3:12] + hexed[28:31]\n44|}\n45|\n46|// fixtureTuple is the one shared target tuple every paired document\n47|// carries: reads observe it, the plan targets it, and both reports\n48|// bind it.\n49|func fixtureTuple() []byte {\n50|\treturn []byte(`{\"adapter_version\":\"1.2.3\",\"architecture\":\"arm64\",\"environment_id\":\"relux.target\",\"environment_version\":\"2026.09\",\"platform\":\"macos\",\"store_schema_fingerprint\":\"` + fixtureDigest(\"store-fingerprint\") + `\"}`)\n51|}\n52|\n53|// fixtureTupleOther is a distinct owner-valid tuple for cross-match\n54|// refusal cells.\n55|func fixtureTupleOther() []byte {\n56|\treturn []byte(`{\"adapter_version\":\"1.2.4\",\"architecture\":\"amd64\",\"environment_id\":\"relux.other\",\"environment_version\":\"2026.09\",\"platform\":\"linux\",\"store_schema_fingerprint\":\"` + fixtureDigest(\"store-fingerprint-other\") + `\"}`)\n57|}\n58|\n59|// fixtureBinding is one owner-valid Workspace Binding document.\n60|func fixtureBinding() []byte {\n61|\tfirst, second := fixtureDigest(\"remote-a\"), fixtureDigest(\"remote-b\")\n62|\tif second < first {\n63|\t\tfirst, second = second, first\n64|\t}\n65|\treturn []byte(`{\"branch\":\"main\",\"cwd_relative\":\"work/session\",\"extensions\":{},\"head_digest\":\"` + fixtureDigest(\"head\") + `\",\"index_digest\":null,\"logical_workspace_id\":\"` + fixtureOperationID(\"workspace\") + `\",\"repository_remote_fingerprints\":[\"` + first + `\",\"` + second + `\"],\"working_tree_digest\":null}`)\n66|}\n67|\n68|// fixtureFindings renders one owner-valid findings array over the\n69|// given severities.\n70|func fixtureFindings(severities ...string) []byte {\n71|\tvar rows []string\n72|\tfor index, severity := range severities {\n73|\t\trows = append(rows, `{\"code\":\"probe-`+itoa(index)+`\",\"extensions\":{},\"message\":\"finding `+itoa(index)+`\",\"remediation\":null,\"severity\":\"`+severity+`\"}`)\n74|\t}\n75|\treturn []byte(\"[\" + strings.Join(rows, \",\") + \"]\")\n76|}\n77|\n78|// fixtureAuthority decodes one owner-valid ReadAuthority carrying\n79|// the given purpose through the sessadapter owner.\n80|func fixtureAuthority(t *testing.T, purpose string) sessadapter.ReadAuthority {\n81|\tt.Helper()\n82|\traw := []byte(`{\"authority_id\":\"` + fixtureOperationID(\"authority-\"+purpose) + `\",\"purpose\":\"` + purpose + `\",\"root_handle_names\":[\"handle-a\"],\"expires_at\":\"2026-09-24T00:00:00.000Z\",\"extensions\":{}}`)\n83|\tauthority, err := sessadapter.DecodeReadAuthority(raw)\n84|\tif err != nil {\n85|\t\tt.Fatalf(\"DecodeReadAuthority(%s): %v\", purpose, err)\n86|\t}\n87|\treturn authority\n88|}\n89|\n90|func strptr(value string) *string { return &value }\n91|\n92|func itoa(value int) string {\n93|\tif value == 0 {\n94|\t\treturn \"0\"\n95|\t}\n96|\tdigits := []byte{}\n97|\tfor value > 0 {\n98|\t\tdigits = append([]byte{byte('0' + value%10)}, digits...)\n99|\t\tvalue /= 10\n100|\t}\n101|\treturn string(digits)\n102|}\n103|\n104|const fixtureNativeSession = \"target-native-session-1\"\n105|\n106|// evidenceFor renders the evidence rows one sealed read carries for\n107|// the given blob seeds, sorted by (kind, blob) as the read-back\n108|// owner requires.\n109|func evidenceFor(t *testing.T, seeds []string) []clonereadback.EvidenceObjectInput {\n110|\tt.Helper()\n111|\trows := make([]clonereadback.EvidenceObjectInput, 0, len(seeds))\n112|\tfor _, seed := range seeds {\n113|\t\trows = append(rows, clonereadback.EvidenceObjectInput{\n114|\t\t\tEvidenceKind:     \"native_sample\",\n115|\t\t\tMediaType:        \"application/octet-stream\",\n116|\t\t\tByteCount:        64,\n117|\t\t\tBlobID:           fixtureDigest(seed),\n118|\t\t\tBlobDescriptorID: fixtureDigest(\"descriptor-\" + seed),\n119|\t\t})\n120|\t}\n121|\tsort.Slice(rows, func(i, j int) bool { return rows[i].BlobID < rows[j].BlobID })\n122|\treturn rows\n123|}\n124|\n125|// sealRead seals one read-back manifest through the read-back owner\n126|// under the authority for its mode, observing the shared target.\n127|func sealRead(t *testing.T, mode, planID, projectedID string, evidence []clonereadback.EvidenceObjectInput) (clonereadback.ValidatedReadBack, []byte) {\n128|\tt.Helper()\n129|\treturn sealReadFull(t, mode, planID, projectedID, evidence, fixtureNativeSession, fixtureTuple())\n130|}\n131|\n132|// sealReadFull seals one read-back manifest observing the given\n133|// native session and tuple: pairing cells seal reads against\n134|// neighbor targets while the shared plan/projected stay fixed.\n135|func sealReadFull(t *testing.T, mode, planID, projectedID string, evidence []clonereadback.EvidenceObjectInput, session string, env []byte) (clonereadback.ValidatedReadBack, []byte) {\n136|\tt.Helper()\n137|\tpurpose := \"target_staged\"\n138|\tif mode == \"live\" {\n139|\t\tpurpose = \"target_live\"\n140|\t}\n141|\tinput := clonereadback.ReadBackManifestInput{\n142|\t\tOperationID:                 fixtureOperationID(\"read-\" + mode + session),\n143|\t\tMode:                        mode,\n144|\t\tProjectionPlanID:            planID,\n145|\t\tProjectedObjectManifestID:   projectedID,\n146|\t\tExpectedTargetNativeSession: session,\n147|\t\tObservedTargetNativeSession: session,\n148|\t\tObservedEnvironment:         env,\n149|\t\tParsedEventCount:            7,\n150|\t\tParsedHeadIDs:               []string{\"head-a\"},\n151|\t\tWorkspaceBinding:            fixtureBinding(),\n152|\t\tStructuralDigest:            fixtureDigest(\"structural-\" + mode),\n153|\t\tEvidenceObjects:             evidence,\n154|\t\tExtensions:                  map[string]any{},\n155|\t}\n156|\tsealed, bytes, err := clonereadback.BuildReadBackEvidenceManifest(input, fixtureAuthority(t, purpose))\n157|\tif err != nil {\n158|\t\tt.Fatalf(\"BuildReadBackEvidenceManifest(%s): %v\", mode, err)\n159|\t}\n160|\treturn sealed, bytes\n161|}\n162|\n163|// validPlanInput renders one valid projection plan candidate bound\n164|// to the shared target.\n165|func validPlanInput() cloneplan.ProjectionPlanInput {\n166|\treturn cloneplan.ProjectionPlanInput{\n167|\t\tOperationID:                 fixtureOperationID(\"plan\"),\n168|\t\tBundleID:                    fixtureOperationID(\"bundle\"),\n169|\t\tRequestDigest:               fixtureDigest(\"request\"),\n170|\t\tSourceSnapshotDigest:        fixtureDigest(\"snapshot\"),\n171|\t\tCaptureManifestID:           fixtureDigest(\"capture\"),\n172|\t\tCanonicalSessionID:          fixtureDigest(\"canonical\"),\n173|\t\tCanonicalEventIDs:           []string{},\n174|\t\tSourceEnvironment:           fixtureTuple(),\n175|\t\tTargetEnvironment:           fixtureTuple(),\n176|\t\tExpectedTargetNativeSession: fixtureNativeSession,\n177|\t\tTargetWorkspace:             []byte(`{\"logical_workspace_id\":\"` + fixtureOperationID(\"plan-workspace\") + `\",\"cwd_relative\":\"work/target\",\"repository_remote_fingerprints\":[],\"branch\":null,\"head_digest\":null,\"index_digest\":null,\"working_tree_digest\":null,\"extensions\":{}}`),\n178|\t\tStrategy:                    \"target_native_writer\",\n179|\t\tStrategyRationale:           \"native writer covers the target tuple\",\n180|\t\tFidelityProfile:             \"maximal_safe\",\n181|\t\tRequiredDispositions:        map[string][]string{\"durable_payload\": {\"exact\"}},\n182|\t\tForbidReasons:               []string{},\n183|\t\tItemMappings: []cloneplan.ItemMappingInput{{\n184|\t\t\tSourceItemKey:     \"a-item\",\n185|\t\t\tCanonicalObjectID: strptr(fixtureDigest(\"canonical-a-item\")),\n186|\t\t\tTargetResourceKey: []string{\"res/a-item\"},\n187|\t\t\tExpectedDispos:    \"exact\",\n188|\t\t\tReasonCodes:       []string{},\n189|\t\t\tExtensions:        map[string]any{},\n190|\t\t}},\n191|\t\tTargetOperations: []cloneplan.TargetOperationInput{{\n192|\t\t\tSequence:           1,\n193|\t\t\tAction:             \"write_blob\",\n194|\t\t\tResourceKeys:       []string{\"res/op\"},\n195|\t\t\tDependsOnSequences: nil,\n196|\t\t\tExtensions:         map[string]any{},\n197|\t\t}},\n198|\t\tExpectedResources: []cloneplan.ExpectedResourceInput{{\n199|\t\t\tOperationSequence: 1,\n200|\t\t\tResourceKey:       \"a-res\",\n201|\t\t\tKind:              \"blob\",\n202|\t\t\tMode:              nil,\n203|\t\t\tExpectedBlobID:    strptr(fixtureDigest(\"blob-a-res\")),\n204|\t\t\tExtensions:        map[string]any{},\n205|\t\t}},\n206|\t\tSynthesizedEvents:        []cloneplan.SynthesizedEventInput{},\n207|\t\tSecurityExclusions:       []string{},\n208|\t\tResourceLimits:           []byte(`{\"max_objects\":100,\"max_total_bytes\":1000000,\"max_single_object_bytes\":65536,\"max_events\":100,\"max_target_resources\":100}`),\n209|\t\tTransactionPlan:          cloneplan.TransactionPlanInput{MaterializationIntent: \"clone\", TargetCollisionPolicy: \"must_be_absent\", Activation: \"dormant_validated\", Extensions: map[string]any{}},\n210|\t\tReadBackPlan:             cloneplan.ReadBackPlanInput{Modes: []string{\"staged\", \"live\"}, RequireIdentityMatch: true, RequireWorkspaceMatch: true, RequireSemanticMarker: true, Extensions: map[string]any{}},\n211|\t\tResumePlan:               cloneplan.ResumePlanInput{OpensExistingIdentity: true, AllowBlankFallback: false, BoundedContinuationTurnRequired: true, Extensions: map[string]any{}},\n212|\t\tRollbackPlan:             cloneplan.RollbackPlanInput{Required: true, RetainThrough: \"live_validated\", ForbiddenAfterProviderCommit: true, Extensions: map[string]any{}},\n213|\t\tRequiredContracts:        []cloneplan.ContractRequirementInput{{ContractID: \"ax.contract.plan\", Version: \"1.2.3\"}},\n214|\t\tRequiredCapabilities:     []string{\"clone.target.write\"},\n215|\t\tFidelityBasisDigest:      fixtureDigest(\"basis\"),\n216|\t\tSourceAdapterBuildDigest: fixtureDigest(\"source-build\"),\n217|\t\tTargetAdapterBuildDigest: fixtureDigest(\"target-build\"),\n218|\t\tControllerBuildDigest:    fixtureDigest(\"controller-build\"),\n219|\t\tExtensions:               map[string]any{},\n220|\t}\n221|}\n222|\n223|// mustBuildPlan seals one projection plan through the plan owner.\n224|func mustBuildPlan(t *testing.T, input cloneplan.ProjectionPlanInput) []byte {\n225|\tt.Helper()\n226|\tsealed, err := cloneplan.BuildProjectionPlan(input)\n227|\tif err != nil {\n228|\t\tt.Fatalf(\"BuildProjectionPlan() error = %v\", err)\n229|\t}\n230|\treturn sealed\n231|}\n232|\n233|// mustDecodePlan decodes one sealed plan through the plan owner.\n234|func mustDecodePlan(t *testing.T, sealed []byte) cloneplan.ProjectionPlan {\n235|\tt.Helper()\n236|\tplan, err := cloneplan.DecodeProjectionPlan(sealed)\n237|\tif err != nil {\n238|\t\tt.Fatalf(\"DecodeProjectionPlan() error = %v\", err)\n239|\t}\n240|\treturn plan\n241|}\n242|\n243|// validProjectedInput renders one valid projected manifest candidate\n244|// bound to the given plan digest and the shared target.\n245|func validProjectedInput(planID string) cloneplan.ProjectedManifestInput {\n246|\treturn cloneplan.ProjectedManifestInput{\n247|\t\tOperationID:                 fixtureOperationID(\"projected\"),\n248|\t\tProjectionPlanID:            planID,\n249|\t\tTargetEnvironment:           fixtureTuple(),\n250|\t\tExpectedTargetNativeSession: fixtureNativeSession,\n251|\t\tEntries: []cloneplan.ProjectedEntryInput{\n252|\t\t\t{OperationSequence: 1, ResourceKey: \"a-dir\", Kind: \"directory\", Mode: u64ptr(0755)},\n253|\t\t\t{OperationSequence: 1, ResourceKey: \"b-blob\", Kind: \"blob\", Mode: nil, ByteCount: u64ptr(128), BlobID: strptr(fixtureDigest(\"blob-b-blob\")), BlobDescriptorID: strptr(fixtureDigest(\"descriptor-b-blob\"))},\n254|\t\t},\n255|\t\tTotalBytes: 128,\n256|\t\tExtensions: map[string]any{},\n257|\t}\n258|}\n259|\n260|func u64ptr(value uint64) *uint64 { return &value }\n261|\n262|// mustBuildProjected seals one projected manifest through the plan\n263|// owner.\n264|func mustBuildProjected(t *testing.T, input cloneplan.ProjectedManifestInput) []byte {\n265|\tt.Helper()\n266|\tsealed, err := cloneplan.BuildProjectedObjectManifest(input)\n267|\tif err != nil {\n268|\t\tt.Fatalf(\"BuildProjectedObjectManifest() error = %v\", err)\n269|\t}\n270|\treturn sealed\n271|}\n272|\n273|// mustDecodeProjected decodes one sealed projected manifest through\n274|// the plan owner.\n275|func mustDecodeProjected(t *testing.T, sealed []byte) cloneplan.ProjectedManifest {\n276|\tt.Helper()\n277|\tmanifest, err := cloneplan.DecodeProjectedObjectManifest(sealed)\n278|\tif err != nil {\n279|\t\tt.Fatalf(\"DecodeProjectedObjectManifest() error = %v\", err)\n280|\t}\n281|\treturn manifest\n282|}\n283|\n284|// rowReasons renders the default reason set for one disposition:\n285|// exact rows carry none, every other row carries one core reason.\n286|func rowReasons(disposition string) []string {\n287|\tif disposition == \"exact\" {\n288|\t\treturn []string{}\n289|\t}\n290|\treturn []string{\"unknown_native_event\"}\n291|}\n292|\n293|// validRowInput renders one valid fidelity row candidate over the\n294|// given source key, canonical digest (nil for normalized rows and\n295|// synthesized rows), disposition, and staged/live evidence seeds.\n296|// Source evidence always names the candidate's raw digest; the\n297|// caller passes the raw seed explicitly so tier-1 and tier-3 stay\n298|// in agreement by construction.\n299|func validRowInput(key, rawSeed string, canonical *string, disposition string, stagedSeeds, liveSeeds []string) clonefidelity.DispositionRecordInput {\n300|\tstaged := make([]string, 0, len(stagedSeeds))\n301|\tfor _, seed := range stagedSeeds {\n302|\t\tstaged = append(staged, fixtureDigest(seed))\n303|\t}\n304|\tsort.Strings(staged)\n305|\tlive := make([]string, 0, len(liveSeeds))\n306|\tfor _, seed := range liveSeeds {\n307|\t\tlive = append(live, fixtureDigest(seed))\n308|\t}\n309|\tsort.Strings(live)\n310|\treturn clonefidelity.DispositionRecordInput{\n311|\t\tSourceItemKey:           key,\n312|\t\tSourceClass:             \"durable_payload\",\n313|\t\tSourceEvidenceIDs:       []string{fixtureDigest(rawSeed)},\n314|\t\tCanonicalObjectID:       canonical,\n315|\t\tTargetLocator:           strptr(\"target/\" + key),\n316|\t\tDisposition:             disposition,\n317|\t\tReasonCodes:             rowReasons(disposition),\n318|\t\tExplanation:             \"row \" + key,\n319|\t\tStagedEvidenceObjectIDs: staged,\n320|\t\tLiveEvidenceObjectIDs:   live,\n321|\t\tExtensions:              map[string]any{},\n322|\t}\n323|}\n324|\n325|// synthRowInput renders one valid synthesized-row candidate: no\n326|// source canonical object, source evidence naming a digest outside\n327|// the captured raw set, and optional resolving evidence.\n328|func synthRowInput(key, evidenceSeed string, stagedSeeds, liveSeeds []string) clonefidelity.DispositionRecordInput {\n329|\trow := validRowInput(key, evidenceSeed, nil, \"synthesized\", stagedSeeds, liveSeeds)\n330|\trow.ReasonCodes = []string{\"derived_index_rebuilt\"}\n331|\treturn row\n332|}\n333|\n334|// concentratedBreakdowns derives reconciling breakdown maps that\n335|// concentrate every row on the first owner key, hand-counted\n336|// independently of production derivation.\n337|func concentratedBreakdowns(rows []clonefidelity.DispositionRecordInput) (map[string]clonefidelity.FidelityCounts, map[string]clonefidelity.FidelityCounts, map[string]uint64) {\n338|\teventKinds := clonebundle.EventKinds()\n339|\tblockTypes := clonebundle.ContentBlockTypes()\n340|\tevents := make(map[string]clonefidelity.FidelityCounts, len(eventKinds))\n341|\tfor _, kind := range eventKinds {\n342|\t\tevents[kind] = clonefidelity.FidelityCounts{}\n343|\t}\n344|\tblocks := make(map[string]clonefidelity.FidelityCounts, len(blockTypes))\n345|\tfor _, block := range blockTypes {\n346|\t\tblocks[block] = clonefidelity.FidelityCounts{}\n347|\t}\n348|\tbytes := map[string]uint64{\n349|\t\t\"exact\": 0, \"semantic\": 0, \"summarized\": 0, \"opaque_preserved\": 0,\n350|\t\t\"synthesized\": 0, \"omitted\": 0, \"unrecoverable\": 0,\n351|\t}\n352|\tbump := func(counts clonefidelity.FidelityCounts, disposition string) clonefidelity.FidelityCounts {\n353|\t\tswitch disposition {\n354|\t\tcase \"exact\":\n355|\t\t\tcounts.Exact++\n356|\t\tcase \"semantic\":\n357|\t\t\tcounts.Semantic++\n358|\t\tcase \"summarized\":\n359|\t\t\tcounts.Summarized++\n360|\t\tcase \"opaque_preserved\":\n361|\t\t\tcounts.OpaquePreserved++\n362|\t\tcase \"synthesized\":\n363|\t\t\tcounts.Synthesized++\n364|\t\tcase \"omitted\":\n365|\t\t\tcounts.Omitted++\n366|\t\tcase \"unrecoverable\":\n367|\t\t\tcounts.Unrecoverable++\n368|\t\t}\n369|\t\treturn counts\n370|\t}\n371|\tfor _, row := range rows {\n372|\t\tevents[eventKinds[0]] = bump(events[eventKinds[0]], row.Disposition)\n373|\t\tblocks[blockTypes[0]] = bump(blocks[blockTypes[0]], row.Disposition)\n374|\t}\n375|\treturn events, blocks, bytes\n376|}\n377|\n378|// validFidelityInput renders one valid target-scope fidelity report\n379|// candidate over the given rows bound to the sealed reads.\n380|func validFidelityInput(rows []clonefidelity.DispositionRecordInput, stagedID, liveID string) clonefidelity.FidelityReportInput {\n381|\tevents, blocks, byteCounts := concentratedBreakdowns(rows)\n382|\treturn clonefidelity.FidelityReportInput{\n383|\t\tScope:                            \"target\",\n384|\t\tOperationID:                      fixtureOperationID(\"fidelity\"),\n385|\t\tBundleID:                         fixtureOperationID(\"bundle\"),\n386|\t\tSourceSnapshotDigest:             fixtureDigest(\"source-snapshot\"),\n387|\t\tCaptureManifestID:                fixtureDigest(\"capture-manifest\"),\n388|\t\tCanonicalSessionID:               fixtureDigest(\"canonical-session\"),\n389|\t\tProjectionPlanID:                 strptr(fixtureDigest(\"projection-plan\")),\n390|\t\tSourceEnvironment:                fixtureTuple(),\n391|\t\tTargetEnvironment:                fixtureTuple(),\n392|\t\tProfile:                          \"maximal_safe\",\n393|\t\tRequiredDispositions:             map[string][]string{\"durable_payload\": {\"exact\", \"semantic\"}},\n394|\t\tForbidReasons:                    []string{\"credential_excluded\"},\n395|\t\tRows:                             rows,\n396|\t\tEventKindCounts:                  events,\n397|\t\tContentBlockCounts:               blocks,\n398|\t\tByteCounts:                       byteCounts,\n399|\t\tRawBundleComplete:                true,\n400|\t\tCanonicalComplete:                true,\n401|\t\tTargetSemanticallyContinuable:    true,\n402|\t\tTargetNativelyResumable:          true,\n403|\t\tStagedReadBackEvidenceManifestID: strptr(stagedID),\n404|\t\tLiveReadBackEvidenceManifestID:   strptr(liveID),\n405|\t\tAdapterAttestations:              []string{},\n406|\t\tExtensions:                       map[string]any{},\n407|\t}\n408|}\n409|\n410|// validValidationFields renders one valid validation member set:\n411|// all checks true, no findings, the shared target.\n412|func validValidationFields(expectedFidelityID string) clonereconcile.ValidationFields {\n413|\treturn clonereconcile.ValidationFields{\n414|\t\tOperationID:                 fixtureOperationID(\"validation\"),\n415|\t\tProviderManifestID:          fixtureDigest(\"provider-manifest\"),\n416|\t\tExpectedTargetNativeSession: fixtureNativeSession,\n417|\t\tObservedTargetNativeSession: fixtureNativeSession,\n418|\t\tTargetEnvironment:           fixtureTuple(),\n419|\t\tChecks: clonereadback.ValidationChecks{\n420|\t\t\tStagedStructuralValid: true, LiveStructuralValid: true,\n421|\t\t\tSemanticMarkerValid: true, IdentityValid: true,\n422|\t\t\tWorkspaceBindingValid: true, ResumeSurfaceValid: true,\n423|\t\t\tSourceGenerationRevalidated: true,\n424|\t\t},\n425|\t\tFindings:                 fixtureFindings(),\n426|\t\tExtensions:               map[string]any{},\n427|\t\tExpectedFidelityReportID: expectedFidelityID,\n428|\t}\n429|}\n430|\n431|// requireRefusal asserts the refusal contract: the stable ErrInvalid\n432|// code plus the literal detail. The literal pins the gate; the code\n433|// pins the refusal identity.\n434|func requireRefusal(t *testing.T, err error, literal string) {\n435|\tt.Helper()\n436|\tif err == nil {\n437|\t\tt.Fatalf(\"error = nil, want refusal containing %q\", literal)\n438|\t}\n439|\tif !errors.Is(err, clonereconcile.ErrInvalid) {\n440|\t\tt.Fatalf(\"error = %v, want errors.Is ErrInvalid\", err)\n441|\t}\n442|\tif !strings.Contains(err.Error(), literal) {\n443|\t\tt.Fatalf(\"error = %q, want literal %q\", err.Error(), literal)\n444|\t}\n445|}\n446|\n447|// independentFidelityID recomputes the omit-self identity in the\n448|// test: the sealed document minus fidelity_report_id, JCS-hashed\n449|// with SHA-256. It shares no production helper.\n450|func independentFidelityID(t *testing.T, sealed []byte) string {\n451|\tt.Helper()\n452|\tvar document map[string]any\n453|\tif err := json.Unmarshal(sealed, &document); err != nil {\n454|\t\tt.Fatalf(\"decode sealed fidelity report: %v\", err)\n455|\t}\n456|\tdelete(document, \"fidelity_report_id\")\n457|\tplain, err := json.Marshal(document)\n458|\tif err != nil {\n459|\t\tt.Fatalf(\"marshal omit-self object: %v\", err)\n460|\t}\n461|\tcanonical, err := jcs.Transform(plain)\n462|\tif err != nil {\n463|\t\tt.Fatalf(\"JCS transform: %v\", err)\n464|\t}\n465|\tsum := sha256.Sum256(canonical)\n466|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n467|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
