{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7b9","stream":{"kind":"session","id":"01a0d602-12a6-7cb3-99d1-8d1cf4fb003f"},"sequence":567,"recorded_at":1780531400001129,"record_type":"event","durability":"durable","causation_id":"8384434d-9d62-45ba-bafd-be548807fde7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"8384434d-9d62-45ba-bafd-be548807fde7","run_stream":{"kind":"run","id":"8384434d-9d62-45ba-bafd-be548807fde7"},"call_id":"call_01a0d6035bef758fa128de213e87ebf5","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/clonereconcile/census_test.go`.\n1|package clonereconcile_test\n2|\n3|import (\n4|\t\"os\"\n5|\t\"path/filepath\"\n6|\t\"regexp\"\n7|\t\"strings\"\n8|\t\"testing\"\n9|)\n10|\n11|// This file pins two evidence-construction rules: no test in this\n12|// package skips by default (the allowlist is empty and justified\n13|// below), and every production refusal site appears in the gate\n14|// reachability matrix in TRACEABILITY.md while every matrix row\n15|// names a production literal. An unlisted site fails the census.\n16|\n17|// TestNoDefaultSkippedEvidenceTests pins that no evidence test in\n18|// this package skips: every Test runs its assertions on every\n19|// platform the suite configures. The allowlist is empty because\n20|// the package is pure Go with no platform, network, or terminal\n21|// dependencies — there is no shape a skip could legitimately\n22|// cover.\n23|func TestNoDefaultSkippedEvidenceTests(t *testing.T) {\n24|\tdir := packageDir(t)\n25|\tentries, err := os.ReadDir(dir)\n26|\tif err != nil {\n27|\t\tt.Fatalf(\"read dir: %v\", err)\n28|\t}\n29|\tskipPattern := regexp.MustCompile(`\\bt\\.Skip(f|Now)?\\(|\\bSkip\\(|\\bSkipNow\\(`)\n30|\tfor _, entry := range entries {\n31|\t\tname := entry.Name()\n32|\t\tif !strings.HasSuffix(name, \"_test.go\") {\n33|\t\t\tcontinue\n34|\t\t}\n35|\t\tsource, err := os.ReadFile(filepath.Join(dir, name))\n36|\t\tif err != nil {\n37|\t\t\tt.Fatalf(\"read %s: %v\", name, err)\n38|\t\t}\n39|\t\t// Strip line comments and the pattern definitions\n40|\t\t// themselves: mentions of skips in prose and the\n41|\t\t// census regex data are not skippable calls.\n42|\t\tvar code []string\n43|\t\tfor _, line := range strings.Split(string(source), \"\\n\") {\n44|\t\t\tif trimmed := strings.TrimSpace(line); strings.HasPrefix(trimmed, \"//\") {\n45|\t\t\t\tcontinue\n46|\t\t\t}\n47|\t\t\tif strings.Contains(line, \"MustCompile\") {\n48|\t\t\t\tcontinue\n49|\t\t\t}\n50|\t\t\tcode = append(code, line)\n51|\t\t}\n52|\t\tif skipPattern.MatchString(strings.Join(code, \"\\n\")) {\n53|\t\t\tt.Errorf(\"%s skips an evidence test; the allowlist is empty\", name)\n54|\t\t}\n55|\t}\n56|}\n57|\n58|// TestSkipCensusControlPlant proves the skip census bites: a\n59|// planted skip is reported. The token assembles at runtime so the\n60|// plant itself carries no skippable call for the census to flag.\n61|func TestSkipCensusControlPlant(t *testing.T) {\n62|\tplant := \"func TestPlanted(t *testing.T) {\\n\\tt.\" + \"Ski\" + \"p(\\\"planted\\\")\\n}\\n\"\n63|\tskipPattern := regexp.MustCompile(`\\bt\\.Skip(f|Now)?\\(|\\bSkip\\(|\\bSkipNow\\(`)\n64|\tif !skipPattern.MatchString(plant) {\n65|\t\tt.Fatalf(\"control plant skip not detected\")\n66|\t}\n67|}\n68|\n69|// productionRefusalLiterals extracts every refuse(\"...\") literal\n70|// from the package's non-test sources.\n71|func productionRefusalLiterals(t *testing.T) []string {\n72|\tt.Helper()\n73|\tdir := packageDir(t)\n74|\tentries, err := os.ReadDir(dir)\n75|\tif err != nil {\n76|\t\tt.Fatalf(\"read dir: %v\", err)\n77|\t}\n78|\tpattern := regexp.MustCompile(`refuse\\(\"((?:[^\"\\\\]|\\\\.)*)\"`)\n79|\tvar literals []string\n80|\tfor _, entry := range entries {\n81|\t\tname := entry.Name()\n82|\t\tif !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n83|\t\t\tcontinue\n84|\t\t}\n85|\t\tsource, err := os.ReadFile(filepath.Join(dir, name))\n86|\t\tif err != nil {\n87|\t\t\tt.Fatalf(\"read %s: %v\", name, err)\n88|\t\t}\n89|\t\tfor _, match := range pattern.FindAllStringSubmatch(string(source), -1) {\n90|\t\t\tliterals = append(literals, match[1])\n91|\t\t}\n92|\t}\n93|\treturn literals\n94|}\n95|\n96|// matrixSection extracts the gate reachability matrix section from\n97|// TRACEABILITY.md: the lines between the matrix heading and the\n98|// next heading.\n99|func matrixSection(t *testing.T) string {\n100|\tt.Helper()\n101|\traw, err := os.ReadFile(filepath.Join(packageDir(t), \"TRACEABILITY.md\"))\n102|\tif err != nil {\n103|\t\tt.Fatalf(\"read TRACEABILITY.md: %v\", err)\n104|\t}\n105|\tlines := strings.Split(string(raw), \"\\n\")\n106|\tstart := -1\n107|\tfor i, line := range lines {\n108|\t\tif strings.TrimSpace(line) == \"## Gate reachability matrix\" {\n109|\t\t\tstart = i\n110|\t\t\tbreak\n111|\t\t}\n112|\t}\n113|\tif start < 0 {\n114|\t\tt.Fatalf(\"TRACEABILITY.md carries no gate reachability matrix\")\n115|\t}\n116|\tend := len(lines)\n117|\tfor i := start + 1; i < len(lines); i++ {\n118|\t\tif strings.HasPrefix(strings.TrimSpace(lines[i]), \"## \") {\n119|\t\t\tend = i\n120|\t\t\tbreak\n121|\t\t}\n122|\t}\n123|\treturn strings.Join(lines[start:end], \"\\n\")\n124|}\n125|\n126|// missingFromMatrix returns the production literals absent from\n127|// the matrix text.\n128|func missingFromMatrix(literals []string, matrix string) []string {\n129|\tvar missing []string\n130|\tfor _, literal := range literals {\n131|\t\tif !strings.Contains(matrix, literal) {\n132|\t\t\tmissing = append(missing, literal)\n133|\t\t}\n134|\t}\n135|\treturn missing\n136|}\n137|\n138|// matrixLiteralCells returns the first backticked cell of every\n139|// matrix table row (header and separator excluded).\n140|func matrixLiteralCells(matrix string) []string {\n141|\ttickPattern := regexp.MustCompile(\"`([^`]*)`\")\n142|\tvar cells []string\n143|\tfor _, line := range strings.Split(matrix, \"\\n\") {\n144|\t\ttrimmed := strings.TrimSpace(line)\n145|\t\tif !strings.HasPrefix(trimmed, \"| `\") {\n146|\t\t\tcontinue\n147|\t\t}\n148|\t\tmatch := tickPattern.FindStringSubmatch(trimmed)\n149|\t\tif len(match) == 2 {\n150|\t\t\tcells = append(cells, match[1])\n151|\t\t}\n152|\t}\n153|\treturn cells\n154|}\n155|\n156|// TestGateReachabilityMatrixDerivedFromRefusalSites pins the matrix\n157|// mechanically: every production refusal literal appears verbatim\n158|// in the matrix section, and every matrix literal cell names a\n159|// production literal (or a documented owner: delegation). An\n160|// unlisted site fails here instead of silently escaping the gate\n161|// table.\n162|func TestGateReachabilityMatrixDerivedFromRefusalSites(t *testing.T) {\n163|\tmatrix := matrixSection(t)\n164|\tliterals := productionRefusalLiterals(t)\n165|\tfor _, missing := range missingFromMatrix(literals, matrix) {\n166|\t\tt.Errorf(\"refusal site %q is absent from the gate reachability matrix\", missing)\n167|\t}\n168|\tfor _, cell := range matrixLiteralCells(matrix) {\n169|\t\tif strings.HasPrefix(cell, \"owner:\") {\n170|\t\t\tcontinue\n171|\t\t}\n172|\t\tfound := false\n173|\t\tfor _, literal := range literals {\n174|\t\t\tif strings.Contains(literal, cell) || strings.Contains(cell, literal) {\n175|\t\t\t\tfound = true\n176|\t\t\t\tbreak\n177|\t\t\t}\n178|\t\t}\n179|\t\tif !found {\n180|\t\t\tt.Errorf(\"matrix literal %q names no production refusal site\", cell)\n181|\t\t}\n182|\t}\n183|}\n184|\n185|// TestGateReachabilityControlPlant proves the matrix census bites:\n186|// a production literal missing from a synthetic matrix is\n187|// reported, and a matrix cell naming nothing is reported.\n188|func TestGateReachabilityControlPlant(t *testing.T) {\n189|\tplantLiterals := []string{\"tier-9 plant refuses here\"}\n190|\tplantMatrix := \"## Gate reachability matrix\\n\\n| `tier-9 other` | plant |\\n\"\n191|\tif missing := missingFromMatrix(plantLiterals, plantMatrix); len(missing) != 1 {\n192|\t\tt.Fatalf(\"missingFromMatrix(plant) = %q, want the plant literal\", missing)\n193|\t}\n194|\tcells := matrixLiteralCells(plantMatrix)\n195|\tif len(cells) != 1 || cells[0] != \"tier-9 other\" {\n196|\t\tt.Fatalf(\"matrixLiteralCells(plant) = %q, want the plant cell\", cells)\n197|\t}\n198|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7bb","stream":{"kind":"session","id":"01a0d602-12a6-7cb3-99d1-8d1cf4fb003f"},"sequence":568,"recorded_at":1780531400001131,"record_type":"event","durability":"durable","causation_id":"8384434d-9d62-45ba-bafd-be548807fde7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"8384434d-9d62-45ba-bafd-be548807fde7","run_stream":{"kind":"run","id":"8384434d-9d62-45ba-bafd-be548807fde7"},"call_id":"call_01a0d6035dda74c09b65c8cebdb17fd8","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/clonereconcile/reconcile_test.go`.\n1|package clonereconcile_test\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/clonefidelity\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/clonereadback\"\n9|\tclonereconcile \"github.com/relux-works/agent-session-manager/internal/clonereconcile\"\n10|)\n11|\n12|// TestReconcileAdmitsValidTargetHistory proves the end-to-end\n13|// admission: tiers close, rows resolve into the sealed reads,\n14|// pairing binds one target, and both reports derive through their\n15|// owners with the owner-decided valid bit.\n16|func TestReconcileAdmitsValidTargetHistory(t *testing.T) {\n17|\tdocs := sealSharedWorldDocs(t)\n18|\tinput := gateBaseline(t, docs)\n19|\tgot, err := clonereconcile.Reconcile(input)\n20|\tif err != nil {\n21|\t\tt.Fatalf(\"Reconcile() error = %v\", err)\n22|\t}\n23|\tif !got.Valid {\n24|\t\tt.Fatalf(\"Reconcile() valid = false, want true\")\n25|\t}\n26|\tif got.Candidates != 4 || got.RawItems != 3 || got.CanonicalItems != 2 || got.Rows != 4 {\n27|\t\tt.Fatalf(\"Reconcile() census = %d/%d/%d/%d, want 4/3/2/4\",\n28|\t\t\tgot.Candidates, got.RawItems, got.CanonicalItems, got.Rows)\n29|\t}\n30|\tif got.FidelityID != independentFidelityID(t, got.FidelityReport) {\n31|\t\tt.Fatalf(\"Reconcile() fidelity ID %q disagrees with the independent recompute\", got.FidelityID)\n32|\t}\n33|\tfidelity, err := clonefidelity.DecodeFidelityReport(got.FidelityReport)\n34|\tif err != nil {\n35|\t\tt.Fatalf(\"DecodeFidelityReport(derived) error = %v\", err)\n36|\t}\n37|\tif fidelity.ReportID.String() != got.FidelityID {\n38|\t\tt.Fatalf(\"derived fidelity ID %q != census ID %q\", fidelity.ReportID.String(), got.FidelityID)\n39|\t}\n40|\tvalidation, err := clonereadback.DecodeValidationReport(got.ValidationReport, input.History.Staged, input.History.Live)\n41|\tif err != nil {\n42|\t\tt.Fatalf(\"DecodeValidationReport(derived) error = %v\", err)\n43|\t}\n44|\tif !validation.Valid {\n45|\t\tt.Fatalf(\"derived validation report valid = false, want true\")\n46|\t}\n47|\tif validation.FidelityReportID.String() != got.FidelityID {\n48|\t\tt.Fatalf(\"derived validation binds fidelity %q, want %q\", validation.FidelityReportID.String(), got.FidelityID)\n49|\t}\n50|}\n51|\n52|// TestReconcileValidFollowsOwner pins that the valid bit is decided\n53|// by the read-back owner alone: each failing check shape seals with\n54|// valid=false through the production entry, and the sealed bytes\n55|// decode back through the owner with the same bit.\n56|func TestReconcileValidFollowsOwner(t *testing.T) {\n57|\tdocs := sealSharedWorldDocs(t)\n58|\tcases := []struct {\n59|\t\tname   string\n60|\t\tmutate func(*clonereconcile.ReconciliationInput)\n61|\t}{\n62|\t\t{name: \"all-true\", mutate: func(input *clonereconcile.ReconciliationInput) {}},\n63|\t\t{name: \"check-false\", mutate: func(input *clonereconcile.ReconciliationInput) {\n64|\t\t\tinput.Validation.Checks.LiveStructuralValid = false\n65|\t\t}},\n66|\t\t{name: \"observed-differs\", mutate: func(input *clonereconcile.ReconciliationInput) {\n67|\t\t\tinput.Validation.ObservedTargetNativeSession = \"other-native-session\"\n68|\t\t}},\n69|\t\t{name: \"error-finding\", mutate: func(input *clonereconcile.ReconciliationInput) {\n70|\t\t\tinput.Validation.Findings = fixtureFindings(\"error\")\n71|\t\t}},\n72|\t}\n73|\tfor _, tc := range cases {\n74|\t\tt.Run(tc.name, func(t *testing.T) {\n75|\t\t\tinput := gateBaseline(t, docs)\n76|\t\t\ttc.mutate(&input)\n77|\t\t\tgot, err := clonereconcile.Reconcile(input)\n78|\t\t\tif err != nil {\n79|\t\t\t\tt.Fatalf(\"Reconcile() error = %v\", err)\n80|\t\t\t}\n81|\t\t\twant := tc.name == \"all-true\"\n82|\t\t\tif got.Valid != want {\n83|\t\t\t\tt.Fatalf(\"Reconcile() valid = %v, want %v\", got.Valid, want)\n84|\t\t\t}\n85|\t\t\tdecoded, err := clonereadback.DecodeValidationReport(got.ValidationReport, input.History.Staged, input.History.Live)\n86|\t\t\tif err != nil {\n87|\t\t\t\tt.Fatalf(\"DecodeValidationReport(derived) error = %v\", err)\n88|\t\t\t}\n89|\t\t\tif decoded.Valid != want {\n90|\t\t\t\tt.Fatalf(\"decoded valid = %v, want %v\", decoded.Valid, want)\n91|\t\t\t}\n92|\t\t})\n93|\t}\n94|}\n95|\n96|// TestReconcileDeterminism pins bytes-identical outputs for\n97|// identical inputs across ten reconciliations.\n98|func TestReconcileDeterminism(t *testing.T) {\n99|\tdocs := sealSharedWorldDocs(t)\n100|\tinput := gateBaseline(t, docs)\n101|\tfirst, err := clonereconcile.Reconcile(input)\n102|\tif err != nil {\n103|\t\tt.Fatalf(\"Reconcile() error = %v\", err)\n104|\t}\n105|\tfor i := 0; i < 9; i++ {\n106|\t\tnext, err := clonereconcile.Reconcile(gateBaseline(t, docs))\n107|\t\tif err != nil {\n108|\t\t\tt.Fatalf(\"Reconcile() error = %v\", err)\n109|\t\t}\n110|\t\tif !bytes.Equal(next.FidelityReport, first.FidelityReport) {\n111|\t\t\tt.Fatalf(\"reconciliation %d fidelity bytes differ\", i)\n112|\t\t}\n113|\t\tif !bytes.Equal(next.ValidationReport, first.ValidationReport) {\n114|\t\t\tt.Fatalf(\"reconciliation %d validation bytes differ\", i)\n115|\t\t}\n116|\t}\n117|}\n118|\n119|// TestReconcilePurity pins that neither entry mutates its inputs:\n120|// the candidate, link, row, and document inputs are byte-equal\n121|// before and after.\n122|func TestReconcilePurity(t *testing.T) {\n123|\tdocs := sealSharedWorldDocs(t)\n124|\tinput := gateBaseline(t, docs)\n125|\tbeforePlan := append([]byte{}, input.Plan...)\n126|\tbeforeProjected := append([]byte{}, input.Projected...)\n127|\tbeforeTuple := append([]byte{}, input.Validation.TargetEnvironment...)\n128|\tbeforeFindings := append([]byte{}, input.Validation.Findings...)\n129|\tbeforeRows := len(input.Fidelity.Rows)\n130|\tif _, err := clonereconcile.Reconcile(input); err != nil {\n131|\t\tt.Fatalf(\"Reconcile() error = %v\", err)\n132|\t}\n133|\tif !bytes.Equal(input.Plan, beforePlan) {\n134|\t\tt.Fatalf(\"Reconcile mutated the plan bytes\")\n135|\t}\n136|\tif !bytes.Equal(input.Projected, beforeProjected) {\n137|\t\tt.Fatalf(\"Reconcile mutated the projected bytes\")\n138|\t}\n139|\tif !bytes.Equal(input.Validation.TargetEnvironment, beforeTuple) {\n140|\t\tt.Fatalf(\"Reconcile mutated the validation tuple\")\n141|\t}\n142|\tif !bytes.Equal(input.Validation.Findings, beforeFindings) {\n143|\t\tt.Fatalf(\"Reconcile mutated the validation findings\")\n144|\t}\n145|\tif len(input.Fidelity.Rows) != beforeRows {\n146|\t\tt.Fatalf(\"Reconcile mutated the fidelity rows\")\n147|\t}\n148|}\n149|\n150|// TestReadBackHistoryAdmitsSealedPair pins the read-back entry: two\n151|// owner-sealed documents decode through the read-back owner into a\n152|// staged/live history.\n153|func TestReadBackHistoryAdmitsSealedPair(t *testing.T) {\n154|\tdocs := sealSharedWorldDocs(t)\n155|\tplanID := mustDecodePlan(t, docs.planBytes).PlanID.String()\n156|\tprojectedID := mustDecodeProjected(t, docs.projectedBytes).ManifestID.String()\n157|\t_, stagedBytes := sealRead(t, \"staged\", planID, projectedID, evidenceFor(t, mustUniverseStaged()))\n158|\t_, liveBytes := sealRead(t, \"live\", planID, projectedID, evidenceFor(t, mustUniverseLive()))\n159|\thistory, err := clonereconcile.ReadBackHistory(\n160|\t\tstagedBytes, liveBytes,\n161|\t\tfixtureAuthority(t, \"target_staged\"), fixtureAuthority(t, \"target_live\"))\n162|\tif err != nil {\n163|\t\tt.Fatalf(\"ReadBackHistory() error = %v\", err)\n164|\t}\n165|\tif history.Staged.Mode() != \"staged\" || history.Live.Mode() != \"live\" {\n166|\t\tt.Fatalf(\"ReadBackHistory() modes = %q/%q, want staged/live\", history.Staged.Mode(), history.Live.Mode())\n167|\t}\n168|\tif history.Staged.ManifestID() == history.Live.ManifestID() {\n169|\t\tt.Fatalf(\"ReadBackHistory() sealed identical staged/live reads\")\n170|\t}\n171|}\n172|\n173|// TestReadBackHistoryRefusals pins the read-back entry refusals:\n174|// malformed documents refuse with the side literal, and a swapped\n175|// pair refuses at the read-back owner (the authority-derived mode\n176|// binds each document before the pair gate runs).\n177|func TestReadBackHistoryRefusals(t *testing.T) {\n178|\tdocs := sealSharedWorldDocs(t)\n179|\tplanID := mustDecodePlan(t, docs.planBytes).PlanID.String()\n180|\tprojectedID := mustDecodeProjected(t, docs.projectedBytes).ManifestID.String()\n181|\t_, stagedBytes := sealRead(t, \"staged\", planID, projectedID, evidenceFor(t, mustUniverseStaged()))\n182|\t_, liveBytes := sealRead(t, \"live\", planID, projectedID, evidenceFor(t, mustUniverseLive()))\n183|\tstagedAuth := fixtureAuthority(t, \"target_staged\")\n184|\tliveAuth := fixtureAuthority(t, \"target_live\")\n185|\n186|\tif _, err := clonereconcile.ReadBackHistory([]byte(\"not-json\"), liveBytes, stagedAuth, liveAuth); err == nil {\n187|\t\tt.Fatalf(\"ReadBackHistory(garbage staged) admitted\")\n188|\t} else {\n189|\t\trequireRefusal(t, err, \"staged read-back invalid\")\n190|\t}\n191|\tif _, err := clonereconcile.ReadBackHistory(stagedBytes, []byte(\"not-json\"), stagedAuth, liveAuth); err == nil {\n192|\t\tt.Fatalf(\"ReadBackHistory(garbage live) admitted\")\n193|\t} else {\n194|\t\trequireRefusal(t, err, \"live read-back invalid\")\n195|\t}\n196|\t// Swapped documents under swapped authorities still decode,\n197|\t// but the pair gate sees live-first.\n198|\tif _, err := clonereconcile.ReadBackHistory(liveBytes, stagedBytes, liveAuth, stagedAuth); err == nil {\n199|\t\tt.Fatalf(\"ReadBackHistory(swapped pair) admitted\")\n200|\t} else {\n201|\t\trequireRefusal(t, err, \"reconciliation staged read is not a staged manifest\")\n202|\t}\n203|\t// A staged document under the live authority refuses at the\n204|\t// read-back owner: modes cannot be relabeled.\n205|\tif _, err := clonereadback.DecodeReadBackEvidenceManifest(stagedBytes, liveAuth); err == nil {\n206|\t\tt.Fatalf(\"DecodeReadBackEvidenceManifest(staged bytes, live authority) admitted\")\n207|\t}\n208|\tif _, err := clonereconcile.ReadBackHistory(stagedBytes, liveBytes, liveAuth, liveAuth); err == nil {\n209|\t\tt.Fatalf(\"ReadBackHistory(staged bytes, live authority) admitted\")\n210|\t} else {\n211|\t\trequireRefusal(t, err, \"staged read-back invalid\")\n212|\t}\n213|}\n214|\n215|// TestReadBackHistoryEmptyInput pins that empty documents refuse\n216|// with the side literal: the wrap forwards the owner's refusal\n217|// for the empty member of the malformed class.\n218|func TestReadBackHistoryEmptyInput(t *testing.T) {\n219|\tdocs := sealSharedWorldDocs(t)\n220|\tplanID := mustDecodePlan(t, docs.planBytes).PlanID.String()\n221|\tprojectedID := mustDecodeProjected(t, docs.projectedBytes).ManifestID.String()\n222|\t_, stagedBytes := sealRead(t, \"staged\", planID, projectedID, evidenceFor(t, mustUniverseStaged()))\n223|\t_, liveBytes := sealRead(t, \"live\", planID, projectedID, evidenceFor(t, mustUniverseLive()))\n224|\tstagedAuth := fixtureAuthority(t, \"target_staged\")\n225|\tliveAuth := fixtureAuthority(t, \"target_live\")\n226|\n227|\tt.Run(\"empty-staged\", func(t *testing.T) {\n228|\t\t_, err := clonereconcile.ReadBackHistory([]byte{}, liveBytes, stagedAuth, liveAuth)\n229|\t\trequireRefusal(t, err, \"staged read-back invalid\")\n230|\t})\n231|\tt.Run(\"empty-live\", func(t *testing.T) {\n232|\t\t_, err := clonereconcile.ReadBackHistory(stagedBytes, []byte{}, stagedAuth, liveAuth)\n233|\t\trequireRefusal(t, err, \"live read-back invalid\")\n234|\t})\n235|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
