, tier 2 derives \"` + canon0 + `\"`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n132|\t\t\tinput.Fidelity.Rows[0].CanonicalObjectID, input.Fidelity.Rows[1].CanonicalObjectID =\n133|\t\t\t\tinput.Fidelity.Rows[1].CanonicalObjectID, input.Fidelity.Rows[0].CanonicalObjectID\n134|\t\t}},\n135|\t\t{name: \"tier3-canon-under-normalization\", literal: `tier-3 row \"cand-2\" names canonical \"` + phantom + `\" under normalization`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n136|\t\t\tinput.Fidelity.Rows[2].CanonicalObjectID = strptr(phantom)\n137|\t\t}},\n138|\t\t{name: \"tier3-unreconciled-evidence\", literal: `tier-3 row \"cand-0\" claims unreconciled source evidence \"` + phantom + `\"`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n139|\t\t\tinput.Fidelity.Rows[0].SourceEvidenceIDs = []string{phantom}\n140|\t\t}},\n141|\t\t{name: \"tier3-loss-claims-staged\", literal: `tier-3 loss row \"cand-1\" claims staged evidence \"` + fixtureDigest(\"staged-0\") + `\"`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n142|\t\t\tinput.Fidelity.Rows[1].StagedEvidenceObjectIDs = []string{fixtureDigest(\"staged-0\")}\n143|\t\t}},\n144|\t\t{name: \"tier3-loss-claims-live\", literal: `tier-3 loss row \"cand-1\" claims live evidence \"` + fixtureDigest(\"live-0\") + `\"`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n145|\t\t\tinput.Fidelity.Rows[1].LiveEvidenceObjectIDs = []string{fixtureDigest(\"live-0\")}\n146|\t\t}},\n147|\t\t{name: \"tier3-no-staged\", literal: `tier-3 row \"cand-0\" has no staged target evidence`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n148|\t\t\tinput.Fidelity.Rows[0].StagedEvidenceObjectIDs = []string{}\n149|\t\t}},\n150|\t\t{name: \"tier3-no-live\", literal: `tier-3 row \"cand-0\" has no live target evidence`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n151|\t\t\tinput.Fidelity.Rows[0].LiveEvidenceObjectIDs = []string{}\n152|\t\t}},\n153|\t\t{name: \"tier3-staged-outside\", literal: `tier-3 row \"cand-0\" claims staged evidence \"` + phantom + `\" outside the staged read`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n154|\t\t\tinput.Fidelity.Rows[0].StagedEvidenceObjectIDs = []string{phantom}\n155|\t\t}},\n156|\t\t{name: \"tier3-live-outside\", literal: `tier-3 row \"cand-0\" claims live evidence \"` + phantom + `\" outside the live read`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n157|\t\t\tinput.Fidelity.Rows[0].LiveEvidenceObjectIDs = []string{phantom}\n158|\t\t}},\n159|\t\t{name: \"tier3-missing-row\", literal: `tier-3 candidate \"cand-0\" has no disposition row`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n160|\t\t\tinput.Fidelity.Rows = input.Fidelity.Rows[1:]\n161|\t\t\tevents, blocks, bytes := concentratedBreakdowns(input.Fidelity.Rows)\n162|\t\t\tinput.Fidelity.EventKindCounts = events\n163|\t\t\tinput.Fidelity.ContentBlockCounts = blocks\n164|\t\t\tinput.Fidelity.ByteCounts = bytes\n165|\t\t}},\n166|\t\t{name: \"tier3-duplicate-keys-refused-by-owner\", literal: \"fidelity report invalid\", mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n167|\t\t\t// A second row for one candidate refuses at the\n168|\t\t\t// fidelity build (owner key uniqueness), wrapped in\n169|\t\t\t// the reconciliation refusal.\n170|\t\t\tinput.Fidelity.Rows[1].SourceItemKey = \"cand-0\"\n171|\t\t}},\n172|\t\t{name: \"tier3-duplicate-canonical-refused-by-agreement\", literal: `tier-3 row \"cand-1\" names canonical \"` + canon0 + `\", tier 2 derives \"` + canon1 + `\"`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n173|\t\t\t// Tier-2 injectivity plus per-row agreement make a\n174|\t\t\t// second row for one canonical disagree here.\n175|\t\t\tinput.Fidelity.Rows[1].CanonicalObjectID = input.Fidelity.Rows[0].CanonicalObjectID\n176|\t\t}},\n177|\t\t// Scope and history.\n178|\t\t{name: \"scope-archive\", literal: \"reconciliation needs a target fidelity report\", mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n179|\t\t\tinput.Fidelity.Scope = \"archive\"\n180|\t\t}},\n181|\t\t{name: \"staged-not-staged\", literal: \"reconciliation staged read is not a staged manifest\", mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n182|\t\t\tinput.History.Staged = input.History.Live\n183|\t\t}},\n184|\t\t{name: \"live-not-live\", literal: \"reconciliation live read is not a live manifest\", mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n185|\t\t\tinput.History.Live = input.History.Staged\n186|\t\t}},\n187|\t\t{name: \"zero-history\", literal: \"reconciliation staged read is not a staged manifest\", mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n188|\t\t\tinput.History = clonereconcile.History{}\n189|\t\t}},\n190|\t\t// Plan and projected pairing.\n191|\t\t{name: \"plan-garbage\", literal: \"projection plan invalid\", mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n192|\t\t\tinput.Plan = []byte(\"not-json\")\n193|\t\t}},\n194|\t\t{name: \"plan-empty\", literal: \"projection plan invalid\", mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n195|\t\t\tinput.Plan = []byte{}\n196|\t\t}},\n197|\t\t{name: \"projected-garbage\", literal: \"projected object manifest invalid\", mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationI