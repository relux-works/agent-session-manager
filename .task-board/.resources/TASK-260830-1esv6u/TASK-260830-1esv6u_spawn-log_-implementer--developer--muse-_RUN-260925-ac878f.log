s the (plan-A, plan-B) pair only\"),\n247|        Mutant(\"N-projected-staged\", '\\tif history.Staged.Manifest().ProjectedObjectManifestID != projected.ManifestID {',\n248|               '\\tif history.Staged.Manifest().ProjectedObjectManifestID != projected.ManifestID && (history.Staged.Manifest().ProjectedObjectManifestID.String() != \"' + PROJA + '\" || projected.ManifestID.String() != \"' + PROJB + '\") {',\n249|               GATE + \"staged-projected-mismatch\", \"KILLED\", \"narrowing: admits the (proj-A, proj-B) pair only\"),\n250|        Mutant(\"N-projected-live\", '\\tif history.Live.Manifest().ProjectedObjectManifestID != projected.ManifestID {',\n251|               '\\tif history.Live.Manifest().ProjectedObjectManifestID != projected.ManifestID && (history.Live.Manifest().ProjectedObjectManifestID.String() != \"' + PROJA + '\" || projected.ManifestID.String() != \"' + PROJB + '\") {',\n252|               GATE + \"live-projected-mismatch\", \"KILLED\", \"narrowing: admits the (proj-A, proj-B) pair only\"),\n253|        Mutant(\"N-native-sessions\", '\\tif staged.ObservedTargetNativeSession != live.ObservedTargetNativeSession {',\n254|               '\\tif staged.ObservedTargetNativeSession != live.ObservedTargetNativeSession && live.ObservedTargetNativeSession != \"other-session\" {',\n255|               GATE + \"reads-differ-sessions\", \"KILLED\", \"narrowing: admits the other-session live read only\"),\n256|        Mutant(\"N-plan-expects\", '\\tif plan.ExpectedTargetNativeSession != staged.ObservedTargetNativeSession {',\n257|               '\\tif plan.ExpectedTargetNativeSession != staged.ObservedTargetNativeSession && staged.ObservedTargetNativeSession != \"other-session\" {',\n258|               GATE + \"plan-expects-other\", \"KILLED\", \"narrowing: admits other-session reads only\"),\n259|        Mutant(\"N-projected-expects\", '\\tif projected.ExpectedTargetNativeSession != staged.ObservedTargetNativeSession {',\n260|               '\\tif projected.ExpectedTargetNativeSession != staged.ObservedTargetNativeSession && staged.ObservedTargetNativeSession != \"other-session\" {',\n261|               GATE + \"projected-expects-other\", \"KILLED\", \"narrowing: admits other-session reads only\"),\n262|        Mutant(\"N-fid-staged-bind\",\n263|               '\\tif fidelity.StagedReadBackEvidenceManifestID == nil ||\\n\\t\\t*fidelity.StagedReadBackEvidenceManifestID != history.Staged.ManifestID() {',\n264|               '\\tif fidelity.StagedReadBackEvidenceManifestID == nil ||\\n\\t\\t*fidelity.StagedReadBackEvidenceManifestID != history.Staged.ManifestID() && (fidelity.StagedReadBackEvidenceManifestID == nil ||\\n\\t\\t\\tfidelity.StagedReadBackEvidenceManifestID.String() != \"' + PHANTOM + '\") {',\n265|               GATE + \"fidelity-staged-unbound\", \"KILLED\", \"narrowing: admits the phantom staged binding only\"),\n266|        Mutant(\"N-fid-live-bind\",\n267|               '\\tif fidelity.LiveReadBackEvidenceManifestID == nil ||\\n\\t\\t*fidelity.LiveReadBackEvidenceManifestID != history.Live.ManifestID() {',\n268|               '\\tif fidelity.LiveReadBackEvidenceManifestID == nil ||\\n\\t\\t*fidelity.LiveReadBackEvidenceManifestID != history.Live.ManifestID() && (fidelity.LiveReadBackEvidenceManifestID == nil ||\\n\\t\\t\\tfidelity.LiveReadBackEvidenceManifestID.String() != \"' + PHANTOM + '\") {',\n269|               GATE + \"fidelity-live-unbound\", \"KILLED\", \"narrowing: admits the phantom live binding only\"),\n270|        Mutant(\"N-fid-tuple-staged\", other_staged[0], other_staged[1],\n271|               GATE + \"fidelity-tuple-staged\", \"KILLED\", \"narrowing: admits the relux.other fidelity target only\"),\n272|        Mutant(\"N-fid-tuple-live\", other_live[0], other_live[1],\n273|               GATE + \"fidelity-tuple-live\", \"KILLED\", \"narrowing: admits the relux.other live observation only\"),\n274|        Mutant(\"N-validation-tuple\", other_validation[0], other_validation[1],\n275|               GATE + \"validation-tuple-staged\", \"KILLED\", \"narrowing: admits the relux.other report target only\"),\n276|        Mutant(\"N-validation-native\", '\\tif expected != history.Staged.Manifest().ObservedTargetNativeSession {',\n277|               '\\tif expected != history.Staged.Manifest().ObservedTargetNativeSession && expected != \"other-session\" {',\n278|               GATE + \"validation-expects-other\", \"KILLED\", \"narrowing: admits the other-session expectation only\"),\n279|        Mutant(\"N-expected-fidelity\", '\\tif expectedFidelity != fidelity.ReportID {',\n280|               '\\tif expectedFidelity != fidelity.ReportID && expectedFidelity.String() != \"' + PHANTOM + '\" {',\n281|               GATE + \"expected-fidelity-mismatch\", \"KILLED\", \"narrowing: admits the phantom expectation only\"),\n282|        Mutant(\"T-mode-staged\", '\\t\\treturn refuse(\"reconciliation staged read is not a staged manifest\")',\n283|               '\\t\\treturn refuse(\"reconciliation live read is not a live manifest\")',\n284|               GATE + \"staged-not-staged\", \"KILLED\", \"token-preserving: staged token kept, live detail reported\"),\n285|        Mutant(\"T-loss-branch\", '\\treturn disposition == \"omitted\" || disposition == \"unrecoverable\"',\n286|               '\\treturn disposition == \"omitted\" && disposition == \"unrecoverable\"',\n287|               GATE + \"tier3-loss-claims-staged\", \"KILLED\", \"token-preserving: both loss tokens kept, conjunction never holds\"),\n288|        Mutant(\"T-tier2-synth\", '\\t\\t\\tif link.Normalization == \"synthesized\" {',\n289|               '\\t\\t\\tif link.Normalization == \"synthesized\" && link.Raw == \"\" {',\n290|               GATE + \"tier2-synth-normalization\", \"KILLED\", \"token-preserving: synthesized token kept, unreachable arm\"),\n291|        Mutant(\"T-tier3-synth\", '\\t\\tif row.Disposition == \"synthesized\" {',\n292|               '\\t\\tif row.Disposition == \"synthesized\" && row.SourceItemKey == \"\" {',\n293|               GATE + \"tier3-synth-claims\", \"KILLED\", \"token-preserving: synthesized token kept, unreachable arm\"),\n294|        Mutant(\"C-doc-comment\", '// CandidateLink reconciles one captured candidate at tier 1: exactly',\n295|               '// CandidateLink reconciles one captured candidate at tier 1 - exactly',\n296|               \"FULLSUITE\", \"SURVIVED\", \"control: comment-only edit must survive the full suite\"),\n297|    ]\n298|\n299|\n300|def run_case(log_dir, mutant, full_suite):\n301|    target = REPO / TARGET\n302|    original = target.read_text()\n303|    if original.count(mutant.find) != 1:\n304|        return (\"ERROR\", f\"find occurs {original.count(mutant.find)} times, want 1\")\n305|    target.write_text(original.replace(mutant.find, mutant.replace))\n306|    try:\n307|        if full_suite or mutant.run == \"FULLSUITE\":\n308|            cmd = [\"go\", \"test\", \"./\" + PACKAGE + \"/\", \"-count=1\"]\n309|        else:\n310|            cmd = [\"go\", \"test\", \"./\" + PACKAGE + \"/\", \"-run\", mutant.run + \"$\", \"-count=1\", \"-v\"]\n311|        started = time.time()\n312|        proc = subprocess.run(cmd, cwd=REPO, capture_output=True, text=True, timeout=300)\n313|        elapsed = time.time() - started\n314|        log_path = log_dir / (mutant.name + (\"-suite.log\" if full_suite else \".log\"))\n315|        log_path.write_text(f\"$ {' '.join(cmd)}\\nexit={proc.returncode} elapsed={elapsed:.1f}s\\n--- stdout ---\\n{proc.stdout}\\n--- stderr ---\\n{proc.stderr}\\n\")\n316|        if proc.returncode == 0:\n317|            return (\"SURVIVED\", f\"exit 0 in {elapsed:.1f}s\")\n318|        if \"FAIL\" in (proc.stdout + proc.stderr):\n319|            return (\"KILLED\", f\"exit {proc.returncode} with FAIL in {elapsed:.1f}s\")\n320|        return (\"ERROR\", f\"exit {proc.returncode} without FAIL in {elapsed:.1f}s\")\n321|    except subprocess.TimeoutExpired:\n322|        return (\"ERROR\", \"timeout after 300s\")\n323|    finally:\n324|        target.write_text(original)\n325|\n326|\n327|def main(argv):\n328|    log_dir = REPO / \".temp\" / \"mutant_logs\"\n329|    wanted = []\n330|    args = list(argv)\n331|    while args:\n332|        if args[0] == \"--log-dir\":\n333|            log_dir = Path(args[1])\n334|            args = args[2:]\n335|        else:\n336|            wanted.append(args.pop(0))\n337|    rows = mutants()\n338|    # N-t2-raw-digest and N-t2-canon-digest are repaired below: the\n339|    # digest-error branches need condition patches, not return\n340|    # patches (the table above holds placeholders for them).\n341|    patched = []\n342|    for mutant in rows:\n343|        if mutant.name == \"N-t2-raw-digest\":\n344|            mutant = Mutant(\"N-t2-raw-digest\",\n345|                            '\\t\\traw, err := scalar.ParseDigest(link.Raw)\\n\\t\\tif err != nil {\\n\\t\\t\\treturn nil, nil, nil, refuse(\"tier-2 raw item %q is not a digest: %v\", link.Raw, err)',\n346|                            '\\t\\traw, err := scalar.ParseDigest(link.Raw)\\n\\t\\tif err != nil && link.Raw != \"bogus\" {\\n\\t\\t\\treturn nil, nil, nil, refuse(\"tier-2 raw item %q is not a digest: %v\", link.Raw, err)',\n347|                            GATE + \"tier2-raw-not-digest\", \"KILLED\",\n348|                            \"narrowing: admits the bogus tier-2 raw only\")\n349|        if mutant.name == \"N-t2-canon-digest\":\n350|            mutant = Mutant(\"N-t2-canon-digest\",\n351|                            '\\t\\t\\tcanonical, err := scalar.ParseDigest(link.Canonical)\\n\\t\\t\\tif err != nil {\\n\\t\\t\\t\\treturn nil, nil, nil, refuse(\"tier-2 canonical item %q is not a digest: %v\", link.Canonical, err)',\n352|                            '\\t\\t\\tcanonical, err := scalar.ParseDigest(link.Canonical)\\n\\t\\t\\tif err != nil && link.Canonical != \"bogus\" {\\n\\t\\t\\t\\treturn nil, nil, nil, refuse(\"tier-2 canonical item %q is not a digest: %v\", link.Canonical, err)',\n353|                            GATE + \"tier2-canon-not-digest\", \"KILLED\",\n354|                            \"narrowing: admits the bogus canonical only\")\n355|        patched.append(mutant)\n356|    rows = patched\n357|    if wanted:\n358|        rows = [m for m in rows if m.name in wanted]\n359|        if not rows:\n360|            print(\"no such mutant\", file=sys.stderr)\n361|            return 2\n362|    log_dir.mkdir(parents=True, exist_ok=True)\n363|    failures = []\n364|    print(f\"{'mutant':28} {'verdict':9} detail\")\n365|    for mutant in rows:\n366|        verdict, detail = run_case(log_dir, mutant, False)\n367|        print(f\"{mutant.name:28} {verdict:9} {detail}\", flush=True)\n368|        if verdict != mutant.expect:\n369|            failures.append((mutant.name, verdict, mutant.expect))\n370|        if mutant.name.startswith(\"T-\") and verdict == \"KILLED\":\n371|            suite_verdict, suite_detail = run_case(log_dir, mutant, True)\n372|            print(f\"{mutant.name + '+suite':28} {suite_verdict:9} {suite_detail}\", flush=True)\n373|            if suite_verdict != \"KILLED\":\n374|                failures.append((mutant.name + \"+suite\", suite_verdict, \"KILLED\"))\n375|    if failures:\n376|        print(f\"\\n{len(failures)} unexpected verdict(s):\", file=sys.stderr)\n377|        for name, got, want in failures:\n378|            print(f\"  {name}: got {got}, want {want}\", file=sys.stderr)\n379|        return 1\n380|    print(\"\\nall verdicts as expected\")\n381|    return 0\n382|\n383|\n384|if __name__ == \"__main__\":\n385|    sys.exit(main(sys.argv[1:]))","final_result":true}}}
