required[acceptance.Production.Path] = struct{}{}\n658|\t\tfor _, test := range acceptance.Tests {\n659|\t\t\trequired[test.Path] = struct{}{}\n660|\t\t}\n661|\t}\n662|\tfor _, group := range registry.Ownership {\n663|\t\trequired[group.Production.Path] = struct{}{}\n664|\t}\n665|\n666|\tresult := make(fstest.MapFS, len(required))\n667|\tfor filename := range required {\n668|\t\tvalue, err := fs.ReadFile(root, filename)\n669|\t\tif err != nil {\n670|\t\t\tt.Fatalf(\"read repository fixture %q: %v\", filename, err)\n671|\t\t}\n672|\t\tresult[filename] = &fstest.MapFile{Data: bytes.Clone(value)}\n673|\t}\n674|\treturn result\n675|}\n676|\n677|func rewriteRegistry(t *testing.T, repository fstest.MapFS, mutate func(*ownershipRegistry)) {\n678|\tt.Helper()\n679|\n680|\tregistry, err := decodeOwnershipRegistry(repository[ownershipRegistryPath].Data)\n681|\tif err != nil {\n682|\t\tt.Fatalf(\"decode ownership registry: %v\", err)\n683|\t}\n684|\tmutate(&registry)\n685|\tvalue, err := json.MarshalIndent(registry, \"\", \"  \")\n686|\tif err != nil {\n687|\t\tt.Fatalf(\"encode ownership registry: %v\", err)\n688|\t}\n689|\trepository[ownershipRegistryPath] = &fstest.MapFile{Data: value}\n690|}\n691|\n692|func replaceRepositorySourceOnce(t *testing.T, repository fstest.MapFS, filename, from, to string) {\n693|\tt.Helper()\n694|\n695|\tfile, ok := repository[filename]\n696|\tif !ok {\n697|\t\tt.Fatalf(\"repository fixture %q not found\", filename)\n698|\t}\n699|\tif count := bytes.Count(file.Data, []byte(from)); count != 1 {\n700|\t\tt.Fatalf(\"repository fixture %q contains source declaration %q %d times, want exactly once\", filename, from, count)\n701|\t}\n702|\trepository[filename] = &fstest.MapFile{Data: bytes.Replace(file.Data, []byte(from), []byte(to), 1)}\n703|}\n704|\n705|func ownershipGroupByKind(t *testing.T, registry *ownershipRegistry, kind ownershipKind) *ownershipGroup {\n706|\tt.Helper()\n707|\n708|\tfor index := range registry.Ownership {\n709|\t\tif registry.