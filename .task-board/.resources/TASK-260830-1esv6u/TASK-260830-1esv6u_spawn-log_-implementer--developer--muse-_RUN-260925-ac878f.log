f-minted implementation claim has nowhere to hide.\n29|var newV070Bindings = map[string]string{\n30|\t\"section:13.1\":  \"STORY-260916-3fjjtn\",\n31|\t\"section:13.10\": \"STORY-260916-3aukw3\",\n32|\t\"section:14.1\":  \"STORY-260916-3fjjtn\",\n33|}\n34|\n35|// newV070Cases is the exact set of acceptance cases the v0.7.0 adoption may\n36|// add. Carried cases must otherwise be byte-equal to the v0.6.0 registry,\n37|// except for the two intended repoints asserted inline below.\n38|var newV070Cases = map[string]struct{}{\n39|\t\"catalog-v070-exact\":      {},\n40|\t\"source-pin-v070-exact\":   {},\n41|\t\"source-pin-v070-refusal\": {},\n42|}\n43|\n44|// rewordedV070Gaps maps the carried bindings whose gap the adoption rewords\n45|// to the story that must own the new text. appendix-d carries a split\n46|// attribution (\"pending STORY-...\") rather than the owner formula.\n47|var rewordedV070Gaps = map[string]string{\n48|\t\"section:5.1\":        \"STORY-260916-2q85nu\",\n49|\t\"section:7.3\":        \"STORY-260916-1ea7od\",\n50|\t\"section:7.4\":        \"STORY-260916-1ea7od\",\n51|\t\"section:7.5\":        \"STORY-260916-1kp1lx\",\n52|\t\"section:appendix-d\": \"STORY-260916-vucwn0\",\n53|}\n54|\n55|const (\n56|\tlaunchPlanContractKey = \"Launch Plan request [urn:ax:schema:launch-plan-request]\"\n57|\tlaunchPlanFixtureKey  = \"pin:ax-launch-plan-request-v1\"\n58|)\n59|\n60|// TestV070RegistryRederivesFromTrunkV060Registry re-derives the adopted v0.7.0\n61|// ownership registry from the trunk-final v0.6.0 registry and fails on any\n62|// missing binding, any unshifted clause line, or any self-minted claim.\n63|//\n64|// The v0.6.0 file in this tree is the trunk baseline: the suite's historical\n65|// byte-identity gate keeps it equal to trunk, and this test treats it as the\n66|// derivation source. Production VerifyRepository pins the exact adopted bytes\n67|// through reviewedOwnershipCanonicalSHA256; this test pins the derivation\n68|// relationship between the two registries, so neither a dropped carry nor an\n69|// unreviewed addition can pass as a re-derivation.\n70|//\n71|// Post-adoption stories upgrade the adopted registry deliberately through\n72|// storyUpgradedV070Bindings and storyNewV070Cases: each named upgrade is\n73|// pinned literally and re-measured against the pinned v0.7.0 document, while\n74|// every other binding and case still rederives byte-equal.\n75|func TestV070RegistryRederivesFromTrunkV060Registry(t *testing.T) {\n76|\tt.Parallel()\n77|\n78|\tprevious := decodeRegistryFile(t, \"ownership.v0.6.0.json\")\n79|\tcurrent := decodeRegistryFile(t, \"ownership.v0.7.0.json\")\n80|\n81|\tif current.Source != expectedV070Source {\n82|\t\tt.Fatalf(\"v0.7.0 registry source = %+v, want %+v\", current.Source, expectedV070Source)\n83|\t}\n84|\n85|\tpreviousBindings := sectionBindingsByKey(t, previous)\n86|\tcurrentBindings := sectionBindingsByKey(t, current)\n87|\n88|\tassertNoMissingBindings(t, previousBindings, currentBindings)\n89|\tassertNewBindingsAreReviewed(t, previousBindings, currentBindings)\n90|\tassertCarriedBindingsRederive(t, previousBindings, currentBindings)\n91|\tassertClauseLinesRemeasured(t, previousBindings, currentBindings)\n92|\tassertAcceptanceCasesRederive(t, previous, current)\n93|\tassertOwnershipGroupsRederive(t, previous, current)\n94|\tassertUnownedSectionsCarried(t, previous, current)\n95|}\n96|\n97|// TestStoryV070AcceptanceCasesHaveClauseEdges prevents a declaration-only\n98|// addition from being mistaken for measured coverage. Each Story leaf case\n99|// added by the tmux backend Story must be listed on an executed clause edge.\n100|func TestStoryV070AcceptanceCasesHaveClauseEdges(t *testing.T) {\n101|\tt.Parallel()\n102|\n103|\tcurrent := decodeRegistryFile(t, \"ownership.v0.7.0.json\")\n104|\tbindings := sectionBindingsByKey(t, current)\n105|\twantEdges := map[string]map[string]string{\n106|\t\t\"tmux-private-server-management-v070\": {\n107|\t\t\t\"section:4.2\": \"4.2#4,4.2#5,4.2#6,4.2#7\",\n108|\t\t},\n109|\t\t\"tmux-lifecycle-operations-v070\": {\n110|\t\t\t\"section:4.2\": \"4.2#9\",\n111|\t\t\t\"section:4.C\": \"4.C#3,4.C#4,4.C#7\",\n112|\t\t},\n113|\t\t\"tmux-attach-overlap-v070\": {\n114|\t\t\t\"section:4.C\": \"4.C#6\",\n115|\t\t},\n116|\t\t\"tmux-attach-semantics-v070\": {\n117|\t\t\t\"section:4.C\": \"4.C#3,4.C#5,4.C#6,4.C#7\",\n118|\t\t},\n119|\t\t\"tmux-socket-custody-v070\": {\n120|\t\t\t\"section:3.2\": \"3.2#8\",\n121|\t\t},\n122|\t}\n123|\n124|\tfor acceptanceID, sections := range wantEdges {\n125|\t\tfor bindingKey, clauseIDs := range sections {\n126|\t\t\tbinding, ok := bindings[bindingKey]\n127|\t\t\tif !ok {\n128|\t\t\t\tt.Fatalf(\"acceptance case %q requires absent binding %s\", acceptanceID, bindingKey)\n129|\t\t\t}\n130|\t\t\tgroupHasCase := false\n131|\t\t\tfor _, id := range binding.AcceptanceCases {\n132|\t\t\t\tif id == acceptanceID {\n133|\t\t\t\t\tgroupHasCase = true\n134|\t\t\t\t\tbreak\n135|\t\t\t\t}\n136|\t\t\t}\n137|\t\t\tif !groupHasCase {\n138|\t\t\t\tt.Fatalf(\"acceptance case %q is absent from binding %s\", acceptanceID, bindingKey)\n139|\t\t\t}\n140|\t\t\tfor _, clause := range binding.Clauses {\n141|\t\t\t\tif !strings.Contains(\",\"+clauseIDs+\",\", \",\"+clause.ID+\",\") {\n142|\t\t\t\t\tcontinue\n143|\t\t\t\t}\n144|\t\t\t\tfor _, id := range clause.AcceptanceCases {\n145|\t\t\t\t\tif id == acceptanceID {\n146|\t\t\t\t\t\tclauseIDs = strings.ReplaceAll(clauseIDs, clause.ID, \"\")\n147|\t\t\t\t\t\tbreak\n148|\t\t\t\t\t}\n149|\t\t\t\t}\n150|\t\t\t}\n(more lines below)","final_result":true}}}
