ause.ID != oldClause.ID {\n486|\t\t\t\tt.Fatalf(\"binding %q clause %d id moved from %s to %s\", key, index, oldClause.ID, newClause.ID)\n487|\t\t\t}\n488|\t\t\tif newClause.Excerpt != oldClause.Excerpt {\n489|\t\t\t\tt.Fatalf(\"binding %q clause %s excerpt changed\", key, oldClause.ID)\n490|\t\t\t}\n491|\t\t\tif !reflect.DeepEqual(newClause.AcceptanceCases, oldClause.AcceptanceCases) {\n492|\t\t\t\tt.Fatalf(\"binding %q clause %s acceptance cases moved\", key, oldClause.ID)\n493|\t\t\t}\n494|\t\t\tif newClause.Line == oldClause.Line {\n495|\t\t\t\tt.Fatalf(\"binding %q clause %s still cites v0.6.0 line %d; every carried clause shifts in v0.7.0\",\n496|\t\t\t\t\tkey, oldClause.ID, oldClause.Line)\n497|\t\t\t}\n498|\t\t\tif measured060[key][oldClause.ID] != oldClause.Line {\n499|\t\t\t\tt.Fatalf(\"binding %q clause %s v0.6.0 line %d is not the measured line %d\",\n500|\t\t\t\t\tkey, oldClause.ID, oldClause.Line, measured060[key][oldClause.ID])\n501|\t\t\t}\n502|\t\t\tif measured070[key][newClause.ID] != newClause.Line {\n503|\t\t\t\tt.Fatalf(\"binding %q clause %s v0.7.0 line %d is not the measured line %d\",\n504|\t\t\t\t\tkey, newClause.ID, newClause.Line, measured070[key][newClause.ID])\n505|\t\t\t}\n506|\t\t}\n507|\t}\n508|\tfor key := range storyNewV070Bindings {\n509|\t\tnow, ok := current[key]\n510|\t\tif !ok {\n511|\t\t\tcontinue\n512|\t\t}\n513|\t\tfor _, newClause := range now.Clauses {\n514|\t\t\tif measured070[key][newClause.ID] != newClause.Line {\n515|\t\t\t\tt.Fatalf(\"binding %q clause %s v0.7.0 line %d is not the measured line %d\",\n516|\t\t\t\t\tkey, newClause.ID, newClause.Line, measured070[key][newClause.ID])\n517|\t\t\t}\n518|\t\t}\n519|\t}\n520|}\n521|\n522|// measuredClauseLines returns the production-measured line of every normative\n523|// clause the pinned document carries for the given bindings, verifying each\n524|// binding's declared excerpts quote verbatim at their declared lines.\n525|func measuredClauseLines(t *testing.T, document *s