{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6e3","stream":{"kind":"session","id":"01a0d602-12a6-7cb3-99d1-8d1cf4fb003f"},"sequence":460,"recorded_at":1780531400000915,"record_type":"event","durability":"durable","causation_id":"8384434d-9d62-45ba-bafd-be548807fde7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8384434d-9d62-45ba-bafd-be548807fde7","run_stream":{"kind":"run","id":"8384434d-9d62-45ba-bafd-be548807fde7"},"task_stream":{"kind":"task","id":"01a0d603-35b3-7da2-8422-42bb24c0dc9a"},"task_id":"01a0d603-35b3-7da2-8422-42bb24c0dc9a","event":{"kind":"output","task_id":"01a0d603-35b3-7da2-8422-42bb24c0dc9a","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/clonereconcile/property_test.go`.\n1|package clonereconcile_test\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/clonefidelity\"\n10|\tclonereconcile \"github.com/relux-works/agent-session-manager/internal/clonereconcile\"\n11|)\n12|\n13|// Independent oracle for the reconciliation property. Every rule\n14|// below is retyped from the pinned SPEC v0.7.0 Section 13.14.2 text\n15|// (lines 10554-10556, 10581-10582, 10776-10777); the oracle shares\n16|// no code with production and reads only the generation parameters,\n17|// never the production verdict.\n18|//\n19|// Oracle rules (O1-O8):\n20|//   O1. Every captured candidate reconciles once: exactly one\n21|//       tier-1 arm. Zero or two arms refuse.\n22|//   O2. Every raw item reconciles once: exactly one tier-2 arm.\n23|//   O3. Every canonical item reconciles once: exactly one\n24|//       non-synthesized row, with staged/live target evidence or a\n25|//       target (omitted/unrecoverable) disposition.\n26|//   O4. A synthesized row never claims captured source evidence.\n27|//   O5. Claimed staged/live evidence resolves into the sealed read\n28|//       of its side; absent or mismatched read-back refuses.\n29|//   O6. The fidelity report binds both sealed reads.\n30|//   O7. An empty row set cannot seal a fidelity report (the owner\n31|//       requires 1..1000000 rows).\n32|//   O8. Valid follows the report rule: every check boolean true,\n33|//       matching native IDs, and no error finding.\n34|\n35|// oracleExpectation is one independent verdict: admit with a valid\n36|// bit, or refuse with a set of literal classes. Production reports\n37|// the first break in its documented gate order; the oracle reports\n38|// the SET of broken rules and the test asserts membership, so the\n39|// oracle never mirrors production's (arbitrary) firing order. Each\n40|// literal is additionally pinned exactly by its single-break gate\n41|// test.\n42|type oracleExpectation struct {\n43|\tadmit    bool\n44|\tvalid    bool\n45|\tliterals []string\n46|}\n47|\n48|// faultSpec is one injected fault: a pre-assembly worldSpec\n49|// transformer (only drop-row, which changes the row multiset the\n50|// fidelity breakdowns derive from) or a post-assembly input\n51|// mutation, plus the literal class production must report. An\n52|// applier returns false when the world lacks the shape the fault\n53|// needs; the cell then runs fault-free and the oracle predicts\n54|// from the degraded parameters.\n55|type faultSpec struct {\n56|\tname    string\n57|\tpre     func(*worldSpec) bool\n58|\tpost    func(*clonereconcile.ReconciliationInput) bool\n59|\tliteral string\n60|}\n61|\n62|func includedTier1Index(input *clonereconcile.ReconciliationInput) int {\n63|\tfor i, link := range input.Tier1 {\n64|\t\tif link.Raw != \"\" {\n65|\t\t\treturn i\n66|\t\t}\n67|\t}\n68|\treturn -1\n69|}\n70|\n71|func exclusionTier1Index(input *clonereconcile.ReconciliationInput) int {\n72|\tfor i, link := range input.Tier1 {\n73|\t\tif link.Exclusion != \"\" {\n74|\t\t\treturn i\n75|\t\t}\n76|\t}\n77|\treturn -1\n78|}\n79|\n80|func canonicalTier2Index(input *clonereconcile.ReconciliationInput) int {\n81|\tfor i, link := range input.Tier2 {\n82|\t\tif link.Canonical != \"\" {\n83|\t\t\treturn i\n84|\t\t}\n85|\t}\n86|\treturn -1\n87|}\n88|\n89|func rowIndexByDisposition(input *clonereconcile.ReconciliationInput, want func(string) bool) int {\n90|\tfor i, row := range input.Fidelity.Rows {\n91|\t\tif want(row.Disposition) {\n92|\t\t\treturn i\n93|\t\t}\n94|\t}\n95|\treturn -1\n96|}\n97|\n98|// tierFaults enumerates the rotating injected faults.\n99|func tierFaults() []faultSpec {\n100|\treturn []faultSpec{\n101|\t\t{name: \"none\"},\n102|\t\t{name: \"drop-tier1\", literal: \"has no link to raw evidence or exclusion\", post: func(input *clonereconcile.ReconciliationInput) bool {\n103|\t\t\tif len(input.Tier1) == 0 {\n104|\t\t\t\treturn false\n105|\t\t\t}\n106|\t\t\tinput.Tier1 = input.Tier1[1:]\n107|\t\t\treturn true\n108|\t\t}},\n109|\t\t{name: \"dup-tier1\", literal: \"tier-1 candidate\", post: func(input *clonereconcile.ReconciliationInput) bool {\n110|\t\t\tif len(input.Tier1) == 0 {\n111|\t\t\t\treturn false\n112|\t\t\t}\n113|\t\t\tinput.Tier1 = append(input.Tier1, input.Tier1[0])\n114|\t\t\treturn true\n115|\t\t}},\n116|\t\t{name: \"both-tier1\", literal: \"claims both raw evidence and exclusion\", post: func(input *clonereconcile.ReconciliationInput) bool {\n117|\t\t\ti := includedTier1Index(input)\n118|\t\t\tif i < 0 {\n119|\t\t\t\treturn false\n120|\t\t\t}\n121|\t\t\tinput.Tier1[i].Exclusion = \"durable_payload\"\n122|\t\t\treturn true\n123|\t\t}},\n124|\t\t{name: \"neither-tier1\", literal: \"has neither raw evidence nor exclusion\", post: func(input *clonereconcile.ReconciliationInput) bool {\n125|\t\t\tif len(input.Tier1) == 0 {\n126|\t\t\t\treturn false\n127|\t\t\t}\n128|\t\t\tinput.Tier1[0].Raw = \"\"\n129|\t\t\tinput.Tier1[0].Exclusion = \"\"\n130|\t\t\treturn true\n131|\t\t}},\n132|\t\t{name: \"raw-twice\", literal: \"tier-1 raw evidence\", post: func(input *clonereconcile.ReconciliationInput) bool {\n133|\t\t\tfirst, second := -1, -1\n134|\t\t\tfor i, link := range input.Tier1 {\n135|\t\t\t\tif link.Raw == \"\" {\n136|\t\t\t\t\tcontinue\n137|\t\t\t\t}\n138|\t\t\t\tif first < 0 {\n139|\t\t\t\t\tfirst = i\n140|\t\t\t\t} else {\n141|\t\t\t\t\tsecond = i\n142|\t\t\t\t\tbreak\n143|\t\t\t\t}\n144|\t\t\t}\n145|\t\t\tif second < 0 {\n146|\t\t\t\treturn false\n147|\t\t\t}\n148|\t\t\tinput.Tier1[second].Raw = input.Tier1[first].Raw\n149|\t\t\treturn true\n150|\t\t}},\n151|\t\t{name: \"bad-exclusion\", literal: \"outside the capture classes\", post: func(input *clonereconcile.ReconciliationInput) bool {\n152|\t\t\tif i := exclusionTier1Index(input); i >= 0 {\n153|\t\t\t\tinput.Tier1[i].Exclusion = \"frobnicate\"\n154|\t\t\t\treturn true\n155|\t\t\t}\n156|\t\t\tif len(input.Tier1) == 0 {\n157|\t\t\t\treturn false\n158|\t\t\t}\n159|\t\t\tinput.Tier1[0].Raw = \"\"\n160|\t\t\tinput.Tier1[0].Exclusion = \"frobnicate\"\n161|\t\t\treturn true\n162|\t\t}},\n163|\t\t{name: \"drop-tier2\", literal: \"has no link to a canonical item or normalization disposition\", post: func(input *clonereconcile.ReconciliationInput) bool {\n164|\t\t\tif len(input.Tier2) == 0 {\n165|\t\t\t\treturn false\n166|\t\t\t}\n167|\t\t\tinput.Tier2 = input.Tier2[1:]\n168|\t\t\treturn true\n169|\t\t}},\n170|\t\t{name: \"both-tier2\", literal: \"claims both a canonical item and a normalization disposition\", post: func(input *clonereconcile.ReconciliationInput) bool {\n171|\t\t\tif len(input.Tier2) == 0 {\n172|\t\t\t\treturn false\n173|\t\t\t}\n174|\t\t\tinput.Tier2[0].Canonical = fixtureDigest(\"fault-canon\")\n175|\t\t\tinput.Tier2[0].Normalization = \"omitted\"\n176|\t\t\treturn true\n177|\t\t}},\n178|\t\t{name: \"synth-normalization\", literal: \"normalizes to synthesized, which is sourceless\", post: func(input *clonereconcile.ReconciliationInput) bool {\n179|\t\t\tif len(input.Tier2) == 0 {\n180|\t\t\t\treturn false\n181|\t\t\t}\n182|\t\t\tinput.Tier2[0].Canonical = \"\"\n183|\t\t\tinput.Tier2[0].Normalization = \"synthesized\"\n184|\t\t\treturn true\n185|\t\t}},\n186|\t\t{name: \"canon-twice\", literal: \"tier-2 canonical item\", post: func(input *clonereconcile.ReconciliationInput) bool {\n187|\t\t\tfirst, second := -1, -1\n188|\t\t\tfor i, link := range input.Tier2 {\n189|\t\t\t\tif link.Canonical == \"\" {\n190|\t\t\t\t\tcontinue\n191|\t\t\t\t}\n192|\t\t\t\tif first < 0 {\n193|\t\t\t\t\tfirst = i\n194|\t\t\t\t} else {\n195|\t\t\t\t\tsecond = i\n196|\t\t\t\t\tbreak\n197|\t\t\t\t}\n198|\t\t\t}\n199|\t\t\tif second < 0 {\n200|\t\t\t\treturn false\n201|\t\t\t}\n202|\t\t\tinput.Tier2[second].Canonical = input.Tier2[first].Canonical\n203|\t\t\treturn true\n204|\t\t}},\n205|\t\t{name: \"drop-row\", literal: \"has no disposition row\", pre: func(spec *worldSpec) bool {\n206|\t\t\tfor i := range spec.items {\n207|\t\t\t\tif spec.items[i].exclusion == \"\" && !spec.items[i].noRow {\n208|\t\t\t\t\tspec.items[i].noRow = true\n209|\t\t\t\t\treturn true\n210|\t\t\t\t}\n211|\t\t\t}\n212|\t\t\treturn false\n213|\t\t}},\n214|\t\t{name: \"swap-canon\", literal: \"tier 2 derives\", post: func(input *clonereconcile.ReconciliationInput) bool {\n215|\t\t\tfirst, second := -1, -1\n216|\t\t\tfor i, row := range input.Fidelity.Rows {\n217|\t\t\t\tif row.Disposition == \"synthesized\" || row.CanonicalObjectID == nil {\n218|\t\t\t\t\tcontinue\n219|\t\t\t\t}\n220|\t\t\t\tif first < 0 {\n221|\t\t\t\t\tfirst = i\n222|\t\t\t\t} else {\n223|\t\t\t\t\tsecond = i\n224|\t\t\t\t\tbreak\n225|\t\t\t\t}\n226|\t\t\t}\n227|\t\t\tif second < 0 {\n228|\t\t\t\treturn false\n229|\t\t\t}\n230|\t\t\tinput.Fidelity.Rows[first].CanonicalObjectID, input.Fidelity.Rows[second].CanonicalObjectID =\n231|\t\t\t\tinput.Fidelity.Rows[second].CanonicalObjectID, input.Fidelity.Rows[first].CanonicalObjectID\n232|\t\t\treturn true\n233|\t\t}},\n234|\t\t{name: \"synth-claims\", literal: \"tier-3 synthesized row\", post: func(input *clonereconcile.ReconciliationInput) bool {\n235|\t\t\ti := rowIndexByDisposition(input, func(d string) bool { return d == \"synthesized\" })\n236|\t\t\traw := includedTier1Index(input)\n237|\t\t\tif i < 0 || raw < 0 {\n238|\t\t\t\treturn false\n239|\t\t\t}\n240|\t\t\tinput.Fidelity.Rows[i].SourceEvidenceIDs = []string{input.Tier1[raw].Raw}\n241|\t\t\treturn true\n242|\t\t}},\n243|\t\t{name: \"loss-claims\", literal: \"tier-3 loss row\", post: func(input *clonereconcile.ReconciliationInput) bool {\n244|\t\t\ti := rowIndexByDisposition(input, isLossDispositionName)\n245|\t\t\tif i < 0 {\n246|\t\t\t\treturn false\n247|\t\t\t}\n248|\t\t\tinput.Fidelity.Rows[i].StagedEvidenceObjectIDs = []string{fixtureDigest(\"staged-0\")}\n249|\t\t\treturn true\n250|\t\t}},\n251|\t\t{name: \"drop-staged\", literal: \"has no staged target evidence\", post: func(input *clonereconcile.ReconciliationInput) bool {\n252|\t\t\ti := rowIndexByDisposition(input, func(d string) bool {\n253|\t\t\t\treturn d != \"synthesized\" && !isLossDispositionName(d)\n254|\t\t\t})\n255|\t\t\tif i < 0 {\n256|\t\t\t\treturn false\n257|\t\t\t}\n258|\t\t\tinput.Fidelity.Rows[i].StagedEvidenceObjectIDs = []string{}\n259|\t\t\treturn true\n260|\t\t}},\n261|\t\t{name: \"drop-live\", literal: \"has no live target evidence\", post: func(input *clonereconcile.ReconciliationInput) bool {\n262|\t\t\ti := rowIndexByDisposition(input, func(d string) bool {\n263|\t\t\t\treturn d != \"synthesized\" && !isLossDispositionName(d)\n264|\t\t\t})\n265|\t\t\tif i < 0 {\n266|\t\t\t\treturn false\n267|\t\t\t}\n268|\t\t\tinput.Fidelity.Rows[i].LiveEvidenceObjectIDs = []string{}\n269|\t\t\treturn true\n270|\t\t}},\n271|\t\t{name: \"ghost-link\", literal: \"names undeclared candidate\", post: func(input *clonereconcile.ReconciliationInput) bool {\n272|\t\t\tinput.Tier1 = append(input.Tier1, clonereconcile.CandidateLink{Candidate: \"ghost\", Raw: fixtureDigest(\"ghost-raw\")})\n273|\t\t\treturn true\n274|\t\t}},\n275|\t\t{name: \"dup-candidate\", literal: \"carry duplicate\", post: func(input *clonereconcile.ReconciliationInput) bool {\n276|\t\t\tif len(input.Candidates) == 0 {\n277|\t\t\t\tinput.Candidates = []string{\"z\", \"z\"}\n278|\t\t\t\treturn true\n279|\t\t\t}\n280|\t\t\tinput.Candidates = append(input.Candidates, input.Candidates[0])\n281|\t\t\treturn true\n282|\t\t}},\n283|\t\t{name: \"bad-digest\", literal: \"is not a digest\", post: func(input *clonereconcile.ReconciliationInput) bool {\n284|\t\t\tif len(input.Tier1) > 0 {\n285|\t\t\t\tinput.Tier1[0].Raw = \"not-a-digest\"\n286|\t\t\t\tinput.Tier1[0].Exclusion = \"\"\n287|\t\t\t\treturn true\n288|\t\t\t}\n289|\t\t\tif len(input.Tier2) > 0 {\n290|\t\t\t\tinput.Tier2[0].Raw = \"not-a-digest\"\n291|\t\t\t\treturn true\n292|\t\t\t}\n293|\t\t\tinput.Candidates = []string{\"z\"}\n294|\t\t\tinput.Tier1 = []clonereconcile.CandidateLink{{Candidate: \"z\", Raw: \"not-a-digest\"}}\n295|\t\t\treturn true\n296|\t\t}},\n297|\t}\n298|}\n299|\n300|// readOutcome names one side's read-back state: the sealed read\n301|// carries the claimed universe (present), nothing (absent), or only\n302|// phantoms (mismatched).\n303|type readOutcome int\n304|\n305|const (\n306|\toutcomePresent readOutcome = iota\n307|\toutcomeAbsent\n308|\toutcomeMismatch\n309|)\n310|\n311|// oracle predicts the verdict for one generated cell from the\n312|// generation parameters. staged/live name the read-back outcomes;\n313|// rowsPresent reports whether any row sealed; stagedClaimants and\n314|// liveClaimants count the non-loss rows claiming evidence on each\n315|// side after the applied fault; applied is the applied fault's\n316|// literal (\"\" when no fault applied).\n317|func oracle(spec worldSpec, applied string, staged, live readOutcome, rowsPresent bool, stagedClaimants, liveClaimants int) oracleExpectation {\n318|\tvar literals []string\n319|\tif applied != \"\" {\n320|\t\tliterals = append(literals, applied)\n321|\t}\n322|\tif !rowsPresent {\n323|\t\tliterals = append(literals, \"fidelity report invalid\")\n324|\t}\n325|\tif staged != outcomePresent && stagedClaimants > 0 {\n326|\t\tliterals = append(literals, \"outside the staged read\")\n327|\t}\n328|\tif live != outcomePresent && liveClaimants > 0 {\n329|\t\tliterals = append(literals, \"outside the live read\")\n330|\t}\n331|\tif len(literals) > 0 {\n332|\t\treturn oracleExpectation{admit: false, literals: literals}\n333|\t}\n334|\treturn oracleExpectation{\n335|\t\tadmit: true,\n336|\t\tvalid: !spec.flipCheck && !spec.flipObserved && !spec.errorFinding,\n337|\t}\n338|}\n339|\n340|// claimantSummary counts the non-loss rows claiming evidence per\n341|// side from the generation parameters: excluded and rowless items\n342|// take no row, loss rows claim none, and the drop-staged/drop-live\n343|// faults strip the first claimant of their side.\n344|func claimantSummary(spec worldSpec, appliedFault string) (rowsPresent bool, staged, live int) {\n345|\tif spec.synthRows > 0 {\n346|\t\trowsPresent = true\n347|\t}\n348|\tstrippedStaged := appliedFault == \"drop-staged\"\n349|\tstrippedLive := appliedFault == \"drop-live\"\n350|\tfor _, item := range spec.items {\n351|\t\tif item.exclusion != \"\" || item.noRow {\n352|\t\t\tcontinue\n353|\t\t}\n354|\t\trowsPresent = true\n355|\t\tif isLossDispositionName(item.disposition) {\n356|\t\t\tcontinue\n357|\t\t}\n358|\t\tif len(item.stagedSeeds) > 0 || (item.stagedSeeds == nil && !strippedStagedFirst(&strippedStaged)) {\n359|\t\t\tstaged++\n360|\t\t}\n361|\t\tif len(item.liveSeeds) > 0 || (item.liveSeeds == nil && !strippedLiveFirst(&strippedLive)) {\n362|\t\t\tlive++\n363|\t\t}\n364|\t}\n365|\treturn rowsPresent, staged, live\n366|}\n367|\n368|func strippedStagedFirst(stripped *bool) bool {\n369|\tif *stripped {\n370|\t\t*stripped = false\n371|\t\treturn true\n372|\t}\n373|\treturn false\n374|}\n375|\n376|func strippedLiveFirst(stripped *bool) bool {\n377|\tif *stripped {\n378|\t\t*stripped = false\n379|\t\treturn true\n380|\t}\n381|\treturn false\n382|}\n383|\n384|// itemClass is one generated per-candidate class.\n385|type itemClass int\n386|\n387|const (\n388|\tclassExact itemClass = iota\n389|\tclassOpaque\n390|\tclassExcluded\n391|\tclassNormalized\n392|\tclassLost\n393|)\n394|\n395|func (c itemClass) item(index int) worldItem {\n396|\tkey := \"cand-\" + itoa(index)\n397|\tswitch c {\n398|\tcase classExact:\n399|\t\treturn worldItem{key: key, disposition: \"exact\"}\n400|\tcase classOpaque:\n401|\t\treturn worldItem{key: key, disposition: \"opaque_preserved\"}\n402|\tcase classExcluded:\n403|\t\treturn worldItem{key: key, exclusion: \"durable_payload\"}\n404|\tcase classNormalized:\n405|\t\treturn worldItem{key: key, normalization: \"summarized\", disposition: \"semantic\"}\n406|\tcase classLost:\n407|\t\treturn worldItem{key: key, disposition: \"omitted\"}\n408|\tdefault:\n409|\t\tpanic(\"unknown item class\")\n410|\t}\n411|}\n412|\n413|// classVectors enumerates every class vector of length n over the\n414|// five capture classes.\n415|func classVectors(n int) [][]itemClass {\n416|\tif n == 0 {\n417|\t\treturn [][]itemClass{{}}\n418|\t}\n419|\tvar out [][]itemClass\n420|\tfor _, tail := range classVectors(n - 1) {\n421|\t\tfor class := classExact; class <= classLost; class++ {\n422|\t\t\tvector := append([]itemClass{class}, tail...)\n423|\t\t\tout = append(out, vector)\n424|\t\t}\n425|\t}\n426|\treturn out\n427|}\n428|\n429|// applyOutcome maps one read-back outcome to carry overrides: nil\n430|// keeps the present universe, empty seals the absent read, phantoms\n431|// seal the mismatched read.\n432|func applyOutcome(spec *worldSpec, staged, live readOutcome) {\n433|\tif staged == outcomeAbsent {\n434|\t\tempty := []string{}\n435|\t\tspec.stagedCarry = &empty\n436|\t} else if staged == outcomeMismatch {\n437|\t\tphantoms := []string{\"phantom-staged-1\", \"phantom-staged-2\"}\n438|\t\tspec.stagedCarry = &phantoms\n439|\t}\n440|\tif live == outcomeAbsent {\n441|\t\tempty := []string{}\n442|\t\tspec.liveCarry = &empty\n443|\t} else if live == outcomeMismatch {\n444|\t\tphantoms := []string{\"phantom-live-1\", \"phantom-live-2\"}\n445|\t\tspec.liveCarry = &phantoms\n446|\t}\n447|}\n448|\n449|// rotateValidity assigns one validity variant per cell: nominal,\n450|// one flipped check boolean, a diverged observed native session, or\n451|// one error-severity finding. The oracle predicts the valid bit\n452|// from the same flags.\n453|func rotateValidity(spec *worldSpec, cell int) {\n454|\tswitch cell % 4 {\n455|\tcase 1:\n456|\t\tspec.flipCheck = true\n457|\tcase 2:\n458|\t\tspec.flipObserved = true\n459|\tcase 3:\n460|\t\tspec.errorFinding = true\n461|\t}\n462|}\n463|\n464|// runPropertyCell assembles one world, applies one rotating fault,\n465|// and checks the production verdict against the oracle.\n466|func runPropertyCell(t *testing.T, docs sharedWorldDocs, faults []faultSpec, spec worldSpec, staged, live readOutcome, cell, n int) {\n467|\tt.Helper()\n468|\trotateValidity(&spec, cell)\n469|\tfault := faults[cell%len(faults)]\n470|\tapplied := \"\"\n471|\tif fault.pre != nil && fault.pre(&spec) {\n472|\t\tapplied = fault.literal\n473|\t}\n474|\tinput := assembleWorld(t, docs, spec)\n475|\tappliedFault := \"\"\n476|\tif fault.post != nil {\n477|\t\tif fault.post(&input) {\n478|\t\t\tappliedFault = fault.name\n479|\t\t\tapplied = fault.literal\n480|\t\t}\n481|\t} else if fault.pre != nil && applied != \"\" {\n482|\t\tappliedFault = fault.name\n483|\t}\n484|\tassertFidelitySealsWhenRows(t, input, cell)\n485|\trowsPresent, stagedClaimants, liveClaimants := claimantSummary(spec, appliedFault)\n486|\twant := oracle(spec, applied, staged, live, rowsPresent, stagedClaimants, liveClaimants)\n487|\tcheckPropertyCell(t, input, want, cell, n, spec.synthRows, staged, live, fault.name, applied != \"\")\n488|}\n489|\n490|// TestReconciliationProperty enumerates the reconciliation product:\n491|// capture sets of N<=3 over the five classes crossed with\n492|// synthesized-row counts, the nine read-back outcomes, rotating\n493|// injected faults, and rotating validity variants. Every cell runs\n494|// the production Reconcile entry; the independent oracle predicts\n495|// admit/refuse and the valid bit.\n496|func TestReconciliationProperty(t *testing.T) {\n497|\tdocs := sealSharedWorldDocs(t)\n498|\tfaults := tierFaults()\n499|\tcell := 0\n500|\tfor n := 0; n <= 3; n++ {\n(more lines below)","final_result":true}}}
