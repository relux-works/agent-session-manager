{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c721","stream":{"kind":"session","id":"01a0d602-12a6-7cb3-99d1-8d1cf4fb003f"},"sequence":491,"recorded_at":1780531400000977,"record_type":"event","durability":"durable","causation_id":"8384434d-9d62-45ba-bafd-be548807fde7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"8384434d-9d62-45ba-bafd-be548807fde7","run_stream":{"kind":"run","id":"8384434d-9d62-45ba-bafd-be548807fde7"},"call_id":"call_01a0d6033b197577aaa6770aae143aff","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/clonereconcile/property_test.go`.\n(499 line(s) above)\n500|\tfor n := 0; n <= 3; n++ {\n501|\t\tfor _, vector := range classVectors(n) {\n502|\t\t\tfor synth := 0; synth <= 1; synth++ {\n503|\t\t\t\tfor staged := outcomePresent; staged <= outcomeMismatch; staged++ {\n504|\t\t\t\t\tfor live := outcomePresent; live <= outcomeMismatch; live++ {\n505|\t\t\t\t\t\tspec := worldSpec{synthRows: synth}\n506|\t\t\t\t\t\tfor index, class := range vector {\n507|\t\t\t\t\t\t\tspec.items = append(spec.items, class.item(index))\n508|\t\t\t\t\t\t}\n509|\t\t\t\t\t\tapplyOutcome(&spec, staged, live)\n510|\t\t\t\t\t\trunPropertyCell(t, docs, faults, spec, staged, live, cell, n)\n511|\t\t\t\t\t\tcell++\n512|\t\t\t\t\t}\n513|\t\t\t\t}\n514|\t\t\t}\n515|\t\t}\n516|\t}\n517|\tt.Logf(\"property cells: %d\", cell)\n518|}\n519|\n520|// nonNominalOutcomes rotates one non-nominal read-back outcome per\n521|// large-N cell.\n522|var nonNominalOutcomes = [][2]readOutcome{\n523|\t{outcomeAbsent, outcomePresent},\n524|\t{outcomePresent, outcomeAbsent},\n525|\t{outcomeMismatch, outcomePresent},\n526|\t{outcomePresent, outcomeMismatch},\n527|\t{outcomeAbsent, outcomeAbsent},\n528|\t{outcomeMismatch, outcomeMismatch},\n529|}\n530|\n531|// TestReconciliationPropertyLargeN samples the N=4..6 capture sets:\n532|// all-same-class vectors plus a deterministic rotating mix, each\n533|// with nominal and one rotated non-nominal read-back outcome.\n534|func TestReconciliationPropertyLargeN(t *testing.T) {\n535|\tdocs := sealSharedWorldDocs(t)\n536|\tfaults := tierFaults()\n537|\tcell := 0\n538|\tfor n := 4; n <= 6; n++ {\n539|\t\tvar vectors [][]itemClass\n540|\t\tfor class := classExact; class <= classLost; class++ {\n541|\t\t\tvector := make([]itemClass, n)\n542|\t\t\tfor i := range vector {\n543|\t\t\t\tvector[i] = class\n544|\t\t\t}\n545|\t\t\tvectors = append(vectors, vector)\n546|\t\t}\n547|\t\tfor mix := 0; mix < 55; mix++ {\n548|\t\t\tvector := make([]itemClass, n)\n549|\t\t\tfor i := range vector {\n550|\t\t\t\tvector[i] = itemClass((mix + 3*i) % 5)\n551|\t\t\t}\n552|\t\t\tvectors = append(vectors, vector)\n553|\t\t}\n554|\t\tfor _, vector := range vectors {\n555|\t\t\tfor synth := 0; synth <= 1; synth++ {\n556|\t\t\t\toutcomes := [][2]readOutcome{\n557|\t\t\t\t\t{outcomePresent, outcomePresent},\n558|\t\t\t\t\tnonNominalOutcomes[cell%len(nonNominalOutcomes)],\n559|\t\t\t\t}\n560|\t\t\t\tfor _, outcome := range outcomes {\n561|\t\t\t\t\tspec := worldSpec{synthRows: synth}\n562|\t\t\t\t\tfor index, class := range vector {\n563|\t\t\t\t\t\tspec.items = append(spec.items, class.item(index))\n564|\t\t\t\t\t}\n565|\t\t\t\t\tapplyOutcome(&spec, outcome[0], outcome[1])\n566|\t\t\t\t\trunPropertyCell(t, docs, faults, spec, outcome[0], outcome[1], cell, n)\n567|\t\t\t\t\tcell++\n568|\t\t\t\t}\n569|\t\t\t}\n570|\t\t}\n571|\t}\n572|\tt.Logf(\"large-N property cells: %d\", cell)\n573|}\n574|\n575|// assertFidelitySealsWhenRows guards the oracle's completeness: any\n576|// assembled input carrying rows must seal through the fidelity\n577|// owner, so production always reaches the reconciliation gates and\n578|// the oracle's break set stays complete. A seal failure here is a\n579|// generator bug, loud instead of silent.\n580|func assertFidelitySealsWhenRows(t *testing.T, input clonereconcile.ReconciliationInput, cell int) {\n581|\tt.Helper()\n582|\tif len(input.Fidelity.Rows) == 0 {\n583|\t\treturn\n584|\t}\n585|\tif _, err := clonefidelity.BuildFidelityReport(input.Fidelity); err != nil {\n586|\t\tt.Fatalf(\"cell %d: assembled fidelity input with %d rows refuses at the owner: %v\", cell, len(input.Fidelity.Rows), err)\n587|\t}\n588|}\n589|\n590|// checkPropertyCell runs one property cell through the production\n591|// entry and checks the oracle verdict: refusal membership over the\n592|// broken-rule set, or admission with the oracle's valid bit.\n593|func checkPropertyCell(t *testing.T, input clonereconcile.ReconciliationInput, want oracleExpectation, cell, n, synth int, staged, live readOutcome, fault string, applied bool) {\n594|\tt.Helper()\n595|\tgot, err := clonereconcile.Reconcile(input)\n596|\tlabel := fmt.Sprintf(\"cell=%d n=%d synth=%d staged=%d live=%d fault=%s applied=%v\", cell, n, synth, staged, live, fault, applied)\n597|\tif !want.admit {\n598|\t\tif err == nil {\n599|\t\t\tt.Fatalf(\"%s: Reconcile admitted, oracle refuses %q\", label, want.literals)\n600|\t\t}\n601|\t\tif !errors.Is(err, clonereconcile.ErrInvalid) {\n602|\t\t\tt.Fatalf(\"%s: error = %v, want errors.Is ErrInvalid\", label, err)\n603|\t\t}\n604|\t\tfor _, literal := range want.literals {\n605|\t\t\tif strings.Contains(err.Error(), literal) {\n606|\t\t\t\treturn\n607|\t\t\t}\n608|\t\t}\n609|\t\tt.Fatalf(\"%s: Reconcile error %q matches none of oracle %q\", label, err.Error(), want.literals)\n610|\t}\n611|\tif err != nil {\n612|\t\tt.Fatalf(\"%s: Reconcile refused %q, oracle admits\", label, err.Error())\n613|\t}\n614|\tif got.Valid != want.valid {\n615|\t\tt.Fatalf(\"%s: Reconcile valid=%v, oracle valid=%v\", label, got.Valid, want.valid)\n616|\t}\n617|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c723","stream":{"kind":"session","id":"01a0d602-12a6-7cb3-99d1-8d1cf4fb003f"},"sequence":492,"recorded_at":1780531400000979,"record_type":"event","durability":"durable","causation_id":"8384434d-9d62-45ba-bafd-be548807fde7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"8384434d-9d62-45ba-bafd-be548807fde7","run_stream":{"kind":"run","id":"8384434d-9d62-45ba-bafd-be548807fde7"},"call_id":"call_01a0d6033d5e7729bd2d85ca120275f9","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/clonereconcile/world_test.go`.\n1|package clonereconcile_test\n2|\n3|import (\n4|\t\"sort\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/clonefidelity\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/clonereadback\"\n9|\tclonereconcile \"github.com/relux-works/agent-session-manager/internal/clonereconcile\"\n10|)\n11|\n12|// worldItem is one generated capture item: a candidate key with its\n13|// tier-1 arm, tier-2 arm, and tier-3 row shape.\n14|type worldItem struct {\n15|\tkey           string // candidate key; \"\" synthesizes cand-<index>\n16|\texclusion     string // non-empty => tier-1 exclusion arm (no row)\n17|\tnormalization string // non-empty => tier-2 normalization arm (null-canonical row)\n18|\tdisposition   string // row disposition; \"\" => excluded item, no row\n19|\tstagedSeeds   []string\n20|\tliveSeeds     []string\n21|\tnoRow         bool // tiers link the item but no row covers it (fault cells)\n22|}\n23|\n24|// worldSpec is one generated reconciliation world: items plus the\n25|// read-back outcome and validity variant.\n26|type worldSpec struct {\n27|\titems        []worldItem\n28|\tsynthRows    int       // extra synthesized rows (evidence-free)\n29|\tstagedCarry  *[]string // nil => reads carry the claimed universe; else the override seeds\n30|\tliveCarry    *[]string\n31|\tflipCheck    bool // validity variant: one check boolean false\n32|\tflipObserved bool // validity variant: observed native session differs\n33|\terrorFinding bool // validity variant: one error-severity finding\n34|}\n35|\n36|// universeSeeds returns the fixed staged/live blob universes every\n37|// generated row claims within: staged-<i>/live-<i> for i in 0..5.\n38|func universeSeeds() (staged, live []string) {\n39|\tfor i := 0; i < 6; i++ {\n40|\t\tstaged = append(staged, \"staged-\"+itoa(i))\n41|\t\tlive = append(live, \"live-\"+itoa(i))\n42|\t}\n43|\treturn staged, live\n44|}\n45|\n46|// sharedWorldDocs seals the plan, projected manifest, and the three\n47|// read variants (present/absent/mismatched per side) once per test:\n48|// generated rows always claim within the fixed universe, so one\n49|// sealed read per outcome serves every cell honestly.\n50|type sharedWorldDocs struct {\n51|\tplanBytes      []byte\n52|\tprojectedBytes []byte\n53|\tstagedPresent  clonereadback.ValidatedReadBack\n54|\tstagedAbsent   clonereadback.ValidatedReadBack\n55|\tstagedMismatch clonereadback.ValidatedReadBack\n56|\tlivePresent    clonereadback.ValidatedReadBack\n57|\tliveAbsent     clonereadback.ValidatedReadBack\n58|\tliveMismatch   clonereadback.ValidatedReadBack\n59|}\n60|\n61|func sealSharedWorldDocs(t *testing.T) sharedWorldDocs {\n62|\tt.Helper()\n63|\tplanBytes := mustBuildPlan(t, validPlanInput())\n64|\tplanID := mustDecodePlan(t, planBytes).PlanID.String()\n65|\tprojectedBytes := mustBuildProjected(t, validProjectedInput(planID))\n66|\tprojectedID := mustDecodeProjected(t, projectedBytes).ManifestID.String()\n67|\tstagedUniverse, liveUniverse := universeSeeds()\n68|\tstagedPresent, _ := sealRead(t, \"staged\", planID, projectedID, evidenceFor(t, stagedUniverse))\n69|\tstagedAbsent, _ := sealRead(t, \"staged\", planID, projectedID, nil)\n70|\tstagedMismatch, _ := sealRead(t, \"staged\", planID, projectedID, evidenceFor(t, []string{\"phantom-staged-1\", \"phantom-staged-2\"}))\n71|\tlivePresent, _ := sealRead(t, \"live\", planID, projectedID, evidenceFor(t, liveUniverse))\n72|\tliveAbsent, _ := sealRead(t, \"live\", planID, projectedID, nil)\n73|\tliveMismatch, _ := sealRead(t, \"live\", planID, projectedID, evidenceFor(t, []string{\"phantom-live-1\", \"phantom-live-2\"}))\n74|\treturn sharedWorldDocs{\n75|\t\tplanBytes:      planBytes,\n76|\t\tprojectedBytes: projectedBytes,\n77|\t\tstagedPresent:  stagedPresent,\n78|\t\tstagedAbsent:   stagedAbsent,\n79|\t\tstagedMismatch: stagedMismatch,\n80|\t\tlivePresent:    livePresent,\n81|\t\tliveAbsent:     liveAbsent,\n82|\t\tliveMismatch:   liveMismatch,\n83|\t}\n84|}\n85|\n86|// resolveReads maps a worldSpec's carry overrides to sealed reads:\n87|// nil override => present variant; empty => absent; phantom seeds =>\n88|// the mismatch variant (the override seeds themselves decide which\n89|// mismatch read; any non-universe seed reads as mismatched).\n90|func (docs sharedWorldDocs) resolveReads(spec worldSpec) (clonereadback.ValidatedReadBack, clonereadback.ValidatedReadBack) {\n91|\tstaged := docs.stagedPresent\n92|\tif spec.stagedCarry != nil {\n93|\t\tswitch {\n94|\t\tcase len(*spec.stagedCarry) == 0:\n95|\t\t\tstaged = docs.stagedAbsent\n96|\t\tcase !carriesUniverse(*spec.stagedCarry, true):\n97|\t\t\tstaged = docs.stagedMismatch\n98|\t\t}\n99|\t}\n100|\tlive := docs.livePresent\n101|\tif spec.liveCarry != nil {\n102|\t\tswitch {\n103|\t\tcase len(*spec.liveCarry) == 0:\n104|\t\t\tlive = docs.liveAbsent\n105|\t\tcase !carriesUniverse(*spec.liveCarry, false):\n106|\t\t\tlive = docs.liveMismatch\n107|\t\t}\n108|\t}\n109|\treturn staged, live\n110|}\n111|\n112|// carriesUniverse reports whether override seeds cover the claimed\n113|// universe of their side. The mismatch reads carry only phantoms,\n114|// so any override missing a universe seed resolves as mismatched.\n115|func carriesUniverse(override []string, staged bool) bool {\n116|\tuniverse, _ := universeSeeds()\n117|\tif !staged {\n118|\t\t_, universe = universeSeeds()\n119|\t}\n120|\thave := make(map[string]bool, len(override))\n121|\tfor _, seed := range override {\n122|\t\thave[seed] = true\n123|\t}\n124|\tfor _, seed := range universe {\n125|\t\tif !have[seed] {\n126|\t\t\treturn false\n127|\t\t}\n128|\t}\n129|\treturn true\n130|}\n131|\n132|// assembleWorld builds one ReconciliationInput from a worldSpec:\n133|// tiers from the items, rows in owner order (source rows by key,\n134|// synthesized after), reads from the shared docs, and the expected\n135|// fidelity digest derived through the fidelity owner.\n136|func assembleWorld(t *testing.T, docs sharedWorldDocs, spec worldSpec) clonereconcile.ReconciliationInput {\n137|\tt.Helper()\n138|\tvar candidates []string\n139|\tvar tier1 []clonereconcile.CandidateLink\n140|\tvar tier2 []clonereconcile.RawLink\n141|\tvar rows []clonefidelity.DispositionRecordInput\n142|\tfor index, item := range spec.items {\n143|\t\tkey := item.key\n144|\t\tif key == \"\" {\n145|\t\t\tkey = \"cand-\" + itoa(index)\n146|\t\t}\n147|\t\tcandidates = append(candidates, key)\n148|\t\trawSeed := \"raw-\" + key\n149|\t\tif item.exclusion != \"\" {\n150|\t\t\ttier1 = append(tier1, clonereconcile.CandidateLink{Candidate: key, Exclusion: item.exclusion})\n151|\t\t\tcontinue\n152|\t\t}\n153|\t\ttier1 = append(tier1, clonereconcile.CandidateLink{Candidate: key, Raw: fixtureDigest(rawSeed)})\n154|\t\tcanonicalSeed := \"canon-\" + key\n155|\t\tvar canonical *string\n156|\t\tif item.normalization != \"\" {\n157|\t\t\ttier2 = append(tier2, clonereconcile.RawLink{Raw: fixtureDigest(rawSeed), Normalization: item.normalization})\n158|\t\t} else {\n159|\t\t\ttier2 = append(tier2, clonereconcile.RawLink{Raw: fixtureDigest(rawSeed), Canonical: fixtureDigest(canonicalSeed)})\n160|\t\t\tcanonical = strptr(fixtureDigest(canonicalSeed))\n161|\t\t}\n162|\t\tif item.noRow {\n163|\t\t\tcontinue\n164|\t\t}\n165|\t\tstaged := item.stagedSeeds\n166|\t\tif staged == nil && !isLossDispositionName(item.disposition) {\n167|\t\t\tstaged = []string{\"staged-\" + itoa(index)}\n168|\t\t}\n169|\t\tlive := item.liveSeeds\n170|\t\tif live == nil && !isLossDispositionName(item.disposition) {\n171|\t\t\tlive = []string{\"live-\" + itoa(index)}\n172|\t\t}\n173|\t\trows = append(rows, validRowInput(key, rawSeed, canonical, item.disposition, staged, live))\n174|\t}\n175|\tfor k := 0; k < spec.synthRows; k++ {\n176|\t\tkey := \"synth-\" + itoa(k)\n177|\t\trows = append(rows, synthRowInput(key, \"synth-ev-\"+itoa(k), nil, nil))\n178|\t}\n179|\tsort.SliceStable(rows, func(i, j int) bool {\n180|\t\tith := rows[i].Disposition == \"synthesized\"\n181|\t\tjth := rows[j].Disposition == \"synthesized\"\n182|\t\tif ith != jth {\n183|\t\t\treturn jth\n184|\t\t}\n185|\t\treturn rows[i].SourceItemKey < rows[j].SourceItemKey\n186|\t})\n187|\tstaged, live := docs.resolveReads(spec)\n188|\tfidelity := validFidelityInput(rows, staged.ManifestID().String(), live.ManifestID().String())\n189|\texpected, err := clonefidelity.BuildFidelityReport(fidelity)\n190|\tif err != nil {\n191|\t\t// The assembler may legitimately produce owner-invalid\n192|\t\t// fidelity inputs (empty rows when every candidate is\n193|\t\t// excluded): the expected digest is then the empty\n194|\t\t// marker and production must refuse at the fidelity\n195|\t\t// build. The oracle predicts that refusal.\n196|\t\texpected = nil\n197|\t}\n198|\texpectedID := \"\"\n199|\tif expected != nil {\n200|\t\treport, err := clonefidelity.DecodeFidelityReport(expected)\n201|\t\tif err != nil {\n202|\t\t\tt.Fatalf(\"DecodeFidelityReport(assembled): %v\", err)\n203|\t\t}\n204|\t\texpectedID = report.ReportID.String()\n205|\t}\n206|\tvalidation := validValidationFields(expectedID)\n207|\tif spec.flipCheck {\n208|\t\tvalidation.Checks.LiveStructuralValid = false\n209|\t}\n210|\tif spec.flipObserved {\n211|\t\tvalidation.ObservedTargetNativeSession = \"other-native-session\"\n212|\t}\n213|\tif spec.errorFinding {\n214|\t\tvalidation.Findings = fixtureFindings(\"error\")\n215|\t}\n216|\treturn clonereconcile.ReconciliationInput{\n217|\t\tCandidates: candidates,\n218|\t\tTier1:      tier1,\n219|\t\tTier2:      tier2,\n220|\t\tFidelity:   fidelity,\n221|\t\tHistory:    clonereconcile.History{Staged: staged, Live: live},\n222|\t\tPlan:       docs.planBytes,\n223|\t\tProjected:  docs.projectedBytes,\n224|\t\tValidation: validation,\n225|\t}\n226|}\n227|\n228|// isLossDispositionName mirrors the production loss set for fixture\n229|// defaulting: omitted and unrecoverable rows carry no evidence.\n230|func isLossDispositionName(disposition string) bool {\n231|\treturn disposition == \"omitted\" || disposition == \"unrecoverable\"\n232|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
