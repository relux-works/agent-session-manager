put(planID)\n227|\t\t\tother.TotalBytes = 129\n228|\t\t\tprojectedB := mustBuildProjected(t, other)\n229|\t\t\tprojectedBID := mustDecodeProjected(t, projectedB).ManifestID.String()\n230|\t\t\tstagedB, _ := sealRead(t, \"staged\", planID, projectedBID, evidenceFor(t, mustUniverseStaged()))\n231|\t\t\tinput.History.Staged = stagedB\n232|\t\t\tinput.Projected = projectedB\n233|\t\t}},\n234|\t\t{name: \"reads-differ-sessions\", literal: \"staged and live reads observe different native sessions\", mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n235|\t\t\tplanID := mustDecodePlan(t, input.Plan).PlanID.String()\n236|\t\t\tprojectedID := mustDecodeProjected(t, input.Projected).ManifestID.String()\n237|\t\t\tliveOther, _ := sealReadFull(t, \"live\", planID, projectedID, evidenceFor(t, mustUniverseLive()), \"other-session\", fixtureTuple())\n238|\t\t\tinput.History.Live = liveOther\n239|\t\t}},\n240|\t\t{name: \"plan-expects-other\", literal: \"projection plan expects native session\", mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n241|\t\t\tplanID := mustDecodePlan(t, input.Plan).PlanID.String()\n242|\t\t\tprojectedID := mustDecodeProjected(t, input.Projected).ManifestID.String()\n243|\t\t\tstagedOther, _ := sealReadFull(t, \"staged\", planID, projectedID, evidenceFor(t, mustUniverseStaged()), \"other-session\", fixtureTuple())\n244|\t\t\tliveOther, _ := sealReadFull(t, \"live\", planID, projectedID, evidenceFor(t, mustUniverseLive()), \"other-session\", fixtureTuple())\n245|\t\t\tinput.History.Staged = stagedOther\n246|\t\t\tinput.History.Live = liveOther\n247|\t\t}},\n248|\t\t{name: \"projected-expects-other\", literal: \"projected manifest expects native session\", mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n249|\t\t\tplanInput := validPlanInput()\n250|\t\t\tplanInput.ExpectedTargetNativeSession = \"other-session\"\n251|\t\t\tplanB := mustBuildPlan(t, planInput)\n252|\t\t\tplanBID := mustDecodePlan(t, planB).PlanID.String()\n253|\t\t\tprojectedID := mustDecodeProjected(t, input.Projected).ManifestID.String()\n254|\t\t\tstagedOther, _ := sealReadFull(t, \"staged\", planBID, projectedID, evidenceFor(t, mustUniverseStaged()), \"other-session\", fixtureTuple())\n255|\t\t\tliveOther, _ := sealReadFull(t, \"live\", planBID, projectedID, evidenceFor(t, mustUniverseLive()), \"other-session\", fixtureTuple())\n256|\t\t\tinput.History.Staged = stagedOther\n257|\t\t\tinput.History.Live = liveOther\n258|\t\t\tinput.Plan = planB\n259|\t\t}},\n260|\t\t// Fidelity pairing.\n261|\t\t{name: \"fidelity-staged-unbound\", literal: \"fidelity report does not bind the staged read\", mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n262|\t\t\tinput.Fidelity.StagedReadBackEvidenceManifestID = strptr(phantom)\n263|\t\t}},\n264|\t\t{name: \"fidelity-live-unbound\", literal: \"fidelity report does not bind the live read\", mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n265|\t\t\tinput.Fidelity.LiveReadBackEvidenceManifestID = strptr(phantom)\n266|\t\t}},\n267|\t\t{name: \"fidelity-tuple-staged\", literal: \"fidelity target tuple differs from the staged observed tuple\", mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n268|\t\t\tinput.Fidelity.TargetEnvironment = fixtureTupleOther()\n269|\t\t}},\n270|\t\t{name: \"fidelity-tuple-live\", literal: \"fidelity target tuple differs from the live observed tuple\", mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n271|\t\t\tplanID := mustDecodePlan(t, input.Plan).PlanID.String()\n272|\t\t\tprojectedID := mustDecodeProjected(t, input.Projected).ManifestID.String()\n273|\t\t\tliveOther, _ := sealReadFull(t, \"live\", planID, projectedID, evidenceFor(t, mustUniverseLive()), fixtureNativeSession, fixtureTupleOther())\n274|\t\t\tinput.History.Live = liveOther\n275|\t\t\tinput.Fidelity.LiveReadBackEvidenceManifestID = strptr(liveOther.ManifestID().String())\n276|\t\t}},\n277|\t\t// Validation pairing and seal.\n278|\t\t{name: \"validation-tuple-garbage\", literal: \"validation target tuple invalid\", mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n279|\t\t\tinput.Validation.TargetEnvironment = []byte(\"not-json\")\n280|\t\t}},\n281|\t\t{name: \"validation-tuple-empty\", literal: \"validation target tuple invalid\", mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n282|\t\t\tinput.Validation.TargetEnvironment = []byte{}\n283|\t\t}},\n284|\t\t{name: \"validation-tuple-staged\", literal: \"validation target tuple differs from the staged observed tuple\", mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n285|\t\t\tinput.Validation.TargetEnvironment = fixtureTupleOther()\n286|\t\t}},\n287|\t\t{name: \"validation-expects-other\", literal: `validation report expects native session \"other-session\", reads observe \"target-native-session-1\"`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n288|\t\t\tinput.Validation.ExpectedTargetNativeSession = \"other-session\"\n289|\t\t}},\n290|\t\t{name: \"expected-fidelity-garbage\", literal: \"expected fidelity report is not a digest\", mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n291|\t\t\tinput.Validation.ExpectedFidelityReportID = \"bogus\"\n292|\t\t}},\n293|\t\t{name: \"expected-fidelity-empty\", literal: \"expected fidelity report is not a digest\", mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n294|\t\t\tinput.Validation.ExpectedFidelityReportID = \"\"\n295|\t\t}},\n296|\t\t{name: \"expected-fidelity-mismatch\", literal: \"expected fidelity report\", mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n297|\t\t\tinput.Validation.ExpectedFidelityReportID = phantom\n298|\t\t}},\n299|\t\t{name: \"validation-malformed\", literal: \"validation report invalid\", mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n300|\t\t\tinput.Validation.Findings = []byte(\"not-json\")\n301|\t\t}},\n302|\t}\n303|}\n304|\n305|func mustUniverseStaged() []string {\n306|\tstaged, _ := universeSeeds()\n307|\treturn staged\n308|}\n309|\n310|func mustUniverseLive() []string {\n311|\t_, live := universeSeeds()\n312|\treturn live\n313|}\n314|\n315|// TestReconcileGateRefusals pins every refusal site exactly: each\n316|// row breaks one gate and asserts its literal code and detail at\n317|// the production Reconcile entry.\n318|func TestReconcileGateRefusals(t *testing.T) {\n319|\tdocs := sealSharedWorldDocs(t)\n320|\tfor _, row := range gateRefusalTable() {\n321|\t\tt.Run(row.name, func(t *testing.T) {\n322|\t\t\tbuild := gateBaseline\n323|\t\t\tif row.world != nil {\n324|\t\t\t\tbuild = row.world\n325|\t\t\t}\n326|\t\t\tinput := build(t, docs)\n327|\t\t\trow.mutate(t, docs, &input)\n328|\t\t\t_, err := clonereconcile.Reconcile(input)\n329|\t\t\trequireRefusal(t, err, row.literal)\n330|\t\t})\n331|\t}\n332|}\n333|\n334|// TestReconcileMultibyteCandidateMeasure pins the character (not\n335|// byte) string measure at the candidate gate: 512 é admit, 513\n336|// refuse.\n337|func TestReconcileMultibyteCandidateMeasure(t *testing.T) {\n338|\tdocs := sealSharedWorldDocs(t)\n339|\tadmit := gateBaseline(t, docs)\n340|\tadmit.Candidates[0] = strings.Repeat(\"é\", 512)\n341|\tadmit.Tier1[0].Candidate = strings.Repeat(\"é\", 512)\n342|\tadmit.Fidelity.Rows[0].SourceItemKey = strings.Repeat(\"é\", 512)\n343|\t// Re-sort: the multibyte key sorts after the ASCII keys, so\n344|\t// move the row to keep owner order.\n345|\trows := admit.Fidelity.Rows\n346|\tadmit.Fidelity.Rows = []clonefidelity.DispositionRecordInput{rows[1], rows[2], rows[0], rows[3]}\n347|\trelinkExpectedFidelity(t, &admit)\n348|\tif _, err := clonereconcile.Reconcile(admit); err != nil {\n349|\t\tt.Fatalf(\"Reconcile(512-char key) error = %v\", err)\n350|\t}\n351|\trefuse := gateBaseline(t, docs)\n352|\trefuse.Candidates[0] = strings.Repeat(\"é\", 513)\n353|\t_, err := clonereconcile.Reconcile(refuse)\n354|\trequireRefusal(t, err, \"candidate key is not a string[1..512]\")\n355|}\n356|\n357|// relinkExpectedFidelity re-derives the expected fidelity digest\n358|// through the fidelity owner after a test mutation changes the\n359|// fidelity input.\n360|func relinkExpectedFidelity(t *testing.T, input *clonereconcile.ReconciliationInput) {\n361|\tt.Helper()\n362|\tsealed, err := clonefidelity.BuildFidelityReport(input.Fidelity)\n363|\tif err != nil {\n364|\t\tt.Fatalf(\"BuildFidelityReport(relinked) error = %v\", err)\n365|\t}\n366|\treport, err := clonefidelity.DecodeFidelityReport(sealed)\n367|\tif err != nil {\n368|\t\tt.Fatalf(\"DecodeFidelityReport(relinked) error = %v\", err)\n369|\t}\n370|\tinput.Validation.ExpectedFidelityReportID = report.ReportID.String()\n371|}\n372|\n373|// TestReconcilePlanDecodesThroughOwner pins that the plan pairing\n374|// reads the owner-decoded plan: a plan whose bytes the owner\n375|// refuses on a semantic rule never reaches pairing.\n376|func TestReconcilePlanDecodesThroughOwner(t *testing.T) {\n377|\tdocs := sealSharedWorldDocs(t)\n378|\tinput := gateBaseline(t, docs)\n379|\tvar document map[string]any\n380|\tif err := json.Unmarshal(input.Plan, &document); err != nil {\n381|\t\tt.Fatalf(\"decode plan: %v\", err)\n382|\t}\n383|\tdocument[\"strategy\"] = \"archive_only\"\n384|\ttampered, err := json.Marshal(document)\n385|\tif err != nil {\n386|\t\tt.Fatalf(\"marshal tampered plan: %v\", err)\n387|\t}\n388|\tinput.Plan = tampered\n389|\t_, err = clonereconcile.Reconcile(input)\n390|\trequireRefusal(t, err, \"projection plan invalid\")\n391|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
