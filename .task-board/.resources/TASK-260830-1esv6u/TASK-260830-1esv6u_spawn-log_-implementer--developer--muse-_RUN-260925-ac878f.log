t.DischargedClauses += measured.Discharged\n466|\t\tswitch measured.Level {\n467|\t\tcase coverageFull:\n468|\t\t\treport.FullCoverage++\n469|\t\tcase coveragePartial:\n470|\t\t\treport.PartialCoverage++\n471|\t\tcase coverageSliver:\n472|\t\t\treport.SliverCoverage++\n473|\t\tcase coverageUnevidenced:\n474|\t\t\treport.UnevidencedCoverage++\n475|\t\tcase coverageUnmeasured:\n476|\t\t\treport.UnmeasuredCoverage++\n477|\t\t}\n478|\t}\n479|\treturn report, nil\n480|}\n481|\n482|// verifySectionCoverage measures every registered section binding against the\n483|// pinned document and refuses a coverage claim on any other ownership kind. A\n484|// contract or fixture owner has no section to be measured against, so a\n485|// coverage field there would be a claim the gate cannot check.\n486|func verifySectionCoverage(\n487|\tdocument *specdoc.Document,\n488|\tgroups []ownershipGroup,\n489|\tacceptanceIDs map[string]struct{},\n490|) (map[string]sectionCoverage, error) {\n491|\tresult := make(map[string]sectionCoverage)\n492|\tfor index, group := range groups {\n493|\t\tif group.Kind != ownershipSectionBinding {\n494|\t\t\tif group.Coverage != \"\" || group.Gap != \"\" || len(group.Clauses) != 0 {\n495|\t\t\t\treturn nil, fail(\n496|\t\t\t\t\t\"ownership group %d (%s) claims section coverage, which only a section binding can be measured for\",\n497|\t\t\t\t\tindex, group.Kind)\n498|\t\t\t}\n499|\t\t\tcontinue\n500|\t\t}\n501|\t\tif len(group.Keys) != 1 {\n502|\t\t\treturn nil, fail(\"section binding ownership group %d has %d keys, want exactly one\", index, len(group.Keys))\n503|\t\t}\n504|\t\tmeasured, err := verifySectionBindingCoverage(document, group, acceptanceIDs)\n505|\t\tif err != nil {\n506|\t\t\treturn nil, err\n507|\t\t}\n508|\t\tif _, duplicate := result[measured.Key]; duplicate {\n509|\t\t\treturn nil, fail(\"duplicate section_binding implementation owner for %q\", measured.Key)\n510|\t\t}\n511|\t\tresult[measured.Key] = measured\n512|\t}\n513|\treturn result, nil\n514|}\n515|\n516|func verifyAcceptanceCases(checker *sourceChecker, cases []acceptanceCase) (map[string]struct{}, error) {\n517|\tif len(cases) == 0 {\n518|\t\treturn nil, fail(\"acceptance case registry is empty\")\n519|\t}\n520|\tseen := make(map[string]struct{}, len(cases))\n521|\tfor index, acceptance := range cases {\n522|\t\tif acceptance.ID == \"\" {\n523|\t\t\treturn nil, fail(\"acceptance case %d has an empty id\", index)\n524|\t\t}\n525|\t\tif _, duplicate := seen[acceptance.ID]; duplicate {\n526|\t\t\treturn nil, fail(\"duplicate acceptance case %q\", acceptance.ID)\n527|\t\t}\n528|\t\tseen[acceptance.ID] = struct{}{}\n529|\t\tif err := checker.verify(acceptance.Production, false); err != nil {\n530|\t\t\treturn nil, fail(\"acceptance case %q production owner: %v\", acceptance.ID, err)\n531|\t\t}\n532|\t\tif len(acceptance.Tests) == 0 {\n533|\t\t\treturn nil, fail(\"acceptance case %q has no executable test owner\", acceptance.ID)\n534|\t\t}\n535|\t\ttestSeen := make(map[codeReference]struct{}, len(acceptance.Tests))\n536|\t\tfor _, test := range acceptance.Tests {\n537|\t\t\tif _, duplicate := testSeen[test]; duplicate {\n538|\t\t\t\treturn nil, fail(\"acceptance case %q repeats test owner %s:%s\", acceptance.ID, test.Path, test.Declaration)\n539|\t\t\t}\n540|\t\t\ttestSeen[test] = struct{}{}\n541|\t\t\tif err := checker.verify(test, true); err != nil {\n542|\t\t\t\treturn nil, fail(\"acceptance case %q test owner: %v\", acceptance.ID, err)\n543|\t\t\t}\n544|\t\t}\n545|\t}\n546|\treturn seen, nil\n547|}\n548|\n549|func verifyOwnershipGroups(\n550|\tchecker *sourceChecker,\n551|\tgroups []ownershipGroup,\n552|\tacceptanceIDs map[string]struct{},\n553|\tallowed map[ownershipKind]map[string]struct{},\n554|\trequired map[ownershipKind]map[string]struct{},\n555|\tselectedSectionBindings map[string]struct{},\n556|) (map[ownershipKind]map[string]struct{}, error) {\n557|\towned := map[ownershipKind]map[string]struct{}{\n558|\t\townershipContract:         make(map[string]struct{}),\n559|\t\townershipNormativeSection: make(map[string]struct{}),\n560|\t\townershipSectionBinding:   make(map[string]struct{}),\n561|\t\townershipFixture:          make(map[string]struct{}),\n562|\t}\n563|\tif len(groups) == 0 {\n564|\t\treturn nil, fail(\"implementation ownership registry is empty\")\n565|\t}\n566|\tfor index, group := range groups {\n567|\t\tif _, ok := allowed[group.Kind]; !ok {\n568|\t\t\treturn nil, fail(\"ownership group %d has unknown kind %q\", index, group.Kind)\n569|\t\t}\n(more lines below)","final_result":true}}}
