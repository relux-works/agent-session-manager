ke(map[string]struct{}, len(registry.AcceptanceCases))\n174|\tfor _, acceptance := range registry.AcceptanceCases {\n175|\t\tregistered[acceptance.ID] = struct{}{}\n176|\t}\n177|\treferences := make(map[string]map[string]struct{}, len(want))\n178|\tfor _, group := range registry.Ownership {\n179|\t\tif group.Kind != ownershipSectionBinding || len(group.Keys) != 1 {\n180|\t\t\tcontinue\n181|\t\t}\n182|\t\tfor _, clause := range group.Clauses {\n183|\t\t\tkey := \"section:\" + clause.ID\n184|\t\t\tfor _, acceptanceID := range clause.AcceptanceCases {\n185|\t\t\t\tif _, assigned := want[acceptanceID]; !assigned {\n186|\t\t\t\t\tcontinue\n187|\t\t\t\t}\n188|\t\t\t\tif references[acceptanceID] == nil {\n189|\t\t\t\t\treferences[acceptanceID] = make(map[string]struct{})\n190|\t\t\t\t}\n191|\t\t\t\treferences[acceptanceID][key] = struct{}{}\n192|\t\t\t}\n193|\t\t}\n194|\t}\n195|\tfor acceptanceID, clauseKeys := range want {\n196|\t\tif _, ok := registered[acceptanceID]; !ok {\n197|\t\t\tt.Errorf(\"story acceptance case %q is absent from the decoded registry\", acceptanceID)\n198|\t\t}\n199|\t\tfor _, clauseKey := range clauseKeys {\n200|\t\t\tif _, ok := references[acceptanceID][clauseKey]; !ok {\n201|\t\t\t\tt.Errorf(\"story acceptance case %q is not named by decoded clause %q\", acceptanceID, clauseKey)\n202|\t\t\t}\n203|\t\t}\n204|\t\tif len(references[acceptanceID]) == 0 {\n205|\t\t\tt.Errorf(\"story acceptance case %q is defined but referenced by no decoded clause\", acceptanceID)\n206|\t\t}\n207|\t}\n208|}\n209|\n210|// TestStoryFinalFidelityCasesAppearInDecodedBinding decodes the\n211|// adopted registry and proves the STORY-260830-21bxa3 story-final\n212|// edit: all five leaf acceptance cases are registered, the\n213|// section:13.14.2 binding owns all five, and the binding\n214|// production is the implementing reconciliation entry. Section\n215|// 13.14.2 carries no scanner-measured clause line (verified by the\n216|// probe in the story-final handoff note), so there is no clause\n217|// list to appear in; the binding edge is the measured claim, and\n218|// the binding enumerates no clauses.\n219|func TestStoryFinalFidelityCasesAppearInDecodedBinding(t *testing.T) {\n220|\tregistry := decodeRegistryFile(t, \"ownership.v0.7.0.json\")\n221|\twant := []string{\n222|\t\t\"story-260830-2ya5le-fidelity-report\",\n223|\t\t\"story-260830-1jmmqn-projection-plan\",\n224|\t\t\"story-260830-3n78rv-projection-planning\",\n225|\t\t\"story-260830-2zboyz-readback-validation\",\n226|\t\t\"story-260830-1esv6u-reconciliation\",\n227|\t}\n228|\tregistered := make(map[string]acceptanceCase, len(registry.AcceptanceCases))\n229|\tfor _, acceptance := range registry.AcceptanceCases {\n230|\t\tregistered[acceptance.ID] = acceptance\n231|\t}\n232|\tfor _, acceptanceID := range want {\n233|\t\tacceptance, ok := registered[acceptanceID]\n234|\t\tif !ok {\n235|\t\t\tt.Errorf(\"story acceptance case %q is absent from the decoded registry\", acceptanceID)\n236|\t\t\tcontinue\n237|\t\t}\n238|\t\tif len(acceptance.Tests) == 0 {\n239|\t\t\tt.Errorf(\"story acceptance case %q names no executable test\", acceptanceID)\n240|\t\t}\n241|\t}\n242|\tbindings := sectionBindingsByKey(t, registry)\n243|\tbinding, ok := bindings[\"section:13.14.2\"]\n244|\tif !ok {\n245|\t\tt.Fatalf(\"decoded registry carries no section:13.14.2 binding\")\n246|\t}\n247|\tif binding.Production != (codeReference{Path: \"internal/clonereconcile/reconcile.go\", Declaration: \"Reconcile\"}) {\n248|\t\tt.Errorf(\"section:13.14.2 production = %+v, want the Reconcile entry\", binding.Production)\n249|\t}\n250|\tif len(binding.Clauses) != 0 {\n251|\t\tt.Errorf(\"section:13.14.2 enumerates %d clauses, want none for the clauseless section\", len(binding.Clauses))\n252|\t}\n253|\towned := make(map[string]bool, len(binding.AcceptanceCases))\n254|\tfor _, acceptanceID := range binding.AcceptanceCases {\n255|\t\towned[acceptanceID] = true\n256|\t}\n257|\tfor _, acceptanceID := range want {\n258|\t\tif !owned[acceptanceID] {\n259|\t\t\tt.Errorf(\"story acceptance case %q is absent from the decoded section:13.14.2 binding\", acceptanceID)\n260|\t\t}\n261|\t}\n262|}\n263|\n264|func decodeRegistryFile(t *testing.T, name string) ownershipRegistry {\n265|\tt.Helper()\n266|\n267|\traw, err := os.ReadFile(name)\n268|\tif err != nil {\n269|\t\tt.Fatalf(\"read %s: %v\", name, err)\n270|\t}\n271|\tregistry, err := decodeOwnershipRegistry(raw)\n272|\tif err != nil {\n273|\t\tt.Fatalf(\"decode %s: %v\", name, err)\n274|\t}\n275|\treturn registry\n276|}\n277|\n278|func TestSection24LosingLeaseClausePointsAtDerivationAuthority(t *testing.T) {\n279|\tregistry := decodeRegistryFile(t, \"ownership.v0.7.0.json\")\n280|\tgroup := ownershipGroupByKindAndKeys(t, registry, ownershipSectionBinding, \"section:2.4\")\n281|\twantOwner := codeReference{Path: \"internal/sessprofile/authority.go\", Declaration: \"Derive\"}\n282|\tif group.Production != wantOwner {\n283|\t\tt.Fatalf(\"Section 2.4 owner = %+v, want derivation authority %+v\", group.Production, wantOwner)\n284|\t}\n285|\twantCase := \"story-260922-derivation-side-profile-source\"\n286|\tif !stringMember(group.AcceptanceCases, wantCase) {\n287|\t\tt.Fatalf(\"Section 2.4 acceptance cases omit %q: %q\", wantCase, group.AcceptanceCases)\n288|\t}\n289|\tvar clause *dischargedClause\n290|\tfor index := range group.Clauses {\n291|\t\tif group.Clauses[index].ID == \"2.4#2\" {\n292|\t\t\tclause = &group.Clauses[index]\n293|\t\t\tbreak\n294|\t\t}\n295|\t}\n296|\tif clause == nil || !stringMember(clause.AcceptanceCases, wantCase) {\n297|\t\tt.Fatalf(\"decoded 2.4#2 edge = %+v, want acceptance case %q\", clause, wantCase)\n298|\t}\n299|\tvar acceptance *acceptanceCase\n300|\tfor index := range registry.AcceptanceCases {\n301|\t\tif registry.AcceptanceCases[index].ID == wantCase {\n302|\t\t\tacceptance = &registry.AcceptanceCases[index]\n303|\t\t\tbreak\n304|\t\t}\n305|\t}\n306|\tif acceptance == nil || acceptance.Production != wantOwner {\n307|\t\tt.Fatalf(\"decoded acceptance case %q = %+v, want production owner %+v\", wantCase, acceptance, wantOwner)\n308|\t}\n309|}\n310|\n311|func stringMember(values []string, want string) bool {\n312|\tfor _, value := range values {\n313|\t\tif value == want {\n314|\t\t\treturn true\n315|\t\t}\n316|\t}\n317|\treturn false\n318|}\n319|\n320|func sectionBindingsByKey(t *testing.T, registry ownershipRegistry) map[string]ownershipGroup {\n321|\tt.Helper()\n322|\n323|\tresult := make(map[string]ownershipGroup)\n324|\tfor _, group := range registry.Ownership {\n325|\t\tif group.Kind != ownershipSectionBinding {\n326|\t\t\tcontinue\n327|\t\t}\n328|\t\tif len(group.Keys) != 1 {\n329|\t\t\tt.Fatalf(\"section binding group carries %d keys %q, want exactly 1\", len(group.Keys), group.Keys)\n(more lines below)","final_result":true}}}
