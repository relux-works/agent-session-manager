ncile.ReconciliationInput\n32|}\n33|\n34|func gateRefusalTable() []gateRow {\n35|\traw0 := fixtureDigest(\"raw-cand-0\")\n36|\tcanon0 := fixtureDigest(\"canon-cand-0\")\n37|\tcanon1 := fixtureDigest(\"canon-cand-1\")\n38|\tphantom := fixtureDigest(\"phantom\")\n39|\treturn []gateRow{\n40|\t\t// Candidate hygiene.\n41|\t\t{name: \"candidate-utf8\", literal: \"candidate key is not valid UTF-8\", mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n42|\t\t\tinput.Candidates[0] = \"bad\\xff\"\n43|\t\t}},\n44|\t\t{name: \"candidate-empty\", literal: \"candidate key is not a string[1..512]\", mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n45|\t\t\tinput.Candidates[0] = \"\"\n46|\t\t}},\n47|\t\t{name: \"candidate-too-long\", literal: \"candidate key is not a string[1..512]\", mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n48|\t\t\tinput.Candidates[0] = strings.Repeat(\"a\", 513)\n49|\t\t}},\n50|\t\t{name: \"candidate-duplicate\", literal: `candidates carry duplicate \"cand-0\"`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n51|\t\t\tinput.Candidates = append(input.Candidates, \"cand-0\")\n52|\t\t}},\n53|\t\t// Tier 1.\n54|\t\t{name: \"tier1-undeclared\", literal: `tier-1 link names undeclared candidate \"ghost\"`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n55|\t\t\tinput.Tier1 = append(input.Tier1, clonereconcile.CandidateLink{Candidate: \"ghost\", Raw: phantom})\n56|\t\t}},\n57|\t\t{name: \"tier1-twice\", literal: `tier-1 candidate \"cand-0\" reconciles twice`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n58|\t\t\tinput.Tier1 = append(input.Tier1, input.Tier1[0])\n59|\t\t}},\n60|\t\t{name: \"tier1-missing\", literal: `tier-1 candidate \"cand-0\" has no link to raw evidence or exclusion`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n61|\t\t\tinput.Tier1 = input.Tier1[1:]\n62|\t\t}},\n63|\t\t{name: \"tier1-both\", literal: `tier-1 candidate \"cand-0\" claims both raw evidence and exclusion`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n64|\t\t\tinput.Tier1[0].Exclusion = \"durable_payload\"\n65|\t\t}},\n66|\t\t{name: \"tier1-neither\", literal: `tier-1 candidate \"cand-0\" has neither raw evidence nor exclusion`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n67|\t\t\tinput.Tier1[0].Raw = \"\"\n68|\t\t\tinput.Tier1[0].Exclusion = \"\"\n69|\t\t}},\n70|\t\t{name: \"tier1-raw-not-digest\", literal: `tier-1 raw evidence \"bogus\" is not a digest`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n71|\t\t\tinput.Tier1[0].Raw = \"bogus\"\n72|\t\t\tinput.Tier1[0].Exclusion = \"\"\n73|\t\t}},\n74|\t\t{name: \"tier1-raw-twice\", literal: `tier-1 raw evidence \"` + raw0 + `\" is claimed twice`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n75|\t\t\tinput.Tier1[1].Raw = input.Tier1[0].Raw\n76|\t\t}},\n77|\t\t{name: \"tier1-bad-exclusion\", literal: `tier-1 exclusion \"frobnicate\" is outside the capture classes`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n78|\t\t\tinput.Tier1[3].Exclusion = \"frobnicate\"\n79|\t\t}},\n80|\t\t// Tier 2.\n81|\t\t{name: \"tier2-raw-not-digest\", literal: `tier-2 raw item \"bogus\" is not a digest`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n82|\t\t\tinput.Tier2[0].Raw = \"bogus\"\n83|\t\t}},\n84|\t\t{name: \"tier2-unknown-raw\", literal: `tier-2 link names unreconciled raw item \"` + phantom + `\"`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n85|\t\t\tinput.Tier2[0].Raw = phantom\n86|\t\t}},\n87|\t\t{name: \"tier2-twice\", literal: `tier-2 raw item \"` + raw0 + `\" reconciles twice`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n88|\t\t\tinput.Tier2 = append(input.Tier2, input.Tier2[0])\n89|\t\t}},\n90|\t\t{name: \"tier2-both\", literal: `tier-2 raw item \"` + raw0 + `\" claims both a canonical item and a normalization disposition`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n91|\t\t\tinput.Tier2[0].Normalization = \"omitted\"\n92|\t\t}},\n93|\t\t{name: \"tier2-neither\", literal: `tier-2 raw item \"` + raw0 + `\" has neither a canonical item nor a normalization disposition`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n94|\t\t\tinput.Tier2[0].Canonical = \"\"\n95|\t\t\tinput.Tier2[0].Normalization = \"\"\n96|\t\t}},\n97|\t\t{name: \"tier2-canon-not-digest\", literal: `tier-2 canonical item \"bogus\" is not a digest`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n98|\t\t\tinput.Tier2[0].Canonical = \"bogus\"\n99|\t\t}},\n100|\t\t{name: \"tier2-canon-twice\", literal: `tier-2 canonical item \"` + canon0 + `\" is claimed twice`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n101|\t\t\tinput.Tier2[1].Canonical = input.Tier2[0].Canonical\n102|\t\t}},\n103|\t\t{name: \"tier2-bad-normalization\", literal: `tier-2 normalization \"frobnicate\" is outside the dispositions`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.ReconciliationInput) {\n104|\t\t\tinput.Tier2[2].Normalization = \"frobnicate\"\n105|\t\t}},\n106|\t\t{name: \"tier2-synth-normalization\", literal: `tier-2 raw item \"` + fixtureDigest(\"raw-cand-2\") + `\" normalizes to synthesized, which is sourceless`, mutate: func(t *testing.T, docs sharedWorldDocs, input *clonereconcile.Reco