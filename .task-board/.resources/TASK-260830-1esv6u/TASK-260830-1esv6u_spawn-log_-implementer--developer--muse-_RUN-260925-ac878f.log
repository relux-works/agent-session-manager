{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c625","stream":{"kind":"session","id":"01a0d602-12a6-7cb3-99d1-8d1cf4fb003f"},"sequence":365,"recorded_at":1780531400000725,"record_type":"event","durability":"durable","causation_id":"8384434d-9d62-45ba-bafd-be548807fde7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8384434d-9d62-45ba-bafd-be548807fde7","run_stream":{"kind":"run","id":"8384434d-9d62-45ba-bafd-be548807fde7"},"task_stream":{"kind":"task","id":"01a0d603-0883-72e3-98a6-785e3bda87ba"},"task_id":"01a0d603-0883-72e3-98a6-785e3bda87ba","event":{"kind":"output","task_id":"01a0d603-0883-72e3-98a6-785e3bda87ba","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/clonereconcile/reconcile.go`.\n1|package clonereconcile\n2|\n3|import (\n4|\t\"sort\"\n5|\t\"unicode/utf8\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/clonefidelity\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/cloneplan\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/clonereadback\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n14|)\n15|\n16|// CandidateLink reconciles one captured candidate at tier 1: exactly\n17|// one of Raw (a raw-evidence digest) or Exclusion (a capture class)\n18|// is set. Both set is double-counted; neither set is a missing\n19|// link.\n20|type CandidateLink struct {\n21|\tCandidate string\n22|\tRaw       string\n23|\tExclusion string\n24|}\n25|\n26|// RawLink reconciles one raw item at tier 2: exactly one of\n27|// Canonical (a canonical-object digest) or Normalization (a\n28|// non-synthesized fidelity disposition) is set.\n29|type RawLink struct {\n30|\tRaw           string\n31|\tCanonical     string\n32|\tNormalization string\n33|}\n34|\n35|// History is one sealed staged/live read-back pair: the target\n36|// history ReadBackHistory decoded through the read-back owner. Only\n37|// sealed reads reconcile; the zero value seals nothing and every\n38|// pairing gate refuses it.\n39|type History struct {\n40|\tStaged clonereadback.ValidatedReadBack\n41|\tLive   clonereadback.ValidatedReadBack\n42|}\n43|\n44|// ValidationFields carries the caller-supplied validation-report\n45|// members Reconcile passes to the report owner. The staged/live\n46|// manifest references, the plan/projected references, and the\n47|// fidelity reference are derived by construction from the sealed\n48|// reads and the derived reports, never carried. Valid is decided by\n49|// the owner: the entry attempts true, then false, and exactly one\n50|// seals.\n51|type ValidationFields struct {\n52|\tOperationID                 string\n53|\tProviderManifestID          string\n54|\tExpectedTargetNativeSession string\n55|\tObservedTargetNativeSession string\n56|\tTargetEnvironment           []byte\n57|\tChecks                      clonereadback.ValidationChecks\n58|\tFindings                    []byte\n59|\tExtensions                  map[string]any\n60|\tExpectedFidelityReportID    string\n61|}\n62|\n63|// ReconciliationInput is the caller-supplied reconciliation\n64|// candidate. Candidates with Tier1/Tier2 link it at tiers 1-2;\n65|// Fidelity.Rows links it at tier 3; History pairs target evidence;\n66|// Plan and Projected pair the projection inputs.\n67|type ReconciliationInput struct {\n68|\tCandidates []string\n69|\tTier1      []CandidateLink\n70|\tTier2      []RawLink\n71|\tFidelity   clonefidelity.FidelityReportInput\n72|\tHistory    History\n73|\tPlan       []byte\n74|\tProjected  []byte\n75|\tValidation ValidationFields\n76|}\n77|\n78|// Reconciliation is the proven result: the derived report bytes,\n79|// the owner-decided valid bit, and the tier census counts.\n80|type Reconciliation struct {\n81|\tFidelityReport   []byte\n82|\tFidelityID       string\n83|\tValidationReport []byte\n84|\tValid            bool\n85|\tCandidates       int\n86|\tRawItems         int\n87|\tCanonicalItems   int\n88|\tRows             int\n89|}\n90|\n91|// ReadBackHistory reads back staged and live target history through\n92|// the landed read-back owner: both documents decode via\n93|// clonereadback.DecodeReadBackEvidenceManifest under their trusted\n94|// read authorities, and the pair seals only in staged/live order. A\n95|// swapped pair, a relabeled mode, or an authority the purpose does\n96|// not grant refuses; the owner decides every shape, seal, and\n97|// authority rule.\n98|func ReadBackHistory(stagedBytes, liveBytes []byte, stagedAuthority, liveAuthority sessadapter.ReadAuthority) (History, error) {\n99|\tstaged, err := clonereadback.DecodeReadBackEvidenceManifest(stagedBytes, stagedAuthority)\n100|\tif err != nil {\n101|\t\treturn History{}, refuse(\"staged read-back invalid: %v\", err)\n102|\t}\n103|\tlive, err := clonereadback.DecodeReadBackEvidenceManifest(liveBytes, liveAuthority)\n104|\tif err != nil {\n105|\t\treturn History{}, refuse(\"live read-back invalid: %v\", err)\n106|\t}\n107|\tif err := checkHistoryPair(staged, live); err != nil {\n108|\t\treturn History{}, err\n109|\t}\n110|\treturn History{Staged: staged, Live: live}, nil\n111|}\n112|\n113|// checkHistoryPair enforces that the first sealed read is staged\n114|// and the second is live. The zero value seals nothing: its mode\n115|// reads empty and refuses here before any pairing gate touches it.\n116|func checkHistoryPair(staged, live clonereadback.ValidatedReadBack) error {\n117|\tif staged.Mode() != \"staged\" {\n118|\t\treturn refuse(\"reconciliation staged read is not a staged manifest\")\n119|\t}\n120|\tif live.Mode() != \"live\" {\n121|\t\treturn refuse(\"reconciliation live read is not a live manifest\")\n122|\t}\n123|\treturn nil\n124|}\n125|\n126|// Reconcile proves reconciliation completeness over the three\n127|// tiers and derives both reports through their owners:\n128|//\n129|//   - tier 1: every captured candidate reconciles exactly once to\n130|//     raw evidence or to a capture-class exclusion;\n131|//   - tier 2: every raw item reconciles exactly once to a canonical\n132|//     item or to a non-synthesized normalization disposition;\n133|//   - tier 3: every included candidate and every canonical item\n134|//     occurs in exactly one non-synthesized fidelity row, and every\n135|//     non-loss row resolves staged/live target evidence into the\n136|//     sealed reads while every loss row carries explicit loss with\n137|//     no evidence claim;\n138|//   - pairing: plan, projected manifest, fidelity report, and both\n139|//     reports' tuples bind the same target the reads observe.\n140|//\n141|// The fidelity report seals via clonefidelity, the plan and\n142|// projected inputs decode via cloneplan, and the validation report\n143|// seals via clonereadback, which alone decides the valid bit. Every\n144|// rule is a refusal with a literal code, never a repair.\n145|func Reconcile(input ReconciliationInput) (Reconciliation, error) {\n146|\tif input.Fidelity.Scope != \"target\" {\n147|\t\treturn Reconciliation{}, refuse(\"reconciliation needs a target fidelity report\")\n148|\t}\n149|\tincluded, rawSet, rawByCandidate, err := checkTier1(input.Candidates, input.Tier1)\n150|\tif err != nil {\n(more lines below)","final_result":true}}}
