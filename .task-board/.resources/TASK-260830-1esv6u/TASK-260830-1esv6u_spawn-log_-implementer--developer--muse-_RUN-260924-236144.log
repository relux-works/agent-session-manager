spaceJSON() string {\n37|\treturn `{\"logical_workspace_id\":\"` + fixtureWorkspaceID + `\",\"cwd_relative\":\"work/target\",\"repository_remote_fingerprints\":[],\"branch\":null,\"head_digest\":null,\"index_digest\":null,\"working_tree_digest\":null,\"extensions\":{}}`\n38|}\n39|\n40|func fixtureLimitsJSON() string {\n41|\treturn `{\"max_objects\":100,\"max_total_bytes\":1000000,\"max_single_object_bytes\":65536,\"max_events\":100,\"max_target_resources\":100}`\n42|}\n43|\n44|func strptr(value string) *string { return &value }\n45|\n46|func u64ptr(value uint64) *uint64 { return &value }\n47|\n48|// validMappingInput returns a valid item mapping candidate.\n49|func validMappingInput(key string) cloneplan.ItemMappingInput {\n50|\treturn cloneplan.ItemMappingInput{\n51|\t\tSourceItemKey:     key,\n52|\t\tCanonicalObjectID: strptr(fixtureDigest(\"canonical-\" + key)),\n53|\t\tTargetResourceKey: []string{\"res/\" + key},\n54|\t\tExpectedDispos:    \"exact\",\n55|\t\tReasonCodes:       []string{},\n56|\t\tExtensions:        map[string]any{},\n57|\t}\n58|}\n59|\n60|// validOperationInput returns a valid target operation candidate.\n61|func validOperationInput(sequence uint64, depends ...uint64) cloneplan.TargetOperationInput {\n62|\treturn cloneplan.TargetOperationInput{\n63|\t\tSequence:           sequence,\n64|\t\tAction:             \"write_blob\",\n65|\t\tResourceKeys:       []string{\"res/op\"},\n66|\t\tDependsOnSequences: depends,\n67|\t\tExtensions:         map[string]any{},\n68|\t}\n69|}\n70|\n71|// validResourceInput returns a valid expected blob resource.\n72|func validResourceInput(sequence uint64, key string) cloneplan.ExpectedResourceInput {\n73|\treturn cloneplan.ExpectedResourceInput{\n74|\t\tOperationSequence: sequence,\n75|\t\tResourceKey:       key,\n76|\t\tKind:              \"blob\",\n77|\t\tMode:              nil,\n78|\t\tExpectedBlobID:    strptr(fixtureDigest(\"blob-\" + key)),\n79|\t\tExtensions:        map[string]any{},\n80|\t}\n81|}\n82|\n83|// validDirectoryResourceInput returns a valid expected directory\n84|// resource.\n85|func validDirectoryResourceInput(sequence uint64, key string) cloneplan.ExpectedResourceInput {\n86|\treturn cloneplan.ExpectedResourceInput{\n87|\t\tOperationSequence: sequence,\n88|\t\tResourceKey:       key,\n89|\t\tKind:              \"directory\",\n90|\t\tMode:              u64ptr(0755),\n91|\t\tExpectedBlobID:    nil,\n92|\t\tExtensions:        map[string]any{},\n93|\t}\n94|}\n95|\n96|// validSynthEventInput returns a valid synthesized event candidate.\n97|func validSynthEventInput(seed string) cloneplan.SynthesizedEventInput {\n98|\treturn cloneplan.SynthesizedEventInput{\n99|\t\tCanonicalEventID:    fixtureDigest(\"synth-\" + seed),\n100|\t\tInsertionAfterEvent: strptr(fixtureDigest(\"anchor-\" + seed)),\n101|\t\tPurpose:             \"summary\",\n102|\t\tExtensions:          map[string]any{},\n103|\t}\n104|}\n105|\n106|func validTransactionInput() cloneplan.TransactionPlanInput {\n107|\treturn cloneplan.TransactionPlanInput{\n108|\t\tMaterializationIntent: \"clone\",\n109|\t\tTargetCollisionPolicy: \"must_be_absent\",\n110|\t\tActivation:            \"dormant_validated\",\n111|\t\tExtensions:            map[string]any{},\n112|\t}\n113|}\n114|\n115|func validReadBackInput() cloneplan.ReadBackPlanInput {\n116|\treturn cloneplan.ReadBackPlanInput{\n117|\t\tModes:                 []string{\"staged\", \"live\"},\n118|\t\tRequireIdentityMatch:  true,\n119|\t\tRequireWorkspaceMatch: true,\n120|\t\tRequireSemanticMarker: true,\n121|\t\tExtensions:            map[string]any{},\n122|\t}\n123|}\n124|\n125|func validResumeInput() cloneplan.ResumePlanInput {\n126|\treturn cloneplan.ResumePlanInput{\n127|\t\tOpensExistingIdentity:           true,\n128|\t\tAllowBlankFallback:              false,\n129|\t\tBoundedContinuationTurnRequired: true,\n130|\t\tExtensions:                      map[string]any{},\n131|\t}\n132|}\n133|\n134|func validRollbackInput() cloneplan.RollbackPlanInput {\n135|\treturn cloneplan.RollbackPlanInput{\n136|\t\tRequired:                     true,\n137|\t\tRetainThrough:                \"live_validated\",\n138|\t\tForbiddenAfterProviderCommit: true,\n139|\t\tExtensions:                   map[string]any{},\n140|\t}\n141|}\n142|\n143|func validContractInput(id string) cloneplan.ContractRequirementInput {\n144|\treturn cloneplan.ContractRequirementInput{ContractID: id, Version: \"1.2.3\"}\n145|}\n146|\n147|// validPlanInput returns a valid projection plan candidate: one\n148|// mapping, one operation, one blob resource, no synthesized events,\n149|// one contract, one capability.\n150|func validPlanInput() cloneplan.ProjectionPlanInput {\n151|\treturn cloneplan.ProjectionPlanInput{\n152|\t\tOperationID:                 fixtureOperationID,\n153|\t\tBundleID:                    fixtureBundleID,\n154|\t\tRequestDigest:               fixtureDigest(\"request\"),\n155|\t\tSourceSnapshotDigest:        fixtureDigest(\"snapshot\"),\n156|\t\tCaptureManifestID:           fixtureDigest(\"capture\"),\n157|\t\tCanonicalSessionID:          fixtureDigest(\"canonical\"),\n158|\t\tCanonicalEventIDs:           []string{},\n159|\t\tSourceEnvironment:           []byte(fixtureTupleJSON()),\n160|\t\tTargetEnvironment:           []byte(fixtureTupleJSON()),\n161|\t\tExpectedTargetNativeSession: \"target-native-session\",\n162|\t\tTargetWorkspace:             []byte(fixtureWorkspaceJSON()),\n163|\t\tStrategy:                    \"target_native_writer\",\n164|\t\tStrategyRationale:           \"native writer covers the target tuple\",\n165|\t\tFidelityProfile:             \"maximal_safe\",\n166|\t\tRequiredDispositions:        map[string][]string{\"durable_payload\": {\"exact\"}},\n167|\t\tForbidReasons:               []string{},\n168|\t\tItemMappings:                []cloneplan.ItemMappingInput{validMappingInput(\"a-item\")},\n169|\t\tTargetOperations:            []cloneplan.TargetOperationInput{validOperationInput(1)},\n170|\t\tExpectedResources:           []cloneplan.ExpectedResourceInput{validResourceInput(1, \"a-res\")},\n171|\t\tSynthesizedEvents:           []cloneplan.SynthesizedEventInput{},\n172|\t\tSecurityExclusions:          []string{},\n173|\t\tResourceLimits:              []byte(fixtureLimitsJSON()),\n174|\t\tTransactionPlan:             validTransactionInput(),\n175|\t\tReadBackPlan:                validReadBackInput(),\n176|\t\tResumePlan:                  validResumeInput(),\n177|\t\tRollbackPlan:                validRollbackInput(),\n178|\t\tRequiredContracts:           []cloneplan.ContractRequirementInput{validContractInput(\"ax.contract.plan\")},\n179|\t\tRequiredCapabilities:        []string{\"clone.target.write\"},\n180|\t\tFidelityBasisDigest:         fixtureDigest(\"basis\"),\n181|\t\tSourceAdapterBuildDigest:    fixtureDigest(\"source-build\"),\n182|\t\tTargetAdapterBuildDigest:    fixtureDigest(\"target-build\"),\n183|\t\tControllerBuildDigest:       fixtureDigest(\"controller-build\"),\n184|\t\tExtensions:                  map[string]any{},\n185|\t}\n186|}\n187|\n188|// validBlobEntryInput returns a valid blob manifest entry.\n189|func validBlobEntryInput(sequence uint64, key string) cloneplan.ProjectedEntryInput {\n190|\treturn cloneplan.ProjectedEntryInput{\n191|\t\tOperationSequence: sequence,\n192|\t\tResourceKey:       key,\n193|\t\tKind:              \"blob\",\n194|\t\tMode:              nil,\n195|\t\tByteCount:         u64ptr(128),\n196|\t\tBlobID:            strptr(fixtureDigest(\"blob-\" + key)),\n197|\t\tBlobDescriptorID:  strptr(fixtureDigest(\"descriptor-\" + key)),\n198|\t}\n199|}\n200|\n201|// validDirectoryEntryInput returns a valid directory manifest\n202|// entry.\n203|func validDirectoryEntryInput(sequence uint64, key string) cloneplan.ProjectedEntryInput {\n204|\treturn cloneplan.ProjectedEntryInput{\n205|\t\tOperationSequence: sequence,\n206|\t\tResourceKey:       key,\n207|\t\tKind:              \"directory\",\n208|\t\tMode:              u64ptr(0755),\n209|\t}\n210|}\n211|\n212|// validManifestInput returns a valid projected manifest candidate.\n213|func validManifestInput() cloneplan.ProjectedManifestInput {\n214|\treturn cloneplan.ProjectedManifestInput{\n215|\t\tOperationID:                 fixtureOperationID,\n216|\t\tProjectionPlanID:            fixtureDigest(\"plan-id\"),\n217|\t\tTargetEnvironment:           []byte(fixtureTupleJSON()),\n218|\t\tExpectedTargetNativeSession: \"target-native-session\",\n219|\t\tEntries: []cloneplan.ProjectedEntryInput{\n220|\t\t\tvalidDirectoryEntryInput(1, \"a-dir\"),\n221|\t\t\tvalidBlobEntryInput(1, \"b-blob\"),\n222|\t\t},\n223|\t\tTotalBytes: 128,\n224|\t\tExtensions: map[string]any{},\n225|\t}\n226|}\n227|\n228|func mustBuildPlan(t *testing.T, input cloneplan.ProjectionPlanInput) []byte {\n229|\tt.Helper()\n230|\tsealed, err := cloneplan.BuildProjectionPlan(input)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
