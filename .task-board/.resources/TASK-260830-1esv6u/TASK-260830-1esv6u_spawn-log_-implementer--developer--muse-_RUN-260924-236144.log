{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c69b","stream":{"kind":"session","id":"01a0d595-9c87-7b41-8174-a6b1261d78d7"},"sequence":424,"recorded_at":1780531400000843,"record_type":"event","durability":"durable","causation_id":"3f52b624-2d68-419d-80a5-f0df2f588e41","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"3f52b624-2d68-419d-80a5-f0df2f588e41","run_stream":{"kind":"run","id":"3f52b624-2d68-419d-80a5-f0df2f588e41"},"call_id":"call_01a0d596c7497046ae2cbef85ef98989","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/clonereadback/readback.go`.\n1|package clonereadback\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"fmt\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n10|)\n11|\n12|// This file validates and constructs Clone Read-Back Evidence\n13|// Manifest 1.0.0: the closed 15-member manifest Section 13.14.2\n14|// states, binding operation, staged|live mode, plan and projected\n15|// manifest, equal expected/observed native Session IDs, observed\n16|// tuple, parsed count/heads, Workspace Binding, structural digest,\n17|// and sorted evidence blobs. The mode is derived from the trusted\n18|// read authority the caller threads from its authority chain and\n19|// the manifest claim must agree with it: a resealed opposite mode\n20|// refuses as an authority mismatch even though its self-digest\n21|// recomputes, because the digest alone does not carry the stage.\n22|// Staged and live manifests are distinct documents, never two\n23|// readings of one.\n24|\n25|const (\n26|\treadBackSchema   = \"urn:ax:schema:clone-read-back-evidence-manifest\"\n27|\treadBackVersion  = \"1.0.0\"\n28|\treadBackSelf     = \"read_back_evidence_manifest_id\"\n29|\tmaxEvidenceRows  = 65536\n30|\tmaxParsedHeadIDs = 1024\n31|)\n32|\n33|var readBackMembers = map[string]bool{\n34|\t\"schema\": true, \"schema_version\": true,\n35|\t\"read_back_evidence_manifest_id\": true, \"operation_id\": true,\n36|\t\"mode\": true, \"projection_plan_id\": true,\n37|\t\"projected_object_manifest_id\":      true,\n38|\t\"expected_target_native_session_id\": true,\n39|\t\"observed_target_native_session_id\": true,\n40|\t\"observed_environment\":              true,\n41|\t\"parsed_event_count\":                true,\n42|\t\"parsed_head_ids\":                   true,\n43|\t\"workspace_binding\":                 true,\n44|\t\"structural_digest\":                 true,\n45|\t\"evidence_objects\":                  true, \"extensions\": true,\n46|}\n47|\n48|var readBackRequired = []string{\n49|\t\"schema\", \"schema_version\",\n50|\t\"read_back_evidence_manifest_id\", \"operation_id\",\n51|\t\"mode\", \"projection_plan_id\",\n52|\t\"projected_object_manifest_id\",\n53|\t\"expected_target_native_session_id\",\n54|\t\"observed_target_native_session_id\",\n55|\t\"observed_environment\",\n56|\t\"parsed_event_count\",\n57|\t\"parsed_head_ids\",\n58|\t\"workspace_binding\",\n59|\t\"structural_digest\",\n60|\t\"evidence_objects\", \"extensions\",\n61|}\n62|\n63|var evidenceMembers = map[string]bool{\n64|\t\"evidence_kind\": true, \"media_type\": true,\n65|\t\"byte_count\": true, \"blob_id\": true,\n66|\t\"blob_descriptor_id\": true,\n67|}\n68|\n69|var evidenceRequired = []string{\n70|\t\"evidence_kind\", \"media_type\",\n71|\t\"byte_count\", \"blob_id\",\n72|\t\"blob_descriptor_id\",\n73|}\n74|\n75|// EvidenceObject is one validated evidence row: the closed kind, a\n76|// media type, a byte count, and the blob pair.\n77|type EvidenceObject struct {\n78|\tEvidenceKind     string\n79|\tMediaType        string\n80|\tByteCount        uint64\n81|\tBlobID           scalar.Digest\n82|\tBlobDescriptorID scalar.Digest\n83|}\n84|\n85|// EvidenceObjectInput is the caller-supplied evidence row candidate\n86|// for Build.\n87|type EvidenceObjectInput struct {\n88|\tEvidenceKind     string\n89|\tMediaType        string\n90|\tByteCount        uint64\n91|\tBlobID           string\n92|\tBlobDescriptorID string\n93|}\n94|\n95|// ReadBackManifest is one validated Clone Read-Back Evidence\n96|// Manifest 1.0.0.\n97|type ReadBackManifest struct {\n98|\tManifestID                  scalar.Digest\n99|\tOperationID                 scalar.UUIDv7\n100|\tMode                        string\n101|\tProjectionPlanID            scalar.Digest\n102|\tProjectedObjectManifestID   scalar.Digest\n103|\tExpectedTargetNativeSession string\n104|\tObservedTargetNativeSession string\n105|\tObservedEnvironment         sessadapter.Tuple\n106|\tParsedEventCount            uint64\n107|\tParsedHeadIDs               []string\n108|\tWorkspaceBinding            clonebundle.WorkspaceBinding\n109|\tStructuralDigest            scalar.Digest\n110|\tEvidenceObjects             []EvidenceObject\n111|}\n112|\n113|// ReadBackManifestInput is the caller-supplied read-back manifest\n114|// candidate for Build. Nested closed shapes (observed tuple,\n115|// workspace binding) arrive as raw JSON and decode through their\n116|// owners; extensions arrive as a Go map and seal through the\n117|// closed-extensions owner.\n118|type ReadBackManifestInput struct {\n119|\tOperationID                 string\n120|\tMode                        string\n121|\tProjectionPlanID            string\n122|\tProjectedObjectManifestID   string\n123|\tExpectedTargetNativeSession string\n124|\tObservedTargetNativeSession string\n125|\tObservedEnvironment         []byte\n126|\tParsedEventCount            uint64\n127|\tParsedHeadIDs               []string\n128|\tWorkspaceBinding            []byte\n129|\tStructuralDigest            string\n130|\tEvidenceObjects             []EvidenceObjectInput\n131|\tExtensions                  map[string]any\n132|}\n133|\n134|// buildEvidenceObject validates one caller-supplied evidence row\n135|// and renders its closed object.\n136|func buildEvidenceObject(input EvidenceObjectInput, index int) (EvidenceObject, map[string]any, error) {\n137|\towner := fmt.Sprintf(\"evidence object[%d]\", index)\n138|\tif !validText(input.EvidenceKind) {\n139|\t\treturn EvidenceObject{}, nil, invalid(\"%s evidence_kind is not valid UTF-8\", owner)\n140|\t}\n141|\tif !ValidEvidenceKind(input.EvidenceKind) {\n142|\t\treturn EvidenceObject{}, nil, invalid(\"%s evidence_kind is outside native_sample|parser_trace|marker_observation\", owner)\n143|\t}\n144|\tif !validText(input.MediaType) {\n145|\t\treturn EvidenceObject{}, nil, invalid(\"%s media_type is not valid UTF-8\", owner)\n146|\t}\n147|\tif length := stringLength(input.MediaType); length < 1 || length > 128 {\n148|\t\treturn EvidenceObject{}, nil, invalid(\"%s media_type is not a string[1..128]\", owner)\n149|\t}\n150|\tif input.ByteCount > maxUint53 {\n151|\t\treturn EvidenceObject{}, nil, invalid(\"%s byte_count exceeds uint53\", owner)\n152|\t}\n153|\tblob, err := scalar.ParseDigest(input.BlobID)\n154|\tif err != nil {\n155|\t\treturn EvidenceObject{}, nil, invalid(\"%s blob_id is not a digest: %v\", owner, err)\n156|\t}\n157|\tdescriptor, err := scalar.ParseDigest(input.BlobDescriptorID)\n158|\tif err != nil {\n159|\t\treturn EvidenceObject{}, nil, invalid(\"%s blob_descriptor_id is not a digest: %v\", owner, err)\n160|\t}\n161|\trow := EvidenceObject{\n162|\t\tEvidenceKind:     input.EvidenceKind,\n163|\t\tMediaType:        input.MediaType,\n164|\t\tByteCount:        input.ByteCount,\n165|\t\tBlobID:           blob,\n166|\t\tBlobDescriptorID: descriptor,\n167|\t}\n168|\tobject := map[string]any{\n169|\t\t\"evidence_kind\":      input.EvidenceKind,\n170|\t\t\"media_type\":         input.MediaType,\n171|\t\t\"byte_count\":         input.ByteCount,\n172|\t\t\"blob_id\":            blob.String(),\n173|\t\t\"blob_descriptor_id\": descriptor.String(),\n174|\t}\n175|\treturn row, object, nil\n176|}\n177|\n178|// decodeEvidenceObject validates one closed EvidenceObject.\n179|func decodeEvidenceObject(raw json.RawMessage, index int) (EvidenceObject, error) {\n180|\towner := \"evidence object\"\n181|\tmembers, fault := decodeStrictObject(raw)\n182|\tif fault != nil {\n183|\t\treturn EvidenceObject{}, invalid(\"%s[%d] %s (%s)\", owner, index, fault.detail, memberField(fault.member))\n184|\t}\n185|\tif name, unknown := unknownMember(members, evidenceMembers); unknown {\n186|\t\treturn EvidenceObject{}, invalid(\"%s[%d] carries unknown member %q\", owner, index, name)\n187|\t}\n188|\tif name, missing := missingMember(members, evidenceRequired); missing {\n189|\t\treturn EvidenceObject{}, invalid(\"%s[%d] misses a required member %q\", owner, index, name)\n190|\t}\n191|\tkind, ok := rawString(members[\"evidence_kind\"])\n192|\tif !ok || !ValidEvidenceKind(kind) {\n193|\t\treturn EvidenceObject{}, invalid(\"%s[%d] evidence_kind is outside native_sample|parser_trace|marker_observation\", owner, index)\n194|\t}\n195|\tmedia, ok := checkStringBounds(members[\"media_type\"], 1, 128)\n196|\tif !ok {\n197|\t\treturn EvidenceObject{}, invalid(\"%s[%d] media_type is not a string[1..128]\", owner, index)\n198|\t}\n199|\tcount, ok := checkUint53Bounds(members[\"byte_count\"], 0, maxUint53)\n200|\tif !ok {\n201|\t\treturn EvidenceObject{}, invalid(\"%s[%d] byte_count is not a uint53\", owner, index)\n202|\t}\n203|\tblob, ok := checkDigest(members[\"blob_id\"])\n204|\tif !ok {\n205|\t\treturn EvidenceObject{}, invalid(\"%s[%d] blob_id is not a digest\", owner, index)\n206|\t}\n207|\tdescriptor, ok := checkDigest(members[\"blob_descriptor_id\"])\n208|\tif !ok {\n209|\t\treturn EvidenceObject{}, invalid(\"%s[%d] blob_descriptor_id is not a digest\", owner, index)\n210|\t}\n211|\treturn EvidenceObject{\n212|\t\tEvidenceKind:     kind,\n213|\t\tMediaType:        media,\n214|\t\tByteCount:        count,\n215|\t\tBlobID:           blob,\n216|\t\tBlobDescriptorID: descriptor,\n217|\t}, nil\n218|}\n219|\n220|// checkEvidenceOrder enforces \"sorted unique by evidence kind/blob\n221|// ID\": the (kind, blob ID) pairs are strictly increasing in\n222|// bytewise string order. Both entries share this gate over the\n223|// sealed row set.\n224|func checkEvidenceOrder(rows []EvidenceObject) error {\n225|\tfor index := 1; index < len(rows); index++ {\n226|\t\tprevious := rows[index-1]\n227|\t\tcurrent := rows[index]\n228|\t\tif current.EvidenceKind < previous.EvidenceKind ||\n229|\t\t\t(current.EvidenceKind == previous.EvidenceKind && current.BlobID.String() <= previous.BlobID.String()) {\n230|\t\t\treturn invalid(\"read-back evidence manifest evidence_objects are not sorted unique by evidence kind/blob ID\")\n231|\t\t}\n232|\t}\n233|\treturn nil\n234|}\n235|\n236|// checkEvidenceCount enforces the evidence cardinality bound\n237|// EvidenceObject[0..65536]. The gate is factored so the exact upper\n238|// edge pins at the gate while row reachability pins at both\n239|// entries.\n240|func checkEvidenceCount(count int) error {\n241|\tif count < 0 || count > maxEvidenceRows {\n242|\t\treturn invalid(\"read-back evidence manifest carries %d evidence_objects, want [0..65536]\", count)\n243|\t}\n244|\treturn nil\n245|}\n246|\n247|// checkNativeIdentityMatch enforces the pinned equality of the two\n248|// native Session IDs: the observed target session is the expected\n249|// one, never a neighbor. Both entries share this gate.\n250|func checkNativeIdentityMatch(expected, observed string) error {\n251|\tif expected != observed {\n252|\t\treturn invalid(\"read-back evidence manifest expected and observed native Session IDs differ\")\n253|\t}\n254|\treturn nil\n255|}\n256|\n257|// BuildReadBackEvidenceManifest constructs one closed Clone\n258|// Read-Back Evidence Manifest 1.0.0 as canonical bytes. Identical\n259|// inputs produce byte-identical outputs. The authority carries the\n260|// trusted read purpose from the caller chain; the claimed mode\n261|// must agree with the mode that purpose derives, or the build\n262|// refuses as a relabel. Every closed-shape, mode, equality,\n263|// order, and vocabulary rule is a refusal, never a repair. On\n264|// success the entry also mints the sealed read the report\n265|// entries aggregate: the sealed value carries this seal's\n266|// omit-self digest and authority-derived mode.\n267|func BuildReadBackEvidenceManifest(input ReadBackManifestInput, authority sessadapter.ReadAuthority) (ValidatedReadBack, []byte, error) {\n268|\tmanifest, object, err := buildReadBackManifest(input, authority)\n269|\tif err != nil {\n270|\t\treturn ValidatedReadBack{}, nil, err\n271|\t}\n272|\tomitted, err := canonicalizeObject(object)\n273|\tif err != nil {\n274|\t\treturn ValidatedReadBack{}, nil, err\n275|\t}\n276|\tmanifestID := scalar.SHA256Digest(omitted)\n277|\tobject[readBackSelf] = manifestID.String()\n278|\tsealed, err := canonicalizeObject(object)\n279|\tif err != nil {\n280|\t\treturn ValidatedReadBack{}, nil, err\n281|\t}\n282|\tmanifest.ManifestID = manifestID\n283|\treturn sealReadBack(manifest), sealed, nil\n284|}\n285|\n286|func buildReadBackManifest(input ReadBackManifestInput, authority sessadapter.ReadAuthority) (ReadBackManifest, map[string]any, error) {\n287|\towner := \"read-back evidence manifest\"\n288|\toperation, err := scalar.ParseUUIDv7(input.OperationID)\n289|\tif err != nil {\n290|\t\treturn ReadBackManifest{}, nil, invalid(\"%s operation_id is not a UUIDv7: %v\", owner, err)\n291|\t}\n292|\tif !validText(input.Mode) {\n293|\t\treturn ReadBackManifest{}, nil, invalid(\"%s mode is not valid UTF-8\", owner)\n294|\t}\n295|\tif !ValidReadBackMode(input.Mode) {\n296|\t\treturn ReadBackManifest{}, nil, invalid(\"%s mode is outside staged|live\", owner)\n297|\t}\n298|\texpectedMode, err := modeForAuthorityPurpose(authority.Purpose)\n299|\tif err != nil {\n300|\t\treturn ReadBackManifest{}, nil, err\n301|\t}\n302|\tif err := checkModeAuthority(owner, input.Mode, expectedMode, authority.Purpose); err != nil {\n303|\t\treturn ReadBackManifest{}, nil, err\n304|\t}\n305|\tplanID, err := scalar.ParseDigest(input.ProjectionPlanID)\n306|\tif err != nil {\n307|\t\treturn ReadBackManifest{}, nil, invalid(\"%s projection_plan_id is not a digest: %v\", owner, err)\n308|\t}\n309|\tmanifestID, err := scalar.ParseDigest(input.ProjectedObjectManifestID)\n310|\tif err != nil {\n311|\t\treturn ReadBackManifest{}, nil, invalid(\"%s projected_object_manifest_id is not a digest: %v\", owner, err)\n312|\t}\n313|\tif !validText(input.ExpectedTargetNativeSession) {\n314|\t\treturn ReadBackManifest{}, nil, invalid(\"%s expected_target_native_session_id is not valid UTF-8\", owner)\n315|\t}\n316|\tif length := stringLength(input.ExpectedTargetNativeSession); length < 1 || length > 512 {\n317|\t\treturn ReadBackManifest{}, nil, invalid(\"%s expected_target_native_session_id is not a string[1..512]\", owner)\n318|\t}\n319|\tif !validText(input.ObservedTargetNativeSession) {\n320|\t\treturn ReadBackManifest{}, nil, invalid(\"%s observed_target_native_session_id is not valid UTF-8\", owner)\n321|\t}\n322|\tif length := stringLength(input.ObservedTargetNativeSession); length < 1 || length > 512 {\n323|\t\treturn ReadBackManifest{}, nil, invalid(\"%s observed_target_native_session_id is not a string[1..512]\", owner)\n324|\t}\n325|\tif err := checkNativeIdentityMatch(input.ExpectedTargetNativeSession, input.ObservedTargetNativeSession); err != nil {\n326|\t\treturn ReadBackManifest{}, nil, err\n327|\t}\n328|\tobservedTuple, err := sessadapter.DecodeTuple(json.RawMessage(input.ObservedEnvironment))\n329|\tif err != nil {\n330|\t\treturn ReadBackManifest{}, nil, invalid(\"%s observed_environment is not an Environment Tuple: %v\", owner, err)\n331|\t}\n332|\tif input.ParsedEventCount > maxUint53 {\n333|\t\treturn ReadBackManifest{}, nil, invalid(\"%s parsed_event_count exceeds uint53\", owner)\n334|\t}\n335|\theads, err := checkSortedUniqueBoundedStrings(input.ParsedHeadIDs, 1, 512, 0, maxParsedHeadIDs, owner, \"parsed_head_ids\")\n336|\tif err != nil {\n337|\t\treturn ReadBackManifest{}, nil, err\n338|\t}\n339|\tbinding, err := clonebundle.DecodeWorkspaceBinding(json.RawMessage(input.WorkspaceBinding))\n340|\tif err != nil {\n341|\t\treturn ReadBackManifest{}, nil, invalid(\"%s workspace_binding is not a Workspace Binding: %v\", owner, err)\n342|\t}\n343|\tstructural, err := scalar.ParseDigest(input.StructuralDigest)\n344|\tif err != nil {\n345|\t\treturn ReadBackManifest{}, nil, invalid(\"%s structural_digest is not a digest: %v\", owner, err)\n346|\t}\n347|\tif err := checkEvidenceCount(len(input.EvidenceObjects)); err != nil {\n348|\t\treturn ReadBackManifest{}, nil, err\n349|\t}\n350|\trows := make([]EvidenceObject, 0, len(input.EvidenceObjects))\n351|\trowObjects := make([]any, 0, len(input.EvidenceObjects))\n352|\tfor index, candidate := range input.EvidenceObjects {\n353|\t\trow, object, err := buildEvidenceObject(candidate, index)\n354|\t\tif err != nil {\n355|\t\t\treturn ReadBackManifest{}, nil, err\n356|\t\t}\n357|\t\trows = append(rows, row)\n358|\t\trowObjects = append(rowObjects, object)\n359|\t}\n360|\tif err := checkEvidenceOrder(rows); err != nil {\n361|\t\treturn ReadBackManifest{}, nil, err\n362|\t}\n363|\textensions, err := clonebundle.EncodeExtensions(input.Extensions)\n364|\tif err != nil {\n365|\t\treturn ReadBackManifest{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n366|\t}\n367|\tvar extensionsValue any\n368|\tif err := json.Unmarshal(extensions, &extensionsValue); err != nil {\n369|\t\treturn ReadBackManifest{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n370|\t}\n371|\tmanifest := ReadBackManifest{\n372|\t\tOperationID:                 operation,\n373|\t\tMode:                        input.Mode,\n374|\t\tProjectionPlanID:            planID,\n375|\t\tProjectedObjectManifestID:   manifestID,\n376|\t\tExpectedTargetNativeSession: input.ExpectedTargetNativeSession,\n377|\t\tObservedTargetNativeSession: input.ObservedTargetNativeSession,\n378|\t\tObservedEnvironment:         observedTuple,\n379|\t\tParsedEventCount:            input.ParsedEventCount,\n380|\t\tParsedHeadIDs:               heads,\n381|\t\tWorkspaceBinding:            binding,\n382|\t\tStructuralDigest:            structural,\n383|\t\tEvidenceObjects:             rows,\n384|\t}\n385|\tobject := map[string]any{\n386|\t\t\"schema\":                            readBackSchema,\n387|\t\t\"schema_version\":                    readBackVersion,\n388|\t\t\"operation_id\":                      operation.String(),\n389|\t\t\"mode\":                              input.Mode,\n390|\t\t\"projection_plan_id\":                planID.String(),\n391|\t\t\"projected_object_manifest_id\":      manifestID.String(),\n392|\t\t\"expected_target_native_session_id\": input.ExpectedTargetNativeSession,\n393|\t\t\"observed_target_native_session_id\": input.ObservedTargetNativeSession,\n394|\t\t\"parsed_event_count\":                input.ParsedEventCount,\n395|\t\t\"parsed_head_ids\":                   stringValues(heads),\n396|\t\t\"structural_digest\":                 structural.String(),\n397|\t\t\"evidence_objects\":                  rowObjects,\n398|\t\t\"extensions\":                        extensionsValue,\n399|\t}\n400|\tvar tupleValue any\n401|\tif err := json.Unmarshal(input.ObservedEnvironment, &tupleValue); err != nil {\n402|\t\treturn ReadBackManifest{}, nil, invalid(\"%s observed_environment invalid: %v\", owner, err)\n403|\t}\n404|\tobject[\"observed_environment\"] = tupleValue\n405|\tvar bindingValue any\n406|\tif err := json.Unmarshal(input.WorkspaceBinding, &bindingValue); err != nil {\n407|\t\treturn ReadBackManifest{}, nil, invalid(\"%s workspace_binding invalid: %v\", owner, err)\n408|\t}\n409|\tobject[\"workspace_binding\"] = bindingValue\n410|\treturn manifest, object, nil\n411|}\n412|\n413|// DecodeReadBackEvidenceManifest validates one closed Clone\n414|// Read-Back Evidence Manifest 1.0.0: exact members, literal\n415|// schema/version, the closed mode bound to the trusted read\n416|// authority, equal native IDs, owner-decoded tuple and binding,\n417|// sorted heads and rows, and the omit-self identity. A relabeled\n418|// mode refuses as an authority mismatch even when the self-digest\n419|// recomputes. On success the entry mints the sealed read the\n420|// report entries aggregate.\n421|func DecodeReadBackEvidenceManifest(data []byte, authority sessadapter.ReadAuthority) (ValidatedReadBack, error) {\n422|\towner := \"read-back evidence manifest\"\n423|\tmembers, fault := decodeStrictObject(data)\n424|\tif fault != nil {\n425|\t\treturn ValidatedReadBack{}, invalid(\"%s %s (%s)\", owner, fault.detail, memberField(fault.member))\n426|\t}\n427|\tif name, unknown := unknownMember(members, readBackMembers); unknown {\n428|\t\treturn ValidatedReadBack{}, invalid(\"%s carries unknown member %q\", owner, name)\n429|\t}\n430|\tif name, missing := missingMember(members, readBackRequired); missing {\n431|\t\treturn ValidatedReadBack{}, invalid(\"%s misses a required member %q\", owner, name)\n432|\t}\n433|\tschema, ok := rawString(members[\"schema\"])\n434|\tif !ok || schema != readBackSchema {\n435|\t\treturn ValidatedReadBack{}, invalid(\"%s schema is not urn:ax:schema:clone-read-back-evidence-manifest\", owner)\n436|\t}\n437|\tversion, ok := rawString(members[\"schema_version\"])\n438|\tif !ok || version != readBackVersion {\n439|\t\treturn ValidatedReadBack{}, invalid(\"%s schema_version is not 1.0.0\", owner)\n440|\t}\n441|\tclaimed, ok := checkDigest(members[readBackSelf])\n442|\tif !ok {\n443|\t\treturn ValidatedReadBack{}, invalid(\"%s read_back_evidence_manifest_id is not a digest\", owner)\n444|\t}\n445|\toperation, ok := checkUUIDv7(members[\"operation_id\"])\n446|\tif !ok {\n447|\t\treturn ValidatedReadBack{}, invalid(\"%s operation_id is not a UUIDv7\", owner)\n448|\t}\n449|\tmode, ok := rawString(members[\"mode\"])\n450|\tif !ok || !ValidReadBackMode(mode) {\n451|\t\treturn ValidatedReadBack{}, invalid(\"%s mode is outside staged|live\", owner)\n452|\t}\n453|\texpectedMode, err := modeForAuthorityPurpose(authority.Purpose)\n454|\tif err != nil {\n455|\t\treturn ValidatedReadBack{}, err\n456|\t}\n457|\tif err := checkModeAuthority(owner, mode, expectedMode, authority.Purpose); err != nil {\n458|\t\treturn ValidatedReadBack{}, err\n459|\t}\n460|\tplanID, ok := checkDigest(members[\"projection_plan_id\"])\n461|\tif !ok {\n462|\t\treturn ValidatedReadBack{}, invalid(\"%s projection_plan_id is not a digest\", owner)\n463|\t}\n464|\tprojectedID, ok := checkDigest(members[\"projected_object_manifest_id\"])\n465|\tif !ok {\n466|\t\treturn ValidatedReadBack{}, invalid(\"%s projected_object_manifest_id is not a digest\", owner)\n467|\t}\n468|\texpected, ok := checkStringBounds(members[\"expected_target_native_session_id\"], 1, 512)\n469|\tif !ok {\n470|\t\treturn ValidatedReadBack{}, invalid(\"%s expected_target_native_session_id is not a string[1..512]\", owner)\n471|\t}\n472|\tobserved, ok := checkStringBounds(members[\"observed_target_native_session_id\"], 1, 512)\n473|\tif !ok {\n474|\t\treturn ValidatedReadBack{}, invalid(\"%s observed_target_native_session_id is not a string[1..512]\", owner)\n475|\t}\n476|\tif err := checkNativeIdentityMatch(expected, observed); err != nil {\n477|\t\treturn ValidatedReadBack{}, err\n478|\t}\n479|\tobservedTuple, err := sessadapter.DecodeTuple(members[\"observed_environment\"])\n480|\tif err != nil {\n481|\t\treturn ValidatedReadBack{}, invalid(\"%s observed_environment is not an Environment Tuple: %v\", owner, err)\n482|\t}\n483|\tparsedCount, ok := checkUint53Bounds(members[\"parsed_event_count\"], 0, maxUint53)\n484|\tif !ok {\n485|\t\treturn ValidatedReadBack{}, invalid(\"%s parsed_event_count is not a uint53\", owner)\n486|\t}\n487|\theads, ok := checkSortedUniqueStrings(members[\"parsed_head_ids\"], 1, 512, 0, maxParsedHeadIDs)\n488|\tif !ok {\n489|\t\treturn ValidatedReadBack{}, invalid(\"%s parsed_head_ids are not sorted unique string[1..512][0..1024]\", owner)\n490|\t}\n491|\tbinding, err := clonebundle.DecodeWorkspaceBinding(members[\"workspace_binding\"])\n492|\tif err != nil {\n493|\t\treturn ValidatedReadBack{}, invalid(\"%s workspace_binding is not a Workspace Binding: %v\", owner, err)\n494|\t}\n495|\tstructural, ok := checkDigest(members[\"structural_digest\"])\n496|\tif !ok {\n497|\t\treturn ValidatedReadBack{}, invalid(\"%s structural_digest is not a digest\", owner)\n498|\t}\n499|\trawRows, ok := decodeArray(members[\"evidence_objects\"])\n500|\tif !ok {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
