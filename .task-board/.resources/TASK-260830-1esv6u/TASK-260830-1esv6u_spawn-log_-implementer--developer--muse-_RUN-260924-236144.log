cs := sealSharedWorldDocs(t)\n+\tinput := gateBaseline(t, docs)\n+\tvar document map[string]any\n+\tif err := jsonUnmarshal(input.Plan, &document); err != nil {\n+\t\tt.Fatalf(\"decode plan: %v\", err)\n+\t}\n+\tdocument[\"strategy\"] = \"archive_only\"\n+\ttampered, err := jsonMarshal(document)\n+\tif err != nil {\n+\t\tt.Fatalf(\"marshal tampered plan: %v\", err)\n+\t}\n+\tinput.Plan = tampered\n+\t_, err = clonereconcile.Reconcile(input)\n+\trequireRefusal(t, err, \"projection plan invalid\")\n+}\n","edit_facts":{"tool_name":"edit_file","path":"/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/clonereconcile/gates_test.go","added":35,"removed":10},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
