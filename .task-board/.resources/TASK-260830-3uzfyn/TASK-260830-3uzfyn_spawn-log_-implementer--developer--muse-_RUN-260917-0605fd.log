{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ce99","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":1447,"recorded_at":1780531400002889,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"task_stream":{"kind":"task","id":"01a0add1-a941-7050-a766-6ec08340247c"},"task_id":"01a0add1-a941-7050-a766-6ec08340247c","event":{"kind":"output","task_id":"01a0add1-a941-7050-a766-6ec08340247c","chunk":"Read text file `internal/provhost/protocol.go`.\n(59 line(s) above)\n60|\tOpMaterializeStatus   Operation = \"materialize-status\"\n61|\tOpMaterializeCommit   Operation = \"materialize-commit\"\n62|\tOpMaterializeRollback Operation = \"materialize-rollback\"\n63|\tOpResume              Operation = \"resume\"\n64|\tOpFork                Operation = \"fork\"\n65|\tOpStop                Operation = \"stop\"\n66|\tOpDoctor              Operation = \"doctor\"\n67|)\n68|\n69|// operationOrder is the single construction site of the dispatch registry.\n70|var operationOrder = []Operation{\n71|\tOpManifest,\n72|\tOpProbe,\n73|\tOpLaunch,\n74|\tOpIdentifySession,\n75|\tOpQuiesce,\n76|\tOpNativeStorePlan,\n77|\tOpCapture,\n78|\tOpMaterialize,\n79|\tOpMaterializeStatus,\n80|\tOpMaterializeCommit,\n81|\tOpMaterializeRollback,\n82|\tOpResume,\n83|\tOpFork,\n84|\tOpStop,\n85|\tOpDoctor,\n86|}\n87|\n88|// Operations returns the dispatch registry in manifest order. The result\n89|// is a copy; the registry cannot be mutated through it.\n90|func Operations() []string {\n91|\tout := make([]string, 0, len(operationOrder))\n92|\tfor _, operation := range operationOrder {\n93|\t\tout = append(out, string(operation))\n94|\t}\n95|\treturn out\n96|}\n97|\n98|// validOperation reports whether the name is a registry member.\n99|func validOperation(name string) bool {\n100|\tfor _, operation := range operationOrder {\n101|\t\tif string(operation) == name {\n102|\t\t\treturn true\n103|\t\t}\n104|\t}\n105|\treturn false\n106|}\n107|\n108|// The refusal constructors below are declared as variables so the\n109|// inventory gate can observe every exercised refusal site. Each is the\n110|// single construction site for its failure class; production code must\n111|// not build *axerror.Error any other way.\n112|//\n113|// failInvalid reports a caller error caught before any process starts:\n114|// an unknown operation, a stale deadline, or an unframeable request body.\n115|// failProtocol reports an unusable plugin frame through the Section 15.1\n116|// provider-stdio otherwise branch. failMismatch reports a recognizable\n117|// major mismatch through the same table's mismatch branch, without\n118|// trusting the foreign payload. failProcess reports a crash or transport\n119|// failure. failTimeout reports a plugin that exceeded its request\n120|// deadline. failIntegrity reports a status observation that cannot be\n121|// reconciled to durable state.\n122|var failInvalid = func(detail string) (*axerror.Error, error) {\n123|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"invalid_config\", Message: \"provider host refused the request: \" + detail, Details: axerror.Details{}})\n124|}\n125|\n126|var failProtocol = func(detail string, member string) (*axerror.Error, error) {\n127|\treturn axerror.LocalFromUntrusted(axerror.SurfaceProviderStdio, axerror.OutcomeUnusableFrame, \"provider host rejected the plugin frame: \"+detail, axerror.NoIDs(), axerror.Details{\"member\": member}, nil)\n128|}\n129|\n130|var failMismatch = func(detail string, observed string) (*axerror.Error, error) {\n131|\treturn axerror.LocalFromUntrusted(axerror.SurfaceProviderStdio, axerror.OutcomeRecognizableMajorMismatch, \"provider host rejected a foreign protocol major: \"+detail, axerror.NoIDs(), axerror.Details{\"observed\": observed}, nil)\n132|}\n133|\n134|var failProcess = func(detail string, cause error) (*axerror.Error, error) {\n135|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"provider_process_failed\", Message: \"provider plugin process failed: \" + detail, Details: axerror.Details{}, Cause: cause})\n136|}\n137|\n138|var failTimeout = func(detail string, millis int64) (*axerror.Error, error) {\n139|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"provider_timeout\", Message: \"provider plugin exceeded its deadline: \" + detail, Details: axerror.Details{\"deadline_ms\": json.Number(strconv.FormatInt(millis, 10))}})\n140|}\n141|\n142|var failIntegrity = func(detail string, statusState string, materializationID string, transactionID string) (*axerror.Error, error) {\n143|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"integrity_failure\", Message: \"provider status observation is not durable state: \" + detail, Details: axerror.Details{\"status_state\": statusState, \"materialization_id\": materializationID, \"transaction_id\": transactionID}})\n144|}\n145|\n146|// Request is one Section 7.2 request envelope. Body crosses the transport\n147|// opaquely: it must be a JSON object, and its members are interpreted by\n148|// the operation layer, except for the status recovery read.\n149|type Request struct {\n150|\tOperation Operation\n151|\tRequestID scalar.UUIDv7\n152|\tDeadline  scalar.Timestamp\n153|\tBody      json.RawMessage\n154|}\n155|\n156|// Response is one accepted success envelope. Body is the raw\n157|// operation-specific object for the operation layer to interpret. A\n158|// failure envelope never produces a Response: DecodeResponse returns the\n159|// bound child error instead, and a failure envelope carrying a body is\n160|// refused outright.\n161|type Response struct {\n162|\tBody json.RawMessage\n163|}\n164|\n165|// wireRequest is the exact emitted member set: protocol, protocol_version,\n166|// request_id, operation, deadline, and body, in this fixed order.\n167|type wireRequest struct {\n168|\tProtocol        string           `json:\"protocol\"`\n169|\tProtocolVersion string           `json:\"protocol_version\"`\n170|\tRequestID       scalar.UUIDv7    `json:\"request_id\"`\n171|\tOperation       string           `json:\"operation\"`\n172|\tDeadline        scalar.Timestamp `json:\"deadline\"`\n173|\tBody            json.RawMessage  `json:\"body\"`\n174|}\n175|\n176|// EncodeRequest frames one request as a single JSONL line without the\n177|// terminator. The deadline must be in the future at now, which the caller\n178|// supplies so tests stay deterministic; Host passes its clock.\n179|func EncodeRequest(req Request, now time.Time) ([]byte, error) {\n180|\tframe, _, err := encodeFrame(req, now)\n181|\treturn frame, err\n182|}\n183|\n184|// encodeFrame validates and frames a request, also returning the parsed\n185|// deadline instant so Host.Call validates once at a single site.\n186|func encodeFrame(req Request, now time.Time) ([]byte, time.Time, error) {\n187|\tif !validOperation(string(req.Operation)) {\n188|\t\tfailure, err := failInvalid(\"unknown operation\")\n189|\t\tif err != nil {\n190|\t\t\treturn nil, time.Time{}, err\n191|\t\t}\n192|\t\treturn nil, time.Time{}, failure\n193|\t}\n194|\tif _, err := scalar.ParseUUIDv7(req.RequestID.String()); err != nil {\n195|\t\tfailure, fault := failInvalid(\"request_id is not a UUIDv7\")\n196|\t\tif fault != nil {\n197|\t\t\treturn nil, time.Time{}, fault\n198|\t\t}\n199|\t\treturn nil, time.Time{}, failure\n(more lines below)","final_result":true}}}
