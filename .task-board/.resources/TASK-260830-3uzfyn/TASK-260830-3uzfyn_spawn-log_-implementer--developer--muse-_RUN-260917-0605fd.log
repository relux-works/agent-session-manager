{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c791","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":547,"recorded_at":1780531400001089,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"task_stream":{"kind":"task","id":"01a0adcc-3ab0-7c31-bb1a-7a3f67753009"},"task_id":"01a0adcc-3ab0-7c31-bb1a-7a3f67753009","event":{"kind":"output","task_id":"01a0adcc-3ab0-7c31-bb1a-7a3f67753009","chunk":"Read text file `internal/sessstate/sessstate.go`.\n1|package sessstate\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|\t\"sort\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n10|)\n11|\n12|// SessionState spellings in SPEC.md Section 5.7 declared order. Every\n13|// RPC and CLI field typed SessionState uses exactly this registry; the\n14|// spellings created, starting, and quiesced are not session lifecycle\n15|// states. The const block below is the single production source of the\n16|// registry: no other production literal may name a state spelling, so\n17|// the census derives the state space from these lines.\n18|const (\n19|\tStateCreating      State = \"creating\"\n20|\tStateRunning       State = \"running\"\n21|\tStateIdle          State = \"idle\"\n22|\tStateQuiescing     State = \"quiescing\"\n23|\tStateCheckpointing State = \"checkpointing\"\n24|\tStateStopped       State = \"stopped\"\n25|\tStateMaterializing State = \"materializing\"\n26|\tStateParked        State = \"parked\"\n27|\tStateFailed        State = \"failed\"\n28|\tStateStale         State = \"stale\"\n29|\tStateTombstoned    State = \"tombstoned\"\n30|)\n31|\n32|// State is one Section 5.7 lifecycle value.\n33|type State string\n34|\n35|// States returns the SessionState registry in Section 5.7 declared\n36|// order. It converts the const block above instead of retyping the\n37|// spellings, so every state literal lives exactly once in production\n38|// and the census can require that single source. Callers must not\n39|// invent spellings beside this list.\n40|func States() []string {\n41|\treturn []string{\n42|\t\tstring(StateCreating), string(StateRunning), string(StateIdle),\n43|\t\tstring(StateQuiescing), string(StateCheckpointing),\n44|\t\tstring(StateStopped), string(StateMaterializing),\n45|\t\tstring(StateParked), string(StateFailed), string(StateStale),\n46|\t\tstring(StateTombstoned),\n47|\t}\n48|}\n49|\n50|// allowedTransitions is the Section 5.7 transition table, the single\n51|// source the step gate enforces. A same-state restatement (a confirming\n52|// event while already in the target state) is not a transition and\n53|// needs no edge; every other move needs exactly the edge below.\n54|var allowedTransitions = map[State]map[State]struct{}{\n55|\tStateCreating: {\n56|\t\tStateRunning: {}, StateIdle: {}, StateFailed: {},\n57|\t},\n58|\tStateRunning: {\n59|\t\tStateIdle: {}, StateQuiescing: {}, StateFailed: {}, StateStale: {},\n60|\t},\n61|\tStateIdle: {\n62|\t\tStateRunning: {}, StateQuiescing: {}, StateCheckpointing: {},\n63|\t\tStateStopped: {}, StateStale: {},\n64|\t},\n65|\tStateQuiescing: {\n66|\t\tStateIdle: {}, StateCheckpointing: {}, StateFailed: {}, StateStale: {},\n67|\t},\n68|\tStateCheckpointing: {\n69|\t\tStateIdle: {}, StateStopped: {}, StateMaterializing: {}, StateFailed: {},\n70|\t},\n71|\tStateMaterializing: {\n72|\t\tStateStopped: {}, StateRunning: {}, StateParked: {}, StateFailed: {},\n73|\t},\n74|\tStateStopped: {\n75|\t\tStateMaterializing: {}, StateRunning: {}, StateParked: {}, StateTombstoned: {},\n76|\t},\n77|\tStateParked: {\n78|\t\tStateMaterializing: {}, StateRunning: {}, StateStopped: {}, StateStale: {},\n79|\t},\n80|\tStateFailed: {\n81|\t\tStateCreating: {}, StateStopped: {}, StateParked: {},\n82|\t\tStateMaterializing: {}, StateStale: {}, StateTombstoned: {},\n83|\t},\n84|\tStateStale: {\n85|\t\tStateStopped: {}, StateTombstoned: {},\n86|\t},\n87|}\n88|\n89|// initialTargets bounds the first event of a chain: a session opens in\n90|// one of these states, and only through its bootstrap event. Any other\n91|// first event is invalid_state_transition, not a silent default.\n92|var initialTargets = map[State]struct{}{\n93|\tStateCreating: {}, StateRunning: {}, StateIdle: {}, StateFailed: {},\n94|}\n95|\n96|// staleSources bounds the local-stale override the same way the table\n97|// bounds every other move into stale: the override applies only when\n98|// the winner projection stands in a state the table lets go stale,\n99|// otherwise the winner state stands with the lease conflict recorded.\n100|var staleSources = map[State]struct{}{\n101|\tStateRunning: {}, StateIdle: {}, StateQuiescing: {},\n102|\tStateFailed: {}, StateParked: {},\n103|}\n104|\n105|var (\n106|\tErrInvalidRecord     = errors.New(\"invalid session record\")\n107|\tErrInvalidEvent      = errors.New(\"invalid session event\")\n108|\tErrInvalidTransition = errors.New(\"invalid_state_transition\")\n109|\tErrIntegrity         = errors.New(\"integrity_failure\")\n110|\tErrDerivation        = errors.New(\"derivation input is corrupt\")\n111|\tErrUnknownSession    = errors.New(\"unknown session\")\n112|\tErrStaleLease        = errors.New(\"event lease epoch precedes the chain head\")\n113|\tErrDivergentLease    = errors.New(\"divergent lease branch cannot be authoritative\")\n114|)\n115|\n116|// refuse is the single refusal funnel every sessstate rejection flows\n117|// through. It is a var so the census TestMain can wrap it and record\n118|// the production file:line behind each exercised refusal. No production\n119|// path wraps a sentinel with fmt.Errorf directly.\n120|var refuse = func(sentinel error, format string, arguments ...any) error {\n121|\treturn fmt.Errorf(\"%w: %s\", sentinel, fmt.Sprintf(format, arguments...))\n122|}\n123|\n124|// LeaseHead is one observed fencing token: the winning-lease pair\n125|// carried by every owner-authored event and mutation.\n126|type LeaseHead struct {\n127|\tEpoch   uint64\n128|\tLeaseID string\n129|}\n130|\n131|// IsZero reports an unset lease head: no local lease was supplied.\n132|func (head LeaseHead) IsZero() bool {\n133|\treturn head.Epoch == 0 && head.LeaseID == \"\"\n134|}\n135|\n136|// Compare orders two lease heads by the Section 5.3 tuple rule: the\n137|// greatest (epoch, lease_id) wins, where lease_id uses bytewise UUID\n138|// order. Lease IDs are canonical lowercase UUIDv4, so string order is\n139|// bytewise order.\n140|func Compare(a, b LeaseHead) int {\n141|\tif a.Epoch != b.Epoch {\n142|\t\tif a.Epoch < b.Epoch {\n143|\t\t\treturn -1\n144|\t\t}\n145|\t\treturn 1\n146|\t}\n147|\tswitch {\n148|\tcase a.LeaseID < b.LeaseID:\n149|\t\treturn -1\n150|\tcase a.LeaseID > b.LeaseID:\n151|\t\treturn 1\n152|\t}\n153|\treturn 0\n154|}\n155|\n156|// Conflict kinds. A conflict is reported data, never an error: both\n157|// sides were individually admittable, so the projection names the rule\n158|// that resolved them.\n159|const (\n160|\t// ConflictSameEpochTie ResolveRuleGreatestLeaseIDWins: two distinct\n161|\t// leases share the winning epoch (concurrent force takeovers under\n162|\t// partition); the bytewise-greater lease ID wins.\n163|\tConflictSameEpochTie = \"same_epoch_tie\"\n164|\t// ConflictEpochGap ResolveRuleGreatestTupleWins: a successor epoch\n165|\t// skips its predecessor (epoch N to N+2 or more); the greatest\n166|\t// tuple still wins, and only an explicit takeover checkpoint heals\n167|\t// the gap.\n168|\tConflictEpochGap = \"epoch_gap\"\n169|\t// ConflictLosingBranchPreserved ResolveRulePreservedNeverApplied:\n170|\t// an observed lease loses the tuple comparison; its history stays\n171|\t// preserved but never affects authoritative state.\n172|\tConflictLosingBranchPreserved = \"losing_branch_preserved\"\n173|\t// ConflictProviderMismatch ResolveRuleRecordPinnedProviderWins:\n174|\t// a launch event names a provider other than the immutable Session\n175|\t// Record provider; the record value stays authoritative.\n176|\tConflictProviderMismatch = \"provider_mismatch\"\n177|\t// ConflictUnionSupersedesChain\n178|\t// ResolveRuleAuthoritativeStateUnchanged: the union winner is not\n179|\t// among the authoritative chain leases; the reported winner moves\n180|\t// but derived state does not until an explicit takeover lands.\n181|\tConflictUnionSupersedesChain = \"union_supersedes_chain\"\n182|)\n183|\n184|// Resolution rules named by conflicts.\n185|const (\n186|\tResolveRuleGreatestLeaseIDWins         = \"greatest-lease-id-wins\"\n187|\tResolveRuleGreatestTupleWins           = \"greatest-tuple-wins\"\n188|\tResolveRulePreservedNeverApplied       = \"preserved-never-applied\"\n189|\tResolveRuleRecordPinnedProviderWins    = \"record-pinned-provider-wins\"\n190|\tResolveRuleAuthoritativeStateUnchanged = \"authoritative-state-unchanged\"\n191|)\n192|\n193|// Conflict is one resolved lease or identity conflict.\n194|type Conflict struct {\n195|\tKind   string\n196|\tRule   string\n197|\tDetail string\n198|}\n199|\n200|// Checkpoint is the newest validated checkpoint the projection knows.\n201|type Checkpoint struct {\n202|\tID      string\n203|\tKind    string\n204|\tEventID string\n205|}\n206|\n207|// ProviderIdentity is the derived provider surface: the immutable\n208|// record provider, the newest launched version, and the newest\n209|// identified record with its confidence.\n210|type ProviderIdentity struct {\n211|\tID               string\n212|\tVersion          string\n213|\tIdentityRecordID string\n214|\tConfidence       string\n215|}\n216|\n217|// TerminalBinding is the current terminal surface: the newest\n218|// terminal.created or session.resumed binding. V1 bindings carry the\n219|// backend with the terminal or native session handle; v4 bindings\n220|// carry the binding digest with the backend and versions.\n221|type TerminalBinding struct {\n222|\tBackend         string\n223|\tBindingID       string\n224|\tTerminalID      string\n225|\tNativeSessionID string\n226|\tEventID         string\n227|}\n228|\n229|// ParkedFacts carries the per-session parked channel from sessrepo\n230|// into the projection: the recoverable_parked_state blocking reason\n231|// and the same-operation retry.\n232|type ParkedFacts struct {\n233|\tBlockingReason string\n234|\tRetryHint      string\n235|}\n236|\n237|// Record is the decoded Session Record surface the reducer reads.\n238|type Record struct {\n239|\tSessionID  string\n240|\tRecordID   string\n241|\tName       string\n242|\tKind       string\n243|\tProviderID string\n244|}\n245|\n246|// Event is one decoded authoritative Session Event: the routing\n247|// members plus the closed payload object admitted by the canonical\n248|// owner at decode time.\n249|type Event struct {\n250|\tID              string\n251|\tType            string\n252|\tSchemaVersion   string\n253|\tSessionID       string\n254|\tCreatedByHostID string\n255|\tLeaseEpoch      uint64\n256|\tLeaseID         string\n257|\tSequence        uint64\n258|\tPredecessors    []string\n259|\tPayload         map[string]any\n260|}\n261|\n262|// Input is the complete pure-reducer input: the record, the\n263|// authoritative events in chain order, the competing off-chain leases\n264|// observed at union, the lease the local host acts under (zero when\n265|// unknown), the local host ID (empty when unknown), and the parked\n266|// channel (non-nil when sessrepo reports the session parked).\n267|type Input struct {\n268|\tRecord      Record\n269|\tEvents      []Event\n270|\tUnion       []LeaseHead\n271|\tLocal       LeaseHead\n272|\tLocalHostID string\n273|\tParked      *ParkedFacts\n274|}\n275|\n276|// Projection is the derived session surface: lifecycle state, winning\n277|// lease, conflicts, current checkpoint, provider identity, terminal\n278|// binding, owner and role, the parked channel when set, and warnings.\n279|type Projection struct {\n280|\tSessionID     string\n281|\tRecordID      string\n282|\tName          string\n283|\tKind          string\n284|\tState         State\n285|\tWinner        LeaseHead\n286|\tConflicts     []Conflict\n287|\tHasCheckpoint bool\n288|\tNewest        Checkpoint\n289|\tProvider      ProviderIdentity\n290|\tHasTerminal   bool\n291|\tTerminal      TerminalBinding\n292|\tOwnerHostID   string\n293|\tLocalRole     string\n294|\tParked        *ParkedFacts\n295|\tWarnings      []string\n296|}\n297|\n298|// Reduce folds one record with its authoritative events into a\n299|// Projection. It is pure: no I/O, no clock, no cache. Chain continuity\n300|// is re-checked over the input, so a chain-forbidden reordering\n301|// refuses with invalid_state_transition instead of silently deriving a\n302|// different state.\n303|func Reduce(input Input) (Projection, error) {\n304|\tprojection := Projection{\n305|\t\tSessionID: input.Record.SessionID,\n306|\t\tRecordID:  input.Record.RecordID,\n307|\t\tName:      input.Record.Name,\n308|\t\tKind:      input.Record.Kind,\n309|\t\tProvider:  ProviderIdentity{ID: input.Record.ProviderID},\n310|\t}\n311|\tif input.Parked != nil {\n312|\t\tprojection.State = StateParked\n313|\t\tprojection.Parked = &ParkedFacts{\n314|\t\t\tBlockingReason: input.Parked.BlockingReason,\n315|\t\t\tRetryHint:      input.Parked.RetryHint,\n316|\t\t}\n317|\t\tprojection.Warnings = []string{\"parked: \" + input.Parked.BlockingReason}\n318|\t\treturn projection, nil\n319|\t}\n320|\tif input.Record.SessionID == \"\" || input.Record.RecordID == \"\" {\n321|\t\treturn Projection{}, refuse(ErrInvalidRecord, \"reducer input carries no session identity\")\n322|\t}\n323|\tfold := &chainFold{\n324|\t\trecordID:       input.Record.RecordID,\n325|\t\trecordProvider: input.Record.ProviderID,\n326|\t\tprojection:     &projection,\n327|\t}\n328|\tfor index := range input.Events {\n329|\t\tif err := fold.apply(input.Events[index]); err != nil {\n330|\t\t\treturn Projection{}, err\n331|\t\t}\n332|\t}\n333|\tif len(input.Events) == 0 {\n334|\t\t// An empty chain derives creating, but the union still\n335|\t\t// passes through resolveWinner below: a malformed union\n336|\t\t// refuses here exactly as on a non-empty chain, and a\n337|\t\t// well-formed union moves only the reported winner while\n338|\t\t// authoritative state stays creating.\n339|\t\tfold.state = StateCreating\n340|\t}\n341|\tif err := fold.resolveWinner(input.Union); err != nil {\n342|\t\treturn Projection{}, err\n343|\t}\n344|\tfold.applyLocalLease(input.Local, input.LocalHostID)\n345|\tfold.emitWarnings()\n346|\treturn projection, nil\n347|}\n348|\n349|// chainFold carries the mutable fold state across one Reduce call. It\n350|// never escapes Reduce.\n351|type chainFold struct {\n352|\trecordID       string\n353|\trecordProvider string\n354|\tprojection     *Projection\n355|\tstate          State\n356|\tcurrent        LeaseHead\n357|\tcreateLease    LeaseHead\n358|\thaveLease      bool\n359|\tseenCheckpoint bool\n360|\tseenAbort      bool\n361|\tonChain        map[string]struct{}\n362|\ttailID         string\n363|\ttailSeq        uint64\n364|\tleases         []LeaseHead\n365|\tprevious       LeaseHead\n366|}\n367|\n368|// apply folds one event: continuity first, then the type effect.\n369|func (fold *chainFold) apply(event Event) error {\n370|\tif err := fold.checkContinuity(event); err != nil {\n371|\t\treturn err\n372|\t}\n373|\tif event.SchemaVersion != \"1.0.0\" && event.SchemaVersion != \"2.0.0\" &&\n374|\t\tevent.SchemaVersion != \"3.0.0\" && event.SchemaVersion != \"4.0.0\" {\n375|\t\treturn refuse(ErrInvalidEvent, \"event %s carries unregistered schema version %q\", event.ID, event.SchemaVersion)\n376|\t}\n377|\tif event.SessionID != fold.projection.SessionID {\n378|\t\treturn refuse(ErrInvalidEvent, \"event %s session %s does not belong to session %s\", event.ID, event.SessionID, fold.projection.SessionID)\n379|\t}\n380|\tlease := LeaseHead{Epoch: event.LeaseEpoch, LeaseID: event.LeaseID}\n381|\tsuccession, err := fold.trackLease(event, lease)\n382|\tif err != nil {\n383|\t\treturn err\n384|\t}\n385|\tif succession {\n386|\t\tif err := fold.successionMove(what(event)); err != nil {\n387|\t\t\treturn err\n388|\t\t}\n389|\t}\n390|\tfold.projection.OwnerHostID = event.CreatedByHostID\n391|\treturn fold.effect(event, lease, succession)\n392|}\n393|\n394|// what names one event for refusal evidence.\n395|func what(event Event) string {\n396|\treturn \"event \" + event.Type + \" \" + event.ID\n397|}\n398|\n399|// successionMove folds a successor lease arrival before the event's own\n400|// effect: a takeover while the winner is active stales the old host's\n(more lines below)","final_result":true}}}
