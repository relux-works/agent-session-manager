tion; every\n35|// rejection branch of parseMajor (a return 0, false) yields\n36|// parse|<enclosing condition source>; every literal first argument to one\n37|// of the six refusal constructors yields ctor|<constructor>|<detail>.\n38|// A non-literal frameFault detail or integrity argument lands as an\n39|// expr:<source> obligation rather than passing silently; a non-literal\n40|// constructor first argument is a fault conduit (fault.detail, a detail\n41|// variable) whose arms are the frame arms above, so it carries no\n42|// separate obligation by design. A missing parseMajor fails the\n43|// derivation outright.\n44|//\n45|// Both directions are checked: TestDerivedRefusalArmsAreAllWitnessed\n46|// (every derived arm carries a witness) and\n47|// TestWitnessedArmsAreAllDerived (every witness names a derived arm, so a\n48|// truncated derivation reddens on the orphaned witnesses instead of\n49|// passing vacuously). TestEveryArmWitnessRefusesAtTheProductionEntry\n50|// drives each witness through the production entry and requires the\n51|// refusal to come from the arm under test. Empty, single-file, or\n52|// unparseable derivations fail closed: a domain that silently derives\n53|// nothing is not a measurement.\n54|//\n55|// Stated bound: arms sharing one (constructor, detail) identity merge to\n56|// one obligation (the two timeout sites, the two empty-response sites,\n57|// the six identical \"not a JSON object\" sites). Deleting one of a merged\n58|// pair is a behavioral mutant the entry-point tests must catch, not this\n59|// inventory.\n60|\n61|// refusalArmCensusFloor is the derived arm count this test was written\n62|// against. It is a tripwire, not an enumeration: a derivation returning\n63|// fewer arms fails closed even when every surviving arm is witnessed,\n64|// which is what catches a silently truncated scan. Raising it is routine\n65|// when production gains a refusal; lowering it requires saying why.\n66|//\n67|// Raised 60 -> 162 by the operation-layer leaf (manifest, probe,\n68|// profile, quiescence, spawn, identity, idempotency decoders), each\n69|// new arm witnessed in declaredOperationWitnesses below, then 162 ->\n70|// 164 by the lone-surrogate gate and 164 -> 166 by the UTF-8 gate:\n71|// one frame arm in decodeStrictObject plus its status-body integrity\n72|// expansion each, every one witnessed above. Raised 166 -> 216 by the\n73|// provider-identity creation leaf (CreateIdentity, the discovery\n74|// decoder, store roots, the resume-tuple gate, and the build and\n75|// discovery bindings), each new arm witnessed in\n76|// declaredOperationWitnessesIdentityCreate. The pre-existing domain\n77|// derived 167 against the 166 floor, so 167 + 50 pins 217 exactly.\n78|const refusalArmCensusFloor = 217\n79|\n80|func deriveRefusalArms(t *testing.T) map[string]struct{} {\n81|\tt.Helper()\n82|\tdirectory, err := os.Getwd()\n83|\tif err != nil {\n84|\t\tt.Fatalf(\"derive refusal arms: %v\", err)\n85|\t}\n86|\tarms, scanned, err := refusalArmsIn(directory)\n87|\tif err != nil {\n88|\t\tt.Fatalf(\"derive refusal arms: %v\", err)\n89|\t}\n90|\tif len(scanned) == 0 {\n91|\t\tt.Fatal(\"derived refusal arms from zero production files; the scanner is broken, not the package\")\n92|\t}\n93|\tif len(arms) == 0 {\n94|\t\tt.Fatal(\"derived zero refusal arms from the package sources; the scanner is broken, not the package\")\n95|\t}\n96|\tif len(arms) < refusalArmCensusFloor {\n97|\t\tt.Fatalf(\"derived %d refusal arms, below the %d census floor; the derivation is short, not the package\", len(arms), refusalArmCensusFloor)\n98|\t}\n99|\tt.Logf(\"refusal arm coverage domain: %d derived arms across %d production files\", len(arms), len(scanned))\n100|\treturn arms\n101|}\n102|\n103|func refusalArmsIn(directory string) (map[string]struct{}, []string, error) {\n104|\t// Production-file selection and fail-closed parsing are the shared\n105|\t// core's; the derivation below only classifies.\n106|\tscannedFiles, fileSet, failures := invcore.ScanProduction(directory)\n107|\tif len(failures) != 0 {\n108|\t\treturn nil, nil, errors.New(strings.Join(failures, \"; \"))\n109|\t}\n110|\tarms := map[string]struct{}{}\n111|\tvar scanned []string\n112|\tparseBranches := 0\n113|\ttype productionFile struct {\n114|\t\tsyntax *ast.File\n115|\t\tsource []byte\n116|\t}\n117|\tvar files []productionFile\n118|\tfor _, production := range scannedFiles {\n119|\t\tscanned = append(scanned, production.Name)\n120|\t\tfiles = append(files, productionFile{syntax: production.Syntax, source: production.Source})\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
