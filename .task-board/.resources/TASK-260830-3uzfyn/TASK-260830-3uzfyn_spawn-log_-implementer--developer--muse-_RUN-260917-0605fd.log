+\\\" payload \\\"+eventType, payload, shape.members...); err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tif shape.check != nil {\\n\\t\\treturn shape.check(payload)\\n\\t}\\n\\treturn nil\\n}\\n\",\n  \"original_output_bytes\": 2680,\n  \"original_output_tokens\": 670,\n  \"truncated\": false\n}","final_result":true}}}
