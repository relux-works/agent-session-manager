{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc05","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":1117,"recorded_at":1780531400002229,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"call_id":"call_01a0adce40d773468ffcd0141608bd7e","text":"{\n  \"chunk_id\": \"exec-22-1\",\n  \"command\": \"grep -n 'profile.*default\\\\|default.*profile' internal/specdoc/SPEC.v0.6.0.md | head; echo ===; sed -n 8993,9015p internal/specdoc/SPEC.v0.6.0.md\",\n  \"description\": \"Find default profile rule\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"661:maps both ax profiles to <code>default_unrestricted_tool_set</code>; the two ax\\n2545:| <code>default_enrichment_profile_id</code> | digest or empty; empty means deterministic extraction only |\\n3502:| Pi 0.73.1 | No invented flag; use the provider's default full built-in tool set and report <code>profile_mapping = \\\"default_unrestricted_tool_set\\\"</code> |\\n3510:For Pi 0.73.1, both profiles resolve to the provider's same default full tool\\n6503:data policy; the default profile is deterministic/public-user-and-assistant,\\n===\\n### 13.1 Direct-session launch\\n\\nPreconditions:\\n\\n- configuration and local host identity are valid;\\n- the session name is unused across the reachable mesh;\\n- the provider plugin is trusted and <code>probe</code> succeeds;\\n- requested profile mapping is available;\\n- destination workspace is validated or captured as a new managed workspace;\\n- the terminal backend is available; and\\n- no task-board fields are supplied.\\n\\nTransitions:\\n\\n1. Allocate session, caller-stable bootstrap-operation,\\n   first-checkpoint-operation, and initial lease IDs. If the workspace has a\\n   valid current managed-replica marker, reuse its unique Workspace Group\\n   Record after exact topology validation; otherwise allocate new workspace-\\n   group/workspace IDs and one new group record. Epoch is 1 and the local host\\n   is the holder.\\n2. Persist any new Workspace Group Record, then the Session Record referencing\\n   that group, the initial Lease Record, and <code>session.created</code> carrying\\n   both operation IDs before creating a process. Joining\\n\",\n  \"original_output_bytes\": 1562,\n  \"original_output_tokens\": 391,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc07","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":1118,"recorded_at":1780531400002231,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"call_id":"call_01a0adce446c7784999f646145d2c334","text":"{\n  \"chunk_id\": \"exec-23-1\",\n  \"command\": \"cat .github/workflows/ci.yml; echo ===; go version; echo ===; grep -rn 'gofmt\\\\|go vet\\\\|staticcheck\\\\|golangci' .github/ AGENTS.md 2>&1 | head\",\n  \"description\": \"Read CI gates and toolchain\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"name: CI\\n\\non:\\n  pull_request:\\n  push:\\n    branches:\\n      - main\\n\\npermissions:\\n  contents: read\\n\\n# What green means. Every job below proves its selection matched something:\\n# a grep, glob, file scan, matrix expansion, or test selector that finds\\n# nothing fails closed instead of passing on an empty result set. No job\\n# declares an `if:` condition, so no job can skip quietly; gates-verdict\\n# additionally refuses any skipped, failed, or cancelled dependency.\\n#\\n# GOOS=windows work is compile-and-vet only. A green windows-compile-only job\\n# proves the tree type-checks for Windows; it never implies executed\\n# behaviour. Coverage is reported as numbers, not enforced as a floor.\\njobs:\\n  contract-preservation:\\n    name: Contract preservation (v0.5.0 current, v0.4.3 historical)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 10\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      - name: Verify specification-to-code ownership\\n        run: go run ./internal/traceability/cmd/tracecheck\\n\\n      # The diff proves the committed catalog matches generator output, but\\n      # `go generate` runs nothing when its directive is disarmed: rewriting\\n      # `//go:generate` as `// go:generate` preserves the token while turning\\n      # the directive into a plain comment, so generation is skipped and the\\n      # diff stays clean. The anchored check refuses that token-preserving\\n      # rewrite; only the exact directive form counts. A new directive\\n      # without a pin update reddens here (and in\\n      # TestGenerateDirectiveStaysRecognizedForm) instead of going unchecked.\\n      - name: Verify generated catalog is current\\n        run: |\\n          test \\\"$(grep -c '^//go:generate' internal/catalog/catalog.go)\\\" -eq 1\\n          go generate ./internal/catalog\\n          git diff --exit-code -- internal/catalog/catalog_gen.go\\n\\n      # The release roots are derived from internal/specpin and\\n      # internal/catalog inside the gate, never retyped here. Each -- PASS\\n      # guard below must match: a selector that runs nothing fails here\\n      # instead of passing silently.\\n      - name: Run pinned contract-version gates\\n        run: |\\n          set +e\\n          go test ./internal/cigate -run 'TestVerifyContractPreservationLive|TestPinnedReleasesAgreeAcrossAuthorities|TestDerivedSetsAreComplete|TestCheckAgreementAdmitsIdenticalSets|TestCheckAgreementRefusals|TestCheckReleaseRootsRefusesDrift' -count=1 -v > cigate-contracts.log 2>&1\\n          code=$?\\n          set -e\\n          cat cigate-contracts.log\\n          test $code -eq 0\\n          for gate in TestVerifyContractPreservationLive TestPinnedReleasesAgreeAcrossAuthorities TestDerivedSetsAreComplete TestCheckAgreementAdmitsIdenticalSets TestCheckAgreementRefusals TestCheckReleaseRootsRefusesDrift; do\\n            grep -q \\\"^--- PASS: ${gate}\\\" cigate-contracts.log\\n          done\\n\\n  lint:\\n    name: Linters (vet, Windows vet, gofmt)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 10\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      - name: Vet\\n        run: go vet ./...\\n\\n      - name: Vet Windows build-tagged sources\\n        run: GOOS=windows go vet ./...\\n\\n      # gofmt lists only offending files, so a clean tree prints nothing.\\n      # The file count proves the scan was not empty; the log must then be.\\n      - name: Check formatting\\n        run: |\\n          count=$(find internal -name '*.go' | wc -l | tr -d ' ')\\n          echo \\\"go files scanned: ${count}\\\"\\n          test \\\"${count}\\\" -gt 0\\n          set +e\\n          gofmt -l internal > gofmt.log 2>&1\\n          code=$?\\n          set -e\\n          cat gofmt.log\\n          test $code -eq 0\\n          test ! -s gofmt.log\\n\\n  test:\\n    name: Build and test (no cache)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 15\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      - name: Build\\n        run: go build ./...\\n\\n      # Verbose on purpose: the --- SKIP lines are the suite-wide skip\\n      # datum. At least one package must report ok: a suite that matched\\n      # nothing is a failure, not a pass.\\n      - name: Test\\n        run: |\\n          set +e\\n          go test ./... -v -count=1 > test.log 2>&1\\n          code=$?\\n          set -e\\n          cat test.log\\n          test $code -eq 0\\n          test \\\"$(grep -c '^ok' test.log)\\\" -gt 0\\n          test \\\"$(grep -c '^FAIL' test.log || true)\\\" -eq 0\\n          {\\n            echo \\\"## Suite skips\\\"\\n            echo \\\"\\\"\\n            echo \\\"Skipped: $(grep -c '^--- SKIP' test.log || true)\\\"\\n            grep '^--- SKIP' test.log || echo \\\"none\\\"\\n          } >> \\\"$GITHUB_STEP_SUMMARY\\\"\\n\\n  race:\\n    name: Race detector\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 15\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      - name: Test with race detector\\n        run: |\\n          set +e\\n          go test -race ./... -count=1 > race.log 2>&1\\n          code=$?\\n          set -e\\n          cat race.log\\n          test $code -eq 0\\n          test \\\"$(grep -c '^ok' race.log)\\\" -gt 0\\n\\n  coverage:\\n    name: Coverage numbers (reported, no floor)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 15\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      # Coverage is a number, not a gate: this job reports per-package\\n      # percentages and refuses only an unreadable or empty result.\\n      - name: Test with coverage\\n        run: |\\n          set +e\\n          go test ./... -cover -count=1 > cover.log 2>&1\\n          code=$?\\n          set -e\\n          cat cover.log\\n          test $code -eq 0\\n          test \\\"$(grep -c 'coverage: ' cover.log)\\\" -gt 0\\n          {\\n            echo \\\"## Coverage\\\"\\n            echo \\\"\\\"\\n            echo \\\"| Package | Coverage |\\\"\\n            echo \\\"| --- | --- |\\\"\\n            grep 'coverage: ' cover.log | sed -E 's/^(ok|---)[[:space:]]+([^[:space:]]+).*coverage: ([0-9.]+% of statements)/| `\\\\2` | \\\\3 |/' || true\\n            echo \\\"\\\"\\n            echo \\\"Packages without test files (stated bounds, not failures):\\\"\\n            echo \\\"\\\"\\n            grep 'no test files' cover.log || echo \\\"none\\\"\\n          } >> \\\"$GITHUB_STEP_SUMMARY\\\"\\n\\n  fixture-matrix:\\n    name: Conformance fixtures (${{ matrix.os }}, ${{ matrix.package }})\\n    runs-on: ${{ matrix.os }}\\n    timeout-minutes: 15\\n    strategy:\\n      fail-fast: false\\n      matrix:\\n        os: [ubuntu-latest, macos-latest]\\n        package: [internal/secprim, internal/secconftest]\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      # Verbose on purpose: the --- SKIP lines are the skip datum, and the\\n      # secconftest capabilities line witnesses the probe counters after the\\n      # whole suite. Skips are loud here by construction.\\n      - name: Run fixture package\\n        run: |\\n          set +e\\n          go test ./${{ matrix.package }} -count=1 -v > fixture.log 2>&1\\n          code=$?\\n          set -e\\n          grep '^--- SKIP' fixture.log || echo \\\"no skipped tests\\\"\\n          grep 'secconftest capabilities on' fixture.log || true\\n          {\\n            echo \\\"## Fixture run ${{ matrix.os }} ${{ matrix.package }}\\\"\\n            echo \\\"\\\"\\n            echo \\\"Skipped: $(grep -c '^--- SKIP' fixture.log || true)\\\"\\n          } >> \\\"$GITHUB_STEP_SUMMARY\\\"\\n          test $code -eq 0\\n          test \\\"$(grep -c '^--- PASS' fixture.log)\\\" -gt 0\\n\\n  fuzz-smoke:\\n    name: Fuzz smoke (derived targets)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 15\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      # Targets are derived per package from the compiled test binaries,\\n      # never retyped: only names starting with Fuzz are fuzz targets. An\\n      # empty leg fails the total-count pin below: the grep sits in a\\n      # pipeline whose exit status the shell discards, so it refuses\\n      # nothing, and the non-empty-file check refuses only the\\n      # every-package-empty case — a single silently empty package dies\\n      # only at the pinned total. A new fuzz target without a CI update\\n      # reddens here instead of going unsmoked.\\n      - name: Derive fuzz targets\\n        run: |\\n          rm -f fuzz-targets.clean\\n          for pkg in internal/secconftest internal/canonicaljson internal/scalar; do\\n            go test \\\"./${pkg}\\\" -list '^Fuzz' > \\\"fuzz-targets-$(basename \\\"${pkg}\\\").log\\\" 2>&1\\n            grep '^Fuzz' \\\"fuzz-targets-$(basename \\\"${pkg}\\\").log\\\" | sed \\\"s|^|${pkg} |\\\" >> fuzz-targets.clean\\n          done\\n          test -s fuzz-targets.clean\\n          test \\\"$(wc -l < fuzz-targets.clean | tr -d ' ')\\\" -eq 13\\n          cat fuzz-targets.clean\\n\\n      # The secconftest leg of that list must equal the cigate.FuzzTargets\\n      # derivation, which maps each target to the production entry it\\n      # drives. Either side drifting — a target without an entry, or an\\n      # entry without a target — fails the diff before any smoke runs.\\n      - name: Check secconftest list matches the target derivation\\n        run: |\\n          set +e\\n          go test ./internal/cigate -run 'TestListedTargetsMatchDerivation|TestFuzzTargetsAreDerivedSorted' -count=1 -v > cigate-targets.log 2>&1\\n          code=$?\\n          set -e\\n          cat cigate-targets.log\\n          test $code -eq 0\\n          for gate in TestListedTargetsMatchDerivation TestFuzzTargetsAreDerivedSorted; do\\n            grep -q \\\"^--- PASS: ${gate}\\\" cigate-targets.log\\n          done\\n\\n      # A -fuzz selector that matches nothing exits 0 with \\\"no fuzz tests\\n      # to fuzz\\\", so exit status alone cannot prove execution. The\\n      # '^fuzz: elapsed' line proves the engine ran; its absence fails.\\n      # It does not prove the mutation phase: at -fuzztime=100x the\\n      # large-corpus targets (secconftest/FuzzRedactCorpus, all four\\n      # canonicaljson targets) spend the budget on baseline coverage and\\n      # never print 'now fuzzing'. Lengthening the budget or shrinking a\\n      # corpus changes that without reddening here.\\n      - name: Smoke each target\\n        run: |\\n          while read -r pkg target; do\\n            go test \\\"./${pkg}\\\" -run='^$' -fuzz=\\\"^${target}$\\\" -fuzztime=100x -parallel=1 -count=1 > \\\"fuzz-$(basename \\\"${pkg}\\\")-${target}.log\\\" 2>&1\\n            grep -q '^fuzz: elapsed' \\\"fuzz-$(basename \\\"${pkg}\\\")-${target}.log\\\"\\n          done < fuzz-targets.clean\\n\\n  capability-claims:\\n    name: Unsupported-capability claim check\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 10\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      # The vocabulary is secconftest's probe set; the gate scans the README\\n      # with every probe forced unavailable — the strongest posture, and\\n      # host-independent: a backticked capability mention that reads as a\\n      # positive availability claim is refused no matter what this host's\\n      # probes would report. CheckAdvertisements reads ProbeState.Available\\n      # from the states it is given, and both postures are driven\\n      # (TestRealREADMECarriesNoPositiveClaim forces all unavailable,\\n      # TestRealREADMEAdmitsWhenAllAvailable forces all available). What\\n      # reaches no availability reader is the live probe outcome:\\n      # ProbeStates feeds only CapabilityIDs, which keeps the IDs and\\n      # drops availability. README prose is never capability evidence\\n      # either way.\\n      - name: Check README with all probes forced unavailable\\n        run: |\\n          set +e\\n          go test ./internal/cigate -run 'TestRealREADMECarriesNoPositiveClaim|TestRealREADMEAdmitsWhenAllAvailable|TestCapabilityIDsAreDerivedSorted|TestPositiveClaimsAreRefused|TestNegatedClaimsAreAdmitted|TestUnclassifiedMentionIsRefused' -count=1 -v > cigate-claims.log 2>&1\\n          code=$?\\n          set -e\\n          cat cigate-claims.log\\n          test $code -eq 0\\n          for gate in TestRealREADMECarriesNoPositiveClaim TestRealREADMEAdmitsWhenAllAvailable TestCapabilityIDsAreDerivedSorted TestPositiveClaimsAreRefused TestNegatedClaimsAreAdmitted TestUnclassifiedMentionIsRefused; do\\n            grep -q \\\"^--- PASS: ${gate}\\\" cigate-claims.log\\n          done\\n\\n  windows-compile-only:\\n    name: Windows compile-only (no execution implied)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 10\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      # Compile-and-vet only: go vet type-checks test files as well, and no\\n      # step here executes a Windows binary. A green here must never be read\\n      # as behaviour executed on Windows.\\n      - name: Compile for Windows\\n        run: GOOS=windows go build ./...\\n\\n      - name: Vet Windows build (includes test files)\\n        run: GOOS=windows go vet ./...\\n\\n  gates-verdict:\\n    name: All gates green, none skipped\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 5\\n    needs:\\n      - contract-preservation\\n      - lint\\n      - test\\n      - race\\n      - coverage\\n      - fixture-matrix\\n      - fuzz-smoke\\n      - capability-claims\\n      - windows-compile-only\\n    if: always()\\n    steps:\\n      - name: Refuse any non-success dependency\\n        run: |\\n          echo '${{ toJSON(needs) }}' > needs.json\\n          jq . needs.json\\n          jq -e 'to_entries | map(select(.value.result != \\\"success\\\")) | length == 0' needs.json\\n===\\ngo version go1.25.5 darwin/arm64\\n===\\n.github/workflows/ci.yml:69:    name: Linters (vet, Windows vet, gofmt)\\n.github/workflows/ci.yml:82:        run: go vet ./...\\n.github/workflows/ci.yml:85:        run: GOOS=windows go vet ./...\\n.github/workflows/ci.yml:87:      # gofmt lists only offending files, so a clean tree prints nothing.\\n.github/workflows/ci.yml:95:          gofmt -l internal > gofmt.log 2>&1\\n.github/workflows/ci.yml:98:          cat gofmt.log\\n.github/workflows/ci.yml:100:          test ! -s gofmt.log\\n.github/workflows/ci.yml:347:      # Compile-and-vet only: go vet type-checks test files as well, and no\\n.github/workflows/ci.yml:354:        run: GOOS=windows go vet ./...\\n\",\n  \"original_output_bytes\": 14871,\n  \"original_output_tokens\": 3718,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
