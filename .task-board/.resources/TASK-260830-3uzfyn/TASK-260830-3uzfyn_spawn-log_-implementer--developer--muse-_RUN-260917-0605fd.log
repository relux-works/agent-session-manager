{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7f1","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":595,"recorded_at":1780531400001185,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"call_id":"call_01a0adcc4c0d76b885569bbb0fa94b40","text":"Read text file `internal/sessstate/sessstate.go`.\n(728 line(s) above)\n729|// checkpointed stop carries its resumable base with it. A bootstrap\n730|// abort requires the null checkpoint, false resumable and graceful\n731|// values the canonical owner admitted, plus a preceding authoritative\n732|// abort event; an ambiguous live process stays failed with recovery\n733|// diagnostics instead.\n734|func (fold *chainFold) effectStopped(event Event, what string) error {\n735|\tcheckpointID, hasCheckpoint, err := payloadNullableDigest(event.Payload, \"checkpoint_id\")\n736|\tif err != nil {\n737|\t\treturn err\n738|\t}\n739|\tresumable, err := payloadBool(event.Payload, \"resumable\")\n740|\tif err != nil {\n741|\t\treturn err\n742|\t}\n743|\tclosure, err := payloadString(event.Payload, \"closure_kind\")\n744|\tif err != nil {\n745|\t\treturn err\n746|\t}\n747|\tif closure == \"checkpointed\" {\n748|\t\tif !hasCheckpoint || !resumable {\n749|\t\t\treturn refuse(ErrIntegrity, \"%s closes checkpointed without a resumable checkpoint\", what)\n750|\t\t}\n751|\t\tfold.noteCheckpoint(checkpointID, \"\", event.ID)\n752|\t\treturn fold.step(StateStopped, what)\n753|\t}\n754|\tif hasCheckpoint || resumable {\n755|\t\treturn refuse(ErrIntegrity, \"%s closes bootstrap_abort with a checkpoint or resumable set\", what)\n756|\t}\n757|\tif !fold.seenAbort {\n758|\t\treturn refuse(ErrInvalidTransition, \"%s closes bootstrap_abort with no authoritative abort event\", what)\n759|\t}\n760|\treturn fold.step(StateFailed, what)\n761|}\n762|\n763|// effectResumed moves to running under the resumed checkpoint and\n764|// records the terminal binding the resume selected.\n765|func (fold *chainFold) effectResumed(event Event, what string) error {\n766|\tcheckpointID, err := payloadString(event.Payload, \"checkpoint_id\")\n767|\tif err != nil {\n768|\t\treturn err\n769|\t}\n770|\tif _, err := scalar.ParseDigest(checkpointID); err != nil {\n771|\t\treturn refuse(ErrDerivation, \"%s carries malformed checkpoint_id: %v\", what, err)\n772|\t}\n773|\tfold.noteCheckpoint(checkpointID, \"\", event.ID)\n774|\tif event.SchemaVersion == \"4.0.0\" {\n775|\t\tbinding, err := payloadString(event.Payload, \"terminal_binding_id\")\n776|\t\tif err != nil {\n777|\t\t\treturn err\n778|\t\t}\n779|\t\tif _, err := scalar.ParseDigest(binding); err != nil {\n780|\t\t\treturn refuse(ErrDerivation, \"%s carries malformed terminal_binding_id: %v\", what, err)\n781|\t\t}\n782|\t\tbackend, err := payloadString(event.Payload, \"terminal_backend_id\")\n783|\t\tif err != nil {\n784|\t\t\treturn err\n785|\t\t}\n786|\t\tif _, err := terminalbackend.ParseID(backend); err != nil {\n787|\t\t\treturn refuse(ErrDerivation, \"%s carries refused terminal backend: %v\", what, err)\n788|\t\t}\n789|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, BindingID: binding, EventID: event.ID}\n790|\t} else {\n791|\t\tbackend, err := payloadString(event.Payload, \"terminal_backend\")\n792|\t\tif err != nil {\n793|\t\t\treturn err\n794|\t\t}\n795|\t\tif backend != \"tmux\" && backend != \"conpty\" {\n796|\t\t\treturn refuse(ErrDerivation, \"%s carries unknown terminal backend %q\", what, backend)\n797|\t\t}\n798|\t\tnativeID, err := payloadString(event.Payload, \"native_session_id\")\n799|\t\tif err != nil {\n800|\t\t\treturn err\n801|\t\t}\n802|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, NativeSessionID: nativeID, EventID: event.ID}\n803|\t}\n804|\tfold.projection.HasTerminal = true\n805|\treturn fold.step(StateRunning, what)\n806|}\n807|\n808|// effectBootstrapAborted records the authoritative abort and fails the\n809|// bootstrap. Only the creating session can abort its bootstrap; any\n810|// later abort is invalid_state_transition.\n811|func (fold *chainFold) effectBootstrapAborted(event Event, what string) error {\n812|\tfold.seenAbort = true\n813|\tif fold.state != \"\" && fold.state != StateCreating {\n814|\t\treturn refuse(ErrInvalidTransition, \"%s aborts a bootstrap past creating\", what)\n815|\t}\n816|\treturn fold.step(StateFailed, what)\n817|}\n818|\n819|// effectLease checks the successor-lease payload linkage: the payload\n820|// must name the predecessor the chain stands on and the envelope it\n821|// arrives under, else integrity_failure. The lifecycle move already\n822|// happened in successionMove; a lease event repeating the current\n823|// lease is a fact, not a transition.\n824|func (fold *chainFold) effectLease(event Event, lease LeaseHead, what string, succession bool) error {\n825|\tif !succession {\n826|\t\treturn nil\n827|\t}\n828|\tif event.Type == \"lease.transferred\" {\n829|\t\tpredecessor, err := payloadString(event.Payload, \"predecessor_lease_id\")\n830|\t\tif err != nil {\n831|\t\t\treturn err\n832|\t\t}\n833|\t\tif predecessor != fold.previous.LeaseID {\n834|\t\t\treturn refuse(ErrIntegrity, \"%s transfers from lease %s past chain head lease %s\", what, predecessor, fold.previous.LeaseID)\n835|\t\t}\n836|\t\tsuccessor, err := payloadString(event.Payload, \"new_lease_id\")\n837|\t\tif err != nil {\n838|\t\t\treturn err\n839|\t\t}\n840|\t\tif successor != lease.LeaseID {\n841|\t\t\treturn refuse(ErrIntegrity, \"%s transfers to lease %s outside its envelope lease %s\", what, successor, lease.LeaseID)\n842|\t\t}\n843|\t} else {\n844|\t\tsuccessor, err := payloadString(event.Payload, \"new_lease_id\")\n845|\t\tif err != nil {\n846|\t\t\treturn err\n847|\t\t}\n848|\t\tif successor != lease.LeaseID {\n849|\t\t\treturn refuse(ErrIntegrity, \"%s forces lease %s outside its envelope lease %s\", what, successor, lease.LeaseID)\n850|\t\t}\n851|\t}\n852|\treturn nil\n853|}\n854|\n855|// effectTaskBoardLaunched enforces the Section 5.2 repeat rule — the\n856|// event must repeat the winning creation lease and the Session\n857|// Record's provider and launch mode — then derives the payload's\n858|// running or idle state through the table.\n859|func (fold *chainFold) effectTaskBoardLaunched(event Event, what string) error {\n860|\tproviderID, err := payloadString(event.Payload, \"provider_id\")\n861|\tif err != nil {\n862|\t\treturn err\n863|\t}\n864|\tif providerID != fold.recordProvider {\n865|\t\treturn refuse(ErrIntegrity, \"%s repeats provider %q past record provider %q\", what, providerID, fold.recordProvider)\n866|\t}\n867|\tpayloadEpoch, err := payloadUint(event.Payload, \"lease_epoch\")\n868|\tif err != nil {\n869|\t\treturn err\n870|\t}\n871|\tpayloadLease, err := payloadString(event.Payload, \"lease_id\")\n872|\tif err != nil {\n873|\t\treturn err\n874|\t}\n875|\tif payloadEpoch != fold.createLease.Epoch || payloadLease != fold.createLease.LeaseID {\n876|\t\treturn refuse(ErrIntegrity, \"%s repeats creation lease (%d, %s) past create lease (%d, %s)\", what, payloadEpoch, payloadLease, fold.createLease.Epoch, fold.createLease.LeaseID)\n877|\t}\n878|\treported, err := payloadString(event.Payload, \"state\")\n879|\tif err != nil {\n880|\t\treturn err\n881|\t}\n882|\tif reported == string(StateRunning) {\n883|\t\treturn fold.step(StateRunning, what)\n884|\t}\n885|\treturn fold.step(StateIdle, what)\n886|}\n887|\n888|// noteCheckpoint records the newest validated checkpoint.\n889|func (fold *chainFold) noteCheckpoint(id, kind, eventID string) {\n890|\tfold.seenCheckpoint = true\n891|\tfold.projection.HasCheckpoint = true\n892|\tfold.projection.Newest = Checkpoint{ID: id, Kind: kind, EventID: eventID}\n893|}\n894|\n895|// resolveWinner selects the winning lease over the authoritative chain\n896|// leases and the union leases by the greatest (epoch, lease_id)\n897|// tuple. A same-epoch tie resolves to the bytewise-greater lease ID;\n898|// an off-chain union winner moves the reported winner but never\n899|// rewrites authoritative state; union leases that lose are reported\n900|// preserved-never-applied. With no union the chain head wins alone\n901|// and no conflict is recorded.\n902|func (fold *chainFold) resolveWinner(union []LeaseHead) error {\n903|\twinner := fold.current\n904|\tonChain := map[string]struct{}{}\n905|\tif fold.haveLease {\n906|\t\tonChain[fold.current.LeaseID] = struct{}{}\n907|\t}\n908|\tfor _, lease := range fold.chainLeases() {\n909|\t\tonChain[lease.LeaseID] = struct{}{}\n910|\t}\n911|\tbyEpoch := map[uint64]map[string]struct{}{}\n912|\tnote := func(lease LeaseHead) {\n913|\t\tif byEpoch[lease.Epoch] == nil {\n914|\t\t\tbyEpoch[lease.Epoch] = map[string]struct{}{}\n915|\t\t}\n916|\t\tbyEpoch[lease.Epoch][lease.LeaseID] = struct{}{}\n917|\t}\n918|\tfor _, lease := range fold.chainLeases() {\n919|\t\tnote(lease)\n920|\t}\n921|\toffChainWinner := false\n922|\tfor _, lease := range union {\n923|\t\tif lease.IsZero() {\n924|\t\t\treturn refuse(ErrInvalidEvent, \"union carries an empty lease head\")\n925|\t\t}\n926|\t\tif _, err := scalar.ParseUUIDv4(lease.LeaseID); err != nil {\n927|\t\t\treturn refuse(ErrInvalidEvent, \"union lease %q is not a UUIDv4: %v\", lease.LeaseID, err)\n928|\t\t}\n929|\t\tnote(lease)\n930|\t\tswitch Compare(lease, winner) {\n931|\t\tcase 1:\n932|\t\t\twinner = lease\n933|\t\t\tif _, ok := onChain[lease.LeaseID]; !ok {\n934|\t\t\t\toffChainWinner = true\n935|\t\t\t}\n936|\t\tcase -1:\n937|\t\t\tfold.conflict(ConflictLosingBranchPreserved, ResolveRulePreservedNeverApplied,\n938|\t\t\t\t\"union lease (%d, %s) loses to (%d, %s); its history stays preserved and never applies\",\n939|\t\t\t\tlease.Epoch, lease.LeaseID, winner.Epoch, winner.LeaseID)\n940|\t\tcase 0:\n941|\t\t\t// A duplicate union entry names the tuple already\n942|\t\t\t// selected: the winner and the off-chain flag stand.\n943|\t\t\t// Clearing here would drop a correctly recorded\n944|\t\t\t// union_supersedes_chain conflict (and its\n945|\t\t\t// divergent_history warning) on a repeated entry.\n946|\t\t}\n947|\t}\n948|\tepochs := make([]uint64, 0, len(byEpoch))\n949|\tfor epoch := range byEpoch {\n950|\t\tepochs = append(epochs, epoch)\n951|\t}\n952|\tsort.Slice(epochs, func(i, j int) bool { return epochs[i] < epochs[j] })\n953|\tfor _, epoch := range epochs {\n954|\t\trivals := byEpoch[epoch]\n955|\t\tif len(rivals) < 2 {\n956|\t\t\tcontinue\n957|\t\t}\n958|\t\tordered := make([]string, 0, len(rivals))\n959|\t\tfor id := range rivals {\n960|\t\t\tordered = append(ordered, id)\n961|\t\t}\n962|\t\tsort.Strings(ordered)\n963|\t\tfold.conflict(ConflictSameEpochTie, ResolveRuleGreatestLeaseIDWins,\n964|\t\t\t\"epoch %d is shared by leases %v; the bytewise-greater lease ID %s wins\",\n965|\t\t\tepoch, ordered, ordered[len(ordered)-1])\n966|\t}\n967|\tif offChainWinner {\n968|\t\tfold.conflict(ConflictUnionSupersedesChain, ResolveRuleAuthoritativeStateUnchanged,\n969|\t\t\t\"union winner (%d, %s) stands outside the authoritative chain; derived state is unchanged until an explicit takeover lands\",\n970|\t\t\twinner.Epoch, winner.LeaseID)\n971|\t}\n972|\tfold.projection.Winner = winner\n973|\treturn nil\n974|}\n975|\n976|// chainLeases replays the distinct envelope leases in first-appearance\n977|// order. Every succession appends, so a tie planted at any past epoch\n978|// still resolves against the lease the chain actually stood on. Gaps\n979|// were already recorded at succession time.\n980|func (fold *chainFold) chainLeases() []LeaseHead {\n981|\treturn append([]LeaseHead(nil), fold.leases...)\n982|}\n983|\n984|// applyLocalLease derives the local projection: the owner host of the\n985|// newest authoritative event decides the local role against the\n986|// caller-supplied host, and a local lease that lost the tuple rule\n987|// stales the projection exactly where the table lets it go stale.\n988|func (fold *chainFold) applyLocalLease(local LeaseHead, localHostID string) {\n989|\tif localHostID != \"\" && fold.projection.OwnerHostID != \"\" {\n990|\t\tif localHostID == fold.projection.OwnerHostID {\n991|\t\t\tfold.projection.LocalRole = \"owner\"\n992|\t\t} else {\n993|\t\t\tfold.projection.LocalRole = \"replica\"\n994|\t\t}\n995|\t}\n996|\tif local.IsZero() || !fold.haveLease {\n997|\t\treturn\n998|\t}\n999|\t// Only a lease that lost the tuple rule stales the projection:\n1000|\t// an equal or strictly greater local lease stands with the\n1001|\t// winner instead of reporting stale.\n1002|\tif Compare(local, fold.projection.Winner) >= 0 {\n1003|\t\treturn\n1004|\t}\n1005|\tif _, ok := staleSources[fold.state]; !ok {\n1006|\t\treturn\n1007|\t}\n1008|\tfold.state = StateStale\n1009|\tfold.projection.State = StateStale\n1010|}\n1011|\n1012|// emitWarnings publishes the sorted unique warnings this leaf derives:\n1013|// divergent history behind any lease or provider conflict, a stale\n1014|// local process, and the parked blocking reason. Capability,\n1015|// authentication, and sync-age warnings belong to other leaves.\n1016|func (fold *chainFold) emitWarnings() {\n1017|\tfold.projection.State = fold.state\n1018|\twarnings := map[string]struct{}{}\n1019|\tfor _, conflict := range fold.projection.Conflicts {\n1020|\t\tswitch conflict.Kind {\n1021|\t\tcase ConflictSameEpochTie, ConflictEpochGap, ConflictLosingBranchPreserved,\n1022|\t\t\tConflictUnionSupersedesChain, ConflictProviderMismatch:\n1023|\t\t\twarnings[\"divergent_history\"] = struct{}{}\n1024|\t\t}\n1025|\t}\n1026|\tif fold.state == StateStale {\n1027|\t\twarnings[\"stale_process\"] = struct{}{}\n1028|\t}\n1029|\tif fold.projection.Parked != nil {\n1030|\t\twarnings[\"parked: \"+fold.projection.Parked.BlockingReason] = struct{}{}\n1031|\t}\n1032|\tif len(warnings) == 0 {\n1033|\t\treturn\n1034|\t}\n1035|\tordered := make([]string, 0, len(warnings))\n1036|\tfor warning := range warnings {\n1037|\t\tordered = append(ordered, warning)\n1038|\t}\n1039|\tsort.Strings(ordered)\n1040|\tfold.projection.Warnings = ordered\n1041|}\n1042|\n1043|func containsString(haystack []string, needle string) bool {\n1044|\tfor _, candidate := range haystack {\n1045|\t\tif candidate == needle {\n1046|\t\t\treturn true\n1047|\t\t}\n1048|\t}\n1049|\treturn false\n1050|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
