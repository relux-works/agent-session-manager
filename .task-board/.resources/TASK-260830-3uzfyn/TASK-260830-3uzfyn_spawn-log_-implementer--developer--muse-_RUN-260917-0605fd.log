{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c96f","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":786,"recorded_at":1780531400001567,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"task_stream":{"kind":"task","id":"01a0adcc-c094-71d1-80b1-9ac9ff3b5824"},"task_id":"01a0adcc-c094-71d1-80b1-9ac9ff3b5824","event":{"kind":"output","task_id":"01a0adcc-c094-71d1-80b1-9ac9ff3b5824","chunk":"Read text file `internal/provhost/spawn.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"strings\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n9|)\n10|\n11|// This file validates the SpawnPlan a launch or resume operation\n12|// returns as its success body (Section 7.5 rows). The trusted\n13|// terminal backend performs process creation from this plan, so the\n14|// plan MUST NOT carry secret environment values, and its\n15|// profile_mapping MUST equal the Section 7.7 mapping for the calling\n16|// provider and profile. Literal secrecy is structural, not\n17|// content-admitted: values are bounded and disjoint from inherited\n18|// names, and the host never logs bodies; no content inspection could\n19|// prove a literal non-secret, so none is attempted.\n20|\n21|// spawnMembers is the exact required member set of a SpawnPlan.\n22|var spawnMembers = map[string]bool{\n23|\t\"argv\":              true,\n24|\t\"cwd\":               true,\n25|\t\"env_names\":         true,\n26|\t\"env_literals\":      true,\n27|\t\"native_session_id\": true,\n28|\t\"profile_mapping\":   true,\n29|\t\"extensions\":        true,\n30|}\n31|\n32|// spawnRequired lists spawnMembers in a fixed order so a plan missing\n33|// several members always names the same one.\n34|var spawnRequired = []string{\n35|\t\"argv\",\n36|\t\"cwd\",\n37|\t\"env_names\",\n38|\t\"env_literals\",\n39|\t\"native_session_id\",\n40|\t\"profile_mapping\",\n41|\t\"extensions\",\n42|}\n43|\n44|// maxSpawnArgvBytes bounds the total encoded argv Section 5.1 states.\n45|const maxSpawnArgvBytes = 65536\n46|\n47|// DecodeSpawnPlan validates one launch- or resume-operation success\n48|// body as a SpawnPlan for the calling provider under the calling\n49|// profile on the destination platform. It returns nil on a\n50|// well-formed plan and a refusal naming the offending member\n51|// otherwise: a provider_protocol_error for a malformed plan, and an\n52|// invalid_config caller error when the caller names an unknown\n53|// provider or profile for the mapping check.\n54|func DecodeSpawnPlan(body []byte, providerID, profile string, platform scalar.Platform) error {\n55|\tmembers, fault := decodeStrictObject(body)\n56|\tif fault != nil {\n57|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n58|\t\tif err != nil {\n59|\t\t\treturn err\n60|\t\t}\n61|\t\treturn failure\n62|\t}\n63|\tif name, unknown := unknownMember(members, spawnMembers); unknown {\n64|\t\tfailure, err := failProtocol(\"spawn plan carries unknown member\", name)\n65|\t\tif err != nil {\n66|\t\t\treturn err\n67|\t\t}\n68|\t\treturn failure\n69|\t}\n70|\tif name, missing := missingMember(members, spawnRequired); missing {\n71|\t\tfailure, err := failProtocol(\"spawn plan misses a required member\", name)\n72|\t\tif err != nil {\n73|\t\t\treturn err\n74|\t\t}\n75|\t\treturn failure\n76|\t}\n77|\tif err := checkSpawnArgv(members[\"argv\"]); err != nil {\n78|\t\treturn err\n79|\t}\n80|\tif cwd, ok := rawString(members[\"cwd\"]); !ok || !isAbsoluteOn(cwd, platform) {\n81|\t\tfailure, err := failProtocol(\"spawn cwd is not an absolute path\", \"cwd\")\n82|\t\tif err != nil {\n83|\t\t\treturn err\n84|\t\t}\n85|\t\treturn failure\n86|\t}\n87|\tnames, err := checkSpawnEnvNames(members[\"env_names\"])\n88|\tif err != nil {\n89|\t\treturn err\n90|\t}\n91|\tif err := checkSpawnEnvLiterals(members[\"env_literals\"], names); err != nil {\n92|\t\treturn err\n93|\t}\n94|\tif _, isNull, ok := rawNullableString(members[\"native_session_id\"]); !ok || (!isNull && !isBoundedString(members[\"native_session_id\"], 1, 512)) {\n95|\t\tfailure, err := failProtocol(\"spawn native_session_id is not 1..512 characters or null\", \"native_session_id\")\n96|\t\tif err != nil {\n97|\t\t\treturn err\n98|\t\t}\n99|\t\treturn failure\n100|\t}\n101|\tif err := checkSpawnProfileMapping(members[\"profile_mapping\"], providerID, profile); err != nil {\n102|\t\treturn err\n103|\t}\n104|\tif !isJSONObject(members[\"extensions\"]) {\n105|\t\tfailure, err := failProtocol(\"spawn extensions is not an object\", \"extensions\")\n106|\t\tif err != nil {\n107|\t\t\treturn err\n108|\t\t}\n109|\t\treturn failure\n110|\t}\n111|\treturn nil\n112|}\n113|\n114|// isAbsoluteOn reports whether the path is absolute on the\n115|// destination platform. Destination-native is the Section 7.5 rule;\n116|// the platform arrives from the caller because the plan carries none.\n117|func isAbsoluteOn(path string, platform scalar.Platform) bool {\n118|\t_, err := scalar.ParseAbsolutePath(platform, path)\n119|\treturn err == nil\n120|}\n121|\n122|// isBoundedString reports whether the raw JSON string counts 1..max\n123|// Unicode characters. The caller already established it is a string.\n124|func isBoundedString(raw json.RawMessage, min, max int) bool {\n125|\tvalue, ok := rawString(raw)\n126|\tif !ok {\n127|\t\treturn false\n128|\t}\n129|\tlength := runeLength(value)\n130|\treturn length >= min && length <= max\n131|}\n132|\n133|// checkSpawnArgv enforces the Section 5.1 argv limits: 1..128\n134|// elements, each a NUL-free string of 1..4,096 bytes, 65,536 bytes\n135|// total. Byte length is the exec-bound quantity, so elements count\n136|// bytes here while the character-bounded members count runes.\n137|func checkSpawnArgv(raw json.RawMessage) error {\n138|\telements, ok := rawArray(raw)\n139|\tif !ok || len(elements) == 0 || len(elements) > 128 {\n140|\t\tfailure, err := failProtocol(\"spawn argv is empty or longer than 128\", \"argv\")\n141|\t\tif err != nil {\n142|\t\t\treturn err\n143|\t\t}\n144|\t\treturn failure\n145|\t}\n146|\ttotal := 0\n147|\tfor _, element := range elements {\n148|\t\tvalue, ok := rawString(element)\n149|\t\tif !ok || len(value) < 1 || len(value) > 4096 || strings.ContainsRune(value, 0) {\n150|\t\t\tfailure, err := failProtocol(\"spawn argv element is not 1..4096 NUL-free bytes\", \"argv\")\n151|\t\t\tif err != nil {\n152|\t\t\t\treturn err\n153|\t\t\t}\n154|\t\t\treturn failure\n155|\t\t}\n156|\t\ttotal += len(value)\n157|\t}\n158|\tif total > maxSpawnArgvBytes {\n159|\t\tfailure, err := failProtocol(\"spawn argv exceeds 65536 bytes total\", \"argv\")\n160|\t\tif err != nil {\n161|\t\t\treturn err\n162|\t\t}\n163|\t\treturn failure\n164|\t}\n165|\treturn nil\n166|}\n167|\n168|// validEnvName reports whether the name satisfies the Section 5.1\n169|// environment-name grammar: [A-Za-z_][A-Za-z0-9_]{0,127}. The grammar is\n170|// owned by internal/secprim, which also enforces it for launch allowlists;\n171|// this wrapper keeps the Section 5.1 call sites readable while the\n172|// cross-package agreement test pins that the two never diverge.\n173|func validEnvName(name string) bool {\n174|\treturn secprim.IsEnvName(name)\n175|}\n176|\n177|// checkSpawnEnvNames enforces sorted unique environment names\n178|// [0..64] and returns them for the disjointness check.\n179|func checkSpawnEnvNames(raw json.RawMessage) ([]string, error) {\n180|\tnames, ok := rawStringArray(raw)\n181|\tif !ok || len(names) > 64 {\n182|\t\tfailure, err := failProtocol(\"spawn env_names exceed 64 entries\", \"env_names\")\n183|\t\tif err != nil {\n184|\t\t\treturn nil, err\n185|\t\t}\n186|\t\treturn nil, failure\n187|\t}\n188|\tfor _, name := range names {\n189|\t\tif !validEnvName(name) {\n190|\t\t\tfailure, err := failProtocol(\"spawn env_names are not environment names\", \"env_names\")\n191|\t\t\tif err != nil {\n192|\t\t\t\treturn nil, err\n193|\t\t\t}\n194|\t\t\treturn nil, failure\n195|\t\t}\n196|\t}\n197|\tif !sortedUniqueStrings(names) {\n198|\t\tfailure, err := failProtocol(\"spawn env_names are not sorted unique\", \"env_names\")\n199|\t\tif err != nil {\n200|\t\t\treturn nil, err\n201|\t\t}\n202|\t\treturn nil, failure\n203|\t}\n204|\treturn names, nil\n205|}\n206|\n207|// checkSpawnEnvLiterals enforces the literal map: at most 64\n208|// entries, environment-name keys disjoint from env_names, string\n209|// values of at most 4,096 bytes. Keys sort in canonical form on the\n210|// wire; the host reads the set, so order is not rechecked here.\n211|func checkSpawnEnvLiterals(raw json.RawMessage, names []string) error {\n212|\tliterals, fault := decodeStrictObject(raw)\n213|\tif fault != nil {\n214|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n215|\t\tif err != nil {\n216|\t\t\treturn err\n217|\t\t}\n218|\t\treturn failure\n219|\t}\n220|\tif len(literals) > 64 {\n221|\t\tfailure, err := failProtocol(\"spawn env_literals exceed 64 entries\", \"env_literals\")\n222|\t\tif err != nil {\n223|\t\t\treturn err\n224|\t\t}\n225|\t\treturn failure\n226|\t}\n227|\tinherited := map[string]bool{}\n228|\tfor _, name := range names {\n229|\t\tinherited[name] = true\n230|\t}\n231|\tfor key, value := range literals {\n232|\t\tif !validEnvName(key) || inherited[key] {\n233|\t\t\tfailure, err := failProtocol(\"spawn env_literal key is not disjoint\", \"env_literals\")\n234|\t\t\tif err != nil {\n235|\t\t\t\treturn err\n236|\t\t\t}\n237|\t\t\treturn failure\n238|\t\t}\n239|\t\ttext, ok := rawString(value)\n240|\t\tif !ok || len(text) > 4096 || strings.ContainsRune(text, 0) {\n241|\t\t\tfailure, err := failProtocol(\"spawn env_literal is not at most 4096 NUL-free bytes\", \"env_literals\")\n242|\t\t\tif err != nil {\n243|\t\t\t\treturn err\n244|\t\t\t}\n245|\t\t\treturn failure\n246|\t\t}\n247|\t}\n248|\treturn nil\n249|}\n250|\n251|// checkSpawnProfileMapping requires profile_mapping to equal the\n252|// Section 7.7 mapping for the calling provider and profile. A\n253|// provider that answers yolo with the standard omission, or standard\n254|// with a yolo flag, fails here rather than executing under the wrong\n255|// sandbox. Unknown providers and profiles are caller errors that\n256|// propagate from the mapping table.\n257|func checkSpawnProfileMapping(raw json.RawMessage, providerID, profile string) error {\n258|\tmapping, ok := rawString(raw)\n259|\tif !ok || runeLength(mapping) > 512 {\n260|\t\tfailure, err := failProtocol(\"spawn profile_mapping is not at most 512 characters\", \"profile_mapping\")\n261|\t\tif err != nil {\n262|\t\t\treturn err\n263|\t\t}\n264|\t\treturn failure\n265|\t}\n266|\twant, err := ProfileMapping(providerID, profile)\n267|\tif err != nil {\n268|\t\treturn err\n269|\t}\n270|\tif mapping != want {\n271|\t\tfailure, fault := failProtocol(\"spawn profile_mapping does not match the provider profile\", \"profile_mapping\")\n272|\t\tif fault != nil {\n273|\t\t\treturn fault\n274|\t\t}\n275|\t\treturn failure\n276|\t}\n277|\treturn nil\n278|}","final_result":true}}}
