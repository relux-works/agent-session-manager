{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c82f","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":626,"recorded_at":1780531400001247,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"task_stream":{"kind":"task","id":"01a0adcc-653d-7612-8044-de77287460d0"},"task_id":"01a0adcc-653d-7612-8044-de77287460d0","event":{"kind":"output","task_id":"01a0adcc-653d-7612-8044-de77287460d0","chunk":"Read text file `internal/sessstate/decode.go`.\n1|package sessstate\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"fmt\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|const (\n12|\tsessionRecordSchema = \"urn:ax:schema:session-record\"\n13|\tsessionEventSchema  = \"urn:ax:schema:session-event\"\n14|)\n15|\n16|// DecodeRecord projects the reducer's record members from recordJSON:\n17|// strict frame (environ) then member grammars (scalar, environ). It\n18|// deliberately does not attest canonical identity: attestation is\n19|// owned by internal/sessrepo at the durable boundary (and pinned\n20|// there by the provhost no-attestation-outside-the-leaf gate), so a\n21|// second Verify here would fork the attestation owner. Production\n22|// bytes always arrive attested through the repository entries; the\n23|// digest below is the grammar-checked self member of those bytes,\n24|// never a recomputation.\n25|func DecodeRecord(recordJSON []byte) (Record, error) {\n26|\tmembers, fault := environ.DecodeStrictObject(recordJSON)\n27|\tif fault != nil {\n28|\t\treturn Record{}, refuse(ErrInvalidRecord, \"decode session record frame: %v\", fault)\n29|\t}\n30|\tschema, err := stringMember(members, \"schema\")\n31|\tif err != nil || schema != sessionRecordSchema {\n32|\t\treturn Record{}, refuse(ErrInvalidRecord, \"session record schema %q, want %q\", schema, sessionRecordSchema)\n33|\t}\n34|\tsessionID, ok := environ.CheckUUIDv7(members[\"session_id\"])\n35|\tif !ok {\n36|\t\treturn Record{}, refuse(ErrInvalidRecord, \"session record carries no valid session_id member\")\n37|\t}\n38|\trecordID, err := stringMember(members, \"record_id\")\n39|\tif err != nil {\n40|\t\treturn Record{}, refuse(ErrInvalidRecord, \"session record carries no record_id member\")\n41|\t}\n42|\tif _, err := scalar.ParseDigest(recordID); err != nil {\n43|\t\treturn Record{}, refuse(ErrInvalidRecord, \"session record record_id: %v\", err)\n44|\t}\n45|\t// Identity members below were admitted by the canonical closed\n46|\t// shape above through the same owners, so these reads cannot fail\n47|\t// on bytes Verify accepted. The plain errors keep the refusal\n48|\t// funnel for reachable arms only.\n49|\tname, err := stringMember(members, \"name\")\n50|\tif err != nil {\n51|\t\treturn Record{}, fmt.Errorf(\"session record carries no name member: %v\", err)\n52|\t}\n53|\tkind, err := stringMember(members, \"kind\")\n54|\tif err != nil {\n55|\t\treturn Record{}, fmt.Errorf(\"session record carries no kind member: %v\", err)\n56|\t}\n57|\tprovider, err := stringMember(members, \"provider_id\")\n58|\tif err != nil {\n59|\t\treturn Record{}, fmt.Errorf(\"session record carries no provider_id member: %v\", err)\n60|\t}\n61|\tif _, err := scalar.ParseProviderID(provider); err != nil {\n62|\t\treturn Record{}, fmt.Errorf(\"session record provider_id: %v\", err)\n63|\t}\n64|\treturn Record{\n65|\t\tSessionID:  sessionID.String(),\n66|\t\tRecordID:   recordID,\n67|\t\tName:       name,\n68|\t\tKind:       kind,\n69|\t\tProviderID: provider,\n70|\t}, nil\n71|}\n72|\n73|// DecodeEvent projects the routing members plus the payload object the\n74|// reducer reads, under the same no-attestation division as\n75|// DecodeRecord: the closed payload shape was admitted by the canonical\n76|// owner at the sessrepo boundary, and a member that no longer decodes\n77|// refuses the derivation instead of reading as absent.\n78|func DecodeEvent(eventJSON []byte) (Event, error) {\n79|\tmembers, fault := environ.DecodeStrictObject(eventJSON)\n80|\tif fault != nil {\n81|\t\treturn Event{}, refuse(ErrInvalidEvent, \"decode session event frame: %v\", fault)\n82|\t}\n83|\tschema, err := stringMember(members, \"schema\")\n84|\tif err != nil || schema != sessionEventSchema {\n85|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event schema %q, want %q\", schema, sessionEventSchema)\n86|\t}\n87|\tversion, err := stringMember(members, \"schema_version\")\n88|\tif err != nil {\n89|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event carries no schema_version member\")\n90|\t}\n91|\tsessionID, ok := environ.CheckUUIDv7(members[\"session_id\"])\n92|\tif !ok {\n93|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event carries no valid session_id member\")\n94|\t}\n95|\teventType, err := stringMember(members, \"event_type\")\n96|\tif err != nil {\n97|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event carries no event_type member\")\n98|\t}\n99|\tepoch, ok := environ.CheckUint53Bounds(members[\"lease_epoch\"], 1, uint53Max)\n100|\tif !ok {\n101|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event carries no lease_epoch at or above 1\")\n102|\t}\n103|\tleaseID, err := stringMember(members, \"lease_id\")\n104|\tif err != nil {\n105|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event carries no lease_id member\")\n106|\t}\n107|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n108|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event lease_id: %v\", err)\n109|\t}\n110|\tsequence, ok := environ.CheckUint53Bounds(members[\"lease_sequence\"], 1, uint53Max)\n111|\tif !ok {\n112|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event carries no lease_sequence at or above 1\")\n113|\t}\n114|\towner, ok := environ.CheckUUIDv7(members[\"created_by_host_id\"])\n115|\tif !ok {\n116|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event carries no valid created_by_host_id member\")\n117|\t}\n118|\tpredecessors, err := digestMembers(members, \"predecessors\")\n119|\tif err != nil {\n120|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event predecessors: %v\", err)\n121|\t}\n122|\tif len(predecessors) == 0 {\n123|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event names no predecessor\")\n124|\t}\n125|\teventID, err := stringMember(members, \"event_id\")\n126|\tif err != nil {\n127|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event carries no event_id member\")\n128|\t}\n129|\tif _, err := scalar.ParseDigest(eventID); err != nil {\n130|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event event_id: %v\", err)\n131|\t}\n132|\t// The payload object was admitted by the canonical per-type union\n133|\t// at the sessrepo boundary; a non-object here is unreachable on\n134|\t// attested bytes. Plain for the same reason as the record\n135|\t// identity members.\n136|\tpayload, err := objectMember(members, \"payload\")\n137|\tif err != nil {\n138|\t\treturn Event{}, fmt.Errorf(\"session event carries no payload object: %v\", err)\n139|\t}\n140|\treturn Event{\n141|\t\tID:              eventID,\n142|\t\tType:            eventType,\n143|\t\tSchemaVersion:   version,\n144|\t\tSessionID:       sessionID.String(),\n145|\t\tCreatedByHostID: owner.String(),\n146|\t\tLeaseEpoch:      epoch,\n147|\t\tLeaseID:         leaseID,\n148|\t\tSequence:        sequence,\n149|\t\tPredecessors:    predecessors,\n150|\t\tPayload:         payload,\n151|\t}, nil\n152|}\n153|\n154|// uint53Max is the AX safe-integer ceiling from SPEC.md Section 1.6.\n155|// It is passed to the environ bound checker, never re-enforced here.\n156|const uint53Max = uint64(1<<53 - 1)\n157|\n158|// stringMember reads one string member with the language decoder.\n159|// Grammar rules for the value stay with the shape owner. Failures are\n160|// plain errors; the caller attributes them through its own site, so\n161|// the refusal census sees one site per boundary arm, not per helper.\n162|func stringMember(members map[string]json.RawMessage, name string) (string, error) {\n163|\traw, ok := members[name]\n164|\tif !ok {\n165|\t\treturn \"\", fmt.Errorf(\"member %q is absent\", name)\n166|\t}\n167|\tvar value string\n168|\tif err := json.Unmarshal(raw, &value); err != nil {\n169|\t\treturn \"\", fmt.Errorf(\"member %q is not a string: %v\", name, err)\n170|\t}\n171|\treturn value, nil\n172|}\n173|\n174|// digestMembers reads one array of digest strings. Digest grammar stays\n175|// with the scalar owner. Failures are plain errors for the caller to\n176|// attribute.\n177|func digestMembers(members map[string]json.RawMessage, name string) ([]string, error) {\n178|\traw, ok := members[name]\n179|\tif !ok {\n180|\t\treturn nil, fmt.Errorf(\"member %q is absent\", name)\n181|\t}\n182|\tvar values []string\n183|\tif err := json.Unmarshal(raw, &values); err != nil {\n184|\t\treturn nil, fmt.Errorf(\"member %q is not a string array: %v\", name, err)\n185|\t}\n186|\tfor _, value := range values {\n187|\t\tif _, err := scalar.ParseDigest(value); err != nil {\n188|\t\t\treturn nil, fmt.Errorf(\"member %q holds malformed digest %q: %v\", name, value, err)\n189|\t\t}\n190|\t}\n191|\treturn values, nil\n192|}\n193|\n194|// objectMember reads one object member into a decoded map. Failures\n195|// are plain errors for the caller to attribute.\n196|func objectMember(members map[string]json.RawMessage, name string) (map[string]any, error) {\n197|\traw, ok := members[name]\n198|\tif !ok {\n199|\t\treturn nil, fmt.Errorf(\"member %q is absent\", name)\n200|\t}\n201|\tvar object map[string]any\n202|\tif err := json.Unmarshal(raw, &object); err != nil || object == nil {\n203|\t\treturn nil, fmt.Errorf(\"member %q is not an object\", name)\n204|\t}\n205|\treturn object, nil\n206|}\n207|\n208|// payloadString reads one required string from an admitted payload.\n209|func payloadString(payload map[string]any, name string) (string, error) {\n210|\tvalue, ok := payload[name]\n211|\tif !ok {\n212|\t\treturn \"\", refuse(ErrDerivation, \"payload member %q is absent\", name)\n213|\t}\n214|\ttext, ok := value.(string)\n215|\tif !ok {\n216|\t\treturn \"\", refuse(ErrDerivation, \"payload member %q is not a string\", name)\n217|\t}\n218|\treturn text, nil\n219|}\n220|\n221|// payloadBool reads one required boolean from an admitted payload.\n222|func payloadBool(payload map[string]any, name string) (bool, error) {\n223|\tvalue, ok := payload[name]\n224|\tif !ok {\n225|\t\treturn false, refuse(ErrDerivation, \"payload member %q is absent\", name)\n226|\t}\n227|\tflag, ok := value.(bool)\n228|\tif !ok {\n229|\t\treturn false, refuse(ErrDerivation, \"payload member %q is not a boolean\", name)\n230|\t}\n231|\treturn flag, nil\n232|}\n233|\n234|// payloadUint reads one required uint53-range number from an admitted\n235|// payload. JSON numbers decode as float64; range and integrality stay\n236|// with this check, which refuses what the grammar cannot carry.\n237|func payloadUint(payload map[string]any, name string) (uint64, error) {\n238|\tvalue, ok := payload[name]\n239|\tif !ok {\n240|\t\treturn 0, refuse(ErrDerivation, \"payload member %q is absent\", name)\n241|\t}\n242|\tnumber, ok := value.(float64)\n243|\tif !ok || number != float64(uint64(number)) || uint64(number) == 0 || uint64(number) > uint53Max {\n244|\t\treturn 0, refuse(ErrDerivation, \"payload member %q is not a uint53 at or above 1\", name)\n245|\t}\n246|\treturn uint64(number), nil\n247|}\n248|\n249|// payloadNullableDigest reads one required nullable digest from an\n250|// admitted payload: null reports absent without failing, a string must\n251|// parse through the scalar owner.\n252|func payloadNullableDigest(payload map[string]any, name string) (string, bool, error) {\n253|\tvalue, ok := payload[name]\n254|\tif !ok {\n255|\t\treturn \"\", false, refuse(ErrDerivation, \"payload member %q is absent\", name)\n256|\t}\n257|\tif value == nil {\n258|\t\treturn \"\", false, nil\n259|\t}\n260|\ttext, ok := value.(string)\n261|\tif !ok {\n262|\t\treturn \"\", false, refuse(ErrDerivation, \"payload member %q is neither a digest nor null\", name)\n263|\t}\n264|\tif _, err := scalar.ParseDigest(text); err != nil {\n265|\t\treturn \"\", false, refuse(ErrDerivation, \"payload member %q holds malformed digest %q: %v\", name, text, err)\n266|\t}\n267|\treturn text, true, nil\n268|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c831","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":627,"recorded_at":1780531400001249,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"task_stream":{"kind":"task","id":"01a0adcc-653d-7612-8044-de77287460d0"},"task_id":"01a0adcc-653d-7612-8044-de77287460d0","event":{"kind":"completed","task_id":"01a0adcc-653d-7612-8044-de77287460d0"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c833","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":628,"recorded_at":1780531400001251,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"call_id":"call_01a0adcc60bd778086c6c79b5ba4efad","text":"Read text file `internal/sessstate/decode.go`.\n1|package sessstate\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"fmt\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|const (\n12|\tsessionRecordSchema = \"urn:ax:schema:session-record\"\n13|\tsessionEventSchema  = \"urn:ax:schema:session-event\"\n14|)\n15|\n16|// DecodeRecord projects the reducer's record members from recordJSON:\n17|// strict frame (environ) then member grammars (scalar, environ). It\n18|// deliberately does not attest canonical identity: attestation is\n19|// owned by internal/sessrepo at the durable boundary (and pinned\n20|// there by the provhost no-attestation-outside-the-leaf gate), so a\n21|// second Verify here would fork the attestation owner. Production\n22|// bytes always arrive attested through the repository entries; the\n23|// digest below is the grammar-checked self member of those bytes,\n24|// never a recomputation.\n25|func DecodeRecord(recordJSON []byte) (Record, error) {\n26|\tmembers, fault := environ.DecodeStrictObject(recordJSON)\n27|\tif fault != nil {\n28|\t\treturn Record{}, refuse(ErrInvalidRecord, \"decode session record frame: %v\", fault)\n29|\t}\n30|\tschema, err := stringMember(members, \"schema\")\n31|\tif err != nil || schema != sessionRecordSchema {\n32|\t\treturn Record{}, refuse(ErrInvalidRecord, \"session record schema %q, want %q\", schema, sessionRecordSchema)\n33|\t}\n34|\tsessionID, ok := environ.CheckUUIDv7(members[\"session_id\"])\n35|\tif !ok {\n36|\t\treturn Record{}, refuse(ErrInvalidRecord, \"session record carries no valid session_id member\")\n37|\t}\n38|\trecordID, err := stringMember(members, \"record_id\")\n39|\tif err != nil {\n40|\t\treturn Record{}, refuse(ErrInvalidRecord, \"session record carries no record_id member\")\n41|\t}\n42|\tif _, err := scalar.ParseDigest(recordID); err != nil {\n43|\t\treturn Record{}, refuse(ErrInvalidRecord, \"session record record_id: %v\", err)\n44|\t}\n45|\t// Identity members below were admitted by the canonical closed\n46|\t// shape above through the same owners, so these reads cannot fail\n47|\t// on bytes Verify accepted. The plain errors keep the refusal\n48|\t// funnel for reachable arms only.\n49|\tname, err := stringMember(members, \"name\")\n50|\tif err != nil {\n51|\t\treturn Record{}, fmt.Errorf(\"session record carries no name member: %v\", err)\n52|\t}\n53|\tkind, err := stringMember(members, \"kind\")\n54|\tif err != nil {\n55|\t\treturn Record{}, fmt.Errorf(\"session record carries no kind member: %v\", err)\n56|\t}\n57|\tprovider, err := stringMember(members, \"provider_id\")\n58|\tif err != nil {\n59|\t\treturn Record{}, fmt.Errorf(\"session record carries no provider_id member: %v\", err)\n60|\t}\n61|\tif _, err := scalar.ParseProviderID(provider); err != nil {\n62|\t\treturn Record{}, fmt.Errorf(\"session record provider_id: %v\", err)\n63|\t}\n64|\treturn Record{\n65|\t\tSessionID:  sessionID.String(),\n66|\t\tRecordID:   recordID,\n67|\t\tName:       name,\n68|\t\tKind:       kind,\n69|\t\tProviderID: provider,\n70|\t}, nil\n71|}\n72|\n73|// DecodeEvent projects the routing members plus the payload object the\n74|// reducer reads, under the same no-attestation division as\n75|// DecodeRecord: the closed payload shape was admitted by the canonical\n76|// owner at the sessrepo boundary, and a member that no longer decodes\n77|// refuses the derivation instead of reading as absent.\n78|func DecodeEvent(eventJSON []byte) (Event, error) {\n79|\tmembers, fault := environ.DecodeStrictObject(eventJSON)\n80|\tif fault != nil {\n81|\t\treturn Event{}, refuse(ErrInvalidEvent, \"decode session event frame: %v\", fault)\n82|\t}\n83|\tschema, err := stringMember(members, \"schema\")\n84|\tif err != nil || schema != sessionEventSchema {\n85|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event schema %q, want %q\", schema, sessionEventSchema)\n86|\t}\n87|\tversion, err := stringMember(members, \"schema_version\")\n88|\tif err != nil {\n89|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event carries no schema_version member\")\n90|\t}\n91|\tsessionID, ok := environ.CheckUUIDv7(members[\"session_id\"])\n92|\tif !ok {\n93|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event carries no valid session_id member\")\n94|\t}\n95|\teventType, err := stringMember(members, \"event_type\")\n96|\tif err != nil {\n97|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event carries no event_type member\")\n98|\t}\n99|\tepoch, ok := environ.CheckUint53Bounds(members[\"lease_epoch\"], 1, uint53Max)\n100|\tif !ok {\n101|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event carries no lease_epoch at or above 1\")\n102|\t}\n103|\tleaseID, err := stringMember(members, \"lease_id\")\n104|\tif err != nil {\n105|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event carries no lease_id member\")\n106|\t}\n107|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n108|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event lease_id: %v\", err)\n109|\t}\n110|\tsequence, ok := environ.CheckUint53Bounds(members[\"lease_sequence\"], 1, uint53Max)\n111|\tif !ok {\n112|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event carries no lease_sequence at or above 1\")\n113|\t}\n114|\towner, ok := environ.CheckUUIDv7(members[\"created_by_host_id\"])\n115|\tif !ok {\n116|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event carries no valid created_by_host_id member\")\n117|\t}\n118|\tpredecessors, err := digestMembers(members, \"predecessors\")\n119|\tif err != nil {\n120|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event predecessors: %v\", err)\n121|\t}\n122|\tif len(predecessors) == 0 {\n123|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event names no predecessor\")\n124|\t}\n125|\teventID, err := stringMember(members, \"event_id\")\n126|\tif err != nil {\n127|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event carries no event_id member\")\n128|\t}\n129|\tif _, err := scalar.ParseDigest(eventID); err != nil {\n130|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event event_id: %v\", err)\n131|\t}\n132|\t// The payload object was admitted by the canonical per-type union\n133|\t// at the sessrepo boundary; a non-object here is unreachable on\n134|\t// attested bytes. Plain for the same reason as the record\n135|\t// identity members.\n136|\tpayload, err := objectMember(members, \"payload\")\n137|\tif err != nil {\n138|\t\treturn Event{}, fmt.Errorf(\"session event carries no payload object: %v\", err)\n139|\t}\n140|\treturn Event{\n141|\t\tID:              eventID,\n142|\t\tType:            eventType,\n143|\t\tSchemaVersion:   version,\n144|\t\tSessionID:       sessionID.String(),\n145|\t\tCreatedByHostID: owner.String(),\n146|\t\tLeaseEpoch:      epoch,\n147|\t\tLeaseID:         leaseID,\n148|\t\tSequence:        sequence,\n149|\t\tPredecessors:    predecessors,\n150|\t\tPayload:         payload,\n151|\t}, nil\n152|}\n153|\n154|// uint53Max is the AX safe-integer ceiling from SPEC.md Section 1.6.\n155|// It is passed to the environ bound checker, never re-enforced here.\n156|const uint53Max = uint64(1<<53 - 1)\n157|\n158|// stringMember reads one string member with the language decoder.\n159|// Grammar rules for the value stay with the shape owner. Failures are\n160|// plain errors; the caller attributes them through its own site, so\n161|// the refusal census sees one site per boundary arm, not per helper.\n162|func stringMember(members map[string]json.RawMessage, name string) (string, error) {\n163|\traw, ok := members[name]\n164|\tif !ok {\n165|\t\treturn \"\", fmt.Errorf(\"member %q is absent\", name)\n166|\t}\n167|\tvar value string\n168|\tif err := json.Unmarshal(raw, &value); err != nil {\n169|\t\treturn \"\", fmt.Errorf(\"member %q is not a string: %v\", name, err)\n170|\t}\n171|\treturn value, nil\n172|}\n173|\n174|// digestMembers reads one array of digest strings. Digest grammar stays\n175|// with the scalar owner. Failures are plain errors for the caller to\n176|// attribute.\n177|func digestMembers(members map[string]json.RawMessage, name string) ([]string, error) {\n178|\traw, ok := members[name]\n179|\tif !ok {\n180|\t\treturn nil, fmt.Errorf(\"member %q is absent\", name)\n181|\t}\n182|\tvar values []string\n183|\tif err := json.Unmarshal(raw, &values); err != nil {\n184|\t\treturn nil, fmt.Errorf(\"member %q is not a string array: %v\", name, err)\n185|\t}\n186|\tfor _, value := range values {\n187|\t\tif _, err := scalar.ParseDigest(value); err != nil {\n188|\t\t\treturn nil, fmt.Errorf(\"member %q holds malformed digest %q: %v\", name, value, err)\n189|\t\t}\n190|\t}\n191|\treturn values, nil\n192|}\n193|\n194|// objectMember reads one object member into a decoded map. Failures\n195|// are plain errors for the caller to attribute.\n196|func objectMember(members map[string]json.RawMessage, name string) (map[string]any, error) {\n197|\traw, ok := members[name]\n198|\tif !ok {\n199|\t\treturn nil, fmt.Errorf(\"member %q is absent\", name)\n200|\t}\n201|\tvar object map[string]any\n202|\tif err := json.Unmarshal(raw, &object); err != nil || object == nil {\n203|\t\treturn nil, fmt.Errorf(\"member %q is not an object\", name)\n204|\t}\n205|\treturn object, nil\n206|}\n207|\n208|// payloadString reads one required string from an admitted payload.\n209|func payloadString(payload map[string]any, name string) (string, error) {\n210|\tvalue, ok := payload[name]\n211|\tif !ok {\n212|\t\treturn \"\", refuse(ErrDerivation, \"payload member %q is absent\", name)\n213|\t}\n214|\ttext, ok := value.(string)\n215|\tif !ok {\n216|\t\treturn \"\", refuse(ErrDerivation, \"payload member %q is not a string\", name)\n217|\t}\n218|\treturn text, nil\n219|}\n220|\n221|// payloadBool reads one required boolean from an admitted payload.\n222|func payloadBool(payload map[string]any, name string) (bool, error) {\n223|\tvalue, ok := payload[name]\n224|\tif !ok {\n225|\t\treturn false, refuse(ErrDerivation, \"payload member %q is absent\", name)\n226|\t}\n227|\tflag, ok := value.(bool)\n228|\tif !ok {\n229|\t\treturn false, refuse(ErrDerivation, \"payload member %q is not a boolean\", name)\n230|\t}\n231|\treturn flag, nil\n232|}\n233|\n234|// payloadUint reads one required uint53-range number from an admitted\n235|// payload. JSON numbers decode as float64; range and integrality stay\n236|// with this check, which refuses what the grammar cannot carry.\n237|func payloadUint(payload map[string]any, name string) (uint64, error) {\n238|\tvalue, ok := payload[name]\n239|\tif !ok {\n240|\t\treturn 0, refuse(ErrDerivation, \"payload member %q is absent\", name)\n241|\t}\n242|\tnumber, ok := value.(float64)\n243|\tif !ok || number != float64(uint64(number)) || uint64(number) == 0 || uint64(number) > uint53Max {\n244|\t\treturn 0, refuse(ErrDerivation, \"payload member %q is not a uint53 at or above 1\", name)\n245|\t}\n246|\treturn uint64(number), nil\n247|}\n248|\n249|// payloadNullableDigest reads one required nullable digest from an\n250|// admitted payload: null reports absent without failing, a string must\n251|// parse through the scalar owner.\n252|func payloadNullableDigest(payload map[string]any, name string) (string, bool, error) {\n253|\tvalue, ok := payload[name]\n254|\tif !ok {\n255|\t\treturn \"\", false, refuse(ErrDerivation, \"payload member %q is absent\", name)\n256|\t}\n257|\tif value == nil {\n258|\t\treturn \"\", false, nil\n259|\t}\n260|\ttext, ok := value.(string)\n261|\tif !ok {\n262|\t\treturn \"\", false, refuse(ErrDerivation, \"payload member %q is neither a digest nor null\", name)\n263|\t}\n264|\tif _, err := scalar.ParseDigest(text); err != nil {\n265|\t\treturn \"\", false, refuse(ErrDerivation, \"payload member %q holds malformed digest %q: %v\", name, text, err)\n266|\t}\n267|\treturn text, true, nil\n268|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c835","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":629,"recorded_at":1780531400001253,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"call_id":"call_01a0adcc622e77b3bf4405f97297a4ac","text":"Read text file `internal/sessrepo/sessrepo.go`.\n1|package sessrepo\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"errors\"\n6|\t\"fmt\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"sync\"\n10|)\n11|\n12|// uint53Max is the AX safe-integer ceiling from SPEC.md Section 1.6. It is\n13|// passed to the environ bound checker, never re-enforced here.\n14|const uint53Max = uint64(1<<53 - 1)\n15|\n16|const (\n17|\tsessionRecordSchema = \"urn:ax:schema:session-record\"\n18|\tsessionEventSchema  = \"urn:ax:schema:session-event\"\n19|)\n20|\n21|var (\n22|\tErrInvalidRecord   = errors.New(\"invalid session record\")\n23|\tErrSessionExists   = errors.New(\"session already exists\")\n24|\tErrUnknownSession  = errors.New(\"unknown session\")\n25|\tErrInvalidEvent    = errors.New(\"invalid session event\")\n26|\tErrSequenceGap     = errors.New(\"event source sequence gap\")\n27|\tErrSequenceRepeat  = errors.New(\"event source sequence repeat\")\n28|\tErrPredecessorLink = errors.New(\"event predecessor link mismatch\")\n29|\tErrDivergentBranch = errors.New(\"divergent lease branch preserved without application\")\n30|\tErrStaleLease      = errors.New(\"event lease epoch precedes the chain head\")\n31|\tErrChainCorrupt    = errors.New(\"session event chain is corrupt\")\n32|\tErrUnknownEvent    = errors.New(\"unknown session event\")\n33|\tErrNameAmbiguous   = errors.New(\"name_ambiguous\")\n34|\tErrNameNotFound    = errors.New(\"session name not found\")\n35|\tErrRepositoryPath  = errors.New(\"invalid session repository path\")\n36|)\n37|\n38|// refuse is the single refusal funnel every sessrepo rejection flows\n39|// through. It is a var so the census TestMain can wrap it and record the\n40|// production file:line behind each exercised refusal. No production path\n41|// wraps a sentinel with fmt.Errorf directly.\n42|var refuse = func(sentinel error, format string, arguments ...any) error {\n43|\treturn fmt.Errorf(\"%w: %s\", sentinel, fmt.Sprintf(format, arguments...))\n44|}\n45|\n46|// SessionRef names one persisted session: its Session Record digest and ID.\n47|type SessionRef struct {\n48|\tSessionID string\n49|\tRecordID  string\n50|}\n51|\n52|// EventRef names one chained event: its digest, lease sequence, and position.\n53|type EventRef struct {\n54|\tSessionID     string\n55|\tEventID       string\n56|\tLeaseSequence uint64\n57|\tPosition      int\n58|}\n59|\n60|// EventSummary is the chain-index entry for one event, derived from the\n61|// validated event bytes at append time and re-verified against them on load.\n62|type EventSummary struct {\n63|\tEventID       string   `json:\"event_id\"`\n64|\tEventType     string   `json:\"event_type\"`\n65|\tLeaseEpoch    uint64   `json:\"lease_epoch\"`\n66|\tLeaseID       string   `json:\"lease_id\"`\n67|\tLeaseSequence uint64   `json:\"lease_sequence\"`\n68|\tPredecessors  []string `json:\"predecessors\"`\n69|}\n70|\n71|// SessionSummary is the Section 14.4 list projection this leaf owns: stored\n72|// identity plus chain-head facts for a healthy session, or the per-session\n73|// parked channel for an interrupted create or a torn store. Owner host,\n74|// checkpoint age, capability status, and rendered warnings are derived\n75|// downstream, never here; the parked fields below are the facts the\n76|// Section 5.7 reducer and the Section 14.4 rendering leaves project from.\n77|//\n78|// A healthy entry carries Parked=false with empty BlockingReason and\n79|// RetryHint. A parked entry carries Parked=true, SessionID set to the\n80|// session directory name, BlockingReason naming the load failure (a\n81|// recoverable_parked_state block with its per-session cause), and RetryHint\n82|// naming the same-operation retry. Identity members (RecordID, Name, Kind,\n83|// ProviderID) are filled from the parked record when it still verifies;\n84|// a bare directory with no verifiable record leaves them empty.\n85|type SessionSummary struct {\n86|\tSessionID      string\n87|\tRecordID       string\n88|\tName           string\n89|\tKind           string\n90|\tProviderID     string\n91|\tEventCount     int\n92|\tTailEvent      string\n93|\tParked         bool\n94|\tBlockingReason string\n95|\tRetryHint      string\n96|}\n97|\n98|// retryHintForParkedRecord names the same-operation retry for a parked\n99|// session: a record is already parked, so only the byte-identical record\n100|// resumes through CreateSession.\n101|const retryHintForParkedRecord = \"retry CreateSession with the byte-identical session record\"\n102|\n103|// retryHintForBareDirectory names the same-operation retry for a bare\n104|// session directory: no record is parked yet, so CreateSession with the\n105|// session record for this session ID resumes.\n106|const retryHintForBareDirectory = \"retry CreateSession with the session record for this session ID\"\n107|\n108|// CreateStep names one durable boundary inside CreateSession's four-step\n109|// span: the session directory, the record install, the events directory,\n110|// and the chain index install, in that order.\n111|type CreateStep string\n112|\n113|const (\n114|\tCreateStepSessionDir CreateStep = \"session-dir\"\n115|\tCreateStepRecord     CreateStep = \"record\"\n116|\tCreateStepEventsDir  CreateStep = \"events-dir\"\n117|\tCreateStepChain      CreateStep = \"chain\"\n118|)\n119|\n120|// Repository persists Session Records and per-session event chains under\n121|// one data root. All mutating entries serialize on one mutex; files are\n122|// content-addressed and installed no-replace, so the chain is append-only\n123|// by construction and there is no update or delete entry to test.\n124|//\n125|// BeforeWrite fires after validation and before the first durable byte;\n126|// AfterCommit fires after the chain index is durable. AfterCreateStep\n127|// fires after each CreateStep inside CreateSession's four-step span, so\n128|// an interrupted create — not only a fault outside it — is drivable.\n129|// All three are nil in normal operation. Tests connect them to a\n130|// secconftest Injector firing the owner's own points: a fault before\n131|// any durable byte carries safe_retry, and a fault past any durable\n132|// step — including every interior boundary, whose parked state the\n133|// identical retry resumes — carries recoverable_parked_state.\n134|type Repository struct {\n135|\troot            string\n136|\tmutex           sync.Mutex\n137|\tBeforeWrite     func() error\n138|\tAfterCommit     func() error\n139|\tAfterCreateStep func(CreateStep) error\n140|}\n141|\n142|// Open binds a repository to the sessions namespace beneath dataRoot,\n143|// creating it owner-only when absent. The root must be absolute.\n144|func Open(dataRoot string) (*Repository, error) {\n145|\tif !filepath.IsAbs(dataRoot) {\n146|\t\treturn nil, refuse(ErrRepositoryPath, \"data root %q is not absolute\", dataRoot)\n147|\t}\n148|\troot := filepath.Join(dataRoot, \"sessions\")\n149|\tif err := os.MkdirAll(root, 0o700); err != nil {\n150|\t\treturn nil, refuse(ErrRepositoryPath, \"create sessions root %q: %v\", root, err)\n151|\t}\n152|\treturn &Repository{root: root}, nil\n153|}\n154|\n155|// CreateSession validates recordJSON through the canonical owner and\n156|// persists it as a new session. The bytes are stored verbatim.\n157|func (repository *Repository) CreateSession(recordJSON []byte) (SessionRef, error) {\n158|\trecord, err := decodeSessionRecord(recordJSON)\n159|\tif err != nil {\n160|\t\treturn SessionRef{}, err\n161|\t}\n162|\trepository.mutex.Lock()\n163|\tdefer repository.mutex.Unlock()\n164|\tif repository.BeforeWrite != nil {\n165|\t\tif err := repository.BeforeWrite(); err != nil {\n166|\t\t\treturn SessionRef{}, err\n167|\t\t}\n168|\t}\n169|\tdirectory := repository.sessionDir(record.sessionID)\n170|\tif _, err := os.Stat(directory); err == nil {\n171|\t\tresumed, resumeErr := repository.resumeCreateLocked(directory, record, recordJSON)\n172|\t\tif resumeErr != nil {\n173|\t\t\treturn SessionRef{}, resumeErr\n174|\t\t}\n175|\t\tif !resumed {\n176|\t\t\treturn SessionRef{}, refuse(ErrSessionExists, \"session %s already exists\", record.sessionID)\n177|\t\t}\n178|\t} else {\n179|\t\tif err := os.MkdirAll(directory, 0o700); err != nil {\n180|\t\t\treturn SessionRef{}, fmt.Errorf(\"create session directory: %w\", err)\n181|\t\t}\n182|\t\tif err := repository.crashCreateStep(CreateStepSessionDir); err != nil {\n183|\t\t\treturn SessionRef{}, err\n184|\t\t}\n185|\t\tif err := writeExclusive(filepath.Join(directory, \"record.json\"), recordJSON); err != nil {\n186|\t\t\treturn SessionRef{}, fmt.Errorf(\"install session record: %w\", err)\n187|\t\t}\n188|\t\tif err := repository.crashCreateStep(CreateStepRecord); err != nil {\n189|\t\t\treturn SessionRef{}, err\n190|\t\t}\n191|\t\tif err := os.MkdirAll(filepath.Join(directory, \"events\"), 0o700); err != nil {\n192|\t\t\treturn SessionRef{}, fmt.Errorf(\"create session events directory: %w\", err)\n193|\t\t}\n194|\t\tif err := repository.crashCreateStep(CreateStepEventsDir); err != nil {\n195|\t\t\treturn SessionRef{}, err\n196|\t\t}\n197|\t\tif err := repository.writeChain(directory, storedChain{RecordID: record.recordID}); err != nil {\n198|\t\t\treturn SessionRef{}, err\n199|\t\t}\n200|\t\tif err := repository.crashCreateStep(CreateStepChain); err != nil {\n201|\t\t\treturn SessionRef{}, err\n202|\t\t}\n203|\t}\n204|\tif repository.AfterCommit != nil {\n205|\t\tif err := repository.AfterCommit(); err != nil {\n206|\t\t\treturn SessionRef{}, err\n207|\t\t}\n208|\t}\n209|\treturn SessionRef{SessionID: record.sessionID, RecordID: record.recordID}, nil\n210|}\n211|\n212|// crashCreateStep fires the AfterCreateStep hook after one durable create\n213|// step. It is nil-safe: unhooked production never faults. A hook error —\n214|// the injected secconftest fault in tests — propagates unwrapped so the\n215|// caller observes the owner's point and outcome.\n216|func (repository *Repository) crashCreateStep(step CreateStep) error {\n217|\tif repository.AfterCreateStep == nil {\n218|\t\treturn nil\n219|\t}\n220|\treturn repository.AfterCreateStep(step)\n221|}\n222|\n223|// resumeCreateLocked completes a create that crashed inside the four-step\n224|// span. Two parked states resume:\n225|//\n226|//   - record absent: the crash landed after the session directory and\n227|//     before the record install, so nothing committed. The chain index\n228|//     must also be absent — a chain without a record is torn foreign\n229|//     state, never a resume — and the retry's bytes become the record.\n230|//   - record present with the retried bytes and the chain still absent:\n231|//     the crash landed between the record write and the chain write, and\n232|//     the retry completes the index.\n233|//\n234|// Anything else is not a resume — a completed create, or a colliding\n235|// record under a live session ID — and the caller refuses it as an\n236|// existing session. It returns plain operational errors; refusal\n237|// attribution stays at the caller.\n238|func (repository *Repository) resumeCreateLocked(directory string, record sessionRecord, recordJSON []byte) (bool, error) {\n239|\texisting, err := os.ReadFile(filepath.Join(directory, \"record.json\"))\n240|\tif err != nil {\n241|\t\tif !os.IsNotExist(err) {\n242|\t\t\treturn false, fmt.Errorf(\"read session record for resume: %w\", err)\n243|\t\t}\n244|\t\tif _, statErr := os.Stat(filepath.Join(directory, \"chain.json\")); statErr == nil {\n245|\t\t\treturn false, nil\n246|\t\t}\n247|\t\tif err := writeExclusive(filepath.Join(directory, \"record.json\"), recordJSON); err != nil {\n248|\t\t\treturn false, fmt.Errorf(\"install session record on resume: %w\", err)\n249|\t\t}\n250|\t\tif err := os.MkdirAll(filepath.Join(directory, \"events\"), 0o700); err != nil {\n251|\t\t\treturn false, fmt.Errorf(\"recreate session events directory: %w\", err)\n252|\t\t}\n253|\t\tif err := repository.writeChain(directory, storedChain{RecordID: record.recordID}); err != nil {\n254|\t\t\treturn false, err\n255|\t\t}\n256|\t\treturn true, nil\n257|\t}\n258|\tif !bytes.Equal(existing, recordJSON) {\n259|\t\treturn false, nil\n260|\t}\n261|\tif _, err := os.Stat(filepath.Join(directory, \"chain.json\")); err == nil {\n262|\t\treturn false, nil\n263|\t}\n264|\tif err := os.MkdirAll(filepath.Join(directory, \"events\"), 0o700); err != nil {\n265|\t\treturn false, fmt.Errorf(\"recreate session events directory: %w\", err)\n266|\t}\n267|\tif err := repository.writeChain(directory, storedChain{RecordID: record.recordID}); err != nil {\n268|\t\treturn false, err\n269|\t}\n270|\treturn true, nil\n271|}\n272|\n273|// AppendEvent validates eventJSON through the canonical owner and links it\n274|// onto the session chain after the continuity checks. A byte-identical\n275|// retry of an already chained event returns its existing reference without\n276|// duplicating the chain, so a retry after a crashed commit is safe.\n277|func (repository *Repository) AppendEvent(sessionID string, eventJSON []byte) (EventRef, error) {\n278|\tevent, err := decodeSessionEvent(eventJSON)\n279|\tif err != nil {\n280|\t\treturn EventRef{}, err\n281|\t}\n282|\tif event.sessionID != sessionID {\n283|\t\treturn EventRef{}, refuse(ErrInvalidEvent, \"event session %s does not match target session %s\", event.sessionID, sessionID)\n284|\t}\n285|\trepository.mutex.Lock()\n286|\tdefer repository.mutex.Unlock()\n287|\tview, err := repository.loadSessionLocked(sessionID)\n288|\tif err != nil {\n289|\t\treturn EventRef{}, err\n290|\t}\n291|\tfor position, existing := range view.chain.Events {\n292|\t\tif existing.EventID == event.eventID {\n293|\t\t\treturn EventRef{SessionID: sessionID, EventID: event.eventID, LeaseSequence: existing.LeaseSequence, Position: position}, nil\n294|\t\t}\n295|\t}\n296|\tif repository.BeforeWrite != nil {\n297|\t\tif err := repository.BeforeWrite(); err != nil {\n298|\t\t\treturn EventRef{}, err\n299|\t\t}\n300|\t}\n301|\tvar tail *EventSummary\n302|\tif len(view.chain.Events) > 0 {\n303|\t\tprevious := view.chain.Events[len(view.chain.Events)-1]\n304|\t\ttail = &previous\n305|\t}\n306|\tif err := checkAppend(view.chain.RecordID, tail, event); err != nil {\n307|\t\t// Losing-lease branches are preserved as immutable blobs but never\n308|\t\t// applied: the bytes stay addressable while the chain is untouched.\n309|\t\tif errors.Is(err, ErrDivergentBranch) || errors.Is(err, ErrStaleLease) {\n310|\t\t\tif preserveErr := installEventBlob(filepath.Join(view.directory, \"events\", blobFileName(event.eventID)), eventJSON); preserveErr != nil {\n311|\t\t\t\treturn EventRef{}, fmt.Errorf(\"preserve unapplied branch: %v: %w\", preserveErr, err)\n312|\t\t\t}\n313|\t\t}\n314|\t\treturn EventRef{}, err\n315|\t}\n316|\tblobPath := filepath.Join(view.directory, \"events\", blobFileName(event.eventID))\n317|\tif err := installEventBlob(blobPath, eventJSON); err != nil {\n318|\t\tif errors.Is(err, errDigestDisagreement) {\n319|\t\t\treturn EventRef{}, refuse(ErrChainCorrupt, \"digest path holds disagreeing bytes for event\")\n320|\t\t}\n321|\t\treturn EventRef{}, err\n322|\t}\n323|\tnext := append(append([]EventSummary(nil), view.chain.Events...), eventSummary(event))\n324|\tif err := repository.writeChain(view.directory, storedChain{RecordID: view.chain.RecordID, Events: next}); err != nil {\n325|\t\treturn EventRef{}, err\n326|\t}\n327|\tif repository.AfterCommit != nil {\n328|\t\tif err := repository.AfterCommit(); err != nil {\n329|\t\t\treturn EventRef{}, err\n330|\t\t}\n331|\t}\n332|\treturn EventRef{SessionID: sessionID, EventID: event.eventID, LeaseSequence: event.leaseSeq, Position: len(next) - 1}, nil\n333|}\n334|\n335|// eventSummary projects the validated routing members into the chain index.\n336|func eventSummary(event eventView) EventSummary {\n337|\treturn EventSummary{EventID: event.eventID, EventType: event.eventType, LeaseEpoch: event.leaseEpoch, LeaseID: event.leaseID, LeaseSequence: event.leaseSeq, Predecessors: append([]string(nil), event.predecessors...)}\n338|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
