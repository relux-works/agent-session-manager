{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d7e5","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":2637,"recorded_at":1780531400005269,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"task_stream":{"kind":"task","id":"01a0addd-ec87-7a11-9ffd-34b0ec8a0ce0"},"task_id":"01a0addd-ec87-7a11-9ffd-34b0ec8a0ce0","event":{"kind":"output","task_id":"01a0addd-ec87-7a11-9ffd-34b0ec8a0ce0","chunk":"edited\nchanged lines: lines 235-260\n--- original\n+++ updated\n@@\n-// sameEnvelope reports whether the committed change is the request\n-// already applied: the same profile.changed ends under the same\n-// lease, author, and instant. Confirmation is deliberately not\n-// part of the envelope: a replay commits nothing new, and the\n-// original commit already carried the confirmation its mint\n-// required.\n-func sameEnvelope(committed Event, request SetProfileRequest, from string) bool {\n-\tif committed.Type != \"profile.changed\" {\n-\t\treturn false\n-\t}\n-\tpayloadFrom, ok := payloadString(committed.Payload, \"from\")\n-\tif !ok || payloadFrom != from {\n-\t\treturn false\n-\t}\n-\tpayloadTo, ok := payloadString(committed.Payload, \"to\")\n-\tif !ok || payloadTo != request.To {\n-\t\treturn false\n-\t}\n-\tif committed.LeaseEpoch != request.LeaseEpoch || committed.LeaseID != request.LeaseID {\n-\t\treturn false\n-\t}\n-\tif committed.CreatedByHostID != request.CreatedByHostID || committed.CreatedAt != request.CreatedAt {\n-\t\treturn false\n-\t}\n-\treturn true\n-}\n+// sameEnvelope reports whether the committed change is the request\n+// already applied: the same target under the same lease, author,\n+// and instant. The from end is deliberately not compared: from is\n+// derived, not requested, and the committed from necessarily\n+// differs from the current profile (a change never targets its\n+// own source). Confirmation is likewise not part of the envelope:\n+// a replay commits nothing new, and the original commit already\n+// carried the confirmation its mint required.\n+func sameEnvelope(committed Event, request SetProfileRequest) bool {\n+\tif committed.Type != \"profile.changed\" {\n+\t\treturn false\n+\t}\n+\tpayloadTo, ok := payloadString(committed.Payload, \"to\")\n+\tif !ok || payloadTo != request.To {\n+\t\treturn false\n+\t}\n+\tif committed.LeaseEpoch != request.LeaseEpoch || committed.LeaseID != request.LeaseID {\n+\t\treturn false\n+\t}\n+\tif committed.CreatedByHostID != request.CreatedByHostID || committed.CreatedAt != request.CreatedAt {\n+\t\treturn false\n+\t}\n+\treturn true\n+}\n","final_result":true}}}
