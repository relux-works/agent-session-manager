{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d6f5","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":2517,"recorded_at":1780531400005029,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"task_stream":{"kind":"task","id":"01a0addd-0fc0-7593-a5fa-014fa207e9a8"},"task_id":"01a0addd-0fc0-7593-a5fa-014fa207e9a8","event":{"kind":"output","task_id":"01a0addd-0fc0-7593-a5fa-014fa207e9a8","chunk":"edited\nchanged lines: lines 33-49\n--- original\n+++ updated\n@@\n-func TestDeriveSecondChangeSupersedesFirst(t *testing.T) {\n-\trepository := openTestRepository(t)\n-\treference := createTestSession(t, repository, testSessionID, \"payments-api\", ProfileStandard)\n-\tfirst := appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n-\tappendTestEvent(t, repository, testSessionID, []string{first}, 1, testLeaseID, 2, \"profile.changed\", changedPayload(ProfileStandard, ProfileYOLO, true))\n-\tsecond := appendTestEvent(t, repository, testSessionID, []string{first}, 1, testLeaseID, 2, \"profile.changed\", changedPayload(ProfileStandard, ProfileYOLO, true))\n-\t_ = second\n-\trecord, events := decodeTestChain(t, repository, testSessionID)\n-\tpair, err := Derive(record, events)\n-\tif err != nil {\n-\t\tt.Fatalf(\"Derive error = %v\", err)\n-\t}\n-\t// The chain holds exactly one change (the second append above is\n-\t// a duplicate sequence the repository refuses) — this test\n-\t// therefore rebuilds with two successive changes instead.\n-\t_ = pair\n-}\n+func TestDeriveSecondChangeSupersedesFirst(t *testing.T) {\n+\trepository := openTestRepository(t)\n+\treference := createTestSession(t, repository, testSessionID, \"payments-api\", ProfileStandard)\n+\tfirst := appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n+\tmiddle := appendTestEvent(t, repository, testSessionID, []string{first}, 1, testLeaseID, 2, \"profile.changed\", changedPayload(ProfileStandard, ProfileYOLO, true))\n+\t// A second change under a successor lease supersedes the first:\n+\t// newest in lease/sequence order governs.\n+\tsecond := appendTestEvent(t, repository, testSessionID, []string{middle}, 2, testLeaseIDB, 1, \"profile.changed\", changedPayload(ProfileYOLO, ProfileStandard, false))\n+\trecord, events := decodeTestChain(t, repository, testSessionID)\n+\tpair, err := Derive(record, events)\n+\tif err != nil {\n+\t\tt.Fatalf(\"Derive error = %v\", err)\n+\t}\n+\tmustPairEqual(t, pair, Pair{Profile: ProfileStandard, Source: second, HasSource: true}, \"Derive(second change)\")\n+}\n","final_result":true}}}
