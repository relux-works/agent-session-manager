d the four Section 15.1 detail classes that an exact key name makes decidable.\\n//\\n// The nesting bound counts containers opened by a detail value, matching the\\n// extension-value convention already used for canonical records: a value may\\n// open four containers and the fifth is refused.\\nfunc ValidateDetails(details Details) error {\\n\\tif details == nil {\\n\\t\\treturn fmt.Errorf(\\\"%w: details is required and must not be null\\\", ErrInvalidDetails)\\n===\\n189:func ExitCodeFor(version Version, code Code) (int, error) {\\n190-\\tif !isRegisteredVersion(version) {\\n191-\\t\\treturn 0, fmt.Errorf(\\\"%w: %q\\\", ErrUnsupportedVersion, version)\\n192-\\t}\\n193-\\tentry, known := codeRegistry[code]\\n194-\\tif !known {\\n195-\\t\\treturn 0, fmt.Errorf(\\\"%w: %q is not a Structured Error code\\\", ErrUnregisteredCode, code)\\n196-\\t}\\n197-\\tif _, admitted := entry.versions[version]; !admitted {\\n198-\\t\\treturn 0, fmt.Errorf(\\\"%w: %q is not registered by Structured Error %s\\\", ErrUnregisteredCode, code, version)\\n199-\\t}\\n200-\\treturn entry.exitCode, nil\\n201-}\\n202-\\n203-// ExitStatusMeaning returns the Section 15.2 meaning of a registered exit\\n204-// status. The second result is false for any status the registry does not\\n205-// carry, so an unregistered status is reported as unknown rather than given a\\n206-// plausible meaning.\\n207-func ExitStatusMeaning(status int) (string, bool) {\\n208-\\tmeaning, ok := exitMeanings[status]\\n209-\\treturn meaning, ok\\n\",\n  \"original_output_bytes\": 5822,\n  \"original_output_tokens\": 1456,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
