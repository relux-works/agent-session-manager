{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d4f1","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":2259,"recorded_at":1780531400004513,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"task_stream":{"kind":"task","id":"01a0add9-b1a3-77b2-b96f-36ed787afa53"},"task_id":"01a0add9-b1a3-77b2-b96f-36ed787afa53","event":{"kind":"output","task_id":"01a0add9-b1a3-77b2-b96f-36ed787afa53","chunk":"{\n  \"chunk_id\": \"exec-51-1\",\n  \"command\": \"sed -n 19,120p internal/axerror/details.go; echo ===; grep -n 'func ExitCodeFor' -A 20 internal/axerror/registry.go | head -30\",\n  \"description\": \"Read detail validation and exit resolution\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"type Details map[string]any\\n\\nvar (\\n\\t// ErrInvalidDetails reports a diagnostic map outside the Section 15.1\\n\\t// shape, bounds, or redaction rules.\\n\\tErrInvalidDetails = errors.New(\\\"invalid structured error details\\\")\\n\\n\\t// ErrCausalLeak reports human text or a diagnostic value that reproduces\\n\\t// the rendered text of the Go cause the failure was built from. The cause\\n\\t// chain stays local; it is never copied onto the wire.\\n\\tErrCausalLeak = errors.New(\\\"structured error would carry its cause onto the wire\\\")\\n)\\n\\n// detailKeyPattern is the Section 15.1 constraint on detail keys, verbatim:\\n// \\\"0-64 keys matching [a-z][a-z0-9_]{0,63}\\\".\\nvar detailKeyPattern = regexp.MustCompile(`^[a-z][a-z0-9_]{0,63}$`)\\n\\nconst (\\n\\tmaxDetailKeys      = 64\\n\\tmaxDetailDepth     = 4\\n\\tmaxDetailCanonical = 16 * 1024\\n\\tminRedactableCause = 8\\n\\tmaxMessageRunes    = 4096\\n\\tminMessageRunes    = 1\\n)\\n\\n// excludedDetailKeys is the best-effort scanner Section 16.2 says an\\n// implementation SHOULD offer. It refuses a detail key that names one of the\\n// four classes Section 15.1 forbids outright — \\\"No detail may contain a\\n// credential, raw transcript, environment secret, or opaque bundle content\\\" —\\n// and nothing else.\\n//\\n// Matching is exact, never by substring, and that is deliberate. A substring\\n// rule refusing every key containing \\\"token\\\", \\\"socket\\\" or \\\"credential\\\" would\\n// refuse \\\"token_count\\\", \\\"socket_timeout_ms\\\" and \\\"credential_profile\\\" — ordinary\\n// diagnostics the specification admits — while still passing a secret written\\n// under an innocuous name. That is pure false-positive surface with no\\n// true-positive capability, and it is the exact defect removed from the\\n// Configuration extension-key validator: where the pinned document is silent\\n// about a name, be permissive.\\n//\\n// The list is also scoped to Section 15.1's four classes rather than to the\\n// whole Section 16.2 exclusion table. Section 16.2 governs manifests and\\n// bundles generated by ax; a diagnostic key naming a PID, a tmux socket or a\\n// Terminal Instance Binding is not a credential, a transcript, an environment\\n// secret, or bundle content, and refusing it here would invent a constraint the\\n// error contract does not state.\\nvar excludedDetailKeys = map[string]string{\\n\\t// Credential.\\n\\t\\\"access_token\\\":       \\\"credential\\\",\\n\\t\\\"api_key\\\":            \\\"credential\\\",\\n\\t\\\"auth_json\\\":          \\\"credential\\\",\\n\\t\\\"cookie\\\":             \\\"credential\\\",\\n\\t\\\"cookies\\\":            \\\"credential\\\",\\n\\t\\\"credential\\\":         \\\"credential\\\",\\n\\t\\\"credentials\\\":        \\\"credential\\\",\\n\\t\\\"oauth_token\\\":        \\\"credential\\\",\\n\\t\\\"passphrase\\\":         \\\"credential\\\",\\n\\t\\\"password\\\":           \\\"credential\\\",\\n\\t\\\"private_key\\\":        \\\"credential\\\",\\n\\t\\\"refresh_token\\\":      \\\"credential\\\",\\n\\t\\\"session_token\\\":      \\\"credential\\\",\\n\\t\\\"ssh_private_key\\\":    \\\"credential\\\",\\n\\t\\\"subscription_token\\\": \\\"credential\\\",\\n\\t// Raw transcript.\\n\\t\\\"raw_transcript\\\":      \\\"raw transcript\\\",\\n\\t\\\"scrollback\\\":          \\\"raw transcript\\\",\\n\\t\\\"terminal_scrollback\\\": \\\"raw transcript\\\",\\n\\t\\\"transcript\\\":          \\\"raw transcript\\\",\\n\\t// Environment secret.\\n\\t\\\"dotenv\\\":             \\\"environment secret\\\",\\n\\t\\\"env_secret\\\":         \\\"environment secret\\\",\\n\\t\\\"environment_secret\\\": \\\"environment secret\\\",\\n\\t\\\"secret\\\":             \\\"environment secret\\\",\\n\\t\\\"secrets\\\":            \\\"environment secret\\\",\\n\\t// Opaque bundle content.\\n\\t\\\"bundle_bytes\\\":   \\\"opaque bundle content\\\",\\n\\t\\\"bundle_content\\\": \\\"opaque bundle content\\\",\\n\\t\\\"opaque_bundle\\\":  \\\"opaque bundle content\\\",\\n}\\n\\n// RedactionBound states what the gates below can and cannot decide. It is\\n// quoted in README.md and asserted by this package's tests so that no caller\\n// reads a refusal as a confidentiality guarantee. Section 16.2 is explicit:\\n// \\\"v0.5.0 does not claim reliable content-level secret scrubbing\\\", and this\\n// implementation claims no more than the pinned document does.\\nconst RedactionBound = \\\"Detail redaction decides two things: whether a key exactly names one of the four classes \\\" +\\n\\t\\\"Section 15.1 forbids, and whether human text or a diagnostic value reproduces the rendered local cause \\\" +\\n\\t\\\"verbatim. It inspects no free-form value for secret content, matches no key by substring, and admits a \\\" +\\n\\t\\\"secret written under an innocuously named key. Section 16.2 does not claim content-level scrubbing and \\\" +\\n\\t\\\"neither does this package.\\\"\\n\\n// ValidateDetails checks a diagnostic map against every Section 15.1 bound: the\\n// key count, the key grammar, the value nesting depth, the canonical byte size,\\n// and the four Section 15.1 detail classes that an exact key name makes decidable.\\n//\\n// The nesting bound counts containers opened by a detail value, matching the\\n// extension-value convention already used for canonical records: a value may\\n// open four containers and the fifth is refused.\\nfunc ValidateDetails(details Details) error {\\n\\tif details == nil {\\n\\t\\treturn fmt.Errorf(\\\"%w: details is required and must not be null\\\", ErrInvalidDetails)\\n===\\n189:func ExitCodeFor(version Version, code Code) (int, error) {\\n190-\\tif !isRegisteredVersion(version) {\\n191-\\t\\treturn 0, fmt.Errorf(\\\"%w: %q\\\", ErrUnsupportedVersion, version)\\n192-\\t}\\n193-\\tentry, known := codeRegistry[code]\\n194-\\tif !known {\\n195-\\t\\treturn 0, fmt.Errorf(\\\"%w: %q is not a Structured Error code\\\", ErrUnregisteredCode, code)\\n196-\\t}\\n197-\\tif _, admitted := entry.versions[version]; !admitted {\\n198-\\t\\treturn 0, fmt.Errorf(\\\"%w: %q is not registered by Structured Error %s\\\", ErrUnregisteredCode, code, version)\\n199-\\t}\\n200-\\treturn entry.exitCode, nil\\n201-}\\n202-\\n203-// ExitStatusMeaning returns the Section 15.2 meaning of a registered exit\\n204-// status. The second result is false for any status the registry does not\\n205-// carry, so an unregistered status is reported as unknown rather than given a\\n206-// plausible meaning.\\n207-func ExitStatusMeaning(status int) (string, bool) {\\n208-\\tmeaning, ok := exitMeanings[status]\\n209-\\treturn meaning, ok\\n\",\n  \"original_output_bytes\": 5822,\n  \"original_output_tokens\": 1456,\n  \"truncated\": false\n}","final_result":true}}}
