{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000de3f","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":3450,"recorded_at":1780531400006895,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"call_id":"call_01a0ade2bdbb7300af32b4568c8ddf99","text":"Read text file `internal/provhost/inventory_test.go`.\n(119 line(s) above)\n120|\t// vacuously — the same \"the scan is blind\" floor the discovery\n121|\t// package carries on its own scans.\n122|\tif len(inventory.ScannedFiles) == 0 {\n123|\t\tfailures = append(failures, \"scanned no production sources; the check is blind\")\n124|\t}\n125|\tif len(inventory.Sites) == 0 {\n126|\t\tfailures = append(failures, \"derived no refusal sites; the scan is blind\")\n127|\t}\n128|\t// Reverse direction: every exercised refusal site must resolve to a\n129|\t// derived site. The exercised set comes from the test run, not from\n130|\t// a hand list, so a truncated derivation reddens here even though\n131|\t// the forward check passes vacuously.\n132|\tderived := map[string]struct{}{}\n133|\tfor _, site := range inventory.Sites {\n134|\t\tderived[site] = struct{}{}\n135|\t}\n136|\t// Both directions run through the shared harness: derived sites\n137|\t// without an exercised path (forward) and exercised sites outside\n138|\t// the derivation (reverse) fail together.\n139|\tmissing, outside, scanFailures := invcore.DiffSets(derived, refusalRecorder.Sites())\n140|\tfailures = append(failures, scanFailures...)\n141|\tif len(outside) != 0 {\n142|\t\tfailures = append(failures, \"exercised refusal sites outside the derived inventory; the derivation is short: \"+strings.Join(outside, \", \"))\n143|\t}\n144|\tif len(inventory.StrayBuilders) != 0 {\n145|\t\tsort.Strings(inventory.StrayBuilders)\n146|\t\tfailures = append(failures, \"provhost failures built outside the refusal constructors: \"+strings.Join(inventory.StrayBuilders, \", \"))\n147|\t}\n148|\tif len(inventory.RawConstructors) != 0 {\n149|\t\tsort.Strings(inventory.RawConstructors)\n150|\t\tfailures = append(failures, \"provhost raw error construction: \"+strings.Join(inventory.RawConstructors, \", \"))\n151|\t}\n152|\tif len(missing) != 0 {\n153|\t\tfailures = append(failures, \"provhost refusal call sites without an exercised negative path: \"+strings.Join(missing, \", \"))\n154|\t}\n155|\tcodes := refusalRecorder.Codes()\n156|\twant := []string{\"incompatible_protocol\", \"integrity_failure\", \"invalid_config\", \"provider_process_failed\", \"provider_protocol_error\", \"provider_timeout\"}\n157|\tif fmt.Sprintf(\"%v\", codes) != fmt.Sprintf(\"%v\", want) {\n158|\t\tfailures = append(failures, fmt.Sprintf(\"observed refusal codes = %v, want closed set %v\", codes, want))\n159|\t}\n160|\treturn failures\n161|}\n162|\n163|// refusalInventory is derived from package sources.\n164|type refusalInventory struct {\n165|\t// ScannedFiles are the production source basenames the derivation\n166|\t// parsed. The audit fails closed when this is empty.\n167|\tScannedFiles []string\n168|\t// Sites are file:line positions of production refusal constructor\n169|\t// calls. Every constructor call must sit on a single source line so\n170|\t// the runtime site and the parsed site agree.\n171|\tSites []string\n172|\t// StrayBuilders are axerror.New or axerror.LocalFromUntrusted calls\n173|\t// outside a constructor body.\n174|\tStrayBuilders []string\n175|\t// RawConstructors are errors.New, fmt.Errorf, or panic calls\n176|\t// anywhere in production code. There is no allowlist: dynamic facts\n177|\t// travel in Structured Error details, never in Go error text.\n178|\tRawConstructors []string\n179|}\n180|\n181|var refusalConstructors = map[string]bool{\n182|\t\"failInvalid\":   true,\n183|\t\"failProtocol\":  true,\n184|\t\"failMismatch\":  true,\n185|\t\"failProcess\":   true,\n186|\t\"failTimeout\":   true,\n187|\t\"failIntegrity\": true,\n188|}\n189|\n190|func deriveRefusalInventory(directory string) (refusalInventory, error) {\n191|\tscannedFiles, fileSet, failures := invcore.ScanProduction(directory)\n192|\tif len(failures) != 0 {\n193|\t\treturn refusalInventory{}, errors.New(strings.Join(failures, \"; \"))\n194|\t}\n195|\tvar inventory refusalInventory\n196|\tfor _, production := range scannedFiles {\n197|\t\tname, syntax := production.Name, production.Syntax\n198|\t\tinventory.ScannedFiles = append(inventory.ScannedFiles, name)\n199|\t\t// Map each constructor's own body span so builder calls inside\n200|\t\t// it are not mistaken for strays.\n201|\t\tconstructorBodies := map[*ast.FuncLit]bool{}\n202|\t\tfor _, decl := range syntax.Decls {\n203|\t\t\tgeneral, ok := decl.(*ast.GenDecl)\n204|\t\t\tif !ok {\n205|\t\t\t\tcontinue\n206|\t\t\t}\n207|\t\t\tfor _, spec := range general.Specs {\n208|\t\t\t\tvalues, ok := spec.(*ast.ValueSpec)\n209|\t\t\t\tif !ok {\n210|\t\t\t\t\tcontinue\n211|\t\t\t\t}\n212|\t\t\t\tfor i, ident := range values.Names {\n213|\t\t\t\t\tif !refusalConstructors[ident.Name] || i >= len(values.Values) {\n214|\t\t\t\t\t\tcontinue\n215|\t\t\t\t\t}\n216|\t\t\t\t\tif literal, ok := values.Values[i].(*ast.FuncLit); ok {\n217|\t\t\t\t\t\tconstructorBodies[literal] = true\n218|\t\t\t\t\t}\n219|\t\t\t\t}\n220|\t\t\t}\n221|\t\t}\n222|\t\tinsideConstructor := func(pos token.Pos) bool {\n223|\t\t\tfor body := range constructorBodies {\n224|\t\t\t\tif pos >= body.Pos() && pos <= body.End() {\n225|\t\t\t\t\treturn true\n226|\t\t\t\t}\n227|\t\t\t}\n228|\t\t\treturn false\n229|\t\t}\n230|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n231|\t\t\tcall, ok := node.(*ast.CallExpr)\n232|\t\t\tif !ok {\n233|\t\t\t\treturn true\n234|\t\t\t}\n235|\t\t\tposition := fileSet.Position(call.Pos())\n236|\t\t\tsite := fmt.Sprintf(\"%s:%d\", filepath.Base(position.Filename), position.Line)\n237|\t\t\tif ident, ok := call.Fun.(*ast.Ident); ok {\n238|\t\t\t\tif refusalConstructors[ident.Name] {\n239|\t\t\t\t\tinventory.Sites = append(inventory.Sites, site)\n240|\t\t\t\t\treturn true\n241|\t\t\t\t}\n242|\t\t\t\tif ident.Name == \"panic\" {\n243|\t\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" panic\")\n244|\t\t\t\t\treturn true\n245|\t\t\t\t}\n246|\t\t\t}\n247|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n248|\t\t\tif !ok {\n249|\t\t\t\treturn true\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
