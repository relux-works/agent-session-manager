{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9a3","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":812,"recorded_at":1780531400001619,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"task_stream":{"kind":"task","id":"01a0adcc-e80e-7670-a6b6-2f3a14fe95b2"},"task_id":"01a0adcc-e80e-7670-a6b6-2f3a14fe95b2","event":{"kind":"output","task_id":"01a0adcc-e80e-7670-a6b6-2f3a14fe95b2","chunk":"Read text file `internal/sessquery/lease.go`.\n1|// Validated Lease Record admission for the v0.6.0 selector contract\n2|// (SPEC Sections 5.3 and 14.7.2).\n3|//\n4|// The reader carries canonical Lease Record bytes from the lease owner\n5|// in Reader.LeaseRecords. Each record is validated through the\n6|// canonicaljson owner (closed shape plus canonical self identity), and\n7|// the greatest (epoch, lease_id) winner per session supplies the plan\n8|// lease_record_id digest with its epoch, lease ID, and holder. Envelope\n9|// triples observed on event chains never substitute for these records:\n10|// a session with no admitted winning record refuses\n11|// selector_observation_unavailable, and malformed bytes refuse\n12|// invalid_config.\n13|package sessquery\n14|\n15|import (\n16|\t\"encoding/json\"\n17|\t\"fmt\"\n18|\n19|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n20|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n21|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n22|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n23|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n24|)\n25|\n26|const leaseRecordSchema = \"urn:ax:schema:lease\"\n27|\n28|// validatedLease is one admitted Lease Record: its canonical digest and\n29|// the members the selector binds.\n30|type validatedLease struct {\n31|\tDigest         string\n32|\tSessionID      string\n33|\tLeaseID        string\n34|\tEpoch          uint64\n35|\tHolderHostID   string\n36|\tPredecessor    string\n37|\tHasPredecessor bool\n38|\tCheckpoint     string\n39|\tHasCheckpoint  bool\n40|\tRaw            []byte\n41|}\n42|\n43|// checkpointRecordSchema is the exact Checkpoint Record schema the\n44|// winning-lease checkpoint gate admits.\n45|const checkpointRecordSchema = \"urn:ax:schema:checkpoint\"\n46|\n47|// validatedCheckpoint is the parsed canonical Checkpoint Record shape,\n48|// not yet an admitted authority capability: it carries the digest with\n49|// the session and lease it was taken under, plus the host that created\n50|// it. Section 5.4 binds lease_epoch/lease_id to the\n51|// referenced winning lease, so a successor's checkpoint names its\n52|// predecessor lease, and binds created_by_host_id to the current\n53|// lease holder: the holder of the lease the checkpoint names. The\n54|// persistence presence members carry which variant the record uses;\n55|// the referenced Session Record selects which variant is valid\n56|// (checkCheckpointPersistence), because canonical shape alone admits\n57|// either variant. EventHeads carries the authoritative event DAG\n58|// heads immediately before the checkpoint object; every required\n59|// checkpoint must resolve each head to a chained event for its\n60|// session at or before its bound lease\n61|// (checkCheckpointEventHeads), because a canonical checkpoint\n62|// naming an absent event or an event under a later lease cannot\n63|// establish Section 5.3/14.7.2 current complete authority. The same\n64|// closure must then admit the Section 2.4 profile authority\n65|// (checkCheckpointProfileAuthority), because a canonical checkpoint\n66|// over a corrupt profile history cannot fix the effective profile.\n67|type validatedCheckpoint struct {\n68|\tDigest              string\n69|\tSessionID           string\n70|\tLeaseEpoch          uint64\n71|\tLeaseID             string\n72|\tCreatorHostID       string\n73|\tHasProviderManifest bool\n74|\tHasTaskBoardBundle  bool\n75|\tEventHeads          []string\n76|\tRaw                 []byte\n77|}\n78|\n79|// checkpointSealToken is deliberately unexported and is created only by the\n80|// free admitCheckpoint constructor. The type-level census protects that\n81|// construction boundary across every production source file; the token then\n82|// makes a zero or field-assembled admittedCheckpoint unusable at runtime.\n83|type checkpointSealToken struct{}\n84|\n85|// checkpointSeal holds the facts that profile derivation may consume after\n86|// semantic admission. Its fields are private so callers cannot treat the\n87|// admitted representation as a public record-shaped DTO.\n88|type checkpointSeal struct {\n89|\ttoken               *checkpointSealToken\n90|\tdigest              string\n91|\tsessionID           string\n92|\tleaseEpoch          uint64\n93|\tleaseID             string\n94|\tcreatorHostID       string\n95|\thasProviderManifest bool\n96|\thasTaskBoardBundle  bool\n97|\teventHeads          []string\n98|}\n99|\n100|// admittedCheckpoint is the only checkpoint representation that profile\n101|// derivation may consume. A validatedCheckpoint is still a loader/admission\n102|// concern: canonical parsing alone does not establish its session, lease,\n103|// holder, persistence, event-head, or temporal authority. The unexported seal\n104|// is the capability; without its constructor-only token the value is not\n105|// admitted, even when a caller assembles the outer struct manually.\n106|type admittedCheckpoint struct {\n107|\tseal *checkpointSeal\n108|}\n109|\n110|func (checkpoint admittedCheckpoint) authority() (*checkpointSeal, error) {\n111|\tif checkpoint.seal == nil || checkpoint.seal.token == nil {\n112|\t\treturn nil, fmt.Errorf(\"%w: checkpoint authority seal is missing\", ErrObservationUnavailable)\n113|\t}\n114|\treturn checkpoint.seal, nil\n115|}\n116|\n117|// checkpointAdmission is the narrow capability handed to profile derivation\n118|// for a session.resumed reference. The derivation path can request a named\n119|// checkpoint, but it cannot obtain or consume a raw validated record.\n120|type checkpointAdmission func(checkpointID, sessionID string, summary sessrepo.EventSummary) (admittedCheckpoint, error)\n121|\n122|// parseLeaseRecord validates one canonical Lease Record through the\n123|// canonicaljson owner and extracts the bound members. Closed-shape and\n124|// identity failures refuse invalid_config; the caller maps absence to\n125|// observation_unavailable.\n126|func parseLeaseRecord(raw []byte) (validatedLease, error) {\n127|\tvar lease validatedLease\n128|\tmembers, fault := environ.DecodeStrictObject(raw)\n129|\tif fault != nil {\n130|\t\treturn lease, fmt.Errorf(\"%w: decode lease record frame: %v\", ErrInvalidConfig, fault)\n131|\t}\n132|\tschema, err := leaseStringMember(members, \"schema\")\n133|\tif err != nil || schema != leaseRecordSchema {\n134|\t\treturn lease, fmt.Errorf(\"%w: lease record schema %q, want %q\", ErrInvalidConfig, schema, leaseRecordSchema)\n135|\t}\n136|\tdigest, field, err := sessrepo.AttestLeaseRecord(raw)\n137|\tif err != nil {\n138|\t\treturn lease, fmt.Errorf(\"%w: verify lease record identity: %v\", ErrInvalidConfig, err)\n139|\t}\n140|\tif field != canonicaljson.SelfRecordID {\n141|\t\treturn lease, fmt.Errorf(\"%w: lease record identity field %q, want record_id\", ErrInvalidConfig, string(field))\n142|\t}\n143|\tsessionID, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"session_id\"))\n144|\tif !ok {\n145|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no valid session_id member\", ErrInvalidConfig)\n146|\t}\n147|\tleaseID, err := leaseStringMember(members, \"lease_id\")\n148|\tif err != nil {\n149|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no lease_id member: %v\", ErrInvalidConfig, err)\n150|\t}\n151|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n152|\t\treturn lease, fmt.Errorf(\"%w: lease record lease_id: %v\", ErrInvalidConfig, err)\n153|\t}\n154|\tepoch, ok := environ.CheckUint53Bounds(leaseMemberRaw(members, \"epoch\"), 1, uint53Ceiling)\n155|\tif !ok {\n156|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no epoch at or above 1\", ErrInvalidConfig)\n157|\t}\n158|\tholder, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"holder_host_id\"))\n159|\tif !ok {\n160|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no valid holder_host_id member\", ErrInvalidConfig)\n161|\t}\n162|\tpredecessor, hasPredecessor, err := leaseNullableUUIDv4(members, \"predecessor_lease_id\")\n163|\tif err != nil {\n164|\t\treturn lease, fmt.Errorf(\"%w: lease record predecessor_lease_id: %v\", ErrInvalidConfig, err)\n165|\t}\n166|\tcheckpoint, hasCheckpoint, err := leaseNullableDigest(members, \"checkpoint_id\")\n167|\tif err != nil {\n168|\t\treturn lease, fmt.Errorf(\"%w: lease record checkpoint_id: %v\", ErrInvalidConfig, err)\n169|\t}\n170|\tlease = validatedLease{\n171|\t\tDigest:         digest.String(),\n172|\t\tSessionID:      sessionID.String(),\n173|\t\tLeaseID:        leaseID,\n174|\t\tEpoch:          epoch,\n175|\t\tHolderHostID:   holder.String(),\n176|\t\tPredecessor:    predecessor,\n177|\t\tHasPredecessor: hasPredecessor,\n178|\t\tCheckpoint:     checkpoint,\n179|\t\tHasCheckpoint:  hasCheckpoint,\n180|\t\tRaw:            append([]byte(nil), raw...),\n181|\t}\n182|\treturn lease, nil\n183|}\n184|\n185|func leaseMemberRaw(members map[string]json.RawMessage, name string) json.RawMessage {\n186|\treturn members[name]\n187|}\n188|\n189|func leaseStringMember(members map[string]json.RawMessage, name string) (string, error) {\n190|\traw, ok := members[name]\n191|\tif !ok {\n192|\t\treturn \"\", fmt.Errorf(\"member %q is absent\", name)\n193|\t}\n194|\tvar value string\n195|\tif err := json.Unmarshal(raw, &value); err != nil {\n196|\t\treturn \"\", fmt.Errorf(\"member %q is not a string: %v\", name, err)\n197|\t}\n198|\treturn value, nil\n199|}\n200|\n201|func leaseNullableUUIDv4(members map[string]json.RawMessage, name string) (string, bool, error) {\n202|\traw, ok := members[name]\n203|\tif !ok {\n204|\t\treturn \"\", false, fmt.Errorf(\"member %q is absent\", name)\n205|\t}\n206|\tif string(raw) == \"null\" {\n207|\t\treturn \"\", false, nil\n208|\t}\n209|\tvar value string\n210|\tif err := json.Unmarshal(raw, &value); err != nil {\n211|\t\treturn \"\", false, fmt.Errorf(\"member %q is neither a UUID nor null\", name)\n212|\t}\n213|\tif _, err := scalar.ParseUUIDv4(value); err != nil {\n214|\t\treturn \"\", false, err\n215|\t}\n216|\treturn value, true, nil\n217|}\n218|\n219|// leaseNullableDigest reads a nullable digest member: null binds\n220|// absence, a string must parse as a canonical digest.\n221|func leaseNullableDigest(members map[string]json.RawMessage, name string) (string, bool, error) {\n222|\traw, ok := members[name]\n223|\tif !ok {\n224|\t\treturn \"\", false, fmt.Errorf(\"member %q is absent\", name)\n225|\t}\n226|\tif string(raw) == \"null\" {\n227|\t\treturn \"\", false, nil\n228|\t}\n229|\tvar value string\n230|\tif err := json.Unmarshal(raw, &value); err != nil {\n231|\t\treturn \"\", false, fmt.Errorf(\"member %q is neither a digest nor null\", name)\n232|\t}\n233|\tdigest, err := scalar.ParseDigest(value)\n234|\tif err != nil {\n235|\t\treturn \"\", false, err\n236|\t}\n237|\treturn digest.String(), true, nil\n238|}\n239|\n240|// parseCheckpointRecord validates one canonical Checkpoint Record\n241|// through the sessrepo owner (closed shape plus canonical self\n242|// identity) and extracts the bound members. Closed-shape and\n243|// identity failures refuse invalid_config; the caller maps an\n244|// unresolvable reference to observation_unavailable.\n245|func parseCheckpointRecord(raw []byte) (validatedCheckpoint, error) {\n246|\tvar checkpoint validatedCheckpoint\n247|\tmembers, fault := environ.DecodeStrictObject(raw)\n248|\tif fault != nil {\n249|\t\treturn checkpoint, fmt.Errorf(\"%w: decode checkpoint record frame: %v\", ErrInvalidConfig, fault)\n250|\t}\n251|\tschema, err := leaseStringMember(members, \"schema\")\n252|\tif err != nil || schema != checkpointRecordSchema {\n253|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record schema %q, want %q\", ErrInvalidConfig, schema, checkpointRecordSchema)\n254|\t}\n255|\tdigest, field, err := sessrepo.AttestCheckpointRecord(raw)\n256|\tif err != nil {\n257|\t\treturn checkpoint, fmt.Errorf(\"%w: verify checkpoint record identity: %v\", ErrInvalidConfig, err)\n258|\t}\n259|\tif field != canonicaljson.SelfCheckpointID {\n260|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record identity field %q, want checkpoint_id\", ErrInvalidConfig, string(field))\n261|\t}\n262|\tsessionID, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"session_id\"))\n263|\tif !ok {\n264|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no valid session_id member\", ErrInvalidConfig)\n265|\t}\n266|\tepoch, ok := environ.CheckUint53Bounds(leaseMemberRaw(members, \"lease_epoch\"), 1, uint53Ceiling)\n267|\tif !ok {\n268|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no lease_epoch at or above 1\", ErrInvalidConfig)\n269|\t}\n270|\tleaseID, err := leaseStringMember(members, \"lease_id\")\n271|\tif err != nil {\n272|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no lease_id member: %v\", ErrInvalidConfig, err)\n273|\t}\n274|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n275|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record lease_id: %v\", ErrInvalidConfig, err)\n276|\t}\n277|\tcreator, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"created_by_host_id\"))\n278|\tif !ok {\n279|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no valid created_by_host_id member\", ErrInvalidConfig)\n280|\t}\n281|\t_, hasProvider, err := leaseNullableDigest(members, \"provider_manifest_id\")\n282|\tif err != nil {\n283|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record provider_manifest_id: %v\", ErrInvalidConfig, err)\n284|\t}\n285|\t_, hasBoard, err := leaseNullableDigest(members, \"task_board_bundle_id\")\n286|\tif err != nil {\n287|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record task_board_bundle_id: %v\", ErrInvalidConfig, err)\n288|\t}\n289|\theads, err := checkpointEventHeads(members)\n290|\tif err != nil {\n291|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record event_heads: %v\", ErrInvalidConfig, err)\n292|\t}\n293|\tcheckpoint = validatedCheckpoint{\n294|\t\tDigest:              digest.String(),\n295|\t\tSessionID:           sessionID.String(),\n296|\t\tLeaseEpoch:          epoch,\n297|\t\tLeaseID:             leaseID,\n298|\t\tCreatorHostID:       creator.String(),\n299|\t\tHasProviderManifest: hasProvider,\n300|\t\tHasTaskBoardBundle:  hasBoard,\n301|\t\tEventHeads:          heads,\n302|\t\tRaw:                 append([]byte(nil), raw...),\n303|\t}\n304|\treturn checkpoint, nil\n305|}\n306|\n307|// checkpointEventHeads extracts the sorted unique event-head digests\n308|// the canonical checkpoint owner already shape-validated (1..64\n309|// entries). Grammar failures refuse invalid_config; resolution\n310|// against the session chain belongs to checkCheckpointEventHeads.\n311|func checkpointEventHeads(members map[string]json.RawMessage) ([]string, error) {\n312|\traw, ok := members[\"event_heads\"]\n313|\tif !ok {\n314|\t\treturn nil, fmt.Errorf(\"member %q is absent\", \"event_heads\")\n315|\t}\n316|\tvar values []string\n317|\tif err := json.Unmarshal(raw, &values); err != nil {\n318|\t\treturn nil, fmt.Errorf(\"member %q is not a string array: %v\", \"event_heads\", err)\n319|\t}\n320|\tout := make([]string, 0, len(values))\n321|\tfor _, value := range values {\n322|\t\tdigest, err := scalar.ParseDigest(value)\n323|\t\tif err != nil {\n324|\t\t\treturn nil, fmt.Errorf(\"member %q holds malformed digest %q: %v\", \"event_heads\", value, err)\n325|\t\t}\n326|\t\tout = append(out, digest.String())\n327|\t}\n328|\treturn out, nil\n329|}\n330|\n331|// validatedLeasesBySession validates every supplied Lease Record and\n332|// groups the admitted records by session UUID.\n333|func (reader *Reader) validatedLeasesBySession() (map[string][]validatedLease, error) {\n334|\tout := map[string][]validatedLease{}\n335|\tif reader == nil {\n336|\t\treturn out, fmt.Errorf(\"%w: reader carries no configuration\", ErrInvalidConfig)\n337|\t}\n338|\tfor _, raw := range reader.LeaseRecords {\n339|\t\tlease, err := parseLeaseRecord(raw)\n340|\t\tif err != nil {\n341|\t\t\treturn nil, err\n342|\t\t}\n343|\t\tout[lease.SessionID] = append(out[lease.SessionID], lease)\n344|\t}\n345|\treturn out, nil\n346|}\n347|\n348|// winningLeaseFor selects the greatest (epoch, lease_id) validated Lease\n349|// Record for one session and validates its succession: the\n350|// predecessor ancestry must chain by epoch plus one down to an\n351|// epoch-1 root, and every lease in that winning ancestry above\n352|// epoch 1 must reference a validated checkpoint for its session and\n353|// predecessor lease (Section 5.3), each created by the owning lease\n354|// holder (Section 5.4). Every required checkpoint must additionally\n355|// carry the persistence variant the referenced Session Record\n356|// selects: sessionKind is that record's kind as projected from the\n357|// winning source, and a variant mismatch refuses\n358|// observation_unavailable even when canonical identity, session,\n359|// lease, epoch, and creator all agree. Every required checkpoint\n360|// must also resolve each event head to a chained event for its\n361|// session at or before its bound lease in the winning source chain\n362|// (repo, Section 5.4 event-head closure): a head naming an absent\n363|// event or an event under a later lease cannot establish current\n364|// complete authority, so it refuses observation_unavailable;\n365|// historical heads stay admissible and are never required to equal\n366|// the current tail. Every required checkpoint must also admit its\n367|// Section 2.4 profile authority over the same closure\n368|// (checkCheckpointProfileAuthority): a first launch outside the\n369|// creation pair, a later launch outside the newest authoritative\n370|// change at or before it, a resume outside its referenced\n371|// checkpoint's closure pair, or a fork outside the new record\n372|// pair, contradicts the admitted history (integrity failure).\n373|// Absence refuses observation_unavailable; a\n374|// lease above epoch 1 without its named predecessor in the admitted\n375|// set refuses the same class rather than binding a dangling\n376|// successor, while an illegal predecessor link is malformed\n377|// authority (integrity failure).\n378|func (reader *Reader) winningLeaseFor(sessionID, sessionKind string, repo *sessrepo.Repository) (validatedLease, error) {\n379|\tif sessionKind != \"direct\" && sessionKind != \"task_board\" {\n380|\t\treturn validatedLease{}, fmt.Errorf(\"%w: session %s carries unknown kind %q for checkpoint persistence\", ErrInvalidConfig, sessionID, sessionKind)\n381|\t}\n382|\tbySession, err := reader.validatedLeasesBySession()\n383|\tif err != nil {\n384|\t\treturn validatedLease{}, err\n385|\t}\n386|\tcandidates := bySession[sessionID]\n387|\tif len(candidates) == 0 {\n388|\t\treturn validatedLease{}, fmt.Errorf(\"%w: winning lease record for session %s cannot be established\", ErrObservationUnavailable, sessionID)\n389|\t}\n390|\twinner := candidates[0]\n391|\tfor _, candidate := range candidates[1:] {\n392|\t\tif sessstate.Compare(\n393|\t\t\tsessstate.LeaseHead{Epoch: candidate.Epoch, LeaseID: candidate.LeaseID},\n394|\t\t\tsessstate.LeaseHead{Epoch: winner.Epoch, LeaseID: winner.LeaseID},\n395|\t\t) > 0 {\n396|\t\t\twinner = candidate\n397|\t\t}\n398|\t}\n399|\tchain, predecessor, err := checkLeaseChain(candidates, winner)\n400|\tif err != nil {\n401|\t\treturn validatedLease{}, err\n402|\t}\n403|\tif err := reader.checkWinnerCheckpoint(winner, predecessor, sessionKind, repo, chain); err != nil {\n404|\t\treturn validatedLease{}, err\n405|\t}\n406|\tif err := reader.checkAncestorCheckpoints(chain, sessionKind, repo); err != nil {\n407|\t\treturn validatedLease{}, err\n408|\t}\n409|\treturn winner, nil\n410|}\n411|\n412|// checkLeaseChain validates the winner's predecessor ancestry within\n413|// the admitted records for its session. Section 5.3 requires every\n414|// epoch above 1 to name a known predecessor for the same session\n415|// with an epoch exactly one below, down to an epoch-1 root with a\n416|// null predecessor; epochs below 1 cannot exist, so an epoch-1\n417|// lease naming any predecessor is malformed. A self, cyclic,\n418|// skipped, contradictory, or duplicated link is malformed authority\n419|// (integrity failure); a missing predecessor name or record is\n420|// incomplete authority (observation_unavailable). Epochs strictly\n421|// decrease along the walk, so the walk always terminates. It\n422|// returns the winning ancestry from the winner down to the epoch-1\n423|// root, plus the winner's direct predecessor, or the zero lease at\n424|// epoch 1.\n425|func checkLeaseChain(candidates []validatedLease, winner validatedLease) ([]validatedLease, validatedLease, error) {\n426|\tbyLease := make(map[string]validatedLease, len(candidates))\n427|\tfor _, candidate := range candidates {\n428|\t\tif previous, ok := byLease[candidate.LeaseID]; ok && previous.Digest != candidate.Digest {\n429|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: session %s carries contradictory lease records for lease %s\", sessstate.ErrIntegrity, winner.SessionID, candidate.LeaseID)\n430|\t\t}\n431|\t\tbyLease[candidate.LeaseID] = candidate\n432|\t}\n433|\tvar predecessor validatedLease\n434|\tvar chain []validatedLease\n435|\tcurrent := winner\n436|\tfor {\n437|\t\tchain = append(chain, current)\n438|\t\tif current.Epoch == 1 {\n439|\t\t\tif current.HasPredecessor {\n440|\t\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: session %s epoch-1 lease %s names a predecessor\", sessstate.ErrIntegrity, current.SessionID, current.LeaseID)\n441|\t\t\t}\n442|\t\t\treturn chain, predecessor, nil\n443|\t\t}\n444|\t\tif !current.HasPredecessor {\n445|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: winning lease record for session %s names no predecessor\", ErrObservationUnavailable, current.SessionID)\n446|\t\t}\n447|\t\tparent, ok := byLease[current.Predecessor]\n448|\t\tif !ok {\n449|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: predecessor lease record for session %s cannot be established\", ErrObservationUnavailable, current.SessionID)\n450|\t\t}\n451|\t\tif parent.Epoch+1 != current.Epoch {\n452|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: session %s lease %s at epoch %d does not succeed its predecessor %s at epoch %d\", sessstate.ErrIntegrity, current.SessionID, current.LeaseID, current.Epoch, parent.LeaseID, parent.Epoch)\n453|\t\t}\n454|\t\tif current.LeaseID == winner.LeaseID {\n455|\t\t\tpredecessor = parent\n456|\t\t}\n457|\t\tcurrent = parent\n458|\t}\n459|}\n460|\n461|// validatedCheckpointsByDigest validates every supplied Checkpoint\n462|// Record and indexes the parsed records by canonical digest. Semantic\n463|// admission happens only at the shared admission owners below.\n464|func (reader *Reader) validatedCheckpointsByDigest() (map[string]validatedCheckpoint, error) {\n465|\tout := map[string]validatedCheckpoint{}\n466|\tif reader == nil {\n467|\t\treturn out, fmt.Errorf(\"%w: reader carries no configuration\", ErrInvalidConfig)\n468|\t}\n469|\tfor _, raw := range reader.CheckpointRecords {\n470|\t\tcheckpoint, err := parseCheckpointRecord(raw)\n471|\t\tif err != nil {\n472|\t\t\treturn nil, err\n473|\t\t}\n474|\t\tout[checkpoint.Digest] = checkpoint\n475|\t}\n476|\treturn out, nil\n477|}\n478|\n479|// checkWinnerCheckpoint resolves the winner's checkpoint reference\n480|// against the admitted Checkpoint Records. Section 5.3 requires\n481|// every epoch above 1 to reference a validated checkpoint for its\n482|// session and predecessor lease; an epoch-1 root without a\n483|// predecessor may carry no checkpoint before the first provider\n484|// boundary exists. A non-null reference must resolve to an admitted\n485|// record for the same session bound to the lease it was taken\n486|// under: the predecessor for a successor, the winner itself at\n487|// epoch 1 (Section 5.4 binds a checkpoint to its winning lease). An\n488|// unresolvable reference is incomplete authority\n489|// (observation_unavailable), never absence or a minted fact. The\n490|// admitted checkpoint must also resolve its event-head closure in\n491|// the winning source chain (repo); see checkCheckpointEventHeads.\n492|// The same closure must then admit its Section 2.4 profile\n493|// authority; see checkCheckpointProfileAuthority.\n494|func (reader *Reader) checkWinnerCheckpoint(winner validatedLease, predecessor validatedLease, sessionKind string, repo *sessrepo.Repository, chain []validatedLease) error {\n495|\tif !winner.HasCheckpoint {\n496|\t\tif winner.Epoch == 1 && !winner.HasPredecessor {\n497|\t\t\treturn nil\n498|\t\t}\n499|\t\treturn fmt.Errorf(\"%w: validated checkpoint for session %s lease %s cannot be established\", ErrObservationUnavailable, winner.SessionID, winner.LeaseID)\n500|\t}\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9a5","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":813,"recorded_at":1780531400001621,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"task_stream":{"kind":"task","id":"01a0adcc-e80e-7670-a6b6-2f3a14fe95b2"},"task_id":"01a0adcc-e80e-7670-a6b6-2f3a14fe95b2","event":{"kind":"completed","task_id":"01a0adcc-e80e-7670-a6b6-2f3a14fe95b2"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9a7","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":814,"recorded_at":1780531400001623,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"call_id":"call_01a0adcce4b671a78184a4437ff5fedb","text":"Read text file `internal/sessquery/lease.go`.\n1|// Validated Lease Record admission for the v0.6.0 selector contract\n2|// (SPEC Sections 5.3 and 14.7.2).\n3|//\n4|// The reader carries canonical Lease Record bytes from the lease owner\n5|// in Reader.LeaseRecords. Each record is validated through the\n6|// canonicaljson owner (closed shape plus canonical self identity), and\n7|// the greatest (epoch, lease_id) winner per session supplies the plan\n8|// lease_record_id digest with its epoch, lease ID, and holder. Envelope\n9|// triples observed on event chains never substitute for these records:\n10|// a session with no admitted winning record refuses\n11|// selector_observation_unavailable, and malformed bytes refuse\n12|// invalid_config.\n13|package sessquery\n14|\n15|import (\n16|\t\"encoding/json\"\n17|\t\"fmt\"\n18|\n19|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n20|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n21|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n22|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n23|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n24|)\n25|\n26|const leaseRecordSchema = \"urn:ax:schema:lease\"\n27|\n28|// validatedLease is one admitted Lease Record: its canonical digest and\n29|// the members the selector binds.\n30|type validatedLease struct {\n31|\tDigest         string\n32|\tSessionID      string\n33|\tLeaseID        string\n34|\tEpoch          uint64\n35|\tHolderHostID   string\n36|\tPredecessor    string\n37|\tHasPredecessor bool\n38|\tCheckpoint     string\n39|\tHasCheckpoint  bool\n40|\tRaw            []byte\n41|}\n42|\n43|// checkpointRecordSchema is the exact Checkpoint Record schema the\n44|// winning-lease checkpoint gate admits.\n45|const checkpointRecordSchema = \"urn:ax:schema:checkpoint\"\n46|\n47|// validatedCheckpoint is the parsed canonical Checkpoint Record shape,\n48|// not yet an admitted authority capability: it carries the digest with\n49|// the session and lease it was taken under, plus the host that created\n50|// it. Section 5.4 binds lease_epoch/lease_id to the\n51|// referenced winning lease, so a successor's checkpoint names its\n52|// predecessor lease, and binds created_by_host_id to the current\n53|// lease holder: the holder of the lease the checkpoint names. The\n54|// persistence presence members carry which variant the record uses;\n55|// the referenced Session Record selects which variant is valid\n56|// (checkCheckpointPersistence), because canonical shape alone admits\n57|// either variant. EventHeads carries the authoritative event DAG\n58|// heads immediately before the checkpoint object; every required\n59|// checkpoint must resolve each head to a chained event for its\n60|// session at or before its bound lease\n61|// (checkCheckpointEventHeads), because a canonical checkpoint\n62|// naming an absent event or an event under a later lease cannot\n63|// establish Section 5.3/14.7.2 current complete authority. The same\n64|// closure must then admit the Section 2.4 profile authority\n65|// (checkCheckpointProfileAuthority), because a canonical checkpoint\n66|// over a corrupt profile history cannot fix the effective profile.\n67|type validatedCheckpoint struct {\n68|\tDigest              string\n69|\tSessionID           string\n70|\tLeaseEpoch          uint64\n71|\tLeaseID             string\n72|\tCreatorHostID       string\n73|\tHasProviderManifest bool\n74|\tHasTaskBoardBundle  bool\n75|\tEventHeads          []string\n76|\tRaw                 []byte\n77|}\n78|\n79|// checkpointSealToken is deliberately unexported and is created only by the\n80|// free admitCheckpoint constructor. The type-level census protects that\n81|// construction boundary across every production source file; the token then\n82|// makes a zero or field-assembled admittedCheckpoint unusable at runtime.\n83|type checkpointSealToken struct{}\n84|\n85|// checkpointSeal holds the facts that profile derivation may consume after\n86|// semantic admission. Its fields are private so callers cannot treat the\n87|// admitted representation as a public record-shaped DTO.\n88|type checkpointSeal struct {\n89|\ttoken               *checkpointSealToken\n90|\tdigest              string\n91|\tsessionID           string\n92|\tleaseEpoch          uint64\n93|\tleaseID             string\n94|\tcreatorHostID       string\n95|\thasProviderManifest bool\n96|\thasTaskBoardBundle  bool\n97|\teventHeads          []string\n98|}\n99|\n100|// admittedCheckpoint is the only checkpoint representation that profile\n101|// derivation may consume. A validatedCheckpoint is still a loader/admission\n102|// concern: canonical parsing alone does not establish its session, lease,\n103|// holder, persistence, event-head, or temporal authority. The unexported seal\n104|// is the capability; without its constructor-only token the value is not\n105|// admitted, even when a caller assembles the outer struct manually.\n106|type admittedCheckpoint struct {\n107|\tseal *checkpointSeal\n108|}\n109|\n110|func (checkpoint admittedCheckpoint) authority() (*checkpointSeal, error) {\n111|\tif checkpoint.seal == nil || checkpoint.seal.token == nil {\n112|\t\treturn nil, fmt.Errorf(\"%w: checkpoint authority seal is missing\", ErrObservationUnavailable)\n113|\t}\n114|\treturn checkpoint.seal, nil\n115|}\n116|\n117|// checkpointAdmission is the narrow capability handed to profile derivation\n118|// for a session.resumed reference. The derivation path can request a named\n119|// checkpoint, but it cannot obtain or consume a raw validated record.\n120|type checkpointAdmission func(checkpointID, sessionID string, summary sessrepo.EventSummary) (admittedCheckpoint, error)\n121|\n122|// parseLeaseRecord validates one canonical Lease Record through the\n123|// canonicaljson owner and extracts the bound members. Closed-shape and\n124|// identity failures refuse invalid_config; the caller maps absence to\n125|// observation_unavailable.\n126|func parseLeaseRecord(raw []byte) (validatedLease, error) {\n127|\tvar lease validatedLease\n128|\tmembers, fault := environ.DecodeStrictObject(raw)\n129|\tif fault != nil {\n130|\t\treturn lease, fmt.Errorf(\"%w: decode lease record frame: %v\", ErrInvalidConfig, fault)\n131|\t}\n132|\tschema, err := leaseStringMember(members, \"schema\")\n133|\tif err != nil || schema != leaseRecordSchema {\n134|\t\treturn lease, fmt.Errorf(\"%w: lease record schema %q, want %q\", ErrInvalidConfig, schema, leaseRecordSchema)\n135|\t}\n136|\tdigest, field, err := sessrepo.AttestLeaseRecord(raw)\n137|\tif err != nil {\n138|\t\treturn lease, fmt.Errorf(\"%w: verify lease record identity: %v\", ErrInvalidConfig, err)\n139|\t}\n140|\tif field != canonicaljson.SelfRecordID {\n141|\t\treturn lease, fmt.Errorf(\"%w: lease record identity field %q, want record_id\", ErrInvalidConfig, string(field))\n142|\t}\n143|\tsessionID, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"session_id\"))\n144|\tif !ok {\n145|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no valid session_id member\", ErrInvalidConfig)\n146|\t}\n147|\tleaseID, err := leaseStringMember(members, \"lease_id\")\n148|\tif err != nil {\n149|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no lease_id member: %v\", ErrInvalidConfig, err)\n150|\t}\n151|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n152|\t\treturn lease, fmt.Errorf(\"%w: lease record lease_id: %v\", ErrInvalidConfig, err)\n153|\t}\n154|\tepoch, ok := environ.CheckUint53Bounds(leaseMemberRaw(members, \"epoch\"), 1, uint53Ceiling)\n155|\tif !ok {\n156|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no epoch at or above 1\", ErrInvalidConfig)\n157|\t}\n158|\tholder, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"holder_host_id\"))\n159|\tif !ok {\n160|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no valid holder_host_id member\", ErrInvalidConfig)\n161|\t}\n162|\tpredecessor, hasPredecessor, err := leaseNullableUUIDv4(members, \"predecessor_lease_id\")\n163|\tif err != nil {\n164|\t\treturn lease, fmt.Errorf(\"%w: lease record predecessor_lease_id: %v\", ErrInvalidConfig, err)\n165|\t}\n166|\tcheckpoint, hasCheckpoint, err := leaseNullableDigest(members, \"checkpoint_id\")\n167|\tif err != nil {\n168|\t\treturn lease, fmt.Errorf(\"%w: lease record checkpoint_id: %v\", ErrInvalidConfig, err)\n169|\t}\n170|\tlease = validatedLease{\n171|\t\tDigest:         digest.String(),\n172|\t\tSessionID:      sessionID.String(),\n173|\t\tLeaseID:        leaseID,\n174|\t\tEpoch:          epoch,\n175|\t\tHolderHostID:   holder.String(),\n176|\t\tPredecessor:    predecessor,\n177|\t\tHasPredecessor: hasPredecessor,\n178|\t\tCheckpoint:     checkpoint,\n179|\t\tHasCheckpoint:  hasCheckpoint,\n180|\t\tRaw:            append([]byte(nil), raw...),\n181|\t}\n182|\treturn lease, nil\n183|}\n184|\n185|func leaseMemberRaw(members map[string]json.RawMessage, name string) json.RawMessage {\n186|\treturn members[name]\n187|}\n188|\n189|func leaseStringMember(members map[string]json.RawMessage, name string) (string, error) {\n190|\traw, ok := members[name]\n191|\tif !ok {\n192|\t\treturn \"\", fmt.Errorf(\"member %q is absent\", name)\n193|\t}\n194|\tvar value string\n195|\tif err := json.Unmarshal(raw, &value); err != nil {\n196|\t\treturn \"\", fmt.Errorf(\"member %q is not a string: %v\", name, err)\n197|\t}\n198|\treturn value, nil\n199|}\n200|\n201|func leaseNullableUUIDv4(members map[string]json.RawMessage, name string) (string, bool, error) {\n202|\traw, ok := members[name]\n203|\tif !ok {\n204|\t\treturn \"\", false, fmt.Errorf(\"member %q is absent\", name)\n205|\t}\n206|\tif string(raw) == \"null\" {\n207|\t\treturn \"\", false, nil\n208|\t}\n209|\tvar value string\n210|\tif err := json.Unmarshal(raw, &value); err != nil {\n211|\t\treturn \"\", false, fmt.Errorf(\"member %q is neither a UUID nor null\", name)\n212|\t}\n213|\tif _, err := scalar.ParseUUIDv4(value); err != nil {\n214|\t\treturn \"\", false, err\n215|\t}\n216|\treturn value, true, nil\n217|}\n218|\n219|// leaseNullableDigest reads a nullable digest member: null binds\n220|// absence, a string must parse as a canonical digest.\n221|func leaseNullableDigest(members map[string]json.RawMessage, name string) (string, bool, error) {\n222|\traw, ok := members[name]\n223|\tif !ok {\n224|\t\treturn \"\", false, fmt.Errorf(\"member %q is absent\", name)\n225|\t}\n226|\tif string(raw) == \"null\" {\n227|\t\treturn \"\", false, nil\n228|\t}\n229|\tvar value string\n230|\tif err := json.Unmarshal(raw, &value); err != nil {\n231|\t\treturn \"\", false, fmt.Errorf(\"member %q is neither a digest nor null\", name)\n232|\t}\n233|\tdigest, err := scalar.ParseDigest(value)\n234|\tif err != nil {\n235|\t\treturn \"\", false, err\n236|\t}\n237|\treturn digest.String(), true, nil\n238|}\n239|\n240|// parseCheckpointRecord validates one canonical Checkpoint Record\n241|// through the sessrepo owner (closed shape plus canonical self\n242|// identity) and extracts the bound members. Closed-shape and\n243|// identity failures refuse invalid_config; the caller maps an\n244|// unresolvable reference to observation_unavailable.\n245|func parseCheckpointRecord(raw []byte) (validatedCheckpoint, error) {\n246|\tvar checkpoint validatedCheckpoint\n247|\tmembers, fault := environ.DecodeStrictObject(raw)\n248|\tif fault != nil {\n249|\t\treturn checkpoint, fmt.Errorf(\"%w: decode checkpoint record frame: %v\", ErrInvalidConfig, fault)\n250|\t}\n251|\tschema, err := leaseStringMember(members, \"schema\")\n252|\tif err != nil || schema != checkpointRecordSchema {\n253|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record schema %q, want %q\", ErrInvalidConfig, schema, checkpointRecordSchema)\n254|\t}\n255|\tdigest, field, err := sessrepo.AttestCheckpointRecord(raw)\n256|\tif err != nil {\n257|\t\treturn checkpoint, fmt.Errorf(\"%w: verify checkpoint record identity: %v\", ErrInvalidConfig, err)\n258|\t}\n259|\tif field != canonicaljson.SelfCheckpointID {\n260|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record identity field %q, want checkpoint_id\", ErrInvalidConfig, string(field))\n261|\t}\n262|\tsessionID, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"session_id\"))\n263|\tif !ok {\n264|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no valid session_id member\", ErrInvalidConfig)\n265|\t}\n266|\tepoch, ok := environ.CheckUint53Bounds(leaseMemberRaw(members, \"lease_epoch\"), 1, uint53Ceiling)\n267|\tif !ok {\n268|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no lease_epoch at or above 1\", ErrInvalidConfig)\n269|\t}\n270|\tleaseID, err := leaseStringMember(members, \"lease_id\")\n271|\tif err != nil {\n272|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no lease_id member: %v\", ErrInvalidConfig, err)\n273|\t}\n274|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n275|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record lease_id: %v\", ErrInvalidConfig, err)\n276|\t}\n277|\tcreator, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"created_by_host_id\"))\n278|\tif !ok {\n279|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no valid created_by_host_id member\", ErrInvalidConfig)\n280|\t}\n281|\t_, hasProvider, err := leaseNullableDigest(members, \"provider_manifest_id\")\n282|\tif err != nil {\n283|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record provider_manifest_id: %v\", ErrInvalidConfig, err)\n284|\t}\n285|\t_, hasBoard, err := leaseNullableDigest(members, \"task_board_bundle_id\")\n286|\tif err != nil {\n287|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record task_board_bundle_id: %v\", ErrInvalidConfig, err)\n288|\t}\n289|\theads, err := checkpointEventHeads(members)\n290|\tif err != nil {\n291|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record event_heads: %v\", ErrInvalidConfig, err)\n292|\t}\n293|\tcheckpoint = validatedCheckpoint{\n294|\t\tDigest:              digest.String(),\n295|\t\tSessionID:           sessionID.String(),\n296|\t\tLeaseEpoch:          epoch,\n297|\t\tLeaseID:             leaseID,\n298|\t\tCreatorHostID:       creator.String(),\n299|\t\tHasProviderManifest: hasProvider,\n300|\t\tHasTaskBoardBundle:  hasBoard,\n301|\t\tEventHeads:          heads,\n302|\t\tRaw:                 append([]byte(nil), raw...),\n303|\t}\n304|\treturn checkpoint, nil\n305|}\n306|\n307|// checkpointEventHeads extracts the sorted unique event-head digests\n308|// the canonical checkpoint owner already shape-validated (1..64\n309|// entries). Grammar failures refuse invalid_config; resolution\n310|// against the session chain belongs to checkCheckpointEventHeads.\n311|func checkpointEventHeads(members map[string]json.RawMessage) ([]string, error) {\n312|\traw, ok := members[\"event_heads\"]\n313|\tif !ok {\n314|\t\treturn nil, fmt.Errorf(\"member %q is absent\", \"event_heads\")\n315|\t}\n316|\tvar values []string\n317|\tif err := json.Unmarshal(raw, &values); err != nil {\n318|\t\treturn nil, fmt.Errorf(\"member %q is not a string array: %v\", \"event_heads\", err)\n319|\t}\n320|\tout := make([]string, 0, len(values))\n321|\tfor _, value := range values {\n322|\t\tdigest, err := scalar.ParseDigest(value)\n323|\t\tif err != nil {\n324|\t\t\treturn nil, fmt.Errorf(\"member %q holds malformed digest %q: %v\", \"event_heads\", value, err)\n325|\t\t}\n326|\t\tout = append(out, digest.String())\n327|\t}\n328|\treturn out, nil\n329|}\n330|\n331|// validatedLeasesBySession validates every supplied Lease Record and\n332|// groups the admitted records by session UUID.\n333|func (reader *Reader) validatedLeasesBySession() (map[string][]validatedLease, error) {\n334|\tout := map[string][]validatedLease{}\n335|\tif reader == nil {\n336|\t\treturn out, fmt.Errorf(\"%w: reader carries no configuration\", ErrInvalidConfig)\n337|\t}\n338|\tfor _, raw := range reader.LeaseRecords {\n339|\t\tlease, err := parseLeaseRecord(raw)\n340|\t\tif err != nil {\n341|\t\t\treturn nil, err\n342|\t\t}\n343|\t\tout[lease.SessionID] = append(out[lease.SessionID], lease)\n344|\t}\n345|\treturn out, nil\n346|}\n347|\n348|// winningLeaseFor selects the greatest (epoch, lease_id) validated Lease\n349|// Record for one session and validates its succession: the\n350|// predecessor ancestry must chain by epoch plus one down to an\n351|// epoch-1 root, and every lease in that winning ancestry above\n352|// epoch 1 must reference a validated checkpoint for its session and\n353|// predecessor lease (Section 5.3), each created by the owning lease\n354|// holder (Section 5.4). Every required checkpoint must additionally\n355|// carry the persistence variant the referenced Session Record\n356|// selects: sessionKind is that record's kind as projected from the\n357|// winning source, and a variant mismatch refuses\n358|// observation_unavailable even when canonical identity, session,\n359|// lease, epoch, and creator all agree. Every required checkpoint\n360|// must also resolve each event head to a chained event for its\n361|// session at or before its bound lease in the winning source chain\n362|// (repo, Section 5.4 event-head closure): a head naming an absent\n363|// event or an event under a later lease cannot establish current\n364|// complete authority, so it refuses observation_unavailable;\n365|// historical heads stay admissible and are never required to equal\n366|// the current tail. Every required checkpoint must also admit its\n367|// Section 2.4 profile authority over the same closure\n368|// (checkCheckpointProfileAuthority): a first launch outside the\n369|// creation pair, a later launch outside the newest authoritative\n370|// change at or before it, a resume outside its referenced\n371|// checkpoint's closure pair, or a fork outside the new record\n372|// pair, contradicts the admitted history (integrity failure).\n373|// Absence refuses observation_unavailable; a\n374|// lease above epoch 1 without its named predecessor in the admitted\n375|// set refuses the same class rather than binding a dangling\n376|// successor, while an illegal predecessor link is malformed\n377|// authority (integrity failure).\n378|func (reader *Reader) winningLeaseFor(sessionID, sessionKind string, repo *sessrepo.Repository) (validatedLease, error) {\n379|\tif sessionKind != \"direct\" && sessionKind != \"task_board\" {\n380|\t\treturn validatedLease{}, fmt.Errorf(\"%w: session %s carries unknown kind %q for checkpoint persistence\", ErrInvalidConfig, sessionID, sessionKind)\n381|\t}\n382|\tbySession, err := reader.validatedLeasesBySession()\n383|\tif err != nil {\n384|\t\treturn validatedLease{}, err\n385|\t}\n386|\tcandidates := bySession[sessionID]\n387|\tif len(candidates) == 0 {\n388|\t\treturn validatedLease{}, fmt.Errorf(\"%w: winning lease record for session %s cannot be established\", ErrObservationUnavailable, sessionID)\n389|\t}\n390|\twinner := candidates[0]\n391|\tfor _, candidate := range candidates[1:] {\n392|\t\tif sessstate.Compare(\n393|\t\t\tsessstate.LeaseHead{Epoch: candidate.Epoch, LeaseID: candidate.LeaseID},\n394|\t\t\tsessstate.LeaseHead{Epoch: winner.Epoch, LeaseID: winner.LeaseID},\n395|\t\t) > 0 {\n396|\t\t\twinner = candidate\n397|\t\t}\n398|\t}\n399|\tchain, predecessor, err := checkLeaseChain(candidates, winner)\n400|\tif err != nil {\n401|\t\treturn validatedLease{}, err\n402|\t}\n403|\tif err := reader.checkWinnerCheckpoint(winner, predecessor, sessionKind, repo, chain); err != nil {\n404|\t\treturn validatedLease{}, err\n405|\t}\n406|\tif err := reader.checkAncestorCheckpoints(chain, sessionKind, repo); err != nil {\n407|\t\treturn validatedLease{}, err\n408|\t}\n409|\treturn winner, nil\n410|}\n411|\n412|// checkLeaseChain validates the winner's predecessor ancestry within\n413|// the admitted records for its session. Section 5.3 requires every\n414|// epoch above 1 to name a known predecessor for the same session\n415|// with an epoch exactly one below, down to an epoch-1 root with a\n416|// null predecessor; epochs below 1 cannot exist, so an epoch-1\n417|// lease naming any predecessor is malformed. A self, cyclic,\n418|// skipped, contradictory, or duplicated link is malformed authority\n419|// (integrity failure); a missing predecessor name or record is\n420|// incomplete authority (observation_unavailable). Epochs strictly\n421|// decrease along the walk, so the walk always terminates. It\n422|// returns the winning ancestry from the winner down to the epoch-1\n423|// root, plus the winner's direct predecessor, or the zero lease at\n424|// epoch 1.\n425|func checkLeaseChain(candidates []validatedLease, winner validatedLease) ([]validatedLease, validatedLease, error) {\n426|\tbyLease := make(map[string]validatedLease, len(candidates))\n427|\tfor _, candidate := range candidates {\n428|\t\tif previous, ok := byLease[candidate.LeaseID]; ok && previous.Digest != candidate.Digest {\n429|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: session %s carries contradictory lease records for lease %s\", sessstate.ErrIntegrity, winner.SessionID, candidate.LeaseID)\n430|\t\t}\n431|\t\tbyLease[candidate.LeaseID] = candidate\n432|\t}\n433|\tvar predecessor validatedLease\n434|\tvar chain []validatedLease\n435|\tcurrent := winner\n436|\tfor {\n437|\t\tchain = append(chain, current)\n438|\t\tif current.Epoch == 1 {\n439|\t\t\tif current.HasPredecessor {\n440|\t\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: session %s epoch-1 lease %s names a predecessor\", sessstate.ErrIntegrity, current.SessionID, current.LeaseID)\n441|\t\t\t}\n442|\t\t\treturn chain, predecessor, nil\n443|\t\t}\n444|\t\tif !current.HasPredecessor {\n445|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: winning lease record for session %s names no predecessor\", ErrObservationUnavailable, current.SessionID)\n446|\t\t}\n447|\t\tparent, ok := byLease[current.Predecessor]\n448|\t\tif !ok {\n449|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: predecessor lease record for session %s cannot be established\", ErrObservationUnavailable, current.SessionID)\n450|\t\t}\n451|\t\tif parent.Epoch+1 != current.Epoch {\n452|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: session %s lease %s at epoch %d does not succeed its predecessor %s at epoch %d\", sessstate.ErrIntegrity, current.SessionID, current.LeaseID, current.Epoch, parent.LeaseID, parent.Epoch)\n453|\t\t}\n454|\t\tif current.LeaseID == winner.LeaseID {\n455|\t\t\tpredecessor = parent\n456|\t\t}\n457|\t\tcurrent = parent\n458|\t}\n459|}\n460|\n461|// validatedCheckpointsByDigest validates every supplied Checkpoint\n462|// Record and indexes the parsed records by canonical digest. Semantic\n463|// admission happens only at the shared admission owners below.\n464|func (reader *Reader) validatedCheckpointsByDigest() (map[string]validatedCheckpoint, error) {\n465|\tout := map[string]validatedCheckpoint{}\n466|\tif reader == nil {\n467|\t\treturn out, fmt.Errorf(\"%w: reader carries no configuration\", ErrInvalidConfig)\n468|\t}\n469|\tfor _, raw := range reader.CheckpointRecords {\n470|\t\tcheckpoint, err := parseCheckpointRecord(raw)\n471|\t\tif err != nil {\n472|\t\t\treturn nil, err\n473|\t\t}\n474|\t\tout[checkpoint.Digest] = checkpoint\n475|\t}\n476|\treturn out, nil\n477|}\n478|\n479|// checkWinnerCheckpoint resolves the winner's checkpoint reference\n480|// against the admitted Checkpoint Records. Section 5.3 requires\n481|// every epoch above 1 to reference a validated checkpoint for its\n482|// session and predecessor lease; an epoch-1 root without a\n483|// predecessor may carry no checkpoint before the first provider\n484|// boundary exists. A non-null reference must resolve to an admitted\n485|// record for the same session bound to the lease it was taken\n486|// under: the predecessor for a successor, the winner itself at\n487|// epoch 1 (Section 5.4 binds a checkpoint to its winning lease). An\n488|// unresolvable reference is incomplete authority\n489|// (observation_unavailable), never absence or a minted fact. The\n490|// admitted checkpoint must also resolve its event-head closure in\n491|// the winning source chain (repo); see checkCheckpointEventHeads.\n492|// The same closure must then admit its Section 2.4 profile\n493|// authority; see checkCheckpointProfileAuthority.\n494|func (reader *Reader) checkWinnerCheckpoint(winner validatedLease, predecessor validatedLease, sessionKind string, repo *sessrepo.Repository, chain []validatedLease) error {\n495|\tif !winner.HasCheckpoint {\n496|\t\tif winner.Epoch == 1 && !winner.HasPredecessor {\n497|\t\t\treturn nil\n498|\t\t}\n499|\t\treturn fmt.Errorf(\"%w: validated checkpoint for session %s lease %s cannot be established\", ErrObservationUnavailable, winner.SessionID, winner.LeaseID)\n500|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
