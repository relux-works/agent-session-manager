failure, err := failInvalid(\"create opaque value is not 1..1024 characters\")\n253|\t\t\tif err != nil {\n254|\t\t\t\treturn err\n255|\t\t\t}\n256|\t\t\treturn failure\n257|\t\t}\n258|\t\tif strings.HasPrefix(value, \"/\") || strings.HasPrefix(value, `\\\\`) || windowsDrivePattern.MatchString(value) {\n259|\t\t\tfailure, err := failInvalid(\"create opaque value begins with an absolute path\")\n260|\t\t\tif err != nil {\n261|\t\t\t\treturn err\n262|\t\t\t}\n263|\t\t\treturn failure\n264|\t\t}\n265|\t}\n266|\treturn nil\n267|}\n268|\n269|// checkCreateExtensions enforces the extensions count and key rules on\n270|// creation params: at most 64 entries keyed by 3..253-character\n271|// lowercase reverse-DNS names. Value depth and the object byte bound\n272|// belong to the owner's backstop in CreateIdentity, which refuses what\n273|// these arms cannot see. Keys iterate sorted so a params value\n274|// violating several entries always names the same rule.\n275|func checkCreateExtensions(extensions map[string]any) error {\n276|\tif len(extensions) > maxExtensionMembers {\n277|\t\tfailure, err := failInvalid(\"create extensions exceed 64 entries\")\n278|\t\tif err != nil {\n279|\t\t\treturn err\n280|\t\t}\n281|\t\treturn failure\n282|\t}\n283|\tkeys := make([]string, 0, len(extensions))\n284|\tfor key := range extensions {\n285|\t\tkeys = append(keys, key)\n286|\t}\n287|\tsort.Strings(keys)\n288|\tfor _, key := range keys {\n289|\t\tif len(key) < 3 || len(key) > 253 || !reverseDNSPattern.MatchString(key) {\n290|\t\t\tfailure, err := failInvalid(\"create extension key is not reverse-DNS\")\n291|\t\t\tif err != nil {\n292|\t\t\t\treturn err\n293|\t\t\t}\n294|\t\t\treturn failure\n295|\t\t}\n296|\t}\n297|\treturn nil\n298|}\n299|\n300|// opaqueJSON renders the opaque map for the staged record: a nil map\n301|// means the empty object, never null.\n302|func opaqueJSON(opaque map[string]string) map[string]any {\n303|\trendered := make(map[string]any, len(opaque))\n304|\tfor key, value := range opaque {\n305|\t\trendered[key] = value\n306|\t}\n307|\treturn rendered\n308|}\n309|\n310|// extensionsJSON renders the extensions map for the staged record: a\n311|// nil map means the empty object, never null.\n312|func extensionsJSON(extensions map[string]any) map[string]any {\n313|\tif extensions == nil {\n314|\t\treturn map[string]any{}\n315|\t}\n316|\treturn extensions\n317|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
