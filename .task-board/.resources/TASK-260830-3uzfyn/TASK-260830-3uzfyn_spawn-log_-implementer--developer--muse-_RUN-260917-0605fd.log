{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9d5","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":837,"recorded_at":1780531400001669,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"task_stream":{"kind":"task","id":"01a0adcc-f132-72d3-9483-4e6b3da0410f"},"task_id":"01a0adcc-f132-72d3-9483-4e6b3da0410f","event":{"kind":"output","task_id":"01a0adcc-f132-72d3-9483-4e6b3da0410f","chunk":"Read text file `internal/sessquery/lease.go`.\n(499 line(s) above)\n500|\t}\n501|\tcheckpoints, err := reader.validatedCheckpointsByDigest()\n502|\tif err != nil {\n503|\t\treturn err\n504|\t}\n505|\tcheckpoint, ok := checkpoints[winner.Checkpoint]\n506|\tif !ok {\n507|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, winner.Checkpoint, winner.SessionID)\n508|\t}\n509|\towner := winner\n510|\tif winner.Epoch > 1 {\n511|\t\towner = predecessor\n512|\t}\n513|\tadmitted, err := admitCheckpoint(checkpoint, winner.SessionID, owner, sessionKind, chain, repo, nil)\n514|\tif err != nil {\n515|\t\treturn err\n516|\t}\n517|\tadmitReference := buildCheckpointAdmission(checkpoints, chain, repo, sessionKind)\n518|\tif err := checkCheckpointProfileAuthority(admitted, repo, admitReference); err != nil {\n519|\t\treturn err\n520|\t}\n521|\treturn nil\n522|}\n523|\n524|// checkAncestorCheckpoints validates the checkpoint references of\n525|// every non-winner lease in the winning ancestry: Section 5.3\n526|// requires each epoch above 1 to reference a validated checkpoint\n527|// for its session and predecessor lease, and Section 5.4 requires\n528|// that checkpoint to be created by the owning lease holder. The\n529|// winner itself is covered by checkWinnerCheckpoint. Only the\n530|// winner's own ancestry is admitted: sibling branches off that\n531|// chain are never consulted, so legal branching is preserved. An\n532|// epoch-1 root without a reference stays admissible before the\n533|// first provider boundary exists; a reference it does carry must\n534|// resolve to a checkpoint bound to itself and created by its own\n535|// holder. An unresolvable reference or a binding to another\n536|// session, lease, or holder is incomplete authority\n537|// (observation_unavailable), never absence or a minted fact. Every\n538|// admitted ancestor checkpoint must also resolve its event-head\n539|// closure in the winning source chain (repo) and admit its Section\n540|// 2.4 profile authority over that closure.\n541|func (reader *Reader) checkAncestorCheckpoints(chain []validatedLease, sessionKind string, repo *sessrepo.Repository) error {\n542|\tif len(chain) < 2 {\n543|\t\treturn nil\n544|\t}\n545|\tcheckpoints, err := reader.validatedCheckpointsByDigest()\n546|\tif err != nil {\n547|\t\treturn err\n548|\t}\n549|\tfor index := 1; index < len(chain); index++ {\n550|\t\tcurrent := chain[index]\n551|\t\tif current.Epoch == 1 {\n552|\t\t\tif !current.HasCheckpoint {\n553|\t\t\t\tcontinue\n554|\t\t\t}\n555|\t\t\tif err := checkCheckpointBinding(current, current, checkpoints, sessionKind, repo, chain); err != nil {\n556|\t\t\t\treturn err\n557|\t\t\t}\n558|\t\t\tcontinue\n559|\t\t}\n560|\t\tif !current.HasCheckpoint {\n561|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint for session %s lease %s cannot be established\", ErrObservationUnavailable, current.SessionID, current.LeaseID)\n562|\t\t}\n563|\t\tif index+1 >= len(chain) {\n564|\t\t\treturn fmt.Errorf(\"%w: predecessor lease record for session %s cannot be established\", ErrObservationUnavailable, current.SessionID)\n565|\t\t}\n566|\t\tif err := checkCheckpointBinding(current, chain[index+1], checkpoints, sessionKind, repo, chain); err != nil {\n567|\t\t\treturn err\n568|\t\t}\n569|\t}\n570|\treturn nil\n571|}\n572|\n573|// checkCheckpointBinding resolves one lease's checkpoint reference\n574|// against the admitted Checkpoint Records and validates its Section\n575|// 5.3 session and predecessor-lease binding with its Section 5.4\n576|// holder binding: the checkpoint must name this session and the\n577|// owning lease, and its creator must be that lease's holder. The\n578|// admitted checkpoint must also resolve its event-head closure in\n579|// the winning source chain (repo); see checkCheckpointEventHeads.\n580|// The same closure must then admit its Section 2.4 profile\n581|// authority; see checkCheckpointProfileAuthority.\n582|func checkCheckpointBinding(current, owner validatedLease, checkpoints map[string]validatedCheckpoint, sessionKind string, repo *sessrepo.Repository, chain []validatedLease) error {\n583|\tcheckpoint, ok := checkpoints[current.Checkpoint]\n584|\tif !ok {\n585|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, current.Checkpoint, current.SessionID)\n586|\t}\n587|\tadmitted, err := admitCheckpoint(checkpoint, current.SessionID, owner, sessionKind, chain, repo, nil)\n588|\tif err != nil {\n589|\t\treturn err\n590|\t}\n591|\tadmitReference := buildCheckpointAdmission(checkpoints, chain, repo, sessionKind)\n592|\tif err := checkCheckpointProfileAuthority(admitted, repo, admitReference); err != nil {\n593|\t\treturn err\n594|\t}\n595|\treturn nil\n596|}\n597|\n598|// admitCheckpoint is the single constructor for an admitted Checkpoint\n599|// Record. All raw validated data enters this function from an explicit\n600|// winner/ancestor/reference admission owner; profile derivation receives only\n601|// the resulting capability.\n602|func admitCheckpoint(raw validatedCheckpoint, sessionID string, owner validatedLease, sessionKind string, chain []validatedLease, repo *sessrepo.Repository, resume *sessrepo.EventSummary) (admittedCheckpoint, error) {\n603|\tif raw.SessionID != sessionID {\n604|\t\treturn admittedCheckpoint{}, fmt.Errorf(\"%w: validated checkpoint %s carries session %s, want %s\", ErrObservationUnavailable, raw.Digest, raw.SessionID, sessionID)\n605|\t}\n606|\tif raw.LeaseEpoch != owner.Epoch || raw.LeaseID != owner.LeaseID {\n607|\t\treturn admittedCheckpoint{}, fmt.Errorf(\"%w: validated checkpoint %s is bound to lease %s at epoch %d, want lease %s at epoch %d\", ErrObservationUnavailable, raw.Digest, raw.LeaseID, raw.LeaseEpoch, owner.LeaseID, owner.Epoch)\n608|\t}\n609|\tif raw.CreatorHostID != owner.HolderHostID {\n610|\t\treturn admittedCheckpoint{}, fmt.Errorf(\"%w: validated checkpoint %s is created by host %s, want owning lease holder %s\", ErrObservationUnavailable, raw.Digest, raw.CreatorHostID, owner.HolderHostID)\n611|\t}\n612|\tif err := checkCheckpointPersistence(raw, sessionID, sessionKind); err != nil {\n613|\t\treturn admittedCheckpoint{}, err\n614|\t}\n615|\tif err := checkCheckpointEventHeads(raw, owner, repo); err != nil {\n616|\t\treturn admittedCheckpoint{}, err\n617|\t}\n618|\tif resume != nil {\n619|\t\tif err := checkReferencedCheckpointTemporal(raw, owner, *resume, chain, repo); err != nil {\n620|\t\t\treturn admittedCheckpoint{}, err\n621|\t\t}\n622|\t}\n623|\treturn admittedCheckpoint{seal: &checkpointSeal{\n624|\t\ttoken:               &checkpointSealToken{},\n625|\t\tdigest:              raw.Digest,\n626|\t\tsessionID:           raw.SessionID,\n627|\t\tleaseEpoch:          raw.LeaseEpoch,\n628|\t\tleaseID:             raw.LeaseID,\n629|\t\tcreatorHostID:       raw.CreatorHostID,\n630|\t\thasProviderManifest: raw.HasProviderManifest,\n631|\t\thasTaskBoardBundle:  raw.HasTaskBoardBundle,\n632|\t\teventHeads:          append([]string(nil), raw.EventHeads...),\n633|\t}}, nil\n634|}\n635|\n636|// buildCheckpointAdmission returns the only raw-record lookup capability\n637|// exposed to the referenced profile derivation. The closure performs the\n638|// lookup and immediately routes the result through the shared admission owner.\n639|func buildCheckpointAdmission(checkpoints map[string]validatedCheckpoint, chain []validatedLease, repo *sessrepo.Repository, sessionKind string) checkpointAdmission {\n640|\treturn func(checkpointID, sessionID string, summary sessrepo.EventSummary) (result admittedCheckpoint, err error) {\n641|\t\traw, ok := checkpoints[checkpointID]\n642|\t\tif !ok {\n643|\t\t\terr = fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, checkpointID, sessionID)\n644|\t\t\treturn\n645|\t\t}\n646|\t\treturn checkReferencedCheckpointBinding(raw, checkpointID, sessionID, sessionKind, summary, chain, repo)\n647|\t}\n648|}\n649|\n650|// checkCheckpointEventHeads resolves every event head of one parsed\n651|// Checkpoint Record against the winning source chain for its session\n652|// (Section 5.4 event-head closure). Each head must name a chained\n653|// event for the same session at or before the owning lease: a head\n654|// naming an absent event (including a cross-session digest, a\n655|// losing-lease preserved blob outside the authoritative chain, or a\n656|// synthetic placeholder) is incomplete authority\n657|// (observation_unavailable), and a head under a later lease (a\n658|// greater epoch, or the same epoch under a different fencing token)\n659|// is likewise incomplete authority because the checkpoint cannot fix\n660|// authority over events that postdate it. Historical heads stay\n661|// admissible and are never required to equal the current tail, so\n662|// valid branching and lagging copies are preserved. A failed chain\n663|// read keeps its cause inside the same incomplete-authority refusal\n664|// instead of minting a fact, and a nil chain handle refuses the same\n665|// class rather than skipping the gate.\n666|func checkCheckpointEventHeads(checkpoint validatedCheckpoint, owner validatedLease, repo *sessrepo.Repository) error {\n667|\tif repo == nil {\n668|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s event-head authority for session %s cannot be established: no winning source chain\", ErrObservationUnavailable, checkpoint.Digest, checkpoint.SessionID)\n669|\t}\n670|\tevents, err := repo.ListEvents(checkpoint.SessionID)\n671|\tif err != nil {\n672|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s event-head authority for session %s cannot be established: %v\", ErrObservationUnavailable, checkpoint.Digest, checkpoint.SessionID, err)\n673|\t}\n674|\tbyID := make(map[string]sessrepo.EventSummary, len(events))\n675|\tfor _, summary := range events {\n676|\t\tbyID[summary.EventID] = summary\n677|\t}\n678|\tfor _, head := range checkpoint.EventHeads {\n679|\t\tsummary, ok := byID[head]\n680|\t\tif !ok {\n681|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s names unknown event head %s for session %s\", ErrObservationUnavailable, checkpoint.Digest, head, checkpoint.SessionID)\n682|\t\t}\n683|\t\tif summary.LeaseEpoch > owner.Epoch {\n684|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s names event head %s under later lease epoch %d, want at or before epoch %d\", ErrObservationUnavailable, checkpoint.Digest, head, summary.LeaseEpoch, owner.Epoch)\n685|\t\t}\n686|\t\tif summary.LeaseEpoch == owner.Epoch && summary.LeaseID != owner.LeaseID {\n687|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s names event head %s under lease %s, want owning lease %s at epoch %d\", ErrObservationUnavailable, checkpoint.Digest, head, summary.LeaseID, owner.LeaseID, owner.Epoch)\n688|\t\t}\n689|\t}\n690|\treturn nil\n691|}\n692|\n693|// checkCheckpointProfileAuthority admits the Section 2.4 effective\n694|// execution profile and its nullable source event for one required\n695|// checkpoint against the winning source chain (repo, SPEC 5.4\n696|// event-head closure). The transitive predecessor closure of the\n697|// checkpoint heads fixes the launch values: the Session Record\n698|// carries the creation profile, the first launch in the closure\n699|// carries that profile with a null source, and every later\n700|// provider/task-board launch carries the newest authoritative\n701|// profile.changed event at or before it with the profile it\n702|// targets (launches carry no checkpoint_id member, so the closure\n703|// under admission evaluated in lease/sequence order is their only\n704|// referenced authority). Every session resume instead carries the\n705|// effective pair of ITS referenced checkpoint (SPEC 5.2),\n706|// resolved through the admitted Checkpoint Records (checkpoints)\n707|// and derived from that checkpoint's own event-head closure, never\n708|// from the position in the outer walk. Every fork carries the\n709|// newly persisted Session Record profile with a null source (SPEC\n710|// 2.4/5.2 new-session authority); only its source_profile_event_id\n711|// provenance stays outside this closure. A non-null source must\n712|// name a chained profile.changed event inside the governing\n713|// closure; a missing (dangling, cross-session, or preserved\n714|// outside the authoritative index), out-of-closure (later\n715|// local-only or losing-lease), wrong-type, or non-newest reference\n716|// is contradictory authority (integrity failure), as is a pair\n717|// whose profile value does not equal the derived effective\n718|// profile — consumers MUST NOT consult a later local-only event or\n719|// fall back to the creation value. Historical heads stay admissible\n720|// because derivation reads only closures, never the current tail.\n721|// A missing or misbound referenced checkpoint, an unresolvable\n722|// referenced head, a failed chain read, and a nil chain handle\n723|// refuse incomplete authority (observation_unavailable) with the\n724|// cause kept instead of minting a fact. Payloads are fetched only\n725|// for pair and change events in the closures; the index already\n726|// carries every other routing member the walk needs.\n727|func checkCheckpointProfileAuthority(checkpoint admittedCheckpoint, repo *sessrepo.Repository, admission checkpointAdmission) error {\n728|\tauthority, err := checkpoint.authority()\n729|\tif err != nil {\n730|\t\treturn err\n731|\t}\n732|\tif repo == nil {\n733|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s profile authority for session %s cannot be established: no winning source chain\", ErrObservationUnavailable, authority.digest, authority.sessionID)\n734|\t}\n735|\trecordBytes, err := repo.GetRecord(authority.sessionID)\n736|\tif err != nil {\n737|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s profile authority for session %s cannot be established: %v\", ErrObservationUnavailable, authority.digest, authority.sessionID, err)\n738|\t}\n739|\tcreation, recordID, err := sessionCreationProfile(checkpoint, recordBytes)\n740|\tif err != nil {\n741|\t\treturn err\n742|\t}\n743|\tevents, err := repo.ListEvents(authority.sessionID)\n744|\tif err != nil {\n745|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s profile authority for session %s cannot be established: %v\", ErrObservationUnavailable, authority.digest, authority.sessionID, err)\n746|\t}\n747|\tclosure, err := profileClosure(checkpoint, recordID, events)\n748|\tif err != nil {\n749|\t\treturn err\n750|\t}\n751|\treturn checkClosureProfilePairs(checkpoint, creation, recordID, events, closure, repo, admission)\n752|}\n753|\n754|// sessionCreationProfile reads the immutable creation profile and\n755|// the canonical record digest from the winning-source Session\n756|// Record bytes. The closed shape owner requires execution_profile\n757|// standard|yolo, so any other value contradicts the admitted\n758|// record (integrity failure).\n759|func sessionCreationProfile(checkpoint admittedCheckpoint, recordBytes []byte) (string, string, error) {\n760|\tauthority, err := checkpoint.authority()\n761|\tif err != nil {\n762|\t\treturn \"\", \"\", err\n763|\t}\n764|\tmembers, fault := environ.DecodeStrictObject(recordBytes)\n765|\tif fault != nil {\n766|\t\treturn \"\", \"\", fmt.Errorf(\"%w: session %s carries no decodable session record for profile authority: %v\", sessstate.ErrIntegrity, authority.sessionID, fault)\n767|\t}\n768|\tcreation, err := leaseStringMember(members, \"execution_profile\")\n769|\tif err != nil || (creation != \"standard\" && creation != \"yolo\") {\n770|\t\treturn \"\", \"\", fmt.Errorf(\"%w: session %s carries no valid creation profile for profile authority\", sessstate.ErrIntegrity, authority.sessionID)\n771|\t}\n772|\trecordID, err := leaseStringMember(members, \"record_id\")\n773|\tif err != nil {\n774|\t\treturn \"\", \"\", fmt.Errorf(\"%w: session %s carries no valid record digest for profile authority\", sessstate.ErrIntegrity, authority.sessionID)\n775|\t}\n776|\tdigest, err := scalar.ParseDigest(recordID)\n777|\tif err != nil {\n778|\t\treturn \"\", \"\", fmt.Errorf(\"%w: session %s carries malformed record digest %q for profile authority\", sessstate.ErrIntegrity, authority.sessionID, recordID)\n779|\t}\n780|\treturn creation, digest.String(), nil\n781|}\n782|\n783|// profileClosure resolves the transitive predecessor closure of the\n784|// checkpoint heads against the winning source chain index. The\n785|// genesis link names the Session Record digest rather than an\n786|// event; every other predecessor must name a chained event, so a\n787|// dangling reference contradicts the admitted closure (integrity\n788|// failure). Divergent blobs preserved outside the authoritative\n789|// index never enter the closure: index membership is authority.\n790|func profileClosure(checkpoint admittedCheckpoint, recordID string, events []sessrepo.EventSummary) (map[string]bool, error) {\n791|\tauthority, err := checkpoint.authority()\n792|\tif err != nil {\n793|\t\treturn nil, err\n794|\t}\n795|\tbyID := make(map[string]sessrepo.EventSummary, len(events))\n796|\tfor _, summary := range events {\n797|\t\tbyID[summary.EventID] = summary\n798|\t}\n799|\tclosure := make(map[string]bool, len(events))\n800|\tstack := append([]string(nil), authority.eventHeads...)\n801|\tfor len(stack) > 0 {\n802|\t\tid := stack[len(stack)-1]\n803|\t\tstack = stack[:len(stack)-1]\n804|\t\tif closure[id] {\n805|\t\t\tcontinue\n806|\t\t}\n807|\t\tsummary, ok := byID[id]\n808|\t\tif !ok {\n809|\t\t\tif id == recordID {\n810|\t\t\t\tcontinue\n811|\t\t\t}\n812|\t\t\treturn nil, fmt.Errorf(\"%w: validated checkpoint %s profile closure names unknown event %s for session %s\", sessstate.ErrIntegrity, authority.digest, id, authority.sessionID)\n813|\t\t}\n814|\t\tclosure[id] = true\n815|\t\tstack = append(stack, summary.Predecessors...)\n816|\t}\n817|\treturn closure, nil\n818|}\n819|\n820|// profilePair is one decoded Section 2.4 pair from a launch or\n821|// resume event payload.\n822|type profilePair struct {\n823|\tprofile   string\n824|\tsource    string\n825|\thasSource bool\n826|}\n827|\n828|// eventProfilePair decodes the pair from one chained launch or\n829|// resume event. Chained bytes passed the closed payload shape at\n830|// append time, so a member that no longer decodes contradicts the\n831|// attested chain (integrity failure).\n832|func eventProfilePair(checkpoint admittedCheckpoint, repo *sessrepo.Repository, summary sessrepo.EventSummary) (profilePair, error) {\n833|\tauthority, err := checkpoint.authority()\n834|\tif err != nil {\n835|\t\treturn profilePair{}, err\n836|\t}\n837|\tvar pair profilePair\n838|\tpayload, err := eventPayloadMembers(checkpoint, repo, summary)\n839|\tif err != nil {\n840|\t\treturn pair, err\n841|\t}\n842|\tprofile, err := leaseStringMember(payload, \"execution_profile\")\n843|\tif err != nil || (profile != \"standard\" && profile != \"yolo\") {\n844|\t\treturn pair, fmt.Errorf(\"%w: session %s event %s carries no valid execution profile for profile authority\", sessstate.ErrIntegrity, authority.sessionID, summary.EventID)\n845|\t}\n846|\tsource, hasSource, err := leaseNullableDigest(payload, \"profile_source_event_id\")\n847|\tif err != nil {\n848|\t\treturn pair, fmt.Errorf(\"%w: session %s event %s carries no valid profile source for profile authority: %v\", sessstate.ErrIntegrity, authority.sessionID, summary.EventID, err)\n849|\t}\n850|\treturn profilePair{profile: profile, source: source, hasSource: hasSource}, nil\n851|}\n852|\n853|// eventProfileTarget decodes the target profile of one chained\n854|// profile.changed event. Only the target feeds the derivation: the\n855|// source value and the confirmation history belong to the\n856|// publication flow that admitted the event, never to this\n857|// admission.\n858|func eventProfileTarget(checkpoint admittedCheckpoint, repo *sessrepo.Repository, summary sessrepo.EventSummary) (string, error) {\n859|\tauthority, err := checkpoint.authority()\n860|\tif err != nil {\n861|\t\treturn \"\", err\n862|\t}\n863|\tpayload, err := eventPayloadMembers(checkpoint, repo, summary)\n864|\tif err != nil {\n865|\t\treturn \"\", err\n866|\t}\n867|\ttarget, err := leaseStringMember(payload, \"to\")\n868|\tif err != nil || (target != \"standard\" && target != \"yolo\") {\n869|\t\treturn \"\", fmt.Errorf(\"%w: session %s event %s carries no valid profile target for profile authority\", sessstate.ErrIntegrity, authority.sessionID, summary.EventID)\n870|\t}\n871|\treturn target, nil\n872|}\n873|\n874|// eventPayloadMembers returns the decoded payload object of one\n875|// chained event. A failed blob read keeps its cause inside the\n876|// incomplete-authority refusal; bytes that no longer decode\n877|// contradict the attested chain.\n878|func eventPayloadMembers(checkpoint admittedCheckpoint, repo *sessrepo.Repository, summary sessrepo.EventSummary) (map[string]json.RawMessage, error) {\n879|\tauthority, err := checkpoint.authority()\n880|\tif err != nil {\n881|\t\treturn nil, err\n882|\t}\n883|\traw, err := repo.GetEvent(authority.sessionID, summary.EventID)\n884|\tif err != nil {\n885|\t\treturn nil, fmt.Errorf(\"%w: validated checkpoint %s profile authority for session %s cannot be established: %v\", ErrObservationUnavailable, authority.digest, authority.sessionID, err)\n886|\t}\n887|\tmembers, fault := environ.DecodeStrictObject(raw)\n888|\tif fault != nil {\n889|\t\treturn nil, fmt.Errorf(\"%w: session %s event %s carries no decodable event frame for profile authority: %v\", sessstate.ErrIntegrity, authority.sessionID, summary.EventID, fault)\n890|\t}\n891|\tpayloadRaw, ok := members[\"payload\"]\n892|\tif !ok || string(payloadRaw) == \"null\" {\n893|\t\treturn nil, fmt.Errorf(\"%w: session %s event %s carries no payload for profile authority\", sessstate.ErrIntegrity, authority.sessionID, summary.EventID)\n894|\t}\n895|\tpayload, fault := environ.DecodeStrictObject([]byte(payloadRaw))\n896|\tif fault != nil {\n897|\t\treturn nil, fmt.Errorf(\"%w: session %s event %s carries no decodable payload for profile authority: %v\", sessstate.ErrIntegrity, authority.sessionID, summary.EventID, fault)\n898|\t}\n899|\treturn payload, nil\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9d7","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":838,"recorded_at":1780531400001671,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"task_stream":{"kind":"task","id":"01a0adcc-f132-72d3-9483-4e6b3da0410f"},"task_id":"01a0adcc-f132-72d3-9483-4e6b3da0410f","event":{"kind":"completed","task_id":"01a0adcc-f132-72d3-9483-4e6b3da0410f"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9d9","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":839,"recorded_at":1780531400001673,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"call_id":"call_01a0adcced5a72049bcb661fd83d236b","text":"Read text file `internal/sessquery/lease.go`.\n(499 line(s) above)\n500|\t}\n501|\tcheckpoints, err := reader.validatedCheckpointsByDigest()\n502|\tif err != nil {\n503|\t\treturn err\n504|\t}\n505|\tcheckpoint, ok := checkpoints[winner.Checkpoint]\n506|\tif !ok {\n507|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, winner.Checkpoint, winner.SessionID)\n508|\t}\n509|\towner := winner\n510|\tif winner.Epoch > 1 {\n511|\t\towner = predecessor\n512|\t}\n513|\tadmitted, err := admitCheckpoint(checkpoint, winner.SessionID, owner, sessionKind, chain, repo, nil)\n514|\tif err != nil {\n515|\t\treturn err\n516|\t}\n517|\tadmitReference := buildCheckpointAdmission(checkpoints, chain, repo, sessionKind)\n518|\tif err := checkCheckpointProfileAuthority(admitted, repo, admitReference); err != nil {\n519|\t\treturn err\n520|\t}\n521|\treturn nil\n522|}\n523|\n524|// checkAncestorCheckpoints validates the checkpoint references of\n525|// every non-winner lease in the winning ancestry: Section 5.3\n526|// requires each epoch above 1 to reference a validated checkpoint\n527|// for its session and predecessor lease, and Section 5.4 requires\n528|// that checkpoint to be created by the owning lease holder. The\n529|// winner itself is covered by checkWinnerCheckpoint. Only the\n530|// winner's own ancestry is admitted: sibling branches off that\n531|// chain are never consulted, so legal branching is preserved. An\n532|// epoch-1 root without a reference stays admissible before the\n533|// first provider boundary exists; a reference it does carry must\n534|// resolve to a checkpoint bound to itself and created by its own\n535|// holder. An unresolvable reference or a binding to another\n536|// session, lease, or holder is incomplete authority\n537|// (observation_unavailable), never absence or a minted fact. Every\n538|// admitted ancestor checkpoint must also resolve its event-head\n539|// closure in the winning source chain (repo) and admit its Section\n540|// 2.4 profile authority over that closure.\n541|func (reader *Reader) checkAncestorCheckpoints(chain []validatedLease, sessionKind string, repo *sessrepo.Repository) error {\n542|\tif len(chain) < 2 {\n543|\t\treturn nil\n544|\t}\n545|\tcheckpoints, err := reader.validatedCheckpointsByDigest()\n546|\tif err != nil {\n547|\t\treturn err\n548|\t}\n549|\tfor index := 1; index < len(chain); index++ {\n550|\t\tcurrent := chain[index]\n551|\t\tif current.Epoch == 1 {\n552|\t\t\tif !current.HasCheckpoint {\n553|\t\t\t\tcontinue\n554|\t\t\t}\n555|\t\t\tif err := checkCheckpointBinding(current, current, checkpoints, sessionKind, repo, chain); err != nil {\n556|\t\t\t\treturn err\n557|\t\t\t}\n558|\t\t\tcontinue\n559|\t\t}\n560|\t\tif !current.HasCheckpoint {\n561|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint for session %s lease %s cannot be established\", ErrObservationUnavailable, current.SessionID, current.LeaseID)\n562|\t\t}\n563|\t\tif index+1 >= len(chain) {\n564|\t\t\treturn fmt.Errorf(\"%w: predecessor lease record for session %s cannot be established\", ErrObservationUnavailable, current.SessionID)\n565|\t\t}\n566|\t\tif err := checkCheckpointBinding(current, chain[index+1], checkpoints, sessionKind, repo, chain); err != nil {\n567|\t\t\treturn err\n568|\t\t}\n569|\t}\n570|\treturn nil\n571|}\n572|\n573|// checkCheckpointBinding resolves one lease's checkpoint reference\n574|// against the admitted Checkpoint Records and validates its Section\n575|// 5.3 session and predecessor-lease binding with its Section 5.4\n576|// holder binding: the checkpoint must name this session and the\n577|// owning lease, and its creator must be that lease's holder. The\n578|// admitted checkpoint must also resolve its event-head closure in\n579|// the winning source chain (repo); see checkCheckpointEventHeads.\n580|// The same closure must then admit its Section 2.4 profile\n581|// authority; see checkCheckpointProfileAuthority.\n582|func checkCheckpointBinding(current, owner validatedLease, checkpoints map[string]validatedCheckpoint, sessionKind string, repo *sessrepo.Repository, chain []validatedLease) error {\n583|\tcheckpoint, ok := checkpoints[current.Checkpoint]\n584|\tif !ok {\n585|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, current.Checkpoint, current.SessionID)\n586|\t}\n587|\tadmitted, err := admitCheckpoint(checkpoint, current.SessionID, owner, sessionKind, chain, repo, nil)\n588|\tif err != nil {\n589|\t\treturn err\n590|\t}\n591|\tadmitReference := buildCheckpointAdmission(checkpoints, chain, repo, sessionKind)\n592|\tif err := checkCheckpointProfileAuthority(admitted, repo, admitReference); err != nil {\n593|\t\treturn err\n594|\t}\n595|\treturn nil\n596|}\n597|\n598|// admitCheckpoint is the single constructor for an admitted Checkpoint\n599|// Record. All raw validated data enters this function from an explicit\n600|// winner/ancestor/reference admission owner; profile derivation receives only\n601|// the resulting capability.\n602|func admitCheckpoint(raw validatedCheckpoint, sessionID string, owner validatedLease, sessionKind string, chain []validatedLease, repo *sessrepo.Repository, resume *sessrepo.EventSummary) (admittedCheckpoint, error) {\n603|\tif raw.SessionID != sessionID {\n604|\t\treturn admittedCheckpoint{}, fmt.Errorf(\"%w: validated checkpoint %s carries session %s, want %s\", ErrObservationUnavailable, raw.Digest, raw.SessionID, sessionID)\n605|\t}\n606|\tif raw.LeaseEpoch != owner.Epoch || raw.LeaseID != owner.LeaseID {\n607|\t\treturn admittedCheckpoint{}, fmt.Errorf(\"%w: validated checkpoint %s is bound to lease %s at epoch %d, want lease %s at epoch %d\", ErrObservationUnavailable, raw.Digest, raw.LeaseID, raw.LeaseEpoch, owner.LeaseID, owner.Epoch)\n608|\t}\n609|\tif raw.CreatorHostID != owner.HolderHostID {\n610|\t\treturn admittedCheckpoint{}, fmt.Errorf(\"%w: validated checkpoint %s is created by host %s, want owning lease holder %s\", ErrObservationUnavailable, raw.Digest, raw.CreatorHostID, owner.HolderHostID)\n611|\t}\n612|\tif err := checkCheckpointPersistence(raw, sessionID, sessionKind); err != nil {\n613|\t\treturn admittedCheckpoint{}, err\n614|\t}\n615|\tif err := checkCheckpointEventHeads(raw, owner, repo); err != nil {\n616|\t\treturn admittedCheckpoint{}, err\n617|\t}\n618|\tif resume != nil {\n619|\t\tif err := checkReferencedCheckpointTemporal(raw, owner, *resume, chain, repo); err != nil {\n620|\t\t\treturn admittedCheckpoint{}, err\n621|\t\t}\n622|\t}\n623|\treturn admittedCheckpoint{seal: &checkpointSeal{\n624|\t\ttoken:               &checkpointSealToken{},\n625|\t\tdigest:              raw.Digest,\n626|\t\tsessionID:           raw.SessionID,\n627|\t\tleaseEpoch:          raw.LeaseEpoch,\n628|\t\tleaseID:             raw.LeaseID,\n629|\t\tcreatorHostID:       raw.CreatorHostID,\n630|\t\thasProviderManifest: raw.HasProviderManifest,\n631|\t\thasTaskBoardBundle:  raw.HasTaskBoardBundle,\n632|\t\teventHeads:          append([]string(nil), raw.EventHeads...),\n633|\t}}, nil\n634|}\n635|\n636|// buildCheckpointAdmission returns the only raw-record lookup capability\n637|// exposed to the referenced profile derivation. The closure performs the\n638|// lookup and immediately routes the result through the shared admission owner.\n639|func buildCheckpointAdmission(checkpoints map[string]validatedCheckpoint, chain []validatedLease, repo *sessrepo.Repository, sessionKind string) checkpointAdmission {\n640|\treturn func(checkpointID, sessionID string, summary sessrepo.EventSummary) (result admittedCheckpoint, err error) {\n641|\t\traw, ok := checkpoints[checkpointID]\n642|\t\tif !ok {\n643|\t\t\terr = fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, checkpointID, sessionID)\n644|\t\t\treturn\n645|\t\t}\n646|\t\treturn checkReferencedCheckpointBinding(raw, checkpointID, sessionID, sessionKind, summary, chain, repo)\n647|\t}\n648|}\n649|\n650|// checkCheckpointEventHeads resolves every event head of one parsed\n651|// Checkpoint Record against the winning source chain for its session\n652|// (Section 5.4 event-head closure). Each head must name a chained\n653|// event for the same session at or before the owning lease: a head\n654|// naming an absent event (including a cross-session digest, a\n655|// losing-lease preserved blob outside the authoritative chain, or a\n656|// synthetic placeholder) is incomplete authority\n657|// (observation_unavailable), and a head under a later lease (a\n658|// greater epoch, or the same epoch under a different fencing token)\n659|// is likewise incomplete authority because the checkpoint cannot fix\n660|// authority over events that postdate it. Historical heads stay\n661|// admissible and are never required to equal the current tail, so\n662|// valid branching and lagging copies are preserved. A failed chain\n663|// read keeps its cause inside the same incomplete-authority refusal\n664|// instead of minting a fact, and a nil chain handle refuses the same\n665|// class rather than skipping the gate.\n666|func checkCheckpointEventHeads(checkpoint validatedCheckpoint, owner validatedLease, repo *sessrepo.Repository) error {\n667|\tif repo == nil {\n668|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s event-head authority for session %s cannot be established: no winning source chain\", ErrObservationUnavailable, checkpoint.Digest, checkpoint.SessionID)\n669|\t}\n670|\tevents, err := repo.ListEvents(checkpoint.SessionID)\n671|\tif err != nil {\n672|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s event-head authority for session %s cannot be established: %v\", ErrObservationUnavailable, checkpoint.Digest, checkpoint.SessionID, err)\n673|\t}\n674|\tbyID := make(map[string]sessrepo.EventSummary, len(events))\n675|\tfor _, summary := range events {\n676|\t\tbyID[summary.EventID] = summary\n677|\t}\n678|\tfor _, head := range checkpoint.EventHeads {\n679|\t\tsummary, ok := byID[head]\n680|\t\tif !ok {\n681|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s names unknown event head %s for session %s\", ErrObservationUnavailable, checkpoint.Digest, head, checkpoint.SessionID)\n682|\t\t}\n683|\t\tif summary.LeaseEpoch > owner.Epoch {\n684|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s names event head %s under later lease epoch %d, want at or before epoch %d\", ErrObservationUnavailable, checkpoint.Digest, head, summary.LeaseEpoch, owner.Epoch)\n685|\t\t}\n686|\t\tif summary.LeaseEpoch == owner.Epoch && summary.LeaseID != owner.LeaseID {\n687|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s names event head %s under lease %s, want owning lease %s at epoch %d\", ErrObservationUnavailable, checkpoint.Digest, head, summary.LeaseID, owner.LeaseID, owner.Epoch)\n688|\t\t}\n689|\t}\n690|\treturn nil\n691|}\n692|\n693|// checkCheckpointProfileAuthority admits the Section 2.4 effective\n694|// execution profile and its nullable source event for one required\n695|// checkpoint against the winning source chain (repo, SPEC 5.4\n696|// event-head closure). The transitive predecessor closure of the\n697|// checkpoint heads fixes the launch values: the Session Record\n698|// carries the creation profile, the first launch in the closure\n699|// carries that profile with a null source, and every later\n700|// provider/task-board launch carries the newest authoritative\n701|// profile.changed event at or before it with the profile it\n702|// targets (launches carry no checkpoint_id member, so the closure\n703|// under admission evaluated in lease/sequence order is their only\n704|// referenced authority). Every session resume instead carries the\n705|// effective pair of ITS referenced checkpoint (SPEC 5.2),\n706|// resolved through the admitted Checkpoint Records (checkpoints)\n707|// and derived from that checkpoint's own event-head closure, never\n708|// from the position in the outer walk. Every fork carries the\n709|// newly persisted Session Record profile with a null source (SPEC\n710|// 2.4/5.2 new-session authority); only its source_profile_event_id\n711|// provenance stays outside this closure. A non-null source must\n712|// name a chained profile.changed event inside the governing\n713|// closure; a missing (dangling, cross-session, or preserved\n714|// outside the authoritative index), out-of-closure (later\n715|// local-only or losing-lease), wrong-type, or non-newest reference\n716|// is contradictory authority (integrity failure), as is a pair\n717|// whose profile value does not equal the derived effective\n718|// profile — consumers MUST NOT consult a later local-only event or\n719|// fall back to the creation value. Historical heads stay admissible\n720|// because derivation reads only closures, never the current tail.\n721|// A missing or misbound referenced checkpoint, an unresolvable\n722|// referenced head, a failed chain read, and a nil chain handle\n723|// refuse incomplete authority (observation_unavailable) with the\n724|// cause kept instead of minting a fact. Payloads are fetched only\n725|// for pair and change events in the closures; the index already\n726|// carries every other routing member the walk needs.\n727|func checkCheckpointProfileAuthority(checkpoint admittedCheckpoint, repo *sessrepo.Repository, admission checkpointAdmission) error {\n728|\tauthority, err := checkpoint.authority()\n729|\tif err != nil {\n730|\t\treturn err\n731|\t}\n732|\tif repo == nil {\n733|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s profile authority for session %s cannot be established: no winning source chain\", ErrObservationUnavailable, authority.digest, authority.sessionID)\n734|\t}\n735|\trecordBytes, err := repo.GetRecord(authority.sessionID)\n736|\tif err != nil {\n737|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s profile authority for session %s cannot be established: %v\", ErrObservationUnavailable, authority.digest, authority.sessionID, err)\n738|\t}\n739|\tcreation, recordID, err := sessionCreationProfile(checkpoint, recordBytes)\n740|\tif err != nil {\n741|\t\treturn err\n742|\t}\n743|\tevents, err := repo.ListEvents(authority.sessionID)\n744|\tif err != nil {\n745|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s profile authority for session %s cannot be established: %v\", ErrObservationUnavailable, authority.digest, authority.sessionID, err)\n746|\t}\n747|\tclosure, err := profileClosure(checkpoint, recordID, events)\n748|\tif err != nil {\n749|\t\treturn err\n750|\t}\n751|\treturn checkClosureProfilePairs(checkpoint, creation, recordID, events, closure, repo, admission)\n752|}\n753|\n754|// sessionCreationProfile reads the immutable creation profile and\n755|// the canonical record digest from the winning-source Session\n756|// Record bytes. The closed shape owner requires execution_profile\n757|// standard|yolo, so any other value contradicts the admitted\n758|// record (integrity failure).\n759|func sessionCreationProfile(checkpoint admittedCheckpoint, recordBytes []byte) (string, string, error) {\n760|\tauthority, err := checkpoint.authority()\n761|\tif err != nil {\n762|\t\treturn \"\", \"\", err\n763|\t}\n764|\tmembers, fault := environ.DecodeStrictObject(recordBytes)\n765|\tif fault != nil {\n766|\t\treturn \"\", \"\", fmt.Errorf(\"%w: session %s carries no decodable session record for profile authority: %v\", sessstate.ErrIntegrity, authority.sessionID, fault)\n767|\t}\n768|\tcreation, err := leaseStringMember(members, \"execution_profile\")\n769|\tif err != nil || (creation != \"standard\" && creation != \"yolo\") {\n770|\t\treturn \"\", \"\", fmt.Errorf(\"%w: session %s carries no valid creation profile for profile authority\", sessstate.ErrIntegrity, authority.sessionID)\n771|\t}\n772|\trecordID, err := leaseStringMember(members, \"record_id\")\n773|\tif err != nil {\n774|\t\treturn \"\", \"\", fmt.Errorf(\"%w: session %s carries no valid record digest for profile authority\", sessstate.ErrIntegrity, authority.sessionID)\n775|\t}\n776|\tdigest, err := scalar.ParseDigest(recordID)\n777|\tif err != nil {\n778|\t\treturn \"\", \"\", fmt.Errorf(\"%w: session %s carries malformed record digest %q for profile authority\", sessstate.ErrIntegrity, authority.sessionID, recordID)\n779|\t}\n780|\treturn creation, digest.String(), nil\n781|}\n782|\n783|// profileClosure resolves the transitive predecessor closure of the\n784|// checkpoint heads against the winning source chain index. The\n785|// genesis link names the Session Record digest rather than an\n786|// event; every other predecessor must name a chained event, so a\n787|// dangling reference contradicts the admitted closure (integrity\n788|// failure). Divergent blobs preserved outside the authoritative\n789|// index never enter the closure: index membership is authority.\n790|func profileClosure(checkpoint admittedCheckpoint, recordID string, events []sessrepo.EventSummary) (map[string]bool, error) {\n791|\tauthority, err := checkpoint.authority()\n792|\tif err != nil {\n793|\t\treturn nil, err\n794|\t}\n795|\tbyID := make(map[string]sessrepo.EventSummary, len(events))\n796|\tfor _, summary := range events {\n797|\t\tbyID[summary.EventID] = summary\n798|\t}\n799|\tclosure := make(map[string]bool, len(events))\n800|\tstack := append([]string(nil), authority.eventHeads...)\n801|\tfor len(stack) > 0 {\n802|\t\tid := stack[len(stack)-1]\n803|\t\tstack = stack[:len(stack)-1]\n804|\t\tif closure[id] {\n805|\t\t\tcontinue\n806|\t\t}\n807|\t\tsummary, ok := byID[id]\n808|\t\tif !ok {\n809|\t\t\tif id == recordID {\n810|\t\t\t\tcontinue\n811|\t\t\t}\n812|\t\t\treturn nil, fmt.Errorf(\"%w: validated checkpoint %s profile closure names unknown event %s for session %s\", sessstate.ErrIntegrity, authority.digest, id, authority.sessionID)\n813|\t\t}\n814|\t\tclosure[id] = true\n815|\t\tstack = append(stack, summary.Predecessors...)\n816|\t}\n817|\treturn closure, nil\n818|}\n819|\n820|// profilePair is one decoded Section 2.4 pair from a launch or\n821|// resume event payload.\n822|type profilePair struct {\n823|\tprofile   string\n824|\tsource    string\n825|\thasSource bool\n826|}\n827|\n828|// eventProfilePair decodes the pair from one chained launch or\n829|// resume event. Chained bytes passed the closed payload shape at\n830|// append time, so a member that no longer decodes contradicts the\n831|// attested chain (integrity failure).\n832|func eventProfilePair(checkpoint admittedCheckpoint, repo *sessrepo.Repository, summary sessrepo.EventSummary) (profilePair, error) {\n833|\tauthority, err := checkpoint.authority()\n834|\tif err != nil {\n835|\t\treturn profilePair{}, err\n836|\t}\n837|\tvar pair profilePair\n838|\tpayload, err := eventPayloadMembers(checkpoint, repo, summary)\n839|\tif err != nil {\n840|\t\treturn pair, err\n841|\t}\n842|\tprofile, err := leaseStringMember(payload, \"execution_profile\")\n843|\tif err != nil || (profile != \"standard\" && profile != \"yolo\") {\n844|\t\treturn pair, fmt.Errorf(\"%w: session %s event %s carries no valid execution profile for profile authority\", sessstate.ErrIntegrity, authority.sessionID, summary.EventID)\n845|\t}\n846|\tsource, hasSource, err := leaseNullableDigest(payload, \"profile_source_event_id\")\n847|\tif err != nil {\n848|\t\treturn pair, fmt.Errorf(\"%w: session %s event %s carries no valid profile source for profile authority: %v\", sessstate.ErrIntegrity, authority.sessionID, summary.EventID, err)\n849|\t}\n850|\treturn profilePair{profile: profile, source: source, hasSource: hasSource}, nil\n851|}\n852|\n853|// eventProfileTarget decodes the target profile of one chained\n854|// profile.changed event. Only the target feeds the derivation: the\n855|// source value and the confirmation history belong to the\n856|// publication flow that admitted the event, never to this\n857|// admission.\n858|func eventProfileTarget(checkpoint admittedCheckpoint, repo *sessrepo.Repository, summary sessrepo.EventSummary) (string, error) {\n859|\tauthority, err := checkpoint.authority()\n860|\tif err != nil {\n861|\t\treturn \"\", err\n862|\t}\n863|\tpayload, err := eventPayloadMembers(checkpoint, repo, summary)\n864|\tif err != nil {\n865|\t\treturn \"\", err\n866|\t}\n867|\ttarget, err := leaseStringMember(payload, \"to\")\n868|\tif err != nil || (target != \"standard\" && target != \"yolo\") {\n869|\t\treturn \"\", fmt.Errorf(\"%w: session %s event %s carries no valid profile target for profile authority\", sessstate.ErrIntegrity, authority.sessionID, summary.EventID)\n870|\t}\n871|\treturn target, nil\n872|}\n873|\n874|// eventPayloadMembers returns the decoded payload object of one\n875|// chained event. A failed blob read keeps its cause inside the\n876|// incomplete-authority refusal; bytes that no longer decode\n877|// contradict the attested chain.\n878|func eventPayloadMembers(checkpoint admittedCheckpoint, repo *sessrepo.Repository, summary sessrepo.EventSummary) (map[string]json.RawMessage, error) {\n879|\tauthority, err := checkpoint.authority()\n880|\tif err != nil {\n881|\t\treturn nil, err\n882|\t}\n883|\traw, err := repo.GetEvent(authority.sessionID, summary.EventID)\n884|\tif err != nil {\n885|\t\treturn nil, fmt.Errorf(\"%w: validated checkpoint %s profile authority for session %s cannot be established: %v\", ErrObservationUnavailable, authority.digest, authority.sessionID, err)\n886|\t}\n887|\tmembers, fault := environ.DecodeStrictObject(raw)\n888|\tif fault != nil {\n889|\t\treturn nil, fmt.Errorf(\"%w: session %s event %s carries no decodable event frame for profile authority: %v\", sessstate.ErrIntegrity, authority.sessionID, summary.EventID, fault)\n890|\t}\n891|\tpayloadRaw, ok := members[\"payload\"]\n892|\tif !ok || string(payloadRaw) == \"null\" {\n893|\t\treturn nil, fmt.Errorf(\"%w: session %s event %s carries no payload for profile authority\", sessstate.ErrIntegrity, authority.sessionID, summary.EventID)\n894|\t}\n895|\tpayload, fault := environ.DecodeStrictObject([]byte(payloadRaw))\n896|\tif fault != nil {\n897|\t\treturn nil, fmt.Errorf(\"%w: session %s event %s carries no decodable payload for profile authority: %v\", sessstate.ErrIntegrity, authority.sessionID, summary.EventID, fault)\n898|\t}\n899|\treturn payload, nil\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
