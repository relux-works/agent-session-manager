{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c759","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":519,"recorded_at":1780531400001033,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"task_stream":{"kind":"task","id":"01a0adcc-2be3-7222-8844-49fb1c2ca6ad"},"task_id":"01a0adcc-2be3-7222-8844-49fb1c2ca6ad","event":{"kind":"output","task_id":"01a0adcc-2be3-7222-8844-49fb1c2ca6ad","chunk":"Read text file `internal/sessstate/project.go`.\n1|package sessstate\n2|\n3|import (\n4|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n5|)\n6|\n7|// Projector binds the pure reducer to one repository. It only reads:\n8|// ListSessions locates the session (and its parked channel), GetRecord\n9|// and ListEvents with GetEvent load the authoritative bytes, and\n10|// Decode plus Reduce derive the projection. No entry here mutates\n11|// durable state, so there is no crash window to arm: placing\n12|// secconftest points around reads would measure nothing, and a crashed\n13|// read retries as the same read. Idempotency is the reducer's purity —\n14|// projecting twice yields the identical projection — pinned by\n15|// TestProjectIsIdempotentAcrossReads.\n16|type Projector struct {\n17|\t// Repo is the session repository to project from. It is required.\n18|\tRepo *sessrepo.Repository\n19|\t// LocalHostID selects the local role: the owner host of the\n20|\t// newest authoritative event decides owner against replica. Empty\n21|\t// leaves the role unknown rather than guessing.\n22|\tLocalHostID string\n23|\t// Union carries competing off-chain leases observed at mesh union\n24|\t// for winner resolution. Nil projects the chain alone.\n25|\tUnion []LeaseHead\n26|\t// Local is the lease the local host acts under for the stale\n27|\t// projection. Zero disables the stale override.\n28|\tLocal LeaseHead\n29|}\n30|\n31|// Project derives the session projection for one session ID. A parked\n32|// session returns the parked state with its blocking reason and retry,\n33|// never an error or an omission; an ID with no listing entry refuses\n34|// unknown. The listing therefore tells a parked name apart from a\n35|// missing one with no sessrepo interface change.\n36|func (projector *Projector) Project(sessionID string) (Projection, error) {\n37|\tif projector == nil || projector.Repo == nil {\n38|\t\treturn Projection{}, refuse(ErrDerivation, \"projector carries no repository\")\n39|\t}\n40|\tsummaries, err := projector.Repo.ListSessions()\n41|\tif err != nil {\n42|\t\treturn Projection{}, err\n43|\t}\n44|\tvar found *sessrepo.SessionSummary\n45|\tfor index := range summaries {\n46|\t\tif summaries[index].SessionID == sessionID {\n47|\t\t\tfound = &summaries[index]\n48|\t\t\tbreak\n49|\t\t}\n50|\t}\n51|\tif found == nil {\n52|\t\treturn Projection{}, refuse(ErrUnknownSession, \"no session %s\", sessionID)\n53|\t}\n54|\tif found.Parked {\n55|\t\treturn Reduce(Input{\n56|\t\t\tRecord: Record{\n57|\t\t\t\tSessionID:  found.SessionID,\n58|\t\t\t\tRecordID:   found.RecordID,\n59|\t\t\t\tName:       found.Name,\n60|\t\t\t\tKind:       found.Kind,\n61|\t\t\t\tProviderID: found.ProviderID,\n62|\t\t\t},\n63|\t\t\tParked: &ParkedFacts{\n64|\t\t\t\tBlockingReason: found.BlockingReason,\n65|\t\t\t\tRetryHint:      found.RetryHint,\n66|\t\t\t},\n67|\t\t})\n68|\t}\n69|\trecordBytes, err := projector.Repo.GetRecord(sessionID)\n70|\tif err != nil {\n71|\t\treturn Projection{}, err\n72|\t}\n73|\trecord, err := DecodeRecord(recordBytes)\n74|\tif err != nil {\n75|\t\treturn Projection{}, err\n76|\t}\n77|\tindexed, err := projector.Repo.ListEvents(sessionID)\n78|\tif err != nil {\n79|\t\treturn Projection{}, err\n80|\t}\n81|\tevents := make([]Event, 0, len(indexed))\n82|\tfor _, summary := range indexed {\n83|\t\tblob, err := projector.Repo.GetEvent(sessionID, summary.EventID)\n84|\t\tif err != nil {\n85|\t\t\treturn Projection{}, err\n86|\t\t}\n87|\t\tevent, err := DecodeEvent(blob)\n88|\t\tif err != nil {\n89|\t\t\treturn Projection{}, err\n90|\t\t}\n91|\t\tevents = append(events, event)\n92|\t}\n93|\treturn Reduce(Input{\n94|\t\tRecord:      record,\n95|\t\tEvents:      events,\n96|\t\tUnion:       append([]LeaseHead(nil), projector.Union...),\n97|\t\tLocal:       projector.Local,\n98|\t\tLocalHostID: projector.LocalHostID,\n99|\t})\n100|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c75b","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":520,"recorded_at":1780531400001035,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"task_stream":{"kind":"task","id":"01a0adcc-2be3-7222-8844-49fb1c2ca6ad"},"task_id":"01a0adcc-2be3-7222-8844-49fb1c2ca6ad","event":{"kind":"completed","task_id":"01a0adcc-2be3-7222-8844-49fb1c2ca6ad"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c75d","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":521,"recorded_at":1780531400001037,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"call_id":"call_01a0adcc22a07663b7e212e9b4eb0e9a","text":"Read text file `internal/sessstate/doc.go`.\n1|// Package sessstate derives deterministic logical-session state from\n2|// immutable records according to AX v0.5.0 Sections 2.3, 5.1-5.2, 5.7,\n3|// and 14.4: every SessionState value, the winning lease epoch, lease\n4|// conflicts, the current checkpoint, provider identity, and terminal\n5|// binding.\n6|//\n7|// The reducer is a pure function of its input: Reduce takes decoded\n8|// record and event facts and returns one Projection. It performs no\n9|// I/O, reads no clock, and keeps no cache, so the same event sequence\n10|// always yields the same state. Project binds the pure core to a\n11|// sessrepo.Repository for one session: it loads the stored record and\n12|// the authoritative chain through the repository's production entries\n13|// and folds them through Reduce. Project only reads; it mutates no\n14|// durable state of its own and owns no crash window.\n15|//\n16|// Division of authority inside this story:\n17|//\n18|//   - Durable session state — the immutable record, the ordered event\n19|//     chain, source sequence continuity, and the per-session parked\n20|//     channel — is owned by internal/sessrepo and reached only through\n21|//     its production entries (ListSessions, GetRecord, ListEvents,\n22|//     GetEvent). This package never decodes a chain index, never\n23|//     attests a blob, and never lists a session directory.\n24|//   - Canonical attestation stays single-owned: identity, the closed\n25|//     Session Record and Session Event shapes, the per-type payload\n26|//     union, and the unknown-v1-type inert rule are verified by\n27|//     internal/canonicaljson at the sessrepo durable boundary only.\n28|//     The provhost no-attestation-outside-the-leaf gate pins that\n29|//     exclusivity, so Decode projects members from attested bytes and\n30|//     never re-verifies. The payload members Reduce reads were\n31|//     admitted by that closed shape, and a member that no longer\n32|//     decodes refuses the derivation instead of reading as absent.\n33|//   - Strict frame decoding and scalar bound checks stay with their\n34|//     owners: environ.DecodeStrictObject for the JSON frame,\n35|//     environ.CheckUUIDv7 and environ.CheckUint53Bounds for identifier\n36|//     and counter members, scalar.ParseDigest and scalar.ParseUUIDv4\n37|//     for digest and UUID grammars (UUIDv7 members stay with\n38|//     environ.CheckUUIDv7, which owns that check),\n39|//     scalar.ParseProviderID for the provider alphabet, and\n40|//     terminalbackend.ParseID for the terminal backend alphabet.\n41|//   - The refusal census denominator is derived from production\n42|//     through internal/invcore; see census_test.go.\n43|//\n44|// A parked session from sessrepo reaches SessionState as a state, not\n45|// as an error or an omission: when ListSessions reports Parked for the\n46|// session, Project returns a parked Projection carrying the blocking\n47|// reason and the retry hint, and Reduce folds an explicit Parked input\n48|// the same way. A name that exists but is parked still resolves as not\n49|// found at the sessrepo entry; Project takes a session UUID, and the\n50|// listing distinguishes a parked session (entry present) from an\n51|// unknown one (entry absent), so no sessrepo interface change is\n52|// needed for this leaf.\n53|//\n54|// Stated bounds (not silent gaps):\n55|//\n56|//   - Single authoritative chain. Reduce folds exactly the events it\n57|//     is given in order and re-checks chain continuity itself, so a\n58|//     chain-forbidden reordering refuses instead of silently deriving\n59|//     a different state. Cross-partition lease convergence beyond the\n60|//     tuple rule belongs to the ownership-leases story: competing\n61|//     off-chain leases enter only through Input.Union, and the union\n62|//     never rewrites authoritative state — it selects the reported\n63|//     winner and records conflicts.\n64|//   - No name resolution, no list/status rendering, no peer names, and\n65|//     no interactive choice: the local sessrepo steps are reused\n66|//     through Project's listing lookup, and the full Section 2.3 order\n67|//     with choice plus Section 14.4 rendering belong to the sibling\n68|//     name-resolution leaf that builds on this projection.\n69|//   - No persisted profile derivation. Section 2.4 effective-profile\n70|//     authority is out of this leaf's scoped sections; profile.changed\n71|//     and the profile pairs on launch, resume, and fork events are\n72|//     retained as inert facts.\n73|//   - No execution-realm readiness, workspace materialization status,\n74|//     capability map, or sync-age derivation: those Section 14.4\n75|//     fields belong to the provider, workspace, and mesh leaves. The\n76|//     warnings member carries only what this leaf derives\n77|//     (divergent history, stale process, parked blocking reason).\n78|//   - Local role derives from a caller-supplied local host ID against\n79|//     the owner host of the newest authoritative event. An empty local\n80|//     host ID leaves the role unknown rather than guessing replica.\n81|//   - An empty chain derives creating with no authoritative lease, but\n82|//     the union is still validated and resolves the reported winner\n83|//     through the same resolveWinner path: a malformed union refuses\n84|//     exactly as on a non-empty chain, while a well-formed union moves\n85|//     only the reported winner (with its named conflict) and never\n86|//     rewrites the creating state. Local is ignored on this path, including\n87|//     malformed and partial tuples: without an authoritative event there is\n88|//     no local process lease to fence or owner host to compare. LocalHostID\n89|//     leaves the role unknown, even when Union reports a winner. No Local\n90|//     validation is claimed. TestReduceEmptyChainLocalIsIgnored pins this\n91|//     bound through Reduce with and without a selected union winner.\n92|//\n93|// The package adds no ax command, no doctor result, and no runtime\n94|// capability claim.\n95|package sessstate","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c75f","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":522,"recorded_at":1780531400001039,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"call_id":"call_01a0adcc24397262a29ed408809aca0d","text":"Read text file `internal/sessrepo/doc.go`.\n1|// Package sessrepo persists and validates AX Session Records and the\n2|// append-only per-session event chain with source sequence continuity.\n3|//\n4|// Normative scope: AX v0.5.0 sections 2.3 (session name resolution), 5.1\n5|// (Session Record), 5.2 (Session Event), 5.7 (derived session states), and\n6|// 14.4 (list and status fields). This package owns durable session state:\n7|// the immutable record, the ordered event chain beneath it, and the stored\n8|// identity fields that later leaves project into lifecycle state, resolved\n9|// names, and list/status rows.\n10|//\n11|// Division of authority inside this story:\n12|//\n13|//   - Validation of record and event closed shapes and of every self-identity\n14|//     digest is owned by internal/canonicaljson and reached only through its\n15|//     production VerifyObjectIdentity entry. Entry decodes refuse a foreign\n16|//     schema before Verify; the load path re-verifies stored blobs through\n17|//     Verify — recomputing whatever digest the bytes claim — and refuses a\n18|//     non-event_id self field or an index-disagreeing digest at its named\n19|//     arms. This package never re-decodes a frame, never recomputes a\n20|//     bound, and never selects a self field.\n21|//   - Strict frame decoding and scalar bound checks on the members this\n22|//     package must read (session and lease identifiers, lease_sequence,\n23|//     predecessor digests, names) are owned by internal/environ and\n24|//     internal/scalar and reached only through their production checks.\n25|//   - Crash-point vocabulary and outcomes are owned by\n26|//     internal/secconftest. The repository fires the owner's own points\n27|//     through the owner's Injector: a fault before the durable write carries\n28|//     safe_retry, a fault after it carries recoverable_parked_state, and a\n29|//     crashed commit counts as committed.\n30|//   - The refusal census denominator is derived from production through\n31|//     internal/invcore; see census_test.go.\n32|//\n33|// Per-session parked reporting (SPEC.md:9082, Section 13.13\n34|// recoverable_parked_state; Section 14.4 per-session warnings).\n35|//\n36|// ListSessions reports one entry per session directory in session-ID\n37|// order. A session whose bytes no longer verify is returned as a parked\n38|// entry — Parked=true with the blocking reason and the same-operation\n39|// retry — and never fails the listing for its healthy siblings. Resolve\n40|// routes only healthy sessions; a query naming only a parked session is\n41|// not found. GetRecord, GetEvent, and ListEvents still refuse a parked\n42|// session per session with the load failure.\n43|//\n44|// Why per-session instead of repository-wide closure: a repository-wide\n45|// listing error carries no per-session channel, so the Section 5.7\n46|// reducer and the Section 14.4 rendering leaves could not project the\n47|// parked lifecycle state, the blocking reason, or the warnings from what\n48|// this leaf exposes — and one torn session denied listing and name\n49|// resolution to every healthy sibling permanently when its original\n50|// bytes were lost. Per-session reporting keeps healthy sessions usable\n51|// while the parked session stays visible. The tradeoff is that callers\n52|// must check Parked: a listing that contains parked entries returns nil\n53|// error by design.\n54|//\n55|// Retry table (same-operation retry, Section 13.13):\n56|//\n57|//   - Bare session directory (no record.json, no chain.json): retry\n58|//     CreateSession with the session record for this session ID. Any\n59|//     valid record for the ID resumes; the parked state is the bare\n60|//     directory left by a crash between the directory and record steps.\n61|//   - Record parked without a chain index (record.json verifies, no\n62|//     chain.json): retry CreateSession with the byte-identical session\n63|//     record. A different record for the same session ID is refused\n64|//     with ErrSessionExists and the parked bytes survive; the\n65|//     byte-equality is full-content, not length-only.\n66|//   - Torn store (chain.json present but the session no longer\n67|//     verifies): no CreateSession retry heals it. A byte-identical\n68|//     retry is refused as an existing session and a differing retry is\n69|//     refused the same way; the store stays parked.\n70|//\n71|// Operator remedy. There is no delete, prune, or quarantine entry by\n72|// design: records and events are append-only and no production path\n73|// rewrites or deletes an existing entry. When no same-operation retry\n74|// heals a parked session — the original record bytes are lost, or the\n75|// store is torn past the create window — the operator removes the\n76|// session directory at <data-root>/sessions/<session-id> from the\n77|// filesystem after confirming no host will retry with the original\n78|// bytes, and the listing heals on the next read. Removing the directory\n79|// discards whatever that session had parked; it never touches siblings.\n80|// Downstream leaves consume the parked channel as: SessionSummary.Parked\n81|// selects the parked/failed lifecycle projection, BlockingReason feeds\n82|// status/doctor blocking reason and warnings, and RetryHint feeds the\n83|// retry or remedy line.\n84|//\n85|// Stated bounds (not silent gaps):\n86|//\n87|//   - Single authoritative branch. The repository tracks one ordered chain\n88|//     per session in arrival order. A same-epoch event under a different\n89|//     lease is preserved as an immutable blob but refused from the chain\n90|//     with ErrDivergentBranch; lease arbitration across partitions belongs\n91|//     to the ownership-leases story, not to this leaf.\n92|//   - No lifecycle derivation. Section 5.7 SessionState reduction and the\n93|//     full Section 2.3 four-step resolution order (peer-learned names,\n94|//     interactive choice) belong to the sibling reducer and name-resolution\n95|//     leaves. This package exposes the stored facts they project: exact\n96|//     local names with ASCII case-fold ambiguity detection, UUID routing,\n97|//     per-session chain heads, and the parked channel above.\n98|//   - No Section 14.4 rendering. ListSessions exposes stored identity plus\n99|//     chain-head facts (or the parked channel); human or JSON rendering\n100|//     of owner host, checkpoint age, capability status, and warnings\n101|//     belongs to the CLI surface leaf.\n102|//\n103|// The package adds no ax command, no doctor result, and no runtime\n104|// capability claim.\n105|package sessrepo","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c761","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":523,"recorded_at":1780531400001041,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"call_id":"call_01a0adcc255c707287ff3b07b22e5c78","text":"Read text file `internal/provhost/profile.go`.\n1|package provhost\n2|\n3|// This file maps execution profiles to provider adapter flags under\n4|// Section 7.7. The v0.3.0 yolo mappings below are exact adapter\n5|// strings the host persists into SpawnPlans; standard uses the\n6|// provider's normal approval and sandbox behavior and omits every\n7|// unrestricted flag. The adapter MUST probe the exact provider\n8|// version before applying a mapping, and an absent or changed flag\n9|// fails closed: unknown providers and unknown profiles are refused,\n10|// never defaulted.\n11|\n12|// Execution profiles Section 7.7 defines.\n13|const (\n14|\tProfileStandard = \"standard\"\n15|\tProfileYOLO     = \"yolo\"\n16|)\n17|\n18|// profileProviders lists the six Section 7.7 providers in table\n19|// order. Pi has no permission-mode flag: both of its profiles resolve\n20|// to the default full tool set, and probe and launch output MUST\n21|// disclose that equivalence rather than invent a flag.\n22|var profileProviders = []string{\n23|\t\"codex\",\n24|\t\"claude\",\n25|\t\"gemini\",\n26|\t\"muse\",\n27|\t\"antigravity\",\n28|\t\"pi\",\n29|}\n30|\n31|// profileYOLOMapping is the required yolo adapter flag per provider.\n32|// Standard maps to the empty string for every provider: no flag, no\n33|// alias that silently expands to unrestricted mode.\n34|var profileYOLOMapping = map[string]string{\n35|\t\"codex\":       \"--dangerously-bypass-approvals-and-sandbox\",\n36|\t\"claude\":      \"--dangerously-skip-permissions\",\n37|\t\"gemini\":      \"--approval-mode=yolo\",\n38|\t\"muse\":        \"--yolo\",\n39|\t\"antigravity\": \"--dangerously-skip-permissions\",\n40|\t\"pi\":          \"default_unrestricted_tool_set\",\n41|}\n42|\n43|// profileNames is the exact Section 7.7 execution-profile vocabulary:\n44|// standard and yolo, nothing else. It is package-level so the closed\n45|// vocabulary census derives it: admitting a third profile here must\n46|// redden TestProfileNamesAreDerivedFromSpec, not resolve to a flag.\n47|var profileNames = map[string]bool{\n48|\tProfileStandard: true,\n49|\tProfileYOLO:     true,\n50|}\n51|\n52|// ProfileMapping resolves the adapter flag for one provider under one\n53|// profile. Standard returns the empty string: the caller omits every\n54|// unrestricted flag. An unknown provider or profile is an\n55|// invalid_config caller error; there is no default mapping a new\n56|// provider could silently inherit.\n57|func ProfileMapping(providerID, profile string) (string, error) {\n58|\tmapping, known := profileYOLOMapping[providerID]\n59|\tif !known {\n60|\t\tfailure, err := failInvalid(\"profile mapping names an unknown provider\")\n61|\t\tif err != nil {\n62|\t\t\treturn \"\", err\n63|\t\t}\n64|\t\treturn \"\", failure\n65|\t}\n66|\tif !profileNames[profile] {\n67|\t\tfailure, err := failInvalid(\"profile mapping names an unknown profile\")\n68|\t\tif err != nil {\n69|\t\t\treturn \"\", err\n70|\t\t}\n71|\t\treturn \"\", failure\n72|\t}\n73|\tif profile == ProfileYOLO {\n74|\t\treturn mapping, nil\n75|\t}\n76|\treturn \"\", nil\n77|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c763","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":524,"recorded_at":1780531400001043,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"call_id":"call_01a0adcc26a970f79ee41120dd5e1410","text":"Read text file `internal/sessstate/project.go`.\n1|package sessstate\n2|\n3|import (\n4|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n5|)\n6|\n7|// Projector binds the pure reducer to one repository. It only reads:\n8|// ListSessions locates the session (and its parked channel), GetRecord\n9|// and ListEvents with GetEvent load the authoritative bytes, and\n10|// Decode plus Reduce derive the projection. No entry here mutates\n11|// durable state, so there is no crash window to arm: placing\n12|// secconftest points around reads would measure nothing, and a crashed\n13|// read retries as the same read. Idempotency is the reducer's purity —\n14|// projecting twice yields the identical projection — pinned by\n15|// TestProjectIsIdempotentAcrossReads.\n16|type Projector struct {\n17|\t// Repo is the session repository to project from. It is required.\n18|\tRepo *sessrepo.Repository\n19|\t// LocalHostID selects the local role: the owner host of the\n20|\t// newest authoritative event decides owner against replica. Empty\n21|\t// leaves the role unknown rather than guessing.\n22|\tLocalHostID string\n23|\t// Union carries competing off-chain leases observed at mesh union\n24|\t// for winner resolution. Nil projects the chain alone.\n25|\tUnion []LeaseHead\n26|\t// Local is the lease the local host acts under for the stale\n27|\t// projection. Zero disables the stale override.\n28|\tLocal LeaseHead\n29|}\n30|\n31|// Project derives the session projection for one session ID. A parked\n32|// session returns the parked state with its blocking reason and retry,\n33|// never an error or an omission; an ID with no listing entry refuses\n34|// unknown. The listing therefore tells a parked name apart from a\n35|// missing one with no sessrepo interface change.\n36|func (projector *Projector) Project(sessionID string) (Projection, error) {\n37|\tif projector == nil || projector.Repo == nil {\n38|\t\treturn Projection{}, refuse(ErrDerivation, \"projector carries no repository\")\n39|\t}\n40|\tsummaries, err := projector.Repo.ListSessions()\n41|\tif err != nil {\n42|\t\treturn Projection{}, err\n43|\t}\n44|\tvar found *sessrepo.SessionSummary\n45|\tfor index := range summaries {\n46|\t\tif summaries[index].SessionID == sessionID {\n47|\t\t\tfound = &summaries[index]\n48|\t\t\tbreak\n49|\t\t}\n50|\t}\n51|\tif found == nil {\n52|\t\treturn Projection{}, refuse(ErrUnknownSession, \"no session %s\", sessionID)\n53|\t}\n54|\tif found.Parked {\n55|\t\treturn Reduce(Input{\n56|\t\t\tRecord: Record{\n57|\t\t\t\tSessionID:  found.SessionID,\n58|\t\t\t\tRecordID:   found.RecordID,\n59|\t\t\t\tName:       found.Name,\n60|\t\t\t\tKind:       found.Kind,\n61|\t\t\t\tProviderID: found.ProviderID,\n62|\t\t\t},\n63|\t\t\tParked: &ParkedFacts{\n64|\t\t\t\tBlockingReason: found.BlockingReason,\n65|\t\t\t\tRetryHint:      found.RetryHint,\n66|\t\t\t},\n67|\t\t})\n68|\t}\n69|\trecordBytes, err := projector.Repo.GetRecord(sessionID)\n70|\tif err != nil {\n71|\t\treturn Projection{}, err\n72|\t}\n73|\trecord, err := DecodeRecord(recordBytes)\n74|\tif err != nil {\n75|\t\treturn Projection{}, err\n76|\t}\n77|\tindexed, err := projector.Repo.ListEvents(sessionID)\n78|\tif err != nil {\n79|\t\treturn Projection{}, err\n80|\t}\n81|\tevents := make([]Event, 0, len(indexed))\n82|\tfor _, summary := range indexed {\n83|\t\tblob, err := projector.Repo.GetEvent(sessionID, summary.EventID)\n84|\t\tif err != nil {\n85|\t\t\treturn Projection{}, err\n86|\t\t}\n87|\t\tevent, err := DecodeEvent(blob)\n88|\t\tif err != nil {\n89|\t\t\treturn Projection{}, err\n90|\t\t}\n91|\t\tevents = append(events, event)\n92|\t}\n93|\treturn Reduce(Input{\n94|\t\tRecord:      record,\n95|\t\tEvents:      events,\n96|\t\tUnion:       append([]LeaseHead(nil), projector.Union...),\n97|\t\tLocal:       projector.Local,\n98|\t\tLocalHostID: projector.LocalHostID,\n99|\t})\n100|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
