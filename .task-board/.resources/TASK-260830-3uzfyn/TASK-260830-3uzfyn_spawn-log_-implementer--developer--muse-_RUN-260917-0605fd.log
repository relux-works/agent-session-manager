{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb05","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":989,"recorded_at":1780531400001973,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"task_stream":{"kind":"task","id":"01a0adcd-cc86-7c81-b1c7-dee6f0b8a090"},"task_id":"01a0adcd-cc86-7c81-b1c7-dee6f0b8a090","event":{"kind":"output","task_id":"01a0adcd-cc86-7c81-b1c7-dee6f0b8a090","chunk":"{\n  \"chunk_id\": \"exec-18-1\",\n  \"command\": \"sed -n 780,830p internal/canonicaljson/core_records.go; echo ===; grep -rn 'CalculateObjectIdentity' internal/ --include='*.go' | grep -v _test | head\",\n  \"description\": \"Read profile.changed shape check and identity mint sites\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"\\tif err := literalBool(\\\"resume_allowed\\\", false)(object); err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tidentityEstablished := phase == \\\"after_identity\\\" || phase == \\\"before_checkpoint\\\"\\n\\tif identityEstablished && providerPresent == managerPresent {\\n\\t\\treturn invalidIdentity(\\\"session.bootstrap_aborted after identity requires exactly one identity field\\\")\\n\\t}\\n\\tif !identityEstablished && (providerPresent || managerPresent) {\\n\\t\\treturn invalidIdentity(\\\"session.bootstrap_aborted before identity requires both identity fields null\\\")\\n\\t}\\n\\treturn nil\\n}\\n\\nfunc validateProfileChangedPayload(object map[string]any) error {\\n\\tfrom, err := requireEnum(object, \\\"from\\\", \\\"standard\\\", \\\"yolo\\\")\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tto, err := requireEnum(object, \\\"to\\\", \\\"standard\\\", \\\"yolo\\\")\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tif from == to {\\n\\t\\treturn invalidIdentity(\\\"profile.changed from and to must differ\\\")\\n\\t}\\n\\treturn booleans(\\\"confirmed\\\")(object)\\n}\\n\\nfunc validateForceConfirmedPayload(object map[string]any) error {\\n\\tif err := uuid7s(\\\"operation_id\\\", \\\"expected_owner_host_id\\\")(object); err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tif err := positiveUints(\\\"expected_epoch\\\")(object); err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tif err := digests(\\\"checkpoint_id\\\")(object); err != nil {\\n\\t\\treturn err\\n\\t}\\n\\trisks, err := requireArrayRange(object, \\\"accepted_risks\\\", 3, 3)\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\twant := []string{\\\"divergent_history\\\", \\\"split_brain\\\", \\\"stale_process\\\"}\\n\\tfor index, value := range risks {\\n\\t\\tif value != want[index] {\\n\\t\\t\\treturn invalidIdentity(\\\"takeover.force_confirmed accepted_risks must be exactly %v\\\", want)\\n\\t\\t}\\n\\t}\\n\\treturn enum(\\\"confirmation_mode\\\", \\\"interactive\\\", \\\"non_interactive\\\")(object)\\n}\\n\\n===\\ninternal/canonicaljson/canonical.go:24:// strict decode path behind Canonicalize, CalculateObjectIdentity, and\\ninternal/canonicaljson/canonical.go:213://\\tCalculateObjectIdentity\\ninternal/canonicaljson/canonical.go:241:// CalculateObjectIdentity validates the AX common logical number model,\\ninternal/canonicaljson/canonical.go:251:func CalculateObjectIdentity(input []byte) (scalar.Digest, SelfField, error) {\\ninternal/canonicaljson/canonical.go:307:// prepareObjectIdentity with CalculateObjectIdentity, so it carries the same AX\\ninternal/provhost/identity_create.go:20:// canonicaljson.CalculateObjectIdentity, and the binding attestation\\ninternal/provhost/identity_create.go:210:\\tdigest, _, err := canonicaljson.CalculateObjectIdentity(staged)\\ninternal/provhost/identity.go:25:// production identity entry canonicaljson.CalculateObjectIdentity: the two\\ninternal/provhost/identity.go:39:// it, and the conjoined CalculateObjectIdentity entry validates shape\\ninternal/provhost/identity.go:302:\\tif _, _, err := canonicaljson.CalculateObjectIdentity(body); err != nil {\\n\",\n  \"original_output_bytes\": 2713,\n  \"original_output_tokens\": 679,\n  \"truncated\": false\n}","final_result":true}}}
