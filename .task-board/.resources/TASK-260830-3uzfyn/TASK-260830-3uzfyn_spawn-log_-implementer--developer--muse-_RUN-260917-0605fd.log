 \"event %s names no predecessor\", event.ID)\n427|\t}\n428|\tif fold.onChain == nil {\n429|\t\tif len(event.Predecessors) != 1 || event.Predecessors[0] != fold.recordID {\n430|\t\t\treturn refuse(ErrInvalidTransition, \"first event %s must link exactly the session record\", event.ID)\n431|\t\t}\n432|\t\tif event.Sequence != 1 {\n433|\t\t\treturn refuse(ErrInvalidTransition, \"first event %s must open its lease at sequence 1\", event.ID)\n434|\t\t}\n435|\t\tfold.onChain = map[string]struct{}{event.ID: {}}\n436|\t\treturn nil\n437|\t}\n438|\ttail := fold.tailEventID()\n439|\tif event.LeaseID == fold.current.LeaseID && event.LeaseEpoch == fold.current.Epoch {\n440|\t\tif event.Sequence != fold.tailSequence()+1 {\n441|\t\t\tif event.Sequence <= fold.tailSequence() {\n442|\t\t\t\treturn refuse(ErrInvalidTransition, \"event %s repeats chained sequence through %d\", event.ID, fold.tailSequence())\n443|\t\t\t}\n444|\t\t\treturn refuse(ErrInvalidTransition, \"event %s skips chained sequence %d\", event.ID, fold.tailSequence()+1)\n445|\t\t}\n446|\t} else {\n447|\t\tif event.Sequence != 1 {\n448|\t\t\treturn refuse(ErrInvalidTransition, \"successor-lease event %s must restart at sequence 1\", event.ID)\n449|\t\t}\n450|\t}\n451|\tif !containsString(event.Predecessors, tail) {\n452|\t\treturn refuse(ErrInvalidTransition, \"event %s predecessors omit prior authoritative event\", event.ID)\n453|\t}\n454|\tfold.onChain[event.ID] = struct{}{}\n455|\treturn nil\n456|}\n457|\n458|// tail tracking: the fold remembers the last applied event ID and its\n459|// sequence alongside the current lease.\n460|func (fold *chainFold) trackTail(event Event) {\n461|\tfold.tailID = event.ID\n462|\tfold.tailSeq = event.Sequence\n463|}\n464|\n465|func (fold *chainFold) tailEventID() string { return fold.tailID }\n466|\n467|func (fold *chainFold) tailSequence() uint64 { return fold.tailSeq }\n468|\n469|// trackLease observes the envelope lease: same-lease events continue,\n470|// a greater tuple succeeds (recording an epoch gap past plus one), a\n471|// same-epoch second lease diverges, and a lower epoch is stale. The\n472|// chain cannot hold the losing cases, so they refuse here for direct\n473|// Reduce inputs; the union path reports them as conflicts instead.\n474|func (fold *chainFold) trackLease(event Event, lease LeaseHead) (bool, error) {\n475|\tif !fold.haveLease {\n476|\t\tfold.current = lease\n477|\t\tfold.createLease = lease\n478|\t\tfold.haveLease = true\n479|\t\tfold.leases = append(fold.leases, lease)\n480|\t\tfold.trackTail(event)\n481|\t\treturn false, nil\n482|\t}\n483|\tswitch Compare(lease, fold.current) {\n484|\tcase 0:\n485|\t\tfold.trackTail(event)\n486|\t\treturn false, nil\n487|\tcase 1:\n488|\t\tif lease.Epoch == fold.current.Epoch {\n489|\t\t\treturn false, refuse(ErrDivergentLease, \"event %s under lease %s diverges from chain head lease %s at epoch %d\", event.ID, lease.LeaseID, fold.current.LeaseID, fold.current.Epoch)\n490|\t\t}\n491|\t\tif lease.Epoch > fold.current.Epoch+1 {\n492|\t\t\tfold.conflict(ConflictEpochGap, ResolveRuleGreatestTupleWins,\n493|\t\t\t\t\"lease epoch jumps from %d to %d at event %s; only an explicit takeover checkpoint heals the gap\",\n494|\t\t\t\tfold.current.Epoch, lease.Epoch, event.ID)\n495|\t\t}\n496|\t\tfold.previous = fold.current\n497|\t\tfold.current = lease\n498|\t\tfold.leases = append(fold.leases, lease)\n499|\t\tfold.trackTail(event)\n500|\t\treturn true, nil\n501|\tdefault:\n502|\t\treturn false, refuse(ErrStaleLease, \"event %s lease epoch %d precedes chain head epoch %d\", event.ID, lease.Epoch, fold.current.Epoch)\n503|\t}\n504|}\n505|\n506|// tailID and tailSeq live beside the fold; declared here to keep the\n507|// struct literal above readable.\n508|func (fold *chainFold) conflict(kind, rule, format string, arguments ...any) {\n509|\tfold.projection.Conflicts = append(fold.projection.Conflicts, Conflict{\n510|\t\tKind:   kind,\n511|\t\tRule:   rule,\n512|\t\tDetail: fmt.Sprintf(format, arguments...),\n513|\t})\n514|}\n515|\n516|// step moves the derivation through the Section 5.7 table. An empty\n517|// target keeps the state (a fact or inert event performs no\n518|// transition); an equal target restates it (a confirming event while\n519|// already there is not a transition); the first event may only open a\n520|// bootstrap state; every other move needs its table edge, else\n521|// invalid_state_transition.\n522|func (fold *chainFold) step(target State, what string) error {\n523|\tif target == \"\" || target == fold.state {\n524|\t\treturn nil\n525|\t}\n526|\tif fold.state == \"\" {\n527|\t\tif _, ok := initialTargets[target]; !ok {\n528|\t\t\treturn refuse(ErrInvalidTransition, \"%s opens unbootstrapped state %q\", what, string(target))\n529|\t\t}\n530|\t\tfold.state = target\n531|\t\treturn nil\n532|\t}\n533|\tif _, ok := allowedTransitions[fold.state][target]; !ok {\n534|\t\treturn refuse(ErrInvalidTransition, \"%s moves %q to %q without a Section 5.7 edge\", what, string(fold.state), string(target))\n535|\t}\n536|\tfold.state = target\n537|\treturn nil\n538|}\n539|\n540|// effect applies one event's lifecycle meaning after continuity and\n541|// lease tracking. Fact events return an empty target and keep the\n542|// state; unknown v1 types and the v2/v3/v4 non-lifecycle types are\n543|// inert by Section 5.2 (retained, never applied).\n544|func (fold *chainFold) effect(event Event, lease LeaseHead, succession bool) error {\n545|\tname := \"event \" + event.Type + \" \" + event.ID\n546|\tswitch event.Type {\n547|\tcase \"session.created\":\n548|\t\treturn fold.effectCreated(event, name)\n549|\tcase \"terminal.created\":\n550|\t\treturn fold.effectTerminalCreated(event, name)\n551|\tcase \"provider.launched\":\n552|\t\treturn fold.effectProviderLaunched(event, name)\n553|\tcase \"provider.identified\":\n554|\t\treturn fold.effectProviderIdentified(event, name)\n555|\tcase \"session.idle\":\n556|\t\treturn fold.step(StateIdle, name)\n557|\tcase \"session.quiescing\":\n558|\t\treturn fold.step(StateQuiescing, name)\n559|\tcase \"checkpoint.created\":\n560|\t\treturn fold.effectCheckpointCreated(event, name)\n561|\tcase \"sync.completed\":\n562|\t\treturn nil\n563|\tcase \"session.stopped\":\n564|\t\treturn fold.effectStopped(event, name)\n565|\tcase \"session.resumed\":\n566|\t\treturn fold.effectResumed(event, name)\n567|\tcase \"session.bootstrap_aborted\":\n568|\t\treturn fold.effectBootstrapAborted(event, name)\n569|\tcase \"lease.transferred\", \"lease.forced\":\n570|\t\treturn fold.effectLease(event, lease, name, succession)\n571|\tcase \"session.parked\":\n572|\t\treturn fold.step(StateParked, name)\n573|\tcase \"session.failed\":\n574|\t\treturn fold.step(StateFailed, name)\n575|\tcase \"fork.created\", \"profile.changed\", \"takeover.force_confirmed\",\n576|\t\t\"replica.replace_confirmed\", \"task_board.adopted\",\n577|\t\t\"tombstone.issued\", \"tombstone.resolved\":\n578|\t\treturn nil\n579|\tcase \"session.tombstoned\":\n580|\t\treturn fold.step(StateTombstoned, name)\n581|\tcase \"task_board.launched\":\n582|\t\treturn fold.effectTaskBoardLaunched(event, name)\n583|\tdefault:\n584|\t\treturn nil\n585|\t}\n586|}\n587|\n588|// effectCreated opens the bootstrap, including the Section 5.7\n589|// failed-to-creating retry: epoch 1 under the same winning create\n590|// lease, no validated checkpoint yet, and no authoritative bootstrap\n591|// abort on record. Anything else that reaches for creating refuses.\n592|func (fold *chainFold) effectCreated(event Event, what string) error {\n593|\tif fold.state == \"\" {\n594|\t\treturn fold.step(StateCreating, what)\n595|\t}\n596|\tif fold.state != StateFailed {\n597|\t\treturn fold.step(StateCreating, what)\n598|\t}\n599|\tif event.LeaseEpoch != 1 || event.LeaseID != fold.createLease.LeaseID ||\n600|\t\tevent.LeaseEpoch != fold.createLease.Epoch {\n601|\t\treturn refuse(ErrInvalidTransition, \"%s retries bootstrap under a new lease\", what)\n602|\t}\n603|\tif fold.seenCheckpoint {\n604|\t\treturn refuse(ErrInvalidTransition, \"%s retries bootstrap past a validated checkpoint\", what)\n605|\t}\n606|\tif fold.seenAbort {\n607|\t\treturn refuse(ErrInvalidTransition, \"%s retries bootstrap past an authoritative abort\", what)\n608|\t}\n609|\treturn fold.step(StateCreating, what)\n610|}\n611|\n612|// effectTerminalCreated records the terminal binding; as the first\n613|// event it also opens the bootstrap in creating.\n614|func (fold *chainFold) effectTerminalCreated(event Event, what string) error {\n615|\tif event.SchemaVersion == \"4.0.0\" {\n616|\t\tbinding, err := payloadString(event.Payload, \"terminal_binding_id\")\n617|\t\tif err != nil {\n618|\t\t\treturn err\n619|\t\t}\n620|\t\tif _, err := scalar.ParseDigest(binding); err != nil {\n621|\t\t\treturn refuse(ErrDerivation, \"%s carries malformed terminal_binding_id: %v\", what, err)\n622|\t\t}\n623|\t\tbackend, err := payloadString(event.Payload, \"terminal_backend_id\")\n624|\t\tif err != nil {\n625|\t\t\treturn err\n626|\t\t}\n627|\t\tif _, err := terminalbackend.ParseID(backend); err != nil {\n628|\t\t\treturn refuse(ErrDerivation, \"%s carries refused terminal backend: %v\", what, err)\n629|\t\t}\n630|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, BindingID: binding, EventID: event.ID}\n631|\t} else {\n632|\t\tbackend, err := payloadString(event.Payload, \"backend\")\n633|\t\tif err != nil {\n634|\t\t\treturn err\n635|\t\t}\n636|\t\tif backend != \"tmux\" && backend != \"conpty\" {\n637|\t\t\treturn refuse(ErrDerivation, \"%s carries unknown terminal backend %q\", what, backend)\n638|\t\t}\n639|\t\tterminalID, err := payloadString(event.Payload, \"terminal_id\")\n640|\t\tif err != nil {\n641|\t\t\treturn err\n642|\t\t}\n643|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, TerminalID: terminalID, EventID: event.ID}\n644|\t}\n645|\tfold.projection.HasTerminal = true\n646|\tif fold.state == \"\" {\n647|\t\treturn fold.step(StateCreating, what)\n648|\t}\n649|\treturn nil\n650|}\n651|\n652|// effectProviderLaunched moves to running and records the launched\n653|// version. The record provider stays authoritative: a launched event\n654|// naming another provider records a provider_mismatch conflict under\n655|// the record-pinned-provider-wins rule instead of rewriting identity.\n656|func (fold *chainFold) effectProviderLaunched(event Event, what string) error {\n657|\tproviderID, err := payloadString(event.Payload, \"provider_id\")\n658|\tif err != nil {\n659|\t\treturn err\n660|\t}\n661|\tversion, err := payloadString(event.Payload, \"provider_version\")\n662|\tif err != nil {\n663|\t\treturn err\n664|\t}\n665|\tif providerID != fold.recordProvider {\n666|\t\tfold.conflict(ConflictProviderMismatch, ResolveRuleRecordPinnedProviderWins,\n667|\t\t\t\"event %s launches provider %q under record provider %q; the record value stays authoritative\",\n668|\t\t\tevent.ID, providerID, fold.recordProvider)\n669|\t} else {\n670|\t\tfold.projection.Provider.Version = version\n671|\t}\n672|\treturn fold.step(StateRunning, what)\n673|}\n674|\n675|// effectProviderIdentified records the newest identity record with\n676|// its confidence.\n677|func (fold *chainFold) effectProviderIdentified(event Event, what string) error {\n678|\trecordID, err := payloadString(event.Payload, \"provider_identity_record_id\")\n679|\tif err != nil {\n680|\t\treturn err\n681|\t}\n682|\tif _, err := scalar.ParseDigest(recordID); err != nil {\n683|\t\treturn refuse(ErrDerivation, \"%s carries malformed provider_identity_record_id: %v\", what, err)\n684|\t}\n685|\tconfidence, err := payloadString(event.Payload, \"confidence\")\n686|\tif err != nil {\n687|\t\treturn err\n688|\t}\n689|\tfold.projection.Provider.IdentityRecordID = recordID\n690|\tfold.projection.Provider.Confidence = confidence\n691|\treturn nil\n692|}\n693|\n694|// effectCheckpointCreated records the newest validated checkpoint and\n695|// moves idle or quiescing into checkpointing, or checkpointing back to\n696|// idle at the validated boundary. Any other lifecycle position refuses:\n697|// a checkpoint cannot land while running, creating, stopped, parked,\n698|// failed, stale, materializing, or tombstoned without the quiesce or\n699|// resume the table requires.\n700|func (fold *chainFold) effectCheckpointCreated(event Event, what string) error {\n701|\tcheckpointID, err := payloadString(event.Payload, \"checkpoint_id\")\n702|\tif err != nil {\n703|\t\treturn err\n704|\t}\n705|\tif _, err := scalar.ParseDigest(checkpointID); err != nil {\n706|\t\treturn refuse(ErrDerivation, \"%s carries malformed checkpoint_id: %v\", what, err)\n707|\t}\n708|\tkind, err := payloadString(event.Payload, \"kind\")\n709|\tif err != nil {\n710|\t\treturn err\n711|\t}\n712|\tfold.noteCheckpoint(checkpointID, kind, event.ID)\n713|\tswitch fold.state {\n714|\tcase \"\", StateIdle, StateQuiescing:\n715|\t\tif fold.state == \"\" {\n716|\t\t\treturn refuse(ErrInvalidTransition, \"%s publishes a checkpoint before any bootstrap\", what)\n717|\t\t}\n718|\t\treturn fold.step(StateCheckpointing, what)\n719|\tcase StateCheckpointing:\n720|\t\treturn fold.step(StateIdle, what)\n721|\tdefault:\n722|\t\treturn fold.step(StateCheckpointing, what)\n723|\t}\n724|}\n725|\n726|// effectStopped derives stopped for a checkpointed closure and failed\n727|// for a bootstrap abort. No event may derive stopped while the newest\n728|// checkpoint is null: the event's own checkpoint counts, so a\n729|// checkpointed stop carries its resumable base with it. A bootstrap\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
