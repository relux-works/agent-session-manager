{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca15","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":869,"recorded_at":1780531400001733,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"call_id":"call_01a0adccffaa7390a752dacd1192c62a","text":"Read text file `internal/sessquery/lease.go`.\n(899 line(s) above)\n900|}\n901|\n902|// checkClosureProfilePairs walks the closure in authoritative chain\n903|// order and binds every launch, resume, and fork pair to its\n904|// Section 2.4 derivation: the first launch carries the creation\n905|// profile with a null source, and every later launch carries the\n906|// newest authoritative profile.changed event at or before it with\n907|// that change's target profile (the creation pair while no change\n908|// exists). Every resume carries the effective pair of its own\n909|// referenced checkpoint (referencedCheckpointProfile), never the\n910|// outer-walk prefix. Every fork carries the newly persisted\n911|// Session Record profile with a null source: the fork event lives\n912|// in the new session chain, so creation here is already the new\n913|// record; its source_profile_event_id provenance is never read.\n914|// Each pair mismatch, each unexpected or missing source, and each\n915|// source that fails the governing-closure resolution below refuses\n916|// integrity failure.\n917|func checkClosureProfilePairs(checkpoint admittedCheckpoint, creation, recordID string, events []sessrepo.EventSummary, closure map[string]bool, repo *sessrepo.Repository, admission checkpointAdmission) error {\n918|\tif _, err := checkpoint.authority(); err != nil {\n919|\t\treturn err\n920|\t}\n921|\tbyID := make(map[string]sessrepo.EventSummary, len(events))\n922|\tfor _, summary := range events {\n923|\t\tbyID[summary.EventID] = summary\n924|\t}\n925|\tnewestSource, newestProfile := \"\", \"\"\n926|\thasNewest := false\n927|\tfirstLaunch := true\n928|\tfor _, summary := range events {\n929|\t\tif !closure[summary.EventID] {\n930|\t\t\tcontinue\n931|\t\t}\n932|\t\tswitch summary.EventType {\n933|\t\tcase \"profile.changed\":\n934|\t\t\ttarget, err := eventProfileTarget(checkpoint, repo, summary)\n935|\t\t\tif err != nil {\n936|\t\t\t\treturn err\n937|\t\t\t}\n938|\t\t\tnewestSource, newestProfile, hasNewest = summary.EventID, target, true\n939|\t\tcase \"provider.launched\", \"task_board.launched\":\n940|\t\t\tpair, err := eventProfilePair(checkpoint, repo, summary)\n941|\t\t\tif err != nil {\n942|\t\t\t\treturn err\n943|\t\t\t}\n944|\t\t\twantProfile, wantSource, wantHasSource := creation, \"\", false\n945|\t\t\tif !firstLaunch && hasNewest {\n946|\t\t\t\twantProfile, wantSource, wantHasSource = newestProfile, newestSource, true\n947|\t\t\t}\n948|\t\t\tif err := checkProfilePairSource(checkpoint, summary, pair, wantProfile, wantSource, wantHasSource, byID, closure); err != nil {\n949|\t\t\t\treturn err\n950|\t\t\t}\n951|\t\t\tfirstLaunch = false\n952|\t\tcase \"session.resumed\":\n953|\t\t\tpair, err := eventProfilePair(checkpoint, repo, summary)\n954|\t\t\tif err != nil {\n955|\t\t\t\treturn err\n956|\t\t\t}\n957|\t\t\twantProfile, wantSource, wantHasSource, refClosure, err := referencedCheckpointProfile(checkpoint, summary, creation, recordID, events, admission, repo)\n958|\t\t\tif err != nil {\n959|\t\t\t\treturn err\n960|\t\t\t}\n961|\t\t\tif err := checkProfilePairSource(checkpoint, summary, pair, wantProfile, wantSource, wantHasSource, byID, refClosure); err != nil {\n962|\t\t\t\treturn err\n963|\t\t\t}\n964|\t\tcase \"fork.created\":\n965|\t\t\tpair, err := eventProfilePair(checkpoint, repo, summary)\n966|\t\t\tif err != nil {\n967|\t\t\t\treturn err\n968|\t\t\t}\n969|\t\t\tif err := checkProfilePairSource(checkpoint, summary, pair, creation, \"\", false, byID, closure); err != nil {\n970|\t\t\t\treturn err\n971|\t\t\t}\n972|\t\t}\n973|\t}\n974|\treturn nil\n975|}\n976|\n977|// checkReferencedCheckpointBinding admits one resume-referenced\n978|// Checkpoint Record through the same semantic owner the winner and\n979|// necessary-ancestor checkpoints use. The owning lease is resolved\n980|// by (epoch, lease_id) tuple within the winning ancestry chain for\n981|// the session; historical leases stay admissible because the chain\n982|// covers every epoch from the winner down to the root, while a\n983|// fencing token without an admitted owning lease at that epoch is\n984|// incomplete authority. The creator must be that lease's holder,\n985|// the persistence variant must match the Session Record kind, every\n986|// head must resolve at or before the owning lease, and the consuming\n987|// resume must be at the same or a later lease in that ancestry. A\n988|// missing, misbound, future-owned, or unresolvable reference refuses\n989|// observation_unavailable, never a minted fact.\n990|func checkReferencedCheckpointBinding(ref validatedCheckpoint, checkpointID, sessionID, sessionKind string, summary sessrepo.EventSummary, chain []validatedLease, repo *sessrepo.Repository) (result admittedCheckpoint, err error) {\n991|\tvar owner validatedLease\n992|\tfound := false\n993|\tfor _, lease := range chain {\n994|\t\tif lease.SessionID == ref.SessionID && lease.Epoch == ref.LeaseEpoch && lease.LeaseID == ref.LeaseID {\n995|\t\t\towner = lease\n996|\t\t\tfound = true\n997|\t\t\tbreak\n998|\t\t}\n999|\t}\n1000|\tif !found {\n1001|\t\terr = fmt.Errorf(\"%w: validated checkpoint %s is bound to lease %s at epoch %d without an admitted owning lease\", ErrObservationUnavailable, checkpointID, ref.LeaseID, ref.LeaseEpoch)\n1002|\t\treturn\n1003|\t}\n1004|\treturn admitCheckpoint(ref, sessionID, owner, sessionKind, chain, repo, &summary)\n1005|}\n1006|\n1007|// checkReferencedCheckpointTemporal binds the checkpoint's authority to the\n1008|// event that consumes it. The owning lease must be the consuming lease or an\n1009|// earlier lease in the admitted winner-to-root ancestry. Each checkpoint head\n1010|// must also be an ancestor of the resume event; otherwise the resume would\n1011|// consume a checkpoint whose authoritative state is later than the event.\n1012|func checkReferencedCheckpointTemporal(checkpoint validatedCheckpoint, owner validatedLease, summary sessrepo.EventSummary, chain []validatedLease, repo *sessrepo.Repository) error {\n1013|\townerIndex, ownerFound := leaseChainIndex(chain, owner.Epoch, owner.LeaseID)\n1014|\tresumeIndex, resumeFound := leaseChainIndex(chain, summary.LeaseEpoch, summary.LeaseID)\n1015|\tif !ownerFound || !resumeFound {\n1016|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s and resume event %s do not share an admitted lease ancestry\", ErrObservationUnavailable, checkpoint.Digest, summary.EventID)\n1017|\t}\n1018|\tif ownerIndex < resumeIndex {\n1019|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is owned by later lease %s at epoch %d than consuming resume %s at epoch %d\", ErrObservationUnavailable, checkpoint.Digest, owner.LeaseID, owner.Epoch, summary.EventID, summary.LeaseEpoch)\n1020|\t}\n1021|\tif repo == nil {\n1022|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s temporal authority for resume event %s cannot be established: no winning source chain\", ErrObservationUnavailable, checkpoint.Digest, summary.EventID)\n1023|\t}\n1024|\tevents, err := repo.ListEvents(checkpoint.SessionID)\n1025|\tif err != nil {\n1026|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s temporal authority for resume event %s cannot be established: %v\", ErrObservationUnavailable, checkpoint.Digest, summary.EventID, err)\n1027|\t}\n1028|\tbyID := make(map[string]sessrepo.EventSummary, len(events))\n1029|\tfor _, event := range events {\n1030|\t\tbyID[event.EventID] = event\n1031|\t}\n1032|\tif _, ok := byID[summary.EventID]; !ok {\n1033|\t\treturn fmt.Errorf(\"%w: resume event %s for checkpoint %s is not in the winning source chain\", ErrObservationUnavailable, summary.EventID, checkpoint.Digest)\n1034|\t}\n1035|\tancestors := make(map[string]bool, len(events))\n1036|\tstack := append([]string(nil), summary.Predecessors...)\n1037|\tfor len(stack) > 0 {\n1038|\t\tid := stack[len(stack)-1]\n1039|\t\tstack = stack[:len(stack)-1]\n1040|\t\tif ancestors[id] {\n1041|\t\t\tcontinue\n1042|\t\t}\n1043|\t\tancestor, ok := byID[id]\n1044|\t\tif !ok {\n1045|\t\t\t// The repository's validated chain includes the Session Record\n1046|\t\t\t// digest as the genesis predecessor, not as an EventSummary.\n1047|\t\t\t// Other missing predecessors would already have refused from\n1048|\t\t\t// Repository.ListEvents, so do not confuse that record boundary\n1049|\t\t\t// with an unreadable event.\n1050|\t\t\tcontinue\n1051|\t\t}\n1052|\t\tancestors[id] = true\n1053|\t\tstack = append(stack, ancestor.Predecessors...)\n1054|\t}\n1055|\tfor _, head := range checkpoint.EventHeads {\n1056|\t\tif !ancestors[head] {\n1057|\t\t\treturn fmt.Errorf(\"%w: resume event %s does not descend from checkpoint %s event head %s\", ErrObservationUnavailable, summary.EventID, checkpoint.Digest, head)\n1058|\t\t}\n1059|\t}\n1060|\treturn nil\n1061|}\n1062|\n1063|// leaseChainIndex returns the winner-to-root position of one lease. A lower\n1064|// index is a later lease; this keeps the temporal rule tied to the admitted\n1065|// ancestry rather than to an independently sorted canonical tuple.\n1066|func leaseChainIndex(chain []validatedLease, epoch uint64, leaseID string) (int, bool) {\n1067|\tfor index, lease := range chain {\n1068|\t\tif lease.Epoch == epoch && lease.LeaseID == leaseID {\n1069|\t\t\treturn index, true\n1070|\t\t}\n1071|\t}\n1072|\treturn 0, false\n1073|}\n1074|\n1075|// referencedCheckpointProfile derives the Section 2.4 effective\n1076|// pair one session.resumed event must carry (SPEC 5.2): the newest\n1077|// authoritative profile.changed event in its referenced\n1078|// checkpoint's own event-head closure with that change's target\n1079|// profile, or the creation pair while that closure holds no\n1080|// change. The checkpoint_id member resolves through the admitted\n1081|// Checkpoint Records and is admitted through the shared semantic\n1082|// owner (checkReferencedCheckpointBinding) before its closure is\n1083|// consumed; the closure walks the same winning-source chain index,\n1084|// so a later local-only change outside the referenced heads is\n1085|// never consulted and branching history stays admissible. A\n1086|// missing, wrong-session, wrong-lease, wrong-creator,\n1087|// wrong-variant, or unresolvable-head reference is incomplete\n1088|// referenced authority (observation_unavailable); a dangling\n1089|// predecessor inside the referenced closure or a pair the closure\n1090|// contradicts refuses integrity failure. Read failures keep their\n1091|// cause inside the incomplete-authority refusal.\n1092|func referencedCheckpointProfile(checkpoint admittedCheckpoint, summary sessrepo.EventSummary, creation, recordID string, events []sessrepo.EventSummary, admission checkpointAdmission, repo *sessrepo.Repository) (string, string, bool, map[string]bool, error) {\n1093|\tauthority, err := checkpoint.authority()\n1094|\tif err != nil {\n1095|\t\treturn \"\", \"\", false, nil, err\n1096|\t}\n1097|\tpayload, err := eventPayloadMembers(checkpoint, repo, summary)\n1098|\tif err != nil {\n1099|\t\treturn \"\", \"\", false, nil, err\n1100|\t}\n1101|\trawID, err := leaseStringMember(payload, \"checkpoint_id\")\n1102|\tif err != nil {\n1103|\t\treturn \"\", \"\", false, nil, fmt.Errorf(\"%w: session %s event %s carries no valid resume checkpoint for profile authority: %v\", sessstate.ErrIntegrity, authority.sessionID, summary.EventID, err)\n1104|\t}\n1105|\treference, err := scalar.ParseDigest(rawID)\n1106|\tif err != nil {\n1107|\t\treturn \"\", \"\", false, nil, fmt.Errorf(\"%w: session %s event %s carries malformed resume checkpoint %q for profile authority\", sessstate.ErrIntegrity, authority.sessionID, summary.EventID, rawID)\n1108|\t}\n1109|\tcheckpointID := reference.String()\n1110|\tif admission == nil {\n1111|\t\treturn \"\", \"\", false, nil, fmt.Errorf(\"%w: validated checkpoint %s profile authority has no admission capability\", ErrObservationUnavailable, checkpointID)\n1112|\t}\n1113|\tref, err := admission(checkpointID, authority.sessionID, summary)\n1114|\tif err != nil {\n1115|\t\treturn \"\", \"\", false, nil, err\n1116|\t}\n1117|\trefClosure, err := profileClosure(ref, recordID, events)\n1118|\tif err != nil {\n1119|\t\treturn \"\", \"\", false, nil, err\n1120|\t}\n1121|\trefSource, refProfile := \"\", \"\"\n1122|\trefHas := false\n1123|\tfor _, candidate := range events {\n1124|\t\tif !refClosure[candidate.EventID] {\n1125|\t\t\tcontinue\n1126|\t\t}\n1127|\t\tif candidate.EventType != \"profile.changed\" {\n1128|\t\t\tcontinue\n1129|\t\t}\n1130|\t\ttarget, err := eventProfileTarget(checkpoint, repo, candidate)\n1131|\t\tif err != nil {\n1132|\t\t\treturn \"\", \"\", false, nil, err\n1133|\t\t}\n1134|\t\trefSource, refProfile, refHas = candidate.EventID, target, true\n1135|\t}\n1136|\tif !refHas {\n1137|\t\treturn creation, \"\", false, refClosure, nil\n1138|\t}\n1139|\treturn refProfile, refSource, true, refClosure, nil\n1140|}\n1141|\n1142|// checkProfilePairSource binds one decoded pair to its derived\n1143|// expectation. The profile value must equal the derived effective\n1144|// profile, so falling back to the creation value past a change\n1145|// refuses; the source presence must match, so a first launch with\n1146|// any source refuses; and a present source must resolve to the\n1147|// newest authoritative profile.changed event in the closure —\n1148|// missing, out-of-closure (later local-only or losing-lease),\n1149|// wrong-type, and non-newest references each refuse with the\n1150|// violated expectation named.\n1151|func checkProfilePairSource(checkpoint admittedCheckpoint, summary sessrepo.EventSummary, pair profilePair, wantProfile, wantSource string, wantHasSource bool, byID map[string]sessrepo.EventSummary, closure map[string]bool) error {\n1152|\tauthority, err := checkpoint.authority()\n1153|\tif err != nil {\n1154|\t\treturn err\n1155|\t}\n1156|\tif pair.profile != wantProfile {\n1157|\t\treturn fmt.Errorf(\"%w: session %s event %s carries execution profile %q, want effective profile %q for profile authority\", sessstate.ErrIntegrity, authority.sessionID, summary.EventID, pair.profile, wantProfile)\n1158|\t}\n1159|\tif pair.hasSource != wantHasSource {\n1160|\t\tif pair.hasSource {\n1161|\t\t\treturn fmt.Errorf(\"%w: session %s event %s carries profile source %s, want no profile source for profile authority\", sessstate.ErrIntegrity, authority.sessionID, summary.EventID, pair.source)\n1162|\t\t}\n1163|\t\treturn fmt.Errorf(\"%w: session %s event %s carries no profile source, want newest authoritative source %s for profile authority\", sessstate.ErrIntegrity, authority.sessionID, summary.EventID, wantSource)\n1164|\t}\n1165|\tif !wantHasSource {\n1166|\t\treturn nil\n1167|\t}\n1168|\tsourced, ok := byID[pair.source]\n1169|\tif !ok {\n1170|\t\treturn fmt.Errorf(\"%w: session %s event %s names unknown profile source %s for profile authority\", sessstate.ErrIntegrity, authority.sessionID, summary.EventID, pair.source)\n1171|\t}\n1172|\tif !closure[pair.source] {\n1173|\t\treturn fmt.Errorf(\"%w: session %s event %s names profile source %s outside the checkpoint closure for profile authority\", sessstate.ErrIntegrity, authority.sessionID, summary.EventID, pair.source)\n1174|\t}\n1175|\tif sourced.EventType != \"profile.changed\" {\n1176|\t\treturn fmt.Errorf(\"%w: session %s event %s names profile source %s of type %q, want a profile.changed event for profile authority\", sessstate.ErrIntegrity, authority.sessionID, summary.EventID, pair.source, sourced.EventType)\n1177|\t}\n1178|\tif pair.source != wantSource {\n1179|\t\treturn fmt.Errorf(\"%w: session %s event %s names profile source %s, want newest authoritative source %s for profile authority\", sessstate.ErrIntegrity, authority.sessionID, summary.EventID, pair.source, wantSource)\n1180|\t}\n1181|\treturn nil\n1182|}\n1183|\n1184|// checkCheckpointPersistence binds a parsed Checkpoint Record to\n1185|// the persistence variant the referenced Session Record selects\n1186|// (Section 5.4): a direct session requires a non-null\n1187|// provider_manifest_id with a null task_board_bundle_id, while a\n1188|// task_board session requires the reverse. Canonical shape proves\n1189|// exactly one variant is present but cannot select which one is\n1190|// valid, so a swapped variant keeps canonical identity, session,\n1191|// lease, epoch, and creator yet refuses here with incomplete\n1192|// authority (observation_unavailable), never absence or a minted\n1193|// fact. An unknown session kind is malformed configuration: valid\n1194|// Session Records admit only the two kinds.\n1195|func checkCheckpointPersistence(checkpoint validatedCheckpoint, sessionID, sessionKind string) error {\n1196|\tswitch sessionKind {\n1197|\tcase \"direct\":\n1198|\t\tif !checkpoint.HasProviderManifest || checkpoint.HasTaskBoardBundle {\n1199|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries a task-board persistence variant for direct session %s\", ErrObservationUnavailable, checkpoint.Digest, sessionID)\n1200|\t\t}\n1201|\t\treturn nil\n1202|\tcase \"task_board\":\n1203|\t\tif checkpoint.HasProviderManifest || !checkpoint.HasTaskBoardBundle {\n1204|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries a provider persistence variant for task_board session %s\", ErrObservationUnavailable, checkpoint.Digest, sessionID)\n1205|\t\t}\n1206|\t\treturn nil\n1207|\tdefault:\n1208|\t\treturn fmt.Errorf(\"%w: session %s carries unknown kind %q for checkpoint persistence\", ErrInvalidConfig, sessionID, sessionKind)\n1209|\t}\n1210|}\n1211|\n1212|// compareLeaseTuple orders (epoch, lease_id) with the Section 5.3 rule:\n1213|// greatest epoch wins, ties break by bytewise lease-ID order.\n1214|func compareLeaseTuple(epochA uint64, leaseA string, epochB uint64, leaseB string) int {\n1215|\treturn sessstate.Compare(\n1216|\t\tsessstate.LeaseHead{Epoch: epochA, LeaseID: leaseA},\n1217|\t\tsessstate.LeaseHead{Epoch: epochB, LeaseID: leaseB},\n1218|\t)\n1219|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
