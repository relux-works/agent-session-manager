{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000de7f","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":3482,"recorded_at":1780531400006959,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"task_stream":{"kind":"task","id":"01a0ade2-dbd0-7453-954f-498be8f98001"},"task_id":"01a0ade2-dbd0-7453-954f-498be8f98001","event":{"kind":"output","task_id":"01a0ade2-dbd0-7453-954f-498be8f98001","chunk":"{\n  \"chunk_id\": \"exec-76-1\",\n  \"command\": \"sed -n 480,540p internal/provhost/inventory_test.go\",\n  \"description\": \"Read constructor code table test\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"}\\n\\n// TestRefusalConstructorsAreTotal proves the fallible-constructor error\\n// path never fires in practice: every constructor returns a failure and\\n// a nil error across representative dynamic causes. The sites recorded\\n// here are test lines, not production sites, so every key this test adds\\n// to the exercised set is removed before it returns, keeping the\\n// reverse-direction audit exact.\\nfunc TestRefusalConstructorsAreTotal(t *testing.T) {\\n\\tbeforeSites, beforeCodes := refusalRecorder.Snapshot()\\n\\tt.Cleanup(func() {\\n\\t\\trefusalRecorder.Restore(beforeSites, beforeCodes)\\n\\t})\\n\\tcause := fmt.Errorf(\\\"fake: dynamic cause\\\")\\n\\tlongCause := fmt.Errorf(\\\"fake: %s\\\", strings.Repeat(\\\"x\\\", 300))\\n\\tfor _, kase := range []struct {\\n\\t\\tname string\\n\\t\\tcall func() (*axerror.Error, error)\\n\\t\\tcode string\\n\\t}{\\n\\t\\t{\\\"invalid\\\", func() (*axerror.Error, error) { return failInvalid(\\\"fake\\\") }, \\\"invalid_config\\\"},\\n\\t\\t{\\\"protocol\\\", func() (*axerror.Error, error) { return failProtocol(\\\"fake\\\", \\\"member\\\") }, \\\"provider_protocol_error\\\"},\\n\\t\\t{\\\"mismatch\\\", func() (*axerror.Error, error) { return failMismatch(\\\"fake\\\", \\\"3.0.0\\\") }, \\\"incompatible_protocol\\\"},\\n\\t\\t{\\\"process with cause\\\", func() (*axerror.Error, error) { return failProcess(\\\"fake\\\", cause) }, \\\"provider_process_failed\\\"},\\n\\t\\t{\\\"process with long cause\\\", func() (*axerror.Error, error) { return failProcess(\\\"fake\\\", longCause) }, \\\"provider_process_failed\\\"},\\n\\t\\t{\\\"process without cause\\\", func() (*axerror.Error, error) { return failProcess(\\\"fake\\\", nil) }, \\\"provider_process_failed\\\"},\\n\\t\\t{\\\"timeout\\\", func() (*axerror.Error, error) { return failTimeout(\\\"fake\\\", 100) }, \\\"provider_timeout\\\"},\\n\\t\\t{\\\"integrity\\\", func() (*axerror.Error, error) { return failIntegrity(\\\"fake\\\", \\\"unknown\\\", \\\"m\\\", \\\"t\\\") }, \\\"integrity_failure\\\"},\\n\\t} {\\n\\t\\tt.Run(kase.name, func(t *testing.T) {\\n\\t\\t\\tfailure, err := kase.call()\\n\\t\\t\\tif err != nil {\\n\\t\\t\\t\\tt.Fatalf(\\\"constructor error = %v, want nil\\\", err)\\n\\t\\t\\t}\\n\\t\\t\\tif failure == nil || string(failure.Code()) != kase.code {\\n\\t\\t\\t\\tt.Fatalf(\\\"constructor failure = %v, want code %s\\\", failure, kase.code)\\n\\t\\t\\t}\\n\\t\\t})\\n\\t}\\n}\\n\",\n  \"original_output_bytes\": 2029,\n  \"original_output_tokens\": 508,\n  \"truncated\": false\n}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000de81","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":3483,"recorded_at":1780531400006961,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"task_stream":{"kind":"task","id":"01a0ade2-dbd0-7453-954f-498be8f98001"},"task_id":"01a0ade2-dbd0-7453-954f-498be8f98001","event":{"kind":"completed","task_id":"01a0ade2-dbd0-7453-954f-498be8f98001"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000de83","stream":{"kind":"session","id":"01a0adca-fe2f-74a0-ad0c-d5a68eb484bd"},"sequence":3484,"recorded_at":1780531400006963,"record_type":"event","durability":"durable","causation_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d","run_stream":{"kind":"run","id":"05bf7ae6-0f62-48b6-bcc1-cef4e9824e8d"},"call_id":"call_01a0ade2d5d2705f8d21964c65b19b72","text":"Read text file `internal/provhost/inventory_test.go`.\n(249 line(s) above)\n250|\t\t\t}\n251|\t\t\tif qualifier, ok := selector.X.(*ast.Ident); ok {\n252|\t\t\t\tqualified := qualifier.Name + \".\" + selector.Sel.Name\n253|\t\t\t\tswitch qualified {\n254|\t\t\t\tcase \"axerror.New\", \"axerror.LocalFromUntrusted\":\n255|\t\t\t\t\tif !insideConstructor(call.Pos()) {\n256|\t\t\t\t\t\tinventory.StrayBuilders = append(inventory.StrayBuilders, site+\" \"+qualified)\n257|\t\t\t\t\t}\n258|\t\t\t\t\treturn true\n259|\t\t\t\tcase \"errors.New\", \"fmt.Errorf\":\n260|\t\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" \"+qualified)\n261|\t\t\t\t\treturn true\n262|\t\t\t\t}\n263|\t\t\t}\n264|\t\t\tif selector.Sel.Name == \"panic\" {\n265|\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" panic\")\n266|\t\t\t}\n267|\t\t\treturn true\n268|\t\t})\n269|\t}\n270|\treturn inventory, nil\n271|}\n272|\n273|// sectionLines joins the pinned document lines for a section, failing\n274|// when the section boundaries move. Every citation below resolves\n275|// against the real text, never against a restatement in this repository.\n276|func sectionLines(t *testing.T, document *specdoc.Document, section string, first, last int) string {\n277|\tt.Helper()\n278|\tfor _, line := range []int{first, last} {\n279|\t\tgot, ok := document.SectionID(line)\n280|\t\tif !ok || got != section {\n281|\t\t\tt.Fatalf(\"SPEC.md line %d is in section %q, want %q\", line, got, section)\n282|\t\t}\n283|\t}\n284|\tvar body strings.Builder\n285|\tfor line := first; line <= last; line++ {\n286|\t\ttext, ok := document.Line(line)\n287|\t\tif !ok {\n288|\t\t\tt.Fatalf(\"SPEC.md line %d is missing\", line)\n289|\t\t}\n290|\t\tbody.WriteString(text)\n291|\t\tbody.WriteString(\"\\n\")\n292|\t}\n293|\treturn body.String()\n294|}\n295|\n296|// requireQuote asserts the excerpt occurs verbatim in the pinned\n297|// document and begins on a line inside the cited section.\n298|func requireQuote(t *testing.T, document *specdoc.Document, excerpt, section string) {\n299|\tt.Helper()\n300|\tif !document.Contains(excerpt) {\n301|\t\tt.Fatalf(\"pinned document does not contain %q\", excerpt)\n302|\t}\n303|\tlines := document.QuoteLines(excerpt)\n304|\tif len(lines) == 0 {\n305|\t\tt.Fatalf(\"pinned document quotes no line for %q\", excerpt)\n306|\t}\n307|\tgot, ok := document.SectionID(lines[0])\n308|\tif !ok || got != section {\n309|\t\tt.Fatalf(\"%q begins on SPEC.md line %d in section %q, want %q\", excerpt, lines[0], got, section)\n310|\t}\n311|\tt.Logf(\"%q begins on SPEC.md line %d\", excerpt, lines[0])\n312|}\n313|\n314|var operationCellPattern = regexp.MustCompile(`^\\| <code>([a-z-]+)</code> \\|`)\n315|\n316|// TestOperationRegistryIsDerivedFromSpec proves the dispatch registry is\n317|// exactly the Section 7.5 operation table in order: every table row must\n318|// appear in Operations() at the same position, and nothing else may.\n319|// A dropped, added, or reordered entry reddens here.\n320|func TestOperationRegistryIsDerivedFromSpec(t *testing.T) {\n321|\tdocument, err := specdoc.Load()\n322|\tif err != nil {\n323|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n324|\t}\n325|\twindow := sectionLines(t, document, \"7.5\", 3070, 3086)\n326|\tvar derived []string\n327|\tfor _, line := range strings.Split(window, \"\\n\") {\n328|\t\tif match := operationCellPattern.FindStringSubmatch(line); match != nil {\n329|\t\t\tderived = append(derived, match[1])\n330|\t\t}\n331|\t}\n332|\tif len(derived) == 0 {\n333|\t\tt.Fatal(\"derived no operations from the Section 7.5 table; the check is blind\")\n334|\t}\n335|\tgot := Operations()\n336|\tif fmt.Sprintf(\"%v\", got) != fmt.Sprintf(\"%v\", derived) {\n337|\t\tt.Fatalf(\"Operations() = %v, want the Section 7.5 table %v\", got, derived)\n338|\t}\n339|\tt.Logf(\"operation registry coverage: %d/%d table entries dispatched\", len(got), len(derived))\n340|}\n341|\n342|// TestSection72FramingIsPinned quotes every Section 7.2 sentence this\n343|// package implements: the framing limits, the process model, the\n344|// envelope shapes, the closed-member rule, and the deadline/redaction\n345|// duties.\n346|func TestSection72FramingIsPinned(t *testing.T) {\n347|\tdocument, err := specdoc.Load()\n348|\tif err != nil {\n349|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n350|\t}\n351|\tfor _, excerpt := range []string{\n352|\t\t\"Each line MUST be one complete UTF-8\",\n353|\t\t\"JSON object no larger than 8 MiB\",\n354|\t\t\"Stdout MUST contain protocol frames only\",\n355|\t\t\"human diagnostics go to stderr\",\n356|\t\t\"starts one plugin process per operation\",\n357|\t\t\"After one response, <code>ax</code> closes stdin and the\",\n358|\t\t\"Exit 0 requires a successful response\",\n359|\t\t\"A structured error\",\n360|\t\t\"response SHOULD exit 0 because the protocol succeeded\",\n361|\t\t\"a crash, invalid frame,\",\n362|\t\t\"or missing response is a provider-host failure\",\n363|\t\t\"The deadline MUST be in the future when the host writes the frame\",\n364|\t\t\"A failure envelope contains\",\n365|\t\t\"and MUST NOT contain <code>body</code>\",\n366|\t\t\"Envelope and body\",\n367|\t\t\"unknown members are protocol errors under major version 2\",\n368|\t\t\"The host MUST terminate a plugin that exceeds its deadline and report\",\n369|\t\t\"<code>provider_timeout</code>\",\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
