{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ce13","stream":{"kind":"session","id":"01a0ae11-04bd-7bb0-aac5-3ecca198188f"},"sequence":1380,"recorded_at":1780531400002755,"record_type":"event","durability":"durable","causation_id":"a44b1373-1c97-4578-936f-97327477c22e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a44b1373-1c97-4578-936f-97327477c22e","run_stream":{"kind":"run","id":"a44b1373-1c97-4578-936f-97327477c22e"},"task_stream":{"kind":"task","id":"01a0ae19-3343-7542-8004-c258527938af"},"task_id":"01a0ae19-3343-7542-8004-c258527938af","event":{"kind":"output","task_id":"01a0ae19-3343-7542-8004-c258527938af","chunk":"Read text file `internal/sessprofile/setprofile.go`.\n1|package sessprofile\n2|\n3|import (\n4|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n5|)\n6|\n7|// Transactor appends profile.changed events under the current lease\n8|// through the sessrepo append/attest path. It mints deterministically\n9|// from the request, so a retry after a lost response replays the\n10|// committed event instead of duplicating it.\n11|type Transactor struct {\n12|\t// Repo is the session repository the transaction appends to. It\n13|\t// is required.\n14|\tRepo *sessrepo.Repository\n15|}\n16|\n17|// SetProfileRequest is one ax session set-profile operation: the\n18|// session, the requested profile, the operator confirmation (which\n19|// Section 2.4 requires exactly when changing to yolo), the lease\n20|// the operator acts under, and the author with the creation\n21|// instant. The instant is caller input: a retry repeats it\n22|// byte-identically, which is what makes the retry idempotent.\n23|type SetProfileRequest struct {\n24|\tSessionID       string\n25|\tTo              string\n26|\tConfirmed       bool\n27|\tLeaseEpoch      uint64\n28|\tLeaseID         string\n29|\tCreatedByHostID string\n30|\tCreatedAt       string\n31|}\n32|\n33|// SetProfileResult is the committed (or replayed) change: the\n34|// previous and new profiles with the authoritative event carrying\n35|// the change. PreviousProfile is the effective profile before the\n36|// transaction; NewProfile equals the request target.\n37|type SetProfileResult struct {\n38|\tSessionID       string\n39|\tPreviousProfile string\n40|\tNewProfile      string\n41|\tEventID         string\n42|\tEvent           []byte\n43|\tRef             sessrepo.EventRef\n44|}\n45|\n46|// SetProfile validates one profile change and appends it as a new\n47|// event under the current lease. The from end is the session-head\n48|// effective profile, never the creation value alone: a second\n49|// change starts where the first landed. Refusals, in order: an\n50|// unknown session or a parked one; a target outside the vocabulary;\n51|// an acting lease that is not the chain-head lease (a stale epoch\n52|// or a divergent token — there is no time-expiring lease in the\n53|// pinned Section 5.3, so a superseded lease is the expired lease);\n54|// an unconfirmed change to yolo; and a change from a profile to\n55|// itself. A retry of an already-committed change replays the\n56|// committed event when the newest authoritative change carries the\n57|// request envelope; anything else from-equal-to refuses\n58|// unchanged. Only the append mutates durable state, so the\n59|// landed sessrepo crash semantics apply unchanged: a fault before\n60|// the durable write admits nothing and the identical retry\n61|// appends, while a fault after it counts as committed and the\n62|// identical retry replays.\n63|func (transactor *Transactor) SetProfile(request SetProfileRequest) (SetProfileResult, error) {\n64|\tif transactor == nil || transactor.Repo == nil {\n65|\t\treturn SetProfileResult{}, refuse(ErrDerivation, \"transactor carries no repository\")\n66|\t}\n67|\tif request.To != ProfileStandard && request.To != ProfileYOLO {\n68|\t\treturn SetProfileResult{}, refuse(ErrInvalidProfile, \"set-profile target %q is not standard|yolo\", request.To)\n69|\t}\n70|\trecord, events, err := transactor.load(request.SessionID)\n71|\tif err != nil {\n72|\t\treturn SetProfileResult{}, err\n73|\t}\n74|\tcurrent, err := Derive(record, events)\n75|\tif err != nil {\n76|\t\treturn SetProfileResult{}, err\n77|\t}\n78|\tsequence, predecessors, err := currentLeaseLink(events, record.RecordID, request.LeaseEpoch, request.LeaseID)\n79|\tif err != nil {\n80|\t\treturn SetProfileResult{}, err\n81|\t}\n82|\tif current.Profile == request.To {\n83|\t\treturn transactor.replayOrRefuse(request, record, events, current)\n84|\t}\n85|\tminted, err := MintChangeEvent(ChangeParams{\n86|\t\tSessionID:       request.SessionID,\n87|\t\tCreatedByHostID: request.CreatedByHostID,\n88|\t\tLeaseEpoch:      request.LeaseEpoch,\n89|\t\tLeaseID:         request.LeaseID,\n90|\t\tSequence:        sequence,\n91|\t\tPredecessors:    predecessors,\n92|\t\tFrom:            current.Profile,\n93|\t\tTo:              request.To,\n94|\t\tConfirmed:       request.Confirmed,\n95|\t\tCreatedAt:       request.CreatedAt,\n96|\t})\n97|\tif err != nil {\n98|\t\treturn SetProfileResult{}, err\n99|\t}\n100|\treference, err := transactor.Repo.AppendEvent(request.SessionID, minted)\n101|\tif err != nil {\n102|\t\treturn SetProfileResult{}, err\n103|\t}\n104|\treturn SetProfileResult{\n105|\t\tSessionID:       request.SessionID,\n106|\t\tPreviousProfile: current.Profile,\n107|\t\tNewProfile:      request.To,\n108|\t\tEventID:         reference.EventID,\n109|\t\tEvent:           minted,\n110|\t\tRef:             reference,\n111|\t}, nil\n112|}\n113|\n114|// load locates the session through the listing (distinguishing a\n115|// parked session from an unknown one) and decodes the stored record\n116|// with the authoritative chain in index order.\n117|func (transactor *Transactor) load(sessionID string) (Record, []Event, error) {\n118|\tsummaries, err := transactor.Repo.ListSessions()\n119|\tif err != nil {\n120|\t\treturn Record{}, nil, err\n121|\t}\n122|\tvar found *sessrepo.SessionSummary\n123|\tfor index := range summaries {\n124|\t\tif summaries[index].SessionID == sessionID {\n125|\t\t\tfound = &summaries[index]\n126|\t\t\tbreak\n127|\t\t}\n128|\t}\n129|\tif found == nil {\n130|\t\treturn Record{}, nil, refuse(ErrUnknownSession, \"no session %s\", sessionID)\n131|\t}\n132|\tif found.Parked {\n133|\t\treturn Record{}, nil, refuse(ErrSessionParked, \"session %s: %s (%s)\", sessionID, found.BlockingReason, found.RetryHint)\n134|\t}\n135|\trecordBytes, err := transactor.Repo.GetRecord(sessionID)\n136|\tif err != nil {\n137|\t\treturn Record{}, nil, err\n138|\t}\n139|\trecord, err := DecodeRecord(recordBytes)\n140|\tif err != nil {\n141|\t\treturn Record{}, nil, err\n142|\t}\n143|\tindexed, err := transactor.Repo.ListEvents(sessionID)\n144|\tif err != nil {\n145|\t\treturn Record{}, nil, err\n146|\t}\n147|\tevents := make([]Event, 0, len(indexed))\n148|\tfor _, summary := range indexed {\n149|\t\tblob, err := transactor.Repo.GetEvent(sessionID, summary.EventID)\n150|\t\tif err != nil {\n151|\t\t\treturn Record{}, nil, err\n152|\t\t}\n153|\t\tevent, err := DecodeEvent(blob)\n154|\t\tif err != nil {\n155|\t\t\treturn Record{}, nil, err\n156|\t\t}\n157|\t\tevents = append(events, event)\n158|\t}\n159|\treturn record, events, nil\n160|}\n161|\n162|// currentLeaseLink binds the acting lease to the chain head and\n163|// returns the sequence with the predecessors the new event must\n164|// carry. On an eventless chain the acting lease opens sequence 1\n165|// (the Lease Record binding of that opening lease belongs to the\n166|// ownership-leases story; the caller passes the winning lease).\n167|// On a non-empty chain the acting lease must equal the head\n168|// exactly: set-profile authors under the current lease only, so a\n169|// greater-epoch acting lease refuses alongside the stale and\n170|// divergent ones — lease succession arrives through takeover\n171|// flows, never through a profile event.\n172|func currentLeaseLink(events []Event, recordID string, epoch uint64, leaseID string) (uint64, []string, error) {\n173|\tif len(events) == 0 {\n174|\t\treturn 1, []string{recordID}, nil\n175|\t}\n176|\ttail := events[len(events)-1]\n177|\tacting := LeaseHead{Epoch: epoch, LeaseID: leaseID}\n178|\thead := LeaseHead{Epoch: tail.LeaseEpoch, LeaseID: tail.LeaseID}\n179|\tswitch compareLease(acting, head) {\n180|\tcase 0:\n181|\t\treturn tail.Sequence + 1, []string{tail.ID}, nil\n182|\tcase -1:\n183|\t\tif acting.Epoch < head.Epoch {\n184|\t\t\treturn 0, nil, refuse(ErrStaleLease, \"set-profile acts under epoch %d past chain head epoch %d\", acting.Epoch, head.Epoch)\n185|\t\t}\n186|\t\treturn 0, nil, refuse(ErrDivergentLease, \"set-profile acts under lease %s past chain head lease %s at epoch %d\", acting.LeaseID, head.LeaseID, head.Epoch)\n187|\tdefault:\n188|\t\treturn 0, nil, refuse(ErrDivergentLease, \"set-profile acts under lease (%d, %s) past current lease (%d, %s)\", acting.Epoch, acting.LeaseID, head.Epoch, head.LeaseID)\n189|\t}\n190|}\n191|\n192|// replayOrRefuse handles a request whose target already equals the\n193|// effective profile. When the newest authoritative change carries\n194|// the request envelope — the same from and to under the same\n195|// lease, author, and instant — the change already committed and\n196|// the retry replays it with the committed bytes; anything else is\n197|// a genuine no-op change and refuses unchanged. The chained bytes\n198|// are returned verbatim, so a replayed result equals the original\n199|// commit result.\n200|func (transactor *Transactor) replayOrRefuse(request SetProfileRequest, record Record, events []Event, current Pair) (SetProfileResult, error) {\n201|\tif !current.HasSource {\n202|\t\treturn SetProfileResult{}, refuse(ErrProfileUnchanged, \"session %s already carries effective profile %q\", request.SessionID, request.To)\n203|\t}\n204|\tblob, err := transactor.Repo.GetEvent(request.SessionID, current.Source)\n205|\tif err != nil {\n206|\t\treturn SetProfileResult{}, err\n207|\t}\n208|\tcommitted, err := DecodeEvent(blob)\n209|\tif err != nil {\n210|\t\treturn SetProfileResult{}, err\n211|\t}\n212|\tif !sameEnvelope(committed, request) {\n213|\t\treturn SetProfileResult{}, refuse(ErrProfileUnchanged, \"session %s already carries effective profile %q\", request.SessionID, request.To)\n214|\t}\n215|\t// The position scan always succeeds: Derive named the\n216|\t// source from this same slice, so the committed change is\n217|\t// chained by construction.\n218|\tposition := 0\n219|\tfor index := range events {\n220|\t\tif events[index].ID == committed.ID {\n221|\t\t\tposition = index\n222|\t\t\tbreak\n223|\t\t}\n224|\t}\n225|\treturn SetProfileResult{\n226|\t\tSessionID:       request.SessionID,\n227|\t\tPreviousProfile: current.Profile,\n228|\t\tNewProfile:      request.To,\n229|\t\tEventID:         committed.ID,\n230|\t\tEvent:           append([]byte(nil), blob...),\n231|\t\tRef:             sessrepo.EventRef{SessionID: request.SessionID, EventID: committed.ID, LeaseSequence: committed.Sequence, Position: position},\n232|\t}, nil\n233|}\n234|\n235|// sameEnvelope reports whether the committed change is the request\n236|// already applied: the same target under the same lease, author,\n237|// and instant. The from end is deliberately not compared: from is\n238|// derived, not requested, and the committed from necessarily\n239|// differs from the current profile (a change never targets its\n240|// own source). Confirmation is likewise not part of the envelope:\n241|// a replay commits nothing new, and the original commit already\n242|// carried the confirmation its mint required.\n243|func sameEnvelope(committed Event, request SetProfileRequest) bool {\n244|\tif committed.Type != \"profile.changed\" {\n245|\t\treturn false\n246|\t}\n247|\tpayloadTo, ok := payloadString(committed.Payload, \"to\")\n248|\tif !ok || payloadTo != request.To {\n249|\t\treturn false\n250|\t}\n251|\tif committed.LeaseEpoch != request.LeaseEpoch || committed.LeaseID != request.LeaseID {\n252|\t\treturn false\n253|\t}\n254|\tif committed.CreatedByHostID != request.CreatedByHostID || committed.CreatedAt != request.CreatedAt {\n255|\t\treturn false\n256|\t}\n257|\treturn true\n258|}","final_result":true}}}
