{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c951","stream":{"kind":"session","id":"01a0ae11-04bd-7bb0-aac5-3ecca198188f"},"sequence":771,"recorded_at":1780531400001537,"record_type":"event","durability":"durable","causation_id":"a44b1373-1c97-4578-936f-97327477c22e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a44b1373-1c97-4578-936f-97327477c22e","run_stream":{"kind":"run","id":"a44b1373-1c97-4578-936f-97327477c22e"},"task_stream":{"kind":"task","id":"01a0ae16-16aa-7133-8315-e88f4126a36c"},"task_id":"01a0ae16-16aa-7133-8315-e88f4126a36c","event":{"kind":"output","task_id":"01a0ae16-16aa-7133-8315-e88f4126a36c","chunk":"{\n  \"chunk_id\": \"exec-24-1\",\n  \"command\": \"sed -n 95,150p internal/sessprofile/mint_test.go; echo \\\"===DERIVE ambiguity test===\\\"; grep -n \\\"repeated_sequence\\\\|repeated\\\\|message\\\\|ErrorIs\\\\|errors.Is\\\" internal/sessprofile/profile_test.go | head -n 30\",\n  \"description\": \"Read mint refusal cases and derive assertions\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"\\t}\\n}\\n\\nfunc TestMintChangeEventRefusals(t *testing.T) {\\n\\tcases := []struct {\\n\\t\\tname     string\\n\\t\\tmutate   func(*ChangeParams)\\n\\t\\tsentinel error\\n\\t\\tfault    string\\n\\t}{\\n\\t\\t{\\\"bad session\\\", func(params *ChangeParams) { params.SessionID = \\\"nope\\\" }, ErrInvalidEvent, \\\"session_id\\\"},\\n\\t\\t{\\\"bad author\\\", func(params *ChangeParams) { params.CreatedByHostID = \\\"nope\\\" }, ErrInvalidEvent, \\\"created_by_host_id\\\"},\\n\\t\\t{\\\"zero epoch\\\", func(params *ChangeParams) { params.LeaseEpoch = 0 }, ErrInvalidEvent, \\\"lease_epoch\\\"},\\n\\t\\t{\\\"epoch past uint53\\\", func(params *ChangeParams) { params.LeaseEpoch = uint53Max + 1 }, ErrInvalidEvent, \\\"lease_epoch\\\"},\\n\\t\\t{\\\"bad lease\\\", func(params *ChangeParams) { params.LeaseID = \\\"nope\\\" }, ErrInvalidEvent, \\\"lease_id\\\"},\\n\\t\\t{\\\"zero sequence\\\", func(params *ChangeParams) { params.Sequence = 0 }, ErrInvalidEvent, \\\"lease_sequence\\\"},\\n\\t\\t{\\\"sequence past uint53\\\", func(params *ChangeParams) { params.Sequence = uint53Max + 1 }, ErrInvalidEvent, \\\"lease_sequence\\\"},\\n\\t\\t{\\\"no predecessor\\\", func(params *ChangeParams) { params.Predecessors = nil }, ErrInvalidEvent, \\\"predecessor\\\"},\\n\\t\\t{\\\"malformed predecessor\\\", func(params *ChangeParams) { params.Predecessors = []string{\\\"nope\\\"} }, ErrInvalidEvent, \\\"predecessor\\\"},\\n\\t\\t{\\\"from outside vocabulary\\\", func(params *ChangeParams) { params.From = \\\"turbo\\\" }, ErrInvalidProfile, \\\"change from\\\"},\\n\\t\\t{\\\"to outside vocabulary\\\", func(params *ChangeParams) { params.To = \\\"turbo\\\" }, ErrInvalidProfile, \\\"change to\\\"},\\n\\t\\t{\\\"from equals to\\\", func(params *ChangeParams) { params.From = ProfileYOLO }, ErrProfileUnchanged, \\\"differ\\\"},\\n\\t\\t{\\\"unconfirmed yolo\\\", func(params *ChangeParams) { params.Confirmed = false }, ErrUnconfirmedYOLO, \\\"confirmation\\\"},\\n\\t\\t{\\\"bad instant\\\", func(params *ChangeParams) { params.CreatedAt = \\\"yesterday\\\" }, ErrInvalidEvent, \\\"created_at\\\"},\\n\\t}\\n\\tfor _, tc := range cases {\\n\\t\\tt.Run(tc.name, func(t *testing.T) {\\n\\t\\t\\tparams := validChangeParams()\\n\\t\\t\\ttc.mutate(&params)\\n\\t\\t\\t_, err := MintChangeEvent(params)\\n\\t\\t\\tif !errors.Is(err, tc.sentinel) {\\n\\t\\t\\t\\tt.Fatalf(\\\"MintChangeEvent(%s) error = %v, want %v\\\", tc.name, err, tc.sentinel)\\n\\t\\t\\t}\\n\\t\\t\\tif !strings.Contains(err.Error(), tc.fault) {\\n\\t\\t\\t\\tt.Fatalf(\\\"MintChangeEvent(%s) error = %v, want %q named\\\", tc.name, err, tc.fault)\\n\\t\\t\\t}\\n\\t\\t})\\n\\t}\\n}\\n\\nfunc TestMintChangeEventAdmitsUnconfirmedStandard(t *testing.T) {\\n\\tparams := validChangeParams()\\n\\tparams.From = ProfileYOLO\\n\\tparams.To = ProfileStandard\\n\\tparams.Confirmed = false\\n\\tminted, err := MintChangeEvent(params)\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"MintChangeEvent(unconfirmed standard) error = %v\\\", err)\\n\\t}\\n\\tif _, _, err := canonicaljson.VerifyObjectIdentity(minted); err != nil {\\n\\t\\tt.Fatalf(\\\"VerifyObjectIdentity(minted) error = %v\\\", err)\\n\\t}\\n}\\n===DERIVE ambiguity test===\\n158:\\t// (a repeated sequence) must not disturb the closure\\n167:\\tif _, err := Derive(record, corrupt); !errors.Is(err, ErrInvalidTransition) {\\n189:\\t\\t{\\\"repeated sequence\\\", func(event *Event) { event.Sequence = 1 }, ErrInvalidTransition},\\n202:\\t\\t\\tif _, err := Derive(record, input); !errors.Is(err, tc.sentinel) {\\n230:\\t\\t\\tif _, err := Derive(record, []Event{candidate}); !errors.Is(err, tc.sentinel) {\\n260:\\t\\t\\tif _, err := Derive(record, input); !errors.Is(err, ErrIntegrity) {\\n268:\\tif _, err := Derive(Record{}, nil); !errors.Is(err, ErrInvalidRecord) {\\n272:\\tif _, err := Derive(record, nil); !errors.Is(err, ErrInvalidRecord) {\\n283:\\tif _, err := DeriveForHeads(record, events, nil); !errors.Is(err, ErrDerivation) {\\n287:\\tif _, err := DeriveForHeads(record, events, []string{unknown}); !errors.Is(err, ErrIntegrity) {\\n294:\\tif _, err := DeriveForHeads(record, dangling, []string{change}); !errors.Is(err, ErrIntegrity) {\\n297:\\tif _, err := DeriveForHeads(Record{}, events, []string{change}); !errors.Is(err, ErrInvalidRecord) {\\n323:\\tif _, err := projector.Project(testSessionIDB); !errors.Is(err, ErrUnknownSession) {\\n327:\\tif _, err := bare.Project(testSessionID); !errors.Is(err, ErrDerivation) {\\n331:\\tif _, err := nilProjector.Project(testSessionID); !errors.Is(err, ErrDerivation) {\\n334:\\tif _, err := bare.ProjectForHeads(testSessionID, []string{first}); !errors.Is(err, ErrDerivation) {\\n360:\\t\\t\\tif !errors.Is(err, ErrInvalidRecord) {\\n414:\\t\\t\\tif !errors.Is(err, ErrInvalidEvent) {\\n\",\n  \"original_output_bytes\": 4159,\n  \"original_output_tokens\": 1040,\n  \