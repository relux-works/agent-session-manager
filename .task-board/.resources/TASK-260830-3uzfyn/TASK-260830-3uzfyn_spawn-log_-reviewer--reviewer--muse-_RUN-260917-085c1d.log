{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cdaf","stream":{"kind":"session","id":"01a0ae11-04bd-7bb0-aac5-3ecca198188f"},"sequence":1330,"recorded_at":1780531400002655,"record_type":"event","durability":"durable","causation_id":"a44b1373-1c97-4578-936f-97327477c22e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a44b1373-1c97-4578-936f-97327477c22e","run_stream":{"kind":"run","id":"a44b1373-1c97-4578-936f-97327477c22e"},"task_stream":{"kind":"task","id":"01a0ae19-065e-7993-baff-d7d2cd122877"},"task_id":"01a0ae19-065e-7993-baff-d7d2cd122877","event":{"kind":"output","task_id":"01a0ae19-065e-7993-baff-d7d2cd122877","chunk":"Read text file `internal/sessprofile/crash_test.go`.\n1|package sessprofile\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"errors\"\n6|\t\"testing\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/secconftest\"\n9|)\n10|\n11|// The set-profile transaction mutates only through the append\n12|// path, so the repository's BeforeWrite/AfterCommit boundaries are\n13|// its crash windows unchanged. Both tests below wire those hooks\n14|// to the owner's injector directly.\n15|\n16|func TestSetProfileCrashBeforeDurableWriteAdmitsNothing(t *testing.T) {\n17|\trepository := openTestRepository(t)\n18|\tcreateTestSession(t, repository, testSessionID, \"payments-api\", ProfileStandard)\n19|\tinjector := &secconftest.Injector{}\n20|\trepository.BeforeWrite = func() error {\n21|\t\treturn injector.MaybeFail(secconftest.PointPrepareEnter)\n22|\t}\n23|\trepository.AfterCommit = func() error {\n24|\t\treturn injector.MaybeFail(secconftest.PointCommitApply)\n25|\t}\n26|\tinjector.Arm(secconftest.PointPrepareEnter)\n27|\ttransactor := &Transactor{Repo: repository}\n28|\t_, err := transactor.SetProfile(validSetProfileRequest())\n29|\tvar fault *secconftest.Fault\n30|\tif !errors.As(err, &fault) {\n31|\t\tt.Fatalf(\"SetProfile(prepare fault) error = %v, want *secconftest.Fault\", err)\n32|\t}\n33|\tif fault.Point() != secconftest.PointPrepareEnter || fault.Outcome() != secconftest.OutcomeSafeRetry {\n34|\t\tt.Fatalf(\"fault = %s/%s, want prepare/safe_retry\", fault.Point(), fault.Outcome())\n35|\t}\n36|\t// No partial event is admitted: the chain is still empty.\n37|\tindexed, err := repository.ListEvents(testSessionID)\n38|\tif err != nil {\n39|\t\tt.Fatalf(\"ListEvents error = %v\", err)\n40|\t}\n41|\tif len(indexed) != 0 {\n42|\t\tt.Fatalf(\"chain after prepare fault = %d events, want 0\", len(indexed))\n43|\t}\n44|\t// The identical retry appends exactly one event.\n45|\tresult, err := transactor.SetProfile(validSetProfileRequest())\n46|\tif err != nil {\n47|\t\tt.Fatalf(\"retry SetProfile error = %v\", err)\n48|\t}\n49|\tif result.PreviousProfile != ProfileStandard || result.NewProfile != ProfileYOLO {\n50|\t\tt.Fatalf(\"retry result = %+v\", result)\n51|\t}\n52|\tindexed, err = repository.ListEvents(testSessionID)\n53|\tif err != nil {\n54|\t\tt.Fatalf(\"ListEvents error = %v\", err)\n55|\t}\n56|\tif len(indexed) != 1 || indexed[0].EventID != result.EventID {\n57|\t\tt.Fatalf(\"chain after retry = %+v, want exactly the committed change\", indexed)\n58|\t}\n59|}\n60|\n61|func TestSetProfileCrashAfterDurableWriteReplaysOnRetry(t *testing.T) {\n62|\trepository := openTestRepository(t)\n63|\tcreateTestSession(t, repository, testSessionID, \"payments-api\", ProfileStandard)\n64|\tinjector := &secconftest.Injector{}\n65|\trepository.BeforeWrite = func() error {\n66|\t\treturn injector.MaybeFail(secconftest.PointPrepareEnter)\n67|\t}\n68|\trepository.AfterCommit = func() error {\n69|\t\treturn injector.MaybeFail(secconftest.PointCommitApply)\n70|\t}\n71|\tinjector.Arm(secconftest.PointCommitApply)\n72|\ttransactor := &Transactor{Repo: repository}\n73|\t_, err := transactor.SetProfile(validSetProfileRequest())\n74|\tvar fault *secconftest.Fault\n75|\tif !errors.As(err, &fault) {\n76|\t\tt.Fatalf(\"SetProfile(commit fault) error = %v, want *secconftest.Fault\", err)\n77|\t}\n78|\tif fault.Point() != secconftest.PointCommitApply || fault.Outcome() != secconftest.OutcomeRecoverableParked {\n79|\t\tt.Fatalf(\"fault = %s/%s, want commit/recoverable_parked_state\", fault.Point(), fault.Outcome())\n80|\t}\n81|\t// The crashed commit already performed the durable write: the\n82|\t// change reads back and the operation is terminal.\n83|\tindexed, err := repository.ListEvents(testSessionID)\n84|\tif err != nil {\n85|\t\tt.Fatalf(\"ListEvents error = %v\", err)\n86|\t}\n87|\tif len(indexed) != 1 {\n88|\t\tt.Fatalf(\"chain after crashed commit = %d events, want 1\", len(indexed))\n89|\t}\n90|\tstored, err := repository.GetEvent(testSessionID, indexed[0].EventID)\n91|\tif err != nil {\n92|\t\tt.Fatalf(\"GetEvent error = %v\", err)\n93|\t}\n94|\t// The identical retry replays the committed bytes instead of\n95|\t// duplicating the change or refusing it as unchanged.\n96|\treplayed, err := transactor.SetProfile(validSetProfileRequest())\n97|\tif err != nil {\n98|\t\tt.Fatalf(\"retry SetProfile error = %v\", err)\n99|\t}\n100|\tif replayed.EventID != indexed[0].EventID || !bytes.Equal(replayed.Event, stored) {\n101|\t\tt.Fatal(\"retry did not replay the committed change\")\n102|\t}\n103|\tindexed, err = repository.ListEvents(testSessionID)\n104|\tif err != nil {\n105|\t\tt.Fatalf(\"ListEvents error = %v\", err)\n106|\t}\n107|\tif len(indexed) != 1 {\n108|\t\tt.Fatalf(\"chain after replay = %d events, want 1\", len(indexed))\n109|\t}\n110|}","final_result":true}}}
