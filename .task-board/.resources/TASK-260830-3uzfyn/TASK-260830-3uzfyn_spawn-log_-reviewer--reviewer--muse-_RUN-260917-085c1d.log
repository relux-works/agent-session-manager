{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c67b","stream":{"kind":"session","id":"01a0ae11-04bd-7bb0-aac5-3ecca198188f"},"sequence":408,"recorded_at":1780531400000811,"record_type":"event","durability":"durable","causation_id":"a44b1373-1c97-4578-936f-97327477c22e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a44b1373-1c97-4578-936f-97327477c22e","run_stream":{"kind":"run","id":"a44b1373-1c97-4578-936f-97327477c22e"},"call_id":"call_01a0ae11f37c711f856d017b9ba5e2d9","text":"Read text file `internal/sessprofile/profile.go`.\n1|package sessprofile\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|)\n7|\n8|// Execution profiles Section 2.4 defines. The vocabulary is exactly\n9|// these two spellings; no registry, alias, or third value exists.\n10|const (\n11|\tProfileStandard = \"standard\"\n12|\tProfileYOLO     = \"yolo\"\n13|)\n14|\n15|var (\n16|\t// ErrInvalidRecord reports a Session Record projection without\n17|\t// session identity or without a valid creation profile.\n18|\tErrInvalidRecord = errors.New(\"invalid session record\")\n19|\t// ErrInvalidEvent reports a Session Event projection without the\n20|\t// routing members the derivation must read.\n21|\tErrInvalidEvent = errors.New(\"invalid session event\")\n22|\t// ErrInvalidTransition reports chain input the repository could\n23|\t// not have authored: a broken predecessor link, a repeated or\n24|\t// skipped sequence, or an ambiguous branch. The message is the\n25|\t// Section 5.2 code.\n26|\tErrInvalidTransition = errors.New(\"invalid_state_transition\")\n27|\t// ErrStaleLease reports an input event under an epoch below the\n28|\t// chain head, or a set-profile request acting under one.\n29|\tErrStaleLease = errors.New(\"event lease epoch precedes the chain head\")\n30|\t// ErrDivergentLease reports an input event under a second lease\n31|\t// at the chain-head epoch, or a set-profile request acting\n32|\t// under a lease that is not the chain head.\n33|\tErrDivergentLease = errors.New(\"divergent lease branch cannot be authoritative\")\n34|\t// ErrIntegrity reports a pair or closure the admitted history\n35|\t// contradicts. The message is the Section 2.4/5.2 code.\n36|\tErrIntegrity = errors.New(\"integrity_failure\")\n37|\t// ErrInvalidProfile reports a profile spelling outside the\n38|\t// standard|yolo vocabulary.\n39|\tErrInvalidProfile = errors.New(\"invalid execution profile\")\n40|\t// ErrUnconfirmedYOLO reports a profile change to yolo without\n41|\t// operator confirmation.\n42|\tErrUnconfirmedYOLO = errors.New(\"profile change to yolo requires operator confirmation\")\n43|\t// ErrProfileUnchanged reports a profile change whose from and to\n44|\t// are equal.\n45|\tErrProfileUnchanged = errors.New(\"profile.changed from and to must differ\")\n46|\t// ErrDerivation reports corrupt derivation input: a missing\n47|\t// repository, an empty closure, or an unknown activation.\n48|\tErrDerivation = errors.New(\"derivation input is corrupt\")\n49|\t// ErrUnknownSession reports a session ID with no listing entry.\n50|\t// A parked session is not unknown; see ErrSessionParked.\n51|\tErrUnknownSession = errors.New(\"unknown session\")\n52|\t// ErrSessionParked reports a session whose bytes no longer\n53|\t// verify. The message carries the blocking reason and retry;\n54|\t// the profile of a parked session cannot be derived.\n55|\tErrSessionParked = errors.New(\"session is parked\")\n56|)\n57|\n58|// refuse is the single refusal funnel every sessprofile rejection\n59|// flows through. It is a var so a census can wrap it and record the\n60|// production file:line behind each exercised refusal. No production\n61|// path wraps a sentinel with fmt.Errorf directly.\n62|var refuse = func(sentinel error, format string, arguments ...any) error {\n63|\treturn fmt.Errorf(\"%w: %s\", sentinel, fmt.Sprintf(format, arguments...))\n64|}\n65|\n66|// Pair is one Section 2.4 effective profile with its nullable\n67|// source: the profile spelling plus the digest of the newest\n68|// authoritative profile.changed event it was derived from, or no\n69|// source when the Session Record is still the authority. The zero\n70|// value is the dormant null pair (no profile, no source) used only\n71|// by dormant materialization finalization.\n72|type Pair struct {\n73|\tProfile   string\n74|\tSource    string\n75|\tHasSource bool\n76|}\n77|\n78|// Equal reports whole-pair equality: the profile spelling and the\n79|// source presence with its digest must all match. A dormant null\n80|// pair equals only another dormant null pair.\n81|func (pair Pair) Equal(other Pair) bool {\n82|\treturn pair.Profile == other.Profile && pair.HasSource == other.HasSource && pair.Source == other.Source\n83|}\n84|\n85|// Record is the decoded Session Record surface the reducer reads:\n86|// session identity plus the immutable creation profile.\n87|type Record struct {\n88|\tSessionID string\n89|\tRecordID  string\n90|\tCreation  string\n91|}\n92|\n93|// Event is one decoded authoritative Session Event: the routing\n94|// members plus the closed payload object admitted by the canonical\n95|// owner at decode time. The author and instant identify a committed\n96|// change for set-profile replay.\n97|type Event struct {\n98|\tID              string\n99|\tType            string\n100|\tSchemaVersion   string\n101|\tSessionID       string\n102|\tCreatedByHostID string\n103|\tCreatedAt       string\n104|\tLeaseEpoch      uint64\n105|\tLeaseID         string\n106|\tSequence        uint64\n107|\tPredecessors    []string\n108|\tPayload         map[string]any\n109|}\n110|\n111|// LeaseHead is one observed fencing token: the winning-lease pair\n112|// carried by every owner-authored event and mutation.\n113|type LeaseHead struct {\n114|\tEpoch   uint64\n115|\tLeaseID string\n116|}\n117|\n118|// Derive folds one record with its authoritative events in chain\n119|// order into the session-head effective pair: the creation profile\n120|// while no authoritative profile.changed event exists, otherwise\n121|// the newest change's target with that event's digest as source.\n122|// An empty chain derives the creation pair. It is pure: no I/O, no\n123|// clock, no cache. Chain continuity is re-checked over the input,\n124|// so a chain-forbidden reordering refuses with\n125|// invalid_state_transition instead of silently deriving a different\n126|// pair, and a losing-lease or ambiguous event refuses instead of\n127|// changing the derivation.\n128|func Derive(record Record, events []Event) (Pair, error) {\n129|\tif err := checkRecord(record); err != nil {\n130|\t\treturn Pair{}, err\n131|\t}\n132|\tif len(events) == 0 {\n133|\t\treturn Pair{Profile: record.Creation}, nil\n134|\t}\n135|\tordered, err := checkChain(record, events, len(events))\n136|\tif err != nil {\n137|\t\treturn Pair{}, err\n138|\t}\n139|\treturn foldChanges(record.Creation, ordered, nil)\n140|}\n141|\n142|// DeriveForHeads derives the effective pair over the transitive\n143|// predecessor closure of heads: the Section 5.4 event-head closure\n144|// of one checkpoint. Only closure events are consulted — a later\n145|// local-only change outside the heads never affects the pair, and\n146|// the derivation never falls back to the creation value while the\n147|// closure holds a change. Events past the closure are not even\n148|// validated. An unknown head or a dangling predecessor contradicts\n149|// the admitted closure (integrity_failure); empty heads carry no\n150|// closure to derive over.\n151|func DeriveForHeads(record Record, events []Event, heads []string) (Pair, error) {\n152|\tif err := checkRecord(record); err != nil {\n153|\t\treturn Pair{}, err\n154|\t}\n155|\tif len(heads) == 0 {\n156|\t\treturn Pair{}, refuse(ErrDerivation, \"checkpoint closure names no event head\")\n157|\t}\n158|\tclosure, limit, err := closurePrefix(record.RecordID, events, heads)\n159|\tif err != nil {\n160|\t\treturn Pair{}, err\n161|\t}\n162|\tordered, err := checkChain(record, events, limit)\n163|\tif err != nil {\n164|\t\treturn Pair{}, err\n165|\t}\n166|\treturn foldChanges(record.Creation, ordered, closure)\n167|}\n168|\n169|// checkRecord validates the record surface the derivation reads:\n170|// session identity plus a creation profile inside the vocabulary.\n171|func checkRecord(record Record) error {\n172|\tif record.SessionID == \"\" || record.RecordID == \"\" {\n173|\t\treturn refuse(ErrInvalidRecord, \"reducer input carries no session identity\")\n174|\t}\n175|\tif record.Creation != ProfileStandard && record.Creation != ProfileYOLO {\n176|\t\treturn refuse(ErrInvalidRecord, \"session record carries creation profile %q, want standard|yolo\", record.Creation)\n177|\t}\n178|\treturn nil\n179|}\n180|\n181|// closurePrefix resolves the transitive predecessor closure of\n182|// heads against the chain index in input order. The Session Record\n183|// digest is the genesis terminal; every other predecessor must\n184|// name a chained event. It returns the closure set plus the\n185|// one-past-the-end validation limit: the highest closure position\n186|// plus one, so events past the closure are never consulted.\n187|func closurePrefix(recordID string, events []Event, heads []string) (map[string]bool, int, error) {\n188|\tbyID := make(map[string]Event, len(events))\n189|\tposition := make(map[string]int, len(events))\n190|\tfor index := range events {\n191|\t\tbyID[events[index].ID] = events[index]\n192|\t\tposition[events[index].ID] = index\n193|\t}\n194|\tfor _, head := range heads {\n195|\t\tif _, ok := byID[head]; !ok {\n196|\t\t\treturn nil, 0, refuse(ErrIntegrity, \"checkpoint closure names unknown event head %s\", head)\n197|\t\t}\n198|\t}\n199|\tclosure := make(map[string]bool, len(events))\n200|\tstack := append([]string(nil), heads...)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c67d","stream":{"kind":"session","id":"01a0ae11-04bd-7bb0-aac5-3ecca198188f"},"sequence":409,"recorded_at":1780531400000813,"record_type":"event","durability":"durable","causation_id":"a44b1373-1c97-4578-936f-97327477c22e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a44b1373-1c97-4578-936f-97327477c22e","run_stream":{"kind":"run","id":"a44b1373-1c97-4578-936f-97327477c22e"},"call_id":"call_01a0ae11f3f372fdacd60f33086cc218","text":"Read text file `internal/provhost/profile_resolve.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n5|)\n6|\n7|// This file resolves Section 7.7 execution-profile mappings against the\n8|// exact probed provider build and projects the sanitized launch argv a\n9|// launch or resume operation executes. The table in profile.go is the\n10|// single source of the required yolo flags; this file decides when\n11|// those flags may be applied.\n12|//\n13|// Resolution requires the exact-version probe result as a BuildTuple:\n14|// the tuple passes the Section 8.4 resume gate (CheckResumeTuple, so\n15|// an unknown provider, platform, or architecture, a direct Qwen\n16|// claim, and an unverified Muse build refuse before any mapping is\n17|// considered) and names the resolved provider exactly, because a\n18|// mapping decided for one build must never silently apply to\n19|// another. A provider without a Section 7.7 row — Qwen direct,\n20|// future plugins — and a Pi build other than the table's pinned\n21|// 0.73.1 cannot be mapped for the probed version and refuse with\n22|// the Section 2.4 profile_mapping_unavailable resume failure.\n23|//\n24|// The launch projection emits the unrestricted flag only for yolo\n25|// and only the exact table token: an absent flag (nothing to emit\n26|// where yolo requires one is impossible by construction, so absence\n27|// is the caller's empty base, refused structurally) or a changed\n28|// flag (any table token already present in the base, or any\n29|// foreign table token) fails closed. Standard omits every\n30|// unrestricted flag and refuses a base that already carries one —\n31|// the decidable half of the machine-local-alias rule: an exact\n32|// token match over the six table flags plus the documented codex\n33|// --yolo alias. A locally aliased shell word that expands to\n34|// unrestricted mode without spelling a table token is beyond what\n35|// argv inspection can decide (shell aliases never expand under\n36|// execve argv, which is the structural defense, owned by secprim);\n37|// that residual is stated, not silently admitted.\n38|//\n39|// The Section 5.1 argv bounds enforced here (1..128 elements, each\n40|// 1..4,096 bytes, 65,536 bytes total) are the host-side twin of\n41|// the SpawnPlan wire bounds checkSpawnArgv enforces: the two never\n42|// diverge, pinned by the agreement test that drives identical\n43|// vectors at each limit through both entries. Structural argv\n44|// validity (non-empty, NUL-free, UTF-8) stays with secprim and is\n45|// driven, not duplicated.\n46|\n47|// codexAliasYOLO is the codex --yolo alias Section 7.7 documents as\n48|// accepted by the current CLI. The required adapter mapping stays\n49|// the long form in profileYOLOMapping; the alias exists here only\n50|// so the launch projection recognizes (and refuses) it as an\n51|// unrestricted token rather than passing it through as an\n52|// innocuous word.\n53|const codexAliasYOLO = \"--yolo\"\n54|\n55|// piPinnedVersion is the exact Pi build the Section 7.7 table maps.\n56|// Every other Pi version refuses profile_mapping_unavailable:\n57|// the table pins 0.73.1, and no other row covers Pi.\n58|const piPinnedVersion = \"0.73.1\"\n59|\n60|// ResolvedMapping is one Section 7.7 mapping decision for an exact\n61|// probed build: the provider and profile it was resolved for, the\n62|// probed version it is bound to, the SpawnPlan profile_mapping\n63|// value (the exact table flag for yolo, empty for standard, which\n64|// omits every unrestricted flag), and whether both profiles share\n65|// the provider's default full tool set (Pi only — probe and launch\n66|// output MUST disclose that equivalence).\n67|type ResolvedMapping struct {\n68|\tProviderID string\n69|\tProfile    string\n70|\tVersion    string\n71|\tMapping    string\n72|\tEquivalent bool\n73|}\n74|\n75|// ResolveMapping resolves the Section 7.7 adapter mapping for one\n76|// provider under one profile against the exact probed build tuple.\n77|// The tuple passes the Section 8.4 resume gate and must name the\n78|// resolved provider; the profile must be inside the vocabulary; the\n79|// provider must carry a Section 7.7 row and Pi must be the pinned\n80|// 0.73.1 build. Unmappable combinations refuse with the Section\n81|// 2.4 profile_mapping_unavailable failure naming the provider,\n82|// probed version, and profile; miscorrelated inputs refuse as\n83|// caller errors.\n84|func ResolveMapping(providerID, profile string, tuple BuildTuple) (ResolvedMapping, error) {\n85|\tempty := ResolvedMapping{}\n86|\t// The caller's provider argument is classified before the\n87|\t// tuple gate runs: garbage fails as a caller error, while a\n88|\t// well-formed provider without a Section 7.7 row (Qwen\n89|\t// direct, future plugins) is the mapping gap Section 2.4\n90|\t// names. Running the tuple gate first would misclassify\n91|\t// both as tuple refusals.\n92|\tif !validProviderID(providerID) {\n93|\t\tfailure, err := failInvalid(\"mapping provider is not a provider id\")\n94|\t\tif err != nil {\n95|\t\t\treturn empty, err\n96|\t\t}\n97|\t\treturn empty, failure\n98|\t}\n99|\tif _, ok := profileYOLOMapping[providerID]; !ok {\n100|\t\tfailure, err := failMappingUnavailable(\"mapping has no row for this provider\", providerID, tuple.ProviderVersion, profile)\n101|\t\tif err != nil {\n102|\t\t\treturn empty, err\n103|\t\t}\n104|\t\treturn empty, failure\n105|\t}\n106|\tif err := CheckResumeTuple(tuple); err != nil {\n107|\t\treturn empty, err\n108|\t}\n109|\tif tuple.ProviderID != providerID {\n110|\t\tfailure, err := failInvalid(\"mapping tuple names another provider\")\n111|\t\tif err != nil {\n112|\t\t\treturn empty, err\n113|\t\t}\n114|\t\treturn empty, failure\n115|\t}\n116|\tif !profileNames[profile] {\n117|\t\tfailure, err := failInvalid(\"mapping profile is not standard or yolo\")\n118|\t\tif err != nil {\n119|\t\t\treturn empty, err\n120|\t\t}\n121|\t\treturn empty, failure\n122|\t}\n123|\tif providerID == \"pi\" && tuple.ProviderVersion != piPinnedVersion {\n124|\t\tfailure, err := failMappingUnavailable(\"mapping pins pi to probed 0.73.1\", providerID, tuple.ProviderVersion, profile)\n125|\t\tif err != nil {\n126|\t\t\treturn empty, err\n127|\t\t}\n128|\t\treturn empty, failure\n129|\t}\n130|\t// The flag value comes from the single table source. Both\n131|\t// refusals below it are unreachable on this path — the row and\n132|\t// the profile were just established — but the value must not be\n133|\t// retyped here.\n134|\tmapping, err := ProfileMapping(providerID, profile)\n135|\tif err != nil {\n136|\t\treturn empty, err\n137|\t}\n138|\treturn ResolvedMapping{\n139|\t\tProviderID: providerID,\n140|\t\tProfile:    profile,\n141|\t\tVersion:    tuple.ProviderVersion,\n142|\t\tMapping:    mapping,\n143|\t\tEquivalent: providerID == \"pi\",\n144|\t}, nil\n145|}\n146|\n147|// ProjectLaunchArgv projects the sanitized launch argv for one\n148|// resolved mapping over the caller base (the provider binary with\n149|// its subcommand). The resolution must name this provider and\n150|// profile, and the base must be structurally valid. Yolo appends\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
