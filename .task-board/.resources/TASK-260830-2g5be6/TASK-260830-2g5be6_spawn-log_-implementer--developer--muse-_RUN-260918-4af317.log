{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c549","stream":{"kind":"session","id":"01a0b326-34a5-74f1-8680-2e2c2ca4449b"},"sequence":255,"recorded_at":1780531400000505,"record_type":"event","durability":"durable","causation_id":"37553fb7-ae2e-4004-ba6a-caef8cb79aa4","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"37553fb7-ae2e-4004-ba6a-caef8cb79aa4","run_stream":{"kind":"run","id":"37553fb7-ae2e-4004-ba6a-caef8cb79aa4"},"task_stream":{"kind":"task","id":"01a0b327-a4ac-7300-9325-834f7eca3972"},"task_id":"01a0b327-a4ac-7300-9325-834f7eca3972","event":{"kind":"output","task_id":"01a0b327-a4ac-7300-9325-834f7eca3972","chunk":"{\n  \"chunk_id\": \"exec-10-1\",\n  \"command\": \"/Users/iv/.curator/global/bin/task-board resource --help 2>&1 | head -n 40; echo \\\"===\\\"; /Users/iv/.curator/global/bin/task-board m --help 2>&1 | head -n 60\",\n  \"description\": \"Show resource and mutation help\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Manage attached resources such as screenshots, docs, logs, and other files.\\n\\nUse \\\"task-board resource add\\\" to create a new attached resource, \\\"task-board\\nresource adopt\\\" to register an orphaned local payload, \\\"task-board resource\\nupdate\\\" to replace an existing one, \\\"task-board resource delete\\\" to remove it,\\nand \\\"task-board resource get\\\" to materialize a resource back to the local\\nfilesystem for inspection.\\n\\nUsage:\\n  task-board resource [command]\\n\\nAvailable Commands:\\n  add         Attach a new file resource to an element\\n  adopt       Register an existing unreferenced local resource payload\\n  delete      Delete a resource from an element (requires --confirm)\\n  get         Download a resource to the local filesystem\\n  update      Replace an existing file resource on an element\\n\\nFlags:\\n  -h, --help   help for resource\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\\nUse \\\"task-board resource [command] --help\\\" for more information about a command.\\n===\\nExecute a write operation against the board using the DSL.\\n\\nMutations:\\n  set_status(ID, status=..., commit_ack=scope_committed?)\\n                                        Change status; acknowledge enforced done transitions\\n  normalize_legacy_status(ID, expected_raw=..., status=...)\\n                                        Repair one exact unparseable raw status (local boards)\\n  handoff(ID, role=..., status=...)     Verify checklist/outcome evidence and change status\\n  set_estimate(ID, estimate=..., ...)  Set Task/Bug story-point estimate\\n  create(type=..., name=..., ...)      Create element\\n  set_details(ID, title=..., ...)      Update README fields\\n  rename(ID, name=...)                 Rename element name/slug\\n  delete(ID)                           Delete element (destructive)\\n  assign(ID, agent=...)                Assign agent\\n  unassign(ID)                         Remove assignment\\n  link(ID, blocked_by=...)             Add dependency\\n  unlink(ID, blocked_by=...)           Remove dependency\\n  check_item(ID, item=N)              Check checklist item\\n  uncheck_item(ID, item=N)            Uncheck checklist item\\n  add_checklist_item(ID, text=...)     Add checklist item\\n  remove_checklist_item(ID, item=N)    Remove obsolete checklist item (destructive)\\n  set_notes(ID, text=..., set=bool?)   Append/set notes\\n  set_parent(ID, parent=...)           Move to new parent\\n  accept_cr(ID, revision=N, evidence=...) Record a reviewer acceptance of a Change Request revision (local board only)\\n  integrate_external(ID, evidence=...)     Close accepted empty-delta external work by evidence (local board only)\\n  withdraw_cr(ID, revision=N, reason=...) Retire an unintegrated revision (local board only)\\n  defer_cr(ID, revision=N, reason=...)    Mark an accepted revision deferred by human decision (local board only)\\n  undefer_cr(ID, revision=N)              Clear the deferral marker (local board only)\\n  add_resource(ID, name=..., content=..., type=..., description=...)\\n  update_resource(ID, name=..., content=..., type=..., description=...)\\n  delete_resource(ID, name=...)        Delete resource (destructive)\\n  correct_activity(ID, target_event_id=..., kind=..., reason=...)\\n                                        Privileged append-only correction (destructive)\\n\\nAuth (always local):\\n  login(user=..., token=...)           Store token in credentials file\\n  logout()                             Remove active user's token\\n  switch_user(user=...)                Switch active user for remote\\n\\nSafety:\\n  --dry-run     Preview mutation without applying\\n  --confirm     Required for every schema-classified destructive mutation\\n\\nIntrospection:\\n  task-board q 'schema(mutation=NAME)' Show one mutation signature\\n\\nExamples:\\n  task-board m --format json 'set_status(TASK-260218-abc, status=development)'\\n  task-board m --format json 'normalize_legacy_status(STORY-260713-72b914, expected_raw=\\\"in-progress\\\", status=development)'\\n  task-board m --format json 'set_status(STORY-260218-abc, status=done, commit_ack=scope_committed)'\\n  task-board m --format json 'set_estimate(TASK-260218-abc, estimate=estimated, scale=fibonacci, number=5)'\\n  task-board m --format compact 'assign(TASK-260218-abc, agent=claude-opus)'\\n  task-board m --format json --dry-run 'delete(TASK-260218-abc)'\\n  task-board m --format json --dry-run 'remove_checklist_item(TASK-260218-abc, item=2)'\\n  task-board m --format json --confirm 'remove_checklist_item(TASK-260218-abc, item=2)'\\n  task-board m --format json --confirm 'delete(TASK-260218-abc)'\\n\\nUsage:\\n  task-board m <mutation> [flags]\\n\\n\",\n  \"original_output_bytes\": 5086,\n  \"original_output_tokens\": 1272,\n  \"truncated\": false\n}","final_result":true}}}
