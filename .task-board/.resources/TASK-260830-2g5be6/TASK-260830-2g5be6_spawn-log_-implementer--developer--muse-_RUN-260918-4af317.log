ed\\\",\\\"done\\\":true},{\\\"text\\\":\\\"If review does not accept the work — verdict evidence added and status routed by the explicit verdict branches\\\",\\\"done\\\":true}],\\\"id\\\":\\\"TASK-260830-2g5be6\\\",\\\"status\\\":\\\"integrating\\\"}\\n\",\n  \"original_output_bytes\": 2954,\n  \"original_output_tokens\": 739,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
