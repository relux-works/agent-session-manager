{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c995","stream":{"kind":"session","id":"01a0b2d0-7ac7-7f03-8c97-ccb0ee9decb3"},"sequence":805,"recorded_at":1780531400001605,"record_type":"event","durability":"durable","causation_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","run_stream":{"kind":"run","id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2"},"task_stream":{"kind":"task","id":"01a0b2d3-92c4-7913-b31e-7514a3214a49"},"task_id":"01a0b2d3-92c4-7913-b31e-7514a3214a49","event":{"kind":"output","task_id":"01a0b2d3-92c4-7913-b31e-7514a3214a49","chunk":"Read text file `internal/clonesnap/capture_test.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"crypto/sha256\"\n6|\t\"encoding/hex\"\n7|\t\"encoding/json\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|)\n16|\n17|// Positive contract tests: Capture seals both manifests from real\n18|// store bytes through the landed builders, every sealed manifest\n19|// re-decodes, identical runs produce byte-identical manifests, and\n20|// the sealed members match independently recomputed values.\n21|\n22|func TestCaptureSealsBothManifestsFromStoreBytes(t *testing.T) {\n23|\tstoreRoot := fixtureStore(t)\n24|\tstore := openTestStore(t)\n25|\tresult := mustCapture(t, validCaptureRequest(t, storeRoot, store))\n26|\n27|\tif result.BoundaryKind != \"stable\" {\n28|\t\tt.Fatalf(\"BoundaryKind = %q, want stable\", result.BoundaryKind)\n29|\t}\n30|\tif result.PreDigest != result.PostDigest {\n31|\t\tt.Fatalf(\"PreDigest %q != PostDigest %q on a quiet store\", result.PreDigest, result.PostDigest)\n32|\t}\n33|\tif !result.RawInstalled || !result.CaptureInstalled {\n34|\t\tt.Fatalf(\"Installed = (%v, %v), want (true, true) on first capture\", result.RawInstalled, result.CaptureInstalled)\n35|\t}\n36|\n37|\t// The raw manifest carries exactly the two included members,\n38|\t// sorted by native key, with byte counts recomputed here.\n39|\traw, err := clonebundle.DecodeRawObjectManifest(result.RawManifest)\n40|\tif err != nil {\n41|\t\tt.Fatalf(\"DecodeRawObjectManifest() error = %v\", err)\n42|\t}\n43|\tif len(raw.Entries) != 2 {\n44|\t\tt.Fatalf(\"raw entries = %d, want 2\", len(raw.Entries))\n45|\t}\n46|\tif raw.Entries[0].NativeItemKey != \"store/blob-a\" || raw.Entries[1].NativeItemKey != \"store/blob-b\" {\n47|\t\tt.Fatalf(\"raw entry keys = %q, %q\", raw.Entries[0].NativeItemKey, raw.Entries[1].NativeItemKey)\n48|\t}\n49|\twantA := sha256.Sum256([]byte(\"alpha-payload-bytes\"))\n50|\twantB := sha256.Sum256([]byte(\"beta-payload-bytes\"))\n51|\tif raw.Entries[0].BlobID.String() != \"sha256:\"+hex.EncodeToString(wantA[:]) {\n52|\t\tt.Fatalf(\"blob-a blob_id = %q\", raw.Entries[0].BlobID)\n53|\t}\n54|\tif raw.Entries[1].BlobID.String() != \"sha256:\"+hex.EncodeToString(wantB[:]) {\n55|\t\tt.Fatalf(\"blob-b blob_id = %q\", raw.Entries[1].BlobID)\n56|\t}\n57|\tif raw.Entries[0].ByteCount != uint64(len(\"alpha-payload-bytes\")) {\n58|\t\tt.Fatalf(\"blob-a byte_count = %d\", raw.Entries[0].ByteCount)\n59|\t}\n60|\tvar sum uint64\n61|\tfor _, entry := range raw.Entries {\n62|\t\tsum += entry.ByteCount\n63|\t}\n64|\tif raw.TotalBytes != sum {\n65|\t\tt.Fatalf(\"TotalBytes = %d, entries sum to %d\", raw.TotalBytes, sum)\n66|\t}\n67|\tif raw.SourceNativeSessionID != \"native-session-snap\" {\n68|\t\tt.Fatalf(\"SourceNativeSessionID = %q\", raw.SourceNativeSessionID)\n69|\t}\n70|\n71|\t// The capture manifest reconciles: one item per plan candidate,\n72|\t// the credential excluded with its stable reason, raw_complete\n73|\t// derived true, and the exact raw manifest identity.\n74|\tmanifest, err := clonebundle.DecodeCaptureManifest(result.CaptureManifest)\n75|\tif err != nil {\n76|\t\tt.Fatalf(\"DecodeCaptureManifest() error = %v\", err)\n77|\t}\n78|\tif len(manifest.Items) != 3 {\n79|\t\tt.Fatalf(\"capture items = %d, want 3\", len(manifest.Items))\n80|\t}\n81|\tbyKey := map[string]clonebundle.CaptureItem{}\n82|\tfor _, item := range manifest.Items {\n83|\t\tbyKey[item.NativeItemKey] = item\n84|\t}\n85|\tif !byKey[\"store/blob-a\"].Included() || !byKey[\"store/blob-b\"].Included() {\n86|\t\tt.Fatal(\"included members did not seal as included\")\n87|\t}\n88|\tcredential := byKey[\"store/token-cache\"]\n89|\tif credential.Included() {\n90|\t\tt.Fatal(\"credential sealed as included\")\n91|\t}\n92|\tif credential.ExclusionReason == nil || *credential.ExclusionReason != \"credential_excluded\" {\n93|\t\tt.Fatalf(\"credential exclusion reason = %v\", credential.ExclusionReason)\n94|\t}\n95|\tif len(manifest.ExcludedClasses) != 1 || manifest.ExcludedClasses[0] != \"credential\" {\n96|\t\tt.Fatalf(\"ExcludedClasses = %v, want [credential]\", manifest.ExcludedClasses)\n97|\t}\n98|\tif !manifest.RawComplete {\n99|\t\tt.Fatal(\"RawComplete = false, want true after complete reconciliation\")\n100|\t}\n101|\tif manifest.SourceRawObjectManifest != raw.ManifestID {\n102|\t\tt.Fatalf(\"SourceRawObjectManifest %q != raw %q\", manifest.SourceRawObjectManifest, raw.ManifestID)\n103|\t}\n104|\tif !manifest.CaptureBoundary.Stable() {\n105|\t\tt.Fatal(\"CaptureBoundary is not stable\")\n106|\t}\n107|\tproof := manifest.CaptureBoundary.Proof\n108|\tif proof.ProofKind != \"closed_store\" {\n109|\t\tt.Fatalf(\"ProofKind = %q, want closed_store\", proof.ProofKind)\n110|\t}\n111|\tif proof.PreCaptureDigest != proof.PostCaptureDigest {\n112|\t\tt.Fatal(\"sealed proof digests differ on a quiet store\")\n113|\t}\n114|\tif proof.PreCaptureDigest != result.PreDigest {\n115|\t\tt.Fatal(\"sealed proof pre digest is not the measured source digest\")\n116|\t}\n117|\tif proof.SourceGeneration.String() != \"generation-7\" {\n118|\t\tt.Fatalf(\"SourceGeneration = %q\", proof.SourceGeneration)\n119|\t}\n120|\n121|\t// The workspace checkpoint seals the observed repository state.\n122|\tbinding, err := clonebundle.DecodeWorkspaceBinding(result.WorkspaceBinding)\n123|\tif err != nil {\n124|\t\tt.Fatalf(\"DecodeWorkspaceBinding() error = %v\", err)\n125|\t}\n126|\tif binding.CwdRelative != \"work/trees/alpha\" {\n127|\t\tt.Fatalf(\"CwdRelative = %q\", binding.CwdRelative)\n128|\t}\n129|\tif binding.Branch == nil || *binding.Branch != \"main\" {\n130|\t\tt.Fatalf(\"Branch = %v\", binding.Branch)\n131|\t}\n132|\tif binding.HeadDigest == nil || binding.HeadDigest.String() != fixtureDigest(\"snap-head\") {\n133|\t\tt.Fatalf(\"HeadDigest = %v\", binding.HeadDigest)\n134|\t}\n135|}\n136|\n137|func TestCaptureInstallsEveryPayloadBlob(t *testing.T) {\n138|\t// Section 10.2 MUST: before publishing a record that\n139|\t// references a blob, the blob is installed. Every raw entry's\n140|\t// blob is present in the store after Capture.\n141|\tstoreRoot := fixtureStore(t)\n142|\tstore := openTestStore(t)\n143|\tresult := mustCapture(t, validCaptureRequest(t, storeRoot, store))\n144|\tassertEveryRawBlobInstalled(t, store, result.Raw)\n145|}\n146|\n147|func TestCaptureIsByteIdenticalAcrossRuns(t *testing.T) {\n148|\tstoreRoot := fixtureStore(t)\n149|\tfirst := mustCapture(t, validCaptureRequest(t, storeRoot, openTestStore(t)))\n150|\tsecond := mustCapture(t, validCaptureRequest(t, storeRoot, openTestStore(t)))\n151|\tif !bytes.Equal(first.RawManifest, second.RawManifest) {\n152|\t\tt.Fatal(\"RawManifest bytes differ across identical runs\")\n153|\t}\n154|\tif !bytes.Equal(first.CaptureManifest, second.CaptureManifest) {\n155|\t\tt.Fatal(\"CaptureManifest bytes differ across identical runs\")\n156|\t}\n157|\tif first.PreDigest != second.PreDigest {\n158|\t\tt.Fatal(\"PreDigest differs across identical runs\")\n159|\t}\n160|}\n161|\n162|func TestCaptureUnknownMakesRawIncomplete(t *testing.T) {\n163|\tstoreRoot := fixtureStore(t)\n164|\twriteStoreFile(t, storeRoot, \"store/zz-unknown\", []byte(\"unknown-kind-bytes\"))\n165|\tstore := openTestStore(t)\n166|\trequest := validCaptureRequest(t, storeRoot, store)\n167|\trequest.Plan = []PlanItem{\n168|\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n169|\t\t{NativeKey: \"store/blob-b\", Class: \"durable_sidecar\", Required: true},\n170|\t\t{NativeKey: \"store/token-cache\", Class: \"credential\", Required: false},\n171|\t\t{NativeKey: \"store/zz-unknown\", Class: \"unknown\", Required: true},\n172|\t}\n173|\tresult := mustCapture(t, request)\n174|\tif result.Capture.RawComplete {\n175|\t\tt.Fatal(\"RawComplete = true with an unknown-class item, want false\")\n176|\t}\n177|\tif len(result.Raw.Entries) != 3 {\n178|\t\tt.Fatalf(\"raw entries = %d, want 3 (unknown is captured)\", len(result.Raw.Entries))\n179|\t}\n180|\tif err := clonebundle.RefuseMaximalSafeUnlessComplete(result.Capture); err == nil {\n181|\t\tt.Fatal(\"RefuseMaximalSafeUnlessComplete() = nil with an unknown-class item\")\n182|\t} else if !strings.Contains(err.Error(), \"maximal_safe\") {\n183|\t\tt.Fatalf(\"RefuseMaximalSafeUnlessComplete() error = %v, want the maximal_safe refusal\", err)\n184|\t}\n185|}\n186|\n187|func TestCaptureOptionalAbsentUnknownMakesRawIncomplete(t *testing.T) {\n188|\t// P3-ε: an EXCLUDED unknown-class item — an optional plan\n189|\t// member absent from the store — still drives\n190|\t// raw_complete=false and still blocks maximal_safe at the\n191|\t// projection entry, exactly like an included unknown item.\n192|\tstoreRoot := fixtureStore(t)\n193|\tstore := openTestStore(t)\n194|\trequest := validCaptureRequest(t, storeRoot, store)\n195|\trequest.Plan = []PlanItem{\n196|\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n197|\t\t{NativeKey: \"store/blob-b\", Class: \"durable_sidecar\", Required: true},\n198|\t\t{NativeKey: \"store/token-cache\", Class: \"credential\", Required: false},\n199|\t\t{NativeKey: \"store/zz-unknown-absent\", Class: \"unknown\", Required: false},\n200|\t}\n201|\tresult := mustCapture(t, request)\n202|\tif result.Capture.RawComplete {\n203|\t\tt.Fatal(\"RawComplete = true with an excluded unknown-class item, want false\")\n204|\t}\n205|\tvar found *clonebundle.CaptureItem\n206|\tfor index := range result.Capture.Items {\n207|\t\tif result.Capture.Items[index].NativeItemKey == \"store/zz-unknown-absent\" {\n208|\t\t\tfound = &result.Capture.Items[index]\n209|\t\t}\n210|\t}\n211|\tif found == nil {\n212|\t\tt.Fatal(\"optional absent unknown candidate has no item\")\n213|\t}\n214|\tif found.Included() {\n215|\t\tt.Fatal(\"optional absent unknown candidate sealed as included\")\n216|\t}\n217|\tif found.ExclusionReason == nil || *found.ExclusionReason != \"plan_optional_absent\" {\n218|\t\tt.Fatalf(\"optional absent unknown reason = %v\", found.ExclusionReason)\n219|\t}\n220|\tif _, err := AdmitForTarget(result.CaptureManifest, \"maximal_safe\"); err == nil {\n221|\t\tt.Fatal(\"AdmitForTarget(maximal_safe) admitted a manifest with an excluded unknown item\")\n222|\t} else {\n223|\t\trequireRefusalDetail(t, err, \"maximal_safe\")\n224|\t}\n225|\tif _, err := AdmitForTarget(result.CaptureManifest, \"strict_exact\"); err != nil {\n226|\t\tt.Fatalf(\"AdmitForTarget(strict_exact) error = %v\", err)\n227|\t}\n228|}\n229|\n230|func TestCaptureImmutableSnapshotProof(t *testing.T) {\n231|\tstoreRoot := fixtureStore(t)\n232|\tstore := openTestStore(t)\n233|\trequest := validCaptureRequest(t, storeRoot, store)\n234|\trequest.ProofKind = \"immutable_snapshot\"\n235|\tidentity := fixtureDigest(\"snap-snapshot-identity\")\n236|\trequest.SnapshotIdentity = &identity\n237|\tresult := mustCapture(t, request)\n238|\tproof := result.Capture.CaptureBoundary.Proof\n239|\tif proof.ProofKind != \"immutable_snapshot\" {\n240|\t\tt.Fatalf(\"ProofKind = %q\", proof.ProofKind)\n241|\t}\n242|\tif proof.SnapshotIdentity == nil || proof.SnapshotIdentity.String() != identity {\n243|\t\tt.Fatalf(\"SnapshotIdentity = %v\", proof.SnapshotIdentity)\n244|\t}\n245|}\n246|\n247|func TestCaptureExternalNativeBasis(t *testing.T) {\n248|\tstoreRoot := fixtureStore(t)\n249|\tstore := openTestStore(t)\n250|\trequest := validCaptureRequest(t, storeRoot, store)\n251|\trequest.SourceBasis = clonebundle.SourceBasisInput{\n252|\t\tKind:              \"external_native\",\n253|\t\tExternalSourceRef: \"provider-native-source-9\",\n254|\t}\n255|\tresult := mustCapture(t, request)\n256|\tif result.Capture.SourceBasis.Kind != \"external_native\" {\n257|\t\tt.Fatalf(\"SourceBasis kind = %q\", result.Capture.SourceBasis.Kind)\n258|\t}\n259|\tif result.Capture.SourceBasis.ExternalSourceRef == nil ||\n260|\t\t*result.Capture.SourceBasis.ExternalSourceRef != \"provider-native-source-9\" {\n261|\t\tt.Fatalf(\"ExternalSourceRef = %v\", result.Capture.SourceBasis.ExternalSourceRef)\n262|\t}\n263|}\n264|\n265|func TestCaptureOptionalAbsentSealsExcluded(t *testing.T) {\n266|\tstoreRoot := fixtureStore(t)\n267|\tstore := openTestStore(t)\n268|\trequest := validCaptureRequest(t, storeRoot, store)\n269|\trequest.Plan = []PlanItem{\n270|\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n271|\t\t{NativeKey: \"store/blob-b\", Class: \"durable_sidecar\", Required: true},\n272|\t\t{NativeKey: \"store/maybe\", Class: \"durable_payload\", Required: false},\n273|\t\t{NativeKey: \"store/token-cache\", Class: \"credential\", Required: false},\n274|\t}\n275|\tresult := mustCapture(t, request)\n276|\tif len(result.Capture.Items) != 4 {\n277|\t\tt.Fatalf(\"capture items = %d, want 4\", len(result.Capture.Items))\n278|\t}\n279|\tvar found *clonebundle.CaptureItem\n280|\tfor index := range result.Capture.Items {\n281|\t\tif result.Capture.Items[index].NativeItemKey == \"store/maybe\" {\n282|\t\t\tfound = &result.Capture.Items[index]\n283|\t\t}\n284|\t}\n285|\tif found == nil {\n286|\t\tt.Fatal(\"optional absent candidate has no item\")\n287|\t}\n288|\tif found.Included() {\n289|\t\tt.Fatal(\"optional absent candidate sealed as included\")\n290|\t}\n291|\tif found.ExclusionReason == nil || *found.ExclusionReason != \"plan_optional_absent\" {\n292|\t\tt.Fatalf(\"optional absent reason = %v\", found.ExclusionReason)\n293|\t}\n294|\tif !result.Capture.RawComplete {\n295|\t\tt.Fatal(\"RawComplete = false, want true: the absent optional reconciles as excluded\")\n296|\t}\n297|}\n298|\n299|func TestCaptureEmptyMemberSealsEmptyBlob(t *testing.T) {\n300|\tstoreRoot := fixtureStore(t)\n301|\twriteStoreFile(t, storeRoot, \"store/blob-empty\", []byte{})\n302|\tstore := openTestStore(t)\n303|\trequest := validCaptureRequest(t, storeRoot, store)\n304|\trequest.Plan = []PlanItem{\n305|\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n306|\t\t{NativeKey: \"store/blob-b\", Class: \"durable_sidecar\", Required: true},\n307|\t\t{NativeKey: \"store/blob-empty\", Class: \"durable_sidecar\", Required: true},\n308|\t\t{NativeKey: \"store/token-cache\", Class: \"credential\", Required: false},\n309|\t}\n310|\tresult := mustCapture(t, request)\n311|\tvar entry *clonebundle.RawObjectEntry\n312|\tfor index := range result.Raw.Entries {\n313|\t\tif result.Raw.Entries[index].NativeItemKey == \"store/blob-empty\" {\n314|\t\t\tentry = &result.Raw.Entries[index]\n315|\t\t}\n316|\t}\n317|\tif entry == nil {\n318|\t\tt.Fatal(\"empty member has no raw entry\")\n319|\t}\n320|\tif entry.ByteCount != 0 {\n321|\t\tt.Fatalf(\"empty member byte_count = %d\", entry.ByteCount)\n322|\t}\n323|\temptySum := sha256.Sum256(nil)\n324|\tif entry.BlobID.String() != \"sha256:\"+hex.EncodeToString(emptySum[:]) {\n325|\t\tt.Fatalf(\"empty member blob_id = %q\", entry.BlobID)\n326|\t}\n327|\tdescriptor, err := BuildBlobDescriptor([]byte{})\n328|\tif err != nil {\n329|\t\tt.Fatalf(\"BuildBlobDescriptor(empty) error = %v\", err)\n330|\t}\n331|\tvar members map[string]json.RawMessage\n332|\tif err := json.Unmarshal(descriptor.Descriptor, &members); err != nil {\n333|\t\tt.Fatal(err)\n334|\t}\n335|\tif string(members[\"chunks\"]) != \"[]\" {\n336|\t\tt.Fatalf(\"empty descriptor chunks = %s, want []\", members[\"chunks\"])\n337|\t}\n338|\tif string(members[\"media_type\"]) != `\"application/octet-stream\"` {\n339|\t\tt.Fatalf(\"empty descriptor media_type = %s\", members[\"media_type\"])\n340|\t}\n341|}\n342|\n343|func TestCaptureMultiChunkMember(t *testing.T) {\n344|\tstoreRoot := fixtureStore(t)\n345|\tpayload := bytes.Repeat([]byte(\"0123456789abcdef\"), 4*1048576/16+1)\n346|\tpayload = payload[:4*1048576+10]\n347|\twriteStoreFile(t, storeRoot, \"store/blob-big\", payload)\n348|\tstore := openTestStore(t)\n349|\trequest := validCaptureRequest(t, storeRoot, store)\n350|\trequest.Plan = []PlanItem{\n351|\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n352|\t\t{NativeKey: \"store/blob-b\", Class: \"durable_sidecar\", Required: true},\n353|\t\t{NativeKey: \"store/blob-big\", Class: \"durable_payload\", Required: true},\n354|\t\t{NativeKey: \"store/token-cache\", Class: \"credential\", Required: false},\n355|\t}\n356|\tresult := mustCapture(t, request)\n357|\tdescriptor, err := BuildBlobDescriptor(payload)\n358|\tif err != nil {\n359|\t\tt.Fatalf(\"BuildBlobDescriptor() error = %v\", err)\n360|\t}\n361|\tvar members map[string]json.RawMessage\n362|\tif err := json.Unmarshal(descriptor.Descriptor, &members); err != nil {\n363|\t\tt.Fatal(err)\n364|\t}\n365|\tvar chunks []map[string]json.RawMessage\n366|\tif err := json.Unmarshal(members[\"chunks\"], &chunks); err != nil {\n367|\t\tt.Fatal(err)\n368|\t}\n369|\tif len(chunks) != 2 {\n370|\t\tt.Fatalf(\"chunks = %d, want 2\", len(chunks))\n371|\t}\n372|\tif string(chunks[0][\"index\"]) != \"0\" || string(chunks[0][\"offset\"]) != \"0\" ||\n373|\t\tstring(chunks[0][\"size\"]) != \"4194304\" {\n374|\t\tt.Fatalf(\"chunk[0] = %v\", chunks[0])\n375|\t}\n376|\tif string(chunks[1][\"index\"]) != \"1\" || string(chunks[1][\"offset\"]) != \"4194304\" ||\n377|\t\tstring(chunks[1][\"size\"]) != \"10\" {\n378|\t\tt.Fatalf(\"chunk[1] = %v\", chunks[1])\n379|\t}\n380|\tfirstSum := sha256.Sum256(payload[:4194304])\n381|\tif string(chunks[0][\"chunk_id\"]) != `\"sha256:`+hex.EncodeToString(firstSum[:])+`\"` {\n382|\t\tt.Fatalf(\"chunk[0] chunk_id = %s\", chunks[0][\"chunk_id\"])\n383|\t}\n384|\tvar found *clonebundle.RawObjectEntry\n385|\tfor index := range result.Raw.Entries {\n386|\t\tif result.Raw.Entries[index].NativeItemKey == \"store/blob-big\" {\n387|\t\t\tfound = &result.Raw.Entries[index]\n388|\t\t}\n389|\t}\n390|\tif found == nil || found.BlobID != descriptor.BlobID || found.BlobDescriptorID != descriptor.DescriptorID {\n391|\t\tt.Fatal(\"raw entry does not reference the sealed multi-chunk descriptor\")\n392|\t}\n393|}\n394|\n395|func TestDefaultMaxSingleBytesIs128GiB(t *testing.T) {\n396|\tif DefaultMaxSingleBytes != 137438953472 {\n397|\t\tt.Fatalf(\"DefaultMaxSingleBytes = %d, want 137438953472\", DefaultMaxSingleBytes)\n398|\t}\n399|}\n400|\n401|func storeFixturePayload(t *testing.T, storeRoot, key string) string {\n402|\tt.Helper()\n403|\treturn filepath.Join(storeRoot, filepath.FromSlash(key))\n404|}\n405|\n406|func TestCaptureDescriptorAgreementEndToEnd(t *testing.T) {\n407|\tstoreRoot := fixtureStore(t)\n408|\tstore := openTestStore(t)\n409|\tresult := mustCapture(t, validCaptureRequest(t, storeRoot, store))\n410|\tfetch := map[string][]byte{}\n411|\tfor _, entry := range result.Raw.Entries {\n412|\t\tpayload, err := os.ReadFile(storeFixturePayload(t, storeRoot, entry.NativeItemKey))\n413|\t\tif err != nil {\n414|\t\t\tt.Fatal(err)\n415|\t\t}\n416|\t\tdescriptor, err := BuildBlobDescriptor(payload)\n417|\t\tif err != nil {\n418|\t\t\tt.Fatal(err)\n419|\t\t}\n420|\t\tfetch[descriptor.DescriptorID.String()] = descriptor.Descriptor\n421|\t}\n422|\tif err := clonebundle.VerifyRawManifestDescriptors(result.Raw, func(id string) ([]byte, error) {\n423|\t\tdescriptor, ok := fetch[id]\n424|\t\tif !ok {\n425|\t\t\tt.Fatalf(\"descriptor fetch missed %s\", id)\n426|\t\t}\n427|\t\treturn descriptor, nil\n428|\t}); err != nil {\n429|\t\tt.Fatalf(\"VerifyRawManifestDescriptors() error = %v\", err)\n430|\t}\n431|\tif got := scalar.SHA256Digest([]byte(\"alpha-payload-bytes\")).String(); result.Raw.Entries[0].BlobID.String() != got {\n432|\t\tt.Fatalf(\"blob-a blob_id = %q, want %q\", result.Raw.Entries[0].BlobID, got)\n433|\t}\n434|}","final_result":true}}}
