e mutates blob-a at equal size: size equality is\n44|\t// never proof, so the content digests still disagree.\n45|\terr := raceRefusal(t, func(root string) {\n46|\t\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"alpha-payload-bytez\"))\n47|\t})\n48|\trequireRefusalDetail(t, err, `\"store/blob-a\"`, \"capture digests differ\")\n49|\t// The second case mutates blob-b: other members still refuse\n50|\t// after the admit-exactly-blob-a narrowing.\n51|\tother := raceRefusal(t, func(root string) {\n52|\t\twriteStoreFile(t, root, \"store/blob-b\", []byte(\"beta-payload-bytez\"))\n53|\t})\n54|\trequireRefusalDetail(t, other, `\"store/blob-b\"`, \"capture digests differ\")\n55|}\n56|\n57|func TestCaptureRaceChangedSize(t *testing.T) {\n58|\terr := raceRefusal(t, func(root string) {\n59|\t\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"alpha-payload-bytes-extended\"))\n60|\t})\n61|\trequireRefusalDetail(t, err, `\"store/blob-a\"`)\n62|}\n63|\n64|func TestCaptureRaceAppendedRecord(t *testing.T) {\n65|\terr := raceRefusal(t, func(root string) {\n66|\t\twriteStoreFile(t, root, \"store/blob-appended\", []byte(\"appended-bytes\"))\n67|\t})\n68|\trequireRefusalDetail(t, err, `\"store/blob-appended\"`)\n69|}\n70|\n71|func TestCaptureRaceReplacedFile(t *testing.T) {\n72|\terr := raceRefusal(t, func(root string) {\n73|\t\tif err := os.Remove(filepath.Join(root, \"store\", \"blob-a\")); err != nil {\n74|\t\t\tt.Fatal(err)\n75|\t\t}\n76|\t\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"replacement-bytes\"))\n77|\t})\n78|\trequireRefusalDetail(t, err, `\"store/blob-a\"`)\n79|}\n80|\n81|func TestCaptureRaceUnreadableAtPost(t *testing.T) {\n82|\t// A member that grows past MaxSingleBytes between the walk\n83|\t// and the post measurement keeps its shape — the same\n84|\t// regular key — but cannot be re-read: the race refuses\n85|\t// naming the member instead of sealing the captured hash.\n86|\tstoreRoot := fixtureStore(t)\n87|\tstoreSink := openTestStore(t)\n88|\trequest :