{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c88d","stream":{"kind":"session","id":"01a0b2d0-7ac7-7f03-8c97-ccb0ee9decb3"},"sequence":673,"recorded_at":1780531400001341,"record_type":"event","durability":"durable","causation_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","run_stream":{"kind":"run","id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2"},"task_stream":{"kind":"task","id":"01a0b2d2-6883-7ee2-843c-a2e5bdc30f02"},"task_id":"01a0b2d2-6883-7ee2-843c-a2e5bdc30f02","event":{"kind":"output","task_id":"01a0b2d2-6883-7ee2-843c-a2e5bdc30f02","chunk":"Read text file `internal/clonesnap/exclusion_test.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"strconv\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n9|)\n10|\n11|func itoa(value int) string { return strconv.Itoa(value) }\n12|\n13|// Exclusion evidence: the always-excluded classes seal as excluded\n14|// rows with stable reasons, and their bytes never reach a blob, a\n15|// manifest, a log line, or an error string — because the walk never\n16|// opens them.\n17|\n18|var exclusionSecrets = map[string]string{\n19|\t\"credential\":     \"snap-secret-credential-7f3a\",\n20|\t\"machine_auth\":   \"snap-secret-machine-auth-9b1e\",\n21|\t\"runtime_state\":  \"snap-secret-runtime-state-4c8d\",\n22|\t\"transient_lock\": \"snap-secret-transient-lock-2e6f\",\n23|}\n24|\n25|func exclusionStore(t *testing.T) (string, []PlanItem) {\n26|\tt.Helper()\n27|\troot := t.TempDir()\n28|\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"alpha-payload-bytes\"))\n29|\tplan := []PlanItem{{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true}}\n30|\tkeys := []string{\"store/auth-token\", \"store/lock-file\", \"store/runtime-sock\", \"store/session-key\"}\n31|\tclasses := []string{\"credential\", \"transient_lock\", \"runtime_state\", \"machine_auth\"}\n32|\tfor index, key := range keys {\n33|\t\twriteStoreFile(t, root, key, []byte(exclusionSecrets[classes[index]]))\n34|\t\tplan = append(plan, PlanItem{NativeKey: key, Class: classes[index], Required: true})\n35|\t}\n36|\t// Sorted: auth-token, blob-a, lock-file, runtime-sock, session-key.\n37|\tordered := []PlanItem{plan[1], plan[0], plan[2], plan[3], plan[4]}\n38|\treturn root, ordered\n39|}\n40|\n41|func TestCaptureExcludesSecrets(t *testing.T) {\n42|\tstoreRoot, plan := exclusionStore(t)\n43|\tstoreSink := openTestStore(t)\n44|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n45|\trequest.Plan = plan\n46|\tresult := mustCapture(t, request)\n47|\n48|\tbyKey := map[string]clonebundle.CaptureItem{}\n49|\tfor _, item := range result.Capture.Items {\n50|\t\tbyKey[item.NativeItemKey] = item\n51|\t}\n52|\texpectReason := map[string]string{\n53|\t\t\"store/auth-token\":   \"credential_excluded\",\n54|\t\t\"store/session-key\":  \"machine_auth_excluded\",\n55|\t\t\"store/runtime-sock\": \"runtime_state_excluded\",\n56|\t\t\"store/lock-file\":    \"transient_lock_excluded\",\n57|\t}\n58|\tfor key, reason := range expectReason {\n59|\t\titem, ok := byKey[key]\n60|\t\tif !ok {\n61|\t\t\tt.Fatalf(\"excluded candidate %q has no item\", key)\n62|\t\t}\n63|\t\tif item.Included() {\n64|\t\t\tt.Fatalf(\"excluded candidate %q sealed as included\", key)\n65|\t\t}\n66|\t\tif item.ExclusionReason == nil || *item.ExclusionReason != reason {\n67|\t\t\tt.Fatalf(\"excluded candidate %q reason = %v, want %q\", key, item.ExclusionReason, reason)\n68|\t\t}\n69|\t\tif item.BlobDescriptorID != nil || item.ByteCount != nil {\n70|\t\t\tt.Fatalf(\"excluded candidate %q carries content members\", key)\n71|\t\t}\n72|\t}\n73|\tfor _, entry := range result.Raw.Entries {\n74|\t\tif entry.NativeItemKey != \"store/blob-a\" {\n75|\t\t\tt.Fatalf(\"raw entry %q is not the included member\", entry.NativeItemKey)\n76|\t\t}\n77|\t}\n78|\n79|\tsecrets := []string{}\n80|\tfor _, secret := range exclusionSecrets {\n81|\t\tsecrets = append(secrets, secret)\n82|\t}\n83|\tscanSecrets := func(context string, haystacks ...string) {\n84|\t\tt.Helper()\n85|\t\tfor _, haystack := range haystacks {\n86|\t\t\tfor _, secret := range secrets {\n87|\t\t\t\tif strings.Contains(haystack, secret) {\n88|\t\t\t\t\tt.Fatalf(\"%s carries excluded bytes %q\", context, secret)\n89|\t\t\t\t}\n90|\t\t\t}\n91|\t\t}\n92|\t}\n93|\tfor _, blob := range listStoredBlobs(t, storeSink) {\n94|\t\tscanSecrets(\"stored blob\", string(blob.bytes))\n95|\t}\n96|\tscanSecrets(\"raw manifest\", string(result.RawManifest))\n97|\tscanSecrets(\"capture manifest\", string(result.CaptureManifest))\n98|\tscanSecrets(\"workspace binding\", string(result.WorkspaceBinding))\n99|\tscanSecrets(\"capture log\", strings.Join(result.Logs, \"\\n\"))\n100|\n101|\t// A refusal elsewhere in the run must not smuggle excluded\n102|\t// bytes into its error string either.\n103|\twriteStoreFile(t, storeRoot, \"store/zz-extra\", []byte(\"unplanned-bytes\"))\n104|\tsecond, err := Capture(validCaptureRequest(t, storeRoot, openTestStore(t)))\n105|\tif err == nil {\n106|\t\tt.Fatalf(\"Capture() = %+v, want an unplanned-member refusal\", second)\n107|\t}\n108|\tscanSecrets(\"refusal error\", err.Error())\n109|}\n110|\n111|func TestCaptureLogRecordsDigestsOnly(t *testing.T) {\n112|\tstoreRoot := t.TempDir()\n113|\tsecret := \"snap-secret-included-payload-5a1c\"\n114|\tpayload := \"prefix-\" + secret + \"-suffix\"\n115|\twriteStoreFile(t, storeRoot, \"store/blob-a\", []byte(payload))\n116|\tstoreSink := openTestStore(t)\n117|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n118|\trequest.Plan = []PlanItem{{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true}}\n119|\tresult := mustCapture(t, request)\n120|\n121|\tjoined := strings.Join(result.Logs, \"\\n\")\n122|\tif strings.Contains(joined, secret) {\n123|\t\tt.Fatalf(\"capture log carries payload bytes:\\n%s\", joined)\n124|\t}\n125|\tdigest := result.Raw.Entries[0].BlobID.String()\n126|\tif !strings.Contains(joined, digest) {\n127|\t\tt.Fatalf(\"capture log misses the blob digest %q:\\n%s\", digest, joined)\n128|\t}\n129|\tif !strings.Contains(joined, \"application/octet-stream\") {\n130|\t\tt.Fatalf(\"capture log misses the media type:\\n%s\", joined)\n131|\t}\n132|\tif want := \"size=\" + itoa(len(payload)); !strings.Contains(joined, want) {\n133|\t\tt.Fatalf(\"capture log misses the byte size %q:\\n%s\", want, joined)\n134|\t}\n135|}","final_result":true}}}
