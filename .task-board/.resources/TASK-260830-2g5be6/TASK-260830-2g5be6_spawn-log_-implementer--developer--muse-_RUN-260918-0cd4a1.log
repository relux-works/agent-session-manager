{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c75d","stream":{"kind":"session","id":"01a0b2d0-7ac7-7f03-8c97-ccb0ee9decb3"},"sequence":521,"recorded_at":1780531400001037,"record_type":"event","durability":"durable","causation_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","run_stream":{"kind":"run","id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2"},"task_stream":{"kind":"task","id":"01a0b2d2-2544-7be3-9cac-40f36c72818b"},"task_id":"01a0b2d2-2544-7be3-9cac-40f36c72818b","event":{"kind":"output","task_id":"01a0b2d2-2544-7be3-9cac-40f36c72818b","chunk":"Read text file `internal/clonesnap/fixtures_test.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"runtime\"\n9|\t\"strings\"\n10|\t\"testing\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/localstore\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|)\n16|\n17|// Shared fixtures for the clonesnap suite. Every literal is\n18|// hand-written and independent of production constants; digests are\n19|// recomputed with crypto/sha256, never copied from production. The\n20|// verdict always comes from production; the vectors never do.\n21|\n22|const (\n23|\tfixtureOperationID = \"0198f4d1-9e60-7f11-8a31-abcdef012345\"\n24|\tfixtureBundleID    = \"0198f4d1-9e60-7f22-8b42-bcdef0123456\"\n25|\tfixtureSessionID   = \"0198f4d1-9e60-7f33-8c53-cdef01234567\"\n26|\tfixtureHostID      = \"0198f4d1-9e60-7f44-8d64-def012345678\"\n27|\tfixtureWorkspaceID = \"0198f4d1-9e60-7f55-8e75-ef0123456789\"\n28|\tfixtureCreatedAt   = \"2026-09-18T05:10:00.000Z\"\n29|\tfixtureUUIDKey     = \"0198f4d1-9e60-7f66-8f86-f0123456789a\"\n30|)\n31|\n32|func fixtureDigest(seed string) string {\n33|\tsum := sha256.Sum256([]byte(seed))\n34|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n35|}\n36|\n37|func fixtureTupleJSON() string {\n38|\treturn `{\"environment_id\":\"snap.env\",\"environment_version\":\"3.0.1\",\"platform\":\"linux\",\"architecture\":\"arm64\",\"store_schema_fingerprint\":` +\n39|\t\t`\"` + fixtureDigest(\"snap-store-fingerprint\") + `\",\"adapter_version\":\"2.0.0\"}`\n40|}\n41|\n42|func fixtureNativeIdentity(t *testing.T) clonebundle.NativeIdentity {\n43|\tt.Helper()\n44|\tworkspace, err := scalar.ParseUUIDv7(fixtureWorkspaceID)\n45|\tif err != nil {\n46|\t\tt.Fatalf(\"ParseUUIDv7() error = %v\", err)\n47|\t}\n48|\treturn clonebundle.NativeIdentity{\n49|\t\tNativeSessionID:    \"native-session-snap\",\n50|\t\tIdentityKind:       \"provider_native\",\n51|\t\tLogicalWorkspaceID: workspace,\n52|\t}\n53|}\n54|\n55|func fixturePlatform() scalar.Platform {\n56|\tif runtime.GOOS == \"darwin\" {\n57|\t\treturn scalar.PlatformMacOS\n58|\t}\n59|\tif runtime.GOOS == \"windows\" {\n60|\t\treturn scalar.PlatformWindows\n61|\t}\n62|\treturn scalar.PlatformLinux\n63|}\n64|\n65|func openTestStore(t *testing.T) *localstore.ObjectStore {\n66|\tt.Helper()\n67|\thome := t.TempDir()\n68|\tconfig := filepath.Join(home, \"config\")\n69|\tif err := os.Mkdir(config, 0o700); err != nil {\n70|\t\tt.Fatal(err)\n71|\t}\n72|\tstore, err := openStoreAt(home)\n73|\tif err != nil {\n74|\t\tt.Fatalf(\"openStoreAt() error = %v\", err)\n75|\t}\n76|\treturn store\n77|}\n78|\n79|// openStoreAt opens the object store rooted at an existing home\n80|// directory. The crash child uses it without a testing context.\n81|func openStoreAt(home string) (*localstore.ObjectStore, error) {\n82|\tresolved, err := localstore.ResolvePaths(localstore.ResolveRequest{\n83|\t\tPlatform: fixturePlatform(),\n84|\t\tFlags: map[string]string{\n85|\t\t\t\"--config\":      filepath.Join(home, \"config\", \"config.toml\"),\n86|\t\t\t\"--data-dir\":    filepath.Join(home, \"data\"),\n87|\t\t\t\"--state-dir\":   filepath.Join(home, \"state\"),\n88|\t\t\t\"--cache-dir\":   filepath.Join(home, \"cache\"),\n89|\t\t\t\"--runtime-dir\": filepath.Join(home, \"runtime\"),\n90|\t\t},\n91|\t\tEnvironment:  map[string]string{},\n92|\t\tHomeDir:      home,\n93|\t\tTemporaryDir: filepath.Join(home, \"temporary\"),\n94|\t})\n95|\tif err != nil {\n96|\t\treturn nil, err\n97|\t}\n98|\treturn localstore.OpenObjectStore(resolved)\n99|}\n100|\n101|// writeStoreFile creates one regular store member with the given\n102|// bytes, creating parent directories as needed.\n103|func writeStoreFile(t *testing.T, root, key string, data []byte) {\n104|\tt.Helper()\n105|\tpath := filepath.Join(root, filepath.FromSlash(key))\n106|\tif err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {\n107|\t\tt.Fatal(err)\n108|\t}\n109|\tif err := os.WriteFile(path, data, 0o600); err != nil {\n110|\t\tt.Fatal(err)\n111|\t}\n112|}\n113|\n114|// fixtureStore builds the standard provider store: two included\n115|// members, one credential member, and a nested directory.\n116|func fixtureStore(t *testing.T) string {\n117|\tt.Helper()\n118|\troot := t.TempDir()\n119|\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"alpha-payload-bytes\"))\n120|\twriteStoreFile(t, root, \"store/blob-b\", []byte(\"beta-payload-bytes\"))\n121|\twriteStoreFile(t, root, \"store/token-cache\", []byte(\"credential-secret-bytes\"))\n122|\treturn root\n123|}\n124|\n125|func fixturePlan() []PlanItem {\n126|\treturn []PlanItem{\n127|\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n128|\t\t{NativeKey: \"store/blob-b\", Class: \"durable_sidecar\", Required: true},\n129|\t\t{NativeKey: \"store/token-cache\", Class: \"credential\", Required: false},\n130|\t}\n131|}\n132|\n133|// fixtureWorkspace builds a real workspace tree and returns its\n134|// checkpoint request: the root, an existing nested cwd, one remote\n135|// fingerprint, a branch, and a head digest.\n136|func fixtureWorkspace(t *testing.T) WorkspaceRequest {\n137|\tt.Helper()\n138|\troot := t.TempDir()\n139|\tcwd := filepath.Join(root, \"work\", \"trees\", \"alpha\")\n140|\tif err := os.MkdirAll(cwd, 0o700); err != nil {\n141|\t\tt.Fatal(err)\n142|\t}\n143|\tbranch := \"main\"\n144|\thead := fixtureDigest(\"snap-head\")\n145|\treturn WorkspaceRequest{\n146|\t\tLogicalWorkspaceID: fixtureWorkspaceID,\n147|\t\tWorkspaceRoot:      root,\n148|\t\tCwd:                cwd,\n149|\t\tRemoteFingerprints: []string{fixtureDigest(\"snap-remote\")},\n150|\t\tBranch:             &branch,\n151|\t\tHeadDigest:         &head,\n152|\t\tPlatform:           fixturePlatform(),\n153|\t}\n154|}\n155|\n156|func fixtureSourceBasis() clonebundle.SourceBasisInput {\n157|\treturn clonebundle.SourceBasisInput{\n158|\t\tKind:                     \"ax_session\",\n159|\t\tSourceSessionID:          fixtureSessionID,\n160|\t\tSourceSessionRecordID:    fixtureDigest(\"snap-session-record\"),\n161|\t\tSourceCheckpointID:       fixtureDigest(\"snap-checkpoint\"),\n162|\t\tSourceProviderIdentityID: fixtureDigest(\"snap-provider-identity\"),\n163|\t}\n164|}\n165|\n166|func validCaptureRequest(t *testing.T, storeRoot string, store *localstore.ObjectStore) CaptureRequest {\n167|\tt.Helper()\n168|\treturn CaptureRequest{\n169|\t\tStoreRoot:         storeRoot,\n170|\t\tPlatform:          fixturePlatform(),\n171|\t\tPlan:              fixturePlan(),\n172|\t\tOperationID:       fixtureOperationID,\n173|\t\tBundleID:          fixtureBundleID,\n174|\t\tSourceBasis:       fixtureSourceBasis(),\n175|\t\tSourceEnvironment: []byte(fixtureTupleJSON()),\n176|\t\tSourceIdentity:    fixtureNativeIdentity(t),\n177|\t\tCapturePlanDigest: fixtureDigest(\"snap-capture-plan\"),\n178|\t\tNativeSessionID:   \"native-session-snap\",\n179|\t\tCreatedByHostID:   fixtureHostID,\n180|\t\tCreatedAt:         fixtureCreatedAt,\n181|\t\tGeneration:        \"generation-7\",\n182|\t\tProofKind:         \"closed_store\",\n183|\t\tInputBlocked:      true,\n184|\t\tForegroundIdle:    true,\n185|\t\tBackgroundIdle:    true,\n186|\t\tOperatorExplicit:  false,\n187|\t\tOnRace:            RaceRefuse,\n188|\t\tWorkspace:         fixtureWorkspace(t),\n189|\t\tStore:             store,\n190|\t}\n191|}\n192|\n193|// storedBlob is one content-addressed file observed under a store's\n194|// objects namespace.\n195|type storedBlob struct {\n196|\tdigest scalar.Digest\n197|\tbytes  []byte\n198|}\n199|\n200|// listStoredBlobs enumerates every blob file under the store's\n201|// objects namespace. It is the test-side oracle for what capture\n202|// published: production never lists the namespace.\n203|func listStoredBlobs(t *testing.T, store *localstore.ObjectStore) []storedBlob {\n204|\tt.Helper()\n205|\tobjects := filepath.Join(store.DataRoot(), \"objects\")\n206|\tvar blobs []storedBlob\n207|\terr := filepath.Walk(objects, func(path string, info os.FileInfo, err error) error {\n208|\t\tif err != nil {\n209|\t\t\tif os.IsNotExist(err) {\n210|\t\t\t\treturn nil\n211|\t\t\t}\n212|\t\t\treturn err\n213|\t\t}\n214|\t\tif info.IsDir() {\n215|\t\t\treturn nil\n216|\t\t}\n217|\t\traw, err := os.ReadFile(path)\n218|\t\tif err != nil {\n219|\t\t\tt.Fatalf(\"ReadFile(%q) error = %v\", path, err)\n220|\t\t}\n221|\t\tsum := sha256.Sum256(raw)\n222|\t\tdigest, err := scalar.ParseDigest(\"sha256:\" + hex.EncodeToString(sum[:]))\n223|\t\tif err != nil {\n224|\t\t\tt.Fatalf(\"ParseDigest() error = %v\", err)\n225|\t\t}\n226|\t\tblobs = append(blobs, storedBlob{digest: digest, bytes: raw})\n227|\t\treturn nil\n228|\t})\n229|\tif err != nil {\n230|\t\tt.Fatalf(\"Walk(objects) error = %v\", err)\n231|\t}\n232|\treturn blobs\n233|}\n234|\n235|// blobsContain reports whether any stored blob carries the needle.\n236|func blobsContain(blobs []storedBlob, needle string) bool {\n237|\tfor _, blob := range blobs {\n238|\t\tif strings.Contains(string(blob.bytes), needle) {\n239|\t\t\treturn true\n240|\t\t}\n241|\t}\n242|\treturn false\n243|}\n244|\n245|func mustCapture(t *testing.T, request CaptureRequest) *CaptureResult {\n246|\tt.Helper()\n247|\tresult, err := Capture(request)\n248|\tif err != nil {\n249|\t\tt.Fatalf(\"Capture() error = %v\", err)\n250|\t}\n251|\tif result == nil {\n252|\t\tt.Fatal(\"Capture() returned nil result without an error\")\n253|\t}\n254|\treturn result\n255|}\n256|\n257|// assertEveryRawBlobInstalled proves the Section 10.2 install rule\n258|// at the store: every raw-manifest entry's blob is present under\n259|// its content digest. A manifest that references a blob Capture\n260|// never installed fails here.\n261|func assertEveryRawBlobInstalled(t *testing.T, store *localstore.ObjectStore, raw clonebundle.RawObjectManifest) {\n262|\tt.Helper()\n263|\tif len(raw.Entries) == 0 {\n264|\t\tt.Fatal(\"raw manifest carries no entries\")\n265|\t}\n266|\tinstalled := map[string]bool{}\n267|\tfor _, blob := range listStoredBlobs(t, store) {\n268|\t\tinstalled[blob.digest.String()] = true\n269|\t}\n270|\tfor _, entry := range raw.Entries {\n271|\t\tif !installed[entry.BlobID.String()] {\n272|\t\t\tt.Fatalf(\"raw entry %q references blob %q with no installed blob\", entry.NativeItemKey, entry.BlobID)\n273|\t\t}\n274|\t}\n275|}","final_result":true}}}
