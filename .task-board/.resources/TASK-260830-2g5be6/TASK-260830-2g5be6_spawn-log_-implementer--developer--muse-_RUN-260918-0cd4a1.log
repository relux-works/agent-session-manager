{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7d7","stream":{"kind":"session","id":"01a0b2d0-7ac7-7f03-8c97-ccb0ee9decb3"},"sequence":582,"recorded_at":1780531400001159,"record_type":"event","durability":"durable","causation_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","run_stream":{"kind":"run","id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2"},"task_stream":{"kind":"task","id":"01a0b2d2-4756-7833-80bd-9b69d1ae97c7"},"task_id":"01a0b2d2-4756-7833-80bd-9b69d1ae97c7","event":{"kind":"output","task_id":"01a0b2d2-4756-7833-80bd-9b69d1ae97c7","chunk":"Read text file `internal/clonesnap/testdata/mutant_harness.py`.\n(499 line(s) above)\n500|    Mutant(\n501|        name=\"N-optional-blocked-ancestor\",\n502|        path=f\"{PACKAGE}/capture.go\",\n503|        find=\"\\t\\tif !present && !item.Required && !blockedAncestor(byKey, key) {\\n\",\n504|        replace=\"\\t\\tif !present && !item.Required {\\n\",\n505|        count=1,\n506|        run=\"TestCaptureRefusesOptionalSymlinkedIntermediate\",\n507|        expect=\"KILLED\",\n508|        note=\"Seals an optional member behind a symlinked intermediate as plan_optional_absent instead of routing it to the Guard refusal; required members still route to the Guard.\",\n509|    ),\n510|    Mutant(\n511|        name=\"N-post-fallback-captured\",\n512|        path=f\"{PACKAGE}/capture.go\",\n513|        find=(\n514|            \"\\t\\t\\tif !useCaptured {\\n\"\n515|            \"\\t\\t\\t\\tif payload, err := openMember(state.guard, state.root, member.key, state.limit); err == nil {\\n\"\n516|            \"\\t\\t\\t\\t\\trecord.addFile(member.key, uint64(len(payload)), contentHash(payload))\\n\"\n517|            \"\\t\\t\\t\\t\\tcontinue\\n\"\n518|            \"\\t\\t\\t\\t}\\n\"\n519|            \"\\t\\t\\t}\\n\"\n520|        ),\n521|        replace=(\n522|            \"\\t\\t\\tif !useCaptured {\\n\"\n523|            \"\\t\\t\\t\\tif payload, err := openMember(state.guard, state.root, member.key, state.limit); err == nil {\\n\"\n524|            \"\\t\\t\\t\\t\\trecord.addFile(member.key, uint64(len(payload)), contentHash(payload))\\n\"\n525|            \"\\t\\t\\t\\t\\tcontinue\\n\"\n526|            \"\\t\\t\\t\\t}\\n\"\n527|            \"\\t\\t\\t\\tfallback := false\\n\"\n528|            \"\\t\\t\\t\\tfor _, captured := range state.captured {\\n\"\n529|            \"\\t\\t\\t\\t\\tif captured.key == member.key {\\n\"\n530|            \"\\t\\t\\t\\t\\t\\trecord.addFile(member.key, captured.descriptor.Size, contentHash(captured.payload))\\n\"\n531|            \"\\t\\t\\t\\t\\t\\tfallback = true\\n\"\n532|            \"\\t\\t\\t\\t\\t}\\n\"\n533|            \"\\t\\t\\t\\t}\\n\"\n534|            \"\\t\\t\\t\\tif fallback {\\n\"\n535|            \"\\t\\t\\t\\t\\tcontinue\\n\"\n536|            \"\\t\\t\\t\\t}\\n\"\n537|            \"\\t\\t\\t}\\n\"\n538|        ),\n539|        count=1,\n540|        run=\"TestCaptureRaceUnreadableAtPost\",\n541|        expect=\"KILLED\",\n542|        note=\"A member unreadable at post time falls back to its captured hash instead of unknown content, so exactly the unreadable-at-post class misses the race; every re-readable member still compares fresh bytes.\",\n543|    ),\n544|    Mutant(\n545|        name=\"N-clonebundle-unknown-excluded\",\n546|        path=\"internal/clonebundle/capturebuild.go\",\n547|        find=(\n548|            \"\\tfor _, item := range items {\\n\"\n549|            \"\\t\\tif item.Class == \\\"unknown\\\" {\\n\"\n550|            \"\\t\\t\\treturn true\\n\"\n551|            \"\\t\\t}\\n\"\n552|            \"\\t}\\n\"\n553|            \"\\treturn false\\n\"\n554|            \"}\\n\"\n555|        ),\n556|        replace=(\n557|            \"\\tfor _, item := range items {\\n\"\n558|            \"\\t\\tif item.Class == \\\"unknown\\\" && item.Included() {\\n\"\n559|            \"\\t\\t\\treturn true\\n\"\n560|            \"\\t\\t}\\n\"\n561|            \"\\t}\\n\"\n562|            \"\\treturn false\\n\"\n563|            \"}\\n\"\n564|        ),\n565|        count=1,\n566|        run=\"TestCaptureOptionalAbsentUnknownMakesRawIncomplete\",\n567|        expect=\"KILLED\",\n568|        note=\"P3-ε: the plant lives in clonebundle (hasUnknownClass ignores excluded items) while the killer lives here — an excluded unknown item must still drive raw_complete=false and block maximal_safe at this leaf's projection entry.\",\n569|    ),\n570|    Mutant(\n571|        name=\"N-excluded-orphan-blob\",\n572|        path=f\"{PACKAGE}/capture.go\",\n573|        find=(\n574|            \"\\t\\tif excludedClass(item.Class) {\\n\"\n575|            \"\\t\\t\\tstate.log.Linef(\\\"exclude member=%q class=%s reason=%s\\\", key, item.Class, exclusionReason(item.Class))\\n\"\n576|            \"\\t\\t\\tcontinue\\n\"\n577|            \"\\t\\t}\\n\"\n578|        ),\n579|        replace=(\n580|            \"\\t\\tif excludedClass(item.Class) {\\n\"\n581|            \"\\t\\t\\tstate.log.Linef(\\\"exclude member=%q class=%s reason=%s\\\", key, item.Class, exclusionReason(item.Class))\\n\"\n582|            \"\\t\\t\\tif leaked, leakErr := openMember(state.guard, state.root, key, state.limit); leakErr == nil {\\n\"\n583|            \"\\t\\t\\t\\tif leakDescriptor, descErr := BuildBlobDescriptor(leaked); descErr == nil {\\n\"\n584|            \"\\t\\t\\t\\t\\t_, _ = clonebundle.InstallRawBlob(state.request.Store, leakDescriptor.Descriptor, bytes.NewReader(leaked))\\n\"\n585|            \"\\t\\t\\t\\t}\\n\"\n586|            \"\\t\\t\\t}\\n\"\n587|            \"\\t\\t\\tcontinue\\n\"\n588|            \"\\t\\t}\\n\"\n589|        ),\n590|        count=1,\n591|        run=\"TestCaptureExcludesSecrets\",\n592|        expect=\"KILLED\",\n593|        note=\"P3-ε′ (add-write, not a narrowing): installs excluded bytes as an orphan blob with no manifest entry and no log line, so the killer's blob scan — not a builder refusal — must catch the leak.\",\n594|    ),\n595|    Mutant(\n596|        name=\"C-doc-comment\",\n597|        path=f\"{PACKAGE}/doc.go\",\n598|        find=\"// Authority: relux-works/agent-session-manager-spec@v0.7.0, Sections\\n\",\n599|        replace=\"// Authority: relux-works/agent-session-manager-spec@v0.7.0, Sections (control).\\n\",\n600|        count=1,\n601|        run=\"TestDefaultMaxSingleBytesIs128GiB\",\n602|        expect=\"SURVIVED\",\n603|        note=\"Harmless control: a comment-only edit must survive.\",\n604|    ),\n605|]\n606|\n607|\n608|def run_mutant(mutant: Mutant) -> tuple[str, str, int, float]:\n609|    target = REPO / mutant.path\n610|    original = target.read_text()\n611|    found = original.count(mutant.find)\n612|    if found != mutant.count:\n613|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\", \"\", -1, 0.0\n614|    with tempfile.TemporaryDirectory() as staging:\n615|        backup = Path(staging) / \"backup\"\n616|        shutil.copy2(target, backup)\n617|        try:\n618|            target.write_text(original.replace(mutant.find, mutant.replace))\n619|            started = time.time()\n620|            run = subprocess.run(\n621|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n622|                cwd=REPO,\n623|                capture_output=True,\n624|                text=True,\n625|                timeout=300,\n626|            )\n627|            elapsed = time.time() - started\n628|        finally:\n629|            shutil.copy2(backup, target)\n630|    output = (run.stdout + run.stderr).strip()\n631|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n632|        return f\"ERROR: {mutant.name}: build broke under the patch\", output, run.returncode, elapsed\n633|    if run.returncode == 0:\n634|        verdict = \"SURVIVED\"\n635|    elif '--- FAIL' in output or 'FAIL:' in output:\n636|        verdict = \"KILLED\"\n637|    else:\n638|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\", output, run.returncode, elapsed\n639|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n640|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note}\", output, run.returncode, elapsed\n641|\n642|\n643|def main(argv: list[str]) -> int:\n644|    log_dir: Path | None = None\n645|    selected_names: list[str] = []\n646|    args = list(argv)\n647|    while args:\n648|        if args[0] == \"--log-dir\":\n649|            if len(args) < 2:\n650|                print(\"missing directory for --log-dir\")\n651|                return 2\n652|            log_dir = Path(args[1])\n653|            args = args[2:]\n654|        else:\n655|            selected_names.append(args[0])\n656|            args = args[1:]\n657|    selected = [m for m in MUTANTS if not selected_names or m.name in selected_names]\n658|    if selected_names and len(selected) != len(selected_names):\n659|        unknown = sorted(set(selected_names) - {m.name for m in selected})\n660|        print(f\"unknown mutants: {', '.join(unknown)}\")\n661|        return 2\n662|    if log_dir is not None:\n663|        log_dir.mkdir(parents=True, exist_ok=True)\n664|    failures = 0\n665|    for mutant in selected:\n666|        try:\n667|            line, output, exit_code, elapsed = run_mutant(mutant)\n668|        except subprocess.TimeoutExpired:\n669|            line, output, exit_code, elapsed = f\"ERROR: {mutant.name}: killer timed out\", \"\", -1, 0.0\n670|        print(line, flush=True)\n671|        if log_dir is not None:\n672|            (log_dir / f\"{mutant.name}.log\").write_text(\n673|                f\"# mutant={mutant.name} path={mutant.path} -run={mutant.run}\\n\"\n674|                f\"# exit={exit_code} elapsed={elapsed:.1f}s\\n\"\n675|                f\"# find={mutant.find!r}\\n# replace={mutant.replace!r}\\n---\\n{output}\\n\"\n676|            )\n677|        if not line.startswith(\"ok:\"):\n678|            failures += 1\n679|    return 1 if failures else 0\n680|\n681|\n682|if __name__ == \"__main__\":\n683|    sys.exit(main(sys.argv[1:]))","final_result":true}}}
