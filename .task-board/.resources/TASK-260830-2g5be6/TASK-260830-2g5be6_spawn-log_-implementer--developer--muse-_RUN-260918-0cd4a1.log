{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cad9","stream":{"kind":"session","id":"01a0b2d0-7ac7-7f03-8c97-ccb0ee9decb3"},"sequence":967,"recorded_at":1780531400001929,"record_type":"event","durability":"durable","causation_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","run_stream":{"kind":"run","id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2"},"task_stream":{"kind":"task","id":"01a0b2d5-2ce6-71c1-b965-d5456ea7ebfa"},"task_id":"01a0b2d5-2ce6-71c1-b965-d5456ea7ebfa","event":{"kind":"output","task_id":"01a0b2d5-2ce6-71c1-b965-d5456ea7ebfa","chunk":"Read text file `internal/clonesnap/race.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"fmt\"\n7|\t\"sort\"\n8|\t\"strconv\"\n9|\t\"strings\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|)\n14|\n15|// This file owns the source-race record: the canonical digest over\n16|// every enumerated store member that the pre and post capture\n17|// measurements compare. Included-class members contribute their key,\n18|// size, and content hash; excluded-class members contribute key and\n19|// size only, because their bytes are never opened; directories\n20|// contribute their keys, so an appended record is a detected\n21|// mutation. Size equality is never proof: the comparison is digest\n22|// equality over content hashes through the landed CheckDigestsEqual.\n23|\n24|// sourceRecord is one canonical source listing: sorted unique lines,\n25|// one per enumerated member.\n26|type sourceRecord struct {\n27|\tlines []string\n28|}\n29|\n30|func recordFileLine(key string, size uint64, content string) string {\n31|\treturn key + \"\\x00\" + string(memberFile) + \"\\x00\" + strconv.FormatUint(size, 10) + \"\\x00\" + content\n32|}\n33|\n34|func recordDirLine(key string) string {\n35|\treturn key + \"\\x00\" + string(memberDir) + \"\\x00\" + \"0\" + \"\\x00\" + \"-\"\n36|}\n37|\n38|func recordOtherLine(key string) string {\n39|\treturn key + \"\\x00\" + string(memberOther) + \"\\x00\" + \"0\" + \"\\x00\" + \"-\"\n40|}\n41|\n42|// addFile records one regular member: content is the hex content\n43|// hash for included members and \"-\" for excluded members, whose\n44|// bytes are never read.\n45|func (record *sourceRecord) addFile(key string, size uint64, content string) {\n46|\trecord.lines = append(record.lines, recordFileLine(key, size, content))\n47|}\n48|\n49|func (record *sourceRecord) addDir(key string) {\n50|\trecord.lines = append(record.lines, recordDirLine(key))\n51|}\n52|\n53|func (record *sourceRecord) addOther(key string) {\n54|\trecord.lines = append(record.lines, recordOtherLine(key))\n55|}\n56|\n57|// digest seals the record: the lines sort and join deterministically,\n58|// so identical sources seal identical digests.\n59|func (record *sourceRecord) digest() scalar.Digest {\n60|\tlines := append([]string(nil), record.lines...)\n61|\tsort.Strings(lines)\n62|\tsum := sha256.Sum256([]byte(strings.Join(lines, \"\\n\")))\n63|\tdigest, err := scalar.ParseDigest(\"sha256:\" + hex.EncodeToString(sum[:]))\n64|\tif err != nil {\n65|\t\tpanic(fmt.Sprintf(\"clonesnap: source record digest is not a digest: %v\", err))\n66|\t}\n67|\treturn digest\n68|}\n69|\n70|// contentHash is the hex content hash one record line carries for an\n71|// included member.\n72|func contentHash(payload []byte) string {\n73|\tsum := sha256.Sum256(payload)\n74|\treturn hex.EncodeToString(sum[:])\n75|}\n76|\n77|// checkSourceRace compares the pre and post source digests through\n78|// the landed equality gate. Equal sizes with differing bytes refuse:\n79|// the gate compares content digests, never sizes. The refusal names\n80|// the first differing member alongside the two digests; it never\n81|// carries source bytes.\n82|func checkSourceRace(pre, post scalar.Digest, preLines, postLines []string) error {\n83|\tif err := clonebundle.CheckDigestsEqual(pre, post); err != nil {\n84|\t\treturn invalid(\"source mutated during capture: member %q changed: %v\", firstChangedMember(preLines, postLines), err)\n85|\t}\n86|\treturn nil\n87|}\n88|\n89|// firstChangedMember names one member whose record line differs\n90|// between the pre and post listings: an appended, removed, resized,\n91|// retyped, or content-changed member. The listings compared equal as\n92|// sets only when the digests agree, so a mismatch always names a\n93|// member; the fallback names the record, never nothing.\n94|func firstChangedMember(preLines, postLines []string) string {\n95|\tpre := make(map[string]bool, len(preLines))\n96|\tfor _, line := range preLines {\n97|\t\tpre[line] = true\n98|\t}\n99|\tpost := make(map[string]bool, len(postLines))\n100|\tfor _, line := range postLines {\n101|\t\tpost[line] = true\n102|\t}\n103|\tfor _, line := range postLines {\n104|\t\tif !pre[line] {\n105|\t\t\tif key, _, found := strings.Cut(line, \"\\x00\"); found {\n106|\t\t\t\treturn key\n107|\t\t\t}\n108|\t\t\treturn \"source record\"\n109|\t\t}\n110|\t}\n111|\tfor _, line := range preLines {\n112|\t\tif !post[line] {\n113|\t\t\tif key, _, found := strings.Cut(line, \"\\x00\"); found {\n114|\t\t\t\treturn key\n115|\t\t\t}\n116|\t\t\treturn \"source record\"\n117|\t\t}\n118|\t}\n119|\treturn \"source record\"\n120|}","final_result":true}}}
