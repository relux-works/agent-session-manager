{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca0d","stream":{"kind":"session","id":"01a0b2d0-7ac7-7f03-8c97-ccb0ee9decb3"},"sequence":865,"recorded_at":1780531400001725,"record_type":"event","durability":"durable","causation_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","run_stream":{"kind":"run","id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2"},"task_stream":{"kind":"task","id":"01a0b2d3-cb9e-7031-99aa-401973b155d6"},"task_id":"01a0b2d3-cb9e-7031-99aa-401973b155d6","event":{"kind":"output","task_id":"01a0b2d3-cb9e-7031-99aa-401973b155d6","chunk":"{\n  \"chunk_id\": \"exec-19-1\",\n  \"command\": \"sed -n 1,60p internal/clonebundle/generation.go\\necho ===\\npython3 -c \\\"import json; c=json.load(open('task-board.config.json')); cmds=c.get('validation',c).get('commands',None) if isinstance(c.get('validation',None),dict) else None; print(type(c)); print(list(c.keys()))\\\" 2>&1 | head\\necho ===\\ngrep -c \\\"command\\\" task-board.config.json 2>&1; head -c 2000 task-board.config.json\",\n  \"description\": \"Check generation type and validation config\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"package clonebundle\\n\\nimport (\\n\\t\\\"encoding/json\\\"\\n\\n\\t\\\"github.com/relux-works/agent-session-manager/internal/scalar\\\"\\n)\\n\\n// This file owns the Section 13.14.1 immutable generations: the\\n// source_generation strings carried by StableSnapshotProof and the\\n// unstable-archive Capture Boundary, and the snapshot-identity digest\\n// that pins an immutable snapshot. Generations are opaque immutable\\n// tokens: a generation never mutates, and equality is exact string\\n// equality. Capture digests that must agree (stable pre/post) are\\n// compared by digest equality here so both boundary validators share\\n// one comparison.\\n\\n// Generation is one validated immutable source generation token:\\n// string[1..512], opaque to the core.\\ntype Generation struct {\\n\\tvalue string\\n}\\n\\n// ParseGeneration validates one generation token. Empty,\\n// over-long, and invalid-UTF-8 tokens are refused; every other text\\n// content crosses opaquely, because generations are native-store\\n// tokens the core compares but never interprets. The UTF-8 gate\\n// matters because the token seals into the boundary bytes: without\\n// it the marshaler would rewrite invalid bytes to U+FFFD and two\\n// distinct generations would seal byte-identical.\\nfunc ParseGeneration(value string) (Generation, error) {\\n\\tif !validText(value) {\\n\\t\\treturn Generation{}, invalid(\\\"source generation is not valid UTF-8\\\")\\n\\t}\\n\\tif stringLength(value) < 1 || stringLength(value) > 512 {\\n\\t\\treturn Generation{}, invalid(\\\"source generation is not a string[1..512]\\\")\\n\\t}\\n\\treturn Generation{value: value}, nil\\n}\\n\\n// MustParseGeneration validates one generation token and panics on\\n// refusal. Tests and fixed fixtures use it; production paths use\\n// ParseGeneration and return the refusal.\\nfunc MustParseGeneration(value string) Generation {\\n\\tgeneration, err := ParseGeneration(value)\\n\\tif err != nil {\\n\\t\\tpanic(err)\\n\\t}\\n\\treturn generation\\n}\\n\\nfunc (generation Generation) String() string { return generation.value }\\n\\n// Equal reports exact generation equality. Generations are\\n// immutable: two captures name the same source state if and only if\\n// their tokens are byte-identical.\\nfunc (generation Generation) Equal(other Generation) bool {\\n\\treturn generation.value == other.value\\n}\\n\\n===\\n<class 'dict'>\\n['mode', 'local', 'version_control', 'spawn', 'features']\\n===\\n1\\n{\\n  \\\"mode\\\": \\\"local\\\",\\n  \\\"local\\\": {\\n    \\\"board_dir\\\": \\\".task-board\\\"\\n  },\\n  \\\"version_control\\\": {\\n    \\\"confirm\\\": true,\\n    \\\"desired_commit_time\\\": \\\"current real time; AX does not backdate commits\\\"\\n  },\\n  \\\"spawn\\\": {\\n    \\\"enabled\\\": true,\\n    \\\"max_parallel\\\": 20,\\n    \\\"ceilings\\\": {\\n      \\\"contract_version\\\": \\\"spawn-policy-v4\\\",\\n      \\\"codex\\\": {\\n        \\\"entries\\\": [\\n          {\\n            \\\"criterion\\\": \\\"equal\\\",\\n            \\\"model\\\": \\\"gpt-6-astra\\\",\\n            \\\"reasoning_effort\\\": \\\"medium\\\"\\n          },\\n          {\\n            \\\"criterion\\\": \\\"equal\\\",\\n            \\\"model\\\": \\\"gpt-6-astra\\\",\\n            \\\"reasoning_effort\\\": \\\"high\\\"\\n          }\\n        ],\\n        \\\"resolution_model\\\": \\\"gpt-6-astra\\\",\\n        \\\"adjustment_confirmation\\\": \\\"none\\\",\\n        \\\"fast_mode\\\": true,\\n        \\\"roles\\\": {\\n          \\\"reviewer\\\": {\\n            \\\"entries\\\": [\\n              {\\n                \\\"criterion\\\": \\\"equal\\\",\\n                \\\"model\\\": \\\"gpt-6-astra\\\",\\n                \\\"reasoning_effort\\\": \\\"low\\\"\\n              },\\n              {\\n                \\\"criterion\\\": \\\"equal\\\",\\n                \\\"model\\\": \\\"gpt-6-astra\\\",\\n                \\\"reasoning_effort\\\": \\\"medium\\\"\\n              }\\n            ],\\n            \\\"resolution_model\\\": \\\"gpt-6-astra\\\",\\n            \\\"adjustment_confirmation\\\": \\\"none\\\",\\n            \\\"default_model\\\": \\\"gpt-6-astra\\\",\\n            \\\"default_reasoning_effort\\\": \\\"low\\\"\\n          },\\n          \\\"developer\\\": {\\n            \\\"entries\\\": [\\n              {\\n                \\\"criterion\\\": \\\"equal\\\",\\n                \\\"model\\\": \\\"gpt-6-astra\\\",\\n                \\\"reasoning_effort\\\": \\\"medium\\\"\\n              },\\n              {\\n                \\\"criterion\\\": \\\"equal\\\",\\n                \\\"model\\\": \\\"gpt-6-astra\\\",\\n                \\\"reasoning_effort\\\": \\\"high\\\"\\n              },\\n              {\\n                \\\"criterion\\\": \\\"equal\\\",\\n                \\\"model\\\": \\\"gpt-5.6-luna\\\",\\n                \\\"reasoning_effort\\\": \\\"max\\\"\\n              }\\n            ],\\n            \\\"resolution_model\\\": \\\"gpt-6-astra\\\",\\n            \\\"adjustment_confirmation\\\": \\\"none\\\"\\n          }\\n        }\\n      },\\n      \\\"claud\",\n  \"original_output_bytes\": 4289,\n  \"original_output_tokens\": 1073,\n  \"truncated\": false\n}","final_result":true}}}
