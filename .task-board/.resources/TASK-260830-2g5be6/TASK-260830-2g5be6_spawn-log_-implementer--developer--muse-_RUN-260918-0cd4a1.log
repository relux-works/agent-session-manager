{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7d3","stream":{"kind":"session","id":"01a0b2d0-7ac7-7f03-8c97-ccb0ee9decb3"},"sequence":580,"recorded_at":1780531400001155,"record_type":"event","durability":"durable","causation_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","run_stream":{"kind":"run","id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2"},"task_stream":{"kind":"task","id":"01a0b2d2-4778-78c3-b57f-61fd3739bb3c"},"task_id":"01a0b2d2-4778-78c3-b57f-61fd3739bb3c","event":{"kind":"output","task_id":"01a0b2d2-4778-78c3-b57f-61fd3739bb3c","chunk":"Read text file `internal/clonesnap/walk.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"io\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"sort\"\n8|\t\"strings\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n13|)\n14|\n15|// This file owns the contained capture walk over a provider store\n16|// directory. Enumeration observes names only: every payload open\n17|// descends from the verified store-root handle through the landed\n18|// secprim Guard, so a symlinked intermediate component or a trailing\n19|// symlink refuses before any payload byte is read, and a FIFO,\n20|// directory, device, or socket refuses on its opened shape. Every\n21|// refusal names the member. The walk never escapes the store root:\n22|// nothing enumerated is opened except through the Guard on a\n23|// validated member name.\n24|//\n25|// The walk reads every included-class member twice — once for the\n26|// capture bytes and the pre digest, once for the post digest — and\n27|// enumerates the store twice. Any difference is a detected source\n28|// race, decided before any manifest is sealed. Excluded-class\n29|// members are never opened: their bytes cannot reach a blob, a\n30|// manifest, a log line, or an error string, because no read ever\n31|// observes them.\n32|\n33|// PlanItem is one capture-plan candidate: the native key the walk\n34|// must reconcile and the closed class that decides its disposition.\n35|// Required candidates must be present when their class is included;\n36|// optional included-class candidates absent from the store seal as\n37|// excluded rows instead of refusing.\n38|type PlanItem struct {\n39|\tNativeKey string\n40|\tClass     string\n41|\tRequired  bool\n42|}\n43|\n44|// memberKind is the observed shape of one enumerated store member.\n45|type memberKind string\n46|\n47|const (\n48|\tmemberFile  memberKind = \"file\"\n49|\tmemberDir   memberKind = \"dir\"\n50|\tmemberOther memberKind = \"other\"\n51|)\n52|\n53|// observedMember is one enumerated store member: its slash-separated\n54|// key beneath the store root, its observed shape, and its observed\n55|// size. Observation never opens a payload.\n56|type observedMember struct {\n57|\tkey  string\n58|\tkind memberKind\n59|\tsize uint64\n60|}\n61|\n62|// capturedMember is one walked included-class member: the bytes read\n63|// through the Guard and their sealed descriptor.\n64|type capturedMember struct {\n65|\tkey        string\n66|\tclass      string\n67|\tpayload    []byte\n68|\tdescriptor BlobDescriptor\n69|}\n70|\n71|// enumerateStore lists every store member beneath root as\n72|// slash-separated keys. It observes names, shapes, and sizes only;\n73|// it opens no payload. A failed observation is a refusal, never an\n74|// absence: a member that cannot be listed cannot be captured.\n75|func enumerateStore(root string) ([]observedMember, error) {\n76|\tvar members []observedMember\n77|\tvar descend func(relative string) error\n78|\tdescend = func(relative string) error {\n79|\t\tdirectory := root\n80|\t\tif relative != \"\" {\n81|\t\t\tdirectory = filepath.Join(root, filepath.FromSlash(relative))\n82|\t\t}\n83|\t\tentries, err := os.ReadDir(directory)\n84|\t\tif err != nil {\n85|\t\t\treturn invalid(\"capture cannot enumerate store member %q: %v\", relative, err)\n86|\t\t}\n87|\t\tfor _, entry := range entries {\n88|\t\t\tname := entry.Name()\n89|\t\t\tif name == \"\" || name == \".\" || name == \"..\" || strings.Contains(name, \"/\") || strings.Contains(name, `\\`) {\n90|\t\t\t\treturn invalid(\"capture store member %q is not a plain file name\", name)\n91|\t\t\t}\n92|\t\t\tkey := name\n93|\t\t\tif relative != \"\" {\n94|\t\t\t\tkey = relative + \"/\" + name\n95|\t\t\t}\n96|\t\t\tinfo, err := os.Lstat(filepath.Join(root, filepath.FromSlash(key)))\n97|\t\t\tif err != nil {\n98|\t\t\t\treturn invalid(\"capture cannot stat store member %q: %v\", key, err)\n99|\t\t\t}\n100|\t\t\tmode := info.Mode()\n101|\t\t\tswitch {\n102|\t\t\tcase mode.IsRegular():\n103|\t\t\t\tif info.Size() < 0 {\n104|\t\t\t\t\treturn invalid(\"capture store member %q has a negative size\", key)\n105|\t\t\t\t}\n106|\t\t\t\tmembers = append(members, observedMember{key: key, kind: memberFile, size: uint64(info.Size())})\n107|\t\t\tcase mode.IsDir():\n108|\t\t\t\tmembers = append(members, observedMember{key: key, kind: memberDir})\n109|\t\t\t\tif err := descend(key); err != nil {\n110|\t\t\t\t\treturn err\n111|\t\t\t\t}\n112|\t\t\tdefault:\n113|\t\t\t\tmembers = append(members, observedMember{key: key, kind: memberOther})\n114|\t\t\t}\n115|\t\t}\n116|\t\treturn nil\n117|\t}\n118|\tif err := descend(\"\"); err != nil {\n119|\t\treturn nil, err\n120|\t}\n121|\tsort.Slice(members, func(left, right int) bool { return members[left].key < members[right].key })\n122|\treturn members, nil\n123|}\n124|\n125|// checkPlan validates the whole capture plan before anything is\n126|// opened or installed: every key is sanitized, every class is in the\n127|// closed nine-class vocabulary, keys are sorted unique, and every\n128|// member name passes the containment grammar. A plan this gate\n129|// refuses leaves the store and the object sink untouched.\n130|func checkPlan(platform scalar.Platform, plan []PlanItem) (map[string]PlanItem, error) {\n131|\tbyKey := make(map[string]PlanItem, len(plan))\n132|\tprevious := \"\"\n133|\tfor index, item := range plan {\n134|\t\tif index > 0 && item.NativeKey <= previous {\n135|\t\t\treturn nil, invalid(\"capture plan keys are not sorted unique by native item key\")\n136|\t\t}\n137|\t\tprevious = item.NativeKey\n138|\t\tif err := clonebundle.SanitizeNativeKey(item.NativeKey); err != nil {\n139|\t\t\treturn nil, invalid(\"capture plan key %q: %v\", item.NativeKey, err)\n140|\t\t}\n141|\t\tif err := secprim.CheckMemberPath(platform, item.NativeKey); err != nil {\n142|\t\t\treturn nil, invalid(\"capture plan key %q escapes the store root: %v\", item.NativeKey, err)\n143|\t\t}\n144|\t\tif !clonebundle.ValidCaptureClass(item.Class) {\n145|\t\t\treturn nil, invalid(\"capture plan key %q carries class %q outside the nine-class vocabulary\", item.NativeKey, item.Class)\n146|\t\t}\n147|\t\tbyKey[item.NativeKey] = item\n148|\t}\n149|\treturn byKey, nil\n150|}\n151|\n152|// excludedClass reports whether the class is always excluded:\n153|// credential, machine-auth, runtime-state, and transient-lock rows\n154|// are never included and their bytes are never opened.\n155|func excludedClass(class string) bool {\n156|\tswitch class {\n157|\tcase \"credential\", \"machine_auth\", \"runtime_state\", \"transient_lock\":\n158|\t\treturn true\n159|\tdefault:\n160|\t\treturn false\n161|\t}\n162|}\n163|\n164|// exclusionReason is the stable exclusion reason sealed for an\n165|// always-excluded class.\n166|func exclusionReason(class string) string {\n167|\treturn class + \"_excluded\"\n168|}\n169|\n170|// openMember opens one planned member through the store Guard and\n171|// returns its bytes. The Guard refuses symlink escapes before any\n172|// payload byte is read and refuses non-regular shapes on the opened\n173|// descriptor; this wrapper names the member on every failure. The\n174|// limit refuses oversized members with capability_unavailable before\n175|// their bytes are read, so no manifest is ever published over a\n176|// member this package cannot carry.\n177|func openMember(guard secprim.Guard, root *os.File, member string, limit uint64) ([]byte, error) {\n178|\tfile, err := guard.Open(root, member)\n179|\tif err != nil {\n180|\t\treturn nil, invalid(\"capture member %q: %v\", member, err)\n181|\t}\n182|\tdefer func() { _ = file.Close() }()\n183|\tinfo, err := file.Stat()\n184|\tif err != nil {\n185|\t\treturn nil, invalid(\"capture member %q cannot be stated: %v\", member, err)\n186|\t}\n187|\tif info.Size() < 0 {\n188|\t\treturn nil, invalid(\"capture member %q has a negative size\", member)\n189|\t}\n190|\tif uint64(info.Size()) > limit {\n191|\t\treturn nil, invalid(\"capture member %q of %d bytes exceeds the %d byte bound: capability_unavailable\", member, info.Size(), limit)\n192|\t}\n193|\tpayload, err := io.ReadAll(io.LimitReader(file, int64(limit)+1))\n194|\tif err != nil {\n195|\t\treturn nil, invalid(\"capture member %q cannot be read: %v\", member, err)\n196|\t}\n197|\tif uint64(len(payload)) != uint64(info.Size()) {\n198|\t\treturn nil, invalid(\"capture member %q changed size during its read: source_not_quiescent\", member)\n199|\t}\n200|\treturn payload, nil\n201|}\n202|\n203|// planMemberClass resolves the planned class for one enumerated key.\n204|// The lookup is exact: a key that merely shares a prefix with a\n205|// planned key is unplanned, and an unplanned store member refuses\n206|// capture before any manifest is sealed, because silently dropping\n207|// source bytes would forge completeness.\n208|func planMemberClass(plan map[string]PlanItem, key string) (string, error) {\n209|\titem, planned := plan[key]\n210|\tif !planned {\n211|\t\treturn \"\", invalid(\"capture store member %q is not a plan candidate\", key)\n212|\t}\n213|\treturn item.Class, nil\n214|}\n215|\n216|// intermediatePrefix reports whether the observed other stands on\n217|// the path of a planned key: a symlink or special that a nested\n218|// member traverses. Its refusal belongs to the planned member's\n219|// Guard open — which names the full member — not to the plan gate.\n220|func intermediatePrefix(plan map[string]PlanItem, key string) bool {\n221|\tprefix := key + \"/\"\n222|\tfor planned := range plan {\n223|\t\tif strings.HasPrefix(planned, prefix) {\n224|\t\t\treturn true\n225|\t\t}\n226|\t}\n227|\treturn false\n228|}\n229|\n230|// blockedAncestor reports whether a strict directory prefix of the\n231|// key was observed as a non-directory: a symlink, special, or file\n232|// standing where the Guard must descend. The planned member routes\n233|// to its Guard open, which refuses with the full member named,\n234|// instead of reporting the unobserved member absent.\n235|func blockedAncestor(observed map[string]observedMember, key string) bool {\n236|\tfor offset := 0; offset < len(key); offset++ {\n237|\t\tif key[offset] != '/' {\n238|\t\t\tcontinue\n239|\t\t}\n240|\t\tif member, ok := observed[key[:offset]]; ok && member.kind != memberDir {\n241|\t\t\treturn true\n242|\t\t}\n243|\t}\n244|\treturn false\n245|}","final_result":true}}}
