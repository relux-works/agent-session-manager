{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c795","stream":{"kind":"session","id":"01a0b2d0-7ac7-7f03-8c97-ccb0ee9decb3"},"sequence":549,"recorded_at":1780531400001093,"record_type":"event","durability":"durable","causation_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","run_stream":{"kind":"run","id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2"},"task_stream":{"kind":"task","id":"01a0b2d2-3771-7d43-877d-c2ad43e66041"},"task_id":"01a0b2d2-3771-7d43-877d-c2ad43e66041","event":{"kind":"output","task_id":"01a0b2d2-3771-7d43-877d-c2ad43e66041","chunk":"Read text file `internal/clonesnap/testdata/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for internal/clonesnap.\n3|\n4|Every gate ships a narrowing mutant: the gate stays present and is\n5|weakened to admit exactly one member of the class it must reject, and\n6|the named killer test must fail. A delete-only mutant proves only that\n7|the gate exists and is not accepted as evidence.\n8|\n9|Each row runs M (mutate one production file in place), R (run the\n10|scoped Go killer through the production entry point), V (verdict from\n11|the Go exit code plus a FAIL kill-line: KILLED iff R fails with a test\n12|failure line, SURVIVED iff R passes, ERROR for anything else —\n13|unapplied patches, build breaks, timeouts). M failures and R\n14|infrastructure errors are ERROR, never kills or survivals. The file is\n15|restored from its backup after every row, pass or fail.\n16|\n17|Row N-plan-prefix is the token-preserving text mutant: the plan\n18|lookup keeps comparing against the planned keys but changes exact\n19|match to prefix match, and its killer drives the full Capture entry\n20|(the behavioral suite), not a static checker.\n21|\n22|Row C-doc-comment is the harmless control: a comment-only edit that\n23|must SURVIVE, proving the harness observes test outcomes instead of\n24|hard-coding kills.\n25|\n26|Usage:\n27|  PYTHONDONTWRITEBYTECODE=1 python3 internal/clonesnap/testdata/mutant_harness.py [--log-dir DIR] [MUTANT ...]\n28|\"\"\"\n29|\n30|import shutil\n31|import subprocess\n32|import sys\n33|import tempfile\n34|import time\n35|from dataclasses import dataclass\n36|from pathlib import Path\n37|\n38|REPO = Path(__file__).resolve().parents[3]\n39|PACKAGE = \"internal/clonesnap\"\n40|\n41|OPEN_MEMBER_HEAD = (\n42|    \"func openMember(guard secprim.Guard, root *os.File, member string, limit uint64) ([]byte, error) {\\n\"\n43|    \"\\tfile, err := guard.Open(root, member)\\n\"\n44|)\n45|\n46|PLAN_LOOKUP = (\n47|    '\\titem, planned := plan[key]\\n'\n48|    '\\tif !planned {\\n'\n49|    '\\t\\treturn \"\", invalid(\"capture store member %q is not a plan candidate\", key)\\n'\n50|    '\\t}\\n'\n51|    '\\treturn item.Class, nil\\n'\n52|)\n53|\n54|\n55|@dataclass(frozen=True)\n56|class Mutant:\n57|    name: str\n58|    path: str\n59|    find: str\n60|    replace: str\n61|    count: int\n62|    run: str\n63|    expect: str\n64|    note: str\n65|\n66|\n67|MUTANTS = [\n68|    Mutant(\n69|        name=\"N-contain-trailing\",\n70|        path=f\"{PACKAGE}/walk.go\",\n71|        find=OPEN_MEMBER_HEAD,\n72|        replace=(\n73|            \"func openMember(guard secprim.Guard, root *os.File, member string, limit uint64) ([]byte, error) {\\n\"\n74|            '\\tif member == \"link-escape\" {\\n'\n75|            '\\t\\treturn []byte(\"mutant-escaped-bytes\"), nil\\n'\n76|            '\\t}\\n'\n77|            \"\\tfile, err := guard.Open(root, member)\\n\"\n78|        ),\n79|        count=1,\n80|        run=\"TestCaptureRefusesTrailingSymlink\",\n81|        expect=\"KILLED\",\n82|        note=\"Stands forged bytes in for the Guard open of exactly link-escape; every other member still opens through the Guard.\",\n83|    ),\n84|    Mutant(\n85|        name=\"N-contain-intermediate\",\n86|        path=f\"{PACKAGE}/walk.go\",\n87|        find=OPEN_MEMBER_HEAD,\n88|        replace=(\n89|            \"func openMember(guard secprim.Guard, root *os.File, member string, limit uint64) ([]byte, error) {\\n\"\n90|            '\\tif member == \"link-escape/file\" {\\n'\n91|            '\\t\\treturn []byte(\"mutant-escaped-bytes\"), nil\\n'\n92|            '\\t}\\n'\n93|            \"\\tfile, err := guard.Open(root, member)\\n\"\n94|        ),\n95|        count=1,\n96|        run=\"TestCaptureRefusesSymlinkedIntermediate\",\n97|        expect=\"KILLED\",\n98|        note=\"Stands forged bytes in for the Guard open of exactly link-escape/file; every other member still opens through the Guard.\",\n99|    ),\n100|    Mutant(\n101|        name=\"N-fifo\",\n102|        path=f\"{PACKAGE}/walk.go\",\n103|        find=OPEN_MEMBER_HEAD,\n104|        replace=(\n105|            \"func openMember(guard secprim.Guard, root *os.File, member string, limit uint64) ([]byte, error) {\\n\"\n106|            '\\tif member == \"stash-fifo\" {\\n'\n107|            '\\t\\treturn []byte(\"mutant-fifo-bytes\"), nil\\n'\n108|            '\\t}\\n'\n109|            \"\\tfile, err := guard.Open(root, member)\\n\"\n110|        ),\n111|        count=1,\n112|        run=\"TestCaptureRefusesFIFO\",\n113|        expect=\"KILLED\",\n114|        note=\"Stands forged bytes in for the Guard open of exactly stash-fifo; every other member still opens through the Guard.\",\n115|    ),\n116|    Mutant(\n117|        name=\"N-unplanned\",\n118|        path=f\"{PACKAGE}/walk.go\",\n119|        find=PLAN_LOOKUP,\n120|        replace=(\n121|            '\\titem, planned := plan[key]\\n'\n122|            '\\tif !planned && key != \"store/zz-extra\" {\\n'\n123|            '\\t\\treturn \"\", invalid(\"capture store member %q is not a plan candidate\", key)\\n'\n124|            '\\t}\\n'\n125|            '\\tif !planned {\\n'\n126|            '\\t\\treturn \"durable_payload\", nil\\n'\n127|            '\\t}\\n'\n128|            '\\treturn item.Class, nil\\n'\n129|        ),\n130|        count=1,\n131|        run=\"TestCaptureRefusesUnplannedMember\",\n132|        expect=\"KILLED\",\n133|        note=\"Admits exactly store/zz-extra past the plan gate as durable_payload; every other unplanned key still refuses.\",\n134|    ),\n135|    Mutant(\n136|        name=\"N-plan-prefix\",\n137|        path=f\"{PACKAGE}/walk.go\",\n138|        find=PLAN_LOOKUP,\n139|        replace=(\n140|            '\\tfor plannedKey, plannedItem := range plan {\\n'\n141|            '\\t\\tif strings.HasPrefix(key, plannedKey) {\\n'\n142|            '\\t\\t\\treturn plannedItem.Class, nil\\n'\n143|            '\\t\\t}\\n'\n144|            '\\t}\\n'\n145|            '\\treturn \"\", invalid(\"capture store member %q is not a plan candidate\", key)\\n'\n146|        ),\n147|        count=1,\n148|        run=\"TestCaptureRefusesPrefixSibling\",\n149|        expect=\"KILLED\",\n150|        note=\"TOKEN-PRESERVING: the lookup still compares against the planned keys but admits prefix matches, so store/blob-a-evil rides on store/blob-a. The killer drives the full Capture entry.\",\n151|    ),\n152|    Mutant(\n153|        name=\"N-plan-order\",\n154|        path=f\"{PACKAGE}/walk.go\",\n155|        find=\"\\t\\tif index > 0 && item.NativeKey <= previous {\\n\",\n156|        replace=\"\\t\\tif index > 0 && item.NativeKey < previous {\\n\",\n157|        count=1,\n158|        run=\"TestCaptureRefusesDuplicatePlanKey\",\n159|        expect=\"KILLED\",\n160|        note=\"Admits exactly duplicate plan keys; unsorted keys still refuse with the plan detail.\",\n161|    ),\n162|    Mutant(\n163|        name=\"N-plan-sanitize\",\n164|        path=f\"{PACKAGE}/walk.go\",\n165|        find=\"\\t\\tif err := clonebundle.SanitizeNativeKey(item.NativeKey); err != nil {\\n\",\n166|        replace='\\t\\tif err := clonebundle.SanitizeNativeKey(item.NativeKey); err != nil && item.NativeKey != \"0198f4d1-9e60-7f66-8f86-f0123456789a\" {\\n',\n167|        count=1,\n168|        run=\"TestCaptureRefusesUnsanitizedPlanKey\",\n169|        expect=\"KILLED\",\n170|        note=\"Admits exactly one UUIDv7 plan key past the sanitizer; every other unsanitized key still refuses. Token preserved.\",\n171|    ),\n172|    Mutant(\n173|        name=\"N-plan-class\",\n174|        path=f\"{PACKAGE}/walk.go\",\n175|        find=\"\\t\\tif !clonebundle.ValidCaptureClass(item.Class) {\\n\",\n176|        replace='\\t\\tif !clonebundle.ValidCaptureClass(item.Class) && item.Class != \"mystery\" {\\n',\n177|        count=1,\n178|        run=\"TestCaptureRefusesMysteryPlanClass\",\n179|        expect=\"KILLED\",\n180|        note=\"Admits exactly class mystery past the vocabulary gate; every other unknown class still refuses.\",\n181|    ),\n182|    Mutant(\n183|        name=\"N-exclude-credential\",\n184|        path=f\"{PACKAGE}/walk.go\",\n185|        find='\\tcase \"credential\", \"machine_auth\", \"runtime_state\", \"transient_lock\":\\n',\n186|        replace='\\tcase \"machine_auth\", \"runtime_state\", \"transient_lock\":\\n',\n187|        count=1,\n188|        run=\"TestCaptureExcludesSecrets\",\n189|        expect=\"KILLED\",\n190|        note=\"Admits exactly credential rows as included; the other three always-excluded classes still exclude.\",\n191|    ),\n192|    Mutant(\n193|        name=\"N-exclude-machine-auth\",\n194|        path=f\"{PACKAGE}/walk.go\",\n195|        find='\\tcase \"credential\", \"machine_auth\", \"runtime_state\", \"transient_lock\":\\n',\n196|        replace='\\tcase \"credential\", \"runtime_state\", \"transient_lock\":\\n',\n197|        count=1,\n198|        run=\"TestCaptureExcludesSecrets\",\n199|        expect=\"KILLED\",\n200|        note=\"Admits exactly machine_auth rows as included; the other three always-excluded classes still exclude.\",\n201|    ),\n202|    Mutant(\n203|        name=\"N-exclude-runtime-state\",\n204|        path=f\"{PACKAGE}/walk.go\",\n205|        find='\\tcase \"credential\", \"machine_auth\", \"runtime_state\", \"transient_lock\":\\n',\n206|        replace='\\tcase \"credential\", \"machine_auth\", \"transient_lock\":\\n',\n207|        count=1,\n208|        run=\"TestCaptureExcludesSecrets\",\n209|        expect=\"KILLED\",\n210|        note=\"Admits exactly runtime_state rows as included; the other three always-excluded classes still exclude.\",\n211|    ),\n212|    Mutant(\n213|        name=\"N-exclude-transient-lock\",\n214|        path=f\"{PACKAGE}/walk.go\",\n215|        find='\\tcase \"credential\", \"machine_auth\", \"runtime_state\", \"transient_lock\":\\n',\n216|        replace='\\tcase \"credential\", \"machine_auth\", \"runtime_state\":\\n',\n217|        count=1,\n218|        run=\"TestCaptureExcludesSecrets\",\n219|        expect=\"KILLED\",\n220|        note=\"Admits exactly transient_lock rows as included; the other three always-excluded classes still exclude.\",\n221|    ),\n222|    Mutant(\n223|        name=\"N-required\",\n224|        path=f\"{PACKAGE}/capture.go\",\n225|        find=\"\\t\\tif !present && item.Required && !blockedAncestor(byKey, key) {\\n\",\n226|        replace='\\t\\tif !present && item.Required && key != \"store/must-have\" && !blockedAncestor(byKey, key) {\\n',\n227|        count=1,\n228|        run=\"TestCaptureRefusesRequiredMissing\",\n229|        expect=\"KILLED\",\n230|        note=\"Admits exactly store/must-have past the required-absent refusal; every other required-absent candidate still refuses.\",\n231|    ),\n232|    Mutant(\n233|        name=\"N-optional\",\n234|        path=f\"{PACKAGE}/capture.go\",\n235|        find=\"\\t\\tif !present && !item.Required && !blockedAncestor(byKey, key) {\\n\",\n236|        replace='\\t\\tif !present && !item.Required && key != \"store/maybe\" && !blockedAncestor(byKey, key) {\\n',\n237|        count=1,\n238|        run=\"TestCaptureOptionalAbsentSealsExcluded\",\n239|        expect=\"KILLED\",\n240|        note=\"Refuses exactly the optional-absent store/maybe that must seal as excluded; every other optional-absent still seals.\",\n241|    ),\n242|    Mutant(\n243|        name=\"N-race-narrow\",\n244|        path=f\"{PACKAGE}/race.go\",\n245|        find=\"\\tif err := clonebundle.CheckDigestsEqual(pre, post); err != nil {\\n\",\n246|        replace='\\tif err := clonebundle.CheckDigestsEqual(pre, post); err != nil && firstChangedMember(preLines, postLines) != \"store/blob-a\" {\\n',\n247|        count=1,\n248|        run=\"TestCaptureRaceChangedByte\",\n249|        expect=\"KILLED\",\n250|        note=\"Ignores exactly races naming store/blob-a; races on every other member still refuse.\",\n251|    ),\n252|    Mutant(\n253|        name=\"N-race-order-capture\",\n254|        path=f\"{PACKAGE}/capture.go\",\n255|        find=(\n256|            \"\\t// ORDER-PIN: the source-race gate precedes any seal or publish.\\n\"\n257|            \"\\t// N-race-order-capture moves this gate after sealAndPublish and\\n\"\n258|            \"\\t// the killer reddens on the published manifests.\\n\"\n259|            \"\\tif err := state.gateSourceRace(); err != nil {\\n\"\n260|            \"\\t\\treturn state.raceOutcome(err)\\n\"\n261|            \"\\t}\\n\"\n262|            \"\\treturn state.sealAndPublish(false)\\n\"\n263|        ),\n264|        replace=(\n265|            \"\\tsealed, sealErr := state.sealAndPublish(false)\\n\"\n266|            \"\\tif sealErr != nil {\\n\"\n267|            \"\\t\\treturn nil, sealErr\\n\"\n268|            \"\\t}\\n\"\n269|            \"\\tif err := state.gateSourceRace(); err != nil {\\n\"\n270|            \"\\t\\t_, _ = state.raceOutcome(err)\\n\"\n271|            \"\\t\\treturn sealed, err\\n\"\n272|            \"\\t}\\n\"\n273|            \"\\treturn sealed, nil\\n\"\n274|        ),\n275|        count=1,\n276|        run=\"TestCaptureRaceSealsNoManifest\",\n277|        expect=\"KILLED\",\n278|        note=\"ORDERING: seals and publishes before the race gate; the killer reddens on the published manifests and the non-nil result.\",\n279|    ),\n280|    Mutant(\n281|        name=\"N-race-order-project\",\n282|        path=f\"{PACKAGE}/project.go\",\n283|        find=(\n284|            \"\\t// ORDER-PIN: the source-race gate precedes any seal, admission,\\n\"\n285|            \"\\t// or projection output. N-race-order-project moves this gate\\n\"\n286|            \"\\t// after admitAndEmit: the early seal then refuses with a seal\\n\"\n287|            \"\\t// error instead of the race refusal, so the killer reddens on\\n\"\n288|            \"\\t// the wrong error — and on any emitted receipt blob.\\n\"\n289|            \"\\tif err := state.gateSourceRace(); err != nil {\\n\"\n290|            \"\\t\\tcaptured, raceErr := state.raceOutcome(err)\\n\"\n291|            \"\\t\\tif raceErr != nil {\\n\"\n292|            \"\\t\\t\\treturn nil, raceErr\\n\"\n293|            \"\\t\\t}\\n\"\n294|            \"\\t\\t// Archive-only output never enters a target branch: the\\n\"\n295|            \"\\t\\t// admission gate below refuses it, so no receipt exists.\\n\"\n296|            \"\\t\\tif _, err := AdmitForTarget(captured.CaptureManifest, request.FidelityProfile); err != nil {\\n\"\n297|            \"\\t\\t\\treturn nil, err\\n\"\n298|            \"\\t\\t}\\n\"\n299|            '\\t\\treturn nil, invalid(\"capture archive unexpectedly admitted to a target branch\")\\n'\n300|            \"\\t}\\n\"\n301|            \"\\tsealed, err := state.sealAndPublish(false)\\n\"\n302|            \"\\tif err != nil {\\n\"\n303|            \"\\t\\treturn nil, err\\n\"\n304|            \"\\t}\\n\"\n305|            \"\\treturn state.admitAndEmit(request, sealed)\\n\"\n306|        ),\n307|        replace=(\n308|            \"\\tsealed, err := state.sealAndPublish(false)\\n\"\n309|            \"\\tif err != nil {\\n\"\n310|            \"\\t\\treturn nil, err\\n\"\n311|            \"\\t}\\n\"\n312|            \"\\temitted, emitErr := state.admitAndEmit(request, sealed)\\n\"\n313|            \"\\tif emitErr != nil {\\n\"\n314|            \"\\t\\treturn nil, emitErr\\n\"\n315|            \"\\t}\\n\"\n316|            \"\\tif err := state.gateSourceRace(); err != nil {\\n\"\n317|            \"\\t\\treturn emitted, err\\n\"\n318|            \"\\t}\\n\"\n319|            \"\\treturn emitted, nil\\n\"\n320|        ),\n321|        count=1,\n322|        run=\"TestCaptureRaceEmitsNoReceipt\",\n323|        expect=\"KILLED\",\n324|        note=\"ORDERING: seals, admits and emits before the race gate; the early seal refuses with a seal error instead of the race refusal, so the killer reddens on the wrong error — and on any emitted receipt blob.\",\n325|    ),\n326|    Mutant(\n327|        name=\"N-explicit\",\n328|        path=f\"{PACKAGE}/capture.go\",\n329|        find=\"\\tif !state.request.OperatorExplicit {\\n\",\n330|        replace='\\tif !state.request.OperatorExplicit && state.request.Generation != \"generation-9\" {\\n',\n331|        count=1,\n332|        run=\"TestCaptureArchiveRequiresExplicit\",\n333|        expect=\"KILLED\",\n334|        note=\"Seals unstable output without acknowledgement for exactly generation-9; every other generation still refuses.\",\n335|    ),\n336|    Mutant(\n337|        name=\"N-g2\",\n338|        path=f\"{PACKAGE}/project.go\",\n339|        find=(\n340|            \"\\tif err := clonebundle.RefuseUnstableForTarget(manifest.CaptureBoundary); err != nil {\\n\"\n341|            \"\\t\\treturn clonebundle.CaptureManifest{}, err\\n\"\n342|            \"\\t}\\n\"\n343|        ),\n344|        replace=(\n345|            '\\tif err := clonebundle.RefuseUnstableForTarget(manifest.CaptureBoundary); err != nil && manifest.CaptureBoundary.SourceGeneration.String() != \"generation-9\" {\\n'\n346|            \"\\t\\treturn clonebundle.CaptureManifest{}, err\\n\"\n347|            \"\\t}\\n\"\n348|        ),\n349|        count=1,\n350|        run=\"TestProjectRefusesUnstable\",\n351|        expect=\"KILLED\",\n352|        note=\"Admits exactly generation-9 unstable archives to the target branch; every other unstable still refuses.\",\n353|    ),\n354|    Mutant(\n355|        name=\"N-maximal\",\n356|        path=f\"{PACKAGE}/project.go\",\n357|        find='\\tif profile == \"maximal_safe\" {\\n',\n358|        replace='\\tif profile == \"maximal_safe\" && len(manifest.Items) != 3 {\\n',\n359|        count=1,\n360|        run=\"TestProjectMaximalSafeRequiresComplete\",\n361|        expect=\"KILLED\",\n362|        note=\"Admits exactly the three-item unknown manifest to maximal_safe; unknown manifests of every other size still refuse.\",\n363|    ),\n364|    Mutant(\n365|        name=\"N-fidelity\",\n366|        path=f\"{PACKAGE}/project.go\",\n367|        find=\"\\tdefault:\\n\\t\\treturn false\\n\\t}\\n\",\n368|        replace='\\tcase FidelityProfile(\"ultra\"):\\n\\t\\treturn true\\n\\tdefault:\\n\\t\\treturn false\\n\\t}\\n',\n369|        count=1,\n370|        run=\"TestProjectRefusesUnknownProfile\",\n371|        expect=\"KILLED\",\n372|        note=\"Admits exactly profile ultra; every other unknown profile still refuses.\",\n373|    ),\n374|    Mutant(\n375|        name=\"N-oversize\",\n376|        path=f\"{PACKAGE}/walk.go\",\n377|        find=\"\\tif uint64(info.Size()) > limit {\\n\",\n378|        replace=\"\\tif uint64(info.Size()) > limit && uint64(info.Size()) != 11 {\\n\",\n379|        count=1,\n380|        run=\"TestCaptureRefusesOversizedMember\",\n381|        expect=\"KILLED\",\n382|        note=\"Admits exactly 11-byte members past the size bound; every other oversized member still refuses.\",\n383|    ),\n384|    Mutant(\n385|        name=\"N-descriptor-empty\",\n386|        path=f\"{PACKAGE}/descriptor.go\",\n387|        find=\"\\tchunks := make([]any, 0, 1)\\n\\tfor offset := uint64(0); offset < size; {\\n\",\n388|        replace=(\n389|            \"\\tchunks := make([]any, 0, 1)\\n\"\n390|            \"\\tif size == 0 {\\n\"\n391|            '\\t\\tchunks = append(chunks, map[string]any{\"index\": 0, \"offset\": 0, \"size\": 0, \"chunk_id\": blobID.String()})\\n'\n392|            \"\\t}\\n\"\n393|            \"\\tfor offset := uint64(0); offset < size; {\\n\"\n394|        ),\n395|        count=1,\n396|        run=\"TestCaptureEmptyMemberSealsEmptyBlob\",\n397|        expect=\"KILLED\",\n398|        note=\"Seals exactly empty payloads with a zero-size chunk; every non-empty payload still seals clean chunks.\",\n399|    ),\n400|    Mutant(\n401|        name=\"N-descriptor-offset\",\n402|        path=f\"{PACKAGE}/descriptor.go\",\n403|        find=(\n404|            \"\\t\\tchunks = append(chunks, map[string]any{\\n\"\n405|            '\\t\\t\\t\"index\":    len(chunks),\\n'\n406|            '\\t\\t\\t\"offset\":   offset,\\n'\n407|        ),\n408|        replace=(\n409|            \"\\t\\tshifted := offset\\n\"\n410|            \"\\t\\tif len(chunks) == 1 {\\n\"\n411|            \"\\t\\t\\tshifted = offset + 1\\n\"\n412|            \"\\t\\t}\\n\"\n413|            \"\\t\\tchunks = append(chunks, map[string]any{\\n\"\n414|            '\\t\\t\\t\"index\":    len(chunks),\\n'\n415|            '\\t\\t\\t\"offset\":   shifted,\\n'\n416|        ),\n417|        count=1,\n418|        run=\"TestCaptureMultiChunkMember\",\n419|        expect=\"KILLED\",\n420|        note=\"Shifts exactly the second chunk off contiguity; single-chunk descriptors still seal.\",\n421|    ),\n422|    Mutant(\n423|        name=\"N-workspace-cwd\",\n424|        path=f\"{PACKAGE}/workspace.go\",\n425|        find='\\t\\tif relative == \"..\" || strings.HasPrefix(relative, \"..\"+string(filepath.Separator)) {\\n',\n426|        replace='\\t\\tif (relative == \"..\" || strings.HasPrefix(relative, \"..\"+string(filepath.Separator))) && cwd != \"/outside-workspace\" {\\n',\n427|        count=1,\n428|        run=\"TestCheckpointWorkspaceRefusesEscape\",\n429|        expect=\"KILLED\",\n430|        note=\"P3-δ (defence-in-depth, message-keyed): admits exactly /outside-workspace past the line-120 escape check while the landed relative-path grammar still refuses it; the killer reddens on the missing 'escapes the workspace root' literal, not on admission.\",\n431|    ),\n432|    Mutant(\n433|        name=\"N-workspace-fingerprints\",\n434|        path=f\"{PACKAGE}/workspace.go\",\n435|        find=\"\\t\\tif index > 0 && fingerprint <= previous {\\n\",\n436|        replace=\"\\t\\tif index > 0 && fingerprint < previous {\\n\",\n437|        count=1,\n438|        run=\"TestCheckpointWorkspaceRefusesDuplicateFingerprint\",\n439|        expect=\"KILLED\",\n440|        note=\"Admits exactly duplicate fingerprints; unsorted fingerprints still refuse with the checkpoint detail.\",\n441|    ),\n442|    Mutant(\n443|        name=\"N-log-leak\",\n444|        path=f\"{PACKAGE}/capture.go\",\n445|        find='\\t\\tstate.log.Linef(\"capture member=%q class=%s digest=%s size=%d media=%s\", key, item.Class, descriptor.BlobID.String(), descriptor.Size, blobMediaType)\\n',\n446|        replace=(\n447|            '\\t\\tstate.log.Linef(\"capture member=%q class=%s digest=%s size=%d media=%s\", key, item.Class, descriptor.BlobID.String(), descriptor.Size, blobMediaType)\\n'\n448|            '\\t\\tif key == \"store/blob-a\" {\\n'\n449|            '\\t\\t\\tstate.log.Linef(\"capture preview=%q\", string(payload))\\n'\n450|            '\\t\\t}\\n'\n451|        ),\n452|        count=1,\n453|        run=\"TestCaptureLogRecordsDigestsOnly\",\n454|        expect=\"KILLED\",\n455|        note=\"Leaks exactly store/blob-a payload bytes into the log; every other member still logs digests only.\",\n456|    ),\n457|    Mutant(\n458|        name=\"N-hook-crash\",\n459|        path=f\"{PACKAGE}/capture.go\",\n460|        find=\"\\tif request.Hooks.AfterRawPublish != nil {\\n\",\n461|        replace='\\tif request.Hooks.AfterRawPublish != nil && request.Generation != \"crash-generation-7\" {\\n',\n462|        count=1,\n463|        run=\"TestCaptureCrashChildSelfTerminates\",\n464|        expect=\"KILLED\",\n465|        note=\"Skips the crash-boundary hook for exactly the crash generation; the child exits clean and the parent misses its SIGKILL.\",\n466|    ),\n467|    Mutant(\n468|        name=\"N-payload-install-blob-b\",\n469|        path=f\"{PACKAGE}/capture.go\",\n470|        find=(\n471|            '\\t\\tif _, err := clonebundle.InstallRawBlob(state.request.Store, descriptor.Descriptor, bytes.NewReader(payload)); err != nil {\\n'\n472|            '\\t\\t\\treturn invalid(\"capture member %q: %v\", key, err)\\n'\n473|            '\\t\\t}\\n'\n474|        ),\n475|        replace=(\n476|            '\\t\\tif key != \"store/blob-b\" {\\n'\n477|            '\\t\\t\\tif _, err := clonebundle.InstallRawBlob(state.request.Store, descriptor.Descriptor, bytes.NewReader(payload)); err != nil {\\n'\n478|            '\\t\\t\\t\\treturn invalid(\"capture member %q: %v\", key, err)\\n'\n479|            '\\t\\t\\t}\\n'\n480|            '\\t\\t}\\n'\n481|        ),\n482|        count=1,\n483|        run=\"TestCaptureInstallsEveryPayloadBlob\",\n484|        expect=\"KILLED\",\n485|        note=\"Seals exactly store/blob-b into the raw manifest without installing its blob; every other member still installs. The killer scans the store for every referenced blob.\",\n486|    ),\n487|    Mutant(\n488|        name=\"N-archive-emits-receipt\",\n489|        path=f\"{PACKAGE}/project.go\",\n490|        find=\"\\t\\t// Archive-only output never enters a target branch: the\\n\",\n491|        replace=(\n492|            \"\\t\\t_, _ = request.TargetSink.PutBlob(scalar.SHA256Digest(captured.CaptureManifest), uint64(len(captured.CaptureManifest)), bytes.NewReader(captured.CaptureManifest))\\n\"\n493|            \"\\t\\t// Archive-only output never enters a target branch: the\\n\"\n494|        ),\n495|        count=1,\n496|        run=\"TestProjectRefusesUnstable\",\n497|        expect=\"KILLED\",\n498|        note=\"P3 row 8 (add-write, not a narrowing): writes the archive capture manifest into the TARGET sink before the G2 refusal; the killer asserts the target sink is empty, not only that admission refused.\",\n499|    ),\n500|    Mutant(\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c797","stream":{"kind":"session","id":"01a0b2d0-7ac7-7f03-8c97-ccb0ee9decb3"},"sequence":550,"recorded_at":1780531400001095,"record_type":"event","durability":"durable","causation_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","run_stream":{"kind":"run","id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2"},"task_stream":{"kind":"task","id":"01a0b2d2-3771-7d43-877d-c2ad43e66041"},"task_id":"01a0b2d2-3771-7d43-877d-c2ad43e66041","event":{"kind":"completed","task_id":"01a0b2d2-3771-7d43-877d-c2ad43e66041"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c799","stream":{"kind":"session","id":"01a0b2d0-7ac7-7f03-8c97-ccb0ee9decb3"},"sequence":551,"recorded_at":1780531400001097,"record_type":"event","durability":"durable","causation_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","run_stream":{"kind":"run","id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2"},"call_id":"call_01a0b2d233d4762c83e739a2d6b7e3ae","text":"Read text file `internal/clonesnap/testdata/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for internal/clonesnap.\n3|\n4|Every gate ships a narrowing mutant: the gate stays present and is\n5|weakened to admit exactly one member of the class it must reject, and\n6|the named killer test must fail. A delete-only mutant proves only that\n7|the gate exists and is not accepted as evidence.\n8|\n9|Each row runs M (mutate one production file in place), R (run the\n10|scoped Go killer through the production entry point), V (verdict from\n11|the Go exit code plus a FAIL kill-line: KILLED iff R fails with a test\n12|failure line, SURVIVED iff R passes, ERROR for anything else —\n13|unapplied patches, build breaks, timeouts). M failures and R\n14|infrastructure errors are ERROR, never kills or survivals. The file is\n15|restored from its backup after every row, pass or fail.\n16|\n17|Row N-plan-prefix is the token-preserving text mutant: the plan\n18|lookup keeps comparing against the planned keys but changes exact\n19|match to prefix match, and its killer drives the full Capture entry\n20|(the behavioral suite), not a static checker.\n21|\n22|Row C-doc-comment is the harmless control: a comment-only edit that\n23|must SURVIVE, proving the harness observes test outcomes instead of\n24|hard-coding kills.\n25|\n26|Usage:\n27|  PYTHONDONTWRITEBYTECODE=1 python3 internal/clonesnap/testdata/mutant_harness.py [--log-dir DIR] [MUTANT ...]\n28|\"\"\"\n29|\n30|import shutil\n31|import subprocess\n32|import sys\n33|import tempfile\n34|import time\n35|from dataclasses import dataclass\n36|from pathlib import Path\n37|\n38|REPO = Path(__file__).resolve().parents[3]\n39|PACKAGE = \"internal/clonesnap\"\n40|\n41|OPEN_MEMBER_HEAD = (\n42|    \"func openMember(guard secprim.Guard, root *os.File, member string, limit uint64) ([]byte, error) {\\n\"\n43|    \"\\tfile, err := guard.Open(root, member)\\n\"\n44|)\n45|\n46|PLAN_LOOKUP = (\n47|    '\\titem, planned := plan[key]\\n'\n48|    '\\tif !planned {\\n'\n49|    '\\t\\treturn \"\", invalid(\"capture store member %q is not a plan candidate\", key)\\n'\n50|    '\\t}\\n'\n51|    '\\treturn item.Class, nil\\n'\n52|)\n53|\n54|\n55|@dataclass(frozen=True)\n56|class Mutant:\n57|    name: str\n58|    path: str\n59|    find: str\n60|    replace: str\n61|    count: int\n62|    run: str\n63|    expect: str\n64|    note: str\n65|\n66|\n67|MUTANTS = [\n68|    Mutant(\n69|        name=\"N-contain-trailing\",\n70|        path=f\"{PACKAGE}/walk.go\",\n71|        find=OPEN_MEMBER_HEAD,\n72|        replace=(\n73|            \"func openMember(guard secprim.Guard, root *os.File, member string, limit uint64) ([]byte, error) {\\n\"\n74|            '\\tif member == \"link-escape\" {\\n'\n75|            '\\t\\treturn []byte(\"mutant-escaped-bytes\"), nil\\n'\n76|            '\\t}\\n'\n77|            \"\\tfile, err := guard.Open(root, member)\\n\"\n78|        ),\n79|        count=1,\n80|        run=\"TestCaptureRefusesTrailingSymlink\",\n81|        expect=\"KILLED\",\n82|        note=\"Stands forged bytes in for the Guard open of exactly link-escape; every other member still opens through the Guard.\",\n83|    ),\n84|    Mutant(\n85|        name=\"N-contain-intermediate\",\n86|        path=f\"{PACKAGE}/walk.go\",\n87|        find=OPEN_MEMBER_HEAD,\n88|        replace=(\n89|            \"func openMember(guard secprim.Guard, root *os.File, member string, limit uint64) ([]byte, error) {\\n\"\n90|            '\\tif member == \"link-escape/file\" {\\n'\n91|            '\\t\\treturn []byte(\"mutant-escaped-bytes\"), nil\\n'\n92|            '\\t}\\n'\n93|            \"\\tfile, err := guard.Open(root, member)\\n\"\n94|        ),\n95|        count=1,\n96|        run=\"TestCaptureRefusesSymlinkedIntermediate\",\n97|        expect=\"KILLED\",\n98|        note=\"Stands forged bytes in for the Guard open of exactly link-escape/file; every other member still opens through the Guard.\",\n99|    ),\n100|    Mutant(\n101|        name=\"N-fifo\",\n102|        path=f\"{PACKAGE}/walk.go\",\n103|        find=OPEN_MEMBER_HEAD,\n104|        replace=(\n105|            \"func openMember(guard secprim.Guard, root *os.File, member string, limit uint64) ([]byte, error) {\\n\"\n106|            '\\tif member == \"stash-fifo\" {\\n'\n107|            '\\t\\treturn []byte(\"mutant-fifo-bytes\"), nil\\n'\n108|            '\\t}\\n'\n109|            \"\\tfile, err := guard.Open(root, member)\\n\"\n110|        ),\n111|        count=1,\n112|        run=\"TestCaptureRefusesFIFO\",\n113|        expect=\"KILLED\",\n114|        note=\"Stands forged bytes in for the Guard open of exactly stash-fifo; every other member still opens through the Guard.\",\n115|    ),\n116|    Mutant(\n117|        name=\"N-unplanned\",\n118|        path=f\"{PACKAGE}/walk.go\",\n119|        find=PLAN_LOOKUP,\n120|        replace=(\n121|            '\\titem, planned := plan[key]\\n'\n122|            '\\tif !planned && key != \"store/zz-extra\" {\\n'\n123|            '\\t\\treturn \"\", invalid(\"capture store member %q is not a plan candidate\", key)\\n'\n124|            '\\t}\\n'\n125|            '\\tif !planned {\\n'\n126|            '\\t\\treturn \"durable_payload\", nil\\n'\n127|            '\\t}\\n'\n128|            '\\treturn item.Class, nil\\n'\n129|        ),\n130|        count=1,\n131|        run=\"TestCaptureRefusesUnplannedMember\",\n132|        expect=\"KILLED\",\n133|        note=\"Admits exactly store/zz-extra past the plan gate as durable_payload; every other unplanned key still refuses.\",\n134|    ),\n135|    Mutant(\n136|        name=\"N-plan-prefix\",\n137|        path=f\"{PACKAGE}/walk.go\",\n138|        find=PLAN_LOOKUP,\n139|        replace=(\n140|            '\\tfor plannedKey, plannedItem := range plan {\\n'\n141|            '\\t\\tif strings.HasPrefix(key, plannedKey) {\\n'\n142|            '\\t\\t\\treturn plannedItem.Class, nil\\n'\n143|            '\\t\\t}\\n'\n144|            '\\t}\\n'\n145|            '\\treturn \"\", invalid(\"capture store member %q is not a plan candidate\", key)\\n'\n146|        ),\n147|        count=1,\n148|        run=\"TestCaptureRefusesPrefixSibling\",\n149|        expect=\"KILLED\",\n150|        note=\"TOKEN-PRESERVING: the lookup still compares against the planned keys but admits prefix matches, so store/blob-a-evil rides on store/blob-a. The killer drives the full Capture entry.\",\n151|    ),\n152|    Mutant(\n153|        name=\"N-plan-order\",\n154|        path=f\"{PACKAGE}/walk.go\",\n155|        find=\"\\t\\tif index > 0 && item.NativeKey <= previous {\\n\",\n156|        replace=\"\\t\\tif index > 0 && item.NativeKey < previous {\\n\",\n157|        count=1,\n158|        run=\"TestCaptureRefusesDuplicatePlanKey\",\n159|        expect=\"KILLED\",\n160|        note=\"Admits exactly duplicate plan keys; unsorted keys still refuse with the plan detail.\",\n161|    ),\n162|    Mutant(\n163|        name=\"N-plan-sanitize\",\n164|        path=f\"{PACKAGE}/walk.go\",\n165|        find=\"\\t\\tif err := clonebundle.SanitizeNativeKey(item.NativeKey); err != nil {\\n\",\n166|        replace='\\t\\tif err := clonebundle.SanitizeNativeKey(item.NativeKey); err != nil && item.NativeKey != \"0198f4d1-9e60-7f66-8f86-f0123456789a\" {\\n',\n167|        count=1,\n168|        run=\"TestCaptureRefusesUnsanitizedPlanKey\",\n169|        expect=\"KILLED\",\n170|        note=\"Admits exactly one UUIDv7 plan key past the sanitizer; every other unsanitized key still refuses. Token preserved.\",\n171|    ),\n172|    Mutant(\n173|        name=\"N-plan-class\",\n174|        path=f\"{PACKAGE}/walk.go\",\n175|        find=\"\\t\\tif !clonebundle.ValidCaptureClass(item.Class) {\\n\",\n176|        replace='\\t\\tif !clonebundle.ValidCaptureClass(item.Class) && item.Class != \"mystery\" {\\n',\n177|        count=1,\n178|        run=\"TestCaptureRefusesMysteryPlanClass\",\n179|        expect=\"KILLED\",\n180|        note=\"Admits exactly class mystery past the vocabulary gate; every other unknown class still refuses.\",\n181|    ),\n182|    Mutant(\n183|        name=\"N-exclude-credential\",\n184|        path=f\"{PACKAGE}/walk.go\",\n185|        find='\\tcase \"credential\", \"machine_auth\", \"runtime_state\", \"transient_lock\":\\n',\n186|        replace='\\tcase \"machine_auth\", \"runtime_state\", \"transient_lock\":\\n',\n187|        count=1,\n188|        run=\"TestCaptureExcludesSecrets\",\n189|        expect=\"KILLED\",\n190|        note=\"Admits exactly credential rows as included; the other three always-excluded classes still exclude.\",\n191|    ),\n192|    Mutant(\n193|        name=\"N-exclude-machine-auth\",\n194|        path=f\"{PACKAGE}/walk.go\",\n195|        find='\\tcase \"credential\", \"machine_auth\", \"runtime_state\", \"transient_lock\":\\n',\n196|        replace='\\tcase \"credential\", \"runtime_state\", \"transient_lock\":\\n',\n197|        count=1,\n198|        run=\"TestCaptureExcludesSecrets\",\n199|        expect=\"KILLED\",\n200|        note=\"Admits exactly machine_auth rows as included; the other three always-excluded classes still exclude.\",\n201|    ),\n202|    Mutant(\n203|        name=\"N-exclude-runtime-state\",\n204|        path=f\"{PACKAGE}/walk.go\",\n205|        find='\\tcase \"credential\", \"machine_auth\", \"runtime_state\", \"transient_lock\":\\n',\n206|        replace='\\tcase \"credential\", \"machine_auth\", \"transient_lock\":\\n',\n207|        count=1,\n208|        run=\"TestCaptureExcludesSecrets\",\n209|        expect=\"KILLED\",\n210|        note=\"Admits exactly runtime_state rows as included; the other three always-excluded classes still exclude.\",\n211|    ),\n212|    Mutant(\n213|        name=\"N-exclude-transient-lock\",\n214|        path=f\"{PACKAGE}/walk.go\",\n215|        find='\\tcase \"credential\", \"machine_auth\", \"runtime_state\", \"transient_lock\":\\n',\n216|        replace='\\tcase \"credential\", \"machine_auth\", \"runtime_state\":\\n',\n217|        count=1,\n218|        run=\"TestCaptureExcludesSecrets\",\n219|        expect=\"KILLED\",\n220|        note=\"Admits exactly transient_lock rows as included; the other three always-excluded classes still exclude.\",\n221|    ),\n222|    Mutant(\n223|        name=\"N-required\",\n224|        path=f\"{PACKAGE}/capture.go\",\n225|        find=\"\\t\\tif !present && item.Required && !blockedAncestor(byKey, key) {\\n\",\n226|        replace='\\t\\tif !present && item.Required && key != \"store/must-have\" && !blockedAncestor(byKey, key) {\\n',\n227|        count=1,\n228|        run=\"TestCaptureRefusesRequiredMissing\",\n229|        expect=\"KILLED\",\n230|        note=\"Admits exactly store/must-have past the required-absent refusal; every other required-absent candidate still refuses.\",\n231|    ),\n232|    Mutant(\n233|        name=\"N-optional\",\n234|        path=f\"{PACKAGE}/capture.go\",\n235|        find=\"\\t\\tif !present && !item.Required && !blockedAncestor(byKey, key) {\\n\",\n236|        replace='\\t\\tif !present && !item.Required && key != \"store/maybe\" && !blockedAncestor(byKey, key) {\\n',\n237|        count=1,\n238|        run=\"TestCaptureOptionalAbsentSealsExcluded\",\n239|        expect=\"KILLED\",\n240|        note=\"Refuses exactly the optional-absent store/maybe that must seal as excluded; every other optional-absent still seals.\",\n241|    ),\n242|    Mutant(\n243|        name=\"N-race-narrow\",\n244|        path=f\"{PACKAGE}/race.go\",\n245|        find=\"\\tif err := clonebundle.CheckDigestsEqual(pre, post); err != nil {\\n\",\n246|        replace='\\tif err := clonebundle.CheckDigestsEqual(pre, post); err != nil && firstChangedMember(preLines, postLines) != \"store/blob-a\" {\\n',\n247|        count=1,\n248|        run=\"TestCaptureRaceChangedByte\",\n249|        expect=\"KILLED\",\n250|        note=\"Ignores exactly races naming store/blob-a; races on every other member still refuse.\",\n251|    ),\n252|    Mutant(\n253|        name=\"N-race-order-capture\",\n254|        path=f\"{PACKAGE}/capture.go\",\n255|        find=(\n256|            \"\\t// ORDER-PIN: the source-race gate precedes any seal or publish.\\n\"\n257|            \"\\t// N-race-order-capture moves this gate after sealAndPublish and\\n\"\n258|            \"\\t// the killer reddens on the published manifests.\\n\"\n259|            \"\\tif err := state.gateSourceRace(); err != nil {\\n\"\n260|            \"\\t\\treturn state.raceOutcome(err)\\n\"\n261|            \"\\t}\\n\"\n262|            \"\\treturn state.sealAndPublish(false)\\n\"\n263|        ),\n264|        replace=(\n265|            \"\\tsealed, sealErr := state.sealAndPublish(false)\\n\"\n266|            \"\\tif sealErr != nil {\\n\"\n267|            \"\\t\\treturn nil, sealErr\\n\"\n268|            \"\\t}\\n\"\n269|            \"\\tif err := state.gateSourceRace(); err != nil {\\n\"\n270|            \"\\t\\t_, _ = state.raceOutcome(err)\\n\"\n271|            \"\\t\\treturn sealed, err\\n\"\n272|            \"\\t}\\n\"\n273|            \"\\treturn sealed, nil\\n\"\n274|        ),\n275|        count=1,\n276|        run=\"TestCaptureRaceSealsNoManifest\",\n277|        expect=\"KILLED\",\n278|        note=\"ORDERING: seals and publishes before the race gate; the killer reddens on the published manifests and the non-nil result.\",\n279|    ),\n280|    Mutant(\n281|        name=\"N-race-order-project\",\n282|        path=f\"{PACKAGE}/project.go\",\n283|        find=(\n284|            \"\\t// ORDER-PIN: the source-race gate precedes any seal, admission,\\n\"\n285|            \"\\t// or projection output. N-race-order-project moves this gate\\n\"\n286|            \"\\t// after admitAndEmit: the early seal then refuses with a seal\\n\"\n287|            \"\\t// error instead of the race refusal, so the killer reddens on\\n\"\n288|            \"\\t// the wrong error — and on any emitted receipt blob.\\n\"\n289|            \"\\tif err := state.gateSourceRace(); err != nil {\\n\"\n290|            \"\\t\\tcaptured, raceErr := state.raceOutcome(err)\\n\"\n291|            \"\\t\\tif raceErr != nil {\\n\"\n292|            \"\\t\\t\\treturn nil, raceErr\\n\"\n293|            \"\\t\\t}\\n\"\n294|            \"\\t\\t// Archive-only output never enters a target branch: the\\n\"\n295|            \"\\t\\t// admission gate below refuses it, so no receipt exists.\\n\"\n296|            \"\\t\\tif _, err := AdmitForTarget(captured.CaptureManifest, request.FidelityProfile); err != nil {\\n\"\n297|            \"\\t\\t\\treturn nil, err\\n\"\n298|            \"\\t\\t}\\n\"\n299|            '\\t\\treturn nil, invalid(\"capture archive unexpectedly admitted to a target branch\")\\n'\n300|            \"\\t}\\n\"\n301|            \"\\tsealed, err := state.sealAndPublish(false)\\n\"\n302|            \"\\tif err != nil {\\n\"\n303|            \"\\t\\treturn nil, err\\n\"\n304|            \"\\t}\\n\"\n305|            \"\\treturn state.admitAndEmit(request, sealed)\\n\"\n306|        ),\n307|        replace=(\n308|            \"\\tsealed, err := state.sealAndPublish(false)\\n\"\n309|            \"\\tif err != nil {\\n\"\n310|            \"\\t\\treturn nil, err\\n\"\n311|            \"\\t}\\n\"\n312|            \"\\temitted, emitErr := state.admitAndEmit(request, sealed)\\n\"\n313|            \"\\tif emitErr != nil {\\n\"\n314|            \"\\t\\treturn nil, emitErr\\n\"\n315|            \"\\t}\\n\"\n316|            \"\\tif err := state.gateSourceRace(); err != nil {\\n\"\n317|            \"\\t\\treturn emitted, err\\n\"\n318|            \"\\t}\\n\"\n319|            \"\\treturn emitted, nil\\n\"\n320|        ),\n321|        count=1,\n322|        run=\"TestCaptureRaceEmitsNoReceipt\",\n323|        expect=\"KILLED\",\n324|        note=\"ORDERING: seals, admits and emits before the race gate; the early seal refuses with a seal error instead of the race refusal, so the killer reddens on the wrong error — and on any emitted receipt blob.\",\n325|    ),\n326|    Mutant(\n327|        name=\"N-explicit\",\n328|        path=f\"{PACKAGE}/capture.go\",\n329|        find=\"\\tif !state.request.OperatorExplicit {\\n\",\n330|        replace='\\tif !state.request.OperatorExplicit && state.request.Generation != \"generation-9\" {\\n',\n331|        count=1,\n332|        run=\"TestCaptureArchiveRequiresExplicit\",\n333|        expect=\"KILLED\",\n334|        note=\"Seals unstable output without acknowledgement for exactly generation-9; every other generation still refuses.\",\n335|    ),\n336|    Mutant(\n337|        name=\"N-g2\",\n338|        path=f\"{PACKAGE}/project.go\",\n339|        find=(\n340|            \"\\tif err := clonebundle.RefuseUnstableForTarget(manifest.CaptureBoundary); err != nil {\\n\"\n341|            \"\\t\\treturn clonebundle.CaptureManifest{}, err\\n\"\n342|            \"\\t}\\n\"\n343|        ),\n344|        replace=(\n345|            '\\tif err := clonebundle.RefuseUnstableForTarget(manifest.CaptureBoundary); err != nil && manifest.CaptureBoundary.SourceGeneration.String() != \"generation-9\" {\\n'\n346|            \"\\t\\treturn clonebundle.CaptureManifest{}, err\\n\"\n347|            \"\\t}\\n\"\n348|        ),\n349|        count=1,\n350|        run=\"TestProjectRefusesUnstable\",\n351|        expect=\"KILLED\",\n352|        note=\"Admits exactly generation-9 unstable archives to the target branch; every other unstable still refuses.\",\n353|    ),\n354|    Mutant(\n355|        name=\"N-maximal\",\n356|        path=f\"{PACKAGE}/project.go\",\n357|        find='\\tif profile == \"maximal_safe\" {\\n',\n358|        replace='\\tif profile == \"maximal_safe\" && len(manifest.Items) != 3 {\\n',\n359|        count=1,\n360|        run=\"TestProjectMaximalSafeRequiresComplete\",\n361|        expect=\"KILLED\",\n362|        note=\"Admits exactly the three-item unknown manifest to maximal_safe; unknown manifests of every other size still refuse.\",\n363|    ),\n364|    Mutant(\n365|        name=\"N-fidelity\",\n366|        path=f\"{PACKAGE}/project.go\",\n367|        find=\"\\tdefault:\\n\\t\\treturn false\\n\\t}\\n\",\n368|        replace='\\tcase FidelityProfile(\"ultra\"):\\n\\t\\treturn true\\n\\tdefault:\\n\\t\\treturn false\\n\\t}\\n',\n369|        count=1,\n370|        run=\"TestProjectRefusesUnknownProfile\",\n371|        expect=\"KILLED\",\n372|        note=\"Admits exactly profile ultra; every other unknown profile still refuses.\",\n373|    ),\n374|    Mutant(\n375|        name=\"N-oversize\",\n376|        path=f\"{PACKAGE}/walk.go\",\n377|        find=\"\\tif uint64(info.Size()) > limit {\\n\",\n378|        replace=\"\\tif uint64(info.Size()) > limit && uint64(info.Size()) != 11 {\\n\",\n379|        count=1,\n380|        run=\"TestCaptureRefusesOversizedMember\",\n381|        expect=\"KILLED\",\n382|        note=\"Admits exactly 11-byte members past the size bound; every other oversized member still refuses.\",\n383|    ),\n384|    Mutant(\n385|        name=\"N-descriptor-empty\",\n386|        path=f\"{PACKAGE}/descriptor.go\",\n387|        find=\"\\tchunks := make([]any, 0, 1)\\n\\tfor offset := uint64(0); offset < size; {\\n\",\n388|        replace=(\n389|            \"\\tchunks := make([]any, 0, 1)\\n\"\n390|            \"\\tif size == 0 {\\n\"\n391|            '\\t\\tchunks = append(chunks, map[string]any{\"index\": 0, \"offset\": 0, \"size\": 0, \"chunk_id\": blobID.String()})\\n'\n392|            \"\\t}\\n\"\n393|            \"\\tfor offset := uint64(0); offset < size; {\\n\"\n394|        ),\n395|        count=1,\n396|        run=\"TestCaptureEmptyMemberSealsEmptyBlob\",\n397|        expect=\"KILLED\",\n398|        note=\"Seals exactly empty payloads with a zero-size chunk; every non-empty payload still seals clean chunks.\",\n399|    ),\n400|    Mutant(\n401|        name=\"N-descriptor-offset\",\n402|        path=f\"{PACKAGE}/descriptor.go\",\n403|        find=(\n404|            \"\\t\\tchunks = append(chunks, map[string]any{\\n\"\n405|            '\\t\\t\\t\"index\":    len(chunks),\\n'\n406|            '\\t\\t\\t\"offset\":   offset,\\n'\n407|        ),\n408|        replace=(\n409|            \"\\t\\tshifted := offset\\n\"\n410|            \"\\t\\tif len(chunks) == 1 {\\n\"\n411|            \"\\t\\t\\tshifted = offset + 1\\n\"\n412|            \"\\t\\t}\\n\"\n413|            \"\\t\\tchunks = append(chunks, map[string]any{\\n\"\n414|            '\\t\\t\\t\"index\":    len(chunks),\\n'\n415|            '\\t\\t\\t\"offset\":   shifted,\\n'\n416|        ),\n417|        count=1,\n418|        run=\"TestCaptureMultiChunkMember\",\n419|        expect=\"KILLED\",\n420|        note=\"Shifts exactly the second chunk off contiguity; single-chunk descriptors still seal.\",\n421|    ),\n422|    Mutant(\n423|        name=\"N-workspace-cwd\",\n424|        path=f\"{PACKAGE}/workspace.go\",\n425|        find='\\t\\tif relative == \"..\" || strings.HasPrefix(relative, \"..\"+string(filepath.Separator)) {\\n',\n426|        replace='\\t\\tif (relative == \"..\" || strings.HasPrefix(relative, \"..\"+string(filepath.Separator))) && cwd != \"/outside-workspace\" {\\n',\n427|        count=1,\n428|        run=\"TestCheckpointWorkspaceRefusesEscape\",\n429|        expect=\"KILLED\",\n430|        note=\"P3-δ (defence-in-depth, message-keyed): admits exactly /outside-workspace past the line-120 escape check while the landed relative-path grammar still refuses it; the killer reddens on the missing 'escapes the workspace root' literal, not on admission.\",\n431|    ),\n432|    Mutant(\n433|        name=\"N-workspace-fingerprints\",\n434|        path=f\"{PACKAGE}/workspace.go\",\n435|        find=\"\\t\\tif index > 0 && fingerprint <= previous {\\n\",\n436|        replace=\"\\t\\tif index > 0 && fingerprint < previous {\\n\",\n437|        count=1,\n438|        run=\"TestCheckpointWorkspaceRefusesDuplicateFingerprint\",\n439|        expect=\"KILLED\",\n440|        note=\"Admits exactly duplicate fingerprints; unsorted fingerprints still refuse with the checkpoint detail.\",\n441|    ),\n442|    Mutant(\n443|        name=\"N-log-leak\",\n444|        path=f\"{PACKAGE}/capture.go\",\n445|        find='\\t\\tstate.log.Linef(\"capture member=%q class=%s digest=%s size=%d media=%s\", key, item.Class, descriptor.BlobID.String(), descriptor.Size, blobMediaType)\\n',\n446|        replace=(\n447|            '\\t\\tstate.log.Linef(\"capture member=%q class=%s digest=%s size=%d media=%s\", key, item.Class, descriptor.BlobID.String(), descriptor.Size, blobMediaType)\\n'\n448|            '\\t\\tif key == \"store/blob-a\" {\\n'\n449|            '\\t\\t\\tstate.log.Linef(\"capture preview=%q\", string(payload))\\n'\n450|            '\\t\\t}\\n'\n451|        ),\n452|        count=1,\n453|        run=\"TestCaptureLogRecordsDigestsOnly\",\n454|        expect=\"KILLED\",\n455|        note=\"Leaks exactly store/blob-a payload bytes into the log; every other member still logs digests only.\",\n456|    ),\n457|    Mutant(\n458|        name=\"N-hook-crash\",\n459|        path=f\"{PACKAGE}/capture.go\",\n460|        find=\"\\tif request.Hooks.AfterRawPublish != nil {\\n\",\n461|        replace='\\tif request.Hooks.AfterRawPublish != nil && request.Generation != \"crash-generation-7\" {\\n',\n462|        count=1,\n463|        run=\"TestCaptureCrashChildSelfTerminates\",\n464|        expect=\"KILLED\",\n465|        note=\"Skips the crash-boundary hook for exactly the crash generation; the child exits clean and the parent misses its SIGKILL.\",\n466|    ),\n467|    Mutant(\n468|        name=\"N-payload-install-blob-b\",\n469|        path=f\"{PACKAGE}/capture.go\",\n470|        find=(\n471|            '\\t\\tif _, err := clonebundle.InstallRawBlob(state.request.Store, descriptor.Descriptor, bytes.NewReader(payload)); err != nil {\\n'\n472|            '\\t\\t\\treturn invalid(\"capture member %q: %v\", key, err)\\n'\n473|            '\\t\\t}\\n'\n474|        ),\n475|        replace=(\n476|            '\\t\\tif key != \"store/blob-b\" {\\n'\n477|            '\\t\\t\\tif _, err := clonebundle.InstallRawBlob(state.request.Store, descriptor.Descriptor, bytes.NewReader(payload)); err != nil {\\n'\n478|            '\\t\\t\\t\\treturn invalid(\"capture member %q: %v\", key, err)\\n'\n479|            '\\t\\t\\t}\\n'\n480|            '\\t\\t}\\n'\n481|        ),\n482|        count=1,\n483|        run=\"TestCaptureInstallsEveryPayloadBlob\",\n484|        expect=\"KILLED\",\n485|        note=\"Seals exactly store/blob-b into the raw manifest without installing its blob; every other member still installs. The killer scans the store for every referenced blob.\",\n486|    ),\n487|    Mutant(\n488|        name=\"N-archive-emits-receipt\",\n489|        path=f\"{PACKAGE}/project.go\",\n490|        find=\"\\t\\t// Archive-only output never enters a target branch: the\\n\",\n491|        replace=(\n492|            \"\\t\\t_, _ = request.TargetSink.PutBlob(scalar.SHA256Digest(captured.CaptureManifest), uint64(len(captured.CaptureManifest)), bytes.NewReader(captured.CaptureManifest))\\n\"\n493|            \"\\t\\t// Archive-only output never enters a target branch: the\\n\"\n494|        ),\n495|        count=1,\n496|        run=\"TestProjectRefusesUnstable\",\n497|        expect=\"KILLED\",\n498|        note=\"P3 row 8 (add-write, not a narrowing): writes the archive capture manifest into the TARGET sink before the G2 refusal; the killer asserts the target sink is empty, not only that admission refused.\",\n499|    ),\n500|    Mutant(\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
