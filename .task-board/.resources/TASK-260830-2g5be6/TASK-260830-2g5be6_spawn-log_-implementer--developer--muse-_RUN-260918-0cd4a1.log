{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c721","stream":{"kind":"session","id":"01a0b2d0-7ac7-7f03-8c97-ccb0ee9decb3"},"sequence":491,"recorded_at":1780531400000977,"record_type":"event","durability":"durable","causation_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","run_stream":{"kind":"run","id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2"},"task_stream":{"kind":"task","id":"01a0b2d2-1a58-78c3-b919-6a10243e9347"},"task_id":"01a0b2d2-1a58-78c3-b919-6a10243e9347","event":{"kind":"output","task_id":"01a0b2d2-1a58-78c3-b919-6a10243e9347","chunk":"Read text file `internal/clonesnap/project.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/localstore\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|)\n12|\n13|// This file owns target-branch admission and the projection output\n14|// whose existence pins the race-before-projection ordering.\n15|// CaptureAndProject runs the capture pipeline, then admits the\n16|// sealed capture manifest: the unstable_archive form can never enter\n17|// a target branch (the landed G2 gate decides), and the maximal_safe\n18|// fidelity profile requires a reconciled complete manifest (the\n19|// landed maximal-safe gate decides). Admission emits one admission\n20|// receipt into the target sink. Projection planning past admission\n21|// is the final leaf's scope; this receipt exists to prove admission\n22|// and ordering, not to plan a projection.\n23|\n24|// FidelityProfile is one Section 7.8 fidelity profile:\n25|// strict_exact|maximal_safe|compact|messages_only.\n26|type FidelityProfile string\n27|\n28|const (\n29|\t// FidelityStrictExact requests exact projection.\n30|\tFidelityStrictExact FidelityProfile = \"strict_exact\"\n31|\t// FidelityMaximalSafe requests maximal safe projection: it\n32|\t// requires a reconciled complete manifest with no unknown class.\n33|\tFidelityMaximalSafe FidelityProfile = \"maximal_safe\"\n34|\t// FidelityCompact requests compact projection.\n35|\tFidelityCompact FidelityProfile = \"compact\"\n36|\t// FidelityMessagesOnly requests messages-only projection.\n37|\tFidelityMessagesOnly FidelityProfile = \"messages_only\"\n38|)\n39|\n40|// validFidelityProfile reports whether the profile is in the Section\n41|// 7.8 closed vocabulary. Bound (P3-ζ′): sessadapter owns an\n42|// unexported copy of this four-profile table; the Story FINAL leaf\n43|// unifies or exports one owner. This package keeps its own closed\n44|// switch so the leaf boundary stays narrow.\n45|func validFidelityProfile(profile string) bool {\n46|\tswitch FidelityProfile(profile) {\n47|\tcase FidelityStrictExact, FidelityMaximalSafe, FidelityCompact, FidelityMessagesOnly:\n48|\t\treturn true\n49|\tdefault:\n50|\t\treturn false\n51|\t}\n52|}\n53|\n54|// ProjectRequest is one capture-and-project candidate: the capture\n55|// request, the target sink that receives the admission receipt, and\n56|// the fidelity profile admission decides.\n57|type ProjectRequest struct {\n58|\tCapture CaptureRequest\n59|\t// TargetSink receives the admission receipt. It stays empty\n60|\t// when capture refuses, races, or seals archive-only output.\n61|\tTargetSink *localstore.ObjectStore\n62|\t// FidelityProfile is the requested Section 7.8 profile.\n63|\tFidelityProfile string\n64|}\n65|\n66|// ProjectResult is one admitted capture: the capture result plus the\n67|// sealed admission receipt.\n68|type ProjectResult struct {\n69|\tCapture *CaptureResult\n70|\t// Receipt carries the sealed admission receipt bytes.\n71|\tReceipt []byte\n72|\t// ReceiptDigest is the blob identity of the receipt.\n73|\tReceiptDigest scalar.Digest\n74|\t// ReceiptInstalled reports whether this run installed the\n75|\t// receipt blob (a replay verifies and reuses).\n76|\tReceiptInstalled bool\n77|}\n78|\n79|// CaptureAndProject runs capture, then admits the sealed capture to\n80|// a target branch and emits the admission receipt. The race gate\n81|// precedes admission and emission (see ORDER-PIN below): a mutated\n82|// source refuses, or seals archive-only output that admission\n83|// rejects — no projection output is produced before the race is\n84|// decided.\n85|func CaptureAndProject(request ProjectRequest) (*ProjectResult, error) {\n86|\tif request.TargetSink == nil {\n87|\t\treturn nil, invalid(\"capture projection requires a target sink\")\n88|\t}\n89|\tstate, err := newPipeline(request.Capture)\n90|\tif err != nil {\n91|\t\treturn nil, err\n92|\t}\n93|\tdefer state.close()\n94|\tif err := state.walkAndMeasure(); err != nil {\n95|\t\treturn nil, err\n96|\t}\n97|\t// ORDER-PIN: the source-race gate precedes any seal, admission,\n98|\t// or projection output. N-race-order-project moves this gate\n99|\t// after admitAndEmit: the early seal then refuses with a seal\n100|\t// error instead of the race refusal, so the killer reddens on\n101|\t// the wrong error — and on any emitted receipt blob.\n102|\tif err := state.gateSourceRace(); err != nil {\n103|\t\tcaptured, raceErr := state.raceOutcome(err)\n104|\t\tif raceErr != nil {\n105|\t\t\treturn nil, raceErr\n106|\t\t}\n107|\t\t// Archive-only output never enters a target branch: the\n108|\t\t// admission gate below refuses it, so no receipt exists.\n109|\t\tif _, err := AdmitForTarget(captured.CaptureManifest, request.FidelityProfile); err != nil {\n110|\t\t\treturn nil, err\n111|\t\t}\n112|\t\treturn nil, invalid(\"capture archive unexpectedly admitted to a target branch\")\n113|\t}\n114|\tsealed, err := state.sealAndPublish(false)\n115|\tif err != nil {\n116|\t\treturn nil, err\n117|\t}\n118|\treturn state.admitAndEmit(request, sealed)\n119|}\n120|\n121|// admitAndEmit admits one sealed capture to the target branch and\n122|// emits its admission receipt into the target sink.\n123|func (state *pipeline) admitAndEmit(request ProjectRequest, sealed *CaptureResult) (*ProjectResult, error) {\n124|\tif _, err := AdmitForTarget(sealed.CaptureManifest, request.FidelityProfile); err != nil {\n125|\t\treturn nil, err\n126|\t}\n127|\treceipt, err := BuildAdmissionReceipt(sealed.Raw.ManifestID, sealed.Capture.ManifestID, request.FidelityProfile)\n128|\tif err != nil {\n129|\t\treturn nil, err\n130|\t}\n131|\tdigest := scalar.SHA256Digest(receipt)\n132|\tput, err := request.TargetSink.PutBlob(digest, uint64(len(receipt)), bytes.NewReader(receipt))\n133|\tif err != nil {\n134|\t\treturn nil, invalid(\"capture projection cannot publish the admission receipt: %v\", err)\n135|\t}\n136|\treturn &ProjectResult{\n137|\t\tCapture:          sealed,\n138|\t\tReceipt:          receipt,\n139|\t\tReceiptDigest:    digest,\n140|\t\tReceiptInstalled: put.Installed,\n141|\t}, nil\n142|}\n143|\n144|// AdmitForTarget admits one sealed capture manifest to a target\n145|// branch under the requested fidelity profile. The unstable_archive\n146|// form is archive-only output and always refuses; an unknown\n147|// fidelity profile refuses; maximal_safe requires a reconciled\n148|// complete manifest with no unknown class.\n149|func AdmitForTarget(captureManifest []byte, profile string) (clonebundle.CaptureManifest, error) {\n150|\tmanifest, err := clonebundle.DecodeCaptureManifest(captureManifest)\n151|\tif err != nil {\n152|\t\treturn clonebundle.CaptureManifest{}, err\n153|\t}\n154|\tif err := clonebundle.RefuseUnstableForTarget(manifest.CaptureBoundary); err != nil {\n155|\t\treturn clonebundle.CaptureManifest{}, err\n156|\t}\n157|\tif !validFidelityProfile(profile) {\n158|\t\treturn clonebundle.CaptureManifest{}, invalid(\"capture fidelity profile %q is outside strict_exact|maximal_safe|compact|messages_only\", profile)\n159|\t}\n160|\tif profile == \"maximal_safe\" {\n161|\t\tif err := clonebundle.RefuseMaximalSafeUnlessComplete(manifest); err != nil {\n162|\t\t\treturn clonebundle.CaptureManifest{}, err\n163|\t\t}\n164|\t}\n165|\treturn manifest, nil\n166|}\n167|\n168|// admissionReceiptSchema pins the admission receipt envelope\n169|// identity.\n170|const admissionReceiptSchema = \"urn:ax:internal:clonesnap-admission-receipt\"\n171|\n172|// BuildAdmissionReceipt seals one target admission receipt: the\n173|// admitted raw and capture manifest identities, the stable boundary\n174|// kind, and the fidelity profile. Only stable captures reach it;\n175|// AdmitForTarget refused everything else before this seal ran.\n176|func BuildAdmissionReceipt(rawManifestID, captureManifestID scalar.Digest, profile string) ([]byte, error) {\n177|\tif !validFidelityProfile(profile) {\n178|\t\treturn nil, invalid(\"capture fidelity profile %q is outside strict_exact|maximal_safe|compact|messages_only\", profile)\n179|\t}\n180|\tobject := map[string]any{\n181|\t\t\"schema\":                 admissionReceiptSchema,\n182|\t\t\"schema_version\":         \"1.0.0\",\n183|\t\t\"raw_object_manifest_id\": rawManifestID.String(),\n184|\t\t\"capture_manifest_id\":    captureManifestID.String(),\n185|\t\t\"boundary_kind\":          \"stable\",\n186|\t\t\"fidelity_profile\":       profile,\n187|\t\t\"extensions\":             map[string]any{},\n188|\t}\n189|\tplain, err := json.Marshal(object)\n190|\tif err != nil {\n191|\t\treturn nil, invalid(\"serialize admission receipt: %v\", err)\n192|\t}\n193|\tsealed, err := canonicaljson.Canonicalize(plain)\n194|\tif err != nil {\n195|\t\treturn nil, invalid(\"canonicalize admission receipt: %v\", err)\n196|\t}\n197|\treturn sealed, nil\n198|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c723","stream":{"kind":"session","id":"01a0b2d0-7ac7-7f03-8c97-ccb0ee9decb3"},"sequence":492,"recorded_at":1780531400000979,"record_type":"event","durability":"durable","causation_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","run_stream":{"kind":"run","id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2"},"task_stream":{"kind":"task","id":"01a0b2d2-1a58-78c3-b919-6a10243e9347"},"task_id":"01a0b2d2-1a58-78c3-b919-6a10243e9347","event":{"kind":"completed","task_id":"01a0b2d2-1a58-78c3-b919-6a10243e9347"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c725","stream":{"kind":"session","id":"01a0b2d0-7ac7-7f03-8c97-ccb0ee9decb3"},"sequence":493,"recorded_at":1780531400000981,"record_type":"event","durability":"durable","causation_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","run_stream":{"kind":"run","id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2"},"task_stream":{"kind":"task","id":"01a0b2d2-1a3b-7dc1-a2b3-3f044f1b7286"},"task_id":"01a0b2d2-1a3b-7dc1-a2b3-3f044f1b7286","event":{"kind":"output","task_id":"01a0b2d2-1a3b-7dc1-a2b3-3f044f1b7286","chunk":"Read text file `internal/clonesnap/capture.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"os\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/localstore\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n11|)\n12|\n13|// This file owns the native capture operation: Capture walks a real\n14|// provider store directory through the contained walk, installs\n15|// payload blobs through the landed no-replace discipline, seals the\n16|// Raw Object Manifest and Capture Manifest through the landed\n17|// builders, publishes both through the object store, and checkpoints\n18|// the workspace binding. The source-race gate runs after the\n19|// post-capture measurement and before any seal: a detected mutation\n20|// refuses, or seals the core-created unstable_archive form for\n21|// archive-only output when the operator explicitly acknowledged\n22|// archival. Nothing sealed here is trusted undecoded: every sealed\n23|// manifest re-decodes through the landed decoder before it is\n24|// published or returned.\n25|\n26|// RacePolicy decides a detected source mutation: RaceRefuse aborts\n27|// capture with no sealed manifest; RaceArchive seals the\n28|// unstable_archive form for archive-only output, which can never\n29|// enter a target branch.\n30|type RacePolicy string\n31|\n32|const (\n33|\t// RaceRefuse aborts capture on a detected source mutation.\n34|\tRaceRefuse RacePolicy = \"refuse\"\n35|\t// RaceArchive seals unstable_archive output on a detected\n36|\t// source mutation. It requires OperatorExplicit.\n37|\tRaceArchive RacePolicy = \"archive\"\n38|)\n39|\n40|// CaptureHooks carries the crash and race seams: AfterWalk runs\n41|// between the capture walk and the post-capture measurement (race\n42|// injection observes here), AfterRawPublish runs between the raw\n43|// manifest publish and the capture manifest seal (crash kill lands\n44|// here). A hook error aborts capture; a hook that never returns\n45|// (process kill) leaves at most the published prefix behind.\n46|type CaptureHooks struct {\n47|\tAfterWalk       func(storeRoot string) error\n48|\tAfterRawPublish func() error\n49|}\n50|\n51|// CaptureRequest is one native capture candidate over a provider\n52|// store directory.\n53|type CaptureRequest struct {\n54|\t// StoreRoot is the absolute provider store directory. Every\n55|\t// payload open descends from its verified handle.\n56|\tStoreRoot string\n57|\t// Platform governs member-name grammar.\n58|\tPlatform scalar.Platform\n59|\t// Plan carries the sorted unique capture-plan candidates.\n60|\tPlan []PlanItem\n61|\t// OperationID and BundleID identify the clone operation and\n62|\t// the logical bundle chain.\n63|\tOperationID string\n64|\tBundleID    string\n65|\t// SourceBasis binds ax_session or external_native source IDs.\n66|\tSourceBasis clonebundle.SourceBasisInput\n67|\t// SourceEnvironment carries the exact probed Environment Tuple\n68|\t// bytes.\n69|\tSourceEnvironment []byte\n70|\t// SourceIdentity is the sanitized NativeIdentity. Capture\n71|\t// re-validates it through the landed IdentityDigest before\n72|\t// anything seals: an identity decoding would refuse fails the\n73|\t// entry, so no sealed artifact carries it.\n74|\tSourceIdentity clonebundle.NativeIdentity\n75|\t// CapturePlanDigest is the exact core-validated capture-plan\n76|\t// digest.\n77|\tCapturePlanDigest string\n78|\t// NativeSessionID is the sanitized source native session ID.\n79|\tNativeSessionID string\n80|\t// CreatedByHostID and CreatedAt stamp the capture manifest.\n81|\tCreatedByHostID string\n82|\tCreatedAt       string\n83|\t// Generation is the immutable source generation token.\n84|\tGeneration string\n85|\t// ProofKind is the closed proof vocabulary:\n86|\t// closed_store|immutable_snapshot|verified_log_prefix|provider_quiescence.\n87|\tProofKind string\n88|\t// SnapshotIdentity pins an immutable snapshot; nil unless the\n89|\t// proof kind requires it.\n90|\tSnapshotIdentity *string\n91|\t// InputBlocked, ForegroundIdle, and BackgroundIdle are the\n92|\t// measured idle facts the stable proof seals.\n93|\tInputBlocked   bool\n94|\tForegroundIdle bool\n95|\tBackgroundIdle bool\n96|\t// OperatorExplicit acknowledges archive-only output when the\n97|\t// source is not quiescent.\n98|\tOperatorExplicit bool\n99|\t// OnRace decides a detected mutation: refuse or archive.\n100|\tOnRace RacePolicy\n101|\t// Workspace carries the repository state the workspace\n102|\t// checkpoint seals.\n103|\tWorkspace WorkspaceRequest\n104|\t// Store receives payload blobs and published manifests.\n105|\tStore *localstore.ObjectStore\n106|\t// MaxSingleBytes bounds one captured member; zero selects\n107|\t// DefaultMaxSingleBytes. A larger member fails capture with\n108|\t// capability_unavailable before any manifest is published.\n109|\tMaxSingleBytes uint64\n110|\t// Hooks carries the crash and race seams; nil hooks are skipped.\n111|\tHooks CaptureHooks\n112|}\n113|\n114|// CaptureResult is one completed native capture: the sealed bytes,\n115|// their decoded forms, the measured digests, and the publish facts.\n116|type CaptureResult struct {\n117|\t// RawManifest and CaptureManifest carry the sealed manifest\n118|\t// bytes produced through the landed builders.\n119|\tRawManifest     []byte\n120|\tCaptureManifest []byte\n121|\t// WorkspaceBinding carries the sealed workspace checkpoint.\n122|\tWorkspaceBinding []byte\n123|\t// Decoded forms of the sealed manifests.\n124|\tRaw     clonebundle.RawObjectManifest\n125|\tCapture clonebundle.CaptureManifest\n126|\t// BoundaryKind is stable or unstable_archive, read back from\n127|\t// the sealed capture manifest.\n128|\tBoundaryKind string\n129|\t// PreDigest and PostDigest are the measured source digests.\n130|\tPreDigest  scalar.Digest\n131|\tPostDigest scalar.Digest\n132|\t// RawInstalled and CaptureInstalled report whether this run\n133|\t// installed the manifest blobs (a replay verifies and reuses).\n134|\tRawInstalled     bool\n135|\tCaptureInstalled bool\n136|\t// Logs carries the digest/size/media-only capture log lines.\n137|\tLogs []string\n138|}\n139|\n140|// Capture runs one native capture over the provider store: validate\n141|// the plan, checkpoint the workspace, walk and install payload\n142|// bytes, measure the source race, seal and publish both manifests.\n143|// The race gate precedes the seal (see ORDER-PIN below): a mutation\n144|// refuses, or seals unstable_archive output when archival was\n145|// explicitly acknowledged and requested.\n146|func Capture(request CaptureRequest) (*CaptureResult, error) {\n147|\tstate, err := newPipeline(request)\n148|\tif err != nil {\n149|\t\treturn nil, err\n150|\t}\n151|\tdefer state.close()\n152|\tif err := state.walkAndMeasure(); err != nil {\n153|\t\treturn nil, err\n154|\t}\n155|\t// ORDER-PIN: the source-race gate precedes any seal or publish.\n156|\t// N-race-order-capture moves this gate after sealAndPublish and\n157|\t// the killer reddens on the published manifests.\n158|\tif err := state.gateSourceRace(); err != nil {\n159|\t\treturn state.raceOutcome(err)\n160|\t}\n161|\treturn state.sealAndPublish(false)\n162|}\n163|\n164|// pipeline is one running capture: the validated plan, the open\n165|// store handles, the walked bytes, and the measured digests.\n166|type pipeline struct {\n167|\trequest        CaptureRequest\n168|\tlog            *CaptureLog\n169|\tguard          secprim.Guard\n170|\troot           *os.File\n171|\tplan           map[string]PlanItem\n172|\tplanKeys       []string\n173|\tlimit          uint64\n174|\tcaptured       []capturedMember\n175|\tpre            scalar.Digest\n176|\tpost           scalar.Digest\n177|\tpreLines       []string\n178|\tpostLines      []string\n179|\tworkspaceBytes []byte\n180|}\n181|\n182|func newPipeline(request CaptureRequest) (*pipeline, error) {\n183|\tif request.Store == nil {\n184|\t\treturn nil, invalid(\"capture requires an object store\")\n185|\t}\n186|\tif request.OnRace != RaceRefuse && request.OnRace != RaceArchive {\n187|\t\treturn nil, invalid(\"capture race policy %q is outside refuse|archive\", string(request.OnRace))\n188|\t}\n189|\tplan, err := checkPlan(request.Platform, request.Plan)\n190|\tif err != nil {\n191|\t\treturn nil, err\n192|\t}\n193|\tlimit := request.MaxSingleBytes\n194|\tif limit == 0 {\n195|\t\tlimit = DefaultMaxSingleBytes\n196|\t}\n197|\tworkspaceBytes, err := CheckpointWorkspace(request.Workspace)\n198|\tif err != nil {\n199|\t\treturn nil, err\n200|\t}\n201|\troot, err := secprim.OpenNoFollowDir(request.StoreRoot)\n202|\tif err != nil {\n203|\t\treturn nil, invalid(\"capture store root %q: %v\", request.StoreRoot, err)\n204|\t}\n205|\tguard, err := secprim.NewGuard(request.StoreRoot, request.Platform, nil)\n206|\tif err != nil {\n207|\t\t_ = root.Close()\n208|\t\treturn nil, invalid(\"capture store root %q: %v\", request.StoreRoot, err)\n209|\t}\n210|\tkeys := make([]string, 0, len(request.Plan))\n211|\tfor _, item := range request.Plan {\n212|\t\tkeys = append(keys, item.NativeKey)\n213|\t}\n214|\treturn &pipeline{\n215|\t\trequest:        request,\n216|\t\tlog:            &CaptureLog{},\n217|\t\tguard:          guard,\n218|\t\troot:           root,\n219|\t\tplan:           plan,\n220|\t\tplanKeys:       keys,\n221|\t\tlimit:          limit,\n222|\t\tworkspaceBytes: workspaceBytes,\n223|\t}, nil\n224|}\n225|\n226|func (state *pipeline) close() {\n227|\tif state.root != nil {\n228|\t\t_ = state.root.Close()\n229|\t\tstate.root = nil\n230|\t}\n231|}\n232|\n233|// walkAndMeasure enumerates the store, reconciles every member\n234|// against the plan, opens and installs every included-class member\n235|// through the Guard, and records the pre source digest. Excluded\n236|// members are never opened. It then runs the AfterWalk hook and\n237|// re-measures the post source digest. Any measurement failure\n238|// refuses; mutation itself is decided by gateSourceRace.\n239|func (state *pipeline) walkAndMeasure() error {\n240|\tobserved, err := enumerateStore(state.request.StoreRoot)\n241|\tif err != nil {\n242|\t\treturn err\n243|\t}\n244|\tbyKey := make(map[string]observedMember, len(observed))\n245|\tfor _, member := range observed {\n246|\t\tbyKey[member.key] = member\n247|\t\tif member.kind == memberDir {\n248|\t\t\tcontinue\n249|\t\t}\n250|\t\tif member.kind == memberOther && intermediatePrefix(state.plan, member.key) {\n251|\t\t\tcontinue\n252|\t\t}\n253|\t\tif _, err := planMemberClass(state.plan, member.key); err != nil {\n254|\t\t\treturn err\n255|\t\t}\n256|\t}\n257|\t// Early containment refusal: every included-class special\n258|\t// member (symlink, FIFO, device, socket) reaches the Guard,\n259|\t// which refuses it before any payload byte is read. The plan\n260|\t// loop would refuse it again; this pass fails fast with nothing\n261|\t// installed. Intermediates belong to their planned member's\n262|\t// open, which names the full member.\n263|\tfor _, member := range observed {\n264|\t\tif member.kind != memberOther {\n265|\t\t\tcontinue\n266|\t\t}\n267|\t\tif intermediatePrefix(state.plan, member.key) {\n268|\t\t\tcontinue\n269|\t\t}\n270|\t\tif excludedClass(state.plan[member.key].Class) {\n271|\t\t\tcontinue\n272|\t\t}\n273|\t\tif _, err := openMember(state.guard, state.root, member.key, state.limit); err != nil {\n274|\t\t\treturn err\n275|\t\t}\n276|\t}\n277|\tfor _, key := range state.planKeys {\n278|\t\titem := state.plan[key]\n279|\t\tif excludedClass(item.Class) {\n280|\t\t\tstate.log.Linef(\"exclude member=%q class=%s reason=%s\", key, item.Class, exclusionReason(item.Class))\n281|\t\t\tcontinue\n282|\t\t}\n283|\t\t_, present := byKey[key]\n284|\t\tif !present && !item.Required && !blockedAncestor(byKey, key) {\n285|\t\t\tstate.log.Linef(\"exclude member=%q class=%s reason=plan_optional_absent\", key, item.Class)\n286|\t\t\tcontinue\n287|\t\t}\n288|\t\tif !present && item.Required && !blockedAncestor(byKey, key) {\n289|\t\t\treturn invalid(\"capture plan candidate %q is required but absent from the store\", key)\n290|\t\t}\n291|\t\t// Every planned included member — file, directory, or\n292|\t\t// special shape — opens through the Guard, which admits\n293|\t\t// regular files and refuses the rest with the member named.\n294|\t\tpayload, err := openMember(state.guard, state.root, key, state.limit)\n295|\t\tif err != nil {\n296|\t\t\treturn err\n297|\t\t}\n298|\t\tdescriptor, err := BuildBlobDescriptor(payload)\n299|\t\tif err != nil {\n300|\t\t\treturn invalid(\"capture member %q: %v\", key, err)\n301|\t\t}\n302|\t\tif _, err := clonebundle.InstallRawBlob(state.request.Store, descriptor.Descriptor, bytes.NewReader(payload)); err != nil {\n303|\t\t\treturn invalid(\"capture member %q: %v\", key, err)\n304|\t\t}\n305|\t\tstate.log.Linef(\"capture member=%q class=%s digest=%s size=%d media=%s\", key, item.Class, descriptor.BlobID.String(), descriptor.Size, blobMediaType)\n306|\t\tstate.captured = append(state.captured, capturedMember{key: key, class: item.Class, payload: payload, descriptor: descriptor})\n307|\t}\n308|\tstate.pre, state.preLines = state.recordSource(observed, true)\n309|\tif state.request.Hooks.AfterWalk != nil {\n310|\t\tif err := state.request.Hooks.AfterWalk(state.request.StoreRoot); err != nil {\n311|\t\t\treturn invalid(\"capture hook refused after the walk: %v\", err)\n312|\t\t}\n313|\t}\n314|\treturn state.measurePost()\n315|}\n316|\n317|// recordSource builds the canonical source record over one\n318|// enumeration: directories contribute keys, specials contribute\n319|// keys, excluded files contribute key and size, and included files\n320|// contribute key, size, and content hash. Production always captured\n321|// every included file it enumerates; the unknown-content fallback\n322|// runs only when a mutant admits an unplanned member past the plan\n323|// gate, and then the post measurement still disagrees.\n324|func (state *pipeline) recordSource(observed []observedMember, useCaptured bool) (scalar.Digest, []string) {\n325|\thashByKey := make(map[string]capturedMember, len(state.captured))\n326|\tif useCaptured {\n327|\t\tfor _, member := range state.captured {\n328|\t\t\thashByKey[member.key] = member\n329|\t\t}\n330|\t}\n331|\trecord := &sourceRecord{}\n332|\tfor _, member := range observed {\n333|\t\tswitch member.kind {\n334|\t\tcase memberDir:\n335|\t\t\trecord.addDir(member.key)\n336|\t\tcase memberOther:\n337|\t\t\trecord.addOther(member.key)\n338|\t\tcase memberFile:\n339|\t\t\tclass := state.plan[member.key].Class\n340|\t\t\tif !useCaptured {\n341|\t\t\t\tif resolved, err := planMemberClass(state.plan, member.key); err == nil {\n342|\t\t\t\t\tclass = resolved\n343|\t\t\t\t} else {\n344|\t\t\t\t\tclass = \"\"\n345|\t\t\t\t}\n346|\t\t\t}\n347|\t\t\tif class == \"\" || excludedClass(class) {\n348|\t\t\t\trecord.addFile(member.key, member.size, \"-\")\n349|\t\t\t\tcontinue\n350|\t\t\t}\n351|\t\t\tif captured, ok := hashByKey[member.key]; useCaptured && ok {\n352|\t\t\t\trecord.addFile(member.key, captured.descriptor.Size, contentHash(captured.payload))\n353|\t\t\t\tcontinue\n354|\t\t\t}\n355|\t\t\tif !useCaptured {\n356|\t\t\t\tif payload, err := openMember(state.guard, state.root, member.key, state.limit); err == nil {\n357|\t\t\t\t\trecord.addFile(member.key, uint64(len(payload)), contentHash(payload))\n358|\t\t\t\t\tcontinue\n359|\t\t\t\t}\n360|\t\t\t}\n361|\t\t\trecord.addFile(member.key, member.size, \"-\")\n362|\t\t}\n363|\t}\n364|\treturn record.digest(), append([]string(nil), record.lines...)\n365|}\n366|\n367|// measurePost re-enumerates the store and re-reads every included\n368|// member through the Guard, recording the post source digest. A\n369|// member that cannot be re-read — appended, removed, retyped, or\n370|// unreadable — joins the record with unknown content, so the digest\n371|// comparison, not the read error, decides the race, and the refusal\n372|// names the member.\n373|func (state *pipeline) measurePost() error {\n374|\tobserved, err := enumerateStore(state.request.StoreRoot)\n375|\tif err != nil {\n376|\t\treturn err\n377|\t}\n378|\tstate.post, state.postLines = state.recordSource(observed, false)\n379|\treturn nil\n380|}\n381|\n382|// gateSourceRace decides the measured source race: equal pre and\n383|// post digests proceed; a difference refuses, or marks archive-only\n384|// output when archival was explicitly acknowledged and requested.\n385|// Size equality never decides: the comparison is digest equality\n386|// over content hashes.\n387|func (state *pipeline) gateSourceRace() error {\n388|\tif err := checkSourceRace(state.pre, state.post, state.preLines, state.postLines); err != nil {\n389|\t\treturn err\n390|\t}\n391|\treturn nil\n392|}\n393|\n394|// raceOutcome maps a detected race onto the requested policy: refuse\n395|// aborts with no sealed manifest; archive seals the core-created\n396|// unstable_archive form for archive-only output — never for a\n397|// target branch — and only with explicit operator acknowledgement.\n398|func (state *pipeline) raceOutcome(race error) (*CaptureResult, error) {\n399|\tif state.request.OnRace != RaceArchive {\n400|\t\treturn nil, race\n401|\t}\n402|\tif !state.request.OperatorExplicit {\n403|\t\treturn nil, invalid(\"capture archive requires explicit operator acknowledgement for source_not_quiescent\")\n404|\t}\n405|\treturn state.sealAndPublish(true)\n406|}\n407|\n408|// sealAndPublish seals both manifests through the landed builders,\n409|// re-decodes each before publishing, publishes in raw-then-capture\n410|// order through the object store, and returns the capture result.\n411|// The stable proof seals the two measured source digests: the race\n412|// gate proved them equal before this seal ran, so on the stable\n413|// path the sealed bytes equal either measurement, and the landed\n414|// builder refuses unequal digests. The N-race-order mutants move\n415|// the gate after this seal and the killers redden on the published\n416|// manifests, which proves the gate precedes the seal.\n417|func (state *pipeline) sealAndPublish(unstable bool) (*CaptureResult, error) {\n418|\trequest := state.request\n419|\tentries := make([]clonebundle.EntryInput, 0, len(state.captured))\n420|\tincluded := make([]string, 0, len(state.captured))\n421|\tfor _, member := range state.captured {\n422|\t\tentries = append(entries, clonebundle.EntryInput{\n423|\t\t\tNativeItemKey: member.key,\n424|\t\t\tClass:         member.class,\n425|\t\t\tByteCount:     member.descriptor.Size,\n426|\t\t\tBlobID:        member.descriptor.BlobID.String(),\n427|\t\t\tDescriptorID:  member.descriptor.DescriptorID.String(),\n428|\t\t\tDescriptor:    member.descriptor.Descriptor,\n429|\t\t})\n430|\t\tincluded = append(included, member.key)\n431|\t}\n432|\tidentityDigest, err := clonebundle.IdentityDigest(request.SourceIdentity, nil)\n433|\tif err != nil {\n434|\t\treturn nil, err\n435|\t}\n436|\trawBytes, err := clonebundle.BuildRawObjectManifest(\n437|\t\trequest.OperationID,\n438|\t\trequest.SourceEnvironment,\n439|\t\trequest.NativeSessionID,\n440|\t\tidentityDigest.String(),\n441|\t\trequest.CapturePlanDigest,\n442|\t\tentries,\n443|\t\tnil,\n444|\t)\n445|\tif err != nil {\n446|\t\treturn nil, err\n447|\t}\n448|\traw, err := clonebundle.DecodeRawObjectManifest(rawBytes)\n449|\tif err != nil {\n450|\t\treturn nil, invalid(\"sealed raw object manifest refused: %v\", err)\n451|\t}\n452|\t// Manifests publish under their content digest: the manifest ID\n453|\t// is the omit-self identity, not the digest of the sealed bytes.\n454|\trawPut, err := request.Store.PutBlob(scalar.SHA256Digest(rawBytes), uint64(len(rawBytes)), bytes.NewReader(rawBytes))\n455|\tif err != nil {\n456|\t\treturn nil, invalid(\"capture cannot publish the raw object manifest: %v\", err)\n457|\t}\n458|\tif request.Hooks.AfterRawPublish != nil {\n459|\t\tif err := request.Hooks.AfterRawPublish(); err != nil {\n460|\t\t\treturn nil, invalid(\"capture hook refused after the raw publish: %v\", err)\n461|\t\t}\n462|\t}\n463|\tboundary := clonebundle.BoundaryInput{\n464|\t\tKind:              \"stable\",\n465|\t\tProofKind:         request.ProofKind,\n466|\t\tGeneration:        request.Generation,\n467|\t\tPreCaptureDigest:  state.pre.String(),\n468|\t\tPostCaptureDigest: state.post.String(),\n469|\t\tInputBlocked:      request.InputBlocked,\n470|\t\tForegroundIdle:    request.ForegroundIdle,\n471|\t\tBackgroundIdle:    request.BackgroundIdle,\n472|\t}\n473|\tif request.SnapshotIdentity != nil {\n474|\t\tidentity := *request.SnapshotIdentity\n475|\t\tboundary.SnapshotIdentity = &identity\n476|\t}\n477|\tif unstable {\n478|\t\tboundary = clonebundle.BoundaryInput{\n479|\t\t\tKind:              \"unstable_archive\",\n480|\t\t\tGeneration:        request.Generation,\n481|\t\t\tPreCaptureDigest:  state.pre.String(),\n482|\t\t\tPostCaptureDigest: state.post.String(),\n483|\t\t\tCore:              true,\n484|\t\t}\n485|\t}\n486|\titems := make([]clonebundle.CaptureItemInput, 0, len(state.planKeys))\n487|\tcapturedByKey := make(map[string]capturedMember, len(state.captured))\n488|\tfor _, member := range state.captured {\n489|\t\tcapturedByKey[member.key] = member\n490|\t}\n491|\tfor _, key := range state.planKeys {\n492|\t\titem := state.plan[key]\n493|\t\tif member, ok := capturedByKey[key]; ok {\n494|\t\t\tdescriptor := member.descriptor.DescriptorID.String()\n495|\t\t\tcount := member.descriptor.Size\n496|\t\t\titems = append(items, clonebundle.CaptureItemInput{\n497|\t\t\t\tNativeItemKey:    key,\n498|\t\t\t\tClass:            item.Class,\n499|\t\t\t\tDisposition:      \"included\",\n500|\t\t\t\tBlobDescriptorID: &descriptor,\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c727","stream":{"kind":"session","id":"01a0b2d0-7ac7-7f03-8c97-ccb0ee9decb3"},"sequence":494,"recorded_at":1780531400000983,"record_type":"event","durability":"durable","causation_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","run_stream":{"kind":"run","id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2"},"task_stream":{"kind":"task","id":"01a0b2d2-1a3b-7dc1-a2b3-3f044f1b7286"},"task_id":"01a0b2d2-1a3b-7dc1-a2b3-3f044f1b7286","event":{"kind":"completed","task_id":"01a0b2d2-1a3b-7dc1-a2b3-3f044f1b7286"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c729","stream":{"kind":"session","id":"01a0b2d0-7ac7-7f03-8c97-ccb0ee9decb3"},"sequence":495,"recorded_at":1780531400000985,"record_type":"event","durability":"durable","causation_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","run_stream":{"kind":"run","id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2"},"call_id":"call_01a0b2d2141f7222b3dd12efaf4f937b","text":"Read text file `internal/clonesnap/capture.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"os\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/localstore\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n11|)\n12|\n13|// This file owns the native capture operation: Capture walks a real\n14|// provider store directory through the contained walk, installs\n15|// payload blobs through the landed no-replace discipline, seals the\n16|// Raw Object Manifest and Capture Manifest through the landed\n17|// builders, publishes both through the object store, and checkpoints\n18|// the workspace binding. The source-race gate runs after the\n19|// post-capture measurement and before any seal: a detected mutation\n20|// refuses, or seals the core-created unstable_archive form for\n21|// archive-only output when the operator explicitly acknowledged\n22|// archival. Nothing sealed here is trusted undecoded: every sealed\n23|// manifest re-decodes through the landed decoder before it is\n24|// published or returned.\n25|\n26|// RacePolicy decides a detected source mutation: RaceRefuse aborts\n27|// capture with no sealed manifest; RaceArchive seals the\n28|// unstable_archive form for archive-only output, which can never\n29|// enter a target branch.\n30|type RacePolicy string\n31|\n32|const (\n33|\t// RaceRefuse aborts capture on a detected source mutation.\n34|\tRaceRefuse RacePolicy = \"refuse\"\n35|\t// RaceArchive seals unstable_archive output on a detected\n36|\t// source mutation. It requires OperatorExplicit.\n37|\tRaceArchive RacePolicy = \"archive\"\n38|)\n39|\n40|// CaptureHooks carries the crash and race seams: AfterWalk runs\n41|// between the capture walk and the post-capture measurement (race\n42|// injection observes here), AfterRawPublish runs between the raw\n43|// manifest publish and the capture manifest seal (crash kill lands\n44|// here). A hook error aborts capture; a hook that never returns\n45|// (process kill) leaves at most the published prefix behind.\n46|type CaptureHooks struct {\n47|\tAfterWalk       func(storeRoot string) error\n48|\tAfterRawPublish func() error\n49|}\n50|\n51|// CaptureRequest is one native capture candidate over a provider\n52|// store directory.\n53|type CaptureRequest struct {\n54|\t// StoreRoot is the absolute provider store directory. Every\n55|\t// payload open descends from its verified handle.\n56|\tStoreRoot string\n57|\t// Platform governs member-name grammar.\n58|\tPlatform scalar.Platform\n59|\t// Plan carries the sorted unique capture-plan candidates.\n60|\tPlan []PlanItem\n61|\t// OperationID and BundleID identify the clone operation and\n62|\t// the logical bundle chain.\n63|\tOperationID string\n64|\tBundleID    string\n65|\t// SourceBasis binds ax_session or external_native source IDs.\n66|\tSourceBasis clonebundle.SourceBasisInput\n67|\t// SourceEnvironment carries the exact probed Environment Tuple\n68|\t// bytes.\n69|\tSourceEnvironment []byte\n70|\t// SourceIdentity is the sanitized NativeIdentity. Capture\n71|\t// re-validates it through the landed IdentityDigest before\n72|\t// anything seals: an identity decoding would refuse fails the\n73|\t// entry, so no sealed artifact carries it.\n74|\tSourceIdentity clonebundle.NativeIdentity\n75|\t// CapturePlanDigest is the exact core-validated capture-plan\n76|\t// digest.\n77|\tCapturePlanDigest string\n78|\t// NativeSessionID is the sanitized source native session ID.\n79|\tNativeSessionID string\n80|\t// CreatedByHostID and CreatedAt stamp the capture manifest.\n81|\tCreatedByHostID string\n82|\tCreatedAt       string\n83|\t// Generation is the immutable source generation token.\n84|\tGeneration string\n85|\t// ProofKind is the closed proof vocabulary:\n86|\t// closed_store|immutable_snapshot|verified_log_prefix|provider_quiescence.\n87|\tProofKind string\n88|\t// SnapshotIdentity pins an immutable snapshot; nil unless the\n89|\t// proof kind requires it.\n90|\tSnapshotIdentity *string\n91|\t// InputBlocked, ForegroundIdle, and BackgroundIdle are the\n92|\t// measured idle facts the stable proof seals.\n93|\tInputBlocked   bool\n94|\tForegroundIdle bool\n95|\tBackgroundIdle bool\n96|\t// OperatorExplicit acknowledges archive-only output when the\n97|\t// source is not quiescent.\n98|\tOperatorExplicit bool\n99|\t// OnRace decides a detected mutation: refuse or archive.\n100|\tOnRace RacePolicy\n101|\t// Workspace carries the repository state the workspace\n102|\t// checkpoint seals.\n103|\tWorkspace WorkspaceRequest\n104|\t// Store receives payload blobs and published manifests.\n105|\tStore *localstore.ObjectStore\n106|\t// MaxSingleBytes bounds one captured member; zero selects\n107|\t// DefaultMaxSingleBytes. A larger member fails capture with\n108|\t// capability_unavailable before any manifest is published.\n109|\tMaxSingleBytes uint64\n110|\t// Hooks carries the crash and race seams; nil hooks are skipped.\n111|\tHooks CaptureHooks\n112|}\n113|\n114|// CaptureResult is one completed native capture: the sealed bytes,\n115|// their decoded forms, the measured digests, and the publish facts.\n116|type CaptureResult struct {\n117|\t// RawManifest and CaptureManifest carry the sealed manifest\n118|\t// bytes produced through the landed builders.\n119|\tRawManifest     []byte\n120|\tCaptureManifest []byte\n121|\t// WorkspaceBinding carries the sealed workspace checkpoint.\n122|\tWorkspaceBinding []byte\n123|\t// Decoded forms of the sealed manifests.\n124|\tRaw     clonebundle.RawObjectManifest\n125|\tCapture clonebundle.CaptureManifest\n126|\t// BoundaryKind is stable or unstable_archive, read back from\n127|\t// the sealed capture manifest.\n128|\tBoundaryKind string\n129|\t// PreDigest and PostDigest are the measured source digests.\n130|\tPreDigest  scalar.Digest\n131|\tPostDigest scalar.Digest\n132|\t// RawInstalled and CaptureInstalled report whether this run\n133|\t// installed the manifest blobs (a replay verifies and reuses).\n134|\tRawInstalled     bool\n135|\tCaptureInstalled bool\n136|\t// Logs carries the digest/size/media-only capture log lines.\n137|\tLogs []string\n138|}\n139|\n140|// Capture runs one native capture over the provider store: validate\n141|// the plan, checkpoint the workspace, walk and install payload\n142|// bytes, measure the source race, seal and publish both manifests.\n143|// The race gate precedes the seal (see ORDER-PIN below): a mutation\n144|// refuses, or seals unstable_archive output when archival was\n145|// explicitly acknowledged and requested.\n146|func Capture(request CaptureRequest) (*CaptureResult, error) {\n147|\tstate, err := newPipeline(request)\n148|\tif err != nil {\n149|\t\treturn nil, err\n150|\t}\n151|\tdefer state.close()\n152|\tif err := state.walkAndMeasure(); err != nil {\n153|\t\treturn nil, err\n154|\t}\n155|\t// ORDER-PIN: the source-race gate precedes any seal or publish.\n156|\t// N-race-order-capture moves this gate after sealAndPublish and\n157|\t// the killer reddens on the published manifests.\n158|\tif err := state.gateSourceRace(); err != nil {\n159|\t\treturn state.raceOutcome(err)\n160|\t}\n161|\treturn state.sealAndPublish(false)\n162|}\n163|\n164|// pipeline is one running capture: the validated plan, the open\n165|// store handles, the walked bytes, and the measured digests.\n166|type pipeline struct {\n167|\trequest        CaptureRequest\n168|\tlog            *CaptureLog\n169|\tguard          secprim.Guard\n170|\troot           *os.File\n171|\tplan           map[string]PlanItem\n172|\tplanKeys       []string\n173|\tlimit          uint64\n174|\tcaptured       []capturedMember\n175|\tpre            scalar.Digest\n176|\tpost           scalar.Digest\n177|\tpreLines       []string\n178|\tpostLines      []string\n179|\tworkspaceBytes []byte\n180|}\n181|\n182|func newPipeline(request CaptureRequest) (*pipeline, error) {\n183|\tif request.Store == nil {\n184|\t\treturn nil, invalid(\"capture requires an object store\")\n185|\t}\n186|\tif request.OnRace != RaceRefuse && request.OnRace != RaceArchive {\n187|\t\treturn nil, invalid(\"capture race policy %q is outside refuse|archive\", string(request.OnRace))\n188|\t}\n189|\tplan, err := checkPlan(request.Platform, request.Plan)\n190|\tif err != nil {\n191|\t\treturn nil, err\n192|\t}\n193|\tlimit := request.MaxSingleBytes\n194|\tif limit == 0 {\n195|\t\tlimit = DefaultMaxSingleBytes\n196|\t}\n197|\tworkspaceBytes, err := CheckpointWorkspace(request.Workspace)\n198|\tif err != nil {\n199|\t\treturn nil, err\n200|\t}\n201|\troot, err := secprim.OpenNoFollowDir(request.StoreRoot)\n202|\tif err != nil {\n203|\t\treturn nil, invalid(\"capture store root %q: %v\", request.StoreRoot, err)\n204|\t}\n205|\tguard, err := secprim.NewGuard(request.StoreRoot, request.Platform, nil)\n206|\tif err != nil {\n207|\t\t_ = root.Close()\n208|\t\treturn nil, invalid(\"capture store root %q: %v\", request.StoreRoot, err)\n209|\t}\n210|\tkeys := make([]string, 0, len(request.Plan))\n211|\tfor _, item := range request.Plan {\n212|\t\tkeys = append(keys, item.NativeKey)\n213|\t}\n214|\treturn &pipeline{\n215|\t\trequest:        request,\n216|\t\tlog:            &CaptureLog{},\n217|\t\tguard:          guard,\n218|\t\troot:           root,\n219|\t\tplan:           plan,\n220|\t\tplanKeys:       keys,\n221|\t\tlimit:          limit,\n222|\t\tworkspaceBytes: workspaceBytes,\n223|\t}, nil\n224|}\n225|\n226|func (state *pipeline) close() {\n227|\tif state.root != nil {\n228|\t\t_ = state.root.Close()\n229|\t\tstate.root = nil\n230|\t}\n231|}\n232|\n233|// walkAndMeasure enumerates the store, reconciles every member\n234|// against the plan, opens and installs every included-class member\n235|// through the Guard, and records the pre source digest. Excluded\n236|// members are never opened. It then runs the AfterWalk hook and\n237|// re-measures the post source digest. Any measurement failure\n238|// refuses; mutation itself is decided by gateSourceRace.\n239|func (state *pipeline) walkAndMeasure() error {\n240|\tobserved, err := enumerateStore(state.request.StoreRoot)\n241|\tif err != nil {\n242|\t\treturn err\n243|\t}\n244|\tbyKey := make(map[string]observedMember, len(observed))\n245|\tfor _, member := range observed {\n246|\t\tbyKey[member.key] = member\n247|\t\tif member.kind == memberDir {\n248|\t\t\tcontinue\n249|\t\t}\n250|\t\tif member.kind == memberOther && intermediatePrefix(state.plan, member.key) {\n251|\t\t\tcontinue\n252|\t\t}\n253|\t\tif _, err := planMemberClass(state.plan, member.key); err != nil {\n254|\t\t\treturn err\n255|\t\t}\n256|\t}\n257|\t// Early containment refusal: every included-class special\n258|\t// member (symlink, FIFO, device, socket) reaches the Guard,\n259|\t// which refuses it before any payload byte is read. The plan\n260|\t// loop would refuse it again; this pass fails fast with nothing\n261|\t// installed. Intermediates belong to their planned member's\n262|\t// open, which names the full member.\n263|\tfor _, member := range observed {\n264|\t\tif member.kind != memberOther {\n265|\t\t\tcontinue\n266|\t\t}\n267|\t\tif intermediatePrefix(state.plan, member.key) {\n268|\t\t\tcontinue\n269|\t\t}\n270|\t\tif excludedClass(state.plan[member.key].Class) {\n271|\t\t\tcontinue\n272|\t\t}\n273|\t\tif _, err := openMember(state.guard, state.root, member.key, state.limit); err != nil {\n274|\t\t\treturn err\n275|\t\t}\n276|\t}\n277|\tfor _, key := range state.planKeys {\n278|\t\titem := state.plan[key]\n279|\t\tif excludedClass(item.Class) {\n280|\t\t\tstate.log.Linef(\"exclude member=%q class=%s reason=%s\", key, item.Class, exclusionReason(item.Class))\n281|\t\t\tcontinue\n282|\t\t}\n283|\t\t_, present := byKey[key]\n284|\t\tif !present && !item.Required && !blockedAncestor(byKey, key) {\n285|\t\t\tstate.log.Linef(\"exclude member=%q class=%s reason=plan_optional_absent\", key, item.Class)\n286|\t\t\tcontinue\n287|\t\t}\n288|\t\tif !present && item.Required && !blockedAncestor(byKey, key) {\n289|\t\t\treturn invalid(\"capture plan candidate %q is required but absent from the store\", key)\n290|\t\t}\n291|\t\t// Every planned included member — file, directory, or\n292|\t\t// special shape — opens through the Guard, which admits\n293|\t\t// regular files and refuses the rest with the member named.\n294|\t\tpayload, err := openMember(state.guard, state.root, key, state.limit)\n295|\t\tif err != nil {\n296|\t\t\treturn err\n297|\t\t}\n298|\t\tdescriptor, err := BuildBlobDescriptor(payload)\n299|\t\tif err != nil {\n300|\t\t\treturn invalid(\"capture member %q: %v\", key, err)\n301|\t\t}\n302|\t\tif _, err := clonebundle.InstallRawBlob(state.request.Store, descriptor.Descriptor, bytes.NewReader(payload)); err != nil {\n303|\t\t\treturn invalid(\"capture member %q: %v\", key, err)\n304|\t\t}\n305|\t\tstate.log.Linef(\"capture member=%q class=%s digest=%s size=%d media=%s\", key, item.Class, descriptor.BlobID.String(), descriptor.Size, blobMediaType)\n306|\t\tstate.captured = append(state.captured, capturedMember{key: key, class: item.Class, payload: payload, descriptor: descriptor})\n307|\t}\n308|\tstate.pre, state.preLines = state.recordSource(observed, true)\n309|\tif state.request.Hooks.AfterWalk != nil {\n310|\t\tif err := state.request.Hooks.AfterWalk(state.request.StoreRoot); err != nil {\n311|\t\t\treturn invalid(\"capture hook refused after the walk: %v\", err)\n312|\t\t}\n313|\t}\n314|\treturn state.measurePost()\n315|}\n316|\n317|// recordSource builds the canonical source record over one\n318|// enumeration: directories contribute keys, specials contribute\n319|// keys, excluded files contribute key and size, and included files\n320|// contribute key, size, and content hash. Production always captured\n321|// every included file it enumerates; the unknown-content fallback\n322|// runs only when a mutant admits an unplanned member past the plan\n323|// gate, and then the post measurement still disagrees.\n324|func (state *pipeline) recordSource(observed []observedMember, useCaptured bool) (scalar.Digest, []string) {\n325|\thashByKey := make(map[string]capturedMember, len(state.captured))\n326|\tif useCaptured {\n327|\t\tfor _, member := range state.captured {\n328|\t\t\thashByKey[member.key] = member\n329|\t\t}\n330|\t}\n331|\trecord := &sourceRecord{}\n332|\tfor _, member := range observed {\n333|\t\tswitch member.kind {\n334|\t\tcase memberDir:\n335|\t\t\trecord.addDir(member.key)\n336|\t\tcase memberOther:\n337|\t\t\trecord.addOther(member.key)\n338|\t\tcase memberFile:\n339|\t\t\tclass := state.plan[member.key].Class\n340|\t\t\tif !useCaptured {\n341|\t\t\t\tif resolved, err := planMemberClass(state.plan, member.key); err == nil {\n342|\t\t\t\t\tclass = resolved\n343|\t\t\t\t} else {\n344|\t\t\t\t\tclass = \"\"\n345|\t\t\t\t}\n346|\t\t\t}\n347|\t\t\tif class == \"\" || excludedClass(class) {\n348|\t\t\t\trecord.addFile(member.key, member.size, \"-\")\n349|\t\t\t\tcontinue\n350|\t\t\t}\n351|\t\t\tif captured, ok := hashByKey[member.key]; useCaptured && ok {\n352|\t\t\t\trecord.addFile(member.key, captured.descriptor.Size, contentHash(captured.payload))\n353|\t\t\t\tcontinue\n354|\t\t\t}\n355|\t\t\tif !useCaptured {\n356|\t\t\t\tif payload, err := openMember(state.guard, state.root, member.key, state.limit); err == nil {\n357|\t\t\t\t\trecord.addFile(member.key, uint64(len(payload)), contentHash(payload))\n358|\t\t\t\t\tcontinue\n359|\t\t\t\t}\n360|\t\t\t}\n361|\t\t\trecord.addFile(member.key, member.size, \"-\")\n362|\t\t}\n363|\t}\n364|\treturn record.digest(), append([]string(nil), record.lines...)\n365|}\n366|\n367|// measurePost re-enumerates the store and re-reads every included\n368|// member through the Guard, recording the post source digest. A\n369|// member that cannot be re-read — appended, removed, retyped, or\n370|// unreadable — joins the record with unknown content, so the digest\n371|// comparison, not the read error, decides the race, and the refusal\n372|// names the member.\n373|func (state *pipeline) measurePost() error {\n374|\tobserved, err := enumerateStore(state.request.StoreRoot)\n375|\tif err != nil {\n376|\t\treturn err\n377|\t}\n378|\tstate.post, state.postLines = state.recordSource(observed, false)\n379|\treturn nil\n380|}\n381|\n382|// gateSourceRace decides the measured source race: equal pre and\n383|// post digests proceed; a difference refuses, or marks archive-only\n384|// output when archival was explicitly acknowledged and requested.\n385|// Size equality never decides: the comparison is digest equality\n386|// over content hashes.\n387|func (state *pipeline) gateSourceRace() error {\n388|\tif err := checkSourceRace(state.pre, state.post, state.preLines, state.postLines); err != nil {\n389|\t\treturn err\n390|\t}\n391|\treturn nil\n392|}\n393|\n394|// raceOutcome maps a detected race onto the requested policy: refuse\n395|// aborts with no sealed manifest; archive seals the core-created\n396|// unstable_archive form for archive-only output — never for a\n397|// target branch — and only with explicit operator acknowledgement.\n398|func (state *pipeline) raceOutcome(race error) (*CaptureResult, error) {\n399|\tif state.request.OnRace != RaceArchive {\n400|\t\treturn nil, race\n401|\t}\n402|\tif !state.request.OperatorExplicit {\n403|\t\treturn nil, invalid(\"capture archive requires explicit operator acknowledgement for source_not_quiescent\")\n404|\t}\n405|\treturn state.sealAndPublish(true)\n406|}\n407|\n408|// sealAndPublish seals both manifests through the landed builders,\n409|// re-decodes each before publishing, publishes in raw-then-capture\n410|// order through the object store, and returns the capture result.\n411|// The stable proof seals the two measured source digests: the race\n412|// gate proved them equal before this seal ran, so on the stable\n413|// path the sealed bytes equal either measurement, and the landed\n414|// builder refuses unequal digests. The N-race-order mutants move\n415|// the gate after this seal and the killers redden on the published\n416|// manifests, which proves the gate precedes the seal.\n417|func (state *pipeline) sealAndPublish(unstable bool) (*CaptureResult, error) {\n418|\trequest := state.request\n419|\tentries := make([]clonebundle.EntryInput, 0, len(state.captured))\n420|\tincluded := make([]string, 0, len(state.captured))\n421|\tfor _, member := range state.captured {\n422|\t\tentries = append(entries, clonebundle.EntryInput{\n423|\t\t\tNativeItemKey: member.key,\n424|\t\t\tClass:         member.class,\n425|\t\t\tByteCount:     member.descriptor.Size,\n426|\t\t\tBlobID:        member.descriptor.BlobID.String(),\n427|\t\t\tDescriptorID:  member.descriptor.DescriptorID.String(),\n428|\t\t\tDescriptor:    member.descriptor.Descriptor,\n429|\t\t})\n430|\t\tincluded = append(included, member.key)\n431|\t}\n432|\tidentityDigest, err := clonebundle.IdentityDigest(request.SourceIdentity, nil)\n433|\tif err != nil {\n434|\t\treturn nil, err\n435|\t}\n436|\trawBytes, err := clonebundle.BuildRawObjectManifest(\n437|\t\trequest.OperationID,\n438|\t\trequest.SourceEnvironment,\n439|\t\trequest.NativeSessionID,\n440|\t\tidentityDigest.String(),\n441|\t\trequest.CapturePlanDigest,\n442|\t\tentries,\n443|\t\tnil,\n444|\t)\n445|\tif err != nil {\n446|\t\treturn nil, err\n447|\t}\n448|\traw, err := clonebundle.DecodeRawObjectManifest(rawBytes)\n449|\tif err != nil {\n450|\t\treturn nil, invalid(\"sealed raw object manifest refused: %v\", err)\n451|\t}\n452|\t// Manifests publish under their content digest: the manifest ID\n453|\t// is the omit-self identity, not the digest of the sealed bytes.\n454|\trawPut, err := request.Store.PutBlob(scalar.SHA256Digest(rawBytes), uint64(len(rawBytes)), bytes.NewReader(rawBytes))\n455|\tif err != nil {\n456|\t\treturn nil, invalid(\"capture cannot publish the raw object manifest: %v\", err)\n457|\t}\n458|\tif request.Hooks.AfterRawPublish != nil {\n459|\t\tif err := request.Hooks.AfterRawPublish(); err != nil {\n460|\t\t\treturn nil, invalid(\"capture hook refused after the raw publish: %v\", err)\n461|\t\t}\n462|\t}\n463|\tboundary := clonebundle.BoundaryInput{\n464|\t\tKind:              \"stable\",\n465|\t\tProofKind:         request.ProofKind,\n466|\t\tGeneration:        request.Generation,\n467|\t\tPreCaptureDigest:  state.pre.String(),\n468|\t\tPostCaptureDigest: state.post.String(),\n469|\t\tInputBlocked:      request.InputBlocked,\n470|\t\tForegroundIdle:    request.ForegroundIdle,\n471|\t\tBackgroundIdle:    request.BackgroundIdle,\n472|\t}\n473|\tif request.SnapshotIdentity != nil {\n474|\t\tidentity := *request.SnapshotIdentity\n475|\t\tboundary.SnapshotIdentity = &identity\n476|\t}\n477|\tif unstable {\n478|\t\tboundary = clonebundle.BoundaryInput{\n479|\t\t\tKind:              \"unstable_archive\",\n480|\t\t\tGeneration:        request.Generation,\n481|\t\t\tPreCaptureDigest:  state.pre.String(),\n482|\t\t\tPostCaptureDigest: state.post.String(),\n483|\t\t\tCore:              true,\n484|\t\t}\n485|\t}\n486|\titems := make([]clonebundle.CaptureItemInput, 0, len(state.planKeys))\n487|\tcapturedByKey := make(map[string]capturedMember, len(state.captured))\n488|\tfor _, member := range state.captured {\n489|\t\tcapturedByKey[member.key] = member\n490|\t}\n491|\tfor _, key := range state.planKeys {\n492|\t\titem := state.plan[key]\n493|\t\tif member, ok := capturedByKey[key]; ok {\n494|\t\t\tdescriptor := member.descriptor.DescriptorID.String()\n495|\t\t\tcount := member.descriptor.Size\n496|\t\t\titems = append(items, clonebundle.CaptureItemInput{\n497|\t\t\t\tNativeItemKey:    key,\n498|\t\t\t\tClass:            item.Class,\n499|\t\t\t\tDisposition:      \"included\",\n500|\t\t\t\tBlobDescriptorID: &descriptor,\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c72b","stream":{"kind":"session","id":"01a0b2d0-7ac7-7f03-8c97-ccb0ee9decb3"},"sequence":496,"recorded_at":1780531400000987,"record_type":"event","durability":"durable","causation_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","run_stream":{"kind":"run","id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2"},"call_id":"call_01a0b2d2161c74ca99d5070bcc566e9f","text":"Read text file `internal/clonesnap/project.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/localstore\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|)\n12|\n13|// This file owns target-branch admission and the projection output\n14|// whose existence pins the race-before-projection ordering.\n15|// CaptureAndProject runs the capture pipeline, then admits the\n16|// sealed capture manifest: the unstable_archive form can never enter\n17|// a target branch (the landed G2 gate decides), and the maximal_safe\n18|// fidelity profile requires a reconciled complete manifest (the\n19|// landed maximal-safe gate decides). Admission emits one admission\n20|// receipt into the target sink. Projection planning past admission\n21|// is the final leaf's scope; this receipt exists to prove admission\n22|// and ordering, not to plan a projection.\n23|\n24|// FidelityProfile is one Section 7.8 fidelity profile:\n25|// strict_exact|maximal_safe|compact|messages_only.\n26|type FidelityProfile string\n27|\n28|const (\n29|\t// FidelityStrictExact requests exact projection.\n30|\tFidelityStrictExact FidelityProfile = \"strict_exact\"\n31|\t// FidelityMaximalSafe requests maximal safe projection: it\n32|\t// requires a reconciled complete manifest with no unknown class.\n33|\tFidelityMaximalSafe FidelityProfile = \"maximal_safe\"\n34|\t// FidelityCompact requests compact projection.\n35|\tFidelityCompact FidelityProfile = \"compact\"\n36|\t// FidelityMessagesOnly requests messages-only projection.\n37|\tFidelityMessagesOnly FidelityProfile = \"messages_only\"\n38|)\n39|\n40|// validFidelityProfile reports whether the profile is in the Section\n41|// 7.8 closed vocabulary. Bound (P3-ζ′): sessadapter owns an\n42|// unexported copy of this four-profile table; the Story FINAL leaf\n43|// unifies or exports one owner. This package keeps its own closed\n44|// switch so the leaf boundary stays narrow.\n45|func validFidelityProfile(profile string) bool {\n46|\tswitch FidelityProfile(profile) {\n47|\tcase FidelityStrictExact, FidelityMaximalSafe, FidelityCompact, FidelityMessagesOnly:\n48|\t\treturn true\n49|\tdefault:\n50|\t\treturn false\n51|\t}\n52|}\n53|\n54|// ProjectRequest is one capture-and-project candidate: the capture\n55|// request, the target sink that receives the admission receipt, and\n56|// the fidelity profile admission decides.\n57|type ProjectRequest struct {\n58|\tCapture CaptureRequest\n59|\t// TargetSink receives the admission receipt. It stays empty\n60|\t// when capture refuses, races, or seals archive-only output.\n61|\tTargetSink *localstore.ObjectStore\n62|\t// FidelityProfile is the requested Section 7.8 profile.\n63|\tFidelityProfile string\n64|}\n65|\n66|// ProjectResult is one admitted capture: the capture result plus the\n67|// sealed admission receipt.\n68|type ProjectResult struct {\n69|\tCapture *CaptureResult\n70|\t// Receipt carries the sealed admission receipt bytes.\n71|\tReceipt []byte\n72|\t// ReceiptDigest is the blob identity of the receipt.\n73|\tReceiptDigest scalar.Digest\n74|\t// ReceiptInstalled reports whether this run installed the\n75|\t// receipt blob (a replay verifies and reuses).\n76|\tReceiptInstalled bool\n77|}\n78|\n79|// CaptureAndProject runs capture, then admits the sealed capture to\n80|// a target branch and emits the admission receipt. The race gate\n81|// precedes admission and emission (see ORDER-PIN below): a mutated\n82|// source refuses, or seals archive-only output that admission\n83|// rejects — no projection output is produced before the race is\n84|// decided.\n85|func CaptureAndProject(request ProjectRequest) (*ProjectResult, error) {\n86|\tif request.TargetSink == nil {\n87|\t\treturn nil, invalid(\"capture projection requires a target sink\")\n88|\t}\n89|\tstate, err := newPipeline(request.Capture)\n90|\tif err != nil {\n91|\t\treturn nil, err\n92|\t}\n93|\tdefer state.close()\n94|\tif err := state.walkAndMeasure(); err != nil {\n95|\t\treturn nil, err\n96|\t}\n97|\t// ORDER-PIN: the source-race gate precedes any seal, admission,\n98|\t// or projection output. N-race-order-project moves this gate\n99|\t// after admitAndEmit: the early seal then refuses with a seal\n100|\t// error instead of the race refusal, so the killer reddens on\n101|\t// the wrong error — and on any emitted receipt blob.\n102|\tif err := state.gateSourceRace(); err != nil {\n103|\t\tcaptured, raceErr := state.raceOutcome(err)\n104|\t\tif raceErr != nil {\n105|\t\t\treturn nil, raceErr\n106|\t\t}\n107|\t\t// Archive-only output never enters a target branch: the\n108|\t\t// admission gate below refuses it, so no receipt exists.\n109|\t\tif _, err := AdmitForTarget(captured.CaptureManifest, request.FidelityProfile); err != nil {\n110|\t\t\treturn nil, err\n111|\t\t}\n112|\t\treturn nil, invalid(\"capture archive unexpectedly admitted to a target branch\")\n113|\t}\n114|\tsealed, err := state.sealAndPublish(false)\n115|\tif err != nil {\n116|\t\treturn nil, err\n117|\t}\n118|\treturn state.admitAndEmit(request, sealed)\n119|}\n120|\n121|// admitAndEmit admits one sealed capture to the target branch and\n122|// emits its admission receipt into the target sink.\n123|func (state *pipeline) admitAndEmit(request ProjectRequest, sealed *CaptureResult) (*ProjectResult, error) {\n124|\tif _, err := AdmitForTarget(sealed.CaptureManifest, request.FidelityProfile); err != nil {\n125|\t\treturn nil, err\n126|\t}\n127|\treceipt, err := BuildAdmissionReceipt(sealed.Raw.ManifestID, sealed.Capture.ManifestID, request.FidelityProfile)\n128|\tif err != nil {\n129|\t\treturn nil, err\n130|\t}\n131|\tdigest := scalar.SHA256Digest(receipt)\n132|\tput, err := request.TargetSink.PutBlob(digest, uint64(len(receipt)), bytes.NewReader(receipt))\n133|\tif err != nil {\n134|\t\treturn nil, invalid(\"capture projection cannot publish the admission receipt: %v\", err)\n135|\t}\n136|\treturn &ProjectResult{\n137|\t\tCapture:          sealed,\n138|\t\tReceipt:          receipt,\n139|\t\tReceiptDigest:    digest,\n140|\t\tReceiptInstalled: put.Installed,\n141|\t}, nil\n142|}\n143|\n144|// AdmitForTarget admits one sealed capture manifest to a target\n145|// branch under the requested fidelity profile. The unstable_archive\n146|// form is archive-only output and always refuses; an unknown\n147|// fidelity profile refuses; maximal_safe requires a reconciled\n148|// complete manifest with no unknown class.\n149|func AdmitForTarget(captureManifest []byte, profile string) (clonebundle.CaptureManifest, error) {\n150|\tmanifest, err := clonebundle.DecodeCaptureManifest(captureManifest)\n151|\tif err != nil {\n152|\t\treturn clonebundle.CaptureManifest{}, err\n153|\t}\n154|\tif err := clonebundle.RefuseUnstableForTarget(manifest.CaptureBoundary); err != nil {\n155|\t\treturn clonebundle.CaptureManifest{}, err\n156|\t}\n157|\tif !validFidelityProfile(profile) {\n158|\t\treturn clonebundle.CaptureManifest{}, invalid(\"capture fidelity profile %q is outside strict_exact|maximal_safe|compact|messages_only\", profile)\n159|\t}\n160|\tif profile == \"maximal_safe\" {\n161|\t\tif err := clonebundle.RefuseMaximalSafeUnlessComplete(manifest); err != nil {\n162|\t\t\treturn clonebundle.CaptureManifest{}, err\n163|\t\t}\n164|\t}\n165|\treturn manifest, nil\n166|}\n167|\n168|// admissionReceiptSchema pins the admission receipt envelope\n169|// identity.\n170|const admissionReceiptSchema = \"urn:ax:internal:clonesnap-admission-receipt\"\n171|\n172|// BuildAdmissionReceipt seals one target admission receipt: the\n173|// admitted raw and capture manifest identities, the stable boundary\n174|// kind, and the fidelity profile. Only stable captures reach it;\n175|// AdmitForTarget refused everything else before this seal ran.\n176|func BuildAdmissionReceipt(rawManifestID, captureManifestID scalar.Digest, profile string) ([]byte, error) {\n177|\tif !validFidelityProfile(profile) {\n178|\t\treturn nil, invalid(\"capture fidelity profile %q is outside strict_exact|maximal_safe|compact|messages_only\", profile)\n179|\t}\n180|\tobject := map[string]any{\n181|\t\t\"schema\":                 admissionReceiptSchema,\n182|\t\t\"schema_version\":         \"1.0.0\",\n183|\t\t\"raw_object_manifest_id\": rawManifestID.String(),\n184|\t\t\"capture_manifest_id\":    captureManifestID.String(),\n185|\t\t\"boundary_kind\":          \"stable\",\n186|\t\t\"fidelity_profile\":       profile,\n187|\t\t\"extensions\":             map[string]any{},\n188|\t}\n189|\tplain, err := json.Marshal(object)\n190|\tif err != nil {\n191|\t\treturn nil, invalid(\"serialize admission receipt: %v\", err)\n192|\t}\n193|\tsealed, err := canonicaljson.Canonicalize(plain)\n194|\tif err != nil {\n195|\t\treturn nil, invalid(\"canonicalize admission receipt: %v\", err)\n196|\t}\n197|\treturn sealed, nil\n198|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
