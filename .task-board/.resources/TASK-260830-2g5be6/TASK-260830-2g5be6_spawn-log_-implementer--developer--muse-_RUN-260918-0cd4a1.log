{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9d9","stream":{"kind":"session","id":"01a0b2d0-7ac7-7f03-8c97-ccb0ee9decb3"},"sequence":839,"recorded_at":1780531400001673,"record_type":"event","durability":"durable","causation_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","run_stream":{"kind":"run","id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2"},"task_stream":{"kind":"task","id":"01a0b2d3-ac7a-7432-b181-a4c1378350d2"},"task_id":"01a0b2d3-ac7a-7432-b181-a4c1378350d2","event":{"kind":"output","task_id":"01a0b2d3-ac7a-7432-b181-a4c1378350d2","chunk":"Read text file `internal/clonesnap/project_test.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n9|)\n10|\n11|// Target admission evidence: AdmitForTarget drives the landed G2\n12|// and maximal-safe gates from the projection entry, and\n13|// CaptureAndProject emits the admission receipt only for admitted\n14|// stable captures.\n15|\n16|func projectValid(t *testing.T, profile string) (*ProjectResult, error) {\n17|\tt.Helper()\n18|\tstoreRoot := fixtureStore(t)\n19|\treturn CaptureAndProject(ProjectRequest{\n20|\t\tCapture:         validCaptureRequest(t, storeRoot, openTestStore(t)),\n21|\t\tTargetSink:      openTestStore(t),\n22|\t\tFidelityProfile: profile,\n23|\t})\n24|}\n25|\n26|func TestProjectAdmitsStableEveryProfile(t *testing.T) {\n27|\tfor _, profile := range []string{\"strict_exact\", \"maximal_safe\", \"compact\", \"messages_only\"} {\n28|\t\tprojected, err := projectValid(t, profile)\n29|\t\tif err != nil {\n30|\t\t\tt.Fatalf(\"CaptureAndProject(%q) error = %v\", profile, err)\n31|\t\t}\n32|\t\tif !projected.ReceiptInstalled {\n33|\t\t\tt.Fatalf(\"CaptureAndProject(%q) installed no receipt\", profile)\n34|\t\t}\n35|\t\tsealed := string(projected.Receipt)\n36|\t\tfor _, literal := range []string{\n37|\t\t\t`\"schema\":\"urn:ax:internal:clonesnap-admission-receipt\"`,\n38|\t\t\t`\"schema_version\":\"1.0.0\"`,\n39|\t\t\t`\"boundary_kind\":\"stable\"`,\n40|\t\t\t`\"fidelity_profile\":\"` + profile + `\"`,\n41|\t\t} {\n42|\t\t\tif !strings.Contains(sealed, literal) {\n43|\t\t\t\tt.Fatalf(\"receipt misses %s:\\n%s\", literal, sealed)\n44|\t\t\t}\n45|\t\t}\n46|\t\tif !strings.Contains(sealed, projected.Capture.Raw.ManifestID.String()) {\n47|\t\t\tt.Fatal(\"receipt misses the raw manifest identity\")\n48|\t\t}\n49|\t\tif !strings.Contains(sealed, projected.Capture.Capture.ManifestID.String()) {\n50|\t\t\tt.Fatal(\"receipt misses the capture manifest identity\")\n51|\t\t}\n52|\t}\n53|}\n54|\n55|func TestProjectRefusesUnstable(t *testing.T) {\n56|\tarchive := func(t *testing.T, generation string) error {\n57|\t\tt.Helper()\n58|\t\tstoreRoot := fixtureStore(t)\n59|\t\tstoreSink := openTestStore(t)\n60|\t\ttargetSink := openTestStore(t)\n61|\t\trequest := validCaptureRequest(t, storeRoot, storeSink)\n62|\t\trequest.OnRace = RaceArchive\n63|\t\trequest.OperatorExplicit = true\n64|\t\trequest.Generation = generation\n65|\t\trequest.Hooks.AfterWalk = mutateAfterWalk(t, func(root string) {\n66|\t\t\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"alpha-payload-bytez\"))\n67|\t\t})\n68|\t\tprojected, err := CaptureAndProject(ProjectRequest{\n69|\t\t\tCapture:         request,\n70|\t\t\tTargetSink:      targetSink,\n71|\t\t\tFidelityProfile: \"strict_exact\",\n72|\t\t})\n73|\t\tif err == nil {\n74|\t\t\tt.Fatalf(\"CaptureAndProject() = %+v, want a target refusal\", projected)\n75|\t\t}\n76|\t\t// Archive-only output never enters a target branch: the\n77|\t\t// refusal leaves the target sink empty, not only unadmitted.\n78|\t\tif blobs := listStoredBlobs(t, targetSink); len(blobs) != 0 {\n79|\t\t\tt.Fatalf(\"refused archive capture wrote %d blobs to the target sink, want none\", len(blobs))\n80|\t\t}\n81|\t\treturn err\n82|\t}\n83|\t// The unstable_archive form can never enter a target branch.\n84|\trequireRefusalDetail(t, archive(t, \"generation-9\"), \"unstable_archive\", \"target branch\")\n85|\t// A different generation still refuses after the\n86|\t// admit-exactly-generation-9 narrowing.\n87|\trequireRefusalDetail(t, archive(t, \"generation-10\"), \"unstable_archive\", \"target branch\")\n88|}\n89|\n90|func TestProjectRefusesUnstableDirect(t *testing.T) {\n91|\tstoreRoot := fixtureStore(t)\n92|\tstoreSink := openTestStore(t)\n93|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n94|\trequest.OnRace = RaceArchive\n95|\trequest.OperatorExplicit = true\n96|\trequest.Hooks.AfterWalk = mutateAfterWalk(t, func(root string) {\n97|\t\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"alpha-payload-bytez\"))\n98|\t})\n99|\tcaptured := mustCapture(t, request)\n100|\tif _, err := AdmitForTarget(captured.CaptureManifest, \"strict_exact\"); err == nil {\n101|\t\tt.Fatal(\"AdmitForTarget(unstable) = nil, want a refusal\")\n102|\t} else {\n103|\t\trequireRefusalDetail(t, err, \"unstable_archive\", \"target branch\")\n104|\t}\n105|}\n106|\n107|func TestProjectMaximalSafeRequiresComplete(t *testing.T) {\n108|\tadmitUnknown := func(t *testing.T, keys int) error {\n109|\t\tt.Helper()\n110|\t\tstoreRoot := t.TempDir()\n111|\t\twriteStoreFile(t, storeRoot, \"store/blob-a\", []byte(\"alpha-payload-bytes\"))\n112|\t\tplan := []PlanItem{{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true}}\n113|\t\tfor index := 0; index < keys; index++ {\n114|\t\t\tkey := \"store/zz-unknown-\" + string(rune('a'+index))\n115|\t\t\twriteStoreFile(t, storeRoot, key, []byte(\"unknown-bytes\"))\n116|\t\t\tplan = append(plan, PlanItem{NativeKey: key, Class: \"unknown\", Required: true})\n117|\t\t}\n118|\t\t// Sorted: blob-a, then the zz-unknown keys in order.\n119|\t\trequest := validCaptureRequest(t, storeRoot, openTestStore(t))\n120|\t\trequest.Plan = plan\n121|\t\tcaptured := mustCapture(t, request)\n122|\t\tif captured.Capture.RawComplete {\n123|\t\t\tt.Fatal(\"RawComplete = true with unknown-class items\")\n124|\t\t}\n125|\t\t_, err := AdmitForTarget(captured.CaptureManifest, \"maximal_safe\")\n126|\t\tif err == nil {\n127|\t\t\tt.Fatalf(\"AdmitForTarget(maximal_safe) = nil with %d unknown items\", keys)\n128|\t\t}\n129|\t\treturn err\n130|\t}\n131|\trequireRefusalDetail(t, admitUnknown(t, 2), \"maximal_safe\")\n132|\t// The two-item manifest still refuses after the\n133|\t// admit-exactly-three-items narrowing.\n134|\trequireRefusalDetail(t, admitUnknown(t, 1), \"maximal_safe\")\n135|}\n136|\n137|func TestProjectMaximalSafeAdmitsComplete(t *testing.T) {\n138|\tprojected, err := projectValid(t, \"maximal_safe\")\n139|\tif err != nil {\n140|\t\tt.Fatalf(\"CaptureAndProject(maximal_safe) error = %v\", err)\n141|\t}\n142|\tif !projected.ReceiptInstalled {\n143|\t\tt.Fatal(\"complete maximal_safe capture installed no receipt\")\n144|\t}\n145|}\n146|\n147|func TestProjectStrictExactAdmitsUnknown(t *testing.T) {\n148|\tstoreRoot := fixtureStore(t)\n149|\twriteStoreFile(t, storeRoot, \"store/zz-unknown\", []byte(\"unknown-kind-bytes\"))\n150|\tstoreSink := openTestStore(t)\n151|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n152|\trequest.Plan = []PlanItem{\n153|\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n154|\t\t{NativeKey: \"store/blob-b\", Class: \"durable_sidecar\", Required: true},\n155|\t\t{NativeKey: \"store/token-cache\", Class: \"credential\", Required: false},\n156|\t\t{NativeKey: \"store/zz-unknown\", Class: \"unknown\", Required: true},\n157|\t}\n158|\tprojected, err := CaptureAndProject(ProjectRequest{\n159|\t\tCapture:         request,\n160|\t\tTargetSink:      openTestStore(t),\n161|\t\tFidelityProfile: \"strict_exact\",\n162|\t})\n163|\tif err != nil {\n164|\t\tt.Fatalf(\"CaptureAndProject(strict_exact) error = %v\", err)\n165|\t}\n166|\tif projected.Capture.Capture.RawComplete {\n167|\t\tt.Fatal(\"RawComplete = true with an unknown-class item\")\n168|\t}\n169|}\n170|\n171|func TestProjectRefusesUnknownProfile(t *testing.T) {\n172|\tstoreRoot := fixtureStore(t)\n173|\tcaptured := mustCapture(t, validCaptureRequest(t, storeRoot, openTestStore(t)))\n174|\tif _, err := AdmitForTarget(captured.CaptureManifest, \"ultra\"); err == nil {\n175|\t\tt.Fatal(\"AdmitForTarget(ultra) = nil, want a refusal\")\n176|\t} else {\n177|\t\trequireRefusalDetail(t, err, `\"ultra\"`, \"strict_exact|maximal_safe|compact|messages_only\")\n178|\t}\n179|\tif _, err := projectValid(t, \"ultra\"); err == nil {\n180|\t\tt.Fatal(\"CaptureAndProject(ultra) admitted, want a refusal\")\n181|\t}\n182|}\n183|\n184|func TestProjectIsIdempotent(t *testing.T) {\n185|\t// A replayed capture installs the same blobs and publishes no\n186|\t// half-written manifest: every manifest blob re-decodes, the\n187|\t// replay verifies and reuses, and the bytes are identical.\n188|\tstoreRoot := fixtureStore(t)\n189|\tstoreSink := openTestStore(t)\n190|\ttargetSink := openTestStore(t)\n191|\tbuild := func() ProjectRequest {\n192|\t\treturn ProjectRequest{\n193|\t\t\tCapture:         validCaptureRequest(t, storeRoot, storeSink),\n194|\t\t\tTargetSink:      targetSink,\n195|\t\t\tFidelityProfile: \"strict_exact\",\n196|\t\t}\n197|\t}\n198|\tfirst, err := CaptureAndProject(build())\n199|\tif err != nil {\n200|\t\tt.Fatalf(\"CaptureAndProject() error = %v\", err)\n201|\t}\n202|\tsecond, err := CaptureAndProject(build())\n203|\tif err != nil {\n204|\t\tt.Fatalf(\"replayed CaptureAndProject() error = %v\", err)\n205|\t}\n206|\tif !bytes.Equal(first.Capture.RawManifest, second.Capture.RawManifest) {\n207|\t\tt.Fatal(\"replayed raw manifest bytes differ\")\n208|\t}\n209|\tif !bytes.Equal(first.Capture.CaptureManifest, second.Capture.CaptureManifest) {\n210|\t\tt.Fatal(\"replayed capture manifest bytes differ\")\n211|\t}\n212|\tif !bytes.Equal(first.Receipt, second.Receipt) {\n213|\t\tt.Fatal(\"replayed receipt bytes differ\")\n214|\t}\n215|\tif second.Capture.RawInstalled || second.Capture.CaptureInstalled || second.ReceiptInstalled {\n216|\t\tt.Fatal(\"replay installed instead of verifying and reusing\")\n217|\t}\n218|\tfor _, blob := range listStoredBlobs(t, storeSink) {\n219|\t\tif _, err := clonebundle.DecodeRawObjectManifest(blob.bytes); err == nil {\n220|\t\t\tcontinue\n221|\t\t}\n222|\t\tif _, err := clonebundle.DecodeCaptureManifest(blob.bytes); err == nil {\n223|\t\t\tcontinue\n224|\t\t}\n225|\t\t// Payload blobs decode as neither manifest; their digest\n226|\t\t// is their identity, verified at install.\n227|\t}\n228|\tcountBefore := len(listStoredBlobs(t, storeSink))\n229|\tthird, err := CaptureAndProject(build())\n230|\tif err != nil {\n231|\t\tt.Fatalf(\"second replay error = %v\", err)\n232|\t}\n233|\t_ = third\n234|\tif countAfter := len(listStoredBlobs(t, storeSink)); countAfter != countBefore {\n235|\t\tt.Fatalf(\"replay changed the blob count %d -> %d\", countBefore, countAfter)\n236|\t}\n237|}","final_result":true}}}
