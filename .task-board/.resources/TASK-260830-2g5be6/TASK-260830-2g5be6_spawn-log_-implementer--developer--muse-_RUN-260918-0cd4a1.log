{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c853","stream":{"kind":"session","id":"01a0b2d0-7ac7-7f03-8c97-ccb0ee9decb3"},"sequence":644,"recorded_at":1780531400001283,"record_type":"event","durability":"durable","causation_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","run_stream":{"kind":"run","id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2"},"call_id":"call_01a0b2d25bdd75589d33d2204a7258c9","text":"Read text file `internal/clonesnap/refusal_test.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"strings\"\n8|\t\"testing\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|var errHookRefused = errors.New(\"test hook refused\")\n15|\n16|// Refusal table: every capture gate refuses through the production\n17|// Capture entry with the offending member named. Each row drives the\n18|// entry; the mutant harness weakens each gate and the named killer\n19|// fails.\n20|\n21|func captureRefusal(t *testing.T, mutate func(*CaptureRequest), store func(t *testing.T, root string)) error {\n22|\tt.Helper()\n23|\tstoreRoot := fixtureStore(t)\n24|\tif store != nil {\n25|\t\tstore(t, storeRoot)\n26|\t}\n27|\tstoreSink := openTestStore(t)\n28|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n29|\tif mutate != nil {\n30|\t\tmutate(&request)\n31|\t}\n32|\tresult, err := Capture(request)\n33|\tif err == nil {\n34|\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n35|\t}\n36|\tif result != nil {\n37|\t\tt.Fatalf(\"Capture() returned a result with error %v\", err)\n38|\t}\n39|\tif !errors.Is(err, ErrInvalid) && !errors.Is(err, clonebundle.ErrInvalid) {\n40|\t\tt.Fatalf(\"Capture() error = %v, want ErrInvalid or the landed refusal\", err)\n41|\t}\n42|\treturn err\n43|}\n44|\n45|func requireRefusalDetail(t *testing.T, err error, fragments ...string) {\n46|\tt.Helper()\n47|\tfor _, fragment := range fragments {\n48|\t\tif !strings.Contains(err.Error(), fragment) {\n49|\t\t\tt.Fatalf(\"refusal %q misses %q\", err.Error(), fragment)\n50|\t\t}\n51|\t}\n52|}\n53|\n54|func TestCaptureRefusesUnplannedMember(t *testing.T) {\n55|\terr := captureRefusal(t, nil, func(t *testing.T, root string) {\n56|\t\twriteStoreFile(t, root, \"store/zz-extra\", []byte(\"unplanned-bytes\"))\n57|\t})\n58|\trequireRefusalDetail(t, err, `\"store/zz-extra\"`, \"not a plan candidate\")\n59|}\n60|\n61|func TestCaptureRefusesPrefixSibling(t *testing.T) {\n62|\t// An unplanned key that merely shares a prefix with a planned\n63|\t// key is still unplanned: the lookup is exact.\n64|\terr := captureRefusal(t, nil, func(t *testing.T, root string) {\n65|\t\twriteStoreFile(t, root, \"store/blob-a-evil\", []byte(\"prefix-sibling-bytes\"))\n66|\t})\n67|\trequireRefusalDetail(t, err, `\"store/blob-a-evil\"`, \"not a plan candidate\")\n68|}\n69|\n70|func TestCaptureRefusesRequiredMissing(t *testing.T) {\n71|\terr := captureRefusal(t, func(request *CaptureRequest) {\n72|\t\trequest.Plan = []PlanItem{\n73|\t\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n74|\t\t\t{NativeKey: \"store/blob-b\", Class: \"durable_sidecar\", Required: true},\n75|\t\t\t{NativeKey: \"store/must-have\", Class: \"durable_payload\", Required: true},\n76|\t\t\t{NativeKey: \"store/token-cache\", Class: \"credential\", Required: false},\n77|\t\t}\n78|\t}, nil)\n79|\trequireRefusalDetail(t, err, `\"store/must-have\"`, \"required but absent\")\n80|}\n81|\n82|func TestCaptureRefusesDuplicatePlanKey(t *testing.T) {\n83|\terr := captureRefusal(t, func(request *CaptureRequest) {\n84|\t\trequest.Plan = []PlanItem{\n85|\t\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n86|\t\t\t{NativeKey: \"store/blob-a\", Class: \"durable_sidecar\", Required: true},\n87|\t\t\t{NativeKey: \"store/token-cache\", Class: \"credential\", Required: false},\n88|\t\t}\n89|\t}, nil)\n90|\trequireRefusalDetail(t, err, \"capture plan keys are not sorted unique\")\n91|\t// An unsorted plan still refuses after the duplicate-only\n92|\t// narrowing: the second case pins the other half.\n93|\tunsorted := captureRefusal(t, func(request *CaptureRequest) {\n94|\t\trequest.Plan = []PlanItem{\n95|\t\t\t{NativeKey: \"store/blob-b\", Class: \"durable_sidecar\", Required: true},\n96|\t\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n97|\t\t}\n98|\t}, nil)\n99|\trequireRefusalDetail(t, unsorted, \"capture plan keys are not sorted unique\")\n100|}\n101|\n102|func TestCaptureRefusesUnsanitizedPlanKey(t *testing.T) {\n103|\t// A UUIDv7 native key is indistinguishable from a fabricated AX\n104|\t// Session identity: the sanitizer refuses it, and nothing is\n105|\t// installed before the refusal.\n106|\tstoreRoot := fixtureStore(t)\n107|\tstoreSink := openTestStore(t)\n108|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n109|\trequest.Plan = []PlanItem{\n110|\t\t{NativeKey: fixtureUUIDKey, Class: \"durable_payload\", Required: true},\n111|\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n112|\t}\n113|\tresult, err := Capture(request)\n114|\tif err == nil {\n115|\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n116|\t}\n117|\trequireRefusalDetail(t, err, fixtureUUIDKey, \"UUIDv7\")\n118|\tif blobs := listStoredBlobs(t, storeSink); len(blobs) != 0 {\n119|\t\tt.Fatalf(\"refused capture installed %d blobs, want none\", len(blobs))\n120|\t}\n121|}\n122|\n123|func TestCaptureRefusesAbsolutePlanKey(t *testing.T) {\n124|\terr := captureRefusal(t, func(request *CaptureRequest) {\n125|\t\trequest.Plan = []PlanItem{\n126|\t\t\t{NativeKey: \"/abs-plan-key\", Class: \"durable_payload\", Required: true},\n127|\t\t}\n128|\t}, nil)\n129|\trequireRefusalDetail(t, err, \"absolute source path\")\n130|}\n131|\n132|func TestCaptureRefusesParentPlanKey(t *testing.T) {\n133|\terr := captureRefusal(t, func(request *CaptureRequest) {\n134|\t\trequest.Plan = []PlanItem{\n135|\t\t\t{NativeKey: \"store/../escape\", Class: \"durable_payload\", Required: true},\n136|\t\t}\n137|\t}, nil)\n138|\trequireRefusalDetail(t, err, `\"store/../escape\"`, \"escapes the store root\")\n139|}\n140|\n141|func TestCaptureRefusesMysteryPlanClass(t *testing.T) {\n142|\tstoreRoot := fixtureStore(t)\n143|\twriteStoreFile(t, storeRoot, \"store/blob-c\", []byte(\"mystery-class-bytes\"))\n144|\tstoreSink := openTestStore(t)\n145|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n146|\trequest.Plan = []PlanItem{\n147|\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n148|\t\t{NativeKey: \"store/blob-c\", Class: \"mystery\", Required: true},\n149|\t}\n150|\tresult, err := Capture(request)\n151|\tif err == nil {\n152|\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n153|\t}\n154|\trequireRefusalDetail(t, err, `\"mystery\"`, \"nine-class vocabulary\")\n155|\tif blobs := listStoredBlobs(t, storeSink); len(blobs) != 0 {\n156|\t\tt.Fatalf(\"refused capture installed %d blobs, want none\", len(blobs))\n157|\t}\n158|}\n159|\n160|func TestCaptureRefusesDirectoryMember(t *testing.T) {\n161|\tstoreRoot := t.TempDir()\n162|\tif err := os.Mkdir(filepath.Join(storeRoot, \"store\"), 0o700); err != nil {\n163|\t\tt.Fatal(err)\n164|\t}\n165|\tstoreSink := openTestStore(t)\n166|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n167|\trequest.Plan = []PlanItem{\n168|\t\t{NativeKey: \"store\", Class: \"durable_payload\", Required: true},\n169|\t}\n170|\tresult, err := Capture(request)\n171|\tif err == nil {\n172|\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n173|\t}\n174|\trequireRefusalDetail(t, err, `\"store\"`)\n175|}\n176|\n177|func TestCaptureRefusesSymlinkedIntermediate(t *testing.T) {\n178|\tstoreRoot := t.TempDir()\n179|\toutside := t.TempDir()\n180|\tif err := os.WriteFile(filepath.Join(outside, \"file\"), []byte(\"outside-bytes\"), 0o600); err != nil {\n181|\t\tt.Fatal(err)\n182|\t}\n183|\tif err := os.Symlink(outside, filepath.Join(storeRoot, \"link-escape\")); err != nil {\n184|\t\tt.Fatal(err)\n185|\t}\n186|\tstoreSink := openTestStore(t)\n187|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n188|\trequest.Plan = []PlanItem{\n189|\t\t{NativeKey: \"link-escape/file\", Class: \"durable_payload\", Required: true},\n190|\t}\n191|\tresult, err := Capture(request)\n192|\tif err == nil {\n193|\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n194|\t}\n195|\trequireRefusalDetail(t, err, \"link-escape/file\", \"symlink\")\n196|\tif blobs := listStoredBlobs(t, storeSink); blobsContain(blobs, \"outside-bytes\") {\n197|\t\tt.Fatal(\"capture installed bytes from outside the store root\")\n198|\t}\n199|}\n200|\n201|func TestCaptureRefusesOptionalSymlinkedIntermediate(t *testing.T) {\n202|\t// An OPTIONAL member behind a symlinked intermediate still\n203|\t// refuses: the blocked ancestor routes the member to its Guard\n204|\t// open, which names the full member — it never seals as\n205|\t// plan_optional_absent.\n206|\tstoreRoot := t.TempDir()\n207|\toutside := t.TempDir()\n208|\tif err := os.WriteFile(filepath.Join(outside, \"file\"), []byte(\"outside-bytes\"), 0o600); err != nil {\n209|\t\tt.Fatal(err)\n210|\t}\n211|\tif err := os.Symlink(outside, filepath.Join(storeRoot, \"link-escape\")); err != nil {\n212|\t\tt.Fatal(err)\n213|\t}\n214|\tstoreSink := openTestStore(t)\n215|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n216|\trequest.Plan = []PlanItem{\n217|\t\t{NativeKey: \"link-escape/file\", Class: \"durable_payload\", Required: false},\n218|\t}\n219|\tresult, err := Capture(request)\n220|\tif err == nil {\n221|\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n222|\t}\n223|\trequireRefusalDetail(t, err, \"link-escape/file\", \"symlink\")\n224|\tif blobs := listStoredBlobs(t, storeSink); blobsContain(blobs, \"outside-bytes\") {\n225|\t\tt.Fatal(\"capture installed bytes from outside the store root\")\n226|\t}\n227|}\n228|\n229|func TestCaptureRefusesTrailingSymlink(t *testing.T) {\n230|\tstoreRoot := t.TempDir()\n231|\tif err := os.WriteFile(filepath.Join(storeRoot, \"real-target\"), []byte(\"real-bytes\"), 0o600); err != nil {\n232|\t\tt.Fatal(err)\n233|\t}\n234|\tif err := os.Symlink(\"real-target\", filepath.Join(storeRoot, \"link-escape\")); err != nil {\n235|\t\tt.Fatal(err)\n236|\t}\n237|\tstoreSink := openTestStore(t)\n238|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n239|\trequest.Plan = []PlanItem{\n240|\t\t{NativeKey: \"link-escape\", Class: \"durable_payload\", Required: true},\n241|\t\t{NativeKey: \"real-target\", Class: \"durable_payload\", Required: true},\n242|\t}\n243|\tresult, err := Capture(request)\n244|\tif err == nil {\n245|\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n246|\t}\n247|\trequireRefusalDetail(t, err, \"link-escape\", \"symlink\")\n248|}\n249|\n250|func TestCaptureRefusesInvalidSourceIdentity(t *testing.T) {\n251|\t// P3-η at this leaf's entry: Capture re-validates\n252|\t// SourceIdentity through the landed IdentityDigest before\n253|\t// anything seals — an identity decoding would refuse fails\n254|\t// here, and no manifest is published.\n255|\trefuseIdentity := func(t *testing.T, mutate func(*clonebundle.NativeIdentity)) error {\n256|\t\tt.Helper()\n257|\t\tstoreRoot := fixtureStore(t)\n258|\t\tstoreSink := openTestStore(t)\n259|\t\trequest := validCaptureRequest(t, storeRoot, storeSink)\n260|\t\tmutate(&request.SourceIdentity)\n261|\t\tresult, err := Capture(request)\n262|\t\tif err == nil {\n263|\t\t\tt.Fatalf(\"Capture() = %+v, want an identity refusal\", result)\n264|\t\t}\n265|\t\tif result != nil {\n266|\t\t\tt.Fatalf(\"Capture() returned a result with error %v\", err)\n267|\t\t}\n268|\t\tfor _, blob := range listStoredBlobs(t, storeSink) {\n269|\t\t\tif _, err := clonebundle.DecodeRawObjectManifest(blob.bytes); err == nil {\n270|\t\t\t\tt.Fatal(\"refused identity sealed a raw manifest\")\n271|\t\t\t}\n272|\t\t\tif _, err := clonebundle.DecodeCaptureManifest(blob.bytes); err == nil {\n273|\t\t\t\tt.Fatal(\"refused identity sealed a capture manifest\")\n274|\t\t\t}\n275|\t\t}\n276|\t\treturn err\n277|\t}\n278|\toverlong := strings.Repeat(\"n\", 513)\n279|\trequireRefusalDetail(t, refuseIdentity(t, func(identity *clonebundle.NativeIdentity) {\n280|\t\tidentity.NativeSessionID = overlong\n281|\t}), \"native identity digest seals no undecodable identity\")\n282|\trequireRefusalDetail(t, refuseIdentity(t, func(identity *clonebundle.NativeIdentity) {\n283|\t\tidentity.IdentityKind = \"bogus\"\n284|\t}), \"native identity digest seals no undecodable identity\")\n285|\trequireRefusalDetail(t, refuseIdentity(t, func(identity *clonebundle.NativeIdentity) {\n286|\t\tidentity.LogicalWorkspaceID = scalar.UUIDv7{}\n287|\t}), \"native identity digest seals no undecodable identity\")\n288|\trequireRefusalDetail(t, refuseIdentity(t, func(identity *clonebundle.NativeIdentity) {\n289|\t\tidentity.NativeSessionID = \"native\\xff\"\n290|\t}), \"native key is not valid UTF-8\")\n291|\trequireRefusalDetail(t, refuseIdentity(t, func(identity *clonebundle.NativeIdentity) {\n292|\t\tidentity.NativeSessionID = \"/abs/native\"\n293|\t}), \"absolute source path\")\n294|}\n295|\n296|func TestCaptureRefusesBadTuple(t *testing.T) {\n297|\terr := captureRefusal(t, func(request *CaptureRequest) {\n298|\t\trequest.SourceEnvironment = []byte(`{\"environment_id\":\"snap.env\"}`)\n299|\t}, nil)\n300|\trequireRefusalDetail(t, err, \"Environment Tuple\")\n301|}\n302|\n303|func TestCaptureRefusesMixedSourceBasis(t *testing.T) {\n304|\terr := captureRefusal(t, func(request *CaptureRequest) {\n305|\t\trequest.SourceBasis.ExternalSourceRef = \"also-native\"\n306|\t}, nil)\n307|\trequireRefusalDetail(t, err, \"external source reference\")\n308|}\n309|\n310|func TestCaptureRefusesUnknownBasisKind(t *testing.T) {\n311|\terr := captureRefusal(t, func(request *CaptureRequest) {\n312|\t\trequest.SourceBasis.Kind = \"maybe\"\n313|\t}, nil)\n314|\trequireRefusalDetail(t, err, \"ax_session|external_native\")\n315|}\n316|\n317|func TestCaptureRefusesUnsanitizedExternalRef(t *testing.T) {\n318|\terr := captureRefusal(t, func(request *CaptureRequest) {\n319|\t\trequest.SourceBasis = clonebundle.SourceBasisInput{\n320|\t\t\tKind:              \"external_native\",\n321|\t\t\tExternalSourceRef: \"/absolute-source-ref\",\n322|\t\t}\n323|\t}, nil)\n324|\trequireRefusalDetail(t, err, \"absolute source path\")\n325|}\n326|\n327|func TestCaptureRefusesUnknownProofKind(t *testing.T) {\n328|\terr := captureRefusal(t, func(request *CaptureRequest) {\n329|\t\trequest.ProofKind = \"maybe_stable\"\n330|\t}, nil)\n331|\trequireRefusalDetail(t, err, \"closed proof vocabulary\")\n332|}\n333|\n334|func TestCaptureRefusesIdleCouplingViolation(t *testing.T) {\n335|\terr := captureRefusal(t, func(request *CaptureRequest) {\n336|\t\trequest.InputBlocked = false\n337|\t}, nil)\n338|\trequireRefusalDetail(t, err, \"input_blocked\")\n339|}\n340|\n341|func TestCaptureRefusesSnapshotIdentityCoupling(t *testing.T) {\n342|\tidentity := fixtureDigest(\"snap-snapshot-identity\")\n343|\terr := captureRefusal(t, func(request *CaptureRequest) {\n344|\t\trequest.SnapshotIdentity = &identity\n345|\t}, nil)\n346|\trequireRefusalDetail(t, err, \"null snapshot identity\")\n347|\tmissing := captureRefusal(t, func(request *CaptureRequest) {\n348|\t\trequest.ProofKind = \"immutable_snapshot\"\n349|\t}, nil)\n350|\trequireRefusalDetail(t, missing, \"non-null snapshot identity\")\n351|}\n352|\n353|func TestCaptureRefusesEmptyGeneration(t *testing.T) {\n354|\terr := captureRefusal(t, func(request *CaptureRequest) {\n355|\t\trequest.Generation = \"\"\n356|\t}, nil)\n357|\trequireRefusalDetail(t, err, \"string[1..512]\")\n358|}\n359|\n360|func TestCaptureRefusesBadPlanDigest(t *testing.T) {\n361|\terr := captureRefusal(t, func(request *CaptureRequest) {\n362|\t\trequest.CapturePlanDigest = \"not-a-digest\"\n363|\t}, nil)\n364|\trequireRefusalDetail(t, err, \"capture_plan_digest\")\n365|}\n366|\n367|func TestCaptureRefusesBadRacePolicy(t *testing.T) {\n368|\terr := captureRefusal(t, func(request *CaptureRequest) {\n369|\t\trequest.OnRace = RacePolicy(\"maybe\")\n370|\t}, nil)\n371|\trequireRefusalDetail(t, err, \"refuse|archive\")\n372|}\n373|\n374|func TestCaptureRefusesNilStore(t *testing.T) {\n375|\tstoreRoot := fixtureStore(t)\n376|\trequest := validCaptureRequest(t, storeRoot, openTestStore(t))\n377|\trequest.Store = nil\n378|\tresult, err := Capture(request)\n379|\tif err == nil {\n380|\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n381|\t}\n382|\trequireRefusalDetail(t, err, \"object store\")\n383|}\n384|\n385|func TestCaptureRefusesHookError(t *testing.T) {\n386|\terr := captureRefusal(t, func(request *CaptureRequest) {\n387|\t\trequest.Hooks.AfterWalk = func(string) error { return errHookRefused }\n388|\t}, nil)\n389|\trequireRefusalDetail(t, err, \"hook refused\")\n390|}\n391|\n392|func TestCaptureRefusesOversizedMember(t *testing.T) {\n393|\trefuseSized := func(t *testing.T, payload string) error {\n394|\t\tt.Helper()\n395|\t\tstoreRoot := t.TempDir()\n396|\t\twriteStoreFile(t, storeRoot, \"store/only\", []byte(payload))\n397|\t\tstoreSink := openTestStore(t)\n398|\t\trequest := validCaptureRequest(t, storeRoot, storeSink)\n399|\t\trequest.MaxSingleBytes = 10\n400|\t\trequest.Plan = []PlanItem{{NativeKey: \"store/only\", Class: \"durable_payload\", Required: true}}\n401|\t\tresult, err := Capture(request)\n402|\t\tif err == nil {\n403|\t\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n404|\t\t}\n405|\t\treturn err\n406|\t}\n407|\t// An 11-byte member refuses under a 10-byte bound.\n408|\trequireRefusalDetail(t, refuseSized(t, \"0123456789a\"), `\"store/only\"`, \"capability_unavailable\")\n409|\t// A 12-byte member still refuses after the admit-exactly-11\n410|\t// narrowing: the second case pins the other half.\n411|\trequireRefusalDetail(t, refuseSized(t, \"0123456789ab\"), `\"store/only\"`, \"capability_unavailable\")\n412|}\n413|\n414|func TestCaptureRefusesSparseOversizedMember(t *testing.T) {\n415|\t// A 128 GiB + 1 sparse member refuses with\n416|\t// capability_unavailable under the default bound without\n417|\t// reading its bytes and without publishing any manifest.\n418|\tstoreRoot := fixtureStore(t)\n419|\tsparse := filepath.Join(storeRoot, \"store\", \"sparse-huge\")\n420|\tfile, err := os.OpenFile(sparse, os.O_CREATE|os.O_WRONLY, 0o600)\n421|\tif err != nil {\n422|\t\tt.Fatal(err)\n423|\t}\n424|\tif err := file.Truncate(137438953472 + 1); err != nil {\n425|\t\t_ = file.Close()\n426|\t\tt.Skipf(\"sparse truncate: %v\", err)\n427|\t}\n428|\tif err := file.Close(); err != nil {\n429|\t\tt.Fatal(err)\n430|\t}\n431|\tstoreSink := openTestStore(t)\n432|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n433|\trequest.Plan = []PlanItem{\n434|\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n435|\t\t{NativeKey: \"store/blob-b\", Class: \"durable_sidecar\", Required: true},\n436|\t\t{NativeKey: \"store/sparse-huge\", Class: \"durable_payload\", Required: true},\n437|\t\t{NativeKey: \"store/token-cache\", Class: \"credential\", Required: false},\n438|\t}\n439|\tresult, err := Capture(request)\n440|\tif err == nil {\n441|\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n442|\t}\n443|\trequireRefusalDetail(t, err, `\"store/sparse-huge\"`, \"capability_unavailable\")\n444|\tfor _, blob := range listStoredBlobs(t, storeSink) {\n445|\t\tif _, err := clonebundle.DecodeRawObjectManifest(blob.bytes); err == nil {\n446|\t\t\tt.Fatal(\"oversized capture published a raw manifest\")\n447|\t\t}\n448|\t\tif _, err := clonebundle.DecodeCaptureManifest(blob.bytes); err == nil {\n449|\t\t\tt.Fatal(\"oversized capture published a capture manifest\")\n450|\t\t}\n451|\t}\n452|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
