{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c761","stream":{"kind":"session","id":"01a0b2d0-7ac7-7f03-8c97-ccb0ee9decb3"},"sequence":523,"recorded_at":1780531400001041,"record_type":"event","durability":"durable","causation_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2","run_stream":{"kind":"run","id":"6c09b2f8-d07d-42a7-92aa-11c55130fea2"},"task_stream":{"kind":"task","id":"01a0b2d2-2522-7471-a996-42fe143e13f9"},"task_id":"01a0b2d2-2522-7471-a996-42fe143e13f9","event":{"kind":"output","task_id":"01a0b2d2-2522-7471-a996-42fe143e13f9","chunk":"Read text file `internal/clonesnap/race_test.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"strings\"\n8|\t\"testing\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n11|)\n12|\n13|// Source-race evidence: a changed byte, a changed size, an appended\n14|// record, and a replaced file each refuse — or seal the\n15|// unstable_archive form with source_not_quiescent — and the mutation\n16|// check runs before any seal or projection output. The AfterWalk\n17|// hook injects each mutation deterministically between the capture\n18|// walk and the post-capture measurement.\n19|\n20|func mutateAfterWalk(t *testing.T, mutate func(root string)) func(string) error {\n21|\tt.Helper()\n22|\treturn func(root string) error {\n23|\t\tmutate(root)\n24|\t\treturn nil\n25|\t}\n26|}\n27|\n28|func raceRefusal(t *testing.T, mutate func(root string)) error {\n29|\tt.Helper()\n30|\tstoreRoot := fixtureStore(t)\n31|\tstoreSink := openTestStore(t)\n32|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n33|\trequest.Hooks.AfterWalk = mutateAfterWalk(t, mutate)\n34|\tresult, err := Capture(request)\n35|\tif err == nil {\n36|\t\tt.Fatalf(\"Capture() = %+v, want a race refusal\", result)\n37|\t}\n38|\trequireRefusalDetail(t, err, \"source mutated during capture\")\n39|\treturn err\n40|}\n41|\n42|func TestCaptureRaceChangedByte(t *testing.T) {\n43|\t// The first case mutates blob-a at equal size: size equality is\n44|\t// never proof, so the content digests still disagree.\n45|\terr := raceRefusal(t, func(root string) {\n46|\t\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"alpha-payload-bytez\"))\n47|\t})\n48|\trequireRefusalDetail(t, err, `\"store/blob-a\"`, \"capture digests differ\")\n49|\t// The second case mutates blob-b: other members still refuse\n50|\t// after the admit-exactly-blob-a narrowing.\n51|\tother := raceRefusal(t, func(root string) {\n52|\t\twriteStoreFile(t, root, \"store/blob-b\", []byte(\"beta-payload-bytez\"))\n53|\t})\n54|\trequireRefusalDetail(t, other, `\"store/blob-b\"`, \"capture digests differ\")\n55|}\n56|\n57|func TestCaptureRaceChangedSize(t *testing.T) {\n58|\terr := raceRefusal(t, func(root string) {\n59|\t\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"alpha-payload-bytes-extended\"))\n60|\t})\n61|\trequireRefusalDetail(t, err, `\"store/blob-a\"`)\n62|}\n63|\n64|func TestCaptureRaceAppendedRecord(t *testing.T) {\n65|\terr := raceRefusal(t, func(root string) {\n66|\t\twriteStoreFile(t, root, \"store/blob-appended\", []byte(\"appended-bytes\"))\n67|\t})\n68|\trequireRefusalDetail(t, err, `\"store/blob-appended\"`)\n69|}\n70|\n71|func TestCaptureRaceReplacedFile(t *testing.T) {\n72|\terr := raceRefusal(t, func(root string) {\n73|\t\tif err := os.Remove(filepath.Join(root, \"store\", \"blob-a\")); err != nil {\n74|\t\t\tt.Fatal(err)\n75|\t\t}\n76|\t\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"replacement-bytes\"))\n77|\t})\n78|\trequireRefusalDetail(t, err, `\"store/blob-a\"`)\n79|}\n80|\n81|func TestCaptureRaceUnreadableAtPost(t *testing.T) {\n82|\t// A member that grows past MaxSingleBytes between the walk\n83|\t// and the post measurement keeps its shape — the same\n84|\t// regular key — but cannot be re-read: the race refuses\n85|\t// naming the member instead of sealing the captured hash.\n86|\tstoreRoot := fixtureStore(t)\n87|\tstoreSink := openTestStore(t)\n88|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n89|\trequest.MaxSingleBytes = 32\n90|\trequest.Hooks.AfterWalk = mutateAfterWalk(t, func(root string) {\n91|\t\twriteStoreFile(t, root, \"store/blob-a\", bytes.Repeat([]byte(\"g\"), 64))\n92|\t})\n93|\tresult, err := Capture(request)\n94|\tif err == nil {\n95|\t\tt.Fatalf(\"Capture() = %+v, want a race refusal\", result)\n96|\t}\n97|\trequireRefusalDetail(t, err, \"source mutated during capture\", `\"store/blob-a\"`, \"capture digests differ\")\n98|}\n99|\n100|func TestCaptureRaceRemovedFile(t *testing.T) {\n101|\terr := raceRefusal(t, func(root string) {\n102|\t\tif err := os.Remove(filepath.Join(root, \"store\", \"blob-b\")); err != nil {\n103|\t\t\tt.Fatal(err)\n104|\t\t}\n105|\t})\n106|\trequireRefusalDetail(t, err, `\"store/blob-b\"`)\n107|}\n108|\n109|func TestCaptureArchiveSealsUnstable(t *testing.T) {\n110|\tstoreRoot := fixtureStore(t)\n111|\tstoreSink := openTestStore(t)\n112|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n113|\trequest.OnRace = RaceArchive\n114|\trequest.OperatorExplicit = true\n115|\trequest.Hooks.AfterWalk = mutateAfterWalk(t, func(root string) {\n116|\t\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"alpha-payload-bytez\"))\n117|\t})\n118|\tresult := mustCapture(t, request)\n119|\tif result.BoundaryKind != \"unstable_archive\" {\n120|\t\tt.Fatalf(\"BoundaryKind = %q, want unstable_archive\", result.BoundaryKind)\n121|\t}\n122|\tif result.PreDigest == result.PostDigest {\n123|\t\tt.Fatal(\"PreDigest == PostDigest despite the injected mutation\")\n124|\t}\n125|\tmanifest, err := clonebundle.DecodeCaptureManifest(result.CaptureManifest)\n126|\tif err != nil {\n127|\t\tt.Fatalf(\"DecodeCaptureManifest() error = %v\", err)\n128|\t}\n129|\tif manifest.CaptureBoundary.Stable() {\n130|\t\tt.Fatal(\"sealed boundary is stable after a detected mutation\")\n131|\t}\n132|\tsealed := string(result.CaptureManifest)\n133|\tif !strings.Contains(sealed, `\"kind\":\"unstable_archive\"`) {\n134|\t\tt.Fatal(\"sealed manifest misses the unstable_archive kind\")\n135|\t}\n136|\tif !strings.Contains(sealed, `\"reason_code\":\"source_not_quiescent\"`) {\n137|\t\tt.Fatal(\"sealed manifest misses reason_code source_not_quiescent\")\n138|\t}\n139|\tif !strings.Contains(sealed, `\"operator_explicit\":true`) {\n140|\t\tt.Fatal(\"sealed manifest misses operator_explicit true\")\n141|\t}\n142|\tif !strings.Contains(sealed, `\"target_projection_forbidden\":true`) {\n143|\t\tt.Fatal(\"sealed manifest misses target_projection_forbidden true\")\n144|\t}\n145|\tif err := clonebundle.RefuseUnstableForTarget(manifest.CaptureBoundary); err == nil {\n146|\t\tt.Fatal(\"RefuseUnstableForTarget() = nil for archive output\")\n147|\t}\n148|}\n149|\n150|func TestCaptureArchiveRequiresExplicit(t *testing.T) {\n151|\tarchive := func(t *testing.T, generation string) error {\n152|\t\tt.Helper()\n153|\t\tstoreRoot := fixtureStore(t)\n154|\t\tstoreSink := openTestStore(t)\n155|\t\trequest := validCaptureRequest(t, storeRoot, storeSink)\n156|\t\trequest.OnRace = RaceArchive\n157|\t\trequest.OperatorExplicit = false\n158|\t\trequest.Generation = generation\n159|\t\trequest.Hooks.AfterWalk = mutateAfterWalk(t, func(root string) {\n160|\t\t\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"alpha-payload-bytez\"))\n161|\t\t})\n162|\t\tresult, err := Capture(request)\n163|\t\tif err == nil {\n164|\t\t\tt.Fatalf(\"Capture() = %+v, want an acknowledgement refusal\", result)\n165|\t\t}\n166|\t\treturn err\n167|\t}\n168|\trequireRefusalDetail(t, archive(t, \"generation-9\"), \"explicit operator acknowledgement\")\n169|\t// A different generation still refuses after the\n170|\t// admit-exactly-generation-9 narrowing.\n171|\trequireRefusalDetail(t, archive(t, \"generation-10\"), \"explicit operator acknowledgement\")\n172|}\n173|\n174|func TestCaptureRaceSealsNoManifest(t *testing.T) {\n175|\t// The race gate precedes the seal: a mutated source leaves no\n176|\t// manifest blob behind, only the orphaned payload prefix.\n177|\tstoreRoot := fixtureStore(t)\n178|\tstoreSink := openTestStore(t)\n179|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n180|\trequest.Hooks.AfterWalk = mutateAfterWalk(t, func(root string) {\n181|\t\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"alpha-payload-bytez\"))\n182|\t})\n183|\tresult, err := Capture(request)\n184|\tif err == nil {\n185|\t\tt.Fatalf(\"Capture() = %+v, want a race refusal\", result)\n186|\t}\n187|\tif result != nil {\n188|\t\tt.Fatalf(\"Capture() returned a result with error %v\", err)\n189|\t}\n190|\tfor _, blob := range listStoredBlobs(t, storeSink) {\n191|\t\tif _, err := clonebundle.DecodeRawObjectManifest(blob.bytes); err == nil {\n192|\t\t\tt.Fatal(\"mutated capture sealed a raw manifest before the race gate\")\n193|\t\t}\n194|\t\tif _, err := clonebundle.DecodeCaptureManifest(blob.bytes); err == nil {\n195|\t\t\tt.Fatal(\"mutated capture sealed a capture manifest before the race gate\")\n196|\t\t}\n197|\t}\n198|}\n199|\n200|func TestCaptureRaceEmitsNoReceipt(t *testing.T) {\n201|\t// The race gate precedes projection output: a mutated source\n202|\t// is refused BY the gate — with the race refusal, not a seal\n203|\t// error from a seal that ran too early — and leaves the\n204|\t// target sink empty.\n205|\tstoreRoot := fixtureStore(t)\n206|\tstoreSink := openTestStore(t)\n207|\ttargetSink := openTestStore(t)\n208|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n209|\trequest.Hooks.AfterWalk = mutateAfterWalk(t, func(root string) {\n210|\t\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"alpha-payload-bytez\"))\n211|\t})\n212|\tprojected, err := CaptureAndProject(ProjectRequest{\n213|\t\tCapture:         request,\n214|\t\tTargetSink:      targetSink,\n215|\t\tFidelityProfile: \"strict_exact\",\n216|\t})\n217|\tif err == nil {\n218|\t\tt.Fatalf(\"CaptureAndProject() = %+v, want a race refusal\", projected)\n219|\t}\n220|\trequireRefusalDetail(t, err, \"source mutated during capture\", `\"store/blob-a\"`)\n221|\tif blobs := listStoredBlobs(t, targetSink); len(blobs) != 0 {\n222|\t\tt.Fatalf(\"mutated capture emitted %d receipt blobs before the race gate\", len(blobs))\n223|\t}\n224|}\n225|\n226|func TestCaptureHookFires(t *testing.T) {\n227|\tstoreRoot := fixtureStore(t)\n228|\tstoreSink := openTestStore(t)\n229|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n230|\tfired := false\n231|\trequest.Hooks.AfterRawPublish = func() error {\n232|\t\tfired = true\n233|\t\treturn nil\n234|\t}\n235|\tmustCapture(t, request)\n236|\tif !fired {\n237|\t\tt.Fatal(\"AfterRawPublish hook did not fire\")\n238|\t}\n239|}","final_result":true}}}
