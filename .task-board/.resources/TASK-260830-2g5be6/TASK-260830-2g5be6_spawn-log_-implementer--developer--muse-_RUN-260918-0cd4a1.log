529|\t\tCreatedAt:           request.CreatedAt,\n530|\t})\n531|\tif err != nil {\n532|\t\treturn nil, err\n533|\t}\n534|\tmanifest, err := clonebundle.DecodeCaptureManifest(captureBytes)\n535|\tif err != nil {\n536|\t\treturn nil, invalid(\"sealed capture manifest refused: %v\", err)\n537|\t}\n538|\tcapturePut, err := request.Store.PutBlob(scalar.SHA256Digest(captureBytes), uint64(len(captureBytes)), bytes.NewReader(captureBytes))\n539|\tif err != nil {\n540|\t\treturn nil, invalid(\"capture cannot publish the capture manifest: %v\", err)\n541|\t}\n542|\tboundaryKind := \"stable\"\n543|\tif !manifest.CaptureBoundary.Stable() {\n544|\t\tboundaryKind = \"unstable_archive\"\n545|\t}\n546|\tstate.log.Linef(\"boundary kind=%s pre=%s post=%s\", boundaryKind, state.pre.String(), state.post.String())\n547|\treturn &CaptureResult{\n548|\t\tRawManifest:      rawBytes,\n549|\t\tCaptureManifest:  captureBytes,\n550|\t\tWorkspaceBinding: append([]byte(nil), state.workspaceBytes...),\n551|\t\tRaw:              raw,\n552|\t\tCapture:          manifest,\n553|\t\tBoundaryKind:     boundaryKind,\n554|\t\tPreDigest:        state.pre,\n555|\t\tPostDigest:       state.post,\n556|\t\tRawInstalled:     rawPut.Installed,\n557|\t\tCaptureInstalled: capturePut.Installed,\n558|\t\tLogs:             state.log.Lines(),\n559|\t}, nil\n560|}","final_result":true}}}
