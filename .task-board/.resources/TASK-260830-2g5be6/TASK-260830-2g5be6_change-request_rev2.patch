+		storeRoot := t.TempDir()
+		writeStoreFile(t, storeRoot, "store/only", []byte(payload))
+		storeSink := openTestStore(t)
+		request := validCaptureRequest(t, storeRoot, storeSink)
+		request.MaxSingleBytes = 10
