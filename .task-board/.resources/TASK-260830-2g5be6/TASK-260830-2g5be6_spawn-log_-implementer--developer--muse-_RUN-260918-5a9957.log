{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c869","stream":{"kind":"session","id":"01a0b27e-c8a1-7be1-9b43-e0047ff1ed44"},"sequence":655,"recorded_at":1780531400001305,"record_type":"event","durability":"durable","causation_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","run_stream":{"kind":"run","id":"42a50646-ac4c-4d20-af82-db3f2b0269ba"},"task_stream":{"kind":"task","id":"01a0b280-311a-78b2-a4c4-f64be41ea04b"},"task_id":"01a0b280-311a-78b2-a4c4-f64be41ea04b","event":{"kind":"output","task_id":"01a0b280-311a-78b2-a4c4-f64be41ea04b","chunk":"Read text file `internal/clonesnap/workspace.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"strings\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n14|)\n15|\n16|// This file builds the closed WorkspaceBinding from real repository\n17|// state: the logical workspace, the cwd normalized beneath the\n18|// Workspace Group root, sorted unique repository remote\n19|// fingerprints, the branch, and the head, index, and working-tree\n20|// digests. The cwd never grants filesystem authority: absolute\n21|// paths, dot segments, and escapes past the root refuse, and the\n22|// recorded relative path must name a directory that exists. The\n23|// binding seals through the landed DecodeWorkspaceBinding, so what\n24|// this entry emits is exactly what the closed shape admits.\n25|\n26|// WorkspaceRequest is one workspace checkpoint candidate: the\n27|// Workspace Group root and the observed repository facts. Cwd is an\n28|// absolute path or a root-relative path; RemoteFingerprints must\n29|// arrive sorted unique; the branch and digests are nullable.\n30|type WorkspaceRequest struct {\n31|\tLogicalWorkspaceID string\n32|\tWorkspaceRoot      string\n33|\tCwd                string\n34|\tRemoteFingerprints []string\n35|\tBranch             *string\n36|\tHeadDigest         *string\n37|\tIndexDigest        *string\n38|\tWorkingTreeDigest  *string\n39|\tPlatform           scalar.Platform\n40|}\n41|\n42|// CheckpointWorkspace builds one closed WorkspaceBinding from the\n43|// observed repository state and returns its canonical bytes. The\n44|// workspace root must be an existing directory opened without\n45|// following a trailing symlink; the cwd must normalize beneath it;\n46|// every digest and identifier validates through the landed decoder.\n47|func CheckpointWorkspace(request WorkspaceRequest) ([]byte, error) {\n48|\tworkspaceID, err := scalar.ParseUUIDv7(request.LogicalWorkspaceID)\n49|\tif err != nil {\n50|\t\treturn nil, invalid(\"workspace binding logical_workspace_id is not a UUIDv7: %v\", err)\n51|\t}\n52|\troot, err := secprim.OpenNoFollowDir(request.WorkspaceRoot)\n53|\tif err != nil {\n54|\t\treturn nil, invalid(\"workspace root %q: %v\", request.WorkspaceRoot, err)\n55|\t}\n56|\t_ = root.Close()\n57|\trelative, err := workspaceCwdRelative(request.Platform, request.WorkspaceRoot, request.Cwd)\n58|\tif err != nil {\n59|\t\treturn nil, err\n60|\t}\n61|\tfingerprints, err := workspaceFingerprints(request.RemoteFingerprints)\n62|\tif err != nil {\n63|\t\treturn nil, err\n64|\t}\n65|\tbranch, err := workspaceNullableText(request.Branch, \"branch\", 1, 1024)\n66|\tif err != nil {\n67|\t\treturn nil, err\n68|\t}\n69|\thead, err := workspaceNullableDigest(request.HeadDigest, \"head_digest\")\n70|\tif err != nil {\n71|\t\treturn nil, err\n72|\t}\n73|\tindex, err := workspaceNullableDigest(request.IndexDigest, \"index_digest\")\n74|\tif err != nil {\n75|\t\treturn nil, err\n76|\t}\n77|\ttree, err := workspaceNullableDigest(request.WorkingTreeDigest, \"working_tree_digest\")\n78|\tif err != nil {\n79|\t\treturn nil, err\n80|\t}\n81|\tobject := map[string]any{\n82|\t\t\"logical_workspace_id\":           workspaceID.String(),\n83|\t\t\"cwd_relative\":                   relative,\n84|\t\t\"repository_remote_fingerprints\": fingerprints,\n85|\t\t\"branch\":                         branch,\n86|\t\t\"head_digest\":                    head,\n87|\t\t\"index_digest\":                   index,\n88|\t\t\"working_tree_digest\":            tree,\n89|\t\t\"extensions\":                     map[string]any{},\n90|\t}\n91|\tplain, err := json.Marshal(object)\n92|\tif err != nil {\n93|\t\treturn nil, invalid(\"serialize workspace binding: %v\", err)\n94|\t}\n95|\tsealed, err := canonicaljson.Canonicalize(plain)\n96|\tif err != nil {\n97|\t\treturn nil, invalid(\"canonicalize workspace binding: %v\", err)\n98|\t}\n99|\tif _, err := clonebundle.DecodeWorkspaceBinding(sealed); err != nil {\n100|\t\treturn nil, invalid(\"sealed workspace binding refused: %v\", err)\n101|\t}\n102|\treturn sealed, nil\n103|}\n104|\n105|// workspaceCwdRelative normalizes the observed cwd beneath the\n106|// Workspace Group root. An absolute cwd must sit inside the root; a\n107|// relative cwd must already be normalized; absolute paths outside\n108|// the root, parent segments, and dot segments refuse. The resolved\n109|// directory must exist, so the checkpoint records observed state,\n110|// not an unanchored claim.\n111|func workspaceCwdRelative(platform scalar.Platform, root, cwd string) (string, error) {\n112|\tif cwd == \"\" {\n113|\t\treturn \"\", invalid(\"workspace binding cwd_relative is empty\")\n114|\t}\n115|\tif _, err := scalar.ParseAbsolutePath(platform, cwd); err == nil {\n116|\t\trelative, err := filepath.Rel(root, cwd)\n117|\t\tif err != nil {\n118|\t\t\treturn \"\", invalid(\"workspace binding cwd %q is not beneath the workspace root\", cwd)\n119|\t\t}\n120|\t\tif relative == \"..\" || strings.HasPrefix(relative, \"..\"+string(filepath.Separator)) {\n121|\t\t\treturn \"\", invalid(\"workspace binding cwd %q escapes the workspace root\", cwd)\n122|\t\t}\n123|\t\tcwd = filepath.ToSlash(relative)\n124|\t}\n125|\tif cwd == \".\" {\n126|\t\tcwd = \".\"\n127|\t} else {\n128|\t\tparsed, err := scalar.ParseRelativePath(cwd)\n129|\t\tif err != nil {\n130|\t\t\treturn \"\", invalid(\"workspace binding cwd_relative %q is not normalized beneath the workspace root: %v\", cwd, err)\n131|\t\t}\n132|\t\tcwd = parsed.String()\n133|\t}\n134|\tabsolute := root\n135|\tif cwd != \".\" {\n136|\t\tabsolute = filepath.Join(root, filepath.FromSlash(cwd))\n137|\t}\n138|\tinfo, err := os.Stat(absolute)\n139|\tif err != nil {\n140|\t\treturn \"\", invalid(\"workspace binding cwd_relative %q does not name an observed directory: %v\", cwd, err)\n141|\t}\n142|\tif !info.IsDir() {\n143|\t\treturn \"\", invalid(\"workspace binding cwd_relative %q does not name an observed directory\", cwd)\n144|\t}\n145|\treturn cwd, nil\n146|}\n147|\n148|// workspaceFingerprints admits the sorted unique repository remote\n149|// fingerprints: at most 128 digests in strict bytewise order. An\n150|// unsorted, duplicated, over-long, or over-count row refuses; the\n151|// entry never repairs caller order.\n152|func workspaceFingerprints(fingerprints []string) ([]any, error) {\n153|\tif len(fingerprints) > 128 {\n154|\t\treturn nil, invalid(\"workspace binding carries %d repository remote fingerprints, maximum is 128\", len(fingerprints))\n155|\t}\n156|\tprevious := \"\"\n157|\tvalues := make([]any, 0, len(fingerprints))\n158|\tfor index, fingerprint := range fingerprints {\n159|\t\tdigest, err := scalar.ParseDigest(fingerprint)\n160|\t\tif err != nil {\n161|\t\t\treturn nil, invalid(\"workspace binding repository_remote_fingerprints[%d] is not a digest: %v\", index, err)\n162|\t\t}\n163|\t\tif index > 0 && fingerprint <= previous {\n164|\t\t\treturn nil, invalid(\"workspace binding carries unsorted or duplicate repository remote fingerprints\")\n165|\t\t}\n166|\t\tprevious = fingerprint\n167|\t\tvalues = append(values, digest.String())\n168|\t}\n169|\treturn values, nil\n170|}\n171|\n172|func workspaceNullableText(value *string, name string, minimum, maximum int) (any, error) {\n173|\tif value == nil {\n174|\t\treturn nil, nil\n175|\t}\n176|\t// The Section 1.6 string measure counts characters, not bytes:\n177|\t// the bound delegates to the environ owner, never len.\n178|\tif length := environ.StringLength(*value); length < minimum || length > maximum {\n179|\t\treturn nil, invalid(\"workspace binding %s is not a string[%d..%d]\", name, minimum, maximum)\n180|\t}\n181|\treturn *value, nil\n182|}\n183|\n184|func workspaceNullableDigest(value *string, name string) (any, error) {\n185|\n186|\tif value == nil {\n187|\t\treturn nil, nil\n188|\t}\n189|\tdigest, err := scalar.ParseDigest(*value)\n190|\tif err != nil {\n191|\t\treturn nil, invalid(\"workspace binding %s is not a digest: %v\", name, err)\n192|\t}\n193|\treturn digest.String(), nil\n194|}","final_result":true}}}
