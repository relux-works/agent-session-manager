{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8cb","stream":{"kind":"session","id":"01a0b27e-c8a1-7be1-9b43-e0047ff1ed44"},"sequence":704,"recorded_at":1780531400001403,"record_type":"event","durability":"durable","causation_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","run_stream":{"kind":"run","id":"42a50646-ac4c-4d20-af82-db3f2b0269ba"},"task_stream":{"kind":"task","id":"01a0b280-8b05-7823-a03d-6140174208e6"},"task_id":"01a0b280-8b05-7823-a03d-6140174208e6","event":{"kind":"output","task_id":"01a0b280-8b05-7823-a03d-6140174208e6","chunk":"Read text file `internal/clonesnap/workspace_test.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"os\"\n5|\t\"path/filepath\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n10|)\n11|\n12|// Workspace checkpoint evidence: CheckpointWorkspace builds the\n13|// closed WorkspaceBinding from observed repository state through\n14|// the production entry, and every escape or shape violation refuses\n15|// with the member named.\n16|\n17|func TestCheckpointWorkspaceSealsObservedState(t *testing.T) {\n18|\trequest := fixtureWorkspace(t)\n19|\tsealed, err := CheckpointWorkspace(request)\n20|\tif err != nil {\n21|\t\tt.Fatalf(\"CheckpointWorkspace() error = %v\", err)\n22|\t}\n23|\tbinding, err := clonebundle.DecodeWorkspaceBinding(sealed)\n24|\tif err != nil {\n25|\t\tt.Fatalf(\"DecodeWorkspaceBinding() error = %v\", err)\n26|\t}\n27|\tif binding.LogicalWorkspaceID.String() != fixtureWorkspaceID {\n28|\t\tt.Fatalf(\"LogicalWorkspaceID = %q\", binding.LogicalWorkspaceID)\n29|\t}\n30|\tif binding.CwdRelative != \"work/trees/alpha\" {\n31|\t\tt.Fatalf(\"CwdRelative = %q\", binding.CwdRelative)\n32|\t}\n33|\tif len(binding.RemoteFingerprints) != 1 || binding.RemoteFingerprints[0].String() != fixtureDigest(\"snap-remote\") {\n34|\t\tt.Fatalf(\"RemoteFingerprints = %v\", binding.RemoteFingerprints)\n35|\t}\n36|\tif binding.Branch == nil || *binding.Branch != \"main\" {\n37|\t\tt.Fatalf(\"Branch = %v\", binding.Branch)\n38|\t}\n39|\tif binding.HeadDigest == nil || binding.HeadDigest.String() != fixtureDigest(\"snap-head\") {\n40|\t\tt.Fatalf(\"HeadDigest = %v\", binding.HeadDigest)\n41|\t}\n42|\tif binding.IndexDigest != nil || binding.WorkingTreeDigest != nil {\n43|\t\tt.Fatal(\"null digests did not seal as null\")\n44|\t}\n45|}\n46|\n47|func TestCheckpointWorkspaceRelativeCwd(t *testing.T) {\n48|\trequest := fixtureWorkspace(t)\n49|\trequest.Cwd = \"work/trees/alpha\"\n50|\tsealed, err := CheckpointWorkspace(request)\n51|\tif err != nil {\n52|\t\tt.Fatalf(\"CheckpointWorkspace() error = %v\", err)\n53|\t}\n54|\tbinding, err := clonebundle.DecodeWorkspaceBinding(sealed)\n55|\tif err != nil {\n56|\t\tt.Fatalf(\"DecodeWorkspaceBinding() error = %v\", err)\n57|\t}\n58|\tif binding.CwdRelative != \"work/trees/alpha\" {\n59|\t\tt.Fatalf(\"CwdRelative = %q\", binding.CwdRelative)\n60|\t}\n61|}\n62|\n63|func TestCheckpointWorkspaceRootCwd(t *testing.T) {\n64|\trequest := fixtureWorkspace(t)\n65|\trequest.Cwd = request.WorkspaceRoot\n66|\tsealed, err := CheckpointWorkspace(request)\n67|\tif err != nil {\n68|\t\tt.Fatalf(\"CheckpointWorkspace() error = %v\", err)\n69|\t}\n70|\tbinding, err := clonebundle.DecodeWorkspaceBinding(sealed)\n71|\tif err != nil {\n72|\t\tt.Fatalf(\"DecodeWorkspaceBinding() error = %v\", err)\n73|\t}\n74|\tif binding.CwdRelative != \".\" {\n75|\t\tt.Fatalf(\"CwdRelative = %q, want .\", binding.CwdRelative)\n76|\t}\n77|}\n78|\n79|func TestCheckpointWorkspaceRefusesEscape(t *testing.T) {\n80|\trequest := fixtureWorkspace(t)\n81|\trequest.Cwd = \"/outside-workspace\"\n82|\tif _, err := CheckpointWorkspace(request); err == nil {\n83|\t\tt.Fatal(\"CheckpointWorkspace() admitted an absolute escape\")\n84|\t} else {\n85|\t\trequireRefusalDetail(t, err, \"escapes the workspace root\")\n86|\t}\n87|\t// A different escape still refuses after the\n88|\t// admit-exactly-/outside-workspace narrowing.\n89|\trequest.Cwd = \"/outside-workspace-2\"\n90|\tif _, err := CheckpointWorkspace(request); err == nil {\n91|\t\tt.Fatal(\"CheckpointWorkspace() admitted an absolute escape\")\n92|\t} else {\n93|\t\trequireRefusalDetail(t, err, \"escapes the workspace root\")\n94|\t}\n95|}\n96|\n97|func TestCheckpointWorkspaceRefusesDotSegments(t *testing.T) {\n98|\trequest := fixtureWorkspace(t)\n99|\trequest.Cwd = \"work/../escape\"\n100|\tif _, err := CheckpointWorkspace(request); err == nil {\n101|\t\tt.Fatal(\"CheckpointWorkspace() admitted parent segments\")\n102|\t} else {\n103|\t\trequireRefusalDetail(t, err, `\"work/../escape\"`)\n104|\t}\n105|}\n106|\n107|func TestCheckpointWorkspaceRefusesMissingCwd(t *testing.T) {\n108|\trequest := fixtureWorkspace(t)\n109|\trequest.Cwd = \"work/trees/missing\"\n110|\tif _, err := CheckpointWorkspace(request); err == nil {\n111|\t\tt.Fatal(\"CheckpointWorkspace() admitted an unobserved cwd\")\n112|\t} else {\n113|\t\trequireRefusalDetail(t, err, `\"work/trees/missing\"`)\n114|\t}\n115|}\n116|\n117|func TestCheckpointWorkspaceRefusesFileCwd(t *testing.T) {\n118|\trequest := fixtureWorkspace(t)\n119|\tplain := filepath.Join(request.WorkspaceRoot, \"plain-file\")\n120|\tif err := os.WriteFile(plain, []byte(\"not-a-directory\"), 0o600); err != nil {\n121|\t\tt.Fatal(err)\n122|\t}\n123|\trequest.Cwd = \"plain-file\"\n124|\tif _, err := CheckpointWorkspace(request); err == nil {\n125|\t\tt.Fatal(\"CheckpointWorkspace() admitted a file cwd\")\n126|\t} else {\n127|\t\trequireRefusalDetail(t, err, `\"plain-file\"`)\n128|\t}\n129|}\n130|\n131|func TestCheckpointWorkspaceRefusesUnsortedFingerprints(t *testing.T) {\n132|\trequest := fixtureWorkspace(t)\n133|\tfirst := fixtureDigest(\"snap-remote-a\")\n134|\tsecond := fixtureDigest(\"snap-remote-b\")\n135|\tfingerprints := []string{first, second}\n136|\tif fingerprints[0] > fingerprints[1] {\n137|\t\tfingerprints[0], fingerprints[1] = fingerprints[1], fingerprints[0]\n138|\t}\n139|\t// Descending order refuses.\n140|\trequest.RemoteFingerprints = []string{fingerprints[1], fingerprints[0]}\n141|\tif _, err := CheckpointWorkspace(request); err == nil {\n142|\t\tt.Fatal(\"CheckpointWorkspace() admitted unsorted fingerprints\")\n143|\t} else {\n144|\t\trequireRefusalDetail(t, err, \"unsorted or duplicate repository remote fingerprints\")\n145|\t}\n146|\t// Ascending order seals.\n147|\trequest.RemoteFingerprints = []string{fingerprints[0], fingerprints[1]}\n148|\tif _, err := CheckpointWorkspace(request); err != nil {\n149|\t\tt.Fatalf(\"CheckpointWorkspace() error = %v\", err)\n150|\t}\n151|}\n152|\n153|func TestCheckpointWorkspaceRefusesDuplicateFingerprint(t *testing.T) {\n154|\trequest := fixtureWorkspace(t)\n155|\tduplicate := fixtureDigest(\"snap-remote\")\n156|\trequest.RemoteFingerprints = []string{duplicate, duplicate}\n157|\tif _, err := CheckpointWorkspace(request); err == nil {\n158|\t\tt.Fatal(\"CheckpointWorkspace() admitted duplicate fingerprints\")\n159|\t} else {\n160|\t\trequireRefusalDetail(t, err, \"unsorted or duplicate repository remote fingerprints\")\n161|\t}\n162|}\n163|\n164|func TestCheckpointWorkspaceRefusesTooManyFingerprints(t *testing.T) {\n165|\trequest := fixtureWorkspace(t)\n166|\tfingerprints := make([]string, 0, 129)\n167|\tfor index := 0; index < 129; index++ {\n168|\t\tfingerprints = append(fingerprints, fixtureDigest(\"snap-remote-\"+string(rune('a'+index/26))+string(rune('a'+index%26))))\n169|\t}\n170|\trequest.RemoteFingerprints = fingerprints\n171|\tif _, err := CheckpointWorkspace(request); err == nil {\n172|\t\tt.Fatal(\"CheckpointWorkspace() admitted 129 fingerprints\")\n173|\t} else {\n174|\t\trequireRefusalDetail(t, err, \"maximum is 128\")\n175|\t}\n176|}\n177|\n178|func TestCheckpointWorkspaceRefusesBadDigest(t *testing.T) {\n179|\trequest := fixtureWorkspace(t)\n180|\tbad := \"not-a-digest\"\n181|\trequest.HeadDigest = &bad\n182|\tif _, err := CheckpointWorkspace(request); err == nil {\n183|\t\tt.Fatal(\"CheckpointWorkspace() admitted a bad head digest\")\n184|\t} else {\n185|\t\trequireRefusalDetail(t, err, \"head_digest\")\n186|\t}\n187|}\n188|\n189|func TestCheckpointWorkspaceRefusesBadWorkspaceID(t *testing.T) {\n190|\trequest := fixtureWorkspace(t)\n191|\trequest.LogicalWorkspaceID = \"not-a-uuid\"\n192|\tif _, err := CheckpointWorkspace(request); err == nil {\n193|\t\tt.Fatal(\"CheckpointWorkspace() admitted a bad workspace ID\")\n194|\t} else {\n195|\t\trequireRefusalDetail(t, err, \"UUIDv7\")\n196|\t}\n197|}\n198|\n199|func TestCheckpointWorkspaceRefusesSymlinkRoot(t *testing.T) {\n200|\treal := t.TempDir()\n201|\tlink := filepath.Join(t.TempDir(), \"link-root\")\n202|\tif err := os.Symlink(real, link); err != nil {\n203|\t\tt.Fatal(err)\n204|\t}\n205|\trequest := fixtureWorkspace(t)\n206|\trequest.WorkspaceRoot = link\n207|\tif _, err := CheckpointWorkspace(request); err == nil {\n208|\t\tt.Fatal(\"CheckpointWorkspace() admitted a symlinked root\")\n209|\t}\n210|}\n211|\n212|func TestCheckpointWorkspaceMultibyteBranch(t *testing.T) {\n213|\t// The branch bound counts characters, not bytes: 1024\n214|\t// two-byte characters admit.\n215|\trequest := fixtureWorkspace(t)\n216|\tbranch := strings.Repeat(\"é\", 1024)\n217|\trequest.Branch = &branch\n218|\tif _, err := CheckpointWorkspace(request); err != nil {\n219|\t\tt.Fatalf(\"CheckpointWorkspace() error = %v\", err)\n220|\t}\n221|\ttooLong := strings.Repeat(\"é\", 1025)\n222|\trequest.Branch = &tooLong\n223|\tif _, err := CheckpointWorkspace(request); err == nil {\n224|\t\tt.Fatal(\"CheckpointWorkspace() admitted a 1025-character branch\")\n225|\t} else {\n226|\t\trequireRefusalDetail(t, err, \"string[1..1024]\")\n227|\t}\n228|}","final_result":true}}}
