{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c81f","stream":{"kind":"session","id":"01a0b27e-c8a1-7be1-9b43-e0047ff1ed44"},"sequence":618,"recorded_at":1780531400001231,"record_type":"event","durability":"durable","causation_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","run_stream":{"kind":"run","id":"42a50646-ac4c-4d20-af82-db3f2b0269ba"},"call_id":"call_01a0b28019657234a3d8a838d6e77cb1","text":"Read text file `internal/clonesnap/race_test.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"os\"\n5|\t\"path/filepath\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n10|)\n11|\n12|// Source-race evidence: a changed byte, a changed size, an appended\n13|// record, and a replaced file each refuse — or seal the\n14|// unstable_archive form with source_not_quiescent — and the mutation\n15|// check runs before any seal or projection output. The AfterWalk\n16|// hook injects each mutation deterministically between the capture\n17|// walk and the post-capture measurement.\n18|\n19|func mutateAfterWalk(t *testing.T, mutate func(root string)) func(string) error {\n20|\tt.Helper()\n21|\treturn func(root string) error {\n22|\t\tmutate(root)\n23|\t\treturn nil\n24|\t}\n25|}\n26|\n27|func raceRefusal(t *testing.T, mutate func(root string)) error {\n28|\tt.Helper()\n29|\tstoreRoot := fixtureStore(t)\n30|\tstoreSink := openTestStore(t)\n31|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n32|\trequest.Hooks.AfterWalk = mutateAfterWalk(t, mutate)\n33|\tresult, err := Capture(request)\n34|\tif err == nil {\n35|\t\tt.Fatalf(\"Capture() = %+v, want a race refusal\", result)\n36|\t}\n37|\trequireRefusalDetail(t, err, \"source mutated during capture\")\n38|\treturn err\n39|}\n40|\n41|func TestCaptureRaceChangedByte(t *testing.T) {\n42|\t// The first case mutates blob-a at equal size: size equality is\n43|\t// never proof, so the content digests still disagree.\n44|\terr := raceRefusal(t, func(root string) {\n45|\t\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"alpha-payload-bytez\"))\n46|\t})\n47|\trequireRefusalDetail(t, err, `\"store/blob-a\"`, \"capture digests differ\")\n48|\t// The second case mutates blob-b: other members still refuse\n49|\t// after the admit-exactly-blob-a narrowing.\n50|\tother := raceRefusal(t, func(root string) {\n51|\t\twriteStoreFile(t, root, \"store/blob-b\", []byte(\"beta-payload-bytez\"))\n52|\t})\n53|\trequireRefusalDetail(t, other, `\"store/blob-b\"`, \"capture digests differ\")\n54|}\n55|\n56|func TestCaptureRaceChangedSize(t *testing.T) {\n57|\terr := raceRefusal(t, func(root string) {\n58|\t\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"alpha-payload-bytes-extended\"))\n59|\t})\n60|\trequireRefusalDetail(t, err, `\"store/blob-a\"`)\n61|}\n62|\n63|func TestCaptureRaceAppendedRecord(t *testing.T) {\n64|\terr := raceRefusal(t, func(root string) {\n65|\t\twriteStoreFile(t, root, \"store/blob-appended\", []byte(\"appended-bytes\"))\n66|\t})\n67|\trequireRefusalDetail(t, err, `\"store/blob-appended\"`)\n68|}\n69|\n70|func TestCaptureRaceReplacedFile(t *testing.T) {\n71|\terr := raceRefusal(t, func(root string) {\n72|\t\tif err := os.Remove(filepath.Join(root, \"store\", \"blob-a\")); err != nil {\n73|\t\t\tt.Fatal(err)\n74|\t\t}\n75|\t\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"replacement-bytes\"))\n76|\t})\n77|\trequireRefusalDetail(t, err, `\"store/blob-a\"`)\n78|}\n79|\n80|func TestCaptureRaceRemovedFile(t *testing.T) {\n81|\terr := raceRefusal(t, func(root string) {\n82|\t\tif err := os.Remove(filepath.Join(root, \"store\", \"blob-b\")); err != nil {\n83|\t\t\tt.Fatal(err)\n84|\t\t}\n85|\t})\n86|\trequireRefusalDetail(t, err, `\"store/blob-b\"`)\n87|}\n88|\n89|func TestCaptureArchiveSealsUnstable(t *testing.T) {\n90|\tstoreRoot := fixtureStore(t)\n91|\tstoreSink := openTestStore(t)\n92|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n93|\trequest.OnRace = RaceArchive\n94|\trequest.OperatorExplicit = true\n95|\trequest.Hooks.AfterWalk = mutateAfterWalk(t, func(root string) {\n96|\t\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"alpha-payload-bytez\"))\n97|\t})\n98|\tresult := mustCapture(t, request)\n99|\tif result.BoundaryKind != \"unstable_archive\" {\n100|\t\tt.Fatalf(\"BoundaryKind = %q, want unstable_archive\", result.BoundaryKind)\n101|\t}\n102|\tif result.PreDigest == result.PostDigest {\n103|\t\tt.Fatal(\"PreDigest == PostDigest despite the injected mutation\")\n104|\t}\n105|\tmanifest, err := clonebundle.DecodeCaptureManifest(result.CaptureManifest)\n106|\tif err != nil {\n107|\t\tt.Fatalf(\"DecodeCaptureManifest() error = %v\", err)\n108|\t}\n109|\tif manifest.CaptureBoundary.Stable() {\n110|\t\tt.Fatal(\"sealed boundary is stable after a detected mutation\")\n111|\t}\n112|\tsealed := string(result.CaptureManifest)\n113|\tif !strings.Contains(sealed, `\"kind\":\"unstable_archive\"`) {\n114|\t\tt.Fatal(\"sealed manifest misses the unstable_archive kind\")\n115|\t}\n116|\tif !strings.Contains(sealed, `\"reason_code\":\"source_not_quiescent\"`) {\n117|\t\tt.Fatal(\"sealed manifest misses reason_code source_not_quiescent\")\n118|\t}\n119|\tif !strings.Contains(sealed, `\"operator_explicit\":true`) {\n120|\t\tt.Fatal(\"sealed manifest misses operator_explicit true\")\n121|\t}\n122|\tif !strings.Contains(sealed, `\"target_projection_forbidden\":true`) {\n123|\t\tt.Fatal(\"sealed manifest misses target_projection_forbidden true\")\n124|\t}\n125|\tif err := clonebundle.RefuseUnstableForTarget(manifest.CaptureBoundary); err == nil {\n126|\t\tt.Fatal(\"RefuseUnstableForTarget() = nil for archive output\")\n127|\t}\n128|}\n129|\n130|func TestCaptureArchiveRequiresExplicit(t *testing.T) {\n131|\tarchive := func(t *testing.T, generation string) error {\n132|\t\tt.Helper()\n133|\t\tstoreRoot := fixtureStore(t)\n134|\t\tstoreSink := openTestStore(t)\n135|\t\trequest := validCaptureRequest(t, storeRoot, storeSink)\n136|\t\trequest.OnRace = RaceArchive\n137|\t\trequest.OperatorExplicit = false\n138|\t\trequest.Generation = generation\n139|\t\trequest.Hooks.AfterWalk = mutateAfterWalk(t, func(root string) {\n140|\t\t\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"alpha-payload-bytez\"))\n141|\t\t})\n142|\t\tresult, err := Capture(request)\n143|\t\tif err == nil {\n144|\t\t\tt.Fatalf(\"Capture() = %+v, want an acknowledgement refusal\", result)\n145|\t\t}\n146|\t\treturn err\n147|\t}\n148|\trequireRefusalDetail(t, archive(t, \"generation-9\"), \"explicit operator acknowledgement\")\n149|\t// A different generation still refuses after the\n150|\t// admit-exactly-generation-9 narrowing.\n151|\trequireRefusalDetail(t, archive(t, \"generation-10\"), \"explicit operator acknowledgement\")\n152|}\n153|\n154|func TestCaptureRaceSealsNoManifest(t *testing.T) {\n155|\t// The race gate precedes the seal: a mutated source leaves no\n156|\t// manifest blob behind, only the orphaned payload prefix.\n157|\tstoreRoot := fixtureStore(t)\n158|\tstoreSink := openTestStore(t)\n159|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n160|\trequest.Hooks.AfterWalk = mutateAfterWalk(t, func(root string) {\n161|\t\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"alpha-payload-bytez\"))\n162|\t})\n163|\tresult, err := Capture(request)\n164|\tif err == nil {\n165|\t\tt.Fatalf(\"Capture() = %+v, want a race refusal\", result)\n166|\t}\n167|\tif result != nil {\n168|\t\tt.Fatalf(\"Capture() returned a result with error %v\", err)\n169|\t}\n170|\tfor _, blob := range listStoredBlobs(t, storeSink) {\n171|\t\tif _, err := clonebundle.DecodeRawObjectManifest(blob.bytes); err == nil {\n172|\t\t\tt.Fatal(\"mutated capture sealed a raw manifest before the race gate\")\n173|\t\t}\n174|\t\tif _, err := clonebundle.DecodeCaptureManifest(blob.bytes); err == nil {\n175|\t\t\tt.Fatal(\"mutated capture sealed a capture manifest before the race gate\")\n176|\t\t}\n177|\t}\n178|}\n179|\n180|func TestCaptureRaceEmitsNoReceipt(t *testing.T) {\n181|\t// The race gate precedes projection output: a mutated source\n182|\t// leaves the target sink empty.\n183|\tstoreRoot := fixtureStore(t)\n184|\tstoreSink := openTestStore(t)\n185|\ttargetSink := openTestStore(t)\n186|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n187|\trequest.Hooks.AfterWalk = mutateAfterWalk(t, func(root string) {\n188|\t\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"alpha-payload-bytez\"))\n189|\t})\n190|\tprojected, err := CaptureAndProject(ProjectRequest{\n191|\t\tCapture:         request,\n192|\t\tTargetSink:      targetSink,\n193|\t\tFidelityProfile: \"strict_exact\",\n194|\t})\n195|\tif err == nil {\n196|\t\tt.Fatalf(\"CaptureAndProject() = %+v, want a race refusal\", projected)\n197|\t}\n198|\tif blobs := listStoredBlobs(t, targetSink); len(blobs) != 0 {\n199|\t\tt.Fatalf(\"mutated capture emitted %d receipt blobs before the race gate\", len(blobs))\n200|\t}\n201|}\n202|\n203|func TestCaptureHookFires(t *testing.T) {\n204|\tstoreRoot := fixtureStore(t)\n205|\tstoreSink := openTestStore(t)\n206|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n207|\tfired := false\n208|\trequest.Hooks.AfterRawPublish = func() error {\n209|\t\tfired = true\n210|\t\treturn nil\n211|\t}\n212|\tmustCapture(t, request)\n213|\tif !fired {\n214|\t\tt.Fatal(\"AfterRawPublish hook did not fire\")\n215|\t}\n216|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c821","stream":{"kind":"session","id":"01a0b27e-c8a1-7be1-9b43-e0047ff1ed44"},"sequence":619,"recorded_at":1780531400001233,"record_type":"event","durability":"durable","causation_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","run_stream":{"kind":"run","id":"42a50646-ac4c-4d20-af82-db3f2b0269ba"},"call_id":"call_01a0b2801bce77f997a03d76af29a6d2","text":"Read text file `internal/clonesnap/project_test.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n9|)\n10|\n11|// Target admission evidence: AdmitForTarget drives the landed G2\n12|// and maximal-safe gates from the projection entry, and\n13|// CaptureAndProject emits the admission receipt only for admitted\n14|// stable captures.\n15|\n16|func projectValid(t *testing.T, profile string) (*ProjectResult, error) {\n17|\tt.Helper()\n18|\tstoreRoot := fixtureStore(t)\n19|\treturn CaptureAndProject(ProjectRequest{\n20|\t\tCapture:         validCaptureRequest(t, storeRoot, openTestStore(t)),\n21|\t\tTargetSink:      openTestStore(t),\n22|\t\tFidelityProfile: profile,\n23|\t})\n24|}\n25|\n26|func TestProjectAdmitsStableEveryProfile(t *testing.T) {\n27|\tfor _, profile := range []string{\"strict_exact\", \"maximal_safe\", \"compact\", \"messages_only\"} {\n28|\t\tprojected, err := projectValid(t, profile)\n29|\t\tif err != nil {\n30|\t\t\tt.Fatalf(\"CaptureAndProject(%q) error = %v\", profile, err)\n31|\t\t}\n32|\t\tif !projected.ReceiptInstalled {\n33|\t\t\tt.Fatalf(\"CaptureAndProject(%q) installed no receipt\", profile)\n34|\t\t}\n35|\t\tsealed := string(projected.Receipt)\n36|\t\tfor _, literal := range []string{\n37|\t\t\t`\"schema\":\"urn:ax:internal:clonesnap-admission-receipt\"`,\n38|\t\t\t`\"schema_version\":\"1.0.0\"`,\n39|\t\t\t`\"boundary_kind\":\"stable\"`,\n40|\t\t\t`\"fidelity_profile\":\"` + profile + `\"`,\n41|\t\t} {\n42|\t\t\tif !strings.Contains(sealed, literal) {\n43|\t\t\t\tt.Fatalf(\"receipt misses %s:\\n%s\", literal, sealed)\n44|\t\t\t}\n45|\t\t}\n46|\t\tif !strings.Contains(sealed, projected.Capture.Raw.ManifestID.String()) {\n47|\t\t\tt.Fatal(\"receipt misses the raw manifest identity\")\n48|\t\t}\n49|\t\tif !strings.Contains(sealed, projected.Capture.Capture.ManifestID.String()) {\n50|\t\t\tt.Fatal(\"receipt misses the capture manifest identity\")\n51|\t\t}\n52|\t}\n53|}\n54|\n55|func TestProjectRefusesUnstable(t *testing.T) {\n56|\tarchive := func(t *testing.T, generation string) error {\n57|\t\tt.Helper()\n58|\t\tstoreRoot := fixtureStore(t)\n59|\t\tstoreSink := openTestStore(t)\n60|\t\trequest := validCaptureRequest(t, storeRoot, storeSink)\n61|\t\trequest.OnRace = RaceArchive\n62|\t\trequest.OperatorExplicit = true\n63|\t\trequest.Generation = generation\n64|\t\trequest.Hooks.AfterWalk = mutateAfterWalk(t, func(root string) {\n65|\t\t\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"alpha-payload-bytez\"))\n66|\t\t})\n67|\t\tprojected, err := CaptureAndProject(ProjectRequest{\n68|\t\t\tCapture:         request,\n69|\t\t\tTargetSink:      openTestStore(t),\n70|\t\t\tFidelityProfile: \"strict_exact\",\n71|\t\t})\n72|\t\tif err == nil {\n73|\t\t\tt.Fatalf(\"CaptureAndProject() = %+v, want a target refusal\", projected)\n74|\t\t}\n75|\t\treturn err\n76|\t}\n77|\t// The unstable_archive form can never enter a target branch.\n78|\trequireRefusalDetail(t, archive(t, \"generation-9\"), \"unstable_archive\", \"target branch\")\n79|\t// A different generation still refuses after the\n80|\t// admit-exactly-generation-9 narrowing.\n81|\trequireRefusalDetail(t, archive(t, \"generation-10\"), \"unstable_archive\", \"target branch\")\n82|}\n83|\n84|func TestProjectRefusesUnstableDirect(t *testing.T) {\n85|\tstoreRoot := fixtureStore(t)\n86|\tstoreSink := openTestStore(t)\n87|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n88|\trequest.OnRace = RaceArchive\n89|\trequest.OperatorExplicit = true\n90|\trequest.Hooks.AfterWalk = mutateAfterWalk(t, func(root string) {\n91|\t\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"alpha-payload-bytez\"))\n92|\t})\n93|\tcaptured := mustCapture(t, request)\n94|\tif _, err := AdmitForTarget(captured.CaptureManifest, \"strict_exact\"); err == nil {\n95|\t\tt.Fatal(\"AdmitForTarget(unstable) = nil, want a refusal\")\n96|\t} else {\n97|\t\trequireRefusalDetail(t, err, \"unstable_archive\", \"target branch\")\n98|\t}\n99|}\n100|\n101|func TestProjectMaximalSafeRequiresComplete(t *testing.T) {\n102|\tadmitUnknown := func(t *testing.T, keys int) error {\n103|\t\tt.Helper()\n104|\t\tstoreRoot := t.TempDir()\n105|\t\twriteStoreFile(t, storeRoot, \"store/blob-a\", []byte(\"alpha-payload-bytes\"))\n106|\t\tplan := []PlanItem{{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true}}\n107|\t\tfor index := 0; index < keys; index++ {\n108|\t\t\tkey := \"store/zz-unknown-\" + string(rune('a'+index))\n109|\t\t\twriteStoreFile(t, storeRoot, key, []byte(\"unknown-bytes\"))\n110|\t\t\tplan = append(plan, PlanItem{NativeKey: key, Class: \"unknown\", Required: true})\n111|\t\t}\n112|\t\t// Sorted: blob-a, then the zz-unknown keys in order.\n113|\t\trequest := validCaptureRequest(t, storeRoot, openTestStore(t))\n114|\t\trequest.Plan = plan\n115|\t\tcaptured := mustCapture(t, request)\n116|\t\tif captured.Capture.RawComplete {\n117|\t\t\tt.Fatal(\"RawComplete = true with unknown-class items\")\n118|\t\t}\n119|\t\t_, err := AdmitForTarget(captured.CaptureManifest, \"maximal_safe\")\n120|\t\tif err == nil {\n121|\t\t\tt.Fatalf(\"AdmitForTarget(maximal_safe) = nil with %d unknown items\", keys)\n122|\t\t}\n123|\t\treturn err\n124|\t}\n125|\trequireRefusalDetail(t, admitUnknown(t, 2), \"maximal_safe\")\n126|\t// The two-item manifest still refuses after the\n127|\t// admit-exactly-three-items narrowing.\n128|\trequireRefusalDetail(t, admitUnknown(t, 1), \"maximal_safe\")\n129|}\n130|\n131|func TestProjectMaximalSafeAdmitsComplete(t *testing.T) {\n132|\tprojected, err := projectValid(t, \"maximal_safe\")\n133|\tif err != nil {\n134|\t\tt.Fatalf(\"CaptureAndProject(maximal_safe) error = %v\", err)\n135|\t}\n136|\tif !projected.ReceiptInstalled {\n137|\t\tt.Fatal(\"complete maximal_safe capture installed no receipt\")\n138|\t}\n139|}\n140|\n141|func TestProjectStrictExactAdmitsUnknown(t *testing.T) {\n142|\tstoreRoot := fixtureStore(t)\n143|\twriteStoreFile(t, storeRoot, \"store/zz-unknown\", []byte(\"unknown-kind-bytes\"))\n144|\tstoreSink := openTestStore(t)\n145|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n146|\trequest.Plan = []PlanItem{\n147|\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n148|\t\t{NativeKey: \"store/blob-b\", Class: \"durable_sidecar\", Required: true},\n149|\t\t{NativeKey: \"store/token-cache\", Class: \"credential\", Required: false},\n150|\t\t{NativeKey: \"store/zz-unknown\", Class: \"unknown\", Required: true},\n151|\t}\n152|\tprojected, err := CaptureAndProject(ProjectRequest{\n153|\t\tCapture:         request,\n154|\t\tTargetSink:      openTestStore(t),\n155|\t\tFidelityProfile: \"strict_exact\",\n156|\t})\n157|\tif err != nil {\n158|\t\tt.Fatalf(\"CaptureAndProject(strict_exact) error = %v\", err)\n159|\t}\n160|\tif projected.Capture.Capture.RawComplete {\n161|\t\tt.Fatal(\"RawComplete = true with an unknown-class item\")\n162|\t}\n163|}\n164|\n165|func TestProjectRefusesUnknownProfile(t *testing.T) {\n166|\tstoreRoot := fixtureStore(t)\n167|\tcaptured := mustCapture(t, validCaptureRequest(t, storeRoot, openTestStore(t)))\n168|\tif _, err := AdmitForTarget(captured.CaptureManifest, \"ultra\"); err == nil {\n169|\t\tt.Fatal(\"AdmitForTarget(ultra) = nil, want a refusal\")\n170|\t} else {\n171|\t\trequireRefusalDetail(t, err, `\"ultra\"`, \"strict_exact|maximal_safe|compact|messages_only\")\n172|\t}\n173|\tif _, err := projectValid(t, \"ultra\"); err == nil {\n174|\t\tt.Fatal(\"CaptureAndProject(ultra) admitted, want a refusal\")\n175|\t}\n176|}\n177|\n178|func TestProjectIsIdempotent(t *testing.T) {\n179|\t// A replayed capture installs the same blobs and publishes no\n180|\t// half-written manifest: every manifest blob re-decodes, the\n181|\t// replay verifies and reuses, and the bytes are identical.\n182|\tstoreRoot := fixtureStore(t)\n183|\tstoreSink := openTestStore(t)\n184|\ttargetSink := openTestStore(t)\n185|\tbuild := func() ProjectRequest {\n186|\t\treturn ProjectRequest{\n187|\t\t\tCapture:         validCaptureRequest(t, storeRoot, storeSink),\n188|\t\t\tTargetSink:      targetSink,\n189|\t\t\tFidelityProfile: \"strict_exact\",\n190|\t\t}\n191|\t}\n192|\tfirst, err := CaptureAndProject(build())\n193|\tif err != nil {\n194|\t\tt.Fatalf(\"CaptureAndProject() error = %v\", err)\n195|\t}\n196|\tsecond, err := CaptureAndProject(build())\n197|\tif err != nil {\n198|\t\tt.Fatalf(\"replayed CaptureAndProject() error = %v\", err)\n199|\t}\n200|\tif !bytes.Equal(first.Capture.RawManifest, second.Capture.RawManifest) {\n201|\t\tt.Fatal(\"replayed raw manifest bytes differ\")\n202|\t}\n203|\tif !bytes.Equal(first.Capture.CaptureManifest, second.Capture.CaptureManifest) {\n204|\t\tt.Fatal(\"replayed capture manifest bytes differ\")\n205|\t}\n206|\tif !bytes.Equal(first.Receipt, second.Receipt) {\n207|\t\tt.Fatal(\"replayed receipt bytes differ\")\n208|\t}\n209|\tif second.Capture.RawInstalled || second.Capture.CaptureInstalled || second.ReceiptInstalled {\n210|\t\tt.Fatal(\"replay installed instead of verifying and reusing\")\n211|\t}\n212|\tfor _, blob := range listStoredBlobs(t, storeSink) {\n213|\t\tif _, err := clonebundle.DecodeRawObjectManifest(blob.bytes); err == nil {\n214|\t\t\tcontinue\n215|\t\t}\n216|\t\tif _, err := clonebundle.DecodeCaptureManifest(blob.bytes); err == nil {\n217|\t\t\tcontinue\n218|\t\t}\n219|\t\t// Payload blobs decode as neither manifest; their digest\n220|\t\t// is their identity, verified at install.\n221|\t}\n222|\tcountBefore := len(listStoredBlobs(t, storeSink))\n223|\tthird, err := CaptureAndProject(build())\n224|\tif err != nil {\n225|\t\tt.Fatalf(\"second replay error = %v\", err)\n226|\t}\n227|\t_ = third\n228|\tif countAfter := len(listStoredBlobs(t, storeSink)); countAfter != countBefore {\n229|\t\tt.Fatalf(\"replay changed the blob count %d -> %d\", countBefore, countAfter)\n230|\t}\n231|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c823","stream":{"kind":"session","id":"01a0b27e-c8a1-7be1-9b43-e0047ff1ed44"},"sequence":620,"recorded_at":1780531400001235,"record_type":"event","durability":"durable","causation_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","run_stream":{"kind":"run","id":"42a50646-ac4c-4d20-af82-db3f2b0269ba"},"call_id":"call_01a0b2801ddb75a48273e91473ffffdb","text":"Read text file `internal/clonesnap/refusal_test.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"strings\"\n8|\t\"testing\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n11|)\n12|\n13|var errHookRefused = errors.New(\"test hook refused\")\n14|\n15|// Refusal table: every capture gate refuses through the production\n16|// Capture entry with the offending member named. Each row drives the\n17|// entry; the mutant harness weakens each gate and the named killer\n18|// fails.\n19|\n20|func captureRefusal(t *testing.T, mutate func(*CaptureRequest), store func(t *testing.T, root string)) error {\n21|\tt.Helper()\n22|\tstoreRoot := fixtureStore(t)\n23|\tif store != nil {\n24|\t\tstore(t, storeRoot)\n25|\t}\n26|\tstoreSink := openTestStore(t)\n27|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n28|\tif mutate != nil {\n29|\t\tmutate(&request)\n30|\t}\n31|\tresult, err := Capture(request)\n32|\tif err == nil {\n33|\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n34|\t}\n35|\tif result != nil {\n36|\t\tt.Fatalf(\"Capture() returned a result with error %v\", err)\n37|\t}\n38|\tif !errors.Is(err, ErrInvalid) && !errors.Is(err, clonebundle.ErrInvalid) {\n39|\t\tt.Fatalf(\"Capture() error = %v, want ErrInvalid or the landed refusal\", err)\n40|\t}\n41|\treturn err\n42|}\n43|\n44|func requireRefusalDetail(t *testing.T, err error, fragments ...string) {\n45|\tt.Helper()\n46|\tfor _, fragment := range fragments {\n47|\t\tif !strings.Contains(err.Error(), fragment) {\n48|\t\t\tt.Fatalf(\"refusal %q misses %q\", err.Error(), fragment)\n49|\t\t}\n50|\t}\n51|}\n52|\n53|func TestCaptureRefusesUnplannedMember(t *testing.T) {\n54|\terr := captureRefusal(t, nil, func(t *testing.T, root string) {\n55|\t\twriteStoreFile(t, root, \"store/zz-extra\", []byte(\"unplanned-bytes\"))\n56|\t})\n57|\trequireRefusalDetail(t, err, `\"store/zz-extra\"`, \"not a plan candidate\")\n58|}\n59|\n60|func TestCaptureRefusesPrefixSibling(t *testing.T) {\n61|\t// An unplanned key that merely shares a prefix with a planned\n62|\t// key is still unplanned: the lookup is exact.\n63|\terr := captureRefusal(t, nil, func(t *testing.T, root string) {\n64|\t\twriteStoreFile(t, root, \"store/blob-a-evil\", []byte(\"prefix-sibling-bytes\"))\n65|\t})\n66|\trequireRefusalDetail(t, err, `\"store/blob-a-evil\"`, \"not a plan candidate\")\n67|}\n68|\n69|func TestCaptureRefusesRequiredMissing(t *testing.T) {\n70|\terr := captureRefusal(t, func(request *CaptureRequest) {\n71|\t\trequest.Plan = []PlanItem{\n72|\t\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n73|\t\t\t{NativeKey: \"store/blob-b\", Class: \"durable_sidecar\", Required: true},\n74|\t\t\t{NativeKey: \"store/must-have\", Class: \"durable_payload\", Required: true},\n75|\t\t\t{NativeKey: \"store/token-cache\", Class: \"credential\", Required: false},\n76|\t\t}\n77|\t}, nil)\n78|\trequireRefusalDetail(t, err, `\"store/must-have\"`, \"required but absent\")\n79|}\n80|\n81|func TestCaptureRefusesDuplicatePlanKey(t *testing.T) {\n82|\terr := captureRefusal(t, func(request *CaptureRequest) {\n83|\t\trequest.Plan = []PlanItem{\n84|\t\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n85|\t\t\t{NativeKey: \"store/blob-a\", Class: \"durable_sidecar\", Required: true},\n86|\t\t\t{NativeKey: \"store/token-cache\", Class: \"credential\", Required: false},\n87|\t\t}\n88|\t}, nil)\n89|\trequireRefusalDetail(t, err, \"capture plan keys are not sorted unique\")\n90|\t// An unsorted plan still refuses after the duplicate-only\n91|\t// narrowing: the second case pins the other half.\n92|\tunsorted := captureRefusal(t, func(request *CaptureRequest) {\n93|\t\trequest.Plan = []PlanItem{\n94|\t\t\t{NativeKey: \"store/blob-b\", Class: \"durable_sidecar\", Required: true},\n95|\t\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n96|\t\t}\n97|\t}, nil)\n98|\trequireRefusalDetail(t, unsorted, \"capture plan keys are not sorted unique\")\n99|}\n100|\n101|func TestCaptureRefusesUnsanitizedPlanKey(t *testing.T) {\n102|\t// A UUIDv7 native key is indistinguishable from a fabricated AX\n103|\t// Session identity: the sanitizer refuses it, and nothing is\n104|\t// installed before the refusal.\n105|\tstoreRoot := fixtureStore(t)\n106|\tstoreSink := openTestStore(t)\n107|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n108|\trequest.Plan = []PlanItem{\n109|\t\t{NativeKey: fixtureUUIDKey, Class: \"durable_payload\", Required: true},\n110|\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n111|\t}\n112|\tresult, err := Capture(request)\n113|\tif err == nil {\n114|\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n115|\t}\n116|\trequireRefusalDetail(t, err, fixtureUUIDKey, \"UUIDv7\")\n117|\tif blobs := listStoredBlobs(t, storeSink); len(blobs) != 0 {\n118|\t\tt.Fatalf(\"refused capture installed %d blobs, want none\", len(blobs))\n119|\t}\n120|}\n121|\n122|func TestCaptureRefusesAbsolutePlanKey(t *testing.T) {\n123|\terr := captureRefusal(t, func(request *CaptureRequest) {\n124|\t\trequest.Plan = []PlanItem{\n125|\t\t\t{NativeKey: \"/abs-plan-key\", Class: \"durable_payload\", Required: true},\n126|\t\t}\n127|\t}, nil)\n128|\trequireRefusalDetail(t, err, \"absolute source path\")\n129|}\n130|\n131|func TestCaptureRefusesParentPlanKey(t *testing.T) {\n132|\terr := captureRefusal(t, func(request *CaptureRequest) {\n133|\t\trequest.Plan = []PlanItem{\n134|\t\t\t{NativeKey: \"store/../escape\", Class: \"durable_payload\", Required: true},\n135|\t\t}\n136|\t}, nil)\n137|\trequireRefusalDetail(t, err, `\"store/../escape\"`, \"escapes the store root\")\n138|}\n139|\n140|func TestCaptureRefusesMysteryPlanClass(t *testing.T) {\n141|\tstoreRoot := fixtureStore(t)\n142|\twriteStoreFile(t, storeRoot, \"store/blob-c\", []byte(\"mystery-class-bytes\"))\n143|\tstoreSink := openTestStore(t)\n144|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n145|\trequest.Plan = []PlanItem{\n146|\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n147|\t\t{NativeKey: \"store/blob-c\", Class: \"mystery\", Required: true},\n148|\t}\n149|\tresult, err := Capture(request)\n150|\tif err == nil {\n151|\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n152|\t}\n153|\trequireRefusalDetail(t, err, `\"mystery\"`, \"nine-class vocabulary\")\n154|\tif blobs := listStoredBlobs(t, storeSink); len(blobs) != 0 {\n155|\t\tt.Fatalf(\"refused capture installed %d blobs, want none\", len(blobs))\n156|\t}\n157|}\n158|\n159|func TestCaptureRefusesDirectoryMember(t *testing.T) {\n160|\tstoreRoot := t.TempDir()\n161|\tif err := os.Mkdir(filepath.Join(storeRoot, \"store\"), 0o700); err != nil {\n162|\t\tt.Fatal(err)\n163|\t}\n164|\tstoreSink := openTestStore(t)\n165|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n166|\trequest.Plan = []PlanItem{\n167|\t\t{NativeKey: \"store\", Class: \"durable_payload\", Required: true},\n168|\t}\n169|\tresult, err := Capture(request)\n170|\tif err == nil {\n171|\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n172|\t}\n173|\trequireRefusalDetail(t, err, `\"store\"`)\n174|}\n175|\n176|func TestCaptureRefusesSymlinkedIntermediate(t *testing.T) {\n177|\tstoreRoot := t.TempDir()\n178|\toutside := t.TempDir()\n179|\tif err := os.WriteFile(filepath.Join(outside, \"file\"), []byte(\"outside-bytes\"), 0o600); err != nil {\n180|\t\tt.Fatal(err)\n181|\t}\n182|\tif err := os.Symlink(outside, filepath.Join(storeRoot, \"link-escape\")); err != nil {\n183|\t\tt.Fatal(err)\n184|\t}\n185|\tstoreSink := openTestStore(t)\n186|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n187|\trequest.Plan = []PlanItem{\n188|\t\t{NativeKey: \"link-escape/file\", Class: \"durable_payload\", Required: true},\n189|\t}\n190|\tresult, err := Capture(request)\n191|\tif err == nil {\n192|\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n193|\t}\n194|\trequireRefusalDetail(t, err, \"link-escape/file\", \"symlink\")\n195|\tif blobs := listStoredBlobs(t, storeSink); blobsContain(blobs, \"outside-bytes\") {\n196|\t\tt.Fatal(\"capture installed bytes from outside the store root\")\n197|\t}\n198|}\n199|\n200|func TestCaptureRefusesTrailingSymlink(t *testing.T) {\n201|\tstoreRoot := t.TempDir()\n202|\tif err := os.WriteFile(filepath.Join(storeRoot, \"real-target\"), []byte(\"real-bytes\"), 0o600); err != nil {\n203|\t\tt.Fatal(err)\n204|\t}\n205|\tif err := os.Symlink(\"real-target\", filepath.Join(storeRoot, \"link-escape\")); err != nil {\n206|\t\tt.Fatal(err)\n207|\t}\n208|\tstoreSink := openTestStore(t)\n209|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n210|\trequest.Plan = []PlanItem{\n211|\t\t{NativeKey: \"link-escape\", Class: \"durable_payload\", Required: true},\n212|\t\t{NativeKey: \"real-target\", Class: \"durable_payload\", Required: true},\n213|\t}\n214|\tresult, err := Capture(request)\n215|\tif err == nil {\n216|\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n217|\t}\n218|\trequireRefusalDetail(t, err, \"link-escape\", \"symlink\")\n219|}\n220|\n221|func TestCaptureRefusesBadTuple(t *testing.T) {\n222|\terr := captureRefusal(t, func(request *CaptureRequest) {\n223|\t\trequest.SourceEnvironment = []byte(`{\"environment_id\":\"snap.env\"}`)\n224|\t}, nil)\n225|\trequireRefusalDetail(t, err, \"Environment Tuple\")\n226|}\n227|\n228|func TestCaptureRefusesMixedSourceBasis(t *testing.T) {\n229|\terr := captureRefusal(t, func(request *CaptureRequest) {\n230|\t\trequest.SourceBasis.ExternalSourceRef = \"also-native\"\n231|\t}, nil)\n232|\trequireRefusalDetail(t, err, \"external source reference\")\n233|}\n234|\n235|func TestCaptureRefusesUnknownBasisKind(t *testing.T) {\n236|\terr := captureRefusal(t, func(request *CaptureRequest) {\n237|\t\trequest.SourceBasis.Kind = \"maybe\"\n238|\t}, nil)\n239|\trequireRefusalDetail(t, err, \"ax_session|external_native\")\n240|}\n241|\n242|func TestCaptureRefusesUnsanitizedExternalRef(t *testing.T) {\n243|\terr := captureRefusal(t, func(request *CaptureRequest) {\n244|\t\trequest.SourceBasis = clonebundle.SourceBasisInput{\n245|\t\t\tKind:              \"external_native\",\n246|\t\t\tExternalSourceRef: \"/absolute-source-ref\",\n247|\t\t}\n248|\t}, nil)\n249|\trequireRefusalDetail(t, err, \"absolute source path\")\n250|}\n251|\n252|func TestCaptureRefusesUnknownProofKind(t *testing.T) {\n253|\terr := captureRefusal(t, func(request *CaptureRequest) {\n254|\t\trequest.ProofKind = \"maybe_stable\"\n255|\t}, nil)\n256|\trequireRefusalDetail(t, err, \"closed proof vocabulary\")\n257|}\n258|\n259|func TestCaptureRefusesIdleCouplingViolation(t *testing.T) {\n260|\terr := captureRefusal(t, func(request *CaptureRequest) {\n261|\t\trequest.InputBlocked = false\n262|\t}, nil)\n263|\trequireRefusalDetail(t, err, \"input_blocked\")\n264|}\n265|\n266|func TestCaptureRefusesSnapshotIdentityCoupling(t *testing.T) {\n267|\tidentity := fixtureDigest(\"snap-snapshot-identity\")\n268|\terr := captureRefusal(t, func(request *CaptureRequest) {\n269|\t\trequest.SnapshotIdentity = &identity\n270|\t}, nil)\n271|\trequireRefusalDetail(t, err, \"null snapshot identity\")\n272|\tmissing := captureRefusal(t, func(request *CaptureRequest) {\n273|\t\trequest.ProofKind = \"immutable_snapshot\"\n274|\t}, nil)\n275|\trequireRefusalDetail(t, missing, \"non-null snapshot identity\")\n276|}\n277|\n278|func TestCaptureRefusesEmptyGeneration(t *testing.T) {\n279|\terr := captureRefusal(t, func(request *CaptureRequest) {\n280|\t\trequest.Generation = \"\"\n281|\t}, nil)\n282|\trequireRefusalDetail(t, err, \"string[1..512]\")\n283|}\n284|\n285|func TestCaptureRefusesBadPlanDigest(t *testing.T) {\n286|\terr := captureRefusal(t, func(request *CaptureRequest) {\n287|\t\trequest.CapturePlanDigest = \"not-a-digest\"\n288|\t}, nil)\n289|\trequireRefusalDetail(t, err, \"capture_plan_digest\")\n290|}\n291|\n292|func TestCaptureRefusesBadRacePolicy(t *testing.T) {\n293|\terr := captureRefusal(t, func(request *CaptureRequest) {\n294|\t\trequest.OnRace = RacePolicy(\"maybe\")\n295|\t}, nil)\n296|\trequireRefusalDetail(t, err, \"refuse|archive\")\n297|}\n298|\n299|func TestCaptureRefusesNilStore(t *testing.T) {\n300|\tstoreRoot := fixtureStore(t)\n301|\trequest := validCaptureRequest(t, storeRoot, openTestStore(t))\n302|\trequest.Store = nil\n303|\tresult, err := Capture(request)\n304|\tif err == nil {\n305|\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n306|\t}\n307|\trequireRefusalDetail(t, err, \"object store\")\n308|}\n309|\n310|func TestCaptureRefusesHookError(t *testing.T) {\n311|\terr := captureRefusal(t, func(request *CaptureRequest) {\n312|\t\trequest.Hooks.AfterWalk = func(string) error { return errHookRefused }\n313|\t}, nil)\n314|\trequireRefusalDetail(t, err, \"hook refused\")\n315|}\n316|\n317|func TestCaptureRefusesOversizedMember(t *testing.T) {\n318|\trefuseSized := func(t *testing.T, payload string) error {\n319|\t\tt.Helper()\n320|\t\tstoreRoot := t.TempDir()\n321|\t\twriteStoreFile(t, storeRoot, \"store/only\", []byte(payload))\n322|\t\tstoreSink := openTestStore(t)\n323|\t\trequest := validCaptureRequest(t, storeRoot, storeSink)\n324|\t\trequest.MaxSingleBytes = 10\n325|\t\trequest.Plan = []PlanItem{{NativeKey: \"store/only\", Class: \"durable_payload\", Required: true}}\n326|\t\tresult, err := Capture(request)\n327|\t\tif err == nil {\n328|\t\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n329|\t\t}\n330|\t\treturn err\n331|\t}\n332|\t// An 11-byte member refuses under a 10-byte bound.\n333|\trequireRefusalDetail(t, refuseSized(t, \"0123456789a\"), `\"store/only\"`, \"capability_unavailable\")\n334|\t// A 12-byte member still refuses after the admit-exactly-11\n335|\t// narrowing: the second case pins the other half.\n336|\trequireRefusalDetail(t, refuseSized(t, \"0123456789ab\"), `\"store/only\"`, \"capability_unavailable\")\n337|}\n338|\n339|func TestCaptureRefusesSparseOversizedMember(t *testing.T) {\n340|\t// A 128 GiB + 1 sparse member refuses with\n341|\t// capability_unavailable under the default bound without\n342|\t// reading its bytes and without publishing any manifest.\n343|\tstoreRoot := fixtureStore(t)\n344|\tsparse := filepath.Join(storeRoot, \"store\", \"sparse-huge\")\n345|\tfile, err := os.OpenFile(sparse, os.O_CREATE|os.O_WRONLY, 0o600)\n346|\tif err != nil {\n347|\t\tt.Fatal(err)\n348|\t}\n349|\tif err := file.Truncate(137438953472 + 1); err != nil {\n350|\t\t_ = file.Close()\n351|\t\tt.Skipf(\"sparse truncate: %v\", err)\n352|\t}\n353|\tif err := file.Close(); err != nil {\n354|\t\tt.Fatal(err)\n355|\t}\n356|\tstoreSink := openTestStore(t)\n357|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n358|\trequest.Plan = []PlanItem{\n359|\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n360|\t\t{NativeKey: \"store/blob-b\", Class: \"durable_sidecar\", Required: true},\n361|\t\t{NativeKey: \"store/sparse-huge\", Class: \"durable_payload\", Required: true},\n362|\t\t{NativeKey: \"store/token-cache\", Class: \"credential\", Required: false},\n363|\t}\n364|\tresult, err := Capture(request)\n365|\tif err == nil {\n366|\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n367|\t}\n368|\trequireRefusalDetail(t, err, `\"store/sparse-huge\"`, \"capability_unavailable\")\n369|\tfor _, blob := range listStoredBlobs(t, storeSink) {\n370|\t\tif _, err := clonebundle.DecodeRawObjectManifest(blob.bytes); err == nil {\n371|\t\t\tt.Fatal(\"oversized capture published a raw manifest\")\n372|\t\t}\n373|\t\tif _, err := clonebundle.DecodeCaptureManifest(blob.bytes); err == nil {\n374|\t\t\tt.Fatal(\"oversized capture published a capture manifest\")\n375|\t\t}\n376|\t}\n377|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
