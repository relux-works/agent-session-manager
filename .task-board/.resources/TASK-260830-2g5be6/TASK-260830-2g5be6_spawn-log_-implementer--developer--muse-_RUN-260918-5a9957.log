{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c817","stream":{"kind":"session","id":"01a0b27e-c8a1-7be1-9b43-e0047ff1ed44"},"sequence":614,"recorded_at":1780531400001223,"record_type":"event","durability":"durable","causation_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","run_stream":{"kind":"run","id":"42a50646-ac4c-4d20-af82-db3f2b0269ba"},"task_stream":{"kind":"task","id":"01a0b280-22e6-7172-a92d-191a23bb0052"},"task_id":"01a0b280-22e6-7172-a92d-191a23bb0052","event":{"kind":"output","task_id":"01a0b280-22e6-7172-a92d-191a23bb0052","chunk":"Read text file `internal/clonesnap/refusal_test.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"strings\"\n8|\t\"testing\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n11|)\n12|\n13|var errHookRefused = errors.New(\"test hook refused\")\n14|\n15|// Refusal table: every capture gate refuses through the production\n16|// Capture entry with the offending member named. Each row drives the\n17|// entry; the mutant harness weakens each gate and the named killer\n18|// fails.\n19|\n20|func captureRefusal(t *testing.T, mutate func(*CaptureRequest), store func(t *testing.T, root string)) error {\n21|\tt.Helper()\n22|\tstoreRoot := fixtureStore(t)\n23|\tif store != nil {\n24|\t\tstore(t, storeRoot)\n25|\t}\n26|\tstoreSink := openTestStore(t)\n27|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n28|\tif mutate != nil {\n29|\t\tmutate(&request)\n30|\t}\n31|\tresult, err := Capture(request)\n32|\tif err == nil {\n33|\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n34|\t}\n35|\tif result != nil {\n36|\t\tt.Fatalf(\"Capture() returned a result with error %v\", err)\n37|\t}\n38|\tif !errors.Is(err, ErrInvalid) && !errors.Is(err, clonebundle.ErrInvalid) {\n39|\t\tt.Fatalf(\"Capture() error = %v, want ErrInvalid or the landed refusal\", err)\n40|\t}\n41|\treturn err\n42|}\n43|\n44|func requireRefusalDetail(t *testing.T, err error, fragments ...string) {\n45|\tt.Helper()\n46|\tfor _, fragment := range fragments {\n47|\t\tif !strings.Contains(err.Error(), fragment) {\n48|\t\t\tt.Fatalf(\"refusal %q misses %q\", err.Error(), fragment)\n49|\t\t}\n50|\t}\n51|}\n52|\n53|func TestCaptureRefusesUnplannedMember(t *testing.T) {\n54|\terr := captureRefusal(t, nil, func(t *testing.T, root string) {\n55|\t\twriteStoreFile(t, root, \"store/zz-extra\", []byte(\"unplanned-bytes\"))\n56|\t})\n57|\trequireRefusalDetail(t, err, `\"store/zz-extra\"`, \"not a plan candidate\")\n58|}\n59|\n60|func TestCaptureRefusesPrefixSibling(t *testing.T) {\n61|\t// An unplanned key that merely shares a prefix with a planned\n62|\t// key is still unplanned: the lookup is exact.\n63|\terr := captureRefusal(t, nil, func(t *testing.T, root string) {\n64|\t\twriteStoreFile(t, root, \"store/blob-a-evil\", []byte(\"prefix-sibling-bytes\"))\n65|\t})\n66|\trequireRefusalDetail(t, err, `\"store/blob-a-evil\"`, \"not a plan candidate\")\n67|}\n68|\n69|func TestCaptureRefusesRequiredMissing(t *testing.T) {\n70|\terr := captureRefusal(t, func(request *CaptureRequest) {\n71|\t\trequest.Plan = []PlanItem{\n72|\t\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n73|\t\t\t{NativeKey: \"store/blob-b\", Class: \"durable_sidecar\", Required: true},\n74|\t\t\t{NativeKey: \"store/must-have\", Class: \"durable_payload\", Required: true},\n75|\t\t\t{NativeKey: \"store/token-cache\", Class: \"credential\", Required: false},\n76|\t\t}\n77|\t}, nil)\n78|\trequireRefusalDetail(t, err, `\"store/must-have\"`, \"required but absent\")\n79|}\n80|\n81|func TestCaptureRefusesDuplicatePlanKey(t *testing.T) {\n82|\terr := captureRefusal(t, func(request *CaptureRequest) {\n83|\t\trequest.Plan = []PlanItem{\n84|\t\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n85|\t\t\t{NativeKey: \"store/blob-a\", Class: \"durable_sidecar\", Required: true},\n86|\t\t\t{NativeKey: \"store/token-cache\", Class: \"credential\", Required: false},\n87|\t\t}\n88|\t}, nil)\n89|\trequireRefusalDetail(t, err, \"capture plan keys are not sorted unique\")\n90|\t// An unsorted plan still refuses after the duplicate-only\n91|\t// narrowing: the second case pins the other half.\n92|\tunsorted := captureRefusal(t, func(request *CaptureRequest) {\n93|\t\trequest.Plan = []PlanItem{\n94|\t\t\t{NativeKey: \"store/blob-b\", Class: \"durable_sidecar\", Required: true},\n95|\t\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n96|\t\t}\n97|\t}, nil)\n98|\trequireRefusalDetail(t, unsorted, \"capture plan keys are not sorted unique\")\n99|}\n100|\n101|func TestCaptureRefusesUnsanitizedPlanKey(t *testing.T) {\n102|\t// A UUIDv7 native key is indistinguishable from a fabricated AX\n103|\t// Session identity: the sanitizer refuses it, and nothing is\n104|\t// installed before the refusal.\n105|\tstoreRoot := fixtureStore(t)\n106|\tstoreSink := openTestStore(t)\n107|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n108|\trequest.Plan = []PlanItem{\n109|\t\t{NativeKey: fixtureUUIDKey, Class: \"durable_payload\", Required: true},\n110|\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n111|\t}\n112|\tresult, err := Capture(request)\n113|\tif err == nil {\n114|\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n115|\t}\n116|\trequireRefusalDetail(t, err, fixtureUUIDKey, \"UUIDv7\")\n117|\tif blobs := listStoredBlobs(t, storeSink); len(blobs) != 0 {\n118|\t\tt.Fatalf(\"refused capture installed %d blobs, want none\", len(blobs))\n119|\t}\n120|}\n121|\n122|func TestCaptureRefusesAbsolutePlanKey(t *testing.T) {\n123|\terr := captureRefusal(t, func(request *CaptureRequest) {\n124|\t\trequest.Plan = []PlanItem{\n125|\t\t\t{NativeKey: \"/abs-plan-key\", Class: \"durable_payload\", Required: true},\n126|\t\t}\n127|\t}, nil)\n128|\trequireRefusalDetail(t, err, \"absolute source path\")\n129|}\n130|\n131|func TestCaptureRefusesParentPlanKey(t *testing.T) {\n132|\terr := captureRefusal(t, func(request *CaptureRequest) {\n133|\t\trequest.Plan = []PlanItem{\n134|\t\t\t{NativeKey: \"store/../escape\", Class: \"durable_payload\", Required: true},\n135|\t\t}\n136|\t}, nil)\n137|\trequireRefusalDetail(t, err, `\"store/../escape\"`, \"escapes the store root\")\n138|}\n139|\n140|func TestCaptureRefusesMysteryPlanClass(t *testing.T) {\n141|\tstoreRoot := fixtureStore(t)\n142|\twriteStoreFile(t, storeRoot, \"store/blob-c\", []byte(\"mystery-class-bytes\"))\n143|\tstoreSink := openTestStore(t)\n144|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n145|\trequest.Plan = []PlanItem{\n146|\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n147|\t\t{NativeKey: \"store/blob-c\", Class: \"mystery\", Required: true},\n148|\t}\n149|\tresult, err := Capture(request)\n150|\tif err == nil {\n151|\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n152|\t}\n153|\trequireRefusalDetail(t, err, `\"mystery\"`, \"nine-class vocabulary\")\n154|\tif blobs := listStoredBlobs(t, storeSink); len(blobs) != 0 {\n155|\t\tt.Fatalf(\"refused capture installed %d blobs, want none\", len(blobs))\n156|\t}\n157|}\n158|\n159|func TestCaptureRefusesDirectoryMember(t *testing.T) {\n160|\tstoreRoot := t.TempDir()\n161|\tif err := os.Mkdir(filepath.Join(storeRoot, \"store\"), 0o700); err != nil {\n162|\t\tt.Fatal(err)\n163|\t}\n164|\tstoreSink := openTestStore(t)\n165|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n166|\trequest.Plan = []PlanItem{\n167|\t\t{NativeKey: \"store\", Class: \"durable_payload\", Required: true},\n168|\t}\n169|\tresult, err := Capture(request)\n170|\tif err == nil {\n171|\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n172|\t}\n173|\trequireRefusalDetail(t, err, `\"store\"`)\n174|}\n175|\n176|func TestCaptureRefusesSymlinkedIntermediate(t *testing.T) {\n177|\tstoreRoot := t.TempDir()\n178|\toutside := t.TempDir()\n179|\tif err := os.WriteFile(filepath.Join(outside, \"file\"), []byte(\"outside-bytes\"), 0o600); err != nil {\n180|\t\tt.Fatal(err)\n181|\t}\n182|\tif err := os.Symlink(outside, filepath.Join(storeRoot, \"link-escape\")); err != nil {\n183|\t\tt.Fatal(err)\n184|\t}\n185|\tstoreSink := openTestStore(t)\n186|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n187|\trequest.Plan = []PlanItem{\n188|\t\t{NativeKey: \"link-escape/file\", Class: \"durable_payload\", Required: true},\n189|\t}\n190|\tresult, err := Capture(request)\n191|\tif err == nil {\n192|\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n193|\t}\n194|\trequireRefusalDetail(t, err, \"link-escape/file\", \"symlink\")\n195|\tif blobs := listStoredBlobs(t, storeSink); blobsContain(blobs, \"outside-bytes\") {\n196|\t\tt.Fatal(\"capture installed bytes from outside the store root\")\n197|\t}\n198|}\n199|\n200|func TestCaptureRefusesTrailingSymlink(t *testing.T) {\n201|\tstoreRoot := t.TempDir()\n202|\tif err := os.WriteFile(filepath.Join(storeRoot, \"real-target\"), []byte(\"real-bytes\"), 0o600); err != nil {\n203|\t\tt.Fatal(err)\n204|\t}\n205|\tif err := os.Symlink(\"real-target\", filepath.Join(storeRoot, \"link-escape\")); err != nil {\n206|\t\tt.Fatal(err)\n207|\t}\n208|\tstoreSink := openTestStore(t)\n209|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n210|\trequest.Plan = []PlanItem{\n211|\t\t{NativeKey: \"link-escape\", Class: \"durable_payload\", Required: true},\n212|\t\t{NativeKey: \"real-target\", Class: \"durable_payload\", Required: true},\n213|\t}\n214|\tresult, err := Capture(request)\n215|\tif err == nil {\n216|\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n217|\t}\n218|\trequireRefusalDetail(t, err, \"link-escape\", \"symlink\")\n219|}\n220|\n221|func TestCaptureRefusesBadTuple(t *testing.T) {\n222|\terr := captureRefusal(t, func(request *CaptureRequest) {\n223|\t\trequest.SourceEnvironment = []byte(`{\"environment_id\":\"snap.env\"}`)\n224|\t}, nil)\n225|\trequireRefusalDetail(t, err, \"Environment Tuple\")\n226|}\n227|\n228|func TestCaptureRefusesMixedSourceBasis(t *testing.T) {\n229|\terr := captureRefusal(t, func(request *CaptureRequest) {\n230|\t\trequest.SourceBasis.ExternalSourceRef = \"also-native\"\n231|\t}, nil)\n232|\trequireRefusalDetail(t, err, \"external source reference\")\n233|}\n234|\n235|func TestCaptureRefusesUnknownBasisKind(t *testing.T) {\n236|\terr := captureRefusal(t, func(request *CaptureRequest) {\n237|\t\trequest.SourceBasis.Kind = \"maybe\"\n238|\t}, nil)\n239|\trequireRefusalDetail(t, err, \"ax_session|external_native\")\n240|}\n241|\n242|func TestCaptureRefusesUnsanitizedExternalRef(t *testing.T) {\n243|\terr := captureRefusal(t, func(request *CaptureRequest) {\n244|\t\trequest.SourceBasis = clonebundle.SourceBasisInput{\n245|\t\t\tKind:              \"external_native\",\n246|\t\t\tExternalSourceRef: \"/absolute-source-ref\",\n247|\t\t}\n248|\t}, nil)\n249|\trequireRefusalDetail(t, err, \"absolute source path\")\n250|}\n251|\n252|func TestCaptureRefusesUnknownProofKind(t *testing.T) {\n253|\terr := captureRefusal(t, func(request *CaptureRequest) {\n254|\t\trequest.ProofKind = \"maybe_stable\"\n255|\t}, nil)\n256|\trequireRefusalDetail(t, err, \"closed proof vocabulary\")\n257|}\n258|\n259|func TestCaptureRefusesIdleCouplingViolation(t *testing.T) {\n260|\terr := captureRefusal(t, func(request *CaptureRequest) {\n261|\t\trequest.InputBlocked = false\n262|\t}, nil)\n263|\trequireRefusalDetail(t, err, \"input_blocked\")\n264|}\n265|\n266|func TestCaptureRefusesSnapshotIdentityCoupling(t *testing.T) {\n267|\tidentity := fixtureDigest(\"snap-snapshot-identity\")\n268|\terr := captureRefusal(t, func(request *CaptureRequest) {\n269|\t\trequest.SnapshotIdentity = &identity\n270|\t}, nil)\n271|\trequireRefusalDetail(t, err, \"null snapshot identity\")\n272|\tmissing := captureRefusal(t, func(request *CaptureRequest) {\n273|\t\trequest.ProofKind = \"immutable_snapshot\"\n274|\t}, nil)\n275|\trequireRefusalDetail(t, missing, \"non-null snapshot identity\")\n276|}\n277|\n278|func TestCaptureRefusesEmptyGeneration(t *testing.T) {\n279|\terr := captureRefusal(t, func(request *CaptureRequest) {\n280|\t\trequest.Generation = \"\"\n281|\t}, nil)\n282|\trequireRefusalDetail(t, err, \"string[1..512]\")\n283|}\n284|\n285|func TestCaptureRefusesBadPlanDigest(t *testing.T) {\n286|\terr := captureRefusal(t, func(request *CaptureRequest) {\n287|\t\trequest.CapturePlanDigest = \"not-a-digest\"\n288|\t}, nil)\n289|\trequireRefusalDetail(t, err, \"capture_plan_digest\")\n290|}\n291|\n292|func TestCaptureRefusesBadRacePolicy(t *testing.T) {\n293|\terr := captureRefusal(t, func(request *CaptureRequest) {\n294|\t\trequest.OnRace = RacePolicy(\"maybe\")\n295|\t}, nil)\n296|\trequireRefusalDetail(t, err, \"refuse|archive\")\n297|}\n298|\n299|func TestCaptureRefusesNilStore(t *testing.T) {\n300|\tstoreRoot := fixtureStore(t)\n301|\trequest := validCaptureRequest(t, storeRoot, openTestStore(t))\n302|\trequest.Store = nil\n303|\tresult, err := Capture(request)\n304|\tif err == nil {\n305|\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n306|\t}\n307|\trequireRefusalDetail(t, err, \"object store\")\n308|}\n309|\n310|func TestCaptureRefusesHookError(t *testing.T) {\n311|\terr := captureRefusal(t, func(request *CaptureRequest) {\n312|\t\trequest.Hooks.AfterWalk = func(string) error { return errHookRefused }\n313|\t}, nil)\n314|\trequireRefusalDetail(t, err, \"hook refused\")\n315|}\n316|\n317|func TestCaptureRefusesOversizedMember(t *testing.T) {\n318|\trefuseSized := func(t *testing.T, payload string) error {\n319|\t\tt.Helper()\n320|\t\tstoreRoot := t.TempDir()\n321|\t\twriteStoreFile(t, storeRoot, \"store/only\", []byte(payload))\n322|\t\tstoreSink := openTestStore(t)\n323|\t\trequest := validCaptureRequest(t, storeRoot, storeSink)\n324|\t\trequest.MaxSingleBytes = 10\n325|\t\trequest.Plan = []PlanItem{{NativeKey: \"store/only\", Class: \"durable_payload\", Required: true}}\n326|\t\tresult, err := Capture(request)\n327|\t\tif err == nil {\n328|\t\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n329|\t\t}\n330|\t\treturn err\n331|\t}\n332|\t// An 11-byte member refuses under a 10-byte bound.\n333|\trequireRefusalDetail(t, refuseSized(t, \"0123456789a\"), `\"store/only\"`, \"capability_unavailable\")\n334|\t// A 12-byte member still refuses after the admit-exactly-11\n335|\t// narrowing: the second case pins the other half.\n336|\trequireRefusalDetail(t, refuseSized(t, \"0123456789ab\"), `\"store/only\"`, \"capability_unavailable\")\n337|}\n338|\n339|func TestCaptureRefusesSparseOversizedMember(t *testing.T) {\n340|\t// A 128 GiB + 1 sparse member refuses with\n341|\t// capability_unavailable under the default bound without\n342|\t// reading its bytes and without publishing any manifest.\n343|\tstoreRoot := fixtureStore(t)\n344|\tsparse := filepath.Join(storeRoot, \"store\", \"sparse-huge\")\n345|\tfile, err := os.OpenFile(sparse, os.O_CREATE|os.O_WRONLY, 0o600)\n346|\tif err != nil {\n347|\t\tt.Fatal(err)\n348|\t}\n349|\tif err := file.Truncate(137438953472 + 1); err != nil {\n350|\t\t_ = file.Close()\n351|\t\tt.Skipf(\"sparse truncate: %v\", err)\n352|\t}\n353|\tif err := file.Close(); err != nil {\n354|\t\tt.Fatal(err)\n355|\t}\n356|\tstoreSink := openTestStore(t)\n357|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n358|\trequest.Plan = []PlanItem{\n359|\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n360|\t\t{NativeKey: \"store/blob-b\", Class: \"durable_sidecar\", Required: true},\n361|\t\t{NativeKey: \"store/sparse-huge\", Class: \"durable_payload\", Required: true},\n362|\t\t{NativeKey: \"store/token-cache\", Class: \"credential\", Required: false},\n363|\t}\n364|\tresult, err := Capture(request)\n365|\tif err == nil {\n366|\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n367|\t}\n368|\trequireRefusalDetail(t, err, `\"store/sparse-huge\"`, \"capability_unavailable\")\n369|\tfor _, blob := range listStoredBlobs(t, storeSink) {\n370|\t\tif _, err := clonebundle.DecodeRawObjectManifest(blob.bytes); err == nil {\n371|\t\t\tt.Fatal(\"oversized capture published a raw manifest\")\n372|\t\t}\n373|\t\tif _, err := clonebundle.DecodeCaptureManifest(blob.bytes); err == nil {\n374|\t\t\tt.Fatal(\"oversized capture published a capture manifest\")\n375|\t\t}\n376|\t}\n377|}","final_result":true}}}
