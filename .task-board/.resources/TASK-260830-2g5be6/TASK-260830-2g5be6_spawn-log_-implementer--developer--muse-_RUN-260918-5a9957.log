{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c813","stream":{"kind":"session","id":"01a0b27e-c8a1-7be1-9b43-e0047ff1ed44"},"sequence":612,"recorded_at":1780531400001219,"record_type":"event","durability":"durable","causation_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","run_stream":{"kind":"run","id":"42a50646-ac4c-4d20-af82-db3f2b0269ba"},"task_stream":{"kind":"task","id":"01a0b280-227d-7462-bc31-ae0ee5a33e42"},"task_id":"01a0b280-227d-7462-bc31-ae0ee5a33e42","event":{"kind":"output","task_id":"01a0b280-227d-7462-bc31-ae0ee5a33e42","chunk":"Read text file `internal/clonesnap/race_test.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"os\"\n5|\t\"path/filepath\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n10|)\n11|\n12|// Source-race evidence: a changed byte, a changed size, an appended\n13|// record, and a replaced file each refuse — or seal the\n14|// unstable_archive form with source_not_quiescent — and the mutation\n15|// check runs before any seal or projection output. The AfterWalk\n16|// hook injects each mutation deterministically between the capture\n17|// walk and the post-capture measurement.\n18|\n19|func mutateAfterWalk(t *testing.T, mutate func(root string)) func(string) error {\n20|\tt.Helper()\n21|\treturn func(root string) error {\n22|\t\tmutate(root)\n23|\t\treturn nil\n24|\t}\n25|}\n26|\n27|func raceRefusal(t *testing.T, mutate func(root string)) error {\n28|\tt.Helper()\n29|\tstoreRoot := fixtureStore(t)\n30|\tstoreSink := openTestStore(t)\n31|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n32|\trequest.Hooks.AfterWalk = mutateAfterWalk(t, mutate)\n33|\tresult, err := Capture(request)\n34|\tif err == nil {\n35|\t\tt.Fatalf(\"Capture() = %+v, want a race refusal\", result)\n36|\t}\n37|\trequireRefusalDetail(t, err, \"source mutated during capture\")\n38|\treturn err\n39|}\n40|\n41|func TestCaptureRaceChangedByte(t *testing.T) {\n42|\t// The first case mutates blob-a at equal size: size equality is\n43|\t// never proof, so the content digests still disagree.\n44|\terr := raceRefusal(t, func(root string) {\n45|\t\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"alpha-payload-bytez\"))\n46|\t})\n47|\trequireRefusalDetail(t, err, `\"store/blob-a\"`, \"capture digests differ\")\n48|\t// The second case mutates blob-b: other members still refuse\n49|\t// after the admit-exactly-blob-a narrowing.\n50|\tother := raceRefusal(t, func(root string) {\n51|\t\twriteStoreFile(t, root, \"store/blob-b\", []byte(\"beta-payload-bytez\"))\n52|\t})\n53|\trequireRefusalDetail(t, other, `\"store/blob-b\"`, \"capture digests differ\")\n54|}\n55|\n56|func TestCaptureRaceChangedSize(t *testing.T) {\n57|\terr := raceRefusal(t, func(root string) {\n58|\t\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"alpha-payload-bytes-extended\"))\n59|\t})\n60|\trequireRefusalDetail(t, err, `\"store/blob-a\"`)\n61|}\n62|\n63|func TestCaptureRaceAppendedRecord(t *testing.T) {\n64|\terr := raceRefusal(t, func(root string) {\n65|\t\twriteStoreFile(t, root, \"store/blob-appended\", []byte(\"appended-bytes\"))\n66|\t})\n67|\trequireRefusalDetail(t, err, `\"store/blob-appended\"`)\n68|}\n69|\n70|func TestCaptureRaceReplacedFile(t *testing.T) {\n71|\terr := raceRefusal(t, func(root string) {\n72|\t\tif err := os.Remove(filepath.Join(root, \"store\", \"blob-a\")); err != nil {\n73|\t\t\tt.Fatal(err)\n74|\t\t}\n75|\t\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"replacement-bytes\"))\n76|\t})\n77|\trequireRefusalDetail(t, err, `\"store/blob-a\"`)\n78|}\n79|\n80|func TestCaptureRaceRemovedFile(t *testing.T) {\n81|\terr := raceRefusal(t, func(root string) {\n82|\t\tif err := os.Remove(filepath.Join(root, \"store\", \"blob-b\")); err != nil {\n83|\t\t\tt.Fatal(err)\n84|\t\t}\n85|\t})\n86|\trequireRefusalDetail(t, err, `\"store/blob-b\"`)\n87|}\n88|\n89|func TestCaptureArchiveSealsUnstable(t *testing.T) {\n90|\tstoreRoot := fixtureStore(t)\n91|\tstoreSink := openTestStore(t)\n92|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n93|\trequest.OnRace = RaceArchive\n94|\trequest.OperatorExplicit = true\n95|\trequest.Hooks.AfterWalk = mutateAfterWalk(t, func(root string) {\n96|\t\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"alpha-payload-bytez\"))\n97|\t})\n98|\tresult := mustCapture(t, request)\n99|\tif result.BoundaryKind != \"unstable_archive\" {\n100|\t\tt.Fatalf(\"BoundaryKind = %q, want unstable_archive\", result.BoundaryKind)\n101|\t}\n102|\tif result.PreDigest == result.PostDigest {\n103|\t\tt.Fatal(\"PreDigest == PostDigest despite the injected mutation\")\n104|\t}\n105|\tmanifest, err := clonebundle.DecodeCaptureManifest(result.CaptureManifest)\n106|\tif err != nil {\n107|\t\tt.Fatalf(\"DecodeCaptureManifest() error = %v\", err)\n108|\t}\n109|\tif manifest.CaptureBoundary.Stable() {\n110|\t\tt.Fatal(\"sealed boundary is stable after a detected mutation\")\n111|\t}\n112|\tsealed := string(result.CaptureManifest)\n113|\tif !strings.Contains(sealed, `\"kind\":\"unstable_archive\"`) {\n114|\t\tt.Fatal(\"sealed manifest misses the unstable_archive kind\")\n115|\t}\n116|\tif !strings.Contains(sealed, `\"reason_code\":\"source_not_quiescent\"`) {\n117|\t\tt.Fatal(\"sealed manifest misses reason_code source_not_quiescent\")\n118|\t}\n119|\tif !strings.Contains(sealed, `\"operator_explicit\":true`) {\n120|\t\tt.Fatal(\"sealed manifest misses operator_explicit true\")\n121|\t}\n122|\tif !strings.Contains(sealed, `\"target_projection_forbidden\":true`) {\n123|\t\tt.Fatal(\"sealed manifest misses target_projection_forbidden true\")\n124|\t}\n125|\tif err := clonebundle.RefuseUnstableForTarget(manifest.CaptureBoundary); err == nil {\n126|\t\tt.Fatal(\"RefuseUnstableForTarget() = nil for archive output\")\n127|\t}\n128|}\n129|\n130|func TestCaptureArchiveRequiresExplicit(t *testing.T) {\n131|\tarchive := func(t *testing.T, generation string) error {\n132|\t\tt.Helper()\n133|\t\tstoreRoot := fixtureStore(t)\n134|\t\tstoreSink := openTestStore(t)\n135|\t\trequest := validCaptureRequest(t, storeRoot, storeSink)\n136|\t\trequest.OnRace = RaceArchive\n137|\t\trequest.OperatorExplicit = false\n138|\t\trequest.Generation = generation\n139|\t\trequest.Hooks.AfterWalk = mutateAfterWalk(t, func(root string) {\n140|\t\t\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"alpha-payload-bytez\"))\n141|\t\t})\n142|\t\tresult, err := Capture(request)\n143|\t\tif err == nil {\n144|\t\t\tt.Fatalf(\"Capture() = %+v, want an acknowledgement refusal\", result)\n145|\t\t}\n146|\t\treturn err\n147|\t}\n148|\trequireRefusalDetail(t, archive(t, \"generation-9\"), \"explicit operator acknowledgement\")\n149|\t// A different generation still refuses after the\n150|\t// admit-exactly-generation-9 narrowing.\n151|\trequireRefusalDetail(t, archive(t, \"generation-10\"), \"explicit operator acknowledgement\")\n152|}\n153|\n154|func TestCaptureRaceSealsNoManifest(t *testing.T) {\n155|\t// The race gate precedes the seal: a mutated source leaves no\n156|\t// manifest blob behind, only the orphaned payload prefix.\n157|\tstoreRoot := fixtureStore(t)\n158|\tstoreSink := openTestStore(t)\n159|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n160|\trequest.Hooks.AfterWalk = mutateAfterWalk(t, func(root string) {\n161|\t\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"alpha-payload-bytez\"))\n162|\t})\n163|\tresult, err := Capture(request)\n164|\tif err == nil {\n165|\t\tt.Fatalf(\"Capture() = %+v, want a race refusal\", result)\n166|\t}\n167|\tif result != nil {\n168|\t\tt.Fatalf(\"Capture() returned a result with error %v\", err)\n169|\t}\n170|\tfor _, blob := range listStoredBlobs(t, storeSink) {\n171|\t\tif _, err := clonebundle.DecodeRawObjectManifest(blob.bytes); err == nil {\n172|\t\t\tt.Fatal(\"mutated capture sealed a raw manifest before the race gate\")\n173|\t\t}\n174|\t\tif _, err := clonebundle.DecodeCaptureManifest(blob.bytes); err == nil {\n175|\t\t\tt.Fatal(\"mutated capture sealed a capture manifest before the race gate\")\n176|\t\t}\n177|\t}\n178|}\n179|\n180|func TestCaptureRaceEmitsNoReceipt(t *testing.T) {\n181|\t// The race gate precedes projection output: a mutated source\n182|\t// leaves the target sink empty.\n183|\tstoreRoot := fixtureStore(t)\n184|\tstoreSink := openTestStore(t)\n185|\ttargetSink := openTestStore(t)\n186|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n187|\trequest.Hooks.AfterWalk = mutateAfterWalk(t, func(root string) {\n188|\t\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"alpha-payload-bytez\"))\n189|\t})\n190|\tprojected, err := CaptureAndProject(ProjectRequest{\n191|\t\tCapture:         request,\n192|\t\tTargetSink:      targetSink,\n193|\t\tFidelityProfile: \"strict_exact\",\n194|\t})\n195|\tif err == nil {\n196|\t\tt.Fatalf(\"CaptureAndProject() = %+v, want a race refusal\", projected)\n197|\t}\n198|\tif blobs := listStoredBlobs(t, targetSink); len(blobs) != 0 {\n199|\t\tt.Fatalf(\"mutated capture emitted %d receipt blobs before the race gate\", len(blobs))\n200|\t}\n201|}\n202|\n203|func TestCaptureHookFires(t *testing.T) {\n204|\tstoreRoot := fixtureStore(t)\n205|\tstoreSink := openTestStore(t)\n206|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n207|\tfired := false\n208|\trequest.Hooks.AfterRawPublish = func() error {\n209|\t\tfired = true\n210|\t\treturn nil\n211|\t}\n212|\tmustCapture(t, request)\n213|\tif !fired {\n214|\t\tt.Fatal(\"AfterRawPublish hook did not fire\")\n215|\t}\n216|}","final_result":true}}}
