{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c70b","stream":{"kind":"session","id":"01a0b27e-c8a1-7be1-9b43-e0047ff1ed44"},"sequence":480,"recorded_at":1780531400000955,"record_type":"event","durability":"durable","causation_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","run_stream":{"kind":"run","id":"42a50646-ac4c-4d20-af82-db3f2b0269ba"},"call_id":"call_01a0b27fdafa75dd98bcfdef15672ea0","text":"Read text file `internal/clonesnap/capture.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"os\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/localstore\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n11|)\n12|\n13|// This file owns the native capture operation: Capture walks a real\n14|// provider store directory through the contained walk, installs\n15|// payload blobs through the landed no-replace discipline, seals the\n16|// Raw Object Manifest and Capture Manifest through the landed\n17|// builders, publishes both through the object store, and checkpoints\n18|// the workspace binding. The source-race gate runs after the\n19|// post-capture measurement and before any seal: a detected mutation\n20|// refuses, or seals the core-created unstable_archive form for\n21|// archive-only output when the operator explicitly acknowledged\n22|// archival. Nothing sealed here is trusted undecoded: every sealed\n23|// manifest re-decodes through the landed decoder before it is\n24|// published or returned.\n25|\n26|// RacePolicy decides a detected source mutation: RaceRefuse aborts\n27|// capture with no sealed manifest; RaceArchive seals the\n28|// unstable_archive form for archive-only output, which can never\n29|// enter a target branch.\n30|type RacePolicy string\n31|\n32|const (\n33|\t// RaceRefuse aborts capture on a detected source mutation.\n34|\tRaceRefuse RacePolicy = \"refuse\"\n35|\t// RaceArchive seals unstable_archive output on a detected\n36|\t// source mutation. It requires OperatorExplicit.\n37|\tRaceArchive RacePolicy = \"archive\"\n38|)\n39|\n40|// CaptureHooks carries the crash and race seams: AfterWalk runs\n41|// between the capture walk and the post-capture measurement (race\n42|// injection observes here), AfterRawPublish runs between the raw\n43|// manifest publish and the capture manifest seal (crash kill lands\n44|// here). A hook error aborts capture; a hook that never returns\n45|// (process kill) leaves at most the published prefix behind.\n46|type CaptureHooks struct {\n47|\tAfterWalk       func(storeRoot string) error\n48|\tAfterRawPublish func() error\n49|}\n50|\n51|// CaptureRequest is one native capture candidate over a provider\n52|// store directory.\n53|type CaptureRequest struct {\n54|\t// StoreRoot is the absolute provider store directory. Every\n55|\t// payload open descends from its verified handle.\n56|\tStoreRoot string\n57|\t// Platform governs member-name grammar.\n58|\tPlatform scalar.Platform\n59|\t// Plan carries the sorted unique capture-plan candidates.\n60|\tPlan []PlanItem\n61|\t// OperationID and BundleID identify the clone operation and\n62|\t// the logical bundle chain.\n63|\tOperationID string\n64|\tBundleID    string\n65|\t// SourceBasis binds ax_session or external_native source IDs.\n66|\tSourceBasis clonebundle.SourceBasisInput\n67|\t// SourceEnvironment carries the exact probed Environment Tuple\n68|\t// bytes.\n69|\tSourceEnvironment []byte\n70|\t// SourceIdentity is the sanitized NativeIdentity.\n71|\tSourceIdentity clonebundle.NativeIdentity\n72|\t// CapturePlanDigest is the exact core-validated capture-plan\n73|\t// digest.\n74|\tCapturePlanDigest string\n75|\t// NativeSessionID is the sanitized source native session ID.\n76|\tNativeSessionID string\n77|\t// CreatedByHostID and CreatedAt stamp the capture manifest.\n78|\tCreatedByHostID string\n79|\tCreatedAt       string\n80|\t// Generation is the immutable source generation token.\n81|\tGeneration string\n82|\t// ProofKind is the closed proof vocabulary:\n83|\t// closed_store|immutable_snapshot|verified_log_prefix|provider_quiescence.\n84|\tProofKind string\n85|\t// SnapshotIdentity pins an immutable snapshot; nil unless the\n86|\t// proof kind requires it.\n87|\tSnapshotIdentity *string\n88|\t// InputBlocked, ForegroundIdle, and BackgroundIdle are the\n89|\t// measured idle facts the stable proof seals.\n90|\tInputBlocked   bool\n91|\tForegroundIdle bool\n92|\tBackgroundIdle bool\n93|\t// OperatorExplicit acknowledges archive-only output when the\n94|\t// source is not quiescent.\n95|\tOperatorExplicit bool\n96|\t// OnRace decides a detected mutation: refuse or archive.\n97|\tOnRace RacePolicy\n98|\t// Workspace carries the repository state the workspace\n99|\t// checkpoint seals.\n100|\tWorkspace WorkspaceRequest\n101|\t// Store receives payload blobs and published manifests.\n102|\tStore *localstore.ObjectStore\n103|\t// MaxSingleBytes bounds one captured member; zero selects\n104|\t// DefaultMaxSingleBytes. A larger member fails capture with\n105|\t// capability_unavailable before any manifest is published.\n106|\tMaxSingleBytes uint64\n107|\t// Hooks carries the crash and race seams; nil hooks are skipped.\n108|\tHooks CaptureHooks\n109|}\n110|\n111|// CaptureResult is one completed native capture: the sealed bytes,\n112|// their decoded forms, the measured digests, and the publish facts.\n113|type CaptureResult struct {\n114|\t// RawManifest and CaptureManifest carry the sealed manifest\n115|\t// bytes produced through the landed builders.\n116|\tRawManifest     []byte\n117|\tCaptureManifest []byte\n118|\t// WorkspaceBinding carries the sealed workspace checkpoint.\n119|\tWorkspaceBinding []byte\n120|\t// Decoded forms of the sealed manifests.\n121|\tRaw     clonebundle.RawObjectManifest\n122|\tCapture clonebundle.CaptureManifest\n123|\t// BoundaryKind is stable or unstable_archive, read back from\n124|\t// the sealed capture manifest.\n125|\tBoundaryKind string\n126|\t// PreDigest and PostDigest are the measured source digests.\n127|\tPreDigest  scalar.Digest\n128|\tPostDigest scalar.Digest\n129|\t// RawInstalled and CaptureInstalled report whether this run\n130|\t// installed the manifest blobs (a replay verifies and reuses).\n131|\tRawInstalled     bool\n132|\tCaptureInstalled bool\n133|\t// Logs carries the digest/size/media-only capture log lines.\n134|\tLogs []string\n135|}\n136|\n137|// Capture runs one native capture over the provider store: validate\n138|// the plan, checkpoint the workspace, walk and install payload\n139|// bytes, measure the source race, seal and publish both manifests.\n140|// The race gate precedes the seal (see ORDER-PIN below): a mutation\n141|// refuses, or seals unstable_archive output when archival was\n142|// explicitly acknowledged and requested.\n143|func Capture(request CaptureRequest) (*CaptureResult, error) {\n144|\tstate, err := newPipeline(request)\n145|\tif err != nil {\n146|\t\treturn nil, err\n147|\t}\n148|\tdefer state.close()\n149|\tif err := state.walkAndMeasure(); err != nil {\n150|\t\treturn nil, err\n151|\t}\n152|\t// ORDER-PIN: the source-race gate precedes any seal or publish.\n153|\t// N-race-order-capture moves this gate after sealAndPublish and\n154|\t// the killer reddens on the published manifests.\n155|\tif err := state.gateSourceRace(); err != nil {\n156|\t\treturn state.raceOutcome(err)\n157|\t}\n158|\treturn state.sealAndPublish(false)\n159|}\n160|\n161|// pipeline is one running capture: the validated plan, the open\n162|// store handles, the walked bytes, and the measured digests.\n163|type pipeline struct {\n164|\trequest        CaptureRequest\n165|\tlog            *CaptureLog\n166|\tguard          secprim.Guard\n167|\troot           *os.File\n168|\tplan           map[string]PlanItem\n169|\tplanKeys       []string\n170|\tlimit          uint64\n171|\tcaptured       []capturedMember\n172|\tpre            scalar.Digest\n173|\tpost           scalar.Digest\n174|\tpreLines       []string\n175|\tpostLines      []string\n176|\tworkspaceBytes []byte\n177|}\n178|\n179|func newPipeline(request CaptureRequest) (*pipeline, error) {\n180|\tif request.Store == nil {\n181|\t\treturn nil, invalid(\"capture requires an object store\")\n182|\t}\n183|\tif request.OnRace != RaceRefuse && request.OnRace != RaceArchive {\n184|\t\treturn nil, invalid(\"capture race policy %q is outside refuse|archive\", string(request.OnRace))\n185|\t}\n186|\tplan, err := checkPlan(request.Platform, request.Plan)\n187|\tif err != nil {\n188|\t\treturn nil, err\n189|\t}\n190|\tlimit := request.MaxSingleBytes\n191|\tif limit == 0 {\n192|\t\tlimit = DefaultMaxSingleBytes\n193|\t}\n194|\tworkspaceBytes, err := CheckpointWorkspace(request.Workspace)\n195|\tif err != nil {\n196|\t\treturn nil, err\n197|\t}\n198|\troot, err := secprim.OpenNoFollowDir(request.StoreRoot)\n199|\tif err != nil {\n200|\t\treturn nil, invalid(\"capture store root %q: %v\", request.StoreRoot, err)\n201|\t}\n202|\tguard, err := secprim.NewGuard(request.StoreRoot, request.Platform, nil)\n203|\tif err != nil {\n204|\t\t_ = root.Close()\n205|\t\treturn nil, invalid(\"capture store root %q: %v\", request.StoreRoot, err)\n206|\t}\n207|\tkeys := make([]string, 0, len(request.Plan))\n208|\tfor _, item := range request.Plan {\n209|\t\tkeys = append(keys, item.NativeKey)\n210|\t}\n211|\treturn &pipeline{\n212|\t\trequest:        request,\n213|\t\tlog:            &CaptureLog{},\n214|\t\tguard:          guard,\n215|\t\troot:           root,\n216|\t\tplan:           plan,\n217|\t\tplanKeys:       keys,\n218|\t\tlimit:          limit,\n219|\t\tworkspaceBytes: workspaceBytes,\n220|\t}, nil\n221|}\n222|\n223|func (state *pipeline) close() {\n224|\tif state.root != nil {\n225|\t\t_ = state.root.Close()\n226|\t\tstate.root = nil\n227|\t}\n228|}\n229|\n230|// walkAndMeasure enumerates the store, reconciles every member\n231|// against the plan, opens and installs every included-class member\n232|// through the Guard, and records the pre source digest. Excluded\n233|// members are never opened. It then runs the AfterWalk hook and\n234|// re-measures the post source digest. Any measurement failure\n235|// refuses; mutation itself is decided by gateSourceRace.\n236|func (state *pipeline) walkAndMeasure() error {\n237|\tobserved, err := enumerateStore(state.request.StoreRoot)\n238|\tif err != nil {\n239|\t\treturn err\n240|\t}\n241|\tbyKey := make(map[string]observedMember, len(observed))\n242|\tfor _, member := range observed {\n243|\t\tbyKey[member.key] = member\n244|\t\tif member.kind == memberDir {\n245|\t\t\tcontinue\n246|\t\t}\n247|\t\tif member.kind == memberOther && intermediatePrefix(state.plan, member.key) {\n248|\t\t\tcontinue\n249|\t\t}\n250|\t\tif _, err := planMemberClass(state.plan, member.key); err != nil {\n251|\t\t\treturn err\n252|\t\t}\n253|\t}\n254|\t// Early containment refusal: every included-class special\n255|\t// member (symlink, FIFO, device, socket) reaches the Guard,\n256|\t// which refuses it before any payload byte is read. The plan\n257|\t// loop would refuse it again; this pass fails fast with nothing\n258|\t// installed. Intermediates belong to their planned member's\n259|\t// open, which names the full member.\n260|\tfor _, member := range observed {\n261|\t\tif member.kind != memberOther {\n262|\t\t\tcontinue\n263|\t\t}\n264|\t\tif intermediatePrefix(state.plan, member.key) {\n265|\t\t\tcontinue\n266|\t\t}\n267|\t\tif excludedClass(state.plan[member.key].Class) {\n268|\t\t\tcontinue\n269|\t\t}\n270|\t\tif _, err := openMember(state.guard, state.root, member.key, state.limit); err != nil {\n271|\t\t\treturn err\n272|\t\t}\n273|\t}\n274|\tfor _, key := range state.planKeys {\n275|\t\titem := state.plan[key]\n276|\t\tif excludedClass(item.Class) {\n277|\t\t\tstate.log.Linef(\"exclude member=%q class=%s reason=%s\", key, item.Class, exclusionReason(item.Class))\n278|\t\t\tcontinue\n279|\t\t}\n280|\t\t_, present := byKey[key]\n281|\t\tif !present && !item.Required && !blockedAncestor(byKey, key) {\n282|\t\t\tstate.log.Linef(\"exclude member=%q class=%s reason=plan_optional_absent\", key, item.Class)\n283|\t\t\tcontinue\n284|\t\t}\n285|\t\tif !present && item.Required && !blockedAncestor(byKey, key) {\n286|\t\t\treturn invalid(\"capture plan candidate %q is required but absent from the store\", key)\n287|\t\t}\n288|\t\t// Every planned included member — file, directory, or\n289|\t\t// special shape — opens through the Guard, which admits\n290|\t\t// regular files and refuses the rest with the member named.\n291|\t\tpayload, err := openMember(state.guard, state.root, key, state.limit)\n292|\t\tif err != nil {\n293|\t\t\treturn err\n294|\t\t}\n295|\t\tdescriptor, err := BuildBlobDescriptor(payload)\n296|\t\tif err != nil {\n297|\t\t\treturn invalid(\"capture member %q: %v\", key, err)\n298|\t\t}\n299|\t\tif _, err := clonebundle.InstallRawBlob(state.request.Store, descriptor.Descriptor, bytes.NewReader(payload)); err != nil {\n300|\t\t\treturn invalid(\"capture member %q: %v\", key, err)\n301|\t\t}\n302|\t\tstate.log.Linef(\"capture member=%q class=%s digest=%s size=%d media=%s\", key, item.Class, descriptor.BlobID.String(), descriptor.Size, blobMediaType)\n303|\t\tstate.captured = append(state.captured, capturedMember{key: key, class: item.Class, payload: payload, descriptor: descriptor})\n304|\t}\n305|\tstate.pre, state.preLines = state.recordSource(observed, true)\n306|\tif state.request.Hooks.AfterWalk != nil {\n307|\t\tif err := state.request.Hooks.AfterWalk(state.request.StoreRoot); err != nil {\n308|\t\t\treturn invalid(\"capture hook refused after the walk: %v\", err)\n309|\t\t}\n310|\t}\n311|\treturn state.measurePost()\n312|}\n313|\n314|// recordSource builds the canonical source record over one\n315|// enumeration: directories contribute keys, specials contribute\n316|// keys, excluded files contribute key and size, and included files\n317|// contribute key, size, and content hash. Production always captured\n318|// every included file it enumerates; the unknown-content fallback\n319|// runs only when a mutant admits an unplanned member past the plan\n320|// gate, and then the post measurement still disagrees.\n321|func (state *pipeline) recordSource(observed []observedMember, useCaptured bool) (scalar.Digest, []string) {\n322|\thashByKey := make(map[string]capturedMember, len(state.captured))\n323|\tif useCaptured {\n324|\t\tfor _, member := range state.captured {\n325|\t\t\thashByKey[member.key] = member\n326|\t\t}\n327|\t}\n328|\trecord := &sourceRecord{}\n329|\tfor _, member := range observed {\n330|\t\tswitch member.kind {\n331|\t\tcase memberDir:\n332|\t\t\trecord.addDir(member.key)\n333|\t\tcase memberOther:\n334|\t\t\trecord.addOther(member.key)\n335|\t\tcase memberFile:\n336|\t\t\tclass := state.plan[member.key].Class\n337|\t\t\tif !useCaptured {\n338|\t\t\t\tif resolved, err := planMemberClass(state.plan, member.key); err == nil {\n339|\t\t\t\t\tclass = resolved\n340|\t\t\t\t} else {\n341|\t\t\t\t\tclass = \"\"\n342|\t\t\t\t}\n343|\t\t\t}\n344|\t\t\tif class == \"\" || excludedClass(class) {\n345|\t\t\t\trecord.addFile(member.key, member.size, \"-\")\n346|\t\t\t\tcontinue\n347|\t\t\t}\n348|\t\t\tif captured, ok := hashByKey[member.key]; useCaptured && ok {\n349|\t\t\t\trecord.addFile(member.key, captured.descriptor.Size, contentHash(captured.payload))\n350|\t\t\t\tcontinue\n351|\t\t\t}\n352|\t\t\tif !useCaptured {\n353|\t\t\t\tif payload, err := openMember(state.guard, state.root, member.key, state.limit); err == nil {\n354|\t\t\t\t\trecord.addFile(member.key, uint64(len(payload)), contentHash(payload))\n355|\t\t\t\t\tcontinue\n356|\t\t\t\t}\n357|\t\t\t}\n358|\t\t\trecord.addFile(member.key, member.size, \"-\")\n359|\t\t}\n360|\t}\n361|\treturn record.digest(), append([]string(nil), record.lines...)\n362|}\n363|\n364|// measurePost re-enumerates the store and re-reads every included\n365|// member through the Guard, recording the post source digest. A\n366|// member that cannot be re-read — appended, removed, retyped, or\n367|// unreadable — joins the record with unknown content, so the digest\n368|// comparison, not the read error, decides the race, and the refusal\n369|// names the member.\n370|func (state *pipeline) measurePost() error {\n371|\tobserved, err := enumerateStore(state.request.StoreRoot)\n372|\tif err != nil {\n373|\t\treturn err\n374|\t}\n375|\tstate.post, state.postLines = state.recordSource(observed, false)\n376|\treturn nil\n377|}\n378|\n379|// gateSourceRace decides the measured source race: equal pre and\n380|// post digests proceed; a difference refuses, or marks archive-only\n381|// output when archival was explicitly acknowledged and requested.\n382|// Size equality never decides: the comparison is digest equality\n383|// over content hashes.\n384|func (state *pipeline) gateSourceRace() error {\n385|\tif err := checkSourceRace(state.pre, state.post, state.preLines, state.postLines); err != nil {\n386|\t\treturn err\n387|\t}\n388|\treturn nil\n389|}\n390|\n391|// raceOutcome maps a detected race onto the requested policy: refuse\n392|// aborts with no sealed manifest; archive seals the core-created\n393|// unstable_archive form for archive-only output — never for a\n394|// target branch — and only with explicit operator acknowledgement.\n395|func (state *pipeline) raceOutcome(race error) (*CaptureResult, error) {\n396|\tif state.request.OnRace != RaceArchive {\n397|\t\treturn nil, race\n398|\t}\n399|\tif !state.request.OperatorExplicit {\n400|\t\treturn nil, invalid(\"capture archive requires explicit operator acknowledgement for source_not_quiescent\")\n401|\t}\n402|\treturn state.sealAndPublish(true)\n403|}\n404|\n405|// sealAndPublish seals both manifests through the landed builders,\n406|// re-decodes each before publishing, publishes in raw-then-capture\n407|// order through the object store, and returns the capture result.\n408|// The stable proof carries the gate-verified pre digest for both\n409|// capture digests: gateSourceRace proved the measured post equal\n410|// before this seal ran, so the sealed bytes are identical to sealing\n411|// the measurement. Sealing the raw post measurement instead would\n412|// fail closed under a reorder (the landed builder refuses unequal\n413|// digests) and leave the race-before-seal ordering unpinned; the\n414|// N-race-order mutants prove the gate precedes this seal.\n415|func (state *pipeline) sealAndPublish(unstable bool) (*CaptureResult, error) {\n416|\trequest := state.request\n417|\tentries := make([]clonebundle.EntryInput, 0, len(state.captured))\n418|\tincluded := make([]string, 0, len(state.captured))\n419|\tfor _, member := range state.captured {\n420|\t\tentries = append(entries, clonebundle.EntryInput{\n421|\t\t\tNativeItemKey: member.key,\n422|\t\t\tClass:         member.class,\n423|\t\t\tByteCount:     member.descriptor.Size,\n424|\t\t\tBlobID:        member.descriptor.BlobID.String(),\n425|\t\t\tDescriptorID:  member.descriptor.DescriptorID.String(),\n426|\t\t\tDescriptor:    member.descriptor.Descriptor,\n427|\t\t})\n428|\t\tincluded = append(included, member.key)\n429|\t}\n430|\tidentityDigest, err := clonebundle.IdentityDigest(request.SourceIdentity, nil)\n431|\tif err != nil {\n432|\t\treturn nil, err\n433|\t}\n434|\trawBytes, err := clonebundle.BuildRawObjectManifest(\n435|\t\trequest.OperationID,\n436|\t\trequest.SourceEnvironment,\n437|\t\trequest.NativeSessionID,\n438|\t\tidentityDigest.String(),\n439|\t\trequest.CapturePlanDigest,\n440|\t\tentries,\n441|\t\tnil,\n442|\t)\n443|\tif err != nil {\n444|\t\treturn nil, err\n445|\t}\n446|\traw, err := clonebundle.DecodeRawObjectManifest(rawBytes)\n447|\tif err != nil {\n448|\t\treturn nil, invalid(\"sealed raw object manifest refused: %v\", err)\n449|\t}\n450|\t// Manifests publish under their content digest: the manifest ID\n451|\t// is the omit-self identity, not the digest of the sealed bytes.\n452|\trawPut, err := request.Store.PutBlob(scalar.SHA256Digest(rawBytes), uint64(len(rawBytes)), bytes.NewReader(rawBytes))\n453|\tif err != nil {\n454|\t\treturn nil, invalid(\"capture cannot publish the raw object manifest: %v\", err)\n455|\t}\n456|\tif request.Hooks.AfterRawPublish != nil {\n457|\t\tif err := request.Hooks.AfterRawPublish(); err != nil {\n458|\t\t\treturn nil, invalid(\"capture hook refused after the raw publish: %v\", err)\n459|\t\t}\n460|\t}\n461|\tboundary := clonebundle.BoundaryInput{\n462|\t\tKind:              \"stable\",\n463|\t\tProofKind:         request.ProofKind,\n464|\t\tGeneration:        request.Generation,\n465|\t\tPreCaptureDigest:  state.pre.String(),\n466|\t\tPostCaptureDigest: state.pre.String(),\n467|\t\tInputBlocked:      request.InputBlocked,\n468|\t\tForegroundIdle:    request.ForegroundIdle,\n469|\t\tBackgroundIdle:    request.BackgroundIdle,\n470|\t}\n471|\tif request.SnapshotIdentity != nil {\n472|\t\tidentity := *request.SnapshotIdentity\n473|\t\tboundary.SnapshotIdentity = &identity\n474|\t}\n475|\tif unstable {\n476|\t\tboundary = clonebundle.BoundaryInput{\n477|\t\t\tKind:              \"unstable_archive\",\n478|\t\t\tGeneration:        request.Generation,\n479|\t\t\tPreCaptureDigest:  state.pre.String(),\n480|\t\t\tPostCaptureDigest: state.post.String(),\n481|\t\t\tCore:              true,\n482|\t\t}\n483|\t}\n484|\titems := make([]clonebundle.CaptureItemInput, 0, len(state.planKeys))\n485|\tcapturedByKey := make(map[string]capturedMember, len(state.captured))\n486|\tfor _, member := range state.captured {\n487|\t\tcapturedByKey[member.key] = member\n488|\t}\n489|\tfor _, key := range state.planKeys {\n490|\t\titem := state.plan[key]\n491|\t\tif member, ok := capturedByKey[key]; ok {\n492|\t\t\tdescriptor := member.descriptor.DescriptorID.String()\n493|\t\t\tcount := member.descriptor.Size\n494|\t\t\titems = append(items, clonebundle.CaptureItemInput{\n495|\t\t\t\tNativeItemKey:    key,\n496|\t\t\t\tClass:            item.Class,\n497|\t\t\t\tDisposition:      \"included\",\n498|\t\t\t\tBlobDescriptorID: &descriptor,\n499|\t\t\t\tByteCount:        &count,\n500|\t\t\t})\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c70d","stream":{"kind":"session","id":"01a0b27e-c8a1-7be1-9b43-e0047ff1ed44"},"sequence":481,"recorded_at":1780531400000957,"record_type":"event","durability":"durable","causation_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","run_stream":{"kind":"run","id":"42a50646-ac4c-4d20-af82-db3f2b0269ba"},"call_id":"call_01a0b27fdcfd73aa98f964ab080de5e3","text":"Read text file `internal/clonesnap/project.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/localstore\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|)\n12|\n13|// This file owns target-branch admission and the projection output\n14|// whose existence pins the race-before-projection ordering.\n15|// CaptureAndProject runs the capture pipeline, then admits the\n16|// sealed capture manifest: the unstable_archive form can never enter\n17|// a target branch (the landed G2 gate decides), and the maximal_safe\n18|// fidelity profile requires a reconciled complete manifest (the\n19|// landed maximal-safe gate decides). Admission emits one admission\n20|// receipt into the target sink. Projection planning past admission\n21|// is the final leaf's scope; this receipt exists to prove admission\n22|// and ordering, not to plan a projection.\n23|\n24|// FidelityProfile is one Section 7.8 fidelity profile:\n25|// strict_exact|maximal_safe|compact|messages_only.\n26|type FidelityProfile string\n27|\n28|const (\n29|\t// FidelityStrictExact requests exact projection.\n30|\tFidelityStrictExact FidelityProfile = \"strict_exact\"\n31|\t// FidelityMaximalSafe requests maximal safe projection: it\n32|\t// requires a reconciled complete manifest with no unknown class.\n33|\tFidelityMaximalSafe FidelityProfile = \"maximal_safe\"\n34|\t// FidelityCompact requests compact projection.\n35|\tFidelityCompact FidelityProfile = \"compact\"\n36|\t// FidelityMessagesOnly requests messages-only projection.\n37|\tFidelityMessagesOnly FidelityProfile = \"messages_only\"\n38|)\n39|\n40|// validFidelityProfile reports whether the profile is in the Section\n41|// 7.8 closed vocabulary.\n42|func validFidelityProfile(profile string) bool {\n43|\tswitch FidelityProfile(profile) {\n44|\tcase FidelityStrictExact, FidelityMaximalSafe, FidelityCompact, FidelityMessagesOnly:\n45|\t\treturn true\n46|\tdefault:\n47|\t\treturn false\n48|\t}\n49|}\n50|\n51|// ProjectRequest is one capture-and-project candidate: the capture\n52|// request, the target sink that receives the admission receipt, and\n53|// the fidelity profile admission decides.\n54|type ProjectRequest struct {\n55|\tCapture CaptureRequest\n56|\t// TargetSink receives the admission receipt. It stays empty\n57|\t// when capture refuses, races, or seals archive-only output.\n58|\tTargetSink *localstore.ObjectStore\n59|\t// FidelityProfile is the requested Section 7.8 profile.\n60|\tFidelityProfile string\n61|}\n62|\n63|// ProjectResult is one admitted capture: the capture result plus the\n64|// sealed admission receipt.\n65|type ProjectResult struct {\n66|\tCapture *CaptureResult\n67|\t// Receipt carries the sealed admission receipt bytes.\n68|\tReceipt []byte\n69|\t// ReceiptDigest is the blob identity of the receipt.\n70|\tReceiptDigest scalar.Digest\n71|\t// ReceiptInstalled reports whether this run installed the\n72|\t// receipt blob (a replay verifies and reuses).\n73|\tReceiptInstalled bool\n74|}\n75|\n76|// CaptureAndProject runs capture, then admits the sealed capture to\n77|// a target branch and emits the admission receipt. The race gate\n78|// precedes admission and emission (see ORDER-PIN below): a mutated\n79|// source refuses, or seals archive-only output that admission\n80|// rejects — no projection output is produced before the race is\n81|// decided.\n82|func CaptureAndProject(request ProjectRequest) (*ProjectResult, error) {\n83|\tif request.TargetSink == nil {\n84|\t\treturn nil, invalid(\"capture projection requires a target sink\")\n85|\t}\n86|\tstate, err := newPipeline(request.Capture)\n87|\tif err != nil {\n88|\t\treturn nil, err\n89|\t}\n90|\tdefer state.close()\n91|\tif err := state.walkAndMeasure(); err != nil {\n92|\t\treturn nil, err\n93|\t}\n94|\t// ORDER-PIN: the source-race gate precedes any seal, admission,\n95|\t// or projection output. N-race-order-project moves this gate\n96|\t// after admitAndEmit and the killer reddens on the emitted\n97|\t// receipt.\n98|\tif err := state.gateSourceRace(); err != nil {\n99|\t\tcaptured, raceErr := state.raceOutcome(err)\n100|\t\tif raceErr != nil {\n101|\t\t\treturn nil, raceErr\n102|\t\t}\n103|\t\t// Archive-only output never enters a target branch: the\n104|\t\t// admission gate below refuses it, so no receipt exists.\n105|\t\tif _, err := AdmitForTarget(captured.CaptureManifest, request.FidelityProfile); err != nil {\n106|\t\t\treturn nil, err\n107|\t\t}\n108|\t\treturn nil, invalid(\"capture archive unexpectedly admitted to a target branch\")\n109|\t}\n110|\tsealed, err := state.sealAndPublish(false)\n111|\tif err != nil {\n112|\t\treturn nil, err\n113|\t}\n114|\treturn state.admitAndEmit(request, sealed)\n115|}\n116|\n117|// admitAndEmit admits one sealed capture to the target branch and\n118|// emits its admission receipt into the target sink.\n119|func (state *pipeline) admitAndEmit(request ProjectRequest, sealed *CaptureResult) (*ProjectResult, error) {\n120|\tif _, err := AdmitForTarget(sealed.CaptureManifest, request.FidelityProfile); err != nil {\n121|\t\treturn nil, err\n122|\t}\n123|\treceipt, err := BuildAdmissionReceipt(sealed.Raw.ManifestID, sealed.Capture.ManifestID, request.FidelityProfile)\n124|\tif err != nil {\n125|\t\treturn nil, err\n126|\t}\n127|\tdigest := scalar.SHA256Digest(receipt)\n128|\tput, err := request.TargetSink.PutBlob(digest, uint64(len(receipt)), bytes.NewReader(receipt))\n129|\tif err != nil {\n130|\t\treturn nil, invalid(\"capture projection cannot publish the admission receipt: %v\", err)\n131|\t}\n132|\treturn &ProjectResult{\n133|\t\tCapture:          sealed,\n134|\t\tReceipt:          receipt,\n135|\t\tReceiptDigest:    digest,\n136|\t\tReceiptInstalled: put.Installed,\n137|\t}, nil\n138|}\n139|\n140|// AdmitForTarget admits one sealed capture manifest to a target\n141|// branch under the requested fidelity profile. The unstable_archive\n142|// form is archive-only output and always refuses; an unknown\n143|// fidelity profile refuses; maximal_safe requires a reconciled\n144|// complete manifest with no unknown class.\n145|func AdmitForTarget(captureManifest []byte, profile string) (clonebundle.CaptureManifest, error) {\n146|\tmanifest, err := clonebundle.DecodeCaptureManifest(captureManifest)\n147|\tif err != nil {\n148|\t\treturn clonebundle.CaptureManifest{}, err\n149|\t}\n150|\tif err := clonebundle.RefuseUnstableForTarget(manifest.CaptureBoundary); err != nil {\n151|\t\treturn clonebundle.CaptureManifest{}, err\n152|\t}\n153|\tif !validFidelityProfile(profile) {\n154|\t\treturn clonebundle.CaptureManifest{}, invalid(\"capture fidelity profile %q is outside strict_exact|maximal_safe|compact|messages_only\", profile)\n155|\t}\n156|\tif profile == \"maximal_safe\" {\n157|\t\tif err := clonebundle.RefuseMaximalSafeUnlessComplete(manifest); err != nil {\n158|\t\t\treturn clonebundle.CaptureManifest{}, err\n159|\t\t}\n160|\t}\n161|\treturn manifest, nil\n162|}\n163|\n164|// admissionReceiptSchema pins the admission receipt envelope\n165|// identity.\n166|const admissionReceiptSchema = \"urn:ax:internal:clonesnap-admission-receipt\"\n167|\n168|// BuildAdmissionReceipt seals one target admission receipt: the\n169|// admitted raw and capture manifest identities, the stable boundary\n170|// kind, and the fidelity profile. Only stable captures reach it;\n171|// AdmitForTarget refused everything else before this seal ran.\n172|func BuildAdmissionReceipt(rawManifestID, captureManifestID scalar.Digest, profile string) ([]byte, error) {\n173|\tif !validFidelityProfile(profile) {\n174|\t\treturn nil, invalid(\"capture fidelity profile %q is outside strict_exact|maximal_safe|compact|messages_only\", profile)\n175|\t}\n176|\tobject := map[string]any{\n177|\t\t\"schema\":                 admissionReceiptSchema,\n178|\t\t\"schema_version\":         \"1.0.0\",\n179|\t\t\"raw_object_manifest_id\": rawManifestID.String(),\n180|\t\t\"capture_manifest_id\":    captureManifestID.String(),\n181|\t\t\"boundary_kind\":          \"stable\",\n182|\t\t\"fidelity_profile\":       profile,\n183|\t\t\"extensions\":             map[string]any{},\n184|\t}\n185|\tplain, err := json.Marshal(object)\n186|\tif err != nil {\n187|\t\treturn nil, invalid(\"serialize admission receipt: %v\", err)\n188|\t}\n189|\tsealed, err := canonicaljson.Canonicalize(plain)\n190|\tif err != nil {\n191|\t\treturn nil, invalid(\"canonicalize admission receipt: %v\", err)\n192|\t}\n193|\treturn sealed, nil\n194|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c70f","stream":{"kind":"session","id":"01a0b27e-c8a1-7be1-9b43-e0047ff1ed44"},"sequence":482,"recorded_at":1780531400000959,"record_type":"event","durability":"durable","causation_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","run_stream":{"kind":"run","id":"42a50646-ac4c-4d20-af82-db3f2b0269ba"},"call_id":"call_01a0b27fdf107586b27fe3a9a80ed075","text":"Read text file `internal/clonesnap/race.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"fmt\"\n7|\t\"sort\"\n8|\t\"strconv\"\n9|\t\"strings\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|)\n14|\n15|// This file owns the source-race record: the canonical digest over\n16|// every enumerated store member that the pre and post capture\n17|// measurements compare. Included-class members contribute their key,\n18|// size, and content hash; excluded-class members contribute key and\n19|// size only, because their bytes are never opened; directories\n20|// contribute their keys, so an appended record is a detected\n21|// mutation. Size equality is never proof: the comparison is digest\n22|// equality over content hashes through the landed CheckDigestsEqual.\n23|\n24|// sourceRecord is one canonical source listing: sorted unique lines,\n25|// one per enumerated member.\n26|type sourceRecord struct {\n27|\tlines []string\n28|}\n29|\n30|func recordFileLine(key string, size uint64, content string) string {\n31|\treturn key + \"\\x00\" + string(memberFile) + \"\\x00\" + strconv.FormatUint(size, 10) + \"\\x00\" + content\n32|}\n33|\n34|func recordDirLine(key string) string {\n35|\treturn key + \"\\x00\" + string(memberDir) + \"\\x00\" + \"0\" + \"\\x00\" + \"-\"\n36|}\n37|\n38|func recordOtherLine(key string) string {\n39|\treturn key + \"\\x00\" + string(memberOther) + \"\\x00\" + \"0\" + \"\\x00\" + \"-\"\n40|}\n41|\n42|// addFile records one regular member: content is the hex content\n43|// hash for included members and \"-\" for excluded members, whose\n44|// bytes are never read.\n45|func (record *sourceRecord) addFile(key string, size uint64, content string) {\n46|\trecord.lines = append(record.lines, recordFileLine(key, size, content))\n47|}\n48|\n49|func (record *sourceRecord) addDir(key string) {\n50|\trecord.lines = append(record.lines, recordDirLine(key))\n51|}\n52|\n53|func (record *sourceRecord) addOther(key string) {\n54|\trecord.lines = append(record.lines, recordOtherLine(key))\n55|}\n56|\n57|// digest seals the record: the lines sort and join deterministically,\n58|// so identical sources seal identical digests.\n59|func (record *sourceRecord) digest() scalar.Digest {\n60|\tlines := append([]string(nil), record.lines...)\n61|\tsort.Strings(lines)\n62|\tsum := sha256.Sum256([]byte(strings.Join(lines, \"\\n\")))\n63|\tdigest, err := scalar.ParseDigest(\"sha256:\" + hex.EncodeToString(sum[:]))\n64|\tif err != nil {\n65|\t\tpanic(fmt.Sprintf(\"clonesnap: source record digest is not a digest: %v\", err))\n66|\t}\n67|\treturn digest\n68|}\n69|\n70|// contentHash is the hex content hash one record line carries for an\n71|// included member.\n72|func contentHash(payload []byte) string {\n73|\tsum := sha256.Sum256(payload)\n74|\treturn hex.EncodeToString(sum[:])\n75|}\n76|\n77|// checkSourceRace compares the pre and post source digests through\n78|// the landed equality gate. Equal sizes with differing bytes refuse:\n79|// the gate compares content digests, never sizes. The refusal names\n80|// the first differing member alongside the two digests; it never\n81|// carries source bytes.\n82|func checkSourceRace(pre, post scalar.Digest, preLines, postLines []string) error {\n83|\tif err := clonebundle.CheckDigestsEqual(pre, post); err != nil {\n84|\t\treturn invalid(\"source mutated during capture: member %q changed: %v\", firstChangedMember(preLines, postLines), err)\n85|\t}\n86|\treturn nil\n87|}\n88|\n89|// firstChangedMember names one member whose record line differs\n90|// between the pre and post listings: an appended, removed, resized,\n91|// retyped, or content-changed member. The listings compared equal as\n92|// sets only when the digests agree, so a mismatch always names a\n93|// member; the fallback names the record, never nothing.\n94|func firstChangedMember(preLines, postLines []string) string {\n95|\tpre := make(map[string]bool, len(preLines))\n96|\tfor _, line := range preLines {\n97|\t\tpre[line] = true\n98|\t}\n99|\tpost := make(map[string]bool, len(postLines))\n100|\tfor _, line := range postLines {\n101|\t\tpost[line] = true\n102|\t}\n103|\tfor _, line := range postLines {\n104|\t\tif !pre[line] {\n105|\t\t\tif key, _, found := strings.Cut(line, \"\\x00\"); found {\n106|\t\t\t\treturn key\n107|\t\t\t}\n108|\t\t\treturn \"source record\"\n109|\t\t}\n110|\t}\n111|\tfor _, line := range preLines {\n112|\t\tif !post[line] {\n113|\t\t\tif key, _, found := strings.Cut(line, \"\\x00\"); found {\n114|\t\t\t\treturn key\n115|\t\t\t}\n116|\t\t\treturn \"source record\"\n117|\t\t}\n118|\t}\n119|\treturn \"source record\"\n120|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c711","stream":{"kind":"session","id":"01a0b27e-c8a1-7be1-9b43-e0047ff1ed44"},"sequence":483,"recorded_at":1780531400000961,"record_type":"event","durability":"durable","causation_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","run_stream":{"kind":"run","id":"42a50646-ac4c-4d20-af82-db3f2b0269ba"},"call_id":"call_01a0b27fe0a874eba629e64c72b83940","text":"Read text file `internal/clonesnap/walk.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"io\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"sort\"\n8|\t\"strings\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n13|)\n14|\n15|// This file owns the contained capture walk over a provider store\n16|// directory. Enumeration observes names only: every payload open\n17|// descends from the verified store-root handle through the landed\n18|// secprim Guard, so a symlinked intermediate component or a trailing\n19|// symlink refuses before any payload byte is read, and a FIFO,\n20|// directory, device, or socket refuses on its opened shape. Every\n21|// refusal names the member. The walk never escapes the store root:\n22|// nothing enumerated is opened except through the Guard on a\n23|// validated member name.\n24|//\n25|// The walk reads every included-class member twice — once for the\n26|// capture bytes and the pre digest, once for the post digest — and\n27|// enumerates the store twice. Any difference is a detected source\n28|// race, decided before any manifest is sealed. Excluded-class\n29|// members are never opened: their bytes cannot reach a blob, a\n30|// manifest, a log line, or an error string, because no read ever\n31|// observes them.\n32|\n33|// PlanItem is one capture-plan candidate: the native key the walk\n34|// must reconcile and the closed class that decides its disposition.\n35|// Required candidates must be present when their class is included;\n36|// optional included-class candidates absent from the store seal as\n37|// excluded rows instead of refusing.\n38|type PlanItem struct {\n39|\tNativeKey string\n40|\tClass     string\n41|\tRequired  bool\n42|}\n43|\n44|// memberKind is the observed shape of one enumerated store member.\n45|type memberKind string\n46|\n47|const (\n48|\tmemberFile  memberKind = \"file\"\n49|\tmemberDir   memberKind = \"dir\"\n50|\tmemberOther memberKind = \"other\"\n51|)\n52|\n53|// observedMember is one enumerated store member: its slash-separated\n54|// key beneath the store root, its observed shape, and its observed\n55|// size. Observation never opens a payload.\n56|type observedMember struct {\n57|\tkey  string\n58|\tkind memberKind\n59|\tsize uint64\n60|}\n61|\n62|// capturedMember is one walked included-class member: the bytes read\n63|// through the Guard and their sealed descriptor.\n64|type capturedMember struct {\n65|\tkey        string\n66|\tclass      string\n67|\tpayload    []byte\n68|\tdescriptor BlobDescriptor\n69|}\n70|\n71|// enumerateStore lists every store member beneath root as\n72|// slash-separated keys. It observes names, shapes, and sizes only;\n73|// it opens no payload. A failed observation is a refusal, never an\n74|// absence: a member that cannot be listed cannot be captured.\n75|func enumerateStore(root string) ([]observedMember, error) {\n76|\tvar members []observedMember\n77|\tvar descend func(relative string) error\n78|\tdescend = func(relative string) error {\n79|\t\tdirectory := root\n80|\t\tif relative != \"\" {\n81|\t\t\tdirectory = filepath.Join(root, filepath.FromSlash(relative))\n82|\t\t}\n83|\t\tentries, err := os.ReadDir(directory)\n84|\t\tif err != nil {\n85|\t\t\treturn invalid(\"capture cannot enumerate store member %q: %v\", relative, err)\n86|\t\t}\n87|\t\tfor _, entry := range entries {\n88|\t\t\tname := entry.Name()\n89|\t\t\tif name == \"\" || name == \".\" || name == \"..\" || strings.Contains(name, \"/\") || strings.Contains(name, `\\`) {\n90|\t\t\t\treturn invalid(\"capture store member %q is not a plain file name\", name)\n91|\t\t\t}\n92|\t\t\tkey := name\n93|\t\t\tif relative != \"\" {\n94|\t\t\t\tkey = relative + \"/\" + name\n95|\t\t\t}\n96|\t\t\tinfo, err := os.Lstat(filepath.Join(root, filepath.FromSlash(key)))\n97|\t\t\tif err != nil {\n98|\t\t\t\treturn invalid(\"capture cannot stat store member %q: %v\", key, err)\n99|\t\t\t}\n100|\t\t\tmode := info.Mode()\n101|\t\t\tswitch {\n102|\t\t\tcase mode.IsRegular():\n103|\t\t\t\tif info.Size() < 0 {\n104|\t\t\t\t\treturn invalid(\"capture store member %q has a negative size\", key)\n105|\t\t\t\t}\n106|\t\t\t\tmembers = append(members, observedMember{key: key, kind: memberFile, size: uint64(info.Size())})\n107|\t\t\tcase mode.IsDir():\n108|\t\t\t\tmembers = append(members, observedMember{key: key, kind: memberDir})\n109|\t\t\t\tif err := descend(key); err != nil {\n110|\t\t\t\t\treturn err\n111|\t\t\t\t}\n112|\t\t\tdefault:\n113|\t\t\t\tmembers = append(members, observedMember{key: key, kind: memberOther})\n114|\t\t\t}\n115|\t\t}\n116|\t\treturn nil\n117|\t}\n118|\tif err := descend(\"\"); err != nil {\n119|\t\treturn nil, err\n120|\t}\n121|\tsort.Slice(members, func(left, right int) bool { return members[left].key < members[right].key })\n122|\treturn members, nil\n123|}\n124|\n125|// checkPlan validates the whole capture plan before anything is\n126|// opened or installed: every key is sanitized, every class is in the\n127|// closed nine-class vocabulary, keys are sorted unique, and every\n128|// member name passes the containment grammar. A plan this gate\n129|// refuses leaves the store and the object sink untouched.\n130|func checkPlan(platform scalar.Platform, plan []PlanItem) (map[string]PlanItem, error) {\n131|\tbyKey := make(map[string]PlanItem, len(plan))\n132|\tprevious := \"\"\n133|\tfor index, item := range plan {\n134|\t\tif index > 0 && item.NativeKey <= previous {\n135|\t\t\treturn nil, invalid(\"capture plan keys are not sorted unique by native item key\")\n136|\t\t}\n137|\t\tprevious = item.NativeKey\n138|\t\tif err := clonebundle.SanitizeNativeKey(item.NativeKey); err != nil {\n139|\t\t\treturn nil, invalid(\"capture plan key %q: %v\", item.NativeKey, err)\n140|\t\t}\n141|\t\tif err := secprim.CheckMemberPath(platform, item.NativeKey); err != nil {\n142|\t\t\treturn nil, invalid(\"capture plan key %q escapes the store root: %v\", item.NativeKey, err)\n143|\t\t}\n144|\t\tif !clonebundle.ValidCaptureClass(item.Class) {\n145|\t\t\treturn nil, invalid(\"capture plan key %q carries class %q outside the nine-class vocabulary\", item.NativeKey, item.Class)\n146|\t\t}\n147|\t\tbyKey[item.NativeKey] = item\n148|\t}\n149|\treturn byKey, nil\n150|}\n151|\n152|// excludedClass reports whether the class is always excluded:\n153|// credential, machine-auth, runtime-state, and transient-lock rows\n154|// are never included and their bytes are never opened.\n155|func excludedClass(class string) bool {\n156|\tswitch class {\n157|\tcase \"credential\", \"machine_auth\", \"runtime_state\", \"transient_lock\":\n158|\t\treturn true\n159|\tdefault:\n160|\t\treturn false\n161|\t}\n162|}\n163|\n164|// exclusionReason is the stable exclusion reason sealed for an\n165|// always-excluded class.\n166|func exclusionReason(class string) string {\n167|\treturn class + \"_excluded\"\n168|}\n169|\n170|// openMember opens one planned member through the store Guard and\n171|// returns its bytes. The Guard refuses symlink escapes before any\n172|// payload byte is read and refuses non-regular shapes on the opened\n173|// descriptor; this wrapper names the member on every failure. The\n174|// limit refuses oversized members with capability_unavailable before\n175|// their bytes are read, so no manifest is ever published over a\n176|// member this package cannot carry.\n177|func openMember(guard secprim.Guard, root *os.File, member string, limit uint64) ([]byte, error) {\n178|\tfile, err := guard.Open(root, member)\n179|\tif err != nil {\n180|\t\treturn nil, invalid(\"capture member %q: %v\", member, err)\n181|\t}\n182|\tdefer func() { _ = file.Close() }()\n183|\tinfo, err := file.Stat()\n184|\tif err != nil {\n185|\t\treturn nil, invalid(\"capture member %q cannot be stated: %v\", member, err)\n186|\t}\n187|\tif info.Size() < 0 {\n188|\t\treturn nil, invalid(\"capture member %q has a negative size\", member)\n189|\t}\n190|\tif uint64(info.Size()) > limit {\n191|\t\treturn nil, invalid(\"capture member %q of %d bytes exceeds the %d byte bound: capability_unavailable\", member, info.Size(), limit)\n192|\t}\n193|\tpayload, err := io.ReadAll(io.LimitReader(file, int64(limit)+1))\n194|\tif err != nil {\n195|\t\treturn nil, invalid(\"capture member %q cannot be read: %v\", member, err)\n196|\t}\n197|\tif uint64(len(payload)) != uint64(info.Size()) {\n198|\t\treturn nil, invalid(\"capture member %q changed size during its read: source_not_quiescent\", member)\n199|\t}\n200|\treturn payload, nil\n201|}\n202|\n203|// planMemberClass resolves the planned class for one enumerated key.\n204|// The lookup is exact: a key that merely shares a prefix with a\n205|// planned key is unplanned, and an unplanned store member refuses\n206|// capture before any manifest is sealed, because silently dropping\n207|// source bytes would forge completeness.\n208|func planMemberClass(plan map[string]PlanItem, key string) (string, error) {\n209|\titem, planned := plan[key]\n210|\tif !planned {\n211|\t\treturn \"\", invalid(\"capture store member %q is not a plan candidate\", key)\n212|\t}\n213|\treturn item.Class, nil\n214|}\n215|\n216|// intermediatePrefix reports whether the observed other stands on\n217|// the path of a planned key: a symlink or special that a nested\n218|// member traverses. Its refusal belongs to the planned member's\n219|// Guard open — which names the full member — not to the plan gate.\n220|func intermediatePrefix(plan map[string]PlanItem, key string) bool {\n221|\tprefix := key + \"/\"\n222|\tfor planned := range plan {\n223|\t\tif strings.HasPrefix(planned, prefix) {\n224|\t\t\treturn true\n225|\t\t}\n226|\t}\n227|\treturn false\n228|}\n229|\n230|// blockedAncestor reports whether a strict directory prefix of the\n231|// key was observed as a non-directory: a symlink, special, or file\n232|// standing where the Guard must descend. The planned member routes\n233|// to its Guard open, which refuses with the full member named,\n234|// instead of reporting the unobserved member absent.\n235|func blockedAncestor(observed map[string]observedMember, key string) bool {\n236|\tfor offset := 0; offset < len(key); offset++ {\n237|\t\tif key[offset] != '/' {\n238|\t\t\tcontinue\n239|\t\t}\n240|\t\tif member, ok := observed[key[:offset]]; ok && member.kind != memberDir {\n241|\t\t\treturn true\n242|\t\t}\n243|\t}\n244|\treturn false\n245|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
