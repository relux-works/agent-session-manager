{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c86d","stream":{"kind":"session","id":"01a0b27e-c8a1-7be1-9b43-e0047ff1ed44"},"sequence":657,"recorded_at":1780531400001309,"record_type":"event","durability":"durable","causation_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","run_stream":{"kind":"run","id":"42a50646-ac4c-4d20-af82-db3f2b0269ba"},"call_id":"call_01a0b28029d176b9bf3b3a2208645a41","text":"Read text file `internal/clonesnap/exclusion_test.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"strconv\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n9|)\n10|\n11|func itoa(value int) string { return strconv.Itoa(value) }\n12|\n13|// Exclusion evidence: the always-excluded classes seal as excluded\n14|// rows with stable reasons, and their bytes never reach a blob, a\n15|// manifest, a log line, or an error string — because the walk never\n16|// opens them.\n17|\n18|var exclusionSecrets = map[string]string{\n19|\t\"credential\":     \"snap-secret-credential-7f3a\",\n20|\t\"machine_auth\":   \"snap-secret-machine-auth-9b1e\",\n21|\t\"runtime_state\":  \"snap-secret-runtime-state-4c8d\",\n22|\t\"transient_lock\": \"snap-secret-transient-lock-2e6f\",\n23|}\n24|\n25|func exclusionStore(t *testing.T) (string, []PlanItem) {\n26|\tt.Helper()\n27|\troot := t.TempDir()\n28|\twriteStoreFile(t, root, \"store/blob-a\", []byte(\"alpha-payload-bytes\"))\n29|\tplan := []PlanItem{{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true}}\n30|\tkeys := []string{\"store/auth-token\", \"store/lock-file\", \"store/runtime-sock\", \"store/session-key\"}\n31|\tclasses := []string{\"credential\", \"transient_lock\", \"runtime_state\", \"machine_auth\"}\n32|\tfor index, key := range keys {\n33|\t\twriteStoreFile(t, root, key, []byte(exclusionSecrets[classes[index]]))\n34|\t\tplan = append(plan, PlanItem{NativeKey: key, Class: classes[index], Required: true})\n35|\t}\n36|\t// Sorted: auth-token, blob-a, lock-file, runtime-sock, session-key.\n37|\tordered := []PlanItem{plan[1], plan[0], plan[2], plan[3], plan[4]}\n38|\treturn root, ordered\n39|}\n40|\n41|func TestCaptureExcludesSecrets(t *testing.T) {\n42|\tstoreRoot, plan := exclusionStore(t)\n43|\tstoreSink := openTestStore(t)\n44|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n45|\trequest.Plan = plan\n46|\tresult := mustCapture(t, request)\n47|\n48|\tbyKey := map[string]clonebundle.CaptureItem{}\n49|\tfor _, item := range result.Capture.Items {\n50|\t\tbyKey[item.NativeItemKey] = item\n51|\t}\n52|\texpectReason := map[string]string{\n53|\t\t\"store/auth-token\":   \"credential_excluded\",\n54|\t\t\"store/session-key\":  \"machine_auth_excluded\",\n55|\t\t\"store/runtime-sock\": \"runtime_state_excluded\",\n56|\t\t\"store/lock-file\":    \"transient_lock_excluded\",\n57|\t}\n58|\tfor key, reason := range expectReason {\n59|\t\titem, ok := byKey[key]\n60|\t\tif !ok {\n61|\t\t\tt.Fatalf(\"excluded candidate %q has no item\", key)\n62|\t\t}\n63|\t\tif item.Included() {\n64|\t\t\tt.Fatalf(\"excluded candidate %q sealed as included\", key)\n65|\t\t}\n66|\t\tif item.ExclusionReason == nil || *item.ExclusionReason != reason {\n67|\t\t\tt.Fatalf(\"excluded candidate %q reason = %v, want %q\", key, item.ExclusionReason, reason)\n68|\t\t}\n69|\t\tif item.BlobDescriptorID != nil || item.ByteCount != nil {\n70|\t\t\tt.Fatalf(\"excluded candidate %q carries content members\", key)\n71|\t\t}\n72|\t}\n73|\tfor _, entry := range result.Raw.Entries {\n74|\t\tif entry.NativeItemKey != \"store/blob-a\" {\n75|\t\t\tt.Fatalf(\"raw entry %q is not the included member\", entry.NativeItemKey)\n76|\t\t}\n77|\t}\n78|\n79|\tsecrets := []string{}\n80|\tfor _, secret := range exclusionSecrets {\n81|\t\tsecrets = append(secrets, secret)\n82|\t}\n83|\tscanSecrets := func(context string, haystacks ...string) {\n84|\t\tt.Helper()\n85|\t\tfor _, haystack := range haystacks {\n86|\t\t\tfor _, secret := range secrets {\n87|\t\t\t\tif strings.Contains(haystack, secret) {\n88|\t\t\t\t\tt.Fatalf(\"%s carries excluded bytes %q\", context, secret)\n89|\t\t\t\t}\n90|\t\t\t}\n91|\t\t}\n92|\t}\n93|\tfor _, blob := range listStoredBlobs(t, storeSink) {\n94|\t\tscanSecrets(\"stored blob\", string(blob.bytes))\n95|\t}\n96|\tscanSecrets(\"raw manifest\", string(result.RawManifest))\n97|\tscanSecrets(\"capture manifest\", string(result.CaptureManifest))\n98|\tscanSecrets(\"workspace binding\", string(result.WorkspaceBinding))\n99|\tscanSecrets(\"capture log\", strings.Join(result.Logs, \"\\n\"))\n100|\n101|\t// A refusal elsewhere in the run must not smuggle excluded\n102|\t// bytes into its error string either.\n103|\twriteStoreFile(t, storeRoot, \"store/zz-extra\", []byte(\"unplanned-bytes\"))\n104|\tsecond, err := Capture(validCaptureRequest(t, storeRoot, openTestStore(t)))\n105|\tif err == nil {\n106|\t\tt.Fatalf(\"Capture() = %+v, want an unplanned-member refusal\", second)\n107|\t}\n108|\tscanSecrets(\"refusal error\", err.Error())\n109|}\n110|\n111|func TestCaptureLogRecordsDigestsOnly(t *testing.T) {\n112|\tstoreRoot := t.TempDir()\n113|\tsecret := \"snap-secret-included-payload-5a1c\"\n114|\tpayload := \"prefix-\" + secret + \"-suffix\"\n115|\twriteStoreFile(t, storeRoot, \"store/blob-a\", []byte(payload))\n116|\tstoreSink := openTestStore(t)\n117|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n118|\trequest.Plan = []PlanItem{{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true}}\n119|\tresult := mustCapture(t, request)\n120|\n121|\tjoined := strings.Join(result.Logs, \"\\n\")\n122|\tif strings.Contains(joined, secret) {\n123|\t\tt.Fatalf(\"capture log carries payload bytes:\\n%s\", joined)\n124|\t}\n125|\tdigest := result.Raw.Entries[0].BlobID.String()\n126|\tif !strings.Contains(joined, digest) {\n127|\t\tt.Fatalf(\"capture log misses the blob digest %q:\\n%s\", digest, joined)\n128|\t}\n129|\tif !strings.Contains(joined, \"application/octet-stream\") {\n130|\t\tt.Fatalf(\"capture log misses the media type:\\n%s\", joined)\n131|\t}\n132|\tif want := \"size=\" + itoa(len(payload)); !strings.Contains(joined, want) {\n133|\t\tt.Fatalf(\"capture log misses the byte size %q:\\n%s\", want, joined)\n134|\t}\n135|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c86f","stream":{"kind":"session","id":"01a0b27e-c8a1-7be1-9b43-e0047ff1ed44"},"sequence":658,"recorded_at":1780531400001311,"record_type":"event","durability":"durable","causation_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","run_stream":{"kind":"run","id":"42a50646-ac4c-4d20-af82-db3f2b0269ba"},"call_id":"call_01a0b2802b3a73bba1bdf824d861685f","text":"Read text file `internal/clonesnap/crash_unix_test.go`.\n1|//go:build darwin || linux\n2|\n3|package clonesnap\n4|\n5|import (\n6|\t\"bytes\"\n7|\t\"context\"\n8|\t\"errors\"\n9|\t\"os\"\n10|\t\"os/exec\"\n11|\t\"path/filepath\"\n12|\t\"syscall\"\n13|\t\"testing\"\n14|\t\"time\"\n15|\n16|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n17|\t\"github.com/relux-works/agent-session-manager/internal/localstore\"\n18|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n19|)\n20|\n21|// parseTestUUID parses one fixture UUID outside a testing context.\n22|func parseTestUUID(value string) (scalar.UUIDv7, error) {\n23|\treturn scalar.ParseUUIDv7(value)\n24|}\n25|\n26|// testNativeIdentity builds the fixture native identity outside a\n27|// testing context.\n28|func testNativeIdentity(workspace scalar.UUIDv7) clonebundle.NativeIdentity {\n29|\treturn clonebundle.NativeIdentity{\n30|\t\tNativeSessionID:    \"native-session-snap\",\n31|\t\tIdentityKind:       \"provider_native\",\n32|\t\tLogicalWorkspaceID: workspace,\n33|\t}\n34|}\n35|\n36|// Real process-termination evidence for the manifest-publish seam:\n37|// the child runs the genuine production Capture entry and SIGKILLs\n38|// itself between the raw manifest publish and the capture manifest\n39|// seal. The parent then proves the kill left one complete raw\n40|// manifest with no capture manifest behind, and the identical replay\n41|// converges with both manifests and byte-identical bytes.\n42|//\n43|// The child rebuilds nothing: it opens the parent's store root,\n44|// object home, and workspace from the environment, so its closure\n45|// inputs are byte-identical to the parent's replay by construction.\n46|\n47|const (\n48|\tcrashChildEnv       = \"AX_CLONESNAP_CRASH_CHILD\"\n49|\tcrashChildRoot      = \"AX_CLONESNAP_CRASH_ROOT\"\n50|\tcrashChildHome      = \"AX_CLONESNAP_CRASH_HOME\"\n51|\tcrashChildWorkspace = \"AX_CLONESNAP_CRASH_WORKSPACE\"\n52|\tcrashGeneration     = \"crash-generation-7\"\n53|)\n54|\n55|func TestCaptureCrashChildSelfTerminates(t *testing.T) {\n56|\tif os.Getenv(crashChildEnv) == \"1\" {\n57|\t\tcaptureCrashChild()\n58|\t\treturn\n59|\t}\n60|\tstoreRoot := fixtureStore(t)\n61|\thome := t.TempDir()\n62|\tconfig := filepath.Join(home, \"config\")\n63|\tif err := os.Mkdir(config, 0o700); err != nil {\n64|\t\tt.Fatal(err)\n65|\t}\n66|\tworkspace := fixtureWorkspace(t)\n67|\tif _, err := openStoreAt(home); err != nil {\n68|\t\tt.Fatal(err)\n69|\t}\n70|\tctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)\n71|\tdefer cancel()\n72|\tchild := exec.CommandContext(ctx, os.Args[0],\n73|\t\t\"-test.run=^TestCaptureCrashChildSelfTerminates$\",\n74|\t\t\"-test.count=1\",\n75|\t)\n76|\tchild.Env = append(os.Environ(),\n77|\t\tcrashChildEnv+\"=1\",\n78|\t\tcrashChildRoot+\"=\"+storeRoot,\n79|\t\tcrashChildHome+\"=\"+home,\n80|\t\tcrashChildWorkspace+\"=\"+workspace.WorkspaceRoot,\n81|\t)\n82|\trunErr := child.Run()\n83|\tvar exitErr *exec.ExitError\n84|\tif !errors.As(runErr, &exitErr) {\n85|\t\tt.Fatalf(\"child run = %v, want a signal-kill exit\", runErr)\n86|\t}\n87|\tstatus, ok := exitErr.Sys().(syscall.WaitStatus)\n88|\tif !ok || !status.Signaled() || status.Signal() != syscall.SIGKILL {\n89|\t\tt.Fatalf(\"child status = %v, want killed by SIGKILL\", exitErr)\n90|\t}\n91|\t// The kill landed between the raw publish and the capture seal:\n92|\t// one complete raw manifest that verifies, no capture manifest,\n93|\t// no partial bytes.\n94|\tstore, err := openStoreAt(home)\n95|\tif err != nil {\n96|\t\tt.Fatal(err)\n97|\t}\n98|\trawFound := false\n99|\tfor _, blob := range listStoredBlobs(t, store) {\n100|\t\tif _, err := clonebundle.DecodeRawObjectManifest(blob.bytes); err == nil {\n101|\t\t\tif rawFound {\n102|\t\t\t\tt.Fatal(\"two raw manifests after one killed capture\")\n103|\t\t\t}\n104|\t\t\trawFound = true\n105|\t\t}\n106|\t\tif _, err := clonebundle.DecodeCaptureManifest(blob.bytes); err == nil {\n107|\t\t\tt.Fatal(\"capture manifest present after a kill before its seal\")\n108|\t\t}\n109|\t}\n110|\tif !rawFound {\n111|\t\tt.Fatal(\"raw manifest missing after a kill past its publish\")\n112|\t}\n113|\t// The identical replay converges: the raw publish verifies and\n114|\t// reuses, the capture manifest installs, and both manifests\n115|\t// decode.\n116|\trequest := crashRequest(t, storeRoot, store, workspace.WorkspaceRoot)\n117|\treplayed, err := Capture(request)\n118|\tif err != nil {\n119|\t\tt.Fatalf(\"replayed Capture() error = %v\", err)\n120|\t}\n121|\tif replayed.RawInstalled {\n122|\t\tt.Fatal(\"replay reinstalled the raw manifest instead of verifying and reusing\")\n123|\t}\n124|\tif !replayed.CaptureInstalled {\n125|\t\tt.Fatal(\"replay did not install the capture manifest\")\n126|\t}\n127|\t// The replayed bytes equal a clean capture over an identical\n128|\t// fixture: the kill published no half-written manifest.\n129|\tcleanRoot := fixtureStore(t)\n130|\tclean, err := Capture(crashRequest(t, cleanRoot, openTestStore(t), fixtureWorkspace(t).WorkspaceRoot))\n131|\tif err != nil {\n132|\t\tt.Fatalf(\"clean Capture() error = %v\", err)\n133|\t}\n134|\tif !bytes.Equal(replayed.RawManifest, clean.RawManifest) {\n135|\t\tt.Fatal(\"replayed raw manifest differs from the clean capture\")\n136|\t}\n137|\tif !bytes.Equal(replayed.CaptureManifest, clean.CaptureManifest) {\n138|\t\tt.Fatal(\"replayed capture manifest differs from the clean capture\")\n139|\t}\n140|}\n141|\n142|// crashRequest rebuilds the deterministic crash capture request over\n143|// the given store root, object store, and workspace root.\n144|func crashRequest(t *testing.T, storeRoot string, store *localstore.ObjectStore, workspaceRoot string) CaptureRequest {\n145|\tt.Helper()\n146|\tbranch := \"main\"\n147|\thead := fixtureDigest(\"snap-head\")\n148|\trequest := CaptureRequest{\n149|\t\tStoreRoot:         storeRoot,\n150|\t\tPlatform:          fixturePlatform(),\n151|\t\tPlan:              fixturePlan(),\n152|\t\tOperationID:       fixtureOperationID,\n153|\t\tBundleID:          fixtureBundleID,\n154|\t\tSourceBasis:       fixtureSourceBasis(),\n155|\t\tSourceEnvironment: []byte(fixtureTupleJSON()),\n156|\t\tSourceIdentity:    fixtureNativeIdentity(t),\n157|\t\tCapturePlanDigest: fixtureDigest(\"snap-capture-plan\"),\n158|\t\tNativeSessionID:   \"native-session-snap\",\n159|\t\tCreatedByHostID:   fixtureHostID,\n160|\t\tCreatedAt:         fixtureCreatedAt,\n161|\t\tGeneration:        crashGeneration,\n162|\t\tProofKind:         \"closed_store\",\n163|\t\tInputBlocked:      true,\n164|\t\tForegroundIdle:    true,\n165|\t\tBackgroundIdle:    true,\n166|\t\tOnRace:            RaceRefuse,\n167|\t\tWorkspace: WorkspaceRequest{\n168|\t\t\tLogicalWorkspaceID: fixtureWorkspaceID,\n169|\t\t\tWorkspaceRoot:      workspaceRoot,\n170|\t\t\tCwd:                filepath.Join(workspaceRoot, \"work\", \"trees\", \"alpha\"),\n171|\t\t\tRemoteFingerprints: []string{fixtureDigest(\"snap-remote\")},\n172|\t\t\tBranch:             &branch,\n173|\t\t\tHeadDigest:         &head,\n174|\t\t\tPlatform:           fixturePlatform(),\n175|\t\t},\n176|\t\tStore: store,\n177|\t}\n178|\treturn request\n179|}\n180|\n181|// captureCrashChild runs the production Capture entry and kills its\n182|// own process at the AfterRawPublish boundary. It never returns.\n183|func captureCrashChild() {\n184|\tstore, err := openStoreAt(os.Getenv(crashChildHome))\n185|\tif err != nil {\n186|\t\tos.Exit(66)\n187|\t}\n188|\tbranch := \"main\"\n189|\thead := fixtureDigest(\"snap-head\")\n190|\tworkspace, err := parseTestUUID(fixtureWorkspaceID)\n191|\tif err != nil {\n192|\t\tos.Exit(66)\n193|\t}\n194|\trequest := CaptureRequest{\n195|\t\tStoreRoot:         os.Getenv(crashChildRoot),\n196|\t\tPlatform:          fixturePlatform(),\n197|\t\tPlan:              fixturePlan(),\n198|\t\tOperationID:       fixtureOperationID,\n199|\t\tBundleID:          fixtureBundleID,\n200|\t\tSourceBasis:       fixtureSourceBasis(),\n201|\t\tSourceEnvironment: []byte(fixtureTupleJSON()),\n202|\t\tSourceIdentity:    testNativeIdentity(workspace),\n203|\t\tCapturePlanDigest: fixtureDigest(\"snap-capture-plan\"),\n204|\t\tNativeSessionID:   \"native-session-snap\",\n205|\t\tCreatedByHostID:   fixtureHostID,\n206|\t\tCreatedAt:         fixtureCreatedAt,\n207|\t\tGeneration:        crashGeneration,\n208|\t\tProofKind:         \"closed_store\",\n209|\t\tInputBlocked:      true,\n210|\t\tForegroundIdle:    true,\n211|\t\tBackgroundIdle:    true,\n212|\t\tOnRace:            RaceRefuse,\n213|\t\tWorkspace: WorkspaceRequest{\n214|\t\t\tLogicalWorkspaceID: fixtureWorkspaceID,\n215|\t\t\tWorkspaceRoot:      os.Getenv(crashChildWorkspace),\n216|\t\t\tCwd:                filepath.Join(os.Getenv(crashChildWorkspace), \"work\", \"trees\", \"alpha\"),\n217|\t\t\tRemoteFingerprints: []string{fixtureDigest(\"snap-remote\")},\n218|\t\t\tBranch:             &branch,\n219|\t\t\tHeadDigest:         &head,\n220|\t\t\tPlatform:           fixturePlatform(),\n221|\t\t},\n222|\t\tStore: store,\n223|\t\tHooks: CaptureHooks{AfterRawPublish: func() error {\n224|\t\t\t_ = syscall.Kill(syscall.Getpid(), syscall.SIGKILL)\n225|\t\t\t// The kill is asynchronous under instrumentation:\n226|\t\t\t// block here so a delivered SIGKILL always wins the\n227|\t\t\t// race against process exit. If the kill failed, the\n228|\t\t\t// parent context times out and fails the test instead\n229|\t\t\t// of passing on a wrong exit.\n230|\t\t\tselect {}\n231|\t\t}},\n232|\t}\n233|\t_, _ = Capture(request)\n234|\t// The hook must have fired: reaching here means the boundary\n235|\t// was skipped, so fail the parent with a clean exit.\n236|\tos.Exit(0)\n237|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c871","stream":{"kind":"session","id":"01a0b27e-c8a1-7be1-9b43-e0047ff1ed44"},"sequence":659,"recorded_at":1780531400001313,"record_type":"event","durability":"durable","causation_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","run_stream":{"kind":"run","id":"42a50646-ac4c-4d20-af82-db3f2b0269ba"},"call_id":"call_01a0b2802d487194a517e9c1f82ee9a3","text":"Read text file `internal/clonesnap/workspace.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"strings\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n14|)\n15|\n16|// This file builds the closed WorkspaceBinding from real repository\n17|// state: the logical workspace, the cwd normalized beneath the\n18|// Workspace Group root, sorted unique repository remote\n19|// fingerprints, the branch, and the head, index, and working-tree\n20|// digests. The cwd never grants filesystem authority: absolute\n21|// paths, dot segments, and escapes past the root refuse, and the\n22|// recorded relative path must name a directory that exists. The\n23|// binding seals through the landed DecodeWorkspaceBinding, so what\n24|// this entry emits is exactly what the closed shape admits.\n25|\n26|// WorkspaceRequest is one workspace checkpoint candidate: the\n27|// Workspace Group root and the observed repository facts. Cwd is an\n28|// absolute path or a root-relative path; RemoteFingerprints must\n29|// arrive sorted unique; the branch and digests are nullable.\n30|type WorkspaceRequest struct {\n31|\tLogicalWorkspaceID string\n32|\tWorkspaceRoot      string\n33|\tCwd                string\n34|\tRemoteFingerprints []string\n35|\tBranch             *string\n36|\tHeadDigest         *string\n37|\tIndexDigest        *string\n38|\tWorkingTreeDigest  *string\n39|\tPlatform           scalar.Platform\n40|}\n41|\n42|// CheckpointWorkspace builds one closed WorkspaceBinding from the\n43|// observed repository state and returns its canonical bytes. The\n44|// workspace root must be an existing directory opened without\n45|// following a trailing symlink; the cwd must normalize beneath it;\n46|// every digest and identifier validates through the landed decoder.\n47|func CheckpointWorkspace(request WorkspaceRequest) ([]byte, error) {\n48|\tworkspaceID, err := scalar.ParseUUIDv7(request.LogicalWorkspaceID)\n49|\tif err != nil {\n50|\t\treturn nil, invalid(\"workspace binding logical_workspace_id is not a UUIDv7: %v\", err)\n51|\t}\n52|\troot, err := secprim.OpenNoFollowDir(request.WorkspaceRoot)\n53|\tif err != nil {\n54|\t\treturn nil, invalid(\"workspace root %q: %v\", request.WorkspaceRoot, err)\n55|\t}\n56|\t_ = root.Close()\n57|\trelative, err := workspaceCwdRelative(request.Platform, request.WorkspaceRoot, request.Cwd)\n58|\tif err != nil {\n59|\t\treturn nil, err\n60|\t}\n61|\tfingerprints, err := workspaceFingerprints(request.RemoteFingerprints)\n62|\tif err != nil {\n63|\t\treturn nil, err\n64|\t}\n65|\tbranch, err := workspaceNullableText(request.Branch, \"branch\", 1, 1024)\n66|\tif err != nil {\n67|\t\treturn nil, err\n68|\t}\n69|\thead, err := workspaceNullableDigest(request.HeadDigest, \"head_digest\")\n70|\tif err != nil {\n71|\t\treturn nil, err\n72|\t}\n73|\tindex, err := workspaceNullableDigest(request.IndexDigest, \"index_digest\")\n74|\tif err != nil {\n75|\t\treturn nil, err\n76|\t}\n77|\ttree, err := workspaceNullableDigest(request.WorkingTreeDigest, \"working_tree_digest\")\n78|\tif err != nil {\n79|\t\treturn nil, err\n80|\t}\n81|\tobject := map[string]any{\n82|\t\t\"logical_workspace_id\":           workspaceID.String(),\n83|\t\t\"cwd_relative\":                   relative,\n84|\t\t\"repository_remote_fingerprints\": fingerprints,\n85|\t\t\"branch\":                         branch,\n86|\t\t\"head_digest\":                    head,\n87|\t\t\"index_digest\":                   index,\n88|\t\t\"working_tree_digest\":            tree,\n89|\t\t\"extensions\":                     map[string]any{},\n90|\t}\n91|\tplain, err := json.Marshal(object)\n92|\tif err != nil {\n93|\t\treturn nil, invalid(\"serialize workspace binding: %v\", err)\n94|\t}\n95|\tsealed, err := canonicaljson.Canonicalize(plain)\n96|\tif err != nil {\n97|\t\treturn nil, invalid(\"canonicalize workspace binding: %v\", err)\n98|\t}\n99|\tif _, err := clonebundle.DecodeWorkspaceBinding(sealed); err != nil {\n100|\t\treturn nil, invalid(\"sealed workspace binding refused: %v\", err)\n101|\t}\n102|\treturn sealed, nil\n103|}\n104|\n105|// workspaceCwdRelative normalizes the observed cwd beneath the\n106|// Workspace Group root. An absolute cwd must sit inside the root; a\n107|// relative cwd must already be normalized; absolute paths outside\n108|// the root, parent segments, and dot segments refuse. The resolved\n109|// directory must exist, so the checkpoint records observed state,\n110|// not an unanchored claim.\n111|func workspaceCwdRelative(platform scalar.Platform, root, cwd string) (string, error) {\n112|\tif cwd == \"\" {\n113|\t\treturn \"\", invalid(\"workspace binding cwd_relative is empty\")\n114|\t}\n115|\tif _, err := scalar.ParseAbsolutePath(platform, cwd); err == nil {\n116|\t\trelative, err := filepath.Rel(root, cwd)\n117|\t\tif err != nil {\n118|\t\t\treturn \"\", invalid(\"workspace binding cwd %q is not beneath the workspace root\", cwd)\n119|\t\t}\n120|\t\tif relative == \"..\" || strings.HasPrefix(relative, \"..\"+string(filepath.Separator)) {\n121|\t\t\treturn \"\", invalid(\"workspace binding cwd %q escapes the workspace root\", cwd)\n122|\t\t}\n123|\t\tcwd = filepath.ToSlash(relative)\n124|\t}\n125|\tif cwd == \".\" {\n126|\t\tcwd = \".\"\n127|\t} else {\n128|\t\tparsed, err := scalar.ParseRelativePath(cwd)\n129|\t\tif err != nil {\n130|\t\t\treturn \"\", invalid(\"workspace binding cwd_relative %q is not normalized beneath the workspace root: %v\", cwd, err)\n131|\t\t}\n132|\t\tcwd = parsed.String()\n133|\t}\n134|\tabsolute := root\n135|\tif cwd != \".\" {\n136|\t\tabsolute = filepath.Join(root, filepath.FromSlash(cwd))\n137|\t}\n138|\tinfo, err := os.Stat(absolute)\n139|\tif err != nil {\n140|\t\treturn \"\", invalid(\"workspace binding cwd_relative %q does not name an observed directory: %v\", cwd, err)\n141|\t}\n142|\tif !info.IsDir() {\n143|\t\treturn \"\", invalid(\"workspace binding cwd_relative %q does not name an observed directory\", cwd)\n144|\t}\n145|\treturn cwd, nil\n146|}\n147|\n148|// workspaceFingerprints admits the sorted unique repository remote\n149|// fingerprints: at most 128 digests in strict bytewise order. An\n150|// unsorted, duplicated, over-long, or over-count row refuses; the\n151|// entry never repairs caller order.\n152|func workspaceFingerprints(fingerprints []string) ([]any, error) {\n153|\tif len(fingerprints) > 128 {\n154|\t\treturn nil, invalid(\"workspace binding carries %d repository remote fingerprints, maximum is 128\", len(fingerprints))\n155|\t}\n156|\tprevious := \"\"\n157|\tvalues := make([]any, 0, len(fingerprints))\n158|\tfor index, fingerprint := range fingerprints {\n159|\t\tdigest, err := scalar.ParseDigest(fingerprint)\n160|\t\tif err != nil {\n161|\t\t\treturn nil, invalid(\"workspace binding repository_remote_fingerprints[%d] is not a digest: %v\", index, err)\n162|\t\t}\n163|\t\tif index > 0 && fingerprint <= previous {\n164|\t\t\treturn nil, invalid(\"workspace binding carries unsorted or duplicate repository remote fingerprints\")\n165|\t\t}\n166|\t\tprevious = fingerprint\n167|\t\tvalues = append(values, digest.String())\n168|\t}\n169|\treturn values, nil\n170|}\n171|\n172|func workspaceNullableText(value *string, name string, minimum, maximum int) (any, error) {\n173|\tif value == nil {\n174|\t\treturn nil, nil\n175|\t}\n176|\t// The Section 1.6 string measure counts characters, not bytes:\n177|\t// the bound delegates to the environ owner, never len.\n178|\tif length := environ.StringLength(*value); length < minimum || length > maximum {\n179|\t\treturn nil, invalid(\"workspace binding %s is not a string[%d..%d]\", name, minimum, maximum)\n180|\t}\n181|\treturn *value, nil\n182|}\n183|\n184|func workspaceNullableDigest(value *string, name string) (any, error) {\n185|\n186|\tif value == nil {\n187|\t\treturn nil, nil\n188|\t}\n189|\tdigest, err := scalar.ParseDigest(*value)\n190|\tif err != nil {\n191|\t\treturn nil, invalid(\"workspace binding %s is not a digest: %v\", name, err)\n192|\t}\n193|\treturn digest.String(), nil\n194|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
