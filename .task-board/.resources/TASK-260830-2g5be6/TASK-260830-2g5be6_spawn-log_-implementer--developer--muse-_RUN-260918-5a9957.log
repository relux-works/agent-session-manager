{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7c7","stream":{"kind":"session","id":"01a0b27e-c8a1-7be1-9b43-e0047ff1ed44"},"sequence":574,"recorded_at":1780531400001143,"record_type":"event","durability":"durable","causation_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","run_stream":{"kind":"run","id":"42a50646-ac4c-4d20-af82-db3f2b0269ba"},"task_stream":{"kind":"task","id":"01a0b280-1123-7cb0-8cdc-88fecdafc33a"},"task_id":"01a0b280-1123-7cb0-8cdc-88fecdafc33a","event":{"kind":"output","task_id":"01a0b280-1123-7cb0-8cdc-88fecdafc33a","chunk":"Read text file `internal/clonesnap/capture_test.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"crypto/sha256\"\n6|\t\"encoding/hex\"\n7|\t\"encoding/json\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|)\n16|\n17|// Positive contract tests: Capture seals both manifests from real\n18|// store bytes through the landed builders, every sealed manifest\n19|// re-decodes, identical runs produce byte-identical manifests, and\n20|// the sealed members match independently recomputed values.\n21|\n22|func TestCaptureSealsBothManifestsFromStoreBytes(t *testing.T) {\n23|\tstoreRoot := fixtureStore(t)\n24|\tstore := openTestStore(t)\n25|\tresult := mustCapture(t, validCaptureRequest(t, storeRoot, store))\n26|\n27|\tif result.BoundaryKind != \"stable\" {\n28|\t\tt.Fatalf(\"BoundaryKind = %q, want stable\", result.BoundaryKind)\n29|\t}\n30|\tif result.PreDigest != result.PostDigest {\n31|\t\tt.Fatalf(\"PreDigest %q != PostDigest %q on a quiet store\", result.PreDigest, result.PostDigest)\n32|\t}\n33|\tif !result.RawInstalled || !result.CaptureInstalled {\n34|\t\tt.Fatalf(\"Installed = (%v, %v), want (true, true) on first capture\", result.RawInstalled, result.CaptureInstalled)\n35|\t}\n36|\n37|\t// The raw manifest carries exactly the two included members,\n38|\t// sorted by native key, with byte counts recomputed here.\n39|\traw, err := clonebundle.DecodeRawObjectManifest(result.RawManifest)\n40|\tif err != nil {\n41|\t\tt.Fatalf(\"DecodeRawObjectManifest() error = %v\", err)\n42|\t}\n43|\tif len(raw.Entries) != 2 {\n44|\t\tt.Fatalf(\"raw entries = %d, want 2\", len(raw.Entries))\n45|\t}\n46|\tif raw.Entries[0].NativeItemKey != \"store/blob-a\" || raw.Entries[1].NativeItemKey != \"store/blob-b\" {\n47|\t\tt.Fatalf(\"raw entry keys = %q, %q\", raw.Entries[0].NativeItemKey, raw.Entries[1].NativeItemKey)\n48|\t}\n49|\twantA := sha256.Sum256([]byte(\"alpha-payload-bytes\"))\n50|\twantB := sha256.Sum256([]byte(\"beta-payload-bytes\"))\n51|\tif raw.Entries[0].BlobID.String() != \"sha256:\"+hex.EncodeToString(wantA[:]) {\n52|\t\tt.Fatalf(\"blob-a blob_id = %q\", raw.Entries[0].BlobID)\n53|\t}\n54|\tif raw.Entries[1].BlobID.String() != \"sha256:\"+hex.EncodeToString(wantB[:]) {\n55|\t\tt.Fatalf(\"blob-b blob_id = %q\", raw.Entries[1].BlobID)\n56|\t}\n57|\tif raw.Entries[0].ByteCount != uint64(len(\"alpha-payload-bytes\")) {\n58|\t\tt.Fatalf(\"blob-a byte_count = %d\", raw.Entries[0].ByteCount)\n59|\t}\n60|\tvar sum uint64\n61|\tfor _, entry := range raw.Entries {\n62|\t\tsum += entry.ByteCount\n63|\t}\n64|\tif raw.TotalBytes != sum {\n65|\t\tt.Fatalf(\"TotalBytes = %d, entries sum to %d\", raw.TotalBytes, sum)\n66|\t}\n67|\tif raw.SourceNativeSessionID != \"native-session-snap\" {\n68|\t\tt.Fatalf(\"SourceNativeSessionID = %q\", raw.SourceNativeSessionID)\n69|\t}\n70|\n71|\t// The capture manifest reconciles: one item per plan candidate,\n72|\t// the credential excluded with its stable reason, raw_complete\n73|\t// derived true, and the exact raw manifest identity.\n74|\tmanifest, err := clonebundle.DecodeCaptureManifest(result.CaptureManifest)\n75|\tif err != nil {\n76|\t\tt.Fatalf(\"DecodeCaptureManifest() error = %v\", err)\n77|\t}\n78|\tif len(manifest.Items) != 3 {\n79|\t\tt.Fatalf(\"capture items = %d, want 3\", len(manifest.Items))\n80|\t}\n81|\tbyKey := map[string]clonebundle.CaptureItem{}\n82|\tfor _, item := range manifest.Items {\n83|\t\tbyKey[item.NativeItemKey] = item\n84|\t}\n85|\tif !byKey[\"store/blob-a\"].Included() || !byKey[\"store/blob-b\"].Included() {\n86|\t\tt.Fatal(\"included members did not seal as included\")\n87|\t}\n88|\tcredential := byKey[\"store/token-cache\"]\n89|\tif credential.Included() {\n90|\t\tt.Fatal(\"credential sealed as included\")\n91|\t}\n92|\tif credential.ExclusionReason == nil || *credential.ExclusionReason != \"credential_excluded\" {\n93|\t\tt.Fatalf(\"credential exclusion reason = %v\", credential.ExclusionReason)\n94|\t}\n95|\tif len(manifest.ExcludedClasses) != 1 || manifest.ExcludedClasses[0] != \"credential\" {\n96|\t\tt.Fatalf(\"ExcludedClasses = %v, want [credential]\", manifest.ExcludedClasses)\n97|\t}\n98|\tif !manifest.RawComplete {\n99|\t\tt.Fatal(\"RawComplete = false, want true after complete reconciliation\")\n100|\t}\n101|\tif manifest.SourceRawObjectManifest != raw.ManifestID {\n102|\t\tt.Fatalf(\"SourceRawObjectManifest %q != raw %q\", manifest.SourceRawObjectManifest, raw.ManifestID)\n103|\t}\n104|\tif !manifest.CaptureBoundary.Stable() {\n105|\t\tt.Fatal(\"CaptureBoundary is not stable\")\n106|\t}\n107|\tproof := manifest.CaptureBoundary.Proof\n108|\tif proof.ProofKind != \"closed_store\" {\n109|\t\tt.Fatalf(\"ProofKind = %q, want closed_store\", proof.ProofKind)\n110|\t}\n111|\tif proof.PreCaptureDigest != proof.PostCaptureDigest {\n112|\t\tt.Fatal(\"sealed proof digests differ on a quiet store\")\n113|\t}\n114|\tif proof.PreCaptureDigest != result.PreDigest {\n115|\t\tt.Fatal(\"sealed proof pre digest is not the measured source digest\")\n116|\t}\n117|\tif proof.SourceGeneration.String() != \"generation-7\" {\n118|\t\tt.Fatalf(\"SourceGeneration = %q\", proof.SourceGeneration)\n119|\t}\n120|\n121|\t// The workspace checkpoint seals the observed repository state.\n122|\tbinding, err := clonebundle.DecodeWorkspaceBinding(result.WorkspaceBinding)\n123|\tif err != nil {\n124|\t\tt.Fatalf(\"DecodeWorkspaceBinding() error = %v\", err)\n125|\t}\n126|\tif binding.CwdRelative != \"work/trees/alpha\" {\n127|\t\tt.Fatalf(\"CwdRelative = %q\", binding.CwdRelative)\n128|\t}\n129|\tif binding.Branch == nil || *binding.Branch != \"main\" {\n130|\t\tt.Fatalf(\"Branch = %v\", binding.Branch)\n131|\t}\n132|\tif binding.HeadDigest == nil || binding.HeadDigest.String() != fixtureDigest(\"snap-head\") {\n133|\t\tt.Fatalf(\"HeadDigest = %v\", binding.HeadDigest)\n134|\t}\n135|}\n136|\n137|func TestCaptureIsByteIdenticalAcrossRuns(t *testing.T) {\n138|\tstoreRoot := fixtureStore(t)\n139|\tfirst := mustCapture(t, validCaptureRequest(t, storeRoot, openTestStore(t)))\n140|\tsecond := mustCapture(t, validCaptureRequest(t, storeRoot, openTestStore(t)))\n141|\tif !bytes.Equal(first.RawManifest, second.RawManifest) {\n142|\t\tt.Fatal(\"RawManifest bytes differ across identical runs\")\n143|\t}\n144|\tif !bytes.Equal(first.CaptureManifest, second.CaptureManifest) {\n145|\t\tt.Fatal(\"CaptureManifest bytes differ across identical runs\")\n146|\t}\n147|\tif first.PreDigest != second.PreDigest {\n148|\t\tt.Fatal(\"PreDigest differs across identical runs\")\n149|\t}\n150|}\n151|\n152|func TestCaptureUnknownMakesRawIncomplete(t *testing.T) {\n153|\tstoreRoot := fixtureStore(t)\n154|\twriteStoreFile(t, storeRoot, \"store/zz-unknown\", []byte(\"unknown-kind-bytes\"))\n155|\tstore := openTestStore(t)\n156|\trequest := validCaptureRequest(t, storeRoot, store)\n157|\trequest.Plan = []PlanItem{\n158|\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n159|\t\t{NativeKey: \"store/blob-b\", Class: \"durable_sidecar\", Required: true},\n160|\t\t{NativeKey: \"store/token-cache\", Class: \"credential\", Required: false},\n161|\t\t{NativeKey: \"store/zz-unknown\", Class: \"unknown\", Required: true},\n162|\t}\n163|\tresult := mustCapture(t, request)\n164|\tif result.Capture.RawComplete {\n165|\t\tt.Fatal(\"RawComplete = true with an unknown-class item, want false\")\n166|\t}\n167|\tif len(result.Raw.Entries) != 3 {\n168|\t\tt.Fatalf(\"raw entries = %d, want 3 (unknown is captured)\", len(result.Raw.Entries))\n169|\t}\n170|\tif err := clonebundle.RefuseMaximalSafeUnlessComplete(result.Capture); err == nil {\n171|\t\tt.Fatal(\"RefuseMaximalSafeUnlessComplete() = nil with an unknown-class item\")\n172|\t} else if !strings.Contains(err.Error(), \"maximal_safe\") {\n173|\t\tt.Fatalf(\"RefuseMaximalSafeUnlessComplete() error = %v, want the maximal_safe refusal\", err)\n174|\t}\n175|}\n176|\n177|func TestCaptureImmutableSnapshotProof(t *testing.T) {\n178|\tstoreRoot := fixtureStore(t)\n179|\tstore := openTestStore(t)\n180|\trequest := validCaptureRequest(t, storeRoot, store)\n181|\trequest.ProofKind = \"immutable_snapshot\"\n182|\tidentity := fixtureDigest(\"snap-snapshot-identity\")\n183|\trequest.SnapshotIdentity = &identity\n184|\tresult := mustCapture(t, request)\n185|\tproof := result.Capture.CaptureBoundary.Proof\n186|\tif proof.ProofKind != \"immutable_snapshot\" {\n187|\t\tt.Fatalf(\"ProofKind = %q\", proof.ProofKind)\n188|\t}\n189|\tif proof.SnapshotIdentity == nil || proof.SnapshotIdentity.String() != identity {\n190|\t\tt.Fatalf(\"SnapshotIdentity = %v\", proof.SnapshotIdentity)\n191|\t}\n192|}\n193|\n194|func TestCaptureExternalNativeBasis(t *testing.T) {\n195|\tstoreRoot := fixtureStore(t)\n196|\tstore := openTestStore(t)\n197|\trequest := validCaptureRequest(t, storeRoot, store)\n198|\trequest.SourceBasis = clonebundle.SourceBasisInput{\n199|\t\tKind:              \"external_native\",\n200|\t\tExternalSourceRef: \"provider-native-source-9\",\n201|\t}\n202|\tresult := mustCapture(t, request)\n203|\tif result.Capture.SourceBasis.Kind != \"external_native\" {\n204|\t\tt.Fatalf(\"SourceBasis kind = %q\", result.Capture.SourceBasis.Kind)\n205|\t}\n206|\tif result.Capture.SourceBasis.ExternalSourceRef == nil ||\n207|\t\t*result.Capture.SourceBasis.ExternalSourceRef != \"provider-native-source-9\" {\n208|\t\tt.Fatalf(\"ExternalSourceRef = %v\", result.Capture.SourceBasis.ExternalSourceRef)\n209|\t}\n210|}\n211|\n212|func TestCaptureOptionalAbsentSealsExcluded(t *testing.T) {\n213|\tstoreRoot := fixtureStore(t)\n214|\tstore := openTestStore(t)\n215|\trequest := validCaptureRequest(t, storeRoot, store)\n216|\trequest.Plan = []PlanItem{\n217|\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n218|\t\t{NativeKey: \"store/blob-b\", Class: \"durable_sidecar\", Required: true},\n219|\t\t{NativeKey: \"store/maybe\", Class: \"durable_payload\", Required: false},\n220|\t\t{NativeKey: \"store/token-cache\", Class: \"credential\", Required: false},\n221|\t}\n222|\tresult := mustCapture(t, request)\n223|\tif len(result.Capture.Items) != 4 {\n224|\t\tt.Fatalf(\"capture items = %d, want 4\", len(result.Capture.Items))\n225|\t}\n226|\tvar found *clonebundle.CaptureItem\n227|\tfor index := range result.Capture.Items {\n228|\t\tif result.Capture.Items[index].NativeItemKey == \"store/maybe\" {\n229|\t\t\tfound = &result.Capture.Items[index]\n230|\t\t}\n231|\t}\n232|\tif found == nil {\n233|\t\tt.Fatal(\"optional absent candidate has no item\")\n234|\t}\n235|\tif found.Included() {\n236|\t\tt.Fatal(\"optional absent candidate sealed as included\")\n237|\t}\n238|\tif found.ExclusionReason == nil || *found.ExclusionReason != \"plan_optional_absent\" {\n239|\t\tt.Fatalf(\"optional absent reason = %v\", found.ExclusionReason)\n240|\t}\n241|\tif !result.Capture.RawComplete {\n242|\t\tt.Fatal(\"RawComplete = false, want true: the absent optional reconciles as excluded\")\n243|\t}\n244|}\n245|\n246|func TestCaptureEmptyMemberSealsEmptyBlob(t *testing.T) {\n247|\tstoreRoot := fixtureStore(t)\n248|\twriteStoreFile(t, storeRoot, \"store/blob-empty\", []byte{})\n249|\tstore := openTestStore(t)\n250|\trequest := validCaptureRequest(t, storeRoot, store)\n251|\trequest.Plan = []PlanItem{\n252|\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n253|\t\t{NativeKey: \"store/blob-b\", Class: \"durable_sidecar\", Required: true},\n254|\t\t{NativeKey: \"store/blob-empty\", Class: \"durable_sidecar\", Required: true},\n255|\t\t{NativeKey: \"store/token-cache\", Class: \"credential\", Required: false},\n256|\t}\n257|\tresult := mustCapture(t, request)\n258|\tvar entry *clonebundle.RawObjectEntry\n259|\tfor index := range result.Raw.Entries {\n260|\t\tif result.Raw.Entries[index].NativeItemKey == \"store/blob-empty\" {\n261|\t\t\tentry = &result.Raw.Entries[index]\n262|\t\t}\n263|\t}\n264|\tif entry == nil {\n265|\t\tt.Fatal(\"empty member has no raw entry\")\n266|\t}\n267|\tif entry.ByteCount != 0 {\n268|\t\tt.Fatalf(\"empty member byte_count = %d\", entry.ByteCount)\n269|\t}\n270|\temptySum := sha256.Sum256(nil)\n271|\tif entry.BlobID.String() != \"sha256:\"+hex.EncodeToString(emptySum[:]) {\n272|\t\tt.Fatalf(\"empty member blob_id = %q\", entry.BlobID)\n273|\t}\n274|\tdescriptor, err := BuildBlobDescriptor([]byte{})\n275|\tif err != nil {\n276|\t\tt.Fatalf(\"BuildBlobDescriptor(empty) error = %v\", err)\n277|\t}\n278|\tvar members map[string]json.RawMessage\n279|\tif err := json.Unmarshal(descriptor.Descriptor, &members); err != nil {\n280|\t\tt.Fatal(err)\n281|\t}\n282|\tif string(members[\"chunks\"]) != \"[]\" {\n283|\t\tt.Fatalf(\"empty descriptor chunks = %s, want []\", members[\"chunks\"])\n284|\t}\n285|\tif string(members[\"media_type\"]) != `\"application/octet-stream\"` {\n286|\t\tt.Fatalf(\"empty descriptor media_type = %s\", members[\"media_type\"])\n287|\t}\n288|}\n289|\n290|func TestCaptureMultiChunkMember(t *testing.T) {\n291|\tstoreRoot := fixtureStore(t)\n292|\tpayload := bytes.Repeat([]byte(\"0123456789abcdef\"), 4*1048576/16+1)\n293|\tpayload = payload[:4*1048576+10]\n294|\twriteStoreFile(t, storeRoot, \"store/blob-big\", payload)\n295|\tstore := openTestStore(t)\n296|\trequest := validCaptureRequest(t, storeRoot, store)\n297|\trequest.Plan = []PlanItem{\n298|\t\t{NativeKey: \"store/blob-a\", Class: \"durable_payload\", Required: true},\n299|\t\t{NativeKey: \"store/blob-b\", Class: \"durable_sidecar\", Required: true},\n300|\t\t{NativeKey: \"store/blob-big\", Class: \"durable_payload\", Required: true},\n301|\t\t{NativeKey: \"store/token-cache\", Class: \"credential\", Required: false},\n302|\t}\n303|\tresult := mustCapture(t, request)\n304|\tdescriptor, err := BuildBlobDescriptor(payload)\n305|\tif err != nil {\n306|\t\tt.Fatalf(\"BuildBlobDescriptor() error = %v\", err)\n307|\t}\n308|\tvar members map[string]json.RawMessage\n309|\tif err := json.Unmarshal(descriptor.Descriptor, &members); err != nil {\n310|\t\tt.Fatal(err)\n311|\t}\n312|\tvar chunks []map[string]json.RawMessage\n313|\tif err := json.Unmarshal(members[\"chunks\"], &chunks); err != nil {\n314|\t\tt.Fatal(err)\n315|\t}\n316|\tif len(chunks) != 2 {\n317|\t\tt.Fatalf(\"chunks = %d, want 2\", len(chunks))\n318|\t}\n319|\tif string(chunks[0][\"index\"]) != \"0\" || string(chunks[0][\"offset\"]) != \"0\" ||\n320|\t\tstring(chunks[0][\"size\"]) != \"4194304\" {\n321|\t\tt.Fatalf(\"chunk[0] = %v\", chunks[0])\n322|\t}\n323|\tif string(chunks[1][\"index\"]) != \"1\" || string(chunks[1][\"offset\"]) != \"4194304\" ||\n324|\t\tstring(chunks[1][\"size\"]) != \"10\" {\n325|\t\tt.Fatalf(\"chunk[1] = %v\", chunks[1])\n326|\t}\n327|\tfirstSum := sha256.Sum256(payload[:4194304])\n328|\tif string(chunks[0][\"chunk_id\"]) != `\"sha256:`+hex.EncodeToString(firstSum[:])+`\"` {\n329|\t\tt.Fatalf(\"chunk[0] chunk_id = %s\", chunks[0][\"chunk_id\"])\n330|\t}\n331|\tvar found *clonebundle.RawObjectEntry\n332|\tfor index := range result.Raw.Entries {\n333|\t\tif result.Raw.Entries[index].NativeItemKey == \"store/blob-big\" {\n334|\t\t\tfound = &result.Raw.Entries[index]\n335|\t\t}\n336|\t}\n337|\tif found == nil || found.BlobID != descriptor.BlobID || found.BlobDescriptorID != descriptor.DescriptorID {\n338|\t\tt.Fatal(\"raw entry does not reference the sealed multi-chunk descriptor\")\n339|\t}\n340|}\n341|\n342|func TestDefaultMaxSingleBytesIs128GiB(t *testing.T) {\n343|\tif DefaultMaxSingleBytes != 137438953472 {\n344|\t\tt.Fatalf(\"DefaultMaxSingleBytes = %d, want 137438953472\", DefaultMaxSingleBytes)\n345|\t}\n346|}\n347|\n348|func storeFixturePayload(t *testing.T, storeRoot, key string) string {\n349|\tt.Helper()\n350|\treturn filepath.Join(storeRoot, filepath.FromSlash(key))\n351|}\n352|\n353|func TestCaptureDescriptorAgreementEndToEnd(t *testing.T) {\n354|\tstoreRoot := fixtureStore(t)\n355|\tstore := openTestStore(t)\n356|\tresult := mustCapture(t, validCaptureRequest(t, storeRoot, store))\n357|\tfetch := map[string][]byte{}\n358|\tfor _, entry := range result.Raw.Entries {\n359|\t\tpayload, err := os.ReadFile(storeFixturePayload(t, storeRoot, entry.NativeItemKey))\n360|\t\tif err != nil {\n361|\t\t\tt.Fatal(err)\n362|\t\t}\n363|\t\tdescriptor, err := BuildBlobDescriptor(payload)\n364|\t\tif err != nil {\n365|\t\t\tt.Fatal(err)\n366|\t\t}\n367|\t\tfetch[descriptor.DescriptorID.String()] = descriptor.Descriptor\n368|\t}\n369|\tif err := clonebundle.VerifyRawManifestDescriptors(result.Raw, func(id string) ([]byte, error) {\n370|\t\tdescriptor, ok := fetch[id]\n371|\t\tif !ok {\n372|\t\t\tt.Fatalf(\"descriptor fetch missed %s\", id)\n373|\t\t}\n374|\t\treturn descriptor, nil\n375|\t}); err != nil {\n376|\t\tt.Fatalf(\"VerifyRawManifestDescriptors() error = %v\", err)\n377|\t}\n378|\tif got := scalar.SHA256Digest([]byte(\"alpha-payload-bytes\")).String(); result.Raw.Entries[0].BlobID.String() != got {\n379|\t\tt.Fatalf(\"blob-a blob_id = %q, want %q\", result.Raw.Entries[0].BlobID, got)\n380|\t}\n381|}","final_result":true}}}
