{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c74b","stream":{"kind":"session","id":"01a0b27e-c8a1-7be1-9b43-e0047ff1ed44"},"sequence":512,"recorded_at":1780531400001019,"record_type":"event","durability":"durable","causation_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","run_stream":{"kind":"run","id":"42a50646-ac4c-4d20-af82-db3f2b0269ba"},"call_id":"call_01a0b27ff2a57138b620f5386edb4035","text":"Read text file `internal/clonesnap/capture.go`.\n(499 line(s) above)\n500|\t\t\t})\n501|\t\t\tcontinue\n502|\t\t}\n503|\t\treason := exclusionReason(item.Class)\n504|\t\tif !excludedClass(item.Class) {\n505|\t\t\treason = \"plan_optional_absent\"\n506|\t\t}\n507|\t\titems = append(items, clonebundle.CaptureItemInput{\n508|\t\t\tNativeItemKey:   key,\n509|\t\t\tClass:           item.Class,\n510|\t\t\tDisposition:     \"excluded\",\n511|\t\t\tExclusionReason: &reason,\n512|\t\t})\n513|\t}\n514|\tcaptureBytes, err := clonebundle.BuildCaptureManifest(clonebundle.CaptureManifestInput{\n515|\t\tOperationID:         request.OperationID,\n516|\t\tBundleID:            request.BundleID,\n517|\t\tSourceBasis:         request.SourceBasis,\n518|\t\tSourceEnvironment:   request.SourceEnvironment,\n519|\t\tSourceIdentity:      request.SourceIdentity,\n520|\t\tCapturePlanDigest:   request.CapturePlanDigest,\n521|\t\tBoundary:            boundary,\n522|\t\tSourceRawManifestID: raw.ManifestID.String(),\n523|\t\tItems:               items,\n524|\t\tPlanKeys:            append([]string(nil), state.planKeys...),\n525|\t\tRawKeys:             included,\n526|\t\tCreatedByHostID:     request.CreatedByHostID,\n527|\t\tCreatedAt:           request.CreatedAt,\n528|\t})\n529|\tif err != nil {\n530|\t\treturn nil, err\n531|\t}\n532|\tmanifest, err := clonebundle.DecodeCaptureManifest(captureBytes)\n533|\tif err != nil {\n534|\t\treturn nil, invalid(\"sealed capture manifest refused: %v\", err)\n535|\t}\n536|\tcapturePut, err := request.Store.PutBlob(scalar.SHA256Digest(captureBytes), uint64(len(captureBytes)), bytes.NewReader(captureBytes))\n537|\tif err != nil {\n538|\t\treturn nil, invalid(\"capture cannot publish the capture manifest: %v\", err)\n539|\t}\n540|\tboundaryKind := \"stable\"\n541|\tif !manifest.CaptureBoundary.Stable() {\n542|\t\tboundaryKind = \"unstable_archive\"\n543|\t}\n544|\tstate.log.Linef(\"boundary kind=%s pre=%s post=%s\", boundaryKind, state.pre.String(), state.post.String())\n545|\treturn &CaptureResult{\n546|\t\tRawManifest:      rawBytes,\n547|\t\tCaptureManifest:  captureBytes,\n548|\t\tWorkspaceBinding: append([]byte(nil), state.workspaceBytes...),\n549|\t\tRaw:              raw,\n550|\t\tCapture:          manifest,\n551|\t\tBoundaryKind:     boundaryKind,\n552|\t\tPreDigest:        state.pre,\n553|\t\tPostDigest:       state.post,\n554|\t\tRawInstalled:     rawPut.Installed,\n555|\t\tCaptureInstalled: capturePut.Installed,\n556|\t\tLogs:             state.log.Lines(),\n557|\t}, nil\n558|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c74d","stream":{"kind":"session","id":"01a0b27e-c8a1-7be1-9b43-e0047ff1ed44"},"sequence":513,"recorded_at":1780531400001021,"record_type":"event","durability":"durable","causation_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","run_stream":{"kind":"run","id":"42a50646-ac4c-4d20-af82-db3f2b0269ba"},"call_id":"call_01a0b27ff4c9772e8f68084265ca6f99","text":"Read text file `internal/clonesnap/testdata/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for internal/clonesnap.\n3|\n4|Every gate ships a narrowing mutant: the gate stays present and is\n5|weakened to admit exactly one member of the class it must reject, and\n6|the named killer test must fail. A delete-only mutant proves only that\n7|the gate exists and is not accepted as evidence.\n8|\n9|Each row runs M (mutate one production file in place), R (run the\n10|scoped Go killer through the production entry point), V (verdict from\n11|the Go exit code plus a FAIL kill-line: KILLED iff R fails with a test\n12|failure line, SURVIVED iff R passes, ERROR for anything else —\n13|unapplied patches, build breaks, timeouts). M failures and R\n14|infrastructure errors are ERROR, never kills or survivals. The file is\n15|restored from its backup after every row, pass or fail.\n16|\n17|Row N-plan-prefix is the token-preserving text mutant: the plan\n18|lookup keeps comparing against the planned keys but changes exact\n19|match to prefix match, and its killer drives the full Capture entry\n20|(the behavioral suite), not a static checker.\n21|\n22|Row C-doc-comment is the harmless control: a comment-only edit that\n23|must SURVIVE, proving the harness observes test outcomes instead of\n24|hard-coding kills.\n25|\n26|Usage:\n27|  PYTHONDONTWRITEBYTECODE=1 python3 internal/clonesnap/testdata/mutant_harness.py [--log-dir DIR] [MUTANT ...]\n28|\"\"\"\n29|\n30|import shutil\n31|import subprocess\n32|import sys\n33|import tempfile\n34|import time\n35|from dataclasses import dataclass\n36|from pathlib import Path\n37|\n38|REPO = Path(__file__).resolve().parents[3]\n39|PACKAGE = \"internal/clonesnap\"\n40|\n41|OPEN_MEMBER_HEAD = (\n42|    \"func openMember(guard secprim.Guard, root *os.File, member string, limit uint64) ([]byte, error) {\\n\"\n43|    \"\\tfile, err := guard.Open(root, member)\\n\"\n44|)\n45|\n46|PLAN_LOOKUP = (\n47|    '\\titem, planned := plan[key]\\n'\n48|    '\\tif !planned {\\n'\n49|    '\\t\\treturn \"\", invalid(\"capture store member %q is not a plan candidate\", key)\\n'\n50|    '\\t}\\n'\n51|    '\\treturn item.Class, nil\\n'\n52|)\n53|\n54|\n55|@dataclass(frozen=True)\n56|class Mutant:\n57|    name: str\n58|    path: str\n59|    find: str\n60|    replace: str\n61|    count: int\n62|    run: str\n63|    expect: str\n64|    note: str\n65|\n66|\n67|MUTANTS = [\n68|    Mutant(\n69|        name=\"N-contain-trailing\",\n70|        path=f\"{PACKAGE}/walk.go\",\n71|        find=OPEN_MEMBER_HEAD,\n72|        replace=(\n73|            \"func openMember(guard secprim.Guard, root *os.File, member string, limit uint64) ([]byte, error) {\\n\"\n74|            '\\tif member == \"link-escape\" {\\n'\n75|            '\\t\\treturn []byte(\"mutant-escaped-bytes\"), nil\\n'\n76|            '\\t}\\n'\n77|            \"\\tfile, err := guard.Open(root, member)\\n\"\n78|        ),\n79|        count=1,\n80|        run=\"TestCaptureRefusesTrailingSymlink\",\n81|        expect=\"KILLED\",\n82|        note=\"Stands forged bytes in for the Guard open of exactly link-escape; every other member still opens through the Guard.\",\n83|    ),\n84|    Mutant(\n85|        name=\"N-contain-intermediate\",\n86|        path=f\"{PACKAGE}/walk.go\",\n87|        find=OPEN_MEMBER_HEAD,\n88|        replace=(\n89|            \"func openMember(guard secprim.Guard, root *os.File, member string, limit uint64) ([]byte, error) {\\n\"\n90|            '\\tif member == \"link-escape/file\" {\\n'\n91|            '\\t\\treturn []byte(\"mutant-escaped-bytes\"), nil\\n'\n92|            '\\t}\\n'\n93|            \"\\tfile, err := guard.Open(root, member)\\n\"\n94|        ),\n95|        count=1,\n96|        run=\"TestCaptureRefusesSymlinkedIntermediate\",\n97|        expect=\"KILLED\",\n98|        note=\"Stands forged bytes in for the Guard open of exactly link-escape/file; every other member still opens through the Guard.\",\n99|    ),\n100|    Mutant(\n101|        name=\"N-fifo\",\n102|        path=f\"{PACKAGE}/walk.go\",\n103|        find=OPEN_MEMBER_HEAD,\n104|        replace=(\n105|            \"func openMember(guard secprim.Guard, root *os.File, member string, limit uint64) ([]byte, error) {\\n\"\n106|            '\\tif member == \"stash-fifo\" {\\n'\n107|            '\\t\\treturn []byte(\"mutant-fifo-bytes\"), nil\\n'\n108|            '\\t}\\n'\n109|            \"\\tfile, err := guard.Open(root, member)\\n\"\n110|        ),\n111|        count=1,\n112|        run=\"TestCaptureRefusesFIFO\",\n113|        expect=\"KILLED\",\n114|        note=\"Stands forged bytes in for the Guard open of exactly stash-fifo; every other member still opens through the Guard.\",\n115|    ),\n116|    Mutant(\n117|        name=\"N-unplanned\",\n118|        path=f\"{PACKAGE}/walk.go\",\n119|        find=PLAN_LOOKUP,\n120|        replace=(\n121|            '\\titem, planned := plan[key]\\n'\n122|            '\\tif !planned && key != \"store/zz-extra\" {\\n'\n123|            '\\t\\treturn \"\", invalid(\"capture store member %q is not a plan candidate\", key)\\n'\n124|            '\\t}\\n'\n125|            '\\tif !planned {\\n'\n126|            '\\t\\treturn \"durable_payload\", nil\\n'\n127|            '\\t}\\n'\n128|            '\\treturn item.Class, nil\\n'\n129|        ),\n130|        count=1,\n131|        run=\"TestCaptureRefusesUnplannedMember\",\n132|        expect=\"KILLED\",\n133|        note=\"Admits exactly store/zz-extra past the plan gate as durable_payload; every other unplanned key still refuses.\",\n134|    ),\n135|    Mutant(\n136|        name=\"N-plan-prefix\",\n137|        path=f\"{PACKAGE}/walk.go\",\n138|        find=PLAN_LOOKUP,\n139|        replace=(\n140|            '\\tfor plannedKey, plannedItem := range plan {\\n'\n141|            '\\t\\tif strings.HasPrefix(key, plannedKey) {\\n'\n142|            '\\t\\t\\treturn plannedItem.Class, nil\\n'\n143|            '\\t\\t}\\n'\n144|            '\\t}\\n'\n145|            '\\treturn \"\", invalid(\"capture store member %q is not a plan candidate\", key)\\n'\n146|        ),\n147|        count=1,\n148|        run=\"TestCaptureRefusesPrefixSibling\",\n149|        expect=\"KILLED\",\n150|        note=\"TOKEN-PRESERVING: the lookup still compares against the planned keys but admits prefix matches, so store/blob-a-evil rides on store/blob-a. The killer drives the full Capture entry.\",\n151|    ),\n152|    Mutant(\n153|        name=\"N-plan-order\",\n154|        path=f\"{PACKAGE}/walk.go\",\n155|        find=\"\\t\\tif index > 0 && item.NativeKey <= previous {\\n\",\n156|        replace=\"\\t\\tif index > 0 && item.NativeKey < previous {\\n\",\n157|        count=1,\n158|        run=\"TestCaptureRefusesDuplicatePlanKey\",\n159|        expect=\"KILLED\",\n160|        note=\"Admits exactly duplicate plan keys; unsorted keys still refuse with the plan detail.\",\n161|    ),\n162|    Mutant(\n163|        name=\"N-plan-sanitize\",\n164|        path=f\"{PACKAGE}/walk.go\",\n165|        find=\"\\t\\tif err := clonebundle.SanitizeNativeKey(item.NativeKey); err != nil {\\n\",\n166|        replace='\\t\\tif err := clonebundle.SanitizeNativeKey(item.NativeKey); err != nil && item.NativeKey != \"0198f4d1-9e60-7f66-8f86-f0123456789a\" {\\n',\n167|        count=1,\n168|        run=\"TestCaptureRefusesUnsanitizedPlanKey\",\n169|        expect=\"KILLED\",\n170|        note=\"Admits exactly one UUIDv7 plan key past the sanitizer; every other unsanitized key still refuses. Token preserved.\",\n171|    ),\n172|    Mutant(\n173|        name=\"N-plan-class\",\n174|        path=f\"{PACKAGE}/walk.go\",\n175|        find=\"\\t\\tif !clonebundle.ValidCaptureClass(item.Class) {\\n\",\n176|        replace='\\t\\tif !clonebundle.ValidCaptureClass(item.Class) && item.Class != \"mystery\" {\\n',\n177|        count=1,\n178|        run=\"TestCaptureRefusesMysteryPlanClass\",\n179|        expect=\"KILLED\",\n180|        note=\"Admits exactly class mystery past the vocabulary gate; every other unknown class still refuses.\",\n181|    ),\n182|    Mutant(\n183|        name=\"N-exclude-credential\",\n184|        path=f\"{PACKAGE}/walk.go\",\n185|        find='\\tcase \"credential\", \"machine_auth\", \"runtime_state\", \"transient_lock\":\\n',\n186|        replace='\\tcase \"machine_auth\", \"runtime_state\", \"transient_lock\":\\n',\n187|        count=1,\n188|        run=\"TestCaptureExcludesSecrets\",\n189|        expect=\"KILLED\",\n190|        note=\"Admits exactly credential rows as included; the other three always-excluded classes still exclude.\",\n191|    ),\n192|    Mutant(\n193|        name=\"N-exclude-machine-auth\",\n194|        path=f\"{PACKAGE}/walk.go\",\n195|        find='\\tcase \"credential\", \"machine_auth\", \"runtime_state\", \"transient_lock\":\\n',\n196|        replace='\\tcase \"credential\", \"runtime_state\", \"transient_lock\":\\n',\n197|        count=1,\n198|        run=\"TestCaptureExcludesSecrets\",\n199|        expect=\"KILLED\",\n200|        note=\"Admits exactly machine_auth rows as included; the other three always-excluded classes still exclude.\",\n201|    ),\n202|    Mutant(\n203|        name=\"N-exclude-runtime-state\",\n204|        path=f\"{PACKAGE}/walk.go\",\n205|        find='\\tcase \"credential\", \"machine_auth\", \"runtime_state\", \"transient_lock\":\\n',\n206|        replace='\\tcase \"credential\", \"machine_auth\", \"transient_lock\":\\n',\n207|        count=1,\n208|        run=\"TestCaptureExcludesSecrets\",\n209|        expect=\"KILLED\",\n210|        note=\"Admits exactly runtime_state rows as included; the other three always-excluded classes still exclude.\",\n211|    ),\n212|    Mutant(\n213|        name=\"N-exclude-transient-lock\",\n214|        path=f\"{PACKAGE}/walk.go\",\n215|        find='\\tcase \"credential\", \"machine_auth\", \"runtime_state\", \"transient_lock\":\\n',\n216|        replace='\\tcase \"credential\", \"machine_auth\", \"runtime_state\":\\n',\n217|        count=1,\n218|        run=\"TestCaptureExcludesSecrets\",\n219|        expect=\"KILLED\",\n220|        note=\"Admits exactly transient_lock rows as included; the other three always-excluded classes still exclude.\",\n221|    ),\n222|    Mutant(\n223|        name=\"N-required\",\n224|        path=f\"{PACKAGE}/capture.go\",\n225|        find=\"\\t\\tif !present && item.Required && !blockedAncestor(byKey, key) {\\n\",\n226|        replace='\\t\\tif !present && item.Required && key != \"store/must-have\" && !blockedAncestor(byKey, key) {\\n',\n227|        count=1,\n228|        run=\"TestCaptureRefusesRequiredMissing\",\n229|        expect=\"KILLED\",\n230|        note=\"Admits exactly store/must-have past the required-absent refusal; every other required-absent candidate still refuses.\",\n231|    ),\n232|    Mutant(\n233|        name=\"N-optional\",\n234|        path=f\"{PACKAGE}/capture.go\",\n235|        find=\"\\t\\tif !present && !item.Required && !blockedAncestor(byKey, key) {\\n\",\n236|        replace='\\t\\tif !present && !item.Required && key != \"store/maybe\" && !blockedAncestor(byKey, key) {\\n',\n237|        count=1,\n238|        run=\"TestCaptureOptionalAbsentSealsExcluded\",\n239|        expect=\"KILLED\",\n240|        note=\"Refuses exactly the optional-absent store/maybe that must seal as excluded; every other optional-absent still seals.\",\n241|    ),\n242|    Mutant(\n243|        name=\"N-race-narrow\",\n244|        path=f\"{PACKAGE}/race.go\",\n245|        find=\"\\tif err := clonebundle.CheckDigestsEqual(pre, post); err != nil {\\n\",\n246|        replace='\\tif err := clonebundle.CheckDigestsEqual(pre, post); err != nil && firstChangedMember(preLines, postLines) != \"store/blob-a\" {\\n',\n247|        count=1,\n248|        run=\"TestCaptureRaceChangedByte\",\n249|        expect=\"KILLED\",\n250|        note=\"Ignores exactly races naming store/blob-a; races on every other member still refuse.\",\n251|    ),\n252|    Mutant(\n253|        name=\"N-race-order-capture\",\n254|        path=f\"{PACKAGE}/capture.go\",\n255|        find=(\n256|            \"\\t// ORDER-PIN: the source-race gate precedes any seal or publish.\\n\"\n257|            \"\\t// N-race-order-capture moves this gate after sealAndPublish and\\n\"\n258|            \"\\t// the killer reddens on the published manifests.\\n\"\n259|            \"\\tif err := state.gateSourceRace(); err != nil {\\n\"\n260|            \"\\t\\treturn state.raceOutcome(err)\\n\"\n261|            \"\\t}\\n\"\n262|            \"\\treturn state.sealAndPublish(false)\\n\"\n263|        ),\n264|        replace=(\n265|            \"\\tsealed, sealErr := state.sealAndPublish(false)\\n\"\n266|            \"\\tif sealErr != nil {\\n\"\n267|            \"\\t\\treturn nil, sealErr\\n\"\n268|            \"\\t}\\n\"\n269|            \"\\tif err := state.gateSourceRace(); err != nil {\\n\"\n270|            \"\\t\\t_, _ = state.raceOutcome(err)\\n\"\n271|            \"\\t\\treturn sealed, err\\n\"\n272|            \"\\t}\\n\"\n273|            \"\\treturn sealed, nil\\n\"\n274|        ),\n275|        count=1,\n276|        run=\"TestCaptureRaceSealsNoManifest\",\n277|        expect=\"KILLED\",\n278|        note=\"ORDERING: seals and publishes before the race gate; the killer reddens on the published manifests and the non-nil result.\",\n279|    ),\n280|    Mutant(\n281|        name=\"N-race-order-project\",\n282|        path=f\"{PACKAGE}/project.go\",\n283|        find=(\n284|            \"\\t// ORDER-PIN: the source-race gate precedes any seal, admission,\\n\"\n285|            \"\\t// or projection output. N-race-order-project moves this gate\\n\"\n286|            \"\\t// after admitAndEmit and the killer reddens on the emitted\\n\"\n287|            \"\\t// receipt.\\n\"\n288|            \"\\tif err := state.gateSourceRace(); err != nil {\\n\"\n289|            \"\\t\\tcaptured, raceErr := state.raceOutcome(err)\\n\"\n290|            \"\\t\\tif raceErr != nil {\\n\"\n291|            \"\\t\\t\\treturn nil, raceErr\\n\"\n292|            \"\\t\\t}\\n\"\n293|            \"\\t\\t// Archive-only output never enters a target branch: the\\n\"\n294|            \"\\t\\t// admission gate below refuses it, so no receipt exists.\\n\"\n295|            \"\\t\\tif _, err := AdmitForTarget(captured.CaptureManifest, request.FidelityProfile); err != nil {\\n\"\n296|            \"\\t\\t\\treturn nil, err\\n\"\n297|            \"\\t\\t}\\n\"\n298|            '\\t\\treturn nil, invalid(\"capture archive unexpectedly admitted to a target branch\")\\n'\n299|            \"\\t}\\n\"\n300|            \"\\tsealed, err := state.sealAndPublish(false)\\n\"\n301|            \"\\tif err != nil {\\n\"\n302|            \"\\t\\treturn nil, err\\n\"\n303|            \"\\t}\\n\"\n304|            \"\\treturn state.admitAndEmit(request, sealed)\\n\"\n305|        ),\n306|        replace=(\n307|            \"\\tsealed, err := state.sealAndPublish(false)\\n\"\n308|            \"\\tif err != nil {\\n\"\n309|            \"\\t\\treturn nil, err\\n\"\n310|            \"\\t}\\n\"\n311|            \"\\temitted, emitErr := state.admitAndEmit(request, sealed)\\n\"\n312|            \"\\tif emitErr != nil {\\n\"\n313|            \"\\t\\treturn nil, emitErr\\n\"\n314|            \"\\t}\\n\"\n315|            \"\\tif err := state.gateSourceRace(); err != nil {\\n\"\n316|            \"\\t\\treturn emitted, err\\n\"\n317|            \"\\t}\\n\"\n318|            \"\\treturn emitted, nil\\n\"\n319|        ),\n320|        count=1,\n321|        run=\"TestCaptureRaceEmitsNoReceipt\",\n322|        expect=\"KILLED\",\n323|        note=\"ORDERING: admits and emits the receipt before the race gate; the killer reddens on the emitted receipt blob.\",\n324|    ),\n325|    Mutant(\n326|        name=\"N-explicit\",\n327|        path=f\"{PACKAGE}/capture.go\",\n328|        find=\"\\tif !state.request.OperatorExplicit {\\n\",\n329|        replace='\\tif !state.request.OperatorExplicit && state.request.Generation != \"generation-9\" {\\n',\n330|        count=1,\n331|        run=\"TestCaptureArchiveRequiresExplicit\",\n332|        expect=\"KILLED\",\n333|        note=\"Seals unstable output without acknowledgement for exactly generation-9; every other generation still refuses.\",\n334|    ),\n335|    Mutant(\n336|        name=\"N-g2\",\n337|        path=f\"{PACKAGE}/project.go\",\n338|        find=(\n339|            \"\\tif err := clonebundle.RefuseUnstableForTarget(manifest.CaptureBoundary); err != nil {\\n\"\n340|            \"\\t\\treturn clonebundle.CaptureManifest{}, err\\n\"\n341|            \"\\t}\\n\"\n342|        ),\n343|        replace=(\n344|            '\\tif err := clonebundle.RefuseUnstableForTarget(manifest.CaptureBoundary); err != nil && manifest.CaptureBoundary.SourceGeneration.String() != \"generation-9\" {\\n'\n345|            \"\\t\\treturn clonebundle.CaptureManifest{}, err\\n\"\n346|            \"\\t}\\n\"\n347|        ),\n348|        count=1,\n349|        run=\"TestProjectRefusesUnstable\",\n350|        expect=\"KILLED\",\n351|        note=\"Admits exactly generation-9 unstable archives to the target branch; every other unstable still refuses.\",\n352|    ),\n353|    Mutant(\n354|        name=\"N-maximal\",\n355|        path=f\"{PACKAGE}/project.go\",\n356|        find='\\tif profile == \"maximal_safe\" {\\n',\n357|        replace='\\tif profile == \"maximal_safe\" && len(manifest.Items) != 3 {\\n',\n358|        count=1,\n359|        run=\"TestProjectMaximalSafeRequiresComplete\",\n360|        expect=\"KILLED\",\n361|        note=\"Admits exactly the three-item unknown manifest to maximal_safe; unknown manifests of every other size still refuse.\",\n362|    ),\n363|    Mutant(\n364|        name=\"N-fidelity\",\n365|        path=f\"{PACKAGE}/project.go\",\n366|        find=\"\\tdefault:\\n\\t\\treturn false\\n\\t}\\n\",\n367|        replace='\\tcase FidelityProfile(\"ultra\"):\\n\\t\\treturn true\\n\\tdefault:\\n\\t\\treturn false\\n\\t}\\n',\n368|        count=1,\n369|        run=\"TestProjectRefusesUnknownProfile\",\n370|        expect=\"KILLED\",\n371|        note=\"Admits exactly profile ultra; every other unknown profile still refuses.\",\n372|    ),\n373|    Mutant(\n374|        name=\"N-oversize\",\n375|        path=f\"{PACKAGE}/walk.go\",\n376|        find=\"\\tif uint64(info.Size()) > limit {\\n\",\n377|        replace=\"\\tif uint64(info.Size()) > limit && uint64(info.Size()) != 11 {\\n\",\n378|        count=1,\n379|        run=\"TestCaptureRefusesOversizedMember\",\n380|        expect=\"KILLED\",\n381|        note=\"Admits exactly 11-byte members past the size bound; every other oversized member still refuses.\",\n382|    ),\n383|    Mutant(\n384|        name=\"N-descriptor-empty\",\n385|        path=f\"{PACKAGE}/descriptor.go\",\n386|        find=\"\\tchunks := make([]any, 0, 1)\\n\\tfor offset := uint64(0); offset < size; {\\n\",\n387|        replace=(\n388|            \"\\tchunks := make([]any, 0, 1)\\n\"\n389|            \"\\tif size == 0 {\\n\"\n390|            '\\t\\tchunks = append(chunks, map[string]any{\"index\": 0, \"offset\": 0, \"size\": 0, \"chunk_id\": blobID.String()})\\n'\n391|            \"\\t}\\n\"\n392|            \"\\tfor offset := uint64(0); offset < size; {\\n\"\n393|        ),\n394|        count=1,\n395|        run=\"TestCaptureEmptyMemberSealsEmptyBlob\",\n396|        expect=\"KILLED\",\n397|        note=\"Seals exactly empty payloads with a zero-size chunk; every non-empty payload still seals clean chunks.\",\n398|    ),\n399|    Mutant(\n400|        name=\"N-descriptor-offset\",\n401|        path=f\"{PACKAGE}/descriptor.go\",\n402|        find=(\n403|            \"\\t\\tchunks = append(chunks, map[string]any{\\n\"\n404|            '\\t\\t\\t\"index\":    len(chunks),\\n'\n405|            '\\t\\t\\t\"offset\":   offset,\\n'\n406|        ),\n407|        replace=(\n408|            \"\\t\\tshifted := offset\\n\"\n409|            \"\\t\\tif len(chunks) == 1 {\\n\"\n410|            \"\\t\\t\\tshifted = offset + 1\\n\"\n411|            \"\\t\\t}\\n\"\n412|            \"\\t\\tchunks = append(chunks, map[string]any{\\n\"\n413|            '\\t\\t\\t\"index\":    len(chunks),\\n'\n414|            '\\t\\t\\t\"offset\":   shifted,\\n'\n415|        ),\n416|        count=1,\n417|        run=\"TestCaptureMultiChunkMember\",\n418|        expect=\"KILLED\",\n419|        note=\"Shifts exactly the second chunk off contiguity; single-chunk descriptors still seal.\",\n420|    ),\n421|    Mutant(\n422|        name=\"N-workspace-cwd\",\n423|        path=f\"{PACKAGE}/workspace.go\",\n424|        find='\\t\\tif relative == \"..\" || strings.HasPrefix(relative, \"..\"+string(filepath.Separator)) {\\n',\n425|        replace='\\t\\tif (relative == \"..\" || strings.HasPrefix(relative, \"..\"+string(filepath.Separator))) && cwd != \"/outside-workspace\" {\\n',\n426|        count=1,\n427|        run=\"TestCheckpointWorkspaceRefusesEscape\",\n428|        expect=\"KILLED\",\n429|        note=\"Admits exactly the /outside-workspace escape past the escape refusal; every other escape still refuses.\",\n430|    ),\n431|    Mutant(\n432|        name=\"N-workspace-fingerprints\",\n433|        path=f\"{PACKAGE}/workspace.go\",\n434|        find=\"\\t\\tif index > 0 && fingerprint <= previous {\\n\",\n435|        replace=\"\\t\\tif index > 0 && fingerprint < previous {\\n\",\n436|        count=1,\n437|        run=\"TestCheckpointWorkspaceRefusesDuplicateFingerprint\",\n438|        expect=\"KILLED\",\n439|        note=\"Admits exactly duplicate fingerprints; unsorted fingerprints still refuse with the checkpoint detail.\",\n440|    ),\n441|    Mutant(\n442|        name=\"N-log-leak\",\n443|        path=f\"{PACKAGE}/capture.go\",\n444|        find='\\t\\tstate.log.Linef(\"capture member=%q class=%s digest=%s size=%d media=%s\", key, item.Class, descriptor.BlobID.String(), descriptor.Size, blobMediaType)\\n',\n445|        replace=(\n446|            '\\t\\tstate.log.Linef(\"capture member=%q class=%s digest=%s size=%d media=%s\", key, item.Class, descriptor.BlobID.String(), descriptor.Size, blobMediaType)\\n'\n447|            '\\t\\tif key == \"store/blob-a\" {\\n'\n448|            '\\t\\t\\tstate.log.Linef(\"capture preview=%q\", string(payload))\\n'\n449|            '\\t\\t}\\n'\n450|        ),\n451|        count=1,\n452|        run=\"TestCaptureLogRecordsDigestsOnly\",\n453|        expect=\"KILLED\",\n454|        note=\"Leaks exactly store/blob-a payload bytes into the log; every other member still logs digests only.\",\n455|    ),\n456|    Mutant(\n457|        name=\"N-hook-crash\",\n458|        path=f\"{PACKAGE}/capture.go\",\n459|        find=\"\\tif request.Hooks.AfterRawPublish != nil {\\n\",\n460|        replace='\\tif request.Hooks.AfterRawPublish != nil && request.Generation != \"crash-generation-7\" {\\n',\n461|        count=1,\n462|        run=\"TestCaptureCrashChildSelfTerminates\",\n463|        expect=\"KILLED\",\n464|        note=\"Skips the crash-boundary hook for exactly the crash generation; the child exits clean and the parent misses its SIGKILL.\",\n465|    ),\n466|    Mutant(\n467|        name=\"C-doc-comment\",\n468|        path=f\"{PACKAGE}/doc.go\",\n469|        find=\"// Authority: relux-works/agent-session-manager-spec@v0.7.0, Sections\\n\",\n470|        replace=\"// Authority: relux-works/agent-session-manager-spec@v0.7.0, Sections (control).\\n\",\n471|        count=1,\n472|        run=\"TestDefaultMaxSingleBytesIs128GiB\",\n473|        expect=\"SURVIVED\",\n474|        note=\"Harmless control: a comment-only edit must survive.\",\n475|    ),\n476|]\n477|\n478|\n479|def run_mutant(mutant: Mutant) -> tuple[str, str, int, float]:\n480|    target = REPO / mutant.path\n481|    original = target.read_text()\n482|    found = original.count(mutant.find)\n483|    if found != mutant.count:\n484|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\", \"\", -1, 0.0\n485|    with tempfile.TemporaryDirectory() as staging:\n486|        backup = Path(staging) / \"backup\"\n487|        shutil.copy2(target, backup)\n488|        try:\n489|            target.write_text(original.replace(mutant.find, mutant.replace))\n490|            started = time.time()\n491|            run = subprocess.run(\n492|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n493|                cwd=REPO,\n494|                capture_output=True,\n495|                text=True,\n496|                timeout=300,\n497|            )\n498|            elapsed = time.time() - started\n499|        finally:\n500|            shutil.copy2(backup, target)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
