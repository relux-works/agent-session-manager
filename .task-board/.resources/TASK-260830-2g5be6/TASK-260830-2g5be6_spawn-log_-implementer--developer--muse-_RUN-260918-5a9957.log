{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c62d","stream":{"kind":"session","id":"01a0b27e-c8a1-7be1-9b43-e0047ff1ed44"},"sequence":369,"recorded_at":1780531400000733,"record_type":"event","durability":"durable","causation_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","run_stream":{"kind":"run","id":"42a50646-ac4c-4d20-af82-db3f2b0269ba"},"task_stream":{"kind":"task","id":"01a0b27f-b665-7781-874e-cd5305d8c16f"},"task_id":"01a0b27f-b665-7781-874e-cd5305d8c16f","event":{"kind":"output","task_id":"01a0b27f-b665-7781-874e-cd5305d8c16f","chunk":"Read text file `/tmp/rev1/rev/review-evidence-TASK-260830-2g5be6-rev1/reviewer_mutants_rev1.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Reviewer narrowing-mutant battery for CR-TASK-260830-2g5be6-1.\n3|\n4|Each row patches ONE production file in the isolated `mut/` copy of the\n5|exact candidate tree, runs the WHOLE committed internal/clonesnap suite\n6|(go test ./internal/clonesnap/ -count=1), records the raw output with the\n7|subprocess exit, and restores the file from a byte copy. Verdicts:\n8|KILLED iff the suite fails with a FAIL line; SURVIVED iff exit 0; ERROR\n9|otherwise (unapplied anchor, build break, timeout).\n10|\n11|Usage: PYTHONDONTWRITEBYTECODE=1 python3 reviewer_mutants_rev1.py --repo mut --log-dir logs/mutants/run1\n12|\"\"\"\n13|\n14|import shutil\n15|import subprocess\n16|import sys\n17|import tempfile\n18|import time\n19|from dataclasses import dataclass\n20|from pathlib import Path\n21|\n22|PKG = \"internal/clonesnap\"\n23|\n24|\n25|@dataclass(frozen=True)\n26|class Mutant:\n27|    name: str\n28|    path: str\n29|    find: str\n30|    replace: str\n31|    kind: str  # narrowing | add-write | control | widening\n32|    note: str\n33|\n34|\n35|MUTANTS = [\n36|    Mutant(\n37|        name=\"R1-blockedAncestor-optional\",\n38|        path=f\"{PKG}/capture.go\",\n39|        find=\"\\t\\tif !present && !item.Required && !blockedAncestor(byKey, key) {\\n\",\n40|        replace=\"\\t\\tif !present && !item.Required {\\n\",\n41|        kind=\"narrowing\",\n42|        note=\"An OPTIONAL member behind a symlinked/special intermediate seals as plan_optional_absent instead of reaching the Guard refusal; required members still route to the Guard.\",\n43|    ),\n44|    Mutant(\n45|        name=\"R1-excluded-bytes-into-blob\",\n46|        path=f\"{PKG}/capture.go\",\n47|        find=\"\\t\\tif excludedClass(item.Class) {\\n\\t\\t\\tstate.log.Linef(\\\"exclude member=%q class=%s reason=%s\\\", key, item.Class, exclusionReason(item.Class))\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\",\n48|        replace=(\n49|            \"\\t\\tif excludedClass(item.Class) {\\n\"\n50|            \"\\t\\t\\tstate.log.Linef(\\\"exclude member=%q class=%s reason=%s\\\", key, item.Class, exclusionReason(item.Class))\\n\"\n51|            \"\\t\\t\\tif leaked, leakErr := openMember(state.guard, state.root, key, state.limit); leakErr == nil {\\n\"\n52|            \"\\t\\t\\t\\tif leakDescriptor, descErr := BuildBlobDescriptor(leaked); descErr == nil {\\n\"\n53|            \"\\t\\t\\t\\t\\t_, _ = clonebundle.InstallRawBlob(state.request.Store, leakDescriptor.Descriptor, bytes.NewReader(leaked))\\n\"\n54|            \"\\t\\t\\t\\t}\\n\"\n55|            \"\\t\\t\\t}\\n\"\n56|            \"\\t\\t\\tcontinue\\n\"\n57|            \"\\t\\t}\\n\"\n58|        ),\n59|        kind=\"add-write\",\n60|        note=\"Opens an always-excluded member and installs its bytes as an orphan blob (no manifest entry, no log line). Measures whether the blob scan in TestCaptureExcludesSecrets is load-bearing.\",\n61|    ),\n62|    Mutant(\n63|        name=\"R1-size-equality-is-proof\",\n64|        path=f\"{PKG}/race.go\",\n65|        find=\"\\tif err := clonebundle.CheckDigestsEqual(pre, post); err != nil {\\n\",\n66|        replace=(\n67|            \"\\tif sizeOnly(preLines) == sizeOnly(postLines) {\\n\"\n68|            \"\\t\\treturn nil\\n\"\n69|            \"\\t}\\n\"\n70|            \"\\tif err := clonebundle.CheckDigestsEqual(pre, post); err != nil {\\n\"\n71|        ),\n72|        kind=\"widening\",\n73|        note=\"Size equality decides the race: when every (key, kind, size) agrees the gate passes without comparing content hashes. The spec clause 'file-size equality is never proof'.\",\n74|    ),\n75|    Mutant(\n76|        name=\"R1-archive-seals-stable\",\n77|        path=f\"{PKG}/capture.go\",\n78|        find=\"\\treturn state.sealAndPublish(true)\\n\",\n79|        replace=\"\\treturn state.sealAndPublish(false)\\n\",\n80|        kind=\"narrowing\",\n81|        note=\"The archive path seals the STABLE form (pre digest for both) after a detected mutation with explicit acknowledgement.\",\n82|    ),\n83|    Mutant(\n84|        name=\"R1-archive-emits-receipt\",\n85|        path=f\"{PKG}/project.go\",\n86|        find=\"\\t\\t// Archive-only output never enters a target branch: the\\n\",\n87|        replace=(\n88|            \"\\t\\t_, _ = request.TargetSink.PutBlob(scalar.SHA256Digest(captured.CaptureManifest), uint64(len(captured.CaptureManifest)), bytes.NewReader(captured.CaptureManifest))\\n\"\n89|            \"\\t\\t// Archive-only output never enters a target branch: the\\n\"\n90|        ),\n91|        kind=\"add-write\",\n92|        note=\"The projection entry writes the archive capture manifest into the TARGET sink before the G2 refusal. Measures whether 'archive output never reaches the target sink' is pinned at the sink, not only at the error.\",\n93|    ),\n94|    Mutant(\n95|        name=\"R1-skip-payload-install-blob-b\",\n96|        path=f\"{PKG}/capture.go\",\n97|        find=\"\\t\\tif _, err := clonebundle.InstallRawBlob(state.request.Store, descriptor.Descriptor, bytes.NewReader(payload)); err != nil {\\n\\t\\t\\treturn invalid(\\\"capture member %q: %v\\\", key, err)\\n\\t\\t}\\n\",\n98|        replace=(\n99|            \"\\t\\tif key != \\\"store/blob-b\\\" {\\n\"\n100|            \"\\t\\t\\tif _, err := clonebundle.InstallRawBlob(state.request.Store, descriptor.Descriptor, bytes.NewReader(payload)); err != nil {\\n\"\n101|            \"\\t\\t\\t\\treturn invalid(\\\"capture member %q: %v\\\", key, err)\\n\"\n102|            \"\\t\\t\\t}\\n\"\n103|            \"\\t\\t}\\n\"\n104|        ),\n105|        kind=\"narrowing\",\n106|        note=\"Exactly store/blob-b is sealed into the raw manifest without its blob ever being installed. Measures whether payload-blob installation (10.2 'before publishing a record that references a blob') is pinned by the committed suite.\",\n107|    ),\n108|    Mutant(\n109|        name=\"R1-post-falls-back-to-captured-hash\",\n110|        path=f\"{PKG}/capture.go\",\n111|        find=\"\\t\\t\\tif !useCaptured {\\n\\t\\t\\t\\tif payload, err := openMember(state.guard, state.root, member.key, state.limit); err == nil {\\n\\t\\t\\t\\t\\trecord.addFile(member.key, uint64(len(payload)), contentHash(payload))\\n\\t\\t\\t\\t\\tcontinue\\n\\t\\t\\t\\t}\\n\\t\\t\\t}\\n\",\n112|        replace=(\n113|            \"\\t\\t\\tif !useCaptured {\\n\"\n114|            \"\\t\\t\\t\\tif payload, err := openMember(state.guard, state.root, member.key, state.limit); err == nil {\\n\"\n115|            \"\\t\\t\\t\\t\\trecord.addFile(member.key, uint64(len(payload)), contentHash(payload))\\n\"\n116|            \"\\t\\t\\t\\t\\tcontinue\\n\"\n117|            \"\\t\\t\\t\\t}\\n\"\n118|            \"\\t\\t\\t\\tfallback := false\\n\"\n119|            \"\\t\\t\\t\\tfor _, captured := range state.captured {\\n\"\n120|            \"\\t\\t\\t\\t\\tif captured.key == member.key {\\n\"\n121|            \"\\t\\t\\t\\t\\t\\trecord.addFile(member.key, captured.descriptor.Size, contentHash(captured.payload))\\n\"\n122|            \"\\t\\t\\t\\t\\t\\tfallback = true\\n\"\n123|            \"\\t\\t\\t\\t\\t}\\n\"\n124|            \"\\t\\t\\t\\t}\\n\"\n125|            \"\\t\\t\\t\\tif fallback {\\n\"\n126|            \"\\t\\t\\t\\t\\tcontinue\\n\"\n127|            \"\\t\\t\\t\\t}\\n\"\n128|            \"\\t\\t\\t}\\n\"\n129|        ),\n130|        kind=\"narrowing\",\n131|        note=\"A member that cannot be re-read at post time (retyped to a symlink/special, permission lost) falls back to the captured hash instead of unknown content, so the race is missed for exactly the unreadable-at-post class.\",\n132|    ),\n133|    Mutant(\n134|        name=\"R1-hook-after-post-measure\",\n135|        path=f\"{PKG}/capture.go\",\n136|        find=\"\\tstate.pre, state.preLines = state.recordSource(observed, true)\\n\\tif state.request.Hooks.AfterWalk != nil {\\n\\t\\tif err := state.request.Hooks.AfterWalk(state.request.StoreRoot); err != nil {\\n\\t\\t\\treturn invalid(\\\"capture hook refused after the walk: %v\\\", err)\\n\\t\\t}\\n\\t}\\n\\treturn state.measurePost()\\n\",\n137|        replace=(\n138|            \"\\tstate.pre, state.preLines = state.recordSource(observed, true)\\n\"\n139|            \"\\tif err := state.measurePost(); err != nil {\\n\"\n140|            \"\\t\\treturn err\\n\"\n141|            \"\\t}\\n\"\n142|            \"\\tif state.request.Hooks.AfterWalk != nil {\\n\"\n143|            \"\\t\\tif err := state.request.Hooks.AfterWalk(state.request.StoreRoot); err != nil {\\n\"\n144|            \"\\t\\t\\treturn invalid(\\\"capture hook refused after the walk: %v\\\", err)\\n\"\n145|            \"\\t\\t}\\n\"\n146|            \"\\t}\\n\"\n147|            \"\\treturn nil\\n\"\n148|        ),\n149|        kind=\"narrowing\",\n150|        note=\"Seam control: the injection hook runs after the post measurement, so every injected mutation lands outside the measured window. Proves the race suite depends on the seam it names.\",\n151|    ),\n152|    Mutant(\n153|        name=\"R1-descriptor-media-uppercase\",\n154|        path=f\"{PKG}/descriptor.go\",\n155|        find='\\tblobMediaType = \"application/octet-stream\"\\n',\n156|        replace='\\tblobMediaType = \"Application/Octet-Stream\"\\n',\n157|        kind=\"narrowing\",\n158|        note=\"Descriptor media_type violates the lowercase rule; measures that the landed canonicaljson closed-shape validator is in the descriptor path.\",\n159|    ),\n160|    Mutant(\n161|        name=\"R1-unstable-not-core\",\n162|        path=f\"{PKG}/capture.go\",\n163|        find=\"\\t\\t\\tCore:              true,\\n\",\n164|        replace=\"\\t\\t\\tCore:              false,\\n\",\n165|        kind=\"narrowing\",\n166|        note=\"The unstable form is built without the core flag; measures that the landed core-only construction rule is enforced through the capture entry.\",\n167|    ),\n168|    Mutant(\n169|        name=\"R1-publish-under-manifest-id\",\n170|        path=f\"{PKG}/capture.go\",\n171|        find=\"\\trawPut, err := request.Store.PutBlob(scalar.SHA256Digest(rawBytes), uint64(len(rawBytes)), bytes.NewReader(rawBytes))\\n\",\n172|        replace=\"\\trawPut, err := request.Store.PutBlob(raw.ManifestID, uint64(len(rawBytes)), bytes.NewReader(rawBytes))\\n\",\n173|        kind=\"narrowing\",\n174|        note=\"Publishes the raw manifest under its omit-self identity instead of the digest of its sealed bytes; measures that the store verifies the digest of what it installs.\",\n175|    ),\n176|    Mutant(\n177|        name=\"R1-oversize-boundary-off-by-one\",\n178|        path=f\"{PKG}/walk.go\",\n179|        find=\"\\tif uint64(info.Size()) > limit {\\n\",\n180|        replace=\"\\tif uint64(info.Size()) > limit+1 {\\n\",\n181|        kind=\"narrowing\",\n182|        note=\"Admits exactly limit+1 bytes: the far edge of the single-object bound (TestCaptureRefusesOversizedMember pins 11 and 12 under a 10-byte bound).\",\n183|    ),\n184|    Mutant(\n185|        name=\"R1-stable-seals-post-as-pre\",\n186|        path=f\"{PKG}/capture.go\",\n187|        find=\"\\t\\tPreCaptureDigest:  state.pre.String(),\\n\\t\\tPostCaptureDigest: state.pre.String(),\\n\",\n188|        replace=\"\\t\\tPreCaptureDigest:  state.pre.String(),\\n\\t\\tPostCaptureDigest: state.post.String(),\\n\",\n189|        kind=\"control\",\n190|        note=\"Equivalence control: sealing the measured post digest instead of the pre digest for post_capture_digest. Under the gate the two are equal, so this must SURVIVE; it also refutes the doc claim that this variant 'would fail closed under a reorder and leave the ordering unpinned' only if the ordering rows still kill (checked separately).\",\n191|    ),\n192|    Mutant(\n193|        name=\"R1-clonebundle-unknown-ignores-excluded\",\n194|        path=\"internal/clonebundle/capturebuild.go\",\n195|        find=\"\\tfor _, item := range items {\\n\\t\\tif item.Class == \\\"unknown\\\" {\\n\\t\\t\\treturn true\\n\\t\\t}\\n\\t}\\n\\treturn false\\n}\\n\",\n196|        replace=\"\\tfor _, item := range items {\\n\\t\\tif item.Class == \\\"unknown\\\" && item.Included() {\\n\\t\\t\\treturn true\\n\\t\\t}\\n\\t}\\n\\treturn false\\n}\\n\",\n197|        kind=\"narrowing\",\n198|        note=\"Inherited P3-ε re-planted at the landed site: an EXCLUDED unknown-class item no longer drives raw_complete=false nor blocks maximal_safe. Run against the clonesnap suite to measure whether this leaf closed the gap.\",\n199|    ),\n200|    Mutant(\n201|        name=\"C-rev1-comment\",\n202|        path=f\"{PKG}/walk.go\",\n203|        find=\"// This file owns the contained capture walk over a provider store\\n\",\n204|        replace=\"// This file owns the contained capture walk over a provider store (reviewer control)\\n\",\n205|        kind=\"control\",\n206|        note=\"Harmless control: a comment-only edit must SURVIVE.\",\n207|    ),\n208|]\n209|\n210|SIZE_ONLY_HELPER = '''\n211|// sizeOnly (reviewer mutant helper) strips content hashes from a record listing.\n212|func sizeOnly(lines []string) string {\n213|\tout := make([]string, 0, len(lines))\n214|\tfor _, line := range lines {\n215|\t\tif i := strings.LastIndex(line, \"\\\\x00\"); i >= 0 {\n216|\t\t\tline = line[:i]\n217|\t\t}\n218|\t\tout = append(out, line)\n219|\t}\n220|\tsort.Strings(out)\n221|\treturn strings.Join(out, \"\\\\n\")\n222|}\n223|'''\n224|\n225|\n226|def run(repo: Path, mutant: Mutant, log_dir: Path) -> str:\n227|    target = repo / mutant.path\n228|    original = target.read_bytes()\n229|    text = original.decode()\n230|    count = text.count(mutant.find)\n231|    if count != 1:\n232|        line = f\"ERROR: {mutant.name}: anchor count {count}, want 1\"\n233|        (log_dir / f\"{mutant.name}.log\").write_text(line + \"\\n\")\n234|        return line\n235|    patched = text.replace(mutant.find, mutant.replace)\n236|    if mutant.name == \"R1-size-equality-is-proof\":\n237|        patched += SIZE_ONLY_HELPER\n238|    with tempfile.TemporaryDirectory() as staging:\n239|        backup = Path(staging) / \"backup\"\n240|        backup.write_bytes(original)\n241|        try:\n242|            target.write_text(patched)\n243|            started = time.time()\n244|            try:\n245|                proc = subprocess.run(\n246|                    [\"go\", \"test\", f\"./{PKG}/\", \"-count=1\"],\n247|                    cwd=repo, capture_output=True, text=True, timeout=600,\n248|                )\n249|                output = (proc.stdout + proc.stderr).strip()\n250|                code = proc.returncode\n251|            except subprocess.TimeoutExpired:\n252|                output = \"TIMEOUT\"\n253|                code = -1\n254|            elapsed = time.time() - started\n255|        finally:\n256|            target.write_bytes(backup.read_bytes())\n257|    if target.read_bytes() != original:\n258|        raise SystemExit(f\"restore failed for {mutant.path}\")\n259|    if output == \"TIMEOUT\":\n260|        verdict = \"ERROR(timeout)\"\n261|    elif \"build failed\" in output or output.startswith(\"# \") or \"\\n# \" in output:\n262|        verdict = \"ERROR(build)\"\n263|    elif code == 0:\n264|        verdict = \"SURVIVED\"\n265|    elif \"--- FAIL\" in output or \"FAIL:\" in output:\n266|        verdict = \"KILLED\"\n267|    else:\n268|        verdict = f\"ERROR(exit {code})\"\n269|    killers = sorted({l.split()[2] for l in output.splitlines() if l.startswith(\"--- FAIL\")})\n270|    line = f\"{mutant.name}: {verdict} kind={mutant.kind} exit={code} elapsed={elapsed:.1f}s killers={','.join(killers) or '-'} :: {mutant.note}\"\n271|    (log_dir / f\"{mutant.name}.log\").write_text(\n272|        f\"# mutant={mutant.name} path={mutant.path} kind={mutant.kind}\\n# exit={code} elapsed={elapsed:.1f}s verdict={verdict}\\n# find={mutant.find!r}\\n# replace={mutant.replace!r}\\n---\\n{output}\\n\"\n273|    )\n274|    return line\n275|\n276|\n277|def main(argv):\n278|    repo = Path(\"mut\")\n279|    log_dir = Path(\"logs/mutants/run\")\n280|    names = []\n281|    i = 0\n282|    while i < len(argv):\n283|        if argv[i] == \"--repo\":\n284|            repo = Path(argv[i + 1]); i += 2\n285|        elif argv[i] == \"--log-dir\":\n286|            log_dir = Path(argv[i + 1]); i += 2\n287|        else:\n288|            names.append(argv[i]); i += 1\n289|    log_dir.mkdir(parents=True, exist_ok=True)\n290|    selected = [m for m in MUTANTS if not names or m.name in names]\n291|    for m in selected:\n292|        print(run(repo.resolve(), m, log_dir), flush=True)\n293|    return 0\n294|\n295|\n296|if __name__ == \"__main__\":\n297|    sys.exit(main(sys.argv[1:]))","final_result":true}}}
