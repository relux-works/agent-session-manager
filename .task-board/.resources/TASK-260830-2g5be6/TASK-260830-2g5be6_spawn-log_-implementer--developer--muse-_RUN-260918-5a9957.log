{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8cf","stream":{"kind":"session","id":"01a0b27e-c8a1-7be1-9b43-e0047ff1ed44"},"sequence":706,"recorded_at":1780531400001407,"record_type":"event","durability":"durable","causation_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"42a50646-ac4c-4d20-af82-db3f2b0269ba","run_stream":{"kind":"run","id":"42a50646-ac4c-4d20-af82-db3f2b0269ba"},"task_stream":{"kind":"task","id":"01a0b280-8add-7662-9b5b-26d6fc52d9c9"},"task_id":"01a0b280-8add-7662-9b5b-26d6fc52d9c9","event":{"kind":"output","task_id":"01a0b280-8add-7662-9b5b-26d6fc52d9c9","chunk":"Read text file `internal/clonesnap/fifo_unix_test.go`.\n1|//go:build darwin || linux\n2|\n3|package clonesnap\n4|\n5|import (\n6|\t\"path/filepath\"\n7|\t\"testing\"\n8|\n9|\t\"golang.org/x/sys/unix\"\n10|)\n11|\n12|// A FIFO member refuses before any payload byte is read: the Guard\n13|// opens it non-blocking and refuses its special shape with the\n14|// member named. The test completes without a writer, which is the\n15|// proof the open never stalled.\n16|\n17|func TestCaptureRefusesFIFO(t *testing.T) {\n18|\tstoreRoot := t.TempDir()\n19|\tfifo := filepath.Join(storeRoot, \"stash-fifo\")\n20|\tif err := unix.Mkfifo(fifo, 0o600); err != nil {\n21|\t\tt.Fatalf(\"Mkfifo() error = %v\", err)\n22|\t}\n23|\tstoreSink := openTestStore(t)\n24|\trequest := validCaptureRequest(t, storeRoot, storeSink)\n25|\trequest.Plan = []PlanItem{\n26|\t\t{NativeKey: \"stash-fifo\", Class: \"durable_payload\", Required: true},\n27|\t}\n28|\tresult, err := Capture(request)\n29|\tif err == nil {\n30|\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n31|\t}\n32|\trequireRefusalDetail(t, err, \"stash-fifo\")\n33|}","final_result":true}}}
