{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c61f","stream":{"kind":"session","id":"01a0b225-c4f5-7551-94b6-c0c601dc074b"},"sequence":362,"recorded_at":1780531400000719,"record_type":"event","durability":"durable","causation_id":"83118e98-b6d0-4b7d-9792-f7c513af3eac","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"83118e98-b6d0-4b7d-9792-f7c513af3eac","run_stream":{"kind":"run","id":"83118e98-b6d0-4b7d-9792-f7c513af3eac"},"task_stream":{"kind":"task","id":"01a0b226-64d9-7d13-a258-e56951d956b5"},"task_id":"01a0b226-64d9-7d13-a258-e56951d956b5","event":{"kind":"output","task_id":"01a0b226-64d9-7d13-a258-e56951d956b5","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/dirnode/scan.go`.\n1|package dirnode\n2|\n3|import (\n4|\t\"encoding/base64\"\n5|\t\"encoding/json\"\n6|\t\"sort\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// This file validates the Section 7.9 scan operation framing and\n13|// owns the (operation, operation_id) idempotency the scan and\n14|// enrichment-run mutations use: repeating the same canonical body\n15|// returns the prior durable result, and a changed body under a\n16|// recorded key is an idempotency_mismatch without new records.\n17|//\n18|// Scan reads only declared non-auth roots, publishes observations\n19|// and its Inventory Batch atomically, and never claims that an\n20|// active prefix is a cloning-safe boundary. The InventoryBatch\n21|// content crosses as a present object: its content owner is the\n22|// shared-environment leaf of this Story, so CheckScanResponse\n23|// requires the object shape and never inspects further.\n24|\n25|// scanRequestMembers is the exact scan request-body member set.\n26|var scanRequestMembers = map[string]bool{\n27|\t\"operation_id\":     true,\n28|\t\"installation_ids\": true,\n29|\t\"prior_batch_id\":   true,\n30|\t\"cursor\":           true,\n31|\t\"max_instances\":    true,\n32|\t\"extensions\":       true,\n33|}\n34|\n35|// scanRequestRequired lists scanRequestMembers in a fixed order.\n36|var scanRequestRequired = []string{\n37|\t\"operation_id\",\n38|\t\"installation_ids\",\n39|\t\"prior_batch_id\",\n40|\t\"cursor\",\n41|\t\"max_instances\",\n42|\t\"extensions\",\n43|}\n44|\n45|// ScanRequest is one validated scan request body.\n46|type ScanRequest struct {\n47|\tOperationID   string\n48|\tInstallations []string\n49|\tHasPriorBatch bool\n50|\tPriorBatchID  string\n51|\tHasCursor     bool\n52|\tCursor        string\n53|\tMaxInstances  uint64\n54|}\n55|\n56|// CheckScanRequest validates one scan-operation request body: the\n57|// exact closed members, a UUIDv7 operation identifier, sorted\n58|// unique installation digests in the count bound, a digest|null\n59|// prior batch, a string[1..4096]|null cursor, and max_instances in\n60|// uint53[1..65536]. Null is the only accepted absence for the\n61|// nullable members: a missing-typed value is not an absence.\n62|func CheckScanRequest(body []byte) (ScanRequest, error) {\n63|\tmembers, fault := decodeStrictObject(bytesTrimSpace(body))\n64|\tif fault != nil {\n65|\t\tfailure, err := failViolation(\"scan request \"+fault.detail, fault.member)\n66|\t\tif err != nil {\n67|\t\t\treturn ScanRequest{}, err\n68|\t\t}\n69|\t\treturn ScanRequest{}, failure\n70|\t}\n71|\tif name, unknown := unknownMember(members, scanRequestMembers); unknown {\n72|\t\tfailure, err := failViolation(\"scan request carries unknown member\", name)\n73|\t\tif err != nil {\n74|\t\t\treturn ScanRequest{}, err\n75|\t\t}\n76|\t\treturn ScanRequest{}, failure\n77|\t}\n78|\tif name, missing := missingMember(members, scanRequestRequired); missing {\n79|\t\tfailure, err := failViolation(\"scan request misses a required member\", name)\n80|\t\tif err != nil {\n81|\t\t\treturn ScanRequest{}, err\n82|\t\t}\n83|\t\treturn ScanRequest{}, failure\n84|\t}\n85|\toperationID, ok := checkUUIDv7(members[\"operation_id\"])\n86|\tif !ok {\n87|\t\tfailure, err := failViolation(\"scan request operation identifier is not a UUIDv7\", \"operation_id\")\n88|\t\tif err != nil {\n89|\t\t\treturn ScanRequest{}, err\n90|\t\t}\n91|\t\treturn ScanRequest{}, failure\n92|\t}\n93|\tinstallations, ok := checkSortedUniqueDigests(members[\"installation_ids\"], 1, 256)\n94|\tif !ok {\n95|\t\tfailure, err := failViolation(\"scan request installations are not sorted unique digest[1..256]\", \"installation_ids\")\n96|\t\tif err != nil {\n97|\t\t\treturn ScanRequest{}, err\n98|\t\t}\n99|\t\treturn ScanRequest{}, failure\n100|\t}\n101|\tprior, present, wasNull := checkOptionalDigest(members[\"prior_batch_id\"])\n102|\tif !present {\n103|\t\tfailure, err := failViolation(\"scan request prior batch is not a digest|null\", \"prior_batch_id\")\n104|\t\tif err != nil {\n105|\t\t\treturn ScanRequest{}, err\n106|\t\t}\n107|\t\treturn ScanRequest{}, failure\n108|\t}\n109|\tcursor, cursorPresent, cursorNull := checkOptionalString(members[\"cursor\"], 1, 4096)\n110|\tif !cursorPresent {\n111|\t\tfailure, err := failViolation(\"scan request cursor is not a string[1..4096]|null\", \"cursor\")\n112|\t\tif err != nil {\n113|\t\t\treturn ScanRequest{}, err\n114|\t\t}\n115|\t\treturn ScanRequest{}, failure\n116|\t}\n117|\tmaximum, ok := checkUint53Bounds(members[\"max_instances\"], 1, 65536)\n118|\tif !ok {\n119|\t\tfailure, err := failViolation(\"scan request max_instances is not uint53[1..65536]\", \"max_instances\")\n120|\t\tif err != nil {\n121|\t\t\treturn ScanRequest{}, err\n122|\t\t}\n123|\t\treturn ScanRequest{}, failure\n124|\t}\n125|\tif !checkExtensions(members[\"extensions\"]) {\n126|\t\tfailure, err := failViolation(\"scan request extensions are not reverse-DNS keyed\", \"extensions\")\n127|\t\tif err != nil {\n128|\t\t\treturn ScanRequest{}, err\n129|\t\t}\n130|\t\treturn ScanRequest{}, failure\n131|\t}\n132|\treturn ScanRequest{\n133|\t\tOperationID:   operationID.String(),\n134|\t\tInstallations: digestStrings(installations),\n135|\t\tHasPriorBatch: !wasNull,\n136|\t\tPriorBatchID:  prior.String(),\n137|\t\tHasCursor:     !cursorNull,\n138|\t\tCursor:        cursor,\n139|\t\tMaxInstances:  maximum,\n140|\t}, nil\n141|}\n142|\n143|// scanResponseMembers is the exact scan success-body member set.\n144|var scanResponseMembers = map[string]bool{\n145|\t\"batch\":                       true,\n146|\t\"environment_observation_ids\": true,\n147|\t\"native_observation_ids\":      true,\n148|\t\"next_cursor\":                 true,\n149|\t\"extensions\":                  true,\n150|}\n151|\n152|// scanResponseRequired lists scanResponseMembers in a fixed order.\n153|var scanResponseRequired = []string{\n154|\t\"batch\",\n155|\t\"environment_observation_ids\",\n156|\t\"native_observation_ids\",\n157|\t\"next_cursor\",\n158|\t\"extensions\",\n159|}\n160|\n161|// ScanResponse is one validated scan success body. The batch\n162|// crosses as presence: the InventoryBatch content owner is the\n163|// shared-environment leaf, so only the object shape is checked.\n164|type ScanResponse struct {\n165|\tHasBatch       bool\n166|\tEnvironmentIDs []string\n167|\tNativeIDs      []string\n168|\tHasNextCursor  bool\n169|\tNextCursor     string\n170|}\n171|\n172|// CheckScanResponse validates one scan-operation success body: the\n173|// exact closed members, a present batch object, sorted unique\n174|// environment observation digests in [1..256], sorted unique\n175|// native observation digests in [0..65536], and a\n176|// string[1..4096]|null next cursor.\n177|func CheckScanResponse(body []byte) (ScanResponse, error) {\n178|\tmembers, fault := decodeStrictObject(bytesTrimSpace(body))\n179|\tif fault != nil {\n180|\t\tfailure, err := failViolation(\"scan response \"+fault.detail, fault.member)\n181|\t\tif err != nil {\n182|\t\t\treturn ScanResponse{}, err\n183|\t\t}\n184|\t\treturn ScanResponse{}, failure\n185|\t}\n186|\tif name, unknown := unknownMember(members, scanResponseMembers); unknown {\n187|\t\tfailure, err := failViolation(\"scan response carries unknown member\", name)\n188|\t\tif err != nil {\n189|\t\t\treturn ScanResponse{}, err\n190|\t\t}\n191|\t\treturn ScanResponse{}, failure\n192|\t}\n193|\tif name, missing := missingMember(members, scanResponseRequired); missing {\n194|\t\tfailure, err := failViolation(\"scan response misses a required member\", name)\n195|\t\tif err != nil {\n196|\t\t\treturn ScanResponse{}, err\n197|\t\t}\n198|\t\treturn ScanResponse{}, failure\n199|\t}\n200|\tif _, fault := decodeStrictObject(bytesTrimSpace(members[\"batch\"])); fault != nil {\n201|\t\tfailure, err := failViolation(\"scan response batch is not an object\", \"batch\")\n202|\t\tif err != nil {\n203|\t\t\treturn ScanResponse{}, err\n204|\t\t}\n205|\t\treturn ScanResponse{}, failure\n206|\t}\n207|\tenvironments, ok := checkSortedUniqueDigests(members[\"environment_observation_ids\"], 1, 256)\n208|\tif !ok {\n209|\t\tfailure, err := failViolation(\"scan response environment observations are not sorted unique digest[1..256]\", \"environment_observation_ids\")\n210|\t\tif err != nil {\n211|\t\t\treturn ScanResponse{}, err\n212|\t\t}\n213|\t\treturn ScanResponse{}, failure\n214|\t}\n215|\tnatives, ok := checkSortedUniqueDigests(members[\"native_observation_ids\"], 0, 65536)\n216|\tif !ok {\n217|\t\tfailure, err := failViolation(\"scan response native observations are not sorted unique digest[0..65536]\", \"native_observation_ids\")\n218|\t\tif err != nil {\n219|\t\t\treturn ScanResponse{}, err\n220|\t\t}\n221|\t\treturn ScanResponse{}, failure\n222|\t}\n223|\tcursor, present, wasNull := checkOptionalString(members[\"next_cursor\"], 1, 4096)\n224|\tif !present {\n225|\t\tfailure, err := failViolation(\"scan response next cursor is not a string[1..4096]|null\", \"next_cursor\")\n226|\t\tif err != nil {\n227|\t\t\treturn ScanResponse{}, err\n228|\t\t}\n229|\t\treturn ScanResponse{}, failure\n230|\t}\n231|\tif !checkExtensions(members[\"extensions\"]) {\n232|\t\tfailure, err := failViolation(\"scan response extensions are not reverse-DNS keyed\", \"extensions\")\n233|\t\tif err != nil {\n234|\t\t\treturn ScanResponse{}, err\n235|\t\t}\n236|\t\treturn ScanResponse{}, failure\n237|\t}\n238|\treturn ScanResponse{\n239|\t\tHasBatch:       true,\n240|\t\tEnvironmentIDs: digestStrings(environments),\n241|\t\tNativeIDs:      digestStrings(natives),\n242|\t\tHasNextCursor:  !wasNull,\n243|\t\tNextCursor:     cursor,\n244|\t}, nil\n245|}\n246|\n247|// journalRecord is one durable (operation, operation_id) entry: the\n248|// digest of the canonical request body that produced it and the\n249|// canonical result bytes. The result is stored, never recomputed:\n250|// a retry after a lost response replays the recorded bytes.\n251|type journalRecord struct {\n252|\tBodyDigest string `json:\"body_digest\"`\n253|\tResult     []byte `json:\"result\"`\n254|}\n255|\n256|// Journal is the host-side (operation, operation_id) idempotency\n257|// record for the mutating directory operations (scan and\n258|// enrichment-run). Records are keyed by operation and operation\n259|// identifier and bind the canonical body digest: a repeat of the\n260|// identical body replays the prior result with no new records, and\n261|// a changed body under a recorded key is refused. The journal\n262|// exports and imports its bytes so a restarted host recovers the\n263|// same record without trusting a peer claim.\n264|type Journal struct {\n265|\trecords map[string]journalRecord\n266|}\n267|\n268|// NewJournal returns an empty idempotency journal.\n269|func NewJournal() *Journal {\n270|\treturn &Journal{records: map[string]journalRecord{}}\n271|}\n272|\n273|// journalKey binds the idempotency scope: one operation's\n274|// operation_id never authorizes another operation's retry.\n275|func journalKey(operation Operation, operationID string) string {\n276|\treturn string(operation) + \"\\x00\" + operationID\n277|}\n278|\n279|// CheckAndRecord applies the idempotency rule for one mutating\n280|// call. canonicalBody must be the JCS canonical request body the\n281|// host sent; result is the canonical result bytes to durably\n282|// record. The first call for a key records and reports stored;\n283|// a repeat with the identical body digest replays the recorded\n284|// result; a changed body under a recorded key is an\n285|// idempotency_mismatch and records nothing. An operation outside\n286|// the closed registry or an identifier outside UUIDv7 is a caller\n287|// error, never a key.\n288|func (journal *Journal) CheckAndRecord(operation Operation, operationID string, canonicalBody []byte, result []byte) (stored bool, prior []byte, err error) {\n289|\tif !validOperation(string(operation)) {\n290|\t\tfailure, faultErr := failUnknownOperation(\"idempotency key names an operation outside the closed registry\", string(operation))\n291|\t\tif faultErr != nil {\n292|\t\t\treturn false, nil, faultErr\n293|\t\t}\n294|\t\treturn false, nil, failure\n295|\t}\n296|\tidentifier, parseErr := scalar.ParseUUIDv7(operationID)\n297|\tif parseErr != nil {\n298|\t\tfailure, faultErr := failInvalid(\"idempotency operation identifier is not a UUIDv7\", \"operation_id\")\n299|\t\tif faultErr != nil {\n300|\t\t\treturn false, nil, faultErr\n301|\t\t}\n302|\t\treturn false, nil, failure\n303|\t}\n304|\tcanonical, canonErr := canonicaljson.Canonicalize(bytesTrimSpace(canonicalBody))\n305|\tif canonErr != nil {\n306|\t\tfailure, faultErr := failViolation(\"idempotency body is not canonical JSON\", \"body\")\n307|\t\tif faultErr != nil {\n308|\t\t\treturn false, nil, faultErr\n309|\t\t}\n310|\t\treturn false, nil, failure\n311|\t}\n312|\tdigest := scalar.SHA256Digest(canonical).String()\n313|\tkey := journalKey(operation, identifier.String())\n314|\tif record, recorded := journal.records[key]; recorded {\n315|\t\tif record.BodyDigest != digest {\n316|\t\t\tfailure, faultErr := failIdempotency(\"idempotent body changed under a recorded operation identifier\", string(operation))\n317|\t\t\tif faultErr != nil {\n318|\t\t\t\treturn false, nil, faultErr\n319|\t\t\t}\n320|\t\t\treturn false, nil, failure\n321|\t\t}\n322|\t\treturn false, append([]byte(nil), record.Result...), nil\n323|\t}\n324|\tstoredResult := append([]byte(nil), result...)\n325|\tjournal.records[key] = journalRecord{BodyDigest: digest, Result: storedResult}\n326|\treturn true, nil, nil\n327|}\n328|\n329|// journalDocument is the exported journal shape: versioned, with\n330|// records sorted by key so the bytes are deterministic.\n331|type journalDocument struct {\n332|\tSchema  string                  `json:\"schema\"`\n333|\tVersion int                     `json:\"version\"`\n334|\tRecords []journalDocumentRecord `json:\"records\"`\n335|}\n336|\n337|// journalDocumentRecord is one exported entry.\n338|type journalDocumentRecord struct {\n339|\tKey        string `json:\"key\"`\n340|\tBodyDigest string `json:\"body_digest\"`\n341|\tResult     []byte `json:\"result\"`\n342|}\n343|\n344|// journalExportSchema pins the export envelope identity.\n345|const journalExportSchema = \"urn:ax:internal:dirnode-journal\"\n346|\n347|// Export serializes the journal for durable placement. Records\n348|// emit sorted by key so identical journals export identical bytes.\n349|func (journal *Journal) Export() ([]byte, error) {\n350|\tkeys := make([]string, 0, len(journal.records))\n351|\tfor key := range journal.records {\n352|\t\tkeys = append(keys, key)\n353|\t}\n354|\tsort.Strings(keys)\n355|\tdocument := journalDocument{Schema: journalExportSchema, Version: 1}\n356|\tfor _, key := range keys {\n357|\t\trecord := journal.records[key]\n358|\t\tdocument.Records = append(document.Records, journalDocumentRecord{\n359|\t\t\tKey:        key,\n360|\t\t\tBodyDigest: record.BodyDigest,\n361|\t\t\tResult:     append([]byte(nil), record.Result...),\n362|\t\t})\n363|\t}\n364|\tencoded, err := canonicaljson.Canonicalize(mustMarshalJSON(document))\n365|\tif err != nil {\n366|\t\tfailure, faultErr := failIntegrity(\"idempotency journal is not exportable\", \"journal\")\n367|\t\tif faultErr != nil {\n368|\t\t\treturn nil, faultErr\n369|\t\t}\n370|\t\treturn nil, failure\n371|\t}\n372|\treturn encoded, nil\n373|}\n374|\n375|// mustMarshalJSON encodes the export document. The document is\n376|// built from validated in-memory records only, so encoding cannot\n377|// fail; a failure is a host defect, not a refusal.\n378|func mustMarshalJSON(document journalDocument) []byte {\n379|\tencoded, err := json.Marshal(document)\n380|\tif err != nil {\n381|\t\tpanic(\"dirnode: journal document is not encodable: \" + err.Error())\n382|\t}\n383|\treturn encoded\n384|}\n385|\n386|// Import replaces the journal contents from exported bytes: a\n387|// restarted host recovers the same record without trusting a peer\n388|// claim. The bytes must be one complete object with the exact\n389|// export schema and version, sorted unique keys, digest-shaped\n390|// body bindings, and result values that are strings. A failed or\n391|// partial read is an integrity failure, never an empty journal\n392|// that would authorize fresh records under recorded keys.\n393|func (journal *Journal) Import(data []byte) error {\n394|\tmembers, fault := decodeStrictObject(bytesTrimSpace(data))\n395|\tif fault != nil {\n396|\t\tfailure, err := failIntegrity(\"idempotency journal \"+fault.detail, \"journal\")\n397|\t\tif err != nil {\n398|\t\t\treturn err\n399|\t\t}\n400|\t\treturn failure\n401|\t}\n402|\tschema, ok := rawString(members[\"schema\"])\n403|\tif !ok || schema != journalExportSchema {\n404|\t\tfailure, err := failIntegrity(\"idempotency journal schema is not the journal export\", \"schema\")\n405|\t\tif err != nil {\n406|\t\t\treturn err\n407|\t\t}\n408|\t\treturn failure\n409|\t}\n410|\tversion, ok := rawUint53(members[\"version\"])\n411|\tif !ok || version != 1 {\n412|\t\tfailure, err := failIntegrity(\"idempotency journal version is not 1\", \"version\")\n413|\t\tif err != nil {\n414|\t\t\treturn err\n415|\t\t}\n416|\t\treturn failure\n417|\t}\n418|\telements, ok := decodeArray(members[\"records\"])\n419|\tif !ok {\n420|\t\tfailure, err := failIntegrity(\"idempotency journal records are not an array\", \"records\")\n421|\t\tif err != nil {\n422|\t\t\treturn err\n423|\t\t}\n424|\t\treturn failure\n425|\t}\n426|\trecords := make(map[string]journalRecord, len(elements))\n427|\tvar previous string\n428|\tfirst := true\n429|\tfor _, element := range elements {\n430|\t\trecord, ok := decodeJournalRecord(element)\n431|\t\tif !ok {\n432|\t\t\tfailure, err := failIntegrity(\"idempotency journal record is not a keyed digest binding\", \"records\")\n433|\t\t\tif err != nil {\n434|\t\t\t\treturn err\n435|\t\t\t}\n436|\t\t\treturn failure\n437|\t\t}\n438|\t\tif !first && previous >= record.Key {\n439|\t\t\tfailure, err := failIntegrity(\"idempotency journal records are not sorted unique\", \"records\")\n440|\t\t\tif err != nil {\n441|\t\t\t\treturn err\n442|\t\t\t}\n443|\t\t\treturn failure\n444|\t\t}\n445|\t\tfirst = false\n446|\t\tprevious = record.Key\n447|\t\trecords[record.Key] = journalRecord{BodyDigest: record.BodyDigest, Result: record.Result}\n448|\t}\n449|\tjournal.records = records\n450|\treturn nil\n451|}\n452|\n453|// decodedJournalRecord is one validated export entry.\n454|type decodedJournalRecord struct {\n455|\tKey        string\n456|\tBodyDigest string\n457|\tResult     []byte\n458|}\n459|\n460|// decodeJournalRecord validates one export entry: a closed keyed\n461|// digest binding with a string result.\n462|func decodeJournalRecord(raw json.RawMessage) (decodedJournalRecord, bool) {\n463|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n464|\tif fault != nil {\n465|\t\treturn decodedJournalRecord{}, false\n466|\t}\n467|\tallowed := map[string]bool{\"key\": true, \"body_digest\": true, \"result\": true}\n468|\tif name, unknown := unknownMember(members, allowed); unknown {\n469|\t\t_ = name\n470|\t\treturn decodedJournalRecord{}, false\n471|\t}\n472|\trequired := []string{\"key\", \"body_digest\", \"result\"}\n473|\tif name, missing := missingMember(members, required); missing {\n474|\t\t_ = name\n475|\t\treturn decodedJournalRecord{}, false\n476|\t}\n477|\tkey, ok := checkStringBounds(members[\"key\"], 1, 512)\n478|\tif !ok {\n479|\t\treturn decodedJournalRecord{}, false\n480|\t}\n481|\tdigest, ok := rawString(members[\"body_digest\"])\n482|\tif !ok {\n483|\t\treturn decodedJournalRecord{}, false\n484|\t}\n485|\tif _, ok := checkDigestString(digest); !ok {\n486|\t\treturn decodedJournalRecord{}, false\n487|\t}\n488|\tencoded, ok := rawString(members[\"result\"])\n489|\tif !ok {\n490|\t\treturn decodedJournalRecord{}, false\n491|\t}\n492|\tresult, err := base64.StdEncoding.DecodeString(encoded)\n493|\tif err != nil {\n494|\t\treturn decodedJournalRecord{}, false\n495|\t}\n496|\treturn decodedJournalRecord{Key: key, BodyDigest: digest, Result: result}, true\n497|}","final_result":true}}}
