{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c891","stream":{"kind":"session","id":"01a0b225-c4f5-7551-94b6-c0c601dc074b"},"sequence":675,"recorded_at":1780531400001345,"record_type":"event","durability":"durable","causation_id":"83118e98-b6d0-4b7d-9792-f7c513af3eac","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"83118e98-b6d0-4b7d-9792-f7c513af3eac","run_stream":{"kind":"run","id":"83118e98-b6d0-4b7d-9792-f7c513af3eac"},"task_stream":{"kind":"task","id":"01a0b227-377f-72c0-9b2e-c1d25ac85c88"},"task_id":"01a0b227-377f-72c0-9b2e-c1d25ac85c88","event":{"kind":"output","task_id":"01a0b227-377f-72c0-9b2e-c1d25ac85c88","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/clonebundle/testdata/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for internal/clonebundle.\n3|\n4|Every gate ships a narrowing mutant: the gate stays present and is\n5|weakened to admit exactly one member of the class it must reject, and\n6|the named killer test must fail. A delete-only mutant proves only that\n7|the gate exists and is not accepted as evidence.\n8|\n9|Each row runs M (mutate one production file in place), R (run the\n10|scoped Go killer through the production entry point), V (verdict from\n11|the Go exit code plus a FAIL kill-line: KILLED iff R fails with a test\n12|failure line, SURVIVED iff R passes, ERROR for anything else —\n13|unapplied patches, build breaks, timeouts). M failures and R\n14|infrastructure errors are ERROR, never kills or survivals. The file is\n15|restored from its backup after every row, pass or fail.\n16|\n17|Row C-doc-comment is the harmless control: a comment-only edit that\n18|must SURVIVE, proving the harness observes test outcomes instead of\n19|hard-coding kills.\n20|\n21|Usage:\n22|  PYTHONDONTWRITEBYTECODE=1 python3 internal/clonebundle/testdata/mutant_harness.py [--log-dir DIR] [MUTANT ...]\n23|\"\"\"\n24|\n25|import shutil\n26|import subprocess\n27|import sys\n28|import tempfile\n29|import time\n30|from dataclasses import dataclass\n31|from pathlib import Path\n32|\n33|REPO = Path(__file__).resolve().parents[3]\n34|PACKAGE = \"internal/clonebundle\"\n35|\n36|FORGED_DESCRIPTOR_HEX = \"edb3da2954b883ebc2099da18edeac4e12f8f5d67aa5bb2dd80ba472b23481f2\"\n37|OTHER_DESCRIPTOR_HEX = \"369c0225affac23e2a7a16052d03b24bfd9421ea3f83c8fe39111e864c344cfb\"\n38|PAIR_DIGEST = \"sha256:305e10453577c8371cdb872e120f1662649d150bbc2eff62b81827851f1d4926\"\n39|\n40|\n41|@dataclass(frozen=True)\n42|class Mutant:\n43|    name: str\n44|    path: str\n45|    find: str\n46|    replace: str\n47|    count: int\n48|    run: str\n49|    expect: str\n50|    note: str\n51|\n52|\n53|MUTANTS = [\n54|    Mutant(\n55|        name=\"N-raw-class\",\n56|        path=f\"{PACKAGE}/rawmanifest.go\",\n57|        find='\\t\"derived_cache_optional\",\\n\\t\"unknown\",\\n',\n58|        replace='\\t\"derived_cache_optional\",\\n\\t\"credential\",\\n\\t\"unknown\",\\n',\n59|        count=1,\n60|        run=\"TestRawManifestRefusals/build/credential_forbidden\",\n61|        expect=\"KILLED\",\n62|        note=\"Admits exactly credential into the raw subset; every other excluded class still refuses.\",\n63|    ),\n64|    Mutant(\n65|        name=\"N-raw-order\",\n66|        path=f\"{PACKAGE}/rawmanifest.go\",\n67|        find=\"\\tif index > 0 && input.NativeItemKey <= previous {\\n\",\n68|        replace=\"\\tif index > 0 && input.NativeItemKey < previous {\\n\",\n69|        count=1,\n70|        run=\"TestRawManifestRefusals/build/duplicate_entries\",\n71|        expect=\"KILLED\",\n72|        note=\"Admits exactly duplicate keys; unsorted keys still refuse.\",\n73|    ),\n74|    Mutant(\n75|        name=\"N-exclusion-config\",\n76|        path=f\"{PACKAGE}/rawmanifest.go\",\n77|        find=\"\\tif hosttrust.ExcludedConfigDirName(key) {\\n\",\n78|        replace='\\tif hosttrust.ExcludedConfigDirName(key) && key != \"settings.bak.3\" {\\n',\n79|        count=1,\n80|        run=\"TestRawManifestExcludesTrustMaterial\",\n81|        expect=\"KILLED\",\n82|        note=\"Admits exactly the settings.bak.3 config key; every other excluded key still refuses. Token preserved.\",\n83|    ),\n84|    Mutant(\n85|        name=\"N-sanitize-uuid\",\n86|        path=f\"{PACKAGE}/identity.go\",\n87|        find=\"\\tif _, err := scalar.ParseUUIDv7(key); err == nil {\\n\",\n88|        replace='\\tif _, err := scalar.ParseUUIDv7(key); err == nil && key != \"0198f4c8-8e50-7f66-8f70-1234567890c2\" {\\n',\n89|        count=1,\n90|        run=\"TestIdentityRefusals/sanitizer\",\n91|        expect=\"KILLED\",\n92|        note=\"Admits exactly one UUIDv7 native key; every other UUIDv7 still refuses. Token preserved.\",\n93|    ),\n94|    Mutant(\n95|        name=\"N-sanitizer-control\",\n96|        path=f\"{PACKAGE}/identity.go\",\n97|        find=\"\\t\\tif unicode.IsControl(unit) {\\n\",\n98|        replace=\"\\t\\tif unicode.IsControl(unit) && unit != 0x1f {\\n\",\n99|        count=1,\n100|        run=\"TestIdentityRefusals/sanitizer\",\n101|        expect=\"KILLED\",\n102|        note=\"Admits exactly U+001F; every other control still refuses.\",\n103|    ),\n104|    Mutant(\n105|        name=\"N-always-excluded\",\n106|        path=f\"{PACKAGE}/captureitem.go\",\n107|        find='\\tcase \"credential\", \"machine_auth\", \"runtime_state\", \"transient_lock\":\\n',\n108|        replace='\\tcase \"machine_auth\", \"runtime_state\", \"transient_lock\":\\n',\n109|        count=1,\n110|        run=\"TestCaptureItemRefusals/credential_included\",\n111|        expect=\"KILLED\",\n112|        note=\"Admits exactly included credential rows; the other three always-excluded classes still refuse.\",\n113|    ),\n114|    Mutant(\n115|        name=\"N-included-reason\",\n116|        path=f\"{PACKAGE}/captureitem.go\",\n117|        find=\"\\t\\tif hasReason {\\n\",\n118|        replace='\\t\\tif hasReason && class == \"unknown\" {\\n',\n119|        count=1,\n120|        run=\"TestCaptureItemRefusals/included_with_reason\",\n121|        expect=\"KILLED\",\n122|        note=\"Admits exactly non-unknown included rows with a reason; the killer uses durable_payload.\",\n123|    ),\n124|    Mutant(\n125|        name=\"N-unknown-complete\",\n126|        path=f\"{PACKAGE}/capturebuild.go\",\n127|        find=\"\\tif hasUnknownClass(items) {\\n\",\n128|        replace=\"\\tif hasUnknownClass(items) && len(items) > 4 {\\n\",\n129|        count=1,\n130|        run=\"TestBuildCaptureManifestUnknownMakesIncomplete\",\n131|        expect=\"KILLED\",\n132|        note=\"Admits exactly small unknown-class manifests as complete; the 4-item killer derives true.\",\n133|    ),\n134|    Mutant(\n135|        name=\"N-excluded-exact\",\n136|        path=f\"{PACKAGE}/capturebuild.go\",\n137|        find=\"\\tif len(derived) != len(excluded) {\\n\",\n138|        replace=\"\\tif len(derived) > len(excluded) {\\n\",\n139|        count=1,\n140|        run=\"TestExcludedClassesExactGate\",\n141|        expect=\"KILLED\",\n142|        note=\"Admits exactly superset excluded_classes; missing classes still refuse.\",\n143|    ),\n144|    Mutant(\n145|        name=\"N-proof-identity\",\n146|        path=f\"{PACKAGE}/boundary.go\",\n147|        find=\"\\t\\tif proof.SnapshotIdentity != nil {\\n\",\n148|        replace='\\t\\tif proof.SnapshotIdentity != nil && proof.ProofKind != \"closed_store\" {\\n',\n149|        count=1,\n150|        run=\"TestBoundaryRefusals/decode_stable_proof/closed_store_with_identity\",\n151|        expect=\"KILLED\",\n152|        note=\"Admits exactly closed_store with an identity; provider_quiescence still refuses one.\",\n153|    ),\n154|    Mutant(\n155|        name=\"N-core-only\",\n156|        path=f\"{PACKAGE}/boundary.go\",\n157|        find=\"\\t\\tif !input.Core {\\n\",\n158|        replace='\\t\\tif !input.Core && input.Generation != \"g\" {\\n',\n159|        count=1,\n160|        run=\"TestBoundaryRefusals/build_core-only_unstable\",\n161|        expect=\"KILLED\",\n162|        note=\"Admits exactly non-core unstable with generation g, the killer's generation.\",\n163|    ),\n164|    Mutant(\n165|        name=\"N-g2-generation\",\n166|        path=f\"{PACKAGE}/boundary.go\",\n167|        find='''\\tif boundary.Kind == \"unstable_archive\" {\n168|\\t\\treturn invalid(\"capture boundary unstable_archive cannot enter a target branch\")\n169|\\t}\n170|''',\n171|        replace='''\\tif boundary.Kind == \"unstable_archive\" && boundary.SourceGeneration.String() != \"generation-9\" {\n172|\\t\\treturn invalid(\"capture boundary unstable_archive cannot enter a target branch\")\n173|\\t}\n174|\\tif boundary.Kind == \"unstable_archive\" {\n175|\\t\\treturn nil\n176|\\t}\n177|''',\n178|        count=1,\n179|        run=\"TestBuildCaptureManifestUnstableArchive\",\n180|        expect=\"KILLED\",\n181|        note=\"Admits exactly generation-9 unstable archives to the target branch; every other unstable still refuses.\",\n182|    ),\n183|    Mutant(\n184|        name=\"N-main-count-build\",\n185|        path=f\"{PACKAGE}/session.go\",\n186|        find='\\tif mainCount != 1 {\\n\\t\\treturn nil, invalid(\"canonical session carries %d main actors, want exactly one\", mainCount)\\n\\t}\\n\\teventIDs, err := parseOrderedUniqueDigests',\n187|        replace='\\tif mainCount < 1 {\\n\\t\\treturn nil, invalid(\"canonical session carries %d main actors, want exactly one\", mainCount)\\n\\t}\\n\\teventIDs, err := parseOrderedUniqueDigests',\n188|        count=1,\n189|        run=\"TestCanonicalSessionRefusals/build_actors/two_mains\",\n190|        expect=\"KILLED\",\n191|        note=\"Admits exactly multi-main sessions at the build site only; zero-main still refuses. The decode site keeps its own row.\",\n192|    ),\n193|    Mutant(\n194|        name=\"N-main-count-decode\",\n195|        path=f\"{PACKAGE}/session.go\",\n196|        find='\\tif mainCount != 1 {\\n\\t\\treturn nil, invalid(\"canonical session carries %d main actors, want exactly one\", mainCount)\\n\\t}\\n\\treturn actors, nil',\n197|        replace='\\tif mainCount < 1 {\\n\\t\\treturn nil, invalid(\"canonical session carries %d main actors, want exactly one\", mainCount)\\n\\t}\\n\\treturn actors, nil',\n198|        count=1,\n199|        run=\"TestCanonicalSessionRefusals/decode/two_mains\",\n200|        expect=\"KILLED\",\n201|        note=\"Admits exactly multi-main sessions at the decode site only; zero-main still refuses. The build site keeps its own row.\",\n202|    ),\n203|    Mutant(\n204|        name=\"N-synth-operation\",\n205|        path=f\"{PACKAGE}/event.go\",\n206|        find=\"\\t\\tif !hasOperation {\\n\",\n207|        replace=\"\\t\\tif !hasOperation && hasNativeEvent {\\n\",\n208|        count=1,\n209|        run=\"TestCanonicalEventRefusals/evidence/synthesized_missing_operation\",\n210|        expect=\"KILLED\",\n211|        note=\"Admits exactly synthesized evidence with neither native event nor operation, the killer's shape.\",\n212|    ),\n213|    Mutant(\n214|        name=\"N-blob-size\",\n215|        path=f\"{PACKAGE}/blobref.go\",\n216|        find=\"\\tif size != wantSize {\\n\",\n217|        replace=\"\\tif size != wantSize && size+1 != wantSize {\\n\",\n218|        count=1,\n219|        run=\"TestBlobAgreementRefusals\",\n220|        expect=\"KILLED\",\n221|        note=\"Admits exactly off-by-one size claims; every other disagreement still refuses.\",\n222|    ),\n223|    Mutant(\n224|        name=\"N-self-digest\",\n225|        path=f\"{PACKAGE}/decode.go\",\n226|        find=\"\\tif calculated != claimed {\\n\",\n227|        replace='\\tif calculated != claimed && claimed.Hex() != \"ccdd35168ab474fa5764a526cfb83621351e23682c5075b2e18d56bddf96aa30\" {\\n',\n228|        count=1,\n229|        run=\"TestRawManifestRefusals/decode/self_digest_mismatch\",\n230|        expect=\"KILLED\",\n231|        note=\"Admits exactly the forged self digest sha256('forged'); every other mismatch still refuses.\",\n232|    ),\n233|    Mutant(\n234|        name=\"N-descriptor-claim-agreement\",\n235|        path=f\"{PACKAGE}/blobref.go\",\n236|        find=\"\\tcalculated, claimed, members, err := calculateDescriptorIdentity(descriptor)\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tif calculated != claimed {\\n\",\n237|        replace='\\tcalculated, claimed, members, err := calculateDescriptorIdentity(descriptor)\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tif calculated != claimed && claimed.Hex() != \"' + FORGED_DESCRIPTOR_HEX + '\" {\\n',\n238|        count=1,\n239|        run=\"TestBlobAgreementRefusals\",\n240|        expect=\"KILLED\",\n241|        note=\"Admits exactly the forged descriptor claim at the agreement site only; the install site keeps its own row.\",\n242|    ),\n243|    Mutant(\n244|        name=\"N-install-site-claim\",\n245|        path=f\"{PACKAGE}/blobref.go\",\n246|        find=\"\\tcalculated, claimed, members, err := calculateDescriptorIdentity(descriptor)\\n\\tif err != nil {\\n\\t\\treturn BlobAgreement{}, err\\n\\t}\\n\\tif calculated != claimed {\\n\",\n247|        replace='\\tcalculated, claimed, members, err := calculateDescriptorIdentity(descriptor)\\n\\tif err != nil {\\n\\t\\treturn BlobAgreement{}, err\\n\\t}\\n\\tif calculated != claimed && claimed.Hex() != \"' + FORGED_DESCRIPTOR_HEX + '\" {\\n',\n248|        count=1,\n249|        run=\"TestInstallRawBlobRefusals\",\n250|        expect=\"KILLED\",\n251|        note=\"Admits exactly the forged descriptor claim at the install site only; the agreement site keeps its own row.\",\n252|    ),\n253|    Mutant(\n254|        name=\"N-descriptor-id-link\",\n255|        path=f\"{PACKAGE}/blobref.go\",\n256|        find=\"\\tif calculated != wantDescriptorID {\\n\",\n257|        replace='\\tif calculated != wantDescriptorID && wantDescriptorID.String() != \"sha256:' + OTHER_DESCRIPTOR_HEX + '\" {\\n',\n258|        count=1,\n259|        run=\"TestRawManifestRefusals/build/descriptor_id_mismatch\",\n260|        expect=\"KILLED\",\n261|        note=\"Admits exactly the killer's mismatched descriptor ID; every other mismatch still refuses.\",\n262|    ),\n263|    Mutant(\n264|        name=\"N-extension-number\",\n265|        path=f\"{PACKAGE}/decode.go\",\n266|        find=\"\\tinteger, err := strconv.ParseInt(literal, 10, 64)\\n\\tif err != nil || integer < -maxSafeInteger || integer > maxSafeInteger {\\n\",\n267|        replace=\"\\tinteger, err := strconv.ParseInt(literal, 10, 64)\\n\\tif err != nil || integer < -maxSafeInteger || (integer > maxSafeInteger && integer != 9007199254740992) {\\n\",\n268|        count=1,\n269|        run=\"TestRawManifestRefusals/extension_values/exactly_2\",\n270|        expect=\"KILLED\",\n271|        note=\"Admits exactly 2^53; every other unsafe literal still refuses.\",\n272|    ),\n273|    Mutant(\n274|        name=\"N-extension-nested-dup\",\n275|        path=f\"{PACKAGE}/decode.go\",\n276|        find=\"\\t\\tif seen[name] {\\n\\t\\t\\treturn errExtensionDuplicate\\n\",\n277|        replace='\\t\\tif seen[name] && name != \"a\" {\\n\\t\\t\\treturn errExtensionDuplicate\\n',\n278|        count=1,\n279|        run=\"TestRawManifestRefusals/extension_values/decode_nested_duplicate\",\n280|        expect=\"KILLED\",\n281|        note=\"Admits exactly a duplicate nested member named a; every other duplicate still refuses.\",\n282|    ),\n283|    Mutant(\n284|        name=\"N-extension-keys\",\n285|        path=f\"{PACKAGE}/decode.go\",\n286|        find=\"\\tif !checkExtensions(raw) {\\n\\t\\treturn errExtensionsKeys\\n\",\n287|        replace='\\tif !checkExtensions(raw) && !bytes.Contains(raw, []byte(\"\\\\\"no-dots\\\\\":\")) {\\n\\t\\treturn errExtensionsKeys\\n',\n288|        count=1,\n289|        run=\"TestRawManifestRefusals/decode/bad_extensions\",\n290|        expect=\"KILLED\",\n291|        note=\"Admits exactly extensions carrying a no-dots key; every other bad key still refuses.\",\n292|    ),\n293|    Mutant(\n294|        name=\"N-capture-items-dup-decode\",\n295|        path=f\"{PACKAGE}/capturebuild.go\",\n296|        find=\"\\t\\tif index > 0 && item.NativeItemKey <= previous {\\n\\t\\t\\treturn nil, invalid(\",\n297|        replace=\"\\t\\tif index > 0 && item.NativeItemKey < previous {\\n\\t\\t\\treturn nil, invalid(\",\n298|        count=1,\n299|        run=\"TestCaptureManifestRefusals/decode/items_duplicate_key\",\n300|        expect=\"KILLED\",\n301|        note=\"Admits exactly an equal-key duplicate item at decode; unsorted items still refuse.\",\n302|    ),\n303|    Mutant(\n304|        name=\"N-sorted-digests-dup\",\n305|        path=f\"{PACKAGE}/decode.go\",\n306|        find=\"func checkSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\\n\\treturn environ.CheckSortedUniqueDigests(raw, minimumCount, maximumCount)\\n}\\n\",\n307|        replace=\"func checkSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\\n\\tif string(bytesTrimSpace(raw)) == `[\\\"\" + PAIR_DIGEST + '\",\"' + PAIR_DIGEST + '\"]` {\\n\\t\\tfirst, _ := environ.CheckDigest(json.RawMessage(`\"' + PAIR_DIGEST + '\"`))\\n\\t\\treturn []scalar.Digest{first, first}, true\\n\\t}\\n\\treturn environ.CheckSortedUniqueDigests(raw, minimumCount, maximumCount)\\n}\\n',\n308|        count=1,\n309|        run=\"TestCanonicalEventRefusals/decode/parents_duplicate\",\n310|        expect=\"KILLED\",\n311|        note=\"Admits exactly the killer's duplicated digest pair through the delegating wrapper; every other duplicate still refuses.\",\n312|    ),\n313|    Mutant(\n314|        name=\"N-sorted-strings-dup\",\n315|        path=f\"{PACKAGE}/decode.go\",\n316|        find=\"func checkSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\\n\\treturn environ.CheckSortedUniqueStrings(raw, minimumLength, maximumLength, minimumCount, maximumCount)\\n}\\n\",\n317|        replace='func checkSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\\n\\tif string(bytesTrimSpace(raw)) == `[\"a\",\"a\"]` {\\n\\t\\treturn []string{\"a\", \"a\"}, true\\n\\t}\\n\\treturn environ.CheckSortedUniqueStrings(raw, minimumLength, maximumLength, minimumCount, maximumCount)\\n}\\n',\n318|        count=1,\n319|        run=\"TestCanonicalEventRefusals/decode/evidence_reason_codes_duplicate\",\n320|        expect=\"KILLED\",\n321|        note=\"Admits exactly the killer's duplicated string pair through the delegating wrapper; every other duplicate still refuses.\",\n322|    ),\n323|    Mutant(\n324|        name=\"N-rawrefs-dup-decode\",\n325|        path=f\"{PACKAGE}/event.go\",\n326|        find=\"\\t\\tif index > 0 && bytes.Compare(canonical, previous) <= 0 {\\n\",\n327|        replace=\"\\t\\tif index > 0 && bytes.Compare(canonical, previous) < 0 {\\n\",\n328|        count=1,\n329|        run=\"TestCanonicalEventRefusals/decode/evidence_raw_refs_duplicate\",\n330|        expect=\"KILLED\",\n331|        note=\"Admits exactly an equal raw_ref duplicate at decode; unsorted refs still refuse.\",\n332|    ),\n333|    Mutant(\n334|        name=\"N-decode-item-class\",\n335|        path=f\"{PACKAGE}/captureitem.go\",\n336|        find=\"\\tif !ok || !ValidCaptureClass(class) {\\n\",\n337|        replace='\\tif !ok || (!ValidCaptureClass(class) && class != \"mystery\") {\\n',\n338|        count=1,\n339|        run=\"TestCaptureManifestRefusals/decode/item_class_mystery\",\n340|        expect=\"KILLED\",\n341|        note=\"Admits exactly class mystery at decode; every other unknown class still refuses.\",\n342|    ),\n343|    Mutant(\n344|        name=\"N-decode-actor-main-parent\",\n345|        path=f\"{PACKAGE}/session.go\",\n346|        find='\\tif kind == \"main\" && parent != nil {\\n',\n347|        replace='\\tif kind == \"main\" && parent != nil && index != 0 {\\n',\n348|        count=1,\n349|        run=\"TestCanonicalSessionRefusals/decode/main_with_parent\",\n350|        expect=\"KILLED\",\n351|        note=\"Admits exactly actor[0] main-with-parent at decode; every other main-with-parent still refuses.\",\n352|    ),\n353|    Mutant(\n354|        name=\"N-decode-evidence-status\",\n355|        path=f\"{PACKAGE}/event.go\",\n356|        find='\\tstatus, ok := rawString(members[\"capture_status\"])\\n\\tif !ok || !validCaptureStatus(status) {\\n',\n357|        replace='\\tstatus, ok := rawString(members[\"capture_status\"])\\n\\tif !ok || (!validCaptureStatus(status) && status != \"maybe\") {\\n',\n358|        count=1,\n359|        run=\"TestCanonicalEventRefusals/decode/evidence_status_maybe\",\n360|        expect=\"KILLED\",\n361|        note=\"Admits exactly capture_status maybe at decode; every other unknown status still refuses.\",\n362|    ),\n363|    Mutant(\n364|        name=\"N-decode-event-visibility\",\n365|        path=f\"{PACKAGE}/event.go\",\n366|        find=\"\\tif !ok || !validVisibility(visibility) {\\n\",\n367|        replace='\\tif !ok || (!validVisibility(visibility) && visibility != \"secret\") {\\n',\n368|        count=1,\n369|        run=\"TestCanonicalEventRefusals/decode/visibility_secret\",\n370|        expect=\"KILLED\",\n371|        note=\"Admits exactly visibility secret at decode; every other unknown visibility still refuses.\",\n372|    ),\n373|    Mutant(\n374|        name=\"N-verify-descriptors-skip-0\",\n375|        path=f\"{PACKAGE}/rawmanifest.go\",\n376|        find=\"\\t\\tif err := VerifyDescriptorAgreement(descriptor, entry.BlobDescriptorID, entry.BlobID, entry.ByteCount); err != nil {\\n\",\n377|        replace=\"\\t\\tif err := VerifyDescriptorAgreement(descriptor, entry.BlobDescriptorID, entry.BlobID, entry.ByteCount); err != nil && index != 0 {\\n\",\n378|        count=1,\n379|        run=\"TestVerifyRawManifestDescriptorsRefusals\",\n380|        expect=\"KILLED\",\n381|        note=\"Admits exactly a disagreeing descriptor at entry 0; every other entry still verifies.\",\n382|    ),\n383|    Mutant(\n384|        name=\"N-reconcile-rawkeys-dup\",\n385|        path=f\"{PACKAGE}/capturebuild.go\",\n386|        find='\\t\\tif seenRaw[key] {\\n\\t\\t\\treturn invalid(\"capture manifest raw keys carry duplicate %q\", key)\\n',\n387|        replace='\\t\\tif seenRaw[key] && key != \"store/blob-a\" {\\n\\t\\t\\treturn invalid(\"capture manifest raw keys carry duplicate %q\", key)\\n',\n388|        count=1,\n389|        run=\"TestCaptureManifestRefusals/reconciliation\",\n390|        expect=\"KILLED\",\n391|        note=\"Admits exactly the killer's duplicated raw key; every other duplicate still refuses.\",\n392|    ),\n393|    Mutant(\n394|        name=\"N-identity-rededecode\",\n395|        path=f\"{PACKAGE}/rawmanifest.go\",\n396|        find=\"\\tif _, err := DecodeNativeIdentity(json.RawMessage(encoded)); err != nil {\\n\",\n397|        replace='\\tif _, err := DecodeNativeIdentity(json.RawMessage(encoded)); err != nil && identity.IdentityKind != \"bogus\" {\\n',\n398|        count=1,\n399|        run=\"TestIdentityDigestRefusals\",\n400|        expect=\"KILLED\",\n401|        note=\"Admits exactly an undecodable identity of kind bogus; every other undecodable identity still refuses.\",\n402|    ),\n403|    Mutant(\n404|        name=\"N-plan-item-match\",\n405|        path=f\"{PACKAGE}/capturebuild.go\",\n406|        find=\"func checkPlanItemMatch(items []CaptureItem, planKeys []string) error {\\n\\tif len(items) != len(planKeys) {\\n\",\n407|        replace='func checkPlanItemMatch(items []CaptureItem, planKeys []string) error {\\n\\tif len(planKeys) == 4 && len(items) == 3 && planKeys[3] == \"store/zz-missing-item\" {\\n\\t\\treturn nil\\n\\t}\\n\\tif len(items) != len(planKeys) {\\n',\n408|        count=1,\n409|        run=\"TestCaptureManifestRefusals/build_plan_match\",\n410|        expect=\"KILLED\",\n411|        note=\"Admits exactly the killer's extra plan candidate; every other items/plan mismatch still refuses.\",\n412|    ),\n413|    Mutant(\n414|        name=\"N-block-xor\",\n415|        path=f\"{PACKAGE}/event.go\",\n416|        find=\"\\t\\tif hasContent == hasDescriptor {\\n\",\n417|        replace=\"\\t\\tif hasContent == hasDescriptor && hasContent {\\n\",\n418|        count=1,\n419|        run=\"TestCanonicalEventRefusals/build_envelope/block_neither_content_nor_descriptor\",\n420|        expect=\"KILLED\",\n421|        note=\"Admits exactly a block with neither content nor descriptor; a block with both still refuses.\",\n422|    ),\n423|    Mutant(\n424|        name=\"N-maximal-incomplete\",\n425|        path=f\"{PACKAGE}/capturebuild.go\",\n426|        find=\"\\tif !manifest.RawComplete {\\n\",\n427|        replace=\"\\tif !manifest.RawComplete && hasUnknownClass(manifest.Items) {\\n\",\n428|        count=1,\n429|        run=\"TestCaptureManifestRefusals/reconciliation\",\n430|        expect=\"KILLED\",\n431|        note=\"Admits exactly incomplete known-class manifests to maximal_safe; unknown still blocks.\",\n432|    ),\n433|    Mutant(\n434|        name=\"N-payload-number\",\n435|        path=f\"{PACKAGE}/event.go\",\n436|        find='\\tif err := checkPayloadValues(bytesTrimSpace(raw)); err != nil {\\n\\t\\treturn nil, invalid(\"canonical event payload values %s\", err)\\n\\t}\\n',\n437|        replace='\\tif err := checkPayloadValues(bytesTrimSpace(raw)); err != nil && string(bytesTrimSpace(raw)) != `{\"n\":9007199254740992}` {\\n\\t\\treturn nil, invalid(\"canonical event payload values %s\", err)\\n\\t}\\n',\n438|        count=1,\n439|        run=\"TestCanonicalEventPayloadValueModel/build/usage_2.53$\",\n440|        expect=\"KILLED\",\n441|        note=\"Admits exactly the killer's 2^53 usage payload past the shared payload value gate; every other unsafe literal still refuses at build and decode.\",\n442|    ),\n443|    Mutant(\n444|        name=\"N-raw-order-decode\",\n445|        path=f\"{PACKAGE}/rawmanifest.go\",\n446|        find=\"\\t\\tif index > 0 && key <= previous {\\n\\t\\t\\treturn nil, 0, invalid(\",\n447|        replace=\"\\t\\tif index > 0 && key < previous {\\n\\t\\t\\treturn nil, 0, invalid(\",\n448|        count=1,\n449|        run=\"TestRawManifestRefusals/decode/duplicate_entries\",\n450|        expect=\"KILLED\",\n451|        note=\"Admits exactly an equal-key duplicate entry at decode; unsorted entries still refuse. The build site keeps its own row.\",\n452|    ),\n453|    Mutant(\n454|        name=\"N-plan-keys-dup\",\n455|        path=f\"{PACKAGE}/capturebuild.go\",\n456|        find='\\t\\tif seenPlan[key] {\\n\\t\\t\\treturn invalid(\"capture manifest plan keys carry duplicate %q\", key)\\n',\n457|        replace='\\t\\tif seenPlan[key] && key != \"store/blob-a\" {\\n\\t\\t\\treturn invalid(\"capture manifest plan keys carry duplicate %q\", key)\\n',\n458|        count=1,\n459|        run=\"TestCaptureManifestRefusals/build_plan_match\",\n460|        expect=\"KILLED\",\n461|        note=\"Admits exactly the killer's duplicated plan key store/blob-a; every other duplicate still refuses.\",\n462|    ),\n463|    Mutant(\n464|        name=\"N-block-content-null\",\n465|        path=f\"{PACKAGE}/event.go\",\n466|        find='\\t\\thasContent := hasContentMember && !isNull(members[\"content\"])\\n',\n467|        replace='\\t\\thasContent := hasContentMember\\n',\n468|        count=1,\n469|        run=\"TestCanonicalEventRefusals/build_envelope/block_null_content\",\n470|        expect=\"KILLED\",\n471|        note=\"Admits exactly null content (presence-only XOR arm); null descriptors and neither/both rows still refuse.\",\n472|    ),\n473|    Mutant(\n474|        name=\"N-proof-input-blocked\",\n475|        path=f\"{PACKAGE}/boundary.go\",\n476|        find=\"\\t