{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4d1","stream":{"kind":"session","id":"01a0b225-c4f5-7551-94b6-c0c601dc074b"},"sequence":195,"recorded_at":1780531400000385,"record_type":"event","durability":"durable","causation_id":"83118e98-b6d0-4b7d-9792-f7c513af3eac","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"83118e98-b6d0-4b7d-9792-f7c513af3eac","run_stream":{"kind":"run","id":"83118e98-b6d0-4b7d-9792-f7c513af3eac"},"task_stream":{"kind":"task","id":"01a0b226-17e2-79d2-be35-724ab837090f"},"task_id":"01a0b226-17e2-79d2-be35-724ab837090f","event":{"kind":"output","task_id":"01a0b226-17e2-79d2-be35-724ab837090f","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/clonebundle/generation.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n7|)\n8|\n9|// This file owns the Section 13.14.1 immutable generations: the\n10|// source_generation strings carried by StableSnapshotProof and the\n11|// unstable-archive Capture Boundary, and the snapshot-identity digest\n12|// that pins an immutable snapshot. Generations are opaque immutable\n13|// tokens: a generation never mutates, and equality is exact string\n14|// equality. Capture digests that must agree (stable pre/post) are\n15|// compared by digest equality here so both boundary validators share\n16|// one comparison.\n17|\n18|// Generation is one validated immutable source generation token:\n19|// string[1..512], opaque to the core.\n20|type Generation struct {\n21|\tvalue string\n22|}\n23|\n24|// ParseGeneration validates one generation token. Empty,\n25|// over-long, and invalid-UTF-8 tokens are refused; every other text\n26|// content crosses opaquely, because generations are native-store\n27|// tokens the core compares but never interprets. The UTF-8 gate\n28|// matters because the token seals into the boundary bytes: without\n29|// it the marshaler would rewrite invalid bytes to U+FFFD and two\n30|// distinct generations would seal byte-identical.\n31|func ParseGeneration(value string) (Generation, error) {\n32|\tif !validText(value) {\n33|\t\treturn Generation{}, invalid(\"source generation is not valid UTF-8\")\n34|\t}\n35|\tif stringLength(value) < 1 || stringLength(value) > 512 {\n36|\t\treturn Generation{}, invalid(\"source generation is not a string[1..512]\")\n37|\t}\n38|\treturn Generation{value: value}, nil\n39|}\n40|\n41|// MustParseGeneration validates one generation token and panics on\n42|// refusal. Tests and fixed fixtures use it; production paths use\n43|// ParseGeneration and return the refusal.\n44|func MustParseGeneration(value string) Generation {\n45|\tgeneration, err := ParseGeneration(value)\n46|\tif err != nil {\n47|\t\tpanic(err)\n48|\t}\n49|\treturn generation\n50|}\n51|\n52|func (generation Generation) String() string { return generation.value }\n53|\n54|// Equal reports exact generation equality. Generations are\n55|// immutable: two captures name the same source state if and only if\n56|// their tokens are byte-identical.\n57|func (generation Generation) Equal(other Generation) bool {\n58|\treturn generation.value == other.value\n59|}\n60|\n61|func checkGeneration(raw json.RawMessage) (Generation, bool) {\n62|\tvalue, ok := checkStringBounds(raw, 1, 512)\n63|\tif !ok {\n64|\t\treturn Generation{}, false\n65|\t}\n66|\tgeneration, err := ParseGeneration(value)\n67|\tif err != nil {\n68|\t\treturn Generation{}, false\n69|\t}\n70|\treturn generation, true\n71|}\n72|\n73|// CheckDigestsEqual refuses two capture digests that differ. Stable\n74|// capture requires equal pre/post digests; file-size equality is\n75|// never proof and is not consulted here.\n76|func CheckDigestsEqual(pre, post scalar.Digest) error {\n77|\tif pre != post {\n78|\t\treturn invalid(\"capture digests differ: pre %q, post %q\", pre.String(), post.String())\n79|\t}\n80|\treturn nil\n81|}","final_result":true}}}
