{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d373","stream":{"kind":"session","id":"01a0b225-c4f5-7551-94b6-c0c601dc074b"},"sequence":2068,"recorded_at":1780531400004131,"record_type":"event","durability":"durable","causation_id":"83118e98-b6d0-4b7d-9792-f7c513af3eac","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"83118e98-b6d0-4b7d-9792-f7c513af3eac","run_stream":{"kind":"run","id":"83118e98-b6d0-4b7d-9792-f7c513af3eac"},"task_stream":{"kind":"task","id":"01a0b238-b5a4-7a03-aaa2-f5b56b1f7ebf"},"task_id":"01a0b238-b5a4-7a03-aaa2-f5b56b1f7ebf","event":{"kind":"output","task_id":"01a0b238-b5a4-7a03-aaa2-f5b56b1f7ebf","chunk":"edited\nchanged lines: lines 295-306\n--- original\n+++ updated\n@@\n-func TestCaptureRefusesOversizedMember(t *testing.T) {\n-\terr := captureRefusal(t, func(request *CaptureRequest) {\n-\t\trequest.MaxSingleBytes = 10\n-\t}, nil)\n-\trequireRefusalDetail(t, err, \"capability_unavailable\")\n-\t// A larger member still refuses after the off-by-one\n-\t// narrowing: the second case pins the other half.\n-\tbigger := captureRefusal(t, func(request *CaptureRequest) {\n-\t\trequest.MaxSingleBytes = 11\n-\t}, nil)\n-\trequireRefusalDetail(t, bigger, \"capability_unavailable\")\n-}\n+func TestCaptureRefusesOversizedMember(t *testing.T) {\n+\trefuseSized := func(t *testing.T, payload string) error {\n+\t\tt.Helper()\n+\t\tstoreRoot := t.TempDir()\n+\t\twriteStoreFile(t, storeRoot, \"store/only\", []byte(payload))\n+\t\tstoreSink := openTestStore(t)\n+\t\trequest := validCaptureRequest(t, storeRoot, storeSink)\n+\t\trequest.MaxSingleBytes = 10\n+\t\trequest.Plan = []PlanItem{{NativeKey: \"store/only\", Class: \"durable_payload\", Required: true}}\n+\t\tresult, err := Capture(request)\n+\t\tif err == nil {\n+\t\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n+\t\t}\n+\t\treturn err\n+\t}\n+\t// An 11-byte member refuses under a 10-byte bound.\n+\trequireRefusalDetail(t, refuseSized(t, \"0123456789a\"), `\"store/only\"`, \"capability_unavailable\")\n+\t// A 12-byte member still refuses after the admit-exactly-11\n+\t// narrowing: the second case pins the other half.\n+\trequireRefusalDetail(t, refuseSized(t, \"0123456789ab\"), `\"store/only\"`, \"capability_unavailable\")\n+}\n","final_result":true}}}
