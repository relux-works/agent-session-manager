{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c483","stream":{"kind":"session","id":"01a0b225-c4f5-7551-94b6-c0c601dc074b"},"sequence":156,"recorded_at":1780531400000307,"record_type":"event","durability":"durable","causation_id":"83118e98-b6d0-4b7d-9792-f7c513af3eac","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"83118e98-b6d0-4b7d-9792-f7c513af3eac","run_stream":{"kind":"run","id":"83118e98-b6d0-4b7d-9792-f7c513af3eac"},"task_stream":{"kind":"task","id":"01a0b226-0cbe-7453-8b3b-954aa2d7bdc8"},"task_id":"01a0b226-0cbe-7453-8b3b-954aa2d7bdc8","event":{"kind":"output","task_id":"01a0b226-0cbe-7453-8b3b-954aa2d7bdc8","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/clonebundle/identity.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"strings\"\n6|\t\"unicode\"\n7|\t\"unicode/utf8\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// This file validates the Section 13.14.1 identities: NativeIdentity,\n13|// WorkspaceBinding, and the sanitized native-key admission shared by\n14|// every native key in this package. Sanitized means printable,\n15|// relative, and unambiguously native: never an absolute source path,\n16|// never an AX Session identity, never carrying embedded credentials.\n17|\n18|var nativeIdentityMembers = map[string]bool{\n19|\t\"native_session_id\":         true,\n20|\t\"identity_kind\":             true,\n21|\t\"logical_workspace_id\":      true,\n22|\t\"backend_realm_fingerprint\": true,\n23|\t\"opaque_identity\":           true,\n24|\t\"extensions\":                true,\n25|}\n26|\n27|var nativeIdentityRequired = []string{\n28|\t\"native_session_id\",\n29|\t\"identity_kind\",\n30|\t\"logical_workspace_id\",\n31|\t\"backend_realm_fingerprint\",\n32|\t\"opaque_identity\",\n33|\t\"extensions\",\n34|}\n35|\n36|var nativeIdentityKinds = []string{\n37|\t\"provider_native\",\n38|\t\"official_import\",\n39|\t\"continuation_context\",\n40|}\n41|\n42|func validNativeIdentityKind(kind string) bool {\n43|\tfor _, allowed := range nativeIdentityKinds {\n44|\t\tif kind == allowed {\n45|\t\t\treturn true\n46|\t\t}\n47|\t}\n48|\treturn false\n49|}\n50|\n51|// NativeIdentity is one validated sanitized native identity.\n52|type NativeIdentity struct {\n53|\tNativeSessionID         string\n54|\tIdentityKind            string\n55|\tLogicalWorkspaceID      scalar.UUIDv7\n56|\tBackendRealmFingerprint *scalar.Digest\n57|\tOpaqueIdentity          *string\n58|}\n59|\n60|// DecodeNativeIdentity validates one closed NativeIdentity: exact\n61|// members, the closed identity-kind vocabulary, a sanitized native\n62|// session ID, a UUIDv7 logical workspace, an optional digest realm\n63|// fingerprint, an optional sanitized opaque identity, and\n64|// reverse-DNS extensions. Credential, absolute-path, PID, socket,\n65|// token, and secret-environment material is refused by the shared\n66|// sanitizer, never laundered into an identity.\n67|func DecodeNativeIdentity(raw json.RawMessage) (NativeIdentity, error) {\n68|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n69|\tif fault != nil {\n70|\t\treturn NativeIdentity{}, invalid(\"native identity %s (%s)\", fault.detail, memberField(fault.member))\n71|\t}\n72|\tif name, unknown := unknownMember(members, nativeIdentityMembers); unknown {\n73|\t\treturn NativeIdentity{}, invalid(\"native identity carries unknown member %q\", name)\n74|\t}\n75|\tif name, missing := missingMember(members, nativeIdentityRequired); missing {\n76|\t\treturn NativeIdentity{}, invalid(\"native identity misses a required member %q\", name)\n77|\t}\n78|\tnativeID, ok := checkStringBounds(members[\"native_session_id\"], 1, 512)\n79|\tif !ok {\n80|\t\treturn NativeIdentity{}, invalid(\"native identity native_session_id is not a string[1..512]\")\n81|\t}\n82|\tif err := SanitizeNativeKey(nativeID); err != nil {\n83|\t\treturn NativeIdentity{}, err\n84|\t}\n85|\tkind, ok := rawString(members[\"identity_kind\"])\n86|\tif !ok || !validNativeIdentityKind(kind) {\n87|\t\treturn NativeIdentity{}, invalid(\"native identity kind is outside provider_native|official_import|continuation_context\")\n88|\t}\n89|\tworkspaceID, ok := checkUUIDv7(members[\"logical_workspace_id\"])\n90|\tif !ok {\n91|\t\treturn NativeIdentity{}, invalid(\"native identity logical_workspace_id is not a UUIDv7\")\n92|\t}\n93|\tvar fingerprint *scalar.Digest\n94|\tif !isNull(members[\"backend_realm_fingerprint\"]) {\n95|\t\tdigest, ok := checkDigest(members[\"backend_realm_fingerprint\"])\n96|\t\tif !ok {\n97|\t\t\treturn NativeIdentity{}, invalid(\"native identity backend_realm_fingerprint is not a digest\")\n98|\t\t}\n99|\t\tfingerprint = &digest\n100|\t}\n101|\tvar opaque *string\n102|\tif !isNull(members[\"opaque_identity\"]) {\n103|\t\tvalue, ok := checkStringBounds(members[\"opaque_identity\"], 1, 512)\n104|\t\tif !ok {\n105|\t\t\treturn NativeIdentity{}, invalid(\"native identity opaque_identity is not a string[1..512]\")\n106|\t\t}\n107|\t\tif err := SanitizeNativeKey(value); err != nil {\n108|\t\t\treturn NativeIdentity{}, err\n109|\t\t}\n110|\t\topaque = &value\n111|\t}\n112|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n113|\t\treturn NativeIdentity{}, invalid(\"native identity extensions %s\", extensionsFault)\n114|\t}\n115|\treturn NativeIdentity{\n116|\t\tNativeSessionID:         nativeID,\n117|\t\tIdentityKind:            kind,\n118|\t\tLogicalWorkspaceID:      workspaceID,\n119|\t\tBackendRealmFingerprint: fingerprint,\n120|\t\tOpaqueIdentity:          opaque,\n121|\t}, nil\n122|}\n123|\n124|// EncodeNativeIdentity renders one validated identity as canonical\n125|// bytes under the given extensions. The native session ID and the\n126|// opaque identity are sanitized here, before marshaling —\n127|// encoding/json would otherwise rewrite invalid UTF-8 to U+FFFD and\n128|// the caller's re-decode would only ever see the rewritten bytes,\n129|// laundering a native key past the sanitizer's own refusal and\n130|// sealing two distinct inputs to byte-identical objects. The kind\n131|// refuses invalid UTF-8 here too, so no member the encoder seals is\n132|// ever rewritten. The extensions are validated here as well, so\n133|// encoding never admits what decoding refused. A nil extensions map\n134|// encodes as the empty object.\n135|func EncodeNativeIdentity(identity NativeIdentity, extensions map[string]any) ([]byte, error) {\n136|\tif !validText(identity.IdentityKind) {\n137|\t\treturn nil, invalid(\"native identity kind is not valid UTF-8\")\n138|\t}\n139|\tif err := SanitizeNativeKey(identity.NativeSessionID); err != nil {\n140|\t\treturn nil, err\n141|\t}\n142|\tif identity.OpaqueIdentity != nil {\n143|\t\tif err := SanitizeNativeKey(*identity.OpaqueIdentity); err != nil {\n144|\t\t\treturn nil, err\n145|\t\t}\n146|\t}\n147|\tif _, err := encodeExtensions(extensions); err != nil {\n148|\t\treturn nil, err\n149|\t}\n150|\tvar fingerprint any\n151|\tif identity.BackendRealmFingerprint != nil {\n152|\t\tfingerprint = identity.BackendRealmFingerprint.String()\n153|\t}\n154|\tvar opaque any\n155|\tif identity.OpaqueIdentity != nil {\n156|\t\topaque = *identity.OpaqueIdentity\n157|\t}\n158|\tif extensions == nil {\n159|\t\textensions = map[string]any{}\n160|\t}\n161|\treturn canonicalizeObject(map[string]any{\n162|\t\t\"native_session_id\":         identity.NativeSessionID,\n163|\t\t\"identity_kind\":             identity.IdentityKind,\n164|\t\t\"logical_workspace_id\":      identity.LogicalWorkspaceID.String(),\n165|\t\t\"backend_realm_fingerprint\": fingerprint,\n166|\t\t\"opaque_identity\":           opaque,\n167|\t\t\"extensions\":                extensions,\n168|\t})\n169|}\n170|\n171|var workspaceBindingMembers = map[string]bool{\n172|\t\"logical_workspace_id\":           true,\n173|\t\"cwd_relative\":                   true,\n174|\t\"repository_remote_fingerprints\": true,\n175|\t\"branch\":                         true,\n176|\t\"head_digest\":                    true,\n177|\t\"index_digest\":                   true,\n178|\t\"working_tree_digest\":            true,\n179|\t\"extensions\":                     true,\n180|}\n181|\n182|var workspaceBindingRequired = []string{\n183|\t\"logical_workspace_id\",\n184|\t\"cwd_relative\",\n185|\t\"repository_remote_fingerprints\",\n186|\t\"branch\",\n187|\t\"head_digest\",\n188|\t\"index_digest\",\n189|\t\"working_tree_digest\",\n190|\t\"extensions\",\n191|}\n192|\n193|// WorkspaceBinding is one validated closed workspace binding. No\n194|// member grants filesystem authority: the cwd is a normalized\n195|// relative path beneath the Workspace Group root, never an absolute\n196|// path or an escape.\n197|type WorkspaceBinding struct {\n198|\tLogicalWorkspaceID scalar.UUIDv7\n199|\tCwdRelative        string\n200|\tRemoteFingerprints []scalar.Digest\n201|\tBranch             *string\n202|\tHeadDigest         *scalar.Digest\n203|\tIndexDigest        *scalar.Digest\n204|\tWorkingTreeDigest  *scalar.Digest\n205|}\n206|\n207|// DecodeWorkspaceBinding validates one closed WorkspaceBinding.\n208|func DecodeWorkspaceBinding(raw json.RawMessage) (WorkspaceBinding, error) {\n209|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n210|\tif fault != nil {\n211|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding %s (%s)\", fault.detail, memberField(fault.member))\n212|\t}\n213|\tif name, unknown := unknownMember(members, workspaceBindingMembers); unknown {\n214|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding carries unknown member %q\", name)\n215|\t}\n216|\tif name, missing := missingMember(members, workspaceBindingRequired); missing {\n217|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding misses a required member %q\", name)\n218|\t}\n219|\tworkspaceID, ok := checkUUIDv7(members[\"logical_workspace_id\"])\n220|\tif !ok {\n221|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding logical_workspace_id is not a UUIDv7\")\n222|\t}\n223|\tcwd, ok := checkStringBounds(members[\"cwd_relative\"], 1, 4096)\n224|\tif !ok {\n225|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding cwd_relative is not a string[1..4096]\")\n226|\t}\n227|\tif err := checkCwdRelative(cwd); err != nil {\n228|\t\treturn WorkspaceBinding{}, err\n229|\t}\n230|\tfingerprints, ok := checkSortedUniqueDigests(members[\"repository_remote_fingerprints\"], 0, 128)\n231|\tif !ok {\n232|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding repository_remote_fingerprints are not sorted unique digest[0..128]\")\n233|\t}\n234|\tvar branch *string\n235|\tif !isNull(members[\"branch\"]) {\n236|\t\tvalue, ok := checkStringBounds(members[\"branch\"], 1, 1024)\n237|\t\tif !ok {\n238|\t\t\treturn WorkspaceBinding{}, invalid(\"workspace binding branch is not a string[1..1024]\")\n239|\t\t}\n240|\t\tbranch = &value\n241|\t}\n242|\thead, err := checkNullableDigest(members, \"head_digest\", \"workspace binding\")\n243|\tif err != nil {\n244|\t\treturn WorkspaceBinding{}, err\n245|\t}\n246|\tindex, err := checkNullableDigest(members, \"index_digest\", \"workspace binding\")\n247|\tif err != nil {\n248|\t\treturn WorkspaceBinding{}, err\n249|\t}\n250|\ttree, err := checkNullableDigest(members, \"working_tree_digest\", \"workspace binding\")\n251|\tif err != nil {\n252|\t\treturn WorkspaceBinding{}, err\n253|\t}\n254|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n255|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding extensions %s\", extensionsFault)\n256|\t}\n257|\treturn WorkspaceBinding{\n258|\t\tLogicalWorkspaceID: workspaceID,\n259|\t\tCwdRelative:        cwd,\n260|\t\tRemoteFingerprints: fingerprints,\n261|\t\tBranch:             branch,\n262|\t\tHeadDigest:         head,\n263|\t\tIndexDigest:        index,\n264|\t\tWorkingTreeDigest:  tree,\n265|\t}, nil\n266|}\n267|\n268|// checkCwdRelative admits exactly the normalized relative paths\n269|// beneath (or equal to) the Workspace Group root: scalar relative\n270|// paths plus the root itself (\".\"). Anything else — absolute,\n271|// escaped, backslashed, encoded-separator, or dot-segment forms —\n272|// would grant or smuggle filesystem authority and is refused.\n273|func checkCwdRelative(cwd string) error {\n274|\tif cwd == \".\" {\n275|\t\treturn nil\n276|\t}\n277|\tif _, err := scalar.ParseRelativePath(cwd); err != nil {\n278|\t\treturn invalid(\"workspace binding cwd_relative is not normalized beneath the workspace root: %v\", err)\n279|\t}\n280|\treturn nil\n281|}\n282|\n283|func checkNullableDigest(members map[string]json.RawMessage, name, owner string) (*scalar.Digest, error) {\n284|\traw, present := members[name]\n285|\tif !present {\n286|\t\treturn nil, invalid(\"%s misses a required member %q\", owner, name)\n287|\t}\n288|\tif isNull(raw) {\n289|\t\treturn nil, nil\n290|\t}\n291|\tdigest, ok := checkDigest(raw)\n292|\tif !ok {\n293|\t\treturn nil, invalid(\"%s %s is not a digest\", owner, name)\n294|\t}\n295|\treturn &digest, nil\n296|}\n297|\n298|// SanitizeNativeKey refuses every native key that is not sanitized:\n299|// empty values are refused here (over-long values by the caller's\n300|// bound check), and this gate refuses control characters (the full\n301|// Cc class, C0 and C1), invisible format characters (Cf, Zl, Zp:\n302|// zero-width and separator marks that render invisibly),\n303|// absolute-path forms, a UUIDv7 form (indistinguishable from a\n304|// fabricated AX Session identity), embedded-credential forms (a\n305|// password-style colon before the first @, with or without a\n306|// scheme), and AX-schema markers in any case. The pinned text does\n307|// not define the sanitizer's exact scope, so the implemented bound\n308|// is exactly this list, pinned by the sanitizer corpus and stated\n309|// in TRACEABILITY.md: ordinary spaces, @ without a password\n310|// colon, and colons without an @ all admit. A native key that\n311|// survives is printable, relative, and unambiguously native.\n312|func SanitizeNativeKey(key string) error {\n313|\tif key == \"\" {\n314|\t\treturn invalid(\"native key is empty\")\n315|\t}\n316|\tif !utf8.ValidString(key) {\n317|\t\treturn invalid(\"native key is not valid UTF-8\")\n318|\t}\n319|\tfor _, unit := range key {\n320|\t\tif unicode.IsControl(unit) {\n321|\t\t\treturn invalid(\"native key carries control characters\")\n322|\t\t}\n323|\t\tif unicode.Is(unicode.Cf, unit) || unicode.Is(unicode.Zl, unit) || unicode.Is(unicode.Zp, unit) {\n324|\t\t\treturn invalid(\"native key carries invisible format characters\")\n325|\t\t}\n326|\t}\n327|\tif strings.HasPrefix(key, \"/\") || strings.HasPrefix(key, `\\\\`) || hasDrivePrefix(key) {\n328|\t\treturn invalid(\"native key is an absolute source path, never a cross-host identity\")\n329|\t}\n330|\tif _, err := scalar.ParseUUIDv7(key); err == nil {\n331|\t\treturn invalid(\"native key %q is a UUIDv7, indistinguishable from a fabricated AX Session identity\", key)\n332|\t}\n333|\tif strings.Contains(strings.ToLower(key), \"urn:ax:\") {\n334|\t\treturn invalid(\"native key carries an AX identity marker\")\n335|\t}\n336|\tif at := strings.Index(key, \"@\"); at >= 0 && strings.Contains(key[:at], \":\") {\n337|\t\treturn invalid(\"native key carries embedded credentials\")\n338|\t}\n339|\treturn nil\n340|}\n341|\n342|func hasDrivePrefix(value string) bool {\n343|\treturn len(value) >= 3 && ((value[0] >= 'a' && value[0] <= 'z') || (value[0] >= 'A' && value[0] <= 'Z')) && value[1] == ':' && (value[2] == '/' || value[2] == '\\\\')\n344|}\n345|\n346|func memberField(member string) string {\n347|\tif member == \"\" {\n348|\t\treturn \"frame\"\n349|\t}\n350|\treturn \"member \" + member\n351|}","final_result":true}}}
