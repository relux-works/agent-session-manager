{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d4cd","stream":{"kind":"session","id":"01a0b225-c4f5-7551-94b6-c0c601dc074b"},"sequence":2241,"recorded_at":1780531400004477,"record_type":"event","durability":"durable","causation_id":"83118e98-b6d0-4b7d-9792-f7c513af3eac","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"83118e98-b6d0-4b7d-9792-f7c513af3eac","run_stream":{"kind":"run","id":"83118e98-b6d0-4b7d-9792-f7c513af3eac"},"task_stream":{"kind":"task","id":"01a0b239-f03a-7500-80cb-c54fb9ccf159"},"task_id":"01a0b239-f03a-7500-80cb-c54fb9ccf159","event":{"kind":"output","task_id":"01a0b239-f03a-7500-80cb-c54fb9ccf159","chunk":"edited\nchanged lines: lines 176-207\n--- original\n+++ updated\n@@\n-func TestCaptureRefusesSymlinkedIntermediate(t *testing.T) {\n-\toutside := t.TempDir()\n-\tif err := os.WriteFile(filepath.Join(outside, \"target\"), []byte(\"outside-bytes\"), 0o600); err != nil {\n-\t\tt.Fatal(err)\n-\t}\n-\terr := captureRefusal(t, func(request *CaptureRequest) {\n-\t\trequest.Plan = []PlanItem{\n-\t\t\t{NativeKey: \"link-escape/file\", Class: \"durable_payload\", Required: true},\n-\t\t}\n-\t}, func(t *testing.T, root string) {\n-\t\tif err := os.Symlink(outside, filepath.Join(root, \"link-escape\")); err != nil {\n-\t\t\tt.Fatal(err)\n-\t\t}\n-\t})\n-\trequireRefusalDetail(t, err, \"link-escape\", \"symlink\")\n-}\n-\n-func TestCaptureRefusesTrailingSymlink(t *testing.T) {\n-\terr := captureRefusal(t, func(request *CaptureRequest) {\n-\t\trequest.Plan = []PlanItem{\n-\t\t\t{NativeKey: \"link-escape\", Class: \"durable_payload\", Required: true},\n-\t\t}\n-\t}, func(t *testing.T, root string) {\n-\t\tif err := os.WriteFile(filepath.Join(root, \"real-target\"), []byte(\"real-bytes\"), 0o600); err != nil {\n-\t\t\tt.Fatal(err)\n-\t\t}\n-\t\tif err := os.Symlink(\"real-target\", filepath.Join(root, \"link-escape\")); err != nil {\n-\t\t\tt.Fatal(err)\n-\t\t}\n-\t})\n-\trequireRefusalDetail(t, err, \"link-escape\", \"symlink\")\n-}\n+func TestCaptureRefusesSymlinkedIntermediate(t *testing.T) {\n+\tstoreRoot := t.TempDir()\n+\toutside := t.TempDir()\n+\tif err := os.WriteFile(filepath.Join(outside, \"file\"), []byte(\"outside-bytes\"), 0o600); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif err := os.Symlink(outside, filepath.Join(storeRoot, \"link-escape\")); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tstoreSink := openTestStore(t)\n+\trequest := validCaptureRequest(t, storeRoot, storeSink)\n+\trequest.Plan = []PlanItem{\n+\t\t{NativeKey: \"link-escape/file\", Class: \"durable_payload\", Required: true},\n+\t}\n+\tresult, err := Capture(request)\n+\tif err == nil {\n+\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n+\t}\n+\trequireRefusalDetail(t, err, \"link-escape/file\", \"symlink\")\n+\tif blobs := listStoredBlobs(t, storeSink); blobsContain(blobs, \"outside-bytes\") {\n+\t\tt.Fatal(\"capture installed bytes from outside the store root\")\n+\t}\n+}\n+\n+func TestCaptureRefusesTrailingSymlink(t *testing.T) {\n+\tstoreRoot := t.TempDir()\n+\tif err := os.WriteFile(filepath.Join(storeRoot, \"real-target\"), []byte(\"real-bytes\"), 0o600); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif err := os.Symlink(\"real-target\", filepath.Join(storeRoot, \"link-escape\")); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tstoreSink := openTestStore(t)\n+\trequest := validCaptureRequest(t, storeRoot, storeSink)\n+\trequest.Plan = []PlanItem{\n+\t\t{NativeKey: \"link-escape\", Class: \"durable_payload\", Required: true},\n+\t\t{NativeKey: \"real-target\", Class: \"durable_payload\", Required: true},\n+\t}\n+\tresult, err := Capture(request)\n+\tif err == nil {\n+\t\tt.Fatalf(\"Capture() = %+v, want a refusal\", result)\n+\t}\n+\trequireRefusalDetail(t, err, \"link-escape\", \"symlink\")\n+}\n","final_result":true}}}
