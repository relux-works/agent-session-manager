{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c48b","stream":{"kind":"session","id":"01a0b225-c4f5-7551-94b6-c0c601dc074b"},"sequence":160,"recorded_at":1780531400000315,"record_type":"event","durability":"durable","causation_id":"83118e98-b6d0-4b7d-9792-f7c513af3eac","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"83118e98-b6d0-4b7d-9792-f7c513af3eac","run_stream":{"kind":"run","id":"83118e98-b6d0-4b7d-9792-f7c513af3eac"},"call_id":"call_01a0b22605f075bdbf751833ea33a208","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/clonebundle/rawmanifest.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/hosttrust\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n9|)\n10|\n11|// This file validates and constructs Clone Raw Object Manifest 1.0.0:\n12|// the closed sorted unique entry list over content-addressed blobs.\n13|// Credential, machine-auth, runtime-state, transient-lock, and\n14|// hosttrust-excluded candidates are forbidden here; they never become\n15|// raw objects.\n16|\n17|const (\n18|\trawManifestSchema  = \"urn:ax:schema:clone-raw-object-manifest\"\n19|\trawManifestVersion = \"1.0.0\"\n20|\trawManifestSelf    = \"raw_object_manifest_id\"\n21|)\n22|\n23|// rawEntryClasses is the closed RawObjectEntry class subset:\n24|// durable and derived-cache classes plus unknown. The four\n25|// excluded classes (credential, machine_auth, runtime_state,\n26|// transient_lock) are absent by construction, so membership in this\n27|// table is the gate.\n28|var rawEntryClasses = []string{\n29|\t\"durable_payload\",\n30|\t\"durable_index_required\",\n31|\t\"durable_sidecar\",\n32|\t\"derived_cache_optional\",\n33|\t\"unknown\",\n34|}\n35|\n36|func validRawEntryClass(class string) bool {\n37|\tfor _, allowed := range rawEntryClasses {\n38|\t\tif class == allowed {\n39|\t\t\treturn true\n40|\t\t}\n41|\t}\n42|\treturn false\n43|}\n44|\n45|var rawManifestMembers = map[string]bool{\n46|\t\"schema\":                   true,\n47|\t\"schema_version\":           true,\n48|\t\"raw_object_manifest_id\":   true,\n49|\t\"operation_id\":             true,\n50|\t\"source_environment\":       true,\n51|\t\"source_native_session_id\": true,\n52|\t\"source_identity_digest\":   true,\n53|\t\"capture_plan_digest\":      true,\n54|\t\"entries\":                  true,\n55|\t\"total_bytes\":              true,\n56|\t\"extensions\":               true,\n57|}\n58|\n59|var rawManifestRequired = []string{\n60|\t\"schema\",\n61|\t\"schema_version\",\n62|\t\"raw_object_manifest_id\",\n63|\t\"operation_id\",\n64|\t\"source_environment\",\n65|\t\"source_native_session_id\",\n66|\t\"source_identity_digest\",\n67|\t\"capture_plan_digest\",\n68|\t\"entries\",\n69|\t\"total_bytes\",\n70|\t\"extensions\",\n71|}\n72|\n73|var rawEntryMembers = map[string]bool{\n74|\t\"native_item_key\":    true,\n75|\t\"class\":              true,\n76|\t\"byte_count\":         true,\n77|\t\"blob_id\":            true,\n78|\t\"blob_descriptor_id\": true,\n79|}\n80|\n81|var rawEntryRequired = []string{\n82|\t\"native_item_key\",\n83|\t\"class\",\n84|\t\"byte_count\",\n85|\t\"blob_id\",\n86|\t\"blob_descriptor_id\",\n87|}\n88|\n89|// RawObjectEntry is one validated raw object entry.\n90|type RawObjectEntry struct {\n91|\tNativeItemKey    string\n92|\tClass            string\n93|\tByteCount        uint64\n94|\tBlobID           scalar.Digest\n95|\tBlobDescriptorID scalar.Digest\n96|}\n97|\n98|// RawObjectManifest is one validated Clone Raw Object Manifest.\n99|type RawObjectManifest struct {\n100|\tManifestID            scalar.Digest\n101|\tOperationID           scalar.UUIDv7\n102|\tSourceEnvironment     sessadapter.Tuple\n103|\tSourceNativeSessionID string\n104|\tSourceIdentityDigest  scalar.Digest\n105|\tCapturePlanDigest     scalar.Digest\n106|\tEntries               []RawObjectEntry\n107|\tTotalBytes            uint64\n108|}\n109|\n110|// EntryInput is one caller-supplied raw entry candidate for Build.\n111|// Descriptor carries the exact Section 10.2 Blob Descriptor bytes\n112|// the entry references; Build verifies the descriptor's closed\n113|// shape and identity and its blob-ID/byte-count agreement before\n114|// the entry is admitted.\n115|type EntryInput struct {\n116|\tNativeItemKey string\n117|\tClass         string\n118|\tByteCount     uint64\n119|\tBlobID        string\n120|\tDescriptorID  string\n121|\tDescriptor    []byte\n122|}\n123|\n124|// BuildRawObjectManifest constructs one closed Clone Raw Object\n125|// Manifest as canonical bytes. Identical inputs produce\n126|// byte-identical outputs. Every closed-shape rule is a refusal:\n127|// unknown classes, unsanitized or excluded native keys, unsorted or\n128|// duplicate entries, descriptor disagreement, and total-byte\n129|// mismatch are all refused, never repaired.\n130|func BuildRawObjectManifest(\n131|\toperationID string,\n132|\tsourceEnvironment []byte,\n133|\tsourceNativeSessionID string,\n134|\tsourceIdentityDigest string,\n135|\tcapturePlanDigest string,\n136|\tinputs []EntryInput,\n137|\textensions map[string]any,\n138|) ([]byte, error) {\n139|\toperation, err := scalar.ParseUUIDv7(operationID)\n140|\tif err != nil {\n141|\t\treturn nil, invalid(\"raw object manifest operation_id is not a UUIDv7: %v\", err)\n142|\t}\n143|\ttuple, err := sessadapter.DecodeTuple(json.RawMessage(sourceEnvironment))\n144|\tif err != nil {\n145|\t\treturn nil, invalid(\"raw object manifest source_environment is not an Environment Tuple: %v\", err)\n146|\t}\n147|\tif stringLength(sourceNativeSessionID) < 1 || stringLength(sourceNativeSessionID) > 512 {\n148|\t\treturn nil, invalid(\"raw object manifest source_native_session_id is not a string[1..512]\")\n149|\t}\n150|\tif err := SanitizeNativeKey(sourceNativeSessionID); err != nil {\n151|\t\treturn nil, err\n152|\t}\n153|\tidentityDigest, err := scalar.ParseDigest(sourceIdentityDigest)\n154|\tif err != nil {\n155|\t\treturn nil, invalid(\"raw object manifest source_identity_digest is not a digest: %v\", err)\n156|\t}\n157|\tplanDigest, err := scalar.ParseDigest(capturePlanDigest)\n158|\tif err != nil {\n159|\t\treturn nil, invalid(\"raw object manifest capture_plan_digest is not a digest: %v\", err)\n160|\t}\n161|\tif len(inputs) > 65536 {\n162|\t\treturn nil, invalid(\"raw object manifest carries %d entries, maximum is 65536\", len(inputs))\n163|\t}\n164|\tentries, total, err := buildRawEntries(inputs)\n165|\tif err != nil {\n166|\t\treturn nil, err\n167|\t}\n168|\tif _, err := encodeExtensions(extensions); err != nil {\n169|\t\treturn nil, err\n170|\t}\n171|\tobject := map[string]any{\n172|\t\t\"schema\":                   rawManifestSchema,\n173|\t\t\"schema_version\":           rawManifestVersion,\n174|\t\t\"operation_id\":             operation.String(),\n175|\t\t\"source_environment\":       tupleObject(tuple),\n176|\t\t\"source_native_session_id\": sourceNativeSessionID,\n177|\t\t\"source_identity_digest\":   identityDigest.String(),\n178|\t\t\"capture_plan_digest\":      planDigest.String(),\n179|\t\t\"entries\":                  rawEntryObjects(entries),\n180|\t\t\"total_bytes\":              total,\n181|\t\t\"extensions\":               extensionValue(extensions),\n182|\t}\n183|\tomitted, err := canonicalizeObject(object)\n184|\tif err != nil {\n185|\t\treturn nil, err\n186|\t}\n187|\tmanifestID := scalar.SHA256Digest(omitted)\n188|\tobject[rawManifestSelf] = manifestID.String()\n189|\treturn canonicalizeObject(object)\n190|}\n191|\n192|func buildRawEntries(inputs []EntryInput) ([]RawObjectEntry, uint64, error) {\n193|\tentries := make([]RawObjectEntry, 0, len(inputs))\n194|\tprevious := \"\"\n195|\tvar total uint64\n196|\tfor index, input := range inputs {\n197|\t\tif stringLength(input.NativeItemKey) < 1 || stringLength(input.NativeItemKey) > 512 {\n198|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] native_item_key is not a string[1..512]\", index)\n199|\t\t}\n200|\t\tif err := SanitizeNativeKey(input.NativeItemKey); err != nil {\n201|\t\t\treturn nil, 0, err\n202|\t\t}\n203|\t\tif err := refuseExcludedMember(\"raw object entry\", input.NativeItemKey, index); err != nil {\n204|\t\t\treturn nil, 0, err\n205|\t\t}\n206|\t\tif !validRawEntryClass(input.Class) {\n207|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] class %q is outside the raw subset\", index, input.Class)\n208|\t\t}\n209|\t\tif input.ByteCount > maxUint53 {\n210|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] byte_count exceeds uint53\", index)\n211|\t\t}\n212|\t\tblobID, err := scalar.ParseDigest(input.BlobID)\n213|\t\tif err != nil {\n214|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] blob_id is not a digest: %v\", index, err)\n215|\t\t}\n216|\t\tdescriptorID, err := scalar.ParseDigest(input.DescriptorID)\n217|\t\tif err != nil {\n218|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] blob_descriptor_id is not a digest: %v\", index, err)\n219|\t\t}\n220|\t\tif err := VerifyDescriptorAgreement(input.Descriptor, descriptorID, blobID, input.ByteCount); err != nil {\n221|\t\t\treturn nil, 0, invalid(\"raw object entry[%d]: %v\", index, err)\n222|\t\t}\n223|\t\tif total > maxUint53-input.ByteCount {\n224|\t\t\treturn nil, 0, invalid(\"raw object manifest total_bytes exceeds uint53\")\n225|\t\t}\n226|\t\ttotal += input.ByteCount\n227|\t\tif index > 0 && input.NativeItemKey <= previous {\n228|\t\t\treturn nil, 0, invalid(\"raw object manifest entries are not sorted unique by native item key\")\n229|\t\t}\n230|\t\tprevious = input.NativeItemKey\n231|\t\tentries = append(entries, RawObjectEntry{\n232|\t\t\tNativeItemKey:    input.NativeItemKey,\n233|\t\t\tClass:            input.Class,\n234|\t\t\tByteCount:        input.ByteCount,\n235|\t\t\tBlobID:           blobID,\n236|\t\t\tBlobDescriptorID: descriptorID,\n237|\t\t})\n238|\t}\n239|\treturn entries, total, nil\n240|}\n241|\n242|// refuseExcludedMember is the row-21 exclusion allowlist: a native\n243|// key matching hosttrust.MatchExcludedFromReplication or\n244|// hosttrust.ExcludedConfigDirName is trust-adjacent material that\n245|// must never enter a clone bundle, so construction refuses it. The\n246|// owner names the calling shape (raw entry, capture item) so the\n247|// refusal identifies the exact member.\n248|func refuseExcludedMember(owner, key string, index int) error {\n249|\tif hosttrust.MatchExcludedFromReplication(key) {\n250|\t\treturn invalid(\"%s[%d] native key %q is excluded from replication\", owner, index, key)\n251|\t}\n252|\tif hosttrust.ExcludedConfigDirName(key) {\n253|\t\treturn invalid(\"%s[%d] native key %q is trust-adjacent config material\", owner, index, key)\n254|\t}\n255|\treturn nil\n256|}\n257|\n258|// DecodeRawObjectManifest validates one closed Clone Raw Object\n259|// Manifest: exact members, schema/version, self-digest agreement,\n260|// tuple, sanitized source identity, sorted unique entries, and a\n261|// total equal to the sum of entry byte counts.\n262|func DecodeRawObjectManifest(data []byte) (RawObjectManifest, error) {\n263|\tmembers, fault := decodeStrictObject(data)\n264|\tif fault != nil {\n265|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest %s (%s)\", fault.detail, memberField(fault.member))\n266|\t}\n267|\tif name, unknown := unknownMember(members, rawManifestMembers); unknown {\n268|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest carries unknown member %q\", name)\n269|\t}\n270|\tif name, missing := missingMember(members, rawManifestRequired); missing {\n271|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest misses a required member %q\", name)\n272|\t}\n273|\tschema, ok := rawString(members[\"schema\"])\n274|\tif !ok || schema != rawManifestSchema {\n275|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest schema is not the clone raw object manifest\")\n276|\t}\n277|\tversion, ok := rawString(members[\"schema_version\"])\n278|\tif !ok || version != rawManifestVersion {\n279|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest version is not 1.0.0\")\n280|\t}\n281|\tmanifestID, ok := checkDigest(members[rawManifestSelf])\n282|\tif !ok {\n283|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest raw_object_manifest_id is not a digest\")\n284|\t}\n285|\toperation, ok := checkUUIDv7(members[\"operation_id\"])\n286|\tif !ok {\n287|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest operation_id is not a UUIDv7\")\n288|\t}\n289|\ttuple, err := sessadapter.DecodeTuple(members[\"source_environment\"])\n290|\tif err != nil {\n291|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest source_environment is not an Environment Tuple: %v\", err)\n292|\t}\n293|\tnativeID, ok := checkStringBounds(members[\"source_native_session_id\"], 1, 512)\n294|\tif !ok {\n295|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest source_native_session_id is not a string[1..512]\")\n296|\t}\n297|\tif err := SanitizeNativeKey(nativeID); err != nil {\n298|\t\treturn RawObjectManifest{}, err\n299|\t}\n300|\tidentityDigest, ok := checkDigest(members[\"source_identity_digest\"])\n301|\tif !ok {\n302|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest source_identity_digest is not a digest\")\n303|\t}\n304|\tplanDigest, ok := checkDigest(members[\"capture_plan_digest\"])\n305|\tif !ok {\n306|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest capture_plan_digest is not a digest\")\n307|\t}\n308|\tentries, total, err := decodeRawEntries(members[\"entries\"])\n309|\tif err != nil {\n310|\t\treturn RawObjectManifest{}, err\n311|\t}\n312|\tclaimed, ok := checkUint53Bounds(members[\"total_bytes\"], 0, maxUint53)\n313|\tif !ok {\n314|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest total_bytes is not a uint53\")\n315|\t}\n316|\tif claimed != total {\n317|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest total_bytes is %d, entries sum to %d\", claimed, total)\n318|\t}\n319|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n320|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest extensions %s\", extensionsFault)\n321|\t}\n322|\tif err := verifySelfDigest(members, rawManifestSelf, manifestID); err != nil {\n323|\t\treturn RawObjectManifest{}, err\n324|\t}\n325|\treturn RawObjectManifest{\n326|\t\tManifestID:            manifestID,\n327|\t\tOperationID:           operation,\n328|\t\tSourceEnvironment:     tuple,\n329|\t\tSourceNativeSessionID: nativeID,\n330|\t\tSourceIdentityDigest:  identityDigest,\n331|\t\tCapturePlanDigest:     planDigest,\n332|\t\tEntries:               entries,\n333|\t\tTotalBytes:            total,\n334|\t}, nil\n335|}\n336|\n337|func decodeRawEntries(raw json.RawMessage) ([]RawObjectEntry, uint64, error) {\n338|\telements, ok := decodeArray(raw)\n339|\tif !ok {\n340|\t\treturn nil, 0, invalid(\"raw object manifest entries are not an array\")\n341|\t}\n342|\tif len(elements) > 65536 {\n343|\t\treturn nil, 0, invalid(\"raw object manifest carries %d entries, maximum is 65536\", len(elements))\n344|\t}\n345|\tentries := make([]RawObjectEntry, 0, len(elements))\n346|\tprevious := \"\"\n347|\tvar total uint64\n348|\tfor index, element := range elements {\n349|\t\tmembers, fault := decodeStrictObject(bytesTrimSpace(element))\n350|\t\tif fault != nil {\n351|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] %s (%s)\", index, fault.detail, memberField(fault.member))\n352|\t\t}\n353|\t\tif name, unknown := unknownMember(members, rawEntryMembers); unknown {\n354|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] carries unknown member %q\", index, name)\n355|\t\t}\n356|\t\tif name, missing := missingMember(members, rawEntryRequired); missing {\n357|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] misses a required member %q\", index, name)\n358|\t\t}\n359|\t\tkey, ok := checkStringBounds(members[\"native_item_key\"], 1, 512)\n360|\t\tif !ok {\n361|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] native_item_key is not a string[1..512]\", index)\n362|\t\t}\n363|\t\tif err := SanitizeNativeKey(key); err != nil {\n364|\t\t\treturn nil, 0, err\n365|\t\t}\n366|\t\tif err := refuseExcludedMember(\"raw object entry\", key, index); err != nil {\n367|\t\t\treturn nil, 0, err\n368|\t\t}\n369|\t\tclass, ok := rawString(members[\"class\"])\n370|\t\tif !ok || !validRawEntryClass(class) {\n371|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] class %q is outside the raw subset\", index, class)\n372|\t\t}\n373|\t\tcount, ok := checkUint53Bounds(members[\"byte_count\"], 0, maxUint53)\n374|\t\tif !ok {\n375|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] byte_count is not a uint53\", index)\n376|\t\t}\n377|\t\tblobID, ok := checkDigest(members[\"blob_id\"])\n378|\t\tif !ok {\n379|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] blob_id is not a digest\", index)\n380|\t\t}\n381|\t\tdescriptorID, ok := checkDigest(members[\"blob_descriptor_id\"])\n382|\t\tif !ok {\n383|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] blob_descriptor_id is not a digest\", index)\n384|\t\t}\n385|\t\tif total > maxUint53-count {\n386|\t\t\treturn nil, 0, invalid(\"raw object manifest total_bytes exceeds uint53\")\n387|\t\t}\n388|\t\ttotal += count\n389|\t\tif index > 0 && key <= previous {\n390|\t\t\treturn nil, 0, invalid(\"raw object manifest entries are not sorted unique by native item key\")\n391|\t\t}\n392|\t\tprevious = key\n393|\t\tentries = append(entries, RawObjectEntry{\n394|\t\t\tNativeItemKey:    key,\n395|\t\t\tClass:            class,\n396|\t\t\tByteCount:        count,\n397|\t\t\tBlobID:           blobID,\n398|\t\t\tBlobDescriptorID: descriptorID,\n399|\t\t})\n400|\t}\n401|\treturn entries, total, nil\n402|}\n403|\n404|// VerifyRawManifestDescriptors re-checks descriptor agreement for a\n405|// decoded manifest: every entry's blob ID and byte count must agree\n406|// with the fetched Section 10.2 Blob Descriptor bytes, and the\n407|// fetched bytes must be the exact descriptor the entry's\n408|// blob_descriptor_id names. Decode validates structure; this entry\n409|// validates evidence.\n410|func VerifyRawManifestDescriptors(manifest RawObjectManifest, fetch func(descriptorID string) ([]byte, error)) error {\n411|\tfor index, entry := range manifest.Entries {\n412|\t\tdescriptor, err := fetch(entry.BlobDescriptorID.String())\n413|\t\tif err != nil {\n414|\t\t\treturn invalid(\"raw object entry[%d]: descriptor fetch failed: %v\", index, err)\n415|\t\t}\n416|\t\tif len(descriptor) == 0 {\n417|\t\t\treturn invalid(\"raw object entry[%d]: descriptor is absent\", index)\n418|\t\t}\n419|\t\tif err := VerifyDescriptorAgreement(descriptor, entry.BlobDescriptorID, entry.BlobID, entry.ByteCount); err != nil {\n420|\t\t\treturn invalid(\"raw object entry[%d]: %v\", index, err)\n421|\t\t}\n422|\t}\n423|\treturn nil\n424|}\n425|\n426|// IdentityDigest computes the terminal digest of canonical sanitized\n427|// NativeIdentity bytes: the source_identity_digest production entry.\n428|// The encoded bytes re-decode before hashing, exactly as\n429|// buildCaptureManifest re-decodes the source identity, so no digest\n430|// is ever sealed over an identity decoding would refuse.\n431|func IdentityDigest(identity NativeIdentity, extensions map[string]any) (scalar.Digest, error) {\n432|\tif err := SanitizeNativeKey(identity.NativeSessionID); err != nil {\n433|\t\treturn scalar.Digest{}, err\n434|\t}\n435|\tencoded, err := EncodeNativeIdentity(identity, extensions)\n436|\tif err != nil {\n437|\t\treturn scalar.Digest{}, err\n438|\t}\n439|\tif _, err := DecodeNativeIdentity(json.RawMessage(encoded)); err != nil {\n440|\t\treturn scalar.Digest{}, invalid(\"native identity digest seals no undecodable identity: %v\", err)\n441|\t}\n442|\treturn scalar.SHA256Digest(encoded), nil\n443|}\n444|\n445|func tupleObject(tuple sessadapter.Tuple) map[string]any {\n446|\treturn map[string]any{\n447|\t\t\"environment_id\":           tuple.EnvironmentID,\n448|\t\t\"environment_version\":      tuple.Version,\n449|\t\t\"platform\":                 tuple.Platform,\n450|\t\t\"architecture\":             tuple.Architecture,\n451|\t\t\"store_schema_fingerprint\": tuple.StoreFingerprint,\n452|\t\t\"adapter_version\":          tuple.AdapterVersion,\n453|\t}\n454|}\n455|\n456|func rawEntryObjects(entries []RawObjectEntry) []any {\n457|\tobjects := make([]any, 0, len(entries))\n458|\tfor _, entry := range entries {\n459|\t\tobjects = append(objects, map[string]any{\n460|\t\t\t\"native_item_key\":    entry.NativeItemKey,\n461|\t\t\t\"class\":              entry.Class,\n462|\t\t\t\"byte_count\":         entry.ByteCount,\n463|\t\t\t\"blob_id\":            entry.BlobID.String(),\n464|\t\t\t\"blob_descriptor_id\": entry.BlobDescriptorID.String(),\n465|\t\t})\n466|\t}\n467|\treturn objects\n468|}\n469|\n470|func extensionValue(extensions map[string]any) map[string]any {\n471|\tif extensions == nil {\n472|\t\treturn map[string]any{}\n473|\t}\n474|\treturn extensions\n475|}\n476|\n477|func encodeExtensions(extensions map[string]any) ([]byte, error) {\n478|\tvalue := extensionValue(extensions)\n479|\tif !validExtensionText(value) {\n480|\t\treturn nil, invalid(\"extensions carry text that is not valid UTF-8\")\n481|\t}\n482|\tplain, err := json.Marshal(value)\n483|\tif err != nil {\n484|\t\treturn nil, invalid(\"extensions are not JSON: %v\", err)\n485|\t}\n486|\tif fault := checkExtensionsClosed(json.RawMessage(plain)); fault != nil {\n487|\t\treturn nil, invalid(\"extensions %s\", fault)\n488|\t}\n489|\treturn plain, nil\n490|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c48d","stream":{"kind":"session","id":"01a0b225-c4f5-7551-94b6-c0c601dc074b"},"sequence":161,"recorded_at":1780531400000317,"record_type":"event","durability":"durable","causation_id":"83118e98-b6d0-4b7d-9792-f7c513af3eac","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"83118e98-b6d0-4b7d-9792-f7c513af3eac","run_stream":{"kind":"run","id":"83118e98-b6d0-4b7d-9792-f7c513af3eac"},"call_id":"call_01a0b226079a7442b984620dd125e97e","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/clonebundle/captureitem.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n7|)\n8|\n9|// This file validates the CaptureItem, Capture Source Basis, and\n10|// Capture Boundary closed shapes of Clone Capture Manifest 1.0.0.\n11|// The manifest envelope itself lives in capturebuild.go.\n12|\n13|// captureClasses is the closed nine-class vocabulary Section 13.14.1\n14|// states for CaptureItem. It mirrors the sessadapter capture-plan\n15|// vocabulary over the same pinned section; membership here is the\n16|// manifest-side gate.\n17|var captureClasses = []string{\n18|\t\"durable_payload\",\n19|\t\"durable_index_required\",\n20|\t\"durable_sidecar\",\n21|\t\"derived_cache_optional\",\n22|\t\"credential\",\n23|\t\"machine_auth\",\n24|\t\"runtime_state\",\n25|\t\"transient_lock\",\n26|\t\"unknown\",\n27|}\n28|\n29|// ValidCaptureClass reports whether the name is a capture class.\n30|func ValidCaptureClass(name string) bool {\n31|\tfor _, class := range captureClasses {\n32|\t\tif class == name {\n33|\t\t\treturn true\n34|\t\t}\n35|\t}\n36|\treturn false\n37|}\n38|\n39|// alwaysExcludedClass reports whether the class is always excluded:\n40|// credential, auth, runtime, and lock classes are never included.\n41|func alwaysExcludedClass(class string) bool {\n42|\tswitch class {\n43|\tcase \"credential\", \"machine_auth\", \"runtime_state\", \"transient_lock\":\n44|\t\treturn true\n45|\tdefault:\n46|\t\treturn false\n47|\t}\n48|}\n49|\n50|var captureItemMembers = map[string]bool{\n51|\t\"native_item_key\":    true,\n52|\t\"class\":              true,\n53|\t\"disposition\":        true,\n54|\t\"blob_descriptor_id\": true,\n55|\t\"byte_count\":         true,\n56|\t\"exclusion_reason\":   true,\n57|\t\"extensions\":         true,\n58|}\n59|\n60|var captureItemRequired = []string{\n61|\t\"native_item_key\",\n62|\t\"class\",\n63|\t\"disposition\",\n64|\t\"blob_descriptor_id\",\n65|\t\"byte_count\",\n66|\t\"exclusion_reason\",\n67|\t\"extensions\",\n68|}\n69|\n70|// CaptureItem is one validated capture item.\n71|type CaptureItem struct {\n72|\tNativeItemKey    string\n73|\tClass            string\n74|\tDisposition      string\n75|\tBlobDescriptorID *scalar.Digest\n76|\tByteCount        *uint64\n77|\tExclusionReason  *string\n78|\tExtensions       map[string]any\n79|}\n80|\n81|// Included reports whether the item is an included row.\n82|func (item CaptureItem) Included() bool { return item.Disposition == \"included\" }\n83|\n84|// decodeCaptureItem validates one closed CaptureItem: the\n85|// included/excluded content rule, the always-excluded classes, and\n86|// the row-21 exclusion allowlist on the native key.\n87|func decodeCaptureItem(raw json.RawMessage, index int) (CaptureItem, error) {\n88|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n89|\tif fault != nil {\n90|\t\treturn CaptureItem{}, invalid(\"capture item[%d] %s (%s)\", index, fault.detail, memberField(fault.member))\n91|\t}\n92|\tif name, unknown := unknownMember(members, captureItemMembers); unknown {\n93|\t\treturn CaptureItem{}, invalid(\"capture item[%d] carries unknown member %q\", index, name)\n94|\t}\n95|\tif name, missing := missingMember(members, captureItemRequired); missing {\n96|\t\treturn CaptureItem{}, invalid(\"capture item[%d] misses a required member %q\", index, name)\n97|\t}\n98|\tkey, ok := checkStringBounds(members[\"native_item_key\"], 1, 512)\n99|\tif !ok {\n100|\t\treturn CaptureItem{}, invalid(\"capture item[%d] native_item_key is not a string[1..512]\", index)\n101|\t}\n102|\tif err := SanitizeNativeKey(key); err != nil {\n103|\t\treturn CaptureItem{}, err\n104|\t}\n105|\tif err := refuseExcludedMember(\"capture item\", key, index); err != nil {\n106|\t\treturn CaptureItem{}, err\n107|\t}\n108|\tclass, ok := rawString(members[\"class\"])\n109|\tif !ok || !ValidCaptureClass(class) {\n110|\t\treturn CaptureItem{}, invalid(\"capture item[%d] class %q is outside the nine-class vocabulary\", index, class)\n111|\t}\n112|\tdisposition, ok := rawString(members[\"disposition\"])\n113|\tif !ok || (disposition != \"included\" && disposition != \"excluded\") {\n114|\t\treturn CaptureItem{}, invalid(\"capture item[%d] disposition is outside included|excluded\", index)\n115|\t}\n116|\tvar descriptor *scalar.Digest\n117|\tif !isNull(members[\"blob_descriptor_id\"]) {\n118|\t\tvalue, ok := checkDigest(members[\"blob_descriptor_id\"])\n119|\t\tif !ok {\n120|\t\t\treturn CaptureItem{}, invalid(\"capture item[%d] blob_descriptor_id is not a digest\", index)\n121|\t\t}\n122|\t\tdescriptor = &value\n123|\t}\n124|\tvar count *uint64\n125|\tif !isNull(members[\"byte_count\"]) {\n126|\t\tvalue, ok := checkUint53Bounds(members[\"byte_count\"], 0, maxUint53)\n127|\t\tif !ok {\n128|\t\t\treturn CaptureItem{}, invalid(\"capture item[%d] byte_count is not a uint53\", index)\n129|\t\t}\n130|\t\tcount = &value\n131|\t}\n132|\tvar reason *string\n133|\tif !isNull(members[\"exclusion_reason\"]) {\n134|\t\tvalue, ok := checkStringBounds(members[\"exclusion_reason\"], 1, 128)\n135|\t\tif !ok {\n136|\t\t\treturn CaptureItem{}, invalid(\"capture item[%d] exclusion_reason is not a string[1..128]\", index)\n137|\t\t}\n138|\t\treason = &value\n139|\t}\n140|\tif err := checkItemDisposition(index, class, disposition, descriptor != nil, count != nil, reason != nil); err != nil {\n141|\t\treturn CaptureItem{}, err\n142|\t}\n143|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n144|\t\treturn CaptureItem{}, invalid(\"capture item[%d] extensions %s\", index, extensionsFault)\n145|\t}\n146|\tvar decodedExtensions map[string]any\n147|\tif err := json.Unmarshal(bytesTrimSpace(members[\"extensions\"]), &decodedExtensions); err != nil {\n148|\t\treturn CaptureItem{}, invalid(\"capture item[%d] extensions are not an object\", index)\n149|\t}\n150|\tif decodedExtensions == nil {\n151|\t\tdecodedExtensions = map[string]any{}\n152|\t}\n153|\treturn CaptureItem{\n154|\t\tNativeItemKey:    key,\n155|\t\tClass:            class,\n156|\t\tDisposition:      disposition,\n157|\t\tBlobDescriptorID: descriptor,\n158|\t\tByteCount:        count,\n159|\t\tExclusionReason:  reason,\n160|\t\tExtensions:       decodedExtensions,\n161|\t}, nil\n162|}\n163|\n164|// checkItemDisposition enforces the included/excluded rule: included\n165|// requires both content members non-null and a null reason; excluded\n166|// requires null content members and a non-null reason; the four\n167|// always-excluded classes are never included.\n168|func checkItemDisposition(index int, class, disposition string, hasDescriptor, hasCount, hasReason bool) error {\n169|\tif disposition == \"included\" {\n170|\t\tif alwaysExcludedClass(class) {\n171|\t\t\treturn invalid(\"capture item[%d] class %q is always excluded, never included\", index, class)\n172|\t\t}\n173|\t\tif !hasDescriptor || !hasCount {\n174|\t\t\treturn invalid(\"capture item[%d] included requires non-null descriptor and byte count\", index)\n175|\t\t}\n176|\t\tif hasReason {\n177|\t\t\treturn invalid(\"capture item[%d] included carries an exclusion reason\", index)\n178|\t\t}\n179|\t\treturn nil\n180|\t}\n181|\tif hasDescriptor || hasCount {\n182|\t\treturn invalid(\"capture item[%d] excluded carries content members\", index)\n183|\t}\n184|\tif !hasReason {\n185|\t\treturn invalid(\"capture item[%d] excluded requires a non-null exclusion reason\", index)\n186|\t}\n187|\treturn nil\n188|}\n189|\n190|// CaptureItemInput is one caller-supplied capture item candidate for\n191|// Build. Null members are nil pointers: BlobDescriptorID and\n192|// ByteCount for excluded rows, ExclusionReason for included rows.\n193|type CaptureItemInput struct {\n194|\tNativeItemKey    string\n195|\tClass            string\n196|\tDisposition      string\n197|\tBlobDescriptorID *string\n198|\tByteCount        *uint64\n199|\tExclusionReason  *string\n200|\tExtensions       map[string]any\n201|}\n202|\n203|func buildCaptureItem(input CaptureItemInput, index int) (CaptureItem, error) {\n204|\tif stringLength(input.NativeItemKey) < 1 || stringLength(input.NativeItemKey) > 512 {\n205|\t\treturn CaptureItem{}, invalid(\"capture item[%d] native_item_key is not a string[1..512]\", index)\n206|\t}\n207|\tif err := SanitizeNativeKey(input.NativeItemKey); err != nil {\n208|\t\treturn CaptureItem{}, err\n209|\t}\n210|\tif err := refuseExcludedMember(\"capture item\", input.NativeItemKey, index); err != nil {\n211|\t\treturn CaptureItem{}, err\n212|\t}\n213|\tif !ValidCaptureClass(input.Class) {\n214|\t\treturn CaptureItem{}, invalid(\"capture item[%d] class %q is outside the nine-class vocabulary\", index, input.Class)\n215|\t}\n216|\tif input.Disposition != \"included\" && input.Disposition != \"excluded\" {\n217|\t\treturn CaptureItem{}, invalid(\"capture item[%d] disposition is outside included|excluded\", index)\n218|\t}\n219|\tvar descriptor *scalar.Digest\n220|\tif input.BlobDescriptorID != nil {\n221|\t\tvalue, err := scalar.ParseDigest(*input.BlobDescriptorID)\n222|\t\tif err != nil {\n223|\t\t\treturn CaptureItem{}, invalid(\"capture item[%d] blob_descriptor_id is not a digest: %v\", index, err)\n224|\t\t}\n225|\t\tdescriptor = &value\n226|\t}\n227|\tvar count *uint64\n228|\tif input.ByteCount != nil {\n229|\t\tif *input.ByteCount > maxUint53 {\n230|\t\t\treturn CaptureItem{}, invalid(\"capture item[%d] byte_count exceeds uint53\", index)\n231|\t\t}\n232|\t\tkept := *input.ByteCount\n233|\t\tcount = &kept\n234|\t}\n235|\tvar reason *string\n236|\tif input.ExclusionReason != nil {\n237|\t\tif !validText(*input.ExclusionReason) {\n238|\t\t\treturn CaptureItem{}, invalid(\"capture item[%d] exclusion_reason is not valid UTF-8\", index)\n239|\t\t}\n240|\t\tif stringLength(*input.ExclusionReason) < 1 || stringLength(*input.ExclusionReason) > 128 {\n241|\t\t\treturn CaptureItem{}, invalid(\"capture item[%d] exclusion_reason is not a string[1..128]\", index)\n242|\t\t}\n243|\t\tkept := *input.ExclusionReason\n244|\t\treason = &kept\n245|\t}\n246|\tif err := checkItemDisposition(index, input.Class, input.Disposition, descriptor != nil, count != nil, reason != nil); err != nil {\n247|\t\treturn CaptureItem{}, err\n248|\t}\n249|\tif _, err := encodeExtensions(input.Extensions); err != nil {\n250|\t\treturn CaptureItem{}, invalid(\"capture item[%d]: %v\", index, err)\n251|\t}\n252|\treturn CaptureItem{\n253|\t\tNativeItemKey:    input.NativeItemKey,\n254|\t\tClass:            input.Class,\n255|\t\tDisposition:      input.Disposition,\n256|\t\tBlobDescriptorID: descriptor,\n257|\t\tByteCount:        count,\n258|\t\tExclusionReason:  reason,\n259|\t\tExtensions:       extensionValue(input.Extensions),\n260|\t}, nil\n261|}\n262|\n263|func captureItemObject(item CaptureItem) map[string]any {\n264|\tvar descriptor any\n265|\tif item.BlobDescriptorID != nil {\n266|\t\tdescriptor = item.BlobDescriptorID.String()\n267|\t}\n268|\tvar count any\n269|\tif item.ByteCount != nil {\n270|\t\tcount = *item.ByteCount\n271|\t}\n272|\tvar reason any\n273|\tif item.ExclusionReason != nil {\n274|\t\treason = *item.ExclusionReason\n275|\t}\n276|\treturn map[string]any{\n277|\t\t\"native_item_key\":    item.NativeItemKey,\n278|\t\t\"class\":              item.Class,\n279|\t\t\"disposition\":        item.Disposition,\n280|\t\t\"blob_descriptor_id\": descriptor,\n281|\t\t\"byte_count\":         count,\n282|\t\t\"exclusion_reason\":   reason,\n283|\t\t\"extensions\":         extensionValue(item.Extensions),\n284|\t}\n285|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c48f","stream":{"kind":"session","id":"01a0b225-c4f5-7551-94b6-c0c601dc074b"},"sequence":162,"recorded_at":1780531400000319,"record_type":"event","durability":"durable","causation_id":"83118e98-b6d0-4b7d-9792-f7c513af3eac","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"83118e98-b6d0-4b7d-9792-f7c513af3eac","run_stream":{"kind":"run","id":"83118e98-b6d0-4b7d-9792-f7c513af3eac"},"call_id":"call_01a0b226092d7151b81a9bbd6cc3cef7","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/clonebundle/identity.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"strings\"\n6|\t\"unicode\"\n7|\t\"unicode/utf8\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// This file validates the Section 13.14.1 identities: NativeIdentity,\n13|// WorkspaceBinding, and the sanitized native-key admission shared by\n14|// every native key in this package. Sanitized means printable,\n15|// relative, and unambiguously native: never an absolute source path,\n16|// never an AX Session identity, never carrying embedded credentials.\n17|\n18|var nativeIdentityMembers = map[string]bool{\n19|\t\"native_session_id\":         true,\n20|\t\"identity_kind\":             true,\n21|\t\"logical_workspace_id\":      true,\n22|\t\"backend_realm_fingerprint\": true,\n23|\t\"opaque_identity\":           true,\n24|\t\"extensions\":                true,\n25|}\n26|\n27|var nativeIdentityRequired = []string{\n28|\t\"native_session_id\",\n29|\t\"identity_kind\",\n30|\t\"logical_workspace_id\",\n31|\t\"backend_realm_fingerprint\",\n32|\t\"opaque_identity\",\n33|\t\"extensions\",\n34|}\n35|\n36|var nativeIdentityKinds = []string{\n37|\t\"provider_native\",\n38|\t\"official_import\",\n39|\t\"continuation_context\",\n40|}\n41|\n42|func validNativeIdentityKind(kind string) bool {\n43|\tfor _, allowed := range nativeIdentityKinds {\n44|\t\tif kind == allowed {\n45|\t\t\treturn true\n46|\t\t}\n47|\t}\n48|\treturn false\n49|}\n50|\n51|// NativeIdentity is one validated sanitized native identity.\n52|type NativeIdentity struct {\n53|\tNativeSessionID         string\n54|\tIdentityKind            string\n55|\tLogicalWorkspaceID      scalar.UUIDv7\n56|\tBackendRealmFingerprint *scalar.Digest\n57|\tOpaqueIdentity          *string\n58|}\n59|\n60|// DecodeNativeIdentity validates one closed NativeIdentity: exact\n61|// members, the closed identity-kind vocabulary, a sanitized native\n62|// session ID, a UUIDv7 logical workspace, an optional digest realm\n63|// fingerprint, an optional sanitized opaque identity, and\n64|// reverse-DNS extensions. Credential, absolute-path, PID, socket,\n65|// token, and secret-environment material is refused by the shared\n66|// sanitizer, never laundered into an identity.\n67|func DecodeNativeIdentity(raw json.RawMessage) (NativeIdentity, error) {\n68|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n69|\tif fault != nil {\n70|\t\treturn NativeIdentity{}, invalid(\"native identity %s (%s)\", fault.detail, memberField(fault.member))\n71|\t}\n72|\tif name, unknown := unknownMember(members, nativeIdentityMembers); unknown {\n73|\t\treturn NativeIdentity{}, invalid(\"native identity carries unknown member %q\", name)\n74|\t}\n75|\tif name, missing := missingMember(members, nativeIdentityRequired); missing {\n76|\t\treturn NativeIdentity{}, invalid(\"native identity misses a required member %q\", name)\n77|\t}\n78|\tnativeID, ok := checkStringBounds(members[\"native_session_id\"], 1, 512)\n79|\tif !ok {\n80|\t\treturn NativeIdentity{}, invalid(\"native identity native_session_id is not a string[1..512]\")\n81|\t}\n82|\tif err := SanitizeNativeKey(nativeID); err != nil {\n83|\t\treturn NativeIdentity{}, err\n84|\t}\n85|\tkind, ok := rawString(members[\"identity_kind\"])\n86|\tif !ok || !validNativeIdentityKind(kind) {\n87|\t\treturn NativeIdentity{}, invalid(\"native identity kind is outside provider_native|official_import|continuation_context\")\n88|\t}\n89|\tworkspaceID, ok := checkUUIDv7(members[\"logical_workspace_id\"])\n90|\tif !ok {\n91|\t\treturn NativeIdentity{}, invalid(\"native identity logical_workspace_id is not a UUIDv7\")\n92|\t}\n93|\tvar fingerprint *scalar.Digest\n94|\tif !isNull(members[\"backend_realm_fingerprint\"]) {\n95|\t\tdigest, ok := checkDigest(members[\"backend_realm_fingerprint\"])\n96|\t\tif !ok {\n97|\t\t\treturn NativeIdentity{}, invalid(\"native identity backend_realm_fingerprint is not a digest\")\n98|\t\t}\n99|\t\tfingerprint = &digest\n100|\t}\n101|\tvar opaque *string\n102|\tif !isNull(members[\"opaque_identity\"]) {\n103|\t\tvalue, ok := checkStringBounds(members[\"opaque_identity\"], 1, 512)\n104|\t\tif !ok {\n105|\t\t\treturn NativeIdentity{}, invalid(\"native identity opaque_identity is not a string[1..512]\")\n106|\t\t}\n107|\t\tif err := SanitizeNativeKey(value); err != nil {\n108|\t\t\treturn NativeIdentity{}, err\n109|\t\t}\n110|\t\topaque = &value\n111|\t}\n112|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n113|\t\treturn NativeIdentity{}, invalid(\"native identity extensions %s\", extensionsFault)\n114|\t}\n115|\treturn NativeIdentity{\n116|\t\tNativeSessionID:         nativeID,\n117|\t\tIdentityKind:            kind,\n118|\t\tLogicalWorkspaceID:      workspaceID,\n119|\t\tBackendRealmFingerprint: fingerprint,\n120|\t\tOpaqueIdentity:          opaque,\n121|\t}, nil\n122|}\n123|\n124|// EncodeNativeIdentity renders one validated identity as canonical\n125|// bytes under the given extensions. The native session ID and the\n126|// opaque identity are sanitized here, before marshaling —\n127|// encoding/json would otherwise rewrite invalid UTF-8 to U+FFFD and\n128|// the caller's re-decode would only ever see the rewritten bytes,\n129|// laundering a native key past the sanitizer's own refusal and\n130|// sealing two distinct inputs to byte-identical objects. The kind\n131|// refuses invalid UTF-8 here too, so no member the encoder seals is\n132|// ever rewritten. The extensions are validated here as well, so\n133|// encoding never admits what decoding refused. A nil extensions map\n134|// encodes as the empty object.\n135|func EncodeNativeIdentity(identity NativeIdentity, extensions map[string]any) ([]byte, error) {\n136|\tif !validText(identity.IdentityKind) {\n137|\t\treturn nil, invalid(\"native identity kind is not valid UTF-8\")\n138|\t}\n139|\tif err := SanitizeNativeKey(identity.NativeSessionID); err != nil {\n140|\t\treturn nil, err\n141|\t}\n142|\tif identity.OpaqueIdentity != nil {\n143|\t\tif err := SanitizeNativeKey(*identity.OpaqueIdentity); err != nil {\n144|\t\t\treturn nil, err\n145|\t\t}\n146|\t}\n147|\tif _, err := encodeExtensions(extensions); err != nil {\n148|\t\treturn nil, err\n149|\t}\n150|\tvar fingerprint any\n151|\tif identity.BackendRealmFingerprint != nil {\n152|\t\tfingerprint = identity.BackendRealmFingerprint.String()\n153|\t}\n154|\tvar opaque any\n155|\tif identity.OpaqueIdentity != nil {\n156|\t\topaque = *identity.OpaqueIdentity\n157|\t}\n158|\tif extensions == nil {\n159|\t\textensions = map[string]any{}\n160|\t}\n161|\treturn canonicalizeObject(map[string]any{\n162|\t\t\"native_session_id\":         identity.NativeSessionID,\n163|\t\t\"identity_kind\":             identity.IdentityKind,\n164|\t\t\"logical_workspace_id\":      identity.LogicalWorkspaceID.String(),\n165|\t\t\"backend_realm_fingerprint\": fingerprint,\n166|\t\t\"opaque_identity\":           opaque,\n167|\t\t\"extensions\":                extensions,\n168|\t})\n169|}\n170|\n171|var workspaceBindingMembers = map[string]bool{\n172|\t\"logical_workspace_id\":           true,\n173|\t\"cwd_relative\":                   true,\n174|\t\"repository_remote_fingerprints\": true,\n175|\t\"branch\":                         true,\n176|\t\"head_digest\":                    true,\n177|\t\"index_digest\":                   true,\n178|\t\"working_tree_digest\":            true,\n179|\t\"extensions\":                     true,\n180|}\n181|\n182|var workspaceBindingRequired = []string{\n183|\t\"logical_workspace_id\",\n184|\t\"cwd_relative\",\n185|\t\"repository_remote_fingerprints\",\n186|\t\"branch\",\n187|\t\"head_digest\",\n188|\t\"index_digest\",\n189|\t\"working_tree_digest\",\n190|\t\"extensions\",\n191|}\n192|\n193|// WorkspaceBinding is one validated closed workspace binding. No\n194|// member grants filesystem authority: the cwd is a normalized\n195|// relative path beneath the Workspace Group root, never an absolute\n196|// path or an escape.\n197|type WorkspaceBinding struct {\n198|\tLogicalWorkspaceID scalar.UUIDv7\n199|\tCwdRelative        string\n200|\tRemoteFingerprints []scalar.Digest\n201|\tBranch             *string\n202|\tHeadDigest         *scalar.Digest\n203|\tIndexDigest        *scalar.Digest\n204|\tWorkingTreeDigest  *scalar.Digest\n205|}\n206|\n207|// DecodeWorkspaceBinding validates one closed WorkspaceBinding.\n208|func DecodeWorkspaceBinding(raw json.RawMessage) (WorkspaceBinding, error) {\n209|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n210|\tif fault != nil {\n211|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding %s (%s)\", fault.detail, memberField(fault.member))\n212|\t}\n213|\tif name, unknown := unknownMember(members, workspaceBindingMembers); unknown {\n214|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding carries unknown member %q\", name)\n215|\t}\n216|\tif name, missing := missingMember(members, workspaceBindingRequired); missing {\n217|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding misses a required member %q\", name)\n218|\t}\n219|\tworkspaceID, ok := checkUUIDv7(members[\"logical_workspace_id\"])\n220|\tif !ok {\n221|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding logical_workspace_id is not a UUIDv7\")\n222|\t}\n223|\tcwd, ok := checkStringBounds(members[\"cwd_relative\"], 1, 4096)\n224|\tif !ok {\n225|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding cwd_relative is not a string[1..4096]\")\n226|\t}\n227|\tif err := checkCwdRelative(cwd); err != nil {\n228|\t\treturn WorkspaceBinding{}, err\n229|\t}\n230|\tfingerprints, ok := checkSortedUniqueDigests(members[\"repository_remote_fingerprints\"], 0, 128)\n231|\tif !ok {\n232|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding repository_remote_fingerprints are not sorted unique digest[0..128]\")\n233|\t}\n234|\tvar branch *string\n235|\tif !isNull(members[\"branch\"]) {\n236|\t\tvalue, ok := checkStringBounds(members[\"branch\"], 1, 1024)\n237|\t\tif !ok {\n238|\t\t\treturn WorkspaceBinding{}, invalid(\"workspace binding branch is not a string[1..1024]\")\n239|\t\t}\n240|\t\tbranch = &value\n241|\t}\n242|\thead, err := checkNullableDigest(members, \"head_digest\", \"workspace binding\")\n243|\tif err != nil {\n244|\t\treturn WorkspaceBinding{}, err\n245|\t}\n246|\tindex, err := checkNullableDigest(members, \"index_digest\", \"workspace binding\")\n247|\tif err != nil {\n248|\t\treturn WorkspaceBinding{}, err\n249|\t}\n250|\ttree, err := checkNullableDigest(members, \"working_tree_digest\", \"workspace binding\")\n251|\tif err != nil {\n252|\t\treturn WorkspaceBinding{}, err\n253|\t}\n254|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n255|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding extensions %s\", extensionsFault)\n256|\t}\n257|\treturn WorkspaceBinding{\n258|\t\tLogicalWorkspaceID: workspaceID,\n259|\t\tCwdRelative:        cwd,\n260|\t\tRemoteFingerprints: fingerprints,\n261|\t\tBranch:             branch,\n262|\t\tHeadDigest:         head,\n263|\t\tIndexDigest:        index,\n264|\t\tWorkingTreeDigest:  tree,\n265|\t}, nil\n266|}\n267|\n268|// checkCwdRelative admits exactly the normalized relative paths\n269|// beneath (or equal to) the Workspace Group root: scalar relative\n270|// paths plus the root itself (\".\"). Anything else — absolute,\n271|// escaped, backslashed, encoded-separator, or dot-segment forms —\n272|// would grant or smuggle filesystem authority and is refused.\n273|func checkCwdRelative(cwd string) error {\n274|\tif cwd == \".\" {\n275|\t\treturn nil\n276|\t}\n277|\tif _, err := scalar.ParseRelativePath(cwd); err != nil {\n278|\t\treturn invalid(\"workspace binding cwd_relative is not normalized beneath the workspace root: %v\", err)\n279|\t}\n280|\treturn nil\n281|}\n282|\n283|func checkNullableDigest(members map[string]json.RawMessage, name, owner string) (*scalar.Digest, error) {\n284|\traw, present := members[name]\n285|\tif !present {\n286|\t\treturn nil, invalid(\"%s misses a required member %q\", owner, name)\n287|\t}\n288|\tif isNull(raw) {\n289|\t\treturn nil, nil\n290|\t}\n291|\tdigest, ok := checkDigest(raw)\n292|\tif !ok {\n293|\t\treturn nil, invalid(\"%s %s is not a digest\", owner, name)\n294|\t}\n295|\treturn &digest, nil\n296|}\n297|\n298|// SanitizeNativeKey refuses every native key that is not sanitized:\n299|// empty values are refused here (over-long values by the caller's\n300|// bound check), and this gate refuses control characters (the full\n301|// Cc class, C0 and C1), invisible format characters (Cf, Zl, Zp:\n302|// zero-width and separator marks that render invisibly),\n303|// absolute-path forms, a UUIDv7 form (indistinguishable from a\n304|// fabricated AX Session identity), embedded-credential forms (a\n305|// password-style colon before the first @, with or without a\n306|// scheme), and AX-schema markers in any case. The pinned text does\n307|// not define the sanitizer's exact scope, so the implemented bound\n308|// is exactly this list, pinned by the sanitizer corpus and stated\n309|// in TRACEABILITY.md: ordinary spaces, @ without a password\n310|// colon, and colons without an @ all admit. A native key that\n311|// survives is printable, relative, and unambiguously native.\n312|func SanitizeNativeKey(key string) error {\n313|\tif key == \"\" {\n314|\t\treturn invalid(\"native key is empty\")\n315|\t}\n316|\tif !utf8.ValidString(key) {\n317|\t\treturn invalid(\"native key is not valid UTF-8\")\n318|\t}\n319|\tfor _, unit := range key {\n320|\t\tif unicode.IsControl(unit) {\n321|\t\t\treturn invalid(\"native key carries control characters\")\n322|\t\t}\n323|\t\tif unicode.Is(unicode.Cf, unit) || unicode.Is(unicode.Zl, unit) || unicode.Is(unicode.Zp, unit) {\n324|\t\t\treturn invalid(\"native key carries invisible format characters\")\n325|\t\t}\n326|\t}\n327|\tif strings.HasPrefix(key, \"/\") || strings.HasPrefix(key, `\\\\`) || hasDrivePrefix(key) {\n328|\t\treturn invalid(\"native key is an absolute source path, never a cross-host identity\")\n329|\t}\n330|\tif _, err := scalar.ParseUUIDv7(key); err == nil {\n331|\t\treturn invalid(\"native key %q is a UUIDv7, indistinguishable from a fabricated AX Session identity\", key)\n332|\t}\n333|\tif strings.Contains(strings.ToLower(key), \"urn:ax:\") {\n334|\t\treturn invalid(\"native key carries an AX identity marker\")\n335|\t}\n336|\tif at := strings.Index(key, \"@\"); at >= 0 && strings.Contains(key[:at], \":\") {\n337|\t\treturn invalid(\"native key carries embedded credentials\")\n338|\t}\n339|\treturn nil\n340|}\n341|\n342|func hasDrivePrefix(value string) bool {\n343|\treturn len(value) >= 3 && ((value[0] >= 'a' && value[0] <= 'z') || (value[0] >= 'A' && value[0] <= 'Z')) && value[1] == ':' && (value[2] == '/' || value[2] == '\\\\')\n344|}\n345|\n346|func memberField(member string) string {\n347|\tif member == \"\" {\n348|\t\treturn \"frame\"\n349|\t}\n350|\treturn \"member \" + member\n351|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
