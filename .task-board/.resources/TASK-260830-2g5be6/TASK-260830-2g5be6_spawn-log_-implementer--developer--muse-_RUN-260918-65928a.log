time=100x -parallel=1\\n  9 :: go test ./internal/canonicaljson -run=^$ -fuzz=^FuzzCanonicalizeRoundTrip$ -fuzztime=100x -parallel=1\\n  10 :: go test ./internal/canonicaljson -run=^$ -fuzz=^FuzzObjectIdentityRepresentationInvariant$ -fuzztime=100x -parallel=1\\n  11 :: go test ./internal/canonicaljson -run=^$ -fuzz=^FuzzClosedIdentityShapeRefusal$ -fuzztime=100x -parallel=1\\n  12 :: go test ./internal/canonicaljson -run=^$ -fuzz=^FuzzObservationEventRefusal$ -fuzztime=100x -parallel=1\\n  13 :: go test ./internal/secconftest -run=^$ -fuzz=^FuzzCheckArgv$ -fuzztime=100x -parallel=1\\n  14 :: go test ./internal/secconftest -run=^$ -fuzz=^FuzzCheckMemberPath$ -fuzztime=100x -parallel=1\\n  15 :: go test ./internal/secconftest -run=^$ -fuzz=^FuzzIsEnvName$ -fuzztime=100x -parallel=1\\n  16 :: go test ./internal/secconftest -run=^$ -fuzz=^FuzzRedactCorpus$ -fuzztime=100x -parallel=1\\n  17 :: go test ./internal/secconftest -run=^$ -fuzz=^FuzzEscapeForTerminal$ -fuzztime=100x -parallel=1\\n  18 :: go test ./internal/secconftest -run=^$ -fuzz=^FuzzRenderForTerminal$ -fuzztime=100x -parallel=1\\n  19 :: go test ./internal/secconftest -run=^$ -fuzz=^FuzzGuardResolve$ -fuzztime=100x -parallel=1\\n  20 :: go test ./internal/secconftest -run=^$ -fuzz=^FuzzDetectCaseCollision$ -fuzztime=100x -parallel=1\\n  21 :: go run ./internal/traceability/cmd/tracecheck\\n  22 :: go run ./internal/catalog/cmd/cataloggen -adopted -output internal/catalog/catalog_gen.go -check\\n  23 :: GOOS=linux GOARCH=amd64 go build ./...\\n  24 :: GOOS=windows GOARCH=amd64 go build ./...\\n  25 :: git ls-files -z '*.json' | xargs -0 -n1 python3 -c 'import json,sys;json.load(open(sys.argv[1]))'\\n  26 :: task-board validate\\n  27 :: git diff --check\\n\",\n  \"original_output_bytes\": 2195,\n  \"original_output_tokens\": 549,\n  \"truncated\": false\n}","final_result":true}}}
