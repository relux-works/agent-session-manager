{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9cd","stream":{"kind":"session","id":"01a0b225-c4f5-7551-94b6-c0c601dc074b"},"sequence":833,"recorded_at":1780531400001661,"record_type":"event","durability":"durable","causation_id":"83118e98-b6d0-4b7d-9792-f7c513af3eac","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"83118e98-b6d0-4b7d-9792-f7c513af3eac","run_stream":{"kind":"run","id":"83118e98-b6d0-4b7d-9792-f7c513af3eac"},"task_stream":{"kind":"task","id":"01a0b228-e426-7552-805b-67e5294ec424"},"task_id":"01a0b228-e426-7552-805b-67e5294ec424","event":{"kind":"output","task_id":"01a0b228-e426-7552-805b-67e5294ec424","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/secprim/path.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"os\"\n5|\t\"path\"\n6|\t\"strings\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|// CheckMemberPath admits one staging or archive member name on the given\n12|// platform under Section 16.3. The member is a slash-separated relative\n13|// path: the shared relative grammar (absolute, drive-qualified, backslash,\n14|// NUL, empty, dot, parent segments, and repeatedly encoded separators) is\n15|// decided by scalar.ParseRelativePath, which owns it. This gate adds only\n16|// the platform rules scalar does not own because they apply to member\n17|// names rather than to absolute paths:\n18|//\n19|//   - encoded dots and overlong separators (%2e, %c0%af, any case and %25\n20|//     nesting): an extension past scalar, because extraction stacks\n21|//     commonly percent-decode after validation and an admitted \"%2e%2e\"\n22|//     becomes a parent segment below this gate;\n23|//   - Windows alternate-stream and NTFS syntax: any colon outside a refused\n24|//     drive prefix (Section 16.3 \"alternate streams\");\n25|//   - Windows trailing dots and spaces per segment, which the filesystem\n26|//     strips and which therefore alias distinct members;\n27|//   - Windows reserved device names, decided by the same table scalar uses\n28|//     for absolute paths.\n29|func CheckMemberPath(platform scalar.Platform, member string) error {\n30|\tif _, err := scalar.ParseRelativePath(member); err != nil {\n31|\t\treturn failPath(\"member grammar\", memberErrorTarget(member))\n32|\t}\n33|\tif containsEncodedDot(member) {\n34|\t\treturn failPath(\"member encoded dot\", memberErrorTarget(member))\n35|\t}\n36|\tif containsOverlongSeparator(member) {\n37|\t\treturn failPath(\"member overlong separator\", memberErrorTarget(member))\n38|\t}\n39|\tif platform == scalar.PlatformWindows {\n40|\t\tfor _, segment := range strings.Split(member, \"/\") {\n41|\t\t\tif strings.Contains(segment, \":\") {\n42|\t\t\t\treturn failPath(\"member alternate stream\", memberErrorTarget(member))\n43|\t\t\t}\n44|\t\t\tif strings.HasSuffix(segment, \".\") || strings.HasSuffix(segment, \" \") {\n45|\t\t\t\treturn failPath(\"member trailing dot or space\", memberErrorTarget(member))\n46|\t\t\t}\n47|\t\t\tif scalar.IsReservedWindowsDeviceName(segment) {\n48|\t\t\t\treturn failPath(\"member reserved device name\", memberErrorTarget(member))\n49|\t\t\t}\n50|\t\t}\n51|\t}\n52|\treturn nil\n53|}\n54|\n55|// unwrapPercentEncoding folds %25 layers the way scalar's separator check\n56|// does, so a twice-encoded dot or separator cannot hide behind its outer\n57|// encoding.\n58|func unwrapPercentEncoding(value string) string {\n59|\tcandidate := strings.ToLower(value)\n60|\tfor {\n61|\t\tnext := strings.ReplaceAll(candidate, \"%25\", \"%\")\n62|\t\tif next == candidate {\n63|\t\t\treturn candidate\n64|\t\t}\n65|\t\tcandidate = next\n66|\t}\n67|}\n68|\n69|// containsEncodedDot reports a percent-encoded dot (%2e, any case, any\n70|// %25 nesting). scalar owns the encoded-separator rule (%2f/%5c) but not\n71|// encoded dots; this gate extends it because extraction stacks commonly\n72|// percent-decode after validation, turning an admitted \"%2e%2e\" into a\n73|// parent segment below this gate. A literal percent followed by other\n74|// hex (for example \"100%.txt\" or \"a%20b\") keeps passing through.\n75|func containsEncodedDot(member string) bool {\n76|\treturn strings.Contains(unwrapPercentEncoding(member), \"%2e\")\n77|}\n78|\n79|// containsOverlongSeparator reports the overlong UTF-8 encoding of slash\n80|// (%c0%af, any case, any %25 nesting), which some decoders accept as a\n81|// separator. Same ownership rationale as containsEncodedDot.\n82|func containsOverlongSeparator(member string) bool {\n83|\treturn strings.Contains(unwrapPercentEncoding(member), \"%c0%af\")\n84|}\n85|\n86|// memberErrorTarget names the refused member without echoing unbounded\n87|// foreign bytes: the first 64 characters identify the site for an\n88|// operator while a hostile multi-megabyte member cannot flood a log.\n89|func memberErrorTarget(member string) string {\n90|\tif len(member) > 64 {\n91|\t\treturn member[:64] + \"...\"\n92|\t}\n93|\treturn member\n94|}\n95|\n96|// Guard is a containment boundary for staging and extraction: a validated\n97|// absolute root on one platform plus the optional exact set of managed\n98|// member names that may be replaced. A nil managed set disables the\n99|// managed check; a non-nil set (even an empty one) restricts Resolve to\n100|// its members, so denying by default is representable and distinct from\n101|// not checking. The zero value is unusable; build one with NewGuard.\n102|type Guard struct {\n103|\troot         string\n104|\tplatform     scalar.Platform\n105|\tmanaged      map[string]bool\n106|\tcheckManaged bool\n107|}\n108|\n109|// NewGuard validates the staging root and records the managed set.\n110|// The root must be an absolute path on the platform: a relative root\n111|// fails here instead of resolving against the process working directory\n112|// at commit time.\n113|func NewGuard(root string, platform scalar.Platform, managed []string) (Guard, error) {\n114|\tif _, err := scalar.ParseAbsolutePath(platform, root); err != nil {\n115|\t\treturn Guard{}, failPath(\"guard root\", memberErrorTarget(root))\n116|\t}\n117|\tguard := Guard{root: root, platform: platform}\n118|\tif managed != nil {\n119|\t\tguard.checkManaged = true\n120|\t\tguard.managed = make(map[string]bool, len(managed))\n(more lines below)","final_result":true}}}
