lf(\"BuildRawObjectManifest() error = %v\", err)\n30|\t}\n31|\tif !bytes.Equal(first, second) {\n32|\t\tt.Fatal(\"BuildRawObjectManifest identical inputs produced different bytes\")\n33|\t}\n34|\tmanifest, err := DecodeRawObjectManifest(first)\n35|\tif err != nil {\n36|\t\tt.Fatalf(\"DecodeRawObjectManifest() error = %v\", err)\n37|\t}\n38|\tif len(manifest.Entries) != 2 {\n39|\t\tt.Fatalf(\"DecodeRawObjectManifest entries = %d, want 2\", len(manifest.Entries))\n40|\t}\n41|\tvar sum uint64\n42|\tfor _, entry := range manifest.Entries {\n43|\t\tsum += entry.ByteCount\n44|\t}\n45|\tif manifest.TotalBytes != sum {\n46|\t\tt.Fatalf(\"TotalBytes = %d, entries sum to %d\", manifest.TotalBytes, sum)\n47|\t}\n48|\tif manifest.SourceNativeSessionID != \"native-session-alpha\" {\n49|\t\tt.Fatalf(\"SourceNativeSessionID = %q\", manifest.SourceNativeSessionID)\n50|\t}\n51|\tbyKey := map[string]RawObjectEntry{}\n52|\tfor _, entry := range manifest.Entries {\n53|\t\tbyKey[entry.NativeItemKey] = entry\n54|\t}\n55|\tfetch := map[string][]byte{}\n56|\tfor index, input := range inputs {\n57|\t\tfetch[manifest.Entries[index].BlobDescriptorID.String()] = input.Descriptor\n58|\t}\n59|\tif err := VerifyRawManifestDescriptors(manifest, func(id string) ([]byte, error) {\n60|\t\tdescriptor, ok := fetch[id]\n61|\t\tif !ok {\n62|\t\t\tt.Fatalf(\"descriptor fetch missed %s\", id)\n63|\t\t}\n64|\t\treturn descriptor, nil\n65|\t}); err != nil {\n66|\t\tt.Fatalf(\"VerifyRawManifestDescriptors() error = %v\", err)\n67|\t}\n68|\tif byKey[\"store/blob-a\"].Class != \"durable_payload\" || byKey[\"store/blob-b\"].Class != \"durable_sidecar\" {\n69|\t\tt.Fatalf(\"entry classes = %q, %q\", byKey[\"store/blob-a\"].Class, byKey[\"store/blob-b\"].Class)\n70|\t}\n71|}\n72|\n73|func TestBuildCaptureManifestDerivesRawComplete(t *testing.T) {\n74|\tinput := validCaptureInput(t)\n75|\tbuilt, err := BuildCaptureManifest(input)\n76|\tif err != nil {\n77|\t\tt.Fatalf(\"BuildCaptureManifest() error = %v\", err)\n78|\t}\n79|\trebuilt, err := BuildCaptureManifest(input)\n80|\tif err != nil {\n81|\t\tt.Fatalf(\"BuildCaptureManifest() error = %v\", err)\n82|\t}\n83|\tif !bytes.Equal(built, rebuilt) {\n84|\t\tt.Fatal(\"BuildCaptureManifest identical inputs produced different bytes\")\n85|\t}\n86|\tmanifest, err := DecodeCaptureManifest(built)\n87|\tif err != nil {\n88|\t\tt.Fatalf(\"DecodeCaptureManifest() error = %v\", err)\n89|\t}\n90|\tif !manifest.RawComplete {\n91|\t\tt.Fatal(\"RawComplete = false, want true after complete reconciliation\")\n92|\t}\n93|\tif len(manifest.ExcludedClasses) != 1 || manifest.ExcludedClasses[0] != \"credential\" {\n94|\t\tt.Fatalf(\"ExcludedClasses = %v, want [credential]\", manifest.ExcludedClasses)\n95|\t}\n96|\tif err := VerifyCaptureReconciliation(manifest, input.PlanKeys, input.RawKeys); err != nil {\n97|\t\tt.Fatalf(\"VerifyCaptureReconciliation() error = %v\", err)\n98|\t}\n99|\tif err := RefuseMaximalSafeUnlessComplete(manifest); err != nil {\n100|\t\tt.Fatalf(\"RefuseMaximalSafeUnlessComplete() error = %v\", err)\n101|\t}\n102|\tif !manifest.CaptureBoundary.Stable() {\n103|\t\tt.Fatal(\"CaptureBoundary is not stable\")\n104|\t}\n105|}\n106|\n107|func TestBuildCaptureManifestUnknownMakesIncomplete(t *testing.T) {\n108|\tinput := validCaptureInput(t)\n109|\tcount := uint64(9)\n110|\tdescriptor := fixtureDigest(\"test-descriptor\")\n111|\tinput.Items = append(input.Items, CaptureItemInput{\n112|\t\tNativeItemKey: \"store/zz-unknown\", Class: \"unknown\", Disposition: \"included\",\n113|\t\tBlobDescriptorID: &descriptor, ByteCount: &count,\n114|\t})\n115|\tinput.PlanKeys = append(input.PlanKeys, \"store/zz-unknown\")\n116|\tinput.RawKeys = append(input.RawKeys, \"store/zz-unknown\")\n117|\tbuilt, err := BuildCaptureManifest(input)\n118|\tif err != nil {\n119|\t\tt.Fatalf(\"BuildCaptureManifest() error = %v\", err)\n120|\t}\n(more lines below)","final_result":true}}}
