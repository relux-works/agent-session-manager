c DigestPathV1(digest scalar.Digest, style PathStyle) (string, error) {\n42|\tcomponents, err := digestPathComponents(digest)\n43|\tif err != nil {\n44|\t\treturn \"\", err\n45|\t}\n46|\tseparator := \"\"\n47|\tswitch style {\n48|\tcase PathStylePOSIX:\n49|\t\tseparator = \"/\"\n50|\tcase PathStyleWindows:\n51|\t\tseparator = `\\`\n52|\tdefault:\n53|\t\treturn \"\", fmt.Errorf(\"%w: %q\", ErrInvalidPathStyle, style)\n54|\t}\n55|\treturn strings.Join(components[:], separator), nil\n56|}\n57|\n58|// digestPathComponents is the single owner of the digest_path_v1 split. Every\n59|// durable namespace in this package joins these exact components beneath its\n60|// own root instead of re-deriving the shard and leaf independently.\n61|func digestPathComponents(digest scalar.Digest) ([3]string, error) {\n62|\thexDigest := digest.Hex()\n63|\tif len(hexDigest) != sha256.Size*2 {\n64|\t\treturn [3]string{}, fmt.Errorf(\"%w: malformed digest\", ErrInvalidPath)\n65|\t}\n66|\treturn [3]string{\"sha256\", hexDigest[:2], hexDigest[2:]}, nil\n67|}\n68|\n69|func nativeDigestPath(root string, digest scalar.Digest) (string, error) {\n70|\tcomponents, err := digestPathComponents(digest)\n71|\tif err != nil {\n72|\t\treturn \"\", err\n73|\t}\n74|\treturn filepath.Join(root, components[0], components[1], components[2]), nil\n75|}\n76|\n77|type PutResult struct {\n78|\tDigest                 scalar.Digest\n79|\tSize                   uint64\n80|\tPath                   string\n81|\tInstalled              bool\n82|\tQuarantinePath         string\n83|\tExistingQuarantinePath string\n84|}\n85|\n86|type storeOperations struct {\n87|\tsyncFile      func(*os.File) error\n88|\tinstall       func(string, string) error\n89|\tsyncDirectory func(string) error\n90|\t// openExisting reads the entry already occupying a digest path. It is a\n91|\t// seam because the classification that depends on it — a read that did not\n92|\t// complete is a durability failure, never a proven mismatch — is otherwise\n93|\t// reachable only through descriptor exhaustion or real media failure.\n94|\topenExisting blobOpener\n95|}\n96|\n97|func defaultStoreOperations() storeOperations {\n98|\treturn storeOperations{\n99|\t\tsyncFile: func(file *os.File) error { return file.Sync() },\n100|\t\tinstall:  atomicRenameNoReplace,\n101|\t\tsyncDirectory: func(directory string) error {\n102|\t\t\treturn syncDirectory(directory)\n103|\t\t},\n104|\t\topenExisting: openBlobFile,\n105|\t}\n106|}\n107|\n108|type ObjectStore struct {\n109|\tdataRoot   string\n110|\tobjects    string\n111|\tquarantine string\n112|\toperations storeOperations\n113|\tmu         sync.Mutex\n114|}\n115|\n116|// OpenObjectStore creates or verifies the owner-only local roots and opens the\n117|// live blob namespace. It does not expose this root to a plugin or peer.\n118|func OpenObjectStore(paths ResolvedPaths) (*ObjectStore, error) {\n119|\tif err := InitializeLayout(paths); err != nil {\n120|\t\treturn nil, err\n121|\t}\n122|\tdata, ok := paths.Path(PathData)\n123|\tif !ok {\n124|\t\treturn nil, fmt.Errorf(\"%w: missing data root\", ErrInvalidPath)\n125|\t}\n126|\tdataRoot := data.Value.String()\n127|\tif err := ensureOwnerChildTree(dataRoot, \"objects\", \"sha256\"); err != nil {\n128|\t\treturn nil, fmt.Errorf(\"initialize object namespace: %w\", err)\n129|\t}\n130|\tif err := ensureOwnerChildTree(dataRoot, \"quarantine\", \"sha256\"); err != nil {\n131|\t\treturn nil, fmt.Errorf(\"initialize quarantine namespace: %w\", err)\n132|\t}\n133|\treturn &ObjectStore{\n134|\t\tdataRoot: dataRoot, objects: filepath.Join(dataRoot, \"objects\"),\n135|\t\tquarantine: filepath.Join(dataRoot, \"quarantine\"), operations: defaultStoreOperations(),\n136|\t}, nil\n137|}\n138|\n139|func (store *ObjectStore) DataRoot() string { return store.dataRoot }\n140|\n141|// PutBlob is the production immutable-write entry point. It stages in the\n142|// destination directory, fsyncs, verifies the declared uint53 size and SHA-256,\n143|// atomically renames, then fsyncs the containing directory. An identical retry\n144|// verifies and reuses the existing inode. Mismatches are installed create-new\n145|// in quarantine and never enter the immutable namespace.\n146|//\n147|// Quarantine of an entry that already occupies the digest path is authorized\n148|// only by a completed, disagreeing read, which is the SPEC.md Section 3.2\n149|// trigger. An inspection whose read did not complete is a durability failure:\n150|// PutBlob reports it and moves nothing, because a flaky read would otherwise\n151|// permanently sideline a valid immutable object.\n152|func (store *ObjectStore) PutBlob(expected scalar.Digest, expectedSize uint64, source io.Reader) (PutResult, error) {\n153|\tif store == nil || store.operations.syncFile == nil || store.operations.install == nil ||\n154|\t\tstore.operations.syncDirectory == nil || store.operations.openExisting == nil {\n155|\t\treturn PutResult{}, fmt.Errorf(\"%w: object store is not initialized\", ErrDurability)\n156|\t}\n157|\tif expectedSize > MaxBlobSize {\n158|\t\treturn PutResult{}, fmt.Errorf(\"%w: must be at most uint53\", ErrInvalidBlobSize)\n159|\t}\n160|\tif source == nil {\n161|\t\treturn PutResult{}, fmt.Errorf(\"%w: source is nil\", ErrIntegrityMismatch)\n162|\t}\n163|\tif _, err := scalar.ParseDigest(expected.String()); err != nil {\n164|\t\treturn PutResult{}, fmt.Errorf(\"%w: expected digest: %v\", ErrIntegrityMismatch, err)\n165|\t}\n166|\n167|\tstore.mu.Lock()\n168|\tdefer store.mu.Unlock()\n169|\n170|\ttarget, err := nativeDigestPath(store.objects, expected)\n171|\tif err != nil {\n172|\t\treturn PutResult{}, fmt.Errorf(\"%w: object path: %v\", ErrIntegrityMismatch, err)\n173|\t}\n174|\tshardDirectory := filepath.Dir(target)\n175|\tif err := ensureOwnerChildTree(store.objects, \"sha256\", expected.Hex()[:2]); err != nil {\n176|\t\treturn PutResult{}, fmt.Errorf(\"%w: create object shard: %v\", ErrDurability, err)\n177|\t}\n178|\tstaged, err := os.CreateTemp(shardDirectory, stagedFilePrefix)\n179|\tif err != nil {\n180|\t\treturn PutResult{}, fmt.Errorf(\"%w: create staged blob: %v\", ErrDurability, err)\n181|\t}\n182|\tstagedPath := staged.Name()\n183|\tstagedClosed := false\n184|\tdefer func() {\n185|\t\tif !stagedClosed {\n186|\t\t\t_ = staged.Close()\n187|\t\t}\n188|\t\t_ = os.Remove(stagedPath)\n189|\t}()\n190|\tif err := staged.Chmod(0o600); err != nil {\n191|\t\treturn PutResult{}, fmt.Errorf(\"%w: set staged mode: %v\", ErrDurability, err)\n192|\t}\n193|\n194|\thasher := sha256.New()\n195|\twritten, copyErr := io.Copy(io.MultiWriter(staged, hasher), io.LimitReader(source, int64(expectedSize)+1))\n196|\tif copyErr != nil {\n197|\t\treturn PutResult{}, fmt.Errorf(\"%w: stage bytes: %v\", ErrDurability, copyErr)\n198|\t}\n199|\tif err := store.operations.syncFile(staged); err != nil {\n200|\t\treturn PutResult{}, fmt.Errorf(\"%w: fsync staged blob: %v\", ErrDurability, err)\n201|\t}\n202|\tinfo, err := staged.Stat()\n203|\tif err != nil {\n204|\t\treturn PutResult{}, fmt.Errorf(\"%w: stat staged blob: %v\", ErrDurability, err)\n205|\t}\n206|\tif err := verifyOwnerFileInfo(info, 0o600); err != nil {\n207|\t\treturn PutResult{}, fmt.Errorf(\"%w: staged blob: %v\", ErrDurability, err)\n208|\t}\n209|\tif err := staged.Close(); err != nil {\n210|\t\treturn PutResult{}, fmt.Errorf(\"%w: close staged blob: %v\", ErrDurability, err)\n211|\t}\n212|\tstagedClosed = true\n213|\n214|\tactualDigest, err := scalar.ParseDigest(\"sha256:\" + hex.EncodeToString(hasher.Sum(nil)))\n215|\tif err != nil {\n216|\t\treturn PutResult{}, fmt.Errorf(\"%w: calculate staged digest: %v\", ErrDurability, err)\n217|\t}\n218|\tactualSize := uint64(written)\n219|\t// A staged write that did not durably keep what the copy accepted proves\n220|\t// nothing about the source bytes. A volume that fills discovers ENOSPC at\n221|\t// writeback rather than at the accepting write, so the byte count the copy\n222|\t// reported and the length the filesystem kept can disagree without either\n223|\t// side raising an error. That is a durability failure, the exact mirror of\n224|\t// the rule verifyBlobContent owns for reads: an operation that did not\n225|\t// complete is never a proven mismatch. The partial candidate is discarded\n226|\t// by the deferred cleanup instead of being quarantined as disagreeing\n227|\t// evidence, because quarantining it would both misattribute the fault and\n228|\t// consume more of the space that just ran out. The negative length term is\n229|\t// unreachable through os.FileInfo and is stated for the same reason the\n230|\t// projection states it: the comparison below is unsigned.\n231|\tif info.Size() < 0 || uint64(info.Size()) != actualSize {\n232|\t\treturn PutResult{}, fmt.Errorf(\"%w: staged write kept %d of %d accepted bytes\",\n233|\t\t\tErrDurability, info.Size(), actualSize)\n234|\t}\n235|\tif actualSize != expectedSize || actualDigest != expected {\n236|\t\tquarantinePath, quarantineErr := store.quarantineStaged(expected, stagedPath)\n237|\t\tif quarantineErr != nil {\n238|\t\t\treturn PutResult{}, fmt.Errorf(\"%w: mismatch and quarantine failed: %v\", ErrDurability, quarantineErr)\n239|\t\t}\n240|\t\treturn PutResult{Digest: actualDigest, Size: actualSize, QuarantinePath: quarantinePath},\n241|\t\t\tfmt.Errorf(\"%w: declared and staged identity differ\", ErrIntegrityMismatch)\n242|\t}\n243|\n244|\tresult := PutResult{Digest: expected, Size: expectedSize, Path: target}\n245|\tinspection := store.inspectExisting(target, expected, expectedSize)\n246|\tif inspection.verdict != blobAbsent {\n247|\t\treturn store.resolveExistingEntry(inspection, expected, stagedPath, target, result, \"\")\n248|\t}\n249|\n250|\tif err := store.operations.install(stagedPath, target); err != nil {\n251|\t\tif errors.Is(err, os.ErrExist) {\n252|\t\t\traced := store.inspectExisting(target, expected, expectedSize)\n253|\t\t\tif raced.verdict != blobAbsent {\n254|\t\t\t\treturn store.resolveExistingEntry(raced, expected, stagedPath, target, result, \"raced \")\n255|\t\t\t}\n256|\t\t}\n257|\t\treturn PutResult{}, fmt.Errorf(\"%w: atomic no-replace rename: %v\", ErrDurability, err)\n258|\t}\n259|\tresult.Installed = true\n260|\tif err := store.operations.syncDirectory(shardDirectory); err != nil {\n261|\t\treturn result, fmt.Errorf(\"%w: fsync object directory after rename: %v\", ErrDurability, err)\n262|\t}\n263|\treturn result, nil\n264|}\n265|\n266|// resolveExistingEntry maps one inspection verdict onto the single consequence\n267|// Section 3.2 allows for it. Both the first-attempt and the raced post-rename\n268|// paths funnel through here, so the two cannot drift apart: a read that did not\n269|// complete is a durability failure that moves nothing, and only a completed,\n270|// disagreeing read reaches quarantineExisting.\n271|func (store *ObjectStore) resolveExistingEntry(\n272|\tinspection blobInspection, expected scalar.Digest, stagedPath, target string,\n273|\tresult PutResult, label string,\n274|) (PutResult, error) {\n275|\tif inspection.verdict == blobMatches {\n276|\t\treturn result, nil\n277|\t}\n278|\tif inspection.verdict == blobUnreadable {\n279|\t\t// The bytes on disk were never established, so nothing is proven and\n280|\t\t// nothing may move. The staged candidate is discarded by PutBlob's\n281|\t\t// deferred cleanup and the existing object stays exactly where it is.\n282|\t\treturn PutResult{}, fmt.Errorf(\"%w: inspect %sexisting digest path: %v\", ErrDurability, label, inspection.err)\n283|\t}\n284|\tcandidateQuarantine, quarantineErr := store.quarantineStaged(expected, stagedPath)\n285|\tif quarantineErr != nil {\n286|\t\treturn PutResult{}, fmt.Errorf(\"%w: %sexisting conflict and candidate quarantine failed: %v\",\n287|\t\t\tErrDurability, label, quarantineErr)\n288|\t}\n289|\tresult.QuarantinePath = candidateQuarantine\n290|\tif !inspection.verdict.quarantineWarranted() {\n291|\t\treturn result, fmt.Errorf(\"%w: unsafe %sdigest-path entry: %v\", ErrImmutableConflict, label, inspection.err)\n292|\t}\n293|\texistingQuarantine, quarantineErr := store.quarantineExisting(expected, target)\n294|\tif quarantineErr != nil {\n295|\t\treturn result, fmt.Errorf(\"%w: %v; %sexisting quarantine failed: %v\",\n296|\t\t\tErrImmutableConflict, inspection.err, label, quarantineErr)\n297|\t}\n298|\tresult.ExistingQuarantinePath = existingQuarantine\n299|\treturn result, fmt.Errorf(\"%w: %sexisting digest path failed verification: %v\",\n300|\t\tErrImmutableConflict, label, inspection.err)\n301|}\n302|\n303|// inspectExisting classifies whatever occupies the digest path. It never\n304|// decides a consequence; it reports only what was proven. Content comparison is\n305|// delegated to verifyBlobContent, the classifier the projection source scan\n306|// also uses, so a failed read cannot become a mismatch on this path alone.\n307|func (store *ObjectStore) inspectExisting(target string, expected scalar.Digest, expectedSize uint64) blobInspection {\n308|\tinfo, err := os.Lstat(target)\n309|\tif errors.Is(err, os.ErrNotExist) {\n310|\t\treturn blobInspection{verdict: blobAbsent}\n311|\t}\n312|\tif err != nil {\n313|\t\treturn blobInspection{verdict: blobUnreadable, err: fmt.Errorf(\"lstat digest path: %w\", err)}\n314|\t}\n315|\tif !info.Mode().IsRegular() || info.Mode()&os.ModeSymlink != 0 {\n316|\t\treturn blobInspection{verdict: blobUnsafe, err: fmt.Errorf(\"%w: target is not a regular file\", ErrUnsafeOwnership)}\n317|\t}\n318|\tif err := verifyOwnerFileInfo(info, 0o600); err != nil {\n319|\t\tif !errors.Is(err, ErrUnsafeOwnership) {\n320|\t\t\treturn blobInspection{verdict: blobUnreadable, err: err}\n321|\t\t}\n322|\t\treturn blobInspection{verdict: blobUnsafe, err: err}\n323|\t}\n324|\treturn verifyBlobContent(store.operations.openExisting, target, expected, expectedSize)\n325|}\n326|\n327|func (store *ObjectStore) quarantineStaged(expected scalar.Digest, stagedPath string) (string, error) {\n328|\tdirectory, err := store.quarantineDigestDirectory(expected)\n329|\tif err != nil {\n330|\t\treturn \"\", err\n331|\t}\n332|\treturn store.moveToQuarantine(stagedPath, directory)\n333|}\n334|\n335|func (store *ObjectStore) quarantineExisting(expected scalar.Digest, target string) (string, error) {\n336|\tdirectory, err := store.quarantineDigestDirectory(expected)\n337|\tif err != nil {\n338|\t\treturn \"\", err\n339|\t}\n340|\tdestination, err := store.moveToQuarantine(target, directory)\n341|\tif err != nil {\n342|\t\treturn destination, err\n343|\t}\n344|\tif err := store.operations.syncDirectory(filepath.Dir(target)); err != nil {\n345|\t\treturn destination, err\n346|\t}\n347|\treturn destination, nil\n348|}\n349|\n350|func (store *ObjectStore) moveToQuarantine(source, directory string) (string, error) {\n351|\tfor attempts := 0; attempts < 8; attempts++ {\n352|\t\tdestination, err := uniqueQuarantinePath(directory)\n353|\t\tif err != nil {\n354|\t\t\treturn \"\", err\n355|\t\t}\n356|\t\tif err := store.operations.install(source, destination); err != nil {\n357|\t\t\tif errors.Is(err, os.ErrExist) {\n358|\t\t\t\tcontinue\n359|\t\t\t}\n360|\t\t\treturn \"\", err\n361|\t\t}\n362|\t\tif err := store.operations.syncDirectory(directory); err != nil {\n363|\t\t\treturn destination, err\n364|\t\t}\n365|\t\treturn destination, nil\n366|\t}\n367|\treturn \"\", fmt.Errorf(\"allocate create-new quarantine destination\")\n368|}\n369|\n370|func (store *ObjectStore) quarantineDigestDirectory(digest scalar.Digest) (string, error) {\n371|\tcomponents, err := digestPathComponents(digest)\n372|\tif err != nil {\n373|\t\treturn \"\", err\n374|\t}\n375|\tif err := ensureOwnerChildTree(store.quarantine, components[:]...); err != nil {\n376|\t\treturn \"\", err\n377|\t}\n378|\treturn nativeDigestPath(store.quarantine, digest)\n379|}\n380|\n381|func uniqueQuarantinePath(directory string) (string, error) {\n382|\tfor attempts := 0; attempts < 8; attempts++ {\n383|\t\tidentifier, err := newUUIDv7()\n384|\t\tif err != nil {\n385|\t\t\treturn \"\", err\n386|\t\t}\n387|\t\tcandidate := filepath.Join(directory, identifier)\n388|\t\tif _, err := os.Lstat(candidate); errors.Is(err, os.ErrNotExist) {\n389|\t\t\treturn candidate, nil\n390|\t\t} else if err != nil {\n391|\t\t\treturn \"\", err\n392|\t\t}\n393|\t}\n394|\treturn \"\", fmt.Errorf(\"allocate unique quarantine identifier\")\n395|}\n396|\n397|func newUUIDv7() (string, error) {\n398|\tvar value [16]byte\n399|\tmilliseconds := uint64(time.Now().UnixMilli())\n400|\tvalue[0] = byte(milliseconds >> 40)\n401|\tvalue[1] = byte(milliseconds >> 32)\n402|\tvalue[2] = byte(milliseconds >> 24)\n403|\tvalue[3] = byte(milliseconds >> 16)\n404|\tvalue[4] = byte(milliseconds >> 8)\n405|\tvalue[5] = byte(milliseconds)\n406|\tif _, err := rand.Read(value[6:]); err != nil {\n407|\t\treturn \"\", err\n408|\t}\n409|\tvalue[6] = value[6]&0x0f | 0x70\n410|\tvalue[8] = value[8]&0x3f | 0x80\n411|\treturn fmt.Sprintf(\"%08x-%04x-%04x-%04x-%012x\",\n412|\t\tvalue[0:4], value[4:6], value[6:8], value[8:10], value[10:16]), nil\n413|}\n414|\n415|func ensureOwnerChildTree(root string, elements ...string) error {\n416|\tif err := verifyOwnerDirectory(root); err != nil {\n417|\t\treturn err\n418|\t}\n419|\tcurrent := root\n420|\tfor _, element := range elements {\n421|\t\tif element == \"\" || element == \".\" || element == \"..\" || strings.ContainsAny(element, `/\\`) {\n422|\t\t\treturn fmt.Errorf(\"%w: unsafe child component\", ErrInvalidPath)\n423|\t\t}\n424|\t\tcurrent = filepath.Join(current, element)\n425|\t\tif err := ensureOwnerDirectory(current); err != nil {\n426|\t\t\treturn err\n427|\t\t}\n428|\t}\n429|\treturn nil\n430|}","final_result":true}}}
