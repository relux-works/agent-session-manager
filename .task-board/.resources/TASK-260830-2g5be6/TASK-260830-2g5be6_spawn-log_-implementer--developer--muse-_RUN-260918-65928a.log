exit_code, elapsed = run_mutant(mutant)\n796|        except subprocess.TimeoutExpired:\n797|            line, output, exit_code, elapsed = f\"ERROR: {mutant.name}: killer timed out\", \"\", -1, 0.0\n798|        print(line, flush=True)\n799|        if log_dir is not None:\n800|            (log_dir / f\"{mutant.name}.log\").write_text(\n801|                f\"# mutant={mutant.name} path={mutant.path} -run={mutant.run}\\n\"\n802|                f\"# exit={exit_code} elapsed={elapsed:.1f}s\\n\"\n803|                f\"# find={mutant.find!r}\\n# replace={mutant.replace!r}\\n---\\n{output}\\n\"\n804|            )\n805|        if not line.startswith(\"ok:\"):\n806|            failures += 1\n807|    return 1 if failures else 0\n808|\n809|\n810|if __name__ == \"__main__\":\n811|    sys.exit(main(sys.argv[1:]))","final_result":true}}}
