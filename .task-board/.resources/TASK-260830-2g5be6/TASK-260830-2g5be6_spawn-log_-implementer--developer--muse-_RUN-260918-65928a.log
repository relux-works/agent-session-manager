{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4d9","stream":{"kind":"session","id":"01a0b225-c4f5-7551-94b6-c0c601dc074b"},"sequence":199,"recorded_at":1780531400000393,"record_type":"event","durability":"durable","causation_id":"83118e98-b6d0-4b7d-9792-f7c513af3eac","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"83118e98-b6d0-4b7d-9792-f7c513af3eac","run_stream":{"kind":"run","id":"83118e98-b6d0-4b7d-9792-f7c513af3eac"},"call_id":"call_01a0b226113b7151a9fde7832bd62c40","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/clonebundle/decode.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"reflect\"\n8|\t\"strconv\"\n9|\t\"strings\"\n10|\t\"unicode/utf8\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|)\n16|\n17|// This file holds parse-only helpers for every Section 13.14.1 closed\n18|// shape. Helpers report verdicts; every refusal is constructed at the\n19|// deciding site with a literal detail so each rule stays a distinct\n20|// gate. Strict object decoding and extension admission delegate to the\n21|// landed environ owner; tuple decoding delegates to sessadapter at the\n22|// call site.\n23|\n24|const maxUint53 = uint64(1<<53 - 1)\n25|\n26|// maxSafeInteger is the AX safe-integer magnitude bound: extension\n27|// values must fall in [-maxSafeInteger, maxSafeInteger], mirroring\n28|// the canonicaljson identity guarantee.\n29|const maxSafeInteger = int64(1<<53 - 1)\n30|\n31|type frameFault struct {\n32|\tdetail string\n33|\tmember string\n34|}\n35|\n36|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n37|\tmembers, fault := environ.DecodeStrictObject(data)\n38|\tif fault != nil {\n39|\t\treturn nil, &frameFault{detail: fault.Detail, member: fault.Member}\n40|\t}\n41|\treturn members, nil\n42|}\n43|\n44|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n45|\tfor name := range members {\n46|\t\tif !allowed[name] {\n47|\t\t\treturn name, true\n48|\t\t}\n49|\t}\n50|\treturn \"\", false\n51|}\n52|\n53|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n54|\tfor _, name := range required {\n55|\t\tif _, present := members[name]; !present {\n56|\t\t\treturn name, true\n57|\t\t}\n58|\t}\n59|\treturn \"\", false\n60|}\n61|\n62|func rawString(raw json.RawMessage) (string, bool) {\n63|\tvar value string\n64|\tif err := json.Unmarshal(raw, &value); err != nil {\n65|\t\treturn \"\", false\n66|\t}\n67|\treturn value, true\n68|}\n69|\n70|func rawBool(raw json.RawMessage) (bool, bool) {\n71|\tvar value bool\n72|\tif err := json.Unmarshal(raw, &value); err != nil {\n73|\t\treturn false, false\n74|\t}\n75|\treturn value, true\n76|}\n77|\n78|// checkUint53Bounds reports whether the member is a uint53 in the\n79|// inclusive bound. Both edges are checked: a one-sided check would\n80|// admit the open side. It delegates to the environ gate.\n81|func checkUint53Bounds(raw json.RawMessage, minimum, maximum uint64) (uint64, bool) {\n82|\treturn environ.CheckUint53Bounds(raw, minimum, maximum)\n83|}\n84|\n85|// stringLength is the Section 1.6 string measure in characters, not\n86|// bytes: a bound of string[1..512] admits 512 characters of any\n87|// width. It delegates to the single environ measure so the two can\n88|// never drift.\n89|func stringLength(value string) int {\n90|\treturn environ.StringLength(value)\n91|}\n92|\n93|// checkStringBounds reports whether the member is a JSON string whose\n94|// character count falls in the inclusive bound. It delegates to the\n95|// environ gate.\n96|func checkStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n97|\treturn environ.CheckStringBounds(raw, minimum, maximum)\n98|}\n99|\n100|// checkDigest reports whether the member is a digest of the pinned\n101|// sha256 form. It delegates to the environ gate.\n102|func checkDigest(raw json.RawMessage) (scalar.Digest, bool) {\n103|\treturn environ.CheckDigest(raw)\n104|}\n105|\n106|// checkUUIDv7 reports whether the member is a lowercase UUIDv7. It\n107|// delegates to the environ gate.\n108|func checkUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n109|\treturn environ.CheckUUIDv7(raw)\n110|}\n111|\n112|// checkTimestamp reports whether the member is a pinned timestamp.\n113|// It delegates to the environ gate.\n114|func checkTimestamp(raw json.RawMessage) (scalar.Timestamp, bool) {\n115|\treturn environ.CheckTimestamp(raw)\n116|}\n117|\n118|// validText reports whether the value is valid UTF-8 text. Section\n119|// 1.6 requires text to be valid UTF-8, and encoding/json silently\n120|// rewrites invalid bytes to U+FFFD instead of failing — so every\n121|// Build-side string admission runs this gate BEFORE marshaling, and\n122|// refuses what it cannot seal byte-exactly. Without it two distinct\n123|// inputs (e.g. \"native\\xff\" vs \"native\\xfe\") would seal\n124|// byte-identical objects, and a native key would launder past the\n125|// sanitizer's own invalid-UTF-8 refusal. Every refusal is\n126|// constructed at the deciding site with a literal detail.\n127|func validText(value string) bool {\n128|\treturn utf8.ValidString(value)\n129|}\n130|\n131|// validExtensionText reports whether every string under an\n132|// extensions value — keys and string values at any depth, through\n133|// maps, slices, arrays, pointers, interfaces, and exported struct\n134|// fields — is valid UTF-8 text. The build helper runs it before\n135|// marshaling for the same rewrite-and-continue reason as validText:\n136|// a single invalid byte anywhere in the map would otherwise seal as\n137|// U+FFFD. Numbers, booleans, and nulls cross opaquely; values whose\n138|// marshaled form is computed rather than textual (custom\n139|// json.Marshaler implementations) are trusted to render valid text.\n140|func validExtensionText(value any) bool {\n141|\treturn extensionTextValid(reflect.ValueOf(value))\n142|}\n143|\n144|func extensionTextValid(value reflect.Value) bool {\n145|\tif !value.IsValid() {\n146|\t\treturn true\n147|\t}\n148|\tswitch value.Kind() {\n149|\tcase reflect.String:\n150|\t\treturn validText(value.String())\n151|\tcase reflect.Map:\n152|\t\titer := value.MapRange()\n153|\t\tfor iter.Next() {\n154|\t\t\tif !extensionTextValid(iter.Key()) || !extensionTextValid(iter.Value()) {\n155|\t\t\t\treturn false\n156|\t\t\t}\n157|\t\t}\n158|\t\treturn true\n159|\tcase reflect.Slice, reflect.Array:\n160|\t\tfor index := 0; index < value.Len(); index++ {\n161|\t\t\tif !extensionTextValid(value.Index(index)) {\n162|\t\t\t\treturn false\n163|\t\t\t}\n164|\t\t}\n165|\t\treturn true\n166|\tcase reflect.Struct:\n167|\t\town := value.Type()\n168|\t\tfor index := 0; index < value.NumField(); index++ {\n169|\t\t\tif own.Field(index).PkgPath != \"\" {\n170|\t\t\t\tcontinue\n171|\t\t\t}\n172|\t\t\tif !extensionTextValid(value.Field(index)) {\n173|\t\t\t\treturn false\n174|\t\t\t}\n175|\t\t}\n176|\t\treturn true\n177|\tcase reflect.Interface, reflect.Pointer:\n178|\t\tif value.IsNil() {\n179|\t\t\treturn true\n180|\t\t}\n181|\t\treturn extensionTextValid(value.Elem())\n182|\tdefault:\n183|\t\treturn true\n184|\t}\n185|}\n186|\n187|func bytesTrimSpace(raw json.RawMessage) json.RawMessage {\n188|\treturn json.RawMessage(bytes.TrimSpace(raw))\n189|}\n190|\n191|func isNull(raw json.RawMessage) bool {\n192|\ttrimmed := bytes.TrimSpace(raw)\n193|\treturn string(trimmed) == \"null\"\n194|}\n195|\n196|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n197|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n198|\ttoken, err := decoder.Token()\n199|\tif err != nil {\n200|\t\treturn nil, false\n201|\t}\n202|\tdelimiter, ok := token.(json.Delim)\n203|\tif !ok || delimiter != '[' {\n204|\t\treturn nil, false\n205|\t}\n206|\tvar elements []json.RawMessage\n207|\tfor decoder.More() {\n208|\t\tvar element json.RawMessage\n209|\t\tif err := decoder.Decode(&element); err != nil {\n210|\t\t\treturn nil, false\n211|\t\t}\n212|\t\telements = append(elements, element)\n213|\t}\n214|\ttoken, err = decoder.Token()\n215|\tif err != nil {\n216|\t\treturn nil, false\n217|\t}\n218|\tdelimiter, ok = token.(json.Delim)\n219|\tif !ok || delimiter != ']' {\n220|\t\treturn nil, false\n221|\t}\n222|\tif _, err := decoder.Token(); err != io.EOF {\n223|\t\treturn nil, false\n224|\t}\n225|\tif elements == nil {\n226|\t\telements = []json.RawMessage{}\n227|\t}\n228|\treturn elements, true\n229|}\n230|\n231|// checkSortedUniqueStrings reports whether the member is an array of\n232|// strings in the item bound whose JCS encodings order strictly\n233|// increasingly with no duplicates. It delegates to the environ gate.\n234|func checkSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n235|\treturn environ.CheckSortedUniqueStrings(raw, minimumLength, maximumLength, minimumCount, maximumCount)\n236|}\n237|\n238|// checkSortedUniqueDigests reports whether the member is a sorted\n239|// unique digest array in the count bound. It delegates to the\n240|// environ gate.\n241|func checkSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\n242|\treturn environ.CheckSortedUniqueDigests(raw, minimumCount, maximumCount)\n243|}\n244|\n245|// checkExtensions reports whether the member is an object whose keys\n246|// are all reverse-DNS names. It delegates to the environ gate. Key\n247|// admission alone is not the closed extensions rule for this\n248|// package: extension values flow into the omit-self identity, so\n249|// every admission site uses checkExtensionsClosed, which additionally\n250|// enforces the AX number model and nested duplicate refusal on the\n251|// values.\n252|func checkExtensions(raw json.RawMessage) bool {\n253|\treturn environ.CheckExtensions(raw)\n254|}\n255|\n256|// maxExtensionDepth mirrors the canonicaljson nesting bound: a\n257|// container nested deeper than this inside an extension value is\n258|// refused, exactly as the identity owner refuses it.\n259|const maxExtensionDepth = 256\n260|\n261|// checkExtensionsClosed enforces the full closed extensions rule:\n262|// reverse-DNS keys (via the environ owner) and values inside the AX\n263|// common logical data model (integer literals only, |n| <= 2^53-1,\n264|// no fraction or exponent, nested objects duplicate-free at every\n265|// depth). It returns nil when the member is closed, otherwise the\n266|// refusal detail naming the failed rule.\n267|func checkExtensionsClosed(raw json.RawMessage) error {\n268|\tif !checkExtensions(raw) {\n269|\t\treturn errExtensionsKeys\n270|\t}\n271|\treturn checkExtensionValues(raw)\n272|}\n273|\n274|var (\n275|\terrExtensionsKeys     = errorString(\"are not reverse-DNS keyed\")\n276|\terrExtensionNumber    = errorString(\"carry a number outside the AX safe-integer model\")\n277|\terrExtensionDuplicate = errorString(\"carry a duplicate nested member\")\n278|\terrExtensionShape     = errorString(\"are not a depth-bounded extension object\")\n279|\terrPayloadShape       = errorString(\"are not a depth-bounded payload object\")\n280|)\n281|\n282|// errorString is one fixed refusal detail. Extension faults name the\n283|// failed rule; the deciding site names the owner.\n284|type errorString string\n285|\n286|func (detail errorString) Error() string { return string(detail) }\n287|\n288|// checkExtensionValues validates every value under the extensions\n289|// object against the AX number model with nested objects\n290|// duplicate-free. It mirrors the canonicaljson identity guarantee\n291|// (safe integers, no rounding, strict objects) which Canonicalize\n292|// alone does not carry, so no value that would round or collapse\n293|// under canonicalization is ever admitted into an omit-self\n294|// identity.\n295|func checkExtensionValues(raw json.RawMessage) error {\n296|\tdecoder := json.NewDecoder(bytes.NewReader(bytesTrimSpace(raw)))\n297|\tdecoder.UseNumber()\n298|\ttoken, err := decoder.Token()\n299|\tif err != nil {\n300|\t\treturn errExtensionShape\n301|\t}\n302|\tdelimiter, ok := token.(json.Delim)\n303|\tif !ok || delimiter != '{' {\n304|\t\treturn errExtensionShape\n305|\t}\n306|\tif err := checkExtensionMembers(decoder, 0); err != nil {\n307|\t\treturn err\n308|\t}\n309|\tif _, err := decoder.Token(); err != io.EOF {\n310|\t\treturn errExtensionShape\n311|\t}\n312|\treturn nil\n313|}\n314|\n315|// checkExtensionMembers validates the members of one open extension\n316|// object: names are duplicate-free and every value validates.\n317|func checkExtensionMembers(decoder *json.Decoder, depth int) error {\n318|\tif depth >= maxExtensionDepth {\n319|\t\treturn errExtensionShape\n320|\t}\n321|\tseen := map[string]bool{}\n322|\tfor decoder.More() {\n323|\t\tnameToken, err := decoder.Token()\n324|\t\tif err != nil {\n325|\t\t\treturn errExtensionShape\n326|\t\t}\n327|\t\tname, ok := nameToken.(string)\n328|\t\tif !ok {\n329|\t\t\treturn errExtensionShape\n330|\t\t}\n331|\t\tif seen[name] {\n332|\t\t\treturn errExtensionDuplicate\n333|\t\t}\n334|\t\tseen[name] = true\n335|\t\tif err := checkExtensionValue(decoder, depth+1); err != nil {\n336|\t\t\treturn err\n337|\t\t}\n338|\t}\n339|\tend, err := decoder.Token()\n340|\tif err != nil || end != json.Delim('}') {\n341|\t\treturn errExtensionShape\n342|\t}\n343|\treturn nil\n344|}\n345|\n346|// checkExtensionValue validates one extension value: containers\n347|// recurse (objects duplicate-free at every depth, arrays in order),\n348|// numbers obey the AX literal rule, and strings, booleans, and null\n349|// cross opaquely.\n350|func checkExtensionValue(decoder *json.Decoder, depth int) error {\n351|\ttoken, err := decoder.Token()\n352|\tif err != nil {\n353|\t\treturn errExtensionShape\n354|\t}\n355|\tswitch typed := token.(type) {\n356|\tcase json.Delim:\n357|\t\tswitch typed {\n358|\t\tcase '{':\n359|\t\t\treturn checkExtensionMembers(decoder, depth)\n360|\t\tcase '[':\n361|\t\t\tif depth >= maxExtensionDepth {\n362|\t\t\t\treturn errExtensionShape\n363|\t\t\t}\n364|\t\t\tfor decoder.More() {\n365|\t\t\t\tif err := checkExtensionValue(decoder, depth+1); err != nil {\n366|\t\t\t\t\treturn err\n367|\t\t\t\t}\n368|\t\t\t}\n369|\t\t\tend, err := decoder.Token()\n370|\t\t\tif err != nil || end != json.Delim(']') {\n371|\t\t\t\treturn errExtensionShape\n372|\t\t\t}\n373|\t\t\treturn nil\n374|\t\tdefault:\n375|\t\t\treturn errExtensionShape\n376|\t\t}\n377|\tcase json.Number:\n378|\t\tif !checkAXNumberLiteral(typed.String()) {\n379|\t\t\treturn errExtensionNumber\n380|\t\t}\n381|\t\treturn nil\n382|\tcase string, bool, nil:\n383|\t\treturn nil\n384|\tdefault:\n385|\t\treturn errExtensionShape\n386|\t}\n387|}\n388|\n389|// checkAXNumberLiteral mirrors the canonicaljson safe-integer rule:\n390|// a literal with a fraction or exponent is forbidden, and the\n391|// integer value must fall in [-2^53+1, 2^53-1]. The bound is checked\n392|// on the literal before any host conversion, so a value the host\n393|// would round is refused instead.\n394|func checkAXNumberLiteral(literal string) bool {\n395|\tif strings.ContainsAny(literal, \".eE\") {\n396|\t\treturn false\n397|\t}\n398|\tinteger, err := strconv.ParseInt(literal, 10, 64)\n399|\tif err != nil || integer < -maxSafeInteger || integer > maxSafeInteger {\n400|\t\treturn false\n401|\t}\n402|\treturn true\n403|}\n404|\n405|// canonicalizeObject renders one closed object deterministically: the\n406|// members marshal in any order and the JCS transform sorts them, so\n407|// identical logical inputs always produce identical bytes.\n408|func canonicalizeObject(object map[string]any) ([]byte, error) {\n409|\tplain, err := json.Marshal(object)\n410|\tif err != nil {\n411|\t\treturn nil, invalid(\"serialize clone bundle object: %v\", err)\n412|\t}\n413|\tcanonical, err := canonicaljson.Canonicalize(plain)\n414|\tif err != nil {\n415|\t\treturn nil, invalid(\"canonicalize clone bundle object: %v\", err)\n416|\t}\n417|\treturn canonical, nil\n418|}\n419|\n420|// omitSelfDigest computes the JCS SHA-256 identity of members with\n421|// only the self field omitted. It mirrors the canonicaljson\n422|// omit-self construction without routing through that package's\n423|// closed-shape registry, which refuses these schemas by design (see\n424|// doc.go).\n425|func omitSelfDigest(members map[string]json.RawMessage, selfField string) (scalar.Digest, error) {\n426|\tomitted := make(map[string]any, len(members))\n427|\tfor name, raw := range members {\n428|\t\tif name == selfField {\n429|\t\t\tcontinue\n430|\t\t}\n431|\t\tvar value any\n432|\t\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n433|\t\tdecoder.UseNumber()\n434|\t\tif err := decoder.Decode(&value); err != nil {\n435|\t\t\treturn scalar.Digest{}, invalid(\"identity input member %s is not JSON: %v\", name, err)\n436|\t\t}\n437|\t\tomitted[name] = value\n438|\t}\n439|\tplain, err := json.Marshal(omitted)\n440|\tif err != nil {\n441|\t\treturn scalar.Digest{}, invalid(\"serialize omit-self object: %v\", err)\n442|\t}\n443|\tcanonical, err := canonicaljson.Canonicalize(plain)\n444|\tif err != nil {\n445|\t\treturn scalar.Digest{}, invalid(\"canonicalize omit-self object: %v\", err)\n446|\t}\n447|\treturn scalar.SHA256Digest(canonical), nil\n448|}\n449|\n450|// verifySelfDigest recomputes the omit-self identity and refuses a\n451|// mismatch against the claimed self digest.\n452|func verifySelfDigest(members map[string]json.RawMessage, selfField string, claimed scalar.Digest) error {\n453|\tcalculated, err := omitSelfDigest(members, selfField)\n454|\tif err != nil {\n455|\t\treturn err\n456|\t}\n457|\tif calculated != claimed {\n458|\t\treturn invalid(\"%s claim %q does not match omit-self digest %q\", selfField, claimed.String(), calculated.String())\n459|\t}\n460|\treturn nil\n461|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4db","stream":{"kind":"session","id":"01a0b225-c4f5-7551-94b6-c0c601dc074b"},"sequence":200,"recorded_at":1780531400000395,"record_type":"event","durability":"durable","causation_id":"83118e98-b6d0-4b7d-9792-f7c513af3eac","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"83118e98-b6d0-4b7d-9792-f7c513af3eac","run_stream":{"kind":"run","id":"83118e98-b6d0-4b7d-9792-f7c513af3eac"},"call_id":"call_01a0b22613297067a3b23430837521aa","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/clonebundle/blobref.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"io\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/localstore\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// This file owns the Section 10.2 raw evidence descriptor path: Blob\n13|// Descriptor identity and byte-count agreement, and no-replace blob\n14|// installation through the landed localstore durable-write\n15|// discipline. This package performs no durable write itself: every\n16|// byte crosses localstore.ObjectStore.PutBlob, whose no-replace,\n17|// fsync, and crash/idempotency evidence is cited in TRACEABILITY.md.\n18|\n19|// BlobAgreement is the verified agreement between a manifest entry\n20|// and its Section 10.2 Blob Descriptor.\n21|type BlobAgreement struct {\n22|\tDescriptorID scalar.Digest\n23|\tBlobID       scalar.Digest\n24|\tSize         uint64\n25|}\n26|\n27|// VerifyDescriptorAgreement verifies one raw evidence descriptor:\n28|// the bytes must be a closed valid Blob Descriptor 1.0.0 whose\n29|// claimed identity equals the computed omit-self digest, the\n30|// computed identity must equal the manifest entry's\n31|// blob_descriptor_id claim, and the descriptor's blob ID and size\n32|// must agree with the entry's claim. The identity link is what\n33|// binds the entry to the exact descriptor bytes verified: without\n34|// it any descriptor with an agreeing blob ID and size would satisfy\n35|// the entry. Shape validation and digest computation run through\n36|// the canonicaljson owner, never a fork; the claim comparisons are\n37|// local, because binding attestation outside the session leaf is\n38|// refused by the provhost no-attestation bound, so this package\n39|// never calls the attesting entry.\n40|func VerifyDescriptorAgreement(descriptor []byte, wantDescriptorID, wantBlobID scalar.Digest, wantSize uint64) error {\n41|\tcalculated, claimed, members, err := calculateDescriptorIdentity(descriptor)\n42|\tif err != nil {\n43|\t\treturn err\n44|\t}\n45|\tif calculated != claimed {\n46|\t\treturn invalid(\"blob descriptor claim %q does not match omit-self digest %q\", claimed.String(), calculated.String())\n47|\t}\n48|\tif calculated != wantDescriptorID {\n49|\t\treturn invalid(\"blob descriptor identity %q disagrees with entry claim %q\", calculated.String(), wantDescriptorID.String())\n50|\t}\n51|\tblobID, ok := checkDigest(members[\"blob_id\"])\n52|\tif !ok {\n53|\t\treturn invalid(\"blob descriptor blob_id is not a digest\")\n54|\t}\n55|\tif blobID != wantBlobID {\n56|\t\treturn invalid(\"blob descriptor blob_id %q disagrees with entry claim %q\", blobID.String(), wantBlobID.String())\n57|\t}\n58|\tsize, ok := checkUint53Bounds(members[\"size\"], 0, maxUint53)\n59|\tif !ok {\n60|\t\treturn invalid(\"blob descriptor size is not a uint53\")\n61|\t}\n62|\tif size != wantSize {\n63|\t\treturn invalid(\"blob descriptor size %d disagrees with entry claim %d\", size, wantSize)\n64|\t}\n65|\treturn nil\n66|}\n67|\n68|// InstallRawBlob installs one raw evidence blob through the landed\n69|// durable-write discipline: fsync, size/digest verification, and\n70|// atomic no-replace install owned by localstore. It returns the\n71|// verified agreement. A digest collision or same-ID/different-bytes\n72|// observation quarantines through the store owner; this package\n73|// adds no second write path.\n74|func InstallRawBlob(store *localstore.ObjectStore, descriptor []byte, source io.Reader) (BlobAgreement, error) {\n75|\tcalculated, claimed, members, err := calculateDescriptorIdentity(descriptor)\n76|\tif err != nil {\n77|\t\treturn BlobAgreement{}, err\n78|\t}\n79|\tif calculated != claimed {\n80|\t\treturn BlobAgreement{}, invalid(\"blob descriptor claim %q does not match omit-self digest %q\", claimed.String(), calculated.String())\n81|\t}\n82|\tblobID, ok := checkDigest(members[\"blob_id\"])\n83|\tif !ok {\n84|\t\treturn BlobAgreement{}, invalid(\"blob descriptor blob_id is not a digest\")\n85|\t}\n86|\tsize, ok := checkUint53Bounds(members[\"size\"], 0, maxUint53)\n87|\tif !ok {\n88|\t\treturn BlobAgreement{}, invalid(\"blob descriptor size is not a uint53\")\n89|\t}\n90|\tif store == nil {\n91|\t\treturn BlobAgreement{}, invalid(\"blob install requires an object store\")\n92|\t}\n93|\tif _, err := store.PutBlob(blobID, size, source); err != nil {\n94|\t\treturn BlobAgreement{}, invalid(\"blob install refused: %v\", err)\n95|\t}\n96|\treturn BlobAgreement{DescriptorID: calculated, BlobID: blobID, Size: size}, nil\n97|}\n98|\n99|// calculateDescriptorIdentity runs the owner's shape validation and\n100|// omit-self computation over one descriptor and reads its claimed\n101|// self digest. Callers compare the two; this helper never attests.\n102|func calculateDescriptorIdentity(descriptor []byte) (scalar.Digest, scalar.Digest, map[string]json.RawMessage, error) {\n103|\tcalculated, field, err := canonicaljson.CalculateObjectIdentity(descriptor)\n104|\tif err != nil {\n105|\t\treturn scalar.Digest{}, scalar.Digest{}, nil, invalid(\"blob descriptor identity fails: %v\", err)\n106|\t}\n107|\tif field != \"descriptor_id\" {\n108|\t\treturn scalar.Digest{}, scalar.Digest{}, nil, invalid(\"blob descriptor self field is %q, want descriptor_id\", string(field))\n109|\t}\n110|\tvar members map[string]json.RawMessage\n111|\tif err := json.Unmarshal(descriptor, &members); err != nil {\n112|\t\treturn scalar.Digest{}, scalar.Digest{}, nil, invalid(\"blob descriptor is not an object: %v\", err)\n113|\t}\n114|\tclaimed, ok := checkDigest(members[\"descriptor_id\"])\n115|\tif !ok {\n116|\t\treturn scalar.Digest{}, scalar.Digest{}, nil, invalid(\"blob descriptor descriptor_id is not a digest\")\n117|\t}\n118|\treturn calculated, claimed, members, nil\n119|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4dd","stream":{"kind":"session","id":"01a0b225-c4f5-7551-94b6-c0c601dc074b"},"sequence":201,"recorded_at":1780531400000397,"record_type":"event","durability":"durable","causation_id":"83118e98-b6d0-4b7d-9792-f7c513af3eac","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"83118e98-b6d0-4b7d-9792-f7c513af3eac","run_stream":{"kind":"run","id":"83118e98-b6d0-4b7d-9792-f7c513af3eac"},"call_id":"call_01a0b22614db763a9613ec36ec8b9665","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/clonebundle/generation.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n7|)\n8|\n9|// This file owns the Section 13.14.1 immutable generations: the\n10|// source_generation strings carried by StableSnapshotProof and the\n11|// unstable-archive Capture Boundary, and the snapshot-identity digest\n12|// that pins an immutable snapshot. Generations are opaque immutable\n13|// tokens: a generation never mutates, and equality is exact string\n14|// equality. Capture digests that must agree (stable pre/post) are\n15|// compared by digest equality here so both boundary validators share\n16|// one comparison.\n17|\n18|// Generation is one validated immutable source generation token:\n19|// string[1..512], opaque to the core.\n20|type Generation struct {\n21|\tvalue string\n22|}\n23|\n24|// ParseGeneration validates one generation token. Empty,\n25|// over-long, and invalid-UTF-8 tokens are refused; every other text\n26|// content crosses opaquely, because generations are native-store\n27|// tokens the core compares but never interprets. The UTF-8 gate\n28|// matters because the token seals into the boundary bytes: without\n29|// it the marshaler would rewrite invalid bytes to U+FFFD and two\n30|// distinct generations would seal byte-identical.\n31|func ParseGeneration(value string) (Generation, error) {\n32|\tif !validText(value) {\n33|\t\treturn Generation{}, invalid(\"source generation is not valid UTF-8\")\n34|\t}\n35|\tif stringLength(value) < 1 || stringLength(value) > 512 {\n36|\t\treturn Generation{}, invalid(\"source generation is not a string[1..512]\")\n37|\t}\n38|\treturn Generation{value: value}, nil\n39|}\n40|\n41|// MustParseGeneration validates one generation token and panics on\n42|// refusal. Tests and fixed fixtures use it; production paths use\n43|// ParseGeneration and return the refusal.\n44|func MustParseGeneration(value string) Generation {\n45|\tgeneration, err := ParseGeneration(value)\n46|\tif err != nil {\n47|\t\tpanic(err)\n48|\t}\n49|\treturn generation\n50|}\n51|\n52|func (generation Generation) String() string { return generation.value }\n53|\n54|// Equal reports exact generation equality. Generations are\n55|// immutable: two captures name the same source state if and only if\n56|// their tokens are byte-identical.\n57|func (generation Generation) Equal(other Generation) bool {\n58|\treturn generation.value == other.value\n59|}\n60|\n61|func checkGeneration(raw json.RawMessage) (Generation, bool) {\n62|\tvalue, ok := checkStringBounds(raw, 1, 512)\n63|\tif !ok {\n64|\t\treturn Generation{}, false\n65|\t}\n66|\tgeneration, err := ParseGeneration(value)\n67|\tif err != nil {\n68|\t\treturn Generation{}, false\n69|\t}\n70|\treturn generation, true\n71|}\n72|\n73|// CheckDigestsEqual refuses two capture digests that differ. Stable\n74|// capture requires equal pre/post digests; file-size equality is\n75|// never proof and is not consulted here.\n76|func CheckDigestsEqual(pre, post scalar.Digest) error {\n77|\tif pre != post {\n78|\t\treturn invalid(\"capture digests differ: pre %q, post %q\", pre.String(), post.String())\n79|\t}\n80|\treturn nil\n81|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
