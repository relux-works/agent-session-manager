+func expectedContracts(contracts []specpin.ContractPin) map[string]struct{} {
+	result := make(map[string]struct{}, len(contracts))
+	for _, contract := range contracts {
+		result[contractKey(contract.Name, contract.ID)] = struct{}{}
+	}
+	return result
+}
