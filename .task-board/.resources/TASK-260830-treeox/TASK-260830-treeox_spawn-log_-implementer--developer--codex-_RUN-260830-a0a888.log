+			},
+			contains: "decode ownership registry",
+		},
+		{
+			name: "production owner source absent",
+			mutate: func(repository fstest.MapFS) {
+				delete(repository, "internal/catalog/catalog.go")
+			},
+			contains: "read \"internal/catalog/catalog.go\"",
