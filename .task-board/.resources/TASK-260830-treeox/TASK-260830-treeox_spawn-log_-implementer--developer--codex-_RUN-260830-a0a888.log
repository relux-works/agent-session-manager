+func TestVerifyRepositoryDistinguishesMissingAndMalformedEvidence(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name     string
+		mutate   func(fstest.MapFS)
+		contains string
+	}{
+		{
