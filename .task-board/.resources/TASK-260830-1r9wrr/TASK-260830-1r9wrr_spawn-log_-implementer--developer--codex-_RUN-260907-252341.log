package sessstate

import (
 "testing"
)

func TestReviewerUnknownV1Neighbor(t *testing.T) {
 record := decodeTestRecord(t)
 specs := append(baseBootstrap(record), eventSpec{typ:"session.reaped", payload:map[string]any{"note":"reviewer neighbor"}})
 got, err := reduceSpecs(t, record, specs, Input{})
 if err != nil { t.Fatal(err) }
 t.Logf("unknown-v1 session.reaped: state=%q", got.State)
 if got.State != StateRunning { t.Fatalf("unknown v1 changed state: got %q want running", got.State) }
}

func TestReviewerUnionAndLocalNeighbors(t *testing.T) {
 record := decodeTestRecord(t)
 c := LeaseHead{Epoch:3,LeaseID:testLeaseIDC}
 b := LeaseHead{Epoch:2,LeaseID:testLeaseIDB}
 unions := [][]LeaseHead{{c,c,b,c},{b,c,c,b},{c,b,c,c}, {c,c,{Epoch:1,LeaseID:testLeaseID}}}
 for i, union := range unions {
  got,err := reduceSpecs(t,record,baseBootstrap(record),Input{Union:union})
  if err != nil {t.Fatal(err)}
  n:=0
  for _,conflict:=range got.Conflicts { if conflict.Kind==ConflictUnionSupersedesChain { n++; if conflict.Rule!=ResolveRuleAuthoritativeStateUnchanged {t.Fatal(conflict)} } }
  if n!=1 || got.Winner!=c || got.State!=StateRunning {t.Fatalf("union neighbor %d: %+v",i,got)}
  assertWarning(t,got,"divergent_history")
 }
 for _,row:= range []struct{ local LeaseHead; want State }{
  {LeaseHead{Epoch:2,LeaseID:testLeaseIDB},StateStale},
  {LeaseHead{Epoch:3,LeaseID:testLeaseIDB},StateStale},
  {c,StateRunning},
  {LeaseHead{Epoch:4,LeaseID:testLeaseIDR},StateRunning},
 } {
  got,err:=reduceSpecs(t,record,baseBootstrap(record),Input{Union:[]LeaseHead{c},Local:row.local})
  if err!=nil {t.Fatal(err)}
  if got.State!=row.want {t.Fatalf("local %+v: got %q want %q",row.local,got.State,row.want)}
 }
}

func TestReviewerEmptyChainLocalBound(t *testing.T) {
 record:=decodeTestRecord(t)
 for _,union:=range [][]LeaseHead{nil, {{Epoch:3,LeaseID:testLeaseIDC}}} {
  for _,local:=range []LeaseHead{{}, {Epoch:1,LeaseID:testLeaseID}, {Epoch:4,LeaseID:testLeaseIDB}, {Epoch:1,LeaseID:"not-a-uuid"}, {LeaseID:testLeaseID}} {
   got,err:=Reduce(Input{Record:record,Union:union,Local:local,LocalHostID:testHostID})
