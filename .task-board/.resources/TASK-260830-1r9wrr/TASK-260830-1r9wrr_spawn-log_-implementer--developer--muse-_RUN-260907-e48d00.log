{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5d9","stream":{"kind":"session","id":"01a07db8-a28a-7e80-8be1-e3a988123386"},"sequence":327,"recorded_at":1780531400000649,"record_type":"event","durability":"durable","causation_id":"4385e4d6-e071-42f2-a438-a44213370546","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4385e4d6-e071-42f2-a438-a44213370546","run_stream":{"kind":"run","id":"4385e4d6-e071-42f2-a438-a44213370546"},"task_stream":{"kind":"task","id":"3799c788-8da8-41be-ac1f-4e8aacb5f69e"},"task_id":"3799c788-8da8-41be-ac1f-4e8aacb5f69e","event":{"kind":"output","task_id":"3799c788-8da8-41be-ac1f-4e8aacb5f69e","chunk":"Read text file `.temp/TASK-260830-1r9wrr/mutate.sh`.\n(79 line(s) above)\n80|}\n81|\n82|// effectCreated opens the bootstrap'\n83|want N8 && N N8 sessstate.go 'if successor != lease.LeaseID {\n84|\t\t\treturn refuse(ErrIntegrity, \"%s transfers to lease %s outside its envelope lease %s\", what, successor, lease.LeaseID)' 'if successor != lease.LeaseID && successor != \"cccccccc-dddd-4eee-8fff-000000000000\" {\n85|\t\t\treturn refuse(ErrIntegrity, \"%s transfers to lease %s outside its envelope lease %s\", what, successor, lease.LeaseID)'\n86|want N9 && N N9 sessstate.go 'if hasCheckpoint || resumable {\n87|\t\treturn refuse(ErrIntegrity, \"%s closes bootstrap_abort with a checkpoint or resumable set\", what)' 'if hasCheckpoint && resumable {\n88|\t\treturn refuse(ErrIntegrity, \"%s closes bootstrap_abort with a checkpoint or resumable set\", what)'\n89|\n90|echo \"== narrowing: read and recovery paths ==\"\n91|want N10 && N N10 project.go 'if found.Parked {' 'if found.Parked && found.RetryHint == \"\" {'\n92|want N11 && N N11 sessstate.go '\tif providerID != fold.recordProvider {\n93|\t\tfold.conflict(ConflictProviderMismatch, ResolveRuleRecordPinnedProviderWins,' '\tif providerID != fold.recordProvider && providerID != \"qwen\" {\n94|\t\tfold.conflict(ConflictProviderMismatch, ResolveRuleRecordPinnedProviderWins,'\n95|want N12 && N N12 sessstate.go 'if payloadEpoch != fold.createLease.Epoch || payloadLease != fold.createLease.LeaseID {' 'if payloadLease != fold.createLease.LeaseID {'\n96|\n97|echo \"== arm-deletion ==\"\n98|want D1 && D D1 sessstate.go '\tif _, ok := allowedTransitions[fold.state][target]; !ok {\n99|\t\treturn refuse(ErrInvalidTransition, \"%s moves %q to %q without a Section 5.7 edge\", what, string(fold.state), string(target))' '\tif _, ok := allowedTransitions[fold.state][target]; !ok {\n100|\t\tfold.state = target\n101|\t\treturn nil'\n102|want D2 && D D2 sessstate.go '\t\tif lease.Epoch == fold.current.Epoch {\n103|\t\t\treturn false, refuse(ErrDivergentLease, \"event %s under lease %s diverges from chain head lease %s at epoch %d\", event.ID, lease.LeaseID, fold.current.LeaseID, fold.current.Epoch)\n104|\t\t}' '\t\tif false {\n105|\t\t\treturn false, refuse(ErrDivergentLease, \"planted\", event.ID)\n106|\t\t}'\n107|want D3 && D D3 sessstate.go '\tdefault:\n108|\t\treturn false, refuse(ErrStaleLease, \"event %s lease epoch %d precedes chain head epoch %d\", event.ID, lease.Epoch, fold.current.Epoch)' '\tdefault:\n109|\t\tfold.trackTail(event)\n110|\t\treturn false, nil'\n111|want D4 && D D4 sessstate.go '\tif input.Parked != nil {\n112|\t\tprojection.State = StateParked' '\tif input.Parked != nil && false {\n113|\t\tprojection.State = StateParked'\n114|want D5 && D D5 sessstate.go '\tproviderID, err := payloadString(event.Payload, \"provider_id\")\n115|\tif err != nil {\n116|\t\treturn err\n117|\t}\n118|\tif providerID != fold.recordProvider {\n119|\t\treturn refuse(ErrIntegrity, \"%s repeats provider %q past record provider %q\", what, providerID, fold.recordProvider)\n120|\t}' '\tproviderID, err := payloadString(event.Payload, \"provider_id\")\n121|\tif err != nil {\n122|\t\treturn err\n123|\t}\n124|\t_ = providerID'\n125|want D6 && D D6 sessstate.go '\tif event.LeaseEpoch != 1 || event.LeaseID != fold.createLease.LeaseID ||\n126|\t\tevent.LeaseEpoch != fold.createLease.Epoch {\n127|\t\treturn refuse(ErrInvalidTransition, \"%s retries bootstrap under a new lease\", what)' '\tif false {\n128|\t\treturn refuse(ErrInvalidTransition, \"%s retries bootstrap under a new lease\", what)'\n129|want D7 && D D7 sessstate.go '\tif !containsString(event.Predecessors, tail) {\n130|\t\treturn refuse(ErrInvalidTransition, \"event %s predecessors omit prior authoritative event\", event.ID)' '\tif !containsString(event.Predecessors, tail) && false {\n131|\t\treturn refuse(ErrInvalidTransition, \"event %s predecessors omit prior authoritative event\", event.ID)'\n132|want D8 && D D8 sessstate.go '\tif target == \"\" || target == fold.state {\n133|\t\treturn nil\n134|\t}' '\tif target == \"\" {\n135|\t\treturn nil\n136|\t}'\n137|\n138|echo \"== TestMain-only kills (behavioral green, full-package red) plus one roster-test kill ==\"\n139|want C1 && C C1 sessstate.go '\tcase \"sync.completed\":\n140|\t\treturn nil' '\tcase \"sync.completed\":\n141|\t\t_ = refuse(ErrInvalidEvent, \"planted unrouted refusal\")\n142|\t\treturn nil'\n143|want A1 && A A1 sessstate.go '\tcase \"sync.completed\":\n144|\t\treturn nil' '\tcase \"sync.completed\":\n145|\t\tvar deny = refuse; _ = deny; return nil'\n146|want A2 && A A2 sessstate.go '\tcase \"sync.completed\":\n147|\t\treturn nil' '\tcase \"sync.completed\":\n148|\t\tfunc() { refuse := 0; _ = refuse }(); return nil'\n149|want A3 && A A3 sessstate.go '\tcase \"sync.completed\":\n150|\t\treturn nil' '\tcase \"sync.completed\":\n151|\t\t_ = fmt.Errorf(\"%w: planted\", ErrInvalidEvent); return nil'\n152|\n153|echo \"== census-test kills (the state and event censuses are tests, so both gates redden) ==\"\n154|want T1 && run_one T1 sessstate.go '\tStateCreating      State = \"creating\"' '\tStateCreating      State = \"created\"' narrowing\n155|want T2 && run_one T2 sessstate.go '\tcase \"sync.completed\":' '\tcase \"sync.completed\", \"session.future\":' narrowing\n156|\n157|echo \"== harness controls ==\"\n158|want X1 && run_one X1 sessstate.go 'this pattern is absent' 'planted' narrowing\n159|want X2 && run_one X2 sessstate.go 'func Reduce(input Input) (Projection, error) {' 'func Reduce(input Input) (Projection, error) {{' narrowing\n160|\n161|echo \"== results ==\"\n162|for id in N1 N2 N3 N4 N5 N6 N7 N8 N9 N10 N11 N12 D1 D2 D3 D4 D5 D6 D7 D8 C1 A1 A2 A3 T1 T2 X1 X2; do\n163|  case \" $ALL \" in \"\"|\" \"*$id*\" \") :;; *) continue;; esac\n164|done\n165|echo \"(see rows above)\""}}}
