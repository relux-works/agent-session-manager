S) { PROJECTION }; the projection block is optional\\\",\\\"batch\\\":\\\"STATEMENT; STATEMENT — statements separated by ';', results keep source order\\\",\\\"arguments\\\":\\\"comma-separated arguments: the first bare positional value is the element/identifier argument; remaining arguments use key=value; no operators or lists (not key in [a,b], not key!=value)\\\",\\\"values\\\":\\\"a bare identifier (letters, digits, '_', '-', '.', '/'), an int, a bool (true|false), or a \\\\\\\"double-quoted string\\\\\\\"; quote any value containing spaces, commas or parentheses\\\",\\\"escapes\\\":[\\\"\\\\\\\\\\\\\\\"\\\",\\\"\\\\\\\\\\\\\\\\\\\",\\\"\\\\\\\\n\\\",\\\"\\\\\\\\t\\\"],\\\"projection\\\":\\\"field projection: { field preset ... } — space-separated field names and preset names inside braces; omitted means the default fields\\\",\\\"tokens\\\":[\\\"identifier\\\",\\\"string\\\",\\\"'('\\\",\\\"')'\\\",\\\"'{'\\\",\\\"'}'\\\",\\\"'='\\\",\\\"','\\\",\\\"';'\\\",\\\"end of input\\\"],\\\"examples\\\":[\\\"op()\\\",\\\"op(key=value)\\\",\\\"op(key=value, other=42, flag=true)\\\",\\\"op(key=\\\\\\\"quoted value with \\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\\ \\\\\\\\n \\\\\\\\t\\\\\\\")\\\",\\\"op(positional)\\\",\\\"op() { field preset }\\\",\\\"op(key=value) { field }; other()\\\"]},\\\"mutationMetadata\\\":{\\\"accept_cr\\\":{\\\"description\\\":\\\"Record an evidence-backed reviewer acceptance and route the element to integrating\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID carrying the Change Request\\\",\\\"required\\\":true},{\\\"name\\\":\\\"revision\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Change Request revision being accepted (expected-revision CAS)\\\",\\\"required\\\":true},{\\\"name\\\":\\\"evidence\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Task-scoped outcome resource name carrying the verdict evidence\