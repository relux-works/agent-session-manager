7|\t\t\"sessstate.go:751\": \"TestReduceRefusesDerivationVectors/abort_closure_with_checkpoint\",\n78|\t\t\"sessstate.go:754\": \"TestReduceRefusesBootstrapAbortStopWithoutAbort\",\n79|\t\t\"sessstate.go:767\": \"TestReduceRefusesDerivationVectors/resume_checkpoint_malformed\",\n80|\t\t\"sessstate.go:776\": \"TestReduceRefusesDerivationVectors/resume_v4_binding_malformed\",\n81|\t\t\"sessstate.go:783\": \"TestReduceRefusesDerivationVectors/resume_v4_backend_refused\",\n82|\t\t\"sessstate.go:792\": \"TestReduceRefusesDerivationVectors/resume_v1_backend_unknown\",\n83|\t\t\"sessstate.go:810\": \"TestReduceGatesFailedToCreatingRetry/abort_refused\",\n84|\t\t\"sessstate.go:830\": \"TestReduceRefusesLeaseLinkageMismatch/wrong_predecessor\",\n85|\t\t\"sessstate.go:837\": \"TestReduceRefusesLeaseLinkageMismatch/transfer_outside_envelope\",\n86|\t\t\"sessstate.go:845\": \"TestReduceRefusesLeaseLinkageMismatch/envelope_outside_payload\",\n87|\t\t\"sessstate.go:861\": \"TestReduceRefusesTaskBoardRepeatMismatch/foreign_provider\",\n88|\t\t\"sessstate.go:872\": \"TestReduceRefusesTaskBoardRepeatMismatch/foreign_creation_lease\",\n89|\t\t\"sessstate.go:920\": \"TestReduceRefusesUnionVectors/empty_lease_head\",\n90|\t\t\"sessstate.go:923\": \"TestReduceRefusesUnionVectors/malformed_lease_id\",\n91|\t}\n92|}\n93|\n94|// TestRefusalSitesAreCensused requires the derived refusal inventory\n95|// to equal the roster in both directions.\n96|func TestRefusalSitesAreCensused(t *testing.T) {\n97|\tfiles, fileSet := invcore.MustScanProduction(t, \".\")\n98|\t_, derived, failures := deriveSessstateRefusalSites(files, fileSet)\n99|\tfor _, failure := range failures {\n100|\t\tt.Error(failure)\n101|\t}\n102|\trows := map[string]struct{}{}\n103|\tfor site := range sessstateRefusalRows() {\n104|\t\trows[site] = struct{}{}\n105|\t}\n106|\tinvcore.MustCheckBothDirections(t, \"sessstate refusals\", derived, rows)\n107|}\n108|\n109|// stateRows rosters every SessionState spelling with the test driving\n110|// it through the production Reduce entry.\n111|func stateRows() map[string]string {\n112|\treturn map[string]string{\n113|\t\t\"creating\":      \"TestReduceDerivesEverySessionState/creating\",\n114|\t\t\"running\":       \"TestReduceDerivesEverySessionState/running\",\n115|\t\t\"idle\":          \"TestReduceDerivesEverySessionState/idle\",\n116|\t\t\"quiescing\":     \"TestReduceDerivesEverySessionState/quiescing\",\n117|\t\t\"checkpointing\": \"TestReduceDerivesEverySessionState/checkpointing\",\n118|\t\t\"stopped\":       \"TestReduceDerivesEverySessionState/stopped\",\n119|\t\t\"materializing\": \"TestReduceDerivesEverySessionState/materializing\",\n120|\t\t\"parked\":        \"TestReduceDerivesEverySessionState/parked\",\n121|\t\t\"failed\":        \"TestReduceDerivesEverySessionState/failed\",\n122|\t\t\"stale\":         \"TestReduceDerivesEverySessionState/stale\",\n123|\t\t\"tombstoned\":    \"TestReduceDerivesEverySessionState/tombstoned\",\n124|\t}\n125|}\n126|\n127|// deriveStateSpellings derives the SessionState spellings\n128|// structurally: every State-typed const value, plus State()\n129|// conversions over string literals. A State() conversion over anything\n130|// else — a variable, a call — fails closed as unclassifiable, since a\n131|// state value with no listed spelling is exactly the defect. It also\n132|// returns the declared State const names for the use-position check.\n133|func deriveStateSpellings(files []invcore.ProductionFile, fileSet *token.FileSet) (map[string]struct{}, map[string]struct{}, []string) {\n134|\tspelled := map[string]struct{}{}\n135|\tconstNames := map[string]struct{}{}\n136|\tvar failures []string\n137|\t_ = fileSet\n138|\tfor _, production := range files {\n139|\t\tast.Inspect(production.Syntax, func(node ast.Node) bool {\n140|\t\t\tspec, ok := node.(*ast.ValueSpec)\n141|\t\t\tif ok {\n142|\t\t\t\ttypeIdent, ok := spec.Type.(*ast.Ident)\n143|\t\t\t\tif ok && typeIdent.Name == \"State\" {\n144|\t\t\t\t\tfor index, name := range spec.Names {\n145|\t\t\t\t\t\tconstNames[name.Name] = struct{}{}\n146|\t\t\t\t\t\tif index >= len(spec.Values) {\n147|\t\t\t\t\t\t\tfailures = append(failures, production.Name+\": State const \"+name.Name+\" without a value fails closed\")\n148|\t\t\t\t\t\t\tcontinue\n149|\t\t\t\t\t\t}\n150|\t\t\t\t\t\tliteral, ok := spec.Values[index].(*ast.BasicLit)\n151|\t\t\t\t\t\tif !ok || literal.Kind != token.STRING {\n152|\t\t\t\t\t\t\tfailures = append(failures, production.Name+\": State const \"+name.Name+\" without a string literal fails closed\")\n153|\t\t\t\t\t\t\tcontinue\n154|\t\t\t\t\t\t}\n155|\t\t\t\t\t\tvalue, err := strconv.Unquote(literal.Value)\n156|\t\t\t\t\t\tif err != nil {\n157|\t\t\t\t\t\t\tfailures = append(failures, production.Name+\": State const \"+name.Name+\" holds an unreadable literal\")\n158|\t\t\t\t\t\t\tcontinue\n159|\t\t\t\t\t\t}\n160|\t\t\t\t\t\tspelled[value] = struct{}{}\n161|\t\t\t\t\t}\n162|\t\t\t\t}\n163|\t\t\t\treturn true\n164|\t\t\t}\n165|\t\t\tcall, ok := node.(*ast.CallExpr)\n166|\t\t\tif !ok {\n167|\t\t\t\treturn true\n168|\t\t\t}\n169|\t\t\tconversion, ok := call.Fun.(*ast.Ident)\n170|\t\t\tif !ok || conversion.Name != \"State\" || len(call.Args) != 1 {\n171|\t\t\t\treturn true\n172|\t\t\t}\n173|\t\t\tswitch argument := call.Args[0].(type) {\n174|\t\t\tcase *ast.BasicLit:\n175|\t\t\t\tif argument.Kind != token.STRING {\n176|\t\t\t\t\tfailures = append(failures, production.Name+\": State() conversion over a non-string fails closed\")\n177|\t\t\t\t\treturn true\n178|\t\t\t\t}\n179|\t\t\t\tvalue, err := strconv.Unquote(argument.Value)\n180|\t\t\t\tif err != nil {\n181|\t\t\t\t\tfailures = append(failures, production.Name+\": State() conversion holds an unreadable literal\")\n182|\t\t\t\t\treturn true\n183|\t\t\t\t}\n184|\t\t\t\tspelled[value] = struct{}{}\n185|\t\t\tcase *ast.Ident:\n186|\t\t\t\t// A use position, not a definition: the name must be a\n187|\t\t\t\t// declared State const, checked after the walk.\n188|\t\t\t\tspelled[\"use:\"+argument.Name] = struct{}{}\n189|\t\t\tdefault:\n190|\t\t\t\tfailures = append(failures, production.Name+\": State() conversion over a computed value fails closed as unclassifiable\")\n191|\t\t\t}\n192|\t\t\treturn true\n193|\t\t})\n194|\t}\n195|\tfor key := range spelled {\n196|\t\tif !strings.HasPrefix(key, \"use:\") {\n197|\t\t\tcontinue\n198|\t\t}\n199|\t\tdelete(spelled, key)\n200|\t\tif _, ok := constNames[strings.TrimPrefix(key, \"use:\")]; !ok {\n201|\t\t\tfailures = append(failures, \"State() conversion over undeclared name \"+strings.TrimPrefix(key, \"use:\")+\" fails closed\")\n202|\t\t}\n203|\t}\n204|\treturn spelled, constNames, failures\n205|}\n206|\n207|// TestStateSpaceIsCensused requires the derived state spellings to\n208|// equal the roster in both directions, every roster spelling to live\n209|// exactly once as a production literal, and every roster value to\n210|// derive from a production Reduce path in this test.\n211|func TestStateSpaceIsCensused(t *testing.T) {\n212|\tfiles, fileSet := invcore.MustScanProduction(t, \".\")\n213|\tderived, _, failures := deriveStateSpellings(files, fileSet)\n214|\tfor _, failure := range failures {\n215|\t\tt.Error(failure)\n216|\t}\n217|\trows := map[string]struct{}{}\n218|\tfor spelling := range stateRows() {\n219|\t\trows[spelling] = struct{}{}\n220|\t}\n221|\tinvcore.MustCheckBothDirections(t, \"sessstate states\", derived, rows)\n222|\tassertStateLiteralsAreSingleSourced(t, files)\n223|\n224|\trecord := buildRecord(t, nil)\n225|\tdecoded, err := DecodeRecord(record)\n226|\tif err != nil {\n227|\t\tt.Fatalf(\"DecodeRecord error = %v\", err)\n228|\t}\n229|\tcreated := eventSpec{typ: \"session.created\", payload: createdPayload(decoded.RecordID)}\n230|\tlaunched := eventSpec{typ: \"provider.launched\", payload: launchedPayload(\"codex\")}\n231|\tidle := eventSpec{typ: \"session.idle\", payload: idlePayload()}\n232|\tcheckpoint := eventSpec{typ: \"checkpoint.created\", payload: checkpointPayload()}\n233|\tstopped := eventSpec{typ: \"session.stopped\", payload: stoppedPayload()}\n234|\ttransferred := eventSpec{epoch: 2, leaseID: testLeaseIDB, typ: \"lease.transferred\", payload: transferredPayload(testLeaseID, testLeaseIDB)}\n235|\tchains := map[string][]eventSpec{\n236|\t\t\"creating\":      {created},\n237|\t\t\"running\":       {created, launched},\n238|\t\t\"idle\":          {created, launched, idle},\n239|\t\t\"quiescing\":     {created, launched, idle, {typ: \"session.quiescing\", payload: quiescingPayload()}},\n240|\t\t\"checkpointing\": {created, launched, idle, checkpoint},\n241|\t\t\"stopped\":       {created, launched, idle, checkpoint, checkpoint, stopped},\n242|\t\t\"materializing\": {created, launched, idle, checkpoint, checkpoint, stopped, transferred},\n243|\t\t\"parked\": {created, launched, idle, checkpoint, checkpoint, stopped, transferred,\n244|\t\t\t{epoch: 2, leaseID: testLeaseIDB, typ: \"session.parked\", payload: parkedPayload(testLeaseIDB)}},\n245|\t\t\"failed\": {created, launched, {typ: \"session.failed\", payload: failedPayload()}},\n246|\t\t\"stale\": {created, launched, idle,\n247|\t\t\t{epoch: 2, leaseID: testLeaseIDB, typ: \"lease.forced\", payload: forcedPayload(testLeaseIDB, 1)}},\n248|\t\t\"tombstoned\": {created, launched, idle, checkpoint, checkpoint, stopped,\n249|\t\t\t{typ: \"session.tombstoned\", payload: tombstonedPayload()}},\n250|\t}\n251|\tproduced := map[string]struct{}{}\n252|\tfor want, chain := range chains {\n253|\t\tprojection := reduceDirect(t, record, chain)\n254|\t\tif string(projection.State) != want {\n255|\t\t\tt.Errorf(\"census chain state = %q, want %q\", projection.State, want)\n256|\t\t}\n257|\t\tproduced[string(projection.State)] = struct{}{}\n258|\t}\n259|\t// A path producing an uncensused value fails here: the produced\n260|\t// set must equal the roster exactly, in both directions.\n261|\tinvcore.MustCheckBothDirections(t, \"sessstate produced states\", produced, rows)\n262|\tif ordered := States(); len(ordered) != len(rows) {\n263|\t\tt.Fatalf(\"States() has %d entries, roster has %d\", len(ordered), len(rows))\n264|\t} else {\n265|\t\tfor index, spelling := range ordered {\n266|\t\t\tif _, ok := rows[spelling]; !ok {\n267|\t\t\t\tt.Fatalf(\"States()[%d] = %q outside the roster\", index, spelling)\n268|\t\t\t}\n269|\t\t}\n270|\t\t// Declared order pins the Section 5.7 sequence exactly.\n271|\t\twant := []string{\"creating\", \"running\", \"idle\", \"quiescing\", \"checkpointing\", \"stopped\", \"materializing\", \"parked\", \"failed\", \"stale\", \"tombstoned\"}\n272|\t\tfor index := range want {\n273|\t\t\tif ordered[index] != want[index] {\n274|\t\t\t\tt.Fatalf(\"States() order = %v, want Section 5.7 order %v\", ordered, want)\n275|\t\t\t}\n276|\t\t}\n277|\t}\n278|}\n279|\n280|// assertStateLiteralsAreSingleSourced requires every roster spelling to\n281|// appear exactly once as a string literal in production: the const\n282|// block is the single source, and a second literal (a message, a\n283|// duplicate table) fails the gate.\n284|func assertStateLiteralsAreSingleSourced(t *testing.T, files []invcore.ProductionFile) {\n285|\tt.Helper()\n286|\tcounts := map[string]int{}\n287|\tfor _, production := range files {\n288|\t\tast.Inspect(production.Syntax, func(node ast.Node) bool {\n289|\t\t\tliteral, ok := node.(*ast.BasicLit)\n290|\t\t\tif !ok || literal.Kind != token.STRING {\n291|\t\t\t\treturn true\n292|\t\t\t}\n293|\t\t\tvalue, err := strconv.Unquote(literal.Value)\n294|\t\t\tif err != nil {\n295|\t\t\t\treturn true\n296|\t\t\t}\n297|\t\t\tcounts[value]++\n298|\t\t\treturn true\n299|\t\t})\n300|\t}\n301|\tfor spelling := range stateRows() {\n302|\t\tif counts[spelling] != 1 {\n303|\t\t\tt.Errorf(\"state spelling %q appears %d times as a production literal, want exactly once\", spelling, counts[spelling])\n304|\t\t}\n305|\t}\n306|}\n307|\n308|// eventRow names one handled event type with its class and driver.\n309|type eventRow struct {\n310|\tclass  string\n311|\tdriver string\n312|}\n313|\n314|// eventRows rosters every handled v1 event type: lifecycle types move\n315|// the derivation, fact types record data and keep the state. Unknown\n316|// v1 types stay inert by default and never appear here.\n317|func eventRows() map[string]eventRow {\n318|\treturn map[string]eventRow{\n319|\t\t\"session.created\":           {\"lifecycle\", \"TestReduceDerivesEverySessionState/creating\"},\n320|\t\t\"terminal.created\":          {\"lifecycle\", \"TestProjectDerivesFullLifecycle\"},\n321|\t\t\"provider.launched\":         {\"lifecycle\", \"TestReduceDerivesEverySessionState/running\"},\n322|\t\t\"provider.identified\":       {\"fact\", \"TestProjectDerivesFullLifecycle\"},\n323|\t\t\"session.idle\":              {\"lifecycle\", \"TestReduceDerivesEverySessionState/idle\"},\n324|\t\t\"session.quiescing\":         {\"lifecycle\", \"TestReduceDerivesEverySessionState/quiescing\"},\n325|\t\t\"checkpoint.created\":        {\"lifecycle\", \"TestReduceDerivesEverySessionState/checkpointing\"},\n326|\t\t\"sync.completed\":            {\"fact\", \"TestReduceKeepsFactEventsStateless\"},\n327|\t\t\"session.stopped\":           {\"lifecycle\", \"TestReduceDerivesEverySessionState/stopped\"},\n328|\t\t\"session.resumed\":           {\"lifecycle\", \"TestProjectDerivesFullLifecycle\"},\n329|\t\t\"session.bootstrap_aborted\": {\"lifecycle\", \"TestReduceDerivesFailedFromBootstrapAbortStop\"},\n330|\t\t\"lease.transferred\":         {\"lifecycle\", \"TestReduceDerivesEverySessionState/materializing\"},\n331|\t\t\"lease.forced\":              {\"lifecycle\", \"TestReduceDerivesEverySessionState/stale\"},\n332|\t\t\"session.parked\":            {\"lifecycle\", \"TestReduceDerivesEverySessionState/parked\"},\n333|\t\t\"session.failed\":            {\"lifecycle\", \"TestReduceDerivesEverySessionState/failed\"},\n334|\t\t\"fork.created\":              {\"fact\", \"TestReduceKeepsFactEventsStateless\"},\n335|\t\t\"profile.changed\":           {\"fact\", \"TestReduceKeepsFactEventsStateless\"},\n336|\t\t\"session.tombstoned\":        {\"lifecycle\", \"TestReduceDerivesEverySessionState/tombstoned\"},\n337|\t\t\"takeover.force_confirmed\":  {\"fact\", \"TestReduceKeepsFactEventsStateless\"},\n338|\t\t\"replica.replace_confirmed\": {\"fact\", \"TestReduceKeepsFactEventsStateless\"},\n339|\t\t\"task_board.launched\":       {\"lifecycle\", \"TestReduceDerivesTaskBoardLaunch\"},\n340|\t\t\"task_board.adopted\":        {\"fact\", \"TestReduceKeepsFactEventsStateless\"},\n341|\t\t\"tombstone.issued\":          {\"fact\", \"TestReduceKeepsFactEventsStateless\"},\n342|\t\t\"tombstone.resolved\":        {\"fact\", \"TestReduceKeepsFactEventsStateless\"},\n343|\t}\n344|}\n345|\n346|// pinnedV1EventTypes is the Section 5.2 v1 registry in table order.\n347|// The canonical owner pins the same registry against the catalog; this\n348|// list pins the reducer's handling against the section.\n349|func pinnedV1EventTypes() []string {\n350|\treturn []string{\n351|\t\t\"session.created\", \"terminal.created\", \"provider.launched\",\n352|\t\t\"provider.identified\", \"session.idle\", \"session.quiescing\",\n353|\t\t\"checkpoint.created\", \"sync.completed\", \"session.stopped\",\n354|\t\t\"session.resumed\", \"session.bootstrap_aborted\",\n355|\t\t\"lease.transferred\", \"lease.forced\", \"session.parked\",\n356|\t\t\"session.failed\", \"fork.created\", \"profile.changed\",\n357|\t\t\"session.tombstoned\", \"takeover.force_confirmed\",\n358|\t\t\"replica.replace_confirmed\", \"task_board.launched\",\n359|\t\t\"task_board.adopted\", \"tombstone.issued\", \"tombstone.resolved\",\n360|\t}\n361|}\n362|\n363|// deriveHandledEventTypes derives the handled event_type literals\n364|// from the effect switch cases. A non-literal case fails closed.\n365|func deriveHandledEventTypes(files []invcore.ProductionFile, fileSet *token.FileSet) (map[string]struct{}, []string) {\n366|\t_ = fileSet\n367|\tderived := map[string]struct{}{}\n368|\tvar failures []string\n369|\tfor _, production := range files {\n370|\t\tast.Inspect(production.Syntax, func(node ast.Node) bool {\n371|\t\t\tfunction, ok := node.(*ast.FuncDecl)\n372|\t\t\tif !ok || function.Name.Name != \"effect\" {\n373|\t\t\t\treturn true\n374|\t\t\t}\n375|\t\t\tast.Inspect(function.Body, func(inner ast.Node) bool {\n376|\t\t\t\tclause, ok := inner.(*ast.CaseClause)\n377|\t\t\t\tif !ok {\n378|\t\t\t\t\treturn true\n379|\t\t\t\t}\n380|\t\t\t\tfor _, expression := range clause.List {\n381|\t\t\t\t\tliteral, ok := expression.(*ast.BasicLit)\n382|\t\t\t\t\tif !ok || literal.Kind != token.STRING {\n383|\t\t\t\t\t\tfailures = append(failures, production.Name+\": effect case without a string literal fails closed\")\n384|\t\t\t\t\t\tcontinue\n385|\t\t\t\t\t}\n386|\t\t\t\t\tvalue, err := strconv.Unquote(literal.Value)\n387|\t\t\t\t\tif err != nil {\n388|\t\t\t\t\t\tfailures = append(failures, production.Name+\": effect case holds an unreadable literal\")\n389|\t\t\t\t\t\tcontinue\n390|\t\t\t\t\t}\n391|\t\t\t\t\tderived[value] = struct{}{}\n392|\t\t\t\t}\n393|\t\t\t\treturn true\n394|\t\t\t})\n395|\t\t\treturn false\n396|\t\t})\n397|\t}\n398|\treturn derived, failures\n399|}\n400|\n401|// TestEventHandlingIsCensused requires the derived handled set to\n402|// equal the roster in both directions, and the roster to equal the\n403|// pinned v1 registry exactly: a handled type without a row, a row\n404|// without a handler, and a registry type with no handling decision\n405|// each fail.\n406|func TestEventHandlingIsCensused(t *testing.T) {\n407|\tfiles, fileSet := invcore.MustScanProduction(t, \".\")\n408|\tderived, failures := deriveHandledEventTypes(files, fileSet)\n409|\tfor _, failure := range failures {\n410|\t\tt.Error(failure)\n411|\t}\n412|\trows := map[string]struct{}{}\n413|\tfor eventType, row := range eventRows() {\n414|\t\tif row.class != \"lifecycle\" && row.class != \"fact\" {\n415|\t\t\tt.Errorf(\"event row %s carries class %q, want lifecycle or fact\", eventType, row.class)\n416|\t\t}\n417|\t\tif row.driver == \"\" {\n418|\t\t\tt.Errorf(\"event row %s names no driver\", eventType)\n419|\t\t}\n420|\t\trows[eventType] = struct{}{}\n421|\t}\n422|\tinvcore.MustCheckBothDirections(t, \"sessstate handled events\", derived, rows)\n423|\tpinned := map[string]struct{}{}\n424|\tfor _, eventType := range pinnedV1EventTypes() {\n425|\t\tpinned[eventType] = struct{}{}\n426|\t}\n427|\tinvcore.MustCheckBothDirections(t, \"sessstate v1 registry\", pinned, rows)\n428|\tvar ordered []string\n429|\tfor eventType := range rows {\n430|\t\tordered = append(ordered, eventType)\n431|\t}\n432|\tsort.Strings(ordered)\n433|\tif len(ordered) != 24 {\n434|\t\tt.Fatalf(\"handled events = %d, want the 24-member v1 registry\", len(ordered))\n435|\t}\n436|\t_ = strings.Join(ordered, \",\")\n437|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c507","stream":{"kind":"session","id":"01a07db8-a28a-7e80-8be1-e3a988123386"},"sequence":222,"recorded_at":1780531400000439,"record_type":"event","durability":"durable","causation_id":"4385e4d6-e071-42f2-a438-a44213370546","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4385e4d6-e071-42f2-a438-a44213370546","run_stream":{"kind":"run","id":"4385e4d6-e071-42f2-a438-a44213370546"},"call_id":"call_01a07db9b4af74d3bac944de69ec2ee9","text":"Read text file `internal/sessstate/census_test.go`.\n1|package sessstate\n2|\n3|import (\n4|\t\"flag\"\n5|\t\"fmt\"\n6|\t\"go/ast\"\n7|\t\"go/token\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"runtime\"\n11|\t\"strconv\"\n12|\t\"strings\"\n13|\t\"testing\"\n14|\n15|\t\"github.com/relux-works/agent-session-manager/internal/invcore\"\n16|)\n17|\n18|// This file is the sessstate census. Three inventories derive their\n19|// denominator from production source through internal/invcore instead\n20|// of listing it:\n21|//\n22|//  1. Refusals: every direct refuse(SENTINEL, ...) call site must have\n23|//     a boundary-driven negative path, and every exercised refusal\n24|//     must derive. Calls sit on a single line with a bare sentinel\n25|//     identifier, or the derivation fails closed.\n26|//  2. States: the SessionState spellings derive structurally from the\n27|//     State-typed const block (plus State() conversions), each\n28|//     spelling lives exactly once as a production literal, and the\n29|//     census drives Reduce to every roster value through the\n30|//     production entry.\n31|//  3. Events: the handled event_type literals derive from the effect\n32|//     switch cases, each row names its class and driver, and the rows\n33|//     equal the pinned v1 registry exactly.\n34|//\n35|// Control plants below prove each half fails closed, including an\n36|// import alias and a var binding in both the passing and the failing\n37|// direction.\n38|var sessstateRefusalRecorder = invcore.NewSiteRecorder()\n39|\n40|var sessstateBoundarySites = map[string]struct{}{}\n41|\n42|var sessstateObservedSentinels = map[string]struct{}{}\n43|\n44|var sessstateBoundaryMarkers = []string{\n45|\t\"sessstate.Reduce\",\n46|\t\"sessstate.DecodeRecord\",\n47|\t\"sessstate.DecodeEvent\",\n48|\t\").Project\",\n49|}\n50|\n51|var sessstateSentinels = map[string]bool{\n52|\t\"ErrInvalidRecord\": true, \"ErrInvalidEvent\": true,\n53|\t\"ErrInvalidTransition\": true, \"ErrIntegrity\": true,\n54|\t\"ErrDerivation\": true, \"ErrUnknownSession\": true,\n55|\t\"ErrStaleLease\": true, \"ErrDivergentLease\": true,\n56|}\n57|\n58|func TestMain(main *testing.M) {\n59|\toriginal := refuse\n60|\trefuse = func(sentinel error, format string, arguments ...any) error {\n61|\t\terr := original(sentinel, format, arguments...)\n62|\t\tname := sentinelName(sentinel)\n63|\t\tsessstateRefusalRecorder.Record(name, 1)\n64|\t\tif beneathSessstateBoundary() {\n65|\t\t\tif site := callerSessstateSite(); site != \"\" {\n66|\t\t\t\tsessstateBoundarySites[site] = struct{}{}\n67|\t\t\t}\n68|\t\t\tsessstateObservedSentinels[name] = struct{}{}\n69|\t\t}\n70|\t\treturn err\n71|\t}\n72|\tcode := main.Run()\n73|\tif fullSessstatePackageTestRun() {\n74|\t\t// Static audits run on every full run, green or red, so a\n75|\t\t// plant reddens the gate even when an unrelated test is\n76|\t\t// already red. The refusal runtime audit compares exercised\n77|\t\t// sites against derived sites and stays gated on green.\n78|\t\tfiles, fileSet, scanFailures := invcore.ScanProduction(\".\")\n79|\t\tvar failures []string\n80|\t\tfailures = append(failures, scanFailures...)\n81|\t\tif len(scanFailures) == 0 {\n82|\t\t\tfailures = append(failures, auditSessstateAliases(files, fileSet)...)\n83|\t\t\tfailures = append(failures, auditSessstateUnrouted(files, fileSet)...)\n84|\t\t}\n85|\t\tif code == 0 {\n86|\t\t\tfailures = append(failures, auditSessstateRefusals()...)\n87|\t\t}\n88|\t\tif len(failures) != 0 {\n89|\t\t\tfor _, failure := range failures {\n90|\t\t\t\tfmt.Fprintln(os.Stderr, failure)\n91|\t\t\t}\n92|\t\t\tcode = 1\n93|\t\t}\n94|\t}\n95|\tos.Exit(code)\n96|}\n97|\n98|func sentinelName(sentinel error) string {\n99|\tcandidates := []struct {\n100|\t\tname  string\n101|\t\tvalue error\n102|\t}{\n103|\t\t{\"ErrInvalidRecord\", ErrInvalidRecord},\n104|\t\t{\"ErrInvalidEvent\", ErrInvalidEvent},\n105|\t\t{\"ErrInvalidTransition\", ErrInvalidTransition},\n106|\t\t{\"ErrIntegrity\", ErrIntegrity},\n107|\t\t{\"ErrDerivation\", ErrDerivation},\n108|\t\t{\"ErrUnknownSession\", ErrUnknownSession},\n109|\t\t{\"ErrStaleLease\", ErrStaleLease},\n110|\t\t{\"ErrDivergentLease\", ErrDivergentLease},\n111|\t}\n112|\tfor _, candidate := range candidates {\n113|\t\tif sentinel == candidate.value {\n114|\t\t\treturn candidate.name\n115|\t\t}\n116|\t}\n117|\treturn \"unknown-sentinel\"\n118|}\n119|\n120|func fullSessstatePackageTestRun() bool {\n121|\tselected := flag.Lookup(\"test.run\")\n122|\treturn selected == nil || selected.Value.String() == \"\"\n123|}\n124|\n125|// callerSessstateSite reports the production file:line of the refuse\n126|// call site.\n127|func callerSessstateSite() string {\n128|\tframes := make([]uintptr, 4)\n129|\tif count := runtime.Callers(3, frames); count == 0 {\n130|\t\treturn \"\"\n131|\t}\n132|\tlocated := runtime.CallersFrames(frames)\n133|\tframe, _ := located.Next()\n134|\tif frame.Function == \"\" {\n135|\t\treturn \"\"\n136|\t}\n137|\treturn filepath.Base(frame.File) + \":\" + strconv.Itoa(frame.Line)\n138|}\n139|\n140|func beneathSessstateBoundary() bool {\n141|\tframes := make([]uintptr, 64)\n142|\tfor {\n143|\t\tcount := runtime.Callers(2, frames)\n144|\t\tlocated := runtime.CallersFrames(frames[:count])\n145|\t\tfor range frames[:count] {\n146|\t\t\tframe, _ := located.Next()\n147|\t\t\tfor _, marker := range sessstateBoundaryMarkers {\n148|\t\t\t\tif strings.Contains(frame.Function, marker) {\n149|\t\t\t\t\treturn true\n150|\t\t\t\t}\n151|\t\t\t}\n152|\t\t}\n153|\t\tif count < len(frames) {\n154|\t\t\treturn false\n155|\t\t}\n156|\t\tframes = make([]uintptr, 2*len(frames))\n157|\t}\n158|}\n159|\n160|// auditSessstateRefusals derives the expected inventory from production\n161|// AST and requires the exercised sets to match it in both directions,\n162|// the alias and unrouted audits to be clean, and the observed sentinel\n163|// set to equal the derived sentinel roster exactly.\n164|func auditSessstateRefusals() []string {\n165|\tfiles, fileSet, scanFailures := invcore.ScanProduction(\".\")\n166|\tif len(scanFailures) != 0 {\n167|\t\treturn scanFailures\n168|\t}\n169|\t_, derived, failures := deriveSessstateRefusalSites(files, fileSet)\n170|\trows := map[string]struct{}{}\n171|\tfor site := range sessstateRefusalRows() {\n172|\t\trows[site] = struct{}{}\n173|\t}\n174|\tunregistered, orphaned, diffFailures := invcore.DiffSets(derived, rows)\n175|\tfailures = append(failures, diffFailures...)\n176|\tfor _, site := range unregistered {\n177|\t\tfailures = append(failures, \"sessstate refusal site without a boundary-driven row: \"+site)\n178|\t}\n179|\tfor _, site := range orphaned {\n180|\t\tfailures = append(failures, \"sessstate refusal row without a derived site: \"+site)\n181|\t}\n182|\tunexercised, underived, _ := invcore.DiffSets(derived, sessstateBoundarySites)\n183|\t_ = unexercised\n184|\tfor _, site := range underived {\n185|\t\tfailures = append(failures, \"sessstate exercised refusal outside the derived inventory: \"+site)\n186|\t}\n187|\tfor site := range derived {\n188|\t\tif _, ok := sessstateBoundarySites[site]; !ok {\n189|\t\t\tfailures = append(failures, \"sessstate refusal site without an exercised negative path: \"+site)\n190|\t\t}\n191|\t}\n192|\tderivedSentinels := map[string]struct{}{}\n193|\tfor _, sentinel := range derivedRefusalSentinels(files, fileSet) {\n194|\t\tderivedSentinels[sentinel] = struct{}{}\n195|\t}\n196|\tfor sentinel := range derivedSentinels {\n197|\t\tif _, ok := sessstateObservedSentinels[sentinel]; !ok {\n198|\t\t\tfailures = append(failures, \"sessstate sentinel never observed beneath a boundary: \"+sentinel)\n199|\t\t}\n200|\t}\n201|\tfor sentinel := range sessstateObservedSentinels {\n202|\t\tif _, ok := derivedSentinels[sentinel]; !ok {\n203|\t\t\tfailures = append(failures, \"sessstate observed sentinel outside the derived roster: \"+sentinel)\n204|\t\t}\n205|\t}\n206|\treturn failures\n207|}\n208|\n209|// refusalSite is one derived refuse call: production file:line plus\n210|// the sentinel it carries.\n211|type refusalSite struct {\n212|\tsite     string\n213|\tsentinel string\n214|}\n215|\n216|// deriveSessstateRefusalSites derives every direct refuse(SENTINEL,\n217|// ...) call in the production files as file:line with its sentinel.\n218|// Calls must sit on a single line with a bare sentinel identifier, or\n219|// the derivation fails closed; two calls sharing one line fail too.\n220|func deriveSessstateRefusalSites(files []invcore.ProductionFile, fileSet *token.FileSet) ([]refusalSite, map[string]struct{}, []string) {\n221|\tvar sites []refusalSite\n222|\tderived := map[string]struct{}{}\n223|\tvar failures []string\n224|\tfor _, production := range files {\n225|\t\tast.Inspect(production.Syntax, func(node ast.Node) bool {\n226|\t\t\tcall, ok := node.(*ast.CallExpr)\n227|\t\t\tif !ok {\n228|\t\t\t\treturn true\n229|\t\t\t}\n230|\t\t\tident, ok := call.Fun.(*ast.Ident)\n231|\t\t\tif !ok || ident.Name != \"refuse\" {\n232|\t\t\t\treturn true\n233|\t\t\t}\n234|\t\t\tif len(call.Args) == 0 {\n235|\t\t\t\tfailures = append(failures, production.Name+\": refuse call without a sentinel fails closed\")\n236|\t\t\t\treturn true\n237|\t\t\t}\n238|\t\t\tsentinel, ok := call.Args[0].(*ast.Ident)\n239|\t\t\tif !ok || !sessstateSentinels[sentinel.Name] {\n240|\t\t\t\tfailures = append(failures, production.Name+\": refuse call without a bare sentinel identifier fails closed\")\n241|\t\t\t\treturn true\n242|\t\t\t}\n243|\t\t\tfirst := fileSet.Position(call.Lparen)\n244|\t\t\tlast := fileSet.Position(call.Rparen)\n245|\t\t\tif !first.IsValid() || !last.IsValid() || first.Line != last.Line {\n246|\t\t\t\tfailures = append(failures, production.Name+\": refuse call outside one line fails closed\")\n247|\t\t\t\treturn true\n248|\t\t\t}\n249|\t\t\tsite := production.Name + \":\" + strconv.Itoa(first.Line)\n250|\t\t\tif _, duplicate := derived[site]; duplicate {\n251|\t\t\t\tfailures = append(failures, \"two refuse calls share production line \"+site)\n252|\t\t\t\treturn true\n253|\t\t\t}\n254|\t\t\tsites = append(sites, refusalSite{site: site, sentinel: sentinel.Name})\n255|\t\t\tderived[site] = struct{}{}\n256|\t\t\treturn true\n257|\t\t})\n258|\t}\n259|\treturn sites, derived, failures\n260|}\n261|\n262|// derivedRefusalSentinels reports the sentinel names carried by the\n263|// derived sites.\n264|func derivedRefusalSentinels(files []invcore.ProductionFile, fileSet *token.FileSet) []string {\n265|\tsites, _, _ := deriveSessstateRefusalSites(files, fileSet)\n266|\tseen := map[string]struct{}{}\n267|\tvar sentinels []string\n268|\tfor _, site := range sites {\n269|\t\tif _, ok := seen[site.sentinel]; !ok {\n270|\t\t\tseen[site.sentinel] = struct{}{}\n271|\t\t\tsentinels = append(sentinels, site.sentinel)\n272|\t\t}\n273|\t}\n274|\treturn sentinels\n275|}\n276|\n277|// auditSessstateUnrouted fails every fmt.Errorf that wraps a sentinel\n278|// with %w outside the refuse funnel: a sentinel-carrying refusal must\n279|// flow through refuse so the inventory can require its negative path.\n280|// Plain %v diagnostics stay allowed.\n281|func auditSessstateUnrouted(files []invcore.ProductionFile, fileSet *token.FileSet) []string {\n282|\tvar failures []string\n283|\tfor _, production := range files {\n284|\t\tast.Inspect(production.Syntax, func(node ast.Node) bool {\n285|\t\t\tcall, ok := node.(*ast.CallExpr)\n286|\t\t\tif !ok {\n287|\t\t\t\treturn true\n288|\t\t\t}\n289|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n290|\t\t\tif !ok || selector.Sel.Name != \"Errorf\" {\n291|\t\t\t\treturn true\n292|\t\t\t}\n293|\t\t\tif len(call.Args) == 0 {\n294|\t\t\t\treturn true\n295|\t\t\t}\n296|\t\t\tformat, ok := call.Args[0].(*ast.BasicLit)\n297|\t\t\tif !ok || !strings.Contains(format.Value, \"%w\") {\n298|\t\t\t\treturn true\n299|\t\t\t}\n300|\t\t\tfor _, argument := range call.Args[1:] {\n301|\t\t\t\tif ident, ok := argument.(*ast.Ident); ok && sessstateSentinels[ident.Name] {\n302|\t\t\t\t\tposition := fileSet.Position(call.Lparen)\n303|\t\t\t\t\tfailures = append(failures, \"sessstate refusals raised outside the refuse funnel (the derived inventory cannot require a negative path for them): \"+production.Name+\":\"+strconv.Itoa(position.Line))\n304|\t\t\t\t\treturn true\n305|\t\t\t\t}\n306|\t\t\t}\n307|\t\t\treturn true\n308|\t\t})\n309|\t}\n310|\treturn failures\n311|}\n312|\n313|// sessstateConstructorSpec is the alias-audit policy: the local funnel\n314|// must stay a direct call, and the watched owner delegations must stay\n315|// direct qualified calls resolved by import path.\n316|func sessstateConstructorSpec() invcore.ConstructorSpec {\n317|\treturn invcore.ConstructorSpec{\n318|\t\tLocal: map[string]bool{\"refuse\": true},\n319|\t\tQualified: map[string]map[string]bool{\n320|\t\t\t\"github.com/relux-works/agent-session-manager/internal/environ\":         {\"DecodeStrictObject\": true, \"CheckUUIDv7\": true, \"CheckUint53Bounds\": true},\n321|\t\t\t\"github.com/relux-works/agent-session-manager/internal/scalar\":          {\"ParseDigest\": true, \"ParseUUIDv4\": true, \"ParseUUIDv7\": true, \"ParseProviderID\": true},\n322|\t\t\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\": {\"ParseID\": true},\n323|\t\t},\n324|\t}\n325|}\n326|\n327|// auditSessstateAliases runs the alias audit over every production\n328|// file, allowlisting the funnel's own declaration position.\n329|func auditSessstateAliases(files []invcore.ProductionFile, fileSet *token.FileSet) []string {\n330|\tvar failures []string\n331|\tspec := sessstateConstructorSpec()\n332|\tfor _, production := range files {\n333|\t\tallowed := sessstateFunnelPositions(production.Syntax)\n334|\t\tfor _, failure := range invcore.AuditConstructorReferences(production.Syntax, fileSet, production.Name, spec) {\n335|\t\t\tif atAllowedPosition(failure, production.Name, fileSet, allowed) {\n336|\t\t\t\tcontinue\n337|\t\t\t}\n338|\t\t\tfailures = append(failures, failure)\n339|\t\t}\n340|\t}\n341|\treturn failures\n342|}\n343|\n344|func sessstateFunnelPositions(syntax *ast.File) map[token.Pos]bool {\n345|\tpositions := map[token.Pos]bool{}\n346|\tfor _, declaration := range syntax.Decls {\n347|\t\tgeneral, ok := declaration.(*ast.GenDecl)\n348|\t\tif !ok || general.Tok != token.VAR {\n349|\t\t\tcontinue\n350|\t\t}\n351|\t\tfor _, specification := range general.Specs {\n352|\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n353|\t\t\tif !ok {\n354|\t\t\t\tcontinue\n355|\t\t\t}\n356|\t\t\tfor index, name := range value.Names {\n357|\t\t\t\tif name.Name != \"refuse\" || index >= len(value.Values) {\n358|\t\t\t\t\tcontinue\n359|\t\t\t\t}\n360|\t\t\t\tif _, ok := value.Values[index].(*ast.FuncLit); ok {\n361|\t\t\t\t\tpositions[name.Pos()] = true\n362|\t\t\t\t}\n363|\t\t\t}\n364|\t\t}\n365|\t}\n366|\treturn positions\n367|}\n368|\n369|func atAllowedPosition(failure, display string, fileSet *token.FileSet, allowed map[token.Pos]bool) bool {\n370|\tfor position := range allowed {\n371|\t\tlocated := fileSet.Position(position)\n372|\t\tif !located.IsValid() {\n373|\t\t\tcontinue\n374|\t\t}\n375|\t\tprefix := display + \":\" + strconv.Itoa(located.Line) + \":\" + strconv.Itoa(located.Column) + \":\"\n376|\t\tif strings.Contains(failure, prefix) {\n377|\t\t\treturn true\n378|\t\t}\n379|\t}\n380|\treturn false\n381|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
