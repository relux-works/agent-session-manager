{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5a1","stream":{"kind":"session","id":"01a07db8-a28a-7e80-8be1-e3a988123386"},"sequence":299,"recorded_at":1780531400000593,"record_type":"event","durability":"durable","causation_id":"4385e4d6-e071-42f2-a438-a44213370546","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4385e4d6-e071-42f2-a438-a44213370546","run_stream":{"kind":"run","id":"4385e4d6-e071-42f2-a438-a44213370546"},"task_stream":{"kind":"task","id":"0c600913-f041-481d-bcc2-72d31a90a4b2"},"task_id":"0c600913-f041-481d-bcc2-72d31a90a4b2","event":{"kind":"output","task_id":"0c600913-f041-481d-bcc2-72d31a90a4b2","chunk":"Read text file `internal/sessstate/project_test.go`.\n(279 line(s) above)\n280|\t}\n281|\tif !reflect.DeepEqual(first, second) {\n282|\t\tt.Fatalf(\"Project is not idempotent:\\nfirst = %+v\\nsecond = %+v\", first, second)\n283|\t}\n284|\tif first.State != StateIdle || first.LocalRole != \"owner\" {\n285|\t\tt.Fatalf(\"projection = %+v, want idle owner\", first)\n286|\t}\n287|}\n288|\n289|// TestProjectDerivesLocalStale requires the local projection to go\n290|// stale when its lease loses: the winner stands idle under lease B\n291|// while the local host still acts under lease A, with the\n292|// stale_process warning raised.\n293|func TestProjectDerivesLocalStale(t *testing.T) {\n294|\trecord := buildRecord(t, nil)\n295|\tbuilder := openChain(t, record)\n296|\tdecoded, err := DecodeRecord(record)\n297|\tif err != nil {\n298|\t\tt.Fatalf(\"DecodeRecord error = %v\", err)\n299|\t}\n300|\tbuilder.append(eventOptions{epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \"session.created\", payload: createdPayload(decoded.RecordID)})\n301|\tbuilder.append(eventOptions{epoch: 1, leaseID: testLeaseID, sequence: 2, eventType: \"provider.launched\", payload: launchedPayload(\"codex\")})\n302|\tbuilder.append(eventOptions{epoch: 1, leaseID: testLeaseID, sequence: 3, eventType: \"session.idle\", payload: idlePayload()})\n303|\tbuilder.append(eventOptions{epoch: 1, leaseID: testLeaseID, sequence: 4, eventType: \"checkpoint.created\", payload: checkpointPayload()})\n304|\tbuilder.append(eventOptions{epoch: 1, leaseID: testLeaseID, sequence: 5, eventType: \"checkpoint.created\", payload: checkpointPayload()})\n305|\tbuilder.append(eventOptions{epoch: 1, leaseID: testLeaseID, sequence: 6, eventType: \"session.stopped\", payload: stoppedPayload()})\n306|\tbuilder.append(eventOptions{epoch: 2, leaseID: testLeaseIDB, sequence: 1, eventType: \"lease.transferred\", payload: transferredPayload(testLeaseID, testLeaseIDB)})\n307|\tbuilder.append(eventOptions{epoch: 2, leaseID: testLeaseIDB, sequence: 2, eventType: \"session.resumed\", payload: resumedPayload()})\n308|\tbuilder.append(eventOptions{epoch: 2, leaseID: testLeaseIDB, sequence: 3, eventType: \"session.idle\", payload: idlePayload()})\n309|\n310|\twinner, err := (&Projector{Repo: builder.repo}).Project(builder.sessionID)\n311|\tif err != nil {\n312|\t\tt.Fatalf(\"Project(winner) error = %v\", err)\n313|\t}\n314|\tif winner.State != StateIdle {\n315|\t\tt.Fatalf(\"winner state = %q, want idle\", winner.State)\n316|\t}\n317|\tlocal, err := (&Projector{\n318|\t\tRepo:        builder.repo,\n319|\t\tLocalHostID: testHostIDB,\n320|\t\tLocal:       LeaseHead{Epoch: 1, LeaseID: testLeaseID},\n321|\t}).Project(builder.sessionID)\n322|\tif err != nil {\n323|\t\tt.Fatalf(\"Project(local) error = %v\", err)\n324|\t}\n325|\tif local.State != StateStale {\n326|\t\tt.Fatalf(\"local state = %q, want stale\", local.State)\n327|\t}\n328|\tassertWarning(t, local, \"stale_process\")\n329|\tif local.Winner != (LeaseHead{Epoch: 2, LeaseID: testLeaseIDB}) {\n330|\t\tt.Fatalf(\"local winner = %+v, want epoch 2 lease B\", local.Winner)\n331|\t}\n332|}\n333|\n334|// TestProjectLeavesStoppedPastTakeoverUnstaled requires the stale\n335|// override to stay transition-gated: a stopped winner with a losing\n336|// local lease keeps stopped (stopped has no edge to stale) while the\n337|// winner still reports the new lease.\n338|func TestProjectLeavesStoppedPastTakeoverUnstaled(t *testing.T) {\n339|\trecord := buildRecord(t, nil)\n340|\tbuilder := openChain(t, record)\n341|\tdecoded, err := DecodeRecord(record)\n342|\tif err != nil {\n343|\t\tt.Fatalf(\"DecodeRecord error = %v\", err)\n344|\t}\n345|\tbuilder.append(eventOptions{epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \"session.created\", payload: createdPayload(decoded.RecordID)})\n346|\tbuilder.append(eventOptions{epoch: 1, leaseID: testLeaseID, sequence: 2, eventType: \"provider.launched\", payload: launchedPayload(\"codex\")})\n347|\tbuilder.append(eventOptions{epoch: 1, leaseID: testLeaseID, sequence: 3, eventType: \"session.idle\", payload: idlePayload()})\n348|\tbuilder.append(eventOptions{epoch: 1, leaseID: testLeaseID, sequence: 4, eventType: \"checkpoint.created\", payload: checkpointPayload()})\n349|\tbuilder.append(eventOptions{epoch: 1, leaseID: testLeaseID, sequence: 5, eventType: \"checkpoint.created\", payload: checkpointPayload()})\n350|\tbuilder.append(eventOptions{epoch: 1, leaseID: testLeaseID, sequence: 6, eventType: \"session.stopped\", payload: stoppedPayload()})\n351|\tlocal, err := (&Projector{\n352|\t\tRepo:  builder.repo,\n353|\t\tLocal: LeaseHead{Epoch: 1, LeaseID: testLeaseID},\n354|\t\tUnion: []LeaseHead{{Epoch: 2, LeaseID: testLeaseIDB}},\n355|\t}).Project(builder.sessionID)\n356|\tif err != nil {\n357|\t\tt.Fatalf(\"Project error = %v\", err)\n358|\t}\n359|\tif local.State != StateStopped {\n360|\t\tt.Fatalf(\"state = %q, want stopped: no table edge carries it to stale\", local.State)\n361|\t}\n362|\tif local.Winner != (LeaseHead{Epoch: 2, LeaseID: testLeaseIDB}) {\n363|\t\tt.Fatalf(\"winner = %+v, want the union winner\", local.Winner)\n364|\t}\n365|}\n366|\n367|// TestProjectRefusesWithoutRepository requires a nil repository to\n368|// refuse instead of panicking.\n369|func TestProjectRefusesWithoutRepository(t *testing.T) {\n370|\t_, err := (&Projector{}).Project(testSessionID)\n371|\tmustErrorIs(t, err, ErrDerivation, \"Project(nil repo)\")\n372|}"}}}
