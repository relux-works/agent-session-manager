{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c53b","stream":{"kind":"session","id":"01a07db8-a28a-7e80-8be1-e3a988123386"},"sequence":248,"recorded_at":1780531400000491,"record_type":"event","durability":"durable","causation_id":"4385e4d6-e071-42f2-a438-a44213370546","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4385e4d6-e071-42f2-a438-a44213370546","run_stream":{"kind":"run","id":"4385e4d6-e071-42f2-a438-a44213370546"},"call_id":"call_01a07db9bc9270a095bcdce8992f56b0","text":"Read text file `internal/sessstate/census_plants_test.go`.\n1|package sessstate\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/invcore\"\n8|)\n9|\n10|type sessstateAliasPlant struct {\n11|\tname        string\n12|\tsource      string\n13|\twantFailure string\n14|}\n15|\n16|func sessstateAliasPlants() []sessstateAliasPlant {\n17|\tenvironPath := `\"github.com/relux-works/agent-session-manager/internal/environ\"`\n18|\tscalar := `\"github.com/relux-works/agent-session-manager/internal/scalar\"`\n19|\treturn []sessstateAliasPlant{\n20|\t\t{\n21|\t\t\tname:        \"direct local call is clean\",\n22|\t\t\tsource:      \"package plant\\nfunc run() error {\\n\\treturn refuse(ErrInvalidEvent, \\\"no\\\")\\n}\\n\",\n23|\t\t\twantFailure: \"\",\n24|\t\t},\n25|\t\t{\n26|\t\t\tname:        \"import alias direct call resolves by path\",\n27|\t\t\tsource:      \"package plant\\nimport env \" + environPath + \"\\nfunc run(raw []byte) {\\n\\t_, _ = env.DecodeStrictObject(raw)\\n}\\n\",\n28|\t\t\twantFailure: \"\",\n29|\t\t},\n30|\t\t{\n31|\t\t\tname:        \"import alias var binding fails\",\n32|\t\t\tsource:      \"package plant\\nimport env \" + environPath + \"\\nfunc run(raw []byte) {\\n\\tdecode := env.DecodeStrictObject\\n\\t_, _ = decode(raw)\\n}\\n\",\n33|\t\t\twantFailure: \"outside direct-call position\",\n34|\t\t},\n35|\t\t{\n36|\t\t\tname:        \"local var binding fails\",\n37|\t\t\tsource:      \"package plant\\nfunc run() error {\\n\\tdeny := refuse\\n\\treturn deny(ErrInvalidEvent, \\\"no\\\")\\n}\\n\",\n38|\t\t\twantFailure: \"outside direct-call position\",\n39|\t\t},\n40|\t\t{\n41|\t\t\tname:        \"dot import of a watched path fails closed\",\n42|\t\t\tsource:      \"package plant\\nimport . \" + scalar + \"\\nfunc run(value string) {\\n\\t_, _ = ParseDigest(value)\\n}\\n\",\n43|\t\t\twantFailure: \"dot-imports watched path\",\n44|\t\t},\n45|\t\t{\n46|\t\t\tname:        \"shadowed funnel name fails closed\",\n47|\t\t\tsource:      \"package plant\\nfunc run(refuse int) int {\\n\\treturn refuse\\n}\\n\",\n48|\t\t\twantFailure: \"outside direct-call position\",\n49|\t\t},\n50|\t}\n51|}\n52|\n53|// TestCensusAliasPlants drives every control through the production\n54|// audit spec and requires the ledgered outcome, in both the passing\n55|// and the failing direction. A plant that stops reporting fails here\n56|// by construction.\n57|func TestCensusAliasPlants(t *testing.T) {\n58|\tspec := sessstateConstructorSpec()\n59|\tfor _, plant := range sessstateAliasPlants() {\n60|\t\tt.Run(plant.name, func(t *testing.T) {\n61|\t\t\tsyntax, fileSet, failure := invcore.ParseSource(\"plant.go\", []byte(plant.source))\n62|\t\t\tif failure != \"\" {\n63|\t\t\t\tt.Fatalf(\"control does not parse: %s\", failure)\n64|\t\t\t}\n65|\t\t\tfailures := invcore.AuditConstructorReferences(syntax, fileSet, \"plant.go\", spec)\n66|\t\t\tif plant.wantFailure == \"\" {\n67|\t\t\t\tif len(failures) != 0 {\n68|\t\t\t\t\tt.Fatalf(\"clean plant reported: %s\", strings.Join(failures, \"; \"))\n69|\t\t\t\t}\n70|\t\t\t\treturn\n71|\t\t\t}\n72|\t\t\tmatched := false\n73|\t\t\tfor _, failure := range failures {\n74|\t\t\t\tif strings.Contains(failure, plant.wantFailure) {\n75|\t\t\t\t\tmatched = true\n76|\t\t\t\t}\n77|\t\t\t}\n78|\t\t\tif !matched {\n79|\t\t\t\tt.Fatalf(\"plant reported %q, want a failure containing %q\", failures, plant.wantFailure)\n80|\t\t\t}\n81|\t\t})\n82|\t}\n83|}\n84|\n85|// TestCensusPlantHarnessFailsClosed proves the plant harness itself is\n86|// fail-closed: an unparseable control is a harness failure, never\n87|// clean.\n88|func TestCensusPlantHarnessFailsClosed(t *testing.T) {\n89|\t_, _, failure := invcore.ParseSource(\"plant.go\", []byte(\"package plant\\nfunc broken( {\\n\"))\n90|\tif failure == \"\" {\n91|\t\tt.Fatal(\"unparseable control parsed clean; the harness would pass a blind plant\")\n92|\t}\n93|}\n94|\n95|// TestCensusDerivationFailsClosed plants every derivation failure\n96|// shape against the production derive funcs: a call the derivation\n97|// cannot classify fails instead of passing silently.\n98|func TestCensusDerivationFailsClosed(t *testing.T) {\n99|\tderive := func(t *testing.T, source string) []string {\n100|\t\tt.Helper()\n101|\t\tsyntax, fileSet, failure := invcore.ParseSource(\"plant.go\", []byte(source))\n102|\t\tif failure != \"\" {\n103|\t\t\tt.Fatalf(\"control does not parse: %s\", failure)\n104|\t\t}\n105|\t\t_, _, failures := deriveSessstateRefusalSites([]invcore.ProductionFile{{Name: \"plant.go\", Syntax: syntax}}, fileSet)\n106|\t\treturn failures\n107|\t}\n108|\tcases := []struct {\n109|\t\tname   string\n110|\t\tsource string\n111|\t}{\n112|\t\t{\"no sentinel\", \"package plant\\nfunc run() error {\\n\\treturn refuse()\\n}\\n\"},\n113|\t\t{\"non-ident sentinel\", \"package plant\\nfunc run() error {\\n\\treturn refuse(\\\"no\\\", \\\"x\\\")\\n}\\n\"},\n114|\t\t{\"unknown sentinel\", \"package plant\\nfunc run() error {\\n\\treturn refuse(ErrSomethingElse, \\\"x\\\")\\n}\\n\"},\n115|\t\t{\"multiline call\", \"package plant\\nfunc run() error {\\n\\treturn refuse(ErrInvalidEvent,\\n\\t\\t\\\"x\\\")\\n}\\n\"},\n116|\t}\n117|\tfor _, tc := range cases {\n118|\t\tt.Run(tc.name, func(t *testing.T) {\n119|\t\t\tif failures := derive(t, tc.source); len(failures) == 0 {\n120|\t\t\t\tt.Fatalf(\"plant %q derived clean; the derivation is blind to it\", tc.name)\n121|\t\t\t}\n122|\t\t})\n123|\t}\n124|\tt.Run(\"shared line\", func(t *testing.T) {\n125|\t\tsource := \"package plant\\nfunc run() error {\\n\\t_ = refuse(ErrInvalidEvent, \\\"a\\\"); _ = refuse(ErrInvalidEvent, \\\"b\\\")\\n\\treturn nil\\n}\\n\"\n126|\t\tif failures := derive(t, source); len(failures) == 0 {\n127|\t\t\tt.Fatal(\"two refuse calls sharing one line derived clean\")\n128|\t\t}\n129|\t})\n130|\tt.Run(\"unrouted sentinel wrap\", func(t *testing.T) {\n131|\t\tsource := \"package plant\\nimport \\\"fmt\\\"\\nvar errShaped = fmt.Errorf(\\\"%w\\\", ErrInvalidEvent)\\n\"\n132|\t\tsyntax, fileSet, failure := invcore.ParseSource(\"plant.go\", []byte(source))\n133|\t\tif failure != \"\" {\n134|\t\t\tt.Fatalf(\"control does not parse: %s\", failure)\n135|\t\t}\n136|\t\tfailures := auditSessstateUnrouted([]invcore.ProductionFile{{Name: \"plant.go\", Syntax: syntax}}, fileSet)\n137|\t\tif len(failures) == 0 {\n138|\t\t\tt.Fatal(\"sentinel wrapped with %w outside refuse audited clean\")\n139|\t\t}\n140|\t})\n141|\tt.Run(\"state conversion over variable\", func(t *testing.T) {\n142|\t\tsource := \"package plant\\ntype State string\\nfunc convert(s string) State {\\n\\treturn State(s)\\n}\\n\"\n143|\t\tsyntax, fileSet, failure := invcore.ParseSource(\"plant.go\", []byte(source))\n144|\t\tif failure != \"\" {\n145|\t\t\tt.Fatalf(\"control does not parse: %s\", failure)\n146|\t\t}\n147|\t\t_, _, failures := deriveStateSpellings([]invcore.ProductionFile{{Name: \"plant.go\", Syntax: syntax}}, fileSet)\n148|\t\tif len(failures) == 0 {\n149|\t\t\tt.Fatal(\"State() conversion over a variable derived clean\")\n150|\t\t}\n151|\t})\n152|\tt.Run(\"new state spelling is unregistered\", func(t *testing.T) {\n153|\t\tsource := \"package plant\\ntype State string\\nconst StateQuiesced State = \\\"quiesced\\\"\\n\"\n154|\t\tsyntax, fileSet, failure := invcore.ParseSource(\"plant.go\", []byte(source))\n155|\t\tif failure != \"\" {\n156|\t\t\tt.Fatalf(\"control does not parse: %s\", failure)\n157|\t\t}\n158|\t\tderived, _, failures := deriveStateSpellings([]invcore.ProductionFile{{Name: \"plant.go\", Syntax: syntax}}, fileSet)\n159|\t\tif len(failures) != 0 {\n160|\t\t\tt.Fatalf(\"plant derivation failed: %v\", failures)\n161|\t\t}\n162|\t\trows := map[string]struct{}{}\n163|\t\tfor spelling := range stateRows() {\n164|\t\t\trows[spelling] = struct{}{}\n165|\t\t}\n166|\t\tunregistered, _, _ := invcore.DiffSets(derived, rows)\n167|\t\tif len(unregistered) == 0 {\n168|\t\t\tt.Fatal(\"a new State spelling diffed clean against the roster\")\n169|\t\t}\n170|\t})\n171|\tt.Run(\"orphan row\", func(t *testing.T) {\n172|\t\trows := map[string]struct{}{\"creating\": {}, \"no-such-state\": {}}\n173|\t\tderived := map[string]struct{}{\"creating\": {}}\n174|\t\t_, orphaned, _ := invcore.DiffSets(derived, rows)\n175|\t\tif len(orphaned) == 0 {\n176|\t\t\tt.Fatal(\"an orphan row diffed clean\")\n177|\t\t}\n178|\t})\n179|\tt.Run(\"effect case without literal\", func(t *testing.T) {\n180|\t\tsource := \"package plant\\nfunc effect(kind string) string {\\n\\tswitch kind {\\n\\tcase kind:\\n\\t\\treturn kind\\n\\t}\\n\\treturn \\\"\\\"\\n}\\n\"\n181|\t\tsyntax, fileSet, failure := invcore.ParseSource(\"plant.go\", []byte(source))\n182|\t\tif failure != \"\" {\n183|\t\t\tt.Fatalf(\"control does not parse: %s\", failure)\n184|\t\t}\n185|\t\t// The production derivation keys on FuncDecl \"effect\": the\n186|\t\t// plant reuses that name so the rule under test fires.\n187|\t\t_, failures := deriveHandledEventTypes([]invcore.ProductionFile{{Name: \"plant.go\", Syntax: syntax}}, fileSet)\n188|\t\tif len(failures) == 0 {\n189|\t\t\tt.Fatal(\"a non-literal effect case derived clean\")\n190|\t\t}\n191|\t})\n192|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c53d","stream":{"kind":"session","id":"01a07db8-a28a-7e80-8be1-e3a988123386"},"sequence":249,"recorded_at":1780531400000493,"record_type":"event","durability":"durable","causation_id":"4385e4d6-e071-42f2-a438-a44213370546","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4385e4d6-e071-42f2-a438-a44213370546","run_stream":{"kind":"run","id":"4385e4d6-e071-42f2-a438-a44213370546"},"call_id":"call_01a07db9bd5373e2ab766b8ed5af1153","text":"Read text file `internal/sessstate/winner_test.go`.\n1|package sessstate\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|)\n7|\n8|// baseBootstrap returns the created+launched specs opening every\n9|// winner test under lease A at epoch 1.\n10|func baseBootstrap(record Record) []eventSpec {\n11|\treturn []eventSpec{\n12|\t\t{typ: \"session.created\", payload: createdPayload(record.RecordID)},\n13|\t\t{typ: \"provider.launched\", payload: launchedPayload(\"codex\")},\n14|\t}\n15|}\n16|\n17|func decodeTestRecord(t *testing.T) Record {\n18|\tt.Helper()\n19|\tdecoded, err := DecodeRecord(buildRecord(t, nil))\n20|\tif err != nil {\n21|\t\tt.Fatalf(\"DecodeRecord error = %v\", err)\n22|\t}\n23|\treturn decoded\n24|}\n25|\n26|func reduceSpecs(t *testing.T, record Record, specs []eventSpec, extra Input) (Projection, error) {\n27|\tt.Helper()\n28|\traw := buildRecord(t, nil)\n29|\t_, events, _ := buildChain(t, raw, specs)\n30|\tinput := Input{Record: record, Events: events}\n31|\tinput.Union = extra.Union\n32|\tinput.Local = extra.Local\n33|\tinput.LocalHostID = extra.LocalHostID\n34|\treturn Reduce(input)\n35|}\n36|\n37|func conflictKinds(projection Projection) []string {\n38|\tvar kinds []string\n39|\tfor _, conflict := range projection.Conflicts {\n40|\t\tkinds = append(kinds, conflict.Kind)\n41|\t}\n42|\treturn kinds\n43|}\n44|\n45|// TestWinnerResolutionClearWin requires the plain succession — epoch 1\n46|// to epoch 2 — to select the higher epoch with no conflict recorded.\n47|func TestWinnerResolutionClearWin(t *testing.T) {\n48|\trecord := decodeTestRecord(t)\n49|\t// The takeover stales the running winner, so the new owner stops\n50|\t// and resumes before running again: stale to stopped to running.\n51|\tspecs := append(baseBootstrap(record),\n52|\t\teventSpec{epoch: 2, leaseID: testLeaseIDB, typ: \"lease.transferred\", payload: transferredPayload(testLeaseID, testLeaseIDB)},\n53|\t\teventSpec{epoch: 2, leaseID: testLeaseIDB, typ: \"session.stopped\", payload: stoppedPayload()},\n54|\t\teventSpec{epoch: 2, leaseID: testLeaseIDB, typ: \"session.resumed\", payload: resumedPayload()},\n55|\t)\n56|\tprojection, err := reduceSpecs(t, record, specs, Input{})\n57|\tif err != nil {\n58|\t\tt.Fatalf(\"Reduce error = %v\", err)\n59|\t}\n60|\tif projection.Winner != (LeaseHead{Epoch: 2, LeaseID: testLeaseIDB}) {\n61|\t\tt.Fatalf(\"winner = %+v, want epoch 2 lease B\", projection.Winner)\n62|\t}\n63|\tif len(projection.Conflicts) != 0 {\n64|\t\tt.Fatalf(\"conflicts = %+v, want none on a clear win\", projection.Conflicts)\n65|\t}\n66|\tif projection.State != StateRunning {\n67|\t\tt.Fatalf(\"state = %q, want running\", projection.State)\n68|\t}\n69|}\n70|\n71|// TestWinnerResolutionTie requires the equal-epoch case to resolve by\n72|// the bytewise-greater lease ID under the named tie rule, with the\n73|// conflict recorded and the divergent_history warning raised.\n74|func TestWinnerResolutionTie(t *testing.T) {\n75|\trecord := decodeTestRecord(t)\n76|\tspecs := baseBootstrap(record)\n77|\t// The rival shares epoch 1 with the chain lease but sorts below\n78|\t// it, so the chain lease keeps the epoch while both the tie and\n79|\t// the rival's losing branch are reported.\n80|\tunion := []LeaseHead{{Epoch: 1, LeaseID: testLeaseIDR}}\n81|\tprojection, err := reduceSpecs(t, record, specs, Input{Union: union})\n82|\tif err != nil {\n83|\t\tt.Fatalf(\"Reduce error = %v\", err)\n84|\t}\n85|\tif projection.Winner != (LeaseHead{Epoch: 1, LeaseID: testLeaseID}) {\n86|\t\tt.Fatalf(\"winner = %+v, want epoch 1 chain lease\", projection.Winner)\n87|\t}\n88|\tkinds := conflictKinds(projection)\n89|\tif len(kinds) != 2 || kinds[0] != ConflictLosingBranchPreserved || kinds[1] != ConflictSameEpochTie {\n90|\t\tt.Fatalf(\"conflicts = %v, want [losing_branch_preserved same_epoch_tie]\", kinds)\n91|\t}\n92|\tfor _, conflict := range projection.Conflicts {\n93|\t\tif conflict.Kind == ConflictSameEpochTie && conflict.Rule != ResolveRuleGreatestLeaseIDWins {\n94|\t\t\tt.Fatalf(\"rule = %q, want greatest-lease-id-wins\", conflict.Rule)\n95|\t\t}\n96|\t}\n97|\tassertWarning(t, projection, \"divergent_history\")\n98|}\n99|\n100|// TestWinnerResolutionTieOrdersBytewise pins the tie-break direction:\n101|// the greater ID wins even when the union lists it first, so wall\n102|// clock or arrival order cannot bias the outcome.\n103|func TestWinnerResolutionTieOrdersBytewise(t *testing.T) {\n104|\trecord := decodeTestRecord(t)\n105|\tspecs := baseBootstrap(record)\n106|\tunion := []LeaseHead{\n107|\t\t{Epoch: 1, LeaseID: testLeaseIDC},\n108|\t\t{Epoch: 1, LeaseID: testLeaseIDB},\n109|\t}\n110|\tprojection, err := reduceSpecs(t, record, specs, Input{Union: union})\n111|\tif err != nil {\n112|\t\tt.Fatalf(\"Reduce error = %v\", err)\n113|\t}\n114|\tif projection.Winner.LeaseID != testLeaseIDC {\n115|\t\tt.Fatalf(\"winner = %s, want lease C regardless of union order\", projection.Winner.LeaseID)\n116|\t}\n117|\tkinds := conflictKinds(projection)\n118|\twant := map[string]bool{\n119|\t\tConflictSameEpochTie: true, ConflictLosingBranchPreserved: true,\n120|\t\tConflictUnionSupersedesChain: true,\n121|\t}\n122|\tif len(kinds) != len(want) {\n123|\t\tt.Fatalf(\"conflicts = %v, want the tie with its losing branch and off-chain winner\", kinds)\n124|\t}\n125|\tfor _, kind := range kinds {\n126|\t\tif !want[kind] {\n127|\t\t\tt.Fatalf(\"conflicts = %v, want the tie with its losing branch and off-chain winner\", kinds)\n128|\t\t}\n129|\t}\n130|}\n131|\n132|// TestWinnerResolutionGap requires an epoch jump in the authoritative\n133|// chain to keep the greatest tuple as winner while recording the gap\n134|// conflict: both sides are not individually valid (the jump skips the\n135|// predecessor-plus-one rule), so the named rule carries the healing\n136|// condition.\n137|func TestWinnerResolutionGap(t *testing.T) {\n138|\trecord := decodeTestRecord(t)\n139|\tspecs := append(baseBootstrap(record),\n140|\t\teventSpec{epoch: 3, leaseID: testLeaseIDB, typ: \"lease.transferred\", payload: transferredPayload(testLeaseID, testLeaseIDB)},\n141|\t)\n142|\tprojection, err := reduceSpecs(t, record, specs, Input{})\n143|\tif err != nil {\n144|\t\tt.Fatalf(\"Reduce error = %v\", err)\n145|\t}\n146|\tif projection.Winner != (LeaseHead{Epoch: 3, LeaseID: testLeaseIDB}) {\n147|\t\tt.Fatalf(\"winner = %+v, want epoch 3 lease B\", projection.Winner)\n148|\t}\n149|\tkinds := conflictKinds(projection)\n150|\tif len(kinds) != 1 || kinds[0] != ConflictEpochGap {\n151|\t\tt.Fatalf(\"conflicts = %v, want exactly [epoch_gap]\", kinds)\n152|\t}\n153|\tif projection.Conflicts[0].Rule != ResolveRuleGreatestTupleWins {\n154|\t\tt.Fatalf(\"rule = %q, want greatest-tuple-wins\", projection.Conflicts[0].Rule)\n155|\t}\n156|\tassertWarning(t, projection, \"divergent_history\")\n157|}\n158|\n159|// TestWinnerResolutionLosingBranchPreserved requires union leases that\n160|// lose the tuple comparison to be reported preserved-never-applied\n161|// while the chain winner stands. The rival shares the head epoch, so\n162|// its tie reports at epoch 2.\n163|func TestWinnerResolutionLosingBranchPreserved(t *testing.T) {\n164|\trecord := decodeTestRecord(t)\n165|\tspecs := append(baseBootstrap(record),\n166|\t\teventSpec{epoch: 2, leaseID: testLeaseIDB, typ: \"lease.transferred\", payload: transferredPayload(testLeaseID, testLeaseIDB)},\n167|\t)\n168|\tunion := []LeaseHead{{Epoch: 2, LeaseID: testLeaseIDR}}\n169|\tprojection, err := reduceSpecs(t, record, specs, Input{Union: union})\n170|\tif err != nil {\n171|\t\tt.Fatalf(\"Reduce error = %v\", err)\n172|\t}\n173|\tif projection.Winner != (LeaseHead{Epoch: 2, LeaseID: testLeaseIDB}) {\n174|\t\tt.Fatalf(\"winner = %+v, want epoch 2 lease B\", projection.Winner)\n175|\t}\n176|\tkinds := conflictKinds(projection)\n177|\tif len(kinds) != 2 || kinds[0] != ConflictLosingBranchPreserved || kinds[1] != ConflictSameEpochTie {\n178|\t\tt.Fatalf(\"conflicts = %v, want [losing_branch_preserved same_epoch_tie]\", kinds)\n179|\t}\n180|\tassertConflictDetailContains(t, projection, ConflictSameEpochTie, \"epoch 2 is shared\")\n181|}\n182|\n183|// TestWinnerResolutionUnionSupersedesChain requires an off-chain union\n184|// winner to move the reported winner without rewriting authoritative\n185|// state, under its named rule.\n186|func TestWinnerResolutionUnionSupersedesChain(t *testing.T) {\n187|\trecord := decodeTestRecord(t)\n188|\tspecs := baseBootstrap(record)\n189|\tunion := []LeaseHead{{Epoch: 2, LeaseID: testLeaseIDB}}\n190|\tprojection, err := reduceSpecs(t, record, specs, Input{Union: union})\n191|\tif err != nil {\n192|\t\tt.Fatalf(\"Reduce error = %v\", err)\n193|\t}\n194|\tif projection.Winner != (LeaseHead{Epoch: 2, LeaseID: testLeaseIDB}) {\n195|\t\tt.Fatalf(\"winner = %+v, want epoch 2 lease B\", projection.Winner)\n196|\t}\n197|\tif projection.State != StateRunning {\n198|\t\tt.Fatalf(\"state = %q, want running: authoritative state is unchanged\", projection.State)\n199|\t}\n200|\tkinds := conflictKinds(projection)\n201|\tif len(kinds) != 1 || kinds[0] != ConflictUnionSupersedesChain {\n202|\t\tt.Fatalf(\"conflicts = %v, want exactly [union_supersedes_chain]\", kinds)\n203|\t}\n204|\tif projection.Conflicts[0].Rule != ResolveRuleAuthoritativeStateUnchanged {\n205|\t\tt.Fatalf(\"rule = %q, want authoritative-state-unchanged\", projection.Conflicts[0].Rule)\n206|\t}\n207|}\n208|\n209|// TestWinnerResolutionPastEpochTie resolves a tie planted at a past\n210|// epoch against the lease the chain actually stood on: the union rival\n211|// at epoch 1 loses to the chain's epoch-2 head, and the epoch-1 tie is\n212|// still reported because two distinct leases shared it.\n213|func TestWinnerResolutionPastEpochTie(t *testing.T) {\n214|\trecord := decodeTestRecord(t)\n215|\tspecs := append(baseBootstrap(record),\n216|\t\teventSpec{epoch: 2, leaseID: testLeaseIDB, typ: \"lease.transferred\", payload: transferredPayload(testLeaseID, testLeaseIDB)},\n217|\t)\n218|\tunion := []LeaseHead{{Epoch: 1, LeaseID: testLeaseIDC}}\n219|\tprojection, err := reduceSpecs(t, record, specs, Input{Union: union})\n220|\tif err != nil {\n221|\t\tt.Fatalf(\"Reduce error = %v\", err)\n222|\t}\n223|\tif projection.Winner != (LeaseHead{Epoch: 2, LeaseID: testLeaseIDB}) {\n224|\t\tt.Fatalf(\"winner = %+v, want epoch 2 lease B\", projection.Winner)\n225|\t}\n226|\tkinds := conflictKinds(projection)\n227|\twant := map[string]bool{ConflictSameEpochTie: true, ConflictLosingBranchPreserved: true}\n228|\tif len(kinds) != 2 {\n229|\t\tt.Fatalf(\"conflicts = %v, want tie plus losing branch\", kinds)\n230|\t}\n231|\tfor _, kind := range kinds {\n232|\t\tif !want[kind] {\n233|\t\t\tt.Fatalf(\"conflicts = %v, want tie plus losing branch\", kinds)\n234|\t\t}\n235|\t}\n236|\tassertConflictDetailContains(t, projection, ConflictSameEpochTie, \"epoch 1 is shared\")\n237|}\n238|\n239|// TestProviderMismatchKeepsRecordPinned requires a launch under a\n240|// foreign provider to record the named conflict while the record\n241|// provider stays authoritative.\n242|func TestProviderMismatchKeepsRecordPinned(t *testing.T) {\n243|\trecord := decodeTestRecord(t)\n244|\tspecs := []eventSpec{\n245|\t\t{typ: \"session.created\", payload: createdPayload(record.RecordID)},\n246|\t\t{typ: \"provider.launched\", payload: launchedPayload(\"qwen\")},\n247|\t}\n248|\tprojection, err := reduceSpecs(t, record, specs, Input{})\n249|\tif err != nil {\n250|\t\tt.Fatalf(\"Reduce error = %v\", err)\n251|\t}\n252|\tif projection.State != StateRunning {\n253|\t\tt.Fatalf(\"state = %q, want running\", projection.State)\n254|\t}\n255|\tif projection.Provider.ID != \"codex\" {\n256|\t\tt.Fatalf(\"provider = %q, want record-pinned codex\", projection.Provider.ID)\n257|\t}\n258|\tif projection.Provider.Version != \"\" {\n259|\t\tt.Fatalf(\"provider version = %q, want empty: a mismatching launch contributes no version\", projection.Provider.Version)\n260|\t}\n261|\tkinds := conflictKinds(projection)\n262|\tif len(kinds) != 1 || kinds[0] != ConflictProviderMismatch {\n263|\t\tt.Fatalf(\"conflicts = %v, want exactly [provider_mismatch]\", kinds)\n264|\t}\n265|\tif projection.Conflicts[0].Rule != ResolveRuleRecordPinnedProviderWins {\n266|\t\tt.Fatalf(\"rule = %q, want record-pinned-provider-wins\", projection.Conflicts[0].Rule)\n267|\t}\n268|}\n269|\n270|func assertConflictDetailContains(t *testing.T, projection Projection, kind, fragment string) {\n271|\tt.Helper()\n272|\tfor _, conflict := range projection.Conflicts {\n273|\t\tif conflict.Kind == kind {\n274|\t\t\tif !strings.Contains(conflict.Detail, fragment) {\n275|\t\t\t\tt.Fatalf(\"conflict %s detail = %q, want fragment %q\", kind, conflict.Detail, fragment)\n276|\t\t\t}\n277|\t\t\treturn\n278|\t\t}\n279|\t}\n280|\tt.Fatalf(\"no conflict of kind %s in %+v\", kind, projection.Conflicts)\n281|}\n282|\n283|func assertWarning(t *testing.T, projection Projection, warning string) {\n284|\tt.Helper()\n285|\tfor _, candidate := range projection.Warnings {\n286|\t\tif candidate == warning {\n287|\t\t\treturn\n288|\t\t}\n289|\t}\n290|\tt.Fatalf(\"warnings = %v, want %q\", projection.Warnings, warning)\n291|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
