tEpochGap'\n103|\n104|echo \"== R10: narrowing — losing union branch conflict dropped for epoch 1 rivals ==\"\n105|run_one R10 sessstate.go '\t\tcase -1:\n106|\t\t\tfold.conflict(ConflictLosingBranchPreserved' '\t\tcase -1:\n107|\t\t\tif lease.Epoch == 1 { break }\n108|\t\t\tfold.conflict(ConflictLosingBranchPreserved'\n109|#!/bin/bash\n110|set -u\n111|PKG=./internal/sessstate\n112|BK=.temp/TASK-260830-1r9wrr/review/bk\n113|PLANT=internal/sessstate/zz_plant.go\n114|restore() { cp \"$BK/sessstate.go\" internal/sessstate/sessstate.go; rm -f \"$PLANT\"; }\n115|run_plant() {\n116|  local ID=\"$1\" BODY=\"$2\" WIRE=\"${3:-no}\"\n117|  restore\n118|  printf '%s' \"$BODY\" > \"$PLANT\"\n119|  if [ \"$WIRE\" = \"yes\" ]; then\n120|    python3 - <<'PY'\n121|import io\n122|p='internal/sessstate/sessstate.go'\n123|s=open(p).read()\n124|old='''\tcase \"task_board.launched\":\n125|\t\treturn fold.effectTaskBoardLaunched(event, name)\n126|\tdefault:\n127|\t\treturn nil\n128|\t}'''\n129|new='''\tcase \"task_board.launched\":\n130|\t\treturn fold.effectTaskBoardLaunched(event, name)\n131|\tdefault:\n132|\t\treturn fold.effectExtra(event, name)\n133|\t}'''\n134|assert s.count(old)==1, s.count(old)\n135|open(p,'w').write(s.replace(old,new,1))\n136|PY\n137|  fi\n138|  if ! go build \"$PKG\" >/dev/null 2>&1; then echo \"$ID: COMPILE_FAIL\"; go build \"$PKG\" 2>&1|head -3; restore; return; fi\n139|  local BEH FULL\n140|  if go test \"$PKG\" -count=1 -run '.*' >\"/tmp/plant_beh_$ID.log\" 2>&1; then BEH=PASS; else BEH=FAIL; fi\n141|  if go test \"$PKG\" -count=1 >\"/tmp/plant_full_$ID.log\" 2>&1; then FULL=PASS; else FULL=FAIL; fi\n142|  if [ \"$BEH\" = \"FAIL\" ]; then echo \"$ID: KILLED(behavioral) beh=$BEH full=$FULL\"\n143|  elif [ \"$FULL\" = \"FAIL\" ]; then echo \"$ID: KILLED(audit/census-only) beh=$BEH full=$FULL\"\n144|  else echo \"$ID: SURVIVED beh=$BEH full=$FULL\"; fi\n145|  [ \"$BEH\" = \"FAIL\" ] && grep -E \"^\\s*--- FAIL\" \"/tmp/plant_beh_$ID.log\" | head -3\n146|  [ \"$BEH\" = \"PASS\" ] && [ \"$FULL\" = \"FAIL\" ] && grep -E \"sessstate |outside direct-call|zz_plant\" \"/tmp/plant_full_$ID.log\" | head -3\n147|  restore\n148|}\n149|\n150|echo \"== PA: fresh-spelling handler in a new production file, wired into effect's default ==\"\n151|echo \"     (unknown v1 type 'session.reaped' silently moves running -> idle; Section 5.2 says inert)\"\n152|run_plant PA 'package sessstate\n153|\n154|// effectExtra is a second event-handling site outside the censused\n155|// effect switch.\n156|func (fold *chainFold) effectExtra(event Event, what string) error {\n157|\tswitch event.Type {\n158|\tcase \"session.reaped\":\n159|\t\treturn fold.step(StateIdle, what)\n160|\t}\n161|\treturn nil\n162|}\n163|' yes\n164|\n165|echo \"== PB: same fresh-spelling handler, but raising a refusal through a var-bound funnel ==\"\n166|run_plant PB 'package sessstate\n167|\n168|var deny = refuse\n169|\n170|func (fold *chainFold) effectExtra(event Event, what string) error {\n171|\tswitch event.Type {\n172|\tcase \"session.reaped\":\n173|\t\treturn deny(ErrIntegrity, \"%s reaped\", what)\n174|\t}\n175|\treturn nil\n176|}\n177|' yes\n178|\n179|echo \"== PC: alias-bound var over a watched owner delegation, in a new production file ==\"\n180|run_plant PC 'package sessstate\n181|\n182|import \"github.com/relux-works/agent-session-manager/internal/scalar\"\n183|\n184|var parseDigest = scalar.ParseDigest\n185|\n186|func (fold *chainFold) effectExtra(event Event, what string) error {\n187|\tif event.Type == \"session.reaped\" {\n188|\t\tif _, err := parseDigest(event.ID); err != nil {\n189|\t\t\treturn nil\n190|\t\t}\n191|\t\treturn fold.step(StateIdle, what)\n192|\t}\n193|\treturn nil\n194|}\n195|' yes\n196|\n197|echo \"== PD: new State spelling declared in a new production file ==\"\n198|run_plant PD 'package sessstate\n199|\n200|// StateReaped is an unregistered spelling.\n201|const StateReaped State = \"reaped\"\n202|\n203|func (fold *chainFold) effectExtra(event Event, what string) error {\n204|\tif event.Type == \"session.reaped\" {\n205|\t\tfold.projection.State = StateReaped\n206|\t}\n207|\treturn nil\n208|}\n209|' yes\n210|\n211|echo \"== PE: direct refuse() call at a new production site (unregistered census row) ==\"\n212|run_plant PE 'package sessstate\n213|\n214|func (fold *chainFold) effectExtra(event Event, what string) error {\n215|\tif event.Type == \"session.reaped\" {\n216|\t\treturn refuse(ErrIntegrity, \"%s is reaped\", what)\n217|\t}\n218|\treturn nil\n219|}\n220|' yes","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
