    \"TestDecodeEventRefusesMemberVectors/session_id\",\n31|\t\t\"decode.go:97\":     \"TestDecodeEventRefusesMemberVectors/event_type\",\n32|\t\t\"decode.go:101\":    \"TestDecodeEventRefusesMemberVectors/lease_epoch\",\n33|\t\t\"decode.go:105\":    \"TestDecodeEventRefusesMemberVectors/lease_id_absent\",\n34|\t\t\"decode.go:108\":    \"TestDecodeEventRefusesMemberVectors/lease_id_grammar\",\n35|\t\t\"decode.go:112\":    \"TestDecodeEventRefusesMemberVectors/lease_sequence\",\n36|\t\t\"decode.go:116\":    \"TestDecodeEventRefusesMemberVectors/created_by_host_id\",\n37|\t\t\"decode.go:120\":    \"TestDecodeEventRefusesMemberVectors/predecessors_malformed\",\n38|\t\t\"decode.go:123\":    \"TestDecodeEventRefusesMemberVectors/predecessors_empty\",\n39|\t\t\"decode.go:127\":    \"TestDecodeEventRefusesMemberVectors/event_id_absent\",\n40|\t\t\"decode.go:130\":    \"TestDecodeEventRefusesMemberVectors/event_id_grammar\",\n41|\t\t\"decode.go:212\":    \"TestReduceRefusesDerivationVectors/string_absent\",\n42|\t\t\"decode.go:216\":    \"TestReduceRefusesDerivationVectors/string_not_string\",\n43|\t\t\"decode.go:225\":    \"TestReduceRefusesDerivationVectors/bool_absent\",\n44|\t\t\"decode.go:229\":    \"TestReduceRefusesDerivationVectors/bool_not_bool\",\n45|\t\t\"decode.go:240\":    \"TestReduceRefusesDerivationVectors/uint_absent\",\n46|\t\t\"decode.go:244\":    \"TestReduceRefusesDerivationVectors/uint_not_uint\",\n47|\t\t\"decode.go:255\":    \"TestReduceRefusesDerivationVectors/nullable_absent\",\n48|\t\t\"decode.go:262\":    \"TestReduceRefusesDerivationVectors/nullable_not_string\",\n49|\t\t\"decode.go:265\":    \"TestReduceRefusesDerivationVectors/nullable_malformed\",\n50|\t\t\"project.go:38\":    \"TestProjectRefusesWithoutRepository\",\n51|\t\t\"project.go:52\":    \"TestProjectRefusesUnknownSession\",\n52|\t\t\"sessstate.go:321\": \"TestReduceRefusesContinuityVectors/empty_record_identity\",\n53|\t\t\"sessstate.go:371\": \"TestReduceRefusesContinuityVectors/un