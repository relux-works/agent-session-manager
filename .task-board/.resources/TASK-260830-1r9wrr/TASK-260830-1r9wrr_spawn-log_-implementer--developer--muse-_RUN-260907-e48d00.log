{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3cf","stream":{"kind":"session","id":"01a07db8-a28a-7e80-8be1-e3a988123386"},"sequence":66,"recorded_at":1780531400000127,"record_type":"event","durability":"durable","causation_id":"4385e4d6-e071-42f2-a438-a44213370546","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4385e4d6-e071-42f2-a438-a44213370546","run_stream":{"kind":"run","id":"4385e4d6-e071-42f2-a438-a44213370546"},"task_stream":{"kind":"task","id":"ec010e97-b51f-4983-8ce8-55aeba10fb0e"},"task_id":"ec010e97-b51f-4983-8ce8-55aeba10fb0e","event":{"kind":"output","task_id":"ec010e97-b51f-4983-8ce8-55aeba10fb0e","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.task-board/.resources/TASK-260830-1r9wrr/TASK-260830-1r9wrr_review-rev1-harness.sh`.\n1|#!/bin/bash\n2|# Reviewer mutation harness. Same two-gate shape as the producer's, plus a\n3|# real negative control: BEH = go test -run '.*', FULL = go test.\n4|set -u\n5|PKG=./internal/sessstate\n6|BK=.temp/TASK-260830-1r9wrr/review/bk\n7|run_one() {\n8|  local ID=\"$1\" FILE=\"$2\" OLD=\"$3\" NEW=\"$4\"\n9|  local F=\"internal/sessstate/$FILE\"\n10|  cp \"$BK/$FILE\" \"$F\"\n11|  local COUNT\n12|  COUNT=$(python3 -c \"import sys; s=open('$F').read(); sys.stdout.write(str(s.count(sys.argv[1])))\" \"$OLD\")\n13|  if [ \"$COUNT\" != \"1\" ]; then echo \"$ID: NOT_APPLIED (pattern count=$COUNT)\"; cp \"$BK/$FILE\" \"$F\"; return; fi\n14|  python3 -c \"import sys; p='$F'; s=open(p).read(); s=s.replace(sys.argv[1], sys.argv[2], 1); open(p,'w').write(s)\" \"$OLD\" \"$NEW\"\n15|  if ! go build \"$PKG\" >/dev/null 2>&1; then echo \"$ID: COMPILE_FAIL\"; cp \"$BK/$FILE\" \"$F\"; return; fi\n16|  local BEH FULL\n17|  if go test \"$PKG\" -count=1 -run '.*' >\"/tmp/rev_beh_$ID.log\" 2>&1; then BEH=PASS; else BEH=FAIL; fi\n18|  if go test \"$PKG\" -count=1 >\"/tmp/rev_full_$ID.log\" 2>&1; then FULL=PASS; else FULL=FAIL; fi\n19|  local K\n20|  if [ \"$BEH\" = \"FAIL\" ]; then K=\"KILLED(behavioral)\"\n21|  elif [ \"$FULL\" = \"FAIL\" ]; then K=\"KILLED(audit/census-only)\"\n22|  else K=\"SURVIVED\"; fi\n23|  echo \"$ID: $K  behavioral=$BEH full=$FULL\"\n24|  [ \"$BEH\" = \"FAIL\" ] && grep -E \"^\\s*--- FAIL\" \"/tmp/rev_beh_$ID.log\" | head -4\n25|  [ \"$BEH\" = \"PASS\" ] && [ \"$FULL\" = \"FAIL\" ] && grep -E \"sessstate |outside direct-call|outside the refuse funnel\" \"/tmp/rev_full_$ID.log\" | head -4\n26|  cp \"$BK/$FILE\" \"$F\"\n27|}\n28|echo \"== baseline ==\"\n29|go test \"$PKG\" -count=1 >/dev/null 2>&1 && echo \"baseline green\" || { echo \"BASELINE RED\"; exit 1; }\n30|\n31|echo \"== R0: NEGATIVE CONTROL (behaviour-neutral, line-count preserving) — must SURVIVE ==\"\n32|run_one R0 sessstate.go 'func (fold *chainFold) tailEventID() string { return fold.tailID }' 'func (fold *chainFold) tailEventID() string { return \"\" + fold.tailID }'\n33|\n34|echo \"== R0b: POSITIVE CONTROL (known-bad, compiles) — must be KILLED behaviorally ==\"\n35|run_one R0b project.go '\tif found.Parked {' '\tif found == nil || found.Parked {'\n36|\n37|echo \"== R1: candidate FIX for the local-lease comparison (does the suite notice?) ==\"\n38|run_one R1 sessstate.go '\tif Compare(local, fold.projection.Winner) == 0 {\n39|\t\treturn\n40|\t}' '\tif Compare(local, fold.projection.Winner) >= 0 {\n41|\t\treturn\n42|\t}'\n43|\n44|echo \"== R2: candidate FIX for the duplicate-union case-0 branch (does the suite notice?) ==\"\n45|run_one R2 sessstate.go '\t\tcase 0:\n46|\t\t\tif _, ok := onChain[lease.LeaseID]; !ok {\n47|\t\t\t\toffChainWinner = false\n48|\t\t\t}' '\t\tcase 0:\n49|\t\t\t_ = onChain'\n50|\n51|echo \"== R3: narrowing — staleSources admits stopped ==\"\n52|run_one R3 sessstate.go '\tStateRunning: {}, StateIdle: {}, StateQuiescing: {},\n53|\tStateFailed: {}, StateParked: {},' '\tStateRunning: {}, StateIdle: {}, StateQuiescing: {},\n54|\tStateFailed: {}, StateParked: {}, StateStopped: {},'\n55|\n56|echo \"== R4: narrowing — transition table admits running->stopped ==\"\n57|run_one R4 sessstate.go '\tStateRunning: {\n58|\t\tStateIdle: {}, StateQuiescing: {}, StateFailed: {}, StateStale: {},\n59|\t},' '\tStateRunning: {\n60|\t\tStateIdle: {}, StateQuiescing: {}, StateFailed: {}, StateStale: {}, StateStopped: {},\n61|\t},'\n62|\n63|echo \"== R5: narrowing — newest checkpoint keeps the OLDEST instead ==\"\n64|run_one R5 sessstate.go '\tfold.seenCheckpoint = true\n65|\tfold.projection.HasCheckpoint = true\n66|\tfold.projection.Newest = Checkpoint{ID: id, Kind: kind, EventID: eventID}' '\tif fold.seenCheckpoint {\n67|\t\treturn\n68|\t}\n69|\tfold.seenCheckpoint = true\n70|\tfold.projection.HasCheckpoint = true\n71|\tfold.projection.Newest = Checkpoint{ID: id, Kind: kind, EventID: eventID}'\n72|\n73|echo \"== R6: narrowing — provider version recorded even on record mismatch ==\"\n74|run_one R6 sessstate.go '\t} else {\n75|\t\tfold.projection.Provider.Version = version\n76|\t}\n77|\treturn fold.step(StateRunning, what)' '\t}\n78|\tfold.projection.Provider.Version = version\n79|\treturn fold.step(StateRunning, what)'\n80|\n81|echo \"== R7: narrowing — local role inverted ==\"\n82|run_one R7 sessstate.go '\t\tif localHostID == fold.projection.OwnerHostID {\n83|\t\t\tfold.projection.LocalRole = \"owner\"\n84|\t\t} else {\n85|\t\t\tfold.projection.LocalRole = \"replica\"\n86|\t\t}' '\t\tif localHostID != fold.projection.OwnerHostID {\n87|\t\t\tfold.projection.LocalRole = \"owner\"\n88|\t\t} else {\n89|\t\t\tfold.projection.LocalRole = \"replica\"\n90|\t\t}'\n91|\n92|echo \"== R8: narrowing — stale_process warning dropped ==\"\n93|run_one R8 sessstate.go '\tif fold.state == StateStale {\n94|\t\twarnings[\"stale_process\"] = struct{}{}\n95|\t}' '\tif fold.state == StateStale && len(fold.leases) > 99 {\n96|\t\twarnings[\"stale_process\"] = struct{}{}\n97|\t}'\n98|\n99|echo \"== R9: narrowing — epoch-gap conflict only past a jump of 3 ==\"\n100|run_one R9 sessstate.go '\t\tif lease.Epoch > fold.current.Epoch+1 {\n101|\t\t\tfold.conflict(ConflictEpochGap' '\t\tif lease.Epoch > fold.current.Epoch+3 {\n102|\t\t\tfold.conflict(ConflictEpochGap'\n103|\n104|echo \"== R10: narrowing — losing union branch conflict dropped for epoch 1 rivals ==\"\n105|run_one R10 sessstate.go '\t\tcase -1:\n106|\t\t\tfold.conflict(ConflictLosingBranchPreserved' '\t\tcase -1:\n107|\t\t\tif lease.Epoch == 1 { break }\n108|\t\t\tfold.conflict(ConflictLosingBranchPreserved'\n109|#!/bin/bash\n110|set -u\n111|PKG=./internal/sessstate\n112|BK=.temp/TASK-260830-1r9wrr/review/bk\n113|PLANT=internal/sessstate/zz_plant.go\n114|restore() { cp \"$BK/sessstate.go\" internal/sessstate/sessstate.go; rm -f \"$PLANT\"; }\n115|run_plant() {\n116|  local ID=\"$1\" BODY=\"$2\" WIRE=\"${3:-no}\"\n117|  restore\n118|  printf '%s' \"$BODY\" > \"$PLANT\"\n119|  if [ \"$WIRE\" = \"yes\" ]; then\n120|    python3 - <<'PY'\n121|import io\n122|p='internal/sessstate/sessstate.go'\n123|s=open(p).read()\n124|old='''\tcase \"task_board.launched\":\n125|\t\treturn fold.effectTaskBoardLaunched(event, name)\n126|\tdefault:\n127|\t\treturn nil\n128|\t}'''\n129|new='''\tcase \"task_board.launched\":\n130|\t\treturn fold.effectTaskBoardLaunched(event, name)\n131|\tdefault:\n132|\t\treturn fold.effectExtra(event, name)\n133|\t}'''\n134|assert s.count(old)==1, s.count(old)\n135|open(p,'w').write(s.replace(old,new,1))\n136|PY\n137|  fi\n138|  if ! go build \"$PKG\" >/dev/null 2>&1; then echo \"$ID: COMPILE_FAIL\"; go build \"$PKG\" 2>&1|head -3; restore; return; fi\n139|  local BEH FULL\n140|  if go test \"$PKG\" -count=1 -run '.*' >\"/tmp/plant_beh_$ID.log\" 2>&1; then BEH=PASS; else BEH=FAIL; fi\n141|  if go test \"$PKG\" -count=1 >\"/tmp/plant_full_$ID.log\" 2>&1; then FULL=PASS; else FULL=FAIL; fi\n142|  if [ \"$BEH\" = \"FAIL\" ]; then echo \"$ID: KILLED(behavioral) beh=$BEH full=$FULL\"\n143|  elif [ \"$FULL\" = \"FAIL\" ]; then echo \"$ID: KILLED(audit/census-only) beh=$BEH full=$FULL\"\n144|  else echo \"$ID: SURVIVED beh=$BEH full=$FULL\"; fi\n145|  [ \"$BEH\" = \"FAIL\" ] && grep -E \"^\\s*--- FAIL\" \"/tmp/plant_beh_$ID.log\" | head -3\n146|  [ \"$BEH\" = \"PASS\" ] && [ \"$FULL\" = \"FAIL\" ] && grep -E \"sessstate |outside direct-call|zz_plant\" \"/tmp/plant_full_$ID.log\" | head -3\n147|  restore\n148|}\n149|\n150|echo \"== PA: fresh-spelling handler in a new production file, wired into effect's default ==\"\n151|echo \"     (unknown v1 type 'session.reaped' silently moves running -> idle; Section 5.2 says inert)\"\n152|run_plant PA 'package sessstate\n153|\n154|// effectExtra is a second event-handling site outside the censused\n155|// effect switch.\n156|func (fold *chainFold) effectExtra(event Event, what string) error {\n157|\tswitch event.Type {\n158|\tcase \"session.reaped\":\n159|\t\treturn fold.step(StateIdle, what)\n160|\t}\n161|\treturn nil\n162|}\n163|' yes\n164|\n165|echo \"== PB: same fresh-spelling handler, but raising a refusal through a var-bound funnel ==\"\n166|run_plant PB 'package sessstate\n167|\n168|var deny = refuse\n169|\n170|func (fold *chainFold) effectExtra(event Event, what string) error {\n171|\tswitch event.Type {\n172|\tcase \"session.reaped\":\n173|\t\treturn deny(ErrIntegrity, \"%s reaped\", what)\n174|\t}\n175|\treturn nil\n176|}\n177|' yes\n178|\n179|echo \"== PC: alias-bound var over a watched owner delegation, in a new production file ==\"\n180|run_plant PC 'package sessstate\n181|\n182|import \"github.com/relux-works/agent-session-manager/internal/scalar\"\n183|\n184|var parseDigest = scalar.ParseDigest\n185|\n186|func (fold *chainFold) effectExtra(event Event, what string) error {\n187|\tif event.Type == \"session.reaped\" {\n188|\t\tif _, err := parseDigest(event.ID); err != nil {\n189|\t\t\treturn nil\n190|\t\t}\n191|\t\treturn fold.step(StateIdle, what)\n192|\t}\n193|\treturn nil\n194|}\n195|' yes\n196|\n197|echo \"== PD: new State spelling declared in a new production file ==\"\n198|run_plant PD 'package sessstate\n199|\n200|// StateReaped is an unregistered spelling.\n201|const StateReaped State = \"reaped\"\n202|\n203|func (fold *chainFold) effectExtra(event Event, what string) error {\n204|\tif event.Type == \"session.reaped\" {\n205|\t\tfold.projection.State = StateReaped\n206|\t}\n207|\treturn nil\n208|}\n209|' yes\n210|\n211|echo \"== PE: direct refuse() call at a new production site (unregistered census row) ==\"\n212|run_plant PE 'package sessstate\n213|\n214|func (fold *chainFold) effectExtra(event Event, what string) error {\n215|\tif event.Type == \"session.reaped\" {\n216|\t\treturn refuse(ErrIntegrity, \"%s is reaped\", what)\n217|\t}\n218|\treturn nil\n219|}\n220|' yes"}}}
