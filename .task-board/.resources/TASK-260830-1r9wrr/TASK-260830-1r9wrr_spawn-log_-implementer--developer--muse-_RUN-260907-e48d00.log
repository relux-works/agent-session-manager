rce add TASK-260311-abc file:///tmp/report.pdf --name ui-report.pdf\\n  task-board resource add TASK-260311-abc ./report.md --name reports/review/report.md\\n  task-board resource add TASK-260311-abc https://example.com/spec.pdf --type outcome\\n\\nUsage:\\n  task-board resource add <ELEMENT-ID> <SOURCE> [flags]\\n\\nFlags:\\n  -d, --description string   Optional one-line description\\n  -h, --help                 help for add\\n      --name string          Override stored resource filename\\n      --type string          Resource type: precondition or outcome (default \\\"outcome\\\")\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n\",\n  \"original_output_bytes\": 1721,\n  \"original_output_tokens\": 431,\n  \"truncated\": false\n}"}}}
