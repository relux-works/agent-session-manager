{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4a9","stream":{"kind":"session","id":"01a07db8-a28a-7e80-8be1-e3a988123386"},"sequence":175,"recorded_at":1780531400000345,"record_type":"event","durability":"durable","causation_id":"4385e4d6-e071-42f2-a438-a44213370546","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4385e4d6-e071-42f2-a438-a44213370546","run_stream":{"kind":"run","id":"4385e4d6-e071-42f2-a438-a44213370546"},"task_stream":{"kind":"task","id":"9910bca4-bd31-4401-9e75-5f9148afc18d"},"task_id":"9910bca4-bd31-4401-9e75-5f9148afc18d","event":{"kind":"output","task_id":"9910bca4-bd31-4401-9e75-5f9148afc18d","chunk":"Read text file `internal/sessstate/sessstate.go`.\n(499 line(s) above)\n500|}\n501|\n502|// tailID and tailSeq live beside the fold; declared here to keep the\n503|// struct literal above readable.\n504|func (fold *chainFold) conflict(kind, rule, format string, arguments ...any) {\n505|\tfold.projection.Conflicts = append(fold.projection.Conflicts, Conflict{\n506|\t\tKind:   kind,\n507|\t\tRule:   rule,\n508|\t\tDetail: fmt.Sprintf(format, arguments...),\n509|\t})\n510|}\n511|\n512|// step moves the derivation through the Section 5.7 table. An empty\n513|// target keeps the state (a fact or inert event performs no\n514|// transition); an equal target restates it (a confirming event while\n515|// already there is not a transition); the first event may only open a\n516|// bootstrap state; every other move needs its table edge, else\n517|// invalid_state_transition.\n518|func (fold *chainFold) step(target State, what string) error {\n519|\tif target == \"\" || target == fold.state {\n520|\t\treturn nil\n521|\t}\n522|\tif fold.state == \"\" {\n523|\t\tif _, ok := initialTargets[target]; !ok {\n524|\t\t\treturn refuse(ErrInvalidTransition, \"%s opens unbootstrapped state %q\", what, string(target))\n525|\t\t}\n526|\t\tfold.state = target\n527|\t\treturn nil\n528|\t}\n529|\tif _, ok := allowedTransitions[fold.state][target]; !ok {\n530|\t\treturn refuse(ErrInvalidTransition, \"%s moves %q to %q without a Section 5.7 edge\", what, string(fold.state), string(target))\n531|\t}\n532|\tfold.state = target\n533|\treturn nil\n534|}\n535|\n536|// effect applies one event's lifecycle meaning after continuity and\n537|// lease tracking. Fact events return an empty target and keep the\n538|// state; unknown v1 types and the v2/v3/v4 non-lifecycle types are\n539|// inert by Section 5.2 (retained, never applied).\n540|func (fold *chainFold) effect(event Event, lease LeaseHead, succession bool) error {\n541|\tname := \"event \" + event.Type + \" \" + event.ID\n542|\tswitch event.Type {\n543|\tcase \"session.created\":\n544|\t\treturn fold.effectCreated(event, name)\n545|\tcase \"terminal.created\":\n546|\t\treturn fold.effectTerminalCreated(event, name)\n547|\tcase \"provider.launched\":\n548|\t\treturn fold.effectProviderLaunched(event, name)\n549|\tcase \"provider.identified\":\n550|\t\treturn fold.effectProviderIdentified(event, name)\n551|\tcase \"session.idle\":\n552|\t\treturn fold.step(StateIdle, name)\n553|\tcase \"session.quiescing\":\n554|\t\treturn fold.step(StateQuiescing, name)\n555|\tcase \"checkpoint.created\":\n556|\t\treturn fold.effectCheckpointCreated(event, name)\n557|\tcase \"sync.completed\":\n558|\t\treturn nil\n559|\tcase \"session.stopped\":\n560|\t\treturn fold.effectStopped(event, name)\n561|\tcase \"session.resumed\":\n562|\t\treturn fold.effectResumed(event, name)\n563|\tcase \"session.bootstrap_aborted\":\n564|\t\treturn fold.effectBootstrapAborted(event, name)\n565|\tcase \"lease.transferred\", \"lease.forced\":\n566|\t\treturn fold.effectLease(event, lease, name, succession)\n567|\tcase \"session.parked\":\n568|\t\treturn fold.step(StateParked, name)\n569|\tcase \"session.failed\":\n570|\t\treturn fold.step(StateFailed, name)\n571|\tcase \"fork.created\", \"profile.changed\", \"takeover.force_confirmed\",\n572|\t\t\"replica.replace_confirmed\", \"task_board.adopted\",\n573|\t\t\"tombstone.issued\", \"tombstone.resolved\":\n574|\t\treturn nil\n575|\tcase \"session.tombstoned\":\n576|\t\treturn fold.step(StateTombstoned, name)\n577|\tcase \"task_board.launched\":\n578|\t\treturn fold.effectTaskBoardLaunched(event, name)\n579|\tdefault:\n580|\t\treturn nil\n581|\t}\n582|}\n583|\n584|// effectCreated opens the bootstrap, including the Section 5.7\n585|// failed-to-creating retry: epoch 1 under the same winning create\n586|// lease, no validated checkpoint yet, and no authoritative bootstrap\n587|// abort on record. Anything else that reaches for creating refuses.\n588|func (fold *chainFold) effectCreated(event Event, what string) error {\n589|\tif fold.state == \"\" {\n590|\t\treturn fold.step(StateCreating, what)\n591|\t}\n592|\tif fold.state != StateFailed {\n593|\t\treturn fold.step(StateCreating, what)\n594|\t}\n595|\tif event.LeaseEpoch != 1 || event.LeaseID != fold.createLease.LeaseID ||\n596|\t\tevent.LeaseEpoch != fold.createLease.Epoch {\n597|\t\treturn refuse(ErrInvalidTransition, \"%s retries bootstrap under a new lease\", what)\n598|\t}\n599|\tif fold.seenCheckpoint {\n600|\t\treturn refuse(ErrInvalidTransition, \"%s retries bootstrap past a validated checkpoint\", what)\n601|\t}\n602|\tif fold.seenAbort {\n603|\t\treturn refuse(ErrInvalidTransition, \"%s retries bootstrap past an authoritative abort\", what)\n604|\t}\n605|\treturn fold.step(StateCreating, what)\n606|}\n607|\n608|// effectTerminalCreated records the terminal binding; as the first\n609|// event it also opens the bootstrap in creating.\n610|func (fold *chainFold) effectTerminalCreated(event Event, what string) error {\n611|\tif event.SchemaVersion == \"4.0.0\" {\n612|\t\tbinding, err := payloadString(event.Payload, \"terminal_binding_id\")\n613|\t\tif err != nil {\n614|\t\t\treturn err\n615|\t\t}\n616|\t\tif _, err := scalar.ParseDigest(binding); err != nil {\n617|\t\t\treturn refuse(ErrDerivation, \"%s carries malformed terminal_binding_id: %v\", what, err)\n618|\t\t}\n619|\t\tbackend, err := payloadString(event.Payload, \"terminal_backend_id\")\n620|\t\tif err != nil {\n621|\t\t\treturn err\n622|\t\t}\n623|\t\tif _, err := terminalbackend.ParseID(backend); err != nil {\n624|\t\t\treturn refuse(ErrDerivation, \"%s carries refused terminal backend: %v\", what, err)\n625|\t\t}\n626|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, BindingID: binding, EventID: event.ID}\n627|\t} else {\n628|\t\tbackend, err := payloadString(event.Payload, \"backend\")\n629|\t\tif err != nil {\n630|\t\t\treturn err\n631|\t\t}\n632|\t\tif backend != \"tmux\" && backend != \"conpty\" {\n633|\t\t\treturn refuse(ErrDerivation, \"%s carries unknown terminal backend %q\", what, backend)\n634|\t\t}\n635|\t\tterminalID, err := payloadString(event.Payload, \"terminal_id\")\n636|\t\tif err != nil {\n637|\t\t\treturn err\n638|\t\t}\n639|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, TerminalID: terminalID, EventID: event.ID}\n640|\t}\n641|\tfold.projection.HasTerminal = true\n642|\tif fold.state == \"\" {\n643|\t\treturn fold.step(StateCreating, what)\n644|\t}\n645|\treturn nil\n646|}\n647|\n648|// effectProviderLaunched moves to running and records the launched\n649|// version. The record provider stays authoritative: a launched event\n650|// naming another provider records a provider_mismatch conflict under\n651|// the record-pinned-provider-wins rule instead of rewriting identity.\n652|func (fold *chainFold) effectProviderLaunched(event Event, what string) error {\n653|\tproviderID, err := payloadString(event.Payload, \"provider_id\")\n654|\tif err != nil {\n655|\t\treturn err\n656|\t}\n657|\tversion, err := payloadString(event.Payload, \"provider_version\")\n658|\tif err != nil {\n659|\t\treturn err\n660|\t}\n661|\tif providerID != fold.recordProvider {\n662|\t\tfold.conflict(ConflictProviderMismatch, ResolveRuleRecordPinnedProviderWins,\n663|\t\t\t\"event %s launches provider %q under record provider %q; the record value stays authoritative\",\n664|\t\t\tevent.ID, providerID, fold.recordProvider)\n665|\t} else {\n666|\t\tfold.projection.Provider.Version = version\n667|\t}\n668|\treturn fold.step(StateRunning, what)\n669|}\n670|\n671|// effectProviderIdentified records the newest identity record with\n672|// its confidence.\n673|func (fold *chainFold) effectProviderIdentified(event Event, what string) error {\n674|\trecordID, err := payloadString(event.Payload, \"provider_identity_record_id\")\n675|\tif err != nil {\n676|\t\treturn err\n677|\t}\n678|\tif _, err := scalar.ParseDigest(recordID); err != nil {\n679|\t\treturn refuse(ErrDerivation, \"%s carries malformed provider_identity_record_id: %v\", what, err)\n680|\t}\n681|\tconfidence, err := payloadString(event.Payload, \"confidence\")\n682|\tif err != nil {\n683|\t\treturn err\n684|\t}\n685|\tfold.projection.Provider.IdentityRecordID = recordID\n686|\tfold.projection.Provider.Confidence = confidence\n687|\treturn nil\n688|}\n689|\n690|// effectCheckpointCreated records the newest validated checkpoint and\n691|// moves idle or quiescing into checkpointing, or checkpointing back to\n692|// idle at the validated boundary. Any other lifecycle position refuses:\n693|// a checkpoint cannot land while running, creating, stopped, parked,\n694|// failed, stale, materializing, or tombstoned without the quiesce or\n695|// resume the table requires.\n696|func (fold *chainFold) effectCheckpointCreated(event Event, what string) error {\n697|\tcheckpointID, err := payloadString(event.Payload, \"checkpoint_id\")\n698|\tif err != nil {\n699|\t\treturn err\n700|\t}\n701|\tif _, err := scalar.ParseDigest(checkpointID); err != nil {\n702|\t\treturn refuse(ErrDerivation, \"%s carries malformed checkpoint_id: %v\", what, err)\n703|\t}\n704|\tkind, err := payloadString(event.Payload, \"kind\")\n705|\tif err != nil {\n706|\t\treturn err\n707|\t}\n708|\tfold.noteCheckpoint(checkpointID, kind, event.ID)\n709|\tswitch fold.state {\n710|\tcase \"\", StateIdle, StateQuiescing:\n711|\t\tif fold.state == \"\" {\n712|\t\t\treturn refuse(ErrInvalidTransition, \"%s publishes a checkpoint before any bootstrap\", what)\n713|\t\t}\n714|\t\treturn fold.step(StateCheckpointing, what)\n715|\tcase StateCheckpointing:\n716|\t\treturn fold.step(StateIdle, what)\n717|\tdefault:\n718|\t\treturn fold.step(StateCheckpointing, what)\n719|\t}\n720|}\n721|\n722|// effectStopped derives stopped for a checkpointed closure and failed\n723|// for a bootstrap abort. No event may derive stopped while the newest\n724|// checkpoint is null: the event's own checkpoint counts, so a\n725|// checkpointed stop carries its resumable base with it. A bootstrap\n726|// abort requires the null checkpoint, false resumable and graceful\n727|// values the canonical owner admitted, plus a preceding authoritative\n728|// abort event; an ambiguous live process stays failed with recovery\n729|// diagnostics instead.\n730|func (fold *chainFold) effectStopped(event Event, what string) error {\n731|\tcheckpointID, hasCheckpoint, err := payloadNullableDigest(event.Payload, \"checkpoint_id\")\n732|\tif err != nil {\n733|\t\treturn err\n734|\t}\n735|\tresumable, err := payloadBool(event.Payload, \"resumable\")\n736|\tif err != nil {\n737|\t\treturn err\n738|\t}\n739|\tclosure, err := payloadString(event.Payload, \"closure_kind\")\n740|\tif err != nil {\n741|\t\treturn err\n742|\t}\n743|\tif closure == \"checkpointed\" {\n744|\t\tif !hasCheckpoint || !resumable {\n745|\t\t\treturn refuse(ErrIntegrity, \"%s closes checkpointed without a resumable checkpoint\", what)\n746|\t\t}\n747|\t\tfold.noteCheckpoint(checkpointID, \"\", event.ID)\n748|\t\treturn fold.step(StateStopped, what)\n749|\t}\n750|\tif hasCheckpoint || resumable {\n751|\t\treturn refuse(ErrIntegrity, \"%s closes bootstrap_abort with a checkpoint or resumable set\", what)\n752|\t}\n753|\tif !fold.seenAbort {\n754|\t\treturn refuse(ErrInvalidTransition, \"%s closes bootstrap_abort with no authoritative abort event\", what)\n755|\t}\n756|\treturn fold.step(StateFailed, what)\n757|}\n758|\n759|// effectResumed moves to running under the resumed checkpoint and\n760|// records the terminal binding the resume selected.\n761|func (fold *chainFold) effectResumed(event Event, what string) error {\n762|\tcheckpointID, err := payloadString(event.Payload, \"checkpoint_id\")\n763|\tif err != nil {\n764|\t\treturn err\n765|\t}\n766|\tif _, err := scalar.ParseDigest(checkpointID); err != nil {\n767|\t\treturn refuse(ErrDerivation, \"%s carries malformed checkpoint_id: %v\", what, err)\n768|\t}\n769|\tfold.noteCheckpoint(checkpointID, \"\", event.ID)\n770|\tif event.SchemaVersion == \"4.0.0\" {\n771|\t\tbinding, err := payloadString(event.Payload, \"terminal_binding_id\")\n772|\t\tif err != nil {\n773|\t\t\treturn err\n774|\t\t}\n775|\t\tif _, err := scalar.ParseDigest(binding); err != nil {\n776|\t\t\treturn refuse(ErrDerivation, \"%s carries malformed terminal_binding_id: %v\", what, err)\n777|\t\t}\n778|\t\tbackend, err := payloadString(event.Payload, \"terminal_backend_id\")\n779|\t\tif err != nil {\n780|\t\t\treturn err\n781|\t\t}\n782|\t\tif _, err := terminalbackend.ParseID(backend); err != nil {\n783|\t\t\treturn refuse(ErrDerivation, \"%s carries refused terminal backend: %v\", what, err)\n784|\t\t}\n785|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, BindingID: binding, EventID: event.ID}\n786|\t} else {\n787|\t\tbackend, err := payloadString(event.Payload, \"terminal_backend\")\n788|\t\tif err != nil {\n789|\t\t\treturn err\n790|\t\t}\n791|\t\tif backend != \"tmux\" && backend != \"conpty\" {\n792|\t\t\treturn refuse(ErrDerivation, \"%s carries unknown terminal backend %q\", what, backend)\n793|\t\t}\n794|\t\tnativeID, err := payloadString(event.Payload, \"native_session_id\")\n795|\t\tif err != nil {\n796|\t\t\treturn err\n797|\t\t}\n798|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, NativeSessionID: nativeID, EventID: event.ID}\n799|\t}\n800|\tfold.projection.HasTerminal = true\n801|\treturn fold.step(StateRunning, what)\n802|}\n803|\n804|// effectBootstrapAborted records the authoritative abort and fails the\n805|// bootstrap. Only the creating session can abort its bootstrap; any\n806|// later abort is invalid_state_transition.\n807|func (fold *chainFold) effectBootstrapAborted(event Event, what string) error {\n808|\tfold.seenAbort = true\n809|\tif fold.state != \"\" && fold.state != StateCreating {\n810|\t\treturn refuse(ErrInvalidTransition, \"%s aborts a bootstrap past creating\", what)\n811|\t}\n812|\treturn fold.step(StateFailed, what)\n813|}\n814|\n815|// effectLease checks the successor-lease payload linkage: the payload\n816|// must name the predecessor the chain stands on and the envelope it\n817|// arrives under, else integrity_failure. The lifecycle move already\n818|// happened in successionMove; a lease event repeating the current\n819|// lease is a fact, not a transition.\n820|func (fold *chainFold) effectLease(event Event, lease LeaseHead, what string, succession bool) error {\n821|\tif !succession {\n822|\t\treturn nil\n823|\t}\n824|\tif event.Type == \"lease.transferred\" {\n825|\t\tpredecessor, err := payloadString(event.Payload, \"predecessor_lease_id\")\n826|\t\tif err != nil {\n827|\t\t\treturn err\n828|\t\t}\n829|\t\tif predecessor != fold.previous.LeaseID {\n830|\t\t\treturn refuse(ErrIntegrity, \"%s transfers from lease %s past chain head lease %s\", what, predecessor, fold.previous.LeaseID)\n831|\t\t}\n832|\t\tsuccessor, err := payloadString(event.Payload, \"new_lease_id\")\n833|\t\tif err != nil {\n834|\t\t\treturn err\n835|\t\t}\n836|\t\tif successor != lease.LeaseID {\n837|\t\t\treturn refuse(ErrIntegrity, \"%s transfers to lease %s outside its envelope lease %s\", what, successor, lease.LeaseID)\n838|\t\t}\n839|\t} else {\n840|\t\tsuccessor, err := payloadString(event.Payload, \"new_lease_id\")\n841|\t\tif err != nil {\n842|\t\t\treturn err\n843|\t\t}\n844|\t\tif successor != lease.LeaseID {\n845|\t\t\treturn refuse(ErrIntegrity, \"%s forces lease %s outside its envelope lease %s\", what, successor, lease.LeaseID)\n846|\t\t}\n847|\t}\n848|\treturn nil\n849|}\n850|\n851|// effectTaskBoardLaunched enforces the Section 5.2 repeat rule — the\n852|// event must repeat the winning creation lease and the Session\n853|// Record's provider and launch mode — then derives the payload's\n854|// running or idle state through the table.\n855|func (fold *chainFold) effectTaskBoardLaunched(event Event, what string) error {\n856|\tproviderID, err := payloadString(event.Payload, \"provider_id\")\n857|\tif err != nil {\n858|\t\treturn err\n859|\t}\n860|\tif providerID != fold.recordProvider {\n861|\t\treturn refuse(ErrIntegrity, \"%s repeats provider %q past record provider %q\", what, providerID, fold.recordProvider)\n862|\t}\n863|\tpayloadEpoch, err := payloadUint(event.Payload, \"lease_epoch\")\n864|\tif err != nil {\n865|\t\treturn err\n866|\t}\n867|\tpayloadLease, err := payloadString(event.Payload, \"lease_id\")\n868|\tif err != nil {\n869|\t\treturn err\n870|\t}\n871|\tif payloadEpoch != fold.createLease.Epoch || payloadLease != fold.createLease.LeaseID {\n872|\t\treturn refuse(ErrIntegrity, \"%s repeats creation lease (%d, %s) past create lease (%d, %s)\", what, payloadEpoch, payloadLease, fold.createLease.Epoch, fold.createLease.LeaseID)\n873|\t}\n874|\treported, err := payloadString(event.Payload, \"state\")\n875|\tif err != nil {\n876|\t\treturn err\n877|\t}\n878|\tif reported == string(StateRunning) {\n879|\t\treturn fold.step(StateRunning, what)\n880|\t}\n881|\treturn fold.step(StateIdle, what)\n882|}\n883|\n884|// noteCheckpoint records the newest validated checkpoint.\n885|func (fold *chainFold) noteCheckpoint(id, kind, eventID string) {\n886|\tfold.seenCheckpoint = true\n887|\tfold.projection.HasCheckpoint = true\n888|\tfold.projection.Newest = Checkpoint{ID: id, Kind: kind, EventID: eventID}\n889|}\n890|\n891|// resolveWinner selects the winning lease over the authoritative chain\n892|// leases and the union leases by the greatest (epoch, lease_id)\n893|// tuple. A same-epoch tie resolves to the bytewise-greater lease ID;\n894|// an off-chain union winner moves the reported winner but never\n895|// rewrites authoritative state; union leases that lose are reported\n896|// preserved-never-applied. With no union the chain head wins alone\n897|// and no conflict is recorded.\n898|func (fold *chainFold) resolveWinner(union []LeaseHead) error {\n899|\twinner := fold.current\n900|\tonChain := map[string]struct{}{}\n901|\tif fold.haveLease {\n902|\t\tonChain[fold.current.LeaseID] = struct{}{}\n903|\t}\n904|\tfor _, lease := range fold.chainLeases() {\n905|\t\tonChain[lease.LeaseID] = struct{}{}\n906|\t}\n907|\tbyEpoch := map[uint64]map[string]struct{}{}\n908|\tnote := func(lease LeaseHead) {\n909|\t\tif byEpoch[lease.Epoch] == nil {\n910|\t\t\tbyEpoch[lease.Epoch] = map[string]struct{}{}\n911|\t\t}\n912|\t\tbyEpoch[lease.Epoch][lease.LeaseID] = struct{}{}\n913|\t}\n914|\tfor _, lease := range fold.chainLeases() {\n915|\t\tnote(lease)\n916|\t}\n917|\toffChainWinner := false\n918|\tfor _, lease := range union {\n919|\t\tif lease.IsZero() {\n920|\t\t\treturn refuse(ErrInvalidEvent, \"union carries an empty lease head\")\n921|\t\t}\n922|\t\tif _, err := scalar.ParseUUIDv4(lease.LeaseID); err != nil {\n923|\t\t\treturn refuse(ErrInvalidEvent, \"union lease %q is not a UUIDv4: %v\", lease.LeaseID, err)\n924|\t\t}\n925|\t\tnote(lease)\n926|\t\tswitch Compare(lease, winner) {\n927|\t\tcase 1:\n928|\t\t\twinner = lease\n929|\t\t\tif _, ok := onChain[lease.LeaseID]; !ok {\n930|\t\t\t\toffChainWinner = true\n931|\t\t\t}\n932|\t\tcase -1:\n933|\t\t\tfold.conflict(ConflictLosingBranchPreserved, ResolveRulePreservedNeverApplied,\n934|\t\t\t\t\"union lease (%d, %s) loses to (%d, %s); its history stays preserved and never applies\",\n935|\t\t\t\tlease.Epoch, lease.LeaseID, winner.Epoch, winner.LeaseID)\n936|\t\tcase 0:\n937|\t\t\tif _, ok := onChain[lease.LeaseID]; !ok {\n938|\t\t\t\toffChainWinner = false\n939|\t\t\t}\n940|\t\t}\n941|\t}\n942|\tepochs := make([]uint64, 0, len(byEpoch))\n943|\tfor epoch := range byEpoch {\n944|\t\tepochs = append(epochs, epoch)\n945|\t}\n946|\tsort.Slice(epochs, func(i, j int) bool { return epochs[i] < epochs[j] })\n947|\tfor _, epoch := range epochs {\n948|\t\trivals := byEpoch[epoch]\n949|\t\tif len(rivals) < 2 {\n950|\t\t\tcontinue\n951|\t\t}\n952|\t\tordered := make([]string, 0, len(rivals))\n953|\t\tfor id := range rivals {\n954|\t\t\tordered = append(ordered, id)\n955|\t\t}\n956|\t\tsort.Strings(ordered)\n957|\t\tfold.conflict(ConflictSameEpochTie, ResolveRuleGreatestLeaseIDWins,\n958|\t\t\t\"epoch %d is shared by leases %v; the bytewise-greater lease ID %s wins\",\n959|\t\t\tepoch, ordered, ordered[len(ordered)-1])\n960|\t}\n961|\tif offChainWinner {\n962|\t\tfold.conflict(ConflictUnionSupersedesChain, ResolveRuleAuthoritativeStateUnchanged,\n963|\t\t\t\"union winner (%d, %s) stands outside the authoritative chain; derived state is unchanged until an explicit takeover lands\",\n964|\t\t\twinner.Epoch, winner.LeaseID)\n965|\t}\n966|\tfold.projection.Winner = winner\n967|\treturn nil\n968|}\n969|\n970|// chainLeases replays the distinct envelope leases in first-appearance\n971|// order. Every succession appends, so a tie planted at any past epoch\n972|// still resolves against the lease the chain actually stood on. Gaps\n973|// were already recorded at succession time.\n974|func (fold *chainFold) chainLeases() []LeaseHead {\n975|\treturn append([]LeaseHead(nil), fold.leases...)\n976|}\n977|\n978|// applyLocalLease derives the local projection: the owner host of the\n979|// newest authoritative event decides the local role against the\n980|// caller-supplied host, and a local lease that lost the tuple rule\n981|// stales the projection exactly where the table lets it go stale.\n982|func (fold *chainFold) applyLocalLease(local LeaseHead, localHostID string) {\n983|\tif localHostID != \"\" && fold.projection.OwnerHostID != \"\" {\n984|\t\tif localHostID == fold.projection.OwnerHostID {\n985|\t\t\tfold.projection.LocalRole = \"owner\"\n986|\t\t} else {\n987|\t\t\tfold.projection.LocalRole = \"replica\"\n988|\t\t}\n989|\t}\n990|\tif local.IsZero() || !fold.haveLease {\n991|\t\treturn\n992|\t}\n993|\tif Compare(local, fold.projection.Winner) == 0 {\n994|\t\treturn\n995|\t}\n996|\tif _, ok := staleSources[fold.state]; !ok {\n997|\t\treturn\n998|\t}\n999|\tfold.state = StateStale\n1000|\tfold.projection.State = StateStale\n1001|}\n1002|\n1003|// emitWarnings publishes the sorted unique warnings this leaf derives:\n1004|// divergent history behind any lease or provider conflict, a stale\n1005|// local process, and the parked blocking reason. Capability,\n1006|// authentication, and sync-age warnings belong to other leaves.\n1007|func (fold *chainFold) emitWarnings() {\n1008|\tfold.projection.State = fold.state\n1009|\twarnings := map[string]struct{}{}\n1010|\tfor _, conflict := range fold.projection.Conflicts {\n1011|\t\tswitch conflict.Kind {\n1012|\t\tcase ConflictSameEpochTie, ConflictEpochGap, ConflictLosingBranchPreserved,\n1013|\t\t\tConflictUnionSupersedesChain, ConflictProviderMismatch:\n1014|\t\t\twarnings[\"divergent_history\"] = struct{}{}\n1015|\t\t}\n1016|\t}\n1017|\tif fold.state == StateStale {\n1018|\t\twarnings[\"stale_process\"] = struct{}{}\n1019|\t}\n1020|\tif fold.projection.Parked != nil {\n1021|\t\twarnings[\"parked: \"+fold.projection.Parked.BlockingReason] = struct{}{}\n1022|\t}\n1023|\tif len(warnings) == 0 {\n1024|\t\treturn\n1025|\t}\n1026|\tordered := make([]string, 0, len(warnings))\n1027|\tfor warning := range warnings {\n1028|\t\tordered = append(ordered, warning)\n1029|\t}\n1030|\tsort.Strings(ordered)\n1031|\tfold.projection.Warnings = ordered\n1032|}\n1033|\n1034|func containsString(haystack []string, needle string) bool {\n1035|\tfor _, candidate := range haystack {\n1036|\t\tif candidate == needle {\n1037|\t\t\treturn true\n1038|\t\t}\n1039|\t}\n1040|\treturn false\n1041|}"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4ab","stream":{"kind":"session","id":"01a07db8-a28a-7e80-8be1-e3a988123386"},"sequence":176,"recorded_at":1780531400000347,"record_type":"event","durability":"durable","causation_id":"4385e4d6-e071-42f2-a438-a44213370546","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4385e4d6-e071-42f2-a438-a44213370546","run_stream":{"kind":"run","id":"4385e4d6-e071-42f2-a438-a44213370546"},"task_stream":{"kind":"task","id":"9910bca4-bd31-4401-9e75-5f9148afc18d"},"task_id":"9910bca4-bd31-4401-9e75-5f9148afc18d","event":{"kind":"completed","task_id":"9910bca4-bd31-4401-9e75-5f9148afc18d"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4ad","stream":{"kind":"session","id":"01a07db8-a28a-7e80-8be1-e3a988123386"},"sequence":177,"recorded_at":1780531400000349,"record_type":"event","durability":"durable","causation_id":"4385e4d6-e071-42f2-a438-a44213370546","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4385e4d6-e071-42f2-a438-a44213370546","run_stream":{"kind":"run","id":"4385e4d6-e071-42f2-a438-a44213370546"},"call_id":"call_01a07db90a2b710089bc99e493a18bdf","text":"Read text file `internal/sessstate/sessstate.go`.\n(499 line(s) above)\n500|}\n501|\n502|// tailID and tailSeq live beside the fold; declared here to keep the\n503|// struct literal above readable.\n504|func (fold *chainFold) conflict(kind, rule, format string, arguments ...any) {\n505|\tfold.projection.Conflicts = append(fold.projection.Conflicts, Conflict{\n506|\t\tKind:   kind,\n507|\t\tRule:   rule,\n508|\t\tDetail: fmt.Sprintf(format, arguments...),\n509|\t})\n510|}\n511|\n512|// step moves the derivation through the Section 5.7 table. An empty\n513|// target keeps the state (a fact or inert event performs no\n514|// transition); an equal target restates it (a confirming event while\n515|// already there is not a transition); the first event may only open a\n516|// bootstrap state; every other move needs its table edge, else\n517|// invalid_state_transition.\n518|func (fold *chainFold) step(target State, what string) error {\n519|\tif target == \"\" || target == fold.state {\n520|\t\treturn nil\n521|\t}\n522|\tif fold.state == \"\" {\n523|\t\tif _, ok := initialTargets[target]; !ok {\n524|\t\t\treturn refuse(ErrInvalidTransition, \"%s opens unbootstrapped state %q\", what, string(target))\n525|\t\t}\n526|\t\tfold.state = target\n527|\t\treturn nil\n528|\t}\n529|\tif _, ok := allowedTransitions[fold.state][target]; !ok {\n530|\t\treturn refuse(ErrInvalidTransition, \"%s moves %q to %q without a Section 5.7 edge\", what, string(fold.state), string(target))\n531|\t}\n532|\tfold.state = target\n533|\treturn nil\n534|}\n535|\n536|// effect applies one event's lifecycle meaning after continuity and\n537|// lease tracking. Fact events return an empty target and keep the\n538|// state; unknown v1 types and the v2/v3/v4 non-lifecycle types are\n539|// inert by Section 5.2 (retained, never applied).\n540|func (fold *chainFold) effect(event Event, lease LeaseHead, succession bool) error {\n541|\tname := \"event \" + event.Type + \" \" + event.ID\n542|\tswitch event.Type {\n543|\tcase \"session.created\":\n544|\t\treturn fold.effectCreated(event, name)\n545|\tcase \"terminal.created\":\n546|\t\treturn fold.effectTerminalCreated(event, name)\n547|\tcase \"provider.launched\":\n548|\t\treturn fold.effectProviderLaunched(event, name)\n549|\tcase \"provider.identified\":\n550|\t\treturn fold.effectProviderIdentified(event, name)\n551|\tcase \"session.idle\":\n552|\t\treturn fold.step(StateIdle, name)\n553|\tcase \"session.quiescing\":\n554|\t\treturn fold.step(StateQuiescing, name)\n555|\tcase \"checkpoint.created\":\n556|\t\treturn fold.effectCheckpointCreated(event, name)\n557|\tcase \"sync.completed\":\n558|\t\treturn nil\n559|\tcase \"session.stopped\":\n560|\t\treturn fold.effectStopped(event, name)\n561|\tcase \"session.resumed\":\n562|\t\treturn fold.effectResumed(event, name)\n563|\tcase \"session.bootstrap_aborted\":\n564|\t\treturn fold.effectBootstrapAborted(event, name)\n565|\tcase \"lease.transferred\", \"lease.forced\":\n566|\t\treturn fold.effectLease(event, lease, name, succession)\n567|\tcase \"session.parked\":\n568|\t\treturn fold.step(StateParked, name)\n569|\tcase \"session.failed\":\n570|\t\treturn fold.step(StateFailed, name)\n571|\tcase \"fork.created\", \"profile.changed\", \"takeover.force_confirmed\",\n572|\t\t\"replica.replace_confirmed\", \"task_board.adopted\",\n573|\t\t\"tombstone.issued\", \"tombstone.resolved\":\n574|\t\treturn nil\n575|\tcase \"session.tombstoned\":\n576|\t\treturn fold.step(StateTombstoned, name)\n577|\tcase \"task_board.launched\":\n578|\t\treturn fold.effectTaskBoardLaunched(event, name)\n579|\tdefault:\n580|\t\treturn nil\n581|\t}\n582|}\n583|\n584|// effectCreated opens the bootstrap, including the Section 5.7\n585|// failed-to-creating retry: epoch 1 under the same winning create\n586|// lease, no validated checkpoint yet, and no authoritative bootstrap\n587|// abort on record. Anything else that reaches for creating refuses.\n588|func (fold *chainFold) effectCreated(event Event, what string) error {\n589|\tif fold.state == \"\" {\n590|\t\treturn fold.step(StateCreating, what)\n591|\t}\n592|\tif fold.state != StateFailed {\n593|\t\treturn fold.step(StateCreating, what)\n594|\t}\n595|\tif event.LeaseEpoch != 1 || event.LeaseID != fold.createLease.LeaseID ||\n596|\t\tevent.LeaseEpoch != fold.createLease.Epoch {\n597|\t\treturn refuse(ErrInvalidTransition, \"%s retries bootstrap under a new lease\", what)\n598|\t}\n599|\tif fold.seenCheckpoint {\n600|\t\treturn refuse(ErrInvalidTransition, \"%s retries bootstrap past a validated checkpoint\", what)\n601|\t}\n602|\tif fold.seenAbort {\n603|\t\treturn refuse(ErrInvalidTransition, \"%s retries bootstrap past an authoritative abort\", what)\n604|\t}\n605|\treturn fold.step(StateCreating, what)\n606|}\n607|\n608|// effectTerminalCreated records the terminal binding; as the first\n609|// event it also opens the bootstrap in creating.\n610|func (fold *chainFold) effectTerminalCreated(event Event, what string) error {\n611|\tif event.SchemaVersion == \"4.0.0\" {\n612|\t\tbinding, err := payloadString(event.Payload, \"terminal_binding_id\")\n613|\t\tif err != nil {\n614|\t\t\treturn err\n615|\t\t}\n616|\t\tif _, err := scalar.ParseDigest(binding); err != nil {\n617|\t\t\treturn refuse(ErrDerivation, \"%s carries malformed terminal_binding_id: %v\", what, err)\n618|\t\t}\n619|\t\tbackend, err := payloadString(event.Payload, \"terminal_backend_id\")\n620|\t\tif err != nil {\n621|\t\t\treturn err\n622|\t\t}\n623|\t\tif _, err := terminalbackend.ParseID(backend); err != nil {\n624|\t\t\treturn refuse(ErrDerivation, \"%s carries refused terminal backend: %v\", what, err)\n625|\t\t}\n626|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, BindingID: binding, EventID: event.ID}\n627|\t} else {\n628|\t\tbackend, err := payloadString(event.Payload, \"backend\")\n629|\t\tif err != nil {\n630|\t\t\treturn err\n631|\t\t}\n632|\t\tif backend != \"tmux\" && backend != \"conpty\" {\n633|\t\t\treturn refuse(ErrDerivation, \"%s carries unknown terminal backend %q\", what, backend)\n634|\t\t}\n635|\t\tterminalID, err := payloadString(event.Payload, \"terminal_id\")\n636|\t\tif err != nil {\n637|\t\t\treturn err\n638|\t\t}\n639|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, TerminalID: terminalID, EventID: event.ID}\n640|\t}\n641|\tfold.projection.HasTerminal = true\n642|\tif fold.state == \"\" {\n643|\t\treturn fold.step(StateCreating, what)\n644|\t}\n645|\treturn nil\n646|}\n647|\n648|// effectProviderLaunched moves to running and records the launched\n649|// version. The record provider stays authoritative: a launched event\n650|// naming another provider records a provider_mismatch conflict under\n651|// the record-pinned-provider-wins rule instead of rewriting identity.\n652|func (fold *chainFold) effectProviderLaunched(event Event, what string) error {\n653|\tproviderID, err := payloadString(event.Payload, \"provider_id\")\n654|\tif err != nil {\n655|\t\treturn err\n656|\t}\n657|\tversion, err := payloadString(event.Payload, \"provider_version\")\n658|\tif err != nil {\n659|\t\treturn err\n660|\t}\n661|\tif providerID != fold.recordProvider {\n662|\t\tfold.conflict(ConflictProviderMismatch, ResolveRuleRecordPinnedProviderWins,\n663|\t\t\t\"event %s launches provider %q under record provider %q; the record value stays authoritative\",\n664|\t\t\tevent.ID, providerID, fold.recordProvider)\n665|\t} else {\n666|\t\tfold.projection.Provider.Version = version\n667|\t}\n668|\treturn fold.step(StateRunning, what)\n669|}\n670|\n671|// effectProviderIdentified records the newest identity record with\n672|// its confidence.\n673|func (fold *chainFold) effectProviderIdentified(event Event, what string) error {\n674|\trecordID, err := payloadString(event.Payload, \"provider_identity_record_id\")\n675|\tif err != nil {\n676|\t\treturn err\n677|\t}\n678|\tif _, err := scalar.ParseDigest(recordID); err != nil {\n679|\t\treturn refuse(ErrDerivation, \"%s carries malformed provider_identity_record_id: %v\", what, err)\n680|\t}\n681|\tconfidence, err := payloadString(event.Payload, \"confidence\")\n682|\tif err != nil {\n683|\t\treturn err\n684|\t}\n685|\tfold.projection.Provider.IdentityRecordID = recordID\n686|\tfold.projection.Provider.Confidence = confidence\n687|\treturn nil\n688|}\n689|\n690|// effectCheckpointCreated records the newest validated checkpoint and\n691|// moves idle or quiescing into checkpointing, or checkpointing back to\n692|// idle at the validated boundary. Any other lifecycle position refuses:\n693|// a checkpoint cannot land while running, creating, stopped, parked,\n694|// failed, stale, materializing, or tombstoned without the quiesce or\n695|// resume the table requires.\n696|func (fold *chainFold) effectCheckpointCreated(event Event, what string) error {\n697|\tcheckpointID, err := payloadString(event.Payload, \"checkpoint_id\")\n698|\tif err != nil {\n699|\t\treturn err\n700|\t}\n701|\tif _, err := scalar.ParseDigest(checkpointID); err != nil {\n702|\t\treturn refuse(ErrDerivation, \"%s carries malformed checkpoint_id: %v\", what, err)\n703|\t}\n704|\tkind, err := payloadString(event.Payload, \"kind\")\n705|\tif err != nil {\n706|\t\treturn err\n707|\t}\n708|\tfold.noteCheckpoint(checkpointID, kind, event.ID)\n709|\tswitch fold.state {\n710|\tcase \"\", StateIdle, StateQuiescing:\n711|\t\tif fold.state == \"\" {\n712|\t\t\treturn refuse(ErrInvalidTransition, \"%s publishes a checkpoint before any bootstrap\", what)\n713|\t\t}\n714|\t\treturn fold.step(StateCheckpointing, what)\n715|\tcase StateCheckpointing:\n716|\t\treturn fold.step(StateIdle, what)\n717|\tdefault:\n718|\t\treturn fold.step(StateCheckpointing, what)\n719|\t}\n720|}\n721|\n722|// effectStopped derives stopped for a checkpointed closure and failed\n723|// for a bootstrap abort. No event may derive stopped while the newest\n724|// checkpoint is null: the event's own checkpoint counts, so a\n725|// checkpointed stop carries its resumable base with it. A bootstrap\n726|// abort requires the null checkpoint, false resumable and graceful\n727|// values the canonical owner admitted, plus a preceding authoritative\n728|// abort event; an ambiguous live process stays failed with recovery\n729|// diagnostics instead.\n730|func (fold *chainFold) effectStopped(event Event, what string) error {\n731|\tcheckpointID, hasCheckpoint, err := payloadNullableDigest(event.Payload, \"checkpoint_id\")\n732|\tif err != nil {\n733|\t\treturn err\n734|\t}\n735|\tresumable, err := payloadBool(event.Payload, \"resumable\")\n736|\tif err != nil {\n737|\t\treturn err\n738|\t}\n739|\tclosure, err := payloadString(event.Payload, \"closure_kind\")\n740|\tif err != nil {\n741|\t\treturn err\n742|\t}\n743|\tif closure == \"checkpointed\" {\n744|\t\tif !hasCheckpoint || !resumable {\n745|\t\t\treturn refuse(ErrIntegrity, \"%s closes checkpointed without a resumable checkpoint\", what)\n746|\t\t}\n747|\t\tfold.noteCheckpoint(checkpointID, \"\", event.ID)\n748|\t\treturn fold.step(StateStopped, what)\n749|\t}\n750|\tif hasCheckpoint || resumable {\n751|\t\treturn refuse(ErrIntegrity, \"%s closes bootstrap_abort with a checkpoint or resumable set\", what)\n752|\t}\n753|\tif !fold.seenAbort {\n754|\t\treturn refuse(ErrInvalidTransition, \"%s closes bootstrap_abort with no authoritative abort event\", what)\n755|\t}\n756|\treturn fold.step(StateFailed, what)\n757|}\n758|\n759|// effectResumed moves to running under the resumed checkpoint and\n760|// records the terminal binding the resume selected.\n761|func (fold *chainFold) effectResumed(event Event, what string) error {\n762|\tcheckpointID, err := payloadString(event.Payload, \"checkpoint_id\")\n763|\tif err != nil {\n764|\t\treturn err\n765|\t}\n766|\tif _, err := scalar.ParseDigest(checkpointID); err != nil {\n767|\t\treturn refuse(ErrDerivation, \"%s carries malformed checkpoint_id: %v\", what, err)\n768|\t}\n769|\tfold.noteCheckpoint(checkpointID, \"\", event.ID)\n770|\tif event.SchemaVersion == \"4.0.0\" {\n771|\t\tbinding, err := payloadString(event.Payload, \"terminal_binding_id\")\n772|\t\tif err != nil {\n773|\t\t\treturn err\n774|\t\t}\n775|\t\tif _, err := scalar.ParseDigest(binding); err != nil {\n776|\t\t\treturn refuse(ErrDerivation, \"%s carries malformed terminal_binding_id: %v\", what, err)\n777|\t\t}\n778|\t\tbackend, err := payloadString(event.Payload, \"terminal_backend_id\")\n779|\t\tif err != nil {\n780|\t\t\treturn err\n781|\t\t}\n782|\t\tif _, err := terminalbackend.ParseID(backend); err != nil {\n783|\t\t\treturn refuse(ErrDerivation, \"%s carries refused terminal backend: %v\", what, err)\n784|\t\t}\n785|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, BindingID: binding, EventID: event.ID}\n786|\t} else {\n787|\t\tbackend, err := payloadString(event.Payload, \"terminal_backend\")\n788|\t\tif err != nil {\n789|\t\t\treturn err\n790|\t\t}\n791|\t\tif backend != \"tmux\" && backend != \"conpty\" {\n792|\t\t\treturn refuse(ErrDerivation, \"%s carries unknown terminal backend %q\", what, backend)\n793|\t\t}\n794|\t\tnativeID, err := payloadString(event.Payload, \"native_session_id\")\n795|\t\tif err != nil {\n796|\t\t\treturn err\n797|\t\t}\n798|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, NativeSessionID: nativeID, EventID: event.ID}\n799|\t}\n800|\tfold.projection.HasTerminal = true\n801|\treturn fold.step(StateRunning, what)\n802|}\n803|\n804|// effectBootstrapAborted records the authoritative abort and fails the\n805|// bootstrap. Only the creating session can abort its bootstrap; any\n806|// later abort is invalid_state_transition.\n807|func (fold *chainFold) effectBootstrapAborted(event Event, what string) error {\n808|\tfold.seenAbort = true\n809|\tif fold.state != \"\" && fold.state != StateCreating {\n810|\t\treturn refuse(ErrInvalidTransition, \"%s aborts a bootstrap past creating\", what)\n811|\t}\n812|\treturn fold.step(StateFailed, what)\n813|}\n814|\n815|// effectLease checks the successor-lease payload linkage: the payload\n816|// must name the predecessor the chain stands on and the envelope it\n817|// arrives under, else integrity_failure. The lifecycle move already\n818|// happened in successionMove; a lease event repeating the current\n819|// lease is a fact, not a transition.\n820|func (fold *chainFold) effectLease(event Event, lease LeaseHead, what string, succession bool) error {\n821|\tif !succession {\n822|\t\treturn nil\n823|\t}\n824|\tif event.Type == \"lease.transferred\" {\n825|\t\tpredecessor, err := payloadString(event.Payload, \"predecessor_lease_id\")\n826|\t\tif err != nil {\n827|\t\t\treturn err\n828|\t\t}\n829|\t\tif predecessor != fold.previous.LeaseID {\n830|\t\t\treturn refuse(ErrIntegrity, \"%s transfers from lease %s past chain head lease %s\", what, predecessor, fold.previous.LeaseID)\n831|\t\t}\n832|\t\tsuccessor, err := payloadString(event.Payload, \"new_lease_id\")\n833|\t\tif err != nil {\n834|\t\t\treturn err\n835|\t\t}\n836|\t\tif successor != lease.LeaseID {\n837|\t\t\treturn refuse(ErrIntegrity, \"%s transfers to lease %s outside its envelope lease %s\", what, successor, lease.LeaseID)\n838|\t\t}\n839|\t} else {\n840|\t\tsuccessor, err := payloadString(event.Payload, \"new_lease_id\")\n841|\t\tif err != nil {\n842|\t\t\treturn err\n843|\t\t}\n844|\t\tif successor != lease.LeaseID {\n845|\t\t\treturn refuse(ErrIntegrity, \"%s forces lease %s outside its envelope lease %s\", what, successor, lease.LeaseID)\n846|\t\t}\n847|\t}\n848|\treturn nil\n849|}\n850|\n851|// effectTaskBoardLaunched enforces the Section 5.2 repeat rule — the\n852|// event must repeat the winning creation lease and the Session\n853|// Record's provider and launch mode — then derives the payload's\n854|// running or idle state through the table.\n855|func (fold *chainFold) effectTaskBoardLaunched(event Event, what string) error {\n856|\tproviderID, err := payloadString(event.Payload, \"provider_id\")\n857|\tif err != nil {\n858|\t\treturn err\n859|\t}\n860|\tif providerID != fold.recordProvider {\n861|\t\treturn refuse(ErrIntegrity, \"%s repeats provider %q past record provider %q\", what, providerID, fold.recordProvider)\n862|\t}\n863|\tpayloadEpoch, err := payloadUint(event.Payload, \"lease_epoch\")\n864|\tif err != nil {\n865|\t\treturn err\n866|\t}\n867|\tpayloadLease, err := payloadString(event.Payload, \"lease_id\")\n868|\tif err != nil {\n869|\t\treturn err\n870|\t}\n871|\tif payloadEpoch != fold.createLease.Epoch || payloadLease != fold.createLease.LeaseID {\n872|\t\treturn refuse(ErrIntegrity, \"%s repeats creation lease (%d, %s) past create lease (%d, %s)\", what, payloadEpoch, payloadLease, fold.createLease.Epoch, fold.createLease.LeaseID)\n873|\t}\n874|\treported, err := payloadString(event.Payload, \"state\")\n875|\tif err != nil {\n876|\t\treturn err\n877|\t}\n878|\tif reported == string(StateRunning) {\n879|\t\treturn fold.step(StateRunning, what)\n880|\t}\n881|\treturn fold.step(StateIdle, what)\n882|}\n883|\n884|// noteCheckpoint records the newest validated checkpoint.\n885|func (fold *chainFold) noteCheckpoint(id, kind, eventID string) {\n886|\tfold.seenCheckpoint = true\n887|\tfold.projection.HasCheckpoint = true\n888|\tfold.projection.Newest = Checkpoint{ID: id, Kind: kind, EventID: eventID}\n889|}\n890|\n891|// resolveWinner selects the winning lease over the authoritative chain\n892|// leases and the union leases by the greatest (epoch, lease_id)\n893|// tuple. A same-epoch tie resolves to the bytewise-greater lease ID;\n894|// an off-chain union winner moves the reported winner but never\n895|// rewrites authoritative state; union leases that lose are reported\n896|// preserved-never-applied. With no union the chain head wins alone\n897|// and no conflict is recorded.\n898|func (fold *chainFold) resolveWinner(union []LeaseHead) error {\n899|\twinner := fold.current\n900|\tonChain := map[string]struct{}{}\n901|\tif fold.haveLease {\n902|\t\tonChain[fold.current.LeaseID] = struct{}{}\n903|\t}\n904|\tfor _, lease := range fold.chainLeases() {\n905|\t\tonChain[lease.LeaseID] = struct{}{}\n906|\t}\n907|\tbyEpoch := map[uint64]map[string]struct{}{}\n908|\tnote := func(lease LeaseHead) {\n909|\t\tif byEpoch[lease.Epoch] == nil {\n910|\t\t\tbyEpoch[lease.Epoch] = map[string]struct{}{}\n911|\t\t}\n912|\t\tbyEpoch[lease.Epoch][lease.LeaseID] = struct{}{}\n913|\t}\n914|\tfor _, lease := range fold.chainLeases() {\n915|\t\tnote(lease)\n916|\t}\n917|\toffChainWinner := false\n918|\tfor _, lease := range union {\n919|\t\tif lease.IsZero() {\n920|\t\t\treturn refuse(ErrInvalidEvent, \"union carries an empty lease head\")\n921|\t\t}\n922|\t\tif _, err := scalar.ParseUUIDv4(lease.LeaseID); err != nil {\n923|\t\t\treturn refuse(ErrInvalidEvent, \"union lease %q is not a UUIDv4: %v\", lease.LeaseID, err)\n924|\t\t}\n925|\t\tnote(lease)\n926|\t\tswitch Compare(lease, winner) {\n927|\t\tcase 1:\n928|\t\t\twinner = lease\n929|\t\t\tif _, ok := onChain[lease.LeaseID]; !ok {\n930|\t\t\t\toffChainWinner = true\n931|\t\t\t}\n932|\t\tcase -1:\n933|\t\t\tfold.conflict(ConflictLosingBranchPreserved, ResolveRulePreservedNeverApplied,\n934|\t\t\t\t\"union lease (%d, %s) loses to (%d, %s); its history stays preserved and never applies\",\n935|\t\t\t\tlease.Epoch, lease.LeaseID, winner.Epoch, winner.LeaseID)\n936|\t\tcase 0:\n937|\t\t\tif _, ok := onChain[lease.LeaseID]; !ok {\n938|\t\t\t\toffChainWinner = false\n939|\t\t\t}\n940|\t\t}\n941|\t}\n942|\tepochs := make([]uint64, 0, len(byEpoch))\n943|\tfor epoch := range byEpoch {\n944|\t\tepochs = append(epochs, epoch)\n945|\t}\n946|\tsort.Slice(epochs, func(i, j int) bool { return epochs[i] < epochs[j] })\n947|\tfor _, epoch := range epochs {\n948|\t\trivals := byEpoch[epoch]\n949|\t\tif len(rivals) < 2 {\n950|\t\t\tcontinue\n951|\t\t}\n952|\t\tordered := make([]string, 0, len(rivals))\n953|\t\tfor id := range rivals {\n954|\t\t\tordered = append(ordered, id)\n955|\t\t}\n956|\t\tsort.Strings(ordered)\n957|\t\tfold.conflict(ConflictSameEpochTie, ResolveRuleGreatestLeaseIDWins,\n958|\t\t\t\"epoch %d is shared by leases %v; the bytewise-greater lease ID %s wins\",\n959|\t\t\tepoch, ordered, ordered[len(ordered)-1])\n960|\t}\n961|\tif offChainWinner {\n962|\t\tfold.conflict(ConflictUnionSupersedesChain, ResolveRuleAuthoritativeStateUnchanged,\n963|\t\t\t\"union winner (%d, %s) stands outside the authoritative chain; derived state is unchanged until an explicit takeover lands\",\n964|\t\t\twinner.Epoch, winner.LeaseID)\n965|\t}\n966|\tfold.projection.Winner = winner\n967|\treturn nil\n968|}\n969|\n970|// chainLeases replays the distinct envelope leases in first-appearance\n971|// order. Every succession appends, so a tie planted at any past epoch\n972|// still resolves against the lease the chain actually stood on. Gaps\n973|// were already recorded at succession time.\n974|func (fold *chainFold) chainLeases() []LeaseHead {\n975|\treturn append([]LeaseHead(nil), fold.leases...)\n976|}\n977|\n978|// applyLocalLease derives the local projection: the owner host of the\n979|// newest authoritative event decides the local role against the\n980|// caller-supplied host, and a local lease that lost the tuple rule\n981|// stales the projection exactly where the table lets it go stale.\n982|func (fold *chainFold) applyLocalLease(local LeaseHead, localHostID string) {\n983|\tif localHostID != \"\" && fold.projection.OwnerHostID != \"\" {\n984|\t\tif localHostID == fold.projection.OwnerHostID {\n985|\t\t\tfold.projection.LocalRole = \"owner\"\n986|\t\t} else {\n987|\t\t\tfold.projection.LocalRole = \"replica\"\n988|\t\t}\n989|\t}\n990|\tif local.IsZero() || !fold.haveLease {\n991|\t\treturn\n992|\t}\n993|\tif Compare(local, fold.projection.Winner) == 0 {\n994|\t\treturn\n995|\t}\n996|\tif _, ok := staleSources[fold.state]; !ok {\n997|\t\treturn\n998|\t}\n999|\tfold.state = StateStale\n1000|\tfold.projection.State = StateStale\n1001|}\n1002|\n1003|// emitWarnings publishes the sorted unique warnings this leaf derives:\n1004|// divergent history behind any lease or provider conflict, a stale\n1005|// local process, and the parked blocking reason. Capability,\n1006|// authentication, and sync-age warnings belong to other leaves.\n1007|func (fold *chainFold) emitWarnings() {\n1008|\tfold.projection.State = fold.state\n1009|\twarnings := map[string]struct{}{}\n1010|\tfor _, conflict := range fold.projection.Conflicts {\n1011|\t\tswitch conflict.Kind {\n1012|\t\tcase ConflictSameEpochTie, ConflictEpochGap, ConflictLosingBranchPreserved,\n1013|\t\t\tConflictUnionSupersedesChain, ConflictProviderMismatch:\n1014|\t\t\twarnings[\"divergent_history\"] = struct{}{}\n1015|\t\t}\n1016|\t}\n1017|\tif fold.state == StateStale {\n1018|\t\twarnings[\"stale_process\"] = struct{}{}\n1019|\t}\n1020|\tif fold.projection.Parked != nil {\n1021|\t\twarnings[\"parked: \"+fold.projection.Parked.BlockingReason] = struct{}{}\n1022|\t}\n1023|\tif len(warnings) == 0 {\n1024|\t\treturn\n1025|\t}\n1026|\tordered := make([]string, 0, len(warnings))\n1027|\tfor warning := range warnings {\n1028|\t\tordered = append(ordered, warning)\n1029|\t}\n1030|\tsort.Strings(ordered)\n1031|\tfold.projection.Warnings = ordered\n1032|}\n1033|\n1034|func containsString(haystack []string, needle string) bool {\n1035|\tfor _, candidate := range haystack {\n1036|\t\tif candidate == needle {\n1037|\t\t\treturn true\n1038|\t\t}\n1039|\t}\n1040|\treturn false\n1041|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
