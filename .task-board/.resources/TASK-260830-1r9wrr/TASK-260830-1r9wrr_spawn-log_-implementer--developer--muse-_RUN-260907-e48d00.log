:\\\"New acceptance criteria\\\"},{\\\"name\\\":\\\"review\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"New review policy\\\",\\\"enum\\\":[\\\"required\\\",\\\"light\\\",\\\"none\\\"]},{\\\"name\\\":\\\"task_class\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"New task class\\\",\\\"enum\\\":[\\\"code\\\",\\\"metadata\\\",\\\"docs\\\",\\\"research\\\"]}],\\\"examples\\\":[\\\"set_details(TASK-260218-abc123, title=\\\\\\\"new-title\\\\\\\", description=\\\\\\\"updated desc\\\\\\\")\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":true},\\\"set_estimate\\\":{\\\"description\\\":\\\"Set the explicit Task/Bug estimate enum\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Task or Bug ID\\\",\\\"required\\\":true},{\\\"name\\\":\\\"estimate\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Outer estimate enum\\\",\\\"enum\\\":[\\\"notEstimated\\\",\\\"estimated\\\"],\\\"required\\\":true},{\\\"name\\\":\\\"scale\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Nested estimate scale\\\",\\\"enum\\\":[\\\"fibonacci\\\"]},{\\\"name\\\":\\\"number\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Non-negative scale value\\\"}],\\\"examples\\\":[\\\"set_estimate(TASK-260218-abc123, estimate=notEstimated)\\\",\\\"set_estimate(TASK-260218-abc123, estimate=estimated, scale=fibonacci, number=5)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":true},\\\"set_notes\\\":{\\\"description\\\":\\\"Append or replace notes on an element\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\",\\\"required\\\":true},{\\\"name\\\":\\\"text\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Notes text\\\",\\\"required\\\":true},{\\\"name\\\":\\\"set\\\",\\\"type\\