:= buildRecord(t, nil)\n+\t\t_, events, _ := buildChain(t, raw, chain)\n+\t\t_, err := Reduce(Input{Record: record, Events: events})\n+\t\tmustErrorIs(t, err, ErrIntegrity, \"Reduce(task-board later epoch)\")\n+\t})\n"}}}
