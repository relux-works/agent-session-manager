{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb6b","stream":{"kind":"session","id":"01a07d5e-0f16-71a3-abaf-54c2f5d26492"},"sequence":1040,"recorded_at":1780531400002075,"record_type":"event","durability":"durable","causation_id":"e2cea5ab-c4ff-4757-bfdf-44257ee82bbf","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e2cea5ab-c4ff-4757-bfdf-44257ee82bbf","run_stream":{"kind":"run","id":"e2cea5ab-c4ff-4757-bfdf-44257ee82bbf"},"task_stream":{"kind":"task","id":"9961d23c-466d-484d-8cfa-be71b1ccee6f"},"task_id":"9961d23c-466d-484d-8cfa-be71b1ccee6f","event":{"kind":"output","task_id":"9961d23c-466d-484d-8cfa-be71b1ccee6f","chunk":"edited\nchanged lines: lines 16-56\n--- original\n+++ updated\n@@\n-// reduceDirect folds specs through Decode into Reduce without a\n-// repository, for the pure-core table.\n-func reduceDirect(t *testing.T, record []byte, specs []eventSpec) Projection {\n-\tt.Helper()\n-\tdecoded, err := DecodeRecord(record)\n-\tif err != nil {\n-\t\tt.Fatalf(\"DecodeRecord error = %v\", err)\n-\t}\n-\tinput := Input{Record: decoded}\n-\tpredecessors := []string{decoded.RecordID}\n-\tfor index, spec := range specs {\n-\t\tepoch := spec.epoch\n-\t\tif epoch == 0 {\n-\t\t\tepoch = 1\n-\t\t}\n-\t\tleaseID := spec.leaseID\n-\t\tif leaseID == \"\" {\n-\t\t\tleaseID = testLeaseID\n-\t\t}\n-\t\tevent, _ := mustDecodeEvent(t, eventOptions{\n-\t\t\tsessionID:     decoded.SessionID,\n-\t\t\tpredecessors:  predecessors,\n-\t\t\tepoch:         epoch,\n-\t\t\tleaseID:       leaseID,\n-\t\t\tsequence:      uint64(index + 1),\n-\t\t\teventType:     spec.typ,\n-\t\t\tpayload:       spec.payload,\n-\t\t\tschemaVersion: spec.version,\n-\t\t})\n-\t\t// Sequence restarts per lease for successor leases; the table\n-\t\t// below passes explicit envelopes, so recompute per-lease\n-\t\t// sequence here from the spec order within each lease.\n-\t\tinput.Events = append(input.Events, event)\n-\t\tpredecessors = []string{event.ID}\n-\t}\n-\tprojection, err := Reduce(input)\n-\tif err != nil {\n-\t\tt.Fatalf(\"Reduce error = %v\", err)\n-\t}\n-\treturn projection\n-}\n+// buildChain folds specs into canonical-exact decoded events,\n+// assigning per-lease sequences (a successor lease restarts at 1) and\n+// chaining predecessors. It returns the raw bytes alongside, so the\n+// same chain drives both the pure Reduce entry and the\n+// repository-backed Project entry.\n+func buildChain(t *testing.T, record []byte, specs []eventSpec) (Record, []Event, [][]byte) {\n+\tt.Helper()\n+\tdecoded, err := DecodeRecord(record)\n+\tif err != nil {\n+\t\tt.Fatalf(\"DecodeRecord error = %v\", err)\n+\t}\n+\tvar events []Event\n+\tvar raws [][]byte\n+\tpredecessors := []string{decoded.RecordID}\n+\tvar lastLease string\n+\tvar sequence uint64\n+\tfor _, spec := range specs {\n+\t\tepoch := spec.epoch\n+\t\tif epoch == 0 {\n+\t\t\tepoch = 1\n+\t\t}\n+\t\tleaseID := spec.leaseIDOr(testLeaseID)\n+\t\tif leaseID != lastLease {\n+\t\t\tsequence = 1\n+\t\t\tlastLease = leaseID\n+\t\t} else {\n+\t\t\tsequence++\n+\t\t}\n+\t\tevent, raw := mustDecodeEvent(t, eventOptions{\n+\t\t\tsessionID:     decoded.SessionID,\n+\t\t\tpredecessors:  predecessors,\n+\t\t\tepoch:         epoch,\n+\t\t\tleaseID:       leaseID,\n+\t\t\tsequence:      sequence,\n+\t\t\teventType:     spec.typ,\n+\t\t\tpayload:       spec.payload,\n+\t\t\tschemaVersion: spec.version,\n+\t\t})\n+\t\tevents = append(events, event)\n+\t\traws = append(raws, raw)\n+\t\tpredecessors = []string{event.ID}\n+\t}\n+\treturn decoded, events, raws\n+}\n+\n+// reduceDirect folds specs through Decode into Reduce without a\n+// repository, for the pure-core table.\n+func reduceDirect(t *testing.T, record []byte, specs []eventSpec) Projection {\n+\tt.Helper()\n+\tdecoded, events, _ := buildChain(t, record, specs)\n+\tprojection, err := Reduce(Input{Record: decoded, Events: events})\n+\tif err != nil {\n+\t\tt.Fatalf(\"Reduce error = %v\", err)\n+\t}\n+\treturn projection\n+}\n"}}}
