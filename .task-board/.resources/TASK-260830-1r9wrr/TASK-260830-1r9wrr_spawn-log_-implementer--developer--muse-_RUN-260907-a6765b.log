{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d71d","stream":{"kind":"session","id":"01a07d5e-0f16-71a3-abaf-54c2f5d26492"},"sequence":2537,"recorded_at":1780531400005069,"record_type":"event","durability":"durable","causation_id":"e2cea5ab-c4ff-4757-bfdf-44257ee82bbf","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e2cea5ab-c4ff-4757-bfdf-44257ee82bbf","run_stream":{"kind":"run","id":"e2cea5ab-c4ff-4757-bfdf-44257ee82bbf"},"task_stream":{"kind":"task","id":"666a85ec-f6c0-4cb2-a18e-6d5afd3151fa"},"task_id":"666a85ec-f6c0-4cb2-a18e-6d5afd3151fa","event":{"kind":"output","task_id":"666a85ec-f6c0-4cb2-a18e-6d5afd3151fa","chunk":"edited\nchanged lines: lines 212-234\n--- original\n+++ updated\n@@\n-\tt.Run(\"new lease refused\", func(t *testing.T) {\n-\t\traw := buildRecord(t, nil)\n-\t\thead := []eventSpec{\n-\t\t\t{typ: \"session.created\", payload: createdPayload(record.RecordID)},\n-\t\t\t{typ: \"provider.launched\", payload: launchedPayload(\"codex\")},\n-\t\t\t{typ: \"session.failed\", payload: failedPayload()},\n-\t\t}\n-\t\t_, headEvents, _ := buildChain(t, raw, head)\n-\t\tretry, _ := mustDecodeEvent(t, eventOptions{\n-\t\t\tsessionID:    record.SessionID,\n-\t\t\tpredecessors: []string{headEvents[len(headEvents)-1].ID},\n-\t\t\tepoch:        2,\n-\t\t\tleaseID:      testLeaseIDB,\n-\t\t\tsequence:     1,\n-\t\t\teventType:    \"session.created\",\n-\t\t\tpayload:      createdPayload(record.RecordID),\n-\t\t})\n-\t\t// A bare new-lease create without a lease event still reaches\n-\t\t// the retry gate through succession; the gate must refuse the\n-\t\t// new lease even though the table would stage materializing.\n-\t\t_, err := Reduce(Input{Record: record, Events: append(headEvents, retry)})\n-\t\tmustErrorIs(t, err, ErrInvalidTransition, \"Reduce(retry under new lease)\")\n-\t})\n+\tt.Run(\"new lease refused\", func(t *testing.T) {\n+\t\t// The retry gate compares against the create lease, not the\n+\t\t// current one: after a takeover the chain stands on lease B,\n+\t\t// fails there, and a creating retry under B still refuses.\n+\t\t// (A retry under a fresh lease C would strand in\n+\t\t// successionMove first; the gate owns the same-lease case.)\n+\t\traw := buildRecord(t, nil)\n+\t\thead := []eventSpec{\n+\t\t\t{typ: \"session.created\", payload: createdPayload(record.RecordID)},\n+\t\t\t{typ: \"provider.launched\", payload: launchedPayload(\"codex\")},\n+\t\t\t{typ: \"session.idle\", payload: idlePayload()},\n+\t\t\t{typ: \"checkpoint.created\", payload: checkpointPayload()},\n+\t\t\t{typ: \"checkpoint.created\", payload: checkpointPayload()},\n+\t\t\t{typ: \"session.stopped\", payload: stoppedPayload()},\n+\t\t\t{typ: \"session.resumed\", payload: resumedPayload()},\n+\t\t\t{typ: \"session.failed\", payload: failedPayload()},\n+\t\t}\n+\t\t_, headEvents, _ := buildChain(t, raw, head)\n+\t\tretry, _ := mustDecodeEvent(t, eventOptions{\n+\t\t\tsessionID:    record.SessionID,\n+\t\t\tpredecessors: []string{headEvents[len(headEvents)-1].ID},\n+\t\t\tepoch:        1,\n+\t\t\tleaseID:      testLeaseID,\n+\t\t\tsequence:     uint64(len(headEvents) + 1),\n+\t\t\teventType:    \"session.created\",\n+\t\t\tpayload:      createdPayload(record.RecordID),\n+\t\t})\n+\t\t_, err := Reduce(Input{Record: record, Events: append(headEvents, retry)})\n+\t\tmustErrorIs(t, err, ErrInvalidTransition, \"Reduce(retry under new lease)\")\n+\t})\n"}}}
