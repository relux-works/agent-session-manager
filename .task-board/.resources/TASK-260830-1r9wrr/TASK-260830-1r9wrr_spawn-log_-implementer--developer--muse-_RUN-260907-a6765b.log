{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d051","stream":{"kind":"session","id":"01a07d5e-0f16-71a3-abaf-54c2f5d26492"},"sequence":1667,"recorded_at":1780531400003329,"record_type":"event","durability":"durable","causation_id":"e2cea5ab-c4ff-4757-bfdf-44257ee82bbf","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e2cea5ab-c4ff-4757-bfdf-44257ee82bbf","run_stream":{"kind":"run","id":"e2cea5ab-c4ff-4757-bfdf-44257ee82bbf"},"task_stream":{"kind":"task","id":"0eab4029-cb17-45fa-a457-33a8d0426be8"},"task_id":"0eab4029-cb17-45fa-a457-33a8d0426be8","event":{"kind":"output","task_id":"0eab4029-cb17-45fa-a457-33a8d0426be8","chunk":"edited\nchanged lines: lines 73-96\n--- original\n+++ updated\n@@\n-func TestWinnerResolutionTie(t *testing.T) {\n-\trecord := decodeTestRecord(t)\n-\tspecs := baseBootstrap(record)\n-\tunion := []LeaseHead{\n-\t\t{Epoch: 1, LeaseID: testLeaseIDB},\n-\t\t{Epoch: 1, LeaseID: testLeaseIDC},\n-\t}\n-\tprojection, err := reduceSpecs(t, record, specs, Input{Union: union})\n-\tif err != nil {\n-\t\tt.Fatalf(\"Reduce error = %v\", err)\n-\t}\n-\t// Bytewise: testLeaseIDC (\"cccccccc-...\") wins over B (\"bbbbbbbb-...\") and A.\n-\tif projection.Winner != (LeaseHead{Epoch: 1, LeaseID: testLeaseIDC}) {\n-\t\tt.Fatalf(\"winner = %+v, want epoch 1 lease C\", projection.Winner)\n-\t}\n-\tkinds := conflictKinds(projection)\n-\tif len(kinds) != 1 || kinds[0] != ConflictSameEpochTie {\n-\t\tt.Fatalf(\"conflicts = %v, want exactly [same_epoch_tie]\", kinds)\n-\t}\n-\tif projection.Conflicts[0].Rule != ResolveRuleGreatestLeaseIDWins {\n-\t\tt.Fatalf(\"rule = %q, want greatest-lease-id-wins\", projection.Conflicts[0].Rule)\n-\t}\n-\tassertWarning(t, projection, \"divergent_history\")\n-}\n+func TestWinnerResolutionTie(t *testing.T) {\n+\trecord := decodeTestRecord(t)\n+\tspecs := baseBootstrap(record)\n+\t// The rival shares epoch 1 with the chain lease but sorts below\n+\t// it, so the chain lease keeps the epoch while both the tie and\n+\t// the rival's losing branch are reported.\n+\tunion := []LeaseHead{{Epoch: 1, LeaseID: testLeaseIDR}}\n+\tprojection, err := reduceSpecs(t, record, specs, Input{Union: union})\n+\tif err != nil {\n+\t\tt.Fatalf(\"Reduce error = %v\", err)\n+\t}\n+\tif projection.Winner != (LeaseHead{Epoch: 1, LeaseID: testLeaseID}) {\n+\t\tt.Fatalf(\"winner = %+v, want epoch 1 chain lease\", projection.Winner)\n+\t}\n+\tkinds := conflictKinds(projection)\n+\tif len(kinds) != 2 || kinds[0] != ConflictLosingBranchPreserved || kinds[1] != ConflictSameEpochTie {\n+\t\tt.Fatalf(\"conflicts = %v, want [losing_branch_preserved same_epoch_tie]\", kinds)\n+\t}\n+\tfor _, conflict := range projection.Conflicts {\n+\t\tif conflict.Kind == ConflictSameEpochTie && conflict.Rule != ResolveRuleGreatestLeaseIDWins {\n+\t\t\tt.Fatalf(\"rule = %q, want greatest-lease-id-wins\", conflict.Rule)\n+\t\t}\n+\t}\n+\tassertWarning(t, projection, \"divergent_history\")\n+}\n"}}}
