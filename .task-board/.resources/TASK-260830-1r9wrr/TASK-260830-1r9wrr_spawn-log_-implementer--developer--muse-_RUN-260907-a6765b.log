41:\\tthird, _ := appendTestEvent(t, repository, testSessionID, []string{second.EventID}, 1, testLeaseID, 3, \\\"checkpoint.created\\\", checkpointPayload())\\ninternal/sessrepo/sessrepo_test.go:453:\\tevent := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{\\\"sha256:d61701066a7f5dd37bf35fea0e85e7f154251355ad24a49976532d7f79ddc772\\\"}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \\\"session.idle\\\", payload: idlePayload()})\\ninternal/sessrepo/sessrepo_test.go:532:\\tevent := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{\\\"sha256:d61701066a7f5dd37bf35fea0e85e7f154251355ad24a49976532d7f79ddc772\\\"}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \\\"session.idle\\\", payload: idlePayload()})\\ninternal/sessrepo/sessrepo_test.go:579:\\t\\t\\traw := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{reference.RecordID}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \\\"session.idle\\\", payload: idlePayload()})\\ninternal/sessrepo/sessrepo_test.go:595:\\traw := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{reference.RecordID}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \\\"session.idle\\\", payload: idlePayload()})\\n===\\n174:func createdPayload(recordID string) map[string]any {\\n178:func idlePayload() map[string]any {\\n182:func checkpointPayload() map[string]any {\\n316:\\tsecondRef, _ := appendTestEvent(t, second, testSessionID, []string{firstEvent.EventID}, 1, testLeaseID, 2, \\\"session.idle\\\", idlePayload())\\n340:\\tsecond, _ := appendTestEvent(t, repository, testSessionID, []string{first.EventID}, 1, testLeaseID, 2, \\\"session.idle\\\", idlePayload())\\n341:\\tthird, _ := appendTestEvent(t, repository, testSessionID, []string{second.EventID}, 1, testLeaseID, 3, \\\"checkpoint.created\\\", checkpointPayload())\\n453:\\tevent := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{\\\"sha256:d61701066a7f5dd37bf35fea0e85e7f154251355ad24a49976532d7f79ddc772\\\"}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \\\"session.idle\\\", payload: idlePayload()})\\n532:\\tevent := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{\\\"sha256:d61701066a7f5dd37bf35fea0e85e7f154251355ad24a49976532d7f79ddc772\\\"}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \\\"session.idle\\\", payload: idlePayload()})\\n579:\\t\\t\\traw := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{reference.RecordID}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \\\"session.idle\\\", payload: idlePayload()})\\n595:\\traw := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{reference.RecordID}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \\\"session.idle\\\", payload: idlePayload()})\\n607:\\tforeign := buildEvent(t, eventOptions{sessionID: testSessionIDB, predecessors: []string{\\\"sha256:d61701066a7f5dd37bf35fea0e85e7f154251355ad24a49976532d7f79ddc772\\\"}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \\\"session.idle\\\", payload: idlePayload()})\\n617:\\t\\tskipped := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{first.EventID}, epoch: 1, leaseID: testLeaseID, sequence: 3, eventType: \\\"session.idle\\\", payload: idlePayload()})\\n632:\\t\\tnext := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{first.EventID}, epoch: 2, leaseID: testLeaseIDB, sequence: 2, eventType: \\\"session.idle\\\", payload: idlePayload()})\\n653:\\trepeat := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{reference.RecordID}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \\\"session.idle\\\", payload: idlePayload()})\\n656:\\tsecond, _ := appendTestEvent(t, repository, testSessionID, []string{first.EventID}, 1, testLeaseID, 2, \\\"session.idle\\\", idlePayload())\\n657:\