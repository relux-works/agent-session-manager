{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000df7d","stream":{"kind":"session","id":"01a07d5e-0f16-71a3-abaf-54c2f5d26492"},"sequence":3609,"recorded_at":1780531400007213,"record_type":"event","durability":"durable","causation_id":"e2cea5ab-c4ff-4757-bfdf-44257ee82bbf","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e2cea5ab-c4ff-4757-bfdf-44257ee82bbf","run_stream":{"kind":"run","id":"e2cea5ab-c4ff-4757-bfdf-44257ee82bbf"},"task_stream":{"kind":"task","id":"f65bdd65-794d-4e5e-a72a-8d53e72fa582"},"task_id":"f65bdd65-794d-4e5e-a72a-8d53e72fa582","event":{"kind":"output","task_id":"f65bdd65-794d-4e5e-a72a-8d53e72fa582","chunk":"edited\nchanged lines: lines 16-44\n--- original\n+++ updated\n@@\n-// DecodeRecord validates recordJSON through the three owned layers in\n-// order — strict frame (environ), canonical identity and closed shape\n-// (canonicaljson), member grammars (scalar, environ) — and projects\n-// the members the reducer reads. Each layer refuses before the next\n-// runs.\n-func DecodeRecord(recordJSON []byte) (Record, error) {\n-\tmembers, fault := environ.DecodeStrictObject(recordJSON)\n-\tif fault != nil {\n-\t\treturn Record{}, refuse(ErrInvalidRecord, \"decode session record frame: %v\", fault)\n-\t}\n-\tschema, err := stringMember(members, \"schema\")\n-\tif err != nil || schema != sessionRecordSchema {\n-\t\treturn Record{}, refuse(ErrInvalidRecord, \"session record schema %q, want %q\", schema, sessionRecordSchema)\n-\t}\n-\tsessionID, ok := environ.CheckUUIDv7(members[\"session_id\"])\n-\tif !ok {\n-\t\treturn Record{}, refuse(ErrInvalidRecord, \"session record carries no valid session_id member\")\n-\t}\n-\tdigest, field, err := canonicaljson.VerifyObjectIdentity(recordJSON)\n-\tif err != nil {\n-\t\treturn Record{}, refuse(ErrInvalidRecord, \"verify session record identity: %v\", err)\n-\t}\n-\tif field != canonicaljson.SelfRecordID {\n-\t\t// Unreachable through the schema gate above: the canonical\n-\t\t// owner selects the self field from the admitted schema, so a\n-\t\t// session-record envelope always reports record_id. The plain\n-\t\t// error keeps the refusal funnel for reachable arms only.\n-\t\treturn Record{}, fmt.Errorf(\"session record identity field %q, want record_id\", string(field))\n-\t}\n+// DecodeRecord projects the reducer's record members from recordJSON:\n+// strict frame (environ) then member grammars (scalar, environ). It\n+// deliberately does not attest canonical identity: attestation is\n+// owned by internal/sessrepo at the durable boundary (and pinned\n+// there by the provhost no-attestation-outside-the-leaf gate), so a\n+// second Verify here would fork the attestation owner. Production\n+// bytes always arrive attested through the repository entries; the\n+// digest below is the grammar-checked self member of those bytes,\n+// never a recomputation.\n+func DecodeRecord(recordJSON []byte) (Record, error) {\n+\tmembers, fault := environ.DecodeStrictObject(recordJSON)\n+\tif fault != nil {\n+\t\treturn Record{}, refuse(ErrInvalidRecord, \"decode session record frame: %v\", fault)\n+\t}\n+\tschema, err := stringMember(members, \"schema\")\n+\tif err != nil || schema != sessionRecordSchema {\n+\t\treturn Record{}, refuse(ErrInvalidRecord, \"session record schema %q, want %q\", schema, sessionRecordSchema)\n+\t}\n+\tsessionID, ok := environ.CheckUUIDv7(members[\"session_id\"])\n+\tif !ok {\n+\t\treturn Record{}, refuse(ErrInvalidRecord, \"session record carries no valid session_id member\")\n+\t}\n+\trecordID, err := stringMember(members, \"record_id\")\n+\tif err != nil {\n+\t\treturn Record{}, refuse(ErrInvalidRecord, \"session record carries no record_id member\")\n+\t}\n+\tif _, err := scalar.ParseDigest(recordID); err != nil {\n+\t\treturn Record{}, refuse(ErrInvalidRecord, \"session record record_id: %v\", err)\n+\t}\n"}}}
