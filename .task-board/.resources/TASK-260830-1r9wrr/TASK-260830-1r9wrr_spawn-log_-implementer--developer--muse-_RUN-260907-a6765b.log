n82-// behaviorally in the owning leaf by\\n83-// TestLoadRefusesProviderIdentityBlobAtEventPath and\\n84-// TestLoadRefusesSwappedEventBlobs: the first revision stated a schema\\n85-// gate in front of every Verify call, which the load site never had.\\n86-// The allowlist below names the owning directory by its full\\n87-// module-relative path and pins the exact site count, so a stale\\n88-// exception or a foreign directory with the same leaf name fails\\n89-// instead of lingering; it still reddens for any other tree. The scan\\n90-// is AST-based (comments and test files never count) and fails closed\\n91-// when it sees nothing.\\n92-// Stated bound on this test: only *ast.CallExpr nodes are inspected, so a\\n93-// `f := pkg.VerifyObjectIdentity; f(x)` binding would not be seen; no such\\n94-// shape exists today.\\n95:func TestNoProductionPathAttestsProviderIdentityBinding(t *testing.T) {\\n96-\\t_, self, _, ok := runtime.Caller(0)\\n97-\\tif !ok {\\n98-\\t\\tt.Fatal(\\\"runtime.Caller cannot locate the test file\\\")\\n99-\\t}\\n100-\\troot := filepath.Dir(self)\\n101-\\tfor {\\n102-\\t\\tif _, err := os.Stat(filepath.Join(root, \\\"go.mod\\\")); err == nil {\\n103-\\t\\t\\tbreak\\n104-\\t\\t}\\n105-\\t\\tparent := filepath.Dir(root)\\n106-\\t\\tif parent == root {\\n107-\\t\\t\\tt.Fatal(\\\"no module root above the test file; the scan is blind\\\")\\n108-\\t\\t}\\n109-\\t\\troot = parent\\n110-\\t}\\n111-\\tallowed, callers, scanned, parsed := scanAttestationSites(t, root)\\n112-\\tif scanned == 0 {\\n113-\\t\\tt.Fatal(\\\"scanned no production sources; the check is blind\\\")\\n114-\\t}\\n115-\\tif len(allowed) != 3 {\\n116-\\t\\tt.Fatalf(\\\"session-leaf attestation sites = %d, want exactly 3 (decodeSessionRecord, decodeSessionEvent, loadSessionLocked): a moved call site must rewrite the bound, a new one must justify itself, a stale exception must go\\\", len(allowed))\\n117-\\t}\\n118-\\tif len(callers) != 0 {\\n119-\\t\\tt.Fatalf(\\\"production call sites outside the session leaf attest the identity binding, contradicting the stated bound:\\\\n  %s\\\", strings.Join(callers, \\\"\\\\n  \\\"))\\n120-\\t}\\n121-\\tt.Logf(\\\"attestation scan: %d production files, %d parsed, %d session-leaf call sites, 0 elsewhere\\\", scanned, parsed, len(allowed))\\n122-}\\n123-\\n124-// isSessrepoLeafFile reports whether a scan path sits inside the owning\\n125-// session-persistence directory: <root>/internal/sessrepo/. The match\\n126-// anchors on the full module-relative owning path, never on a bare\\n127-// segment, so internal/provhost/sessrepo/plant.go (same leaf name,\\n128-// foreign owner) and internal/xsessrepo/plant.go (near-miss name) both\\n129-// land outside the allowlist while the leaf's own files stay admitted.\\n130-func isSessrepoLeafFile(root, path string) bool {\\n131-\\tleaf := filepath.Join(root, \\\"internal\\\", \\\"sessrepo\\\") + string(filepath.Separator)\\n132-\\treturn strings.HasPrefix(path, leaf)\\n133-}\\n134-\\n135-// scanAttestationSites walks the production trees beneath root and\\n136-// classifies every VerifyObjectIdentity call: inside the owning leaf it\\n137-// is allowlisted, anywhere else it contradicts the bound. It returns\\n138-// the allowlisted entries, the contradicting entries, and the scanned\\n139-// and parsed file counts.\\n140-func scanAttestationSites(t *testing.T, root string) (allowed, callers []string, scanned, parsed int) {\\n141-\\tt.Helper()\\n142-\\tfor _, tree := range []string{\\\"internal\\\", \\\"cmd\\\"} {\\n143-\\t\\tbase := filepath.Join(root, tree)\\n144-\\t\\tif _, err := os.Stat(base); err != nil {\\n145-\\t\\t\\tcontinue\\n146-\\t\\t}\\n147-\\t\\t// Recursion stays local: the core selects single-package\\n148-\\t\\t// production files, while this attestation spans trees.\\n149-\\t\\t// Fail-closed parsing is the core's.\\n150-\\t\\tif err := filepath.Walk(base, func(path string, info os.FileInfo, err error) error {\\n151-\\t\\t\\tif err != nil || info.IsDir() || !strings.HasSuffix(path, \\\".go\\\") || strings.HasSuffix(path, \\\"_test.go\\\") {\\n152-\\t\\t\\t\\treturn err\\n153-\\t\\t\\t}\\n154-\\t\\t\\tscanned++\\n155-\\t\\t\\tsource, err := os.ReadFile(path)\\n\",\n  \"original_output_bytes\": 4915,\n  \"original_output_tokens\": 1229,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
