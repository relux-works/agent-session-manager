{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c81b","stream":{"kind":"session","id":"01a0d381-286a-7d03-bf7e-13c4c16a42b5"},"sequence":616,"recorded_at":1780531400001227,"record_type":"event","durability":"durable","causation_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","run_stream":{"kind":"run","id":"4603a868-01f4-4025-8e84-c5ce1f2882d9"},"call_id":"call_01a0d385e5167460a43ec2f50e95412e","text":"Read text file `internal/clonefidelity/decode.go`.\n(182 line(s) above)\n183|func validText(value string) bool {\n184|\treturn utf8.ValidString(value)\n185|}\n186|\n187|// checkExtensionsClosed enforces the full closed extensions rule via\n188|// the clonebundle owner: reverse-DNS keys and values inside the AX\n189|// common logical data model. It returns nil when the member is\n190|// closed, otherwise the refusal detail naming the failed rule.\n191|func checkExtensionsClosed(raw json.RawMessage) error {\n192|\treturn clonebundle.CheckExtensionsClosed(raw)\n193|}\n194|\n195|// canonicalizeObject renders one closed object deterministically:\n196|// the members marshal in any order and the JCS transform sorts\n197|// them, so identical logical inputs always produce identical bytes.\n198|func canonicalizeObject(object map[string]any) ([]byte, error) {\n199|\tplain, err := json.Marshal(object)\n200|\tif err != nil {\n201|\t\treturn nil, invalid(\"serialize fidelity object: %v\", err)\n202|\t}\n203|\tcanonical, err := canonicaljson.Canonicalize(plain)\n204|\tif err != nil {\n205|\t\treturn nil, invalid(\"canonicalize fidelity object: %v\", err)\n206|\t}\n207|\treturn canonical, nil\n208|}\n209|\n210|// verifySelfDigest recomputes the omit-self identity through the\n211|// clonebundle owner and refuses a mismatch against the claimed self\n212|// digest.\n213|func verifySelfDigest(members map[string]json.RawMessage, selfField string, claimed scalar.Digest) error {\n214|\tcalculated, err := clonebundle.OmitSelfDigest(members, selfField)\n215|\tif err != nil {\n216|\t\treturn err\n217|\t}\n218|\tif calculated != claimed {\n219|\t\treturn invalid(\"%s claim %q does not match omit-self digest %q\", selfField, claimed.String(), calculated.String())\n220|\t}\n221|\treturn nil\n222|}\n223|\n224|// checkSortedUniqueReasonStrings reports whether the caller-supplied\n225|// Build input is sorted unique ValidReasonCode strings in the item\n226|// bound. It mirrors checkReasonCodes for Go inputs: UTF-8 first (so\n227|// nothing seals rewritten), then character bounds, then order, then\n228|// vocabulary.\n229|func checkSortedUniqueReasonStrings(values []string, minimumCount, maximumCount int, owner string) ([]string, error) {\n230|\tif len(values) < minimumCount || len(values) > maximumCount {\n231|\t\treturn nil, invalid(\"%s carries %d reason_codes, want [%d..%d]\", owner, len(values), minimumCount, maximumCount)\n232|\t}\n233|\tprevious := \"\"\n234|\tfor index, reason := range values {\n235|\t\tif !validText(reason) {\n236|\t\t\treturn nil, invalid(\"%s reason_codes[%d] is not valid UTF-8\", owner, index)\n237|\t\t}\n238|\t\tif length := stringLength(reason); length < 1 || length > 128 {\n239|\t\t\treturn nil, invalid(\"%s reason_codes[%d] is not a string[1..128]\", owner, index)\n240|\t\t}\n241|\t\tif !ValidReasonCode(reason) {\n242|\t\t\treturn nil, invalid(\"%s reason_codes[%d] %q is outside the core and reverse-DNS reason vocabulary\", owner, index, reason)\n243|\t\t}\n244|\t\tif index > 0 && reason <= previous {\n245|\t\t\treturn nil, invalid(\"%s reason_codes are not sorted unique\", owner)\n246|\t\t}\n247|\t\tprevious = reason\n248|\t}\n249|\treturn values, nil\n250|}\n251|\n252|// checkSortedUniqueBoundedStrings reports whether the\n253|// caller-supplied Build input is sorted unique strings in the\n254|// character and count bounds. Ordering and measure delegate to the\n255|// same rules the environ JSON gate enforces.\n256|func checkSortedUniqueBoundedStrings(values []string, minimumLength, maximumLength int, minimumCount, maximumCount int, owner, member string) ([]string, error) {\n257|\tif len(values) < minimumCount || len(values) > maximumCount {\n258|\t\treturn nil, invalid(\"%s carries %d %s, want [%d..%d]\", owner, len(values), member, minimumCount, maximumCount)\n259|\t}\n260|\tprevious := \"\"\n261|\tfor index, value := range values {\n262|\t\tif !validText(value) {\n263|\t\t\treturn nil, invalid(\"%s %s[%d] is not valid UTF-8\", owner, member, index)\n264|\t\t}\n265|\t\tif length := stringLength(value); length < minimumLength || length > maximumLength {\n266|\t\t\treturn nil, invalid(\"%s %s[%d] is not a string[%d..%d]\", owner, member, index, minimumLength, maximumLength)\n267|\t\t}\n268|\t\tif index > 0 && value <= previous {\n269|\t\t\treturn nil, invalid(\"%s %s are not sorted unique\", owner, member)\n270|\t\t}\n271|\t\tprevious = value\n272|\t}\n273|\treturn values, nil\n274|}\n275|\n276|// parseSortedUniqueDigestStrings reports whether the\n277|// caller-supplied Build input is sorted unique digests in the count\n278|// bound.\n279|func parseSortedUniqueDigestStrings(values []string, minimum, maximum int, owner, member string) ([]scalar.Digest, error) {\n280|\tif len(values) < minimum || len(values) > maximum {\n281|\t\treturn nil, invalid(\"%s carries %d %s, want [%d..%d]\", owner, len(values), member, minimum, maximum)\n282|\t}\n283|\tids := make([]scalar.Digest, 0, len(values))\n284|\tprevious := \"\"\n285|\tfor index, value := range values {\n286|\t\tid, err := scalar.ParseDigest(value)\n287|\t\tif err != nil {\n288|\t\t\treturn nil, invalid(\"%s %s[%d] is not a digest: %v\", owner, member, index, err)\n289|\t\t}\n290|\t\tif index > 0 && id.String() <= previous {\n291|\t\t\treturn nil, invalid(\"%s %s are not sorted unique\", owner, member)\n292|\t\t}\n293|\t\tprevious = id.String()\n294|\t\tids = append(ids, id)\n295|\t}\n296|\treturn ids, nil\n297|}\n298|\n299|func digestStrings(ids []scalar.Digest) []any {\n300|\tout := make([]any, 0, len(ids))\n301|\tfor _, id := range ids {\n302|\t\tout = append(out, id.String())\n303|\t}\n304|\treturn out\n305|}\n306|\n307|func stringValues(values []string) []any {\n308|\tout := make([]any, 0, len(values))\n309|\tfor _, value := range values {\n310|\t\tout = append(out, value)\n311|\t}\n312|\treturn out\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
