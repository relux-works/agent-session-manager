|// through the plan-profile gate.\n78|func SelectProfile(requested string) (Branch, string, error) {\n79|\tif !validText(requested) {\n80|\t\treturn \"\", \"\", invalid(\"projection profile is not valid UTF-8\")\n81|\t}\n82|\tif requested == profileArchive {\n83|\t\treturn BranchArchive, requested, nil\n84|\t}\n85|\tif !cloneplan.ValidPlanProfile(requested) {\n86|\t\treturn \"\", \"\", invalid(\"projection profile %q is outside strict_exact|maximal_safe|compact|messages_only|archive_only\", requested)\n87|\t}\n88|\treturn BranchTarget, requested, nil\n89|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
