 update TASK-260311-abc https://example.com/report.json --type outcome\\n\\nUsage:\\n  task-board resource update <ELEMENT-ID> <SOURCE> [flags]\\n\\nFlags:\\n  -d, --description string   Optional one-line description\\n  -h, --help                 help for update\\n      --name string          Override stored resource filename\\n      --type string          Resource type: precondition or outcome (default \\\"outcome\\\")\\n\\n\",\n  \"original_output_bytes\": 1494,\n  \"original_output_tokens\": 374,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
