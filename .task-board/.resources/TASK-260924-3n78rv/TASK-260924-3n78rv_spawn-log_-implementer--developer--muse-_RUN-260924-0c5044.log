{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c62b","stream":{"kind":"session","id":"01a0d381-286a-7d03-bf7e-13c4c16a42b5"},"sequence":368,"recorded_at":1780531400000731,"record_type":"event","durability":"durable","causation_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","run_stream":{"kind":"run","id":"4603a868-01f4-4025-8e84-c5ce1f2882d9"},"task_stream":{"kind":"task","id":"01a0d382-125e-76c2-af10-2c8f6aaf5f30"},"task_id":"01a0d382-125e-76c2-af10-2c8f6aaf5f30","event":{"kind":"output","task_id":"01a0d382-125e-76c2-af10-2c8f6aaf5f30","chunk":"Read text file `internal/cloneplanning/plan.go`.\n1|package cloneplanning\n2|\n3|import (\n4|\t\"sort\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/clonefidelity\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/cloneproject\"\n8|)\n9|\n10|// This file plans per-item expected dispositions with reason sets\n11|// and folds planned sessions to predicted counts. The strategy arm\n12|// decides the base mapping, the profile overlay refines it, and\n13|// reasons compose as sorted sets. The planner never emits\n14|// synthesized (synthesized rows have no source object) or\n15|// unrecoverable (planned canonical items exist), and never plans\n16|// the archive branch. Disposition and reason spellings quote the\n17|// internal/clonefidelity owner; the agreement test pins the quote.\n18|\n19|// Mapping is one planned item: its expected disposition and sorted\n20|// reason set. Exact mappings carry no reason.\n21|type Mapping struct {\n22|\tDisposition string\n23|\tReasons     []string\n24|}\n25|\n26|// Disposition spellings, quoted from the internal/clonefidelity\n27|// owner.\n28|const (\n29|\tdispositionExact           = \"exact\"\n30|\tdispositionSemantic        = \"semantic\"\n31|\tdispositionSummarized      = \"summarized\"\n32|\tdispositionOpaquePreserved = \"opaque_preserved\"\n33|\tdispositionOmitted         = \"omitted\"\n34|)\n35|\n36|// Reason spellings, quoted from the internal/clonefidelity owner.\n37|const (\n38|\treasonTargetNoEquivalent   = \"target_no_equivalent\"\n39|\treasonForeignEncrypted     = \"foreign_encrypted_payload\"\n40|\treasonForeignSigned        = \"foreign_signature_unverifiable\"\n41|\treasonOfficialImporterLoss = \"official_importer_loss\"\n42|\treasonGraphFlattened       = \"graph_flattened\"\n43|\treasonUnsafePending        = \"unsafe_pending_action\"\n44|\treasonOperatorPolicy       = \"operator_policy\"\n45|\treasonUnsupportedMedia     = \"unsupported_media_type\"\n46|\treasonUnknownNative        = \"unknown_native_event\"\n47|\treasonTargetContextLimit   = \"target_context_limit\"\n48|)\n49|\n50|// Profile spellings, quoted from the internal/clonefidelity owner.\n51|const (\n52|\tprofileStrictExact = \"strict_exact\"\n53|\tprofileMaximalSafe = \"maximal_safe\"\n54|\tprofileCompact     = \"compact\"\n55|\tprofileMessages    = \"messages_only\"\n56|)\n57|\n58|// completeToolKinds degrade under the vendor importer: the\n59|// importer's native tool history is lossy.\n60|var completeToolKinds = map[string]bool{\n61|\t\"tool_call\":                true,\n62|\t\"tool_result\":              true,\n63|\t\"tool_definition_snapshot\": true,\n64|}\n65|\n66|// subagentKinds flatten under the vendor importer: the subagent\n67|// graph does not survive official import.\n68|var subagentKinds = map[string]bool{\n69|\t\"subagent_started\":   true,\n70|\t\"subagent_completed\": true,\n71|}\n72|\n73|// messageKinds survive messages_only at the event level.\n74|var messageKinds = map[string]bool{\n75|\t\"user_message\":      true,\n76|\t\"assistant_message\": true,\n77|}\n78|\n79|// messageBlocks survive messages_only at the block level:\n80|// text and structured message content plus the redaction marker,\n81|// which preserves the redaction exactly.\n82|var messageBlocks = map[string]bool{\n83|\t\"text\":     true,\n84|\t\"json\":     true,\n85|\t\"redacted\": true,\n86|}\n87|\n88|// mediaBlocks are message content the messages_only profile cannot\n89|// carry: the target shows text messages, not media.\n90|var mediaBlocks = map[string]bool{\n91|\t\"image\":         true,\n92|\t\"audio\":         true,\n93|\t\"document\":      true,\n94|\t\"resource_link\": true,\n95|}\n96|\n97|// maxSessionItems bounds one planned session: the Projection Plan\n98|// 1.0.0 table carries item_mappings[1..1000000].\n99|const maxSessionItems = 1000000\n100|\n101|// PlanItem plans one item's expected disposition with its reason\n102|// set under the strategy and profile. Unknown strategies,\n103|// profiles, or item classes refuse; the archive strategy or\n104|// profile refuses (archive carries no plan); strict_exact refuses\n105|// every non-exact item.\n106|func PlanItem(strategy, profile string, item Item) (Mapping, error) {\n107|\tif !validText(strategy) {\n108|\t\treturn Mapping{}, invalid(\"projection strategy is not valid UTF-8\")\n109|\t}\n110|\tif !clonefidelity.ValidStrategy(strategy) {\n111|\t\treturn Mapping{}, invalid(\"projection strategy %q is outside the Section 13.14.2 vocabulary\", strategy)\n112|\t}\n113|\tif strategy == strategyArchive || profile == profileArchive {\n114|\t\treturn Mapping{}, invalid(\"projection strategy %q with profile %q names the archive branch, which carries no plan\", strategy, profile)\n115|\t}\n116|\tif !validText(profile) {\n117|\t\treturn Mapping{}, invalid(\"projection profile is not valid UTF-8\")\n118|\t}\n119|\tif err := requireValidItemText(item); err != nil {\n120|\t\treturn Mapping{}, err\n121|\t}\n122|\tif err := checkItem(item); err != nil {\n123|\t\treturn Mapping{}, err\n124|\t}\n125|\tdisposition, reasons := baseMapping(strategy, item)\n126|\tdisposition, reasons, err := applyProfile(profile, item, disposition, reasons)\n127|\tif err != nil {\n128|\t\treturn Mapping{}, err\n129|\t}\n130|\tsorted := append([]string(nil), reasons...)\n131|\tsort.Strings(sorted)\n132|\treturn Mapping{Disposition: disposition, Reasons: sorted}, nil\n133|}\n134|\n135|// baseMapping decides the strategy arm: class rules first (opaque\n136|// and aborted history are strategy-independent), then the\n137|// continuation clamp, then the vendor importer degradations, then\n138|// the native exact default.\n139|func baseMapping(strategy string, item Item) (string, []string) {\n140|\tif item.Kind == \"opaque_reasoning\" {\n141|\t\tif item.Protection == protectionSigned {\n142|\t\t\treturn dispositionOpaquePreserved, []string{reasonForeignSigned}\n143|\t\t}\n144|\t\treturn dispositionOpaquePreserved, []string{reasonForeignEncrypted}\n145|\t}\n146|\tif item.Kind == \"opaque_event\" || item.Block == \"opaque\" {\n147|\t\treturn dispositionOpaquePreserved, []string{reasonUnknownNative}\n148|\t}\n149|\tif (item.Kind == \"tool_call\" || item.Kind == \"tool_result\") && item.Resolution == cloneproject.StatusAborted {\n150|\t\treturn dispositionSummarized, []string{reasonUnsafePending}\n151|\t}\n152|\tif strategy == strategyContinuation {\n153|\t\treturn dispositionSemantic, []string{reasonTargetNoEquivalent}\n154|\t}\n155|\tif strategy == strategyOfficial {\n156|\t\tif completeToolKinds[item.Kind] {\n157|\t\t\treturn dispositionSemantic, []string{reasonOfficialImporterLoss}\n158|\t\t}\n159|\t\tif subagentKinds[item.Kind] {\n160|\t\t\treturn dispositionSemantic, []string{reasonGraphFlattened}\n161|\t\t}\n162|\t}\n163|\treturn dispositionExact, nil\n164|}\n165|\n166|// applyProfile refines the strategy mapping under the profile:\n167|// strict_exact refuses non-exact, compact clamps semantic to\n168|// summarized, messages_only omits non-message classes (keeping and\n169|// extending the reason set), and maximal_safe passes through.\n170|func applyProfile(profile string, item Item, disposition string, reasons []string) (string, []string, error) {\n171|\tswitch profile {\n172|\tcase profileStrictExact:\n173|\t\tif disposition != dispositionExact {\n174|\t\t\treturn \"\", nil, invalid(\"projection profile strict_exact refuses %s with disposition %q\", describeItem(item), disposition)\n175|\t\t}\n176|\t\treturn disposition, reasons, nil\n177|\tcase profileCompact:\n178|\t\tif disposition == dispositionSemantic {\n179|\t\t\treturn dispositionSummarized, append(append([]string(nil), reasons...), reasonTargetContextLimit), nil\n180|\t\t}\n181|\t\treturn disposition, reasons, nil\n182|\tcase profileMessages:\n183|\t\tif isMessageClass(item) {\n184|\t\t\treturn disposition, reasons, nil\n185|\t\t}\n186|\t\tomitted := append(append([]string(nil), reasons...), reasonOperatorPolicy)\n187|\t\tif mediaBlocks[item.Block] {\n188|\t\t\tomitted = append(omitted, reasonUnsupportedMedia)\n189|\t\t}\n190|\t\treturn dispositionOmitted, omitted, nil\n191|\tcase profileMaximalSafe:\n192|\t\treturn disposition, reasons, nil\n193|\tdefault:\n194|\t\treturn \"\", nil, invalid(\"projection profile %q is not a target plan profile\", profile)\n195|\t}\n196|}\n197|\n198|// isMessageClass reports whether the item survives messages_only:\n199|// user/assistant message events and text/structured/redacted\n200|// blocks.\n201|func isMessageClass(item Item) bool {\n202|\tif item.Kind != \"\" {\n203|\t\treturn messageKinds[item.Kind]\n204|\t}\n205|\treturn messageBlocks[item.Block]\n206|}\n207|\n208|// describeItem names the item class for refusals.\n209|func describeItem(item Item) string {\n210|\tif item.Kind != \"\" {\n211|\t\treturn \"kind \" + item.Kind\n212|\t}\n213|\treturn \"block \" + item.Block\n214|}\n215|\n216|// PlanSession plans every item in order and folds the predicted\n217|// counts. Sessions are non-empty and bounded by the plan table's\n218|// item_mappings[1..1000000]; the first refusing item refuses the\n219|// session. Counts derive from the mappings, never accepted.\n220|func PlanSession(strategy, profile string, items []Item) ([]Mapping, clonefidelity.FidelityCounts, error) {\n221|\tif len(items) == 0 || len(items) > maxSessionItems {\n222|\t\treturn nil, clonefidelity.FidelityCounts{}, invalid(\"projection session carries %d items, the plan table requires item_mappings[1..1000000]\", len(items))\n223|\t}\n224|\tif !validText(strategy) {\n225|\t\treturn nil, clonefidelity.FidelityCounts{}, invalid(\"projection session strategy is not valid UTF-8\")\n226|\t}\n227|\tif !validText(profile) {\n228|\t\treturn nil, clonefidelity.FidelityCounts{}, invalid(\"projection session profile is not valid UTF-8\")\n229|\t}\n230|\tmappings := make([]Mapping, 0, len(items))\n231|\tvar counts clonefidelity.FidelityCounts\n232|\tfor _, item := range items {\n233|\t\tmapping, err := PlanItem(strategy, profile, item)\n234|\t\tif err != nil {\n235|\t\t\treturn nil, clonefidelity.FidelityCounts{}, err\n236|\t\t}\n237|\t\tmappings = append(mappings, mapping)\n238|\t\tswitch mapping.Disposition {\n239|\t\tcase dispositionExact:\n240|\t\t\tcounts.Exact++\n241|\t\tcase dispositionSemantic:\n242|\t\t\tcounts.Semantic++\n243|\t\tcase dispositionSummarized:\n244|\t\t\tcounts.Summarized++\n245|\t\tcase dispositionOpaquePreserved:\n246|\t\t\tcounts.OpaquePreserved++\n247|\t\tcase dispositionOmitted:\n248|\t\t\tcounts.Omitted++\n249|\t\tdefault:\n250|\t\t\treturn nil, clonefidelity.FidelityCounts{}, invalid(\"projection session planned unexpected disposition %q\", mapping.Disposition)\n251|\t\t}\n252|\t}\n253|\treturn mappings, counts, nil\n254|}","final_result":true}}}
