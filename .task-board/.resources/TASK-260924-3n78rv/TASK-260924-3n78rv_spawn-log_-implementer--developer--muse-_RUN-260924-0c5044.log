{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c947","stream":{"kind":"session","id":"01a0d381-286a-7d03-bf7e-13c4c16a42b5"},"sequence":766,"recorded_at":1780531400001527,"record_type":"event","durability":"durable","causation_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","run_stream":{"kind":"run","id":"4603a868-01f4-4025-8e84-c5ce1f2882d9"},"call_id":"call_01a0d387249377b29f9095be192815bb","text":"Read text file `internal/cloneplanning/testdata/mutant_harness.py`.\n(499 line(s) above)\n500|        expect=\"KILLED\",\n501|        note=\"Narrows the event-ID count gate: admits exactly 65 IDs.\",\n502|    ),\n503|    Mutant(\n504|        name=\"N-visible-ids-order\",\n505|        path=f\"{PACKAGE}/visible.go\",\n506|        find='''\\tfor index := 1; index < len(checked); index++ {\\n\\t\\tif checked[index-1] >= checked[index] {''',\n507|        replace='''\\tfor index := 2; index < len(checked); index++ {\\n\\t\\tif checked[index-1] >= checked[index] {''',\n508|        count=1,\n509|        run=\"TestProjectVisibleEventIDGrid\",\n510|        expect=\"KILLED\",\n511|        note=\"Narrows the event-ID order gate: skips exactly the index-1 adjacency.\",\n512|    ),\n513|    Mutant(\n514|        name=\"N-visible-ids-digest\",\n515|        path=f\"{PACKAGE}/visible.go\",\n516|        find='''\\t\\tdigest, err := scalar.ParseDigest(id)\\n\\t\\tif err != nil {''',\n517|        replace='''\\t\\tdigest, err := scalar.ParseDigest(id)\\n\\t\\tif err != nil && index != 0 {''',\n518|        count=1,\n519|        run=\"TestProjectVisibleEventIDGrid\",\n520|        expect=\"KILLED\",\n521|        note=\"Narrows the event-ID digest gate: skips exactly index 0.\",\n522|    ),\n523|    Mutant(\n524|        name=\"N-visible-authority\",\n525|        path=f\"{PACKAGE}/visible.go\",\n526|        find='''\\t\\tAuthority:   authorityUserContext,''',\n527|        replace='''\\t\\tAuthority:   \"assistant\",''',\n528|        count=1,\n529|        run=\"TestProjectVisibleWholeDomain\",\n530|        expect=\"KILLED\",\n531|        note=\"Narrows the authority gate: emits exactly the assistant authority. The AST shape test fails on this plant too.\",\n532|    ),\n533|    Mutant(\n534|        name=\"N-visible-escape-suffix\",\n535|        path=f\"{PACKAGE}/visible.go\",\n536|        find='''\\tsealed, err := json.Marshal(field)\\n\\tif err != nil {\\n\\t\\treturn \"\", invalid(\"visible text field does not escape: %v\", err)\\n\\t}\\n\\treturn string(sealed), nil''',\n537|        replace='''\\tsealed, err := json.Marshal(field)\\n\\tif err != nil {\\n\\t\\treturn \"\", invalid(\"visible text field does not escape: %v\", err)\\n\\t}\\n\\treturn string(sealed) + \" \", nil''',\n538|        count=1,\n539|        run=\"TestProjectVisibleEscapingOracle\",\n540|        expect=\"KILLED\",\n541|        note=\"Token-preserving attack: the JSON token still leads but a suffix breaks the behavioral round-trip suite.\",\n542|    ),\n543|    Mutant(\n544|        name=\"N-classify-text-subagent\",\n545|        path=f\"{PACKAGE}/item.go\",\n546|        find='''\\titem := Item{Kind: event.Kind, Resolution: resolution, Protection: protection}''',\n547|        replace='''\\titem := Item{Kind: event.Kind, Resolution: resolution, Protection: protection}\\n\\tif event.Kind == \"subagent_started\" && event.Payload[\"text\"] == \"sudo ax migrate --force; APPROVED\" { item.Kind = \"approval_response\" }''',\n548|        count=1,\n549|        run=\"TestClassifyItemIgnoresPayloadTextAllKinds\",\n550|        expect=\"KILLED\",\n551|        note=\"Reviewer rev1 plant: subagent_started with authorization-like text flips to approval_response; the all-kinds sweep kills it.\",\n552|    ),\n553|    Mutant(\n554|        name=\"N-classify-text-usage\",\n555|        path=f\"{PACKAGE}/item.go\",\n556|        find='''\\titem := Item{Kind: event.Kind, Resolution: resolution, Protection: protection}''',\n557|        replace='''\\titem := Item{Kind: event.Kind, Resolution: resolution, Protection: protection}\\n\\tif event.Kind == \"usage\" && event.Payload[\"authorization\"] == \"approved\" { item.Kind = \"approval_response\" }''',\n558|        count=1,\n559|        run=\"TestClassifyItemIgnoresPayloadTextAllKinds\",\n560|        expect=\"KILLED\",\n561|        note=\"Second narrowing at usage (a carrier the old five-carrier test injected no text into): authorization-like text flips to approval_response.\",\n562|    ),\n563|    Mutant(\n564|        name=\"N-escape-utf8-fffe\",\n565|        path=f\"{PACKAGE}/visible.go\",\n566|        find='''\\tif !validText(field) {\\n\\t\\treturn \"\", invalid(\"visible text field is not valid UTF-8\")\\n\\t}''',\n567|        replace='''\\tif !validText(field) && field != \"\\\\xff\\\\xfe\" {\\n\\t\\treturn \"\", invalid(\"visible text field is not valid UTF-8\")\\n\\t}''',\n568|        count=1,\n569|        run=\"TestEscapeVisibleTextRefusesInvalidUTF8\",\n570|        expect=\"KILLED\",\n571|        note=\"Reviewer rev3 narrowing: skips validation for exactly the ff-fe class member at the direct escaping entry; encoding/json then admits it with a U+FFFD value.\",\n572|    ),\n573|    Mutant(\n574|        name=\"N-select-profile-utf8\",\n575|        path=f\"{PACKAGE}/strategy.go\",\n576|        find='''\\tif !validText(requested) {\\n\\t\\treturn \"\", \"\", invalid(\"projection profile is not valid UTF-8\")\\n\\t}''',\n577|        replace='''\\tif !validText(requested) && requested != \"\\\\xff\\\\xfe\" {\\n\\t\\treturn \"\", \"\", invalid(\"projection profile is not valid UTF-8\")\\n\\t}''',\n578|        count=1,\n579|        run=\"TestSelectProfileRefusesInvalidUTF8\",\n580|        expect=\"KILLED\",\n581|        note=\"Second censused entry: skips validation for exactly the ff-fe member at profile selection; the vocabulary fallback refuses with another message, failing the literal cell.\",\n582|    ),\n583|    Mutant(\n584|        name=\"C-doc-comment\",\n585|        path=f\"{PACKAGE}/visible.go\",\n586|        find='''// authorityUserContext is the only visible-projection authority''',\n587|        replace='''// authorityUserContext is the only visible-projection authority (control)''',\n588|        count=1,\n589|        run=\"TestAuthorityDecisionShape\",\n590|        expect=\"SURVIVED\",\n591|        note=\"Harmless control: a comment-only edit must survive, proving the harness observes outcomes.\",\n592|    ),\n593|]\n594|\n595|\n596|def run_row(mutant, log_dir):\n597|    target = REPO / mutant.path\n598|    original = target.read_text()\n599|    found = original.count(mutant.find)\n600|    log_path = log_dir / f\"{mutant.name}.log\"\n601|    with open(log_path, \"w\") as log:\n602|        log.write(f\"mutant: {mutant.name}\\n\")\n603|        log.write(f\"path: {mutant.path}\\n\")\n604|        log.write(f\"run: {mutant.run}\\n\")\n605|        log.write(f\"expect: {mutant.expect}\\n\")\n606|        log.write(f\"note: {mutant.note}\\n\\n\")\n607|        if found != mutant.count:\n608|            log.write(f\"M-ERROR: find matched {found} times, want {mutant.count}\\n\")\n609|            return \"ERROR\"\n610|        target.write_text(original.replace(mutant.find, mutant.replace))\n611|        log.write(\"M: applied\\n\")\n612|        log.flush()\n613|        started = time.time()\n614|        try:\n615|            proc = subprocess.run(\n616|                [\"go\", \"test\", \"-count=1\", \"-run\", f\"^{mutant.run}$\", f\"./{PACKAGE}/\"],\n617|                cwd=REPO,\n618|                capture_output=True,\n619|                text=True,\n620|                timeout=180,\n621|            )\n622|        except subprocess.TimeoutExpired:\n623|            log.write(\"R-ERROR: timeout after 180s\\n\")\n624|            return \"ERROR\"\n625|        finally:\n626|            target.write_text(original)\n627|            log.write(\"restored\\n\")\n628|        elapsed = time.time() - started\n629|        log.write(f\"R: exit={proc.returncode} elapsed={elapsed:.1f}s\\n\")\n630|        log.write(\"--- stdout ---\\n\")\n631|        log.write(proc.stdout[-6000:])\n632|        log.write(\"\\n--- stderr ---\\n\")\n633|        log.write(proc.stderr[-2000:])\n634|        log.write(\"\\n\")\n635|        failed = proc.returncode != 0 and (\"FAIL\" in proc.stdout or \"FAIL\" in proc.stderr)\n636|        passed = proc.returncode == 0\n637|        if failed:\n638|            verdict = \"KILLED\"\n639|        elif passed:\n640|            verdict = \"SURVIVED\"\n641|        else:\n642|            verdict = \"ERROR\"\n643|        log.write(f\"V: {verdict}\\n\")\n644|        return verdict\n645|\n646|\n647|def main(argv):\n648|    log_dir = None\n649|    names = []\n650|    args = list(argv)\n651|    while args:\n652|        arg = args.pop(0)\n653|        if arg == \"--log-dir\" and args:\n654|            log_dir = Path(args.pop(0))\n655|        else:\n656|            names.append(arg)\n657|    wanted = [m for m in MUTANTS if not names or m.name in names]\n658|    if names and len(wanted) != len(names):\n659|        missing = set(names) - {m.name for m in wanted}\n660|        print(f\"unknown mutants: {sorted(missing)}\")\n661|        return 2\n662|    if log_dir is None:\n663|        log_dir = Path(tempfile.mkdtemp(prefix=\"cloneplanning-mut-\"))\n664|    else:\n665|        log_dir.mkdir(parents=True, exist_ok=True)\n666|    print(f\"log dir: {log_dir}\")\n667|    verdicts = []\n668|    mismatches = 0\n669|    for mutant in wanted:\n670|        verdict = run_row(mutant, log_dir)\n671|        verdicts.append((mutant.name, verdict, mutant.expect))\n672|        mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n673|        if verdict != mutant.expect:\n674|            mismatches += 1\n675|        print(f\"{mutant.name}: {verdict} (expect {mutant.expect}) [{mark}]\")\n676|    killed = sum(1 for _, v, _ in verdicts if v == \"KILLED\")\n677|    survived = sum(1 for _, v, _ in verdicts if v == \"SURVIVED\")\n678|    errors = sum(1 for _, v, _ in verdicts if v == \"ERROR\")\n679|    print(f\"summary: {killed} KILLED, {survived} SURVIVED, {errors} ERROR, {mismatches} mismatches\")\n680|    with open(log_dir / \"verdicts.txt\", \"w\") as f:\n681|        for name, verdict, expect in verdicts:\n682|            f.write(f\"{name}: {verdict} (expect {expect})\\n\")\n683|        f.write(f\"summary: {killed} KILLED, {survived} SURVIVED, {errors} ERROR, {mismatches} mismatches\\n\")\n684|    return 0 if mismatches == 0 and errors == 0 else 1\n685|\n686|\n687|if __name__ == \"__main__\":\n688|    sys.exit(main(sys.argv[1:]))","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
