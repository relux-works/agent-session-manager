{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9e1","stream":{"kind":"session","id":"01a0d381-286a-7d03-bf7e-13c4c16a42b5"},"sequence":843,"recorded_at":1780531400001681,"record_type":"event","durability":"durable","causation_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","run_stream":{"kind":"run","id":"4603a868-01f4-4025-8e84-c5ce1f2882d9"},"call_id":"call_01a0d3879b757605868dd6f60a4c58c8","text":"Read text file `internal/cloneplanning/utf8_test.go`.\n1|package cloneplanning\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|\t\"unicode/utf8\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n9|)\n10|\n11|// This file is the regression answer to review finding\n12|// escape-invalid-utf8-value-change (CR rev3): EscapeVisibleText\n13|// passed its input to encoding/json.Marshal, which silently\n14|// rewrites invalid UTF-8 as U+FFFD and succeeds, so only the\n15|// composed ProjectVisibleText entry refused malformed text. Every\n16|// exported entry that accepts text now refuses invalid UTF-8\n17|// through the shared validText gate before any encoding step, and\n18|// no entry returns a value whose text differs from its input.\n19|//\n20|// The refusal table below drives every censused entry with every\n21|// invalid-UTF-8 class; the census test pins the entry set from\n22|// the production AST, never a hand list.\n23|\n24|// utf8InvalidClass is one invalid-UTF-8 class with its probe. The\n25|// five classes are the rework brief's list; the ff-fe probe is\n26|// exactly the narrowing probe the escape/profile mutants admit.\n27|type utf8InvalidClass struct {\n28|\tname  string\n29|\tprobe string\n30|}\n31|\n32|func utf8InvalidClasses() []utf8InvalidClass {\n33|\treturn []utf8InvalidClass{\n34|\t\t{\"lone-continuation\", \"\\x80\"},\n35|\t\t{\"ff-fe\", \"\\xff\\xfe\"},\n36|\t\t{\"overlong\", \"\\xc0\\xaf\"},\n37|\t\t{\"lone-surrogate\", \"\\xed\\xa0\\x80\"},\n38|\t\t{\"truncated\", \"abc\\xe2\\x82\"},\n39|\t}\n40|}\n41|\n42|// requireUTF8Refusal asserts the UTF-8 refusal: the entry refuses,\n43|// and the refusal names the literal \"valid UTF-8\" from\n44|// SPEC.v0.7.0.md:256 (\"text MUST be valid UTF-8\"), so a fallback\n45|// gate refusing with another message does not satisfy the cell.\n46|func requireUTF8Refusal(t *testing.T, label string, err error) {\n47|\tt.Helper()\n48|\tif err == nil {\n49|\t\tt.Fatalf(\"%s: invalid UTF-8 admitted\", label)\n50|\t}\n51|\tif !strings.Contains(err.Error(), \"valid UTF-8\") {\n52|\t\tt.Fatalf(\"%s: refusal %q does not name valid UTF-8\", label, err.Error())\n53|\t}\n54|}\n55|\n56|func driveEscapeVisibleText(t *testing.T, class, probe string) {\n57|\tt.Helper()\n58|\tgot, err := EscapeVisibleText(probe)\n59|\tlabel := \"EscapeVisibleText/\" + class\n60|\trequireUTF8Refusal(t, label, err)\n61|\tif got != \"\" {\n62|\t\tt.Fatalf(\"%s: refused but returned %q, want no value\", label, got)\n63|\t}\n64|\tif strings.Contains(got, \"\\uFFFD\") {\n65|\t\tt.Fatalf(\"%s: returned a U+FFFD-substituted value\", label)\n66|\t}\n67|}\n68|\n69|func driveSelectProfile(t *testing.T, class, probe string) {\n70|\tt.Helper()\n71|\t_, _, err := SelectProfile(probe)\n72|\trequireUTF8Refusal(t, \"SelectProfile/\"+class, err)\n73|}\n74|\n75|func driveClassifyItem(t *testing.T, class, probe string) {\n76|\tt.Helper()\n77|\t_, err := ClassifyItem(clonebundle.CanonicalEvent{Kind: probe})\n78|\trequireUTF8Refusal(t, \"ClassifyItem/kind/\"+class, err)\n79|\t_, err = ClassifyItem(clonebundle.CanonicalEvent{\n80|\t\tKind:    \"tool_call\",\n81|\t\tPayload: map[string]any{\"resolution\": probe},\n82|\t})\n83|\trequireUTF8Refusal(t, \"ClassifyItem/resolution/\"+class, err)\n84|\t_, err = ClassifyItem(clonebundle.CanonicalEvent{\n85|\t\tKind:    \"opaque_reasoning\",\n86|\t\tPayload: map[string]any{\"protection\": probe},\n87|\t})\n88|\trequireUTF8Refusal(t, \"ClassifyItem/protection/\"+class, err)\n89|}\n90|\n91|func drivePlanItem(t *testing.T, class, probe string) {\n92|\tt.Helper()\n93|\tvalidItem := Item{Kind: \"user_message\"}\n94|\t_, err := PlanItem(probe, \"maximal_safe\", validItem)\n95|\trequireUTF8Refusal(t, \"PlanItem/strategy/\"+class, err)\n96|\t_, err = PlanItem(\"target_native_writer\", probe, validItem)\n97|\trequireUTF8Refusal(t, \"PlanItem/profile/\"+class, err)\n98|\t_, err = PlanItem(\"target_native_writer\", \"maximal_safe\", Item{Kind: probe})\n99|\trequireUTF8Refusal(t, \"PlanItem/kind/\"+class, err)\n100|\t_, err = PlanItem(\"target_native_writer\", \"maximal_safe\", Item{Block: probe})\n101|\trequireUTF8Refusal(t, \"PlanItem/block/\"+class, err)\n102|\t_, err = PlanItem(\"target_native_writer\", \"maximal_safe\", Item{Kind: \"tool_call\", Resolution: probe})\n103|\trequireUTF8Refusal(t, \"PlanItem/resolution/\"+class, err)\n104|\t_, err = PlanItem(\"target_native_writer\", \"maximal_safe\", Item{Kind: \"opaque_reasoning\", Protection: probe})\n105|\trequireUTF8Refusal(t, \"PlanItem/protection/\"+class, err)\n106|}\n107|\n108|func drivePlanSession(t *testing.T, class, probe string) {\n109|\tt.Helper()\n110|\titems := []Item{{Kind: \"user_message\"}}\n111|\t_, _, err := PlanSession(probe, \"maximal_safe\", items)\n112|\trequireUTF8Refusal(t, \"PlanSession/strategy/\"+class, err)\n113|\t_, _, err = PlanSession(\"target_native_writer\", probe, items)\n114|\trequireUTF8Refusal(t, \"PlanSession/profile/\"+class, err)\n115|\t_, _, err = PlanSession(\"target_native_writer\", \"maximal_safe\", []Item{{Kind: probe}})\n116|\trequireUTF8Refusal(t, \"PlanSession/item/\"+class, err)\n117|}\n118|\n119|func drivePlanTargetEffects(t *testing.T, class, probe string) {\n120|\tt.Helper()\n121|\t_, err := PlanTargetEffects([]Mapping{{Disposition: probe}})\n122|\trequireUTF8Refusal(t, \"PlanTargetEffects/disposition/\"+class, err)\n123|\t_, err = PlanTargetEffects([]Mapping{{Disposition: \"exact\", Reasons: []string{probe}}})\n124|\trequireUTF8Refusal(t, \"PlanTargetEffects/reason/\"+class, err)\n125|}\n126|\n127|func driveProjectVisibleText(t *testing.T, class, probe string) {\n128|\tt.Helper()\n129|\tids := []string{orderedDigest(1)}\n130|\t_, err := ProjectVisibleText(VisibleInput{Kind: \"user_message\", Texts: []string{probe}, EventIDs: ids})\n131|\trequireUTF8Refusal(t, \"ProjectVisibleText/texts/\"+class, err)\n132|\t_, err = ProjectVisibleText(VisibleInput{Kind: probe, Texts: []string{\"a\"}, EventIDs: ids})\n133|\trequireUTF8Refusal(t, \"ProjectVisibleText/kind/\"+class, err)\n134|\t_, err = ProjectVisibleText(VisibleInput{Kind: \"user_message\", Texts: []string{\"a\"}, EventIDs: []string{probe}})\n135|\trequireUTF8Refusal(t, \"ProjectVisibleText/eventIDs/\"+class, err)\n136|}\n137|\n138|// utf8RefusalTable is the refusal table: every censused entry\n139|// with the driver injecting invalid UTF-8 into each consumed text\n140|// position. The census test asserts this table's key set equals\n141|// the AST-derived text-entry set exactly: a censused entry\n142|// missing here fails, and an unknown row fails.\n143|var utf8RefusalTable = []struct {\n144|\tentry string\n145|\tdrive func(t *testing.T, class, probe string)\n146|}{\n147|\t{\"EscapeVisibleText\", driveEscapeVisibleText},\n148|\t{\"SelectProfile\", driveSelectProfile},\n149|\t{\"ClassifyItem\", driveClassifyItem},\n150|\t{\"PlanItem\", drivePlanItem},\n151|\t{\"PlanSession\", drivePlanSession},\n152|\t{\"PlanTargetEffects\", drivePlanTargetEffects},\n153|\t{\"ProjectVisibleText\", driveProjectVisibleText},\n154|}\n155|\n156|func TestUTF8ProbesAreInvalid(t *testing.T) {\n157|\t// Fixture guard: every refusal-table probe is actually\n158|\t// invalid UTF-8, and the ff-fe probe is exactly the member\n159|\t// the escape/profile narrowings admit.\n160|\tclasses := utf8InvalidClasses()\n161|\tif len(classes) != 5 {\n162|\t\tt.Fatalf(\"refusal table carries %d invalid classes, want 5\", len(classes))\n163|\t}\n164|\tseen := map[string]bool{}\n165|\tfor _, class := range classes {\n166|\t\tif seen[class.name] {\n167|\t\t\tt.Fatalf(\"duplicate invalid class %q\", class.name)\n168|\t\t}\n169|\t\tseen[class.name] = true\n170|\t\tif utf8.ValidString(class.probe) {\n171|\t\t\tt.Fatalf(\"class %s probe %q is valid UTF-8\", class.name, class.probe)\n172|\t\t}\n173|\t}\n174|\tfor _, class := range classes {\n175|\t\tif class.name == \"ff-fe\" && class.probe != \"\\xff\\xfe\" {\n176|\t\t\tt.Fatalf(\"ff-fe probe is %q, want exactly the narrowing member\", class.probe)\n177|\t\t}\n178|\t}\n179|}\n180|\n181|func TestEscapeVisibleTextRefusesInvalidUTF8(t *testing.T) {\n182|\t// Killer for N-escape-utf8-fffe (the rev3 reviewer's\n183|\t// narrowing: skip validation for the ff-fe class at the\n184|\t// direct escaping entry).\n185|\tfor _, class := range utf8InvalidClasses() {\n186|\t\tdriveEscapeVisibleText(t, class.name, class.probe)\n187|\t}\n188|\t// The rev3 reviewer's exact probe (byte FF,\n189|\t// reviewer_invalid_escape_test.go): embedded so the next\n190|\t// cycle inherits it.\n191|\tdriveEscapeVisibleText(t, \"reviewer-exact-ff\", \"\\xff\")\n192|}\n193|\n194|func TestSelectProfileRefusesInvalidUTF8(t *testing.T) {\n195|\t// Killer for N-select-profile-utf8 (the second censused\n196|\t// entry: skip validation for the ff-fe class at profile\n197|\t// selection; the vocabulary fallback refuses with another\n198|\t// message, which fails the literal cell).\n199|\tfor _, class := range utf8InvalidClasses() {\n200|\t\tdriveSelectProfile(t, class.name, class.probe)\n201|\t}\n202|}\n203|\n204|func TestClassifyItemRefusesInvalidUTF8(t *testing.T) {\n205|\tfor _, class := range utf8InvalidClasses() {\n206|\t\tdriveClassifyItem(t, class.name, class.probe)\n207|\t}\n208|}\n209|\n210|func TestPlanItemRefusesInvalidUTF8(t *testing.T) {\n211|\tfor _, class := range utf8InvalidClasses() {\n212|\t\tdrivePlanItem(t, class.name, class.probe)\n213|\t}\n214|}\n215|\n216|func TestPlanSessionRefusesInvalidUTF8(t *testing.T) {\n217|\tfor _, class := range utf8InvalidClasses() {\n218|\t\tdrivePlanSession(t, class.name, class.probe)\n219|\t}\n220|}\n221|\n222|func TestPlanTargetEffectsRefusesInvalidUTF8(t *testing.T) {\n223|\tfor _, class := range utf8InvalidClasses() {\n224|\t\tdrivePlanTargetEffects(t, class.name, class.probe)\n225|\t}\n226|}\n227|\n228|func TestProjectVisibleTextRefusesInvalidUTF8(t *testing.T) {\n229|\tfor _, class := range utf8InvalidClasses() {\n230|\t\tdriveProjectVisibleText(t, class.name, class.probe)\n231|\t}\n232|}\n233|\n234|func TestClassifyItemIgnoresInvalidPayloadBytes(t *testing.T) {\n235|\t// Ignored members stay ignored even when their bytes are not\n236|\t// valid UTF-8: invalid bytes in any non-fact payload member\n237|\t// cannot change the item, because the item carries no text\n238|\t// field by type and the entry emits nothing derived from\n239|\t// them. Consumed text (kind, closed facts) refuses instead;\n240|\t// the refusal table pins that direction. Hand-built events:\n241|\t// the sealed builder cannot carry invalid UTF-8 at all\n242|\t// (encoding/json rewrites it), so only the direct struct\n243|\t// path exercises these bytes.\n244|\titems := eventSweepItems()\n245|\tcells := 0\n246|\tfor _, want := range items {\n247|\t\tfor _, field := range sweepProbeFields {\n248|\t\t\tfor _, class := range utf8InvalidClasses() {\n249|\t\t\t\tpayload := map[string]any{}\n250|\t\t\t\tif want.Resolution != \"\" {\n251|\t\t\t\t\tpayload[\"resolution\"] = want.Resolution\n252|\t\t\t\t}\n253|\t\t\t\tif want.Protection != \"\" {\n254|\t\t\t\t\tpayload[\"protection\"] = want.Protection\n255|\t\t\t\t}\n256|\t\t\t\tpayload[field] = class.probe\n257|\t\t\t\tgot, err := ClassifyItem(clonebundle.CanonicalEvent{Kind: want.Kind, Payload: payload})\n258|\t\t\t\tlabel := want.Kind + \"/\" + field + \"/\" + class.name\n259|\t\t\t\tif err != nil {\n260|\t\t\t\t\tt.Fatalf(\"ignored-bytes %s refused: %v\", label, err)\n261|\t\t\t\t}\n262|\t\t\t\tif got != want {\n263|\t\t\t\t\tt.Fatalf(\"ignored-bytes %s = %+v, want %+v\", label, got, want)\n264|\t\t\t\t}\n265|\t\t\t\tcells++\n266|\t\t\t}\n267|\t\t}\n268|\t}\n269|\tt.Logf(\"classify ignored-bytes: %d cells\", cells)\n270|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
