{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c915","stream":{"kind":"session","id":"01a0d381-286a-7d03-bf7e-13c4c16a42b5"},"sequence":741,"recorded_at":1780531400001477,"record_type":"event","durability":"durable","causation_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","run_stream":{"kind":"run","id":"4603a868-01f4-4025-8e84-c5ce1f2882d9"},"call_id":"call_01a0d38715227675892dff70e93242cc","text":"Read text file `internal/cloneplanning/testdata/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for internal/cloneplanning.\n3|\n4|Every gate ships a narrowing mutant: the gate stays present and is\n5|weakened to admit exactly one member of the class it must reject,\n6|and the named killer test must fail when run alone. A delete-only\n7|mutant proves only that the gate exists and is not accepted as\n8|evidence.\n9|\n10|Each row runs M (mutate one production file in place), R (run the\n11|scoped Go killer through a production entry), V (verdict from the Go\n12|exit code plus a FAIL kill-line: KILLED iff R fails with a test\n13|failure line, SURVIVED iff R passes, ERROR for anything else --\n14|unapplied patches, build breaks, timeouts). M failures and R\n15|infrastructure errors are ERROR, never kills or survivals. The file\n16|is restored from its backup after every row, pass or fail.\n17|\n18|Shared gates (the checkItem vocabulary and fact gates with two call\n19|sites: PlanItem and ClassifyItem) carry one plant each with the\n20|both-entries killer TestSharedItemVocabBothEntries.\n21|\n22|Row N-visible-escape-suffix is the token-preserving attack: the\n23|JSON token still leads the output but the behavior changes, and the\n24|killer executes the behavioral escaping suite.\n25|\n26|Single-member-class rows narrow a gate whose reject class holds\n27|exactly one member, so the plant admits the whole class, which is\n28|one member.\n29|\n30|Row C-doc-comment is the harmless control: a comment-only edit that\n31|must SURVIVE, proving the harness observes test outcomes instead of\n32|hard-coding kills.\n33|\n34|Usage:\n35|  PYTHONDONTWRITEBYTECODE=1 python3 internal/cloneplanning/testdata/mutant_harness.py [--log-dir DIR] [MUTANT ...]\n36|\"\"\"\n37|\n38|import shutil\n39|import subprocess\n40|import sys\n41|import tempfile\n42|import time\n43|from dataclasses import dataclass\n44|from pathlib import Path\n45|\n46|REPO = Path(__file__).resolve().parents[3]\n47|PACKAGE = \"internal/cloneplanning\"\n48|\n49|\n50|@dataclass(frozen=True)\n51|class Mutant:\n52|    name: str\n53|    path: str\n54|    find: str\n55|    replace: str\n56|    count: int\n57|    run: str\n58|    expect: str\n59|    note: str\n60|\n61|\n62|MUTANTS = [\n63|    Mutant(\n64|        name=\"N-select-archive-priority\",\n65|        path=f\"{PACKAGE}/strategy.go\",\n66|        find='''\\tif archive {\\n\\t\\treturn strategyArchive, nil\\n\\t}\\n\\tif continuation {\\n\\t\\treturn strategyContinuation, nil\\n\\t}''',\n67|        replace='''\\tif continuation {\\n\\t\\treturn strategyContinuation, nil\\n\\t}\\n\\tif archive {\\n\\t\\treturn strategyArchive, nil\\n\\t}''',\n68|        count=1,\n69|        run=\"TestSelectStrategyOracle\",\n70|        expect=\"KILLED\",\n71|        note=\"Narrows the priority gate: archive+continuation selects continuation instead of archive.\",\n72|    ),\n73|    Mutant(\n74|        name=\"N-select-official\",\n75|        path=f\"{PACKAGE}/strategy.go\",\n76|        find='''\\tif !sameEnvironment {\\n\\t\\tif officialImport {\\n\\t\\t\\treturn strategyOfficial, nil\\n\\t\\t}\\n\\t\\treturn strategyNativeWriter, nil\\n\\t}\\n\\treturn strategyNativeRewrite, nil''',\n77|        replace='''\\tif officialImport {\\n\\t\\treturn strategyOfficial, nil\\n\\t}\\n\\tif !sameEnvironment {\\n\\t\\treturn strategyNativeWriter, nil\\n\\t}\\n\\treturn strategyNativeRewrite, nil''',\n78|        count=1,\n79|        run=\"TestSelectStrategyOracle\",\n80|        expect=\"KILLED\",\n81|        note=\"Narrows the pair arm: same-environment with the importer selects official import instead of native rewrite.\",\n82|    ),\n83|    Mutant(\n84|        name=\"N-select-profile-archive\",\n85|        path=f\"{PACKAGE}/strategy.go\",\n86|        find='''\\tif requested == profileArchive {\\n\\t\\treturn BranchArchive, requested, nil\\n\\t}''',\n87|        replace='''\\tif requested == profileArchive {\\n\\t\\treturn BranchTarget, requested, nil\\n\\t}''',\n88|        count=1,\n89|        run=\"TestSelectProfileOracle\",\n90|        expect=\"KILLED\",\n91|        note=\"Narrows the branch router: archive_only routes target instead of archive.\",\n92|    ),\n93|    Mutant(\n94|        name=\"N-select-profile-unknown\",\n95|        path=f\"{PACKAGE}/strategy.go\",\n96|        find='''\\tif !cloneplan.ValidPlanProfile(requested) {''',\n97|        replace='''\\tif requested != \"bogus_profile\" && !cloneplan.ValidPlanProfile(requested) {''',\n98|        count=1,\n99|        run=\"TestSelectProfileOracle\",\n100|        expect=\"KILLED\",\n101|        note=\"Narrows the plan-profile gate: admits exactly bogus_profile to the target branch.\",\n102|    ),\n103|    Mutant(\n104|        name=\"N-kind-vocab\",\n105|        path=f\"{PACKAGE}/item.go\",\n106|        find='''\\t\\tif !clonebundle.ValidEventKind(item.Kind) {''',\n107|        replace='''\\t\\tif item.Kind != \"bogus_kind\" && !clonebundle.ValidEventKind(item.Kind) {''',\n108|        count=1,\n109|        run=\"TestSharedItemVocabBothEntries\",\n110|        expect=\"KILLED\",\n111|        note=\"Shared gate: admits exactly bogus_kind through both PlanItem and ClassifyItem.\",\n112|    ),\n113|    Mutant(\n114|        name=\"N-block-vocab\",\n115|        path=f\"{PACKAGE}/item.go\",\n116|        find='''\\t\\tif !clonebundle.ValidContentBlockType(item.Block) {''',\n117|        replace='''\\t\\tif item.Block != \"bogus_block\" && !clonebundle.ValidContentBlockType(item.Block) {''',\n118|        count=1,\n119|        run=\"TestSharedItemVocabBothEntries\",\n120|        expect=\"KILLED\",\n121|        note=\"Shared gate: admits exactly bogus_block through PlanItem (blocks have no event bridge).\",\n122|    ),\n123|    Mutant(\n124|        name=\"N-resolution-vocab\",\n125|        path=f\"{PACKAGE}/item.go\",\n126|        find='''\\tif !validResolution(item.Resolution) {''',\n127|        replace='''\\tif item.Resolution != \"bogus_resolution\" && !validResolution(item.Resolution) {''',\n128|        count=1,\n129|        run=\"TestSharedItemVocabBothEntries\",\n130|        expect=\"KILLED\",\n131|        note=\"Shared gate: admits exactly bogus_resolution through both entries.\",\n132|    ),\n133|    Mutant(\n134|        name=\"N-protection-vocab\",\n135|        path=f\"{PACKAGE}/item.go\",\n136|        find='''\\tif !validProtection(item.Protection) {''',\n137|        replace='''\\tif item.Protection != \"bogus_protection\" && !validProtection(item.Protection) {''',\n138|        count=1,\n139|        run=\"TestSharedItemVocabBothEntries\",\n140|        expect=\"KILLED\",\n141|        note=\"Shared gate: admits exactly bogus_protection through both entries.\",\n142|    ),\n143|    Mutant(\n144|        name=\"N-classify-resolution-required\",\n145|        path=f\"{PACKAGE}/item.go\",\n146|        find='''\\tif toolKinds[item.Kind] {\\n\\t\\tif item.Resolution == \"\" {\\n\\t\\t\\treturn invalid(\"projection item kind %q requires its completed|aborted resolution\", item.Kind)\\n\\t\\t}''',\n147|        replace='''\\tif toolKinds[item.Kind] {\\n\\t\\tif item.Resolution == \"\" && item.Kind != \"tool_call\" {\\n\\t\\t\\treturn invalid(\"projection item kind %q requires its completed|aborted resolution\", item.Kind)\\n\\t\\t}''',\n148|        count=1,\n149|        run=\"TestClassifyItemRefusals\",\n150|        expect=\"KILLED\",\n151|        note=\"Narrows the required-resolution gate: tool_call without resolution admits, tool_result still refuses.\",\n152|    ),\n153|    Mutant(\n154|        name=\"N-classify-protection-required\",\n155|        path=f\"{PACKAGE}/item.go\",\n156|        find='''\\tif item.Kind == \"opaque_reasoning\" {\\n\\t\\tif item.Protection == \"\" {\\n\\t\\t\\treturn invalid(\"projection item kind opaque_reasoning requires its encrypted|signed protection\")\\n\\t\\t}''',\n157|        replace='''\\tif item.Kind == \"opaque_reasoning\" {\\n\\t\\tif item.Protection == \"\" && item.Kind != \"opaque_reasoning\" {\\n\\t\\t\\treturn invalid(\"projection item kind opaque_reasoning requires its encrypted|signed protection\")\\n\\t\\t}''',\n158|        count=1,\n159|        run=\"TestClassifyItemRefusals\",\n160|        expect=\"KILLED\",\n161|        note=\"Single-member-class narrowing: the gate whose reject class is exactly opaque_reasoning-without-protection admits it.\",\n162|    ),\n163|    Mutant(\n164|        name=\"N-classify-fact-type\",\n165|        path=f\"{PACKAGE}/item.go\",\n166|        find='''\\tvalue, ok := raw.(string)\\n\\tif !ok {\\n\\t\\treturn \"\", invalid(\"projection item fact %q is not a string\", name)\\n\\t}\\n\\treturn value, nil''',\n167|        replace='''\\tif _, isInt := raw.(int64); isInt {\\n\\t\\treturn \"\", nil\\n\\t}\\n\\tvalue, ok := raw.(string)\\n\\tif !ok {\\n\\t\\treturn \"\", invalid(\"projection item fact %q is not a string\", name)\\n\\t}\\n\\treturn value, nil''',\n168|        count=1,\n169|        run=\"TestClassifyItemRefusals\",\n170|        expect=\"KILLED\",\n171|        note=\"Narrows the fact-type gate: admits exactly int64-typed facts as absent (the landed decoder renders numbers int64); bool and object facts still refuse.\",\n172|    ),\n173|    Mutant(\n174|        name=\"N-strategy-vocab\",\n175|        path=f\"{PACKAGE}/plan.go\",\n176|        find='''\\tif !clonefidelity.ValidStrategy(strategy) {''',\n177|        replace='''\\tif strategy != \"bogus_strategy\" && !clonefidelity.ValidStrategy(strategy) {''',\n178|        count=1,\n179|        run=\"TestPlanItemInvalidArms\",\n180|        expect=\"KILLED\",\n181|        note=\"Narrows the strategy vocabulary delegation: admits exactly bogus_strategy.\",\n182|    ),\n183|    Mutant(\n184|        name=\"N-profile-vocab\",\n185|        path=f\"{PACKAGE}/plan.go\",\n186|        find='''\\tcase profileMaximalSafe:\\n\\t\\treturn disposition, reasons, nil\\n\\tdefault:\\n\\t\\treturn \"\", nil, invalid(\"projection profile %q is not a target plan profile\", profile)''',\n187|        replace='''\\tcase profileMaximalSafe:\\n\\t\\treturn disposition, reasons, nil\\n\\tcase \"bogus_profile\":\\n\\t\\treturn disposition, reasons, nil\\n\\tdefault:\\n\\t\\treturn \"\", nil, invalid(\"projection profile %q is not a target plan profile\", profile)''',\n188|        count=1,\n189|        run=\"TestPlanItemInvalidArms\",\n190|        expect=\"KILLED\",\n191|        note=\"Narrows the profile overlay default: admits exactly bogus_profile as a pass-through.\",\n192|    ),\n193|    Mutant(\n194|        name=\"N-archive-strategy\",\n195|        path=f\"{PACKAGE}/plan.go\",\n196|        find='''\\tif strategy == strategyArchive || profile == profileArchive {''',\n197|        replace='''\\tif !(strategy == strategyArchive && profile == profileMaximalSafe) && (strategy == strategyArchive || profile == profileArchive) {''',\n198|        count=1,\n199|        run=\"TestPlanItemArchiveRule\",\n200|        expect=\"KILLED\",\n201|        note=\"Narrows the archive gate: admits exactly the archive_only/maximal_safe cell.\",\n202|    ),\n203|    Mutant(\n204|        name=\"N-archive-profile\",\n205|        path=f\"{PACKAGE}/plan.go\",\n206|        find='''\\tif strategy == strategyArchive || profile == profileArchive {''',\n207|        replace='''\\tif !(strategy == strategyNativeWriter && profile == profileArchive) && (strategy == strategyArchive || profile == profileArchive) {''',\n208|        count=1,\n209|        run=\"TestPlanItemArchiveRule\",\n210|        expect=\"KILLED\",\n211|        note=\"Narrows the archive gate: exempts exactly the writer/archive cell from the archive-branch refusal (it then refuses via the overlay default, which names no archive branch).\",\n212|    ),\n213|    Mutant(\n214|        name=\"N-opaque-reason\",\n215|        path=f\"{PACKAGE}/plan.go\",\n216|        find='''\\t\\tif item.Protection == protectionSigned {\\n\\t\\t\\treturn dispositionOpaquePreserved, []string{reasonForeignSigned}\\n\\t\\t}''',\n217|        replace='''\\t\\tif item.Protection == protectionSigned {\\n\\t\\t\\treturn dispositionOpaquePreserved, []string{reasonForeignEncrypted}\\n\\t\\t}''',\n218|        count=1,\n219|        run=\"TestPlanItemOpaqueRule\",\n220|        expect=\"KILLED\",\n221|        note=\"Narrows the opaque-reason mapping: signed reasoning reports the encrypted reason; the encrypted arm is intact.\",\n222|    ),\n223|    Mutant(\n224|        name=\"N-opaque-event-reason\",\n225|        path=f\"{PACKAGE}/plan.go\",\n226|        find='''\\tif item.Kind == \"opaque_event\" || item.Block == \"opaque\" {\\n\\t\\treturn dispositionOpaquePreserved, []string{reasonUnknownNative}\\n\\t}''',\n227|        replace='''\\tif item.Kind == \"opaque_event\" && item.Protection == \"\" {\\n\\t\\treturn dispositionOpaquePreserved, []string{reasonForeignEncrypted}\\n\\t}\\n\\tif item.Kind == \"opaque_event\" || item.Block == \"opaque\" {\\n\\t\\treturn dispositionOpaquePreserved, []string{reasonUnknownNative}\\n\\t}''',\n228|        count=1,\n229|        run=\"TestPlanItemOpaqueRule\",\n230|        expect=\"KILLED\",\n231|        note=\"Narrows the opaque-event mapping: the unprotected opaque_event item reports the encrypted reason.\",\n232|    ),\n233|    Mutant(\n234|        name=\"N-abort-drop\",\n235|        path=f\"{PACKAGE}/plan.go\",\n236|        find='''\\tif (item.Kind == \"tool_call\" || item.Kind == \"tool_result\") && item.Resolution == cloneproject.StatusAborted {''',\n237|        replace='''\\tif (item.Kind == \"tool_result\") && item.Resolution == cloneproject.StatusAborted {''',\n238|        count=1,\n239|        run=\"TestPlanItemAbortRule\",\n240|        expect=\"KILLED\",\n241|        note=\"Narrows the abort arm: aborted tool_call falls to the strategy default; aborted tool_result is intact.\",\n242|    ),\n243|    Mutant(\n244|        name=\"N-abort-reason\",\n245|        path=f\"{PACKAGE}/plan.go\",\n246|        find='''\\t\\treturn dispositionSummarized, []string{reasonUnsafePending}''',\n247|        replace='''\\t\\treturn dispositionSummarized, nil''',\n248|        count=1,\n249|        run=\"TestPlanItemAbortRule\",\n250|        expect=\"KILLED\",\n251|        note=\"Narrows the abort mapping: aborted history without its unsafe_pending_action reason.\",\n252|    ),\n253|    Mutant(\n254|        name=\"N-continuation-exact\",\n255|        path=f\"{PACKAGE}/plan.go\",\n256|        find='''\\tif strategy == strategyContinuation {\\n\\t\\treturn dispositionSemantic, []string{reasonTargetNoEquivalent}\\n\\t}''',\n257|        replace='''\\tif strategy == strategyContinuation && item.Kind != \"usage\" {\\n\\t\\treturn dispositionSemantic, []string{reasonTargetNoEquivalent}\\n\\t}''',\n258|        count=1,\n259|        run=\"TestPlanItemContinuationRule\",\n260|        expect=\"KILLED\",\n261|        note=\"Narrows the continuation clamp: usage plans exact under continuation_context.\",\n262|    ),\n263|    Mutant(\n264|        name=\"N-continuation-reason\",\n265|        path=f\"{PACKAGE}/plan.go\",\n266|        find='''\\t\\treturn dispositionSemantic, []string{reasonTargetNoEquivalent}''',\n267|        replace='''\\t\\treturn dispositionSemantic, nil''',\n268|        count=1,\n269|        run=\"TestPlanItemContinuationRule\",\n270|        expect=\"KILLED\",\n271|        note=\"Narrows the continuation mapping: semantic without its target_no_equivalent reason.\",\n272|    ),\n273|    Mutant(\n274|        name=\"N-importer-tool\",\n275|        path=f\"{PACKAGE}/plan.go\",\n276|        find='''\\t\\tif completeToolKinds[item.Kind] {\\n\\t\\t\\treturn dispositionSemantic, []string{reasonOfficialImporterLoss}\\n\\t\\t}''',\n277|        replace='''\\t\\tif completeToolKinds[item.Kind] && item.Kind != \"tool_definition_snapshot\" {\\n\\t\\t\\treturn dispositionSemantic, []string{reasonOfficialImporterLoss}\\n\\t\\t}''',\n278|        count=1,\n279|        run=\"TestPlanItemImporterRule\",\n280|        expect=\"KILLED\",\n281|        note=\"Narrows the importer tool arm: tool_definition_snapshot plans exact under official import.\",\n282|    ),\n283|    Mutant(\n284|        name=\"N-importer-graph\",\n285|        path=f\"{PACKAGE}/plan.go\",\n286|        find='''\\t\\tif subagentKinds[item.Kind] {\\n\\t\\t\\treturn dispositionSemantic, []string{reasonGraphFlattened}\\n\\t\\t}''',\n287|        replace='''\\t\\tif subagentKinds[item.Kind] && item.Kind != \"subagent_completed\" {\\n\\t\\t\\treturn dispositionSemantic, []string{reasonGraphFlattened}\\n\\t\\t}''',\n288|        count=1,\n289|        run=\"TestPlanItemImporterRule\",\n290|        expect=\"KILLED\",\n291|        note=\"Narrows the importer graph arm: subagent_completed plans exact under official import.\",\n292|    ),\n293|    Mutant(\n294|        name=\"N-strict-admit\",\n295|        path=f\"{PACKAGE}/plan.go\",\n296|        find='''\\tcase profileStrictExact:\\n\\t\\tif disposition != dispositionExact {''',\n297|        replace='''\\tcase profileStrictExact:\\n\\t\\tif disposition != dispositionExact && disposition != dispositionSemantic {''',\n298|        count=1,\n299|        run=\"TestPlanItemStrictRule\",\n300|        expect=\"KILLED\",\n301|        note=\"Narrows the strict gate: admits exactly semantic alongside exact.\",\n302|    ),\n303|    Mutant(\n304|        name=\"N-compact-skip\",\n305|        path=f\"{PACKAGE}/plan.go\",\n306|        find='''\\tcase profileCompact:\\n\\t\\tif disposition == dispositionSemantic {''',\n307|        replace='''\\tcase profileCompact:\\n\\t\\tif disposition == dispositionSemantic && item.Kind != \"usage\" {''',\n308|        count=1,\n309|        run=\"TestPlanItemCompactRule\",\n310|        expect=\"KILLED\",\n311|        note=\"Narrows the compact clamp: usage keeps semantic under compact.\",\n312|    ),\n313|    Mutant(\n314|        name=\"N-compact-reason\",\n315|        path=f\"{PACKAGE}/plan.go\",\n316|        find='''\\t\\t\\treturn dispositionSummarized, append(append([]string(nil), reasons...), reasonTargetContextLimit), nil''',\n317|        replace='''\\t\\t\\treturn dispositionSummarized, append([]string(nil), reasons...), nil''',\n318|        count=1,\n319|        run=\"TestPlanItemCompactRule\",\n320|        expect=\"KILLED\",\n321|        note=\"Narrows the compact clamp: summarized without the appended target_context_limit reason.\",\n322|    ),\n323|    Mutant(\n324|        name=\"N-messages-admit\",\n325|        path=f\"{PACKAGE}/plan.go\",\n326|        find='''\\tcase profileMessages:\\n\\t\\tif isMessageClass(item) {''',\n327|        replace='''\\tcase profileMessages:\\n\\t\\tif isMessageClass(item) || item.Kind == \"usage\" {''',\n328|        count=1,\n329|        run=\"TestPlanItemMessagesRule\",\n330|        expect=\"KILLED\",\n331|        note=\"Narrows the messages_only survivor set: usage survives alongside message classes.\",\n332|    ),\n333|    Mutant(\n334|        name=\"N-messages-reason\",\n335|        path=f\"{PACKAGE}/plan.go\",\n336|        find='''\\t\\tomitted := append(append([]string(nil), reasons...), reasonOperatorPolicy)''',\n337|        replace='''\\t\\tomitted := append([]string(nil), reasons...)''',\n338|        count=1,\n339|        run=\"TestPlanItemMessagesRule\",\n340|        expect=\"KILLED\",\n341|        note=\"Narrows the messages_only overlay: omitted without the operator_policy reason.\",\n342|    ),\n343|    Mutant(\n344|        name=\"N-media-reason\",\n345|        path=f\"{PACKAGE}/plan.go\",\n346|        find='''\\t\\tif mediaBlocks[item.Block] {\\n\\t\\t\\tomitted = append(omitted, reasonUnsupportedMedia)\\n\\t\\t}''',\n347|        replace='''\\t\\tif mediaBlocks[item.Block] && item.Block != \"image\" {\\n\\t\\t\\tomitted = append(omitted, reasonUnsupportedMedia)\\n\\t\\t}''',\n348|        count=1,\n349|        run=\"TestPlanItemMessagesRule\",\n350|        expect=\"KILLED\",\n351|        note=\"Narrows the media overlay: image blocks omit without the unsupported_media_type reason.\",\n352|    ),\n353|    Mutant(\n354|        name=\"N-reason-order\",\n355|        path=f\"{PACKAGE}/plan.go\",\n356|        find='''\\tsorted := append([]string(nil), reasons...)\\n\\tsort.Strings(sorted)''',\n357|        replace='''\\tsorted := append([]string(nil), reasons...)\\n\\t_ = sort.Strings''',\n358|        count=1,\n359|        run=\"TestPlanItemMessagesRule\",\n360|        expect=\"KILLED\",\n361|        note=\"Narrows the reason emission: insertion order instead of sorted (the aborted+messages cell proves the order).\",\n362|    ),\n363|    Mutant(\n364|        name=\"N-session-empty\",\n365|        path=f\"{PACKAGE}/plan.go\",\n366|        find='''\\tif len(items) == 0 || len(items) > maxSessionItems {''',\n367|        replace='''\\tif len(items) > maxSessionItems {''',\n368|        count=1,\n369|        run=\"TestPlanSessionRefusals\",\n370|        expect=\"KILLED\",\n371|        note=\"Narrows the session bound: admits exactly the empty session.\",\n372|    ),\n373|    Mutant(\n374|        name=\"N-session-bound\",\n375|        path=f\"{PACKAGE}/plan.go\",\n376|        find='''\\tif len(items) == 0 || len(items) > maxSessionItems {''',\n377|        replace='''\\tif len(items) == 0 || len(items) > maxSessionItems+1 {''',\n378|        count=1,\n379|        run=\"TestPlanSessionRefusals\",\n380|        expect=\"KILLED\",\n381|        note=\"Narrows the session bound: admits exactly 1000001 items.\",\n382|    ),\n383|    Mutant(\n384|        name=\"N-count-swap\",\n385|        path=f\"{PACKAGE}/plan.go\",\n386|        find='''\\t\\tcase dispositionExact:\\n\\t\\t\\tcounts.Exact++''',\n387|        replace='''\\t\\tcase dispositionExact:\\n\\t\\t\\tcounts.Semantic++''',\n388|        count=1,\n389|        run=\"TestPlanSessionCounts\",\n390|        expect=\"KILLED\",\n391|        note=\"Narrows the count fold: exact mappings fund the semantic counter.\",\n392|    ),\n393|    Mutant(\n394|        name=\"N-effects-disposition\",\n395|        path=f\"{PACKAGE}/effects.go\",\n396|        find='''\\t\\tif !clonefidelity.ValidDisposition(mapping.Disposition) {''',\n397|        replace='''\\t\\tif mapping.Disposition != \"bogus_disposition\" && !clonefidelity.ValidDisposition(mapping.Disposition) {''',\n398|        count=1,\n399|        run=\"TestPlanTargetEffectsRefusals\",\n400|        expect=\"KILLED\",\n401|        note=\"Narrows the effects disposition gate: admits exactly bogus_disposition.\",\n402|    ),\n403|    Mutant(\n404|        name=\"N-effects-reason\",\n405|        path=f\"{PACKAGE}/effects.go\",\n406|        find='''\\t\\t\\tif !clonefidelity.ValidReasonCode(reason) {''',\n407|        replace='''\\t\\t\\tif reason != \"bogus_reason\" && !clonefidelity.ValidReasonCode(reason) {''',\n408|        count=1,\n409|        run=\"TestPlanTargetEffectsRefusals\",\n410|        expect=\"KILLED\",\n411|        note=\"Narrows the effects reason gate: admits exactly bogus_reason.\",\n412|    ),\n413|    Mutant(\n414|        name=\"N-effects-order-skip\",\n415|        path=f\"{PACKAGE}/effects.go\",\n416|        find='''\\t\\t\\tif mapping.Reasons[position-1] >= mapping.Reasons[position] {''',\n417|        replace='''\\t\\t\\tif mapping.Reasons[position-1] >= mapping.Reasons[position] && mapping.Reasons[position-1] != \"unsafe_pending_action\" {''',\n418|        count=1,\n419|        run=\"TestPlanTargetEffectsRefusals\",\n420|        expect=\"KILLED\",\n421|        note=\"Narrows the effects order gate: admits exactly unsorted pairs led by unsafe_pending_action.\",\n422|    ),\n423|    Mutant(\n424|        name=\"N-effects-nonzero\",\n425|        path=f\"{PACKAGE}/effects.go\",\n426|        find='''\\t\\t}\\n\\t}\\n\\treturn TargetEffects{}, nil\\n}''',\n427|        replace='''\\t\\t}\\n\\t}\\n\\teffects := TargetEffects{}\\n\\tfor _, mapping := range mappings {\\n\\t\\tif mapping.Disposition == dispositionExact {\\n\\t\\t\\teffects.TargetInputTokens = 1\\n\\t\\t}\\n\\t}\\n\\treturn effects, nil\\n}''',\n428|        count=1,\n429|        run=\"TestPlanTargetEffectsZeroSweep\",\n430|        expect=\"KILLED\",\n431|        note=\"Narrows the zero fold: exact mappings fund one target input token.\",\n432|    ),\n433|    Mutant(\n434|        name=\"N-visible-kind\",\n435|        path=f\"{PACKAGE}/visible.go\",\n436|        find='''\\tif !clonebundle.ValidEventKind(input.Kind) {''',\n437|        replace='''\\tif input.Kind != \"bogus_kind\" && !clonebundle.ValidEventKind(input.Kind) {''',\n438|        count=1,\n439|        run=\"TestProjectVisibleKindRefusals\",\n440|        expect=\"KILLED\",\n441|        note=\"Narrows the visible kind gate: admits exactly bogus_kind.\",\n442|    ),\n443|    Mutant(\n444|        name=\"N-visible-ordinal\",\n445|        path=f\"{PACKAGE}/visible.go\",\n446|        find='''\\tif _, err := scalar.NewUint53(input.Ordinal); err != nil {\\n\\t\\treturn VisibleProjection{}, invalid(\"visible projection ordinal %d is not a uint53: %v\", input.Ordinal, err)\\n\\t}''',\n447|        replace='''\\tif input.Ordinal != 9007199254740992 {\\n\\t\\tif _, err := scalar.NewUint53(input.Ordinal); err != nil {\\n\\t\\t\\treturn VisibleProjection{}, invalid(\"visible projection ordinal %d is not a uint53: %v\", input.Ordinal, err)\\n\\t\\t}\\n\\t}''',\n448|        count=1,\n449|        run=\"TestProjectVisibleOrdinalEdges\",\n450|        expect=\"KILLED\",\n451|        note=\"Narrows the ordinal gate: admits exactly 9007199254740992.\",\n452|    ),\n453|    Mutant(\n454|        name=\"N-visible-utf8\",\n455|        path=f\"{PACKAGE}/visible.go\",\n456|        find='''\\tfor index, field := range input.Texts {\\n\\t\\tif !validText(field) {''',\n457|        replace='''\\tfor index, field := range input.Texts {\\n\\t\\tif !validText(field) && index != 1 {''',\n458|        count=1,\n459|        run=\"TestProjectVisibleTextRefusals\",\n460|        expect=\"KILLED\",\n461|        note=\"Narrows the UTF-8 gate: skips exactly field[1]; the direct entry then refuses with the unindexed message, failing the field[ cell.\",\n462|    ),\n463|    Mutant(\n464|        name=\"N-visible-max\",\n465|        path=f\"{PACKAGE}/visible.go\",\n466|        find='''\\tif length := environ.StringLength(joined); length < 1 || length > maxEscapedText {''',\n467|        replace='''\\tif length := environ.StringLength(joined); length < 1 || length > maxEscapedText+1 {''',\n468|        count=1,\n469|        run=\"TestProjectVisibleBounds\",\n470|        expect=\"KILLED\",\n471|        note=\"Narrows the escaped_text bound: admits exactly 65537 characters.\",\n472|    ),\n473|    Mutant(\n474|        name=\"N-visible-empty\",\n475|        path=f\"{PACKAGE}/visible.go\",\n476|        find='''\\tif length := environ.StringLength(joined); length < 1 || length > maxEscapedText {''',\n477|        replace='''\\tif length := environ.StringLength(joined); length < 0 || length > maxEscapedText {''',\n478|        count=1,\n479|        run=\"TestProjectVisibleBounds\",\n480|        expect=\"KILLED\",\n481|        note=\"Narrows the escaped_text bound: admits exactly the empty text.\",\n482|    ),\n483|    Mutant(\n484|        name=\"N-visible-ids-count0\",\n485|        path=f\"{PACKAGE}/visible.go\",\n486|        find='''\\tif len(ids) < 1 || len(ids) > maxVisibleEventIDs {''',\n487|        replace='''\\tif len(ids) > maxVisibleEventIDs {''',\n488|        count=1,\n489|        run=\"TestProjectVisibleEventIDGrid\",\n490|        expect=\"KILLED\",\n491|        note=\"Narrows the event-ID count gate: admits exactly zero IDs.\",\n492|    ),\n493|    Mutant(\n494|        name=\"N-visible-ids-count65\",\n495|        path=f\"{PACKAGE}/visible.go\",\n496|        find='''\\tif len(ids) < 1 || len(ids) > maxVisibleEventIDs {''',\n497|        replace='''\\tif len(ids) < 1 || len(ids) > maxVisibleEventIDs+1 {''',\n498|        count=1,\n499|        run=\"TestProjectVisibleEventIDGrid\",\n500|        expect=\"KILLED\",\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
