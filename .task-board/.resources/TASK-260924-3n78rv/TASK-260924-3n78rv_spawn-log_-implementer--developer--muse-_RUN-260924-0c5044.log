{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5f1","stream":{"kind":"session","id":"01a0d381-286a-7d03-bf7e-13c4c16a42b5"},"sequence":339,"recorded_at":1780531400000673,"record_type":"event","durability":"durable","causation_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","run_stream":{"kind":"run","id":"4603a868-01f4-4025-8e84-c5ce1f2882d9"},"call_id":"call_01a0d382050f76a58a0474e91a669b20","text":"Read text file `internal/cloneplanning/effects.go`.\n1|package cloneplanning\n2|\n3|import (\n4|\t\"github.com/relux-works/agent-session-manager/internal/clonefidelity\"\n5|)\n6|\n7|// This file folds planned mappings to target effects: callable\n8|// tools, pending actions, and target token accounting. Historical\n9|// tools are inert and source usage is not target accounting\n10|// (Section 13.14.1), so the fold is always empty: no mapping admits\n11|// a live effect. Mappings carry no token field by type, so token\n12|// counts cannot reach the accounting decision at all; the sweep\n13|// proves every mapping the planner emits folds to zero.\n14|\n15|// TargetEffects is the planned session's live surface: callable\n16|// tools, pending actions, and target token accounting. Planning\n17|// from captured history always yields the zero value.\n18|type TargetEffects struct {\n19|\tCallableTools      []string\n20|\tPendingActions     []string\n21|\tTargetInputTokens  uint64\n22|\tTargetOutputTokens uint64\n23|}\n24|\n25|// PlanTargetEffects folds planned mappings to their target\n26|// effects: always empty. Every mapping is validated first (closed\n27|// disposition, vocabulary reasons in sorted-unique order), so\n28|// garbage mappings refuse instead of folding.\n29|func PlanTargetEffects(mappings []Mapping) (TargetEffects, error) {\n30|\tfor index, mapping := range mappings {\n31|\t\tif !validText(mapping.Disposition) {\n32|\t\t\treturn TargetEffects{}, invalid(\"target effects mapping[%d] disposition is not valid UTF-8\", index)\n33|\t\t}\n34|\t\tif !clonefidelity.ValidDisposition(mapping.Disposition) {\n35|\t\t\treturn TargetEffects{}, invalid(\"target effects mapping[%d] disposition %q is outside the Section 13.14.2 vocabulary\", index, mapping.Disposition)\n36|\t\t}\n37|\t\tfor _, reason := range mapping.Reasons {\n38|\t\t\tif !validText(reason) {\n39|\t\t\t\treturn TargetEffects{}, invalid(\"target effects mapping[%d] reason is not valid UTF-8\", index)\n40|\t\t\t}\n41|\t\t\tif !clonefidelity.ValidReasonCode(reason) {\n42|\t\t\t\treturn TargetEffects{}, invalid(\"target effects mapping[%d] reason %q is not a core or reverse-DNS reason\", index, reason)\n43|\t\t\t}\n44|\t\t}\n45|\t\tfor position := 1; position < len(mapping.Reasons); position++ {\n46|\t\t\tif mapping.Reasons[position-1] >= mapping.Reasons[position] {\n47|\t\t\t\treturn TargetEffects{}, invalid(\"target effects mapping[%d] reasons are not sorted unique\", index)\n48|\t\t\t}\n49|\t\t}\n50|\t}\n51|\treturn TargetEffects{}, nil\n52|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5f3","stream":{"kind":"session","id":"01a0d381-286a-7d03-bf7e-13c4c16a42b5"},"sequence":340,"recorded_at":1780531400000675,"record_type":"event","durability":"durable","causation_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","run_stream":{"kind":"run","id":"4603a868-01f4-4025-8e84-c5ce1f2882d9"},"call_id":"call_01a0d382066571f18f541e6d0f118aad","text":"Read text file `internal/cloneplanning/doc.go`.\n1|package cloneplanning\n2|\n3|// This package plans the pair-neutral target projection: strategy\n4|// and profile selection, per-item expected dispositions with reason\n5|// sets, checkpoint visible-text authority, historical-tool\n6|// inertness, and source/target usage separation. It is the third\n7|// leaf of the fidelity-projection-and-validation-contracts story:\n8|// planning semantics only. Closed shapes stay owned by the schema\n9|// siblings (internal/clonefidelity dispositions/reasons,\n10|// internal/cloneplan Projection Plan and Projected Object Manifest,\n11|// internal/clonebundle capture/canonical contracts,\n12|// internal/cloneproject G1 normalization); this package decides,\n13|// never re-validates, their shapes.\n14|//\n15|// Authority: relux-works/agent-session-manager-spec@v0.7.0,\n16|// Section 13.14.1 (internal/specdoc/SPEC.v0.7.0.md, lines\n17|// 10385-10393: event kinds, content blocks, \"Historical tools are\n18|// inert; incomplete calls become aborted history\", \"Foreign\n19|// instructions are low-authority history, foreign encrypted/signed\n20|// reasoning is opaque-preserved, and source usage is not target\n21|// accounting\") and Section 13.14.2 (lines 10548-10570:\n22|// dispositions, reasons, profiles, strategies, \"Continuation\n23|// context is explicitly non-native historical fidelity\"), the\n24|// Projection Plan 1.0.0 table (strategy/profile four-lists), the\n25|// projection-plan adapter contract (\"archive_only is forbidden\",\n26|// line 3841), and Migration Checkpoint VisibleMigrationProjection\n27|// (lines 10808-10812: \"authority=user_context\", \"never an\n28|// assistant reply, system instruction, or authorization\",\n29|// \"Visible text comes from typed escaped fields and is user\n30|// context, never an assistant reply or control instruction\").\n31|//\n32|// Production entries: SelectStrategy, SelectProfile, ClassifyItem,\n33|// PlanItem, PlanSession, ProjectVisibleText, EscapeVisibleText, and\n34|// PlanTargetEffects. Every rule is driven through these entries by\n35|// a whole-domain oracle written in the tests from the derivation in\n36|// TRACEABILITY.md; every gate ships a narrowing mutant killed by\n37|// its named test run alone (see\n38|// testdata/mutant_harness.py). Authority is decided by type, never\n39|// by text: the visible authority is one constant, the item\n40|// classifier admits closed vocabularies only, and the structural\n41|// test pins that shape with control plants.\n42|//\n43|// Reuse, not fork: strategy/profile/disposition/reason/event-kind/\n44|// block vocabularies delegate to internal/clonefidelity,\n45|// internal/cloneplan, and internal/clonebundle; target-branch\n46|// admission (unstable refusal, maximal-safe completeness) stays\n47|// with clonesnap.AdmitForTarget and the clonebundle G2 gates;\n48|// G1 tool/instruction/usage folds stay with internal/cloneproject\n49|// (this package consumes the completed/aborted and\n50|// encrypted/signed facts it lands); character measures and uint53\n51|// come from internal/environ and internal/scalar. The fact names\n52|// ClassifyItem reads (resolution, protection) follow cloneproject's\n53|// landed registry; value vocabularies are gated here.\n54|//\n55|// Stated bounds (sibling scope or spec-silent, not waived): target\n56|// operation synthesis from dispositions; source-condition reasons\n57|// (source_not_persisted, source_truncated, source_corrupt) and\n58|// target-condition reasons (target_schema_constraint,\n59|// target_size_limit, target_version_gate, credential_excluded,\n60|// secret_policy, derived_index_rebuilt) need inputs the item axis\n61|// does not carry; capability-gated degradation beyond the tool and\n62|// subagent importer classes; per-kind text-field extraction (the\n63|// visible entry takes extracted typed texts); the full Migration\n64|// Checkpoint Build/Decode shape (a future leaf seals it from the\n65|// authority value pinned here); cross-package payload fact-name\n66|// renames past the grep pin. See TRACEABILITY.md.","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5f5","stream":{"kind":"session","id":"01a0d381-286a-7d03-bf7e-13c4c16a42b5"},"sequence":341,"recorded_at":1780531400000677,"record_type":"event","durability":"durable","causation_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","run_stream":{"kind":"run","id":"4603a868-01f4-4025-8e84-c5ce1f2882d9"},"call_id":"call_01a0d38207d47504bf68ceea668c5b98","text":"Read text file `internal/cloneplanning/errors.go`.\n1|package cloneplanning\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|)\n7|\n8|// ErrInvalid is the refusal for every malformed planning input:\n9|// unknown strategies, profiles, item classes, or fact values,\n10|// archive-branch target planning, strict-exact non-exact items,\n11|// and malformed visible-projection inputs. Callers match with\n12|// errors.Is; the message names the offending member.\n13|var ErrInvalid = errors.New(\"cloneplanning: invalid projection planning input\")\n14|\n15|func invalid(format string, arguments ...any) error {\n16|\treturn fmt.Errorf(\"%w: %s\", ErrInvalid, fmt.Sprintf(format, arguments...))\n17|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
