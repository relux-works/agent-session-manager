nRecord{}, nil, invalid(\"%s source_item_key is not valid UTF-8\", owner)\n88|\t}\n89|\tif length := stringLength(input.SourceItemKey); length < 1 || length > 512 {\n90|\t\treturn DispositionRecord{}, nil, invalid(\"%s source_item_key is not a string[1..512]\", owner)\n91|\t}\n92|\tif !validText(input.SourceClass) {\n93|\t\treturn DispositionRecord{}, nil, invalid(\"%s source_class is not valid UTF-8\", owner)\n94|\t}\n95|\tif length := stringLength(input.SourceClass); length < 1 || length > 128 {\n96|\t\treturn DispositionRecord{}, nil, invalid(\"%s source_class is not a string[1..128]\", owner)\n97|\t}\n98|\tevidence, err := parseSortedUniqueDigestStrings(input.SourceEvidenceIDs, 1, 65536, owner, \"source_evidence_ids\")\n99|\tif err != nil {\n100|\t\treturn DispositionRecord{}, nil, err\n101|\t}\n102|\tvar canonical *scalar.Digest\n103|\tvar canonicalValue any\n104|\tif input.CanonicalObjectID != nil {\n105|\t\tid, err := scalar.ParseDigest(*input.CanonicalObjectID)\n106|\t\tif err != nil {\n107|\t\t\treturn DispositionRecord{}, nil, invalid(\"%s canonical_object_id is not a digest: %v\", owner, err)\n108|\t\t}\n109|\t\tcanonical = &id\n110|\t\tcanonicalValue = id.String()\n111|\t}\n112|\tvar locator *string\n113|\tvar locatorValue any\n114|\tif input.TargetLocator != nil {\n115|\t\tif !validText(*input.TargetLocator) {\n116|\t\t\treturn DispositionRecord{}, nil, invalid(\"%s target_locator is not valid UTF-8\", owner)\n117|\t\t}\n118|\t\tif length := stringLength(*input.TargetLocator); length < 1 || length > 1024 {\n119|\t\t\treturn DispositionRecord{}, nil, invalid(\"%s target_locator is not a string[1..1024]\", owner)\n120|\t\t}\n121|\t\tlocator = input.TargetLocator\n122|\t\tlocatorValue = *input.TargetLocator\n123|\t}\n124|\tif !ValidDisposition(input.Disposition) {\n125|\t\treturn DispositionRecord{}, nil, invalid(\"%s disposition %q is outside exact|semantic|summarized|opaque_preserved|synthesized|omitted|unrecoverable\", owner, input.Disposition)\n126|\t}\n127|\treasons, err := checkSortedUniqueReasonStrings(input.ReasonCodes, 0, 128, owner)\n128|\tif err != nil {\n129|\t\treturn DispositionRecord{}, nil, err\n130|\t}\n131|\tif err := checkRecordReasonRule(owner, input.Disposition, len(reasons)); err != nil {\n132|\t\treturn DispositionRecord{}, nil, err\n133|\t}\n134|\tif err := checkRecordCanonicalRule(owner, input.Disposition, canonical != nil); err != nil {\n135|\t\treturn DispositionRecord{}, nil, err\n136|\t}\n137|\tif !validText(input.Explanation) {\n138|\t\treturn DispositionRecord{}, nil, invalid(\"%s explanation is not valid UTF-8\", owner)\n139|\t}\n140|\tif length := stringLength(input.Explanation); length < 1 || length > 4096 {\n141|\t\treturn DispositionRecord{}, nil, invalid(\"%s explanation is not a string[1..4096]\", owner)\n142|\t}\n143|\tstaged, err := parseSortedUniqueDigestStrings(input.StagedEvidenceObjectIDs, 0, 65536, owner, \"staged_evidence_object_ids\")\n144|\tif err != nil {\n145|\t\treturn DispositionRecord{}, nil, err\n146|\t}\n147|\tlive, err := parseSortedUniqueDigestStrings(input.LiveEvidenceObjectIDs, 0, 65536, owner, \"live_evidence_object_ids\")\n148|\tif err != nil {\n149|\t\treturn DispositionRecord{}, nil, err\n150|\t}\n151|\tif _, err := clonebundle.EncodeExtensions(input.Extensions); err != nil {\n152|\t\treturn DispositionRecord{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n153|\t}\n154|\textensions := input.Extensions\n155|\tif extensions == nil {\n156|\t\textensions = map[string]any{}\n157|\t}\n158|\trecord := DispositionRecord{\n159|\t\tSourceItemKey:           input.SourceItemKey,\n160|\t\tSourceClass:             input.SourceClass,\n161|\t\tSourceEvidenceIDs:       evidence,\n162|\t\tCanonicalObjectID:       canonical,\n163|\t\tTargetLocator:           locator,\n164|\t\tDisposition:             input.Disposition,\n165|\t\tReasonCodes:             reasons,\n166|\t\tExplanation:             input.Explanation,\n167|\t\tStagedEvidenceObjectIDs: staged,\n168|\t\tLiveEvidenceObjectIDs:   live,\n169|\t}\n170|\tobject := map[string]any{\n171|\t\t\"source_item_key\":            input.SourceItemKey,\n172|\t\t\"source_class\":               input.SourceClass,\n173|\t\t\"source_evidence_ids\":        digestStrings(evidence),\n174|\t\t\"canonical_object_id\":        canonicalValue,\n175|\t\t\"target_locator\":             locatorValue,\n176|\t\t\"disposition\":                input.Disposition,\n177|\t\t\"reason_codes\":               stringValues(reasons),\n178|\t\t\"explanation\":                input.Explanation,\n179|\t\t\"staged_evidence_object_ids\": digestStrings(staged),\n180|\t\t\"live_evidence_object_ids\":   digestStrings(live),\n181|\t\t\"extensions\":                 extensions,\n182|\t}\n183|\treturn record, object, nil\n184|}\n185|\n186|// checkRecordReasonRule enforces the reason-set rule both entries\n187|// share: exact requires an empty reason set and every other\n188|// disposition at least one reason.\n189|func checkRecordReasonRule(owner, disposition string, reasonCount int) error {\n190|\tif disposition == \"exact\" {\n191|\t\tif reasonCount != 0 {\n192|\t\t\treturn invalid(\"%s exact carries %d reason_codes, want an empty reason set\", owner, reasonCount)\n193|\t\t}\n194|\t\treturn nil\n195|\t}\n196|\tif reasonCount < 1 {\n197|\t\treturn invalid(\"%s %s carries no reason_codes, want at least one reason\", owner, disposition)\n198|\t}\n199|\treturn nil\n200|}\n201|\n202|// checkRecordCanonicalRule enforces the canonical-object rule both\n203|// entries share: synthesized requires no source canonical object.\n204|// Non-synthesized rows admit a digest or null: capture items that\n205|// never normalized (omitted, unrecoverable) carry null, canonical\n206|// events carry their object ID.\n207|func checkRecordCanonicalRule(owner, disposition string, hasCanonical bool) error {\n208|\tif disposition == \"synthesized\" && hasCanonical {\n209|\t\treturn invalid(\"%s synthesized carries a source canonical object\", owner)\n210|\t}\n211|\treturn nil\n212|}\n213|\n214|// decodeDispositionRecord validates one closed disposition row:\n215|// exact members, bounded scalars, the disposition and reason\n216|// vocabularies, sorted-unique arrays, the exact/synthesized rules,\n217|// and closed extensions.\n218|func decodeDispositionRecord(raw json.RawMessage, index int) (DispositionRecord, error) {\n219|\towner := \"fidelity disposition record\"\n220|\tmembers, fault := decodeStrictObject(raw)\n221|\tif fault != nil {\n222|\t\treturn DispositionRecord{}, invalid(\"%s[%d] %s (%s)\", owner, index, fault.detail, memberField(fault.member))\n223|\t}\n224|\tif name, unknown := unknownMember(members, dispositionRecordMembers); unknown {\n225|\t\treturn DispositionRecord{}, invalid(\"%s[%d] carries unknown member %q\", owner, index, name)\n226|\t}\n227|\tif name, missing := missingMember(members, dispositionRecordRequired); missing {\n228|\t\treturn DispositionRecord{}, invalid(\"%s[%d] misses a required member %q\", owner, index, name)\n229|\t}\n230|\tkey, ok := checkStringBounds(members[\"source_item_key\"], 1, 512)\n231|\tif !ok {\n232|\t\treturn DispositionRecord{}, invalid(\"%s[%d] source_item_key is not a string[1..512]\", owner, index)\n233|\t}\n234|\tclass, ok := checkStringBounds(members[\"source_class\"], 1, 128)\n235|\tif !ok {\n236|\t\treturn DispositionRecord{}, invalid(\"%s[%d] source_class is not a string[1..128]\", owner, index)\n237|\t}\n238|\tevidence, ok := checkSortedUniqueDigests(members[\"source_evidence_ids\"], 1, 65536)\n239|\tif !ok {\n240|\t\treturn DispositionRecord{}, invalid(\"%s[%d] source_evidence_ids are not sorted unique digest[1..65536]\", owner, index)\n241|\t}\n242|\tvar canonical *scalar.Digest\n243|\tif !isNull(members[\"canonical_object_id\"]) {\n244|\t\tid, ok := checkDigest(members[\"canonical_object_id\"])\n245|\t\tif !ok {\n246|\t\t\treturn DispositionRecord{}, invalid(\"%s[%d] canonical_object_id is not a digest or null\", owner, index)\n247|\t\t}\n248|\t\tcanonical = &id\n249|\t}\n250|\tvar locator *string\n251|\tif !isNull(members[\"target_locator\"]) {\n252|\t\tvalue, ok := checkStringBounds(members[\"target_locator\"], 1, 1024)\n253|\t\tif !ok {\n254|\t\t\treturn DispositionRecord{}, invalid(\"%s[%d] target_locator is not a string[1..1024] or null\", owner, index)\n255|\t\t}\n256|\t\tlocator = &value\n257|\t}\n258|\tdisposition, ok := rawString(members[\"disposition\"])\n259|\tif !ok || !ValidDisposition(disposition) {\n260|\t\treturn DispositionRecord{}, invalid(\"%s[%d] disposition is outside exact|semantic|summarized|opaque_preserved|synthesized|omitted|unrecoverable\", owner, index)\n261|\t}\n262|\treasons, ok := checkSortedUniqueStrings(members[\"reason_codes\"], 1, 128, 0, 128)\n263|\tif !ok {\n264|\t\treturn DispositionRecord{}, invalid(\"%s[%d] reason_codes are not sorted unique string[1..128][0..128]\", owner, index)\n265|\t}\n266|\tfor _, reason := range reasons {\n267|\t\tif !ValidReasonCode(reason) {\n268|\t\t\treturn DispositionRecord{}, invalid(\"%s[%d] reason_codes carry %q outside the core and reverse-DNS reason vocabulary\", owner, index, reason)\n269|\t\t}\n270|\t}\n271|\trowOwner := fmt.Sprintf(\"%s[%d]\", owner, index)\n272|\tif err := checkRecordReasonRule(rowOwner, disposition, len(reasons)); err != nil {\n273|\t\treturn DispositionRecord{}, err\n274|\t}\n275|\tif err := checkRecordCanonicalRule(rowOwner, disposition, canonical != nil); err != nil {\n276|\t\treturn DispositionRecord{}, err\n277|\t}\n278|\texplanation, ok := checkStringBounds(members[\"explanation\"], 1, 4096)\n279|\tif !ok {\n280|\t\treturn DispositionRecord{}, invalid(\"%s[%d] explanation is not a string[1..4096]\", owner, index)\n281|\t}\n282|\tstaged, ok := checkSortedUniqueDigests(members[\"staged_evidence_object_ids\"], 0, 65536)\n283|\tif !ok {\n284|\t\treturn DispositionRecord{}, invalid(\"%s[%d] staged_evidence_object_ids are not sorted unique digest[0..65536]\", owner, index)\n285|\t}\n286|\tlive, ok := checkSortedUniqueDigests(members[\"live_evidence_object_ids\"], 0, 65536)\n287|\tif !ok {\n288|\t\treturn DispositionRecord{}, invalid(\"%s[%d] live_evidence_object_ids are not sorted unique digest[0..65536]\", owner, index)\n289|\t}\n290|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n291|\t\treturn DispositionRecord{}, invalid(\"%s[%d] extensions %s\", owner, index, extensionsFault)\n292|\t}\n293|\treturn DispositionRecord{\n294|\t\tSourceItemKey:           key,\n295|\t\tSourceClass:             class,\n296|\t\tSourceEvidenceIDs:       evidence,\n297|\t\tCanonicalObjectID:       canonical,\n298|\t\tTargetLocator:           locator,\n299|\t\tDisposition:             disposition,\n300|\t\tReasonCodes:             reasons,\n301|\t\tExplanation:             explanation,\n302|\t\tStagedEvidenceObjectIDs: staged,\n303|\t\tLiveEvidenceObjectIDs:   live,\n304|\t}, nil\n305|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6c3","stream":{"kind":"session","id":"01a0d381-286a-7d03-bf7e-13c4c16a42b5"},"sequence":444,"recorded_at":1780531400000883,"record_type":"event","durability":"durable","causation_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","run_stream":{"kind":"run","id":"4603a868-01f4-4025-8e84-c5ce1f2882d9"},"call_id":"call_01a0d382292e75fe94c640c78b2cd7fe","text":"Read text file `internal/clonefidelity/vocab.go`.\n1|package clonefidelity\n2|\n3|import (\n4|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n5|)\n6|\n7|// This file owns the four Section 13.14.2 closed vocabularies: the\n8|// seven dispositions, the five profiles, the five strategies, and\n9|// the nineteen core reason codes plus reverse-DNS extensions. Every\n10|// table is quoted from the pinned specification text; the oracle\n11|// tests retype each list from the spec and sweep admission and\n12|// refusal through the production entries.\n13|\n14|// dispositions is the exact seven-member disposition vocabulary\n15|// Section 13.14.2 states: exact|semantic|summarized|\n16|// opaque_preserved|synthesized|omitted|unrecoverable.\n17|var dispositions = []string{\n18|\t\"exact\",\n19|\t\"semantic\",\n20|\t\"summarized\",\n21|\t\"opaque_preserved\",\n22|\t\"synthesized\",\n23|\t\"omitted\",\n24|\t\"unrecoverable\",\n25|}\n26|\n27|// ValidDisposition reports whether the name is a fidelity\n28|// disposition.\n29|func ValidDisposition(disposition string) bool {\n30|\tfor _, allowed := range dispositions {\n31|\t\tif disposition == allowed {\n32|\t\t\treturn true\n33|\t\t}\n34|\t}\n35|\treturn false\n36|}\n37|\n38|// Dispositions returns the exact seven-member disposition\n39|// vocabulary in specification order. Callers iterate the returned\n40|// copy; the table above stays the single owner.\n41|func Dispositions() []string {\n42|\tout := make([]string, len(dispositions))\n43|\tcopy(out, dispositions)\n44|\treturn out\n45|}\n46|\n47|// profiles is the exact five-member profile vocabulary Section\n48|// 13.14.2 states: strict_exact|maximal_safe|compact|messages_only|\n49|// archive_only. Maximal-safe is default.\n50|var profiles = []string{\n51|\t\"strict_exact\",\n52|\t\"maximal_safe\",\n53|\t\"compact\",\n54|\t\"messages_only\",\n55|\t\"archive_only\",\n56|}\n57|\n58|// ValidProfile reports whether the name is a fidelity profile.\n59|func ValidProfile(profile string) bool {\n60|\tfor _, allowed := range profiles {\n61|\t\tif profile == allowed {\n62|\t\t\treturn true\n63|\t\t}\n64|\t}\n65|\treturn false\n66|}\n67|\n68|// Profiles returns the exact five-member profile vocabulary in\n69|// specification order. Callers iterate the returned copy; the table\n70|// above stays the single owner.\n71|func Profiles() []string {\n72|\tout := make([]string, len(profiles))\n73|\tcopy(out, profiles)\n74|\treturn out\n75|}\n76|\n77|// strategies is the exact five-member strategy vocabulary Section\n78|// 13.14.2 states: same_environment_native_rewrite|\n79|// target_native_writer|target_official_import|continuation_context|\n80|// archive_only. Continuation context is explicitly non-native\n81|// historical fidelity. (The Projection Plan sibling narrows this to\n82|// the four non-archive strategies; this registry owns the full\n83|// Section 13.14.2 list.)\n84|var strategies = []string{\n85|\t\"same_environment_native_rewrite\",\n86|\t\"target_native_writer\",\n87|\t\"target_official_import\",\n88|\t\"continuation_context\",\n89|\t\"archive_only\",\n90|}\n91|\n92|// ValidStrategy reports whether the name is a fidelity strategy.\n93|func ValidStrategy(strategy string) bool {\n94|\tfor _, allowed := range strategies {\n95|\t\tif strategy == allowed {\n96|\t\t\treturn true\n97|\t\t}\n98|\t}\n99|\treturn false\n100|}\n101|\n102|// Strategies returns the exact five-member strategy vocabulary in\n103|// specification order. Callers iterate the returned copy; the table\n104|// above stays the single owner.\n105|func Strategies() []string {\n106|\tout := make([]string, len(strategies))\n107|\tcopy(out, strategies)\n108|\treturn out\n109|}\n110|\n111|// coreReasons is the exact nineteen-member closed core reason list\n112|// Section 13.14.2 states: target_no_equivalent|\n113|// source_not_persisted|source_truncated|source_corrupt|\n114|// foreign_encrypted_payload|foreign_signature_unverifiable|\n115|// target_schema_constraint|target_context_limit|target_size_limit|\n116|// target_version_gate|official_importer_loss|graph_flattened|\n117|// unsafe_pending_action|credential_excluded|secret_policy|\n118|// operator_policy|unsupported_media_type|unknown_native_event|\n119|// derived_index_rebuilt.\n120|var coreReasons = []string{\n121|\t\"target_no_equivalent\",\n122|\t\"source_not_persisted\",\n123|\t\"source_truncated\",\n124|\t\"source_corrupt\",\n125|\t\"foreign_encrypted_payload\",\n126|\t\"foreign_signature_unverifiable\",\n127|\t\"target_schema_constraint\",\n128|\t\"target_context_limit\",\n129|\t\"target_size_limit\",\n130|\t\"target_version_gate\",\n131|\t\"official_importer_loss\",\n132|\t\"graph_flattened\",\n133|\t\"unsafe_pending_action\",\n134|\t\"credential_excluded\",\n135|\t\"secret_policy\",\n136|\t\"operator_policy\",\n137|\t\"unsupported_media_type\",\n138|\t\"unknown_native_event\",\n139|\t\"derived_index_rebuilt\",\n140|}\n141|\n142|// IsCoreReasonCode reports whether the code is one of the nineteen\n143|// closed core reason codes.\n144|func IsCoreReasonCode(code string) bool {\n145|\tfor _, core := range coreReasons {\n146|\t\tif code == core {\n147|\t\t\treturn true\n148|\t\t}\n149|\t}\n150|\treturn false\n151|}\n152|\n153|// CoreReasonCodes returns the exact nineteen-member closed core\n154|// reason list in specification order. Callers iterate the returned\n155|// copy; the table above stays the single owner.\n156|func CoreReasonCodes() []string {\n157|\tout := make([]string, len(coreReasons))\n158|\tcopy(out, coreReasons)\n159|\treturn out\n160|}\n161|\n162|// ValidReasonCode reports whether the code is an admissible reason:\n163|// one of the nineteen closed core codes or a reverse-DNS extension\n164|// reason. An extension can never redefine a core code: core codes\n165|// carry no dot and the reverse-DNS grammar requires one, so the\n166|// two arms are disjoint by construction. Length bounds live at the\n167|// JSON gates (reason_codes items are string[1..128]); this\n168|// predicate is pure vocabulary.\n169|func ValidReasonCode(code string) bool {\n170|\tif IsCoreReasonCode(code) {\n171|\t\treturn true\n172|\t}\n173|\treturn isExtensionReason(code)\n174|}\n175|\n176|// isExtensionReason reports whether the code is a reverse-DNS\n177|// extension reason. It delegates to the single environ grammar so\n178|// extension reasons and extension keys can never drift.\n179|func isExtensionReason(code string) bool {\n180|\treturn environ.CheckReverseDNS(code)\n181|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
