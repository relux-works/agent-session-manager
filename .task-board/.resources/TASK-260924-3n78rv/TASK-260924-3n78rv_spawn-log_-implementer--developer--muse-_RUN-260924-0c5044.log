\\n\\t// whole-domain oracle plus the emitted-valid sweep prove this\\n\\t// arm never fires; PlanSession inherits it per item.\\n\\tif err := checkMappingViaOwner(\\\"projection planner emitted mapping\\\", mapping); err != nil {\\n\\t\\treturn Mapping{}, err\\n\\t}\\n\\treturn mapping, nil\\n'''\\nassert s.count(find) == 1, s.count(find)\\np.write_text(s.replace(find, '''\\treturn Mapping{Disposition: disposition, Reasons: sorted}, nil\\n'''))\\nEOF\\ncp \\\"$S/effects-prefix.go\\\" internal/cloneplanning/effects.go\\ngofmt -l internal/cloneplanning/ prefixdemo/; go test -count=1 -run '^TestPrefixDemoReviewerCells$' ./prefixdemo/ > \\\"$S/prefix-demo-fail.log\\\" 2>&1; echo \\\"prefix-shape exit=$? (want 1)\\\"\\ngrep -m2 'admitted' \\\"$S/prefix-demo-fail.log\\\"\\ncp \\\"$S/effects.fixed\\\" internal/cloneplanning/effects.go\\ncp \\\"$S/plan.fixed\\\" internal/cloneplanning/plan.go\\ncmp internal/cloneplanning/effects.go \\\"$S/effects.fixed\\\" && cmp internal/cloneplanning/plan.go \\\"$S/plan.fixed\\\" && echo \\\"both byte-identical\\\"\\ngo test -count=1 -run '^TestPrefixDemoReviewerCells$' ./prefixdemo/ > \\\"$S/prefix-demo-pass.log\\\" 2>&1; echo \\\"fixed-shape exit=$? (want 0)\\\"\\nrm -rf prefixdemo\\ngit status --porcelain\",\n  \"description\": \"Rerun prefix demo with full prefix shape\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"prefix-shape exit=1 (want 1)\\n    demo_test.go:14: semantic without reasons admitted\\nboth byte-identical\\nfixed-shape exit=0 (want 0)\\n M internal/clonefidelity/record.go\\n?? internal/cloneplanning/\\n\",\n  \"original_output_bytes\": 195,\n  \"original_output_tokens\": 49,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
