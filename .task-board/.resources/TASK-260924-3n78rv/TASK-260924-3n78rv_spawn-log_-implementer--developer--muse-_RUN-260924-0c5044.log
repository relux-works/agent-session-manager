{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c687","stream":{"kind":"session","id":"01a0d381-286a-7d03-bf7e-13c4c16a42b5"},"sequence":414,"recorded_at":1780531400000823,"record_type":"event","durability":"durable","causation_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","run_stream":{"kind":"run","id":"4603a868-01f4-4025-8e84-c5ce1f2882d9"},"call_id":"call_01a0d3821a6470d68a4441bb88aefe2e","text":"Read text file `internal/cloneplanning/visible.go`.\n1|package cloneplanning\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"strings\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// This file projects checkpoint visible text: typed text fields\n13|// are escaped per field and joined, and the projection authority\n14|// is one constant. Authority is decided by type, never by text:\n15|// ProjectVisibleText assigns Authority exactly once from\n16|// authorityUserContext with no condition on the text, kind,\n17|// ordinal, or event IDs, and the structural test pins that shape\n18|// with control plants. Escaped output round-trips through\n19|// encoding/json to exactly the input fields, so no instruction,\n20|// reply, control token, or authorization is added or interpreted.\n21|\n22|// authorityUserContext is the only visible-projection authority\n23|// Section 13.14.2 admits: VisibleMigrationProjection carries\n24|// exactly authority=user_context, never an assistant reply, system\n25|// instruction, or authorization.\n26|const authorityUserContext = \"user_context\"\n27|\n28|// maxEscapedText is the escaped_text character bound Section\n29|// 13.14.2 states: string[1..65536], measured in characters.\n30|const maxEscapedText = 65536\n31|\n32|// maxVisibleEventIDs bounds the target event IDs Section 13.14.2\n33|// states: sorted unique digest[1..64].\n34|const maxVisibleEventIDs = 64\n35|\n36|// VisibleInput is one checkpoint visible-projection candidate: the\n37|// carrying event kind, the event ordinal, the extracted typed text\n38|// fields, and the shown target event IDs. Per-kind text-field\n39|// extraction is caller scope; this entry takes the extracted texts.\n40|type VisibleInput struct {\n41|\tKind     string\n42|\tOrdinal  uint64\n43|\tTexts    []string\n44|\tEventIDs []string\n45|}\n46|\n47|// VisibleProjection is one projected checkpoint visible text: its\n48|// low authority, the event ordinal, the per-field escaped text,\n49|// and the shown target event IDs.\n50|type VisibleProjection struct {\n51|\tAuthority   string\n52|\tOrdinal     uint64\n53|\tEscapedText string\n54|\tEventIDs    []string\n55|}\n56|\n57|// EscapeVisibleText escapes one typed text field as a JSON string\n58|// literal. The field must be valid UTF-8 first: encoding/json\n59|// would otherwise rewrite invalid bytes as U+FFFD and succeed,\n60|// returning a value whose text differs from its input. The output\n61|// parses through encoding/json to exactly the input; control\n62|// characters, quotes, and markup delimiters never cross raw.\n63|func EscapeVisibleText(field string) (string, error) {\n64|\tif !validText(field) {\n65|\t\treturn \"\", invalid(\"visible text field is not valid UTF-8\")\n66|\t}\n67|\tsealed, err := json.Marshal(field)\n68|\tif err != nil {\n69|\t\treturn \"\", invalid(\"visible text field does not escape: %v\", err)\n70|\t}\n71|\treturn string(sealed), nil\n72|}\n73|\n74|// ProjectVisibleText projects one checkpoint visible text. The\n75|// kind must be a Canonical Event kind, the ordinal a uint53, every\n76|// text field valid UTF-8, the joined escaped text within\n77|// string[1..65536] characters, and the event IDs sorted unique\n78|// digests[1..64]. The authority is always user_context.\n79|func ProjectVisibleText(input VisibleInput) (VisibleProjection, error) {\n80|\tif !validText(input.Kind) {\n81|\t\treturn VisibleProjection{}, invalid(\"visible projection kind is not valid UTF-8\")\n82|\t}\n83|\tif !clonebundle.ValidEventKind(input.Kind) {\n84|\t\treturn VisibleProjection{}, invalid(\"visible projection kind %q is not a Canonical Event kind\", input.Kind)\n85|\t}\n86|\tif _, err := scalar.NewUint53(input.Ordinal); err != nil {\n87|\t\treturn VisibleProjection{}, invalid(\"visible projection ordinal %d is not a uint53: %v\", input.Ordinal, err)\n88|\t}\n89|\tfor index, field := range input.Texts {\n90|\t\tif !validText(field) {\n91|\t\t\treturn VisibleProjection{}, invalid(\"visible projection text field[%d] is not valid UTF-8\", index)\n92|\t\t}\n93|\t}\n94|\tescaped := make([]string, 0, len(input.Texts))\n95|\tfor _, field := range input.Texts {\n96|\t\tquoted, err := EscapeVisibleText(field)\n97|\t\tif err != nil {\n98|\t\t\treturn VisibleProjection{}, err\n99|\t\t}\n100|\t\tescaped = append(escaped, quoted)\n101|\t}\n102|\tjoined := strings.Join(escaped, \"\\n\")\n103|\tif length := environ.StringLength(joined); length < 1 || length > maxEscapedText {\n104|\t\treturn VisibleProjection{}, invalid(\"visible projection escaped_text carries %d characters, the checkpoint requires string[1..65536]\", length)\n105|\t}\n106|\tids, err := checkVisibleEventIDs(input.EventIDs)\n107|\tif err != nil {\n108|\t\treturn VisibleProjection{}, err\n109|\t}\n110|\treturn VisibleProjection{\n111|\t\tAuthority:   authorityUserContext,\n112|\t\tOrdinal:     input.Ordinal,\n113|\t\tEscapedText: joined,\n114|\t\tEventIDs:    ids,\n115|\t}, nil\n116|}\n117|\n118|// checkVisibleEventIDs validates the shown target event IDs:\n119|// sorted unique digests[1..64]. Digest grammar delegates to the\n120|// scalar owner; order and count are this entry's composition.\n121|func checkVisibleEventIDs(ids []string) ([]string, error) {\n122|\tif len(ids) < 1 || len(ids) > maxVisibleEventIDs {\n123|\t\treturn nil, invalid(\"visible projection carries %d target event IDs, the checkpoint requires sorted unique digest[1..64]\", len(ids))\n124|\t}\n125|\tchecked := make([]string, 0, len(ids))\n126|\tfor index, id := range ids {\n127|\t\tif !validText(id) {\n128|\t\t\treturn nil, invalid(\"visible projection target event ID[%d] is not valid UTF-8\", index)\n129|\t\t}\n130|\t\tdigest, err := scalar.ParseDigest(id)\n131|\t\tif err != nil {\n132|\t\t\treturn nil, invalid(\"visible projection target event ID[%d] is not a digest: %v\", index, err)\n133|\t\t}\n134|\t\tchecked = append(checked, digest.String())\n135|\t}\n136|\tfor index := 1; index < len(checked); index++ {\n137|\t\tif checked[index-1] >= checked[index] {\n138|\t\t\treturn nil, invalid(\"visible projection target event IDs are not sorted unique\")\n139|\t\t}\n140|\t}\n141|\treturn checked, nil\n142|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
