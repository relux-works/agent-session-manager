{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c777","stream":{"kind":"session","id":"01a0d381-286a-7d03-bf7e-13c4c16a42b5"},"sequence":534,"recorded_at":1780531400001063,"record_type":"event","durability":"durable","causation_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","run_stream":{"kind":"run","id":"4603a868-01f4-4025-8e84-c5ce1f2882d9"},"task_stream":{"kind":"task","id":"01a0d382-fca1-72c3-a01c-bec3347ab42a"},"task_id":"01a0d382-fca1-72c3-a01c-bec3347ab42a","event":{"kind":"output","task_id":"01a0d382-fca1-72c3-a01c-bec3347ab42a","chunk":"Read text file `internal/clonefidelity/report.go`.\n(213 line(s) above)\n214|type FidelityReport struct {\n215|\tReportID                         scalar.Digest\n216|\tScope                            string\n217|\tOperationID                      scalar.UUIDv7\n218|\tBundleID                         scalar.UUIDv7\n219|\tSourceSnapshotDigest             scalar.Digest\n220|\tCaptureManifestID                scalar.Digest\n221|\tCanonicalSessionID               scalar.Digest\n222|\tProjectionPlanID                 *scalar.Digest\n223|\tSourceEnvironment                sessadapter.Tuple\n224|\tTargetEnvironment                *sessadapter.Tuple\n225|\tProfile                          string\n226|\tRequiredDispositions             map[string][]string\n227|\tForbidReasons                    []string\n228|\tRows                             []DispositionRecord\n229|\tCounts                           FidelityCounts\n230|\tEventKindCounts                  map[string]FidelityCounts\n231|\tContentBlockCounts               map[string]FidelityCounts\n232|\tByteCounts                       map[string]uint64\n233|\tReasonCounts                     map[string]uint64\n234|\tRawBundleComplete                bool\n235|\tCanonicalComplete                bool\n236|\tTargetSemanticallyContinuable    bool\n237|\tTargetNativelyResumable          bool\n238|\tStagedReadBackEvidenceManifestID *scalar.Digest\n239|\tLiveReadBackEvidenceManifestID   *scalar.Digest\n240|\tAdapterAttestations              []scalar.Digest\n241|}\n242|\n243|// FidelityReportInput is the caller-supplied fidelity report\n244|// candidate for Build. Counts and reason counts are derived from\n245|// Rows and are never accepted; the per-kind, per-block, and\n246|// per-disposition breakdowns are caller-supplied and reconciled.\n247|// Nil digest pointers and empty TargetEnvironment seal as null.\n248|type FidelityReportInput struct {\n249|\tScope                            string\n250|\tOperationID                      string\n251|\tBundleID                         string\n252|\tSourceSnapshotDigest             string\n253|\tCaptureManifestID                string\n254|\tCanonicalSessionID               string\n255|\tProjectionPlanID                 *string\n256|\tSourceEnvironment                []byte\n257|\tTargetEnvironment                []byte\n258|\tProfile                          string\n259|\tRequiredDispositions             map[string][]string\n260|\tForbidReasons                    []string\n261|\tRows                             []DispositionRecordInput\n262|\tEventKindCounts                  map[string]FidelityCounts\n263|\tContentBlockCounts               map[string]FidelityCounts\n264|\tByteCounts                       map[string]uint64\n265|\tRawBundleComplete                bool\n266|\tCanonicalComplete                bool\n267|\tTargetSemanticallyContinuable    bool\n268|\tTargetNativelyResumable          bool\n269|\tStagedReadBackEvidenceManifestID *string\n270|\tLiveReadBackEvidenceManifestID   *string\n271|\tAdapterAttestations              []string\n272|\tExtensions                       map[string]any\n273|}\n274|\n275|// BuildFidelityReport constructs one closed Fidelity Report 1.0.0\n276|// as canonical bytes. Identical inputs produce byte-identical\n277|// outputs. Counts and reason counts derive from the rows; every\n278|// other closed-shape, vocabulary, branch, order, and reconciliation\n279|// rule is a refusal, never a repair.\n280|func BuildFidelityReport(input FidelityReportInput) ([]byte, error) {\n281|\t_, object, err := buildFidelityReport(input)\n282|\tif err != nil {\n283|\t\treturn nil, err\n284|\t}\n285|\tomitted, err := canonicalizeObject(object)\n286|\tif err != nil {\n287|\t\treturn nil, err\n288|\t}\n289|\treportID := scalar.SHA256Digest(omitted)\n290|\tobject[fidelityReportSelf] = reportID.String()\n291|\treturn canonicalizeObject(object)\n292|}\n293|\n294|func buildFidelityReport(input FidelityReportInput) (FidelityReport, map[string]any, error) {\n295|\towner := \"fidelity report\"\n296|\tarchive := false\n297|\tswitch input.Scope {\n298|\tcase \"archive\":\n299|\t\tarchive = true\n300|\tcase \"target\":\n301|\tdefault:\n302|\t\treturn FidelityReport{}, nil, invalid(\"%s scope is outside archive|target\", owner)\n303|\t}\n304|\toperation, err := scalar.ParseUUIDv7(input.OperationID)\n305|\tif err != nil {\n306|\t\treturn FidelityReport{}, nil, invalid(\"%s operation_id is not a UUIDv7: %v\", owner, err)\n307|\t}\n308|\tbundle, err := scalar.ParseUUIDv7(input.BundleID)\n309|\tif err != nil {\n310|\t\treturn FidelityReport{}, nil, invalid(\"%s bundle_id is not a UUIDv7: %v\", owner, err)\n311|\t}\n312|\tsnapshot, err := scalar.ParseDigest(input.SourceSnapshotDigest)\n313|\tif err != nil {\n314|\t\treturn FidelityReport{}, nil, invalid(\"%s source_snapshot_digest is not a digest: %v\", owner, err)\n315|\t}\n316|\tcaptureID, err := scalar.ParseDigest(input.CaptureManifestID)\n317|\tif err != nil {\n318|\t\treturn FidelityReport{}, nil, invalid(\"%s capture_manifest_id is not a digest: %v\", owner, err)\n319|\t}\n320|\tcanonicalID, err := scalar.ParseDigest(input.CanonicalSessionID)\n321|\tif err != nil {\n322|\t\treturn FidelityReport{}, nil, invalid(\"%s canonical_session_id is not a digest: %v\", owner, err)\n323|\t}\n324|\tvar plan *scalar.Digest\n325|\tvar planValue any\n326|\tif archive {\n327|\t\tif input.ProjectionPlanID != nil {\n328|\t\t\treturn FidelityReport{}, nil, invalid(\"%s projection_plan_id is not null for archive\", owner)\n329|\t\t}\n330|\t} else {\n331|\t\tif input.ProjectionPlanID == nil {\n332|\t\t\treturn FidelityReport{}, nil, invalid(\"%s projection_plan_id is null for target\", owner)\n333|\t\t}\n334|\t\tid, err := scalar.ParseDigest(*input.ProjectionPlanID)\n335|\t\tif err != nil {\n336|\t\t\treturn FidelityReport{}, nil, invalid(\"%s projection_plan_id is not a digest: %v\", owner, err)\n337|\t\t}\n338|\t\tplan = &id\n339|\t\tplanValue = id.String()\n340|\t}\n341|\tsourceTuple, err := sessadapter.DecodeTuple(json.RawMessage(input.SourceEnvironment))\n342|\tif err != nil {\n343|\t\treturn FidelityReport{}, nil, invalid(\"%s source_environment is not an Environment Tuple: %v\", owner, err)\n344|\t}\n345|\tvar targetTuple *sessadapter.Tuple\n346|\tvar targetValue any\n347|\tif archive {\n348|\t\tif len(input.TargetEnvironment) != 0 {\n349|\t\t\treturn FidelityReport{}, nil, invalid(\"%s target_environment is not null for archive\", owner)\n350|\t\t}\n351|\t} else {\n352|\t\ttuple, err := sessadapter.DecodeTuple(json.RawMessage(input.TargetEnvironment))\n353|\t\tif err != nil {\n354|\t\t\treturn FidelityReport{}, nil, invalid(\"%s target_environment is not an Environment Tuple: %v\", owner, err)\n355|\t\t}\n356|\t\ttargetTuple = &tuple\n357|\t\ttargetValue = tupleObject(tuple)\n358|\t}\n359|\tif !ValidProfile(input.Profile) {\n360|\t\treturn FidelityReport{}, nil, invalid(\"%s profile %q is outside strict_exact|maximal_safe|compact|messages_only|archive_only\", owner, input.Profile)\n361|\t}\n362|\tif archive && input.Profile != \"archive_only\" {\n363|\t\treturn FidelityReport{}, nil, invalid(\"%s profile is %q for archive, want archive_only\", owner, input.Profile)\n364|\t}\n365|\tif !archive && input.Profile == \"archive_only\" {\n366|\t\treturn FidelityReport{}, nil, invalid(\"%s profile is archive_only for target\", owner)\n367|\t}\n368|\trequired, err := buildRequiredDispositions(input.RequiredDispositions)\n369|\tif err != nil {\n370|\t\treturn FidelityReport{}, nil, err\n371|\t}\n372|\tforbidden, err := checkSortedUniqueBoundedStrings(input.ForbidReasons, 1, 128, 0, 128, owner, \"forbid_reasons\")\n373|\tif err != nil {\n374|\t\treturn FidelityReport{}, nil, err\n375|\t}\n376|\tif err := checkRowCount(len(input.Rows)); err != nil {\n377|\t\treturn FidelityReport{}, nil, err\n378|\t}\n379|\trows := make([]DispositionRecord, 0, len(input.Rows))\n380|\tobjects := make([]any, 0, len(input.Rows))\n381|\tfor index, candidate := range input.Rows {\n382|\t\trow, object, err := buildDispositionRecord(candidate, index)\n383|\t\tif err != nil {\n384|\t\t\treturn FidelityReport{}, nil, err\n385|\t\t}\n386|\t\trows = append(rows, row)\n387|\t\tobjects = append(objects, object)\n388|\t}\n389|\tif err := checkRowOrder(rows); err != nil {\n390|\t\treturn FidelityReport{}, nil, err\n391|\t}\n392|\tcounts := deriveCounts(rows)\n393|\treasonCounts := deriveReasonCounts(rows)\n(more lines below)","final_result":true}}}
