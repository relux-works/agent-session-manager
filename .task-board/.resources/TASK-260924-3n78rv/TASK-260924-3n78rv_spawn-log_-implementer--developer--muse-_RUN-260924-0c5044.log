{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5ed","stream":{"kind":"session","id":"01a0d381-286a-7d03-bf7e-13c4c16a42b5"},"sequence":337,"recorded_at":1780531400000669,"record_type":"event","durability":"durable","causation_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","run_stream":{"kind":"run","id":"4603a868-01f4-4025-8e84-c5ce1f2882d9"},"task_stream":{"kind":"task","id":"01a0d382-0a1f-73d0-8bb9-880f0dd89ccd"},"task_id":"01a0d382-0a1f-73d0-8bb9-880f0dd89ccd","event":{"kind":"output","task_id":"01a0d382-0a1f-73d0-8bb9-880f0dd89ccd","chunk":"Read text file `internal/cloneplanning/errors.go`.\n1|package cloneplanning\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|)\n7|\n8|// ErrInvalid is the refusal for every malformed planning input:\n9|// unknown strategies, profiles, item classes, or fact values,\n10|// archive-branch target planning, strict-exact non-exact items,\n11|// and malformed visible-projection inputs. Callers match with\n12|// errors.Is; the message names the offending member.\n13|var ErrInvalid = errors.New(\"cloneplanning: invalid projection planning input\")\n14|\n15|func invalid(format string, arguments ...any) error {\n16|\treturn fmt.Errorf(\"%w: %s\", ErrInvalid, fmt.Sprintf(format, arguments...))\n17|}","final_result":true}}}
