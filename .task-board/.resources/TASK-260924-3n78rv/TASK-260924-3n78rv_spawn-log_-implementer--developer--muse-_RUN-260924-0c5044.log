{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb1d","stream":{"kind":"session","id":"01a0d381-286a-7d03-bf7e-13c4c16a42b5"},"sequence":1001,"recorded_at":1780531400001997,"record_type":"event","durability":"durable","causation_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","run_stream":{"kind":"run","id":"4603a868-01f4-4025-8e84-c5ce1f2882d9"},"task_stream":{"kind":"task","id":"01a0d388-11b1-7023-825c-72ecac697138"},"task_id":"01a0d388-11b1-7023-825c-72ecac697138","event":{"kind":"output","task_id":"01a0d388-11b1-7023-825c-72ecac697138","chunk":"{\n  \"chunk_id\": \"exec-26-1\",\n  \"command\": \"sed -n 260,400p .github/workflows/ci.yml; echo ===; grep -c \\\"\\\" .github/workflows/ci.yml\",\n  \"description\": \"Read final CI workflow part\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"            grep '^Fuzz' \\\"fuzz-targets-$(basename \\\"${pkg}\\\").log\\\" | sed \\\"s|^|${pkg} |\\\" >> fuzz-targets.clean\\n          done\\n          test -s fuzz-targets.clean\\n          test \\\"$(wc -l < fuzz-targets.clean | tr -d ' ')\\\" -eq 13\\n          cat fuzz-targets.clean\\n\\n      # The secconftest leg of that list must equal the cigate.FuzzTargets\\n      # derivation, which maps each target to the production entry it\\n      # drives. Either side drifting — a target without an entry, or an\\n      # entry without a target — fails the diff before any smoke runs.\\n      - name: Check secconftest list matches the target derivation\\n        run: |\\n          set +e\\n          go test ./internal/cigate -run 'TestListedTargetsMatchDerivation|TestFuzzTargetsAreDerivedSorted' -count=1 -v > cigate-targets.log 2>&1\\n          code=$?\\n          set -e\\n          cat cigate-targets.log\\n          test $code -eq 0\\n          for gate in TestListedTargetsMatchDerivation TestFuzzTargetsAreDerivedSorted; do\\n            grep -q \\\"^--- PASS: ${gate}\\\" cigate-targets.log\\n          done\\n\\n      # A -fuzz selector that matches nothing exits 0 with \\\"no fuzz tests\\n      # to fuzz\\\", so exit status alone cannot prove execution. The\\n      # '^fuzz: elapsed' line proves the engine ran; its absence fails.\\n      # It does not prove the mutation phase: at -fuzztime=100x the\\n      # large-corpus targets (secconftest/FuzzRedactCorpus, all four\\n      # canonicaljson targets) spend the budget on baseline coverage and\\n      # never print 'now fuzzing'. Lengthening the budget or shrinking a\\n      # corpus changes that without reddening here.\\n      - name: Smoke each target\\n        run: |\\n          while read -r pkg target; do\\n            go test \\\"./${pkg}\\\" -run='^$' -fuzz=\\\"^${target}$\\\" -fuzztime=100x -parallel=1 -count=1 > \\\"fuzz-$(basename \\\"${pkg}\\\")-${target}.log\\\" 2>&1\\n            grep -q '^fuzz: elapsed' \\\"fuzz-$(basename \\\"${pkg}\\\")-${target}.log\\\"\\n          done < fuzz-targets.clean\\n\\n  capability-claims:\\n    name: Unsupported-capability claim check\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 10\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      # The vocabulary is secconftest's probe set; the gate scans the README\\n      # with every probe forced unavailable — the strongest posture, and\\n      # host-independent: a backticked capability mention that reads as a\\n      # positive availability claim is refused no matter what this host's\\n      # probes would report. CheckAdvertisements reads ProbeState.Available\\n      # from the states it is given, and both postures are driven\\n      # (TestRealREADMECarriesNoPositiveClaim forces all unavailable,\\n      # TestRealREADMEAdmitsWhenAllAvailable forces all available). What\\n      # reaches no availability reader is the live probe outcome:\\n      # ProbeStates feeds only CapabilityIDs, which keeps the IDs and\\n      # drops availability. README prose is never capability evidence\\n      # either way.\\n      - name: Check README with all probes forced unavailable\\n        run: |\\n          set +e\\n          go test ./internal/cigate -run 'TestRealREADMECarriesNoPositiveClaim|TestRealREADMEAdmitsWhenAllAvailable|TestCapabilityIDsAreDerivedSorted|TestPositiveClaimsAreRefused|TestNegatedClaimsAreAdmitted|TestUnclassifiedMentionIsRefused' -count=1 -v > cigate-claims.log 2>&1\\n          code=$?\\n          set -e\\n          cat cigate-claims.log\\n          test $code -eq 0\\n          for gate in TestRealREADMECarriesNoPositiveClaim TestRealREADMEAdmitsWhenAllAvailable TestCapabilityIDsAreDerivedSorted TestPositiveClaimsAreRefused TestNegatedClaimsAreAdmitted TestUnclassifiedMentionIsRefused; do\\n            grep -q \\\"^--- PASS: ${gate}\\\" cigate-claims.log\\n          done\\n\\n  windows-compile-only:\\n    name: Windows compile-only (no execution implied)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 10\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      # Compile-and-vet only: go vet type-checks test files as well, and no\\n      # step here executes a Windows binary. A green here must never be read\\n      # as behaviour executed on Windows.\\n      - name: Compile for Windows\\n        run: GOOS=windows go build ./...\\n\\n      - name: Vet Windows build (includes test files)\\n        run: GOOS=windows go vet ./...\\n\\n  gates-verdict:\\n    name: All gates green, none skipped\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 5\\n    needs:\\n      - contract-preservation\\n      - lint\\n      - test\\n      - race\\n      - coverage\\n      - fixture-matrix\\n      - fuzz-smoke\\n      - capability-claims\\n      - windows-compile-only\\n    if: always()\\n    steps:\\n      - name: Refuse any non-success dependency\\n        run: |\\n          echo '${{ toJSON(needs) }}' > needs.json\\n          jq . needs.json\\n          jq -e 'to_entries | map(select(.value.result != \\\"success\\\")) | length == 0' needs.json\\n===\\n376\\n\",\n  \"original_output_bytes\": 5093,\n  \"original_output_tokens\": 1274,\n  \"truncated\": false\n}","final_result":true}}}
