{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7a9","stream":{"kind":"session","id":"01a0d381-286a-7d03-bf7e-13c4c16a42b5"},"sequence":559,"recorded_at":1780531400001113,"record_type":"event","durability":"durable","causation_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","run_stream":{"kind":"run","id":"4603a868-01f4-4025-8e84-c5ce1f2882d9"},"task_stream":{"kind":"task","id":"01a0d383-17af-7681-bc93-882f83dc3ebc"},"task_id":"01a0d383-17af-7681-bc93-882f83dc3ebc","event":{"kind":"output","task_id":"01a0d383-17af-7681-bc93-882f83dc3ebc","chunk":"Read text file `internal/clonefidelity/report.go`.\n(392 line(s) above)\n393|\treasonCounts := deriveReasonCounts(rows)\n394|\teventKinds, err := buildBreakdown(input.EventKindCounts, clonebundle.EventKinds(), \"event_kind_counts\")\n395|\tif err != nil {\n396|\t\treturn FidelityReport{}, nil, err\n397|\t}\n398|\tif err := checkBreakdownSums(\"fidelity report event_kind_counts\", eventKinds, counts); err != nil {\n399|\t\treturn FidelityReport{}, nil, err\n400|\t}\n401|\tcontentBlocks, err := buildBreakdown(input.ContentBlockCounts, clonebundle.ContentBlockTypes(), \"content_block_counts\")\n402|\tif err != nil {\n403|\t\treturn FidelityReport{}, nil, err\n404|\t}\n405|\tif err := checkBreakdownSums(\"fidelity report content_block_counts\", contentBlocks, counts); err != nil {\n406|\t\treturn FidelityReport{}, nil, err\n407|\t}\n408|\tbyteCounts, err := buildByteCounts(input.ByteCounts)\n409|\tif err != nil {\n410|\t\treturn FidelityReport{}, nil, err\n411|\t}\n412|\tif archive {\n413|\t\tif input.TargetSemanticallyContinuable {\n414|\t\t\treturn FidelityReport{}, nil, invalid(\"%s target_semantically_continuable is true for archive\", owner)\n415|\t\t}\n416|\t\tif input.TargetNativelyResumable {\n417|\t\t\treturn FidelityReport{}, nil, invalid(\"%s target_natively_resumable is true for archive\", owner)\n418|\t\t}\n419|\t}\n420|\tvar staged *scalar.Digest\n421|\tvar stagedValue any\n422|\tvar live *scalar.Digest\n423|\tvar liveValue any\n424|\tif archive {\n425|\t\tif input.StagedReadBackEvidenceManifestID != nil {\n426|\t\t\treturn FidelityReport{}, nil, invalid(\"%s staged_read_back_evidence_manifest_id is not null for archive\", owner)\n427|\t\t}\n428|\t\tif input.LiveReadBackEvidenceManifestID != nil {\n429|\t\t\treturn FidelityReport{}, nil, invalid(\"%s live_read_back_evidence_manifest_id is not null for archive\", owner)\n430|\t\t}\n431|\t} else {\n432|\t\tif input.StagedReadBackEvidenceManifestID == nil {\n433|\t\t\treturn FidelityReport{}, nil, invalid(\"%s staged_read_back_evidence_manifest_id is null for target\", owner)\n434|\t\t}\n435|\t\tstagedID, err := scalar.ParseDigest(*input.StagedReadBackEvidenceManifestID)\n436|\t\tif err != nil {\n437|\t\t\treturn FidelityReport{}, nil, invalid(\"%s staged_read_back_evidence_manifest_id is not a digest: %v\", owner, err)\n438|\t\t}\n439|\t\tstaged = &stagedID\n440|\t\tstagedValue = stagedID.String()\n441|\t\tif input.LiveReadBackEvidenceManifestID == nil {\n442|\t\t\treturn FidelityReport{}, nil, invalid(\"%s live_read_back_evidence_manifest_id is null for target\", owner)\n443|\t\t}\n444|\t\tliveID, err := scalar.ParseDigest(*input.LiveReadBackEvidenceManifestID)\n445|\t\tif err != nil {\n446|\t\t\treturn FidelityReport{}, nil, invalid(\"%s live_read_back_evidence_manifest_id is not a digest: %v\", owner, err)\n447|\t\t}\n448|\t\tlive = &liveID\n449|\t\tliveValue = liveID.String()\n450|\t}\n451|\tattestations, err := parseSortedUniqueDigestStrings(input.AdapterAttestations, 0, 64, owner, \"adapter_attestations\")\n452|\tif err != nil {\n453|\t\treturn FidelityReport{}, nil, err\n454|\t}\n455|\tif _, err := clonebundle.EncodeExtensions(input.Extensions); err != nil {\n456|\t\treturn FidelityReport{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n457|\t}\n458|\textensions := input.Extensions\n459|\tif extensions == nil {\n460|\t\textensions = map[string]any{}\n461|\t}\n462|\treport := FidelityReport{\n463|\t\tScope:                            input.Scope,\n464|\t\tOperationID:                      operation,\n465|\t\tBundleID:                         bundle,\n466|\t\tSourceSnapshotDigest:             snapshot,\n467|\t\tCaptureManifestID:                captureID,\n468|\t\tCanonicalSessionID:               canonicalID,\n469|\t\tProjectionPlanID:                 plan,\n470|\t\tSourceEnvironment:                sourceTuple,\n471|\t\tTargetEnvironment:                targetTuple,\n472|\t\tProfile:                          input.Profile,\n473|\t\tRequiredDispositions:             required,\n474|\t\tForbidReasons:                    forbidden,\n475|\t\tRows:                             rows,\n476|\t\tCounts:                           counts,\n477|\t\tEventKindCounts:                  eventKinds,\n478|\t\tContentBlockCounts:               contentBlocks,\n479|\t\tByteCounts:                       byteCounts,\n480|\t\tReasonCounts:                     reasonCounts,\n481|\t\tRawBundleComplete:                input.RawBundleComplete,\n482|\t\tCanonicalComplete:                input.CanonicalComplete,\n483|\t\tTargetSemanticallyContinuable:    input.TargetSemanticallyContinuable,\n484|\t\tTargetNativelyResumable:          input.TargetNativelyResumable,\n485|\t\tStagedReadBackEvidenceManifestID: staged,\n486|\t\tLiveReadBackEvidenceManifestID:   live,\n487|\t\tAdapterAttestations:              attestations,\n488|\t}\n489|\tobject := map[string]any{\n490|\t\t\"schema\":                                fidelityReportSchema,\n491|\t\t\"schema_version\":                        fidelityReportVersion,\n492|\t\t\"scope\":                                 input.Scope,\n493|\t\t\"operation_id\":                          operation.String(),\n494|\t\t\"bundle_id\":                             bundle.String(),\n495|\t\t\"source_snapshot_digest\":                snapshot.String(),\n496|\t\t\"capture_manifest_id\":                   captureID.String(),\n497|\t\t\"canonical_session_id\":                  canonicalID.String(),\n498|\t\t\"projection_plan_id\":                    planValue,\n499|\t\t\"source_environment\":                    tupleObject(sourceTuple),\n500|\t\t\"target_environment\":                    targetValue,\n501|\t\t\"profile\":                               input.Profile,\n502|\t\t\"required_dispositions\":                 requiredObject(required),\n503|\t\t\"forbid_reasons\":                        stringValues(forbidden),\n504|\t\t\"dispositions\":                          objects,\n505|\t\t\"counts\":                                counts.object(),\n506|\t\t\"event_kind_counts\":                     breakdownObject(eventKinds),\n507|\t\t\"content_block_counts\":                  breakdownObject(contentBlocks),\n508|\t\t\"byte_counts\":                           byteCountsObject(byteCounts),\n509|\t\t\"reason_counts\":                         reasonCountsObject(reasonCounts),\n510|\t\t\"raw_bundle_complete\":                   input.RawBundleComplete,\n511|\t\t\"canonical_complete\":                    input.CanonicalComplete,\n512|\t\t\"target_semantically_continuable\":       input.TargetSemanticallyContinuable,\n513|\t\t\"target_natively_resumable\":             input.TargetNativelyResumable,\n514|\t\t\"staged_read_back_evidence_manifest_id\": stagedValue,\n515|\t\t\"live_read_back_evidence_manifest_id\":   liveValue,\n516|\t\t\"adapter_attestations\":                  digestStrings(attestations),\n517|\t\t\"extensions\":                            extensions,\n518|\t}\n519|\treturn report, object, nil\n520|}\n521|\n522|// buildRequiredDispositions validates the caller-supplied policy\n523|// map: closed capture-class keys (the spec word for a closed class\n524|// vocabulary) to sorted unique non-empty disposition sets. Keys\n525|// validate in sorted order so multi-key refusals are deterministic.\n526|func buildRequiredDispositions(input map[string][]string) (map[string][]string, error) {\n527|\towner := \"fidelity report required_dispositions\"\n528|\tkeys := make([]string, 0, len(input))\n529|\tfor class := range input {\n530|\t\tkeys = append(keys, class)\n531|\t}\n532|\tsort.Strings(keys)\n(more lines below)","final_result":true}}}
