{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8a1","stream":{"kind":"session","id":"01a0d381-286a-7d03-bf7e-13c4c16a42b5"},"sequence":683,"recorded_at":1780531400001361,"record_type":"event","durability":"durable","causation_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","run_stream":{"kind":"run","id":"4603a868-01f4-4025-8e84-c5ce1f2882d9"},"task_stream":{"kind":"task","id":"01a0d386-fdff-79a3-bae5-0653b86afa5a"},"task_id":"01a0d386-fdff-79a3-bae5-0653b86afa5a","event":{"kind":"output","task_id":"01a0d386-fdff-79a3-bae5-0653b86afa5a","chunk":"Read text file `internal/cloneplanning/census_test.go`.\n1|package cloneplanning\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"reflect\"\n9|\t\"sort\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n14|)\n15|\n16|// This file pins the UTF-8 entry census structurally: the test\n17|// parses the package's production files, lists every exported\n18|// function or method with a text-carrying parameter (a string, a\n19|// []byte, or a struct type containing either, followed\n20|// transitively), and asserts that set equals the refusal table's\n21|// key set exactly. A new exported text entry with no refusal row\n22|// fails here; the control plant proves it (log rides the evidence\n23|// tar). A reflection cross-check proves the classification\n24|// against the real parameter types, and the Marshal guard proves\n25|// no text value reaches encoding/json.Marshal before the shared\n26|// validText gate.\n27|\n28|// productionFiles returns the parsed production files of this\n29|// package: every .go file except the tests themselves.\n30|func productionFiles(t *testing.T) []*ast.File {\n31|\tt.Helper()\n32|\tentries, err := os.ReadDir(\".\")\n33|\tif err != nil {\n34|\t\tt.Fatal(err)\n35|\t}\n36|\tfset := token.NewFileSet()\n37|\tvar files []*ast.File\n38|\tfor _, entry := range entries {\n39|\t\tname := entry.Name()\n40|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n41|\t\t\tcontinue\n42|\t\t}\n43|\t\tfile, err := parser.ParseFile(fset, name, nil, 0)\n44|\t\tif err != nil {\n45|\t\t\tt.Fatalf(\"parse %s: %v\", name, err)\n46|\t\t}\n47|\t\tfiles = append(files, file)\n48|\t}\n49|\tif len(files) == 0 {\n50|\t\tt.Fatalf(\"no production files found\")\n51|\t}\n52|\treturn files\n53|}\n54|\n55|// localTypes collects the package's named type declarations for\n56|// transitive resolution.\n57|func localTypes(files []*ast.File) map[string]ast.Expr {\n58|\ttypes := map[string]ast.Expr{}\n59|\tfor _, file := range files {\n60|\t\tfor _, decl := range file.Decls {\n61|\t\t\tgeneral, ok := decl.(*ast.GenDecl)\n62|\t\t\tif !ok {\n63|\t\t\t\tcontinue\n64|\t\t\t}\n65|\t\t\tfor _, spec := range general.Specs {\n66|\t\t\t\ttyped, ok := spec.(*ast.TypeSpec)\n67|\t\t\t\tif !ok {\n68|\t\t\t\t\tcontinue\n69|\t\t\t\t}\n70|\t\t\t\ttypes[typed.Name.Name] = typed.Type\n71|\t\t\t}\n72|\t\t}\n73|\t}\n74|\treturn types\n75|}\n76|\n77|var nonTextIdents = map[string]bool{\n78|\t\"bool\": true, \"byte\": true, \"rune\": true,\n79|\t\"int\": true, \"int8\": true, \"int16\": true, \"int32\": true, \"int64\": true,\n80|\t\"uint\": true, \"uint8\": true, \"uint16\": true, \"uint32\": true, \"uint64\": true, \"uintptr\": true,\n81|\t\"float32\": true, \"float64\": true, \"complex64\": true, \"complex128\": true,\n82|}\n83|\n84|// isTextType reports whether the parameter type can carry text:\n85|// a string, a []byte, or a struct (or named type) containing\n86|// either, followed transitively through the package's own\n87|// declarations. External qualified types and open shapes (maps,\n88|// any) classify as text conservatively; the reflection\n89|// cross-check proves the actual reachability.\n90|func isTextType(expr ast.Expr, types map[string]ast.Expr, visited map[string]bool) bool {\n91|\tswitch typed := expr.(type) {\n92|\tcase *ast.Ident:\n93|\t\tif typed.Name == \"string\" {\n94|\t\t\treturn true\n95|\t\t}\n96|\t\tif nonTextIdents[typed.Name] {\n97|\t\t\treturn false\n98|\t\t}\n99|\t\tif visited[typed.Name] {\n100|\t\t\treturn false\n101|\t\t}\n102|\t\tunderlying, ok := types[typed.Name]\n103|\t\tif !ok {\n104|\t\t\treturn true\n105|\t\t}\n106|\t\tvisited[typed.Name] = true\n107|\t\treturn isTextType(underlying, types, visited)\n108|\tcase *ast.SelectorExpr:\n109|\t\treturn true\n110|\tcase *ast.ArrayType:\n111|\t\tif typed.Len == nil {\n112|\t\t\tif elt, ok := typed.Elt.(*ast.Ident); ok && (elt.Name == \"byte\" || elt.Name == \"uint8\") {\n113|\t\t\t\treturn true\n114|\t\t\t}\n115|\t\t}\n116|\t\treturn isTextType(typed.Elt, types, visited)\n117|\tcase *ast.MapType:\n118|\t\treturn true\n119|\tcase *ast.StarExpr:\n120|\t\treturn isTextType(typed.X, types, visited)\n121|\tcase *ast.InterfaceType:\n122|\t\treturn true\n123|\tcase *ast.Ellipsis:\n124|\t\treturn isTextType(typed.Elt, types, visited)\n125|\tcase *ast.StructType:\n126|\t\tfor _, field := range typed.Fields.List {\n127|\t\t\tif isTextType(field.Type, types, visited) {\n128|\t\t\t\treturn true\n129|\t\t\t}\n130|\t\t}\n131|\t\treturn false\n132|\tdefault:\n133|\t\treturn false\n134|\t}\n135|}\n136|\n137|// censusEntry is one exported function or method with its\n138|// text-carrying verdict.\n139|type censusEntry struct {\n140|\tname     string\n141|\thasText  bool\n142|\treceiver string\n143|}\n144|\n145|// inspectEntryCensus parses the production files and classifies\n146|// every exported function or method by its parameter types.\n147|func inspectEntryCensus(t *testing.T) []censusEntry {\n148|\tt.Helper()\n149|\tfiles := productionFiles(t)\n150|\ttypes := localTypes(files)\n151|\tvar out []censusEntry\n152|\tfor _, file := range files {\n153|\t\tfor _, decl := range file.Decls {\n154|\t\t\tfn, ok := decl.(*ast.FuncDecl)\n155|\t\t\tif !ok || !ast.IsExported(fn.Name.Name) {\n156|\t\t\t\tcontinue\n157|\t\t\t}\n158|\t\t\tentry := censusEntry{name: fn.Name.Name}\n159|\t\t\tif fn.Recv != nil && len(fn.Recv.List) > 0 {\n160|\t\t\t\tentry.receiver = \"method\"\n161|\t\t\t\tentry.name = \"method:\" + fn.Name.Name\n162|\t\t\t}\n163|\t\t\tif fn.Type.Params != nil {\n164|\t\t\t\tfor _, field := range fn.Type.Params.List {\n165|\t\t\t\t\tif isTextType(field.Type, types, map[string]bool{}) {\n166|\t\t\t\t\t\tentry.hasText = true\n167|\t\t\t\t\t\tbreak\n168|\t\t\t\t\t}\n169|\t\t\t\t}\n170|\t\t\t}\n171|\t\t\tout = append(out, entry)\n172|\t\t}\n173|\t}\n174|\tsort.Slice(out, func(i, j int) bool { return out[i].name < out[j].name })\n175|\treturn out\n176|}\n177|\n178|// exportedEntryFuncs pins the package's exported function set for\n179|// the reflection cross-check. The census test asserts these names\n180|// equal the AST-derived exported set, so a new entry breaks\n181|// loudly here instead of slipping past the cross-check.\n182|var exportedEntryFuncs = []struct {\n183|\tname  string\n184|\tvalue any\n185|}{\n186|\t{\"SelectStrategy\", SelectStrategy},\n187|\t{\"SelectProfile\", SelectProfile},\n188|\t{\"ClassifyItem\", ClassifyItem},\n189|\t{\"PlanItem\", PlanItem},\n190|\t{\"PlanSession\", PlanSession},\n191|\t{\"ProjectVisibleText\", ProjectVisibleText},\n192|\t{\"EscapeVisibleText\", EscapeVisibleText},\n193|\t{\"PlanTargetEffects\", PlanTargetEffects},\n194|}\n195|\n196|// reflectReachesText reports whether text (a string or a []byte)\n197|// is reachable from the type through fields, elements, keys, and\n198|// pointees. Interface members count as text conservatively: an\n199|// any-typed member can carry a string.\n200|func reflectReachesText(typ reflect.Type, visited map[reflect.Type]bool) bool {\n201|\tif typ == nil {\n202|\t\treturn false\n203|\t}\n204|\tif typ.Kind() == reflect.String {\n205|\t\treturn true\n206|\t}\n207|\tif typ.Kind() == reflect.Slice && typ.Elem().Kind() == reflect.Uint8 {\n208|\t\treturn true\n209|\t}\n210|\tswitch typ.Kind() {\n211|\tcase reflect.Interface:\n212|\t\treturn true\n213|\tcase reflect.Pointer:\n214|\t\treturn reflectReachesText(typ.Elem(), visited)\n215|\tcase reflect.Slice, reflect.Array:\n216|\t\treturn reflectReachesText(typ.Elem(), visited)\n217|\tcase reflect.Map:\n218|\t\treturn reflectReachesText(typ.Key(), visited) || reflectReachesText(typ.Elem(), visited)\n219|\tcase reflect.Struct:\n220|\t\tif visited[typ] {\n221|\t\t\treturn false\n222|\t\t}\n223|\t\tvisited[typ] = true\n224|\t\tfor i := 0; i < typ.NumField(); i++ {\n225|\t\t\tif reflectReachesText(typ.Field(i).Type, visited) {\n226|\t\t\t\treturn true\n227|\t\t\t}\n228|\t\t}\n229|\t\treturn false\n230|\tdefault:\n231|\t\treturn false\n232|\t}\n233|}\n234|\n235|// reflectEntryHasText reports whether any parameter of the\n236|// function value can carry text.\n237|func reflectEntryHasText(value any) bool {\n238|\ttyp := reflect.TypeOf(value)\n239|\tfor i := 0; i < typ.NumIn(); i++ {\n240|\t\tif reflectReachesText(typ.In(i), map[reflect.Type]bool{}) {\n241|\t\t\treturn true\n242|\t\t}\n243|\t}\n244|\treturn false\n245|}\n246|\n247|func TestExportedTextEntryCensus(t *testing.T) {\n248|\t// The census derives from the production AST: a new exported\n249|\t// text entry with no refusal row fails here. Methods fail\n250|\t// explicitly: none exist, and one would need deliberate\n251|\t// table handling.\n252|\tcensus := inspectEntryCensus(t)\n253|\tcensused := map[string]bool{}\n254|\tfor _, entry := range census {\n255|\t\tif entry.receiver != \"\" {\n256|\t\t\tt.Fatalf(\"exported method %q needs explicit refusal-table handling\", entry.name)\n257|\t\t}\n258|\t\tcensused[entry.name] = entry.hasText\n259|\t}\n260|\t// The reflection list tracks the AST set exactly.\n261|\tlisted := map[string]bool{}\n262|\tfor _, entry := range exportedEntryFuncs {\n263|\t\tlisted[entry.name] = true\n264|\t}\n265|\tfor name := range censused {\n266|\t\tif !listed[name] {\n267|\t\t\tt.Fatalf(\"exported %s is missing from the reflection cross-check list\", name)\n268|\t\t}\n269|\t}\n270|\tfor name := range listed {\n271|\t\tif _, ok := censused[name]; !ok {\n272|\t\t\tt.Fatalf(\"reflection list names %s, which the AST census does not export\", name)\n273|\t\t}\n274|\t}\n275|\t// The reflection cross-check proves the AST classification\n276|\t// against the real parameter types, both directions: a text\n277|\t// entry the AST missed fails as loudly as a non-text entry\n278|\t// it misclassified.\n279|\tfor _, entry := range exportedEntryFuncs {\n280|\t\tif reflectEntryHasText(entry.value) != censused[entry.name] {\n281|\t\t\tt.Fatalf(\"entry %s: AST text=%v, reflection text=%v\", entry.name, censused[entry.name], reflectEntryHasText(entry.value))\n282|\t\t}\n283|\t}\n284|\t// The external struct grounding: ClassifyItem's CanonicalEvent\n285|\t// parameter actually carries text (a string Kind field), so\n286|\t// the conservative external classification is not vacuous.\n287|\teventType := reflect.TypeOf(clonebundle.CanonicalEvent{})\n288|\tkindField, ok := eventType.FieldByName(\"Kind\")\n289|\tif !ok || kindField.Type.Kind() != reflect.String {\n290|\t\tt.Fatalf(\"CanonicalEvent carries no string Kind field\")\n291|\t}\n292|\t// The refusal table covers the censused set exactly: a\n293|\t// censused entry missing from the table fails, and an\n294|\t// unknown table row fails.\n295|\ttable := map[string]bool{}\n296|\tfor _, row := range utf8RefusalTable {\n297|\t\tif table[row.entry] {\n298|\t\t\tt.Fatalf(\"refusal table duplicates %s\", row.entry)\n299|\t\t}\n300|\t\ttable[row.entry] = true\n301|\t}\n302|\tfor name, hasText := range censused {\n303|\t\tif hasText && !table[name] {\n304|\t\t\tt.Fatalf(\"censused text entry %s is missing from the refusal table\", name)\n305|\t\t}\n306|\t}\n307|\tfor name := range table {\n308|\t\thasText, ok := censused[name]\n309|\t\tif !ok {\n310|\t\t\tt.Fatalf(\"refusal table names %s, which is not an exported entry\", name)\n311|\t\t}\n312|\t\tif !hasText {\n313|\t\t\tt.Fatalf(\"refusal table names non-text entry %s\", name)\n314|\t\t}\n315|\t}\n316|\t// The exclusion pin: SelectStrategy is the only exported\n317|\t// entry without text (four booleans), so the census is not\n318|\t// silently empty.\n319|\texcluded := []string{}\n320|\tfor name, hasText := range censused {\n321|\t\tif !hasText {\n322|\t\t\texcluded = append(excluded, name)\n323|\t\t}\n324|\t}\n325|\tif len(excluded) != 1 || excluded[0] != \"SelectStrategy\" {\n326|\t\tt.Fatalf(\"non-text entries %q, want exactly [SelectStrategy]\", excluded)\n327|\t}\n328|\tif len(censused) != 8 {\n329|\t\tt.Fatalf(\"census carries %d exported entries, want 8\", len(censused))\n330|\t}\n331|}\n332|\n333|// marshalCallSite is one encoding/json.Marshal call with its\n334|// containing function and statement order evidence.\n335|type marshalCallSite struct {\n336|\tfunction   string\n337|\tvalidator  int\n338|\tmarshalIdx int\n339|}\n340|\n341|// inspectMarshalCallSites resolves the encoding/json import in\n342|// each production file and locates every Marshal call with the\n343|// validText call ordering inside its function. Statement indices\n344|// are top-level statement positions within the function body.\n345|func inspectMarshalCallSites(t *testing.T) []marshalCallSite {\n346|\tt.Helper()\n347|\tvar sites []marshalCallSite\n348|\tfor _, file := range productionFiles(t) {\n349|\t\tjsonName := \"\"\n350|\t\tdotImport := false\n351|\t\tfor _, imported := range file.Imports {\n352|\t\t\tif strings.Trim(imported.Path.Value, `\"`) != \"encoding/json\" {\n353|\t\t\t\tcontinue\n354|\t\t\t}\n355|\t\t\tif imported.Name == nil {\n356|\t\t\t\tjsonName = \"json\"\n357|\t\t\t} else if imported.Name.Name == \".\" {\n358|\t\t\t\tdotImport = true\n359|\t\t\t} else {\n360|\t\t\t\tjsonName = imported.Name.Name\n361|\t\t\t}\n362|\t\t}\n363|\t\tfor _, decl := range file.Decls {\n364|\t\t\tfn, ok := decl.(*ast.FuncDecl)\n365|\t\t\tif !ok || fn.Body == nil {\n366|\t\t\t\tcontinue\n367|\t\t\t}\n368|\t\t\tisMarshalCall := func(call *ast.CallExpr) bool {\n369|\t\t\t\tif sel, ok := call.Fun.(*ast.SelectorExpr); ok {\n370|\t\t\t\t\tident, ok := sel.X.(*ast.Ident)\n371|\t\t\t\t\treturn ok && jsonName != \"\" && ident.Name == jsonName && sel.Sel.Name == \"Marshal\"\n372|\t\t\t\t}\n373|\t\t\t\tif ident, ok := call.Fun.(*ast.Ident); ok {\n374|\t\t\t\t\treturn dotImport && ident.Name == \"Marshal\"\n375|\t\t\t\t}\n376|\t\t\t\treturn false\n377|\t\t\t}\n378|\t\t\tvalidator := -1\n379|\t\t\tmarshalIdx := -1\n380|\t\t\tfor index, stmt := range fn.Body.List {\n381|\t\t\t\tfoundValidator := false\n382|\t\t\t\tfoundMarshal := false\n383|\t\t\t\tast.Inspect(stmt, func(node ast.Node) bool {\n384|\t\t\t\t\tcall, ok := node.(*ast.CallExpr)\n385|\t\t\t\t\tif !ok {\n386|\t\t\t\t\t\treturn true\n387|\t\t\t\t\t}\n388|\t\t\t\t\tif isMarshalCall(call) {\n389|\t\t\t\t\t\tfoundMarshal = true\n390|\t\t\t\t\t}\n391|\t\t\t\t\tif ident, ok := call.Fun.(*ast.Ident); ok && ident.Name == \"validText\" {\n392|\t\t\t\t\t\tfoundValidator = true\n393|\t\t\t\t\t}\n394|\t\t\t\t\treturn true\n395|\t\t\t\t})\n396|\t\t\t\tif foundValidator && validator < 0 {\n397|\t\t\t\t\tvalidator = index\n398|\t\t\t\t}\n399|\t\t\t\tif foundMarshal && marshalIdx < 0 {\n400|\t\t\t\t\tmarshalIdx = index\n401|\t\t\t\t}\n402|\t\t\t}\n403|\t\t\tif marshalIdx >= 0 {\n404|\t\t\t\tsites = append(sites, marshalCallSite{function: fn.Name.Name, validator: validator, marshalIdx: marshalIdx})\n405|\t\t\t}\n406|\t\t}\n407|\t}\n408|\treturn sites\n409|}\n410|\n411|func TestJSONMarshalFollowsValidator(t *testing.T) {\n412|\t// Structural pin: the only encoding/json.Marshal call in the\n413|\t// package's production files is in EscapeVisibleText, and the\n414|\t// shared validText gate runs in an earlier statement, so no\n415|\t// text value reaches the encoder unvalidated. A second\n416|\t// Marshal call site, a missing gate, or a reordering reddens\n417|\t// here; the behavioral refusal table proves the refusal\n418|\t// itself. Control-plant logs ride the evidence tar.\n419|\tsites := inspectMarshalCallSites(t)\n420|\tif len(sites) != 1 {\n421|\t\tfunctions := []string{}\n422|\t\tfor _, site := range sites {\n423|\t\t\tfunctions = append(functions, site.function)\n424|\t\t}\n425|\t\tt.Fatalf(\"json.Marshal call sites %q, want exactly [EscapeVisibleText]\", functions)\n426|\t}\n427|\tsite := sites[0]\n428|\tif site.function != \"EscapeVisibleText\" {\n429|\t\tt.Fatalf(\"json.Marshal call site %q, want EscapeVisibleText\", site.function)\n430|\t}\n431|\tif site.validator < 0 {\n432|\t\tt.Fatalf(\"EscapeVisibleText calls json.Marshal with no validText gate\")\n433|\t}\n434|\tif site.validator >= site.marshalIdx {\n435|\t\tt.Fatalf(\"EscapeVisibleText validates at statement %d, marshals at %d: gate must run first\", site.validator, site.marshalIdx)\n436|\t}\n437|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8a3","stream":{"kind":"session","id":"01a0d381-286a-7d03-bf7e-13c4c16a42b5"},"sequence":684,"recorded_at":1780531400001363,"record_type":"event","durability":"durable","causation_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","run_stream":{"kind":"run","id":"4603a868-01f4-4025-8e84-c5ce1f2882d9"},"task_stream":{"kind":"task","id":"01a0d386-fdff-79a3-bae5-0653b86afa5a"},"task_id":"01a0d386-fdff-79a3-bae5-0653b86afa5a","event":{"kind":"completed","task_id":"01a0d386-fdff-79a3-bae5-0653b86afa5a"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8a5","stream":{"kind":"session","id":"01a0d381-286a-7d03-bf7e-13c4c16a42b5"},"sequence":685,"recorded_at":1780531400001365,"record_type":"event","durability":"durable","causation_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","run_stream":{"kind":"run","id":"4603a868-01f4-4025-8e84-c5ce1f2882d9"},"call_id":"call_01a0d386f9cd7505a3a903dfa36d4ae2","text":"Read text file `internal/cloneplanning/session_test.go`.\n1|package cloneplanning\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/clonefidelity\"\n8|)\n9|\n10|// This file drives PlanSession and PlanTargetEffects through the\n11|// production entries. Sessions fold to predicted counts derived\n12|// from the mappings; every mapping the planner emits folds to zero\n13|// target effects (no callable tools, no pending actions, no target\n14|// token accounting).\n15|\n16|// foldOracleCounts folds the independent oracle over a session,\n17|// mirroring the production count derivation from literals.\n18|func foldOracleCounts(t *testing.T, strategy, profile string, items []Item) []Mapping {\n19|\tt.Helper()\n20|\tmappings := make([]Mapping, 0, len(items))\n21|\tfor _, item := range items {\n22|\t\twant := oraclePlan(strategy, profile, item)\n23|\t\tif want.refuseToken != \"\" {\n24|\t\t\tt.Fatalf(\"oracle refuses %s/%s/%s\", strategy, profile, describeItem(item))\n25|\t\t}\n26|\t\tmappings = append(mappings, Mapping{Disposition: want.disposition, Reasons: want.reasons})\n27|\t}\n28|\treturn mappings\n29|}\n30|\n31|func countDispositions(mappings []Mapping) clonefidelity.FidelityCounts {\n32|\tvar counts clonefidelity.FidelityCounts\n33|\tfor _, mapping := range mappings {\n34|\t\tswitch mapping.Disposition {\n35|\t\tcase \"exact\":\n36|\t\t\tcounts.Exact++\n37|\t\tcase \"semantic\":\n38|\t\t\tcounts.Semantic++\n39|\t\tcase \"summarized\":\n40|\t\t\tcounts.Summarized++\n41|\t\tcase \"opaque_preserved\":\n42|\t\t\tcounts.OpaquePreserved++\n43|\t\tcase \"synthesized\":\n44|\t\t\tcounts.Synthesized++\n45|\t\tcase \"omitted\":\n46|\t\t\tcounts.Omitted++\n47|\t\tcase \"unrecoverable\":\n48|\t\t\tcounts.Unrecoverable++\n49|\t\t}\n50|\t}\n51|\treturn counts\n52|}\n53|\n54|func TestPlanSessionCounts(t *testing.T) {\n55|\tsessions := []struct {\n56|\t\tname     string\n57|\t\tstrategy string\n58|\t\tprofile  string\n59|\t\titems    []Item\n60|\t}{\n61|\t\t{\"single-exact\", \"target_native_writer\", \"maximal_safe\", []Item{{Kind: \"user_message\"}}},\n62|\t\t{\"mixed-native\", \"same_environment_native_rewrite\", \"maximal_safe\", []Item{\n63|\t\t\t{Kind: \"user_message\"},\n64|\t\t\t{Kind: \"tool_call\", Resolution: \"aborted\"},\n65|\t\t\t{Kind: \"opaque_reasoning\", Protection: \"signed\"},\n66|\t\t\t{Block: \"image\"},\n67|\t\t}},\n68|\t\t{\"mixed-continuation\", \"continuation_context\", \"compact\", []Item{\n69|\t\t\t{Kind: \"user_message\"},\n70|\t\t\t{Kind: \"assistant_message\"},\n71|\t\t\t{Kind: \"tool_call\", Resolution: \"completed\"},\n72|\t\t\t{Kind: \"usage\"},\n73|\t\t\t{Block: \"text\"},\n74|\t\t}},\n75|\t\t{\"mixed-importer\", \"target_official_import\", \"messages_only\", []Item{\n76|\t\t\t{Kind: \"user_message\"},\n77|\t\t\t{Kind: \"tool_call\", Resolution: \"completed\"},\n78|\t\t\t{Kind: \"subagent_completed\"},\n79|\t\t\t{Kind: \"usage\"},\n80|\t\t\t{Block: \"image\"},\n81|\t\t\t{Block: \"text\"},\n82|\t\t}},\n83|\t\t{\"strict-exact\", \"target_native_writer\", \"strict_exact\", []Item{\n84|\t\t\t{Kind: \"user_message\"},\n85|\t\t\t{Block: \"text\"},\n86|\t\t}},\n87|\t}\n88|\tfor _, session := range sessions {\n89|\t\twant := foldOracleCounts(t, session.strategy, session.profile, session.items)\n90|\t\twantCounts := countDispositions(want)\n91|\t\tgot, counts, err := PlanSession(session.strategy, session.profile, session.items)\n92|\t\tif err != nil {\n93|\t\t\tt.Fatalf(\"%s refused: %v\", session.name, err)\n94|\t\t}\n95|\t\tif len(got) != len(want) {\n96|\t\t\tt.Fatalf(\"%s: %d mappings, want %d\", session.name, len(got), len(want))\n97|\t\t}\n98|\t\tfor i := range want {\n99|\t\t\tif got[i].Disposition != want[i].Disposition || !equalReasons(got[i].Reasons, want[i].Reasons) {\n100|\t\t\t\tt.Fatalf(\"%s mapping[%d] = %+v, want %+v\", session.name, i, got[i], want[i])\n101|\t\t\t}\n102|\t\t}\n103|\t\tif counts != wantCounts {\n104|\t\t\tt.Fatalf(\"%s: counts %+v, want %+v\", session.name, counts, wantCounts)\n105|\t\t}\n106|\t\ttotal := counts.Exact + counts.Semantic + counts.Summarized + counts.OpaquePreserved + counts.Synthesized + counts.Omitted + counts.Unrecoverable\n107|\t\tif total != uint64(len(session.items)) {\n108|\t\t\tt.Fatalf(\"%s: counts total %d, want %d\", session.name, total, len(session.items))\n109|\t\t}\n110|\t}\n111|}\n112|\n113|func TestPlanSessionRefusals(t *testing.T) {\n114|\titem := Item{Kind: \"user_message\"}\n115|\t// Empty sessions refuse: the plan table requires\n116|\t// item_mappings[1..1000000].\n117|\tif _, _, err := PlanSession(\"target_native_writer\", \"maximal_safe\", nil); err == nil {\n118|\t\tt.Fatalf(\"empty session admitted\")\n119|\t}\n120|\t// Over-bound sessions refuse at exactly max+1 (the narrowing\n121|\t// probe N-session-bound admits exactly 1000001).\n122|\tmany := make([]Item, 1000001)\n123|\tfor i := range many {\n124|\t\tmany[i] = item\n125|\t}\n126|\tif _, _, err := PlanSession(\"target_native_writer\", \"maximal_safe\", many); err == nil {\n127|\t\tt.Fatalf(\"1000001-item session admitted\")\n128|\t} else if !strings.Contains(err.Error(), \"1000001\") {\n129|\t\tt.Fatalf(\"over-bound refusal %q does not name the count\", err.Error())\n130|\t}\n131|\t// The first refusing item refuses the session: strict_exact\n132|\t// with a non-exact member, and an invalid member mid-session.\n133|\tif _, _, err := PlanSession(\"target_native_writer\", \"strict_exact\", []Item{item, {Kind: \"tool_call\", Resolution: \"aborted\"}}); err == nil {\n134|\t\tt.Fatalf(\"strict session with aborted tool admitted\")\n135|\t} else if !strings.Contains(err.Error(), \"strict_exact\") {\n136|\t\tt.Fatalf(\"strict session refusal %q does not name strict_exact\", err.Error())\n137|\t}\n138|\tif _, _, err := PlanSession(\"target_native_writer\", \"maximal_safe\", []Item{item, {Kind: \"bogus_kind\"}}); err == nil {\n139|\t\tt.Fatalf(\"session with invalid member admitted\")\n140|\t}\n141|}\n142|\n143|func TestPlanSessionMillionEdge(t *testing.T) {\n144|\t// The plan table's item_mappings[1..1000000] upper edge seals\n145|\t// at the production entry: one million identical items plan\n146|\t// and fold to Exact == 1000000.\n147|\titems := make([]Item, 1000000)\n148|\tfor i := range items {\n149|\t\titems[i] = Item{Kind: \"user_message\"}\n150|\t}\n151|\tgot, counts, err := PlanSession(\"target_native_writer\", \"maximal_safe\", items)\n152|\tif err != nil {\n153|\t\tt.Fatalf(\"million-item session refused: %v\", err)\n154|\t}\n155|\tif len(got) != 1000000 || counts.Exact != 1000000 {\n156|\t\tt.Fatalf(\"million-item session folds to %+v over %d mappings\", counts, len(got))\n157|\t}\n158|}\n159|\n160|func TestPlanTargetEffectsZeroSweep(t *testing.T) {\n161|\t// Every mapping the planner emits over the whole domain folds\n162|\t// to zero target effects: no callable tools, no pending\n163|\t// actions, no target token accounting (R-INERT, R-ACCT).\n164|\tmappings := []Mapping{}\n165|\tfor _, strategy := range clonefidelity.Strategies() {\n166|\t\tfor _, profile := range clonefidelity.Profiles() {\n167|\t\t\tfor _, item := range allValidItems() {\n168|\t\t\t\tgot, err := PlanItem(strategy, profile, item)\n169|\t\t\t\tif err != nil {\n170|\t\t\t\t\tcontinue\n171|\t\t\t\t}\n172|\t\t\t\tmappings = append(mappings, got)\n173|\t\t\t}\n174|\t\t}\n175|\t}\n176|\tif len(mappings) == 0 {\n177|\t\tt.Fatalf(\"no admitted mappings to fold\")\n178|\t}\n179|\teffects, err := PlanTargetEffects(mappings)\n180|\tif err != nil {\n181|\t\tt.Fatalf(\"PlanTargetEffects refused planned mappings: %v\", err)\n182|\t}\n183|\tif len(effects.CallableTools) != 0 || len(effects.PendingActions) != 0 ||\n184|\t\teffects.TargetInputTokens != 0 || effects.TargetOutputTokens != 0 {\n185|\t\tt.Fatalf(\"planned mappings fold to %+v, want zero\", effects)\n186|\t}\n187|\t// Per-disposition: each emitted disposition folds to zero\n188|\t// alone, so the N-effects-nonzero narrowing (exact funds one\n189|\t// token) fails on its cell.\n190|\tseen := map[string]Mapping{}\n191|\tfor _, mapping := range mappings {\n192|\t\tseen[mapping.Disposition] = mapping\n193|\t}\n194|\tfor disposition, mapping := range seen {\n195|\t\teffects, err := PlanTargetEffects([]Mapping{mapping})\n196|\t\tif err != nil {\n197|\t\t\tt.Fatalf(\"PlanTargetEffects(%s) refused: %v\", disposition, err)\n198|\t\t}\n199|\t\tif len(effects.CallableTools) != 0 || len(effects.PendingActions) != 0 ||\n200|\t\t\teffects.TargetInputTokens != 0 || effects.TargetOutputTokens != 0 {\n201|\t\t\tt.Fatalf(\"PlanTargetEffects(%s) = %+v, want zero\", disposition, effects)\n202|\t\t}\n203|\t}\n204|\tt.Logf(\"effects sweep: %d mappings, %d dispositions\", len(mappings), len(seen))\n205|}\n206|\n207|func TestPlanTargetEffectsRefusals(t *testing.T) {\n208|\tgood := Mapping{Disposition: \"exact\"}\n209|\tif _, err := PlanTargetEffects([]Mapping{good}); err != nil {\n210|\t\tt.Fatalf(\"exact mapping refused: %v\", err)\n211|\t}\n212|\tif _, err := PlanTargetEffects(nil); err != nil {\n213|\t\tt.Fatalf(\"empty mapping list refused: %v\", err)\n214|\t}\n215|\t// \"bogus_disposition\" and \"bogus_reason\" are the narrowing\n216|\t// probes (N-effects-disposition, N-effects-reason).\n217|\tfor _, mapping := range []Mapping{\n218|\t\t{Disposition: \"bogus_disposition\"},\n219|\t\t{Disposition: \"\"},\n220|\t\t{Disposition: \"exact\", Reasons: []string{\"bogus_reason\"}},\n221|\t\t{Disposition: \"exact\", Reasons: []string{\"unsafe_pending_action\", \"operator_policy\"}},\n222|\t\t{Disposition: \"exact\", Reasons: []string{\"operator_policy\", \"operator_policy\"}},\n223|\t} {\n224|\t\tif _, err := PlanTargetEffects([]Mapping{good, mapping}); err == nil {\n225|\t\t\tt.Fatalf(\"mapping %+v admitted\", mapping)\n226|\t\t}\n227|\t}\n228|}\n229|\n230|func TestPlanTargetEffectsChained(t *testing.T) {\n231|\t// The real chain: PlanSession output folds through\n232|\t// PlanTargetEffects to zero.\n233|\titems := []Item{\n234|\t\t{Kind: \"user_message\"},\n235|\t\t{Kind: \"tool_call\", Resolution: \"aborted\"},\n236|\t\t{Kind: \"usage\"},\n237|\t\t{Kind: \"subagent_completed\"},\n238|\t\t{Block: \"opaque\"},\n239|\t}\n240|\tmappings, _, err := PlanSession(\"target_official_import\", \"compact\", items)\n241|\tif err != nil {\n242|\t\tt.Fatalf(\"PlanSession refused: %v\", err)\n243|\t}\n244|\teffects, err := PlanTargetEffects(mappings)\n245|\tif err != nil {\n246|\t\tt.Fatalf(\"PlanTargetEffects refused: %v\", err)\n247|\t}\n248|\tif len(effects.CallableTools) != 0 || len(effects.PendingActions) != 0 ||\n249|\t\teffects.TargetInputTokens != 0 || effects.TargetOutputTokens != 0 {\n250|\t\tt.Fatalf(\"chained effects = %+v, want zero\", effects)\n251|\t}\n252|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8a7","stream":{"kind":"session","id":"01a0d381-286a-7d03-bf7e-13c4c16a42b5"},"sequence":686,"recorded_at":1780531400001367,"record_type":"event","durability":"durable","causation_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","run_stream":{"kind":"run","id":"4603a868-01f4-4025-8e84-c5ce1f2882d9"},"call_id":"call_01a0d386fb5e76c7a2b5d9e61ed4b5da","text":"Read text file `internal/cloneplanning/census_test.go`.\n1|package cloneplanning\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"reflect\"\n9|\t\"sort\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n14|)\n15|\n16|// This file pins the UTF-8 entry census structurally: the test\n17|// parses the package's production files, lists every exported\n18|// function or method with a text-carrying parameter (a string, a\n19|// []byte, or a struct type containing either, followed\n20|// transitively), and asserts that set equals the refusal table's\n21|// key set exactly. A new exported text entry with no refusal row\n22|// fails here; the control plant proves it (log rides the evidence\n23|// tar). A reflection cross-check proves the classification\n24|// against the real parameter types, and the Marshal guard proves\n25|// no text value reaches encoding/json.Marshal before the shared\n26|// validText gate.\n27|\n28|// productionFiles returns the parsed production files of this\n29|// package: every .go file except the tests themselves.\n30|func productionFiles(t *testing.T) []*ast.File {\n31|\tt.Helper()\n32|\tentries, err := os.ReadDir(\".\")\n33|\tif err != nil {\n34|\t\tt.Fatal(err)\n35|\t}\n36|\tfset := token.NewFileSet()\n37|\tvar files []*ast.File\n38|\tfor _, entry := range entries {\n39|\t\tname := entry.Name()\n40|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n41|\t\t\tcontinue\n42|\t\t}\n43|\t\tfile, err := parser.ParseFile(fset, name, nil, 0)\n44|\t\tif err != nil {\n45|\t\t\tt.Fatalf(\"parse %s: %v\", name, err)\n46|\t\t}\n47|\t\tfiles = append(files, file)\n48|\t}\n49|\tif len(files) == 0 {\n50|\t\tt.Fatalf(\"no production files found\")\n51|\t}\n52|\treturn files\n53|}\n54|\n55|// localTypes collects the package's named type declarations for\n56|// transitive resolution.\n57|func localTypes(files []*ast.File) map[string]ast.Expr {\n58|\ttypes := map[string]ast.Expr{}\n59|\tfor _, file := range files {\n60|\t\tfor _, decl := range file.Decls {\n61|\t\t\tgeneral, ok := decl.(*ast.GenDecl)\n62|\t\t\tif !ok {\n63|\t\t\t\tcontinue\n64|\t\t\t}\n65|\t\t\tfor _, spec := range general.Specs {\n66|\t\t\t\ttyped, ok := spec.(*ast.TypeSpec)\n67|\t\t\t\tif !ok {\n68|\t\t\t\t\tcontinue\n69|\t\t\t\t}\n70|\t\t\t\ttypes[typed.Name.Name] = typed.Type\n71|\t\t\t}\n72|\t\t}\n73|\t}\n74|\treturn types\n75|}\n76|\n77|var nonTextIdents = map[string]bool{\n78|\t\"bool\": true, \"byte\": true, \"rune\": true,\n79|\t\"int\": true, \"int8\": true, \"int16\": true, \"int32\": true, \"int64\": true,\n80|\t\"uint\": true, \"uint8\": true, \"uint16\": true, \"uint32\": true, \"uint64\": true, \"uintptr\": true,\n81|\t\"float32\": true, \"float64\": true, \"complex64\": true, \"complex128\": true,\n82|}\n83|\n84|// isTextType reports whether the parameter type can carry text:\n85|// a string, a []byte, or a struct (or named type) containing\n86|// either, followed transitively through the package's own\n87|// declarations. External qualified types and open shapes (maps,\n88|// any) classify as text conservatively; the reflection\n89|// cross-check proves the actual reachability.\n90|func isTextType(expr ast.Expr, types map[string]ast.Expr, visited map[string]bool) bool {\n91|\tswitch typed := expr.(type) {\n92|\tcase *ast.Ident:\n93|\t\tif typed.Name == \"string\" {\n94|\t\t\treturn true\n95|\t\t}\n96|\t\tif nonTextIdents[typed.Name] {\n97|\t\t\treturn false\n98|\t\t}\n99|\t\tif visited[typed.Name] {\n100|\t\t\treturn false\n101|\t\t}\n102|\t\tunderlying, ok := types[typed.Name]\n103|\t\tif !ok {\n104|\t\t\treturn true\n105|\t\t}\n106|\t\tvisited[typed.Name] = true\n107|\t\treturn isTextType(underlying, types, visited)\n108|\tcase *ast.SelectorExpr:\n109|\t\treturn true\n110|\tcase *ast.ArrayType:\n111|\t\tif typed.Len == nil {\n112|\t\t\tif elt, ok := typed.Elt.(*ast.Ident); ok && (elt.Name == \"byte\" || elt.Name == \"uint8\") {\n113|\t\t\t\treturn true\n114|\t\t\t}\n115|\t\t}\n116|\t\treturn isTextType(typed.Elt, types, visited)\n117|\tcase *ast.MapType:\n118|\t\treturn true\n119|\tcase *ast.StarExpr:\n120|\t\treturn isTextType(typed.X, types, visited)\n121|\tcase *ast.InterfaceType:\n122|\t\treturn true\n123|\tcase *ast.Ellipsis:\n124|\t\treturn isTextType(typed.Elt, types, visited)\n125|\tcase *ast.StructType:\n126|\t\tfor _, field := range typed.Fields.List {\n127|\t\t\tif isTextType(field.Type, types, visited) {\n128|\t\t\t\treturn true\n129|\t\t\t}\n130|\t\t}\n131|\t\treturn false\n132|\tdefault:\n133|\t\treturn false\n134|\t}\n135|}\n136|\n137|// censusEntry is one exported function or method with its\n138|// text-carrying verdict.\n139|type censusEntry struct {\n140|\tname     string\n141|\thasText  bool\n142|\treceiver string\n143|}\n144|\n145|// inspectEntryCensus parses the production files and classifies\n146|// every exported function or method by its parameter types.\n147|func inspectEntryCensus(t *testing.T) []censusEntry {\n148|\tt.Helper()\n149|\tfiles := productionFiles(t)\n150|\ttypes := localTypes(files)\n151|\tvar out []censusEntry\n152|\tfor _, file := range files {\n153|\t\tfor _, decl := range file.Decls {\n154|\t\t\tfn, ok := decl.(*ast.FuncDecl)\n155|\t\t\tif !ok || !ast.IsExported(fn.Name.Name) {\n156|\t\t\t\tcontinue\n157|\t\t\t}\n158|\t\t\tentry := censusEntry{name: fn.Name.Name}\n159|\t\t\tif fn.Recv != nil && len(fn.Recv.List) > 0 {\n160|\t\t\t\tentry.receiver = \"method\"\n161|\t\t\t\tentry.name = \"method:\" + fn.Name.Name\n162|\t\t\t}\n163|\t\t\tif fn.Type.Params != nil {\n164|\t\t\t\tfor _, field := range fn.Type.Params.List {\n165|\t\t\t\t\tif isTextType(field.Type, types, map[string]bool{}) {\n166|\t\t\t\t\t\tentry.hasText = true\n167|\t\t\t\t\t\tbreak\n168|\t\t\t\t\t}\n169|\t\t\t\t}\n170|\t\t\t}\n171|\t\t\tout = append(out, entry)\n172|\t\t}\n173|\t}\n174|\tsort.Slice(out, func(i, j int) bool { return out[i].name < out[j].name })\n175|\treturn out\n176|}\n177|\n178|// exportedEntryFuncs pins the package's exported function set for\n179|// the reflection cross-check. The census test asserts these names\n180|// equal the AST-derived exported set, so a new entry breaks\n181|// loudly here instead of slipping past the cross-check.\n182|var exportedEntryFuncs = []struct {\n183|\tname  string\n184|\tvalue any\n185|}{\n186|\t{\"SelectStrategy\", SelectStrategy},\n187|\t{\"SelectProfile\", SelectProfile},\n188|\t{\"ClassifyItem\", ClassifyItem},\n189|\t{\"PlanItem\", PlanItem},\n190|\t{\"PlanSession\", PlanSession},\n191|\t{\"ProjectVisibleText\", ProjectVisibleText},\n192|\t{\"EscapeVisibleText\", EscapeVisibleText},\n193|\t{\"PlanTargetEffects\", PlanTargetEffects},\n194|}\n195|\n196|// reflectReachesText reports whether text (a string or a []byte)\n197|// is reachable from the type through fields, elements, keys, and\n198|// pointees. Interface members count as text conservatively: an\n199|// any-typed member can carry a string.\n200|func reflectReachesText(typ reflect.Type, visited map[reflect.Type]bool) bool {\n201|\tif typ == nil {\n202|\t\treturn false\n203|\t}\n204|\tif typ.Kind() == reflect.String {\n205|\t\treturn true\n206|\t}\n207|\tif typ.Kind() == reflect.Slice && typ.Elem().Kind() == reflect.Uint8 {\n208|\t\treturn true\n209|\t}\n210|\tswitch typ.Kind() {\n211|\tcase reflect.Interface:\n212|\t\treturn true\n213|\tcase reflect.Pointer:\n214|\t\treturn reflectReachesText(typ.Elem(), visited)\n215|\tcase reflect.Slice, reflect.Array:\n216|\t\treturn reflectReachesText(typ.Elem(), visited)\n217|\tcase reflect.Map:\n218|\t\treturn reflectReachesText(typ.Key(), visited) || reflectReachesText(typ.Elem(), visited)\n219|\tcase reflect.Struct:\n220|\t\tif visited[typ] {\n221|\t\t\treturn false\n222|\t\t}\n223|\t\tvisited[typ] = true\n224|\t\tfor i := 0; i < typ.NumField(); i++ {\n225|\t\t\tif reflectReachesText(typ.Field(i).Type, visited) {\n226|\t\t\t\treturn true\n227|\t\t\t}\n228|\t\t}\n229|\t\treturn false\n230|\tdefault:\n231|\t\treturn false\n232|\t}\n233|}\n234|\n235|// reflectEntryHasText reports whether any parameter of the\n236|// function value can carry text.\n237|func reflectEntryHasText(value any) bool {\n238|\ttyp := reflect.TypeOf(value)\n239|\tfor i := 0; i < typ.NumIn(); i++ {\n240|\t\tif reflectReachesText(typ.In(i), map[reflect.Type]bool{}) {\n241|\t\t\treturn true\n242|\t\t}\n243|\t}\n244|\treturn false\n245|}\n246|\n247|func TestExportedTextEntryCensus(t *testing.T) {\n248|\t// The census derives from the production AST: a new exported\n249|\t// text entry with no refusal row fails here. Methods fail\n250|\t// explicitly: none exist, and one would need deliberate\n251|\t// table handling.\n252|\tcensus := inspectEntryCensus(t)\n253|\tcensused := map[string]bool{}\n254|\tfor _, entry := range census {\n255|\t\tif entry.receiver != \"\" {\n256|\t\t\tt.Fatalf(\"exported method %q needs explicit refusal-table handling\", entry.name)\n257|\t\t}\n258|\t\tcensused[entry.name] = entry.hasText\n259|\t}\n260|\t// The reflection list tracks the AST set exactly.\n261|\tlisted := map[string]bool{}\n262|\tfor _, entry := range exportedEntryFuncs {\n263|\t\tlisted[entry.name] = true\n264|\t}\n265|\tfor name := range censused {\n266|\t\tif !listed[name] {\n267|\t\t\tt.Fatalf(\"exported %s is missing from the reflection cross-check list\", name)\n268|\t\t}\n269|\t}\n270|\tfor name := range listed {\n271|\t\tif _, ok := censused[name]; !ok {\n272|\t\t\tt.Fatalf(\"reflection list names %s, which the AST census does not export\", name)\n273|\t\t}\n274|\t}\n275|\t// The reflection cross-check proves the AST classification\n276|\t// against the real parameter types, both directions: a text\n277|\t// entry the AST missed fails as loudly as a non-text entry\n278|\t// it misclassified.\n279|\tfor _, entry := range exportedEntryFuncs {\n280|\t\tif reflectEntryHasText(entry.value) != censused[entry.name] {\n281|\t\t\tt.Fatalf(\"entry %s: AST text=%v, reflection text=%v\", entry.name, censused[entry.name], reflectEntryHasText(entry.value))\n282|\t\t}\n283|\t}\n284|\t// The external struct grounding: ClassifyItem's CanonicalEvent\n285|\t// parameter actually carries text (a string Kind field), so\n286|\t// the conservative external classification is not vacuous.\n287|\teventType := reflect.TypeOf(clonebundle.CanonicalEvent{})\n288|\tkindField, ok := eventType.FieldByName(\"Kind\")\n289|\tif !ok || kindField.Type.Kind() != reflect.String {\n290|\t\tt.Fatalf(\"CanonicalEvent carries no string Kind field\")\n291|\t}\n292|\t// The refusal table covers the censused set exactly: a\n293|\t// censused entry missing from the table fails, and an\n294|\t// unknown table row fails.\n295|\ttable := map[string]bool{}\n296|\tfor _, row := range utf8RefusalTable {\n297|\t\tif table[row.entry] {\n298|\t\t\tt.Fatalf(\"refusal table duplicates %s\", row.entry)\n299|\t\t}\n300|\t\ttable[row.entry] = true\n301|\t}\n302|\tfor name, hasText := range censused {\n303|\t\tif hasText && !table[name] {\n304|\t\t\tt.Fatalf(\"censused text entry %s is missing from the refusal table\", name)\n305|\t\t}\n306|\t}\n307|\tfor name := range table {\n308|\t\thasText, ok := censused[name]\n309|\t\tif !ok {\n310|\t\t\tt.Fatalf(\"refusal table names %s, which is not an exported entry\", name)\n311|\t\t}\n312|\t\tif !hasText {\n313|\t\t\tt.Fatalf(\"refusal table names non-text entry %s\", name)\n314|\t\t}\n315|\t}\n316|\t// The exclusion pin: SelectStrategy is the only exported\n317|\t// entry without text (four booleans), so the census is not\n318|\t// silently empty.\n319|\texcluded := []string{}\n320|\tfor name, hasText := range censused {\n321|\t\tif !hasText {\n322|\t\t\texcluded = append(excluded, name)\n323|\t\t}\n324|\t}\n325|\tif len(excluded) != 1 || excluded[0] != \"SelectStrategy\" {\n326|\t\tt.Fatalf(\"non-text entries %q, want exactly [SelectStrategy]\", excluded)\n327|\t}\n328|\tif len(censused) != 8 {\n329|\t\tt.Fatalf(\"census carries %d exported entries, want 8\", len(censused))\n330|\t}\n331|}\n332|\n333|// marshalCallSite is one encoding/json.Marshal call with its\n334|// containing function and statement order evidence.\n335|type marshalCallSite struct {\n336|\tfunction   string\n337|\tvalidator  int\n338|\tmarshalIdx int\n339|}\n340|\n341|// inspectMarshalCallSites resolves the encoding/json import in\n342|// each production file and locates every Marshal call with the\n343|// validText call ordering inside its function. Statement indices\n344|// are top-level statement positions within the function body.\n345|func inspectMarshalCallSites(t *testing.T) []marshalCallSite {\n346|\tt.Helper()\n347|\tvar sites []marshalCallSite\n348|\tfor _, file := range productionFiles(t) {\n349|\t\tjsonName := \"\"\n350|\t\tdotImport := false\n351|\t\tfor _, imported := range file.Imports {\n352|\t\t\tif strings.Trim(imported.Path.Value, `\"`) != \"encoding/json\" {\n353|\t\t\t\tcontinue\n354|\t\t\t}\n355|\t\t\tif imported.Name == nil {\n356|\t\t\t\tjsonName = \"json\"\n357|\t\t\t} else if imported.Name.Name == \".\" {\n358|\t\t\t\tdotImport = true\n359|\t\t\t} else {\n360|\t\t\t\tjsonName = imported.Name.Name\n361|\t\t\t}\n362|\t\t}\n363|\t\tfor _, decl := range file.Decls {\n364|\t\t\tfn, ok := decl.(*ast.FuncDecl)\n365|\t\t\tif !ok || fn.Body == nil {\n366|\t\t\t\tcontinue\n367|\t\t\t}\n368|\t\t\tisMarshalCall := func(call *ast.CallExpr) bool {\n369|\t\t\t\tif sel, ok := call.Fun.(*ast.SelectorExpr); ok {\n370|\t\t\t\t\tident, ok := sel.X.(*ast.Ident)\n371|\t\t\t\t\treturn ok && jsonName != \"\" && ident.Name == jsonName && sel.Sel.Name == \"Marshal\"\n372|\t\t\t\t}\n373|\t\t\t\tif ident, ok := call.Fun.(*ast.Ident); ok {\n374|\t\t\t\t\treturn dotImport && ident.Name == \"Marshal\"\n375|\t\t\t\t}\n376|\t\t\t\treturn false\n377|\t\t\t}\n378|\t\t\tvalidator := -1\n379|\t\t\tmarshalIdx := -1\n380|\t\t\tfor index, stmt := range fn.Body.List {\n381|\t\t\t\tfoundValidator := false\n382|\t\t\t\tfoundMarshal := false\n383|\t\t\t\tast.Inspect(stmt, func(node ast.Node) bool {\n384|\t\t\t\t\tcall, ok := node.(*ast.CallExpr)\n385|\t\t\t\t\tif !ok {\n386|\t\t\t\t\t\treturn true\n387|\t\t\t\t\t}\n388|\t\t\t\t\tif isMarshalCall(call) {\n389|\t\t\t\t\t\tfoundMarshal = true\n390|\t\t\t\t\t}\n391|\t\t\t\t\tif ident, ok := call.Fun.(*ast.Ident); ok && ident.Name == \"validText\" {\n392|\t\t\t\t\t\tfoundValidator = true\n393|\t\t\t\t\t}\n394|\t\t\t\t\treturn true\n395|\t\t\t\t})\n396|\t\t\t\tif foundValidator && validator < 0 {\n397|\t\t\t\t\tvalidator = index\n398|\t\t\t\t}\n399|\t\t\t\tif foundMarshal && marshalIdx < 0 {\n400|\t\t\t\t\tmarshalIdx = index\n401|\t\t\t\t}\n402|\t\t\t}\n403|\t\t\tif marshalIdx >= 0 {\n404|\t\t\t\tsites = append(sites, marshalCallSite{function: fn.Name.Name, validator: validator, marshalIdx: marshalIdx})\n405|\t\t\t}\n406|\t\t}\n407|\t}\n408|\treturn sites\n409|}\n410|\n411|func TestJSONMarshalFollowsValidator(t *testing.T) {\n412|\t// Structural pin: the only encoding/json.Marshal call in the\n413|\t// package's production files is in EscapeVisibleText, and the\n414|\t// shared validText gate runs in an earlier statement, so no\n415|\t// text value reaches the encoder unvalidated. A second\n416|\t// Marshal call site, a missing gate, or a reordering reddens\n417|\t// here; the behavioral refusal table proves the refusal\n418|\t// itself. Control-plant logs ride the evidence tar.\n419|\tsites := inspectMarshalCallSites(t)\n420|\tif len(sites) != 1 {\n421|\t\tfunctions := []string{}\n422|\t\tfor _, site := range sites {\n423|\t\t\tfunctions = append(functions, site.function)\n424|\t\t}\n425|\t\tt.Fatalf(\"json.Marshal call sites %q, want exactly [EscapeVisibleText]\", functions)\n426|\t}\n427|\tsite := sites[0]\n428|\tif site.function != \"EscapeVisibleText\" {\n429|\t\tt.Fatalf(\"json.Marshal call site %q, want EscapeVisibleText\", site.function)\n430|\t}\n431|\tif site.validator < 0 {\n432|\t\tt.Fatalf(\"EscapeVisibleText calls json.Marshal with no validText gate\")\n433|\t}\n434|\tif site.validator >= site.marshalIdx {\n435|\t\tt.Fatalf(\"EscapeVisibleText validates at statement %d, marshals at %d: gate must run first\", site.validator, site.marshalIdx)\n436|\t}\n437|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
