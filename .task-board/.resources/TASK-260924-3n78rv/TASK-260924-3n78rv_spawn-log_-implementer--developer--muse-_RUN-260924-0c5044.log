{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c627","stream":{"kind":"session","id":"01a0d381-286a-7d03-bf7e-13c4c16a42b5"},"sequence":366,"recorded_at":1780531400000727,"record_type":"event","durability":"durable","causation_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4603a868-01f4-4025-8e84-c5ce1f2882d9","run_stream":{"kind":"run","id":"4603a868-01f4-4025-8e84-c5ce1f2882d9"},"task_stream":{"kind":"task","id":"01a0d382-127c-7b42-b8e9-18cf4096d3ae"},"task_id":"01a0d382-127c-7b42-b8e9-18cf4096d3ae","event":{"kind":"output","task_id":"01a0d382-127c-7b42-b8e9-18cf4096d3ae","chunk":"Read text file `internal/cloneplanning/item.go`.\n1|package cloneplanning\n2|\n3|import (\n4|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n5|\t\"github.com/relux-works/agent-session-manager/internal/cloneproject\"\n6|)\n7|\n8|// This file bridges decoded Canonical Events to planning items.\n9|// Classification is by closed vocabularies only: the event kind\n10|// plus the completed/aborted tool resolution and the\n11|// encrypted/signed opaque protection. Every other payload text is\n12|// ignored (the sweep proves adversarial payload text cannot change\n13|// the item), and every unknown fact value refuses. The fact names\n14|// (resolution, protection) follow cloneproject's landed registry;\n15|// the completed/aborted spellings reference its exported statuses\n16|// so a rename breaks the build, and the protection spellings are\n17|// pinned against its source by the composition test.\n18|\n19|// Item is one plannable source class: exactly one of Kind (a\n20|// Canonical Event kind) or Block (a content-block type) is set.\n21|// Resolution carries the folded tool resolution for tool_call and\n22|// tool_result only; Protection carries the opaque protection for\n23|// opaque_reasoning (required) and opaque_event (admitted, the\n24|// unknown-native reason does not vary by it). Content blocks carry\n25|// neither fact: blocks have no protection member.\n26|type Item struct {\n27|\tKind       string\n28|\tBlock      string\n29|\tResolution string\n30|\tProtection string\n31|}\n32|\n33|// Protection spellings, quoted from cloneproject's landed\n34|// none|encrypted|signed envelope vocabulary.\n35|const (\n36|\tprotectionEncrypted = \"encrypted\"\n37|\tprotectionSigned    = \"signed\"\n38|)\n39|\n40|// toolKinds admit the folded resolution fact.\n41|var toolKinds = map[string]bool{\n42|\t\"tool_call\":   true,\n43|\t\"tool_result\": true,\n44|}\n45|\n46|// validResolution reports whether the value is an admitted\n47|// resolution: absent or one of cloneproject's folded statuses.\n48|func validResolution(value string) bool {\n49|\treturn value == \"\" || value == cloneproject.StatusCompleted || value == cloneproject.StatusAborted\n50|}\n51|\n52|// validProtection reports whether the value is an admitted\n53|// protection: absent, encrypted, or signed.\n54|func validProtection(value string) bool {\n55|\treturn value == \"\" || value == protectionEncrypted || value == protectionSigned\n56|}\n57|\n58|// requireValidItemText refuses an item carrying invalid UTF-8 in\n59|// any text member it consumes: kind, block, resolution, or\n60|// protection. Both planning entries apply it before the\n61|// vocabulary gates; the vocabulary gates below then decide among\n62|// valid strings only.\n63|func requireValidItemText(item Item) error {\n64|\tif !validText(item.Kind) {\n65|\t\treturn invalid(\"projection item kind is not valid UTF-8\")\n66|\t}\n67|\tif !validText(item.Block) {\n68|\t\treturn invalid(\"projection item block is not valid UTF-8\")\n69|\t}\n70|\tif !validText(item.Resolution) {\n71|\t\treturn invalid(\"projection item resolution is not valid UTF-8\")\n72|\t}\n73|\tif !validText(item.Protection) {\n74|\t\treturn invalid(\"projection item protection is not valid UTF-8\")\n75|\t}\n76|\treturn nil\n77|}\n78|\n79|// checkItem validates one caller-supplied item: exactly one class\n80|// member set, closed kind/block vocabularies, and kind-gated fact\n81|// admission with required facts present.\n82|func checkItem(item Item) error {\n83|\tif (item.Kind == \"\") == (item.Block == \"\") {\n84|\t\treturn invalid(\"projection item sets kind and block together or neither; exactly one class member is required\")\n85|\t}\n86|\tif item.Kind != \"\" {\n87|\t\tif !clonebundle.ValidEventKind(item.Kind) {\n88|\t\t\treturn invalid(\"projection item kind %q is not a Canonical Event kind\", item.Kind)\n89|\t\t}\n90|\t} else {\n91|\t\tif !clonebundle.ValidContentBlockType(item.Block) {\n92|\t\t\treturn invalid(\"projection item block %q is not a content-block type\", item.Block)\n93|\t\t}\n94|\t}\n95|\tif !validResolution(item.Resolution) {\n96|\t\treturn invalid(\"projection item resolution %q is outside completed|aborted\", item.Resolution)\n97|\t}\n98|\tif !validProtection(item.Protection) {\n99|\t\treturn invalid(\"projection item protection %q is outside encrypted|signed\", item.Protection)\n100|\t}\n101|\tif item.Block != \"\" {\n102|\t\tif item.Resolution != \"\" {\n103|\t\t\treturn invalid(\"projection item block carries a tool resolution; blocks carry no resolution fact\")\n104|\t\t}\n105|\t\tif item.Protection != \"\" {\n106|\t\t\treturn invalid(\"projection item block carries a protection fact; blocks carry no protection fact\")\n107|\t\t}\n108|\t\treturn nil\n109|\t}\n110|\tif toolKinds[item.Kind] {\n111|\t\tif item.Resolution == \"\" {\n112|\t\t\treturn invalid(\"projection item kind %q requires its completed|aborted resolution\", item.Kind)\n113|\t\t}\n114|\t} else if item.Resolution != \"\" {\n115|\t\treturn invalid(\"projection item kind %q carries a tool resolution; only tool_call and tool_result admit one\", item.Kind)\n116|\t}\n117|\tif item.Kind == \"opaque_reasoning\" {\n118|\t\tif item.Protection == \"\" {\n119|\t\t\treturn invalid(\"projection item kind opaque_reasoning requires its encrypted|signed protection\")\n120|\t\t}\n121|\t} else if item.Kind == \"opaque_event\" {\n122|\t\treturn nil\n123|\t} else if item.Protection != \"\" {\n124|\t\treturn invalid(\"projection item kind %q carries a protection fact; only opaque kinds admit one\", item.Kind)\n125|\t}\n126|\treturn nil\n127|}\n128|\n129|// ClassifyItem bridges one decoded Canonical Event to its planning\n130|// item: the kind plus the closed resolution/protection facts when\n131|// the landed payload carries them. Unknown fact values refuse;\n132|// every other payload member is ignored by type (the item has no\n133|// text field to carry it).\n134|func ClassifyItem(event clonebundle.CanonicalEvent) (Item, error) {\n135|\tif !validText(event.Kind) {\n136|\t\treturn Item{}, invalid(\"projection item kind is not valid UTF-8\")\n137|\t}\n138|\tif !clonebundle.ValidEventKind(event.Kind) {\n139|\t\treturn Item{}, invalid(\"projection item kind %q is not a Canonical Event kind\", event.Kind)\n140|\t}\n141|\tresolution, err := closedFact(event.Payload, \"resolution\")\n142|\tif err != nil {\n143|\t\treturn Item{}, err\n144|\t}\n145|\tprotection, err := closedFact(event.Payload, \"protection\")\n146|\tif err != nil {\n147|\t\treturn Item{}, err\n148|\t}\n149|\titem := Item{Kind: event.Kind, Resolution: resolution, Protection: protection}\n150|\tif err := requireValidItemText(item); err != nil {\n151|\t\treturn Item{}, err\n152|\t}\n153|\tif err := checkItem(item); err != nil {\n154|\t\treturn Item{}, err\n155|\t}\n156|\treturn item, nil\n157|}\n158|\n159|// closedFact reads one optional closed-vocabulary payload fact. An\n160|// absent member maps to absent; a present member must be a string,\n161|// and its admission is decided by the caller's vocabulary gate.\n162|func closedFact(payload map[string]any, name string) (string, error) {\n163|\traw, present := payload[name]\n164|\tif !present || raw == nil {\n165|\t\treturn \"\", nil\n166|\t}\n167|\tvalue, ok := raw.(string)\n168|\tif !ok {\n169|\t\treturn \"\", invalid(\"projection item fact %q is not a string\", name)\n170|\t}\n171|\treturn value, nil\n172|}","final_result":true}}}
