+        find='''\t\t\treturn dispositionSummarized, append(append([]string(nil), reasons...), reasonTargetContextLimit), nil''',
+        replace='''\t\t\treturn dispositionSummarized, append([]string(nil), reasons...), nil''',
+        count=1,
