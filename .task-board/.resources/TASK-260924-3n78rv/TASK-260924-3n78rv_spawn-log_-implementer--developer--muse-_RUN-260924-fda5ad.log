NT \\\\u2014 statements separated by ';', results keep source order\\\",\\n  \\\"arguments\\\": \\\"comma-separated arguments: the first bare positional value is the element/identifier argument; remaining arguments use key=value; no operators or lists (not key in [a,b], not key!=value)\\\",\\n  \\\"values\\\": \\\"a bare identifier (letters, digits, '_', '-', '.', '/'), an int, a bool (true|false), or a \\\\\\\"double-quoted string\\\\\\\"; quote any value containing spaces, commas or parentheses\\\",\\n  \\\"escapes\\\": [\\n   \\\"\\\\\\\\\\\\\\\"\\\",\\n   \\\"\\\\\\\\\\\\\\\\\\\",\\n   \\\"\\\\\\\\n\\\",\\n   \\\"\\\\\\\\t\\\"\\n  ],\\n  \\\"projection\\\": \\\"field projection: { field preset ... } \\\\u2014 space-separated field names and preset names inside braces; omitted means the default fields\\\",\\n  \\\"tokens\\\": [\\n   \\\"identifier\\\",\\n   \\\"string\\\",\\n   \\\"'('\\\",\\n   \\\"')'\\\",\\n   \\\"'{'\\\",\\n   \\\"'}'\\\",\\n   \\\"'='\\\",\\n   \\\"','\\\",\\n   \\\"';'\\\",\\n   \\\"end of input\\\"\\n  ],\\n  \\\"examples\\\": [\\n   \\\"op()\\\",\\n   \\\"op(key=value)\\\",\\n   \\\"op(key=value, other=42, flag=true)\\\",\\n   \\\"op(key=\\\\\\\"quoted value with \\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\\ \\\\\\\\n \\\\\\\\t\\\\\\\")\\\",\\n   \\\"op(positional)\\\",\\n   \\\"op() { field preset }\\\",\\n   \\\"op(key=value) { field }; other()\\\"\\n  ]\\n },\\n \\\"mutationMetadata\\\": {\\n  \\\"accept_cr\\\": {\\n   \\\"description\\\": \\\"Record an evidence-backed reviewer acceptance and route the element to integrating\\\",\\n   \\\"parameters\\\": [\\n    {\\n     \\\"name\\\": \\\"id\\\",\\n     \\\"type\\\": \\\"string\\\",\\n     \\\"optional\\\": false,\\n     \\\"description\\\": \\\"Element ID carrying the Change Request\\\",\\n     \\\"required\\\": true\\n    },\\n    {\\n     \\\"name\\\": \\\"revision\\\",\\n     \\\"type\\\": \\\"int\\\",\\n     \\\"optional\\\": false,\\n     \\\"description\\\": \\\"Change Request revision being accepted (expected-revision CAS)\\\",\\n     \\\"required\\\": true\\n    },\\n    {\\n     \\\"name\\\": \\\"evidence\\\",\\n     \\\"type\\\": \\\"string\\\",\\n     \\\"optional\\\": false,\\n     \\\"description\\\": \\\"Task-scoped outcome resource name carrying the verdict evidence\\\",\\n     \\\"required\\\": true\\n    }\\n   ],\\n   \\\"examples\\\": [\\n    \\\"accept_cr(TASK-260803-323q82, revision=2, evidence=TASK-260803-323q82_review-verdict-rev2.md)\\\"\\n   ],\\n   \\\"destructive\\\": false,\\n   \\\"idempotent\\\": false\\n  },\\n  \\\"add_checklist_item\\\": {\\n   \\\"description\\\": \\\"Add a new checklist item\\\",\\n   \\\"parameters\\\": [\\n    {\\n     \\\"name\\\": \\\"id\\\",\\n     \\\"type\\\": \\\"string\\\",\\n     \\\"optional\\\": false,\\n     \\\"description\\\": \\\"Element ID\\\",\\n     \\\"required\\\": true\\n    },\\n    {\\n     \\\"name\\\": \\\"text\\\",\\n     \\\"type\\\": \\\"string\\\",\\n     \\\"optional\\\": false,\\n     \\\"description\\\": \\\"Checklist item text\\\",\\n     \\\"required\\\": true\\n    }\\n   ],\\n   \\\"examples\\\": [\\n    \\\"add_checklist_item(TASK-260218-abc123, text=\\\\\\\"Write unit tests\\\\\\\")\\\"\\n   ],\\n   \\\"destructive\\\": false,\\n   \\\"idempotent\\\": false\\n  },\\n  \\\"add_resource\\\": {\\n   \\\"description\\\": \\\"Add a text resource to an element\\\",\\n   \\\"parameters\\\": [\\n    {\\n     \\\"name\\\": \\\"id\\\",\\n     \\\"type\\\": \\\"string\\\",\\n     \\\"optional\\\": false,\\n     \\\"description\\\": \\\"Element ID\\\",\\n     \\\"required\\\": true\\n    },\\n    {\\n     \\\"name\\\": \\\"name\\\",\\n     \\\"type\\\": \\\"string\\\",\\n     \\\"optional\\\": false,\\n     \\\"description\\\": \\\"Resource name (e.g. research.md)\\\",\\n     \\\"required\\\": true\\n    },\\n    {\\n     \\\"name\\\": \\\"content\\\",\\n     \\\"type\\\": \\\"string\\\",\\n     \\\"optional\\\": true,\\n     \\\"description\\\": \\\"Resource content (text); required if path is not provided\\\"\\n    },\\n    {\\n     \\\"name\\\": \\\"path\\\",\\n     \\\"type\\\": \\\"string\\\",\\n     \\\"optional\\\": true,\\n     \\\"description\\\": \\\"Client-local file path (remote CLI inlines content; board-server rejects raw paths)\\\"\\n    },\\n    {\\n     \\\"name\\\": \\\"type\\\",\\n     \\\"type\\\": \\\"string\\\",\\n     \\\"optional\\\": true,\\n     \\\"default\\\": \\\"outcome\\\",\\n     \\\"description\\\": \\\"Resource type\\\",\\n     \\\"enum\\\": [\\n      \\\"precondition\\\",\\n      \\\"outcome\\\"\\n     ]\\n    },\\n    {\\n     \\\"name\\\": \\\"description\\\",\\n     \\\"type\\\": \\\"string\\\",\\n     \\\"optional\\\": true,\\n     \\\"description\\\": \\\"One-line description\\\"\\n    }\\n   ],\\n   \\\"examples\\\": [\\n    \\\"add_resource(TASK-260218-abc123, name=\\\\\\\"research.md\\\\\\\", content=\\\\\\\"...\\\\\\\", type=outcome)\\\",\\n    \\\"add_resource(TASK-260218-abc123, name=\\\\\\\"spec.md\\\\\\\", path=\\\\\\\".temp/spec.md\\\\\\\", type=precondition)\\\"\\n   ],\\n   \\\"destructive\\\": false,\\n   \\\"idempotent\\\": false\\n  },\\n  \\\"assign\\\": {\\n   \\\"description\\\": \\\"Assign an agent to an element\\\",\\n   \\\"parameters\\\": [\\n    {\\n     \\\"name\\\": \\\"id\\\",\\n     \\\"type\\\": \\\"string\\\",\\n     \\\"optional\\\": false,\\n     \\\"description\\\": \\\"Element ID\\\",\\n     \\\"required\\\": true\\n    },\\n    {\\n     \\\"name\\\": \\\"agent\\\",\\n     \\\"type\\\": \\\"string\\\",\\n     \\\"optional\\\": false,\\n     \\\"description\\\": \\\"Agent name\\\",\\n     \\\"required\\\": true\\n    }\\n   ],\\n   \\\"examples\\\": [\\n    \\\"assign(TASK-260218-abc123, agent=claude-opus)\\\"\\n   ],\\n   \\\"destructive\\\": false,\\n   \\\"idempotent\\\": true\\n  },\\n  \\\"audit_context_validation\\\": {\\n   \\\"description\\\": \\\"Run one no-model validation audit over a ready context and apply its consequence\\\",\\n   \\\"parameters\\\": [\\n    {\\n     \\\"name\\\": \\\"id\\\",\\n     \\\"type\\\": \\\"string\\\",\\n     \\\"optional\\\": false,\\n     \\\"description\\\": \\\"CTX identifier\\\",\\n     \\\"required\\\": true\\n    },\\n    {\\n     \\\"name\\\": \\\"expected_revision\\\",\\n     \\\"type\\\": \\\"int\\\",\\n     \\\"optional\\\": true,\\n     \\\"description\\\": \\\"Observed record revision\\\"\\n    },\\n    {\\n     \\\"name\\\": \\\"trigger\\\",\\n     \\\"type\\\": \\\"string\\\",\\n     \\\"optional\\\": true,\\n     \\\"default\\\": \\\"daily_audit\\\",\\n     \\\"description\\\": \\\"Audit to run; the model gate is not reachable here\\\",\\n     \\\"enum\\\": [\\n      \\\"daily_audit\\\",\\n      \\\"deep_audit\\\",\\n      \\\"fork_preflight\\\",\\n      \\\"validator_policy_change\\\"\\n     ]\\n    },\\n    {\\n     \\\"name\\\": \\\"payload_sha256\\\",\\n     \\\"type\\\": \\\"string\\\",\\n     \\\"optional\\\": true,\\n     \\\"description\\\": \\\"Observed payload digest\\\"\\n    },\\n    {\\n     \\\"name\\\": \\\"coverage_manifest_sha256\\\",\\n     \\\"type\\\": \\\"string\\\",\\n     \\\"optional\\\": true,\\n     \\\"description\\\": \\\"Observed manifest digest; a deep audit needs it\\\"\\n    },\\n    {\\n     \\\"name\\\": \\\"anchor_commit\\\",\\n     \\\"type\\\": \\\"string\\\",\\n     \\\"optional\\\": true,\\n     \\\"description\\\": \\\"Observed anchor commit; a deep audit needs it\\\"\\n    },\\n    {\\n     \\\"name\\\": \\\"boundary_drift\\\",\\n     \\\"type\\\": \\\"bool\\\",\\n     \\\"optional\\\": true,\\n     \\\"default\\\": false,\\n     \\\"description\\\": \\\"In-boundary change the caller detected\\\"\\n    },\\n    {\\n     \\\"name\\\": \\\"finding\\\",\\n     \\\"type\\\": \\\"string\\\",\\n     \\\"optional\\\": true,\\n     \\\"description\\\": \\\"Post-publication finding; quarantines\\\",\\n     \\\"enum\\\": [\\n      \\\"known_falsehood\\\",\\n      \\\"contaminated\\\",\\n      \\\"integrity_failed\\\"\\n     ]\\n    },\\n    {\\n     \\\"name\\\": \\\"at\\\",\\n     \\\"type\\\": \\\"string\\\",\\n     \\\"optional\\\": true,\\n     \\\"description\\\": \\\"RFC3339 audit instant\\\"\\n    }\\n   ],\\n   \\\"examples\\\": [\\n    \\\"audit_context_validation(CTX-260728-a1b2c3, trigger=daily_audit)\\\",\\n    \\\"audit_context_validation(CTX-260728-a1b2c3, trigger=deep_audit, coverage_manifest_sha256=abc123, anchor_commit=def456)\\\"\\n   ],\\n   \\\"destructive\\\": false,\\n   \\\"idempotent\\\": false\\n  },\\n  \\\"check_item\\\": {\\n   \\\"description\\\": \\\"Check a checklist item\\\",\\n   \\\"parameters\\\": [\\n    {\\n     \\\"name\\\": \\\"id\\\",\\n     \\\"type\\\": \\\"string\\\",\\n     \\\"optional\\\": false,\\n     \\\"description\\\": \\\"Element ID\\\",\\n     \\\"required\\\": true\\n    },\\n    {\\n     \\\"name\\\": \\\"item\\\",\\n     \\\"type\\\": \\\"int\\\",\\n     \\\"optional\\\": false,\\n     \\\"description\\\": \\\"Checklist item number (1-based)\\\",\\n     \\\"required\\\": true\\n    }\\n   ],\\n   \\\"examples\\\": [\\n    \\\"check_item(TASK-260218-abc123, item=1)\\\"\\n   ],\\n   \\\"destructive\\\": false,\\n   \\\"idempotent\\\": true\\n  },\\n  \\\"collect_context_retention\\\": {\\n   \\\"description\\\": \\\"Retire what a never-pruning provider left behind and name the payloads to delete\\\",\\n   \\\"parameters\\\": [\\n    {\\n     \\\"name\\\": \\\"warn_days\\\",\\n     \\\"type\\\": \\\"int\\\",\\n     \\\"optional\\\": true,\\n     \\\"default\\\": 7,\\n     \\\"description\\\": \\\"Expiry warning horizon\\\"\\n    },\\n    {\\n     \\\"name\\\": \\\"include_pinned\\\",\\n     \\\"type\\\": \\\"bool\\\",\\n     \\\"optional\\\": true,\\n     \\\"default\\\": false,\\n     \\\"description\\\": \\\"Collect pinned contexts\\n\",\n  \"original_output_bytes\": 8001,\n  \"original_output_tokens\": 2001,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
