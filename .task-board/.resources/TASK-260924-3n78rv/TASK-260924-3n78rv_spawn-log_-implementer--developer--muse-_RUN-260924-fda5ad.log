{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c643","stream":{"kind":"session","id":"01a0d33e-21a1-7dd1-8410-6ee446430389"},"sequence":380,"recorded_at":1780531400000755,"record_type":"event","durability":"durable","causation_id":"4e561a79-c0d9-4ce2-8e43-bf7439b5274c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4e561a79-c0d9-4ce2-8e43-bf7439b5274c","run_stream":{"kind":"run","id":"4e561a79-c0d9-4ce2-8e43-bf7439b5274c"},"task_stream":{"kind":"task","id":"01a0d33e-e04b-76d1-a18a-b43b3d33a321"},"task_id":"01a0d33e-e04b-76d1-a18a-b43b3d33a321","event":{"kind":"output","task_id":"01a0d33e-e04b-76d1-a18a-b43b3d33a321","chunk":"Read text file `internal/cloneplanning/item.go`.\n1|package cloneplanning\n2|\n3|import (\n4|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n5|\t\"github.com/relux-works/agent-session-manager/internal/cloneproject\"\n6|)\n7|\n8|// This file bridges decoded Canonical Events to planning items.\n9|// Classification is by closed vocabularies only: the event kind\n10|// plus the completed/aborted tool resolution and the\n11|// encrypted/signed opaque protection. Every other payload text is\n12|// ignored (the sweep proves adversarial payload text cannot change\n13|// the item), and every unknown fact value refuses. The fact names\n14|// (resolution, protection) follow cloneproject's landed registry;\n15|// the completed/aborted spellings reference its exported statuses\n16|// so a rename breaks the build, and the protection spellings are\n17|// pinned against its source by the composition test.\n18|\n19|// Item is one plannable source class: exactly one of Kind (a\n20|// Canonical Event kind) or Block (a content-block type) is set.\n21|// Resolution carries the folded tool resolution for tool_call and\n22|// tool_result only; Protection carries the opaque protection for\n23|// opaque_reasoning (required) and opaque_event (admitted, the\n24|// unknown-native reason does not vary by it). Content blocks carry\n25|// neither fact: blocks have no protection member.\n26|type Item struct {\n27|\tKind       string\n28|\tBlock      string\n29|\tResolution string\n30|\tProtection string\n31|}\n32|\n33|// Protection spellings, quoted from cloneproject's landed\n34|// none|encrypted|signed envelope vocabulary.\n35|const (\n36|\tprotectionEncrypted = \"encrypted\"\n37|\tprotectionSigned    = \"signed\"\n38|)\n39|\n40|// toolKinds admit the folded resolution fact.\n41|var toolKinds = map[string]bool{\n42|\t\"tool_call\":   true,\n43|\t\"tool_result\": true,\n44|}\n45|\n46|// validResolution reports whether the value is an admitted\n47|// resolution: absent or one of cloneproject's folded statuses.\n48|func validResolution(value string) bool {\n49|\treturn value == \"\" || value == cloneproject.StatusCompleted || value == cloneproject.StatusAborted\n50|}\n51|\n52|// validProtection reports whether the value is an admitted\n53|// protection: absent, encrypted, or signed.\n54|func validProtection(value string) bool {\n55|\treturn value == \"\" || value == protectionEncrypted || value == protectionSigned\n56|}\n57|\n58|// checkItem validates one caller-supplied item: exactly one class\n59|// member set, closed kind/block vocabularies, and kind-gated fact\n60|// admission with required facts present.\n61|func checkItem(item Item) error {\n62|\tif (item.Kind == \"\") == (item.Block == \"\") {\n63|\t\treturn invalid(\"projection item sets kind and block together or neither; exactly one class member is required\")\n64|\t}\n65|\tif item.Kind != \"\" {\n66|\t\tif !clonebundle.ValidEventKind(item.Kind) {\n67|\t\t\treturn invalid(\"projection item kind %q is not a Canonical Event kind\", item.Kind)\n68|\t\t}\n69|\t} else {\n70|\t\tif !clonebundle.ValidContentBlockType(item.Block) {\n71|\t\t\treturn invalid(\"projection item block %q is not a content-block type\", item.Block)\n72|\t\t}\n73|\t}\n74|\tif !validResolution(item.Resolution) {\n75|\t\treturn invalid(\"projection item resolution %q is outside completed|aborted\", item.Resolution)\n76|\t}\n77|\tif !validProtection(item.Protection) {\n78|\t\treturn invalid(\"projection item protection %q is outside encrypted|signed\", item.Protection)\n79|\t}\n80|\tif item.Block != \"\" {\n81|\t\tif item.Resolution != \"\" {\n82|\t\t\treturn invalid(\"projection item block carries a tool resolution; blocks carry no resolution fact\")\n83|\t\t}\n84|\t\tif item.Protection != \"\" {\n85|\t\t\treturn invalid(\"projection item block carries a protection fact; blocks carry no protection fact\")\n86|\t\t}\n87|\t\treturn nil\n88|\t}\n89|\tif toolKinds[item.Kind] {\n90|\t\tif item.Resolution == \"\" {\n91|\t\t\treturn invalid(\"projection item kind %q requires its completed|aborted resolution\", item.Kind)\n92|\t\t}\n93|\t} else if item.Resolution != \"\" {\n94|\t\treturn invalid(\"projection item kind %q carries a tool resolution; only tool_call and tool_result admit one\", item.Kind)\n95|\t}\n96|\tif item.Kind == \"opaque_reasoning\" {\n97|\t\tif item.Protection == \"\" {\n98|\t\t\treturn invalid(\"projection item kind opaque_reasoning requires its encrypted|signed protection\")\n99|\t\t}\n100|\t} else if item.Kind == \"opaque_event\" {\n101|\t\treturn nil\n102|\t} else if item.Protection != \"\" {\n103|\t\treturn invalid(\"projection item kind %q carries a protection fact; only opaque kinds admit one\", item.Kind)\n104|\t}\n105|\treturn nil\n106|}\n107|\n108|// ClassifyItem bridges one decoded Canonical Event to its planning\n109|// item: the kind plus the closed resolution/protection facts when\n110|// the landed payload carries them. Unknown fact values refuse;\n111|// every other payload member is ignored by type (the item has no\n112|// text field to carry it).\n113|func ClassifyItem(event clonebundle.CanonicalEvent) (Item, error) {\n114|\tif !clonebundle.ValidEventKind(event.Kind) {\n115|\t\treturn Item{}, invalid(\"projection item kind %q is not a Canonical Event kind\", event.Kind)\n116|\t}\n117|\tresolution, err := closedFact(event.Payload, \"resolution\")\n118|\tif err != nil {\n119|\t\treturn Item{}, err\n120|\t}\n121|\tprotection, err := closedFact(event.Payload, \"protection\")\n122|\tif err != nil {\n123|\t\treturn Item{}, err\n124|\t}\n125|\titem := Item{Kind: event.Kind, Resolution: resolution, Protection: protection}\n126|\tif err := checkItem(item); err != nil {\n127|\t\treturn Item{}, err\n128|\t}\n129|\treturn item, nil\n130|}\n131|\n132|// closedFact reads one optional closed-vocabulary payload fact. An\n133|// absent member maps to absent; a present member must be a string,\n134|// and its admission is decided by the caller's vocabulary gate.\n135|func closedFact(payload map[string]any, name string) (string, error) {\n136|\traw, present := payload[name]\n137|\tif !present || raw == nil {\n138|\t\treturn \"\", nil\n139|\t}\n140|\tvalue, ok := raw.(string)\n141|\tif !ok {\n142|\t\treturn \"\", invalid(\"projection item fact %q is not a string\", name)\n143|\t}\n144|\treturn value, nil\n145|}","final_result":true}}}
