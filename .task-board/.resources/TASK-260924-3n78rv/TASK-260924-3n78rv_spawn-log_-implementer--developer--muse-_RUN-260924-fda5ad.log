{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c695","stream":{"kind":"session","id":"01a0d33e-21a1-7dd1-8410-6ee446430389"},"sequence":421,"recorded_at":1780531400000837,"record_type":"event","durability":"durable","causation_id":"4e561a79-c0d9-4ce2-8e43-bf7439b5274c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4e561a79-c0d9-4ce2-8e43-bf7439b5274c","run_stream":{"kind":"run","id":"4e561a79-c0d9-4ce2-8e43-bf7439b5274c"},"task_stream":{"kind":"task","id":"01a0d33f-6a26-7c62-9685-b9c094ea8baa"},"task_id":"01a0d33f-6a26-7c62-9685-b9c094ea8baa","event":{"kind":"output","task_id":"01a0d33f-6a26-7c62-9685-b9c094ea8baa","chunk":"Read text file `internal/cloneplanning/testdata/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for internal/cloneplanning.\n3|\n4|Every gate ships a narrowing mutant: the gate stays present and is\n5|weakened to admit exactly one member of the class it must reject,\n6|and the named killer test must fail when run alone. A delete-only\n7|mutant proves only that the gate exists and is not accepted as\n8|evidence.\n9|\n10|Each row runs M (mutate one production file in place), R (run the\n11|scoped Go killer through a production entry), V (verdict from the Go\n12|exit code plus a FAIL kill-line: KILLED iff R fails with a test\n13|failure line, SURVIVED iff R passes, ERROR for anything else --\n14|unapplied patches, build breaks, timeouts). M failures and R\n15|infrastructure errors are ERROR, never kills or survivals. The file\n16|is restored from its backup after every row, pass or fail.\n17|\n18|Shared gates (the checkItem vocabulary and fact gates with two call\n19|sites: PlanItem and ClassifyItem) carry one plant each with the\n20|both-entries killer TestSharedItemVocabBothEntries.\n21|\n22|Row N-visible-escape-suffix is the token-preserving attack: the\n23|JSON token still leads the output but the behavior changes, and the\n24|killer executes the behavioral escaping suite.\n25|\n26|Single-member-class rows narrow a gate whose reject class holds\n27|exactly one member, so the plant admits the whole class, which is\n28|one member.\n29|\n30|Row C-doc-comment is the harmless control: a comment-only edit that\n31|must SURVIVE, proving the harness observes test outcomes instead of\n32|hard-coding kills.\n33|\n34|Usage:\n35|  PYTHONDONTWRITEBYTECODE=1 python3 internal/cloneplanning/testdata/mutant_harness.py [--log-dir DIR] [MUTANT ...]\n36|\"\"\"\n37|\n38|import shutil\n39|import subprocess\n40|import sys\n41|import tempfile\n42|import time\n43|from dataclasses import dataclass\n44|from pathlib import Path\n45|\n46|REPO = Path(__file__).resolve().parents[3]\n47|PACKAGE = \"internal/cloneplanning\"\n48|\n49|\n50|@dataclass(frozen=True)\n51|class Mutant:\n52|    name: str\n53|    path: str\n54|    find: str\n55|    replace: str\n56|    count: int\n57|    run: str\n58|    expect: str\n59|    note: str\n60|\n61|\n62|MUTANTS = [\n63|    Mutant(\n64|        name=\"N-select-archive-priority\",\n65|        path=f\"{PACKAGE}/strategy.go\",\n66|        find='''\\tif archive {\\n\\t\\treturn strategyArchive, nil\\n\\t}\\n\\tif continuation {\\n\\t\\treturn strategyContinuation, nil\\n\\t}''',\n67|        replace='''\\tif continuation {\\n\\t\\treturn strategyContinuation, nil\\n\\t}\\n\\tif archive {\\n\\t\\treturn strategyArchive, nil\\n\\t}''',\n68|        count=1,\n69|        run=\"TestSelectStrategyOracle\",\n70|        expect=\"KILLED\",\n71|        note=\"Narrows the priority gate: archive+continuation selects continuation instead of archive.\",\n72|    ),\n73|    Mutant(\n74|        name=\"N-select-official\",\n75|        path=f\"{PACKAGE}/strategy.go\",\n76|        find='''\\tif !sameEnvironment {\\n\\t\\tif officialImport {\\n\\t\\t\\treturn strategyOfficial, nil\\n\\t\\t}\\n\\t\\treturn strategyNativeWriter, nil\\n\\t}\\n\\treturn strategyNativeRewrite, nil''',\n77|        replace='''\\tif officialImport {\\n\\t\\treturn strategyOfficial, nil\\n\\t}\\n\\tif !sameEnvironment {\\n\\t\\treturn strategyNativeWriter, nil\\n\\t}\\n\\treturn strategyNativeRewrite, nil''',\n78|        count=1,\n79|        run=\"TestSelectStrategyOracle\",\n80|        expect=\"KILLED\",\n81|        note=\"Narrows the pair arm: same-environment with the importer selects official import instead of native rewrite.\",\n82|    ),\n83|    Mutant(\n84|        name=\"N-select-profile-archive\",\n85|        path=f\"{PACKAGE}/strategy.go\",\n86|        find='''\\tif requested == profileArchive {\\n\\t\\treturn BranchArchive, requested, nil\\n\\t}''',\n87|        replace='''\\tif requested == profileArchive {\\n\\t\\treturn BranchTarget, requested, nil\\n\\t}''',\n88|        count=1,\n89|        run=\"TestSelectProfileOracle\",\n90|        expect=\"KILLED\",\n91|        note=\"Narrows the branch router: archive_only routes target instead of archive.\",\n92|    ),\n93|    Mutant(\n94|        name=\"N-select-profile-unknown\",\n95|        path=f\"{PACKAGE}/strategy.go\",\n96|        find='''\\tif !cloneplan.ValidPlanProfile(requested) {''',\n97|        replace='''\\tif requested != \"bogus_profile\" && !cloneplan.ValidPlanProfile(requested) {''',\n98|        count=1,\n99|        run=\"TestSelectProfileOracle\",\n100|        expect=\"KILLED\",\n101|        note=\"Narrows the plan-profile gate: admits exactly bogus_profile to the target branch.\",\n102|    ),\n103|    Mutant(\n104|        name=\"N-kind-vocab\",\n105|        path=f\"{PACKAGE}/item.go\",\n106|        find='''\\t\\tif !clonebundle.ValidEventKind(item.Kind) {''',\n107|        replace='''\\t\\tif item.Kind != \"bogus_kind\" && !clonebundle.ValidEventKind(item.Kind) {''',\n108|        count=1,\n109|        run=\"TestSharedItemVocabBothEntries\",\n110|        expect=\"KILLED\",\n111|        note=\"Shared gate: admits exactly bogus_kind through both PlanItem and ClassifyItem.\",\n112|    ),\n113|    Mutant(\n114|        name=\"N-block-vocab\",\n115|        path=f\"{PACKAGE}/item.go\",\n116|        find='''\\t\\tif !clonebundle.ValidContentBlockType(item.Block) {''',\n117|        replace='''\\t\\tif item.Block != \"bogus_block\" && !clonebundle.ValidContentBlockType(item.Block) {''',\n118|        count=1,\n119|        run=\"TestSharedItemVocabBothEntries\",\n120|        expect=\"KILLED\",\n121|        note=\"Shared gate: admits exactly bogus_block through PlanItem (blocks have no event bridge).\",\n122|    ),\n123|    Mutant(\n124|        name=\"N-resolution-vocab\",\n125|        path=f\"{PACKAGE}/item.go\",\n126|        find='''\\tif !validResolution(item.Resolution) {''',\n127|        replace='''\\tif item.Resolution != \"bogus_resolution\" && !validResolution(item.Resolution) {''',\n128|        count=1,\n129|        run=\"TestSharedItemVocabBothEntries\",\n130|        expect=\"KILLED\",\n131|        note=\"Shared gate: admits exactly bogus_resolution through both entries.\",\n132|    ),\n133|    Mutant(\n134|        name=\"N-protection-vocab\",\n135|        path=f\"{PACKAGE}/item.go\",\n136|        find='''\\tif !validProtection(item.Protection) {''',\n137|        replace='''\\tif item.Protection != \"bogus_protection\" && !validProtection(item.Protection) {''',\n138|        count=1,\n139|        run=\"TestSharedItemVocabBothEntries\",\n140|        expect=\"KILLED\",\n141|        note=\"Shared gate: admits exactly bogus_protection through both entries.\",\n142|    ),\n143|    Mutant(\n144|        name=\"N-classify-resolution-required\",\n145|        path=f\"{PACKAGE}/item.go\",\n146|        find='''\\tif toolKinds[item.Kind] {\\n\\t\\tif item.Resolution == \"\" {\\n\\t\\t\\treturn invalid(\"projection item kind %q requires its completed|aborted resolution\", item.Kind)\\n\\t\\t}''',\n147|        replace='''\\tif toolKinds[item.Kind] {\\n\\t\\tif item.Resolution == \"\" && item.Kind != \"tool_call\" {\\n\\t\\t\\treturn invalid(\"projection item kind %q requires its completed|aborted resolution\", item.Kind)\\n\\t\\t}''',\n148|        count=1,\n149|        run=\"TestClassifyItemRefusals\",\n150|        expect=\"KILLED\",\n151|        note=\"Narrows the required-resolution gate: tool_call without resolution admits, tool_result still refuses.\",\n152|    ),\n153|    Mutant(\n154|        name=\"N-classify-protection-required\",\n155|        path=f\"{PACKAGE}/item.go\",\n156|        find='''\\tif item.Kind == \"opaque_reasoning\" {\\n\\t\\tif item.Protection == \"\" {\\n\\t\\t\\treturn invalid(\"projection item kind opaque_reasoning requires its encrypted|signed protection\")\\n\\t\\t}''',\n157|        replace='''\\tif item.Kind == \"opaque_reasoning\" {\\n\\t\\tif item.Protection == \"\" && item.Kind != \"opaque_reasoning\" {\\n\\t\\t\\treturn invalid(\"projection item kind opaque_reasoning requires its encrypted|signed protection\")\\n\\t\\t}''',\n158|        count=1,\n159|        run=\"TestClassifyItemRefusals\",\n160|        expect=\"KILLED\",\n161|        note=\"Single-member-class narrowing: the gate whose reject class is exactly opaque_reasoning-without-protection admits it.\",\n162|    ),\n163|    Mutant(\n164|        name=\"N-classify-fact-type\",\n165|        path=f\"{PACKAGE}/item.go\",\n166|        find='''\\tvalue, ok := raw.(string)\\n\\tif !ok {\\n\\t\\treturn \"\", invalid(\"projection item fact %q is not a string\", name)\\n\\t}\\n\\treturn value, nil''',\n167|        replace='''\\tif _, isInt := raw.(int64); isInt {\\n\\t\\treturn \"\", nil\\n\\t}\\n\\tvalue, ok := raw.(string)\\n\\tif !ok {\\n\\t\\treturn \"\", invalid(\"projection item fact %q is not a string\", name)\\n\\t}\\n\\treturn value, nil''',\n168|        count=1,\n169|        run=\"TestClassifyItemRefusals\",\n170|        expect=\"KILLED\",\n171|        note=\"Narrows the fact-type gate: admits exactly int64-typed facts as absent (the landed decoder renders numbers int64); bool and object facts still refuse.\",\n172|    ),\n173|    Mutant(\n174|        name=\"N-strategy-vocab\",\n175|        path=f\"{PACKAGE}/plan.go\",\n176|        find='''\\tif !clonefidelity.ValidStrategy(strategy) {''',\n177|        replace='''\\tif strategy != \"bogus_strategy\" && !clonefidelity.ValidStrategy(strategy) {''',\n178|        count=1,\n179|        run=\"TestPlanItemInvalidArms\",\n180|        expect=\"KILLED\",\n181|        note=\"Narrows the strategy vocabulary delegation: admits exactly bogus_strategy.\",\n182|    ),\n183|    Mutant(\n184|        name=\"N-profile-vocab\",\n185|        path=f\"{PACKAGE}/plan.go\",\n186|        find='''\\tcase profileMaximalSafe:\\n\\t\\treturn disposition, reasons, nil\\n\\tdefault:\\n\\t\\treturn \"\", nil, invalid(\"projection profile %q is not a target plan profile\", profile)''',\n187|        replace='''\\tcase profileMaximalSafe:\\n\\t\\treturn disposition, reasons, nil\\n\\tcase \"bogus_profile\":\\n\\t\\treturn disposition, reasons, nil\\n\\tdefault:\\n\\t\\treturn \"\", nil, invalid(\"projection profile %q is not a target plan profile\", profile)''',\n188|        count=1,\n189|        run=\"TestPlanItemInvalidArms\",\n190|        expect=\"KILLED\",\n191|        note=\"Narrows the profile overlay default: admits exactly bogus_profile as a pass-through.\",\n192|    ),\n193|    Mutant(\n194|        name=\"N-archive-strategy\",\n195|        path=f\"{PACKAGE}/plan.go\",\n196|        find='''\\tif strategy == strategyArchive || profile == profileArchive {''',\n197|        replace='''\\tif !(strategy == strategyArchive && profile == profileMaximalSafe) && (strategy == strategyArchive || profile == profileArchive) {''',\n198|        count=1,\n199|        run=\"TestPlanItemArchiveRule\",\n200|        expect=\"KILLED\",\n201|        note=\"Narrows the archive gate: admits exactly the archive_only/maximal_safe cell.\",\n202|    ),\n203|    Mutant(\n204|        name=\"N-archive-profile\",\n205|        path=f\"{PACKAGE}/plan.go\",\n206|        find='''\\tif strategy == strategyArchive || profile == profileArchive {''',\n207|        replac