      string\\ninternal/clonebundle/event.go-387-\\tPayload          map[string]any\\ninternal/clonebundle/event.go-388-\\tEvidence         SourceEvidence\\ninternal/clonebundle/event.go-389-}\\ninternal/clonebundle/event.go-390-\\ninternal/clonebundle/event.go-391-// RawRefInput is one caller-supplied raw reference candidate.\\ninternal/clonebundle/event.go-392-type RawRefInput struct {\\ninternal/clonebundle/event.go-393-\\tManifestID       string\\ninternal/clonebundle/event.go-394-\\tBlobDescriptorID string\\ninternal/clonebundle/event.go-395-\\tOffset           uint64\\ninternal/clonebundle/event.go-396-\\tLength           uint64\\ninternal/clonebundle/event.go-397-}\\n===ValidReasonCode===\\ninternal/clonefidelity/vocab.go:169:func ValidReasonCode(code string) bool {\\ninternal/clonefidelity/vocab.go-170-\\tif IsCoreReasonCode(code) {\\ninternal/clonefidelity/vocab.go-171-\\t\\treturn true\\ninternal/clonefidelity/vocab.go-172-\\t}\\ninternal/clonefidelity/vocab.go-173-\\treturn isExtensionReason(code)\\ninternal/clonefidelity/vocab.go-174-}\\ninternal/clonefidelity/vocab.go-175-\\ninternal/clonefidelity/vocab.go-176-// isExtensionReason reports whether the code is a reverse-DNS\\ninternal/clonefidelity/vocab.go-177-// extension reason. It delegates to the single environ grammar so\\ninternal/clonefidelity/vocab.go-178-// extension reasons and extension keys can never drift.\\ninternal/clonefidelity/vocab.go-179-func isExtensionReason(code string) bool {\\ninternal/clonefidelity/vocab.go-180-\\treturn environ.CheckReverseDNS(code)\\ninternal/clonefidelity/vocab.go-181-}\\n===ParseDigest/String===\\ninternal/scalar/time_digest.go:132:func ParseDigest(value string) (Digest, error) {\\ninternal/scalar/time_digest.go-133-\\tif len(value) != len(\\\"sha256:\\\")+sha256.Size*2 || !strings.HasPrefix(value, \\\"sha256:\\\") {\\ninternal/scalar/time_digest.go-134-\\t\\treturn Digest{}, invalid(\\\"digest\\\", \\\"must use the sha256 prefix and exactly 64 digits\\\")\\ninternal/scalar/time_digest.go-135-\\t}\\ninternal/scalar/time_digest.go-136-\\tfor index := len(\\\"sha256:\\\"); index < len(value); index++ {\\ninternal/scalar/time_digest.go-137-\\t\\tif !isLowerHex(value[index]) {\\ninternal/scalar/time_digest.go-138-\\t\\t\\treturn Digest{}, invalid(\\\"digest\\\", \\\"must contain lowercase hexadecimal digits\\\")\\ninternal/scalar/time_digest.go-139-\\t\\t}\\ninternal/scalar/time_digest.go-140-\\t}\\ninternal/scalar/time_digest.go-141-\\treturn Digest{value: value}, nil\\ninternal/scalar/time_digest.go-142-}\\ninternal/scalar/time_digest.go-143-\\ninternal/scalar/time_digest.go-144-func SHA256Digest(value []byte) Digest {\\ninternal/scalar/time_digest.go-145-\\tsum := sha256.Sum256(value)\\ninternal/scalar/time_digest.go-146-\\treturn Digest{value: \\\"sha256:\\\" + hex.EncodeToString(sum[:])}\\ninternal/scalar/time_digest.go-147-}\\ninternal/scalar/time_digest.go-148-\\ninternal/scalar/time_digest.go-149-func (value Digest) String() string { return value.value }\\ninternal/scalar/time_digest.go-150-func (value Digest) Hex() string    { return strings.TrimPrefix(value.value, \\\"sha256:\\\") }\\ninternal/scalar/time_digest.go-151-\\ninternal/scalar/time_digest.go-152-func (value Digest) MarshalText() ([]byte, error) {\\ninternal/scalar/time_digest.go:149:func (value Digest) String() string { return value.value }\\ninternal/scalar/time_digest.go-150-func (value Digest) Hex() string    { return strings.TrimPrefix(value.value, \\\"sha256:\\\") }\\ninternal/scalar/time_digest.go-151-\\ninternal/scalar/time_digest.go-152-func (value Digest) MarshalText() ([]byte, error) {\\ninternal/scalar/time_digest.go-153-\\treturn marshalValidatedText(value.value, func(candidate string) error {\\ninternal/scalar/time_digest.go-154-\\t\\t_, err := ParseDigest(candidate)\\ninternal/scalar/time_digest.go-155-\\t\\treturn err\\ninternal/scalar/time_digest.go-156-\\t})\\ninternal/scalar/time_digest.go-157-}\\n\",\n  \"original_output_bytes\": 4350