{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5dd","stream":{"kind":"session","id":"01a0d33e-21a1-7dd1-8410-6ee446430389"},"sequence":329,"recorded_at":1780531400000653,"record_type":"event","durability":"durable","causation_id":"4e561a79-c0d9-4ce2-8e43-bf7439b5274c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4e561a79-c0d9-4ce2-8e43-bf7439b5274c","run_stream":{"kind":"run","id":"4e561a79-c0d9-4ce2-8e43-bf7439b5274c"},"task_stream":{"kind":"task","id":"01a0d33e-d57c-7cf1-928f-c6e4458a0a95"},"task_id":"01a0d33e-d57c-7cf1-928f-c6e4458a0a95","event":{"kind":"output","task_id":"01a0d33e-d57c-7cf1-928f-c6e4458a0a95","chunk":"Read text file `internal/cloneplanning/visible.go`.\n1|package cloneplanning\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"strings\"\n6|\t\"unicode/utf8\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|)\n12|\n13|// This file projects checkpoint visible text: typed text fields\n14|// are escaped per field and joined, and the projection authority\n15|// is one constant. Authority is decided by type, never by text:\n16|// ProjectVisibleText assigns Authority exactly once from\n17|// authorityUserContext with no condition on the text, kind,\n18|// ordinal, or event IDs, and the structural test pins that shape\n19|// with control plants. Escaped output round-trips through\n20|// encoding/json to exactly the input fields, so no instruction,\n21|// reply, control token, or authorization is added or interpreted.\n22|\n23|// authorityUserContext is the only visible-projection authority\n24|// Section 13.14.2 admits: VisibleMigrationProjection carries\n25|// exactly authority=user_context, never an assistant reply, system\n26|// instruction, or authorization.\n27|const authorityUserContext = \"user_context\"\n28|\n29|// maxEscapedText is the escaped_text character bound Section\n30|// 13.14.2 states: string[1..65536], measured in characters.\n31|const maxEscapedText = 65536\n32|\n33|// maxVisibleEventIDs bounds the target event IDs Section 13.14.2\n34|// states: sorted unique digest[1..64].\n35|const maxVisibleEventIDs = 64\n36|\n37|// VisibleInput is one checkpoint visible-projection candidate: the\n38|// carrying event kind, the event ordinal, the extracted typed text\n39|// fields, and the shown target event IDs. Per-kind text-field\n40|// extraction is caller scope; this entry takes the extracted texts.\n41|type VisibleInput struct {\n42|\tKind     string\n43|\tOrdinal  uint64\n44|\tTexts    []string\n45|\tEventIDs []string\n46|}\n47|\n48|// VisibleProjection is one projected checkpoint visible text: its\n49|// low authority, the event ordinal, the per-field escaped text,\n50|// and the shown target event IDs.\n51|type VisibleProjection struct {\n52|\tAuthority   string\n53|\tOrdinal     uint64\n54|\tEscapedText string\n55|\tEventIDs    []string\n56|}\n57|\n58|// EscapeVisibleText escapes one typed text field as a JSON string\n59|// literal. The output parses through encoding/json to exactly the\n60|// input; control characters, quotes, and markup delimiters never\n61|// cross raw.\n62|func EscapeVisibleText(field string) (string, error) {\n63|\tsealed, err := json.Marshal(field)\n64|\tif err != nil {\n65|\t\treturn \"\", invalid(\"visible text field does not escape: %v\", err)\n66|\t}\n67|\treturn string(sealed), nil\n68|}\n69|\n70|// ProjectVisibleText projects one checkpoint visible text. The\n71|// kind must be a Canonical Event kind, the ordinal a uint53, every\n72|// text field valid UTF-8, the joined escaped text within\n73|// string[1..65536] characters, and the event IDs sorted unique\n74|// digests[1..64]. The authority is always user_context.\n75|func ProjectVisibleText(input VisibleInput) (VisibleProjection, error) {\n76|\tif !clonebundle.ValidEventKind(input.Kind) {\n77|\t\treturn VisibleProjection{}, invalid(\"visible projection kind %q is not a Canonical Event kind\", input.Kind)\n78|\t}\n79|\tif _, err := scalar.NewUint53(input.Ordinal); err != nil {\n80|\t\treturn VisibleProjection{}, invalid(\"visible projection ordinal %d is not a uint53: %v\", input.Ordinal, err)\n81|\t}\n82|\tfor index, field := range input.Texts {\n83|\t\tif !utf8.ValidString(field) {\n84|\t\t\treturn VisibleProjection{}, invalid(\"visible projection text field[%d] is not valid UTF-8\", index)\n85|\t\t}\n86|\t}\n87|\tescaped := make([]string, 0, len(input.Texts))\n88|\tfor _, field := range input.Texts {\n89|\t\tquoted, err := EscapeVisibleText(field)\n90|\t\tif err != nil {\n91|\t\t\treturn VisibleProjection{}, err\n92|\t\t}\n93|\t\tescaped = append(escaped, quoted)\n94|\t}\n95|\tjoined := strings.Join(escaped, \"\\n\")\n96|\tif length := environ.StringLength(joined); length < 1 || length > maxEscapedText {\n97|\t\treturn VisibleProjection{}, invalid(\"visible projection escaped_text carries %d characters, the checkpoint requires string[1..65536]\", length)\n98|\t}\n99|\tids, err := checkVisibleEventIDs(input.EventIDs)\n100|\tif err != nil {\n101|\t\treturn VisibleProjection{}, err\n102|\t}\n103|\treturn VisibleProjection{\n104|\t\tAuthority:   authorityUserContext,\n105|\t\tOrdinal:     input.Ordinal,\n106|\t\tEscapedText: joined,\n107|\t\tEventIDs:    ids,\n108|\t}, nil\n109|}\n110|\n111|// checkVisibleEventIDs validates the shown target event IDs:\n112|// sorted unique digests[1..64]. Digest grammar delegates to the\n113|// scalar owner; order and count are this entry's composition.\n114|func checkVisibleEventIDs(ids []string) ([]string, error) {\n115|\tif len(ids) < 1 || len(ids) > maxVisibleEventIDs {\n116|\t\treturn nil, invalid(\"visible projection carries %d target event IDs, the checkpoint requires sorted unique digest[1..64]\", len(ids))\n117|\t}\n118|\tchecked := make([]string, 0, len(ids))\n119|\tfor index, id := range ids {\n120|\t\tdigest, err := scalar.ParseDigest(id)\n121|\t\tif err != nil {\n122|\t\t\treturn nil, invalid(\"visible projection target event ID[%d] is not a digest: %v\", index, err)\n123|\t\t}\n124|\t\tchecked = append(checked, digest.String())\n125|\t}\n126|\tfor index := 1; index < len(checked); index++ {\n127|\t\tif checked[index-1] >= checked[index] {\n128|\t\t\treturn nil, invalid(\"visible projection target event IDs are not sorted unique\")\n129|\t\t}\n130|\t}\n131|\treturn checked, nil\n132|}","final_result":true}}}
