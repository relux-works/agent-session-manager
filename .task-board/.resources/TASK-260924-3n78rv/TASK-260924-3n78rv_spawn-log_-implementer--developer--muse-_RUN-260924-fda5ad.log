{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c95f","stream":{"kind":"session","id":"01a0d33e-21a1-7dd1-8410-6ee446430389"},"sequence":778,"recorded_at":1780531400001551,"record_type":"event","durability":"durable","causation_id":"4e561a79-c0d9-4ce2-8e43-bf7439b5274c","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4e561a79-c0d9-4ce2-8e43-bf7439b5274c","run_stream":{"kind":"run","id":"4e561a79-c0d9-4ce2-8e43-bf7439b5274c"},"call_id":"call_01a0d3436d08777eb4df189eb3f63418","text":"Read text file `internal/cloneplanning/classification_allkinds_test.go`.\n(79 line(s) above)\n80|\treturn strings.Split(body[start+len(\"<code>\"):end], \"|\")\n81|}\n82|\n83|// assertSpecVocab pins the sweep domain: the production event-kind\n84|// and content-block vocabularies equal the closed lists at\n85|// SPEC.v0.7.0.md:10385 (kinds) and :10387 (blocks). The sweep\n86|// iterates the production getters, never a hand list.\n87|func assertSpecVocab(t *testing.T) {\n88|\tt.Helper()\n89|\twantKinds := specVocabLine(t, 10385)\n90|\tgotKinds := clonebundle.EventKinds()\n91|\tif len(gotKinds) != len(wantKinds) {\n92|\t\tt.Fatalf(\"EventKinds carries %d kinds, spec line 10385 carries %d\", len(gotKinds), len(wantKinds))\n93|\t}\n94|\tfor i := range wantKinds {\n95|\t\tif gotKinds[i] != wantKinds[i] {\n96|\t\t\tt.Fatalf(\"EventKinds[%d] = %q, spec line 10385 wants %q\", i, gotKinds[i], wantKinds[i])\n97|\t\t}\n98|\t}\n99|\twantBlocks := specVocabLine(t, 10387)\n100|\tgotBlocks := clonebundle.ContentBlockTypes()\n101|\tif len(gotBlocks) != len(wantBlocks) {\n102|\t\tt.Fatalf(\"ContentBlockTypes carries %d types, spec line 10387 carries %d\", len(gotBlocks), len(wantBlocks))\n103|\t}\n104|\tfor i := range wantBlocks {\n105|\t\tif gotBlocks[i] != wantBlocks[i] {\n106|\t\t\tt.Fatalf(\"ContentBlockTypes[%d] = %q, spec line 10387 wants %q\", i, gotBlocks[i], wantBlocks[i])\n107|\t\t}\n108|\t}\n109|}\n110|\n111|func TestClassifyItemVocabMatchesSpec(t *testing.T) {\n112|\tassertSpecVocab(t)\n113|}\n114|\n115|// sweepTexts returns the deduplicated fixed sweep corpus: every\n116|// member of every corpus class (benign control plus the four\n117|// adversarial classes) plus the reviewer's short probes.\n118|func sweepTexts() []string {\n119|\tseen := map[string]bool{}\n120|\tvar out []string\n121|\tfor _, class := range corpusClasses() {\n122|\t\tfor _, text := range class[1].([]string) {\n123|\t\t\tif !seen[text] {\n124|\t\t\t\tseen[text] = true\n125|\t\t\t\tout = append(out, text)\n126|\t\t\t}\n127|\t\t}\n128|\t}\n129|\tfor _, text := range reviewerShortProbes() {\n130|\t\tif !seen[text] {\n131|\t\t\tseen[text] = true\n132|\t\t\tout = append(out, text)\n133|\t\t}\n134|\t}\n135|\treturn out\n136|}\n137|\n138|// eventSweepItems returns the event half of the valid item domain:\n139|// every Canonical Event kind with its admitted fact variants. The\n140|// domain builder iterates the production vocabularies.\n141|func eventSweepItems() []Item {\n142|\tvar out []Item\n143|\tfor _, item := range allValidItems() {\n144|\t\tif item.Kind != \"\" {\n145|\t\t\tout = append(out, item)\n146|\t\t}\n147|\t}\n148|\treturn out\n149|}\n150|\n151|// isMessageKind reports whether the kind seals a message-like\n152|// payload (content_blocks plus extensions only). Payload shaping\n153|// only; the sweep domain stays derived.\n154|func isMessageKind(kind string) bool {\n155|\treturn kind == \"user_message\" || kind == \"assistant_message\"\n156|}\n157|\n158|// sweepPayload renders one sealed sweep payload: the item's closed\n159|// facts plus the adversarial text in every probe field, the\n160|// extensions probe, and one content block of the given type.\n161|// Message-like kinds carry content plus extensions only, per the\n162|// landed builder.\n163|func sweepPayload(item Item, blockType, quoted string) string {\n164|\textensions := `\"extensions\":{\"com.example.probe\":` + quoted + `}`\n165|\tblocks := `\"content_blocks\":[{\"type\":` + strconv.Quote(blockType) + `,\"content\":` + quoted + `}]`\n166|\tif isMessageKind(item.Kind) {\n167|\t\treturn `{` + blocks + `,` + extensions + `}`\n168|\t}\n169|\tmembers := []string{extensions}\n170|\tif item.Resolution != \"\" {\n171|\t\tmembers = append(members, `\"resolution\":`+strconv.Quote(item.Resolution))\n172|\t}\n173|\tif item.Protection != \"\" {\n174|\t\tmembers = append(members, `\"protection\":`+strconv.Quote(item.Protection))\n175|\t}\n176|\tfor _, field := range sweepProbeFields {\n177|\t\tmembers = append(members, strconv.Quote(field)+`:`+quoted)\n178|\t}\n179|\tmembers = append(members, blocks)\n180|\treturn `{` + strings.Join(members, `,`) + `}`\n181|}\n182|\n183|// checkDownstream plans one classified item under the native\n184|// writer and folds its target effects: the plan must admit and\n185|// the fold must stay zero (no tool call, no pending action, no\n186|// target accounting), so injected text never becomes an\n187|// authorization or an action downstream.\n188|func checkDownstream(t *testing.T, label string, item Item) {\n189|\tt.Helper()\n190|\tmapping, err := PlanItem(\"target_native_writer\", \"maximal_safe\", item)\n191|\tif err != nil {\n192|\t\tt.Fatalf(\"%s: PlanItem refused: %v\", label, err)\n193|\t}\n194|\teffects, err := PlanTargetEffects([]Mapping{mapping})\n195|\tif err != nil {\n196|\t\tt.Fatalf(\"%s: PlanTargetEffects refused: %v\", label, err)\n197|\t}\n198|\tif len(effects.CallableTools) != 0 || len(effects.PendingActions) != 0 || effects.TargetInputTokens != 0 || effects.TargetOutputTokens != 0 {\n199|\t\tt.Fatalf(\"%s: effects %+v, want zero\", label, effects)\n200|\t}\n201|}\n202|\n203|func TestClassifyItemIgnoresPayloadTextAllKinds(t *testing.T) {\n204|\tassertSpecVocab(t)\n205|\titems := eventSweepItems()\n206|\tblocks := clonebundle.ContentBlockTypes()\n207|\ttexts := sweepTexts()\n208|\tids := []string{orderedDigest(1)}\n209|\n210|\t// Sealed path: every item x every block type x every text\n211|\t// through BuildCanonicalEvent/DecodeCanonicalEvent and\n212|\t// ClassifyItem, then downstream. Visibility is uniform: the\n213|\t// classifier never reads it.\n214|\tsealed := 0\n215|\tfor _, want := range items {\n216|\t\tfor _, block := range blocks {\n217|\t\t\tfor _, text := range texts {\n218|\t\t\t\tquoted, err := EscapeVisibleText(text)\n219|\t\t\t\tif err != nil {\n220|\t\t\t\t\tt.Fatal(err)\n221|\t\t\t\t}\n222|\t\t\t\tevent := mustBuildEvent(t, want.Kind, \"internal\", sweepPayload(want, block, quoted), 0)\n223|\t\t\t\tgot, err := ClassifyItem(event)\n224|\t\t\t\tlabel := want.Kind + \"/\" + block + \"/\" + strconv.Quote(text)\n225|\t\t\t\tif err != nil {\n226|\t\t\t\t\tt.Fatalf(\"sealed %s refused: %v\", label, err)\n227|\t\t\t\t}\n228|\t\t\t\tif got != want {\n229|\t\t\t\t\tt.Fatalf(\"sealed %s = %+v, want %+v\", label, got, want)\n230|\t\t\t\t}\n231|\t\t\t\tcheckDownstream(t, \"sealed \"+label, got)\n232|\t\t\t\tsealed++\n233|\t\t\t}\n234|\t\t}\n235|\t}\n236|\n237|\t// Hand-built path (the reviewer-probe shape): every item x\n238|\t// every text with all probe fields set directly, no builder\n239|\t// between the text and the entry.\n240|\thand := 0\n241|\tfor _, want := range items {\n242|\t\tfor _, text := range texts {\n243|\t\t\tpayload := map[string]any{}\n244|\t\t\tif want.Resolution != \"\" {\n245|\t\t\t\tpayload[\"resolution\"] = want.Resolution\n246|\t\t\t}\n247|\t\t\tif want.Protection != \"\" {\n248|\t\t\t\tpayload[\"protection\"] = want.Protection\n249|\t\t\t}\n250|\t\t\tfor _, field := range sweepProbeFields {\n251|\t\t\t\tpayload[field] = text\n252|\t\t\t}\n253|\t\t\tgot, err := ClassifyItem(clonebundle.CanonicalEvent{Kind: want.Kind, Payload: payload})\n254|\t\t\tlabel := want.Kind + \"/\" + strconv.Quote(text)\n255|\t\t\tif err != nil {\n256|\t\t\t\tt.Fatalf(\"hand-built %s refused: %v\", label, err)\n257|\t\t\t}\n258|\t\t\tif got != want {\n259|\t\t\t\tt.Fatalf(\"hand-built %s = %+v, want %+v\", label, got, want)\n260|\t\t\t}\n261|\t\t\tcheckDownstream(t, \"hand-built \"+label, got)\n262|\t\t\thand++\n263|\t\t}\n264|\t}\n265|\n266|\t// Unbounded remainder, sealed: the fixed-seed generated\n267|\t// corpus plus the very-long probe over every item on the\n268|\t// derived first block type.\n269|\trepresentative := blocks[0]\n270|\tgenerated := 0\n271|\tfor _, text := range generatedCorpus(50) {\n272|\t\tfor _, want := range items {\n273|\t\t\tquoted, err := EscapeVisibleText(text)\n274|\t\t\tif err != nil {\n275|\t\t\t\tt.Fatal(err)\n276|\t\t\t}\n277|\t\t\tevent := mustBuildEvent(t, want.Kind, \"internal\", sweepPayload(want, representative, quoted), 0)\n278|\t\t\tgot, err := ClassifyItem(event)\n279|\t\t\tif err != nil {\n280|\t\t\t\tt.Fatalf(\"generated %s refused: %v\", want.Kind, err)\n281|\t\t\t}\n282|\t\t\tif got != want {\n283|\t\t\t\tt.Fatalf(\"generated %s = %+v, want %+v\", want.Kind, got, want)\n284|\t\t\t}\n285|\t\t\tgenerated++\n286|\t\t}\n287|\t}\n288|\tlongQuoted, err := EscapeVisibleText(reviewerLongProbe())\n289|\tif err != nil {\n290|\t\tt.Fatal(err)\n291|\t}\n292|\tfor _, want := range items {\n293|\t\tevent := mustBuildEvent(t, want.Kind, \"internal\", sweepPayload(want, representative, longQuoted), 0)\n294|\t\tgot, err := ClassifyItem(event)\n295|\t\tif err != nil {\n296|\t\t\tt.Fatalf(\"long %s refused: %v\", want.Kind, err)\n297|\t\t}\n298|\t\tif got != want {\n299|\t\t\tt.Fatalf(\"long %s = %+v, want %+v\", want.Kind, got, want)\n300|\t\t}\n301|\t\tgenerated++\n302|\t}\n303|\n304|\t// Every entry: the reviewer probes also ride the visible\n305|\t// projection at every kind, pinning authority through that\n306|\t// entry for the same texts.\n307|\tfor _, kind := range clonebundle.EventKinds() {\n308|\t\tfor _, text := range reviewerShortProbes() {\n309|\t\t\tgot, err := ProjectVisibleText(VisibleInput{Kind: kind, Texts: []string{text}, EventIDs: ids})\n310|\t\t\tif err != nil {\n311|\t\t\t\tt.Fatalf(\"visible %s refused: %v\", kind, err)\n312|\t\t\t}\n313|\t\t\tif got.Authority != \"user_context\" {\n314|\t\t\t\tt.Fatalf(\"visible %s: authority %q\", kind, got.Authority)\n315|\t\t\t}\n316|\t\t}\n317|\t}\n318|\tt.Logf(\"classify all-kinds: %d sealed, %d hand-built, %d generated/long\", sealed, hand, generated)\n319|}\n320|\n321|// classifyFactShape describes the payload-key literals reaching\n322|// the classifier: closedFact call keys plus any direct string\n323|// index into a payload.\n324|type classifyFactShape struct {\n325|\tclosedKeys map[string]int\n326|\tdirect     []string\n327|}\n328|\n329|// inspectClassifyFactShape parses the named file and collects, for\n330|// ClassifyItem only, the string keys passed to closedFact and any\n331|// direct string-literal index expression.\n332|func inspectClassifyFactShape(t *testing.T, path string) classifyFactShape {\n333|\tt.Helper()\n334|\tfset := token.NewFileSet()\n335|\tfile, err := parser.ParseFile(fset, path, nil, 0)\n336|\tif err != nil {\n337|\t\tt.Fatalf(\"parse %s: %v\", path, err)\n338|\t}\n339|\tshape := classifyFactShape{closedKeys: map[string]int{}}\n340|\tfor _, decl := range file.Decls {\n341|\t\tfn, ok := decl.(*ast.FuncDecl)\n342|\t\tif !ok || fn.Name.Name != \"ClassifyItem\" {\n343|\t\t\tcontinue\n344|\t\t}\n345|\t\tast.Inspect(fn.Body, func(node ast.Node) bool {\n346|\t\t\tcall, ok := node.(*ast.CallExpr)\n347|\t\t\tif ok {\n348|\t\t\t\tif ident, ok := call.Fun.(*ast.Ident); ok && ident.Name == \"closedFact\" && len(call.Args) >= 2 {\n349|\t\t\t\t\tif lit, ok := call.Args[1].(*ast.BasicLit); ok {\n350|\t\t\t\t\t\tvalue, err := strconv.Unquote(lit.Value)\n351|\t\t\t\t\t\tif err != nil {\n352|\t\t\t\t\t\t\tt.Fatalf(\"unquote %s: %v\", lit.Value, err)\n353|\t\t\t\t\t\t}\n354|\t\t\t\t\t\tshape.closedKeys[value]++\n355|\t\t\t\t\t}\n356|\t\t\t\t}\n357|\t\t\t\treturn true\n358|\t\t\t}\n359|\t\t\tindex, ok := node.(*ast.IndexExpr)\n360|\t\t\tif ok {\n361|\t\t\t\tif lit, ok := index.Index.(*ast.BasicLit); ok {\n362|\t\t\t\t\tvalue, err := strconv.Unquote(lit.Value)\n363|\t\t\t\t\tif err != nil {\n364|\t\t\t\t\t\tt.Fatalf(\"unquote %s: %v\", lit.Value, err)\n365|\t\t\t\t\t}\n366|\t\t\t\t\tshape.direct = append(shape.direct, value)\n367|\t\t\t\t}\n368|\t\t\t}\n369|\t\t\treturn true\n370|\t\t})\n371|\t}\n372|\treturn shape\n373|}\n374|\n375|func TestClassifyItemReadsClosedFactsOnly(t *testing.T) {\n376|\t// Structural pin: ClassifyItem reads exactly the two closed\n377|\t// fact keys through closedFact and never indexes a payload\n378|\t// with a string literal directly. A narrowing that tests\n379|\t// event.Payload[\"text\"] (or any other member) reddens here\n380|\t// as well as in the behavioral sweep; logs ride the evidence\n381|\t// tar.\n382|\tshape := inspectClassifyFactShape(t, \"item.go\")\n383|\tif len(shape.direct) != 0 {\n384|\t\tt.Fatalf(\"ClassifyItem carries direct string indexes %q, want none\", shape.direct)\n385|\t}\n386|\tif len(shape.closedKeys) != 2 || shape.closedKeys[\"resolution\"] != 1 || shape.closedKeys[\"protection\"] != 1 {\n387|\t\tt.Fatalf(\"ClassifyItem closedFact keys %v, want exactly resolution and protection once each\", shape.closedKeys)\n388|\t}\n389|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
