r := scalar.NewUint53(input.Ordinal); err != nil {\n80|\t\treturn VisibleProjection{}, invalid(\"visible projection ordinal %d is not a uint53: %v\", input.Ordinal, err)\n81|\t}\n82|\tfor index, field := range input.Texts {\n83|\t\tif !utf8.ValidString(field) {\n84|\t\t\treturn VisibleProjection{}, invalid(\"visible projection text field[%d] is not valid UTF-8\", index)\n85|\t\t}\n86|\t}\n87|\tescaped := make([]string, 0, len(input.Texts))\n88|\tfor _, field := range input.Texts {\n89|\t\tquoted, err := EscapeVisibleText(field)\n90|\t\tif err != nil {\n91|\t\t\treturn VisibleProjection{}, err\n92|\t\t}\n93|\t\tescaped = append(escaped, quoted)\n94|\t}\n95|\tjoined := strings.Join(escaped, \"\\n\")\n96|\tif length := environ.StringLength(joined); length < 1 || length > maxEscapedText {\n97|\t\treturn VisibleProjection{}, invalid(\"visible projection escaped_text carries %d characters, the checkpoint requires string[1..65536]\", length)\n98|\t}\n99|\tids, err := checkVisibleEventIDs(input.EventIDs)\n100|\tif err != nil {\n101|\t\treturn VisibleProjection{}, err\n102|\t}\n103|\treturn VisibleProjection{\n104|\t\tAuthority:   authorityUserContext,\n105|\t\tOrdinal:     input.Ordinal,\n106|\t\tEscapedText: joined,\n107|\t\tEventIDs:    ids,\n108|\t}, nil\n109|}\n110|\n111|// checkVisibleEventIDs validates the shown target event IDs:\n112|// sorted unique digests[1..64]. Digest grammar delegates to the\n113|// scalar owner; order and count are this entry's composition.\n114|func checkVisibleEventIDs(ids []string) ([]string, error) {\n115|\tif len(ids) < 1 || len(ids) > maxVisibleEventIDs {\n116|\t\treturn nil, invalid(\"visible projection carries %d target event IDs, the checkpoint requires sorted unique digest[1..64]\", len(ids))\n117|\t}\n118|\tchecked := make([]string, 0, len(ids))\n119|\tfor index, id := range ids {\n120|\t\tdigest, err := scalar.ParseDigest(id)\n121|\t\tif err != nil {\n122|\t\t\treturn nil, invalid(\"visible projection target event ID[%d] is not a d