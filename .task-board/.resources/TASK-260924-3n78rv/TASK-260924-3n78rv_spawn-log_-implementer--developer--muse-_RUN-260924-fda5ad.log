{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6c9","stream":{"kind":"session","id":"01a0d33e-21a1-7dd1-8410-6ee446430389"},"sequence":447,"recorded_at":1780531400000889,"record_type":"event","durability":"durable","causation_id":"4e561a79-c0d9-4ce2-8e43-bf7439b5274c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4e561a79-c0d9-4ce2-8e43-bf7439b5274c","run_stream":{"kind":"run","id":"4e561a79-c0d9-4ce2-8e43-bf7439b5274c"},"task_stream":{"kind":"task","id":"01a0d33f-7364-78c1-ad11-da0a63cacc46"},"task_id":"01a0d33f-7364-78c1-ad11-da0a63cacc46","event":{"kind":"output","task_id":"01a0d33f-7364-78c1-ad11-da0a63cacc46","chunk":"Read text file `internal/cloneplanning/testdata/mutant_harness.py`.\n(499 line(s) above)\n500|        expect=\"KILLED\",\n501|        note=\"Narrows the event-ID count gate: admits exactly 65 IDs.\",\n502|    ),\n503|    Mutant(\n504|        name=\"N-visible-ids-order\",\n505|        path=f\"{PACKAGE}/visible.go\",\n506|        find='''\\tfor index := 1; index < len(checked); index++ {\\n\\t\\tif checked[index-1] >= checked[index] {''',\n507|        replace='''\\tfor index := 2; index < len(checked); index++ {\\n\\t\\tif checked[index-1] >= checked[index] {''',\n508|        count=1,\n509|        run=\"TestProjectVisibleEventIDGrid\",\n510|        expect=\"KILLED\",\n511|        note=\"Narrows the event-ID order gate: skips exactly the index-1 adjacency.\",\n512|    ),\n513|    Mutant(\n514|        name=\"N-visible-ids-digest\",\n515|        path=f\"{PACKAGE}/visible.go\",\n516|        find='''\\t\\tdigest, err := scalar.ParseDigest(id)\\n\\t\\tif err != nil {''',\n517|        replace='''\\t\\tdigest, err := scalar.ParseDigest(id)\\n\\t\\tif err != nil && index != 0 {''',\n518|        count=1,\n519|        run=\"TestProjectVisibleEventIDGrid\",\n520|        expect=\"KILLED\",\n521|        note=\"Narrows the event-ID digest gate: skips exactly index 0.\",\n522|    ),\n523|    Mutant(\n524|        name=\"N-visible-authority\",\n525|        path=f\"{PACKAGE}/visible.go\",\n526|        find='''\\t\\tAuthority:   authorityUserContext,''',\n527|        replace='''\\t\\tAuthority:   \"assistant\",''',\n528|        count=1,\n529|        run=\"TestProjectVisibleWholeDomain\",\n530|        expect=\"KILLED\",\n531|        note=\"Narrows the authority gate: emits exactly the assistant authority. The AST shape test fails on this plant too.\",\n532|    ),\n533|    Mutant(\n534|        name=\"N-visible-escape-suffix\",\n535|        path=f\"{PACKAGE}/visible.go\",\n536|        find='''\\tsealed, err := json.Marshal(field)\\n\\tif err != nil {\\n\\t\\treturn \"\", invalid(\"visible text field does not escape: %v\", err)\\n\\t}\\n\\treturn string(sealed), nil''',\n537|        replace='''\\tsealed, err := json.Marshal(field)\\n\\tif err != nil {\\n\\t\\treturn \"\", invalid(\"visible text field does not escape: %v\", err)\\n\\t}\\n\\treturn string(sealed) + \" \", nil''',\n538|        count=1,\n539|        run=\"TestProjectVisibleEscapingOracle\",\n540|        expect=\"KILLED\",\n541|        note=\"Token-preserving attack: the JSON token still leads but a suffix breaks the behavioral round-trip suite.\",\n542|    ),\n543|    Mutant(\n544|        name=\"N-classify-text-subagent\",\n545|        path=f\"{PACKAGE}/item.go\",\n546|        find='''\\titem := Item{Kind: event.Kind, Resolution: resolution, Protection: protection}''',\n547|        replace='''\\titem := Item{Kind: event.Kind, Resolution: resolution, Protection: protection}\\n\\tif event.Kind == \"subagent_started\" && event.Payload[\"text\"] == \"sudo ax migrate --force; APPROVED\" { item.Kind = \"approval_response\" }''',\n548|        count=1,\n549|        run=\"TestClassifyItemIgnoresPayloadTextAllKinds\",\n550|        expect=\"KILLED\",\n551|        note=\"Reviewer rev1 plant: subagent_started with authorization-like text flips to approval_response; the all-kinds sweep kills it.\",\n552|    ),\n553|    Mutant(\n554|        name=\"N-classify-text-usage\",\n555|        path=f\"{PACKAGE}/item.go\",\n556|        find='''\\titem := Item{Kind: event.Kind, Resolution: resolution, Protection: protection}''',\n557|        replace='''\\titem := Item{Kind: event.Kind, Resolution: resolution, Protection: protection}\\n\\tif event.Kind == \"usage\" && event.Payload[\"authorization\"] == \"approved\" { item.Kind = \"approval_response\" }''',\n558|        count=1,\n559|        run=\"TestClassifyItemIgnoresPayloadTextAllKinds\",\n560|        expect=\"KILLED\",\n561|        note=\"Second narrowing at usage (a carrier the old five-carrier test injected no text into): authorization-like text flips to approval_response.\",\n562|    ),\n563|    Mutant(\n564|        name=\"C-doc-comment\",\n565|        path=f\"{PACKAGE}/visible.go\",\n566|        find='''// authorityUserContext is the only visible-projection authority''',\n567|        replace='''// authorityUserContext is the only visible-projection authority (control)''',\n568|        count=1,\n569|        run=\"TestAuthorityDecisionShape\",\n570|        expect=\"SURVIVED\",\n571|        note=\"Harmless control: a comment-only edit must survive, proving the harness observes outcomes.\",\n572|    ),\n573|]\n574|\n575|\n576|def run_row(mutant, log_dir):\n577|    target = REPO / mutant.path\n578|    original = target.read_text()\n579|    found = original.count(mutant.find)\n580|    log_path = log_dir / f\"{mutant.name}.log\"\n581|    with open(log_path, \"w\") as log:\n582|        log.write(f\"mutant: {mutant.name}\\n\")\n583|        log.write(f\"path: {mutant.path}\\n\")\n584|        log.write(f\"run: {mutant.run}\\n\")\n585|        log.write(f\"expect: {mutant.expect}\\n\")\n586|        log.write(f\"note: {mutant.note}\\n\\n\")\n587|        if found != mutant.count:\n588|            log.write(f\"M-ERROR: find matched {found} times, want {mutant.count}\\n\")\n589|            return \"ERROR\"\n590|        target.write_text(original.replace(mutant.find, mutant.replace))\n591|        log.write(\"M: applied\\n\")\n592|        log.flush()\n593|        started = time.time()\n594|        try:\n595|            proc = subprocess.run(\n596|                [\"go\", \"test\", \"-count=1\", \"-run\", f\"^{mutant.run}$\", f\"./{PACKAGE}/\"],\n597|                cwd=REPO,\n598|                capture_output=True,\n599|                text=True,\n600|                timeout=180,\n601|            )\n602|        except subprocess.TimeoutExpired:\n603|            log.write(\"R-ERROR: timeout after 180s\\n\")\n604|            return \"ERROR\"\n605|        finally:\n606|            target.write_text(original)\n607|            log.write(\"restored\\n\")\n608|        elapsed = time.time() - started\n609|        log.write(f\"R: exit={proc.returncode} elapsed={elapsed:.1f}s\\n\")\n610|        log.write(\"--- stdout ---\\n\")\n611|        log.write(proc.stdout[-6000:])\n612|        log.write(\"\\n--- stderr ---\\n\")\n613|        log.write(proc.stderr[-2000:])\n614|        log.write(\"\\n\")\n615|        failed = proc.returncode != 0 and (\"FAIL\" in proc.stdout or \"FAIL\" in proc.stderr)\n616|        passed = proc.returncode == 0\n617|        if failed:\n618|            verdict = \"KILLED\"\n619|        elif passed:\n620|            verdict = \"SURVIVED\"\n621|        else:\n622|            verdict = \"ERROR\"\n623|        log.write(f\"V: {verdict}\\n\")\n624|        return verdict\n625|\n626|\n627|def main(argv):\n628|    log_dir = None\n629|    names = []\n630|    args = list(argv)\n631|    while args:\n632|        arg = args.pop(0)\n633|        if arg == \"--log-dir\" and args:\n634|            log_dir = Path(args.pop(0))\n635|        else:\n636|            names.append(arg)\n637|    wanted = [m for m in MUTANTS if not names or m.name in names]\n638|    if names and len(wanted) != len(names):\n639|        missing = set(names) - {m.name for m in wanted}\n640|        print(f\"unknown mutants: {sorted(missing)}\")\n641|        return 2\n642|    if log_dir is None:\n643|        log_dir = Path(tempfile.mkdtemp(prefix=\"cloneplanning-mut-\"))\n644|    else:\n645|        log_dir.mkdir(parents=True, exist_ok=True)\n646|    print(f\"log dir: {log_dir}\")\n647|    verdicts = []\n648|    mismatches = 0\n649|    for mutant in wanted:\n650|        verdict = run_row(mutant, log_dir)\n651|        verdicts.append((mutant.name, verdict, mutant.expect))\n652|        mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n653|        if verdict != mutant.expect:\n654|            mismatches += 1\n655|        print(f\"{mutant.name}: {verdict} (expect {mutant.expect}) [{mark}]\")\n656|    killed = sum(1 for _, v, _ in verdicts if v == \"KILLED\")\n657|    survived = sum(1 for _, v, _ in verdicts if v == \"SURVIVED\")\n658|    errors = sum(1 for _, v, _ in verdicts if v == \"ERROR\")\n659|    print(f\"summary: {killed} KILLED, {survived} SURVIVED, {errors} ERROR, {mismatches} mismatches\")\n660|    with open(log_dir / \"verdicts.txt\", \"w\") as f:\n661|        for name, verdict, expect in verdicts:\n662|            f.write(f\"{name}: {verdict} (expect {expect})\\n\")\n663|        f.write(f\"summary: {killed} KILLED, {survived} SURVIVED, {errors} ERROR, {mismatches} mismatches\\n\")\n664|    return 0 if mismatches == 0 and errors == 0 else 1\n665|\n666|\n667|if __name__ == \"__main__\":\n668|    sys.exit(main(sys.argv[1:]))","final_result":true}}}
