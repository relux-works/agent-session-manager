{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5d9","stream":{"kind":"session","id":"01a0d33e-21a1-7dd1-8410-6ee446430389"},"sequence":327,"recorded_at":1780531400000649,"record_type":"event","durability":"durable","causation_id":"4e561a79-c0d9-4ce2-8e43-bf7439b5274c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4e561a79-c0d9-4ce2-8e43-bf7439b5274c","run_stream":{"kind":"run","id":"4e561a79-c0d9-4ce2-8e43-bf7439b5274c"},"task_stream":{"kind":"task","id":"01a0d33e-d59b-7343-a74b-d293c75480ee"},"task_id":"01a0d33e-d59b-7343-a74b-d293c75480ee","event":{"kind":"output","task_id":"01a0d33e-d59b-7343-a74b-d293c75480ee","chunk":"Read text file `internal/cloneplanning/errors.go`.\n1|package cloneplanning\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|)\n7|\n8|// ErrInvalid is the refusal for every malformed planning input:\n9|// unknown strategies, profiles, item classes, or fact values,\n10|// archive-branch target planning, strict-exact non-exact items,\n11|// and malformed visible-projection inputs. Callers match with\n12|// errors.Is; the message names the offending member.\n13|var ErrInvalid = errors.New(\"cloneplanning: invalid projection planning input\")\n14|\n15|func invalid(format string, arguments ...any) error {\n16|\treturn fmt.Errorf(\"%w: %s\", ErrInvalid, fmt.Sprintf(format, arguments...))\n17|}","final_result":true}}}
