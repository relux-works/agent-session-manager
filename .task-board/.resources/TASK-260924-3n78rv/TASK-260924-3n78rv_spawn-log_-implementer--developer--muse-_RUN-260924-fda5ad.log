{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c743","stream":{"kind":"session","id":"01a0d33e-21a1-7dd1-8410-6ee446430389"},"sequence":508,"recorded_at":1780531400001011,"record_type":"event","durability":"durable","causation_id":"4e561a79-c0d9-4ce2-8e43-bf7439b5274c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4e561a79-c0d9-4ce2-8e43-bf7439b5274c","run_stream":{"kind":"run","id":"4e561a79-c0d9-4ce2-8e43-bf7439b5274c"},"task_stream":{"kind":"task","id":"01a0d341-35d5-7490-a5cd-d371a62859bc"},"task_id":"01a0d341-35d5-7490-a5cd-d371a62859bc","event":{"kind":"output","task_id":"01a0d341-35d5-7490-a5cd-d371a62859bc","chunk":"Read text file `internal/cloneplanning/classification_test.go`.\n1|package cloneplanning\n2|\n3|import (\n4|\t\"os\"\n5|\t\"path/filepath\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n10|)\n11|\n12|// This file drives ClassifyItem through the production entry over\n13|// real canonical events sealed by the landed\n14|// clonebundle.BuildCanonicalEvent entry. Classification is by\n15|// closed vocabularies only: the sweep proves adversarial payload\n16|// text cannot change the item, and refusals prove unknown fact\n17|// values never interpret.\n18|\n19|// classifyPayload renders one non-message payload carrying the\n20|// given extra facts.\n21|func classifyPayload(facts string) string {\n22|\tif facts == \"\" {\n23|\t\treturn `{\"extensions\":{}}`\n24|\t}\n25|\treturn `{\"extensions\":{},` + facts + `}`\n26|}\n27|\n28|func TestClassifyItemValidGrid(t *testing.T) {\n29|\tcases := []struct {\n30|\t\tkind       string\n31|\t\tpayload    string\n32|\t\tvisibility string\n33|\t\twant       Item\n34|\t}{\n35|\t\t{\"tool_call\", classifyPayload(`\"call_id\":\"c1\",\"tool_name\":\"t\",\"resolution\":\"completed\"`), \"internal\", Item{Kind: \"tool_call\", Resolution: \"completed\"}},\n36|\t\t{\"tool_call\", classifyPayload(`\"call_id\":\"c1\",\"tool_name\":\"t\",\"resolution\":\"aborted\"`), \"internal\", Item{Kind: \"tool_call\", Resolution: \"aborted\"}},\n37|\t\t{\"tool_result\", classifyPayload(`\"call_id\":\"c1\",\"status\":\"ok\",\"resolution\":\"completed\"`), \"internal\", Item{Kind: \"tool_result\", Resolution: \"completed\"}},\n38|\t\t{\"tool_result\", classifyPayload(`\"call_id\":\"c1\",\"status\":\"error\",\"resolution\":\"aborted\"`), \"internal\", Item{Kind: \"tool_result\", Resolution: \"aborted\"}},\n39|\t\t{\"opaque_reasoning\", classifyPayload(`\"protection\":\"encrypted\",\"byte_count\":9`), \"opaque\", Item{Kind: \"opaque_reasoning\", Protection: \"encrypted\"}},\n40|\t\t{\"opaque_reasoning\", classifyPayload(`\"protection\":\"signed\",\"byte_count\":9`), \"opaque\", Item{Kind: \"opaque_reasoning\", Protection: \"signed\"}},\n41|\t\t{\"opaque_event\", classifyPayload(`\"native_type\":\"x.y\",\"byte_count\":9`), \"opaque\", Item{Kind: \"opaque_event\"}},\n42|\t\t{\"opaque_event\", classifyPayload(`\"native_type\":\"x.y\",\"protection\":\"encrypted\",\"byte_count\":9`), \"opaque\", Item{Kind: \"opaque_event\", Protection: \"encrypted\"}},\n43|\t\t{\"opaque_event\", classifyPayload(`\"native_type\":\"x.y\",\"protection\":\"signed\",\"byte_count\":9`), \"opaque\", Item{Kind: \"opaque_event\", Protection: \"signed\"}},\n44|\t\t{\"user_message\", messagePayload(\"hello\"), \"public\", Item{Kind: \"user_message\"}},\n45|\t\t{\"assistant_message\", messagePayload(\"done\"), \"public\", Item{Kind: \"assistant_message\"}},\n46|\t\t{\"instruction_snapshot\", classifyPayload(`\"authority\":\"high\",\"directives\":[\"a\"]`), \"internal\", Item{Kind: \"instruction_snapshot\"}},\n47|\t\t{\"usage\", classifyPayload(`\"input_tokens\":5,\"output_tokens\":7`), \"internal\", Item{Kind: \"usage\"}},\n48|\t}\n49|\tcovered := map[string]bool{}\n50|\tfor _, tc := range cases {\n51|\t\tcovered[tc.kind] = true\n52|\t\tevent := mustBuildEvent(t, tc.kind, tc.visibility, tc.payload, 0)\n53|\t\tgot, err := ClassifyItem(event)\n54|\t\tif err != nil {\n55|\t\t\tt.Fatalf(\"ClassifyItem(%s) refused: %v\", tc.kind, err)\n56|\t\t}\n57|\t\tif got != tc.want {\n58|\t\t\tt.Fatalf(\"ClassifyItem(%s) = %+v, want %+v\", tc.kind, got, tc.want)\n59|\t\t}\n60|\t}\n61|\t// Every remaining kind classifies from a minimal payload.\n62|\tfor _, kind := range clonebundle.EventKinds() {\n63|\t\tif covered[kind] {\n64|\t\t\tcontinue\n65|\t\t}\n66|\t\tevent := mustBuildEvent(t, kind, \"internal\", classifyPayload(\"\"), 0)\n67|\t\tgot, err := ClassifyItem(event)\n68|\t\tif err != nil {\n69|\t\t\tt.Fatalf(\"ClassifyItem(%s) refused: %v\", kind, err)\n70|\t\t}\n71|\t\tif got != (Item{Kind: kind}) {\n72|\t\t\tt.Fatalf(\"ClassifyItem(%s) = %+v, want kind-only\", kind, got)\n73|\t\t}\n74|\t}\n75|}\n76|\n77|func TestClassifyItemRefusals(t *testing.T) {\n78|\t// Unknown kinds refuse. The builder would refuse these too,\n79|\t// so they ride hand-built structs.\n80|\tfor _, kind := range []string{\"\", \"bogus_kind\", \"USER_MESSAGE\", \"tool_call\\xff\"} {\n81|\t\tif _, err := ClassifyItem(clonebundle.CanonicalEvent{Kind: kind}); err == nil {\n82|\t\t\tt.Fatalf(\"ClassifyItem kind %q admitted\", kind)\n83|\t\t}\n84|\t}\n85|\t// Unknown or mistyped fact values refuse, never interpret.\n86|\t// Probes \"bogus_resolution\", \"bogus_protection\", and the\n87|\t// float64 fact are the narrowing probes\n88|\t// (N-resolution-vocab, N-protection-vocab, N-classify-fact-type).\n89|\tbadPayloads := []struct {\n90|\t\tname    string\n91|\t\tkind    string\n92|\t\tpayload string\n93|\t}{\n94|\t\t{\"bad-resolution\", \"tool_call\", classifyPayload(`\"call_id\":\"c\",\"tool_name\":\"t\",\"resolution\":\"bogus_resolution\"`)},\n95|\t\t{\"bad-protection\", \"opaque_reasoning\", classifyPayload(`\"protection\":\"bogus_protection\"`)},\n96|\t\t{\"numeric-resolution\", \"tool_call\", classifyPayload(`\"call_id\":\"c\",\"tool_name\":\"t\",\"resolution\":1`)},\n97|\t\t{\"numeric-resolution-plain\", \"usage\", classifyPayload(`\"input_tokens\":1,\"resolution\":1`)},\n98|\t\t{\"bool-protection\", \"opaque_reasoning\", classifyPayload(`\"protection\":true`)},\n99|\t\t{\"object-resolution\", \"tool_call\", classifyPayload(`\"call_id\":\"c\",\"tool_name\":\"t\",\"resolution\":{}`)},\n100|\t\t{\"missing-resolution\", \"tool_call\", classifyPayload(`\"call_id\":\"c\",\"tool_name\":\"t\"`)},\n101|\t\t{\"missing-protection\", \"opaque_reasoning\", classifyPayload(`\"byte_count\":1`)},\n102|\t\t{\"resolution-on-plain\", \"usage\", classifyPayload(`\"input_tokens\":1,\"resolution\":\"completed\"`)},\n103|\t\t{\"protection-on-plain\", \"usage\", classifyPayload(`\"input_tokens\":1,\"protection\":\"encrypted\"`)},\n104|\t\t{\"null-resolution-tool\", \"tool_call\", classifyPayload(`\"call_id\":\"c\",\"tool_name\":\"t\",\"resolution\":null`)},\n105|\t}\n106|\tfor _, tc := range badPayloads {\n107|\t\tevent := mustBuildEvent(t, tc.kind, \"internal\", tc.payload, 0)\n108|\t\tif _, err := ClassifyItem(event); err == nil {\n109|\t\t\tt.Fatalf(\"ClassifyItem %s admitted\", tc.name)\n110|\t\t}\n111|\t}\n112|\t// Present-but-null on a kind that forbids the fact maps to\n113|\t// absent (the cloneproject null precedent) and admits.\n114|\tevent := mustBuildEvent(t, \"usage\", \"internal\", classifyPayload(`\"input_tokens\":1,\"resolution\":null,\"protection\":null`), 0)\n115|\tgot, err := ClassifyItem(event)\n116|\tif err != nil {\n117|\t\tt.Fatalf(\"ClassifyItem null facts refused: %v\", err)\n118|\t}\n119|\tif got != (Item{Kind: \"usage\"}) {\n120|\t\tt.Fatalf(\"ClassifyItem null facts = %+v, want kind-only\", got)\n121|\t}\n122|\t// Every adversarial text class as a fact value refuses: text\n123|\t// never decides classification.\n124|\tfor _, class := range corpusClasses() {\n125|\t\tfor _, text := range class[1].([]string) {\n126|\t\t\tquoted, err := EscapeVisibleText(text)\n127|\t\t\tif err != nil {\n128|\t\t\t\tt.Fatal(err)\n129|\t\t\t}\n130|\t\t\tevent := mustBuildEvent(t, \"tool_call\", \"internal\", classifyPayload(`\"call_id\":\"c\",\"tool_name\":\"t\",\"resolution\":`+quoted), 0)\n131|\t\t\tif _, err := ClassifyItem(event); err == nil {\n132|\t\t\t\tt.Fatalf(\"ClassifyItem %s resolution %q admitted\", class[0], text)\n133|\t\t\t}\n134|\t\t}\n135|\t}\n136|}\n137|\n138|func TestClassifyItemIgnoresPayloadText(t *testing.T) {\n139|\t// The same kind and closed facts with benign versus\n140|\t// adversarial other-facts classify to identical items: text\n141|\t// content never flows into the item (the item has no text\n142|\t// field by type). Sweep representative carriers over every\n143|\t// corpus class, every member, plus the generated corpus.\n144|\tcarriers := []struct {\n145|\t\tkind       string\n146|\t\tpayload    func(text, quoted string) string\n147|\t\tvisibility string\n148|\t\twant       Item\n149|\t}{\n150|\t\t{\"tool_call\", func(text, quoted string) string {\n151|\t\t\treturn classifyPayload(`\"call_id\":\"c\",\"tool_name\":` + quoted + `,\"resolution\":\"completed\"`)\n152|\t\t}, \"internal\", Item{Kind: \"tool_call\", Resolution: \"completed\"}},\n153|\t\t{\"user_message\", func(text, quoted string) string {\n154|\t\t\t_ = text\n155|\t\t\treturn messagePayload(text)\n156|\t\t}, \"public\", Item{Kind: \"user_message\"}},\n157|\t\t{\"instruction_snapshot\", func(text, quoted string) string {\n158|\t\t\treturn classifyPayload(`\"authority\":\"high\",\"directives\":[` + quoted + `]`)\n159|\t\t}, \"internal\", Item{Kind: \"instruction_snapshot\"}},\n160|\t\t{\"usage\", func(text, quoted string) string {\n161|\t\t\t_ = quoted\n162|\t\t\treturn classifyPayload(`\"input_tokens\":5,\"output_tokens\":7`)\n163|\t\t}, \"internal\", Item{Kind: \"usage\"}},\n164|\t\t{\"opaque_reasoning\", func(text, quoted string) string {\n165|\t\t\t_ = quoted\n166|\t\t\treturn classifyPayload(`\"protection\":\"encrypted\",\"byte_count\":9`)\n167|\t\t}, \"opaque\", Item{Kind: \"opaque_reasoning\", Protection: \"encrypted\"}},\n168|\t}\n169|\ttexts := []string{}\n170|\tfor _, class := range corpusClasses() {\n171|\t\ttexts = append(texts, class[1].([]string)...)\n172|\t}\n173|\ttexts = append(texts, generatedCorpus(50)...)\n174|\tfor _, carrier := range carriers {\n175|\t\tfor _, text := range texts {\n176|\t\t\tquoted, err := EscapeVisibleText(text)\n177|\t\t\tif err != nil {\n178|\t\t\t\tt.Fatal(err)\n179|\t\t\t}\n180|\t\t\tevent := mustBuildEvent(t, carrier.kind, carrier.visibility, carrier.payload(text, quoted), 0)\n181|\t\t\tgot, err := ClassifyItem(event)\n182|\t\t\tif err != nil {\n183|\t\t\t\tt.Fatalf(\"ClassifyItem(%s) with payload text %q refused: %v\", carrier.kind, text, err)\n184|\t\t\t}\n185|\t\t\tif got != carrier.want {\n186|\t\t\t\tt.Fatalf(\"ClassifyItem(%s) with payload text %q = %+v, want %+v\", carrier.kind, text, got, carrier.want)\n187|\t\t\t}\n188|\t\t}\n189|\t}\n190|}\n191|\n192|func TestClassifyItemFactNamePin(t *testing.T) {\n193|\t// Composition pin: the payload fact names and protection\n194|\t// spellings ClassifyItem reads follow cloneproject's landed\n195|\t// registry. A rename there breaks this test loudly instead\n196|\t// of silently decoupling the bridge. The completed/aborted\n197|\t// spellings reference cloneproject's exported statuses, so a\n198|\t// rename there breaks the build.\n199|\tdispatch, err := os.ReadFile(filepath.Join(\"..\", \"cloneproject\", \"dispatch.go\"))\n200|\tif err != nil {\n201|\t\tt.Fatal(err)\n202|\t}\n203|\tfor _, key := range []string{`\"resolution\"`, `\"protection\"`} {\n204|\t\tif !strings.Contains(string(dispatch), key) {\n205|\t\t\tt.Fatalf(\"cloneproject/dispatch.go no longer carries fact name %s\", key)\n206|\t\t}\n207|\t}\n208|\tnative, err := os.ReadFile(filepath.Join(\"..\", \"cloneproject\", \"native.go\"))\n209|\tif err != nil {\n210|\t\tt.Fatal(err)\n211|\t}\n212|\tif !strings.Contains(string(native), `!= \"encrypted\"`) || !strings.Contains(string(native), `!= \"signed\"`) {\n213|\t\tt.Fatalf(\"cloneproject/native.go no longer pins the encrypted|signed protection vocabulary\")\n214|\t}\n215|}\n216|\n217|// TestSharedItemVocabBothEntries drives the shared checkItem\n218|// vocabulary gates through both production entries (PlanItem and\n219|// ClassifyItem): one implementation, both call sites, one killer\n220|// per narrowing row.\n221|func TestSharedItemVocabBothEntries(t *testing.T) {\n222|\t// Kind vocabulary through both entries.\n223|\tif _, err := PlanItem(\"target_native_writer\", \"maximal_safe\", Item{Kind: \"bogus_kind\"}); err == nil {\n224|\t\tt.Fatalf(\"PlanItem bogus_kind admitted\")\n225|\t}\n226|\tif _, err := ClassifyItem(clonebundle.CanonicalEvent{Kind: \"bogus_kind\"}); err == nil {\n227|\t\tt.Fatalf(\"ClassifyItem bogus_kind admitted\")\n228|\t}\n229|\t// Block vocabulary through PlanItem (blocks have no event\n230|\t// bridge: per-block items are built by the caller).\n231|\tif _, err := PlanItem(\"target_native_writer\", \"maximal_safe\", Item{Block: \"bogus_block\"}); err == nil {\n232|\t\tt.Fatalf(\"PlanItem bogus_block admitted\")\n233|\t}\n234|\t// Resolution vocabulary through both entries.\n235|\tif _, err := PlanItem(\"target_native_writer\", \"maximal_safe\", Item{Kind: \"tool_call\", Resolution: \"bogus_resolution\"}); err == nil {\n236|\t\tt.Fatalf(\"PlanItem bogus_resolution admitted\")\n237|\t}\n238|\tevent := mustBuildEvent(t, \"tool_call\", \"internal\", classifyPayload(`\"call_id\":\"c\",\"tool_name\":\"t\",\"resolution\":\"bogus_resolution\"`), 0)\n239|\tif _, err := ClassifyItem(event); err == nil {\n240|\t\tt.Fatalf(\"ClassifyItem bogus_resolution admitted\")\n241|\t}\n242|\t// Protection vocabulary through both entries.\n243|\tif _, err := PlanItem(\"target_native_writer\", \"maximal_safe\", Item{Kind: \"opaque_reasoning\", Protection: \"bogus_protection\"}); err == nil {\n244|\t\tt.Fatalf(\"PlanItem bogus_protection admitted\")\n245|\t}\n246|\tevent = mustBuildEvent(t, \"opaque_reasoning\", \"opaque\", classifyPayload(`\"protection\":\"bogus_protection\"`), 0)\n247|\tif _, err := ClassifyItem(event); err == nil {\n248|\t\tt.Fatalf(\"ClassifyItem bogus_protection admitted\")\n249|\t}\n250|}","final_result":true}}}
