{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c69b","stream":{"kind":"session","id":"01a0d2c4-4f2b-7620-b603-17ce30f31e40"},"sequence":424,"recorded_at":1780531400000843,"record_type":"event","durability":"durable","causation_id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23","run_stream":{"kind":"run","id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23"},"task_stream":{"kind":"task","id":"01a0d2c5-2be8-70f2-bbe2-ef8a708093fa"},"task_id":"01a0d2c5-2be8-70f2-bbe2-ef8a708093fa","event":{"kind":"output","task_id":"01a0d2c5-2be8-70f2-bbe2-ef8a708093fa","chunk":"Read text file `internal/cloneplanning/plan.go`.\n1|package cloneplanning\n2|\n3|import (\n4|\t\"sort\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/clonefidelity\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/cloneproject\"\n8|)\n9|\n10|// This file plans per-item expected dispositions with reason sets\n11|// and folds planned sessions to predicted counts. The strategy arm\n12|// decides the base mapping, the profile overlay refines it, and\n13|// reasons compose as sorted sets. The planner never emits\n14|// synthesized (synthesized rows have no source object) or\n15|// unrecoverable (planned canonical items exist), and never plans\n16|// the archive branch. Disposition and reason spellings quote the\n17|// internal/clonefidelity owner; the agreement test pins the quote.\n18|\n19|// Mapping is one planned item: its expected disposition and sorted\n20|// reason set. Exact mappings carry no reason.\n21|type Mapping struct {\n22|\tDisposition string\n23|\tReasons     []string\n24|}\n25|\n26|// Disposition spellings, quoted from the internal/clonefidelity\n27|// owner.\n28|const (\n29|\tdispositionExact           = \"exact\"\n30|\tdispositionSemantic        = \"semantic\"\n31|\tdispositionSummarized      = \"summarized\"\n32|\tdispositionOpaquePreserved = \"opaque_preserved\"\n33|\tdispositionOmitted         = \"omitted\"\n34|)\n35|\n36|// Reason spellings, quoted from the internal/clonefidelity owner.\n37|const (\n38|\treasonTargetNoEquivalent   = \"target_no_equivalent\"\n39|\treasonForeignEncrypted     = \"foreign_encrypted_payload\"\n40|\treasonForeignSigned        = \"foreign_signature_unverifiable\"\n41|\treasonOfficialImporterLoss = \"official_importer_loss\"\n42|\treasonGraphFlattened       = \"graph_flattened\"\n43|\treasonUnsafePending        = \"unsafe_pending_action\"\n44|\treasonOperatorPolicy       = \"operator_policy\"\n45|\treasonUnsupportedMedia     = \"unsupported_media_type\"\n46|\treasonUnknownNative        = \"unknown_native_event\"\n47|\treasonTargetContextLimit   = \"target_context_limit\"\n48|)\n49|\n50|// Profile spellings, quoted from the internal/clonefidelity owner.\n51|const (\n52|\tprofileStrictExact = \"strict_exact\"\n53|\tprofileMaximalSafe = \"maximal_safe\"\n54|\tprofileCompact     = \"compact\"\n55|\tprofileMessages    = \"messages_only\"\n56|)\n57|\n58|// completeToolKinds degrade under the vendor importer: the\n59|// importer's native tool history is lossy.\n60|var completeToolKinds = map[string]bool{\n61|\t\"tool_call\":                true,\n62|\t\"tool_result\":              true,\n63|\t\"tool_definition_snapshot\": true,\n64|}\n65|\n66|// subagentKinds flatten under the vendor importer: the subagent\n67|// graph does not survive official import.\n68|var subagentKinds = map[string]bool{\n69|\t\"subagent_started\":   true,\n70|\t\"subagent_completed\": true,\n71|}\n72|\n73|// messageKinds survive messages_only at the event level.\n74|var messageKinds = map[string]bool{\n75|\t\"user_message\":      true,\n76|\t\"assistant_message\": true,\n77|}\n78|\n79|// messageBlocks survive messages_only at the block level:\n80|// text and structured message content plus the redaction marker,\n81|// which preserves the redaction exactly.\n82|var messageBlocks = map[string]bool{\n83|\t\"text\":     true,\n84|\t\"json\":     true,\n85|\t\"redacted\": true,\n86|}\n87|\n88|// mediaBlocks are message content the messages_only profile cannot\n89|// carry: the target shows text messages, not media.\n90|var mediaBlocks = map[string]bool{\n91|\t\"image\":         true,\n92|\t\"audio\":         true,\n93|\t\"document\":      true,\n94|\t\"resource_link\": true,\n95|}\n96|\n97|// maxSessionItems bounds one planned session: the Projection Plan\n98|// 1.0.0 table carries item_mappings[1..1000000].\n99|const maxSessionItems = 1000000\n100|\n101|// PlanItem plans one item's expected disposition with its reason\n102|// set under the strategy and profile. Unknown strategies,\n103|// profiles, or item classes refuse; the archive strategy or\n104|// profile refuses (archive carries no plan); strict_exact refuses\n105|// every non-exact item.\n106|func PlanItem(strategy, profile string, item Item) (Mapping, error) {\n107|\tif !clonefidelity.ValidStrategy(strategy) {\n108|\t\treturn Mapping{}, invalid(\"projection strategy %q is outside the Section 13.14.2 vocabulary\", strategy)\n109|\t}\n110|\tif strategy == strategyArchive || profile == profileArchive {\n111|\t\treturn Mapping{}, invalid(\"projection strategy %q with profile %q names the archive branch, which carries no plan\", strategy, profile)\n112|\t}\n113|\tif err := checkItem(item); err != nil {\n114|\t\treturn Mapping{}, err\n115|\t}\n116|\tdisposition, reasons := baseMapping(strategy, item)\n117|\tdisposition, reasons, err := applyProfile(profile, item, disposition, reasons)\n118|\tif err != nil {\n119|\t\treturn Mapping{}, err\n120|\t}\n121|\tsorted := append([]string(nil), reasons...)\n122|\tsort.Strings(sorted)\n123|\treturn Mapping{Disposition: disposition, Reasons: sorted}, nil\n124|}\n125|\n126|// baseMapping decides the strategy arm: class rules first (opaque\n127|// and aborted history are strategy-independent), then the\n128|// continuation clamp, then the vendor importer degradations, then\n129|// the native exact default.\n130|func baseMapping(strategy string, item Item) (string, []string) {\n131|\tif item.Kind == \"opaque_reasoning\" {\n132|\t\tif item.Protection == protectionSigned {\n133|\t\t\treturn dispositionOpaquePreserved, []string{reasonForeignSigned}\n134|\t\t}\n135|\t\treturn dispositionOpaquePreserved, []string{reasonForeignEncrypted}\n136|\t}\n137|\tif item.Kind == \"opaque_event\" || item.Block == \"opaque\" {\n138|\t\treturn dispositionOpaquePreserved, []string{reasonUnknownNative}\n139|\t}\n140|\tif (item.Kind == \"tool_call\" || item.Kind == \"tool_result\") && item.Resolution == cloneproject.StatusAborted {\n141|\t\treturn dispositionSummarized, []string{reasonUnsafePending}\n142|\t}\n143|\tif strategy == strategyContinuation {\n144|\t\treturn dispositionSemantic, []string{reasonTargetNoEquivalent}\n145|\t}\n146|\tif strategy == strategyOfficial {\n147|\t\tif completeToolKinds[item.Kind] {\n148|\t\t\treturn dispositionSemantic, []string{reasonOfficialImporterLoss}\n149|\t\t}\n150|\t\tif subagentKinds[item.Kind] {\n151|\t\t\treturn dispositionSemantic, []string{reasonGraphFlattened}\n152|\t\t}\n153|\t}\n154|\treturn dispositionExact, nil\n155|}\n156|\n157|// applyProfile refines the strategy mapping under the profile:\n158|// strict_exact refuses non-exact, compact clamps semantic to\n159|// summarized, messages_only omits non-message classes (keeping and\n160|// extending the reason set), and maximal_safe passes through.\n161|func applyProfile(profile string, item Item, disposition string, reasons []string) (string, []string, error) {\n162|\tswitch profile {\n163|\tcase profileStrictExact:\n164|\t\tif disposition != dispositionExact {\n165|\t\t\treturn \"\", nil, invalid(\"projection profile strict_exact refuses %s with disposition %q\", describeItem(item), disposition)\n166|\t\t}\n167|\t\treturn disposition, reasons, nil\n168|\tcase profileCompact:\n169|\t\tif disposition == dispositionSemantic {\n170|\t\t\treturn dispositionSummarized, append(append([]string(nil), reasons...), reasonTargetContextLimit), nil\n171|\t\t}\n172|\t\treturn disposition, reasons, nil\n173|\tcase profileMessages:\n174|\t\tif isMessageClass(item) {\n175|\t\t\treturn disposition, reasons, nil\n176|\t\t}\n177|\t\tomitted := append(append([]string(nil), reasons...), reasonOperatorPolicy)\n178|\t\tif mediaBlocks[item.Block] {\n179|\t\t\tomitted = append(omitted, reasonUnsupportedMedia)\n180|\t\t}\n181|\t\treturn dispositionOmitted, omitted, nil\n182|\tcase profileMaximalSafe:\n183|\t\treturn disposition, reasons, nil\n184|\tdefault:\n185|\t\treturn \"\", nil, invalid(\"projection profile %q is not a target plan profile\", profile)\n186|\t}\n187|}\n188|\n189|// isMessageClass reports whether the item survives messages_only:\n190|// user/assistant message events and text/structured/redacted\n191|// blocks.\n192|func isMessageClass(item Item) bool {\n193|\tif item.Kind != \"\" {\n194|\t\treturn messageKinds[item.Kind]\n195|\t}\n196|\treturn messageBlocks[item.Block]\n197|}\n198|\n199|// describeItem names the item class for refusals.\n200|func describeItem(item Item) string {\n201|\tif item.Kind != \"\" {\n202|\t\treturn \"kind \" + item.Kind\n203|\t}\n204|\treturn \"block \" + item.Block\n205|}\n206|\n207|// PlanSession plans every item in order and folds the predicted\n208|// counts. Sessions are non-empty and bounded by the plan table's\n209|// item_mappings[1..1000000]; the first refusing item refuses the\n210|// session. Counts derive from the mappings, never accepted.\n211|func PlanSession(strategy, profile string, items []Item) ([]Mapping, clonefidelity.FidelityCounts, error) {\n212|\tif len(items) == 0 || len(items) > maxSessionItems {\n213|\t\treturn nil, clonefidelity.FidelityCounts{}, invalid(\"projection session carries %d items, the plan table requires item_mappings[1..1000000]\", len(items))\n214|\t}\n215|\tmappings := make([]Mapping, 0, len(items))\n216|\tvar counts clonefidelity.FidelityCounts\n217|\tfor _, item := range items {\n218|\t\tmapping, err := PlanItem(strategy, profile, item)\n219|\t\tif err != nil {\n220|\t\t\treturn nil, clonefidelity.FidelityCounts{}, err\n221|\t\t}\n222|\t\tmappings = append(mappings, mapping)\n223|\t\tswitch mapping.Disposition {\n224|\t\tcase dispositionExact:\n225|\t\t\tcounts.Exact++\n226|\t\tcase dispositionSemantic:\n227|\t\t\tcounts.Semantic++\n228|\t\tcase dispositionSummarized:\n229|\t\t\tcounts.Summarized++\n230|\t\tcase dispositionOpaquePreserved:\n231|\t\t\tcounts.OpaquePreserved++\n232|\t\tcase dispositionOmitted:\n233|\t\t\tcounts.Omitted++\n234|\t\tdefault:\n235|\t\t\treturn nil, clonefidelity.FidelityCounts{}, invalid(\"projection session planned unexpected disposition %q\", mapping.Disposition)\n236|\t\t}\n237|\t}\n238|\treturn mappings, counts, nil\n239|}","final_result":true}}}
