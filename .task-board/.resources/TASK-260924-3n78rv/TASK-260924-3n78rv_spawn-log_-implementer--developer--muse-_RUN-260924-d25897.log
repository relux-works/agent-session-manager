{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb03","stream":{"kind":"session","id":"01a0d2c4-4f2b-7620-b603-17ce30f31e40"},"sequence":988,"recorded_at":1780531400001971,"record_type":"event","durability":"durable","causation_id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23","run_stream":{"kind":"run","id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23"},"task_stream":{"kind":"task","id":"01a0d2ca-f2bd-78f0-b37f-42bcba0d8ba3"},"task_id":"01a0d2ca-f2bd-78f0-b37f-42bcba0d8ba3","event":{"kind":"output","task_id":"01a0d2ca-f2bd-78f0-b37f-42bcba0d8ba3","chunk":"{\n  \"chunk_id\": \"exec-20-1\",\n  \"command\": \"ls -R .github 2>&1 | head -n 20; echo \\\"===\\\"; cat .github/workflows/* 2>&1 | head -n 80\",\n  \"description\": \"Inspect CI workflow gates\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"workflows\\n\\n.github/workflows:\\nci.yml\\n===\\nname: CI\\n\\non:\\n  pull_request:\\n  push:\\n    branches:\\n      - main\\n\\npermissions:\\n  contents: read\\n\\n# What green means. Every job below proves its selection matched something:\\n# a grep, glob, file scan, matrix expansion, or test selector that finds\\n# nothing fails closed instead of passing on an empty result set. No job\\n# declares an `if:` condition, so no job can skip quietly; gates-verdict\\n# additionally refuses any skipped, failed, or cancelled dependency.\\n#\\n# GOOS=windows work is compile-and-vet only. A green windows-compile-only job\\n# proves the tree type-checks for Windows; it never implies executed\\n# behaviour. Coverage is reported as numbers, not enforced as a floor.\\njobs:\\n  contract-preservation:\\n    name: Contract preservation (v0.5.0 current, v0.4.3 historical)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 10\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      - name: Verify specification-to-code ownership\\n        run: go run ./internal/traceability/cmd/tracecheck\\n\\n      # The diff proves the committed catalog matches generator output, but\\n      # `go generate` runs nothing when its directive is disarmed: rewriting\\n      # `//go:generate` as `// go:generate` preserves the token while turning\\n      # the directive into a plain comment, so generation is skipped and the\\n      # diff stays clean. The anchored check refuses that token-preserving\\n      # rewrite; only the exact directive form counts. A new directive\\n      # without a pin update reddens here (and in\\n      # TestGenerateDirectiveStaysRecognizedForm) instead of going unchecked.\\n      - name: Verify generated catalog is current\\n        run: |\\n          test \\\"$(grep -c '^//go:generate' internal/catalog/catalog.go)\\\" -eq 1\\n          go generate ./internal/catalog\\n          git diff --exit-code -- internal/catalog/catalog_gen.go\\n\\n      # The release roots are derived from internal/specpin and\\n      # internal/catalog inside the gate, never retyped here. Each -- PASS\\n      # guard below must match: a selector that runs nothing fails here\\n      # instead of passing silently.\\n      - name: Run pinned contract-version gates\\n        run: |\\n          set +e\\n          go test ./internal/cigate -run 'TestVerifyContractPreservationLive|TestPinnedReleasesAgreeAcrossAuthorities|TestDerivedSetsAreComplete|TestCheckAgreementAdmitsIdenticalSets|TestCheckAgreementRefusals|TestCheckReleaseRootsRefusesDrift' -count=1 -v > cigate-contracts.log 2>&1\\n          code=$?\\n          set -e\\n          cat cigate-contracts.log\\n          test $code -eq 0\\n          for gate in TestVerifyContractPreservationLive TestPinnedReleasesAgreeAcrossAuthorities TestDerivedSetsAreComplete TestCheckAgreementAdmitsIdenticalSets TestCheckAgreementRefusals TestCheckReleaseRootsRefusesDrift; do\\n            grep -q \\\"^--- PASS: ${gate}\\\" cigate-contracts.log\\n          done\\n\\n  lint:\\n    name: Linters (vet, Windows vet, gofmt)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 10\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n\",\n  \"original_output_bytes\": 3314,\n  \"original_output_tokens\": 829,\n  \"truncated\": false\n}","final_result":true}}}
