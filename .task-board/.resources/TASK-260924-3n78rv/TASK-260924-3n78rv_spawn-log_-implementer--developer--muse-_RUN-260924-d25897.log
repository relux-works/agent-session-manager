{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c72b","stream":{"kind":"session","id":"01a0d2c4-4f2b-7620-b603-17ce30f31e40"},"sequence":496,"recorded_at":1780531400000987,"record_type":"event","durability":"durable","causation_id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23","run_stream":{"kind":"run","id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23"},"call_id":"call_01a0d2c54ed3703298a017aabc7f0acc","text":"Read text file `internal/clonebundle/event.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"strconv\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n11|)\n12|\n13|// This file validates and constructs Canonical Event 1.0.0 with its\n14|// Source Evidence and raw byte-range references. The envelope,\n15|// vocabularies, evidence coupling, and message-like content-block\n16|// rules are enforced here; the full per-kind payload fact registry\n17|// is sibling (normalization) scope and is stated in doc.go.\n18|\n19|const (\n20|\tcanonicalEventSchema  = \"urn:ax:schema:canonical-event\"\n21|\tcanonicalEventVersion = \"1.0.0\"\n22|\tcanonicalEventSelf    = \"event_id\"\n23|\tmaxInlineContent      = 65536\n24|)\n25|\n26|// eventKinds is the exact 26-kind event vocabulary Section 13.14.1\n27|// states.\n28|var eventKinds = []string{\n29|\t\"session_started\",\n30|\t\"instruction_snapshot\",\n31|\t\"user_message\",\n32|\t\"assistant_message\",\n33|\t\"reasoning_summary\",\n34|\t\"opaque_reasoning\",\n35|\t\"tool_definition_snapshot\",\n36|\t\"tool_call\",\n37|\t\"tool_result\",\n38|\t\"approval_request\",\n39|\t\"approval_response\",\n40|\t\"plan_update\",\n41|\t\"progress\",\n42|\t\"usage\",\n43|\t\"rate_limit\",\n44|\t\"file_change\",\n45|\t\"compaction\",\n46|\t\"turn_started\",\n47|\t\"turn_completed\",\n48|\t\"turn_aborted\",\n49|\t\"subagent_started\",\n50|\t\"subagent_completed\",\n51|\t\"error\",\n52|\t\"migration_checkpoint\",\n53|\t\"session_finished\",\n54|\t\"opaque_event\",\n55|}\n56|\n57|// ValidEventKind reports whether the name is a canonical event kind.\n58|func ValidEventKind(kind string) bool {\n59|\tfor _, allowed := range eventKinds {\n60|\t\tif kind == allowed {\n61|\t\t\treturn true\n62|\t\t}\n63|\t}\n64|\treturn false\n65|}\n66|\n67|// EventKinds returns the exact 26-kind event vocabulary Section\n68|// 13.14.1 states, in specification order. Sibling packages iterate\n69|// the returned copy so closed maps over every kind keep one owner;\n70|// callers must not retain and mutate across calls.\n71|func EventKinds() []string {\n72|\tkinds := make([]string, len(eventKinds))\n73|\tcopy(kinds, eventKinds)\n74|\treturn kinds\n75|}\n76|\n77|func validVisibility(visibility string) bool {\n78|\tswitch visibility {\n79|\tcase \"public\", \"projection\", \"internal\", \"opaque\":\n80|\t\treturn true\n81|\tdefault:\n82|\t\treturn false\n83|\t}\n84|}\n85|\n86|func validCaptureStatus(status string) bool {\n87|\tswitch status {\n88|\tcase \"exact\", \"partial\", \"synthesized\", \"unavailable\":\n89|\t\treturn true\n90|\tdefault:\n91|\t\treturn false\n92|\t}\n93|}\n94|\n95|// contentBlockTypes is the exact message-like content-block\n96|// vocabulary: text|json|image|audio|document|resource_link|redacted|opaque.\n97|var contentBlockTypes = []string{\n98|\t\"text\",\n99|\t\"json\",\n100|\t\"image\",\n101|\t\"audio\",\n102|\t\"document\",\n103|\t\"resource_link\",\n104|\t\"redacted\",\n105|\t\"opaque\",\n106|}\n107|\n108|func validContentBlockType(blockType string) bool {\n109|\tfor _, allowed := range contentBlockTypes {\n110|\t\tif blockType == allowed {\n111|\t\t\treturn true\n112|\t\t}\n113|\t}\n114|\treturn false\n115|}\n116|\n117|// ValidContentBlockType reports whether the name is a message-like\n118|// content-block type. It delegates to the single Section 13.14.1\n119|// table above so sibling packages share one vocabulary owner.\n120|func ValidContentBlockType(blockType string) bool {\n121|\treturn validContentBlockType(blockType)\n122|}\n123|\n124|// ContentBlockTypes returns the exact message-like content-block\n125|// vocabulary Section 13.14.1 states, in specification order.\n126|// Sibling packages iterate the returned copy so closed maps over\n127|// every type keep one owner; callers must not retain and mutate\n128|// across calls.\n129|func ContentBlockTypes() []string {\n130|\ttypes := make([]string, len(contentBlockTypes))\n131|\tcopy(types, contentBlockTypes)\n132|\treturn types\n133|}\n134|\n135|// messageLikeKind reports whether the kind carries a message-like\n136|// payload: user and assistant messages always do. Other kinds may\n137|// carry content blocks under the same block rules, but only these\n138|// two require them.\n139|func messageLikeKind(kind string) bool {\n140|\treturn kind == \"user_message\" || kind == \"assistant_message\"\n141|}\n142|\n143|var rawReferenceMembers = map[string]bool{\n144|\t\"manifest_id\": true, \"blob_descriptor_id\": true, \"offset\": true, \"length\": true,\n145|}\n146|\n147|var rawReferenceRequired = []string{\n148|\t\"manifest_id\", \"blob_descriptor_id\", \"offset\", \"length\",\n149|}\n150|\n151|// RawReference is one validated raw byte-range reference.\n152|type RawReference struct {\n153|\tManifestID       scalar.Digest\n154|\tBlobDescriptorID scalar.Digest\n155|\tOffset           uint64\n156|\tLength           uint64\n157|}\n158|\n159|func decodeRawReference(raw json.RawMessage, index int) (RawReference, error) {\n160|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n161|\tif fault != nil {\n162|\t\treturn RawReference{}, invalid(\"raw reference[%d] %s (%s)\", index, fault.detail, memberField(fault.member))\n163|\t}\n164|\tif name, unknown := unknownMember(members, rawReferenceMembers); unknown {\n165|\t\treturn RawReference{}, invalid(\"raw reference[%d] carries unknown member %q\", index, name)\n166|\t}\n167|\tif name, missing := missingMember(members, rawReferenceRequired); missing {\n168|\t\treturn RawReference{}, invalid(\"raw reference[%d] misses a required member %q\", index, name)\n169|\t}\n170|\tmanifestID, ok := checkDigest(members[\"manifest_id\"])\n171|\tif !ok {\n172|\t\treturn RawReference{}, invalid(\"raw reference[%d] manifest_id is not a digest\", index)\n173|\t}\n174|\tdescriptorID, ok := checkDigest(members[\"blob_descriptor_id\"])\n175|\tif !ok {\n176|\t\treturn RawReference{}, invalid(\"raw reference[%d] blob_descriptor_id is not a digest\", index)\n177|\t}\n178|\toffset, ok := checkUint53Bounds(members[\"offset\"], 0, maxUint53)\n179|\tif !ok {\n180|\t\treturn RawReference{}, invalid(\"raw reference[%d] offset is not a uint53\", index)\n181|\t}\n182|\tlength, ok := checkUint53Bounds(members[\"length\"], 0, maxUint53)\n183|\tif !ok {\n184|\t\treturn RawReference{}, invalid(\"raw reference[%d] length is not a uint53\", index)\n185|\t}\n186|\treturn RawReference{\n187|\t\tManifestID:       manifestID,\n188|\t\tBlobDescriptorID: descriptorID,\n189|\t\tOffset:           offset,\n190|\t\tLength:           length,\n191|\t}, nil\n192|}\n193|\n194|func rawReferenceObject(reference RawReference) map[string]any {\n195|\treturn map[string]any{\n196|\t\t\"manifest_id\":        reference.ManifestID.String(),\n197|\t\t\"blob_descriptor_id\": reference.BlobDescriptorID.String(),\n198|\t\t\"offset\":             reference.Offset,\n199|\t\t\"length\":             reference.Length,\n200|\t}\n201|}\n202|\n203|// decodeSortedUniqueRawReferences validates sorted unique raw\n204|// references: bytewise order of each item's JCS encoding, strict\n205|// increase proving sortedness and uniqueness together.\n206|func decodeSortedUniqueRawReferences(raw json.RawMessage) ([]RawReference, error) {\n207|\telements, ok := decodeArray(raw)\n208|\tif !ok {\n209|\t\treturn nil, invalid(\"source evidence raw_refs are not an array\")\n210|\t}\n211|\tif len(elements) > 65536 {\n212|\t\treturn nil, invalid(\"source evidence carries %d raw_refs, maximum is 65536\", len(elements))\n213|\t}\n214|\treferences := make([]RawReference, 0, len(elements))\n215|\tvar previous []byte\n216|\tfor index, element := range elements {\n217|\t\treference, err := decodeRawReference(element, index)\n218|\t\tif err != nil {\n219|\t\t\treturn nil, err\n220|\t\t}\n221|\t\tcanonical, err := canonicaljson.Canonicalize(bytesTrimSpace(element))\n222|\t\tif err != nil {\n223|\t\t\treturn nil, invalid(\"source evidence raw_refs[%d] are not canonical JSON: %v\", index, err)\n224|\t\t}\n225|\t\tif index > 0 && bytes.Compare(canonical, previous) <= 0 {\n226|\t\t\treturn nil, invalid(\"source evidence raw_refs are not sorted unique\")\n227|\t\t}\n228|\t\tprevious = canonical\n229|\t\treferences = append(references, reference)\n230|\t}\n231|\treturn references, nil\n232|}\n233|\n234|var sourceEvidenceMembers = map[string]bool{\n235|\t\"environment\": true, \"native_session_id\": true, \"native_event_id\": true,\n236|\t\"native_type\": true, \"raw_refs\": true, \"capture_status\": true,\n237|\t\"reason_codes\": true, \"core_operation_id\": true, \"extensions\": true,\n238|}\n239|\n240|var sourceEvidenceRequired = []string{\n241|\t\"environment\", \"native_session_id\", \"native_event_id\",\n242|\t\"native_type\", \"raw_refs\", \"capture_status\",\n243|\t\"reason_codes\", \"core_operation_id\", \"extensions\",\n244|}\n245|\n246|// SourceEvidence is one validated source evidence record.\n247|type SourceEvidence struct {\n248|\tEnvironment     sessadapter.Tuple\n249|\tNativeSessionID string\n250|\tNativeEventID   *string\n251|\tNativeType      *string\n252|\tRawRefs         []RawReference\n253|\tCaptureStatus   string\n254|\tReasonCodes     []string\n255|\tCoreOperationID *scalar.UUIDv7\n256|}\n257|\n258|// DecodeSourceEvidence validates one closed SourceEvidence:\n259|// sanitized native IDs, sorted unique raw references, and the\n260|// synthesized coupling (null native Event ID with a non-null core\n261|// operation; every other status with a null core operation).\n262|func DecodeSourceEvidence(raw json.RawMessage) (SourceEvidence, error) {\n263|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n264|\tif fault != nil {\n265|\t\treturn SourceEvidence{}, invalid(\"source evidence %s (%s)\", fault.detail, memberField(fault.member))\n266|\t}\n267|\tif name, unknown := unknownMember(members, sourceEvidenceMembers); unknown {\n268|\t\treturn SourceEvidence{}, invalid(\"source evidence carries unknown member %q\", name)\n269|\t}\n270|\tif name, missing := missingMember(members, sourceEvidenceRequired); missing {\n271|\t\treturn SourceEvidence{}, invalid(\"source evidence misses a required member %q\", name)\n272|\t}\n273|\ttuple, err := sessadapter.DecodeTuple(members[\"environment\"])\n274|\tif err != nil {\n275|\t\treturn SourceEvidence{}, invalid(\"source evidence environment is not an Environment Tuple: %v\", err)\n276|\t}\n277|\tnativeSession, ok := checkStringBounds(members[\"native_session_id\"], 1, 512)\n278|\tif !ok {\n279|\t\treturn SourceEvidence{}, invalid(\"source evidence native_session_id is not a string[1..512]\")\n280|\t}\n281|\tif err := SanitizeNativeKey(nativeSession); err != nil {\n282|\t\treturn SourceEvidence{}, err\n283|\t}\n284|\tvar nativeEvent *string\n285|\tif !isNull(members[\"native_event_id\"]) {\n286|\t\tvalue, ok := checkStringBounds(members[\"native_event_id\"], 1, 512)\n287|\t\tif !ok {\n288|\t\t\treturn SourceEvidence{}, invalid(\"source evidence native_event_id is not a string[1..512]\")\n289|\t\t}\n290|\t\tif err := SanitizeNativeKey(value); err != nil {\n291|\t\t\treturn SourceEvidence{}, err\n292|\t\t}\n293|\t\tnativeEvent = &value\n294|\t}\n295|\tvar nativeType *string\n296|\tif !isNull(members[\"native_type\"]) {\n297|\t\tvalue, ok := checkStringBounds(members[\"native_type\"], 1, 512)\n298|\t\tif !ok {\n299|\t\t\treturn SourceEvidence{}, invalid(\"source evidence native_type is not a string[1..512]\")\n300|\t\t}\n301|\t\tnativeType = &value\n302|\t}\n303|\treferences, err := decodeSortedUniqueRawReferences(members[\"raw_refs\"])\n304|\tif err != nil {\n305|\t\treturn SourceEvidence{}, err\n306|\t}\n307|\tstatus, ok := rawString(members[\"capture_status\"])\n308|\tif !ok || !validCaptureStatus(status) {\n309|\t\treturn SourceEvidence{}, invalid(\"source evidence capture_status is outside exact|partial|synthesized|unavailable\")\n310|\t}\n311|\treasons, ok := checkSortedUniqueStrings(members[\"reason_codes\"], 1, 128, 0, 128)\n312|\tif !ok {\n313|\t\treturn SourceEvidence{}, invalid(\"source evidence reason_codes are not sorted unique string[1..128][0..128]\")\n314|\t}\n315|\tvar operation *scalar.UUIDv7\n316|\tif !isNull(members[\"core_operation_id\"]) {\n317|\t\tvalue, ok := checkUUIDv7(members[\"core_operation_id\"])\n318|\t\tif !ok {\n319|\t\t\treturn SourceEvidence{}, invalid(\"source evidence core_operation_id is not a UUIDv7\")\n320|\t\t}\n321|\t\toperation = &value\n322|\t}\n323|\tif err := checkEvidenceCoupling(status, nativeEvent != nil, operation != nil); err != nil {\n324|\t\treturn SourceEvidence{}, err\n325|\t}\n326|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n327|\t\treturn SourceEvidence{}, invalid(\"source evidence extensions %s\", extensionsFault)\n328|\t}\n329|\treturn SourceEvidence{\n330|\t\tEnvironment:     tuple,\n331|\t\tNativeSessionID: nativeSession,\n332|\t\tNativeEventID:   nativeEvent,\n333|\t\tNativeType:      nativeType,\n334|\t\tRawRefs:         references,\n335|\t\tCaptureStatus:   status,\n336|\t\tReasonCodes:     reasons,\n337|\t\tCoreOperationID: operation,\n338|\t}, nil\n339|}\n340|\n341|// checkEvidenceCoupling enforces the synthesized rule: synthesized\n342|// requires a null native Event ID and a non-null core operation\n343|// identifying the core operation; all other statuses require a\n344|// null core operation.\n345|func checkEvidenceCoupling(status string, hasNativeEvent, hasOperation bool) error {\n346|\tif status == \"synthesized\" {\n347|\t\tif hasNativeEvent {\n348|\t\t\treturn invalid(\"source evidence synthesized carries a native event ID\")\n349|\t\t}\n350|\t\tif !hasOperation {\n351|\t\t\treturn invalid(\"source evidence synthesized requires a core operation\")\n352|\t\t}\n353|\t\treturn nil\n354|\t}\n355|\tif hasOperation {\n356|\t\treturn invalid(\"source evidence %s carries a core operation\", status)\n357|\t}\n358|\treturn nil\n359|}\n360|\n361|var canonicalEventMembers = map[string]bool{\n362|\t\"schema\": true, \"schema_version\": true, \"event_id\": true,\n363|\t\"logical_session_id\": true, \"ordinal\": true, \"parents\": true,\n364|\t\"actor_id\": true, \"turn_id\": true, \"kind\": true, \"timestamp\": true,\n365|\t\"visibility\": true, \"payload\": true, \"source_evidence\": true, \"extensions\": true,\n366|}\n367|\n368|var canonicalEventRequired = []string{\n369|\t\"schema\", \"schema_version\", \"event_id\",\n370|\t\"logical_session_id\", \"ordinal\", \"parents\",\n371|\t\"actor_id\", \"turn_id\", \"kind\", \"timestamp\",\n372|\t\"visibility\", \"payload\", \"source_evidence\", \"extensions\",\n373|}\n374|\n375|// CanonicalEvent is one validated Canonical Event. Payload carries\n376|// the validated closed payload object.\n377|type CanonicalEvent struct {\n378|\tEventID          scalar.Digest\n379|\tLogicalSessionID scalar.UUIDv7\n380|\tOrdinal          uint64\n381|\tParents          []scalar.Digest\n382|\tActorID          scalar.UUIDv7\n383|\tTurnID           *scalar.UUIDv7\n384|\tKind             string\n385|\tTimestamp        *scalar.Timestamp\n386|\tVisibility       string\n387|\tPayload          map[string]any\n388|\tEvidence         SourceEvidence\n389|}\n390|\n391|// RawRefInput is one caller-supplied raw reference candidate.\n392|type RawRefInput struct {\n393|\tManifestID       string\n394|\tBlobDescriptorID string\n395|\tOffset           uint64\n396|\tLength           uint64\n397|}\n398|\n399|// EvidenceInput is one caller-supplied source evidence candidate\n400|// for Build.\n401|type EvidenceInput struct {\n402|\tEnvironment     []byte\n403|\tNativeSessionID string\n404|\tNativeEventID   *string\n405|\tNativeType      *string\n406|\tRawRefs         []RawRefInput\n407|\tCaptureStatus   string\n408|\tReasonCodes     []string\n409|\tCoreOperationID *string\n410|}\n411|\n412|// CanonicalEventInput is the caller-supplied canonical event\n413|// candidate for Build. Payload carries the exact closed payload\n414|// object bytes; Build validates them under the kind-selected rules.\n415|type CanonicalEventInput struct {\n416|\tLogicalSessionID string\n417|\tOrdinal          uint64\n418|\tParents          []string\n419|\tActorID          string\n420|\tTurnID           *string\n421|\tKind             string\n422|\tTimestamp        *string\n423|\tVisibility       string\n424|\tPayload          []byte\n425|\tEvidence         EvidenceInput\n426|\tExtensions       map[string]any\n427|}\n428|\n429|// BuildCanonicalEvent constructs one closed Canonical Event 1.0.0\n430|// as canonical bytes. Identical inputs produce byte-identical\n431|// outputs.\n432|func BuildCanonicalEvent(input CanonicalEventInput) ([]byte, error) {\n433|\tobject, err := buildCanonicalEvent(input)\n434|\tif err != nil {\n435|\t\treturn nil, err\n436|\t}\n437|\tomitted, err := canonicalizeObject(object)\n438|\tif err != nil {\n439|\t\treturn nil, err\n440|\t}\n441|\teventID := scalar.SHA256Digest(omitted)\n442|\tobject[canonicalEventSelf] = eventID.String()\n443|\treturn canonicalizeObject(object)\n444|}\n445|\n446|func buildCanonicalEvent(input CanonicalEventInput) (map[string]any, error) {\n447|\tlogical, err := scalar.ParseUUIDv7(input.LogicalSessionID)\n448|\tif err != nil {\n449|\t\treturn nil, invalid(\"canonical event logical_session_id is not a UUIDv7: %v\", err)\n450|\t}\n451|\tif input.Ordinal > maxUint53 {\n452|\t\treturn nil, invalid(\"canonical event ordinal exceeds uint53\")\n453|\t}\n454|\tparents, err := parseSortedUniqueDigestStrings(input.Parents, 0, 64, \"parents\")\n455|\tif err != nil {\n456|\t\treturn nil, invalid(\"canonical event %v\", err)\n457|\t}\n458|\tactorID, err := scalar.ParseUUIDv7(input.ActorID)\n459|\tif err != nil {\n460|\t\treturn nil, invalid(\"canonical event actor_id is not a UUIDv7: %v\", err)\n461|\t}\n462|\tvar turn any\n463|\tif input.TurnID != nil {\n464|\t\tvalue, err := scalar.ParseUUIDv7(*input.TurnID)\n465|\t\tif err != nil {\n466|\t\t\treturn nil, invalid(\"canonical event turn_id is not a UUIDv7: %v\", err)\n467|\t\t}\n468|\t\tturn = value.String()\n469|\t}\n470|\tif !ValidEventKind(input.Kind) {\n471|\t\treturn nil, invalid(\"canonical event kind is outside the 26-kind vocabulary\")\n472|\t}\n473|\tvar stamp any\n474|\tif input.Timestamp != nil {\n475|\t\tvalue, err := scalar.ParseTimestamp(*input.Timestamp)\n476|\t\tif err != nil {\n477|\t\t\treturn nil, invalid(\"canonical event timestamp is not a timestamp: %v\", err)\n478|\t\t}\n479|\t\tstamp = value.String()\n480|\t}\n481|\tif !validVisibility(input.Visibility) {\n482|\t\treturn nil, invalid(\"canonical event visibility is outside public|projection|internal|opaque\")\n483|\t}\n484|\tpayload, err := checkPayload(input.Kind, json.RawMessage(input.Payload))\n485|\tif err != nil {\n486|\t\treturn nil, err\n487|\t}\n488|\tevidence, err := buildSourceEvidence(input.Evidence)\n489|\tif err != nil {\n490|\t\treturn nil, err\n491|\t}\n492|\tif _, err := encodeExtensions(input.Extensions); err != nil {\n493|\t\treturn nil, err\n494|\t}\n495|\treturn map[string]any{\n496|\t\t\"schema\":             canonicalEventSchema,\n497|\t\t\"schema_version\":     canonicalEventVersion,\n498|\t\t\"logical_session_id\": logical.String(),\n499|\t\t\"ordinal\":            input.Ordinal,\n500|\t\t\"parents\":            digestStrings(parents),\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
