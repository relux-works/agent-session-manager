{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c659","stream":{"kind":"session","id":"01a0d2c4-4f2b-7620-b603-17ce30f31e40"},"sequence":391,"recorded_at":1780531400000777,"record_type":"event","durability":"durable","causation_id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23","run_stream":{"kind":"run","id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23"},"task_stream":{"kind":"task","id":"01a0d2c5-2199-7712-91fc-b0fb33d72975"},"task_id":"01a0d2c5-2199-7712-91fc-b0fb33d72975","event":{"kind":"output","task_id":"01a0d2c5-2199-7712-91fc-b0fb33d72975","chunk":"Read text file `internal/cloneplanning/structural_test.go`.\n1|package cloneplanning\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"testing\"\n8|)\n9|\n10|// This file pins the authority-by-type shape structurally: in\n11|// ProjectVisibleText the Authority field is assigned exactly once,\n12|// unconditionally, from the authorityUserContext constant (or the\n13|// literal \"user_context\" it quotes). No branch on text, kind,\n14|// ordinal, or event IDs can reach the authority decision, because\n15|// no branch reaches it at all. Control plants (a conditional\n16|// authority, a foreign literal) redden this test; logs ride the\n17|// evidence tar.\n18|\n19|// authorityShape describes the Authority assignments found in\n20|// ProjectVisibleText.\n21|type authorityShape struct {\n22|\tassignments int\n23|\tconditional int\n24|\tforeign     int\n25|}\n26|\n27|func inspectAuthorityShape(t *testing.T, path string) authorityShape {\n28|\tt.Helper()\n29|\tfset := token.NewFileSet()\n30|\tfile, err := parser.ParseFile(fset, path, nil, 0)\n31|\tif err != nil {\n32|\t\tt.Fatalf(\"parse %s: %v\", path, err)\n33|\t}\n34|\tvar shape authorityShape\n35|\tfor _, decl := range file.Decls {\n36|\t\tfn, ok := decl.(*ast.FuncDecl)\n37|\t\tif !ok || fn.Name.Name != \"ProjectVisibleText\" {\n38|\t\t\tcontinue\n39|\t\t}\n40|\t\tast.Inspect(fn.Body, func(node ast.Node) bool {\n41|\t\t\tswitch stmt := node.(type) {\n42|\t\t\tcase *ast.IfStmt, *ast.SwitchStmt, *ast.TypeSwitchStmt, *ast.ForStmt, *ast.RangeStmt, *ast.SelectStmt:\n43|\t\t\t\t// Any Authority assignment nested in a\n44|\t\t\t\t// branch or loop counts conditional.\n45|\t\t\t\tast.Inspect(stmt, func(inner ast.Node) bool {\n46|\t\t\t\t\tkv, ok := inner.(*ast.KeyValueExpr)\n47|\t\t\t\t\tif ok {\n48|\t\t\t\t\t\tcheckAuthorityValue(t, kv, &shape, true)\n49|\t\t\t\t\t}\n50|\t\t\t\t\tassign, ok := inner.(*ast.AssignStmt)\n51|\t\t\t\t\tif ok {\n52|\t\t\t\t\t\tcheckAuthorityAssign(t, assign, &shape, true)\n53|\t\t\t\t\t}\n54|\t\t\t\t\treturn true\n55|\t\t\t\t})\n56|\t\t\t\treturn false\n57|\t\t\tcase *ast.KeyValueExpr:\n58|\t\t\t\tcheckAuthorityValue(t, stmt, &shape, false)\n59|\t\t\tcase *ast.AssignStmt:\n60|\t\t\t\tcheckAuthorityAssign(t, stmt, &shape, false)\n61|\t\t\t}\n62|\t\t\treturn true\n63|\t\t})\n64|\t}\n65|\treturn shape\n66|}\n67|\n68|func isAuthorityKey(expr ast.Expr) bool {\n69|\tident, ok := expr.(*ast.Ident)\n70|\treturn ok && ident.Name == \"Authority\"\n71|}\n72|\n73|func isAuthoritySelector(expr ast.Expr) bool {\n74|\tsel, ok := expr.(*ast.SelectorExpr)\n75|\treturn ok && sel.Sel.Name == \"Authority\"\n76|}\n77|\n78|// checkAuthorityValue inspects one composite-literal Authority\n79|// field for the constant shape.\n80|func checkAuthorityValue(t *testing.T, kv *ast.KeyValueExpr, shape *authorityShape, conditional bool) {\n81|\tt.Helper()\n82|\tif !isAuthorityKey(kv.Key) {\n83|\t\treturn\n84|\t}\n85|\tshape.assignments++\n86|\tif conditional {\n87|\t\tshape.conditional++\n88|\t}\n89|\tif !isAuthorityConstant(kv.Value) {\n90|\t\tshape.foreign++\n91|\t}\n92|}\n93|\n94|// checkAuthorityAssign inspects one Authority assignment for the\n95|// constant shape.\n96|func checkAuthorityAssign(t *testing.T, assign *ast.AssignStmt, shape *authorityShape, conditional bool) {\n97|\tt.Helper()\n98|\tfor i, target := range assign.Lhs {\n99|\t\tif !isAuthoritySelector(target) && !isAuthorityKey(target) {\n100|\t\t\tcontinue\n101|\t\t}\n102|\t\tif i >= len(assign.Rhs) {\n103|\t\t\tcontinue\n104|\t\t}\n105|\t\tshape.assignments++\n106|\t\tif conditional {\n107|\t\t\tshape.conditional++\n108|\t\t}\n109|\t\tif !isAuthorityConstant(assign.Rhs[i]) {\n110|\t\t\tshape.foreign++\n111|\t\t}\n112|\t}\n113|}\n114|\n115|// isAuthorityConstant reports whether the value is the authority\n116|// constant or the literal it quotes.\n117|func isAuthorityConstant(expr ast.Expr) bool {\n118|\tif ident, ok := expr.(*ast.Ident); ok {\n119|\t\treturn ident.Name == \"authorityUserContext\"\n120|\t}\n121|\tif lit, ok := expr.(*ast.BasicLit); ok {\n122|\t\treturn lit.Value == `\"user_context\"`\n123|\t}\n124|\treturn false\n125|}\n126|\n127|func TestAuthorityDecisionShape(t *testing.T) {\n128|\t// The constant quotes SPEC.v0.7.0.md:10810 literally.\n129|\tif authorityUserContext != \"user_context\" {\n130|\t\tt.Fatalf(\"authority constant %q, want user_context\", authorityUserContext)\n131|\t}\n132|\tshape := inspectAuthorityShape(t, \"visible.go\")\n133|\tif shape.assignments != 1 {\n134|\t\tt.Fatalf(\"ProjectVisibleText assigns Authority %d times, want exactly 1\", shape.assignments)\n135|\t}\n136|\tif shape.conditional != 0 {\n137|\t\tt.Fatalf(\"ProjectVisibleText assigns Authority under a branch or loop\")\n138|\t}\n139|\tif shape.foreign != 0 {\n140|\t\tt.Fatalf(\"ProjectVisibleText assigns Authority from a foreign value\")\n141|\t}\n142|}","final_result":true}}}
