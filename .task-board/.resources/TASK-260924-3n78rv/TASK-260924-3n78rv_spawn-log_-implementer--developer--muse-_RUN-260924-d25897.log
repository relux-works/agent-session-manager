{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c69f","stream":{"kind":"session","id":"01a0d2c4-4f2b-7620-b603-17ce30f31e40"},"sequence":426,"recorded_at":1780531400000847,"record_type":"event","durability":"durable","causation_id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23","run_stream":{"kind":"run","id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23"},"task_stream":{"kind":"task","id":"01a0d2c5-2bb0-7a92-b184-05f80c2a3131"},"task_id":"01a0d2c5-2bb0-7a92-b184-05f80c2a3131","event":{"kind":"output","task_id":"01a0d2c5-2bb0-7a92-b184-05f80c2a3131","chunk":"Read text file `internal/cloneplanning/testdata/mutant_harness.py`.\n(499 line(s) above)\n500|        expect=\"KILLED\",\n501|        note=\"Narrows the event-ID count gate: admits exactly 65 IDs.\",\n502|    ),\n503|    Mutant(\n504|        name=\"N-visible-ids-order\",\n505|        path=f\"{PACKAGE}/visible.go\",\n506|        find='''\\tfor index := 1; index < len(checked); index++ {\\n\\t\\tif checked[index-1] >= checked[index] {''',\n507|        replace='''\\tfor index := 2; index < len(checked); index++ {\\n\\t\\tif checked[index-1] >= checked[index] {''',\n508|        count=1,\n509|        run=\"TestProjectVisibleEventIDGrid\",\n510|        expect=\"KILLED\",\n511|        note=\"Narrows the event-ID order gate: skips exactly the index-1 adjacency.\",\n512|    ),\n513|    Mutant(\n514|        name=\"N-visible-ids-digest\",\n515|        path=f\"{PACKAGE}/visible.go\",\n516|        find='''\\t\\tdigest, err := scalar.ParseDigest(id)\\n\\t\\tif err != nil {''',\n517|        replace='''\\t\\tdigest, err := scalar.ParseDigest(id)\\n\\t\\tif err != nil && index != 0 {''',\n518|        count=1,\n519|        run=\"TestProjectVisibleEventIDGrid\",\n520|        expect=\"KILLED\",\n521|        note=\"Narrows the event-ID digest gate: skips exactly index 0.\",\n522|    ),\n523|    Mutant(\n524|        name=\"N-visible-authority\",\n525|        path=f\"{PACKAGE}/visible.go\",\n526|        find='''\\t\\tAuthority:   authorityUserContext,''',\n527|        replace='''\\t\\tAuthority:   \"assistant\",''',\n528|        count=1,\n529|        run=\"TestProjectVisibleWholeDomain\",\n530|        expect=\"KILLED\",\n531|        note=\"Narrows the authority gate: emits exactly the assistant authority. The AST shape test fails on this plant too.\",\n532|    ),\n533|    Mutant(\n534|        name=\"N-visible-escape-suffix\",\n535|        path=f\"{PACKAGE}/visible.go\",\n536|        find='''\\tsealed, err := json.Marshal(field)\\n\\tif err != nil {\\n\\t\\treturn \"\", invalid(\"visible text field does not escape: %v\", err)\\n\\t}\\n\\treturn string(sealed), nil''',\n537|        replace='''\\tsealed, err := json.Marshal(field)\\n\\tif err != nil {\\n\\t\\treturn \"\", invalid(\"visible text field does not escape: %v\", err)\\n\\t}\\n\\treturn string(sealed) + \" \", nil''',\n538|        count=1,\n539|        run=\"TestProjectVisibleEscapingOracle\",\n540|        expect=\"KILLED\",\n541|        note=\"Token-preserving attack: the JSON token still leads but a suffix breaks the behavioral round-trip suite.\",\n542|    ),\n543|    Mutant(\n544|        name=\"C-doc-comment\",\n545|        path=f\"{PACKAGE}/visible.go\",\n546|        find='''// authorityUserContext is the only visible-projection authority''',\n547|        replace='''// authorityUserContext is the only visible-projection authority (control)''',\n548|        count=1,\n549|        run=\"TestAuthorityDecisionShape\",\n550|        expect=\"SURVIVED\",\n551|        note=\"Harmless control: a comment-only edit must survive, proving the harness observes outcomes.\",\n552|    ),\n553|]\n554|\n555|\n556|def run_row(mutant, log_dir):\n557|    target = REPO / mutant.path\n558|    original = target.read_text()\n559|    found = original.count(mutant.find)\n560|    log_path = log_dir / f\"{mutant.name}.log\"\n561|    with open(log_path, \"w\") as log:\n562|        log.write(f\"mutant: {mutant.name}\\n\")\n563|        log.write(f\"path: {mutant.path}\\n\")\n564|        log.write(f\"run: {mutant.run}\\n\")\n565|        log.write(f\"expect: {mutant.expect}\\n\")\n566|        log.write(f\"note: {mutant.note}\\n\\n\")\n567|        if found != mutant.count:\n568|            log.write(f\"M-ERROR: find matched {found} times, want {mutant.count}\\n\")\n569|            return \"ERROR\"\n570|        target.write_text(original.replace(mutant.find, mutant.replace))\n571|        log.write(\"M: applied\\n\")\n572|        log.flush()\n573|        started = time.time()\n574|        try:\n575|            proc = subprocess.run(\n576|                [\"go\", \"test\", \"-count=1\", \"-run\", f\"^{mutant.run}$\", f\"./{PACKAGE}/\"],\n577|                cwd=REPO,\n578|                capture_output=True,\n579|                text=True,\n580|                timeout=180,\n581|            )\n582|        except subprocess.TimeoutExpired:\n583|            log.write(\"R-ERROR: timeout after 180s\\n\")\n584|            return \"ERROR\"\n585|        finally:\n586|            target.write_text(original)\n587|            log.write(\"restored\\n\")\n588|        elapsed = time.time() - started\n589|        log.write(f\"R: exit={proc.returncode} elapsed={elapsed:.1f}s\\n\")\n590|        log.write(\"--- stdout ---\\n\")\n591|        log.write(proc.stdout[-6000:])\n592|        log.write(\"\\n--- stderr ---\\n\")\n593|        log.write(proc.stderr[-2000:])\n594|        log.write(\"\\n\")\n595|        failed = proc.returncode != 0 and (\"FAIL\" in proc.stdout or \"FAIL\" in proc.stderr)\n596|        passed = proc.returncode == 0\n597|        if failed:\n598|            verdict = \"KILLED\"\n599|        elif passed:\n600|            verdict = \"SURVIVED\"\n601|        else:\n602|            verdict = \"ERROR\"\n603|        log.write(f\"V: {verdict}\\n\")\n604|        return verdict\n605|\n606|\n607|def main(argv):\n608|    log_dir = None\n609|    names = []\n610|    args = list(argv)\n611|    while args:\n612|        arg = args.pop(0)\n613|        if arg == \"--log-dir\" and args:\n614|            log_dir = Path(args.pop(0))\n615|        else:\n616|            names.append(arg)\n617|    wanted = [m for m in MUTANTS if not names or m.name in names]\n618|    if names and len(wanted) != len(names):\n619|        missing = set(names) - {m.name for m in wanted}\n620|        print(f\"unknown mutants: {sorted(missing)}\")\n621|        return 2\n622|    if log_dir is None:\n623|        log_dir = Path(tempfile.mkdtemp(prefix=\"cloneplanning-mut-\"))\n624|    else:\n625|        log_dir.mkdir(parents=True, exist_ok=True)\n626|    print(f\"log dir: {log_dir}\")\n627|    verdicts = []\n628|    mismatches = 0\n629|    for mutant in wanted:\n630|        verdict = run_row(mutant, log_dir)\n631|        verdicts.append((mutant.name, verdict, mutant.expect))\n632|        mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n633|        if verdict != mutant.expect:\n634|            mismatches += 1\n635|        print(f\"{mutant.name}: {verdict} (expect {mutant.expect}) [{mark}]\")\n636|    killed = sum(1 for _, v, _ in verdicts if v == \"KILLED\")\n637|    survived = sum(1 for _, v, _ in verdicts if v == \"SURVIVED\")\n638|    errors = sum(1 for _, v, _ in verdicts if v == \"ERROR\")\n639|    print(f\"summary: {killed} KILLED, {survived} SURVIVED, {errors} ERROR, {mismatches} mismatches\")\n640|    with open(log_dir / \"verdicts.txt\", \"w\") as f:\n641|        for name, verdict, expect in verdicts:\n642|            f.write(f\"{name}: {verdict} (expect {expect})\\n\")\n643|        f.write(f\"summary: {killed} KILLED, {survived} SURVIVED, {errors} ERROR, {mismatches} mismatches\\n\")\n644|    return 0 if mismatches == 0 and errors == 0 else 1\n645|\n646|\n647|if __name__ == \"__main__\":\n648|    sys.exit(main(sys.argv[1:]))","final_result":true}}}
