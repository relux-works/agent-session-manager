{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c955","stream":{"kind":"session","id":"01a0d2c4-4f2b-7620-b603-17ce30f31e40"},"sequence":773,"recorded_at":1780531400001541,"record_type":"event","durability":"durable","causation_id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23","run_stream":{"kind":"run","id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23"},"call_id":"call_01a0d2c8b9e874818e50c097247aa480","text":"Read text file `internal/cloneplanning/effects.go`.\n1|package cloneplanning\n2|\n3|import (\n4|\t\"github.com/relux-works/agent-session-manager/internal/clonefidelity\"\n5|)\n6|\n7|// This file folds planned mappings to target effects: callable\n8|// tools, pending actions, and target token accounting. Historical\n9|// tools are inert and source usage is not target accounting\n10|// (Section 13.14.1), so the fold is always empty: no mapping admits\n11|// a live effect. Mappings carry no token field by type, so token\n12|// counts cannot reach the accounting decision at all; the sweep\n13|// proves every mapping the planner emits folds to zero.\n14|\n15|// TargetEffects is the planned session's live surface: callable\n16|// tools, pending actions, and target token accounting. Planning\n17|// from captured history always yields the zero value.\n18|type TargetEffects struct {\n19|\tCallableTools      []string\n20|\tPendingActions     []string\n21|\tTargetInputTokens  uint64\n22|\tTargetOutputTokens uint64\n23|}\n24|\n25|// PlanTargetEffects folds planned mappings to their target\n26|// effects: always empty. Every mapping is validated first (closed\n27|// disposition, vocabulary reasons in sorted-unique order), so\n28|// garbage mappings refuse instead of folding.\n29|func PlanTargetEffects(mappings []Mapping) (TargetEffects, error) {\n30|\tfor index, mapping := range mappings {\n31|\t\tif !clonefidelity.ValidDisposition(mapping.Disposition) {\n32|\t\t\treturn TargetEffects{}, invalid(\"target effects mapping[%d] disposition %q is outside the Section 13.14.2 vocabulary\", index, mapping.Disposition)\n33|\t\t}\n34|\t\tfor _, reason := range mapping.Reasons {\n35|\t\t\tif !clonefidelity.ValidReasonCode(reason) {\n36|\t\t\t\treturn TargetEffects{}, invalid(\"target effects mapping[%d] reason %q is not a core or reverse-DNS reason\", index, reason)\n37|\t\t\t}\n38|\t\t}\n39|\t\tfor position := 1; position < len(mapping.Reasons); position++ {\n40|\t\t\tif mapping.Reasons[position-1] >= mapping.Reasons[position] {\n41|\t\t\t\treturn TargetEffects{}, invalid(\"target effects mapping[%d] reasons are not sorted unique\", index)\n42|\t\t\t}\n43|\t\t}\n44|\t}\n45|\treturn TargetEffects{}, nil\n46|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c957","stream":{"kind":"session","id":"01a0d2c4-4f2b-7620-b603-17ce30f31e40"},"sequence":774,"recorded_at":1780531400001543,"record_type":"event","durability":"durable","causation_id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23","run_stream":{"kind":"run","id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23"},"call_id":"call_01a0d2c8bb2f73a6aeac97f71013f35b","text":"Read text file `internal/cloneplanning/session_test.go`.\n1|package cloneplanning\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/clonefidelity\"\n8|)\n9|\n10|// This file drives PlanSession and PlanTargetEffects through the\n11|// production entries. Sessions fold to predicted counts derived\n12|// from the mappings; every mapping the planner emits folds to zero\n13|// target effects (no callable tools, no pending actions, no target\n14|// token accounting).\n15|\n16|// foldOracleCounts folds the independent oracle over a session,\n17|// mirroring the production count derivation from literals.\n18|func foldOracleCounts(t *testing.T, strategy, profile string, items []Item) []Mapping {\n19|\tt.Helper()\n20|\tmappings := make([]Mapping, 0, len(items))\n21|\tfor _, item := range items {\n22|\t\twant := oraclePlan(strategy, profile, item)\n23|\t\tif want.refuseToken != \"\" {\n24|\t\t\tt.Fatalf(\"oracle refuses %s/%s/%s\", strategy, profile, describeItem(item))\n25|\t\t}\n26|\t\tmappings = append(mappings, Mapping{Disposition: want.disposition, Reasons: want.reasons})\n27|\t}\n28|\treturn mappings\n29|}\n30|\n31|func countDispositions(mappings []Mapping) clonefidelity.FidelityCounts {\n32|\tvar counts clonefidelity.FidelityCounts\n33|\tfor _, mapping := range mappings {\n34|\t\tswitch mapping.Disposition {\n35|\t\tcase \"exact\":\n36|\t\t\tcounts.Exact++\n37|\t\tcase \"semantic\":\n38|\t\t\tcounts.Semantic++\n39|\t\tcase \"summarized\":\n40|\t\t\tcounts.Summarized++\n41|\t\tcase \"opaque_preserved\":\n42|\t\t\tcounts.OpaquePreserved++\n43|\t\tcase \"synthesized\":\n44|\t\t\tcounts.Synthesized++\n45|\t\tcase \"omitted\":\n46|\t\t\tcounts.Omitted++\n47|\t\tcase \"unrecoverable\":\n48|\t\t\tcounts.Unrecoverable++\n49|\t\t}\n50|\t}\n51|\treturn counts\n52|}\n53|\n54|func TestPlanSessionCounts(t *testing.T) {\n55|\tsessions := []struct {\n56|\t\tname     string\n57|\t\tstrategy string\n58|\t\tprofile  string\n59|\t\titems    []Item\n60|\t}{\n61|\t\t{\"single-exact\", \"target_native_writer\", \"maximal_safe\", []Item{{Kind: \"user_message\"}}},\n62|\t\t{\"mixed-native\", \"same_environment_native_rewrite\", \"maximal_safe\", []Item{\n63|\t\t\t{Kind: \"user_message\"},\n64|\t\t\t{Kind: \"tool_call\", Resolution: \"aborted\"},\n65|\t\t\t{Kind: \"opaque_reasoning\", Protection: \"signed\"},\n66|\t\t\t{Block: \"image\"},\n67|\t\t}},\n68|\t\t{\"mixed-continuation\", \"continuation_context\", \"compact\", []Item{\n69|\t\t\t{Kind: \"user_message\"},\n70|\t\t\t{Kind: \"assistant_message\"},\n71|\t\t\t{Kind: \"tool_call\", Resolution: \"completed\"},\n72|\t\t\t{Kind: \"usage\"},\n73|\t\t\t{Block: \"text\"},\n74|\t\t}},\n75|\t\t{\"mixed-importer\", \"target_official_import\", \"messages_only\", []Item{\n76|\t\t\t{Kind: \"user_message\"},\n77|\t\t\t{Kind: \"tool_call\", Resolution: \"completed\"},\n78|\t\t\t{Kind: \"subagent_completed\"},\n79|\t\t\t{Kind: \"usage\"},\n80|\t\t\t{Block: \"image\"},\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
