{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb31","stream":{"kind":"session","id":"01a0d2c4-4f2b-7620-b603-17ce30f31e40"},"sequence":1011,"recorded_at":1780531400002017,"record_type":"event","durability":"durable","causation_id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23","run_stream":{"kind":"run","id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23"},"call_id":"call_01a0d2caf8c972f3b6c186f0264db4b1","text":"{\n  \"chunk_id\": \"exec-21-1\",\n  \"command\": \"sed -n '80,200p' .github/workflows/ci.yml 2>&1 | head -n 120\",\n  \"description\": \"Read rest of CI workflow\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"\\n      - name: Vet\\n        run: go vet ./...\\n\\n      - name: Vet Windows build-tagged sources\\n        run: GOOS=windows go vet ./...\\n\\n      # gofmt lists only offending files, so a clean tree prints nothing.\\n      # The file count proves the scan was not empty; the log must then be.\\n      - name: Check formatting\\n        run: |\\n          count=$(find internal -name '*.go' | wc -l | tr -d ' ')\\n          echo \\\"go files scanned: ${count}\\\"\\n          test \\\"${count}\\\" -gt 0\\n          set +e\\n          gofmt -l internal > gofmt.log 2>&1\\n          code=$?\\n          set -e\\n          cat gofmt.log\\n          test $code -eq 0\\n          test ! -s gofmt.log\\n\\n  test:\\n    name: Build and test (no cache)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 15\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      - name: Build\\n        run: go build ./...\\n\\n      # Verbose on purpose: the --- SKIP lines are the suite-wide skip\\n      # datum. At least one package must report ok: a suite that matched\\n      # nothing is a failure, not a pass.\\n      - name: Test\\n        run: |\\n          set +e\\n          go test ./... -v -count=1 > test.log 2>&1\\n          code=$?\\n          set -e\\n          cat test.log\\n          test $code -eq 0\\n          test \\\"$(grep -c '^ok' test.log)\\\" -gt 0\\n          test \\\"$(grep -c '^FAIL' test.log || true)\\\" -eq 0\\n          {\\n            echo \\\"## Suite skips\\\"\\n            echo \\\"\\\"\\n            echo \\\"Skipped: $(grep -c '^--- SKIP' test.log || true)\\\"\\n            grep '^--- SKIP' test.log || echo \\\"none\\\"\\n          } >> \\\"$GITHUB_STEP_SUMMARY\\\"\\n\\n  race:\\n    name: Race detector\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 15\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      - name: Test with race detector\\n        run: |\\n          set +e\\n          go test -race ./... -count=1 > race.log 2>&1\\n          code=$?\\n          set -e\\n          cat race.log\\n          test $code -eq 0\\n          test \\\"$(grep -c '^ok' race.log)\\\" -gt 0\\n\\n  coverage:\\n    name: Coverage numbers (reported, no floor)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 15\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      # Coverage is a number, not a gate: this job reports per-package\\n      # percentages and refuses only an unreadable or empty result.\\n      - name: Test with coverage\\n        run: |\\n          set +e\\n          go test ./... -cover -count=1 > cover.log 2>&1\\n          code=$?\\n          set -e\\n          cat cover.log\\n          test $code -eq 0\\n          test \\\"$(grep -c 'coverage: ' cover.log)\\\" -gt 0\\n          {\\n            echo \\\"## Coverage\\\"\\n            echo \\\"\\\"\\n            echo \\\"| Package | Coverage |\\\"\\n            echo \\\"| --- | --- |\\\"\\n            grep 'coverage: ' cover.log | sed -E 's/^(ok|---)[[:space:]]+([^[:space:]]+).*coverage: ([0-9.]+% of statements)/| `\\\\2` | \\\\3 |/' || true\\n            echo \\\"\\\"\\n            echo \\\"Packages without test files (stated bounds, not failures):\\\"\\n            echo \\\"\\\"\\n            grep 'no test files' cover.log || echo \\\"none\\\"\\n          } >> \\\"$GITHUB_STEP_SUMMARY\\\"\\n\\n  fixture-matrix:\\n    name: Conformance fixtures (${{ matrix.os }}, ${{ matrix.package }})\\n    runs-on: ${{ matrix.os }}\\n\",\n  \"original_output_bytes\": 3547,\n  \"original_output_tokens\": 887,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
