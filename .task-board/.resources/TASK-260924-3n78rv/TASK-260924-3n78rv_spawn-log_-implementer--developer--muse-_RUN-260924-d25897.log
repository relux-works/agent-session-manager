{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c661","stream":{"kind":"session","id":"01a0d2c4-4f2b-7620-b603-17ce30f31e40"},"sequence":395,"recorded_at":1780531400000785,"record_type":"event","durability":"durable","causation_id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23","run_stream":{"kind":"run","id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23"},"task_stream":{"kind":"task","id":"01a0d2c5-21ba-7a73-aba3-12ec8e98ed96"},"task_id":"01a0d2c5-21ba-7a73-aba3-12ec8e98ed96","event":{"kind":"output","task_id":"01a0d2c5-21ba-7a73-aba3-12ec8e98ed96","chunk":"Read text file `internal/cloneplanning/testdata/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for internal/cloneplanning.\n3|\n4|Every gate ships a narrowing mutant: the gate stays present and is\n5|weakened to admit exactly one member of the class it must reject,\n6|and the named killer test must fail when run alone. A delete-only\n7|mutant proves only that the gate exists and is not accepted as\n8|evidence.\n9|\n10|Each row runs M (mutate one production file in place), R (run the\n11|scoped Go killer through a production entry), V (verdict from the Go\n12|exit code plus a FAIL kill-line: KILLED iff R fails with a test\n13|failure line, SURVIVED iff R passes, ERROR for anything else --\n14|unapplied patches, build breaks, timeouts). M failures and R\n15|infrastructure errors are ERROR, never kills or survivals. The file\n16|is restored from its backup after every row, pass or fail.\n17|\n18|Shared gates (the checkItem vocabulary and fact gates with two call\n19|sites: PlanItem and ClassifyItem) carry one plant each with the\n20|both-entries killer TestSharedItemVocabBothEntries.\n21|\n22|Row N-visible-escape-suffix is the token-preserving attack: the\n23|JSON token still leads the output but the behavior changes, and the\n24|killer executes the behavioral escaping suite.\n25|\n26|Single-member-class rows narrow a gate whose reject class holds\n27|exactly one member, so the plant admits the whole class, which is\n28|one member.\n29|\n30|Row C-doc-comment is the harmless control: a comment-only edit that\n31|must SURVIVE, proving the harness observes test outcomes instead of\n32|hard-coding kills.\n33|\n34|Usage:\n35|  PYTHONDONTWRITEBYTECODE=1 python3 internal/cloneplanning/testdata/mutant_harness.py [--log-dir DIR] [MUTANT ...]\n36|\"\"\"\n37|\n38|import shutil\n39|import subprocess\n40|import sys\n41|import tempfile\n42|import time\n43|from dataclasses import dataclass\n44|from pathlib import Path\n45|\n46|REPO = Path(__file__).resolve().parents[3]\n47|PACKAGE = \"internal/cloneplanning\"\n48|\n49|\n50|@dataclass(frozen=True)\n51|class Mutant:\n52|    name: str\n53|    path: str\n54|    find: str\n55|    replace: str\n56|    count: int\n57|    run: str\n58|    expect: str\n59|    note: str\n60|\n61|\n62|MUTANTS = [\n63|    Mutant(\n64|        name=\"N-select-archive-priority\",\n65|        path=f\"{PACKAGE}/strategy.go\",\n66|        find='''\\tif archive {\\n\\t\\treturn strategyArchive, nil\\n\\t}\\n\\tif continuation {\\n\\t\\treturn strategyContinuation, nil\\n\\t}''',\n67|        replace='''\\tif continuation {\\n\\t\\treturn strategyContinuation, nil\\n\\t}\\n\\tif archive {\\n\\t\\treturn strategyArchive, nil\\n\\t}''',\n68|        count=1,\n69|        run=\"TestSelectStrategyOracle\",\n70|        expect=\"KILLED\",\n71|        note=\"Narrows the priority gate: archive+continuation selects continuation instead of archive.\",\n72|    ),\n73|    Mutant(\n74|        name=\"N-select-official\",\n75|        path=f\"{PACKAGE}/strategy.go\",\n76|        find='''\\tif !sameEnvironment {\\n\\t\\tif officialImport {\\n\\t\\t\\treturn strategyOfficial, nil\\n\\t\\t}\\n\\t\\treturn strategyNativeWriter, nil\\n\\t}\\n\\treturn strategyNativeRewrite, nil''',\n77|        replace='''\\tif officialImport {\\n\\t\\treturn strategyOfficial, nil\\n\\t}\\n\\tif !sameEnvironment {\\n\\t\\treturn strategyNativeWriter, nil\\n\\t}\\n\\treturn strategyNativeRewrite, nil''',\n78|        count=1,\n79|        run=\"TestSelectStrategyOracle\",\n80|        expect=\"KILLED\",\n81|        note=\"Narrows the pair arm: same-environment with the importer selects official import instead of native rewrite.\",\n82|    ),\n83|    Mutant(\n84|        name=\"N-select-profile-archive\",\n85|        path=f\"{PACKAGE}/strategy.go\",\n86|        find='''\\tif requested == profileArchive {\\n\\t\\treturn BranchArchive, requested, nil\\n\\t}''',\n87|        replace='''\\tif requested == profileArchive {\\n\\t\\treturn BranchTarget, requested, nil\\n\\t}''',\n88|        count=1,\n89|        run=\"TestSelectProfileOracle\",\n90|        expect=\"KILLED\",\n91|        note=\"Narrows the branch router: archive_only routes target instead of archive.\",\n92|    ),\n93|    Mutant(\n94|        name=\"N-select-profile-unknown\",\n95|        path=f\"{PACKAGE}/strategy.go\",\n96|        find='''\\tif !cloneplan.ValidPlanProfile(requested) {''',\n97|        replace='''\\tif requested != \"bogus_profile\" && !cloneplan.ValidPlanProfile(requested) {''',\n98|        count=1,\n99|        run=\"TestSelectProfileOracle\",\n100|        expect=\"KILLED\",\n101|        note=\"Narrows the plan-profile gate: admits exactly bogus_profile to the target branch.\",\n102|    ),\n103|    Mutant(\n104|        name=\"N-kind-vocab\",\n105|        path=f\"{PACKAGE}/item.go\",\n106|        find='''\\t\\tif !clonebundle.ValidEventKind(item.Kind) {''',\n107|        replace='''\\t\\tif item.Kind != \"bogus_kind\" && !clonebundle.ValidEventKind(item.Kind) {''',\n108|        count=1,\n109|        run=\"TestSharedItemVocabBothEntries\",\n110|        expect=\"KILLED\",\n111|        note=\"Shared gate: admits exactly bogus_kind through both PlanItem and ClassifyItem.\",\n112|    ),\n113|    Mutant(\n114|        name=\"N-block-vocab\",\n115|        path=f\"{PACKAGE}/item.go\",\n116|        find='''\\t\\tif !clonebundle.ValidContentBlockType(item.Block) {''',\n117|        replace='''\\t\\tif item.Block != \"bogus_block\" && !clonebundle.ValidContentBlockType(item.Block) {''',\n118|        count=1,\n119|        run=\"TestSharedItemVocabBothEntries\",\n120|        expect=\"KILLED\",\n121|        note=\"Shared gate: admits exactly bogus_block through PlanItem (blocks have no event bridge).\",\n122|    ),\n123|    Mutant(\n124|        name=\"N-resolution-vocab\",\n125|        path=f\"{PACKAGE}/item.go\",\n126|        find='''\\tif !validResolution(item.Resolution) {''',\n127|        replace='''\\tif item.Resolution != \"bogus_resolution\" && !validResolution(item.Resolution) {''',\n128|        count=1,\n129|        run=\"TestSharedItemVocabBothEntries\",\n130|        expect=\"KILLED\",\n131|        note=\"Shared gate: admits exactly bogus_resolution through both entries.\",\n132|    ),\n133|    Mutant(\n134|        name=\"N-protection-vocab\",\n135|        path=f\"{PACKAGE}/item.go\",\n136|        find='''\\tif !validProtection(item.Protection) {''',\n137|        replace='''\\tif item.Protection != \"bogus_protection\" && !validProtection(item.Protection) {''',\n138|        count=1,\n139|        run=\"TestSharedItemVocabBothEntries\",\n140|        expect=\"KILLED\",\n141|        note=\"Shared gate: admits exactly bogus_protection through both entries.\",\n142|    ),\n143|    Mutant(\n144|        name=\"N-classify-resolution-required\",\n145|        path=f\"{PACKAGE}/item.go\",\n146|        find='''\\tif toolKinds[item.Kind] {\\n\\t\\tif item.Resolution == \"\" {\\n\\t\\t\\treturn invalid(\"projection item kind %q requires its completed|aborted resolution\", item.Kind)\\n\\t\\t}''',\n147|        replace='''\\tif toolKinds[item.Kind] {\\n\\t\\tif item.Resolution == \"\" && item.Kind != \"tool_call\" {\\n\\t\\t\\treturn invalid(\"projection item kind %q requires its completed|aborted resolution\", item.Kind)\\n\\t\\t}''',\n148|        count=1,\n149|        run=\"TestClassifyItemRefusals\",\n150|        expect=\"KILLED\",\n151|        note=\"Narrows the required-resolution gate: tool_call without resolution admits, tool_result still refuses.\",\n152|    ),\n153|    Mutant(\n154|        name=\"N-classify-protection-required\",\n155|        path=f\"{PACKAGE}/item.go\",\n156|        find='''\\tif item.Kind == \"opaque_reasoning\" {\\n\\t\\tif item.Protection == \"\" {\\n\\t\\t\\treturn invalid(\"projection item kind opaque_reasoning requires its encrypted|signed protection\")\\n\\t\\t}''',\n157|        replace='''\\tif item.Kind == \"opaque_reasoning\" {\\n\\t\\tif item.Protection == \"\" && item.Kind != \"opaque_reasoning\" {\\n\\t\\t\\treturn invalid(\"projection item kind opaque_reasoning requires its encrypted|signed protection\")\\n\\t\\t}''',\n158|        count=1,\n159|        run=\"TestClassifyItemRefusals\",\n160|        expect=\"KILLED\",\n161|        note=\"Single-member-class narrowing: the gate whose reject class is exactly opaque_reasoning-without-protection admits it.\",\n162|    ),\n163|    Mutant(\n164|        name=\"N-classify-fact-type\",\n165|        path=f\"{PACKAGE}/item.go\",\n166|        find='''\\tvalue, ok := raw.(string)\\n\\tif !ok {\\n\\t\\treturn \"\", invalid(\"projection item fact %q is not a string\", name)\\n\\t}\\n\\treturn value, nil''',\n167|        replace='''\\tif _, isInt := raw.(int64); isInt {\\n\\t\\treturn \"\", nil\\n\\t}\\n\\tvalue, ok := raw.(string)\\n\\tif !ok {\\n\\t\\treturn \"\", invalid(\"projection item fact %q is not a string\", name)\\n\\t}\\n\\treturn value, nil''',\n168|        count=1,\n169|        run=\"TestClassifyItemRefusals\",\n170|        expect=\"KILLED\",\n171|        note=\"Narrows the fact-type gate: admits exactly int64-typed facts as absent (the landed decoder renders numbers int64); bool and object facts still refuse.\",\n172|    ),\n173|    Mutant(\n174|        name=\"N-strategy-vocab\",\n175|        path=f\"{PACKAGE}/plan.go\",\n176|        find='''\\tif !clonefidelity.ValidStrategy(strategy) {''',\n177|        replace='''\\tif strategy != \"bogus_strategy\" && !clonefidelity.ValidStrategy(strategy) {''',\n178|        count=1,\n179|        run=\"TestPlanItemInvalidArms\",\n180|        expect=\"KILLED\",\n181|        note=\"Narrows the strategy vocabulary delegation: admits exactly bogus_strategy.\",\n182|    ),\n183|    Mutant(\n184|        name=\"N-profile-vocab\",\n185|        path=f\"{PACKAGE}/plan.go\",\n186|        find='''\\tcase profileMaximalSafe:\\n\\t\\treturn disposition, reasons, nil\\n\\tdefault:\\n\\t\\treturn \"\", nil, invalid(\"projection profile %q is not a target plan profile\", profile)''',\n187|        replace='''\\tcase profileMaximalSafe:\\n\\t\\treturn disposition, reasons, nil\\n\\tcase \"bogus_profile\":\\n\\t\\treturn disposition, reasons, nil\\n\\tdefault:\\n\\t\\treturn \"\", nil, invalid(\"projection profile %q is not a target plan profile\", profile)''',\n188|        count=1,\n189|        run=\"TestPlanItemInvalidArms\",\n190|        expect=\"KILLED\",\n191|        note=\"Narrows the profile overlay default: admits exactly bogus_profile as a pass-through.\",\n192|    ),\n193|    Mutant(\n194|        name=\"N-archive-strategy\",\n195|        path=f\"{PACKAGE}/plan.go\",\n196|        find='''\\tif strategy == strategyArchive || profile == profileArchive {''',\n197|        replace='''\\tif !(strategy == strategyArchive && profile == profileMaximalSafe) && (strategy == strategyArchive || profile == profileArchive) {''',\n198|        count=1,\n199|        run=\"TestPlanItemArchiveRule\",\n200|        expect=\"KILLED\",\n201|        note=\"Narrows the archive gate: admits exactly the archive_only/maximal_safe cell.\",\n202|    ),\n203|    Mutant(\n204|        name=\"N-archive-profile\",\n205|        path=f\"{PACKAGE}/plan.go\",\n206|        find='''\\tif strategy == strategyArchive || profile == profileArchive {''',\n207|        replace='''\\tif !(strategy == strategyNativeWriter && profile == profileArchive) && (strategy == strategyArchive || profile == profileArchive) {''',\n208|        count=1,\n209|        run=\"TestPlanItemArchiveRule\",\n210|        expect=\"KILLED\",\n211|        note=\"Narrows the archive gate: exempts exactly the writer/archive cell from the archive-branch refusal (it then refuses via the overlay default, which names no archive branch).\",\n212|    ),\n213|    Mutant(\n214|        name=\"N-opaque-reason\",\n215|        path=f\"{PACKAGE}/plan.go\",\n216|        find='''\\t\\tif item.Protection == protectionSigned {\\n\\t\\t\\treturn dispositionOpaquePreserved, []string{reasonForeignSigned}\\n\\t\\t}''',\n217|        replace='''\\t\\tif item.Protection == protectionSigned {\\n\\t\\t\\treturn dispositionOpaquePreserved, []string{reasonForeignEncrypted}\\n\\t\\t}''',\n218|        count=1,\n219|        run=\"TestPlanItemOpaqueRule\",\n220|        expect=\"KILLED\",\n221|        note=\"Narrows the opaque-reason mapping: signed reasoning reports the encrypted reason; the encrypted arm is intact.\",\n222|    ),\n223|    Mutant(\n224|        name=\"N-opaque-event-reason\",\n225|        path=f\"{PACKAGE}/plan.go\",\n226|        find='''\\tif item.Kind == \"opaque_event\" || item.Block == \"opaque\" {\\n\\t\\treturn dispositionOpaquePreserved, []string{reasonUnknownNative}\\n\\t}''',\n227|        replace='''\\tif item.Kind == \"opaque_event\" && item.Protection == \"\" {\\n\\t\\treturn dispositionOpaquePreserved, []string{reasonForeignEncrypted}\\n\\t}\\n\\tif item.Kind == \"opaque_event\" || item.Block == \"opaque\" {\\n\\t\\treturn dispositionOpaquePreserved, []string{reasonUnknownNative}\\n\\t}''',\n228|        count=1,\n229|        run=\"TestPlanItemOpaqueRule\",\n230|        expect=\"KILLED\",\n231|        note=\"Narrows the opaque-event mapping: the unprotected opaque_event item reports the encrypted reason.\",\n232|    ),\n233|    Mutant(\n234|        name=\"N-abort-drop\",\n235|        path=f\"{PACKAGE}/plan.go\",\n236|        find='''\\tif (item.Kind == \"tool_call\" || item.Kind == \"tool_result\") && item.Resolution == cloneproject.StatusAborted {''',\n237|        replace='''\\tif (item.Kind == \"tool_result\") && item.Resolution == cloneproject.StatusAborted {''',\n238|        count=1,\n239|        run=\"TestPlanItemAbortRule\",\n240|        expect=\"KILLED\",\n241|        note=\"Narrows the abort arm: aborted tool_call falls to the strategy default; aborted tool_result is intact.\",\n242|    ),\n243|    Mutant(\n244|        name=\"N-abort-reason\",\n245|        path=f\"{PACKAGE}/plan.go\",\n246|        find='''\\t\\treturn dispositionSummarized, []string{reasonUnsafePending}''',\n247|        replace='''\\t\\treturn dispositionSummarized, nil''',\n248|        count=1,\n249|        run=\"TestPlanItemAbortRule\",\n250|        expect=\"KILLED\",\n251|        note=\"Narrows the abort mapping: aborted history without its unsafe_pending_action reason.\",\n252|    ),\n253|    Mutant(\n254|        name=\"N-continuation-exact\",\n255|        path=f\"{PACKAGE}/plan.go\",\n256|        find='''\\tif strategy == strategyContinuation {\\n\\t\\treturn dispositionSemantic, []string{reasonTargetNoEquivalent}\\n\\t}''',\n257|        replace='''\\tif strategy == strategyContinuation && item.Kind != \"usage\" {\\n\\t\\treturn dispositionSemantic, []string{reasonTargetNoEquivalent}\\n\\t}''',\n258|        count=1,\n259|        run=\"TestPlanItemContinuationRule\",\n260|        expect=\"KILLED\",\n261|        note=\"Narrows the continuation clamp: usage plans exact under continuation_context.\",\n262|    ),\n263|    Mutant(\n264|        name=\"N-continuation-reason\",\n265|        path=f\"{PACKAGE}/plan.go\",\n266|        find='''\\t\\treturn dispositionSemantic, []string{reasonTargetNoEquivalent}''',\n267|        replace='''\\t\\treturn dispositionSemantic, nil''',\n268|        count=1,\n269|        run=\"TestPlanItemContinuationRule\",\n270|        expect=\"KILLED\",\n271|        note=\"Narrows the continuation mapping: semantic without its target_no_equivalent reason.\",\n272|    ),\n273|    Mutant(\n274|        name=\"N-importer-tool\",\n275|        path=f\"{PACKAGE}/plan.go\",\n276|        find='''\\t\\tif completeToolKinds[item.Kind] {\\n\\t\\t\\treturn dispositionSemantic, []string{reasonOfficialImporterLoss}\\n\\t\\t}''',\n277|        replace='''\\t\\tif completeToolKinds[item.Kind] && item.Kind != \"tool_definition_snapshot\" {\\n\\t\\t\\treturn dispositionSemantic, []string{reasonOfficialImporterLoss}\\n\\t\\t}''',\n278|        count=1,\n279|        run=\"TestPlanItemImporterRule\",\n280|        expect=\"KILLED\",\n281|        note=\"Narrows the importer tool arm: tool_definition_snapshot plans exact under official import.\",\n282|    ),\n283|    Mutant(\n284|        name=\"N-importer-graph\",\n285|        path=f\"{PACKAGE}/plan.go\",\n286|        find='''\\t\\tif subagentKinds[item.Kind] {\\n\\t\\t\\treturn dispositionSemantic, []string{reasonGraphFlattened}\\n\\t\\t}''',\n287|        replace='''\\t\\tif subagentKinds[item.Kind] && item.Kind != \"subagent_completed\" {\\n\\t\\t\\treturn dispositionSemantic, []string{reasonGraphFlattened}\\n\\t\\t}''',\n288|        count=1,\n289|        run=\"TestPlanItemImporterRule\",\n290|        expect=\"KILLED\",\n291|        note=\"Narrows the importer graph arm: subagent_completed plans exact under official import.\",\n292|    ),\n293|    Mutant(\n294|        name=\"N-strict-admit\",\n295|        path=f\"{PACKAGE}/plan.go\",\n296|        find='''\\tcase profileStrictExact:\\n\\t\\tif disposition != dispositionExact {''',\n297|        replace='''\\tcase profileStrictExact:\\n\\t\\tif disposition != dispositionExact && disposition != dispositionSemantic {''',\n298|        count=1,\n299|        run=\"TestPlanItemStrictRule\",\n300|        expect=\"KILLED\",\n301|        note=\"Narrows the strict gate: admits exactly semantic alongside exact.\",\n302|    ),\n303|    Mutant(\n304|        name=\"N-compact-skip\",\n305|        path=f\"{PACKAGE}/plan.go\",\n306|        find='''\\tcase profileCompact:\\n\\t\\tif disposition == dispositionSemantic {''',\n307|        replace='''\\tcase profileCompact:\\n\\t\\tif disposition == dispositionSemantic && item.Kind != \"usage\" {''',\n308|        count=1,\n309|        run=\"TestPlanItemCompactRule\",\n310|        expect=\"KILLED\",\n311|        note=\"Narrows the compact clamp: usage keeps semantic under compact.\",\n312|    ),\n313|    Mutant(\n314|        name=\"N-compact-reason\",\n315|        path=f\"{PACKAGE}/plan.go\",\n316|        find='''\\t\\t\\treturn dispositionSummarized, append(append([]string(nil), reasons...), reasonTargetContextLimit), nil''',\n317|        replace='''\\t\\t\\treturn dispositionSummarized, append([]string(nil), reasons...), nil''',\n318|        count=1,\n319|        run=\"TestPlanItemCompactRule\",\n320|        expect=\"KILLED\",\n321|        note=\"Narrows the compact clamp: summarized without the appended target_context_limit reason.\",\n322|    ),\n323|    Mutant(\n324|        name=\"N-messages-admit\",\n325|        path=f\"{PACKAGE}/plan.go\",\n326|        find='''\\tcase profileMessages:\\n\\t\\tif isMessageClass(item) {''',\n327|        replace='''\\tcase profileMessages:\\n\\t\\tif isMessageClass(item) || item.Kind == \"usage\" {''',\n328|        count=1,\n329|        run=\"TestPlanItemMessagesRule\",\n330|        expect=\"KILLED\",\n331|        note=\"Narrows the messages_only survivor set: usage survives alongside message classes.\",\n332|    ),\n333|    Mutant(\n334|        name=\"N-messages-reason\",\n335|        path=f\"{PACKAGE}/plan.go\",\n336|        find='''\\t\\tomitted := append(append([]string(nil), reasons...), reasonOperatorPolicy)''',\n337|        replace='''\\t\\tomitted := append([]string(nil), reasons...)''',\n338|        count=1,\n339|        run=\"TestPlanItemMessagesRule\",\n340|        expect=\"KILLED\",\n341|        note=\"Narrows the messages_only overlay: omitted without the operator_policy reason.\",\n342|    ),\n343|    Mutant(\n344|        name=\"N-media-reason\",\n345|        path=f\"{PACKAGE}/plan.go\",\n346|        find='''\\t\\tif mediaBlocks[item.Block] {\\n\\t\\t\\tomitted = append(omitted, reasonUnsupportedMedia)\\n\\t\\t}''',\n347|        replace='''\\t\\tif mediaBlocks[item.Block] && item.Block != \"image\" {\\n\\t\\t\\tomitted = append(omitted, reasonUnsupportedMedia)\\n\\t\\t}''',\n348|        count=1,\n349|        run=\"TestPlanItemMessagesRule\",\n350|        expect=\"KILLED\",\n351|        note=\"Narrows the media overlay: image blocks omit without the unsupported_media_type reason.\",\n352|    ),\n353|    Mutant(\n354|        name=\"N-reason-order\",\n355|        path=f\"{PACKAGE}/plan.go\",\n356|        find='''\\tsorted := append([]string(nil), reasons...)\\n\\tsort.Strings(sorted)''',\n357|        replace='''\\tsorted := append([]string(nil), reasons...)\\n\\t_ = sort.Strings''',\n358|        count=1,\n359|        run=\"TestPlanItemMessagesRule\",\n360|        expect=\"KILLED\",\n361|        note=\"Narrows the reason emission: insertion order instead of sorted (the aborted+messages cell proves the order).\",\n362|    ),\n363|    Mutant(\n364|        name=\"N-session-empty\",\n365|        path=f\"{PACKAGE}/plan.go\",\n366|        find='''\\tif len(items) == 0 || len(items) > maxSessionItems {''',\n367|        replace='''\\tif len(items) > maxSessionItems {''',\n368|        count=1,\n369|        run=\"TestPlanSessionRefusals\",\n370|        expect=\"KILLED\",\n371|        note=\"Narrows the session bound: admits exactly the empty session.\",\n372|    ),\n373|    Mutant(\n374|        name=\"N-session-bound\",\n375|        path=f\"{PACKAGE}/plan.go\",\n376|        find='''\\tif len(items) == 0 || len(items) > maxSessionItems {''',\n377|        replace='''\\tif len(items) == 0 || len(items) > maxSessionItems+1 {''',\n378|        count=1,\n379|        run=\"TestPlanSessionRefusals\",\n380|        expect=\"KILLED\",\n381|        note=\"Narrows the session bound: admits exactly 1000001 items.\",\n382|    ),\n383|    Mutant(\n384|        name=\"N-count-swap\",\n385|        path=f\"{PACKAGE}/plan.go\",\n386|        find='''\\t\\tcase dispositionExact:\\n\\t\\t\\tcounts.Exact++''',\n387|        replace='''\\t\\tcase dispositionExact:\\n\\t\\t\\tcounts.Semantic++''',\n388|        count=1,\n389|        run=\"TestPlanSessionCounts\",\n390|        expect=\"KILLED\",\n391|        note=\"Narrows the count fold: exact mappings fund the semantic counter.\",\n392|    ),\n393|    Mutant(\n394|        name=\"N-effects-disposition\",\n395|        path=f\"{PACKAGE}/effects.go\",\n396|        find='''\\t\\tif !clonefidelity.ValidDisposition(mapping.Disposition) {''',\n397|        replace='''\\t\\tif mapping.Disposition != \"bogus_disposition\" && !clonefidelity.ValidDisposition(mapping.Disposition) {''',\n398|        count=1,\n399|        run=\"TestPlanTargetEffectsRefusals\",\n400|        expect=\"KILLED\",\n401|        note=\"Narrows the effects disposition gate: admits exactly bogus_disposition.\",\n402|    ),\n403|    Mutant(\n404|        name=\"N-effects-reason\",\n405|        path=f\"{PACKAGE}/effects.go\",\n406|        find='''\\t\\t\\tif !clonefidelity.ValidReasonCode(reason) {''',\n407|        replace='''\\t\\t\\tif reason != \"bogus_reason\" && !clonefidelity.ValidReasonCode(reason) {''',\n408|        count=1,\n409|        run=\"TestPlanTargetEffectsRefusals\",\n410|        expect=\"KILLED\",\n411|        note=\"Narrows the effects reason gate: admits exactly bogus_reason.\",\n412|    ),\n413|    Mutant(\n414|        name=\"N-effects-order-skip\",\n415|        path=f\"{PACKAGE}/effects.go\",\n416|        find='''\\t\\t\\tif mapping.Reasons[position-1] >= mapping.Reasons[position] {''',\n417|        replace='''\\t\\t\\tif mapping.Reasons[position-1] >= mapping.Reasons[position] && mapping.Reasons[position-1] != \"unsafe_pending_action\" {''',\n418|        count=1,\n419|        run=\"TestPlanTargetEffectsRefusals\",\n420|        expect=\"KILLED\",\n421|        note=\"Narrows the effects order gate: admits exactly unsorted pairs led by unsafe_pending_action.\",\n422|    ),\n423|    Mutant(\n424|        name=\"N-effects-nonzero\",\n425|        path=f\"{PACKAGE}/effects.go\",\n426|        find='''\\t\\t}\\n\\t}\\n\\treturn TargetEffects{}, nil\\n}''',\n427|        replace='''\\t\\t}\\n\\t}\\n\\teffects := TargetEffects{}\\n\\tfor _, mapping := range mappings {\\n\\t\\tif mapping.Disposition == dispositionExact {\\n\\t\\t\\teffects.TargetInputTokens = 1\\n\\t\\t}\\n\\t}\\n\\treturn effects, nil\\n}''',\n428|        count=1,\n429|        run=\"TestPlanTargetEffectsZeroSweep\",\n430|        expect=\"KILLED\",\n431|        note=\"Narrows the zero fold: exact mappings fund one target input token.\",\n432|    ),\n433|    Mutant(\n434|        name=\"N-visible-kind\",\n435|        path=f\"{PACKAGE}/visible.go\",\n436|        find='''\\tif !clonebundle.ValidEventKind(input.Kind) {''',\n437|        replace='''\\tif input.Kind != \"bogus_kind\" && !clonebundle.ValidEventKind(input.Kind) {''',\n438|        count=1,\n439|        run=\"TestProjectVisibleKindRefusals\",\n440|        expect=\"KILLED\",\n441|        note=\"Narrows the visible kind gate: admits exactly bogus_kind.\",\n442|    ),\n443|    Mutant(\n444|        name=\"N-visible-ordinal\",\n445|        path=f\"{PACKAGE}/visible.go\",\n446|        find='''\\tif _, err := scalar.NewUint53(input.Ordinal); err != nil {\\n\\t\\treturn VisibleProjection{}, invalid(\"visible projection ordinal %d is not a uint53: %v\", input.Ordinal, err)\\n\\t}''',\n447|        replace='''\\tif input.Ordinal != 9007199254740992 {\\n\\t\\tif _, err := scalar.NewUint53(input.Ordinal); err != nil {\\n\\t\\t\\treturn VisibleProjection{}, invalid(\"visible projection ordinal %d is not a uint53: %v\", input.Ordinal, err)\\n\\t\\t}\\n\\t}''',\n448|        count=1,\n449|        run=\"TestProjectVisibleOrdinalEdges\",\n450|        expect=\"KILLED\",\n451|        note=\"Narrows the ordinal gate: admits exactly 9007199254740992.\",\n452|    ),\n453|    Mutant(\n454|        name=\"N-visible-utf8\",\n455|        path=f\"{PACKAGE}/visible.go\",\n456|        find='''\\tfor index, field := range input.Texts {\\n\\t\\tif !utf8.ValidString(field) {''',\n457|        replace='''\\tfor index, field := range input.Texts {\\n\\t\\tif !utf8.ValidString(field) && index != 1 {''',\n458|        count=1,\n459|        run=\"TestProjectVisibleTextRefusals\",\n460|        expect=\"KILLED\",\n461|        note=\"Narrows the UTF-8 gate: skips exactly field[1].\",\n462|    ),\n463|    Mutant(\n464|        name=\"N-visible-max\",\n465|        path=f\"{PACKAGE}/visible.go\",\n466|        find='''\\tif length := environ.StringLength(joined); length < 1 || length > maxEscapedText {''',\n467|        replace='''\\tif length := environ.StringLength(joined); length < 1 || length > maxEscapedText+1 {''',\n468|        count=1,\n469|        run=\"TestProjectVisibleBounds\",\n470|        expect=\"KILLED\",\n471|        note=\"Narrows the escaped_text bound: admits exactly 65537 characters.\",\n472|    ),\n473|    Mutant(\n474|        name=\"N-visible-empty\",\n475|        path=f\"{PACKAGE}/visible.go\",\n476|        find='''\\tif length := environ.StringLength(joined); length < 1 || length > maxEscapedText {''',\n477|        replace='''\\tif length := environ.StringLength(joined); length < 0 || length > maxEscapedText {''',\n478|        count=1,\n479|        run=\"TestProjectVisibleBounds\",\n480|        expect=\"KILLED\",\n481|        note=\"Narrows the escaped_text bound: admits exactly the empty text.\",\n482|    ),\n483|    Mutant(\n484|        name=\"N-visible-ids-count0\",\n485|        path=f\"{PACKAGE}/visible.go\",\n486|        find='''\\tif len(ids) < 1 || len(ids) > maxVisibleEventIDs {''',\n487|        replace='''\\tif len(ids) > maxVisibleEventIDs {''',\n488|        count=1,\n489|        run=\"TestProjectVisibleEventIDGrid\",\n490|        expect=\"KILLED\",\n491|        note=\"Narrows the event-ID count gate: admits exactly zero IDs.\",\n492|    ),\n493|    Mutant(\n494|        name=\"N-visible-ids-count65\",\n495|        path=f\"{PACKAGE}/visible.go\",\n496|        find='''\\tif len(ids) < 1 || len(ids) > maxVisibleEventIDs {''',\n497|        replace='''\\tif len(ids) < 1 || len(ids) > maxVisibleEventIDs+1 {''',\n498|        count=1,\n499|        run=\"TestProjectVisibleEventIDGrid\",\n500|        expect=\"KILLED\",\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c663","stream":{"kind":"session","id":"01a0d2c4-4f2b-7620-b603-17ce30f31e40"},"sequence":396,"recorded_at":1780531400000787,"record_type":"event","durability":"durable","causation_id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23","run_stream":{"kind":"run","id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23"},"task_stream":{"kind":"task","id":"01a0d2c5-21ba-7a73-aba3-12ec8e98ed96"},"task_id":"01a0d2c5-21ba-7a73-aba3-12ec8e98ed96","event":{"kind":"completed","task_id":"01a0d2c5-21ba-7a73-aba3-12ec8e98ed96"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c665","stream":{"kind":"session","id":"01a0d2c4-4f2b-7620-b603-17ce30f31e40"},"sequence":397,"recorded_at":1780531400000789,"record_type":"event","durability":"durable","causation_id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23","run_stream":{"kind":"run","id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23"},"call_id":"call_01a0d2c51c31760186daea522e9271f4","text":"Read text file `internal/cloneplanning/TRACEABILITY.md`.\n1|# internal/cloneplanning TRACEABILITY\n2|\n3|Planning semantics for the pair-neutral target projection:\n4|strategy/profile selection, per-item expected dispositions with\n5|reason sets, checkpoint visible-text authority, historical-tool\n6|inertness, and source/target usage separation. Pinned authority is\n7|`internal/specdoc/SPEC.v0.7.0.md`; every rule below quotes it.\n8|Rules marked spec-forced derive from a quoted sentence; rules\n9|marked leaf-pinned record a design decision the specification\n10|leaves open, with the quoted name or sentence that shapes it. A\n11|leaf-pinned rule is still fully measured (whole-domain oracle cell\n12|plus narrowing mutant); the label records provenance honestly,\n13|not a waiver.\n14|\n15|## Derivation\n16|\n17|- R-ARCH (spec-forced; plan table 10663-10665, adapter contract\n18|  3841 \"archive_only is forbidden\", 10629-10631 \"therefore\n19|  targetless\"). The archive strategy or profile refuses target\n20|  planning; SelectProfile routes archive_only to the archive\n21|  branch. Entries: PlanItem, PlanSession (propagation),\n22|  SelectProfile.\n23|- R-OPAQUE-R (spec-forced; 10392 \"foreign encrypted/signed\n24|  reasoning is opaque-preserved\"; 10552-10553 the two foreign\n25|  reasons). opaque_reasoning plans opaque_preserved with\n26|  foreign_encrypted_payload (encrypted) or\n27|  foreign_signature_unverifiable (signed). Entry: PlanItem.\n28|- R-OPAQUE-E (spec-derived; 10390 \"Unknown native records become\n29|  raw-addressable opaque events\"; 10561 unknown_native_event).\n30|  opaque_event plans opaque_preserved with unknown_native_event\n31|  under any admitted protection. Opaque content blocks inherit the\n32|  unknown-content cause (leaf-pinned: blocks carry no protection\n33|  fact). Entry: PlanItem.\n34|- R-ABORT (spec-forced; 10391 \"incomplete calls become aborted\n35|  history\"; 10558 unsafe_pending_action; the G1 fold in\n36|  internal/cloneproject lands the completed/aborted fact consumed\n37|  here). Aborted tool_call/tool_result plan summarized (history\n38|  preserved, never omitted; non-exact, never executable) with\n39|  unsafe_pending_action. Entries: PlanItem, ClassifyItem (fact\n40|  bridge).\n41|- R-CONT (spec-derived; 10565 \"Continuation context is explicitly\n42|  non-native historical fidelity\"). Under continuation_context,\n43|  would-be-exact plans semantic with target_no_equivalent; exact\n44|  never emits. Entry: PlanItem.\n45|- R-IMPORT-TOOL (spec-derived; 10557 official_importer_loss; 3888\n46|  the official_import capability). Under target_official_import,\n47|  complete tool classes (tool_call/tool_result completed,\n48|  tool_definition_snapshot) plan semantic with\n49|  official_importer_loss. Entry: PlanItem.\n50|- R-IMPORT-GRAPH (spec-derived; 10558 graph_flattened). Under\n51|  target_official_import, subagent_started/subagent_completed plan\n52|  semantic with graph_flattened. Entry: PlanItem.\n53|- R-STRICT (leaf-pinned from the profile name with 10560 \"An\n54|  aggregate score cannot replace item gates\" and AC-CLONE-001\n55|  item-level fidelity). strict_exact refuses every non-exact item.\n56|  Entries: PlanItem, PlanSession (propagation).\n57|- R-COMPACT (leaf-pinned from the profile name with 10555\n58|  target_context_limit). compact clamps semantic to summarized,\n59|  keeping and extending the reason set. Entry: PlanItem.\n60|- R-MSG (leaf-pinned from the profile name with 10560\n61|  operator_policy and unsupported_media_type). messages_only keeps\n62|  user/assistant message events and text/json/redacted blocks;\n63|  every other class omits, keeping and extending the reason set\n64|  with operator_policy, plus unsupported_media_type for media\n65|  blocks. Entry: PlanItem.\n66|- R-DEFAULT (leaf-pinned). Native strategies reproduce bytes:\n67|  every cell no rule above decides plans exact with no reason.\n68|  Entry: PlanItem.\n69|- R-NEVER (spec-derived; 10605 the synthesized coupling;\n70|  R-OPAQUE-E). The planner never emits synthesized (no source\n71|  object) or unrecoverable (planned canonical items exist).\n72|  Entries: PlanItem, PlanSession.\n73|- R-AUTH (spec-forced; 10586-10587; 10808-10812\n74|  \"authority=user_context\", \"never an assistant reply, system\n75|  instruction, or authorization\", \"Visible text comes from typed\n76|  escaped fields and is user context, never an assistant reply or\n77|  control instruction\"). Visible authority is the user_context\n78|  constant; every text field escapes per field and joins; escaped\n79|  output round-trips through encoding/json to exactly the input.\n80|  Entries: ProjectVisibleText, EscapeVisibleText.\n81|- R-INERT (spec-forced; 10391 \"Historical tools are inert\";\n82|  internal/cloneproject lands the empty G1 live surface consumed\n83|  here). Planned mappings fold to zero callable tools and zero\n84|  pending actions. Entry: PlanTargetEffects.\n85|- R-ACCT (spec-forced; 10393 \"source usage is not target\n86|  accounting\"; internal/cloneproject lands the zero-target G1\n87|  ledger consumed here). Planned mappings fold to zero target\n88|  token accounting; mappings carry no token field by type, so\n89|  counts cannot reach the decision. Entry: PlanTargetEffects.\n90|- R-SEL-S (leaf-pinned from the strategy names with 3888 the\n91|  official_import capability). SelectStrategy priority: archive,\n92|  then continuation, then the pair/capability arm (cross pair with\n93|  the importer uses target_official_import, cross pair without it\n94|  uses target_native_writer, same pair uses\n95|  same_environment_native_rewrite). Entry: SelectStrategy.\n96|- R-SEL-P (spec-derived; plan table 10663-10665; R-ARCH).\n97|  SelectProfile routes archive_only to the archive branch and the\n98|  four plan profiles to target; anything else refuses. Target\n99|  admission stays with clonesnap.AdmitForTarget (composition row\n100|  in the conformance matrix). Entry: SelectProfile.\n101|\n102|## Axis inventory\n103|\n104|- Strategy: the 5 owner strategies (clonefidelity.Strategies)\n105|  plus invalid probes (\"\", case variant, truncation, unknown,\n106|  invalid UTF-8).\n107|- Profile: the 5 owner profiles (clonefidelity.Profiles) plus\n108|  invalid probes of the same classes.\n109|- SelectStrategy signals: same x official x continuation x\n110|  archive booleans, all 16 cells.\n111|- Item: 26 event kinds x admitted facts (tool_call/tool_result x\n112|  completed/aborted; opaque_reasoning x encrypted/signed;\n113|  opaque_event x none/encrypted/signed; 22 factless kinds) = 31\n114|  event items; 8 content-block types = 8 block items; 39 total.\n115|  Invalid arms: kind+block both/neither, unknown kind/block,\n116|  misplaced or missing facts, unknown fact values, blocks with\n117|  facts (15 classes x all 25 strategy/profile contexts, with\n118|  archive-first order pinning).\n119|- PlanItem oracle: 5 strategies x 5 profiles x 39 items = 975\n120|  cells, every cell literal-asserted (disposition, exact reason\n121|  list, or refusal token). Global asserts per admitted cell:\n122|  never synthesized/unrecoverable; exact iff empty reasons;\n123|  non-exact carries a reason; reasons core and sorted unique.\n124|- Visible: kind (26 + 5 invalid probes) x ordinal (0, 1, uint53\n125|  max admitted; max+1 and 2^64-1 refused) x field position\n126|  (adversarial at index 0/1/2 of 3 fields) x text class\n127|  (benign/instruction-like/reply-like/control-token-like/\n128|  authorization-like, 29 fixed members) = 6786 cells plus 200\n129|  generated-corpus cells; per cell the authority literal and the\n130|  independent JSON round-trip. Escaped-text bounds at 65536/65537\n131|  characters with a byte/char discriminator; invalid UTF-8 at\n132|  every field position; event-ID grid (counts 0/1/2/64/65,\n133|  unsorted/duplicated, malformed at every index).\n134|- Text payloads are unbounded: the fixed corpus pairs with a\n135|  200-string fixed-seed generated corpus (seed 260924, mixed\n136|  alphabet, lengths 0..64) and the structural argument\n137|  (authority is one constant assigned unconditionally, pinned by\n138|  TestAuthorityDecisionShape with control plants; escaping\n139|  round-trips through encoding/json; classification admits\n140|  closed vocabularies only and the sweep proves adversarial\n141|  payload text cannot change the item).\n142|- Sessions: empty/1M/1M+1 edges at the production entry, counts\n143|  derived and reconciled per session, strict propagation.\n144|- Effects: all 556 admitted whole-domain mappings fold to zero\n145|  in one sweep plus per-disposition cells; invalid mappings\n146|  (disposition, reason, order arms) refuse.\n147|\n148|## Reuse (not fork)\n149|\n150|Strategy/profile/disposition/reason vocabularies:\n151|internal/clonefidelity (membership) and internal/cloneplan (plan\n152|narrowing). Event kinds and content blocks: internal/clonebundle.\n153|Canonical events for the classifier: sealed by\n154|clonebundle.BuildCanonicalEvent. Target admission (unstable\n155|refusal, maximal-safe completeness): clonesnap.AdmitForTarget and\n156|the clonebundle G2 gates (caller scope; composition row).\n157|Completed/aborted spellings: cloneproject.StatusCompleted/\n158|StatusAborted by reference; resolution/protection fact names and\n159|encrypted/signed spellings pinned against cloneproject source by\n160|TestClassifyItemFactNamePin. Character measure: environ.\n161|StringLength. uint53: scalar.NewUint53. Digests:\n162|scalar.ParseDigest. Predicted counts: clonefidelity.\n163|FidelityCounts. Nothing above is re-implemented here.\n164|\n165|## Stated bounds (not waived)\n166|\n167|- Target operation synthesis from dispositions: the planner emits\n168|  per-item mappings; deriving write_blob/write_native_record\n169|  operations and expected resources from them is unpinned by the\n170|  specification and stays future scope.\n171|- Source-condition reasons (source_not_persisted,\n172|  source_truncated, source_corrupt) and the remaining\n173|  target-condition and policy reasons (target_schema_constraint,\n174|  target_size_limit, target_version_gate, credential_excluded,\n175|  secret_policy, derived_index_rebuilt): no rule emits them\n176|  because the item axis carries no source/target condition\n177|  input. The oracle asserts every emitted reason is core and the\n178|  never-emit sweep names the dispositions; a condition-carrying\n179|  item extension would add arms here.\n180|- Capability-gated degradation beyond the tool and subagent\n181|  importer classes (usage_history, compaction_history,\n182|  opaque_reasoning_roundtrip granularities): adapter scope; the\n183|  planner degrades exactly the tool and subagent classes under\n184|  target_official_import.\n185|- Per-kind text-field extraction: the visible entry takes\n186|  extracted typed texts; which payload member each kind carries\n187|  as text follows the sibling payload registry.\n188|- The full Migration Checkpoint Build/Decode shape: a future leaf\n189|  seals it from the authority value pinned here\n190|  (authority=user_context, escaped text, sorted event IDs).\n191|- Cross-package payload fact-name renames past the grep pin:\n192|  TestClassifyItemFactNamePin breaks loudly on a rename of the\n193|  resolution/protection keys or protection spellings in\n194|  internal/cloneproject; the completed/aborted spellings break\n195|  the build by reference.\n196|\n197|## Out of contract\n198|\n199|- Shapes (Projection Plan, Projected Object Manifest, Fidelity\n200|  Report, capture/canonical contracts): sibling leaves\n201|  internal/cloneplan, internal/clonefidelity,\n202|  internal/clonebundle. This leaf decides values that populate\n203|  those shapes and never validates them.\n204|- G1 normalization (capture, folds, live surface, ledgers):\n205|  internal/clonesnap, internal/cloneproject. This leaf consumes\n206|  their folded facts.\n207|- Target-branch admission: clonesnap.AdmitForTarget. This leaf\n208|  routes the branch; the caller admits the manifest.\n209|- Transaction, lineage, read-back, validation (13.14.3-13.14.5):\n210|  sibling/future scope.\n211|\n212|## Composition\n213|\n214|The (package, entry, input) importer outcome grid rides the\n215|conformance matrix resource. Base is the story checkpoint tree;\n216|the candidate adds internal/cloneplanning/* only (no landed file\n217|edited, no registry edit). Every reused owner package is\n218|byte-identical base vs candidate with green suites on both, so no\n219|input class moved; the new entries are n/a on base and green on\n220|the candidate.","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c667","stream":{"kind":"session","id":"01a0d2c4-4f2b-7620-b603-17ce30f31e40"},"sequence":398,"recorded_at":1780531400000791,"record_type":"event","durability":"durable","causation_id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23","run_stream":{"kind":"run","id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23"},"call_id":"call_01a0d2c51d0670a1b30138ddbfd52a8c","text":"Read text file `internal/cloneplanning/structural_test.go`.\n1|package cloneplanning\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"testing\"\n8|)\n9|\n10|// This file pins the authority-by-type shape structurally: in\n11|// ProjectVisibleText the Authority field is assigned exactly once,\n12|// unconditionally, from the authorityUserContext constant (or the\n13|// literal \"user_context\" it quotes). No branch on text, kind,\n14|// ordinal, or event IDs can reach the authority decision, because\n15|// no branch reaches it at all. Control plants (a conditional\n16|// authority, a foreign literal) redden this test; logs ride the\n17|// evidence tar.\n18|\n19|// authorityShape describes the Authority assignments found in\n20|// ProjectVisibleText.\n21|type authorityShape struct {\n22|\tassignments int\n23|\tconditional int\n24|\tforeign     int\n25|}\n26|\n27|func inspectAuthorityShape(t *testing.T, path string) authorityShape {\n28|\tt.Helper()\n29|\tfset := token.NewFileSet()\n30|\tfile, err := parser.ParseFile(fset, path, nil, 0)\n31|\tif err != nil {\n32|\t\tt.Fatalf(\"parse %s: %v\", path, err)\n33|\t}\n34|\tvar shape authorityShape\n35|\tfor _, decl := range file.Decls {\n36|\t\tfn, ok := decl.(*ast.FuncDecl)\n37|\t\tif !ok || fn.Name.Name != \"ProjectVisibleText\" {\n38|\t\t\tcontinue\n39|\t\t}\n40|\t\tast.Inspect(fn.Body, func(node ast.Node) bool {\n41|\t\t\tswitch stmt := node.(type) {\n42|\t\t\tcase *ast.IfStmt, *ast.SwitchStmt, *ast.TypeSwitchStmt, *ast.ForStmt, *ast.RangeStmt, *ast.SelectStmt:\n43|\t\t\t\t// Any Authority assignment nested in a\n44|\t\t\t\t// branch or loop counts conditional.\n45|\t\t\t\tast.Inspect(stmt, func(inner ast.Node) bool {\n46|\t\t\t\t\tkv, ok := inner.(*ast.KeyValueExpr)\n47|\t\t\t\t\tif ok {\n48|\t\t\t\t\t\tcheckAuthorityValue(t, kv, &shape, true)\n49|\t\t\t\t\t}\n50|\t\t\t\t\tassign, ok := inner.(*ast.AssignStmt)\n51|\t\t\t\t\tif ok {\n52|\t\t\t\t\t\tcheckAuthorityAssign(t, assign, &shape, true)\n53|\t\t\t\t\t}\n54|\t\t\t\t\treturn true\n55|\t\t\t\t})\n56|\t\t\t\treturn false\n57|\t\t\tcase *ast.KeyValueExpr:\n58|\t\t\t\tcheckAuthorityValue(t, stmt, &shape, false)\n59|\t\t\tcase *ast.AssignStmt:\n60|\t\t\t\tcheckAuthorityAssign(t, stmt, &shape, false)\n61|\t\t\t}\n62|\t\t\treturn true\n63|\t\t})\n64|\t}\n65|\treturn shape\n66|}\n67|\n68|func isAuthorityKey(expr ast.Expr) bool {\n69|\tident, ok := expr.(*ast.Ident)\n70|\treturn ok && ident.Name == \"Authority\"\n71|}\n72|\n73|func isAuthoritySelector(expr ast.Expr) bool {\n74|\tsel, ok := expr.(*ast.SelectorExpr)\n75|\treturn ok && sel.Sel.Name == \"Authority\"\n76|}\n77|\n78|// checkAuthorityValue inspects one composite-literal Authority\n79|// field for the constant shape.\n80|func checkAuthorityValue(t *testing.T, kv *ast.KeyValueExpr, shape *authorityShape, conditional bool) {\n81|\tt.Helper()\n82|\tif !isAuthorityKey(kv.Key) {\n83|\t\treturn\n84|\t}\n85|\tshape.assignments++\n86|\tif conditional {\n87|\t\tshape.conditional++\n88|\t}\n89|\tif !isAuthorityConstant(kv.Value) {\n90|\t\tshape.foreign++\n91|\t}\n92|}\n93|\n94|// checkAuthorityAssign inspects one Authority assignment for the\n95|// constant shape.\n96|func checkAuthorityAssign(t *testing.T, assign *ast.AssignStmt, shape *authorityShape, conditional bool) {\n97|\tt.Helper()\n98|\tfor i, target := range assign.Lhs {\n99|\t\tif !isAuthoritySelector(target) && !isAuthorityKey(target) {\n100|\t\t\tcontinue\n101|\t\t}\n102|\t\tif i >= len(assign.Rhs) {\n103|\t\t\tcontinue\n104|\t\t}\n105|\t\tshape.assignments++\n106|\t\tif conditional {\n107|\t\t\tshape.conditional++\n108|\t\t}\n109|\t\tif !isAuthorityConstant(assign.Rhs[i]) {\n110|\t\t\tshape.foreign++\n111|\t\t}\n112|\t}\n113|}\n114|\n115|// isAuthorityConstant reports whether the value is the authority\n116|// constant or the literal it quotes.\n117|func isAuthorityConstant(expr ast.Expr) bool {\n118|\tif ident, ok := expr.(*ast.Ident); ok {\n119|\t\treturn ident.Name == \"authorityUserContext\"\n120|\t}\n121|\tif lit, ok := expr.(*ast.BasicLit); ok {\n122|\t\treturn lit.Value == `\"user_context\"`\n123|\t}\n124|\treturn false\n125|}\n126|\n127|func TestAuthorityDecisionShape(t *testing.T) {\n128|\t// The constant quotes SPEC.v0.7.0.md:10810 literally.\n129|\tif authorityUserContext != \"user_context\" {\n130|\t\tt.Fatalf(\"authority constant %q, want user_context\", authorityUserContext)\n131|\t}\n132|\tshape := inspectAuthorityShape(t, \"visible.go\")\n133|\tif shape.assignments != 1 {\n134|\t\tt.Fatalf(\"ProjectVisibleText assigns Authority %d times, want exactly 1\", shape.assignments)\n135|\t}\n136|\tif shape.conditional != 0 {\n137|\t\tt.Fatalf(\"ProjectVisibleText assigns Authority under a branch or loop\")\n138|\t}\n139|\tif shape.foreign != 0 {\n140|\t\tt.Fatalf(\"ProjectVisibleText assigns Authority from a foreign value\")\n141|\t}\n142|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c669","stream":{"kind":"session","id":"01a0d2c4-4f2b-7620-b603-17ce30f31e40"},"sequence":399,"recorded_at":1780531400000793,"record_type":"event","durability":"durable","causation_id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23","run_stream":{"kind":"run","id":"312c8d31-8278-4b5e-92ac-bdc5e8392e23"},"call_id":"call_01a0d2c51df370aea63ddc9bc35d9248","text":"Read text file `internal/cloneplanning/testdata/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for internal/cloneplanning.\n3|\n4|Every gate ships a narrowing mutant: the gate stays present and is\n5|weakened to admit exactly one member of the class it must reject,\n6|and the named killer test must fail when run alone. A delete-only\n7|mutant proves only that the gate exists and is not accepted as\n8|evidence.\n9|\n10|Each row runs M (mutate one production file in place), R (run the\n11|scoped Go killer through a production entry), V (verdict from the Go\n12|exit code plus a FAIL kill-line: KILLED iff R fails with a test\n13|failure line, SURVIVED iff R passes, ERROR for anything else --\n14|unapplied patches, build breaks, timeouts). M failures and R\n15|infrastructure errors are ERROR, never kills or survivals. The file\n16|is restored from its backup after every row, pass or fail.\n17|\n18|Shared gates (the checkItem vocabulary and fact gates with two call\n19|sites: PlanItem and ClassifyItem) carry one plant each with the\n20|both-entries killer TestSharedItemVocabBothEntries.\n21|\n22|Row N-visible-escape-suffix is the token-preserving attack: the\n23|JSON token still leads the output but the behavior changes, and the\n24|killer executes the behavioral escaping suite.\n25|\n26|Single-member-class rows narrow a gate whose reject class holds\n27|exactly one member, so the plant admits the whole class, which is\n28|one member.\n29|\n30|Row C-doc-comment is the harmless control: a comment-only edit that\n31|must SURVIVE, proving the harness observes test outcomes instead of\n32|hard-coding kills.\n33|\n34|Usage:\n35|  PYTHONDONTWRITEBYTECODE=1 python3 internal/cloneplanning/testdata/mutant_harness.py [--log-dir DIR] [MUTANT ...]\n36|\"\"\"\n37|\n38|import shutil\n39|import subprocess\n40|import sys\n41|import tempfile\n42|import time\n43|from dataclasses import dataclass\n44|from pathlib import Path\n45|\n46|REPO = Path(__file__).resolve().parents[3]\n47|PACKAGE = \"internal/cloneplanning\"\n48|\n49|\n50|@dataclass(frozen=True)\n51|class Mutant:\n52|    name: str\n53|    path: str\n54|    find: str\n55|    replace: str\n56|    count: int\n57|    run: str\n58|    expect: str\n59|    note: str\n60|\n61|\n62|MUTANTS = [\n63|    Mutant(\n64|        name=\"N-select-archive-priority\",\n65|        path=f\"{PACKAGE}/strategy.go\",\n66|        find='''\\tif archive {\\n\\t\\treturn strategyArchive, nil\\n\\t}\\n\\tif continuation {\\n\\t\\treturn strategyContinuation, nil\\n\\t}''',\n67|        replace='''\\tif continuation {\\n\\t\\treturn strategyContinuation, nil\\n\\t}\\n\\tif archive {\\n\\t\\treturn strategyArchive, nil\\n\\t}''',\n68|        count=1,\n69|        run=\"TestSelectStrategyOracle\",\n70|        expect=\"KILLED\",\n71|        note=\"Narrows the priority gate: archive+continuation selects continuation instead of archive.\",\n72|    ),\n73|    Mutant(\n74|        name=\"N-select-official\",\n75|        path=f\"{PACKAGE}/strategy.go\",\n76|        find='''\\tif !sameEnvironment {\\n\\t\\tif officialImport {\\n\\t\\t\\treturn strategyOfficial, nil\\n\\t\\t}\\n\\t\\treturn strategyNativeWriter, nil\\n\\t}\\n\\treturn strategyNativeRewrite, nil''',\n77|        replace='''\\tif officialImport {\\n\\t\\treturn strategyOfficial, nil\\n\\t}\\n\\tif !sameEnvironment {\\n\\t\\treturn strategyNativeWriter, nil\\n\\t}\\n\\treturn strategyNativeRewrite, nil''',\n78|        count=1,\n79|        run=\"TestSelectStrategyOracle\",\n80|        expect=\"KILLED\",\n81|        note=\"Narrows the pair arm: same-environment with the importer selects official import instead of native rewrite.\",\n82|    ),\n83|    Mutant(\n84|        name=\"N-select-profile-archive\",\n85|        path=f\"{PACKAGE}/strategy.go\",\n86|        find='''\\tif requested == profileArchive {\\n\\t\\treturn BranchArchive, requested, nil\\n\\t}''',\n87|        replace='''\\tif requested == profileArchive {\\n\\t\\treturn BranchTarget, requested, nil\\n\\t}''',\n88|        count=1,\n89|        run=\"TestSelectProfileOracle\",\n90|        expect=\"KILLED\",\n91|        note=\"Narrows the branch router: archive_only routes target instead of archive.\",\n92|    ),\n93|    Mutant(\n94|        name=\"N-select-profile-unknown\",\n95|        path=f\"{PACKAGE}/strategy.go\",\n96|        find='''\\tif !cloneplan.ValidPlanProfile(requested) {''',\n97|        replace='''\\tif requested != \"bogus_profile\" && !cloneplan.ValidPlanProfile(requested) {''',\n98|        count=1,\n99|        run=\"TestSelectProfileOracle\",\n100|        expect=\"KILLED\",\n101|        note=\"Narrows the plan-profile gate: admits exactly bogus_profile to the target branch.\",\n102|    ),\n103|    Mutant(\n104|        name=\"N-kind-vocab\",\n105|        path=f\"{PACKAGE}/item.go\",\n106|        find='''\\t\\tif !clonebundle.ValidEventKind(item.Kind) {''',\n107|        replace='''\\t\\tif item.Kind != \"bogus_kind\" && !clonebundle.ValidEventKind(item.Kind) {''',\n108|        count=1,\n109|        run=\"TestSharedItemVocabBothEntries\",\n110|        expect=\"KILLED\",\n111|        note=\"Shared gate: admits exactly bogus_kind through both PlanItem and ClassifyItem.\",\n112|    ),\n113|    Mutant(\n114|        name=\"N-block-vocab\",\n115|        path=f\"{PACKAGE}/item.go\",\n116|        find='''\\t\\tif !clonebundle.ValidContentBlockType(item.Block) {''',\n117|        replace='''\\t\\tif item.Block != \"bogus_block\" && !clonebundle.ValidContentBlockType(item.Block) {''',\n118|        count=1,\n119|        run=\"TestSharedItemVocabBothEntries\",\n120|        expect=\"KILLED\",\n121|        note=\"Shared gate: admits exactly bogus_block through PlanItem (blocks have no event bridge).\",\n122|    ),\n123|    Mutant(\n124|        name=\"N-resolution-vocab\",\n125|        path=f\"{PACKAGE}/item.go\",\n126|        find='''\\tif !validResolution(item.Resolution) {''',\n127|        replace='''\\tif item.Resolution != \"bogus_resolution\" && !validResolution(item.Resolution) {''',\n128|        count=1,\n129|        run=\"TestSharedItemVocabBothEntries\",\n130|        expect=\"KILLED\",\n131|        note=\"Shared gate: admits exactly bogus_resolution through both entries.\",\n132|    ),\n133|    Mutant(\n134|        name=\"N-protection-vocab\",\n135|        path=f\"{PACKAGE}/item.go\",\n136|        find='''\\tif !validProtection(item.Protection) {''',\n137|        replace='''\\tif item.Protection != \"bogus_protection\" && !validProtection(item.Protection) {''',\n138|        count=1,\n139|        run=\"TestSharedItemVocabBothEntries\",\n140|        expect=\"KILLED\",\n141|        note=\"Shared gate: admits exactly bogus_protection through both entries.\",\n142|    ),\n143|    Mutant(\n144|        name=\"N-classify-resolution-required\",\n145|        path=f\"{PACKAGE}/item.go\",\n146|        find='''\\tif toolKinds[item.Kind] {\\n\\t\\tif item.Resolution == \"\" {\\n\\t\\t\\treturn invalid(\"projection item kind %q requires its completed|aborted resolution\", item.Kind)\\n\\t\\t}''',\n147|        replace='''\\tif toolKinds[item.Kind] {\\n\\t\\tif item.Resolution == \"\" && item.Kind != \"tool_call\" {\\n\\t\\t\\treturn invalid(\"projection item kind %q requires its completed|aborted resolution\", item.Kind)\\n\\t\\t}''',\n148|        count=1,\n149|        run=\"TestClassifyItemRefusals\",\n150|        expect=\"KILLED\",\n151|        note=\"Narrows the required-resolution gate: tool_call without resolution admits, tool_result still refuses.\",\n152|    ),\n153|    Mutant(\n154|        name=\"N-classify-protection-required\",\n155|        path=f\"{PACKAGE}/item.go\",\n156|        find='''\\tif item.Kind == \"opaque_reasoning\" {\\n\\t\\tif item.Protection == \"\" {\\n\\t\\t\\treturn invalid(\"projection item kind opaque_reasoning requires its encrypted|signed protection\")\\n\\t\\t}''',\n157|        replace='''\\tif item.Kind == \"opaque_reasoning\" {\\n\\t\\tif item.Protection == \"\" && item.Kind != \"opaque_reasoning\" {\\n\\t\\t\\treturn invalid(\"projection item kind opaque_reasoning requires its encrypted|signed protection\")\\n\\t\\t}''',\n158|        count=1,\n159|        run=\"TestClassifyItemRefusals\",\n160|        expect=\"KILLED\",\n161|        note=\"Single-member-class narrowing: the gate whose reject class is exactly opaque_reasoning-without-protection admits it.\",\n162|    ),\n163|    Mutant(\n164|        name=\"N-classify-fact-type\",\n165|        path=f\"{PACKAGE}/item.go\",\n166|        find='''\\tvalue, ok := raw.(string)\\n\\tif !ok {\\n\\t\\treturn \"\", invalid(\"projection item fact %q is not a string\", name)\\n\\t}\\n\\treturn value, nil''',\n167|        replace='''\\tif _, isInt := raw.(int64); isInt {\\n\\t\\treturn \"\", nil\\n\\t}\\n\\tvalue, ok := raw.(string)\\n\\tif !ok {\\n\\t\\treturn \"\", invalid(\"projection item fact %q is not a string\", name)\\n\\t}\\n\\treturn value, nil''',\n168|        count=1,\n169|        run=\"TestClassifyItemRefusals\",\n170|        expect=\"KILLED\",\n171|        note=\"Narrows the fact-type gate: admits exactly int64-typed facts as absent (the landed decoder renders numbers int64); bool and object facts still refuse.\",\n172|    ),\n173|    Mutant(\n174|        name=\"N-strategy-vocab\",\n175|        path=f\"{PACKAGE}/plan.go\",\n176|        find='''\\tif !clonefidelity.ValidStrategy(strategy) {''',\n177|        replace='''\\tif strategy != \"bogus_strategy\" && !clonefidelity.ValidStrategy(strategy) {''',\n178|        count=1,\n179|        run=\"TestPlanItemInvalidArms\",\n180|        expect=\"KILLED\",\n181|        note=\"Narrows the strategy vocabulary delegation: admits exactly bogus_strategy.\",\n182|    ),\n183|    Mutant(\n184|        name=\"N-profile-vocab\",\n185|        path=f\"{PACKAGE}/plan.go\",\n186|        find='''\\tcase profileMaximalSafe:\\n\\t\\treturn disposition, reasons, nil\\n\\tdefault:\\n\\t\\treturn \"\", nil, invalid(\"projection profile %q is not a target plan profile\", profile)''',\n187|        replace='''\\tcase profileMaximalSafe:\\n\\t\\treturn disposition, reasons, nil\\n\\tcase \"bogus_profile\":\\n\\t\\treturn disposition, reasons, nil\\n\\tdefault:\\n\\t\\treturn \"\", nil, invalid(\"projection profile %q is not a target plan profile\", profile)''',\n188|        count=1,\n189|        run=\"TestPlanItemInvalidArms\",\n190|        expect=\"KILLED\",\n191|        note=\"Narrows the profile overlay default: admits exactly bogus_profile as a pass-through.\",\n192|    ),\n193|    Mutant(\n194|        name=\"N-archive-strategy\",\n195|        path=f\"{PACKAGE}/plan.go\",\n196|        find='''\\tif strategy == strategyArchive || profile == profileArchive {''',\n197|        replace='''\\tif !(strategy == strategyArchive && profile == profileMaximalSafe) && (strategy == strategyArchive || profile == profileArchive) {''',\n198|        count=1,\n199|        run=\"TestPlanItemArchiveRule\",\n200|        expect=\"KILLED\",\n201|        note=\"Narrows the archive gate: admits exactly the archive_only/maximal_safe cell.\",\n202|    ),\n203|    Mutant(\n204|        name=\"N-archive-profile\",\n205|        path=f\"{PACKAGE}/plan.go\",\n206|        find='''\\tif strategy == strategyArchive || profile == profileArchive {''',\n207|        replace='''\\tif !(strategy == strategyNativeWriter && profile == profileArchive) && (strategy == strategyArchive || profile == profileArchive) {''',\n208|        count=1,\n209|        run=\"TestPlanItemArchiveRule\",\n210|        expect=\"KILLED\",\n211|        note=\"Narrows the archive gate: exempts exactly the writer/archive cell from the archive-branch refusal (it then refuses via the overlay default, which names no archive branch).\",\n212|    ),\n213|    Mutant(\n214|        name=\"N-opaque-reason\",\n215|        path=f\"{PACKAGE}/plan.go\",\n216|        find='''\\t\\tif item.Protection == protectionSigned {\\n\\t\\t\\treturn dispositionOpaquePreserved, []string{reasonForeignSigned}\\n\\t\\t}''',\n217|        replace='''\\t\\tif item.Protection == protectionSigned {\\n\\t\\t\\treturn dispositionOpaquePreserved, []string{reasonForeignEncrypted}\\n\\t\\t}''',\n218|        count=1,\n219|        run=\"TestPlanItemOpaqueRule\",\n220|        expect=\"KILLED\",\n221|        note=\"Narrows the opaque-reason mapping: signed reasoning reports the encrypted reason; the encrypted arm is intact.\",\n222|    ),\n223|    Mutant(\n224|        name=\"N-opaque-event-reason\",\n225|        path=f\"{PACKAGE}/plan.go\",\n226|        find='''\\tif item.Kind == \"opaque_event\" || item.Block == \"opaque\" {\\n\\t\\treturn dispositionOpaquePreserved, []string{reasonUnknownNative}\\n\\t}''',\n227|        replace='''\\tif item.Kind == \"opaque_event\" && item.Protection == \"\" {\\n\\t\\treturn dispositionOpaquePreserved, []string{reasonForeignEncrypted}\\n\\t}\\n\\tif item.Kind == \"opaque_event\" || item.Block == \"opaque\" {\\n\\t\\treturn dispositionOpaquePreserved, []string{reasonUnknownNative}\\n\\t}''',\n228|        count=1,\n229|        run=\"TestPlanItemOpaqueRule\",\n230|        expect=\"KILLED\",\n231|        note=\"Narrows the opaque-event mapping: the unprotected opaque_event item reports the encrypted reason.\",\n232|    ),\n233|    Mutant(\n234|        name=\"N-abort-drop\",\n235|        path=f\"{PACKAGE}/plan.go\",\n236|        find='''\\tif (item.Kind == \"tool_call\" || item.Kind == \"tool_result\") && item.Resolution == cloneproject.StatusAborted {''',\n237|        replace='''\\tif (item.Kind == \"tool_result\") && item.Resolution == cloneproject.StatusAborted {''',\n238|        count=1,\n239|        run=\"TestPlanItemAbortRule\",\n240|        expect=\"KILLED\",\n241|        note=\"Narrows the abort arm: aborted tool_call falls to the strategy default; aborted tool_result is intact.\",\n242|    ),\n243|    Mutant(\n244|        name=\"N-abort-reason\",\n245|        path=f\"{PACKAGE}/plan.go\",\n246|        find='''\\t\\treturn dispositionSummarized, []string{reasonUnsafePending}''',\n247|        replace='''\\t\\treturn dispositionSummarized, nil''',\n248|        count=1,\n249|        run=\"TestPlanItemAbortRule\",\n250|        expect=\"KILLED\",\n251|        note=\"Narrows the abort mapping: aborted history without its unsafe_pending_action reason.\",\n252|    ),\n253|    Mutant(\n254|        name=\"N-continuation-exact\",\n255|        path=f\"{PACKAGE}/plan.go\",\n256|        find='''\\tif strategy == strategyContinuation {\\n\\t\\treturn dispositionSemantic, []string{reasonTargetNoEquivalent}\\n\\t}''',\n257|        replace='''\\tif strategy == strategyContinuation && item.Kind != \"usage\" {\\n\\t\\treturn dispositionSemantic, []string{reasonTargetNoEquivalent}\\n\\t}''',\n258|        count=1,\n259|        run=\"TestPlanItemContinuationRule\",\n260|        expect=\"KILLED\",\n261|        note=\"Narrows the continuation clamp: usage plans exact under continuation_context.\",\n262|    ),\n263|    Mutant(\n264|        name=\"N-continuation-reason\",\n265|        path=f\"{PACKAGE}/plan.go\",\n266|        find='''\\t\\treturn dispositionSemantic, []string{reasonTargetNoEquivalent}''',\n267|        replace='''\\t\\treturn dispositionSemantic, nil''',\n268|        count=1,\n269|        run=\"TestPlanItemContinuationRule\",\n270|        expect=\"KILLED\",\n271|        note=\"Narrows the continuation mapping: semantic without its target_no_equivalent reason.\",\n272|    ),\n273|    Mutant(\n274|  