{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc13","stream":{"kind":"session","id":"01a0d24d-9c2d-7841-a066-6ac00d915ab7"},"sequence":1124,"recorded_at":1780531400002243,"record_type":"event","durability":"durable","causation_id":"6722cf1c-e919-40c8-89ba-6768c67dec7c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6722cf1c-e919-40c8-89ba-6768c67dec7c","run_stream":{"kind":"run","id":"6722cf1c-e919-40c8-89ba-6768c67dec7c"},"task_stream":{"kind":"task","id":"01a0d252-ca14-7c82-ab7a-f757ef2b2505"},"task_id":"01a0d252-ca14-7c82-ab7a-f757ef2b2505","event":{"kind":"output","task_id":"01a0d252-ca14-7c82-ab7a-f757ef2b2505","chunk":"Read text file `internal/cloneproject/tools.go`.\n1|package cloneproject\n2|\n3|// This file folds historical tools: call/result pairing, the\n4|// completed/aborted resolution, the live surface that stays empty,\n5|// the effective instruction snapshot that excludes foreign history,\n6|// and the usage ledger that never becomes target accounting.\n7|\n8|import (\n9|\t\"sort\"\n10|)\n11|\n12|// Tool resolution statuses. Capture yields completed or aborted\n13|// only: a call resolves completed with exactly one tool_result and\n14|// becomes aborted history otherwise. Nothing captured is pending.\n15|const (\n16|\t// StatusCompleted marks a call paired with its result.\n17|\tStatusCompleted = \"completed\"\n18|\t// StatusAborted marks a call without its result, or a result\n19|\t// without its call: inert history with reason\n20|\t// unsafe_pending_action.\n21|\tStatusAborted = \"aborted\"\n22|)\n23|\n24|// ToolResolution is one folded tool call or orphan result.\n25|type ToolResolution struct {\n26|\t// CallID is the native call identifier.\n27|\tCallID string\n28|\t// ToolName is empty for orphan results, which name no call.\n29|\tToolName string\n30|\t// Status is completed or aborted.\n31|\tStatus string\n32|\t// ResultStatus is the paired result status (ok|error), empty\n33|\t// for calls without a result.\n34|\tResultStatus string\n35|}\n36|\n37|// toolCall is one observed tool/call record.\n38|type toolCall struct {\n39|\trecord NativeRecord\n40|\tbody   toolCallBody\n41|}\n42|\n43|// toolResult is one observed tool/result record.\n44|type toolResult struct {\n45|\trecord NativeRecord\n46|\tbody   toolResultBody\n47|}\n48|\n49|// resolveToolCalls pairs calls with results in record order. Two\n50|// calls sharing one ID refuse, two results sharing one ID refuse,\n51|// and a result claiming live followup refuses: captured history can\n52|// neither fork nor request a live action.\n53|func resolveToolCalls(calls []toolCall, results []toolResult) ([]ToolResolution, error) {\n54|\tseenCalls := map[string]toolCall{}\n55|\tfor _, call := range calls {\n56|\t\tif _, duplicate := seenCalls[call.body.CallID]; duplicate {\n57|\t\t\treturn nil, invalid(\"tool call %q is not unique\", call.body.CallID)\n58|\t\t}\n59|\t\tseenCalls[call.body.CallID] = call\n60|\t}\n61|\tseenResults := map[string]toolResult{}\n62|\tfor _, result := range results {\n63|\t\tif _, duplicate := seenResults[result.body.CallID]; duplicate {\n64|\t\t\treturn nil, invalid(\"tool result %q is not unique\", result.body.CallID)\n65|\t\t}\n66|\t\tseenResults[result.body.CallID] = result\n67|\t}\n68|\tfor _, result := range results {\n69|\t\tif result.body.LiveFollowup {\n70|\t\t\twhere := \"record \" + result.record.MemberKey + \" line \" + itoa(result.record.Line)\n71|\t\t\treturn nil, invalid(\"%s claims a live followup for historical tool result %q\", where, result.body.CallID)\n72|\t\t}\n73|\t}\n74|\tresolutions := make([]ToolResolution, 0, len(calls)+len(results))\n75|\tfor _, call := range calls {\n76|\t\tresult, ok := seenResults[call.body.CallID]\n77|\t\tif !ok {\n78|\t\t\tresolutions = append(resolutions, ToolResolution{\n79|\t\t\t\tCallID:   call.body.CallID,\n80|\t\t\t\tToolName: call.body.ToolName,\n81|\t\t\t\tStatus:   StatusAborted,\n82|\t\t\t})\n83|\t\t\tcontinue\n84|\t\t}\n85|\t\tresolutions = append(resolutions, ToolResolution{\n86|\t\t\tCallID:       call.body.CallID,\n87|\t\t\tToolName:     call.body.ToolName,\n88|\t\t\tStatus:       StatusCompleted,\n89|\t\t\tResultStatus: result.body.Status,\n90|\t\t})\n91|\t}\n92|\tfor _, result := range results {\n93|\t\tif _, ok := seenCalls[result.body.CallID]; !ok {\n94|\t\t\tresolutions = append(resolutions, ToolResolution{\n95|\t\t\t\tCallID:       result.body.CallID,\n96|\t\t\t\tStatus:       StatusAborted,\n97|\t\t\t\tResultStatus: result.body.Status,\n98|\t\t\t})\n99|\t\t}\n100|\t}\n101|\treturn resolutions, nil\n102|}\n103|\n104|// LiveSurface is the projection's live action surface: callable\n105|// tools and pending actions. Capture carries no live work order, so\n106|// both lists are always empty: historical tools are inert.\n107|type LiveSurface struct {\n108|\t// CallableTools names tools the target may call. Always empty\n109|\t// from captured history.\n110|\tCallableTools []string\n111|\t// PendingActions names call IDs awaiting execution. Always\n112|\t// empty from captured history.\n113|\tPendingActions []string\n114|}\n115|\n116|// toolDefinition is one observed tool/definition record.\n117|type toolDefinition struct {\n118|\trecord NativeRecord\n119|\tbody   toolDefinitionBody\n120|}\n121|\n122|// deriveLiveSurface folds historical definitions and resolutions.\n123|// A captured definition claiming live authority refuses instead of\n124|// registering: history can never self-promote to a callable tool.\n125|// Pending actions admit only completed calls named by a live work\n126|// order; aborted history never pends even when named.\n127|func deriveLiveSurface(definitions []toolDefinition, resolutions []ToolResolution, liveWorkOrders map[string]bool) (LiveSurface, error) {\n128|\tsurface := LiveSurface{}\n129|\tfor _, definition := range definitions {\n130|\t\tif definition.body.LiveClaim {\n131|\t\t\twhere := \"record \" + definition.record.MemberKey + \" line \" + itoa(definition.record.Line)\n132|\t\t\treturn LiveSurface{}, invalid(\"%s claims live authority for historical tool definition %q\", where, definition.body.ToolName)\n133|\t\t}\n134|\t}\n135|\tfor _, resolution := range resolutions {\n136|\t\tif resolution.Status == StatusAborted {\n137|\t\t\tcontinue\n138|\t\t}\n139|\t\tif liveWorkOrders[resolution.CallID] {\n140|\t\t\tsurface.PendingActions = append(surface.PendingActions, resolution.CallID)\n141|\t\t}\n142|\t}\n143|\tsort.Strings(surface.PendingActions)\n144|\treturn surface, nil\n145|}\n146|\n147|// EffectiveInstruction is the projected session's instruction\n148|// snapshot: the last native instruction in record order. Foreign\n149|// instructions are low-authority history and never change it.\n150|type EffectiveInstruction struct {\n151|\t// Found reports whether any native instruction was observed.\n152|\tFound bool\n153|\t// Authority is the native claimed authority, high or low.\n154|\tAuthority string\n155|\t// Directives are the native directives in record order.\n156|\tDirectives []string\n157|}\n158|\n159|// instructionObservation is one observed instruction/snapshot record.\n160|type instructionObservation struct {\n161|\trecord NativeRecord\n162|\tbody   instructionBody\n163|}\n164|\n165|// foldInstructions folds native instructions in record order. The\n166|// last native record wins; foreign records are history only and\n167|// never reach the snapshot.\n168|func foldInstructions(observations []instructionObservation) EffectiveInstruction {\n169|\teffective := EffectiveInstruction{}\n170|\tfor _, observation := range observations {\n171|\t\tif observation.record.Origin != \"native\" {\n172|\t\t\tcontinue\n173|\t\t}\n174|\t\teffective = EffectiveInstruction{\n175|\t\t\tFound:      true,\n176|\t\t\tAuthority:  observation.body.Authority,\n177|\t\t\tDirectives: append([]string(nil), observation.body.Directives...),\n178|\t\t}\n179|\t}\n180|\treturn effective\n181|}\n182|\n183|// UsageLedger separates source usage from target accounting. Source\n184|// records count into the source totals only; the target totals stay\n185|// zero: source usage is not target accounting.\n186|type UsageLedger struct {\n187|\tSourceInputTokens  uint64\n188|\tSourceOutputTokens uint64\n189|\tTargetInputTokens  uint64\n190|\tTargetOutputTokens uint64\n191|}\n192|\n193|// usageObservation is one observed usage/report record.\n194|type usageObservation struct {\n195|\trecord NativeRecord\n196|\tbody   usageBody\n197|}\n198|\n199|// foldUsage sums source tokens with overflow refusal. The target\n200|// totals are never written: no source record can fund them.\n201|func foldUsage(observations []usageObservation) (UsageLedger, error) {\n202|\tledger := UsageLedger{}\n203|\tfor _, observation := range observations {\n204|\t\tinput := ledger.SourceInputTokens + observation.body.InputTokens\n205|\t\tif input < ledger.SourceInputTokens || input > maxUint53 {\n206|\t\t\treturn UsageLedger{}, invalid(\"source input token total exceeds uint53\")\n207|\t\t}\n208|\t\toutput := ledger.SourceOutputTokens + observation.body.OutputTokens\n209|\t\tif output < ledger.SourceOutputTokens || output > maxUint53 {\n210|\t\t\treturn UsageLedger{}, invalid(\"source output token total exceeds uint53\")\n211|\t\t}\n212|\t\tledger.SourceInputTokens = input\n213|\t\tledger.SourceOutputTokens = output\n214|\t}\n215|\treturn ledger, nil\n216|}","final_result":true}}}
