asonCodes() []string {\n157|\tout := make([]string, len(coreReasons))\n158|\tcopy(out, coreReasons)\n159|\treturn out\n160|}\n161|\n162|// ValidReasonCode reports whether the code is an admissible reason:\n163|// one of the nineteen closed core codes or a reverse-DNS extension\n164|// reason. An extension can never redefine a core code: core codes\n165|// carry no dot and the reverse-DNS grammar requires one, so the\n166|// two arms are disjoint by construction. Length bounds live at the\n167|// JSON gates (reason_codes items are string[1..128]); this\n168|// predicate is pure vocabulary.\n169|func ValidReasonCode(code string) bool {\n170|\tif IsCoreReasonCode(code) {\n171|\t\treturn true\n172|\t}\n173|\treturn isExtensionReason(code)\n174|}\n175|\n176|// isExtensionReason reports whether the code is a reverse-DNS\n177|// extension reason. It delegates to the single environ grammar so\n178|// extension reasons and extension keys can never drift.\n179|func isExtensionReason(code string) bool {\n180|\treturn environ.CheckReverseDNS(code)\n181|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
