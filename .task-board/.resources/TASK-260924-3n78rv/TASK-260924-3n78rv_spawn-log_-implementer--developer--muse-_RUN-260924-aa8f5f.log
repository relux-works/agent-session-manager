{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d74f","stream":{"kind":"session","id":"01a0d24d-9c2d-7841-a066-6ac00d915ab7"},"sequence":2562,"recorded_at":1780531400005119,"record_type":"event","durability":"durable","causation_id":"6722cf1c-e919-40c8-89ba-6768c67dec7c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6722cf1c-e919-40c8-89ba-6768c67dec7c","run_stream":{"kind":"run","id":"6722cf1c-e919-40c8-89ba-6768c67dec7c"},"task_stream":{"kind":"task","id":"01a0d263-3025-76e2-a5e0-e24e9a52e4f3"},"task_id":"01a0d263-3025-76e2-a5e0-e24e9a52e4f3","event":{"kind":"output","task_id":"01a0d263-3025-76e2-a5e0-e24e9a52e4f3","chunk":"edited\nchanged lines: lines 73-89\n--- original\n+++ updated\n@@\n-// SelectProfile validates one requested profile and routes its\n-// branch. archive_only routes the archive branch, which carries no\n-// plan. The four plan profiles route the target branch; the caller\n-// admits the capture manifest under the returned profile through\n-// the landed clonesnap.AdmitForTarget gate. Anything else refuses.\n-func SelectProfile(requested string) (Branch, string, error) {\n-\tif !clonefidelity.ValidProfile(requested) {\n-\t\treturn \"\", \"\", invalid(\"projection profile %q is outside strict_exact|maximal_safe|compact|messages_only|archive_only\", requested)\n-\t}\n-\tif requested == profileArchive {\n-\t\treturn BranchArchive, requested, nil\n-\t}\n-\tif !cloneplan.ValidPlanProfile(requested) {\n-\t\treturn \"\", \"\", invalid(\"projection profile %q is not a target plan profile\", requested)\n-\t}\n-\treturn BranchTarget, requested, nil\n-}\n+// SelectProfile validates one requested profile and routes its\n+// branch. archive_only routes the archive branch, which carries no\n+// plan. The four plan profiles route the target branch; the caller\n+// admits the capture manifest under the returned profile through\n+// the landed clonesnap.AdmitForTarget gate. Anything else refuses\n+// through the plan-profile gate.\n+func SelectProfile(requested string) (Branch, string, error) {\n+\tif requested == profileArchive {\n+\t\treturn BranchArchive, requested, nil\n+\t}\n+\tif !cloneplan.ValidPlanProfile(requested) {\n+\t\treturn \"\", \"\", invalid(\"projection profile %q is outside strict_exact|maximal_safe|compact|messages_only|archive_only\", requested)\n+\t}\n+\treturn BranchTarget, requested, nil\n+}\n","final_result":true}}}
