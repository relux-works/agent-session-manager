{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cd7b","stream":{"kind":"session","id":"01a0d24d-9c2d-7841-a066-6ac00d915ab7"},"sequence":1304,"recorded_at":1780531400002603,"record_type":"event","durability":"durable","causation_id":"6722cf1c-e919-40c8-89ba-6768c67dec7c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6722cf1c-e919-40c8-89ba-6768c67dec7c","run_stream":{"kind":"run","id":"6722cf1c-e919-40c8-89ba-6768c67dec7c"},"task_stream":{"kind":"task","id":"01a0d253-8cb5-7c50-8b72-05f813ec07cb"},"task_id":"01a0d253-8cb5-7c50-8b72-05f813ec07cb","event":{"kind":"output","task_id":"01a0d253-8cb5-7c50-8b72-05f813ec07cb","chunk":"Read text file `internal/clonesnap/project.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/localstore\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|)\n12|\n13|// This file owns target-branch admission and the projection output\n14|// whose existence pins the race-before-projection ordering.\n15|// CaptureAndProject runs the capture pipeline, then admits the\n16|// sealed capture manifest: the unstable_archive form can never enter\n17|// a target branch (the landed G2 gate decides), and the maximal_safe\n18|// fidelity profile requires a reconciled complete manifest (the\n19|// landed maximal-safe gate decides). Admission emits one admission\n20|// receipt into the target sink. Projection planning past admission\n21|// is the final leaf's scope; this receipt exists to prove admission\n22|// and ordering, not to plan a projection.\n23|\n24|// FidelityProfile is one Section 7.8 fidelity profile:\n25|// strict_exact|maximal_safe|compact|messages_only.\n26|type FidelityProfile string\n27|\n28|const (\n29|\t// FidelityStrictExact requests exact projection.\n30|\tFidelityStrictExact FidelityProfile = \"strict_exact\"\n31|\t// FidelityMaximalSafe requests maximal safe projection: it\n32|\t// requires a reconciled complete manifest with no unknown class.\n33|\tFidelityMaximalSafe FidelityProfile = \"maximal_safe\"\n34|\t// FidelityCompact requests compact projection.\n35|\tFidelityCompact FidelityProfile = \"compact\"\n36|\t// FidelityMessagesOnly requests messages-only projection.\n37|\tFidelityMessagesOnly FidelityProfile = \"messages_only\"\n38|)\n39|\n40|// validFidelityProfile reports whether the profile is in the Section\n41|// 7.8 closed vocabulary. Bound (P3-ζ′): sessadapter owns an\n42|// unexported copy of this four-profile table (operations.go\n43|// fidelityProfiles, pinned by TestValueVocabulariesMatchSpec) and\n44|// this package keeps its own closed switch (pinned by\n45|// TestProjectAdmitsStableEveryProfile and\n46|// TestProjectRefusesUnknownProfile). The two spellings are not\n47|// unified: unification is deferred to a follow-up on\n48|// internal/sessadapter and internal/clonesnap.\n49|func validFidelityProfile(profile string) bool {\n50|\tswitch FidelityProfile(profile) {\n51|\tcase FidelityStrictExact, FidelityMaximalSafe, FidelityCompact, FidelityMessagesOnly:\n52|\t\treturn true\n53|\tdefault:\n54|\t\treturn false\n55|\t}\n56|}\n57|\n58|// ProjectRequest is one capture-and-project candidate: the capture\n59|// request, the target sink that receives the admission receipt, and\n60|// the fidelity profile admission decides.\n61|type ProjectRequest struct {\n62|\tCapture CaptureRequest\n63|\t// TargetSink receives the admission receipt. It stays empty\n64|\t// when capture refuses, races, or seals archive-only output.\n65|\tTargetSink *localstore.ObjectStore\n66|\t// FidelityProfile is the requested Section 7.8 profile.\n67|\tFidelityProfile string\n68|}\n69|\n70|// ProjectResult is one admitted capture: the capture result plus the\n71|// sealed admission receipt.\n72|type ProjectResult struct {\n73|\tCapture *CaptureResult\n74|\t// Receipt carries the sealed admission receipt bytes.\n75|\tReceipt []byte\n76|\t// ReceiptDigest is the blob identity of the receipt.\n77|\tReceiptDigest scalar.Digest\n78|\t// ReceiptInstalled reports whether this run installed the\n79|\t// receipt blob (a replay verifies and reuses).\n80|\tReceiptInstalled bool\n81|}\n82|\n83|// CaptureAndProject runs capture, then admits the sealed capture to\n84|// a target branch and emits the admission receipt. The race gate\n85|// precedes admission and emission (see ORDER-PIN below): a mutated\n86|// source refuses, or seals archive-only output that admission\n87|// rejects — no projection output is produced before the race is\n88|// decided.\n89|func CaptureAndProject(request ProjectRequest) (*ProjectResult, error) {\n90|\tif request.TargetSink == nil {\n91|\t\treturn nil, invalid(\"capture projection requires a target sink\")\n92|\t}\n93|\tstate, err := newPipeline(request.Capture)\n94|\tif err != nil {\n95|\t\treturn nil, err\n96|\t}\n97|\tdefer state.close()\n98|\tif err := state.walkAndMeasure(); err != nil {\n99|\t\treturn nil, err\n100|\t}\n101|\t// ORDER-PIN: the source-race gate precedes any seal, admission,\n102|\t// or projection output. N-race-order-project moves this gate\n103|\t// after admitAndEmit: the early seal then refuses with a seal\n104|\t// error instead of the race refusal, so that row's killer\n105|\t// reddens on the wrong error (the seal error message, not a\n106|\t// sink). N-race-order-project-seal keeps the race error while\n107|\t// sealing first: its killer reddens on the sealed raw manifest\n108|\t// in the capture store.\n109|\tif err := state.gateSourceRace(); err != nil {\n110|\t\tcaptured, raceErr := state.raceOutcome(err)\n111|\t\tif raceErr != nil {\n112|\t\t\treturn nil, raceErr\n113|\t\t}\n114|\t\t// Archive-only output never enters a target branch: the\n115|\t\t// admission gate below refuses it, so no receipt exists.\n116|\t\tif _, err := AdmitForTarget(captured.CaptureManifest, request.FidelityProfile); err != nil {\n117|\t\t\treturn nil, err\n118|\t\t}\n119|\t\treturn nil, invalid(\"capture archive unexpectedly admitted to a target branch\")\n120|\t}\n121|\tsealed, err := state.sealAndPublish(false)\n122|\tif err != nil {\n123|\t\treturn nil, err\n124|\t}\n125|\treturn state.admitAndEmit(request, sealed)\n126|}\n127|\n128|// admitAndEmit admits one sealed capture to the target branch and\n129|// emits its admission receipt into the target sink.\n130|func (state *pipeline) admitAndEmit(request ProjectRequest, sealed *CaptureResult) (*ProjectResult, error) {\n131|\tif _, err := AdmitForTarget(sealed.CaptureManifest, request.FidelityProfile); err != nil {\n132|\t\treturn nil, err\n133|\t}\n134|\treceipt, err := BuildAdmissionReceipt(sealed.Raw.ManifestID, sealed.Capture.ManifestID, request.FidelityProfile)\n135|\tif err != nil {\n136|\t\treturn nil, err\n137|\t}\n138|\tdigest := scalar.SHA256Digest(receipt)\n139|\tput, err := request.TargetSink.PutBlob(digest, uint64(len(receipt)), bytes.NewReader(receipt))\n140|\tif err != nil {\n141|\t\treturn nil, invalid(\"capture projection cannot publish the admission receipt: %v\", err)\n142|\t}\n143|\treturn &ProjectResult{\n144|\t\tCapture:          sealed,\n145|\t\tReceipt:          receipt,\n146|\t\tReceiptDigest:    digest,\n147|\t\tReceiptInstalled: put.Installed,\n148|\t}, nil\n149|}\n150|\n151|// AdmitForTarget admits one sealed capture manifest to a target\n152|// branch under the requested fidelity profile. The unstable_archive\n153|// form is archive-only output and always refuses; an unknown\n154|// fidelity profile refuses; maximal_safe requires a reconciled\n155|// complete manifest with no unknown class.\n156|func AdmitForTarget(captureManifest []byte, profile string) (clonebundle.CaptureManifest, error) {\n157|\tmanifest, err := clonebundle.DecodeCaptureManifest(captureManifest)\n158|\tif err != nil {\n159|\t\treturn clonebundle.CaptureManifest{}, err\n160|\t}\n161|\tif err := clonebundle.RefuseUnstableForTarget(manifest.CaptureBoundary); err != nil {\n162|\t\treturn clonebundle.CaptureManifest{}, err\n163|\t}\n164|\tif !validFidelityProfile(profile) {\n165|\t\treturn clonebundle.CaptureManifest{}, invalid(\"capture fidelity profile %q is outside strict_exact|maximal_safe|compact|messages_only\", profile)\n166|\t}\n167|\tif profile == \"maximal_safe\" {\n168|\t\tif err := clonebundle.RefuseMaximalSafeUnlessComplete(manifest); err != nil {\n169|\t\t\treturn clonebundle.CaptureManifest{}, err\n170|\t\t}\n171|\t}\n172|\treturn manifest, nil\n173|}\n174|\n175|// admissionReceiptSchema pins the admission receipt envelope\n176|// identity.\n177|const admissionReceiptSchema = \"urn:ax:internal:clonesnap-admission-receipt\"\n178|\n179|// BuildAdmissionReceipt seals one target admission receipt: the\n180|// admitted raw and capture manifest identities, the stable boundary\n181|// kind, and the fidelity profile. Only stable captures reach it;\n182|// AdmitForTarget refused everything else before this seal ran.\n183|func BuildAdmissionReceipt(rawManifestID, captureManifestID scalar.Digest, profile string) ([]byte, error) {\n184|\tif !validFidelityProfile(profile) {\n185|\t\treturn nil, invalid(\"capture fidelity profile %q is outside strict_exact|maximal_safe|compact|messages_only\", profile)\n186|\t}\n187|\tobject := map[string]any{\n188|\t\t\"schema\":                 admissionReceiptSchema,\n189|\t\t\"schema_version\":         \"1.0.0\",\n190|\t\t\"raw_object_manifest_id\": rawManifestID.String(),\n191|\t\t\"capture_manifest_id\":    captureManifestID.String(),\n192|\t\t\"boundary_kind\":          \"stable\",\n193|\t\t\"fidelity_profile\":       profile,\n194|\t\t\"extensions\":             map[string]any{},\n195|\t}\n196|\tplain, err := json.Marshal(object)\n197|\tif err != nil {\n198|\t\treturn nil, invalid(\"serialize admission receipt: %v\", err)\n199|\t}\n200|\tsealed, err := canonicaljson.Canonicalize(plain)\n201|\tif err != nil {\n202|\t\treturn nil, invalid(\"canonicalize admission receipt: %v\", err)\n203|\t}\n204|\treturn sealed, nil\n205|}","final_result":true}}}
