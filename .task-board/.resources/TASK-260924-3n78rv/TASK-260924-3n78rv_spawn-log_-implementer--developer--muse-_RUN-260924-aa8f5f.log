ximal safe projection: it\n32|\t// requires a reconciled complete manifest with no unknown class.\n33|\tFidelityMaximalSafe FidelityProfile = \"maximal_safe\"\n34|\t// FidelityCompact requests compact projection.\n35|\tFidelityCompact FidelityProfile = \"compact\"\n36|\t// FidelityMessagesOnly requests messages-only projection.\n37|\tFidelityMessagesOnly FidelityProfile = \"messages_only\"\n38|)\n39|\n40|// validFidelityProfile reports whether the profile is in the Section\n41|// 7.8 closed vocabulary. Bound (P3-ζ′): sessadapter owns an\n42|// unexported copy of this four-profile table (operations.go\n43|// fidelityProfiles, pinned by TestValueVocabulariesMatchSpec) and\n44|// this package keeps its own closed switch (pinned by\n45|// TestProjectAdmitsStableEveryProfile and\n46|// TestProjectRefusesUnknownProfile). The two spellings are not\n47|// unified: unification is deferred to a follow-up on\n48|// internal/sessadapter and internal/clonesnap.\n49|func validFidelityProfile(profile string) bool {\n50|\tswitch FidelityProfile(profile) {\n51|\tcase FidelityStrictExact, FidelityMaximalSafe, FidelityCompact, FidelityMessagesOnly:\n52|\t\treturn true\n53|\tdefault:\n54|\t\treturn false\n55|\t}\n56|}\n57|\n58|// ProjectRequest is one capture-and-project candidate: the capture\n59|// request, the target sink that receives the admission receipt, and\n60|// the fidelity profile admission decides.\n61|type ProjectRequest struct {\n62|\tCapture CaptureRequest\n63|\t// TargetSink receives the admission receipt. It stays empty\n64|\t// when capture refuses, races, or seals archive-only output.\n65|\tTargetSink *localstore.ObjectStore\n66|\t// FidelityProfile is the requested Section 7.8 profile.\n67|\tFidelityProfile string\n68|}\n69|\n70|// ProjectResult is one admitted capture: the capture result plus the\n71|// sealed admission receipt.\n72|type ProjectResult struct {\n73|\tCapture *CaptureResult\n74|\t// Receipt carries the sealed admission receipt bytes.\n75|\tReceipt [