{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cbdb","stream":{"kind":"session","id":"01a0d24d-9c2d-7841-a066-6ac00d915ab7"},"sequence":1096,"recorded_at":1780531400002187,"record_type":"event","durability":"durable","causation_id":"6722cf1c-e919-40c8-89ba-6768c67dec7c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6722cf1c-e919-40c8-89ba-6768c67dec7c","run_stream":{"kind":"run","id":"6722cf1c-e919-40c8-89ba-6768c67dec7c"},"task_stream":{"kind":"task","id":"01a0d252-bc90-7572-aa1b-71241731060b"},"task_id":"01a0d252-bc90-7572-aa1b-71241731060b","event":{"kind":"output","task_id":"01a0d252-bc90-7572-aa1b-71241731060b","chunk":"Read text file `internal/cloneplan/mapping.go`.\n1|package cloneplan\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"fmt\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/clonefidelity\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// This file validates and constructs ProjectionItemMapping: the\n13|// closed per-item row Section 13.14.2 states. Unlike the fidelity\n14|// disposition row, the spec pins no coupling between\n15|// expected_disposition and reason_codes or canonical_object_id here,\n16|// so every combination of the shaped members admits.\n17|\n18|var itemMappingMembers = map[string]bool{\n19|\t\"source_item_key\":      true,\n20|\t\"canonical_object_id\":  true,\n21|\t\"target_resource_keys\": true,\n22|\t\"expected_disposition\": true,\n23|\t\"reason_codes\":         true,\n24|\t\"extensions\":           true,\n25|}\n26|\n27|var itemMappingRequired = []string{\n28|\t\"source_item_key\",\n29|\t\"canonical_object_id\",\n30|\t\"target_resource_keys\",\n31|\t\"expected_disposition\",\n32|\t\"reason_codes\",\n33|\t\"extensions\",\n34|}\n35|\n36|// ItemMapping is one validated projection item mapping.\n37|type ItemMapping struct {\n38|\tSourceItemKey     string\n39|\tCanonicalObjectID *scalar.Digest\n40|\tTargetResourceKey []string\n41|\tExpectedDispos    string\n42|\tReasonCodes       []string\n43|}\n44|\n45|// ItemMappingInput is the caller-supplied item mapping candidate\n46|// for Build. A nil CanonicalObjectID seals as null.\n47|type ItemMappingInput struct {\n48|\tSourceItemKey     string\n49|\tCanonicalObjectID *string\n50|\tTargetResourceKey []string\n51|\tExpectedDispos    string\n52|\tReasonCodes       []string\n53|\tExtensions        map[string]any\n54|}\n55|\n56|// buildItemMapping validates one caller-supplied mapping and\n57|// renders its closed object. Every rule is a refusal: broken\n58|// bounds, unsorted or duplicate arrays, unknown dispositions, and\n59|// out-of-vocabulary reasons are refused, never repaired.\n60|func buildItemMapping(input ItemMappingInput, index int) (ItemMapping, map[string]any, error) {\n61|\towner := fmt.Sprintf(\"projection item mapping[%d]\", index)\n62|\tif !validText(input.SourceItemKey) {\n63|\t\treturn ItemMapping{}, nil, invalid(\"%s source_item_key is not valid UTF-8\", owner)\n64|\t}\n65|\tif length := stringLength(input.SourceItemKey); length < 1 || length > 512 {\n66|\t\treturn ItemMapping{}, nil, invalid(\"%s source_item_key is not a string[1..512]\", owner)\n67|\t}\n68|\tvar canonical *scalar.Digest\n69|\tvar canonicalValue any\n70|\tif input.CanonicalObjectID != nil {\n71|\t\tid, err := scalar.ParseDigest(*input.CanonicalObjectID)\n72|\t\tif err != nil {\n73|\t\t\treturn ItemMapping{}, nil, invalid(\"%s canonical_object_id is not a digest: %v\", owner, err)\n74|\t\t}\n75|\t\tcanonical = &id\n76|\t\tcanonicalValue = id.String()\n77|\t}\n78|\tkeys, err := checkSortedUniqueBoundedStrings(input.TargetResourceKey, 1, 512, 0, 65536, owner, \"target_resource_keys\")\n79|\tif err != nil {\n80|\t\treturn ItemMapping{}, nil, err\n81|\t}\n82|\tif !validText(input.ExpectedDispos) {\n83|\t\treturn ItemMapping{}, nil, invalid(\"%s expected_disposition is not valid UTF-8\", owner)\n84|\t}\n85|\tif !clonefidelity.ValidDisposition(input.ExpectedDispos) {\n86|\t\treturn ItemMapping{}, nil, invalid(\"%s expected_disposition is outside exact|semantic|summarized|opaque_preserved|synthesized|omitted|unrecoverable\", owner)\n87|\t}\n88|\treasons, err := checkSortedUniqueReasonStrings(input.ReasonCodes, 0, 128, owner)\n89|\tif err != nil {\n90|\t\treturn ItemMapping{}, nil, err\n91|\t}\n92|\tif _, err := clonebundle.EncodeExtensions(input.Extensions); err != nil {\n93|\t\treturn ItemMapping{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n94|\t}\n95|\textensions := input.Extensions\n96|\tif extensions == nil {\n97|\t\textensions = map[string]any{}\n98|\t}\n99|\treturn ItemMapping{\n100|\t\t\tSourceItemKey:     input.SourceItemKey,\n(more lines below)","final_result":true}}}
