{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cd1f","stream":{"kind":"session","id":"01a0d24d-9c2d-7841-a066-6ac00d915ab7"},"sequence":1258,"recorded_at":1780531400002511,"record_type":"event","durability":"durable","causation_id":"6722cf1c-e919-40c8-89ba-6768c67dec7c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6722cf1c-e919-40c8-89ba-6768c67dec7c","run_stream":{"kind":"run","id":"6722cf1c-e919-40c8-89ba-6768c67dec7c"},"task_stream":{"kind":"task","id":"01a0d253-39bb-70d0-a5c1-7db45d17769d"},"task_id":"01a0d253-39bb-70d0-a5c1-7db45d17769d","event":{"kind":"output","task_id":"01a0d253-39bb-70d0-a5c1-7db45d17769d","chunk":"Read text file `internal/clonebundle/event.go`.\n(339 line(s) above)\n340|\n341|// checkEvidenceCoupling enforces the synthesized rule: synthesized\n342|// requires a null native Event ID and a non-null core operation\n343|// identifying the core operation; all other statuses require a\n344|// null core operation.\n345|func checkEvidenceCoupling(status string, hasNativeEvent, hasOperation bool) error {\n346|\tif status == \"synthesized\" {\n347|\t\tif hasNativeEvent {\n348|\t\t\treturn invalid(\"source evidence synthesized carries a native event ID\")\n349|\t\t}\n350|\t\tif !hasOperation {\n351|\t\t\treturn invalid(\"source evidence synthesized requires a core operation\")\n352|\t\t}\n353|\t\treturn nil\n354|\t}\n355|\tif hasOperation {\n356|\t\treturn invalid(\"source evidence %s carries a core operation\", status)\n357|\t}\n358|\treturn nil\n359|}\n360|\n361|var canonicalEventMembers = map[string]bool{\n362|\t\"schema\": true, \"schema_version\": true, \"event_id\": true,\n363|\t\"logical_session_id\": true, \"ordinal\": true, \"parents\": true,\n364|\t\"actor_id\": true, \"turn_id\": true, \"kind\": true, \"timestamp\": true,\n365|\t\"visibility\": true, \"payload\": true, \"source_evidence\": true, \"extensions\": true,\n366|}\n367|\n368|var canonicalEventRequired = []string{\n369|\t\"schema\", \"schema_version\", \"event_id\",\n370|\t\"logical_session_id\", \"ordinal\", \"parents\",\n371|\t\"actor_id\", \"turn_id\", \"kind\", \"timestamp\",\n372|\t\"visibility\", \"payload\", \"source_evidence\", \"extensions\",\n373|}\n374|\n375|// CanonicalEvent is one validated Canonical Event. Payload carries\n376|// the validated closed payload object.\n377|type CanonicalEvent struct {\n378|\tEventID          scalar.Digest\n379|\tLogicalSessionID scalar.UUIDv7\n380|\tOrdinal          uint64\n381|\tParents          []scalar.Digest\n382|\tActorID          scalar.UUIDv7\n383|\tTurnID           *scalar.UUIDv7\n384|\tKind             string\n385|\tTimestamp        *scalar.Timestamp\n386|\tVisibility       string\n387|\tPayload          map[string]any\n388|\tEvidence         SourceEvidence\n389|}\n390|\n391|// RawRefInput is one caller-supplied raw reference candidate.\n392|type RawRefInput struct {\n393|\tManifestID       string\n394|\tBlobDescriptorID string\n395|\tOffset           uint64\n396|\tLength           uint64\n397|}\n398|\n399|// EvidenceInput is one caller-supplied source evidence candidate\n400|// for Build.\n401|type EvidenceInput struct {\n402|\tEnvironment     []byte\n403|\tNativeSessionID string\n404|\tNativeEventID   *string\n405|\tNativeType      *string\n406|\tRawRefs         []RawRefInput\n407|\tCaptureStatus   string\n408|\tReasonCodes     []string\n409|\tCoreOperationID *string\n410|}\n411|\n412|// CanonicalEventInput is the caller-supplied canonical event\n413|// candidate for Build. Payload carries the exact closed payload\n414|// object bytes; Build validates them under the kind-selected rules.\n415|type CanonicalEventInput struct {\n416|\tLogicalSessionID string\n417|\tOrdinal          uint64\n418|\tParents          []string\n419|\tActorID          string\n420|\tTurnID           *string\n421|\tKind             string\n422|\tTimestamp        *string\n423|\tVisibility       string\n424|\tPayload          []byte\n425|\tEvidence         EvidenceInput\n426|\tExtensions       map[string]any\n427|}\n428|\n429|// BuildCanonicalEvent constructs one closed Canonical Event 1.0.0\n430|// as canonical bytes. Identical inputs produce byte-identical\n431|// outputs.\n432|func BuildCanonicalEvent(input CanonicalEventInput) ([]byte, error) {\n433|\tobject, err := buildCanonicalEvent(input)\n434|\tif err != nil {\n435|\t\treturn nil, err\n436|\t}\n437|\tomitted, err := canonicalizeObject(object)\n438|\tif err != nil {\n439|\t\treturn nil, err\n440|\t}\n441|\teventID := scalar.SHA256Digest(omitted)\n442|\tobject[canonicalEventSelf] = eventID.String()\n443|\treturn canonicalizeObject(object)\n444|}\n445|\n446|func buildCanonicalEvent(input CanonicalEventInput) (map[string]any, error) {\n447|\tlogical, err := scalar.ParseUUIDv7(input.LogicalSessionID)\n448|\tif err != nil {\n449|\t\treturn nil, invalid(\"canonical event logical_session_id is not a UUIDv7: %v\", err)\n(more lines below)","final_result":true}}}
