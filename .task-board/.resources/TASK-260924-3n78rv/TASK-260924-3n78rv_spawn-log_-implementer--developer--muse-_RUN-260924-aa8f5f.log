 PlanStrategies returns the exact four-member plan strategy\n37|// vocabulary in specification order. Callers iterate the returned\n38|// copy; the table above stays the single owner.\n39|func PlanStrategies() []string {\n40|\tout := make([]string, len(planStrategies))\n41|\tcopy(out, planStrategies)\n42|\treturn out\n43|}\n44|\n45|// planProfiles is the exact four-member profile vocabulary the\n46|// Projection Plan 1.0.0 table states: strict_exact|maximal_safe|\n47|// compact|messages_only. The fifth Section 13.14.2 profile,\n48|// archive_only, is refused on a plan.\n49|var planProfiles = []string{\n50|\t\"strict_exact\",\n51|\t\"maximal_safe\",\n52|\t\"compact\",\n53|\t\"messages_only\",\n54|}\n55|\n56|// ValidPlanProfile reports whether the name is a projection plan\n57|// fidelity profile.\n58|func ValidPlanProfile(profile string) bool {\n59|\tfor _, allowed := range planProfiles {\n60|\t\tif profile == allowed {\n61|\t\t\treturn true\n62|\t\t}\n63|\t}\n64|\treturn false\n65|}\n66|\n67|// PlanProfiles returns the exact four-member plan profile\n68|// vocabulary in specification order. Callers iterate the returned\n69|// copy; the table above stays the single owner.\n70|func PlanProfiles() []string {\n71|\tout := make([]string, len(planProfiles))\n72|\tcopy(out, planProfiles)\n73|\treturn out\n74|}\n75|\n76|// operationActions is the exact four-member action vocabulary\n77|// Section 13.14.2 states for ProjectionTargetOperation:\n78|// create_directory|write_blob|write_native_record|rebuild_index.\n79|var operationActions = []string{\n80|\t\"create_directory\",\n81|\t\"write_blob\",\n82|\t\"write_native_record\",\n83|\t\"rebuild_index\",\n84|}\n85|\n86|// ValidOperationAction reports whether the name is a target\n87|// operation action.\n88|func ValidOperationAction(action string) bool {\n89|\tfor _, allowed := range operationActions {\n90|\t\tif action == allowed {\n91|\t\t\treturn true\n92|\t\t}\n93|\t}\n94|\treturn false\n95|}\n96|\n97|// OperationActions returns the exact four-member action vocabulary\n98|// in specification order. Callers iterate the returned copy; the\n99|// table above stays the single owner.\n100|func OperationActions() []string {\n101|\tout := make([]string, len(operationActions))\n102|\tcopy(out, operationActions)\n103|\treturn out\n104|}\n105|\n106|// synthesizedPurposes is the exact three-member purpose vocabulary\n107|// Section 13.14.2 states for SynthesizedProjectionEvent:\n108|// migration_checkpoint|summary|delimiter.\n109|var synthesizedPurposes = []string{\n110|\t\"migration_checkpoint\",\n111|\t\"summary\",\n112|\t\"delimiter\",\n113|}\n114|\n115|// ValidSynthesizedPurpose reports whether the name is a synthesized\n116|// projection event purpose.\n117|func ValidSynthesizedPurpose(purpose string) bool {\n118|\tfor _, allowed := range synthesizedPurposes {\n119|\t\tif purpose == allowed {\n120|\t\t\treturn true\n121|\t\t}\n122|\t}\n123|\treturn false\n124|}\n125|\n126|// SynthesizedPurposes returns the exact three-member purpose\n127|// vocabulary in specification order. Callers iterate the returned\n128|// copy; the table above stays the single owner.\n129|func SynthesizedPurposes() []string {\n130|\tout := make([]string, len(synthesizedPurposes))\n131|\tcopy(out, synthesizedPurposes)\n132|\treturn out\n133|}\n134|\n135|// resourceKinds is the exact two-member kind vocabulary Section\n136|// 13.14.2 states for ExpectedTargetResource and\n137|// ProjectedObjectEntry: blob|directory.\n138|var resourceKinds = []string{\n139|\t\"blob\",\n140|\t\"directory\",\n141|}\n142|\n143|// ValidResourceKind reports whether the name is a target resource\n144|// kind.\n145|func ValidResourceKind(kind string) bool {\n146|\tfor _, allowed := range resourceKinds {\n147|\t\tif kind == allowed {\n148|\t\t\treturn true\n149|\t\t}\n150|\t}\n151|\treturn false\n152|}\n153|\n154|// ResourceKinds returns the exact two-member kind vocabulary in\n155|// specification order. Callers iterate the returned copy; the table\n156|// above stays the single owner.\n157|func ResourceKinds() []string {\n158|\tout := make([]string, len(resourceKinds))\n159|\tcopy(out, resourceKinds)\n160|\treturn out\n161|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
