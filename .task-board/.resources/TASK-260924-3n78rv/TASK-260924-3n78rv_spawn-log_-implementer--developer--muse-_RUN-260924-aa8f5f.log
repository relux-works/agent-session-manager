\t\"tool_result\",\n38|\t\"approval_request\",\n39|\t\"approval_response\",\n40|\t\"plan_update\",\n41|\t\"progress\",\n42|\t\"usage\",\n43|\t\"rate_limit\",\n44|\t\"file_change\",\n45|\t\"compaction\",\n46|\t\"turn_started\",\n47|\t\"turn_completed\",\n48|\t\"turn_aborted\",\n49|\t\"subagent_started\",\n50|\t\"subagent_completed\",\n51|\t\"error\",\n52|\t\"migration_checkpoint\",\n53|\t\"session_finished\",\n54|\t\"opaque_event\",\n55|}\n56|\n57|// ValidEventKind reports whether the name is a canonical event kind.\n58|func ValidEventKind(kind string) bool {\n59|\tfor _, allowed := range eventKinds {\n60|\t\tif kind == allowed {\n61|\t\t\treturn true\n62|\t\t}\n63|\t}\n64|\treturn false\n65|}\n66|\n67|// EventKinds returns the exact 26-kind event vocabulary Section\n68|// 13.14.1 states, in specification order. Sibling packages iterate\n69|// the returned copy so closed maps over every kind keep one owner;\n70|// callers must not retain and mutate across calls.\n71|func EventKinds() []string {\n72|\tkinds := make([]string, len(eventKinds))\n73|\tcopy(kinds, eventKinds)\n74|\treturn kinds\n75|}\n76|\n77|func validVisibility(visibility string) bool {\n78|\tswitch visibility {\n79|\tcase \"public\", \"projection\", \"internal\", \"opaque\":\n80|\t\treturn true\n81|\tdefault:\n82|\t\treturn false\n83|\t}\n84|}\n85|\n86|func validCaptureStatus(status string) bool {\n87|\tswitch status {\n88|\tcase \"exact\", \"partial\", \"synthesized\", \"unavailable\":\n89|\t\treturn true\n90|\tdefault:\n91|\t\treturn false\n92|\t}\n93|}\n94|\n95|// contentBlockTypes is the exact message-like content-block\n96|// vocabulary: text|json|image|audio|document|resource_link|redacted|opaque.\n97|var contentBlockTypes = []string{\n98|\t\"text\",\n99|\t\"json\",\n100|\t\"image\",\n101|\t\"audio\",\n102|\t\"document\",\n103|\t\"resource_link\",\n104|\t\"redacted\",\n105|\t\"opaque\",\n106|}\n107|\n108|func validContentBlockType(blockType string) bool {\n109|\tfor _, allowed := range contentBlockTypes {\n110|\t\tif blockType == allowed {\n111|\t\t\treturn true\n112|\t\t}\n113|\t}\n114|\treturn false\n115|}\n116|\n117|// ValidContentBlockType reports whether the name is a message-like\n118|// content-block type. It delegates to the single Section 13.14.1\n119|// table above so sibling packages share one vocabulary owner.\n120|func ValidContentBlockType(blockType string) bool {\n121|\treturn validContentBlockType(blockType)\n122|}\n123|\n124|// ContentBlockTypes returns the exact message-like content-block\n125|// vocabulary Section 13.14.1 states, in specification order.\n126|// Sibling packages iterate the returned copy so closed maps over\n127|// every type keep one owner; callers must not retain and mutate\n128|// across calls.\n129|func ContentBlockTypes() []string {\n130|\ttypes := make([]string, len(contentBlockTypes))\n131|\tcopy(types, contentBlockTypes)\n132|\treturn types\n133|}\n134|\n135|// messageLikeKind reports whether the kind carries a message-like\n136|// payload: user and assistant messages always do. Other kinds may\n137|// carry content blocks under the same block rules, but only these\n138|// two require them.\n139|func messageLikeKind(kind string) bool {\n140|\treturn kind == \"user_message\" || kind == \"assistant_message\"\n(more lines below)","final_result":true}}}
