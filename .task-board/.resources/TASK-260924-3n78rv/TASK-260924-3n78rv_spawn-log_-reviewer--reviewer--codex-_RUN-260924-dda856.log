ype ProjectRequest struct {\\ninternal/clonesnap/project.go:72:type ProjectResult struct {\\ninternal/clonesnap/project.go:89:func CaptureAndProject(request ProjectRequest) (*ProjectResult, error) {\\ninternal/clonesnap/project.go:156:func AdmitForTarget(captureManifest []byte, profile string) (clonebundle.CaptureManifest, error) {\\ninternal/clonesnap/project.go:183:func BuildAdmissionReceipt(rawManifestID, captureManifestID scalar.Digest, profile string) ([]byte, error) {\\ninternal/clonesnap/walk.go:38:type PlanItem struct {\\ninternal/clonesnap/workspace.go:30:type WorkspaceRequest struct {\\ninternal/clonesnap/workspace.go:47:func CheckpointWorkspace(request WorkspaceRequest) ([]byte, error) {\\n===\\nmutant_harness.py\\n===\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"Narrowing-mutant harness for internal/cloneplan.\\n\\nEvery gate ships a narrowing mutant: the gate stays present and is\\nweakened to admit exactly one member of the class it must reject, and\\nthe named killer test must fail. A delete-only mutant proves only that\\nthe gate exists and is not accepted as evidence.\\n\\nEach row runs M (mutate one production file in place), R (run the\\nscoped Go killer through a production entry), V (verdict from the Go\\nexit code plus a FAIL kill-line: KILLED iff R fails with a test\\nfailure line, SURVIVED iff R passes, ERROR for anything else --\\nunapplied patches, build breaks, timeouts). M failures and R\\ninfrastructure errors are ERROR, never kills or survivals. The file\\nis restored from its backup after every row, pass or fail.\\n\\nShared gates (one implementation, two call sites: the vocabulary\\npredicates, the strict frame, the member census helpers, the order\\nhelpers, the DAG gate, the branch gates, the factored count gates,\\nthe modes constant) carry one plant each with a killer that drives\\nthe production entries. Rules implemented twice (build + decode)\\ncarry one plant per side.\\n\\nRows N-strategy-route and N-action-route are the token-preserving\\nattacks: the searched-for token still matches the vocabulary table,\\nbut the entry decision changes, and the killers execute the\\nbehavioral oracle suites through both entries.\\n\\nSingle-member-class rows narrow a gate whose reject class holds\\nexactly one member, so the plant admits the whole class, which is\\none member.\\n\\nRow C-doc-comment is the harmless control: a comment-only edit that\\nmust SURVIVE, proving the harness observes test outcomes instead of\\nhard-coding kills.\\n\\nUsage:\\n  PYTHONDONTWRITEBYTECODE=1 python3 internal/cloneplan/testdata/mutant_harness.py [--log-dir DIR] [MUTANT ...]\\n\\\"\\\"\\\"\\n\\nimport shutil\\nimport subprocess\\nimport sys\\nimport tempfile\\nimport time\\nfrom dataclasses import dataclass\\nfrom pathlib import Path\\n\\nREPO = Path(__file__).resolve().parents[3]\\nPACKAGE = \\\"internal/cloneplan\\\"\\n\\n\\n@dataclass(frozen=True)\\nclass Mutant:\\n    name: str\\n    path: str\\n    find: str\\n    replace: str\\n    count: int\\n    run: str\\n    expect: str\\n    note: str\\n\\n\\nMUTANTS = [\\n    Mutant(\\n        name=\\\"N-strategy-vocab\\\",\\n        path=f\\\"{PACKAGE}/vocab.go\\\",\\n        find='''func ValidPlanStrategy(strategy string) bool {\\\\n\\\\tfor _, allowed := range planStrategies {\\\\n\\\\t\\\\tif strategy == allowed {\\\\n\\\\t\\\\t\\\\treturn true\\\\n\\\\t\\\\t}\\\\n\\\\t}\\\\n\\\\treturn false\\\\n}''',\\n        replace='''func ValidPlanStrategy(strategy string) bool {\\\\n\\\\tfor _, allowed := range planStrategies {\\\\n\\\\t\\\\tif strategy == allowed {\\\\n\\\\t\\\\t\\\\treturn true\\\\n\\\\t\\\\t}\\\\n\\\\t}\\\\n\\\\tif strategy == \\\"archive_only\\\" {\\\\n\\\\t\\\\treturn true\\\\n\\\\t}\\\\n\\\\treturn false\\\\n}''',\\n        count=1,\\n        run=\\\"TestPlanStrategyOracle\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Shared gate: admits exactly archive_only past the plan strategy vocabulary at both entries.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-profile-vocab\\\",\\n        path=f\\\"{PACKAGE}/vocab.go\\\",\\n        find='''func ValidPlanProfile(profile string) bool {\\\\n\\\\tfor _, allowed := range planProfiles {\\\\n\\\\t\\\\tif profile == allowed {\\\\n\\\\t\\\\t\\\\treturn true\\\\n\\\\t\\\\t}\\\\n\\\\t}\\\\n\\\\treturn false\\\\n}''',\\n        replace='''func ValidPlanProfile(profile string) bool {\\\\n\\\\tfor _, allowed := range planProfiles {\\\\n\\\\t\\\\tif profile == allowed {\\\\n\\\\t\\\\t\\\\treturn true\\\\n\\\\t\\\\t}\\\\n\\\\t}\\\\n\\\\tif profile == \\\"archive_only\\\" {\\\\n\\\\t\\\\treturn true\\\\n\\\\t}\\\\n\\\\treturn false\\\\n}''',\\n\",\n  \"original_output_bytes\": 4787,\n  \"original_output_tokens\": 1197,\n  \"truncated\": false\n}","final_result":true}}}
