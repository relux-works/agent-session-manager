ce Release an element whose acceptance §6.2 already invalidated back to rework\\n  repair                Re-materialize a recorded workspace whose worktree is missing\\n  status                Report managed Story workspaces and what blocks their cleanup\\n  transaction           Inspect and dispose of a refused or abandoned integration transaction\\n\\nFlags:\\n  -h, --help   help for worktree\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\\nUse \\\"task-board worktree [command] --help\\\" for more information about a command.\\n===\\n{\\n \\\"subject\\\": {\\n  \\\"element_id\\\": \\\"TASK-260830-7a0s2c\\\",\\n  \\\"element_type\\\": \\\"task\\\"\\n },\\n \\\"boundary\\\": {\\n  \\\"version\\\": \\\"activity-history-boundary.v1\\\",\\n  \\\"kind\\\": \\\"legacy_pre_feature\\\",\\n  \\\"established_at\\\": \\\"2026-09-06T16:09:05.987355Z\\\",\\n  \\\"implicit\\\": true\\n },\\n \\\"events\\\": [\\n  {\\n   \\\"version\\\": \\\"activity-event.v1\\\",\\n   \\\"id\\\": \\\"AEV-260906-44075570c0722f3755958794\\\",\\n   \\\"sequence\\\": 226,\\n   \\\"timestamp\\\": \\\"2026-09-06T18:14:54.285658Z\\\",\\n   \\\"actor\\\": {\\n    \\\"principal\\\": {\\n     \\\"availability\\\": \\\"unknown\\\"\\n    },\\n    \\\"agent\\\": {\\n     \\\"availability\\\": \\\"known\\\",\\n     \\\"value\\\": \\\"claude\\\"\\n    },\\n    \\\"run\\\": {\\n     \\\"availability\\\": \\\"known\\\",\\n     \\\"value\\\": \\\"RUN-260906-6e4729\\\"\\n    },\\n    \\\"session\\\": {\\n     \\\"availability\\\": \\\"known\\\",\\n     \\\"value\\\": \\\"6d2e8b01-2cc4-4e49-994a-05938b6ce680\\\"\\n    },\\n    \\\"operator\\\": {\\n     \\\"availability\\\": \\\"unknown\\\"\\n    }\\n   },\\n   \\\"subject\\\": {\\n    \\\"element_id\\\": \\\"TASK-260830-7a0s2c\\\",\\n    \\\"element_type\\\": \\\"task\\\"\\n   },\\n   \\\"source\\\": {\\n    \\\"kind\\\": \\\"local_cli\\\",\\n    \\\"entrypoint\\\": \\\"cmd.ledgerMirror\\\",\\n    \\\"request\\\": {\\n     \\\"availability\\\": \\\"unknown\\\"\\n    }\\n   },\\n   \\\"correlation_id\\\": \\\"COR-260906-a54bac8b0ef706ae542cd0f2\\\",\\n   \\\"causal_order\\\": 1,\\n   \\\"operation\\\": \\\"change_request\\\",\\n   \\\"changes\\\": [\\n    {\\n     \\\"field\\\": \\\"ledger_event\\\",\\n     \\\"after\\\": {\\n      \\\"kind\\\": \\\"ledger\\\",\\n      \\\"ledger\\\": {\\n       \\\"domain\\\": \\\"change_request\\\",\\n       \\\"ledger_id\\\": \\\"CR-TASK-260830-7a0s2c-3\\\",\\n       \\\"event\\\": \\\"transitioned\\\",\\n       \\\"sequence\\\": 5,\\n       \\\"revision\\\": 3,\\n       \\\"from_state\\\": \\\"accepted\\\",\\n       \\\"to_state\\\": \\\"checkpointed\\\",\\n       \\\"recorded_at\\\": \\\"2026-09-06T18:14:54.270287Z\\\"\\n      }\\n     }\\n    }\\n   ]\\n  },\\n  {\\n   \\\"version\\\": \\\"activity-event.v1\\\",\\n   \\\"id\\\": \\\"AEV-260906-a8a24bc92387b46f26bf89d4\\\",\\n   \\\"sequence\\\": 225,\\n   \\\"timestamp\\\": \\\"2026-09-06T18:14:44.849521Z\\\",\\n   \\\"actor\\\": {\\n    \\\"principal\\\": {\\n     \\\"availability\\\": \\\"unknown\\\"\\n    },\\n    \\\"agent\\\": {\\n     \\\"availability\\\": \\\"known\\\",\\n     \\\"value\\\": \\\"claude\\\"\\n    },\\n    \\\"run\\\": {\\n     \\\"availability\\\": \\\"unknown\\\"\\n    },\\n    \\\"session\\\": {\\n     \\\"availability\\\": \\\"known\\\",\\n     \\\"value\\\": \\\"6d2e8b01-2cc4-4e49-994a-05938b6ce680\\\"\\n    },\\n    \\\"operator\\\": {\