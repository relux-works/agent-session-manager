{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8d3","stream":{"kind":"session","id":"01a077c8-d88a-7931-843c-3e9dddbe9444"},"sequence":708,"recorded_at":1780531400001411,"record_type":"event","durability":"durable","causation_id":"d502244e-0589-4672-9c20-02af4f4b0b68","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d502244e-0589-4672-9c20-02af4f4b0b68","run_stream":{"kind":"run","id":"d502244e-0589-4672-9c20-02af4f4b0b68"},"task_stream":{"kind":"task","id":"86238197-5cff-4648-af14-57a46beb6743"},"task_id":"86238197-5cff-4648-af14-57a46beb6743","event":{"kind":"output","task_id":"86238197-5cff-4648-af14-57a46beb6743","chunk":"Read text file `internal/secconftest/crash_test.go`.\n(193 line(s) above)\n194|\n195|func TestTransactorRecoversAfterFault(t *testing.T) {\n196|\tt.Parallel()\n197|\troot := t.TempDir()\n198|\tinjector := &Injector{}\n199|\ttransactor := NewTransactor(injector, root)\n200|\tinjector.Arm(PointPrepareCommit)\n201|\tif _, err := transactor.Prepare(\"r\", []byte(\"body-r\")); err == nil {\n202|\t\tt.Fatal(\"armed prepare-commit passed; the fault never fired\")\n203|\t}\n204|\t// The fault consumed its arm and cleaned the staging file, so the\n205|\t// identical retry must proceed and commit byte-exact bytes.\n206|\treceipt, err := transactor.Prepare(\"r\", []byte(\"body-r\"))\n207|\tif err != nil {\n208|\t\tt.Fatalf(\"retry after fault: %v\", err)\n209|\t}\n210|\tif _, err := transactor.Commit(\"r\"); err != nil {\n211|\t\tt.Fatalf(\"commit after recovery: %v\", err)\n212|\t}\n213|\treadBack, err := transactor.CommittedBytes(\"r\")\n214|\tif err != nil || string(readBack) != \"body-r\" {\n215|\t\tt.Fatalf(\"recovered bytes = %q, %v; want the exact staged body\", readBack, err)\n216|\t}\n217|\t_ = receipt\n218|}\n219|\n220|func TestTransactorRefusesRollbackPastFinalize(t *testing.T) {\n221|\tt.Parallel()\n222|\troot := t.TempDir()\n223|\ttransactor := NewTransactor(&Injector{}, root)\n224|\tif err := transactor.Rollback(\"ghost\"); err == nil {\n225|\t\tt.Fatal(\"rollback without prepare succeeded\")\n226|\t}\n227|\tif _, err := transactor.Prepare(\"f\", []byte(\"body-f\")); err != nil {\n228|\t\tt.Fatalf(\"Prepare: %v\", err)\n229|\t}\n230|\tif err := transactor.Rollback(\"f\"); err != nil {\n231|\t\tt.Fatalf(\"pre-commit rollback: %v\", err)\n232|\t}\n233|\tif _, err := os.Stat(filepath.Join(root, \"f.staged\")); !os.IsNotExist(err) {\n234|\t\tt.Fatal(\"rollback left staged bytes behind\")\n235|\t}\n236|\t// The arm this test is named for: a clean Commit finalizes the\n237|\t// operation (AC-CLONE-005), so rollback past it must fail and the\n238|\t// committed bytes must survive the refused call untouched.\n239|\tbody := []byte(\"body-final\")\n240|\tif _, err := transactor.Prepare(\"g\", body); err != nil {\n241|\t\tt.Fatalf(\"Prepare: %v\", err)\n242|\t}\n243|\tif _, err := transactor.Commit(\"g\"); err != nil {\n244|\t\tt.Fatalf(\"Commit: %v\", err)\n245|\t}\n246|\tif err := transactor.Rollback(\"g\"); !errors.Is(err, ErrRollbackPastFinalize) {\n247|\t\tt.Fatalf(\"post-commit rollback = %v, want %v\", err, ErrRollbackPastFinalize)\n248|\t}\n249|\treadBack, err := transactor.CommittedBytes(\"g\")\n250|\tif err != nil || string(readBack) != string(body) {\n251|\t\tt.Fatalf(\"refused rollback deleted the committed bytes: %q, %v\", readBack, err)\n252|\t}\n253|}\n254|\n255|func TestTransactorCommitRequiresPrepare(t *testing.T) {\n256|\tt.Parallel()\n257|\troot := t.TempDir()\n258|\ttransactor := NewTransactor(&Injector{}, root)\n259|\t// No receipt and no staged file: the refusal must name the\n260|\t// missing prepare, not merely inherit a filesystem error.\n261|\tif _, err := transactor.Commit(\"ghost\"); err == nil || !strings.Contains(err.Error(), \"without prepare\") {\n262|\t\tt.Fatalf(\"commit without prepare = %v, want the without-prepare refusal\", err)\n263|\t}\n264|\t// A planted staged file with no receipt: the filesystem would\n265|\t// admit this commit, so only the prepare check refuses it.\n266|\tif err := os.WriteFile(filepath.Join(root, \"planted.staged\"), []byte(\"x\"), 0o600); err != nil {\n267|\t\tt.Fatalf(\"plant staged file: %v\", err)\n268|\t}\n269|\tif _, err := transactor.Commit(\"planted\"); err == nil || !strings.Contains(err.Error(), \"without prepare\") {\n270|\t\tt.Fatalf(\"commit with staged bytes but no prepare = %v, want the without-prepare refusal\", err)\n271|\t}\n272|\tif _, err := os.Stat(filepath.Join(root, \"planted.committed\")); !os.IsNotExist(err) {\n273|\t\tt.Fatal(\"refused commit left committed bytes behind\")\n274|\t}\n275|}\n276|\n277|func TestInjectorArmedPointIsConsumedByTheDrive(t *testing.T) {\n278|\tt.Parallel()\n279|\tinjector := &Injector{}\n280|\tinjector.Arm(PointPrepareEnter)\n281|\tinjector.Arm(PointCommitApply)\n282|\tif got := injector.RemainingArmed(); len(got) != 2 {\n283|\t\tt.Fatalf(\"RemainingArmed = %q, want the two armed points\", got)\n284|\t}\n285|\tif err := injector.MaybeFail(PointPrepareEnter); err == nil {\n286|\t\tt.Fatal(\"armed point did not fire\")\n287|\t}\n288|\tif got := injector.RemainingArmed(); len(got) != 1 || got[0] != PointCommitApply {\n289|\t\tt.Fatalf(\"RemainingArmed = %q, want exactly [%q]\", got, PointCommitApply)\n290|\t}\n291|\tinjector.Disarm()\n292|\tif got := injector.RemainingArmed(); len(got) != 0 {\n293|\t\tt.Fatalf(\"RemainingArmed after Disarm = %q, want empty\", got)\n294|\t}\n295|}\n296|\n297|func TestCrashPointVocabularyIsPinned(t *testing.T) {\n298|\tt.Parallel()\n299|\t// The five point names are instrument-local phase boundaries, not\n300|\t// the SPEC registry: CR-MAT-01..08 names nothing here, and a\n301|\t// registry-style name must be refused as unknown rather than armed\n302|\t// silently. Adding a sixth point without extending this list must\n303|\t// fail the Classify arm below only if it is wired; the residual\n304|\t// bound (a new site without an arm) is stated in doc.go.\n305|\twant := map[string]Outcome{\n306|\t\tPointPrepareEnter:  OutcomeSafeRetry,\n307|\t\tPointPrepareCommit: OutcomeExplicitRollback,\n308|\t\tPointCommitEnter:   OutcomeExplicitRollback,\n309|\t\tPointCommitApply:   OutcomeRecoverableParked,\n310|\t\tPointRollbackEnter: OutcomeExplicitRollback,\n311|\t}\n312|\tif len(want) != 5 {\n313|\t\tt.Fatalf(\"vocabulary has %d points, want exactly 5\", len(want))\n314|\t}\n315|\tfor point, outcome := range want {\n316|\t\tif got, err := Classify(point); err != nil || got != outcome {\n317|\t\t\tt.Errorf(\"Classify(%q) = %v, %v; want %v\", point, got, err, outcome)\n318|\t\t}\n319|\t}\n320|\tfor _, registry := range []string{\"CR-MAT-01\", \"CR-MAT-08\", \"CR-MAT-09\", \"CR-MAT-prepare\"} {\n321|\t\tif _, err := Classify(registry); err == nil {\n322|\t\t\tt.Errorf(\"Classify(%q) succeeded; the SPEC registry is not this vocabulary\", registry)\n323|\t\t}\n(more lines below)"}}}
