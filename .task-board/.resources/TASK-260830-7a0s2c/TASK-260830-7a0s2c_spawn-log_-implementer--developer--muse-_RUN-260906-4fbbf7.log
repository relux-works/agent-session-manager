{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4c5","stream":{"kind":"session","id":"01a077c8-d88a-7931-843c-3e9dddbe9444"},"sequence":189,"recorded_at":1780531400000373,"record_type":"event","durability":"durable","causation_id":"d502244e-0589-4672-9c20-02af4f4b0b68","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d502244e-0589-4672-9c20-02af4f4b0b68","run_stream":{"kind":"run","id":"d502244e-0589-4672-9c20-02af4f4b0b68"},"task_stream":{"kind":"task","id":"5bc54bc9-dc1b-4f14-8cee-5e8f1c75b8b3"},"task_id":"5bc54bc9-dc1b-4f14-8cee-5e8f1c75b8b3","event":{"kind":"output","task_id":"5bc54bc9-dc1b-4f14-8cee-5e8f1c75b8b3","chunk":"Read text file `internal/secconftest/skip_test.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"os\"\n5|\t\"path/filepath\"\n6|\t\"runtime\"\n7|\t\"strings\"\n8|\t\"testing\"\n9|\t\"time\"\n10|)\n11|\n12|func TestSkipDecideTable(t *testing.T) {\n13|\tt.Parallel()\n14|\tstrict := Capability{ID: \"strict-cap\", Probe: func() (bool, string) { return false, \"down\" }, StrictGOOS: []string{runtime.GOOS}}\n15|\tlax := Capability{ID: \"lax-cap\", Probe: func() (bool, string) { return false, \"down\" }, StrictGOOS: []string{\"plan9\"}}\n16|\tother := Capability{ID: \"other-cap\", Probe: func() (bool, string) { return false, \"down\" }}\n17|\tif got := decide(strict, true); got != decisionPass {\n18|\t\tt.Errorf(\"available strict capability decides %v, want pass\", got)\n19|\t}\n20|\tif got := decide(lax, true); got != decisionPass {\n21|\t\tt.Errorf(\"available lax capability decides %v, want pass\", got)\n22|\t}\n23|\tif got := decide(strict, false); got != decisionFail {\n24|\t\tt.Errorf(\"unavailable strict capability decides %v, want fail: an unexpected skip must not pass quietly\", got)\n25|\t}\n26|\tif got := decide(lax, false); got != decisionSkip {\n27|\t\tt.Errorf(\"unavailable lax capability decides %v, want skip\", got)\n28|\t}\n29|\tif got := decide(other, false); got != decisionSkip {\n30|\t\tt.Errorf(\"unavailable unlisted capability decides %v, want skip\", got)\n31|\t}\n32|\tif got := decide(Capability{}, false); got != decisionFail {\n33|\t\tt.Errorf(\"malformed capability decides %v, want fail\", got)\n34|\t}\n35|\tif got := decide(Capability{ID: \"no-probe\"}, false); got != decisionFail {\n36|\t\tt.Errorf(\"probeless capability decides %v, want fail\", got)\n37|\t}\n38|}\n39|\n40|func TestSkipDefaultProbesTerminate(t *testing.T) {\n41|\tt.Parallel()\n42|\tcapabilities := DefaultCapabilities()\n43|\tif len(capabilities) != 4 {\n44|\t\tt.Fatalf(\"DefaultCapabilities has %d entries, want 4\", len(capabilities))\n45|\t}\n46|\tseen := map[string]bool{}\n47|\tfor _, capability := range capabilities {\n48|\t\tif capability.ID == \"\" || capability.Probe == nil || capability.Detail == \"\" {\n49|\t\t\tt.Errorf(\"capability %+v is malformed\", capability)\n50|\t\t}\n51|\t\tif seen[capability.ID] {\n52|\t\t\tt.Errorf(\"duplicate capability %q\", capability.ID)\n53|\t\t}\n54|\t\tseen[capability.ID] = true\n55|\t\tok, reason := capability.Probe()\n56|\t\tif reason == \"\" {\n57|\t\t\tt.Errorf(\"capability %q probed without a reason\", capability.ID)\n58|\t\t}\n59|\t\tt.Logf(\"capability %q on %s: ok=%v (%s)\", capability.ID, runtime.GOOS, ok, reason)\n60|\t}\n61|}\n62|\n63|func TestSkipProbesAreDeterministic(t *testing.T) {\n64|\tt.Parallel()\n65|\tfor _, capability := range DefaultCapabilities() {\n66|\t\tfirst, _ := capability.Probe()\n67|\t\tsecond, _ := capability.Probe()\n68|\t\tif first != second {\n69|\t\t\tt.Errorf(\"capability %q probe flips: %v then %v\", capability.ID, first, second)\n70|\t\t}\n71|\t}\n72|}\n73|\n74|func TestSkipFifoFixtureExchangesBytes(t *testing.T) {\n75|\tt.Parallel()\n76|\t// The fifo probe gates this test: where the platform cannot\n77|\t// provide named pipes the test skips (Windows is not strict)\n78|\t// instead of passing over an unbuilt fixture.\n79|\tRequire(t, FifoCapability())\n80|\tdir := t.TempDir()\n81|\tpath, err := makeFifo(dir, \"exchange\")\n82|\tif err != nil {\n83|\t\tt.Fatalf(\"makeFifo: %v\", err)\n84|\t}\n85|\tinfo, err := os.Lstat(path)\n86|\tif err != nil {\n87|\t\tt.Fatalf(\"Lstat: %v\", err)\n88|\t}\n89|\tif info.Mode()&os.ModeNamedPipe == 0 {\n90|\t\tt.Fatalf(\"fixture %q is not a named pipe\", path)\n91|\t}\n92|\t// Negative control: a regular file beside the fifo must not\n93|\t// identify as one, so the suite can tell the kinds apart.\n94|\tcontrol := filepath.Join(dir, \"regular\")\n95|\tif err := os.WriteFile(control, []byte(\"x\"), 0o600); err != nil {\n96|\t\tt.Fatalf(\"write control: %v\", err)\n97|\t}\n98|\tcontrolInfo, err := os.Lstat(control)\n99|\tif err != nil {\n100|\t\tt.Fatalf(\"Lstat control: %v\", err)\n101|\t}\n102|\tif controlInfo.Mode()&os.ModeNamedPipe != 0 {\n103|\t\tt.Fatal(\"regular file identifies as a named pipe\")\n104|\t}\n105|\t// Byte exchange. A bare FIFO open blocks until the peer end\n106|\t// opens, so both ends open in goroutines and rendezvous in the\n107|\t// kernel; the main goroutine joins both with a timeout so a\n108|\t// broken fifo fails the test instead of hanging it. The byte\n109|\t// then moves synchronously with both ends held.\n110|\ttype openResult struct {\n111|\t\tfile *os.File\n112|\t\terr  error\n113|\t}\n114|\treaderCh := make(chan openResult, 1)\n115|\twriterCh := make(chan openResult, 1)\n116|\tgo func() {\n117|\t\treader, err := os.OpenFile(path, os.O_RDONLY, 0)\n118|\t\treaderCh <- openResult{reader, err}\n119|\t}()\n120|\tgo func() {\n121|\t\twriter, err := os.OpenFile(path, os.O_WRONLY, 0)\n122|\t\twriterCh <- openResult{writer, err}\n123|\t}()\n124|\ttimer := time.NewTimer(30 * time.Second)\n125|\tdefer timer.Stop()\n126|\tvar reader, writer *os.File\n127|\tfor range 2 {\n128|\t\tselect {\n129|\t\tcase result := <-readerCh:\n130|\t\t\tif result.err != nil {\n131|\t\t\t\tt.Fatalf(\"fifo read-end open: %v\", result.err)\n132|\t\t\t}\n133|\t\t\treader = result.file\n134|\t\tcase result := <-writerCh:\n135|\t\t\tif result.err != nil {\n136|\t\t\t\tt.Fatalf(\"fifo write-end open: %v\", result.err)\n137|\t\t\t}\n138|\t\t\twriter = result.file\n139|\t\tcase <-timer.C:\n140|\t\t\tt.Fatal(\"fifo open handshake blocked; the fixture does not exchange\")\n141|\t\t}\n142|\t}\n143|\tdefer func() { _ = reader.Close() }()\n144|\tdefer func() { _ = writer.Close() }()\n145|\tif _, err := writer.Write([]byte(\"p\")); err != nil {\n146|\t\tt.Fatalf(\"fifo write: %v\", err)\n147|\t}\n148|\tbuf := make([]byte, 1)\n149|\tn, err := reader.Read(buf)\n150|\tif err != nil || n != 1 || buf[0] != 'p' {\n151|\t\tt.Fatalf(\"fifo exchange read %d bytes %q, %v; want one byte %q\", n, buf, err, \"p\")\n152|\t}\n153|}\n154|\n155|func TestSkipFifoProbeAttemptsItsCapability(t *testing.T) {\n156|\t// Not parallel: it faults the fifo build seam. With the build\n157|\t// broken, the probe must report unavailable; a probe closure\n158|\t// hardened to constant true ignores the fault and fails here.\n159|\t// On a strict host (linux, darwin) the unbroken probe must hold:\n160|\t// absence there is unexpected and must fail, not skip.\n161|\treal := fifoBuild\n162|\tt.Cleanup(func() { fifoBuild = real })\n163|\tcapability := FifoCapability()\n164|\tif runtime.GOOS == \"windows\" {\n165|\t\tif ok, _ := capability.Probe(); ok {\n166|\t\t\tt.Fatal(\"fifo probe holds on Windows, where named-pipe fixtures are unavailable\")\n167|\t\t}\n168|\t\treturn\n169|\t}\n170|\tstrict := false\n171|\tfor _, goos := range capability.StrictGOOS {\n172|\t\tif goos == runtime.GOOS {\n173|\t\t\tstrict = true\n174|\t\t}\n175|\t}\n176|\tif !strict {\n177|\t\tt.Fatalf(\"fifo probe is not strict on %s; unexpected absence would skip quietly\", runtime.GOOS)\n178|\t}\n179|\tif ok, reason := capability.Probe(); !ok {\n180|\t\tt.Fatalf(\"fifo probe fails on strict host %s: %s\", runtime.GOOS, reason)\n181|\t}\n182|\tfifoBuild = func(dir, name string) (string, error) { return \"\", errTestSentinel }\n183|\tif ok, _ := capability.Probe(); ok {\n184|\t\tt.Fatal(\"fifo probe holds with its build broken; the probe attempts nothing\")\n185|\t}\n186|}\n187|\n188|func TestSkipModeBitsAndNonRootDenialsHold(t *testing.T) {\n189|\tt.Parallel()\n190|\t// Both probes gate this test. As superuser the first Require\n191|\t// skips (permission denials are untestable past the uid check);\n192|\t// where mode bits are unenforceable the second Require skips;\n193|\t// where both hold, the denial must be a permission error, not\n194|\t// merely any failure.\n195|\tRequire(t, NonRootCapability())\n196|\tRequire(t, ModeBitsCapability())\n197|\tdir := t.TempDir()\n198|\tpath := filepath.Join(dir, \"guarded\")\n199|\tif err := os.WriteFile(path, []byte(\"x\"), 0o600); err != nil {\n200|\t\tt.Fatalf(\"write: %v\", err)\n201|\t}\n202|\tif err := os.Chmod(path, 0); err != nil {\n203|\t\tt.Fatalf(\"chmod: %v\", err)\n204|\t}\n205|\tt.Cleanup(func() { _ = os.Chmod(path, 0o600) })\n206|\tfile, err := os.Open(path)\n207|\tif err == nil {\n208|\t\t_ = file.Close()\n209|\t\tt.Fatal(\"open succeeded despite mode 000; permission bits are not enforced here\")\n210|\t}\n211|\tif !os.IsPermission(err) {\n212|\t\tt.Fatalf(\"denial error %v is not a permission error\", err)\n213|\t}\n214|}\n215|\n216|func TestSkipReportReadsRecordedVerdicts(t *testing.T) {\n217|\t// Not parallel: it mutates the process-wide counters. It records\n218|\t// its own synthetic verdicts, asserts the report moves, then\n219|\t// restores the suite state — so the numbers below are evidence\n220|\t// that Report reads the live counters, not a constant. Gutting\n221|\t// recordVerdict leaves both assertions red.\n222|\tconst skipID = \"self-test-skip-probe\"\n223|\tconst failID = \"self-test-fail-probe\"\n224|\tbeforeSkipped, beforeFailed := snapshotReport()\n225|\tt.Cleanup(func() {\n226|\t\trestoreReport(beforeSkipped, beforeFailed)\n227|\t\tfor _, id := range SkippedIDs() {\n228|\t\t\tif id == skipID || id == failID {\n229|\t\t\t\tt.Errorf(\"synthetic verdict %q leaked into the suite counters\", id)\n230|\t\t\t}\n231|\t\t}\n232|\t})\n233|\trecordVerdict(Verdict{ID: skipID, Skipped: true, Reason: \"synthetic skip\"})\n234|\trecordVerdict(Verdict{ID: failID, Failed: true, Reason: \"synthetic failure\"})\n235|\tfound := false\n236|\tfor _, id := range SkippedIDs() {\n237|\t\tif id == skipID {\n238|\t\t\tfound = true\n239|\t\t}\n240|\t}\n241|\tif !found {\n242|\t\tt.Fatalf(\"SkippedIDs() = %q, want it to contain %q\", SkippedIDs(), skipID)\n243|\t}\n244|\treport := Report()\n245|\tif !strings.Contains(report, skipID) || !strings.Contains(report, failID) {\n246|\t\tt.Fatalf(\"Report() = %q, want it to carry both synthetic verdicts\", report)\n247|\t}\n248|\t// Attached evidence with real nonzero counters from this test's\n249|\t// own recorded verdicts.\n250|\tLogReport(t)\n251|\tt.Logf(\"skipped IDs: %q\", SkippedIDs())\n252|}"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4c7","stream":{"kind":"session","id":"01a077c8-d88a-7931-843c-3e9dddbe9444"},"sequence":190,"recorded_at":1780531400000375,"record_type":"event","durability":"durable","causation_id":"d502244e-0589-4672-9c20-02af4f4b0b68","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d502244e-0589-4672-9c20-02af4f4b0b68","run_stream":{"kind":"run","id":"d502244e-0589-4672-9c20-02af4f4b0b68"},"task_stream":{"kind":"task","id":"5bc54bc9-dc1b-4f14-8cee-5e8f1c75b8b3"},"task_id":"5bc54bc9-dc1b-4f14-8cee-5e8f1c75b8b3","event":{"kind":"completed","task_id":"5bc54bc9-dc1b-4f14-8cee-5e8f1c75b8b3"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4c9","stream":{"kind":"session","id":"01a077c8-d88a-7931-843c-3e9dddbe9444"},"sequence":191,"recorded_at":1780531400000377,"record_type":"event","durability":"durable","causation_id":"d502244e-0589-4672-9c20-02af4f4b0b68","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d502244e-0589-4672-9c20-02af4f4b0b68","run_stream":{"kind":"run","id":"d502244e-0589-4672-9c20-02af4f4b0b68"},"task_stream":{"kind":"task","id":"3d749b90-ee96-4096-b078-0214b7763eeb"},"task_id":"3d749b90-ee96-4096-b078-0214b7763eeb","event":{"kind":"output","task_id":"3d749b90-ee96-4096-b078-0214b7763eeb","chunk":"Read text file `internal/secconftest/crash.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"errors\"\n7|\t\"fmt\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"sort\"\n11|\t\"sync\"\n12|)\n13|\n14|// Outcome is the Section 13.13 crash/restart vocabulary every crash\n15|// point classifies into. AC-CRASH-001 requires exactly one of these per\n16|// injection with the section's evidence record; no run may produce\n17|// duplicate live owners, treat an unfenced external continuation as\n18|// safe, or substitute a fresh identity for the persisted one.\n19|type Outcome string\n20|\n21|const (\n22|\t// OutcomeSafeRetry means the operation never mutated durable state\n23|\t// and the identical retry is safe.\n24|\tOutcomeSafeRetry Outcome = \"safe_retry\"\n25|\t// OutcomeExplicitRollback means durable state mutated and the caller\n26|\t// must roll back before any retry.\n27|\tOutcomeExplicitRollback Outcome = \"explicit_rollback\"\n28|\t// OutcomeRecoverableParked means the operation stopped in a named\n29|\t// parked state from which an operator or a later run recovers; it\n30|\t// must never silently resume as a fresh identity.\n31|\tOutcomeRecoverableParked Outcome = \"recoverable_parked_state\"\n32|)\n33|\n34|// Crash points name the phase boundaries the injector can fire on. The\n35|// families follow the AC-CRASH-001 class list (CR-LAUNCH-*, CR-SYNC-*,\n36|// CR-MAT-*, CR-GRACE-*, CR-FORCE-*, CR-FORK-*, CR-STOP-*, CR-RESUME-*,\n37|// CR-RESTORE-*, CR-CLONE-01..16); the suffix selects the boundary\n38|// inside the modeled operation.\n39|const (\n40|\tPointPrepareEnter  = \"CR-MAT-prepare-enter\"\n41|\tPointPrepareCommit = \"CR-MAT-prepare-commit\"\n42|\tPointCommitEnter   = \"CR-MAT-commit-enter\"\n43|\tPointCommitApply   = \"CR-MAT-commit-apply\"\n44|\tPointRollbackEnter = \"CR-MAT-rollback-enter\"\n45|)\n46|\n47|// ErrInjected reports a fired crash point. It carries the point and the\n48|// classified outcome so the caller cannot observe the fault without\n49|// observing what it requires.\n50|var ErrInjected = errors.New(\"secconftest injected crash\")\n51|\n52|// Fault is the fired crash-point evidence.\n53|type Fault struct {\n54|\tpoint   string\n55|\toutcome Outcome\n56|}\n57|\n58|func (fault *Fault) Error() string {\n59|\treturn fmt.Sprintf(\"%v: %s requires %s\", ErrInjected, fault.point, fault.outcome)\n60|}\n61|\n62|// Unwrap matches ErrInjected so callers match the fault kind without\n63|// parsing human text.\n64|func (fault *Fault) Unwrap() error {\n65|\treturn ErrInjected\n66|}\n67|\n68|// Point names the fired crash point.\n69|func (fault *Fault) Point() string { return fault.point }\n70|\n71|// Outcome classifies the fired crash point into the Section 13.13\n72|// vocabulary.\n73|func (fault *Fault) Outcome() Outcome { return fault.outcome }\n74|\n75|// Classify maps a crash point to its required outcome. Points before\n76|// any durable mutation are safe_retry; points after the journal takes\n77|// effect require explicit_rollback; points past the commit marker park\n78|// for recovery. Weakening any row to a different outcome must fail the\n79|// table test that drives it.\n80|func Classify(point string) (Outcome, error) {\n81|\tswitch point {\n82|\tcase PointPrepareEnter:\n83|\t\treturn OutcomeSafeRetry, nil\n84|\tcase PointPrepareCommit, PointCommitEnter, PointRollbackEnter:\n85|\t\treturn OutcomeExplicitRollback, nil\n86|\tcase PointCommitApply:\n87|\t\treturn OutcomeRecoverableParked, nil\n88|\tdefault:\n89|\t\treturn \"\", fmt.Errorf(\"secconftest: unknown crash point %q\", point)\n90|\t}\n91|}\n92|\n93|// Injector arms named crash points. The zero value is usable and fires\n94|// nothing. MaybeFail is the only firing entry: production-shaped code\n95|// under test calls it at each phase boundary.\n96|type Injector struct {\n97|\tmutex sync.Mutex\n98|\tarmed map[string]bool\n99|}\n100|\n101|// Arm fires point on its next MaybeFail call.\n102|func (injector *Injector) Arm(point string) {\n103|\tinjector.mutex.Lock()\n104|\tdefer injector.mutex.Unlock()\n105|\tif injector.armed == nil {\n106|\t\tinjector.armed = map[string]bool{}\n107|\t}\n108|\tinjector.armed[point] = true\n109|}\n110|\n111|// Disarm clears every armed point.\n112|func (injector *Injector) Disarm() {\n113|\tinjector.mutex.Lock()\n114|\tdefer injector.mutex.Unlock()\n115|\tinjector.armed = map[string]bool{}\n116|}\n117|\n118|// Armed reports whether point is currently armed.\n119|func (injector *Injector) Armed(point string) bool {\n120|\tinjector.mutex.Lock()\n121|\tdefer injector.mutex.Unlock()\n122|\treturn injector.armed[point]\n123|}\n124|\n125|// RemainingArmed lists the points still armed, sorted. A test that arms\n126|// a point and drives the operation must find this empty afterwards: an\n127|// armed point that never fires is otherwise noticed only incidentally,\n128|// and a new crash site added without an arm is outside this model (see\n129|// the package bounds). Weakening this to a constant empty slice must\n130|// fail the consumption test that drives it.\n131|func (injector *Injector) RemainingArmed() []string {\n132|\tinjector.mutex.Lock()\n133|\tdefer injector.mutex.Unlock()\n134|\tremaining := make([]string, 0, len(injector.armed))\n135|\tfor point := range injector.armed {\n136|\t\tremaining = append(remaining, point)\n137|\t}\n138|\tsort.Strings(remaining)\n139|\treturn remaining\n140|}\n141|\n142|// MaybeFail returns a *Fault when point is armed and consumes the arm,\n143|// so each armed point fires exactly once. It returns nil when\n144|// disarmed. An unknown point name is a caller error, never silent.\n145|func (injector *Injector) MaybeFail(point string) error {\n146|\toutcome, err := Classify(point)\n147|\tif err != nil {\n148|\t\treturn err\n149|\t}\n150|\tinjector.mutex.Lock()\n151|\tfire := injector.armed[point]\n152|\tif fire {\n153|\t\tdelete(injector.armed, point)\n154|\t}\n155|\tinjector.mutex.Unlock()\n156|\tif !fire {\n157|\t\treturn nil\n158|\t}\n159|\treturn &Fault{point: point, outcome: outcome}\n160|}\n161|\n162|// ErrIdempotencyMismatch reports a lost-response retry that changed the\n163|// operation body: AC-MAT-004 requires the byte-identical receipt for\n164|// the identical retry and a failure that creates no second root for a\n165|// changed one.\n166|var ErrIdempotencyMismatch = errors.New(\"secconftest idempotency_mismatch\")\n167|\n168|// Receipt is the durable proof of one transacted operation.\n169|type Receipt struct {\n170|\tOperationID string\n171|\tBodyDigest  string\n172|\tOutcome     Outcome\n173|\tBytes       []byte\n174|}\n175|\n176|// Transactor is a three-phase durable-commit model (prepare, commit,\n177|// rollback) over a directory, driven through MaybeFail boundaries. It\n178|// exists to prove the injector, the outcome vocabulary, and the\n179|// idempotency rule against real filesystem state; it is not a product\n180|// journal and no product path may import it for recovery.\n181|type Transactor struct {\n182|\tinjector *Injector\n183|\troot     string\n184|\tmutex    sync.Mutex\n185|\treceipts map[string]Receipt\n186|\t// finalized marks operations whose Commit returned cleanly. The\n187|\t// operation is then terminal and Rollback must refuse it\n188|\t// (AC-CLONE-005: rollback is forbidden after Provider commit).\n189|\tfinalized map[string]bool\n190|}\n191|\n192|// NewTransactor binds a Transactor to root, which must exist.\n193|func NewTransactor(injector *Injector, root string) *Transactor {\n194|\treturn &Transactor{injector: injector, root: root, receipts: map[string]Receipt{}, finalized: map[string]bool{}}\n195|}\n196|\n197|func digestBody(body []byte) string {\n198|\tsum := sha256.Sum256(body)\n199|\treturn hex.EncodeToString(sum[:])\n200|}\n201|\n202|// Prepare stages body under operationID and fsyncs the journal entry.\n203|// A retry with the same operation ID and byte-identical body returns\n204|// the identical receipt without staging twice. A retry with the same\n205|// ID and a different body fails with ErrIdempotencyMismatch and\n206|// stages nothing new.\n207|func (transactor *Transactor) Prepare(operationID string, body []byte) (Receipt, error) {\n208|\tif operationID == \"\" {\n209|\t\treturn Receipt{}, errors.New(\"secconftest: empty operation ID\")\n210|\t}\n211|\tif err := transactor.injector.MaybeFail(PointPrepareEnter); err != nil {\n212|\t\treturn Receipt{}, err\n213|\t}\n214|\tdigest := digestBody(body)\n215|\ttransactor.mutex.Lock()\n216|\tif prior, ok := transactor.receipts[operationID]; ok {\n217|\t\ttransactor.mutex.Unlock()\n218|\t\tif prior.BodyDigest != digest {\n219|\t\t\treturn Receipt{}, fmt.Errorf(\"%w: operation %q body changed\", ErrIdempotencyMismatch, operationID)\n220|\t\t}\n221|\t\treturn prior, nil\n222|\t}\n223|\ttransactor.mutex.Unlock()\n224|\tstaged := filepath.Join(transactor.root, operationID+\".staged\")\n225|\tif err := os.WriteFile(staged, body, 0o600); err != nil {\n226|\t\treturn Receipt{}, err\n227|\t}\n228|\tif err := transactor.injector.MaybeFail(PointPrepareCommit); err != nil {\n229|\t\t_ = os.Remove(staged)\n230|\t\treturn Receipt{}, err\n231|\t}\n232|\treceipt := Receipt{OperationID: operationID, BodyDigest: digest, Outcome: OutcomeSafeRetry, Bytes: append([]byte(nil), body...)}\n233|\ttransactor.mutex.Lock()\n234|\ttransactor.receipts[operationID] = receipt\n235|\ttransactor.mutex.Unlock()\n236|\treturn receipt, nil\n237|}\n238|\n239|// Commit promotes the staged body to committed bytes. It fails armed\n240|// crash points before (commit-enter: rollback required) and after\n241|// (commit-apply: parked) the durable rename.\n242|func (transactor *Transactor) Commit(operationID string) (Receipt, error) {\n243|\tif err := transactor.injector.MaybeFail(PointCommitEnter); err != nil {\n244|\t\treturn Receipt{}, err\n245|\t}\n246|\ttransactor.mutex.Lock()\n247|\treceipt, ok := transactor.receipts[operationID]\n248|\ttransactor.mutex.Unlock()\n249|\tif !ok {\n250|\t\treturn Receipt{}, fmt.Errorf(\"secconftest: commit without prepare for operation %q\", operationID)\n251|\t}\n252|\tstaged := filepath.Join(transactor.root, operationID+\".staged\")\n253|\tcommitted := filepath.Join(transactor.root, operationID+\".committed\")\n254|\tcontents, err := os.ReadFile(staged)\n255|\tif err != nil {\n256|\t\treturn Receipt{}, err\n257|\t}\n258|\tif err := os.WriteFile(committed, contents, 0o600); err != nil {\n259|\t\treturn Receipt{}, err\n260|\t}\n261|\t_ = os.Remove(staged)\n262|\tif err := transactor.injector.MaybeFail(PointCommitApply); err != nil {\n263|\t\treturn Receipt{}, err\n264|\t}\n265|\treceipt.Outcome = OutcomeExplicitRollback\n266|\ttransactor.mutex.Lock()\n267|\ttransactor.receipts[operationID] = receipt\n268|\ttransactor.finalized[operationID] = true\n269|\ttransactor.mutex.Unlock()\n270|\treturn receipt, nil\n271|}\n272|\n273|// ErrRollbackPastFinalize reports a rollback refused after a clean\n274|// Commit: the operation is terminal and rollback is forbidden\n275|// (AC-CLONE-005 shapes this rule; the model enforces it).\n276|var ErrRollbackPastFinalize = errors.New(\"secconftest rollback forbidden after commit\")\n277|\n278|// Rollback removes staged bytes for operationID before finalization.\n279|// It refuses to run past finalization: once Commit returns cleanly the\n280|// operation is terminal, rollback is forbidden, and the committed\n281|// bytes must survive the refused call untouched. Deleting the finalize\n282|// gate must fail the test that commits and then rolls back.\n283|func (transactor *Transactor) Rollback(operationID string) error {\n284|\tif err := transactor.injector.MaybeFail(PointRollbackEnter); err != nil {\n285|\t\treturn err\n286|\t}\n287|\ttransactor.mutex.Lock()\n288|\t_, ok := transactor.receipts[operationID]\n289|\tfinalized := transactor.finalized[operationID]\n290|\ttransactor.mutex.Unlock()\n291|\tif !ok {\n292|\t\treturn fmt.Errorf(\"secconftest: rollback without prepare for operation %q\", operationID)\n293|\t}\n294|\tif finalized {\n295|\t\treturn fmt.Errorf(\"%w: operation %q\", ErrRollbackPastFinalize, operationID)\n296|\t}\n297|\t_ = os.Remove(filepath.Join(transactor.root, operationID+\".staged\"))\n298|\t_ = os.Remove(filepath.Join(transactor.root, operationID+\".committed\"))\n299|\treturn nil\n300|}\n301|\n302|// CommittedBytes reads back the committed bytes for operationID.\n303|func (transactor *Transactor) CommittedBytes(operationID string) ([]byte, error) {\n304|\treturn os.ReadFile(filepath.Join(transactor.root, operationID+\".committed\"))\n305|}"}}}
