{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c585","stream":{"kind":"session","id":"01a077c8-d88a-7931-843c-3e9dddbe9444"},"sequence":285,"recorded_at":1780531400000565,"record_type":"event","durability":"durable","causation_id":"d502244e-0589-4672-9c20-02af4f4b0b68","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d502244e-0589-4672-9c20-02af4f4b0b68","run_stream":{"kind":"run","id":"d502244e-0589-4672-9c20-02af4f4b0b68"},"task_stream":{"kind":"task","id":"519650a1-9b1a-42c6-a173-3a9929c34a49"},"task_id":"519650a1-9b1a-42c6-a173-3a9929c34a49","event":{"kind":"output","task_id":"519650a1-9b1a-42c6-a173-3a9929c34a49","chunk":"Read text file `internal/secconftest/skip_fifo_windows.go`.\n1|//go:build windows\n2|\n3|package secconftest\n4|\n5|import \"errors\"\n6|\n7|// makeFifo is unavailable on Windows: named pipes there are not\n8|// filesystem FIFOs and this instrument does not emulate them. The\n9|// fifo probe reports unavailable (and skips, since Windows is not\n10|// strict) instead of pretending.\n11|func makeFifo(dir, name string) (string, error) {\n12|\treturn fifoBuild(dir, name)\n13|}\n14|\n15|// fifoBuild is the seam the probe-honesty test faults. It always\n16|// fails on Windows, matching makeFifo; the test only asserts the\n17|// probe reports the failure honestly.\n18|var fifoBuild = func(dir, name string) (string, error) {\n19|\treturn \"\", errors.New(\"secconftest: named-pipe fixtures are unavailable on Windows\")\n20|}"}}}
