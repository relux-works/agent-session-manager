{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9f3","stream":{"kind":"session","id":"01a077c8-d88a-7931-843c-3e9dddbe9444"},"sequence":852,"recorded_at":1780531400001699,"record_type":"event","durability":"durable","causation_id":"d502244e-0589-4672-9c20-02af4f4b0b68","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d502244e-0589-4672-9c20-02af4f4b0b68","run_stream":{"kind":"run","id":"d502244e-0589-4672-9c20-02af4f4b0b68"},"task_stream":{"kind":"task","id":"fe94b9bc-6544-4445-a47f-d67648d9e2da"},"task_id":"fe94b9bc-6544-4445-a47f-d67648d9e2da","event":{"kind":"output","task_id":"fe94b9bc-6544-4445-a47f-d67648d9e2da","chunk":"Read text file `internal/secconftest/skip_test.go`.\n(219 line(s) above)\n220|\t\t_ = file.Close()\n221|\t\tt.Fatal(\"open succeeded despite mode 000; permission bits are not enforced here\")\n222|\t}\n223|\tif !os.IsPermission(err) {\n224|\t\tt.Fatalf(\"denial error %v is not a permission error\", err)\n225|\t}\n226|}\n227|\n228|func TestSkipReportReadsRecordedVerdicts(t *testing.T) {\n229|\t// Not parallel: it mutates the process-wide counters. It records\n230|\t// its own synthetic verdicts, asserts the report moves, then\n231|\t// restores the suite state — so the numbers below are evidence\n232|\t// that Report reads the live counters, not a constant. Gutting\n233|\t// recordVerdict leaves both assertions red.\n234|\tconst skipID = \"self-test-skip-probe\"\n235|\tconst failID = \"self-test-fail-probe\"\n236|\tbeforeSkipped, beforeFailed := snapshotReport()\n237|\tt.Cleanup(func() {\n238|\t\trestoreReport(beforeSkipped, beforeFailed)\n239|\t\tfor _, id := range SkippedIDs() {\n240|\t\t\tif id == skipID || id == failID {\n241|\t\t\t\tt.Errorf(\"synthetic verdict %q leaked into the suite counters\", id)\n242|\t\t\t}\n243|\t\t}\n244|\t})\n245|\trecordVerdict(Verdict{ID: skipID, Skipped: true, Reason: \"synthetic skip\"})\n246|\trecordVerdict(Verdict{ID: failID, Failed: true, Reason: \"synthetic failure\"})\n247|\tfound := false\n248|\tfor _, id := range SkippedIDs() {\n249|\t\tif id == skipID {\n250|\t\t\tfound = true\n251|\t\t}\n252|\t}\n253|\tif !found {\n254|\t\tt.Fatalf(\"SkippedIDs() = %q, want it to contain %q\", SkippedIDs(), skipID)\n255|\t}\n256|\treport := Report()\n257|\tif !strings.Contains(report, skipID) || !strings.Contains(report, failID) {\n258|\t\tt.Fatalf(\"Report() = %q, want it to carry both synthetic verdicts\", report)\n259|\t}\n260|\t// Attached evidence with real nonzero counters from this test's\n261|\t// own recorded verdicts.\n262|\tLogReport(t)\n263|\tt.Logf(\"skipped IDs: %q\", SkippedIDs())\n264|}"}}}
