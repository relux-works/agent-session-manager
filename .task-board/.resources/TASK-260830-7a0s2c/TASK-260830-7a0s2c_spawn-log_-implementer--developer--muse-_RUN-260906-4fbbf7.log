{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c51f","stream":{"kind":"session","id":"01a077c8-d88a-7931-843c-3e9dddbe9444"},"sequence":234,"recorded_at":1780531400000463,"record_type":"event","durability":"durable","causation_id":"d502244e-0589-4672-9c20-02af4f4b0b68","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d502244e-0589-4672-9c20-02af4f4b0b68","run_stream":{"kind":"run","id":"d502244e-0589-4672-9c20-02af4f4b0b68"},"task_stream":{"kind":"task","id":"d0a87935-d592-4b5c-991a-2bf7d6f3db34"},"task_id":"d0a87935-d592-4b5c-991a-2bf7d6f3db34","event":{"kind":"output","task_id":"d0a87935-d592-4b5c-991a-2bf7d6f3db34","chunk":"Read text file `internal/secconftest/hostile.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"strings\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n8|)\n9|\n10|// HostileClass is one spec-derived hostile-input class: the exact\n11|// specification phrase it comes from, the section that phrase lives\n12|// in, and the production gate that decides its members.\n13|//\n14|// The roster is derived, not listed: TestHostileRosterQuotesResolve\n15|// requires every Quote to occur in its Section in the pinned document,\n16|// so a class added to or removed from the specification fails the\n17|// roster instead of passing silently. Members are generated from\n18|// Unicode tables and internal/scalar predicates, never from the\n19|// secprim tables under test, so deleting a gate arm keeps the corpus\n20|// and reddens the gate test instead of shrinking the witness with it.\n21|type HostileClass struct {\n22|\t// ID is the stable slug naming the class in test output.\n23|\tID string\n24|\t// Section is the AX specification section the Quote is drawn from.\n25|\tSection string\n26|\t// Quote is the exact specification phrase deriving this class.\n27|\tQuote string\n28|\t// Gate names the production entry point deciding the members.\n29|\tGate string\n30|}\n31|\n32|// Roster lists every hostile class this instrument drives.\n33|func Roster() []HostileClass {\n34|\treturn []HostileClass{\n35|\t\t{ID: \"path-traversal\", Section: \"16.3\", Quote: \"path traversal\", Gate: \"secprim.CheckMemberPath\"},\n36|\t\t{ID: \"path-absolute\", Section: \"16.3\", Quote: \"absolute paths\", Gate: \"secprim.CheckMemberPath\"},\n37|\t\t{ID: \"path-drive-unc\", Section: \"16.3\", Quote: \"drive/UNC injection\", Gate: \"secprim.CheckMemberPath\"},\n38|\t\t{ID: \"path-altstream\", Section: \"16.3\", Quote: \"alternate streams\", Gate: \"secprim.CheckMemberPath\"},\n39|\t\t{ID: \"path-encoded-separator\", Section: \"16.3\", Quote: \"repeatedly encoded separators\", Gate: \"secprim.CheckMemberPath\"},\n40|\t\t{ID: \"path-symlink-escape\", Section: \"16.3\", Quote: \"symlink/reparse escape during both validation and commit\", Gate: \"secprim.Guard.Open\"},\n41|\t\t{ID: \"path-case-collision\", Section: \"16.3\", Quote: \"case-fold collisions on case-insensitive destinations\", Gate: \"secprim.DetectCaseCollision\"},\n42|\t\t{ID: \"path-unmanaged\", Section: \"16.3\", Quote: \"replacement of unmanaged paths\", Gate: \"secprim.Guard.Resolve\"},\n43|\t\t{ID: \"path-device\", Section: \"16.3\", Quote: \"device/FIFO/socket creation\", Gate: \"secprim.CheckMemberPath\"},\n44|\t\t{ID: \"argv-vector\", Section: \"16.4\", Quote: \"Shell command construction from names, paths, provider output, or peer data is forbidden\", Gate: \"secprim.CheckArgv\"},\n45|\t\t{ID: \"env-allowlist\", Section: \"16.7\", Quote: \"minimal environment allowlists\", Gate: \"secprim.IsEnvName\"},\n46|\t\t{ID: \"render-ansi-osc\", Section: \"16.7\", Quote: \"ANSI/OSC sequences\", Gate: \"secprim.EscapeForTerminal\"},\n47|\t\t{ID: \"render-controls\", Section: \"16.7\", Quote: \"control characters\", Gate: \"secprim.EscapeForTerminal\"},\n48|\t\t{ID: \"render-bidi\", Section: \"16.7\", Quote: \"bidi overrides\", Gate: \"secprim.EscapeForTerminal\"},\n49|\t\t{ID: \"render-encoding\", Section: \"16.7\", Quote: \"invalid encodings\", Gate: \"secprim.EscapeForTerminal\"},\n50|\t\t{ID: \"render-width\", Section: \"16.7\", Quote: \"hostile-width graphemes\", Gate: \"secprim.EscapeForTerminal\"},\n51|\t\t{ID: \"redact-persisted\", Section: \"16.4\", Quote: \"redacted before persistence\", Gate: \"secprim.Redact\"},\n52|\t\t{ID: \"redact-credentials\", Section: \"16.2\", Quote: \"API keys, OAuth tokens\", Gate: \"secprim.Redact\"},\n53|\t}\n54|}\n55|\n56|// QuoteInSection reports whether quote occurs on at least one document\n57|// line inside section. The section check is load-bearing, not\n58|// ceremony: TestQuoteInSectionRejectsWrongSection drives a real quote\n59|// against a wrong section and requires refusal, so a mutant that\n60|// preserves the token match but drops the section check fails. The\n61|// mutant harness for that test executes the full behavioral hostile\n62|// battery, not only this checker.\n63|func QuoteInSection(document *specdoc.Document, quote, section string) error {\n64|\tif document == nil {\n65|\t\treturn fmt.Errorf(\"secconftest: nil specification document is never a legitimate absence\")\n66|\t}\n67|\tif strings.TrimSpace(quote) == \"\" {\n68|\t\treturn fmt.Errorf(\"secconftest: empty quote matches nothing\")\n69|\t}\n70|\tlines := document.QuoteLines(quote)\n71|\tif len(lines) == 0 {\n72|\t\treturn fmt.Errorf(\"secconftest: quote %q occurs nowhere in the pinned document\", quote)\n73|\t}\n74|\tfor _, line := range lines {\n75|\t\tif got, ok := document.SectionID(line); ok && got == section {\n76|\t\t\treturn nil\n77|\t\t}\n78|\t}\n79|\treturn fmt.Errorf(\"secconftest: quote %q occurs but never in section %s\", quote, section)\n80|}\n81|\n82|// bidiOverrideRunes enumerates the Section 16.7 bidi class from the\n83|// Unicode code chart, not from the gate under test: embeddings and\n84|// overrides U+202A-U+202E, isolates U+2066-U+2069, directional marks\n85|// U+200E, U+200F, U+061C, and zero-width U+200B-U+200D plus U+FEFF.\n86|// The static list is the point: a gate arm deleted with its test row\n87|// still faces every rune here.\n88|func bidiOverrideRunes() []rune {\n89|\treturn []rune{\n90|\t\t0x202a, 0x202b, 0x202c, 0x202d, 0x202e,\n91|\t\t0x2066, 0x2067, 0x2068, 0x2069,\n92|\t\t0x200e, 0x200f, 0x061c,\n93|\t\t0x200b, 0x200c, 0x200d,\n94|\t\t0xfeff,\n95|\t}\n96|}\n97|\n98|// Members generates the hostile inputs for a roster class ID. Every\n99|// member carries the class token (for example \"..\" for traversal):\n100|// the gates must refuse behavior, not merely match the token, and the\n101|// per-class gate tests assert refusal of every member, so a\n102|// token-preserving behavior change still reddens.\n103|func Members(id string) []string {\n104|\twrap := func(runes []rune) []string {\n105|\t\tmembers := make([]string, 0, len(runes))\n106|\t\tfor _, character := range runes {\n107|\t\t\tmembers = append(members, \"a\"+string(character)+\"b\")\n108|\t\t}\n109|\t\treturn members\n110|\t}\n111|\tswitch id {\n112|\tcase \"path-traversal\":\n113|\t\treturn []string{\"../evil\", \"a/../../evil\", \"..\", \"a/../b\", \"a/b/../../../../c\", \"....//evil\"}\n114|\tcase \"path-absolute\":\n115|\t\treturn []string{\"/etc/passwd\", \"/\", \"/a/b\"}\n116|\tcase \"path-drive-unc\":\n117|\t\treturn []string{\"C:/Windows\", \"C:relative\", \"d:foo\", \"//server/share\", `\\\\server\\share`}\n118|\tcase \"path-altstream\":\n119|\t\treturn []string{\"file:stream\", \"dir/file:ads\", \"file:$DATA\"}\n120|\tcase \"path-encoded-separator\":\n121|\t\treturn []string{\"a%2fb\", \"a%5cb\", \"a%252fb\", \"a%2F..%2Fb\", \"%2e%2e/evil\", \"a/%2e%2e/b\", \"%2E%2E\", \"a%c0%afb\", \"a%C0%AFb\"}\n122|\tcase \"path-case-collision\":\n123|\t\treturn []string{\"readme.md\", \"README.MD\", \"ReadMe.Md\", \"STAGING/MEMBER\", \"Staging/Member\"}\n124|\tcase \"path-unmanaged\":\n125|\t\treturn []string{\"outside-managed\", \"staging/other\", \"secret\"}\n126|\tcase \"path-device\":\n127|\t\treturn []string{\"NUL\", \"CON\", \"COM1\", \"LPT1.txt\", \"aux.log\", \"dir/PRN\", \"COM9\", \"nul\"}\n128|\tcase \"argv-vector\":\n129|\t\treturn []string{\"; rm -rf /\", \"$(evil)\", \"`evil`\", \"a|b\", \"a&&b\", \"a\\nb\", \"--flag=value with spaces\"}\n130|\tcase \"env-allowlist\":\n131|\t\treturn []string{\"\", \"0\", \"1ABC\", \"A-B\", \"A B\", \"A.B\", \"A/B\", \"A\\x00B\", strings.Repeat(\"A\", 129)}\n132|\tcase \"render-ansi-osc\":\n133|\t\treturn []string{\"a\\x1b[31mb\", \"a\\x1b[0mb\", \"a\\x1b]8;;https://evil\\x07b\", \"a\\x9bb\"}\n134|\tcase \"render-controls\":\n135|\t\t// C0 controls except newline and tab (which the gate keeps),\n136|\t\t// DEL, and C1 controls: the exact refused set the section\n137|\t\t// names as \"control characters\". Printable runes are not\n138|\t\t// hostile and are not members.\n139|\t\tvar runes []rune\n140|\t\tfor character := rune(0); character < 0x20; character++ {\n141|\t\t\tif character == '\\n' || character == '\\t' {\n142|\t\t\t\tcontinue\n143|\t\t\t}\n144|\t\t\trunes = append(runes, character)\n145|\t\t}\n146|\t\trunes = append(runes, 0x7f)\n147|\t\tfor character := rune(0x80); character < 0xa0; character++ {\n148|\t\t\trunes = append(runes, character)\n149|\t\t}\n150|\t\treturn wrap(runes)\n151|\tcase \"render-bidi\":\n152|\t\treturn wrap([]rune{0x202a, 0x202b, 0x202c, 0x202d, 0x202e, 0x2066, 0x2067, 0x2068, 0x2069})\n153|\tcase \"render-encoding\":\n154|\t\treturn []string{\"a\\xffb\", \"a\\xfeb\", \"\\xff\", \"\\xfe\", \"a\\xed\\xa0\\x80b\"}\n155|\tcase \"render-width\":\n156|\t\treturn wrap([]rune{0x200e, 0x200f, 0x061c, 0x200b, 0x200c, 0x200d, 0xfeff})\n157|\tcase \"redact-persisted\":\n158|\t\treturn []string{\n159|\t\t\t\"-----BEGIN RSA PRIVATE KEY-----\\nMIIB\\n-----END RSA PRIVATE KEY-----\",\n160|\t\t\t\"key without end -----BEGIN RSA PRIVATE KEY-----\\nMIIB\",\n161|\t\t\t\"https://deploy:s3cret@example.com/repo\",\n162|\t\t\t\"password=hunter2\",\n163|\t\t}\n164|\tcase \"redact-credentials\":\n165|\t\treturn []string{\n166|\t\t\t\"api_key=[REDACTED]\",\n167|\t\t\t\"authorization: Bearer [REDACTED]\",\n168|\t\t\t`\"token\": \"[REDACTED]\"`,\n169|\t\t\t\"cookie=sessionid=abc123\",\n170|\t\t\t\"subscription_token=st_live_42\",\n171|\t\t}\n172|\tdefault:\n173|\t\treturn nil\n174|\t}\n175|}\n176|\n177|// BidiRunes exposes the full bidi/zero-width rune list for gate tests\n178|// that must assert the enumerated set without retyping it.\n179|func BidiRunes() []rune {\n180|\treturn bidiOverrideRunes()\n181|}"}}}
