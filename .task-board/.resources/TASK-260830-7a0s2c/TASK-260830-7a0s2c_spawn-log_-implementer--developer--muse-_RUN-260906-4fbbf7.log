{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c57d","stream":{"kind":"session","id":"01a077c8-d88a-7931-843c-3e9dddbe9444"},"sequence":281,"recorded_at":1780531400000557,"record_type":"event","durability":"durable","causation_id":"d502244e-0589-4672-9c20-02af4f4b0b68","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d502244e-0589-4672-9c20-02af4f4b0b68","run_stream":{"kind":"run","id":"d502244e-0589-4672-9c20-02af4f4b0b68"},"task_stream":{"kind":"task","id":"bed82c3d-1031-422e-80a7-adcf49e7515a"},"task_id":"bed82c3d-1031-422e-80a7-adcf49e7515a","event":{"kind":"output","task_id":"bed82c3d-1031-422e-80a7-adcf49e7515a","chunk":"Read text file `internal/secconftest/clock.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"sync\"\n5|\t\"time\"\n6|)\n7|\n8|// Clock abstracts time for code under test. Production code that needs\n9|// the time takes a Clock; tests pass a Fake. A Fake never reads the\n10|// wall clock, so suite timing cannot leak into results.\n11|type Clock interface {\n12|\tNow() time.Time\n13|}\n14|\n15|// fixedStart pins every Fake to one answer until advanced. The value is\n16|// arbitrary and carries no product meaning.\n17|var fixedStart = time.Date(2026, time.January, 2, 3, 4, 5, 0, time.UTC)\n18|\n19|// Fake is a manually advanced clock. The zero value is usable and reads\n20|// fixedStart. It calls nothing outside its own mutex: in particular it\n21|// never calls time.Now, so a real-clock difference (a sleep, a slow\n22|// host, midnight) cannot change its answer.\n23|type Fake struct {\n24|\tmutex   sync.Mutex\n25|\tcurrent time.Time\n26|\tset     bool\n27|}\n28|\n29|// Now reports the fake time.\n30|func (clock *Fake) Now() time.Time {\n31|\tclock.mutex.Lock()\n32|\tdefer clock.mutex.Unlock()\n33|\tif !clock.set {\n34|\t\treturn fixedStart\n35|\t}\n36|\treturn clock.current\n37|}\n38|\n39|// Advance moves the fake time forward by delta. A negative delta is a\n40|// no-op: clocks under test never run backwards through this type.\n41|func (clock *Fake) Advance(delta time.Duration) {\n42|\tif delta < 0 {\n43|\t\treturn\n44|\t}\n45|\tclock.mutex.Lock()\n46|\tdefer clock.mutex.Unlock()\n47|\tif !clock.set {\n48|\t\tclock.current = fixedStart\n49|\t\tclock.set = true\n50|\t}\n51|\tclock.current = clock.current.Add(delta)\n52|}\n53|\n54|// Set pins the fake time to an exact value.\n55|func (clock *Fake) Set(moment time.Time) {\n56|\tclock.mutex.Lock()\n57|\tdefer clock.mutex.Unlock()\n58|\tclock.current = moment\n59|\tclock.set = true\n60|}\n61|\n62|// Recording wraps a Clock and counts Now calls. Passing a Recording\n63|// into code under test and then reading Calls tells the suite whether\n64|// the fake was actually wired: zero calls after a clock-dependent\n65|// operation means the code read the wall clock (or no clock) instead,\n66|// and the suite must treat that as a failure, not as a pass.\n67|type Recording struct {\n68|\tinner Clock\n69|\tmutex sync.Mutex\n70|\tcalls int64\n71|}\n72|\n73|// Wrap counts Now calls through inner.\n74|func Wrap(inner Clock) *Recording {\n75|\treturn &Recording{inner: inner}\n76|}\n77|\n78|// Now delegates and records the call.\n79|func (clock *Recording) Now() time.Time {\n80|\tclock.mutex.Lock()\n81|\tclock.calls++\n82|\tclock.mutex.Unlock()\n83|\treturn clock.inner.Now()\n84|}\n85|\n86|// Calls reports how many times Now was read through this wrapper.\n87|func (clock *Recording) Calls() int64 {\n88|\tclock.mutex.Lock()\n89|\tdefer clock.mutex.Unlock()\n90|\treturn clock.calls\n91|}"}}}
