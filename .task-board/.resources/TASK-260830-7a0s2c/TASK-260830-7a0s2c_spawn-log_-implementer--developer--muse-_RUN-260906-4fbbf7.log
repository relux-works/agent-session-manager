{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c581","stream":{"kind":"session","id":"01a077c8-d88a-7931-843c-3e9dddbe9444"},"sequence":283,"recorded_at":1780531400000561,"record_type":"event","durability":"durable","causation_id":"d502244e-0589-4672-9c20-02af4f4b0b68","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d502244e-0589-4672-9c20-02af4f4b0b68","run_stream":{"kind":"run","id":"d502244e-0589-4672-9c20-02af4f4b0b68"},"task_stream":{"kind":"task","id":"0793ac17-90f5-4245-a689-348cddbfe2c1"},"task_id":"0793ac17-90f5-4245-a689-348cddbfe2c1","event":{"kind":"output","task_id":"0793ac17-90f5-4245-a689-348cddbfe2c1","chunk":"Read text file `internal/secconftest/skip_fifo_unix.go`.\n1|//go:build !windows\n2|\n3|package secconftest\n4|\n5|import (\n6|\t\"fmt\"\n7|\t\"path/filepath\"\n8|\t\"syscall\"\n9|)\n10|\n11|// makeFifo creates a named pipe at dir/name with mode 0600. Unix-only:\n12|// Windows has no Mkfifo and its file carries the unavailable stub, so\n13|// the fifo probe fails (and skips, since Windows is not strict)\n14|// instead of pretending.\n15|func makeFifo(dir, name string) (string, error) {\n16|\treturn fifoBuild(dir, name)\n17|}\n18|\n19|// fifoBuild is the seam the probe-honesty test faults: it swaps in a\n20|// failing build, drives FifoCapability().Probe(), and requires\n21|// failure. A probe closure hardened to constant true ignores the\n22|// fault and fails the test.\n23|var fifoBuild = func(dir, name string) (string, error) {\n24|\tpath := filepath.Join(dir, name)\n25|\tif err := syscall.Mkfifo(path, 0o600); err != nil {\n26|\t\treturn \"\", fmt.Errorf(\"secconftest: mkfifo %q: %w\", path, err)\n27|\t}\n28|\treturn path, nil\n29|}"}}}
