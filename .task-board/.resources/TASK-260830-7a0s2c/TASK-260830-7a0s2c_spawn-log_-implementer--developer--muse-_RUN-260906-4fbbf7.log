{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ce97","stream":{"kind":"session","id":"01a077c8-d88a-7931-843c-3e9dddbe9444"},"sequence":1446,"recorded_at":1780531400002887,"record_type":"event","durability":"durable","causation_id":"d502244e-0589-4672-9c20-02af4f4b0b68","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d502244e-0589-4672-9c20-02af4f4b0b68","run_stream":{"kind":"run","id":"d502244e-0589-4672-9c20-02af4f4b0b68"},"task_stream":{"kind":"task","id":"14941e4d-7a97-497d-9f61-e86a59bd0c86"},"task_id":"14941e4d-7a97-497d-9f61-e86a59bd0c86","event":{"kind":"output","task_id":"14941e4d-7a97-497d-9f61-e86a59bd0c86","chunk":"edited\nchanged lines: lines 197-200\n--- original\n+++ updated\n@@\n-M(\"C-CapsDrops\", \"census-only\", \"internal/secconftest/skip.go\",\n-  'return []Capability{SymlinkCapability(), FifoCapability(), ModeBitsCapability(), NonRootCapability()}',\n-  'return []Capability{SymlinkCapability(), FifoCapability(), ModeBitsCapability()}',\n-  \"TestSkipDefaultProbesTerminate\")\n+M(\"C-CapsDrops\", \"census-only\", \"internal/secconftest/skip.go\",\n+  'return []Capability{SymlinkCapability(), FifoCapability(), ModeBitsCapability(), NonRootCapability()}',\n+  'return []Capability{SymlinkCapability(), FifoCapability(), ModeBitsCapability()}',\n+  \"TestSkipDefaultProbesTerminate\")\n+\n+def main():\n+    pre_hash, pre_body = manifest()\n+    print(f\"PRE_MANIFEST {pre_hash}\")\n+    with open(\"/tmp/manifest-pre.txt\", \"w\") as f:\n+        f.write(pre_body)\n+    applied = not_applied = compile_fail = vet_fail = 0\n+    killed = survived = 0\n+    by_kind = {}\n+    rows = []\n+    for m in MUTANTS:\n+        label, kind, path = m[\"label\"], m[\"kind\"], m[\"path\"]\n+        with open(path) as f:\n+            src = f.read()\n+        if m[\"old\"] not in src:\n+            not_applied += 1\n+            rows.append((label, kind, \"NOT_APPLIED\", m[\"test\"], \"anchor absent\"))\n+            print(f\"{label} NOT_APPLIED kind={kind} by={m['test']} :: anchor absent\", flush=True)\n+            continue\n+        applied += 1\n+        if m[\"count\"] == 1:\n+            probe = src.replace(m[\"old\"], m[\"new\"], 1)\n+        else:\n+            probe = src.replace(m[\"old\"], m[\"new\"])\n+        if probe == src:\n+            not_applied += 1\n+            applied -= 1\n+            rows.append((label, kind, \"NOT_APPLIED\", m[\"test\"], \"replace no-op\"))\n+            print(f\"{label} NOT_APPLIED kind={kind} by={m['test']} :: replace no-op\", flush=True)\n+            continue\n+        with open(path, \"w\") as f:\n+            f.write(probe)\n+        # grep-confirm the plant\n+        if m[\"new\"].strip() and m[\"new\"].strip() not in open(path).read():\n+            print(f\"{label} WARNING plant text not found after write\", flush=True)\n+        vc, _ = run(\"go vet ./internal/secconftest/ 2>&1\")\n+        if vc != 0:\n+            vet_fail += 1\n+            rows.append((label, kind, \"VET_FAIL\", m[\"test\"], \"vet red\"))\n+            print(f\"{label} VET_FAIL kind={kind} by={m['test']} :: vet exit {vc}\", flush=True)\n+            with open(path, \"w\") as f:\n+                f.write(src)\n+            continue\n+        if m[\"test\"] == \"FULL\":\n+            tc, out = run(\"go test ./internal/secconftest/ -count=1 2>&1\")\n+        else:\n+            tc, out = run(f\"go test ./internal/secconftest/ -run '{m['test']}' -count=1 2>&1\")\n+        # detect build failure vs test failure\n+        if \"build failed\" in out or \"undefined:\" in out or \"cannot \" in out and tc != 0 and (\"FAIL\" not in out):\n+            compile_fail += 1\n+            rows.append((label, kind, \"COMPILE_FAIL\", m[\"test\"], f\"exit {tc}\"))\n+            print(f\"{label} COMPILE_FAIL kind={kind} by={m['test']} :: exit {tc}\", flush=True)\n+        elif tc != 0:\n+            killed += 1\n+            by_kind[kind] = by_kind.get(kind, [0, 0])\n+            by_kind[kind][0] += 1\n+            # name the failing test: first FAIL line\n+            failname = m[\"test\"]\n+            for line in out.splitlines():\n+                if line.startswith(\"--- FAIL:\"):\n+                    failname = line.split(\"--- FAIL:\")[1].split()[0]\n+                    break\n+            rows.append((label, kind, \"KILLED\", failname, f\"exit {tc}\"))\n+            print(f\"{label} KILLED kind={kind} by={failname} expect={m['test']} OK\", flush=True)\n+        else:\n+            survived += 1\n+            by_kind[kind] = by_kind.get(kind, [0, 0])\n+            by_kind[kind][1] += 1\n+            rows.append((label, kind, \"SURVIVED\", m[\"test\"], \"suite green\"))\n+            print(f\"{label} SURVIVED kind={kind} :: {m['test']} green\", flush=True)\n+        with open(path, \"w\") as f:\n+            f.write(src)\n+        # verify restore\n+        cur = open(path).read()\n+        if m[\"new\"].strip() and m[\"new\"].strip() in cur and m[\"old\"] not in cur:\n+            print(f\"{label} RESTORE FAILED\", flush=True)\n+            sys.exit(1)\n+    post_hash, post_body = manifest()\n+    with open(\"/tmp/manifest-post.txt\", \"w\") as f:\n+        f.write(post_body)\n+    print(f\"POST_MANIFEST {post_hash}\")\n+    print(f\"TOTALS applied {applied} NOT_APPLIED {not_applied} COMPILE_FAIL {compile_fail} VET_FAIL {vet_fail} KILLED {killed} SURVIVED {survived}\")\n+    for k in sorted(set([m[\"kind\"] for m in MUTANTS])):\n+        ka = sum(1 for m in MUTANTS if m[\"kind\"] == k)\n+        kk = sum(1 for r in rows if r[1] == k and r[2] == \"KILLED\")\n+        ks = sum(1 for r in rows if r[1] == k and r[2] == \"SURVIVED\")\n+        print(f\"KIND {k}: applied={ka} killed={kk} survived={ks}\")\n+    if pre_hash != post_hash:\n+        print(\"MANIFEST MISMATCH: tree not identical after battery\", flush=True)\n+        sys.exit(2)\n+    print(\"MANIFEST IDENTICAL\")\n+    # residual mutant-literal sweep\n+    sys.exit(0)\n+\n+if __name__ == \"__main__\":\n+    main()\n"}}}
