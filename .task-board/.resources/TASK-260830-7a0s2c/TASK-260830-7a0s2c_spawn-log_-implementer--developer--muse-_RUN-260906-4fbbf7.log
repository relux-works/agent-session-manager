{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c523","stream":{"kind":"session","id":"01a077c8-d88a-7931-843c-3e9dddbe9444"},"sequence":236,"recorded_at":1780531400000467,"record_type":"event","durability":"durable","causation_id":"d502244e-0589-4672-9c20-02af4f4b0b68","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d502244e-0589-4672-9c20-02af4f4b0b68","run_stream":{"kind":"run","id":"d502244e-0589-4672-9c20-02af4f4b0b68"},"task_stream":{"kind":"task","id":"3372fa71-f58f-405e-aac4-d93bc23bc67c"},"task_id":"3372fa71-f58f-405e-aac4-d93bc23bc67c","event":{"kind":"output","task_id":"3372fa71-f58f-405e-aac4-d93bc23bc67c","chunk":"Read text file `internal/secconftest/runner.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"hash/fnv\"\n6|\t\"sort\"\n7|\t\"sync/atomic\"\n8|)\n9|\n10|// Calls counts production entry-point invocations. A fixture receives a\n11|// counter and must record every production call it makes; the Runner\n12|// refuses fixtures that record none, so a corpus that never reaches the\n13|// entry point cannot pass as coverage.\n14|type Calls struct {\n15|\tcount atomic.Int64\n16|}\n17|\n18|// Add records n production calls.\n19|func (calls *Calls) Add(n int64) {\n20|\tcalls.count.Add(n)\n21|}\n22|\n23|// Count reports the recorded calls.\n24|func (calls *Calls) Count() int64 {\n25|\treturn calls.count.Load()\n26|}\n27|\n28|// Fixture is one named deterministic case. Run must be a pure function\n29|// of Seed: same seed, same report string. It receives a fresh Calls\n30|// counter and must record each production entry-point invocation it\n31|// performs.\n32|type Fixture struct {\n33|\tName string\n34|\tRun  func(seed uint64, calls *Calls) (report string, err error)\n35|}\n36|\n37|// Result is the executed record of one fixture.\n38|type Result struct {\n39|\tName   string\n40|\tReport string\n41|\tCalls  int64\n42|}\n43|\n44|// Runner executes fixtures in sorted name order over an explicit seed.\n45|// Registration order and Go map iteration order never affect execution:\n46|// names are sorted before every run, so identical inputs produce one\n47|// answer no matter how the caller stored the fixtures.\n48|type Runner struct {\n49|\t// AllowUnreached disables the arrival check. It exists only so the\n50|\t// suite can prove the check is load-bearing: with it set, an\n51|\t// unreached fixture passes, and TestRunnerRefusesUnreachedFixture\n52|\t// pins that the default refuses. Production use leaves the zero\n53|\t// value.\n54|\tAllowUnreached bool\n55|}\n56|\n57|// Run executes every fixture once and returns results in sorted name\n58|// order. A fixture that records zero production calls is refused with\n59|// an error naming it, unless AllowUnreached is set.\n60|func (runner Runner) Run(fixtures []Fixture, seed uint64) ([]Result, error) {\n61|\tordered := append([]Fixture(nil), fixtures...)\n62|\tsort.Slice(ordered, func(i, j int) bool { return ordered[i].Name < ordered[j].Name })\n63|\tresults := make([]Result, 0, len(ordered))\n64|\tfor _, fixture := range ordered {\n65|\t\tvar calls Calls\n66|\t\treport, err := fixture.Run(seed, &calls)\n67|\t\tif err != nil {\n68|\t\t\treturn nil, fmt.Errorf(\"secconftest runner: fixture %q: %w\", fixture.Name, err)\n69|\t\t}\n70|\t\tif !runner.AllowUnreached && calls.Count() == 0 {\n71|\t\t\treturn nil, fmt.Errorf(\"secconftest runner: fixture %q recorded no production call\", fixture.Name)\n72|\t\t}\n73|\t\tresults = append(results, Result{Name: fixture.Name, Report: report, Calls: calls.Count()})\n74|\t}\n75|\treturn results, nil\n76|}\n77|\n78|// Digest folds the execution log into one FNV-64 hex value: fixture\n79|// names, reports, and call counts in execution order. Two runs with\n80|// identical inputs produce identical digests; any dropped, reordered,\n81|// or altered fixture changes it.\n82|func Digest(results []Result) string {\n83|\tsum := fnv.New64a()\n84|\tfor _, result := range results {\n85|\t\t_, _ = fmt.Fprintf(sum, \"%s\\x00%s\\x00%d\\x00\", result.Name, result.Report, result.Calls)\n86|\t}\n87|\treturn fmt.Sprintf(\"%016x\", sum.Sum64())\n88|}\n89|\n90|// SortedNames reports the execution order for a fixture list. It shares\n91|// the sort with Run so the order claim is testable in isolation.\n92|func SortedNames(fixtures []Fixture) []string {\n93|\tordered := append([]Fixture(nil), fixtures...)\n94|\tsort.Slice(ordered, func(i, j int) bool { return ordered[i].Name < ordered[j].Name })\n95|\tnames := make([]string, 0, len(ordered))\n96|\tfor _, fixture := range ordered {\n97|\t\tnames = append(names, fixture.Name)\n98|\t}\n99|\treturn names\n100|}"}}}
