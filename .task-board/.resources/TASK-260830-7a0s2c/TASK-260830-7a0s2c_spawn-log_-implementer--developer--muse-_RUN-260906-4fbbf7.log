{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5df","stream":{"kind":"session","id":"01a077c8-d88a-7931-843c-3e9dddbe9444"},"sequence":330,"recorded_at":1780531400000655,"record_type":"event","durability":"durable","causation_id":"d502244e-0589-4672-9c20-02af4f4b0b68","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d502244e-0589-4672-9c20-02af4f4b0b68","run_stream":{"kind":"run","id":"d502244e-0589-4672-9c20-02af4f4b0b68"},"call_id":"call_01a077c9680070219583e12055f6e513","text":"Read text file `internal/secconftest/runner_test.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|)\n7|\n8|func TestRunnerExecutesInSortedOrder(t *testing.T) {\n9|\tt.Parallel()\n10|\tvar order []string\n11|\tfixtures := []Fixture{\n12|\t\t{Name: \"zeta\", Run: func(seed uint64, calls *Calls) (string, error) {\n13|\t\t\tcalls.Add(1)\n14|\t\t\torder = append(order, \"zeta\")\n15|\t\t\treturn \"z\", nil\n16|\t\t}},\n17|\t\t{Name: \"alpha\", Run: func(seed uint64, calls *Calls) (string, error) {\n18|\t\t\tcalls.Add(2)\n19|\t\t\torder = append(order, \"alpha\")\n20|\t\t\treturn \"a\", nil\n21|\t\t}},\n22|\t\t{Name: \"mid\", Run: func(seed uint64, calls *Calls) (string, error) {\n23|\t\t\tcalls.Add(3)\n24|\t\t\torder = append(order, \"mid\")\n25|\t\t\treturn \"m\", nil\n26|\t\t}},\n27|\t}\n28|\tvar runner Runner\n29|\tresults, err := runner.Run(fixtures, 7)\n30|\tif err != nil {\n31|\t\tt.Fatalf(\"Run: %v\", err)\n32|\t}\n33|\twant := []string{\"alpha\", \"mid\", \"zeta\"}\n34|\tgot := SortedNames(fixtures)\n35|\tif strings.Join(got, \",\") != strings.Join(want, \",\") {\n36|\t\tt.Fatalf(\"SortedNames = %v, want %v\", got, want)\n37|\t}\n38|\tif strings.Join(order, \",\") != strings.Join(want, \",\") {\n39|\t\tt.Fatalf(\"execution order = %v, want sorted %v\", order, want)\n40|\t}\n41|\tfor index, name := range want {\n42|\t\tif results[index].Name != name {\n43|\t\t\tt.Fatalf(\"results[%d].Name = %q, want %q\", index, results[index].Name, name)\n44|\t\t}\n45|\t}\n46|}\n47|\n48|func TestRunnerDigestIsDeterministic(t *testing.T) {\n49|\tt.Parallel()\n50|\tfixtures := []Fixture{\n51|\t\t{Name: \"b\", Run: func(seed uint64, calls *Calls) (string, error) {\n52|\t\t\tcalls.Add(1)\n53|\t\t\treturn \"report-b\", nil\n54|\t\t}},\n55|\t\t{Name: \"a\", Run: func(seed uint64, calls *Calls) (string, error) {\n56|\t\t\tcalls.Add(1)\n57|\t\t\treturn \"report-a\", nil\n58|\t\t}},\n59|\t}\n60|\tvar runner Runner\n61|\tfirst, err := runner.Run(fixtures, 99)\n62|\tif err != nil {\n63|\t\tt.Fatalf(\"Run: %v\", err)\n64|\t}\n65|\tsecond, err := runner.Run(fixtures, 99)\n66|\tif err != nil {\n67|\t\tt.Fatalf(\"Run: %v\", err)\n68|\t}\n69|\t// Registration order must not matter: reverse and rerun.\n70|\treversed := []Fixture{fixtures[1], fixtures[0]}\n71|\tthird, err := runner.Run(reversed, 99)\n72|\tif err != nil {\n73|\t\tt.Fatalf(\"Run: %v\", err)\n74|\t}\n75|\tif Digest(first) != Digest(second) || Digest(first) != Digest(third) {\n76|\t\tt.Fatalf(\"digest unstable: %q %q %q\", Digest(first), Digest(second), Digest(third))\n77|\t}\n78|\tt.Logf(\"deterministic digest: %s\", Digest(first))\n79|}\n80|\n81|func TestRunnerRefusesUnreachedFixture(t *testing.T) {\n82|\tt.Parallel()\n83|\tvar runner Runner\n84|\tfixtures := []Fixture{\n85|\t\t{Name: \"reached\", Run: func(seed uint64, calls *Calls) (string, error) {\n86|\t\t\tcalls.Add(1)\n87|\t\t\treturn \"ok\", nil\n88|\t\t}},\n89|\t\t{Name: \"unreached\", Run: func(seed uint64, calls *Calls) (string, error) {\n90|\t\t\treturn \"never touched production\", nil\n91|\t\t}},\n92|\t}\n93|\t_, err := runner.Run(fixtures, 1)\n94|\tif err == nil || !strings.Contains(err.Error(), `\"unreached\"`) {\n95|\t\tt.Fatalf(\"Run with an unreached fixture = %v, want an error naming it\", err)\n96|\t}\n97|}\n98|\n99|func TestRunnerAllowsUnreachedWhenOptedIn(t *testing.T) {\n100|\tt.Parallel()\n101|\trunner := Runner{AllowUnreached: true}\n102|\tfixtures := []Fixture{\n103|\t\t{Name: \"unreached\", Run: func(seed uint64, calls *Calls) (string, error) {\n104|\t\t\treturn \"opted in\", nil\n105|\t\t}},\n106|\t}\n107|\tresults, err := runner.Run(fixtures, 1)\n108|\tif err != nil {\n109|\t\tt.Fatalf(\"AllowUnreached Run: %v\", err)\n110|\t}\n111|\tif len(results) != 1 || results[0].Calls != 0 {\n112|\t\tt.Fatalf(\"AllowUnreached results = %+v, want one zero-call result\", results)\n113|\t}\n114|}\n115|\n116|func TestRunnerDigestCoversAllFixtures(t *testing.T) {\n117|\tt.Parallel()\n118|\tvar runner Runner\n119|\tfixtures := []Fixture{\n120|\t\t{Name: \"a\", Run: func(seed uint64, calls *Calls) (string, error) { calls.Add(1); return \"ra\", nil }},\n121|\t\t{Name: \"b\", Run: func(seed uint64, calls *Calls) (string, error) { calls.Add(1); return \"rb\", nil }},\n122|\t}\n123|\tfull, err := runner.Run(fixtures, 3)\n124|\tif err != nil {\n125|\t\tt.Fatalf(\"Run: %v\", err)\n126|\t}\n127|\tpartial, err := runner.Run(fixtures[:1], 3)\n128|\tif err != nil {\n129|\t\tt.Fatalf(\"Run: %v\", err)\n130|\t}\n131|\tif Digest(full) == Digest(partial) {\n132|\t\tt.Fatal(\"digest ignores a dropped fixture; the inventory is unwitnessed\")\n133|\t}\n134|\taltered := []Fixture{\n135|\t\t{Name: \"a\", Run: func(seed uint64, calls *Calls) (string, error) { calls.Add(1); return \"ra\", nil }},\n136|\t\t{Name: \"b\", Run: func(seed uint64, calls *Calls) (string, error) { calls.Add(9); return \"rb\", nil }},\n137|\t}\n138|\trerun, err := runner.Run(altered, 3)\n139|\tif err != nil {\n140|\t\tt.Fatalf(\"Run: %v\", err)\n141|\t}\n142|\tif Digest(full) == Digest(rerun) {\n143|\t\tt.Fatal(\"digest ignores a changed call count; the execution log is unwitnessed\")\n144|\t}\n145|}\n146|\n147|func TestRunnerDigestDistinguishesReports(t *testing.T) {\n148|\tt.Parallel()\n149|\t// Same names, same call counts, different reports: a digest that\n150|\t// drops the report witnesses nothing and must fail here.\n151|\trun := func(report string) []Result {\n152|\t\tvar runner Runner\n153|\t\tresults, err := runner.Run([]Fixture{\n154|\t\t\t{Name: \"a\", Run: func(seed uint64, calls *Calls) (string, error) { calls.Add(1); return report, nil }},\n155|\t\t}, 3)\n156|\t\tif err != nil {\n157|\t\t\tt.Fatalf(\"Run: %v\", err)\n158|\t\t}\n159|\t\treturn results\n160|\t}\n161|\tif Digest(run(\"ra\")) == Digest(run(\"rb\")) {\n162|\t\tt.Fatal(\"digest ignores the report; the witness is call counts only\")\n163|\t}\n164|}\n165|\n166|func TestRunnerDigestDistinguishesNames(t *testing.T) {\n167|\tt.Parallel()\n168|\t// Same reports, same call counts, different names: a digest that\n169|\t// drops the name witnesses nothing and must fail here.\n170|\trun := func(name string) []Result {\n171|\t\tvar runner Runner\n172|\t\tresults, err := runner.Run([]Fixture{\n173|\t\t\t{Name: name, Run: func(seed uint64, calls *Calls) (string, error) { calls.Add(1); return \"r\", nil }},\n174|\t\t}, 3)\n175|\t\tif err != nil {\n176|\t\t\tt.Fatalf(\"Run: %v\", err)\n177|\t\t}\n178|\t\treturn results\n179|\t}\n180|\tif Digest(run(\"a\")) == Digest(run(\"b\")) {\n181|\t\tt.Fatal(\"digest ignores the name; the witness is call counts only\")\n182|\t}\n183|}\n184|\n185|func TestRunnerPropagatesFixtureError(t *testing.T) {\n186|\tt.Parallel()\n187|\tvar runner Runner\n188|\tfixtures := []Fixture{\n189|\t\t{Name: \"broken\", Run: func(seed uint64, calls *Calls) (string, error) {\n190|\t\t\tcalls.Add(1)\n191|\t\t\treturn \"\", errTestSentinel\n192|\t\t}},\n193|\t}\n194|\t_, err := runner.Run(fixtures, 1)\n195|\tif err == nil || !strings.Contains(err.Error(), `\"broken\"`) {\n196|\t\tt.Fatalf(\"Run with a failing fixture = %v, want an error naming it\", err)\n197|\t}\n198|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5e1","stream":{"kind":"session","id":"01a077c8-d88a-7931-843c-3e9dddbe9444"},"sequence":331,"recorded_at":1780531400000657,"record_type":"event","durability":"durable","causation_id":"d502244e-0589-4672-9c20-02af4f4b0b68","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d502244e-0589-4672-9c20-02af4f4b0b68","run_stream":{"kind":"run","id":"d502244e-0589-4672-9c20-02af4f4b0b68"},"call_id":"call_01a077c968c97b73b488be2f33ca15f7","text":"Read text file `internal/secconftest/clock_test.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"testing\"\n6|\t\"time\"\n7|)\n8|\n9|var errTestSentinel = errors.New(\"secconftest test sentinel\")\n10|\n11|func TestFakeClockStartsPinned(t *testing.T) {\n12|\tt.Parallel()\n13|\tfirst := &Fake{}\n14|\tsecond := &Fake{}\n15|\tif !first.Now().Equal(second.Now()) {\n16|\t\tt.Fatalf(\"two fresh fakes disagree: %v vs %v\", first.Now(), second.Now())\n17|\t}\n18|\tif first.Now().Location() != time.UTC {\n19|\t\tt.Fatalf(\"fake start location = %v, want UTC\", first.Now().Location())\n20|\t}\n21|}\n22|\n23|func TestFakeClockIgnoresRealTime(t *testing.T) {\n24|\tt.Parallel()\n25|\tclock := &Fake{}\n26|\tbefore := clock.Now()\n27|\twallBefore := time.Now()\n28|\ttime.Sleep(20 * time.Millisecond)\n29|\tif got := clock.Now(); !got.Equal(before) {\n30|\t\tt.Fatalf(\"fake advanced without Advance: %v -> %v\", before, got)\n31|\t}\n32|\tif !time.Now().After(wallBefore) {\n33|\t\tt.Fatal(\"wall clock did not advance; the test cannot tell fake from real\")\n34|\t}\n35|}\n36|\n37|func TestFakeAdvanceAndSet(t *testing.T) {\n38|\tt.Parallel()\n39|\tclock := &Fake{}\n40|\tstart := clock.Now()\n41|\tclock.Advance(90 * time.Second)\n42|\tif got := clock.Now().Sub(start); got != 90*time.Second {\n43|\t\tt.Fatalf(\"Advance(90s) moved %v\", got)\n44|\t}\n45|\tclock.Advance(-time.Hour)\n46|\tif got := clock.Now().Sub(start); got != 90*time.Second {\n47|\t\tt.Fatalf(\"negative Advance moved the clock to %v\", got)\n48|\t}\n49|\tpinned := time.Date(2030, time.May, 4, 12, 0, 0, 0, time.UTC)\n50|\tclock.Set(pinned)\n51|\tif got := clock.Now(); !got.Equal(pinned) {\n52|\t\tt.Fatalf(\"Set moved to %v, want %v\", got, pinned)\n53|\t}\n54|}\n55|\n56|func TestRecordingNoticesUnwiredClock(t *testing.T) {\n57|\tt.Parallel()\n58|\twired := Wrap(&Fake{})\n59|\t_ = wired.Now()\n60|\tif got := wired.Calls(); got != 1 {\n61|\t\tt.Fatalf(\"wired path recorded %d Now calls, want 1\", got)\n62|\t}\n63|\tunwired := Wrap(&Fake{})\n64|\t// The buggy path takes the clock and never reads it (wall clock or\n65|\t// no clock instead). The suite must notice the zero, not pass it.\n66|\tif got := unwired.Calls(); got != 0 {\n67|\t\tt.Fatalf(\"unwired path recorded %d Now calls, want the detectable 0\", got)\n68|\t}\n69|}\n70|\n71|func TestRecordingCountsConcurrentReads(t *testing.T) {\n72|\tt.Parallel()\n73|\trecording := Wrap(&Fake{})\n74|\tdone := make(chan struct{})\n75|\tfor range 8 {\n76|\t\tgo func() {\n77|\t\t\t_ = recording.Now()\n78|\t\t\tdone <- struct{}{}\n79|\t\t}()\n80|\t}\n81|\tfor range 8 {\n82|\t\t<-done\n83|\t}\n84|\tif got := recording.Calls(); got != 8 {\n85|\t\tt.Fatalf(\"concurrent Now calls recorded %d, want 8\", got)\n86|\t}\n87|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5e3","stream":{"kind":"session","id":"01a077c8-d88a-7931-843c-3e9dddbe9444"},"sequence":332,"recorded_at":1780531400000659,"record_type":"event","durability":"durable","causation_id":"d502244e-0589-4672-9c20-02af4f4b0b68","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d502244e-0589-4672-9c20-02af4f4b0b68","run_stream":{"kind":"run","id":"d502244e-0589-4672-9c20-02af4f4b0b68"},"call_id":"call_01a077c969717642a28a72c665a3af89","text":"{\n  \"chunk_id\": \"exec-9-1\",\n  \"command\": \"cat LOGBOOK.md | head -n 30\\necho \\\"===README diff===\\\"\\ngit diff HEAD -- README.md | head -n 120\",\n  \"description\": \"Check README and LOGBOOK diffs\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"# Flight Logbook\\n\\n> Institutional memory. Concise, factual, high-signal.\\n> Newest entries first. One block per insight.\\n\\n## 2026-09-06\\n\\n### 2105 — secconftest round-2 rework: C1–C4 closed, instrument stops reporting untrue things\\n- SCOPE: TASK-260830-7a0s2c round-2 (review-verdict-rev1, C1–C4 blocking). Production (test instrument) only in `internal/secconftest`: `crash.go` (finalize gate + `ErrRollbackPastFinalize`, `RemainingArmed`), `skip.go` (`Report()` over live counters, real `mkfifo` fifo probe), `skip_fifo_unix/windows.go` (new, `makeFifo` + fault seam), `hostile.go` untouched, `fuzz_test.go` (no-op poles), `doc.go` (bounds). Leaf-1 `internal/secprim` untouched (`git diff HEAD -- internal/secprim` empty).\\n- C1: `Rollback` now refuses post-commit with `ErrRollbackPastFinalize` and leaves committed bytes intact; `TestTransactorRefusesRollbackPastFinalize` commits-then-rolls-back (the arm it is named for) plus both old arms. Deleting the gate is killed by it (battery A1).\\n- C2: `Report()` reads the live counters; `TestSkipReportReadsRecordedVerdicts` records synthetic verdicts, asserts the report moves, restores state (gutting `recordVerdict` reddens it, battery A4). The round-1 `skipped=0` citation was a constant — genuine datum is 0 `--- SKIP` / 0 `--- FAIL` lines under `go test -v` on darwin non-root, now cited in README/outcome/doc.go.\\n- C3: fifo probe builds a real FIFO (`syscall.Mkfifo`+Lstat; Windows stub unavailable) with a fault seam (`TestSkipFifoProbeAttemptsItsCapability` kills a success-on-failure weakening, battery N14). All 4 probes gate real tests: symlink→escape witness, fifo→byte-exchange fixture, mode-bits+nonroot→denial test (4/4 wired, was 1/4).\\n- C4: all 8 listed survivors closed — digest report/name distinguishing tests (N1–N3), bidi rune-for-rune pin + corpus coverage (N4–N5), Gate pin+drive for all 18 classes (N6), verdict counter test (A4), commit-requires-prepare with planted staged file (A3). Battery re-derived from this tree: 29 applied / 0 NOT_APPLIED / 0 COMPILE_FAIL / 0 VET_FAIL, 27 killed (15 narrowing + 8 arm-deletion + 4 census-only), 2 survived with bounds: N16 driver-delegation (read-verified + arrival-counted) and S1 mode-bits-false (survives-as-SKIP by construction — the SKIP line is the signal). N10 token-preserving mutant killed by the full behavioral suite; tree sha256-identical after the battery.\\n- EVIDENCE: outcome `TASK-260830-7a0s2c_secconftest-round2.md` (6/6 AC rows corrected, 29-row mutant table with bounds, gates with exit codes) + `TASK-260830-7a0s2c_mutant-battery-round2.log` + full-test log.\\n- GATES: `go test ./... -count=1` exit 0 (21 pkgs), secconftest `-race` exit 0, `./... -cover` exit 0 (secconftest 89.3%, secprim 94.4% unchanged), `go vet` + `GOOS=windows go vet/build` exit 0, gofmt clean, `tracecheck` exit 0 (94 cases, unchanged), 8/8 fuzz `-fuzztime=100x` exit 0 with no corpus written, digest `5569f34caab734eb` x5 processes.\\n- STATUS: Ready for review, handed off to review (review/landing are orchestrator steps).\\n\\n### 2035 — secconftest instrument leaf: runners, fake clocks, crash points, fuzz, hostile strings, skips\\n- SCOPE: TASK-260830-7a0s2c (second leaf of STORY-260830-1i3qu7). New package `internal/secconftest` (doc/runner/clock/crash/fuzz/hostile/skip + 6 test files): sorted deterministic Runner with execution digest and zero-call refusal, wall-clock-free Fake with Recording wiring detector, CR-MAT-* Injector over a three-phase Transactor with §13.13 outcomes and idempotency_mismatch, 8 Fuzz targets through one shared Driver with seed arrival proofs, 18-class spec-derived hostile roster plus symlink-escape commit witness, 4 probed capabilities with strict-platform failure. Leaf-1 `internal/secprim` production untouched; `task-board.config.json` gains the 8 required fuzz validation commands (pinned by `TestConfiguredValidationRunsEveryFuzzTargetWithFixedBudget`, which failed until registered).\\n- FINDING: the repo already forces fuzz registration — a new Fuzz target without a config line fails `TestConfiguredValidationRunsEveryFuzzTargetWithFixedBudget` plus its coverage parent. The instrument therefore cannot silently add unfuzzed-in-CI targets.\\n- FINDING (M6): a Fake leaking `time.Now` is caught by two fresh fakes disagreeing (real timestamps in the failure), not just by the sleep test — the stronger kill.\\n- EVIDENCE: outcome `TASK-260830-7a0s2c_secconftest.md` (6/6 AC rows with call sites, 10-row mutant table: 4 narrowing + 4 arm-deletion + 2 census-only, 10/10 killed, 0 survivors; M4 token-preserving mutant with 222-pass/1-fail full-suite run; darwin skip report skipped=0; digest `5569f34caab734eb` x3).\\n- GATES: `go test ./... -count=1` exit 0 (21 pkgs), `-race` exit 0, `-cover` exit 0 (secconftest 86.9%), `go vet` + `GOOS=windows go vet` + `GOOS=windows go build` exit 0, gofmt clean, `tracecheck` exit 0 (94 cases, unchanged). 8/8 fuzz targets pass 5s smoke and `-fuzztime=100x` with no corpus written.\\n- STATUS: Ready for review, handed off to review (review/landing are orchestrator steps).\\n\\n### 1939 — secprim round-3 rework: C1 handle binding, C2 classify-before-close, C3 spelling bound, N24 restored\\n- SCOPE: TASK-260830-2ciy0s round-3 (review-verdict-rev2, C1–C4 blocking). Production: `internal/secprim/nofollow.go` (`guardRootMatches` fstat dev/ino compare via `os.SameFile`, new `guard root mismatch` site in `Guard.Open`); `open_member_unix.go` (classify-before-close at both sites); spelling bound stated in `errors.go`/`inventory_test.go`/README + `TestRefusalInventorySpellingBoundIsStated`; honest reparse mapping in both windows files + README. Tests: `guard_root_test.go` (foreign-handle refusal + matched control, cross-platform), depth-3/4 full-string vectors in `open_unix_test.go`.\\n- ROOT CAUSE (C1): `openCommitRelative(root, _ string, ...)` discarded `guard.root`; unix walked the handle, Windows the path — one entry, two containment roots. Fixed in shared `Guard.Open` so both answer identically.\\n- ROOT CAUSE (C2): from iteration 2 `previous == current`; closing before `classifyCommitErr` fstat'd a recycled fd, misreporting depth>=2 symlink hops as `open failed`. Revert reproduces the exact reported string.\\n- FINDING (N24): arm-drop spelling KILLS (`target special file` vs `target directory`); the `Size() > 0` spelling SURVIVES (empty dirs report Size > 0) — rev2 withdrew the wrong spelling. FINDING (D14): scripted shape is COMPILE-FAIL (unused import), superseded by killing D14b.\\n===README diff===\\ndiff --git a/README.md b/README.md\\nindex 6026a8b..79ceb60 100644\\n--- a/README.md\\n+++ b/README.md\\n@@ -607,6 +607,85 @@ go test ./internal/secprim -count=1\\n go test ./internal/secprim -cover -count=1\\n ```\\n \\n+## Security Conformance Test Instrument\\n+\\n+[`internal/secconftest`](internal/secconftest) is the test instrument\\n+for the Section 16 production gates above: deterministic fixture\\n+runners, fake clocks, crash points, protocol fuzz drivers, hostile\\n+strings, and platform capability skips. It decides nothing itself —\\n+every refusal stays in `secprim`, every grammar in\\n+[`internal/scalar`](internal/scalar), every bound check in\\n+[`internal/environ`](internal/environ) — and every mechanism ships\\n+with a proof that disabling it reddens the suite.\\n+\\n+The `Runner` executes named fixtures in sorted order over an explicit\\n+seed and folds names, reports, and production-call counts into one\\n+digest, with each component witnessed by a dedicated test (a\\n+report-only or name-only change reddens the suite); a fixture that\\n+records no production call is refused, so a corpus that never reaches\\n+the entry point cannot pass as coverage. `Fake` is a manually\\n+advanced clock that never reads the wall clock (a 20 ms sleep moves\\n+`time.Now` and not the fake), and the `Recording` wrapper makes an\\n+unwired clock read as zero calls — detected, not passed. The\\n+`Injector` arms five instrument-local `CR-MAT-*` phase boundaries\\n+(not the SPEC `CR-MAT-01..08` registry, whose names are refused as\\n+unknown) over a three-phase durable-commit model with the Section\\n+13.13 outcome vocabulary (`safe_retry`, `explicit_rollback`,\\n+`recoverable_parked_state`); identical retries return the\\n+byte-identical receipt while a changed body fails with\\n+`idempotency_mismatch` and stages nothing new, and a clean `Commit`\\n+finalizes the operation so further rollback is refused with the\\n+committed bytes intact (`AC-CLONE-005`). Every armed point is\\n+consumption-checked, so an arm the drive never reaches fails its\\n+test. Eight `Fuzz*` targets drive the argv, member-path, env-name,\\n+redact, escape, render, guard-resolve, and case-collision entries\\n+through one shared `Driver` that seed-corpus tests prove reaches\\n+production (22 arrivals per entry); the env-name and redact targets\\n+additionally pin the poles a no-op gate fails (refused empty /\\n+admitted well-formed name; rewritten secret / passing innocuous\\n+line). Every target is registered in the configured validation\\n+matrix. The hostile roster derives 18 classes from the pinned\\n+specification text (every quote verified in its section) with members\\n+generated from Unicode tables and `scalar` predicates rather than the\\n+gates under test; every roster `Gate` is pinned and driven through\\n+the production entry it names, the bidi vocabulary is pinned\\n+rune-for-rune with corpus coverage, plus a symlink-escape commit\\n+witness gated on a probed capability. Capability probes (`symlink`,\\n+`fifo`, `mode-bits`, `nonroot`) each really attempt their\\n+capability — symlink create+Lstat, `mkfifo`+Lstat, `chmod 000`\\n+denial, uid check — and each gates a named test (symlink-escape\\n+commit witness, fifo byte-exchange fixture, mode-bits/nonroot denial\\n+test); they skip only where the platform cannot provide and fail on\\n+strict platforms where absence is unexpected. The per-test skip\\n+datum is the `--- SKIP` lines under `go test -v` (0 on darwin/arm64\\n+non-root); the process-wide report line witnesses only verdicts the\\n+suite really recorded.\\n+\\n+Run the focused tests, race, coverage, and fuzz smoke with:\\n+\\n+```bash\\n+go test ./internal/secconftest -count=1\\n+go test ./internal/secconftest -race -count=1\\n+go test ./internal/secconftest -cover -count=1\\n+go test ./internal/secconftest -run='^$' -fuzz='^FuzzCheckArgv$' -fuzztime=100x -parallel=1\\n+```\\n+\\n+Stated bounds: the commit model proves the injector and the outcome\\n+vocabulary, not any product recovery path; the crash-point names are\\n+instrument-local, not the SPEC registry, and a site added without an\\n+arm is outside the model. Fuzz covers the Section 16 string and\\n+vector gates, not containment races; the env-name/redact fuzz pins\\n+cover the no-op poles while the interior grammar and per-class\\n+markers stay with the hostile corpus; tombstone-deletion and TOCTOU\\n+shapes have no product surface in this story and are not driven. A\\n+skip-gated probe that reports unavailable on a non-strict platform\\n+skips by construction —\\n+the `--- SKIP` line is the signal, so CI watches skip counts rather\\n+than treating green as unskipped. Driver delegation to production is\\n+read-verified with arrival counts, not mutant-pinned. No new\\n+capability is advertised: the instrument cannot enable a platform\\n+lane or provider suite.\\n+\\n ## Canonical JSON and Immutable Object Identities\\n \\n [`internal/canonicaljson`](internal/canonicaljson) exposes the production RFC\\n\",\n  \"original_output_bytes\": 11406,\n  \"original_output_tokens\": 2852,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
