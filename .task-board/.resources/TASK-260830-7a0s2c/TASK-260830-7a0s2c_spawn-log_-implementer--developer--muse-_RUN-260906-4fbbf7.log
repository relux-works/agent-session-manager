{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7fb","stream":{"kind":"session","id":"01a077c8-d88a-7931-843c-3e9dddbe9444"},"sequence":600,"recorded_at":1780531400001195,"record_type":"event","durability":"durable","causation_id":"d502244e-0589-4672-9c20-02af4f4b0b68","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d502244e-0589-4672-9c20-02af4f4b0b68","run_stream":{"kind":"run","id":"d502244e-0589-4672-9c20-02af4f4b0b68"},"task_stream":{"kind":"task","id":"a2118c66-85f3-4226-b3ae-adc9a2e1eae4"},"task_id":"a2118c66-85f3-4226-b3ae-adc9a2e1eae4","event":{"kind":"output","task_id":"a2118c66-85f3-4226-b3ae-adc9a2e1eae4","chunk":"Read text file `internal/secconftest/crash.go`.\n(289 line(s) above)\n290|\tstaged := filepath.Join(transactor.root, operationID+\".staged\")\n291|\tcommitted := filepath.Join(transactor.root, operationID+\".committed\")\n292|\tcontents, err := os.ReadFile(staged)\n293|\tif err != nil {\n294|\t\tif os.IsNotExist(err) {\n295|\t\t\treturn Receipt{}, fmt.Errorf(\"secconftest: commit without staged bytes for operation %q: %w\", operationID, err)\n296|\t\t}\n297|\t\treturn Receipt{}, err\n298|\t}\n299|\tif err := os.WriteFile(committed, contents, 0o600); err != nil {\n300|\t\treturn Receipt{}, err\n301|\t}\n302|\t_ = os.Remove(staged)\n303|\tif err := transactor.injector.MaybeFail(PointCommitApply); err != nil {\n304|\t\treceipt.Outcome = OutcomeRecoverableParked\n305|\t\ttransactor.mutex.Lock()\n306|\t\ttransactor.receipts[operationID] = receipt\n307|\t\ttransactor.finalized[operationID] = true\n308|\t\ttransactor.mutex.Unlock()\n309|\t\treturn Receipt{}, err\n310|\t}\n311|\treceipt.Outcome = OutcomeExplicitRollback\n312|\ttransactor.mutex.Lock()\n313|\ttransactor.receipts[operationID] = receipt\n314|\ttransactor.finalized[operationID] = true\n315|\ttransactor.mutex.Unlock()\n316|\treturn receipt, nil\n317|}\n318|\n319|// ErrRollbackPastFinalize reports a rollback refused after a clean\n320|// Commit: the operation is terminal and rollback is forbidden\n321|// (AC-CLONE-005 shapes this rule; the model enforces it).\n322|var ErrRollbackPastFinalize = errors.New(\"secconftest rollback forbidden after commit\")\n323|\n324|// Rollback removes staged bytes for operationID before finalization.\n325|// It refuses to run past finalization: once Commit returns cleanly the\n326|// operation is terminal, rollback is forbidden, and the committed\n327|// bytes must survive the refused call untouched. Deleting the finalize\n328|// gate must fail the test that commits and then rolls back.\n329|func (transactor *Transactor) Rollback(operationID string) error {\n330|\tif err := transactor.injector.MaybeFail(PointRollbackEnter); err != nil {\n331|\t\treturn err\n332|\t}\n333|\ttransactor.mutex.Lock()\n334|\t_, ok := transactor.receipts[operationID]\n335|\tfinalized := transactor.finalized[operationID]\n336|\ttransactor.mutex.Unlock()\n337|\tif !ok {\n338|\t\treturn fmt.Errorf(\"secconftest: rollback without prepare for operation %q\", operationID)\n339|\t}\n340|\tif finalized {\n341|\t\treturn fmt.Errorf(\"%w: operation %q\", ErrRollbackPastFinalize, operationID)\n342|\t}\n343|\t_ = os.Remove(filepath.Join(transactor.root, operationID+\".staged\"))\n344|\t_ = os.Remove(filepath.Join(transactor.root, operationID+\".committed\"))\n345|\treturn nil\n346|}\n347|\n348|// CommittedBytes reads back the committed bytes for operationID.\n349|func (transactor *Transactor) CommittedBytes(operationID string) ([]byte, error) {\n(more lines below)"}}}
