{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4cd","stream":{"kind":"session","id":"01a077c8-d88a-7931-843c-3e9dddbe9444"},"sequence":193,"recorded_at":1780531400000381,"record_type":"event","durability":"durable","causation_id":"d502244e-0589-4672-9c20-02af4f4b0b68","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d502244e-0589-4672-9c20-02af4f4b0b68","run_stream":{"kind":"run","id":"d502244e-0589-4672-9c20-02af4f4b0b68"},"call_id":"call_01a077c943217162acba453540f58137","text":"Read text file `internal/secconftest/crash.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"errors\"\n7|\t\"fmt\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"sort\"\n11|\t\"sync\"\n12|)\n13|\n14|// Outcome is the Section 13.13 crash/restart vocabulary every crash\n15|// point classifies into. AC-CRASH-001 requires exactly one of these per\n16|// injection with the section's evidence record; no run may produce\n17|// duplicate live owners, treat an unfenced external continuation as\n18|// safe, or substitute a fresh identity for the persisted one.\n19|type Outcome string\n20|\n21|const (\n22|\t// OutcomeSafeRetry means the operation never mutated durable state\n23|\t// and the identical retry is safe.\n24|\tOutcomeSafeRetry Outcome = \"safe_retry\"\n25|\t// OutcomeExplicitRollback means durable state mutated and the caller\n26|\t// must roll back before any retry.\n27|\tOutcomeExplicitRollback Outcome = \"explicit_rollback\"\n28|\t// OutcomeRecoverableParked means the operation stopped in a named\n29|\t// parked state from which an operator or a later run recovers; it\n30|\t// must never silently resume as a fresh identity.\n31|\tOutcomeRecoverableParked Outcome = \"recoverable_parked_state\"\n32|)\n33|\n34|// Crash points name the phase boundaries the injector can fire on. The\n35|// families follow the AC-CRASH-001 class list (CR-LAUNCH-*, CR-SYNC-*,\n36|// CR-MAT-*, CR-GRACE-*, CR-FORCE-*, CR-FORK-*, CR-STOP-*, CR-RESUME-*,\n37|// CR-RESTORE-*, CR-CLONE-01..16); the suffix selects the boundary\n38|// inside the modeled operation.\n39|const (\n40|\tPointPrepareEnter  = \"CR-MAT-prepare-enter\"\n41|\tPointPrepareCommit = \"CR-MAT-prepare-commit\"\n42|\tPointCommitEnter   = \"CR-MAT-commit-enter\"\n43|\tPointCommitApply   = \"CR-MAT-commit-apply\"\n44|\tPointRollbackEnter = \"CR-MAT-rollback-enter\"\n45|)\n46|\n47|// ErrInjected reports a fired crash point. It carries the point and the\n48|// classified outcome so the caller cannot observe the fault without\n49|// observing what it requires.\n50|var ErrInjected = errors.New(\"secconftest injected crash\")\n51|\n52|// Fault is the fired crash-point evidence.\n53|type Fault struct {\n54|\tpoint   string\n55|\toutcome Outcome\n56|}\n57|\n58|func (fault *Fault) Error() string {\n59|\treturn fmt.Sprintf(\"%v: %s requires %s\", ErrInjected, fault.point, fault.outcome)\n60|}\n61|\n62|// Unwrap matches ErrInjected so callers match the fault kind without\n63|// parsing human text.\n64|func (fault *Fault) Unwrap() error {\n65|\treturn ErrInjected\n66|}\n67|\n68|// Point names the fired crash point.\n69|func (fault *Fault) Point() string { return fault.point }\n70|\n71|// Outcome classifies the fired crash point into the Section 13.13\n72|// vocabulary.\n73|func (fault *Fault) Outcome() Outcome { return fault.outcome }\n74|\n75|// Classify maps a crash point to its required outcome. Points before\n76|// any durable mutation are safe_retry; points after the journal takes\n77|// effect require explicit_rollback; points past the commit marker park\n78|// for recovery. Weakening any row to a different outcome must fail the\n79|// table test that drives it.\n80|func Classify(point string) (Outcome, error) {\n81|\tswitch point {\n82|\tcase PointPrepareEnter:\n83|\t\treturn OutcomeSafeRetry, nil\n84|\tcase PointPrepareCommit, PointCommitEnter, PointRollbackEnter:\n85|\t\treturn OutcomeExplicitRollback, nil\n86|\tcase PointCommitApply:\n87|\t\treturn OutcomeRecoverableParked, nil\n88|\tdefault:\n89|\t\treturn \"\", fmt.Errorf(\"secconftest: unknown crash point %q\", point)\n90|\t}\n91|}\n92|\n93|// Injector arms named crash points. The zero value is usable and fires\n94|// nothing. MaybeFail is the only firing entry: production-shaped code\n95|// under test calls it at each phase boundary.\n96|type Injector struct {\n97|\tmutex sync.Mutex\n98|\tarmed map[string]bool\n99|}\n100|\n101|// Arm fires point on its next MaybeFail call.\n102|func (injector *Injector) Arm(point string) {\n103|\tinjector.mutex.Lock()\n104|\tdefer injector.mutex.Unlock()\n105|\tif injector.armed == nil {\n106|\t\tinjector.armed = map[string]bool{}\n107|\t}\n108|\tinjector.armed[point] = true\n109|}\n110|\n111|// Disarm clears every armed point.\n112|func (injector *Injector) Disarm() {\n113|\tinjector.mutex.Lock()\n114|\tdefer injector.mutex.Unlock()\n115|\tinjector.armed = map[string]bool{}\n116|}\n117|\n118|// Armed reports whether point is currently armed.\n119|func (injector *Injector) Armed(point string) bool {\n120|\tinjector.mutex.Lock()\n121|\tdefer injector.mutex.Unlock()\n122|\treturn injector.armed[point]\n123|}\n124|\n125|// RemainingArmed lists the points still armed, sorted. A test that arms\n126|// a point and drives the operation must find this empty afterwards: an\n127|// armed point that never fires is otherwise noticed only incidentally,\n128|// and a new crash site added without an arm is outside this model (see\n129|// the package bounds). Weakening this to a constant empty slice must\n130|// fail the consumption test that drives it.\n131|func (injector *Injector) RemainingArmed() []string {\n132|\tinjector.mutex.Lock()\n133|\tdefer injector.mutex.Unlock()\n134|\tremaining := make([]string, 0, len(injector.armed))\n135|\tfor point := range injector.armed {\n136|\t\tremaining = append(remaining, point)\n137|\t}\n138|\tsort.Strings(remaining)\n139|\treturn remaining\n140|}\n141|\n142|// MaybeFail returns a *Fault when point is armed and consumes the arm,\n143|// so each armed point fires exactly once. It returns nil when\n144|// disarmed. An unknown point name is a caller error, never silent.\n145|func (injector *Injector) MaybeFail(point string) error {\n146|\toutcome, err := Classify(point)\n147|\tif err != nil {\n148|\t\treturn err\n149|\t}\n150|\tinjector.mutex.Lock()\n151|\tfire := injector.armed[point]\n152|\tif fire {\n153|\t\tdelete(injector.armed, point)\n154|\t}\n155|\tinjector.mutex.Unlock()\n156|\tif !fire {\n157|\t\treturn nil\n158|\t}\n159|\treturn &Fault{point: point, outcome: outcome}\n160|}\n161|\n162|// ErrIdempotencyMismatch reports a lost-response retry that changed the\n163|// operation body: AC-MAT-004 requires the byte-identical receipt for\n164|// the identical retry and a failure that creates no second root for a\n165|// changed one.\n166|var ErrIdempotencyMismatch = errors.New(\"secconftest idempotency_mismatch\")\n167|\n168|// Receipt is the durable proof of one transacted operation.\n169|type Receipt struct {\n170|\tOperationID string\n171|\tBodyDigest  string\n172|\tOutcome     Outcome\n173|\tBytes       []byte\n174|}\n175|\n176|// Transactor is a three-phase durable-commit model (prepare, commit,\n177|// rollback) over a directory, driven through MaybeFail boundaries. It\n178|// exists to prove the injector, the outcome vocabulary, and the\n179|// idempotency rule against real filesystem state; it is not a product\n180|// journal and no product path may import it for recovery.\n181|type Transactor struct {\n182|\tinjector *Injector\n183|\troot     string\n184|\tmutex    sync.Mutex\n185|\treceipts map[string]Receipt\n186|\t// finalized marks operations whose Commit returned cleanly. The\n187|\t// operation is then terminal and Rollback must refuse it\n188|\t// (AC-CLONE-005: rollback is forbidden after Provider commit).\n189|\tfinalized map[string]bool\n190|}\n191|\n192|// NewTransactor binds a Transactor to root, which must exist.\n193|func NewTransactor(injector *Injector, root string) *Transactor {\n194|\treturn &Transactor{injector: injector, root: root, receipts: map[string]Receipt{}, finalized: map[string]bool{}}\n195|}\n196|\n197|func digestBody(body []byte) string {\n198|\tsum := sha256.Sum256(body)\n199|\treturn hex.EncodeToString(sum[:])\n200|}\n201|\n202|// Prepare stages body under operationID and fsyncs the journal entry.\n203|// A retry with the same operation ID and byte-identical body returns\n204|// the identical receipt without staging twice. A retry with the same\n205|// ID and a different body fails with ErrIdempotencyMismatch and\n206|// stages nothing new.\n207|func (transactor *Transactor) Prepare(operationID string, body []byte) (Receipt, error) {\n208|\tif operationID == \"\" {\n209|\t\treturn Receipt{}, errors.New(\"secconftest: empty operation ID\")\n210|\t}\n211|\tif err := transactor.injector.MaybeFail(PointPrepareEnter); err != nil {\n212|\t\treturn Receipt{}, err\n213|\t}\n214|\tdigest := digestBody(body)\n215|\ttransactor.mutex.Lock()\n216|\tif prior, ok := transactor.receipts[operationID]; ok {\n217|\t\ttransactor.mutex.Unlock()\n218|\t\tif prior.BodyDigest != digest {\n219|\t\t\treturn Receipt{}, fmt.Errorf(\"%w: operation %q body changed\", ErrIdempotencyMismatch, operationID)\n220|\t\t}\n221|\t\treturn prior, nil\n222|\t}\n223|\ttransactor.mutex.Unlock()\n224|\tstaged := filepath.Join(transactor.root, operationID+\".staged\")\n225|\tif err := os.WriteFile(staged, body, 0o600); err != nil {\n226|\t\treturn Receipt{}, err\n227|\t}\n228|\tif err := transactor.injector.MaybeFail(PointPrepareCommit); err != nil {\n229|\t\t_ = os.Remove(staged)\n230|\t\treturn Receipt{}, err\n231|\t}\n232|\treceipt := Receipt{OperationID: operationID, BodyDigest: digest, Outcome: OutcomeSafeRetry, Bytes: append([]byte(nil), body...)}\n233|\ttransactor.mutex.Lock()\n234|\ttransactor.receipts[operationID] = receipt\n235|\ttransactor.mutex.Unlock()\n236|\treturn receipt, nil\n237|}\n238|\n239|// Commit promotes the staged body to committed bytes. It fails armed\n240|// crash points before (commit-enter: rollback required) and after\n241|// (commit-apply: parked) the durable rename.\n242|func (transactor *Transactor) Commit(operationID string) (Receipt, error) {\n243|\tif err := transactor.injector.MaybeFail(PointCommitEnter); err != nil {\n244|\t\treturn Receipt{}, err\n245|\t}\n246|\ttransactor.mutex.Lock()\n247|\treceipt, ok := transactor.receipts[operationID]\n248|\ttransactor.mutex.Unlock()\n249|\tif !ok {\n250|\t\treturn Receipt{}, fmt.Errorf(\"secconftest: commit without prepare for operation %q\", operationID)\n251|\t}\n252|\tstaged := filepath.Join(transactor.root, operationID+\".staged\")\n253|\tcommitted := filepath.Join(transactor.root, operationID+\".committed\")\n254|\tcontents, err := os.ReadFile(staged)\n255|\tif err != nil {\n256|\t\treturn Receipt{}, err\n257|\t}\n258|\tif err := os.WriteFile(committed, contents, 0o600); err != nil {\n259|\t\treturn Receipt{}, err\n260|\t}\n261|\t_ = os.Remove(staged)\n262|\tif err := transactor.injector.MaybeFail(PointCommitApply); err != nil {\n263|\t\treturn Receipt{}, err\n264|\t}\n265|\treceipt.Outcome = OutcomeExplicitRollback\n266|\ttransactor.mutex.Lock()\n267|\ttransactor.receipts[operationID] = receipt\n268|\ttransactor.finalized[operationID] = true\n269|\ttransactor.mutex.Unlock()\n270|\treturn receipt, nil\n271|}\n272|\n273|// ErrRollbackPastFinalize reports a rollback refused after a clean\n274|// Commit: the operation is terminal and rollback is forbidden\n275|// (AC-CLONE-005 shapes this rule; the model enforces it).\n276|var ErrRollbackPastFinalize = errors.New(\"secconftest rollback forbidden after commit\")\n277|\n278|// Rollback removes staged bytes for operationID before finalization.\n279|// It refuses to run past finalization: once Commit returns cleanly the\n280|// operation is terminal, rollback is forbidden, and the committed\n281|// bytes must survive the refused call untouched. Deleting the finalize\n282|// gate must fail the test that commits and then rolls back.\n283|func (transactor *Transactor) Rollback(operationID string) error {\n284|\tif err := transactor.injector.MaybeFail(PointRollbackEnter); err != nil {\n285|\t\treturn err\n286|\t}\n287|\ttransactor.mutex.Lock()\n288|\t_, ok := transactor.receipts[operationID]\n289|\tfinalized := transactor.finalized[operationID]\n290|\ttransactor.mutex.Unlock()\n291|\tif !ok {\n292|\t\treturn fmt.Errorf(\"secconftest: rollback without prepare for operation %q\", operationID)\n293|\t}\n294|\tif finalized {\n295|\t\treturn fmt.Errorf(\"%w: operation %q\", ErrRollbackPastFinalize, operationID)\n296|\t}\n297|\t_ = os.Remove(filepath.Join(transactor.root, operationID+\".staged\"))\n298|\t_ = os.Remove(filepath.Join(transactor.root, operationID+\".committed\"))\n299|\treturn nil\n300|}\n301|\n302|// CommittedBytes reads back the committed bytes for operationID.\n303|func (transactor *Transactor) CommittedBytes(operationID string) ([]byte, error) {\n304|\treturn os.ReadFile(filepath.Join(transactor.root, operationID+\".committed\"))\n305|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4cf","stream":{"kind":"session","id":"01a077c8-d88a-7931-843c-3e9dddbe9444"},"sequence":194,"recorded_at":1780531400000383,"record_type":"event","durability":"durable","causation_id":"d502244e-0589-4672-9c20-02af4f4b0b68","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d502244e-0589-4672-9c20-02af4f4b0b68","run_stream":{"kind":"run","id":"d502244e-0589-4672-9c20-02af4f4b0b68"},"call_id":"call_01a077c943b7710097d22da411769182","text":"Read text file `internal/secconftest/skip.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"runtime\"\n8|\t\"sort\"\n9|\t\"strings\"\n10|\t\"sync\"\n11|\t\"testing\"\n12|)\n13|\n14|// Capability is one platform capability a test may need. Probe reports\n15|// whether it holds here and now; StrictGOOS lists the GOOS values\n16|// where absence is a failure rather than a skip. A skip asserts \"this\n17|// cannot run here\": the probe must really attempt the capability, and\n18|// an unexpected skip on a strict platform must fail rather than pass\n19|// quietly.\n20|type Capability struct {\n21|\t// ID is the stable slug naming the capability in reports.\n22|\tID string\n23|\t// Detail explains what the probe attempts.\n24|\tDetail string\n25|\t// Probe attempts the capability and reports availability.\n26|\tProbe func() (ok bool, reason string)\n27|\t// StrictGOOS names platforms where unavailability fails the test.\n28|\tStrictGOOS []string\n29|}\n30|\n31|// Verdict is the outcome of requiring one capability.\n32|type Verdict struct {\n33|\tID      string\n34|\tSkipped bool\n35|\tFailed  bool\n36|\tReason  string\n37|}\n38|\n39|// decision is the testable core of Require: pass, skip, or fail for a\n40|// probed capability. It carries no testing handle so the table test\n41|// can drive every arm, including the failing ones, without failing\n42|// the suite.\n43|type decision int\n44|\n45|const (\n46|\tdecisionPass decision = iota\n47|\tdecisionSkip\n48|\tdecisionFail\n49|)\n50|\n51|func decide(capability Capability, ok bool) decision {\n52|\tif capability.ID == \"\" || capability.Probe == nil {\n53|\t\treturn decisionFail\n54|\t}\n55|\tif ok {\n56|\t\treturn decisionPass\n57|\t}\n58|\tif strictOn(capability) {\n59|\t\treturn decisionFail\n60|\t}\n61|\treturn decisionSkip\n62|}\n63|\n64|// SymlinkCapability probes symlink creation and Lstat identification\n65|// in a fresh temporary directory. Symlink-escape commit tests require\n66|// it; Windows hosts without privilege report unavailable.\n67|func SymlinkCapability() Capability {\n68|\treturn Capability{\n69|\t\tID:     \"symlink\",\n70|\t\tDetail: \"create a symlink in a temp dir and identify it with Lstat\",\n71|\t\tProbe: func() (bool, string) {\n72|\t\t\tdir, err := os.MkdirTemp(\"\", \"secconftest-symlink\")\n73|\t\t\tif err != nil {\n74|\t\t\t\treturn false, fmt.Sprintf(\"temp dir: %v\", err)\n75|\t\t\t}\n76|\t\t\tdefer func() { _ = os.RemoveAll(dir) }()\n77|\t\t\ttarget := filepath.Join(dir, \"target\")\n78|\t\t\tlink := filepath.Join(dir, \"link\")\n79|\t\t\tif err := os.WriteFile(target, []byte(\"x\"), 0o600); err != nil {\n80|\t\t\t\treturn false, fmt.Sprintf(\"write target: %v\", err)\n81|\t\t\t}\n82|\t\t\tif err := os.Symlink(target, link); err != nil {\n83|\t\t\t\treturn false, fmt.Sprintf(\"symlink: %v\", err)\n84|\t\t\t}\n85|\t\t\tinfo, err := os.Lstat(link)\n86|\t\t\tif err != nil {\n87|\t\t\t\treturn false, fmt.Sprintf(\"lstat: %v\", err)\n88|\t\t\t}\n89|\t\t\tif info.Mode()&os.ModeSymlink == 0 {\n90|\t\t\t\treturn false, \"created link is not a symlink\"\n91|\t\t\t}\n92|\t\t\treturn true, \"symlink create+identify works\"\n93|\t\t},\n94|\t\tStrictGOOS: []string{\"linux\", \"darwin\"},\n95|\t}\n96|}\n97|\n98|// FifoCapability probes named-pipe creation: it builds a real FIFO\n99|// in a fresh temporary directory and identifies it with Lstat. It is\n100|// unavailable on Windows by construction, so Windows is not strict:\n101|// the special-file gate there is covered by other means, stated on\n102|// the callers. A probe that returned true without creating anything\n103|// would advertise an unbuilt capability; TestSkipFifoFixtureExchangesBytes\n104|// drives a second FIFO through the same helper so the probe cannot\n105|// pass while fixtures cannot build.\n106|func FifoCapability() Capability {\n107|\treturn Capability{\n108|\t\tID:     \"fifo\",\n109|\t\tDetail: \"create a named pipe in a temp dir and identify it with Lstat\",\n110|\t\tProbe: func() (bool, string) {\n111|\t\t\tdir, err := os.MkdirTemp(\"\", \"secconftest-fifo\")\n112|\t\t\tif err != nil {\n113|\t\t\t\treturn false, fmt.Sprintf(\"temp dir: %v\", err)\n114|\t\t\t}\n115|\t\t\tdefer func() { _ = os.RemoveAll(dir) }()\n116|\t\t\tpath, err := makeFifo(dir, \"probe\")\n117|\t\t\tif err != nil {\n118|\t\t\t\treturn false, fmt.Sprintf(\"mkfifo: %v\", err)\n119|\t\t\t}\n120|\t\t\tinfo, err := os.Lstat(path)\n121|\t\t\tif err != nil {\n122|\t\t\t\treturn false, fmt.Sprintf(\"lstat: %v\", err)\n123|\t\t\t}\n124|\t\t\tif info.Mode()&os.ModeNamedPipe == 0 {\n125|\t\t\t\treturn false, \"created file is not a named pipe\"\n126|\t\t\t}\n127|\t\t\treturn true, \"named-pipe create+identify works\"\n128|\t\t},\n129|\t\tStrictGOOS: []string{\"linux\", \"darwin\"},\n130|\t}\n131|}\n132|\n133|// ModeBitsCapability probes whether permission bits are enforceable:\n134|// it removes all permissions from a temp file and checks the open\n135|// fails. Root bypasses mode bits and Windows ACLs do not express\n136|// them, so neither is strict.\n137|func ModeBitsCapability() Capability {\n138|\treturn Capability{\n139|\t\tID:     \"mode-bits\",\n140|\t\tDetail: \"chmod 000 a temp file and require the open to fail\",\n141|\t\tProbe: func() (bool, string) {\n142|\t\t\tif runtime.GOOS == \"windows\" {\n143|\t\t\t\treturn false, \"Windows ACLs do not express mode bits\"\n144|\t\t\t}\n145|\t\t\tdir, err := os.MkdirTemp(\"\", \"secconftest-modebits\")\n146|\t\t\tif err != nil {\n147|\t\t\t\treturn false, fmt.Sprintf(\"temp dir: %v\", err)\n148|\t\t\t}\n149|\t\t\tdefer func() { _ = os.RemoveAll(dir) }()\n150|\t\t\tpath := filepath.Join(dir, \"guarded\")\n151|\t\t\tif err := os.WriteFile(path, []byte(\"x\"), 0o600); err != nil {\n152|\t\t\t\treturn false, fmt.Sprintf(\"write: %v\", err)\n153|\t\t\t}\n154|\t\t\tif err := os.Chmod(path, 0); err != nil {\n155|\t\t\t\treturn false, fmt.Sprintf(\"chmod: %v\", err)\n156|\t\t\t}\n157|\t\t\tfile, err := os.Open(path)\n158|\t\t\tif err != nil {\n159|\t\t\t\treturn true, \"mode bits enforced\"\n160|\t\t\t}\n161|\t\t\t_ = file.Close()\n162|\t\t\treturn false, \"open succeeded despite mode 000 (root or unenforceable bits)\"\n163|\t\t},\n164|\t}\n165|}\n166|\n167|// NonRootCapability probes that the suite does not run as superuser.\n168|// Permission-refusal vectors that need denial require it.\n169|func NonRootCapability() Capability {\n170|\treturn Capability{\n171|\t\tID:     \"nonroot\",\n172|\t\tDetail: \"require a non-privileged uid on unix\",\n173|\t\tProbe: func() (bool, string) {\n174|\t\t\tif runtime.GOOS == \"windows\" {\n175|\t\t\t\treturn true, \"Windows: no unix superuser\"\n176|\t\t\t}\n177|\t\t\tif os.Geteuid() == 0 {\n178|\t\t\t\treturn false, \"running as root: permission denials are untestable\"\n179|\t\t\t}\n180|\t\t\treturn true, \"non-root user\"\n181|\t\t},\n182|\t}\n183|}\n184|\n185|// DefaultCapabilities lists every capability this instrument probes.\n186|func DefaultCapabilities() []Capability {\n187|\treturn []Capability{SymlinkCapability(), FifoCapability(), ModeBitsCapability(), NonRootCapability()}\n188|}\n189|\n190|// strictOn reports whether id is strict on this host's GOOS.\n191|func strictOn(capability Capability) bool {\n192|\tfor _, goos := range capability.StrictGOOS {\n193|\t\tif goos == runtime.GOOS {\n194|\t\t\treturn true\n195|\t\t}\n196|\t}\n197|\treturn false\n198|}\n199|\n200|// report aggregates verdicts with a process-wide skip counter the\n201|// suite logs once, so the skip count on the host is evidence rather\n202|// than prose.\n203|var report struct {\n204|\tmutex   sync.Mutex\n205|\tskipped []string\n206|\tfailed  []string\n207|}\n208|\n209|func recordVerdict(verdict Verdict) {\n210|\treport.mutex.Lock()\n211|\tdefer report.mutex.Unlock()\n212|\tif verdict.Skipped {\n213|\t\treport.skipped = append(report.skipped, verdict.ID)\n214|\t}\n215|\tif verdict.Failed {\n216|\t\treport.failed = append(report.failed, verdict.ID)\n217|\t}\n218|}\n219|\n220|// SkippedIDs reports capability IDs skipped so far, sorted.\n221|func SkippedIDs() []string {\n222|\treport.mutex.Lock()\n223|\tdefer report.mutex.Unlock()\n224|\tout := append([]string(nil), report.skipped...)\n225|\tsort.Strings(out)\n226|\treturn out\n227|}\n228|\n229|// Require enforces one capability: it returns a passing verdict when\n230|// the probe holds, skips the test when the probe fails on a\n231|// non-strict platform, and fails the test when the probe fails on a\n232|// strict platform or the probe result contradicts a strict\n233|// expectation the caller states. Every skip and failure is recorded\n234|// for the final count.\n235|func Require(t *testing.T, capability Capability) Verdict {\n236|\tt.Helper()\n237|\tif capability.ID == \"\" || capability.Probe == nil {\n238|\t\tverdict := Verdict{ID: capability.ID, Failed: true, Reason: \"capability without identity or probe is unusable\"}\n239|\t\trecordVerdict(verdict)\n240|\t\tt.Fatalf(\"secconftest: capability %q has no identity or probe\", capability.ID)\n241|\t\treturn verdict\n242|\t}\n243|\tok, reason := capability.Probe()\n244|\tswitch decide(capability, ok) {\n245|\tcase decisionPass:\n246|\t\treturn Verdict{ID: capability.ID, Reason: reason}\n247|\tcase decisionFail:\n248|\t\tverdict := Verdict{ID: capability.ID, Failed: true, Reason: reason}\n249|\t\trecordVerdict(verdict)\n250|\t\tt.Fatalf(\"secconftest: capability %q unavailable on strict platform %s: %s\", capability.ID, runtime.GOOS, reason)\n251|\t\treturn verdict\n252|\tdefault:\n253|\t\tverdict := Verdict{ID: capability.ID, Skipped: true, Reason: reason}\n254|\t\trecordVerdict(verdict)\n255|\t\tt.Skipf(\"secconftest: capability %q unavailable here: %s\", capability.ID, reason)\n256|\t\treturn verdict\n257|\t}\n258|}\n259|\n260|// Report formats the capability skip/fail counts recorded so far on\n261|// this host. It reads the live counters: an empty suite records\n262|// nothing and reports zeros, and every recorded skip or failure moves\n263|// the numbers. Citing a Report line as host evidence is only honest\n264|// for verdicts the suite really recorded; the per-test skip datum is\n265|// the `--- SKIP` lines under `go test -v`, which reproduce without\n266|// any counter.\n267|func Report() string {\n268|\treport.mutex.Lock()\n269|\tskipped := append([]string(nil), report.skipped...)\n270|\tfailed := append([]string(nil), report.failed...)\n271|\treport.mutex.Unlock()\n272|\tsort.Strings(skipped)\n273|\tsort.Strings(failed)\n274|\treturn fmt.Sprintf(\"secconftest capabilities on %s: skipped=%d %q failed=%d %q\",\n275|\t\truntime.GOOS, len(skipped), strings.Join(skipped, \",\"), len(failed), strings.Join(failed, \",\"))\n276|}\n277|\n278|// snapshotReport copies the process-wide counters so a test can\n279|// record synthetic verdicts and restore the suite state afterwards.\n280|func snapshotReport() (skipped, failed []string) {\n281|\treport.mutex.Lock()\n282|\tdefer report.mutex.Unlock()\n283|\treturn append([]string(nil), report.skipped...), append([]string(nil), report.failed...)\n284|}\n285|\n286|// restoreReport replaces the process-wide counters, undoing synthetic\n287|// verdicts a test recorded. It exists only for test isolation.\n288|func restoreReport(skipped, failed []string) {\n289|\treport.mutex.Lock()\n290|\tdefer report.mutex.Unlock()\n291|\treport.skipped = append([]string(nil), skipped...)\n292|\treport.failed = append([]string(nil), failed...)\n293|}\n294|\n295|// LogReport logs the capability skip/fail counts on this host. Call\n296|// it after the suite recorded its verdicts so the line carries real\n297|// counters. It never skips or fails: it reports.\n298|func LogReport(t *testing.T) {\n299|\tt.Helper()\n300|\tt.Log(Report())\n301|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4d1","stream":{"kind":"session","id":"01a077c8-d88a-7931-843c-3e9dddbe9444"},"sequence":195,"recorded_at":1780531400000385,"record_type":"event","durability":"durable","causation_id":"d502244e-0589-4672-9c20-02af4f4b0b68","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d502244e-0589-4672-9c20-02af4f4b0b68","run_stream":{"kind":"run","id":"d502244e-0589-4672-9c20-02af4f4b0b68"},"call_id":"call_01a077c9442d7281bfd57930b44b8797","text":"Read text file `internal/secconftest/crash_test.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"strings\"\n8|\t\"testing\"\n9|)\n10|\n11|func TestCrashClassifyTable(t *testing.T) {\n12|\tt.Parallel()\n13|\tcases := []struct {\n14|\t\tpoint string\n15|\t\twant  Outcome\n16|\t}{\n17|\t\t{PointPrepareEnter, OutcomeSafeRetry},\n18|\t\t{PointPrepareCommit, OutcomeExplicitRollback},\n19|\t\t{PointCommitEnter, OutcomeExplicitRollback},\n20|\t\t{PointCommitApply, OutcomeRecoverableParked},\n21|\t\t{PointRollbackEnter, OutcomeExplicitRollback},\n22|\t}\n23|\tfor _, kase := range cases {\n24|\t\tif got, err := Classify(kase.point); err != nil || got != kase.want {\n25|\t\t\tt.Errorf(\"Classify(%q) = %v, %v; want %v\", kase.point, got, err, kase.want)\n26|\t\t}\n27|\t}\n28|\tif _, err := Classify(\"CR-NOPE-unknown\"); err == nil {\n29|\t\tt.Error(\"Classify of an unknown point succeeded; a typo would arm nothing and fire nothing\")\n30|\t}\n31|}\n32|\n33|func TestCrashPointFiresOnceWhenArmed(t *testing.T) {\n34|\tt.Parallel()\n35|\tinjector := &Injector{}\n36|\tif err := injector.MaybeFail(PointPrepareEnter); err != nil {\n37|\t\tt.Fatalf(\"disarmed MaybeFail = %v, want nil\", err)\n38|\t}\n39|\tinjector.Arm(PointPrepareEnter)\n40|\tif !injector.Armed(PointPrepareEnter) {\n41|\t\tt.Fatal(\"Armed reports false after Arm\")\n42|\t}\n43|\terr := injector.MaybeFail(PointPrepareEnter)\n44|\tfault, ok := err.(*Fault)\n45|\tif !ok {\n46|\t\tt.Fatalf(\"armed MaybeFail = %v, want *Fault\", err)\n47|\t}\n48|\tif !errors.Is(err, ErrInjected) {\n49|\t\tt.Fatalf(\"fault %v does not wrap ErrInjected\", err)\n50|\t}\n51|\tif fault.Point() != PointPrepareEnter || fault.Outcome() != OutcomeSafeRetry {\n52|\t\tt.Fatalf(\"fault = %q/%q, want %q/safe_retry\", fault.Point(), fault.Outcome(), PointPrepareEnter)\n53|\t}\n54|\tif err := injector.MaybeFail(PointPrepareEnter); err != nil {\n55|\t\tt.Fatalf(\"consumed arm fired again: %v\", err)\n56|\t}\n57|\tinjector.Arm(PointPrepareEnter)\n58|\tinjector.Disarm()\n59|\tif err := injector.MaybeFail(PointPrepareEnter); err != nil {\n60|\t\tt.Fatalf(\"disarmed point fired: %v\", err)\n61|\t}\n62|\tif err := injector.MaybeFail(\"CR-NOPE-unknown\"); err == nil {\n63|\t\tt.Error(\"unknown point name is silent; a misspelled arm would never fire\")\n64|\t}\n65|}\n66|\n67|func TestTransactorPrepareCommitRoundTrip(t *testing.T) {\n68|\tt.Parallel()\n69|\troot := t.TempDir()\n70|\ttransactor := NewTransactor(&Injector{}, root)\n71|\tbody := []byte(`{\"kind\":\"workspace\",\"id\":\"op-1\"}`)\n72|\tprepared, err := transactor.Prepare(\"op-1\", body)\n73|\tif err != nil {\n74|\t\tt.Fatalf(\"Prepare: %v\", err)\n75|\t}\n76|\tif prepared.Outcome != OutcomeSafeRetry {\n77|\t\tt.Fatalf(\"prepare outcome = %q, want safe_retry\", prepared.Outcome)\n78|\t}\n79|\tcommitted, err := transactor.Commit(\"op-1\")\n80|\tif err != nil {\n81|\t\tt.Fatalf(\"Commit: %v\", err)\n82|\t}\n83|\treadBack, err := transactor.CommittedBytes(\"op-1\")\n84|\tif err != nil {\n85|\t\tt.Fatalf(\"CommittedBytes: %v\", err)\n86|\t}\n87|\tif string(readBack) != string(body) {\n88|\t\tt.Fatalf(\"committed bytes = %q, want %q\", readBack, body)\n89|\t}\n90|\tif committed.BodyDigest != prepared.BodyDigest {\n91|\t\tt.Fatal(\"commit changed the operation digest\")\n92|\t}\n93|}\n94|\n95|func TestTransactorIdempotentRetry(t *testing.T) {\n96|\tt.Parallel()\n97|\troot := t.TempDir()\n98|\ttransactor := NewTransactor(&Injector{}, root)\n99|\tbody := []byte(`{\"kind\":\"provider\",\"id\":\"op-2\"}`)\n100|\tfirst, err := transactor.Prepare(\"op-2\", body)\n101|\tif err != nil {\n102|\t\tt.Fatalf(\"Prepare: %v\", err)\n103|\t}\n104|\tsecond, err := transactor.Prepare(\"op-2\", append([]byte(nil), body...))\n105|\tif err != nil {\n106|\t\tt.Fatalf(\"identical retry Prepare: %v\", err)\n107|\t}\n108|\tif first.OperationID != second.OperationID || first.BodyDigest != second.BodyDigest ||\n109|\t\tfirst.Outcome != second.Outcome || string(first.Bytes) != string(second.Bytes) {\n110|\t\tt.Fatalf(\"identical retry receipt differs: %+v vs %+v\", first, second)\n111|\t}\n112|\tif _, err := transactor.Prepare(\"op-2\", []byte(`{\"kind\":\"provider\",\"id\":\"op-2-changed\"}`)); !errors.Is(err, ErrIdempotencyMismatch) {\n113|\t\tt.Fatalf(\"changed-body retry = %v, want idempotency_mismatch\", err)\n114|\t}\n115|\tentries, err := os.ReadDir(root)\n116|\tif err != nil {\n117|\t\tt.Fatalf(\"ReadDir: %v\", err)\n118|\t}\n119|\tif len(entries) != 1 {\n120|\t\tt.Fatalf(\"changed retry left %d files, want exactly the one staged journal\", len(entries))\n121|\t}\n122|}\n123|\n124|func TestTransactorCrashOutcomes(t *testing.T) {\n125|\tt.Parallel()\n126|\tpoints := []struct {\n127|\t\tpoint        string\n128|\t\toperation    func(*Transactor) error\n129|\t\twantOutcome  Outcome\n130|\t\tstagedExists bool\n131|\t}{\n132|\t\t{PointPrepareEnter, func(tx *Transactor) error { _, err := tx.Prepare(\"a\", []byte(\"body-a\")); return err }, OutcomeSafeRetry, false},\n133|\t\t{PointPrepareCommit, func(tx *Transactor) error { _, err := tx.Prepare(\"b\", []byte(\"body-b\")); return err }, OutcomeExplicitRollback, false},\n134|\t\t{PointCommitEnter, func(tx *Transactor) error {\n135|\t\t\tif _, err := tx.Prepare(\"c\", []byte(\"body-c\")); err != nil {\n136|\t\t\t\treturn err\n137|\t\t\t}\n138|\t\t\t_, err := tx.Commit(\"c\")\n139|\t\t\treturn err\n140|\t\t}, OutcomeExplicitRollback, true},\n141|\t\t{PointCommitApply, func(tx *Transactor) error {\n142|\t\t\tif _, err := tx.Prepare(\"d\", []byte(\"body-d\")); err != nil {\n143|\t\t\t\treturn err\n144|\t\t\t}\n145|\t\t\t_, err := tx.Commit(\"d\")\n146|\t\t\treturn err\n147|\t\t}, OutcomeRecoverableParked, false},\n148|\t}\n149|\tfor _, kase := range points {\n150|\t\tt.Run(kase.point, func(t *testing.T) {\n151|\t\t\tt.Parallel()\n152|\t\t\troot := t.TempDir()\n153|\t\t\tinjector := &Injector{}\n154|\t\t\ttransactor := NewTransactor(injector, root)\n155|\t\t\tinjector.Arm(kase.point)\n156|\t\t\terr := kase.operation(transactor)\n157|\t\t\tif got := injector.RemainingArmed(); len(got) != 0 {\n158|\t\t\t\tt.Fatalf(\"armed point %q was never reached; remaining %q\", kase.point, got)\n159|\t\t\t}\n160|\t\t\tfault, ok := err.(*Fault)\n161|\t\t\tif !ok {\n162|\t\t\t\tt.Fatalf(\"armed %q gave %v, want *Fault\", kase.point, err)\n163|\t\t\t}\n164|\t\t\tif fault.Outcome() != kase.wantOutcome {\n165|\t\t\t\tt.Fatalf(\"outcome = %q, want %q\", fault.Outcome(), kase.wantOutcome)\n166|\t\t\t}\n167|\t\t\tid := map[string]string{\n168|\t\t\t\tPointPrepareEnter: \"a\", PointPrepareCommit: \"b\",\n169|\t\t\t\tPointCommitEnter: \"c\", PointCommitApply: \"d\",\n170|\t\t\t}[kase.point]\n171|\t\t\t_, stagedErr := os.Stat(filepath.Join(root, id+\".staged\"))\n172|\t\t\tif kase.stagedExists && stagedErr != nil {\n173|\t\t\t\tt.Fatalf(\"commit-enter fault removed the staged bytes; rollback would have nothing to restore\")\n174|\t\t\t}\n175|\t\t\tif !kase.stagedExists && stagedErr == nil {\n176|\t\t\t\tt.Fatalf(\"fault at %q left staged bytes behind\", kase.point)\n177|\t\t\t}\n178|\t\t\tif kase.point == PointCommitApply {\n179|\t\t\t\treadBack, readErr := transactor.CommittedBytes(id)\n180|\t\t\t\tif readErr != nil || string(readBack) != \"body-d\" {\n181|\t\t\t\t\tt.Fatalf(\"parked commit lost the durable bytes: %q, %v\", readBack, readErr)\n182|\t\t\t\t}\n183|\t\t\t}\n184|\t\t})\n185|\t}\n186|}\n187|\n188|func TestTransactorRecoversAfterFault(t *testing.T) {\n189|\tt.Parallel()\n190|\troot := t.TempDir()\n191|\tinjector := &Injector{}\n192|\ttransactor := NewTransactor(injector, root)\n193|\tinjector.Arm(PointPrepareCommit)\n194|\tif _, err := transactor.Prepare(\"r\", []byte(\"body-r\")); err == nil {\n195|\t\tt.Fatal(\"armed prepare-commit passed; the fault never fired\")\n196|\t}\n197|\t// The fault consumed its arm and cleaned the staging file, so the\n198|\t// identical retry must proceed and commit byte-exact bytes.\n199|\treceipt, err := transactor.Prepare(\"r\", []byte(\"body-r\"))\n200|\tif err != nil {\n201|\t\tt.Fatalf(\"retry after fault: %v\", err)\n202|\t}\n203|\tif _, err := transactor.Commit(\"r\"); err != nil {\n204|\t\tt.Fatalf(\"commit after recovery: %v\", err)\n205|\t}\n206|\treadBack, err := transactor.CommittedBytes(\"r\")\n207|\tif err != nil || string(readBack) != \"body-r\" {\n208|\t\tt.Fatalf(\"recovered bytes = %q, %v; want the exact staged body\", readBack, err)\n209|\t}\n210|\t_ = receipt\n211|}\n212|\n213|func TestTransactorRefusesRollbackPastFinalize(t *testing.T) {\n214|\tt.Parallel()\n215|\troot := t.TempDir()\n216|\ttransactor := NewTransactor(&Injector{}, root)\n217|\tif err := transactor.Rollback(\"ghost\"); err == nil {\n218|\t\tt.Fatal(\"rollback without prepare succeeded\")\n219|\t}\n220|\tif _, err := transactor.Prepare(\"f\", []byte(\"body-f\")); err != nil {\n221|\t\tt.Fatalf(\"Prepare: %v\", err)\n222|\t}\n223|\tif err := transactor.Rollback(\"f\"); err != nil {\n224|\t\tt.Fatalf(\"pre-commit rollback: %v\", err)\n225|\t}\n226|\tif _, err := os.Stat(filepath.Join(root, \"f.staged\")); !os.IsNotExist(err) {\n227|\t\tt.Fatal(\"rollback left staged bytes behind\")\n228|\t}\n229|\t// The arm this test is named for: a clean Commit finalizes the\n230|\t// operation (AC-CLONE-005), so rollback past it must fail and the\n231|\t// committed bytes must survive the refused call untouched.\n232|\tbody := []byte(\"body-final\")\n233|\tif _, err := transactor.Prepare(\"g\", body); err != nil {\n234|\t\tt.Fatalf(\"Prepare: %v\", err)\n235|\t}\n236|\tif _, err := transactor.Commit(\"g\"); err != nil {\n237|\t\tt.Fatalf(\"Commit: %v\", err)\n238|\t}\n239|\tif err := transactor.Rollback(\"g\"); !errors.Is(err, ErrRollbackPastFinalize) {\n240|\t\tt.Fatalf(\"post-commit rollback = %v, want %v\", err, ErrRollbackPastFinalize)\n241|\t}\n242|\treadBack, err := transactor.CommittedBytes(\"g\")\n243|\tif err != nil || string(readBack) != string(body) {\n244|\t\tt.Fatalf(\"refused rollback deleted the committed bytes: %q, %v\", readBack, err)\n245|\t}\n246|}\n247|\n248|func TestTransactorCommitRequiresPrepare(t *testing.T) {\n249|\tt.Parallel()\n250|\troot := t.TempDir()\n251|\ttransactor := NewTransactor(&Injector{}, root)\n252|\t// No receipt and no staged file: the refusal must name the\n253|\t// missing prepare, not merely inherit a filesystem error.\n254|\tif _, err := transactor.Commit(\"ghost\"); err == nil || !strings.Contains(err.Error(), \"without prepare\") {\n255|\t\tt.Fatalf(\"commit without prepare = %v, want the without-prepare refusal\", err)\n256|\t}\n257|\t// A planted staged file with no receipt: the filesystem would\n258|\t// admit this commit, so only the prepare check refuses it.\n259|\tif err := os.WriteFile(filepath.Join(root, \"planted.staged\"), []byte(\"x\"), 0o600); err != nil {\n260|\t\tt.Fatalf(\"plant staged file: %v\", err)\n261|\t}\n262|\tif _, err := transactor.Commit(\"planted\"); err == nil || !strings.Contains(err.Error(), \"without prepare\") {\n263|\t\tt.Fatalf(\"commit with staged bytes but no prepare = %v, want the without-prepare refusal\", err)\n264|\t}\n265|\tif _, err := os.Stat(filepath.Join(root, \"planted.committed\")); !os.IsNotExist(err) {\n266|\t\tt.Fatal(\"refused commit left committed bytes behind\")\n267|\t}\n268|}\n269|\n270|func TestInjectorArmedPointIsConsumedByTheDrive(t *testing.T) {\n271|\tt.Parallel()\n272|\tinjector := &Injector{}\n273|\tinjector.Arm(PointPrepareEnter)\n274|\tinjector.Arm(PointCommitApply)\n275|\tif got := injector.RemainingArmed(); len(got) != 2 {\n276|\t\tt.Fatalf(\"RemainingArmed = %q, want the two armed points\", got)\n277|\t}\n278|\tif err := injector.MaybeFail(PointPrepareEnter); err == nil {\n279|\t\tt.Fatal(\"armed point did not fire\")\n280|\t}\n281|\tif got := injector.RemainingArmed(); len(got) != 1 || got[0] != PointCommitApply {\n282|\t\tt.Fatalf(\"RemainingArmed = %q, want exactly [%q]\", got, PointCommitApply)\n283|\t}\n284|\tinjector.Disarm()\n285|\tif got := injector.RemainingArmed(); len(got) != 0 {\n286|\t\tt.Fatalf(\"RemainingArmed after Disarm = %q, want empty\", got)\n287|\t}\n288|}\n289|\n290|func TestCrashPointVocabularyIsPinned(t *testing.T) {\n291|\tt.Parallel()\n292|\t// The five point names are instrument-local phase boundaries, not\n293|\t// the SPEC registry: CR-MAT-01..08 names nothing here, and a\n294|\t// registry-style name must be refused as unknown rather than armed\n295|\t// silently. Adding a sixth point without extending this list must\n296|\t// fail the Classify arm below only if it is wired; the residual\n297|\t// bound (a new site without an arm) is stated in doc.go.\n298|\twant := map[string]Outcome{\n299|\t\tPointPrepareEnter:  OutcomeSafeRetry,\n300|\t\tPointPrepareCommit: OutcomeExplicitRollback,\n301|\t\tPointCommitEnter:   OutcomeExplicitRollback,\n302|\t\tPointCommitApply:   OutcomeRecoverableParked,\n303|\t\tPointRollbackEnter: OutcomeExplicitRollback,\n304|\t}\n305|\tif len(want) != 5 {\n306|\t\tt.Fatalf(\"vocabulary has %d points, want exactly 5\", len(want))\n307|\t}\n308|\tfor point, outcome := range want {\n309|\t\tif got, err := Classify(point); err != nil || got != outcome {\n310|\t\t\tt.Errorf(\"Classify(%q) = %v, %v; want %v\", point, got, err, outcome)\n311|\t\t}\n312|\t}\n313|\tfor _, registry := range []string{\"CR-MAT-01\", \"CR-MAT-08\", \"CR-MAT-09\", \"CR-MAT-prepare\"} {\n314|\t\tif _, err := Classify(registry); err == nil {\n315|\t\t\tt.Errorf(\"Classify(%q) succeeded; the SPEC registry is not this vocabulary\", registry)\n316|\t\t}\n317|\t}\n318|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4d3","stream":{"kind":"session","id":"01a077c8-d88a-7931-843c-3e9dddbe9444"},"sequence":196,"recorded_at":1780531400000387,"record_type":"event","durability":"durable","causation_id":"d502244e-0589-4672-9c20-02af4f4b0b68","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d502244e-0589-4672-9c20-02af4f4b0b68","run_stream":{"kind":"run","id":"d502244e-0589-4672-9c20-02af4f4b0b68"},"call_id":"call_01a077c944e27173ae49cb538e2d0717","text":"Read text file `internal/secconftest/skip_test.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"os\"\n5|\t\"path/filepath\"\n6|\t\"runtime\"\n7|\t\"strings\"\n8|\t\"testing\"\n9|\t\"time\"\n10|)\n11|\n12|func TestSkipDecideTable(t *testing.T) {\n13|\tt.Parallel()\n14|\tstrict := Capability{ID: \"strict-cap\", Probe: func() (bool, string) { return false, \"down\" }, StrictGOOS: []string{runtime.GOOS}}\n15|\tlax := Capability{ID: \"lax-cap\", Probe: func() (bool, string) { return false, \"down\" }, StrictGOOS: []string{\"plan9\"}}\n16|\tother := Capability{ID: \"other-cap\", Probe: func() (bool, string) { return false, \"down\" }}\n17|\tif got := decide(strict, true); got != decisionPass {\n18|\t\tt.Errorf(\"available strict capability decides %v, want pass\", got)\n19|\t}\n20|\tif got := decide(lax, true); got != decisionPass {\n21|\t\tt.Errorf(\"available lax capability decides %v, want pass\", got)\n22|\t}\n23|\tif got := decide(strict, false); got != decisionFail {\n24|\t\tt.Errorf(\"unavailable strict capability decides %v, want fail: an unexpected skip must not pass quietly\", got)\n25|\t}\n26|\tif got := decide(lax, false); got != decisionSkip {\n27|\t\tt.Errorf(\"unavailable lax capability decides %v, want skip\", got)\n28|\t}\n29|\tif got := decide(other, false); got != decisionSkip {\n30|\t\tt.Errorf(\"unavailable unlisted capability decides %v, want skip\", got)\n31|\t}\n32|\tif got := decide(Capability{}, false); got != decisionFail {\n33|\t\tt.Errorf(\"malformed capability decides %v, want fail\", got)\n34|\t}\n35|\tif got := decide(Capability{ID: \"no-probe\"}, false); got != decisionFail {\n36|\t\tt.Errorf(\"probeless capability decides %v, want fail\", got)\n37|\t}\n38|}\n39|\n40|func TestSkipDefaultProbesTerminate(t *testing.T) {\n41|\tt.Parallel()\n42|\tcapabilities := DefaultCapabilities()\n43|\tif len(capabilities) != 4 {\n44|\t\tt.Fatalf(\"DefaultCapabilities has %d entries, want 4\", len(capabilities))\n45|\t}\n46|\tseen := map[string]bool{}\n47|\tfor _, capability := range capabilities {\n48|\t\tif capability.ID == \"\" || capability.Probe == nil || capability.Detail == \"\" {\n49|\t\t\tt.Errorf(\"capability %+v is malformed\", capability)\n50|\t\t}\n51|\t\tif seen[capability.ID] {\n52|\t\t\tt.Errorf(\"duplicate capability %q\", capability.ID)\n53|\t\t}\n54|\t\tseen[capability.ID] = true\n55|\t\tok, reason := capability.Probe()\n56|\t\tif reason == \"\" {\n57|\t\t\tt.Errorf(\"capability %q probed without a reason\", capability.ID)\n58|\t\t}\n59|\t\tt.Logf(\"capability %q on %s: ok=%v (%s)\", capability.ID, runtime.GOOS, ok, reason)\n60|\t}\n61|}\n62|\n63|func TestSkipProbesAreDeterministic(t *testing.T) {\n64|\tt.Parallel()\n65|\tfor _, capability := range DefaultCapabilities() {\n66|\t\tfirst, _ := capability.Probe()\n67|\t\tsecond, _ := capability.Probe()\n68|\t\tif first != second {\n69|\t\t\tt.Errorf(\"capability %q probe flips: %v then %v\", capability.ID, first, second)\n70|\t\t}\n71|\t}\n72|}\n73|\n74|func TestSkipFifoFixtureExchangesBytes(t *testing.T) {\n75|\tt.Parallel()\n76|\t// The fifo probe gates this test: where the platform cannot\n77|\t// provide named pipes the test skips (Windows is not strict)\n78|\t// instead of passing over an unbuilt fixture.\n79|\tRequire(t, FifoCapability())\n80|\tdir := t.TempDir()\n81|\tpath, err := makeFifo(dir, \"exchange\")\n82|\tif err != nil {\n83|\t\tt.Fatalf(\"makeFifo: %v\", err)\n84|\t}\n85|\tinfo, err := os.Lstat(path)\n86|\tif err != nil {\n87|\t\tt.Fatalf(\"Lstat: %v\", err)\n88|\t}\n89|\tif info.Mode()&os.ModeNamedPipe == 0 {\n90|\t\tt.Fatalf(\"fixture %q is not a named pipe\", path)\n91|\t}\n92|\t// Negative control: a regular file beside the fifo must not\n93|\t// identify as one, so the suite can tell the kinds apart.\n94|\tcontrol := filepath.Join(dir, \"regular\")\n95|\tif err := os.WriteFile(control, []byte(\"x\"), 0o600); err != nil {\n96|\t\tt.Fatalf(\"write control: %v\", err)\n97|\t}\n98|\tcontrolInfo, err := os.Lstat(control)\n99|\tif err != nil {\n100|\t\tt.Fatalf(\"Lstat control: %v\", err)\n101|\t}\n102|\tif controlInfo.Mode()&os.ModeNamedPipe != 0 {\n103|\t\tt.Fatal(\"regular file identifies as a named pipe\")\n104|\t}\n105|\t// Byte exchange. A bare FIFO open blocks until the peer end\n106|\t// opens, so both ends open in goroutines and rendezvous in the\n107|\t// kernel; the main goroutine joins both with a timeout so a\n108|\t// broken fifo fails the test instead of hanging it. The byte\n109|\t// then moves synchronously with both ends held.\n110|\ttype openResult struct {\n111|\t\tfile *os.File\n112|\t\terr  error\n113|\t}\n114|\treaderCh := make(chan openResult, 1)\n115|\twriterCh := make(chan openResult, 1)\n116|\tgo func() {\n117|\t\treader, err := os.OpenFile(path, os.O_RDONLY, 0)\n118|\t\treaderCh <- openResult{reader, err}\n119|\t}()\n120|\tgo func() {\n121|\t\twriter, err := os.OpenFile(path, os.O_WRONLY, 0)\n122|\t\twriterCh <- openResult{writer, err}\n123|\t}()\n124|\ttimer := time.NewTimer(30 * time.Second)\n125|\tdefer timer.Stop()\n126|\tvar reader, writer *os.File\n127|\tfor range 2 {\n128|\t\tselect {\n129|\t\tcase result := <-readerCh:\n130|\t\t\tif result.err != nil {\n131|\t\t\t\tt.Fatalf(\"fifo read-end open: %v\", result.err)\n132|\t\t\t}\n133|\t\t\treader = result.file\n134|\t\tcase result := <-writerCh:\n135|\t\t\tif result.err != nil {\n136|\t\t\t\tt.Fatalf(\"fifo write-end open: %v\", result.err)\n137|\t\t\t}\n138|\t\t\twriter = result.file\n139|\t\tcase <-timer.C:\n140|\t\t\tt.Fatal(\"fifo open handshake blocked; the fixture does not exchange\")\n141|\t\t}\n142|\t}\n143|\tdefer func() { _ = reader.Close() }()\n144|\tdefer func() { _ = writer.Close() }()\n145|\tif _, err := writer.Write([]byte(\"p\")); err != nil {\n146|\t\tt.Fatalf(\"fifo write: %v\", err)\n147|\t}\n148|\tbuf := make([]byte, 1)\n149|\tn, err := reader.Read(buf)\n150|\tif err != nil || n != 1 || buf[0] != 'p' {\n151|\t\tt.Fatalf(\"fifo exchange read %d bytes %q, %v; want one byte %q\", n, buf, err, \"p\")\n152|\t}\n153|}\n154|\n155|func TestSkipFifoProbeAttemptsItsCapability(t *testing.T) {\n156|\t// Not parallel: it faults the fifo build seam. With the build\n157|\t// broken, the probe must report unavailable; a probe closure\n158|\t// hardened to constant true ignores the fault and fails here.\n159|\t// On a strict host (linux, darwin) the unbroken probe must hold:\n160|\t// absence there is unexpected and must fail, not skip.\n161|\treal := fifoBuild\n162|\tt.Cleanup(func() { fifoBuild = real })\n163|\tcapability := FifoCapability()\n164|\tif runtime.GOOS == \"windows\" {\n165|\t\tif ok, _ := capability.Probe(); ok {\n166|\t\t\tt.Fatal(\"fifo probe holds on Windows, where named-pipe fixtures are unavailable\")\n167|\t\t}\n168|\t\treturn\n169|\t}\n170|\tstrict := false\n171|\tfor _, goos := range capability.StrictGOOS {\n172|\t\tif goos == runtime.GOOS {\n173|\t\t\tstrict = true\n174|\t\t}\n175|\t}\n176|\tif !strict {\n177|\t\tt.Fatalf(\"fifo probe is not strict on %s; unexpected absence would skip quietly\", runtime.GOOS)\n178|\t}\n179|\tif ok, reason := capability.Probe(); !ok {\n180|\t\tt.Fatalf(\"fifo probe fails on strict host %s: %s\", runtime.GOOS, reason)\n181|\t}\n182|\tfifoBuild = func(dir, name string) (string, error) { return \"\", errTestSentinel }\n183|\tif ok, _ := capability.Probe(); ok {\n184|\t\tt.Fatal(\"fifo probe holds with its build broken; the probe attempts nothing\")\n185|\t}\n186|}\n187|\n188|func TestSkipModeBitsAndNonRootDenialsHold(t *testing.T) {\n189|\tt.Parallel()\n190|\t// Both probes gate this test. As superuser the first Require\n191|\t// skips (permission denials are untestable past the uid check);\n192|\t// where mode bits are unenforceable the second Require skips;\n193|\t// where both hold, the denial must be a permission error, not\n194|\t// merely any failure.\n195|\tRequire(t, NonRootCapability())\n196|\tRequire(t, ModeBitsCapability())\n197|\tdir := t.TempDir()\n198|\tpath := filepath.Join(dir, \"guarded\")\n199|\tif err := os.WriteFile(path, []byte(\"x\"), 0o600); err != nil {\n200|\t\tt.Fatalf(\"write: %v\", err)\n201|\t}\n202|\tif err := os.Chmod(path, 0); err != nil {\n203|\t\tt.Fatalf(\"chmod: %v\", err)\n204|\t}\n205|\tt.Cleanup(func() { _ = os.Chmod(path, 0o600) })\n206|\tfile, err := os.Open(path)\n207|\tif err == nil {\n208|\t\t_ = file.Close()\n209|\t\tt.Fatal(\"open succeeded despite mode 000; permission bits are not enforced here\")\n210|\t}\n211|\tif !os.IsPermission(err) {\n212|\t\tt.Fatalf(\"denial error %v is not a permission error\", err)\n213|\t}\n214|}\n215|\n216|func TestSkipReportReadsRecordedVerdicts(t *testing.T) {\n217|\t// Not parallel: it mutates the process-wide counters. It records\n218|\t// its own synthetic verdicts, asserts the report moves, then\n219|\t// restores the suite state — so the numbers below are evidence\n220|\t// that Report reads the live counters, not a constant. Gutting\n221|\t// recordVerdict leaves both assertions red.\n222|\tconst skipID = \"self-test-skip-probe\"\n223|\tconst failID = \"self-test-fail-probe\"\n224|\tbeforeSkipped, beforeFailed := snapshotReport()\n225|\tt.Cleanup(func() {\n226|\t\trestoreReport(beforeSkipped, beforeFailed)\n227|\t\tfor _, id := range SkippedIDs() {\n228|\t\t\tif id == skipID || id == failID {\n229|\t\t\t\tt.Errorf(\"synthetic verdict %q leaked into the suite counters\", id)\n230|\t\t\t}\n231|\t\t}\n232|\t})\n233|\trecordVerdict(Verdict{ID: skipID, Skipped: true, Reason: \"synthetic skip\"})\n234|\trecordVerdict(Verdict{ID: failID, Failed: true, Reason: \"synthetic failure\"})\n235|\tfound := false\n236|\tfor _, id := range SkippedIDs() {\n237|\t\tif id == skipID {\n238|\t\t\tfound = true\n239|\t\t}\n240|\t}\n241|\tif !found {\n242|\t\tt.Fatalf(\"SkippedIDs() = %q, want it to contain %q\", SkippedIDs(), skipID)\n243|\t}\n244|\treport := Report()\n245|\tif !strings.Contains(report, skipID) || !strings.Contains(report, failID) {\n246|\t\tt.Fatalf(\"Report() = %q, want it to carry both synthetic verdicts\", report)\n247|\t}\n248|\t// Attached evidence with real nonzero counters from this test's\n249|\t// own recorded verdicts.\n250|\tLogReport(t)\n251|\tt.Logf(\"skipped IDs: %q\", SkippedIDs())\n252|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
