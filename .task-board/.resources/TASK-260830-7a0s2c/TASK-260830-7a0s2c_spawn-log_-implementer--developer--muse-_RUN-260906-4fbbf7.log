{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4bd","stream":{"kind":"session","id":"01a077c8-d88a-7931-843c-3e9dddbe9444"},"sequence":185,"recorded_at":1780531400000365,"record_type":"event","durability":"durable","causation_id":"d502244e-0589-4672-9c20-02af4f4b0b68","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d502244e-0589-4672-9c20-02af4f4b0b68","run_stream":{"kind":"run","id":"d502244e-0589-4672-9c20-02af4f4b0b68"},"task_stream":{"kind":"task","id":"a353ad03-098b-4a8c-ba93-ebc3ae443b19"},"task_id":"a353ad03-098b-4a8c-ba93-ebc3ae443b19","event":{"kind":"output","task_id":"a353ad03-098b-4a8c-ba93-ebc3ae443b19","chunk":"Read text file `internal/secconftest/crash_test.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"strings\"\n8|\t\"testing\"\n9|)\n10|\n11|func TestCrashClassifyTable(t *testing.T) {\n12|\tt.Parallel()\n13|\tcases := []struct {\n14|\t\tpoint string\n15|\t\twant  Outcome\n16|\t}{\n17|\t\t{PointPrepareEnter, OutcomeSafeRetry},\n18|\t\t{PointPrepareCommit, OutcomeExplicitRollback},\n19|\t\t{PointCommitEnter, OutcomeExplicitRollback},\n20|\t\t{PointCommitApply, OutcomeRecoverableParked},\n21|\t\t{PointRollbackEnter, OutcomeExplicitRollback},\n22|\t}\n23|\tfor _, kase := range cases {\n24|\t\tif got, err := Classify(kase.point); err != nil || got != kase.want {\n25|\t\t\tt.Errorf(\"Classify(%q) = %v, %v; want %v\", kase.point, got, err, kase.want)\n26|\t\t}\n27|\t}\n28|\tif _, err := Classify(\"CR-NOPE-unknown\"); err == nil {\n29|\t\tt.Error(\"Classify of an unknown point succeeded; a typo would arm nothing and fire nothing\")\n30|\t}\n31|}\n32|\n33|func TestCrashPointFiresOnceWhenArmed(t *testing.T) {\n34|\tt.Parallel()\n35|\tinjector := &Injector{}\n36|\tif err := injector.MaybeFail(PointPrepareEnter); err != nil {\n37|\t\tt.Fatalf(\"disarmed MaybeFail = %v, want nil\", err)\n38|\t}\n39|\tinjector.Arm(PointPrepareEnter)\n40|\tif !injector.Armed(PointPrepareEnter) {\n41|\t\tt.Fatal(\"Armed reports false after Arm\")\n42|\t}\n43|\terr := injector.MaybeFail(PointPrepareEnter)\n44|\tfault, ok := err.(*Fault)\n45|\tif !ok {\n46|\t\tt.Fatalf(\"armed MaybeFail = %v, want *Fault\", err)\n47|\t}\n48|\tif !errors.Is(err, ErrInjected) {\n49|\t\tt.Fatalf(\"fault %v does not wrap ErrInjected\", err)\n50|\t}\n51|\tif fault.Point() != PointPrepareEnter || fault.Outcome() != OutcomeSafeRetry {\n52|\t\tt.Fatalf(\"fault = %q/%q, want %q/safe_retry\", fault.Point(), fault.Outcome(), PointPrepareEnter)\n53|\t}\n54|\tif err := injector.MaybeFail(PointPrepareEnter); err != nil {\n55|\t\tt.Fatalf(\"consumed arm fired again: %v\", err)\n56|\t}\n57|\tinjector.Arm(PointPrepareEnter)\n58|\tinjector.Disarm()\n59|\tif err := injector.MaybeFail(PointPrepareEnter); err != nil {\n60|\t\tt.Fatalf(\"disarmed point fired: %v\", err)\n61|\t}\n62|\tif err := injector.MaybeFail(\"CR-NOPE-unknown\"); err == nil {\n63|\t\tt.Error(\"unknown point name is silent; a misspelled arm would never fire\")\n64|\t}\n65|}\n66|\n67|func TestTransactorPrepareCommitRoundTrip(t *testing.T) {\n68|\tt.Parallel()\n69|\troot := t.TempDir()\n70|\ttransactor := NewTransactor(&Injector{}, root)\n71|\tbody := []byte(`{\"kind\":\"workspace\",\"id\":\"op-1\"}`)\n72|\tprepared, err := transactor.Prepare(\"op-1\", body)\n73|\tif err != nil {\n74|\t\tt.Fatalf(\"Prepare: %v\", err)\n75|\t}\n76|\tif prepared.Outcome != OutcomeSafeRetry {\n77|\t\tt.Fatalf(\"prepare outcome = %q, want safe_retry\", prepared.Outcome)\n78|\t}\n79|\tcommitted, err := transactor.Commit(\"op-1\")\n80|\tif err != nil {\n81|\t\tt.Fatalf(\"Commit: %v\", err)\n82|\t}\n83|\treadBack, err := transactor.CommittedBytes(\"op-1\")\n84|\tif err != nil {\n85|\t\tt.Fatalf(\"CommittedBytes: %v\", err)\n86|\t}\n87|\tif string(readBack) != string(body) {\n88|\t\tt.Fatalf(\"committed bytes = %q, want %q\", readBack, body)\n89|\t}\n90|\tif committed.BodyDigest != prepared.BodyDigest {\n91|\t\tt.Fatal(\"commit changed the operation digest\")\n92|\t}\n93|}\n94|\n95|func TestTransactorIdempotentRetry(t *testing.T) {\n96|\tt.Parallel()\n97|\troot := t.TempDir()\n98|\ttransactor := NewTransactor(&Injector{}, root)\n99|\tbody := []byte(`{\"kind\":\"provider\",\"id\":\"op-2\"}`)\n100|\tfirst, err := transactor.Prepare(\"op-2\", body)\n101|\tif err != nil {\n102|\t\tt.Fatalf(\"Prepare: %v\", err)\n103|\t}\n104|\tsecond, err := transactor.Prepare(\"op-2\", append([]byte(nil), body...))\n105|\tif err != nil {\n106|\t\tt.Fatalf(\"identical retry Prepare: %v\", err)\n107|\t}\n108|\tif first.OperationID != second.OperationID || first.BodyDigest != second.BodyDigest ||\n109|\t\tfirst.Outcome != second.Outcome || string(first.Bytes) != string(second.Bytes) {\n110|\t\tt.Fatalf(\"identical retry receipt differs: %+v vs %+v\", first, second)\n111|\t}\n112|\tif _, err := transactor.Prepare(\"op-2\", []byte(`{\"kind\":\"provider\",\"id\":\"op-2-changed\"}`)); !errors.Is(err, ErrIdempotencyMismatch) {\n113|\t\tt.Fatalf(\"changed-body retry = %v, want idempotency_mismatch\", err)\n114|\t}\n115|\tentries, err := os.ReadDir(root)\n116|\tif err != nil {\n117|\t\tt.Fatalf(\"ReadDir: %v\", err)\n118|\t}\n119|\tif len(entries) != 1 {\n120|\t\tt.Fatalf(\"changed retry left %d files, want exactly the one staged journal\", len(entries))\n121|\t}\n122|}\n123|\n124|func TestTransactorCrashOutcomes(t *testing.T) {\n125|\tt.Parallel()\n126|\tpoints := []struct {\n127|\t\tpoint        string\n128|\t\toperation    func(*Transactor) error\n129|\t\twantOutcome  Outcome\n130|\t\tstagedExists bool\n131|\t}{\n132|\t\t{PointPrepareEnter, func(tx *Transactor) error { _, err := tx.Prepare(\"a\", []byte(\"body-a\")); return err }, OutcomeSafeRetry, false},\n133|\t\t{PointPrepareCommit, func(tx *Transactor) error { _, err := tx.Prepare(\"b\", []byte(\"body-b\")); return err }, OutcomeExplicitRollback, false},\n134|\t\t{PointCommitEnter, func(tx *Transactor) error {\n135|\t\t\tif _, err := tx.Prepare(\"c\", []byte(\"body-c\")); err != nil {\n136|\t\t\t\treturn err\n137|\t\t\t}\n138|\t\t\t_, err := tx.Commit(\"c\")\n139|\t\t\treturn err\n140|\t\t}, OutcomeExplicitRollback, true},\n141|\t\t{PointCommitApply, func(tx *Transactor) error {\n142|\t\t\tif _, err := tx.Prepare(\"d\", []byte(\"body-d\")); err != nil {\n143|\t\t\t\treturn err\n144|\t\t\t}\n145|\t\t\t_, err := tx.Commit(\"d\")\n146|\t\t\treturn err\n147|\t\t}, OutcomeRecoverableParked, false},\n148|\t}\n149|\tfor _, kase := range points {\n150|\t\tt.Run(kase.point, func(t *testing.T) {\n151|\t\t\tt.Parallel()\n152|\t\t\troot := t.TempDir()\n153|\t\t\tinjector := &Injector{}\n154|\t\t\ttransactor := NewTransactor(injector, root)\n155|\t\t\tinjector.Arm(kase.point)\n156|\t\t\terr := kase.operation(transactor)\n157|\t\t\tif got := injector.RemainingArmed(); len(got) != 0 {\n158|\t\t\t\tt.Fatalf(\"armed point %q was never reached; remaining %q\", kase.point, got)\n159|\t\t\t}\n160|\t\t\tfault, ok := err.(*Fault)\n161|\t\t\tif !ok {\n162|\t\t\t\tt.Fatalf(\"armed %q gave %v, want *Fault\", kase.point, err)\n163|\t\t\t}\n164|\t\t\tif fault.Outcome() != kase.wantOutcome {\n165|\t\t\t\tt.Fatalf(\"outcome = %q, want %q\", fault.Outcome(), kase.wantOutcome)\n166|\t\t\t}\n167|\t\t\tid := map[string]string{\n168|\t\t\t\tPointPrepareEnter: \"a\", PointPrepareCommit: \"b\",\n169|\t\t\t\tPointCommitEnter: \"c\", PointCommitApply: \"d\",\n170|\t\t\t}[kase.point]\n171|\t\t\t_, stagedErr := os.Stat(filepath.Join(root, id+\".staged\"))\n172|\t\t\tif kase.stagedExists && stagedErr != nil {\n173|\t\t\t\tt.Fatalf(\"commit-enter fault removed the staged bytes; rollback would have nothing to restore\")\n174|\t\t\t}\n175|\t\t\tif !kase.stagedExists && stagedErr == nil {\n176|\t\t\t\tt.Fatalf(\"fault at %q left staged bytes behind\", kase.point)\n177|\t\t\t}\n178|\t\t\tif kase.point == PointCommitApply {\n179|\t\t\t\treadBack, readErr := transactor.CommittedBytes(id)\n180|\t\t\t\tif readErr != nil || string(readBack) != \"body-d\" {\n181|\t\t\t\t\tt.Fatalf(\"parked commit lost the durable bytes: %q, %v\", readBack, readErr)\n182|\t\t\t\t}\n183|\t\t\t}\n184|\t\t})\n185|\t}\n186|}\n187|\n188|func TestTransactorRecoversAfterFault(t *testing.T) {\n189|\tt.Parallel()\n190|\troot := t.TempDir()\n191|\tinjector := &Injector{}\n192|\ttransactor := NewTransactor(injector, root)\n193|\tinjector.Arm(PointPrepareCommit)\n194|\tif _, err := transactor.Prepare(\"r\", []byte(\"body-r\")); err == nil {\n195|\t\tt.Fatal(\"armed prepare-commit passed; the fault never fired\")\n196|\t}\n197|\t// The fault consumed its arm and cleaned the staging file, so the\n198|\t// identical retry must proceed and commit byte-exact bytes.\n199|\treceipt, err := transactor.Prepare(\"r\", []byte(\"body-r\"))\n200|\tif err != nil {\n201|\t\tt.Fatalf(\"retry after fault: %v\", err)\n202|\t}\n203|\tif _, err := transactor.Commit(\"r\"); err != nil {\n204|\t\tt.Fatalf(\"commit after recovery: %v\", err)\n205|\t}\n206|\treadBack, err := transactor.CommittedBytes(\"r\")\n207|\tif err != nil || string(readBack) != \"body-r\" {\n208|\t\tt.Fatalf(\"recovered bytes = %q, %v; want the exact staged body\", readBack, err)\n209|\t}\n210|\t_ = receipt\n211|}\n212|\n213|func TestTransactorRefusesRollbackPastFinalize(t *testing.T) {\n214|\tt.Parallel()\n215|\troot := t.TempDir()\n216|\ttransactor := NewTransactor(&Injector{}, root)\n217|\tif err := transactor.Rollback(\"ghost\"); err == nil {\n218|\t\tt.Fatal(\"rollback without prepare succeeded\")\n219|\t}\n220|\tif _, err := transactor.Prepare(\"f\", []byte(\"body-f\")); err != nil {\n221|\t\tt.Fatalf(\"Prepare: %v\", err)\n222|\t}\n223|\tif err := transactor.Rollback(\"f\"); err != nil {\n224|\t\tt.Fatalf(\"pre-commit rollback: %v\", err)\n225|\t}\n226|\tif _, err := os.Stat(filepath.Join(root, \"f.staged\")); !os.IsNotExist(err) {\n227|\t\tt.Fatal(\"rollback left staged bytes behind\")\n228|\t}\n229|\t// The arm this test is named for: a clean Commit finalizes the\n230|\t// operation (AC-CLONE-005), so rollback past it must fail and the\n231|\t// committed bytes must survive the refused call untouched.\n232|\tbody := []byte(\"body-final\")\n233|\tif _, err := transactor.Prepare(\"g\", body); err != nil {\n234|\t\tt.Fatalf(\"Prepare: %v\", err)\n235|\t}\n236|\tif _, err := transactor.Commit(\"g\"); err != nil {\n237|\t\tt.Fatalf(\"Commit: %v\", err)\n238|\t}\n239|\tif err := transactor.Rollback(\"g\"); !errors.Is(err, ErrRollbackPastFinalize) {\n240|\t\tt.Fatalf(\"post-commit rollback = %v, want %v\", err, ErrRollbackPastFinalize)\n241|\t}\n242|\treadBack, err := transactor.CommittedBytes(\"g\")\n243|\tif err != nil || string(readBack) != string(body) {\n244|\t\tt.Fatalf(\"refused rollback deleted the committed bytes: %q, %v\", readBack, err)\n245|\t}\n246|}\n247|\n248|func TestTransactorCommitRequiresPrepare(t *testing.T) {\n249|\tt.Parallel()\n250|\troot := t.TempDir()\n251|\ttransactor := NewTransactor(&Injector{}, root)\n252|\t// No receipt and no staged file: the refusal must name the\n253|\t// missing prepare, not merely inherit a filesystem error.\n254|\tif _, err := transactor.Commit(\"ghost\"); err == nil || !strings.Contains(err.Error(), \"without prepare\") {\n255|\t\tt.Fatalf(\"commit without prepare = %v, want the without-prepare refusal\", err)\n256|\t}\n257|\t// A planted staged file with no receipt: the filesystem would\n258|\t// admit this commit, so only the prepare check refuses it.\n259|\tif err := os.WriteFile(filepath.Join(root, \"planted.staged\"), []byte(\"x\"), 0o600); err != nil {\n260|\t\tt.Fatalf(\"plant staged file: %v\", err)\n261|\t}\n262|\tif _, err := transactor.Commit(\"planted\"); err == nil || !strings.Contains(err.Error(), \"without prepare\") {\n263|\t\tt.Fatalf(\"commit with staged bytes but no prepare = %v, want the without-prepare refusal\", err)\n264|\t}\n265|\tif _, err := os.Stat(filepath.Join(root, \"planted.committed\")); !os.IsNotExist(err) {\n266|\t\tt.Fatal(\"refused commit left committed bytes behind\")\n267|\t}\n268|}\n269|\n270|func TestInjectorArmedPointIsConsumedByTheDrive(t *testing.T) {\n271|\tt.Parallel()\n272|\tinjector := &Injector{}\n273|\tinjector.Arm(PointPrepareEnter)\n274|\tinjector.Arm(PointCommitApply)\n275|\tif got := injector.RemainingArmed(); len(got) != 2 {\n276|\t\tt.Fatalf(\"RemainingArmed = %q, want the two armed points\", got)\n277|\t}\n278|\tif err := injector.MaybeFail(PointPrepareEnter); err == nil {\n279|\t\tt.Fatal(\"armed point did not fire\")\n280|\t}\n281|\tif got := injector.RemainingArmed(); len(got) != 1 || got[0] != PointCommitApply {\n282|\t\tt.Fatalf(\"RemainingArmed = %q, want exactly [%q]\", got, PointCommitApply)\n283|\t}\n284|\tinjector.Disarm()\n285|\tif got := injector.RemainingArmed(); len(got) != 0 {\n286|\t\tt.Fatalf(\"RemainingArmed after Disarm = %q, want empty\", got)\n287|\t}\n288|}\n289|\n290|func TestCrashPointVocabularyIsPinned(t *testing.T) {\n291|\tt.Parallel()\n292|\t// The five point names are instrument-local phase boundaries, not\n293|\t// the SPEC registry: CR-MAT-01..08 names nothing here, and a\n294|\t// registry-style name must be refused as unknown rather than armed\n295|\t// silently. Adding a sixth point without extending this list must\n296|\t// fail the Classify arm below only if it is wired; the residual\n297|\t// bound (a new site without an arm) is stated in doc.go.\n298|\twant := map[string]Outcome{\n299|\t\tPointPrepareEnter:  OutcomeSafeRetry,\n300|\t\tPointPrepareCommit: OutcomeExplicitRollback,\n301|\t\tPointCommitEnter:   OutcomeExplicitRollback,\n302|\t\tPointCommitApply:   OutcomeRecoverableParked,\n303|\t\tPointRollbackEnter: OutcomeExplicitRollback,\n304|\t}\n305|\tif len(want) != 5 {\n306|\t\tt.Fatalf(\"vocabulary has %d points, want exactly 5\", len(want))\n307|\t}\n308|\tfor point, outcome := range want {\n309|\t\tif got, err := Classify(point); err != nil || got != outcome {\n310|\t\t\tt.Errorf(\"Classify(%q) = %v, %v; want %v\", point, got, err, outcome)\n311|\t\t}\n312|\t}\n313|\tfor _, registry := range []string{\"CR-MAT-01\", \"CR-MAT-08\", \"CR-MAT-09\", \"CR-MAT-prepare\"} {\n314|\t\tif _, err := Classify(registry); err == nil {\n315|\t\t\tt.Errorf(\"Classify(%q) succeeded; the SPEC registry is not this vocabulary\", registry)\n316|\t\t}\n317|\t}\n318|}"}}}
