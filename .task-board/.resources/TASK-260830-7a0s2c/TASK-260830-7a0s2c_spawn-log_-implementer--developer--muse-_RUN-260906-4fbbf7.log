{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c58d","stream":{"kind":"session","id":"01a077c8-d88a-7931-843c-3e9dddbe9444"},"sequence":289,"recorded_at":1780531400000573,"record_type":"event","durability":"durable","causation_id":"d502244e-0589-4672-9c20-02af4f4b0b68","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d502244e-0589-4672-9c20-02af4f4b0b68","run_stream":{"kind":"run","id":"d502244e-0589-4672-9c20-02af4f4b0b68"},"task_stream":{"kind":"task","id":"06591ec2-a318-4374-b04f-cda41b2f258d"},"task_id":"06591ec2-a318-4374-b04f-cda41b2f258d","event":{"kind":"output","task_id":"06591ec2-a318-4374-b04f-cda41b2f258d","chunk":"Read text file `internal/secconftest/hostile_test.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"io\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n14|)\n15|\n16|func TestHostileRosterQuotesResolve(t *testing.T) {\n17|\tt.Parallel()\n18|\tdocument, err := specdoc.Load()\n19|\tif err != nil {\n20|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n21|\t}\n22|\tfor _, class := range Roster() {\n23|\t\tif err := QuoteInSection(document, class.Quote, class.Section); err != nil {\n24|\t\t\tt.Errorf(\"class %q: %v\", class.ID, err)\n25|\t\t}\n26|\t}\n27|}\n28|\n29|func TestHostileRosterShape(t *testing.T) {\n30|\tt.Parallel()\n31|\troster := Roster()\n32|\tif len(roster) != 18 {\n33|\t\tt.Fatalf(\"roster has %d classes, want 18; a spec class added or lost must update this instrument deliberately\", len(roster))\n34|\t}\n35|\tseen := map[string]bool{}\n36|\tvar memberless []string\n37|\tfor _, class := range roster {\n38|\t\tif class.ID == \"\" || class.Section == \"\" || class.Quote == \"\" || class.Gate == \"\" {\n39|\t\t\tt.Errorf(\"class %+v has an empty field\", class)\n40|\t\t}\n41|\t\tif seen[class.ID] {\n42|\t\t\tt.Errorf(\"duplicate class ID %q\", class.ID)\n43|\t\t}\n44|\t\tseen[class.ID] = true\n45|\t\tswitch class.Section {\n46|\t\tcase \"16.2\", \"16.3\", \"16.4\", \"16.7\":\n47|\t\tdefault:\n48|\t\t\tt.Errorf(\"class %q section %q is outside the story scope\", class.ID, class.Section)\n49|\t\t}\n50|\t\tif Members(class.ID) == nil {\n51|\t\t\tmemberless = append(memberless, class.ID)\n52|\t\t}\n53|\t}\n54|\t// Exactly one class is an FS-behavior witness rather than a string\n55|\t// corpus: symlink escape at commit time needs a real symlink, which\n56|\t// Members cannot build. Its witness is\n57|\t// TestHostileSymlinkEscapeRefusedAtCommit, skip-gated on the\n58|\t// symlink capability.\n59|\tif strings.Join(memberless, \",\") != \"path-symlink-escape\" {\n60|\t\tt.Fatalf(\"memberless classes = %v, want exactly [path-symlink-escape]\", memberless)\n61|\t}\n62|}\n63|\n64|func TestQuoteInSectionRefusals(t *testing.T) {\n65|\tt.Parallel()\n66|\tdocument, err := specdoc.Load()\n67|\tif err != nil {\n68|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n69|\t}\n70|\tif err := QuoteInSection(document, \"path traversal\", \"16.7\"); err == nil {\n71|\t\tt.Error(\"a Section 16.3 quote accepted for 16.7; the section check is dead\")\n72|\t}\n73|\tif err := QuoteInSection(document, \"phrase that occurs nowhere in the document\", \"16.3\"); err == nil {\n74|\t\tt.Error(\"unknown quote accepted\")\n75|\t}\n76|\tif err := QuoteInSection(document, \"   \", \"16.3\"); err == nil {\n77|\t\tt.Error(\"empty quote accepted\")\n78|\t}\n79|\tif err := QuoteInSection(nil, \"path traversal\", \"16.3\"); err == nil {\n80|\t\tt.Error(\"nil document accepted as satisfied; a failed read is never an absence\")\n81|\t}\n82|}\n83|\n84|func TestHostileMemberCounts(t *testing.T) {\n85|\tt.Parallel()\n86|\twant := map[string]int{\n87|\t\t\"path-traversal\": 6, \"path-absolute\": 3, \"path-drive-unc\": 5,\n88|\t\t\"path-altstream\": 3, \"path-encoded-separator\": 9,\n89|\t\t\"path-case-collision\": 5, \"path-unmanaged\": 3, \"path-device\": 8,\n90|\t\t\"argv-vector\": 7, \"env-allowlist\": 9,\n91|\t\t\"render-ansi-osc\": 4, \"render-controls\": 63, \"render-bidi\": 9,\n92|\t\t\"render-encoding\": 5, \"render-width\": 7,\n93|\t\t\"redact-persisted\": 4, \"redact-credentials\": 5,\n94|\t}\n95|\tfor id, count := range want {\n96|\t\tif got := len(Members(id)); got != count {\n97|\t\t\tt.Errorf(\"Members(%q) has %d inputs, want %d\", id, got, count)\n98|\t\t}\n99|\t}\n100|\tif got := Members(\"no-such-class\"); got != nil {\n101|\t\tt.Fatalf(\"Members of an unknown class = %v, want nil\", got)\n102|\t}\n103|}\n104|\n105|func TestBidiRunesArePinned(t *testing.T) {\n106|\tt.Parallel()\n107|\t// The bidi/zero-width vocabulary is enumerated from the Unicode\n108|\t// code chart, not from the gate under test. Both narrowings —\n109|\t// dropping U+FEFF and cutting the list to one rune — must fail\n110|\t// here, and every rune must have a corpus member carrying it, so\n111|\t// the vocabulary cannot shrink past the corpus silently.\n112|\twant := []rune{\n113|\t\t0x202a, 0x202b, 0x202c, 0x202d, 0x202e,\n114|\t\t0x2066, 0x2067, 0x2068, 0x2069,\n115|\t\t0x200e, 0x200f, 0x061c,\n116|\t\t0x200b, 0x200c, 0x200d,\n117|\t\t0xfeff,\n118|\t}\n119|\tgot := BidiRunes()\n120|\tif len(got) != len(want) {\n121|\t\tt.Fatalf(\"BidiRunes has %d runes, want %d\", len(got), len(want))\n122|\t}\n123|\tfor index, character := range want {\n124|\t\tif got[index] != character {\n125|\t\t\tt.Fatalf(\"BidiRunes[%d] = %U, want %U\", index, got[index], character)\n126|\t\t}\n127|\t}\n128|\tcovered := map[rune]bool{}\n129|\tfor _, member := range append(Members(\"render-bidi\"), Members(\"render-width\")...) {\n130|\t\tfor _, character := range member {\n131|\t\t\tcovered[character] = true\n132|\t\t}\n133|\t}\n134|\tfor _, character := range want {\n135|\t\tif !covered[character] {\n136|\t\t\tt.Errorf(\"rune %U has no corpus member; the vocabulary outruns the witness\", character)\n137|\t\t}\n138|\t}\n139|}\n140|\n141|// gateWire pins one roster class to its production gate and to the\n142|// decision that gate must return on the representative member.\n143|type gateWire struct {\n144|\twantGate    string\n145|\tplatform    scalar.Platform\n146|\tmember      string\n147|\twantDecided bool\n148|}\n149|\n150|// driveGate resolves a roster Gate string to the production entry it\n151|// names and requires the class-appropriate decision. An unknown Gate\n152|// is a fatal wiring error, never a pass.\n153|func driveGate(t *testing.T, gate, member string, platform scalar.Platform) bool {\n154|\tt.Helper()\n155|\tswitch gate {\n156|\tcase \"secprim.CheckMemberPath\":\n157|\t\treturn secprim.CheckMemberPath(platform, member) == nil\n158|\tcase \"secprim.Guard.Open\":\n159|\t\tstage := t.TempDir()\n160|\t\tguard, err := secprim.NewGuard(stage, platform, nil)\n161|\t\tif err != nil {\n162|\t\t\tt.Fatalf(\"NewGuard: %v\", err)\n163|\t\t}\n164|\t\troot, err := secprim.OpenNoFollowDir(stage)\n165|\t\tif err != nil {\n166|\t\t\tt.Fatalf(\"OpenNoFollowDir: %v\", err)\n167|\t\t}\n168|\t\tdefer func() { _ = root.Close() }()\n169|\t\tfile, err := guard.Open(root, member)\n170|\t\tif err != nil {\n171|\t\t\treturn false\n172|\t\t}\n173|\t\t_ = file.Close()\n174|\t\treturn true\n175|\tcase \"secprim.DetectCaseCollision\":\n176|\t\t_, collided := secprim.DetectCaseCollision([]string{\"README.md\", \"staging/member\"}, member)\n177|\t\treturn collided\n178|\tcase \"secprim.Guard.Resolve\":\n179|\t\tguard, err := secprim.NewGuard(\"/stage\", platform, []string{\"staging/member\"})\n180|\t\tif err != nil {\n181|\t\t\tt.Fatalf(\"NewGuard: %v\", err)\n182|\t\t}\n183|\t\t_, err = guard.Resolve(member)\n184|\t\treturn err == nil\n185|\tcase \"secprim.CheckArgv\":\n186|\t\treturn secprim.CheckArgv([]string{\"exe\", member}) == nil\n187|\tcase \"secprim.IsEnvName\":\n188|\t\treturn secprim.IsEnvName(member)\n189|\tcase \"secprim.EscapeForTerminal\":\n190|\t\tescaped := secprim.EscapeForTerminal(member)\n191|\t\tassertTerminalInert(t, escaped)\n192|\t\treturn escaped != member\n193|\tcase \"secprim.Redact\":\n194|\t\tredacted := secprim.Redact(member, nil)\n195|\t\treturn strings.Contains(redacted, \"[redacted]\")\n196|\tdefault:\n197|\t\tt.Fatalf(\"roster Gate %q resolves to no production entry\", gate)\n198|\t\treturn false\n199|\t}\n200|}\n201|\n202|func TestHostileGatesAreWired(t *testing.T) {\n203|\tt.Parallel()\n204|\t// Every roster Gate is pinned and driven: renaming a Gate to any\n205|\t// other entry fails the pin, and a Gate that stopped deciding its\n206|\t// class fails the drive. The symlink-escape drive opens an absent\n207|\t// member (refused); the commit-time escape proof itself is\n208|\t// TestHostileSymlinkEscapeRefusedAtCommit.\n209|\twires := map[string]gateWire{\n210|\t\t\"path-traversal\":         {wantGate: \"secprim.CheckMemberPath\", platform: scalar.PlatformLinux, member: \"../evil\", wantDecided: false},\n211|\t\t\"path-absolute\":          {wantGate: \"secprim.CheckMemberPath\", platform: scalar.PlatformLinux, member: \"/etc/passwd\", wantDecided: false},\n212|\t\t\"path-drive-unc\":         {wantGate: \"secprim.CheckMemberPath\", platform: scalar.PlatformLinux, member: \"C:/Windows\", wantDecided: false},\n213|\t\t\"path-altstream\":         {wantGate: \"secprim.CheckMemberPath\", platform: scalar.PlatformWindows, member: \"file:stream\", wantDecided: false},\n214|\t\t\"path-encoded-separator\": {wantGate: \"secprim.CheckMemberPath\", platform: scalar.PlatformLinux, member: \"a%2fb\", wantDecided: false},\n215|\t\t\"path-symlink-escape\":    {wantGate: \"secprim.Guard.Open\", platform: scalar.PlatformLinux, member: \"absent-member\", wantDecided: false},\n216|\t\t\"path-case-collision\":    {wantGate: \"secprim.DetectCaseCollision\", platform: scalar.PlatformLinux, member: \"README.MD\", wantDecided: true},\n217|\t\t\"path-unmanaged\":         {wantGate: \"secprim.Guard.Resolve\", platform: scalar.PlatformLinux, member: \"outside-managed\", wantDecided: false},\n218|\t\t\"path-device\":            {wantGate: \"secprim.CheckMemberPath\", platform: scalar.PlatformWindows, member: \"NUL\", wantDecided: false},\n219|\t\t\"argv-vector\":            {wantGate: \"secprim.CheckArgv\", platform: scalar.PlatformLinux, member: \"; rm -rf /\", wantDecided: true},\n220|\t\t\"env-allowlist\":          {wantGate: \"secprim.IsEnvName\", platform: scalar.PlatformLinux, member: \"\", wantDecided: false},\n221|\t\t\"render-ansi-osc\":        {wantGate: \"secprim.EscapeForTerminal\", platform: scalar.PlatformLinux, member: \"a\\x1b[31mb\", wantDecided: true},\n222|\t\t\"render-controls\":        {wantGate: \"secprim.EscapeForTerminal\", platform: scalar.PlatformLinux, member: \"a\\x00b\", wantDecided: true},\n223|\t\t\"render-bidi\":            {wantGate: \"secprim.EscapeForTerminal\", platform: scalar.PlatformLinux, member: \"a\\u202eb\", wantDecided: true},\n224|\t\t\"render-encoding\":        {wantGate: \"secprim.EscapeForTerminal\", platform: scalar.PlatformLinux, member: \"a\\xffb\", wantDecided: true},\n225|\t\t\"render-width\":           {wantGate: \"secprim.EscapeForTerminal\", platform: scalar.PlatformLinux, member: \"a\\ufeffb\", wantDecided: true},\n226|\t\t\"redact-persisted\":       {wantGate: \"secprim.Redact\", platform: scalar.PlatformLinux, member: \"password=hunter2\", wantDecided: true},\n227|\t\t\"redact-credentials\":     {wantGate: \"secprim.Redact\", platform: scalar.PlatformLinux, member: \"api_key=[REDACTED]\", wantDecided: true},\n228|\t}\n229|\tfor _, class := range Roster() {\n230|\t\twire, ok := wires[class.ID]\n231|\t\tif !ok {\n232|\t\t\tt.Errorf(\"class %q has no gate wiring; its Gate annotation is unchecked\", class.ID)\n233|\t\t\tcontinue\n234|\t\t}\n235|\t\tif class.Gate != wire.wantGate {\n236|\t\t\tt.Errorf(\"class %q Gate = %q, want %q\", class.ID, class.Gate, wire.wantGate)\n237|\t\t\tcontinue\n238|\t\t}\n239|\t\tif got := driveGate(t, class.Gate, wire.member, wire.platform); got != wire.wantDecided {\n240|\t\t\tt.Errorf(\"class %q through %s: decided=%v, want %v\", class.ID, class.Gate, got, wire.wantDecided)\n241|\t\t}\n242|\t}\n243|\tfor id := range wires {\n244|\t\tfound := false\n245|\t\tfor _, class := range Roster() {\n246|\t\t\tif class.ID == id {\n247|\t\t\t\tfound = true\n248|\t\t\t}\n249|\t\t}\n250|\t\tif !found {\n251|\t\t\tt.Errorf(\"wire row %q names no roster class; the expectation is orphaned\", id)\n252|\t\t}\n253|\t}\n254|}\n255|\n256|func TestHostilePathMembersRefused(t *testing.T) {\n257|\tt.Parallel()\n258|\tlinux := []string{\"path-traversal\", \"path-absolute\", \"path-drive-unc\", \"path-encoded-separator\"}\n259|\tfor _, id := range linux {\n260|\t\tfor _, member := range Members(id) {\n261|\t\t\tif err := secprim.CheckMemberPath(scalar.PlatformLinux, member); err == nil {\n262|\t\t\t\tt.Errorf(\"linux admits hostile %q (%s)\", member, id)\n263|\t\t\t}\n264|\t\t}\n265|\t}\n266|\twindows := []string{\"path-altstream\", \"path-device\"}\n267|\tfor _, id := range windows {\n268|\t\tfor _, member := range Members(id) {\n269|\t\t\tif err := secprim.CheckMemberPath(scalar.PlatformWindows, member); err == nil {\n270|\t\t\t\tt.Errorf(\"windows admits hostile %q (%s)\", member, id)\n271|\t\t\t}\n272|\t\t}\n273|\t}\n274|}\n275|\n276|func TestHostileCaseCollisionMembersFire(t *testing.T) {\n277|\tt.Parallel()\n278|\tsiblings := []string{\"README.md\", \"staging/member\"}\n279|\tfor _, candidate := range Members(\"path-case-collision\") {\n280|\t\tif _, collided := secprim.DetectCaseCollision(siblings, candidate); !collided {\n281|\t\t\tt.Errorf(\"candidate %q reports no collision against %v\", candidate, siblings)\n282|\t\t}\n283|\t}\n284|\tif _, collided := secprim.DetectCaseCollision(siblings, \"unrelated-name\"); collided {\n285|\t\tt.Error(\"unrelated name collides; the gate over-matches\")\n286|\t}\n287|}\n288|\n289|func TestHostileUnmanagedMembersRefused(t *testing.T) {\n290|\tt.Parallel()\n291|\tguard, err := secprim.NewGuard(\"/stage\", scalar.PlatformLinux, []string{\"staging/member\"})\n292|\tif err != nil {\n293|\t\tt.Fatalf(\"NewGuard: %v\", err)\n294|\t}\n295|\tfor _, member := range Members(\"path-unmanaged\") {\n296|\t\tif _, err := guard.Resolve(member); err == nil {\n297|\t\t\tt.Errorf(\"unmanaged member %q resolved\", member)\n298|\t\t} else if !errors.Is(err, secprim.ErrUnsafePath) {\n299|\t\t\tt.Errorf(\"unmanaged member %q error %v does not wrap ErrUnsafePath\", member, err)\n300|\t\t}\n301|\t}\n302|\tif _, err := guard.Resolve(\"staging/member\"); err != nil {\n303|\t\tt.Errorf(\"managed member refused: %v\", err)\n304|\t}\n305|}\n306|\n307|func TestHostileArgvMembersStaySingleElements(t *testing.T) {\n308|\tt.Parallel()\n309|\tfor _, hostile := range Members(\"argv-vector\") {\n310|\t\tcommand, err := secprim.NewCommand([]string{\"exe\", hostile})\n311|\t\tif err != nil {\n312|\t\t\tt.Errorf(\"shell metacharacter vector %q refused as data: %v\", hostile, err)\n313|\t\t\tcontinue\n314|\t\t}\n315|\t\targv := command.Argv()\n316|\t\tif len(argv) != 2 || argv[1] != hostile {\n317|\t\t\tt.Errorf(\"vector %q did not survive as one element: %q\", hostile, argv)\n318|\t\t}\n319|\t}\n320|\trefused := [][]string{{}, {\"\"}, {\"exe\", \"\"}, {\"exe\", \"a\\x00b\"}, {\"exe\", \"a\\xffb\"}}\n321|\tfor _, argv := range refused {\n322|\t\tif err := secprim.CheckArgv(argv); err == nil {\n323|\t\t\tt.Errorf(\"CheckArgv(%q) admitted\", argv)\n324|\t\t} else if !errors.Is(err, secprim.ErrUnsafeArgv) {\n325|\t\t\tt.Errorf(\"CheckArgv(%q) error %v does not wrap ErrUnsafeArgv\", argv, err)\n326|\t\t}\n327|\t}\n328|}\n329|\n330|func TestHostileEnvNamesRefused(t *testing.T) {\n331|\tt.Parallel()\n332|\tfor _, name := range Members(\"env-allowlist\") {\n333|\t\tif secprim.IsEnvName(name) {\n334|\t\t\tt.Errorf(\"IsEnvName(%q) admitted\", name)\n335|\t\t}\n336|\t}\n337|\tif !secprim.IsEnvName(\"AX_FOO\") {\n338|\t\tt.Error(\"IsEnvName refuses a well-formed name; the gate over-matches\")\n339|\t}\n340|\tif _, err := secprim.BuildEnv([]string{\"AX_OK\"}, map[string]string{\"AX_OK\": \"x\"}, os.LookupEnv); err == nil {\n341|\t\tt.Error(\"BuildEnv admits a literal colliding with the allowlist\")\n342|\t}\n343|\tif _, err := secprim.BuildEnv([]string{\"AX_OK\"}, map[string]string{\"AX_BAD\": \"a\\x00b\"}, os.LookupEnv); err == nil {\n344|\t\tt.Error(\"BuildEnv admits a NUL value\")\n345|\t}\n346|}\n347|\n348|func TestHostileRenderMembersNeutralized(t *testing.T) {\n349|\tt.Parallel()\n350|\tfor _, id := range []string{\"render-ansi-osc\", \"render-controls\", \"render-bidi\", \"render-encoding\", \"render-width\"} {\n351|\t\tfor _, member := range Members(id) {\n352|\t\t\tescaped := secprim.EscapeForTerminal(member)\n353|\t\t\t// The output invariant every class serves: valid UTF-8,\n354|\t\t\t// no ESC, no refused control, no bidi/zero-width rune.\n355|\t\t\tassertTerminalInert(t, escaped)\n356|\t\t\tswitch id {\n357|\t\t\tcase \"render-encoding\":\n358|\t\t\t\t// Invalid bytes cannot survive, and the neutralized\n359|\t\t\t\t// replacement proves they were rewritten, not kept.\n360|\t\t\t\tif escaped == member {\n361|\t\t\t\t\tt.Errorf(\"class %s: member %q passes through unchanged\", id, member)\n362|\t\t\t\t}\n363|\t\t\tdefault:\n364|\t\t\t\t// Neutralization is visible, never a silent strip:\n365|\t\t\t\t// ESC becomes U+241B, every other refused rune\n366|\t\t\t\t// becomes U+FFFD.\n367|\t\t\t\tif strings.ContainsRune(member, 0x1b) && !strings.Contains(escaped, \"␛\") {\n368|\t\t\t\t\tt.Errorf(\"class %s: member %q lost its escape visibly\", id, member)\n369|\t\t\t\t}\n370|\t\t\t\tif !strings.ContainsRune(member, 0x1b) && !strings.Contains(escaped, \"�\") {\n371|\t\t\t\t\tt.Errorf(\"class %s: member %q shows no neutralization marker\", id, member)\n372|\t\t\t\t}\n373|\t\t\t}\n374|\t\t}\n375|\t}\n376|}\n377|\n378|func TestHostileRedactMembersScrubbed(t *testing.T) {\n379|\tt.Parallel()\n380|\tfor _, member := range Members(\"redact-persisted\") {\n381|\t\tredacted := secprim.Redact(member, nil)\n382|\t\tif strings.Contains(redacted, \"PRIVATE KEY-----\\n\") || strings.Contains(redacted, \"s3cret\") {\n383|\t\t\tt.Errorf(\"member %q survives redaction: %q\", member, redacted)\n384|\t\t}\n385|\t}\n386|\tfor _, member := range Members(\"redact-credentials\") {\n387|\t\tredacted := secprim.Redact(member, nil)\n388|\t\tif !strings.Contains(redacted, \"[redacted]\") {\n389|\t\t\tt.Errorf(\"credential member %q carries no redaction marker: %q\", member, redacted)\n390|\t\t}\n391|\t}\n392|\t// Caller-known corpus values are scrubbed verbatim, including when\n393|\t// the key shape is innocuous.\n394|\tconst secret = \"correct-horse-battery\"\n395|\tredacted := secprim.Redact(\" InnocuousKey=\"+secret+\" \", []string{secret})\n396|\tif strings.Contains(redacted, secret) {\n397|\t\tt.Fatalf(\"corpus secret survives: %q\", redacted)\n398|\t}\n399|}\n400|\n401|func TestHostileSymlinkEscapeRefusedAtCommit(t *testing.T) {\n402|\tt.Parallel()\n403|\tRequire(t, SymlinkCapability())\n404|\tbase := t.TempDir()\n405|\tstage := filepath.Join(base, \"stage\")\n406|\toutside := filepath.Join(base, \"outside\")\n407|\tif err := os.MkdirAll(stage, 0o700); err != nil {\n408|\t\tt.Fatal(err)\n409|\t}\n410|\tif err := os.MkdirAll(outside, 0o700); err != nil {\n411|\t\tt.Fatal(err)\n412|\t}\n413|\tif err := os.WriteFile(filepath.Join(outside, \"victim\"), []byte(\"OUTSIDE\"), 0o600); err != nil {\n414|\t\tt.Fatal(err)\n415|\t}\n416|\tif err := os.WriteFile(filepath.Join(stage, \"inside\"), []byte(\"INSIDE\"), 0o600); err != nil {\n417|\t\tt.Fatal(err)\n418|\t}\n419|\tif err := os.Symlink(outside, filepath.Join(stage, \"link\")); err != nil {\n420|\t\tt.Fatal(err)\n421|\t}\n422|\tguard, err := secprim.NewGuard(stage, scalar.PlatformLinux, nil)\n423|\tif err != nil {\n424|\t\tt.Fatal(err)\n425|\t}\n426|\troot, err := secprim.OpenNoFollowDir(stage)\n427|\tif err != nil {\n428|\t\tt.Fatal(err)\n429|\t}\n430|\tdefer func() { _ = root.Close() }()\n431|\tfile, err := guard.Open(root, \"link/victim\")\n432|\tif err == nil {\n433|\t\tcontents, _ := io.ReadAll(file)\n434|\t\t_ = file.Close()\n435|\t\tt.Fatalf(\"symlink escape committed; read %q outside the root\", contents)\n436|\t}\n437|\tif !errors.Is(err, secprim.ErrUnsafePath) {\n438|\t\tt.Fatalf(\"symlink escape error %v does not wrap ErrUnsafePath\", err)\n439|\t}\n440|\tinside, err := guard.Open(root, \"inside\")\n441|\tif err != nil {\n442|\t\tt.Fatalf(\"positive control refused: %v\", err)\n443|\t}\n444|\tcontents, err := io.ReadAll(inside)\n445|\t_ = inside.Close()\n446|\tif err != nil || string(contents) != \"INSIDE\" {\n447|\t\tt.Fatalf(\"positive control read %q, %v; want the staged bytes\", contents, err)\n448|\t}\n449|}"}}}
