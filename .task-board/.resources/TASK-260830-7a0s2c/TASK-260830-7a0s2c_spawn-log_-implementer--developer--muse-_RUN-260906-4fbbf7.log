{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5d1","stream":{"kind":"session","id":"01a077c8-d88a-7931-843c-3e9dddbe9444"},"sequence":323,"recorded_at":1780531400000641,"record_type":"event","durability":"durable","causation_id":"d502244e-0589-4672-9c20-02af4f4b0b68","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d502244e-0589-4672-9c20-02af4f4b0b68","run_stream":{"kind":"run","id":"d502244e-0589-4672-9c20-02af4f4b0b68"},"task_stream":{"kind":"task","id":"85756356-9ae4-437f-8460-6b76fe989a4c"},"task_id":"85756356-9ae4-437f-8460-6b76fe989a4c","event":{"kind":"output","task_id":"85756356-9ae4-437f-8460-6b76fe989a4c","chunk":"Read text file `internal/secconftest/runner_test.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|)\n7|\n8|func TestRunnerExecutesInSortedOrder(t *testing.T) {\n9|\tt.Parallel()\n10|\tvar order []string\n11|\tfixtures := []Fixture{\n12|\t\t{Name: \"zeta\", Run: func(seed uint64, calls *Calls) (string, error) {\n13|\t\t\tcalls.Add(1)\n14|\t\t\torder = append(order, \"zeta\")\n15|\t\t\treturn \"z\", nil\n16|\t\t}},\n17|\t\t{Name: \"alpha\", Run: func(seed uint64, calls *Calls) (string, error) {\n18|\t\t\tcalls.Add(2)\n19|\t\t\torder = append(order, \"alpha\")\n20|\t\t\treturn \"a\", nil\n21|\t\t}},\n22|\t\t{Name: \"mid\", Run: func(seed uint64, calls *Calls) (string, error) {\n23|\t\t\tcalls.Add(3)\n24|\t\t\torder = append(order, \"mid\")\n25|\t\t\treturn \"m\", nil\n26|\t\t}},\n27|\t}\n28|\tvar runner Runner\n29|\tresults, err := runner.Run(fixtures, 7)\n30|\tif err != nil {\n31|\t\tt.Fatalf(\"Run: %v\", err)\n32|\t}\n33|\twant := []string{\"alpha\", \"mid\", \"zeta\"}\n34|\tgot := SortedNames(fixtures)\n35|\tif strings.Join(got, \",\") != strings.Join(want, \",\") {\n36|\t\tt.Fatalf(\"SortedNames = %v, want %v\", got, want)\n37|\t}\n38|\tif strings.Join(order, \",\") != strings.Join(want, \",\") {\n39|\t\tt.Fatalf(\"execution order = %v, want sorted %v\", order, want)\n40|\t}\n41|\tfor index, name := range want {\n42|\t\tif results[index].Name != name {\n43|\t\t\tt.Fatalf(\"results[%d].Name = %q, want %q\", index, results[index].Name, name)\n44|\t\t}\n45|\t}\n46|}\n47|\n48|func TestRunnerDigestIsDeterministic(t *testing.T) {\n49|\tt.Parallel()\n50|\tfixtures := []Fixture{\n51|\t\t{Name: \"b\", Run: func(seed uint64, calls *Calls) (string, error) {\n52|\t\t\tcalls.Add(1)\n53|\t\t\treturn \"report-b\", nil\n54|\t\t}},\n55|\t\t{Name: \"a\", Run: func(seed uint64, calls *Calls) (string, error) {\n56|\t\t\tcalls.Add(1)\n57|\t\t\treturn \"report-a\", nil\n58|\t\t}},\n59|\t}\n60|\tvar runner Runner\n61|\tfirst, err := runner.Run(fixtures, 99)\n62|\tif err != nil {\n63|\t\tt.Fatalf(\"Run: %v\", err)\n64|\t}\n65|\tsecond, err := runner.Run(fixtures, 99)\n66|\tif err != nil {\n67|\t\tt.Fatalf(\"Run: %v\", err)\n68|\t}\n69|\t// Registration order must not matter: reverse and rerun.\n70|\treversed := []Fixture{fixtures[1], fixtures[0]}\n71|\tthird, err := runner.Run(reversed, 99)\n72|\tif err != nil {\n73|\t\tt.Fatalf(\"Run: %v\", err)\n74|\t}\n75|\tif Digest(first) != Digest(second) || Digest(first) != Digest(third) {\n76|\t\tt.Fatalf(\"digest unstable: %q %q %q\", Digest(first), Digest(second), Digest(third))\n77|\t}\n78|\tt.Logf(\"deterministic digest: %s\", Digest(first))\n79|}\n80|\n81|func TestRunnerRefusesUnreachedFixture(t *testing.T) {\n82|\tt.Parallel()\n83|\tvar runner Runner\n84|\tfixtures := []Fixture{\n85|\t\t{Name: \"reached\", Run: func(seed uint64, calls *Calls) (string, error) {\n86|\t\t\tcalls.Add(1)\n87|\t\t\treturn \"ok\", nil\n88|\t\t}},\n89|\t\t{Name: \"unreached\", Run: func(seed uint64, calls *Calls) (string, error) {\n90|\t\t\treturn \"never touched production\", nil\n91|\t\t}},\n92|\t}\n93|\t_, err := runner.Run(fixtures, 1)\n94|\tif err == nil || !strings.Contains(err.Error(), `\"unreached\"`) {\n95|\t\tt.Fatalf(\"Run with an unreached fixture = %v, want an error naming it\", err)\n96|\t}\n97|}\n98|\n99|func TestRunnerAllowsUnreachedWhenOptedIn(t *testing.T) {\n100|\tt.Parallel()\n101|\trunner := Runner{AllowUnreached: true}\n102|\tfixtures := []Fixture{\n103|\t\t{Name: \"unreached\", Run: func(seed uint64, calls *Calls) (string, error) {\n104|\t\t\treturn \"opted in\", nil\n105|\t\t}},\n106|\t}\n107|\tresults, err := runner.Run(fixtures, 1)\n108|\tif err != nil {\n109|\t\tt.Fatalf(\"AllowUnreached Run: %v\", err)\n110|\t}\n111|\tif len(results) != 1 || results[0].Calls != 0 {\n112|\t\tt.Fatalf(\"AllowUnreached results = %+v, want one zero-call result\", results)\n113|\t}\n114|}\n115|\n116|func TestRunnerDigestCoversAllFixtures(t *testing.T) {\n117|\tt.Parallel()\n118|\tvar runner Runner\n119|\tfixtures := []Fixture{\n120|\t\t{Name: \"a\", Run: func(seed uint64, calls *Calls) (string, error) { calls.Add(1); return \"ra\", nil }},\n121|\t\t{Name: \"b\", Run: func(seed uint64, calls *Calls) (string, error) { calls.Add(1); return \"rb\", nil }},\n122|\t}\n123|\tfull, err := runner.Run(fixtures, 3)\n124|\tif err != nil {\n125|\t\tt.Fatalf(\"Run: %v\", err)\n126|\t}\n127|\tpartial, err := runner.Run(fixtures[:1], 3)\n128|\tif err != nil {\n129|\t\tt.Fatalf(\"Run: %v\", err)\n130|\t}\n131|\tif Digest(full) == Digest(partial) {\n132|\t\tt.Fatal(\"digest ignores a dropped fixture; the inventory is unwitnessed\")\n133|\t}\n134|\taltered := []Fixture{\n135|\t\t{Name: \"a\", Run: func(seed uint64, calls *Calls) (string, error) { calls.Add(1); return \"ra\", nil }},\n136|\t\t{Name: \"b\", Run: func(seed uint64, calls *Calls) (string, error) { calls.Add(9); return \"rb\", nil }},\n137|\t}\n138|\trerun, err := runner.Run(altered, 3)\n139|\tif err != nil {\n140|\t\tt.Fatalf(\"Run: %v\", err)\n141|\t}\n142|\tif Digest(full) == Digest(rerun) {\n143|\t\tt.Fatal(\"digest ignores a changed call count; the execution log is unwitnessed\")\n144|\t}\n145|}\n146|\n147|func TestRunnerDigestDistinguishesReports(t *testing.T) {\n148|\tt.Parallel()\n149|\t// Same names, same call counts, different reports: a digest that\n150|\t// drops the report witnesses nothing and must fail here.\n151|\trun := func(report string) []Result {\n152|\t\tvar runner Runner\n153|\t\tresults, err := runner.Run([]Fixture{\n154|\t\t\t{Name: \"a\", Run: func(seed uint64, calls *Calls) (string, error) { calls.Add(1); return report, nil }},\n155|\t\t}, 3)\n156|\t\tif err != nil {\n157|\t\t\tt.Fatalf(\"Run: %v\", err)\n158|\t\t}\n159|\t\treturn results\n160|\t}\n161|\tif Digest(run(\"ra\")) == Digest(run(\"rb\")) {\n162|\t\tt.Fatal(\"digest ignores the report; the witness is call counts only\")\n163|\t}\n164|}\n165|\n166|func TestRunnerDigestDistinguishesNames(t *testing.T) {\n167|\tt.Parallel()\n168|\t// Same reports, same call counts, different names: a digest that\n169|\t// drops the name witnesses nothing and must fail here.\n170|\trun := func(name string) []Result {\n171|\t\tvar runner Runner\n172|\t\tresults, err := runner.Run([]Fixture{\n173|\t\t\t{Name: name, Run: func(seed uint64, calls *Calls) (string, error) { calls.Add(1); return \"r\", nil }},\n174|\t\t}, 3)\n175|\t\tif err != nil {\n176|\t\t\tt.Fatalf(\"Run: %v\", err)\n177|\t\t}\n178|\t\treturn results\n179|\t}\n180|\tif Digest(run(\"a\")) == Digest(run(\"b\")) {\n181|\t\tt.Fatal(\"digest ignores the name; the witness is call counts only\")\n182|\t}\n183|}\n184|\n185|func TestRunnerPropagatesFixtureError(t *testing.T) {\n186|\tt.Parallel()\n187|\tvar runner Runner\n188|\tfixtures := []Fixture{\n189|\t\t{Name: \"broken\", Run: func(seed uint64, calls *Calls) (string, error) {\n190|\t\t\tcalls.Add(1)\n191|\t\t\treturn \"\", errTestSentinel\n192|\t\t}},\n193|\t}\n194|\t_, err := runner.Run(fixtures, 1)\n195|\tif err == nil || !strings.Contains(err.Error(), `\"broken\"`) {\n196|\t\tt.Fatalf(\"Run with a failing fixture = %v, want an error naming it\", err)\n197|\t}\n198|}"}}}
