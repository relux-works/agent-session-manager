n266|\ttransactor.mutex.Lock()\n267|\ttransactor.receipts[operationID] = receipt\n268|\ttransactor.finalized[operationID] = true\n269|\ttransactor.mutex.Unlock()\n270|\treturn receipt, nil\n271|}\n272|\n273|// ErrRollbackPastFinalize reports a rollback refused after a clean\n274|// Commit: the operation is terminal and rollback is forbidden\n275|// (AC-CLONE-005 shapes this rule; the model enforces it).\n276|var ErrRollbackPastFinalize = errors.New(\"secconftest rollback forbidden after commit\")\n277|\n278|// Rollback removes staged bytes for operationID before finalization.\n279|// It refuses to run past finalization: once Commit returns cleanly the\n280|// operation is terminal, rollback is forbidden, and the committed\n281|// bytes must survive the refused call untouched. Deleting the finalize\n282|// gate must fail the test that commits and then rolls back.\n283|func (transactor *Transactor) Rollback(operationID string) error {\n284|\tif err := transactor.injector.MaybeFail(PointRollbackEnter); err != nil {\n285|\t\treturn err\n286|\t}\n287|\ttransactor.mutex.Lock()\n288|\t_, ok := transactor.receipts[operationID]\n(more lines below)"}}}
