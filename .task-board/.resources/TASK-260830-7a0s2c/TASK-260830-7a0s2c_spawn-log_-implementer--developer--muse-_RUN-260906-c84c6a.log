{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9f5","stream":{"kind":"session","id":"01a0779e-4d99-7252-aca0-901ba58a6e8d"},"sequence":853,"recorded_at":1780531400001701,"record_type":"event","durability":"durable","causation_id":"352ff598-ec69-42f2-8d2a-c94c81033676","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"352ff598-ec69-42f2-8d2a-c94c81033676","run_stream":{"kind":"run","id":"352ff598-ec69-42f2-8d2a-c94c81033676"},"task_stream":{"kind":"task","id":"07496a90-8420-433c-bcbb-799645909a83"},"task_id":"07496a90-8420-433c-bcbb-799645909a83","event":{"kind":"output","task_id":"07496a90-8420-433c-bcbb-799645909a83","chunk":"edited\nchanged lines: lines 70-76\n--- original\n+++ updated\n@@\n-func TestSkipReportLogsHostCounts(t *testing.T) {\n-\t// Not parallel: it reads the process-wide counters. It records\n-\t// nothing itself: the counts come only from Require calls the\n-\t// suite really made, so the number is evidence, not prose.\n-\tLogReport(t)\n-\tt.Logf(\"skipped IDs: %q\", SkippedIDs())\n-}\n+func TestSkipReportReadsRecordedVerdicts(t *testing.T) {\n+\t// Not parallel: it mutates the process-wide counters. It records\n+\t// its own synthetic verdicts, asserts the report moves, then\n+\t// restores the suite state — so the numbers below are evidence\n+\t// that Report reads the live counters, not a constant. Gutting\n+\t// recordVerdict leaves both assertions red.\n+\tconst skipID = \"self-test-skip-probe\"\n+\tconst failID = \"self-test-fail-probe\"\n+\tbeforeSkipped, beforeFailed := snapshotReport()\n+\tt.Cleanup(func() {\n+\t\trestoreReport(beforeSkipped, beforeFailed)\n+\t\tfor _, id := range SkippedIDs() {\n+\t\t\tif id == skipID || id == failID {\n+\t\t\t\tt.Errorf(\"synthetic verdict %q leaked into the suite counters\", id)\n+\t\t\t}\n+\t\t}\n+\t})\n+\trecordVerdict(Verdict{ID: skipID, Skipped: true, Reason: \"synthetic skip\"})\n+\trecordVerdict(Verdict{ID: failID, Failed: true, Reason: \"synthetic failure\"})\n+\tfound := false\n+\tfor _, id := range SkippedIDs() {\n+\t\tif id == skipID {\n+\t\t\tfound = true\n+\t\t}\n+\t}\n+\tif !found {\n+\t\tt.Fatalf(\"SkippedIDs() = %q, want it to contain %q\", SkippedIDs(), skipID)\n+\t}\n+\treport := Report()\n+\tif !strings.Contains(report, skipID) || !strings.Contains(report, failID) {\n+\t\tt.Fatalf(\"Report() = %q, want it to carry both synthetic verdicts\", report)\n+\t}\n+\t// Attached evidence with real nonzero counters from this test's\n+\t// own recorded verdicts.\n+\tLogReport(t)\n+\tt.Logf(\"skipped IDs: %q\", SkippedIDs())\n+}\n"}}}
