{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c55f","stream":{"kind":"session","id":"01a0779e-4d99-7252-aca0-901ba58a6e8d"},"sequence":266,"recorded_at":1780531400000527,"record_type":"event","durability":"durable","causation_id":"352ff598-ec69-42f2-8d2a-c94c81033676","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"352ff598-ec69-42f2-8d2a-c94c81033676","run_stream":{"kind":"run","id":"352ff598-ec69-42f2-8d2a-c94c81033676"},"task_stream":{"kind":"task","id":"a79cb6e5-13c8-47bd-ac2f-1545cf3d3b05"},"task_id":"a79cb6e5-13c8-47bd-ac2f-1545cf3d3b05","event":{"kind":"output","task_id":"a79cb6e5-13c8-47bd-ac2f-1545cf3d3b05","chunk":"Read text file `internal/secconftest/clock_test.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"testing\"\n6|\t\"time\"\n7|)\n8|\n9|var errTestSentinel = errors.New(\"secconftest test sentinel\")\n10|\n11|func TestFakeClockStartsPinned(t *testing.T) {\n12|\tt.Parallel()\n13|\tfirst := &Fake{}\n14|\tsecond := &Fake{}\n15|\tif !first.Now().Equal(second.Now()) {\n16|\t\tt.Fatalf(\"two fresh fakes disagree: %v vs %v\", first.Now(), second.Now())\n17|\t}\n18|\tif first.Now().Location() != time.UTC {\n19|\t\tt.Fatalf(\"fake start location = %v, want UTC\", first.Now().Location())\n20|\t}\n21|}\n22|\n23|func TestFakeClockIgnoresRealTime(t *testing.T) {\n24|\tt.Parallel()\n25|\tclock := &Fake{}\n26|\tbefore := clock.Now()\n27|\twallBefore := time.Now()\n28|\ttime.Sleep(20 * time.Millisecond)\n29|\tif got := clock.Now(); !got.Equal(before) {\n30|\t\tt.Fatalf(\"fake advanced without Advance: %v -> %v\", before, got)\n31|\t}\n32|\tif !time.Now().After(wallBefore) {\n33|\t\tt.Fatal(\"wall clock did not advance; the test cannot tell fake from real\")\n34|\t}\n35|}\n36|\n37|func TestFakeAdvanceAndSet(t *testing.T) {\n38|\tt.Parallel()\n39|\tclock := &Fake{}\n40|\tstart := clock.Now()\n41|\tclock.Advance(90 * time.Second)\n42|\tif got := clock.Now().Sub(start); got != 90*time.Second {\n43|\t\tt.Fatalf(\"Advance(90s) moved %v\", got)\n44|\t}\n45|\tclock.Advance(-time.Hour)\n46|\tif got := clock.Now().Sub(start); got != 90*time.Second {\n47|\t\tt.Fatalf(\"negative Advance moved the clock to %v\", got)\n48|\t}\n49|\tpinned := time.Date(2030, time.May, 4, 12, 0, 0, 0, time.UTC)\n50|\tclock.Set(pinned)\n51|\tif got := clock.Now(); !got.Equal(pinned) {\n52|\t\tt.Fatalf(\"Set moved to %v, want %v\", got, pinned)\n53|\t}\n54|}\n55|\n56|func TestRecordingNoticesUnwiredClock(t *testing.T) {\n57|\tt.Parallel()\n58|\twired := Wrap(&Fake{})\n59|\t_ = wired.Now()\n60|\tif got := wired.Calls(); got != 1 {\n61|\t\tt.Fatalf(\"wired path recorded %d Now calls, want 1\", got)\n62|\t}\n63|\tunwired := Wrap(&Fake{})\n64|\t// The buggy path takes the clock and never reads it (wall clock or\n65|\t// no clock instead). The suite must notice the zero, not pass it.\n66|\tif got := unwired.Calls(); got != 0 {\n67|\t\tt.Fatalf(\"unwired path recorded %d Now calls, want the detectable 0\", got)\n68|\t}\n69|}\n70|\n71|func TestRecordingCountsConcurrentReads(t *testing.T) {\n72|\tt.Parallel()\n73|\trecording := Wrap(&Fake{})\n74|\tdone := make(chan struct{})\n75|\tfor range 8 {\n76|\t\tgo func() {\n77|\t\t\t_ = recording.Now()\n78|\t\t\tdone <- struct{}{}\n79|\t\t}()\n80|\t}\n81|\tfor range 8 {\n82|\t\t<-done\n83|\t}\n84|\tif got := recording.Calls(); got != 8 {\n85|\t\tt.Fatalf(\"concurrent Now calls recorded %d, want 8\", got)\n86|\t}\n87|}"}}}
