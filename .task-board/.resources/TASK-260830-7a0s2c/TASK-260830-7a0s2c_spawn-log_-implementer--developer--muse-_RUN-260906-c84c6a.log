{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c759","stream":{"kind":"session","id":"01a0779e-4d99-7252-aca0-901ba58a6e8d"},"sequence":519,"recorded_at":1780531400001033,"record_type":"event","durability":"durable","causation_id":"352ff598-ec69-42f2-8d2a-c94c81033676","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"352ff598-ec69-42f2-8d2a-c94c81033676","run_stream":{"kind":"run","id":"352ff598-ec69-42f2-8d2a-c94c81033676"},"task_stream":{"kind":"task","id":"96d9add6-5b61-4a9e-b236-bf4189ac4a9f"},"task_id":"96d9add6-5b61-4a9e-b236-bf4189ac4a9f","event":{"kind":"output","task_id":"96d9add6-5b61-4a9e-b236-bf4189ac4a9f","chunk":"{\n  \"chunk_id\": \"exec-17-1\",\n  \"command\": \"task-board q --help 2>&1 | head -30; echo ===; task-board m --help 2>&1 | head -40\",\n  \"description\": \"Show query and mutation syntax\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Execute queries against the board using a compact DSL.\\n\\nOperations:\\n  get(ID)              Get a single element by ID\\n  activity(ID, ...)    Read bounded, cursor-paginated element activity\\n  list(filters...)     List elements with filters\\n  count(filters...)    Count elements matching filters\\n  summary()            Board overview (counts + active/blocked)\\n  plan(scope?)         Execution phases; scope=[ID,ID,...] plans the union of subtrees\\n  agents(stale=N?)     Agent dashboard\\n  models(agent?)       Available models for spawn\\n  project_config()     Full active project board runtime config (always local)\\n  project_config(view=spawn-preflight, role=ROLE, agent=PROVIDER?)\\n                       Narrow effective child-spawn policy for one target\\n  provider_limits()    Machine-scoped provider rate-limit state (always local)\\n  provider_limits(identity=KEY|all_identities=true)\\n                       Report one indexed provider identity, or every one\\n  whoami()             Current remote URL and active user (always local)\\n  schema()             Introspect the full operations/fields/presets contract\\n  schema(operation=NAME|mutation=NAME)\\n                       Return only one typed operation or mutation signature\\n\\nField projection:\\n  { id status assignee }     Select specific fields\\n  { overview }               Use a base preset (minimal, default, overview, full, progress, planning)\\n  { observability-task }     Use project observability presets (project, epic, story, task)\\n  (omitted)                  Defaults to { id name status }\\n\\nBatching:\\n  Separate multiple queries with semicolons; results preserve source order\\n===\\nExecute a write operation against the board using the DSL.\\n\\nMutations:\\n  set_status(ID, status=..., commit_ack=scope_committed?)\\n                                        Change status; acknowledge enforced done transitions\\n  normalize_legacy_status(ID, expected_raw=..., status=...)\\n                                        Repair one exact unparseable raw status (local boards)\\n  handoff(ID, role=..., status=...)     Verify checklist/outcome evidence and change status\\n  set_estimate(ID, estimate=..., ...)  Set Task/Bug story-point estimate\\n  create(type=..., name=..., ...)      Create element\\n  set_details(ID, title=..., ...)      Update README fields\\n  rename(ID, name=...)                 Rename element name/slug\\n  delete(ID)                           Delete element (destructive)\\n  assign(ID, agent=...)                Assign agent\\n  unassign(ID)                         Remove assignment\\n  link(ID, blocked_by=...)             Add dependency\\n  unlink(ID, blocked_by=...)           Remove dependency\\n  check_item(ID, item=N)              Check checklist item\\n  uncheck_item(ID, item=N)            Uncheck checklist item\\n  add_checklist_item(ID, text=...)     Add checklist item\\n  remove_checklist_item(ID, item=N)    Remove obsolete checklist item (destructive)\\n  set_notes(ID, text=..., set=bool?)   Append/set notes\\n  set_parent(ID, parent=...)           Move to new parent\\n  accept_cr(ID, revision=N, evidence=...) Record a reviewer acceptance of a Change Request revision (local board only)\\n  add_resource(ID, name=..., content=..., type=..., description=...)\\n  update_resource(ID, name=..., content=..., type=..., description=...)\\n  delete_resource(ID, name=...)        Delete resource (destructive)\\n  correct_activity(ID, target_event_id=..., kind=..., reason=...)\\n                                        Privileged append-only correction (destructive)\\n\\nAuth (always local):\\n  login(user=..., token=...)           Store token in credentials file\\n  logout()                             Remove active user's token\\n  switch_user(user=...)                Switch active user for remote\\n\\nSafety:\\n  --dry-run     Preview mutation without applying\\n  --confirm     Required for every schema-classified destructive mutation\\n\\nIntrospection:\\n\",\n  \"original_output_bytes\": 3885,\n  \"original_output_tokens\": 972,\n  \"truncated\": false\n}"}}}
