{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c557","stream":{"kind":"session","id":"01a0779e-4d99-7252-aca0-901ba58a6e8d"},"sequence":262,"recorded_at":1780531400000519,"record_type":"event","durability":"durable","causation_id":"352ff598-ec69-42f2-8d2a-c94c81033676","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"352ff598-ec69-42f2-8d2a-c94c81033676","run_stream":{"kind":"run","id":"352ff598-ec69-42f2-8d2a-c94c81033676"},"task_stream":{"kind":"task","id":"2761a1f0-4492-4384-9fee-35c920e723d2"},"task_id":"2761a1f0-4492-4384-9fee-35c920e723d2","event":{"kind":"output","task_id":"2761a1f0-4492-4384-9fee-35c920e723d2","chunk":"Read text file `internal/secconftest/fuzz_test.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|\t\"unicode/utf8\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n9|)\n10|\n11|var fuzzDriver = NewDriver()\n12|\n13|var fuzzSeeds = []string{\n14|\t\"\",\n15|\t\"a\",\n16|\t\"staging/member\",\n17|\t\"../evil\",\n18|\t\"/absolute\",\n19|\t\"C:/drive\",\n20|\t\"a%2fb\",\n21|\t\"file:stream\",\n22|\t\"NUL\",\n23|\t\"password=hunter2\",\n24|\t\"-----BEGIN RSA PRIVATE KEY-----\\nMIIB\\n-----END RSA PRIVATE KEY-----\",\n25|\t\"https://user:pass@example.com/x\",\n26|\t\"a\\x1b[31mb\",\n27|\t\"a\\u202eb\",\n28|\t\"a\\x00b\",\n29|\t\"a\\xffb\",\n30|\t\"; rm -rf /\",\n31|\t\"$(evil)\",\n32|\t\"AX_VALID_NAME\",\n33|\t\"1bad-name\",\n34|\tstrings.Repeat(\"A\", 129),\n35|\t\"readme.md\",\n36|}\n37|\n38|func TestFuzzDriversReachProduction(t *testing.T) {\n39|\tt.Parallel()\n40|\tdriver := NewDriver()\n41|\tfor _, seed := range fuzzSeeds {\n42|\t\tdriver.DriveArgv([]string{\"exe\", seed})\n43|\t\tdriver.DriveMemberPath(seed)\n44|\t\tdriver.DriveEnvName(seed)\n45|\t\tdriver.DriveRedact(seed)\n46|\t\tdriver.DriveEscape(seed)\n47|\t\tdriver.DriveRender(seed)\n48|\t\tdriver.DriveGuardResolve(seed)\n49|\t\tdriver.DriveCaseCollision(seed)\n50|\t}\n51|\tfor entry, want := range map[FuzzEntry]bool{\n52|\t\tEntryCheckArgv: true, EntryCheckMemberPath: true, EntryIsEnvName: true,\n53|\t\tEntryRedact: true, EntryEscapeForTerminal: true, EntryRenderForTerminal: true,\n54|\t\tEntryGuardResolve: true, EntryDetectCaseCollision: true,\n55|\t} {\n56|\t\tif !want {\n57|\t\t\tcontinue\n58|\t\t}\n59|\t\tif got := driver.Count(entry); got == 0 {\n60|\t\t\tt.Fatalf(\"no seed reached %s; the corpus cannot cover it\", entry)\n61|\t\t}\n62|\t\tt.Logf(\"entry %s arrivals: %d\", entry, driver.Count(entry))\n63|\t}\n64|\tif len(FuzzTargetEntry) != 8 {\n65|\t\tt.Fatalf(\"FuzzTargetEntry has %d targets, want the 8 committed Fuzz functions\", len(FuzzTargetEntry))\n66|\t}\n67|\tseen := map[FuzzEntry]bool{}\n68|\tfor target, entry := range FuzzTargetEntry {\n69|\t\tif !strings.HasPrefix(target, \"Fuzz\") || entry == \"\" {\n70|\t\t\tt.Fatalf(\"FuzzTargetEntry[%q] = %q is malformed\", target, entry)\n71|\t\t}\n72|\t\tseen[entry] = true\n73|\t}\n74|\tif len(seen) != 8 {\n75|\t\tt.Fatalf(\"FuzzTargetEntry covers %d distinct entries, want 8\", len(seen))\n76|\t}\n77|}\n78|\n79|func FuzzCheckArgv(f *testing.F) {\n80|\tfor _, seed := range fuzzSeeds {\n81|\t\tf.Add(seed)\n82|\t}\n83|\tf.Fuzz(func(t *testing.T, element string) {\n84|\t\tadmitted := fuzzDriver.DriveArgv([]string{\"exe\", element})\n85|\t\tif admitted && element == \"\" {\n86|\t\t\tt.Fatal(\"empty argv element admitted\")\n87|\t\t}\n88|\t\t// Single-gate agreement: NewCommand validates through the same\n89|\t\t// CheckArgv, so the two must agree on every input.\n90|\t\t_, err := secprim.NewCommand([]string{\"exe\", element})\n91|\t\tif admitted != (err == nil) {\n92|\t\t\tt.Fatalf(\"CheckArgv(%q)=%v disagrees with NewCommand err=%v\", element, admitted, err)\n93|\t\t}\n94|\t})\n95|}\n96|\n97|func FuzzCheckMemberPath(f *testing.F) {\n98|\tfor _, seed := range fuzzSeeds {\n99|\t\tf.Add(seed)\n100|\t}\n101|\tf.Fuzz(func(t *testing.T, member string) {\n102|\t\tadmitted := fuzzDriver.DriveMemberPath(member)\n103|\t\tif !admitted {\n104|\t\t\treturn\n105|\t\t}\n106|\t\t// Containment property: every admitted member resolves inside\n107|\t\t// the fixed root through the production Guard.Resolve.\n108|\t\tif !fuzzDriver.DriveGuardResolve(member) {\n109|\t\t\tt.Fatalf(\"member %q admitted by CheckMemberPath but refused by Guard.Resolve\", member)\n110|\t\t}\n111|\t})\n112|}\n113|\n114|func FuzzIsEnvName(f *testing.F) {\n115|\tfor _, seed := range fuzzSeeds {\n116|\t\tf.Add(seed)\n117|\t}\n118|\tf.Fuzz(func(t *testing.T, name string) {\n119|\t\tif !fuzzDriver.DriveEnvName(name) {\n120|\t\t\treturn\n121|\t\t}\n122|\t\t// An admitted name must build through the production allowlist\n123|\t\t// path: absent from the parent environment is skipped, never\n124|\t\t// failed.\n125|\t\tif _, err := secprim.BuildEnv([]string{name}, nil, func(string) (string, bool) { return \"\", false }); err != nil {\n126|\t\t\tt.Fatalf(\"admitted env name %q fails BuildEnv: %v\", name, err)\n127|\t\t}\n128|\t})\n129|}\n130|\n131|func FuzzRedactCorpus(f *testing.F) {\n132|\tfor _, seed := range fuzzSeeds {\n133|\t\tf.Add(seed)\n134|\t}\n135|\tf.Fuzz(func(t *testing.T, line string) {\n136|\t\tfuzzDriver.DriveRedact(line)\n137|\t\t// Idempotency the package documents: rescanning redacted text\n138|\t\t// changes nothing.\n139|\t\tonce := secprim.Redact(line, nil)\n140|\t\tif twice := secprim.Redact(once, nil); twice != once {\n141|\t\t\tt.Fatalf(\"Redact not idempotent on %q: %q then %q\", line, once, twice)\n142|\t\t}\n143|\t})\n144|}\n145|\n146|func FuzzEscapeForTerminal(f *testing.F) {\n147|\tfor _, seed := range fuzzSeeds {\n148|\t\tf.Add(seed)\n149|\t}\n150|\tf.Fuzz(func(t *testing.T, text string) {\n151|\t\tescaped := fuzzDriver.DriveEscape(text)\n152|\t\tassertTerminalInert(t, escaped)\n153|\t})\n154|}\n155|\n156|func FuzzRenderForTerminal(f *testing.F) {\n157|\tfor _, seed := range fuzzSeeds {\n158|\t\tf.Add(seed)\n159|\t}\n160|\tf.Fuzz(func(t *testing.T, line string) {\n161|\t\trendered := fuzzDriver.DriveRender(line)\n162|\t\t// Wiring property: Render is Redact then Escape, in that order,\n163|\t\t// so a secret containing an escape sequence is removed as a\n164|\t\t// secret rather than merely neutralized.\n165|\t\tif want := secprim.EscapeForTerminal(secprim.Redact(line, nil)); rendered != want {\n166|\t\t\tt.Fatalf(\"RenderForTerminal(%q) = %q, want Escape(Redact) = %q\", line, rendered, want)\n167|\t\t}\n168|\t\tassertTerminalInert(t, rendered)\n169|\t})\n170|}\n171|\n172|func FuzzGuardResolve(f *testing.F) {\n173|\tfor _, seed := range fuzzSeeds {\n174|\t\tf.Add(seed)\n175|\t}\n176|\tf.Fuzz(func(t *testing.T, member string) {\n177|\t\tif !fuzzDriver.DriveGuardResolve(member) {\n178|\t\t\treturn\n179|\t\t}\n180|\t\tguard, err := secprim.NewGuard(\"/stage\", \"linux\", nil)\n181|\t\tif err != nil {\n182|\t\t\tt.Fatalf(\"fixed guard construction: %v\", err)\n183|\t\t}\n184|\t\tresolved, err := guard.Resolve(member)\n185|\t\tif err != nil {\n186|\t\t\tt.Fatalf(\"DriveGuardResolve admitted %q but Resolve refuses: %v\", member, err)\n187|\t\t}\n188|\t\tif resolved != \"/stage/\"+member && !strings.HasPrefix(resolved, \"/stage/\") {\n189|\t\t\tt.Fatalf(\"Resolve(%q) = %q escapes the root\", member, resolved)\n190|\t\t}\n191|\t})\n192|}\n193|\n194|func FuzzDetectCaseCollision(f *testing.F) {\n195|\tfor _, seed := range fuzzSeeds {\n196|\t\tf.Add(seed)\n197|\t}\n198|\tf.Fuzz(func(t *testing.T, candidate string) {\n199|\t\tcollided := fuzzDriver.DriveCaseCollision(candidate)\n200|\t\tif !collided {\n201|\t\t\treturn\n202|\t\t}\n203|\t\t// A reported collision must fold-equal a listed sibling it is\n204|\t\t// not identical to.\n205|\t\tfor _, sibling := range []string{\"README.md\", \"staging/member\"} {\n206|\t\t\tif sibling != candidate && strings.EqualFold(sibling, candidate) {\n207|\t\t\t\treturn\n208|\t\t\t}\n209|\t\t}\n210|\t\tt.Fatalf(\"collision reported for %q with no fold-equal sibling\", candidate)\n211|\t})\n212|}\n213|\n214|func assertTerminalInert(t *testing.T, escaped string) {\n215|\tt.Helper()\n216|\tif !utf8.ValidString(escaped) {\n217|\t\tt.Fatalf(\"escaped output %q is not valid UTF-8\", escaped)\n218|\t}\n219|\tfor _, character := range escaped {\n220|\t\tswitch {\n221|\t\tcase character == '\\n' || character == '\\t':\n222|\t\tcase character < 0x20 || character == 0x7f || character >= 0x80 && character <= 0x9f:\n223|\t\t\tt.Fatalf(\"escaped output carries control %U\", character)\n224|\t\tcase character == 0x1b:\n225|\t\t\tt.Fatal(\"escaped output carries ESC\")\n226|\t\t}\n227|\t}\n228|\tfor _, refused := range BidiRunes() {\n229|\t\tif strings.ContainsRune(escaped, refused) {\n230|\t\t\tt.Fatalf(\"escaped output carries %U\", refused)\n231|\t\t}\n232|\t}\n233|}"}}}
