{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8b1","stream":{"kind":"session","id":"01a0779e-4d99-7252-aca0-901ba58a6e8d"},"sequence":691,"recorded_at":1780531400001377,"record_type":"event","durability":"durable","causation_id":"352ff598-ec69-42f2-8d2a-c94c81033676","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"352ff598-ec69-42f2-8d2a-c94c81033676","run_stream":{"kind":"run","id":"352ff598-ec69-42f2-8d2a-c94c81033676"},"task_stream":{"kind":"task","id":"3eb770f7-f44e-40e5-97b4-e1c77fa6ed80"},"task_id":"3eb770f7-f44e-40e5-97b4-e1c77fa6ed80","event":{"kind":"output","task_id":"3eb770f7-f44e-40e5-97b4-e1c77fa6ed80","chunk":"edited\nchanged lines: lines 117-122\n--- original\n+++ updated\n@@\n-// Armed reports whether point is currently armed.\n-func (injector *Injector) Armed(point string) bool {\n-\tinjector.mutex.Lock()\n-\tdefer injector.mutex.Unlock()\n-\treturn injector.armed[point]\n-}\n+// Armed reports whether point is currently armed.\n+func (injector *Injector) Armed(point string) bool {\n+\tinjector.mutex.Lock()\n+\tdefer injector.mutex.Unlock()\n+\treturn injector.armed[point]\n+}\n+\n+// RemainingArmed lists the points still armed, sorted. A test that arms\n+// a point and drives the operation must find this empty afterwards: an\n+// armed point that never fires is otherwise noticed only incidentally,\n+// and a new crash site added without an arm is outside this model (see\n+// the package bounds). Weakening this to a constant empty slice must\n+// fail the consumption test that drives it.\n+func (injector *Injector) RemainingArmed() []string {\n+\tinjector.mutex.Lock()\n+\tdefer injector.mutex.Unlock()\n+\tremaining := make([]string, 0, len(injector.armed))\n+\tfor point := range injector.armed {\n+\t\tremaining = append(remaining, point)\n+\t}\n+\tsort.Strings(remaining)\n+\treturn remaining\n+}\n"}}}
