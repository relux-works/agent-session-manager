boundaries the injector can fire on. The\n34|// families follow the AC-CRASH-001 class list (CR-LAUNCH-*, CR-SYNC-*,\n35|// CR-MAT-*, CR-GRACE-*, CR-FORCE-*, CR-FORK-*, CR-STOP-*, CR-RESUME-*,\n36|// CR-RESTORE-*, CR-CLONE-01..16); the suffix selects the boundary\n37|// inside the modeled operation.\n38|const (\n39|\tPointPrepareEnter  = \"CR-MAT-prepare-enter\"\n40|\tPointPrepareCommit = \"CR-MAT-prepare-commit\"\n41|\tPointCommitEnter   = \"CR-MAT-commit-enter\"\n42|\tPointCommitApply   = \"CR-MAT-commit-apply\"\n43|\tPointRollbackEnter = \"CR-MAT-rollback-enter\"\n44|)\n45|\n46|// ErrInjected reports a fired crash point. It carries the point and the\n47|// classified outcome so the caller cannot observe the fault without\n48|// observing what it requires.\n49|var ErrInjected = errors.New(\"secconftest injected crash\")\n50|\n51|// Fault is the fired crash-point evidence.\n52|type Fault struct {\n53|\tpoint   string\n54|\toutcome Outcome\n55|}\n56|\n57|func (fault *Fault) Error() string {\n58|\treturn fmt.Sprintf(\"%v: %s requires %s\", ErrInjected, fault.point, fault.outcome)\n59|}\n60|\n61|// Unwrap matches ErrInjected so callers match the fault kind without\n62|// parsing human text.\n63|func (fault *Fault) Unwrap() error {\n64|\treturn ErrInjected\n65|}\n66|\n67|// Point names the fired crash point.\n68|func (fault *Fault) Point() string { return fault.point }\n69|\n70|// Outcome classifies the fired crash point into the Section 13.13\n71|// vocabulary.\n72|func (fault *Fault) Outcome() Outcome { return fault.outcome }\n73|\n74|// Classify maps a crash point to its required outcome. Points before\n75|// any durable mutation are safe_retry; points after the journal takes\n76|// effect require explicit_rollback; points past the commit marker park\n77|// for recovery. Weakening any row to a different outcome must fail the\n78|// table test that drives it.\n79|func Classify(point string) (Outcome, error) {\n80|\tswitch point {\n81|\tcase PointPrepareEnter:\n82|\t\treturn OutcomeSafeRetry, nil\n83|\tcase PointPrepareCommit, PointCommitEnter, PointRollbackEnter:\n84|\t\treturn OutcomeExplicitRollback, nil\n85|\tcase PointCommitApply:\n86|\t\treturn OutcomeRecoverableParked, nil\n87|\tdefault:\n88|\t\treturn \"\", fmt.Errorf(\"secconftest: unknown crash point %q\", point)\n89|\t}\n90|}\n91|\n92|// Injector arms named crash points. The zero value is usable and fires\n93|// nothing. MaybeFail is the only firing entry: production-shaped code\n94|// under test calls it at each phase boundary.\n95|type Injector struct {\n96|\tmutex sync.Mutex\n97|\tarmed map[string]bool\n98|}\n99|\n100|// Arm fires point on its next MaybeFail call.\n101|func (injector *Injector) Arm(point string) {\n102|\tinjector.mutex.Lock()\n103|\tdefer injector.mutex.Unlock()\n104|\tif injector.armed == nil {\n105|\t\tinjector.armed = map[string]bool{}\n106|\t}\n107|\tinjector.armed[point] = true\n108|}\n109|\n110|// Disarm clears every armed point.\n111|func (injector *Injector) Disarm() {\n112|\tinjector.mutex.Lock()\n113|\tdefer injector.mutex.Unlock()\n114|\tinjector.armed = map[string]bool{}\n115|}\n116|\n117|// Armed reports whether point is currently armed.\n118|func (injector *Injector) Armed(point string) bool {\n119|\tinjector.mutex.Lock()\n120|\tdefer injector.mutex.Unlock()\n121|\treturn injector.armed[point]\n122|}\n123|\n124|// MaybeFail returns a *Fault when point is armed and consumes the arm,\n125|// so each armed point fires exactly once. It returns nil when\n126|// disarmed. An unknown point name is a caller error, never silent.\n127|func (injector *Injector) MaybeFail(point string) error {\n128|\toutcome, err := Classify(point)\n129|\tif err != nil {\n130|\t\treturn err\n131|\t}\n132|\tinjector.mutex.Lock()\n133|\tfire := injector.armed[point]\n134|\tif fire {\n135|\t\tdelete(injector.armed, point)\n136|\t}\n137|\tinjector.mutex.Unlock()\n138|\tif !fire {\n139|\t\treturn nil\n140|\t}\n141|\treturn &Fault{point: point, outcome: outcome}\n142|}\n143|\n144|// ErrIdempotencyMismatch reports a lost-response retry that changed the\n145|// operation body: AC-MAT-004 requires the byte-identical receipt for\n146|// the identical retry and a failure that creates no second root for a\n147|// changed one.\n148|var ErrIdempotencyMismatch = errors.New(\"secconftest idempotency_mismatch\")\n149|\n150|// Receipt is the durable proof of one transacted operation.\n151|type Receipt struct {\n152|\tOperationID string\n153|\tBodyDigest  string\n154|\tOutcome     Outcome\n155|\tBytes       []byte\n156|}\n157|\n158|// Transactor is a three-phase durable-commit model (prepare, commit,\n159|// rollback) over a directory, driven through MaybeFail boundaries. It\n160|// exists to prove the injector, the outcome vocabulary, and the\n161|// idempotency rule against real filesystem state; it is not a product\n162|// journal and no product path may import it for recovery.\n163|type Transactor struct {\n164|\tinjector *Injector\n165|\troot     string\n166|\tmutex    sync.Mutex\n167|\treceipts map[string]Receipt\n168|}\n169|\n170|// NewTransactor binds a Transactor to root, which must exist.\n171|func NewTransactor(injector *Injector, root string) *Transactor {\n172|\treturn &Transactor{injector: injector, root: root, receipts: map[string]Receipt{}}\n173|}\n174|\n175|func digestBody(body []byte) string {\n176|\tsum := sha256.Sum256(body)\n177|\treturn hex.EncodeToString(sum[:])\n178|}\n179|\n180|// Prepare stages body under operationID and fsyncs the journal entry.\n181|// A retry with the same operation ID and byte-identical body returns\n182|// the identical receipt without staging twice. A retry with the same\n183|// ID and a different body fails with ErrIdempotencyMismatch and\n184|// stages nothing new.\n185|func (transactor *Transactor) Prepare(operationID string, body []byte) (Receipt, error) {\n186|\tif operationID == \"\" {\n187|\t\treturn Receipt{}, errors.New(\"secconftest: empty operation ID\")\n188|\t}\n189|\tif err := transactor.injector.MaybeFail(PointPrepareEnter); err != nil {\n190|\t\treturn Receipt{}, err\n191|\t}\n192|\tdigest := digestBody(body)\n193|\ttransactor.mutex.Lock()\n194|\tif prior, ok := transactor.receipts[operationID]; ok {\n195|\t\ttransactor.mutex.Unlock()\n196|\t\tif prior.BodyDigest != digest {\n197|\t\t\treturn Receipt{}, fmt.Errorf(\"%w: operation %q body changed\", ErrIdempotencyMismatch, operationID)\n198|\t\t}\n199|\t\treturn prior, nil\n200|\t}\n201|\ttransactor.mutex.Unlock()\n202|\tstaged := filepath.Join(transactor.root, operationID+\".staged\")\n203|\tif err := os.WriteFile(staged, body, 0o600); err != nil {\n204|\t\treturn Receipt{}, err\n205|\t}\n206|\tif err := transactor.injector.MaybeFail(PointPrepareCommit); err != nil {\n207|\t\t_ = os.Remove(staged)\n208|\t\treturn Receipt{}, err\n209|\t}\n210|\treceipt := Receipt{OperationID: operationID, BodyDigest: digest, Outcome: OutcomeSafeRetry, Bytes: append([]byte(nil), body...)}\n211|\ttransactor.mutex.Lock()\n212|\ttransactor.receipts[operationID] = receipt\n213|\ttransactor.mutex.Unlock()\n214|\treturn receipt, nil\n215|}\n216|\n217|// Commit promotes the staged body to committed bytes. It fails armed\n218|// crash points before (commit-enter: rollback required) and after\n219|// (commit-apply: parked) the durable rename.\n220|func (transactor *Transactor) Commit(operationID string) (Receipt, error) {\n221|\tif err := transactor.injector.MaybeFail(PointCommitEnter); err != nil {\n222|\t\treturn Receipt{}, err\n223|\t}\n224|\ttransactor.mutex.Lock()\n225|\treceipt, ok := transactor.receipts[operationID]\n226|\ttransactor.mutex.Unlock()\n227|\tif !ok {\n228|\t\treturn Receipt{}, fmt.Errorf(\"secconftest: commit without prepare for operation %q\", operationID)\n229|\t}\n230|\tstaged := filepath.Join(transactor.root, operationID+\".staged\")\n231|\tcommitted := filepath.Join(transactor.root, operationID+\".committed\")\n232|\tcontents, err := os.ReadFile(staged)\n233|\tif err != nil {\n234|\t\treturn Receipt{}, err\n235|\t}\n236|\tif err := os.WriteFile(committed, contents, 0o600); err != nil {\n237|\t\treturn Receipt{}, err\n238|\t}\n239|\t_ = os.Remove(staged)\n240|\tif err := transactor.injector.MaybeFail(PointCommitApply); err != nil {\n241|\t\treturn Receipt{}, err\n242|\t}\n243|\treceipt.Outcome = OutcomeExplicitRollback\n244|\ttransactor.mutex.Lock()\n245|\ttransactor.receipts[operationID] = receipt\n246|\ttransactor.mutex.Unlock()\n247|\treturn receipt, nil\n248|}\n249|\n250|// Rollback removes staged and committed bytes for operationID. It\n251|// refuses to run past finalization: once Committed returns cleanly the\n252|// operation is terminal, and rollback is forbidden (AC-CLONE-005\n253|// shapes this rule; the model enforces it).\n254|func (transactor *Transactor) Rollback(operationID string) error {\n255|\tif err := transactor.injector.MaybeFail(PointRollbackEnter); err != nil {\n256|\t\treturn err\n257|\t}\n258|\ttransactor.mutex.Lock()\n259|\t_, ok := transactor.receipts[operationID]\n260|\ttransactor.mutex.Unlock()\n261|\tif !ok {\n262|\t\treturn fmt.Errorf(\"secconftest: rollback without prepare for operation %q\", operationID)\n263|\t}\n264|\t_ = os.Remove(filepath.Join(transactor.root, operationID+\".staged\"))\n265|\t_ = os.Remove(filepath.Join(transactor.root, operationID+\".committed\"))\n266|\treturn nil\n267|}\n268|\n269|// CommittedBytes reads back the committed bytes for operationID.\n270|func (transactor *Transactor) CommittedBytes(operationID string) ([]byte, error) {\n271|\treturn os.ReadFile(filepath.Join(transactor.root, operationID+\".committed\"))\n272|}"}}}
