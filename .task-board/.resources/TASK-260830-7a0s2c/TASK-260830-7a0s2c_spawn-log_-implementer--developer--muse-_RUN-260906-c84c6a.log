{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c941","stream":{"kind":"session","id":"01a0779e-4d99-7252-aca0-901ba58a6e8d"},"sequence":763,"recorded_at":1780531400001521,"record_type":"event","durability":"durable","causation_id":"352ff598-ec69-42f2-8d2a-c94c81033676","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"352ff598-ec69-42f2-8d2a-c94c81033676","run_stream":{"kind":"run","id":"352ff598-ec69-42f2-8d2a-c94c81033676"},"task_stream":{"kind":"task","id":"be66c19b-d5ee-45aa-9585-a24112b7d0fc"},"task_id":"be66c19b-d5ee-45aa-9585-a24112b7d0fc","event":{"kind":"output","task_id":"be66c19b-d5ee-45aa-9585-a24112b7d0fc","chunk":"edited\nchanged lines: lines 273-290\n--- original\n+++ updated\n@@\n-// Rollback removes staged and committed bytes for operationID. It\n-// refuses to run past finalization: once Committed returns cleanly the\n-// operation is terminal, and rollback is forbidden (AC-CLONE-005\n-// shapes this rule; the model enforces it).\n-func (transactor *Transactor) Rollback(operationID string) error {\n-\tif err := transactor.injector.MaybeFail(PointRollbackEnter); err != nil {\n-\t\treturn err\n-\t}\n-\ttransactor.mutex.Lock()\n-\t_, ok := transactor.receipts[operationID]\n-\ttransactor.mutex.Unlock()\n-\tif !ok {\n-\t\treturn fmt.Errorf(\"secconftest: rollback without prepare for operation %q\", operationID)\n-\t}\n-\t_ = os.Remove(filepath.Join(transactor.root, operationID+\".staged\"))\n-\t_ = os.Remove(filepath.Join(transactor.root, operationID+\".committed\"))\n-\treturn nil\n-}\n+// ErrRollbackPastFinalize reports a rollback refused after a clean\n+// Commit: the operation is terminal and rollback is forbidden\n+// (AC-CLONE-005 shapes this rule; the model enforces it).\n+var ErrRollbackPastFinalize = errors.New(\"secconftest rollback forbidden after commit\")\n+\n+// Rollback removes staged bytes for operationID before finalization.\n+// It refuses to run past finalization: once Commit returns cleanly the\n+// operation is terminal, rollback is forbidden, and the committed\n+// bytes must survive the refused call untouched. Deleting the finalize\n+// gate must fail the test that commits and then rolls back.\n+func (transactor *Transactor) Rollback(operationID string) error {\n+\tif err := transactor.injector.MaybeFail(PointRollbackEnter); err != nil {\n+\t\treturn err\n+\t}\n+\ttransactor.mutex.Lock()\n+\t_, ok := transactor.receipts[operationID]\n+\tfinalized := transactor.finalized[operationID]\n+\ttransactor.mutex.Unlock()\n+\tif !ok {\n+\t\treturn fmt.Errorf(\"secconftest: rollback without prepare for operation %q\", operationID)\n+\t}\n+\tif finalized {\n+\t\treturn fmt.Errorf(\"%w: operation %q\", ErrRollbackPastFinalize, operationID)\n+\t}\n+\t_ = os.Remove(filepath.Join(transactor.root, operationID+\".staged\"))\n+\t_ = os.Remove(filepath.Join(transactor.root, operationID+\".committed\"))\n+\treturn nil\n+}\n"}}}
