ged)\n240|\tif err := transactor.injector.MaybeFail(PointCommitApply); err != nil {\n241|\t\treturn Receipt{}, err\n242|\t}\n243|\treceipt.Outcome = OutcomeExplicitRollback\n244|\ttransactor.mutex.Lock()\n245|\ttransactor.receipts[operationID] = receipt\n246|\ttransactor.mutex.Unlock()\n247|\treturn receipt, nil\n248|}\n249|\n250|// Rollback removes staged and committed bytes for operationID. It\n251|// refuses to run past finalization: once Committed returns cleanly the\n252|// operation is terminal, and rollback is forbidden (AC-CLONE-005\n253|// shapes this rule; the model enforces it).\n254|func (transactor *Transactor) Rollback(operationID string) error {\n255|\tif err := transactor.injector.MaybeFail(PointRollbackEnter); err != nil {\n256|\t\treturn err\n257|\t}\n258|\ttransactor.mutex.Lock()\n259|\t_, ok := transactor.receipts[operationID]\n260|\ttransactor.mutex.Unlock()\n261|\tif !ok {\n262|\t\treturn fmt.Errorf(\"secconftest: rollback without prepare for operation %q\", operationID)\n263|\t}\n264|\t_ = os.Remove(filepath.Join(transactor.root, operationID+\".staged\"))\n265|\t_ = os.Remove(filepath.Join(transactor.root, operationID+\".committed\"))\n266|\treturn nil\n267|}\n268|\n269|// CommittedBytes reads back the committed bytes for operationID.\n270|func (transactor *Transactor) CommittedBytes(operationID string) ([]byte, error) {\n271|\treturn os.ReadFile(filepath.Join(transactor.root, operationID+\".committed\"))\n272|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c477","stream":{"kind":"session","id":"01a0779e-4d99-7252-aca0-901ba58a6e8d"},"sequence":150,"recorded_at":1780531400000295,"record_type":"event","durability":"durable","causation_id":"352ff598-ec69-42f2-8d2a-c94c81033676","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"352ff598-ec69-42f2-8d2a-c94c81033676","run_stream":{"kind":"run","id":"352ff598-ec69-42f2-8d2a-c94c81033676"},"call_id":"call_01a0779ea11a72e082a135873890f41e","text":"Read text file `internal/secconftest/skip.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"runtime\"\n8|\t\"sort\"\n9|\t\"strings\"\n10|\t\"sync\"\n11|\t\"testing\"\n12|)\n13|\n14|// Capability is one platform capability a test may need. Probe reports\n15|// whether it holds here and now; StrictGOOS lists the GOOS values\n16|// where absence is a failure rather than a skip. A skip asserts \"this\n17|// cannot run here\": the probe must really attempt the capability, and\n18|// an unexpected skip on a strict platform must fail rather than pass\n19|// quietly.\n20|type Capability struct {\n21|\t// ID is the stable slug naming the capability in reports.\n22|\tID string\n23|\t// Detail explains what the probe attempts.\n24|\tDetail string\n25|\t// Probe attempts the capability and reports availability.\n26|\tProbe func() (ok bool, reason string)\n27|\t// StrictGOOS names platforms where unavailability fails the test.\n28|\tStrictGOOS []string\n29|}\n30|\n31|// Verdict is the outcome of requiring one capability.\n32|type Verdict struct {\n33|\tID      string\n34|\tSkipped bool\n35|\tFailed  bool\n36|\tReason  string\n37|}\n38|\n39|// decision is the testable core of Require: pass, skip, or fail for a\n40|// probed capability. It carries no testing handle so the table test\n41|// can drive every arm, including the failing ones, without failing\n42|// the suite.\n43|type decision int\n44|\n45|const (\n46|\tdecisionPass decision = iota\n47|\tdecisionSkip\n48|\tdecisionFail\n49|)\n50|\n51|func decide(capability Capability, ok bool) decision {\n52|\tif capability.ID == \"\" || capability.Probe == nil {\n53|\t\treturn decisionFail\n54|\t}\n55|\tif ok {\n56|\t\treturn decisionPass\n57|\t}\n58|\tif strictOn(capability) {\n59|\t\treturn decisionFail\n60|\t}\n61|\treturn decisionSkip\n62|}\n63|\n64|// SymlinkCapability probes symlink creation and Lstat identification\n65|// in a fresh temporary directory. Symlink-escape commit tests require\n66|// it; Windows hosts without privilege report unavailable.\n67|func SymlinkCapability() Capability {\n68|\treturn Capability{\n69|\t\tID:     \"symlink\",\n70|\t\tDetail: \"create a symlink in a temp dir and identify it with Lstat\",\n71|\t\tProbe: func() (bool, string) {\n72|\t\t\tdir, err := os.MkdirTemp(\"\", \"secconftest-symlink\")\n73|\t\t\tif err != nil {\n74|\t\t\t\treturn false, fmt.Sprintf(\"temp dir: %v\", err)\n75|\t\t\t}\n76|\t\t\tdefer func() { _ = os.RemoveAll(dir) }()\n77|\t\t\ttarget := filepath.Join(dir, \"target\")\n78|\t\t\tlink := filepath.Join(dir, \"link\")\n79|\t\t\tif err := os.WriteFile(target, []byte(\"x\"), 0o600); err != nil {\n80|\t\t\t\treturn false, fmt.Sprintf(\"write target: %v\", err)\n81|\t\t\t}\n82|\t\t\tif err := os.Symlink(target, link); err != nil {\n83|\t\t\t\treturn false, fmt.Sprintf(\"symlink: %v\", err)\n84|\t\t\t}\n85|\t\t\tinfo, err := os.Lstat(link)\n86|\t\t\tif err != nil {\n87|\t\t\t\treturn false, fmt.Sprintf(\"lstat: %v\", err)\n88|\t\t\t}\n89|\t\t\tif info.Mode()&os.ModeSymlink == 0 {\n90|\t\t\t\treturn false, \"created link is not a symlink\"\n91|\t\t\t}\n92|\t\t\treturn true, \"symlink create+identify works\"\n93|\t\t},\n94|\t\tStrictGOOS: []string{\"linux\", \"darwin\"},\n95|\t}\n96|}\n97|\n98|// FifoCapability probes named-pipe creation. It is unavailable on\n99|// Windows by construction, so Windows is not strict: the special-file\n100|// gate there is covered by other means, stated on the callers.\n101|func FifoCapability() Capability {\n102|\treturn Capability{\n103|\t\tID:     \"fifo\",\n104|\t\tDetail: \"report named-pipe probe availability on this GOOS\",\n105|\t\tProbe: func() (bool, string) {\n106|\t\t\tif runtime.GOOS == \"windows\" {\n107|\t\t\t\treturn false, \"named pipes are not probed on Windows\"\n108|\t\t\t}\n109|\t\t\treturn true, \"non-Windows host: fifo fixtures build\"\n110|\t\t},\n111|\t\tStrictGOOS: []string{\"linux\", \"darwin\"},\n112|\t}\n113|}\n114|\n115|// ModeBitsCapability probes whether permission bits are enforceable:\n116|// it removes all permissions from a temp file and checks the open\n117|// fails. Root bypasses mode bits and Windows ACLs do not express\n118|// them, so neither is strict.\n119|func ModeBitsCapability() Capability {\n120|\treturn Capability{\n121|\t\tID:     \"mode-bits\",\n122|\t\tDetail: \"chmod 000 a temp file and require the open to fail\",\n123|\t\tProbe: func() (bool, string) {\n124|\t\t\tif runtime.GOOS == \"windows\" {\n125|\t\t\t\treturn false, \"Windows ACLs do not express mode bits\"\n126|\t\t\t}\n127|\t\t\tdir, err := os.MkdirTemp(\"\", \"secconftest-modebits\")\n128|\t\t\tif err != nil {\n129|\t\t\t\treturn false, fmt.Sprintf(\"temp dir: %v\", err)\n130|\t\t\t}\n131|\t\t\tdefer func() { _ = os.RemoveAll(dir) }()\n132|\t\t\tpath := filepath.Join(dir, \"guarded\")\n133|\t\t\tif err := os.WriteFile(path, []byte(\"x\"), 0o600); err != nil {\n134|\t\t\t\treturn false, fmt.Sprintf(\"write: %v\", err)\n135|\t\t\t}\n136|\t\t\tif err := os.Chmod(path, 0); err != nil {\n137|\t\t\t\treturn false, fmt.Sprintf(\"chmod: %v\", err)\n138|\t\t\t}\n139|\t\t\tfile, err := os.Open(path)\n140|\t\t\tif err != nil {\n141|\t\t\t\treturn true, \"mode bits enforced\"\n142|\t\t\t}\n143|\t\t\t_ = file.Close()\n144|\t\t\treturn false, \"open succeeded despite mode 000 (root or unenforceable bits)\"\n145|\t\t},\n146|\t}\n147|}\n148|\n149|// NonRootCapability probes that the suite does not run as superuser.\n150|// Permission-refusal vectors that need denial require it.\n151|func NonRootCapability() Capability {\n152|\treturn Capability{\n153|\t\tID:     \"nonroot\",\n154|\t\tDetail: \"require a non-privileged uid on unix\",\n155|\t\tProbe: func() (bool, string) {\n156|\t\t\tif runtime.GOOS == \"windows\" {\n157|\t\t\t\treturn true, \"Windows: no unix superuser\"\n158|\t\t\t}\n159|\t\t\tif os.Geteuid() == 0 {\n160|\t\t\t\treturn false, \"running as root: permission denials are untestable\"\n161|\t\t\t}\n162|\t\t\treturn true, \"non-root user\"\n163|\t\t},\n164|\t}\n165|}\n166|\n167|// DefaultCapabilities lists every capability this instrument probes.\n168|func DefaultCapabilities() []Capability {\n169|\treturn []Capability{SymlinkCapability(), FifoCapability(), ModeBitsCapability(), NonRootCapability()}\n170|}\n171|\n172|// strictOn reports whether id is strict on this host's GOOS.\n173|func strictOn(capability Capability) bool {\n174|\tfor _, goos := range capability.StrictGOOS {\n175|\t\tif goos == runtime.GOOS {\n176|\t\t\treturn true\n177|\t\t}\n178|\t}\n179|\treturn false\n180|}\n181|\n182|// report aggregates verdicts with a process-wide skip counter the\n183|// suite logs once, so the skip count on the host is evidence rather\n184|// than prose.\n185|var report struct {\n186|\tmutex   sync.Mutex\n187|\tskipped []string\n188|\tfailed  []string\n189|}\n190|\n191|func recordVerdict(verdict Verdict) {\n192|\treport.mutex.Lock()\n193|\tdefer report.mutex.Unlock()\n194|\tif verdict.Skipped {\n195|\t\treport.skipped = append(report.skipped, verdict.ID)\n196|\t}\n197|\tif verdict.Failed {\n198|\t\treport.failed = append(report.failed, verdict.ID)\n199|\t}\n200|}\n201|\n202|// SkippedIDs reports capability IDs skipped so far, sorted.\n203|func SkippedIDs() []string {\n204|\treport.mutex.Lock()\n205|\tdefer report.mutex.Unlock()\n206|\tout := append([]string(nil), report.skipped...)\n207|\tsort.Strings(out)\n208|\treturn out\n209|}\n210|\n211|// Require enforces one capability: it returns a passing verdict when\n212|// the probe holds, skips the test when the probe fails on a\n213|// non-strict platform, and fails the test when the probe fails on a\n214|// strict platform or the probe result contradicts a strict\n215|// expectation the caller states. Every skip and failure is recorded\n216|// for the final count.\n217|func Require(t *testing.T, capability Capability) Verdict {\n218|\tt.Helper()\n219|\tif capability.ID == \"\" || capability.Probe == nil {\n220|\t\tverdict := Verdict{ID: capability.ID, Failed: true, Reason: \"capability without identity or probe is unusable\"}\n221|\t\trecordVerdict(verdict)\n222|\t\tt.Fatalf(\"secconftest: capability %q has no identity or probe\", capability.ID)\n223|\t\treturn verdict\n224|\t}\n225|\tok, reason := capability.Probe()\n226|\tswitch decide(capability, ok) {\n227|\tcase decisionPass:\n228|\t\treturn Verdict{ID: capability.ID, Reason: reason}\n229|\tcase decisionFail:\n230|\t\tverdict := Verdict{ID: capability.ID, Failed: true, Reason: reason}\n231|\t\trecordVerdict(verdict)\n232|\t\tt.Fatalf(\"secconftest: capability %q unavailable on strict platform %s: %s\", capability.ID, runtime.GOOS, reason)\n233|\t\treturn verdict\n234|\tdefault:\n235|\t\tverdict := Verdict{ID: capability.ID, Skipped: true, Reason: reason}\n236|\t\trecordVerdict(verdict)\n237|\t\tt.Skipf(\"secconftest: capability %q unavailable here: %s\", capability.ID, reason)\n238|\t\treturn verdict\n239|\t}\n240|}\n241|\n242|// LogReport logs the capability skip/fail counts on this host. Call\n243|// it once per package suite so the skip count is attached evidence.\n244|// It never skips or fails: it reports.\n245|func LogReport(t *testing.T) {\n246|\tt.Helper()\n247|\treport.mutex.Lock()\n248|\tskipped := append([]string(nil), report.skipped...)\n249|\tfailed := append([]string(nil), report.failed...)\n250|\treport.mutex.Unlock()\n251|\tsort.Strings(skipped)\n252|\tsort.Strings(failed)\n253|\tt.Logf(\"secconftest capabilities on %s: skipped=%d %q failed=%d %q\",\n254|\t\truntime.GOOS, len(skipped), strings.Join(skipped, \",\"), len(failed), strings.Join(failed, \",\"))\n255|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c479","stream":{"kind":"session","id":"01a0779e-4d99-7252-aca0-901ba58a6e8d"},"sequence":151,"recorded_at":1780531400000297,"record_type":"event","durability":"durable","causation_id":"352ff598-ec69-42f2-8d2a-c94c81033676","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"352ff598-ec69-42f2-8d2a-c94c81033676","run_stream":{"kind":"run","id":"352ff598-ec69-42f2-8d2a-c94c81033676"},"call_id":"call_01a0779ea1ba7583b19754fd3e35330d","text":"Read text file `internal/secconftest/hostile.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"strings\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n8|)\n9|\n10|// HostileClass is one spec-derived hostile-input class: the exact\n11|// specification phrase it comes from, the section that phrase lives\n12|// in, and the production gate that decides its members.\n13|//\n14|// The roster is derived, not listed: TestHostileRosterQuotesResolve\n15|// requires every Quote to occur in its Section in the pinned document,\n16|// so a class added to or removed from the specification fails the\n17|// roster instead of passing silently. Members are generated from\n18|// Unicode tables and internal/scalar predicates, never from the\n19|// secprim tables under test, so deleting a gate arm keeps the corpus\n20|// and reddens the gate test instead of shrinking the witness with it.\n21|type HostileClass struct {\n22|\t// ID is the stable slug naming the class in test output.\n23|\tID string\n24|\t// Section is the AX specification section the Quote is drawn from.\n25|\tSection string\n26|\t// Quote is the exact specification phrase deriving this class.\n27|\tQuote string\n28|\t// Gate names the production entry point deciding the members.\n29|\tGate string\n30|}\n31|\n32|// Roster lists every hostile class this instrument drives.\n33|func Roster() []HostileClass {\n34|\treturn []HostileClass{\n35|\t\t{ID: \"path-traversal\", Section: \"16.3\", Quote: \"path traversal\", Gate: \"secprim.CheckMemberPath\"},\n36|\t\t{ID: \"path-absolute\", Section: \"16.3\", Quote: \"absolute paths\", Gate: \"secprim.CheckMemberPath\"},\n37|\t\t{ID: \"path-drive-unc\", Section: \"16.3\", Quote: \"drive/UNC injection\", Gate: \"secprim.CheckMemberPath\"},\n38|\t\t{ID: \"path-altstream\", Section: \"16.3\", Quote: \"alternate streams\", Gate: \"secprim.CheckMemberPath\"},\n39|\t\t{ID: \"path-encoded-separator\", Section: \"16.3\", Quote: \"repeatedly encoded separators\", Gate: \"secprim.CheckMemberPath\"},\n40|\t\t{ID: \"path-symlink-escape\", Section: \"16.3\", Quote: \"symlink/reparse escape during both validation and commit\", Gate: \"secprim.Guard.Open\"},\n41|\t\t{ID: \"path-case-collision\", Section: \"16.3\", Quote: \"case-fold collisions on case-insensitive destinations\", Gate: \"secprim.DetectCaseCollision\"},\n42|\t\t{ID: \"path-unmanaged\", Section: \"16.3\", Quote: \"replacement of unmanaged paths\", Gate: \"secprim.Guard.Resolve\"},\n43|\t\t{ID: \"path-device\", Section: \"16.3\", Quote: \"device/FIFO/socket creation\", Gate: \"secprim.CheckMemberPath\"},\n44|\t\t{ID: \"argv-vector\", Section: \"16.4\", Quote: \"Shell command construction from names, paths, provider output, or peer data is forbidden\", Gate: \"secprim.CheckArgv\"},\n45|\t\t{ID: \"env-allowlist\", Section: \"16.7\", Quote: \"minimal environment allowlists\", Gate: \"secprim.IsEnvName\"},\n46|\t\t{ID: \"render-ansi-osc\", Section: \"16.7\", Quote: \"ANSI/OSC sequences\", Gate: \"secprim.EscapeForTerminal\"},\n47|\t\t{ID: \"render-controls\", Section: \"16.7\", Quote: \"control characters\", Gate: \"secprim.EscapeForTerminal\"},\n48|\t\t{ID: \"render-bidi\", Section: \"16.7\", Quote: \"bidi overrides\", Gate: \"secprim.EscapeForTerminal\"},\n49|\t\t{ID: \"render-encoding\", Section: \"16.7\", Quote: \"invalid encodings\", Gate: \"secprim.EscapeForTerminal\"},\n50|\t\t{ID: \"render-width\", Section: \"16.7\", Quote: \"hostile-width graphemes\", Gate: \"secprim.EscapeForTerminal\"},\n51|\t\t{ID: \"redact-persisted\", Section: \"16.4\", Quote: \"redacted before persistence\", Gate: \"secprim.Redact\"},\n52|\t\t{ID: \"redact-credentials\", Section: \"16.2\", Quote: \"API keys, OAuth tokens\", Gate: \"secprim.Redact\"},\n53|\t}\n54|}\n55|\n56|// QuoteInSection reports whether quote occurs on at least one document\n57|// line inside section. The section check is load-bearing, not\n58|// ceremony: TestQuoteInSectionRejectsWrongSection drives a real quote\n59|// against a wrong section and requires refusal, so a mutant that\n60|// preserves the token match but drops the section check fails. The\n61|// mutant harness for that test executes the full behavioral hostile\n62|// battery, not only this checker.\n63|func QuoteInSection(document *specdoc.Document, quote, section string) error {\n64|\tif document == nil {\n65|\t\treturn fmt.Errorf(\"secconftest: nil specification document is never a legitimate absence\")\n66|\t}\n67|\tif strings.TrimSpace(quote) == \"\" {\n68|\t\treturn fmt.Errorf(\"secconftest: empty quote matches nothing\")\n69|\t}\n70|\tlines := document.QuoteLines(quote)\n71|\tif len(lines) == 0 {\n72|\t\treturn fmt.Errorf(\"secconftest: quote %q occurs nowhere in the pinned document\", quote)\n73|\t}\n74|\tfor _, line := range lines {\n75|\t\tif got, ok := document.SectionID(line); ok && got == section {\n76|\t\t\treturn nil\n77|\t\t}\n78|\t}\n79|\treturn fmt.Errorf(\"secconftest: quote %q occurs but never in section %s\", quote, section)\n80|}\n81|\n82|// bidiOverrideRunes enumerates the Section 16.7 bidi class from the\n83|// Unicode code chart, not from the gate under test: embeddings and\n84|// overrides U+202A-U+202E, isolates U+2066-U+2069, directional marks\n85|// U+200E, U+200F, U+061C, and zero-width U+200B-U+200D plus U+FEFF.\n86|// The static list is the point: a gate arm deleted with its test row\n87|// still faces every rune here.\n88|func bidiOverrideRunes() []rune {\n89|\treturn []rune{\n90|\t\t0x202a, 0x202b, 0x202c, 0x202d, 0x202e,\n91|\t\t0x2066, 0x2067, 0x2068, 0x2069,\n92|\t\t0x200e, 0x200f, 0x061c,\n93|\t\t0x200b, 0x200c, 0x200d,\n94|\t\t0xfeff,\n95|\t}\n96|}\n97|\n98|// Members generates the hostile inputs for a roster class ID. Every\n99|// member carries the class token (for example \"..\" for traversal):\n100|// the gates must refuse behavior, not merely match the token, and the\n101|// per-class gate tests assert refusal of every member, so a\n102|// token-preserving behavior change still reddens.\n103|func Members(id string) []string {\n104|\twrap := func(runes []rune) []string {\n105|\t\tmembers := make([]string, 0, len(runes))\n106|\t\tfor _, character := range runes {\n107|\t\t\tmembers = append(members, \"a\"+string(character)+\"b\")\n108|\t\t}\n109|\t\treturn members\n110|\t}\n111|\tswitch id {\n112|\tcase \"path-traversal\":\n113|\t\treturn []string{\"../evil\", \"a/../../evil\", \"..\", \"a/../b\", \"a/b/../../../../c\", \"....//evil\"}\n114|\tcase \"path-absolute\":\n115|\t\treturn []string{\"/etc/passwd\", \"/\", \"/a/b\"}\n116|\tcase \"path-drive-unc\":\n117|\t\treturn []string{\"C:/Windows\", \"C:relative\", \"d:foo\", \"//server/share\", `\\\\server\\share`}\n118|\tcase \"path-altstream\":\n119|\t\treturn []string{\"file:stream\", \"dir/file:ads\", \"file:$DATA\"}\n120|\tcase \"path-encoded-separator\":\n121|\t\treturn []string{\"a%2fb\", \"a%5cb\", \"a%252fb\", \"a%2F..%2Fb\", \"%2e%2e/evil\", \"a/%2e%2e/b\", \"%2E%2E\", \"a%c0%afb\", \"a%C0%AFb\"}\n122|\tcase \"path-case-collision\":\n123|\t\treturn []string{\"readme.md\", \"README.MD\", \"ReadMe.Md\", \"STAGING/MEMBER\", \"Staging/Member\"}\n124|\tcase \"path-unmanaged\":\n125|\t\treturn []string{\"outside-managed\", \"staging/other\", \"secret\"}\n126|\tcase \"path-device\":\n127|\t\treturn []string{\"NUL\", \"CON\", \"COM1\", \"LPT1.txt\", \"aux.log\", \"dir/PRN\", \"COM9\", \"nul\"}\n128|\tcase \"argv-vector\":\n129|\t\treturn []string{\"; rm -rf /\", \"$(evil)\", \"`evil`\", \"a|b\", \"a&&b\", \"a\\nb\", \"--flag=value with spaces\"}\n130|\tcase \"env-allowlist\":\n131|\t\treturn []string{\"\", \"0\", \"1ABC\", \"A-B\", \"A B\", \"A.B\", \"A/B\", \"A\\x00B\", strings.Repeat(\"A\", 129)}\n132|\tcase \"render-ansi-osc\":\n133|\t\treturn []string{\"a\\x1b[31mb\", \"a\\x1b[0mb\", \"a\\x1b]8;;https://evil\\x07b\", \"a\\x9bb\"}\n134|\tcase \"render-controls\":\n135|\t\t// C0 controls except newline and tab (which the gate keeps),\n136|\t\t// DEL, and C1 controls: the exact refused set the section\n137|\t\t// names as \"control characters\". Printable runes are not\n138|\t\t// hostile and are not members.\n139|\t\tvar runes []rune\n140|\t\tfor character := rune(0); character < 0x20; character++ {\n141|\t\t\tif character == '\\n' || character == '\\t' {\n142|\t\t\t\tcontinue\n143|\t\t\t}\n144|\t\t\trunes = append(runes, character)\n145|\t\t}\n146|\t\trunes = append(runes, 0x7f)\n147|\t\tfor character := rune(0x80); character < 0xa0; character++ {\n148|\t\t\trunes = append(runes, character)\n149|\t\t}\n150|\t\treturn wrap(runes)\n151|\tcase \"render-bidi\":\n152|\t\treturn wrap([]rune{0x202a, 0x202b, 0x202c, 0x202d, 0x202e, 0x2066, 0x2067, 0x2068, 0x2069})\n153|\tcase \"render-encoding\":\n154|\t\treturn []string{\"a\\xffb\", \"a\\xfeb\", \"\\xff\", \"\\xfe\", \"a\\xed\\xa0\\x80b\"}\n155|\tcase \"render-width\":\n156|\t\treturn wrap([]rune{0x200e, 0x200f, 0x061c, 0x200b, 0x200c, 0x200d, 0xfeff})\n157|\tcase \"redact-persisted\":\n158|\t\treturn []string{\n159|\t\t\t\"-----BEGIN RSA PRIVATE KEY-----\\nMIIB\\n-----END RSA PRIVATE KEY-----\",\n160|\t\t\t\"key without end -----BEGIN RSA PRIVATE KEY-----\\nMIIB\",\n161|\t\t\t\"https://deploy:s3cret@example.com/repo\",\n162|\t\t\t\"password=hunter2\",\n163|\t\t}\n164|\tcase \"redact-credentials\":\n165|\t\treturn []string{\n166|\t\t\t\"api_key=[REDACTED]\",\n167|\t\t\t\"authorization: Bearer [REDACTED]\",\n168|\t\t\t`\"token\": \"[REDACTED]\"`,\n169|\t\t\t\"cookie=sessionid=abc123\",\n170|\t\t\t\"subscription_token=st_live_42\",\n171|\t\t}\n172|\tdefault:\n173|\t\treturn nil\n174|\t}\n175|}\n176|\n177|// BidiRunes exposes the full bidi/zero-width rune list for gate tests\n178|// that must assert the enumerated set without retyping it.\n179|func BidiRunes() []rune {\n180|\treturn bidiOverrideRunes()\n181|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
