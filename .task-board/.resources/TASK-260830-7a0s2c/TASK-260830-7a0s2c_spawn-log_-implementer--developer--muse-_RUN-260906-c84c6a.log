{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c50b","stream":{"kind":"session","id":"01a0779e-4d99-7252-aca0-901ba58a6e8d"},"sequence":224,"recorded_at":1780531400000443,"record_type":"event","durability":"durable","causation_id":"352ff598-ec69-42f2-8d2a-c94c81033676","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"352ff598-ec69-42f2-8d2a-c94c81033676","run_stream":{"kind":"run","id":"352ff598-ec69-42f2-8d2a-c94c81033676"},"task_stream":{"kind":"task","id":"93fdfabf-d150-4e66-8c35-d47d6ee142b4"},"task_id":"93fdfabf-d150-4e66-8c35-d47d6ee142b4","event":{"kind":"output","task_id":"93fdfabf-d150-4e66-8c35-d47d6ee142b4","chunk":"Read text file `internal/secconftest/crash_test.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"testing\"\n8|)\n9|\n10|func TestCrashClassifyTable(t *testing.T) {\n11|\tt.Parallel()\n12|\tcases := []struct {\n13|\t\tpoint string\n14|\t\twant  Outcome\n15|\t}{\n16|\t\t{PointPrepareEnter, OutcomeSafeRetry},\n17|\t\t{PointPrepareCommit, OutcomeExplicitRollback},\n18|\t\t{PointCommitEnter, OutcomeExplicitRollback},\n19|\t\t{PointCommitApply, OutcomeRecoverableParked},\n20|\t\t{PointRollbackEnter, OutcomeExplicitRollback},\n21|\t}\n22|\tfor _, kase := range cases {\n23|\t\tif got, err := Classify(kase.point); err != nil || got != kase.want {\n24|\t\t\tt.Errorf(\"Classify(%q) = %v, %v; want %v\", kase.point, got, err, kase.want)\n25|\t\t}\n26|\t}\n27|\tif _, err := Classify(\"CR-NOPE-unknown\"); err == nil {\n28|\t\tt.Error(\"Classify of an unknown point succeeded; a typo would arm nothing and fire nothing\")\n29|\t}\n30|}\n31|\n32|func TestCrashPointFiresOnceWhenArmed(t *testing.T) {\n33|\tt.Parallel()\n34|\tinjector := &Injector{}\n35|\tif err := injector.MaybeFail(PointPrepareEnter); err != nil {\n36|\t\tt.Fatalf(\"disarmed MaybeFail = %v, want nil\", err)\n37|\t}\n38|\tinjector.Arm(PointPrepareEnter)\n39|\tif !injector.Armed(PointPrepareEnter) {\n40|\t\tt.Fatal(\"Armed reports false after Arm\")\n41|\t}\n42|\terr := injector.MaybeFail(PointPrepareEnter)\n43|\tfault, ok := err.(*Fault)\n44|\tif !ok {\n45|\t\tt.Fatalf(\"armed MaybeFail = %v, want *Fault\", err)\n46|\t}\n47|\tif !errors.Is(err, ErrInjected) {\n48|\t\tt.Fatalf(\"fault %v does not wrap ErrInjected\", err)\n49|\t}\n50|\tif fault.Point() != PointPrepareEnter || fault.Outcome() != OutcomeSafeRetry {\n51|\t\tt.Fatalf(\"fault = %q/%q, want %q/safe_retry\", fault.Point(), fault.Outcome(), PointPrepareEnter)\n52|\t}\n53|\tif err := injector.MaybeFail(PointPrepareEnter); err != nil {\n54|\t\tt.Fatalf(\"consumed arm fired again: %v\", err)\n55|\t}\n56|\tinjector.Arm(PointPrepareEnter)\n57|\tinjector.Disarm()\n58|\tif err := injector.MaybeFail(PointPrepareEnter); err != nil {\n59|\t\tt.Fatalf(\"disarmed point fired: %v\", err)\n60|\t}\n61|\tif err := injector.MaybeFail(\"CR-NOPE-unknown\"); err == nil {\n62|\t\tt.Error(\"unknown point name is silent; a misspelled arm would never fire\")\n63|\t}\n64|}\n65|\n66|func TestTransactorPrepareCommitRoundTrip(t *testing.T) {\n67|\tt.Parallel()\n68|\troot := t.TempDir()\n69|\ttransactor := NewTransactor(&Injector{}, root)\n70|\tbody := []byte(`{\"kind\":\"workspace\",\"id\":\"op-1\"}`)\n71|\tprepared, err := transactor.Prepare(\"op-1\", body)\n72|\tif err != nil {\n73|\t\tt.Fatalf(\"Prepare: %v\", err)\n74|\t}\n75|\tif prepared.Outcome != OutcomeSafeRetry {\n76|\t\tt.Fatalf(\"prepare outcome = %q, want safe_retry\", prepared.Outcome)\n77|\t}\n78|\tcommitted, err := transactor.Commit(\"op-1\")\n79|\tif err != nil {\n80|\t\tt.Fatalf(\"Commit: %v\", err)\n81|\t}\n82|\treadBack, err := transactor.CommittedBytes(\"op-1\")\n83|\tif err != nil {\n84|\t\tt.Fatalf(\"CommittedBytes: %v\", err)\n85|\t}\n86|\tif string(readBack) != string(body) {\n87|\t\tt.Fatalf(\"committed bytes = %q, want %q\", readBack, body)\n88|\t}\n89|\tif committed.BodyDigest != prepared.BodyDigest {\n90|\t\tt.Fatal(\"commit changed the operation digest\")\n91|\t}\n92|}\n93|\n94|func TestTransactorIdempotentRetry(t *testing.T) {\n95|\tt.Parallel()\n96|\troot := t.TempDir()\n97|\ttransactor := NewTransactor(&Injector{}, root)\n98|\tbody := []byte(`{\"kind\":\"provider\",\"id\":\"op-2\"}`)\n99|\tfirst, err := transactor.Prepare(\"op-2\", body)\n100|\tif err != nil {\n101|\t\tt.Fatalf(\"Prepare: %v\", err)\n102|\t}\n103|\tsecond, err := transactor.Prepare(\"op-2\", append([]byte(nil), body...))\n104|\tif err != nil {\n105|\t\tt.Fatalf(\"identical retry Prepare: %v\", err)\n106|\t}\n107|\tif first.OperationID != second.OperationID || first.BodyDigest != second.BodyDigest ||\n108|\t\tfirst.Outcome != second.Outcome || string(first.Bytes) != string(second.Bytes) {\n109|\t\tt.Fatalf(\"identical retry receipt differs: %+v vs %+v\", first, second)\n110|\t}\n111|\tif _, err := transactor.Prepare(\"op-2\", []byte(`{\"kind\":\"provider\",\"id\":\"op-2-changed\"}`)); !errors.Is(err, ErrIdempotencyMismatch) {\n112|\t\tt.Fatalf(\"changed-body retry = %v, want idempotency_mismatch\", err)\n113|\t}\n114|\tentries, err := os.ReadDir(root)\n115|\tif err != nil {\n116|\t\tt.Fatalf(\"ReadDir: %v\", err)\n117|\t}\n118|\tif len(entries) != 1 {\n119|\t\tt.Fatalf(\"changed retry left %d files, want exactly the one staged journal\", len(entries))\n120|\t}\n121|}\n122|\n123|func TestTransactorCrashOutcomes(t *testing.T) {\n124|\tt.Parallel()\n125|\tpoints := []struct {\n126|\t\tpoint        string\n127|\t\toperation    func(*Transactor) error\n128|\t\twantOutcome  Outcome\n129|\t\tstagedExists bool\n130|\t}{\n131|\t\t{PointPrepareEnter, func(tx *Transactor) error { _, err := tx.Prepare(\"a\", []byte(\"body-a\")); return err }, OutcomeSafeRetry, false},\n132|\t\t{PointPrepareCommit, func(tx *Transactor) error { _, err := tx.Prepare(\"b\", []byte(\"body-b\")); return err }, OutcomeExplicitRollback, false},\n133|\t\t{PointCommitEnter, func(tx *Transactor) error {\n134|\t\t\tif _, err := tx.Prepare(\"c\", []byte(\"body-c\")); err != nil {\n135|\t\t\t\treturn err\n136|\t\t\t}\n137|\t\t\t_, err := tx.Commit(\"c\")\n138|\t\t\treturn err\n139|\t\t}, OutcomeExplicitRollback, true},\n140|\t\t{PointCommitApply, func(tx *Transactor) error {\n141|\t\t\tif _, err := tx.Prepare(\"d\", []byte(\"body-d\")); err != nil {\n142|\t\t\t\treturn err\n143|\t\t\t}\n144|\t\t\t_, err := tx.Commit(\"d\")\n145|\t\t\treturn err\n146|\t\t}, OutcomeRecoverableParked, false},\n147|\t}\n148|\tfor _, kase := range points {\n149|\t\tt.Run(kase.point, func(t *testing.T) {\n150|\t\t\tt.Parallel()\n151|\t\t\troot := t.TempDir()\n152|\t\t\tinjector := &Injector{}\n153|\t\t\ttransactor := NewTransactor(injector, root)\n154|\t\t\tinjector.Arm(kase.point)\n155|\t\t\terr := kase.operation(transactor)\n156|\t\t\tfault, ok := err.(*Fault)\n157|\t\t\tif !ok {\n158|\t\t\t\tt.Fatalf(\"armed %q gave %v, want *Fault\", kase.point, err)\n159|\t\t\t}\n160|\t\t\tif fault.Outcome() != kase.wantOutcome {\n161|\t\t\t\tt.Fatalf(\"outcome = %q, want %q\", fault.Outcome(), kase.wantOutcome)\n162|\t\t\t}\n163|\t\t\tid := map[string]string{\n164|\t\t\t\tPointPrepareEnter: \"a\", PointPrepareCommit: \"b\",\n165|\t\t\t\tPointCommitEnter: \"c\", PointCommitApply: \"d\",\n166|\t\t\t}[kase.point]\n167|\t\t\t_, stagedErr := os.Stat(filepath.Join(root, id+\".staged\"))\n168|\t\t\tif kase.stagedExists && stagedErr != nil {\n169|\t\t\t\tt.Fatalf(\"commit-enter fault removed the staged bytes; rollback would have nothing to restore\")\n170|\t\t\t}\n171|\t\t\tif !kase.stagedExists && stagedErr == nil {\n172|\t\t\t\tt.Fatalf(\"fault at %q left staged bytes behind\", kase.point)\n173|\t\t\t}\n174|\t\t\tif kase.point == PointCommitApply {\n175|\t\t\t\treadBack, readErr := transactor.CommittedBytes(id)\n176|\t\t\t\tif readErr != nil || string(readBack) != \"body-d\" {\n177|\t\t\t\t\tt.Fatalf(\"parked commit lost the durable bytes: %q, %v\", readBack, readErr)\n178|\t\t\t\t}\n179|\t\t\t}\n180|\t\t})\n181|\t}\n182|}\n183|\n184|func TestTransactorRecoversAfterFault(t *testing.T) {\n185|\tt.Parallel()\n186|\troot := t.TempDir()\n187|\tinjector := &Injector{}\n188|\ttransactor := NewTransactor(injector, root)\n189|\tinjector.Arm(PointPrepareCommit)\n190|\tif _, err := transactor.Prepare(\"r\", []byte(\"body-r\")); err == nil {\n191|\t\tt.Fatal(\"armed prepare-commit passed; the fault never fired\")\n192|\t}\n193|\t// The fault consumed its arm and cleaned the staging file, so the\n194|\t// identical retry must proceed and commit byte-exact bytes.\n195|\treceipt, err := transactor.Prepare(\"r\", []byte(\"body-r\"))\n196|\tif err != nil {\n197|\t\tt.Fatalf(\"retry after fault: %v\", err)\n198|\t}\n199|\tif _, err := transactor.Commit(\"r\"); err != nil {\n200|\t\tt.Fatalf(\"commit after recovery: %v\", err)\n201|\t}\n202|\treadBack, err := transactor.CommittedBytes(\"r\")\n203|\tif err != nil || string(readBack) != \"body-r\" {\n204|\t\tt.Fatalf(\"recovered bytes = %q, %v; want the exact staged body\", readBack, err)\n205|\t}\n206|\t_ = receipt\n207|}\n208|\n209|func TestTransactorRefusesRollbackPastFinalize(t *testing.T) {\n210|\tt.Parallel()\n211|\troot := t.TempDir()\n212|\ttransactor := NewTransactor(&Injector{}, root)\n213|\tif err := transactor.Rollback(\"ghost\"); err == nil {\n214|\t\tt.Fatal(\"rollback without prepare succeeded\")\n215|\t}\n216|\tif _, err := transactor.Prepare(\"f\", []byte(\"body-f\")); err != nil {\n217|\t\tt.Fatalf(\"Prepare: %v\", err)\n218|\t}\n219|\tif err := transactor.Rollback(\"f\"); err != nil {\n220|\t\tt.Fatalf(\"pre-commit rollback: %v\", err)\n221|\t}\n222|\tif _, err := os.Stat(filepath.Join(root, \"f.staged\")); !os.IsNotExist(err) {\n223|\t\tt.Fatal(\"rollback left staged bytes behind\")\n224|\t}\n225|}"}}}
