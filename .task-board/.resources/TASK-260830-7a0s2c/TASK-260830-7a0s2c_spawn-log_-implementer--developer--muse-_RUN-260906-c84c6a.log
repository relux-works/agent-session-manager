 %v, want the without-prepare refusal\", err)\n+\t}\n+\tif _, err := os.Stat(filepath.Join(root, \"planted.committed\")); !os.IsNotExist(err) {\n+\t\tt.Fatal(\"refused commit left committed bytes behind\")\n+\t}\n+}\n","edit_facts":{"tool_name":"edit_file","path":"internal/secconftest/crash_test.go","added":21,"removed":11},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
