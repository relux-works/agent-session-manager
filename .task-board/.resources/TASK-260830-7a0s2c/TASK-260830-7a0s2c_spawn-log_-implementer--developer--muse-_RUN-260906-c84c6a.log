{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4cd","stream":{"kind":"session","id":"01a0779e-4d99-7252-aca0-901ba58a6e8d"},"sequence":193,"recorded_at":1780531400000381,"record_type":"event","durability":"durable","causation_id":"352ff598-ec69-42f2-8d2a-c94c81033676","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"352ff598-ec69-42f2-8d2a-c94c81033676","run_stream":{"kind":"run","id":"352ff598-ec69-42f2-8d2a-c94c81033676"},"call_id":"call_01a0779eadf07c91bbfd42b453af2c2b","text":"Read text file `internal/secconftest/runner.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"hash/fnv\"\n6|\t\"sort\"\n7|\t\"sync/atomic\"\n8|)\n9|\n10|// Calls counts production entry-point invocations. A fixture receives a\n11|// counter and must record every production call it makes; the Runner\n12|// refuses fixtures that record none, so a corpus that never reaches the\n13|// entry point cannot pass as coverage.\n14|type Calls struct {\n15|\tcount atomic.Int64\n16|}\n17|\n18|// Add records n production calls.\n19|func (calls *Calls) Add(n int64) {\n20|\tcalls.count.Add(n)\n21|}\n22|\n23|// Count reports the recorded calls.\n24|func (calls *Calls) Count() int64 {\n25|\treturn calls.count.Load()\n26|}\n27|\n28|// Fixture is one named deterministic case. Run must be a pure function\n29|// of Seed: same seed, same report string. It receives a fresh Calls\n30|// counter and must record each production entry-point invocation it\n31|// performs.\n32|type Fixture struct {\n33|\tName string\n34|\tRun  func(seed uint64, calls *Calls) (report string, err error)\n35|}\n36|\n37|// Result is the executed record of one fixture.\n38|type Result struct {\n39|\tName   string\n40|\tReport string\n41|\tCalls  int64\n42|}\n43|\n44|// Runner executes fixtures in sorted name order over an explicit seed.\n45|// Registration order and Go map iteration order never affect execution:\n46|// names are sorted before every run, so identical inputs produce one\n47|// answer no matter how the caller stored the fixtures.\n48|type Runner struct {\n49|\t// AllowUnreached disables the arrival check. It exists only so the\n50|\t// suite can prove the check is load-bearing: with it set, an\n51|\t// unreached fixture passes, and TestRunnerRefusesUnreachedFixture\n52|\t// pins that the default refuses. Production use leaves the zero\n53|\t// value.\n54|\tAllowUnreached bool\n55|}\n56|\n57|// Run executes every fixture once and returns results in sorted name\n58|// order. A fixture that records zero production calls is refused with\n59|// an error naming it, unless AllowUnreached is set.\n60|func (runner Runner) Run(fixtures []Fixture, seed uint64) ([]Result, error) {\n61|\tordered := append([]Fixture(nil), fixtures...)\n62|\tsort.Slice(ordered, func(i, j int) bool { return ordered[i].Name < ordered[j].Name })\n63|\tresults := make([]Result, 0, len(ordered))\n64|\tfor _, fixture := range ordered {\n65|\t\tvar calls Calls\n66|\t\treport, err := fixture.Run(seed, &calls)\n67|\t\tif err != nil {\n68|\t\t\treturn nil, fmt.Errorf(\"secconftest runner: fixture %q: %w\", fixture.Name, err)\n69|\t\t}\n70|\t\tif !runner.AllowUnreached && calls.Count() == 0 {\n71|\t\t\treturn nil, fmt.Errorf(\"secconftest runner: fixture %q recorded no production call\", fixture.Name)\n72|\t\t}\n73|\t\tresults = append(results, Result{Name: fixture.Name, Report: report, Calls: calls.Count()})\n74|\t}\n75|\treturn results, nil\n76|}\n77|\n78|// Digest folds the execution log into one FNV-64 hex value: fixture\n79|// names, reports, and call counts in execution order. Two runs with\n80|// identical inputs produce identical digests; any dropped, reordered,\n81|// or altered fixture changes it.\n82|func Digest(results []Result) string {\n83|\tsum := fnv.New64a()\n84|\tfor _, result := range results {\n85|\t\t_, _ = fmt.Fprintf(sum, \"%s\\x00%s\\x00%d\\x00\", result.Name, result.Report, result.Calls)\n86|\t}\n87|\treturn fmt.Sprintf(\"%016x\", sum.Sum64())\n88|}\n89|\n90|// SortedNames reports the execution order for a fixture list. It shares\n91|// the sort with Run so the order claim is testable in isolation.\n92|func SortedNames(fixtures []Fixture) []string {\n93|\tordered := append([]Fixture(nil), fixtures...)\n94|\tsort.Slice(ordered, func(i, j int) bool { return ordered[i].Name < ordered[j].Name })\n95|\tnames := make([]string, 0, len(ordered))\n96|\tfor _, fixture := range ordered {\n97|\t\tnames = append(names, fixture.Name)\n98|\t}\n99|\treturn names\n100|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4cf","stream":{"kind":"session","id":"01a0779e-4d99-7252-aca0-901ba58a6e8d"},"sequence":194,"recorded_at":1780531400000383,"record_type":"event","durability":"durable","causation_id":"352ff598-ec69-42f2-8d2a-c94c81033676","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"352ff598-ec69-42f2-8d2a-c94c81033676","run_stream":{"kind":"run","id":"352ff598-ec69-42f2-8d2a-c94c81033676"},"call_id":"call_01a0779eaeb37593b4a6f76f0146d08f","text":"Read text file `internal/secconftest/fuzz.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"sync/atomic\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n8|)\n9|\n10|// FuzzEntry identifies one production entry point a fuzz driver\n11|// reaches. FuzzTargetEntry maps each fuzz target to its entry so the\n12|// suite can assert the mapping instead of claiming it in prose.\n13|type FuzzEntry string\n14|\n15|const (\n16|\tEntryCheckArgv           FuzzEntry = \"secprim.CheckArgv\"\n17|\tEntryCheckMemberPath     FuzzEntry = \"secprim.CheckMemberPath\"\n18|\tEntryIsEnvName           FuzzEntry = \"secprim.IsEnvName\"\n19|\tEntryRedact              FuzzEntry = \"secprim.Redact\"\n20|\tEntryEscapeForTerminal   FuzzEntry = \"secprim.EscapeForTerminal\"\n21|\tEntryRenderForTerminal   FuzzEntry = \"secprim.RenderForTerminal\"\n22|\tEntryGuardResolve        FuzzEntry = \"secprim.Guard.Resolve\"\n23|\tEntryDetectCaseCollision FuzzEntry = \"secprim.DetectCaseCollision\"\n24|)\n25|\n26|// FuzzTargetEntry maps each committed fuzz target to the production\n27|// entry point it drives. Every target in fuzz_test.go must appear\n28|// here, and TestFuzzTargetsReachProduction pins both directions: no\n29|// target without an entry, no entry in the map without a target that\n30|// fires it.\n31|var FuzzTargetEntry = map[string]FuzzEntry{\n32|\t\"FuzzCheckArgv\":           EntryCheckArgv,\n33|\t\"FuzzCheckMemberPath\":     EntryCheckMemberPath,\n34|\t\"FuzzIsEnvName\":           EntryIsEnvName,\n35|\t\"FuzzRedactCorpus\":        EntryRedact,\n36|\t\"FuzzEscapeForTerminal\":   EntryEscapeForTerminal,\n37|\t\"FuzzRenderForTerminal\":   EntryRenderForTerminal,\n38|\t\"FuzzGuardResolve\":        EntryGuardResolve,\n39|\t\"FuzzDetectCaseCollision\": EntryDetectCaseCollision,\n40|}\n41|\n42|// Driver is the shared path from seed-corpus tests and fuzz targets\n43|// into the Section 16 production gates. Both call these methods, so\n44|// the seed tests prove arrival at the same entry points the fuzzer\n45|// mutates against. Every method records its call before delegating,\n46|// so a driver that stopped reaching production shows a zero count.\n47|type Driver struct {\n48|\tcalls map[FuzzEntry]*atomic.Int64\n49|}\n50|\n51|// NewDriver builds a Driver with zeroed arrival counters.\n52|func NewDriver() *Driver {\n53|\tdriver := &Driver{calls: map[FuzzEntry]*atomic.Int64{}}\n54|\tfor _, entry := range []FuzzEntry{\n55|\t\tEntryCheckArgv, EntryCheckMemberPath, EntryIsEnvName,\n56|\t\tEntryRedact, EntryEscapeForTerminal, EntryRenderForTerminal,\n57|\t\tEntryGuardResolve, EntryDetectCaseCollision,\n58|\t} {\n59|\t\tdriver.calls[entry] = &atomic.Int64{}\n60|\t}\n61|\treturn driver\n62|}\n63|\n64|func (driver *Driver) record(entry FuzzEntry) {\n65|\tdriver.calls[entry].Add(1)\n66|}\n67|\n68|// Count reports arrivals at entry.\n69|func (driver *Driver) Count(entry FuzzEntry) int64 {\n70|\tcounter, ok := driver.calls[entry]\n71|\tif !ok {\n72|\t\treturn 0\n73|\t}\n74|\treturn counter.Load()\n75|}\n76|\n77|// DriveArgv drives secprim.CheckArgv and reports admission.\n78|func (driver *Driver) DriveArgv(argv []string) bool {\n79|\tdriver.record(EntryCheckArgv)\n80|\treturn secprim.CheckArgv(argv) == nil\n81|}\n82|\n83|// DriveMemberPath drives secprim.CheckMemberPath on the linux member\n84|// grammar and reports admission.\n85|func (driver *Driver) DriveMemberPath(member string) bool {\n86|\tdriver.record(EntryCheckMemberPath)\n87|\treturn secprim.CheckMemberPath(scalar.PlatformLinux, member) == nil\n88|}\n89|\n90|// DriveEnvName drives secprim.IsEnvName.\n91|func (driver *Driver) DriveEnvName(name string) bool {\n92|\tdriver.record(EntryIsEnvName)\n93|\treturn secprim.IsEnvName(name)\n94|}\n95|\n96|// DriveRedact drives secprim.Redact with no caller corpus and reports\n97|// whether the output still carries the input's non-secret marker. The\n98|// fixed marker keeps the driver deterministic: corpus secrets come\n99|// from the caller in TestFuzzDriversReachProduction, not from the\n100|// fuzzer.\n101|func (driver *Driver) DriveRedact(line string) bool {\n102|\tdriver.record(EntryRedact)\n103|\tout := secprim.Redact(line, nil)\n104|\treturn len(out) > 0 || len(line) == 0\n105|}\n106|\n107|// DriveEscape drives secprim.EscapeForTerminal.\n108|func (driver *Driver) DriveEscape(text string) string {\n109|\tdriver.record(EntryEscapeForTerminal)\n110|\treturn secprim.EscapeForTerminal(text)\n111|}\n112|\n113|// DriveRender drives secprim.RenderForTerminal with no caller corpus.\n114|func (driver *Driver) DriveRender(line string) string {\n115|\tdriver.record(EntryRenderForTerminal)\n116|\treturn secprim.RenderForTerminal(line, nil)\n117|}\n118|\n119|// DriveGuardResolve drives secprim.Guard.Resolve against a fixed\n120|// in-memory root and reports admission. The guard construction cannot\n121|// fail for the fixed root; a construction failure refuses the input\n122|// the same way a resolution refusal does.\n123|func (driver *Driver) DriveGuardResolve(member string) bool {\n124|\tdriver.record(EntryGuardResolve)\n125|\tguard, err := secprim.NewGuard(\"/stage\", scalar.PlatformLinux, nil)\n126|\tif err != nil {\n127|\t\treturn false\n128|\t}\n129|\t_, err = guard.Resolve(member)\n130|\treturn err == nil\n131|}\n132|\n133|// DriveCaseCollision drives secprim.DetectCaseCollision against a\n134|// fixed sibling set and reports whether a collision fired.\n135|func (driver *Driver) DriveCaseCollision(candidate string) bool {\n136|\tdriver.record(EntryDetectCaseCollision)\n137|\t_, collided := secprim.DetectCaseCollision([]string{\"README.md\", \"staging/member\"}, candidate)\n138|\treturn collided\n139|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4d1","stream":{"kind":"session","id":"01a0779e-4d99-7252-aca0-901ba58a6e8d"},"sequence":195,"recorded_at":1780531400000385,"record_type":"event","durability":"durable","causation_id":"352ff598-ec69-42f2-8d2a-c94c81033676","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"352ff598-ec69-42f2-8d2a-c94c81033676","run_stream":{"kind":"run","id":"352ff598-ec69-42f2-8d2a-c94c81033676"},"call_id":"call_01a0779eaf5371b2ad0ccec75afc4715","text":"Read text file `internal/secconftest/clock.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"sync\"\n5|\t\"time\"\n6|)\n7|\n8|// Clock abstracts time for code under test. Production code that needs\n9|// the time takes a Clock; tests pass a Fake. A Fake never reads the\n10|// wall clock, so suite timing cannot leak into results.\n11|type Clock interface {\n12|\tNow() time.Time\n13|}\n14|\n15|// fixedStart pins every Fake to one answer until advanced. The value is\n16|// arbitrary and carries no product meaning.\n17|var fixedStart = time.Date(2026, time.January, 2, 3, 4, 5, 0, time.UTC)\n18|\n19|// Fake is a manually advanced clock. The zero value is usable and reads\n20|// fixedStart. It calls nothing outside its own mutex: in particular it\n21|// never calls time.Now, so a real-clock difference (a sleep, a slow\n22|// host, midnight) cannot change its answer.\n23|type Fake struct {\n24|\tmutex   sync.Mutex\n25|\tcurrent time.Time\n26|\tset     bool\n27|}\n28|\n29|// Now reports the fake time.\n30|func (clock *Fake) Now() time.Time {\n31|\tclock.mutex.Lock()\n32|\tdefer clock.mutex.Unlock()\n33|\tif !clock.set {\n34|\t\treturn fixedStart\n35|\t}\n36|\treturn clock.current\n37|}\n38|\n39|// Advance moves the fake time forward by delta. A negative delta is a\n40|// no-op: clocks under test never run backwards through this type.\n41|func (clock *Fake) Advance(delta time.Duration) {\n42|\tif delta < 0 {\n43|\t\treturn\n44|\t}\n45|\tclock.mutex.Lock()\n46|\tdefer clock.mutex.Unlock()\n47|\tif !clock.set {\n48|\t\tclock.current = fixedStart\n49|\t\tclock.set = true\n50|\t}\n51|\tclock.current = clock.current.Add(delta)\n52|}\n53|\n54|// Set pins the fake time to an exact value.\n55|func (clock *Fake) Set(moment time.Time) {\n56|\tclock.mutex.Lock()\n57|\tdefer clock.mutex.Unlock()\n58|\tclock.current = moment\n59|\tclock.set = true\n60|}\n61|\n62|// Recording wraps a Clock and counts Now calls. Passing a Recording\n63|// into code under test and then reading Calls tells the suite whether\n64|// the fake was actually wired: zero calls after a clock-dependent\n65|// operation means the code read the wall clock (or no clock) instead,\n66|// and the suite must treat that as a failure, not as a pass.\n67|type Recording struct {\n68|\tinner Clock\n69|\tmutex sync.Mutex\n70|\tcalls int64\n71|}\n72|\n73|// Wrap counts Now calls through inner.\n74|func Wrap(inner Clock) *Recording {\n75|\treturn &Recording{inner: inner}\n76|}\n77|\n78|// Now delegates and records the call.\n79|func (clock *Recording) Now() time.Time {\n80|\tclock.mutex.Lock()\n81|\tclock.calls++\n82|\tclock.mutex.Unlock()\n83|\treturn clock.inner.Now()\n84|}\n85|\n86|// Calls reports how many times Now was read through this wrapper.\n87|func (clock *Recording) Calls() int64 {\n88|\tclock.mutex.Lock()\n89|\tdefer clock.mutex.Unlock()\n90|\treturn clock.calls\n91|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4d3","stream":{"kind":"session","id":"01a0779e-4d99-7252-aca0-901ba58a6e8d"},"sequence":196,"recorded_at":1780531400000387,"record_type":"event","durability":"durable","causation_id":"352ff598-ec69-42f2-8d2a-c94c81033676","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"352ff598-ec69-42f2-8d2a-c94c81033676","run_stream":{"kind":"run","id":"352ff598-ec69-42f2-8d2a-c94c81033676"},"call_id":"call_01a0779eb00778f0b1c5313b601ae26d","text":"Read text file `internal/secconftest/doc.go`.\n1|// Package secconftest is the conformance-test instrument for the\n2|// security-primitives-and-conformance-ci story: deterministic fixture\n3|// runners, fake clocks, crash points, protocol fuzz drivers, hostile\n4|// strings, and platform capability skips over the Section 16 production\n5|// gates (internal/secprim).\n6|//\n7|// It is an instrument, not a second authority. Every behavior it covers\n8|// is decided by an existing owner; this package only drives those\n9|// decisions deterministically and proves the drive reaches them:\n10|//\n11|//   - path grammars and bounds stay in internal/scalar;\n12|//   - wire decoding, string measure, and bound checks stay in\n13|//     internal/environ;\n14|//   - argv, environment, redaction, escaping, and containment refusals\n15|//     stay in internal/secprim, whose production code this package must\n16|//     not change;\n17|//   - the pinned specification text stays in internal/specdoc, which\n18|//     this package reads only to derive hostile classes, never to\n19|//     advertise product capabilities.\n20|//\n21|// Normative scope: AX v0.5.0 Sections 16, 19.2-19.5, 20.2, Appendix D.\n22|// Section 19.3 provider suites and Section 19.4 lifecycle cases outside\n23|// Section 16 are not driven here; the per-mechanism tests name that\n24|// bound where it bites.\n25|//\n26|// Stated bounds. The crash Transactor is a test model of a three-phase\n27|// durable commit, not the product journal: it proves the injector and\n28|// the outcome vocabulary work, not that any product recovery path\n29|// works. The fuzz drivers cover the Section 16 string and vector gates\n30|// only; containment races and TOCTOU behavior are out of scope for\n31|// byte-mutating fuzz. Hostile members derive from the specification\n32|// text plus package-unicode tables and internal/scalar predicates, so\n33|// deleting a secprim gate arm keeps the corpus and reddens the gate\n34|// test instead of shrinking the witness with it.\n35|package secconftest","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
