{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c563","stream":{"kind":"session","id":"01a0779e-4d99-7252-aca0-901ba58a6e8d"},"sequence":268,"recorded_at":1780531400000531,"record_type":"event","durability":"durable","causation_id":"352ff598-ec69-42f2-8d2a-c94c81033676","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"352ff598-ec69-42f2-8d2a-c94c81033676","run_stream":{"kind":"run","id":"352ff598-ec69-42f2-8d2a-c94c81033676"},"call_id":"call_01a0779fd6a871d28ff1ef024545a391","text":"Read text file `internal/secconftest/fuzz_test.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|\t\"unicode/utf8\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n9|)\n10|\n11|var fuzzDriver = NewDriver()\n12|\n13|var fuzzSeeds = []string{\n14|\t\"\",\n15|\t\"a\",\n16|\t\"staging/member\",\n17|\t\"../evil\",\n18|\t\"/absolute\",\n19|\t\"C:/drive\",\n20|\t\"a%2fb\",\n21|\t\"file:stream\",\n22|\t\"NUL\",\n23|\t\"password=hunter2\",\n24|\t\"-----BEGIN RSA PRIVATE KEY-----\\nMIIB\\n-----END RSA PRIVATE KEY-----\",\n25|\t\"https://user:pass@example.com/x\",\n26|\t\"a\\x1b[31mb\",\n27|\t\"a\\u202eb\",\n28|\t\"a\\x00b\",\n29|\t\"a\\xffb\",\n30|\t\"; rm -rf /\",\n31|\t\"$(evil)\",\n32|\t\"AX_VALID_NAME\",\n33|\t\"1bad-name\",\n34|\tstrings.Repeat(\"A\", 129),\n35|\t\"readme.md\",\n36|}\n37|\n38|func TestFuzzDriversReachProduction(t *testing.T) {\n39|\tt.Parallel()\n40|\tdriver := NewDriver()\n41|\tfor _, seed := range fuzzSeeds {\n42|\t\tdriver.DriveArgv([]string{\"exe\", seed})\n43|\t\tdriver.DriveMemberPath(seed)\n44|\t\tdriver.DriveEnvName(seed)\n45|\t\tdriver.DriveRedact(seed)\n46|\t\tdriver.DriveEscape(seed)\n47|\t\tdriver.DriveRender(seed)\n48|\t\tdriver.DriveGuardResolve(seed)\n49|\t\tdriver.DriveCaseCollision(seed)\n50|\t}\n51|\tfor entry, want := range map[FuzzEntry]bool{\n52|\t\tEntryCheckArgv: true, EntryCheckMemberPath: true, EntryIsEnvName: true,\n53|\t\tEntryRedact: true, EntryEscapeForTerminal: true, EntryRenderForTerminal: true,\n54|\t\tEntryGuardResolve: true, EntryDetectCaseCollision: true,\n55|\t} {\n56|\t\tif !want {\n57|\t\t\tcontinue\n58|\t\t}\n59|\t\tif got := driver.Count(entry); got == 0 {\n60|\t\t\tt.Fatalf(\"no seed reached %s; the corpus cannot cover it\", entry)\n61|\t\t}\n62|\t\tt.Logf(\"entry %s arrivals: %d\", entry, driver.Count(entry))\n63|\t}\n64|\tif len(FuzzTargetEntry) != 8 {\n65|\t\tt.Fatalf(\"FuzzTargetEntry has %d targets, want the 8 committed Fuzz functions\", len(FuzzTargetEntry))\n66|\t}\n67|\tseen := map[FuzzEntry]bool{}\n68|\tfor target, entry := range FuzzTargetEntry {\n69|\t\tif !strings.HasPrefix(target, \"Fuzz\") || entry == \"\" {\n70|\t\t\tt.Fatalf(\"FuzzTargetEntry[%q] = %q is malformed\", target, entry)\n71|\t\t}\n72|\t\tseen[entry] = true\n73|\t}\n74|\tif len(seen) != 8 {\n75|\t\tt.Fatalf(\"FuzzTargetEntry covers %d distinct entries, want 8\", len(seen))\n76|\t}\n77|}\n78|\n79|func FuzzCheckArgv(f *testing.F) {\n80|\tfor _, seed := range fuzzSeeds {\n81|\t\tf.Add(seed)\n82|\t}\n83|\tf.Fuzz(func(t *testing.T, element string) {\n84|\t\tadmitted := fuzzDriver.DriveArgv([]string{\"exe\", element})\n85|\t\tif admitted && element == \"\" {\n86|\t\t\tt.Fatal(\"empty argv element admitted\")\n87|\t\t}\n88|\t\t// Single-gate agreement: NewCommand validates through the same\n89|\t\t// CheckArgv, so the two must agree on every input.\n90|\t\t_, err := secprim.NewCommand([]string{\"exe\", element})\n91|\t\tif admitted != (err == nil) {\n92|\t\t\tt.Fatalf(\"CheckArgv(%q)=%v disagrees with NewCommand err=%v\", element, admitted, err)\n93|\t\t}\n94|\t})\n95|}\n96|\n97|func FuzzCheckMemberPath(f *testing.F) {\n98|\tfor _, seed := range fuzzSeeds {\n99|\t\tf.Add(seed)\n100|\t}\n101|\tf.Fuzz(func(t *testing.T, member string) {\n102|\t\tadmitted := fuzzDriver.DriveMemberPath(member)\n103|\t\tif !admitted {\n104|\t\t\treturn\n105|\t\t}\n106|\t\t// Containment property: every admitted member resolves inside\n107|\t\t// the fixed root through the production Guard.Resolve.\n108|\t\tif !fuzzDriver.DriveGuardResolve(member) {\n109|\t\t\tt.Fatalf(\"member %q admitted by CheckMemberPath but refused by Guard.Resolve\", member)\n110|\t\t}\n111|\t})\n112|}\n113|\n114|func FuzzIsEnvName(f *testing.F) {\n115|\tfor _, seed := range fuzzSeeds {\n116|\t\tf.Add(seed)\n117|\t}\n118|\tf.Fuzz(func(t *testing.T, name string) {\n119|\t\tif !fuzzDriver.DriveEnvName(name) {\n120|\t\t\treturn\n121|\t\t}\n122|\t\t// An admitted name must build through the production allowlist\n123|\t\t// path: absent from the parent environment is skipped, never\n124|\t\t// failed.\n125|\t\tif _, err := secprim.BuildEnv([]string{name}, nil, func(string) (string, bool) { return \"\", false }); err != nil {\n126|\t\t\tt.Fatalf(\"admitted env name %q fails BuildEnv: %v\", name, err)\n127|\t\t}\n128|\t})\n129|}\n130|\n131|func FuzzRedactCorpus(f *testing.F) {\n132|\tfor _, seed := range fuzzSeeds {\n133|\t\tf.Add(seed)\n134|\t}\n135|\tf.Fuzz(func(t *testing.T, line string) {\n136|\t\tfuzzDriver.DriveRedact(line)\n137|\t\t// Idempotency the package documents: rescanning redacted text\n138|\t\t// changes nothing.\n139|\t\tonce := secprim.Redact(line, nil)\n140|\t\tif twice := secprim.Redact(once, nil); twice != once {\n141|\t\t\tt.Fatalf(\"Redact not idempotent on %q: %q then %q\", line, once, twice)\n142|\t\t}\n143|\t})\n144|}\n145|\n146|func FuzzEscapeForTerminal(f *testing.F) {\n147|\tfor _, seed := range fuzzSeeds {\n148|\t\tf.Add(seed)\n149|\t}\n150|\tf.Fuzz(func(t *testing.T, text string) {\n151|\t\tescaped := fuzzDriver.DriveEscape(text)\n152|\t\tassertTerminalInert(t, escaped)\n153|\t})\n154|}\n155|\n156|func FuzzRenderForTerminal(f *testing.F) {\n157|\tfor _, seed := range fuzzSeeds {\n158|\t\tf.Add(seed)\n159|\t}\n160|\tf.Fuzz(func(t *testing.T, line string) {\n161|\t\trendered := fuzzDriver.DriveRender(line)\n162|\t\t// Wiring property: Render is Redact then Escape, in that order,\n163|\t\t// so a secret containing an escape sequence is removed as a\n164|\t\t// secret rather than merely neutralized.\n165|\t\tif want := secprim.EscapeForTerminal(secprim.Redact(line, nil)); rendered != want {\n166|\t\t\tt.Fatalf(\"RenderForTerminal(%q) = %q, want Escape(Redact) = %q\", line, rendered, want)\n167|\t\t}\n168|\t\tassertTerminalInert(t, rendered)\n169|\t})\n170|}\n171|\n172|func FuzzGuardResolve(f *testing.F) {\n173|\tfor _, seed := range fuzzSeeds {\n174|\t\tf.Add(seed)\n175|\t}\n176|\tf.Fuzz(func(t *testing.T, member string) {\n177|\t\tif !fuzzDriver.DriveGuardResolve(member) {\n178|\t\t\treturn\n179|\t\t}\n180|\t\tguard, err := secprim.NewGuard(\"/stage\", \"linux\", nil)\n181|\t\tif err != nil {\n182|\t\t\tt.Fatalf(\"fixed guard construction: %v\", err)\n183|\t\t}\n184|\t\tresolved, err := guard.Resolve(member)\n185|\t\tif err != nil {\n186|\t\t\tt.Fatalf(\"DriveGuardResolve admitted %q but Resolve refuses: %v\", member, err)\n187|\t\t}\n188|\t\tif resolved != \"/stage/\"+member && !strings.HasPrefix(resolved, \"/stage/\") {\n189|\t\t\tt.Fatalf(\"Resolve(%q) = %q escapes the root\", member, resolved)\n190|\t\t}\n191|\t})\n192|}\n193|\n194|func FuzzDetectCaseCollision(f *testing.F) {\n195|\tfor _, seed := range fuzzSeeds {\n196|\t\tf.Add(seed)\n197|\t}\n198|\tf.Fuzz(func(t *testing.T, candidate string) {\n199|\t\tcollided := fuzzDriver.DriveCaseCollision(candidate)\n200|\t\tif !collided {\n201|\t\t\treturn\n202|\t\t}\n203|\t\t// A reported collision must fold-equal a listed sibling it is\n204|\t\t// not identical to.\n205|\t\tfor _, sibling := range []string{\"README.md\", \"staging/member\"} {\n206|\t\t\tif sibling != candidate && strings.EqualFold(sibling, candidate) {\n207|\t\t\t\treturn\n208|\t\t\t}\n209|\t\t}\n210|\t\tt.Fatalf(\"collision reported for %q with no fold-equal sibling\", candidate)\n211|\t})\n212|}\n213|\n214|func assertTerminalInert(t *testing.T, escaped string) {\n215|\tt.Helper()\n216|\tif !utf8.ValidString(escaped) {\n217|\t\tt.Fatalf(\"escaped output %q is not valid UTF-8\", escaped)\n218|\t}\n219|\tfor _, character := range escaped {\n220|\t\tswitch {\n221|\t\tcase character == '\\n' || character == '\\t':\n222|\t\tcase character < 0x20 || character == 0x7f || character >= 0x80 && character <= 0x9f:\n223|\t\t\tt.Fatalf(\"escaped output carries control %U\", character)\n224|\t\tcase character == 0x1b:\n225|\t\t\tt.Fatal(\"escaped output carries ESC\")\n226|\t\t}\n227|\t}\n228|\tfor _, refused := range BidiRunes() {\n229|\t\tif strings.ContainsRune(escaped, refused) {\n230|\t\t\tt.Fatalf(\"escaped output carries %U\", refused)\n231|\t\t}\n232|\t}\n233|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c565","stream":{"kind":"session","id":"01a0779e-4d99-7252-aca0-901ba58a6e8d"},"sequence":269,"recorded_at":1780531400000533,"record_type":"event","durability":"durable","causation_id":"352ff598-ec69-42f2-8d2a-c94c81033676","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"352ff598-ec69-42f2-8d2a-c94c81033676","run_stream":{"kind":"run","id":"352ff598-ec69-42f2-8d2a-c94c81033676"},"call_id":"call_01a0779fd75177f38cb4f155af6f257f","text":"Read text file `internal/secconftest/runner_test.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|)\n7|\n8|func TestRunnerExecutesInSortedOrder(t *testing.T) {\n9|\tt.Parallel()\n10|\tvar order []string\n11|\tfixtures := []Fixture{\n12|\t\t{Name: \"zeta\", Run: func(seed uint64, calls *Calls) (string, error) {\n13|\t\t\tcalls.Add(1)\n14|\t\t\torder = append(order, \"zeta\")\n15|\t\t\treturn \"z\", nil\n16|\t\t}},\n17|\t\t{Name: \"alpha\", Run: func(seed uint64, calls *Calls) (string, error) {\n18|\t\t\tcalls.Add(2)\n19|\t\t\torder = append(order, \"alpha\")\n20|\t\t\treturn \"a\", nil\n21|\t\t}},\n22|\t\t{Name: \"mid\", Run: func(seed uint64, calls *Calls) (string, error) {\n23|\t\t\tcalls.Add(3)\n24|\t\t\torder = append(order, \"mid\")\n25|\t\t\treturn \"m\", nil\n26|\t\t}},\n27|\t}\n28|\tvar runner Runner\n29|\tresults, err := runner.Run(fixtures, 7)\n30|\tif err != nil {\n31|\t\tt.Fatalf(\"Run: %v\", err)\n32|\t}\n33|\twant := []string{\"alpha\", \"mid\", \"zeta\"}\n34|\tgot := SortedNames(fixtures)\n35|\tif strings.Join(got, \",\") != strings.Join(want, \",\") {\n36|\t\tt.Fatalf(\"SortedNames = %v, want %v\", got, want)\n37|\t}\n38|\tif strings.Join(order, \",\") != strings.Join(want, \",\") {\n39|\t\tt.Fatalf(\"execution order = %v, want sorted %v\", order, want)\n40|\t}\n41|\tfor index, name := range want {\n42|\t\tif results[index].Name != name {\n43|\t\t\tt.Fatalf(\"results[%d].Name = %q, want %q\", index, results[index].Name, name)\n44|\t\t}\n45|\t}\n46|}\n47|\n48|func TestRunnerDigestIsDeterministic(t *testing.T) {\n49|\tt.Parallel()\n50|\tfixtures := []Fixture{\n51|\t\t{Name: \"b\", Run: func(seed uint64, calls *Calls) (string, error) {\n52|\t\t\tcalls.Add(1)\n53|\t\t\treturn \"report-b\", nil\n54|\t\t}},\n55|\t\t{Name: \"a\", Run: func(seed uint64, calls *Calls) (string, error) {\n56|\t\t\tcalls.Add(1)\n57|\t\t\treturn \"report-a\", nil\n58|\t\t}},\n59|\t}\n60|\tvar runner Runner\n61|\tfirst, err := runner.Run(fixtures, 99)\n62|\tif err != nil {\n63|\t\tt.Fatalf(\"Run: %v\", err)\n64|\t}\n65|\tsecond, err := runner.Run(fixtures, 99)\n66|\tif err != nil {\n67|\t\tt.Fatalf(\"Run: %v\", err)\n68|\t}\n69|\t// Registration order must not matter: reverse and rerun.\n70|\treversed := []Fixture{fixtures[1], fixtures[0]}\n71|\tthird, err := runner.Run(reversed, 99)\n72|\tif err != nil {\n73|\t\tt.Fatalf(\"Run: %v\", err)\n74|\t}\n75|\tif Digest(first) != Digest(second) || Digest(first) != Digest(third) {\n76|\t\tt.Fatalf(\"digest unstable: %q %q %q\", Digest(first), Digest(second), Digest(third))\n77|\t}\n78|\tt.Logf(\"deterministic digest: %s\", Digest(first))\n79|}\n80|\n81|func TestRunnerRefusesUnreachedFixture(t *testing.T) {\n82|\tt.Parallel()\n83|\tvar runner Runner\n84|\tfixtures := []Fixture{\n85|\t\t{Name: \"reached\", Run: func(seed uint64, calls *Calls) (string, error) {\n86|\t\t\tcalls.Add(1)\n87|\t\t\treturn \"ok\", nil\n88|\t\t}},\n89|\t\t{Name: \"unreached\", Run: func(seed uint64, calls *Calls) (string, error) {\n90|\t\t\treturn \"never touched production\", nil\n91|\t\t}},\n92|\t}\n93|\t_, err := runner.Run(fixtures, 1)\n94|\tif err == nil || !strings.Contains(err.Error(), `\"unreached\"`) {\n95|\t\tt.Fatalf(\"Run with an unreached fixture = %v, want an error naming it\", err)\n96|\t}\n97|}\n98|\n99|func TestRunnerAllowsUnreachedWhenOptedIn(t *testing.T) {\n100|\tt.Parallel()\n101|\trunner := Runner{AllowUnreached: true}\n102|\tfixtures := []Fixture{\n103|\t\t{Name: \"unreached\", Run: func(seed uint64, calls *Calls) (string, error) {\n104|\t\t\treturn \"opted in\", nil\n105|\t\t}},\n106|\t}\n107|\tresults, err := runner.Run(fixtures, 1)\n108|\tif err != nil {\n109|\t\tt.Fatalf(\"AllowUnreached Run: %v\", err)\n110|\t}\n111|\tif len(results) != 1 || results[0].Calls != 0 {\n112|\t\tt.Fatalf(\"AllowUnreached results = %+v, want one zero-call result\", results)\n113|\t}\n114|}\n115|\n116|func TestRunnerDigestCoversAllFixtures(t *testing.T) {\n117|\tt.Parallel()\n118|\tvar runner Runner\n119|\tfixtures := []Fixture{\n120|\t\t{Name: \"a\", Run: func(seed uint64, calls *Calls) (string, error) { calls.Add(1); return \"ra\", nil }},\n121|\t\t{Name: \"b\", Run: func(seed uint64, calls *Calls) (string, error) { calls.Add(1); return \"rb\", nil }},\n122|\t}\n123|\tfull, err := runner.Run(fixtures, 3)\n124|\tif err != nil {\n125|\t\tt.Fatalf(\"Run: %v\", err)\n126|\t}\n127|\tpartial, err := runner.Run(fixtures[:1], 3)\n128|\tif err != nil {\n129|\t\tt.Fatalf(\"Run: %v\", err)\n130|\t}\n131|\tif Digest(full) == Digest(partial) {\n132|\t\tt.Fatal(\"digest ignores a dropped fixture; the inventory is unwitnessed\")\n133|\t}\n134|\taltered := []Fixture{\n135|\t\t{Name: \"a\", Run: func(seed uint64, calls *Calls) (string, error) { calls.Add(1); return \"ra\", nil }},\n136|\t\t{Name: \"b\", Run: func(seed uint64, calls *Calls) (string, error) { calls.Add(9); return \"rb\", nil }},\n137|\t}\n138|\trerun, err := runner.Run(altered, 3)\n139|\tif err != nil {\n140|\t\tt.Fatalf(\"Run: %v\", err)\n141|\t}\n142|\tif Digest(full) == Digest(rerun) {\n143|\t\tt.Fatal(\"digest ignores a changed call count; the execution log is unwitnessed\")\n144|\t}\n145|}\n146|\n147|func TestRunnerPropagatesFixtureError(t *testing.T) {\n148|\tt.Parallel()\n149|\tvar runner Runner\n150|\tfixtures := []Fixture{\n151|\t\t{Name: \"broken\", Run: func(seed uint64, calls *Calls) (string, error) {\n152|\t\t\tcalls.Add(1)\n153|\t\t\treturn \"\", errTestSentinel\n154|\t\t}},\n155|\t}\n156|\t_, err := runner.Run(fixtures, 1)\n157|\tif err == nil || !strings.Contains(err.Error(), `\"broken\"`) {\n158|\t\tt.Fatalf(\"Run with a failing fixture = %v, want an error naming it\", err)\n159|\t}\n160|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c567","stream":{"kind":"session","id":"01a0779e-4d99-7252-aca0-901ba58a6e8d"},"sequence":270,"recorded_at":1780531400000535,"record_type":"event","durability":"durable","causation_id":"352ff598-ec69-42f2-8d2a-c94c81033676","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"352ff598-ec69-42f2-8d2a-c94c81033676","run_stream":{"kind":"run","id":"352ff598-ec69-42f2-8d2a-c94c81033676"},"call_id":"call_01a0779fd7fc79618ed8ef1577d924f9","text":"Read text file `internal/secconftest/clock_test.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"testing\"\n6|\t\"time\"\n7|)\n8|\n9|var errTestSentinel = errors.New(\"secconftest test sentinel\")\n10|\n11|func TestFakeClockStartsPinned(t *testing.T) {\n12|\tt.Parallel()\n13|\tfirst := &Fake{}\n14|\tsecond := &Fake{}\n15|\tif !first.Now().Equal(second.Now()) {\n16|\t\tt.Fatalf(\"two fresh fakes disagree: %v vs %v\", first.Now(), second.Now())\n17|\t}\n18|\tif first.Now().Location() != time.UTC {\n19|\t\tt.Fatalf(\"fake start location = %v, want UTC\", first.Now().Location())\n20|\t}\n21|}\n22|\n23|func TestFakeClockIgnoresRealTime(t *testing.T) {\n24|\tt.Parallel()\n25|\tclock := &Fake{}\n26|\tbefore := clock.Now()\n27|\twallBefore := time.Now()\n28|\ttime.Sleep(20 * time.Millisecond)\n29|\tif got := clock.Now(); !got.Equal(before) {\n30|\t\tt.Fatalf(\"fake advanced without Advance: %v -> %v\", before, got)\n31|\t}\n32|\tif !time.Now().After(wallBefore) {\n33|\t\tt.Fatal(\"wall clock did not advance; the test cannot tell fake from real\")\n34|\t}\n35|}\n36|\n37|func TestFakeAdvanceAndSet(t *testing.T) {\n38|\tt.Parallel()\n39|\tclock := &Fake{}\n40|\tstart := clock.Now()\n41|\tclock.Advance(90 * time.Second)\n42|\tif got := clock.Now().Sub(start); got != 90*time.Second {\n43|\t\tt.Fatalf(\"Advance(90s) moved %v\", got)\n44|\t}\n45|\tclock.Advance(-time.Hour)\n46|\tif got := clock.Now().Sub(start); got != 90*time.Second {\n47|\t\tt.Fatalf(\"negative Advance moved the clock to %v\", got)\n48|\t}\n49|\tpinned := time.Date(2030, time.May, 4, 12, 0, 0, 0, time.UTC)\n50|\tclock.Set(pinned)\n51|\tif got := clock.Now(); !got.Equal(pinned) {\n52|\t\tt.Fatalf(\"Set moved to %v, want %v\", got, pinned)\n53|\t}\n54|}\n55|\n56|func TestRecordingNoticesUnwiredClock(t *testing.T) {\n57|\tt.Parallel()\n58|\twired := Wrap(&Fake{})\n59|\t_ = wired.Now()\n60|\tif got := wired.Calls(); got != 1 {\n61|\t\tt.Fatalf(\"wired path recorded %d Now calls, want 1\", got)\n62|\t}\n63|\tunwired := Wrap(&Fake{})\n64|\t// The buggy path takes the clock and never reads it (wall clock or\n65|\t// no clock instead). The suite must notice the zero, not pass it.\n66|\tif got := unwired.Calls(); got != 0 {\n67|\t\tt.Fatalf(\"unwired path recorded %d Now calls, want the detectable 0\", got)\n68|\t}\n69|}\n70|\n71|func TestRecordingCountsConcurrentReads(t *testing.T) {\n72|\tt.Parallel()\n73|\trecording := Wrap(&Fake{})\n74|\tdone := make(chan struct{})\n75|\tfor range 8 {\n76|\t\tgo func() {\n77|\t\t\t_ = recording.Now()\n78|\t\t\tdone <- struct{}{}\n79|\t\t}()\n80|\t}\n81|\tfor range 8 {\n82|\t\t<-done\n83|\t}\n84|\tif got := recording.Calls(); got != 8 {\n85|\t\tt.Fatalf(\"concurrent Now calls recorded %d, want 8\", got)\n86|\t}\n87|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
