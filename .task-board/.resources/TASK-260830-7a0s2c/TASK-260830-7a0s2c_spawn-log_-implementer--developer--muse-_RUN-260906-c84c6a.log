{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c517","stream":{"kind":"session","id":"01a0779e-4d99-7252-aca0-901ba58a6e8d"},"sequence":230,"recorded_at":1780531400000455,"record_type":"event","durability":"durable","causation_id":"352ff598-ec69-42f2-8d2a-c94c81033676","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"352ff598-ec69-42f2-8d2a-c94c81033676","run_stream":{"kind":"run","id":"352ff598-ec69-42f2-8d2a-c94c81033676"},"call_id":"call_01a0779ec1547d73a6e5ba8476cf43eb","text":"Read text file `internal/secconftest/crash_test.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"testing\"\n8|)\n9|\n10|func TestCrashClassifyTable(t *testing.T) {\n11|\tt.Parallel()\n12|\tcases := []struct {\n13|\t\tpoint string\n14|\t\twant  Outcome\n15|\t}{\n16|\t\t{PointPrepareEnter, OutcomeSafeRetry},\n17|\t\t{PointPrepareCommit, OutcomeExplicitRollback},\n18|\t\t{PointCommitEnter, OutcomeExplicitRollback},\n19|\t\t{PointCommitApply, OutcomeRecoverableParked},\n20|\t\t{PointRollbackEnter, OutcomeExplicitRollback},\n21|\t}\n22|\tfor _, kase := range cases {\n23|\t\tif got, err := Classify(kase.point); err != nil || got != kase.want {\n24|\t\t\tt.Errorf(\"Classify(%q) = %v, %v; want %v\", kase.point, got, err, kase.want)\n25|\t\t}\n26|\t}\n27|\tif _, err := Classify(\"CR-NOPE-unknown\"); err == nil {\n28|\t\tt.Error(\"Classify of an unknown point succeeded; a typo would arm nothing and fire nothing\")\n29|\t}\n30|}\n31|\n32|func TestCrashPointFiresOnceWhenArmed(t *testing.T) {\n33|\tt.Parallel()\n34|\tinjector := &Injector{}\n35|\tif err := injector.MaybeFail(PointPrepareEnter); err != nil {\n36|\t\tt.Fatalf(\"disarmed MaybeFail = %v, want nil\", err)\n37|\t}\n38|\tinjector.Arm(PointPrepareEnter)\n39|\tif !injector.Armed(PointPrepareEnter) {\n40|\t\tt.Fatal(\"Armed reports false after Arm\")\n41|\t}\n42|\terr := injector.MaybeFail(PointPrepareEnter)\n43|\tfault, ok := err.(*Fault)\n44|\tif !ok {\n45|\t\tt.Fatalf(\"armed MaybeFail = %v, want *Fault\", err)\n46|\t}\n47|\tif !errors.Is(err, ErrInjected) {\n48|\t\tt.Fatalf(\"fault %v does not wrap ErrInjected\", err)\n49|\t}\n50|\tif fault.Point() != PointPrepareEnter || fault.Outcome() != OutcomeSafeRetry {\n51|\t\tt.Fatalf(\"fault = %q/%q, want %q/safe_retry\", fault.Point(), fault.Outcome(), PointPrepareEnter)\n52|\t}\n53|\tif err := injector.MaybeFail(PointPrepareEnter); err != nil {\n54|\t\tt.Fatalf(\"consumed arm fired again: %v\", err)\n55|\t}\n56|\tinjector.Arm(PointPrepareEnter)\n57|\tinjector.Disarm()\n58|\tif err := injector.MaybeFail(PointPrepareEnter); err != nil {\n59|\t\tt.Fatalf(\"disarmed point fired: %v\", err)\n60|\t}\n61|\tif err := injector.MaybeFail(\"CR-NOPE-unknown\"); err == nil {\n62|\t\tt.Error(\"unknown point name is silent; a misspelled arm would never fire\")\n63|\t}\n64|}\n65|\n66|func TestTransactorPrepareCommitRoundTrip(t *testing.T) {\n67|\tt.Parallel()\n68|\troot := t.TempDir()\n69|\ttransactor := NewTransactor(&Injector{}, root)\n70|\tbody := []byte(`{\"kind\":\"workspace\",\"id\":\"op-1\"}`)\n71|\tprepared, err := transactor.Prepare(\"op-1\", body)\n72|\tif err != nil {\n73|\t\tt.Fatalf(\"Prepare: %v\", err)\n74|\t}\n75|\tif prepared.Outcome != OutcomeSafeRetry {\n76|\t\tt.Fatalf(\"prepare outcome = %q, want safe_retry\", prepared.Outcome)\n77|\t}\n78|\tcommitted, err := transactor.Commit(\"op-1\")\n79|\tif err != nil {\n80|\t\tt.Fatalf(\"Commit: %v\", err)\n81|\t}\n82|\treadBack, err := transactor.CommittedBytes(\"op-1\")\n83|\tif err != nil {\n84|\t\tt.Fatalf(\"CommittedBytes: %v\", err)\n85|\t}\n86|\tif string(readBack) != string(body) {\n87|\t\tt.Fatalf(\"committed bytes = %q, want %q\", readBack, body)\n88|\t}\n89|\tif committed.BodyDigest != prepared.BodyDigest {\n90|\t\tt.Fatal(\"commit changed the operation digest\")\n91|\t}\n92|}\n93|\n94|func TestTransactorIdempotentRetry(t *testing.T) {\n95|\tt.Parallel()\n96|\troot := t.TempDir()\n97|\ttransactor := NewTransactor(&Injector{}, root)\n98|\tbody := []byte(`{\"kind\":\"provider\",\"id\":\"op-2\"}`)\n99|\tfirst, err := transactor.Prepare(\"op-2\", body)\n100|\tif err != nil {\n101|\t\tt.Fatalf(\"Prepare: %v\", err)\n102|\t}\n103|\tsecond, err := transactor.Prepare(\"op-2\", append([]byte(nil), body...))\n104|\tif err != nil {\n105|\t\tt.Fatalf(\"identical retry Prepare: %v\", err)\n106|\t}\n107|\tif first.OperationID != second.OperationID || first.BodyDigest != second.BodyDigest ||\n108|\t\tfirst.Outcome != second.Outcome || string(first.Bytes) != string(second.Bytes) {\n109|\t\tt.Fatalf(\"identical retry receipt differs: %+v vs %+v\", first, second)\n110|\t}\n111|\tif _, err := transactor.Prepare(\"op-2\", []byte(`{\"kind\":\"provider\",\"id\":\"op-2-changed\"}`)); !errors.Is(err, ErrIdempotencyMismatch) {\n112|\t\tt.Fatalf(\"changed-body retry = %v, want idempotency_mismatch\", err)\n113|\t}\n114|\tentries, err := os.ReadDir(root)\n115|\tif err != nil {\n116|\t\tt.Fatalf(\"ReadDir: %v\", err)\n117|\t}\n118|\tif len(entries) != 1 {\n119|\t\tt.Fatalf(\"changed retry left %d files, want exactly the one staged journal\", len(entries))\n120|\t}\n121|}\n122|\n123|func TestTransactorCrashOutcomes(t *testing.T) {\n124|\tt.Parallel()\n125|\tpoints := []struct {\n126|\t\tpoint        string\n127|\t\toperation    func(*Transactor) error\n128|\t\twantOutcome  Outcome\n129|\t\tstagedExists bool\n130|\t}{\n131|\t\t{PointPrepareEnter, func(tx *Transactor) error { _, err := tx.Prepare(\"a\", []byte(\"body-a\")); return err }, OutcomeSafeRetry, false},\n132|\t\t{PointPrepareCommit, func(tx *Transactor) error { _, err := tx.Prepare(\"b\", []byte(\"body-b\")); return err }, OutcomeExplicitRollback, false},\n133|\t\t{PointCommitEnter, func(tx *Transactor) error {\n134|\t\t\tif _, err := tx.Prepare(\"c\", []byte(\"body-c\")); err != nil {\n135|\t\t\t\treturn err\n136|\t\t\t}\n137|\t\t\t_, err := tx.Commit(\"c\")\n138|\t\t\treturn err\n139|\t\t}, OutcomeExplicitRollback, true},\n140|\t\t{PointCommitApply, func(tx *Transactor) error {\n141|\t\t\tif _, err := tx.Prepare(\"d\", []byte(\"body-d\")); err != nil {\n142|\t\t\t\treturn err\n143|\t\t\t}\n144|\t\t\t_, err := tx.Commit(\"d\")\n145|\t\t\treturn err\n146|\t\t}, OutcomeRecoverableParked, false},\n147|\t}\n148|\tfor _, kase := range points {\n149|\t\tt.Run(kase.point, func(t *testing.T) {\n150|\t\t\tt.Parallel()\n151|\t\t\troot := t.TempDir()\n152|\t\t\tinjector := &Injector{}\n153|\t\t\ttransactor := NewTransactor(injector, root)\n154|\t\t\tinjector.Arm(kase.point)\n155|\t\t\terr := kase.operation(transactor)\n156|\t\t\tfault, ok := err.(*Fault)\n157|\t\t\tif !ok {\n158|\t\t\t\tt.Fatalf(\"armed %q gave %v, want *Fault\", kase.point, err)\n159|\t\t\t}\n160|\t\t\tif fault.Outcome() != kase.wantOutcome {\n161|\t\t\t\tt.Fatalf(\"outcome = %q, want %q\", fault.Outcome(), kase.wantOutcome)\n162|\t\t\t}\n163|\t\t\tid := map[string]string{\n164|\t\t\t\tPointPrepareEnter: \"a\", PointPrepareCommit: \"b\",\n165|\t\t\t\tPointCommitEnter: \"c\", PointCommitApply: \"d\",\n166|\t\t\t}[kase.point]\n167|\t\t\t_, stagedErr := os.Stat(filepath.Join(root, id+\".staged\"))\n168|\t\t\tif kase.stagedExists && stagedErr != nil {\n169|\t\t\t\tt.Fatalf(\"commit-enter fault removed the staged bytes; rollback would have nothing to restore\")\n170|\t\t\t}\n171|\t\t\tif !kase.stagedExists && stagedErr == nil {\n172|\t\t\t\tt.Fatalf(\"fault at %q left staged bytes behind\", kase.point)\n173|\t\t\t}\n174|\t\t\tif kase.point == PointCommitApply {\n175|\t\t\t\treadBack, readErr := transactor.CommittedBytes(id)\n176|\t\t\t\tif readErr != nil || string(readBack) != \"body-d\" {\n177|\t\t\t\t\tt.Fatalf(\"parked commit lost the durable bytes: %q, %v\", readBack, readErr)\n178|\t\t\t\t}\n179|\t\t\t}\n180|\t\t})\n181|\t}\n182|}\n183|\n184|func TestTransactorRecoversAfterFault(t *testing.T) {\n185|\tt.Parallel()\n186|\troot := t.TempDir()\n187|\tinjector := &Injector{}\n188|\ttransactor := NewTransactor(injector, root)\n189|\tinjector.Arm(PointPrepareCommit)\n190|\tif _, err := transactor.Prepare(\"r\", []byte(\"body-r\")); err == nil {\n191|\t\tt.Fatal(\"armed prepare-commit passed; the fault never fired\")\n192|\t}\n193|\t// The fault consumed its arm and cleaned the staging file, so the\n194|\t// identical retry must proceed and commit byte-exact bytes.\n195|\treceipt, err := transactor.Prepare(\"r\", []byte(\"body-r\"))\n196|\tif err != nil {\n197|\t\tt.Fatalf(\"retry after fault: %v\", err)\n198|\t}\n199|\tif _, err := transactor.Commit(\"r\"); err != nil {\n200|\t\tt.Fatalf(\"commit after recovery: %v\", err)\n201|\t}\n202|\treadBack, err := transactor.CommittedBytes(\"r\")\n203|\tif err != nil || string(readBack) != \"body-r\" {\n204|\t\tt.Fatalf(\"recovered bytes = %q, %v; want the exact staged body\", readBack, err)\n205|\t}\n206|\t_ = receipt\n207|}\n208|\n209|func TestTransactorRefusesRollbackPastFinalize(t *testing.T) {\n210|\tt.Parallel()\n211|\troot := t.TempDir()\n212|\ttransactor := NewTransactor(&Injector{}, root)\n213|\tif err := transactor.Rollback(\"ghost\"); err == nil {\n214|\t\tt.Fatal(\"rollback without prepare succeeded\")\n215|\t}\n216|\tif _, err := transactor.Prepare(\"f\", []byte(\"body-f\")); err != nil {\n217|\t\tt.Fatalf(\"Prepare: %v\", err)\n218|\t}\n219|\tif err := transactor.Rollback(\"f\"); err != nil {\n220|\t\tt.Fatalf(\"pre-commit rollback: %v\", err)\n221|\t}\n222|\tif _, err := os.Stat(filepath.Join(root, \"f.staged\")); !os.IsNotExist(err) {\n223|\t\tt.Fatal(\"rollback left staged bytes behind\")\n224|\t}\n225|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c519","stream":{"kind":"session","id":"01a0779e-4d99-7252-aca0-901ba58a6e8d"},"sequence":231,"recorded_at":1780531400000457,"record_type":"event","durability":"durable","causation_id":"352ff598-ec69-42f2-8d2a-c94c81033676","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"352ff598-ec69-42f2-8d2a-c94c81033676","run_stream":{"kind":"run","id":"352ff598-ec69-42f2-8d2a-c94c81033676"},"call_id":"call_01a0779ec22f7e138079438098722db5","text":"Read text file `internal/secconftest/skip_test.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"runtime\"\n5|\t\"testing\"\n6|)\n7|\n8|func TestSkipDecideTable(t *testing.T) {\n9|\tt.Parallel()\n10|\tstrict := Capability{ID: \"strict-cap\", Probe: func() (bool, string) { return false, \"down\" }, StrictGOOS: []string{runtime.GOOS}}\n11|\tlax := Capability{ID: \"lax-cap\", Probe: func() (bool, string) { return false, \"down\" }, StrictGOOS: []string{\"plan9\"}}\n12|\tother := Capability{ID: \"other-cap\", Probe: func() (bool, string) { return false, \"down\" }}\n13|\tif got := decide(strict, true); got != decisionPass {\n14|\t\tt.Errorf(\"available strict capability decides %v, want pass\", got)\n15|\t}\n16|\tif got := decide(lax, true); got != decisionPass {\n17|\t\tt.Errorf(\"available lax capability decides %v, want pass\", got)\n18|\t}\n19|\tif got := decide(strict, false); got != decisionFail {\n20|\t\tt.Errorf(\"unavailable strict capability decides %v, want fail: an unexpected skip must not pass quietly\", got)\n21|\t}\n22|\tif got := decide(lax, false); got != decisionSkip {\n23|\t\tt.Errorf(\"unavailable lax capability decides %v, want skip\", got)\n24|\t}\n25|\tif got := decide(other, false); got != decisionSkip {\n26|\t\tt.Errorf(\"unavailable unlisted capability decides %v, want skip\", got)\n27|\t}\n28|\tif got := decide(Capability{}, false); got != decisionFail {\n29|\t\tt.Errorf(\"malformed capability decides %v, want fail\", got)\n30|\t}\n31|\tif got := decide(Capability{ID: \"no-probe\"}, false); got != decisionFail {\n32|\t\tt.Errorf(\"probeless capability decides %v, want fail\", got)\n33|\t}\n34|}\n35|\n36|func TestSkipDefaultProbesTerminate(t *testing.T) {\n37|\tt.Parallel()\n38|\tcapabilities := DefaultCapabilities()\n39|\tif len(capabilities) != 4 {\n40|\t\tt.Fatalf(\"DefaultCapabilities has %d entries, want 4\", len(capabilities))\n41|\t}\n42|\tseen := map[string]bool{}\n43|\tfor _, capability := range capabilities {\n44|\t\tif capability.ID == \"\" || capability.Probe == nil || capability.Detail == \"\" {\n45|\t\t\tt.Errorf(\"capability %+v is malformed\", capability)\n46|\t\t}\n47|\t\tif seen[capability.ID] {\n48|\t\t\tt.Errorf(\"duplicate capability %q\", capability.ID)\n49|\t\t}\n50|\t\tseen[capability.ID] = true\n51|\t\tok, reason := capability.Probe()\n52|\t\tif reason == \"\" {\n53|\t\t\tt.Errorf(\"capability %q probed without a reason\", capability.ID)\n54|\t\t}\n55|\t\tt.Logf(\"capability %q on %s: ok=%v (%s)\", capability.ID, runtime.GOOS, ok, reason)\n56|\t}\n57|}\n58|\n59|func TestSkipProbesAreDeterministic(t *testing.T) {\n60|\tt.Parallel()\n61|\tfor _, capability := range DefaultCapabilities() {\n62|\t\tfirst, _ := capability.Probe()\n63|\t\tsecond, _ := capability.Probe()\n64|\t\tif first != second {\n65|\t\t\tt.Errorf(\"capability %q probe flips: %v then %v\", capability.ID, first, second)\n66|\t\t}\n67|\t}\n68|}\n69|\n70|func TestSkipReportLogsHostCounts(t *testing.T) {\n71|\t// Not parallel: it reads the process-wide counters. It records\n72|\t// nothing itself: the counts come only from Require calls the\n73|\t// suite really made, so the number is evidence, not prose.\n74|\tLogReport(t)\n75|\tt.Logf(\"skipped IDs: %q\", SkippedIDs())\n76|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c51b","stream":{"kind":"session","id":"01a0779e-4d99-7252-aca0-901ba58a6e8d"},"sequence":232,"recorded_at":1780531400000459,"record_type":"event","durability":"durable","causation_id":"352ff598-ec69-42f2-8d2a-c94c81033676","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"352ff598-ec69-42f2-8d2a-c94c81033676","run_stream":{"kind":"run","id":"352ff598-ec69-42f2-8d2a-c94c81033676"},"call_id":"call_01a0779ec2f276e0866bb2ca85cdc7f8","text":"Read text file `internal/secconftest/hostile_test.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"io\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n14|)\n15|\n16|func TestHostileRosterQuotesResolve(t *testing.T) {\n17|\tt.Parallel()\n18|\tdocument, err := specdoc.Load()\n19|\tif err != nil {\n20|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n21|\t}\n22|\tfor _, class := range Roster() {\n23|\t\tif err := QuoteInSection(document, class.Quote, class.Section); err != nil {\n24|\t\t\tt.Errorf(\"class %q: %v\", class.ID, err)\n25|\t\t}\n26|\t}\n27|}\n28|\n29|func TestHostileRosterShape(t *testing.T) {\n30|\tt.Parallel()\n31|\troster := Roster()\n32|\tif len(roster) != 18 {\n33|\t\tt.Fatalf(\"roster has %d classes, want 18; a spec class added or lost must update this instrument deliberately\", len(roster))\n34|\t}\n35|\tseen := map[string]bool{}\n36|\tvar memberless []string\n37|\tfor _, class := range roster {\n38|\t\tif class.ID == \"\" || class.Section == \"\" || class.Quote == \"\" || class.Gate == \"\" {\n39|\t\t\tt.Errorf(\"class %+v has an empty field\", class)\n40|\t\t}\n41|\t\tif seen[class.ID] {\n42|\t\t\tt.Errorf(\"duplicate class ID %q\", class.ID)\n43|\t\t}\n44|\t\tseen[class.ID] = true\n45|\t\tswitch class.Section {\n46|\t\tcase \"16.2\", \"16.3\", \"16.4\", \"16.7\":\n47|\t\tdefault:\n48|\t\t\tt.Errorf(\"class %q section %q is outside the story scope\", class.ID, class.Section)\n49|\t\t}\n50|\t\tif Members(class.ID) == nil {\n51|\t\t\tmemberless = append(memberless, class.ID)\n52|\t\t}\n53|\t}\n54|\t// Exactly one class is an FS-behavior witness rather than a string\n55|\t// corpus: symlink escape at commit time needs a real symlink, which\n56|\t// Members cannot build. Its witness is\n57|\t// TestHostileSymlinkEscapeRefusedAtCommit, skip-gated on the\n58|\t// symlink capability.\n59|\tif strings.Join(memberless, \",\") != \"path-symlink-escape\" {\n60|\t\tt.Fatalf(\"memberless classes = %v, want exactly [path-symlink-escape]\", memberless)\n61|\t}\n62|}\n63|\n64|func TestQuoteInSectionRefusals(t *testing.T) {\n65|\tt.Parallel()\n66|\tdocument, err := specdoc.Load()\n67|\tif err != nil {\n68|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n69|\t}\n70|\tif err := QuoteInSection(document, \"path traversal\", \"16.7\"); err == nil {\n71|\t\tt.Error(\"a Section 16.3 quote accepted for 16.7; the section check is dead\")\n72|\t}\n73|\tif err := QuoteInSection(document, \"phrase that occurs nowhere in the document\", \"16.3\"); err == nil {\n74|\t\tt.Error(\"unknown quote accepted\")\n75|\t}\n76|\tif err := QuoteInSection(document, \"   \", \"16.3\"); err == nil {\n77|\t\tt.Error(\"empty quote accepted\")\n78|\t}\n79|\tif err := QuoteInSection(nil, \"path traversal\", \"16.3\"); err == nil {\n80|\t\tt.Error(\"nil document accepted as satisfied; a failed read is never an absence\")\n81|\t}\n82|}\n83|\n84|func TestHostileMemberCounts(t *testing.T) {\n85|\tt.Parallel()\n86|\twant := map[string]int{\n87|\t\t\"path-traversal\": 6, \"path-absolute\": 3, \"path-drive-unc\": 5,\n88|\t\t\"path-altstream\": 3, \"path-encoded-separator\": 9,\n89|\t\t\"path-case-collision\": 5, \"path-unmanaged\": 3, \"path-device\": 8,\n90|\t\t\"argv-vector\": 7, \"env-allowlist\": 9,\n91|\t\t\"render-ansi-osc\": 4, \"render-controls\": 63, \"render-bidi\": 9,\n92|\t\t\"render-encoding\": 5, \"render-width\": 7,\n93|\t\t\"redact-persisted\": 4, \"redact-credentials\": 5,\n94|\t}\n95|\tfor id, count := range want {\n96|\t\tif got := len(Members(id)); got != count {\n97|\t\t\tt.Errorf(\"Members(%q) has %d inputs, want %d\", id, got, count)\n98|\t\t}\n99|\t}\n100|\tif got := Members(\"no-such-class\"); got != nil {\n101|\t\tt.Fatalf(\"Members of an unknown class = %v, want nil\", got)\n102|\t}\n103|}\n104|\n105|func TestHostilePathMembersRefused(t *testing.T) {\n106|\tt.Parallel()\n107|\tlinux := []string{\"path-traversal\", \"path-absolute\", \"path-drive-unc\", \"path-encoded-separator\"}\n108|\tfor _, id := range linux {\n109|\t\tfor _, member := range Members(id) {\n110|\t\t\tif err := secprim.CheckMemberPath(scalar.PlatformLinux, member); err == nil {\n111|\t\t\t\tt.Errorf(\"linux admits hostile %q (%s)\", member, id)\n112|\t\t\t}\n113|\t\t}\n114|\t}\n115|\twindows := []string{\"path-altstream\", \"path-device\"}\n116|\tfor _, id := range windows {\n117|\t\tfor _, member := range Members(id) {\n118|\t\t\tif err := secprim.CheckMemberPath(scalar.PlatformWindows, member); err == nil {\n119|\t\t\t\tt.Errorf(\"windows admits hostile %q (%s)\", member, id)\n120|\t\t\t}\n121|\t\t}\n122|\t}\n123|}\n124|\n125|func TestHostileCaseCollisionMembersFire(t *testing.T) {\n126|\tt.Parallel()\n127|\tsiblings := []string{\"README.md\", \"staging/member\"}\n128|\tfor _, candidate := range Members(\"path-case-collision\") {\n129|\t\tif _, collided := secprim.DetectCaseCollision(siblings, candidate); !collided {\n130|\t\t\tt.Errorf(\"candidate %q reports no collision against %v\", candidate, siblings)\n131|\t\t}\n132|\t}\n133|\tif _, collided := secprim.DetectCaseCollision(siblings, \"unrelated-name\"); collided {\n134|\t\tt.Error(\"unrelated name collides; the gate over-matches\")\n135|\t}\n136|}\n137|\n138|func TestHostileUnmanagedMembersRefused(t *testing.T) {\n139|\tt.Parallel()\n140|\tguard, err := secprim.NewGuard(\"/stage\", scalar.PlatformLinux, []string{\"staging/member\"})\n141|\tif err != nil {\n142|\t\tt.Fatalf(\"NewGuard: %v\", err)\n143|\t}\n144|\tfor _, member := range Members(\"path-unmanaged\") {\n145|\t\tif _, err := guard.Resolve(member); err == nil {\n146|\t\t\tt.Errorf(\"unmanaged member %q resolved\", member)\n147|\t\t} else if !errors.Is(err, secprim.ErrUnsafePath) {\n148|\t\t\tt.Errorf(\"unmanaged member %q error %v does not wrap ErrUnsafePath\", member, err)\n149|\t\t}\n150|\t}\n151|\tif _, err := guard.Resolve(\"staging/member\"); err != nil {\n152|\t\tt.Errorf(\"managed member refused: %v\", err)\n153|\t}\n154|}\n155|\n156|func TestHostileArgvMembersStaySingleElements(t *testing.T) {\n157|\tt.Parallel()\n158|\tfor _, hostile := range Members(\"argv-vector\") {\n159|\t\tcommand, err := secprim.NewCommand([]string{\"exe\", hostile})\n160|\t\tif err != nil {\n161|\t\t\tt.Errorf(\"shell metacharacter vector %q refused as data: %v\", hostile, err)\n162|\t\t\tcontinue\n163|\t\t}\n164|\t\targv := command.Argv()\n165|\t\tif len(argv) != 2 || argv[1] != hostile {\n166|\t\t\tt.Errorf(\"vector %q did not survive as one element: %q\", hostile, argv)\n167|\t\t}\n168|\t}\n169|\trefused := [][]string{{}, {\"\"}, {\"exe\", \"\"}, {\"exe\", \"a\\x00b\"}, {\"exe\", \"a\\xffb\"}}\n170|\tfor _, argv := range refused {\n171|\t\tif err := secprim.CheckArgv(argv); err == nil {\n172|\t\t\tt.Errorf(\"CheckArgv(%q) admitted\", argv)\n173|\t\t} else if !errors.Is(err, secprim.ErrUnsafeArgv) {\n174|\t\t\tt.Errorf(\"CheckArgv(%q) error %v does not wrap ErrUnsafeArgv\", argv, err)\n175|\t\t}\n176|\t}\n177|}\n178|\n179|func TestHostileEnvNamesRefused(t *testing.T) {\n180|\tt.Parallel()\n181|\tfor _, name := range Members(\"env-allowlist\") {\n182|\t\tif secprim.IsEnvName(name) {\n183|\t\t\tt.Errorf(\"IsEnvName(%q) admitted\", name)\n184|\t\t}\n185|\t}\n186|\tif !secprim.IsEnvName(\"AX_FOO\") {\n187|\t\tt.Error(\"IsEnvName refuses a well-formed name; the gate over-matches\")\n188|\t}\n189|\tif _, err := secprim.BuildEnv([]string{\"AX_OK\"}, map[string]string{\"AX_OK\": \"x\"}, os.LookupEnv); err == nil {\n190|\t\tt.Error(\"BuildEnv admits a literal colliding with the allowlist\")\n191|\t}\n192|\tif _, err := secprim.BuildEnv([]string{\"AX_OK\"}, map[string]string{\"AX_BAD\": \"a\\x00b\"}, os.LookupEnv); err == nil {\n193|\t\tt.Error(\"BuildEnv admits a NUL value\")\n194|\t}\n195|}\n196|\n197|func TestHostileRenderMembersNeutralized(t *testing.T) {\n198|\tt.Parallel()\n199|\tfor _, id := range []string{\"render-ansi-osc\", \"render-controls\", \"render-bidi\", \"render-encoding\", \"render-width\"} {\n200|\t\tfor _, member := range Members(id) {\n201|\t\t\tescaped := secprim.EscapeForTerminal(member)\n202|\t\t\t// The output invariant every class serves: valid UTF-8,\n203|\t\t\t// no ESC, no refused control, no bidi/zero-width rune.\n204|\t\t\tassertTerminalInert(t, escaped)\n205|\t\t\tswitch id {\n206|\t\t\tcase \"render-encoding\":\n207|\t\t\t\t// Invalid bytes cannot survive, and the neutralized\n208|\t\t\t\t// replacement proves they were rewritten, not kept.\n209|\t\t\t\tif escaped == member {\n210|\t\t\t\t\tt.Errorf(\"class %s: member %q passes through unchanged\", id, member)\n211|\t\t\t\t}\n212|\t\t\tdefault:\n213|\t\t\t\t// Neutralization is visible, never a silent strip:\n214|\t\t\t\t// ESC becomes U+241B, every other refused rune\n215|\t\t\t\t// becomes U+FFFD.\n216|\t\t\t\tif strings.ContainsRune(member, 0x1b) && !strings.Contains(escaped, \"␛\") {\n217|\t\t\t\t\tt.Errorf(\"class %s: member %q lost its escape visibly\", id, member)\n218|\t\t\t\t}\n219|\t\t\t\tif !strings.ContainsRune(member, 0x1b) && !strings.Contains(escaped, \"�\") {\n220|\t\t\t\t\tt.Errorf(\"class %s: member %q shows no neutralization marker\", id, member)\n221|\t\t\t\t}\n222|\t\t\t}\n223|\t\t}\n224|\t}\n225|}\n226|\n227|func TestHostileRedactMembersScrubbed(t *testing.T) {\n228|\tt.Parallel()\n229|\tfor _, member := range Members(\"redact-persisted\") {\n230|\t\tredacted := secprim.Redact(member, nil)\n231|\t\tif strings.Contains(redacted, \"PRIVATE KEY-----\\n\") || strings.Contains(redacted, \"s3cret\") {\n232|\t\t\tt.Errorf(\"member %q survives redaction: %q\", member, redacted)\n233|\t\t}\n234|\t}\n235|\tfor _, member := range Members(\"redact-credentials\") {\n236|\t\tredacted := secprim.Redact(member, nil)\n237|\t\tif !strings.Contains(redacted, \"[redacted]\") {\n238|\t\t\tt.Errorf(\"credential member %q carries no redaction marker: %q\", member, redacted)\n239|\t\t}\n240|\t}\n241|\t// Caller-known corpus values are scrubbed verbatim, including when\n242|\t// the key shape is innocuous.\n243|\tconst secret = \"correct-horse-battery\"\n244|\tredacted := secprim.Redact(\" InnocuousKey=\"+secret+\" \", []string{secret})\n245|\tif strings.Contains(redacted, secret) {\n246|\t\tt.Fatalf(\"corpus secret survives: %q\", redacted)\n247|\t}\n248|}\n249|\n250|func TestHostileSymlinkEscapeRefusedAtCommit(t *testing.T) {\n251|\tt.Parallel()\n252|\tRequire(t, SymlinkCapability())\n253|\tbase := t.TempDir()\n254|\tstage := filepath.Join(base, \"stage\")\n255|\toutside := filepath.Join(base, \"outside\")\n256|\tif err := os.MkdirAll(stage, 0o700); err != nil {\n257|\t\tt.Fatal(err)\n258|\t}\n259|\tif err := os.MkdirAll(outside, 0o700); err != nil {\n260|\t\tt.Fatal(err)\n261|\t}\n262|\tif err := os.WriteFile(filepath.Join(outside, \"victim\"), []byte(\"OUTSIDE\"), 0o600); err != nil {\n263|\t\tt.Fatal(err)\n264|\t}\n265|\tif err := os.WriteFile(filepath.Join(stage, \"inside\"), []byte(\"INSIDE\"), 0o600); err != nil {\n266|\t\tt.Fatal(err)\n267|\t}\n268|\tif err := os.Symlink(outside, filepath.Join(stage, \"link\")); err != nil {\n269|\t\tt.Fatal(err)\n270|\t}\n271|\tguard, err := secprim.NewGuard(stage, scalar.PlatformLinux, nil)\n272|\tif err != nil {\n273|\t\tt.Fatal(err)\n274|\t}\n275|\troot, err := secprim.OpenNoFollowDir(stage)\n276|\tif err != nil {\n277|\t\tt.Fatal(err)\n278|\t}\n279|\tdefer func() { _ = root.Close() }()\n280|\tfile, err := guard.Open(root, \"link/victim\")\n281|\tif err == nil {\n282|\t\tcontents, _ := io.ReadAll(file)\n283|\t\t_ = file.Close()\n284|\t\tt.Fatalf(\"symlink escape committed; read %q outside the root\", contents)\n285|\t}\n286|\tif !errors.Is(err, secprim.ErrUnsafePath) {\n287|\t\tt.Fatalf(\"symlink escape error %v does not wrap ErrUnsafePath\", err)\n288|\t}\n289|\tinside, err := guard.Open(root, \"inside\")\n290|\tif err != nil {\n291|\t\tt.Fatalf(\"positive control refused: %v\", err)\n292|\t}\n293|\tcontents, err := io.ReadAll(inside)\n294|\t_ = inside.Close()\n295|\tif err != nil || string(contents) != \"INSIDE\" {\n296|\t\tt.Fatalf(\"positive control read %q, %v; want the staged bytes\", contents, err)\n297|\t}\n298|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
