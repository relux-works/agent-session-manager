tring()\\n100-\\t\\t}\\n101-\\t\\theader := rest[begin : begin+len(privateKeyBeginPrefix)+headerClose+len(\\\"-----\\\")]\\n102-\\t\\tif !strings.Contains(header, privateKeyBeginSuffix) {\\n103-\\t\\t\\trendered.WriteString(rest[:begin+len(header)])\\n104-\\t\\t\\trest = rest[begin+len(header):]\\n105-\\t\\t\\tcontinue\\n106-\\t\\t}\\n107-\\t\\tend := strings.Index(rest[begin+len(header):], privateKeyEndPrefix)\\n108-\\t\\tif end < 0 {\\n109-\\t\\t\\trendered.WriteString(rest[:begin])\\n110-\\t\\t\\trendered.WriteString(redactedPrivateKey)\\n111-\\t\\t\\treturn rendered.String()\\n112-\\t\\t}\\n113-\\t\\t// Same dashPrefix care for the END header close.\\n\",\n  \"original_output_bytes\": 1625,\n  \"original_output_tokens\": 407,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
