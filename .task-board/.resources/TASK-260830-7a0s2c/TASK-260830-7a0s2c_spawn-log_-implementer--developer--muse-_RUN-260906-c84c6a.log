{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cd2f","stream":{"kind":"session","id":"01a0779e-4d99-7252-aca0-901ba58a6e8d"},"sequence":1266,"recorded_at":1780531400002527,"record_type":"event","durability":"durable","causation_id":"352ff598-ec69-42f2-8d2a-c94c81033676","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"352ff598-ec69-42f2-8d2a-c94c81033676","run_stream":{"kind":"run","id":"352ff598-ec69-42f2-8d2a-c94c81033676"},"task_stream":{"kind":"task","id":"ee90366a-30c7-490c-85a0-02a5fdeca628"},"task_id":"ee90366a-30c7-490c-85a0-02a5fdeca628","event":{"kind":"output","task_id":"ee90366a-30c7-490c-85a0-02a5fdeca628","chunk":"edited\nchanged lines: lines 11-21\n--- original\n+++ updated\n@@\n-// makeFifo creates a named pipe at dir/name with mode 0600. Unix-only:\n-// Windows has no Mkfifo and its file carries the unavailable stub, so\n-// the fifo probe fails (and skips, since Windows is not strict)\n-// instead of pretending.\n-func makeFifo(dir, name string) (string, error) {\n-\tpath := filepath.Join(dir, name)\n-\tif err := syscall.Mkfifo(path, 0o600); err != nil {\n-\t\treturn \"\", fmt.Errorf(\"secconftest: mkfifo %q: %w\", path, err)\n-\t}\n-\treturn path, nil\n-}\n+// makeFifo creates a named pipe at dir/name with mode 0600. Unix-only:\n+// Windows has no Mkfifo and its file carries the unavailable stub, so\n+// the fifo probe fails (and skips, since Windows is not strict)\n+// instead of pretending.\n+func makeFifo(dir, name string) (string, error) {\n+\treturn fifoBuild(dir, name)\n+}\n+\n+// fifoBuild is the seam the probe-honesty test faults: it swaps in a\n+// failing build, drives FifoCapability().Probe(), and requires\n+// failure. A probe closure hardened to constant true ignores the\n+// fault and fails the test.\n+var fifoBuild = func(dir, name string) (string, error) {\n+\tpath := filepath.Join(dir, name)\n+\tif err := syscall.Mkfifo(path, 0o600); err != nil {\n+\t\treturn \"\", fmt.Errorf(\"secconftest: mkfifo %q: %w\", path, err)\n+\t}\n+\treturn path, nil\n+}\n"}}}
