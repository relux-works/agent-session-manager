{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4bb","stream":{"kind":"session","id":"01a0777b-0bfc-71c2-a449-63245f4fe13c"},"sequence":184,"recorded_at":1780531400000363,"record_type":"event","durability":"durable","causation_id":"32f7efe8-067d-4d98-a2af-fff5c474ce56","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"32f7efe8-067d-4d98-a2af-fff5c474ce56","run_stream":{"kind":"run","id":"32f7efe8-067d-4d98-a2af-fff5c474ce56"},"task_stream":{"kind":"task","id":"90c16549-274c-463d-8b33-702f152b0bb6"},"task_id":"90c16549-274c-463d-8b33-702f152b0bb6","event":{"kind":"output","task_id":"90c16549-274c-463d-8b33-702f152b0bb6","chunk":"{\n  \"chunk_id\": \"exec-9-1\",\n  \"command\": \"task-board q --help 2>&1 | head -n 80\",\n  \"description\": \"Show query syntax help\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Execute queries against the board using a compact DSL.\\n\\nOperations:\\n  get(ID)              Get a single element by ID\\n  activity(ID, ...)    Read bounded, cursor-paginated element activity\\n  list(filters...)     List elements with filters\\n  count(filters...)    Count elements matching filters\\n  summary()            Board overview (counts + active/blocked)\\n  plan(scope?)         Execution phases; scope=[ID,ID,...] plans the union of subtrees\\n  agents(stale=N?)     Agent dashboard\\n  models(agent?)       Available models for spawn\\n  project_config()     Full active project board runtime config (always local)\\n  project_config(view=spawn-preflight, role=ROLE, agent=PROVIDER?)\\n                       Narrow effective child-spawn policy for one target\\n  provider_limits()    Machine-scoped provider rate-limit state (always local)\\n  provider_limits(identity=KEY|all_identities=true)\\n                       Report one indexed provider identity, or every one\\n  whoami()             Current remote URL and active user (always local)\\n  schema()             Introspect the full operations/fields/presets contract\\n  schema(operation=NAME|mutation=NAME)\\n                       Return only one typed operation or mutation signature\\n\\nField projection:\\n  { id status assignee }     Select specific fields\\n  { overview }               Use a base preset (minimal, default, overview, full, progress, planning)\\n  { observability-task }     Use project observability presets (project, epic, story, task)\\n  (omitted)                  Defaults to { id name status }\\n\\nBatching:\\n  Separate multiple queries with semicolons; results preserve source order\\n\\nSpawn policy projection:\\n  Full project_config reports the effective spawn-policy-v2/v3 contract,\\n  authority, normalized provider and role-effective policy, and exact config\\n  provenance. V2 additionally reports its frozen compatibility snapshot and a\\n  copy-ready v3 migration object; this is read-only evidence and never edits\\n  task-board.config.json. Spawn-preflight returns only the selected role policy\\n  and its actionable migration warning.\\n\\nOutput format:\\n  --format json       Standard JSON (default)\\n  --format compact    Compact tabular output (~40% fewer tokens)\\n                      plan() switches to the super-compact planning shape:\\n                      flat waves of IDs, one-line critical path, id->status map\\n\\nExamples:\\n  task-board q 'schema()'\\n  task-board q 'get(TASK-260211-abc) { id status assignee }'\\n  task-board q 'activity(TASK-260211-abc, limit=25, order=descending, view=effective)'\\n  task-board q 'list(type=task, status=development) { overview }'\\n  task-board q 'count(type=task, status=done)'\\n  task-board q 'summary()'\\n  task-board q 'summary() { observability-project }'\\n  task-board q 'get(STORY-1) { observability-story }'\\n  task-board q 'models()'\\n  task-board q 'models(agent=claude)'\\n  task-board q 'project_config()'\\n  task-board q 'provider_limits()'\\n  task-board q 'project_config(view=spawn-preflight, role=developer, agent=codex)'\\n  task-board q 'schema(operation=project_config)'\\n  task-board q 'schema(mutation=set_status)'\\n  task-board q --format compact 'project_config(); models(agent=codex)'\\n  task-board q 'get(TASK-1) { status }; list(type=task) { id status }'\\n  task-board q --format compact 'list(type=task) { overview }'\\n  task-board q --format compact 'plan(EPIC-1, active=true)'\\n  task-board q 'plan(scope=[EPIC-1, STORY-2, TASK-3], mode=children)'\\n\\nUsage:\\n  task-board q <query> [flags]\\n\\nAliases:\\n  q, query\\n\\nFlags:\\n      --format string   Output format: \\\"json\\\" or \\\"compact\\\" (default \\\"json\\\")\\n  -h, --help            help for q\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n\",\n  \"original_output_bytes\": 3860,\n  \"original_output_tokens\": 965,\n  \"truncated\": false\n}"}}}
