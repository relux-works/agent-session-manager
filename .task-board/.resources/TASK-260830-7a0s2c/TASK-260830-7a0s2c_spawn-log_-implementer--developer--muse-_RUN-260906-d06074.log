{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca4d","stream":{"kind":"session","id":"01a0777b-0bfc-71c2-a449-63245f4fe13c"},"sequence":897,"recorded_at":1780531400001789,"record_type":"event","durability":"durable","causation_id":"32f7efe8-067d-4d98-a2af-fff5c474ce56","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"32f7efe8-067d-4d98-a2af-fff5c474ce56","run_stream":{"kind":"run","id":"32f7efe8-067d-4d98-a2af-fff5c474ce56"},"task_stream":{"kind":"task","id":"d3ba94c3-460f-49aa-8f30-14982646f5ef"},"task_id":"d3ba94c3-460f-49aa-8f30-14982646f5ef","event":{"kind":"output","task_id":"d3ba94c3-460f-49aa-8f30-14982646f5ef","chunk":"Read text file `internal/secprim/guard_root_test.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"io\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// TestGuardOpenRefusesForeignRootHandle is the C1 vector: the guard root\n13|// is one directory and the passed handle is another. The member exists\n14|// under the foreign handle, so without the handle-to-root binding the\n15|// commit walk would admit it and hand back foreign bytes. The refusal\n16|// carries the mismatch rule, not a generic handle shape, and the check\n17|// lives in shared Guard.Open code, so unix and Windows answer\n18|// identically: this file carries no build tag and runs on both.\n19|func TestGuardOpenRefusesForeignRootHandle(t *testing.T) {\n20|\tt.Parallel()\n21|\tbase := t.TempDir()\n22|\tstage := filepath.Join(base, \"stage\")\n23|\telsewhere := filepath.Join(base, \"elsewhere\")\n24|\tif err := os.MkdirAll(stage, 0o700); err != nil {\n25|\t\tt.Fatal(err)\n26|\t}\n27|\tif err := os.MkdirAll(elsewhere, 0o700); err != nil {\n28|\t\tt.Fatal(err)\n29|\t}\n30|\tif err := os.WriteFile(filepath.Join(elsewhere, \"secret\"), []byte(\"FOREIGN\"), 0o600); err != nil {\n31|\t\tt.Fatal(err)\n32|\t}\n33|\tguard, err := NewGuard(stage, scalar.PlatformLinux, nil)\n34|\tif err != nil {\n35|\t\tt.Fatal(err)\n36|\t}\n37|\tforeign, err := OpenNoFollowDir(elsewhere)\n38|\tif err != nil {\n39|\t\tt.Fatal(err)\n40|\t}\n41|\tdefer func() { _ = foreign.Close() }()\n42|\tfile, err := guard.Open(foreign, \"secret\")\n43|\tif err == nil {\n44|\t\tcontents, _ := io.ReadAll(file)\n45|\t\t_ = file.Close()\n46|\t\tt.Fatalf(\"foreign handle admitted; read %q outside the guard root\", contents)\n47|\t}\n48|\trequireRefusal(t, err, ErrUnsafePath, \"secprim unsafe path: guard root mismatch: secret\")\n49|}\n50|\n51|// TestGuardOpenAdmitsMatchedRootHandle is the positive control for the\n52|// binding: the handle opened on the guard root itself still commits.\n53|// It runs on every platform beside the refusal above, so a binding\n54|// that is too tight reddens here rather than passing silently.\n55|func TestGuardOpenAdmitsMatchedRootHandle(t *testing.T) {\n56|\tt.Parallel()\n57|\tstage := t.TempDir()\n58|\tif err := os.WriteFile(filepath.Join(stage, \"secret\"), []byte(\"inside\"), 0o600); err != nil {\n59|\t\tt.Fatal(err)\n60|\t}\n61|\tguard, err := NewGuard(stage, scalar.PlatformLinux, nil)\n62|\tif err != nil {\n63|\t\tt.Fatal(err)\n64|\t}\n65|\troot, err := OpenNoFollowDir(stage)\n66|\tif err != nil {\n67|\t\tt.Fatal(err)\n68|\t}\n69|\tdefer func() { _ = root.Close() }()\n70|\tfile, err := guard.Open(root, \"secret\")\n71|\tif err != nil {\n72|\t\tt.Fatalf(\"matched handle refused: %v\", err)\n73|\t}\n74|\tdefer func() { _ = file.Close() }()\n75|\tcontents, err := io.ReadAll(file)\n76|\tif err != nil {\n77|\t\tt.Fatal(err)\n78|\t}\n79|\tif string(contents) != \"inside\" {\n80|\t\tt.Fatalf(\"commit read %q, want the staged bytes\", contents)\n81|\t}\n82|}"}}}
