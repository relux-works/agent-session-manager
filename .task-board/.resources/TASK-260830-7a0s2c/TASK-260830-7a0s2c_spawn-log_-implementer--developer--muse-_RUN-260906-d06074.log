{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca51","stream":{"kind":"session","id":"01a0777b-0bfc-71c2-a449-63245f4fe13c"},"sequence":899,"recorded_at":1780531400001793,"record_type":"event","durability":"durable","causation_id":"32f7efe8-067d-4d98-a2af-fff5c474ce56","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"32f7efe8-067d-4d98-a2af-fff5c474ce56","run_stream":{"kind":"run","id":"32f7efe8-067d-4d98-a2af-fff5c474ce56"},"call_id":"call_01a0777d1e0e716387380b025ea105b5","text":"Read text file `internal/secprim/render_test.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|\t\"unicode/utf8\"\n7|)\n8|\n9|func TestEscapeForTerminal(t *testing.T) {\n10|\tt.Parallel()\n11|\tcases := []struct {\n12|\t\tname  string\n13|\t\tinput string\n14|\t\twant  string\n15|\t}{\n16|\t\t{\"plain\", \"hello world\", \"hello world\"},\n17|\t\t{\"newline kept\", \"a\\nb\", \"a\\nb\"},\n18|\t\t{\"tab kept\", \"a\\tb\", \"a\\tb\"},\n19|\t\t{\"csi neutralized\", \"\\x1b[31mred\\x1b[0m\", \"␛[31mred␛[0m\"},\n20|\t\t{\"osc neutralized\", \"\\x1b]8;;https://evil\\x07link\", \"␛]8;;https://evil�link\"},\n21|\t\t{\"bare esc\", \"a\\x1bb\", \"a␛b\"},\n22|\t\t{\"single byte csi\", \"a\\x9bb\", \"a�b\"},\n23|\t\t{\"c0 nul\", \"a\\x00b\", \"a�b\"},\n24|\t\t{\"c0 bell\", \"a\\x07b\", \"a�b\"},\n25|\t\t{\"c0 cr\", \"a\\rb\", \"a�b\"},\n26|\t\t{\"del\", \"a\\x7fb\", \"a�b\"},\n27|\t\t{\"c1\", \"a\\x80b\", \"a�b\"},\n28|\t\t{\"bidi override\", \"a\\u202eb\", \"a�b\"},\n29|\t\t{\"bidi embedding 202a\", \"a\\u202ab\", \"a�b\"},\n30|\t\t{\"bidi embedding 202b\", \"a\\u202bb\", \"a�b\"},\n31|\t\t{\"bidi pop 202c\", \"a\\u202cb\", \"a�b\"},\n32|\t\t{\"bidi override 202d\", \"a\\u202db\", \"a�b\"},\n33|\t\t{\"bidi isolate\", \"a\\u2066b\\u2067c\", \"a�b�c\"},\n34|\t\t{\"bidi isolate 2068\", \"a\\u2068b\", \"a�b\"},\n35|\t\t{\"bidi isolate 2069\", \"a\\u2069b\", \"a�b\"},\n36|\t\t{\"directional mark\", \"a\\u200fb\", \"a�b\"},\n37|\t\t{\"directional mark 200e\", \"a\\u200eb\", \"a�b\"},\n38|\t\t{\"directional isolate 061c\", \"a\\u061cb\", \"a�b\"},\n39|\t\t{\"zero width space\", \"a\\u200bb\", \"a�b\"},\n40|\t\t{\"zero width non-joiner\", \"a\\u200cb\", \"a�b\"},\n41|\t\t{\"zero width joiner\", \"a\\u200db\", \"a�b\"},\n42|\t\t{\"bom\", \"a\\ufeffb\", \"a�b\"},\n43|\t\t{\"invalid utf8\", \"a\\xffb\", \"a�b\"},\n44|\t\t{\"unicode kept\", \"ünïcodé 名前 privet\", \"ünïcodé 名前 privet\"},\n45|\t\t{\"symbol for escape kept\", \"a␛b\", \"a␛b\"},\n46|\t}\n47|\tfor _, kase := range cases {\n48|\t\tt.Run(kase.name, func(t *testing.T) {\n49|\t\t\tt.Parallel()\n50|\t\t\tif got := EscapeForTerminal(kase.input); got != kase.want {\n51|\t\t\t\tt.Fatalf(\"EscapeForTerminal(%q) = %q, want %q\", kase.input, got, kase.want)\n52|\t\t\t}\n53|\t\t})\n54|\t}\n55|}\n56|\n57|// TestEscapeForTerminalOutputBytes is the output invariant every refusal\n58|// class above serves: no ESC byte, no C0 byte except newline and tab, no\n59|// DEL, and valid UTF-8. It sweeps a hostile corpus so a dropped class\n60|// fails here even if its table row is deleted with it.\n61|//\n62|// The fed runes and the asserted runes are one slice: an assertion can\n63|// never outrun its feed again, so no enumerated code point is\n64|// unwitnessed the way U+202A-U+202D and U+2068-U+2069 once were.\n65|func TestEscapeForTerminalOutputBytes(t *testing.T) {\n66|\tt.Parallel()\n67|\t// Every invisible control EscapeForTerminal neutralizes: the five\n68|\t// bidi embeddings and overrides, the four isolates, the three\n69|\t// directional marks, the three zero-width characters, and the byte\n70|\t// order mark.\n71|\tforbidden := []rune{\n72|\t\t0x202a, 0x202b, 0x202c, 0x202d, 0x202e,\n73|\t\t0x2066, 0x2067, 0x2068, 0x2069,\n74|\t\t0x200e, 0x200f, 0x061c,\n75|\t\t0x200b, 0x200c, 0x200d,\n76|\t\t0xfeff,\n77|\t}\n78|\tvar corpus strings.Builder\n79|\tfor character := 0; character < 0xa0; character++ {\n80|\t\tcorpus.WriteRune(rune(character))\n81|\t}\n82|\tfor _, character := range forbidden {\n83|\t\tcorpus.WriteRune(character)\n84|\t}\n85|\tcorpus.WriteString(\"\\x1b[0m\\x1b]0;title\\x07\\x9b0m\\xff\\xfe\")\n86|\tescaped := EscapeForTerminal(corpus.String())\n87|\tif !utf8.ValidString(escaped) {\n88|\t\tt.Fatal(\"escaped output is not valid UTF-8\")\n89|\t}\n90|\tfor _, character := range escaped {\n91|\t\tswitch {\n92|\t\tcase character == '\\n' || character == '\\t':\n93|\t\tcase character < 0x20 || character == 0x7f || character >= 0x80 && character <= 0x9f:\n94|\t\t\tt.Fatalf(\"escaped output carries control %U\", character)\n95|\t\tcase character == 0x1b:\n96|\t\t\tt.Fatal(\"escaped output carries ESC\")\n97|\t\t}\n98|\t}\n99|\tfor _, refused := range forbidden {\n100|\t\tif strings.ContainsRune(escaped, refused) {\n101|\t\t\tt.Fatalf(\"escaped output carries %U\", refused)\n102|\t\t}\n103|\t}\n104|}\n105|\n106|// TestEscapeForTerminalIsIdempotent proves double-wiring a render path\n107|// cannot corrupt text: every emitted symbol is a fixed point.\n108|func TestEscapeForTerminalIsIdempotent(t *testing.T) {\n109|\tt.Parallel()\n110|\tinputs := []string{\n111|\t\t\"plain\", \"\\x1b[31mred\\x1b[0m\", \"a\\u202eb\\u200bc\", \"a\\x00b\\x7f\\x9b\", \"ünïcodé\",\n112|\t\t\"␛ already visible\", \"� already neutral\",\n113|\t}\n114|\tfor _, input := range inputs {\n115|\t\tonce := EscapeForTerminal(input)\n116|\t\tif twice := EscapeForTerminal(once); twice != once {\n117|\t\t\tt.Errorf(\"EscapeForTerminal is not idempotent on %q: %q then %q\", input, once, twice)\n118|\t\t}\n119|\t}\n120|}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
