{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c935","stream":{"kind":"session","id":"01a0777b-0bfc-71c2-a449-63245f4fe13c"},"sequence":757,"recorded_at":1780531400001509,"record_type":"event","durability":"durable","causation_id":"32f7efe8-067d-4d98-a2af-fff5c474ce56","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"32f7efe8-067d-4d98-a2af-fff5c474ce56","run_stream":{"kind":"run","id":"32f7efe8-067d-4d98-a2af-fff5c474ce56"},"task_stream":{"kind":"task","id":"05481f76-09cb-4cb9-9cc8-2f0ec751d291"},"task_id":"05481f76-09cb-4cb9-9cc8-2f0ec751d291","event":{"kind":"output","task_id":"05481f76-09cb-4cb9-9cc8-2f0ec751d291","chunk":"Read text file `internal/secprim/inventory_test.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"flag\"\n5|\t\"fmt\"\n6|\t\"go/ast\"\n7|\t\"go/parser\"\n8|\t\"go/token\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\t\"runtime\"\n12|\t\"sort\"\n13|\t\"strconv\"\n14|\t\"strings\"\n15|\t\"sync\"\n16|\t\"testing\"\n17|)\n18|\n19|// exercisedRefusalSites records the production file:line that constructed a\n20|// refusal, keyed with the rule it carried, for every instrumented refusal\n21|// constructor call made during the test run.\n22|var exercisedRefusalSites sync.Map // file:line -> rule\n23|\n24|func recordRefusalSite(rule string) {\n25|\tif _, file, line, ok := runtime.Caller(2); ok {\n26|\t\texercisedRefusalSites.Store(fmt.Sprintf(\"%s:%d\", filepath.Base(file), line), rule)\n27|\t}\n28|}\n29|\n30|func TestMain(main *testing.M) {\n31|\torigPath, origArgv, origEnv := failPath, failArgv, failEnv\n32|\tfailPath = func(rule, detail string) *Error {\n33|\t\terr := origPath(rule, detail)\n34|\t\trecordRefusalSite(\"path:\" + rule)\n35|\t\treturn err\n36|\t}\n37|\tfailArgv = func(rule, detail string) *Error {\n38|\t\terr := origArgv(rule, detail)\n39|\t\trecordRefusalSite(\"argv:\" + rule)\n40|\t\treturn err\n41|\t}\n42|\tfailEnv = func(rule, detail string) *Error {\n43|\t\terr := origEnv(rule, detail)\n44|\t\trecordRefusalSite(\"env:\" + rule)\n45|\t\treturn err\n46|\t}\n47|\tcode := main.Run()\n48|\tif code == 0 && fullPackageTestRun() {\n49|\t\tif failures := auditRefusalInventory(); len(failures) != 0 {\n50|\t\t\tfor _, failure := range failures {\n51|\t\t\t\tfmt.Fprintln(os.Stderr, failure)\n52|\t\t\t}\n53|\t\t\tcode = 1\n54|\t\t}\n55|\t}\n56|\tos.Exit(code)\n57|}\n58|\n59|func fullPackageTestRun() bool {\n60|\tselected := flag.Lookup(\"test.run\")\n61|\treturn selected == nil || selected.Value.String() == \"\"\n62|}\n63|\n64|// defensiveSites names derived refusal sites no public input can fire,\n65|// with the bound that keeps each honest. The member-containment conjunct\n66|// in Resolve is unreachable because the member grammar refuses every\n67|// parent segment before the prefix check runs; it stays as defense in\n68|// depth against a future grammar relaxation, and\n69|// TestGuardPrefixCheckIsLoadBearing proves the containment property over\n70|// a generated corpus, so a weakened grammar reddens there first. A\n71|// defensive entry that resolves to no derived site fails as stale.\n72|var defensiveSites = map[string]string{\n73|\t\"failPath:member containment\": \"unreachable while the member grammar refuses parent segments; pinned by TestGuardPrefixCheckIsLoadBearing\",\n74|}\n75|\n76|// platformExempt names rules that need not fire on one GOOS, keyed\n77|// file|constructor:rule. The key is rule-level, not site-level: every\n78|// \"open failed\" site in nofollow.go shares it. The post-check directory\n79|// open fails deterministically only where mode bits are enforceable: the\n80|// chmod vector in TestOpenNoFollowDirRefusesUnreadableDir is skipped on\n81|// Windows (ACLs do not express a mode-000 directory) and as root (which\n82|// bypasses mode bits), so on Windows the rule is exempt. An exemption\n83|// that resolves to no derived site fails as stale.\n84|var platformExempt = map[string]string{\n85|\t\"nofollow.go|failPath:open failed\": \"windows\",\n86|}\n87|\n88|// rootExempt names derived sites excused when the suite runs as root,\n89|// which bypasses the mode bits the chmod vector depends on. Same key\n90|// shape and staleness discipline as platformExempt; the audit below\n91|// checks both tables for orphans.\n92|var rootExempt = map[string]bool{\n93|\t\"nofollow.go|failPath:open failed\": true,\n94|}\n95|\n96|// siteKey renders the platform-exemption identity of a derived site: the\n97|// file basename plus the constructor and rule. Line numbers are left out\n98|// so edits above or below a site do not rename it.\n99|func siteKey(site, constructor string) string {\n100|\tfile := site\n(more lines below)"}}}
