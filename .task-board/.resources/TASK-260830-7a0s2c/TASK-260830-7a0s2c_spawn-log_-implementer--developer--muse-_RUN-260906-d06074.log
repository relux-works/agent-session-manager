{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c939","stream":{"kind":"session","id":"01a0777b-0bfc-71c2-a449-63245f4fe13c"},"sequence":759,"recorded_at":1780531400001513,"record_type":"event","durability":"durable","causation_id":"32f7efe8-067d-4d98-a2af-fff5c474ce56","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"32f7efe8-067d-4d98-a2af-fff5c474ce56","run_stream":{"kind":"run","id":"32f7efe8-067d-4d98-a2af-fff5c474ce56"},"task_stream":{"kind":"task","id":"4741e52c-689e-47b4-bdb5-45352e33e460"},"task_id":"4741e52c-689e-47b4-bdb5-45352e33e460","event":{"kind":"output","task_id":"4741e52c-689e-47b4-bdb5-45352e33e460","chunk":"Read text file `internal/secprim/priv_windows_test.go`.\n1|//go:build windows\n2|\n3|package secprim\n4|\n5|import (\n6|\t\"testing\"\n7|)\n8|\n9|// privilegedUser on Windows: mode-bit permission tests are skipped there\n10|// unconditionally (Windows ACLs do not express them), so this is inert.\n11|func privilegedUser() bool {\n12|\treturn false\n13|}\n14|\n15|// makeFifo on Windows: named-pipe fixtures are not built there (the\n16|// special-file subtest is skipped on Windows — see TestCheckRegularTarget),\n17|// so this stub skips instead of building.\n18|func makeFifo(t *testing.T, path string) {\n19|\tt.Helper()\n20|\tt.Skip(\"named-pipe fixtures are not built on Windows\")\n21|}"}}}
