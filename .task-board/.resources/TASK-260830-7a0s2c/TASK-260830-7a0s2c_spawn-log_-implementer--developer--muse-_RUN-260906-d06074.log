{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8fb","stream":{"kind":"session","id":"01a0777b-0bfc-71c2-a449-63245f4fe13c"},"sequence":728,"recorded_at":1780531400001451,"record_type":"event","durability":"durable","causation_id":"32f7efe8-067d-4d98-a2af-fff5c474ce56","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"32f7efe8-067d-4d98-a2af-fff5c474ce56","run_stream":{"kind":"run","id":"32f7efe8-067d-4d98-a2af-fff5c474ce56"},"call_id":"call_01a0777c9ee77e12910b956385758ae3","text":"Read text file `internal/specdoc/specdoc.go`.\n1|// Package specdoc exposes the exact pinned upstream AX specification document\n2|// to repository fidelity gates.\n3|//\n4|// The upstream specification remains normative. The embedded copy is a\n5|// verification input only: it is accepted solely when its SHA-256 equals the\n6|// document digest already pinned in internal/specpin, so a substituted,\n7|// truncated, edited, or partially read document is refused instead of being\n8|// silently compared against. Nothing here advertises runtime capabilities or\n9|// mutates durable state.\n10|//\n11|// The package exists so that enumeration artifacts and ownership claims can be\n12|// compared against the specification text itself rather than against the\n13|// implementation those artifacts are supposed to constrain. Only repository\n14|// gates import it: the test binaries that check enumeration artifacts, and\n15|// internal/traceability, which measures the normative clause inventory of a\n16|// bound section from this document. The embedded document never reaches the ax\n17|// command, and TestEmbeddedDocumentNeverReachesAProductBinary enforces that\n18|// from the module import graph rather than leaving it as a comment: only\n19|// tracecheck, the ownership gate, may reach this package from a main package.\n20|package specdoc\n21|\n22|import (\n23|\t\"bytes\"\n24|\t\"crypto/sha256\"\n25|\t_ \"embed\"\n26|\t\"encoding/hex\"\n27|\t\"errors\"\n28|\t\"fmt\"\n29|\t\"regexp\"\n30|\t\"strings\"\n31|\n32|\t\"github.com/relux-works/agent-session-manager/internal/specpin\"\n33|)\n34|\n35|//go:embed SPEC.md\n36|var embedded []byte\n37|\n38|// ErrDocumentMismatch reports an absent, empty, or non-pinned document. A\n39|// failed or partial read is reported as a mismatch, never as an absence that\n40|// some caller could treat as satisfied.\n41|var ErrDocumentMismatch = errors.New(\"pinned specification document mismatch\")\n42|\n43|// Document is a verified pinned specification together with the single\n44|// whitespace-normalized projection used for excerpt comparison, an index from\n45|// normalized offsets back to 1-based SPEC.md line numbers, and an index of the\n46|// document's Markdown tables.\n47|//\n48|// The projection collapses each run of ASCII whitespace to one space, except at\n49|// a hard boundary, where it collapses to BlockSeparator instead. A normalized\n50|// excerpt can never contain BlockSeparator, so a quote cannot be satisfied by\n51|// stitching text across such a boundary. Two kinds of boundary are hard:\n52|//\n53|//   - a blank line, which separates a paragraph from the paragraph after it and\n54|//     a heading from its body;\n55|//   - the newline between two adjacent Markdown table rows, because a table row\n56|//     is a complete line by construction, so no honest excerpt spans two of\n57|//     them, while a stitched one silently imports the next row's constraint.\n58|//\n59|// Hard line wrapping and table indentation inside one block are still forgiven,\n60|// as is the newline between two adjacent list items or between two adjacent\n61|// lines of one paragraph.\n62|type Document struct {\n63|\traw            []byte\n64|\tlines          []string\n65|\tnormalized     string\n66|\tlineOf         []int\n67|\tsectionOfLine  []string\n68|\ttableRowOfLine []TableRow\n69|}\n70|\n71|// BlockSeparator marks a hard boundary in the normalized projection. It is a\n72|// newline, which Normalize never emits, so it is unmatchable by any excerpt.\n73|const BlockSeparator = '\\n'\n74|\n75|// TableRow describes one body row of a Markdown table in the pinned document:\n76|// the first-column header of the table it belongs to, and the text of its own\n77|// first cell. Together they say what the row declares — \"Field\"/\"reason\" is the\n78|// declaration of a member, \"Type\"/\"GitIndex\" the declaration of a type, and\n79|// \"Tag\"/\"kind = git\" the declaration of a variant.\n80|type TableRow struct {\n81|\t// Header is the trimmed text of the table's first column header.\n82|\tHeader string\n83|\t// FirstCell is the trimmed text of this row's first cell.\n84|\tFirstCell string\n85|\t// Identifier is FirstCell with a single enclosing <code> element removed,\n86|\t// which is how the pinned document writes every declaration.\n87|\tIdentifier string\n88|\t// Line is the 1-based SPEC.md line of the row.\n89|\tLine int\n90|}\n91|\n92|// Load returns the embedded pinned document after verifying its digest.\n93|func Load() (*Document, error) {\n94|\treturn Parse(embedded)\n95|}\n96|\n97|// Bytes returns an isolated copy of the exact embedded document bytes.\n98|func Bytes() []byte {\n99|\treturn bytes.Clone(embedded)\n100|}\n101|\n102|// Parse accepts only a byte-exact copy of the pinned SPEC.md identified by\n103|// specpin.DocumentSHA256.\n104|func Parse(candidate []byte) (*Document, error) {\n105|\tif len(candidate) == 0 {\n106|\t\treturn nil, fmt.Errorf(\"%w: document is empty\", ErrDocumentMismatch)\n107|\t}\n108|\tdigest := sha256.Sum256(candidate)\n109|\tif got := hex.EncodeToString(digest[:]); got != specpin.DocumentSHA256 {\n110|\t\treturn nil, fmt.Errorf(\"%w: SHA-256 is %s, want %s\", ErrDocumentMismatch, got, specpin.DocumentSHA256)\n111|\t}\n112|\n113|\tdocument := &Document{raw: bytes.Clone(candidate)}\n114|\tdocument.lines = strings.Split(strings.ReplaceAll(string(document.raw), \"\\r\\n\", \"\\n\"), \"\\n\")\n115|\n116|\thardBoundary := indexHardBoundaries(document.lines)\n117|\n118|\tvar normalized strings.Builder\n119|\tnormalized.Grow(len(candidate))\n120|\tlineOf := make([]int, 0, len(candidate))\n121|\tline := 1\n122|\trunStartLine := 1\n123|\tpendingSeparator := false\n124|\twroteAny := false\n125|\tfor index := 0; index < len(document.raw); index++ {\n126|\t\tcharacter := document.raw[index]\n127|\t\tif isNormalizedWhitespace(character) {\n128|\t\t\tif wroteAny && !pendingSeparator {\n129|\t\t\t\trunStartLine = line\n130|\t\t\t\tpendingSeparator = true\n131|\t\t\t}\n132|\t\t\tif character == '\\n' {\n133|\t\t\t\tline++\n134|\t\t\t}\n135|\t\t\tcontinue\n136|\t\t}\n137|\t\tif pendingSeparator {\n138|\t\t\tseparator := byte(' ')\n139|\t\t\tif crossesHardBoundary(hardBoundary, runStartLine, line) {\n140|\t\t\t\tseparator = BlockSeparator\n141|\t\t\t}\n142|\t\t\tnormalized.WriteByte(separator)\n143|\t\t\tlineOf = append(lineOf, line)\n144|\t\t\tpendingSeparator = false\n145|\t\t}\n146|\t\tnormalized.WriteByte(character)\n147|\t\tlineOf = append(lineOf, line)\n148|\t\twroteAny = true\n149|\t}\n150|\tdocument.normalized = normalized.String()\n151|\tdocument.lineOf = lineOf\n152|\tdocument.sectionOfLine = indexSections(document.lines)\n153|\tdocument.tableRowOfLine = indexTableRows(document.lines)\n154|\treturn document, nil\n155|}\n156|\n157|// indexHardBoundaries marks, for each 1-based line n, whether the newline\n158|// between line n and line n+1 is a hard boundary that no excerpt may cross.\n159|func indexHardBoundaries(lines []string) []bool {\n160|\thard := make([]bool, len(lines)+1)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8fd","stream":{"kind":"session","id":"01a0777b-0bfc-71c2-a449-63245f4fe13c"},"sequence":729,"recorded_at":1780531400001453,"record_type":"event","durability":"durable","causation_id":"32f7efe8-067d-4d98-a2af-fff5c474ce56","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"32f7efe8-067d-4d98-a2af-fff5c474ce56","run_stream":{"kind":"run","id":"32f7efe8-067d-4d98-a2af-fff5c474ce56"},"call_id":"call_01a0777c9fb37130821128d9e2ca3023","text":"{\n  \"chunk_id\": \"exec-30-1\",\n  \"command\": \"grep -c \\\"\\\" internal/specdoc/SPEC.md; sha256sum internal/specdoc/SPEC.md; grep -n \\\"DocumentSHA256\\\\|562546d\\\" internal/specpin/pin.go | head -n 3\",\n  \"description\": \"Check embedded spec identity\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"12665\\n562546d240f0fa3e71b47e6359a002f9892c0efd97e19eb55917527552ac484a  internal/specdoc/SPEC.md\\n30:\\tDocumentSHA256           = \\\"562546d240f0fa3e71b47e6359a002f9892c0efd97e19eb55917527552ac484a\\\"\\n195:\\t\\tsource.Document.Path != DocumentPath || source.Document.SHA256 != DocumentSHA256 ||\\n\",\n  \"original_output_bytes\": 285,\n  \"original_output_tokens\": 72,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
