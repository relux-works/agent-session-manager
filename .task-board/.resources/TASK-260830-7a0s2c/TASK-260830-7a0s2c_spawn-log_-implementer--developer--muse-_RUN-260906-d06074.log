{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d483","stream":{"kind":"session","id":"01a0777b-0bfc-71c2-a449-63245f4fe13c"},"sequence":2204,"recorded_at":1780531400004403,"record_type":"event","durability":"durable","causation_id":"32f7efe8-067d-4d98-a2af-fff5c474ce56","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"32f7efe8-067d-4d98-a2af-fff5c474ce56","run_stream":{"kind":"run","id":"32f7efe8-067d-4d98-a2af-fff5c474ce56"},"task_stream":{"kind":"task","id":"bf12662f-aed6-44f1-9d8d-32e9a650fbd4"},"task_id":"bf12662f-aed6-44f1-9d8d-32e9a650fbd4","event":{"kind":"output","task_id":"bf12662f-aed6-44f1-9d8d-32e9a650fbd4","chunk":"{\n  \"chunk_id\": \"exec-78-1\",\n  \"command\": \"for i in $(seq 1 13); do task-board m \\\"check_item(TASK-260830-7a0s2c, item=$i)\\\" 2>&1 | head -n 1; done\",\n  \"description\": \"Check all definition-of-done items\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"TASK-260830-7a0s2c\\\",\\\"item\\\":1,\\\"text\\\":\\\"Production entry points implement the scoped deliverable: Build deterministic fixture runners, fake clocks, crash points, protocol fuzzing, hostile strings, and platform capability skips\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"TASK-260830-7a0s2c\\\",\\\"item\\\":2,\\\"text\\\":\\\"Relevant positive, negative, compatibility, and recovery tests pass with logs attached\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"TASK-260830-7a0s2c\\\",\\\"item\\\":3,\\\"text\\\":\\\"README/doctor/capability evidence and specification traceability are updated without unsupported claims\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"TASK-260830-7a0s2c\\\",\\\"item\\\":4,\\\"text\\\":\\\"Code written per task description and AC\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"TASK-260830-7a0s2c\\\",\\\"item\\\":5,\\\"text\\\":\\\"Relevant tests written for new or changed behavior and passing\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"TASK-260830-7a0s2c\\\",\\\"item\\\":6,\\\"text\\\":\\\"Every command, message, state, or refusal named in the AC is driven through the production entry point by a named committed test, or is declared a stated bound. Report coverage as a ratio — `n of m AC rows driven` — and name the production call site for each. Prose in place of the ratio is not evidence.\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"TASK-260830-7a0s2c\\\",\\\"item\\\":7,\\\"text\\\":\\\"Gating, refusing, validating, authorizing, or attesting behavior covered by negative tests that fail when the gate admits what it must reject, with the production call site named\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"TASK-260830-7a0s2c\\\",\\\"item\\\":8,\\\"text\\\":\\\"Every gate ships at least one NARROWING mutant — the gate stays present and is weakened to admit exactly one member of the class it must reject, and a named test must fail. A delete-only mutant proves only that the gate exists and is not accepted as evidence.\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"TASK-260830-7a0s2c\\\",\\\"item\\\":9,\\\"text\\\":\\\"A gate that inspects source text is additionally attacked by a mutant that PRESERVES the searched-for token and changes behavior, and the mutant harness executes the behavioral suite, not only the static checker.\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"TASK-260830-7a0s2c\\\",\\\"item\\\":10,\\\"text\\\":\\\"Lint clean\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"TASK-260830-7a0s2c\\\",\\\"item\\\":11,\\\"text\\\":\\\"Relevant build/validation commands run after changes and build not broken\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"TASK-260830-7a0s2c\\\",\\\"item\\\":12,\\\"text\\\":\\\"New outcome artifact attached on the board with a task-scoped name when the work produces notes, logs, screenshots, or other deliverables\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"TASK-260830-7a0s2c\\\",\\\"item\\\":13,\\\"text\\\":\\\"Important findings, decisions, anomalies, or regressions recorded in logbook when relevant\\\"}}\\n\",\n  \"original_output_bytes\": 2829,\n  \"original_output_tokens\": 708,\n  \"truncated\": false\n}"}}}
