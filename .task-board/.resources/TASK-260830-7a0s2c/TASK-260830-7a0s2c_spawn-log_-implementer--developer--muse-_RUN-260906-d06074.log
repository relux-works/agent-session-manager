{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc37","stream":{"kind":"session","id":"01a0777b-0bfc-71c2-a449-63245f4fe13c"},"sequence":1142,"recorded_at":1780531400002279,"record_type":"event","durability":"durable","causation_id":"32f7efe8-067d-4d98-a2af-fff5c474ce56","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"32f7efe8-067d-4d98-a2af-fff5c474ce56","run_stream":{"kind":"run","id":"32f7efe8-067d-4d98-a2af-fff5c474ce56"},"task_stream":{"kind":"task","id":"dbd928d2-0500-4496-a129-49517df58837"},"task_id":"dbd928d2-0500-4496-a129-49517df58837","event":{"kind":"output","task_id":"dbd928d2-0500-4496-a129-49517df58837","chunk":"Read text file `internal/secprim/path.go`.\n(99 line(s) above)\n100|// its members, so denying by default is representable and distinct from\n101|// not checking. The zero value is unusable; build one with NewGuard.\n102|type Guard struct {\n103|\troot         string\n104|\tplatform     scalar.Platform\n105|\tmanaged      map[string]bool\n106|\tcheckManaged bool\n107|}\n108|\n109|// NewGuard validates the staging root and records the managed set.\n110|// The root must be an absolute path on the platform: a relative root\n111|// fails here instead of resolving against the process working directory\n112|// at commit time.\n113|func NewGuard(root string, platform scalar.Platform, managed []string) (Guard, error) {\n114|\tif _, err := scalar.ParseAbsolutePath(platform, root); err != nil {\n115|\t\treturn Guard{}, failPath(\"guard root\", memberErrorTarget(root))\n116|\t}\n117|\tguard := Guard{root: root, platform: platform}\n118|\tif managed != nil {\n119|\t\tguard.checkManaged = true\n120|\t\tguard.managed = make(map[string]bool, len(managed))\n121|\t\tfor _, member := range managed {\n122|\t\t\tguard.managed[member] = true\n123|\t\t}\n124|\t}\n125|\treturn guard, nil\n126|}\n127|\n128|// Resolve maps one member name to its commit path inside the guard root.\n129|// It enforces the two conjuncts of containment independently: the member\n130|// grammar (CheckMemberPath, which refuses traversal lexically) and the\n131|// joined-prefix check below (which refuses anything whose cleaned join\n132|// escapes the root even if the grammar ever admits a new shape). Either\n133|// conjunct refuses alone.\n134|//\n135|// The prefix check is currently unreachable through this entry: the\n136|// member grammar refuses every parent segment, so no admitted member can\n137|// produce a join outside the root. It stays as defense in depth against a\n138|// future grammar relaxation, and TestGuardPrefixCheckIsLoadBearing pins\n139|// the property it guards (every resolved join stays within the root) so\n140|// weakening the grammar reddens there first.\n141|func (guard Guard) Resolve(member string) (string, error) {\n142|\tif err := CheckMemberPath(guard.platform, member); err != nil {\n143|\t\treturn \"\", err\n144|\t}\n145|\tif guard.checkManaged && !guard.managed[member] {\n146|\t\treturn \"\", failPath(\"member unmanaged\", memberErrorTarget(member))\n147|\t}\n148|\tjoined := joinSlash(guard.slashRoot(), member)\n149|\tif !withinRoot(guard.slashRoot(), joined) {\n150|\t\treturn \"\", failPath(\"member containment\", memberErrorTarget(member))\n151|\t}\n152|\tif guard.platform == scalar.PlatformWindows {\n153|\t\treturn strings.ReplaceAll(joined, \"/\", `\\`), nil\n154|\t}\n155|\treturn joined, nil\n156|}\n157|\n158|// slashRoot renders the validated root with forward slashes so the join\n159|// and prefix check are platform-parameterized rather than host-native:\n160|// windows cases are decided lexically on any host.\n161|func (guard Guard) slashRoot() string {\n162|\tif guard.platform == scalar.PlatformWindows {\n163|\t\treturn strings.ReplaceAll(guard.root, `\\`, \"/\")\n164|\t}\n165|\treturn guard.root\n166|}\n167|\n168|// joinSlash joins a slash-form root with a grammar-checked member and\n169|// cleans the result, preserving a UNC leading double slash that path\n170|// Clean would otherwise collapse.\n171|func joinSlash(slashRoot, member string) string {\n172|\tfull := strings.TrimSuffix(slashRoot, \"/\") + \"/\" + member\n173|\tcleaned := path.Clean(full)\n174|\tif strings.HasPrefix(slashRoot, \"//\") && !strings.HasPrefix(cleaned, \"//\") {\n175|\t\tcleaned = \"/\" + cleaned\n176|\t}\n177|\treturn cleaned\n178|}\n179|\n180|// withinRoot reports whether the cleaned join stays inside the cleaned\n181|// root: equality (the root itself) or a slash-boundary prefix. A bare\n182|// string prefix is not containment: \"/root-evil\" starts with \"/root\" but\n183|// is not inside it.\n184|func withinRoot(slashRoot, joined string) bool {\n185|\tbase := strings.TrimSuffix(slashRoot, \"/\")\n186|\tif base == \"\" {\n187|\t\tbase = \"/\"\n188|\t}\n189|\tif joined == base {\n190|\t\treturn true\n191|\t}\n192|\treturn strings.HasPrefix(joined, base+\"/\")\n193|}\n194|\n195|// DetectCaseCollision reports whether candidate collides with an existing\n196|// member name under case folding for a case-insensitive destination\n197|// (Section 16.3 \"case-fold collisions\"). It returns the colliding entry.\n198|// Comparison is Unicode simple folding via EqualFold over the exact entry\n199|// spellings the caller lists: the caller owns the directory read, this\n200|// function owns the decision.\n201|func DetectCaseCollision(seen []string, candidate string) (string, bool) {\n202|\tfor _, existing := range seen {\n203|\t\tif existing != candidate && strings.EqualFold(existing, candidate) {\n204|\t\t\treturn existing, true\n205|\t\t}\n206|\t}\n207|\treturn \"\", false\n208|}\n209|\n210|// CheckRegularTarget refuses a stat result that is not a plain regular\n211|// file: symlinks, directories, devices, named pipes, and sockets\n212|// (Section 16.3 \"symlink/reparse escape\" and \"device/FIFO/socket\n213|// creation\"). A nil result is refused rather than treated as absent: a\n214|// failed stat is never a legitimate absence.\n215|func CheckRegularTarget(info os.FileInfo) error {\n216|\tif info == nil {\n217|\t\treturn failPath(\"target stat missing\", \"nil file info\")\n218|\t}\n219|\tmode := info.Mode()\n220|\tswitch {\n221|\tcase mode&os.ModeSymlink != 0:\n222|\t\treturn failPath(\"target symlink\", info.Name())\n223|\tcase info.IsDir():\n224|\t\treturn failPath(\"target directory\", info.Name())\n225|\tcase mode&os.ModeDevice != 0,\n226|\t\tmode&os.ModeNamedPipe != 0,\n227|\t\tmode&os.ModeSocket != 0,\n228|\t\tmode&os.ModeCharDevice != 0,\n229|\t\t!mode.IsRegular():\n230|\t\treturn failPath(\"target special file\", info.Name())\n231|\t}\n232|\treturn nil\n233|}"}}}
