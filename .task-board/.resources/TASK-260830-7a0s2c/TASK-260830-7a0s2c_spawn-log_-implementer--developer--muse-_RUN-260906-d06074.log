' 'M2 narrowing Classify drops prepare-commit row (BROKEN-SETUP check)'\\ndiff internal/secconftest/crash.go crash.go 2>/dev/null; git status --short . | head -3; echo \\\"restore-check done\\\"\",\n  \"description\": \"Apply mutants M1 and M2 setup check\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"--- M1 narrowing runner exempts one unreached member\\nKILLED: M1 narrowing runner exempts one unreached member\\n--- FAIL: TestRunnerRefusesUnreachedFixture (0.00s)\\n    runner_test.go:95: Run with an unreached fixture = <nil>, want an error naming it\\n--- M2 narrowing Classify drops prepare-commit row (BROKEN-SETUP check)\\nKILLED: M2 narrowing Classify drops prepare-commit row (BROKEN-SETUP check)\\n--- FAIL: TestCrashClassifyTable (0.00s)\\n    crash_test.go:24: Classify(\\\"CR-MAT-prepare-commit\\\") = , secconftest: unknown crash point \\\"CR-MAT-prepare-commit\\\"; want explicit_rollback\\n?? ./\\nrestore-check done\\n\",\n  \"original_output_bytes\": 603,\n  \"original_output_tokens\": 151,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
