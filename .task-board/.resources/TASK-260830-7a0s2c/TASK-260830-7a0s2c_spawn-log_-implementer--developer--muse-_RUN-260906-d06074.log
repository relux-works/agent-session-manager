{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c871","stream":{"kind":"session","id":"01a0777b-0bfc-71c2-a449-63245f4fe13c"},"sequence":659,"recorded_at":1780531400001313,"record_type":"event","durability":"durable","causation_id":"32f7efe8-067d-4d98-a2af-fff5c474ce56","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"32f7efe8-067d-4d98-a2af-fff5c474ce56","run_stream":{"kind":"run","id":"32f7efe8-067d-4d98-a2af-fff5c474ce56"},"task_stream":{"kind":"task","id":"851ff8b9-2960-499a-a1a8-500bc12c5ef9"},"task_id":"851ff8b9-2960-499a-a1a8-500bc12c5ef9","event":{"kind":"output","task_id":"851ff8b9-2960-499a-a1a8-500bc12c5ef9","chunk":"Read text file `internal/traceability/cmd/tracecheck/main.go`.\n1|// tracecheck is the headless CI entry point for AX specification-to-code\n2|// ownership verification. It reports inventory coverage, not runtime support.\n3|package main\n4|\n5|import (\n6|\t\"flag\"\n7|\t\"fmt\"\n8|\t\"io\"\n9|\t\"os\"\n10|\t\"strings\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/traceability\"\n13|)\n14|\n15|func main() {\n16|\tif err := run(os.Args[1:], os.Stdout); err != nil {\n17|\t\tfmt.Fprintln(os.Stderr, err)\n18|\t\tos.Exit(1)\n19|\t}\n20|}\n21|\n22|func run(arguments []string, stdout io.Writer) error {\n23|\tflags := flag.NewFlagSet(\"tracecheck\", flag.ContinueOnError)\n24|\tflags.SetOutput(io.Discard)\n25|\troot := flags.String(\"root\", \".\", \"repository root\")\n26|\tvar sections sectionFlags\n27|\tflags.Var(&sections, \"section\", \"assigned normative section or same-section range; repeat for multiple scopes\")\n28|\tif err := flags.Parse(arguments); err != nil {\n29|\t\treturn err\n30|\t}\n31|\tif flags.NArg() != 0 {\n32|\t\treturn fmt.Errorf(\"unexpected positional arguments: %v\", flags.Args())\n33|\t}\n34|\n35|\tvar report traceability.Report\n36|\tvar err error\n37|\tif len(sections) == 0 {\n38|\t\treport, err = traceability.VerifyRepository(os.DirFS(*root))\n39|\t} else {\n40|\t\treport, err = traceability.VerifyAssignedSections(os.DirFS(*root), sections)\n41|\t}\n42|\tif err != nil {\n43|\t\treturn err\n44|\t}\n45|\tif _, err = fmt.Fprintf(\n46|\t\tstdout,\n47|\t\t\"traceability ok: contracts=%d normative_sections=%d acceptance_cases=%d fixtures=%d compatibility_contracts=%d assigned_scopes=%d\\n\",\n48|\t\treport.Contracts,\n49|\t\treport.NormativeSections,\n50|\t\treport.AcceptanceCases,\n51|\t\treport.Fixtures,\n52|\t\treport.CompatibilityContracts,\n53|\t\treport.AssignedScopes,\n54|\t); err != nil {\n55|\t\treturn err\n56|\t}\n57|\t// Coverage is printed as the measured ratio it was computed from. A gate\n58|\t// that reported \"sections owned\" would repeat the claim this line exists to\n59|\t// contradict.\n60|\t_, err = fmt.Fprintf(\n61|\t\tstdout,\n62|\t\t\"section coverage: bindings=%d full=%d partial=%d sliver=%d unevidenced=%d unmeasured=%d unowned=%d clauses_discharged=%d/%d\\n\",\n63|\t\treport.SectionBindings,\n64|\t\treport.FullCoverage,\n65|\t\treport.PartialCoverage,\n66|\t\treport.SliverCoverage,\n67|\t\treport.UnevidencedCoverage,\n68|\t\treport.UnmeasuredCoverage,\n69|\t\treport.UnownedSections,\n70|\t\treport.DischargedClauses,\n71|\t\treport.NormativeClauses,\n72|\t)\n73|\treturn err\n74|}\n75|\n76|type sectionFlags []string\n77|\n78|func (sections *sectionFlags) String() string {\n79|\treturn strings.Join(*sections, \",\")\n80|}\n(more lines below)"}}}
