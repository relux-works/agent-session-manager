ened to safe_retry'\\ncat > /tmp/mutant_payload.txt <<'EOF'\\n\\tif strictOn(capability) {\\n\\t\\treturn decisionFail\\n\\t}\\n\\treturn decisionSkip\\n<<<SPLIT>>>\\n\\tif strictOn(capability) {\\n\\t\\treturn decisionSkip\\n\\t}\\n\\treturn decisionSkip\\nEOF\\nrun_mutant skip.go 'TestSkipDecideTable' 'M3 narrowing strict-unavailable admitted as skip'\\ncat > /tmp/mutant_payload.txt <<'EOF'\\n\\tfor _, line := range lines {\\n\\t\\tif got, ok := document.SectionID(line); ok && got == section {\\n\\t\\t\\treturn nil\\n\\t\\t}\\n\\t}\\n\\treturn fmt.Errorf(\\\"secconftest: quote %q occurs but never in section %s\\\", quote, section)\\n<<<SPLIT>>>\\n\\tfor _, line := range lines {\\n\\t\\tif _, ok := document.SectionID(line); ok {\\n\\t\\t\\treturn nil\\n\\t\\t}\\n\\t}\\n\\treturn fmt.Errorf(\\\"secconftest: quote %q occurs but never in section %s\\\", quote, section)\\nEOF\\nrun_mutant hostile.go 'TestQuoteInSectionRefusals' 'M4 token-preserving QuoteInSection drops section check'\\ngofmt -l .; go test . -count=1 >/dev/null 2>&1 && echo \\\"RESTORED-GREEN\\\" || echo \\\"RESTORE-BROKEN\\\"\",\n  \"description\": \"Apply narrowing mutants M2 M3 M4\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"--- M2 narrowing prepare-commit weakened to safe_retry\\nKILLED: M2 narrowing prepare-commit weakened to safe_retry\\n--- FAIL: TestCrashClassifyTable (0.00s)\\n    crash_test.go:24: Classify(\\\"CR-MAT-prepare-commit\\\") = safe_retry, <nil>; want explicit_rollback\\n--- FAIL: TestTransactorCrashOutcomes (0.00s)\\n--- M3 narrowing strict-unavailable admitted as skip\\nKILLED: M3 narrowing strict-unavailable admitted as skip\\n--- FAIL: TestSkipDecideTable (0.00s)\\n    skip_test.go:20: unavailable strict capability decides 1, want fail: an unexpected skip must not pass quietly\\n--- M4 token-preserving QuoteInSection drops section check\\nKILLED: M4 token-preserving QuoteInSection drops section check\\n--- FAIL: TestQuoteInSectionRefusals (0.01