+		}
+		if directory != "" {
+			t.Fatalf("quarantineProjectionFiles(fifo journal) directory = %q, want no reported recovery", directory)
+		}
+		if _, err := os.Lstat(fifo); err != nil {
+			t.Fatalf("fifo after refusal = %v, want the unsafe source left in place", err)
+		}
+	})
