+				t.Fatalf("corrupt target stat error = %v, want removed from immutable namespace", statErr)
+			}
+			assertFileBytes(t, result.QuarantinePath, content)
+			assertFileBytes(t, result.ExistingQuarantinePath, test.existing)
+		})
+	}
