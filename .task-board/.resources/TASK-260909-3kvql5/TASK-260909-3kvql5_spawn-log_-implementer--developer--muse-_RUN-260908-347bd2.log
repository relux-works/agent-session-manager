g := admissionTriple(t, e)\\n./internal/sessadapter/inventory_witnesses_test.go:1417:\\t\\t\\tentry, tuple, binding := admissionTriple(t, e)\\n./internal/sessadapter/inventory_witnesses_test.go:1423:\\t\\t\\t_, tuple, binding := admissionTriple(t, e)\\n./internal/sessadapter/inventory_witnesses_test.go:1428:\\t\\t\\tentry, tuple, binding := admissionTriple(t, e)\\n./internal/sessadapter/inventory_witnesses_test.go:1459:\\t\\t\\tentry, tuple, binding := admissionTriple(t, e)\\n./internal/sessadapter/inventory_witnesses_test.go:1466:\\t\\t\\tentry, tuple, binding := admissionTriple(t, e)\\n./internal/sessadapter/inventory_witnesses_test.go:1590:// admissionTriple decodes a target entry, tuple, and binding facts\\n\",\n  \"original_output_bytes\": 3278,\n  \"original_output_tokens\": 820,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
