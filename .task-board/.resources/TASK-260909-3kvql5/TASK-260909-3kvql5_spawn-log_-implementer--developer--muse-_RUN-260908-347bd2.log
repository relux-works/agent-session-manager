awn.WorktreeIsolation.Validation.Commands {\n42|\t\tconfigured[command]++\n43|\t}\n44|\n45|\terr = filepath.WalkDir(repositoryRoot, func(path string, entry fs.DirEntry, walkErr error) error {\n46|\t\tif walkErr != nil {\n47|\t\t\treturn walkErr\n48|\t\t}\n49|\t\tif entry.IsDir() {\n50|\t\t\tif path != repositoryRoot && (strings.HasPrefix(entry.Name(), \".\") || entry.Name() == \"vendor\" || entry.Name() == \"testdata\") {\n51|\t\t\t\treturn filepath.SkipDir\n52|\t\t\t}\n53|\t\t\treturn nil\n54|\t\t}\n55|\t\tif !strings.HasSuffix(entry.Name(), \"_test.go\") {\n56|\t\t\treturn nil\n57|\t\t}\n58|\t\tparsed, parseErr := parser.ParseFile(token.NewFileSet(), path, nil, 0)\n59|\t\tif parseErr != nil {\n60|\t\t\treturn parseErr\n61|\t\t}\n62|\t\tpackagePath, pathErr := filepath.Rel(repositoryRoot, filepath.Dir(path))\n63|\t\tif pathErr != nil {\n64|\t\t\treturn pathErr\n65|\t\t}\n66|\t\tpackageArgument := \".\"\n67|\t\tif packagePath != \".\" {\n68|\t\t\tpackageArgument = \"./\" + filepath.ToSlash(packagePath)\n69|\t\t}\n70|\t\tfor _, declaration := range parsed.Decls {\n71|\t\t\tfunction, isFunction := declaration.(*ast.FuncDecl)\n72|\t\t\tif !isFunction || !strings.HasPrefix(function.Name.Name, \"Fuzz\") {\n73|\t\t\t\tcontinue\n74|\t\t\t}\n75|\t\t\texpected := \"go test \" + packageArgument + \" -run=^$ -fuzz=^\" + function.Name.Name + \"$ -fuzztime=100x -parallel=1\"\n76|\t\t\tif count := configured[expected]; count != 1 {\n77|\t\t\t\tt.Errorf(\"configured validation contains %q %d times, want exactly once\", expected, count)\n78|\t\t\t}\n79|\t\t}\n80|\t\treturn nil\n81|\t})\n82|\tif err != nil {\n83|\t\tt.Fatal(err)\n84|\t}\n85|}"}}}
