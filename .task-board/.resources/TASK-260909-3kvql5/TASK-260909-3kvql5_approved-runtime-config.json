{
  "mode": "local",
  "local": {
    "board_dir": ".task-board"
  },
  "version_control": {
    "confirm": true,
    "desired_commit_time": "current real time; AX does not backdate commits"
  },
  "spawn": {
    "enabled": true,
    "max_parallel": 20,
    "ceilings": {
      "contract_version": "spawn-policy-v4",
      "codex": {
        "entries": [
          {
            "criterion": "equal",
            "model": "gpt-6-astra",
            "reasoning_effort": "medium"
          },
          {
            "criterion": "equal",
            "model": "gpt-6-astra",
            "reasoning_effort": "high"
          }
        ],
        "resolution_model": "gpt-6-astra",
        "adjustment_confirmation": "none",
        "fast_mode": true,
        "roles": {
          "reviewer": {
            "entries": [
              {
                "criterion": "equal",
                "model": "gpt-6-astra",
                "reasoning_effort": "medium"
              }
            ],
            "resolution_model": "gpt-6-astra",
            "adjustment_confirmation": "none",
            "default_model": "gpt-6-astra",
            "default_reasoning_effort": "medium"
          }
        }
      },
      "claude": {
        "entries": [
          {
            "criterion": "equal",
            "model": "claude-opus-5",
            "reasoning_effort": "xhigh"
          }
        ],
        "resolution_model": "claude-opus-5",
        "adjustment_confirmation": "none"
      },
      "muse": {
        "entries": [
          {
            "criterion": "equal",
            "model": "muse-spark",
            "reasoning_effort": "xhigh"
          }
        ],
        "resolution_model": "muse-spark",
        "adjustment_confirmation": "none"
      }
    },
    "preferred_agentic_system": {
      "mixed": [
        "muse",
        "codex"
      ]
    },
    "workload_classes": {
      "unified": [
