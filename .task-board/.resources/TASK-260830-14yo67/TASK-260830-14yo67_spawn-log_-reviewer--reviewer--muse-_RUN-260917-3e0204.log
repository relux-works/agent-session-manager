{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6ab","stream":{"kind":"session","id":"01a0adbc-2826-7673-94d4-717956fa0d32"},"sequence":432,"recorded_at":1780531400000859,"record_type":"event","durability":"durable","causation_id":"9162595d-8e13-449e-aede-0d31dd41754b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9162595d-8e13-449e-aede-0d31dd41754b","run_stream":{"kind":"run","id":"9162595d-8e13-449e-aede-0d31dd41754b"},"task_stream":{"kind":"task","id":"01a0adbc-f227-7e42-92ee-01088ce5226e"},"task_id":"01a0adbc-f227-7e42-92ee-01088ce5226e","event":{"kind":"output","task_id":"01a0adbc-f227-7e42-92ee-01088ce5226e","chunk":"Read text file `internal/sessckpt/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for internal/sessckpt (TASK-260830-14yo67).\n3|\n4|Each plant weakens exactly one production gate so it admits one\n5|member of the class the gate must reject; the named killer test\n6|must then FAIL (mutant KILLED). A delete-only mutant proves only\n7|that the gate exists and is never accepted as evidence, so every\n8|plant here preserves the gate and narrows it. The evidence-enum\n9|plant additionally preserves every searched-for token while\n10|changing behavior.\n11|\n12|One harmless SURVIVED control (a comment-only edit) proves the\n13|harness reports survival instead of silently passing.\n14|\n15|Usage (from the repository root):\n16|\n17|    PYTHONDONTWRITEBYTECODE=1 python3 internal/sessckpt/mutant_harness.py \\\n18|        --log-dir .temp/TASK-260830-14yo67/mutants\n19|\n20|For every plant the harness writes the raw per-plant subprocess\n21|log to <log-dir>/<name>.log (command, return code, full output)\n22|plus <log-dir>/summary.json. A plant whose anchor occurs zero or\n23|multiple times is reported NOT_APPLIED; a plant that breaks the\n24|build or matches no test is reported COMPILE_OR_HARNESS_FAILURE.\n25|Both stay outside the killed numerator. The process exits nonzero\n26|unless every killed-expectation is KILLED and every\n27|survived-expectation SURVIVED.\n28|\"\"\"\n29|\n30|import argparse\n31|import json\n32|import os\n33|import subprocess\n34|import sys\n35|\n36|PACKAGE = \"./internal/sessckpt/\"\n37|\n38|PLANTS = [\n39|    {\n40|        \"name\": \"N-bg-idle\",\n41|        \"gate\": \"quiescence (safe_boundary.background_idle)\",\n42|        \"file\": \"internal/sessckpt/capture.go\",\n43|        \"old\": \"\\tif !boundary.BackgroundIdle {\",\n44|        \"new\": \"\\tif !boundary.BackgroundIdle && boundary.OpenProcesses != 0 {\",\n45|        \"run\": \"TestCaptureRefusesNonQuiescentBoundary/cp_n1_background_idle_false\",\n46|        \"expect\": \"killed\",\n47|    },\n48|    {\n49|        \"name\": \"N-both-present\",\n50|        \"gate\": \"variant presence (exactly one persistence leg)\",\n51|        \"file\": \"internal/sessckpt/capture.go\",\n52|        \"old\": \"\\tif hasProvider == hasBoard {\",\n53|        \"new\": \"\\tif !hasProvider && !hasBoard {\",\n54|        \"run\": \"TestCaptureRefusesBadPersistenceVariant/cp_n3_both_present\",\n55|        \"expect\": \"killed\",\n56|    },\n57|    {\n58|        \"name\": \"N-swapped-direct\",\n59|        \"gate\": \"kind-selected variant (direct takes provider)\",\n60|        \"file\": \"internal/sessckpt/capture.go\",\n61|        \"old\": \"\\t\\tif !hasProvider || hasBoard {\",\n62|        \"new\": \"\\t\\tif !hasProvider && !hasBoard {\",\n63|        \"run\": \"TestCaptureRefusesBadPersistenceVariant/swapped_direct_takes_bundle\",\n64|        \"expect\": \"killed\",\n65|    },\n66|    {\n67|        \"name\": \"N-duplicate-heads\",\n68|        \"gate\": \"event-head sorted-unique order\",\n69|        \"file\": \"internal/sessckpt/capture.go\",\n70|        \"old\": \"\\t\\tif len(out) > 0 && name <= previous {\",\n71|        \"new\": \"\\t\\tif len(out) > 0 && name < previous {\",\n72|        \"run\": \"TestCaptureRefusesMalformedHeads/duplicated\",\n73|        \"expect\": \"killed\",\n74|    },\n75|    {\n76|        \"name\": \"N-later-epoch-head\",\n77|        \"gate\": \"event-head at-or-before owning lease (epoch arm)\",\n78|        \"file\": \"internal/sessckpt/capture.go\",\n79|        \"old\": \"\\t\\tif summary.LeaseEpoch > inputs.LeaseEpoch {\",\n80|        \"new\": \"\\t\\tif summary.LeaseEpoch > inputs.LeaseEpoch+1 {\",\n81|        \"run\": \"TestCaptureRefusesLaterLeaseHead\",\n82|        \"expect\": \"killed\",\n83|    },\n84|    {\n85|        \"name\": \"N-idempotency-session\",\n86|        \"gate\": \"same-operation moved-inputs conflict\",\n87|        \"file\": \"internal/sessckpt/capture.go\",\n88|        \"old\": (\n89|            \"\\t\\tif recorded.InputDigest != inputDigest {\\n\"\n90|            '\\t\\t\\treturn CheckpointRef{}, nil, fmt.Errorf(\"%w: operation %s captured different inputs (idempotency_mismatch)\",\\n'\n91|        ),\n92|        \"new\": (\n93|            \"\\t\\tif recorded.InputDigest != inputDigest && recorded.SessionID != session {\\n\"\n94|            '\\t\\t\\treturn CheckpointRef{}, nil, fmt.Errorf(\"%w: operation %s captured different inputs (idempotency_mismatch)\",\\n'\n95|        ),\n96|        \"run\": \"TestCaptureWithMovedInputsRefuses\",\n97|        \"expect\": \"killed\",\n98|    },\n99|    {\n100|        \"name\": \"N-evidence-enum\",\n101|        \"gate\": \"safe_boundary evidence closed enum (token-preserving)\",\n102|        \"file\": \"internal/sessckpt/capture.go\",\n103|        \"old\": \"\\tcase EvidenceProviderAPI, EvidenceProviderEvent, EvidenceManagedPTY, EvidenceTaskBoardBridge, EvidenceAcceptedTest:\",\n104|        \"new\": '\\tcase EvidenceProviderAPI, EvidenceProviderEvent, EvidenceManagedPTY, EvidenceTaskBoardBridge, EvidenceAcceptedTest, \"provider_gossip\":',\n105|        \"run\": \"TestCaptureRefusesMalformedClosureMembers/bad_evidence\",\n106|        \"expect\": \"killed\",\n107|    },\n108|    {\n109|        \"name\": \"C-harmless-comment\",\n110|        \"gate\": \"control: comment-only edit, behavior unchanged\",\n111|        \"file\": \"internal/sessckpt/doc.go\",\n112|        \"old\": \"// Authority: relux-works/agent-session-manager-spec@v0.6.0, Sections 5.4\",\n113|        \"new\": \"// Authority: relux-works/agent-session-manager-spec@v0.6.0; Sections 5.4\",\n114|        \"run\": \"TestCaptureDirectInstallsAttestedRecord\",\n115|        \"expect\": \"survived\",\n116|    },\n117|]\n118|\n119|\n120|def run_plant(root, log_dir, plant):\n121|    path = os.path.join(root, plant[\"file\"])\n122|    with open(path, \"r\", encoding=\"utf-8\") as handle:\n123|        original = handle.read()\n124|    occurrences = original.count(plant[\"old\"])\n125|    record = {\n126|        \"name\": plant[\"name\"],\n127|        \"gate\": plant[\"gate\"],\n128|        \"file\": plant[\"file\"],\n129|        \"run\": plant[\"run\"],\n130|        \"expect\": plant[\"expect\"],\n131|    }\n132|    log_path = os.path.join(log_dir, plant[\"name\"] + \".log\")\n133|    if occurrences != 1:\n134|        record[\"verdict\"] = \"NOT_APPLIED\"\n135|        record[\"detail\"] = \"anchor occurs %d times, want exactly 1\" % occurrences\n136|        with open(log_path, \"w\", encoding=\"utf-8\") as handle:\n137|            handle.write(\"NOT_APPLIED: %s\\n\" % record[\"detail\"])\n138|        return record\n139|    mutated = original.replace(plant[\"old\"], plant[\"new\"], 1)\n140|    with open(path, \"w\", encoding=\"utf-8\") as handle:\n141|        handle.write(mutated)\n142|    try:\n143|        command = [\"go\", \"test\", PACKAGE, \"-run\", plant[\"run\"], \"-count=1\"]\n144|        completed = subprocess.run(\n145|            command,\n146|            cwd=root,\n147|            stdout=subprocess.PIPE,\n148|            stderr=subprocess.STDOUT,\n149|            text=True,\n150|            timeout=300,\n151|        )\n152|        output = completed.stdout\n153|        with open(log_path, \"w\", encoding=\"utf-8\") as handle:\n154|            handle.write(\"$ %s\\n\" % \" \".join(command))\n155|            handle.write(\"returncode: %d\\n\" % completed.returncode)\n156|            handle.write(output)\n157|        record[\"returncode\"] = completed.returncode\n158|        record[\"log\"] = log_path\n159|        if \"no tests to run\" in output or \"no test files\" in output:\n160|            record[\"verdict\"] = \"COMPILE_OR_HARNESS_FAILURE\"\n161|            record[\"detail\"] = \"killer matched no test\"\n162|        elif \"build failed\" in output:\n163|            record[\"verdict\"] = \"COMPILE_OR_HARNESS_FAILURE\"\n164|            record[\"detail\"] = \"plant broke compilation\"\n165|        elif completed.returncode != 0:\n166|            record[\"verdict\"] = \"KILLED\"\n167|            record[\"detail\"] = \"killer test failed under the plant\"\n168|        else:\n169|            record[\"verdict\"] = \"SURVIVED\"\n170|            record[\"detail\"] = \"killer test passed under the plant\"\n171|    except subprocess.TimeoutExpired:\n172|        record[\"verdict\"] = \"COMPILE_OR_HARNESS_FAILURE\"\n173|        record[\"detail\"] = \"subprocess timed out\"\n174|        with open(log_path, \"w\", encoding=\"utf-8\") as handle:\n175|            handle.write(\"TIMEOUT\\n\")\n176|    finally:\n177|        with open(path, \"w\", encoding=\"utf-8\") as handle:\n178|            handle.write(original)\n179|    return record\n180|\n181|\n182|def main():\n183|    parser = argparse.ArgumentParser(description=\"sessckpt narrowing-mutant harness\")\n184|    parser.add_argument(\"--log-dir\", required=True, help=\"directory for per-plant raw logs\")\n185|    parser.add_argument(\"--root\", default=\".\", help=\"repository root\")\n186|    args = parser.parse_args()\n187|    root = os.path.abspath(args.root)\n188|    log_dir = args.log_dir if os.path.isabs(args.log_dir) else os.path.join(root, args.log_dir)\n189|    os.makedirs(log_dir, exist_ok=True)\n190|    results = [run_plant(root, log_dir, plant) for plant in PLANTS]\n191|    summary = {\"plants\": results}\n192|    killed = sum(1 for r in results if r[\"verdict\"] == \"KILLED\" and r[\"expect\"] == \"killed\")\n193|    narrowed = sum(1 for r in results if r[\"expect\"] == \"killed\")\n194|    survived_ok = sum(1 for r in results if r[\"verdict\"] == \"SURVIVED\" and r[\"expect\"] == \"survived\")\n195|    survived_total = sum(1 for r in results if r[\"expect\"] == \"survived\")\n196|    not_applied = sum(1 for r in results if r[\"verdict\"] == \"NOT_APPLIED\")\n197|    harness_fail = sum(1 for r in results if r[\"verdict\"] == \"COMPILE_OR_HARNESS_FAILURE\")\n198|    summary[\"numerator\"] = \"%d of %d narrowing mutants killed\" % (killed, narrowed)\n199|    summary[\"control\"] = \"%d of %d survived controls applied\" % (survived_ok, survived_total)\n200|    summary[\"not_applied\"] = not_applied\n201|    summary[\"compile_or_harness_failure\"] = harness_fail\n202|    expectations_met = all(\n203|        (r[\"verdict\"] == \"KILLED\") if r[\"expect\"] == \"killed\" else (r[\"verdict\"] == \"SURVIVED\")\n204|        for r in results\n205|    )\n206|    summary[\"expectations_met\"] = expectations_met\n207|    with open(os.path.join(log_dir, \"summary.json\"), \"w\", encoding=\"utf-8\") as handle:\n208|        json.dump(summary, handle, indent=2, sort_keys=True)\n209|        handle.write(\"\\n\")\n210|    print(\"narrowing: %s | control: %s | not_applied: %d | harness_failure: %d\" % (\n211|        summary[\"numerator\"], summary[\"control\"], not_applied, harness_fail))\n212|    for record in results:\n213|        print(\"%-22s %-28s expect=%-8s detail=%s\" % (\n214|            record[\"name\"], record[\"verdict\"], record[\"expect\"], record.get(\"detail\", \"\")))\n215|    return 0 if expectations_met else 1\n216|\n217|\n218|if __name__ == \"__main__\":\n219|    sys.exit(main())","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6ad","stream":{"kind":"session","id":"01a0adbc-2826-7673-94d4-717956fa0d32"},"sequence":433,"recorded_at":1780531400000861,"record_type":"event","durability":"durable","causation_id":"9162595d-8e13-449e-aede-0d31dd41754b","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9162595d-8e13-449e-aede-0d31dd41754b","run_stream":{"kind":"run","id":"9162595d-8e13-449e-aede-0d31dd41754b"},"task_stream":{"kind":"task","id":"01a0adbc-f227-7e42-92ee-01088ce5226e"},"task_id":"01a0adbc-f227-7e42-92ee-01088ce5226e","event":{"kind":"completed","task_id":"01a0adbc-f227-7e42-92ee-01088ce5226e"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6af","stream":{"kind":"session","id":"01a0adbc-2826-7673-94d4-717956fa0d32"},"sequence":434,"recorded_at":1780531400000863,"record_type":"event","durability":"durable","causation_id":"9162595d-8e13-449e-aede-0d31dd41754b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"9162595d-8e13-449e-aede-0d31dd41754b","run_stream":{"kind":"run","id":"9162595d-8e13-449e-aede-0d31dd41754b"},"call_id":"call_01a0adbcee517788a6323d3ff1ede294","text":"Read text file `internal/sessckpt/store.go`.\n(99 line(s) above)\n100|// installBlob installs one content-addressed blob idempotently\n101|// through the no-replace open first: a fresh path is created\n102|// atomically, and only an EEXIST loser falls back to comparing\n103|// against the winner's bytes — identical bytes are reused,\n104|// disagreeing bytes report the torn store for refusal. Leading\n105|// with the exclusive create (instead of stat-then-act) keeps the\n106|// no-replace property a filesystem fact under a second process,\n107|// not a check-then-act race the store mutex cannot see: the mutex\n108|// serializes one process, while O_EXCL serializes all of them.\n109|func installBlob(path string, data []byte) error {\n110|\tif err := writeExclusive(path, data); err == nil {\n111|\t\treturn syncDirectory(filepath.Dir(path))\n112|\t} else if !os.IsExist(err) {\n113|\t\treturn fmt.Errorf(\"install checkpoint blob: %w\", err)\n114|\t}\n115|\texisting, readErr := os.ReadFile(path)\n116|\tif readErr != nil {\n117|\t\treturn fmt.Errorf(\"read checkpoint blob for compare: %w\", readErr)\n118|\t}\n119|\tif string(existing) != string(data) {\n120|\t\treturn fmt.Errorf(\"%w: digest path holds disagreeing bytes\", ErrCheckpointConflict)\n121|\t}\n122|\treturn nil\n123|}\n124|\n125|// writeExclusive installs bytes at a path that must not exist. The\n126|// no-replace open makes append-only a filesystem property, not a\n127|// convention. Bytes fsync before close so a crash never leaves a\n128|// torn prefix behind.\n129|func writeExclusive(path string, data []byte) error {\n130|\tfile, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)\n131|\tif err != nil {\n132|\t\treturn err\n133|\t}\n134|\tif _, err := file.Write(data); err != nil {\n135|\t\t_ = file.Close()\n136|\t\treturn fmt.Errorf(\"write exclusive file: %w\", err)\n137|\t}\n138|\tif err := file.Sync(); err != nil {\n139|\t\t_ = file.Close()\n140|\t\treturn fmt.Errorf(\"fsync exclusive file: %w\", err)\n141|\t}\n142|\tif err := file.Close(); err != nil {\n143|\t\treturn fmt.Errorf(\"close exclusive file: %w\", err)\n144|\t}\n145|\treturn nil\n146|}\n147|\n148|// syncDirectory fsyncs a directory so an install inside it survives\n149|// a crash. Opening a directory fails on Windows, where the install\n150|// itself is the durability boundary; there the sync is skipped,\n151|// never faked.\n152|func syncDirectory(path string) error {\n153|\tif runtime.GOOS == \"windows\" {\n154|\t\treturn nil\n155|\t}\n156|\tdirectory, err := os.Open(path)\n157|\tif err != nil {\n158|\t\treturn fmt.Errorf(\"open directory for fsync: %w\", err)\n159|\t}\n160|\tdefer func() { _ = directory.Close() }()\n161|\tif err := directory.Sync(); err != nil {\n162|\t\treturn fmt.Errorf(\"fsync directory: %w\", err)\n163|\t}\n164|\treturn nil\n165|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6b1","stream":{"kind":"session","id":"01a0adbc-2826-7673-94d4-717956fa0d32"},"sequence":435,"recorded_at":1780531400000865,"record_type":"event","durability":"durable","causation_id":"9162595d-8e13-449e-aede-0d31dd41754b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"9162595d-8e13-449e-aede-0d31dd41754b","run_stream":{"kind":"run","id":"9162595d-8e13-449e-aede-0d31dd41754b"},"call_id":"call_01a0adbcef5777b0a2b4a07e7937aadf","text":"Read text file `internal/sessckpt/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for internal/sessckpt (TASK-260830-14yo67).\n3|\n4|Each plant weakens exactly one production gate so it admits one\n5|member of the class the gate must reject; the named killer test\n6|must then FAIL (mutant KILLED). A delete-only mutant proves only\n7|that the gate exists and is never accepted as evidence, so every\n8|plant here preserves the gate and narrows it. The evidence-enum\n9|plant additionally preserves every searched-for token while\n10|changing behavior.\n11|\n12|One harmless SURVIVED control (a comment-only edit) proves the\n13|harness reports survival instead of silently passing.\n14|\n15|Usage (from the repository root):\n16|\n17|    PYTHONDONTWRITEBYTECODE=1 python3 internal/sessckpt/mutant_harness.py \\\n18|        --log-dir .temp/TASK-260830-14yo67/mutants\n19|\n20|For every plant the harness writes the raw per-plant subprocess\n21|log to <log-dir>/<name>.log (command, return code, full output)\n22|plus <log-dir>/summary.json. A plant whose anchor occurs zero or\n23|multiple times is reported NOT_APPLIED; a plant that breaks the\n24|build or matches no test is reported COMPILE_OR_HARNESS_FAILURE.\n25|Both stay outside the killed numerator. The process exits nonzero\n26|unless every killed-expectation is KILLED and every\n27|survived-expectation SURVIVED.\n28|\"\"\"\n29|\n30|import argparse\n31|import json\n32|import os\n33|import subprocess\n34|import sys\n35|\n36|PACKAGE = \"./internal/sessckpt/\"\n37|\n38|PLANTS = [\n39|    {\n40|        \"name\": \"N-bg-idle\",\n41|        \"gate\": \"quiescence (safe_boundary.background_idle)\",\n42|        \"file\": \"internal/sessckpt/capture.go\",\n43|        \"old\": \"\\tif !boundary.BackgroundIdle {\",\n44|        \"new\": \"\\tif !boundary.BackgroundIdle && boundary.OpenProcesses != 0 {\",\n45|        \"run\": \"TestCaptureRefusesNonQuiescentBoundary/cp_n1_background_idle_false\",\n46|        \"expect\": \"killed\",\n47|    },\n48|    {\n49|        \"name\": \"N-both-present\",\n50|        \"gate\": \"variant presence (exactly one persistence leg)\",\n51|        \"file\": \"internal/sessckpt/capture.go\",\n52|        \"old\": \"\\tif hasProvider == hasBoard {\",\n53|        \"new\": \"\\tif !hasProvider && !hasBoard {\",\n54|        \"run\": \"TestCaptureRefusesBadPersistenceVariant/cp_n3_both_present\",\n55|        \"expect\": \"killed\",\n56|    },\n57|    {\n58|        \"name\": \"N-swapped-direct\",\n59|        \"gate\": \"kind-selected variant (direct takes provider)\",\n60|        \"file\": \"internal/sessckpt/capture.go\",\n61|        \"old\": \"\\t\\tif !hasProvider || hasBoard {\",\n62|        \"new\": \"\\t\\tif !hasProvider && !hasBoard {\",\n63|        \"run\": \"TestCaptureRefusesBadPersistenceVariant/swapped_direct_takes_bundle\",\n64|        \"expect\": \"killed\",\n65|    },\n66|    {\n67|        \"name\": \"N-duplicate-heads\",\n68|        \"gate\": \"event-head sorted-unique order\",\n69|        \"file\": \"internal/sessckpt/capture.go\",\n70|        \"old\": \"\\t\\tif len(out) > 0 && name <= previous {\",\n71|        \"new\": \"\\t\\tif len(out) > 0 && name < previous {\",\n72|        \"run\": \"TestCaptureRefusesMalformedHeads/duplicated\",\n73|        \"expect\": \"killed\",\n74|    },\n75|    {\n76|        \"name\": \"N-later-epoch-head\",\n77|        \"gate\": \"event-head at-or-before owning lease (epoch arm)\",\n78|        \"file\": \"internal/sessckpt/capture.go\",\n79|        \"old\": \"\\t\\tif summary.LeaseEpoch > inputs.LeaseEpoch {\",\n80|        \"new\": \"\\t\\tif summary.LeaseEpoch > inputs.LeaseEpoch+1 {\",\n81|        \"run\": \"TestCaptureRefusesLaterLeaseHead\",\n82|        \"expect\": \"killed\",\n83|    },\n84|    {\n85|        \"name\": \"N-idempotency-session\",\n86|        \"gate\": \"same-operation moved-inputs conflict\",\n87|        \"file\": \"internal/sessckpt/capture.go\",\n88|        \"old\": (\n89|            \"\\t\\tif recorded.InputDigest != inputDigest {\\n\"\n90|            '\\t\\t\\treturn CheckpointRef{}, nil, fmt.Errorf(\"%w: operation %s captured different inputs (idempotency_mismatch)\",\\n'\n91|        ),\n92|        \"new\": (\n93|            \"\\t\\tif recorded.InputDigest != inputDigest && recorded.SessionID != session {\\n\"\n94|            '\\t\\t\\treturn CheckpointRef{}, nil, fmt.Errorf(\"%w: operation %s captured different inputs (idempotency_mismatch)\",\\n'\n95|        ),\n96|        \"run\": \"TestCaptureWithMovedInputsRefuses\",\n97|        \"expect\": \"killed\",\n98|    },\n99|    {\n100|        \"name\": \"N-evidence-enum\",\n101|        \"gate\": \"safe_boundary evidence closed enum (token-preserving)\",\n102|        \"file\": \"internal/sessckpt/capture.go\",\n103|        \"old\": \"\\tcase EvidenceProviderAPI, EvidenceProviderEvent, EvidenceManagedPTY, EvidenceTaskBoardBridge, EvidenceAcceptedTest:\",\n104|        \"new\": '\\tcase EvidenceProviderAPI, EvidenceProviderEvent, EvidenceManagedPTY, EvidenceTaskBoardBridge, EvidenceAcceptedTest, \"provider_gossip\":',\n105|        \"run\": \"TestCaptureRefusesMalformedClosureMembers/bad_evidence\",\n106|        \"expect\": \"killed\",\n107|    },\n108|    {\n109|        \"name\": \"C-harmless-comment\",\n110|        \"gate\": \"control: comment-only edit, behavior unchanged\",\n111|        \"file\": \"internal/sessckpt/doc.go\",\n112|        \"old\": \"// Authority: relux-works/agent-session-manager-spec@v0.6.0, Sections 5.4\",\n113|        \"new\": \"// Authority: relux-works/agent-session-manager-spec@v0.6.0; Sections 5.4\",\n114|        \"run\": \"TestCaptureDirectInstallsAttestedRecord\",\n115|        \"expect\": \"survived\",\n116|    },\n117|]\n118|\n119|\n120|def run_plant(root, log_dir, plant):\n121|    path = os.path.join(root, plant[\"file\"])\n122|    with open(path, \"r\", encoding=\"utf-8\") as handle:\n123|        original = handle.read()\n124|    occurrences = original.count(plant[\"old\"])\n125|    record = {\n126|        \"name\": plant[\"name\"],\n127|        \"gate\": plant[\"gate\"],\n128|        \"file\": plant[\"file\"],\n129|        \"run\": plant[\"run\"],\n130|        \"expect\": plant[\"expect\"],\n131|    }\n132|    log_path = os.path.join(log_dir, plant[\"name\"] + \".log\")\n133|    if occurrences != 1:\n134|        record[\"verdict\"] = \"NOT_APPLIED\"\n135|        record[\"detail\"] = \"anchor occurs %d times, want exactly 1\" % occurrences\n136|        with open(log_path, \"w\", encoding=\"utf-8\") as handle:\n137|            handle.write(\"NOT_APPLIED: %s\\n\" % record[\"detail\"])\n138|        return record\n139|    mutated = original.replace(plant[\"old\"], plant[\"new\"], 1)\n140|    with open(path, \"w\", encoding=\"utf-8\") as handle:\n141|        handle.write(mutated)\n142|    try:\n143|        command = [\"go\", \"test\", PACKAGE, \"-run\", plant[\"run\"], \"-count=1\"]\n144|        completed = subprocess.run(\n145|            command,\n146|            cwd=root,\n147|            stdout=subprocess.PIPE,\n148|            stderr=subprocess.STDOUT,\n149|            text=True,\n150|            timeout=300,\n151|        )\n152|        output = completed.stdout\n153|        with open(log_path, \"w\", encoding=\"utf-8\") as handle:\n154|            handle.write(\"$ %s\\n\" % \" \".join(command))\n155|            handle.write(\"returncode: %d\\n\" % completed.returncode)\n156|            handle.write(output)\n157|        record[\"returncode\"] = completed.returncode\n158|        record[\"log\"] = log_path\n159|        if \"no tests to run\" in output or \"no test files\" in output:\n160|            record[\"verdict\"] = \"COMPILE_OR_HARNESS_FAILURE\"\n161|            record[\"detail\"] = \"killer matched no test\"\n162|        elif \"build failed\" in output:\n163|            record[\"verdict\"] = \"COMPILE_OR_HARNESS_FAILURE\"\n164|            record[\"detail\"] = \"plant broke compilation\"\n165|        elif completed.returncode != 0:\n166|            record[\"verdict\"] = \"KILLED\"\n167|            record[\"detail\"] = \"killer test failed under the plant\"\n168|        else:\n169|            record[\"verdict\"] = \"SURVIVED\"\n170|            record[\"detail\"] = \"killer test passed under the plant\"\n171|    except subprocess.TimeoutExpired:\n172|        record[\"verdict\"] = \"COMPILE_OR_HARNESS_FAILURE\"\n173|        record[\"detail\"] = \"subprocess timed out\"\n174|        with open(log_path, \"w\", encoding=\"utf-8\") as handle:\n175|            handle.write(\"TIMEOUT\\n\")\n176|    finally:\n177|        with open(path, \"w\", encoding=\"utf-8\") as handle:\n178|            handle.write(original)\n179|    return record\n180|\n181|\n182|def main():\n183|    parser = argparse.ArgumentParser(description=\"sessckpt narrowing-mutant harness\")\n184|    parser.add_argument(\"--log-dir\", required=True, help=\"directory for per-plant raw logs\")\n185|    parser.add_argument(\"--root\", default=\".\", help=\"repository root\")\n186|    args = parser.parse_args()\n187|    root = os.path.abspath(args.root)\n188|    log_dir = args.log_dir if os.path.isabs(args.log_dir) else os.path.join(root, args.log_dir)\n189|    os.makedirs(log_dir, exist_ok=True)\n190|    results = [run_plant(root, log_dir, plant) for plant in PLANTS]\n191|    summary = {\"plants\": results}\n192|    killed = sum(1 for r in results if r[\"verdict\"] == \"KILLED\" and r[\"expect\"] == \"killed\")\n193|    narrowed = sum(1 for r in results if r[\"expect\"] == \"killed\")\n194|    survived_ok = sum(1 for r in results if r[\"verdict\"] == \"SURVIVED\" and r[\"expect\"] == \"survived\")\n195|    survived_total = sum(1 for r in results if r[\"expect\"] == \"survived\")\n196|    not_applied = sum(1 for r in results if r[\"verdict\"] == \"NOT_APPLIED\")\n197|    harness_fail = sum(1 for r in results if r[\"verdict\"] == \"COMPILE_OR_HARNESS_FAILURE\")\n198|    summary[\"numerator\"] = \"%d of %d narrowing mutants killed\" % (killed, narrowed)\n199|    summary[\"control\"] = \"%d of %d survived controls applied\" % (survived_ok, survived_total)\n200|    summary[\"not_applied\"] = not_applied\n201|    summary[\"compile_or_harness_failure\"] = harness_fail\n202|    expectations_met = all(\n203|        (r[\"verdict\"] == \"KILLED\") if r[\"expect\"] == \"killed\" else (r[\"verdict\"] == \"SURVIVED\")\n204|        for r in results\n205|    )\n206|    summary[\"expectations_met\"] = expectations_met\n207|    with open(os.path.join(log_dir, \"summary.json\"), \"w\", encoding=\"utf-8\") as handle:\n208|        json.dump(summary, handle, indent=2, sort_keys=True)\n209|        handle.write(\"\\n\")\n210|    print(\"narrowing: %s | control: %s | not_applied: %d | harness_failure: %d\" % (\n211|        summary[\"numerator\"], summary[\"control\"], not_applied, harness_fail))\n212|    for record in results:\n213|        print(\"%-22s %-28s expect=%-8s detail=%s\" % (\n214|            record[\"name\"], record[\"verdict\"], record[\"expect\"], record.get(\"detail\", \"\")))\n215|    return 0 if expectations_met else 1\n216|\n217|\n218|if __name__ == \"__main__\":\n219|    sys.exit(main())","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
