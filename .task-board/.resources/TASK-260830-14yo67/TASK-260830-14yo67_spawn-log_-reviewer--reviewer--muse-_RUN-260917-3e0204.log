{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cd9f","stream":{"kind":"session","id":"01a0adbc-2826-7673-94d4-717956fa0d32"},"sequence":1322,"recorded_at":1780531400002639,"record_type":"event","durability":"durable","causation_id":"9162595d-8e13-449e-aede-0d31dd41754b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9162595d-8e13-449e-aede-0d31dd41754b","run_stream":{"kind":"run","id":"9162595d-8e13-449e-aede-0d31dd41754b"},"task_stream":{"kind":"task","id":"01a0adc4-cae0-7642-b788-274747264552"},"task_id":"01a0adc4-cae0-7642-b788-274747264552","event":{"kind":"output","task_id":"01a0adc4-cae0-7642-b788-274747264552","chunk":"{\n  \"chunk_id\": \"exec-34-1\",\n  \"command\": \"cd /tmp/ckiso && python3 - <<'EOF'\\nimport subprocess\\nfor name, old, new, run in [\\n    (\\\"R2c-open-processes\\\", \\\"\\\\tif boundary.OpenProcesses != 0 {\\\", \\\"\\\\tif boundary.OpenProcesses > 1 {\\\",\\n     \\\"TestCaptureRefusesNonQuiescentBoundary/open_processes_nonzero\\\"),\\n    (\\\"R2d-empty-version\\\", \\\"\\\\tif length := runeCount(boundary.ProviderVersion); length < 1 || length > 128 {\\\",\\n     \\\"\\\\tif length := runeCount(boundary.ProviderVersion); length > 128 {\\\",\\n     \\\"TestCaptureRefusesMalformedClosureMembers/empty_provider_version\\\"),\\n]:\\n    path = \\\"internal/sessckpt/capture.go\\\"\\n    src = open(path).read()\\n    assert src.count(old) == 1, (name, src.count(old))\\n    open(path, \\\"w\\\").write(src.replace(old, new, 1))\\n    try:\\n        c = subprocess.run([\\\"go\\\", \\\"test\\\", \\\"./internal/sessckpt/\\\", \\\"-run\\\", run, \\\"-count=1\\\"],\\n                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=300)\\n        open(\\\"/tmp/rev1/iso-review-mutants/%s.log\\\" % name, \\\"w\\\").write(\\n            \\\"$ go test ./internal/sessckpt/ -run %s -count=1\\\\nreturncode: %d\\\\n%s\\\" % (run, c.returncode, c.stdout))\\n        print(name, \\\"KILLED\\\" if c.returncode != 0 else \\\"SURVIVED\\\", \\\"rc=%d\\\" % c.returncode)\\n    finally:\\n        open(path, \\\"w\\\").write(src)\\nEOF\",\n  \"description\": \"Plant counter and version narrowing mutants\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"R2c-open-processes KILLED rc=1\\nR2d-empty-version SURVIVED rc=0\\n\",\n  \"original_output_bytes\": 63,\n  \"original_output_tokens\": 16,\n  \"truncated\": false\n}","final_result":true}}}
