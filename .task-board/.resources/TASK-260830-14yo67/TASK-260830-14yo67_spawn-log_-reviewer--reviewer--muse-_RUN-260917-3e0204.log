ease || plan.OwnerHostID != testHostA {\n417|\t\tt.Fatalf(\"plan triple: %+v\", plan)\n418|\t}\n419|\tif err := reader.Revalidate(plan); err != nil {\n420|\t\tt.Fatalf(\"captured plan is not current: %v\", err)\n421|\t}\n422|}\n423|\n424|func TestCaptureSuccessorAdmitsThroughConsumer(t *testing.T) {\n425|\tchain, created := chainFixture(t)\n426|\tlaunched := appendChainEvent(t, chain, \"provider.launched\", 1, testLease, 2, created, map[string]any{\n427|\t\t\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\",\n428|\t\t\"profile_source_event_id\": nil, \"profile_mapping\": \"default\",\n429|\t})\n430|\t// The transfer event restarts the lease sequence under the new\n431|\t// epoch, mirroring the landed succession fixtures.\n432|\t_ = appendChainEvent(t, chain, \"lease.transferred\", 2, testLeaseB, 1, launched, map[string]any{\n433|\t\t\"operation_id\": testHostB, \"from_host_id\": testHostA, \"to_host_id\": testHostA,\n434|\t\t\"predecessor_lease_id\": testLease, \"new_lease_id\": testLeaseB,\n435|\t})\n436|\tstore := openTestStore(t)\n437|\t// The checkpoint is taken under the epoch-1 predecessor and\n438|\t// names the latest epoch-1 head; the epoch-2 successor names\n439|\t// it for its session and predecessor lease.\n440|\tref, raw := mustCapture(t, store, chain, testInputs([]string{launched}, testOpA))\n441|\treader := &sessquery.Reader{Local: chain, LocalHostID: testHostA}\n442|\treader.CheckpointRecords = append(reader.CheckpointRecords, raw)\n443|\treader.LeaseRecords = append(reader.LeaseRecords,\n444|\t\tleaseCreateBytes(t, testLease, testHostA),\n445|\t\tleaseSuccessorBytes(t, testLeaseB, testLease, ref.CheckpointID),\n446|\t)\n447|\tplan, err := reader.BuildPlan(sessquery.PlanArgs{Selector: \"alpha\", Action: sessquery.ActionStatus})\n448|\tif err != nil {\n449|\t\tt.Fatalf(\"BuildPlan(successor over captured checkpoint) error = %v\", err)\n450|\t}\n451|\tif plan.LeaseEpoch != 2 || plan.LeaseID != testLeaseB {\n452|\t\tt.Fatalf(\"successor plan: %+v\", plan)\n453|\t}\n454|\tif err := reader.Revalidate(plan); err != nil {\n455|\t\tt.Fatalf(\"successor plan is not current: %v\", err)\n456|\t}\n457|}\n458|\n459|// leaseCreateBytes builds the epoch-1 create lease with no\n460|// checkpoint reference.\n461|func leaseCreateBytes(t *testing.T, leaseID, holder string) []byte {\n462|\tt.Helper()\n463|\tvalue := map[string]any{\n464|\t\t\"schema\": \"urn:ax:schema:lease\", \"schema_version\": \"1.0.0\", \"record_id\": zeroDigest,\n465|\t\t\"subject_id\": testSessionID, \"session_id\": testSessionID, \"lease_id\": leaseID, \"epoch\": float64(1),\n466|\t\t\"holder_host_id\": holder, \"predecessor_lease_id\": nil, \"reason\": \"create\",\n467|\t\t\"checkpoint_id\": nil, \"issued_by_host_id\": holder, \"created_by_host_id\": holder,\n468|\t\t\"created_at\": \"2026-08-19T04:09:00.000Z\", \"extensions\": map[string]any{},\n469|\t}\n470|\treturn identify(t, value, \"record_id\")\n471|}\n472|\n473|// leaseSuccessorBytes builds the epoch-2 successor naming its\n474|// predecessor and the captured checkpoint digest.\n475|func leaseSuccessorBytes(t *testing.T, leaseID, predecessor, checkpoint string) []byte {\n476|\tt.Helper()\n477|\tvalue := map[string]any{\n478|\t\t\"schema\": \"urn:ax:schema:lease\", \"schema_version\": \"1.0.0\", \"record_id\": zeroDigest,\n479|\t\t\"subject_id\": testSessionID, \"session_id\": testSessionID, \"lease_id\": leaseID, \"epoch\": float64(2),\n480|\t\t\"holder_host_id\": testHostA, \"predecessor_lease_id\": predecessor, \"reason\": \"graceful_takeover\",\n481|\t\t\"checkpoint_id\": checkpoint, \"issued_by_host_id\": testHostA, \"created_by_host_id\": testHostA,\n482|\t\t\"created_at\": \"2026-08-19T04:09:00.000Z\", \"extensions\": map[string]any{},\n483|\t}\n484|\treturn identify(t, value, \"record_id\")\n485|}\n486|\n487|func TestCaptureWrongCreatorRefusedByConsumer(t *testing.T) {\n488|\tchain, created := chainFixture(t)\n489|\tstore := openTestStore(t)\n490|\t// Capture records exactly what the caller declares: a creator\n491|\t// that is not the owning lease holder stays publishable here\n492|\t// and is refused at admission by the consumer's\n493|\t// creator-holder gate.\n494|\tinputs := testInputs([]string{created}, testOpA)\n495|\tinputs.CreatorHostID = testHostB\n496|\t_, raw := mustCapture(t, store, chain, inputs)\n497|\treader := &sessquery.Reader{Local: chain, LocalHostID: testHostA}\n498|\treader.CheckpointRecords = append(reader.CheckpointRecords, raw)\n499|\tcheckpointID := checkpointIDOf(t, raw)\n500|\treader.LeaseRecords = append(reader.LeaseRecords, leaseRecordBytes(t, testLease, testHostA, checkpointID))\n501|\tif _, err := reader.BuildPlan(sessquery.PlanArgs{Selector: \"alpha\", Action: sessquery.ActionStatus}); !errors.Is(err, sessquery.ErrObservationUnavailable) {\n502|\t\tt.Fatalf(\"wrong-creator build = %v, want selector_observation_unavailable\", err)\n503|\t}\n504|}\n505|\n506|func checkpointIDOf(t *testing.T, raw []byte) string {\n507|\tt.Helper()\n508|\tvar value map[string]any\n509|\tif err := json.Unmarshal(raw, &value); err != nil {\n510|\t\tt.Fatal(err)\n511|\t}\n512|\tid, _ := value[\"checkpoint_id\"].(string)\n513|\tif id == \"\" {\n514|\t\tt.Fatalf(\"captured record carries no checkpoint_id\")\n515|\t}\n516|\treturn id\n517|}\n518|\n519|func TestAdmitRawRecordRoundTrip(t *testing.T) {\n520|\tchain, created := chainFixture(t)\n521|\tstore := openTestStore(t)\n522|\t_, raw := mustCapture(t, store, chain, testInputs([]string{created}, testOpA))\n523|\t// The same bytes admitted under a fresh operation install\n524|\t// through the same durable path.\n525|\tadmitted, err := store.Admit(chain, raw, testOpB, SessionKindDirect)\n526|\tif err != nil {\n527|\t\tt.Fatalf(\"Admit error = %v\", err)\n528|\t}\n529|\tif admitted.CheckpointID != checkpointIDOf(t, raw) {\n530|\t\tt.Fatalf(\"admitted %q, want %q\", admitted.CheckpointID, checkpointIDOf(t, raw))\n531|\t}\n532|\tstored, err := store.Get(admitted.CheckpointID)\n533|\tif err != nil {\n534|\t\tt.Fatalf(\"Get error = %v\", err)\n535|\t}\n536|\tif string(stored) != string(raw) {\n537|\t\tt.Fatalf(\"admitted bytes differ from captured bytes\")\n538|\t}\n539|\t// A byte-identical re-admit replays the recorded result.\n540|\tagain, err := store.Admit(chain, raw, testOpB, SessionKindDirect)\n541|\tif err != nil {\n542|\t\tt.Fatalf(\"re-admit error = %v\", err)\n543|\t}\n544|\tif again != admitted {\n545|\t\tt.Fatalf(\"re-admit = %+v, want %+v\", again, admitted)\n546|\t}\n547|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
