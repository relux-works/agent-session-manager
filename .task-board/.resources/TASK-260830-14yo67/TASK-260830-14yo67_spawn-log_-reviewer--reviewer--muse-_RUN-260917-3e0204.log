{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9c7","stream":{"kind":"session","id":"01a0adbc-2826-7673-94d4-717956fa0d32"},"sequence":830,"recorded_at":1780531400001655,"record_type":"event","durability":"durable","causation_id":"9162595d-8e13-449e-aede-0d31dd41754b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9162595d-8e13-449e-aede-0d31dd41754b","run_stream":{"kind":"run","id":"9162595d-8e13-449e-aede-0d31dd41754b"},"task_stream":{"kind":"task","id":"01a0adc0-b85d-74d1-abe0-f869becdbca5"},"task_id":"01a0adc0-b85d-74d1-abe0-f869becdbca5","event":{"kind":"output","task_id":"01a0adc0-b85d-74d1-abe0-f869becdbca5","chunk":"Read text file `internal/sessckpt/crash_unix_test.go`.\n1|//go:build darwin || linux\n2|\n3|package sessckpt\n4|\n5|import (\n6|\t\"context\"\n7|\t\"errors\"\n8|\t\"os\"\n9|\t\"os/exec\"\n10|\t\"syscall\"\n11|\t\"testing\"\n12|\t\"time\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n15|)\n16|\n17|// Real process-termination evidence for the crash boundary: the\n18|// child runs the genuine production Capture entry and SIGKILLs\n19|// itself between the checkpoint-blob install and the operation\n20|// receipt. The parent then proves the interrupted capture left no\n21|// partial record behind and the identical retry converges.\n22|//\n23|// The child rebuilds nothing: it opens the parent's repository\n24|// and store directories from the environment and derives the same\n25|// head from the chain, so its closure inputs are byte-identical\n26|// to the parent's retry by construction.\n27|const (\n28|\tcrashChildEnv   = \"AX_SESSCKPT_CRASH_CHILD\"\n29|\tcrashChildRepo  = \"AX_SESSCKPT_CRASH_REPO\"\n30|\tcrashChildStore = \"AX_SESSCKPT_CRASH_STORE\"\n31|)\n32|\n33|func TestCaptureCrashChildSelfTerminates(t *testing.T) {\n34|\tif os.Getenv(crashChildEnv) == \"1\" {\n35|\t\tcaptureCrashChild()\n36|\t\treturn\n37|\t}\n38|\trepoDir := t.TempDir()\n39|\trepo, err := sessrepo.Open(repoDir)\n40|\tif err != nil {\n41|\t\tt.Fatal(err)\n42|\t}\n43|\trecord := decodeObject(t, specSessionRecord)\n44|\trecord[\"session_id\"], record[\"subject_id\"], record[\"name\"] = testSessionID, testSessionID, \"alpha\"\n45|\tidentified := identify(t, record, \"record_id\")\n46|\tref, err := repo.CreateSession(identified)\n47|\tif err != nil {\n48|\t\tt.Fatal(err)\n49|\t}\n50|\t_ = appendChainEvent(t, repo, \"session.created\", 1, testLease, 1, ref.RecordID, map[string]any{\n51|\t\t\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": testHostA, \"first_checkpoint_operation_id\": testHostB,\n52|\t})\n53|\tstoreDir := t.TempDir()\n54|\tif _, err := Open(storeDir); err != nil {\n55|\t\tt.Fatal(err)\n56|\t}\n57|\t// A bounded context keeps a hung child a test failure,\n58|\t// never a hung suite: the child must die at the boundary or\n59|\t// not return at all.\n60|\tctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)\n61|\tdefer cancel()\n62|\tchild := exec.CommandContext(ctx, os.Args[0],\n63|\t\t\"-test.run=^TestCaptureCrashChildSelfTerminates$\",\n64|\t\t\"-test.count=1\",\n65|\t)\n66|\tchild.Env = append(os.Environ(),\n67|\t\tcrashChildEnv+\"=1\",\n68|\t\tcrashChildRepo+\"=\"+repoDir,\n69|\t\tcrashChildStore+\"=\"+storeDir,\n70|\t)\n71|\trunErr := child.Run()\n72|\tvar exitErr *exec.ExitError\n73|\tif !errors.As(runErr, &exitErr) {\n74|\t\tt.Fatalf(\"child run = %v, want a signal-kill exit\", runErr)\n75|\t}\n76|\tstatus, ok := exitErr.Sys().(syscall.WaitStatus)\n77|\tif !ok || !status.Signaled() || status.Signal() != syscall.SIGKILL {\n78|\t\tt.Fatalf(\"child status = %v, want killed by SIGKILL\", exitErr)\n79|\t}\n80|\t// The kill landed between the blob and the receipt: one\n81|\t// complete blob that verifies, no receipt, no partial bytes.\n82|\tparent, err := Open(storeDir)\n83|\tif err != nil {\n84|\t\tt.Fatal(err)\n85|\t}\n86|\tif blobs, receipts := countFiles(t, parent); blobs != 1 || receipts != 0 {\n87|\t\tt.Fatalf(\"after SIGKILL: blobs = %d, receipts = %d, want 1, 0\", blobs, receipts)\n88|\t}\n89|\teveryFileVerifies(t, parent)\n90|\t// The identical retry converges on one checkpoint identity\n91|\t// with its receipt: the interrupted capture is resumed, not\n92|\t// duplicated.\n93|\tchain, err := sessrepo.Open(repoDir)\n94|\tif err != nil {\n95|\t\tt.Fatal(err)\n96|\t}\n97|\tevents, err := chain.ListEvents(testSessionID)\n98|\tif err != nil {\n99|\t\tt.Fatal(err)\n100|\t}\n101|\tif len(events) != 1 {\n102|\t\tt.Fatalf(\"chain events = %d, want the single bootstrap event\", len(events))\n103|\t}\n104|\trecovered, raw, err := parent.Capture(chain, testInputs([]string{events[0].EventID}, testOpA))\n105|\tif err != nil {\n106|\t\tt.Fatalf(\"retry Capture error = %v\", err)\n107|\t}\n108|\tif recovered.OperationID != testOpA {\n109|\t\tt.Fatalf(\"retry OperationID = %q\", recovered.OperationID)\n110|\t}\n111|\tstored, err := parent.Get(recovered.CheckpointID)\n112|\tif err != nil {\n113|\t\tt.Fatalf(\"Get after retry error = %v\", err)\n114|\t}\n115|\tif string(stored) != string(raw) {\n116|\t\tt.Fatalf(\"retry bytes differ from stored bytes\")\n117|\t}\n118|\tif blobs, receipts := countFiles(t, parent); blobs != 1 || receipts != 1 {\n119|\t\tt.Fatalf(\"after retry: blobs = %d, receipts = %d, want 1, 1\", blobs, receipts)\n120|\t}\n121|}\n122|\n123|// captureCrashChild runs the production Capture entry and kills\n124|// its own process at the AfterBlob boundary. It never returns.\n125|func captureCrashChild() {\n126|\trepo, err := sessrepo.Open(os.Getenv(crashChildRepo))\n127|\tif err != nil {\n128|\t\tos.Exit(64)\n129|\t}\n130|\tevents, err := repo.ListEvents(testSessionID)\n131|\tif err != nil || len(events) != 1 {\n132|\t\tos.Exit(65)\n133|\t}\n134|\tstore, err := Open(os.Getenv(crashChildStore))\n135|\tif err != nil {\n136|\t\tos.Exit(66)\n137|\t}\n138|\tstore.AfterBlob = func() error {\n139|\t\t_ = syscall.Kill(syscall.Getpid(), syscall.SIGKILL)\n140|\t\t// The kill is asynchronous under instrumentation: block\n141|\t\t// here so a delivered SIGKILL always wins the race\n142|\t\t// against process exit. If the kill failed, the parent\n143|\t\t// context times out and fails the test instead of\n144|\t\t// passing on a wrong exit.\n145|\t\tselect {}\n146|\t}\n147|\t_, _, _ = store.Capture(repo, testInputs([]string{events[0].EventID}, testOpA))\n148|\t// The hook must have fired: reaching here means the boundary\n149|\t// was skipped, so fail the parent with a clean exit.\n150|\tos.Exit(0)\n151|}","final_result":true}}}
