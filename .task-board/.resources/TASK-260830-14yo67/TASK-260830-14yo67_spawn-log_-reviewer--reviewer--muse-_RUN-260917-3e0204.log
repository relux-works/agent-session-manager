{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c995","stream":{"kind":"session","id":"01a0adbc-2826-7673-94d4-717956fa0d32"},"sequence":805,"recorded_at":1780531400001605,"record_type":"event","durability":"durable","causation_id":"9162595d-8e13-449e-aede-0d31dd41754b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9162595d-8e13-449e-aede-0d31dd41754b","run_stream":{"kind":"run","id":"9162595d-8e13-449e-aede-0d31dd41754b"},"task_stream":{"kind":"task","id":"01a0adc0-a564-7e53-b878-98bbbca8797b"},"task_id":"01a0adc0-a564-7e53-b878-98bbbca8797b","event":{"kind":"output","task_id":"01a0adc0-a564-7e53-b878-98bbbca8797b","chunk":"Read text file `internal/sessckpt/capture_test.go`.\n(249 line(s) above)\n250|func TestCaptureDirectInstallsAttestedRecord(t *testing.T) {\n251|\tchain, created := chainFixture(t)\n252|\tstore := openTestStore(t)\n253|\tref, raw := mustCapture(t, store, chain, testInputs([]string{created}, testOpA))\n254|\tif ref.OperationID != testOpA {\n255|\t\tt.Fatalf(\"OperationID = %q, want %q\", ref.OperationID, testOpA)\n256|\t}\n257|\tif _, err := scalar.ParseDigest(ref.CheckpointID); err != nil {\n258|\t\tt.Fatalf(\"CheckpointID %q: %v\", ref.CheckpointID, err)\n259|\t}\n260|\t// The installed bytes attest through the sessrepo owner with\n261|\t// the checkpoint self field.\n262|\tdigest, field, err := sessrepo.AttestCheckpointRecord(raw)\n263|\tif err != nil {\n264|\t\tt.Fatalf(\"AttestCheckpointRecord error = %v\", err)\n265|\t}\n266|\tif field != canonicaljson.SelfCheckpointID || digest.String() != ref.CheckpointID {\n267|\t\tt.Fatalf(\"attested %v %q, want checkpoint_id %q\", field, digest, ref.CheckpointID)\n268|\t}\n269|\t// Get returns the byte-identical record.\n270|\tstored, err := store.Get(ref.CheckpointID)\n271|\tif err != nil {\n272|\t\tt.Fatalf(\"Get error = %v\", err)\n273|\t}\n274|\tif string(stored) != string(raw) {\n275|\t\tt.Fatalf(\"Get returned %d bytes, want the %d captured bytes\", len(stored), len(raw))\n276|\t}\n277|\t// The closed member set matches the normative example exactly.\n278|\tvar example, got map[string]any\n279|\tif err := json.Unmarshal([]byte(specCheckpointExample), &example); err != nil {\n280|\t\tt.Fatal(err)\n281|\t}\n282|\tif err := json.Unmarshal(raw, &got); err != nil {\n283|\t\tt.Fatal(err)\n284|\t}\n285|\tfor key := range example {\n286|\t\tif _, ok := got[key]; !ok {\n287|\t\t\tt.Fatalf(\"captured record misses member %q\", key)\n288|\t\t}\n289|\t}\n290|\tfor key := range got {\n291|\t\tif _, ok := example[key]; !ok {\n292|\t\t\tt.Fatalf(\"captured record carries extra member %q\", key)\n293|\t\t}\n294|\t}\n295|}\n296|\n297|func TestCaptureTaskBoardVariantInstalls(t *testing.T) {\n298|\tchain, created := chainFixture(t)\n299|\tstore := openTestStore(t)\n300|\tinputs := testInputs([]string{created}, testOpA)\n301|\tinputs.SessionKind = SessionKindTaskBoard\n302|\tinputs.ProviderManifestID = \"\"\n303|\tinputs.TaskBoardBundleID = testBoardBundle\n304|\tref, raw := mustCapture(t, store, chain, inputs)\n305|\tif _, _, err := sessrepo.AttestCheckpointRecord(raw); err != nil {\n306|\t\tt.Fatalf(\"AttestCheckpointRecord error = %v\", err)\n307|\t}\n308|\tvar value map[string]any\n309|\tif err := json.Unmarshal(raw, &value); err != nil {\n310|\t\tt.Fatal(err)\n311|\t}\n312|\tif value[\"provider_manifest_id\"] != nil {\n313|\t\tt.Fatalf(\"task_board record provider_manifest_id = %v, want null\", value[\"provider_manifest_id\"])\n314|\t}\n315|\tif value[\"task_board_bundle_id\"] == nil {\n316|\t\tt.Fatalf(\"task_board record task_board_bundle_id is null, want %q\", testBoardBundle)\n317|\t}\n318|\tif ref.CheckpointID == \"\" {\n319|\t\tt.Fatalf(\"empty checkpoint id\")\n320|\t}\n321|}\n322|\n323|func TestSpecExampleAttestsThroughConsumerOwner(t *testing.T) {\n324|\t// The verbatim SPEC Section 5.4 normative example attests\n325|\t// through the same sessrepo owner the capture entry uses, so\n326|\t// the exact contract fixture and the implementation agree on\n327|\t// the closed shape.\n328|\tdigest, field, err := sessrepo.AttestCheckpointRecord([]byte(specCheckpointExample))\n329|\tif err != nil {\n330|\t\tt.Fatalf(\"AttestCheckpointRecord(spec example) error = %v\", err)\n331|\t}\n332|\tif field != canonicaljson.SelfCheckpointID {\n333|\t\tt.Fatalf(\"example identity field = %q, want checkpoint_id\", string(field))\n334|\t}\n335|\tif digest.String() != \"sha256:e051996f51f13ace4f5cdebe1e30fd26fd5fe104cfd6e6a7f9f1206ba3819656\" {\n336|\t\tt.Fatalf(\"example digest = %q\", digest)\n337|\t}\n338|}\n339|\n340|func TestCaptureIdenticalClosuresShareIdentity(t *testing.T) {\n341|\tchain, created := chainFixture(t)\n342|\tstore := openTestStore(t)\n343|\tfirst, _ := mustCapture(t, store, chain, testInputs([]string{created}, testOpA))\n344|\t// A different operation over the identical closure mints no\n345|\t// second identity: the checkpoint digest is a pure function\n346|\t// of the closure.\n347|\tsecond, _ := mustCapture(t, store, chain, testInputs([]string{created}, testOpB))\n348|\tif first.CheckpointID != second.CheckpointID {\n349|\t\tt.Fatalf(\"identical closures share no identity: %q vs %q\", first.CheckpointID, second.CheckpointID)\n350|\t}\n351|\tif first.OperationID == second.OperationID {\n352|\t\tt.Fatalf(\"operations collide: %q\", first.OperationID)\n353|\t}\n354|}\n355|\n356|func TestCaptureMovedInputsChangeIdentity(t *testing.T) {\n357|\tchain, created := chainFixture(t)\n358|\tstore := openTestStore(t)\n359|\tfirst, _ := mustCapture(t, store, chain, testInputs([]string{created}, testOpA))\n360|\t// The same checkpoint with different inputs is a different\n361|\t// checkpoint: moving one manifest leg changes the digest.\n362|\tmoved := testInputs([]string{created}, testOpB)\n363|\tmoved.WorkspaceManifestID = testOtherManifest\n364|\tsecond, _ := mustCapture(t, store, chain, moved)\n365|\tif first.CheckpointID == second.CheckpointID {\n366|\t\tt.Fatalf(\"moved inputs kept identity %q\", first.CheckpointID)\n367|\t}\n368|}\n369|\n370|func TestCaptureReplayIsIdempotent(t *testing.T) {\n371|\tchain, created := chainFixture(t)\n372|\tstore := openTestStore(t)\n373|\tinputs := testInputs([]string{created}, testOpA)\n374|\tfirst, firstRaw := mustCapture(t, store, chain, inputs)\n375|\tsecond, secondRaw, err := store.Capture(chain, inputs)\n376|\tif err != nil {\n377|\t\tt.Fatalf(\"replay Capture error = %v\", err)\n378|\t}\n379|\tif first != second {\n380|\t\tt.Fatalf(\"replay ref = %+v, want %+v\", second, first)\n381|\t}\n382|\tif string(firstRaw) != string(secondRaw) {\n383|\t\tt.Fatalf(\"replay returned different bytes\")\n384|\t}\n385|\t// Exactly one blob and one receipt exist: the replay wrote\n386|\t// nothing.\n387|\tblobs, err := filepath.Glob(filepath.Join(store.root, \"*.json\"))\n388|\tif err != nil {\n389|\t\tt.Fatal(err)\n390|\t}\n391|\tif len(blobs) != 1 {\n392|\t\tt.Fatalf(\"blobs = %d, want 1\", len(blobs))\n393|\t}\n394|\treceipts, err := filepath.Glob(filepath.Join(store.root, \"operations\", \"*.json\"))\n395|\tif err != nil {\n396|\t\tt.Fatal(err)\n397|\t}\n398|\tif len(receipts) != 1 {\n399|\t\tt.Fatalf(\"receipts = %d, want 1\", len(receipts))\n400|\t}\n401|}\n402|\n403|func TestCaptureAdmitsThroughWinningLeaseConsumer(t *testing.T) {\n404|\tchain, created := chainFixture(t)\n405|\tstore := openTestStore(t)\n406|\tref, raw := mustCapture(t, store, chain, testInputs([]string{created}, testOpA))\n407|\t// The captured record admits through the landed sessquery\n408|\t// consumer: an epoch-1 lease naming it builds and revalidates.\n409|\treader := &sessquery.Reader{Local: chain, LocalHostID: testHostA}\n410|\treader.CheckpointRecords = append(reader.CheckpointRecords, raw)\n411|\treader.LeaseRecords = append(reader.LeaseRecords, leaseRecordBytes(t, testLease, testHostA, ref.CheckpointID))\n412|\tplan, err := reader.BuildPlan(sessquery.PlanArgs{Selector: \"alpha\", Action: sessquery.ActionStatus})\n413|\tif err != nil {\n414|\t\tt.Fatalf(\"BuildPlan(captured checkpoint) error = %v\", err)\n415|\t}\n416|\tif plan.LeaseEpoch != 1 || plan.LeaseID != testLease || plan.OwnerHostID != testHostA {\n417|\t\tt.Fatalf(\"plan triple: %+v\", plan)\n418|\t}\n419|\tif err := reader.Revalidate(plan); err != nil {\n420|\t\tt.Fatalf(\"captured plan is not current: %v\", err)\n421|\t}\n422|}\n423|\n424|func TestCaptureSuccessorAdmitsThroughConsumer(t *testing.T) {\n425|\tchain, created := chainFixture(t)\n426|\tlaunched := appendChainEvent(t, chain, \"provider.launched\", 1, testLease, 2, created, map[string]any{\n427|\t\t\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\",\n428|\t\t\"profile_source_event_id\": nil, \"profile_mapping\": \"default\",\n429|\t})\n430|\t// The transfer event restarts the lease sequence under the new\n431|\t// epoch, mirroring the landed succession fixtures.\n432|\t_ = appendChainEvent(t, chain, \"lease.transferred\", 2, testLeaseB, 1, launched, map[string]any{\n433|\t\t\"operation_id\": testHostB, \"from_host_id\": testHostA, \"to_host_id\": testHostA,\n434|\t\t\"predecessor_lease_id\": testLease, \"new_lease_id\": testLeaseB,\n435|\t})\n436|\tstore := openTestStore(t)\n437|\t// The checkpoint is taken under the epoch-1 predecessor and\n438|\t// names the latest epoch-1 head; the epoch-2 successor names\n439|\t// it for its session and predecessor lease.\n440|\tref, raw := mustCapture(t, store, chain, testInputs([]string{launched}, testOpA))\n441|\treader := &sessquery.Reader{Local: chain, LocalHostID: testHostA}\n442|\treader.CheckpointRecords = append(reader.CheckpointRecords, raw)\n443|\treader.LeaseRecords = append(reader.LeaseRecords,\n444|\t\tleaseCreateBytes(t, testLease, testHostA),\n445|\t\tleaseSuccessorBytes(t, testLeaseB, testLease, ref.CheckpointID),\n446|\t)\n447|\tplan, err := reader.BuildPlan(sessquery.PlanArgs{Selector: \"alpha\", Action: sessquery.ActionStatus})\n448|\tif err != nil {\n449|\t\tt.Fatalf(\"BuildPlan(successor over captured checkpoint) error = %v\", err)\n450|\t}\n451|\tif plan.LeaseEpoch != 2 || plan.LeaseID != testLeaseB {\n452|\t\tt.Fatalf(\"successor plan: %+v\", plan)\n453|\t}\n454|\tif err := reader.Revalidate(plan); err != nil {\n455|\t\tt.Fatalf(\"successor plan is not current: %v\", err)\n456|\t}\n457|}\n458|\n459|// leaseCreateBytes builds the epoch-1 create lease with no\n460|// checkpoint reference.\n461|func leaseCreateBytes(t *testing.T, leaseID, holder string) []byte {\n462|\tt.Helper()\n463|\tvalue := map[string]any{\n464|\t\t\"schema\": \"urn:ax:schema:lease\", \"schema_version\": \"1.0.0\", \"record_id\": zeroDigest,\n465|\t\t\"subject_id\": testSessionID, \"session_id\": testSessionID, \"lease_id\": leaseID, \"epoch\": float64(1),\n466|\t\t\"holder_host_id\": holder, \"predecessor_lease_id\": nil, \"reason\": \"create\",\n467|\t\t\"checkpoint_id\": nil, \"issued_by_host_id\": holder, \"created_by_host_id\": holder,\n468|\t\t\"created_at\": \"2026-08-19T04:09:00.000Z\", \"extensions\": map[string]any{},\n469|\t}\n470|\treturn identify(t, value, \"record_id\")\n471|}\n472|\n473|// leaseSuccessorBytes builds the epoch-2 successor naming its\n474|// predecessor and the captured checkpoint digest.\n475|func leaseSuccessorBytes(t *testing.T, leaseID, predecessor, checkpoint string) []byte {\n476|\tt.Helper()\n477|\tvalue := map[string]any{\n478|\t\t\"schema\": \"urn:ax:schema:lease\", \"schema_version\": \"1.0.0\", \"record_id\": zeroDigest,\n479|\t\t\"subject_id\": testSessionID, \"session_id\": testSessionID, \"lease_id\": leaseID, \"epoch\": float64(2),\n480|\t\t\"holder_host_id\": testHostA, \"predecessor_lease_id\": predecessor, \"reason\": \"graceful_takeover\",\n481|\t\t\"checkpoint_id\": checkpoint, \"issued_by_host_id\": testHostA, \"created_by_host_id\": testHostA,\n482|\t\t\"created_at\": \"2026-08-19T04:09:00.000Z\", \"extensions\": map[string]any{},\n483|\t}\n484|\treturn identify(t, value, \"record_id\")\n485|}\n486|\n487|func TestCaptureWrongCreatorRefusedByConsumer(t *testing.T) {\n488|\tchain, created := chainFixture(t)\n489|\tstore := openTestStore(t)\n490|\t// Capture records exactly what the caller declares: a creator\n491|\t// that is not the owning lease holder stays publishable here\n492|\t// and is refused at admission by the consumer's\n493|\t// creator-holder gate.\n494|\tinputs := testInputs([]string{created}, testOpA)\n495|\tinputs.CreatorHostID = testHostB\n496|\t_, raw := mustCapture(t, store, chain, inputs)\n497|\treader := &sessquery.Reader{Local: chain, LocalHostID: testHostA}\n498|\treader.CheckpointRecords = append(reader.CheckpointRecords, raw)\n499|\tcheckpointID := checkpointIDOf(t, raw)\n500|\treader.LeaseRecords = append(reader.LeaseRecords, leaseRecordBytes(t, testLease, testHostA, checkpointID))\n501|\tif _, err := reader.BuildPlan(sessquery.PlanArgs{Selector: \"alpha\", Action: sessquery.ActionStatus}); !errors.Is(err, sessquery.ErrObservationUnavailable) {\n502|\t\tt.Fatalf(\"wrong-creator build = %v, want selector_observation_unavailable\", err)\n503|\t}\n504|}\n505|\n506|func checkpointIDOf(t *testing.T, raw []byte) string {\n507|\tt.Helper()\n508|\tvar value map[string]any\n509|\tif err := json.Unmarshal(raw, &value); err != nil {\n510|\t\tt.Fatal(err)\n511|\t}\n512|\tid, _ := value[\"checkpoint_id\"].(string)\n513|\tif id == \"\" {\n514|\t\tt.Fatalf(\"captured record carries no checkpoint_id\")\n515|\t}\n516|\treturn id\n517|}\n518|\n519|func TestAdmitRawRecordRoundTrip(t *testing.T) {\n520|\tchain, created := chainFixture(t)\n521|\tstore := openTestStore(t)\n522|\t_, raw := mustCapture(t, store, chain, testInputs([]string{created}, testOpA))\n523|\t// The same bytes admitted under a fresh operation install\n524|\t// through the same durable path.\n525|\tadmitted, err := store.Admit(chain, raw, testOpB, SessionKindDirect)\n526|\tif err != nil {\n527|\t\tt.Fatalf(\"Admit error = %v\", err)\n528|\t}\n529|\tif admitted.CheckpointID != checkpointIDOf(t, raw) {\n530|\t\tt.Fatalf(\"admitted %q, want %q\", admitted.CheckpointID, checkpointIDOf(t, raw))\n531|\t}\n532|\tstored, err := store.Get(admitted.CheckpointID)\n533|\tif err != nil {\n534|\t\tt.Fatalf(\"Get error = %v\", err)\n535|\t}\n536|\tif string(stored) != string(raw) {\n537|\t\tt.Fatalf(\"admitted bytes differ from captured bytes\")\n538|\t}\n539|\t// A byte-identical re-admit replays the recorded result.\n540|\tagain, err := store.Admit(chain, raw, testOpB, SessionKindDirect)\n541|\tif err != nil {\n542|\t\tt.Fatalf(\"re-admit error = %v\", err)\n543|\t}\n544|\tif again != admitted {\n545|\t\tt.Fatalf(\"re-admit = %+v, want %+v\", again, admitted)\n546|\t}\n547|}","final_result":true}}}
