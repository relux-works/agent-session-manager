{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6a7","stream":{"kind":"session","id":"01a0adbc-2826-7673-94d4-717956fa0d32"},"sequence":430,"recorded_at":1780531400000855,"record_type":"event","durability":"durable","causation_id":"9162595d-8e13-449e-aede-0d31dd41754b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9162595d-8e13-449e-aede-0d31dd41754b","run_stream":{"kind":"run","id":"9162595d-8e13-449e-aede-0d31dd41754b"},"task_stream":{"kind":"task","id":"01a0adbc-f1cc-7803-a269-6a58ed99c07f"},"task_id":"01a0adbc-f1cc-7803-a269-6a58ed99c07f","event":{"kind":"output","task_id":"01a0adbc-f1cc-7803-a269-6a58ed99c07f","chunk":"Read text file `internal/sessckpt/store.go`.\n(99 line(s) above)\n100|// installBlob installs one content-addressed blob idempotently\n101|// through the no-replace open first: a fresh path is created\n102|// atomically, and only an EEXIST loser falls back to comparing\n103|// against the winner's bytes — identical bytes are reused,\n104|// disagreeing bytes report the torn store for refusal. Leading\n105|// with the exclusive create (instead of stat-then-act) keeps the\n106|// no-replace property a filesystem fact under a second process,\n107|// not a check-then-act race the store mutex cannot see: the mutex\n108|// serializes one process, while O_EXCL serializes all of them.\n109|func installBlob(path string, data []byte) error {\n110|\tif err := writeExclusive(path, data); err == nil {\n111|\t\treturn syncDirectory(filepath.Dir(path))\n112|\t} else if !os.IsExist(err) {\n113|\t\treturn fmt.Errorf(\"install checkpoint blob: %w\", err)\n114|\t}\n115|\texisting, readErr := os.ReadFile(path)\n116|\tif readErr != nil {\n117|\t\treturn fmt.Errorf(\"read checkpoint blob for compare: %w\", readErr)\n118|\t}\n119|\tif string(existing) != string(data) {\n120|\t\treturn fmt.Errorf(\"%w: digest path holds disagreeing bytes\", ErrCheckpointConflict)\n121|\t}\n122|\treturn nil\n123|}\n124|\n125|// writeExclusive installs bytes at a path that must not exist. The\n126|// no-replace open makes append-only a filesystem property, not a\n127|// convention. Bytes fsync before close so a crash never leaves a\n128|// torn prefix behind.\n129|func writeExclusive(path string, data []byte) error {\n130|\tfile, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)\n131|\tif err != nil {\n132|\t\treturn err\n133|\t}\n134|\tif _, err := file.Write(data); err != nil {\n135|\t\t_ = file.Close()\n136|\t\treturn fmt.Errorf(\"write exclusive file: %w\", err)\n137|\t}\n138|\tif err := file.Sync(); err != nil {\n139|\t\t_ = file.Close()\n140|\t\treturn fmt.Errorf(\"fsync exclusive file: %w\", err)\n141|\t}\n142|\tif err := file.Close(); err != nil {\n143|\t\treturn fmt.Errorf(\"close exclusive file: %w\", err)\n144|\t}\n145|\treturn nil\n146|}\n147|\n148|// syncDirectory fsyncs a directory so an install inside it survives\n149|// a crash. Opening a directory fails on Windows, where the install\n150|// itself is the durability boundary; there the sync is skipped,\n151|// never faked.\n152|func syncDirectory(path string) error {\n153|\tif runtime.GOOS == \"windows\" {\n154|\t\treturn nil\n155|\t}\n156|\tdirectory, err := os.Open(path)\n157|\tif err != nil {\n158|\t\treturn fmt.Errorf(\"open directory for fsync: %w\", err)\n159|\t}\n160|\tdefer func() { _ = directory.Close() }()\n161|\tif err := directory.Sync(); err != nil {\n162|\t\treturn fmt.Errorf(\"fsync directory: %w\", err)\n163|\t}\n164|\treturn nil\n165|}","final_result":true}}}
