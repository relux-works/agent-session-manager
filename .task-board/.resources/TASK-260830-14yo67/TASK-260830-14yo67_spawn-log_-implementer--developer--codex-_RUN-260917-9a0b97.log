{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c603","stream":{"kind":"session","id":"01a0ad6b-d9f3-7b60-a446-cfbe978dc3a0"},"sequence":348,"recorded_at":1780531400000691,"record_type":"event","durability":"durable","causation_id":"47d87e75-54e9-4256-91b6-025175a046f7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"47d87e75-54e9-4256-91b6-025175a046f7","run_stream":{"kind":"run","id":"47d87e75-54e9-4256-91b6-025175a046f7"},"call_id":"call_01a0ad6c853674afb0b1832fdcae6f09","text":"Read text file `internal/sessquery/lease.go`.\n(299 line(s) above)\n300|\t\tHasTaskBoardBundle:  hasBoard,\n301|\t\tEventHeads:          heads,\n302|\t\tRaw:                 append([]byte(nil), raw...),\n303|\t}\n304|\treturn checkpoint, nil\n305|}\n306|\n307|// checkpointEventHeads extracts the sorted unique event-head digests\n308|// the canonical checkpoint owner already shape-validated (1..64\n309|// entries). Grammar failures refuse invalid_config; resolution\n310|// against the session chain belongs to checkCheckpointEventHeads.\n311|func checkpointEventHeads(members map[string]json.RawMessage) ([]string, error) {\n312|\traw, ok := members[\"event_heads\"]\n313|\tif !ok {\n314|\t\treturn nil, fmt.Errorf(\"member %q is absent\", \"event_heads\")\n315|\t}\n316|\tvar values []string\n317|\tif err := json.Unmarshal(raw, &values); err != nil {\n318|\t\treturn nil, fmt.Errorf(\"member %q is not a string array: %v\", \"event_heads\", err)\n319|\t}\n320|\tout := make([]string, 0, len(values))\n321|\tfor _, value := range values {\n322|\t\tdigest, err := scalar.ParseDigest(value)\n323|\t\tif err != nil {\n324|\t\t\treturn nil, fmt.Errorf(\"member %q holds malformed digest %q: %v\", \"event_heads\", value, err)\n325|\t\t}\n326|\t\tout = append(out, digest.String())\n327|\t}\n328|\treturn out, nil\n329|}\n330|\n331|// validatedLeasesBySession validates every supplied Lease Record and\n332|// groups the admitted records by session UUID.\n333|func (reader *Reader) validatedLeasesBySession() (map[string][]validatedLease, error) {\n334|\tout := map[string][]validatedLease{}\n335|\tif reader == nil {\n336|\t\treturn out, fmt.Errorf(\"%w: reader carries no configuration\", ErrInvalidConfig)\n337|\t}\n338|\tfor _, raw := range reader.LeaseRecords {\n339|\t\tlease, err := parseLeaseRecord(raw)\n340|\t\tif err != nil {\n341|\t\t\treturn nil, err\n342|\t\t}\n343|\t\tout[lease.SessionID] = append(out[lease.SessionID], lease)\n344|\t}\n345|\treturn out, nil\n346|}\n347|\n348|// winningLeaseFor selects the greatest (epoch, lease_id) validated Lease\n349|// Record for one session and validates its succession: the\n350|// predecessor ancestry must chain by epoch plus one down to an\n351|// epoch-1 root, and every lease in that winning ancestry above\n352|// epoch 1 must reference a validated checkpoint for its session and\n353|// predecessor lease (Section 5.3), each created by the owning lease\n354|// holder (Section 5.4). Every required checkpoint must additionally\n355|// carry the persistence variant the referenced Session Record\n356|// selects: sessionKind is that record's kind as projected from the\n357|// winning source, and a variant mismatch refuses\n358|// observation_unavailable even when canonical identity, session,\n359|// lease, epoch, and creator all agree. Every required checkpoint\n360|// must also resolve each event head to a chained event for its\n361|// session at or before its bound lease in the winning source chain\n362|// (repo, Section 5.4 event-head closure): a head naming an absent\n363|// event or an event under a later lease cannot establish current\n364|// complete authority, so it refuses observation_unavailable;\n365|// historical heads stay admissible and are never required to equal\n366|// the current tail. Every required checkpoint must also admit its\n367|// Section 2.4 profile authority over the same closure\n368|// (checkCheckpointProfileAuthority): a first launch outside the\n369|// creation pair, a later launch outside the newest authoritative\n370|// change at or before it, a resume outside its referenced\n371|// checkpoint's closure pair, or a fork outside the new record\n372|// pair, contradicts the admitted history (integrity failure).\n373|// Absence refuses observation_unavailable; a\n374|// lease above epoch 1 without its named predecessor in the admitted\n375|// set refuses the same class rather than binding a dangling\n376|// successor, while an illegal predecessor link is malformed\n377|// authority (integrity failure).\n378|func (reader *Reader) winningLeaseFor(sessionID, sessionKind string, repo *sessrepo.Repository) (validatedLease, error) {\n379|\tif sessionKind != \"direct\" && sessionKind != \"task_board\" {\n380|\t\treturn validatedLease{}, fmt.Errorf(\"%w: session %s carries unknown kind %q for checkpoint persistence\", ErrInvalidConfig, sessionID, sessionKind)\n381|\t}\n382|\tbySession, err := reader.validatedLeasesBySession()\n383|\tif err != nil {\n384|\t\treturn validatedLease{}, err\n385|\t}\n386|\tcandidates := bySession[sessionID]\n387|\tif len(candidates) == 0 {\n388|\t\treturn validatedLease{}, fmt.Errorf(\"%w: winning lease record for session %s cannot be established\", ErrObservationUnavailable, sessionID)\n389|\t}\n390|\twinner := candidates[0]\n391|\tfor _, candidate := range candidates[1:] {\n392|\t\tif sessstate.Compare(\n393|\t\t\tsessstate.LeaseHead{Epoch: candidate.Epoch, LeaseID: candidate.LeaseID},\n394|\t\t\tsessstate.LeaseHead{Epoch: winner.Epoch, LeaseID: winner.LeaseID},\n395|\t\t) > 0 {\n396|\t\t\twinner = candidate\n397|\t\t}\n398|\t}\n399|\tchain, predecessor, err := checkLeaseChain(candidates, winner)\n400|\tif err != nil {\n401|\t\treturn validatedLease{}, err\n402|\t}\n403|\tif err := reader.checkWinnerCheckpoint(winner, predecessor, sessionKind, repo, chain); err != nil {\n404|\t\treturn validatedLease{}, err\n405|\t}\n406|\tif err := reader.checkAncestorCheckpoints(chain, sessionKind, repo); err != nil {\n407|\t\treturn validatedLease{}, err\n408|\t}\n409|\treturn winner, nil\n410|}\n411|\n412|// checkLeaseChain validates the winner's predecessor ancestry within\n413|// the admitted records for its session. Section 5.3 requires every\n414|// epoch above 1 to name a known predecessor for the same session\n415|// with an epoch exactly one below, down to an epoch-1 root with a\n416|// null predecessor; epochs below 1 cannot exist, so an epoch-1\n417|// lease naming any predecessor is malformed. A self, cyclic,\n418|// skipped, contradictory, or duplicated link is malformed authority\n419|// (integrity failure); a missing predecessor name or record is\n420|// incomplete authority (observation_unavailable). Epochs strictly\n421|// decrease along the walk, so the walk always terminates. It\n422|// returns the winning ancestry from the winner down to the epoch-1\n423|// root, plus the winner's direct predecessor, or the zero lease at\n424|// epoch 1.\n425|func checkLeaseChain(candidates []validatedLease, winner validatedLease) ([]validatedLease, validatedLease, error) {\n426|\tbyLease := make(map[string]validatedLease, len(candidates))\n427|\tfor _, candidate := range candidates {\n428|\t\tif previous, ok := byLease[candidate.LeaseID]; ok && previous.Digest != candidate.Digest {\n429|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: session %s carries contradictory lease records for lease %s\", sessstate.ErrIntegrity, winner.SessionID, candidate.LeaseID)\n430|\t\t}\n431|\t\tbyLease[candidate.LeaseID] = candidate\n432|\t}\n433|\tvar predecessor validatedLease\n434|\tvar chain []validatedLease\n435|\tcurrent := winner\n436|\tfor {\n437|\t\tchain = append(chain, current)\n438|\t\tif current.Epoch == 1 {\n439|\t\t\tif current.HasPredecessor {\n440|\t\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: session %s epoch-1 lease %s names a predecessor\", sessstate.ErrIntegrity, current.SessionID, current.LeaseID)\n441|\t\t\t}\n442|\t\t\treturn chain, predecessor, nil\n443|\t\t}\n444|\t\tif !current.HasPredecessor {\n445|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: winning lease record for session %s names no predecessor\", ErrObservationUnavailable, current.SessionID)\n446|\t\t}\n447|\t\tparent, ok := byLease[current.Predecessor]\n448|\t\tif !ok {\n449|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: predecessor lease record for session %s cannot be established\", ErrObservationUnavailable, current.SessionID)\n450|\t\t}\n451|\t\tif parent.Epoch+1 != current.Epoch {\n452|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: session %s lease %s at epoch %d does not succeed its predecessor %s at epoch %d\", sessstate.ErrIntegrity, current.SessionID, current.LeaseID, current.Epoch, parent.LeaseID, parent.Epoch)\n453|\t\t}\n454|\t\tif current.LeaseID == winner.LeaseID {\n455|\t\t\tpredecessor = parent\n456|\t\t}\n457|\t\tcurrent = parent\n458|\t}\n459|}\n460|\n461|// validatedCheckpointsByDigest validates every supplied Checkpoint\n462|// Record and indexes the parsed records by canonical digest. Semantic\n463|// admission happens only at the shared admission owners below.\n464|func (reader *Reader) validatedCheckpointsByDigest() (map[string]validatedCheckpoint, error) {\n465|\tout := map[string]validatedCheckpoint{}\n466|\tif reader == nil {\n467|\t\treturn out, fmt.Errorf(\"%w: reader carries no configuration\", ErrInvalidConfig)\n468|\t}\n469|\tfor _, raw := range reader.CheckpointRecords {\n470|\t\tcheckpoint, err := parseCheckpointRecord(raw)\n471|\t\tif err != nil {\n472|\t\t\treturn nil, err\n473|\t\t}\n474|\t\tout[checkpoint.Digest] = checkpoint\n475|\t}\n476|\treturn out, nil\n477|}\n478|\n479|// checkWinnerCheckpoint resolves the winner's checkpoint reference\n480|// against the admitted Checkpoint Records. Section 5.3 requires\n481|// every epoch above 1 to reference a validated checkpoint for its\n482|// session and predecessor lease; an epoch-1 root without a\n483|// predecessor may carry no checkpoint before the first provider\n484|// boundary exists. A non-null reference must resolve to an admitted\n485|// record for the same session bound to the lease it was taken\n486|// under: the predecessor for a successor, the winner itself at\n487|// epoch 1 (Section 5.4 binds a checkpoint to its winning lease). An\n488|// unresolvable reference is incomplete authority\n489|// (observation_unavailable), never absence or a minted fact. The\n490|// admitted checkpoint must also resolve its event-head closure in\n491|// the winning source chain (repo); see checkCheckpointEventHeads.\n492|// The same closure must then admit its Section 2.4 profile\n493|// authority; see checkCheckpointProfileAuthority.\n494|func (reader *Reader) checkWinnerCheckpoint(winner validatedLease, predecessor validatedLease, sessionKind string, repo *sessrepo.Repository, chain []validatedLease) error {\n495|\tif !winner.HasCheckpoint {\n496|\t\tif winner.Epoch == 1 && !winner.HasPredecessor {\n497|\t\t\treturn nil\n498|\t\t}\n499|\t\treturn fmt.Errorf(\"%w: validated checkpoint for session %s lease %s cannot be established\", ErrObservationUnavailable, winner.SessionID, winner.LeaseID)\n500|\t}\n501|\tcheckpoints, err := reader.validatedCheckpointsByDigest()\n502|\tif err != nil {\n503|\t\treturn err\n504|\t}\n505|\tcheckpoint, ok := checkpoints[winner.Checkpoint]\n506|\tif !ok {\n507|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, winner.Checkpoint, winner.SessionID)\n508|\t}\n509|\towner := winner\n510|\tif winner.Epoch > 1 {\n511|\t\towner = predecessor\n512|\t}\n513|\tadmitted, err := admitCheckpoint(checkpoint, winner.SessionID, owner, sessionKind, chain, repo, nil)\n514|\tif err != nil {\n515|\t\treturn err\n516|\t}\n517|\tadmitReference := buildCheckpointAdmission(checkpoints, chain, repo, sessionKind)\n518|\tif err := checkCheckpointProfileAuthority(admitted, repo, admitReference); err != nil {\n519|\t\treturn err\n520|\t}\n521|\treturn nil\n522|}\n523|\n524|// checkAncestorCheckpoints validates the checkpoint references of\n525|// every non-winner lease in the winning ancestry: Section 5.3\n526|// requires each epoch above 1 to reference a validated checkpoint\n527|// for its session and predecessor lease, and Section 5.4 requires\n528|// that checkpoint to be created by the owning lease holder. The\n529|// winner itself is covered by checkWinnerCheckpoint. Only the\n530|// winner's own ancestry is admitted: sibling branches off that\n531|// chain are never consulted, so legal branching is preserved. An\n532|// epoch-1 root without a reference stays admissible before the\n533|// first provider boundary exists; a reference it does carry must\n534|// resolve to a checkpoint bound to itself and created by its own\n535|// holder. An unresolvable reference or a binding to another\n536|// session, lease, or holder is incomplete authority\n537|// (observation_unavailable), never absence or a minted fact. Every\n538|// admitted ancestor checkpoint must also resolve its event-head\n539|// closure in the winning source chain (repo) and admit its Section\n540|// 2.4 profile authority over that closure.\n541|func (reader *Reader) checkAncestorCheckpoints(chain []validatedLease, sessionKind string, repo *sessrepo.Repository) error {\n542|\tif len(chain) < 2 {\n543|\t\treturn nil\n544|\t}\n545|\tcheckpoints, err := reader.validatedCheckpointsByDigest()\n546|\tif err != nil {\n547|\t\treturn err\n548|\t}\n549|\tfor index := 1; index < len(chain); index++ {\n550|\t\tcurrent := chain[index]\n551|\t\tif current.Epoch == 1 {\n552|\t\t\tif !current.HasCheckpoint {\n553|\t\t\t\tcontinue\n554|\t\t\t}\n555|\t\t\tif err := checkCheckpointBinding(current, current, checkpoints, sessionKind, repo, chain); err != nil {\n556|\t\t\t\treturn err\n557|\t\t\t}\n558|\t\t\tcontinue\n559|\t\t}\n560|\t\tif !current.HasCheckpoint {\n561|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint for session %s lease %s cannot be established\", ErrObservationUnavailable, current.SessionID, current.LeaseID)\n562|\t\t}\n563|\t\tif index+1 >= len(chain) {\n564|\t\t\treturn fmt.Errorf(\"%w: predecessor lease record for session %s cannot be established\", ErrObservationUnavailable, current.SessionID)\n565|\t\t}\n566|\t\tif err := checkCheckpointBinding(current, chain[index+1], checkpoints, sessionKind, repo, chain); err != nil {\n567|\t\t\treturn err\n568|\t\t}\n569|\t}\n570|\treturn nil\n571|}\n572|\n573|// checkCheckpointBinding resolves one lease's checkpoint reference\n574|// against the admitted Checkpoint Records and validates its Section\n575|// 5.3 session and predecessor-lease binding with its Section 5.4\n576|// holder binding: the checkpoint must name this session and the\n577|// owning lease, and its creator must be that lease's holder. The\n578|// admitted checkpoint must also resolve its event-head closure in\n579|// the winning source chain (repo); see checkCheckpointEventHeads.\n580|// The same closure must then admit its Section 2.4 profile\n581|// authority; see checkCheckpointProfileAuthority.\n582|func checkCheckpointBinding(current, owner validatedLease, checkpoints map[string]validatedCheckpoint, sessionKind string, repo *sessrepo.Repository, chain []validatedLease) error {\n583|\tcheckpoint, ok := checkpoints[current.Checkpoint]\n584|\tif !ok {\n585|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, current.Checkpoint, current.SessionID)\n586|\t}\n587|\tadmitted, err := admitCheckpoint(checkpoint, current.SessionID, owner, sessionKind, chain, repo, nil)\n588|\tif err != nil {\n589|\t\treturn err\n590|\t}\n591|\tadmitReference := buildCheckpointAdmission(checkpoints, chain, repo, sessionKind)\n592|\tif err := checkCheckpointProfileAuthority(admitted, repo, admitReference); err != nil {\n593|\t\treturn err\n594|\t}\n595|\treturn nil\n596|}\n597|\n598|// admitCheckpoint is the single constructor for an admitted Checkpoint\n599|// Record. All raw validated data enters this function from an explicit\n600|// winner/ancestor/reference admission owner; profile derivation receives only\n601|// the resulting capability.\n602|func admitCheckpoint(raw validatedCheckpoint, sessionID string, owner validatedLease, sessionKind string, chain []validatedLease, repo *sessrepo.Repository, resume *sessrepo.EventSummary) (admittedCheckpoint, error) {\n603|\tif raw.SessionID != sessionID {\n604|\t\treturn admittedCheckpoint{}, fmt.Errorf(\"%w: validated checkpoint %s carries session %s, want %s\", ErrObservationUnavailable, raw.Digest, raw.SessionID, sessionID)\n605|\t}\n606|\tif raw.LeaseEpoch != owner.Epoch || raw.LeaseID != owner.LeaseID {\n607|\t\treturn admittedCheckpoint{}, fmt.Errorf(\"%w: validated checkpoint %s is bound to lease %s at epoch %d, want lease %s at epoch %d\", ErrObservationUnavailable, raw.Digest, raw.LeaseID, raw.LeaseEpoch, owner.LeaseID, owner.Epoch)\n608|\t}\n609|\tif raw.CreatorHostID != owner.HolderHostID {\n610|\t\treturn admittedCheckpoint{}, fmt.Errorf(\"%w: validated checkpoint %s is created by host %s, want owning lease holder %s\", ErrObservationUnavailable, raw.Digest, raw.CreatorHostID, owner.HolderHostID)\n611|\t}\n612|\tif err := checkCheckpointPersistence(raw, sessionID, sessionKind); err != nil {\n613|\t\treturn admittedCheckpoint{}, err\n614|\t}\n615|\tif err := checkCheckpointEventHeads(raw, owner, repo); err != nil {\n616|\t\treturn admittedCheckpoint{}, err\n617|\t}\n618|\tif resume != nil {\n619|\t\tif err := checkReferencedCheckpointTemporal(raw, owner, *resume, chain, repo); err != nil {\n620|\t\t\treturn admittedCheckpoint{}, err\n621|\t\t}\n622|\t}\n623|\treturn admittedCheckpoint{seal: &checkpointSeal{\n624|\t\ttoken:               &checkpointSealToken{},\n625|\t\tdigest:              raw.Digest,\n626|\t\tsessionID:           raw.SessionID,\n627|\t\tleaseEpoch:          raw.LeaseEpoch,\n628|\t\tleaseID:             raw.LeaseID,\n629|\t\tcreatorHostID:       raw.CreatorHostID,\n630|\t\thasProviderManifest: raw.HasProviderManifest,\n631|\t\thasTaskBoardBundle:  raw.HasTaskBoardBundle,\n632|\t\teventHeads:          append([]string(nil), raw.EventHeads...),\n633|\t}}, nil\n634|}\n635|\n636|// buildCheckpointAdmission returns the only raw-record lookup capability\n637|// exposed to the referenced profile derivation. The closure performs the\n638|// lookup and immediately routes the result through the shared admission owner.\n639|func buildCheckpointAdmission(checkpoints map[string]validatedCheckpoint, chain []validatedLease, repo *sessrepo.Repository, sessionKind string) checkpointAdmission {\n640|\treturn func(checkpointID, sessionID string, summary sessrepo.EventSummary) (result admittedCheckpoint, err error) {\n641|\t\traw, ok := checkpoints[checkpointID]\n642|\t\tif !ok {\n643|\t\t\terr = fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, checkpointID, sessionID)\n644|\t\t\treturn\n645|\t\t}\n646|\t\treturn checkReferencedCheckpointBinding(raw, checkpointID, sessionID, sessionKind, summary, chain, repo)\n647|\t}\n648|}\n649|\n650|// checkCheckpointEventHeads resolves every event head of one parsed\n651|// Checkpoint Record against the winning source chain for its session\n652|// (Section 5.4 event-head closure). Each head must name a chained\n653|// event for the same session at or before the owning lease: a head\n654|// naming an absent event (including a cross-session digest, a\n655|// losing-lease preserved blob outside the authoritative chain, or a\n656|// synthetic placeholder) is incomplete authority\n657|// (observation_unavailable), and a head under a later lease (a\n658|// greater epoch, or the same epoch under a different fencing token)\n659|// is likewise incomplete authority because the checkpoint cannot fix\n660|// authority over events that postdate it. Historical heads stay\n661|// admissible and are never required to equal the current tail, so\n662|// valid branching and lagging copies are preserved. A failed chain\n663|// read keeps its cause inside the same incomplete-authority refusal\n664|// instead of minting a fact, and a nil chain handle refuses the same\n665|// class rather than skipping the gate.\n666|func checkCheckpointEventHeads(checkpoint validatedCheckpoint, owner validatedLease, repo *sessrepo.Repository) error {\n667|\tif repo == nil {\n668|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s event-head authority for session %s cannot be established: no winning source chain\", ErrObservationUnavailable, checkpoint.Digest, checkpoint.SessionID)\n669|\t}\n670|\tevents, err := repo.ListEvents(checkpoint.SessionID)\n671|\tif err != nil {\n672|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s event-head authority for session %s cannot be established: %v\", ErrObservationUnavailable, checkpoint.Digest, checkpoint.SessionID, err)\n673|\t}\n674|\tbyID := make(map[string]sessrepo.EventSummary, len(events))\n675|\tfor _, summary := range events {\n676|\t\tbyID[summary.EventID] = summary\n677|\t}\n678|\tfor _, head := range checkpoint.EventHeads {\n679|\t\tsummary, ok := byID[head]\n680|\t\tif !ok {\n681|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s names unknown event head %s for session %s\", ErrObservationUnavailable, checkpoint.Digest, head, checkpoint.SessionID)\n682|\t\t}\n683|\t\tif summary.LeaseEpoch > owner.Epoch {\n684|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s names event head %s under later lease epoch %d, want at or before epoch %d\", ErrObservationUnavailable, checkpoint.Digest, head, summary.LeaseEpoch, owner.Epoch)\n685|\t\t}\n686|\t\tif summary.LeaseEpoch == owner.Epoch && summary.LeaseID != owner.LeaseID {\n687|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s names event head %s under lease %s, want owning lease %s at epoch %d\", ErrObservationUnavailable, checkpoint.Digest, head, summary.LeaseID, owner.LeaseID, owner.Epoch)\n688|\t\t}\n689|\t}\n690|\treturn nil\n691|}\n692|\n693|// checkCheckpointProfileAuthority admits the Section 2.4 effective\n694|// execution profile and its nullable source event for one required\n695|// checkpoint against the winning source chain (repo, SPEC 5.4\n696|// event-head closure). The transitive predecessor closure of the\n697|// checkpoint heads fixes the launch values: the Session Record\n698|// carries the creation profile, the first launch in the closure\n699|// carries that profile with a null source, and every later\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
