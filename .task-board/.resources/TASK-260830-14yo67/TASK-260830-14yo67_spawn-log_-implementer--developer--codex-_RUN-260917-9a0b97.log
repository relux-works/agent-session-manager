{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5b9","stream":{"kind":"session","id":"01a0ad6b-d9f3-7b60-a446-cfbe978dc3a0"},"sequence":311,"recorded_at":1780531400000617,"record_type":"event","durability":"durable","causation_id":"47d87e75-54e9-4256-91b6-025175a046f7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"47d87e75-54e9-4256-91b6-025175a046f7","run_stream":{"kind":"run","id":"47d87e75-54e9-4256-91b6-025175a046f7"},"task_stream":{"kind":"task","id":"01a0ad6c-7bfc-7791-b591-a15a965abd0c"},"task_id":"01a0ad6c-7bfc-7791-b591-a15a965abd0c","event":{"kind":"output","task_id":"01a0ad6c-7bfc-7791-b591-a15a965abd0c","chunk":"Read text file `internal/canonicaljson/core_records.go`.\n(112 line(s) above)\n113|func validateCheckpointRecord(object map[string]any) error {\n114|\tif err := requireExactMembers(\"Checkpoint Record\", object,\n115|\t\t\"schema\", \"schema_version\", \"checkpoint_id\", \"subject_id\", \"session_id\", \"lease_epoch\", \"lease_id\",\n116|\t\t\"safe_boundary\", \"event_heads\", \"workspace_manifest_id\", \"provider_manifest_id\", \"task_board_bundle_id\",\n117|\t\t\"created_by_host_id\", \"created_at\", \"status\", \"extensions\"); err != nil {\n118|\t\treturn err\n119|\t}\n120|\tif err := validateIdentityRecordEnvelope(object, checkpointSchema, \"1.0.0\", \"checkpoint_id\"); err != nil {\n121|\t\treturn err\n122|\t}\n123|\tsubjectID, err := requireUUIDv7(object, \"subject_id\")\n124|\tif err != nil {\n125|\t\treturn err\n126|\t}\n127|\tsessionID, err := requireUUIDv7(object, \"session_id\")\n128|\tif err != nil {\n129|\t\treturn err\n130|\t}\n131|\tif subjectID != sessionID {\n132|\t\treturn invalidIdentity(\"Checkpoint Record subject_id must equal session_id\")\n133|\t}\n134|\tif _, err := requirePositiveUint(object, \"lease_epoch\"); err != nil {\n135|\t\treturn err\n136|\t}\n137|\tif err := requireUUIDv4(object, \"lease_id\"); err != nil {\n138|\t\treturn err\n139|\t}\n140|\tboundary, err := requireObject(object, \"safe_boundary\")\n141|\tif err != nil {\n142|\t\treturn err\n143|\t}\n144|\tif err := validateSafeBoundaryEvidence(boundary); err != nil {\n145|\t\treturn err\n146|\t}\n147|\theads, err := requireArrayRange(object, \"event_heads\", 1, 64)\n148|\tif err != nil {\n149|\t\treturn err\n150|\t}\n151|\tif err := validateSortedUniqueDigests(heads, \"event_heads\"); err != nil {\n152|\t\treturn err\n153|\t}\n154|\tif err := requireDigest(object, \"workspace_manifest_id\"); err != nil {\n155|\t\treturn err\n156|\t}\n157|\tproviderPresent, err := requireNullableDigestPresence(object, \"provider_manifest_id\")\n158|\tif err != nil {\n159|\t\treturn err\n160|\t}\n161|\tboardPresent, err := requireNullableDigestPresence(object, \"task_board_bundle_id\")\n162|\tif err != nil {\n163|\t\treturn err\n164|\t}\n165|\tif providerPresent == boardPresent {\n166|\t\treturn invalidIdentity(\"Checkpoint Record requires exactly one of provider_manifest_id and task_board_bundle_id\")\n167|\t}\n168|\treturn requireExactString(object, \"status\", \"validated\")\n169|}\n170|\n171|func validateSafeBoundaryEvidence(object map[string]any) error {\n172|\tif err := requireExactMembers(\"Safe Boundary Evidence\", object,\n173|\t\t\"provider_id\", \"provider_version\", \"evidence\", \"input_blocked\", \"foreground_idle\", \"background_idle\",\n174|\t\t\"open_processes\", \"open_database_handles\"); err != nil {\n175|\t\treturn err\n176|\t}\n177|\tif err := requireProviderID(object, \"provider_id\"); err != nil {\n178|\t\treturn err\n179|\t}\n180|\tif _, err := requireBoundedString(object, \"provider_version\", 1, 128); err != nil {\n181|\t\treturn err\n182|\t}\n183|\tif _, err := requireEnum(object, \"evidence\", \"provider_api\", \"provider_event\", \"managed_pty\", \"task_board_bridge\", \"accepted_test\"); err != nil {\n184|\t\treturn err\n185|\t}\n186|\tfor _, name := range []string{\"input_blocked\", \"foreground_idle\", \"background_idle\"} {\n187|\t\tvalue, err := requireBool(object, name)\n188|\t\tif err != nil {\n189|\t\t\treturn err\n190|\t\t}\n191|\t\tif !value {\n192|\t\t\treturn invalidIdentity(\"Safe Boundary Evidence %s must be true\", name)\n193|\t\t}\n194|\t}\n195|\tfor _, name := range []string{\"open_processes\", \"open_database_handles\"} {\n196|\t\tvalue, err := requireUint(object, name, uint64(maxSafeInteger))\n197|\t\tif err != nil {\n198|\t\t\treturn err\n199|\t\t}\n200|\t\tif value != 0 {\n201|\t\t\treturn invalidIdentity(\"Safe Boundary Evidence %s must be zero\", name)\n202|\t\t}\n203|\t}\n204|\treturn nil\n205|}\n206|\n207|func validateProviderIdentityRecord(object map[string]any) error {\n208|\tif err := requireExactMembers(\"Provider Identity Record\", object,\n209|\t\t\"schema\", \"schema_version\", \"record_id\", \"subject_id\", \"session_id\", \"provider_id\", \"provider_version\",\n210|\t\t\"provider_version_range\", \"native_session_id\", \"identity_kind\", \"logical_workspace_id\",\n211|\t\t\"backend_realm_fingerprint\", \"opaque_identity\", \"created_by_host_id\", \"created_at\", \"extensions\"); err != nil {\n212|\t\treturn err\n213|\t}\n214|\tif err := validateIdentityRecordEnvelope(object, providerIdentitySchema, \"1.0.0\", \"record_id\"); err != nil {\n215|\t\treturn err\n216|\t}\n217|\tsubjectID, err := requireUUIDv7(object, \"subject_id\")\n218|\tif err != nil {\n219|\t\treturn err\n220|\t}\n221|\tsessionID, err := requireUUIDv7(object, \"session_id\")\n222|\tif err != nil {\n223|\t\treturn err\n224|\t}\n225|\tif subjectID != sessionID {\n226|\t\treturn invalidIdentity(\"Provider Identity Record subject_id must equal session_id\")\n227|\t}\n228|\tif err := requireProviderID(object, \"provider_id\"); err != nil {\n229|\t\treturn err\n230|\t}\n231|\t// Spelled out as three ordered calls rather than a map range: a map range\n232|\t// reports a random member when several bounds are violated at once, and it\n233|\t// hides the declared bounds from the derived bounds inventory.\n234|\tif _, err := requireBoundedString(object, \"provider_version\", 1, 128); err != nil {\n235|\t\treturn err\n236|\t}\n237|\tif _, err := requireBoundedString(object, \"provider_version_range\", 1, 256); err != nil {\n238|\t\treturn err\n239|\t}\n240|\tif _, err := requireBoundedString(object, \"native_session_id\", 1, 512); err != nil {\n241|\t\treturn err\n242|\t}\n243|\tkind, err := requireEnum(object, \"identity_kind\", \"session_uuid\", \"session_path_or_id\", \"backend_conversation_uuid\", \"task_board_managed\", \"provider_defined\")\n244|\tif err != nil {\n245|\t\treturn err\n246|\t}\n247|\tif _, err := requireUUIDv7(object, \"logical_workspace_id\"); err != nil {\n248|\t\treturn err\n249|\t}\n250|\trealmPresent, err := requireNullableDigestPresence(object, \"backend_realm_fingerprint\")\n251|\tif err != nil {\n252|\t\treturn err\n253|\t}\n254|\tproviderID, _ := object[\"provider_id\"].(string)\n255|\tif providerID == \"antigravity\" && kind == \"backend_conversation_uuid\" && !realmPresent {\n256|\t\treturn invalidIdentity(\"Provider Identity Record backend_realm_fingerprint must be non-null for Antigravity backend_conversation_uuid\")\n257|\t}\n258|\topaque, err := requireObject(object, \"opaque_identity\")\n259|\tif err != nil {\n260|\t\treturn err\n261|\t}\n262|\tif len(opaque) > 32 {\n263|\t\treturn invalidIdentity(\"Provider Identity Record opaque_identity exceeds maximum length 32\")\n264|\t}\n265|\t// Iterate in sorted key order so a record violating several opaque_identity\n266|\t// bounds always reports the same member rather than a random map key.\n267|\topaqueKeys := make([]string, 0, len(opaque))\n268|\tfor key := range opaque {\n269|\t\topaqueKeys = append(opaqueKeys, key)\n270|\t}\n271|\tsort.Strings(opaqueKeys)\n272|\tfor _, key := range opaqueKeys {\n273|\t\tvalue := opaque[key]\n274|\t\tif !providerIdentityKeyPattern.MatchString(key) {\n275|\t\t\treturn invalidIdentity(\"Provider Identity Record opaque_identity key %q must match [a-z][a-z0-9_.-]{0,63}\", key)\n276|\t\t}\n277|\t\ttext, ok := value.(string)\n278|\t\tif !ok || !utf8.ValidString(text) {\n279|\t\t\treturn invalidIdentity(\"Provider Identity Record opaque_identity[%q] must be a UTF-8 string\", key)\n280|\t\t}\n281|\t\tlength := utf8.RuneCountInString(text)\n282|\t\tif length < 1 || length > 1024 {\n283|\t\t\treturn invalidIdentity(\"Provider Identity Record opaque_identity[%q] must contain 1..1024 Unicode characters\", key)\n284|\t\t}\n285|\t\t// Section 2 declares the map \"MUST NOT contain an absolute path,\n286|\t\t// credential, environment value, PID, socket, terminal ID, or mutable\n287|\t\t// cache selector\". Only the leading-absolute-path form of that sentence\n288|\t\t// is decidable from one candidate: a value such as `cwd=/Users/x`\n289|\t\t// embeds an absolute path and is ADMITTED here. The message says\n290|\t\t// \"begin with\" rather than \"contain\" so the refusal states what it\n291|\t\t// enforces, and constraint-enumeration.md routes the undecidable\n292|\t\t// remainder to the same external column as the credential and PID\n293|\t\t// classes in that sentence.\n294|\t\tif strings.HasPrefix(text, \"/\") || strings.HasPrefix(text, `\\\\`) || windowsAbsolutePathPattern.MatchString(text) {\n295|\t\t\treturn invalidIdentity(\"Provider Identity Record opaque_identity[%q] must not begin with an absolute path\", key)\n296|\t\t}\n297|\t}\n298|\treturn nil\n299|}\n300|\n301|func validateWorkspaceGroupRecord(object map[string]any) error {\n302|\tif err := requireExactMembers(\"Workspace Group Record\", object,\n303|\t\t\"schema\", \"schema_version\", \"record_id\", \"subject_id\", \"workspace_group_id\", \"display_name\", \"members\",\n304|\t\t\"created_by_host_id\", \"created_at\", \"extensions\"); err != nil {\n305|\t\treturn err\n306|\t}\n307|\tif err := validateIdentityRecordEnvelope(object, workspaceGroupSchema, \"1.0.0\", \"record_id\"); err != nil {\n308|\t\treturn err\n309|\t}\n310|\tsubjectID, err := requireUUIDv7(object, \"subject_id\")\n311|\tif err != nil {\n312|\t\treturn err\n313|\t}\n314|\tgroupID, err := requireUUIDv7(object, \"workspace_group_id\")\n315|\tif err != nil {\n316|\t\treturn err\n317|\t}\n318|\tif subjectID != groupID {\n319|\t\treturn invalidIdentity(\"Workspace Group Record subject_id must equal workspace_group_id\")\n320|\t}\n321|\tif _, err := requireBoundedString(object, \"display_name\", 1, 128); err != nil {\n322|\t\treturn err\n323|\t}\n324|\tmembers, err := requireArrayRange(object, \"members\", 1, 256)\n325|\tif err != nil {\n326|\t\treturn err\n327|\t}\n328|\tpreviousID := \"\"\n329|\tpaths := make(map[string]string, len(members))\n330|\tfor index, value := range members {\n331|\t\tmember, err := requireObjectValue(value, fmt.Sprintf(\"Workspace Group Record members[%d]\", index))\n332|\t\tif err != nil {\n333|\t\t\treturn err\n334|\t\t}\n335|\t\tworkspaceID, relativePath, err := validateWorkspaceMember(member)\n336|\t\tif err != nil {\n337|\t\t\treturn err\n338|\t\t}\n339|\t\t// Section 2 declares \"Members are sorted by workspace_id, and no two\n340|\t\t// members may have an equal or case-colliding group_relative_path\". The\n341|\t\t// declared uniqueness is on group_relative_path, enforced below; the\n342|\t\t// workspace_id rule is bare `sorted`, so an equal workspace_id is\n343|\t\t// admitted rather than refused on an undeclared uniqueness.\n344|\t\tif index > 0 && workspaceID < previousID {\n345|\t\t\treturn invalidIdentity(\"Workspace Group Record members must be sorted by workspace_id\")\n346|\t\t}\n347|\t\tpreviousID = workspaceID\n348|\t\tfolded := simpleFoldKey(relativePath)\n349|\t\tif prior, collision := paths[folded]; collision {\n350|\t\t\treturn invalidIdentity(\"Workspace Group Record member paths %q and %q are equal or case-colliding\", prior, relativePath)\n351|\t\t}\n352|\t\tpaths[folded] = relativePath\n353|\t}\n354|\treturn nil\n355|}\n356|\n357|func validateWorkspaceMember(object map[string]any) (string, string, error) {\n358|\tkind, err := requireString(object, \"kind\")\n359|\tif err != nil {\n360|\t\treturn \"\", \"\", err\n361|\t}\n362|\t// Both member lists are spelled out literally rather than appended to a\n(more lines below)","final_result":true}}}
