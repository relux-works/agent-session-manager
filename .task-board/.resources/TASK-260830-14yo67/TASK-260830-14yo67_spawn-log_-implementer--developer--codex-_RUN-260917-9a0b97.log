{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c939","stream":{"kind":"session","id":"01a0ad6b-d9f3-7b60-a446-cfbe978dc3a0"},"sequence":759,"recorded_at":1780531400001513,"record_type":"event","durability":"durable","causation_id":"47d87e75-54e9-4256-91b6-025175a046f7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"47d87e75-54e9-4256-91b6-025175a046f7","run_stream":{"kind":"run","id":"47d87e75-54e9-4256-91b6-025175a046f7"},"call_id":"call_01a0ad6d85cf74748b1105cd2864b740","text":"Read text file `internal/sessrepo/chain.go`.\n(379 line(s) above)\n380|\t}\n381|\tsummary.Predecessors = predecessors\n382|\treturn summary, nil\n383|}\n384|\n385|// writeChain stores the index atomically: temp file, fsync, rename, fsync\n386|// the directory. A crash either leaves the previous index or the new one;\n387|// the blobs it names are verified on every load, so neither outcome can\n388|// invent history.\n389|func (repository *Repository) writeChain(directory string, chain storedChain) error {\n390|\tpayload, err := json.Marshal(chainPayload{RecordID: chain.RecordID, Events: chain.Events})\n391|\tif err != nil {\n392|\t\treturn fmt.Errorf(\"encode chain index: %w\", err)\n393|\t}\n394|\treturn writeAtomic(filepath.Join(directory, \"chain.json\"), payload)\n395|}\n396|\n397|// chainPayload is the on-disk shape of the index. EventSummary carries the\n398|// JSON tags so the stored form stays exactly this struct.\n399|type chainPayload struct {\n400|\tRecordID string         `json:\"record_id\"`\n401|\tEvents   []EventSummary `json:\"events\"`\n402|}\n403|\n404|// errDigestDisagreement reports bytes at a digest path that a completed\n405|// read proved different from the installing candidate. It is an internal\n406|// marker, never a refusal: callers attribute it through their own site.\n407|var errDigestDisagreement = errors.New(\"digest path holds disagreeing bytes\")\n408|\n409|// installEventBlob installs one event blob idempotently through the\n410|// no-replace open first: a fresh path is created atomically, and only an\n411|// EEXIST loser falls back to comparing against the winner's bytes —\n412|// identical bytes are reused, disagreeing bytes are reported for\n413|// refusal. Leading with the exclusive create (instead of stat-then-act)\n414|// keeps the no-replace property a filesystem fact under a second\n415|// process, not a check-then-act race the repository mutex cannot see:\n416|// the mutex serializes one process, while O_EXCL serializes all of\n417|// them. A path that exists but is not a readable file still fails the\n418|// install, as an operational error rather than a digest disagreement.\n419|func installEventBlob(path string, data []byte) error {\n420|\tif err := writeExclusive(path, data); err == nil {\n421|\t\treturn nil\n422|\t} else if !os.IsExist(err) {\n423|\t\treturn fmt.Errorf(\"install event blob: %w\", err)\n424|\t}\n425|\texisting, readErr := os.ReadFile(path)\n426|\tif readErr != nil || !bytes.Equal(existing, data) {\n427|\t\treturn errDigestDisagreement\n428|\t}\n429|\treturn nil\n430|}\n431|\n432|// writeExclusive installs bytes at a path that must not exist. The\n433|// no-replace open makes append-only a filesystem property, not a convention.\n434|func writeExclusive(path string, data []byte) error {\n435|\tfile, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)\n436|\tif err != nil {\n437|\t\treturn err\n438|\t}\n439|\tif _, err := file.Write(data); err != nil {\n440|\t\t_ = file.Close()\n441|\t\treturn fmt.Errorf(\"write exclusive file: %w\", err)\n442|\t}\n443|\tif err := file.Sync(); err != nil {\n444|\t\t_ = file.Close()\n445|\t\treturn fmt.Errorf(\"fsync exclusive file: %w\", err)\n446|\t}\n447|\tif err := file.Close(); err != nil {\n448|\t\treturn fmt.Errorf(\"close exclusive file: %w\", err)\n449|\t}\n450|\treturn nil\n451|}\n452|\n453|// writeAtomic replaces a path through a temp file in the same directory:\n454|// staged bytes fsync before the rename, the directory fsyncs after.\n455|func writeAtomic(path string, data []byte) error {\n456|\tstaged, err := os.CreateTemp(filepath.Dir(path), \".ax-chain-stage-\")\n457|\tif err != nil {\n458|\t\treturn fmt.Errorf(\"stage chain index: %w\", err)\n459|\t}\n460|\tstagedPath := staged.Name()\n461|\tfinished := false\n462|\tdefer func() {\n463|\t\tif !finished {\n464|\t\t\t_ = staged.Close()\n465|\t\t\t_ = os.Remove(stagedPath)\n466|\t\t}\n467|\t}()\n468|\tif err := staged.Chmod(0o600); err != nil {\n469|\t\treturn fmt.Errorf(\"mode staged chain index: %w\", err)\n470|\t}\n471|\tif _, err := io.Copy(staged, bytes.NewReader(data)); err != nil {\n472|\t\treturn fmt.Errorf(\"write staged chain index: %w\", err)\n473|\t}\n474|\tif err := staged.Sync(); err != nil {\n475|\t\treturn fmt.Errorf(\"fsync staged chain index: %w\", err)\n476|\t}\n477|\tif err := staged.Close(); err != nil {\n478|\t\treturn fmt.Errorf(\"close staged chain index: %w\", err)\n479|\t}\n480|\tfinished = true\n481|\tif err := os.Rename(stagedPath, path); err != nil {\n482|\t\treturn fmt.Errorf(\"install chain index: %w\", err)\n483|\t}\n484|\treturn syncDirectory(filepath.Dir(path))\n485|}\n486|\n487|// blobFileName maps a validated event digest to its file name. The digest\n488|// passed scalar grammar at decode time; Hex is the owner's rendering.\n489|func blobFileName(eventID string) string {\n490|\tdigest, err := scalar.ParseDigest(eventID)\n491|\tif err != nil {\n492|\t\treturn \"invalid.json\"\n493|\t}\n494|\treturn digest.Hex() + \".json\"\n495|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
