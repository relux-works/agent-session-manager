{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cff1","stream":{"kind":"session","id":"01a0ad6b-d9f3-7b60-a446-cfbe978dc3a0"},"sequence":1619,"recorded_at":1780531400003233,"record_type":"event","durability":"durable","causation_id":"47d87e75-54e9-4256-91b6-025175a046f7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"47d87e75-54e9-4256-91b6-025175a046f7","run_stream":{"kind":"run","id":"47d87e75-54e9-4256-91b6-025175a046f7"},"task_stream":{"kind":"task","id":"01a0ad72-bda2-79f3-8068-e5a01cbb476a"},"task_id":"01a0ad72-bda2-79f3-8068-e5a01cbb476a","event":{"kind":"output","task_id":"01a0ad72-bda2-79f3-8068-e5a01cbb476a","chunk":"edited\nchanged lines: lines 809-833\n--- original\n+++ updated\n@@\n-\tmembers, fault := environ.DecodeStrictObject(framed)\n-\tif fault != nil {\n-\t\treturn receipt{}, false, fmt.Errorf(\"decode checkpoint operation receipt: %v\", fault)\n-\t}\n-\tvar recorded receipt\n-\tfor _, leg := range []struct {\n-\t\tname   string\n-\t\ttarget *string\n-\t\tcheck  func(string) (string, error)\n-\t}{\n-\t\t{\"operation_id\", &recorded.OperationID, checkOperationID},\n-\t\t{\"checkpoint_id\", &recorded.CheckpointID, func(value string) (string, error) { return checkDigestMember(value, \"checkpoint_id\") }},\n-\t\t{\"input_digest\", &recorded.InputDigest, func(value string) (string, error) { return checkDigestMember(value, \"input_digest\") }},\n-\t\t{\"session_id\", &recorded.SessionID, checkSessionID},\n-\t} {\n-\t\tvalue, err := stringMember(members, leg.name)\n-\t\tif err != nil {\n-\t\t\treturn receipt{}, false, fmt.Errorf(\"decode checkpoint operation receipt: %v\", err)\n-\t\t}\n-\t\tchecked, err := leg.check(value)\n-\t\tif err != nil {\n-\t\t\treturn receipt{}, false, fmt.Errorf(\"decode checkpoint operation receipt: %v\", err)\n-\t\t}\n-\t\t*leg.target = checked\n-\t}\n+\tmembers, fault := environ.DecodeStrictObject(framed)\n+\tif fault != nil {\n+\t\treturn receipt{