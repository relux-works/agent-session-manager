{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000e21d","stream":{"kind":"session","id":"01a0ad6b-d9f3-7b60-a446-cfbe978dc3a0"},"sequence":3945,"recorded_at":1780531400007885,"record_type":"event","durability":"durable","causation_id":"47d87e75-54e9-4256-91b6-025175a046f7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"47d87e75-54e9-4256-91b6-025175a046f7","run_stream":{"kind":"run","id":"47d87e75-54e9-4256-91b6-025175a046f7"},"task_stream":{"kind":"task","id":"01a0ad97-4b25-7292-9c2f-06e377810ada"},"task_id":"01a0ad97-4b25-7292-9c2f-06e377810ada","event":{"kind":"output","task_id":"01a0ad97-4b25-7292-9c2f-06e377810ada","chunk":"Read text file `internal/sessckpt/capture.go`.\n1|package sessckpt\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"fmt\"\n7|\t\"os\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n13|)\n14|\n15|// Checkpoint schema identity the capture entry binds.\n16|const (\n17|\tcheckpointSchema  = \"urn:ax:schema:checkpoint\"\n18|\tcheckpointVersion = \"1.0.0\"\n19|)\n20|\n21|// Evidence kinds the Safe Boundary Evidence closed shape admits\n22|// (SPEC Section 5.4).\n23|const (\n24|\tEvidenceProviderAPI     = \"provider_api\"\n25|\tEvidenceProviderEvent   = \"provider_event\"\n26|\tEvidenceManagedPTY      = \"managed_pty\"\n27|\tEvidenceTaskBoardBridge = \"task_board_bridge\"\n28|\tEvidenceAcceptedTest    = \"accepted_test\"\n29|)\n30|\n31|// Session persistence kinds the referenced Session Record selects\n32|// (SPEC Section 5.4).\n33|const (\n34|\tSessionKindDirect    = \"direct\"\n35|\tSessionKindTaskBoard = \"task_board\"\n36|)\n37|\n38|// SafeBoundary is the typed terminal evidence leg of the capture\n39|// closure: provider identity plus the quiescence proof. A published\n40|// checkpoint requires all three idleness facts true and both\n41|// counters zero; an adapter that cannot prove full idle must not\n42|// publish, so Capture refuses a non-quiescent boundary before\n43|// publication with the incompatible_schema class (CP-N1).\n44|type SafeBoundary struct {\n45|\tProviderID          string\n46|\tProviderVersion     string\n47|\tEvidence            string\n48|\tInputBlocked        bool\n49|\tForegroundIdle      bool\n50|\tBackgroundIdle      bool\n51|\tOpenProcesses       uint64\n52|\tOpenDatabaseHandles uint64\n53|}\n54|\n55|// Inputs is the typed checkpoint closure: provider identity,\n56|// workspace manifests, the task-board bundle, terminal evidence,\n57|// and the source head, bound to the owning lease tuple and the\n58|// caller-stable operation that makes capture idempotent.\n59|//\n60|// Exactly one persistence leg must be set: ProviderManifestID for\n61|// SessionKindDirect, TaskBoardBundleID for SessionKindTaskBoard.\n62|// The other leg must stay empty. EventHeads carries the\n63|// authoritative event DAG heads immediately before the checkpoint\n64|// object: 1..64 sorted unique digests, each resolving to a chained\n65|// event for the session at or before the owning lease.\n66|type Inputs struct {\n67|\tOperationID         string\n68|\tSessionID           string\n69|\tSessionKind         string\n70|\tLeaseEpoch          uint64\n71|\tLeaseID             string\n72|\tCreatorHostID       string\n73|\tWorkspaceManifestID string\n74|\tProviderManifestID  string\n75|\tTaskBoardBundleID   string\n76|\tBoundary            SafeBoundary\n77|\tEventHeads          []string\n78|\tCreatedAt           string\n79|\tExtensions          map[string]string\n80|}\n81|\n82|// receipt is the machine-local operation record: the operation\n83|// identity with the checkpoint it installed and the input digest\n84|// that makes a retry comparable. It is validated by strict decode\n85|// plus grammar on every read; it carries no closed schema version\n86|// because no peer ever consumes it.\n87|type receipt struct {\n88|\tOperationID  string `json:\"operation_id\"`\n89|\tCheckpointID string `json:\"checkpoint_id\"`\n90|\tInputDigest  string `json:\"input_digest\"`\n91|\tSessionID    string `json:\"session_id\"`\n92|}\n93|\n94|// invalid refuses an unpublishable closure with the SPEC Section\n95|// 5.4 incompatible_schema class: every such error wraps both the\n96|// package sentinel and canonicaljson.ErrInvalidIdentity, so\n97|// callers match either layer with errors.Is. It is a function,\n98|// not a method, so every gate site reads identically.\n99|func invalid(format string, arguments ...any) error {\n100|\treturn fmt.Errorf(\"%w: %w: %s\",\n101|\t\tErrInvalidCheckpoint, canonicaljson.ErrInvalidIdentity, fmt.Sprintf(format, arguments...))\n102|}\n103|\n104|// Capture builds the typed closure into a Checkpoint Record\n105|// 1.0.0, attests it through the sessrepo owner, and installs it\n106|// durably with its operation receipt. The same operation retried\n107|// with byte-identical inputs replays the recorded checkpoint\n108|// without writing; the same operation retried with moved inputs\n109|// refuses ErrCheckpointConflict and writes nothing.\n110|//\n111|// Chain binds the source-head leg: every head must resolve to a\n112|// chained event for the session at or before the owning lease. A\n113|// nil chain refuses closed rather than skipping the gate.\n114|func (store *Store) Capture(chain *sessrepo.Repository, inputs Inputs) (CheckpointRef, []byte, error) {\n115|\tcandidate, err := buildCandidate(inputs)\n116|\tif err != nil {\n117|\t\treturn CheckpointRef{}, nil, err\n118|\t}\n119|\tif err := checkHeadBinding(chain, inputs); err != nil {\n120|\t\treturn CheckpointRef{}, nil, err\n(more lines below)","final_result":true}}}
