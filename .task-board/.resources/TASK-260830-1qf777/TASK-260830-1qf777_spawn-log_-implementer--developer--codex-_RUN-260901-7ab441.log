#!/usr/bin/env python3
"""Disable each config refusal once and require the production-entry tests to redden."""

from __future__ import annotations

import hashlib
import pathlib
import subprocess
import sys


ROOT = pathlib.Path(__file__).resolve().parents[2]
TARGETS = (
    ROOT / "internal/config/validation.go",
    ROOT / "internal/config/schema.go",
    ROOT / "internal/config/writer.go",
)
LOG = ROOT / ".temp/TASK-260830-17suox/TASK-260830-17suox_clause-mutation-sweep-rework.log"


def digest(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def main() -> int:
    originals = {path: path.read_bytes() for path in TARGETS}
    clauses: list[tuple[pathlib.Path, int, str]] = []
    for path, data in originals.items():
        for line_number, line in enumerate(data.decode().splitlines(keepends=True), 1):
            if "return " in line and "configError(" in line:
                clauses.append((path, line_number, line))

    records = [f"clauses found: {len(clauses)}"]
    survivors: list[str] = []
    try:
        for ordinal, (path, line_number, original_line) in enumerate(clauses, 1):
            source = originals[path].decode().splitlines(keepends=True)
            call = original_line[original_line.index("configError(") :].rstrip("\r\n")
            newline = "\r\n" if original_line.endswith("\r\n") else "\n"
            indent = original_line[: len(original_line) - len(original_line.lstrip())]
            source[line_number - 1] = f"{indent}_ = {call}{newline}"
            path.write_text("".join(source))

            result = subprocess.run(
                ["go", "test", "./internal/config", "-count=1"],
                cwd=ROOT,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                check=False,
            )
            relative = path.relative_to(ROOT)
            clause = original_line.strip()
            status = "REDDENED" if result.returncode != 0 else "SURVIVED"
            record = f"{ordinal:03d} {status} exit={result.returncode} {relative}:{line_number} {clause}"
            records.append(record)
            if result.returncode == 0:
                survivors.append(record)
            path.write_bytes(originals[path])

            if digest(path.read_bytes()) != digest(originals[path]):
                records.append(f"RESTORE_MISMATCH {relative}:{line_number}")
                return 2
    finally:
        for path, data in originals.items():
            path.write_bytes(data)

    records.append(f"total survivors: {len(survivors)} / {len(clauses)}")
    if survivors:
        records.append("survivors:")
        records.extend(survivors)
    LOG.write_text("\n".join(records) + "\n")
    print("\n".join(records))
    return 1 if survivors else 0


if __name__ == "__main__":
    sys.exit(main())
