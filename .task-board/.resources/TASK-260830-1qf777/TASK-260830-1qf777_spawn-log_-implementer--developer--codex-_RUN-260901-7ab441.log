+func TestLoadOSRefusesRealSymlinkAtProductionEntry(t *testing.T) {
+	platform := hostPlatform(t)
+	root := t.TempDir()
+	target := filepath.Join(root, "target.toml")
+	link := filepath.Join(root, "config.toml")
+	if err := os.WriteFile(target, minimalValidConfig(platform), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(target, link); err != nil {
+		t.Skipf("host cannot create test symlink: %v", err)
+	}
+	overrides := Overrides{ConfigFile: link}
+	for _, specification := range OverrideRegistry() {
+		if specification.Class != ConfigFile {
+			overrides[specification.Class] = filepath.Join(root, string(specification.Class))
+		}
+	}
+	_, err := LoadOS(platform, overrides)
+	if !errors.Is(err, ErrConfigNotRegular) {
+		t.Fatalf("LoadOS(real symlink) error = %v, want ErrConfigNotRegular", err)
+	}
+}
