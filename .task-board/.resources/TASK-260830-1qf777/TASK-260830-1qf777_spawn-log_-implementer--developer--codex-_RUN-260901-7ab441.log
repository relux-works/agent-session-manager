+		DirectoryInstallations:      current.DirectoryInstallations,
+		DirectoryEnrichmentProfiles: current.DirectoryEnrichmentProfiles,
+		DirectoryPeerDisclosure:     current.DirectoryPeerDisclosure,
+	}
