+func encodeVersion2(configuration Configuration, context DecodeContext) ([]byte, error) {
+	current := currentWire(configuration)
+	backend := ""
+	switch configuration.Terminal.BackendID {
+	case "ax.tmux":
+		backend = "tmux"
+	case "ax.conpty":
