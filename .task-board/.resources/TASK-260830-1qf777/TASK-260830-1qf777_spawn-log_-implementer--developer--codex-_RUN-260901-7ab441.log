+	if err := toml.NewEncoder(&output).Encode(raw); err != nil {
+		return nil, configError("TOML", errors.Join(ErrConfigEncode, err)) // config-refusal-subsumed: the v1 production reader supplies only closed scalar, slice, and map-free values to this private v2 wire encoder
+	}
+	if _, err := Decode(output.Bytes(), context); err != nil {
+		return nil, errors.Join(ErrConfigEncode, err)
+	}
+	return output.Bytes(), nil
+}
