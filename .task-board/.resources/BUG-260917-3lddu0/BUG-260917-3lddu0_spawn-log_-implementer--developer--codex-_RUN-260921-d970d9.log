+func TestEmitParkedReachesAppendAdmissionGateAfterStaleObservation(t *testing.T) {
+	t.Parallel()
+	world := buildRunWorld(t)
+	failedID := appendChainEvent(t, world.repo, "session.failed", 1, fixtureLeaseA, 2, world.headID, map[string]any{
