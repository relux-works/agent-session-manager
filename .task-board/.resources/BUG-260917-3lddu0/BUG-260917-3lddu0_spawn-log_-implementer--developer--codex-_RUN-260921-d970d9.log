+package axpane
+
+import (
+	"testing"
+
+	"github.com/relux-works/agent-session-manager/internal/provhost"
+	"github.com/relux-works/agent-session-manager/internal/sessprofile"
+	"github.com/relux-works/agent-session-manager/internal/sessrepo"
+)
+
+// TestReviewProbeLosingLeaseProfileDirectDrivesYolo is the direct production
+// reproduction of review probe 15 for the trunk baseline: AppendEvent accepts
+// profile.changed under A after successor B wins, and the profile fold then
+// maps the stored yolo source to the unrestricted Codex flag.
+func TestReviewProbeLosingLeaseProfileDirectDrivesYolo(t *testing.T) {
+	world := buildRunWorld(t)
+	leases, err := world.repo.ListLeases(fixtureSession)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := world.repo.CompareAndSwapLease(fixtureSession, sessrepo.LeaseExpectation{RecordID: leases[0].RecordID}, sessrepo.SuccessorLeaseInput{
+		CreateLeaseInput: sessrepo.CreateLeaseInput{LeaseID: "cccccccc-dddd-4eee-8fff-000000000002", HolderHostID: fixtureLocalHost, IssuedByHostID: fixtureLocalHost, CreatedAt: fixtureCreatedAt},
+		Reason:           "graceful_takeover",
+		CheckpointID:     world.ckptID,
+	}); err != nil {
+		t.Fatal(err)
+	}
+	appendChainEvent(t, world.repo, "profile.changed", 1, fixtureLeaseA, 2, world.headID, map[string]any{
+		"from": "standard", "to": "yolo", "confirmed": true,
+	})
+	record, events, err := LoadProfile(world.repo, fixtureSession)
+	if err != nil {
+		t.Fatal(err)
+	}
+	profile, err := sessprofile.Derive(record, events)
+	if err != nil {
+		t.Fatal(err)
+	}
+	mapping, err := provhost.ProfileMapping("codex", profile.Profile)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Logf("baseline losing-lease profile: profile=%s source=%s has_source=%t mapping=%q", profile.Profile, profile.Source, profile.HasSource, mapping)
+	if profile.Profile != sessprofile.ProfileYOLO || !profile.HasSource || mapping != "--dangerously-bypass-approvals-and-sandbox" {
+		t.Fatalf("baseline profile = %+v mapping=%q, want losing-lease yolo with the unrestricted mapping", profile, mapping)
+	}
+}
