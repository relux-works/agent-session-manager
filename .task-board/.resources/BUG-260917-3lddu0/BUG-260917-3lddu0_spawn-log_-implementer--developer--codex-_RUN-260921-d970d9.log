+		t.Fatalf("chain after stale append = %+v, want the original lease-A tail only", events)
+	}
+	var eventID struct {
+		EventID string `json:"event_id"`
+	}
+	if err := json.Unmarshal(losing, &eventID); err != nil {
+		t.Fatal(err)
+	}
