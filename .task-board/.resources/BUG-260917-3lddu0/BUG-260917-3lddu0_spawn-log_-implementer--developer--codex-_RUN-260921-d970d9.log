	if err := json.Unmarshal(fork, &forkID); err != nil {
		t.Fatal(err)
	}
	preserved, err := os.ReadFile(blobPathFor(t, repository, testSessionID, forkID.EventID))
	if err != nil {
		t.Fatalf("divergent blob was not preserved: %v", err)
