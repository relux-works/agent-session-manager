+		t.Fatal(err)
+	}
+	preserved, err := os.ReadFile(blobPathFor(t, repository, testSessionID, eventID.EventID))
+	if err != nil {
+		t.Fatalf("losing event was not preserved: %v", err)
+	}
+	if string(preserved) != string(losing) {
