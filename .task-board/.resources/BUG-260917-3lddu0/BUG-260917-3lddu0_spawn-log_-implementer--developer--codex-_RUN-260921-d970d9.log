+			t.Fatalf("SetProfile(superseded lease) error = %v, want stale lease refusal", err)
+		}
+		events, err := repository.ListEvents(testSessionID)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(events) != 1 || events[0].EventID != tail {
