+			CreateLeaseInput: sessrepo.CreateLeaseInput{LeaseID: testLeaseIDB, HolderHostID: testHostID, IssuedByHostID: testHostID, CreatedAt: testCreatedAt},
+			Reason: "graceful_takeover", CheckpointID: zeroDigest,
+		}); err != nil {
