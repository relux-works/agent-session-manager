new file mode 100644
index 0000000000000000000000000000000000000000..2650103610a75abef62eabdf7bd5c0033bff908f
--- /dev/null
+++ b/internal/sessrepo/testdata/mutate_append_admission.py
@@ -0,0 +1,152 @@
+#!/usr/bin/env python3
+"""Run narrowing mutants for the sessrepo append winner gate.
+
+Usage: PYTHONDONTWRITEBYTECODE=1 python3 \
+  internal/sessrepo/testdata/mutate_append_admission.py /absolute/evidence-dir
+
+Each N-mutant keeps the gate present and admits exactly one rejected lease
+class. The selected Go test drives Repository.AppendEvent, so a surviving
+mutant is a real production-entry failure rather than a source-text check.
+"""
+
+import hashlib
+import json
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import sys
+
+
+ROOT = Path(__file__).resolve().parents[3]
+OUTPUT = Path(sys.argv[1]).resolve()
+OUTPUT.mkdir(parents=True, exist_ok=True)
+COPY = OUTPUT / "mutation-source"
+if COPY.exists():
+    raise SystemExit("refusing to overwrite an existing mutation source")
+COPY.mkdir()
+shutil.copytree(ROOT / "internal", COPY / "internal")
