+		first, err := repository.CreateLease(testSessionID, sessrepo.CreateLeaseInput{
+			LeaseID: testLeaseID, HolderHostID: testHostID, IssuedByHostID: testHostID, CreatedAt: testCreatedAt,
+		})
+		if err != nil {
