+		epoch:        2,
+		leaseID:      testLeaseIDC,
+		sequence:     2,
+		eventType:    "session.idle",
+		payload:      idlePayload(),
+	})
+	_, err := repository.AppendEvent(testSessionID, losing)
+	mustErrorIs(t, err, ErrDivergentBranch, "AppendEvent(same-epoch losing tail)")
+	events, err := repository.ListEvents(testSessionID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(events) != 1 || events[0].LeaseID != testLeaseIDC {
+		t.Fatalf("chain after same-epoch losing append = %+v, want the original lease-C tail only", events)
