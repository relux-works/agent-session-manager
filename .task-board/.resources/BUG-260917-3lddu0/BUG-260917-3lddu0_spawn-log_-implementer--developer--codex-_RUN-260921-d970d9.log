+		Action: ActionParked, ParkReason: fencing.ParkStaleOwner, WinningLeaseID: fixtureLeaseA,
+	}, EmitParams{
+		SessionID: fixtureSession, CreatedByHost: fixtureLocalHost,
+		LeaseEpoch: 1, LeaseID: fixtureLeaseA, LeaseSequence: 3,
