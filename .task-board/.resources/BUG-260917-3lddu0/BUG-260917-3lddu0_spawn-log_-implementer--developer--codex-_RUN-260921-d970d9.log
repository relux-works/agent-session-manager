+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(events) != 1 || events[0].EventID != tail {
+			t.Fatalf("chain after refused same-epoch SetProfile = %+v, want the original tail only", events)
+		}
+	})
+}
