+		}
+		request := validSetProfileRequest()
+		request.LeaseEpoch = 2
+		request.LeaseID = testLeaseIDC
+		_, err = (&Transactor{Repo: repository}).SetProfile(request)
+		if err == nil || !errors.Is(err, sessrepo.ErrDivergentBranch) {
