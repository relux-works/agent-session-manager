+	tail, _ := appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 2, testLeaseIDC, 1, "session.created", createdPayload(reference.RecordID))
+	firstLease := mustCreateLease(t, repository, testSessionID, createLeaseFixture())
