package sessrepo

import (
	"errors"
	"testing"
)

// TestReviewProbeSupersededLeaseTailStillMatches is the minimal production
// entry reproduction for the review probe 9 defect: lease B wins in the
// durable lease store while the event-chain tail still remains under A.
func TestReviewProbeSupersededLeaseTailStillMatches(t *testing.T) {
	repository := openTestRepository(t)
	reference := createTestSession(t, repository)
	firstLease := mustCreateLease(t, repository, testSessionID, createLeaseFixture())
	first, _ := appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, "session.created", createdPayload(reference.RecordID))
	mustCompareAndSwap(t, repository, testSessionID, LeaseExpectation{RecordID: firstLease.RecordID}, successorLeaseFixture())

	losing := buildEvent(t, eventOptions{
		sessionID:    testSessionID,
		predecessors: []string{first.EventID},
		epoch:        1,
		leaseID:      testLeaseID,
		sequence:     2,
		eventType:    "profile.changed",
		payload:      map[string]any{"from": "standard", "to": "yolo", "confirmed": true},
	})
	_, err := repository.AppendEvent(testSessionID, losing)
	t.Logf("losing lease A append after successor B won while tail remains A: err=%v", err)
	if err == nil || !errors.Is(err, ErrStaleLease) {
		t.Fatalf("AppendEvent(losing lease before tail move) error = %v, want stale lease refusal", err)
	}
}
