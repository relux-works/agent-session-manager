{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cbe1","stream":{"kind":"session","id":"01a06e59-f410-76d3-be05-ab6d05f2f618"},"sequence":1099,"recorded_at":1780531400002193,"record_type":"event","durability":"durable","causation_id":"1619d586-4e11-48b5-9a4b-4a908ec4863f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1619d586-4e11-48b5-9a4b-4a908ec4863f","run_stream":{"kind":"run","id":"1619d586-4e11-48b5-9a4b-4a908ec4863f"},"task_stream":{"kind":"task","id":"5f77d32a-c61d-4a49-af85-7b736f7c0722"},"task_id":"5f77d32a-c61d-4a49-af85-7b736f7c0722","event":{"kind":"output","task_id":"5f77d32a-c61d-4a49-af85-7b736f7c0722","chunk":"edited\nchanged lines: lines 190-214\n--- original\n+++ updated\n@@\n-// TestVerifyRefusesForgedReceipts proves a self-minted receipt for bytes\n-// the host never trusted fails: the receipt digest must equal the digest\n-// of the bytes actually on disk.\n-func TestVerifyRefusesForgedReceipts(t *testing.T) {\n-\tfake := newFakeSystem()\n-\tfake.addFile(\"/plugins\", \"ax-provider-foo\", []byte(\"real bytes\"), fakeUID)\n-\tcandidate := discoverOneFoo(t, fake)\n-\t// Forge: swap the recorded digest for the digest of attacker bytes.\n-\tforged := candidate\n-\t_ = forged\n-\trecord := trustOneFoo(t, candidate)\n-\tfake.files[\"/plugins/ax-provider-foo\"] = fakeFile{content: []byte(\"attacker bytes\"), uid: fakeUID, regular: true}\n-\tif err := Verify(record, fakeOwner(), fake); err == nil {\n-\t\tt.Fatal(\"Verify accepted attacker bytes against a genuine receipt\")\n-\t}\n-\t// And a receipt minted for one content never validates other content,\n-\t// even when every path and owner fact matches.\n-\tother, err := Trust(candidate, mustTimestamp(t, trustInstant))\n-\tif err != nil {\n-\t\tt.Fatalf(\"Trust: %v\", err)\n-\t}\n-\tif other.Digest() == scalar.SHA256Digest([]byte(\"attacker bytes\")) {\n-\t\tt.Fatal(\"Trust minted a receipt matching untrusted bytes\")\n-\t}\n-}\n+// TestVerifyRefusesForgedReceipts proves Verify rechecks the receipt\n+// instead of trusting its claims: a self-minted receipt whose digest does\n+// not match the bytes on disk fails, even when every path and owner fact\n+// matches.\n+func TestVerifyRefusesForgedReceipts(t *testing.T) {\n+\tfake := newFakeSystem()\n+\tfake.addFile(\"/plugins\", \"ax-provider-foo\", []byte(\"real bytes\"), fakeUID)\n+\tcandidate := discoverOneFoo(t, fake)\n+\tgenuine := trustOneFoo(t, candidate)\n+\tforged := TrustRecord{\n+\t\tproviderID: genuine.ProviderID(),\n+\t\tsourcePath: genuine.SourcePath(),\n+\t\tcanon:      genuine.CanonicalPath(),\n+\t\tdigest:     scalar.SHA256Digest([]byte(\"attacker bytes\")),\n+\t\towner:      genuine.Owner(),\n+\t\ttrustedAt:  genuine.TrustedAt(),\n+\t}\n+\tif err := Verify(forged, fakeOwner(), fake); err == nil {\n+\t\tt.Fatal(\"Verify accepted a self-minted receipt, want integrity_failure\")\n+\t} else if code := errorCode(t, err); code != codeIntegrityFailure {\n+\t\tt.Fatalf(\"code = %q, want integrity_failure\", code)\n+\t}\n+\tif err := Verify(genuine, fakeOwner(), fake); err != nil {\n+\t\tt.Fatalf(\"Verify refused the genuine receipt: %v\", err)\n+\t}\n+}\n"}}}
