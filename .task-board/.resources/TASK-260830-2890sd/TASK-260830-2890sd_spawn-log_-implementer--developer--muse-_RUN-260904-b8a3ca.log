nternal/config -count=1 -v\\n372:    go test ./internal/config -cover -count=1\\n373:    go run ./internal/traceability/cmd/tracecheck -section 6.2\\n383:[`internal/canonicaljson`](internal/canonicaljson) exposes the production RFC\\n461:[`internal/canonicaljson/testdata/constraint-enumeration.md`](internal/canonicaljson/testdata/constraint-enumeration.md).\\n469:[`internal/specdoc`](internal/specdoc) document verbatim, beginning on the exact\\n646:graph, and against the digest-pinned document in `internal/specdoc` — a quoted\\n===\\n16:func ParseTimestamp(value string) (Timestamp, error) {\\n31:func (value Timestamp) String() string { return value.value }\\n33:func (value Timestamp) MarshalText() ([]byte, error) {\\n40:func (value *Timestamp) UnmarshalText(data []byte) error {\\n49:func (value Timestamp) Time() (time.Time, error) {\\n61:func parseTimestampInstant(value string) (time.Time, error) {\\n110:func (value Timestamp) MarshalJSON() ([]byte, error) {\\n117:func (value *Timestamp) UnmarshalJSON(data []byte) error {\\n\",\n  \"original_output_bytes\": 1899,\n  \"original_output_tokens\": 475,\n  \"truncated\": false\n}"}}}
