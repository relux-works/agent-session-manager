\treturn nil\n470|}\n471|\n472|// digestBytes decodes the recorded digest for constant-time comparison. A\n473|// TrustRecord always carries a digest produced by SHA256Digest, so the\n474|// decode cannot fail; a receipt that does not decode compares unequal\n475|// rather than panicking.\n476|func digestBytes(digest scalar.Digest) []byte {\n477|\traw := digest.Hex()\n478|\tif len(raw) != sha256.Size*2 {\n479|\t\treturn nil\n(more lines below)"}}}
