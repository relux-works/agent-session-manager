st.ValueSpec:\n273|\t\t\t\t\tfor _, ident := range concrete.Names {\n274|\t\t\t\t\t\tif ast.IsExported(ident.Name) {\n275|\t\t\t\t\t\t\tout = append(out, ident.Name)\n276|\t\t\t\t\t\t}\n277|\t\t\t\t\t}\n278|\t\t\t\t}\n279|\t\t\t}\n280|\t\t}\n281|\t\tfor _, decl := range syntax.Decls {\n282|\t\t\tfunction, ok := decl.(*ast.FuncDecl)\n283|\t\t\tif !ok || function.Name == nil || !ast.IsExported(function.Name.Name) {\n284|\t\t\t\tcontinue\n285|\t\t\t}\n286|\t\t\tif function.Recv == nil {\n287|\t\t\t\tout = append(out, function.Name.Name)\n288|\t\t\t} else {\n289|\t\t\t\tout = append(out, function.Name.Name+\" (method)\")\n290|\t\t\t}\n291|\t\t}\n292|\t}\n293|\treturn out\n294|}\n295|\n296|// structMembers derives field names and types for the named structs from\n297|// package source.\n298|func structMembers(t *testing.T, wanted ...string) map[string]string {\n299|\tt.Helper()\n300|\twant := map[string]bool{}\n301|\tfor _, name := range wanted {\n302|\t\twant[name] = true\n303|\t}\n304|\tmembers := map[string]string{}\n305|\tfor _, syntax := range parseProductionSources(t) {\n306|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n307|\t\t\tspec, ok := node.(*ast.TypeSpec)\n308|\t\t\tif !ok || !want[spec.Name.Name] {\n309|\t\t\t\treturn true\n310|\t\t\t}\n311|\t\t\tstructure, ok := spec.Type.(*ast.StructType)\n312|\t\t\tif !ok {\n313|\t\t\t\treturn false\n314|\t\t\t}\n315|\t\t\tfor _, field := range structure.Fields.List {\n316|\t\t\t\tfor _, ident := range field.Names {\n317|\t\t\t\t\tmembers[ident.Name] = spec.Name.Name\n318|\t\t\t\t}\n319|\t\t\t}\n320|\t\t\treturn false\n321|\t\t})\n322|\t}\n323|\treturn members\n324|}\n325|\n326|// parseProductionSources parses every non-test Go source in the package\n327|// directory.\n328|func parseProductionSources(t *testing.T) map[string]*ast.File {\n329|\tt.Helper()\n330|\tdirectory, err := os.Getwd()\n331|\tif err != nil {\n332|\t\tt.Fatalf(\"Getwd: %v\", err)\n333|\t}\n334|\tentries, err := os.ReadDir(directory)\n335|\tif err != nil {\n336|\t\tt.Fatalf(\"ReadDir: %v\", err)\n337|\t}\n338|\tfileset := token.NewFileSet()\n339|\tout := map[string]*ast.File{}\n340|\tfor _, entry := range entries {\n341|\t\tname := entry.Name()\n342|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n343|\t\t\tcontinue\n344|\t\t}\n345|\t\tsource, err := os.ReadFile(filepath.Join(directory, name))\n346|\t\tif err != nil {\n347|\t\t\tt.Fatalf(\"ReadFile(%s): %v\", name, err)\n348|\t\t}\n349|\t\tsyntax, err := parser.ParseFile(fileset, name, source, parser.ParseComments)\n350|\t\tif err != nil {\n351|\t\t\tt.Fatalf(\"ParseFile(%s): %v\", name, err)\n352|\t\t}\n353|\t\tout[name] = syntax\n354|\t}\n355|\treturn out\n356|}"}}}
