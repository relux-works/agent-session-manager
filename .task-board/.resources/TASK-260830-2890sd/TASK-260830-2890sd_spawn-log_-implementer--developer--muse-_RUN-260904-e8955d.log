{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5c5","stream":{"kind":"session","id":"01a06e76-bae7-71e0-a570-bb4cc0067a43"},"sequence":317,"recorded_at":1780531400000629,"record_type":"event","durability":"durable","causation_id":"45fd7c01-9695-4667-a2dd-8bdcc25383b6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"45fd7c01-9695-4667-a2dd-8bdcc25383b6","run_stream":{"kind":"run","id":"45fd7c01-9695-4667-a2dd-8bdcc25383b6"},"task_stream":{"kind":"task","id":"ffb04450-3467-46d8-affc-d8368a3e940b"},"task_id":"ffb04450-3467-46d8-affc-d8368a3e940b","event":{"kind":"output","task_id":"ffb04450-3467-46d8-affc-d8368a3e940b","chunk":"Read text file `internal/provider/enumeration_test.go`.\n1|package provider\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"strings\"\n10|\t\"testing\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n15|)\n16|\n17|// sectionLines joins the pinned document lines for section 7.1, failing\n18|// when the section boundaries move. Every citation below resolves against\n19|// the real text, never against a restatement in this repository.\n20|func sectionLines(t *testing.T, document *specdoc.Document, section string, first, last int) string {\n21|\tt.Helper()\n22|\tfor _, line := range []int{first, last} {\n23|\t\tgot, ok := document.SectionID(line)\n24|\t\tif !ok || got != section {\n25|\t\t\tt.Fatalf(\"SPEC.md line %d is in section %q, want %q\", line, got, section)\n26|\t\t}\n27|\t}\n28|\tvar body strings.Builder\n29|\tfor line := first; line <= last; line++ {\n30|\t\ttext, ok := document.Line(line)\n31|\t\tif !ok {\n32|\t\t\tt.Fatalf(\"SPEC.md line %d is missing\", line)\n33|\t\t}\n34|\t\tbody.WriteString(text)\n35|\t\tbody.WriteString(\"\\n\")\n36|\t}\n37|\treturn body.String()\n38|}\n39|\n40|// requireQuote asserts the excerpt occurs verbatim in the pinned document\n41|// and begins on a line inside the cited section.\n42|func requireQuote(t *testing.T, document *specdoc.Document, excerpt, section string) {\n43|\tt.Helper()\n44|\tif !document.Contains(excerpt) {\n45|\t\tt.Fatalf(\"pinned document does not contain %q\", excerpt)\n46|\t}\n47|\tlines := document.QuoteLines(excerpt)\n48|\tif len(lines) == 0 {\n49|\t\tt.Fatalf(\"pinned document quotes no line for %q\", excerpt)\n50|\t}\n51|\tgot, ok := document.SectionID(lines[0])\n52|\tif !ok || got != section {\n53|\t\tt.Fatalf(\"%q begins on SPEC.md line %d in section %q, want %q\", excerpt, lines[0], got, section)\n54|\t}\n55|\tt.Logf(\"%q begins on SPEC.md line %d\", excerpt, lines[0])\n56|}\n57|\n58|// TestSection71BuiltinRegistryIsDocumentOrder proves the builtin registry\n59|// enumerates exactly the six Section 7.1 built-ins in the section's listed\n60|// order. The order is derived from the pinned text: each name's first\n61|// tagged occurrence inside Section 7.1 must appear in registry order.\n62|func TestSection71BuiltinRegistryIsDocumentOrder(t *testing.T) {\n63|\tdocument, err := specdoc.Load()\n64|\tif err != nil {\n65|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n66|\t}\n67|\twindow := sectionLines(t, document, \"7.1\", 2622, 2653)\n68|\tnames := []string{\"codex\", \"claude\", \"gemini\", \"muse\", \"antigravity\", \"pi\"}\n69|\tprevious := -1\n70|\tfor _, name := range names {\n71|\t\toffset := strings.Index(window, \"<code>\"+name+\"</code>\")\n72|\t\tif offset == -1 {\n73|\t\t\tt.Fatalf(\"Section 7.1 does not list builtin %q\", name)\n74|\t\t}\n75|\t\tif offset <= previous {\n76|\t\t\tt.Fatalf(\"Section 7.1 lists %q out of registry order\", name)\n77|\t\t}\n78|\t\tprevious = offset\n79|\t}\n80|\tgot := Builtins()\n81|\tif len(got) != len(names) {\n82|\t\tt.Fatalf(\"Builtins() = %v, want the six Section 7.1 names\", got)\n83|\t}\n84|\tfor i, name := range names {\n85|\t\tif got[i] != name {\n86|\t\t\tt.Fatalf(\"Builtins() = %v, want Section 7.1 order %v\", got, names)\n87|\t\t}\n88|\t}\n89|\trequireQuote(t, document, \"Built-in support covers\", \"7.1\")\n90|}\n91|\n92|// TestSection71DiscoveryOrderIsPinned quotes the Section 7.1 discovery\n93|// order behind Discover's source ranking and the PATH gate.\n94|func TestSection71DiscoveryOrderIsPinned(t *testing.T) {\n95|\tdocument, err := specdoc.Load()\n96|\tif err != nil {\n97|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n98|\t}\n99|\tfor _, excerpt := range []string{\n100|\t\t\"configured <code>providers.plugin_dirs</code> in listed order\",\n101|\t\t\"built-in adapters\",\n102|\t\t\"<code>PATH</code>, only when <code>allow_path_plugins</code> is true\",\n103|\t\t\"The order does not establish precedence\",\n104|\t} {\n105|\t\trequireQuote(t, document, excerpt, \"7.1\")\n106|\t}\n107|}\n108|\n109|// TestSection71DuplicateRefusalIsPinned quotes the duplicate rule and its\n110|// mandated code behind the duplicate refusal.\n111|func TestSection71DuplicateRefusalIsPinned(t *testing.T) {\n112|\tdocument, err := specdoc.Load()\n113|\tif err != nil {\n114|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n115|\t}\n116|\trequireQuote(t, document,\n117|\t\t\"discovery MUST fail with <code>invalid_config</code> before either candidate is probed or executed\",\n118|\t\t\"7.1\")\n119|\trequireQuote(t, document, \"the operator must remove or rename one candidate\", \"7.1\")\n120|}\n121|\n122|// TestSection71TrustRulesArePinned quotes the trust recording, symlink,\n123|// regular-file, ownership, and renewed-trust rules behind Trust and\n124|// Verify.\n125|func TestSection71TrustRulesArePinned(t *testing.T) {\n126|\tdocument, err := specdoc.Load()\n127|\tif err != nil {\n128|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n129|\t}\n130|\tfor _, excerpt := range []string{\n131|\t\t\"External provider executables are named <code>ax-provider-&lt;id&gt;</code>\",\n132|\t\t\"<code>id</code> matches <code>[a-z][a-z0-9-]{0,31}</code>\",\n133|\t\t\"the canonical absolute executable path and SHA-256 digest MUST be recorded at trust time\",\n134|\t\t\"Symlinks MUST be resolved before comparison\",\n135|\t\t\"the target MUST be a regular file owned by the operator or an administrator-approved identity\",\n136|\t\t\"a changed path target or digest MUST require renewed trust\",\n137|\t\t\"they MUST receive only the minimum operation-specific inputs\",\n138|\t} {\n139|\t\trequireQuote(t, document, excerpt, \"7.1\")\n140|\t}\n141|}\n142|\n143|// TestSection71AdvertisesNoPublicSDK quotes the M0 non-advertisement rule\n144|// and proves the package honors it structurally: no exported symbol name\n145|// offers an SDK, client, stable, or public surface.\n146|func TestSection71AdvertisesNoPublicSDK(t *testing.T) {\n147|\tdocument, err := specdoc.Load()\n148|\tif err != nil {\n149|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n150|\t}\n151|\trequireQuote(t, document, \"M0 MUST NOT advertise a public stable plugin SDK\", \"7.1\")\n152|\tfor _, symbol := range exportedSymbols(t) {\n153|\t\tlowered := strings.ToLower(symbol)\n154|\t\tfor _, banned := range []string{\"sdk\", \"stable\", \"public\", \"client\"} {\n155|\t\t\tif strings.Contains(lowered, banned) {\n156|\t\t\t\tt.Fatalf(\"exported symbol %q advertises a public SDK surface\", symbol)\n157|\t\t\t}\n158|\t\t}\n159|\t}\n160|}\n161|\n162|// TestCandidatesAdvertiseNoCapability proves discovery never advertises\n163|// what the probe plane has not proven: no Candidate or TrustRecord member\n164|// carries availability, status, enabled, support, or capability state. The\n165|// member list is derived from package source, never hand-listed.\n166|func TestCandidatesAdvertiseNoCapability(t *testing.T) {\n167|\tmembers := structMembers(t, \"Candidate\", \"TrustRecord\")\n168|\tfor member, typ := range members {\n169|\t\tlowered := strings.ToLower(member)\n170|\t\tfor _, banned := range []string{\"availab\", \"status\", \"enabled\", \"support\", \"capab\"} {\n171|\t\t\tif strings.Contains(lowered, banned) {\n172|\t\t\t\tt.Fatalf(\"member %q (%s) advertises capability state\", member, typ)\n173|\t\t\t}\n174|\t\t}\n175|\t}\n176|\tif len(members) == 0 {\n177|\t\tt.Fatal(\"derived no candidate members; the scan is blind\")\n178|\t}\n179|\tt.Logf(\"scanned %d Candidate/TrustRecord members, none carries capability state\", len(members))\n180|}\n181|\n182|// TestDiscoveryReachesNoProcess proves the ordering guarantee behind the\n183|// duplicate refusal: no package source imports a process-execution\n184|// facility, so Discover cannot probe or execute a candidate. The import\n185|// list is derived from package source.\n186|func TestDiscoveryReachesNoProcess(t *testing.T) {\n187|\tfileset := token.NewFileSet()\n188|\tdirectory, err := os.Getwd()\n189|\tif err != nil {\n190|\t\tt.Fatalf(\"Getwd: %v\", err)\n191|\t}\n192|\tentries, err := os.ReadDir(directory)\n193|\tif err != nil {\n194|\t\tt.Fatalf(\"ReadDir: %v\", err)\n195|\t}\n196|\tfound := false\n197|\tfor _, entry := range entries {\n198|\t\tname := entry.Name()\n199|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n200|\t\t\tcontinue\n201|\t\t}\n202|\t\tfound = true\n203|\t\tsource, err := os.ReadFile(filepath.Join(directory, name))\n204|\t\tif err != nil {\n205|\t\t\tt.Fatalf(\"ReadFile(%s): %v\", name, err)\n206|\t\t}\n207|\t\tsyntax, err := parser.ParseFile(fileset, name, source, parser.ImportsOnly)\n208|\t\tif err != nil {\n209|\t\t\tt.Fatalf(\"ParseFile(%s): %v\", name, err)\n210|\t\t}\n211|\t\tfor _, clause := range syntax.Imports {\n212|\t\t\tpath := strings.Trim(clause.Path.Value, `\"`)\n213|\t\t\tif path == \"os/exec\" || strings.HasPrefix(path, \"os/exec/\") {\n214|\t\t\t\tt.Fatalf(\"%s imports process execution (%s)\", name, path)\n215|\t\t\t}\n216|\t\t}\n217|\t}\n218|\tif !found {\n219|\t\tt.Fatal(\"scanned no production sources; the check is blind\")\n220|\t}\n221|}\n2