\"Symlinks MUST be resolved before comparison\",\n135|\t\t\"the target MUST be a regular file owned by the operator or an administrator-approved identity\",\n136|\t\t\"a changed path target or digest MUST require renewed trust\",\n137|\t\t\"they MUST receive only the minimum operation-specific inputs\",\n138|\t} {\n139|\t\trequireQuote(t, document, excerpt, \"7.1\")\n140|\t}\n141|}\n142|\n143|// TestSection71AdvertisesNoPublicSDK quotes the M0 non-advertisement rule\n144|// and proves the package honors it structurally: no exported symbol name\n145|// offers an SDK, client, stable, or public surface.\n146|func TestSection71AdvertisesNoPublicSDK(t *testing.T) {\n147|\tdocument, err := specdoc.Load()\n148|\tif err != nil {\n149|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n150|\t}\n151|\trequireQuote(t, document, \"M0 MUST NOT advertise a public stable plugin SDK\", \"7.1\")\n152|\tfor _, symbol := range exportedSymbols(t) {\n153|\t\tlowered := strings.ToLower(symbol)\n154|\t\tfor _, banned := range []string{\"sdk\", \"stable\", \"public\", \"client\"} {\n155|\t\t\tif strings.Contains(lowered, banned) {\n156|\t\t\t\tt.Fatalf(\"exported symbol %q advertises a public SDK surface\", symbol)\n157|\t\t\t}\n158|\t\t}\n159|\t}\n160|}\n161|\n162|// TestCandidatesAdvertiseNoCapability proves discovery never advertises\n163|// what the probe plane has not proven: no Candidate or TrustRecord member\n164|// carries availability, status, enabled, support, or capability state. The\n165|// member list is derived from package source, never hand-listed.\n166|func TestCandidatesAdvertiseNoCapability(t *testing.T) {\n167|\tmembers := structMembers(t, \"Candidate\", \"TrustRecord\")\n168|\tfor member, typ := range members {\n169|\t\tlowered := strings.ToLower(member)\n170|\t\tfor _, banned := range []string{\"availab\", \"status\", \"enabled\", \"support\", \"capab\"} {\n171|\t\t\tif strings.Contains(lowered, banned) {\n172|\t\t\t\tt.Fatalf(\"member %q (%s) advertises capability state\", member, typ)\n173|\t\t\t}\n174|\t\t}\n175|\t}\n176|\tif len(members) == 0 {\n177|\t\tt.Fatal(\"derived no candidate members; the scan is blind\")\n178|\t}\n179|\tt.Logf(\"scanned %d Candidate/TrustRecord members, none carries capability state\", len(members))\n180|}\n181|\n182|// TestDiscoveryReachesNoProcess proves the ordering guarantee behind the\n183|// duplicate refusal: no package source imports a process-execution\n184|// facility, so Discover cannot probe or execute a candidate. The import\n185|// list is derived from package source.\n186|func TestDiscoveryReachesNoProcess(t *testing.T) {\n187|\tfileset := token.NewFileSet()\n188|\tdirectory, err := os.Getwd()\n189|\tif err != nil {\n190|\t\tt.Fatalf(\"Getwd: %v\", err)\n191|\t}\n192|\tentries, err := os.ReadDir(directory)\n193|\tif err != nil {\n194|\t\tt.Fatalf(\"ReadDir: %v\", err)\n195|\t}\n196|\tfound := false\n197|\tfor _, entry := range entries {\n198|\t\tname := entry.Name()\n199|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n200|\t\t\tcontinue\n201|\t\t}\n202|\t\tfound = true\n203|\t\tsource, err := os.ReadFile(filepath.Join(directory, name))\n204|\t\tif err != nil {\n205|\t\t\tt.Fatalf(\"ReadFile(%s): %v\", name, err)\n206|\t\t}\n207|\t\tsyntax, err := parser.ParseFile(fileset, name, source, parser.ImportsOnly)\n208|\t\tif err != nil {\n209|\t\t\tt.Fatalf(\"ParseFile(%s): %v\", name, err)\n210|\t\t}\n211|\t\tfor _, clause := range syntax.Imports {\n212|\t\t\tpath := strings.Trim(clause.Path.Value, `\"`)\n213|\t\t\tif path == \"os/exec\" || strings.HasPrefix(path, \"os/exec/\") {\n214|\t\t\t\tt.Fatalf(\"%s imports process execution (%s)\", name, path)\n215|\t\t\t}\n216|\t\t}\n217|\t}\n218|\tif !found {\n219|\t\tt.Fatal(\"scanned no production sources; the check is blind\")\n220|\t}\n221|}\n222|\n223|// TestStableCodesAreRegistered pins every refusal code this package emits\n224|// against the pinned error registry and the exact exit status the host\n225|// surfaces: invalid_config and local_precondition_failed exit 3,\n226|// integrity_failure exits 9.\n227|func TestStableCodesAreRegistered(t *testing.T) {\n228|\tregistered := map[string]int{}\n229|\tfor _, row := range catalog.Current().Errors {\n230|\t\tregistered[string(row.Code)] = row.ExitCode\n231|\t}\n232|\tfor code, wantExit := range map[string]int{\n233|\t\tcodeInvalidConfig:     3,\n234|\t\tcodeLocalPrecondition: 3,\n235|\t\tcodeIntegrityFailure:  9,\n236|\t} {\n237|\t\tgotExit, ok := registered[code]\n238|\t\tif !ok {\n239|\t\t\tt.Fatalf(\"code %q is not in the pinned error registry\", code)\n240|\t\t}\n241|\t\tif gotExit != wantExit {\n242|\t\t\tt.Fatalf(\"code %q exit = %d, want %d\", code, gotExit, wantExit)\n243|\t\t}\n244|\t\tgotWire, err := axerror.ExitCodeFor(axerror.Version100, axerror.Code(code))\n245|\t\tif err != nil {\n246|\t\t\tt.Fatalf(\"ExitCodeFor(1.0.0, %q): %v\", code, err)\n247|\t\t}\n248|\t\tif gotWire != wantExit {\n249|\t\t\tt.Fatalf(\"wire exit for %q = %d, want %d\", code, gotWire, wantExit)\n250|\t\t}\n251|\t}\n252|\tt.Logf(\"refusal code coverage: 3/3 package codes registered with pinned exits\")\n253|}\n254|\n255|// exportedSymbols derives every exported top-level symbol name from\n256|// package source.\n257|func exportedSymbols(t *testing.T) []string {\n258|\tt.Helper()\n259|\tvar out []string\n260|\tfor _, syntax := range parseProductionSources(t) {\n261|\t\tfor _, decl := range syntax.Decls {\n262|\t\t\tgeneral, ok := decl.(*ast.GenDecl)\n263|\t\t\tif !ok {\n264|\t\t\t\tcontinue\n265|\t\t\t}\n266|\t\t\tfor _, spec := range general.Specs {\n267|\t\t\t\tswitch concrete := spec.(type) {\n268|\t\t\t\tcase *ast.TypeSpec:\n269|\t\t\t\t\tif ast.IsExported(concrete.Name.Name) {\n270|\t\t\t\t\t\tout = append(out, concrete.Name.Name)\n271|\t\t\t\t\t}\n272|\t\t\t\tcase *ast.ValueSpec:\n273|\t\t\t\t\tfor _, ident := range concrete.Names {\n274|\t\t\t\t\t\tif ast.IsExported(ident.Name) {\n275|\t\t\t\t\t\t\tout = append(out, ident.Name)\n276|\t\t\t\t\t\t}\n277|\t\t\t\t\t}\n278|\t\t\t\t}\n279|\t\t\t}\n280|\t\t}\n281|\t\tfor _, decl := range syntax.Decls {\n282|\t\t\tfunction, ok := decl.(*ast.FuncDecl)\n283|\t\t\tif !ok || function.Name == nil || !ast.IsExported(function.Name.Name) {\n284|\t\t\t\tcontinue\n285|\t\t\t}\n286|\t\t\tif function.Recv == nil {\n287|\t\t\t\tout = append(out, function.Name.Name)\n288|\t\t\t} else {\n289|\t\t\t\tout = append(out, function.Name.Name+\" (method)\")\n290|\t\t\t}\n291|\t\t}\n292|\t}\n293|\treturn out\n294|}\n295|\n296|// structMembers derives field names and types for the named structs from\n297|// package source.\n298|func structMembers(t *testing.T, wanted ...string) map[string]string {\n299|\tt.Helper()\n300|\twant := map[string]bool{}\n301|\tfor _, name := range wanted {\n302|\t\twant[name] = true\n303|\t}\n304|\tmembers := map[string]string{}\n305|\tfor _, syntax := range parseProductionSources(t) {\n306|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n307|\t\t\tspec, ok := node.(*ast.TypeSpec)\n308|\t\t\tif !ok || !want[spec.Name.Name] {\n309|\t\t\t\treturn true\n310|\t\t\t}\n311|\t\t\tstructure, ok := spec.Type.(*ast.StructType)\n312|\t\t\tif !ok {\n313|\t\t\t\treturn false\n314|\t\t\t}\n315|\t\t\tfor _, field := range structure.Fields.List {\n316|\t\t\t\tfor _, ident := range field.Names {\n317|\t\t\t\t\tmembers[ident.Name] = spec.Name.Name\n318|\t\t\t\t}\n319|\t\t\t}\n320|\t\t\treturn false\n321|\t\t})\n322|\t}\n323|\treturn members\n324|}\n325|\n326|// parseProductionSources parses every non-test Go source in the package\n327|// directory.\n328|func parseProductionSources(t *testing.T) map[string]*ast.File {\n329|\tt.Helper()\n330|\tdirectory, err := os.Getwd()\n331|\tif err != nil {\n332|\t\tt.Fatalf(\"Getwd: %v\", err)\n333|\t}\n334|\tentries, err := os.ReadDir(directory)\n335|\tif err != nil {\n336|\t\tt.Fatalf(\"ReadDir: %v\", err)\n337|\t}\n338|\tfileset := token.NewFileSet()\n339|\tout := map[string]*ast.File{}\n340|\tfor _, entry := range entries {\n341|\t\tname := entry.Name()\n342|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n343|\t\t\tcontinue\n344|\t\t}\n345|\t\tsource, err := os.ReadFile(filepath.Join(directory, name))\n346|\t\tif err != nil {\n347|\t\t\tt.Fatalf(\"ReadFile(%s): %v\", name, err)\n348|\t\t}\n349|\t\tsyntax, err := parser.ParseFile(fileset, name, source, parser.ParseComments)\n350|\t\tif err != nil {\n351|\t\t\tt.Fatalf(\"ParseFile(%s): %v\", name, err)\n352|\t\t}\n353|\t\tout[name] = syntax\n354|\t}\n355|\treturn out\n356|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5cb","stream":{"kind":"session","id":"01a06e76-bae7-71e0-a570-bb4cc0067a43"},"sequence":320,"recorded_at":1780531400000635,"record_type":"event","durability":"durable","causation_id":"45fd7c01-9695-4667-a2dd-8bdcc25383b6","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"45fd7c01-9695-4667-a2dd-8bdcc25383b6","run_stream":{"kind":"run","id":"45fd7c01-9695-4667-a2dd-8bdcc25383b6"},"call_id":"call_01a06e7745a4795099eaf5dce4715b47","text":"Read text file `internal/provider/os_unix.go`.\n1|//go:build !windows\n2|\n3|package provider\n4|\n5|import (\n6|\t\"fmt\"\n7|\t\"os\"\n8|\t\"syscall\"\n9|)\n10|\n11|// fileOwnerUID attests the owning UID of a stat result. The host refuses\n12|// trust when attestation is unavailable rather than treating an unknown\n13|// owner as approved.\n14|func fileOwnerUID(info os.FileInfo) (uint32, error) {\n15|\tstat, ok := info.Sys().(*syscall.Stat_t)\n16|\tif !ok {\n17|\t\treturn 0, fmt.Errorf(\"provider owner attestation: ownership metadata unavailable\")\n18|\t}\n19|\treturn stat.Uid, nil\n20|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
