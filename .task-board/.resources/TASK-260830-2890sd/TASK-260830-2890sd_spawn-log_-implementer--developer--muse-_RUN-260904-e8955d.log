{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5c1","stream":{"kind":"session","id":"01a06e76-bae7-71e0-a570-bb4cc0067a43"},"sequence":315,"recorded_at":1780531400000625,"record_type":"event","durability":"durable","causation_id":"45fd7c01-9695-4667-a2dd-8bdcc25383b6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"45fd7c01-9695-4667-a2dd-8bdcc25383b6","run_stream":{"kind":"run","id":"45fd7c01-9695-4667-a2dd-8bdcc25383b6"},"task_stream":{"kind":"task","id":"87142e02-c02a-4f7f-8205-d3854d5742ca"},"task_id":"87142e02-c02a-4f7f-8205-d3854d5742ca","event":{"kind":"output","task_id":"87142e02-c02a-4f7f-8205-d3854d5742ca","chunk":"Read text file `internal/provider/os_unix.go`.\n1|//go:build !windows\n2|\n3|package provider\n4|\n5|import (\n6|\t\"fmt\"\n7|\t\"os\"\n8|\t\"syscall\"\n9|)\n10|\n11|// fileOwnerUID attests the owning UID of a stat result. The host refuses\n12|// trust when attestation is unavailable rather than treating an unknown\n13|// owner as approved.\n14|func fileOwnerUID(info os.FileInfo) (uint32, error) {\n15|\tstat, ok := info.Sys().(*syscall.Stat_t)\n16|\tif !ok {\n17|\t\treturn 0, fmt.Errorf(\"provider owner attestation: ownership metadata unavailable\")\n18|\t}\n19|\treturn stat.Uid, nil\n20|}"}}}
