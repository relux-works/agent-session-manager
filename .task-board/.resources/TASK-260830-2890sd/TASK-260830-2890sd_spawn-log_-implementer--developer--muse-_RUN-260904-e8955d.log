{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c505","stream":{"kind":"session","id":"01a06e76-bae7-71e0-a570-bb4cc0067a43"},"sequence":221,"recorded_at":1780531400000437,"record_type":"event","durability":"durable","causation_id":"45fd7c01-9695-4667-a2dd-8bdcc25383b6","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"45fd7c01-9695-4667-a2dd-8bdcc25383b6","run_stream":{"kind":"run","id":"45fd7c01-9695-4667-a2dd-8bdcc25383b6"},"call_id":"call_01a06e7724e477a194931c84c8926813","text":"Read text file `internal/provider/discovery_test.go`.\n1|package provider\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"reflect\"\n6|\t\"testing\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|// TestDiscoverEnumeratesSourcesInSectionOrder proves the Section 7.1\n12|// candidate order: configured plugin directories in listed order, then\n13|// built-in adapters, then PATH when allowed. The production entry point is\n14|// Discover.\n15|func TestDiscoverEnumeratesSourcesInSectionOrder(t *testing.T) {\n16|\tfake := newFakeSystem()\n17|\tfake.addFile(\"/plugins/a\", \"ax-provider-zzz\", []byte(\"zzz\"), fakeUID)\n18|\tfake.addFile(\"/plugins/b\", \"ax-provider-aaa\", []byte(\"aaa\"), fakeUID)\n19|\tfake.pathDirs = []string{\"/pathbin\"}\n20|\tfake.addFile(\"/pathbin\", \"ax-provider-pathone\", []byte(\"p\"), fakeUID)\n21|\n22|\tcfg := fakeConfig(\"/plugins/a\", \"/plugins/b\")\n23|\tcfg.AllowPathPlugins = true\n24|\tgot, err := Discover(cfg, fakeOwner(), fake)\n25|\tif err != nil {\n26|\t\tt.Fatalf(\"Discover: %v\", err)\n27|\t}\n28|\tvar order []string\n29|\tfor _, candidate := range got {\n30|\t\torder = append(order, string(candidate.Kind())+\"/\"+candidate.ID())\n31|\t}\n32|\twant := []string{\n33|\t\t\"external/zzz\",\n34|\t\t\"external/aaa\",\n35|\t\t\"builtin/codex\",\n36|\t\t\"builtin/claude\",\n37|\t\t\"builtin/gemini\",\n38|\t\t\"builtin/muse\",\n39|\t\t\"builtin/antigravity\",\n40|\t\t\"builtin/pi\",\n41|\t\t\"external/pathone\",\n42|\t}\n43|\tif !reflect.DeepEqual(order, want) {\n44|\t\tt.Fatalf(\"discovery order = %v, want %v\", order, want)\n45|\t}\n46|\tsources := map[string]string{}\n47|\tfor _, candidate := range got {\n48|\t\tsources[candidate.ID()] = candidate.Source()\n49|\t}\n50|\tif sources[\"zzz\"] != \"plugin_dirs[0]\" || sources[\"aaa\"] != \"plugin_dirs[1]\" {\n51|\t\tt.Fatalf(\"plugin sources = %v, want plugin_dirs[0]/plugin_dirs[1]\", sources)\n52|\t}\n53|\tif sources[\"codex\"] != \"builtin\" {\n54|\t\tt.Fatalf(\"builtin source = %q, want builtin\", sources[\"codex\"])\n55|\t}\n56|\tif sources[\"pathone\"] != \"path\" {\n57|\t\tt.Fatalf(\"path source = %q, want path\", sources[\"pathone\"])\n58|\t}\n59|}\n60|\n61|// TestDiscoverSortsEntriesWithinADirectory narrows the determinism claim:\n62|// the fake returns entries in reverse insertion order, so bytewise output\n63|// proves Discover sorts instead of inheriting filesystem order.\n64|func TestDiscoverSortsEntriesWithinADirectory(t *testing.T) {\n65|\tfake := newFakeSystem()\n66|\tfake.addFile(\"/plugins\", \"ax-provider-mango\", []byte(\"m\"), fakeUID)\n67|\tfake.addFile(\"/plugins\", \"ax-provider-apple\", []byte(\"a\"), fakeUID)\n68|\tfake.addFile(\"/plugins\", \"ax-provider-cherry\", []byte(\"c\"), fakeUID)\n69|\n70|\tgot, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), fake)\n71|\tif err != nil {\n72|\t\tt.Fatalf(\"Discover: %v\", err)\n73|\t}\n74|\tif got[0].ID() != \"apple\" || got[1].ID() != \"cherry\" || got[2].ID() != \"mango\" {\n75|\t\tt.Fatalf(\"directory order = [%s %s %s], want [apple cherry mango]\", got[0].ID(), got[1].ID(), got[2].ID())\n76|\t}\n77|}\n78|\n79|// TestDiscoverSkipsPATHWhenDisallowed proves the Section 7.1 PATH gate:\n80|// PATH is consulted only when allow_path_plugins is true.\n81|func TestDiscoverSkipsPATHWhenDisallowed(t *testing.T) {\n82|\tfake := newFakeSystem()\n83|\tfake.pathDirs = []string{\"/pathbin\"}\n84|\tfake.addFile(\"/pathbin\", \"ax-provider-pathtool\", []byte(\"p\"), fakeUID)\n85|\n86|\tgot, err := Discover(fakeConfig(), fakeOwner(), fake)\n87|\tif err != nil {\n88|\t\tt.Fatalf(\"Discover: %v\", err)\n89|\t}\n90|\tfor _, candidate := range got {\n91|\t\tif candidate.Kind() == KindExternal {\n92|\t\t\tt.Fatalf(\"PATH candidate %q admitted while allow_path_plugins is false\", candidate.ID())\n93|\t\t}\n94|\t}\n95|\tif len(got) != len(builtinOrder) {\n96|\t\tt.Fatalf(\"candidate count = %d, want %d builtins only\", len(got), len(builtinOrder))\n97|\t}\n98|\n99|\tcfg := fakeConfig()\n100|\tcfg.AllowPathPlugins = true\n101|\tgot, err = Discover(cfg, fakeOwner(), fake)\n102|\tif err != nil {\n103|\t\tt.Fatalf(\"Discover with PATH allowed: %v\", err)\n104|\t}\n105|\tfound := false\n106|\tfor _, candidate := range got {\n107|\t\tif candidate.ID() == \"pathtool\" && candidate.Source() == \"path\" {\n108|\t\t\tfound = true\n109|\t\t}\n110|\t}\n111|\tif !found {\n112|\t\tt.Fatalf(\"PATH candidate missing when allow_path_plugins is true: %v\", got)\n113|\t}\n114|}\n115|\n116|// TestDiscoverRecordsTrustFacts proves every accepted external candidate\n117|// carries the Section 7.1 trust-time facts: canonical path, digest, and\n118|// approving owner.\n119|func TestDiscoverRecordsTrustFacts(t *testing.T) {\n120|\tfake := newFakeSystem()\n121|\tfake.addLinkedFile(\"/plugins\", \"ax-provider-foo\", \"/opt/real/foo\", []byte(\"bytes\"), fakeUID, true)\n122|\n123|\tgot, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), fake)\n124|\tif err != nil {\n125|\t\tt.Fatalf(\"Discover: %v\", err)\n126|\t}\n127|\tvar foo *Candidate\n128|\tfor i, candidate := range got {\n129|\t\tif candidate.ID() == \"foo\" {\n130|\t\t\tfoo = &got[i]\n131|\t\t}\n132|\t}\n133|\tif foo == nil {\n134|\t\tt.Fatalf(\"external candidate foo missing: %v\", got)\n135|\t}\n136|\tsource, ok := foo.SourcePath()\n137|\tif !ok || source != \"/plugins/ax-provider-foo\" {\n138|\t\tt.Fatalf(\"SourcePath = %q, %v; want /plugins/ax-provider-foo, true\", source, ok)\n139|\t}\n140|\tcanon, ok := foo.CanonicalPath()\n141|\tif !ok || canon != \"/opt/real/foo\" {\n142|\t\tt.Fatalf(\"CanonicalPath = %q, %v; want /opt/real/foo, true\", canon, ok)\n143|\t}\n144|\tdigest, ok := foo.Digest()\n145|\tif !ok {\n146|\t\tt.Fatal(\"Digest reports absence for an external candidate\")\n147|\t}\n148|\twant := scalar.SHA256Digest([]byte(\"bytes\"))\n149|\tif digest != want {\n150|\t\tt.Fatalf(\"Digest = %v, want %v\", digest, want)\n151|\t}\n152|\towner, ok := foo.Owner()\n153|\tif !ok || owner != \"uid:1000\" {\n154|\t\tt.Fatalf(\"Owner = %q, %v; want uid:1000, true\", owner, ok)\n155|\t}\n156|}\n157|\n158|// TestDiscoverIgnoresNonCandidateEntries proves the prefix boundary: names\n159|// without the ax-provider- prefix are skipped, including the bare prefix\n160|// stem itself.\n161|func TestDiscoverIgnoresNonCandidateEntries(t *testing.T) {\n162|\tfake := newFakeSystem()\n163|\tfake.entries[\"/plugins\"] = []string{\"README.md\", \"ax-provider\", \"other-tool\"}\n164|\tfake.canon[\"/plugins/other-tool\"] = \"/plugins/other-tool\"\n165|\tfake.canon[\"/plugins/README.md\"] = \"/plugins/README.md\"\n166|\tfake.canon[\"/plugins/ax-provider\"] = \"/plugins/ax-provider\"\n167|\tfake.canon[\"/plugins/ax-provider-foo.bak\"] = \"/plugins/ax-provider-foo.bak\"\n168|\n169|\tgot, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), fake)\n170|\tif err != nil {\n171|\t\tt.Fatalf(\"Discover: %v\", err)\n172|\t}\n173|\tfor _, candidate := range got {\n174|\t\tif candidate.Kind() == KindExternal {\n175|\t\t\tt.Fatalf(\"non-candidate entry admitted as %q\", candidate.ID())\n176|\t\t}\n177|\t}\n178|}\n179|\n180|// TestDiscoverRefusesMalformedNames narrows the grammar gate across the\n181|// provider-id boundary: uppercase, leading dash, empty, and overlong\n182|// suffixes fail, each with invalid_config.\n183|func TestDiscoverRefusesMalformedNames(t *testing.T) {\n184|\tfor _, name := range []string{\n185|\t\t\"ax-provider-ABC\",\n186|\t\t\"ax-provider--lead\",\n187|\t\t\"ax-provider-\",\n188|\t\t\"ax-provider-foo.bak\",\n189|\t\t\"ax-provider-has space\",\n190|\t\t\"ax-provider-012345678901234567890123456789012\",\n191|\t} {\n192|\t\tfake := newFakeSystem()\n193|\t\tfake.entries[\"/plugins\"] = []string{name}\n194|\t\tfake.canon[\"/plugins/\"+name] = \"/plugins/\" + name\n195|\t\t_, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), fake)\n196|\t\tif err == nil {\n197|\t\t\tt.Fatalf(\"Discover(%q) succeeded, want invalid_config\", name)\n198|\t\t}\n199|\t\tif code := errorCode(t, err); code != codeInvalidConfig {\n200|\t\t\tt.Fatalf(\"Discover(%q) code = %q, want invalid_config\", name, code)\n201|\t\t}\n202|\t}\n203|}\n204|\n205|// TestDiscoverRefusesNonRegularTargets proves the Section 7.1 regular-file\n206|// rule in both direct and symlinked form.\n207|func TestDiscoverRefusesNonRegularTargets(t *testing.T) {\n208|\tt.Run(\"directory entry\", func(t *testing.T) {\n209|\t\tfake := newFakeSystem()\n210|\t\tfake.addLinkedFile(\"/plugins\", \"ax-provider-odd\", \"/opt/real/odd\", []byte(\"x\"), fakeUID, false)\n211|\t\t_, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), fake)\n212|\t\tif err == nil {\n213|\t\t\tt.Fatal(\"Discover admitted a directory target, want invalid_config\")\n214|\t\t}\n215|\t\tif code := errorCode(t, err); code != codeInvalidConfig {\n216|\t\t\tt.Fatalf(\"code = %q, want invalid_config\", code)\n217|\t\t}\n218|\t})\n219|\tt.Run(\"symlink to directory\", func(t *testing.T) {\n220|\t\tfake := newFakeSystem()\n221|\t\tfake.entries[\"/plugins\"] = []string{\"ax-provider-linkdir\"}\n222|\t\tfake.canon[\"/plugins/ax-provider-linkdir\"] = \"/opt/dirs/linkdir\"\n223|\t\tfake.files[\"/opt/dirs/linkdir\"] = fakeFile{content: nil, uid: fakeUID, regular: false}\n224|\t\t_, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), fake)\n225|\t\tif err == nil {\n226|\t\t\tt.Fatal(\"Discover admitted a symlink-to-directory, want invalid_config\")\n227|\t\t}\n228|\t})\n229|}\n230|\n231|// TestDiscoverRefusesUnapprovedOwners narrows the ownership gate: the same\n232|// bytes are refused under a foreign UID, admitted under the operator UID,\n233|// and admitted under an administrator-approved UID.\n234|func TestDiscoverRefusesUnapprovedOwners(t *testing.T) {\n235|\tsetup := func() *fakeSystem {\n236|\t\tfake := newFakeSystem()\n237|\t\tfake.addFile(\"/plugins\", \"ax-provider-foo\", []byte(\"x\"), foreignUID)\n238|\t\treturn fake\n239|\t}\n240|\tif _, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), setup()); err == nil {\n241|\t\tt.Fatal(\"Discover admitted a foreign-owned executable, want invalid_config\")\n242|\t} else if code := errorCode(t, err); code != codeInvalidConfig {\n243|\t\tt.Fatalf(\"code = %q, want invalid_config\", code)\n244|\t}\n245|\tif _, err := Discover(fakeConfig(\"/plugins\"), OwnerPolicy{OperatorUID: foreignUID}, setup()); err != nil {\n246|\t\tt.Fatalf(\"Discover refused the operator-owned executable: %v\", err)\n247|\t}\n248|\tadmin := OwnerPolicy{OperatorUID: fakeUID, AdministratorUIDs: []uint32{foreignUID}}\n249|\tif _, err := Discover(fakeConfig(\"/plugins\"), admin, setup()); err != nil {\n250|\t\tt.Fatalf(\"Discover refused the administrator-approved executable: %v\", err)\n251|\t}\n252|\tnoRootException := OwnerPolicy{OperatorUID: fakeUID}\n253|\tif _, err := Discover(fakeConfig(\"/plugins\"), noRootException, setup()); err == nil {\n254|\t\tt.Fatal(\"Discover admitted foreign UID without an explicit approval, want refusal\")\n255|\t}\n256|}\n257|\n258|// TestDiscoverRefusesRelativePluginDir proves relative configured\n259|// directories fail closed instead of resolving against an ambient working\n260|// directory.\n261|func TestDiscoverRefusesRelativePluginDir(t *testing.T) {\n262|\tfake := newFakeSystem()\n263|\t_, err := Discover(fakeConfig(\"relative/plugins\"), fakeOwner(), fake)\n264|\tif err == nil {\n265|\t\tt.Fatal(\"Discover accepted a relative plugin dir, want invalid_config\")\n266|\t}\n267|\tif code := errorCode(t, err); code != codeInvalidConfig {\n268|\t\tt.Fatalf(\"code = %q, want invalid_config\", code)\n269|\t}\n270|}\n271|\n272|// TestDiscoverRefusesPartialReads proves a failed or partial read is never\n273|// a legitimate absence: each seam failure aborts discovery with\n274|// local_precondition_failed rather than a narrowed candidate set.\n275|func TestDiscoverRefusesPartialReads(t *testing.T) {\n276|\tt.Run(\"unreadable directory\", func(t *testing.T) {\n277|\t\tfake := newFakeSystem()\n278|\t\tfake.readDirErr[\"/plugins\"] = errors.New(\"permission denied\")\n279|\t\t_, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), fake)\n280|\t\tif code := errorCode(t, err); code != codeLocalPrecondition {\n281|\t\t\tt.Fatalf(\"code = %q, want local_precondition_failed\", code)\n282|\t\t}\n283|\t})\n284|\tt.Run(\"unresolvable symlink\", func(t *testing.T) {\n285|\t\tfake := newFakeSystem()\n286|\t\tfake.entries[\"/plugins\"] = []string{\"ax-provider-dangling\"}\n287|\t\tfake.canonErr[\"/plugins/ax-provider-dangling\"] = errors.New(\"no such file\")\n288|\t\t_, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), fake)\n289|\t\tif code := errorCode(t, err); code != codeLocalPrecondition {\n290|\t\t\tt.Fatalf(\"code = %q, want local_precondition_failed\", code)\n291|\t\t}\n292|\t})\n293|\tt.Run(\"uninspectable target\", func(t *testing.T) {\n294|\t\tfake := newFakeSystem()\n295|\t\tfake.entries[\"/plugins\"] = []string{\"ax-provider-foo\"}\n296|\t\tfake.canon[\"/plugins/ax-provider-foo\"] = \"/opt/real/foo\"\n297|\t\tfake.inspectErr[\"/opt/real/foo\"] = errors.New(\"stale handle\")\n298|\t\t_, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), fake)\n299|\t\tif code := errorCode(t, err); code != codeLocalPrecondition {\n300|\t\t\tt.Fatalf(\"code = %q, want local_precondition_failed\", code)\n301|\t\t}\n302|\t})\n303|\tt.Run(\"undigestible target\", func(t *testing.T) {\n304|\t\tfake := newFakeSystem()\n305|\t\tfake.entries[\"/plugins\"] = []string{\"ax-provider-foo\"}\n306|\t\tfake.canon[\"/plugins/ax-provider-foo\"] = \"/opt/real/foo\"\n307|\t\tfake.files[\"/opt/real/foo\"] = fakeFile{content: []byte(\"x\"), uid: fakeUID, regular: true}\n308|\t\tfake.contentErr[\"/opt/real/foo\"] = errors.New(\"input/output error\")\n309|\t\t_, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), fake)\n310|\t\tif code := errorCode(t, err); code != codeLocalPrecondition {\n311|\t\t\tt.Fatalf(\"code = %q, want local_precondition_failed\", code)\n312|\t\t}\n313|\t})\n314|\tt.Run(\"cause is preserved\", func(t *testing.T) {\n315|\t\tfake := newFakeSystem()\n316|\t\tcause := errors.New(\"disk gone\")\n317|\t\tfake.readDirErr[\"/plugins\"] = cause\n318|\t\t_, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), fake)\n319|\t\tif !errors.Is(err, cause) {\n320|\t\t\tt.Fatalf(\"precondition error does not wrap its cause: %v\", err)\n321|\t\t}\n322|\t})\n323|}\n324|\n325|// TestBuiltinCandidatesCarryNoTrustFacts proves builtins are adapters, not\n326|// executables: every trust accessor reports absence.\n327|func TestBuiltinCandidatesCarryNoTrustFacts(t *testing.T) {\n328|\tgot, err := Discover(fakeConfig(), fakeOwner(), newFakeSystem())\n329|\tif err != nil {\n330|\t\tt.Fatalf(\"Discover: %v\", err)\n331|\t}\n332|\tif len(got) != len(builtinOrder) {\n333|\t\tt.Fatalf(\"builtin count = %d, want %d\", len(got), len(builtinOrder))\n334|\t}\n335|\tfor _, candidate := range got {\n336|\t\tif candidate.Kind() != KindBuiltin {\n337|\t\t\tt.Fatalf(\"candidate %q kind = %q, want builtin\", candidate.ID(), candidate.Kind())\n338|\t\t}\n339|\t\tif _, ok := candidate.SourcePath(); ok {\n340|\t\t\tt.Fatalf(\"builtin %q reports a source path\", candidate.ID())\n341|\t\t}\n342|\t\tif _, ok := candidate.CanonicalPath(); ok {\n343|\t\t\tt.Fatalf(\"builtin %q reports a canonical path\", candidate.ID())\n344|\t\t}\n345|\t\tif _, ok := candidate.Digest(); ok {\n346|\t\t\tt.Fatalf(\"builtin %q reports a digest\", candidate.ID())\n347|\t\t}\n348|\t\tif _, ok := candidate.Owner(); ok {\n349|\t\t\tt.Fatalf(\"builtin %q reports an owner\", candidate.ID())\n350|\t\t}\n351|\t}\n352|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c507","stream":{"kind":"session","id":"01a06e76-bae7-71e0-a570-bb4cc0067a43"},"sequence":222,"recorded_at":1780531400000439,"record_type":"event","durability":"durable","causation_id":"45fd7c01-9695-4667-a2dd-8bdcc25383b6","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"45fd7c01-9695-4667-a2dd-8bdcc25383b6","run_stream":{"kind":"run","id":"45fd7c01-9695-4667-a2dd-8bdcc25383b6"},"call_id":"call_01a06e7725c373e3b752210e84190bc4","text":"Read text file `internal/provider/trust_test.go`.\n1|package provider\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|)\n9|\n10|// errDiskGone scripts a target that exists for stat but fails on read.\n11|var errDiskGone = errors.New(\"fake: input/output error\")\n12|\n13|const trustInstant = \"2026-08-19T04:03:00.000Z\"\n14|\n15|// discoverOneFoo is the shared trust fixture: one external candidate foo.\n16|func discoverOneFoo(t *testing.T, fake *fakeSystem) Candidate {\n17|\tt.Helper()\n18|\tgot, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), fake)\n19|\tif err != nil {\n20|\t\tt.Fatalf(\"Discover: %v\", err)\n21|\t}\n22|\tfor _, candidate := range got {\n23|\t\tif candidate.ID() == \"foo\" {\n24|\t\t\treturn candidate\n25|\t\t}\n26|\t}\n27|\tt.Fatal(\"candidate foo missing\")\n28|\treturn Candidate{}\n29|}\n30|\n31|func trustOneFoo(t *testing.T, candidate Candidate) TrustRecord {\n32|\tt.Helper()\n33|\trecord, err := Trust(candidate, mustTimestamp(t, trustInstant))\n34|\tif err != nil {\n35|\t\tt.Fatalf(\"Trust: %v\", err)\n36|\t}\n37|\treturn record\n38|}\n39|\n40|// TestTrustRecordsCandidateFacts proves Trust copies every Section 7.1\n41|// trust-time fact from the accepted candidate, and that Trust is pure:\n42|// identical inputs return identical receipts.\n43|func TestTrustRecordsCandidateFacts(t *testing.T) {\n44|\tfake := newFakeSystem()\n45|\tfake.addLinkedFile(\"/plugins\", \"ax-provider-foo\", \"/opt/real/foo\", []byte(\"bytes\"), fakeUID, true)\n46|\tfirst := trustOneFoo(t, discoverOneFoo(t, fake))\n47|\tsecond := trustOneFoo(t, discoverOneFoo(t, fake))\n48|\n49|\tif first.ProviderID() != \"foo\" {\n50|\t\tt.Fatalf(\"ProviderID = %q, want foo\", first.ProviderID())\n51|\t}\n52|\tif first.SourcePath() != \"/plugins/ax-provider-foo\" {\n53|\t\tt.Fatalf(\"SourcePath = %q, want undisguised discovery path\", first.SourcePath())\n54|\t}\n55|\tif first.CanonicalPath() != \"/opt/real/foo\" {\n56|\t\tt.Fatalf(\"CanonicalPath = %q, want /opt/real/foo\", first.CanonicalPath())\n57|\t}\n58|\tif want := scalar.SHA256Digest([]byte(\"bytes\")); first.Digest() != want {\n59|\t\tt.Fatalf(\"Digest = %v, want %v\", first.Digest(), want)\n60|\t}\n61|\tif first.Owner() != \"uid:1000\" {\n62|\t\tt.Fatalf(\"Owner = %q, want uid:1000\", first.Owner())\n63|\t}\n64|\tif first.TrustedAt().String() != trustInstant {\n65|\t\tt.Fatalf(\"TrustedAt = %q, want %q\", first.TrustedAt(), trustInstant)\n66|\t}\n67|\tif first != second {\n68|\t\tt.Fatalf(\"Trust is not pure: %+v != %+v\", first, second)\n69|\t}\n70|}\n71|\n72|// TestTrustRefusesBuiltins proves a builtin adapter cannot be trusted: it\n73|// has no executable bytes to record.\n74|func TestTrustRefusesBuiltins(t *testing.T) {\n75|\tgot, err := Discover(fakeConfig(), fakeOwner(), newFakeSystem())\n76|\tif err != nil {\n77|\t\tt.Fatalf(\"Discover: %v\", err)\n78|\t}\n79|\tif _, err := Trust(got[0], mustTimestamp(t, trustInstant)); err == nil {\n80|\t\tt.Fatalf(\"Trust accepted builtin %q, want refusal\", got[0].ID())\n81|\t} else if code := errorCode(t, err); code != codeInvalidConfig {\n82|\t\tt.Fatalf(\"code = %q, want invalid_config\", code)\n83|\t}\n84|}\n85|\n86|// TestVerifyAcceptsUnchangedTree proves Verify succeeds when freshly read\n87|// facts equal the receipt.\n88|func TestVerifyAcceptsUnchangedTree(t *testing.T) {\n89|\tfake := newFakeSystem()\n90|\tfake.addLinkedFile(\"/plugins\", \"ax-provider-foo\", \"/opt/real/foo\", []byte(\"bytes\"), fakeUID, true)\n91|\trecord := trustOneFoo(t, discoverOneFoo(t, fake))\n92|\tif err := Verify(record, fakeOwner(), fake); err != nil {\n93|\t\tt.Fatalf(\"Verify of an unchanged tree: %v\", err)\n94|\t}\n95|}\n96|\n97|// TestVerifyDetectsSubstitution narrows the Section 7.1 substitution rule\n98|// one dimension at a time: each changed trust fact independently fails\n99|// with integrity_failure while every other fact stays equal.\n100|func TestVerifyDetectsSubstitution(t *testing.T) {\n101|\tsetup := func() (*fakeSystem, TrustRecord) {\n102|\t\tfake := newFakeSystem()\n103|\t\tfake.addLinkedFile(\"/plugins\", \"ax-provider-foo\", \"/opt/real/foo\", []byte(\"bytes\"), fakeUID, true)\n104|\t\treturn fake, trustOneFoo(t, discoverOneFoo(t, fake))\n105|\t}\n106|\tt.Run(\"retargeted symlink\", func(t *testing.T) {\n107|\t\tfake, record := setup()\n108|\t\tfake.canon[\"/plugins/ax-provider-foo\"] = \"/opt/real/evil\"\n109|\t\tfake.files[\"/opt/real/evil\"] = fakeFile{content: []byte(\"bytes\"), uid: fakeUID, regular: true}\n110|\t\tif err := Verify(record, fakeOwner(), fake); err == nil {\n111|\t\t\tt.Fatal(\"Verify accepted a retargeted symlink, want integrity_failure\")\n112|\t\t} else if code := errorCode(t, err); code != codeIntegrityFailure {\n113|\t\t\tt.Fatalf(\"code = %q, want integrity_failure\", code)\n114|\t\t}\n115|\t})\n116|\tt.Run(\"changed bytes\", func(t *testing.T) {\n117|\t\tfake, record := setup()\n118|\t\tfake.files[\"/opt/real/foo\"] = fakeFile{content: []byte(\"patched\"), uid: fakeUID, regular: true}\n119|\t\tif err := Verify(record, fakeOwner(), fake); err == nil {\n120|\t\t\tt.Fatal(\"Verify accepted changed bytes, want integrity_failure\")\n121|\t\t} else if code := errorCode(t, err); code != codeIntegrityFailure {\n122|\t\t\tt.Fatalf(\"code = %q, want integrity_failure\", code)\n123|\t\t}\n124|\t})\n125|\tt.Run(\"changed owner\", func(t *testing.T) {\n126|\t\tfake, record := setup()\n127|\t\tfake.files[\"/opt/real/foo\"] = fakeFile{content: []byte(\"bytes\"), uid: foreignUID, regular: true}\n128|\t\tif err := Verify(record, fakeOwner(), fake); err == nil {\n129|\t\t\tt.Fatal(\"Verify accepted a changed owner, want integrity_failure\")\n130|\t\t} else if code := errorCode(t, err); code != codeIntegrityFailure {\n131|\t\t\tt.Fatalf(\"code = %q, want integrity_failure\", code)\n132|\t\t}\n133|\t})\n134|\tt.Run(\"replaced with directory\", func(t *testing.T) {\n135|\t\tfake, record := setup()\n136|\t\tfake.files[\"/opt/real/foo\"] = fakeFile{content: nil, uid: fakeUID, regular: false}\n137|\t\tif err := Verify(record, fakeOwner(), fake); err == nil {\n138|\t\t\tt.Fatal(\"Verify accepted a non-regular replacement, want integrity_failure\")\n139|\t\t} else if code := errorCode(t, err); code != codeIntegrityFailure {\n140|\t\t\tt.Fatalf(\"code = %q, want integrity_failure\", code)\n141|\t\t}\n142|\t})\n143|\tt.Run(\"owner approval revoked\", func(t *testing.T) {\n144|\t\tfake, record := setup()\n145|\t\t// Same recorded owner, but the policy no longer approves it:\n146|\t\t// renewed trust is still required.\n147|\t\tstrict := OwnerPolicy{OperatorUID: 9999}\n148|\t\tif err := Verify(record, strict, fake); err == nil {\n149|\t\t\tt.Fatal(\"Verify accepted a no-longer-approved owner, want integrity_failure\")\n150|\t\t}\n151|\t})\n152|}\n153|\n154|// TestVerifyTreatsReadFailureAsIntegrityFailure proves an unreadable file\n155|// cannot prove it is unchanged: every seam failure at verify time fails\n156|// with integrity_failure rather than success or absence.\n157|func TestVerifyTreatsReadFailureAsIntegrityFailure(t *testing.T) {\n158|\tsetup := func() (*fakeSystem, TrustRecord) {\n159|\t\tfake := newFakeSystem()\n160|\t\tfake.addLinkedFile(\"/plugins\", \"ax-provider-foo\", \"/opt/real/foo\", []byte(\"bytes\"), fakeUID, true)\n161|\t\treturn fake, trustOneFoo(t, discoverOneFoo(t, fake))\n162|\t}\n163|\tt.Run(\"unresolvable source\", func(t *testing.T) {\n164|\t\tfake, record := setup()\n165|\t\tdelete(fake.canon, \"/plugins/ax-provider-foo\")\n166|\t\tif err := Verify(record, fakeOwner(), fake); err == nil {\n167|\t\t\tt.Fatal(\"Verify accepted an unresolvable receipt, want integrity_failure\")\n168|\t\t} else if code := errorCode(t, err); code != codeIntegrityFailure {\n169|\t\t\tt.Fatalf(\"code = %q, want integrity_failure\", code)\n170|\t\t}\n171|\t})\n172|\tt.Run(\"uninspectable target\", func(t *testing.T) {\n173|\t\tfake, record := setup()\n174|\t\tdelete(fake.files, \"/opt/real/foo\")\n175|\t\tif err := Verify(record, fakeOwner(), fake); err == nil {\n176|\t\t\tt.Fatal(\"Verify accepted an uninspectable target, want integrity_failure\")\n177|\t\t} else if code := errorCode(t, err); code != codeIntegrityFailure {\n178|\t\t\tt.Fatalf(\"code = %q, want integrity_failure\", code)\n179|\t\t}\n180|\t})\n181|\tt.Run(\"unreadable target\", func(t *testing.T) {\n182|\t\tfake := newFakeSystem()\n183|\t\tfake.entries[\"/plugins\"] = []string{\"ax-provider-foo\"}\n184|\t\tfake.canon[\"/plugins/ax-provider-foo\"] = \"/opt/real/foo\"\n185|\t\tfake.files[\"/opt/real/foo\"] = fakeFile{content: []byte(\"bytes\"), uid: fakeUID, regular: true}\n186|\t\trecord := trustOneFoo(t, discoverOneFoo(t, fake))\n187|\t\tfake.contentErr[\"/opt/real/foo\"] = errDiskGone\n188|\t\tif err := Verify(record, fakeOwner(), fake); err == nil {\n189|\t\t\tt.Fatal(\"Verify accepted an unreadable target, want integrity_failure\")\n190|\t\t} else if code := errorCode(t, err); code != codeIntegrityFailure {\n191|\t\t\tt.Fatalf(\"code = %q, want integrity_failure\", code)\n192|\t\t}\n193|\t})\n194|}\n195|\n196|// TestVerifyRefusesForgedReceipts proves Verify rechecks the receipt\n197|// instead of trusting its claims: a self-minted receipt whose digest does\n198|// not match the bytes on disk fails, even when every path and owner fact\n199|// matches.\n200|func TestVerifyRefusesForgedReceipts(t *testing.T) {\n201|\tfake := newFakeSystem()\n202|\tfake.addFile(\"/plugins\", \"ax-provider-foo\", []byte(\"real bytes\"), fakeUID)\n203|\tcandidate := discoverOneFoo(t, fake)\n204|\tgenuine := trustOneFoo(t, candidate)\n205|\tforged := TrustRecord{\n206|\t\tproviderID: genuine.ProviderID(),\n207|\t\tsourcePath: genuine.SourcePath(),\n208|\t\tcanon:      genuine.CanonicalPath(),\n209|\t\tdigest:     scalar.SHA256Digest([]byte(\"attacker bytes\")),\n210|\t\towner:      genuine.Owner(),\n211|\t\ttrustedAt:  genuine.TrustedAt(),\n212|\t}\n213|\tif err := Verify(forged, fakeOwner(), fake); err == nil {\n214|\t\tt.Fatal(\"Verify accepted a self-minted receipt, want integrity_failure\")\n215|\t} else if code := errorCode(t, err); code != codeIntegrityFailure {\n216|\t\tt.Fatalf(\"code = %q, want integrity_failure\", code)\n217|\t}\n218|\tif err := Verify(genuine, fakeOwner(), fake); err != nil {\n219|\t\tt.Fatalf(\"Verify refused the genuine receipt: %v\", err)\n220|\t}\n221|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
