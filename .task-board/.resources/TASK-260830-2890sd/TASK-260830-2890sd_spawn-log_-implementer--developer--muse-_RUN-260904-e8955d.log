{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5bd","stream":{"kind":"session","id":"01a06e76-bae7-71e0-a570-bb4cc0067a43"},"sequence":313,"recorded_at":1780531400000621,"record_type":"event","durability":"durable","causation_id":"45fd7c01-9695-4667-a2dd-8bdcc25383b6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"45fd7c01-9695-4667-a2dd-8bdcc25383b6","run_stream":{"kind":"run","id":"45fd7c01-9695-4667-a2dd-8bdcc25383b6"},"task_stream":{"kind":"task","id":"29f2f15b-eb19-4616-ab2c-1804f4e86c7f"},"task_id":"29f2f15b-eb19-4616-ab2c-1804f4e86c7f","event":{"kind":"output","task_id":"29f2f15b-eb19-4616-ab2c-1804f4e86c7f","chunk":"Read text file `internal/provider/os_windows.go`.\n1|//go:build windows\n2|\n3|package provider\n4|\n5|import (\n6|\t\"fmt\"\n7|\t\"os\"\n8|)\n9|\n10|// fileOwnerUID refuses owner attestation on native Windows: no UID model\n11|// exists there, and an unapproved owner must fail closed. External\n12|// executables are therefore undiscoverable on native Windows until a\n13|// Windows owner model lands; built-in adapters are unaffected because they\n14|// carry no executable trust facts.\n15|func fileOwnerUID(info os.FileInfo) (uint32, error) {\n16|\treturn 0, fmt.Errorf(\"provider owner attestation: native Windows owner model is not implemented\")\n17|}"}}}
