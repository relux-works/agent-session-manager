{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c583","stream":{"kind":"session","id":"01a06e76-bae7-71e0-a570-bb4cc0067a43"},"sequence":284,"recorded_at":1780531400000563,"record_type":"event","durability":"durable","causation_id":"45fd7c01-9695-4667-a2dd-8bdcc25383b6","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"45fd7c01-9695-4667-a2dd-8bdcc25383b6","run_stream":{"kind":"run","id":"45fd7c01-9695-4667-a2dd-8bdcc25383b6"},"call_id":"call_01a06e773bd47701ba117c72fc464ed1","text":"Read text file `internal/provider/os_test.go`.\n1|package provider\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// writeExecutable creates dir/name with content and owner-only-executable\n15|// permissions. The executable bit is convenio, not a trust fact: Discover\n16|// records regular-file shape, owner, and digest, never the mode.\n17|func writeExecutable(t *testing.T, dir, name string, content []byte) string {\n18|\tt.Helper()\n19|\tpath := filepath.Join(dir, name)\n20|\tif err := os.WriteFile(path, content, 0o700); err != nil {\n21|\t\tt.Fatalf(\"WriteFile(%s): %v\", path, err)\n22|\t}\n23|\treturn path\n24|}\n25|\n26|// TestOSSystemEndToEnd drives the production entry points Discover, Trust,\n27|// and Verify through the production OSSystem on a real temporary tree:\n28|// symlink resolution, digest recording, trust acceptance, retarget\n29|// detection, byte-change detection, and non-regular replacement detection.\n30|func TestOSSystemEndToEnd(t *testing.T) {\n31|\troot, err := filepath.EvalSymlinks(t.TempDir())\n32|\tif err != nil {\n33|\t\tt.Fatalf(\"EvalSymlinks: %v\", err)\n34|\t}\n35|\tplugindir := filepath.Join(root, \"plugins\")\n36|\trealdir := filepath.Join(root, \"real\")\n37|\tif err := os.MkdirAll(plugindir, 0o755); err != nil {\n38|\t\tt.Fatalf(\"MkdirAll: %v\", err)\n39|\t}\n40|\tif err := os.MkdirAll(realdir, 0o755); err != nil {\n41|\t\tt.Fatalf(\"MkdirAll: %v\", err)\n42|\t}\n43|\tcontent := []byte(\"#!/bin/sh\\nexit 0\\n\")\n44|\ttarget := writeExecutable(t, realdir, \"tool\", content)\n45|\tsource := filepath.Join(plugindir, \"ax-provider-mytool\")\n46|\tif err := os.Symlink(target, source); err != nil {\n47|\t\tt.Fatalf(\"Symlink: %v\", err)\n48|\t}\n49|\n50|\tsystem := OSSystem{}\n51|\towner := CurrentOperatorPolicy()\n52|\tcfg := Config{Platform: scalar.PlatformLinux, PluginDirs: []string{plugindir}}\n53|\n54|\tgot, err := Discover(cfg, owner, system)\n55|\tif err != nil {\n56|\t\tt.Fatalf(\"Discover: %v\", err)\n57|\t}\n58|\tvar candidate *Candidate\n59|\tfor i := range got {\n60|\t\tif got[i].ID() == \"mytool\" {\n61|\t\t\tcandidate = &got[i]\n62|\t\t}\n63|\t}\n64|\tif candidate == nil {\n65|\t\tt.Fatalf(\"candidate mytool missing: %v\", got)\n66|\t}\n67|\tcanon, _ := candidate.CanonicalPath()\n68|\tif canon != target {\n69|\t\tt.Fatalf(\"CanonicalPath = %q, want %q\", canon, target)\n70|\t}\n71|\tsum := sha256.Sum256(content)\n72|\tdigest, _ := candidate.Digest()\n73|\tif digest.Hex() != hex.EncodeToString(sum[:]) {\n74|\t\tt.Fatalf(\"Digest = %v, want sha256 of target bytes\", digest)\n75|\t}\n76|\n77|\trecord, err := Trust(*candidate, mustTimestamp(t, trustInstant))\n78|\tif err != nil {\n79|\t\tt.Fatalf(\"Trust: %v\", err)\n80|\t}\n81|\tif err := Verify(record, owner, system); err != nil {\n82|\t\tt.Fatalf(\"Verify of an unchanged tree: %v\", err)\n83|\t}\n84|\n85|\tt.Run(\"retargeted symlink requires renewed trust\", func(t *testing.T) {\n86|\t\tevil := writeExecutable(t, realdir, \"evil\", []byte(\"#!/bin/sh\\nexit 1\\n\"))\n87|\t\tif err := os.Remove(source); err != nil {\n88|\t\t\tt.Fatalf(\"Remove: %v\", err)\n89|\t\t}\n90|\t\tif err := os.Symlink(evil, source); err != nil {\n91|\t\t\tt.Fatalf(\"Symlink: %v\", err)\n92|\t\t}\n93|\t\tdefer func() {\n94|\t\t\tos.Remove(source)\n95|\t\t\tos.Symlink(target, source)\n96|\t\t}()\n97|\t\tif err := Verify(record, owner, system); err == nil {\n98|\t\t\tt.Fatal(\"Verify accepted a retargeted symlink\")\n99|\t\t} else if code := errorCode(t, err); code != codeIntegrityFailure {\n100|\t\t\tt.Fatalf(\"code = %q, want integrity_failure\", code)\n101|\t\t}\n102|\t})\n103|\n104|\tt.Run(\"changed bytes require renewed trust\", func(t *testing.T) {\n105|\t\tif err := os.WriteFile(target, []byte(\"#!/bin/sh\\nexit 2\\n\"), 0o700); err != nil {\n106|\t\t\tt.Fatalf(\"WriteFile: %v\", err)\n107|\t\t}\n108|\t\tdefer os.WriteFile(target, content, 0o700)\n109|\t\tif err := Verify(record, owner, system); err == nil {\n110|\t\t\tt.Fatal(\"Verify accepted changed bytes\")\n111|\t\t}\n112|\t})\n113|\n114|\tt.Run(\"non-regular replacement requires renewed trust\", func(t *testing.T) {\n115|\t\tplain := filepath.Join(plugindir, \"ax-provider-plain\")\n116|\t\tif err := os.WriteFile(plain, []byte(\"x\"), 0o600); err != nil {\n117|\t\t\tt.Fatalf(\"WriteFile: %v\", err)\n118|\t\t}\n119|\t\tplainCandidates, err := Discover(Config{Platform: scalar.PlatformLinux, PluginDirs: []string{plugindir}}, owner, system)\n120|\t\tif err != nil {\n121|\t\t\tt.Fatalf(\"Discover: %v\", err)\n122|\t\t}\n123|\t\tvar plainCandidate *Candidate\n124|\t\tfor i := range plainCandidates {\n125|\t\t\tif plainCandidates[i].ID() == \"plain\" {\n126|\t\t\t\tplainCandidate = &plainCandidates[i]\n127|\t\t\t}\n128|\t\t}\n129|\t\tif plainCandidate == nil {\n130|\t\t\tt.Fatal(\"candidate plain missing\")\n131|\t\t}\n132|\t\tplainRecord, err := Trust(*plainCandidate, mustTimestamp(t, trustInstant))\n133|\t\tif err != nil {\n134|\t\t\tt.Fatalf(\"Trust: %v\", err)\n135|\t\t}\n136|\t\tif err := os.Remove(plain); err != nil {\n137|\t\t\tt.Fatalf(\"Remove: %v\", err)\n138|\t\t}\n139|\t\tif err := os.Mkdir(plain, 0o755); err != nil {\n140|\t\t\tt.Fatalf(\"Mkdir: %v\", err)\n141|\t\t}\n142|\t\tdefer os.Remove(plain)\n143|\t\tif err := Verify(plainRecord, owner, system); err == nil {\n144|\t\t\tt.Fatal(\"Verify accepted a directory replacement\")\n145|\t\t}\n146|\t})\n147|\n148|\tt.Run(\"direct executable without symlink\", func(t *testing.T) {\n149|\t\tdirect := filepath.Join(plugindir, \"ax-provider-direct\")\n150|\t\tif err := os.WriteFile(direct, []byte(\"direct\"), 0o700); err != nil {\n151|\t\t\tt.Fatalf(\"WriteFile: %v\", err)\n152|\t\t}\n153|\t\tdefer os.Remove(direct)\n154|\t\tresolved, err := filepath.EvalSymlinks(direct)\n155|\t\tif err != nil {\n156|\t\t\tt.Fatalf(\"EvalSymlinks: %v\", err)\n157|\t\t}\n158|\t\tdirectCandidates, err := Discover(Config{Platform: scalar.PlatformLinux, PluginDirs: []string{plugindir}}, owner, system)\n159|\t\tif err != nil {\n160|\t\t\t// The tree now also holds mytool/plain fixtures; a duplicate\n161|\t\t\t// or refusal from an unrelated fixture must not mask this\n162|\t\t\t// case, so report it plainly.\n163|\t\t\tt.Fatalf(\"Discover: %v\", err)\n164|\t\t}\n165|\t\tfor _, found := range directCandidates {\n166|\t\t\tif found.ID() == \"direct\" {\n167|\t\t\t\tcanon, _ := found.CanonicalPath()\n168|\t\t\t\tif canon != resolved {\n169|\t\t\t\t\tt.Fatalf(\"CanonicalPath = %q, want %q\", canon, resolved)\n170|\t\t\t\t}\n171|\t\t\t\treturn\n172|\t\t\t}\n173|\t\t}\n174|\t\tt.Fatal(\"candidate direct missing\")\n175|\t})\n176|}\n177|\n178|// TestOSSystemDuplicateNeverExecutes is the behavioral half of the Section\n179|// 7.1 ordering guarantee on the production seam: a duplicate fixture\n180|// containing a live shell script that marks a sentinel file fails\n181|// discovery with invalid_config and leaves the sentinel absent.\n182|func TestOSSystemDuplicateNeverExecutes(t *testing.T) {\n183|\troot := t.TempDir()\n184|\tplugindir := filepath.Join(root, \"plugins\")\n185|\tif err := os.MkdirAll(plugindir, 0o755); err != nil {\n186|\t\tt.Fatalf(\"MkdirAll: %v\", err)\n187|\t}\n188|\tsentinel := filepath.Join(root, \"executed\")\n189|\tscript := []byte(\"#!/bin/sh\\necho executed >> \" + sentinel + \"\\n\")\n190|\twriteExecutable(t, plugindir, \"ax-provider-codex\", script)\n191|\n192|\t_, err := Discover(\n193|\t\tConfig{Platform: scalar.PlatformLinux, PluginDirs: []string{plugindir}},\n194|\t\tCurrentOperatorPolicy(),\n195|\t\tOSSystem{},\n196|\t)\n197|\tif err == nil {\n198|\t\tt.Fatal(\"Discover admitted a builtin-shadowing executable\")\n199|\t}\n200|\tif code := errorCode(t, err); code != codeInvalidConfig {\n201|\t\tt.Fatalf(\"code = %q, want invalid_config\", code)\n202|\t}\n203|\tif _, statErr := os.Stat(sentinel); !os.IsNotExist(statErr) {\n204|\t\tt.Fatalf(\"duplicate candidate was executed; sentinel present: %v\", statErr)\n205|\t}\n206|}\n207|\n208|// TestOSSystemPATHDiscovery drives the PATH source through the production\n209|// seam with an isolated PATH: discovery finds the tool when allowed,\n210|// ignores PATH when disallowed, and refuses duplicates across PATH\n211|// directories.\n212|func TestOSSystemPATHDiscovery(t *testing.T) {\n213|\troot, err := filepath.EvalSymlinks(t.TempDir())\n214|\tif err != nil {\n215|\t\tt.Fatalf(\"EvalSymlinks: %v\", err)\n216|\t}\n217|\tfirst := filepath.Join(root, \"bin1\")\n218|\tsecond := filepath.Join(root, \"bin2\")\n219|\tfor _, dir := range []string{first, second} {\n220|\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n221|\t\t\tt.Fatalf(\"MkdirAll: %v\", err)\n222|\t\t}\n223|\t}\n224|\twriteExecutable(t, first, \"ax-provider-pathtool\", []byte(\"p1\"))\n225|\tt.Setenv(\"PATH\", first+string(os.PathListSeparator)+second)\n226|\n227|\tsystem := OSSystem{}\n228|\towner := CurrentOperatorPolicy()\n229|\n230|\tallowed := Config{Platform: scalar.PlatformLinux, AllowPathPlugins: true}\n231|\tgot, err := Discover(allowed, owner, system)\n232|\tif err != nil {\n233|\t\tt.Fatalf(\"Discover: %v\", err)\n234|\t}\n235|\tfound := false\n236|\tfor _, candidate := range got {\n237|\t\tif candidate.ID() == \"pathtool\" && candidate.Source() == \"path\" {\n238|\t\t\tfound = true\n239|\t\t\tcanon, _ := candidate.CanonicalPath()\n240|\t\t\tif !strings.HasPrefix(canon, first) {\n241|\t\t\t\tt.Fatalf(\"CanonicalPath = %q, want it under %q\", canon, first)\n242|\t\t\t}\n243|\t\t}\n244|\t}\n245|\tif !found {\n246|\t\tt.Fatal(\"PATH candidate missing when allow_path_plugins is true\")\n247|\t}\n248|\n249|\tdenied, err := Discover(Config{Platform: scalar.PlatformLinux}, owner, system)\n250|\tif err != nil {\n251|\t\tt.Fatalf(\"Discover: %v\", err)\n252|\t}\n253|\tfor _, candidate := range denied {\n254|\t\tif candidate.ID() == \"pathtool\" {\n255|\t\t\tt.Fatal(\"PATH candidate admitted while allow_path_plugins is false\")\n256|\t\t}\n257|\t}\n258|\n259|\twriteExecutable(t, second, \"ax-provider-pathtool\", []byte(\"p2\"))\n260|\tif _, err := Discover(allowed, owner, system); err == nil {\n261|\t\tt.Fatal(\"Discover admitted one ID from two PATH directories\")\n262|\t} else if code := errorCode(t, err); code != codeInvalidConfig {\n263|\t\tt.Fatalf(\"code = %q, want invalid_config\", code)\n264|\t}\n265|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c585","stream":{"kind":"session","id":"01a06e76-bae7-71e0-a570-bb4cc0067a43"},"sequence":285,"recorded_at":1780531400000565,"record_type":"event","durability":"durable","causation_id":"45fd7c01-9695-4667-a2dd-8bdcc25383b6","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"45fd7c01-9695-4667-a2dd-8bdcc25383b6","run_stream":{"kind":"run","id":"45fd7c01-9695-4667-a2dd-8bdcc25383b6"},"call_id":"call_01a06e773c6d76f1afd930c3a4458a5c","text":"Read text file `internal/provider/refusal_inventory_test.go`.\n1|package provider\n2|\n3|import (\n4|\t\"flag\"\n5|\t\"fmt\"\n6|\t\"go/ast\"\n7|\t\"go/parser\"\n8|\t\"go/token\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\t\"runtime\"\n12|\t\"sort\"\n13|\t\"strings\"\n14|\t\"sync\"\n15|\t\"testing\"\n16|)\n17|\n18|// exercisedRefusalSites records the production file:line that constructed a\n19|// refusal, for every instrumented refusal constructor call made during the\n20|// test run. observedCodes records every stable code those refusals carried.\n21|var exercisedRefusalSites sync.Map\n22|var observedCodes sync.Map\n23|\n24|func recordRefusalSite(code string) {\n25|\tobservedCodes.Store(code, struct{}{})\n26|\tif _, file, line, ok := runtime.Caller(2); ok {\n27|\t\texercisedRefusalSites.Store(fmt.Sprintf(\"%s:%d\", filepath.Base(file), line), struct{}{})\n28|\t}\n29|}\n30|\n31|func TestMain(main *testing.M) {\n32|\torigDuplicate, origInvalid, origPrecondition, origIntegrity := failDuplicate, failInvalid, failPrecondition, failIntegrity\n33|\tfailDuplicate = func(providerID, firstSource, secondSource string) Error {\n34|\t\terr := origDuplicate(providerID, firstSource, secondSource)\n35|\t\trecordRefusalSite(err.Code())\n36|\t\treturn err\n37|\t}\n38|\tfailInvalid = func(detail string) Error {\n39|\t\terr := origInvalid(detail)\n40|\t\trecordRefusalSite(err.Code())\n41|\t\treturn err\n42|\t}\n43|\tfailPrecondition = func(detail string, cause error) Error {\n44|\t\terr := origPrecondition(detail, cause)\n45|\t\trecordRefusalSite(err.Code())\n46|\t\treturn err\n47|\t}\n48|\tfailIntegrity = func(detail string, cause error) Error {\n49|\t\terr := origIntegrity(detail, cause)\n50|\t\trecordRefusalSite(err.Code())\n51|\t\treturn err\n52|\t}\n53|\tcode := main.Run()\n54|\tif code == 0 && fullPackageTestRun() {\n55|\t\tif failures := auditRefusalInventory(); len(failures) != 0 {\n56|\t\t\tfor _, failure := range failures {\n57|\t\t\t\tfmt.Fprintln(os.Stderr, failure)\n58|\t\t\t}\n59|\t\t\tcode = 1\n60|\t\t}\n61|\t}\n62|\tos.Exit(code)\n63|}\n64|\n65|func fullPackageTestRun() bool {\n66|\tselected := flag.Lookup(\"test.run\")\n67|\treturn selected == nil || selected.Value.String() == \"\"\n68|}\n69|\n70|// auditRefusalInventory derives the refusal inventory from package source,\n71|// never from memory: every production call to a refusal constructor must\n72|// have an exercised negative path, no Error value may be built outside the\n73|// four constructors, and the observed code set must equal the closed code\n74|// set exactly.\n75|func auditRefusalInventory() []string {\n76|\tdirectory, err := os.Getwd()\n77|\tif err != nil {\n78|\t\treturn []string{fmt.Sprintf(\"derive provider refusal inventory: %v\", err)}\n79|\t}\n80|\tinventory, err := deriveRefusalInventory(directory)\n81|\tif err != nil {\n82|\t\treturn []string{fmt.Sprintf(\"derive provider refusal inventory: %v\", err)}\n83|\t}\n84|\tvar failures []string\n85|\tif len(inventory.StrayLiterals) != 0 {\n86|\t\tsort.Strings(inventory.StrayLiterals)\n87|\t\tfailures = append(failures, \"provider refusals built outside an instrumented constructor: \"+strings.Join(inventory.StrayLiterals, \", \"))\n88|\t}\n89|\tif len(inventory.RawConstructors) != 0 {\n90|\t\tsort.Strings(inventory.RawConstructors)\n91|\t\tfailures = append(failures, \"provider raw error construction outside documented cause sites: \"+strings.Join(inventory.RawConstructors, \", \"))\n92|\t}\n93|\tvar missing []string\n94|\tfor _, site := range inventory.Sites {\n95|\t\tif _, ok := exercisedRefusalSites.Load(site); !ok {\n96|\t\t\tmissing = append(missing, site)\n97|\t\t}\n98|\t}\n99|\tsort.Strings(missing)\n100|\tif len(missing) != 0 {\n101|\t\tfailures = append(failures, \"provider refusal call sites without an exercised negative path: \"+strings.Join(missing, \", \"))\n102|\t}\n103|\tvar codes []string\n104|\tobservedCodes.Range(func(key, _ any) bool {\n105|\t\tcodes = append(codes, key.(string))\n106|\t\treturn true\n107|\t})\n108|\tsort.Strings(codes)\n109|\twant := []string{codeIntegrityFailure, codeInvalidConfig, codeLocalPrecondition}\n110|\tif fmt.Sprintf(\"%v\", codes) != fmt.Sprintf(\"%v\", want) {\n111|\t\tfailures = append(failures, fmt.Sprintf(\"observed refusal codes = %v, want closed set %v\", codes, want))\n112|\t}\n113|\treturn failures\n114|}\n115|\n116|// refusalInventory is derived from package sources.\n117|type refusalInventory struct {\n118|\t// Sites are file:line positions of production refusal constructor calls.\n119|\tSites []string\n120|\t// StrayLiterals are Error composite literals outside the constructors.\n121|\tStrayLiterals []string\n122|\t// RawConstructors are errors.New, fmt.Errorf, or panic calls outside\n123|\t// the documented owner-attestation cause sites.\n124|\tRawConstructors []string\n125|}\n126|\n127|var refusalConstructors = map[string]bool{\n128|\t\"failDuplicate\":    true,\n129|\t\"failInvalid\":      true,\n130|\t\"failPrecondition\": true,\n131|\t\"failIntegrity\":    true,\n132|}\n133|\n134|// causeSiteFiles are the only production files allowed to mint raw cause\n135|// errors: the platform owner-attestation seams whose failures production\n136|// code always wraps in a refusal constructor.\n137|var causeSiteFiles = map[string]bool{\n138|\t\"os_unix.go\":    true,\n139|\t\"os_windows.go\": true,\n140|}\n141|\n142|func deriveRefusalInventory(directory string) (refusalInventory, error) {\n143|\tentries, err := os.ReadDir(directory)\n144|\tif err != nil {\n145|\t\treturn refusalInventory{}, err\n146|\t}\n147|\tvar inventory refusalInventory\n148|\tfileSet := token.NewFileSet()\n149|\tfor _, entry := range entries {\n150|\t\tname := entry.Name()\n151|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n152|\t\t\tcontinue\n153|\t\t}\n154|\t\tpath := filepath.Join(directory, name)\n155|\t\tsource, err := os.ReadFile(path)\n156|\t\tif err != nil {\n157|\t\t\treturn refusalInventory{}, err\n158|\t\t}\n159|\t\tsyntax, err := parser.ParseFile(fileSet, path, source, parser.ParseComments)\n160|\t\tif err != nil {\n161|\t\t\treturn refusalInventory{}, err\n162|\t\t}\n163|\t\t// Map each constructor's own body span so literals inside it are\n164|\t\t// not mistaken for strays.\n165|\t\tconstructorBodies := map[*ast.FuncLit]bool{}\n166|\t\tfor _, decl := range syntax.Decls {\n167|\t\t\tgeneral, ok := decl.(*ast.GenDecl)\n168|\t\t\tif !ok {\n169|\t\t\t\tcontinue\n170|\t\t\t}\n171|\t\t\tfor _, spec := range general.Specs {\n172|\t\t\t\tvalues, ok := spec.(*ast.ValueSpec)\n173|\t\t\t\tif !ok {\n174|\t\t\t\t\tcontinue\n175|\t\t\t\t}\n176|\t\t\t\tfor i, ident := range values.Names {\n177|\t\t\t\t\tif !refusalConstructors[ident.Name] || i >= len(values.Values) {\n178|\t\t\t\t\t\tcontinue\n179|\t\t\t\t\t}\n180|\t\t\t\t\tif literal, ok := values.Values[i].(*ast.FuncLit); ok {\n181|\t\t\t\t\t\tconstructorBodies[literal] = true\n182|\t\t\t\t\t}\n183|\t\t\t\t}\n184|\t\t\t}\n185|\t\t}\n186|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n187|\t\t\tcall, ok := node.(*ast.CallExpr)\n188|\t\t\tif !ok {\n189|\t\t\t\treturn true\n190|\t\t\t}\n191|\t\t\tposition := fileSet.Position(call.Pos())\n192|\t\t\tsite := fmt.Sprintf(\"%s:%d\", filepath.Base(position.Filename), position.Line)\n193|\t\t\tif ident, ok := call.Fun.(*ast.Ident); ok {\n194|\t\t\t\tif refusalConstructors[ident.Name] {\n195|\t\t\t\t\tinventory.Sites = append(inventory.Sites, site)\n196|\t\t\t\t\treturn true\n197|\t\t\t\t}\n198|\t\t\t\tif ident.Name == \"panic\" {\n199|\t\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" panic\")\n200|\t\t\t\t\treturn true\n201|\t\t\t\t}\n202|\t\t\t}\n203|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n204|\t\t\tif !ok {\n205|\t\t\t\treturn true\n206|\t\t\t}\n207|\t\t\tif qualifier, ok := selector.X.(*ast.Ident); ok {\n208|\t\t\t\tqualified := qualifier.Name + \".\" + selector.Sel.Name\n209|\t\t\t\tif qualified == \"errors.New\" || qualified == \"fmt.Errorf\" {\n210|\t\t\t\t\tif !causeSiteFiles[name] {\n211|\t\t\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" \"+qualified)\n212|\t\t\t\t\t}\n213|\t\t\t\t\treturn true\n214|\t\t\t\t}\n215|\t\t\t}\n216|\t\t\tif selector.Sel.Name == \"panic\" {\n217|\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" panic\")\n218|\t\t\t}\n219|\t\t\treturn true\n220|\t\t})\n221|\t\t// Stray Error literals: composite literals of type Error outside\n222|\t\t// a constructor body. Bodies are matched by source span.\n223|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n224|\t\t\tliteral, ok := node.(*ast.CompositeLit)\n225|\t\t\tif !ok {\n226|\t\t\t\treturn true\n227|\t\t\t}\n228|\t\t\tident, ok := literal.Type.(*ast.Ident)\n229|\t\t\tif !ok || ident.Name != \"Error\" {\n230|\t\t\t\treturn true\n231|\t\t\t}\n232|\t\t\tfor body := range constructorBodies {\n233|\t\t\t\tif literal.Pos() >= body.Pos() && literal.End() <= body.End() {\n234|\t\t\t\t\treturn true\n235|\t\t\t\t}\n236|\t\t\t}\n237|\t\t\tposition := fileSet.Position(literal.Pos())\n238|\t\t\tinventory.StrayLiterals = append(inventory.StrayLiterals, fmt.Sprintf(\"%s:%d\", filepath.Base(position.Filename), position.Line))\n239|\t\t\treturn true\n240|\t\t})\n241|\t}\n242|\treturn inventory, nil\n243|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
