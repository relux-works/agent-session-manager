{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c547","stream":{"kind":"session","id":"01a06e76-bae7-71e0-a570-bb4cc0067a43"},"sequence":254,"recorded_at":1780531400000503,"record_type":"event","durability":"durable","causation_id":"45fd7c01-9695-4667-a2dd-8bdcc25383b6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"45fd7c01-9695-4667-a2dd-8bdcc25383b6","run_stream":{"kind":"run","id":"45fd7c01-9695-4667-a2dd-8bdcc25383b6"},"task_stream":{"kind":"task","id":"4d1f1fe0-53d1-42f4-8005-a13ab8d2b21c"},"task_id":"4d1f1fe0-53d1-42f4-8005-a13ab8d2b21c","event":{"kind":"output","task_id":"4d1f1fe0-53d1-42f4-8005-a13ab8d2b21c","chunk":"Read text file `internal/provider/determinism_test.go`.\n1|package provider\n2|\n3|import (\n4|\t\"reflect\"\n5|\t\"testing\"\n6|)\n7|\n8|// candidateSignature reduces a candidate list to its stable observable\n9|// facts for byte-level determinism comparison.\n10|func candidateSignature(candidates []Candidate) []string {\n11|\tvar out []string\n12|\tfor _, candidate := range candidates {\n13|\t\tdigest, _ := candidate.Digest()\n14|\t\tcanon, _ := candidate.CanonicalPath()\n15|\t\towner, _ := candidate.Owner()\n16|\t\tsource, _ := candidate.SourcePath()\n17|\t\tout = append(out, string(candidate.Kind())+\"/\"+candidate.ID()+\"/\"+candidate.Source()+\"/\"+source+\"/\"+canon+\"/\"+digest.String()+\"/\"+owner)\n18|\t}\n19|\treturn out\n20|}\n21|\n22|// TestDiscoverIsDeterministic proves repeated discovery over an unchanged\n23|// tree returns identical candidates: same IDs, sources, paths, digests,\n24|// and owners in the same order.\n25|func TestDiscoverIsDeterministic(t *testing.T) {\n26|\tfake := newFakeSystem()\n27|\tfake.addFile(\"/plugins/b\", \"ax-provider-second\", []byte(\"two\"), fakeUID)\n28|\tfake.addLinkedFile(\"/plugins/a\", \"ax-provider-first\", \"/opt/real/first\", []byte(\"one\"), fakeUID, true)\n29|\tfake.addFile(\"/pathbin\", \"ax-provider-third\", []byte(\"three\"), fakeUID)\n30|\tfake.pathDirs = []string{\"/pathbin\"}\n31|\tcfg := fakeConfig(\"/plugins/b\", \"/plugins/a\")\n32|\tcfg.AllowPathPlugins = true\n33|\n34|\tfirst, err := Discover(cfg, fakeOwner(), fake)\n35|\tif err != nil {\n36|\t\tt.Fatalf(\"Discover: %v\", err)\n37|\t}\n38|\tsecond, err := Discover(cfg, fakeOwner(), fake)\n39|\tif err != nil {\n40|\t\tt.Fatalf(\"Discover: %v\", err)\n41|\t}\n42|\tif !reflect.DeepEqual(candidateSignature(first), candidateSignature(second)) {\n43|\t\tt.Fatalf(\"repeated discovery differs:\\n%v\\n%v\", candidateSignature(first), candidateSignature(second))\n44|\t}\n45|}\n46|\n47|// TestDiscoverIgnoresFilesystemOrder proves discovery is independent of\n48|// directory listing order: two fakes holding the same entries in opposite\n49|// insertion orders yield identical candidates. The fake already reverses\n50|// insertion order on read; here the insertion itself is reversed, so both\n51|// listing parities are covered.\n52|func TestDiscoverIgnoresFilesystemOrder(t *testing.T) {\n53|\tforward := newFakeSystem()\n54|\tforward.addFile(\"/plugins\", \"ax-provider-bravo\", []byte(\"b\"), fakeUID)\n55|\tforward.addFile(\"/plugins\", \"ax-provider-alpha\", []byte(\"a\"), fakeUID)\n56|\tforward.addFile(\"/plugins\", \"ax-provider-charlie\", []byte(\"c\"), fakeUID)\n57|\n58|\tbackward := newFakeSystem()\n59|\tbackward.addFile(\"/plugins\", \"ax-provider-charlie\", []byte(\"c\"), fakeUID)\n60|\tbackward.addFile(\"/plugins\", \"ax-provider-alpha\", []byte(\"a\"), fakeUID)\n61|\tbackward.addFile(\"/plugins\", \"ax-provider-bravo\", []byte(\"b\"), fakeUID)\n62|\n63|\tfirst, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), forward)\n64|\tif err != nil {\n65|\t\tt.Fatalf(\"Discover: %v\", err)\n66|\t}\n67|\tsecond, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), backward)\n68|\tif err != nil {\n69|\t\tt.Fatalf(\"Discover: %v\", err)\n70|\t}\n71|\tif !reflect.DeepEqual(candidateSignature(first), candidateSignature(second)) {\n72|\t\tt.Fatalf(\"listing-order-dependent discovery:\\n%v\\n%v\", candidateSignature(first), candidateSignature(second))\n73|\t}\n74|}"}}}
