{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5b3","stream":{"kind":"session","id":"01a06eb9-cab4-7c32-a1f1-2b4dbf5b926f"},"sequence":308,"recorded_at":1780531400000611,"record_type":"event","durability":"durable","causation_id":"9dbf4a98-925e-4730-ae52-9862c9470765","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9dbf4a98-925e-4730-ae52-9862c9470765","run_stream":{"kind":"run","id":"9dbf4a98-925e-4730-ae52-9862c9470765"},"task_stream":{"kind":"task","id":"258a4097-f074-4904-8946-ab5b790bb482"},"task_id":"258a4097-f074-4904-8946-ab5b790bb482","event":{"kind":"output","task_id":"258a4097-f074-4904-8946-ab5b790bb482","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provider/duplicate_test.go`.\n1|package provider\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|)\n7|\n8|// duplicateCases narrows the Section 7.1 duplicate refusal across every\n9|// source pair that can declare one ID: plugin against plugin, plugin\n10|// against builtin, plugin against PATH, and builtin against PATH. Each case\n11|// must fail with the section-mandated invalid_config.\n12|func duplicateCases() map[string]func(fake *fakeSystem, cfg *Config) {\n13|\treturn map[string]func(fake *fakeSystem, cfg *Config){\n14|\t\t\"plugin against plugin\": func(fake *fakeSystem, cfg *Config) {\n15|\t\t\tfake.addFile(\"/plugins/a\", \"ax-provider-dup\", []byte(\"one\"), fakeUID)\n16|\t\t\tfake.addFile(\"/plugins/b\", \"ax-provider-dup\", []byte(\"two\"), fakeUID)\n17|\t\t\t*cfg = fakeConfig(\"/plugins/a\", \"/plugins/b\")\n18|\t\t},\n19|\t\t\"plugin against builtin\": func(fake *fakeSystem, cfg *Config) {\n20|\t\t\tfake.addFile(\"/plugins\", \"ax-provider-codex\", []byte(\"shadow\"), fakeUID)\n21|\t\t\t*cfg = fakeConfig(\"/plugins\")\n22|\t\t},\n23|\t\t\"plugin against PATH\": func(fake *fakeSystem, cfg *Config) {\n24|\t\t\tfake.addFile(\"/plugins\", \"ax-provider-dup\", []byte(\"one\"), fakeUID)\n25|\t\t\tfake.addFile(\"/pathbin\", \"ax-provider-dup\", []byte(\"two\"), fakeUID)\n26|\t\t\tfake.pathDirs = []string{\"/pathbin\"}\n27|\t\t\t*cfg = fakeConfig(\"/plugins\")\n28|\t\t\tcfg.AllowPathPlugins = true\n29|\t\t},\n30|\t\t\"builtin against PATH\": func(fake *fakeSystem, cfg *Config) {\n31|\t\t\tfake.addFile(\"/pathbin\", \"ax-provider-claude\", []byte(\"shadow\"), fakeUID)\n32|\t\t\tfake.pathDirs = []string{\"/pathbin\"}\n33|\t\t\t*cfg = fakeConfig()\n34|\t\t\tcfg.AllowPathPlugins = true\n35|\t\t},\n36|\t\t\"same file observed through two PATH dirs\": func(fake *fakeSystem, cfg *Config) {\n37|\t\t\tfake.addFile(\"/path/a\", \"ax-provider-dup\", []byte(\"same\"), fakeUID)\n38|\t\t\tfake.addFile(\"/path/b\", \"ax-provider-dup\", []byte(\"same\"), fakeUID)\n39|\t\t\tfake.pathDirs = []string{\"/path/a\", \"/path/b\"}\n40|\t\t\t*cfg = fakeConfig()\n41|\t\t\tcfg.AllowPathPlugins = true\n42|\t\t},\n43|\t}\n44|}\n45|\n46|// TestDiscoverRefusesDuplicates proves the Section 7.1 duplicate rule at\n47|// the production entry point Discover: two candidates declaring one ID\n48|// fail with invalid_config, with no duplicate-selection override — not\n49|// even for byte-identical observations of one file.\n50|func TestDiscoverRefusesDuplicates(t *testing.T) {\n51|\tfor name, setup := range duplicateCases() {\n52|\t\tt.Run(name, func(t *testing.T) {\n53|\t\t\tfake := newFakeSystem()\n54|\t\t\tvar cfg Config\n55|\t\t\tsetup(fake, &cfg)\n56|\t\t\t_, err := Discover(cfg, fakeOwner(), fake)\n57|\t\t\tif err == nil {\n58|\t\t\t\tt.Fatalf(\"Discover admitted a duplicate provider ID, want invalid_config\")\n59|\t\t\t}\n60|\t\t\tif code := errorCode(t, err); code != codeInvalidConfig {\n61|\t\t\t\tt.Fatalf(\"code = %q, want invalid_config\", code)\n62|\t\t\t}\n63|\t\t\tif !strings.Contains(err.Error(), \"duplicate provider\") {\n64|\t\t\t\tt.Fatalf(\"detail does not name the duplicate: %v\", err)\n65|\t\t\t}\n66|\t\t})\n67|\t}\n68|}\n69|\n70|// TestDuplicateRefusalNamesBothSources proves the refusal detail carries\n71|// both declaring sources, so the operator knows which candidates to remove\n72|// or rename.\n73|func TestDuplicateRefusalNamesBothSources(t *testing.T) {\n74|\tfake := newFakeSystem()\n75|\tfake.addFile(\"/plugins/a\", \"ax-provider-dup\", []byte(\"one\"), fakeUID)\n76|\tfake.addFile(\"/plugins/b\", \"ax-provider-dup\", []byte(\"two\"), fakeUID)\n77|\t_, err := Discover(fakeConfig(\"/plugins/a\", \"/plugins/b\"), fakeOwner(), fake)\n78|\tif err == nil {\n79|\t\tt.Fatal(\"Discover admitted a duplicate provider ID\")\n80|\t}\n81|\tdetail := err.Error()\n82|\tif !strings.Contains(detail, \"plugin_dirs[0]\") || !strings.Contains(detail, \"plugin_dirs[1]\") {\n83|\t\tt.Fatalf(\"detail names neither source: %v\", err)\n84|\t}\n85|}\n86|\n87|// TestDuplicateRefusalPrecedesAnyProbeOrExecution proves the Section 7.1\n88|// ordering guarantee structurally: Discover accepts no probe or execution\n89|// callback, and the package imports no process-execution facility, so a\n90|// duplicate fixture containing a live executable cannot be reached. The\n91|// import scan lives in enumeration_test.go; this case pins the behavior at\n92|// a fixture shaped like an attack: a shadowing executable whose content\n93|// would execute if discovery ever shelled out.\n94|func TestDuplicateRefusalPrecedesAnyProbeOrExecution(t *testing.T) {\n95|\tfake := newFakeSystem()\n96|\tfake.addFile(\"/plugins\", \"ax-provider-codex\", []byte(\"#!/bin/sh\\nevil\"), fakeUID)\n97|\t_, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), fake)\n98|\tif err == nil {\n99|\t\tt.Fatal(\"Discover admitted a builtin-shadowing executable\")\n100|\t}\n101|\tif code := errorCode(t, err); code != codeInvalidConfig {\n102|\t\tt.Fatalf(\"code = %q, want invalid_config\", code)\n103|\t}\n104|}\n105|\n106|// TestDistinctIDsCoexist proves the refusal is scoped to true duplicates:\n107|// neighboring IDs from every source coexist in one result.\n108|func TestDistinctIDsCoexist(t *testing.T) {\n109|\tfake := newFakeSystem()\n110|\tfake.addFile(\"/plugins\", \"ax-provider-alpha\", []byte(\"a\"), fakeUID)\n111|\tfake.addFile(\"/pathbin\", \"ax-provider-beta\", []byte(\"b\"), fakeUID)\n112|\tfake.pathDirs = []string{\"/pathbin\"}\n113|\tcfg := fakeConfig(\"/plugins\")\n114|\tcfg.AllowPathPlugins = true\n115|\tgot, err := Discover(cfg, fakeOwner(), fake)\n116|\tif err != nil {\n117|\t\tt.Fatalf(\"Discover refused distinct IDs: %v\", err)\n118|\t}\n119|\tif len(got) != len(builtinOrder)+2 {\n120|\t\tt.Fatalf(\"candidate count = %d, want %d\", len(got), len(builtinOrder)+2)\n121|\t}\n122|}"}}}
