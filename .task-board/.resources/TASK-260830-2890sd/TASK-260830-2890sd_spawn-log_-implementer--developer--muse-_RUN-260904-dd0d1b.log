{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c537","stream":{"kind":"session","id":"01a06eb9-cab4-7c32-a1f1-2b4dbf5b926f"},"sequence":246,"recorded_at":1780531400000487,"record_type":"event","durability":"durable","causation_id":"9dbf4a98-925e-4730-ae52-9862c9470765","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9dbf4a98-925e-4730-ae52-9862c9470765","run_stream":{"kind":"run","id":"9dbf4a98-925e-4730-ae52-9862c9470765"},"task_stream":{"kind":"task","id":"44ad8ade-1646-4e15-8ff5-80f1ee50d8ae"},"task_id":"44ad8ade-1646-4e15-8ff5-80f1ee50d8ae","event":{"kind":"output","task_id":"44ad8ade-1646-4e15-8ff5-80f1ee50d8ae","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provider/discovery_test.go`.\n1|package provider\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"reflect\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// TestDiscoverEnumeratesSourcesInSectionOrder proves the Section 7.1\n13|// candidate order: configured plugin directories in listed order, then\n14|// built-in adapters, then PATH when allowed. The production entry point is\n15|// Discover.\n16|func TestDiscoverEnumeratesSourcesInSectionOrder(t *testing.T) {\n17|\tfake := newFakeSystem()\n18|\tfake.addFile(\"/plugins/a\", \"ax-provider-zzz\", []byte(\"zzz\"), fakeUID)\n19|\tfake.addFile(\"/plugins/b\", \"ax-provider-aaa\", []byte(\"aaa\"), fakeUID)\n20|\tfake.pathDirs = []string{\"/pathbin\"}\n21|\tfake.addFile(\"/pathbin\", \"ax-provider-pathone\", []byte(\"p\"), fakeUID)\n22|\n23|\tcfg := fakeConfig(\"/plugins/a\", \"/plugins/b\")\n24|\tcfg.AllowPathPlugins = true\n25|\tgot, err := Discover(cfg, fakeOwner(), fake)\n26|\tif err != nil {\n27|\t\tt.Fatalf(\"Discover: %v\", err)\n28|\t}\n29|\tvar order []string\n30|\tfor _, candidate := range got {\n31|\t\torder = append(order, string(candidate.Kind())+\"/\"+candidate.ID())\n32|\t}\n33|\twant := []string{\n34|\t\t\"external/zzz\",\n35|\t\t\"external/aaa\",\n36|\t\t\"builtin/codex\",\n37|\t\t\"builtin/claude\",\n38|\t\t\"builtin/gemini\",\n39|\t\t\"builtin/muse\",\n40|\t\t\"builtin/antigravity\",\n41|\t\t\"builtin/pi\",\n42|\t\t\"external/pathone\",\n43|\t}\n44|\tif !reflect.DeepEqual(order, want) {\n45|\t\tt.Fatalf(\"discovery order = %v, want %v\", order, want)\n46|\t}\n47|\tsources := map[string]string{}\n48|\tfor _, candidate := range got {\n49|\t\tsources[candidate.ID()] = candidate.Source()\n50|\t}\n51|\tif sources[\"zzz\"] != \"plugin_dirs[0]\" || sources[\"aaa\"] != \"plugin_dirs[1]\" {\n52|\t\tt.Fatalf(\"plugin sources = %v, want plugin_dirs[0]/plugin_dirs[1]\", sources)\n53|\t}\n54|\tif sources[\"codex\"] != \"builtin\" {\n55|\t\tt.Fatalf(\"builtin source = %q, want builtin\", sources[\"codex\"])\n56|\t}\n57|\tif sources[\"pathone\"] != \"path\" {\n58|\t\tt.Fatalf(\"path source = %q, want path\", sources[\"pathone\"])\n59|\t}\n60|}\n61|\n62|// TestDiscoverSortsEntriesWithinADirectory narrows the determinism claim:\n63|// the fake returns entries in reverse insertion order, so bytewise output\n64|// proves Discover sorts instead of inheriting filesystem order.\n65|func TestDiscoverSortsEntriesWithinADirectory(t *testing.T) {\n66|\tfake := newFakeSystem()\n67|\tfake.addFile(\"/plugins\", \"ax-provider-mango\", []byte(\"m\"), fakeUID)\n68|\tfake.addFile(\"/plugins\", \"ax-provider-apple\", []byte(\"a\"), fakeUID)\n69|\tfake.addFile(\"/plugins\", \"ax-provider-cherry\", []byte(\"c\"), fakeUID)\n70|\n71|\tgot, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), fake)\n72|\tif err != nil {\n73|\t\tt.Fatalf(\"Discover: %v\", err)\n74|\t}\n75|\tif got[0].ID() != \"apple\" || got[1].ID() != \"cherry\" || got[2].ID() != \"mango\" {\n76|\t\tt.Fatalf(\"directory order = [%s %s %s], want [apple cherry mango]\", got[0].ID(), got[1].ID(), got[2].ID())\n77|\t}\n78|}\n79|\n80|// TestDiscoverSkipsPATHWhenDisallowed proves the Section 7.1 PATH gate:\n81|// PATH is consulted only when allow_path_plugins is true.\n82|func TestDiscoverSkipsPATHWhenDisallowed(t *testing.T) {\n83|\tfake := newFakeSystem()\n84|\tfake.pathDirs = []string{\"/pathbin\"}\n85|\tfake.addFile(\"/pathbin\", \"ax-provider-pathtool\", []byte(\"p\"), fakeUID)\n86|\n87|\tgot, err := Discover(fakeConfig(), fakeOwner(), fake)\n88|\tif err != nil {\n89|\t\tt.Fatalf(\"Discover: %v\", err)\n90|\t}\n91|\tfor _, candidate := range got {\n92|\t\tif candidate.Kind() == KindExternal {\n93|\t\t\tt.Fatalf(\"PATH candidate %q admitted while allow_path_plugins is false\", candidate.ID())\n94|\t\t}\n95|\t}\n96|\tif len(got) != len(builtinOrder) {\n97|\t\tt.Fatalf(\"candidate count = %d, want %d builtins only\", len(got), len(builtinOrder))\n98|\t}\n99|\n100|\tcfg := fakeConfig()\n101|\tcfg.AllowPathPlugins = true\n102|\tgot, err = Discover(cfg, fakeOwner(), fake)\n103|\tif err != nil {\n104|\t\tt.Fatalf(\"Discover with PATH allowed: %v\", err)\n105|\t}\n106|\tfound := false\n107|\tfor _, candidate := range got {\n108|\t\tif candidate.ID() == \"pathtool\" && candidate.Source() == \"path\" {\n109|\t\t\tfound = true\n110|\t\t}\n111|\t}\n112|\tif !found {\n113|\t\tt.Fatalf(\"PATH candidate missing when allow_path_plugins is true: %v\", got)\n114|\t}\n115|}\n116|\n117|// TestDiscoverRecordsTrustFacts proves every accepted external candidate\n118|// carries the Section 7.1 trust-time facts: canonical path, digest, and\n119|// approving owner.\n120|func TestDiscoverRecordsTrustFacts(t *testing.T) {\n121|\tfake := newFakeSystem()\n122|\tfake.addLinkedFile(\"/plugins\", \"ax-provider-foo\", \"/opt/real/foo\", []byte(\"bytes\"), fakeUID, true)\n123|\n124|\tgot, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), fake)\n125|\tif err != nil {\n126|\t\tt.Fatalf(\"Discover: %v\", err)\n127|\t}\n128|\tvar foo *Candidate\n129|\tfor i, candidate := range got {\n130|\t\tif candidate.ID() == \"foo\" {\n131|\t\t\tfoo = &got[i]\n132|\t\t}\n133|\t}\n134|\tif foo == nil {\n135|\t\tt.Fatalf(\"external candidate foo missing: %v\", got)\n136|\t}\n137|\tsource, ok := foo.SourcePath()\n138|\tif !ok || source != \"/plugins/ax-provider-foo\" {\n139|\t\tt.Fatalf(\"SourcePath = %q, %v; want /plugins/ax-provider-foo, true\", source, ok)\n140|\t}\n141|\tcanon, ok := foo.CanonicalPath()\n142|\tif !ok || canon != \"/opt/real/foo\" {\n143|\t\tt.Fatalf(\"CanonicalPath = %q, %v; want /opt/real/foo, true\", canon, ok)\n144|\t}\n145|\tdigest, ok := foo.Digest()\n146|\tif !ok {\n147|\t\tt.Fatal(\"Digest reports absence for an external candidate\")\n148|\t}\n149|\twant := scalar.SHA256Digest([]byte(\"bytes\"))\n150|\tif digest != want {\n151|\t\tt.Fatalf(\"Digest = %v, want %v\", digest, want)\n152|\t}\n153|\towner, ok := foo.Owner()\n154|\tif !ok || owner != \"uid:1000\" {\n155|\t\tt.Fatalf(\"Owner = %q, %v; want uid:1000, true\", owner, ok)\n156|\t}\n157|}\n158|\n159|// TestDiscoverIgnoresNonCandidateEntries proves the prefix boundary: names\n160|// without the ax-provider- prefix are skipped, including the bare prefix\n161|// stem itself.\n162|func TestDiscoverIgnoresNonCandidateEntries(t *testing.T) {\n163|\tfake := newFakeSystem()\n164|\tfake.entries[\"/plugins\"] = []string{\"README.md\", \"ax-provider\", \"other-tool\"}\n165|\tfake.canon[\"/plugins/other-tool\"] = \"/plugins/other-tool\"\n166|\tfake.canon[\"/plugins/README.md\"] = \"/plugins/README.md\"\n167|\tfake.canon[\"/plugins/ax-provider\"] = \"/plugins/ax-provider\"\n168|\tfake.canon[\"/plugins/ax-provider-foo.bak\"] = \"/plugins/ax-provider-foo.bak\"\n169|\n170|\tgot, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), fake)\n171|\tif err != nil {\n172|\t\tt.Fatalf(\"Discover: %v\", err)\n173|\t}\n174|\tfor _, candidate := range got {\n175|\t\tif candidate.Kind() == KindExternal {\n176|\t\t\tt.Fatalf(\"non-candidate entry admitted as %q\", candidate.ID())\n177|\t\t}\n178|\t}\n179|}\n180|\n181|// TestDiscoverRefusesMalformedNames narrows the grammar gate across the\n182|// provider-id boundary: uppercase, leading dash, empty, and overlong\n183|// suffixes fail, each with invalid_config.\n184|func TestDiscoverRefusesMalformedNames(t *testing.T) {\n185|\tfor _, name := range []string{\n186|\t\t\"ax-provider-ABC\",\n187|\t\t\"ax-provider--lead\",\n188|\t\t\"ax-provider-\",\n189|\t\t\"ax-provider-foo.bak\",\n190|\t\t\"ax-provider-has space\",\n191|\t\t\"ax-provider-012345678901234567890123456789012\",\n192|\t} {\n193|\t\tfake := newFakeSystem()\n194|\t\tfake.entries[\"/plugins\"] = []string{name}\n195|\t\tfake.canon[\"/plugins/\"+name] = \"/plugins/\" + name\n196|\t\t_, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), fake)\n197|\t\tif err == nil {\n198|\t\t\tt.Fatalf(\"Discover(%q) succeeded, want invalid_config\", name)\n199|\t\t}\n200|\t\tif code := errorCode(t, err); code != codeInvalidConfig {\n201|\t\t\tt.Fatalf(\"Discover(%q) code = %q, want invalid_config\", name, code)\n202|\t\t}\n203|\t}\n204|}\n205|\n206|// TestDiscoverRefusesNonRegularTargets proves the Section 7.1 regular-file\n207|// rule in both direct and symlinked form.\n208|func TestDiscoverRefusesNonRegularTargets(t *testing.T) {\n209|\tt.Run(\"directory entry\", func(t *testing.T) {\n210|\t\tfake := newFakeSystem()\n211|\t\tfake.addLinkedFile(\"/plugins\", \"ax-provider-odd\", \"/opt/real/odd\", []byte(\"x\"), fakeUID, false)\n212|\t\t_, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), fake)\n213|\t\tif err == nil {\n214|\t\t\tt.Fatal(\"Discover admitted a directory target, want invalid_config\")\n215|\t\t}\n216|\t\tif code := errorCode(t, err); code != codeInvalidConfig {\n217|\t\t\tt.Fatalf(\"code = %q, want invalid_config\", code)\n218|\t\t}\n219|\t})\n220|\tt.Run(\"symlink to directory\", func(t *testing.T) {\n221|\t\tfake := newFakeSystem()\n222|\t\tfake.entries[\"/plugins\"] = []string{\"ax-provider-linkdir\"}\n223|\t\tfake.canon[\"/plugins/ax-provider-linkdir\"] = \"/opt/dirs/linkdir\"\n224|\t\tfake.files[\"/opt/dirs/linkdir\"] = fakeFile{content: nil, uid: fakeUID, regular: false}\n225|\t\t_, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), fake)\n226|\t\tif err == nil {\n227|\t\t\tt.Fatal(\"Discover admitted a symlink-to-directory, want invalid_config\")\n228|\t\t}\n229|\t})\n230|}\n231|\n232|// TestDiscoverRefusesUnapprovedOwners narrows the ownership gate: the same\n233|// bytes are refused under a foreign UID, admitted under the operator UID,\n234|// and admitted under an administrator-approved UID.\n235|func TestDiscoverRefusesUnapprovedOwners(t *testing.T) {\n236|\tsetup := func() *fakeSystem {\n237|\t\tfake := newFakeSystem()\n238|\t\tfake.addFile(\"/plugins\", \"ax-provider-foo\", []byte(\"x\"), foreignUID)\n239|\t\treturn fake\n240|\t}\n241|\tif _, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), setup()); err == nil {\n242|\t\tt.Fatal(\"Discover admitted a foreign-owned executable, want invalid_config\")\n243|\t} else if code := errorCode(t, err); code != codeInvalidConfig {\n244|\t\tt.Fatalf(\"code = %q, want invalid_config\", code)\n245|\t}\n246|\tif _, err := Discover(fakeConfig(\"/plugins\"), OwnerPolicy{OperatorUID: foreignUID}, setup()); err != nil {\n247|\t\tt.Fatalf(\"Discover refused the operator-owned executable: %v\", err)\n248|\t}\n249|\tadmin := OwnerPolicy{OperatorUID: fakeUID, AdministratorUIDs: []uint32{foreignUID}}\n250|\tif _, err := Discover(fakeConfig(\"/plugins\"), admin, setup()); err != nil {\n251|\t\tt.Fatalf(\"Discover refused the administrator-approved executable: %v\", err)\n252|\t}\n253|\tnoRootException := OwnerPolicy{OperatorUID: fakeUID}\n254|\tif _, err := Discover(fakeConfig(\"/plugins\"), noRootException, setup()); err == nil {\n255|\t\tt.Fatal(\"Discover admitted foreign UID without an explicit approval, want refusal\")\n256|\t}\n257|}\n258|\n259|// TestDiscoverRefusesRelativePluginDir proves relative configured\n260|// directories fail closed instead of resolving against an ambient working\n261|// directory. The gate is narrowed across the index domain: a relative entry\n262|// at any position refuses, so narrowing the check to index 0 alone reddens.\n263|// The production entry point is Discover.\n264|func TestDiscoverRefusesRelativePluginDir(t *testing.T) {\n265|\tfor _, dirs := range [][]string{\n266|\t\t{\"relative/plugins\"},\n267|\t\t{\"/abs/plugins\", \"relative/plugins\"},\n268|\t\t{\"/abs/a\", \"/abs/b\", \"relative/deep\"},\n269|\t} {\n270|\t\tfake := newFakeSystem()\n271|\t\t// Absolute entries resolve to an empty directory so discovery\n272|\t\t// reaches the relative entry it must refuse.\n273|\t\tfor _, dir := range dirs {\n274|\t\t\tif len(dir) > 0 && dir[0] == '/' {\n275|\t\t\t\tfake.entries[dir] = []string{}\n276|\t\t\t}\n277|\t\t}\n278|\t\t_, err := Discover(fakeConfig(dirs...), fakeOwner(), fake)\n279|\t\tif err == nil {\n280|\t\t\tt.Fatalf(\"Discover accepted relative plugin_dirs entry in %q, want invalid_config\", dirs)\n281|\t\t}\n282|\t\tif code := errorCode(t, err); code != codeInvalidConfig {\n283|\t\t\tt.Fatalf(\"Discover(plugin_dirs=%q) code = %q, want invalid_config\", dirs, code)\n284|\t\t}\n285|\t\tif detail := errorDetail(t, err); !strings.Contains(detail, \"not an absolute path\") {\n286|\t\t\tt.Fatalf(\"detail does not name the absolute-path refusal: %q\", detail)\n287|\t\t}\n288|\t}\n289|}\n290|\n291|// TestDiscoverRefusesPartialReads proves a failed or partial read is never\n292|// a legitimate absence: each seam failure aborts discovery with\n293|// local_precondition_failed rather than a narrowed candidate set.\n294|func TestDiscoverRefusesPartialReads(t *testing.T) {\n295|\tt.Run(\"unreadable directory\", func(t *testing.T) {\n296|\t\tfake := newFakeSystem()\n297|\t\tfake.readDirErr[\"/plugins\"] = errors.New(\"permission denied\")\n298|\t\t_, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), fake)\n299|\t\tif code := errorCode(t, err); code != codeLocalPrecondition {\n300|\t\t\tt.Fatalf(\"code = %q, want local_precondition_failed\", code)\n301|\t\t}\n302|\t})\n303|\tt.Run(\"unresolvable symlink\", func(t *testing.T) {\n304|\t\tfake := newFakeSystem()\n305|\t\tfake.entries[\"/plugins\"] = []string{\"ax-provider-dangling\"}\n306|\t\tfake.canonErr[\"/plugins/ax-provider-dangling\"] = errors.New(\"no such file\")\n307|\t\t_, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), fake)\n308|\t\tif code := errorCode(t, err); code != codeLocalPrecondition {\n309|\t\t\tt.Fatalf(\"code = %q, want local_precondition_failed\", code)\n310|\t\t}\n311|\t})\n312|\tt.Run(\"uninspectable target\", func(t *testing.T) {\n313|\t\tfake := newFakeSystem()\n314|\t\tfake.entries[\"/plugins\"] = []string{\"ax-provider-foo\"}\n315|\t\tfake.canon[\"/plugins/ax-provider-foo\"] = \"/opt/real/foo\"\n316|\t\tfake.inspectErr[\"/opt/real/foo\"] = errors.New(\"stale handle\")\n317|\t\t_, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), fake)\n318|\t\tif code := errorCode(t, err); code != codeLocalPrecondition {\n319|\t\t\tt.Fatalf(\"code = %q, want local_precondition_failed\", code)\n320|\t\t}\n321|\t})\n322|\tt.Run(\"undigestible target\", func(t *testing.T) {\n323|\t\tfake := newFakeSystem()\n324|\t\tfake.entries[\"/plugins\"] = []string{\"ax-provider-foo\"}\n325|\t\tfake.canon[\"/plugins/ax-provider-foo\"] = \"/opt/real/foo\"\n326|\t\tfake.files[\"/opt/real/foo\"] = fakeFile{content: []byte(\"x\"), uid: fakeUID, regular: true}\n327|\t\tfake.contentErr[\"/opt/real/foo\"] = errors.New(\"input/output error\")\n328|\t\t_, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), fake)\n329|\t\tif code := errorCode(t, err); code != codeLocalPrecondition {\n330|\t\t\tt.Fatalf(\"code = %q, want local_precondition_failed\", code)\n331|\t\t}\n332|\t})\n333|\tt.Run(\"cause is preserved\", func(t *testing.T) {\n334|\t\tfake := newFakeSystem()\n335|\t\tcause := errors.New(\"disk gone\")\n336|\t\tfake.readDirErr[\"/plugins\"] = cause\n337|\t\t_, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), fake)\n338|\t\tif !errors.Is(err, cause) {\n339|\t\t\tt.Fatalf(\"precondition error does not wrap its cause: %v\", err)\n340|\t\t}\n341|\t})\n342|}\n343|\n344|// TestBuiltinCandidatesCarryNoTrustFacts proves builtins are adapters, not\n345|// executables: every trust accessor reports absence.\n346|func TestBuiltinCandidatesCarryNoTrustFacts(t *testing.T) {\n347|\tgot, err := Discover(fakeConfig(), fakeOwner(), newFakeSystem())\n348|\tif err != nil {\n349|\t\tt.Fatalf(\"Discover: %v\", err)\n350|\t}\n351|\tif len(got) != len(builtinOrder) {\n352|\t\tt.Fatalf(\"builtin count = %d, want %d\", len(got), len(builtinOrder))\n353|\t}\n354|\tfor _, candidate := range got {\n355|\t\tif candidate.Kind() != KindBuiltin {\n356|\t\t\tt.Fatalf(\"candidate %q kind = %q, want builtin\", candidate.ID(), candidate.Kind())\n357|\t\t}\n358|\t\tif _, ok := candidate.SourcePath(); ok {\n359|\t\t\tt.Fatalf(\"builtin %q reports a source path\", candidate.ID())\n360|\t\t}\n361|\t\tif _, ok := candidate.CanonicalPath(); ok {\n362|\t\t\tt.Fatalf(\"builtin %q reports a canonical path\", candidate.ID())\n363|\t\t}\n364|\t\tif _, ok := candidate.Digest(); ok {\n365|\t\t\tt.Fatalf(\"builtin %q reports a digest\", candidate.ID())\n366|\t\t}\n367|\t\tif _, ok := candidate.Owner(); ok {\n368|\t\t\tt.Fatalf(\"builtin %q reports an owner\", candidate.ID())\n369|\t\t}\n370|\t}\n371|}"}}}
