atalf(\"Symlink: %v\", err)\n92|\t\t}\n93|\t\tdefer func() {\n94|\t\t\tos.Remove(source)\n95|\t\t\tos.Symlink(target, source)\n96|\t\t}()\n97|\t\tif err := Verify(record, owner, system); err == nil {\n98|\t\t\tt.Fatal(\"Verify accepted a retargeted symlink\")\n99|\t\t} else if code := errorCode(t, err); code != codeIntegrityFailure {\n100|\t\t\tt.Fatalf(\"code = %q, want integrity_failure\", code)\n101|\t\t}\n102|\t})\n103|\n104|\tt.Run(\"changed bytes require renewed trust\", func(t *testing.T) {\n105|\t\tif err := os.WriteFile(target, []byte(\"#!/bin/sh\\nexit 2\\n\"), 0o700); err != nil {\n106|\t\t\tt.Fatalf(\"WriteFile: %v\", err)\n107|\t\t}\n108|\t\tdefer os.WriteFile(target, content, 0o700)\n109|\t\tif err := Verify(record, owner, system); err == nil {\n110|\t\t\tt.Fatal(\"Verify accepted changed bytes\")\n111|\t\t}\n112|\t})\n113|\n114|\tt.Run(\"non-regular replacement requires renewed trust\", func(t *testing.T) {\n115|\t\tplain := filepath.Join(plugindir, \"ax-provider-plain\")\n116|\t\tif err := os.WriteFile(plain, []byte(\"x\"), 0o600); err != nil {\n117|\t\t\tt.Fatalf(\"WriteFile: %v\", err)\n118|\t\t}\n119|\t\tplainCandidates, err := Discover(Config{Platform: scalar.PlatformLinux, PluginDirs: []string{plugindir}}, owner, system)\n120|\t\tif err != nil {\n121|\t\t\tt.Fatalf(\"Discover: %v\", err)\n122|\t\t}\n123|\t\tvar plainCandidate *Candidate\n124|\t\tfor i := range plainCandidates {\n125|\t\t\tif plainCandidates[i].ID() == \"plain\" {\n126|\t\t\t\tplainCandidate = &plainCandidates[i]\n127|\t\t\t}\n128|\t\t}\n129|\t\tif plainCandidate == nil {\n130|\t\t\tt.Fatal(\"candidate plain missing\")\n131|\t\t}\n132|\t\tplainRecord, err := Trust(*plainCandidate, mustTimestamp(t, trustInstant))\n133|\t\tif err != nil {\n134|\t\t\tt.Fatalf(\"Trust: %v\", err)\n135|\t\t}\n136|\t\tif err := os.Remove(plain); err != nil {\n137|\t\t\tt.Fatalf(\"Remove: %v\", err)\n138|\t\t}\n139|\t\tif err := os.Mkdir(plain, 0o755); err != nil {\n140|\t\t\tt.Fatalf(\"Mkdir: %v\", err)\n141|\t\t}\n142|\t\tdefer os.Remove(plain)\n143|\t\tif err := Verify(plainRecord, owner, system); err == nil {\n144|\t\t\tt.Fatal(\"Verify accepted a directory replacement\")\n145|\t\t}\n146|\t})\n147|\n148|\tt.Run(\"direct executable without symlink\", func(t *testing.T) {\n149|\t\tdirect := filepath.Join(plugindir, \"ax-provider-direct\")\n150|\t\tif err := os.WriteFile(direct, []byte(\"direct\"), 0o700); err != nil {\n151|\t\t\tt.Fatalf(\"WriteFile: %v\", err)\n152|\t\t}\n153|\t\tdefer os.Remove(direct)\n154|\t\tresolved, err := filepath.EvalSymlinks(direct)\n155|\t\tif err != nil {\n156|\t\t\tt.Fatalf(\"EvalSymlinks: %v\", err)\n157|\t\t}\n158|\t\tdirectCandidates, err := Discover(Config{Platform: scalar.PlatformLinux, PluginDirs: []string{plugindir}}, owner, system)\n159|\t\tif err != nil {\n160|\t\t\t// The tree now also holds mytool/plain fixtures; a duplicate\n161|\t\t\t// or refusal from an unrelated fixture must not mask this\n162|\t\t\t// case, so report it plainly.\n163|\t\t\tt.Fatalf(\"Discover: %v\", err)\n164|\t\t}\n165|\t\tfor _, found := range directCandidates {\n166|\t\t\tif found.ID() == \"direct\" {\n167|\t\t\t\tcanon, _ := found.CanonicalPath()\n168|\t\t\t\tif canon != resolved {\n169|\t\t\t\t\tt.Fatalf(\"CanonicalPath = %q, want %q\", canon, resolved)\n170|\t\t\t\t}\n171|\t\t\t\treturn\n172|\t\t\t}\n173|\t\t}\n174|\t\tt.Fatal(\"candidate direct missing\")\n175|\t})\n176|}\n177|\n178|// TestOSSystemRefusesRelativePATHDir drives the PATH absolute-directory\n179|// gate through the production OSSystem: a relative PATH entry fails with\n180|// invalid_config instead of resolving against the process working\n181|// directory.\n182|func TestOSSystemRefusesRelativePATHDir(t *testing.T) {\n183|\tt.Setenv(\"PATH\", \".\"+string(os.PathListSeparator)+\"/definitely-absent-ax-provider-dir\")\n184|\t_, err := Discover(\n185|\t\tConfig{Platform: scalar.PlatformLinux, AllowPathPlugins: true},\n186|\t\tCurrentOperatorPolicy(),\n187|\t\tOSSystem{},\n188|\t)\n189|\tif err == nil {\n190|\t\tt.Fatal(\"Discover accepted a relative PATH entry, want invalid_config\")\n191|\t}\n192|\tif code := errorCode(t, err); code != codeInvalidConfig {\n193|\t\tt.Fatalf(\"code = %q, want invalid_config\", code)\n194|\t}\n195|}\n196|\n197|// TestOSSystemDuplicateNeverExecutes is the behavioral half of the Section\n198|// 7.1 ordering guarantee on the production seam: a duplicate fixture\n199|// containing a live shell script that marks a sentinel file fails\n200|// discovery with invalid_config and leaves the sentinel absent.\n201|func TestOSSystemDuplicateNeverExecutes(t *testing.T) {\n202|\troot := t.TempDir()\n203|\tplugindir := filepath.Join(root, \"plugins\")\n204|\tif err := os.MkdirAll(plugindir, 0o755); err != nil {\n205|\t\tt.Fatalf(\"MkdirAll: %v\", err)\n206|\t}\n207|\tsentinel := filepath.Join(root, \"executed\")\n208|\tscript := []byte(\"#!/bin/sh\\necho executed >> \" + sentinel + \"\\n\")\n209|\twriteExecutable(t, plugindir, \"ax-provider-codex\", script)\n210|\n211|\t_, err := Discover(\n212|\t\tConfig{Platform: scalar.PlatformLinux, PluginDirs: []string{plugindir}},\n213|\t\tCurrentOperatorPolicy(),\n214|\t\tOSSystem{},\n215|\t)\n216|\tif err == nil {\n217|\t\tt.Fatal(\"Discover admitted a builtin-shadowing executable\")\n218|\t}\n219|\tif code := errorCode(t, err); code != codeInvalidConfig {\n220|\t\tt.Fatalf(\"code = %q, want invalid_config\", code)\n221|\t}\n222|\tif _, statErr := os.Stat(sentinel); !os.IsNotExist(statErr) {\n223|\t\tt.Fatalf(\"duplicate candidate was executed; sentinel present: %v\", statErr)\n224|\t}\n225|}\n226|\n227|// TestOSSystemPATHDiscovery drives the PATH source through the production\n228|// seam with an isolated PATH: discovery finds the tool when allowed,\n229|// ignores PATH when disallowed, and refuses duplicates across PATH\n230|// directories.\n231|func TestOSSystemPATHDiscovery(t *testing.T) {\n232|\troot, err := filepath.EvalSymlinks(t.TempDir())\n233|\tif err != nil {\n234|\t\tt.Fatalf(\"EvalSymlinks: %v\", err)\n235|\t}\n236|\tfirst := filepath.Join(root, \"bin1\")\n237|\tsecond := filepath.Join(root, \"bin2\")\n238|\tfor _, dir := range []string{first, second} {\n239|\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n240|\t\t\tt.Fatalf(\"MkdirAll: %v\", err)\n241|\t\t}\n242|\t}\n243|\twriteExecutable(t, first, \"ax-provider-pathtool\", []byte(\"p1\"))\n244|\tt.Setenv(\"PATH\", first+string(os.PathListSeparator)+second)\n245|\n246|\tsystem := OSSystem{}\n247|\towner := CurrentOperatorPolicy()\n248|\n249|\tallowed := Config{Platform: scalar.PlatformLinux, AllowPathPlugins: true}\n250|\tgot, err := Discover(allowed, owner, system)\n251|\tif err != nil {\n252|\t\tt.Fatalf(\"Discover: %v\", err)\n253|\t}\n254|\tfound := false\n255|\tfor _, candidate := range got {\n256|\t\tif candidate.ID() == \"pathtool\" && candidate.Source() == \"path\" {\n257|\t\t\tfound = true\n258|\t\t\tcanon, _ := candidate.CanonicalPath()\n259|\t\t\tif !strings.HasPrefix(canon, first) {\n260|\t\t\t\tt.Fatalf(\"CanonicalPath = %q, want it under %q\", canon, first)\n261|\t\t\t}\n262|\t\t}\n263|\t}\n264|\tif !found {\n265|\t\tt.Fatal(\"PATH candidate missing when allow_path_plugins is true\")\n266|\t}\n267|\n268|\tdenied, err := Discover(Config{Platform: scalar.PlatformLinux}, owner, system)\n269|\tif err != nil {\n270|\t\tt.Fatalf(\"Discover: %v\", err)\n271|\t}\n272|\tfor _, candidate := range denied {\n273|\t\tif candidate.ID() == \"pathtool\" {\n274|\t\t\tt.Fatal(\"PATH candidate admitted while allow_path_plugins is false\")\n275|\t\t}\n276|\t}\n277|\n278|\twriteExecutable(t, second, \"ax-provider-pathtool\", []byte(\"p2\"))\n279|\tif _, err := Discover(allowed, owner, system); err == nil {\n280|\t\tt.Fatal(\"Discover admitted one ID from two PATH directories\")\n281|\t} else if code := errorCode(t, err); code != codeInvalidConfig {\n282|\t\tt.Fatalf(\"code = %q, want invalid_config\", code)\n283|\t}\n284|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c505","stream":{"kind":"session","id":"01a06eb9-cab4-7c32-a1f1-2b4dbf5b926f"},"sequence":221,"recorded_at":1780531400000437,"record_type":"event","durability":"durable","causation_id":"9dbf4a98-925e-4730-ae52-9862c9470765","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"9dbf4a98-925e-4730-ae52-9862c9470765","run_stream":{"kind":"run","id":"9dbf4a98-925e-4730-ae52-9862c9470765"},"call_id":"call_01a06eba24767530a2f8dcaaa3e5c49c","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provider/os_windows.go`.\n1|//go:build windows\n2|\n3|package provider\n4|\n5|import (\n6|\t\"fmt\"\n7|\t\"os\"\n8|)\n9|\n10|// fileOwnerUID refuses owner attestation on native Windows: no UID model\n11|// exists there, and an unapproved owner must fail closed. External\n12|// executables are therefore undiscoverable on native Windows until a\n13|// Windows owner model lands; built-in adapters are unaffected because they\n14|// carry no executable trust facts.\n15|func fileOwnerUID(info os.FileInfo) (uint32, error) {\n16|\treturn 0, fmt.Errorf(\"provider owner attestation: native Windows owner model is not implemented\")\n17|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c507","stream":{"kind":"session","id":"01a06eb9-cab4-7c32-a1f1-2b4dbf5b926f"},"sequence":222,"recorded_at":1780531400000439,"record_type":"event","durability":"durable","causation_id":"9dbf4a98-925e-4730-ae52-9862c9470765","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"9dbf4a98-925e-4730-ae52-9862c9470765","run_stream":{"kind":"run","id":"9dbf4a98-925e-4730-ae52-9862c9470765"},"call_id":"call_01a06eba25317870a24f3addf2738fad","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provider/enumeration_test.go`.\n1|package provider\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"strings\"\n10|\t\"testing\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n15|)\n16|\n17|// sectionLines joins the pinned document lines for section 7.1, failing\n18|// when the section boundaries move. Every citation below resolves against\n19|// the real text, never against a restatement in this repository.\n20|func sectionLines(t *testing.T, document *specdoc.Document, section string, first, last int) string {\n21|\tt.Helper()\n22|\tfor _, line := range []int{first, last} {\n23|\t\tgot, ok := document.SectionID(line)\n24|\t\tif !ok || got != section {\n25|\t\t\tt.Fatalf(\"SPEC.md line %d is in section %q, want %q\", line, got, section)\n26|\t\t}\n27|\t}\n28|\tvar body strings.Builder\n29|\tfor line := first; line <= last; line++ {\n30|\t\ttext, ok := document.Line(line)\n31|\t\tif !ok {\n32|\t\t\tt.Fatalf(\"SPEC.md line %d is missing\", line)\n33|\t\t}\n34|\t\tbody.WriteString(text)\n35|\t\tbody.WriteString(\"\\n\")\n36|\t}\n37|\treturn body.String()\n38|}\n39|\n40|// requireQuote asserts the excerpt occurs verbatim in the pinned document\n41|// and begins on a line inside the cited section.\n42|func requireQuote(t *testing.T, document *specdoc.Document, excerpt, section string) {\n43|\tt.Helper()\n44|\tif !document.Contains(excerpt) {\n45|\t\tt.Fatalf(\"pinned document does not contain %q\", excerpt)\n46|\t}\n47|\tlines := document.QuoteLines(excerpt)\n48|\tif len(lines) == 0 {\n49|\t\tt.Fatalf(\"pinned document quotes no line for %q\", excerpt)\n50|\t}\n51|\tgot, ok := document.SectionID(lines[0])\n52|\tif !ok || got != section {\n53|\t\tt.Fatalf(\"%q begins on SPEC.md line %d in section %q, want %q\", excerpt, lines[0], got, section)\n54|\t}\n55|\tt.Logf(\"%q begins on SPEC.md line %d\", excerpt, lines[0])\n56|}\n57|\n58|// TestSection71BuiltinRegistryIsDocumentOrder proves the builtin registry\n59|// enumerates exactly the six Section 7.1 built-ins in the section's listed\n60|// order. The order is derived from the pinned text: each name's first\n61|// tagged occurrence inside Section 7.1 must appear in registry order.\n62|func TestSection71BuiltinRegistryIsDocumentOrder(t *testing.T) {\n63|\tdocument, err := specdoc.Load()\n64|\tif err != nil {\n65|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n66|\t}\n67|\twindow := sectionLines(t, document, \"7.1\", 2622, 2653)\n68|\tnames := []string{\"codex\", \"claude\", \"gemini\", \"muse\", \"antigravity\", \"pi\"}\n69|\tprevious := -1\n70|\tfor _, name := range names {\n71|\t\toffset := strings.Index(window, \"<code>\"+name+\"</code>\")\n72|\t\tif offset == -1 {\n73|\t\t\tt.Fatalf(\"Section 7.1 does not list builtin %q\", name)\n74|\t\t}\n75|\t\tif offset <= previous {\n76|\t\t\tt.Fatalf(\"Section 7.1 lists %q out of registry order\", name)\n77|\t\t}\n78|\t\tprevious = offset\n79|\t}\n80|\tgot := Builtins()\n81|\tif len(got) != len(names) {\n82|\t\tt.Fatalf(\"Builtins() = %v, want the six Section 7.1 names\", got)\n83|\t}\n84|\tfor i, name := range names {\n85|\t\tif got[i] != name {\n86|\t\t\tt.Fatalf(\"Builtins() = %v, want Section 7.1 order %v\", got, names)\n87|\t\t}\n88|\t}\n89|\trequireQuote(t, document, \"Built-in support covers\", \"7.1\")\n90|}\n91|\n92|// TestSection71DiscoveryOrderIsPinned quotes the Section 7.1 discovery\n93|// order behind Discover's source ranking and the PATH gate.\n94|func TestSection71DiscoveryOrderIsPinned(t *testing.T) {\n95|\tdocument, err := specdoc.Load()\n96|\tif err != nil {\n97|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n98|\t}\n99|\tfor _, excerpt := range []string{\n100|\t\t\"configured <code>providers.plugin_dirs</code> in listed order\",\n101|\t\t\"built-in adapters\",\n102|\t\t\"<code>PATH</code>, only when <code>allow_path_plugins</code> is true\",\n103|\t\t\"The order does not establish precedence\",\n104|\t} {\n105|\t\trequireQuote(t, document, excerpt, \"7.1\")\n106|\t}\n107|}\n108|\n109|// TestSection71DuplicateRefusalIsPinned quotes the duplicate rule and its\n110|// mandated code behind the duplicate refusal.\n111|func TestSection71DuplicateRefusalIsPinned(t *testing.T) {\n112|\tdocument, err := specdoc.Load()\n113|\tif err != nil {\n114|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n115|\t}\n116|\trequireQuote(t, document,\n117|\t\t\"discovery MUST fail with <code>invalid_config</code> before either candidate is probed or executed\",\n118|\t\t\"7.1\")\n119|\trequireQuote(t, document, \"the operator must remove or rename one candidate\", \"7.1\")\n120|}\n121|\n122|// TestSection71TrustRulesArePinned quotes the trust recording, symlink,\n123|// regular-file, ownership, and renewed-trust rules behind Trust and\n124|// Verify.\n125|func TestSection71TrustRulesArePinned(t *testing.T) {\n126|\tdocument, err := specdoc.Load()\n127|\tif err != nil {\n128|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n129|\t}\n130|\tfor _, excerpt := range []string{\n131|\t\t\"External provider executables are named <code>ax-provider-&lt;id&gt;</code>\",\n132|\t\t\"<code>id</code> matches <code>[a-z][a-z0-9-]{0,31}</code>\",\n133|\t\t\"the canonical absolute executable path and SHA-256 digest MUST be recorded at trust time\",\n134|\t\t\"Symlinks MUST be resolved before comparison\",\n135|\t\t\"the target MUST be a regular file owned by the operator or an administrator-approved identity\",\n136|\t\t\"a changed path target or digest MUST require renewed trust\",\n137|\t\t\"they MUST receive only the minimum operation-specific inputs\",\n138|\t} {\n139|\t\trequireQuote(t, document, excerpt, \"7.1\")\n140|\t}\n141|}\n142|\n143|// TestSection71AdvertisesNoPublicSDK quotes the M0 non-advertisement rule\n144|// and proves the package honors it structurally: no exported symbol name\n145|// offers an SDK, client, stable, or public surface.\n146|func TestSection71AdvertisesNoPublicSDK(t *testing.T) {\n147|\tdocument, err := specdoc.Load()\n148|\tif err != nil {\n149|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n150|\t}\n151|\trequireQuote(t, document, \"M0 MUST NOT advertise a public stable plugin SDK\", \"7.1\")\n152|\tfor _, symbol := range exportedSymbols(t) {\n153|\t\tlowered := strings.ToLower(symbol)\n154|\t\tfor _, banned := range []string{\"sdk\", \"stable\", \"public\", \"client\"} {\n155|\t\t\tif strings.Contains(lowered, banned) {\n156|\t\t\t\tt.Fatalf(\"exported symbol %q advertises a public SDK surface\", symbol)\n157|\t\t\t}\n158|\t\t}\n159|\t}\n160|}\n161|\n162|// TestCandidatesAdvertiseNoCapability proves discovery never advertises\n163|// what the probe plane has not proven: no Candidate or TrustRecord member\n164|// carries availability, status, enabled, support, or capability state. The\n165|// member list is derived from package source, never hand-listed.\n166|func TestCandidatesAdvertiseNoCapability(t *testing.T) {\n167|\tmembers := structMembers(t, \"Candidate\", \"TrustRecord\")\n168|\tfor member, typ := range members {\n169|\t\tlowered := strings.ToLower(member)\n170|\t\tfor _, banned := range []string{\"availab\", \"status\", \"enabled\", \"support\", \"capab\"} {\n171|\t\t\tif strings.Contains(lowered, banned) {\n172|\t\t\t\tt.Fatalf(\"member %q (%s) advertises capability state\", member, typ)\n173|\t\t\t}\n174|\t\t}\n175|\t}\n176|\tif len(members) == 0 {\n177|\t\tt.Fatal(\"derived no candidate members; the scan is blind\")\n178|\t}\n179|\tt.Logf(\"scanned %d Candidate/TrustRecord members, none carries capability state\", len(members))\n180|}\n181|\n182|// TestDiscoveryReachesNoProcess proves the ordering guarantee behind the\n183|// duplicate refusal: no package source imports a process-execution\n184|// facility, so Discover cannot probe or execute a candidate. The import\n185|// list is derived from package source.\n186|func TestDiscoveryReachesNoProcess(t *testing.T) {\n187|\tfileset := token.NewFileSet()\n188|\tdirectory, err := os.Getwd()\n189|\tif err != nil {\n190|\t\tt.Fatalf(\"Getwd: %v\", err)\n191|\t}\n192|\tentries, err := os.ReadDir(directory)\n193|\tif err != nil {\n194|\t\tt.Fatalf(\"ReadDir: %v\", err)\n195|\t}\n196|\tfound := false\n197|\tfor _, entry := range entries {\n198|\t\tname := entry.Name()\n199|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n200|\t\t\tcontinue\n201|\t\t}\n202|\t\tfound = true\n203|\t\tsource, err := os.ReadFile(filepath.Join(directory, name))\n204|\t\tif err != nil {\n205|\t\t\tt.Fatalf(\"ReadFile(%s): %v\", name, err)\n206|\t\t}\n207|\t\tsyntax, err := parser.ParseFile(fileset, name, source, parser.ImportsOnly)\n208|\t\tif err != nil {\n209|\t\t\tt.Fatalf(\"ParseFile(%s): %v\", name, err)\n210|\t\t}\n211|\t\tfor _, clause := range syntax.Imports {\n212|\t\t\tpath := strings.Trim(clause.Path.Value, `\"`)\n213|\t\t\tif path == \"os/exec\" || strings.HasPrefix(path, \"os/exec/\") {\n214|\t\t\t\tt.Fatalf(\"%s imports process execution (%s)\", name, path)\n215|\t\t\t}\n216|\t\t}\n217|\t}\n218|\tif !found {\n219|\t\tt.Fatal(\"scanned no production sources; the check is blind\")\n220|\t}\n221|}\n222|\n223|// TestStableCodesAreRegistered pins every refusal code this package emits\n224|// against the pinned error registry and the exact exit status the host\n225|// surfaces: invalid_config and local_precondition_failed exit 3,\n226|// integrity_failure exits 9.\n227|func TestStableCodesAreRegistered(t *testing.T) {\n228|\tregistered := map[string]int{}\n229|\tfor _, row := range catalog.Current().Errors {\n230|\t\tregistered[string(row.Code)] = row.ExitCode\n231|\t}\n232|\tfor code, wantExit := range map[string]int{\n233|\t\tcodeInvalidConfig:     3,\n234|\t\tcodeLocalPrecondition: 3,\n235|\t\tcodeIntegrityFailure:  9,\n236|\t} {\n237|\t\tgotExit, ok := registered[code]\n238|\t\tif !ok {\n239|\t\t\tt.Fatalf(\"code %q is not in the pinned error registry\", code)\n240|\t\t}\n241|\t\tif gotExit != wantExit {\n242|\t\t\tt.Fatalf(\"code %q exit = %d, want %d\", code, gotExit, wantExit)\n243|\t\t}\n244|\t\tgotWire, err := axerror.ExitCodeFor(axerror.Version100, axerror.Code(code))\n245|\t\tif err != nil {\n246|\t\t\tt.Fatalf(\"ExitCodeFor(1.0.0, %q): %v\", code, err)\n247|\t\t}\n248|\t\tif gotWire != wantExit {\n249|\t\t\tt.Fatalf(\"wire exit for %q = %d, want %d\", code, gotWire, wantExit)\n250|\t\t}\n251|\t}\n252|\tt.Logf(\"refusal code coverage: 3/3 package codes registered with pinned exits\")\n253|}\n254|\n255|// exportedSymbols derives every exported top-level symbol name from\n256|// package source.\n257|func exportedSymbols(t *testing.T) []string {\n258|\tt.Helper()\n259|\tvar out []string\n260|\tfor _, syntax := range parseProductionSources(t) {\n261|\t\tfor _, decl := range syntax.Decls {\n262|\t\t\tgeneral, ok := decl.(*ast.GenDecl)\n263|\t\t\tif !ok {\n264|\t\t\t\tcontinue\n265|\t\t\t}\n266|\t\t\tfor _, spec := range general.Specs {\n267|\t\t\t\tswitch concrete := spec.(type) {\n268|\t\t\t\tcase *ast.TypeSpec:\n269|\t\t\t\t\tif ast.IsExported(concrete.Name.Name) {\n270|\t\t\t\t\t\tout = append(out, concrete.Name.Name)\n271|\t\t\t\t\t}\n272|\t\t\t\tcase *ast.ValueSpec:\n273|\t\t\t\t\tfor _, ident := range concrete.Names {\n274|\t\t\t\t\t\tif ast.IsExported(ident.Name) {\n275|\t\t\t\t\t\t\tout = append(out, ident.Name)\n276|\t\t\t\t\t\t}\n277|\t\t\t\t\t}\n278|\t\t\t\t}\n279|\t\t\t}\n280|\t\t}\n281|\t\tfor _, decl := range syntax.Decls {\n282|\t\t\tfunction, ok := decl.(*ast.FuncDecl)\n283|\t\t\tif !ok || function.Name == nil || !ast.IsExported(function.Name.Name) {\n284|\t\t\t\tcontinue\n285|\t\t\t}\n286|\t\t\tif function.Recv == nil {\n287|\t\t\t\tout = append(out, function.Name.Name)\n288|\t\t\t} else {\n289|\t\t\t\tout = append(out, function.Name.Name+\" (method)\")\n290|\t\t\t}\n291|\t\t}\n292|\t}\n293|\treturn out\n294|}\n295|\n296|// structMembers derives field names and types for the named structs from\n297|// package source.\n298|func structMembers(t *testing.T, wanted ...string) map[string]string {\n299|\tt.Helper()\n300|\twant := map[string]bool{}\n301|\tfor _, name := range wanted {\n302|\t\twant[name] = true\n303|\t}\n304|\tmembers := map[string]string{}\n305|\tfor _, syntax := range parseProductionSources(t) {\n306|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n307|\t\t\tspec, ok := node.(*ast.TypeSpec)\n308|\t\t\tif !ok || !want[spec.Name.Name] {\n309|\t\t\t\treturn true\n310|\t\t\t}\n311|\t\t\tstructure, ok := spec.Type.(*ast.StructType)\n312|\t\t\tif !ok {\n313|\t\t\t\treturn false\n314|\t\t\t}\n315|\t\t\tfor _, field := range structure.Fields.List {\n316|\t\t\t\tfor _, ident := range field.Names {\n317|\t\t\t\t\tmembers[ident.Name] = spec.Name.Name\n318|\t\t\t\t}\n319|\t\t\t}\n320|\t\t\treturn false\n321|\t\t})\n322|\t}\n323|\treturn members\n324|}\n325|\n326|// parseProductionSources parses every non-test Go source in the package\n327|// directory.\n328|func parseProductionSources(t *testing.T) map[string]*ast.File {\n329|\tt.Helper()\n330|\tdirectory, err := os.Getwd()\n331|\tif err != nil {\n332|\t\tt.Fatalf(\"Getwd: %v\", err)\n333|\t}\n334|\tentries, err := os.ReadDir(directory)\n335|\tif err != nil {\n336|\t\tt.Fatalf(\"ReadDir: %v\", err)\n337|\t}\n338|\tfileset := token.NewFileSet()\n339|\tout := map[string]*ast.File{}\n340|\tfor _, entry := range entries {\n341|\t\tname := entry.Name()\n342|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n343|\t\t\tcontinue\n344|\t\t}\n345|\t\tsource, err := os.ReadFile(filepath.Join(directory, name))\n346|\t\tif err != nil {\n347|\t\t\tt.Fatalf(\"ReadFile(%s): %v\", name, err)\n348|\t\t}\n349|\t\tsyntax, err := parser.ParseFile(fileset, name, source, parser.ParseComments)\n350|\t\tif err != nil {\n351|\t\t\tt.Fatalf(\"ParseFile(%s): %v\", name, err)\n352|\t\t}\n353|\t\tout[name] = syntax\n354|\t}\n355|\treturn out\n356|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
