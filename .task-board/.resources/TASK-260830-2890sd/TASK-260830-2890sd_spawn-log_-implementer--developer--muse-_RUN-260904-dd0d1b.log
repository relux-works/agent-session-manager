{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4b5","stream":{"kind":"session","id":"01a06eb9-cab4-7c32-a1f1-2b4dbf5b926f"},"sequence":181,"recorded_at":1780531400000357,"record_type":"event","durability":"durable","causation_id":"9dbf4a98-925e-4730-ae52-9862c9470765","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9dbf4a98-925e-4730-ae52-9862c9470765","run_stream":{"kind":"run","id":"9dbf4a98-925e-4730-ae52-9862c9470765"},"task_stream":{"kind":"task","id":"a76cfca4-90ed-4fa1-859b-3c97314de58c"},"task_id":"a76cfca4-90ed-4fa1-859b-3c97314de58c","event":{"kind":"output","task_id":"a76cfca4-90ed-4fa1-859b-3c97314de58c","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provider/provider.go`.\n1|package provider\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"crypto/subtle\"\n6|\t\"fmt\"\n7|\t\"path/filepath\"\n8|\t\"sort\"\n9|\t\"strings\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// Stable Structured Error codes this package reports. Discovery-shape\n15|// refusals (duplicates, malformed names, non-regular targets, unapproved\n16|// owners, relative directories) report invalid_config; a filesystem read\n17|// that cannot establish the discovery or verification preconditions reports\n18|// local_precondition_failed; a trust receipt that no longer matches freshly\n19|// read facts reports integrity_failure. The duplicate mapping is mandated by\n20|// Section 7.1; the other two are derived mappings documented on the\n21|// constructors, because Section 7.1 names no code for those cases.\n22|const (\n23|\tcodeInvalidConfig     = \"invalid_config\"\n24|\tcodeLocalPrecondition = \"local_precondition_failed\"\n25|\tcodeIntegrityFailure  = \"integrity_failure\"\n26|)\n27|\n28|// Error is the only error this package produces. Code carries the stable\n29|// registry code above; Detail names the offending provider ID, path, or\n30|// trust dimension in human text automation must never branch on; Cause\n31|// preserves the underlying filesystem failure for errors.Is and errors.As.\n32|type Error struct {\n33|\tcode   string\n34|\tdetail string\n35|\tcause  error\n36|}\n37|\n38|// Code reports the stable registry code for this refusal.\n39|func (err Error) Code() string { return err.code }\n40|\n41|// Detail reports the human-text detail for this refusal.\n42|func (err Error) Detail() string { return err.detail }\n43|\n44|// Unwrap exposes the underlying filesystem cause, if one was recorded.\n45|func (err Error) Unwrap() error { return err.cause }\n46|\n47|func (err Error) Error() string {\n48|\tif err.cause == nil {\n49|\t\treturn \"provider \" + err.code + \": \" + err.detail\n50|\t}\n51|\treturn \"provider \" + err.code + \": \" + err.detail + \": \" + err.cause.Error()\n52|}\n53|\n54|// The four refusal constructors below are declared as variables so the\n55|// refusal-inventory gate can observe every exercised refusal site. Each is\n56|// the single construction site for its failure class; production code must\n57|// not build Error values or wrap filesystem errors any other way.\n58|//\n59|// failDuplicate reports the Section 7.1 duplicate-ID refusal with the\n60|// section-mandated invalid_config code.\n61|//\n62|// failInvalid reports a discovery-shape refusal: a malformed plugin name, a\n63|// non-regular target, an unapproved owner, a relative directory, or a Trust\n64|// call on a builtin adapter. These are operator-configuration or caller\n65|// errors, so they share the invalid_config code.\n66|//\n67|// failPrecondition reports a filesystem read failure during discovery: an\n68|// unreadable plugin directory, an unresolvable symlink, an unreadable\n69|// target, or unattainable ownership metadata. A failed read is never a\n70|// legitimate absence, so discovery aborts with local_precondition_failed\n71|// instead of yielding a partial candidate set.\n72|//\n73|// failIntegrity reports a trust receipt that no longer matches freshly read\n74|// facts, including a receipt whose facts cannot be re-read at all: a\n75|// changed path target or digest requires renewed trust, and an unreadable\n76|// file cannot prove it is unchanged.\n77|var failDuplicate = func(providerID, firstSource, secondSource string) Error {\n78|\treturn Error{\n79|\t\tcode:   codeInvalidConfig,\n80|\t\tdetail: fmt.Sprintf(\"duplicate provider %q from %s and %s\", providerID, firstSource, secondSource),\n81|\t}\n82|}\n83|\n84|var failInvalid = func(detail string) Error {\n85|\treturn Error{code: codeInvalidConfig, detail: detail}\n86|}\n87|\n88|var failPrecondition = func(detail string, cause error) Error {\n89|\treturn Error{code: codeLocalPrecondition, detail: detail, cause: cause}\n90|}\n91|\n92|var failIntegrity = func(detail string, cause error) Error {\n93|\treturn Error{code: codeIntegrityFailure, detail: detail, cause: cause}\n94|}\n95|\n96|// Kind distinguishes a built-in adapter from an external executable.\n97|type Kind string\n98|\n99|const (\n100|\t// KindBuiltin is an adapter compiled into the host. It has no\n101|\t// executable path, digest, or owner to trust.\n102|\tKindBuiltin Kind = \"builtin\"\n103|\t// KindExternal is an ax-provider-<id> executable discovered on the\n104|\t// filesystem and subject to trust recording and verification.\n105|\tKindExternal Kind = \"external\"\n106|)\n107|\n108|// ExecutablePrefix is the Section 7.1 external executable name prefix. The\n109|// suffix is a provider ID in the scalar provider-id grammar.\n110|const ExecutablePrefix = \"ax-provider-\"\n111|\n112|// builtinOrder is the Section 7.1 built-in set in the section's listed\n113|// order. The order is a discovery enumeration order only; Section 7.1\n114|// states the order does not establish precedence.\n115|var builtinOrder = []string{\"codex\", \"claude\", \"gemini\", \"muse\", \"antigravity\", \"pi\"}\n116|\n117|// Builtins returns the Section 7.1 built-in provider IDs in discovery\n118|// order. The result is a copy; the registry cannot be mutated through it.\n119|func Builtins() []string {\n120|\treturn append([]string(nil), builtinOrder...)\n121|}\n122|\n123|// Config carries the operator inputs Discover consumes. PluginDirs maps to\n124|// providers.plugin_dirs in listed order and AllowPathPlugins to\n125|// providers.allow_path_plugins; both arrive already parsed by\n126|// internal/config, which additionally enforces absolute directories and\n127|// require_explicit_trust. Platform is the host AX platform the paths are\n128|// evaluated on.\n129|type Config struct {\n130|\tPlatform         scalar.Platform\n131|\tPluginDirs       []string\n132|\tAllowPathPlugins bool\n133|}\n134|\n135|// OwnerPolicy decides whether a filesystem UID may own a trusted external\n136|// executable. OperatorUID is the operator's own identity;\n137|// AdministratorUIDs are the additional administrator-approved identities,\n138|// if the host configures any. An empty administrator set trusts the\n139|// operator alone; no superuser exception is implied.\n140|type OwnerPolicy struct {\n141|\tOperatorUID       uint32\n142|\tAdministratorUIDs []uint32\n143|}\n144|\n145|// Approves reports whether uid may own a trusted executable.\n146|func (policy OwnerPolicy) Approves(uid uint32) bool {\n147|\tif uid == policy.OperatorUID {\n148|\t\treturn true\n149|\t}\n150|\tfor _, admin := range policy.AdministratorUIDs {\n151|\t\tif uid == admin {\n152|\t\t\treturn true\n153|\t\t}\n154|\t}\n155|\treturn false\n156|}\n157|\n158|// OwnerIdentity renders a UID in the stable form TrustRecord stores.\n159|func (policy OwnerPolicy) OwnerIdentity(uid uint32) string {\n160|\treturn fmt.Sprintf(\"uid:%d\", uid)\n161|}\n162|\n163|// FileInfo is the ownership and shape fact System.Inspect reports for one\n164|// path. UID is the owning identity of the symlink target.\n165|type FileInfo struct {\n166|\tIsRegular bool\n167|\tUID       uint32\n168|}\n169|\n170|// System is the filesystem seam Discover and Verify read through.\n171|// Production code supplies OSSystem; tests supply a scripted fake. Every\n172|// method reports a failed or partial read as an error, never as an empty\n173|// result the caller could mistake for absence.\n174|type System interface {\n175|\t// ReadDir returns the entry names of dir, unsorted.\n176|\tReadDir(dir string) ([]string, error)\n177|\t// Canonicalize resolves dir against an absolute base and every\n178|\t// symlink in the path, returning the canonical absolute target.\n179|\tCanonicalize(path string) (string, error)\n180|\t// Inspect stats the symlink target at an already-canonical path.\n181|\tInspect(canonical string) (FileInfo, error)\n182|\t// ReadFile returns the full bytes of the symlink target at an\n183|\t// already-canonical path.\n184|\tReadFile(canonical string) ([]byte, error)\n185|\t// PathDirs returns the PATH search directories in listed order.\n186|\tPathDirs() []string\n187|}\n188|\n189|// Candidate is one discovered provider. External candidates carry the\n190|// trust-time facts Section 7.1 requires: the canonical absolute executable\n191|// path, the SHA-256 digest of its bytes, and the approving owner identity.\n192|// Builtin candidates carry none of those; the zero accessors report\n193|// absence. A Candidate carries no availability, status, or capability\n194|// claim: discovery never advertises what the probe plane has not proven.\n195|type Candidate struct {\n196|\tid     string\n197|\tkind   Kind\n198|\tsource string\n199|\tpath   string\n200|\tcanon  string\n201|\tdigest scalar.Digest\n202|\towner  string\n203|}\n204|\n205|// ID reports the provider ID this candidate declares.\n206|func (candidate Candidate) ID() string { return candidate.id }\n207|\n208|// Kind reports whether this candidate is built-in or external.\n209|func (candidate Candidate) Kind() Kind { return candidate.kind }\n210|\n211|// Source names where the candidate was found: plugin_dirs[i], builtin, or\n212|// path. It is a diagnostic label, not a precedence rank.\n213|func (candidate Candidate) Source() string { return candidate.source }\n214|\n215|// SourcePath reports the undisguised discovery path of an external\n216|// candidate: the plugin or PATH directory joined with the executable name.\n217|// Verify re-resolves this path to detect symlink retargeting.\n218|func (candidate Candidate) SourcePath() (string, bool) {\n219|\tif candidate.kind != KindExternal {\n220|\t\treturn \"\", false\n221|\t}\n222|\treturn candidate.path, true\n223|}\n224|\n225|// CanonicalPath reports the symlink-resolved absolute target recorded at\n226|// trust time for an external candidate.\n227|func (candidate Candidate) CanonicalPath() (string, bool) {\n228|\tif candidate.kind != KindExternal {\n229|\t\treturn \"\", false\n230|\t}\n231|\treturn candidate.canon, true\n232|}\n233|\n234|// Digest reports the SHA-256 digest of the target bytes recorded at trust\n235|// time for an external candidate.\n236|func (candidate Candidate) Digest() (scalar.Digest, bool) {\n237|\tif candidate.kind != KindExternal {\n238|\t\treturn scalar.Digest{}, false\n239|\t}\n240|\treturn candidate.digest, true\n241|}\n242|\n243|// Owner reports the approving owner identity recorded at trust time for an\n244|// external candidate.\n245|func (candidate Candidate) Owner() (string, bool) {\n246|\tif candidate.kind != KindExternal {\n247|\t\treturn \"\", false\n248|\t}\n249|\treturn candidate.owner, true\n250|}\n251|\n252|// TrustRecord is the trust-time receipt for one accepted external\n253|// candidate: the canonical absolute executable path and SHA-256 digest\n254|// Section 7.1 requires, plus the undisguised discovery path Verify\n255|// re-resolves, the approving owner identity, and the trust instant. The\n256|// host persists this receipt; Verify rechecks it.\n257|type TrustRecord struct {\n258|\tproviderID string\n259|\tsourcePath string\n260|\tcanon      string\n261|\tdigest     scalar.Digest\n262|\towner      string\n263|\ttrustedAt  scalar.Timestamp\n264|}\n265|\n266|// ProviderID reports the trusted provider ID.\n267|func (record TrustRecord) ProviderID() string { return record.providerID }\n268|\n269|// SourcePath reports the undisguised discovery path Verify re-resolves.\n270|func (record TrustRecord) SourcePath() string { return record.sourcePath }\n271|\n272|// CanonicalPath reports the recorded canonical absolute target.\n273|func (record TrustRecord) CanonicalPath() string { return record.canon }\n274|\n275|// Digest reports the recorded SHA-256 digest of the target bytes.\n276|func (record TrustRecord) Digest() scalar.Digest { return record.digest }\n277|\n278|// Owner reports the recorded approving owner identity.\n279|func (record TrustRecord) Owner() string { return record.owner }\n280|\n281|// TrustedAt reports the trust instant.\n282|func (record TrustRecord) TrustedAt() scalar.Timestamp { return record.trustedAt }\n283|\n284|// externalID splits an ax-provider-<id> file name. It reports false for\n285|// names outside the prefix so ordinary directory entries are skipped; a\n286|// prefixed name whose suffix fails the provider-id grammar is a malformed\n287|// candidate, reported as an error rather than silently skipped.\n288|func externalID(name string) (string, bool, error) {\n289|\tsuffix, found := strings.CutPrefix(name, ExecutablePrefix)\n290|\tif !found {\n291|\t\treturn \"\", false, nil\n292|\t}\n293|\tif _, err := scalar.ParseProviderID(suffix); err != nil {\n294|\t\treturn \"\", false, err\n295|\t}\n296|\treturn suffix, true, nil\n297|}\n298|\n299|// Discover deterministically enumerates provider candidates in the Section\n300|// 7.1 source order: configured plugin directories in listed order (entry\n301|// names sorted bytewise within each directory, because filesystem order is\n302|// not deterministic), then built-in adapters in registry order, then PATH\n303|// directories in listed order only when AllowPathPlugins is true. Both\n304|// configured plugin directories and PATH entries must be absolute paths:\n305|// a relative entry fails with invalid_config instead of resolving against\n306|// the process working directory.\n307|//\n308|// Discover never probes or executes a candidate, so the duplicate refusal\n309|// below happens before either by construction: the function has no probe\n310|// or execution dependency to invoke. If two candidates declare the same\n311|// provider ID, Discover fails with invalid_config naming both sources; the\n312|// operator must remove or rename one candidate. There is no\n313|// duplicate-selection override, including for byte-identical observations\n314|// of one file through two directories.\n315|//\n316|// Every accepted external candidate records its canonical absolute path,\n317|// SHA-256 digest, and approving owner at trust time: symlinks are resolved\n318|// before comparison, the target must be a regular file, and its owner must\n319|// satisfy policy. A matching directory entry that cannot become an\n320|// accepted candidate (malformed name, unresolvable link, non-regular\n321|// target, unapproved owner) fails discovery instead of being skipped,\n322|// because a skipped trust check would silently narrow the trust boundary.\n323|// Filesystem read failures abort discovery instead of yielding a partial\n324|// set. Discover holds no state and starts no process.\n325|func Discover(cfg Config, owner OwnerPolicy, system System) ([]Candidate, error) {\n326|\tseen := make(map[string]string)\n327|\tvar out []Candidate\n328|\tadd := func(candidate Candidate) error {\n329|\t\tif first, duplicate := seen[candidate.id]; duplicate {\n330|\t\t\treturn failDuplicate(candidate.id, first, candidate.source)\n331|\t\t}\n332|\t\tseen[candidate.id] = candidate.source\n333|\t\tout = append(out, candidate)\n334|\t\treturn nil\n335|\t}\n336|\tfor index, dir := range cfg.PluginDirs {\n337|\t\tif _, err := scalar.ParseAbsolutePath(cfg.Platform, dir); err != nil {\n338|\t\t\treturn nil, failInvalid(fmt.Sprintf(\"providers.plugin_dirs[%d] %q is not an absolute path\", index, dir))\n339|\t\t}\n340|\t\tsource := fmt.Sprintf(\"plugin_dirs[%d]\", index)\n341|\t\tif err := collectDirectory(owner, system, dir, source, add); err != nil {\n342|\t\t\treturn nil, err\n343|\t\t}\n344|\t}\n345|\tfor _, id := range builtinOrder {\n346|\t\tif err := add(Candidate{id: id, kind: KindBuiltin, source: \"builtin\"}); err != nil {\n347|\t\t\treturn nil, err\n348|\t\t}\n349|\t}\n350|\tif cfg.AllowPathPlugins {\n351|\t\tfor index, dir := range system.PathDirs() {\n352|\t\t\tif _, err := scalar.ParseAbsolutePath(cfg.Platform, dir); err != nil {\n353|\t\t\t\treturn nil, failInvalid(fmt.Sprintf(\"PATH[%d] %q is not an absolute path\", index, dir))\n354|\t\t\t}\n355|\t\t\tif err := collectDirectory(owner, system, dir, \"path\", add); err != nil {\n356|\t\t\t\treturn nil, err\n357|\t\t\t}\n358|\t\t}\n359|\t}\n360|\treturn out, nil\n361|}\n362|\n363|// collectDirectory folds every ax-provider-<id> entry of one directory into\n364|// add in bytewise name order. PATH entries reuse this path, so both sources\n365|// enforce the same trust checks; only the diagnostic source label differs.\n366|func collectDirectory(owner OwnerPolicy, system System, dir, source string, add func(Candidate) error) error {\n367|\tnames, err := system.ReadDir(dir)\n368|\tif err != nil {\n369|\t\treturn failPrecondition(fmt.Sprintf(\"cannot list %s directory %q\", source, dir), err)\n370|\t}\n371|\tsort.Strings(names)\n372|\tfor _, name := range names {\n373|\t\tid, candidate, err := externalID(name)\n374|\t\tif err != nil {\n375|\t\t\treturn failInvalid(fmt.Sprintf(\"%s entry %q is not a provider executable name: %v\", source, filepath.Join(dir, name), err))\n376|\t\t}\n377|\t\tif !candidate {\n378|\t\t\tcontinue\n379|\t\t}\n380|\t\tfound, err := trustCandidate(owner, system, id, filepath.Join(dir, name), source)\n381|\t\tif err != nil {\n382|\t\t\treturn err\n383|\t\t}\n384|\t\tif err := add(found); err != nil {\n385|\t\t\treturn err\n386|\t\t}\n387|\t}\n388|\treturn nil\n389|}\n390|\n391|// trustCandidate establishes the trust-time facts for one external\n392|// executable: symlink resolution before comparison, regular-file target,\n393|// approved owner, and digest over the target bytes.\n394|func trustCandidate(owner OwnerPolicy, system System, id, path, source string) (Candidate, error) {\n395|\tcanon, err := system.Canonicalize(path)\n396|\tif err != nil {\n397|\t\treturn Candidate{}, failPrecondition(fmt.Sprintf(\"cannot resolve provider %q at %q\", id, path), err)\n398|\t}\n399|\tinfo, err := system.Inspect(canon)\n400|\tif err != nil {\n401|\t\treturn Candidate{}, failPrecondition(fmt.Sprintf(\"cannot inspect provider %q target %q\", id, canon), err)\n402|\t}\n403|\tif !info.IsRegular {\n404|\t\treturn Candidate{}, failInvalid(fmt.Sprintf(\"provider %q target %q is not a regular file\", id, canon))\n405|\t}\n406|\tif !owner.Approves(info.UID) {\n407|\t\treturn Candidate{}, failInvalid(fmt.Sprintf(\"provider %q target %q is owned by %s, which the trust policy does not approve\", id, canon, owner.OwnerIdentity(info.UID)))\n408|\t}\n409|\tcontent, err := system.ReadFile(canon)\n410|\tif err != nil {\n411|\t\treturn Candidate{}, failPrecondition(fmt.Sprintf(\"cannot digest provider %q target %q\", id, canon), err)\n412|\t}\n413|\tdigest := scalar.SHA256Digest(content)\n414|\treturn Candidate{\n415|\t\tid:     id,\n416|\t\tkind:   KindExternal,\n417|\t\tsource: source,\n418|\t\tpath:   path,\n419|\t\tcanon:  canon,\n420|\t\tdigest: digest,\n421|\t\towner:  owner.OwnerIdentity(info.UID),\n422|\t}, nil\n423|}\n424|\n425|// Trust records the trust receipt for one accepted external candidate.\n426|// Trusting a builtin adapter is refused: it has no executable bytes to\n427|// record. Trust is pure: identical inputs return identical receipts.\n428|func Trust(candidate Candidate, trustedAt scalar.Timestamp) (TrustRecord, error) {\n429|\tif candidate.kind != KindExternal {\n430|\t\treturn TrustRecord{}, failInvalid(fmt.Sprintf(\"provider %q is a builtin adapter with no executable to trust\", candidate.id))\n431|\t}\n432|\treturn TrustRecord{\n433|\t\tproviderID: candidate.id,\n434|\t\tsourcePath: candidate.path,\n435|\t\tcanon:      candidate.canon,\n436|\t\tdigest:     candidate.digest,\n437|\t\towner:      candidate.owner,\n438|\t\ttrustedAt:  trustedAt,\n439|\t}, nil\n440|}\n441|\n442|// Verify rechecks a trust receipt against freshly read filesystem facts. A\n443|// changed path target or digest requires renewed trust: any mismatch in\n444|// the re-resolved canonical path, the target shape, the approving owner,\n445|// or the digest fails with integrity_failure, as does any read failure,\n446|// because an unreadable file cannot prove it is unchanged. Verify holds no\n447|// state and starts no process; repeated verification over an unchanged\n448|// tree succeeds identically.\n449|func Verify(record TrustRecord, owner OwnerPolicy, system System) error {\n450|\tcanon, err := system.Canonicalize(record.sourcePath)\n451|\tif err != nil {\n452|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q trust receipt cannot be re-resolved and requires renewed trust\", record.providerID), err)\n453|\t}\n454|\tif canon != record.canon {\n455|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable target changed from %q to %q and requires renewed trust\", record.providerID, record.canon, canon), nil)\n456|\t}\n457|\tinfo, err := system.Inspect(canon)\n458|\tif err != nil {\n459|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable target %q cannot be re-inspected and requires renewed trust\", record.providerID, canon), err)\n460|\t}\n461|\tif !info.IsRegular {\n462|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable target %q is no longer a regular file and requires renewed trust\", record.providerID, canon), nil)\n463|\t}\n464|\tif identity := owner.OwnerIdentity(info.UID); !owner.Approves(info.UID) || identity != record.owner {\n465|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable owner is now %s and requires renewed trust\", record.providerID, identity), nil)\n466|\t}\n467|\tcontent, err := system.ReadFile(canon)\n468|\tif err != nil {\n469|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable target %q cannot be re-read and requires renewed trust\", record.providerID, canon), err)\n470|\t}\n471|\tsum := sha256.Sum256(content)\n472|\tif subtle.ConstantTimeCompare(sum[:], digestBytes(record.digest)) != 1 {\n473|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable digest changed and requires renewed trust\", record.providerID), nil)\n474|\t}\n475|\treturn nil\n476|}\n477|\n478|// digestBytes decodes the recorded digest for constant-time comparison. A\n479|// TrustRecord always carries a digest produced by SHA256Digest, so the\n480|// decode cannot fail; a receipt that does not decode compares unequal\n481|// rather than panicking.\n482|func digestBytes(digest scalar.Digest) []byte {\n483|\traw := digest.Hex()\n484|\tif len(raw) != sha256.Size*2 {\n485|\t\treturn nil\n486|\t}\n487|\tdecoded := make([]byte, sha256.Size)\n488|\tfor i := range decoded {\n489|\t\thi := unhex(raw[2*i])\n490|\t\tlo := unhex(raw[2*i+1])\n491|\t\tif hi > 15 || lo > 15 {\n492|\t\t\treturn nil\n493|\t\t}\n494|\t\tdecoded[i] = hi<<4 | lo\n495|\t}\n496|\treturn decoded\n497|}\n498|\n499|func unhex(c byte) byte {\n500|\tswitch {\n(more lines below)"}}}
