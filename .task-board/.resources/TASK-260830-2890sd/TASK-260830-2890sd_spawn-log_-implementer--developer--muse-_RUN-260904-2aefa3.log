{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4cd","stream":{"kind":"session","id":"01a06e98-2a6f-7230-81f2-5355ec816701"},"sequence":193,"recorded_at":1780531400000381,"record_type":"event","durability":"durable","causation_id":"e5781de4-97b1-4e5e-9466-20c1d6e7652b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e5781de4-97b1-4e5e-9466-20c1d6e7652b","run_stream":{"kind":"run","id":"e5781de4-97b1-4e5e-9466-20c1d6e7652b"},"task_stream":{"kind":"task","id":"e1962742-ca9e-4066-9c52-f1ad82b18b9c"},"task_id":"e1962742-ca9e-4066-9c52-f1ad82b18b9c","event":{"kind":"output","task_id":"e1962742-ca9e-4066-9c52-f1ad82b18b9c","chunk":"Read text file `internal/provider/provider.go`.\n1|package provider\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"crypto/subtle\"\n6|\t\"fmt\"\n7|\t\"path/filepath\"\n8|\t\"sort\"\n9|\t\"strings\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// Stable Structured Error codes this package reports. Discovery-shape\n15|// refusals (duplicates, malformed names, non-regular targets, unapproved\n16|// owners, relative directories) report invalid_config; a filesystem read\n17|// that cannot establish the discovery or verification preconditions reports\n18|// local_precondition_failed; a trust receipt that no longer matches freshly\n19|// read facts reports integrity_failure. The duplicate mapping is mandated by\n20|// Section 7.1; the other two are derived mappings documented on the\n21|// constructors, because Section 7.1 names no code for those cases.\n22|const (\n23|\tcodeInvalidConfig     = \"invalid_config\"\n24|\tcodeLocalPrecondition = \"local_precondition_failed\"\n25|\tcodeIntegrityFailure  = \"integrity_failure\"\n26|)\n27|\n28|// Error is the only error this package produces. Code carries the stable\n29|// registry code above; Detail names the offending provider ID, path, or\n30|// trust dimension in human text automation must never branch on; Cause\n31|// preserves the underlying filesystem failure for errors.Is and errors.As.\n32|type Error struct {\n33|\tcode   string\n34|\tdetail string\n35|\tcause  error\n36|}\n37|\n38|// Code reports the stable registry code for this refusal.\n39|func (err Error) Code() string { return err.code }\n40|\n41|// Detail reports the human-text detail for this refusal.\n42|func (err Error) Detail() string { return err.detail }\n43|\n44|// Unwrap exposes the underlying filesystem cause, if one was recorded.\n45|func (err Error) Unwrap() error { return err.cause }\n46|\n47|func (err Error) Error() string {\n48|\tif err.cause == nil {\n49|\t\treturn \"provider \" + err.code + \": \" + err.detail\n50|\t}\n51|\treturn \"provider \" + err.code + \": \" + err.detail + \": \" + err.cause.Error()\n52|}\n53|\n54|// The four refusal constructors below are declared as variables so the\n55|// refusal-inventory gate can observe every exercised refusal site. Each is\n56|// the single construction site for its failure class; production code must\n57|// not build Error values or wrap filesystem errors any other way.\n58|//\n59|// failDuplicate reports the Section 7.1 duplicate-ID refusal with the\n60|// section-mandated invalid_config code.\n61|//\n62|// failInvalid reports a discovery-shape refusal: a malformed plugin name, a\n63|// non-regular target, an unapproved owner, a relative directory, or a Trust\n64|// call on a builtin adapter. These are operator-configuration or caller\n65|// errors, so they share the invalid_config code.\n66|//\n67|// failPrecondition reports a filesystem read failure during discovery: an\n68|// unreadable plugin directory, an unresolvable symlink, an unreadable\n69|// target, or unattainable ownership metadata. A failed read is never a\n70|// legitimate absence, so discovery aborts with local_precondition_failed\n71|// instead of yielding a partial candidate set.\n72|//\n73|// failIntegrity reports a trust receipt that no longer matches freshly read\n74|// facts, including a receipt whose facts cannot be re-read at all: a\n75|// changed path target or digest requires renewed trust, and an unreadable\n76|// file cannot prove it is unchanged.\n77|var failDuplicate = func(providerID, firstSource, secondSource string) Error {\n78|\treturn Error{\n79|\t\tcode:   codeInvalidConfig,\n80|\t\tdetail: fmt.Sprintf(\"duplicate provider %q from %s and %s\", providerID, firstSource, secondSource),\n81|\t}\n82|}\n83|\n84|var failInvalid = func(detail string) Error {\n85|\treturn Error{code: codeInvalidConfig, detail: detail}\n86|}\n87|\n88|var failPrecondition = func(detail string, cause error) Error {\n89|\treturn Error{code: codeLocalPrecondition, detail: detail, cause: cause}\n90|}\n91|\n92|var failIntegrity = func(detail string, cause error) Error {\n93|\treturn Error{code: codeIntegrityFailure, detail: detail, cause: cause}\n94|}\n95|\n96|// Kind distinguishes a built-in adapter from an external executable.\n97|type Kind string\n98|\n99|const (\n100|\t// KindBuiltin is an adapter compiled into the host. It has no\n101|\t// executable path, digest, or owner to trust.\n102|\tKindBuiltin Kind = \"builtin\"\n103|\t// KindExternal is an ax-provider-<id> executable discovered on the\n104|\t// filesystem and subject to trust recording and verification.\n105|\tKindExternal Kind = \"external\"\n106|)\n107|\n108|// ExecutablePrefix is the Section 7.1 external executable name prefix. The\n109|// suffix is a provider ID in the scalar provider-id grammar.\n110|const ExecutablePrefix = \"ax-provider-\"\n111|\n112|// builtinOrder is the Section 7.1 built-in set in the section's listed\n113|// order. The order is a discovery enumeration order only; Section 7.1\n114|// states the order does not establish precedence.\n115|var builtinOrder = []string{\"codex\", \"claude\", \"gemini\", \"muse\", \"antigravity\", \"pi\"}\n116|\n117|// Builtins returns the Section 7.1 built-in provider IDs in discovery\n118|// order. The result is a copy; the registry cannot be mutated through it.\n119|func Builtins() []string {\n120|\treturn append([]string(nil), builtinOrder...)\n121|}\n122|\n123|// Config carries the operator inputs Discover consumes. PluginDirs maps to\n124|// providers.plugin_dirs in listed order and AllowPathPlugins to\n125|// providers.allow_path_plugins; both arrive already parsed by\n126|// internal/config, which additionally enforces absolute directories and\n127|// require_explicit_trust. Platform is the host AX platform the paths are\n128|// evaluated on.\n129|type Config struct {\n130|\tPlatform         scalar.Platform\n131|\tPluginDirs       []string\n132|\tAllowPathPlugins bool\n133|}\n134|\n135|// OwnerPolicy decides whether a filesystem UID may own a trusted external\n136|// executable. OperatorUID is the operator's own identity;\n137|// AdministratorUIDs are the additional administrator-approved identities,\n138|// if the host configures any. An empty administrator set trusts the\n139|// operator alone; no superuser exception is implied.\n140|type OwnerPolicy struct {\n141|\tOperatorUID       uint32\n142|\tAdministratorUIDs []uint32\n143|}\n144|\n145|// Approves reports whether uid may own a trusted executable.\n146|func (policy OwnerPolicy) Approves(uid uint32) bool {\n147|\tif uid == policy.OperatorUID {\n148|\t\treturn true\n149|\t}\n150|\tfor _, admin := range policy.AdministratorUIDs {\n151|\t\tif uid == admin {\n152|\t\t\treturn true\n153|\t\t}\n154|\t}\n155|\treturn false\n156|}\n157|\n158|// OwnerIdentity renders a UID in the stable form TrustRecord stores.\n159|func (policy OwnerPolicy) OwnerIdentity(uid uint32) string {\n160|\treturn fmt.Sprintf(\"uid:%d\", uid)\n161|}\n162|\n163|// FileInfo is the ownership and shape fact System.Inspect reports for one\n164|// path. UID is the owning identity of the symlink target.\n165|type FileInfo struct {\n166|\tIsRegular bool\n167|\tUID       uint32\n168|}\n169|\n170|// System is the filesystem seam Discover and Verify read through.\n171|// Production code supplies OSSystem; tests supply a scripted fake. Every\n172|// method reports a failed or partial read as an error, never as an empty\n173|// result the caller could mistake for absence.\n174|type System interface {\n175|\t// ReadDir returns the entry names of dir, unsorted.\n176|\tReadDir(dir string) ([]string, error)\n177|\t// Canonicalize resolves dir against an absolute base and every\n178|\t// symlink in the path, returning the canonical absolute target.\n179|\tCanonicalize(path string) (string, error)\n180|\t// Inspect stats the symlink target at an already-canonical path.\n181|\tInspect(canonical string) (FileInfo, error)\n182|\t// ReadFile returns the full bytes of the symlink target at an\n183|\t// already-canonical path.\n184|\tReadFile(canonical string) ([]byte, error)\n185|\t// PathDirs returns the PATH search directories in listed order.\n186|\tPathDirs() []string\n187|}\n188|\n189|// Candidate is one discovered provider. External candidates carry the\n190|// trust-time facts Section 7.1 requires: the canonical absolute executable\n191|// path, the SHA-256 digest of its bytes, and the approving owner identity.\n192|// Builtin candidates carry none of those; the zero accessors report\n193|// absence. A Candidate carries no availability, status, or capability\n194|// claim: discovery never advertises what the probe plane has not proven.\n195|type Candidate struct {\n196|\tid     string\n197|\tkind   Kind\n198|\tsource string\n199|\tpath   string\n200|\tcanon  string\n201|\tdigest scalar.Digest\n202|\towner  string\n203|}\n204|\n205|// ID reports the provider ID this candidate declares.\n206|func (candidate Candidate) ID() string { return candidate.id }\n207|\n208|// Kind reports whether this candidate is built-in or external.\n209|func (candidate Candidate) Kind() Kind { return candidate.kind }\n210|\n211|// Source names where the candidate was found: plugin_dirs[i], builtin, or\n212|// path. It is a diagnostic label, not a precedence rank.\n213|func (candidate Candidate) Source() string { return candidate.source }\n214|\n215|// SourcePath reports the undisguised discovery path of an external\n216|// candidate: the plugin or PATH directory joined with the executable name.\n217|// Verify re-resolves this path to detect symlink retargeting.\n218|func (candidate Candidate) SourcePath() (string, bool) {\n219|\tif candidate.kind != KindExternal {\n220|\t\treturn \"\", false\n221|\t}\n222|\treturn candidate.path, true\n223|}\n224|\n225|// CanonicalPath reports the symlink-resolved absolute target recorded at\n226|// trust time for an external candidate.\n227|func (candidate Candidate) CanonicalPath() (string, bool) {\n228|\tif candidate.kind != KindExternal {\n229|\t\treturn \"\", false\n230|\t}\n231|\treturn candidate.canon, true\n232|}\n233|\n234|// Digest reports the SHA-256 digest of the target bytes recorded at trust\n235|// time for an external candidate.\n236|func (candidate Candidate) Digest() (scalar.Digest, bool) {\n237|\tif candidate.kind != KindExternal {\n238|\t\treturn scalar.Digest{}, false\n239|\t}\n240|\treturn candidate.digest, true\n241|}\n242|\n243|// Owner reports the approving owner identity recorded at trust time for an\n244|// external candidate.\n245|func (candidate Candidate) Owner() (string, bool) {\n246|\tif candidate.kind != KindExternal {\n247|\t\treturn \"\", false\n248|\t}\n249|\treturn candidate.owner, true\n250|}\n251|\n252|// TrustRecord is the trust-time receipt for one accepted external\n253|// candidate: the canonical absolute executable path and SHA-256 digest\n254|// Section 7.1 requires, plus the undisguised discovery path Verify\n255|// re-resolves, the approving owner identity, and the trust instant. The\n256|// host persists this receipt; Verify rechecks it.\n257|type TrustRecord struct {\n258|\tproviderID string\n259|\tsourcePath string\n260|\tcanon      string\n261|\tdigest     scalar.Digest\n262|\towner      string\n263|\ttrustedAt  scalar.Timestamp\n264|}\n265|\n266|// ProviderID reports the trusted provider ID.\n267|func (record TrustRecord) ProviderID() string { return record.providerID }\n268|\n269|// SourcePath reports the undisguised discovery path Verify re-resolves.\n270|func (record TrustRecord) SourcePath() string { return record.sourcePath }\n271|\n272|// CanonicalPath reports the recorded canonical absolute target.\n273|func (record TrustRecord) CanonicalPath() string { return record.canon }\n274|\n275|// Digest reports the recorded SHA-256 digest of the target bytes.\n276|func (record TrustRecord) Digest() scalar.Digest { return record.digest }\n277|\n278|// Owner reports the recorded approving owner identity.\n279|func (record TrustRecord) Owner() string { return record.owner }\n280|\n281|// TrustedAt reports the trust instant.\n282|func (record TrustRecord) TrustedAt() scalar.Timestamp { return record.trustedAt }\n283|\n284|// externalID splits an ax-provider-<id> file name. It reports false for\n285|// names outside the prefix so ordinary directory entries are skipped; a\n286|// prefixed name whose suffix fails the provider-id grammar is a malformed\n287|// candidate, reported as an error rather than silently skipped.\n288|func externalID(name string) (string, bool, error) {\n289|\tsuffix, found := strings.CutPrefix(name, ExecutablePrefix)\n290|\tif !found {\n291|\t\treturn \"\", false, nil\n292|\t}\n293|\tif _, err := scalar.ParseProviderID(suffix); err != nil {\n294|\t\treturn \"\", false, err\n295|\t}\n296|\treturn suffix, true, nil\n297|}\n298|\n299|// Discover deterministically enumerates provider candidates in the Section\n300|// 7.1 source order: configured plugin directories in listed order (entry\n301|// names sorted bytewise within each directory, because filesystem order is\n302|// not deterministic), then built-in adapters in registry order, then PATH\n303|// directories in listed order only when AllowPathPlugins is true. Both\n304|// configured plugin directories and PATH entries must be absolute paths:\n305|// a relative entry fails with invalid_config instead of resolving against\n306|// the process working directory.\n307|//\n308|// Discover never probes or executes a candidate, so the duplicate refusal\n309|// below happens before either by construction: the function has no probe\n310|// or execution dependency to invoke. If two candidates declare the same\n311|// provider ID, Discover fails with invalid_config naming both sources; the\n312|// operator must remove or rename one candidate. There is no\n313|// duplicate-selection override, including for byte-identical observations\n314|// of one file through two directories.\n315|//\n316|// Every accepted external candidate records its canonical absolute path,\n317|// SHA-256 digest, and approving owner at trust time: symlinks are resolved\n318|// before comparison, the target must be a regular file, and its owner must\n319|// satisfy policy. A matching directory entry that cannot become an\n320|// accepted candidate (malformed name, unresolvable link, non-regular\n321|// target, unapproved owner) fails discovery instead of being skipped,\n322|// because a skipped trust check would silently narrow the trust boundary.\n323|// Filesystem read failures abort discovery instead of yielding a partial\n324|// set. Discover holds no state and starts no process.\n325|func Discover(cfg Config, owner OwnerPolicy, system System) ([]Candidate, error) {\n326|\tseen := make(map[string]string)\n327|\tvar out []Candidate\n328|\tadd := func(candidate Candidate) error {\n329|\t\tif first, duplicate := seen[candidate.id]; duplicate {\n330|\t\t\treturn failDuplicate(candidate.id, first, candidate.source)\n331|\t\t}\n332|\t\tseen[candidate.id] = candidate.source\n333|\t\tout = append(out, candidate)\n334|\t\treturn nil\n335|\t}\n336|\tfor index, dir := range cfg.PluginDirs {\n337|\t\tif _, err := scalar.ParseAbsolutePath(cfg.Platform, dir); err != nil {\n338|\t\t\treturn nil, failInvalid(fmt.Sprintf(\"providers.plugin_dirs[%d] %q is not an absolute path\", index, dir))\n339|\t\t}\n340|\t\tsource := fmt.Sprintf(\"plugin_dirs[%d]\", index)\n341|\t\tif err := collectDirectory(owner, system, dir, source, add); err != nil {\n342|\t\t\treturn nil, err\n343|\t\t}\n344|\t}\n345|\tfor _, id := range builtinOrder {\n346|\t\tif err := add(Candidate{id: id, kind: KindBuiltin, source: \"builtin\"}); err != nil {\n347|\t\t\treturn nil, err\n348|\t\t}\n349|\t}\n350|\tif cfg.AllowPathPlugins {\n351|\t\tfor index, dir := range system.PathDirs() {\n352|\t\t\tif _, err := scalar.ParseAbsolutePath(cfg.Platform, dir); err != nil {\n353|\t\t\t\treturn nil, failInvalid(fmt.Sprintf(\"PATH[%d] %q is not an absolute path\", index, dir))\n354|\t\t\t}\n355|\t\t\tif err := collectDirectory(owner, system, dir, \"path\", add); err != nil {\n356|\t\t\t\treturn nil, err\n357|\t\t\t}\n358|\t\t}\n359|\t}\n360|\treturn out, nil\n361|}\n362|\n363|// collectDirectory folds every ax-provider-<id> entry of one directory into\n364|// add in bytewise name order. PATH entries reuse this path, so both sources\n365|// enforce the same trust checks; only the diagnostic source label differs.\n366|func collectDirectory(owner OwnerPolicy, system System, dir, source string, add func(Candidate) error) error {\n367|\tnames, err := system.ReadDir(dir)\n368|\tif err != nil {\n369|\t\treturn failPrecondition(fmt.Sprintf(\"cannot list %s directory %q\", source, dir), err)\n370|\t}\n371|\tsort.Strings(names)\n372|\tfor _, name := range names {\n373|\t\tid, candidate, err := externalID(name)\n374|\t\tif err != nil {\n375|\t\t\treturn failInvalid(fmt.Sprintf(\"%s entry %q is not a provider executable name: %v\", source, filepath.Join(dir, name), err))\n376|\t\t}\n377|\t\tif !candidate {\n378|\t\t\tcontinue\n379|\t\t}\n380|\t\tfound, err := trustCandidate(owner, system, id, filepath.Join(dir, name), source)\n381|\t\tif err != nil {\n382|\t\t\treturn err\n383|\t\t}\n384|\t\tif err := add(found); err != nil {\n385|\t\t\treturn err\n386|\t\t}\n387|\t}\n388|\treturn nil\n389|}\n390|\n391|// trustCandidate establishes the trust-time facts for one external\n392|// executable: symlink resolution before comparison, regular-file target,\n393|// approved owner, and digest over the target bytes.\n394|func trustCandidate(owner OwnerPolicy, system System, id, path, source string) (Candidate, error) {\n395|\tcanon, err := system.Canonicalize(path)\n396|\tif err != nil {\n397|\t\treturn Candidate{}, failPrecondition(fmt.Sprintf(\"cannot resolve provider %q at %q\", id, path), err)\n398|\t}\n399|\tinfo, err := system.Inspect(canon)\n400|\tif err != nil {\n401|\t\treturn Candidate{}, failPrecondition(fmt.Sprintf(\"cannot inspect provider %q target %q\", id, canon), err)\n402|\t}\n403|\tif !info.IsRegular {\n404|\t\treturn Candidate{}, failInvalid(fmt.Sprintf(\"provider %q target %q is not a regular file\", id, canon))\n405|\t}\n406|\tif !owner.Approves(info.UID) {\n407|\t\treturn Candidate{}, failInvalid(fmt.Sprintf(\"provider %q target %q is owned by %s, which the trust policy does not approve\", id, canon, owner.OwnerIdentity(info.UID)))\n408|\t}\n409|\tcontent, err := system.ReadFile(canon)\n410|\tif err != nil {\n411|\t\treturn Candidate{}, failPrecondition(fmt.Sprintf(\"cannot digest provider %q target %q\", id, canon), err)\n412|\t}\n413|\tdigest := scalar.SHA256Digest(content)\n414|\treturn Candidate{\n415|\t\tid:     id,\n416|\t\tkind:   KindExternal,\n417|\t\tsource: source,\n418|\t\tpath:   path,\n419|\t\tcanon:  canon,\n420|\t\tdigest: digest,\n421|\t\towner:  owner.OwnerIdentity(info.UID),\n422|\t}, nil\n423|}\n424|\n425|// Trust records the trust receipt for one accepted external candidate.\n426|// Trusting a builtin adapter is refused: it has no executable bytes to\n427|// record. Trust is pure: identical inputs return identical receipts.\n428|func Trust(candidate Candidate, trustedAt scalar.Timestamp) (TrustRecord, error) {\n429|\tif candidate.kind != KindExternal {\n430|\t\treturn TrustRecord{}, failInvalid(fmt.Sprintf(\"provider %q is a builtin adapter with no executable to trust\", candidate.id))\n431|\t}\n432|\treturn TrustRecord{\n433|\t\tproviderID: candidate.id,\n434|\t\tsourcePath: candidate.path,\n435|\t\tcanon:      candidate.canon,\n436|\t\tdigest:     candidate.digest,\n437|\t\towner:      candidate.owner,\n438|\t\ttrustedAt:  trustedAt,\n439|\t}, nil\n440|}\n441|\n442|// Verify rechecks a trust receipt against freshly read filesystem facts. A\n443|// changed path target or digest requires renewed trust: any mismatch in\n444|// the re-resolved canonical path, the target shape, the approving owner,\n445|// or the digest fails with integrity_failure, as does any read failure,\n446|// because an unreadable file cannot prove it is unchanged. Verify holds no\n447|// state and starts no process; repeated verification over an unchanged\n448|// tree succeeds identically.\n449|func Verify(record TrustRecord, owner OwnerPolicy, system System) error {\n450|\tcanon, err := system.Canonicalize(record.sourcePath)\n451|\tif err != nil {\n452|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q trust receipt cannot be re-resolved and requires renewed trust\", record.providerID), err)\n453|\t}\n454|\tif canon != record.canon {\n455|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable target changed from %q to %q and requires renewed trust\", record.providerID, record.canon, canon), nil)\n456|\t}\n457|\tinfo, err := system.Inspect(canon)\n458|\tif err != nil {\n459|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable target %q cannot be re-inspected and requires renewed trust\", record.providerID, canon), err)\n460|\t}\n461|\tif !info.IsRegular {\n462|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable target %q is no longer a regular file and requires renewed trust\", record.providerID, canon), nil)\n463|\t}\n464|\tif identity := owner.OwnerIdentity(info.UID); !owner.Approves(info.UID) || identity != record.owner {\n465|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable owner is now %s and requires renewed trust\", record.providerID, identity), nil)\n466|\t}\n467|\tcontent, err := system.ReadFile(canon)\n468|\tif err != nil {\n469|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable target %q cannot be re-read and requires renewed trust\", record.providerID, canon), err)\n470|\t}\n471|\tsum := sha256.Sum256(content)\n472|\tif subtle.ConstantTimeCompare(sum[:], digestBytes(record.digest)) != 1 {\n473|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable digest changed and requires renewed trust\", record.providerID), nil)\n474|\t}\n475|\treturn nil\n476|}\n477|\n478|// digestBytes decodes the recorded digest for constant-time comparison. A\n479|// TrustRecord always carries a digest produced by SHA256Digest, so the\n480|// decode cannot fail; a receipt that does not decode compares unequal\n481|// rather than panicking.\n482|func digestBytes(digest scalar.Digest) []byte {\n483|\traw := digest.Hex()\n484|\tif len(raw) != sha256.Size*2 {\n485|\t\treturn nil\n486|\t}\n487|\tdecoded := make([]byte, sha256.Size)\n488|\tfor i := range decoded {\n489|\t\thi := unhex(raw[2*i])\n490|\t\tlo := unhex(raw[2*i+1])\n491|\t\tif hi > 15 || lo > 15 {\n492|\t\t\treturn nil\n493|\t\t}\n494|\t\tdecoded[i] = hi<<4 | lo\n495|\t}\n496|\treturn decoded\n497|}\n498|\n499|func unhex(c byte) byte {\n500|\tswitch {\n(more lines below)"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4cf","stream":{"kind":"session","id":"01a06e98-2a6f-7230-81f2-5355ec816701"},"sequence":194,"recorded_at":1780531400000383,"record_type":"event","durability":"durable","causation_id":"e5781de4-97b1-4e5e-9466-20c1d6e7652b","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e5781de4-97b1-4e5e-9466-20c1d6e7652b","run_stream":{"kind":"run","id":"e5781de4-97b1-4e5e-9466-20c1d6e7652b"},"task_stream":{"kind":"task","id":"e1962742-ca9e-4066-9c52-f1ad82b18b9c"},"task_id":"e1962742-ca9e-4066-9c52-f1ad82b18b9c","event":{"kind":"completed","task_id":"e1962742-ca9e-4066-9c52-f1ad82b18b9c"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4d1","stream":{"kind":"session","id":"01a06e98-2a6f-7230-81f2-5355ec816701"},"sequence":195,"recorded_at":1780531400000385,"record_type":"event","durability":"durable","causation_id":"e5781de4-97b1-4e5e-9466-20c1d6e7652b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e5781de4-97b1-4e5e-9466-20c1d6e7652b","run_stream":{"kind":"run","id":"e5781de4-97b1-4e5e-9466-20c1d6e7652b"},"call_id":"call_01a06e98a92974a0bd49e873825b2087","text":"<read-skill-result name=\"go-testing-tools\" status=\"ok\">\n<metadata>\npath: /Users/iv/.agents/skills/go-testing-tools/SKILL.md\nlocator: file:///Users/iv/.agents/skills/go-testing-tools/SKILL.md\nsource: user\nbytes_returned: 15216\nbytes_total: 15216\ntruncated: false\n</metadata>\n\n<skill-body id=\"go-testing-tools\">\n---\nname: go-testing-tools\ndescription: &gt;\n  Go testing toolkit with tuitestkit library and a closed-loop development\n  cycle for Go applications. Covers test helpers, reducer tests,\n  snapshot/golden testing, mock executor patterns, and view assertions.\ntriggers:\n  - go test\n  - bubbletea test\n  - tuitestkit\n  - go test helpers\n  - reducer test\n  - snapshot test go\n  - golden file go\n  - тесты го\n  - го тест хелперы\n  - тесты баблти\n  - тест утилиты го\n  - замкнутый цикл тестирования\n---\n\n# Go Testing Tools\n\nTesting toolkit for Go TUI applications built with bubbletea. Provides a Go library (`tuitestkit`), reference documentation, and templates that enable a closed-loop development cycle: write code, write tests, run tests, validate, fix, repeat -- all without human intervention.\n\nCore philosophy: **Elm architecture makes TUI testable.** The reducer is a pure function -- given the same state and action, it always returns the same result. No I/O, no randomness, no terminal. Test everything as function calls.\n\n---\n\n## Prerequisites\n\n- **Go 1.21+**\n- **bubbletea** (`github.com/charmbracelet/bubbletea`)\n- **lipgloss** (`github.com/charmbracelet/lipgloss`) -- used by most bubbletea apps for styling\n\nInstall the library in your project:\n\n```bash\ngo get github.com/relux-works/skill-go-testing-tools/tuitestkit\n```\n\n---\n\n## Quick Start\n\nMinimal test showing the core workflow: build a message, send it to a model, assert on the view.\n\n```go\npackage myscreen_test\n\nimport (\n    &quot;testing&quot;\n\n    &quot;github.com/relux-works/skill-go-testing-tools/tuitestkit&quot;\n)\n\nfunc TestBasicNavigation(t *testing.T) {\n    m := NewMyModel(testData)\n    m = tuitestkit.Send(m, tuitestkit.WindowSize(80, 24))\n\n    // Press down twice\n    m = tuitestkit.Send(m, tuitestkit.Key(&quot;down&quot;), tuitestkit.Key(&quot;down&quot;))\n\n    // Assert the view contains expected content\n    tuitestkit.ViewContains(t, m, &quot;third item&quot;)\n    tuitestkit.ViewNotContains(t, m, &quot;ERROR&quot;)\n}\n```\n\n---\n\n## Testing Pyramid\n\nFive levels, from fastest/most numerous to slowest/fewest:\n\n| Level | What | Speed | Investment |\n|-------|------|-------|------------|\n| 1. Pure Reducer | `func(State, Action) State` | Nanoseconds | ~60% |\n| 2. Component | `Update` + `View` | Microseconds | ~20% |\n| 3. Integration | Multi-component with mocks | Milliseconds | ~10% |\n| 4. Snapshot | Golden file comparison | Milliseconds | ~5% |\n| 5. Behavioral | Full user workflows | Milliseconds | ~5% |\n\nWhen time is limited: **Level 1 &gt; Level 2 &gt; Level 3**. Pure reducer tests catch the most bugs per line of test code.\n\nFull details: `references/testing-pyramid.md`\n\n---\n\n## Library API Reference\n\nAll functions are in the `tuitestkit` package.\n\n### Message Builders (`messages.go`)\n\nBuild `tea.Msg` values for driving model updates.\n\n```go\n// Key builds a tea.KeyMsg from a human-readable string.\n// Supports: &quot;enter&quot;, &quot;tab&quot;, &quot;esc&quot;, &quot;space&quot;, &quot;backspace&quot;, &quot;up&quot;, &quot;down&quot;,\n// &quot;left&quot;, &quot;right&quot;, &quot;home&quot;, &quot;end&quot;, &quot;pgup&quot;, &quot;pgdown&quot;, &quot;delete&quot;, &quot;insert&quot;,\n// &quot;f1&quot;-&quot;f20&quot;, &quot;ctrl+c&quot;, &quot;ctrl+a&quot;...&quot;ctrl+z&quot;, &quot;alt+h&quot;, &quot;alt+enter&quot;,\n// single runes: &quot;a&quot;, &quot;/&quot;, &quot;1&quot;, etc.\nfunc Key(k string) tea.KeyMsg\n\n// Keys builds a slice of tea.Msg from multiple key strings.\nfunc Keys(keys ...string) []tea.Msg\n\n// WindowSize builds a tea.WindowSizeMsg with the given dimensions.\nfunc WindowSize(w, h int) tea.WindowSizeMsg\n\n// MouseClick builds a tea.MouseMsg for a left-button click at (x, y).\nfunc MouseClick(x, y int) tea.MouseMsg\n\n// MouseClickRight builds a tea.MouseMsg for a right-button click at (x, y).\nfunc MouseClickRight(x, y int) tea.MouseMsg\n\n// MouseScroll builds a tea.MouseMsg for a scroll event.\n// Direction constants: ScrollUp, ScrollDown, ScrollLeft, ScrollRight.\nfunc MouseScroll(dir ScrollDir) tea.MouseMsg\n\n// MouseRelease builds a tea.MouseMsg for a button release at (x, y).\nfunc MouseRelease(x, y int) tea.MouseMsg\n```\n\n### Model Harness (`harness.go`)\n\nSend messages to bubbletea models and handle commands.\n\n```go\n// Send sends messages to a model sequentially, returns the final model.\n// Preserves concrete type via generics -- no type assertion needed.\n// Panics if Update returns a different type (broken implementation).\n// Init() is NOT called.\nfunc Send[M tea.Model](model M, msgs ...tea.Msg) M\n\n// SendAndCollect sends messages, collects all non-nil Cmds returned by Update.\n// Returns final model + collected commands.\nfunc SendAndCollect[M tea.Model](model M, msgs ...tea.Msg) (M, []tea.Cmd)\n\n// ExecCmds executes tea.Cmd functions synchronously, collects resulting messages.\n// Recursively handles tea.BatchMsg. Nil cmds/messages are skipped.\nfunc ExecCmds(cmds ...tea.Cmd) []tea.Msg\n```\n\n**Common pattern -- command pipeline:**\n\n```go\nm, cmds := tuitestkit.SendAndCollect(m, tuitestkit.Key(&quot;r&quot;))\nmsgs := tuitestkit.ExecCmds(cmds...)\nm = tuitestkit.Send(m, msgs...)\n```\n\n### Reducer Harness (`reducer.go`)\n\nTable-driven testing for pure reducer functions.\n\n```go\n// ReducerTest defines a single test case for a pure reducer.\n// S = state type, A = action type.\ntype ReducerTest[S any, A any] struct {\n    Name    string\n    Initial S\n    Action  A\n    Assert  func(t *testing.T, got S)\n}\n\n// Step defines one step in a multi-action reducer sequence.\n// Assert is optional -- if nil, applied without per-step validation.\ntype Step[S any, A any] struct {\n    Name   string\n    Action A\n    Assert func(t *testing.T, got S)\n}\n\n// ReducerSequence defines a multi-step test scenario.\n// Actions applied sequentially from Initial. Final runs on end state.\ntype ReducerSequence[S, A any] struct {\n    Name    string\n    Initial S\n    Steps   []Step[S, A]\n    Final   func(t *testing.T, got S)\n}\n\n// RunReducerTests executes table-driven reducer tests as subtests.\nfunc RunReducerTests[S, A any](t *testing.T, reduce func(S, A) S, tests []ReducerTest[S, A])\n\n// RunReducerSequences executes multi-step sequence tests.\n// Per-step Assert runs after each step (if non-nil). Final runs on end state.\nfunc RunReducerSequences[S, A any](t *testing.T, reduce func(S, A) S, sequences []ReducerSequence[S, A])\n```\n\n**Invariant checking:**\n\n```go\n// Invariant defines a property that must hold for any state.\ntype Invariant[S any] struct {\n    Name  string\n    Check func(s S) error\n}\n\n// InvariantChecker holds invariants and validates state against all of them.\ntype InvariantChecker[S any] struct { /* ... */ }\n\n// NewInvariantChecker creates a checker with the given invariants.\nfunc NewInvariantChecker[S any](invariants ...Invariant[S]) *InvariantChecker[S]\n\n// Check validates state against all invariants. Returns combined error or nil.\nfunc (ic *InvariantChecker[S]) Check(s S) error\n\n// WrapWithInvariants wraps a reducer with invariant checking.\n// After every reduce call, all invariants are validated.\n// t.Fatalf on violation.\nfunc WrapWithInvariants[S, A any](t *testing.T, reduce func(S, A) S, checker *InvariantChecker[S]) func(S, A) S\n```\n\n**Example:**\n\n```go\nchecker := tuitestkit.NewInvariantChecker(\n    tuitestkit.Invariant[AppState]{\n        Name: &quot;cursor in bounds&quot;,\n        Check: func(s AppState) error {\n            if s.Cursor &lt; 0 || s.Cursor &gt;= len(s.Items) {\n                return fmt.Errorf(&quot;cursor %d out of [0, %d)&quot;, s.Cursor, len(s.Items))\n            }\n            return nil\n        },\n    },\n)\nsafeReduce := tuitestkit.WrapWithInvariants(t, Reduce, checker)\ntuitestkit.RunReducerTests(t, safeReduce, tests)\n```\n\n### Mock Building Blocks (`mock.go`)\n\nComposable primitives for building project-specific mocks.\n\n```go\n// MockCall represents a single recorded method invocation.\ntype MockCall struct {\n    Method string\n    Args   []any\n}\n\n// MockCallRecorder provides thread-safe recording of method calls.\n// Embed into project-specific mock structs.\ntype MockCallRecorder struct { /* ... */ }\n\nfunc (r *MockCallRecorder) Record(method string, args ...any)\nfunc (r *MockCallRecorder) CallCount(method string) int\nfunc (r *MockCallRecorder) Calls() []MockCall\nfunc (r *MockCallRecorder) CallsFor(method string) []MockCall\nfunc (r *MockCallRecorder) Reset()\n\n// MockResponseMap provides thread-safe canned response storage.\ntype MockResponseMap struct { /* ... */ }\n\nfunc NewMockResponseMap() *MockResponseMap\nfunc (m *MockResponseMap) Set(key string, data []byte, err error)\nfunc (m *MockResponseMap) Get(key string) ([]byte, error)\nfunc (m *MockResponseMap) SetError(key string, err error)\n\n// Assertion helpers\nfunc AssertCalled(t testing.TB, r *MockCallRecorder, method string)\nfunc AssertNotCalled(t testing.TB, r *MockCallRecorder, method string)\nfunc AssertCalledN(t testing.TB, r *MockCallRecorder, method string, n int)\nfunc AssertCalledWith(t testing.TB, r *MockCallRecorder, method string, args ...any)\n```\n\n**Building a mock (two lines per method):**\n\n```go\ntype TaskBoardMock struct {\n    tuitestkit.MockCallRecorder\n    Responses *tuitestkit.MockResponseMap\n}\n\nfunc NewTaskBoardMock() *TaskBoardMock {\n    return &amp;TaskBoardMock{Responses: tuitestkit.NewMockResponseMap()}\n}\n\nfunc (m *TaskBoardMock) TreeJSON() ([]byte, error) {\n    m.Record(&quot;TreeJSON&quot;)\n    return m.Responses.Get(&quot;TreeJSON&quot;)\n}\n\nfunc (m *TaskBoardMock) Execute(cmd string, args ...string) ([]byte, error) {\n    m.Record(&quot;Execute&quot;, cmd, args)\n    return m.Responses.Get(&quot;Execute:&quot; + cmd)\n}\n```\n\n### View Assertions (`view.go`)\n\nAssert on rendered output. All functions strip ANSI escape codes before comparison.\n\n```go\n// StripANSI removes all ANSI escape sequences from a string.\nfunc StripANSI(s string) string\n\n// --- Model-based (call model.View() internally) ---\n\nfunc ViewContains(t testing.TB, model tea.Model, text string)\nfunc ViewNotContains(t testing.TB, model tea.Model, text string)\nfunc ViewLines(model tea.Model) []string\nfunc ViewLineContains(t testing.TB, model tea.Model, lineIdx int, text string)\nfunc ViewLineEquals(t testing.TB, model tea.Model, lineIdx int, text string)\nfunc ViewMatchesRegex(t testing.TB, model tea.Model, pattern string)\n\n// --- String-based (when you already have the view string) ---\n\nfunc ContainsStr(t testing.TB, view string, text string)\nfunc NotContainsStr(t testing.TB, view string, text string)\nfunc LinesFromStr(view string) []string\nfunc MatchesRegexStr(t testing.TB, view string, pattern string)\n```\n\n### Snapshot Testing (`snapshot.go`)\n\nGolden file comparison for visual regression testing.\n\n```go\n// UpdateSnapshots controls whether snapshots are written (true) or compared (false).\n// Set via UPDATE_SNAPSHOTS=1 environment variable.\nvar UpdateSnapshots bool\n\n// SnapshotView captures model.View(), strips ANSI, compares against golden file.\nfunc SnapshotView(t *testing.T, model tea.Model, name string)\n\n// SnapshotViewRaw captures model.View() with raw ANSI codes intact.\nfunc SnapshotViewRaw(t *testing.T, model tea.Model, name string)\n\n// SnapshotStr compares a pre-rendered string (ANSI-stripped) against golden file.\nfunc SnapshotStr(t *testing.T, view string, name string)\n\n// SnapshotStrRaw compares a pre-rendered string (raw ANSI) against golden file.\nfunc SnapshotStrRaw(t *testing.T, view string, name string)\n```\n\nGolden files stored at `testdata/snapshots/&lt;name&gt;.golden` relative to the test file.\n\n```bash\n# Create or update golden files\nUPDATE_SNAPSHOTS=1 go test ./...\n\n# Update for a single package\nUPDATE_SNAPSHOTS=1 go test ./internal/ui/screens/board/ -run TestSnapshot\n```\n\nMismatches produce a line-by-line diff with `-`/`+` markers.\n\n---\n\n## Closed-Loop Workflow\n\nThe agent development cycle for writing tests:\n\n```\n1. UNDERSTAND: Read screen/component code\n2. IDENTIFY:   What behaviors need tests?\n3. EXTRACT:    If exec.Command present, extract to interface (use mock template)\n4. WRITE:      Tests using tuitestkit helpers\n5. RUN:        go test ./... -v\n6. VALIDATE:   All pass? Check coverage with go test -cover\n7. FIX:        If failures, read error, fix code or test, goto 5\n8. SNAPSHOT:   Optionally capture view golden files\n9. DONE:       Tests green, coverage acceptable\n```\n\n### Step Details\n\n**UNDERSTAND:** Read the component source. Identify:\n- What state does it manage?\n- What messages does it handle in Update?\n- Does it have a pure reducer (`func(State, Action) State`)?\n- Does it shell out to external commands (exec.Command)?\n- What does View() render?\n\n**IDENTIFY:** Map behaviors to test levels:\n- Pure state logic -&gt; Level 1 (reducer tests)\n- Key bindings, view rendering -&gt; Level 2 (component tests)\n- Data loading, command execution -&gt; Level 3 (integration tests with mocks)\n- Visual appearance -&gt; Level 4 (snapshot tests)\n\n**EXTRACT:** If the component uses `exec.Command` or any I/O directly:\n1. Define an interface with only the methods this component needs\n2. Move `exec.Command` calls to a production implementation\n3. Build a mock using `MockCallRecorder` + `MockResponseMap`\n4. See `assets/templates/executor_interface.go.tmpl` and `assets/templates/mock_executor.go.tmpl`\n\n**WRITE:** Use the appropriate tuitestkit helpers per level:\n- Level 1: `RunReducerTests`, `RunReducerSequences`, `WrapWithInvariants`\n- Level 2: `Send`, `ViewContains`, `ViewLines`, `Key`, `MouseClick`\n- Level 3: `SendAndCollect`, `ExecCmds`, `AssertCalled`, `AssertCalledWith`\n- Level 4: `SnapshotView`, `SnapshotStr`\n\n**RUN:** `go test ./... -v` -- all tests must run in under 1 second (no I/O, no network).\n\n**VALIDATE:** `go test ./... -cover` -- target 80%+ for code under test.\n\n**FIX:** Read error messages carefully. Common issues:\n- Type assertion panic -&gt; `Update` returns wrong type (broken implementation)\n- View assertion failure -&gt; check ANSI stripping, check exact text\n- Snapshot mismatch -&gt; run with `UPDATE_SNAPSHOTS=1` if the change is intentional\n- Mock assertion failure -&gt; check response key matches (`&quot;Execute:list&quot;` not `&quot;Execute&quot;`)\n\n---\n\n## Templates\n\nScaffolding templates in `assets/templates/`:\n\n| Template | Purpose |\n|----------|---------|\n| `reducer_test.go.tmpl` | Table-driven reducer tests with invariants |\n| `component_test.go.tmpl` | Component model tests (keyboard, mouse, commands, view) |\n| `snapshot_test.go.tmpl` | Snapshot golden file tests |\n| `executor_interface.go.tmpl` | Executor interface + production stub |\n| `mock_executor.go.tmpl` | Mock executor using MockCallRecorder + MockResponseMap |\n| `PROJECT_STRUCTURE.md` | Recommended directory layout for test files |\n\nCopy templates into your project, replace `TODO` markers with your actual types and import paths.\n\n---\n\n## References\n\nIn-depth documentation in `references/`:\n\n| Document | Content |\n|----------|---------|\n| `elm-architecture.md` | Why Elm makes TUI testable, state/action/reducer/view cycle, nested reducers, dependency injection, the executor pattern |\n| `mock-patterns.md` | Interface extraction, when to mock vs test pure functions, stubs vs mocks vs fakes, callback capture, full mock lifecycle example |\n| `testing-pyramid.md` | All 5 test levels with code examples, decision table for which level to use, coverage strategy |\n\n---\n\n## Setup\n\nRun the setup script to create symlinks:\n\n```bash\n./scripts/setup.sh\n```\n\nThis links the skill to `~/.agents/skills/go-testing-tools`, `~/.claude/skills/go-testing-tools`, and `~/.codex/skills/go-testing-tools`.\n\nTo remove:\n\n```bash\n./scripts/deinit.sh\n```\n\n</skill-body>\n</read-skill-result>","correlation_facts":{"tool_name":"read_skill","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4d3","stream":{"kind":"session","id":"01a06e98-2a6f-7230-81f2-5355ec816701"},"sequence":196,"recorded_at":1780531400000387,"record_type":"event","durability":"durable","causation_id":"e5781de4-97b1-4e5e-9466-20c1d6e7652b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e5781de4-97b1-4e5e-9466-20c1d6e7652b","run_stream":{"kind":"run","id":"e5781de4-97b1-4e5e-9466-20c1d6e7652b"},"call_id":"call_01a06e98a98c73528b85f7414255597e","text":"Read text file `internal/provider/provider.go`.\n1|package provider\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"crypto/subtle\"\n6|\t\"fmt\"\n7|\t\"path/filepath\"\n8|\t\"sort\"\n9|\t\"strings\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// Stable Structured Error codes this package reports. Discovery-shape\n15|// refusals (duplicates, malformed names, non-regular targets, unapproved\n16|// owners, relative directories) report invalid_config; a filesystem read\n17|// that cannot establish the discovery or verification preconditions reports\n18|// local_precondition_failed; a trust receipt that no longer matches freshly\n19|// read facts reports integrity_failure. The duplicate mapping is mandated by\n20|// Section 7.1; the other two are derived mappings documented on the\n21|// constructors, because Section 7.1 names no code for those cases.\n22|const (\n23|\tcodeInvalidConfig     = \"invalid_config\"\n24|\tcodeLocalPrecondition = \"local_precondition_failed\"\n25|\tcodeIntegrityFailure  = \"integrity_failure\"\n26|)\n27|\n28|// Error is the only error this package produces. Code carries the stable\n29|// registry code above; Detail names the offending provider ID, path, or\n30|// trust dimension in human text automation must never branch on; Cause\n31|// preserves the underlying filesystem failure for errors.Is and errors.As.\n32|type Error struct {\n33|\tcode   string\n34|\tdetail string\n35|\tcause  error\n36|}\n37|\n38|// Code reports the stable registry code for this refusal.\n39|func (err Error) Code() string { return err.code }\n40|\n41|// Detail reports the human-text detail for this refusal.\n42|func (err Error) Detail() string { return err.detail }\n43|\n44|// Unwrap exposes the underlying filesystem cause, if one was recorded.\n45|func (err Error) Unwrap() error { return err.cause }\n46|\n47|func (err Error) Error() string {\n48|\tif err.cause == nil {\n49|\t\treturn \"provider \" + err.code + \": \" + err.detail\n50|\t}\n51|\treturn \"provider \" + err.code + \": \" + err.detail + \": \" + err.cause.Error()\n52|}\n53|\n54|// The four refusal constructors below are declared as variables so the\n55|// refusal-inventory gate can observe every exercised refusal site. Each is\n56|// the single construction site for its failure class; production code must\n57|// not build Error values or wrap filesystem errors any other way.\n58|//\n59|// failDuplicate reports the Section 7.1 duplicate-ID refusal with the\n60|// section-mandated invalid_config code.\n61|//\n62|// failInvalid reports a discovery-shape refusal: a malformed plugin name, a\n63|// non-regular target, an unapproved owner, a relative directory, or a Trust\n64|// call on a builtin adapter. These are operator-configuration or caller\n65|// errors, so they share the invalid_config code.\n66|//\n67|// failPrecondition reports a filesystem read failure during discovery: an\n68|// unreadable plugin directory, an unresolvable symlink, an unreadable\n69|// target, or unattainable ownership metadata. A failed read is never a\n70|// legitimate absence, so discovery aborts with local_precondition_failed\n71|// instead of yielding a partial candidate set.\n72|//\n73|// failIntegrity reports a trust receipt that no longer matches freshly read\n74|// facts, including a receipt whose facts cannot be re-read at all: a\n75|// changed path target or digest requires renewed trust, and an unreadable\n76|// file cannot prove it is unchanged.\n77|var failDuplicate = func(providerID, firstSource, secondSource string) Error {\n78|\treturn Error{\n79|\t\tcode:   codeInvalidConfig,\n80|\t\tdetail: fmt.Sprintf(\"duplicate provider %q from %s and %s\", providerID, firstSource, secondSource),\n81|\t}\n82|}\n83|\n84|var failInvalid = func(detail string) Error {\n85|\treturn Error{code: codeInvalidConfig, detail: detail}\n86|}\n87|\n88|var failPrecondition = func(detail string, cause error) Error {\n89|\treturn Error{code: codeLocalPrecondition, detail: detail, cause: cause}\n90|}\n91|\n92|var failIntegrity = func(detail string, cause error) Error {\n93|\treturn Error{code: codeIntegrityFailure, detail: detail, cause: cause}\n94|}\n95|\n96|// Kind distinguishes a built-in adapter from an external executable.\n97|type Kind string\n98|\n99|const (\n100|\t// KindBuiltin is an adapter compiled into the host. It has no\n101|\t// executable path, digest, or owner to trust.\n102|\tKindBuiltin Kind = \"builtin\"\n103|\t// KindExternal is an ax-provider-<id> executable discovered on the\n104|\t// filesystem and subject to trust recording and verification.\n105|\tKindExternal Kind = \"external\"\n106|)\n107|\n108|// ExecutablePrefix is the Section 7.1 external executable name prefix. The\n109|// suffix is a provider ID in the scalar provider-id grammar.\n110|const ExecutablePrefix = \"ax-provider-\"\n111|\n112|// builtinOrder is the Section 7.1 built-in set in the section's listed\n113|// order. The order is a discovery enumeration order only; Section 7.1\n114|// states the order does not establish precedence.\n115|var builtinOrder = []string{\"codex\", \"claude\", \"gemini\", \"muse\", \"antigravity\", \"pi\"}\n116|\n117|// Builtins returns the Section 7.1 built-in provider IDs in discovery\n118|// order. The result is a copy; the registry cannot be mutated through it.\n119|func Builtins() []string {\n120|\treturn append([]string(nil), builtinOrder...)\n121|}\n122|\n123|// Config carries the operator inputs Discover consumes. PluginDirs maps to\n124|// providers.plugin_dirs in listed order and AllowPathPlugins to\n125|// providers.allow_path_plugins; both arrive already parsed by\n126|// internal/config, which additionally enforces absolute directories and\n127|// require_explicit_trust. Platform is the host AX platform the paths are\n128|// evaluated on.\n129|type Config struct {\n130|\tPlatform         scalar.Platform\n131|\tPluginDirs       []string\n132|\tAllowPathPlugins bool\n133|}\n134|\n135|// OwnerPolicy decides whether a filesystem UID may own a trusted external\n136|// executable. OperatorUID is the operator's own identity;\n137|// AdministratorUIDs are the additional administrator-approved identities,\n138|// if the host configures any. An empty administrator set trusts the\n139|// operator alone; no superuser exception is implied.\n140|type OwnerPolicy struct {\n141|\tOperatorUID       uint32\n142|\tAdministratorUIDs []uint32\n143|}\n144|\n145|// Approves reports whether uid may own a trusted executable.\n146|func (policy OwnerPolicy) Approves(uid uint32) bool {\n147|\tif uid == policy.OperatorUID {\n148|\t\treturn true\n149|\t}\n150|\tfor _, admin := range policy.AdministratorUIDs {\n151|\t\tif uid == admin {\n152|\t\t\treturn true\n153|\t\t}\n154|\t}\n155|\treturn false\n156|}\n157|\n158|// OwnerIdentity renders a UID in the stable form TrustRecord stores.\n159|func (policy OwnerPolicy) OwnerIdentity(uid uint32) string {\n160|\treturn fmt.Sprintf(\"uid:%d\", uid)\n161|}\n162|\n163|// FileInfo is the ownership and shape fact System.Inspect reports for one\n164|// path. UID is the owning identity of the symlink target.\n165|type FileInfo struct {\n166|\tIsRegular bool\n167|\tUID       uint32\n168|}\n169|\n170|// System is the filesystem seam Discover and Verify read through.\n171|// Production code supplies OSSystem; tests supply a scripted fake. Every\n172|// method reports a failed or partial read as an error, never as an empty\n173|// result the caller could mistake for absence.\n174|type System interface {\n175|\t// ReadDir returns the entry names of dir, unsorted.\n176|\tReadDir(dir string) ([]string, error)\n177|\t// Canonicalize resolves dir against an absolute base and every\n178|\t// symlink in the path, returning the canonical absolute target.\n179|\tCanonicalize(path string) (string, error)\n180|\t// Inspect stats the symlink target at an already-canonical path.\n181|\tInspect(canonical string) (FileInfo, error)\n182|\t// ReadFile returns the full bytes of the symlink target at an\n183|\t// already-canonical path.\n184|\tReadFile(canonical string) ([]byte, error)\n185|\t// PathDirs returns the PATH search directories in listed order.\n186|\tPathDirs() []string\n187|}\n188|\n189|// Candidate is one discovered provider. External candidates carry the\n190|// trust-time facts Section 7.1 requires: the canonical absolute executable\n191|// path, the SHA-256 digest of its bytes, and the approving owner identity.\n192|// Builtin candidates carry none of those; the zero accessors report\n193|// absence. A Candidate carries no availability, status, or capability\n194|// claim: discovery never advertises what the probe plane has not proven.\n195|type Candidate struct {\n196|\tid     string\n197|\tkind   Kind\n198|\tsource string\n199|\tpath   string\n200|\tcanon  string\n201|\tdigest scalar.Digest\n202|\towner  string\n203|}\n204|\n205|// ID reports the provider ID this candidate declares.\n206|func (candidate Candidate) ID() string { return candidate.id }\n207|\n208|// Kind reports whether this candidate is built-in or external.\n209|func (candidate Candidate) Kind() Kind { return candidate.kind }\n210|\n211|// Source names where the candidate was found: plugin_dirs[i], builtin, or\n212|// path. It is a diagnostic label, not a precedence rank.\n213|func (candidate Candidate) Source() string { return candidate.source }\n214|\n215|// SourcePath reports the undisguised discovery path of an external\n216|// candidate: the plugin or PATH directory joined with the executable name.\n217|// Verify re-resolves this path to detect symlink retargeting.\n218|func (candidate Candidate) SourcePath() (string, bool) {\n219|\tif candidate.kind != KindExternal {\n220|\t\treturn \"\", false\n221|\t}\n222|\treturn candidate.path, true\n223|}\n224|\n225|// CanonicalPath reports the symlink-resolved absolute target recorded at\n226|// trust time for an external candidate.\n227|func (candidate Candidate) CanonicalPath() (string, bool) {\n228|\tif candidate.kind != KindExternal {\n229|\t\treturn \"\", false\n230|\t}\n231|\treturn candidate.canon, true\n232|}\n233|\n234|// Digest reports the SHA-256 digest of the target bytes recorded at trust\n235|// time for an external candidate.\n236|func (candidate Candidate) Digest() (scalar.Digest, bool) {\n237|\tif candidate.kind != KindExternal {\n238|\t\treturn scalar.Digest{}, false\n239|\t}\n240|\treturn candidate.digest, true\n241|}\n242|\n243|// Owner reports the approving owner identity recorded at trust time for an\n244|// external candidate.\n245|func (candidate Candidate) Owner() (string, bool) {\n246|\tif candidate.kind != KindExternal {\n247|\t\treturn \"\", false\n248|\t}\n249|\treturn candidate.owner, true\n250|}\n251|\n252|// TrustRecord is the trust-time receipt for one accepted external\n253|// candidate: the canonical absolute executable path and SHA-256 digest\n254|// Section 7.1 requires, plus the undisguised discovery path Verify\n255|// re-resolves, the approving owner identity, and the trust instant. The\n256|// host persists this receipt; Verify rechecks it.\n257|type TrustRecord struct {\n258|\tproviderID string\n259|\tsourcePath string\n260|\tcanon      string\n261|\tdigest     scalar.Digest\n262|\towner      string\n263|\ttrustedAt  scalar.Timestamp\n264|}\n265|\n266|// ProviderID reports the trusted provider ID.\n267|func (record TrustRecord) ProviderID() string { return record.providerID }\n268|\n269|// SourcePath reports the undisguised discovery path Verify re-resolves.\n270|func (record TrustRecord) SourcePath() string { return record.sourcePath }\n271|\n272|// CanonicalPath reports the recorded canonical absolute target.\n273|func (record TrustRecord) CanonicalPath() string { return record.canon }\n274|\n275|// Digest reports the recorded SHA-256 digest of the target bytes.\n276|func (record TrustRecord) Digest() scalar.Digest { return record.digest }\n277|\n278|// Owner reports the recorded approving owner identity.\n279|func (record TrustRecord) Owner() string { return record.owner }\n280|\n281|// TrustedAt reports the trust instant.\n282|func (record TrustRecord) TrustedAt() scalar.Timestamp { return record.trustedAt }\n283|\n284|// externalID splits an ax-provider-<id> file name. It reports false for\n285|// names outside the prefix so ordinary directory entries are skipped; a\n286|// prefixed name whose suffix fails the provider-id grammar is a malformed\n287|// candidate, reported as an error rather than silently skipped.\n288|func externalID(name string) (string, bool, error) {\n289|\tsuffix, found := strings.CutPrefix(name, ExecutablePrefix)\n290|\tif !found {\n291|\t\treturn \"\", false, nil\n292|\t}\n293|\tif _, err := scalar.ParseProviderID(suffix); err != nil {\n294|\t\treturn \"\", false, err\n295|\t}\n296|\treturn suffix, true, nil\n297|}\n298|\n299|// Discover deterministically enumerates provider candidates in the Section\n300|// 7.1 source order: configured plugin directories in listed order (entry\n301|// names sorted bytewise within each directory, because filesystem order is\n302|// not deterministic), then built-in adapters in registry order, then PATH\n303|// directories in listed order only when AllowPathPlugins is true. Both\n304|// configured plugin directories and PATH entries must be absolute paths:\n305|// a relative entry fails with invalid_config instead of resolving against\n306|// the process working directory.\n307|//\n308|// Discover never probes or executes a candidate, so the duplicate refusal\n309|// below happens before either by construction: the function has no probe\n310|// or execution dependency to invoke. If two candidates declare the same\n311|// provider ID, Discover fails with invalid_config naming both sources; the\n312|// operator must remove or rename one candidate. There is no\n313|// duplicate-selection override, including for byte-identical observations\n314|// of one file through two directories.\n315|//\n316|// Every accepted external candidate records its canonical absolute path,\n317|// SHA-256 digest, and approving owner at trust time: symlinks are resolved\n318|// before comparison, the target must be a regular file, and its owner must\n319|// satisfy policy. A matching directory entry that cannot become an\n320|// accepted candidate (malformed name, unresolvable link, non-regular\n321|// target, unapproved owner) fails discovery instead of being skipped,\n322|// because a skipped trust check would silently narrow the trust boundary.\n323|// Filesystem read failures abort discovery instead of yielding a partial\n324|// set. Discover holds no state and starts no process.\n325|func Discover(cfg Config, owner OwnerPolicy, system System) ([]Candidate, error) {\n326|\tseen := make(map[string]string)\n327|\tvar out []Candidate\n328|\tadd := func(candidate Candidate) error {\n329|\t\tif first, duplicate := seen[candidate.id]; duplicate {\n330|\t\t\treturn failDuplicate(candidate.id, first, candidate.source)\n331|\t\t}\n332|\t\tseen[candidate.id] = candidate.source\n333|\t\tout = append(out, candidate)\n334|\t\treturn nil\n335|\t}\n336|\tfor index, dir := range cfg.PluginDirs {\n337|\t\tif _, err := scalar.ParseAbsolutePath(cfg.Platform, dir); err != nil {\n338|\t\t\treturn nil, failInvalid(fmt.Sprintf(\"providers.plugin_dirs[%d] %q is not an absolute path\", index, dir))\n339|\t\t}\n340|\t\tsource := fmt.Sprintf(\"plugin_dirs[%d]\", index)\n341|\t\tif err := collectDirectory(owner, system, dir, source, add); err != nil {\n342|\t\t\treturn nil, err\n343|\t\t}\n344|\t}\n345|\tfor _, id := range builtinOrder {\n346|\t\tif err := add(Candidate{id: id, kind: KindBuiltin, source: \"builtin\"}); err != nil {\n347|\t\t\treturn nil, err\n348|\t\t}\n349|\t}\n350|\tif cfg.AllowPathPlugins {\n351|\t\tfor index, dir := range system.PathDirs() {\n352|\t\t\tif _, err := scalar.ParseAbsolutePath(cfg.Platform, dir); err != nil {\n353|\t\t\t\treturn nil, failInvalid(fmt.Sprintf(\"PATH[%d] %q is not an absolute path\", index, dir))\n354|\t\t\t}\n355|\t\t\tif err := collectDirectory(owner, system, dir, \"path\", add); err != nil {\n356|\t\t\t\treturn nil, err\n357|\t\t\t}\n358|\t\t}\n359|\t}\n360|\treturn out, nil\n361|}\n362|\n363|// collectDirectory folds every ax-provider-<id> entry of one directory into\n364|// add in bytewise name order. PATH entries reuse this path, so both sources\n365|// enforce the same trust checks; only the diagnostic source label differs.\n366|func collectDirectory(owner OwnerPolicy, system System, dir, source string, add func(Candidate) error) error {\n367|\tnames, err := system.ReadDir(dir)\n368|\tif err != nil {\n369|\t\treturn failPrecondition(fmt.Sprintf(\"cannot list %s directory %q\", source, dir), err)\n370|\t}\n371|\tsort.Strings(names)\n372|\tfor _, name := range names {\n373|\t\tid, candidate, err := externalID(name)\n374|\t\tif err != nil {\n375|\t\t\treturn failInvalid(fmt.Sprintf(\"%s entry %q is not a provider executable name: %v\", source, filepath.Join(dir, name), err))\n376|\t\t}\n377|\t\tif !candidate {\n378|\t\t\tcontinue\n379|\t\t}\n380|\t\tfound, err := trustCandidate(owner, system, id, filepath.Join(dir, name), source)\n381|\t\tif err != nil {\n382|\t\t\treturn err\n383|\t\t}\n384|\t\tif err := add(found); err != nil {\n385|\t\t\treturn err\n386|\t\t}\n387|\t}\n388|\treturn nil\n389|}\n390|\n391|// trustCandidate establishes the trust-time facts for one external\n392|// executable: symlink resolution before comparison, regular-file target,\n393|// approved owner, and digest over the target bytes.\n394|func trustCandidate(owner OwnerPolicy, system System, id, path, source string) (Candidate, error) {\n395|\tcanon, err := system.Canonicalize(path)\n396|\tif err != nil {\n397|\t\treturn Candidate{}, failPrecondition(fmt.Sprintf(\"cannot resolve provider %q at %q\", id, path), err)\n398|\t}\n399|\tinfo, err := system.Inspect(canon)\n400|\tif err != nil {\n401|\t\treturn Candidate{}, failPrecondition(fmt.Sprintf(\"cannot inspect provider %q target %q\", id, canon), err)\n402|\t}\n403|\tif !info.IsRegular {\n404|\t\treturn Candidate{}, failInvalid(fmt.Sprintf(\"provider %q target %q is not a regular file\", id, canon))\n405|\t}\n406|\tif !owner.Approves(info.UID) {\n407|\t\treturn Candidate{}, failInvalid(fmt.Sprintf(\"provider %q target %q is owned by %s, which the trust policy does not approve\", id, canon, owner.OwnerIdentity(info.UID)))\n408|\t}\n409|\tcontent, err := system.ReadFile(canon)\n410|\tif err != nil {\n411|\t\treturn Candidate{}, failPrecondition(fmt.Sprintf(\"cannot digest provider %q target %q\", id, canon), err)\n412|\t}\n413|\tdigest := scalar.SHA256Digest(content)\n414|\treturn Candidate{\n415|\t\tid:     id,\n416|\t\tkind:   KindExternal,\n417|\t\tsource: source,\n418|\t\tpath:   path,\n419|\t\tcanon:  canon,\n420|\t\tdigest: digest,\n421|\t\towner:  owner.OwnerIdentity(info.UID),\n422|\t}, nil\n423|}\n424|\n425|// Trust records the trust receipt for one accepted external candidate.\n426|// Trusting a builtin adapter is refused: it has no executable bytes to\n427|// record. Trust is pure: identical inputs return identical receipts.\n428|func Trust(candidate Candidate, trustedAt scalar.Timestamp) (TrustRecord, error) {\n429|\tif candidate.kind != KindExternal {\n430|\t\treturn TrustRecord{}, failInvalid(fmt.Sprintf(\"provider %q is a builtin adapter with no executable to trust\", candidate.id))\n431|\t}\n432|\treturn TrustRecord{\n433|\t\tproviderID: candidate.id,\n434|\t\tsourcePath: candidate.path,\n435|\t\tcanon:      candidate.canon,\n436|\t\tdigest:     candidate.digest,\n437|\t\towner:      candidate.owner,\n438|\t\ttrustedAt:  trustedAt,\n439|\t}, nil\n440|}\n441|\n442|// Verify rechecks a trust receipt against freshly read filesystem facts. A\n443|// changed path target or digest requires renewed trust: any mismatch in\n444|// the re-resolved canonical path, the target shape, the approving owner,\n445|// or the digest fails with integrity_failure, as does any read failure,\n446|// because an unreadable file cannot prove it is unchanged. Verify holds no\n447|// state and starts no process; repeated verification over an unchanged\n448|// tree succeeds identically.\n449|func Verify(record TrustRecord, owner OwnerPolicy, system System) error {\n450|\tcanon, err := system.Canonicalize(record.sourcePath)\n451|\tif err != nil {\n452|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q trust receipt cannot be re-resolved and requires renewed trust\", record.providerID), err)\n453|\t}\n454|\tif canon != record.canon {\n455|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable target changed from %q to %q and requires renewed trust\", record.providerID, record.canon, canon), nil)\n456|\t}\n457|\tinfo, err := system.Inspect(canon)\n458|\tif err != nil {\n459|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable target %q cannot be re-inspected and requires renewed trust\", record.providerID, canon), err)\n460|\t}\n461|\tif !info.IsRegular {\n462|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable target %q is no longer a regular file and requires renewed trust\", record.providerID, canon), nil)\n463|\t}\n464|\tif identity := owner.OwnerIdentity(info.UID); !owner.Approves(info.UID) || identity != record.owner {\n465|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable owner is now %s and requires renewed trust\", record.providerID, identity), nil)\n466|\t}\n467|\tcontent, err := system.ReadFile(canon)\n468|\tif err != nil {\n469|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable target %q cannot be re-read and requires renewed trust\", record.providerID, canon), err)\n470|\t}\n471|\tsum := sha256.Sum256(content)\n472|\tif subtle.ConstantTimeCompare(sum[:], digestBytes(record.digest)) != 1 {\n473|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable digest changed and requires renewed trust\", record.providerID), nil)\n474|\t}\n475|\treturn nil\n476|}\n477|\n478|// digestBytes decodes the recorded digest for constant-time comparison. A\n479|// TrustRecord always carries a digest produced by SHA256Digest, so the\n480|// decode cannot fail; a receipt that does not decode compares unequal\n481|// rather than panicking.\n482|func digestBytes(digest scalar.Digest) []byte {\n483|\traw := digest.Hex()\n484|\tif len(raw) != sha256.Size*2 {\n485|\t\treturn nil\n486|\t}\n487|\tdecoded := make([]byte, sha256.Size)\n488|\tfor i := range decoded {\n489|\t\thi := unhex(raw[2*i])\n490|\t\tlo := unhex(raw[2*i+1])\n491|\t\tif hi > 15 || lo > 15 {\n492|\t\t\treturn nil\n493|\t\t}\n494|\t\tdecoded[i] = hi<<4 | lo\n495|\t}\n496|\treturn decoded\n497|}\n498|\n499|func unhex(c byte) byte {\n500|\tswitch {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
