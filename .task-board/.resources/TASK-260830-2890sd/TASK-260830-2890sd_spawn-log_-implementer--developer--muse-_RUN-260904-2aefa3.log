{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c53d","stream":{"kind":"session","id":"01a06e98-2a6f-7230-81f2-5355ec816701"},"sequence":249,"recorded_at":1780531400000493,"record_type":"event","durability":"durable","causation_id":"e5781de4-97b1-4e5e-9466-20c1d6e7652b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e5781de4-97b1-4e5e-9466-20c1d6e7652b","run_stream":{"kind":"run","id":"e5781de4-97b1-4e5e-9466-20c1d6e7652b"},"call_id":"call_01a06e98b93275419a85bd9d9ca756d8","text":"Read text file `internal/provider/fake_test.go`.\n1|package provider\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"sort\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|)\n9|\n10|// fakeFile is the scripted target behind one canonical path.\n11|type fakeFile struct {\n12|\tcontent []byte\n13|\tuid     uint32\n14|\tregular bool\n15|}\n16|\n17|// fakeSystem scripts every System seam. Absent table entries are read\n18|// failures, never silent absences: Inspect and ReadFile fail on unknown\n19|// canonical paths, and Canonicalize fails on scripted paths.\n20|type fakeSystem struct {\n21|\tentries    map[string][]string\n22|\treadDirErr map[string]error\n23|\tcanon      map[string]string\n24|\tcanonErr   map[string]error\n25|\tfiles      map[string]fakeFile\n26|\tinspectErr map[string]error\n27|\tcontentErr map[string]error\n28|\tpathDirs   []string\n29|}\n30|\n31|func newFakeSystem() *fakeSystem {\n32|\treturn &fakeSystem{\n33|\t\tentries:    map[string][]string{},\n34|\t\treadDirErr: map[string]error{},\n35|\t\tcanon:      map[string]string{},\n36|\t\tcanonErr:   map[string]error{},\n37|\t\tfiles:      map[string]fakeFile{},\n38|\t\tinspectErr: map[string]error{},\n39|\t\tcontentErr: map[string]error{},\n40|\t}\n41|}\n42|\n43|// addFile registers dir/name as an executable target. Without linkTo, the\n44|// source path is its own canonical target.\n45|func (fake *fakeSystem) addFile(dir, name string, content []byte, uid uint32) string {\n46|\treturn fake.addLinkedFile(dir, name, \"\", content, uid, true)\n47|}\n48|\n49|// addLinkedFile registers dir/name resolving to linkTo (empty means\n50|// identity). The target is registered as a regular file unless regular is\n51|// false.\n52|func (fake *fakeSystem) addLinkedFile(dir, name, linkTo string, content []byte, uid uint32, regular bool) string {\n53|\tsource := dir + \"/\" + name\n54|\ttarget := linkTo\n55|\tif target == \"\" {\n56|\t\ttarget = source\n57|\t}\n58|\tfake.entries[dir] = append(fake.entries[dir], name)\n59|\tfake.canon[source] = target\n60|\tfake.files[target] = fakeFile{content: content, uid: uid, regular: regular}\n61|\treturn source\n62|}\n63|\n64|func (fake *fakeSystem) ReadDir(dir string) ([]string, error) {\n65|\tif err, ok := fake.readDirErr[dir]; ok {\n66|\t\treturn nil, err\n67|\t}\n68|\tnames, ok := fake.entries[dir]\n69|\tif !ok {\n70|\t\treturn nil, errors.New(\"fake: unknown directory \" + dir)\n71|\t}\n72|\t// Reverse the insertion order so tests prove Discover sorts rather\n73|\t// than inheriting filesystem order.\n74|\treversed := append([]string(nil), names...)\n75|\tsort.Sort(sort.Reverse(sort.StringSlice(reversed)))\n76|\treturn reversed, nil\n77|}\n78|\n79|func (fake *fakeSystem) Canonicalize(path string) (string, error) {\n80|\tif err, ok := fake.canonErr[path]; ok {\n81|\t\treturn \"\", err\n82|\t}\n83|\tif target, ok := fake.canon[path]; ok {\n84|\t\treturn target, nil\n85|\t}\n86|\treturn \"\", errors.New(\"fake: unresolvable path \" + path)\n87|}\n88|\n89|func (fake *fakeSystem) Inspect(canonical string) (FileInfo, error) {\n90|\tif err, ok := fake.inspectErr[canonical]; ok {\n91|\t\treturn FileInfo{}, err\n92|\t}\n93|\tfile, ok := fake.files[canonical]\n94|\tif !ok {\n95|\t\treturn FileInfo{}, errors.New(\"fake: unknown target \" + canonical)\n96|\t}\n97|\treturn FileInfo{IsRegular: file.regular, UID: file.uid}, nil\n98|}\n99|\n100|func (fake *fakeSystem) ReadFile(canonical string) ([]byte, error) {\n101|\tif err, ok := fake.contentErr[canonical]; ok {\n102|\t\treturn nil, err\n103|\t}\n104|\tfile, ok := fake.files[canonical]\n105|\tif !ok {\n106|\t\treturn nil, errors.New(\"fake: unknown target \" + canonical)\n107|\t}\n108|\treturn append([]byte(nil), file.content...), nil\n109|}\n110|\n111|func (fake *fakeSystem) PathDirs() []string {\n112|\treturn append([]string(nil), fake.pathDirs...)\n113|}\n114|\n115|const (\n116|\tfakeUID      uint32 = 1000\n117|\tforeignUID   uint32 = 2000\n118|\tadminUID     uint32 = 7\n119|\tfakePlatform        = scalar.PlatformLinux\n120|)\n121|\n122|func fakeOwner() OwnerPolicy {\n123|\treturn OwnerPolicy{OperatorUID: fakeUID}\n124|}\n125|\n126|func fakeConfig(dirs ...string) Config {\n127|\treturn Config{Platform: fakePlatform, PluginDirs: dirs}\n128|}\n129|\n130|func mustTimestamp(test testHelper, value string) scalar.Timestamp {\n131|\ttest.Helper()\n132|\tparsed, err := scalar.ParseTimestamp(value)\n133|\tif err != nil {\n134|\t\ttest.Fatalf(\"ParseTimestamp(%q): %v\", value, err)\n135|\t}\n136|\treturn parsed\n137|}\n138|\n139|// errorCode extracts the package Code from err, failing the test when err\n140|// is not a provider refusal.\n141|func errorCode(test testHelper, err error) string {\n142|\ttest.Helper()\n143|\tvar refusal Error\n144|\tif !errors.As(err, &refusal) {\n145|\t\ttest.Fatalf(\"error %v is not a provider Error\", err)\n146|\t}\n147|\treturn refusal.Code()\n148|}\n149|\n150|type testHelper interface {\n151|\tHelper()\n152|\tFatalf(format string, args ...any)\n153|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c53f","stream":{"kind":"session","id":"01a06e98-2a6f-7230-81f2-5355ec816701"},"sequence":250,"recorded_at":1780531400000495,"record_type":"event","durability":"durable","causation_id":"e5781de4-97b1-4e5e-9466-20c1d6e7652b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e5781de4-97b1-4e5e-9466-20c1d6e7652b","run_stream":{"kind":"run","id":"e5781de4-97b1-4e5e-9466-20c1d6e7652b"},"call_id":"call_01a06e98b99e70228dc56b431594fb3a","text":"Read text file `internal/provider/trust_test.go`.\n1|package provider\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|// errorDetail extracts the human-text detail from a provider refusal,\n12|// failing the test when err is not a provider Error.\n13|func errorDetail(test testHelper, err error) string {\n14|\ttest.Helper()\n15|\tvar refusal Error\n16|\tif !errors.As(err, &refusal) {\n17|\t\ttest.Fatalf(\"error %v is not a provider Error\", err)\n18|\t}\n19|\treturn refusal.Detail()\n20|}\n21|\n22|// errDiskGone scripts a target that exists for stat but fails on read.\n23|var errDiskGone = errors.New(\"fake: input/output error\")\n24|\n25|const trustInstant = \"2026-08-19T04:03:00.000Z\"\n26|\n27|// discoverOneFoo is the shared trust fixture: one external candidate foo.\n28|func discoverOneFoo(t *testing.T, fake *fakeSystem) Candidate {\n29|\tt.Helper()\n30|\tgot, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), fake)\n31|\tif err != nil {\n32|\t\tt.Fatalf(\"Discover: %v\", err)\n33|\t}\n34|\tfor _, candidate := range got {\n35|\t\tif candidate.ID() == \"foo\" {\n36|\t\t\treturn candidate\n37|\t\t}\n38|\t}\n39|\tt.Fatal(\"candidate foo missing\")\n40|\treturn Candidate{}\n41|}\n42|\n43|func trustOneFoo(t *testing.T, candidate Candidate) TrustRecord {\n44|\tt.Helper()\n45|\trecord, err := Trust(candidate, mustTimestamp(t, trustInstant))\n46|\tif err != nil {\n47|\t\tt.Fatalf(\"Trust: %v\", err)\n48|\t}\n49|\treturn record\n50|}\n51|\n52|// TestTrustRecordsCandidateFacts proves Trust copies every Section 7.1\n53|// trust-time fact from the accepted candidate, and that Trust is pure:\n54|// identical inputs return identical receipts.\n55|func TestTrustRecordsCandidateFacts(t *testing.T) {\n56|\tfake := newFakeSystem()\n57|\tfake.addLinkedFile(\"/plugins\", \"ax-provider-foo\", \"/opt/real/foo\", []byte(\"bytes\"), fakeUID, true)\n58|\tfirst := trustOneFoo(t, discoverOneFoo(t, fake))\n59|\tsecond := trustOneFoo(t, discoverOneFoo(t, fake))\n60|\n61|\tif first.ProviderID() != \"foo\" {\n62|\t\tt.Fatalf(\"ProviderID = %q, want foo\", first.ProviderID())\n63|\t}\n64|\tif first.SourcePath() != \"/plugins/ax-provider-foo\" {\n65|\t\tt.Fatalf(\"SourcePath = %q, want undisguised discovery path\", first.SourcePath())\n66|\t}\n67|\tif first.CanonicalPath() != \"/opt/real/foo\" {\n68|\t\tt.Fatalf(\"CanonicalPath = %q, want /opt/real/foo\", first.CanonicalPath())\n69|\t}\n70|\tif want := scalar.SHA256Digest([]byte(\"bytes\")); first.Digest() != want {\n71|\t\tt.Fatalf(\"Digest = %v, want %v\", first.Digest(), want)\n72|\t}\n73|\tif first.Owner() != \"uid:1000\" {\n74|\t\tt.Fatalf(\"Owner = %q, want uid:1000\", first.Owner())\n75|\t}\n76|\tif first.TrustedAt().String() != trustInstant {\n77|\t\tt.Fatalf(\"TrustedAt = %q, want %q\", first.TrustedAt(), trustInstant)\n78|\t}\n79|\tif first != second {\n80|\t\tt.Fatalf(\"Trust is not pure: %+v != %+v\", first, second)\n81|\t}\n82|}\n83|\n84|// TestTrustRefusesBuiltins proves a builtin adapter cannot be trusted: it\n85|// has no executable bytes to record.\n86|func TestTrustRefusesBuiltins(t *testing.T) {\n87|\tgot, err := Discover(fakeConfig(), fakeOwner(), newFakeSystem())\n88|\tif err != nil {\n89|\t\tt.Fatalf(\"Discover: %v\", err)\n90|\t}\n91|\tif _, err := Trust(got[0], mustTimestamp(t, trustInstant)); err == nil {\n92|\t\tt.Fatalf(\"Trust accepted builtin %q, want refusal\", got[0].ID())\n93|\t} else if code := errorCode(t, err); code != codeInvalidConfig {\n94|\t\tt.Fatalf(\"code = %q, want invalid_config\", code)\n95|\t}\n96|}\n97|\n98|// TestVerifyAcceptsUnchangedTree proves Verify succeeds when freshly read\n99|// facts equal the receipt.\n100|func TestVerifyAcceptsUnchangedTree(t *testing.T) {\n101|\tfake := newFakeSystem()\n102|\tfake.addLinkedFile(\"/plugins\", \"ax-provider-foo\", \"/opt/real/foo\", []byte(\"bytes\"), fakeUID, true)\n103|\trecord := trustOneFoo(t, discoverOneFoo(t, fake))\n104|\tif err := Verify(record, fakeOwner(), fake); err != nil {\n105|\t\tt.Fatalf(\"Verify of an unchanged tree: %v\", err)\n106|\t}\n107|}\n108|\n109|// TestVerifyDetectsSubstitution narrows the Section 7.1 substitution rule\n110|// one dimension at a time: each changed trust fact independently fails\n111|// with integrity_failure while every other fact stays equal.\n112|func TestVerifyDetectsSubstitution(t *testing.T) {\n113|\tsetup := func() (*fakeSystem, TrustRecord) {\n114|\t\tfake := newFakeSystem()\n115|\t\tfake.addLinkedFile(\"/plugins\", \"ax-provider-foo\", \"/opt/real/foo\", []byte(\"bytes\"), fakeUID, true)\n116|\t\treturn fake, trustOneFoo(t, discoverOneFoo(t, fake))\n117|\t}\n118|\tt.Run(\"retargeted symlink\", func(t *testing.T) {\n119|\t\tfake, record := setup()\n120|\t\tfake.canon[\"/plugins/ax-provider-foo\"] = \"/opt/real/evil\"\n121|\t\tfake.files[\"/opt/real/evil\"] = fakeFile{content: []byte(\"bytes\"), uid: fakeUID, regular: true}\n122|\t\tif err := Verify(record, fakeOwner(), fake); err == nil {\n123|\t\t\tt.Fatal(\"Verify accepted a retargeted symlink, want integrity_failure\")\n124|\t\t} else if code := errorCode(t, err); code != codeIntegrityFailure {\n125|\t\t\tt.Fatalf(\"code = %q, want integrity_failure\", code)\n126|\t\t} else if detail := errorDetail(t, err); !strings.Contains(detail, \"target changed\") {\n127|\t\t\tt.Fatalf(\"detail does not name the retarget refusal: %q\", detail)\n128|\t\t}\n129|\t})\n130|\tt.Run(\"changed bytes\", func(t *testing.T) {\n131|\t\tfake, record := setup()\n132|\t\tfake.files[\"/opt/real/foo\"] = fakeFile{content: []byte(\"patched\"), uid: fakeUID, regular: true}\n133|\t\tif err := Verify(record, fakeOwner(), fake); err == nil {\n134|\t\t\tt.Fatal(\"Verify accepted changed bytes, want integrity_failure\")\n135|\t\t} else if code := errorCode(t, err); code != codeIntegrityFailure {\n136|\t\t\tt.Fatalf(\"code = %q, want integrity_failure\", code)\n137|\t\t} else if detail := errorDetail(t, err); !strings.Contains(detail, \"digest changed\") {\n138|\t\t\tt.Fatalf(\"detail does not name the digest refusal: %q\", detail)\n139|\t\t}\n140|\t})\n141|\tt.Run(\"changed owner\", func(t *testing.T) {\n142|\t\tfake, record := setup()\n143|\t\tfake.files[\"/opt/real/foo\"] = fakeFile{content: []byte(\"bytes\"), uid: foreignUID, regular: true}\n144|\t\tif err := Verify(record, fakeOwner(), fake); err == nil {\n145|\t\t\tt.Fatal(\"Verify accepted a changed owner, want integrity_failure\")\n146|\t\t} else if code := errorCode(t, err); code != codeIntegrityFailure {\n147|\t\t\tt.Fatalf(\"code = %q, want integrity_failure\", code)\n148|\t\t} else if detail := errorDetail(t, err); !strings.Contains(detail, \"owner is now\") {\n149|\t\t\tt.Fatalf(\"detail does not name the owner refusal: %q\", detail)\n150|\t\t}\n151|\t})\n152|\tt.Run(\"owner changed to an approved administrator\", func(t *testing.T) {\n153|\t\tfake := newFakeSystem()\n154|\t\tfake.addLinkedFile(\"/plugins\", \"ax-provider-foo\", \"/opt/real/foo\", []byte(\"bytes\"), fakeUID, true)\n155|\t\tpolicy := OwnerPolicy{OperatorUID: fakeUID, AdministratorUIDs: []uint32{adminUID}}\n156|\t\tgot, err := Discover(fakeConfig(\"/plugins\"), policy, fake)\n157|\t\tif err != nil {\n158|\t\t\tt.Fatalf(\"Discover: %v\", err)\n159|\t\t}\n160|\t\tvar candidate Candidate\n161|\t\tfor _, found := range got {\n162|\t\t\tif found.ID() == \"foo\" {\n163|\t\t\t\tcandidate = found\n164|\t\t\t}\n165|\t\t}\n166|\t\trecord, err := Trust(candidate, mustTimestamp(t, trustInstant))\n167|\t\tif err != nil {\n168|\t\t\tt.Fatalf(\"Trust: %v\", err)\n169|\t\t}\n170|\t\t// The new owner is still approved, so only the\n171|\t\t// identity != record.owner half of the Verify owner check can\n172|\t\t// fire: the bytes, shape, and approval facts are unchanged.\n173|\t\tfake.files[\"/opt/real/foo\"] = fakeFile{content: []byte(\"bytes\"), uid: adminUID, regular: true}\n174|\t\tif err := Verify(record, policy, fake); err == nil {\n175|\t\t\tt.Fatal(\"Verify accepted an owner change to an approved administrator, want integrity_failure\")\n176|\t\t} else if code := errorCode(t, err); code != codeIntegrityFailure {\n177|\t\t\tt.Fatalf(\"code = %q, want integrity_failure\", code)\n178|\t\t} else if detail := errorDetail(t, err); !strings.Contains(detail, \"owner is now uid:7\") {\n179|\t\t\tt.Fatalf(\"detail does not name the owner-identity refusal: %q\", detail)\n180|\t\t}\n181|\t})\n182|\tt.Run(\"replaced with directory\", func(t *testing.T) {\n183|\t\tfake, record := setup()\n184|\t\t// Shape-only replacement: the bytes are unchanged so the digest\n185|\t\t// check alone would accept; only the regular-file check refuses.\n186|\t\tfake.files[\"/opt/real/foo\"] = fakeFile{content: []byte(\"bytes\"), uid: fakeUID, regular: false}\n187|\t\tif err := Verify(record, fakeOwner(), fake); err == nil {\n188|\t\t\tt.Fatal(\"Verify accepted a non-regular replacement, want integrity_failure\")\n189|\t\t} else if code := errorCode(t, err); code != codeIntegrityFailure {\n190|\t\t\tt.Fatalf(\"code = %q, want integrity_failure\", code)\n191|\t\t} else if detail := errorDetail(t, err); !strings.Contains(detail, \"no longer a regular file\") {\n192|\t\t\tt.Fatalf(\"detail does not name the shape refusal: %q\", detail)\n193|\t\t}\n194|\t})\n195|\tt.Run(\"owner approval revoked\", func(t *testing.T) {\n196|\t\tfake, record := setup()\n197|\t\t// Same recorded owner, but the policy no longer approves it:\n198|\t\t// renewed trust is still required.\n199|\t\tstrict := OwnerPolicy{OperatorUID: 9999}\n200|\t\tif err := Verify(record, strict, fake); err == nil {\n201|\t\t\tt.Fatal(\"Verify accepted a no-longer-approved owner, want integrity_failure\")\n202|\t\t}\n203|\t})\n204|}\n205|\n206|// TestVerifyTreatsReadFailureAsIntegrityFailure proves an unreadable file\n207|// cannot prove it is unchanged: every seam failure at verify time fails\n208|// with integrity_failure rather than success or absence.\n209|func TestVerifyTreatsReadFailureAsIntegrityFailure(t *testing.T) {\n210|\tsetup := func() (*fakeSystem, TrustRecord) {\n211|\t\tfake := newFakeSystem()\n212|\t\tfake.addLinkedFile(\"/plugins\", \"ax-provider-foo\", \"/opt/real/foo\", []byte(\"bytes\"), fakeUID, true)\n213|\t\treturn fake, trustOneFoo(t, discoverOneFoo(t, fake))\n214|\t}\n215|\tt.Run(\"unresolvable source\", func(t *testing.T) {\n216|\t\tfake, record := setup()\n217|\t\tdelete(fake.canon, \"/plugins/ax-provider-foo\")\n218|\t\tif err := Verify(record, fakeOwner(), fake); err == nil {\n219|\t\t\tt.Fatal(\"Verify accepted an unresolvable receipt, want integrity_failure\")\n220|\t\t} else if code := errorCode(t, err); code != codeIntegrityFailure {\n221|\t\t\tt.Fatalf(\"code = %q, want integrity_failure\", code)\n222|\t\t}\n223|\t})\n224|\tt.Run(\"uninspectable target\", func(t *testing.T) {\n225|\t\tfake, record := setup()\n226|\t\tdelete(fake.files, \"/opt/real/foo\")\n227|\t\tif err := Verify(record, fakeOwner(), fake); err == nil {\n228|\t\t\tt.Fatal(\"Verify accepted an uninspectable target, want integrity_failure\")\n229|\t\t} else if code := errorCode(t, err); code != codeIntegrityFailure {\n230|\t\t\tt.Fatalf(\"code = %q, want integrity_failure\", code)\n231|\t\t}\n232|\t})\n233|\tt.Run(\"unreadable target\", func(t *testing.T) {\n234|\t\tfake := newFakeSystem()\n235|\t\tfake.entries[\"/plugins\"] = []string{\"ax-provider-foo\"}\n236|\t\tfake.canon[\"/plugins/ax-provider-foo\"] = \"/opt/real/foo\"\n237|\t\tfake.files[\"/opt/real/foo\"] = fakeFile{content: []byte(\"bytes\"), uid: fakeUID, regular: true}\n238|\t\trecord := trustOneFoo(t, discoverOneFoo(t, fake))\n239|\t\tfake.contentErr[\"/opt/real/foo\"] = errDiskGone\n240|\t\tif err := Verify(record, fakeOwner(), fake); err == nil {\n241|\t\t\tt.Fatal(\"Verify accepted an unreadable target, want integrity_failure\")\n242|\t\t} else if code := errorCode(t, err); code != codeIntegrityFailure {\n243|\t\t\tt.Fatalf(\"code = %q, want integrity_failure\", code)\n244|\t\t}\n245|\t})\n246|}\n247|\n248|// TestVerifyDetectsLateByteDigestChange narrows the digest guard across\n249|// the digest: the receipt differs from the bytes on disk only in its final\n250|// byte, so a comparison narrowed to a leading prefix would accept. The\n251|// production entry point is Verify.\n252|func TestVerifyDetectsLateByteDigestChange(t *testing.T) {\n253|\tfake := newFakeSystem()\n254|\tfake.addLinkedFile(\"/plugins\", \"ax-provider-foo\", \"/opt/real/foo\", []byte(\"bytes\"), fakeUID, true)\n255|\tgenuine := trustOneFoo(t, discoverOneFoo(t, fake))\n256|\thexDigest := genuine.Digest().Hex()\n257|\tlast := hexDigest[len(hexDigest)-1]\n258|\tflipped := byte('0')\n259|\tif last == '0' {\n260|\t\tflipped = '1'\n261|\t}\n262|\tmutated, err := scalar.ParseDigest(\"sha256:\" + hexDigest[:len(hexDigest)-1] + string(flipped))\n263|\tif err != nil {\n264|\t\tt.Fatalf(\"ParseDigest: %v\", err)\n265|\t}\n266|\tforged := TrustRecord{\n267|\t\tproviderID: genuine.ProviderID(),\n268|\t\tsourcePath: genuine.SourcePath(),\n269|\t\tcanon:      genuine.CanonicalPath(),\n270|\t\tdigest:     mutated,\n271|\t\towner:      genuine.Owner(),\n272|\t\ttrustedAt:  genuine.TrustedAt(),\n273|\t}\n274|\tif got := forged.Digest().Hex(); got[:len(got)-1] != hexDigest[:len(hexDigest)-1] {\n275|\t\tt.Fatalf(\"mutated digest shares no 31-byte prefix; the narrowing pin is blind: %q vs %q\", got, hexDigest)\n276|\t}\n277|\tif err := Verify(forged, fakeOwner(), fake); err == nil {\n278|\t\tt.Fatal(\"Verify accepted a receipt differing only in its final digest byte, want integrity_failure\")\n279|\t} else if code := errorCode(t, err); code != codeIntegrityFailure {\n280|\t\tt.Fatalf(\"code = %q, want integrity_failure\", code)\n281|\t} else if detail := errorDetail(t, err); !strings.Contains(detail, \"digest changed\") {\n282|\t\tt.Fatalf(\"detail does not name the digest refusal: %q\", detail)\n283|\t}\n284|}\n285|\n286|// TestVerifyRefusesForgedReceipts proves Verify rechecks the receipt\n287|// instead of trusting its claims: a self-minted receipt whose digest does\n288|// not match the bytes on disk fails, even when every path and owner fact\n289|// matches.\n290|func TestVerifyRefusesForgedReceipts(t *testing.T) {\n291|\tfake := newFakeSystem()\n292|\tfake.addFile(\"/plugins\", \"ax-provider-foo\", []byte(\"real bytes\"), fakeUID)\n293|\tcandidate := discoverOneFoo(t, fake)\n294|\tgenuine := trustOneFoo(t, candidate)\n295|\tforged := TrustRecord{\n296|\t\tproviderID: genuine.ProviderID(),\n297|\t\tsourcePath: genuine.SourcePath(),\n298|\t\tcanon:      genuine.CanonicalPath(),\n299|\t\tdigest:     scalar.SHA256Digest([]byte(\"attacker bytes\")),\n300|\t\towner:      genuine.Owner(),\n301|\t\ttrustedAt:  genuine.TrustedAt(),\n302|\t}\n303|\tif err := Verify(forged, fakeOwner(), fake); err == nil {\n304|\t\tt.Fatal(\"Verify accepted a self-minted receipt, want integrity_failure\")\n305|\t} else if code := errorCode(t, err); code != codeIntegrityFailure {\n306|\t\tt.Fatalf(\"code = %q, want integrity_failure\", code)\n307|\t}\n308|\tif err := Verify(genuine, fakeOwner(), fake); err != nil {\n309|\t\tt.Fatalf(\"Verify refused the genuine receipt: %v\", err)\n310|\t}\n311|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
