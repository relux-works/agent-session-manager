{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c503","stream":{"kind":"session","id":"01a06e98-2a6f-7230-81f2-5355ec816701"},"sequence":220,"recorded_at":1780531400000435,"record_type":"event","durability":"durable","causation_id":"e5781de4-97b1-4e5e-9466-20c1d6e7652b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e5781de4-97b1-4e5e-9466-20c1d6e7652b","run_stream":{"kind":"run","id":"e5781de4-97b1-4e5e-9466-20c1d6e7652b"},"task_stream":{"kind":"task","id":"6e11c66d-640a-486e-84c3-7a77712576b4"},"task_id":"6e11c66d-640a-486e-84c3-7a77712576b4","event":{"kind":"output","task_id":"6e11c66d-640a-486e-84c3-7a77712576b4","chunk":"Read text file `internal/provider/trust_sources_test.go`.\n1|package provider\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|)\n8|\n9|// trustGateDimension is one refusal dimension of the Discover trust\n10|// boundary: shape (regular file), owner (approved identity), name\n11|// (provider-id grammar), or read (filesystem seam failure).\n12|type trustGateDimension struct {\n13|\tname string\n14|\t// wantCode is the refusal code the dimension must report.\n15|\twantCode string\n16|\t// plant installs the dimension's violating fixture for source dir.\n17|\tplant func(fake *fakeSystem, dir string)\n18|}\n19|\n20|func trustGateDimensions() []trustGateDimension {\n21|\treturn []trustGateDimension{\n22|\t\t{\n23|\t\t\tname:     \"non-regular target\",\n24|\t\t\twantCode: codeInvalidConfig,\n25|\t\t\tplant: func(fake *fakeSystem, dir string) {\n26|\t\t\t\tfake.addLinkedFile(dir, \"ax-provider-gate\", dir+\"/real/gate\", []byte(\"x\"), fakeUID, false)\n27|\t\t\t},\n28|\t\t},\n29|\t\t{\n30|\t\t\tname:     \"unapproved owner\",\n31|\t\t\twantCode: codeInvalidConfig,\n32|\t\t\tplant: func(fake *fakeSystem, dir string) {\n33|\t\t\t\tfake.addFile(dir, \"ax-provider-gate\", []byte(\"x\"), foreignUID)\n34|\t\t\t},\n35|\t\t},\n36|\t\t{\n37|\t\t\tname:     \"malformed name\",\n38|\t\t\twantCode: codeInvalidConfig,\n39|\t\t\tplant: func(fake *fakeSystem, dir string) {\n40|\t\t\t\tbad := \"ax-provider-ABC\"\n41|\t\t\t\tfake.entries[dir] = append(fake.entries[dir], bad)\n42|\t\t\t\tfake.canon[dir+\"/\"+bad] = dir + \"/\" + bad\n43|\t\t\t},\n44|\t\t},\n45|\t\t{\n46|\t\t\tname:     \"unreadable target\",\n47|\t\t\twantCode: codeLocalPrecondition,\n48|\t\t\tplant: func(fake *fakeSystem, dir string) {\n49|\t\t\t\tsource := fake.addLinkedFile(dir, \"ax-provider-gate\", dir+\"/real/gate\", []byte(\"x\"), fakeUID, true)\n50|\t\t\t\ttarget, err := fake.Canonicalize(source)\n51|\t\t\t\tif err != nil {\n52|\t\t\t\t\tpanic(err)\n53|\t\t\t\t}\n54|\t\t\t\tfake.contentErr[target] = errors.New(\"fake: input/output error\")\n55|\t\t\t},\n56|\t\t},\n57|\t}\n58|}\n59|\n60|// trustGateSource is one discovery source the trust gates must cover:\n61|// plugin_dirs[0], plugin_dirs[1], or PATH.\n62|type trustGateSource struct {\n63|\tname string\n64|\t// configure wires the source dir holding the violating fixture and\n65|\t// returns the Discover config exercising that source.\n66|\tconfigure func(fake *fakeSystem, dir string) Config\n67|}\n68|\n69|func trustGateSources() []trustGateSource {\n70|\treturn []trustGateSource{\n71|\t\t{\n72|\t\t\tname: \"plugin_dirs[0]\",\n73|\t\t\tconfigure: func(fake *fakeSystem, dir string) Config {\n74|\t\t\t\treturn fakeConfig(dir)\n75|\t\t\t},\n76|\t\t},\n77|\t\t{\n78|\t\t\tname: \"plugin_dirs[1]\",\n79|\t\t\tconfigure: func(fake *fakeSystem, dir string) Config {\n80|\t\t\t\t// The leading directory exists but holds no candidate,\n81|\t\t\t\t// so the violation in the second directory is the one\n82|\t\t\t\t// discovery must refuse.\n83|\t\t\t\tfake.entries[\"/plugins/a\"] = []string{}\n84|\t\t\t\treturn fakeConfig(\"/plugins/a\", dir)\n85|\t\t\t},\n86|\t\t},\n87|\t\t{\n88|\t\t\tname: \"path\",\n89|\t\t\tconfigure: func(fake *fakeSystem, dir string) Config {\n90|\t\t\t\tfake.pathDirs = []string{dir}\n91|\t\t\t\tcfg := fakeConfig()\n92|\t\t\t\tcfg.AllowPathPlugins = true\n93|\t\t\t\treturn cfg\n94|\t\t\t},\n95|\t\t},\n96|\t}\n97|}\n98|\n99|// TestDiscoverEnforcesTrustGatesAcrossSources narrows every Discover trust\n100|// gate across every discovery source: {plugin_dirs[0], plugin_dirs[1],\n101|// path} x {shape, owner, name, read}. A gate that holds only for the\n102|// configured plugin directory leaves the PATH source — the most\n103|// attacker-exposed source in this section — unchecked. The production\n104|// entry point is Discover.\n105|func TestDiscoverEnforcesTrustGatesAcrossSources(t *testing.T) {\n106|\tsources := trustGateSources()\n107|\tdimensions := trustGateDimensions()\n108|\ttotal := len(sources) * len(dimensions)\n109|\tpassed := 0\n110|\tfor _, source := range sources {\n111|\t\tfor _, dimension := range dimensions {\n112|\t\t\tname := source.name + \"/\" + dimension.name\n113|\t\t\tt.Run(name, func(t *testing.T) {\n114|\t\t\t\tdir := \"/plugins/gate\"\n115|\t\t\t\tif source.name == \"plugin_dirs[1]\" {\n116|\t\t\t\t\tdir = \"/plugins/b\"\n117|\t\t\t\t} else if source.name == \"path\" {\n118|\t\t\t\t\tdir = \"/pathbin\"\n119|\t\t\t\t}\n120|\t\t\t\tfake := newFakeSystem()\n121|\t\t\t\tdimension.plant(fake, dir)\n122|\t\t\t\t_, err := Discover(source.configure(fake, dir), fakeOwner(), fake)\n123|\t\t\t\tif err == nil {\n124|\t\t\t\t\tt.Fatalf(\"Discover admitted %s via %s, want %s\", dimension.name, source.name, dimension.wantCode)\n125|\t\t\t\t}\n126|\t\t\t\tif code := errorCode(t, err); code != dimension.wantCode {\n127|\t\t\t\t\tt.Fatalf(\"Discover(%s via %s) code = %q, want %q\", dimension.name, source.name, code, dimension.wantCode)\n128|\t\t\t\t}\n129|\t\t\t\tpassed++\n130|\t\t\t})\n131|\t\t}\n132|\t}\n133|\tt.Logf(\"trust-gate coverage: %d/%d source x dimension pairs refused\", passed, total)\n134|\tif passed != total {\n135|\t\tt.Fatalf(\"trust-gate coverage = %d/%d, want %d/%d\", passed, total, total, total)\n136|\t}\n137|}\n138|\n139|// TestDiscoverRefusesRelativePATHDir proves a relative PATH entry fails\n140|// closed instead of resolving against the process working directory: the\n141|// set of discoverable providers must not depend on where the process was\n142|// started. The plugin_dirs half of this gate is pinned by\n143|// TestDiscoverRefusesRelativePluginDir; this case pins the PATH half at\n144|// the same production entry point, Discover.\n145|func TestDiscoverRefusesRelativePATHDir(t *testing.T) {\n146|\tfor _, pathDirs := range [][]string{\n147|\t\t{\".\"},\n148|\t\t{\"/abs/bin\", \"relative/bin\"},\n149|\t} {\n150|\t\tfake := newFakeSystem()\n151|\t\t// Absolute entries resolve to an empty directory so discovery\n152|\t\t// reaches the relative entry it must refuse.\n153|\t\tfake.entries[\"/abs/bin\"] = []string{}\n154|\t\tfake.pathDirs = pathDirs\n155|\t\tcfg := fakeConfig()\n156|\t\tcfg.AllowPathPlugins = true\n157|\t\t_, err := Discover(cfg, fakeOwner(), fake)\n158|\t\tif err == nil {\n159|\t\t\tt.Fatalf(\"Discover accepted relative PATH entry in %q, want invalid_config\", pathDirs)\n160|\t\t}\n161|\t\tif code := errorCode(t, err); code != codeInvalidConfig {\n162|\t\t\tt.Fatalf(\"Discover(PATH=%q) code = %q, want invalid_config\", pathDirs, code)\n163|\t\t}\n164|\t\tif detail := errorDetail(t, err); !strings.Contains(detail, \"not an absolute path\") {\n165|\t\t\tt.Fatalf(\"detail does not name the absolute-path refusal: %q\", detail)\n166|\t\t}\n167|\t}\n168|}"}}}
