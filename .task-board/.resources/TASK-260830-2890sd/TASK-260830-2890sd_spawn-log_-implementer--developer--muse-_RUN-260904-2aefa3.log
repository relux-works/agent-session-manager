{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c56b","stream":{"kind":"session","id":"01a06e98-2a6f-7230-81f2-5355ec816701"},"sequence":272,"recorded_at":1780531400000539,"record_type":"event","durability":"durable","causation_id":"e5781de4-97b1-4e5e-9466-20c1d6e7652b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e5781de4-97b1-4e5e-9466-20c1d6e7652b","run_stream":{"kind":"run","id":"e5781de4-97b1-4e5e-9466-20c1d6e7652b"},"task_stream":{"kind":"task","id":"c14a0fcf-f560-424e-9788-bda9840cbdb8"},"task_id":"c14a0fcf-f560-424e-9788-bda9840cbdb8","event":{"kind":"output","task_id":"c14a0fcf-f560-424e-9788-bda9840cbdb8","chunk":"Read text file `internal/provider/refusal_inventory_test.go`.\n1|package provider\n2|\n3|import (\n4|\t\"flag\"\n5|\t\"fmt\"\n6|\t\"go/ast\"\n7|\t\"go/parser\"\n8|\t\"go/token\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\t\"runtime\"\n12|\t\"sort\"\n13|\t\"strings\"\n14|\t\"sync\"\n15|\t\"testing\"\n16|)\n17|\n18|// exercisedRefusalSites records the production file:line that constructed a\n19|// refusal, for every instrumented refusal constructor call made during the\n20|// test run. observedCodes records every stable code those refusals carried.\n21|var exercisedRefusalSites sync.Map\n22|var observedCodes sync.Map\n23|\n24|func recordRefusalSite(code string) {\n25|\tobservedCodes.Store(code, struct{}{})\n26|\tif _, file, line, ok := runtime.Caller(2); ok {\n27|\t\texercisedRefusalSites.Store(fmt.Sprintf(\"%s:%d\", filepath.Base(file), line), struct{}{})\n28|\t}\n29|}\n30|\n31|func TestMain(main *testing.M) {\n32|\torigDuplicate, origInvalid, origPrecondition, origIntegrity := failDuplicate, failInvalid, failPrecondition, failIntegrity\n33|\tfailDuplicate = func(providerID, firstSource, secondSource string) Error {\n34|\t\terr := origDuplicate(providerID, firstSource, secondSource)\n35|\t\trecordRefusalSite(err.Code())\n36|\t\treturn err\n37|\t}\n38|\tfailInvalid = func(detail string) Error {\n39|\t\terr := origInvalid(detail)\n40|\t\trecordRefusalSite(err.Code())\n41|\t\treturn err\n42|\t}\n43|\tfailPrecondition = func(detail string, cause error) Error {\n44|\t\terr := origPrecondition(detail, cause)\n45|\t\trecordRefusalSite(err.Code())\n46|\t\treturn err\n47|\t}\n48|\tfailIntegrity = func(detail string, cause error) Error {\n49|\t\terr := origIntegrity(detail, cause)\n50|\t\trecordRefusalSite(err.Code())\n51|\t\treturn err\n52|\t}\n53|\tcode := main.Run()\n54|\tif code == 0 && fullPackageTestRun() {\n55|\t\tif failures := auditRefusalInventory(); len(failures) != 0 {\n56|\t\t\tfor _, failure := range failures {\n57|\t\t\t\tfmt.Fprintln(os.Stderr, failure)\n58|\t\t\t}\n59|\t\t\tcode = 1\n60|\t\t}\n61|\t}\n62|\tos.Exit(code)\n63|}\n64|\n65|func fullPackageTestRun() bool {\n66|\tselected := flag.Lookup(\"test.run\")\n67|\treturn selected == nil || selected.Value.String() == \"\"\n68|}\n69|\n70|// auditRefusalInventory derives the refusal inventory from package source,\n71|// never from memory: every production call to a refusal constructor must\n72|// have an exercised negative path, no Error value may be built outside the\n73|// four constructors, and the observed code set must equal the closed code\n74|// set exactly.\n75|func auditRefusalInventory() []string {\n76|\tdirectory, err := os.Getwd()\n77|\tif err != nil {\n78|\t\treturn []string{fmt.Sprintf(\"derive provider refusal inventory: %v\", err)}\n79|\t}\n80|\tinventory, err := deriveRefusalInventory(directory)\n81|\tif err != nil {\n82|\t\treturn []string{fmt.Sprintf(\"derive provider refusal inventory: %v\", err)}\n83|\t}\n84|\tvar failures []string\n85|\tif len(inventory.StrayLiterals) != 0 {\n86|\t\tsort.Strings(inventory.StrayLiterals)\n87|\t\tfailures = append(failures, \"provider refusals built outside an instrumented constructor: \"+strings.Join(inventory.StrayLiterals, \", \"))\n88|\t}\n89|\tif len(inventory.RawConstructors) != 0 {\n90|\t\tsort.Strings(inventory.RawConstructors)\n91|\t\tfailures = append(failures, \"provider raw error construction outside documented cause sites: \"+strings.Join(inventory.RawConstructors, \", \"))\n92|\t}\n93|\tvar missing []string\n94|\tfor _, site := range inventory.Sites {\n95|\t\tif _, ok := exercisedRefusalSites.Load(site); !ok {\n96|\t\t\tmissing = append(missing, site)\n97|\t\t}\n98|\t}\n99|\tsort.Strings(missing)\n100|\tif len(missing) != 0 {\n101|\t\tfailures = append(failures, \"provider refusal call sites without an exercised negative path: \"+strings.Join(missing, \", \"))\n102|\t}\n103|\tvar codes []string\n104|\tobservedCodes.Range(func(key, _ any) bool {\n105|\t\tcodes = append(codes, key.(string))\n106|\t\treturn true\n107|\t})\n108|\tsort.Strings(codes)\n109|\twant := []string{codeIntegrityFailure, codeInvalidConfig, codeLocalPrecondition}\n110|\tif fmt.Sprintf(\"%v\", codes) != fmt.Sprintf(\"%v\", want) {\n111|\t\tfailures = append(failures, fmt.Sprintf(\"observed refusal codes = %v, want closed set %v\", codes, want))\n112|\t}\n113|\treturn failures\n114|}\n115|\n116|// refusalInventory is derived from package sources.\n117|type refusalInventory struct {\n118|\t// Sites are file:line positions of production refusal constructor calls.\n119|\tSites []string\n120|\t// StrayLiterals are Error composite literals outside the constructors.\n121|\tStrayLiterals []string\n122|\t// RawConstructors are errors.New, fmt.Errorf, or panic calls outside\n123|\t// the documented owner-attestation cause sites.\n124|\tRawConstructors []string\n125|}\n126|\n127|var refusalConstructors = map[string]bool{\n128|\t\"failDuplicate\":    true,\n129|\t\"failInvalid\":      true,\n130|\t\"failPrecondition\": true,\n131|\t\"failIntegrity\":    true,\n132|}\n133|\n134|// causeSiteFiles are the only production files allowed to mint raw cause\n135|// errors: the platform owner-attestation seams whose failures production\n136|// code always wraps in a refusal constructor.\n137|var causeSiteFiles = map[string]bool{\n138|\t\"os_unix.go\":    true,\n139|\t\"os_windows.go\": true,\n140|}\n141|\n142|func deriveRefusalInventory(directory string) (refusalInventory, error) {\n143|\tentries, err := os.ReadDir(directory)\n144|\tif err != nil {\n145|\t\treturn refusalInventory{}, err\n146|\t}\n147|\tvar inventory refusalInventory\n148|\tfileSet := token.NewFileSet()\n149|\tfor _, entry := range entries {\n150|\t\tname := entry.Name()\n151|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n152|\t\t\tcontinue\n153|\t\t}\n154|\t\tpath := filepath.Join(directory, name)\n155|\t\tsource, err := os.ReadFile(path)\n156|\t\tif err != nil {\n157|\t\t\treturn refusalInventory{}, err\n158|\t\t}\n159|\t\tsyntax, err := parser.ParseFile(fileSet, path, source, parser.ParseComments)\n160|\t\tif err != nil {\n161|\t\t\treturn refusalInventory{}, err\n162|\t\t}\n163|\t\t// Map each constructor's own body span so literals inside it are\n164|\t\t// not mistaken for strays.\n165|\t\tconstructorBodies := map[*ast.FuncLit]bool{}\n166|\t\tfor _, decl := range syntax.Decls {\n167|\t\t\tgeneral, ok := decl.(*ast.GenDecl)\n168|\t\t\tif !ok {\n169|\t\t\t\tcontinue\n170|\t\t\t}\n171|\t\t\tfor _, spec := range general.Specs {\n172|\t\t\t\tvalues, ok := spec.(*ast.ValueSpec)\n173|\t\t\t\tif !ok {\n174|\t\t\t\t\tcontinue\n175|\t\t\t\t}\n176|\t\t\t\tfor i, ident := range values.Names {\n177|\t\t\t\t\tif !refusalConstructors[ident.Name] || i >= len(values.Values) {\n178|\t\t\t\t\t\tcontinue\n179|\t\t\t\t\t}\n180|\t\t\t\t\tif literal, ok := values.Values[i].(*ast.FuncLit); ok {\n181|\t\t\t\t\t\tconstructorBodies[literal] = true\n182|\t\t\t\t\t}\n183|\t\t\t\t}\n184|\t\t\t}\n185|\t\t}\n186|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n187|\t\t\tcall, ok := node.(*ast.CallExpr)\n188|\t\t\tif !ok {\n189|\t\t\t\treturn true\n190|\t\t\t}\n191|\t\t\tposition := fileSet.Position(call.Pos())\n192|\t\t\tsite := fmt.Sprintf(\"%s:%d\", filepath.Base(position.Filename), position.Line)\n193|\t\t\tif ident, ok := call.Fun.(*ast.Ident); ok {\n194|\t\t\t\tif refusalConstructors[ident.Name] {\n195|\t\t\t\t\tinventory.Sites = append(inventory.Sites, site)\n196|\t\t\t\t\treturn true\n197|\t\t\t\t}\n198|\t\t\t\tif ident.Name == \"panic\" {\n199|\t\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" panic\")\n200|\t\t\t\t\treturn true\n201|\t\t\t\t}\n202|\t\t\t}\n203|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n204|\t\t\tif !ok {\n205|\t\t\t\treturn true\n206|\t\t\t}\n207|\t\t\tif qualifier, ok := selector.X.(*ast.Ident); ok {\n208|\t\t\t\tqualified := qualifier.Name + \".\" + selector.Sel.Name\n209|\t\t\t\tif qualified == \"errors.New\" || qualified == \"fmt.Errorf\" {\n210|\t\t\t\t\tif !causeSiteFiles[name] {\n211|\t\t\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" \"+qualified)\n212|\t\t\t\t\t}\n213|\t\t\t\t\treturn true\n214|\t\t\t\t}\n215|\t\t\t}\n216|\t\t\tif selector.Sel.Name == \"panic\" {\n217|\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" panic\")\n218|\t\t\t}\n219|\t\t\treturn true\n220|\t\t})\n221|\t\t// Stray Error literals: composite literals of type Error outside\n222|\t\t// a constructor body. Bodies are matched by source span.\n223|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n224|\t\t\tliteral, ok := node.(*ast.CompositeLit)\n225|\t\t\tif !ok {\n226|\t\t\t\treturn true\n227|\t\t\t}\n228|\t\t\tident, ok := literal.Type.(*ast.Ident)\n229|\t\t\tif !ok || ident.Name != \"Error\" {\n230|\t\t\t\treturn true\n231|\t\t\t}\n232|\t\t\tfor body := range constructorBodies {\n233|\t\t\t\tif literal.Pos() >= body.Pos() && literal.End() <= body.End() {\n234|\t\t\t\t\treturn true\n235|\t\t\t\t}\n236|\t\t\t}\n237|\t\t\tposition := fileSet.Position(literal.Pos())\n238|\t\t\tinventory.StrayLiterals = append(inventory.StrayLiterals, fmt.Sprintf(\"%s:%d\", filepath.Base(position.Filename), position.Line))\n239|\t\t\treturn true\n240|\t\t})\n241|\t}\n242|\treturn inventory, nil\n243|}"}}}
