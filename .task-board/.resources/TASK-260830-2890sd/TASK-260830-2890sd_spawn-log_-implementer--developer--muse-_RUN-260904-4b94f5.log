{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6a3","stream":{"kind":"session","id":"01a06e8f-8c07-7370-9d35-30d9d8930524"},"sequence":428,"recorded_at":1780531400000851,"record_type":"event","durability":"durable","causation_id":"39e7bb26-f2cf-4f0c-bb0b-bb66be703b18","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"39e7bb26-f2cf-4f0c-bb0b-bb66be703b18","run_stream":{"kind":"run","id":"39e7bb26-f2cf-4f0c-bb0b-bb66be703b18"},"task_stream":{"kind":"task","id":"b7c20f7d-5e07-4543-a69f-449d5d012c73"},"task_id":"b7c20f7d-5e07-4543-a69f-449d5d012c73","event":{"kind":"output","task_id":"b7c20f7d-5e07-4543-a69f-449d5d012c73","chunk":"Read text file `internal/provider/trust_test.go`.\n(199 line(s) above)\n200|\t\tif err := Verify(record, strict, fake); err == nil {\n201|\t\t\tt.Fatal(\"Verify accepted a no-longer-approved owner, want integrity_failure\")\n202|\t\t}\n203|\t})\n204|}\n205|\n206|// TestVerifyTreatsReadFailureAsIntegrityFailure proves an unreadable file\n207|// cannot prove it is unchanged: every seam failure at verify time fails\n208|// with integrity_failure rather than success or absence.\n209|func TestVerifyTreatsReadFailureAsIntegrityFailure(t *testing.T) {\n210|\tsetup := func() (*fakeSystem, TrustRecord) {\n211|\t\tfake := newFakeSystem()\n212|\t\tfake.addLinkedFile(\"/plugins\", \"ax-provider-foo\", \"/opt/real/foo\", []byte(\"bytes\"), fakeUID, true)\n213|\t\treturn fake, trustOneFoo(t, discoverOneFoo(t, fake))\n214|\t}\n215|\tt.Run(\"unresolvable source\", func(t *testing.T) {\n216|\t\tfake, record := setup()\n217|\t\tdelete(fake.canon, \"/plugins/ax-provider-foo\")\n218|\t\tif err := Verify(record, fakeOwner(), fake); err == nil {\n219|\t\t\tt.Fatal(\"Verify accepted an unresolvable receipt, want integrity_failure\")\n220|\t\t} else if code := errorCode(t, err); code != codeIntegrityFailure {\n221|\t\t\tt.Fatalf(\"code = %q, want integrity_failure\", code)\n222|\t\t}\n223|\t})\n224|\tt.Run(\"uninspectable target\", func(t *testing.T) {\n225|\t\tfake, record := setup()\n226|\t\tdelete(fake.files, \"/opt/real/foo\")\n227|\t\tif err := Verify(record, fakeOwner(), fake); err == nil {\n228|\t\t\tt.Fatal(\"Verify accepted an uninspectable target, want integrity_failure\")\n229|\t\t} else if code := errorCode(t, err); code != codeIntegrityFailure {\n230|\t\t\tt.Fatalf(\"code = %q, want integrity_failure\", code)\n231|\t\t}\n232|\t})\n233|\tt.Run(\"unreadable target\", func(t *testing.T) {\n234|\t\tfake := newFakeSystem()\n235|\t\tfake.entries[\"/plugins\"] = []string{\"ax-provider-foo\"}\n236|\t\tfake.canon[\"/plugins/ax-provider-foo\"] = \"/opt/real/foo\"\n237|\t\tfake.files[\"/opt/real/foo\"] = fakeFile{content: []byte(\"bytes\"), uid: fakeUID, regular: true}\n238|\t\trecord := trustOneFoo(t, discoverOneFoo(t, fake))\n239|\t\tfake.contentErr[\"/opt/real/foo\"] = errDiskGone\n240|\t\tif err := Verify(record, fakeOwner(), fake); err == nil {\n241|\t\t\tt.Fatal(\"Verify accepted an unreadable target, want integrity_failure\")\n242|\t\t} else if code := errorCode(t, err); code != codeIntegrityFailure {\n243|\t\t\tt.Fatalf(\"code = %q, want integrity_failure\", code)\n244|\t\t}\n245|\t})\n246|}\n247|\n248|// TestVerifyDetectsLateByteDigestChange narrows the digest guard across\n249|// the digest: the receipt differs from the bytes on disk only in its final\n250|// byte, so a comparison narrowed to a leading prefix would accept. The\n251|// production entry point is Verify.\n252|func TestVerifyDetectsLateByteDigestChange(t *testing.T) {\n253|\tfake := newFakeSystem()\n254|\tfake.addLinkedFile(\"/plugins\", \"ax-provider-foo\", \"/opt/real/foo\", []byte(\"bytes\"), fakeUID, true)\n255|\tgenuine := trustOneFoo(t, discoverOneFoo(t, fake))\n256|\thexDigest := genuine.Digest().Hex()\n257|\tlast := hexDigest[len(hexDigest)-1]\n258|\tflipped := byte('0')\n259|\tif last == '0' {\n260|\t\tflipped = '1'\n261|\t}\n262|\tmutated, err := scalar.ParseDigest(\"sha256:\" + hexDigest[:len(hexDigest)-1] + string(flipped))\n263|\tif err != nil {\n264|\t\tt.Fatalf(\"ParseDigest: %v\", err)\n265|\t}\n266|\tforged := TrustRecord{\n267|\t\tproviderID: genuine.ProviderID(),\n268|\t\tsourcePath: genuine.SourcePath(),\n269|\t\tcanon:      genuine.CanonicalPath(),\n270|\t\tdigest:     mutated,\n271|\t\towner:      genuine.Owner(),\n272|\t\ttrustedAt:  genuine.TrustedAt(),\n273|\t}\n274|\tif got := forged.Digest().Hex(); got[:len(got)-1] != hexDigest[:len(hexDigest)-1] {\n275|\t\tt.Fatalf(\"mutated digest shares no 31-byte prefix; the narrowing pin is blind: %q vs %q\", got, hexDigest)\n276|\t}\n277|\tif err := Verify(forged, fakeOwner(), fake); err == nil {\n278|\t\tt.Fatal(\"Verify accepted a receipt differing only in its final digest byte, want integrity_failure\")\n279|\t} else if code := errorCode(t, err); code != codeIntegrityFailure {\n(more lines below)"}}}
