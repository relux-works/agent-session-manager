shalText() ([]byte, error) {\\ninternal/scalar/time_digest.go-153-\\treturn marshalValidatedText(value.value, func(candidate string) error {\\ninternal/scalar/time_digest.go-154-\\t\\t_, err := ParseDigest(candidate)\\ninternal/scalar/time_digest.go-155-\\t\\treturn err\\ninternal/scalar/time_digest.go-156-\\t})\\ninternal/scalar/time_digest.go-157-}\\ninternal/scalar/time_digest.go-158-\\ninternal/scalar/time_digest.go-159-func (value *Digest) UnmarshalText(data []byte) error {\\n\",\n  \"original_output_bytes\": 1500,\n  \"original_output_tokens\": 375,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
