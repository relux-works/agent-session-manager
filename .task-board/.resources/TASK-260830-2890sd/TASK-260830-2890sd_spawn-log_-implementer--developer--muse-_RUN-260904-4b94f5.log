{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c659","stream":{"kind":"session","id":"01a06e8f-8c07-7370-9d35-30d9d8930524"},"sequence":391,"recorded_at":1780531400000777,"record_type":"event","durability":"durable","causation_id":"39e7bb26-f2cf-4f0c-bb0b-bb66be703b18","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"39e7bb26-f2cf-4f0c-bb0b-bb66be703b18","run_stream":{"kind":"run","id":"39e7bb26-f2cf-4f0c-bb0b-bb66be703b18"},"task_stream":{"kind":"task","id":"2ab8a6f4-b687-4813-9d4a-d934f8daf712"},"task_id":"2ab8a6f4-b687-4813-9d4a-d934f8daf712","event":{"kind":"output","task_id":"2ab8a6f4-b687-4813-9d4a-d934f8daf712","chunk":"Read text file `internal/provider/fake_test.go`.\n1|package provider\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"sort\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|)\n9|\n10|// fakeFile is the scripted target behind one canonical path.\n11|type fakeFile struct {\n12|\tcontent []byte\n13|\tuid     uint32\n14|\tregular bool\n15|}\n16|\n17|// fakeSystem scripts every System seam. Absent table entries are read\n18|// failures, never silent absences: Inspect and ReadFile fail on unknown\n19|// canonical paths, and Canonicalize fails on scripted paths.\n20|type fakeSystem struct {\n21|\tentries    map[string][]string\n22|\treadDirErr map[string]error\n23|\tcanon      map[string]string\n24|\tcanonErr   map[string]error\n25|\tfiles      map[string]fakeFile\n26|\tinspectErr map[string]error\n27|\tcontentErr map[string]error\n28|\tpathDirs   []string\n29|}\n30|\n31|func newFakeSystem() *fakeSystem {\n32|\treturn &fakeSystem{\n33|\t\tentries:    map[string][]string{},\n34|\t\treadDirErr: map[string]error{},\n35|\t\tcanon:      map[string]string{},\n36|\t\tcanonErr:   map[string]error{},\n37|\t\tfiles:      map[string]fakeFile{},\n38|\t\tinspectErr: map[string]error{},\n39|\t\tcontentErr: map[string]error{},\n40|\t}\n41|}\n42|\n43|// addFile registers dir/name as an executable target. Without linkTo, the\n44|// source path is its own canonical target.\n45|func (fake *fakeSystem) addFile(dir, name string, content []byte, uid uint32) string {\n46|\treturn fake.addLinkedFile(dir, name, \"\", content, uid, true)\n47|}\n48|\n49|// addLinkedFile registers dir/name resolving to linkTo (empty means\n50|// identity). The target is registered as a regular file unless regular is\n51|// false.\n52|func (fake *fakeSystem) addLinkedFile(dir, name, linkTo string, content []byte, uid uint32, regular bool) string {\n53|\tsource := dir + \"/\" + name\n54|\ttarget := linkTo\n55|\tif target == \"\" {\n56|\t\ttarget = source\n57|\t}\n58|\tfake.entries[dir] = append(fake.entries[dir], name)\n59|\tfake.canon[source] = target\n60|\tfake.files[target] = fakeFile{content: content, uid: uid, regular: regular}\n61|\treturn source\n62|}\n63|\n64|func (fake *fakeSystem) ReadDir(dir string) ([]string, error) {\n65|\tif err, ok := fake.readDirErr[dir]; ok {\n66|\t\treturn nil, err\n67|\t}\n68|\tnames, ok := fake.entries[dir]\n69|\tif !ok {\n70|\t\treturn nil, errors.New(\"fake: unknown directory \" + dir)\n71|\t}\n72|\t// Reverse the insertion order so tests prove Discover sorts rather\n73|\t// than inheriting filesystem order.\n74|\treversed := append([]string(nil), names...)\n75|\tsort.Sort(sort.Reverse(sort.StringSlice(reversed)))\n76|\treturn reversed, nil\n77|}\n78|\n79|func (fake *fakeSystem) Canonicalize(path string) (string, error) {\n80|\tif err, ok := fake.canonErr[path]; ok {\n81|\t\treturn \"\", err\n82|\t}\n83|\tif target, ok := fake.canon[path]; ok {\n84|\t\treturn target, nil\n85|\t}\n86|\treturn \"\", errors.New(\"fake: unresolvable path \" + path)\n87|}\n88|\n89|func (fake *fakeSystem) Inspect(canonical string) (FileInfo, error) {\n90|\tif err, ok := fake.inspectErr[canonical]; ok {\n91|\t\treturn FileInfo{}, err\n92|\t}\n93|\tfile, ok := fake.files[canonical]\n94|\tif !ok {\n95|\t\treturn FileInfo{}, errors.New(\"fake: unknown target \" + canonical)\n96|\t}\n97|\treturn FileInfo{IsRegular: file.regular, UID: file.uid}, nil\n98|}\n99|\n100|func (fake *fakeSystem) ReadFile(canonical string) ([]byte, error) {\n101|\tif err, ok := fake.contentErr[canonical]; ok {\n102|\t\treturn nil, err\n103|\t}\n104|\tfile, ok := fake.files[canonical]\n105|\tif !ok {\n106|\t\treturn nil, errors.New(\"fake: unknown target \" + canonical)\n107|\t}\n108|\treturn append([]byte(nil), file.content...), nil\n109|}\n110|\n111|func (fake *fakeSystem) PathDirs() []string {\n112|\treturn append([]string(nil), fake.pathDirs...)\n113|}\n114|\n115|const (\n116|\tfakeUID      uint32 = 1000\n117|\tforeignUID   uint32 = 2000\n118|\tadminUID     uint32 = 7\n119|\tfakePlatform        = scalar.PlatformLinux\n120|)\n121|\n122|func fakeOwner() OwnerPolicy {\n123|\treturn OwnerPolicy{OperatorUID: fakeUID}\n124|}\n125|\n126|func fakeConfig(dirs ...string) Config {\n127|\treturn Config{Platform: fakePlatform, PluginDirs: dirs}\n128|}\n129|\n130|func mustTimestamp(test testHelper, value string) scalar.Timestamp {\n131|\ttest.Helper()\n132|\tparsed, err := scalar.ParseTimestamp(value)\n133|\tif err != nil {\n134|\t\ttest.Fatalf(\"ParseTimestamp(%q): %v\", value, err)\n135|\t}\n136|\treturn parsed\n137|}\n138|\n139|// errorCode extracts the package Code from err, failing the test when err\n140|// is not a provider refusal.\n141|func errorCode(test testHelper, err error) string {\n142|\ttest.Helper()\n143|\tvar refusal Error\n144|\tif !errors.As(err, &refusal) {\n145|\t\ttest.Fatalf(\"error %v is not a provider Error\", err)\n146|\t}\n147|\treturn refusal.Code()\n148|}\n149|\n150|type testHelper interface {\n151|\tHelper()\n152|\tFatalf(format string, args ...any)\n153|}"}}}
