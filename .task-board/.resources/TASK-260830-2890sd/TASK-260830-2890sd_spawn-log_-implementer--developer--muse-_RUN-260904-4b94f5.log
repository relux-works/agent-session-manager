{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c549","stream":{"kind":"session","id":"01a06e8f-8c07-7370-9d35-30d9d8930524"},"sequence":255,"recorded_at":1780531400000505,"record_type":"event","durability":"durable","causation_id":"39e7bb26-f2cf-4f0c-bb0b-bb66be703b18","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"39e7bb26-f2cf-4f0c-bb0b-bb66be703b18","run_stream":{"kind":"run","id":"39e7bb26-f2cf-4f0c-bb0b-bb66be703b18"},"task_stream":{"kind":"task","id":"950d0b89-976c-40d7-bc5f-edeb9346da18"},"task_id":"950d0b89-976c-40d7-bc5f-edeb9346da18","event":{"kind":"output","task_id":"950d0b89-976c-40d7-bc5f-edeb9346da18","chunk":"Read text file `internal/provider/os.go`.\n1|package provider\n2|\n3|import (\n4|\t\"os\"\n5|\t\"path/filepath\"\n6|\t\"strings\"\n7|)\n8|\n9|// OSSystem is the production System: it reads the host filesystem through\n10|// the os package. It holds no state and starts no process.\n11|type OSSystem struct{}\n12|\n13|// ReadDir returns the entry names of dir in filesystem order. Discover\n14|// sorts them, so the order here carries no determinism obligation.\n15|func (OSSystem) ReadDir(dir string) ([]string, error) {\n16|\tentries, err := os.ReadDir(dir)\n17|\tif err != nil {\n18|\t\treturn nil, err\n19|\t}\n20|\tnames := make([]string, 0, len(entries))\n21|\tfor _, entry := range entries {\n22|\t\tnames = append(names, entry.Name())\n23|\t}\n24|\treturn names, nil\n25|}\n26|\n27|// Canonicalize returns the absolute, symlink-resolved target of path.\n28|func (OSSystem) Canonicalize(path string) (string, error) {\n29|\tabsolute, err := filepath.Abs(path)\n30|\tif err != nil {\n31|\t\treturn \"\", err\n32|\t}\n33|\treturn filepath.EvalSymlinks(absolute)\n34|}\n35|\n36|// Inspect stats the symlink target at an already-canonical path.\n37|func (OSSystem) Inspect(canonical string) (FileInfo, error) {\n38|\tinfo, err := os.Stat(canonical)\n39|\tif err != nil {\n40|\t\treturn FileInfo{}, err\n41|\t}\n42|\tuid, err := fileOwnerUID(info)\n43|\tif err != nil {\n44|\t\treturn FileInfo{}, err\n45|\t}\n46|\treturn FileInfo{IsRegular: info.Mode().IsRegular(), UID: uid}, nil\n47|}\n48|\n49|// ReadFile returns the full bytes of the symlink target at an\n50|// already-canonical path.\n51|func (OSSystem) ReadFile(canonical string) ([]byte, error) {\n52|\treturn os.ReadFile(canonical)\n53|}\n54|\n55|// PathDirs returns the host PATH directories in listed order, skipping\n56|// empty entries.\n57|func (OSSystem) PathDirs() []string {\n58|\traw := os.Getenv(\"PATH\")\n59|\tif raw == \"\" {\n60|\t\treturn nil\n61|\t}\n62|\tvar dirs []string\n63|\tfor _, dir := range strings.Split(raw, string(os.PathListSeparator)) {\n64|\t\tif dir != \"\" {\n65|\t\t\tdirs = append(dirs, dir)\n66|\t\t}\n67|\t}\n68|\treturn dirs\n69|}\n70|\n71|// CurrentOperatorPolicy returns the OwnerPolicy for the invoking operator\n72|// with no additional administrator-approved identities. A host that\n73|// recognizes administrator-approved owners supplies them explicitly in\n74|// OwnerPolicy instead.\n75|func CurrentOperatorPolicy() OwnerPolicy {\n76|\treturn OwnerPolicy{OperatorUID: uint32(os.Geteuid())}\n77|}"}}}
