{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6e9","stream":{"kind":"session","id":"01a0c3b6-e69d-7952-b5c2-99ff4034d208"},"sequence":463,"recorded_at":1780531400000921,"record_type":"event","durability":"durable","causation_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","run_stream":{"kind":"run","id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8"},"task_stream":{"kind":"task","id":"01a0c3b8-18c9-71b1-93f1-c90baa1668d3"},"task_id":"01a0c3b8-18c9-71b1-93f1-c90baa1668d3","event":{"kind":"output","task_id":"01a0c3b8-18c9-71b1-93f1-c90baa1668d3","chunk":"Read text file `internal/tmuxserver/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for internal/tmuxserver.\n3|\n4|Every gate ships a narrowing mutant: the gate stays present and is\n5|weakened to admit exactly one member of the class it must reject, and\n6|the named killer tests must fail. A delete-only mutant proves only that\n7|the gate exists and is not accepted as evidence; row D-background-fallback\n8|is the one explicitly supplementary additive plant (the reviewer-shaped\n9|direct-creation call on the background path), labeled as such and not\n10|counted as any gate's narrowing.\n11|\n12|Each row runs M (mutate production files in place), R (run the scoped Go\n13|killers through the production entries), V (verdict from the Go exit code\n14|plus a FAIL kill-line: KILLED iff R fails with a test failure line,\n15|SURVIVED iff R passes, ERROR for anything else -- unapplied patches,\n16|build breaks, timeouts). M failures and R infrastructure errors are\n17|ERROR, never kills or survivals. Files are restored from backups after\n18|every row, pass or fail.\n19|\n20|Row C-control is the harmless control: a comment-only edit that must\n21|SURVIVE, proving the harness observes test outcomes instead of\n22|hard-coding kills.\n23|\n24|Usage:\n25|  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py\n26|  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py N-mode-create\n27|  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py --log-dir /tmp/mutant-logs\n28|  AX_MUTANT_VERBOSE=1 PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py N-mode-create\n29|\"\"\"\n30|\n31|import os\n32|import shutil\n33|import subprocess\n34|import sys\n35|import tempfile\n36|from dataclasses import dataclass\n37|from pathlib import Path\n38|\n39|REPO = Path(__file__).resolve().parents[2]\n40|PACKAGE = \"internal/tmuxserver\"\n41|\n42|\n43|@dataclass(frozen=True)\n44|class Mutant:\n45|    name: str\n46|    path: str\n47|    find: str\n48|    replace: str\n49|    count: int\n50|    run: str\n51|    expect: str\n52|    note: str\n53|\n54|\n55|BG_MISS = \"(TestAcquireBackgroundMissReturnsTypedUnavailable|TestAcquireBackgroundHintAndCacheAuthorizeNothing)\"\n56|OVERRIDE = \"TestAcquireRefusesEveryAmbientOverrideVector\"\n57|WIDENED = \"TestEnsureRuntimeDirRefusesWidenedMode\"\n58|\n59|MUTANTS = [\n60|    Mutant(\n61|        name=\"N-mode-create\",\n62|        path=f\"{PACKAGE}/runtime_unix.go\",\n63|        find=\"\\t// leaf above; the mode comparison below is the load-bearing\\n\\t// arm this gate's tests and mutants pin.\\n\\tif info.Mode().Perm() != 0o700 {\\n\",\n64|        replace=\"\\t// leaf above; the mode comparison below is the load-bearing\\n\\t// arm this gate's tests and mutants pin.\\n\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o755 {\\n\",\n65|        count=1,\n66|        run=WIDENED,\n67|        expect=\"KILLED\",\n68|        note=\"Admits exactly 0755 at the create-path mode arm; other widened modes still refuse. Kill path: Ensure stops refusing.\",\n69|    ),\n70|    Mutant(\n71|        name=\"N-mode-verify\",\n72|        path=f\"{PACKAGE}/runtime_unix.go\",\n73|        find='\\tinfo, err := leaf.Stat()\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\\n\\t}\\n\\tif info.Mode().Perm() != 0o700 {\\n',\n74|        replace='\\tinfo, err := leaf.Stat()\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\\n\\t}\\n\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o755 {\\n',\n75|        count=1,\n76|        run=WIDENED,\n77|        expect=\"KILLED\",\n78|        note=\"Admits exactly 0755 at the verify-path mode arm; the create arm still refuses. Kill path: Verify stops refusing.\",\n79|    ),\n80|    Mutant(\n81|        name=\"N-ownership-uid\",\n82|        path=f\"{PACKAGE}/ownership_unix.go\",\n83|        find=\"\\tif stat.Uid != uint32(effectiveUID()) {\\n\",\n84|        replace=\"\\tif stat.Uid != uint32(effectiveUID()) && stat.Uid != uint32(effectiveUID())-100000 {\\n\",\n85|        count=1,\n86|        run=\"TestEnsureRuntimeDirRefusesForeignOwnership\",\n87|        expect=\"KILLED\",\n88|        note=\"Admits exactly the seam-shifted foreign UID; every other foreign UID still refuses.\",\n89|    ),\n90|    Mutant(\n91|        name=\"N-containment-slash\",\n92|        path=f\"{PACKAGE}/runtime.go\",\n93|        find='\\tif strings.Contains(name, \"/\") {\\n',\n94|        replace='\\tif strings.Contains(name, \"/\") && name != \"a/b\" {\\n',\n95|        count=1,\n96|        run=\"TestEnsureRuntimeDirRefusesBadNames\",\n97|        expect=\"KILLED\",\n98|        note=\"Admits exactly the nested a/b name past the single-segment arm; every other multi-segment name still refuses. Kill reroutes to the commit refusal.\",\n99|    ),\n100|    Mutant(\n101|        name=\"N-containment-mismatch\",\n102|        path=f\"{PACKAGE}/runtime.go\",\n103|        find=\"\\treturn sameDirectory(handleInfo, pathInfo)\\n\",\n104|        replace=\"\\treturn sameDirectory(handleInfo, pathInfo) || handleInfo.IsDir()\\n\",\n105|        count=1,\n106|        run=\"TestEnsureRuntimeDirRefusesHandleMismatch\",\n107|        expect=\"KILLED\",\n108|        note=\"Admits exactly directory handles past the handle-binding check; the mismatch still refuses for non-directories.\",\n109|    ),\n110|    Mutant(\n111|        name=\"N-containment-symlink\",\n112|        path=f\"{PACKAGE}/runtime_unix.go\",\n113|        find=\"\\tleafFd, err := unix.Openat(rootFd, name,\\n\\t\\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\",\n114|        replace=\"\\tleafFd, err := unix.Openat(rootFd, name,\\n\\t\\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\tif err != nil {\\n\\t\\tleafFd, err = unix.Openat(rootFd, name,\\n\\t\\t\\tunix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\t}\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\",\n115|        count=1,\n116|        run=\"TestEnsureRuntimeDirRefusesSymlinkLeaf\",\n117|        expect=\"KILLED\",\n118|        note=\"Admits exactly symlink leaves via an ELOOP fallback open; every other commit failure still refuses.\",\n119|    ),\n120|    Mutant(\n121|        name=\"N-root-wiring\",\n122|        path=f\"{PACKAGE}/runtime.go\",\n123|        find='\\tif _, err := scalar.ParseAbsolutePath(platform, root); err != nil {\\n\\t\\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"runtime root\"}\\n\\t}\\n',\n124|        replace='\\tif _, err := scalar.ParseAbsolutePath(platform, root); err != nil && root != \"relative/root\" {\\n\\t\\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"runtime root\"}\\n\\t}\\n',\n125|        count=1,\n126|        run=\"TestEnsureRuntimeDirRefusesBadRoots\",\n127|        expect=\"KILLED\",\n128|        note=\"Admits exactly the relative-root fixture past our wiring of the landed grammar; every other malformed root still refuses. Kill reroutes to the guard refusal.\",\n129|    ),\n130|    Mutant(\n131|        name=\"N-platform-wiring\",\n132|        path=f\"{PACKAGE}/runtime.go\",\n133|        find=\"\\tif _, err := scalar.ParsePlatform(string(platform)); err != nil {\\n\",\n134|        replace='\\tif _, err := scalar.ParsePlatform(string(platform)); err != nil && platform != \"plan9\" {\\n',\n135|        count=1,\n136|        run=\"TestEnsureRuntimeDirRefusesBadPlatform\",\n137|        expect=\"KILLED\",\n138|        note=\"Admits exactly the plan9 platform past our wiring of the landed vocabulary; every other unknown platform still refuses. Kill reroutes to the root refusal.\",\n139|    ),\n140|    Mutant(\n141|        name=\"N-override-env\",\n142|        path=f\"{PACKAGE}/socket.go\",\n143|        find='\\tif override != \"\" {\\n',\n144|        replace='\\tif override != \"\" && override != \"/tmp/tmux-501/default,12345,0\" {\\n',\n145|        count=1,\n146|        run=f\"{OVERRIDE}/environment_variable\",\n147|        expect=\"KILLED\",\n148|        note=\"Admits exactly the TMUX environment value as an override; the other three vectors still refuse.\",\n149|    ),\n150|    Mutant(\n151|        name=\"N-override-inherited\",\n152|        path=f\"{PACKAGE}/socket.go\",\n153|        find='\\tif override != \"\" {\\n',\n154|        replace='\\tif override != \"\" && override != \"/tmp/inherited.sock\" {\\n',\n155|        count=1,\n156|        run=f\"{OVERRIDE}/inherited_socket\",\n157|        expect=\"KILLED\",\n158|        note=\"Admits exactly the inherited socket as an override; the other three vectors still refuse.\",\n159|    ),\n160|    Mutant(\n161|        name=\"N-override-default\",\n162|        path=f\"{PACKAGE}/socket.go\",\n163|        find='\\tif override != \"\" {\\n',\n164|        replace='\\tif override != \"\" && override != \"/tmp/tmux-501/default\" {\\n',\n165|        count=1,\n166|        run=f\"{OVERRIDE}/default_path\",\n167|        expect=\"KILLED\",\n168|        note=\"Admits exactly the default path as an override; the other three vectors still refuse.\",\n169|    ),\n170|    Mutant(\n171|        name=\"N-override-conventional\",\n172|        path=f\"{PACKAGE}/socket.go\",\n173|        find='\\tif override != \"\" {\\n',\n174|        replace='\\tif override != \"\" && override != \"default\" {\\n',\n175|        count=1,\n176|        run=f\"{OVERRIDE}/conventional_name\",\n177|        expect=\"KILLED\",\n178|        note=\"Admits exactly the conventional name as an override; the other three vectors still refuse.\",\n179|    ),\n180|    Mutant(\n181|        name=\"N-collision\",\n182|        path=f\"{PACKAGE}/socket.go\",\n183|        find='\\tif candidate != \"\" && candidate == socket {\\n',\n184|        replace='\\tif candidate != \"\" && candidate == socket && candidate != ambient.DefaultPath {\\n',\n185|        count=1,\n186|        run=\"(TestResolveSocketRefusesAmbientCollision|TestAcquireRefusesAmbientCollision)\",\n187|        expect=\"KILLED\",\n188|        note=\"Admits exactly the default-path collision; collisions on the other four ambient members still refuse.\",\n189|    ),\n190|    Mutant(\n191|        name=\"N-attestation-smoke\",\n192|        path=f\"{PACKAGE}/readiness.go\",\n193|        find=\"\\tif !live.SmokePassed {\\n\",\n194|        replace=\"\\tif !live.SmokePassed && !live.SentinelPassed {\\n\",\n195|        count=1,\n196|        run=\"(TestCheckLiveAttestationRefusesEachMissingConjunct|TestAcquireBackgroundMissReturnsTypedUnavailable)\",\n197|        expect=\"KILLED\",\n198|        note=\"Admits exactly sentinel-only observations past the smoke arm; every other incomplete attestation still refuses.\",\n199|    ),\n200|    Mutant(\n201|        name=\"N-attestation-sentinel\",\n202|        path=f\"{PACKAGE}/readiness.go\",\n203|        find=\"\\tif !live.SentinelPassed {\\n\",\n204|        replace=\"\\tif !live.SentinelPassed && !live.SmokePassed {\\n\",\n205|        count=1,\n206|        run=\"TestCheckLiveAttestationRefusesEachMissingConjunct\",\n207|        expect=\"KILLED\",\n208|        note=\"Admits exactly smoke-only observations past the sentinel arm; every other incomplete attestation still refuses.\",\n209|    ),\n210|    Mutant(\n211|        name=\"N-attestation-binding\",\n212|        path=f\"{PACKAGE}/readiness.go\",\n213|        find='\\tif live.ServerGeneration == \"\" || live.ProviderBuild == \"\" || live.MacOSVersion == \"\" {\\n',\n214|        replace='\\tif live.ServerGeneration == \"\" || live.ProviderBuild == \"\" {\\n',\n215|        count=1,\n216|        run=\"TestCheckLiveAttestationRefusesEachMissingConjunct\",\n217|        expect=\"KILLED\",\n218|        note=\"Admits exactly macOS-unbound observations past the binding arm; generation- and build-unbound still refuse.\",\n219|    ),\n220|    Mutant(\n221|        name=\"N-broker-auth\",\n222|        path=f\"{PACKAGE}/readiness.go\",\n223|        find=\"\\tif !status.Authenticated {\\n\",\n224|        replace=\"\\tif !status.Authenticated && !status.Attested {\\n\",\n225|        count=1,\n226|        run=f\"(TestCheckBrokerContactRefusesEachMissingFact|{BG_MISS})\",\n227|        expect=\"KILLED\",\n228|        note=\"Admits exactly attested-but-unauthenticated brokers; every other broker report still refuses.\",\n229|    ),\n230|    Mutant(\n231|        name=\"N-broker-attested\",\n232|        path=f\"{PACKAGE}/readiness.go\",\n233|        find=\"\\tif !status.Attested {\\n\",\n234|        replace=\"\\tif !status.Attested && !status.Authenticated {\\n\",\n235|        count=1,\n236|        run=f\"(TestCheckBrokerContactRefusesEachMissingFact|{BG_MISS})\",\n237|        expect=\"KILLED\",\n238|        note=\"Admits exactly authenticated-but-unattested servers; every other broker report still refuses.\",\n239|    ),\n240|    Mutant(\n241|        name=\"N-creation-literal\",\n242|        path=f\"{PACKAGE}/acquire.go\",\n243|        find=\"\\tif caller == CallerBackground {\\n\",\n244|        replace='\\tif caller == \"Background\" {\\n',\n245|        count=1,\n246|        run=f\"(TestCheckCreationAllowedRefusesBackground|{BG_MISS})\",\n247|        expect=\"KILLED\",\n248|        note=\"Admits exactly the background caller at the creation choke point; the gate still refuses the capitalized twin. Kill path: background miss reports the creation code instead of the typed unavailable.\",\n249|    ),\n250|    Mutant(\n251|        name=\"N-caller-vocabulary\",\n252|        path=f\"{PACKAGE}/acquire.go\",\n253|        find=\"\\tif req.Caller != CallerForeground && req.Caller != CallerBackground {\\n\",\n254|        replace='\\tif req.Caller != CallerForeground && req.Caller != CallerBackground && req.Caller != \"operator\" {\\n',\n255|        count=1,\n256|        run=\"TestAcquireRefusesUnknownCaller\",\n257|        expect=\"KILLED\",\n258|        note=\"Admits exactly the operator caller past the vocabulary arm; every other unknown caller still refuses. Kill reroutes to the dependencies refusal.\",\n259|    ),\n260|    Mutant(\n261|        name=\"N-details-remediation\",\n262|        path=f\"{PACKAGE}/acquire.go\",\n263|        find='\\tif req.Generation == \"\" || req.BrokerState == \"\" || req.Remediation == \"\" {\\n',\n264|        replace='\\tif req.Generation == \"\" || req.BrokerState == \"\" {\\n',\n265|        count=1,\n266|        run=\"TestAcquireRefusesMissingRealmDetails\",\n267|        expect=\"KILLED\",\n268|        note=\"Admits exactly remediation-less requests past the typed-details arm; generation- and broker-less still refuse. Kill reroutes to the dependencies refusal.\",\n269|    ),\n270|    Mutant(\n271|        name=\"N-unattested-foreground\",\n272|        path=f\"{PACKAGE}/acquire.go\",\n273|        find=\"\\t\\tif err := CheckLiveAttestation(report.Attestation); err != nil {\\n\\t\\t\\treturn Outcome{}, err\\n\\t\\t}\\n\",\n274|        replace=\"\\t\\tif err := CheckLiveAttestation(report.Attestation); err != nil && !report.Attestation.SentinelPassed {\\n\\t\\t\\treturn Outcome{}, err\\n\\t\\t}\\n\",\n275|        count=1,\n276|        run=\"TestAcquireForegroundRefusesRunningUnattested\",\n277|        expect=\"KILLED\",\n278|        note=\"Admits exactly sentinel-passed-but-smoke-missing running servers to attach; every other unattested report still refuses.\",\n279|    ),\n280|    Mutant(\n281|        name=\"N-spawn-swallow\",\n282|        path=f\"{PACKAGE}/acquire.go\",\n283|        find=\"\\tif err := req.Deps.Spawn(socket, argv); err != nil {\\n\",\n284|        replace='\\tif err := req.Deps.Spawn(socket, argv); err != nil && err.Error() != \"exec failed\" {\\n',\n285|        count=1,\n286|        run=\"TestAcquireForegroundSpawnFailureReportsWithoutFallback\",\n287|        expect=\"KILLED\",\n288|        note=\"Admits exactly the fixture spawn failure as success; every other spawn failure still reports.\",\n289|    ),\n290|    Mutant(\n291|        name=\"N-probe-swallow-foreground\",\n292|        path=f\"{PACKAGE}/acquire.go\",\n293|        find=\"\\treport, err := req.Deps.ProbeServer(socket)\\n\\tif err != nil {\\n\",\n294|        replace='\\treport, err := req.Deps.ProbeServer(socket)\\n\\tif err != nil && err.Error() != \"probe boom\" {\\n',\n295|        count=1,\n296|        run=\"TestAcquireForegroundProbeFailurePassesThrough\",\n297|        expect=\"KILLED\",\n298|        note=\"Admits exactly the fixture probe failure as an absent server (then spawns); every other probe failure still passes through.\",\n299|    ),\n300|    Mutant(\n301|        name=\"N-probe-swallow-background\",\n302|        path=f\"{PACKAGE}/acquire.go\",\n303|        find=\"\\tstatus, err := req.Deps.ProbeBroker()\\n\\tif err != nil {\\n\",\n304|        replace='\\tstatus, err := req.Deps.ProbeBroker()\\n\\tif err != nil && err.Error() != \"probe boom\" {\\n',\n305|        count=1,\n306|        run=\"TestAcquireBackgroundProbeFailurePassesThrough\",\n307|        expect=\"KILLED\",\n308|        note=\"Admits exactly the fixture probe failure as a broker miss (then reports unavailable); every other probe failure still passes through.\",\n309|    ),\n310|    Mutant(\n311|        name=\"N-argv-socket\",\n312|        path=f\"{PACKAGE}/argv.go\",\n313|        find=\"\\tif socket != SocketPath(runtimeDir) {\\n\",\n314|        replace='\\tif socket != SocketPath(runtimeDir) && socket != \"/tmp/tmux-501/default\" {\\n',\n315|        count=1,\n316|        run=\"TestBuildArgvRefusesAmbientSocket\",\n317|        expect=\"KILLED\",\n318|        note=\"Admits exactly the default path at the spawn-socket arm; every other ambient socket still refuses.\",\n319|    ),\n320|    Mutant(\n321|        name=\"N-argv-session\",\n322|        path=f\"{PACKAGE}/argv.go\",\n323|        find=\"\\tsession, err := scalar.ParseUUIDv7(sessionID)\\n\\tif err != nil {\\n\",\n324|        replace='\\tsession, err := scalar.ParseUUIDv7(sessionID)\\n\\tif err != nil && sessionID != \"12345\" {\\n',\n325|        count=1,\n326|        run=\"(TestBuildArgvRefusesMalformedSession|TestAcquireForegroundRefusesMalformedSession)\",\n327|        expect=\"KILLED\",\n328|        note=\"Admits exactly the PID-form session past our wiring of the landed UUIDv7 grammar; every other malformed session still refuses.\",\n329|    ),\n330|    Mutant(\n331|        name=\"N-deps-background\",\n332|        path=f\"{PACKAGE}/acquire.go\",\n333|        find=\"\\tif req.Deps.ProbeBroker == nil {\\n\",\n334|        replace=\"\\tif req.Deps.ProbeBroker == nil && req.Deps.Spawn == nil {\\n\",\n335|        count=1,\n336|        run=\"TestAcquireBackgroundNilBrokerWithSpawnRefuses\",\n337|        expect=\"KILLED\",\n338|        note=\"Admits exactly the nil-probe-with-spawn background request past the dependencies arm; the fully-nil request still refuses. Kill path: the admitted request panics on the nil probe, and the panic fails the test.\",\n339|    ),\n340|    Mutant(\n341|        name=\"N-deps-foreground\",\n342|        path=f\"{PACKAGE}/acquire.go\",\n343|        find=\"\\tif req.Deps.ProbeServer == nil || req.Deps.Spawn == nil {\\n\",\n344|        replace=\"\\tif req.Deps.ProbeServer == nil && req.Deps.Spawn == nil {\\n\",\n345|        count=1,\n346|        run=\"TestAcquireForegroundNilSpawnWithProbeRefuses\",\n347|        expect=\"KILLED\",\n348|        note=\"Admits exactly the half-nil foreground dependencies past the arm; fully-nil dependencies still refuse. Kill path: the admitted request panics on the nil spawn, and the panic fails the test.\",\n349|    ),\n350|    Mutant(\n351|        name=\"D-background-fallback\",\n352|        path=f\"{PACKAGE}/acquire.go\",\n353|        find=\"\\t\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\n\\t\\t\\treturn Outcome{}, backgroundUnavailable(req, err)\\n\\t\\t}\\n\",\n354|        replace=\"\\t\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\n\\t\\t\\tif req.Deps.Spawn != nil {\\n\\t\\t\\t\\t_ = req.Deps.Spawn(socket, nil)\\n\\t\\t\\t}\\n\\t\\t\\treturn Outcome{}, backgroundUnavailable(req, err)\\n\\t\\t}\\n\",\n355|        count=1,\n356|        run=BG_MISS,\n357|        expect=\"KILLED\",\n358|        note=\"SUPPLEMENTARY ADDITIVE, not a narrowing: plants the reviewer-shaped direct-creation call on the background miss path. Kill path: every background-miss spy asserts zero spawn calls.\",\n359|    ),\n360|    Mutant(\n361|        name=\"C-control\",\n362|        path=f\"{PACKAGE}/errors.go\",\n363|        find=\"// Error is a package-local refusal. Code is one of the Code*\",\n364|        replace=\"// Error is a package-local refusal (harness control: comment-only). Code is one of the Code*\",\n365|        count=1,\n366|        run=\"TestSocketPathDerivesOnlyFromRuntimeDir\",\n367|        expect=\"SURVIVED\",\n368|        note=\"Harmless control: a comment-only edit that must SURVIVE, proving the harness observes outcomes.\",\n369|    ),\n370|]\n371|\n372|\n373|def apply(mutant: Mutant, original: str) -> str:\n374|    return original.replace(mutant.find, mutant.replace)\n375|\n376|\n377|def run_mutant(mutant: Mutant, log_dir: Path | None) -> str:\n378|    target = REPO / mutant.path\n379|    original = target.read_text()\n380|    found = original.count(mutant.find)\n381|    if found != mutant.count:\n382|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\"\n383|    with tempfile.TemporaryDirectory() as staging:\n384|        backup = Path(staging) / \"backup\"\n385|        shutil.copy2(target, backup)\n386|        try:\n387|            target.write_text(apply(mutant, original))\n388|            run = subprocess.run(\n389|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n390|                cwd=REPO,\n391|                capture_output=True,\n392|                text=True,\n393|                timeout=300,\n394|            )\n395|        finally:\n396|            shutil.copy2(backup, target)\n397|    output = (run.stdout + run.stderr).strip()\n398|    if os.environ.get(\"AX_MUTANT_VERBOSE\") == \"1\":\n399|        print(f\"--- raw: {mutant.name}: exit {run.returncode} ---\", flush=True)\n400|        print(output, flush=True)\n401|        print(f\"--- end raw: {mutant.name} ---\", flush=True)\n402|    if log_dir is not None:\n403|        (log_dir / f\"{mutant.name}.log\").write_text(\n404|            f\"exit: {run.returncode}\\nrun: go test ./{PACKAGE}/ -run {mutant.run} -count=1\\n\\n{output}\\n\"\n405|        )\n406|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n407|        return f\"ERROR: {mutant.name}: build broke under the patch\"\n408|    if run.returncode == 0:\n409|        verdict = \"SURVIVED\"\n410|    elif '--- FAIL' in output or 'FAIL:' in output:\n411|        verdict = \"KILLED\"\n412|    else:\n413|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\"\n414|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n415|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note} [exit {run.returncode}]\"\n416|\n417|\n418|def main(argv: list[str]) -> int:\n419|    log_dir: Path | None = None\n420|    names = list(argv)\n421|    if \"--log-dir\" in names:\n422|        idx = names.index(\"--log-dir\")\n423|        if idx + 1 >= len(names):\n424|            print(\"--log-dir needs a directory\")\n425|            return 2\n426|        log_dir = Path(names[idx + 1])\n427|        log_dir.mkdir(parents=True, exist_ok=True)\n428|        del names[idx : idx + 2]\n429|    selected = [m for m in MUTANTS if not names or m.name in names]\n430|    if names and len(selected) != len(names):\n431|        unknown = sorted(set(names) - {m.name for m in selected})\n432|        print(f\"unknown mutants: {', '.join(unknown)}\")\n433|        return 2\n434|    failures = 0\n435|    for mutant in selected:\n436|        try:\n437|            line = run_mutant(mutant, log_dir)\n438|        except subprocess.TimeoutExpired:\n439|            line = f\"ERROR: {mutant.name}: killer timed out\"\n440|        print(line, flush=True)\n441|        if not line.startswith(\"ok:\"):\n442|            failures += 1\n443|    return 1 if failures else 0\n444|\n445|\n446|if __name__ == \"__main__\":\n447|    sys.exit(main(sys.argv[1:]))","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6eb","stream":{"kind":"session","id":"01a0c3b6-e69d-7952-b5c2-99ff4034d208"},"sequence":464,"recorded_at":1780531400000923,"record_type":"event","durability":"durable","causation_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","run_stream":{"kind":"run","id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8"},"task_stream":{"kind":"task","id":"01a0c3b8-18c9-71b1-93f1-c90baa1668d3"},"task_id":"01a0c3b8-18c9-71b1-93f1-c90baa1668d3","event":{"kind":"completed","task_id":"01a0c3b8-18c9-71b1-93f1-c90baa1668d3"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6ed","stream":{"kind":"session","id":"01a0c3b6-e69d-7952-b5c2-99ff4034d208"},"sequence":465,"recorded_at":1780531400000925,"record_type":"event","durability":"durable","causation_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","run_stream":{"kind":"run","id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8"},"call_id":"call_01a0c3b81408736a85286e6683775caa","text":"Read text file `internal/tmuxserver/TRACEABILITY.md`.\n1|# TRACEABILITY — internal/tmuxserver (AX v0.7.0)\n2|\n3|Normative scope: AX v0.7.0 Section 4.2 (tmux backend: dedicated -S\n4|server, no ambient/default discovery or reuse, credential-sensitive\n5|creation, background broker-or-refuse with typed capability_unavailable\n6|and no fallback to direct creation, launchctl managername as diagnostic\n7|hint only, cached observations never authorize resume), Section 4.C\n8|(operation vocabulary cited for the wrapper entrypoint shape only),\n9|Section 4.D (capability evidence cited landed), and Section 4.E\n10|(sensitive runtime state is owner-only and non-replicable). Story:\n11|production-tmux-backend (first leaf).\n12|\n13|Rule: every row names its production entry point. A row is driven only\n14|when the named committed test executes that entry. Prose in place of\n15|the ratio is not evidence. 54 of 54 AC rows driven; no row is a\n16|bound — the eight stated bounds below cover deliberately unclaimed\n17|surfaces, not undriven rows.\n18|\n19|No test in this package starts a tmux process: every broker, server,\n20|and spawner interaction runs through injected dependencies, and the\n21|suite passes with no tmux installed. No row has a real-tmux witness;\n22|that is the determinism design, not a gap (bound B1).\n23|\n24|## Runtime custody (Sections 4.2, 4.E)\n25|\n26|| # | Clause | Call site | Test |\n27||---|--------|-----------|------|\n28|| 1 | Ensure creates the owner-only 0700 directory | EnsureRuntimeDir (runtime.go, runtime_unix.go) | TestEnsureRuntimeDirCreatesOwnerOnly |\n29|| 2 | Re-ensure is idempotent and verifies mode | EnsureRuntimeDir (runtime.go, runtime_unix.go) | TestEnsureRuntimeDirIsIdempotent |\n30|| 3 | Compliant directory verifies | VerifyRuntimeDir (runtime.go, runtime_unix.go) | TestVerifyRuntimeDirAdmitsCompliant |\n31|| 4 | Widened mode refuses on ensure and verify, never silently repaired | EnsureRuntimeDir, VerifyRuntimeDir (runtime_unix.go) | TestEnsureRuntimeDirRefusesWidenedMode |\n32|| 5 | Non-directory leaf refuses | EnsureRuntimeDir (runtime_unix.go) | TestEnsureRuntimeDirRefusesNonDirectoryLeaf |\n33|| 6 | Symlink leaf refuses | EnsureRuntimeDir (runtime_unix.go) | TestEnsureRuntimeDirRefusesSymlinkLeaf |\n34|| 7 | Foreign ownership refuses on ensure and verify | EnsureRuntimeDir, VerifyRuntimeDir (ownership_unix.go) | TestEnsureRuntimeDirRefusesForeignOwnership |\n35|| 8 | Handle/path mismatch refuses | EnsureRuntimeDir (runtime.go) | TestEnsureRuntimeDirRefusesHandleMismatch |\n36|| 9 | Symlinked root refuses | EnsureRuntimeDir (runtime_unix.go) | TestEnsureRuntimeDirRefusesSymlinkRoot |\n37|| 10 | Relative, empty, parent, and missing roots refuse | EnsureRuntimeDir (runtime.go) | TestEnsureRuntimeDirRefusesBadRoots (4 subtests) |\n38|| 11 | Empty, dot, parent, nested, absolute, and NUL names refuse | EnsureRuntimeDir (runtime.go) | TestEnsureRuntimeDirRefusesBadNames (6 subtests) |\n39|| 12 | Unknown platform refuses | EnsureRuntimeDir (runtime.go) | TestEnsureRuntimeDirRefusesBadPlatform |\n40|| 13 | Verify refuses absence without creating | VerifyRuntimeDir (runtime_unix.go) | TestVerifyRuntimeDirRefusesAbsence |\n41|| 14 | Linux and WSL2 share the unix custody discipline | EnsureRuntimeDir (runtime_unix.go) | TestLinuxAndWSL2ShareUnixCustody |\n42|| 15 | Windows platform on a unix host refuses; the Windows custody subset is a pinned bound | EnsureRuntimeDir (runtime_unix.go, runtime_windows.go) | TestEnsureRuntimeDirRefusesWindowsOnUnixHost, TestWindowsCustodyBoundIsStated (windows-only) |\n43|\n44|## Dedicated socket and ambient non-use (Section 4.2)\n45|\n46|| # | Clause | Call site | Test |\n47||---|--------|-----------|------|\n48|| 16 | Socket derives only from the runtime directory | SocketPath (socket.go) | TestSocketPathDerivesOnlyFromRuntimeDir |\n49|| 17 | Resolution returns the derived socket under hostile ambient on all five members | ResolveSocket (socket.go) | TestResolveSocketDerivesIgnoringAmbient |\n50|| 18 | Ambient observation records without using, including nil lookup | ObserveAmbient (socket.go) | TestObserveAmbientRecordsWithoutUsing, TestObserveAmbientNilLookupKeepsOutOfBand |\n51|| 19 | TMUX environment value as override refuses through Acquire with no spawn | Acquire (acquire.go) via ResolveSocket (socket.go) | TestAcquireRefusesEveryAmbientOverrideVector/environment_variable |\n52|| 20 | Inherited socket as override refuses through Acquire with no spawn | Acquire (acquire.go) via ResolveSocket (socket.go) | TestAcquireRefusesEveryAmbientOverrideVector/inherited_socket |\n53|| 21 | Default path as override refuses through Acquire with no spawn | Acquire (acquire.go) via ResolveSocket (socket.go) | TestAcquireRefusesEveryAmbientOverrideVector/default_path |\n54|| 22 | Conventional name as override refuses through Acquire with no spawn | Acquire (acquire.go) via ResolveSocket (socket.go) | TestAcquireRefusesEveryAmbientOverrideVector/conventional_name |\n55|| 23 | Ambient value colliding with the derived socket refuses | Acquire (acquire.go) via ResolveSocket (socket.go) | TestAcquireRefusesAmbientCollision, TestResolveSocketRefusesAmbientCollision |\n56|\n57|## Background broker-or-refuse (Section 4.2)\n58|\n59|| # | Clause | Call site | Test |\n60||---|--------|-----------|------|\n61|| 24 | Authenticated broker plus attested server contacts on macOS with credentials, with no spawn and no argv | Acquire (acquire.go) via CheckBrokerContact (readiness.go) | TestAcquireBackgroundContactsBroker |\n62|| 25 | No broker returns the typed capability_unavailable with no spawn | Acquire (acquire.go) | TestAcquireBackgroundMissReturnsTypedUnavailable/no_broker |\n63|| 26 | Unauthenticated broker returns the typed capability_unavailable with no spawn | Acquire (acquire.go) | TestAcquireBackgroundMissReturnsTypedUnavailable/unauthenticated_broker |\n64|| 27 | Unattested server returns the typed capability_unavailable with no spawn | Acquire (acquire.go) | TestAcquireBackgroundMissReturnsTypedUnavailable/unattested_server |\n65|| 28 | Sentinel-only attestation returns the typed capability_unavailable with no spawn | Acquire (acquire.go) | TestAcquireBackgroundMissReturnsTypedUnavailable/sentinel-only_attestation |\n66|| 29 | Linux miss also returns the typed capability_unavailable with no spawn | Acquire (acquire.go) | TestAcquireBackgroundMissOnLinuxAlsoRefusesWithoutFallback |\n67|| 30 | Broker probe failure passes through as unknown, never unavailable, with no spawn | Acquire (acquire.go) | TestAcquireBackgroundProbeFailurePassesThrough |\n68|| 31 | Creation gate refuses the background caller; the miss path enforces it by call | checkCreationAllowed via Acquire (acquire.go) | TestCheckCreationAllowedRefusesBackground, TestAcquireBackgroundMissReturnsTypedUnavailable (kill path of N-creation-literal) |\n69|\n70|## Readiness non-authorization (Sections 4.2, 4.D)\n71|\n72|| # | Clause | Call site | Test |\n73||---|--------|-----------|------|\n74|| 32 | Aqua hint plus cached pass still returns the typed capability_unavailable on a broker miss | Acquire (acquire.go) | TestAcquireBackgroundHintAndCacheAuthorizeNothing |\n75|| 33 | Aqua hint plus cached pass neither fakes a running server nor skips the live spawn | Acquire (acquire.go) | TestAcquireForegroundHintAndCacheChangeNothing |\n76|| 34 | Complete live attestation admits | CheckLiveAttestation (readiness.go) | TestCheckLiveAttestationAdmitsComplete |\n77|| 35 | Sentinel-only observation refuses | CheckLiveAttestation (readiness.go) | TestCheckLiveAttestationRefusesEachMissingConjunct/sentinel_only_is_insufficient |\n78|| 36 | Smoke-only observation refuses | CheckLiveAttestation (readiness.go) | TestCheckLiveAttestationRefusesEachMissingConjunct/smoke_only_is_insufficient |\n79|| 37 | Generation-, build-, and macOS-unbound observations refuse | CheckLiveAttestation (readiness.go) | TestCheckLiveAttestationRefusesEachMissingConjunct (3 binding subtests) |\n80|| 38 | Authenticated plus attested broker report admits | CheckBrokerContact (readiness.go) | TestCheckBrokerContactAdmitsAuthenticatedAttested |\n81|| 39 | Missing broker, authentication, attestation, and smoke each refuse | CheckBrokerContact (readiness.go) | TestCheckBrokerContactRefusesEachMissingFact (4 subtests) |\n82|\n83|## Foreground acquisition (Section 4.2)\n84|\n85|| # | Clause | Call site | Test |\n86||---|--------|-----------|------|\n87|| 40 | Absent server spawns dedicated with exact -S argv disjoint from every ambient vector and the ax pane tail | Acquire (acquire.go) via BuildArgv (argv.go) | TestAcquireForegroundSpawnsDedicatedServer |\n88|| 41 | Running attested server attaches with no spawn | Acquire (acquire.go) | TestAcquireForegroundAttachesToRunningAttested |\n89|| 42 | Running unattested server refuses with no spawn and no repair | Acquire (acquire.go) | TestAcquireForegroundRefusesRunningUnattested |\n90|| 43 | Server probe failure passes through as unknown with no spawn | Acquire (acquire.go) | TestAcquireForegroundProbeFailurePassesThrough |\n91|| 44 | Spawn failure reports with exactly one attempt and no fallback | Acquire (acquire.go) | TestAcquireForegroundSpawnFailureReportsWithoutFallback |\n92|| 45 | Malformed session refuses before any spawn | Acquire (acquire.go) via BuildArgv (argv.go) | TestAcquireForegroundRefusesMalformedSession |\n93|\n94|## Spawn argv (Sections 4.2, 4.C)\n95|\n96|| # | Clause | Call site | Test |\n97||---|--------|-----------|------|\n98|| 46 | Spawn vector is exactly tmux -S socket new-session -d -s session ax pane session | BuildArgv (argv.go) | TestBuildArgvAddressesOnlyTheDerivedSocket |\n99|| 47 | Default, inherited, conventional, and tmpdir sockets refuse | BuildArgv (argv.go) | TestBuildArgvRefusesAmbientSocket (4 subtests) |\n100|| 48 | Malformed sessions refuse the landed UUIDv7 wiring | BuildArgv (argv.go) | TestBuildArgvRefusesMalformedSession |\n101|\n102|## Input validation (Sections 4.2, 15.3)\n103|\n104|| # | Clause | Call site | Test |\n105||---|--------|-----------|------|\n106|| 49 | Unknown caller refuses | Acquire (acquire.go) | TestAcquireRefusesUnknownCaller |\n107|| 50 | Missing generation, broker state, and remediation each refuse | Acquire (acquire.go) | TestAcquireRefusesMissingRealmDetails (3 subtests) |\n108|| 51 | Missing dependencies refuse on every nil shape | Acquire (acquire.go) | TestAcquireRefusesMissingDependencies, TestAcquireBackgroundNilBrokerWithSpawnRefuses, TestAcquireForegroundNilSpawnWithProbeRefuses |\n109|| 52 | Acquisition ensures the runtime directory idempotently | Acquire (acquire.go) via EnsureRuntimeDir (runtime.go) | TestAcquireCreatesRuntimeDirIdempotently |\n110|\n111|## Crash and idempotency (Sections 4.2, 4.E)\n112|\n113|| # | Clause | Call site | Test |\n114||---|--------|-----------|------|\n115|| 53 | Real SIGKILL between mkdir and fsync leaves a retry that converges to the one verified directory | EnsureRuntimeDir (runtime_unix.go) | TestEnsureCrashChildSelfTerminates |\n116|| 54 | Spawn-then-retry attaches to the one server with exactly one spawn | Acquire (acquire.go) | TestAcquireForegroundSpawnIsIdempotentAcrossRetry |\n117|\n118|## Mutation battery\n119|\n120|`PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py`:\n121|29 narrowing rows KILLED, 1 supplementary additive row KILLED\n122|(D-background-fallback, labeled), 1 harmless control SURVIVED, on two\n123|full passes with identical verdicts and one raw log per plant per run.\n124|Rows N-deps-background and N-deps-foreground kill by panic: the\n125|admitted request calls the nil dependency and the panic fails the\n126|test. No token-preserving source-text mutant applies: no gate inspects\n127|source text, and the harness executes the behavioral suite (bound B4).\n128|\n129|## Stated bounds\n130|\n131|- B1 Determinism: no row has a real-tmux witness. Every broker, server,\n132|  and spawner interaction runs through injected dependencies; the suite\n133|  passes with no tmux process anywhere. A live-server test would add a\n134|  witness, not a rule, and is sibling scope.\n135|- B2 Windows custody: ownership on Windows is the creating-user ACL\n136|  installed by the OS; no UID gate is claimed\n137|  (runtime_windows.go, TestWindowsCustodyBoundIsStated).\n138|- B3 Nil-dependency weakening panics instead of misbehaving; the two\n139|  narrowing rows pin the refusal and disclose the panic kill.\n140|- B4 No gate inspects source text, so no token-preserving mutant\n141|  applies; the harness executes the behavioral suite.\n142|- B5 Attach presentation vectors are sibling scope: attached and broker\n143|  outcomes carry the socket, and only the spawned outcome carries argv.\n144|- B6 Lifecycle operations (create, attach, status, quiesce, stop,\n145|  terminate, restore) belong to the sibling leaves, not to acquisition.\n146|- B7 The handle-mismatch arm stages its race through the sameDirectory\n147|  seam; a true concurrent handle swap is not staged.\n148|- B8 Registry bindings and the digest re-pin belong to the story's\n149|  final leaf; this leaf documents clause coverage here and in the\n150|  conformance matrix only.","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6ef","stream":{"kind":"session","id":"01a0c3b6-e69d-7952-b5c2-99ff4034d208"},"sequence":466,"recorded_at":1780531400000927,"record_type":"event","durability":"durable","causation_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","run_stream":{"kind":"run","id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8"},"call_id":"call_01a0c3b8161a748c9f76669153abc629","text":"Read text file `internal/tmuxserver/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for internal/tmuxserver.\n3|\n4|Every gate ships a narrowing mutant: the gate stays present and is\n5|weakened to admit exactly one member of the class it must reject, and\n6|the named killer tests must fail. A delete-only mutant proves only that\n7|the gate exists and is not accepted as evidence; row D-background-fallback\n8|is the one explicitly supplementary additive plant (the reviewer-shaped\n9|direct-creation call on the background path), labeled as such and not\n10|counted as any gate's narrowing.\n11|\n12|Each row runs M (mutate production files in place), R (run the scoped Go\n13|killers through the production entries), V (verdict from the Go exit code\n14|plus a FAIL kill-line: KILLED iff R fails with a test failure line,\n15|SURVIVED iff R passes, ERROR for anything else -- unapplied patches,\n16|build breaks, timeouts). M failures and R infrastructure errors are\n17|ERROR, never kills or survivals. Files are restored from backups after\n18|every row, pass or fail.\n19|\n20|Row C-control is the harmless control: a comment-only edit that must\n21|SURVIVE, proving the harness observes test outcomes instead of\n22|hard-coding kills.\n23|\n24|Usage:\n25|  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py\n26|  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py N-mode-create\n27|  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py --log-dir /tmp/mutant-logs\n28|  AX_MUTANT_VERBOSE=1 PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py N-mode-create\n29|\"\"\"\n30|\n31|import os\n32|import shutil\n33|import subprocess\n34|import sys\n35|import tempfile\n36|from dataclasses import dataclass\n37|from pathlib import Path\n38|\n39|REPO = Path(__file__).resolve().parents[2]\n40|PACKAGE = \"internal/tmuxserver\"\n41|\n42|\n43|@dataclass(frozen=True)\n44|class Mutant:\n45|    name: str\n46|    path: str\n47|    find: str\n48|    replace: str\n49|    count: int\n50|    run: str\n51|    expect: str\n52|    note: str\n53|\n54|\n55|BG_MISS = \"(TestAcquireBackgroundMissReturnsTypedUnavailable|TestAcquireBackgroundHintAndCacheAuthorizeNothing)\"\n56|OVERRIDE = \"TestAcquireRefusesEveryAmbientOverrideVector\"\n57|WIDENED = \"TestEnsureRuntimeDirRefusesWidenedMode\"\n58|\n59|MUTANTS = [\n60|    Mutant(\n61|        name=\"N-mode-create\",\n62|        path=f\"{PACKAGE}/runtime_unix.go\",\n63|        find=\"\\t// leaf above; the mode comparison below is the load-bearing\\n\\t// arm this gate's tests and mutants pin.\\n\\tif info.Mode().Perm() != 0o700 {\\n\",\n64|        replace=\"\\t// leaf above; the mode comparison below is the load-bearing\\n\\t// arm this gate's tests and mutants pin.\\n\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o755 {\\n\",\n65|        count=1,\n66|        run=WIDENED,\n67|        expect=\"KILLED\",\n68|        note=\"Admits exactly 0755 at the create-path mode arm; other widened modes still refuse. Kill path: Ensure stops refusing.\",\n69|    ),\n70|    Mutant(\n71|        name=\"N-mode-verify\",\n72|        path=f\"{PACKAGE}/runtime_unix.go\",\n73|        find='\\tinfo, err := leaf.Stat()\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\\n\\t}\\n\\tif info.Mode().Perm() != 0o700 {\\n',\n74|        replace='\\tinfo, err := leaf.Stat()\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\\n\\t}\\n\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o755 {\\n',\n75|        count=1,\n76|        run=WIDENED,\n77|        expect=\"KILLED\",\n78|        note=\"Admits exactly 0755 at the verify-path mode arm; the create arm still refuses. Kill path: Verify stops refusing.\",\n79|    ),\n80|    Mutant(\n81|        name=\"N-ownership-uid\",\n82|        path=f\"{PACKAGE}/ownership_unix.go\",\n83|        find=\"\\tif stat.Uid != uint32(effectiveUID()) {\\n\",\n84|        replace=\"\\tif stat.Uid != uint32(effectiveUID()) && stat.Uid != uint32(effectiveUID())-100000 {\\n\",\n85|        count=1,\n86|        run=\"TestEnsureRuntimeDirRefusesForeignOwnership\",\n87|        expect=\"KILLED\",\n88|        note=\"Admits exactly the seam-shifted foreign UID; every other foreign UID still refuses.\",\n89|    ),\n90|    Mutant(\n91|        name=\"N-containment-slash\",\n92|        path=f\"{PACKAGE}/runtime.go\",\n93|        find='\\tif strings.Contains(name, \"/\") {\\n',\n94|        replace='\\tif strings.Contains(name, \"/\") && name != \"a/b\" {\\n',\n95|        count=1,\n96|        run=\"TestEnsureRuntimeDirRefusesBadNames\",\n97|        expect=\"KILLED\",\n98|        note=\"Admits exactly the nested a/b name past the single-segment arm; every other multi-segment name still refuses. Kill reroutes to the commit refusal.\",\n99|    ),\n100|    Mutant(\n101|        name=\"N-containment-mismatch\",\n102|        path=f\"{PACKAGE}/runtime.go\",\n103|        find=\"\\treturn sameDirectory(handleInfo, pathInfo)\\n\",\n104|        replace=\"\\treturn sameDirectory(handleInfo, pathInfo) || handleInfo.IsDir()\\n\",\n105|        count=1,\n106|        run=\"TestEnsureRuntimeDirRefusesHandleMismatch\",\n107|        expect=\"KILLED\",\n108|        note=\"Admits exactly directory handles past the handle-binding check; the mismatch still refuses for non-directo