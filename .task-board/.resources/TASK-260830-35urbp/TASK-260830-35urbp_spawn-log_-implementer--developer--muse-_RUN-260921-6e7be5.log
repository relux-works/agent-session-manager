{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c615","stream":{"kind":"session","id":"01a0c3b6-e69d-7952-b5c2-99ff4034d208"},"sequence":357,"recorded_at":1780531400000709,"record_type":"event","durability":"durable","causation_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","run_stream":{"kind":"run","id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8"},"task_stream":{"kind":"task","id":"01a0c3b7-f7bb-7ca3-b370-e28c15ca5884"},"task_id":"01a0c3b7-f7bb-7ca3-b370-e28c15ca5884","event":{"kind":"output","task_id":"01a0c3b7-f7bb-7ca3-b370-e28c15ca5884","chunk":"Read text file `internal/tmuxserver/socket.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"path/filepath\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n7|)\n8|\n9|// SocketName is the fixed private socket leaf inside the runtime\n10|// directory. AX derives its server socket from this name under the\n11|// owner-only directory and from nothing else.\n12|const SocketName = \"ax-tmux.sock\"\n13|\n14|// Ambient environment names the four discovery vectors AX must never\n15|// use. TMUXEnv and TMUXTmpDir name the two environment variables\n16|// whose values may carry an ambient socket; InheritedSocket is a\n17|// socket path handed to the process out of band; DefaultPath is the\n18|// operator default socket path; ConventionalName is the bare\n19|// conventional socket name. No member of this struct ever selects\n20|// the acquisition socket: ResolveSocket derives the socket from the\n21|// runtime directory and refuses any explicit override.\n22|type Ambient struct {\n23|\tTMUXEnv          string\n24|\tTMUXTmpDir       string\n25|\tInheritedSocket  string\n26|\tDefaultPath      string\n27|\tConventionalName string\n28|}\n29|\n30|// Ambient environment variable names. Both are validated by the\n31|// landed environment-name grammar at the observation boundary, so a\n32|// misspelled variable cannot smuggle an ambient value past the\n33|// non-use proof.\n34|const (\n35|\t// EnvTMUX is the tmux(1) session environment variable.\n36|\tEnvTMUX = \"TMUX\"\n37|\t// EnvTMUXTmpDir is the tmux(1) socket-directory override.\n38|\tEnvTMUXTmpDir = \"TMUX_TMPDIR\"\n39|)\n40|\n41|// ConventionalSocketName is the operator default socket leaf that AX\n42|// must never resolve to.\n43|const ConventionalSocketName = \"default\"\n44|\n45|// ObserveAmbient records the ambient socket facts visible to the\n46|// caller without using any of them. The lookup is caller-supplied so\n47|// the production entry never reads the process environment itself:\n48|// ambient discovery cannot hide in an os.Getenv call this package\n49|// never makes. Unknown variable names refuse rather than being\n50|// silently skipped, so a renamed vector cannot pass unobserved.\n51|func ObserveAmbient(lookup func(name string) (string, bool), inherited, defPath, conventional string) (Ambient, error) {\n52|\tif !secprim.IsEnvName(EnvTMUX) || !secprim.IsEnvName(EnvTMUXTmpDir) {\n53|\t\treturn Ambient{}, &Error{Code: CodeInvalidArguments, Detail: \"ambient vocabulary\"}\n54|\t}\n55|\tobserved := Ambient{\n56|\t\tInheritedSocket:  inherited,\n57|\t\tDefaultPath:      defPath,\n58|\t\tConventionalName: conventional,\n59|\t}\n60|\tif lookup == nil {\n61|\t\treturn observed, nil\n62|\t}\n63|\tif value, ok := lookup(EnvTMUX); ok {\n64|\t\tobserved.TMUXEnv = value\n65|\t}\n66|\tif value, ok := lookup(EnvTMUXTmpDir); ok {\n67|\t\tobserved.TMUXTmpDir = value\n68|\t}\n69|\treturn observed, nil\n70|}\n71|\n72|// SocketPath derives the dedicated server socket from the runtime\n73|// directory. It is the only socket constructor: acquisition never\n74|// substitutes an ambient value for its result.\n75|func SocketPath(runtimeDir string) string {\n76|\treturn filepath.Join(runtimeDir, SocketName)\n77|}\n78|\n79|// ResolveSocket returns the acquisition socket for the runtime\n80|// directory. An explicit override refuses with the ambient code no\n81|// matter which vector supplied it: there is no override surface,\n82|// only the derived socket. The ambient observation is carried for\n83|// evidence and asserted disjoint from the result by the caller\n84|// tests; resolution never reads it.\n85|func ResolveSocket(runtimeDir string, override string, ambient Ambient) (string, error) {\n86|\tif override != \"\" {\n87|\t\treturn \"\", &Error{Code: CodeAmbientReuse, Detail: \"socket override\"}\n88|\t}\n89|\tsocket := SocketPath(runtimeDir)\n90|\tif err := checkAmbientDisjoint(socket, ambient); err != nil {\n91|\t\treturn \"\", err\n92|\t}\n93|\treturn socket, nil\n94|}\n95|\n96|// checkAmbientDisjoint refuses the degenerate case where an ambient\n97|// value already names the derived socket: using the socket then\n98|// would be indistinguishable from reusing the ambient server, so\n99|// acquisition refuses instead of proceeding on an ambiguous fact.\n100|func checkAmbientDisjoint(socket string, ambient Ambient) error {\n101|\tfor _, candidate := range []string{\n102|\t\tambient.TMUXEnv,\n103|\t\tambient.TMUXTmpDir,\n104|\t\tambient.InheritedSocket,\n105|\t\tambient.DefaultPath,\n106|\t\tambient.ConventionalName,\n107|\t} {\n108|\t\tif candidate != \"\" && candidate == socket {\n109|\t\t\treturn &Error{Code: CodeAmbientReuse, Detail: \"ambient collision\"}\n110|\t\t}\n111|\t}\n112|\treturn nil\n113|}","final_result":true}}}
