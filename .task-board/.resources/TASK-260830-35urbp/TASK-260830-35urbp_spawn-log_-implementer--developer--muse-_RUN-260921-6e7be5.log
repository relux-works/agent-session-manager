trequireLocalError(t, err, \"tmux_ambient_server_reuse\", \"spawn socket\")\n40|\t\t})\n41|\t}\n42|}\n43|\n44|func TestBuildArgvRefusesMalformedSession(t *testing.T) {\n45|\tdir := runtimeDir(t, stateRoot(t))\n46|\tfor _, session := range []string{\"\", \"12345\", \"not-a-uuid\", \"0198f4c8-7d40-7e55-8e6f-1234567890ag\"} {\n47|\t\t_, err := BuildArgv(dir, SocketPath(dir), session)\n48|\t\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"session identity\")\n49|\t}\n50|}","final_result":true}}}
