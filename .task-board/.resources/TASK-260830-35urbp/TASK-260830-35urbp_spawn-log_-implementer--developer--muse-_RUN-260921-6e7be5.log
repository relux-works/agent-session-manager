{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8e7","stream":{"kind":"session","id":"01a0c3b6-e69d-7952-b5c2-99ff4034d208"},"sequence":718,"recorded_at":1780531400001431,"record_type":"event","durability":"durable","causation_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","run_stream":{"kind":"run","id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8"},"call_id":"call_01a0c3babd317655ad9a6e3e992d5a3d","text":"Read text file `internal/tmuxserver/readiness_test.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"testing\"\n5|)\n6|\n7|func TestCheckLiveAttestationAdmitsComplete(t *testing.T) {\n8|\tif err := CheckLiveAttestation(liveAttestation()); err != nil {\n9|\t\tt.Fatal(err)\n10|\t}\n11|}\n12|\n13|func TestCheckLiveAttestationRefusesEachMissingConjunct(t *testing.T) {\n14|\tbase := liveAttestation()\n15|\tfor _, tc := range []struct {\n16|\t\tname   string\n17|\t\tmutate func(*LiveAttestation)\n18|\t\tdetail string\n19|\t}{\n20|\t\t{\"sentinel only is insufficient\", func(l *LiveAttestation) { l.SmokePassed = false }, \"provider smoke result\"},\n21|\t\t{\"smoke only is insufficient\", func(l *LiveAttestation) { l.SentinelPassed = false }, \"sentinel result\"},\n22|\t\t{\"unbound generation\", func(l *LiveAttestation) { l.ServerGeneration = \"\" }, \"attestation binding\"},\n23|\t\t{\"unbound provider build\", func(l *LiveAttestation) { l.ProviderBuild = \"\" }, \"attestation binding\"},\n24|\t\t{\"unbound macos version\", func(l *LiveAttestation) { l.MacOSVersion = \"\" }, \"attestation binding\"},\n25|\t} {\n26|\t\tt.Run(tc.name, func(t *testing.T) {\n27|\t\t\tlive := base\n28|\t\t\ttc.mutate(&live)\n29|\t\t\trequireLocalError(t, CheckLiveAttestation(live), \"tmux_readiness_not_authorizing\", tc.detail)\n30|\t\t})\n31|\t}\n32|}\n33|\n34|func TestCheckBrokerContactAdmitsAuthenticatedAttested(t *testing.T) {\n35|\tstatus := BrokerStatus{Authenticated: true, Attested: true, Attestation: liveAttestation()}\n36|\tif err := CheckBrokerContact(status); err != nil {\n37|\t\tt.Fatal(err)\n38|\t}\n39|}\n40|\n41|func TestCheckBrokerContactRefusesEachMissingFact(t *testing.T) {\n42|\tlive := liveAttestation()\n43|\tfor _, tc := range []struct {\n44|\t\tname   string\n45|\t\tstatus BrokerStatus\n46|\t\tdetail string\n47|\t}{\n48|\t\t{\"no broker\", BrokerStatus{}, \"broker authentication\"},\n49|\t\t{\"unauthenticated broker\", BrokerStatus{Attested: true, Attestation: live}, \"broker authentication\"},\n50|\t\t{\"unattested server\", BrokerStatus{Authenticated: true, Attestation: live}, \"server attestation\"},\n51|\t\t{\"sentinel-only attestation\", BrokerStatus{Authenticated: true, Attested: true, Attestation: LiveAttestation{\n52|\t\t\tSentinelPassed:   true,\n53|\t\t\tServerGeneration: fixtureGeneration,\n54|\t\t\tProviderBuild:    fixtureProvider,\n55|\t\t\tMacOSVersion:     fixtureMacOS,\n56|\t\t}}, \"provider smoke result\"},\n57|\t} {\n58|\t\tt.Run(tc.name, func(t *testing.T) {\n59|\t\t\trequireLocalError(t, CheckBrokerContact(tc.status), \"tmux_readiness_not_authorizing\", tc.detail)\n60|\t\t})\n61|\t}\n62|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8e9","stream":{"kind":"session","id":"01a0c3b6-e69d-7952-b5c2-99ff4034d208"},"sequence":719,"recorded_at":1780531400001433,"record_type":"event","durability":"durable","causation_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","run_stream":{"kind":"run","id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8"},"call_id":"call_01a0c3babfed7735952504f877813b06","text":"Read text file `internal/tmuxserver/socket_test.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|)\n7|\n8|func TestObserveAmbientRecordsWithoutUsing(t *testing.T) {\n9|\thostile := hostileAmbient()\n10|\tobserved, err := ObserveAmbient(func(name string) (string, bool) {\n11|\t\tswitch name {\n12|\t\tcase \"TMUX\":\n13|\t\t\treturn hostile.TMUXEnv, true\n14|\t\tcase \"TMUX_TMPDIR\":\n15|\t\t\treturn hostile.TMUXTmpDir, true\n16|\t\tdefault:\n17|\t\t\treturn \"\", false\n18|\t\t}\n19|\t}, hostile.InheritedSocket, hostile.DefaultPath, hostile.ConventionalName)\n20|\tif err != nil {\n21|\t\tt.Fatal(err)\n22|\t}\n23|\tif observed != hostile {\n24|\t\tt.Fatalf(\"observed = %+v, want %+v\", observed, hostile)\n25|\t}\n26|}\n27|\n28|func TestObserveAmbientNilLookupKeepsOutOfBand(t *testing.T) {\n29|\tobserved, err := ObserveAmbient(nil, \"/tmp/x.sock\", \"/tmp/tmux-501/default\", \"default\")\n30|\tif err != nil {\n31|\t\tt.Fatal(err)\n32|\t}\n33|\tif observed.TMUXEnv != \"\" || observed.TMUXTmpDir != \"\" {\n34|\t\tt.Fatalf(\"nil lookup observed env: %+v\", observed)\n35|\t}\n36|\tif observed.InheritedSocket != \"/tmp/x.sock\" {\n37|\t\tt.Fatalf(\"observed = %+v\", observed)\n38|\t}\n39|}\n40|\n41|func TestResolveSocketDerivesIgnoringAmbient(t *testing.T) {\n42|\tdir := runtimeDir(t, stateRoot(t))\n43|\tsocket, err := ResolveSocket(dir, \"\", hostileAmbient())\n44|\tif err != nil {\n45|\t\tt.Fatal(err)\n46|\t}\n47|\tif socket != SocketPath(dir) {\n48|\t\tt.Fatalf(\"socket = %q\", socket)\n49|\t}\n50|\tfor _, ambient := range []string{\n51|\t\thostileAmbient().TMUXEnv,\n52|\t\thostileAmbient().TMUXTmpDir,\n53|\t\thostileAmbient().InheritedSocket,\n54|\t\thostileAmbient().DefaultPath,\n55|\t\thostileAmbient().ConventionalName,\n56|\t} {\n57|\t\tif strings.Contains(socket, ambient) || socket == ambient {\n58|\t\t\tt.Fatalf(\"socket %q reuses ambient %q\", socket, ambient)\n59|\t\t}\n60|\t}\n61|}\n62|\n63|func TestResolveSocketRefusesEveryOverrideVector(t *testing.T) {\n64|\tdir := runtimeDir(t, stateRoot(t))\n65|\thostile := hostileAmbient()\n66|\tvectors := map[string]string{\n67|\t\t\"environment variable\": hostile.TMUXEnv,\n68|\t\t\"inherited socket\":     hostile.InheritedSocket,\n69|\t\t\"default path\":         hostile.DefaultPath,\n70|\t\t\"conventional name\":    hostile.ConventionalName,\n71|\t}\n72|\tfor name, override := range vectors {\n73|\t\tt.Run(name, func(t *testing.T) {\n74|\t\t\t_, err := ResolveSocket(dir, override, Ambient{})\n75|\t\t\trequireLocalError(t, err, \"tmux_ambient_server_reuse\", \"socket override\")\n76|\t\t})\n77|\t}\n78|}\n79|\n80|func TestResolveSocketRefusesAmbientCollision(t *testing.T) {\n81|\tdir := runtimeDir(t, stateRoot(t))\n82|\tderived := SocketPath(dir)\n83|\t_, err := ResolveSocket(dir, \"\", Ambient{DefaultPath: derived})\n84|\trequireLocalError(t, err, \"tmux_ambient_server_reuse\", \"ambient collision\")\n85|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
