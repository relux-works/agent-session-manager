esModeUnderRestrictiveUmask(t *testing.T) {\n+\troot := stateRoot(t)\n+\tprevious := syscall.Umask(0o177)\n+\tdefer syscall.Umask(previous)\n+\tdir, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tinfo, err := os.Lstat(dir)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif !info.IsDir() || info.Mode().Perm() != 0o700 {\n+\t\tt.Fatalf(\"mode under umask 0177 = %04o dir=%v, want 0700 dir\", info.Mode().Perm(), info.IsDir())\n+\t}\n+}\n","edit_facts":{"tool_name":"edit_file","path":"internal/tmuxserver/runtime_test.go","added":40,"removed":4},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
