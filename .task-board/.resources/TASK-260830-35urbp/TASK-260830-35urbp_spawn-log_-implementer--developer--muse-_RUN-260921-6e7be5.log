uses.\",\n209|    ),\n210|    Mutant(\n211|        name=\"N-attestation-binding\",\n212|        path=f\"{PACKAGE}/readiness.go\",\n213|        find='\\tif live.ServerGeneration == \"\" || live.ProviderBuild == \"\" || live.MacOSVersion == \"\" {\\n',\n214|        replace='\\tif live.ServerGeneration == \"\" || live.ProviderBuild == \"\" {\\n',\n215|        count=1,\n216|        run=\"TestCheckLiveAttestationRefusesEachMissingConjunct\",\n217|        expect=\"KILLED\",\n218|        note=\"Admits exactly macOS-unbound observations past the binding arm; generation- and build-unbound still refuse.\",\n219|    ),\n220|    Mutant(\n221|        name=\"N-broker-auth\",\n222|        path=f\"{PACKAGE}/readiness.go\",\n223|        find=\"\\tif !status.Authenticated {\\n\",\n224|        replace=\"\\tif !status.Authenticated && !status.Attested {\\n\",\n225|        count=1,\n226|        run=f\"(TestCheckBrokerContactRefusesEachMissingFact|{BG_MISS})\",\n227|        expect=\"KILLED\",\n228|        note=\"Admits exactly attested-but-unauthenticated brokers; every other broker report still refuses.\",\n229|    ),\n230|    Mutant(\n231|        name=\"N-broker-attested\",\n232|        path=f\"{PACKAGE}/readiness.go\",\n233|        find=\"\\tif !status.Attested {\\n\",\n234|        replace=\"\\tif !status.Attested && !status.Authenticated {\\n\",\n235|        count=1,\n236|        run=f\"(TestCheckBrokerContactRefusesEachMissingFact|{BG_MISS})\",\n237|        expect=\"KILLED\",\n238|        note=\"Admits exactly authenticated-but-unattested servers; every other broker report still refuses.\",\n239|    ),\n240|    Mutant(\n241|        name=\"N-creation-literal\",\n242|        path=f\"{PACKAGE}/acquire.go\",\n243|        find=\"\\tif caller == CallerBackground {\\n\",\n244|        replace='\\tif caller == \"Background\" {\\n',\n245|        count=1,\n246|        run=f\"(TestCheckCreationAllowedRefusesBackground|{BG_MISS})\",\n247|        expect=\"KILLED\",\n248|        note=\"Admits exactly the background caller at the creation choke point; the gate still refuses the capitalized twin. Kill path: background miss reports the creation code instead of the typed unavailable.\",\n249|    ),\n250|    Mutant(\n251|        name=\"N-caller-vocabulary\",\n252|        path=f\"{PACKAGE}/acquire.go\",\n253|        find=\"\\tif req.Caller != CallerForeground && req.Caller != CallerBackground {\\n\",\n254|        replace='\\tif req.Caller != CallerForeground && req.Caller != CallerBackground && req.Caller != \"operator\" {\\n',\n255|        count=1,\n256|        run=\"TestAcquireRefusesUnknownCaller\",\n257|        expect=\"KILLED\",\n258|        note=\"Admits exactly the operator caller past the vocabulary arm; every other unknown caller still refuses. Kill reroutes to the dependencies refusal.\",\n259|    ),\n260|    Mutant(\n261|        name=\"N-details-remediation\",\n262|        path=f\"{PACKAGE}/acquire.go\",\n263|        find='\\tif req.Generation == \"\" || req.BrokerState == \"\" || req.Remediation == \"\" {\\n',\n264|        replace='\\tif req.Generation == \"\" || req.BrokerState == \"\" {\\n',\n265|        count=1,\n266|        run=\"TestAcquireRefusesMissingRealmDetails\",\n267|        expect=\"KILLED\",\n268|        note=\"Admits exactly remediation-less requests past the typed-details arm; generation- and broker-less still refuse. Kill reroutes to the dependencies refusal.\",\n269|    ),\n270|    Mutant(\n271|        name=\"N-unattested-foreground\",\n272|        path=f\"{PACKAGE}/acquire.go\",\n273|        find=\"\\t\\tif err := CheckLiveAttestation(report.Attestation); err != nil {\\n\\t\\t\\treturn Outcome{}, err\\n\\t\\t}\\n\",\n274|        replace=\"\\t\\tif err := CheckLiveAttestation(report.Attestation); err != nil && !report.Attestation.SentinelPassed {\\n\\t\\t\\treturn Outcome{}, err\\n\\t\\t}\\n\",\n275|        count=1,\n276|        run=\"TestAcquireForegroundRefusesRunningUnattested\",\n277|        expect=\"KILLED\",\n278|        note=\"Admits exactly sentinel-passed-but-smoke-missing running servers to attach; every other unattested report still refuses.\",\n279|    ),\n280|    Mutant(\n281|        name=\"N-spawn-swallow\",\n282|        path=f\"{PACKAGE}/acquire.go\",\n283|        find=\"\\tif err := req.Deps.Spawn(socket, argv); err != nil {\\n\",\n284|        replace='\\tif err := req.Deps.Spawn(socket, argv); err != nil && err.Error() != \"exec failed\" {\\n',\n285|        count=1,\n286|        run=\"TestAcquireForegroundSpawnFailureReportsWithoutFallback\",\n287|        expect=\"KILLED\",\n288|        note=\"Admits exactly the fixture spawn failure as success; every other spawn failure still reports.\",\n289|    ),\n290|    Mutant(\n291|        name=\"N-probe-swallow-foreground\",\n292|        path=f\"{PACKAGE}/acquire.go\",\n293|        find=\"\\treport, err := req.Deps.ProbeServer(socket)\\n\\tif err != nil {\\n\",\n294|        replace='\\treport, err := req.Deps.ProbeServer(socket)\\n\\tif err != nil && err.Error() != \"probe boom\" {\\n',\n295|        count=1,\n296|        run=\"TestAcquireForegroundProbeFailurePassesThrough\",\n297|        expect=\"KILLED\",\n298|        note=\"Admits exactly the fixture probe failure as an absent server (then spawns); every other probe failure still passes through.\",\n299|    ),\n300|    Mutant(\n301|        name=\"N-probe-swallow-background\",\n302|        path=f\"{PACKAGE}/acquire.go\",\n303|        find=\"\\tstatus, err := req.Deps.ProbeBroker()\\n\\tif err != nil {\\n\",\n304|        replace='\\tstatus, err := req.Deps.ProbeBroker()\\n\\tif err != nil && err.Error() != \"probe boom\" {\\n',\n305|        count=1,\n306|        run=\"TestAcquireBackgroundProbeFailurePassesThrough\",\n307|        expect=\"KILLED\",\n308|        note=\"Admits exactly the fixture probe failure as a broker miss (then reports unavailable); every other probe failure still passes through.\",\n309|    ),\n310|    Mutant(\n311|        name=\"N-argv-socket\",\n312|        path=f