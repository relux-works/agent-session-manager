tate:      fixtureBroker,\n42|\t\tRemediation:      fixtureRemedy,\n43|\t\tNeedsCredentials: false,\n44|\t}\n45|}\n46|\n47|func hostileAmbient() Ambient {\n48|\treturn Ambient{\n49|\t\tTMUXEnv:          \"/tmp/tmux-501/default,12345,0\",\n50|\t\tTMUXTmpDir:       \"/tmp/operator-tmux\",\n51|\t\tInheritedSocket:  \"/tmp/inherited.sock\",\n52|\t\tDefaultPath:      \"/tmp/tmux-501/default\",\n53|\t\tConventionalName: \"default\",\n54|\t}\n55|}\n56|\n57|func requireLocalError(t *testing.T, err error, code, detail string) {\n58|\tt.Helper()\n59|\tif err == nil {\n60|\t\tt.Fatalf(\"err = nil, want %s at %s\", code, detail)\n61|\t}\n62|\tvar local *Error\n63|\tif !errors.As(err, &local) {\n64|\t\tt.Fatalf(\"err type = %T (%v), want *tmuxserver.Error\", err, err)\n65|\t}\n66|\tif local.Code != code || local.Detail != detail {\n67|\t\tt.Fatalf(\"err = %s at %s, want %s at %s\", local.Code, local.Detail, code, detail)\n68|\t}\n69|}\n70|\n71|func requireCapabilityUnavailable(t *testing.T, err error, caller, broker, generation, remedy string) {\n72|\tt.Helper()\n73|\tif err == nil {\n74|\t\tt.Fatal(\"err = nil, want capability_unavailable\")\n75|\t}\n76|\tvar failure *axerror.Error\n77|\tif !errors.As(err, &failure) {\n78|\t\tt.Fatalf(\"err type = %T (%v), want *axerror.Error\", err, err)\n79|\t}\n80|\tif string(failure.Code()) != \"capability_unavailable\" {\n81|\t\tt.Fatalf(\"code = %q, want %q\", string(failure.Code()), \"capability_unavailable\")\n82|\t}\n83|\tif failure.ExitCode() != 6 {\n84|\t\tt.Fatalf(\"exit = %d, want 6\", failure.ExitCode())\n85|\t}\n86|\twant := map[string]string{\n87|\t\t\"capability\":             \"credential_capable_execution_realm\",\n88|\t\t\"caller_realm\":           caller,\n89|\t\t\"broker_state\":           broker,\n90|\t\t\"tmux_server_generation\": generation,\n91|\t\t\"remediation\":            remedy,\n92|\t}\n93|\tfor key, value := range want {\n94|\t\tgot, ok := failure.Detail(key)\n95|\t\tif !ok {\n96|\t\t\tt.Fatalf(\"missing typed detail %q\", key)\n97|\t\t}\n98|\t\tif got != value {\n99|\t\t\tt.Fatalf(\"detail %q = %v, want %q\", key, got, value)\n100|\t\t}\n101|\t}\n102|}\n103|\n104|type spawnSpy struct {\n105|\tcalls  int\n106|\tsocket string\n107|\targv   []string\n108|\terr    error\n109|}\n110|\n111|func (spy *spawnSpy) spawn(socket string, argv []string) error {\n112|\tspy.calls++\n113|\tspy.socket = socket\n114|\tspy.argv = append([]string(nil), argv...)\n115|\treturn spy.err\n116|}\n117|\n118|func stateRoot(t *testing.T) string {\n119|\tt.Helper()\n120|\troot := t.TempDir()\n121|\tif err := os.Chmod(root, 0o755); err != nil {\n122|\t\tt.Fatal(err)\n123|\t}\n124|\treturn root\n125|}\n126|\n127|func runtimeDir(t *testing.T, root string) string {\n128|\tt.Helper()\n129|\tdir, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n130|\tif err != nil {\n131|\t\tt.Fatal(err)\n132|\t}\n133|\treturn dir\n134|}\n135|\n136|func TestSocketPathDerivesOnlyFromRuntimeDir(t *testing.T) {\n137|\tdir := filepath.Join(t.TempDir(), RuntimeDirName)\n138|\tif got := SocketPath(dir); got != filepath.Join(dir, \"ax-tmux.sock\") {\n139|\t\tt.Fatalf(\"SocketPath = %q\", got)\n140|\t}\n141|}","final_result":true}}}
