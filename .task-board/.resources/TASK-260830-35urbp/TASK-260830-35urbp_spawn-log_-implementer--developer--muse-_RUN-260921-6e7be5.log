nt == \"\" {\n40|\t\t\tcontinue\n41|\t\t}\n42|\t\tif outcome.Socket == ambient {\n43|\t\t\tt.Fatalf(\"socket reuses ambient vector %d\", i)\n44|\t\t}\n45|\t\tfor _, arg := range spy.argv {\n46|\t\t\tif arg == ambient {\n47|\t\t\t\tt.Fatalf(\"argv carries ambient vector %d: %q\", i, arg)\n48|\t\t\t}\n49|\t\t}\n50|\t}\n51|\twantTail := []string{\"ax\", \"pane\", fixtureSession}\n52|\ttail := spy.argv[len(spy.argv)-3:]\n53|\tfor i := range wantTail {\n54|\t\tif tail[i] != wantTail[i] {\n55|\t\t\tt.Fatalf(\"argv tail = %q, want %q\", tail, wantTail)\n56|\t\t}\n57|\t}\n58|}\n59|\n60|func socketDir(t *testing.T, root string) string {\n61|\tt.Helper()\n62|\treturn runtimeDir(t, root)\n63|}\n64|\n65|func TestAcquireForegroundAttachesToRunningAttested(t *testing.T) {\n66|\troot := stateRoot(t)\n67|\treq := validRequest(t, root)\n68|\tspy := &spawnSpy{}\n69|\tprobed := \"\"\n70|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n71|\t\tprobed = socket\n72|\t\treturn ServerReport{Running: true, Attestation: liveAttestation()}, nil\n73|\t}\n74|\treq.Deps.Spawn = spy.spawn\n75|\toutcome, err := Acquire(req)\n76|\tif err != nil {\n77|\t\tt.Fatal(err)\n78|\t}\n79|\tif outcome.Via != \"attached-running\" {\n80|\t\tt.Fatalf(\"via = %q\", outcome.Via)\n81|\t}\n82|\tif probed != outcome.Socket || outcome.Socket != SocketPath(socketDir(t, root)) {\n83|\t\tt.Fatalf(\"probed = %q socket = %q\", probed, outcome.Socket)\n84|\t}\n85|\tif spy.calls != 0 {\n86|\t\tt.Fatalf(\"spawn calls = %d, want 0 on attach\", spy.calls)\n87|\t}\n88|}\n89|\n90|func TestAcquireForegroundRefusesRunningUnattested(t *testing.T) {\n91|\troot := stateRoot(t)\n92|\tlive := liveAttestation()\n93|\tlive.SmokePassed = false\n94|\treq := validRequest(t, root)\n95|\tspy := &spawnSpy{}\n96|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n97|\t\treturn ServerReport{Running: true, Attestation: live}, nil\n98|\t}\n99|\treq.Deps.Spawn = spy.spawn\n100|\t_, err := Acquire(req)\n101|\trequireLocalError(t, err, \"tmux_readiness_not_authorizing\", \"provider smoke result\")\n102|\tif spy.calls != 0 {\n103|\t\tt.Fatalf(\"spawn calls = %d, want 0 on unattested\", spy.calls)\n104|\t}\n105|}\n106|\n107|func TestAcquireForegroundProbeFailurePassesThrough(t *testing.T) {\n108|\troot := stateRoot(t)\n109|\treq := validRequest(t, root)\n110|\tspy := &spawnSpy{}\n111|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n112|\t\treturn ServerReport{}, errProbeBoom\n113|\t}\n114|\treq.Deps.Spawn = spy.spawn\n115|\t_, err := Acquire(req)\n116|\tif !errors.Is(err, errProbeBoom) {\n117|\t\tt.Fatalf(\"err = %v, want the probe failure\", err)\n118|\t}\n119|\tif spy.calls != 0 {\n120|\t\tt.Fatalf(\"spawn calls = %d, want 0 on unknown\", spy.calls)\n121|\t}\n122|}\n123|\n124|func TestAcquireForegroundSpawnFailureReportsWithoutFallback(t *testing.T) {\n125|\troot := stateRoot(t)\n126|\treq := validRequest(t, root)\n127|\tspy := &spawnSpy{err: errors.New(\"exec failed\")}\n128|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n129|\t\treturn ServerReport{}, nil\n130|\t}\n131|\treq.Deps.Spawn = spy.spawn\n132|\t_, err := Acquire(req)\n133|\trequireLocalError(t, err, \"tmux_server_spawn_failed\", \"server spawn\")\n134|\tif spy.calls != 1 {\n135|\t\tt.Fatalf(\"spawn calls = %d, want exactly 1\", spy.calls)\n136|\t}\n137|}\n138|\n139|func TestAcquireForegroundRefusesMalformedSession(t *testing.T) {\n140|\troot := stateRoot(t)\n141|\treq := validRequest(t, root)\n142|\treq.SessionID = \"12345\"\n143|\tspy := &spawnSpy{}\n144|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n145|\t\treturn ServerReport{}, nil\n146|\t}\n147|\treq.Deps.Spawn = spy.spawn\n148|\t_, err := Acquire(req)\n149|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"session identity\")\n150|\tif spy.calls != 0 {\n151|\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n152|\t}\n153|}\n154|\n155|func TestAcquireBackgroundContactsBroker(t *testing.T) {\n156|\troot := stateRoot(t)\n157|\treq := validRequest(t, root)\n158|\treq.Caller = CallerBackground\n159|\treq.Platform = scalar.PlatformMacOS\n160|\treq.NeedsCredentials = true\n161|\tspy := &spawnSpy{}\n162|\tprobed := false\n163|\treq.Deps.ProbeBroker = func() (BrokerStatus, error) {\n164|\t\tprobed = true\n165|\t\treturn BrokerStatus{Authenticated: true, Attested: true, Attestation: liveAttestation()}, nil\n166|\t}\n167|\treq.Deps.Spawn = spy.spawn\n168|\toutcome, err := Acquire(req)\n169|\tif err != nil {\n170|\t\tt.Fatal(err)\n171|\t}\n172|\tif !probed {\n173|\t\tt.Fatal(\"broker was not probed\")\n174|\t}\n175|\tif outcome.Via != \"broker\" {\n176|\t\tt.Fatalf(\"via = %q\", outcome.Via)\n177|\t}\n178|\tif outcome.Socket != SocketPath(socketDir(t, root)) {\n179|\t\tt.Fatalf(\"socket = %q\", outcome.Socket)\n180|\t}\n181|\tif len(outcome.Argv) != 0 {\n182|\t\tt.Fatalf(\"broker outcome carries argv %q\", outcome.Argv)\n183|\t}\n184|\tif spy.calls != 0 {\n185|\t\tt.Fatalf(\"spawn calls = %d, want 0 on broker contact\", spy.calls)\n186|\t}\n187|}\n188|\n189|func TestAcquireBackgroundMissReturnsTypedUnavailable(t *testing.T) {\n190|\tfor _, tc := range []struct {\n191|\t\tname   string\n192|\t\tstatus BrokerStatus\n193|\t}{\n194|\t\t{\"no broker\", BrokerStatus{}},\n195|\t\t{\"unauthenticated broker\", BrokerStatus{Attested: true, Attestation: liveAttestation()}},\n196|\t\t{\"unattested server\", BrokerStatus{Authenticated: true, Attestation: liveAttestation()}},\n197|\t\t{\"sentinel-only attestation\", BrokerStatus{Authenticated: true, Attested: true, Attestation: LiveAttestation{\n198|\t\t\tSentinelPassed:   true,\n199|\t\t\tServerGeneration: fixtureGeneration,\n200|\t\t\tProviderBuild:    fixtureProvider,\n201|\t\t\tMacOSVersion:     fixtureMacOS,\n202|\t\t}}},\n203|\t} {\n204|\t\tt.Run(tc.name, func(t *testing.T) {\n205|\t\t\troot := stateRoot(t)\n206|\t\t\treq := validRequest(t, root)\n207|\t\t\treq.Caller = CallerBackground\n208|\t\t\treq.Platform = scalar.PlatformMacOS\n209|\t\t\treq.NeedsCredentials = true\n210|\t\t\tspy := &spawnSpy{}\n211|\t\t\t// Even a spawner that would succeed must never run:\n212|\t\t\t// the miss path has no fallback to direct creation.\n213|\t\t\treq.Deps.Spawn = spy.spawn\n214|\t\t\treq.Deps.ProbeBroker = func() (BrokerStatus, error) {\n215|\t\t\t\treturn tc.status, nil\n216|\t\t\t}\n217|\t\t\t_, err := Acquire(req)\n218|\t\t\trequireCapabilityUnavailable(t, err, \"background\", fixtureBroker, fixtureGeneration, fixtureRemedy)\n219|\t\t\tif spy.calls != 0 {\n220|\t\t\t\tt.Fatalf(\"spawn calls = %d, want 0 without fallback\", spy.calls)\n221|\t\t\t}\n222|\t\t})\n223|\t}\n224|}\n225|\n226|func TestAcquireBackgroundMissOnLinuxAlsoRefusesWithoutFallback(t *testing.T) {\n227|\troot := stateRoot(t)\n228|\treq := validRequest(t, root)\n229|\treq.Caller = CallerBackground\n230|\treq.Platform = scalar.PlatformLinux\n231|\tspy := &spawnSpy{}\n232|\treq.Deps.Spawn = spy.spawn\n233|\treq.Deps.ProbeBroker = func() (BrokerStatus, error) {\n234|\t\treturn BrokerStatus{}, nil\n235|\t}\n236|\t_, err := Acquire(req)\n237|\trequireCapabilityUnavailable(t, err, \"background\", fixtureBroker, fixtureGeneration, fixtureRemedy)\n238|\tif spy.calls != 0 {\n239|\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n240|\t}\n241|}\n242|\n243|func TestAcquireBackgroundHintAndCacheAuthorizeNothing(t *testing.T) {\n244|\troot := stateRoot(t)\n245|\treq := validRequest(t, root)\n246|\treq.Caller = CallerBackground\n247|\treq.Hint = ManagerNameHint{Value: \"Aqua\"}\n248|\treq.Cached = &CachedObservation{SentinelPassed: true, ManagerName: \"Aqua\"}\n249|\tspy := &spawnSpy{}\n250|\treq.Deps.Spawn = spy.spawn\n251|\treq.Deps.ProbeBroker = func() (BrokerStatus, error) {\n252|\t\treturn BrokerStatus{}, nil\n253|\t}\n254|\t_, err := Acquire(req)\n255|\trequireCapabilityUnavailable(t, err, \"background\", fixtureBroker, fixtureGeneration, fixtureRemedy)\n256|\tif spy.calls != 0 {\n257|\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n258|\t}\n259|}\n260|\n261|func TestAcquireForegroundHintAndCacheChangeNothing(t *testing.T) {\n262|\troot := stateRoot(t)\n263|\treq := validRequest(t, root)\n264|\treq.Hint = ManagerNameHint{Value: \"Aqua\"}\n265|\treq.Cached = &CachedObservation{SentinelPassed: true, ManagerName: \"Aqua\"}\n266|\tspy := &spawnSpy{}\n267|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n268|\t\treturn ServerReport{}, nil\n269|\t}\n270|\treq.Deps.Spawn = spy.spawn\n271|\toutcome, err := Acquire(req)\n272|\tif err != nil {\n273|\t\tt.Fatal(err)\n274|\t}\n275|\t// A cached pass must not fake a running server: the absent\n276|\t// server still spawns through the live path.\n277|\tif outcome.Via != \"spawned\" || spy.calls != 1 {\n278|\t\tt.Fatalf(\"via = %q calls = %d\", outcome.Via, spy.calls)\n279|\t}\n280|}\n281|\n282|func TestAcquireBackgroundProbeFailurePassesThrough(t *testing.T) {\n283|\troot := stateRoot(t)\n284|\treq := validRequest(t, root)\n285|\treq.Caller = CallerBackground\n286|\tspy := &spawnSpy{}\n287|\treq.Deps.Spawn = spy.spawn\n288|\treq.Deps.ProbeBroker = func() (BrokerStatus, error) {\n289|\t\treturn BrokerStatus{}, errProbeBoom\n290|\t}\n291|\t_, err := Acquire(req)\n292|\tif !errors.Is(err, errProbeBoom) {\n293|\t\tt.Fatalf(\"err = %v, want the probe failure, not unavailable\", err)\n294|\t}\n295|\tif spy.calls != 0 {\n296|\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n297|\t}\n298|}\n299|\n300|func TestAcquireRefusesEveryAmbientOverrideVector(t *testing.T) {\n301|\thostile := hostileAmbient()\n302|\tvectors := map[string]string{\n303|\t\t\"environment variable\": hostile.TMUXEnv,\n304|\t\t\"inherited socket\":     hostile.InheritedSocket,\n305|\t\t\"default path\":         hostile.DefaultPath,\n306|\t\t\"conventional name\":    hostile.ConventionalName,\n307|\t}\n308|\tfor name, override := range vectors {\n309|\t\tt.Run(name, func(t *testing.T) {\n310|\t\t\troot := stateRoot(t)\n311|\t\t\treq := validRequest(t, root)\n312|\t\t\tspy := &spawnSpy{}\n313|\t\t\treq.SocketOverride = override\n314|\t\t\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n315|\t\t\t\treturn ServerReport{}, nil\n316|\t\t\t}\n317|\t\t\treq.Deps.Spawn = spy.spawn\n318|\t\t\t_, err := Acquire(req)\n319|\t\t\trequireLocalError(t, err, \"tmux_ambient_server_reuse\", \"socket override\")\n320|\t\t\tif spy.calls != 0 {\n321|\t\t\t\tt.Fatalf(\"spawn calls = %d, want 0 on ambient refusal\", spy.calls)\n322|\t\t\t}\n323|\t\t})\n324|\t}\n325|}\n326|\n327|func TestAcquireRefusesAmbientCollision(t *testing.T) {\n328|\troot := stateRoot(t)\n329|\tdir := socketDir(t, root)\n330|\treq := validRequest(t, root)\n331|\treq.Ambient = Ambient{DefaultPath: SocketPath(dir)}\n332|\tspy := &spawnSpy{}\n333|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n334|\t\treturn ServerReport{}, nil\n335|\t}\n336|\treq.Deps.Spawn = spy.spawn\n337|\t_, err := Acquire(req)\n338|\trequireLocalError(t, err, \"tmux_ambient_server_reuse\", \"ambient collision\")\n339|\tif spy.calls != 0 {\n340|\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n341|\t}\n342|}\n343|\n344|func TestAcquireRefusesUnknownCaller(t *testing.T) {\n345|\troot := stateRoot(t)\n346|\treq := validRequest(t, root)\n347|\treq.Caller = \"operator\"\n348|\t_, err := Acquire(req)\n349|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"caller\")\n350|}\n351|\n352|func TestAcquireRefusesMissingRealmDetails(t *testing.T) {\n353|\tbase := validRequest(t, stateRoot(t))\n354|\tfor _, tc := range []struct {\n355|\t\tname   string\n356|\t\tmutate func(*Request)\n357|\t}{\n358|\t\t{\"generation\", func(r *Request) { r.Generation = \"\" }},\n359|\t\t{\"broker state\", func(r *Request) { r.BrokerState = \"\" }},\n360|\t\t{\"remediation\", func(r *Request) { r.Remediation = \"\" }},\n361|\t} {\n362|\t\tt.Run(tc.name, func(t *testing.T) {\n363|\t\t\treq := base\n364|\t\t\ttc.mutate(&req)\n365|\t\t\t_, err := Acquire(req)\n366|\t\t\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"realm details\")\n367|\t\t})\n368|\t}\n369|}\n370|\n371|func TestAcquireRefusesMissingDependencies(t *testing.T) {\n372|\troot := stateRoot(t)\n373|\tforeground := validRequest(t, root)\n374|\t_, err := Acquire(foreground)\n375|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"dependencies\")\n376|\tbackground := validRequest(t, root)\n377|\tbackground.Caller = CallerBackground\n378|\t_, err = Acquire(background)\n379|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"dependencies\")\n380|}\n381|\n382|func TestAcquireCreatesRuntimeDirIdempotently(t *testing.T) {\n383|\troot := stateRoot(t)\n384|\tmake := func() Request {\n385|\t\treq := validRequest(t, root)\n386|\t\tspy := &spawnSpy{}\n387|\t\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n388|\t\t\treturn ServerReport{}, nil\n389|\t\t}\n390|\t\treq.Deps.Spawn = spy.spawn\n391|\t\treturn req\n392|\t}\n393|\tfirst, err := Acquire(make())\n394|\tif err != nil {\n395|\t\tt.Fatal(err)\n396|\t}\n397|\tsecond, err := Acquire(make())\n398|\tif err != nil {\n399|\t\tt.Fatal(err)\n400|\t}\n401|\tif first.Socket != second.Socket {\n402|\t\tt.Fatalf(\"sockets differ: %q vs %q\", first.Socket, second.Socket)\n403|\t}\n404|}\n405|\n406|func TestAcquireBackgroundNilBrokerWithSpawnRefuses(t *testing.T) {\n407|\troot := stateRoot(t)\n408|\treq := validRequest(t, root)\n409|\treq.Caller = CallerBackground\n410|\tspy := &spawnSpy{}\n411|\treq.Deps.Spawn = spy.spawn\n412|\t_, err := Acquire(req)\n413|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"dependencies\")\n414|\tif spy.calls != 0 {\n415|\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n416|\t}\n417|}\n418|\n419|func TestAcquireForegroundNilSpawnWithProbeRefuses(t *testing.T) {\n420|\troot := stateRoot(t)\n421|\treq := validRequest(t, root)\n422|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n423|\t\treturn ServerReport{}, nil\n424|\t}\n425|\t_, err := Acquire(req)\n426|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"dependencies\")\n427|}\n428|\n429|func TestCheckCreationAllowedRefusesBackground(t *testing.T) {\n430|\trequireLocalError(t, checkCreationAllowed(CallerBackground), \"tmux_background_creation_refused\", \"background creation\")\n431|\tif err := checkCreationAllowed(CallerForeground); err != nil {\n432|\t\tt.Fatalf(\"foreground creation refused: %v\", err)\n433|\t}\n434|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
