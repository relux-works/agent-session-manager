{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cf73","stream":{"kind":"session","id":"01a0c3b6-e69d-7952-b5c2-99ff4034d208"},"sequence":1556,"recorded_at":1780531400003107,"record_type":"event","durability":"durable","causation_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","run_stream":{"kind":"run","id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8"},"task_stream":{"kind":"task","id":"01a0c3c4-b8f0-7cc0-bc86-22f7a45de141"},"task_id":"01a0c3c4-b8f0-7cc0-bc86-22f7a45de141","event":{"kind":"output","task_id":"01a0c3c4-b8f0-7cc0-bc86-22f7a45de141","chunk":"edited\nchanged lines: lines 242-291\n--- original\n+++ updated\n@@\n-    Mutant(\n-        name=\"N-attestation-smoke\",\n-        path=f\"{PACKAGE}/readiness.go\",\n-        find=\"\\tif !live.SmokePassed {\\n\",\n-        replace=\"\\tif !live.SmokePassed && !live.SentinelPassed {\\n\",\n-        count=1,\n-        run=\"(TestCheckLiveAttestationRefusesEachMissingConjunct|TestAcquireBackgroundMissReturnsTypedUnavailable)\",\n-        expect=\"KILLED\",\n-        note=\"Admits exactly sentinel-only observations past the smoke arm; every other incomplete attestation still refuses.\",\n-    ),\n-    Mutant(\n-        name=\"N-attestation-sentinel\",\n-        path=f\"{PACKAGE}/readiness.go\",\n-        find=\"\\tif !live.SentinelPassed {\\n\",\n-        replace=\"\\tif !live.SentinelPassed && !live.SmokePassed {\\n\",\n-        count=1,\n-        run=\"TestCheckLiveAttestationRefusesEachMissingConjunct\",\n-        expect=\"KILLED\",\n-        note=\"Admits exactly smoke-only observations past the sentinel arm; every other incomplete attestation still refuses.\",\n-    ),\n-    Mutant(\n-        name=\"N-attestation-binding\",\n-        path=f\"{PACKAGE}/readiness.go\",\n-        find='\\tif live.ServerGeneration == \"\" || live.ProviderBuild == \"\" || live.MacOSVersion == \"\" {\\n',\n-        replace='\\tif live.ServerGeneration == \"\" || live.ProviderBuild == \"\" {\\n',\n-        count=1,\n-        run=\"TestCheckLiveAttestationRefusesEachMissingConjunct\",\n-        expect=\"KILLED\",\n-        note=\"Admits exactly macOS-unbound observations past the binding arm; generation- and build-unbound still refuse.\",\n-    ),\n-    Mutant(\n-        name=\"N-broker-auth\",\n-        path=f\"{PACKAGE}/readiness.go\",\n-        find=\"\\tif !status.Authenticated {\\n\",\n-        replace=\"\\tif !status.Authenticated && !status.Attested {\\n\",\n-        count=1,\n-        run=f\"(TestCheckBrokerContactRefusesEachMissingFact|{BG_MISS})\",\n-        expect=\"KILLED\",\n-        note=\"Admits exactly attested-but-unauthenticated brokers; every other broker report still refuses.\",\n-    ),\n-    Mutant(\n-        name=\"N-broker-attested\",\n-        path=f\"{PACKAGE}/readiness.go\",\n-        find=\"\\tif !status.Attested {\\n\",\n-        replace=\"\\tif !status.Attested && !status.Authenticated {\\n\",\n-        count=1,\n-        run=f\"(TestCheckBrokerContactRefusesEachMissingFact|{BG_MISS})\",\n-        expect=\"KILLED\",\n-        note=\"Admits exactly authenticated-but-unattested servers; every other broker report still refuses.\",\n-    ),\n+    Mutant(\n+        name=\"N-realm-membership\",\n+        path=f\"{PACKAGE}/readiness.go\",\n+        find=\"\\tif !admission.Admitted.Has(realmCapability) {\\n\",\n+        replace='\\tif !admission.Admitted.Has(realmCapability) && !admission.Admitted.Has(\"headless_creation\") {\\n',\n+        count=1,\n+        run=\"(TestCheckServerAttestedRefusesEachMissingConjunct|TestAcquireForegroundRefusesRunningUnattested)\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly decoy-capability admissions past the membership arm; every admission without the realm row still refuses. Kill path: the foreground entry attaches to a headless-only server.\",\n+    ),\n+    Mutant(\n+        name=\"N-realm-generation\",\n+        path=f\"{PACKAGE}/readiness.go\",\n+        find=\"\\tif wantGeneration == \\\"\\\" || admission.RawGeneration != wantGeneration {\\n\",\n+        replace='\\tif wantGeneration == \"\" || admission.RawGeneration != wantGeneration && admission.RawGeneration != \"generation-6\" {\\n',\n+        count=1,\n+        run=f\"(TestCheckServerAttestedRefusesEachMissingConjunct|TestAcquireForegroundRefusesWrongGenerationAdmission|{BG_MISS})\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly stale generation-6 admissions past the generation arm; every other unbound generation still refuses. Kill path: a replayed yesterday-proof attaches through both entries.\",\n+    ),\n+    Mutant(\n+        name=\"N-broker-uid\",\n+        path=f\"{PACKAGE}/readiness.go\",\n+        find=\"\\tif report.Principal.UID != currentUID {\\n\",\n+        replace=\"\\tif report.Principal.UID != currentUID && report.Principal.UID != currentUID()+100000 {\\n\",\n+        count=1,\n+        run=f\"(TestCheckBrokerContactRefusesEachMissingFact|{BG_MISS})\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the seam-shifted foreign UID past the same-user arm; every other foreign UID still refuses.\",\n+    ),\n+    Mutant(\n+        name=\"N-broker-generation\",\n+        path=f\"{PACKAGE}/readiness.go\",\n+        find='\\tif report.Principal.Generation == \"\" || report.Principal.Generation != wantGeneration {\\n',\n+        replace='\\tif report.Principal.Generation == \"\" || report.Principal.Generation != wantGeneration && report.Principal.Generation != \"generation-6\" {\\n',\n+        count=1,\n+        run=f\"(TestCheckBrokerContactRefusesEachMissingFact|TestAcquireBackgroundMissReturnsTypedUnavailable/generation-unbound_principal)\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly generation-6 broker principals past the principal-binding arm; every other unbound principal still refuses.\",\n+    ),\n","final_result":