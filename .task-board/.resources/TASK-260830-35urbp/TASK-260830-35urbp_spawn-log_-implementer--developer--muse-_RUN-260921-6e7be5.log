{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cd57","stream":{"kind":"session","id":"01a0c3b6-e69d-7952-b5c2-99ff4034d208"},"sequence":1286,"recorded_at":1780531400002567,"record_type":"event","durability":"durable","causation_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","run_stream":{"kind":"run","id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8"},"task_stream":{"kind":"task","id":"01a0c3c2-b240-7040-8157-d460b735964e"},"task_id":"01a0c3c2-b240-7040-8157-d460b735964e","event":{"kind":"output","task_id":"01a0c3c2-b240-7040-8157-d460b735964e","chunk":"edited\nchanged lines: lines 25-42\n--- original\n+++ updated\n@@\n-func TestBuildArgvRefusesAmbientSocket(t *testing.T) {\n-\tdir := runtimeDir(t, stateRoot(t))\n-\thostile := hostileAmbient()\n-\tfor _, tc := range []struct {\n-\t\tname   string\n-\t\tsocket string\n-\t}{\n-\t\t{\"default path\", hostile.DefaultPath},\n-\t\t{\"inherited socket\", hostile.InheritedSocket},\n-\t\t{\"conventional name\", hostile.ConventionalName},\n-\t\t{\"tmpdir\", hostile.TMUXTmpDir},\n-\t} {\n-\t\tt.Run(tc.name, func(t *testing.T) {\n-\t\t\t_, err := BuildArgv(dir, tc.socket, fixtureSession)\n-\t\t\trequireLocalError(t, err, \"tmux_ambient_server_reuse\", \"spawn socket\")\n-\t\t})\n-\t}\n-}\n+func TestBuildArgvRefusesAmbientSocket(t *testing.T) {\n+\tdir := runtimeDir(t, stateRoot(t))\n+\thostile := hostileAmbient()\n+\tfor _, tc := range []struct {\n+\t\tname   string\n+\t\tsocket string\n+\t}{\n+\t\t{\"tmux env value\", hostile.TMUXEnv},\n+\t\t{\"default path\", hostile.DefaultPath},\n+\t\t{\"inherited socket\", hostile.InheritedSocket},\n+\t\t{\"conventional name\", hostile.ConventionalName},\n+\t\t{\"tmpdir\", hostile.TMUXTmpDir},\n+\t} {\n+\t\tt.Run(tc.name, func(t *testing.T) {\n+\t\t\t_, err := BuildArgv(dir, tc.socket, fixtureSession)\n+\t\t\trequireLocalError(t, err, \"tm