=1,\n346|        run=\"TestAcquireForegroundNilSpawnWithProbeRefuses\",\n347|        expect=\"KILLED\",\n348|        note=\"Admits exactly the half-nil foreground dependencies past the arm; fully-nil dependencies still refuse. Kill path: the admitted request panics on the nil spawn, and the panic fails the test.\",\n349|    ),\n350|    Mutant(\n351|        name=\"D-background-fallback\",\n352|        path=f\"{PACKAGE}/acquire.go\",\n353|        find=\"\\t\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\n\\t\\t\\treturn Outcome{}, backgroundUnavailable(req, err)\\n\\t\\t}\\n\",\n354|        replace=\"\\t\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\n\\t\\t\\tif req.Deps.Spawn != nil {\\n\\t\\t\\t\\t_ = req.Deps.Spawn(socket, nil)\\n\\t\\t\\t}\\n\\t\\t\\treturn Outcome{}, backgroundUnavailable(req, err)\\n\\t\\t}\\n\",\n355|        count=1,\n356|        run=BG_MISS,\n357|        expect=\"KILLED\",\n358|        note=\"SUPPLEMENTARY ADDITIVE, not a narrowing: plants the reviewer-shaped direct-creation call on the background miss path. Kill path: every background-miss spy asserts zero spawn calls.\",\n359|    ),\n360|    Mutant(\n361|        name=\"C-control\",\n362|        path=f\"{PACKAGE}/errors.go\",\n363|        find=\"// Error is a package-local refusal. Code is one of the Code*\",\n364|        replace=\"// Error is a package-local refusal (harness control: comment-only). Code is one of the Code*\",\n365|        count=1,\n366|        run=\"TestSocketPathDerivesOnlyFromRuntimeDir\",\n367|        expect=\"SURVIVED\",\n368|        note=\"Harmless control: a comment-only edit that must SURVIVE, proving the harness observes outcomes.\",\n369|    ),\n370|]\n371|\n372|\n373|def apply(mutant: Mutant, original: str) -> str:\n374|    return original.replace(mutant.find, mutant.replace)\n375|\n376|\n377|def run_mutant(mutant: Mutant, log_dir: Path | None) -> str:\n378|    target = REPO / mutant.path\n379|    original = target.read_text()\n380|    found = original.count(mutant.find)\n381|    if found != mutant.count:\n382|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\"\n383|    with tempfile.TemporaryDirectory() as staging:\n384|        backup = Path(staging) / \"backup\"\n385|        shutil.copy2(target, backup)\n386|        try:\n387|            target.write_text(apply(mutant, original))\n388|            run = subprocess.run(\n389|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n390|                cwd=REPO,\n391|                capture_output=True,\n392|                text=True,\n393|                timeout=300,\n394|            )\n395|        finally:\n396|            shutil.copy2(backup, target)\n397|    output = (run.stdout + run.stderr).strip()\n398|    if os.environ.get(\"AX_MUTANT_VERBOSE\") == \"1\":\n399|        print(f\"--- raw: {mutant.name}: exit {run.returncode} ---\", flush=True)\n400|        print(output, flush=True)\n401|        print(f\"--- end raw: {mutant.name} ---\", flush=True)\n402|    if log_dir is not None:\n403|        (log_dir / f\"{mutant.name}.log\").write_text(\n404|            f\"exit: {run.returncode}\\nrun: go test ./{PACKAGE}/ -run {mutant.run} -count=1\\n\\n{output}\\n\"\n405|        )\n406|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n407|        return f\"ERROR: {mutant.name}: build broke under the patch\"\n408|    if run.returncode == 0:\n409|        verdict = \"SURVIVED\"\n410|    elif '--- FAIL' in output or 'FAIL:' in output:\n411|        verdict = \"KILLED\"\n412|    else:\n413|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\"\n414|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n415|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note} [exit {run.returncode}]\"\n416|\n417|\n418|def main(argv: list[str]) -> int:\n419|    log_dir: Path | None = None\n420|    names = list(argv)\n421|    if \"--log-dir\" in names:\n422|        idx = names.index(\"--log-dir\")\n423|        if idx + 1 >= len(names):\n424|            print(\"--log-dir needs a directory\")\n425|            return 2\n426|        log_dir = Path(names[idx + 1])\n427|        log_dir.mkdir(parents=True, exist_ok=True)\n428|        del names[idx : idx + 2]\n429|    selected = [m for m in MUTANTS if not names or m.name in names]\n430|    if names and len(selected) != len(names):\n431|        unknown = sorted(set(names) - {m.name for m in selected})\n432|        print(f\"unknown mutants: {', '.join(unknown)}\")\n433|        return 2\n434|    failures = 0\n435|    for mutant in selected:\n436|        try:\n437|            line = run_mutant(mutant, log_dir)\n438|        except subprocess.TimeoutExpired:\n439|            line = f\"ERROR: {mutant.name}: killer timed out\"\n440|        print(line, flush=True)\n441|        if not line.startswith(\"ok:\"):\n442|            failures += 1\n443|    return 1 if failures else 0\n444|\n445|\n446|if __name__ == \"__main__\":\n447|    sys.exit(main(sys.argv[1:]))","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
