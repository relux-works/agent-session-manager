*testing.T) {\n42|\tdir := runtimeDir(t, stateRoot(t))\n43|\tsocket, err := ResolveSocket(dir, \"\", hostileAmbient())\n44|\tif err != nil {\n45|\t\tt.Fatal(err)\n46|\t}\n47|\tif socket != SocketPath(dir) {\n48|\t\tt.Fatalf(\"socket = %q\", socket)\n49|\t}\n50|\tfor _, ambient := range []string{\n51|\t\thostileAmbient().TMUXEnv,\n52|\t\thostileAmbient().TMUXTmpDir,\n53|\t\thostileAmbient().InheritedSocket,\n54|\t\thostileAmbient().DefaultPath,\n55|\t\thostileAmbient().ConventionalName,\n56|\t} {\n57|\t\tif strings.Contains(socket, ambient) || socket == ambient {\n58|\t\t\tt.Fatalf(\"socket %q reuses ambient %q\", socket, ambient)\n59|\t\t}\n60|\t}\n61|}\n62|\n63|func TestResolveSocketRefusesEveryOverrideVector(t *testing.T) {\n64|\tdir := runtimeDir(t, stateRoot(t))\n65|\thostile := hostileAmbient()\n66|\tvectors := map[string]string{\n67|\t\t\"environment variable\": hostile.TMUXEnv,\n68|\t\t\"inherited socket\":     hostile.InheritedSocket,\n69|\t\t\"default path\":         hostile.DefaultPath,\n70|\t\t\"conventional name\":    hostile.ConventionalName,\n71|\t}\n72|\tfor name, override := range vectors {\n73|\t\tt.Run(name, func(t *testing.T) {\n74|\t\t\t_, err := ResolveSocket(dir, override, Ambient{})\n75|\t\t\trequireLocalError(t, err, \"tmux_ambient_server_reuse\", \"socket override\")\n76|\t\t})\n77|\t}\n78|}\n79|\n80|func TestResolveSocketRefusesAmbientCollision(t *testing.T) {\n81|\tdir := runtimeDir(t, stateRoot(t))\n82|\tderived := SocketPath(dir)\n83|\t_, err := ResolveSocket(dir, \"\", Ambient{DefaultPath: derived})\n84|\trequireLocalError(t, err, \"tmux_ambient_server_reuse\", \"ambient collision\")\n85|}","final_result":true}}}
