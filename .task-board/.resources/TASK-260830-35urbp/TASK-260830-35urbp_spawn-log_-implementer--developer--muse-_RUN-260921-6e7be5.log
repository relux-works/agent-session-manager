{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c935","stream":{"kind":"session","id":"01a0c3b6-e69d-7952-b5c2-99ff4034d208"},"sequence":757,"recorded_at":1780531400001509,"record_type":"event","durability":"durable","causation_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","run_stream":{"kind":"run","id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8"},"call_id":"call_01a0c3bad1927555a2b8f4a1474d87dd","text":"Read text file `internal/tmuxserver/runtime_test.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"os\"\n5|\t\"path/filepath\"\n6|\t\"testing\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|func TestEnsureRuntimeDirCreatesOwnerOnly(t *testing.T) {\n12|\troot := stateRoot(t)\n13|\tdir, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n14|\tif err != nil {\n15|\t\tt.Fatal(err)\n16|\t}\n17|\tif dir != filepath.Join(root, RuntimeDirName) {\n18|\t\tt.Fatalf(\"dir = %q\", dir)\n19|\t}\n20|\tinfo, err := os.Lstat(dir)\n21|\tif err != nil {\n22|\t\tt.Fatal(err)\n23|\t}\n24|\tif !info.IsDir() || info.Mode().Perm() != 0o700 {\n25|\t\tt.Fatalf(\"mode = %04o dir=%v, want 0700 dir\", info.Mode().Perm(), info.IsDir())\n26|\t}\n27|}\n28|\n29|func TestEnsureRuntimeDirIsIdempotent(t *testing.T) {\n30|\troot := stateRoot(t)\n31|\tfirst, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n32|\tif err != nil {\n33|\t\tt.Fatal(err)\n34|\t}\n35|\tsecond, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n36|\tif err != nil {\n37|\t\tt.Fatal(err)\n38|\t}\n39|\tif first != second {\n40|\t\tt.Fatalf(\"second = %q, want %q\", second, first)\n41|\t}\n42|\tinfo, err := os.Lstat(second)\n43|\tif err != nil {\n44|\t\tt.Fatal(err)\n45|\t}\n46|\tif info.Mode().Perm() != 0o700 {\n47|\t\tt.Fatalf(\"mode after re-ensure = %04o, want 0700\", info.Mode().Perm())\n48|\t}\n49|}\n50|\n51|func TestVerifyRuntimeDirAdmitsCompliant(t *testing.T) {\n52|\troot := stateRoot(t)\n53|\truntimeDir(t, root)\n54|\tif err := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS); err != nil {\n55|\t\tt.Fatal(err)\n56|\t}\n57|}\n58|\n59|func TestEnsureRuntimeDirRefusesWidenedMode(t *testing.T) {\n60|\troot := stateRoot(t)\n61|\tdir, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n62|\tif err != nil {\n63|\t\tt.Fatal(err)\n64|\t}\n65|\t// The suite widens the mode behind the entry's back; re-entry\n66|\t// must refuse, never silently repair.\n67|\tif err := os.Chmod(dir, 0o755); err != nil {\n68|\t\tt.Fatal(err)\n69|\t}\n70|\t_, err = EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n71|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime mode\")\n72|\tif err := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS); err != nil {\n73|\t\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime mode\")\n74|\t} else {\n75|\t\tt.Fatal(\"VerifyRuntimeDir admitted a 0755 directory\")\n76|\t}\n77|}\n78|\n79|func TestEnsureRuntimeDirRefusesNonDirectoryLeaf(t *testing.T) {\n80|\troot := stateRoot(t)\n81|\tleaf := filepath.Join(root, RuntimeDirName)\n82|\tif err := os.WriteFile(leaf, []byte(\"x\"), 0o600); err != nil {\n83|\t\tt.Fatal(err)\n84|\t}\n85|\t_, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n86|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n87|}\n88|\n89|func TestEnsureRuntimeDirRefusesSymlinkLeaf(t *testing.T) {\n90|\troot := stateRoot(t)\n91|\tescape := t.TempDir()\n92|\tleaf := filepath.Join(root, RuntimeDirName)\n93|\tif err := os.Symlink(escape, leaf); err != nil {\n94|\t\tt.Fatal(err)\n95|\t}\n96|\t_, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n97|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n98|}\n99|\n100|func TestEnsureRuntimeDirRefusesForeignOwnership(t *testing.T) {\n101|\troot := stateRoot(t)\n102|\truntimeDir(t, root)\n103|\tprevious := effectiveUID\n104|\teffectiveUID = func() int { return previous() + 100000 }\n105|\tdefer func() { effectiveUID = previous }()\n106|\t_, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n107|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime ownership\")\n108|\tif err := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS); err != nil {\n109|\t\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime ownership\")\n110|\t} else {\n111|\t\tt.Fatal(\"VerifyRuntimeDir admitted foreign ownership\")\n112|\t}\n113|}\n114|\n115|func TestEnsureRuntimeDirRefusesHandleMismatch(t *testing.T) {\n116|\troot := stateRoot(t)\n117|\tprevious := sameDirectory\n118|\tsameDirectory = func(_, _ os.FileInfo) bool { return false }\n119|\tdefer func() { sameDirectory = previous }()\n120|\t_, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n121|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n122|}\n123|\n124|func TestEnsureRuntimeDirRefusesSymlinkRoot(t *testing.T) {\n125|\treal := stateRoot(t)\n126|\tlink := filepath.Join(t.TempDir(), \"linkroot\")\n127|\tif err := os.Symlink(real, link); err != nil {\n128|\t\tt.Fatal(err)\n129|\t}\n130|\t_, err := EnsureRuntimeDir(link, RuntimeDirName, scalar.PlatformMacOS, nil)\n131|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n132|}\n133|\n134|func TestEnsureRuntimeDirRefusesBadRoots(t *testing.T) {\n135|\troot := stateRoot(t)\n136|\tfor _, tc := range []struct {\n137|\t\tname string\n138|\t\troot string\n139|\t}{\n140|\t\t{\"relative\", \"relative/root\"},\n141|\t\t{\"empty\", \"\"},\n142|\t\t{\"parent\", \"/tmp/../etc\"},\n143|\t\t{\"missing\", filepath.Join(root, \"no-such-root\")},\n144|\t} {\n145|\t\tt.Run(tc.name, func(t *testing.T) {\n146|\t\t\t_, err := EnsureRuntimeDir(tc.root, RuntimeDirName, scalar.PlatformMacOS, nil)\n147|\t\t\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"runtime root\")\n148|\t\t})\n149|\t}\n150|}\n151|\n152|func TestEnsureRuntimeDirRefusesBadNames(t *testing.T) {\n153|\troot := stateRoot(t)\n154|\tfor _, tc := range []struct {\n155|\t\tname  string\n156|\t\tvalue string\n157|\t}{\n158|\t\t{\"empty\", \"\"},\n159|\t\t{\"dot\", \".\"},\n160|\t\t{\"parent\", \"..\"},\n161|\t\t{\"nested\", \"a/b\"},\n162|\t\t{\"absolute\", \"/abs\"},\n163|\t\t{\"nul\", \"a\\x00b\"},\n164|\t} {\n165|\t\tt.Run(tc.name, func(t *testing.T) {\n166|\t\t\t_, err := EnsureRuntimeDir(root, tc.value, scalar.PlatformMacOS, nil)\n167|\t\t\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"runtime name\")\n168|\t\t})\n169|\t}\n170|}\n171|\n172|func TestEnsureRuntimeDirRefusesBadPlatform(t *testing.T) {\n173|\troot := stateRoot(t)\n174|\t_, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.Platform(\"plan9\"), nil)\n175|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"runtime platform\")\n176|}\n177|\n178|func TestEnsureRuntimeDirRefusesWindowsOnUnixHost(t *testing.T) {\n179|\t_, err := EnsureRuntimeDir(`C:\\ax-state`, RuntimeDirName, scalar.PlatformWindows, nil)\n180|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"runtime platform host\")\n181|}\n182|\n183|func TestVerifyRuntimeDirRefusesAbsence(t *testing.T) {\n184|\troot := stateRoot(t)\n185|\terr := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS)\n186|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n187|}\n188|\n189|func TestLinuxAndWSL2ShareUnixCustody(t *testing.T) {\n190|\tfor _, platform := range []scalar.Platform{scalar.PlatformLinux, scalar.PlatformWSL2} {\n191|\t\troot := stateRoot(t)\n192|\t\tdir, err := EnsureRuntimeDir(root, RuntimeDirName, platform, nil)\n193|\t\tif err != nil {\n194|\t\t\tt.Fatalf(\"%s: %v\", platform, err)\n195|\t\t}\n196|\t\tinfo, err := os.Lstat(dir)\n197|\t\tif err != nil {\n198|\t\t\tt.Fatal(err)\n199|\t\t}\n200|\t\tif info.Mode().Perm() != 0o700 {\n201|\t\t\tt.Fatalf(\"%s: mode = %04o\", platform, info.Mode().Perm())\n202|\t\t}\n203|\t}\n204|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c937","stream":{"kind":"session","id":"01a0c3b6-e69d-7952-b5c2-99ff4034d208"},"sequence":758,"recorded_at":1780531400001511,"record_type":"event","durability":"durable","causation_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","run_stream":{"kind":"run","id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8"},"call_id":"call_01a0c3bad3b677e3b79c3f7ad1ecc5a1","text":"Read text file `internal/tmuxserver/crash_unix_test.go`.\n1|//go:build darwin || linux\n2|\n3|package tmuxserver\n4|\n5|import (\n6|\t\"context\"\n7|\t\"errors\"\n8|\t\"os\"\n9|\t\"os/exec\"\n10|\t\"syscall\"\n11|\t\"testing\"\n12|\t\"time\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|)\n16|\n17|// Real process-termination evidence for the runtime-directory seam.\n18|// The child runs the genuine production EnsureRuntimeDir entry and\n19|// SIGKILLs itself in the AfterMkdir hook, after the mkdirat commit\n20|// and before verification and the parent fsync. The parent proves\n21|// the interrupted run left no half-custody behind: the retry\n22|// converges to the one verified owner-only directory.\n23|const (\n24|\tcrashChildMode = \"AX_TMUXSERVER_CRASH_MODE\"\n25|\tcrashChildRoot = \"AX_TMUXSERVER_CRASH_ROOT\"\n26|)\n27|\n28|func TestEnsureCrashChildSelfTerminates(t *testing.T) {\n29|\tif os.Getenv(crashChildMode) == \"ensure\" {\n30|\t\tensureCrashChild(t)\n31|\t\treturn\n32|\t}\n33|\troot := stateRoot(t)\n34|\tctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)\n35|\tdefer cancel()\n36|\tchild := exec.CommandContext(ctx, os.Args[0],\n37|\t\t\"-test.run=^TestEnsureCrashChildSelfTerminates$\",\n38|\t\t\"-test.count=1\",\n39|\t)\n40|\tchild.Env = append(os.Environ(),\n41|\t\tcrashChildMode+\"=ensure\",\n42|\t\tcrashChildRoot+\"=\"+root,\n43|\t)\n44|\trunErr := child.Run()\n45|\tvar exitErr *exec.ExitError\n46|\tif !errors.As(runErr, &exitErr) {\n47|\t\tt.Fatalf(\"child run = %v, want a signal-kill exit\", runErr)\n48|\t}\n49|\tstatus, ok := exitErr.Sys().(syscall.WaitStatus)\n50|\tif !ok || !status.Signaled() || status.Signal() != syscall.SIGKILL {\n51|\t\tt.Fatalf(\"child status = %v, want killed by SIGKILL\", exitErr)\n52|\t}\n53|\tdir, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n54|\tif err != nil {\n55|\t\tt.Fatalf(\"EnsureRuntimeDir() retry after kill error = %v\", err)\n56|\t}\n57|\tinfo, err := os.Lstat(dir)\n58|\tif err != nil {\n59|\t\tt.Fatal(err)\n60|\t}\n61|\tif !info.IsDir() || info.Mode().Perm() != 0o700 {\n62|\t\tt.Fatalf(\"dir after kill = %04o dir=%v, want 0700 dir\", info.Mode().Perm(), info.IsDir())\n63|\t}\n64|\tif err := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS); err != nil {\n65|\t\tt.Fatalf(\"VerifyRuntimeDir() after kill error = %v\", err)\n66|\t}\n67|\tagain, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n68|\tif err != nil {\n69|\t\tt.Fatal(err)\n70|\t}\n71|\tif again != dir {\n72|\t\tt.Fatalf(\"second retry = %q, want %q\", again, dir)\n73|\t}\n74|}\n75|\n76|func ensureCrashChild(t *testing.T) {\n77|\tt.Helper()\n78|\troot := os.Getenv(crashChildRoot)\n79|\thooks := &Hooks{AfterMkdir: func(dir string) {\n80|\t\t_ = syscall.Kill(syscall.Getpid(), syscall.SIGKILL)\n81|\t}}\n82|\t_, _ = EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, hooks)\n83|\t// If the hook failed to kill, fail loudly so the parent never\n84|\t// mistakes a clean exit for a kill.\n85|\tt.Fatal(\"crash child survived its kill hook\")\n86|}\n87|\n88|func TestAcquireForegroundSpawnIsIdempotentAcrossRetry(t *testing.T) {\n89|\troot := stateRoot(t)\n90|\tspawned := false\n91|\tspawns := 0\n92|\tmake := func() Request {\n93|\t\treq := validRequest(t, root)\n94|\t\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n95|\t\t\tif spawned {\n96|\t\t\t\treturn ServerReport{Running: true, Attestation: liveAttestation()}, nil\n97|\t\t\t}\n98|\t\t\treturn ServerReport{}, nil\n99|\t\t}\n100|\t\treq.Deps.Spawn = func(socket string, argv []string) error {\n101|\t\t\tspawns++\n102|\t\t\tspawned = true\n103|\t\t\treturn nil\n104|\t\t}\n105|\t\treturn req\n106|\t}\n107|\tfirst, err := Acquire(make())\n108|\tif err != nil {\n109|\t\tt.Fatal(err)\n110|\t}\n111|\tif first.Via != \"spawned\" {\n112|\t\tt.Fatalf(\"first via = %q\", first.Via)\n113|\t}\n114|\tsecond, err := Acquire(make())\n115|\tif err != nil {\n116|\t\tt.Fatal(err)\n117|\t}\n118|\tif second.Via != \"attached-running\" {\n119|\t\tt.Fatalf(\"second via = %q, want attached-running\", second.Via)\n120|\t}\n121|\tif second.Socket != first.Socket {\n122|\t\tt.Fatalf(\"sockets differ: %q vs %q\", second.Socket, first.Socket)\n123|\t}\n124|\tif spawns != 1 {\n125|\t\tt.Fatalf(\"spawns = %d, want exactly 1\", spawns)\n126|\t}\n127|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
