{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c625","stream":{"kind":"session","id":"01a0c3b6-e69d-7952-b5c2-99ff4034d208"},"sequence":365,"recorded_at":1780531400000725,"record_type":"event","durability":"durable","causation_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","run_stream":{"kind":"run","id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8"},"task_stream":{"kind":"task","id":"01a0c3b7-f7e6-70e2-b69d-19e6566a8e2e"},"task_id":"01a0c3b7-f7e6-70e2-b69d-19e6566a8e2e","event":{"kind":"output","task_id":"01a0c3b7-f7e6-70e2-b69d-19e6566a8e2e","chunk":"Read text file `internal/tmuxserver/readiness.go`.\n1|package tmuxserver\n2|\n3|// ManagerNameHint documents the launchctl managername observation:\n4|// a diagnostic hint only. The value travels on the request for\n5|// operator diagnostics and no gate reads it. Any test that sets a\n6|// hint and varies only live attestation proves the hint carries no\n7|// authority.\n8|type ManagerNameHint struct {\n9|\t// Value is the observed manager name, for example \"Aqua\".\n10|\t// Empty means no observation was made.\n11|\tValue string\n12|}\n13|\n14|// CachedObservation is a previously recorded sentinel or managername\n15|// result. It is a distinct type that no authorizing entry accepts:\n16|// CheckLiveAttestation takes LiveAttestation only, so a cached\n17|// value cannot be passed where live proof is required even by\n18|// accident. Its only use is negative tests proving it authorizes\n19|// nothing.\n20|type CachedObservation struct {\n21|\tSentinelPassed bool\n22|\tManagerName    string\n23|}\n24|\n25|// LiveAttestation is one live functional-sentinel plus\n26|// provider-auth-smoke observation inside the exact tmux server. Every\n27|// member is required: Aqua alone and sentinel-only evidence are\n28|// insufficient, and the binding members tie the observation to the\n29|// exact server generation, provider build, and macOS version.\n30|type LiveAttestation struct {\n31|\tSentinelPassed   bool\n32|\tSmokePassed      bool\n33|\tServerGeneration string\n34|\tProviderBuild    string\n35|\tMacOSVersion     string\n36|}\n37|\n38|// CheckLiveAttestation admits exactly one complete live observation:\n39|// a passed sentinel AND a passed provider-auth smoke AND the full\n40|// generation/build/version binding. Each conjunct refuses alone with\n41|// the non-authorizing code, so weakening any one arm admits a\n42|// sentinel-only, smoke-only, or unbound observation the committed\n43|// tests pin. A cached observation is not a LiveAttestation and has\n44|// no conversion: the type boundary, not a boolean, keeps the cache\n45|// off the authorizing path.\n46|func CheckLiveAttestation(live LiveAttestation) error {\n47|\tif !live.SentinelPassed {\n48|\t\treturn &Error{Code: CodeReadinessNotAuthorizing, Detail: \"sentinel result\"}\n49|\t}\n50|\tif !live.SmokePassed {\n51|\t\treturn &Error{Code: CodeReadinessNotAuthorizing, Detail: \"provider smoke result\"}\n52|\t}\n53|\tif live.ServerGeneration == \"\" || live.ProviderBuild == \"\" || live.MacOSVersion == \"\" {\n54|\t\treturn &Error{Code: CodeReadinessNotAuthorizing, Detail: \"attestation binding\"}\n55|\t}\n56|\treturn nil\n57|}\n58|\n59|// BrokerStatus is the live Aqua broker report the background path\n60|// decides over. Authenticated names an already-running authenticated\n61|// broker; Attested names its attested AX tmux server with a live\n62|// attestation. Either fact missing means neither exists for the\n63|// purpose of the broker-or-refuse rule.\n64|type BrokerStatus struct {\n65|\tAuthenticated bool\n66|\tAttested      bool\n67|\tAttestation   LiveAttestation\n68|}\n69|\n70|// CheckBrokerContact admits exactly the background MAY case: an\n71|// already-running authenticated broker AND its attested AX tmux\n72|// server with a complete live attestation. Every other report —\n73|// no broker, unauthenticated broker, unattested server, incomplete\n74|// attestation — refuses, and the caller maps the refusal to the\n75|// typed capability_unavailable the spec names.\n76|func CheckBrokerContact(status BrokerStatus) error {\n77|\tif !status.Authenticated {\n78|\t\treturn &Error{Code: CodeReadinessNotAuthorizing, Detail: \"broker authentication\"}\n79|\t}\n80|\tif !status.Attested {\n81|\t\treturn &Error{Code: CodeReadinessNotAuthorizing, Detail: \"server attestation\"}\n82|\t}\n83|\treturn CheckLiveAttestation(status.Attestation)\n84|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c627","stream":{"kind":"session","id":"01a0c3b6-e69d-7952-b5c2-99ff4034d208"},"sequence":366,"recorded_at":1780531400000727,"record_type":"event","durability":"durable","causation_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","run_stream":{"kind":"run","id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8"},"task_stream":{"kind":"task","id":"01a0c3b7-f7e6-70e2-b69d-19e6566a8e2e"},"task_id":"01a0c3b7-f7e6-70e2-b69d-19e6566a8e2e","event":{"kind":"completed","task_id":"01a0c3b7-f7e6-70e2-b69d-19e6566a8e2e"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c629","stream":{"kind":"session","id":"01a0c3b6-e69d-7952-b5c2-99ff4034d208"},"sequence":367,"recorded_at":1780531400000729,"record_type":"event","durability":"durable","causation_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","run_stream":{"kind":"run","id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8"},"call_id":"call_01a0c3b7eaf275f09efad5beae1de8a0","text":"Read text file `internal/tmuxserver/acquire.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n5|\t\"github.com/relux-works/agent-session-manager/internal/axpane\"\n6|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n7|)\n8|\n9|// Caller names the acquisition caller. The vocabulary is owned by\n10|// internal/axpane, which already gates the wrapper decision over it;\n11|// this package reuses its constants rather than retyping them.\n12|type Caller = string\n13|\n14|const (\n15|\t// CallerForeground is an interactive operator-side caller that\n16|\t// may create the dedicated server.\n17|\tCallerForeground = axpane.CallerForeground\n18|\t// CallerBackground is a background CLI, SSH RPC process,\n19|\t// daemon, or restore worker: it must never create a\n20|\t// credential-dependent tmux server, may contact an\n21|\t// already-running authenticated broker, and otherwise receives\n22|\t// capability_unavailable with no fallback to direct creation.\n23|\tCallerBackground = axpane.CallerBackground\n24|)\n25|\n26|// Acquisition outcomes name how the caller reached the dedicated\n27|// server. Exactly one applies; there is no combined or fallback\n28|// outcome.\n29|const (\n30|\t// ViaSpawned created the dedicated -S server on the foreground\n31|\t// path and returns its spawn argv.\n32|\tViaSpawned = \"spawned\"\n33|\t// ViaAttachedFound the dedicated server already running and\n34|\t// attested on the foreground path.\n35|\tViaAttached = \"attached-running\"\n36|\t// ViaBroker contacted the already-running authenticated Aqua\n37|\t// broker and its attested AX tmux server on the background\n38|\t// path. No local spawn argv exists on this path.\n39|\tViaBroker = \"broker\"\n40|)\n41|\n42|// realmCapability is the Section 4.D capability the background\n43|// typed refusal names: the exact instance passes the AX sentinel\n44|// and the provider-auth smoke without UI.\n45|const realmCapability = \"credential_capable_execution_realm\"\n46|\n47|// ServerReport is the live dedicated-server probe result: whether\n48|// the private socket answers, with the live attestation observed\n49|// inside the exact server when it does.\n50|type ServerReport struct {\n51|\tRunning     bool\n52|\tAttestation LiveAttestation\n53|}\n54|\n55|// Dependencies carries every external interaction acquisition\n56|// performs. Production wires live tmux and broker probes; tests\n57|// wire fakes. No probe runs without its dependency: a nil entry\n58|// refuses instead of reaching for a default.\n59|type Dependencies struct {\n60|\t// ProbeServer reports the dedicated socket's live state.\n61|\tProbeServer func(socket string) (ServerReport, error)\n62|\t// ProbeBroker reports the live Aqua broker state.\n63|\tProbeBroker func() (BrokerStatus, error)\n64|\t// Spawn creates the dedicated server with the given -S argv.\n65|\tSpawn func(socket string, argv []string) error\n66|}\n67|\n68|// Request is the complete acquisition surface.\n69|type Request struct {\n70|\tCaller   Caller\n71|\tPlatform scalar.Platform\n72|\t// Root and Name select the runtime directory: Root is the AX\n73|\t// state root, Name is the runtime leaf (usually\n74|\t// RuntimeDirName). The directory is ensured idempotently;\n75|\t// ensuring a directory is not creating a server.\n76|\tRoot string\n77|\tName string\n78|\t// Ambient carries the observed ambient socket facts for\n79|\t// evidence. Resolution never reads them; tests assert the\n80|\t// acquired socket equals none of them.\n81|\tAmbient Ambient\n82|\t// SocketOverride must be empty. Any caller-supplied socket —\n83|\t// whichever ambient vector supplied it — refuses.\n84|\tSocketOverride string\n85|\t// SessionID is the logical session the spawned server will\n86|\t// host, as canonical UUIDv7. It shapes spawn argv only.\n87|\tSessionID string\n88|\t// NeedsCredentials marks a credential-dependent server on\n89|\t// macOS, where server creation is credential-sensitive.\n90|\tNeedsCredentials bool\n91|\t// Generation, BrokerState, and Remediation are the typed\n92|\t// realm/readiness details the capability_unavailable refusal\n93|\t// carries. All three are required: an input that omits one\n94|\t// is malformed and refuses invalid_arguments instead of\n95|\t// emitting an untyped refusal.\n96|\tGeneration  string\n97|\tBrokerState string\n98|\tRemediation string\n99|\t// Hint is the launchctl managername diagnostic observation.\n100|\t// It travels for operator diagnostics and no gate reads it.\n101|\tHint ManagerNameHint\n102|\t// Cached is a prior sentinel or managername observation. It\n103|\t// is accepted only so tests can prove it authorizes nothing;\n104|\t// no gate reads it.\n105|\tCached *CachedObservation\n106|\tDeps   Dependencies\n107|}\n108|\n109|// Outcome is the one acquisition result.\n110|type Outcome struct {\n111|\tVia    string\n112|\tSocket string\n113|\t// Argv is the dedicated -S spawn argv. It is set only for\n114|\t// ViaSpawned: the broker path spawns nothing and the\n115|\t// attached path presents through sibling-owned attach\n116|\t// semantics, not through a second spawn vector.\n117|\tArgv []string\n118|}\n119|\n120|// Acquire resolves the dedicated server socket from the runtime\n121|// directory and reaches the server through the caller-appropriate\n122|// path. Foreground attaches to the running attested server or\n123|// spawns the dedicated -S server; background contacts the\n124|// already-running authenticated broker or receives the typed\n125|// capability_unavailable refusal, and never falls back to direct\n126|// server creation — there is no spawn call on the background path,\n127|// and every background test arms a spy spawner that fails the run\n128|// if it is ever invoked.\n129|func Acquire(req Request) (Outcome, error) {\n130|\tif req.Caller != CallerForeground && req.Caller != CallerBackground {\n131|\t\treturn Outcome{}, &Error{Code: CodeInvalidArguments, Detail: \"caller\"}\n132|\t}\n133|\tif req.Generation == \"\" || req.BrokerState == \"\" || req.Remediation == \"\" {\n134|\t\treturn Outcome{}, &Error{Code: CodeInvalidArguments, Detail: \"realm details\"}\n135|\t}\n136|\tdir, err := EnsureRuntimeDir(req.Root, req.Name, req.Platform, nil)\n137|\tif err != nil {\n138|\t\treturn Outcome{}, err\n139|\t}\n140|\tsocket, err := ResolveSocket(dir, req.SocketOverride, req.Ambient)\n141|\tif err != nil {\n142|\t\treturn Outcome{}, err\n143|\t}\n144|\tif req.Caller == CallerBackground {\n145|\t\treturn acquireBackground(req, socket)\n146|\t}\n147|\treturn acquireForeground(req, dir, socket)\n148|}\n149|\n150|// acquireBackground implements the broker-or-refuse rule: it may\n151|// contact the already-running authenticated broker and its attested\n152|// server, and when neither exists it returns capability_unavailable\n153|// with typed realm/readiness details. Direct server creation is not\n154|// the else branch — this function has no path to the spawner, on\n155|// any platform, with or without credentials.\n156|func acquireBackground(req Request, socket string) (Outcome, error) {\n157|\tif req.Deps.ProbeBroker == nil {\n158|\t\treturn Outcome{}, &Error{Code: CodeInvalidArguments, Detail: \"dependencies\"}\n159|\t}\n160|\tstatus, err := req.Deps.ProbeBroker()\n161|\tif err != nil {\n162|\t\treturn Outcome{}, err\n163|\t}\n164|\tif err := CheckBrokerContact(status); err != nil {\n165|\t\t// The miss path creates nothing: it consults the creation\n166|\t\t// gate so the no-fallback rule is enforced by a call, not\n167|\t\t// by the absence of one. The gate refuses every background\n168|\t\t// caller; its refusal is expected here and the path reports\n169|\t\t// the typed unavailable the spec names. The else branch is\n170|\t\t// reachable only when the gate is weakened to admit a\n171|\t\t// background caller, and then it refuses with the creation\n172|\t\t// code instead of the typed unavailable, so the committed\n173|\t\t// background-miss tests redden.\n174|\t\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\n175|\t\t\treturn Outcome{}, backgroundUnavailable(req, err)\n176|\t\t}\n177|\t\treturn Outcome{}, &Error{Code: CodeBackgroundCreationRefused, Detail: \"background fallback\"}\n178|\t}\n179|\treturn Outcome{Via: ViaBroker, Socket: socket}, nil\n180|}\n181|\n182|// acquireForeground attaches to the running attested dedicated\n183|// server or spawns it. A running but unattested server refuses:\n184|// acquisition never attaches to a server whose sentinel, smoke, or\n185|// binding is unproven, and never repairs it here — lifecycle owns\n186|// that decision.\n187|func acquireForeground(req Request, dir, socket string) (Outcome, error) {\n188|\tif req.Deps.ProbeServer == nil || req.Deps.Spawn == nil {\n189|\t\treturn Outcome{}, &Error{Code: CodeInvalidArguments, Detail: \"dependencies\"}\n190|\t}\n191|\treport, err := req.Deps.ProbeServer(socket)\n192|\tif err != nil {\n193|\t\treturn Outcome{}, err\n194|\t}\n195|\tif report.Running {\n196|\t\tif err := CheckLiveAttestation(report.Attestation); err != nil {\n197|\t\t\treturn Outcome{}, err\n198|\t\t}\n199|\t\treturn Outcome{Via: ViaAttached, Socket: socket}, nil\n200|\t}\n201|\tif err := checkCreationAllowed(req.Caller); err != nil {\n202|\t\treturn Outcome{}, err\n203|\t}\n204|\targv, err := BuildArgv(dir, socket, req.SessionID)\n205|\tif err != nil {\n206|\t\treturn Outcome{}, err\n207|\t}\n208|\tif err := req.Deps.Spawn(socket, argv); err != nil {\n209|\t\treturn Outcome{}, &Error{Code: CodeSpawnFailed, Detail: \"server spawn\"}\n210|\t}\n211|\treturn Outcome{Via: ViaSpawned, Socket: socket, Argv: argv}, nil\n212|}\n213|\n214|// checkCreationAllowed is the single choke point before every\n215|// direct server creation. A background caller never creates: on\n216|// macOS because server creation is credential-sensitive, and on\n217|// every platform because the background path must not fall back to\n218|// direct creation. The macOS credential-dependent case is one\n219|// fixture of this gate, not a narrower arm: narrowing the gate to\n220|// macOS or to credential-dependent servers would admit background\n221|// creation the no-fallback rule forbids. Foreground creation is\n222|// allowed on every platform; the credential binding it needs is\n223|// proven by the live attestation the server must present before\n224|// any attach.\n225|func checkCreationAllowed(caller Caller) error {\n226|\tif caller == CallerBackground {\n227|\t\treturn &Error{Code: CodeBackgroundCreationRefused, Detail: \"background creation\"}\n228|\t}\n229|\treturn nil\n230|}\n231|\n232|// backgroundUnavailable composes the typed capability_unavailable\n233|// refusal the spec names for the background miss, with the exact\n234|// Section 15.3 detail set. The constructor enforces the typed\n235|// details; a failure to render them is itself malformed input, not\n236|// an untyped refusal.\n237|func backgroundUnavailable(req Request, cause error) error {\n238|\tdetails := axerror.RealmEvidence{\n239|\t\tCapability:           realmCapability,\n240|\t\tCallerRealm:          req.Caller,\n241|\t\tBrokerState:          req.BrokerState,\n242|\t\tTmuxServerGeneration: req.Generation,\n243|\t\tRemediation:          req.Remediation,\n244|\t}\n245|\tfailure, err := axerror.NewRealmEvidenceUnavailable(axerror.Version130,\n246|\t\t\"no authenticated broker or attested tmux server\",\n247|\t\taxerror.NoIDs(), details, cause)\n248|\tif err != nil {\n249|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"realm details\"}\n250|\t}\n251|\treturn failure\n252|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c62b","stream":{"kind":"session","id":"01a0c3b6-e69d-7952-b5c2-99ff4034d208"},"sequence":368,"recorded_at":1780531400000731,"record_type":"event","durability":"durable","causation_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","run_stream":{"kind":"run","id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8"},"call_id":"call_01a0c3b7ecf97301bad6104192b1829a","text":"Read text file `internal/tmuxserver/socket.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"path/filepath\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n7|)\n8|\n9|// SocketName is the fixed private socket leaf inside the runtime\n10|// directory. AX derives its server socket from this name under the\n11|// owner-only directory and from nothing else.\n12|const SocketName = \"ax-tmux.sock\"\n13|\n14|// Ambient environment names the four discovery vectors AX must never\n15|// use. TMUXEnv and TMUXTmpDir name the two environment variables\n16|// whose values may carry an ambient socket; InheritedSocket is a\n17|// socket path handed to the process out of band; DefaultPath is the\n18|// operator default socket path; ConventionalName is the bare\n19|// conventional socket name. No member of this struct ever selects\n20|// the acquisition socket: ResolveSocket derives the socket from the\n21|// runtime directory and refuses any explicit override.\n22|type Ambient struct {\n23|\tTMUXEnv          string\n24|\tTMUXTmpDir       string\n25|\tInheritedSocket  string\n26|\tDefaultPath      string\n27|\tConventionalName string\n28|}\n29|\n30|// Ambient environment variable names. Both are validated by the\n31|// landed environment-name grammar at the observation boundary, so a\n32|// misspelled variable cannot smuggle an ambient value past the\n33|// non-use proof.\n34|const (\n35|\t// EnvTMUX is the tmux(1) session environment variable.\n36|\tEnvTMUX = \"TMUX\"\n37|\t// EnvTMUXTmpDir is the tmux(1) socket-directory override.\n38|\tEnvTMUXTmpDir = \"TMUX_TMPDIR\"\n39|)\n40|\n41|// ConventionalSocketName is the operator default socket leaf that AX\n42|// must never resolve to.\n43|const ConventionalSocketName = \"default\"\n44|\n45|// ObserveAmbient records the ambient socket facts visible to the\n46|// caller without using any of them. The lookup is caller-supplied so\n47|// the production entry never reads the process environment itself:\n48|// ambient discovery cannot hide in an os.Getenv call this package\n49|// never makes. Unknown variable names refuse rather than being\n50|// silently skipped, so a renamed vector cannot pass unobserved.\n51|func ObserveAmbient(lookup func(name string) (string, bool), inherited, defPath, conventional string) (Ambient, error) {\n52|\tif !secprim.IsEnvName(EnvTMUX) || !secprim.IsEnvName(EnvTMUXTmpDir) {\n53|\t\treturn Ambient{}, &Error{Code: CodeInvalidArguments, Detail: \"ambient vocabulary\"}\n54|\t}\n55|\tobserved := Ambient{\n56|\t\tInheritedSocket:  inherited,\n57|\t\tDefaultPath:      defPath,\n58|\t\tConventionalName: conventional,\n59|\t}\n60|\tif lookup == nil {\n61|\t\treturn observed, nil\n62|\t}\n63|\tif value, ok := lookup(EnvTMUX); ok {\n64|\t\tobserved.TMUXEnv = value\n65|\t}\n66|\tif value, ok := lookup(EnvTMUXTmpDir); ok {\n67|\t\tobserved.TMUXTmpDir = value\n68|\t}\n69|\treturn observed, nil\n70|}\n71|\n72|// SocketPath derives the dedicated server socket from the runtime\n73|// directory. It is the only socket constructor: acquisition never\n74|// substitutes an ambient value for its result.\n75|func SocketPath(runtimeDir string) string {\n76|\treturn filepath.Join(runtimeDir, SocketName)\n77|}\n78|\n79|// ResolveSocket returns the acquisition socket for the runtime\n80|// directory. An explicit override refuses with the ambient code no\n81|// matter which vector supplied it: there is no override surface,\n82|// only the derived socket. The ambient observation is carried for\n83|// evidence and asserted disjoint from the result by the caller\n84|// tests; resolution never reads it.\n85|func ResolveSocket(runtimeDir string, override string, ambient Ambient) (string, error) {\n86|\tif override != \"\" {\n87|\t\treturn \"\", &Error{Code: CodeAmbientReuse, Detail: \"socket override\"}\n88|\t}\n89|\tsocket := SocketPath(runtimeDir)\n90|\tif err := checkAmbientDisjoint(socket, ambient); err != nil {\n91|\t\treturn \"\", err\n92|\t}\n93|\treturn socket, nil\n94|}\n95|\n96|// checkAmbientDisjoint refuses the degenerate case where an ambient\n97|// value already names the derived socket: using the socket then\n98|// would be indistinguishable from reusing the ambient server, so\n99|// acquisition refuses instead of proceeding on an ambiguous fact.\n100|func checkAmbientDisjoint(socket string, ambient Ambient) error {\n101|\tfor _, candidate := range []string{\n102|\t\tambient.TMUXEnv,\n103|\t\tambient.TMUXTmpDir,\n104|\t\tambient.InheritedSocket,\n105|\t\tambient.DefaultPath,\n106|\t\tambient.ConventionalName,\n107|\t} {\n108|\t\tif candidate != \"\" && candidate == socket {\n109|\t\t\treturn &Error{Code: CodeAmbientReuse, Detail: \"ambient collision\"}\n110|\t\t}\n111|\t}\n112|\treturn nil\n113|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c62d","stream":{"kind":"session","id":"01a0c3b6-e69d-7952-b5c2-99ff4034d208"},"sequence":369,"recorded_at":1780531400000733,"record_type":"event","durability":"durable","causation_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","run_stream":{"kind":"run","id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8"},"call_id":"call_01a0c3b7eeb670259d95e5cd623427bd","text":"Read text file `internal/tmuxserver/readiness.go`.\n1|package tmuxserver\n2|\n3|// ManagerNameHint documents the launchctl managername observation:\n4|// a diagnostic hint only. The value travels on the request for\n5|// operator diagnostics and no gate reads it. Any test that sets a\n6|// hint and varies only live attestation proves the hint carries no\n7|// authority.\n8|type ManagerNameHint struct {\n9|\t// Value is the observed manager name, for example \"Aqua\".\n10|\t// Empty means no observation was made.\n11|\tValue string\n12|}\n13|\n14|// CachedObservation is a previously recorded sentinel or managername\n15|// result. It is a distinct type that no authorizing entry accepts:\n16|// CheckLiveAttestation takes LiveAttestation only, so a cached\n17|// value cannot be passed where live proof is required even by\n18|// accident. Its only use is negative tests proving it authorizes\n19|// nothing.\n20|type CachedObservation struct {\n21|\tSentinelPassed bool\n22|\tManagerName    string\n23|}\n24|\n25|// LiveAttestation is one live functional-sentinel plus\n26|// provider-auth-smoke observation inside the exact tmux server. Every\n27|// member is required: Aqua alone and sentinel-only evidence are\n28|// insufficient, and the binding members tie the observation to the\n29|// exact server generation, provider build, and macOS version.\n30|type LiveAttestation struct {\n31|\tSentinelPassed   bool\n32|\tSmokePassed      bool\n33|\tServerGeneration string\n34|\tProviderBuild    string\n35|\tMacOSVersion     string\n36|}\n37|\n38|// CheckLiveAttestation admits exactly one complete live observation:\n39|// a passed sentinel AND a passed provider-auth smoke AND the full\n40|// generation/build/version binding. Each conjunct refuses alone with\n41|// the non-authorizing code, so weakening any one arm admits a\n42|// sentinel-only, smoke-only, or unbound observation the committed\n43|// tests pin. A cached observation is not a LiveAttestation and has\n44|// no conversion: the type boundary, not a boolean, keeps the cache\n45|// off the authorizing path.\n46|func CheckLiveAttestation(live LiveAttestation) error {\n47|\tif !live.SentinelPassed {\n48|\t\treturn &Error{Code: CodeReadinessNotAuthorizing, Detail: \"sentinel result\"}\n49|\t}\n50|\tif !live.SmokePassed {\n51|\t\treturn &Error{Code: CodeReadinessNotAuthorizing, Detail: \"provider smoke result\"}\n52|\t}\n53|\tif live.ServerGeneration == \"\" || live.ProviderBuild == \"\" || live.MacOSVersion == \"\" {\n54|\t\treturn &Error{Code: CodeReadinessNotAuthorizing, Detail: \"attestation binding\"}\n55|\t}\n56|\treturn nil\n57|}\n58|\n59|// BrokerStatus is the live Aqua broker report the background path\n60|// decides over. Authenticated names an already-running authenticated\n61|// broker; Attested names its attested AX tmux server with a live\n62|// attestation. Either fact missing means neither exists for the\n63|// purpose of the broker-or-refuse rule.\n64|type BrokerStatus struct {\n65|\tAuthenticated bool\n66|\tAttested      bool\n67|\tAttestation   LiveAttestation\n68|}\n69|\n70|// CheckBrokerContact admits exactly the background MAY case: an\n71|// already-running authenticated broker AND its attested AX tmux\n72|// server with a complete live attestation. Every other report —\n73|// no broker, unauthenticated broker, unattested server, incomplete\n74|// attestation — refuses, and the caller maps the refusal to the\n75|// typed capability_unavailable the spec names.\n76|func CheckBrokerContact(status BrokerStatus) error {\n77|\tif !status.Authenticated {\n78|\t\treturn &Error{Code: CodeReadinessNotAuthorizing, Detail: \"broker authentication\"}\n79|\t}\n80|\tif !status.Attested {\n81|\t\treturn &Error{Code: CodeReadinessNotAuthorizing, Detail: \"server attestation\"}\n82|\t}\n83|\treturn CheckLiveAttestation(status.Attestation)\n84|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c62f","stream":{"kind":"session","id":"01a0c3b6-e69d-7952-b5c2-99ff4034d208"},"sequence":370,"recorded_at":1780531400000735,"record_type":"event","durability":"durable","causation_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","run_stream":{"kind":"run","id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8"},"call_id":"call_01a0c3b7f0c47366a2b5dd7d4d3d6b8f","text":"Read text file `internal/tmuxserver/argv.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n5|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n6|)\n7|\n8|// BuildArgv builds the dedicated server spawn vector: tmux addressed\n9|// by the exact -S socket with the stable pane entrypoint the spec\n10|// requires every managed pane to run (ax pane SESSION_ID). The\n11|// socket must be the one derived from the runtime directory: an\n12|// ambient socket passed here refuses instead of being addressed.\n13|// The session identity delegates to the landed UUIDv7 grammar, and\n14|// the assembled vector passes the landed argv shape gate before it\n15|// is returned, so a malformed vector never reaches the spawner.\n16|func BuildArgv(runtimeDir, socket, sessionID string) ([]string, error) {\n17|\tif socket != SocketPath(runtimeDir) {\n18|\t\treturn nil, &Error{Code: CodeAmbientReuse, Detail: \"spawn socket\"}\n19|\t}\n20|\tsession, err := scalar.ParseUUIDv7(sessionID)\n21|\tif err != nil {\n22|\t\treturn nil, &Error{Code: CodeInvalidArguments, Detail: \"session identity\"}\n23|\t}\n24|\targv := []string{\n25|\t\t\"tmux\",\n26|\t\t\"-S\", socket,\n27|\t\t\"new-session\",\n28|\t\t\"-d\",\n29|\t\t\"-s\", session.String(),\n30|\t\t\"ax\", \"pane\", session.String(),\n31|\t}\n32|\tif err := secprim.CheckArgv(argv); err != nil {\n33|\t\treturn nil, &Error{Code: CodeInvalidArguments, Detail: \"spawn argv\"}\n34|\t}\n35|\treturn argv, nil\n36|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c631","stream":{"kind":"session","id":"01a0c3b6-e69d-7952-b5c2-99ff4034d208"},"sequence":371,"recorded_at":1780531400000737,"record_type":"event","durability":"durable","causation_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","run_stream":{"kind":"run","id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8"},"call_id":"call_01a0c3b7f317705b8494014e397dd8c1","text":"Read text file `internal/tmuxserver/runtime.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"os\"\n5|\t\"strings\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n9|)\n10|\n11|// RuntimeDirName is the fixed leaf name of the AX tmux runtime\n12|// directory under the AX state root. It is AX-controlled vocabulary,\n13|// never an ambient or conventional tmux name.\n14|const RuntimeDirName = \"ax-tmux\"\n15|\n16|// Hooks arms the crash boundaries of EnsureRuntimeDir. AfterMkdir\n17|// runs after the directory entry is committed and before the parent\n18|// fsync; a crash there must leave a retry that converges to the one\n19|// verified directory. Hooks is nil in production.\n20|type Hooks struct {\n21|\tAfterMkdir func(dir string)\n22|}\n23|\n24|// EnsureRuntimeDir creates the owner-only runtime directory\n25|// root/name when absent and verifies it when present, returning the\n26|// joined path. Creation and verification enforce three independent\n27|// gates — containment, mode, ownership — and each refuses alone:\n28|//\n29|//   - containment: the root must be an absolute path on the platform\n30|//     grammar, the name must be one relative segment, and the commit\n31|//     opens the parent through a pinned directory handle and creates\n32|//     the leaf relative to that handle, so a symlinked intermediate\n33|//     directory cannot redirect the commit outside the root;\n34|//   - mode: the leaf must carry exactly 0700, enforced explicitly\n35|//     after creation because mkdir honors umask;\n36|//   - ownership: the leaf must belong to the effective UID.\n37|//\n38|// Lexical validation delegates to its landed owners (absolute root\n39|// and relative member to scalar, the join to secprim.Guard); the\n40|// descriptor-relative commit below is what this package owns, because\n41|// no landed helper commits a directory relative to a handle.\n42|func EnsureRuntimeDir(root, name string, platform scalar.Platform, hooks *Hooks) (string, error) {\n43|\tjoined, err := lexicalRuntimePath(root, name, platform)\n44|\tif err != nil {\n45|\t\treturn \"\", err\n46|\t}\n47|\treturn joined, commitRuntimeDir(root, name, joined, platform, hooks)\n48|}\n49|\n50|// VerifyRuntimeDir enforces the three custody gates on an existing\n51|// runtime directory without creating it. Acquisition calls this\n52|// instead of Ensure: the directory must already exist with exact\n53|// custody, and a missing directory refuses rather than being\n54|// silently created on the authorizing path.\n55|func VerifyRuntimeDir(root, name string, platform scalar.Platform) error {\n56|\tif _, err := lexicalRuntimePath(root, name, platform); err != nil {\n57|\t\treturn err\n58|\t}\n59|\treturn verifyRuntimeDir(root, name, platform)\n60|}\n61|\n62|// lexicalRuntimePath validates the root grammar, the name grammar,\n63|// and the lexical join. It answers the lexical question only; the\n64|// commit answers the filesystem question through a handle.\n65|func lexicalRuntimePath(root, name string, platform scalar.Platform) (string, error) {\n66|\tif _, err := scalar.ParsePlatform(string(platform)); err != nil {\n67|\t\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"runtime platform\"}\n68|\t}\n69|\tif _, err := scalar.ParseAbsolutePath(platform, root); err != nil {\n70|\t\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"runtime root\"}\n71|\t}\n72|\tif err := checkRuntimeName(name); err != nil {\n73|\t\treturn \"\", err\n74|\t}\n75|\tguard, err := secprim.NewGuard(root, platform, []string{name})\n76|\tif err != nil {\n77|\t\treturn \"\", &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n78|\t}\n79|\tjoined, err := guard.Resolve(name)\n80|\tif err != nil {\n81|\t\treturn \"\", &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n82|\t}\n83|\treturn joined, nil\n84|}\n85|\n86|// checkRuntimeName admits exactly one relative path segment. The\n87|// shared grammar (absolute, parent, dot, empty, NUL, backslash,\n88|// encoded separators) is decided by scalar; this gate adds only the\n89|// single-segment rule scalar does not own, because the commit opens\n90|// the leaf relative to the pinned parent handle and a second segment\n91|// would name a path the handle walk never descends.\n92|func checkRuntimeName(name string) error {\n93|\tif _, err := scalar.ParseRelativePath(name); err != nil {\n94|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"runtime name\"}\n95|\t}\n96|\tif strings.Contains(name, \"/\") {\n97|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"runtime name\"}\n98|\t}\n99|\treturn nil\n100|}\n101|\n102|// sameDirectory compares two stat results for directory identity. It\n103|// is a variable only so seam-failure tests can force the\n104|// handle-mismatch path through the production entries: a handle that\n105|// names a different directory than the path cannot be staged without\n106|// a filesystem race, and without the seam the mismatch branch is\n107|// untestable. Production code never reassigns it.\n108|var sameDirectory = os.SameFile\n109|\n110|// handleBoundToPath reports whether the open directory handle refers\n111|// to the same directory as rootPath. It mirrors the private\n112|// secprim.guardRootMatches check, which no caller outside secprim\n113|// can invoke: a stat failure on either side is not a match, and an\n114|// unreadable root fails closed into the mismatch refusal rather\n115|// than admitting an unverifiable handle.\n116|func handleBoundToPath(handle *os.File, rootPath string) bool {\n117|\thandleInfo, err := handle.Stat()\n118|\tif err != nil || handleInfo == nil {\n119|\t\treturn false\n120|\t}\n121|\tpathInfo, err := os.Stat(rootPath)\n122|\tif err != nil || pathInfo == nil {\n123|\t\treturn false\n124|\t}\n125|\treturn sameDirectory(handleInfo, pathInfo)\n126|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
