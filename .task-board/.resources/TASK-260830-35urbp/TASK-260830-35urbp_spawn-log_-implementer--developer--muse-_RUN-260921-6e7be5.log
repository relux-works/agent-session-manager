{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8d5","stream":{"kind":"session","id":"01a0c3b6-e69d-7952-b5c2-99ff4034d208"},"sequence":709,"recorded_at":1780531400001413,"record_type":"event","durability":"durable","causation_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8","run_stream":{"kind":"run","id":"5d75c7b3-ca89-4158-8f1c-936a31a9dfe8"},"task_stream":{"kind":"task","id":"01a0c3ba-c83f-7340-9864-f7c5d6dc1dca"},"task_id":"01a0c3ba-c83f-7340-9864-f7c5d6dc1dca","event":{"kind":"output","task_id":"01a0c3ba-c83f-7340-9864-f7c5d6dc1dca","chunk":"Read text file `internal/tmuxserver/readiness_test.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"testing\"\n5|)\n6|\n7|func TestCheckLiveAttestationAdmitsComplete(t *testing.T) {\n8|\tif err := CheckLiveAttestation(liveAttestation()); err != nil {\n9|\t\tt.Fatal(err)\n10|\t}\n11|}\n12|\n13|func TestCheckLiveAttestationRefusesEachMissingConjunct(t *testing.T) {\n14|\tbase := liveAttestation()\n15|\tfor _, tc := range []struct {\n16|\t\tname   string\n17|\t\tmutate func(*LiveAttestation)\n18|\t\tdetail string\n19|\t}{\n20|\t\t{\"sentinel only is insufficient\", func(l *LiveAttestation) { l.SmokePassed = false }, \"provider smoke result\"},\n21|\t\t{\"smoke only is insufficient\", func(l *LiveAttestation) { l.SentinelPassed = false }, \"sentinel result\"},\n22|\t\t{\"unbound generation\", func(l *LiveAttestation) { l.ServerGeneration = \"\" }, \"attestation binding\"},\n23|\t\t{\"unbound provider build\", func(l *LiveAttestation) { l.ProviderBuild = \"\" }, \"attestation binding\"},\n24|\t\t{\"unbound macos version\", func(l *LiveAttestation) { l.MacOSVersion = \"\" }, \"attestation binding\"},\n25|\t} {\n26|\t\tt.Run(tc.name, func(t *testing.T) {\n27|\t\t\tlive := base\n28|\t\t\ttc.mutate(&live)\n29|\t\t\trequireLocalError(t, CheckLiveAttestation(live), \"tmux_readiness_not_authorizing\", tc.detail)\n30|\t\t})\n31|\t}\n32|}\n33|\n34|func TestCheckBrokerContactAdmitsAuthenticatedAttested(t *testing.T) {\n35|\tstatus := BrokerStatus{Authenticated: true, Attested: true, Attestation: liveAttestation()}\n36|\tif err := CheckBrokerContact(status); err != nil {\n37|\t\tt.Fatal(err)\n38|\t}\n39|}\n40|\n41|func TestCheckBrokerContactRefusesEachMissingFact(t *testing.T) {\n42|\tlive := liveAttestation()\n43|\tfor _, tc := range []struct {\n44|\t\tname   string\n45|\t\tstatus BrokerStatus\n46|\t\tdetail string\n47|\t}{\n48|\t\t{\"no broker\", BrokerStatus{}, \"broker authentication\"},\n49|\t\t{\"unauthenticated broker\", BrokerStatus{Attested: true, Attestation: live}, \"broker authentication\"},\n50|\t\t{\"unattested server\", BrokerStatus{Authenticated: true, Attestation: live}, \"server attestation\"},\n51|\t\t{\"sentinel-only attestation\", BrokerStatus{Authenticated: true, Attested: true, Attestation: LiveAttestation{\n52|\t\t\tSentinelPassed:   true,\n53|\t\t\tServerGeneration: fixtureGeneration,\n54|\t\t\tProviderBuild:    fixtureProvider,\n55|\t\t\tMacOSVersion:     fixtureMacOS,\n56|\t\t}}, \"provider smoke result\"},\n57|\t} {\n58|\t\tt.Run(tc.name, func(t *testing.T) {\n59|\t\t\trequireLocalError(t, CheckBrokerContact(tc.status), \"tmux_readiness_not_authorizing\", tc.detail)\n60|\t\t})\n61|\t}\n62|}","final_result":true}}}
