+        replace="\trootHandle, err := secprim.OpenNoFollowDir(root)\n\tif err != nil {\n\t\tif fi, lerr := os.Lstat(root); lerr == nil && fi.Mode()&os.ModeSymlink != 0 {\n\t\t\trootHandle, err = os.Open(root)\n\t\t}\n\t\tif err != nil {\n\t\t\treturn classifyRootOpenError(err)\n\t\t}\n\t}\n\tdefer func() { _ = rootHandle.Close() }()\n\tif !handleBoundToPath(rootHandle, root) {\n\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n\t}\n\tleafFd, err := unix.Openat(int(rootHandle.Fd()), name,\n",
+        count=1,
+        run="(TestVerifyRuntimeDirRefusesSymlinkRoot|TestAcquireBackgroundRefusesSymlinkRoot)",
+        expect="KILLED",
+        note="Admits exactly symlink roots past the verify-side no-follow open via a following fallback; every other root-open failure still refuses, and the commit side still refuses. One site, both entries: the direct verify test meets the absent detail inside the link target, and the background entry maps it to the typed unavailable instead of the containment refusal.",
+    ),
+    Mutant(
+        name="N-argv-detached",
+        path=f"{PACKAGE}/argv.go",
+        find='\t\t"new-session",\n\t\t"-d",\n',
+        replace='\t\t"new-session",\n',
+        count=1,
+        run="(TestBuildArgvAddressesOnlyTheDerivedSocket|TestAcquireForegroundSpawnsDedicatedServer)",
+        expect="KILLED",
+        note="Admits exactly the attached spawn vector past the fixed-shape builder (the spawned server would try to attach the caller terminal); every other vector element stays exact. One site, both entries: the exact-vector assertions fail at the helper and through the foreground entry alike.",
+    ),
+    Mutant(
+        name="N-argv-tail",
+        path=f"{PACKAGE}/argv.go",
+        find='\t\t"ax", "pane", session.String(),\n',
+        replace='\t\t"ax", "attach", session.String(),\n',
+        count=1,
+        run="(TestBuildArgvAddressesOnlyTheDerivedSocket|TestAcquireForegroundSpawnsDedicatedServer)",
+        expect="KILLED",
+        note="Admits exactly the retargeted pane entrypoint past the fixed-shape builder; every other vector element stays exact. One site, both entries: the exact-vector assertions fail at the helper and through the foreground entry alike.",
+    ),
+    Mutant(
+        name="N-dispatch-foreground",
+        path=f"{PACKAGE}/acquire.go",
+        find="\tif req.Caller == CallerBackground {\n\t\treturn acquireBackground(req, socket)\n\t}\n",
+        replace="\tif req.Caller == CallerBackground || req.Caller == CallerForeground {\n\t\treturn acquireBackground(req, socket)\n\t}\n",
+        count=1,
+        run="TestAcquireForegroundSpawnsDedicatedServer",
+        expect="KILLED",
+        note="Admits exactly foreground callers to the background path; background callers still dispatch background. Kill path: the foreground spawn test refuses the background dependencies code instead of spawning.",
+    ),
+    Mutant(
+        name="N-dispatch-background",
+        path=f"{PACKAGE}/acquire.go",
+        find="\tif req.Caller == CallerBackground {\n\t\treturn acquireBackground(req, socket)\n\t}\n",
+        replace='\tif req.Caller == "Background" {\n\t\treturn acquireBackground(req, socket)\n\t}\n',
+        count=1,
+        run=BG_MISS,
+        expect="KILLED",
+        note="Admits exactly background callers to the foreground path (the capitalized twin still dispatches background); foreground callers are unaffected. Kill path: the background miss table spawns into the dedicated server instead of refusing the typed unavailable.",
+    ),
+    Mutant(
+        name="D-background-fallback",
+        path=f"{PACKAGE}/acquire.go",
+        find="\t\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\n\t\t\treturn Outcome{}, backgroundUnavailable(req, err)\n\t\t}\n",
+        replace="\t\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\n\t\t\tif req.Deps.Spawn != nil {\n\t\t\t\t_ = req.Deps.Spawn(socket, nil)\n\t\t\t}\n\t\t\treturn Outcome{}, backgroundUnavailable(req, err)\n\t\t}\n",
+        count=1,
+        run=BG_MISS_LINUX,
+        expect="KILLED",
+        note="SUPPLEMENTARY ADDITIVE, not a narrowing: plants the reviewer-shaped direct-creation call on the background miss path. Kill path: every background-miss spy asserts zero spawn calls.",
+    ),
+    Mutant(
+        name="D-background-fallback-foreground",
+        path=f"{PACKAGE}/acquire.go",
+        find="\t\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\n\t\t\treturn Outcome{}, backgroundUnavailable(req, err)\n\t\t}\n",
+        replace="\t\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\n\t\t\tif req.Deps.ProbeServer != nil && req.Deps.Spawn != nil {\n\t\t\t\treturn acquireForeground(req, socket)\n\t\t\t}\n\t\t\treturn Outcome{}, backgroundUnavailable(req, err)\n\t\t}\n",
+        count=1,
+        run=BG_MISS_LINUX,
+        expect="KILLED",
+        note="SUPPLEMENTARY ADDITIVE, not a narrowing: a fallback into acquireForeground on the background miss path, guarded on the foreground probe dependency — the shared-Dependencies shape, where the lifecycle adapter passes one Dependencies value to every caller. Kill path: every background-miss test arms both a spy spawner and a spy server probe and asserts the typed unavailable, so re-entering the foreground path trips the census before it spawns.",
+    ),
+    Mutant(
+        name="C-control",
+        path=f"{PACKAGE}/errors.go",
+        find="// Error is a package-local refusal. Code is one of the Code*",
+        replace="// Error is a package-local refusal (harness control: comment-only). Code is one of the Code*",
+        count=1,
+        run="TestSocketPathDerivesOnlyFromRuntimeDir",
+        expect="SURVIVED",
+        note="Harmless control: a comment-only edit that must SURVIVE, proving the harness observes outcomes.",
+    ),
+]
+
+
+def apply(mutant: Mutant, original: str) -> str:
+    return original.replace(mutant.find, mutant.replace)
+
+
+def run_mutant(mutant: Mutant, log_dir: Path | None) -> str:
+    target = REPO / mutant.path
+    original = target.read_text()
+    found = original.count(mutant.find)
+    if found != mutant.count:
+        return f"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}"
+    with tempfile.TemporaryDirectory() as staging:
+        backup = Path(staging) / "backup"
+        shutil.copy2(target, backup)
+        try:
+            target.write_text(apply(mutant, original))
+            run = subprocess.run(
+                ["go", "test", f"./{PACKAGE}/", "-run", mutant.run, "-count=1"],
+                cwd=REPO,
+                capture_output=True,
+                text=True,
+                timeout=300,
+            )
+        finally:
+            shutil.copy2(backup, target)
+    output = (run.stdout + run.stderr).strip()
+    if os.environ.get("AX_MUTANT_VERBOSE") == "1":
+        print(f"--- raw: {mutant.name}: exit {run.returncode} ---", flush=True)
+        print(output, flush=True)
+        print(f"--- end raw: {mutant.name} ---", flush=True)
+    if log_dir is not None:
+        (log_dir / f"{mutant.name}.log").write_text(
+            f"exit: {run.returncode}\nrun: go test ./{PACKAGE}/ -run {mutant.run} -count=1\n\n{output}\n"
+        )
+    if 'build failed' in output or '\n# ' in output or output.startswith('# '):
+        return f"ERROR: {mutant.name}: build broke under the patch"
+    if run.returncode == 0:
+        verdict = "SURVIVED"
+    elif '--- FAIL' in output or 'FAIL:' in output:
+        verdict = "KILLED"
+    else:
+        return f"ERROR: {mutant.name}: exit {run.returncode} with no kill line"
+    mark = "ok" if verdict == mutant.expect else "MISMATCH"
+    return f"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note} [exit {run.returncode}]"
+
+
+def main(argv: list[str]) -> int:
+    log_dir: Path | None = None
+    names = list(argv)
+    if "--log-dir" in names:
+        idx = names.index("--log-dir")
+        if idx + 1 >= len(names):
+            print("--log-dir needs a directory")
+            return 2
+        log_dir = Path(names[idx + 1])
+        log_dir.mkdir(parents=True, exist_ok=True)
+        del names[idx : idx + 2]
+    selected = [m for m in MUTANTS if not names or m.name in names]
+    if names and len(selected) != len(names):
+        unknown = sorted(set(names) - {m.name for m in selected})
+        print(f"unknown mutants: {', '.join(unknown)}")
+        return 2
+    failures = 0
+    for mutant in selected:
+        try:
+            line = run_mutant(mutant, log_dir)
+        except subprocess.TimeoutExpired:
+            line = f"ERROR: {mutant.name}: killer timed out"
+        print(line, flush=True)
+        if not line.startswith("ok:"):
+            failures += 1
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
diff --git a/internal/tmuxserver/ownership_unix.go b/internal/tmuxserver/ownership_unix.go
new file mode 100644
index 0000000..e977db2
--- /dev/null
+++ b/internal/tmuxserver/ownership_unix.go
@@ -0,0 +1,39 @@
+//go:build !windows
+
+package tmuxserver
+
+import (
+	"io/fs"
+	"os"
+	"syscall"
+)
+
+// effectiveUID reports the process effective UID. It is a variable
+// only so seam-failure tests can force the foreign-ownership path
+// through the production entries: staging a foreign-owned directory
+// needs privilege no test may assume, and without the seam the
+// ownership refusal is untestable. Production code never reassigns
+// it.
+var effectiveUID = os.Geteuid
+
+// currentUID reports the process effective UID the broker same-user
+// arm decides over. It reads the effectiveUID seam so tests stage a
+// foreign broker without privilege; production code never reassigns
+// the seam.
+func currentUID() uint32 { return uint32(effectiveUID()) }
+
+// verifyOwnership enforces the ownership gate on unix: the directory
+// must belong to the effective UID. Mode bits are checked by the
+// caller against the exact 0700 requirement, so any group or world
+// access already refused there. A stat without ownership metadata
+// fails closed: unreadable ownership is never legitimate custody.
+func verifyOwnership(info fs.FileInfo) error {
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	if !ok {
+		return &Error{Code: CodeUnsafeRuntimeDir, Detail: "runtime ownership"}
+	}
+	if stat.Uid != uint32(effectiveUID()) {
+		return &Error{Code: CodeUnsafeRuntimeDir, Detail: "runtime ownership"}
+	}
+	return nil
+}
