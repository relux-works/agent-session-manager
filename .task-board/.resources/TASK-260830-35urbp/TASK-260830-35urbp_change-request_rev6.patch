+		t.Fatalf("alias %q cleans to %q, want the derived socket", alias, got)
+	}
+	for _, caller := range []Caller{CallerForeground, CallerBackground} {
+		t.Run(string(caller), func(t *testing.T) {
+			req := validRequest(t, root)
