{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6b5","stream":{"kind":"session","id":"01a0c52f-2ee9-7e90-86a5-5469e2a72bf6"},"sequence":437,"recorded_at":1780531400000869,"record_type":"event","durability":"durable","causation_id":"0c8ad2d8-68e1-4b10-83fc-51c6169a80fc","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0c8ad2d8-68e1-4b10-83fc-51c6169a80fc","run_stream":{"kind":"run","id":"0c8ad2d8-68e1-4b10-83fc-51c6169a80fc"},"task_stream":{"kind":"task","id":"01a0c53e-68c9-7210-b7c7-72bb755c1f93"},"task_id":"01a0c53e-68c9-7210-b7c7-72bb755c1f93","event":{"kind":"output","task_id":"01a0c53e-68c9-7210-b7c7-72bb755c1f93","chunk":"Read text file `internal/tmuxserver/acquire.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"errors\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/axpane\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|// Caller names the acquisition caller. The vocabulary is owned by\n12|// internal/axpane, which already gates the wrapper decision over it;\n13|// this package reuses its constants rather than retyping them.\n14|type Caller = string\n15|\n16|const (\n17|\t// CallerForeground is an interactive operator-side caller that\n18|\t// may create the dedicated server.\n19|\tCallerForeground = axpane.CallerForeground\n20|\t// CallerBackground is a background CLI, SSH RPC process,\n21|\t// daemon, or restore worker: it must never create a\n22|\t// credential-dependent tmux server, may contact an\n23|\t// already-running authenticated broker, and otherwise receives\n24|\t// capability_unavailable with no fallback to direct creation.\n25|\tCallerBackground = axpane.CallerBackground\n26|)\n27|\n28|// Acquisition outcomes name how the caller reached the dedicated\n29|// server. Exactly one applies; there is no combined or fallback\n30|// outcome.\n31|const (\n32|\t// ViaSpawned created the dedicated -S server on the foreground\n33|\t// path and returns its spawn argv.\n34|\tViaSpawned = \"spawned\"\n35|\t// ViaAttachedFound the dedicated server already running and\n36|\t// attested on the foreground path.\n37|\tViaAttached = \"attached-running\"\n38|\t// ViaBroker contacted the already-running authenticated Aqua\n39|\t// broker and its attested AX tmux server on the background\n40|\t// path. No local spawn argv exists on this path.\n41|\tViaBroker = \"broker\"\n42|)\n43|\n44|// realmCapability is the Section 4.D capability the background\n45|// typed refusal names: the exact instance passes the AX sentinel\n46|// and the provider-auth smoke without UI. The admission verdict is\n47|// the landed terminalbackend owner's; this package consumes it\n48|// through RealmAdmission and never re-decides it.\n49|const realmCapability = \"credential_capable_execution_realm\"\n50|\n51|// ServerReport is the live dedicated-server probe result: whether\n52|// the private socket answers, with the landed admission verdict over\n53|// the exact server when it does.\n54|type ServerReport struct {\n55|\tRunning   bool\n56|\tAdmission RealmAdmission\n57|}\n58|\n59|// Dependencies carries every external interaction acquisition\n60|// performs. This leaf ships the decision core and argv only: no\n61|// production probe or spawner implementation exists in the tree. The\n62|// exec/probe adapters — which report Reconcile/ResolveEvidence\n63|// verdicts and spawn through the built argv — and the server socket's\n64|// crash evidence are owned by the lifecycle leaf TASK-260830-1c28dz;\n65|// tests wire fakes. No probe runs without its dependency: a nil entry\n66|// refuses instead of reaching for a default.\n67|type Dependencies struct {\n68|\t// ProbeServer reports the dedicated socket's live state.\n69|\tProbeServer func(socket string) (ServerReport, error)\n70|\t// ProbeBroker reports the live Aqua broker state.\n71|\tProbeBroker func() (BrokerReport, error)\n72|\t// Spawn creates the dedicated server with the given -S argv.\n73|\tSpawn func(socket string, argv []string) error\n74|}\n75|\n76|// Request is the complete acquisition surface. There is deliberately\n77|// no member for a credential flag, a managername hint, or a cached\n78|// observation: the background creation rule needs no credential flag\n79|// because the background path never creates on any platform, and a\n80|// hint or cached observation never authorizes, so none is an input.\n81|type Request struct {\n82|\tCaller   Caller\n83|\tPlatform scalar.Platform\n84|\t// Root is the Runtime IPC root of the SPEC 3.2 table (macOS:\n85|\t// per-user temporary directory; Linux/WSL2:\n86|\t// $XDG_RUNTIME_DIR/ax), resolved by the landed localstore\n87|\t// layout as PathRuntime and supplied by the caller — this leaf\n88|\t// resolves no root of its own, because the socket is runtime\n89|\t// IPC, never durable identity. The runtime leaf is not a\n90|\t// caller input: Acquire always passes RuntimeDirName, so the\n91|\t// derived socket is always <Root>/tmux/ax.sock and no caller\n92|\t// spelling can re-open the ambient or conventional names the\n93|\t// override gate refuses. Foreground acquisition ensures the\n94|\t// directory idempotently; background acquisition verifies the\n95|\t// existing directory and never creates it.\n96|\tRoot string\n97|\t// Ambient carries the observed ambient socket facts for\n98|\t// evidence. Resolution never reads them; tests assert the\n99|\t// acquired socket equals none of them.\n100|\tAmbient Ambient\n101|\t// SocketOverride must be empty. Any caller-supplied socket —\n102|\t// whichever ambient vector supplied it — refuses.\n103|\tSocketOverride string\n104|\t// SessionID is the logical session the spawned server will\n105|\t// host, as canonical UUIDv7. It shapes spawn argv only.\n106|\tSessionID string\n107|\t// Generation, BrokerState, and Remediation are the typed\n108|\t// realm/readiness details the capability_unavailable refusal\n109|\t// carries. All three are required: an input that omits one\n110|\t// is malformed and refuses invalid_arguments instead of\n111|\t// emitting an untyped refusal. Generation is also the typed\n112|\t// generation every admission must bind to.\n113|\tGeneration  string\n114|\tBrokerState string\n115|\tRemediation string\n116|\tDeps        Dependencies\n117|}\n118|\n119|// Outcome is the one acquisition result.\n120|type Outcome struct {\n121|\tVia    string\n122|\tSocket string\n123|\t// Argv is the dedicated -S spawn argv. It is set only for\n124|\t// ViaSpawned: the broker path spawns nothing and the\n125|\t// attached path presents through sibling-owned attach\n126|\t// semantics, not through a second spawn vector.\n127|\tArgv []string\n128|}\n129|\n130|// Acquire resolves the dedicated server socket from the runtime\n131|// directory and reaches the server through the caller-appropriate\n132|// path. Foreground attaches to the running attested server or\n133|// spawns the dedicated -S server; background contacts the\n134|// already-running authenticated broker or receives the typed\n135|// capability_unavailable refusal, and never falls back to direct\n136|// server creation — there is no spawn call on the background path,\n137|// and every background-path Acquire test arms both a spy spawner\n138|// and a spy server probe that fail the run if either is ever\n139|// invoked, so a fallback through either foreground dependency is\n140|// visible.\n141|//\n142|// Refusals precede side effects: malformed input (caller, realm\n143|// details, runtime root/name grammar, session identity), ambient\n144|// reuse, and missing dependencies all refuse before any directory is\n145|// created, and background acquisition verifies the runtime directory\n146|// without creating it, so a background caller performs no durable\n147|// write.\n148|func Acquire(req Request) (Outcome, error) {\n149|\tif req.Caller != CallerForeground && req.Caller != CallerBackground {\n150|\t\treturn Outcome{}, &Error{Code: CodeInvalidArguments, Detail: \"caller\"}\n151|\t}\n152|\tif req.Generation == \"\" || req.BrokerState == \"\" || req.Remediation == \"\" {\n153|\t\treturn Outcome{}, &Error{Code: CodeInvalidArguments, Detail: \"realm details\"}\n154|\t}\n155|\tdir, err := lexicalRuntimePath(req.Root, RuntimeDirName, req.Platform)\n156|\tif err != nil {\n157|\t\treturn Outcome{}, err\n158|\t}\n159|\tsocket, err := ResolveSocket(dir, req.SocketOverride, req.Ambient)\n160|\tif err != nil {\n161|\t\treturn Outcome{}, err\n162|\t}\n163|\tif req.Caller == CallerBackground {\n164|\t\treturn acquireBackground(req, socket)\n165|\t}\n166|\treturn acquireForeground(req, socket)\n167|}\n168|\n169|// acquireBackground implements the broker-or-refuse rule: it may\n170|// contact the already-running authenticated broker and its attested\n171|// server, and when neither exists it returns capability_unavailable\n172|// with typed realm/readiness details. Direct server creation is not\n173|// the else branch — this function has no path to the spawner, on\n174|// any platform — and the runtime directory is verified, never\n175|// created here. A missing leaf is the ordinary cold state (the\n176|// Runtime IPC root is a per-user temporary directory), so absence\n177|// maps to the typed unavailable with no broker probe and no spawn;\n178|// a leaf that exists but fails custody keeps its custody code.\n179|func acquireBackground(req Request, socket string) (Outcome, error) {\n180|\tif req.Deps.ProbeBroker == nil {\n181|\t\treturn Outcome{}, &Error{Code: CodeInvalidArguments, Detail: \"dependencies\"}\n182|\t}\n183|\tverr := VerifyRuntimeDir(req.Root, RuntimeDirName, req.Platform)\n184|\tif runtimeAbsent(verr) {\n185|\t\treturn Outcome{}, backgroundUnavailable(req, verr)\n186|\t}\n187|\tif verr != nil {\n188|\t\treturn Outcome{}, verr\n189|\t}\n190|\tstatus, err := req.Deps.ProbeBroker()\n191|\tif err != nil {\n192|\t\treturn Outcome{}, err\n193|\t}\n194|\tif err := CheckBrokerContact(status, req.Generation, currentUID()); err != nil {\n195|\t\t// The miss path creates nothing: it consults the creation\n196|\t\t// gate so the no-fallback rule is enforced by a call, not\n197|\t\t// by the absence of one. The gate refuses every background\n198|\t\t// caller; its refusal is expected here and the path reports\n199|\t\t// the typed unavailable the spec names. The else branch is\n200|\t\t// reachable only when the gate is weakened to admit a\n201|\t\t// background caller, and then it refuses with the creation\n202|\t\t// code instead of the typed unavailable, so the committed\n203|\t\t// background-miss tests redden.\n204|\t\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\n205|\t\t\treturn Outcome{}, backgroundUnavailable(req, err)\n206|\t\t}\n207|\t\treturn Outcome{}, &Error{Code: CodeBackgroundCreationRefused, Detail: \"background fallback\"}\n208|\t}\n209|\treturn Outcome{Via: ViaBroker, Socket: socket}, nil\n210|}\n211|\n212|// acquireForeground attaches to the running attested dedicated\n213|// server or spawns it. A running but unattested server refuses:\n214|// acquisition never attaches to a server whose landed admission is\n215|// missing or bound to another generation, and never repairs it here\n216|// — lifecycle owns that decision. The session identity is validated\n217|// here, before the directory is ensured and the server probed, so a\n218|// malformed session refuses before any side effect; BuildArgv\n219|// re-validates at the spawn site, and each side carries its own\n220|// narrowing row.\n221|func acquireForeground(req Request, socket string) (Outcome, error) {\n222|\tif req.Deps.ProbeServer == nil || req.Deps.Spawn == nil {\n223|\t\treturn Outcome{}, &Error{Code: CodeInvalidArguments, Detail: \"dependencies\"}\n224|\t}\n225|\tif _, err := scalar.ParseUUIDv7(req.SessionID); err != nil {\n226|\t\treturn Outcome{}, &Error{Code: CodeInvalidArguments, Detail: \"session identity\"}\n227|\t}\n228|\tensured, err := EnsureRuntimeDir(req.Root, RuntimeDirName, req.Platform, nil)\n229|\tif err != nil {\n230|\t\treturn Outcome{}, err\n231|\t}\n232|\treport, err := req.Deps.ProbeServer(socket)\n233|\tif err != nil {\n234|\t\treturn Outcome{}, err\n235|\t}\n236|\tif report.Running {\n237|\t\tif err := CheckServerAttested(report.Admission, req.Generation); err != nil {\n238|\t\t\treturn Outcome{}, err\n239|\t\t}\n240|\t\treturn Outcome{Via: ViaAttached, Socket: socket}, nil\n241|\t}\n242|\targv, err := BuildArgv(ensured, socket, req.SessionID)\n243|\tif err != nil {\n244|\t\treturn Outcome{}, err\n245|\t}\n246|\tif err := req.Deps.Spawn(socket, argv); err != nil {\n247|\t\treturn Outcome{}, &Error{Code: CodeSpawnFailed, Detail: \"server spawn\"}\n248|\t}\n249|\treturn Outcome{Via: ViaSpawned, Socket: socket, Argv: argv}, nil\n250|}\n251|\n252|// runtimeAbsent reports whether err is the verify-side absent-leaf\n253|// refusal. Only the missing leaf counts — never a missing root, a\n254|// mode, ownership, kind, or symlink refusal: absence is the\n255|// readiness fact the background path maps to\n256|// capability_unavailable, while every unsafe-leaf refusal keeps its\n257|// custody code. A nil error is not absence.\n258|func runtimeAbsent(err error) bool {\n259|\tvar local *Error\n260|\tif !errors.As(err, &local) {\n261|\t\treturn false\n262|\t}\n263|\treturn local.Code == CodeUnsafeRuntimeDir && local.Detail == \"runtime absent\"\n264|}\n265|\n266|// checkCreationAllowed is the single choke point before every\n267|// direct server creation. A background caller never creates: on\n268|// macOS because server creation is credential-sensitive, and on\n269|// every platform because the background path must not fall back to\n270|// direct creation. The macOS credential-dependent case is one\n271|// fixture of this gate, not a narrower arm: narrowing the gate to\n272|// macOS or to credential-dependent servers would admit background\n273|// creation the no-fallback rule forbids. Foreground creation is\n274|// allowed on every platform; the credential binding it needs is\n275|// proven by the landed admission the server must present before\n276|// any attach.\n277|func checkCreationAllowed(caller Caller) error {\n278|\tif caller == CallerBackground {\n279|\t\treturn &Error{Code: CodeBackgroundCreationRefused, Detail: \"background creation\"}\n280|\t}\n281|\treturn nil\n282|}\n283|\n284|// backgroundUnavailable composes the typed capability_unavailable\n285|// refusal the spec names for the background miss, with the exact\n286|// Section 15.3 detail set. The constructor enforces the typed\n287|// details; a failure to render them is itself malformed input, not\n288|// an untyped refusal.\n289|func backgroundUnavailable(req Request, cause error) error {\n290|\tdetails := axerror.RealmEvidence{\n291|\t\tCapability:           realmCapability,\n292|\t\tCallerRealm:          req.Caller,\n293|\t\tBrokerState:          req.BrokerState,\n294|\t\tTmuxServerGeneration: req.Generation,\n295|\t\tRemediation:          req.Remediation,\n296|\t}\n297|\tfailure, err := axerror.NewRealmEvidenceUnavailable(axerror.Version130,\n298|\t\t\"no authenticated broker or attested tmux server\",\n299|\t\taxerror.NoIDs(), details, cause)\n300|\tif err != nil {\n301|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"realm details\"}\n302|\t}\n303|\treturn failure\n304|}","final_result":true}}}
