{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c777","stream":{"kind":"session","id":"01a0c36e-d989-7603-9e05-f0fee9b1e516"},"sequence":534,"recorded_at":1780531400001063,"record_type":"event","durability":"durable","causation_id":"78e4a4f8-26f7-4967-82c0-c54272cc4623","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"78e4a4f8-26f7-4967-82c0-c54272cc4623","run_stream":{"kind":"run","id":"78e4a4f8-26f7-4967-82c0-c54272cc4623"},"task_stream":{"kind":"task","id":"01a0c371-0699-7e03-8874-05ba17a70d84"},"task_id":"01a0c371-0699-7e03-8874-05ba17a70d84","event":{"kind":"output","task_id":"01a0c371-0699-7e03-8874-05ba17a70d84","chunk":"Read text file `internal/terminalbackend/terminalbackend.go`.\n1|// Package terminalbackend implements the TerminalBackend registry: canonical\n2|// backend identities, implementation/protocol version tuples, external\n3|// executable trust admission, and duplicate or drift refusal.\n4|//\n5|// Normative scope is relux-works/agent-session-manager-spec@v0.5.0 §4.B\n6|// (registry, identity, discovery, trust), §4.1 (backend interface versions),\n7|// §6.5 (Configuration 3.0.0 TerminalBackend extension), and §7.A (Provider\n8|// Protocol 3.0.0 Terminal Instance binding). Manifest/Probe schemas,\n9|// capability evidence, and generation-bound admission are defined in\n10|// manifest.go; lifecycle operations and legacy v0.4.3 translation belong to\n11|// the sibling story tasks and are deliberately not defined here.\n12|package terminalbackend\n13|\n14|import (\n15|\t\"crypto/sha256\"\n16|\t\"encoding/hex\"\n17|\t\"errors\"\n18|\t\"fmt\"\n19|\t\"math\"\n20|\t\"os\"\n21|\t\"path/filepath\"\n22|\t\"regexp\"\n23|\t\"sort\"\n24|\t\"strings\"\n25|\t\"sync\"\n26|\t\"unicode/utf8\"\n27|\n28|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n29|)\n30|\n31|// Wire error codes are the exact Section 15.3 codes the registry may report.\n32|// They are a subset of the pinned catalog error vocabulary; no other code is\n33|// emitted by this package.\n34|const (\n35|\t// CodeNotFound reports an unknown or malformed backend identity. A failed\n36|\t// read is never absence: callers must not treat this as \"no backend\".\n37|\tCodeNotFound = \"terminal_backend_not_found\"\n38|\t// CodeAmbiguous reports a duplicate or ambiguous backend ID. Re-registering\n39|\t// an identical record is still refused: identity registration is not\n40|\t// idempotent.\n41|\tCodeAmbiguous = \"terminal_backend_ambiguous\"\n42|\t// CodeUntrusted reports a disabled, unresolvable, or digest-mismatched\n43|\t// external executable. Trust is established before any probe.\n44|\tCodeUntrusted = \"terminal_backend_untrusted\"\n45|\t// CodeDrift reports a re-registration whose version tuple, kind,\n46|\t// platforms, or executable digest differs from the admitted record.\n47|\tCodeDrift = \"terminal_backend_implementation_drift\"\n48|\t// CodeRestoreMismatch reports an attempt to substitute the configured\n49|\t// default for the exact prior binding on restore or resume.\n50|\tCodeRestoreMismatch = \"terminal_backend_restore_mismatch\"\n51|\t// CodeStaleGeneration reports a generation that is out of bound or does\n52|\t// not match the validated binding.\n53|\tCodeStaleGeneration = \"terminal_backend_stale_generation\"\n54|)\n55|\n56|// Canonical built-in backend identities. The ax. namespace is reserved (§4.B);\n57|// no third-party registration may use it.\n58|const (\n59|\tBuiltinTmux   = \"ax.tmux\"\n60|\tBuiltinConpty = \"ax.conpty\"\n61|)\n62|\n63|// reservedNamespace is the only namespace this implementation may mint.\n64|const reservedNamespace = \"ax.\"\n65|\n66|// maxIDBytes is the Section 4.B bound: 1-128 ASCII bytes.\n67|const maxIDBytes = 128\n68|\n69|// maxGenerationRunes is the Section 4.B/7.A bound: string[1..256] counts\n70|// UTF-8 characters (SPEC.md:321), not bytes; terminal_backend_id is the\n71|// only member of this package still bounded in ASCII bytes.\n72|const maxGenerationRunes = 256\n73|\n74|// maxProtocolVersions is the Section 4.B bound: sorted unique semver[1..32].\n75|const maxProtocolVersions = 32\n76|\n77|var (\n78|\tidPattern = regexp.MustCompile(`^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$`)\n79|\t// semverPattern implements Semantic Versioning 2.0.0 in full, matching the\n80|\t// grammar the canonical and config packages enforce for the same members.\n81|\tsemverPattern = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n82|)\n83|\n84|// Error is a registry refusal. Code is always one of the Code* constants;\n85|// BackendID names the identity at issue when there is one. Detail is a static\n86|// clause: it never echoes paths, digests, generations, or other local data.\n87|type Error struct {\n88|\tCode      string\n89|\tBackendID string\n90|\tDetail    string\n91|}\n92|\n93|func (err *Error) Error() string {\n94|\tif err.BackendID == \"\" {\n95|\t\treturn \"terminal backend refused: \" + err.Code + \" at \" + err.Detail\n96|\t}\n97|\treturn \"terminal backend refused: \" + err.Code + \" for \" + err.BackendID + \" at \" + err.Detail\n98|}\n99|\n100|// recordRefusal arms runtime attribution of constructed refusals to their\n101|// production call site. It is nil in production: construction is then a\n102|// pure allocation with zero behavior change. The refusal-arm inventory\n103|// audit (internal test) sets it for the test-binary run so the exercised\n104|// file:line set behind every refusal can be audited against the derived\n105|// arm set in both directions. The hook carries only code and detail; the\n106|// audit attributes the site itself through the call stack, exactly like\n107|// the provider/provhost swapped-constructor recorders.\n108|var recordRefusal func(code, detail string)\n109|\n110|// refuse builds the refusal for one derived arm. Every production\n111|// &Error literal routes through refuse so the exercised-site audit can\n112|// attribute each refusal to its file:line; an &Error literal built\n113|// outside refuse is an unregistered construction the derivation rejects.\n114|// The returned value is identical to the wrapped literal: recording never\n115|// alters the refusal.\n116|//\n117|//go:noinline\n118|func refuse(err *Error) *Error {\n119|\tif recordRefusal != nil {\n120|\t\trecordRefusal(err.Code, err.Detail)\n(more lines below)","final_result":true}}}
