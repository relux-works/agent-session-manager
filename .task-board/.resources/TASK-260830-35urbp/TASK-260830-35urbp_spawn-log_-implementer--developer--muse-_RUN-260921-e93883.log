t Section 15.3 requires when\\n// broker, tmux server generation, or functional-sentinel evidence is missing or\\n// unsafe: \\\"capability_unavailable with typed details containing capability,\\n// caller_realm, broker_state, tmux_server_generation, and remediation\\\".\\n//\\n// tmux_server_generation is carried here on that clause's explicit instruction.\\n// The Section 16.2 exclusion of backend generations governs manifests and\\n// bundles generated by ax, and the more specific clause licenses this one\\n// diagnostic field.\\ntype RealmEvidence struct {\\n\\tCapability           string\\n\\tCallerRealm          string\\n\\tBrokerState          string\\n\\tTmuxServerGeneration string\\n\\tRemediation          string\\n}\\n\\n// Details renders the typed set. Every field is required, because a caller that\\n// omits one has not produced the typed details the clause names.\\nfunc (evidence RealmEvidence) Details() (Details, error) {\\n\\treturn requiredTypedDetails(map[string]string{\\n\\t\\t\\\"capability\\\":             evidence.Capability,\\n\\t\\t\\\"caller_realm\\\":           evidence.CallerRealm,\\n\\t\\t\\\"broker_state\\\":           evidence.BrokerState,\\n\\t\\t\\\"tmux_server_generation\\\": evidence.TmuxServerGeneration,\\n\\t\\t\\\"remediation\\\":            evidence.Remediation,\\n\\t})\\n}\\n\\n// TargetAuth is the exact typed detail set Section 15.3 requires for\\n// target_auth_missing: \\\"typed provider_id, provider_build, macos_version,\\n// tmux_server_generation, and remediation\\\".\\ntype TargetAuth struct {\\n\\tProviderID           string\\n\\tProviderBuild        string\\n\\tMacOSVersion         string\\n\\tTmuxServerGeneration string\\n\\tRemediation          string\\n}\\n\\n// Details renders the typed set. Every field is required.\\nfunc (target TargetAuth) Details() (Details, error) {\\n\\treturn requiredTypedDetails(map[string]string{\\n\\t\\t\\\"provider_id\\\":            target.ProviderID,\\n\\t\\t\\\"provider_build\\\":         target.ProviderBuild,\\n\\t\\t\\\"macos_version\\\":          target.MacOSVersion,\\n\\t\\t\\\"tmux_server_generation\\\": target.TmuxServerGeneration,\\n\\t\\t\\\"remediation\\\":            target.Remediation,\\n\\t})\\n}\\n\\n// targetAuthMissingKeys is the presence requirement New enforces for\\n// target_auth_missing, so the generic constructor cannot emit that code with a\\n// weaker detail set than the typed constructor produces.\\nvar targetAuthMissingKeys = []string{\\n\\t\\\"macos_version\\\",\\n\\t\\\"provider_build\\\",\\n\\t\\\"provider_id\\\",\\n\\t\\\"remediation\\\",\\n\\t\\\"tmux_server_generation\\\",\\n}\\n\\nfunc requiredTypedDetails(fields map[string]string) (Details, error) {\\n\\tdetails := make(Details, len(fields))\\n\\tfor _, key := range sortedKeys(fields) {\\n\\t\\tif fields[key] == \\\"\\\" {\\n\\t\\t\\treturn nil, fmt.Errorf(\\\"%w: typed detail %q is required and must not be empty\\\", ErrInvalidDetails, key)\\n\\t\\t}\\n\\t\\tdetails[key] = fields[key]\\n\",\n  \"original_output_bytes\": 5239,\n  \"original_output_tokens\": 1310,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
