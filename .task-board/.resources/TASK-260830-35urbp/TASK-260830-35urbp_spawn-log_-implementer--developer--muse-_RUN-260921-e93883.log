{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8a3","stream":{"kind":"session","id":"01a0c36e-d989-7603-9e05-f0fee9b1e516"},"sequence":684,"recorded_at":1780531400001363,"record_type":"event","durability":"durable","causation_id":"78e4a4f8-26f7-4967-82c0-c54272cc4623","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"78e4a4f8-26f7-4967-82c0-c54272cc4623","run_stream":{"kind":"run","id":"78e4a4f8-26f7-4967-82c0-c54272cc4623"},"task_stream":{"kind":"task","id":"01a0c371-69cf-7da3-abd1-82c00a5879ad"},"task_id":"01a0c371-69cf-7da3-abd1-82c00a5879ad","event":{"kind":"output","task_id":"01a0c371-69cf-7da3-abd1-82c00a5879ad","chunk":"Read text file `internal/axpane/decide.go`.\n(899 line(s) above)\n900|// through the admitted credential_capable_execution_realm\n901|// Capability Evidence row bound to the exact host binding, the\n902|// probed provider build, and the current generation, admitted\n903|// through the landed terminalbackend reconcile path. It never falls\n904|// back to direct server creation, and no cached sentinel,\n905|// managername observation, or bare boolean authorizes resume. A\n906|// foreground caller on a credential-free path passes. Expiry,\n907|// logout, and reboot invalidation are the reconcile liveness and\n908|// generation binding the admission already enforces; a stale\n909|// generation in the typed details refuses as well. Typed details\n910|// are required input members: an input that omits one is itself\n911|// malformed and refuses invalid_arguments instead of emitting an\n912|// untyped capability_unavailable.\n913|func checkRealm(input Input, admitted terminalbackend.Admitted, evidence []terminalbackend.Evidence) error {\n914|\tif input.Realm.Caller != CallerBackground && !input.Smoke.Required {\n915|\t\treturn nil\n916|\t}\n917|\tif !admitted.Has(credentialRealmCapability) {\n918|\t\treturn realmFailure(input, errNoRealmEvidence())\n919|\t}\n920|\tif input.Realm.ServerGeneration != input.Backend.RawGeneration {\n921|\t\treturn realmFailure(input, errRealmGenerationStale())\n922|\t}\n923|\tif err := checkRealmBinding(input, evidence); err != nil {\n924|\t\treturn realmFailure(input, err)\n925|\t}\n926|\treturn nil\n927|}\n928|\n929|// checkRealmBinding binds the admitted realm row to the exact host\n930|// binding and probed provider build: some submitted realm evidence\n931|// object must carry the validated host-local terminal binding and\n932|// the probed provider id/build. The scan accepts when any realm\n933|// object binds, so the outcome never depends on evidence order.\n934|// Generation, platform, OS version, expiry, and signature are the\n935|// reconcile binding the admission already proves; this is only the\n936|// wrapper-side cross-bind the lifecycle owner evaluates.\n937|func checkRealmBinding(input Input, evidence []terminalbackend.Evidence) error {\n938|\tseen := false\n939|\tfor _, object := range evidence {\n940|\t\tif object.Capability != credentialRealmCapability {\n941|\t\t\tcontinue\n942|\t\t}\n943|\t\tseen = true\n944|\t\tif object.TerminalBindingID != input.HostBinding.TerminalBindingID {\n945|\t\t\tcontinue\n946|\t\t}\n947|\t\tif object.ProviderID != input.Provider.Build.ProviderID ||\n948|\t\t\tobject.ProviderBuild != input.Provider.Build.ProviderVersion {\n949|\t\t\tcontinue\n950|\t\t}\n951|\t\treturn nil\n952|\t}\n953|\tif !seen {\n954|\t\treturn errNoRealmEvidence()\n955|\t}\n956|\treturn errRealmBinding()\n957|}\n958|\n959|// deadRealmRefusal maps a backend admission failure to the typed\n960|// capability_unavailable refusal when the caller needs the realm\n961|// row, submitted at least one realm evidence object, and none is\n962|// usable (live at the admission instant and bound to the current\n963|// generation). An expired or pre-reboot realm row fails reconcile\n964|// first; the wrapper reports the §4.2 typed refusal the spec\n965|// names, with the reconcile failure as the cause. It returns nil\n966|// when the backend class stands: a caller that needs no realm\n967|// row, no submitted realm row at all, or any usable realm row.\n968|func deadRealmRefusal(input Input, evidence []terminalbackend.Evidence, cause error) error {\n969|\tif input.Realm.Caller != CallerBackground && !input.Smoke.Required {\n970|\t\treturn nil\n971|\t}\n972|\tsubmitted := false\n973|\tfor _, object := range evidence {\n974|\t\tif object.Capability != credentialRealmCapability {\n975|\t\t\tcontinue\n976|\t\t}\n977|\t\tsubmitted = true\n978|\t\tif realmRowUsable(input, object) {\n979|\t\t\treturn nil\n980|\t\t}\n981|\t}\n982|\tif !submitted {\n983|\t\treturn nil\n984|\t}\n985|\treturn realmFailure(input, cause)\n986|}\n987|\n988|// realmRowUsable classifies one parsed realm evidence object for\n989|// the refusal mapping: live at the admission instant and bound to\n990|// the AX-known raw generation. It classifies the refusal only —\n991|// the admission decision (refuse) is already made by Reconcile,\n992|// which re-proves liveness and generation on the admitted path.\n993|// This restates the reconcile liveness and generation predicate\n994|// as a stated bound, not a derivation: the aggregate Reconcile\n995|// error carries no per-object identity (liveness shares the\n996|// generic mismatch code), so no per-row usability verdict can be\n997|// read off it. The copy is classification-only and fail-closed in\n998|// both directions — it selects the refusal class, never admission.\n999|func realmRowUsable(input Input, object terminalbackend.Evidence) bool {\n1000|\tdigest, err := terminalbackend.GenerationDigest(input.Backend.RawGeneration)\n1001|\tif err != nil {\n1002|\t\treturn false\n1003|\t}\n1004|\tif object.BackendGenerationDigest != digest {\n1005|\t\treturn false\n1006|\t}\n1007|\tobserved, err := object.ObservedAt.Time()\n1008|\tif err != nil {\n1009|\t\treturn false\n1010|\t}\n1011|\texpires, err := object.ExpiresAt.Time()\n1012|\tif err != nil {\n1013|\t\treturn false\n1014|\t}\n1015|\tif observed.After(input.Backend.Now) || !input.Backend.Now.Before(expires) {\n1016|\t\treturn false\n1017|\t}\n1018|\treturn true\n1019|}\n1020|\n1021|// realmFailure composes the typed capability_unavailable refusal.\n1022|// Typed details are required members of the input: an input that\n1023|// omits one is itself malformed and refuses invalid_arguments\n1024|// instead of emitting an untyped refusal.\n1025|func realmFailure(input Input, cause error) error {\n1026|\tdetails := axerror.RealmEvidence{\n1027|\t\tCapability:           credentialRealmCapability,\n1028|\t\tCallerRealm:          input.Realm.Caller,\n1029|\t\tBrokerState:          input.Realm.BrokerState,\n1030|\t\tTmuxServerGeneration: input.Realm.ServerGeneration,\n1031|\t\tRemediation:          input.Realm.Remediation,\n1032|\t}\n1033|\tfailure, err := axerror.NewRealmEvidenceUnavailable(axerror.Version130,\n1034|\t\t\"caller has no admitted realm evidence\",\n1035|\t\taxerror.NoIDs(), details, cause)\n1036|\tif err != nil {\n1037|\t\treturn errInvalidArguments{detail: \"background caller realm details are incomplete\"}\n1038|\t}\n1039|\treturn failure\n1040|}\n1041|\n1042|// checkRealmVocabulary closes the caller vocabulary: only\n1043|// foreground and background name a caller.\n1044|func checkRealmVocabulary(caller string) error {\n1045|\tif caller != CallerForeground && caller != CallerBackground {\n1046|\t\treturn errUnknownCaller(caller)\n1047|\t}\n1048|\treturn nil\n1049|}\n1050|\n1051|// backendClass reads the Section 15 code off a terminalbackend\n1052|// refusal. Landed codes pass through verbatim.\n1053|func backendClass(err error) string {\n1054|\tvar backend *terminalbackend.Error\n1055|\tif errors.As(err, &backend) {\n1056|\t\treturn backend.Code\n1057|\t}\n1058|\treturn terminalbackend.CodeMismatch\n1059|}\n1060|\n1061|// fencingClass reads the Section 15 class off a fencing refusal:\n1062|// invalid_arguments for malformed calls, lease_conflict for\n1063|// foreign sessions and lapsed grants. Parks never reach here;\n1064|// decideParked owns them.\n1065|func fencingClass(err error) string {\n1066|\tif errors.Is(err, fencing.ErrInvalidArguments) {\n1067|\t\treturn ClassInvalidArguments\n1068|\t}\n1069|\treturn \"lease_conflict\"\n1070|}\n1071|\n1072|// providerClass reads the Structured Error code off a provhost\n1073|// refusal: invalid_config for tuple and mapping grammar, the\n1074|// provider protocol code for identity and discovery failures.\n1075|func providerClass(err error) string {\n1076|\tvar failure *axerror.Error\n1077|\tif errors.As(err, &failure) {\n1078|\t\treturn string(failure.Code())\n1079|\t}\n1080|\treturn ClassInvalidConfig\n1081|}\n1082|\n1083|// smokeClass reads the Structured Error code off a smoke refusal:\n1084|// target_auth_missing for a required smoke that fails, or\n1085|// invalid_arguments for a malformed smoke input.\n1086|func smokeClass(err error) string {\n1087|\tvar failure *axerror.Error\n1088|\tif errors.As(err, &failure) {\n1089|\t\treturn string(failure.Code())\n1090|\t}\n1091|\tvar malformed errInvalidArguments\n1092|\tif errors.As(err, &malformed) {\n1093|\t\treturn ClassInvalidArguments\n1094|\t}\n1095|\treturn \"target_auth_missing\"\n1096|}","final_result":true}}}
