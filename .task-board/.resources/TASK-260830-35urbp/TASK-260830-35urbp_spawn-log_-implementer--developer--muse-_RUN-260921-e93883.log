{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7e9","stream":{"kind":"session","id":"01a0c36e-d989-7603-9e05-f0fee9b1e516"},"sequence":591,"recorded_at":1780531400001177,"record_type":"event","durability":"durable","causation_id":"78e4a4f8-26f7-4967-82c0-c54272cc4623","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"78e4a4f8-26f7-4967-82c0-c54272cc4623","run_stream":{"kind":"run","id":"78e4a4f8-26f7-4967-82c0-c54272cc4623"},"task_stream":{"kind":"task","id":"01a0c371-2e56-7db3-9f0d-e8db24ba7865"},"task_id":"01a0c371-2e56-7db3-9f0d-e8db24ba7865","event":{"kind":"output","task_id":"01a0c371-2e56-7db3-9f0d-e8db24ba7865","chunk":"Read text file `internal/hosttrust/custody.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"io\"\n6|\t\"io/fs\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"time\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/localstore\"\n12|)\n13|\n14|const (\n15|\thostChannelDir  = \"host-channel\"\n16|\ttrustFileName   = \"trust.json\"\n17|\tlockFileName    = \"lock\"\n18|\tcredentialsDir  = \"credentials\"\n19|\tcertificateFile = \"certificate.pem\"\n20|\tprivateKeyFile  = \"private-key.pem\"\n21|\trootFile        = \"root.pem\"\n22|\tstagePrefix     = \".trust-stage-\"\n23|)\n24|\n25|// FileSystem abstracts durable writes so crash and fault paths are testable\n26|// without touching the operator disk. The OS implementation is the only\n27|// production backend.\n28|type FileSystem interface {\n29|\tCreateTemp(dir, pattern string, mode fs.FileMode) (StagedFile, error)\n30|\t// CreateExclusive atomically creates a file that must not exist: it\n31|\t// fails when the path already exists and never replaces a live file.\n32|\tCreateExclusive(path string, mode fs.FileMode) error\n33|\tReadFile(name string) ([]byte, error)\n34|\tLstat(name string) (fs.FileInfo, error)\n35|\tStat(name string) (fs.FileInfo, error)\n36|\tRemove(name string) error\n37|\tRename(oldname, newname string) error\n38|\tMkdirAll(path string, mode fs.FileMode) error\n39|\tChmod(name string, mode fs.FileMode) error\n40|\tOpenDirectory(name string) (SyncedDirectory, error)\n41|\tReadDir(name string) ([]fs.DirEntry, error)\n42|}\n43|\n44|// StagedFile is one temp staging file awaiting fsync and atomic rename.\n45|type StagedFile interface {\n46|\tio.Writer\n47|\tName() string\n48|\tChmod(fs.FileMode) error\n49|\tSync() error\n50|\tClose() error\n51|}\n52|\n53|// SyncedDirectory fsyncs a directory entry after renames.\n54|type SyncedDirectory interface {\n55|\tSync() error\n56|\tClose() error\n57|}\n58|\n59|type osFileSystem struct{}\n60|\n61|func (osFileSystem) CreateTemp(dir, pattern string, mode fs.FileMode) (StagedFile, error) {\n62|\tfile, err := os.CreateTemp(dir, pattern)\n63|\tif err != nil {\n64|\t\treturn nil, err\n65|\t}\n66|\tif err := file.Chmod(mode); err != nil {\n67|\t\t_ = file.Close()\n68|\t\t_ = os.Remove(file.Name())\n69|\t\treturn nil, err\n70|\t}\n71|\treturn file, nil\n72|}\n73|\n74|func (osFileSystem) CreateExclusive(path string, mode fs.FileMode) error {\n75|\tfile, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, mode)\n76|\tif err != nil {\n77|\t\treturn err\n78|\t}\n79|\treturn file.Close()\n80|}\n81|\n82|func (osFileSystem) ReadFile(name string) ([]byte, error)   { return os.ReadFile(name) }\n83|func (osFileSystem) Lstat(name string) (fs.FileInfo, error) { return os.Lstat(name) }\n84|func (osFileSystem) Stat(name string) (fs.FileInfo, error)  { return os.Stat(name) }\n85|func (osFileSystem) Remove(name string) error               { return os.Remove(name) }\n86|func (osFileSystem) Rename(oldname, newname string) error   { return os.Rename(oldname, newname) }\n87|\n88|func (osFileSystem) MkdirAll(path string, mode fs.FileMode) error { return os.MkdirAll(path, mode) }\n89|func (osFileSystem) Chmod(name string, mode fs.FileMode) error    { return os.Chmod(name, mode) }\n90|\n91|func (osFileSystem) OpenDirectory(name string) (SyncedDirectory, error) { return os.Open(name) }\n92|func (osFileSystem) ReadDir(name string) ([]fs.DirEntry, error)         { return os.ReadDir(name) }\n93|\n94|// Store is machine-local Host Channel authority rooted at\n95|// STATE_DIR/host-channel. The zero value is unusable; construct with Open.\n96|type Store struct {\n97|\troot       string\n98|\tconfigPath string\n99|\tpaths      localstore.ResolvedPaths\n100|\tfs         FileSystem\n101|\tlock       *fileLock\n102|}\n103|\n104|// Open validates owner-only custody of the resolved StateRoot/host-channel,\n105|// creating the\n106|// directory skeleton with exact 0700/0600 modes when absent. Every open\n107|// re-verifies custody: symlink escapes, foreign ownership and group/world\n108|// access refuse with ErrTrustUnsafeCustody.\n109|func Open(paths localstore.ResolvedPaths) (*Store, error) { return openStore(paths, osFileSystem{}) }\n110|\n111|func openStore(paths localstore.ResolvedPaths, filesystem FileSystem) (*Store, error) {\n112|\tif filesystem == nil {\n113|\t\treturn nil, trustError(TrustError{Operation: \"open store\", Err: ErrInvalidStoreContext})\n114|\t}\n115|\t_, stateDir, err := resolvedPair(paths)\n116|\tif err != nil {\n117|\t\treturn nil, err\n118|\t}\n119|\troot := filepath.Join(stateDir, hostChannelDir)\n120|\tif err := ensureOwnerDir(filesystem, root, 0o700); err != nil {\n(more lines below)","final_result":true}}}
