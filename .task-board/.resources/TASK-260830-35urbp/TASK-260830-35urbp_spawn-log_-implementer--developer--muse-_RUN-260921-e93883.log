g, ids IDs, target TargetAuth, cause error) (*Error, error) {\n206|\tdetails, err := target.Details()\n207|\tif err != nil {\n208|\t\treturn nil, err\n209|\t}\n210|\treturn New(Spec{\n211|\t\tVersion: version,\n212|\t\tCode:    \"target_auth_missing\",\n213|\t\tMessage: message,\n214|\t\tIDs:     ids,\n215|\t\tDetails: details,\n216|\t\tCause:   cause,\n217|\t})\n218|}\n219|\n220|func validateMessage(message string) error {\n221|\tif !utf8.ValidString(message) {\n222|\t\treturn fmt.Errorf(\"%w: message is not valid UTF-8\", ErrInvalidStructuredError)\n223|\t}\n224|\tcount := utf8.RuneCountInString(message)\n225|\tif count < minMessageRunes || count > maxMessageRunes {\n226|\t\treturn fmt.Errorf(\n227|\t\t\t\"%w: message is %d UTF-8 characters, the bound is %d..%d\",\n228|\t\t\tErrInvalidStructuredError, count, minMessageRunes, maxMessageRunes)\n229|\t}\n230|\treturn nil\n231|}\n232|\n233|// Version reports the Structured Error version of this object.\n234|func (failure *Error) Version() Version { return failure.version }\n235|\n236|// Code reports the stable registry code. Automation branches on this and on\n237|// ExitCode, never on Message.\n238|func (failure *Error) Code() Code { return failure.code }\n239|\n240|// Message reports the human text. It carries no machine meaning.\n241|func (failure *Error) Message() string { return failure.message }\n242|\n243|// ExitCode reports the exact Section 15.2 status carried by this object. It is\n244|// never the success status.\n245|func (failure *Error) ExitCode() int { return failure.exitCode }\n246|\n247|// Retryable reports whether the identical request may safely be retried without\n248|// new authority or confirmation. It is false for every code and exit class the\n249|// pinned document disqualifies, on both the writing and the reading side.\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c86d","stream":{"kind":"session","id":"01a0c36e-d989-7603-9e05-f0fee9b1e516"},"sequence":657,"recorded_at":1780531400001309,"record_type":"event","durability":"durable","causation_id":"78e4a4f8-26f7-4967-82c0-c54272cc4623","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"78e4a4f8-26f7-4967-82c0-c54272cc4623","run_stream":{"kind":"run","id":"78e4a4f8-26f7-4967-82c0-c54272cc4623"},"call_id":"call_01a0c37152ed75088fee5a533467e313","text":"Read text file `internal/axpane/decide.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"fmt\"\n7|\t\"time\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/matjournal\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/resumesmoke\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/sessprofile\"\n17|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n18|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n19|)\n20|\n21|// Action is exactly one wrapper outcome. Decide returns one and only\n22|// one; there is no combined or fallback outcome.\n23|type Action string\n24|\n25|const (\n26|\t// ActionLaunch starts the provider under the winning lease with\n27|\t// the validated descriptor and fencing token.\n28|\tActionLaunch Action = \"launch\"\n29|\t// ActionReattach reattaches to the one recorded wrapper/child\n30|\t// after a lost result: the bootstrap pair matches the durable\n31|\t// binding and every gate passes again.\n32|\tActionReattach Action = \"reattach\"\n33|\t// ActionAttachRemote offers remote attach: another host owns the\n34|\t// session in an interactive terminal and the attach capability\n35|\t// is admitted. It authorizes no lease mutation.\n36|\tActionAttachRemote Action = \"attach_remote\"\n37|\t// ActionTakeoverOffer offers takeover: another host owns the\n38|\t// session in an interactive terminal but remote attach is not\n39|\t// available (attach capability unproven). It starts no runtime.\n40|\t// A remote owner outside an interactive terminal parks instead\n41|\t// (§4.2 step 5: parked in all other cases).\n42|\tActionTakeoverOffer Action = \"takeover_offer\"\n43|\t// ActionParked parks without launching the provider, carrying\n44|\t// the Section 5.2 session.parked reason vocabulary.\n45|\tActionParked Action = \"parked\"\n46|\t// ActionRefused refuses: a static validation failed and there is\n47|\t// no parked direction that a state change could resolve.\n48|\tActionRefused Action = \"refused\"\n49|)\n50|\n51|// Refusal classes are the Section 15 codes the wrapper surfaces.\n52|// Landed-gate codes pass through verbatim; the wrapper mints no code.\n53|const (\n54|\t// ClassInvalidConfig reports a configuration that fails\n55|\t// validation (config.Load through ValidateConfig).\n56|\tClassInvalidConfig = \"invalid_config\"\n57|\t// ClassInvalidArguments reports a malformed wrapper call: an\n58|\t// unknown SESSION_ID, an unknown caller kind or mode, or a\n59|\t// malformed presented fencing token.\n60|\tClassInvalidArguments = \"invalid_arguments\"\n61|\t// ClassIntegrityFailure reports profile derivation input the\n62|\t// reducer refuses: the chain cannot be trusted.\n63|\tClassIntegrityFailure = \"integrity_failure\"\n64|\t// ClassProfileMappingUnavailable is the Section 2.4 resume\n65|\t// failure: the adapter cannot map the stored profile for the\n66|\t// probed provider version.\n67|\tClassProfileMappingUnavailable = \"profile_mapping_unavailable\"\n68|)\n69|\n70|// Mode selects the wrapper path: a fresh activation (the Section 4.C\n71|// create row) or the after-restore first start (the restore row). It\n72|// selects both the fencing entry and the backend capability the\n73|// admitted set must confer.\n74|type Mode string\n75|\n76|const (\n77|\t// ModeLaunch gates through fencing AuthorizeActivation and the\n78|\t// create capability dependencies.\n79|\tModeLaunch Mode = \"launch\"\n80|\t// ModeRestore gates through fencing AuthorizeRestore and the\n81|\t// restore capability dependencies.\n82|\tModeRestore Mode = \"restore\"\n83|)\n84|\n85|// Caller kinds are the closed §4.2 realm vocabulary.\n86|const (\n87|\t// CallerForeground is an interactive operator-side caller.\n88|\tCallerForeground = \"foreground\"\n89|\t// CallerBackground is a background CLI, SSH RPC process, daemon,\n90|\t// or restore worker: it must never create a\n91|\t// credential-dependent tmux server.\n92|\tCallerBackground = \"background\"\n93|)\n94|\n95|// Realm carries the §4.2 caller realm and broker readiness the\n96|// credential-conditional arm decides over. There is deliberately no\n97|// member for a cached sentinel result, a managername observation,\n98|// or any attested-server boolean: none authorizes resume, so none\n99|// is an input. A background caller, and any caller on a path that\n100|// requires provider credentials, authorizes only through the\n101|// admitted credential_capable_execution_realm Capability Evidence\n102|// row bound to the exact host binding, probed provider build, and\n103|// current generation (§4.C conditional rows, §4.2, §4.D); the bare\n104|// boolean previously carried here never authorizes and is removed.\n105|type Realm struct {\n106|\t// Caller is CallerForeground or CallerBackground.\n107|\tCaller string\n108|\t// BrokerState, ServerGeneration, and Remediation are the typed\n109|\t// realm/readiness details the capability_unavailable refusal\n110|\t// carries. They are required: an empty member refuses\n111|\t// invalid_arguments instead of emitting an untyped refusal.\n112|\t// ServerGeneration must equal the current AX-known raw\n113|\t// generation the backend admission binds to; a stale generation\n114|\t// refuses capability_unavailable, never launches.\n115|\tBrokerState      string\n116|\tServerGeneration string\n117|\tRemediation      string\n118|}\n119|\n120|// Closed capability names the wrapper's conditional arms evaluate.\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
