{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c867","stream":{"kind":"session","id":"01a0c36e-d989-7603-9e05-f0fee9b1e516"},"sequence":654,"recorded_at":1780531400001303,"record_type":"event","durability":"durable","causation_id":"78e4a4f8-26f7-4967-82c0-c54272cc4623","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"78e4a4f8-26f7-4967-82c0-c54272cc4623","run_stream":{"kind":"run","id":"78e4a4f8-26f7-4967-82c0-c54272cc4623"},"task_stream":{"kind":"task","id":"01a0c371-57eb-7762-baea-b5e3ceb9e5dc"},"task_id":"01a0c371-57eb-7762-baea-b5e3ceb9e5dc","event":{"kind":"output","task_id":"01a0c371-57eb-7762-baea-b5e3ceb9e5dc","chunk":"Read text file `internal/axerror/axerror.go`.\n(129 line(s) above)\n130|// The exit status is never taken from the caller. It is resolved through\n131|// ExitCodeFor, so the returned object's exit_code is the exact Section 15.2\n132|// status the registry assigns to the code.\n133|//\n134|// The typed-detail requirement below is asymmetric on purpose.\n135|// target_auth_missing has exactly one declared use in Section 15.3 and that\n136|// clause names its five typed details, so the generic constructor may not emit\n137|// it with a weaker detail set than NewTargetAuthMissing produces.\n138|// capability_unavailable is a general exit-6 code whose typed details Section\n139|// 15.3 names only for the realm/broker-evidence case, so requiring them from\n140|// every capability_unavailable call site would invent a constraint the pinned\n141|// document does not state; NewRealmEvidenceUnavailable carries that\n142|// requirement for the case that does declare it.\n143|func New(spec Spec) (*Error, error) {\n144|\texitCode, err := ExitCodeFor(spec.Version, spec.Code)\n145|\tif err != nil {\n146|\t\treturn nil, err\n147|\t}\n148|\tif err := validateMessage(spec.Message); err != nil {\n149|\t\treturn nil, err\n150|\t}\n151|\tif err := ValidateDetails(spec.Details); err != nil {\n152|\t\treturn nil, err\n153|\t}\n154|\tif spec.Code == \"target_auth_missing\" {\n155|\t\tif err := requireDetailKeys(spec.Code, spec.Details, targetAuthMissingKeys); err != nil {\n156|\t\t\treturn nil, err\n157|\t\t}\n158|\t}\n159|\tif spec.Retryable {\n160|\t\tif reason, forbidden := RetryabilityRefusal(spec.Code, exitCode); forbidden {\n161|\t\t\treturn nil, fmt.Errorf(\n162|\t\t\t\t\"%w: %q may not claim retryable: %s\", ErrInvalidStructuredError, spec.Code, reason)\n163|\t\t}\n164|\t}\n165|\tif err := refuseCausalLeak(spec.Message, spec.Details, spec.Cause); err != nil {\n166|\t\treturn nil, err\n167|\t}\n168|\treturn &Error{\n169|\t\tversion:        spec.Version,\n170|\t\tcode:           spec.Code,\n171|\t\tmessage:        spec.Message,\n172|\t\texitCode:       exitCode,\n173|\t\tretryable:      spec.Retryable,\n174|\t\tids:            spec.IDs,\n175|\t\tdetails:        cloneDetails(spec.Details),\n176|\t\tcause:          spec.Cause,\n177|\t\tcodeRegistered: true,\n178|\t}, nil\n179|}\n180|\n181|// NewRealmEvidenceUnavailable builds the Section 15.3 capability_unavailable\n182|// failure for missing or unsafe broker, tmux server generation, or\n183|// functional-sentinel evidence, with the exact typed details that clause names.\n184|// It exists so that the realm case cannot be reported with an untyped detail\n185|// map, and so that no realm-specific code is minted while capability_unavailable\n186|// remains truthful.\n187|func NewRealmEvidenceUnavailable(version Version, message string, ids IDs, evidence RealmEvidence, cause error) (*Error, error) {\n188|\tdetails, err := evidence.Details()\n189|\tif err != nil {\n190|\t\treturn nil, err\n191|\t}\n192|\treturn New(Spec{\n193|\t\tVersion: version,\n194|\t\tCode:    \"capability_unavailable\",\n195|\t\tMessage: message,\n196|\t\tIDs:     ids,\n197|\t\tDetails: details,\n198|\t\tCause:   cause,\n199|\t})\n200|}\n201|\n202|// NewTargetAuthMissing builds the Section 15.3 target_auth_missing failure for\n203|// a missing or failed provider-auth smoke, with the exact typed details that\n204|// clause names.\n205|func NewTargetAuthMissing(version Version, message string, ids IDs, target TargetAuth, cause error) (*Error, error) {\n206|\tdetails, err := target.Details()\n207|\tif err != nil {\n208|\t\treturn nil, err\n209|\t}\n210|\treturn New(Spec{\n211|\t\tVersion: version,\n212|\t\tCode:    \"target_auth_missing\",\n213|\t\tMessage: message,\n214|\t\tIDs:     ids,\n215|\t\tDetails: details,\n216|\t\tCause:   cause,\n217|\t})\n218|}\n219|\n220|func validateMessage(message string) error {\n221|\tif !utf8.ValidString(message) {\n222|\t\treturn fmt.Errorf(\"%w: message is not valid UTF-8\", ErrInvalidStructuredError)\n223|\t}\n224|\tcount := utf8.RuneCountInString(message)\n225|\tif count < minMessageRunes || count > maxMessageRunes {\n226|\t\treturn fmt.Errorf(\n227|\t\t\t\"%w: message is %d UTF-8 characters, the bound is %d..%d\",\n228|\t\t\tErrInvalidStructuredError, count, minMessageRunes, maxMessageRunes)\n229|\t}\n230|\treturn nil\n231|}\n232|\n233|// Version reports the Structured Error version of this object.\n234|func (failure *Error) Version() Version { return failure.version }\n235|\n236|// Code reports the stable registry code. Automation branches on this and on\n237|// ExitCode, never on Message.\n238|func (failure *Error) Code() Code { return failure.code }\n239|\n240|// Message reports the human text. It carries no machine meaning.\n241|func (failure *Error) Message() string { return failure.message }\n242|\n243|// ExitCode reports the exact Section 15.2 status carried by this object. It is\n244|// never the success status.\n245|func (failure *Error) ExitCode() int { return failure.exitCode }\n246|\n247|// Retryable reports whether the identical request may safely be retried without\n248|// new authority or confirmation. It is false for every code and exit class the\n249|// pinned document disqualifies, on both the writing and the reading side.\n(more lines below)","final_result":true}}}
