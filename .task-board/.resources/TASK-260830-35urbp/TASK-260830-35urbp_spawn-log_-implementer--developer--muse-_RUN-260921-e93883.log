{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d1c9","stream":{"kind":"session","id":"01a0c36e-d989-7603-9e05-f0fee9b1e516"},"sequence":1855,"recorded_at":1780531400003705,"record_type":"event","durability":"durable","causation_id":"78e4a4f8-26f7-4967-82c0-c54272cc4623","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"78e4a4f8-26f7-4967-82c0-c54272cc4623","run_stream":{"kind":"run","id":"78e4a4f8-26f7-4967-82c0-c54272cc4623"},"task_stream":{"kind":"task","id":"01a0c37c-1356-7803-87c1-301664962837"},"task_id":"01a0c37c-1356-7803-87c1-301664962837","event":{"kind":"output","task_id":"01a0c37c-1356-7803-87c1-301664962837","chunk":"Read text file `internal/termbind/mutant_harness.py`.\n(438 line(s) above)\n439|\n440|\n441|def apply(mutant: Mutant, original: str) -> str:\n442|    patched = original.replace(mutant.find, mutant.replace)\n443|    if mutant.find2:\n444|        patched = patched.replace(mutant.find2, mutant.replace2)\n445|    return patched\n446|\n447|\n448|def run_mutant(mutant: Mutant) -> str:\n449|    target = REPO / mutant.path\n450|    original = target.read_text()\n451|    found = original.count(mutant.find)\n452|    if found != mutant.count:\n453|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\"\n454|    if mutant.find2:\n455|        found2 = original.count(mutant.find2)\n456|        if found2 != mutant.count2:\n457|            return f\"ERROR: {mutant.name}: second anchors {found2}, want {mutant.count2}\"\n458|    with tempfile.TemporaryDirectory() as staging:\n459|        backup = Path(staging) / \"backup\"\n460|        shutil.copy2(target, backup)\n461|        try:\n462|            target.write_text(apply(mutant, original))\n463|            run = subprocess.run(\n464|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n465|                cwd=REPO,\n466|                capture_output=True,\n467|                text=True,\n468|                timeout=300,\n469|            )\n470|        finally:\n471|            shutil.copy2(backup, target)\n472|    output = (run.stdout + run.stderr).strip()\n473|    if os.environ.get(\"AX_MUTANT_VERBOSE\") == \"1\":\n474|        print(f\"--- raw: {mutant.name}: exit {run.returncode} ---\", flush=True)\n475|        print(output, flush=True)\n476|        print(f\"--- end raw: {mutant.name} ---\", flush=True)\n477|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n478|        return f\"ERROR: {mutant.name}: build broke under the patch\"\n479|    if run.returncode == 0:\n480|        verdict = \"SURVIVED\"\n481|    elif '--- FAIL' in output or 'FAIL:' in output:\n482|        verdict = \"KILLED\"\n483|    else:\n484|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\"\n485|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n486|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note} [exit {run.returncode}]\"\n487|\n488|\n489|def main(argv: list[str]) -> int:\n490|    selected = [m for m in MUTANTS if not argv or m.name in argv]\n491|    if argv and len(selected) != len(argv):\n492|        unknown = sorted(set(argv) - {m.name for m in selected})\n493|        print(f\"unknown mutants: {', '.join(unknown)}\")\n494|        return 2\n495|    failures = 0\n496|    for mutant in selected:\n497|        try:\n498|            line = run_mutant(mutant)\n499|        except subprocess.TimeoutExpired:\n500|            line = f\"ERROR: {mutant.name}: killer timed out\"\n501|        print(line, flush=True)\n502|        if not line.startswith(\"ok:\"):\n503|            failures += 1\n504|    return 1 if failures else 0\n505|\n506|\n507|if __name__ == \"__main__\":\n508|    sys.exit(main(sys.argv[1:]))","final_result":true}}}
