ne interrupted joint config-plus-trust commit, if any: a\n156|\t// crash between the configuration replacement and the generation bump\n157|\t// must complete forward or abort on restart, never admit the new\n158|\t// configuration with the old generation. A refused recovery fails the\n159|\t// open so incoherent state cannot be used.\n160|\tif _, err := store.Recover(); err != nil {\n161|\t\treturn nil, err\n162|\t}\n163|\treturn store, nil\n164|}\n165|\n166|// Root reports the validated host-channel directory. It carries no secrets.\n167|func (store *Store) Root() string { return store.root }\n168|\n169|// EnsureConfigBinding establishes the one immutable configuration association\n170|// for this machine-local store. It is an explicit bootstrap operation, not a\n171|// constructor shortcut: the binding is persisted atomically under the same\n172|// exclusive lock used by trust mutations, and a later request for another\n173|// path refuses. The configuration-side StateRoot is checked in the same\n174|// operation, so a foreign store cannot bind itself to a target document even\n175|// when the caller supplies that document's path. Callers that only need\n176|// credential custody may leave a store unbound; pair readers and writers\n177|// require this association.\n178|func (store *Store) EnsureConfigBinding(paths localstore.ResolvedPaths) error {\n179|\tconfigPath, _, err := store.validateResolvedPair(paths)\n180|\tif err != nil {\n181|\t\treturn err\n182|\t}\n183|\tif _, err := canonicalExistingPath(configPath); err != nil {\n184|\t\treturn trustError(TrustError{Operation: \"establish configuration binding\", Err: errors.Join(ErrInvalidStoreContext, err)})\n185|\t}\n186|\thold, unlock, err := store.lock.exclusiveHold()\n187|\tif err != nil {\n188|\t\treturn trustError(TrustError{Operation: \"lock configuration binding\", Err: errors.Join(ErrTrustDurability, err)})\n189|\t}\n190|\tdefer unlock()\n191|\tif err := store.convergeLocked(hold); err != nil {\n192|\t\treturn err\n193|\t}\n194|\t_, err = store.ensureConfigBindingLocked(hold, paths)\n195|\treturn err\n196|}\n197|\n198|// ValidateBoundConfigPath checks the durable binding and the current target\n199|// identity. It takes a shared lock so a caller cannot validate against a\n200|// deleted or malformed sidecar and then proceed as if the association still\n201|// existed. The in-hold pair writers perform the same check through the opaque\n202|// HeldExclusive capability immediately before mutation.\n203|func (store *Store) ValidateBoundConfigPath(paths localstore.ResolvedPaths) error {\n204|\tif _, _, err := store.validateResolvedPair(paths); err != nil {\n205|\t\treturn err\n206|\t}\n207|\tunlock, err := store.lock.shared()\n208|\tif err != nil {\n209|\t\treturn trustError(TrustError{Operation: \"read configuration binding\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n210|\t}\n211|\tdefer unlock()\n212|\treturn store.validateBoundConfigPathLocked(paths)\n213|}\n214|\n215|func (store *Store) validateBoundConfigPathLocked(paths localstore.ResolvedPaths) error {\n216|\tif _, _, err := store.validateResolvedPair(paths); err != nil {\n217|\t\treturn err\n218|\t}\n219|\tcanonical, err := canonicalResolvedConfigPath(paths)\n220|\tif err != nil {\n221|\t\treturn trustError(TrustError{Operation: \"validate configuration binding\", Err: ErrExclusiveHoldResourceMismatch})\n222|\t}\n223|\tbinding, present, err := loadTargetConfigBinding(store.fs, canonical)\n224|\tif err != nil {\n225|\t\treturn err\n226|\t}\n227|\tif !present {\n228|\t\treturn trustError(TrustError{Operation: \"validate configuration binding\", Err: ErrExclusiveHoldResourceMismatch})\n229|\t}\n230|\tif err := validateBindingForStore(binding, canonical, store.root); err != nil {\n231|\t\treturn trustError(TrustError{Operation: \"validate configuration binding\", Err: ErrExclusiveHoldResourceMismatch})\n232|\t}\n233|\treturn nil\n234|}\n235|\n236|// ValidateBoundPaths is the coherent-read association check. The resolved\n237|// pair must be the exact pair with which this Store was opened, and the\n238|// durable target-side binding must still name both that config target and the\n239|// store's state root.\n240|func (store *Store) ValidateBoundPaths(paths localstore.ResolvedPaths) error {\n241|\treturn store.ValidateBoundConfigPath(paths)\n242|}\n243|\n244|// TrustPath reports the trust.json path for operator diagnostics. Reading or\n245|// writing it directly bypasses the authorization lock; use transactions.\n246|func (store *Store) TrustPath() string { return filepath.Join(store.root, trustFileName) }\n247|\n248|// PendingCommitPath reports the pending-commit.json path for operator\n249|// diagnostics. A marker left here after a crash converges automatically on\n250|// the next converged read; a marker that refuses convergence needs\n251|// operator resolution and must never be deleted blindly.\n252|func (store *Store) PendingCommitPath() string { return pendingPath(store.root) }\n253|\n254|// CredentialDir reports the custody directory for one credential ID hex. It\n255|// carries no key material.\n256|func (store *Store) CredentialDir(credentialHex string) (string, error) {\n257|\tif len(credentialHex) != 64 {\n258|\t\treturn \"\", trustError(TrustError{Operation: \"resolve credential directory\", Err: ErrCredentialCustody})\n259|\t}\n260|\tfor _, unit := range credentialHex {\n261|\t\tif (unit < '0' || unit > '9') && (unit < 'a' || unit > 'f') {\n262|\t\t\treturn \"\", trustError(TrustError{Operation: \"resolve credential directory\", Err: ErrCredentialCustody})\n263|\t\t}\n264|\t}\n265|\treturn filepath.Join(store.root, credentialsDir, credentialHex), nil\n266|}\n267|\n268|func ensureOwnerDir(filesystem FileSystem, path string, mode fs.FileMode) error {\n269|\tinfo, err := filesystem.Lstat(path)\n270|\tif err != nil && !os.IsNotExist(err) {\n271|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n272|\t}\n273|\tif err == nil {\n274|\t\t// An existing directory is verified, never repaired: silently\n275|\t\t// narrowing a widened directory would mask the custody violation.\n276|\t\treturn verifyOwnerDir(path, info, mode)\n277|\t}\n278|\tif err := filesystem.MkdirAll(path, mode); err != nil {\n279|\t\treturn trustError(TrustError{Operation: \"create directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n280|\t}\n281|\t// MkdirAll honors umask, so the exact owner-only mode is enforced\n282|\t// explicitly after creation.\n283|\tif err := filesystem.Chmod(path, mode); err != nil {\n284|\t\treturn trustError(TrustError{Operation: \"create directory\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n285|\t}\n286|\t// On platforms where mode bits do not govern access, install the\n287|\t// owner-only ACL at creation: verification below would otherwise\n288|\t// refuse the directory the store just created.\n289|\tif err := secureStaged(path, true); err != nil {\n290|\t\treturn err\n291|\t}\n292|\tinfo, err = filesystem.Lstat(path)\n293|\tif err != nil {\n294|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n295|\t}\n296|\treturn verifyOwnerDir(path, info, mode)\n297|}\n298|\n299|func verifyOwnerDir(path string, info fs.FileInfo, mode fs.FileMode) error {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
