{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c89f","stream":{"kind":"session","id":"01a0c36e-d989-7603-9e05-f0fee9b1e516"},"sequence":682,"recorded_at":1780531400001359,"record_type":"event","durability":"durable","causation_id":"78e4a4f8-26f7-4967-82c0-c54272cc4623","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"78e4a4f8-26f7-4967-82c0-c54272cc4623","run_stream":{"kind":"run","id":"78e4a4f8-26f7-4967-82c0-c54272cc4623"},"task_stream":{"kind":"task","id":"01a0c371-69f2-7273-b136-e4b87b13911e"},"task_id":"01a0c371-69f2-7273-b136-e4b87b13911e","event":{"kind":"output","task_id":"01a0c371-69f2-7273-b136-e4b87b13911e","chunk":"Read text file `internal/axerror/details.go`.\n1|package axerror\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"fmt\"\n7|\t\"regexp\"\n8|\t\"sort\"\n9|\t\"strings\"\n10|\t\"unicode/utf8\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n13|)\n14|\n15|// Details is the Section 15.1 diagnostic data map. The pinned document calls it\n16|// \"an explicitly open diagnostic data map, not an implicit schema extension\":\n17|// unknown keys are admitted as inert data, and nothing in this package derives\n18|// success, authority, or a remediation action from them.\n19|type Details map[string]any\n20|\n21|var (\n22|\t// ErrInvalidDetails reports a diagnostic map outside the Section 15.1\n23|\t// shape, bounds, or redaction rules.\n24|\tErrInvalidDetails = errors.New(\"invalid structured error details\")\n25|\n26|\t// ErrCausalLeak reports human text or a diagnostic value that reproduces\n27|\t// the rendered text of the Go cause the failure was built from. The cause\n28|\t// chain stays local; it is never copied onto the wire.\n29|\tErrCausalLeak = errors.New(\"structured error would carry its cause onto the wire\")\n30|)\n31|\n32|// detailKeyPattern is the Section 15.1 constraint on detail keys, verbatim:\n33|// \"0-64 keys matching [a-z][a-z0-9_]{0,63}\".\n34|var detailKeyPattern = regexp.MustCompile(`^[a-z][a-z0-9_]{0,63}$`)\n35|\n36|const (\n37|\tmaxDetailKeys      = 64\n38|\tmaxDetailDepth     = 4\n39|\tmaxDetailCanonical = 16 * 1024\n40|\tminRedactableCause = 8\n41|\tmaxMessageRunes    = 4096\n42|\tminMessageRunes    = 1\n43|)\n44|\n45|// excludedDetailKeys is the best-effort scanner Section 16.2 says an\n46|// implementation SHOULD offer. It refuses a detail key that names one of the\n47|// four classes Section 15.1 forbids outright — \"No detail may contain a\n48|// credential, raw transcript, environment secret, or opaque bundle content\" —\n49|// and nothing else.\n50|//\n51|// Matching is exact, never by substring, and that is deliberate. A substring\n52|// rule refusing every key containing \"token\", \"socket\" or \"credential\" would\n53|// refuse \"token_count\", \"socket_timeout_ms\" and \"credential_profile\" — ordinary\n54|// diagnostics the specification admits — while still passing a secret written\n55|// under an innocuous name. That is pure false-positive surface with no\n56|// true-positive capability, and it is the exact defect removed from the\n57|// Configuration extension-key validator: where the pinned document is silent\n58|// about a name, be permissive.\n59|//\n60|// The list is also scoped to Section 15.1's four classes rather than to the\n61|// whole Section 16.2 exclusion table. Section 16.2 governs manifests and\n62|// bundles generated by ax; a diagnostic key naming a PID, a tmux socket or a\n63|// Terminal Instance Binding is not a credential, a transcript, an environment\n64|// secret, or bundle content, and refusing it here would invent a constraint the\n65|// error contract does not state.\n66|var excludedDetailKeys = map[string]string{\n67|\t// Credential.\n68|\t\"access_token\":       \"credential\",\n69|\t\"api_key\":            \"credential\",\n70|\t\"auth_json\":          \"credential\",\n71|\t\"cookie\":             \"credential\",\n72|\t\"cookies\":            \"credential\",\n73|\t\"credential\":         \"credential\",\n74|\t\"credentials\":        \"credential\",\n75|\t\"oauth_token\":        \"credential\",\n76|\t\"passphrase\":         \"credential\",\n77|\t\"password\":           \"credential\",\n78|\t\"private_key\":        \"credential\",\n79|\t\"refresh_token\":      \"credential\",\n80|\t\"session_token\":      \"credential\",\n(more lines below)","final_result":true}}}
