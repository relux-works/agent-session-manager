ng) Ambient { return Ambient{ConventionalName: derived} }},\n581|\t} {\n582|\t\tt.Run(tc.name, func(t *testing.T) {\n583|\t\t\troot := runtimeRoot(t)\n584|\t\t\tdir := socketDir(t, root)\n585|\t\t\treq := validRequest(t, root)\n586|\t\t\treq.Ambient = tc.ambient(SocketPath(dir))\n587|\t\t\tspy := &spawnSpy{}\n588|\t\t\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n589|\t\t\t\treturn ServerReport{}, nil\n590|\t\t\t}\n591|\t\t\treq.Deps.Spawn = spy.spawn\n592|\t\t\t_, err := Acquire(req)\n593|\t\t\trequireLocalError(t, err, \"tmux_ambient_server_reuse\", \"ambient collision\")\n594|\t\t\tif spy.calls != 0 {\n595|\t\t\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n596|\t\t\t}\n597|\t\t})\n598|\t}\n599|}\n600|\n601|// The background path verifies custody through VerifyRuntimeDir, so a\n602|// non-directory leaf refuses through the entry before any broker\n603|// contact: the verify-side O_DIRECTORY refusal driven at the entry the\n604|// background path uses.\n605|func TestAcquireBackgroundRefusesNonDirectoryLeaf(t *testing.T) {\n606|\troot := runtimeRoot(t)\n607|\tleaf := filepath.Join(root, RuntimeDirName)\n608|\tif err := os.WriteFile(leaf, []byte(\"x\"), 0o700); err != nil {\n609|\t\tt.Fatal(err)\n610|\t}\n611|\treq := validRequest(t, root)\n612|\treq.Caller = CallerBackground\n613|\tprobed := false\n614|\tspy := &spawnSpy{}\n615|\treq.Deps.Spawn = spy.spawn\n616|\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n617|\t\tprobed = true\n618|\t\treturn brokerReport(), nil\n619|\t}\n620|\t_, err := Acquire(req)\n621|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n622|\tif probed {\n623|\t\tt.Fatal(\"broker was probed past a non-directory leaf\")\n624|\t}\n625|\tif spy.calls != 0 {\n626|\t\tt.Fatalf(\"spawn calls = %d, want 0 past a non-directory leaf\", spy.calls)\n627|\t}\n628|}\n629|\n630|// An unclean spelling of the derived socket refuses through the entry\n631|// with no spawn: the cleaned-spell