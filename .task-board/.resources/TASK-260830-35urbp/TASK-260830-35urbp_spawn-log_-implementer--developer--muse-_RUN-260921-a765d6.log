{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7ff","stream":{"kind":"session","id":"01a0c54c-0ef4-78b3-96e2-4f10155428e6"},"sequence":602,"recorded_at":1780531400001199,"record_type":"event","durability":"durable","causation_id":"a845ab6a-f3a6-48e7-a9d4-e4e3621097f9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a845ab6a-f3a6-48e7-a9d4-e4e3621097f9","run_stream":{"kind":"run","id":"a845ab6a-f3a6-48e7-a9d4-e4e3621097f9"},"task_stream":{"kind":"task","id":"01a0c54e-fca9-7c62-b075-cfa924bf968e"},"task_id":"01a0c54e-fca9-7c62-b075-cfa924bf968e","event":{"kind":"output","task_id":"01a0c54e-fca9-7c62-b075-cfa924bf968e","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-2t4g7i/worktree/internal/tmuxserver/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for internal/tmuxserver.\n3|\n4|Every gate ships a narrowing mutant: the gate stays present and is\n5|weakened to admit exactly one member of the class it must reject, and\n6|the named killer tests must fail. A delete-only mutant proves only that\n7|the gate exists and is not accepted as evidence; row D-background-fallback\n8|is the one explicitly supplementary additive plant (the reviewer-shaped\n9|direct-creation call on the background path), labeled as such and not\n10|counted as any gate's narrowing.\n11|\n12|Each row runs M (mutate production files in place), R (run the scoped Go\n13|killers through the production entries), V (verdict from the Go exit code\n14|plus a FAIL kill-line: KILLED iff R fails with a test failure line,\n15|SURVIVED iff R passes, ERROR for anything else -- unapplied patches,\n16|build breaks, timeouts). M failures and R infrastructure errors are\n17|ERROR, never kills or survivals. Files are restored from backups after\n18|every row, pass or fail.\n19|\n20|Row C-control is the harmless control: a comment-only edit that must\n21|SURVIVE, proving the harness observes test outcomes instead of\n22|hard-coding kills.\n23|\n24|Usage:\n25|  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py\n26|  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py N-mode-create\n27|  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py --log-dir /tmp/mutant-logs\n28|  AX_MUTANT_VERBOSE=1 PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py N-mode-create\n29|\"\"\"\n30|\n31|import os\n32|import shutil\n33|import subprocess\n34|import sys\n35|import tempfile\n36|from dataclasses import dataclass\n37|from pathlib import Path\n38|\n39|REPO = Path(__file__).resolve().parents[2]\n40|PACKAGE = \"internal/tmuxserver\"\n41|\n42|\n43|@dataclass(frozen=True)\n44|class Mutant:\n45|    name: str\n46|    path: str\n47|    find: str\n48|    replace: str\n49|    count: int\n50|    run: str\n51|    expect: str\n52|    note: str\n53|\n54|\n55|BG_MISS = \"TestAcquireBackgroundMissReturnsTypedUnavailable\"\n56|BG_MISS_LINUX = \"(TestAcquireBackgroundMissReturnsTypedUnavailable|TestAcquireBackgroundMissOnLinuxAlsoRefusesWithoutFallback)\"\n57|OVERRIDE = \"TestAcquireRefusesEveryAmbientOverrideVector\"\n58|WIDENED = \"TestEnsureRuntimeDirRefusesWidenedMode\"\n59|COLLISION = \"(TestResolveSocketRefusesAmbientCollision|TestAcquireRefusesAmbientCollision)\"\n60|\n61|MUTANTS = [\n62|    Mutant(\n63|        name=\"N-mode-create\",\n64|        path=f\"{PACKAGE}/runtime_unix.go\",\n65|        find=\"\\t// leaf above; the mode comparison below is the load-bearing\\n\\t// arm this gate's tests and mutants pin.\\n\\tif info.Mode().Perm() != 0o700 {\\n\",\n66|        replace=\"\\t// leaf above; the mode comparison below is the load-bearing\\n\\t// arm this gate's tests and mutants pin.\\n\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o755 {\\n\",\n67|        count=1,\n68|        run=WIDENED,\n69|        expect=\"KILLED\",\n70|        note=\"Admits exactly 0755 at the create-path mode arm; other widened modes still refuse. Kill path: Ensure stops refusing.\",\n71|    ),\n72|    Mutant(\n73|        name=\"N-mode-verify\",\n74|        path=f\"{PACKAGE}/runtime_unix.go\",\n75|        find='\\tinfo, err := leaf.Stat()\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\\n\\t}\\n\\tif info.Mode().Perm() != 0o700 {\\n',\n76|        replace='\\tinfo, err := leaf.Stat()\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\\n\\t}\\n\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o755 {\\n',\n77|        count=1,\n78|        run=WIDENED,\n79|        expect=\"KILLED\",\n80|        note=\"Admits exactly 0755 at the verify-path mode arm; the create arm still refuses. Kill path: Verify stops refusing.\",\n81|    ),\n82|    Mutant(\n83|        name=\"N-mode-narrower-create\",\n84|        path=f\"{PACKAGE}/runtime_unix.go\",\n85|        find=\"\\t// leaf above; the mode comparison below is the load-bearing\\n\\t// arm this gate's tests and mutants pin.\\n\\tif info.Mode().Perm() != 0o700 {\\n\",\n86|        replace=\"\\t// leaf above; the mode comparison below is the load-bearing\\n\\t// arm this gate's tests and mutants pin.\\n\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o600 {\\n\",\n87|        count=1,\n88|        run=\"TestEnsureRuntimeDirRefusesNarrowerMode\",\n89|        expect=\"KILLED\",\n90|        note=\"Admits exactly a 0600 leaf at the create-path mode arm; every other non-0700 mode (widened and narrower) still refuses. Kill path: Ensure stops refusing the 0600 fixture.\",\n91|    ),\n92|    Mutant(\n93|        name=\"N-mode-narrower-verify\",\n94|        path=f\"{PACKAGE}/runtime_unix.go\",\n95|        find='\\tinfo, err := leaf.Stat()\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\\n\\t}\\n\\tif info.Mode().Perm() != 0o700 {\\n',\n96|        replace='\\tinfo, err := leaf.Stat()\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\\n\\t}\\n\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o600 {\\n',\n97|        count=1,\n98|        run=\"TestEnsureRuntimeDirRefusesNarrowerMode\",\n99|        expect=\"KILLED\",\n100|        note=\"Admits exactly a 0600 leaf at the verify-path mode arm; the create arm still refuses, so the kill comes from the Verify leg of the narrower-mode test. Narrower 0500 still refuses on both arms.\",\n101|    ),\n102|    Mutant(\n103|        name=\"N-fchmod-umask\",\n104|        path=f\"{PACKAGE}/runtime_unix.go\",\n105|        find=\"\\tif created {\\n\",\n106|        replace=\"\\tif created && os.Geteuid() == 0 {\\n\",\n107|        count=1,\n108|        run=\"TestEnsureRuntimeDirEnforcesModeUnderRestrictiveUmask\",\n109|        expect=\"KILLED\",\n110|        note=\"Admits exactly non-root creates past the explicit post-mkdirat chmod; root creates still chmod. Kill path: under umask 0177 the leaf stays 0600 and the mode gate refuses. Non-root load-bearing, like the same-shaped reviewer plant.\",\n111|    ),\n112|    Mutant(\n113|        name=\"N-ownership-uid\",\n114|        path=f\"{PACKAGE}/ownership_unix.go\",\n115|        find=\"\\tif stat.Uid != uint32(effectiveUID()) {\\n\",\n116|        replace=\"\\tif stat.Uid != uint32(effectiveUID()) && stat.Uid != uint32(effectiveUID())-100000 {\\n\",\n117|        count=1,\n118|        run=\"TestEnsureRuntimeDirRefusesForeignOwnership\",\n119|        expect=\"KILLED\",\n120|        note=\"Admits exactly the seam-shifted foreign UID; every other foreign UID still refuses.\",\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c801","stream":{"kind":"session","id":"01a0c54c-0ef4-78b3-96e2-4f10155428e6"},"sequence":603,"recorded_at":1780531400001201,"record_type":"event","durability":"durable","causation_id":"a845ab6a-f3a6-48e7-a9d4-e4e3621097f9","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a845ab6a-f3a6-48e7-a9d4-e4e3621097f9","run_stream":{"kind":"run","id":"a845ab6a-f3a6-48e7-a9d4-e4e3621097f9"},"task_stream":{"kind":"task","id":"01a0c54e-fca9-7c62-b075-cfa924bf968e"},"task_id":"01a0c54e-fca9-7c62-b075-cfa924bf968e","event":{"kind":"completed","task_id":"01a0c54e-fca9-7c62-b075-cfa924bf968e"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c803","stream":{"kind":"session","id":"01a0c54c-0ef4-78b3-96e2-4f10155428e6"},"sequence":604,"recorded_at":1780531400001203,"record_type":"event","durability":"durable","causation_id":"a845ab6a-f3a6-48e7-a9d4-e4e3621097f9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a845ab6a-f3a6-48e7-a9d4-e4e3621097f9","run_stream":{"kind":"run","id":"a845ab6a-f3a6-48e7-a9d4-e4e3621097f9"},"task_stream":{"kind":"task","id":"01a0c54e-fcd4-7f32-8e83-a13552660e43"},"task_id":"01a0c54e-fcd4-7f32-8e83-a13552660e43","event":{"kind":"output","task_id":"01a0c54e-fcd4-7f32-8e83-a13552660e43","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-2t4g7i/worktree/internal/tmuxserver/mutant_harness.py`.\n(589 line(s) above)\n590|        note=\"Admits exactly EACCES past the exists-check (a permission failure is treated as an existing leaf); every other mkdir failure still reports the commit detail. Kill reroutes to the runtime-absent refusal — still fail-closed, hence a detail mismatch, not an admission.\",\n591|    ),\n592|    Mutant(\n593|        name=\"N-override-whitespace\",\n594|        path=f\"{PACKAGE}/socket.go\",\n595|        find='\\tif override != \"\" {\\n',\n596|        replace='\\tif override != \"\" && override != \"  \" {\\n',\n597|        count=1,\n598|        run=f\"{OVERRIDE}/whitespace_only\",\n599|        expect=\"KILLED\",\n600|        note=\"Admits exactly the two-space override past the non-empty arm; every other override still refuses. Kill path: the admitted request proceeds to spawn instead of refusing.\",\n601|    ),\n602|    Mutant(\n603|        name=\"N-root-missing-classify\",\n604|        path=f\"{PACKAGE}/runtime_unix.go\",\n605|        find='func classifyRootOpenError(err error) error {\\n\\tif os.IsNotExist(err) || errors.Is(err, os.ErrNotExist) {\\n\\t\\treturn &Error{Code: CodeInvalidArguments, Detail: \"runtime root\"}\\n\\t}\\n\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\\n}\\n',\n606|        replace='func classifyRootOpenError(err error) error {\\n\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\\n}\\n',\n607|        count=1,\n608|        run=\"(TestEnsureRuntimeDirRefusesBadRoots|TestVerifyRuntimeDirRefusesMissingRoot)\",\n609|        expect=\"KILLED\",\n610|        note=\"Admits exactly missing roots past the shared invalid-arguments mapping (they report containment); every other root-open failure still refuses containment. One site, both entries: killed by the missing-root tests on the commit and verify sides.\",\n611|    ),\n612|    Mutant(\n613|        name=\"D-background-fallback\",\n614|        path=f\"{PACKAGE}/acquire.go\",\n615|        find=\"\\t\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\n\\t\\t\\treturn Outcome{}, backgroundUnavailable(req, err)\\n\\t\\t}\\n\",\n616|        replace=\"\\t\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\n\\t\\t\\tif req.Deps.Spawn != nil {\\n\\t\\t\\t\\t_ = req.Deps.Spawn(socket, nil)\\n\\t\\t\\t}\\n\\t\\t\\treturn Outcome{}, backgroundUnavailable(req, err)\\n\\t\\t}\\n\",\n617|        count=1,\n618|        run=BG_MISS_LINUX,\n619|        expect=\"KILLED\",\n620|        note=\"SUPPLEMENTARY ADDITIVE, not a narrowing: plants the reviewer-shaped direct-creation call on the background miss path. Kill path: every background-miss spy asserts zero spawn calls.\",\n621|    ),\n622|    Mutant(\n623|        name=\"C-control\",\n624|        path=f\"{PACKAGE}/errors.go\",\n625|        find=\"// Error is a package-local refusal. Code is one of the Code*\",\n626|        replace=\"// Error is a package-local refusal (harness control: comment-only). Code is one of the Code*\",\n627|        count=1,\n628|        run=\"TestSocketPathDerivesOnlyFromRuntimeDir\",\n629|        expect=\"SURVIVED\",\n630|        note=\"Harmless control: a comment-only edit that must SURVIVE, proving the harness observes outcomes.\",\n631|    ),\n632|]\n633|\n634|\n635|def apply(mutant: Mutant, original: str) -> str:\n636|    return original.replace(mutant.find, mutant.replace)\n637|\n638|\n639|def run_mutant(mutant: Mutant, log_dir: Path | None) -> str:\n640|    target = REPO / mutant.path\n641|    original = target.read_text()\n642|    found = original.count(mutant.find)\n643|    if found != mutant.count:\n644|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\"\n645|    with tempfile.TemporaryDirectory() as staging:\n646|        backup = Path(staging) / \"backup\"\n647|        shutil.copy2(target, backup)\n648|        try:\n649|            target.write_text(apply(mutant, original))\n650|            run = subprocess.run(\n651|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n652|                cwd=REPO,\n653|                capture_output=True,\n654|                text=True,\n655|                timeout=300,\n656|            )\n657|        finally:\n658|            shutil.copy2(backup, target)\n659|    output = (run.stdout + run.stderr).strip()\n660|    if os.environ.get(\"AX_MUTANT_VERBOSE\") == \"1\":\n661|        print(f\"--- raw: {mutant.name}: exit {run.returncode} ---\", flush=True)\n662|        print(output, flush=True)\n663|        print(f\"--- end raw: {mutant.name} ---\", flush=True)\n664|    if log_dir is not None:\n665|        (log_dir / f\"{mutant.name}.log\").write_text(\n666|            f\"exit: {run.returncode}\\nrun: go test ./{PACKAGE}/ -run {mutant.run} -count=1\\n\\n{output}\\n\"\n667|        )\n668|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n669|        return f\"ERROR: {mutant.name}: build broke under the patch\"\n670|    if run.returncode == 0:\n671|        verdict = \"SURVIVED\"\n672|    elif '--- FAIL' in output or 'FAIL:' in output:\n673|        verdict = \"KILLED\"\n674|    else:\n675|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\"\n676|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n677|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note} [exit {run.returncode}]\"\n678|\n679|\n680|def main(argv: list[str]) -> int:\n681|    log_dir: Path | None = None\n682|    names = list(argv)\n683|    if \"--log-dir\" in names:\n684|        idx = names.index(\"--log-dir\")\n685|        if idx + 1 >= len(names):\n686|            print(\"--log-dir needs a directory\")\n687|            return 2\n688|        log_dir = Path(names[idx + 1])\n689|        log_dir.mkdir(parents=True, exist_ok=True)\n690|        del names[idx : idx + 2]\n691|    selected = [m for m in MUTANTS if not names or m.name in names]\n692|    if names and len(selected) != len(names):\n693|        unknown = sorted(set(names) - {m.name for m in selected})\n694|        print(f\"unknown mutants: {', '.join(unknown)}\")\n695|        return 2\n696|    failures = 0\n697|    for mutant in selected:\n698|        try:\n699|            line = run_mutant(mutant, log_dir)\n700|        except subprocess.TimeoutExpired:\n701|            line = f\"ERROR: {mutant.name}: killer timed out\"\n702|        print(line, flush=True)\n703|        if not line.startswith(\"ok:\"):\n704|            failures += 1\n705|    return 1 if failures else 0\n706|\n707|\n708|if __name__ == \"__main__\":\n709|    sys.exit(main(sys.argv[1:]))","final_result":true}}}
