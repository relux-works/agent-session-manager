{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cde3","stream":{"kind":"session","id":"01a0c54c-0ef4-78b3-96e2-4f10155428e6"},"sequence":1356,"recorded_at":1780531400002707,"record_type":"event","durability":"durable","causation_id":"a845ab6a-f3a6-48e7-a9d4-e4e3621097f9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a845ab6a-f3a6-48e7-a9d4-e4e3621097f9","run_stream":{"kind":"run","id":"a845ab6a-f3a6-48e7-a9d4-e4e3621097f9"},"task_stream":{"kind":"task","id":"01a0c55d-fd27-7200-b08d-7eeb44148c0d"},"task_id":"01a0c55d-fd27-7200-b08d-7eeb44148c0d","event":{"kind":"output","task_id":"01a0c55d-fd27-7200-b08d-7eeb44148c0d","chunk":"edited\nchanged lines: lines 760-794\n--- original\n+++ updated\n@@\n-// The caller value is the gate input itself, so the two iterations\n-// differ by the armed dependency set instead: an admitted unknown\n-// caller dispatches down the foreground path in both, reaching the\n-// foreground probe set in one and the background broker set (which\n-// the foreground path cannot use) in the other.\n-func TestAcquireRefusesUnknownCaller(t *testing.T) {\n-\troot := runtimeRoot(t)\n-\tfor _, tc := range []struct {\n-\t\tname      string\n-\t\tarmBroker bool\n-\t}{\n-\t\t{\"foreground deps\", false},\n-\t\t{\"background deps\", true},\n-\t} {\n-\t\tt.Run(tc.name, func(t *testing.T) {\n-\t\t\treq := validRequest(t, root)\n-\t\t\treq.Caller = \"operator\"\n-\t\t\tspy := &spawnSpy{}\n-\t\t\tprobe := &probeServerSpy{}\n-\t\t\treq.Deps.Spawn = spy.spawn\n-\t\t\treq.Deps.ProbeServer = probe.probe\n-\t\t\tif tc.armBroker {\n-\t\t\t\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n-\t\t\t\t\treturn brokerReport(), nil\n-\t\t\t\t}\n-\t\t\t}\n-\t\t\t_, err := Acquire(req)\n-\t\t\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"caller\")\n-\t\t\tif spy.calls != 0 {\n-\t\t\t\tt.Fatalf(\"spawn calls = %d, want 0 on caller refusal\", spy.calls)\n-\t\t\t}\n-\t\t\tprobe.requireSilent(t)\n-\t\t})\n-\t}\n-}\n+// The caller value is the gate input, so no caller dimension exists:\n+// an unknown caller is neither foreground nor background, and an\n+// admitted one always dispatches down the foreground path (its value\n+// differs from the background caller). The test arms the foreground\n+// post-admission spy set the admitted input would reach.\n+func TestAcquireRefusesUnknownCaller(t *testing.T) {\n+\troot := runtimeRoot(t)\n+\treq := validRequest(t, root)\n+\treq.Caller = \"operator\"\n+\tspy := &spawnSpy{}\n+\tprobe := &probeServerSpy{}\n+\treq.Deps.Spawn = spy.spawn\n+\treq.Deps.ProbeServer = probe.probe\n+\t_, err := Acquire(req)\n+\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"caller\")\n+\tif spy.calls != 0 {\n+\t\tt.Fatalf(\"spawn calls = %d, want 0 on caller refusal\", spy.calls)\n+\t}\n+\tprobe.requireSilent(t)\n+}\n","final_result":true}}}
