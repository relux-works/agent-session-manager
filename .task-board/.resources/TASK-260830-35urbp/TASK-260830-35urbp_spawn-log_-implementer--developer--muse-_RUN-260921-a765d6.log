e.TMUXTmpDir},\n37|\t} {\n38|\t\tt.Run(tc.name, func(t *testing.T) {\n39|\t\t\t_, err := BuildArgv(dir, tc.socket, fixtureSession)\n40|\t\t\trequireLocalError(t, err, \"tmux_ambient_server_reuse\", \"spawn socket\")\n41|\t\t})\n42|\t}\n43|}\n44|\n45|// The landed argv shape gate is wired at the spawn vector: a runtime\n46|// directory no filesystem names (invalid UTF-8) refuses there instead\n47|// of reaching the spawner. Reachable only by direct call — through\n48|// Acquire the directory always names a created directory.\n49|func TestBuildArgvRefusesInvalidArgvShape(t *testing.T) {\n50|\tdir := string([]byte{0xff, 0xfe})\n51|\t_, err := BuildArgv(dir, SocketPath(dir), fixtureSession)\n52|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"spawn argv\")\n53|}\n54|\n55|func TestBuildArgvRefusesMalformedSession(t *testing.T) {\n56|\tdir := runtimeDir(t, runtimeRoot(t))\n57|\tfor _, session := range []string{\"\", \"12345\", \"not-a-uuid\", \"0198f4c8-7d40-7e55-8e6f-1234567890ag\"} {\n58|\t\t_, err := BuildArgv(dir, SocketPath(dir), session)\n59|\t\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"session identity\")\n60|\t}\n61|}","final_result":true}}}
