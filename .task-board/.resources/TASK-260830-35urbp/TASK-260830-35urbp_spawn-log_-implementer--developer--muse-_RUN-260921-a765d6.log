ble ownership is never legitimate custody.\n30|func verifyOwnership(info fs.FileInfo) error {\n31|\tstat, ok := info.Sys().(*syscall.Stat_t)\n32|\tif !ok {\n33|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime ownership\"}\n34|\t}\n35|\tif stat.Uid != uint32(effectiveUID()) {\n36|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime ownership\"}\n37|\t}\n38|\treturn nil\n39|}","final_result":true}}}
