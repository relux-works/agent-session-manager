 realmAdmitted()}, \"\", \"server generation\"},\n31|\t} {\n32|\t\tt.Run(tc.name, func(t *testing.T) {\n33|\t\t\trequireLocalError(t, CheckServerAttested(tc.admission, tc.want), \"tmux_readiness_not_authorizing\", tc.detail)\n34|\t\t})\n35|\t}\n36|}\n37|\n38|func TestCheckBrokerContactAdmitsLiveReport(t *testing.T) {\n39|\tif err := CheckBrokerContact(brokerReport(), fixtureGeneration, currentUID()); err != nil {\n40|\t\tt.Fatal(err)\n41|\t}\n42|}\n43|\n44|func TestCheckBrokerContactRefusesEachMissingFact(t *testing.T) {\n45|\tlive := brokerReport()\n46|\tfor _, tc := range []struct {\n47|\t\tname   string\n48|\t\treport BrokerReport\n49|\t\twant   string\n50|\t\tdetail string\n51|\t}{\n52|\t\t{\"no broker\", BrokerReport{}, fixtureGeneration, \"broker authentication\"},\n53|\t\t{\"foreign-user broker\", BrokerReport{\n54|\t\t\tPrincipal: BrokerPrincipal{UID: foreignUID(), Generation: fixtureGeneration},\n55|\t\t\tServer:    boundAdmission(),\n56|\t\t}, fixtureGeneration, \"broker authentication\"},\n57|\t\t{\"generation-unbound principal\", BrokerReport{\n58|\t\t\tPrincipal: BrokerPrincipal{UID: live.Principal.UID, Generation: fixtureStaleGen},\n59|\t\t\tServer:    boundAdmission(),\n60|\t\t}, fixtureGeneration, \"broker generation\"},\n61|\t\t{\"empty principal generation\", BrokerReport{\n62|\t\t\tPrincipal: BrokerPrincipal{UID: live.Principal.UID},\n63|\t\t\tServer:    boundAdmission(),\n64|\t\t}, fixtureGeneration, \"broker generation\"},\n65|\t\t{\"both generations empty\", BrokerReport{\n66|\t\t\tPrincipal: BrokerPrincipal{UID: live.Principal.UID},\n67|\t\t\tServer:    RealmAdmission{Admitted: realmAdmitted()},\n68|\t\t}, \"\", \"broker generation\"},\n69|\t\t{\"unattested server\", BrokerReport{\n70|\t\t\tPrincipal: live.Principal,\n71|\t\t\tServer:    RealmAdmission{RawGeneration: fixtureGeneration},\n72|\t\t}, fixtureGeneration, \"server attestation\"},\n73|\t\t{\"stale server admission\", BrokerReport{\n74|\t\t\tPrincipal: live.Principal,\n75|\t\t\tServer:    staleAdmission(),\n76|\t\t}, fixtureGeneration, \"server generation\"},\n77|\t} {\n78|\t\tt.Run(tc.name, func(t *testing.T) {\n79|\t\t\trequireLocalError(t, CheckBrokerContact(tc.report, tc.want, currentUID()), \"tmux_readiness_not_authorizing\", tc.detail)\n80|\t\t})\n81|\t}\n82|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
