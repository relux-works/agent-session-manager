{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8f9","stream":{"kind":"session","id":"01a0c54c-0ef4-78b3-96e2-4f10155428e6"},"sequence":727,"recorded_at":1780531400001449,"record_type":"event","durability":"durable","causation_id":"a845ab6a-f3a6-48e7-a9d4-e4e3621097f9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a845ab6a-f3a6-48e7-a9d4-e4e3621097f9","run_stream":{"kind":"run","id":"a845ab6a-f3a6-48e7-a9d4-e4e3621097f9"},"task_stream":{"kind":"task","id":"01a0c553-fd56-7a91-b97e-4b2a6cf13d75"},"task_id":"01a0c553-fd56-7a91-b97e-4b2a6cf13d75","event":{"kind":"output","task_id":"01a0c553-fd56-7a91-b97e-4b2a6cf13d75","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-2t4g7i/worktree/internal/tmuxserver/runtime_test.go`.\n(196 line(s) above)\n197|func TestEnsureRuntimeDirRefusesHandleMismatch(t *testing.T) {\n198|\troot := runtimeRoot(t)\n199|\tprevious := sameDirectory\n200|\tsameDirectory = func(_, _ os.FileInfo) bool { return false }\n201|\tdefer func() { sameDirectory = previous }()\n202|\t_, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n203|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n204|\tif err := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS); err != nil {\n205|\t\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n206|\t} else {\n207|\t\tt.Fatal(\"VerifyRuntimeDir admitted a handle mismatch\")\n208|\t}\n209|}\n210|\n211|func TestEnsureRuntimeDirRefusesSymlinkRoot(t *testing.T) {\n212|\treal := runtimeRoot(t)\n213|\tlink := filepath.Join(t.TempDir(), \"linkroot\")\n214|\tif err := os.Symlink(real, link); err != nil {\n215|\t\tt.Fatal(err)\n216|\t}\n217|\t_, err := EnsureRuntimeDir(link, RuntimeDirName, scalar.PlatformMacOS, nil)\n218|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n219|}\n220|\n221|func TestEnsureRuntimeDirRefusesBadRoots(t *testing.T) {\n222|\troot := runtimeRoot(t)\n223|\tfor _, tc := range []struct {\n224|\t\tname string\n225|\t\troot string\n226|\t}{\n227|\t\t{\"relative\", \"relative/root\"},\n228|\t\t{\"empty\", \"\"},\n229|\t\t{\"parent\", \"/tmp/../etc\"},\n230|\t\t{\"missing\", filepath.Join(root, \"no-such-root\")},\n231|\t} {\n232|\t\tt.Run(tc.name, func(t *testing.T) {\n233|\t\t\t_, err := EnsureRuntimeDir(tc.root, RuntimeDirName, scalar.PlatformMacOS, nil)\n234|\t\t\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"runtime root\")\n235|\t\t})\n236|\t}\n237|}\n238|\n239|func TestEnsureRuntimeDirRefusesBadNames(t *testing.T) {\n240|\troot := runtimeRoot(t)\n241|\tfor _, tc := range []struct {\n242|\t\tname  string\n243|\t\tvalue string\n244|\t}{\n245|\t\t{\"empty\", \"\"},\n246|\t\t{\"dot\", \".\"},\n247|\t\t{\"parent\", \"..\"},\n248|\t\t{\"nested\", \"a/b\"},\n249|\t\t{\"absolute\", \"/abs\"},\n250|\t\t{\"nul\", \"a\\x00b\"},\n251|\t} {\n252|\t\tt.Run(tc.name, func(t *testing.T) {\n253|\t\t\t_, err := EnsureRuntimeDir(root, tc.value, scalar.PlatformMacOS, nil)\n254|\t\t\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"runtime name\")\n255|\t\t})\n256|\t}\n257|}\n258|\n259|func TestEnsureRuntimeDirRefusesBadPlatform(t *testing.T) {\n260|\troot := runtimeRoot(t)\n261|\t_, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.Platform(\"plan9\"), nil)\n262|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"runtime platform\")\n263|}\n264|\n265|func TestEnsureRuntimeDirRefusesWindowsOnUnixHost(t *testing.T) {\n266|\t// Native Windows MUST NOT claim tmux: the Windows platform\n267|\t// refuses at the lexical gate on every host, before any\n268|\t// host-specific commit runs.\n269|\tfor _, root := range []string{`C:\\ax-runtime`, `D:\\other-runtime`} {\n270|\t\t_, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformWindows, nil)\n271|\t\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"runtime platform\")\n272|\t}\n273|}\n274|\n275|func TestVerifyRuntimeDirRefusesSymlinkLeaf(t *testing.T) {\n276|\troot := runtimeRoot(t)\n277|\tescape := t.TempDir()\n278|\tleaf := filepath.Join(root, RuntimeDirName)\n279|\tif err := os.Symlink(escape, leaf); err != nil {\n280|\t\tt.Fatal(err)\n281|\t}\n282|\terr := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS)\n283|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n284|}\n285|\n286|// The explicit post-mkdirat mode enforcement is load-bearing: under a\n287|// restrictive umask the mkdir mode alone would leave a narrower leaf,\n288|// and only the explicit chmod converges to the exact owner-only mode.\n289|func TestEnsureRuntimeDirEnforcesModeUnderRestrictiveUmask(t *testing.T) {\n290|\troot := runtimeRoot(t)\n291|\tprevious := syscall.Umask(0o177)\n292|\tdefer syscall.Umask(previous)\n293|\tdir, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n294|\tif err != nil {\n295|\t\tt.Fatal(err)\n296|\t}\n297|\tinfo, err := os.Lstat(dir)\n298|\tif err != nil {\n299|\t\tt.Fatal(err)\n300|\t}\n301|\tif !info.IsDir() || info.Mode().Perm() != 0o700 {\n302|\t\tt.Fatalf(\"mode under umask 0177 = %04o dir=%v, want 0700 dir\", info.Mode().Perm(), info.IsDir())\n303|\t}\n304|}\n305|\n306|func TestVerifyRuntimeDirRefusesAbsence(t *testing.T) {\n307|\troot := runtimeRoot(t)\n308|\terr := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS)\n309|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime absent\")\n310|}\n311|\n312|func TestVerifyRuntimeDirRefusesBadLexical(t *testing.T) {\n313|\troot := runtimeRoot(t)\n314|\tif err := VerifyRuntimeDir(\"relative/root\", RuntimeDirName, scalar.PlatformMacOS); err != nil {\n315|\t\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"runtime root\")\n316|\t} else {\n317|\t\tt.Fatal(\"VerifyRuntimeDir admitted a relative root\")\n318|\t}\n319|\tif err := VerifyRuntimeDir(root, \"a/b\", scalar.PlatformMacOS); err != nil {\n320|\t\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"runtime name\")\n321|\t} else {\n322|\t\tt.Fatal(\"VerifyRuntimeDir admitted a nested name\")\n323|\t}\n324|\tif err := VerifyRuntimeDir(root, RuntimeDirName, scalar.Platform(\"plan9\")); err != nil {\n325|\t\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"runtime platform\")\n326|\t} else {\n327|\t\tt.Fatal(\"VerifyRuntimeDir admitted an unknown platform\")\n328|\t}\n329|}\n330|\n331|func TestVerifyRuntimeDirRefusesMissingRoot(t *testing.T) {\n332|\troot := filepath.Join(runtimeRoot(t), \"no-such-root\")\n333|\terr := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS)\n334|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"runtime root\")\n335|}\n336|\n337|// A commit-phase filesystem failure refuses with the commit detail\n338|// instead of being mistaken for an existing leaf: the suite revokes\n339|// root write permission, so Mkdirat fails EACCES, and restores it so\n340|// the temporary directory cleans up. Non-root only (bound B14).\n341|func TestEnsureRuntimeDirRefusesReadOnlyRoot(t *testing.T) {\n342|\troot := runtimeRoot(t)\n343|\tif err := os.Chmod(root, 0o500); err != nil {\n344|\t\tt.Fatal(err)\n345|\t}\n346|\tdefer func() {\n347|\t\tif err := os.Chmod(root, 0o700); err != nil {\n348|\t\t\tt.Fatal(err)\n349|\t\t}\n350|\t}()\n351|\t_, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n352|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime commit\")\n353|}\n354|\n355|func TestLinuxAndWSL2ShareUnixCustody(t *testing.T) {\n356|\tfor _, platform := range []scalar.Platform{scalar.PlatformLinux, scalar.PlatformWSL2} {\n357|\t\troot := runtimeRoot(t)\n358|\t\tdir, err := EnsureRuntimeDir(root, RuntimeDirName, platform, nil)\n359|\t\tif err != nil {\n360|\t\t\tt.Fatalf(\"%s: %v\", platform, err)\n361|\t\t}\n(more lines below)","final_result":true}}}
