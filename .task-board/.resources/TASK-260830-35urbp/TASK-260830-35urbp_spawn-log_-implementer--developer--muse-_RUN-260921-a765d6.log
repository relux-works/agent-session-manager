{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c65d","stream":{"kind":"session","id":"01a0c54c-0ef4-78b3-96e2-4f10155428e6"},"sequence":393,"recorded_at":1780531400000781,"record_type":"event","durability":"durable","causation_id":"a845ab6a-f3a6-48e7-a9d4-e4e3621097f9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a845ab6a-f3a6-48e7-a9d4-e4e3621097f9","run_stream":{"kind":"run","id":"a845ab6a-f3a6-48e7-a9d4-e4e3621097f9"},"task_stream":{"kind":"task","id":"01a0c54e-0f89-7181-a580-df6b155d6977"},"task_id":"01a0c54e-0f89-7181-a580-df6b155d6977","event":{"kind":"output","task_id":"01a0c54e-0f89-7181-a580-df6b155d6977","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-2t4g7i/worktree/internal/tmuxserver/acquire_test.go`.\n(499 line(s) above)\n500|\tspy := &spawnSpy{}\n501|\tprobe := &probeServerSpy{}\n502|\tprobed := false\n503|\treq.Deps.Spawn = spy.spawn\n504|\treq.Deps.ProbeServer = probe.probe\n505|\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n506|\t\tprobed = true\n507|\t\treturn brokerReport(), nil\n508|\t}\n509|\t_, err = Acquire(req)\n510|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime mode\")\n511|\tif probed {\n512|\t\tt.Fatal(\"broker was probed past a custody refusal\")\n513|\t}\n514|\tif spy.calls != 0 {\n515|\t\tt.Fatalf(\"spawn calls = %d, want 0 past a custody refusal\", spy.calls)\n516|\t}\n517|\tprobe.requireSilent(t)\n518|}\n519|\n520|func TestAcquireBackgroundProbeFailurePassesThrough(t *testing.T) {\n521|\troot := runtimeRoot(t)\n522|\truntimeDir(t, root)\n523|\treq := validRequest(t, root)\n524|\treq.Caller = CallerBackground\n525|\tspy := &spawnSpy{}\n526|\treq.Deps.Spawn = spy.spawn\n527|\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n528|\t\treturn BrokerReport{}, errProbeBoom\n529|\t}\n530|\t_, err := Acquire(req)\n531|\tif !errors.Is(err, errProbeBoom) {\n532|\t\tt.Fatalf(\"err = %v, want the probe failure, not unavailable\", err)\n533|\t}\n534|\tif spy.calls != 0 {\n535|\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n536|\t}\n537|}\n538|\n539|func TestAcquireRefusesEveryAmbientOverrideVector(t *testing.T) {\n540|\thostile := hostileAmbient()\n541|\tvectors := map[string]string{\n542|\t\t\"environment variable\": hostile.TMUXEnv,\n543|\t\t\"tmux tmpdir\":          hostile.TMUXTmpDir,\n544|\t\t\"inherited socket\":     hostile.InheritedSocket,\n545|\t\t\"default path\":         hostile.DefaultPath,\n546|\t\t\"conventional name\":    hostile.ConventionalName,\n547|\t\t\"whitespace only\":      \"  \",\n548|\t}\n549|\tfor name, override := range vectors {\n550|\t\tt.Run(name, func(t *testing.T) {\n551|\t\t\troot := runtimeRoot(t)\n552|\t\t\treq := validRequest(t, root)\n553|\t\t\tspy := &spawnSpy{}\n554|\t\t\treq.SocketOverride = override\n555|\t\t\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n556|\t\t\t\treturn ServerReport{}, nil\n557|\t\t\t}\n558|\t\t\treq.Deps.Spawn = spy.spawn\n559|\t\t\t_, err := Acquire(req)\n560|\t\t\trequireLocalError(t, err, \"tmux_ambient_server_reuse\", \"socket override\")\n561|\t\t\tif spy.calls != 0 {\n562|\t\t\t\tt.Fatalf(\"spawn calls = %d, want 0 on ambient refusal\", spy.calls)\n563|\t\t\t}\n564|\t\t\tif _, statErr := os.Lstat(filepath.Join(root, RuntimeDirName)); !os.IsNotExist(statErr) {\n565|\t\t\t\tt.Fatalf(\"ambient refusal created the directory: stat err = %v\", statErr)\n566|\t\t\t}\n567|\t\t})\n568|\t}\n569|}\n570|\n571|func TestAcquireRefusesAmbientCollision(t *testing.T) {\n572|\tfor _, tc := range []struct {\n573|\t\tname    string\n574|\t\tambient func(derived string) Ambient\n575|\t}{\n576|\t\t{\"tmux env\", func(derived string) Ambient { return Ambient{TMUXEnv: derived} }},\n577|\t\t{\"tmux tmpdir\", func(derived string) Ambient { return Ambient{TMUXTmpDir: derived} }},\n578|\t\t{\"inherited socket\", func(derived string) Ambient { return Ambient{InheritedSocket: derived} }},\n579|\t\t{\"default path\", func(derived string) Ambient { return Ambient{DefaultPath: derived} }},\n580|\t\t{\"conventional name\", func(derived string) Ambient { return Ambient{ConventionalName: derived} }},\n581|\t} {\n582|\t\tt.Run(tc.name, func(t *testing.T) {\n583|\t\t\troot := runtimeRoot(t)\n584|\t\t\tdir := socketDir(t, root)\n585|\t\t\treq := validRequest(t, root)\n586|\t\t\treq.Ambient = tc.ambient(SocketPath(dir))\n587|\t\t\tspy := &spawnSpy{}\n588|\t\t\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n589|\t\t\t\treturn ServerReport{}, nil\n590|\t\t\t}\n591|\t\t\treq.Deps.Spawn = spy.spawn\n592|\t\t\t_, err := Acquire(req)\n593|\t\t\trequireLocalError(t, err, \"tmux_ambient_server_reuse\", \"ambient collision\")\n594|\t\t\tif spy.calls != 0 {\n595|\t\t\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n596|\t\t\t}\n597|\t\t})\n598|\t}\n599|}\n600|\n601|// The background path verifies custody through VerifyRuntimeDir, so a\n602|// non-directory leaf refuses through the entry before any broker\n603|// contact: the verify-side O_DIRECTORY refusal driven at the entry the\n604|// background path uses.\n605|func TestAcquireBackgroundRefusesNonDirectoryLeaf(t *testing.T) {\n606|\troot := runtimeRoot(t)\n607|\tleaf := filepath.Join(root, RuntimeDirName)\n608|\tif err := os.WriteFile(leaf, []byte(\"x\"), 0o700); err != nil {\n609|\t\tt.Fatal(err)\n610|\t}\n611|\treq := validRequest(t, root)\n612|\treq.Caller = CallerBackground\n613|\tprobed := false\n614|\tspy := &spawnSpy{}\n615|\treq.Deps.Spawn = spy.spawn\n616|\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n617|\t\tprobed = true\n618|\t\treturn brokerReport(), nil\n619|\t}\n620|\t_, err := Acquire(req)\n621|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n622|\tif probed {\n623|\t\tt.Fatal(\"broker was probed past a non-directory leaf\")\n624|\t}\n625|\tif spy.calls != 0 {\n626|\t\tt.Fatalf(\"spawn calls = %d, want 0 past a non-directory leaf\", spy.calls)\n627|\t}\n628|}\n629|\n630|// An unclean spelling of the derived socket refuses through the entry\n631|// with no spawn: the cleaned-spelling collision gate driven at\n632|// Acquire.\n633|func TestAcquireRefusesAmbientCollisionUncleanSpelling(t *testing.T) {\n634|\troot := runtimeRoot(t)\n635|\tdir := socketDir(t, root)\n636|\talias := dir + \"/./\" + SocketName\n637|\tif got := filepath.Clean(alias); got != SocketPath(dir) {\n638|\t\tt.Fatalf(\"alias %q cleans to %q, want the derived socket\", alias, got)\n639|\t}\n640|\treq := validRequest(t, root)\n641|\treq.Ambient = Ambient{DefaultPath: alias}\n642|\tspy := &spawnSpy{}\n643|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n644|\t\treturn ServerReport{}, nil\n645|\t}\n646|\treq.Deps.Spawn = spy.spawn\n647|\t_, err := Acquire(req)\n648|\trequireLocalError(t, err, \"tmux_ambient_server_reuse\", \"ambient collision\")\n649|\tif spy.calls != 0 {\n650|\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n651|\t}\n652|}\n653|\n654|// A TMUX value naming the derived socket in the real\n655|// `<socket>,<pid>,<index>` encoding refuses through the entry with\n656|// no spawn: the collision gate compares the socket component.\n657|func TestAcquireRefusesTMUXEnvCollisionRealEncoding(t *testing.T) {\n658|\troot := runtimeRoot(t)\n659|\tdir := socketDir(t, root)\n660|\tencoded := SocketPath(dir) + \",12345,0\"\n661|\treq := validRequest(t, root)\n662|\treq.Ambient = Ambient{TMUXEnv: encoded}\n663|\tspy := &spawnSpy{}\n664|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n665|\t\treturn ServerReport{}, nil\n666|\t}\n667|\treq.Deps.Spawn = spy.spawn\n668|\t_, err := Acquire(req)\n669|\trequireLocalError(t, err, \"tmux_ambient_server_reuse\", \"ambient collision\")\n670|\tif spy.calls != 0 {\n671|\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n672|\t}\n673|}\n674|\n675|func TestAcquireRefusesUnknownCaller(t *testing.T) {\n676|\troot := runtimeRoot(t)\n677|\treq := validRequest(t, root)\n678|\treq.Caller = \"operator\"\n679|\t_, err := Acquire(req)\n680|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"caller\")\n681|}\n682|\n683|func TestAcquireRefusesWindowsPlatform(t *testing.T) {\n684|\troot := runtimeRoot(t)\n685|\tfor _, caller := range []Caller{CallerForeground, CallerBackground} {\n686|\t\treq := validRequest(t, root)\n687|\t\treq.Caller = caller\n688|\t\treq.Platform = scalar.PlatformWindows\n689|\t\treq.Root = `C:\\ax-runtime`\n690|\t\tspy := &spawnSpy{}\n691|\t\treq.Deps.Spawn = spy.spawn\n692|\t\t_, err := Acquire(req)\n693|\t\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"runtime platform\")\n694|\t\tif spy.calls != 0 {\n695|\t\t\tt.Fatalf(\"spawn calls = %d, want 0 on platform refusal\", spy.calls)\n696|\t\t}\n697|\t}\n698|}\n699|\n700|func TestAcquireRefusesMissingRealmDetails(t *testing.T) {\n701|\tbase := validRequest(t, runtimeRoot(t))\n702|\tfor _, tc := range []struct {\n703|\t\tname   string\n704|\t\tmutate func(*Request)\n705|\t}{\n706|\t\t{\"generation\", func(r *Request) { r.Generation = \"\" }},\n707|\t\t{\"broker state\", func(r *Request) { r.BrokerState = \"\" }},\n708|\t\t{\"remediation\", func(r *Request) { r.Remediation = \"\" }},\n709|\t} {\n710|\t\tt.Run(tc.name, func(t *testing.T) {\n711|\t\t\treq := base\n712|\t\t\ttc.mutate(&req)\n713|\t\t\t_, err := Acquire(req)\n714|\t\t\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"realm details\")\n715|\t\t})\n716|\t}\n717|}\n718|\n719|func TestAcquireRefusesMissingDependencies(t *testing.T) {\n720|\troot := runtimeRoot(t)\n721|\tforeground := validRequest(t, root)\n722|\t_, err := Acquire(foreground)\n723|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"dependencies\")\n724|\tbackground := validRequest(t, root)\n725|\tbackground.Caller = CallerBackground\n726|\tspy := &spawnSpy{}\n727|\tbackground.Deps.Spawn = spy.spawn\n728|\t_, err = Acquire(background)\n729|\trequireLocalError(t, err, \"tmux_invalid_argume