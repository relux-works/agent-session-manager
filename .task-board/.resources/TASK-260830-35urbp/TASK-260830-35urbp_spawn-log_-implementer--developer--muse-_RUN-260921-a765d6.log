{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c847","stream":{"kind":"session","id":"01a0c54c-0ef4-78b3-96e2-4f10155428e6"},"sequence":638,"recorded_at":1780531400001271,"record_type":"event","durability":"durable","causation_id":"a845ab6a-f3a6-48e7-a9d4-e4e3621097f9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a845ab6a-f3a6-48e7-a9d4-e4e3621097f9","run_stream":{"kind":"run","id":"a845ab6a-f3a6-48e7-a9d4-e4e3621097f9"},"task_stream":{"kind":"task","id":"01a0c550-2d48-7ed2-8d30-aa1c21bb6130"},"task_id":"01a0c550-2d48-7ed2-8d30-aa1c21bb6130","event":{"kind":"output","task_id":"01a0c550-2d48-7ed2-8d30-aa1c21bb6130","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-2t4g7i/worktree/internal/tmuxserver/mutant_harness.py`.\n(339 line(s) above)\n340|        note=\"Admits exactly the both-empty generation pair past the wanted-empty arm; every pair with a non-empty side still refuses on the inequality (the empty-wanted row keeps a bound Raw, the empty-raw row keeps a bound want). Narrowing, not a delete: the inequality arm stays.\",\n341|    ),\n342|    Mutant(\n343|        name=\"N-broker-uid\",\n344|        path=f\"{PACKAGE}/readiness.go\",\n345|        find=\"\\tif report.Principal.UID != currentUID {\\n\",\n346|        replace=\"\\tif report.Principal.UID != currentUID && report.Principal.UID != currentUID+100000 {\\n\",\n347|        count=1,\n348|        run=f\"(TestCheckBrokerContactRefusesEachMissingFact|{BG_MISS})\",\n349|        expect=\"KILLED\",\n350|        note=\"Admits exactly the seam-shifted foreign UID past the same-user arm; every other foreign UID still refuses.\",\n351|    ),\n352|    Mutant(\n353|        name=\"N-broker-generation\",\n354|        path=f\"{PACKAGE}/readiness.go\",\n355|        find='\\tif report.Principal.Generation == \"\" || report.Principal.Generation != wantGeneration {\\n',\n356|        replace='\\tif report.Principal.Generation == \"\" || report.Principal.Generation != wantGeneration && report.Principal.Generation != \"generation-6\" {\\n',\n357|        count=1,\n358|        run=f\"(TestCheckBrokerContactRefusesEachMissingFact|TestAcquireBackgroundMissReturnsTypedUnavailable/generation-unbound_principal)\",\n359|        expect=\"KILLED\",\n360|        note=\"Admits exactly generation-6 broker principals past the principal-binding arm; every other unbound principal still refuses.\",\n361|    ),\n362|    Mutant(\n363|        name=\"N-broker-empty-generation\",\n364|        path=f\"{PACKAGE}/readiness.go\",\n365|        find='\\tif report.Principal.Generation == \"\" || report.Principal.Generation != wantGeneration {\\n',\n366|        replace='\\tif report.Principal.Generation != wantGeneration {\\n',\n367|        count=1,\n368|        run=\"TestCheckBrokerContactRefusesEachMissingFact\",\n369|        expect=\"KILLED\",\n370|        note=\"Admits exactly the both-empty principal pair past the principal-empty arm; every other unbound principal still refuses. Kill reroutes to the server-generation refusal (the empty wanted generation reaches CheckServerAttested), which mismatches the broker-generation detail the row asserts. Through Acquire the pair is unreachable: the typed-details check refuses an empty Generation first.\",\n371|    ),\n372|    Mutant(\n373|        name=\"N-creation-literal\",\n374|        path=f\"{PACKAGE}/acquire.go\",\n375|        find=\"\\tif caller == CallerBackground {\\n\",\n376|        replace='\\tif caller == \"Background\" {\\n',\n377|        count=1,\n378|        run=f\"(TestCheckCreationAllowedRefusesBackground|{BG_MISS_LINUX})\",\n379|        expect=\"KILLED\",\n380|        note=\"Admits exactly the background caller at the creation choke point; the gate still refuses the capitalized twin. Kill path: the background miss consults the gate by call and reports the creation code instead of the typed unavailable.\",\n381|    ),\n382|    Mutant(\n383|        name=\"N-caller-vocabulary\",\n384|        path=f\"{PACKAGE}/acquire.go\",\n385|        find=\"\\tif req.Caller != CallerForeground && req.Caller != CallerBackground {\\n\",\n386|        replace='\\tif req.Caller != CallerForeground && req.Caller != CallerBackground && req.Caller != \"operator\" {\\n',\n387|        count=1,\n388|        run=\"TestAcquireRefusesUnknownCaller\",\n389|        expect=\"KILLED\",\n390|        note=\"Admits exactly the operator caller past the vocabulary arm; every other unknown caller still refuses. Kill reroutes to the dependencies refusal.\",\n391|    ),\n392|    Mutant(\n393|        name=\"N-details-remediation\",\n394|        path=f\"{PACKAGE}/acquire.go\",\n395|        find='\\tif req.Generation == \"\" || req.BrokerState == \"\" || req.Remediation == \"\" {\\n',\n396|        replace='\\tif req.Generation == \"\" || req.BrokerState == \"\" {\\n',\n397|        count=1,\n398|        run=\"TestAcquireRefusesMissingRealmDetails\",\n399|        expect=\"KILLED\",\n400|        note=\"Admits exactly remediation-less requests past the typed-details arm; generation- and broker-less still refuse. Kill reroutes to the dependencies refusal.\",\n401|    ),\n402|    Mutant(\n403|        name=\"N-unattested-foreground\",\n404|        path=f\"{PACKAGE}/acquire.go\",\n405|        find=\"\\t\\tif err := CheckServerAttested(report.Admission, req.Generation); err != nil {\\n\\t\\t\\treturn Outcome{}, err\\n\\t\\t}\\n\",\n406|        replace='\\t\\tif err := CheckServerAttested(report.Admission, req.Generation); err != nil && err.Error() != \"tmux server refused: tmux_readiness_not_authorizing at server generation\" {\\n\\t\\t\\treturn Outcome{}, err\\n\\t\\t}\\n',\n407|        count=1,\n408|        run=\"TestAcquireForegroundRefusesWrongGenerationAdmission\",\n409|        expect=\"KILLED\",\n410|        note=\"Admits exactly generation-refused running servers to attach past the foreground wiring; membership refusals still refuse. Kill path: a stale admission attaches instead of refusing.\",\n411|    ),\n412|    Mutant(\n413|        name=\"N-acquire-commit-refusal\",\n414|        path=f\"{PACKAGE}/acquire.go\",\n415|        find=\"\\tensured, err := EnsureRuntimeDir(req.Root, RuntimeDirName, req.Platform, nil)\\n\\tif err != nil {\\n\",\n416|        replace=\"\\tensured, err := EnsureRuntimeDir(req.Root, RuntimeDirName, req.Platform, nil)\\n\\tif err != nil && ensured == \\\"\\\" {\\n\",\n417|        count=1,\n418|        run=\"TestAcquireForegroundStagesCommitPhaseCustodyRefusal\",\n419|        expect=\"KILLED\",\n420|        note=\"Admits exactly commit-phase custody refusals past the foreground wiring (commit failures carry the joined path; lexical failures carry \\\"\\\"); lexical refusals still refuse. Kill path: the entry probes and spawns past a widened mode.\",\n421|    ),\n422|    Mutant(\n423|        name=\"N-acquire-verify-refusal\",\n424|        path=f\"{PACKAGE}/acquire.go\",\n425|        find=\"\\tif verr != nil {\\n\\t\\treturn Outcome{}, verr\\n\\t}\\n\",\n426|        replace='\\tif verr != nil && verr.Error() != \"tmux server refused: tmux_unsafe_runtime_dir at runtime mode\" {\\n\\t\\treturn Outcome{}, verr\\n\\t}\\n',\n427|        count=1,\n428|        run=\"TestAcquireBackgroundStagesVerifyCustodyRefusal\",\n429|        expect=\"KILLED\",\n430|        note=\"Admits exactly mode refusals past the background verify wiring; absence maps to unavailable above and every other custody refusal still refuses. Kill path: the entry contacts the broker past a widened mode.\",\n431|    ),\n432|    Mutant(\n433|        name=\"N-spawn-swallow\",\n434|        path=f\"{PACKAGE}/acquire.go\",\n435|        find=\"\\tif err := req.Deps.Spawn(socket, argv); err != nil {\\n\",\n436|        replace='\\tif err := req.Deps.Spawn(socket, argv); err != nil && err.Error() != \"exec failed\" {\\n',\n437|        count=1,\n438|        run=\"TestAcquireForegroundSpawnFailureReportsWithoutFallback\",\n439|        expect=\"KILLED\",\n440|        note=\"Admits exactly the fixture spawn failure as success; every other spawn failure still reports.\",\n441|    ),\n442|    Mutant(\n443|        name=\"N-probe-swallow-foreground\",\n444|        path=f\"{PACKAGE}/acquire.go\",\n445|        find=\"\\treport, err := req.Deps.ProbeServer(socket)\\n\\tif err != nil {\\n\",\n446|        replace='\\treport, err := req.Deps.ProbeServer(socket)\\n\\tif err != nil && err.Error() != \"probe boom\" {\\n',\n447|        count=1,\n448|        run=\"TestAcquireForegroundProbeFailurePassesThrough\",\n449|        expect=\"KILLED\",\n450|        note=\"Admits exactly the fixture probe failure as an absent server (then spawns); every other probe failure still passes through.\",\n451|    ),\n452|    Mutant(\n453|        name=\"N-probe-swallow-background\",\n454|        path=f\"{PACKAGE}/acquire.go\",\n455|        find=\"\\tstatus, err := req.Deps.ProbeBroker()\\n\\tif err != nil {\\n\",\n456|        replace='\\tstatus, err := req.Deps.ProbeBroker()\\n\\tif err != nil && err.Error() != \"probe boom\" {\\n',\n457|        count=1,\n458|        run=\"TestAcquireBackgroundProbeFailurePassesThrough\",\n459|        expect=\"KILLED\",\n460|        note=\"Admits exactly the fixture probe failure as a broker miss (then reports unavailable); every other probe failure still passes through.\",\n461|    ),\n462|    Mutant(\n463|        name=\"N-argv-socket\",\n464|        path=f\"{PACKAGE}/argv.go\",\n465|        find=\"\\tif socket != SocketPath(runtimeDir) {\\n\",\n466|        replace='\\tif socket != SocketPath(runtimeDir) && socket != \"/tmp/tmux-501/default\" {\\n',\n467|        count=1,\n468|        run=\"TestBuildArgvRefusesAmbientSocket\",\n469|        expect=\"KILLED\",\n470|        note=\"Admits exactly the default path at the spawn-socket arm; every other ambient socket still refuses.\",\n471|    ),\n472|    Mutant(\n473|        name=\"N-argv-tmuxenv\",\n474|        path=f\"{PACKAGE}/argv.go\",\n475|        find=\"\\tif socket != SocketPath(runtimeDir) {\\n\",\n476|        replace='\\tif socket != SocketPath(runtimeDir) && socket != \"/tmp/tmux-501/default,12345,0\" {\\n',\n477|        count=1,\n478|        run=\"TestBuildArgvRefusesAmbientSocket/tmux_env_value\",\n479|        expect=\"KILLED\",\n480|        note=\"Admits exactly the TMUX environment value at the spawn-socket arm; every other ambient socket still refuses.\",\n481|    ),\n482|    Mutant(\n483|        name=\"N-argv-shape\",\n484|        path=f\"{PACKAGE}/argv.go\",\n485|        find=\"\\tif err := secprim.CheckArgv(argv); err != nil {\\n\",\n486|        replace='\\tif err := secprim.CheckArgv(argv); err != nil && argv[0] != \"tmux\" {\\n',\n487|        count=1,\n488|        run=\"TestBuildArgvRefusesInvalidArgvShape\",\n489|        expect=\"KILLED\",\n490|        note=\"Admits exactly our tmux-headed spawn vector past the landed shape wiring; any other vector still refuses. Other failing shapes are unstageable through the fixed-shape builder and are disclosed, not pinned.\",\n491|    ),\n492|    Mutant(\n493|        name=\"N-argv-session\",\n494|        path=f\"{PACKAGE}/argv.go\",\n495|        find=\"\\tsession, err := scalar.ParseUUIDv7(sessionID)\\n\\tif err != nil {\\n\",\n496|        replace='\\tsession, err := scalar.ParseUUIDv7(sessionID)\\n\\tif err != nil && sessionID != \"12345\" {\\n',\n497|        count=1,\n498|        run=\"(TestBuildArgvRefusesMalformedSession|TestAcquireForegroundRefusesMalformedSession)\",\n499|        expect=\"KILLED\",\n500|        note=\"Admits exactly the PID-form session past our wiring of the landed UUIDv7 grammar; every other malformed session still refuses.\",\n501|    ),\n502|    Mutant(\n503|        name=\"N-deps-background\",\n504|        path=f\"{PACKAGE}/acquire.go\",\n505|        find=\"\\tif req.Deps.ProbeBroker == nil {\\n\",\n506|        replace=\"\\tif req.Deps.ProbeBroker == nil && req.Deps.Spawn == nil {\\n\",\n507|        count=1,\n508|        run=\"TestAcquireBackgroundNilBrokerWithSpawnRefuses\",\n509|        expect=\"KILLED\",\n510|        note=\"Admits exactly the nil-probe-with-spawn background request past the dependencies arm; the fully-nil request still refuses. Kill path: the admitted request reaches Verify on the absent leaf and reports the typed unavailable instead of the dependencies code.\",\n511|    ),\n512|    Mutant(\n513|        name=\"N-deps-foreground\",\n514|        path=f\"{PACKAGE}/acquire.go\",\n515|        find=\"\\tif req.Deps.ProbeServer == nil || req.Deps.Spawn == nil {\\n\",\n516|        replace=\"\\tif req.Deps.ProbeServer == nil && req.Deps.Spawn == nil {\\n\",\n517|        count=1,\n518|        run=\"TestAcquireForegroundNilSpawnWithProbeRefuses\",\n519|        expect=\"KILLED\",\n520|        note=\"Admits exactly the half-nil foreground dependencies past the arm; fully-nil dependencies still refuse. Kill path: the admitted request panics on the nil spawn, and the panic fails the test.\",\n521|    ),\n522|    Mutant(\n523|        name=\"N-running-empty-admission\",\n524|        path=f\"{PACKAGE}/acquire.go\",\n525|        find=\"\\tif report.Running {\\n\",\n526|        replace=\"\\tif report.Running && len(report.Admission.Admitted.Capabilities) > 0 {\\n\",\n527|        count=1,\n528|        run=\"TestAcquireForegroundRefusesRunningWithEmptyAdmission\",\n529|        expect=\"KILLED\",\n530|        note=\"Admits exactly running servers with zero admission rows past the Running arm (they are treated as absent and spawned into); running servers with admission data still attach-or-refuse. Kill path: a second new-session spawns into the live server.\",\n531|    ),\n532|    Mutant(\n533|        name=\"N-running-empty-generation\",\n534|        path=f\"{PACKAGE}/acquire.go\",\n535|        find=\"\\tif report.Running {\\n\",\n536|        replace='\\tif report.Running && report.Admission.RawGeneration != \"\" {\\n',\n537|        count=1,\n538|        run=\"TestAcquireForegroundRefusesRunningWithEmptyGeneration\",\n539|        expect=\"KILLED\",\n540|        note=\"Admits exactly running servers whose admission carries no generation past the Running arm; running servers with a generation still attach-or-refuse. Kill path: a second new-session spawns into the live server.\",\n541|    ),\n542|    Mutant(\n543|        name=\"N-verify-absence-detail\",\n544|        path=f\"{PACKAGE}/runtime_unix.go\",\n545|        find='\\tif err != nil {\\n\\t\\tif errors.Is(err, unix.ENOENT) {\\n\\t\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime absent\"}\\n\\t\\t}\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\\n\\t}\\n',\n546|        replace='\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\\n\\t}\\n',\n547|        count=1,\n548|        run=\"(TestVerifyRuntimeDirRefusesAbsence|TestAcquireBackgroundVerifiesWithoutCreating)\",\n549|        expect=\"KILLED\",\n550|        note=\"Admits exactly absent leaves past the absence detail (they report containment like an unsafe leaf); ENOTDIR/ELOOP and every other leaf failure still refuse containment. Narrowing, not a delete: the refusal stays, only the ENOENT arm is dropped. Kill paths: the Verify detail mismatch, and the background reroute to the custody code instead of the typed unavailable.\",\n551|    ),\n552|    Mutant(\n553|        name=\"N-background-absence-remap\",\n554|        path=f\"{PACKAGE}/acquire.go\",\n555|        find=\"\\tif runtimeAbsent(verr) {\\n\",\n556|        replace=\"\\tif runtimeAbsent(verr) && req.Platform != scalar.PlatformMacOS {\\n\",\n557|        count=1,\n558|        run=\"TestAcquireBackgroundVerifiesWithoutCreating\",\n559|        expect=\"KILLED\",\n560|        note=\"Admits exactly macOS absences past the unavailable remap (they return the custody code); absences on Linux/WSL2 still map. Kill path: the macOS background cold state reports tmux_unsafe_runtime_dir instead of capability_unavailable.\",\n561|    ),\n562|    Mutant(\n563|        name=\"N-absence-remap-widen\",\n564|        path=f\"{PACKAGE}/acquire.go\",\n565|        find='\\treturn local.Code == CodeUnsafeRuntimeDir && local.Detail == \"runtime absent\"\\n',\n566|        replace='\\treturn local.Code == CodeUnsafeRuntimeDir && (local.Detail == \"runtime absent\" || local.Detail == \"runtime mode\")\\n',\n567|        count=1,\n568|        run=\"TestAcquireBackgroundStagesVerifyCustodyRefusal\",\n569|        expect=\"KILLED\",\n570|        note=\"Admits exactly mode refusals past the absence classifier (a widened leaf maps to capability_unavailable with the custody refusal hidden as its redacted cause); absence still maps and every other unsafe-leaf refusal keeps its custody code. Kill path: the background custody test asserts the top-level *Error the caller renders.\",\n571|    ),\n572|    Mutant(\n573|        name=\"N-collision-tmuxenv-encoding\",\n574|        path=f\"{PACKAGE}/socket.go\",\n575|        find=\"\\tif i := strings.IndexByte(value, ','); i >= 0 {\\n\\t\\treturn value[:i]\\n\\t}\\n\",\n576|        replace=\"\\tif i := strings.IndexByte(value, ','); i >= 0 {\\n\\t\\treturn value\\n\\t}\\n\",\n577|        count=1,\n578|        run=\"(TestResolveSocketRefusesTMUXEnvRealEncoding|TestAcquireRefusesTMUXEnvCollisionRealEncoding)\",\n579|        expect=\"KILLED\",\n580|        note=\"Admits exactly TMUX values in the real <socket>,<pid>,<index> encoding past the socket-component arm; bare TMUX values still refuse byte-identical. Narrowing: the collision gate stays, only the component split is dropped.\",\n581|    ),\n582|    Mutant(\n583|        name=\"N-commit-eacces-as-exist\",\n584|        path=f\"{PACKAGE}/runtime_unix.go\",\n585|        find=\"\\tif !errors.Is(err, unix.EEXIST) {\\n\",\n586|        replace=\"\\tif !errors.Is(err, unix.EEXIST) && !errors.Is(err, unix.EACCES) {\\n\",\n587|        count=1,\n588|        run=\"TestEnsureRuntimeDirRefusesReadOnlyRoot\",\n589|        expect=\"KILLED\",\n(more lines below)","final_result":true}}}
