{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cf0d","stream":{"kind":"session","id":"01a0c54c-0ef4-78b3-96e2-4f10155428e6"},"sequence":1505,"recorded_at":1780531400003005,"record_type":"event","durability":"durable","causation_id":"a845ab6a-f3a6-48e7-a9d4-e4e3621097f9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a845ab6a-f3a6-48e7-a9d4-e4e3621097f9","run_stream":{"kind":"run","id":"a845ab6a-f3a6-48e7-a9d4-e4e3621097f9"},"task_stream":{"kind":"task","id":"01a0c55f-af9d-7c42-91cc-c3076e108b87"},"task_id":"01a0c55f-af9d-7c42-91cc-c3076e108b87","event":{"kind":"output","task_id":"01a0c55f-af9d-7c42-91cc-c3076e108b87","chunk":"edited\nchanged lines: lines 702-703\n--- original\n+++ updated\n@@\n-    Mutant(\n-        name=\"D-background-fallback\",\n+    Mutant(\n+        name=\"N-absence-remap-containment\",\n+        path=f\"{PACKAGE}/acquire.go\",\n+        find='\\treturn local.Code == CodeUnsafeRuntimeDir && local.Detail == \"runtime absent\"\\n',\n+        replace='\\treturn local.Code == CodeUnsafeRuntimeDir && (local.Detail == \"runtime absent\" || local.Detail == \"runtime containment\")\\n',\n+        count=1,\n+        run=\"TestAcquireBackgroundRefusesNonDirectoryLeaf\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly containment refusals past the absence classifier (a non-directory leaf maps to capability_unavailable with the custody refusal hidden as its redacted cause); absence still maps and every other unsafe-leaf refusal keeps its custody code. Kill path: the background non-directory test asserts the top-level *Error the caller renders.\",\n+    ),\n+    Mutant(\n+        name=\"N-absence-remap-invalid\",\n+        path=f\"{PACKAGE}/acquire.go\",\n+        find='\\treturn local.Code == CodeUnsafeRuntimeDir && local.Detail == \"runtime absent\"\\n',\n+        replace='\\treturn local.Code == CodeUnsafeRuntimeDir && local.Detail == \"runtime absent\" || local.Code == CodeInvalidArguments\\n',\n+        count=1,\n+        run=\"TestAcquireBackgroundMissingRootRefusesInvalid\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly malformed-input refusals past the absence classifier (a missing root maps to capability_unavailable instead of the invalid-arguments refusal the commit side reports); absence still maps and every custody refusal keeps its code. Kill path: the background missing-root test asserts the top-level invalid-arguments *Error the caller renders.\",\n+    ),\n+    Mutant(\n+        name=\"N-root-symlink-commit\",\n+        path=f\"{PACKAGE}/runtime_unix.go\",\n+        find=\"\\trootHandle, err := secprim.OpenNoFollowDir(root)\\n\\tif err != nil {\\n\\t\\treturn classifyRootOpenError(err)\\n\\t}\\n\\tdefer func() { _ = rootHandle.Close() }()\\n\\tif !handleBoundToPath(rootHandle, root) {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\\trootFd := int(rootHandle.Fd())\\n\",\n+        replace=\"\\trootHandle, err := secprim.OpenNoFollowDir(root)\\n\\tif err != nil {\\n\\t\\tif fi, lerr := os.Lstat(root); lerr == nil && fi.Mode()&os.ModeSymlink != 0 {\\n\\t\\t\\trootHandle, err = os.Open(root)\\n\\t\\t}\\n\\t\\tif err != nil {\\n\\t\\t\\treturn classifyRootOpenError(err)\\n\\t\\t}\\n\\t}\\n\\tdefer func() { _ = rootHandle.Close() }()\\n\\tif !handleBoundToPath(rootHandle, root) {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\\trootFd := int(rootHandle.Fd())\\n\",\n+        count=1,\n+        run=\"TestEnsureRuntimeDirRefusesSymlinkRoot\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly symlink roots past the commit-side no-follow open via a following fallback; missing, non-directory, and every other root-open failure still refuse through the shared classifier, and the verify side still refuses. Kill path: the entry commits the leaf inside the link target instead of refusing.\",\n+    ),\n+    Mutant(\n+        name=\"N-root-symlink-verify\",\n+        path=f\"{PACKAGE}/runtime_unix.go\",\n+        find=\"\\trootHandle, err := secprim.OpenNoFollowDir(root)\\n\\tif err != nil {\\n\\t\\treturn classifyRootOpenError(err)\\n\\t}\\n\\tdefer func() { _ = rootHandle.Close() }()\\n\\tif !handleBoundToPath(rootHandle, root) {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\\tleafFd, err := unix.Openat(int(rootHandle.Fd()), name,\\n\",\n+        replace=\"\\trootHandle, err := secprim.OpenNoFollowDir(root)\\n\\tif err != nil {\\n\\t\\tif fi, lerr := os.Lstat(root); lerr == nil && fi.Mode()&os.ModeSymlink != 0 {\\n\\t\\t\\trootHandle, err = os.Open(root)\\n\\t\\t}\\n\\t\\tif err != nil {\\n\\t\\t\\treturn classifyRootOpenError(err)\\n\\t\\t}\\n\\t}\\n\\tdefer func() { _ = rootHandle.Close() }()\\n\\tif !handleBoundToPath(rootHandle, root) {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\\tleafFd, err := unix.Openat(int(rootHandle.Fd()), name,\\n\",\n+        count=1,\n+        run=\"(TestVerifyRuntimeDirRefusesSymlinkRoot|TestAcquireBackgroundRefusesSymlinkLeaf)\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly symlink roots past the verify-side no-follow open via a following fallback; every other root-open failure still refuses, and the commit side still refuses. Kill paths: the direct verify test meets the absent detail inside the link target, and the background entry maps it to the typed unavailable instead of the containment refusal.\",\n+    ),\n+    Mutant(\n+        name=\"N-argv-detached\",\n+        path=f\"{PACKAGE}/argv.go\",\n+        find='\\t\\t\"new-session\",\\n\\t\\t\"-d\",\\n',\n+        replace='\\t\\t\"new-session\",\\n',\n+        count=1,\n+        run=\"(TestBuildArgvAddressesOnlyTheDerivedSocket|TestAcquireForegroundSpawnsDedicatedServer)\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the attached spawn vector past the fixed-shape builder (the spawned server would try to attach the caller terminal); every other vector element stays exact. One site, both entries: the exact-vector assertions fail at the helper and through the foreground entry alike.\",\n+    ),\n+    Mutant(\n+        name=\"N-argv-tail\",\n+        path=f\"{PACKAGE}/argv.go\",\n+        find='\\t\\t\"ax\", \"pane\", session.String(),\\n',\n+        replace='\\t\\t\"ax\", \"attach\", session.String(),\\n',\n+        count=1,\n+        run=\"(TestBuildArgvAddressesOnlyTheDerivedSocket|TestAcquireForegroundSpawnsDedicatedServer)\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the retargeted pane entrypoint past the fixed-shape builder; every other vector element stays exact. One site, both entries: the exact-vector assertions fail at the helper and through the foreground entry alike.\",\n+    ),\n+    Mutant(\n+        name=\"N-dispatch-foreground\",\n+        path=f\"{PACKAGE}/acquire.go\",\n+        find=\"\\tif req.Caller == CallerBackground {\\n\\t\\treturn acquireBackground(req, socket)\\n\\t}\\n\",\n+        replace=\"\\tif req.Caller == CallerBackground || req.Caller == CallerForeground {\\n\\t\\treturn acquireBackground(req, socket)\\n\\t}\\n\",\n+        count=1,\n+        run=\"TestAcquireForegroundSpawnsDedicatedServer\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly foreground callers to the background path; background callers still dispatch background. Kill path: the foreground spawn test refuses the background dependencies code instead of spawning.\",\n+    ),\n+    Mutant(\n+        name=\"N-dispatch-background\",\n+        path=f\"{PACKAGE}/acquire.go\",\n+        find=\"\\tif req.Caller == CallerBackground {\\n\\t\\treturn acquireBackground(req, socket)\\n\\t}\\n\",\n+        replace='\\tif req.Caller == \"Background\" {\\n\\t\\treturn acquireBackground(req, socket)\\n\\t}\\n',\n+        count=1,\n+        run=BG_MISS,\n+        expect=\"KILLED\",\n+        note=\"Admits exactly background callers to the foreground path (the capitalized twin still dispatches background); foreground callers are unaffected. Kill path: the background miss table spawns into the dedicated server instead of refusing the typed unavailable.\",\n+    ),\n+    Mutant(\n+        name=\"D-background-fallback\",\n","final_result":true}}}
