f err != nil {\n48|\t\tt.Fatal(err)\n49|\t}\n50|\tif info.Mode().Perm() != 0o700 {\n51|\t\tt.Fatalf(\"mode after re-ensure = %04o, want 0700\", info.Mode().Perm())\n52|\t}\n53|}\n54|\n55|func TestVerifyRuntimeDirAdmitsCompliant(t *testing.T) {\n56|\troot := runtimeRoot(t)\n57|\truntimeDir(t, root)\n58|\tif err := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS); err != nil {\n59|\t\tt.Fatal(err)\n60|\t}\n61|}\n62|\n63|func TestEnsureRuntimeDirRefusesWidenedMode(t *testing.T) {\n64|\troot := runtimeRoot(t)\n65|\tdir, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n66|\tif err != nil {\n67|\t\tt.Fatal(err)\n68|\t}\n69|\t// The suite widens the mode behind the entry's back; re-entry\n70|\t// must refuse, never silently repair.\n71|\tif err := os.Chmod(dir, 0o755); err != nil {\n72|\t\tt.Fatal(err)\n73|\t}\n74|\t_, err = EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n75|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime mode\")\n76|\tif err := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS); err != nil {\n77|\t\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime mode\")\n78|\t} else {\n79|\t\tt.Fatal(\"VerifyRuntimeDir admitted a 0755 directory\")\n80|\t}\n81|}\n82|\n83|// \"Exactly 0700\" is pinned on the narrower side too: a pre-existing\n84|// owner-narrower leaf (0600/0500) refuses the mode gate on both\n85|// entries, never converging by silent repair. The mode is set by an\n86|// explicit chmod so the fixture is exact under any test umask.\n87|func TestEnsureRuntimeDirRefusesNarrowerMode(t *testing.T) {\n88|\tfor _, tc := range []struct {\n89|\t\tname string\n90|\t\tperm os.FileMode\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
