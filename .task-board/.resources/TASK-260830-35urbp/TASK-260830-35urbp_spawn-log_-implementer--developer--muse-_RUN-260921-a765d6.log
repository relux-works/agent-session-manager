ndle-binding check; the mismatch still refuses for non-directories.\",\n141|    ),\n142|    Mutant(\n143|        name=\"N-containment-symlink\",\n144|        path=f\"{PACKAGE}/runtime_unix.go\",\n145|        find=\"\\tleafFd, err := unix.Openat(rootFd, name,\\n\\t\\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\",\n146|        replace=\"\\tleafFd, err := unix.Openat(rootFd, name,\\n\\t\\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\tif err != nil {\\n\\t\\tleafFd, err = unix.Openat(rootFd, name,\\n\\t\\t\\tunix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\t}\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\",\n147|        count=1,\n148|        run=\"TestEnsureRuntimeDirRefusesSymlinkLeaf\",\n149|        expect=\"KILLED\",\n150|        note=\"Admits exactly symlink leaves via an ELOOP fallback open; every other commit failure still refuses.\",\n151|    ),\n152|    Mutant(\n153|        name=\"N-containment-symlink-verify\",\n154|        path=f\"{PACKAGE}/runtime_unix.go\",\n155|        find=\"\\tleafFd, err := unix.Openat(int(rootHandle.Fd()), name,\\n\\t\\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\tif err != nil {\\n\\t\\tif errors.Is(err, unix.ENOENT) {\\n\\t\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime absent\\\"}\\n\\t\\t}\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\",\n156|        replace=\"\\tleafFd, err := unix.Openat(int(rootHandle.Fd()), name,\\n\\t\\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\tif err != nil {\\n\\t\\tleafFd, err = unix.Openat(int(rootHandle.Fd()), name,\\n\\t\\t\\tunix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\t}\\n\\tif err != nil {\\n\\t\\tif errors.Is(err, unix.ENOENT) {\\