\t\"tmux\",\n26|\t\t\"-S\", socket,\n27|\t\t\"new-session\",\n28|\t\t\"-d\",\n29|\t\t\"-s\", session.String(),\n30|\t\t\"ax\", \"pane\", session.String(),\n31|\t}\n32|\tif err := secprim.CheckArgv(argv); err != nil {\n33|\t\treturn nil, &Error{Code: CodeInvalidArguments, Detail: \"spawn argv\"}\n34|\t}\n35|\treturn argv, nil\n36|}","final_result":true}}}
