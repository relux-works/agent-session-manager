{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c625","stream":{"kind":"session","id":"01a0c54c-0ef4-78b3-96e2-4f10155428e6"},"sequence":365,"recorded_at":1780531400000725,"record_type":"event","durability":"durable","causation_id":"a845ab6a-f3a6-48e7-a9d4-e4e3621097f9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a845ab6a-f3a6-48e7-a9d4-e4e3621097f9","run_stream":{"kind":"run","id":"a845ab6a-f3a6-48e7-a9d4-e4e3621097f9"},"call_id":"call_01a0c54de14b775c8469a5000fb7277f","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-2t4g7i/worktree/internal/tmuxserver/acquire_test.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n11|)\n12|\n13|var errProbeBoom = errors.New(\"probe boom\")\n14|\n15|func TestAcquireForegroundSpawnsDedicatedServer(t *testing.T) {\n16|\troot := runtimeRoot(t)\n17|\treq := validRequest(t, root)\n18|\treq.Ambient = hostileAmbient()\n19|\tspy := &spawnSpy{}\n20|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n21|\t\treturn ServerReport{}, nil\n22|\t}\n23|\treq.Deps.Spawn = spy.spawn\n24|\toutcome, err := Acquire(req)\n25|\tif err != nil {\n26|\t\tt.Fatal(err)\n27|\t}\n28|\tif outcome.Via != \"spawned\" {\n29|\t\tt.Fatalf(\"via = %q, want spawned\", outcome.Via)\n30|\t}\n31|\tif outcome.Socket != SocketPath(filepath.Join(root, RuntimeDirName)) {\n32|\t\tt.Fatalf(\"socket = %q\", outcome.Socket)\n33|\t}\n34|\tif spy.calls != 1 || spy.socket != outcome.Socket {\n35|\t\tt.Fatalf(\"spawn calls = %d socket = %q\", spy.calls, spy.socket)\n36|\t}\n37|\tif len(spy.argv) < 3 || spy.argv[0] != \"tmux\" || spy.argv[1] != \"-S\" || spy.argv[2] != outcome.Socket {\n38|\t\tt.Fatalf(\"spawn argv = %q\", spy.argv)\n39|\t}\n40|\tfor i, ambient := range []string{req.Ambient.TMUXEnv, req.Ambient.TMUXTmpDir, req.Ambient.InheritedSocket, req.Ambient.DefaultPath, req.Ambient.ConventionalName} {\n41|\t\tif ambient == \"\" {\n42|\t\t\tcontinue\n43|\t\t}\n44|\t\tif outcome.Socket == ambient {\n45|\t\t\tt.Fatalf(\"socket reuses ambient vector %d\", i)\n46|\t\t}\n47|\t\tfor _, arg := range spy.argv {\n48|\t\t\tif arg == ambient {\n49|\t\t\t\tt.Fatalf(\"argv carries ambient vector %d: %q\", i, arg)\n50|\t\t\t}\n51|\t\t}\n52|\t}\n53|\twantTail := []string{\"ax\", \"pane\", fixtureSession}\n54|\ttail := spy.argv[len(spy.argv)-3:]\n55|\tfor i := range wantTail {\n56|\t\tif tail[i] != wantTail[i] {\n57|\t\t\tt.Fatalf(\"argv tail = %q, want %q\", tail, wantTail)\n58|\t\t}\n59|\t}\n60|}\n61|\n62|func socketDir(t *testing.T, root string) string {\n63|\tt.Helper()\n64|\treturn runtimeDir(t, root)\n65|}\n66|\n67|func TestAcquireForegroundAttachesToRunningAttested(t *testing.T) {\n68|\troot := runtimeRoot(t)\n69|\treq := validRequest(t, root)\n70|\tspy := &spawnSpy{}\n71|\tprobed := \"\"\n72|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n73|\t\tprobed = socket\n74|\t\treturn ServerReport{Running: true, Admission: boundAdmission()}, nil\n75|\t}\n76|\treq.Deps.Spawn = spy.spawn\n77|\toutcome, err := Acquire(req)\n78|\tif err != nil {\n79|\t\tt.Fatal(err)\n80|\t}\n81|\tif outcome.Via != \"attached-running\" {\n82|\t\tt.Fatalf(\"via = %q\", outcome.Via)\n83|\t}\n84|\tif probed != outcome.Socket || outcome.Socket != SocketPath(socketDir(t, root)) {\n85|\t\tt.Fatalf(\"probed = %q socket = %q\", probed, outcome.Socket)\n86|\t}\n87|\tif spy.calls != 0 {\n88|\t\tt.Fatalf(\"spawn calls = %d, want 0 on attach\", spy.calls)\n89|\t}\n90|}\n91|\n92|func TestAcquireForegroundRefusesRunningUnattested(t *testing.T) {\n93|\troot := runtimeRoot(t)\n94|\treq := validRequest(t, root)\n95|\tspy := &spawnSpy{}\n96|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n97|\t\treturn ServerReport{Running: true, Admission: RealmAdmission{\n98|\t\t\tAdmitted:      terminalbackend.Admitted{Capabilities: []string{fixtureDecoyCapacity}},\n99|\t\t\tRawGeneration: fixtureGeneration,\n100|\t\t}}, nil\n101|\t}\n102|\treq.Deps.Spawn = spy.spawn\n103|\t_, err := Acquire(req)\n104|\trequireLocalError(t, err, \"tmux_readiness_not_authorizing\", \"server attestation\")\n105|\tif spy.calls != 0 {\n106|\t\tt.Fatalf(\"spawn calls = %d, want 0 on unattested\", spy.calls)\n107|\t}\n108|}\n109|\n110|// A stale admission — yesterday's live proof replayed against today's\n111|// typed generation — fakes no running attested server: attach refuses\n112|// on the generation arm with no spawn and no repair.\n113|func TestAcquireForegroundRefusesWrongGenerationAdmission(t *testing.T) {\n114|\troot := runtimeRoot(t)\n115|\treq := validRequest(t, root)\n116|\tspy := &spawnSpy{}\n117|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n118|\t\treturn ServerReport{Running: true, Admission: staleAdmission()}, nil\n119|\t}\n120|\treq.Deps.Spawn = spy.spawn\n121|\t_, err := Acquire(req)\n122|\trequireLocalError(t, err, \"tmux_readiness_not_authorizing\", \"server generation\")\n123|\tif spy.calls != 0 {\n124|\t\tt.Fatalf(\"spawn calls = %d, want 0 on stale admission\", spy.calls)\n125|\t}\n126|}\n127|\n128|// The realistic post-spawn state — the server runs, no evidence has\n129|// been reconciled yet, the admission carries nothing — refuses\n130|// through the entry with no second spawn: a running server with zero\n131|// admission rows is still running, never absent.\n132|func TestAcquireForegroundRefusesRunningWithEmptyAdmission(t *testing.T) {\n133|\troot := runtimeRoot(t)\n134|\treq := validRequest(t, root)\n135|\tspy := &spawnSpy{}\n136|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n137|\t\treturn ServerReport{Running: true, Admission: RealmAdmission{}}, nil\n138|\t}\n139|\treq.Deps.Spawn = spy.spawn\n140|\t_, err := Acquire(req)\n141|\trequireLocalError(t, err, \"tmux_readiness_not_authorizing\", \"server attestation\")\n142|\tif spy.calls != 0 {\n143|\t\tt.Fatalf(\"spawn calls = %d, want 0 on a running server\", spy.calls)\n144|\t}\n145|}\n146|\n147|// Same rule one member over: a running server whose admission\n148|// carries the realm row but no generation refuses on the generation\n149|// arm through the entry with no second spawn.\n150|func TestAcquireForegroundRefusesRunningWithEmptyGeneration(t *testing.T) {\n151|\troot := runtimeRoot(t)\n152|\treq := validRequest(t, root)\n153|\tspy := &spawnSpy{}\n154|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n155|\t\treturn ServerReport{Running: true, Admission: RealmAdmission{\n156|\t\t\tAdmitted: realmAdmitted(),\n157|\t\t}}, nil\n158|\t}\n159|\treq.Deps.Spawn = spy.spawn\n160|\t_, err := Acquire(req)\n161|\trequireLocalError(t, err, \"tmux_readiness_not_authorizing\", \"server generation\")\n162|\tif spy.calls != 0 {\n163|\t\tt.Fatalf(\"spawn calls = %d, want 0 on a running server\", spy.calls)\n164|\t}\n165|}\n166|\n167|func TestAcquireForegroundProbeFailurePassesThrough(t *testing.T) {\n168|\troot := runtimeRoot(t)\n169|\treq := validRequest(t, root)\n170|\tspy := &spawnSpy{}\n171|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n172|\t\treturn ServerReport{}, errProbeBoom\n173|\t}\n174|\treq.Deps.Spawn = spy.spawn\n175|\t_, err := Acquire(req)\n176|\tif !errors.Is(err, errProbeBoom) {\n177|\t\tt.Fatalf(\"err = %v, want the probe failure\", err)\n178|\t}\n179|\tif spy.calls != 0 {\n180|\t\tt.Fatalf(\"spawn calls = %d, want 0 on unknown\", spy.calls)\n181|\t}\n182|}\n183|\n184|func TestAcquireForegroundSpawnFailureReportsWithoutFallback(t *testing.T) {\n185|\troot := runtimeRoot(t)\n186|\treq := validRequest(t, root)\n187|\tspy := &spawnSpy{err: errors.New(\"exec failed\")}\n188|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n189|\t\treturn ServerReport{}, nil\n190|\t}\n191|\treq.Deps.Spawn = spy.spawn\n192|\t_, err := Acquire(req)\n193|\trequireLocalError(t, err, \"tmux_server_spawn_failed\", \"server spawn\")\n194|\tif spy.calls != 1 {\n195|\t\tt.Fatalf(\"spawn calls = %d, want exactly 1\", spy.calls)\n196|\t}\n197|}\n198|\n199|func TestAcquireForegroundRefusesMalformedSession(t *testing.T) {\n200|\troot := runtimeRoot(t)\n201|\treq := validRequest(t, root)\n202|\treq.SessionID = \"12345\"\n203|\tspy := &spawnSpy{}\n204|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n205|\t\treturn ServerReport{}, nil\n206|\t}\n207|\treq.Deps.Spawn = spy.spawn\n208|\t_, err := Acquire(req)\n209|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"session identity\")\n210|\tif spy.calls != 0 {\n211|\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n212|\t}\n213|}\n214|\n215|func TestAcquireBackgroundContactsBroker(t *testing.T) {\n216|\troot := runtimeRoot(t)\n217|\truntimeDir(t, root)\n218|\treq := validRequest(t, root)\n219|\treq.Caller = CallerBackground\n220|\treq.Platform = scalar.PlatformMacOS\n221|\tspy := &spawnSpy{}\n222|\tprobe := &probeServerSpy{}\n223|\tprobed := false\n224|\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n225|\t\tprobed = true\n226|\t\treturn brokerReport(), nil\n227|\t}\n228|\treq.Deps.Spawn = spy.spawn\n229|\treq.Deps.ProbeServer = probe.probe\n230|\toutcome, err := Acquire(req)\n231|\tif err != nil {\n232|\t\tt.Fatal(err)\n233|\t}\n234|\tif !probed {\n235|\t\tt.Fatal(\"broker was not probed\")\n236|\t}\n237|\tif outcome.Via != \"broker\" {\n238|\t\tt.Fatalf(\"via = %q\", outcome.Via)\n239|\t}\n240|\tif outcome.Socket != SocketPath(socketDir(t, root)) {\n241|\t\tt.Fatalf(\"socket = %q\", outcome.Socket)\n242|\t}\n243|\tif len(outcome.Argv) != 0 {\n244|\t\tt.Fatalf(\"broker outcome carries argv %q\", outcome.Argv)\n245|\t}\n246|\tif spy.calls != 0 {\n247|\t\tt.Fatalf(\"spawn calls = %d, want 0 on broker contact\", spy.calls)\n248|\t}\n249|\tprobe.requireSilent(t)\n250|}\n251|\n252|func TestAcquireBackgroundMissReturnsTypedUnavailable(t *testing.T) {\n253|\tlive := brokerReport()\n254|\tfor _, tc := range []struct {\n255|\t\tname   string\n256|\t\treport BrokerReport\n257|\t}{\n258|\t\t{\"no broker\", BrokerReport{}},\n259|\t\t{\"foreign-user broker\", BrokerReport{\n260|\t\t\tPrincipal: BrokerPrincipal{UID: foreignUID(), Generation: fixtureGeneration},\n261|\t\t\tServer:    boundAdmission(),\n262|\t\t}},\n263|\t\t{\"generation-unbound principal\", BrokerReport{\n264|\t\t\tPrincipal: BrokerPrincipal{UID: live.Principal.UID, Generation: fixtureStaleGen},\n265|\t\t\tServer:    boundAdmission(),\n266|\t\t}},\n267|\t\t{\"unattested server\", BrokerReport{\n268|\t\t\tPrincipal: live.Principal,\n269|\t\t\tServer:    RealmAdmission{RawGeneration: fixtureGeneration},\n270|\t\t}},\n271|\t\t{\"stale server admission\", BrokerReport{\n272|\t\t\tPrincipal: live.Principal,\n273|\t\t\tServer:    staleAdmission(),\n274|\t\t}},\n275|\t\t{\"zero server admission\", BrokerReport{\n276|\t\t\tPrincipal: live.Principal,\n277|\t\t\tServer:    RealmAdmission{},\n278|\t\t}},\n279|\t\t{\"admitted server without generation\", BrokerReport{\n280|\t\t\tPrincipal: live.Principal,\n281|\t\t\tServer:    RealmAdmission{Admitted: realmAdmitted()},\n282|\t\t}},\n283|\t\t{\"decoy-only server admission\", BrokerReport{\n284|\t\t\tPrincipal: live.Principal,\n285|\t\t\tServer: RealmAdmission{\n286|\t\t\t\tAdmitted:      terminalbackend.Admitted{Capabilities: []string{fixtureDecoyCapacity}},\n287|\t\t\t\tRawGeneration: fixtureGeneration,\n288|\t\t\t},\n289|\t\t}},\n290|\t} {\n291|\t\tt.Run(tc.name, func(t *testing.T) {\n292|\t\t\troot := runtimeRoot(t)\n293|\t\t\truntimeDir(t, root)\n294|\t\t\treq := validRequest(t, root)\n295|\t\t\treq.Caller = CallerBackground\n296|\t\t\treq.Platform = scalar.PlatformMacOS\n297|\t\t\tspy := &spawnSpy{}\n298|\t\t\tprobe := &probeServerSpy{}\n299|\t\t\t// Even dependencies that would succeed must never run:\n300|\t\t\t// the miss path has no fallback to direct creation,\n301|\t\t\t// neither through the spawner nor through a re-entered\n302|\t\t\t// foreground probe.\n303|\t\t\treq.Deps.Spawn = spy.spawn\n304|\t\t\treq.Deps.ProbeServer = probe.probe\n305|\t\t\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n306|\t\t\t\treturn tc.report, nil\n307|\t\t\t}\n308|\t\t\t_, err := Acquire(req)\n309|\t\t\trequireCapabilityUnavailable(t, err, \"background\", fixtureBroker, fixtureGeneration, fixtureRemedy)\n310|\t\t\tif spy.calls != 0 {\n311|\t\t\t\tt.Fatalf(\"spawn calls = %d, want 0 without fallback\", spy.calls)\n312|\t\t\t}\n313|\t\t\tprobe.requireSilent(t)\n314|\t\t})\n315|\t}\n316|}\n317|\n318|func TestAcquireBackgroundMissOnLinuxAlsoRefusesWithoutFallback(t *testing.T) {\n319|\troot := runtimeRoot(t)\n320|\truntimeDir(t, root)\n321|\treq := validRequest(t, root)\n322|\treq.Caller = CallerBackground\n323|\treq.Platform = scalar.PlatformLinux\n324|\tspy := &spawnSpy{}\n325|\tprobe := &probeServerSpy{}\n326|\treq.Deps.Spawn = spy.spawn\n327|\treq.Deps.ProbeServer = probe.probe\n328|\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n329|\t\treturn BrokerReport{}, nil\n330|\t}\n331|\t_, err := Acquire(req)\n332|\trequireCapabilityUnavailable(t, err, \"background\", fixtureBroker, fixtureGeneration, fixtureRemedy)\n333|\tif spy.calls != 0 {\n334|\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n335|\t}\n336|\tprobe.requireSilent(t)\n337|}\n338|\n339|// Background acquisition verifies the runtime directory instead of\n340|// creating it. A missing leaf is the ordinary post-reboot cold\n341|// state — the Runtime IPC root is a per-user temporary directory —\n342|// so absence returns the typed capability_unavailable with the\n343|// request's realm/readiness details, and the refusal probes no\n344|// broker, spawns nothing, and leaves no directory behind: a\n345|// background caller performs no durable write.\n346|func TestAcquireBackgroundVerifiesWithoutCreating(t *testing.T) {\n347|\t// The cold state is the same on every unix platform: $XDG_RUNTIME_DIR\n348|\t// is tmpfs on Linux/WSL2, so a background restore worker there meets\n349|\t// the absent leaf exactly like the macOS caller. Each platform maps\n350|\t// the absence to the typed unavailable — never the custody code.\n351|\tfor _, platform := range []scalar.Platform{scalar.PlatformMacOS, scalar.PlatformLinux, scalar.PlatformWSL2} {\n352|\t\tt.Run(string(platform), func(t *testing.T) {\n353|\t\t\troot := runtimeRoot(t)\n354|\t\t\treq := validRequest(t, root)\n355|\t\t\treq.Caller = CallerBackground\n356|\t\t\treq.Platform = platform\n357|\t\t\tprobed := false\n358|\t\t\tspy := &spawnSpy{}\n359|\t\t\tserverProbe := &probeServerSpy{}\n360|\t\t\treq.Deps.Spawn = spy.spawn\n361|\t\t\treq.Deps.ProbeServer = serverProbe.probe\n362|\t\t\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n363|\t\t\t\tprobed = true\n364|\t\t\t\treturn brokerReport(), nil\n365|\t\t\t}\n366|\t\t\t_, err := Acquire(req)\n367|\t\t\trequireCapabilityUnavailable(t, err, \"background\", fixtureBroker, fixtureGeneration, fixtureRemedy)\n368|\t\t\tif probed {\n369|\t\t\t\tt.Fatal(\"broker was probed for an absent runtime directory\")\n370|\t\t\t}\n371|\t\t\tif spy.calls != 0 {\n372|\t\t\t\tt.Fatalf(\"spawn calls = %d, want 0 on absence\", spy.calls)\n373|\t\t\t}\n374|\t\t\tserverProbe.requireSilent(t)\n375|\t\t\tif _, statErr := os.Lstat(filepath.Join(root, RuntimeDirName)); !os.IsNotExist(statErr) {\n376|\t\t\t\tt.Fatalf(\"background refusal created the directory: stat err = %v\", statErr)\n377|\t\t\t}\n378|\t\t})\n379|\t}\n380|}\n381|\n382|// A missing runtime root is not a missing leaf: the root input names\n383|// nothing the leaf could live under, so the background path refuses\n384|// it as malformed input — the same code the commit side reports —\n385|// without probing the broker.\n386|func TestAcquireBackgroundMissingRootRefusesInvalid(t *testing.T) {\n387|\troot := filepath.Join(runtimeRoot(t), \"no-such-root\")\n388|\treq := validRequest(t, root)\n389|\treq.Caller = CallerBackground\n390|\tprobed := false\n391|\tspy := &spawnSpy{}\n392|\tprobe := &probeServerSpy{}\n393|\treq.Deps.Spawn = spy.spawn\n394|\treq.Deps.ProbeServer = probe.probe\n395|\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n396|\t\tprobed = true\n397|\t\treturn brokerReport(), nil\n398|\t}\n399|\t_, err := Acquire(req)\n400|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"runtime root\")\n401|\tif probed {\n402|\t\tt.Fatal(\"broker was probed past a missing root\")\n403|\t}\n404|\tif spy.calls != 0 {\n405|\t\tt.Fatalf(\"spawn calls = %d, want 0 past a missing root\", spy.calls)\n406|\t}\n407|\tprobe.requireSilent(t)\n408|}\n409|\n410|// The acquisition entry derives the spec's socket path on both caller\n411|// paths: the outcome socket equals <Root>/tmux/ax.sock with both leaves\n412|// asserted as spec literals — not via the production constants — so a\n413|// renamed constant or a caller-selectable leaf reddens here.\n414|func TestAcquireOutcomeSocketEqualsSpecPath(t *testing.T) {\n415|\tt.Run(\"foreground\", func(t *testing.T) {\n416|\t\troot := runtimeRoot(t)\n417|\t\treq := validRequest(t, root)\n418|\t\tspy := &spawnSpy{}\n419|\t\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n420|\t\t\treturn ServerReport{}, nil\n421|\t\t}\n422|\t\treq.Deps.Spawn = spy.spawn\n423|\t\toutcome, err := Acquire(req)\n424|\t\tif err != nil {\n425|\t\t\tt.Fatal(err)\n426|\t\t}\n427|\t\tif want := filepath.Join(root, \"tmux\", \"ax.sock\"); outcome.Socket != want {\n428|\t\t\tt.Fatalf(\"socket = %q, want %q\", outcome.Socket, want)\n429|\t\t}\n430|\t})\n431|\tt.Run(\"background\", func(t *testing.T) {\n432|\t\troot := runtimeRoot(t)\n433|\t\truntimeDir(t, root)\n434|\t\treq := validRequest(t, root)\n435|\t\treq.Caller = CallerBackground\n436|\t\tspy := &spawnSpy{}\n437|\t\tprobe := &probeServerSpy{}\n438|\t\treq.Deps.Spawn = spy.spawn\n439|\t\treq.Deps.ProbeServer = probe.probe\n440|\t\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n441|\t\t\treturn brokerReport(), nil\n442|\t\t}\n443|\t\toutcome, err := Acquire(req)\n444|\t\tif err != nil {\n445|\t\t\tt.Fatal(err)\n446|\t\t}\n447|\t\tif want := filepath.Join(root, \"tmux\", \"ax.sock\"); outcome.Socket != want {\n448|\t\t\tt.Fatalf(\"socket = %q, want %q\", outcome.Socket, want)\n449|\t\t}\n450|\t\tif spy.calls != 0 {\n451|\t\t\tt.Fatalf(\"spawn calls = %d, want 0 on broker contact\", spy.calls)\n452|\t\t}\n453|\t\tprobe.requireSilent(t)\n454|\t})\n455|}\n456|\n457|// A commit-phase custody refusal staged through the foreground entry:\n458|// the suite widens the mode behind the entry's back, and acquisition\n459|// refuses without probing or spawning.\n460|func TestAcquireForegroundStagesCommitPhaseCustodyRefusal(t *testing.T) {\n461|\troot := runtimeRoot(t)\n462|\tdir, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n463|\tif err != nil {\n464|\t\tt.Fatal(err)\n465|\t}\n466|\tif err := os.Chmod(dir, 0o755); err != nil {\n467|\t\tt.Fatal(err)\n468|\t}\n469|\treq := validRequest(t, root)\n470|\tspy := &spawnSpy{}\n471|\tprobed := false\n472|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n473|\t\tprobed = true\n474|\t\treturn ServerReport{}, nil\n475|\t}\n476|\treq.Deps.Spawn = spy.spawn\n477|\t_, err = Acquire(req)\n478|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime mode\")\n479|\tif probed {\n480|\t\tt.Fatal(\"server was probed past a custody refusal\")\n481|\t}\n482|\tif spy.calls != 0 {\n483|\t\tt.Fatalf(\"spawn calls = %d, want 0 past a custody refusal\", spy.calls)\n484|\t}\n485|}\n486|\n487|// The background verify wiring refuses a widened directory through the\n488|// entry with no broker contact.\n489|func TestAcquireBackgroundStagesVerifyCustodyRefusal(t *testing.T) {\n490|\troot := runtimeRoot(t)\n491|\tdir, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n492|\tif err != nil {\n493|\t\tt.Fatal(err)\n494|\t}\n495|\tif err := os.Chmod(dir, 0o755); err != nil {\n496|\t\tt.Fatal(err)\n497|\t}\n498|\treq := validRequest(t, root)\n499|\treq.Caller = CallerBackground\n500|\tspy := &spawnSpy{}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
