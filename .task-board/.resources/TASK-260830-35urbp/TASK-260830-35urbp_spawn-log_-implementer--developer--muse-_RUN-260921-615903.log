{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c881","stream":{"kind":"session","id":"01a0c4ab-e99a-71a1-b01c-d4e1f789add0"},"sequence":667,"recorded_at":1780531400001329,"record_type":"event","durability":"durable","causation_id":"e9eaa535-0e9f-444e-ac97-d216243d9df7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e9eaa535-0e9f-444e-ac97-d216243d9df7","run_stream":{"kind":"run","id":"e9eaa535-0e9f-444e-ac97-d216243d9df7"},"task_stream":{"kind":"task","id":"01a0c4ad-dbed-73a1-9e19-6abcbbcb65f4"},"task_id":"01a0c4ad-dbed-73a1-9e19-6abcbbcb65f4","event":{"kind":"output","task_id":"01a0c4ad-dbed-73a1-9e19-6abcbbcb65f4","chunk":"Read text file `internal/tmuxserver/mutant_harness.py`.\n(499 line(s) above)\n500|        note=\"Admits exactly the PID-form session past our wiring of the landed UUIDv7 grammar; every other malformed session still refuses.\",\n501|    ),\n502|    Mutant(\n503|        name=\"N-deps-background\",\n504|        path=f\"{PACKAGE}/acquire.go\",\n505|        find=\"\\tif req.Deps.ProbeBroker == nil {\\n\",\n506|        replace=\"\\tif req.Deps.ProbeBroker == nil && req.Deps.Spawn == nil {\\n\",\n507|        count=1,\n508|        run=\"TestAcquireBackgroundNilBrokerWithSpawnRefuses\",\n509|        expect=\"KILLED\",\n510|        note=\"Admits exactly the nil-probe-with-spawn background request past the dependencies arm; the fully-nil request still refuses. Kill path: the admitted request reaches Verify on the absent leaf and reports the typed unavailable instead of the dependencies code.\",\n511|    ),\n512|    Mutant(\n513|        name=\"N-deps-foreground\",\n514|        path=f\"{PACKAGE}/acquire.go\",\n515|        find=\"\\tif req.Deps.ProbeServer == nil || req.Deps.Spawn == nil {\\n\",\n516|        replace=\"\\tif req.Deps.ProbeServer == nil && req.Deps.Spawn == nil {\\n\",\n517|        count=1,\n518|        run=\"TestAcquireForegroundNilSpawnWithProbeRefuses\",\n519|        expect=\"KILLED\",\n520|        note=\"Admits exactly the half-nil foreground dependencies past the arm; fully-nil dependencies still refuse. Kill path: the admitted request panics on the nil spawn, and the panic fails the test.\",\n521|    ),\n522|    Mutant(\n523|        name=\"N-running-empty-admission\",\n524|        path=f\"{PACKAGE}/acquire.go\",\n525|        find=\"\\tif report.Running {\\n\",\n526|        replace=\"\\tif report.Running && len(report.Admission.Admitted.Capabilities) > 0 {\\n\",\n527|        count=1,\n528|        run=\"TestAcquireForegroundRefusesRunningWithEmptyAdmission\",\n529|        expect=\"KILLED\",\n530|        note=\"Admits exactly running servers with zero admission rows past the Running arm (they are treated as absent and spawned into); running servers with admission data still attach-or-refuse. Kill path: a second new-session spawns into the live server.\",\n531|    ),\n532|    Mutant(\n533|        name=\"N-running-empty-generation\",\n534|        path=f\"{PACKAGE}/acquire.go\",\n535|        find=\"\\tif report.Running {\\n\",\n536|        replace='\\tif report.Running && report.Admission.RawGeneration != \"\" {\\n',\n537|        count=1,\n538|        run=\"TestAcquireForegroundRefusesRunningWithEmptyGeneration\",\n539|        expect=\"KILLED\",\n540|        note=\"Admits exactly running servers whose admission carries no generation past the Running arm; running servers with a generation still attach-or-refuse. Kill path: a second new-session spawns into the live server.\",\n541|    ),\n542|    Mutant(\n543|        name=\"N-verify-absence-detail\",\n544|        path=f\"{PACKAGE}/runtime_unix.go\",\n545|        find='\\tif err != nil {\\n\\t\\tif errors.Is(err, unix.ENOENT) {\\n\\t\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime absent\"}\\n\\t\\t}\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\\n\\t}\\n',\n546|        replace='\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\\n\\t}\\n',\n547|        count=1,\n548|        run=\"(TestVerifyRuntimeDirRefusesAbsence|TestAcquireBackgroundVerifiesWithoutCreating)\",\n549|        expect=\"KILLED\",\n550|        note=\"Admits exactly absent leaves past the absence detail (they report containment like an unsafe leaf); ENOTDIR/ELOOP and every other leaf failure still refuse containment. Narrowing, not a delete: the refusal stays, only the ENOENT arm is dropped. Kill paths: the Verify detail mismatch, and the background reroute to the custody code instead of the typed unavailable.\",\n551|    ),\n552|    Mutant(\n553|        name=\"N-background-absence-remap\",\n554|        path=f\"{PACKAGE}/acquire.go\",\n555|        find=\"\\tif runtimeAbsent(verr) {\\n\",\n556|        replace=\"\\tif runtimeAbsent(verr) && req.Name != RuntimeDirName {\\n\",\n557|        count=1,\n558|        run=\"TestAcquireBackgroundVerifiesWithoutCreating\",\n559|        expect=\"KILLED\",\n560|        note=\"Admits exactly the canonical-leaf absence past the unavailable remap (it returns the custody code); absences under any other leaf name still map. Kill path: the background cold state reports tmux_unsafe_runtime_dir instead of capability_unavailable.\",\n561|    ),\n562|    Mutant(\n563|        name=\"N-collision-tmuxenv-encoding\",\n564|        path=f\"{PACKAGE}/socket.go\",\n565|        find=\"\\tif i := strings.IndexByte(value, ','); i >= 0 {\\n\\t\\treturn value[:i]\\n\\t}\\n\",\n566|        replace=\"\\tif i := strings.IndexByte(value, ','); i >= 0 {\\n\\t\\treturn value\\n\\t}\\n\",\n567|        count=1,\n568|        run=\"(TestResolveSocketRefusesTMUXEnvRealEncoding|TestAcquireRefusesTMUXEnvCollisionRealEncoding)\",\n569|        expect=\"KILLED\",\n570|        note=\"Admits exactly TMUX values in the real <socket>,<pid>,<index> encoding past the socket-component arm; bare TMUX values still refuse byte-identical. Narrowing: the collision gate stays, only the component split is dropped.\",\n571|    ),\n572|    Mutant(\n573|        name=\"N-commit-eacces-as-exist\",\n574|        path=f\"{PACKAGE}/runtime_unix.go\",\n575|        find=\"\\tif !errors.Is(err, unix.EEXIST) {\\n\",\n576|        replace=\"\\tif !errors.Is(err, unix.EEXIST) && !errors.Is(err, unix.EACCES) {\\n\",\n577|        count=1,\n578|        run=\"TestEnsureRuntimeDirRefusesReadOnlyRoot\",\n579|        expect=\"KILLED\",\n580|        note=\"Admits exactly EACCES past the exists-check (a permission failure is treated as an existing leaf); every other mkdir failure still reports the commit detail. Kill reroutes to the runtime-absent refusal — still fail-closed, hence a detail mismatch, not an admission.\",\n581|    ),\n582|    Mutant(\n583|        name=\"N-override-whitespace\",\n584|        path=f\"{PACKAGE}/socket.go\",\n585|        find='\\tif override != \"\" {\\n',\n586|        replace='\\tif override != \"\" && override != \"  \" {\\n',\n587|        count=1,\n588|        run=f\"{OVERRIDE}/whitespace_only\",\n589|        expect=\"KILLED\",\n590|        note=\"Admits exactly the two-space override past the non-empty arm; every other override still refuses. Kill path: the admitted request proceeds to spawn instead of refusing.\",\n591|    ),\n592|    Mutant(\n593|        name=\"N-root-missing-classify\",\n594|        path=f\"{PACKAGE}/runtime_unix.go\",\n595|        find='func classifyRootOpenError(err error) error {\\n\\tif os.IsNotExist(err) || errors.Is(err, os.ErrNotExist) {\\n\\t\\treturn &Error{Code: CodeInvalidArguments, Detail: \"runtime root\"}\\n\\t}\\n\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\\n}\\n',\n596|        replace='func classifyRootOpenError(err error) error {\\n\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\\n}\\n',\n597|        count=1,\n598|        run=\"(TestEnsureRuntimeDirRefusesBadRoots|TestVerifyRuntimeDirRefusesMissingRoot)\",\n599|        expect=\"KILLED\",\n600|        note=\"Admits exactly missing roots past the shared invalid-arguments mapping (they report containment); every other root-open failure still refuses containment. One site, both entries: killed by the missing-root tests on the commit and verify sides.\",\n601|    ),\n602|    Mutant(\n603|        name=\"D-background-fallback\",\n604|        path=f\"{PACKAGE}/acquire.go\",\n605|        find=\"\\t\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\n\\t\\t\\treturn Outcome{}, backgroundUnavailable(req, err)\\n\\t\\t}\\n\",\n606|        replace=\"\\t\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\n\\t\\t\\tif req.Deps.Spawn != nil {\\n\\t\\t\\t\\t_ = req.Deps.Spawn(socket, nil)\\n\\t\\t\\t}\\n\\t\\t\\treturn Outcome{}, backgroundUnavailable(req, err)\\n\\t\\t}\\n\",\n607|        count=1,\n608|        run=BG_MISS_LINUX,\n609|        expect=\"KILLED\",\n610|        note=\"SUPPLEMENTARY ADDITIVE, not a narrowing: plants the reviewer-shaped direct-creation call on the background miss path. Kill path: every background-miss spy asserts zero spawn calls.\",\n611|    ),\n612|    Mutant(\n613|        name=\"C-control\",\n614|        path=f\"{PACKAGE}/errors.go\",\n615|        find=\"// Error is a package-local refusal. Code is one of the Code*\",\n616|        replace=\"// Error is a package-local refusal (harness control: comment-only). Code is one of the Code*\",\n617|        count=1,\n618|        run=\"TestSocketPathDerivesOnlyFromRuntimeDir\",\n619|        expect=\"SURVIVED\",\n620|        note=\"Harmless control: a comment-only edit that must SURVIVE, proving the harness observes outcomes.\",\n621|    ),\n622|]\n623|\n624|\n625|def apply(mutant: Mutant, original: str) -> str:\n626|    return original.replace(mutant.find, mutant.replace)\n627|\n628|\n629|def run_mutant(mutant: Mutant, log_dir: Path | None) -> str:\n630|    target = REPO / mutant.path\n631|    original = target.read_text()\n632|    found = original.count(mutant.find)\n633|    if found != mutant.count:\n634|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\"\n635|    with tempfile.TemporaryDirectory() as staging:\n636|        backup = Path(staging) / \"backup\"\n637|        shutil.copy2(target, backup)\n638|        try:\n639|            target.write_text(apply(mutant, original))\n640|            run = subprocess.run(\n641|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n642|                cwd=REPO,\n643|                capture_output=True,\n644|                text=True,\n645|                timeout=300,\n646|            )\n647|        finally:\n648|            shutil.copy2(backup, target)\n649|    output = (run.stdout + run.stderr).strip()\n650|    if os.environ.get(\"AX_MUTANT_VERBOSE\") == \"1\":\n651|        print(f\"--- raw: {mutant.name}: exit {run.returncode} ---\", flush=True)\n652|        print(output, flush=True)\n653|        print(f\"--- end raw: {mutant.name} ---\", flush=True)\n654|    if log_dir is not None:\n655|        (log_dir / f\"{mutant.name}.log\").write_text(\n656|            f\"exit: {run.returncode}\\nrun: go test ./{PACKAGE}/ -run {mutant.run} -count=1\\n\\n{output}\\n\"\n657|        )\n658|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n659|        return f\"ERROR: {mutant.name}: build broke under the patch\"\n660|    if run.returncode == 0:\n661|        verdict = \"SURVIVED\"\n662|    elif '--- FAIL' in output or 'FAIL:' in output:\n663|        verdict = \"KILLED\"\n664|    else:\n665|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\"\n666|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n667|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note} [exit {run.returncode}]\"\n668|\n669|\n670|def main(argv: list[str]) -> int:\n671|    log_dir: Path | None = None\n672|    names = list(argv)\n673|    if \"--log-dir\" in names:\n674|        idx = names.index(\"--log-dir\")\n675|        if idx + 1 >= len(names):\n676|            print(\"--log-dir needs a directory\")\n677|            return 2\n678|        log_dir = Path(names[idx + 1])\n679|        log_dir.mkdir(parents=True, exist_ok=True)\n680|        del names[idx : idx + 2]\n681|    selected = [m for m in MUTANTS if not names or m.name in names]\n682|    if names and len(selected) != len(names):\n683|        unknown = sorted(set(names) - {m.name for m in selected})\n684|        print(f\"unknown mutants: {', '.join(unknown)}\")\n685|        return 2\n686|    failures = 0\n687|    for mutant in selected:\n688|        try:\n689|            line = run_mutant(mutant, log_dir)\n690|        except subprocess.TimeoutExpired:\n691|            line = f\"ERROR: {mutant.name}: killer timed out\"\n692|        print(line, flush=True)\n693|        if not line.startswith(\"ok:\"):\n694|            failures += 1\n695|    return 1 if failures else 0\n696|\n697|\n698|if __name__ == \"__main__\":\n699|    sys.exit(main(sys.argv[1:]))","final_result":true}}}
