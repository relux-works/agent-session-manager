{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c74f","stream":{"kind":"session","id":"01a0c4ab-e99a-71a1-b01c-d4e1f789add0"},"sequence":514,"recorded_at":1780531400001023,"record_type":"event","durability":"durable","causation_id":"e9eaa535-0e9f-444e-ac97-d216243d9df7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e9eaa535-0e9f-444e-ac97-d216243d9df7","run_stream":{"kind":"run","id":"e9eaa535-0e9f-444e-ac97-d216243d9df7"},"task_stream":{"kind":"task","id":"01a0c4ad-488a-7ca3-92eb-c35b70983684"},"task_id":"01a0c4ad-488a-7ca3-92eb-c35b70983684","event":{"kind":"output","task_id":"01a0c4ad-488a-7ca3-92eb-c35b70983684","chunk":"Read text file `internal/tmuxserver/acquire.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"errors\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/axpane\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|// Caller names the acquisition caller. The vocabulary is owned by\n12|// internal/axpane, which already gates the wrapper decision over it;\n13|// this package reuses its constants rather than retyping them.\n14|type Caller = string\n15|\n16|const (\n17|\t// CallerForeground is an interactive operator-side caller that\n18|\t// may create the dedicated server.\n19|\tCallerForeground = axpane.CallerForeground\n20|\t// CallerBackground is a background CLI, SSH RPC process,\n21|\t// daemon, or restore worker: it must never create a\n22|\t// credential-dependent tmux server, may contact an\n23|\t// already-running authenticated broker, and otherwise receives\n24|\t// capability_unavailable with no fallback to direct creation.\n25|\tCallerBackground = axpane.CallerBackground\n26|)\n27|\n28|// Acquisition outcomes name how the caller reached the dedicated\n29|// server. Exactly one applies; there is no combined or fallback\n30|// outcome.\n31|const (\n32|\t// ViaSpawned created the dedicated -S server on the foreground\n33|\t// path and returns its spawn argv.\n34|\tViaSpawned = \"spawned\"\n35|\t// ViaAttachedFound the dedicated server already running and\n36|\t// attested on the foreground path.\n37|\tViaAttached = \"attached-running\"\n38|\t// ViaBroker contacted the already-running authenticated Aqua\n39|\t// broker and its attested AX tmux server on the background\n40|\t// path. No local spawn argv exists on this path.\n41|\tViaBroker = \"broker\"\n42|)\n43|\n44|// realmCapability is the Section 4.D capability the background\n45|// typed refusal names: the exact instance passes the AX sentinel\n46|// and the provider-auth smoke without UI. The admission verdict is\n47|// the landed terminalbackend owner's; this package consumes it\n48|// through RealmAdmission and never re-decides it.\n49|const realmCapability = \"credential_capable_execution_realm\"\n50|\n51|// ServerReport is the live dedicated-server probe result: whether\n52|// the private socket answers, with the landed admission verdict over\n53|// the exact server when it does.\n54|type ServerReport struct {\n55|\tRunning   bool\n56|\tAdmission RealmAdmission\n57|}\n58|\n59|// Dependencies carries every external interaction acquisition\n60|// performs. This leaf ships the decision core and argv only: no\n61|// production probe or spawner implementation exists in the tree. The\n62|// exec/probe adapters — which report Reconcile/ResolveEvidence\n63|// verdicts and spawn through the built argv — and the server socket's\n64|// crash evidence are owned by the lifecycle leaf TASK-260830-1c28dz;\n65|// tests wire fakes. No probe runs without its dependency: a nil entry\n66|// refuses instead of reaching for a default.\n67|type Dependencies struct {\n68|\t// ProbeServer reports the dedicated socket's live state.\n69|\tProbeServer func(socket string) (ServerReport, error)\n70|\t// ProbeBroker reports the live Aqua broker state.\n71|\tProbeBroker func() (BrokerReport, error)\n72|\t// Spawn creates the dedicated server with the given -S argv.\n73|\tSpawn func(socket string, argv []string) error\n74|}\n75|\n76|// Request is the complete acquisition surface. There is deliberately\n77|// no member for a credential flag, a managername hint, or a cached\n78|// observation: the background creation rule needs no credential flag\n79|// because the background path never creates on any platform, and a\n80|// hint or cached observation never authorizes, so none is an input.\n81|type Request struct {\n82|\tCaller   Caller\n83|\tPlatform scalar.Platform\n84|\t// Root and Name select the runtime directory: Root is the\n85|\t// Runtime IPC root of the SPEC 3.2 table (macOS: per-user\n86|\t// temporary directory; Linux/WSL2: $XDG_RUNTIME_DIR/ax),\n87|\t// resolved by the landed localstore layout as PathRuntime and\n88|\t// supplied by the caller — this leaf resolves no root of its\n89|\t// own, because the socket is runtime IPC, never durable\n90|\t// identity. Name is the runtime leaf (usually\n91|\t// RuntimeDirName). Foreground acquisition ensures the directory\n92|\t// idempotently; background acquisition verifies the existing\n93|\t// directory and never creates it.\n94|\tRoot string\n95|\tName string\n96|\t// Ambient carries the observed ambient socket facts for\n97|\t// evidence. Resolution never reads them; tests assert the\n98|\t// acquired socket equals none of them.\n99|\tAmbient Ambient\n100|\t// SocketOverride must be empty. Any caller-supplied socket —\n101|\t// whichever ambient vector supplied it — refuses.\n102|\tSocketOverride string\n103|\t// SessionID is the logical session the spawned server will\n104|\t// host, as canonical UUIDv7. It shapes spawn argv only.\n105|\tSessionID string\n106|\t// Generation, BrokerState, and Remediation are the typed\n107|\t// realm/readiness details the capability_unavailable refusal\n108|\t// carries. All three are required: an input that omits one\n109|\t// is malformed and refuses invalid_arguments instead of\n110|\t// emitting an untyped refusal. Generation is also the typed\n111|\t// generation every admission must bind to.\n112|\tGeneration  string\n113|\tBrokerState string\n114|\tRemediation string\n115|\tDeps        Dependencies\n116|}\n117|\n118|// Outcome is the one acquisition result.\n119|type Outcome struct {\n120|\tVia    string\n121|\tSocket string\n122|\t// Argv is the dedicated -S spawn argv. It is set only for\n123|\t// ViaSpawned: the broker path spawns nothing and the\n124|\t// attached path presents through sibling-owned attach\n125|\t// semantics, not through a second spawn vector.\n126|\tArgv []string\n127|}\n128|\n129|// Acquire resolves the dedicated server socket from the runtime\n130|// directory and reaches the server through the caller-appropriate\n131|// path. Foreground attaches to the running attested server or\n132|// spawns the dedicated -S server; background contacts the\n133|// already-running authenticated broker or receives the typed\n134|// capability_unavailable refusal, and never falls back to direct\n135|// server creation — there is no spawn call on the background path,\n136|// and every background test arms a spy spawner that fails the run\n137|// if it is ever invoked.\n138|//\n139|// Refusals precede side effects: malformed input, ambient reuse, and\n140|// missing dependencies all refuse before any directory is created,\n141|// and background acquisition verifies the runtime directory without\n142|// creating it, so a background caller performs no durable write.\n143|func Acquire(req Request) (Outcome, error) {\n144|\tif req.Caller != CallerForeground && req.Caller != CallerBackground {\n145|\t\treturn Outcome{}, &Error{Code: CodeInvalidArguments, Detail: \"caller\"}\n146|\t}\n147|\tif req.Generation == \"\" || req.BrokerState == \"\" || req.Remediation == \"\" {\n148|\t\treturn Outcome{}, &Error{Code: CodeInvalidArguments, Detail: \"realm details\"}\n149|\t}\n150|\tdir, err := lexicalRuntimePath(req.Root, req.Name, req.Platform)\n151|\tif err != nil {\n152|\t\treturn Outcome{}, err\n153|\t}\n154|\tsocket, err := ResolveSocket(dir, req.SocketOverride, req.Ambient)\n155|\tif err != nil {\n156|\t\treturn Outcome{}, err\n157|\t}\n158|\tif req.Caller == CallerBackground {\n159|\t\treturn acquireBackground(req, socket)\n160|\t}\n161|\treturn acquireForeground(req, socket)\n162|}\n163|\n164|// acquireBackground implements the broker-or-refuse rule: it may\n165|// contact the already-running authenticated broker and its attested\n166|// server, and when neither exists it returns capability_unavailable\n167|// with typed realm/readiness details. Direct server creation is not\n168|// the else branch — this function has no path to the spawner, on\n169|// any platform — and the runtime directory is verified, never\n170|// created here. A missing leaf is the ordinary cold state (the\n171|// Runtime IPC root is a per-user temporary directory), so absence\n172|// maps to the typed unavailable with no broker probe and no spawn;\n173|// a leaf that exists but fails custody keeps its custody code.\n174|func acquireBackground(req Request, socket string) (Outcome, error) {\n175|\tif req.Deps.ProbeBroker == nil {\n176|\t\treturn Outcome{}, &Error{Code: CodeInvalidArguments, Detail: \"dependencies\"}\n177|\t}\n178|\tverr := VerifyRuntimeDir(req.Root, req.Name, req.Platform)\n179|\tif runtimeAbsent(verr) {\n180|\t\treturn Outcome{}, backgroundUnavailable(req, verr)\n181|\t}\n182|\tif verr != nil {\n183|\t\treturn Outcome{}, verr\n184|\t}\n185|\tstatus, err := req.Deps.ProbeBroker()\n186|\tif err != nil {\n187|\t\treturn Outcome{}, err\n188|\t}\n189|\tif err := CheckBrokerContact(status, req.Generation, currentUID()); err != nil {\n190|\t\t// The miss path creates nothing: it consults the creation\n191|\t\t// gate so the no-fallback rule is enforced by a call, not\n192|\t\t// by the absence of one. The gate refuses every background\n193|\t\t// caller; its refusal is expected here and the path reports\n194|\t\t// the typed unavailable the spec names. The else branch is\n195|\t\t// reachable only when the gate is weakened to admit a\n196|\t\t// background caller, and then it refuses with the creation\n197|\t\t// code instead of the typed unavailable, so the committed\n198|\t\t// background-miss tests redden.\n199|\t\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\n200|\t\t\treturn Outcome{}, backgroundUnavailable(req, err)\n201|\t\t}\n202|\t\treturn Outcome{}, &Error{Code: CodeBackgroundCreationRefused, Detail: \"background fallback\"}\n203|\t}\n204|\treturn Outcome{Via: ViaBroker, Socket: socket}, nil\n205|}\n206|\n207|// acquireForeground attaches to the running attested dedicated\n208|// server or spawns it. A running but unattested server refuses:\n209|// acquisition never attaches to a server whose landed admission is\n210|// missing or bound to another generation, and never repairs it here\n211|// — lifecycle owns that decision.\n212|func acquireForeground(req Request, socket string) (Outcome, error) {\n213|\tif req.Deps.ProbeServer == nil || req.Deps.Spawn == nil {\n214|\t\treturn Outcome{}, &Error{Code: CodeInvalidArguments, Detail: \"dependencies\"}\n215|\t}\n216|\tensured, err := EnsureRuntimeDir(req.Root, req.Name, req.Platform, nil)\n217|\tif err != nil {\n218|\t\treturn Outcome{}, err\n219|\t}\n220|\treport, err := req.Deps.ProbeServer(socket)\n221|\tif err != nil {\n222|\t\treturn Outcome{}, err\n223|\t}\n224|\tif report.Running {\n225|\t\tif err := CheckServerAttested(report.Admission, req.Generation); err != nil {\n226|\t\t\treturn Outcome{}, err\n227|\t\t}\n228|\t\treturn Outcome{Via: ViaAttached, Socket: socket}, nil\n229|\t}\n230|\targv, err := BuildArgv(ensured, socket, req.SessionID)\n231|\tif err != nil {\n232|\t\treturn Outcome{}, err\n233|\t}\n234|\tif err := req.Deps.Spawn(socket, argv); err != nil {\n235|\t\treturn Outcome{}, &Error{Code: CodeSpawnFailed, Detail: \"server spawn\"}\n236|\t}\n237|\treturn Outcome{Via: ViaSpawned, Socket: socket, Argv: argv}, nil\n238|}\n239|\n240|// runtimeAbsent reports whether err is the verify-side absent-leaf\n241|// refusal. Only the missing leaf counts — never a missing root, a\n242|// mode, ownership, kind, or symlink refusal: absence is the\n243|// readiness fact the background path maps to\n244|// capability_unavailable, while every unsafe-leaf refusal keeps its\n245|// custody code. A nil error is not absence.\n246|func runtimeAbsent(err error) bool {\n247|\tvar local *Error\n248|\tif !errors.As(err, &local) {\n249|\t\treturn false\n250|\t}\n251|\treturn local.Code == CodeUnsafeRuntimeDir && local.Detail == \"runtime absent\"\n252|}\n253|\n254|// checkCreationAllowed is the single choke point before every\n255|// direct server creation. A background caller never creates: on\n256|// macOS because server creation is credential-sensitive, and on\n257|// every platform because the background path must not fall back to\n258|// direct creation. The macOS credential-dependent case is one\n259|// fixture of this gate, not a narrower arm: narrowing the gate to\n260|// macOS or to credential-dependent servers would admit background\n261|// creation the no-fallback rule forbids. Foreground creation is\n262|// allowed on every platform; the credential binding it needs is\n263|// proven by the landed admission the server must present before\n264|// any attach.\n265|func checkCreationAllowed(caller Caller) error {\n266|\tif caller == CallerBackground {\n267|\t\treturn &Error{Code: CodeBackgroundCreationRefused, Detail: \"background creation\"}\n268|\t}\n269|\treturn nil\n270|}\n271|\n272|// backgroundUnavailable composes the typed capability_unavailable\n273|// refusal the spec names for the background miss, with the exact\n274|// Section 15.3 detail set. The constructor enforces the typed\n275|// details; a failure to render them is itself malformed input, not\n276|// an untyped refusal.\n277|func backgroundUnavailable(req Request, cause error) error {\n278|\tdetails := axerror.RealmEvidence{\n279|\t\tCapability:           realmCapability,\n280|\t\tCallerRealm:          req.Caller,\n281|\t\tBrokerState:          req.BrokerState,\n282|\t\tTmuxServerGeneration: req.Generation,\n283|\t\tRemediation:          req.Remediation,\n284|\t}\n285|\tfailure, err := axerror.NewRealmEvidenceUnavailable(axerror.Version130,\n286|\t\t\"no authenticated broker or attested tmux server\",\n287|\t\taxerror.NoIDs(), details, cause)\n288|\tif err != nil {\n289|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"realm details\"}\n290|\t}\n291|\treturn failure\n292|}","final_result":true}}}
