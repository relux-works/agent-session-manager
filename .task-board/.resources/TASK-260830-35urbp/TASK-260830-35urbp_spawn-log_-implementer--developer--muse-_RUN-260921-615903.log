ility_unavailable.\",\n+    ),\n+    Mutant(\n+        name=\"N-absence-remap-widen\",\n+        path=f\"{PACKAGE}/acquire.go\",\n+        find='\\treturn local.Code == CodeUnsafeRuntimeDir && local.Detail == \"runtime absent\"\\n',\n+        replace='\\treturn local.Code == CodeUnsafeRuntimeDir && (local.Detail == \"runtime absent\" || local.Detail == \"runtime mode\")\\n',\n+        count=1,\n+        run=\"TestAcquireBackgroundStagesVerifyCustodyRefusal\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly mode refusals past the absence classifier (a widened leaf maps to capability_unavailable with the custody refusal hidden as its redacted cause); absence still maps and every other unsafe-leaf refusal keeps its custody code. Kill path: the background custody test asserts the top-level *Error the caller renders.\",\n+    ),\n","final_result":true}}}
