{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7c5","stream":{"kind":"session","id":"01a0c4ab-e99a-71a1-b01c-d4e1f789add0"},"sequence":573,"recorded_at":1780531400001141,"record_type":"event","durability":"durable","causation_id":"e9eaa535-0e9f-444e-ac97-d216243d9df7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e9eaa535-0e9f-444e-ac97-d216243d9df7","run_stream":{"kind":"run","id":"e9eaa535-0e9f-444e-ac97-d216243d9df7"},"task_stream":{"kind":"task","id":"01a0c4ad-681f-7b53-89bb-4cc86db8a8f9"},"task_id":"01a0c4ad-681f-7b53-89bb-4cc86db8a8f9","event":{"kind":"output","task_id":"01a0c4ad-681f-7b53-89bb-4cc86db8a8f9","chunk":"Read text file `internal/tmuxserver/acquire_test.go`.\n(499 line(s) above)\n500|\t\t\t}\n501|\t\t})\n502|\t}\n503|}\n504|\n505|// The background path verifies custody through VerifyRuntimeDir, so a\n506|// non-directory leaf refuses through the entry before any broker\n507|// contact: the verify-side O_DIRECTORY refusal driven at the entry the\n508|// background path uses.\n509|func TestAcquireBackgroundRefusesNonDirectoryLeaf(t *testing.T) {\n510|\troot := runtimeRoot(t)\n511|\tleaf := filepath.Join(root, RuntimeDirName)\n512|\tif err := os.WriteFile(leaf, []byte(\"x\"), 0o700); err != nil {\n513|\t\tt.Fatal(err)\n514|\t}\n515|\treq := validRequest(t, root)\n516|\treq.Caller = CallerBackground\n517|\tprobed := false\n518|\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n519|\t\tprobed = true\n520|\t\treturn brokerReport(), nil\n521|\t}\n522|\t_, err := Acquire(req)\n523|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n524|\tif probed {\n525|\t\tt.Fatal(\"broker was probed past a non-directory leaf\")\n526|\t}\n527|}\n528|\n529|// An unclean spelling of the derived socket refuses through the entry\n530|// with no spawn: the cleaned-spelling collision gate driven at\n531|// Acquire.\n532|func TestAcquireRefusesAmbientCollisionUncleanSpelling(t *testing.T) {\n533|\troot := runtimeRoot(t)\n534|\tdir := socketDir(t, root)\n535|\talias := dir + \"/./\" + SocketName\n536|\tif got := filepath.Clean(alias); got != SocketPath(dir) {\n537|\t\tt.Fatalf(\"alias %q cleans to %q, want the derived socket\", alias, got)\n538|\t}\n539|\treq := validRequest(t, root)\n540|\treq.Ambient = Ambient{DefaultPath: alias}\n541|\tspy := &spawnSpy{}\n542|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n543|\t\treturn ServerReport{}, nil\n544|\t}\n545|\treq.Deps.Spawn = spy.spawn\n546|\t_, err := Acquire(req)\n547|\trequireLocalError(t, err, \"tmux_ambient_server_reuse\", \"ambient collision\")\n548|\tif spy.calls != 0 {\n549|\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n550|\t}\n551|}\n552|\n553|// A TMUX value naming the derived socket in the real\n554|// `<socket>,<pid>,<index>` encoding refuses through the entry with\n555|// no spawn: the collision gate compares the socket component.\n556|func TestAcquireRefusesTMUXEnvCollisionRealEncoding(t *testing.T) {\n557|\troot := runtimeRoot(t)\n558|\tdir := socketDir(t, root)\n559|\tencoded := SocketPath(dir) + \",12345,0\"\n560|\treq := validRequest(t, root)\n561|\treq.Ambient = Ambient{TMUXEnv: encoded}\n562|\tspy := &spawnSpy{}\n563|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n564|\t\treturn ServerReport{}, nil\n565|\t}\n566|\treq.Deps.Spawn = spy.spawn\n567|\t_, err := Acquire(req)\n568|\trequireLocalError(t, err, \"tmux_ambient_server_reuse\", \"ambient collision\")\n569|\tif spy.calls != 0 {\n570|\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n571|\t}\n572|}\n573|\n574|func TestAcquireRefusesUnknownCaller(t *testing.T) {\n575|\troot := runtimeRoot(t)\n576|\treq := validRequest(t, root)\n577|\treq.Caller = \"operator\"\n578|\t_, err := Acquire(req)\n579|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"caller\")\n580|}\n581|\n582|func TestAcquireRefusesWindowsPlatform(t *testing.T) {\n583|\troot := runtimeRoot(t)\n584|\tfor _, caller := range []Caller{CallerForeground, CallerBackground} {\n585|\t\treq := validRequest(t, root)\n586|\t\treq.Caller = caller\n587|\t\treq.Platform = scalar.PlatformWindows\n588|\t\treq.Root = `C:\\ax-runtime`\n589|\t\t_, err := Acquire(req)\n590|\t\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"runtime platform\")\n591|\t}\n592|}\n593|\n594|func TestAcquireRefusesMissingRealmDetails(t *testing.T) {\n595|\tbase := validRequest(t, runtimeRoot(t))\n596|\tfor _, tc := range []struct {\n597|\t\tname   string\n598|\t\tmutate func(*Request)\n599|\t}{\n600|\t\t{\"generation\", func(r *Request) { r.Generation = \"\" }},\n601|\t\t{\"broker state\", func(r *Request) { r.BrokerState = \"\" }},\n602|\t\t{\"remediation\", func(r *Request) { r.Remediation = \"\" }},\n603|\t} {\n604|\t\tt.Run(tc.name, func(t *testing.T) {\n605|\t\t\treq := base\n606|\t\t\ttc.mutate(&req)\n607|\t\t\t_, err := Acquire(req)\n608|\t\t\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"realm details\")\n609|\t\t})\n610|\t}\n611|}\n612|\n613|func TestAcquireRefusesMissingDependencies(t *testing.T) {\n614|\troot := runtimeRoot(t)\n615|\tforeground := validRequest(t, root)\n616|\t_, err := Acquire(foreground)\n617|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"dependencies\")\n618|\tbackground := validRequest(t, root)\n619|\tbackground.Caller = CallerBackground\n620|\t_, err = Acquire(background)\n621|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"dependencies\")\n622|}\n623|\n624|func TestAcquireCreatesRuntimeDirIdempotently(t *testing.T) {\n625|\troot := runtimeRoot(t)\n626|\tmake := func() Request {\n627|\t\treq := validRequest(t, root)\n628|\t\tspy := &spawnSpy{}\n629|\t\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n630|\t\t\treturn ServerReport{}, nil\n631|\t\t}\n632|\t\treq.Deps.Spawn = spy.spawn\n633|\t\treturn req\n634|\t}\n635|\tfirst, err := Acquire(make())\n636|\tif err != nil {\n637|\t\tt.Fatal(err)\n638|\t}\n639|\tsecond, err := Acquire(make())\n640|\tif err != nil {\n641|\t\tt.Fatal(err)\n642|\t}\n643|\tif first.Socket != second.Socket {\n644|\t\tt.Fatalf(\"sockets differ: %q vs %q\", first.Socket, second.Socket)\n645|\t}\n646|}\n647|\n648|func TestAcquireBackgroundNilBrokerWithSpawnRefuses(t *testing.T) {\n649|\troot := runtimeRoot(t)\n650|\treq := validRequest(t, root)\n651|\treq.Caller = CallerBackground\n652|\tspy := &spawnSpy{}\n653|\treq.Deps.Spawn = spy.spawn\n654|\t_, err := Acquire(req)\n655|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"dependencies\")\n656|\tif spy.calls != 0 {\n657|\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n658|\t}\n659|}\n660|\n661|func TestAcquireForegroundNilSpawnWithProbeRefuses(t *testing.T) {\n662|\troot := runtimeRoot(t)\n663|\treq := validRequest(t, root)\n664|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n665|\t\treturn ServerReport{}, nil\n666|\t}\n667|\t_, err := Acquire(req)\n668|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"dependencies\")\n669|}\n670|\n671|func TestCheckCreationAllowedRefusesBackground(t *testing.T) {\n672|\trequireLocalError(t, checkCreationAllowed(CallerBackground), \"tmux_background_creation_refused\", \"background creation\")\n673|\tif err := checkCreationAllowed(CallerForeground); err != nil {\n674|\t\tt.Fatalf(\"foreground creation refused: %v\", err)\n675|\t}\n676|}","final_result":true}}}
