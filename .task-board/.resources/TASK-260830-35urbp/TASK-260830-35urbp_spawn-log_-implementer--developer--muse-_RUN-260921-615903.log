{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c847","stream":{"kind":"session","id":"01a0c4ab-e99a-71a1-b01c-d4e1f789add0"},"sequence":638,"recorded_at":1780531400001271,"record_type":"event","durability":"durable","causation_id":"e9eaa535-0e9f-444e-ac97-d216243d9df7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e9eaa535-0e9f-444e-ac97-d216243d9df7","run_stream":{"kind":"run","id":"e9eaa535-0e9f-444e-ac97-d216243d9df7"},"task_stream":{"kind":"task","id":"01a0c4ad-c54b-7930-b4f3-bffe9b12b6e0"},"task_id":"01a0c4ad-c54b-7930-b4f3-bffe9b12b6e0","event":{"kind":"output","task_id":"01a0c4ad-c54b-7930-b4f3-bffe9b12b6e0","chunk":"Read text file `internal/tmuxserver/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for internal/tmuxserver.\n3|\n4|Every gate ships a narrowing mutant: the gate stays present and is\n5|weakened to admit exactly one member of the class it must reject, and\n6|the named killer tests must fail. A delete-only mutant proves only that\n7|the gate exists and is not accepted as evidence; row D-background-fallback\n8|is the one explicitly supplementary additive plant (the reviewer-shaped\n9|direct-creation call on the background path), labeled as such and not\n10|counted as any gate's narrowing.\n11|\n12|Each row runs M (mutate production files in place), R (run the scoped Go\n13|killers through the production entries), V (verdict from the Go exit code\n14|plus a FAIL kill-line: KILLED iff R fails with a test failure line,\n15|SURVIVED iff R passes, ERROR for anything else -- unapplied patches,\n16|build breaks, timeouts). M failures and R infrastructure errors are\n17|ERROR, never kills or survivals. Files are restored from backups after\n18|every row, pass or fail.\n19|\n20|Row C-control is the harmless control: a comment-only edit that must\n21|SURVIVE, proving the harness observes test outcomes instead of\n22|hard-coding kills.\n23|\n24|Usage:\n25|  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py\n26|  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py N-mode-create\n27|  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py --log-dir /tmp/mutant-logs\n28|  AX_MUTANT_VERBOSE=1 PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py N-mode-create\n29|\"\"\"\n30|\n31|import os\n32|import shutil\n33|import subprocess\n34|import sys\n35|import tempfile\n36|from dataclasses import dataclass\n37|from pathlib import Path\n38|\n39|REPO = Path(__file__).resolve().parents[2]\n40|PACKAGE = \"internal/tmuxserver\"\n41|\n42|\n43|@dataclass(frozen=True)\n44|class Mutant:\n45|    name: str\n46|    path: str\n47|    find: str\n48|    replace: str\n49|    count: int\n50|    run: str\n51|    expect: str\n52|    note: str\n53|\n54|\n55|BG_MISS = \"TestAcquireBackgroundMissReturnsTypedUnavailable\"\n56|BG_MISS_LINUX = \"(TestAcquireBackgroundMissReturnsTypedUnavailable|TestAcquireBackgroundMissOnLinuxAlsoRefusesWithoutFallback)\"\n57|OVERRIDE = \"TestAcquireRefusesEveryAmbientOverrideVector\"\n58|WIDENED = \"TestEnsureRuntimeDirRefusesWidenedMode\"\n59|COLLISION = \"(TestResolveSocketRefusesAmbientCollision|TestAcquireRefusesAmbientCollision)\"\n60|\n61|MUTANTS = [\n62|    Mutant(\n63|        name=\"N-mode-create\",\n64|        path=f\"{PACKAGE}/runtime_unix.go\",\n65|        find=\"\\t// leaf above; the mode comparison below is the load-bearing\\n\\t// arm this gate's tests and mutants pin.\\n\\tif info.Mode().Perm() != 0o700 {\\n\",\n66|        replace=\"\\t// leaf above; the mode comparison below is the load-bearing\\n\\t// arm this gate's tests and mutants pin.\\n\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o755 {\\n\",\n67|        count=1,\n68|        run=WIDENED,\n69|        expect=\"KILLED\",\n70|        note=\"Admits exactly 0755 at the create-path mode arm; other widened modes still refuse. Kill path: Ensure stops refusing.\",\n71|    ),\n72|    Mutant(\n73|        name=\"N-mode-verify\",\n74|        path=f\"{PACKAGE}/runtime_unix.go\",\n75|        find='\\tinfo, err := leaf.Stat()\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\\n\\t}\\n\\tif info.Mode().Perm() != 0o700 {\\n',\n76|        replace='\\tinfo, err := leaf.Stat()\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\\n\\t}\\n\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o755 {\\n',\n77|        count=1,\n78|        run=WIDENED,\n79|        expect=\"KILLED\",\n80|        note=\"Admits exactly 0755 at the verify-path mode arm; the create arm still refuses. Kill path: Verify stops refusing.\",\n81|    ),\n82|    Mutant(\n83|        name=\"N-mode-narrower-create\",\n84|        path=f\"{PACKAGE}/runtime_unix.go\",\n85|        find=\"\\t// leaf above; the mode comparison below is the load-bearing\\n\\t// arm this gate's tests and mutants pin.\\n\\tif info.Mode().Perm() != 0o700 {\\n\",\n86|        replace=\"\\t// leaf above; the mode comparison below is the load-bearing\\n\\t// arm this gate's tests and mutants pin.\\n\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o600 {\\n\",\n87|        count=1,\n88|        run=\"TestEnsureRuntimeDirRefusesNarrowerMode\",\n89|        expect=\"KILLED\",\n90|        note=\"Admits exactly a 0600 leaf at the create-path mode arm; every other non-0700 mode (widened and narrower) still refuses. Kill path: Ensure stops refusing the 0600 fixture.\",\n91|    ),\n92|    Mutant(\n93|        name=\"N-mode-narrower-verify\",\n94|        path=f\"{PACKAGE}/runtime_unix.go\",\n95|        find='\\tinfo, err := leaf.Stat()\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\\n\\t}\\n\\tif info.Mode().Perm() != 0o700 {\\n',\n96|        replace='\\tinfo, err := leaf.Stat()\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\\n\\t}\\n\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o600 {\\n',\n97|        count=1,\n98|        run=\"TestEnsureRuntimeDirRefusesNarrowerMode\",\n99|        expect=\"KILLED\",\n100|        note=\"Admits exactly a 0600 leaf at the verify-path mode arm; the create arm still refuses, so the kill comes from the Verify leg of the narrower-mode test. Narrower 0500 still refuses on both arms.\",\n101|    ),\n102|    Mutant(\n103|        name=\"N-fchmod-umask\",\n104|        path=f\"{PACKAGE}/runtime_unix.go\",\n105|        find=\"\\tif created {\\n\",\n106|        replace=\"\\tif created && os.Geteuid() == 0 {\\n\",\n107|        count=1,\n108|        run=\"TestEnsureRuntimeDirEnforcesModeUnderRestrictiveUmask\",\n109|        expect=\"KILLED\",\n110|        note=\"Admits exactly non-root creates past the explicit post-mkdirat chmod; root creates still chmod. Kill path: under umask 0177 the leaf stays 0600 and the mode gate refuses. Non-root load-bearing, like the same-shaped reviewer plant.\",\n111|    ),\n112|    Mutant(\n113|        name=\"N-ownership-uid\",\n114|        path=f\"{PACKAGE}/ownership_unix.go\",\n115|        find=\"\\tif stat.Uid != uint32(effectiveUID()) {\\n\",\n116|        replace=\"\\tif stat.Uid != uint32(effectiveUID()) && stat.Uid != uint32(effectiveUID())-100000 {\\n\",\n117|        count=1,\n118|        run=\"TestEnsureRuntimeDirRefusesForeignOwnership\",\n119|        expect=\"KILLED\",\n120|        note=\"Admits exactly the seam-shifted foreign UID; every other foreign UID still refuses.\",\n121|    ),\n122|    Mutant(\n123|        name=\"N-containment-slash\",\n124|        path=f\"{PACKAGE}/runtime.go\",\n125|        find='\\tif strings.Contains(name, \"/\") {\\n',\n126|        replace='\\tif strings.Contains(name, \"/\") && name != \"a/b\" {\\n',\n127|        count=1,\n128|        run=\"TestEnsureRuntimeDirRefusesBadNames\",\n129|        expect=\"KILLED\",\n130|        note=\"Admits exactly the nested a/b name past the single-segment arm; every other multi-segment name still refuses. Kill reroutes to the commit refusal.\",\n131|    ),\n132|    Mutant(\n133|        name=\"N-containment-mismatch\",\n134|        path=f\"{PACKAGE}/runtime.go\",\n135|        find=\"\\treturn sameDirectory(handleInfo, pathInfo)\\n\",\n136|        replace=\"\\treturn sameDirectory(handleInfo, pathInfo) || handleInfo.IsDir()\\n\",\n137|        count=1,\n138|        run=\"TestEnsureRuntimeDirRefusesHandleMismatch\",\n139|        expect=\"KILLED\",\n140|        note=\"Admits exactly directory handles past the handle-binding check; the mismatch still refuses for non-directories.\",\n141|    ),\n142|    Mutant(\n143|        name=\"N-containment-symlink\",\n144|        path=f\"{PACKAGE}/runtime_unix.go\",\n145|        find=\"\\tleafFd, err := unix.Openat(rootFd, name,\\n\\t\\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\",\n146|        replace=\"\\tleafFd, err := unix.Openat(rootFd, name,\\n\\t\\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\tif err != nil {\\n\\t\\tleafFd, err = unix.Openat(rootFd, name,\\n\\t\\t\\tunix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\t}\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\",\n147|        count=1,\n148|        run=\"TestEnsureRuntimeDirRefusesSymlinkLeaf\",\n149|        expect=\"KILLED\",\n150|        note=\"Admits exactly symlink leaves via an ELOOP fallback open; every other commit failure still refuses.\",\n151|    ),\n152|    Mutant(\n153|        name=\"N-containment-symlink-verify\",\n154|        path=f\"{PACKAGE}/runtime_unix.go\",\n155|        find=\"\\tleafFd, err := unix.Openat(int(rootHandle.Fd()), name,\\n\\t\\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\tif err != nil {\\n\\t\\tif errors.Is(err, unix.ENOENT) {\\n\\t\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime absent\\\"}\\n\\t\\t}\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\",\n156|        replace=\"\\tleafFd, err := unix.Openat(int(rootHandle.Fd()), name,\\n\\t\\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\tif err != nil {\\n\\t\\tleafFd, err = unix.Openat(int(rootHandle.Fd()), name,\\n\\t\\t\\tunix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\t}\\n\\tif err != nil {\\n\\t\\tif errors.Is(err, unix.ENOENT) {\\n\\t\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime absent\\\"}\\n\\t\\t}\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\",\n157|        count=1,\n158|        run=\"TestVerifyRuntimeDirRefusesSymlinkLeaf\",\n159|        expect=\"KILLED\",\n160|        note=\"Admits exactly symlink leaves via an ELOOP fallback open on the verify side; the commit side still refuses. Kill path: Verify follows the leaf and the mode gate passes on the target.\",\n161|    ),\n162|    Mutant(\n163|        name=\"N-containment-odirectory-verify\",\n164|        path=f\"{PACKAGE}/runtime_unix.go\",\n165|        find=\"\\tleafFd, err := unix.Openat(int(rootHandle.Fd()), name,\\n\\t\\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\",\n166|        replace=\"\\tleafFd, err := unix.Openat(int(rootHandle.Fd()), name,\\n\\t\\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)\\n\",\n167|        count=1,\n168|        run=\"(TestVerifyRuntimeDirRefusesNonDirectoryLeaf|TestAcquireBackgroundRefusesNonDirectoryLeaf)\",\n169|        expect=\"KILLED\",\n170|        note=\"Admits exactly non-directory leaves past the verify-side O_DIRECTORY arm; the commit side still refuses and O_NOFOLLOW stays, so symlink leaves still refuse. Kill path: the 0700 regular file verifies clean through both entries, and the FIFO stalls past the 5s deadline.\",\n171|    ),\n172|    Mutant(\n173|        name=\"N-root-wiring\",\n174|        path=f\"{PACKAGE}/runtime.go\",\n175|        find='\\tif _, err := scalar.ParseAbsolutePath(platform, root); err != nil {\\n\\t\\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"runtime root\"}\\n\\t}\\n',\n176|        replace='\\tif _, err := scalar.ParseAbsolutePath(platform, root); err != nil && root != \"relative/root\" {\\n\\t\\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"runtime root\"}\\n\\t}\\n',\n177|        count=1,\n178|        run=\"TestEnsureRuntimeDirRefusesBadRoots\",\n179|        expect=\"KILLED\",\n180|        note=\"Admits exactly the relative-root fixture past our wiring of the landed grammar; every other malformed root still refuses. Kill reroutes to the guard refusal.\",\n181|    ),\n182|    Mutant(\n183|        name=\"N-platform-wiring\",\n184|        path=f\"{PACKAGE}/runtime.go\",\n185|        find=\"\\tif _, err := scalar.ParsePlatform(string(platform)); err != nil {\\n\",\n186|        replace='\\tif _, err := scalar.ParsePlatform(string(platform)); err != nil && platform != \"plan9\" {\\n',\n187|        count=1,\n188|        run=\"TestEnsureRuntimeDirRefusesBadPlatform\",\n189|        expect=\"KILLED\",\n190|        note=\"Admits exactly the plan9 platform past our wiring of the landed vocabulary; every other unknown platform still refuses. Kill reroutes to the root refusal.\",\n191|    ),\n192|    Mutant(\n193|        name=\"N-platform-windows\",\n194|        path=f\"{PACKAGE}/runtime.go\",\n195|        find=\"\\tif platform == scalar.PlatformWindows {\\n\",\n196|        replace='\\tif platform == scalar.PlatformWindows && root != \"C:\\\\\\\\ax-runtime\" {\\n',\n197|        count=1,\n198|        run=\"TestEnsureRuntimeDirRefusesWindowsOnUnixHost\",\n199|        expect=\"KILLED\",\n200|        note=\"Admits exactly the C: fixture root past the lexical Windows refusal; every other Windows root still refuses there. Kill reroutes to the root refusal, which reports runtime root instead of runtime platform.\",\n201|    ),\n202|    Mutant(\n203|        name=\"N-override-env\",\n204|        path=f\"{PACKAGE}/socket.go\",\n205|        find='\\tif override != \"\" {\\n',\n206|        replace='\\tif override != \"\" && override != \"/tmp/tmux-501/default,12345,0\" {\\n',\n207|        count=1,\n208|        run=f\"{OVERRIDE}/environment_variable\",\n209|        expect=\"KILLED\",\n210|        note=\"Admits exactly the TMUX environment value as an override; the other four vectors still refuse.\",\n211|    ),\n212|    Mutant(\n213|        name=\"N-override-inherited\",\n214|        path=f\"{PACKAGE}/socket.go\",\n215|        find='\\tif override != \"\" {\\n',\n216|        replace='\\tif override != \"\" && override != \"/tmp/inherited.sock\" {\\n',\n217|        count=1,\n218|        run=f\"{OVERRIDE}/inherited_socket\",\n219|        expect=\"KILLED\",\n220|        note=\"Admits exactly the inherited socket as an override; the other four vectors still refuse.\",\n221|    ),\n222|    Mutant(\n223|        name=\"N-override-default\",\n224|        path=f\"{PACKAGE}/socket.go\",\n225|        find='\\tif override != \"\" {\\n',\n226|        replace='\\tif override != \"\" && override != \"/tmp/tmux-501/default\" {\\n',\n227|        count=1,\n228|        run=f\"{OVERRIDE}/default_path\",\n229|        expect=\"KILLED\",\n230|        note=\"Admits exactly the default path as an override; the other four vectors still refuse.\",\n231|    ),\n232|    Mutant(\n233|        name=\"N-override-conventional\",\n234|        path=f\"{PACKAGE}/socket.go\",\n235|        find='\\tif override != \"\" {\\n',\n236|        replace='\\tif override != \"\" && override != \"default\" {\\n',\n237|        count=1,\n238|        run=f\"{OVERRIDE}/conventional_name\",\n239|        expect=\"KILLED\",\n240|        note=\"Admits exactly the conventional name as an override; the other four vectors still refuse.\",\n241|    ),\n242|    Mutant(\n243|        name=\"N-override-tmpdir\",\n244|        path=f\"{PACKAGE}/socket.go\",\n245|        find='\\tif override != \"\" {\\n',\n246|        replace='\\tif override != \"\" && override != \"/tmp/operator-tmux\" {\\n',\n247|        count=1,\n248|        run=f\"{OVERRIDE}/tmux_tmpdir\",\n249|        expect=\"KILLED\",\n250|        note=\"Admits exactly the TMUX_TMPDIR value as an override — the member tmux uses to relocate its default socket directory; the other four vectors still refuse.\",\n251|    ),\n252|    Mutant(\n253|        name=\"N-collision\",\n254|        path=f\"{PACKAGE}/socket.go\",\n255|        find='\\tif candidate != \"\" && filepath.Clean(candidate) == socket {\\n',\n256|        replace='\\tif candidate != \"\" && filepath.Clean(candidate) == socket && candidate != ambient.DefaultPath {\\n',\n257|        count=1,\n258|        run=f\"{COLLISION}/default_path\",\n259|        expect=\"KILLED\",\n260|        note=\"Admits exactly the default-path collision; collisions on the other four ambient members still refuse.\",\n261|    ),\n262|    Mutant(\n263|        name=\"N-collision-inherited\",\n264|        path=f\"{PACKAGE}/socket.go\",\n265|        find='\\tif candidate != \"\" && filepath.Clean(candidate) == socket {\\n',\n266|        replace='\\tif candidate != \"\" && filepath.Clean(candidate) == socket && candidate != ambient.InheritedSocket {\\n',\n267|        count=1,\n268|        run=f\"{COLLISION}/inherited_socket\",\n269|        expect=\"KILLED\",\n270|        note=\"Admits exactly the inherited-socket collision; the other four members still refuse.\",\n271|    ),\n272|    Mutant(\n273|        name=\"N-collision-tmuxenv\",\n274|        path=f\"{PACKAGE}/socket.go\",\n275|        find='\\tif candidate != \"\" && filepath.Clean(candidate) == socket {\\n',\n276|        replace='\\tif candidate != \"\" && filepath.Clean(candidate) == socket && candidate != ambient.TMUXEnv {\\n',\n277|        count=1,\n278|        run=f\"{COLLISION}/tmux_env\",\n279|        expect=\"KILLED\",\n280|        note=\"Admits exactly the TMUX-env collision; the other four members still refuse.\",\n281|    ),\n282|    Mutant(\n283|        name=\"N-collision-tmpdir\",\n284|        path=f\"{PACKAGE}/socket.go\",\n285|        find='\\tif candidate != \"\" && filepath.Clean(candidate) == socket {\\n',\n286|        replace='\\tif candidate != \"\" && filepath.Clean(candidate) == socket && candidate != ambient.TMUXTmpDir {\\n',\n287|        count=1,\n288|        run=f\"{COLLISION}/tmux_tmpdir\",\n289|        expect=\"KILLED\",\n290|        note=\"Admits exactly the TMUX_TMPDIR collision; the other four members still refuse.\",\n291|    ),\n292|    Mutant(\n293|        name=\"N-collision-conventional\",\n294|        path=f\"{PACKAGE}/socket.go\",\n295|        find='\\tif candidate != \"\" && filepath.Clean(candidate) == socket {\\n',\n296|        replace='\\tif candidate != \"\" && filepath.Clean(candidate) == socket && candidate != ambient.ConventionalName {\\n',\n297|        count=1,\n298|        run=f\"{COLLISION}/conventional_name\",\n299|        expect=\"KILLED\",\n300|        note=\"Admits exactly the conventional-name collision; the other four members still refuse.\",\n301|    ),\n302|    Mutant(\n303|        name=\"N-collision-unclean\",\n304|        path=f\"{PACKAGE}/socket.go\",\n305|        find='\\tif candidate != \"\" && filepath.Clean(candidate) == socket {\\n',\n306|        replace='\\tif candidate != \"\" && candidate == socket {\\n',\n307|        count=1,\n308|        run=\"(TestResolveSocketRefusesAmbientCollisionUncleanSpellings|TestAcquireRefusesAmbientCollisionUncleanSpelling)\",\n309|        expect=\"KILLED\",\n310|        note=\"Admits exactly unclean spellings of the derived socket past the normalization arm; byte-identical collisions still refuse. Narrowing: the equality gate stays, only Clean is dropped.\",\n311|    ),\n312|    Mutant(\n313|        name=\"N-realm-membership\",\n314|        path=f\"{PACKAGE}/readiness.go\",\n315|        find=\"\\tif !admission.Admitted.Has(realmCapability) {\\n\",\n316|        replace='\\tif !admission.Admitted.Has(realmCapability) && !admission.Admitted.Has(\"headless_creation\") {\\n',\n317|        count=1,\n318|        run=\"(TestCheckServerAttestedRefusesEachMissingConjunct|TestAcquireForegroundRefusesRunningUnattested)\",\n319|        expect=\"KILLED\",\n320|        note=\"Admits exactly decoy-capability admissions past the membership arm; every admission without the realm row still refuses. Kill path: the foreground entry attaches to a headless-only server.\",\n321|    ),\n322|    Mutant(\n323|        name=\"N-realm-generation\",\n324|        path=f\"{PACKAGE}/readiness.go\",\n325|        find=\"\\tif wantGeneration == \\\"\\\" || admission.RawGeneration != wantGeneration {\\n\",\n326|        replace='\\tif wantGeneration == \"\" || admission.RawGeneration != wantGeneration && admission.RawGeneration != \"generation-6\" {\\n',\n327|        count=1,\n328|        run=f\"(TestCheckServerAttestedRefusesEachMissingConjunct|TestAcquireForegroundRefusesWrongGenerationAdmission|{BG_MISS})\",\n329|        expect=\"KILLED\",\n330|        note=\"Admits exactly stale generation-6 admissions past the generation arm; every other unbound generation still refuses. Kill path: a replayed yesterday-proof attaches through both entries.\",\n331|    ),\n332|    Mutant(\n333|        name=\"N-realm-empty-want\",\n334|        path=f\"{PACKAGE}/readiness.go\",\n335|        find='\\tif wantGeneration == \"\" || admission.RawGeneration != wantGeneration {\\n',\n336|        replace='\\tif admission.RawGeneration != wantGeneration {\\n',\n337|        count=1,\n338|        run=\"TestCheckServerAttestedRefusesEachMissingConjunct\",\n339|        expect=\"KILLED\",\n340|        note=\"Admits exactly the both-empty generation pair past the wanted-empty arm; every pair with a non-empty side still refuses on the inequality (the empty-wanted row keeps a bound Raw, the empty-raw row keeps a bound want). Narrowing, not a delete: the inequality arm stays.\",\n341|    ),\n342|    Mutant(\n343|        name=\"N-broker-uid\",\n344|        path=f\"{PACKAGE}/readiness.go\",\n345|        find=\"\\tif report.Principal.UID != currentUID {\\n\",\n346|        replace=\"\\tif report.Principal.UID != currentUID && report.Principal.UID != currentUID+100000 {\\n\",\n347|        count=1,\n348|        run=f\"(TestCheckBrokerContactRefusesEachMissingFact|{BG_MISS})\",\n349|        expect=\"KILLED\",\n350|        note=\"Admits exactly the seam-shifted foreign UID past the same-user arm; every other foreign UID still refuses.\",\n351|    ),\n352|    Mutant(\n353|        name=\"N-broker-generation\",\n354|        path=f\"{PACKAGE}/readiness.go\",\n355|        find='\\tif report.Principal.Generation == \"\" || report.Principal.Generation != wantGeneration {\\n',\n356|        replace='\\tif report.Principal.Generation == \"\" || report.Principal.Generation != wantGeneration && report.Principal.Generation != \"generation-6\" {\\n',\n357|        count=1,\n358|        run=f\"(TestCheckBrokerContactRefusesEachMissingFact|TestAcquireBackgroundMissReturnsTypedUnavailable/generation-unbound_principal)\",\n359|        expect=\"KILLED\",\n360|        note=\"Admits exactly generation-6 broker principals past the principal-binding arm; every other unbound principal still refuses.\",\n361|    ),\n362|    Mutant(\n363|        name=\"N-broker-empty-generation\",\n364|        path=f\"{PACKAGE}/readiness.go\",\n365|        find='\\tif report.Principal.Generation == \"\" || report.Principal.Generation != wantGeneration {\\n',\n366|        replace='\\tif report.Principal.Generation != wantGeneration {\\n',\n367|        count=1,\n368|        run=\"TestCheckBrokerContactRefusesEachMissingFact\",\n369|        expect=\"KILLED\",\n370|        note=\"Admits exactly the both-empty principal pair past the principal-empty arm; every other unbound principal still refuses. Kill reroutes to the server-generation refusal (the empty wanted generation reaches CheckServerAttested), which mismatches the broker-generation detail the row asserts. Through Acquire the pair is unreachable: the typed-details check refuses an empty Generation first.\",\n371|    ),\n372|    Mutant(\n373|        name=\"N-creation-literal\",\n374|        path=f\"{PACKAGE}/acquire.go\",\n375|        find=\"\\tif caller == CallerBackground {\\n\",\n376|        replace='\\tif caller == \"Background\" {\\n',\n377|        count=1,\n378|        run=f\"(TestCheckCreationAllowedRefusesBackground|{BG_MISS_LINUX})\",\n379|        expect=\"KILLED\",\n380|        note=\"Admits exactly the background caller at the creation choke point; the gate still refuses the capitalized twin. Kill path: the background miss consults the gate by call and reports the creation code instead of the typed unavailable.\",\n381|    ),\n382|    Mutant(\n383|        name=\"N-caller-vocabulary\",\n384|        path=f\"{PACKAGE}/acquire.go\",\n385|        find=\"\\tif req.Caller != CallerForeground && req.Caller != CallerBackground {\\n\",\n386|        replace='\\tif req.Caller != CallerForeground && req.Caller != CallerBackground && req.Caller != \"operator\" {\\n',\n387|        count=1,\n388|        run=\"TestAcquireRefusesUnknownCaller\",\n389|        expect=\"KILLED\",\n390|        note=\"Admits exactly the operator caller past the vocabulary arm; every other unknown caller still refuses. Kill reroutes to the dependencies refusal.\",\n391|    ),\n392|    Mutant(\n393|        name=\"N-details-remediation\",\n394|        path=f\"{PACKAGE}/acquire.go\",\n395|        find='\\tif req.Generation == \"\" || req.BrokerState == \"\" || req.Remediation == \"\" {\\n',\n396|        replace='\\tif req.Generation == \"\" || req.BrokerState == \"\" {\\n',\n397|        count=1,\n398|        run=\"TestAcquireRefusesMissingRealmDetails\",\n399|        expect=\"KILLED\",\n400|        note=\"Admits exactly remediation-less requests past the typed-details arm; generation- and broker-less still refuse. Kill reroutes to the dependencies refusal.\",\n401|    ),\n402|    Mutant(\n403|        name=\"N-unattested-foreground\",\n404|        path=f\"{PACKAGE}/acquire.go\",\n405|        find=\"\\t\\tif err := CheckServerAttested(report.Admission, req.Generation); err != nil {\\n\\t\\t\\treturn Outcome{}, err\\n\\t\\t}\\n\",\n406|        replace='\\t\\tif err := CheckServerAttested(report.Admission, req.Generation); err != nil && err.Error() != \"tmux server refused: tmux_readiness_not_authorizing at server generation\" {\\n\\t\\t\\treturn Outcome{}, err\\n\\t\\t}\\n',\n407|        count=1,\n408|        run=\"TestAcquireForegroundRefusesWrongGenerationAdmission\",\n409|        expect=\"KILLED\",\n410|        note=\"Admits exactly generation-refused running servers to attach past the foreground wiring; membership refusals still refuse. Kill path: a stale admission attaches instead of refusing.\",\n411|    ),\n412|    Mutant(\n413|        name=\"N-acquire-commit-refusal\",\n414|        path=f\"{PACKAGE}/acquire.go\",\n415|        find=\"\\tensured, err := EnsureRuntimeDir(req.Root, req.Name, req.Platform, nil)\\n\\tif err != nil {\\n\",\n416|        replace=\"\\tensured, err := EnsureRuntimeDir(req.Root, req.Name, req.Platform, nil)\\n\\tif err != nil && ensured == \\\"\\\" {\\n\",\n417|        count=1,\n418|        run=\"TestAcquireForegroundStagesCommitPhaseCustodyRefusal\",\n419|        expect=\"KILLED\",\n420|        note=\"Admits exactly commit-phase custody refusals past the foreground wiring (commit failures carry the joined path; lexical failures carry \\\"\\\"); lexical refusals still refuse. Kill path: the entry probes and spawns past a widened mode.\",\n421|    ),\n422|    Mutant(\n423|        name=\"N-acquire-verify-refusal\",\n424|        path=f\"{PACKAGE}/acquire.go\",\n425|        find=\"\\tif verr != nil {\\n\\t\\treturn Outcome{}, verr\\n\\t}\\n\",\n426|        replace='\\tif verr != nil && verr.Error() != \"tmux server refused: tmux_unsafe_runtime_dir at runtime mode\" {\\n\\t\\treturn Outcome{}, verr\\n\\t}\\n',\n427|        count=1,\n428|        run=\"TestAcquireBackgroundStagesVerifyCustodyRefusal\",\n429|        expect=\"KILLED\",\n430|        note=\"Admits exactly mode refusals past the background verify wiring; absence maps to unavailable above and every other custody refusal still refuses. Kill path: the entry contacts the broker past a widened mode.\",\n431|    ),\n432|    Mutant(\n433|        name=\"N-spawn-swallow\",\n434|        path=f\"{PACKAGE}/acquire.go\",\n435|        find=\"\\tif err := req.Deps.Spawn(socket, argv); err != nil {\\n\",\n436|        replace='\\tif err := req.Deps.Spawn(socket, argv); err != nil && err.Error() != \"exec failed\" {\\n',\n437|        count=1,\n438|        run=\"TestAcquireForegroundSpawnFailureReportsWithoutFallback\",\n439|        expect=\"KILLED\",\n440|        note=\"Admits exactly the fixture spawn failure as success; every other spawn failure still reports.\",\n441|    ),\n442|    Mutant(\n443|        name=\"N-probe-swallow-foreground\",\n444|        path=f\"{PACKAGE}/acquire.go\",\n445|        find=\"\\treport, err := req.Deps.ProbeServer(socket)\\n\\tif err != nil {\\n\",\n446|        replace='\\treport, err := req.Deps.ProbeServer(socket)\\n\\tif err != nil && err.Error() != \"probe boom\" {\\n',\n447|        count=1,\n448|        run=\"TestAcquireForegroundProbeFailurePassesThrough\",\n449|        expect=\"KILLED\",\n450|        note=\"Admits exactly the fixture probe failure as an absent server (then spawns); every other probe failure still passes through.\",\n451|    ),\n452|    Mutant(\n453|        name=\"N-probe-swallow-background\",\n454|        path=f\"{PACKAGE}/acquire.go\",\n455|        find=\"\\tstatus, err := req.Deps.ProbeBroker()\\n\\tif err != nil {\\n\",\n456|        replace='\\tstatus, err := req.Deps.ProbeBroker()\\n\\tif err != nil && err.Error() != \"probe boom\" {\\n',\n457|        count=1,\n458|        run=\"TestAcquireBackgroundProbeFailurePassesThrough\",\n459|        expect=\"KILLED\",\n460|        note=\"Admits exactly the fixture probe failure as a broker miss (then reports unavailable); every other probe failure still passes through.\",\n461|    ),\n462|    Mutant(\n463|        name=\"N-argv-socket\",\n464|        path=f\"{PACKAGE}/argv.go\",\n465|        find=\"\\tif socket != SocketPath(runtimeDir) {\\n\",\n466|        replace='\\tif socket != SocketPath(runtimeDir) && socket != \"/tmp/tmux-501/default\" {\\n',\n467|        count=1,\n468|        run=\"TestBuildArgvRefusesAmbientSocket\",\n469|        expect=\"KILLED\",\n470|        note=\"Admits exactly the default path at the spawn-socket arm; every other ambient socket still refuses.\",\n471|    ),\n472|    Mutant(\n473|        name=\"N-argv-tmuxenv\",\n474|        path=f\"{PACKAGE}/argv.go\",\n475|        find=\"\\tif socket != SocketPath(runtimeDir) {\\n\",\n476|        replace='\\tif socket != SocketPath(runtimeDir) && socket != \"/tmp/tmux-501/default,12345,0\" {\\n',\n477|        count=1,\n478|        run=\"TestBuildArgvRefusesAmbientSocket/tmux_env_value\",\n479|        expect=\"KILLED\",\n480|        note=\"Admits exactly the TMUX environment value at the spawn-socket arm; every other ambient socket still refuses.\",\n481|    ),\n482|    Mutant(\n483|        name=\"N-argv-shape\",\n484|        path=f\"{PACKAGE}/argv.go\",\n485|        find=\"\\tif err := secprim.CheckArgv(argv); err != nil {\\n\",\n486|        replace='\\tif err := secprim.CheckArgv(argv); err != nil && argv[0] != \"tmux\" {\\n',\n487|        count=1,\n488|        run=\"TestBuildArgvRefusesInvalidArgvShape\",\n489|        expect=\"KILLED\",\n490|        note=\"Admits exactly our tmux-headed spawn vector past the landed shape wiring; any other vector still refuses. Other failing shapes are unstageable through the fixed-shape builder and are disclosed, not pinned.\",\n491|    ),\n492|    Mutant(\n493|        name=\"N-argv-session\",\n494|        path=f\"{PACKAGE}/argv.go\",\n495|        find=\"\\tsession, err := scalar.ParseUUIDv7(sessionID)\\n\\tif err != nil {\\n\",\n496|        replace='\\tsession, err := scalar.ParseUUIDv7(sessionID)\\n\\tif err != nil && sessionID != \"12345\" {\\n',\n497|        count=1,\n498|        run=\"(TestBuildArgvRefusesMalformedSession|TestAcquireForegroundRefusesMalformedSession)\",\n499|        expect=\"KILLED\",\n500|        note=\"Admits exactly the PID-form session past our wiring of the landed UUIDv7 grammar; every other malformed session still refuses.\",\n(more lines below)","final_result":true}}}
