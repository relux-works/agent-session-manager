{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb0f","stream":{"kind":"session","id":"01a0c4ab-e99a-71a1-b01c-d4e1f789add0"},"sequence":994,"recorded_at":1780531400001983,"record_type":"event","durability":"durable","causation_id":"e9eaa535-0e9f-444e-ac97-d216243d9df7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e9eaa535-0e9f-444e-ac97-d216243d9df7","run_stream":{"kind":"run","id":"e9eaa535-0e9f-444e-ac97-d216243d9df7"},"call_id":"call_01a0c4b04b6b7590abee0219936b17e6","text":"edited\nchanged lines: lines 552-561\n--- original\n+++ updated\n@@\n-    Mutant(\n-        name=\"N-background-absence-remap\",\n-        path=f\"{PACKAGE}/acquire.go\",\n-        find=\"\\tif runtimeAbsent(verr) {\\n\",\n-        replace=\"\\tif runtimeAbsent(verr) && req.Name != RuntimeDirName {\\n\",\n-        count=1,\n-        run=\"TestAcquireBackgroundVerifiesWithoutCreating\",\n-        expect=\"KILLED\",\n-        note=\"Admits exactly the canonical-leaf absence past the unavailable remap (it returns the custody code); absences under any other leaf name still map. Kill path: the background cold state reports tmux_unsafe_runtime_dir instead of capability_unavailable.\",\n-    ),\n+    Mutant(\n+        name=\"N-background-absence-remap\",\n+        path=f\"{PACKAGE}/acquire.go\",\n+        find=\"\\tif runtimeAbsent(verr) {\\n\",\n+        replace=\"\\tif runtimeAbsent(verr) && req.Platform != scalar.PlatformMacOS {\\n\",\n+        count=1,\n+        run=\"TestAcquireBackgroundVerifiesWithoutCreating\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly macOS absences past the unavailable remap (they return the custody code); absences on Linux/WSL2 still map. Kill path: the macOS background cold state reports tmux_unsafe_runtime_dir instead of capability_unavailable.\",\n+    ),\n+    Mutant(\n+        name=\"N-absence-remap-widen\",\n+        path=f\"{PACKAGE}/acquire.go\",\n+        find='\\treturn local.Code == CodeUnsafeRuntimeDir && local.Detail == \"runtime absent\"\\n',\n+        replace='\\treturn local.Code == CodeUnsafeRuntimeDir && (local.Detail == \"runtime absent\" || local.Detail == \"runtime mode\")\\n',\n+        count=1,\n+        run=\"TestAcquireBackgroundStagesVerifyCustodyRefusal\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly mode refusals past the absence classifier (a widened leaf maps to capability_unavailable with the custody refusal hidden as its redacted cause); absence still maps and every other unsafe-leaf refusal keeps its custody code. Kill path: the background custody test asserts the top-level *Error the caller renders.\",\n+    ),\n","edit_facts":{"tool_name":"edit_file","path":"internal/tmuxserver/mutant_harness.py","added":20,"removed":10},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
