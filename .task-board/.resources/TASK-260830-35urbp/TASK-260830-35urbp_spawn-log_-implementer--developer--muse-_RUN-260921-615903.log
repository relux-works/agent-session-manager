nment. One site, both entries: killed by the missing-root tests on the commit and verify sides.\",\n601|    ),\n602|    Mutant(\n603|        name=\"D-background-fallback\",\n604|        path=f\"{PACKAGE}/acquire.go\",\n605|        find=\"\\t\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\n\\t\\t\\treturn Outcome{}, backgroundUnavailable(req, err)\\n\\t\\t}\\n\",\n606|        replace=\"\\t\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\n\\t\\t\\tif req.Deps.Spawn != nil {\\n\\t\\t\\t\\t_ = req.Deps.Spawn(socket, nil)\\n\\t\\t\\t}\\n\\t\\t\\treturn Outcome{}, backgroundUnavailable(req, err)\\n\\t\\t}\\n\",\n607|        count=1,\n608|        run=BG_MISS_LINUX,\n609|        expect=\"KILLED\",\n610|        note=\"SUPPLEMENTARY ADDITIVE, not a narrowing: plants the reviewer-shaped direct-creation call on the background miss path. Kill path: every background-miss spy asserts zero spawn calls.\",\n611|    ),\n612|    Mutant(\n613|        name=\"C-control\",\n614|        path=f\"{PACKAGE}/errors.go\",\n615|        find=\"// Error is a package-local refusal. Code is one of the Code*\",\n616|        replace=\"// Error is a package-local refusal (harness control: comment-only). Code is one of the Code*\",\n617|        count=1,\n618|        run=\"TestSocketPathDerivesOnlyFromRuntimeDir\",\n619|        expect=\"SURVIVED\",\n620|        note=\"Harmless control: a comment-only edit that must SURVIVE, proving the harness observes outcomes.\",\n621|    ),\n622|]\n623|\n624|\n625|def apply(mutant: Mutant, original: str) -> str:\n626|    return original.replace(mutant.find, mutant.replace)\n627|\n628|\n629|def run_mutant(mutant: Mutant, log_dir: Path | None) -> str:\n630|    target = REPO / mutant.path\n631|    original = target.read_text()\n632|    found = original.count(mutant.find)\n633|    if found != mutant.count:\n634|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\"\n635|    with tempfile.TemporaryDirectory() as staging:\n636|        backup = Path(staging) / \"backup\"\n637|        shutil.copy2(target, backup)\n638|        try:\n639|            target.write_text(apply(mutant, original))\n640|            run = subprocess.run(\n641|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n642|                cwd=REPO,\n643|                capture_output=True,\n644|                text=True,\n645|                timeout=300,\n646|            )\n647|        finally:\n648|            shutil.copy2(backup, target)\n649|    output = (run.stdout + run.stderr).strip()\n650|    if os.environ.get(\"AX_MUTANT_VERBOSE\") == \"1\":\n651|        print(f\"--- raw: {mutant.name}: exit {run.returncode} ---\", flush=True)\n652|        print(output, flush=True)\n653|        print(f\"--- end raw: {mutant.name} ---\", flush=True)\n654|    if log_dir is not None:\n655|        (log_dir / f\"{mutant.name}.log\").write_text(\n656|            f\"exit: {run.returncode}\\nrun: go test ./{PACKAGE}/ -run {mutant.run} -count=1\\n\\n{output}\\n\"\n657|        )\n658|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n659|        return f\"ERROR: {mutant.name}: build broke under the patch\"\n660|    if run.returncode == 0:\n661|        verdict = \"SURVIVED\"\n662|    elif '--- FAIL' in output or 'FAIL:' in output:\n663|        verdict = \"KILLED\"\n664|    else:\n665|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\"\n666|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n667|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note} [exit {run.returncode}]\"\n668|\n669|\n670|def main(argv: list[str]) -> int:\n671|    log_dir: Path | None = None\n672|    names = list(argv)\n673|    if \"--log-dir\" in names:\n674|        idx = names.index(\"--log-dir\")\n675|        if idx + 1 >= len(names):\n676|            print(\"--log-dir needs a directory\")\n677|            return 2\n678|        log_dir = Path(names[idx + 1])\n679|        log_dir.mkdir(parents=True, exist_ok=True)\n680|        del names[idx : idx + 2]\n681|    selected = [m for m in MUTANTS if not names or m.name in names]\n682|    if names and len(selected) != len(names):\n683|        unknown = sorted(set(names) - {m.name for m in selected})\n684|        print(f\"unknown mutants: {', '.join(unknown)}\")\n685|        return 2\n686|    failures = 0\n687|    for mutant in selected:\n688|        try:\n689|            line = run_mutant(mutant, log_dir)\n690|        except subprocess.TimeoutExpired:\n691|            line = f\"ERROR: {mutant.name}: killer timed out\"\n692|        print(line, flush=True)\n693|        if not line.startswith(\"ok:\"):\n694|            failures += 1\n695|    return 1 if failures else 0\n696|\n697|\n698|if __name__ == \"__main__\":\n699|    sys.exit(main(sys.argv[1:]))","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c887","stream":{"kind":"session","id":"01a0c4ab-e99a-71a1-b01c-d4e1f789add0"},"sequence":670,"recorded_at":1780531400001335,"record_type":"event","durability":"durable","causation_id":"e9eaa535-0e9f-444e-ac97-d216243d9df7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e9eaa535-0e9f-444e-ac97-d216243d9df7","run_stream":{"kind":"run","id":"e9eaa535-0e9f-444e-ac97-d216243d9df7"},"call_id":"call_01a0c4add98574af8c5b1c70fd31ae01","text":"Read text file `internal/tmuxserver/runtime_unix.go`.\n1|//go:build !windows\n2|\n3|package tmuxserver\n4|\n5|import (\n6|\t\"errors\"\n7|\t\"os\"\n8|\n9|\t\"golang.org/x/sys/unix\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n12|)\n13|\n14|// commitRuntimeDir creates the leaf relative to the pinned root\n15|// handle and verifies exact custody on the opened descriptor. The\n16|// root itself must already exist: this entry creates exactly one\n17|// leaf and never builds parents, so a missing root refuses instead\n18|// of materializing an arbitrary ancestor chain with owner-only\n19|// modes. Mkdirat from the handle closes the validate-then-create\n20|// TOCTOU a path-string MkdirAll leaves open: descriptors pin what\n21|// they opened, and the leaf name is one grammar-checked segment.\n22|// classifyRootOpenError maps a pinned-root open failure to its\n23|// refusal: a missing root is malformed input — the entry creates\n24|// exactly one leaf and never builds parents — while every other\n25|// failure (unreadable, non-directory, symlink) is a containment\n26|// refusal. Commit and verify share this mapping so the missing-root\n27|// code cannot drift between the two entries.\n28|func classifyRootOpenError(err error) error {\n29|\tif os.IsNotExist(err) || errors.Is(err, os.ErrNotExist) {\n30|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"runtime root\"}\n31|\t}\n32|\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n33|}\n34|\n35|func commitRuntimeDir(root, name, joined string, hooks *Hooks) error {\n36|\t// No platform arm here: the lexical path already refused the\n37|\t// Windows platform on every host, so only unix platforms reach\n38|\t// this commit.\n39|\trootHandle, err := secprim.OpenNoFollowDir(root)\n40|\tif err != nil {\n41|\t\treturn classifyRootOpenError(err)\n42|\t}\n43|\tdefer func() { _ = rootHandle.Close() }()\n44|\tif !handleBoundToPath(rootHandle, root) {\n45|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n46|\t}\n47|\trootFd := int(rootHandle.Fd())\n48|\tcreated := true\n49|\tif err := unix.Mkdirat(rootFd, name, 0o700); err != nil {\n50|\t\tif !errors.Is(err, unix.EEXIST) {\n51|\t\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime commit\"}\n52|\t\t}\n53|\t\tcreated = false\n54|\t}\n55|\tif hooks != nil && hooks.AfterMkdir != nil {\n56|\t\thooks.AfterMkdir(joined)\n57|\t}\n58|\tleafFd, err := unix.Openat(rootFd, name,\n59|\t\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\n60|\tif err != nil {\n61|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n62|\t}\n63|\tleaf := os.NewFile(uintptr(leafFd), joined)\n64|\tif created {\n65|\t\t// The mkdir mode honors umask, so the exact owner-only\n66|\t\t// mode is enforced explicitly on a leaf this call\n67|\t\t// created. An existing leaf is verified, never\n68|\t\t// repaired: silently narrowing a widened directory\n69|\t\t// would mask the custody violation.\n70|\t\tif err := unix.Fchmod(leafFd, 0o700); err != nil {\n71|\t\t\t_ = leaf.Close()\n72|\t\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\n73|\t\t}\n74|\t}\n75|\tinfo, err := leaf.Stat()\n76|\tif err != nil {\n77|\t\t_ = leaf.Close()\n78|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\n79|\t}\n80|\t// The openat O_DIRECTORY flag already refused a non-directory\n81|\t// leaf above; the mode comparison below is the load-bearing\n82|\t// arm this gate's tests and mutants pin.\n83|\tif info.Mode().Perm() != 0o700 {\n84|\t\t_ = leaf.Close()\n85|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\n86|\t}\n87|\tif err := verifyOwnership(info); err != nil {\n88|\t\t_ = leaf.Close()\n89|\t\treturn err\n90|\t}\n91|\t// The parent fsync persists the directory entry; without it a\n92|\t// crash after mkdir can lose the leaf on journaling filesystems.\n93|\tif err := unix.Fsync(rootFd); err != nil {\n94|\t\t_ = leaf.Close()\n95|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime commit\"}\n96|\t}\n97|\t_ = leaf.Close()\n98|\treturn nil\n99|}\n100|\n101|// verifyRuntimeDir enforces the three custody gates on an existing\n102|// leaf without creating it. A missing leaf refuses with its own\n103|// detail: absence on the authorizing path is a readiness fact the\n104|// background entry maps to capability_unavailable, never a silent\n105|// repair and never the custody code an unsafe leaf earns.\n106|func verifyRuntimeDir(root, name string) error {\n107|\t// No platform arm here, for the same reason as the commit arm\n108|\t// above: only unix platforms reach this verify.\n109|\trootHandle, err := secprim.OpenNoFollowDir(root)\n110|\tif err != nil {\n111|\t\treturn classifyRootOpenError(err)\n112|\t}\n113|\tdefer func() { _ = rootHandle.Close() }()\n114|\tif !handleBoundToPath(rootHandle, root) {\n115|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n116|\t}\n117|\tleafFd, err := unix.Openat(int(rootHandle.Fd()), name,\n118|\t\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\n119|\tif err != nil {\n120|\t\tif errors.Is(err, unix.ENOENT) {\n121|\t\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime absent\"}\n122|\t\t}\n123|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n124|\t}\n125|\tleaf := os.NewFile(uintptr(leafFd), name)\n126|\tdefer func() { _ = leaf.Close() }()\n127|\tinfo, err := leaf.Stat()\n128|\tif err != nil {\n129|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\n130|\t}\n131|\tif info.Mode().Perm() != 0o700 {\n132|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\n133|\t}\n134|\treturn verifyOwnership(info)\n135|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
