{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c87d","stream":{"kind":"session","id":"01a0c4ab-e99a-71a1-b01c-d4e1f789add0"},"sequence":665,"recorded_at":1780531400001325,"record_type":"event","durability":"durable","causation_id":"e9eaa535-0e9f-444e-ac97-d216243d9df7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e9eaa535-0e9f-444e-ac97-d216243d9df7","run_stream":{"kind":"run","id":"e9eaa535-0e9f-444e-ac97-d216243d9df7"},"task_stream":{"kind":"task","id":"01a0c4ad-dc0d-74c1-8f33-5b0622b5cbab"},"task_id":"01a0c4ad-dc0d-74c1-8f33-5b0622b5cbab","event":{"kind":"output","task_id":"01a0c4ad-dc0d-74c1-8f33-5b0622b5cbab","chunk":"Read text file `internal/tmuxserver/runtime_unix.go`.\n1|//go:build !windows\n2|\n3|package tmuxserver\n4|\n5|import (\n6|\t\"errors\"\n7|\t\"os\"\n8|\n9|\t\"golang.org/x/sys/unix\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n12|)\n13|\n14|// commitRuntimeDir creates the leaf relative to the pinned root\n15|// handle and verifies exact custody on the opened descriptor. The\n16|// root itself must already exist: this entry creates exactly one\n17|// leaf and never builds parents, so a missing root refuses instead\n18|// of materializing an arbitrary ancestor chain with owner-only\n19|// modes. Mkdirat from the handle closes the validate-then-create\n20|// TOCTOU a path-string MkdirAll leaves open: descriptors pin what\n21|// they opened, and the leaf name is one grammar-checked segment.\n22|// classifyRootOpenError maps a pinned-root open failure to its\n23|// refusal: a missing root is malformed input — the entry creates\n24|// exactly one leaf and never builds parents — while every other\n25|// failure (unreadable, non-directory, symlink) is a containment\n26|// refusal. Commit and verify share this mapping so the missing-root\n27|// code cannot drift between the two entries.\n28|func classifyRootOpenError(err error) error {\n29|\tif os.IsNotExist(err) || errors.Is(err, os.ErrNotExist) {\n30|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"runtime root\"}\n31|\t}\n32|\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n33|}\n34|\n35|func commitRuntimeDir(root, name, joined string, hooks *Hooks) error {\n36|\t// No platform arm here: the lexical path already refused the\n37|\t// Windows platform on every host, so only unix platforms reach\n38|\t// this commit.\n39|\trootHandle, err := secprim.OpenNoFollowDir(root)\n40|\tif err != nil {\n41|\t\treturn classifyRootOpenError(err)\n42|\t}\n43|\tdefer func() { _ = rootHandle.Close() }()\n44|\tif !handleBoundToPath(rootHandle, root) {\n45|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n46|\t}\n47|\trootFd := int(rootHandle.Fd())\n48|\tcreated := true\n49|\tif err := unix.Mkdirat(rootFd, name, 0o700); err != nil {\n50|\t\tif !errors.Is(err, unix.EEXIST) {\n51|\t\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime commit\"}\n52|\t\t}\n53|\t\tcreated = false\n54|\t}\n55|\tif hooks != nil && hooks.AfterMkdir != nil {\n56|\t\thooks.AfterMkdir(joined)\n57|\t}\n58|\tleafFd, err := unix.Openat(rootFd, name,\n59|\t\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\n60|\tif err != nil {\n61|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n62|\t}\n63|\tleaf := os.NewFile(uintptr(leafFd), joined)\n64|\tif created {\n65|\t\t// The mkdir mode honors umask, so the exact owner-only\n66|\t\t// mode is enforced explicitly on a leaf this call\n67|\t\t// created. An existing leaf is verified, never\n68|\t\t// repaired: silently narrowing a widened directory\n69|\t\t// would mask the custody violation.\n70|\t\tif err := unix.Fchmod(leafFd, 0o700); err != nil {\n71|\t\t\t_ = leaf.Close()\n72|\t\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\n73|\t\t}\n74|\t}\n75|\tinfo, err := leaf.Stat()\n76|\tif err != nil {\n77|\t\t_ = leaf.Close()\n78|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\n79|\t}\n80|\t// The openat O_DIRECTORY flag already refused a non-directory\n81|\t// leaf above; the mode comparison below is the load-bearing\n82|\t// arm this gate's tests and mutants pin.\n83|\tif info.Mode().Perm() != 0o700 {\n84|\t\t_ = leaf.Close()\n85|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\n86|\t}\n87|\tif err := verifyOwnership(info); err != nil {\n88|\t\t_ = leaf.Close()\n89|\t\treturn err\n90|\t}\n91|\t// The parent fsync persists the directory entry; without it a\n92|\t// crash after mkdir can lose the leaf on journaling filesystems.\n93|\tif err := unix.Fsync(rootFd); err != nil {\n94|\t\t_ = leaf.Close()\n95|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime commit\"}\n96|\t}\n97|\t_ = leaf.Close()\n98|\treturn nil\n99|}\n100|\n101|// verifyRuntimeDir enforces the three custody gates on an existing\n102|// leaf without creating it. A missing leaf refuses with its own\n103|// detail: absence on the authorizing path is a readiness fact the\n104|// background entry maps to capability_unavailable, never a silent\n105|// repair and never the custody code an unsafe leaf earns.\n106|func verifyRuntimeDir(root, name string) error {\n107|\t// No platform arm here, for the same reason as the commit arm\n108|\t// above: only unix platforms reach this verify.\n109|\trootHandle, err := secprim.OpenNoFollowDir(root)\n110|\tif err != nil {\n111|\t\treturn classifyRootOpenError(err)\n112|\t}\n113|\tdefer func() { _ = rootHandle.Close() }()\n114|\tif !handleBoundToPath(rootHandle, root) {\n115|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n116|\t}\n117|\tleafFd, err := unix.Openat(int(rootHandle.Fd()), name,\n118|\t\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\n119|\tif err != nil {\n120|\t\tif errors.Is(err, unix.ENOENT) {\n121|\t\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime absent\"}\n122|\t\t}\n123|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n124|\t}\n125|\tleaf := os.NewFile(uintptr(leafFd), name)\n126|\tdefer func() { _ = leaf.Close() }()\n127|\tinfo, err := leaf.Stat()\n128|\tif err != nil {\n129|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\n130|\t}\n131|\tif info.Mode().Perm() != 0o700 {\n132|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\n133|\t}\n134|\treturn verifyOwnership(info)\n135|}","final_result":true}}}
