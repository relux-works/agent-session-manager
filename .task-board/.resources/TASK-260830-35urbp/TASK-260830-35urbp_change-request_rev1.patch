+        path=f"{PACKAGE}/acquire.go",
+        find="\treport, err := req.Deps.ProbeServer(socket)\n\tif err != nil {\n",
+        replace='\treport, err := req.Deps.ProbeServer(socket)\n\tif err != nil && err.Error() != "probe boom" {\n',
+        count=1,
+        run="TestAcquireForegroundProbeFailurePassesThrough",
+        expect="KILLED",
+        note="Admits exactly the fixture probe failure as an absent server (then spawns); every other probe failure still passes through.",
+    ),
+    Mutant(
+        name="N-probe-swallow-background",
+        path=f"{PACKAGE}/acquire.go",
+        find="\tstatus, err := req.Deps.ProbeBroker()\n\tif err != nil {\n",
+        replace='\tstatus, err := req.Deps.ProbeBroker()\n\tif err != nil && err.Error() != "probe boom" {\n',
+        count=1,
+        run="TestAcquireBackgroundProbeFailurePassesThrough",
+        expect="KILLED",
+        note="Admits exactly the fixture probe failure as a broker miss (then reports unavailable); every other probe failure still passes through.",
+    ),
+    Mutant(
+        name="N-argv-socket",
+        path=f"{PACKAGE}/argv.go",
+        find="\tif socket != SocketPath(runtimeDir) {\n",
+        replace='\tif socket != SocketPath(runtimeDir) && socket != "/tmp/tmux-501/default" {\n',
+        count=1,
+        run="TestBuildArgvRefusesAmbientSocket",
+        expect="KILLED",
+        note="Admits exactly the default path at the spawn-socket arm; every other ambient socket still refuses.",
+    ),
+    Mutant(
+        name="N-argv-session",
+        path=f"{PACKAGE}/argv.go",
+        find="\tsession, err := scalar.ParseUUIDv7(sessionID)\n\tif err != nil {\n",
+        replace='\tsession, err := scalar.ParseUUIDv7(sessionID)\n\tif err != nil && sessionID != "12345" {\n',
+        count=1,
+        run="(TestBuildArgvRefusesMalformedSession|TestAcquireForegroundRefusesMalformedSession)",
+        expect="KILLED",
+        note="Admits exactly the PID-form session past our wiring of the landed UUIDv7 grammar; every other malformed session still refuses.",
+    ),
+    Mutant(
+        name="N-deps-background",
+        path=f"{PACKAGE}/acquire.go",
+        find="\tif req.Deps.ProbeBroker == nil {\n",
+        replace="\tif req.Deps.ProbeBroker == nil && req.Deps.Spawn == nil {\n",
+        count=1,
+        run="TestAcquireBackgroundNilBrokerWithSpawnRefuses",
+        expect="KILLED",
+        note="Admits exactly the nil-probe-with-spawn background request past the dependencies arm; the fully-nil request still refuses. Kill path: the admitted request panics on the nil probe, and the panic fails the test.",
+    ),
+    Mutant(
+        name="N-deps-foreground",
+        path=f"{PACKAGE}/acquire.go",
+        find="\tif req.Deps.ProbeServer == nil || req.Deps.Spawn == nil {\n",
+        replace="\tif req.Deps.ProbeServer == nil && req.Deps.Spawn == nil {\n",
+        count=1,
+        run="TestAcquireForegroundNilSpawnWithProbeRefuses",
+        expect="KILLED",
+        note="Admits exactly the half-nil foreground dependencies past the arm; fully-nil dependencies still refuse. Kill path: the admitted request panics on the nil spawn, and the panic fails the test.",
+    ),
+    Mutant(
+        name="D-background-fallback",
+        path=f"{PACKAGE}/acquire.go",
+        find="\t\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\n\t\t\treturn Outcome{}, backgroundUnavailable(req, err)\n\t\t}\n",
+        replace="\t\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\n\t\t\tif req.Deps.Spawn != nil {\n\t\t\t\t_ = req.Deps.Spawn(socket, nil)\n\t\t\t}\n\t\t\treturn Outcome{}, backgroundUnavailable(req, err)\n\t\t}\n",
+        count=1,
+        run=BG_MISS,
+        expect="KILLED",
+        note="SUPPLEMENTARY ADDITIVE, not a narrowing: plants the reviewer-shaped direct-creation call on the background miss path. Kill path: every background-miss spy asserts zero spawn calls.",
+    ),
+    Mutant(
+        name="C-control",
+        path=f"{PACKAGE}/errors.go",
+        find="// Error is a package-local refusal. Code is one of the Code*",
+        replace="// Error is a package-local refusal (harness control: comment-only). Code is one of the Code*",
+        count=1,
+        run="TestSocketPathDerivesOnlyFromRuntimeDir",
+        expect="SURVIVED",
+        note="Harmless control: a comment-only edit that must SURVIVE, proving the harness observes outcomes.",
+    ),
+]
+
+
+def apply(mutant: Mutant, original: str) -> str:
+    return original.replace(mutant.find, mutant.replace)
+
+
+def run_mutant(mutant: Mutant, log_dir: Path | None) -> str:
+    target = REPO / mutant.path
+    original = target.read_text()
+    found = original.count(mutant.find)
+    if found != mutant.count:
+        return f"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}"
+    with tempfile.TemporaryDirectory() as staging:
+        backup = Path(staging) / "backup"
+        shutil.copy2(target, backup)
+        try:
+            target.write_text(apply(mutant, original))
+            run = subprocess.run(
+                ["go", "test", f"./{PACKAGE}/", "-run", mutant.run, "-count=1"],
+                cwd=REPO,
+                capture_output=True,
+                text=True,
+                timeout=300,
+            )
+        finally:
+            shutil.copy2(backup, target)
+    output = (run.stdout + run.stderr).strip()
+    if os.environ.get("AX_MUTANT_VERBOSE") == "1":
+        print(f"--- raw: {mutant.name}: exit {run.returncode} ---", flush=True)
+        print(output, flush=True)
+        print(f"--- end raw: {mutant.name} ---", flush=True)
+    if log_dir is not None:
+        (log_dir / f"{mutant.name}.log").write_text(
+            f"exit: {run.returncode}\nrun: go test ./{PACKAGE}/ -run {mutant.run} -count=1\n\n{output}\n"
+        )
+    if 'build failed' in output or '\n# ' in output or output.startswith('# '):
+        return f"ERROR: {mutant.name}: build broke under the patch"
+    if run.returncode == 0:
+        verdict = "SURVIVED"
+    elif '--- FAIL' in output or 'FAIL:' in output:
+        verdict = "KILLED"
+    else:
+        return f"ERROR: {mutant.name}: exit {run.returncode} with no kill line"
+    mark = "ok" if verdict == mutant.expect else "MISMATCH"
+    return f"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note} [exit {run.returncode}]"
+
+
+def main(argv: list[str]) -> int:
+    log_dir: Path | None = None
+    names = list(argv)
+    if "--log-dir" in names:
+        idx = names.index("--log-dir")
+        if idx + 1 >= len(names):
+            print("--log-dir needs a directory")
+            return 2
+        log_dir = Path(names[idx + 1])
+        log_dir.mkdir(parents=True, exist_ok=True)
+        del names[idx : idx + 2]
+    selected = [m for m in MUTANTS if not names or m.name in names]
+    if names and len(selected) != len(names):
+        unknown = sorted(set(names) - {m.name for m in selected})
+        print(f"unknown mutants: {', '.join(unknown)}")
+        return 2
+    failures = 0
+    for mutant in selected:
+        try:
+            line = run_mutant(mutant, log_dir)
+        except subprocess.TimeoutExpired:
+            line = f"ERROR: {mutant.name}: killer timed out"
+        print(line, flush=True)
+        if not line.startswith("ok:"):
+            failures += 1
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
diff --git a/internal/tmuxserver/ownership_unix.go b/internal/tmuxserver/ownership_unix.go
new file mode 100644
index 0000000..23fad02
--- /dev/null
+++ b/internal/tmuxserver/ownership_unix.go
@@ -0,0 +1,33 @@
+//go:build !windows
+
+package tmuxserver
+
+import (
+	"io/fs"
+	"os"
+	"syscall"
+)
+
+// effectiveUID reports the process effective UID. It is a variable
+// only so seam-failure tests can force the foreign-ownership path
+// through the production entries: staging a foreign-owned directory
+// needs privilege no test may assume, and without the seam the
+// ownership refusal is untestable. Production code never reassigns
+// it.
+var effectiveUID = os.Geteuid
+
+// verifyOwnership enforces the ownership gate on unix: the directory
+// must belong to the effective UID. Mode bits are checked by the
+// caller against the exact 0700 requirement, so any group or world
+// access already refused there. A stat without ownership metadata
+// fails closed: unreadable ownership is never legitimate custody.
+func verifyOwnership(info fs.FileInfo) error {
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	if !ok {
+		return &Error{Code: CodeUnsafeRuntimeDir, Detail: "runtime ownership"}
+	}
+	if stat.Uid != uint32(effectiveUID()) {
+		return &Error{Code: CodeUnsafeRuntimeDir, Detail: "runtime ownership"}
+	}
+	return nil
+}
diff --git a/internal/tmuxserver/readiness.go b/internal/tmuxserver/readiness.go
new file mode 100644
index 0000000..6828c2c
--- /dev/null
+++ b/internal/tmuxserver/readiness.go
@@ -0,0 +1,84 @@
+package tmuxserver
+
+// ManagerNameHint documents the launchctl managername observation:
+// a diagnostic hint only. The value travels on the request for
+// operator diagnostics and no gate reads it. Any test that sets a
+// hint and varies only live attestation proves the hint carries no
+// authority.
+type ManagerNameHint struct {
+	// Value is the observed manager name, for example "Aqua".
+	// Empty means no observation was made.
+	Value string
+}
+
+// CachedObservation is a previously recorded sentinel or managername
+// result. It is a distinct type that no authorizing entry accepts:
+// CheckLiveAttestation takes LiveAttestation only, so a cached
+// value cannot be passed where live proof is required even by
+// accident. Its only use is negative tests proving it authorizes
+// nothing.
+type CachedObservation struct {
+	SentinelPassed bool
+	ManagerName    string
+}
+
+// LiveAttestation is one live functional-sentinel plus
+// provider-auth-smoke observation inside the exact tmux server. Every
+// member is required: Aqua alone and sentinel-only evidence are
+// insufficient, and the binding members tie the observation to the
+// exact server generation, provider build, and macOS version.
+type LiveAttestation struct {
+	SentinelPassed   bool
+	SmokePassed      bool
+	ServerGeneration string
+	ProviderBuild    string
+	MacOSVersion     string
+}
+
+// CheckLiveAttestation admits exactly one complete live observation:
+// a passed sentinel AND a passed provider-auth smoke AND the full
+// generation/build/version binding. Each conjunct refuses alone with
+// the non-authorizing code, so weakening any one arm admits a
+// sentinel-only, smoke-only, or unbound observation the committed
+// tests pin. A cached observation is not a LiveAttestation and has
+// no conversion: the type boundary, not a boolean, keeps the cache
+// off the authorizing path.
+func CheckLiveAttestation(live LiveAttestation) error {
+	if !live.SentinelPassed {
+		return &Error{Code: CodeReadinessNotAuthorizing, Detail: "sentinel result"}
+	}
+	if !live.SmokePassed {
+		return &Error{Code: CodeReadinessNotAuthorizing, Detail: "provider smoke result"}
+	}
+	if live.ServerGeneration == "" || live.ProviderBuild == "" || live.MacOSVersion == "" {
+		return &Error{Code: CodeReadinessNotAuthorizing, Detail: "attestation binding"}
+	}
+	return nil
+}
+
+// BrokerStatus is the live Aqua broker report the background path
+// decides over. Authenticated names an already-running authenticated
+// broker; Attested names its attested AX tmux server with a live
+// attestation. Either fact missing means neither exists for the
+// purpose of the broker-or-refuse rule.
+type BrokerStatus struct {
+	Authenticated bool
+	Attested      bool
+	Attestation   LiveAttestation
+}
+
+// CheckBrokerContact admits exactly the background MAY case: an
+// already-running authenticated broker AND its attested AX tmux
+// server with a complete live attestation. Every other report —
+// no broker, unauthenticated broker, unattested server, incomplete
+// attestation — refuses, and the caller maps the refusal to the
+// typed capability_unavailable the spec names.
+func CheckBrokerContact(status BrokerStatus) error {
+	if !status.Authenticated {
+		return &Error{Code: CodeReadinessNotAuthorizing, Detail: "broker authentication"}
+	}
+	if !status.Attested {
+		return &Error{Code: CodeReadinessNotAuthorizing, Detail: "server attestation"}
+	}
+	return CheckLiveAttestation(status.Attestation)
+}
diff --git a/internal/tmuxserver/readiness_test.go b/internal/tmuxserver/readiness_test.go
