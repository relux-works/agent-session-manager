\tif req.Deps.ProbeServer == nil || req.Deps.Spawn == nil {\\n\",\n517|        replace=\"\\tif req.Deps.ProbeServer == nil && req.Deps.Spawn == nil {\\n\",\n518|        count=1,\n519|        run=\"TestAcquireForegroundNilSpawnWithProbeRefuses\",\n520|        expect=\"KILLED\",\n521|        note=\"Admits exactly the half-nil foreground dependencies past the arm; fully-nil dependencies still refuse. Kill path: the admitted request panics on the nil spawn, and the panic fails the test.\",\n522|    ),\n523|    Mutant(\n524|        name=\"N-running-empty-admission\",\n525|        path=f\"{PACKAGE}/acquire.go\",\n526|        find=\"\\tif report.Running {\\n\",\n527|        replace=\"\\tif report.Running && len(report.Admission.Admitted.Capabilities) > 0 {\\n\",\n528|        count=1,\n529|        run=\"TestAcquireForegroundRefusesRunningWithEmptyAdmission\",\n530|        expect=\"KILLED\",\n531|        note=\"Admits exactly running servers with zero admission rows past the Running arm (they are treated as absent and spawned into); running servers with admission data still attach-or-refuse. Kill path: a second new-session spawns into the live server.\",\n532|    ),\n533|    Mutant(\n534|        name=\"N-running-empty-generation\",\n535|        path=f\"{PACKAGE}/acquire.go\",\n536|        find=\"\\tif report.Running {\\n\",\n537|        replace='\\tif report.Running && report.Admission.RawGeneration != \"\" {\\n',\n538|        count=1,\n539|        run=\"TestAcquireForegroundRefusesRunningWithEmptyGeneration\",\n540|        expect=\"KILLED\",\n541|        note=\"Admits exactly running servers whose admission carries no generation past the Running arm; running servers with a generation still attach-or-refuse. Kill path: a second new-session spawns into the live server.\",\n542|    ),\n543|    Mutant(\n544|        name=\"N-verify-absence-detail\",\n545|        path=f\"{PACKAGE}/runtime_unix.go\",\n546|        find='\\tif err != nil {\\n\\t\\tif errors.Is(err, unix.ENOENT) {\\n