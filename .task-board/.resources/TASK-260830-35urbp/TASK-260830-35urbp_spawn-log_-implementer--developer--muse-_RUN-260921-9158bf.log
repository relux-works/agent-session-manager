: fixtureGeneration},\n322|\t\t\tServer:    boundAdmission(),\n323|\t\t}},\n324|\t\t{\"generation-unbound principal\", BrokerReport{\n325|\t\t\tPrincipal: BrokerPrincipal{UID: live.Principal.UID, Generation: fixtureStaleGen},\n326|\t\t\tServer:    boundAdmission(),\n327|\t\t}},\n328|\t\t{\"unattested server\", BrokerReport{\n329|\t\t\tPrincipal: live.Principal,\n330|\t\t\tServer:    RealmAdmission{RawGeneration: fixtureGeneration},\n331|\t\t}},\n332|\t\t{\"stale server admission\", BrokerReport{\n333|\t\t\tPrincipal: live.Principal,\n334|\t\t\tServer:    staleAdmission(),\n335|\t\t}},\n336|\t\t{\"zero server admission\", BrokerReport{\n337|\t\t\tPrincipal: live.Principal,\n338|\t\t\tServer:    RealmAdmission{},\n339|\t\t}},\n340|\t\t{\"admitted server without generation\", BrokerReport{\n341|\t\t\tPrincipal: live.Principal,\n342|\t\t\tServer:    RealmAdmission{Admitted: realmAdmitted()},\n343|\t\t}},\n344|\t\t{\"decoy-only server admission\", BrokerReport{\n345|\t\t\tPrincipal: live.Principal,\n346|\t\t\tServer: RealmAdmission{\n347|\t\t\t\tAdmitted:      terminalbackend.Admitted{Capabilities: []string{fixtureDecoyCapacity}},\n348|\t\t\t\tRawGeneration: fixtureGeneration,\n349|\t\t\t},\n350|\t\t}},\n351|\t} {\n352|\t\tt.Run(tc.name, func(t *testing.T) {\n353|\t\t\troot := runtimeRoot(t)\n354|\t\t\truntimeDir(t, root)\n355|\t\t\treq := validRequest(t, root)\n356|\t\t\treq.Caller = CallerBackground\n357|\t\t\treq.Platform = scalar.PlatformMacOS\n358|\t\t\tspy := &spawnSpy{}\n359|\t\t\tprobe := &probeServerSpy{}\n360|\t\t\t// Even dependencies that would succeed must never run:\n361|\t\t\t// the miss path has no fallback to direct creation,\n362|\t\t\t// neither through the spawner nor through a re-entered\n363|\t\t\t// foreground probe.\n364|\t\t\treq.Deps.Spawn = spy.spawn\n365|\t\t\treq.Deps.ProbeServer = probe.probe\n366|\t\t\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n367|\t\t\t\treturn tc.report, nil\n368|\t\t\t}\n369|\t\t\t_, err := Acquire(req)\n370|\t\t\trequireCapabilityUnavailable(t, err, \"background\", fixtureBroker, fixtureGeneration, fixtureRemedy)\n371|\t\t\tif spy.calls != 0 {\n372|\t\t\t\tt.Fatalf(\"spawn calls = %d, want 0 without fallback\", spy.calls)\n373|\t\t\t}\n374|\t\t\tprobe.requireSilent(t)\n375|\t\t})\n376|\t}\n377|}\n378|\n379|func TestAcquireBackgroundMissOnLinuxAlsoRefusesWithoutFallback(t *testing.T) {\n380|\troot := runtimeRoot(t)\n381|\truntimeDir(t, root)\n382|\treq := validRequest(t, root)\n383|\treq.Caller = CallerBackground\n384|\treq.Platform = scalar.PlatformLinux\n385|\tspy := &spawnSpy{}\n386|\tprobe := &probeServerSpy{}\n387|\treq.Deps.Spawn = spy.spawn\n388|\treq.Deps.ProbeServer = probe.probe\n389|\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n390|\t\treturn BrokerReport{}, nil\n391|\t}\n392|\t_, err := Acquire(req)\n393|\trequireCapabilityUnavailable(t, err, \"background\", fixtureBroker, fixtureGeneration, fixtureRemedy)\n394|\tif spy.calls != 0 {\n395|\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n396|\t}\n397|\tprobe.requireSilent(t)\n398|}\n399|\n400|// Background acquisition verifies the runtime directory instead of\n401|// creating it. A missing leaf is the ordinary post-reboot cold\n402|// state — the Runtime IPC root is a per-user temporary directory —\n403|// so absence returns the typed capability_unavailable with the\n404|// request's realm/readiness details, and the refusal probes no\n405|// broker, spawns nothing, and leaves no directory behind: a\n406|// background caller performs no durable write.\n407|func TestAcquireBackgroundVerifiesWithoutCreating(t *testing.T) {\n408|\t// The cold state is the same on every unix platform: $XDG_RUNTIME_DIR\n409|\t// is tmpfs on Linux/WSL2, so a background restore worker there meets\n410|\t// the absent leaf exactly like the macOS caller. Each platform maps\n411|\t// the absence to the typed unavailable — never the custody code.\n412|\tfor _, platform := range []scalar.Platform{scalar.PlatformMacOS, scalar.PlatformLinux, scalar.PlatformWSL2} {\n413|\t\tt.Run(string(platform), func(t *testing.T) {\n414|\t\t\troot := runtimeRoot(t)\n415|\t\t\treq := validRequest(t, root)\n416|\t\t\treq.Caller = CallerBackground\n417|\t\t\treq.Platform = platform\n418|\t\t\tprobed := false\n419|\t\t\tspy := &spawnSpy{}\n420|\t\t\tserverProbe := &probeServerSpy{}\n421|\t\t\treq.Deps.Spawn = spy.spawn\n422|\t\t\treq.Deps.ProbeServer = serverProbe.probe\n423|\t\t\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n424|\t\t\t\tprobed = true\n425|\t\t\t\treturn brokerReport(), nil\n426|\t\t\t}\n427|\t\t\t_, err := Acquire(req)\n428|\t\t\trequireCapabilityUnavailable(t, err, \"background\", fixtureBroker, fixtureGeneration, fixtureRemedy)\n429|\t\t\tif probed {\n430|\t\t\t\tt.Fatal(\"broker was probed for an absent runtime directory\")\n431|\t\t\t}\n432|\t\t\tif spy.calls != 0 {\n433|\t\t\t\tt.Fatalf(\"spawn calls = %d, want 0 on absence\", spy.calls)\n434|\t\t\t}\n435|\t\t\tserverProbe.requireSilent(t)\n436|\t\t\tif _, statErr := os.Lstat(filepath.Join(root, RuntimeDirName)); !os.IsNotExist(statErr) {\n437|\t\t\t\tt.Fatalf(\"background refusal created the directory: stat err = %v\", statErr)\n438|\t\t\t}\n439|\t\t})\n440|\t}\n441|}\n442|\n443|// A missing runtime root is not a missing leaf: the root input names\n444|// nothing the leaf could live under, so the background path refuses\n445|// it as malformed input — the same code the commit side reports —\n446|// without probing the broker.\n447|func TestAcquireBackgroundMissingRootRefusesInvalid(t *testing.T) {\n448|\troot := filepath.Join(runtimeRoot(t), \"no-such-root\")\n449|\treq := validRequest(t, root)\n450|\treq.Caller = CallerBackground\n451|\tprobed := false\n452|\tspy := &spawnSpy{}\n453|\tprobe := &probeServerSpy{}\n454|\treq.Deps.Spawn = spy.spawn\n455|\treq.Deps.ProbeServer = probe.probe\n456|\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n457|\t\tprobed = true\n458|\t\treturn brokerReport(), nil\n459|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
