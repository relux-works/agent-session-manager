{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c983","stream":{"kind":"session","id":"01a0c5d0-c246-7b92-beac-dc3b11390997"},"sequence":796,"recorded_at":1780531400001587,"record_type":"event","durability":"durable","causation_id":"aa3bb7a1-c12a-4660-a0d5-ffba7d41ef0c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"aa3bb7a1-c12a-4660-a0d5-ffba7d41ef0c","run_stream":{"kind":"run","id":"aa3bb7a1-c12a-4660-a0d5-ffba7d41ef0c"},"task_stream":{"kind":"task","id":"01a0c5d3-6130-7ec2-a631-039a25f5b72c"},"task_id":"01a0c5d3-6130-7ec2-a631-039a25f5b72c","event":{"kind":"output","task_id":"01a0c5d3-6130-7ec2-a631-039a25f5b72c","chunk":"Read text file `internal/tmuxserver/runtime_test.go`.\n1|//go:build !windows\n2|\n3|package tmuxserver\n4|\n5|import (\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"syscall\"\n9|\t\"testing\"\n10|\t\"time\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|)\n14|\n15|func TestEnsureRuntimeDirCreatesOwnerOnly(t *testing.T) {\n16|\troot := runtimeRoot(t)\n17|\tdir, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n18|\tif err != nil {\n19|\t\tt.Fatal(err)\n20|\t}\n21|\tif dir != filepath.Join(root, RuntimeDirName) {\n22|\t\tt.Fatalf(\"dir = %q\", dir)\n23|\t}\n24|\tinfo, err := os.Lstat(dir)\n25|\tif err != nil {\n26|\t\tt.Fatal(err)\n27|\t}\n28|\tif !info.IsDir() || info.Mode().Perm() != 0o700 {\n29|\t\tt.Fatalf(\"mode = %04o dir=%v, want 0700 dir\", info.Mode().Perm(), info.IsDir())\n30|\t}\n31|}\n32|\n33|func TestEnsureRuntimeDirIsIdempotent(t *testing.T) {\n34|\troot := runtimeRoot(t)\n35|\tfirst, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n36|\tif err != nil {\n37|\t\tt.Fatal(err)\n38|\t}\n39|\tsecond, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n40|\tif err != nil {\n41|\t\tt.Fatal(err)\n42|\t}\n43|\tif first != second {\n44|\t\tt.Fatalf(\"second = %q, want %q\", second, first)\n45|\t}\n46|\tinfo, err := os.Lstat(second)\n47|\tif err != nil {\n48|\t\tt.Fatal(err)\n49|\t}\n50|\tif info.Mode().Perm() != 0o700 {\n51|\t\tt.Fatalf(\"mode after re-ensure = %04o, want 0700\", info.Mode().Perm())\n52|\t}\n53|}\n54|\n55|func TestVerifyRuntimeDirAdmitsCompliant(t *testing.T) {\n56|\troot := runtimeRoot(t)\n57|\truntimeDir(t, root)\n58|\tif err := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS); err != nil {\n59|\t\tt.Fatal(err)\n60|\t}\n61|}\n62|\n63|func TestEnsureRuntimeDirRefusesWidenedMode(t *testing.T) {\n64|\troot := runtimeRoot(t)\n65|\tdir, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n66|\tif err != nil {\n67|\t\tt.Fatal(err)\n68|\t}\n69|\t// The suite widens the mode behind the entry's back; re-entry\n70|\t// must refuse, never silently repair.\n71|\tif err := os.Chmod(dir, 0o755); err != nil {\n72|\t\tt.Fatal(err)\n73|\t}\n74|\t_, err = EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n75|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime mode\")\n76|\tif err := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS); err != nil {\n77|\t\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime mode\")\n78|\t} else {\n79|\t\tt.Fatal(\"VerifyRuntimeDir admitted a 0755 directory\")\n80|\t}\n(more lines below)","final_result":true}}}
