come.Socket {\n38|\t\tt.Fatalf(\"spawn argv = %q\", spy.argv)\n39|\t}\n40|\tfor i, ambient := range []string{req.Ambient.TMUXEnv, req.Ambient.TMUXTmpDir, req.Ambient.InheritedSocket, req.Ambient.DefaultPath, req.Ambient.ConventionalName} {\n41|\t\tif ambient == \"\" {\n42|\t\t\tcontinue\n43|\t\t}\n44|\t\tif outcome.Socket == ambient {\n45|\t\t\tt.Fatalf(\"socket reuses ambient vector %d\", i)\n46|\t\t}\n47|\t\tfor _, arg := range spy.argv {\n48|\t\t\tif arg == ambient {\n49|\t\t\t\tt.Fatalf(\"argv carries ambient vector %d: %q\", i, arg)\n50|\t\t\t}\n51|\t\t}\n52|\t}\n53|\twantTail := []string{\"ax\", \"pane\", fixtureSession}\n54|\ttail := spy.argv[len(spy.argv)-3:]\n55|\tfor i := range wantTail {\n56|\t\tif tail[i] != wantTail[i] {\n57|\t\t\tt.Fatalf(\"argv tail = %q, want %q\", tail, wantTail)\n58|\t\t}\n59|\t}\n60|\t// The spawned vector is pinned element-by-element through the\n61|\t// entry, exactly as the direct BuildArgv test pins it: a dropped\n62|\t// flag or a retargeted tail reddens here, not only at the helper.\n63|\twantVector := []string{\"tmux\", \"-S\", outcome.Socket, \"new-session\", \"-d\", \"-s\", fixtureSession, \"ax\", \"pane\", fixtureSession}\n64|\tif len(spy.argv) != len(wantVector) {\n65|\t\tt.Fatalf(\"spawn argv = %q, want %q\", spy.argv, wantVector)\n66|\t}\n67|\tfor i := range wantVector {\n68|\t\tif spy.argv[i] != wantVector[i] {\n69|\t\t\tt.Fatalf(\"spawn argv = %q, want %q\", spy.argv, wantVector)\n70|\t\t}\n71|\t}\n72|}\n73|\n74|func socketDir(t *testing.T, root string) string {\n75|\tt.Helper()\n76|\treturn runtimeDir(t, root)\n77|}\n78|\n79|func TestAcquireForegroundAttachesToRunningAttested(t *testing.T) {\n80|\troot := runtimeRoot(t)\n81|\treq := validRequest(t, root)\n82|\tspy := &spawnSpy{}\n83|\tprobed := \"\"\n84|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n85|\t\tprobed = socket\n86|\t\treturn ServerReport{Running: true, Admission: boundAdmission()}, nil\n87|\t}\n88|\treq.Deps.Spawn = spy.spawn\n89|\toutcome, err := Acquire(req)\n90|\tif err != nil {\n91|\t\tt.Fatal(err)\n92|\t}\n93|\tif outcome.Via != \"attached-running\" {\n94|\t\tt.Fatalf(\"via = %q\", outcome.Via)\n95|\t}\n96|\tif probed != outcome.Socket || outcome.Socket != SocketPath(socketDir(t, root)) {\n97|\t\tt.Fatalf(\"probed = %q socket = %q\", probed, outcome.Socket)\n98|\t}\n99|\tif spy.calls != 0 {\n100|\t\tt.Fatalf(\"spawn calls = %d, want 0 on attach\", spy.calls)\n101|\t}\n102|}\n103|\n104|func TestAcquireForegroundRefusesRunningUnattested(t *testing.T) {\n105|\troot := runtimeRoot(t)\n106|\treq := validRequest(t, root)\n107|\tspy := &spawnSpy{}\n108|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n109|\t\treturn ServerReport{Running: true, Admission: RealmAdmission{\n110|\t\t\tAdmitted:      terminalbackend.Admitted{Capabilities: []string{fixtureDecoyCapacity}},\n111|\t\t\tRawGeneration: fixtureGeneration,\n112|\t\t}}, nil\n113|\t}\n114|\treq.Deps.Spawn = spy.spawn\n115|\t_, err := Acquire(req)\n116|\trequireLocalError(t, err, \"tmux_readiness_not_authorizing\", \"server attestation\")\n117|\tif spy.calls != 0 {\n118|\t\tt.Fatalf(\"spawn calls = %d, want 0 on unattested\", spy.calls)\n119|\t}\n120|}\n(more lines below)","final_result":true}}}
