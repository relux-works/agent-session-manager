{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c797","stream":{"kind":"session","id":"01a0c5d0-c246-7b92-beac-dc3b11390997"},"sequence":550,"recorded_at":1780531400001095,"record_type":"event","durability":"durable","causation_id":"aa3bb7a1-c12a-4660-a0d5-ffba7d41ef0c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"aa3bb7a1-c12a-4660-a0d5-ffba7d41ef0c","run_stream":{"kind":"run","id":"aa3bb7a1-c12a-4660-a0d5-ffba7d41ef0c"},"task_stream":{"kind":"task","id":"01a0c5d2-44d4-7212-b7bf-1da1bdfd0297"},"task_id":"01a0c5d2-44d4-7212-b7bf-1da1bdfd0297","event":{"kind":"output","task_id":"01a0c5d2-44d4-7212-b7bf-1da1bdfd0297","chunk":"Read text file `internal/tmuxserver/tmuxserver_test.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n12|)\n13|\n14|const (\n15|\tfixtureSession       = \"0198f4c8-7d40-7e55-8e6f-1234567890ab\"\n16|\tfixtureGeneration    = \"generation-7\"\n17|\tfixtureStaleGen      = \"generation-6\"\n18|\tfixtureBroker        = \"absent\"\n19|\tfixtureRemedy        = \"sign in to the GUI realm and retry\"\n20|\tfixtureDecoyCapacity = \"headless_creation\"\n21|)\n22|\n23|// realmAdmitted models a probe-reported landed admission holding the\n24|// credential realm row: in production the probe reports the\n25|// Reconcile/ResolveEvidence verdict, and tests model the report.\n26|func realmAdmitted() terminalbackend.Admitted {\n27|\treturn terminalbackend.Admitted{Capabilities: []string{\"credential_capable_execution_realm\"}}\n28|}\n29|\n30|// boundAdmission models a live admission bound to the request's typed\n31|// generation.\n32|func boundAdmission() RealmAdmission {\n33|\treturn RealmAdmission{Admitted: realmAdmitted(), RawGeneration: fixtureGeneration}\n34|}\n35|\n36|// staleAdmission models yesterday's live proof replayed today: the\n37|// row is admitted but bound to the previous generation.\n38|func staleAdmission() RealmAdmission {\n39|\treturn RealmAdmission{Admitted: realmAdmitted(), RawGeneration: fixtureStaleGen}\n40|}\n41|\n42|// brokerReport models a live broker report: a same-user principal\n43|// bound to the typed generation plus the bound server admission.\n44|func brokerReport() BrokerReport {\n45|\treturn BrokerReport{\n46|\t\tPrincipal: BrokerPrincipal{UID: currentUID(), Generation: fixtureGeneration},\n47|\t\tServer:    boundAdmission(),\n48|\t}\n49|}\n50|\n51|// foreignUID stages a broker principal the same-user arm must refuse\n52|// without privilege: the test identity shifted out of range.\n53|func foreignUID() uint32 { return currentUID() + 100000 }\n54|\n55|func validRequest(t *testing.T, root string) Request {\n56|\tt.Helper()\n57|\treturn Request{\n58|\t\tCaller:      CallerForeground,\n59|\t\tPlatform:    scalar.PlatformMacOS,\n60|\t\tRoot:        root,\n61|\t\tSessionID:   fixtureSession,\n62|\t\tGeneration:  fixtureGeneration,\n63|\t\tBrokerState: fixtureBroker,\n64|\t\tRemediation: fixtureRemedy,\n65|\t}\n66|}\n67|\n68|func hostileAmbient() Ambient {\n69|\treturn Ambient{\n70|\t\tTMUXEnv:          \"/tmp/tmux-501/default,12345,0\",\n71|\t\tTMUXTmpDir:       \"/tmp/operator-tmux\",\n72|\t\tInheritedSocket:  \"/tmp/inherited.sock\",\n73|\t\tDefaultPath:      \"/tmp/tmux-501/default\",\n74|\t\tConventionalName: \"default\",\n75|\t}\n76|}\n77|\n78|// requireLocalError pins the refusal the caller renders: the TOP-LEVEL\n79|// dynamic type must be *tmuxserver.Error, and no *axerror.Error wrapper\n80|// may be reachable. errors.As alone looks through the\n81|// capability_unavailable wrapper (axerror.Error.Unwrap returns the\n82|// cause, which is redacted off the wire by design), so a wrapped\n83|// custody refusal would satisfy a code/detail assertion while the\n84|// caller sees the typed unavailable. Every custody assertion goes\n85|// through this helper, so the wrapper direction of the absence split\n86|// is measured here, not in prose.\n87|func requireLocalError(t *testing.T, err error, code, detail string) {\n88|\tt.Helper()\n89|\tif err == nil {\n90|\t\tt.Fatalf(\"err = nil, want %s at %s\", code, detail)\n91|\t}\n92|\tlocal, ok := err.(*Error)\n93|\tif !ok {\n94|\t\tt.Fatalf(\"err top-level type = %T (%v), want *tmuxserver.Error\", err, err)\n95|\t}\n96|\tvar wrapped *axerror.Error\n97|\tif errors.As(err, &wrapped) {\n98|\t\tt.Fatalf(\"err wraps *axerror.Error (%v), want a bare *tmuxserver.Error\", err)\n99|\t}\n100|\tif local.Code != code || local.Detail != detail {\n101|\t\tt.Fatalf(\"err = %s at %s, want %s at %s\", local.Code, local.Detail, code, detail)\n102|\t}\n103|}\n104|\n105|func requireCapabilityUnavailable(t *testing.T, err error, caller, broker, generation, remedy string) {\n106|\tt.Helper()\n107|\tif err == nil {\n108|\t\tt.Fatal(\"err = nil, want capability_unavailable\")\n109|\t}\n110|\tvar failure *axerror.Error\n111|\tif !errors.As(err, &failure) {\n112|\t\tt.Fatalf(\"err type = %T (%v), want *axerror.Error\", err, err)\n113|\t}\n114|\tif string(failure.Code()) != \"capability_unavailable\" {\n115|\t\tt.Fatalf(\"code = %q, want %q\", string(failure.Code()), \"capability_unavailable\")\n116|\t}\n117|\tif failure.ExitCode() != 6 {\n118|\t\tt.Fatalf(\"exit = %d, want 6\", failure.ExitCode())\n119|\t}\n120|\twant := map[string]string{\n121|\t\t\"capability\":             \"credential_capable_execution_realm\",\n122|\t\t\"caller_realm\":           caller,\n123|\t\t\"broker_state\":           broker,\n124|\t\t\"tmux_server_generation\": generation,\n125|\t\t\"remediation\":            remedy,\n126|\t}\n127|\tfor key, value := range want {\n128|\t\tgot, ok := failure.Detail(key)\n129|\t\tif !ok {\n130|\t\t\tt.Fatalf(\"missing typed detail %q\", key)\n131|\t\t}\n132|\t\tif got != value {\n133|\t\t\tt.Fatalf(\"detail %q = %v, want %q\", key, got, value)\n134|\t\t}\n135|\t}\n136|}\n137|\n138|type spawnSpy struct {\n139|\tcalls  int\n140|\tsocket string\n141|\targv   []string\n142|\terr    error\n143|}\n144|\n145|func (spy *spawnSpy) spawn(socket string, argv []string) error {\n146|\tspy.calls++\n147|\tspy.socket = socket\n148|\tspy.argv = append([]string(nil), argv...)\n149|\treturn spy.err\n150|}\n151|\n152|// probeServerSpy is the background-path census for the foreground\n153|// probe dependency: the background path never probes the dedicated\n154|// server directly, so every background-path Acquire test arms this\n155|// spy and asserts zero calls. A fallback plant that re-enters the\n156|// foreground path trips this spy before it reaches the spawner.\n157|type probeServerSpy struct {\n158|\tcalls int\n159|}\n160|\n161|func (spy *probeServerSpy) probe(socket string) (ServerReport, error) {\n162|\tspy.calls++\n163|\treturn ServerReport{}, nil\n164|}\n165|\n166|func (spy *probeServerSpy) requireSilent(t *testing.T) {\n167|\tt.Helper()\n168|\tif spy.calls != 0 {\n169|\t\tt.Fatalf(\"server probe calls = %d, want 0 on the background path\", spy.calls)\n170|\t}\n171|}\n172|\n173|func runtimeRoot(t *testing.T) string {\n174|\tt.Helper()\n175|\troot := t.TempDir()\n176|\tif err := os.Chmod(root, 0o755); err != nil {\n177|\t\tt.Fatal(err)\n178|\t}\n179|\treturn root\n180|}\n181|\n182|func runtimeDir(t *testing.T, root string) string {\n183|\tt.Helper()\n184|\tdir, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n185|\tif err != nil {\n186|\t\tt.Fatal(err)\n187|\t}\n188|\treturn dir\n189|}\n190|\n191|// The derived path is the path the specification mandates: pinned\n192|// SPEC 806-807 selects the dedicated server by\n193|// `tmux -S <runtime>/tmux/ax.sock`. Both leaves are asserted as spec\n194|// literals plus the joined form, so a renamed constant reddens here.\n195|func TestSocketPathDerivesOnlyFromRuntimeDir(t *testing.T) {\n196|\tif RuntimeDirName != \"tmux\" {\n197|\t\tt.Fatalf(\"RuntimeDirName = %q, want the SPEC 806-808 leaf %q\", RuntimeDirName, \"tmux\")\n198|\t}\n199|\tif SocketName != \"ax.sock\" {\n200|\t\tt.Fatalf(\"SocketName = %q, want the SPEC 806-807 leaf %q\", SocketName, \"ax.sock\")\n201|\t}\n202|\troot := t.TempDir()\n203|\tdir := filepath.Join(root, RuntimeDirName)\n204|\tif got := SocketPath(dir); got != filepath.Join(root, \"tmux\", \"ax.sock\") {\n205|\t\tt.Fatalf(\"SocketPath = %q, want <root>/tmux/ax.sock\", got)\n206|\t}\n207|}","final_result":true}}}
