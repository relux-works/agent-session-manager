ainment\"}\\n\\t}\\n',\n547|        replace='\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\\n\\t}\\n',\n548|        count=1,\n549|        run=\"(TestVerifyRuntimeDirRefusesAbsence|TestAcquireBackgroundVerifiesWithoutCreating)\",\n550|        expect=\"KILLED\",\n551|        note=\"Admits exactly absent leaves past the absence detail (they report containment like an unsafe leaf); ENOTDIR/ELOOP and every other leaf failure still refuse containment. Narrowing, not a delete: the refusal stays, only the ENOENT arm is dropped. Kill paths: the Verify detail mismatch, and the background reroute to the custody code instead of the typed unavailable.\",\n552|    ),\n553|    Mutant(\n554|        name=\"N-background-absence-remap\",\n555|        path=f\"{PACKAGE}/acquire.go\",\n556|        find=\"\\tif runtimeAbsent(verr) {\\n\",\n557|        replace=\"\\tif runtimeAbsent(verr) && req.Platform != scalar.PlatformMacOS {\\n\",\n558|        count=1,\n559|        run=\"TestAcquireBackgroundVerifiesWithoutCreating\",\n560|        expect=\"KILLED\",\n561|        note=\"Admits exactly macOS absences past the unavailable remap (they return the custody code); absences on Linux/WSL2 still map. Kill path: the macOS background cold state reports tmux_unsafe_runtime_dir instead of capability_unavailable.\",\n562|    ),\n563|    Mutant(\n564|        name=\"N-absence-remap-widen\",\n565|        path=f\"{PACKAGE}/acquire.go\",\n566|        find='\\treturn local.Code == CodeUnsafeRuntimeDir && local.Detail == \"runtime absent\"\\n',\n567|        replace='\\treturn local.Code == CodeUnsafeRuntimeDir && (local.Detail == \"runtime absent\" || local.Detail == \"runtime mode\")\\n',\n568|        count=1,\n569|        run=\"TestAcquireBackgroundStagesVerifyCustodyRefusal\",\n570|        expect=\"KILLED\",\n571|        note=\"Admits exactly mode refusals past the absence classifier (a widened leaf maps to capability_unavailable with the custody refusal hidden as its redacted cause); absence still maps and every other unsafe-leaf refusal keeps its custody code. Kill path: the background custody test asserts the top-level *Error the caller renders.\",\n572|    ),\n573|    Mutant(\n574|        name=\"N-collision-tmuxenv-encoding\",\n575|        path=f\"{PACKAGE}/socket.go\",\n576|        find=\"\\tif i := strings.IndexByte(value, ','); i >= 0 {\\n\\t\\treturn value[:i]\\n\\t}\\n\",\n577|        replace=\"\\tif i := strings.IndexByte(value, ','); i >= 0 {\\n\\t\\treturn value\\n\\t}\\n\",\n578|        count=1,\n579|        run=\"(TestResolveSocketRefusesTMUXEnvRealEncoding|TestAcquireRefusesTMUXEnvCollisionRealEncoding)\",\n580|        expect=\"KILLED\",\n581|        note=\"Admits exactly TMUX values in the real <socket>,<pid>,<index> encoding past the socket-component arm; bare TMUX values still refuse byte-identical. Narrowing: the collision gate stays, only the component split is dropped.\",\n582|    ),\n583|    Mutant(\n584|        name=\"N-commit-eacces-as-exist\",\n585|        path=f\"{PACKAGE}/runtime_unix.go\",\n586|        find=\"\\tif !errors.Is(err, unix.EEXIST) {\\n\",\n587|        replace=\"\\tif !errors.Is(err, unix.EEXIST) && !errors.Is(err, unix.EACCES) {\\n\",\n588|        count=1,\n589|        run=\"TestEnsureRuntimeDirRefusesReadOnlyRoot\",\n590|        expect=\"KILLED\",\n591|        note=\"Admits exactly EACCES past the exists-check (a permission failure is treated as an existing leaf); every other mkdir failure still reports the commit detail. Kill reroutes to the runtime-absent refusal — still fail-closed, hence a detail mismatch, not an admission.\",\n592|    ),\n593|    Mutant(\n594|        name=\"N-override-whitespace\",\n595|        path=f\"{PACKAGE}/socket.go\",\n596|        find='\\tif override != \"\" {\\n',\n597|        replace='\\tif override != \"\" && override != \"  \" {\\n',\n598|        count=1,\n599|        run=f\"{RES_OVERRIDE}/whitespace_only\",\n600|        expect=\"KILLED\",\n601|        note=\"Admits exactly the two-space override past the non-empty arm; every other override still refuses. One site, both entries: kill paths are the Acquire whitespace subtests on both callers (the admitted request proceeds instead of refusing) and the direct ResolveSocket whitespace subtest.\",\n602|    ),\n603|    Mutant(\n604|        name=\"N-root-missing-classify\",\n605|        path=f\"{PACKAGE}/runtime_unix.go\",\n606|        find='func classifyRootOpenError(err error) error {\\n\\tif os.IsNotExist(err) || errors.Is(err, os.ErrNotExist) {\\n\\t\\treturn &Error{Code: CodeInvalidArguments, Detail: \"runtime root\"}\\n\\t}\\n\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\\n}\\n',\n607|        replace='func classifyRootOpenError(err error) error {\\n\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\\n}\\n',\n608|        count=1,\n609|        run=\"(TestEnsureRuntimeDirRefusesBadRoots|TestVerifyRuntimeDirRefusesMissingRoot|TestAcquireBackgroundMissingRootRefusesInvalid)\",\n610|        expect=\"KILLED\",\n611|        note=\"Admits exactly missing roots past the shared invalid-arguments mapping (they report containment); every other root-open failure still refuses containment. One site, three entries: killed by the missing-root tests on the commit, verify, and background-acquisition sides.\",\n612|    ),\n613|    Mutant(\n614|        name=\"N-broker-zero-admission\",\n615|        path=f\"{PACKAGE}/readiness.go\",\n616|        find='\\treturn CheckServerAttested(report.Server, wantGeneration)\\n',\n617|        replace='\\tif report.Server.RawGeneration == \"\" && !report.Server.Admitted.Has(realmCapability) {\\n\\t\\treturn nil\\n\\t}\\n\\treturn CheckServerAttested(report.Server, wantGeneration)\\n',\n618|        count=1,\n619|        run=f\"({BG_MISS}|TestCheckBrokerContactRefusesEachMissingFact)\",\n620|        expect=\"KILLED\",\n621|        note=\"Admits exactly the zero-admission server (no rows, no generation: the nothing-reconciled state) past the broker-side server wiring; admitted-without-generation, decoy-only, and every other server report still reach CheckServerAttested. Kill paths: the zero-admission subtests in the background miss table (entry) and the broker-contact table (helper).\",\n622|    ),\n623|    Mutant(\n624|        name=\"N-absence-remap-ownership\",\n625|        path=f\"{PACKAGE}/acquire.go\",\n626|        find='\\treturn local.Code == CodeUnsafeRuntimeDir && local.Detail == \"runtime absent\"\\n',\n627|        replace='\\treturn local.Code == CodeUnsafeRuntimeDir && (local.Detail == \"runtime absent\" || local.Detail == \"runtime ownership\")\\n',\n628|        count=1,\n629|        run=\"TestAcquireBackgroundStagesOwnershipRefusal\",\n630|        expect=\"KILLED\",\n631|        note=\"Admits exactly ownership refusals past the absence classifier (a foreign-owned leaf maps to capability_unavailable with the custody refusal hidden as its redacted cause); absence still maps and every other unsafe-leaf refusal keeps its custody code. Kill path: the background ownership test asserts the top-level *Error the caller renders.\",\n632|    ),\n633|    Mutant(\n634|        name=\"N-session-entry\",\n635|        path=f\"{PACKAGE}/acquire.go\",\n636|        find=\"\\tif _, err := scalar.ParseUUIDv7(req.SessionID); err != nil {\\n\",\n637|        replace='\\tif _, err := scalar.ParseUUIDv7(req.SessionID); err != nil && req.SessionID != \"12345\" {\\n',\n638|        count=1,\n639|        run=\"TestAcquireForegroundRefusesMalformedSession\",\n640|        expect=\"KILLED\",\n641|        note=\"Admits exactly the PID-form session past the foreground-entry session arm; every other malformed session still refuses there, and the spawn-site arm still refuses the admitted member with the same code. Kill path: the admitted request creates the directory and probes the server before the spawn-site refusal, tripping the test's no-directory/no-probe assertions.\",\n642|    ),\n643|    Mutant(\n644|        name=\"N-wiring-lexical\",\n645|        path=f\"{PACKAGE}/acquire.go\",\n646|        find='\\tdir, err := lexicalRuntimePath(req.Root, RuntimeDirName, req.Platform)\\n',\n647|        replace='\\tdir, err := lexicalRuntimePath(req.Root, \"ax-tmux\", req.Platform)\\n',\n648|        count=1,\n649|        run=\"TestAcquireOutcomeSocketEqualsSpecPath\",\n650|        expect=\"KILLED\",\n651|        note=\"Admits exactly the renamed leaf at the Acquire lexical site; the outcome socket becomes <root>/ax-tmux/ax.sock on both caller paths. Kill path: the entry-level spec-path test asserts the literal <root>/tmux/ax.sock.\",\n652|    ),\n653|    Mutant(\n654|        name=\"N-wiring-ensure\",\n655|        path=f\"{PACKAGE}/acquire.go\",\n656|        find='\\tensured, err := EnsureRuntimeDir(req.Root, RuntimeDirName, req.Platform, nil)\\n',\n657|        replace='\\tensured, err := EnsureRuntimeDir(req.Root, \"ax-tmux\", req.Platform, nil)\\n',\n658|        count=1,\n659|        run=\"TestAcquireOutcomeSocketEqualsSpecPath\",\n660|        expect=\"KILLED\",\n661|        note=\"Admits exactly the renamed leaf at the foreground ensure site: the entry creates <root>/ax-tmux while the socket names <root>/tmux/ax.sock. Kill path: the socket-equality arm in BuildArgv refuses the mismatched pair, failing the foreground leg of the spec-path test.\",\n662|    ),\n663|    Mutant(\n664|        name=\"N-wiring-verify\",\n665|        path=f\"{PACKAGE}/acquire.go\",\n666|        find='\\tverr := VerifyRuntimeDir(req.Root, RuntimeDirName, req.Platform)\\n',\n667|        replace='\\tverr := VerifyRuntimeDir(req.Root, \"ax-tmux\", req.Platform)\\n',\n668|        count=1,\n669|        run=\"TestAcquireOutcomeSocketEqualsSpecPath\",\n670|        expect=\"KILLED\",\n671|        note=\"Admits exactly the renamed leaf at the background verify site: the entry verifies <root>/ax-tmux (absent) while the socket names <root>/tmux/ax.sock. Kill path: the absent renamed leaf maps to the typed unavailable, failing the background leg of the spec-path test.\",\n672|    ),\n673|    Mutant(\n674|        name=\"N-details-generation\",\n675|        path=f\"{PACKAGE}/acquire.go\",\n676|        find='\\tif req.Generation == \"\" || req.BrokerState == \"\" || req.Remediation == \"\" {\\n',\n677|        replace='\\tif req.BrokerState == \"\" || req.Remediation == \"\" {\\n',\n678|        count=1,\n679|        run=\"TestAcquireRefusesMissingRealmDetails\",\n680|        expect=\"KILLED\",\n681|        note=\"Admits exactly generation-less requests past the typed-details arm; broker-less and remediation-less still refuse. Kill reroutes to the dependencies refusal.\",\n682|    ),\n683|    Mutant(\n684|        name=\"N-details-brokerstate\",\n685|        path=f\"{PACKAGE}/acquire.go\",\n686|        find='\\tif req.Generation == \"\" || req.BrokerState == \"\" || req.Remediation == \"\" {\\n',\n687|        replace='\\tif req.Generation == \"\" || req.Remediation == \"\" {\\n',\n688|        count=1,\n689|        run=\"TestAcquireRefusesMissingRealmDetails\",\n690|        expect=\"KILLED\",\n691|        note=\"Admits exactly broker-state-less requests past the typed-details arm; generation-less and remediation-less still refuse. Kill reroutes to the dependencies refusal.\",\n692|    ),\n693|    Mutant(\n694|        name=\"N-details-constructor\",\n695|        path=f\"{PACKAGE}/acquire.go\",\n696|        find=\"\\t\\taxerror.NoIDs(), details, cause)\\n\\tif err != nil {\\n\",\n697|        replace='\\t\\taxerror.NoIDs(), details, cause)\\n\\tif err != nil && req.Generation != \"gen\\\\xff\" {\\n',\n698|        count=1,\n699|        run=\"TestAcquireBackgroundInvalidGenerationRefusesAfterProbe\",\n700|        expect=\"KILLED\",\n701|        note=\"Admits exactly the invalid-UTF-8 generation past the refusal-renderer arm: the constructor failure is swallowed and the miss reports success with a zero outcome. Kill path: the detail test expects the invalid-arguments refusal and gets nil.\",\n702|    ),\n703|    Mutant(\n704|        name=\"N-absence-remap-containment\",\n705|        path=f\"{PACKAGE}/acquire.go\",\n706|        find='\\treturn local.Code == CodeUnsafeRuntimeDir && local.Detail == \"runtime absent\"\\n',\n707|        replace='\\treturn local.Code == CodeUnsafeRuntimeDir && (local.Detail == \"runtime absent\" || local.Detail == \"runtime containment\")\\n',\n708|        count=1,\n709|        run=\"TestAcquireBackgroundRefusesNonDirectoryLeaf\",\n710|        expect=\"KILLED\",\n711|        note=\"Admits exactly containment refusals past the absence classifier (a non-directory leaf maps to capability_unavailable with the custody refusal hidden as its redacted cause); absence still maps and every other unsafe-leaf refusal keeps its custody code. Kill path: the background non-directory test asserts the top-level *Error the caller renders.\",\n712|    ),\n713|    Mutant(\n714|        name=\"N-absence-remap-invalid\",\n715|        path=f\"{PACKAGE}/acquire.go\",\n716|        find='\\treturn local.Code == CodeUnsafeRuntimeDir && local.Detail == \"runtime absent\"\\n',\n717|        replace='\\treturn local.Code == CodeUnsafeRuntimeDir && local.Detail == \"runtime absent\" || local.Code == CodeInvalidArguments\\n',\n718|        count=1,\n719|        run=\"TestAcquireBackgroundMissingRootRefusesInvalid\",\n720|        expect=\"KILLED\",\n721|        note=\"Admits exactly malformed-input refusals past the absence classifier (a missing root maps to capability_unavailable instead of the invalid-arguments refusal the commit side reports); absence still maps and every custody refusal keeps its code. Kill path: the background missing-root test asserts the top-level invalid-arguments *Error the caller renders.\",\n722|    ),\n723|    Mutant(\n724|        name=\"N-root-symlink-commit\",\n725|        path=f\"{PACKAGE}/runtime_unix.go\",\n726|        find=\"\\trootHandle, err := secprim.OpenNoFollowDir(root)\\n\\tif err != nil {\\n\\t\\treturn classifyRootOpenError(err)\\n\\t}\\n\\tdefer func() { _ = rootHandle.Close() }()\\n\\tif !handleBoundToPath(rootHandle, root) {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\\trootFd := int(rootHandle.Fd())\\n\",\n727|        replace=\"\\trootHandle, err := secprim.OpenNoFollowDir(root)\\n\\tif err != nil {\\n\\t\\tif fi, lerr := os.Lstat(root); lerr == nil && fi.Mode()&os.ModeSymlink != 0 {\\n\\t\\t\\trootHandle, err = os.Open(root)\\n\\t\\t}\\n\\t\\tif err != nil {\\n\\t\\t\\treturn classifyRootOpenError(err)\\n\\t\\t}\\n\\t}\\n\\tdefer func() { _ = rootHandle.Close() }()\\n\\tif !handleBoundToPath(rootHandle, root) {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\\trootFd := int(rootHandle.Fd())\\n\",\n728|        count=1,\n729|        run=\"TestEnsureRuntimeDirRefusesSymlinkRoot\",\n730|        expect=\"KILLED\",\n731|        note=\"Admits exactly symlink roots past the commit-side no-follow open via a following fallback; missing, non-directory, and every other root-open failure still refuse through the shared classifier, and the verify side still refuses. Kill path: the entry commits the leaf inside the link target instead of refusing.\",\n732|    ),\n733|    Mutant(\n734|        name=\"N-root-symlink-verify\",\n735|        path=f\"{PACKAGE}/runtime_unix.go\",\n736|        find=\"\\trootHandle, err := secprim.OpenNoFollowDir(root)\\n\\tif err != nil {\\n\\t\\treturn classifyRootOpenError(err)\\n\\t}\\n\\tdefer func() { _ = rootHandle.Close() }()\\n\\tif !handleBoundToPath(rootHandle, root) {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\\tleafFd, err := unix.Openat(int(rootHandle.Fd()), name,\\n\",\n737|        replace=\"\\trootHandle, err := secprim.OpenNoFollowDir(root)\\n\\tif err != nil {\\n\\t\\tif fi, lerr := os.Lstat(root); lerr == nil && fi.Mode()&os.ModeSymlink != 0 {\\n\\t\\t\\trootHandle, err = os.Open(root)\\n\\t\\t}\\n\\t\\tif err != nil {\\n\\t\\t\\treturn classifyRootOpenError(err)\\n\\t\\t}\\n\\t}\\n\\tdefer func() { _ = rootHandle.Close() }()\\n\\tif !handleBoundToPath(rootHandle, root) {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\\tleafFd, err := unix.Openat(int(rootHandle.Fd()), name,\\n\",\n738|        count=1,\n739|        run=\"(TestVerifyRuntimeDirRefusesSymlinkRoot|TestAcquireBackgroundRefusesSymlinkRoot)\",\n740|        expect=\"KILLED\",\n741|        note=\"Admits exactly symlink roots past the verify-side no-follow open via a following fallback; every other root-open failure still refuses, and the commit side still refuses. One site, both entries: the direct verify test meets the absent detail inside the link target, and the background entry maps it to the typed unavailable instead of the containment refusal.\",\n742|    ),\n743|    Mutant(\n744|        name=\"N-argv-detached\",\n745|        path=f\"{PACKAGE}/argv.go\",\n746|        find='\\t\\t\"new-session\",\\n\\t\\t\"-d\",\\n',\n747|        replace='\\t\\t\"new-session\",\\n',\n748|        count=1,\n749|        run=\"(TestBuildArgvAddressesOnlyTheDerivedSocket|TestAcquireForegroundSpawnsDedicatedServer)\",\n750|        expect=\"KILLED\",\n751|        note=\"Admits exactly the attached spawn vector past the fixed-shape builder (the spawned server would try to attach the caller terminal); every other vector element stays exact. One site, both entries: the exact-vector assertions fail at the helper and through the foreground entry alike.\",\n752|    ),\n753|    Mutant(\n754|        name=\"N-argv-tail\",\n755|        path=f\"{PACKAGE}/argv.go\",\n756|        find='\\t\\t\"ax\", \"pane\", session.String(),\\n',\n757|        replace='\\t\\t\"ax\", \"attach\", session.String(),\\n',\n758|        count=1,\n759|        run=\"(TestBuildArgvAddressesOnlyTheDerivedSocket|TestAcquireForegroundSpawnsDedicatedServer)\",\n760|        expect=\"KILLED\",\n761|        note=\"Admits exactly the retargeted pane entrypoint past the fixed-shape builder; every other vector element stays exact. One site, both entries: the exact-vector assertions fail at the helper and through the foreground entry alike.\",\n762|    ),\n763|    Mutant(\n764|        name=\"N-dispatch-foreground\",\n765|        path=f\"{PACKAGE}/acquire.go\",\n766|        find=\"\\tif req.Caller == CallerBackground {\\n\\t\\treturn acquireBackground(req, socket)\\n\\t}\\n\",\n767|        replace=\"\\tif req.Caller == CallerBackground || req.Caller == CallerForeground {\\n\\t\\treturn acquireBackground(req, socket)\\n\\t}\\n\",\n768|        count=1,\n769|        run=\"TestAcquireForegroundSpawnsDedicatedServer\",\n770|        expect=\"KILLED\",\n771|        note=\"Admits exactly foreground callers to the background path; background callers still dispatch background. Kill path: the foreground spawn test refuses the background dependencies code instead of spawning.\",\n772|    ),\n773|    Mutant(\n774|        name=\"N-dispatch-background\",\n775|        path=f\"{PACKAGE}/acquire.go\",\n776|        find=\"\\tif req.Caller == CallerBackground {\\n\\t\\treturn acquireBackground(req, socket)\\n\\t}\\n\",\n777|        replace='\\tif req.Caller == \"Background\" {\\n\\t\\treturn acquireBackground(req, socket)\\n\\t}\\n',\n778|        count=1,\n779|        run=BG_MISS,\n780|        expect=\"KILLED\",\n781|        note=\"Admits exactly background callers to the foreground path (the capitalized twin still dispatches background); foreground callers are unaffected. Kill path: the background miss table spawns into the dedicated server instead of refusing the typed unavailable.\",\n782|    ),\n783|    Mutant(\n784|        name=\"D-background-fallback\",\n785|        path=f\"{PACKAGE}/acquire.go\",\n786|        find=\"\\t\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\n\\t\\t\\treturn Outcome{}, backgroundUnavailable(req, err)\\n\\t\\t}\\n\",\n787|        replace=\"\\t\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\n\\t\\t\\tif req.Deps.Spawn != nil {\\n\\t\\t\\t\\t_ = req.Deps.Spawn(socket, nil)\\n\\t\\t\\t}\\n\\t\\t\\treturn Outcome{}, backgroundUnavailable(req, err)\\n\\t\\t}\\n\",\n788|        count=1,\n789|        run=BG_MISS_LINUX,\n790|        expect=\"KILLED\",\n791|        note=\"SUPPLEMENTARY ADDITIVE, not a narrowing: plants the reviewer-shaped direct-creation call on the background miss path. Kill path: every background-miss spy asserts zero spawn calls.\",\n792|    ),\n793|    Mutant(\n794|        name=\"D-background-fallback-foreground\",\n795|        path=f\"{PACKAGE}/acquire.go\",\n796|        find=\"\\t\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\n\\t\\t\\treturn Outcome{}, backgroundUnavailable(req, err)\\n\\t\\t}\\n\",\n797|        replace=\"\\t\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\n\\t\\t\\tif req.Deps.ProbeServer != nil && req.Deps.Spawn != nil {\\n\\t\\t\\t\\treturn acquireForeground(req, socket)\\n\\t\\t\\t}\\n\\t\\t\\treturn Outcome{}, backgroundUnavailable(req, err)\\n\\t\\t}\\n\",\n798|        count=1,\n799|        run=BG_MISS_LINUX,\n800|        expect=\"KILLED\",\n801|        note=\"SUPPLEMENTARY ADDITIVE, not a narrowing: a fallback into acquireForeground on the background miss path, guarded on the foreground probe dependency — the shared-Dependencies shape, where the lifecycle adapter passes one Dependencies value to every caller. Kill path: every background-miss test arms both a spy spawner and a spy server probe and asserts the typed unavailable, so re-entering the foreground path trips the census before it spawns.\",\n802|    ),\n803|    Mutant(\n804|        name=\"C-control\",\n805|        path=f\"{PACKAGE}/errors.go\",\n806|        find=\"// Error is a package-local refusal. Code is one of the Code*\",\n807|        replace=\"// Error is a package-local refusal (harness control: comment-only). Code is one of the Code*\",\n808|        count=1,\n809|        run=\"TestSocketPathDerivesOnlyFromRuntimeDir\",\n810|        expect=\"SURVIVED\",\n811|        note=\"Harmless control: a comment-only edit that must SURVIVE, proving the harness observes outcomes.\",\n812|    ),\n813|]\n814|\n815|\n816|def apply(mutant: Mutant, original: str) -> str:\n817|    return original.replace(mutant.find, mutant.replace)\n818|\n819|\n820|def run_mutant(mutant: Mutant, log_dir: Path | None) -> str:\n821|    target = REPO / mutant.path\n822|    original = target.read_text()\n823|    found = original.count(mutant.find)\n824|    if found != mutant.count:\n825|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\"\n826|    with tempfile.TemporaryDirectory() as staging:\n827|        backup = Path(staging) / \"backup\"\n828|        shutil.copy2(target, backup)\n829|        try:\n830|            target.write_text(apply(mutant, original))\n831|            run = subprocess.run(\n832|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n833|                cwd=REPO,\n834|                capture_output=True,\n835|                text=True,\n836|                timeout=300,\n837|            )\n838|        finally:\n839|            shutil.copy2(backup, target)\n840|    output = (run.stdout + run.stderr).strip()\n841|    if os.environ.get(\"AX_MUTANT_VERBOSE\") == \"1\":\n842|        print(f\"--- raw: {mutant.name}: exit {run.returncode} ---\", flush=True)\n843|        print(output, flush=True)\n844|        print(f\"--- end raw: {mutant.name} ---\", flush=True)\n845|    if log_dir is not None:\n846|        (log_dir / f\"{mutant.name}.log\").write_text(\n847|            f\"exit: {run.returncode}\\nrun: go test ./{PACKAGE}/ -run {mutant.run} -count=1\\n\\n{output}\\n\"\n848|        )\n849|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n850|        return f\"ERROR: {mutant.name}: build broke under the patch\"\n851|    if run.returncode == 0:\n852|        verdict = \"SURVIVED\"\n853|    elif '--- FAIL' in output or 'FAIL:' in output:\n854|        verdict = \"KILLED\"\n855|    else:\n856|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\"\n857|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n858|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note} [exit {run.returncode}]\"\n859|\n860|\n861|def main(argv: list[str]) -> int:\n862|    log_dir: Path | None = None\n863|    names = list(argv)\n864|    if \"--log-dir\" in names:\n865|        idx = names.index(\"--log-dir\")\n866|        if idx + 1 >= len(names):\n867|            print(\"--log-dir needs a directory\")\n868|            return 2\n869|        log_dir = Path(names[idx + 1])\n870|        log_dir.mkdir(parents=True, exist_ok=True)\n871|        del names[idx : idx + 2]\n872|    selected = [m for m in MUTANTS if not names or m.name in names]\n873|    if names and len(selected) != len(names):\n874|        unknown = sorted(set(names) - {m.name for m in selected})\n875|        print(f\"unknown mutants: {', '.join(unknown)}\")\n876|        return 2\n877|    failures = 0\n878|    for mutant in selected:\n879|        try:\n880|            line = run_mutant(mutant, log_dir)\n881|        except subprocess.TimeoutExpired:\n882|            line = f\"ERROR: {mutant.name}: killer timed out\"\n883|        print(line, flush=True)\n884|        if not line.startswith(\"ok:\"):\n885|            failures += 1\n886|    return 1 if failures else 0\n887|\n888|\n889|if __name__ == \"__main__\":\n890|    sys.exit(main(sys.argv[1:]))","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
