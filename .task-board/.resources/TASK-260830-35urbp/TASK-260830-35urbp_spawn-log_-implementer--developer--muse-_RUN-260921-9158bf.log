{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c793","stream":{"kind":"session","id":"01a0c5d0-c246-7b92-beac-dc3b11390997"},"sequence":548,"recorded_at":1780531400001091,"record_type":"event","durability":"durable","causation_id":"aa3bb7a1-c12a-4660-a0d5-ffba7d41ef0c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"aa3bb7a1-c12a-4660-a0d5-ffba7d41ef0c","run_stream":{"kind":"run","id":"aa3bb7a1-c12a-4660-a0d5-ffba7d41ef0c"},"task_stream":{"kind":"task","id":"01a0c5d2-44b1-7601-9de9-7ffd280034d8"},"task_id":"01a0c5d2-44b1-7601-9de9-7ffd280034d8","event":{"kind":"output","task_id":"01a0c5d2-44b1-7601-9de9-7ffd280034d8","chunk":"Read text file `internal/tmuxserver/runtime_test.go`.\n(79 line(s) above)\n80|\t}\n81|}\n82|\n83|// \"Exactly 0700\" is pinned on the narrower side too: a pre-existing\n84|// owner-narrower leaf (0600/0500) refuses the mode gate on both\n85|// entries, never converging by silent repair. The mode is set by an\n86|// explicit chmod so the fixture is exact under any test umask.\n87|func TestEnsureRuntimeDirRefusesNarrowerMode(t *testing.T) {\n88|\tfor _, tc := range []struct {\n89|\t\tname string\n90|\t\tperm os.FileMode\n91|\t}{\n92|\t\t{\"0600\", 0o600},\n93|\t\t{\"0500\", 0o500},\n94|\t} {\n95|\t\tt.Run(tc.name, func(t *testing.T) {\n96|\t\t\troot := runtimeRoot(t)\n97|\t\t\tleaf := filepath.Join(root, RuntimeDirName)\n98|\t\t\tif err := os.Mkdir(leaf, 0o700); err != nil {\n99|\t\t\t\tt.Fatal(err)\n100|\t\t\t}\n101|\t\t\tif err := os.Chmod(leaf, tc.perm); err != nil {\n102|\t\t\t\tt.Fatal(err)\n103|\t\t\t}\n104|\t\t\t_, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n105|\t\t\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime mode\")\n106|\t\t\tif verr := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS); verr != nil {\n107|\t\t\t\trequireLocalError(t, verr, \"tmux_unsafe_runtime_dir\", \"runtime mode\")\n108|\t\t\t} else {\n109|\t\t\t\tt.Fatal(\"VerifyRuntimeDir admitted a narrower-than-0700 directory\")\n110|\t\t\t}\n111|\t\t})\n112|\t}\n113|}\n114|\n115|func TestEnsureRuntimeDirRefusesNonDirectoryLeaf(t *testing.T) {\n116|\troot := runtimeRoot(t)\n117|\tleaf := filepath.Join(root, RuntimeDirName)\n118|\tif err := os.WriteFile(leaf, []byte(\"x\"), 0o600); err != nil {\n119|\t\tt.Fatal(err)\n120|\t}\n121|\t_, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n122|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n123|}\n124|\n125|// The verify side refuses a non-directory leaf through the O_DIRECTORY\n126|// flag on its Openat — the same refusal the commit side pins, on the\n127|// entry the background path uses. The regular file carries 0700 so a\n128|// weakened open admits it outright instead of rerouting to the mode\n129|// gate; the FIFO runs under a deadline so the no-hang property is\n130|// pinned too. The verify open carries no O_NONBLOCK by decision: FIFO\n131|// refusal relies on O_DIRECTORY failing fast with ENOTDIR, symmetric\n132|// with the commit side (TRACEABILITY row 5).\n133|func TestVerifyRuntimeDirRefusesNonDirectoryLeaf(t *testing.T) {\n134|\tt.Run(\"regular file\", func(t *testing.T) {\n135|\t\troot := runtimeRoot(t)\n136|\t\tleaf := filepath.Join(root, RuntimeDirName)\n137|\t\tif err := os.WriteFile(leaf, []byte(\"x\"), 0o700); err != nil {\n138|\t\t\tt.Fatal(err)\n139|\t\t}\n140|\t\terr := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS)\n141|\t\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n142|\t})\n143|\tt.Run(\"fifo without blocking\", func(t *testing.T) {\n144|\t\troot := runtimeRoot(t)\n145|\t\tif err := syscall.Mkfifo(filepath.Join(root, RuntimeDirName), 0o600); err != nil {\n146|\t\t\tt.Fatal(err)\n147|\t\t}\n148|\t\terr := verifyWithDeadline(t, func() error {\n149|\t\t\treturn VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS)\n150|\t\t})\n151|\t\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n152|\t})\n153|}\n154|\n155|// verifyWithDeadline turns a blocked verify into a failure instead of\n156|// a stalled suite: with O_DIRECTORY the refusal arrives immediately,\n157|// and without it the FIFO open stalls past the deadline.\n158|func verifyWithDeadline(t *testing.T, fn func() error) error {\n159|\tt.Helper()\n160|\tdone := make(chan error, 1)\n161|\tgo func() { done <- fn() }()\n162|\tselect {\n163|\tcase err := <-done:\n164|\t\treturn err\n165|\tcase <-time.After(5 * time.Second):\n166|\t\tt.Fatalf(\"VerifyRuntimeDir BLOCKED for 5s on a FIFO leaf (O_DIRECTORY must fail fast)\")\n167|\t\treturn nil\n168|\t}\n169|}\n170|\n171|func TestEnsureRuntimeDirRefusesSymlinkLeaf(t *testing.T) {\n172|\troot := runtimeRoot(t)\n173|\tescape := t.TempDir()\n174|\tleaf := filepath.Join(root, RuntimeDirName)\n175|\tif err := os.Symlink(escape, leaf); err != nil {\n176|\t\tt.Fatal(err)\n177|\t}\n178|\t_, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n179|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n180|}\n181|\n182|func TestEnsureRuntimeDirRefusesForeignOwnership(t *testing.T) {\n183|\troot := runtimeRoot(t)\n184|\truntimeDir(t, root)\n185|\tprevious := effectiveUID\n186|\teffectiveUID = func() int { return previous() + 100000 }\n187|\tdefer func() { effectiveUID = previous }()\n188|\t_, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n189|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime ownership\")\n190|\tif err := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS); err != nil {\n191|\t\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime ownership\")\n192|\t} else {\n193|\t\tt.Fatal(\"VerifyRuntimeDir admitted foreign ownership\")\n194|\t}\n195|}\n196|\n197|func TestEnsureRuntimeDirRefusesHandleMismatch(t *testing.T) {\n198|\troot := runtimeRoot(t)\n199|\tprevious := sameDirectory\n(more lines below)","final_result":true}}}
