tate == \"\" || req.Remediation == \"\" {\n153|\t\treturn Outcome{}, &Error{Code: CodeInvalidArguments, Detail: \"realm details\"}\n154|\t}\n155|\tdir, err := lexicalRuntimePath(req.Root, RuntimeDirName, req.Platform)\n156|\tif err != nil {\n157|\t\treturn Outcome{}, err\n158|\t}\n159|\tsocket, err := ResolveSocket(dir, req.SocketOverride, req.Ambient)\n160|\tif err != nil {\n161|\t\treturn Outcome{}, err\n162|\t}\n163|\tif req.Caller == CallerBackground {\n164|\t\treturn acquireBackground(req, socket)\n165|\t}\n166|\treturn acquireForeground(req, socket)\n167|}\n168|\n169|// acquireBackground implements the broker-or-refuse rule: it may\n170|// contact the already-running authenticated broker and its attested\n171|// server, and when neither exists it returns capability_unavailable\n172|// with typed realm/readiness details. Direct server creation is not\n173|// the else branch — this function has no path to the spawner, on\n174|// any platform — and the runtime directory is verified, never\n175|// created here. A missing leaf is the ordinary cold state (the\n176|// Runtime IPC root is a per-user temporary directory), so absence\n177|// maps to the typed unavailable with no broker probe and no spawn;\n178|// a leaf that exists but fails custody keeps its custody code.\n179|func acquireBackground(req Request, socket string) (Outcome, error) {\n180|\tif req.Deps.ProbeBroker == nil {\n181|\t\treturn Outcome{}, &Error{Code: CodeInvalidArguments, Detail: \"dependencies\"}\n182|\t}\n183|\tverr := VerifyRuntimeDir(req.Root, RuntimeDirName, req.Platform)\n184|\tif runtimeAbsent(verr) {\n185|\t\treturn Outcome{}, backgroundUnavailable(req, verr)\n186|\t}\n187|\tif verr != nil {\n188|\t\treturn Outcome{}, verr\n189|\t}\n190|\tstatus, err := req.Deps.ProbeBroker()\n191|\tif err != nil {\n192|\t\treturn Outcome{}, err\n193|\t}\n194|\tif err := CheckBrokerContact(status, req.Generation, currentUID()); err != nil {\n195|\t\t// The miss path creates nothing: it consults the creation\n196|\t\t// gate so the no-fallback rule is enforced by a call, not\n197|\t\t// by the absence of one. The gate refuses every background\n198|\t\t// caller; its refusal is expected here and the path reports\n199|\t\t// the typed unavailable the spec names. The else branch is\n200|\t\t// reachable only when the gate is weakened to admit a\n201|\t\t// background caller, and then it refuses with the creation\n202|\t\t// code instead of the typed unavailable, so the committed\n203|\t\t// background-miss tests redden.\n204|\t\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\n205|\t\t\treturn Outcome{}, backgroundUnavailable(req, err)\n206|\t\t}\n207|\t\treturn Outcome{}, &Error{Code: CodeBackgroundCreationRefused, Detail: \"background fallback\"}\n208|\t}\n209|\treturn Outcome{Via: ViaBroker, Socket: socket}, nil\n210|}\n211|\n212|// acquireForeground attaches to the running attested dedicated\n213|// server or spawns it. A running but unattested server refuses:\n214|// acquisition never attaches to a server whose landed admission is\n215|// missing or bound to another generation, and never repairs it here\n216|// — lifecycle owns that decision. The session identity is validated\n217|// here, before the directory is ensured and the server probed, so a\n218|// malformed session refuses before any side effect; BuildArgv\n219|// re-validates at the spawn site, and each side carries its own\n220|// narrowing row.\n221|func acquireForeground(req Request, socket string) (Outcome, error) {\n222|\tif req.Deps.ProbeServer == nil || req.Deps.Spawn == nil {\n223|\t\treturn Outcome{}, &Error{Code: CodeInvalidArguments, Detail: \"dependencies\"}\n224|\t}\n225|\tif _, err := scalar.ParseUUIDv7(req.SessionID); err != nil {\n226|\t\treturn Outcome{}, &Error{Code: CodeInvalidArguments, Detail: \"session identity\"}\n227|\t}\n228|\tensured, err := EnsureRuntimeDir(req.Root, RuntimeDirName, req.Platform, nil)\n229|\tif err != nil {\n230|\t\treturn Outcome{}, err\n231|\t}\n232|\treport, err := req.Deps.ProbeServer(socket)\n233|\tif err != nil {\n234|\t\treturn Outcome{}, err\n235|\t}\n236|\tif report.Running {\n237|\t\tif err := CheckServerAttested(report.Admission, req.Generation); err != nil {\n238|\t\t\treturn Outcome{}, err\n239|\t\t}\n240|\t\treturn Outcome{Via: ViaAttached, Socket: socket}, nil\n241|\t}\n242|\targv, err := BuildArgv(ensured, socket, req.SessionID)\n243|\tif err != nil {\n244|\t\treturn Outcome{}, err\n245|\t}\n246|\tif err := req.Deps.Spawn(socket, argv); err != nil {\n247|\t\treturn Outcome{}, &Error{Code: CodeSpawnFailed, Detail: \"server spawn\"}\n248|\t}\n249|\treturn Outcome{Via: ViaSpawned, Socket: socket, Argv: argv}, nil\n250|}\n251|\n252|// runtimeAbsent reports whether err is the verify-side absent-leaf\n253|// refusal. Only the missing leaf counts — never a missing root, a\n254|// mode, ownership, kind, or symlink refusal: absence is the\n255|// readiness fact the background path maps to\n256|// capability_unavailable, while every unsafe-leaf refusal keeps its\n257|// custody code. A nil error is not absence.\n258|func runtimeAbsent(err error) bool {\n259|\tvar local *Error\n260|\tif !errors.As(err, &local) {\n261|\t\treturn false\n262|\t}\n263|\treturn local.Code == CodeUnsafeRuntimeDir && local.Detail == \"runtime absent\"\n264|}\n265|\n266|// checkCreationAllowed is the single choke point before every\n267|// direct server creation. A background caller never creates: on\n268|// macOS because server creation is credential-sensitive, and on\n269|// every platform because the background path must not fall back to\n270|// direct creation. The macOS credential-dependent case is one\n271|// fixture of this gate, not a narrower arm: narrowing the gate to\n272|// macOS or to credential-dependent servers would admit background\n273|// creation the no-fallback rule forbids. Foreground creation is\n274|// allowed on every platform; the credential binding it needs is\n275|// proven by the landed admission the server must present before\n276|// any attach.\n277|func checkCreationAllowed(caller Caller) error {\n278|\tif caller == CallerBackground {\n279|\t\treturn &Error{Code: CodeBackgroundCreationRefused, Detail: \"background creation\"}\n280|\t}\n281|\treturn nil\n282|}\n283|\n284|// backgroundUnavailable composes the typed capability_unavailable\n285|// refusal the spec names for the background miss, with the exact\n286|// Section 15.3 detail set. The constructor enforces the typed\n287|// details; a failure to render them is itself malformed input, not\n288|// an untyped refusal.\n289|func backgroundUnavailable(req Request, cause error) error {\n290|\tdetails := axerror.RealmEvidence{\n291|\t\tCapability:           realmCapability,\n292|\t\tCallerRealm:          req.Caller,\n293|\t\tBrokerState:          req.BrokerState,\n294|\t\tTmuxServerGeneration: req.Generation,\n295|\t\tRemediation:          req.Remediation,\n296|\t}\n297|\tfailure, err := axerror.NewRealmEvidenceUnavailable(axerror.Version130,\n298|\t\t\"no authenticated broker or attested tmux server\",\n299|\t\taxerror.NoIDs(), details, cause)\n300|\tif err != nil {\n301|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"realm details\"}\n302|\t}\n303|\treturn failure\n304|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c847","stream":{"kind":"session","id":"01a0c5d0-c246-7b92-beac-dc3b11390997"},"sequence":638,"recorded_at":1780531400001271,"record_type":"event","durability":"durable","causation_id":"aa3bb7a1-c12a-4660-a0d5-ffba7d41ef0c","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"aa3bb7a1-c12a-4660-a0d5-ffba7d41ef0c","run_stream":{"kind":"run","id":"aa3bb7a1-c12a-4660-a0d5-ffba7d41ef0c"},"call_id":"call_01a0c5d266ee7484b89b28aa6c13a03b","text":"Read text file `internal/tmuxserver/readiness.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n5|)\n6|\n7|// RealmAdmission is the landed admission verdict over the exact tmux\n8|// server: the Reconcile/ResolveEvidence Admitted set plus the AX-known\n9|// raw generation the admission binds to. Production probes report this\n10|// verdict; tests model probe reports. This leaf never re-decides what\n11|// the admission already proves — signature verification, liveness,\n12|// expiry, and the sentinel/smoke requirement coverage are the landed\n13|// terminalbackend owner's verdict, consumed here through Has — and\n14|// composes it only with the generation equality the wrapper owner\n15|// (internal/axpane checkRealm) already enforces: the admission's raw\n16|// generation must equal the request's typed generation, or the proof\n17|// is stale and refuses.\n18|//\n19|// There is deliberately no member for a cached sentinel result, a\n20|// managername observation, or any attested-server boolean: none\n21|// authorizes, so none is an input. A cached observation replayed as a\n22|// live one is exactly a stale-generation admission, and it refuses on\n23|// the generation arm.\n24|type RealmAdmission struct {\n25|\t// Admitted is the landed admission verdict.\n26|\tAdmitted terminalbackend.Admitted\n27|\t// RawGeneration is the AX-known raw generation the admission\n28|\t// binds to.\n29|\tRawGeneration string\n30|}\n31|\n32|// CheckServerAttested admits exactly an attested dedicated server:\n33|// the landed admission holds the credential_capable_execution_realm\n34|// row AND the admission's raw generation equals the request's typed\n35|// generation. Each arm refuses alone: a missing row refuses even with\n36|// a bound generation, and a wrong generation refuses even with an\n37|// admitted row, so weakening either arm admits a server the committed\n38|// tests pin.\n39|func CheckServerAttested(admission RealmAdmission, wantGeneration string) error {\n40|\tif !admission.Admitted.Has(realmCapability) {\n41|\t\treturn &Error{Code: CodeReadinessNotAuthorizing, Detail: \"server attestation\"}\n42|\t}\n43|\tif wantGeneration == \"\" || admission.RawGeneration != wantGeneration {\n44|\t\treturn &Error{Code: CodeReadinessNotAuthorizing, Detail: \"server generation\"}\n45|\t}\n46|\treturn nil\n47|}\n48|\n49|// BrokerPrincipal is the authenticated Aqua broker identity the\n50|// background path decides over. Per Section 4.4 the broker exposes\n51|// only authenticated, same-user, generation-bound terminal readiness,\n52|// so the principal carries the authenticated UID and the generation\n53|// its readiness binds to as typed, bound facts — never a bare\n54|// boolean. The UID is compared against the process identity, and the\n55|// generation against the request's typed generation.\n56|type BrokerPrincipal struct {\n57|\t// UID is the broker's authenticated user identity.\n58|\tUID uint32\n59|\t// Generation is the generation the broker readiness binds to.\n60|\tGeneration string\n61|}\n62|\n63|// BrokerReport is the live Aqua broker report the background path\n64|// decides over: the authenticated principal plus the attested AX tmux\n65|// server admission. Either fact missing means neither exists for the\n66|// purpose of the broker-or-refuse rule.\n67|type BrokerReport struct {\n68|\tPrincipal BrokerPrincipal\n69|\tServer    RealmAdmission\n70|}\n71|\n72|// CheckBrokerContact admits exactly the background MAY case: a\n73|// same-user authenticated broker principal AND a generation-bound\n74|// principal AND the attested AX tmux server admission bound to the\n75|// same typed generation. Every other report — a foreign-user broker,\n76|// an unbound principal, an unattested server, a stale admission —\n77|// refuses, and the caller maps the refusal to the typed\n78|// capability_unavailable the spec names.\n79|func CheckBrokerContact(report BrokerReport, wantGeneration string, currentUID uint32) error {\n80|\tif report.Principal.UID != currentUID {\n81|\t\treturn &Error{Code: CodeReadinessNotAuthorizing, Detail: \"broker authentication\"}\n82|\t}\n83|\tif report.Principal.Generation == \"\" || report.Principal.Generation != wantGeneration {\n84|\t\treturn &Error{Code: CodeReadinessNotAuthorizing, Detail: \"broker generation\"}\n85|\t}\n86|\treturn CheckServerAttested(report.Server, wantGeneration)\n87|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
