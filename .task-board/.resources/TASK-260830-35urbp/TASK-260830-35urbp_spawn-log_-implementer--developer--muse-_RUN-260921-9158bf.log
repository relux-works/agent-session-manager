f socket != SocketPath(runtimeDir) {\\n\",\n467|        replace='\\tif socket != SocketPath(runtimeDir) && socket != \"/tmp/tmux-501/default\" {\\n',\n468|        count=1,\n469|        run=\"TestBuildArgvRefusesAmbientSocket\",\n470|        expect=\"KILLED\",\n471|        note=\"Admits exactly the default path at the spawn-socket arm; every other ambient socket still refuses.\",\n472|    ),\n473|    Mutant(\n474|        name=\"N-argv-tmuxenv\",\n475|        path=f\"{PACKAGE}/argv.go\",\n476|        find=\"\\tif socket != SocketPath(runtimeDir) {\\n\",\n477|        replace='\\tif socket != SocketPath(runtimeDir) && socket != \"/tmp/tmux-501/default,12345,0\" {\\n',\n478|        count=1,\n479|        run=\"TestBuildArgvRefusesAmbientSocket/tmux_env_value\",\n480|        expect=\"KILLED\",\n481|        note=\"Admits exactly the TMUX environment value at the spawn-socket arm; every other ambient socket still refuses.\",\n482|    ),\n483|    Mutant(\n484|        name=\"N-argv-shape\",\n485|        path=f\"{PACKAGE}/argv.go\",\n486|        find=\"\\tif err := secprim.CheckArgv(argv); err != nil {\\n\",\n487|        replace='\\tif err := secprim.CheckArgv(argv); err != nil && argv[0] != \"tmux\" {\\n',\n488|        count=1,\n489|        run=\"TestBuildArgvRefusesInvalidArgvShape\",\n490|        expect=\"KILLED\",\n491|        note=\"Admits exactly our tmux-headed spawn vector past the landed shape wiring; any other vector still refuses. Other failing shapes are unstageable through the fixed-shape builder and are disclosed, not pinned.\",\n492|    ),\n493|    Mutant(\n494|        name=\"N-argv-session\",\n495|        path=f\"{PACKAGE}/argv.go\",\n496|        find=\"\\tsession, err := scalar.ParseUUIDv7(sessionID)\\n\\tif err != nil {\\n\",\n497|        replace='\\tsession, err := scalar.ParseUUIDv7(sessionID)\\n\\tif err != nil && sessionID != \"12345\" {\\n',\n498|        count=1,\n499|        run=\"(TestBuildArgvRefusesMalformedSession|TestAcquireForegroundRefusesMalformedSession)\",\n500|        expect=\"KILLED\",\n(more lines below)","final_result":true}}}
