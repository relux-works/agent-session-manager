tach\", session.String(),\\n',\n758|        count=1,\n759|        run=\"(TestBuildArgvAddressesOnlyTheDerivedSocket|TestAcquireForegroundSpawnsDedicatedServer)\",\n760|        expect=\"KILLED\",\n761|        note=\"Admits exactly the retargeted pane entrypoint past the fixed-shape builder; every other vector element stays exact. One site, both entries: the exact-vector assertions fail at the helper and through the foreground entry alike.\",\n762|    ),\n763|    Mutant(\n764|        name=\"N-dispatch-foreground\",\n765|        path=f\"{PACKAGE}/acquire.go\",\n766|        find=\"\\tif req.Caller == CallerBackground {\\n\\t\\treturn acquireBackground(req, socket)\\n\\t}\\n\",\n767|        replace=\"\\tif req.Caller == CallerBackground || req.Caller == CallerForeground {\\n\\t\\treturn acquireBackground(req, socket)\\n\\t}\\n\",\n768|        count=1,\n769|        run=\"TestAcquireForegroundSpawnsDedicatedServer\",\n770|        expect=\"KILLED\",\n771|        note=\"Admits exactly foreground callers to the background path; background callers still dispatch background. Kill path: the foreground spawn test refuses the background dependencies code instead of spawning.\",\n772|    ),\n773|    Mutant(\n774|        name=\"N-dispatch-background\",\n775|        path=f\"{PACKAGE}/acquire.go\",\n776|        find=\"\\tif req.Caller == CallerBackground {\\n\\t\\treturn acquireBackground(req, socket)\\n\\t}\\n\",\n777|        replace='\\tif req.Caller == \"Background\" {\\n\\t\\treturn acquireBackground(req, socket)\\n\\t}\\n',\n778|        count=1,\n779|        run=BG_MISS,\n780|        expect=\"KILLED\",\n781|        note=\"Admits exactly background callers to the foreground path (the capitalized twin still dispatches background); foreground callers are unaffected. Kill path: the background miss table spawns into the dedicated server instead of refusing the typed unavailable.\",\n782|    ),\n783|    Mutant(\n784|        name=\"D-background-fallback\",\n785|        path=f\"{PACKAGE}/acquire.go\",\n786|        find=\"\\t\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\n\\t\\t\\treturn Outcome{}, backgroundUnavailable(req, err)\\n\\t\\t}\\n\",\n787|        replace=\"\\t\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\n\\t\\t\\tif req.Deps.Spawn != nil {\\n\\t\\t\\t\\t_ = req.Deps.Spawn(socket, nil)\\n\\t\\t\\t}\\n\\t\\t\\treturn Outcome{}, backgroundUnavailable(req, err)\\n\\t\\t}\\n\",\n788|        count=1,\n789|        run=BG_MISS_LINUX,\n790|        expect=\"KILLED\",\n791|        note=\"SUPPLEMENTARY ADDITIVE, not a narrowing: plants the reviewer-shaped direct-creation call on the background miss path. Kill path: every background-miss spy asserts zero spawn calls.\",\n792|    ),\n793|    Mutant(\n794|        name=\"D-background-fallback-foreground\",\n795|        path=f\"{PACKAGE}/acquire.go\",\n796|        find=\"\\t\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\n\\t\\t\\treturn Outcome{}, backgroundUnavailable(req, err)\\n\\t\\t}\\n\",\n797|        replace=\"\\t\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\n\\t\\t\\tif req.Deps.ProbeServer != nil && req.Deps.Spawn != nil {\\n\\t\\t\\t\\treturn acquireForeground(req, socket)\\n\\t\\t\\t}\\n\\t\\t\\treturn Outcome{}, backgroundUnavailable(req, err)\\n\\t\\t}\\n\",\n798|        count=1,\n799|        run=BG_MISS_LINUX,\n800|        expect=\"KILLED\",\n801|        note=\"SUPPLEMENTARY ADDITIVE, not a narrowing: a fallback into acquireForeground on the background miss path, guarded on the foreground probe dependency — the shared-Dependencies shape, where the lifecycle adapter passes one Dependencies value to every caller. Kill path: every background-miss test arms both a spy spawner and a spy server probe and asserts the typed unavailable, so re-entering the foreground path trips the census before it spawns.\",\n802|    ),\n803|    Mutant(\n804|        name=\"C-control\",\n805|        path=f\"{PACKAGE}/errors.go\",\n806|        find=\"// Error is a package-local refusal. Code is one of the Code*\",\n807|        replace=\"// Error is a package-local refusal (harness control: comment-only). Code is one of the Code*\",\n808|        count=1,\n809|        run=\"TestSocketPathDerivesOnlyFromRuntimeDir\",\n810|        expect=\"SURVIVED\",\n811|        note=\"Harmless control: a comment-only edit that must SURVIVE, proving the harness observes outcomes.\",\n812|    ),\n813|]\n814|\n815|\n816|def apply(mutant: Mutant, original: str) -> str:\n817|    return original.replace(mutant.find, mutant.replace)\n818|\n819|\n820|def run_mutant(mutant: Mutant, log_dir: Path | None) -> str:\n821|    target = REPO / mutant.path\n822|    original = target.read_text()\n823|    found = original.count(mutant.find)\n824|    if found != mutant.count:\n825|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\"\n826|    with tempfile.TemporaryDirectory() as staging:\n827|        backup = Path(staging) / \"backup\"\n828|        shutil.copy2(target, backup)\n829|        try:\n830|            target.write_text(apply(mutant, original))\n831|            run = subprocess.run(\n832|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n833|                cwd=REPO,\n834|                capture_output=True,\n835|                text=True,\n836|                timeout=300,\n837|            )\n838|        finally:\n839|            shutil.copy2(backup, target)\n840|    output = (run.stdout + run.stderr).strip()\n841|    if os.environ.get(\"AX_MUTANT_VERBOSE\") == \"1\":\n842|        print(f\"--- raw: {mutant.name}: exit {run.returncode} ---\", flush=True)\n843|        print(output, flush=True)\n844|        print(f\"--- end raw: {mutant.name} ---\", flush=True)\n845|    if log_dir is not None:\n846|        (log_dir / f\"{mutant.name}.log\").write_text(\n847|            f\"exit: {run.returncode}\\nrun: go test ./{PACKAGE}/ -run {mutant.run} -count=1\\n\\n{output}\\n\"\n848|        )\n849|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n850|        return f\"ERROR: {mutant.name}: build broke under the patch\"\n851|    if run.returncode == 0:\n852|        verdict = \"SURVIVED\"\n853|    elif '--- FAIL' in output or 'FAIL:' in output:\n854|        verdict = \"KILLED\"\n855|    else:\n856|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\"\n857|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n858|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note} [exit {run.returncode}]\"\n859|\n860|\n861|def main(argv: list[str]) -> int:\n862|    log_dir: Path | None = None\n863|    names = list(argv)\n864|    if \"--log-dir\" in names:\n865|        idx = names.index(\"--log-dir\")\n866|        if idx + 1 >= len(names):\n867|            print(\"--log-dir needs a directory\")\n868|            return 2\n869|        log_dir = Path(names[idx + 1])\n870|        log_dir.mkdir(parents=True, exist_ok=True)\n871|        del names[idx : idx + 2]\n872|    selected = [m for m in MUTANTS if not names or m.name in names]\n873|    if names and len(selected) != len(names):\n874|        unknown = sorted(set(names) - {m.name for m in selected})\n875|        print(f\"unknown mutants: {', '.join(unknown)}\")\n876|        return 2\n877|    failures = 0\n878|    for mutant in selected:\n879|        try:\n880|            line = run_mutant(mutant, log_dir)\n881|        except subprocess.TimeoutExpired:\n882|            line = f\"ERROR: {mutant.name}: killer timed out\"\n883|        print(line, flush=True)\n884|        if not line.startswith(\"ok:\"):\n885|            failures += 1\n886|    return 1 if failures else 0\n887|\n888|\n889|if __name__ == \"__main__\":\n890|    sys.exit(main(sys.argv[1:]))","final_result":true}}}
