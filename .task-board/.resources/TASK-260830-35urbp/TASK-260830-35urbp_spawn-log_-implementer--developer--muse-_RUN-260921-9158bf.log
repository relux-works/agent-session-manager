{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7d3","stream":{"kind":"session","id":"01a0c5d0-c246-7b92-beac-dc3b11390997"},"sequence":580,"recorded_at":1780531400001155,"record_type":"event","durability":"durable","causation_id":"aa3bb7a1-c12a-4660-a0d5-ffba7d41ef0c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"aa3bb7a1-c12a-4660-a0d5-ffba7d41ef0c","run_stream":{"kind":"run","id":"aa3bb7a1-c12a-4660-a0d5-ffba7d41ef0c"},"task_stream":{"kind":"task","id":"01a0c5d2-513f-7d51-816c-81059014bcb2"},"task_id":"01a0c5d2-513f-7d51-816c-81059014bcb2","event":{"kind":"output","task_id":"01a0c5d2-513f-7d51-816c-81059014bcb2","chunk":"Read text file `internal/tmuxserver/readiness_test.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"testing\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n7|)\n8|\n9|func TestCheckServerAttestedAdmitsBound(t *testing.T) {\n10|\tif err := CheckServerAttested(boundAdmission(), fixtureGeneration); err != nil {\n11|\t\tt.Fatal(err)\n12|\t}\n13|}\n14|\n15|func TestCheckServerAttestedRefusesEachMissingConjunct(t *testing.T) {\n16|\tfor _, tc := range []struct {\n17|\t\tname      string\n18|\t\tadmission RealmAdmission\n19|\t\twant      string\n20|\t\tdetail    string\n21|\t}{\n22|\t\t{\"no admission rows\", RealmAdmission{RawGeneration: fixtureGeneration}, fixtureGeneration, \"server attestation\"},\n23|\t\t{\"decoy capability only\", RealmAdmission{\n24|\t\t\tAdmitted:      terminalbackend.Admitted{Capabilities: []string{fixtureDecoyCapacity}},\n25|\t\t\tRawGeneration: fixtureGeneration,\n26|\t\t}, fixtureGeneration, \"server attestation\"},\n27|\t\t{\"stale generation admission\", staleAdmission(), fixtureGeneration, \"server generation\"},\n28|\t\t{\"empty raw generation\", RealmAdmission{Admitted: realmAdmitted()}, fixtureGeneration, \"server generation\"},\n29|\t\t{\"empty wanted generation\", boundAdmission(), \"\", \"server generation\"},\n30|\t\t{\"both generations empty\", RealmAdmission{Admitted: realmAdmitted()}, \"\", \"server generation\"},\n31|\t} {\n32|\t\tt.Run(tc.name, func(t *testing.T) {\n33|\t\t\trequireLocalError(t, CheckServerAttested(tc.admission, tc.want), \"tmux_readiness_not_authorizing\", tc.detail)\n34|\t\t})\n35|\t}\n36|}\n37|\n38|func TestCheckBrokerContactAdmitsLiveReport(t *testing.T) {\n39|\tif err := CheckBrokerContact(brokerReport(), fixtureGeneration, currentUID()); err != nil {\n40|\t\tt.Fatal(err)\n41|\t}\n42|}\n43|\n44|func TestCheckBrokerContactRefusesEachMissingFact(t *testing.T) {\n45|\tlive := brokerReport()\n46|\tfor _, tc := range []struct {\n47|\t\tname   string\n48|\t\treport BrokerReport\n49|\t\twant   string\n50|\t\tdetail string\n51|\t}{\n52|\t\t{\"no broker\", BrokerReport{}, fixtureGeneration, \"broker authentication\"},\n53|\t\t{\"foreign-user broker\", BrokerReport{\n54|\t\t\tPrincipal: BrokerPrincipal{UID: foreignUID(), Generation: fixtureGeneration},\n55|\t\t\tServer:    boundAdmission(),\n56|\t\t}, fixtureGeneration, \"broker authentication\"},\n57|\t\t{\"generation-unbound principal\", BrokerReport{\n58|\t\t\tPrincipal: BrokerPrincipal{UID: live.Principal.UID, Generation: fixtureStaleGen},\n59|\t\t\tServer:    boundAdmission(),\n60|\t\t}, fixtureGeneration, \"broker generation\"},\n61|\t\t{\"empty principal generation\", BrokerReport{\n62|\t\t\tPrincipal: BrokerPrincipal{UID: live.Principal.UID},\n63|\t\t\tServer:    boundAdmission(),\n64|\t\t}, fixtureGeneration, \"broker generation\"},\n65|\t\t{\"both generations empty\", BrokerReport{\n66|\t\t\tPrincipal: BrokerPrincipal{UID: live.Principal.UID},\n67|\t\t\tServer:    RealmAdmission{Admitted: realmAdmitted()},\n68|\t\t}, \"\", \"broker generation\"},\n69|\t\t{\"unattested server\", BrokerReport{\n70|\t\t\tPrincipal: live.Principal,\n71|\t\t\tServer:    RealmAdmission{RawGeneration: fixtureGeneration},\n72|\t\t}, fixtureGeneration, \"server attestation\"},\n73|\t\t{\"stale server admission\", BrokerReport{\n74|\t\t\tPrincipal: live.Principal,\n75|\t\t\tServer:    staleAdmission(),\n76|\t\t}, fixtureGeneration, \"server generation\"},\n77|\t\t{\"zero server admission\", BrokerReport{\n78|\t\t\tPrincipal: live.Principal,\n79|\t\t\tServer:    RealmAdmission{},\n80|\t\t}, fixtureGeneration, \"server attestation\"},\n81|\t\t{\"admitted server without generation\", BrokerReport{\n82|\t\t\tPrincipal: live.Principal,\n83|\t\t\tServer:    RealmAdmission{Admitted: realmAdmitted()},\n84|\t\t}, fixtureGeneration, \"server generation\"},\n85|\t\t{\"decoy-only server admission\", BrokerReport{\n86|\t\t\tPrincipal: live.Principal,\n87|\t\t\tServer: RealmAdmission{\n88|\t\t\t\tAdmitted:      terminalbackend.Admitted{Capabilities: []string{fixtureDecoyCapacity}},\n89|\t\t\t\tRawGeneration: fixtureGeneration,\n90|\t\t\t},\n91|\t\t}, fixtureGeneration, \"server attestation\"},\n92|\t} {\n93|\t\tt.Run(tc.name, func(t *testing.T) {\n94|\t\t\trequireLocalError(t, CheckBrokerContact(tc.report, tc.want, currentUID()), \"tmux_readiness_not_authorizing\", tc.detail)\n95|\t\t})\n96|\t}\n97|}","final_result":true}}}
