{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb23","stream":{"kind":"session","id":"01a0c5d0-c246-7b92-beac-dc3b11390997"},"sequence":1004,"recorded_at":1780531400002003,"record_type":"event","durability":"durable","causation_id":"aa3bb7a1-c12a-4660-a0d5-ffba7d41ef0c","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"aa3bb7a1-c12a-4660-a0d5-ffba7d41ef0c","run_stream":{"kind":"run","id":"aa3bb7a1-c12a-4660-a0d5-ffba7d41ef0c"},"call_id":"call_01a0c5d580e974eaa096e44553ba5a49","text":"Read text file `internal/tmuxserver/runtime.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"os\"\n5|\t\"strings\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n9|)\n10|\n11|// RuntimeDirName is the fixed leaf name of the AX tmux runtime\n12|// directory under the Runtime IPC root: pinned SPEC 806-808 selects\n13|// the dedicated server by `tmux -S <runtime>/tmux/ax.sock`, so the\n14|// leaf is `tmux`. It is AX-controlled vocabulary, never an ambient\n15|// or conventional tmux name.\n16|const RuntimeDirName = \"tmux\"\n17|\n18|// Hooks arms the crash boundaries of EnsureRuntimeDir. AfterMkdir\n19|// runs after the mkdir attempt resolves — the leaf created or\n20|// already present — and before verification and the parent fsync; a\n21|// crash there must leave a retry that converges to the one verified\n22|// directory. Hooks is nil in production.\n23|type Hooks struct {\n24|\tAfterMkdir func(dir string)\n25|}\n26|\n27|// EnsureRuntimeDir creates the owner-only runtime directory\n28|// root/name when absent and verifies it when present, returning the\n29|// joined path. Creation and verification enforce three independent\n30|// gates — containment, mode, ownership — and each refuses alone:\n31|//\n32|//   - containment: the root must be an absolute path on the platform\n33|//     grammar, the name must be one relative segment, and the commit\n34|//     opens the parent through a pinned directory handle and creates\n35|//     the leaf relative to that handle, so a symlinked intermediate\n36|//     directory cannot redirect the commit outside the root;\n37|//   - mode: the leaf must carry exactly 0700, enforced explicitly\n38|//     after creation because mkdir honors umask;\n39|//   - ownership: the leaf must belong to the effective UID.\n40|//\n41|// Lexical validation delegates to its landed owners (absolute root\n42|// and relative member to scalar, the join to secprim.Guard); the\n43|// descriptor-relative commit below is what this package owns, because\n44|// no landed helper commits a directory relative to a handle.\n45|//\n46|// On failure the returned path distinguishes the refusal phase: a\n47|// lexical refusal returns \"\", while a commit-phase refusal returns\n48|// the joined path alongside the error. Callers must check the error\n49|// first and never use the path when it is set; the split lets the\n50|// acquisition wiring narrow exactly the commit-phase class.\n51|func EnsureRuntimeDir(root, name string, platform scalar.Platform, hooks *Hooks) (string, error) {\n52|\tjoined, err := lexicalRuntimePath(root, name, platform)\n53|\tif err != nil {\n54|\t\treturn \"\", err\n55|\t}\n56|\treturn joined, commitRuntimeDir(root, name, joined, hooks)\n57|}\n58|\n59|// VerifyRuntimeDir enforces the three custody gates on an existing\n60|// runtime directory without creating it. Background acquisition calls\n61|// this instead of Ensure: the directory must already exist with exact\n62|// custody, and a missing directory refuses rather than being silently\n63|// created on the authorizing path. Foreground acquisition calls\n64|// Ensure, which provisions the directory it then verifies.\n65|func VerifyRuntimeDir(root, name string, platform scalar.Platform) error {\n66|\tif _, err := lexicalRuntimePath(root, name, platform); err != nil {\n67|\t\treturn err\n68|\t}\n69|\treturn verifyRuntimeDir(root, name)\n70|}\n71|\n72|// lexicalRuntimePath validates the root grammar, the name grammar,\n73|// and the lexical join. It answers the lexical question only; the\n74|// commit answers the filesystem question through a handle.\n75|func lexicalRuntimePath(root, name string, platform scalar.Platform) (string, error) {\n76|\tif _, err := scalar.ParsePlatform(string(platform)); err != nil {\n77|\t\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"runtime platform\"}\n78|\t}\n79|\t// Native Windows MUST NOT claim tmux or tmux resurrection\n80|\t// (pinned SPEC 1458), so the Windows platform refuses here on\n81|\t// every host, before any host-specific commit runs. Weakening\n82|\t// this arm reroutes a Windows request to the root refusal\n83|\t// instead of admitting it.\n84|\tif platform == scalar.PlatformWindows {\n85|\t\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"runtime platform\"}\n86|\t}\n87|\tif _, err := scalar.ParseAbsolutePath(platform, root); err != nil {\n88|\t\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"runtime root\"}\n89|\t}\n90|\tif err := checkRuntimeName(name); err != nil {\n91|\t\treturn \"\", err\n92|\t}\n93|\tguard, err := secprim.NewGuard(root, platform, []string{name})\n94|\tif err != nil {\n95|\t\treturn \"\", &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n96|\t}\n97|\tjoined, err := guard.Resolve(name)\n98|\tif err != nil {\n99|\t\treturn \"\", &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n100|\t}\n101|\treturn joined, nil\n102|}\n103|\n104|// checkRuntimeName admits exactly one relative path segment. The\n105|// shared grammar (absolute, parent, dot, empty, NUL, backslash,\n106|// encoded separators) is decided by scalar; this gate adds only the\n107|// single-segment rule scalar does not own, because the commit opens\n108|// the leaf relative to the pinned parent handle and a second segment\n109|// would name a path the handle walk never descends.\n110|func checkRuntimeName(name string) error {\n111|\tif _, err := scalar.ParseRelativePath(name); err != nil {\n112|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"runtime name\"}\n113|\t}\n114|\tif strings.Contains(name, \"/\") {\n115|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"runtime name\"}\n116|\t}\n117|\treturn nil\n118|}\n119|\n120|// sameDirectory compares two stat results for directory identity. It\n121|// is a variable only so seam-failure tests can force the\n122|// handle-mismatch path through the production entries: a handle that\n123|// names a different directory than the path cannot be staged without\n124|// a filesystem race, and without the seam the mismatch branch is\n125|// untestable. Production code never reassigns it.\n126|var sameDirectory = os.SameFile\n127|\n128|// handleBoundToPath reports whether the open directory handle refers\n129|// to the same directory as rootPath. It mirrors the private\n130|// secprim.guardRootMatches check, which no caller outside secprim\n131|// can invoke: a stat failure on either side is not a match, and an\n132|// unreadable root fails closed into the mismatch refusal rather\n133|// than admitting an unverifiable handle.\n134|func handleBoundToPath(handle *os.File, rootPath string) bool {\n135|\thandleInfo, err := handle.Stat()\n136|\tif err != nil || handleInfo == nil {\n137|\t\treturn false\n138|\t}\n139|\tpathInfo, err := os.Stat(rootPath)\n140|\tif err != nil || pathInfo == nil {\n141|\t\treturn false\n142|\t}\n143|\treturn sameDirectory(handleInfo, pathInfo)\n144|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb25","stream":{"kind":"session","id":"01a0c5d0-c246-7b92-beac-dc3b11390997"},"sequence":1005,"recorded_at":1780531400002005,"record_type":"event","durability":"durable","causation_id":"aa3bb7a1-c12a-4660-a0d5-ffba7d41ef0c","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"aa3bb7a1-c12a-4660-a0d5-ffba7d41ef0c","run_stream":{"kind":"run","id":"aa3bb7a1-c12a-4660-a0d5-ffba7d41ef0c"},"call_id":"call_01a0c5d582c573c89b7a94e8b6a2d5cb","text":"Read text file `internal/tmuxserver/runtime_windows.go`.\n1|//go:build windows\n2|\n3|package tmuxserver\n4|\n5|// Native Windows MUST NOT claim tmux or tmux resurrection (pinned\n6|// SPEC 1458), so the Windows runtime-directory arms refuse every\n7|// request. The lexical path in runtime.go already refuses\n8|// PlatformWindows on every host before these entries run; the stubs\n9|// exist because Go requires the symbols to compile under\n10|// GOOS=windows, and they fail closed so a weakened lexical gate\n11|// still reaches no tmux directory on this host.\n12|func commitRuntimeDir(root, name, joined string, hooks *Hooks) error {\n13|\treturn &Error{Code: CodeInvalidArguments, Detail: \"runtime platform host\"}\n14|}\n15|\n16|// verifyRuntimeDir refuses on Windows for the same reason as the\n17|// commit arm above: no tmux runtime directory exists on this host.\n18|func verifyRuntimeDir(root, name string) error {\n19|\treturn &Error{Code: CodeInvalidArguments, Detail: \"runtime platform host\"}\n20|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
