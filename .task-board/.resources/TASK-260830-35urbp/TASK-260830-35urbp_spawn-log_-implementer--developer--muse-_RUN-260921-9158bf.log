{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cca1","stream":{"kind":"session","id":"01a0c5d0-c246-7b92-beac-dc3b11390997"},"sequence":1195,"recorded_at":1780531400002385,"record_type":"event","durability":"durable","causation_id":"aa3bb7a1-c12a-4660-a0d5-ffba7d41ef0c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"aa3bb7a1-c12a-4660-a0d5-ffba7d41ef0c","run_stream":{"kind":"run","id":"aa3bb7a1-c12a-4660-a0d5-ffba7d41ef0c"},"task_stream":{"kind":"task","id":"01a0c5d8-334d-7e13-9475-32669a1d3724"},"task_id":"01a0c5d8-334d-7e13-9475-32669a1d3724","event":{"kind":"output","task_id":"01a0c5d8-334d-7e13-9475-32669a1d3724","chunk":"edited\nchanged lines: lines 179-200\n--- original\n+++ updated\n@@\n-\t\terr := verifyWithDeadline(t, func() error {\n-\t\t\treturn VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS)\n-\t\t})\n-\t\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n-\t})\n-}\n-\n-// verifyWithDeadline turns a blocked verify into a failure instead of\n-// a stalled suite: with O_DIRECTORY the refusal arrives immediately,\n-// and without it the FIFO open stalls past the deadline.\n-func verifyWithDeadline(t *testing.T, fn func() error) error {\n-\tt.Helper()\n-\tdone := make(chan error, 1)\n-\tgo func() { done <- fn() }()\n-\tselect {\n-\tcase err := <-done:\n-\t\treturn err\n-\tcase <-time.After(5 * time.Second):\n-\t\tt.Fatalf(\"VerifyRuntimeDir BLOCKED for 5s on a FIFO leaf (O_DIRECTORY must fail fast)\")\n-\t\treturn nil\n-\t}\n-}\n+\t\terr := verifyWithDeadline(t, \"VerifyRuntimeDir\", func() error {\n+\t\t\treturn VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS)\n+\t\t})\n+\t\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n+\t})\n+}\n+\n+// verifyWithDeadline turns a blocked custody refusal into a failure\n+// instead of a stalled suite: with O_DIRECTORY the refusal arrives\n+// immediately, and without it the FIFO open stalls past the deadline.\n+// The entry name identifies the blocked call in the failure message;\n+// both the commit and the verify side run their FIFO fixture through\n+// this helper.\n+func verifyWithDeadline(t *testing.T, entry string, fn func() error) error {\n+\tt.Helper()\n+\tdone := make(chan error, 1)\n+\tgo func() { done <- fn() }()\n+\tselect {\n+\tcase err := <-done:\n+\t\treturn err\n+\tcase <-time.After(5 * time.Second):\n+\t\tt.Fatalf(\"%s BLOCKED for 5s on a FIFO leaf (O_DIRECTORY must fail fast)\", entry)\n+\t\treturn nil\n+\t}\n+}\n","final_result":true}}}
