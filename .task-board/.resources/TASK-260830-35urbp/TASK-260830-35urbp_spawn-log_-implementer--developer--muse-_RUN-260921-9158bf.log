egular_file_0600\\n    runtime_test.go:132: err = tmux_unsafe_runtime_dir at runtime mode, want tmux_unsafe_runtime_dir at runtime containment\\n=== RUN   TestEnsureRuntimeDirRefusesNonDirectoryLeaf/regular_file_0700\\n    runtime_test.go:141: err = nil, want tmux_unsafe_runtime_dir at runtime containment\\n=== RUN   TestEnsureRuntimeDirRefusesNonDirectoryLeaf/fifo_without_blocking\\n    runtime_test.go:148: EnsureRuntimeDir BLOCKED for 5s on a FIFO leaf (O_DIRECTORY must fail fast)\\n--- FAIL: TestEnsureRuntimeDirRefusesNonDirectoryLeaf (5.00s)\\n    --- FAIL: TestEnsureRuntimeDirRefusesNonDirectoryLeaf/regular_file_0600 (0.00s)\\n    --- FAIL: TestEnsureRuntimeDirRefusesNonDirectoryLeaf/regular_file_0700 (0.00s)\\n    --- FAIL: TestEnsureRuntimeDirRefusesNonDirectoryLeaf/fifo_without_blocking (5.00s)\\n internal/tmuxserver/runtime_unix.go | 135 ++++++++++++++++++++++++++++++++++++\\n 1 file changed, 135 insertions(+)\\nrestored\\n\",\n  \"original_output_bytes\": 1249,\n  \"original_output_tokens\": 313,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
