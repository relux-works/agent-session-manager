       name=\"N-root-symlink-commit\",\n725|        path=f\"{PACKAGE}/runtime_unix.go\",\n726|        find=\"\\trootHandle, err := secprim.OpenNoFollowDir(root)\\n\\tif err != nil {\\n\\t\\treturn classifyRootOpenError(err)\\n\\t}\\n\\tdefer func() { _ = rootHandle.Close() }()\\n\\tif !handleBoundToPath(rootHandle, root) {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\\trootFd := int(rootHandle.Fd())\\n\",\n727|        replace=\"\\trootHandle, err := secprim.OpenNoFollowDir(root)\\n\\tif err != nil {\\n\\t\\tif fi, lerr := os.Lstat(root); lerr == nil && fi.Mode()&os.ModeSymlink != 0 {\\n\\t\\t\\trootHandle, err = os.Open(root)\\n\\t\\t}\\n\\t\\tif err != nil {\\n\\t\\t\\treturn classifyRootOpenError(err)\\n\\t\\t}\\n\\t}\\n\\tdefer func() { _ = rootHandle.Close() }()\\n\\tif !handleBoundToPath(rootHandle, root) {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\\trootFd := int(rootHandle.Fd())\\n\",\n728|        count=1,\n729|        run=\"TestEnsureRuntimeDirRefusesSymlinkRoot\",\n730|        expect=\"KILLED\",\n731|        note=\"Admits exactly symlink roots past the commit-side no-follow open via a following fallback; missing, non-directory, and every other root-open failure still refuse through the shared classifier, and the verify side still refuses. Kill path: the entry commits the leaf inside the link target instead of refusing.\",\n732|    ),\n733|    Mutant(\n734|        name=\"N-root-symlink-verify\",\n735|        path=f\"{PACKAGE}/runtime_unix.go\",\n736|        find=\"\\trootHandle, err := secprim.OpenNoFollowDir(root)\\n\\tif err != nil {\\n\\t\\treturn classifyRootOpenError(err)\\n\\t}\\n\\tdefer func() { _ = rootHandle.Close() }()\\n\\tif !handleBoundToPath(rootHandle, root) {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\\tleafFd, err := unix.Openat(int(rootHandle.Fd()), name,\\n\",\n737|        replace