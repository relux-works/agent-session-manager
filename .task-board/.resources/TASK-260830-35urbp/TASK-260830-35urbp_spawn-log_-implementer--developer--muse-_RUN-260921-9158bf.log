t := runtimeRoot(t)\n685|\t\t\t\t\tdir := socketDir(t, root)\n686|\t\t\t\t\treq := validRequest(t, root)\n687|\t\t\t\t\treq.Caller = caller\n688|\t\t\t\t\treq.Ambient = tc.ambient(SocketPath(dir))\n689|\t\t\t\t\tspy := &spawnSpy{}\n690|\t\t\t\t\tprobe := &probeServerSpy{}\n691|\t\t\t\t\treq.Deps.ProbeServer = probe.probe\n692|\t\t\t\t\treq.Deps.Spawn = spy.spawn\n693|\t\t\t\t\t_, err := Acquire(req)\n694|\t\t\t\t\trequireLocalError(t, err, \"tmux_ambient_server_reuse\", \"ambient collision\")\n695|\t\t\t\t\tif spy.calls != 0 {\n696|\t\t\t\t\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n697|\t\t\t\t\t}\n698|\t\t\t\t\tprobe.requireSilent(t)\n699|\t\t\t\t})\n700|\t\t\t}\n701|\t\t})\n702|\t}\n703|}\n704|\n705|// The background path verifies custody through VerifyRuntimeDir, so a\n706|// non-directory leaf refuses through the entry before any broker\n707|// contact: the verify-side O_DIRECTORY refusal driven at the entry the\n708|// background path uses.\n709|func TestAcquireBackgroundRefusesNonDirectoryLeaf(t *testing.T) {\n710|\troot := runtimeRoot(t)\n711|\tleaf := filepath.Join(root, RuntimeDirName)\n712|\tif err := os.WriteFile(leaf, []byte(\"x\"), 0o700); err != nil {\n713|\t\tt.Fatal(err)\n714|\t}\n715|\treq := validRequest(t, root)\n716|\treq.Caller = CallerBackground\n717|\tprobed := false\n718|\tspy := &spawnSpy{}\n719|\tprobe := &probeServerSpy{}\n720|\treq.Deps.Spawn = spy.spawn\n721|\treq.Deps.ProbeServer = probe.probe\n722|\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n723|\t\tprobed = true\n724|\t\treturn brokerReport(), nil\n725|\t}\n726|\t_, err := Acquire(req)\n727|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n728|\tif probed {\n729|\t\tt.Fatal(\"broker was probed past a non-directory leaf\")\n730|\t}\n731|\tif spy.calls != 0 {\n732|\t\tt.Fatalf(\"spawn calls = %d, want 0 past a non-directory leaf\", spy.calls)\n733|\t}\n734|\tprobe.requireSilent(t)\n735|}\n736|\n737|// A symlink leaf refuses through the background entry before any\n738|// broker contact. The escape target is a compliant directory, so a\n739|// verify-side plant that follows the leaf admits fully and the test\n740|// reddens on the broker contact, not on a rerouted custody detail.\n741|func TestAcquireBackgroundRefusesSymlinkLeaf(t *testing.T) {\n742|\troot := runtimeRoot(t)\n743|\tescape := t.TempDir()\n744|\tleaf := filepath.Join(root, RuntimeDirName)\n745|\tif err := os.Symlink(escape, leaf); err != nil {\n746|\t\tt.Fatal(err)\n747|\t}\n748|\treq := validRequest(t, root)\n749|\treq.Caller = CallerBackground\n750|\tprobed := false\n751|\tspy := &spawnSpy{}\n752|\tprobe := &probeServerSpy{}\n753|\treq.Deps.Spawn = spy.spawn\n754|\treq.Deps.ProbeServer = probe.probe\n755|\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n756|\t\tprobed = true\n757|\t\treturn brokerReport(), nil\n758|\t}\n759|\t_, err := Acquire(req)\n760|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n761|\tif probed {\n762|\t\tt.Fatal(\"broker was probed past a symlink leaf\")\n763|\t}\n764|\tif spy.calls != 0 {\n765|\t\tt.Fatalf(\"spawn calls = %d, want 0 past a symlink leaf\", spy.calls)\n766|\t}\n767|\tprobe.requireSilent(t)\n768|}\n769|\n770|// A symlinked runtime root refuses through the background entry\n771|// before any broker contact: the pinned root handle never follows\n772|// the last component, exactly as on the commit and verify sides.\n773|func TestAcquireBackgroundRefusesSymlinkRoot(t *testing.T) {\n774|\treal := runtimeRoot(t)\n775|\tlink := filepath.Join(t.TempDir(), \"linkroot\")\n776|\tif err := os.Symlink(real, link); err != nil {\n777|\t\tt.Fatal(err)\n778|\t}\n779|\treq := validRequest(t, link)\n780|\treq.Caller = CallerBackground\n781|\tprobed := false\n782|\tspy := &spawnSpy{}\n783|\tprobe := &probeServerSpy{}\n784|\treq.Deps.Spawn = spy.spawn\n785|\treq.Deps.ProbeServer = probe.probe\n786|\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n787|\t\tprobed = true\n788|\t\treturn brokerReport(), nil\n789|\t}\n790|\t_, err := Acquire(req)\n791|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n792|\tif probed {\n793|\t\tt.Fatal(\"broker was probed past a symlinked root\")\n794|\t}\n795|\tif spy.calls != 0 {\n796|\t\tt.Fatalf(\"spawn calls = %d, want 0 past a symlinked root\", spy.calls)\n797|\t}\n798|\tprobe.requireSilent(t)\n799|}\n(more lines below)","final_result":true}}}
