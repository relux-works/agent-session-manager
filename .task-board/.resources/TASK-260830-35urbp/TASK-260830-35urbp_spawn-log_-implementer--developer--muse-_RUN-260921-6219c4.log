{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4b7","stream":{"kind":"session","id":"01a0c4fd-996a-7423-ba27-e5daf29de5a2"},"sequence":182,"recorded_at":1780531400000359,"record_type":"event","durability":"durable","causation_id":"e01e1bc2-95c9-4151-a1a6-6ebbbbe18d95","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e01e1bc2-95c9-4151-a1a6-6ebbbbe18d95","run_stream":{"kind":"run","id":"e01e1bc2-95c9-4151-a1a6-6ebbbbe18d95"},"task_stream":{"kind":"task","id":"01a0c4ff-0b20-7bd1-a6c2-2e7c6e908657"},"task_id":"01a0c4ff-0b20-7bd1-a6c2-2e7c6e908657","event":{"kind":"output","task_id":"01a0c4ff-0b20-7bd1-a6c2-2e7c6e908657","chunk":"Read text file `internal/tmuxserver/readiness.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n5|)\n6|\n7|// RealmAdmission is the landed admission verdict over the exact tmux\n8|// server: the Reconcile/ResolveEvidence Admitted set plus the AX-known\n9|// raw generation the admission binds to. Production probes report this\n10|// verdict; tests model probe reports. This leaf never re-decides what\n11|// the admission already proves — signature verification, liveness,\n12|// expiry, and the sentinel/smoke requirement coverage are the landed\n13|// terminalbackend owner's verdict, consumed here through Has — and\n14|// composes it only with the generation equality the wrapper owner\n15|// (internal/axpane checkRealm) already enforces: the admission's raw\n16|// generation must equal the request's typed generation, or the proof\n17|// is stale and refuses.\n18|//\n19|// There is deliberately no member for a cached sentinel result, a\n20|// managername observation, or any attested-server boolean: none\n21|// authorizes, so none is an input. A cached observation replayed as a\n22|// live one is exactly a stale-generation admission, and it refuses on\n23|// the generation arm.\n24|type RealmAdmission struct {\n25|\t// Admitted is the landed admission verdict.\n26|\tAdmitted terminalbackend.Admitted\n27|\t// RawGeneration is the AX-known raw generation the admission\n28|\t// binds to.\n29|\tRawGeneration string\n30|}\n31|\n32|// CheckServerAttested admits exactly an attested dedicated server:\n33|// the landed admission holds the credential_capable_execution_realm\n34|// row AND the admission's raw generation equals the request's typed\n35|// generation. Each arm refuses alone: a missing row refuses even with\n36|// a bound generation, and a wrong generation refuses even with an\n37|// admitted row, so weakening either arm admits a server the committed\n38|// tests pin.\n39|func CheckServerAttested(admission RealmAdmission, wantGeneration string) error {\n40|\tif !admission.Admitted.Has(realmCapability) {\n41|\t\treturn &Error{Code: CodeReadinessNotAuthorizing, Detail: \"server attestation\"}\n42|\t}\n43|\tif wantGeneration == \"\" || admission.RawGeneration != wantGeneration {\n44|\t\treturn &Error{Code: CodeReadinessNotAuthorizing, Detail: \"server generation\"}\n45|\t}\n46|\treturn nil\n47|}\n48|\n49|// BrokerPrincipal is the authenticated Aqua broker identity the\n50|// background path decides over. Per Section 4.4 the broker exposes\n51|// only authenticated, same-user, generation-bound terminal readiness,\n52|// so the principal carries the authenticated UID and the generation\n53|// its readiness binds to as typed, bound facts — never a bare\n54|// boolean. The UID is compared against the process identity, and the\n55|// generation against the request's typed generation.\n56|type BrokerPrincipal struct {\n57|\t// UID is the broker's authenticated user identity.\n58|\tUID uint32\n59|\t// Generation is the generation the broker readiness binds to.\n60|\tGeneration string\n61|}\n62|\n63|// BrokerReport is the live Aqua broker report the background path\n64|// decides over: the authenticated principal plus the attested AX tmux\n65|// server admission. Either fact missing means neither exists for the\n66|// purpose of the broker-or-refuse rule.\n67|type BrokerReport struct {\n68|\tPrincipal BrokerPrincipal\n69|\tServer    RealmAdmission\n70|}\n71|\n72|// CheckBrokerContact admits exactly the background MAY case: a\n73|// same-user authenticated broker principal AND a generation-bound\n74|// principal AND the attested AX tmux server admission bound to the\n75|// same typed generation. Every other report — a foreign-user broker,\n76|// an unbound principal, an unattested server, a stale admission —\n77|// refuses, and the caller maps the refusal to the typed\n78|// capability_unavailable the spec names.\n79|func CheckBrokerContact(report BrokerReport, wantGeneration string, currentUID uint32) error {\n80|\tif report.Principal.UID != currentUID {\n81|\t\treturn &Error{Code: CodeReadinessNotAuthorizing, Detail: \"broker authentication\"}\n82|\t}\n83|\tif report.Principal.Generation == \"\" || report.Principal.Generation != wantGeneration {\n84|\t\treturn &Error{Code: CodeReadinessNotAuthorizing, Detail: \"broker generation\"}\n85|\t}\n86|\treturn CheckServerAttested(report.Server, wantGeneration)\n87|}","final_result":true}}}
