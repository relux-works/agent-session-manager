{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6ef","stream":{"kind":"session","id":"01a0c4fd-996a-7423-ba27-e5daf29de5a2"},"sequence":466,"recorded_at":1780531400000927,"record_type":"event","durability":"durable","causation_id":"e01e1bc2-95c9-4151-a1a6-6ebbbbe18d95","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e01e1bc2-95c9-4151-a1a6-6ebbbbe18d95","run_stream":{"kind":"run","id":"e01e1bc2-95c9-4151-a1a6-6ebbbbe18d95"},"task_stream":{"kind":"task","id":"01a0c50b-5ad9-7ea2-a0b4-36c16206e318"},"task_id":"01a0c50b-5ad9-7ea2-a0b4-36c16206e318","event":{"kind":"output","task_id":"01a0c50b-5ad9-7ea2-a0b4-36c16206e318","chunk":"Read text file `internal/tmuxserver/mutant_harness.py`.\n(649 line(s) above)\n650|            run = subprocess.run(\n651|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n652|                cwd=REPO,\n653|                capture_output=True,\n654|                text=True,\n655|                timeout=300,\n656|            )\n657|        finally:\n658|            shutil.copy2(backup, target)\n659|    output = (run.stdout + run.stderr).strip()\n660|    if os.environ.get(\"AX_MUTANT_VERBOSE\") == \"1\":\n661|        print(f\"--- raw: {mutant.name}: exit {run.returncode} ---\", flush=True)\n662|        print(output, flush=True)\n663|        print(f\"--- end raw: {mutant.name} ---\", flush=True)\n664|    if log_dir is not None:\n665|        (log_dir / f\"{mutant.name}.log\").write_text(\n666|            f\"exit: {run.returncode}\\nrun: go test ./{PACKAGE}/ -run {mutant.run} -count=1\\n\\n{output}\\n\"\n667|        )\n668|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n669|        return f\"ERROR: {mutant.name}: build broke under the patch\"\n670|    if run.returncode == 0:\n671|        verdict = \"SURVIVED\"\n672|    elif '--- FAIL' in output or 'FAIL:' in output:\n673|        verdict = \"KILLED\"\n674|    else:\n675|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\"\n676|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n677|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note} [exit {run.returncode}]\"\n678|\n679|\n680|def main(argv: list[str]) -> int:\n681|    log_dir: Path | None = None\n682|    names = list(argv)\n683|    if \"--log-dir\" in names:\n684|        idx = names.index(\"--log-dir\")\n685|        if idx + 1 >= len(names):\n686|            print(\"--log-dir needs a directory\")\n687|            return 2\n688|        log_dir = Path(names[idx + 1])\n689|        log_dir.mkdir(parents=True, exist_ok=True)\n690|        del names[idx : idx + 2]\n691|    selected = [m for m in MUTANTS if not names or m.name in names]\n692|    if names and len(selected) != len(names):\n693|        unknown = sorted(set(names) - {m.name for m in selected})\n694|        print(f\"unknown mutants: {', '.join(unknown)}\")\n695|        return 2\n696|    failures = 0\n697|    for mutant in selected:\n698|        try:\n699|            line = run_mutant(mutant, log_dir)\n700|        except subprocess.TimeoutExpired:\n701|            line = f\"ERROR: {mutant.name}: killer timed out\"\n702|        print(line, flush=True)\n703|        if not line.startswith(\"ok:\"):\n704|            failures += 1\n705|    return 1 if failures else 0\n706|\n707|\n708|if __name__ == \"__main__\":\n709|    sys.exit(main(sys.argv[1:]))","final_result":true}}}
