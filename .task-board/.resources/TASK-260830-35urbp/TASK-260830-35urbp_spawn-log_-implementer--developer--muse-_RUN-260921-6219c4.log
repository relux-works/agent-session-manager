{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5cf","stream":{"kind":"session","id":"01a0c4fd-996a-7423-ba27-e5daf29de5a2"},"sequence":322,"recorded_at":1780531400000639,"record_type":"event","durability":"durable","causation_id":"e01e1bc2-95c9-4151-a1a6-6ebbbbe18d95","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e01e1bc2-95c9-4151-a1a6-6ebbbbe18d95","run_stream":{"kind":"run","id":"e01e1bc2-95c9-4151-a1a6-6ebbbbe18d95"},"call_id":"call_01a0c504178370c494790ed061229601","text":"Read text file `internal/tmuxserver/acquire_test.go`.\n(499 line(s) above)\n500|\n501|func TestAcquireRefusesEveryAmbientOverrideVector(t *testing.T) {\n502|\thostile := hostileAmbient()\n503|\tvectors := map[string]string{\n504|\t\t\"environment variable\": hostile.TMUXEnv,\n505|\t\t\"tmux tmpdir\":          hostile.TMUXTmpDir,\n506|\t\t\"inherited socket\":     hostile.InheritedSocket,\n507|\t\t\"default path\":         hostile.DefaultPath,\n508|\t\t\"conventional name\":    hostile.ConventionalName,\n509|\t\t\"whitespace only\":      \"  \",\n510|\t}\n511|\tfor name, override := range vectors {\n512|\t\tt.Run(name, func(t *testing.T) {\n513|\t\t\troot := runtimeRoot(t)\n514|\t\t\treq := validRequest(t, root)\n515|\t\t\tspy := &spawnSpy{}\n516|\t\t\treq.SocketOverride = override\n517|\t\t\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n518|\t\t\t\treturn ServerReport{}, nil\n519|\t\t\t}\n520|\t\t\treq.Deps.Spawn = spy.spawn\n521|\t\t\t_, err := Acquire(req)\n522|\t\t\trequireLocalError(t, err, \"tmux_ambient_server_reuse\", \"socket override\")\n523|\t\t\tif spy.calls != 0 {\n524|\t\t\t\tt.Fatalf(\"spawn calls = %d, want 0 on ambient refusal\", spy.calls)\n525|\t\t\t}\n526|\t\t\tif _, statErr := os.Lstat(filepath.Join(root, RuntimeDirName)); !os.IsNotExist(statErr) {\n527|\t\t\t\tt.Fatalf(\"ambient refusal created the directory: stat err = %v\", statErr)\n528|\t\t\t}\n529|\t\t})\n530|\t}\n531|}\n532|\n533|func TestAcquireRefusesAmbientCollision(t *testing.T) {\n534|\tfor _, tc := range []struct {\n535|\t\tname    string\n536|\t\tambient func(derived string) Ambient\n537|\t}{\n538|\t\t{\"tmux env\", func(derived string) Ambient { return Ambient{TMUXEnv: derived} }},\n539|\t\t{\"tmux tmpdir\", func(derived string) Ambient { return Ambient{TMUXTmpDir: derived} }},\n540|\t\t{\"inherited socket\", func(derived string) Ambient { return Ambient{InheritedSocket: derived} }},\n541|\t\t{\"default path\", func(derived string) Ambient { return Ambient{DefaultPath: derived} }},\n542|\t\t{\"conventional name\", func(derived string) Ambient { return Ambient{ConventionalName: derived} }},\n543|\t} {\n544|\t\tt.Run(tc.name, func(t *testing.T) {\n545|\t\t\troot := runtimeRoot(t)\n546|\t\t\tdir := socketDir(t, root)\n547|\t\t\treq := validRequest(t, root)\n548|\t\t\treq.Ambient = tc.ambient(SocketPath(dir))\n549|\t\t\tspy := &spawnSpy{}\n550|\t\t\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n551|\t\t\t\treturn ServerReport{}, nil\n552|\t\t\t}\n553|\t\t\treq.Deps.Spawn = spy.spawn\n554|\t\t\t_, err := Acquire(req)\n555|\t\t\trequireLocalError(t, err, \"tmux_ambient_server_reuse\", \"ambient collision\")\n556|\t\t\tif spy.calls != 0 {\n557|\t\t\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n558|\t\t\t}\n559|\t\t})\n560|\t}\n561|}\n562|\n563|// The background path verifies custody through VerifyRuntimeDir, so a\n564|// non-directory leaf refuses through the entry before any broker\n565|// contact: the verify-side O_DIRECTORY refusal driven at the entry the\n566|// background path uses.\n567|func TestAcquireBackgroundRefusesNonDirectoryLeaf(t *testing.T) {\n568|\troot := runtimeRoot(t)\n569|\tleaf := filepath.Join(root, RuntimeDirName)\n570|\tif err := os.WriteFile(leaf, []byte(\"x\"), 0o700); err != nil {\n571|\t\tt.Fatal(err)\n572|\t}\n573|\treq := validRequest(t, root)\n574|\treq.Caller = CallerBackground\n575|\tprobed := false\n576|\tspy := &spawnSpy{}\n577|\treq.Deps.Spawn = spy.spawn\n578|\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n579|\t\tprobed = true\n580|\t\treturn brokerReport(), nil\n581|\t}\n582|\t_, err := Acquire(req)\n583|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n584|\tif probed {\n585|\t\tt.Fatal(\"broker was probed past a non-directory leaf\")\n586|\t}\n587|\tif spy.calls != 0 {\n588|\t\tt.Fatalf(\"spawn calls = %d, want 0 past a non-directory leaf\", spy.calls)\n589|\t}\n590|}\n591|\n592|// An unclean spelling of the derived socket refuses through the entry\n593|// with no spawn: the cleaned-spelling collision gate driven at\n594|// Acquire.\n595|func TestAcquireRefusesAmbientCollisionUncleanSpelling(t *testing.T) {\n596|\troot := runtimeRoot(t)\n597|\tdir := socketDir(t, root)\n598|\talias := dir + \"/./\" + SocketName\n599|\tif got := filepath.Clean(alias); got != SocketPath(dir) {\n600|\t\tt.Fatalf(\"alias %q cleans to %q, want the derived socket\", alias, got)\n601|\t}\n602|\treq := validRequest(t, root)\n603|\treq.Ambient = Ambient{DefaultPath: alias}\n604|\tspy := &spawnSpy{}\n605|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n606|\t\treturn ServerReport{}, nil\n607|\t}\n608|\treq.Deps.Spawn = spy.spawn\n609|\t_, err := Acquire(req)\n610|\trequireLocalError(t, err, \"tmux_ambient_server_reuse\", \"ambient collision\")\n611|\tif spy.calls != 0 {\n612|\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n613|\t}\n614|}\n615|\n616|// A TMUX value naming the derived socket in the real\n617|// `<socket>,<pid>,<index>` encoding refuses through the entry with\n618|// no spawn: the collision gate compares the socket component.\n619|func TestAcquireRefusesTMUXEnvCollisionRealEncoding(t *testing.T) {\n620|\troot := runtimeRoot(t)\n621|\tdir := socketDir(t, root)\n622|\tencoded := SocketPath(dir) + \",12345,0\"\n623|\treq := validRequest(t, root)\n624|\treq.Ambient = Ambient{TMUXEnv: encoded}\n625|\tspy := &spawnSpy{}\n626|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n627|\t\treturn ServerReport{}, nil\n628|\t}\n629|\treq.Deps.Spawn = spy.spawn\n630|\t_, err := Acquire(req)\n631|\trequireLocalError(t, err, \"tmux_ambient_server_reuse\", \"ambient collision\")\n632|\tif spy.calls != 0 {\n633|\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n634|\t}\n635|}\n636|\n637|func TestAcquireRefusesUnknownCaller(t *testing.T) {\n638|\troot := runtimeRoot(t)\n639|\treq := validRequest(t, root)\n640|\treq.Caller = \"operator\"\n641|\t_, err := Acquire(req)\n642|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"caller\")\n643|}\n644|\n645|func TestAcquireRefusesWindowsPlatform(t *testing.T) {\n646|\troot := runtimeRoot(t)\n647|\tfor _, caller := range []Caller{CallerForeground, CallerBackground} {\n648|\t\treq := validRequest(t, root)\n649|\t\treq.Caller = caller\n650|\t\treq.Platform = scalar.PlatformWindows\n651|\t\treq.Root = `C:\\ax-runtime`\n652|\t\tspy := &spawnSpy{}\n653|\t\treq.Deps.Spawn = spy.spawn\n654|\t\t_, err := Acquire(req)\n655|\t\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"runtime platform\")\n656|\t\tif spy.calls != 0 {\n657|\t\t\tt.Fatalf(\"spawn calls = %d, want 0 on platform refusal\", spy.calls)\n658|\t\t}\n659|\t}\n660|}\n661|\n662|func TestAcquireRefusesMissingRealmDetails(t *testing.T) {\n663|\tbase := validRequest(t, runtimeRoot(t))\n664|\tfor _, tc := range []struct {\n665|\t\tname   string\n666|\t\tmutate func(*Request)\n667|\t}{\n668|\t\t{\"generation\", func(r *Request) { r.Generation = \"\" }},\n669|\t\t{\"broker state\", func(r *Request) { r.BrokerState = \"\" }},\n670|\t\t{\"remediation\", func(r *Request) { r.Remediation = \"\" }},\n671|\t} {\n672|\t\tt.Run(tc.name, func(t *testing.T) {\n673|\t\t\treq := base\n674|\t\t\ttc.mutate(&req)\n675|\t\t\t_, err := Acquire(req)\n676|\t\t\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"realm details\")\n677|\t\t})\n678|\t}\n679|}\n680|\n681|func TestAcquireRefusesMissingDependencies(t *testing.T) {\n682|\troot := runtimeRoot(t)\n683|\tforeground := validRequest(t, root)\n684|\t_, err := Acquire(foreground)\n685|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"dependencies\")\n686|\tbackground := validRequest(t, root)\n687|\tbackground.Caller = CallerBackground\n688|\tspy := &spawnSpy{}\n689|\tbackground.Deps.Spawn = spy.spawn\n690|\t_, err = Acquire(background)\n691|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"dependencies\")\n692|\tif spy.calls != 0 {\n693|\t\tt.Fatalf(\"spawn calls = %d, want 0 on missing dependencies\", spy.calls)\n694|\t}\n695|}\n696|\n697|func TestAcquireCreatesRuntimeDirIdempotently(t *testing.T) {\n698|\troot := runtimeRoot(t)\n699|\tmake := func() Request {\n700|\t\treq := validRequest(t, root)\n701|\t\tspy := &spawnSpy{}\n702|\t\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n703|\t\t\treturn ServerReport{}, nil\n704|\t\t}\n705|\t\treq.Deps.Spawn = spy.spawn\n706|\t\treturn req\n707|\t}\n708|\tfirst, err := Acquire(make())\n709|\tif err != nil {\n710|\t\tt.Fatal(err)\n711|\t}\n712|\tsecond, err := Acquire(make())\n713|\tif err != nil {\n714|\t\tt.Fatal(err)\n715|\t}\n716|\tif first.Socket != second.Socket {\n717|\t\tt.Fatalf(\"sockets differ: %q vs %q\", first.Socket, second.Socket)\n718|\t}\n719|}\n720|\n721|func TestAcquireBackgroundNilBrokerWithSpawnRefuses(t *testing.T) {\n722|\troot := runtimeRoot(t)\n723|\treq := validRequest(t, root)\n724|\treq.Caller = CallerBackground\n725|\tspy := &spawnSpy{}\n726|\treq.Deps.Spawn = spy.spawn\n727|\t_, err := Acquire(req)\n728|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"dependencies\")\n729|\tif spy.calls != 0 {\n730|\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n731|\t}\n732|}\n733|\n734|func TestAcquireForegroundNilSpawnWithProbeRefuses(t *testing.T) {\n735|\troot := runtimeRoot(t)\n736|\treq := validRequest(t, root)\n737|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n738|\t\treturn ServerReport{}, nil\n739|\t}\n740|\t_, err := Acquire(req)\n741|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"dependencies\")\n742|}\n743|\n744|func TestCheckCreationAllowedRefusesBackground(t *testing.T) {\n745|\trequireLocalError(t, checkCreationAllowed(CallerBackground), \"tmux_background_creation_refused\", \"background creation\")\n746|\tif err := checkCreationAllowed(CallerForeground); err != nil {\n747|\t\tt.Fatalf(\"foreground creation refused: %v\", err)\n748|\t}\n749|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5d1","stream":{"kind":"session","id":"01a0c4fd-996a-7423-ba27-e5daf29de5a2"},"sequence":323,"recorded_at":1780531400000641,"record_type":"event","durability":"durable","causation_id":"e01e1bc2-95c9-4151-a1a6-6ebbbbe18d95","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e01e1bc2-95c9-4151-a1a6-6ebbbbe18d95","run_stream":{"kind":"run","id":"e01e1bc2-95c9-4151-a1a6-6ebbbbe18d95"},"call_id":"call_01a0c5041a9f747c9ae1594184f84cbe","text":"Read text file `internal/tmuxserver/tmuxserver_test.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n12|)\n13|\n14|const (\n15|\tfixtureSession       = \"0198f4c8-7d40-7e55-8e6f-1234567890ab\"\n16|\tfixtureGeneration    = \"generation-7\"\n17|\tfixtureStaleGen      = \"generation-6\"\n18|\tfixtureBroker        = \"absent\"\n19|\tfixtureRemedy        = \"sign in to the GUI realm and retry\"\n20|\tfixtureDecoyCapacity = \"headless_creation\"\n21|)\n22|\n23|// realmAdmitted models a probe-reported landed admission holding the\n24|// credential realm row: in production the probe reports the\n25|// Reconcile/ResolveEvidence verdict, and tests model the report.\n26|func realmAdmitted() terminalbackend.Admitted {\n27|\treturn terminalbackend.Admitted{Capabilities: []string{\"credential_capable_execution_realm\"}}\n28|}\n29|\n30|// boundAdmission models a live admission bound to the request's typed\n31|// generation.\n32|func boundAdmission() RealmAdmission {\n33|\treturn RealmAdmission{Admitted: realmAdmitted(), RawGeneration: fixtureGeneration}\n34|}\n35|\n36|// staleAdmission models yesterday's live proof replayed today: the\n37|// row is admitted but bound to the previous generation.\n38|func staleAdmission() RealmAdmission {\n39|\treturn RealmAdmission{Admitted: realmAdmitted(), RawGeneration: fixtureStaleGen}\n40|}\n41|\n42|// brokerReport models a live broker report: a same-user principal\n43|// bound to the typed generation plus the bound server admission.\n44|func brokerReport() BrokerReport {\n45|\treturn BrokerReport{\n46|\t\tPrincipal: BrokerPrincipal{UID: currentUID(), Generation: fixtureGeneration},\n47|\t\tServer:    boundAdmission(),\n48|\t}\n49|}\n50|\n51|// foreignUID stages a broker principal the same-user arm must refuse\n52|// without privilege: the test identity shifted out of range.\n53|func foreignUID() uint32 { return currentUID() + 100000 }\n54|\n55|func validRequest(t *testing.T, root string) Request {\n56|\tt.Helper()\n57|\treturn Request{\n58|\t\tCaller:      CallerForeground,\n59|\t\tPlatform:    scalar.PlatformMacOS,\n60|\t\tRoot:        root,\n61|\t\tSessionID:   fixtureSession,\n62|\t\tGeneration:  fixtureGeneration,\n63|\t\tBrokerState: fixtureBroker,\n64|\t\tRemediation: fixtureRemedy,\n65|\t}\n66|}\n67|\n68|func hostileAmbient() Ambient {\n69|\treturn Ambient{\n70|\t\tTMUXEnv:          \"/tmp/tmux-501/default,12345,0\",\n71|\t\tTMUXTmpDir:       \"/tmp/operator-tmux\",\n72|\t\tInheritedSocket:  \"/tmp/inherited.sock\",\n73|\t\tDefaultPath:      \"/tmp/tmux-501/default\",\n74|\t\tConventionalName: \"default\",\n75|\t}\n76|}\n77|\n78|// requireLocalError pins the refusal the caller renders: the TOP-LEVEL\n79|// dynamic type must be *tmuxserver.Error, and no *axerror.Error wrapper\n80|// may be reachable. errors.As alone looks through the\n81|// capability_unavailable wrapper (axerror.Error.Unwrap returns the\n82|// cause, which is redacted off the wire by design), so a wrapped\n83|// custody refusal would satisfy a code/detail assertion while the\n84|// caller sees the typed unavailable. Every custody assertion goes\n85|// through this helper, so the wrapper direction of the absence split\n86|// is measured here, not in prose.\n87|func requireLocalError(t *testing.T, err error, code, detail string) {\n88|\tt.Helper()\n89|\tif err == nil {\n90|\t\tt.Fatalf(\"err = nil, want %s at %s\", code, detail)\n91|\t}\n92|\tlocal, ok := err.(*Error)\n93|\tif !ok {\n94|\t\tt.Fatalf(\"err top-level type = %T (%v), want *tmuxserver.Error\", err, err)\n95|\t}\n96|\tvar wrapped *axerror.Error\n97|\tif errors.As(err, &wrapped) {\n98|\t\tt.Fatalf(\"err wraps *axerror.Error (%v), want a bare *tmuxserver.Error\", err)\n99|\t}\n100|\tif local.Code != code || local.Detail != detail {\n101|\t\tt.Fatalf(\"err = %s at %s, want %s at %s\", local.Code, local.Detail, code, detail)\n102|\t}\n103|}\n104|\n105|func requireCapabilityUnavailable(t *testing.T, err error, caller, broker, generation, remedy string) {\n106|\tt.Helper()\n107|\tif err == nil {\n108|\t\tt.Fatal(\"err = nil, want capability_unavailable\")\n109|\t}\n110|\tvar failure *axerror.Error\n111|\tif !errors.As(err, &failure) {\n112|\t\tt.Fatalf(\"err type = %T (%v), want *axerror.Error\", err, err)\n113|\t}\n114|\tif string(failure.Code()) != \"capability_unavailable\" {\n115|\t\tt.Fatalf(\"code = %q, want %q\", string(failure.Code()), \"capability_unavailable\")\n116|\t}\n117|\tif failure.ExitCode() != 6 {\n118|\t\tt.Fatalf(\"exit = %d, want 6\", failure.ExitCode())\n119|\t}\n120|\twant := map[string]string{\n121|\t\t\"capability\":             \"credential_capable_execution_realm\",\n122|\t\t\"caller_realm\":           caller,\n123|\t\t\"broker_state\":           broker,\n124|\t\t\"tmux_server_generation\": generation,\n125|\t\t\"remediation\":            remedy,\n126|\t}\n127|\tfor key, value := range want {\n128|\t\tgot, ok := failure.Detail(key)\n129|\t\tif !ok {\n130|\t\t\tt.Fatalf(\"missing typed detail %q\", key)\n131|\t\t}\n132|\t\tif got != value {\n133|\t\t\tt.Fatalf(\"detail %q = %v, want %q\", key, got, value)\n134|\t\t}\n135|\t}\n136|}\n137|\n138|type spawnSpy struct {\n139|\tcalls  int\n140|\tsocket string\n141|\targv   []string\n142|\terr    error\n143|}\n144|\n145|func (spy *spawnSpy) spawn(socket string, argv []string) error {\n146|\tspy.calls++\n147|\tspy.socket = socket\n148|\tspy.argv = append([]string(nil), argv...)\n149|\treturn spy.err\n150|}\n151|\n152|func runtimeRoot(t *testing.T) string {\n153|\tt.Helper()\n154|\troot := t.TempDir()\n155|\tif err := os.Chmod(root, 0o755); err != nil {\n156|\t\tt.Fatal(err)\n157|\t}\n158|\treturn root\n159|}\n160|\n161|func runtimeDir(t *testing.T, root string) string {\n162|\tt.Helper()\n163|\tdir, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n164|\tif err != nil {\n165|\t\tt.Fatal(err)\n166|\t}\n167|\treturn dir\n168|}\n169|\n170|// The derived path is the path the specification mandates: pinned\n171|// SPEC 806-807 selects the dedicated server by\n172|// `tmux -S <runtime>/tmux/ax.sock`. Both leaves are asserted as spec\n173|// literals plus the joined form, so a renamed constant reddens here.\n174|func TestSocketPathDerivesOnlyFromRuntimeDir(t *testing.T) {\n175|\tif RuntimeDirName != \"tmux\" {\n176|\t\tt.Fatalf(\"RuntimeDirName = %q, want the SPEC 806-808 leaf %q\", RuntimeDirName, \"tmux\")\n177|\t}\n178|\tif SocketName != \"ax.sock\" {\n179|\t\tt.Fatalf(\"SocketName = %q, want the SPEC 806-807 leaf %q\", SocketName, \"ax.sock\")\n180|\t}\n181|\troot := t.TempDir()\n182|\tdir := filepath.Join(root, RuntimeDirName)\n183|\tif got := SocketPath(dir); got != filepath.Join(root, \"tmux\", \"ax.sock\") {\n184|\t\tt.Fatalf(\"SocketPath = %q, want <root>/tmux/ax.sock\", got)\n185|\t}\n186|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5d3","stream":{"kind":"session","id":"01a0c4fd-996a-7423-ba27-e5daf29de5a2"},"sequence":324,"recorded_at":1780531400000643,"record_type":"event","durability":"durable","causation_id":"e01e1bc2-95c9-4151-a1a6-6ebbbbe18d95","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e01e1bc2-95c9-4151-a1a6-6ebbbbe18d95","run_stream":{"kind":"run","id":"e01e1bc2-95c9-4151-a1a6-6ebbbbe18d95"},"call_id":"call_01a0c5041ced7286b977dacaeea2c23f","text":"Read text file `internal/tmuxserver/readiness_test.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"testing\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n7|)\n8|\n9|func TestCheckServerAttestedAdmitsBound(t *testing.T) {\n10|\tif err := CheckServerAttested(boundAdmission(), fixtureGeneration); err != nil {\n11|\t\tt.Fatal(err)\n12|\t}\n13|}\n14|\n15|func TestCheckServerAttestedRefusesEachMissingConjunct(t *testing.T) {\n16|\tfor _, tc := range []struct {\n17|\t\tname      string\n18|\t\tadmission RealmAdmission\n19|\t\twant      string\n20|\t\tdetail    string\n21|\t}{\n22|\t\t{\"no admission rows\", RealmAdmission{RawGeneration: fixtureGeneration}, fixtureGeneration, \"server attestation\"},\n23|\t\t{\"decoy capability only\", RealmAdmission{\n24|\t\t\tAdmitted:      terminalbackend.Admitted{Capabilities: []string{fixtureDecoyCapacity}},\n25|\t\t\tRawGeneration: fixtureGeneration,\n26|\t\t}, fixtureGeneration, \"server attestation\"},\n27|\t\t{\"stale generation admission\", staleAdmission(), fixtureGeneration, \"server generation\"},\n28|\t\t{\"empty raw generation\", RealmAdmission{Admitted: realmAdmitted()}, fixtureGeneration, \"server generation\"},\n29|\t\t{\"empty wanted generation\", boundAdmission(), \"\", \"server generation\"},\n30|\t\t{\"both generations empty\", RealmAdmission{Admitted: realmAdmitted()}, \"\", \"server generation\"},\n31|\t} {\n32|\t\tt.Run(tc.name, func(t *testing.T) {\n33|\t\t\trequireLocalError(t, CheckServerAttested(tc.admission, tc.want), \"tmux_readiness_not_authorizing\", tc.detail)\n34|\t\t})\n35|\t}\n36|}\n37|\n38|func TestCheckBrokerContactAdmitsLiveReport(t *testing.T) {\n39|\tif err := CheckBrokerContact(brokerReport(), fixtureGeneration, currentUID()); err != nil {\n40|\t\tt.Fatal(err)\n41|\t}\n42|}\n43|\n44|func TestCheckBrokerContactRefusesEachMissingFact(t *testing.T) {\n45|\tlive := brokerReport()\n46|\tfor _, tc := range []struct {\n47|\t\tname   string\n48|\t\treport BrokerReport\n49|\t\twant   string\n50|\t\tdetail string\n51|\t}{\n52|\t\t{\"no broker\", BrokerReport{}, fixtureGeneration, \"broker authentication\"},\n53|\t\t{\"foreign-user broker\", BrokerReport{\n54|\t\t\tPrincipal: BrokerPrincipal{UID: foreignUID(), Generation: fixtureGeneration},\n55|\t\t\tServer:    boundAdmission(),\n56|\t\t}, fixtureGeneration, \"broker authentication\"},\n57|\t\t{\"generation-unbound principal\", BrokerReport{\n58|\t\t\tPrincipal: BrokerPrincipal{UID: live.Principal.UID, Generation: fixtureStaleGen},\n59|\t\t\tServer:    boundAdmission(),\n60|\t\t}, fixtureGeneration, \"broker generation\"},\n61|\t\t{\"empty principal generation\", BrokerReport{\n62|\t\t\tPrincipal: BrokerPrincipal{UID: live.Principal.UID},\n63|\t\t\tServer:    boundAdmission(),\n64|\t\t}, fixtureGeneration, \"broker generation\"},\n65|\t\t{\"both generations empty\", BrokerReport{\n66|\t\t\tPrincipal: BrokerPrincipal{UID: live.Principal.UID},\n67|\t\t\tServer:    RealmAdmission{Admitted: realmAdmitted()},\n68|\t\t}, \"\", \"broker generation\"},\n69|\t\t{\"unattested server\", BrokerReport{\n70|\t\t\tPrincipal: live.Principal,\n71|\t\t\tServer:    RealmAdmission{RawGeneration: fixtureGeneration},\n72|\t\t}, fixtureGeneration, \"server attestation\"},\n73|\t\t{\"stale server admission\", BrokerReport{\n74|\t\t\tPrincipal: live.Principal,\n75|\t\t\tServer:    staleAdmission(),\n76|\t\t}, fixtureGeneration, \"server generation\"},\n77|\t} {\n78|\t\tt.Run(tc.name, func(t *testing.T) {\n79|\t\t\trequireLocalError(t, CheckBrokerContact(tc.report, tc.want, currentUID()), \"tmux_readiness_not_authorizing\", tc.detail)\n80|\t\t})\n81|\t}\n82|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
