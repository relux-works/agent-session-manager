(\n453|        name=\"N-probe-swallow-background\",\n454|        path=f\"{PACKAGE}/acquire.go\",\n455|        find=\"\\tstatus, err := req.Deps.ProbeBroker()\\n\\tif err != nil {\\n\",\n456|        replace='\\tstatus, err := req.Deps.ProbeBroker()\\n\\tif err != nil && err.Error() != \"probe boom\" {\\n',\n457|        count=1,\n458|        run=\"TestAcquireBackgroundProbeFailurePassesThrough\",\n459|        expect=\"KILLED\",\n460|        note=\"Admits exactly the fixture probe failure as a broker miss (then reports unavailable); every other probe failure still passes through.\",\n461|    ),\n462|    Mutant(\n463|        name=\"N-argv-socket\",\n464|        path=f\"{PACKAGE}/argv.go\",\n465|        find=\"\\tif socket != SocketPath(runtimeDir) {\\n\",\n466|        replace='\\tif socket != SocketPath(runtimeDir) && socket != \"/tmp/tmux-501/default\" {\\n',\n467|        count=1,\n468|        run=\"TestBuildArgvRefusesAmbientSocket\",\n469|        expect=\"KILLED\",\n470|        note=\"Admits exactly the default path at the spawn-socket arm; every other ambient socket still refuses.\",\n471|    ),\n472|    Mutant(\n473|        name=\"N-argv-tmuxenv\",\n474|        path=f\"{PACKAGE}/argv.go\",\n475|        find=\"\\tif socket != SocketPath(runtimeDir) {\\n\",\n476|        replace='\\tif socket != SocketPath(runtimeDir) && socket != \"/tmp/tmux-501/default,12345,0\" {\\n',\n477|        count=1,\n478|        run=\"TestBuildArgvRefusesAmbientSocket/tmux_env_value\",\n479|        expect=\"KILLED\",\n480|        note=\"Admits exactly the TMUX environment value at the spawn-socket arm; every other ambient socket still refuses.\",\n481|    ),\n482|    Mutant(\n483|        name=\"N-argv-shape\",\n484|        path=f\"{PACKAGE}/argv.go\",\n485|        find=\"\\tif err := secprim.CheckArgv(argv); err != nil {\\n\",\n486|        replace='\\tif err := secprim.CheckArgv(argv); err != nil && argv[0] != \"tmux\" {\\n',\n487|        count=1,\n488|        run=\"TestBuildArgvRefusesInvalidArgvShape\",\n489|        expect=\"KILLED\",\n490|        note=\"Admits exactly our tmux-headed spawn vector past the landed shape wiring; any other vector still refuses. Other failing shapes are unstageable through the fixed-shape builder and are disclosed, not pinned.\",\n491|    ),\n492|    Mutant(\n493|        name=\"N-argv-session\",\n494|        path=f\"{PACKAGE}/argv.go\",\n495|        find=\"\\tsession, err := scalar.ParseUUIDv7(sessionID)\\n\\tif err != nil {\\n\",\n496|        replace='\\tsession, err := scalar.ParseUUIDv7(sessionID)\\n\\tif err != nil && sessionID != \"12345\" {\\n',\n497|        count=1,\n498|        run=\"(TestBuildArgvRefusesMalformedSession|TestAcquireForegroundRefusesMalformedSession)\",\n499|        expect=\"KILLED\",\n500|        note=\"Admits exactly the PID-form session past our wiring of the landed UUIDv7 grammar; every other malformed session still refuses.\",\n501|    ),\n502|    Mutant(\n503|        name=\"N-deps-background\",\n504|        path=f\"{PACKAGE}/acquire.go\",\n505|        find=\"\\tif req.Deps.ProbeBroker == nil {\\n\",\n506|        replace=\"\\tif req.Deps.ProbeBroker == nil && req.Deps.Spawn == nil {\\n\",\n507|        count=1,\n508|        run=\"TestAcquireBackgroundNilBrokerWithSpawnRefuses\",\n509|        expect=\"KILLED\",\n510|        note=\"Admits exactly the nil-probe-with-spawn background request past the dependencies arm; the fully-nil request still refuses. Kill path: the admitted request reaches Verify on the absent leaf and reports the typed unavailable instead of the dependencies code.\",\n511|    ),\n512|    Mutant(\n513|        name=\"N-deps-foreground\",\n514|        path=f\"{PACKAGE}/acquire.go\",\n515|        find=\"\\tif req.Deps.ProbeServer == nil || req.Deps.Spawn == nil {\\n\",\n516|        replace=\"\\tif req.Deps.ProbeServer == nil && req.Deps.Spawn == nil {\\n\",\n517|        count=1,\n518|        run=\"TestAcquireForegroundNilSpawnWithProbeRefuses\",\n519|        expect=\"KILLED\",\n520|        note=\"Admits exactly the half-nil foreground dependencies past the arm; fully-nil dependencies still refuse. Kill path: the admitted request panics on the nil spawn, and the panic fails the test.\",\n521|    ),\n522|    Mutant(\n523|        name=\"N-running-empty-admission\",\n524|        path=f\"{PACKAGE}/acquire.go\",\n525|        find=\"\\tif report.Running {\\n\",\n526|        replace=\"\\tif report.Running && len(report.Admission.Admitted.Capabilities) > 0 {\\n\",\n527|        count=1,\n528|        run=\"TestAcquireForegroundRefusesRunningWithEmptyAdmission\",\n529|        expect=\"KILLED\",\n530|        note=\"Admits exactly running servers with zero admission rows past the Running arm (they are treated as absent and spawned into); running servers with admission data still attach-or-refuse. Kill path: a second new-session spawns into the live server.\",\n531|    ),\n532|    Mutant(\n533|        name=\"N-running-empty-generation\",\n534|        path=f\"{PACKAGE}/acquire.go\",\n535|        find=\"\\tif report.Running {\\n\",\n536|        replace='\\tif report.Running && report.Admission.RawGeneration != \"\" {\\n',\n537|        count=1,\n538|        run=\"TestAcquireForegroundRefusesRunningWithEmptyGeneration\",\n539|        expect=\"KILLED\",\n540|        note=\"Admits exactly running servers whose admission carries no generation past the Running arm; running servers with a generation still attach-or-refuse. Kill path: a second new-session spawns into the live server.\",\n541|    ),\n542|    Mutant(\n543|        name=\"N-verify-absence-detail\",\n544|        path=f\"{PACKAGE}/runtime_unix.go\",\n545|        find='\\tif err != nil {\\n\\t\\tif errors.Is(err, unix.ENOENT) {\\n\\t\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime absent\"}\\n\\t\\t}\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\\n\\t}\\n',\n546|        replace='\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\\n\\t}\\n',\n547|        count=1,\n548|        run=\"(TestVerifyRuntimeDirRefusesAbsence|TestAcquireBackgroundVerifiesWithoutCreating)\",\n549|        expect=\"KILLED\",\n550|        note=\"Admits exactly absent leaves past the absence detail (they report containment like an unsafe leaf); ENOTDIR/ELOOP and every other leaf failure still refuse containment. Narrowing, not a delete: the refusal stays, only the ENOENT arm is dropped. Kill paths: the Verify detail mismatch, and the background reroute to the custody code instead of the typed unavailable.\",\n551|    ),\n552|    Mutant(\n553|        name=\"N-background-absence-remap\",\n554|        path=f\"{PACKAGE}/acquire.go\",\n555|        find=\"\\tif runtimeAbsent(verr) {\\n\",\n556|        replace=\"\\tif runtimeAbsent(verr) && req.Platform != scalar.PlatformMacOS {\\n\",\n557|        count=1,\n558|        run=\"TestAcquireBackgroundVerifiesWithoutCreating\",\n559|        expect=\"KILLED\",\n560|        note=\"Admits exactly macOS absences past the unavailable remap (they return the custody code); absences on Linux/WSL2 still map. Kill path: the macOS background cold state reports tmux_unsafe_runtime_dir instead of capability_unavailable.\",\n561|    ),\n562|    Mutant(\n563|        name=\"N-absence-remap-widen\",\n564|        path=f\"{PACKAGE}/acquire.go\",\n565|        find='\\treturn local.Code == CodeUnsafeRuntimeDir && local.Detail == \"runtime absent\"\\n',\n566|        replace='\\treturn local.Code == CodeUnsafeRuntimeDir && (local.Detail == \"runtime absent\" || local.Detail == \"runtime mode\")\\n',\n567|        count=1,\n568|        run=\"TestAcquireBackgroundStagesVerifyCustodyRefusal\",\n569|        expect=\"KILLED\",\n570|        note=\"Admits exactly mode refusals past the absence classifier (a widened leaf maps to capability_unavailable with the custody refusal hidden as its redacted cause); absence still maps and every other unsafe-leaf refusal keeps its custody code. Kill path: the background custody test asserts the top-level *Error the caller renders.\",\n571|    ),\n572|    Mutant(\n573|        name=\"N-collision-tmuxenv-encoding\",\n574|        path=f\"{PACKAGE}/socket.go\",\n575|        find=\"\\tif i := strings.IndexByte(value, ','); i >= 0 {\\n\\t\\treturn value[:i]\\n\\t}\\n\",\n576|        replace=\"\\tif i := strings.IndexByte(value, ','); i >= 0 {\\n\\t\\treturn value\\n\\t}\\n\",\n577|        count=1,\n578|        run=\"(TestResolveSocketRefusesTMUXEnvRealEncoding|TestAcquireRefusesTMUXEnvCollisionRealEncoding)\",\n579|        expect=\"KILLED\",\n580|        note=\"Admits exactly TMUX values in the real <socket>,<pid>,<index> encoding past the socket-component arm; bare TMUX values still refuse byte-identical. Narrowing: the collision gate stays, only the component split is dropped.\",\n581|    ),\n582|    Mutant(\n583|        name=\"N-commit-eacces-as-exist\",\n584|        path=f\"{PACKAGE}/runtime_unix.go\",\n585|        find=\"\\tif !errors.Is(err, unix.EEXIST) {\\n\",\n586|        replace=\"\\tif !errors.Is(err, unix.EEXIST) && !errors.Is(err, unix.EACCES) {\\n\",\n587|        count=1,\n588|        run=\"TestEnsureRuntimeDirRefusesReadOnlyRoot\",\n589|        expect=\"KILLED\",\n590|        note=\"Admits exactly EACCES past the exists-check (a permission failure is treated as an existing leaf); every other mkdir failure still reports the commit detail. Kill reroutes to the runtime-absent refusal — still fail-closed, hence a detail mismatch, not an admission.\",\n591|    ),\n592|    Mutant(\n593|        name=\"N-override-whitespace\",\n594|        path=f\"{PACKAGE}/socket.go\",\n595|        find='\\tif override != \"\" {\\n',\n596|        replace='\\tif override != \"\" && override != \"  \" {\\n',\n597|        count=1,\n598|        run=f\"{OVERRIDE}/whitespace_only\",\n599|        expect=\"KILLED\",\n600|        note=\"Admits exactly the two-space override past the non-empty arm; every other override still refuses. Kill path: the admitted request proceeds to spawn instead of refusing.\",\n601|    ),\n602|    Mutant(\n603|        name=\"N-root-missing-classify\",\n604|        path=f\"{PACKAGE}/runtime_unix.go\",\n605|        find='func classifyRootOpenError(err error) error {\\n\\tif os.IsNotExist(err) || errors.Is(err, os.ErrNotExist) {\\n\\t\\treturn &Error{Code: CodeInvalidArguments, Detail: \"runtime root\"}\\n\\t}\\n\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\\n}\\n',\n606|        replace='func classifyRootOpenError(err error) error {\\n\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\\n}\\n',\n607|        count=1,\n608|        run=\"(TestEnsureRuntimeDirRefusesBadRoots|TestVerifyRuntimeDirRefusesMissingRoot)\",\n609|        expect=\"KILLED\",\n610|        note=\"Admits exactly missing roots past the shared invalid-arguments mapping (they report containment); every other root-open failure still refuses containment. One site, both entries: killed by the missing-root tests on the commit and verify sides.\",\n611|    ),\n612|    Mutant(\n613|        name=\"D-background-fallback\",\n614|        path=f\"{PACKAGE}/acquire.go\",\n615|        find=\"\\t\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\n\\t\\t\\treturn Outcome{}, backgroundUnavailable(req, err)\\n\\t\\t}\\n\",\n616|        replace=\"\\t\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\n\\t\\t\\tif req.Deps.Spawn != nil {\\n\\t\\t\\t\\t_ = req.Deps.Spawn(socket, nil)\\n\\t\\t\\t}\\n\\t\\t\\treturn Outcome{}, backgroundUnavailable(req, err)\\n\\t\\t}\\n\",\n617|        count=1,\n618|        run=BG_MISS_LINUX,\n619|        expect=\"KILLED\",\n620|        note=\"SUPPLEMENTARY ADDITIVE, not a narrowing: plants the reviewer-shaped direct-creation call on the background miss path. Kill path: every background-miss spy asserts zero spawn calls.\",\n621|    ),\n622|    Mutant(\n623|        name=\"C-control\",\n624|        path=f\"{PACKAGE}/errors.go\",\n625|        find=\"// Error is a package-local refusal. Code is one of the Code*\",\n626|        replace=\"// Error is a package-local refusal (harness control: comment-only). Code is one of the Code*\",\n627|        count=1,\n628|        run=\"TestSocketPathDerivesOnlyFromRuntimeDir\",\n629|        expect=\"SURVIVED\",\n630|        note=\"Harmless control: a comment-only edit that must SURVIVE, proving the harness observes outcomes.\",\n631|    ),\n632|]\n633|\n634|\n635|def apply(mutant: Mutant, original: str) -> str:\n636|    return original.replace(mutant.find, mutant.replace)\n637|\n638|\n639|def run_mutant(mutant: Mutant, log_dir: Path | None) -> str:\n640|    target = REPO / mutant.path\n641|    original = target.read_text()\n642|    found = original.count(mutant.find)\n643|    if found != mutant.count:\n644|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\"\n645|    with tempfile.TemporaryDirectory() as staging:\n646|        backup = Path(staging) / \"backup\"\n647|        shutil.copy2(target, backup)\n648|        try:\n649|            target.write_text(apply(mutant, original))\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
