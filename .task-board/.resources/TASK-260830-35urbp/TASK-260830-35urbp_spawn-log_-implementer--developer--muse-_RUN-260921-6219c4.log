{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c57d","stream":{"kind":"session","id":"01a0c4fd-996a-7423-ba27-e5daf29de5a2"},"sequence":281,"recorded_at":1780531400000557,"record_type":"event","durability":"durable","causation_id":"e01e1bc2-95c9-4151-a1a6-6ebbbbe18d95","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e01e1bc2-95c9-4151-a1a6-6ebbbbe18d95","run_stream":{"kind":"run","id":"e01e1bc2-95c9-4151-a1a6-6ebbbbe18d95"},"call_id":"call_01a0c50406f0712ca164115ea9c701e5","text":"Read text file `internal/tmuxserver/acquire_test.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n11|)\n12|\n13|var errProbeBoom = errors.New(\"probe boom\")\n14|\n15|func TestAcquireForegroundSpawnsDedicatedServer(t *testing.T) {\n16|\troot := runtimeRoot(t)\n17|\treq := validRequest(t, root)\n18|\treq.Ambient = hostileAmbient()\n19|\tspy := &spawnSpy{}\n20|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n21|\t\treturn ServerReport{}, nil\n22|\t}\n23|\treq.Deps.Spawn = spy.spawn\n24|\toutcome, err := Acquire(req)\n25|\tif err != nil {\n26|\t\tt.Fatal(err)\n27|\t}\n28|\tif outcome.Via != \"spawned\" {\n29|\t\tt.Fatalf(\"via = %q, want spawned\", outcome.Via)\n30|\t}\n31|\tif outcome.Socket != SocketPath(filepath.Join(root, RuntimeDirName)) {\n32|\t\tt.Fatalf(\"socket = %q\", outcome.Socket)\n33|\t}\n34|\tif spy.calls != 1 || spy.socket != outcome.Socket {\n35|\t\tt.Fatalf(\"spawn calls = %d socket = %q\", spy.calls, spy.socket)\n36|\t}\n37|\tif len(spy.argv) < 3 || spy.argv[0] != \"tmux\" || spy.argv[1] != \"-S\" || spy.argv[2] != outcome.Socket {\n38|\t\tt.Fatalf(\"spawn argv = %q\", spy.argv)\n39|\t}\n40|\tfor i, ambient := range []string{req.Ambient.TMUXEnv, req.Ambient.TMUXTmpDir, req.Ambient.InheritedSocket, req.Ambient.DefaultPath, req.Ambient.ConventionalName} {\n41|\t\tif ambient == \"\" {\n42|\t\t\tcontinue\n43|\t\t}\n44|\t\tif outcome.Socket == ambient {\n45|\t\t\tt.Fatalf(\"socket reuses ambient vector %d\", i)\n46|\t\t}\n47|\t\tfor _, arg := range spy.argv {\n48|\t\t\tif arg == ambient {\n49|\t\t\t\tt.Fatalf(\"argv carries ambient vector %d: %q\", i, arg)\n50|\t\t\t}\n51|\t\t}\n52|\t}\n53|\twantTail := []string{\"ax\", \"pane\", fixtureSession}\n54|\ttail := spy.argv[len(spy.argv)-3:]\n55|\tfor i := range wantTail {\n56|\t\tif tail[i] != wantTail[i] {\n57|\t\t\tt.Fatalf(\"argv tail = %q, want %q\", tail, wantTail)\n58|\t\t}\n59|\t}\n60|}\n61|\n62|func socketDir(t *testing.T, root string) string {\n63|\tt.Helper()\n64|\treturn runtimeDir(t, root)\n65|}\n66|\n67|func TestAcquireForegroundAttachesToRunningAttested(t *testing.T) {\n68|\troot := runtimeRoot(t)\n69|\treq := validRequest(t, root)\n70|\tspy := &spawnSpy{}\n71|\tprobed := \"\"\n72|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n73|\t\tprobed = socket\n74|\t\treturn ServerReport{Running: true, Admission: boundAdmission()}, nil\n75|\t}\n76|\treq.Deps.Spawn = spy.spawn\n77|\toutcome, err := Acquire(req)\n78|\tif err != nil {\n79|\t\tt.Fatal(err)\n80|\t}\n81|\tif outcome.Via != \"attached-running\" {\n82|\t\tt.Fatalf(\"via = %q\", outcome.Via)\n83|\t}\n84|\tif probed != outcome.Socket || outcome.Socket != SocketPath(socketDir(t, root)) {\n85|\t\tt.Fatalf(\"probed = %q socket = %q\", probed, outcome.Socket)\n86|\t}\n87|\tif spy.calls != 0 {\n88|\t\tt.Fatalf(\"spawn calls = %d, want 0 on attach\", spy.calls)\n89|\t}\n90|}\n91|\n92|func TestAcquireForegroundRefusesRunningUnattested(t *testing.T) {\n93|\troot := runtimeRoot(t)\n94|\treq := validRequest(t, root)\n95|\tspy := &spawnSpy{}\n96|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n97|\t\treturn ServerReport{Running: true, Admission: RealmAdmission{\n98|\t\t\tAdmitted:      terminalbackend.Admitted{Capabilities: []string{fixtureDecoyCapacity}},\n99|\t\t\tRawGeneration: fixtureGeneration,\n100|\t\t}}, nil\n101|\t}\n102|\treq.Deps.Spawn = spy.spawn\n103|\t_, err := Acquire(req)\n104|\trequireLocalError(t, err, \"tmux_readiness_not_authorizing\", \"server attestation\")\n105|\tif spy.calls != 0 {\n106|\t\tt.Fatalf(\"spawn calls = %d, want 0 on unattested\", spy.calls)\n107|\t}\n108|}\n109|\n110|// A stale admission — yesterday's live proof replayed against today's\n111|// typed generation — fakes no running attested server: attach refuses\n112|// on the generation arm with no spawn and no repair.\n113|func TestAcquireForegroundRefusesWrongGenerationAdmission(t *testing.T) {\n114|\troot := runtimeRoot(t)\n115|\treq := validRequest(t, root)\n116|\tspy := &spawnSpy{}\n117|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n118|\t\treturn ServerReport{Running: true, Admission: staleAdmission()}, nil\n119|\t}\n120|\treq.Deps.Spawn = spy.spawn\n121|\t_, err := Acquire(req)\n122|\trequireLocalError(t, err, \"tmux_readiness_not_authorizing\", \"server generation\")\n123|\tif spy.calls != 0 {\n124|\t\tt.Fatalf(\"spawn calls = %d, want 0 on stale admission\", spy.calls)\n125|\t}\n126|}\n127|\n128|// The realistic post-spawn state — the server runs, no evidence has\n129|// been reconciled yet, the admission carries nothing — refuses\n130|// through the entry with no second spawn: a running server with zero\n131|// admission rows is still running, never absent.\n132|func TestAcquireForegroundRefusesRunningWithEmptyAdmission(t *testing.T) {\n133|\troot := runtimeRoot(t)\n134|\treq := validRequest(t, root)\n135|\tspy := &spawnSpy{}\n136|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n137|\t\treturn ServerReport{Running: true, Admission: RealmAdmission{}}, nil\n138|\t}\n139|\treq.Deps.Spawn = spy.spawn\n140|\t_, err := Acquire(req)\n141|\trequireLocalError(t, err, \"tmux_readiness_not_authorizing\", \"server attestation\")\n142|\tif spy.calls != 0 {\n143|\t\tt.Fatalf(\"spawn calls = %d, want 0 on a running server\", spy.calls)\n144|\t}\n145|}\n146|\n147|// Same rule one member over: a running server whose admission\n148|// carries the realm row but no generation refuses on the generation\n149|// arm through the entry with no second spawn.\n150|func TestAcquireForegroundRefusesRunningWithEmptyGeneration(t *testing.T) {\n151|\troot := runtimeRoot(t)\n152|\treq := validRequest(t, root)\n153|\tspy := &spawnSpy{}\n154|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n155|\t\treturn ServerReport{Running: true, Admission: RealmAdmission{\n156|\t\t\tAdmitted: realmAdmitted(),\n157|\t\t}}, nil\n158|\t}\n159|\treq.Deps.Spawn = spy.spawn\n160|\t_, err := Acquire(req)\n161|\trequireLocalError(t, err, \"tmux_readiness_not_authorizing\", \"server generation\")\n162|\tif spy.calls != 0 {\n163|\t\tt.Fatalf(\"spawn calls = %d, want 0 on a running server\", spy.calls)\n164|\t}\n165|}\n166|\n167|func TestAcquireForegroundProbeFailurePassesThrough(t *testing.T) {\n168|\troot := runtimeRoot(t)\n169|\treq := validRequest(t, root)\n170|\tspy := &spawnSpy{}\n171|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n172|\t\treturn ServerReport{}, errProbeBoom\n173|\t}\n174|\treq.Deps.Spawn = spy.spawn\n175|\t_, err := Acquire(req)\n176|\tif !errors.Is(err, errProbeBoom) {\n177|\t\tt.Fatalf(\"err = %v, want the probe failure\", err)\n178|\t}\n179|\tif spy.calls != 0 {\n180|\t\tt.Fatalf(\"spawn calls = %d, want 0 on unknown\", spy.calls)\n181|\t}\n182|}\n183|\n184|func TestAcquireForegroundSpawnFailureReportsWithoutFallback(t *testing.T) {\n185|\troot := runtimeRoot(t)\n186|\treq := validRequest(t, root)\n187|\tspy := &spawnSpy{err: errors.New(\"exec failed\")}\n188|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n189|\t\treturn ServerReport{}, nil\n190|\t}\n191|\treq.Deps.Spawn = spy.spawn\n192|\t_, err := Acquire(req)\n193|\trequireLocalError(t, err, \"tmux_server_spawn_failed\", \"server spawn\")\n194|\tif spy.calls != 1 {\n195|\t\tt.Fatalf(\"spawn calls = %d, want exactly 1\", spy.calls)\n196|\t}\n197|}\n198|\n199|func TestAcquireForegroundRefusesMalformedSession(t *testing.T) {\n200|\troot := runtimeRoot(t)\n201|\treq := validRequest(t, root)\n202|\treq.SessionID = \"12345\"\n203|\tspy := &spawnSpy{}\n204|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n205|\t\treturn ServerReport{}, nil\n206|\t}\n207|\treq.Deps.Spawn = spy.spawn\n208|\t_, err := Acquire(req)\n209|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"session identity\")\n210|\tif spy.calls != 0 {\n211|\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n212|\t}\n213|}\n214|\n215|func TestAcquireBackgroundContactsBroker(t *testing.T) {\n216|\troot := runtimeRoot(t)\n217|\truntimeDir(t, root)\n218|\treq := validRequest(t, root)\n219|\treq.Caller = CallerBackground\n220|\treq.Platform = scalar.PlatformMacOS\n221|\tspy := &spawnSpy{}\n222|\tprobed := false\n223|\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n224|\t\tprobed = true\n225|\t\treturn brokerReport(), nil\n226|\t}\n227|\treq.Deps.Spawn = spy.spawn\n228|\toutcome, err := Acquire(req)\n229|\tif err != nil {\n230|\t\tt.Fatal(err)\n231|\t}\n232|\tif !probed {\n233|\t\tt.Fatal(\"broker was not probed\")\n234|\t}\n235|\tif outcome.Via != \"broker\" {\n236|\t\tt.Fatalf(\"via = %q\", outcome.Via)\n237|\t}\n238|\tif outcome.Socket != SocketPath(socketDir(t, root)) {\n239|\t\tt.Fatalf(\"socket = %q\", outcome.Socket)\n240|\t}\n241|\tif len(outcome.Argv) != 0 {\n242|\t\tt.Fatalf(\"broker outcome carries argv %q\", outcome.Argv)\n243|\t}\n244|\tif spy.calls != 0 {\n245|\t\tt.Fatalf(\"spawn calls = %d, want 0 on broker contact\", spy.calls)\n246|\t}\n247|}\n248|\n249|func TestAcquireBackgroundMissReturnsTypedUnavailable(t *testing.T) {\n250|\tlive := brokerReport()\n251|\tfor _, tc := range []struct {\n252|\t\tname   string\n253|\t\treport BrokerReport\n254|\t}{\n255|\t\t{\"no broker\", BrokerReport{}},\n256|\t\t{\"foreign-user broker\", BrokerReport{\n257|\t\t\tPrincipal: BrokerPrincipal{UID: foreignUID(), Generation: fixtureGeneration},\n258|\t\t\tServer:    boundAdmission(),\n259|\t\t}},\n260|\t\t{\"generation-unbound principal\", BrokerReport{\n261|\t\t\tPrincipal: BrokerPrincipal{UID: live.Principal.UID, Generation: fixtureStaleGen},\n262|\t\t\tServer:    boundAdmission(),\n263|\t\t}},\n264|\t\t{\"unattested server\", BrokerReport{\n265|\t\t\tPrincipal: live.Principal,\n266|\t\t\tServer:    RealmAdmission{RawGeneration: fixtureGeneration},\n267|\t\t}},\n268|\t\t{\"stale server admission\", BrokerReport{\n269|\t\t\tPrincipal: live.Principal,\n270|\t\t\tServer:    staleAdmission(),\n271|\t\t}},\n272|\t} {\n273|\t\tt.Run(tc.name, func(t *testing.T) {\n274|\t\t\troot := runtimeRoot(t)\n275|\t\t\truntimeDir(t, root)\n276|\t\t\treq := validRequest(t, root)\n277|\t\t\treq.Caller = CallerBackground\n278|\t\t\treq.Platform = scalar.PlatformMacOS\n279|\t\t\tspy := &spawnSpy{}\n280|\t\t\t// Even a spawner that would succeed must never run:\n281|\t\t\t// the miss path has no fallback to direct creation.\n282|\t\t\treq.Deps.Spawn = spy.spawn\n283|\t\t\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n284|\t\t\t\treturn tc.report, nil\n285|\t\t\t}\n286|\t\t\t_, err := Acquire(req)\n287|\t\t\trequireCapabilityUnavailable(t, err, \"background\", fixtureBroker, fixtureGeneration, fixtureRemedy)\n288|\t\t\tif spy.calls != 0 {\n289|\t\t\t\tt.Fatalf(\"spawn calls = %d, want 0 without fallback\", spy.calls)\n290|\t\t\t}\n291|\t\t})\n292|\t}\n293|}\n294|\n295|func TestAcquireBackgroundMissOnLinuxAlsoRefusesWithoutFallback(t *testing.T) {\n296|\troot := runtimeRoot(t)\n297|\truntimeDir(t, root)\n298|\treq := validRequest(t, root)\n299|\treq.Caller = CallerBackground\n300|\treq.Platform = scalar.PlatformLinux\n301|\tspy := &spawnSpy{}\n302|\treq.Deps.Spawn = spy.spawn\n303|\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n304|\t\treturn BrokerReport{}, nil\n305|\t}\n306|\t_, err := Acquire(req)\n307|\trequireCapabilityUnavailable(t, err, \"background\", fixtureBroker, fixtureGeneration, fixtureRemedy)\n308|\tif spy.calls != 0 {\n309|\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n310|\t}\n311|}\n312|\n313|// Background acquisition verifies the runtime directory instead of\n314|// creating it. A missing leaf is the ordinary post-reboot cold\n315|// state — the Runtime IPC root is a per-user temporary directory —\n316|// so absence returns the typed capability_unavailable with the\n317|// request's realm/readiness details, and the refusal probes no\n318|// broker, spawns nothing, and leaves no directory behind: a\n319|// background caller performs no durable write.\n320|func TestAcquireBackgroundVerifiesWithoutCreating(t *testing.T) {\n321|\t// The cold state is the same on every unix platform: $XDG_RUNTIME_DIR\n322|\t// is tmpfs on Linux/WSL2, so a background restore worker there meets\n323|\t// the absent leaf exactly like the macOS caller. Each platform maps\n324|\t// the absence to the typed unavailable — never the custody code.\n325|\tfor _, platform := range []scalar.Platform{scalar.PlatformMacOS, scalar.PlatformLinux, scalar.PlatformWSL2} {\n326|\t\tt.Run(string(platform), func(t *testing.T) {\n327|\t\t\troot := runtimeRoot(t)\n328|\t\t\treq := validRequest(t, root)\n329|\t\t\treq.Caller = CallerBackground\n330|\t\t\treq.Platform = platform\n331|\t\t\tprobed := false\n332|\t\t\tspy := &spawnSpy{}\n333|\t\t\treq.Deps.Spawn = spy.spawn\n334|\t\t\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n335|\t\t\t\tprobed = true\n336|\t\t\t\treturn brokerReport(), nil\n337|\t\t\t}\n338|\t\t\t_, err := Acquire(req)\n339|\t\t\trequireCapabilityUnavailable(t, err, \"background\", fixtureBroker, fixtureGeneration, fixtureRemedy)\n340|\t\t\tif probed {\n341|\t\t\t\tt.Fatal(\"broker was probed for an absent runtime directory\")\n342|\t\t\t}\n343|\t\t\tif spy.calls != 0 {\n344|\t\t\t\tt.Fatalf(\"spawn calls = %d, want 0 on absence\", spy.calls)\n345|\t\t\t}\n346|\t\t\tif _, statErr := os.Lstat(filepath.Join(root, RuntimeDirName)); !os.IsNotExist(statErr) {\n347|\t\t\t\tt.Fatalf(\"background refusal created the directory: stat err = %v\", statErr)\n348|\t\t\t}\n349|\t\t})\n350|\t}\n351|}\n352|\n353|// A missing runtime root is not a missing leaf: the root input names\n354|// nothing the leaf could live under, so the background path refuses\n355|// it as malformed input — the same code the commit side reports —\n356|// without probing the broker.\n357|func TestAcquireBackgroundMissingRootRefusesInvalid(t *testing.T) {\n358|\troot := filepath.Join(runtimeRoot(t), \"no-such-root\")\n359|\treq := validRequest(t, root)\n360|\treq.Caller = CallerBackground\n361|\tprobed := false\n362|\tspy := &spawnSpy{}\n363|\treq.Deps.Spawn = spy.spawn\n364|\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n365|\t\tprobed = true\n366|\t\treturn brokerReport(), nil\n367|\t}\n368|\t_, err := Acquire(req)\n369|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"runtime root\")\n370|\tif probed {\n371|\t\tt.Fatal(\"broker was probed past a missing root\")\n372|\t}\n373|\tif spy.calls != 0 {\n374|\t\tt.Fatalf(\"spawn calls = %d, want 0 past a missing root\", spy.calls)\n375|\t}\n376|}\n377|\n378|// The acquisition entry derives the spec's socket path on both caller\n379|// paths: the outcome socket equals <Root>/tmux/ax.sock with both leaves\n380|// asserted as spec literals — not via the production constants — so a\n381|// renamed constant or a caller-selectable leaf reddens here.\n382|func TestAcquireOutcomeSocketEqualsSpecPath(t *testing.T) {\n383|\tt.Run(\"foreground\", func(t *testing.T) {\n384|\t\troot := runtimeRoot(t)\n385|\t\treq := validRequest(t, root)\n386|\t\tspy := &spawnSpy{}\n387|\t\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n388|\t\t\treturn ServerReport{}, nil\n389|\t\t}\n390|\t\treq.Deps.Spawn = spy.spawn\n391|\t\toutcome, err := Acquire(req)\n392|\t\tif err != nil {\n393|\t\t\tt.Fatal(err)\n394|\t\t}\n395|\t\tif want := filepath.Join(root, \"tmux\", \"ax.sock\"); outcome.Socket != want {\n396|\t\t\tt.Fatalf(\"socket = %q, want %q\", outcome.Socket, want)\n397|\t\t}\n398|\t})\n399|\tt.Run(\"background\", func(t *testing.T) {\n400|\t\troot := runtimeRoot(t)\n401|\t\truntimeDir(t, root)\n402|\t\treq := validRequest(t, root)\n403|\t\treq.Caller = CallerBackground\n404|\t\tspy := &spawnSpy{}\n405|\t\treq.Deps.Spawn = spy.spawn\n406|\t\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n407|\t\t\treturn brokerReport(), nil\n408|\t\t}\n409|\t\toutcome, err := Acquire(req)\n410|\t\tif err != nil {\n411|\t\t\tt.Fatal(err)\n412|\t\t}\n413|\t\tif want := filepath.Join(root, \"tmux\", \"ax.sock\"); outcome.Socket != want {\n414|\t\t\tt.Fatalf(\"socket = %q, want %q\", outcome.Socket, want)\n415|\t\t}\n416|\t\tif spy.calls != 0 {\n417|\t\t\tt.Fatalf(\"spawn calls = %d, want 0 on broker contact\", spy.calls)\n418|\t\t}\n419|\t})\n420|}\n421|\n422|// A commit-phase custody refusal staged through the foreground entry:\n423|// the suite widens the mode behind the entry's back, and acquisition\n424|// refuses without probing or spawning.\n425|func TestAcquireForegroundStagesCommitPhaseCustodyRefusal(t *testing.T) {\n426|\troot := runtimeRoot(t)\n427|\tdir, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n428|\tif err != nil {\n429|\t\tt.Fatal(err)\n430|\t}\n431|\tif err := os.Chmod(dir, 0o755); err != nil {\n432|\t\tt.Fatal(err)\n433|\t}\n434|\treq := validRequest(t, root)\n435|\tspy := &spawnSpy{}\n436|\tprobed := false\n437|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n438|\t\tprobed = true\n439|\t\treturn ServerReport{}, nil\n440|\t}\n441|\treq.Deps.Spawn = spy.spawn\n442|\t_, err = Acquire(req)\n443|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime mode\")\n444|\tif probed {\n445|\t\tt.Fatal(\"server was probed past a custody refusal\")\n446|\t}\n447|\tif spy.calls != 0 {\n448|\t\tt.Fatalf(\"spawn calls = %d, want 0 past a custody refusal\", spy.calls)\n449|\t}\n450|}\n451|\n452|// The background verify wiring refuses a widened directory through the\n453|// entry with no broker contact.\n454|func TestAcquireBackgroundStagesVerifyCustodyRefusal(t *testing.T) {\n455|\troot := runtimeRoot(t)\n456|\tdir, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n457|\tif err != nil {\n458|\t\tt.Fatal(err)\n459|\t}\n460|\tif err := os.Chmod(dir, 0o755); err != nil {\n461|\t\tt.Fatal(err)\n462|\t}\n463|\treq := validRequest(t, root)\n464|\treq.Caller = CallerBackground\n465|\tspy := &spawnSpy{}\n466|\tprobed := false\n467|\treq.Deps.Spawn = spy.spawn\n468|\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n469|\t\tprobed = true\n470|\t\treturn brokerReport(), nil\n471|\t}\n472|\t_, err = Acquire(req)\n473|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime mode\")\n474|\tif probed {\n475|\t\tt.Fatal(\"broker was probed past a custody refusal\")\n476|\t}\n477|\tif spy.calls != 0 {\n478|\t\tt.Fatalf(\"spawn calls = %d, want 0 past a custody refusal\", spy.calls)\n479|\t}\n480|}\n481|\n482|func TestAcquireBackgroundProbeFailurePassesThrough(t *testing.T) {\n483|\troot := runtimeRoot(t)\n484|\truntimeDir(t, root)\n485|\treq := validRequest(t, root)\n486|\treq.Caller = CallerBackground\n487|\tspy := &spawnSpy{}\n488|\treq.Deps.Spawn = spy.spawn\n489|\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n490|\t\treturn BrokerReport{}, errProbeBoom\n491|\t}\n492|\t_, err := Acquire(req)\n493|\tif !errors.Is(err, errProbeBoom) {\n494|\t\tt.Fatalf(\"err = %v, want the probe failure, not unavailable\", err)\n495|\t}\n496|\tif spy.calls != 0 {\n497|\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n498|\t}\n499|}\n500|\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
