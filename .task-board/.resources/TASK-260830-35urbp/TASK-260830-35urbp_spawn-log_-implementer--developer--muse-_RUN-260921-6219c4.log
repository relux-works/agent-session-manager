/tmuxserver/runtime_test.go:186:\\teffectiveUID = func() int { return previous() + 100000 }\\ninternal/tmuxserver/runtime_test.go:187:\\tdefer func() { effectiveUID = previous }()\\n===\\n182:func TestEnsureRuntimeDirRefusesForeignOwnership(t *testing.T) {\\n183-\\troot := runtimeRoot(t)\\n184-\\truntimeDir(t, root)\\n185-\\tprevious := effectiveUID\\n186-\\teffectiveUID = func() int { return previous() + 100000 }\\n187-\\tdefer func() { effectiveUID = previous }()\\n188-\\t_, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\\n189-\\trequireLocalError(t, err, \\\"tmux_unsafe_runtime_dir\\\", \\\"runtime ownership\\\")\\n190-\\tif err := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS); err != nil {\\n191-\\t\\trequireLocalError(t, err, \\\"tmux_unsafe_runtime_dir\\\", \\\"runtime ownership\\\")\\n192-\\t} else {\\n193-\\t\\tt.Fatal(\\\"VerifyRuntimeDir admitted foreign ownership\\\")\\n194-\\t}\\n195-}\\n196-\\n197-func TestEnsureRuntimeDirRefusesHandleMismatch(t *testing.T) {\\n198-\\troot := runtimeRoot(t)\\n199-\\tprevious := sameDirectory\\n200-\\tsameDirectory = func(_, _ os.FileInfo) bool { return false }\\n201-\\tdefer func() { sameDirectory = previous }()\\n202-\\t_, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\\n203-\\trequireLocalError(t, err, \\\"tmux_unsafe_runtime_dir\\\", \\\"runtime containment\\\")\\n204-\\tif err := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS); err != nil {\\n205-\\t\\trequireLocalError(t, err, \\\"tmux_unsafe_runtime_dir\\\", \\\"runtime containment\\\")\\n206-\\t} else {\\n207-\\t\\tt.Fatal(\\\"VerifyRuntimeDir admitted a handle mismatch\\\")\\n208-\\t}\\n209-}\\n210-\\n211-func TestEnsureRuntimeDirRefusesSymlinkRoot(t *testing.T) {\\n212-\\treal := runtimeRoot(t)\\n213-\\tlink := filepath.Join(t.TempDir(), \\\"linkroot\\\")\\n214-\\tif err := os.Symlink(real, link); err != nil {\\n215-\\t\\tt.Fatal(err)\\n216-\\t}\\n217-\\t_, err := EnsureRuntimeDir(link, RuntimeDirName, scalar.PlatformMacOS, nil)\\n218-\\trequireLocalError(t, err, \\\"tmux_unsafe_runtime_dir\\\", \\\"runtime containment\\\")\\n219-}\\n220-\\n221-func TestEnsureRuntimeDirRefusesBadRoots(t *testing.T) {\\n222-\\troot := runtimeRoot(t)\\n\",\n  \"original_output_bytes\": 2961,\n  \"original_output_tokens\": 741,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
