DirName, req.Platform)\n152|\tif err != nil {\n153|\t\treturn Outcome{}, err\n154|\t}\n155|\tsocket, err := ResolveSocket(dir, req.SocketOverride, req.Ambient)\n156|\tif err != nil {\n157|\t\treturn Outcome{}, err\n158|\t}\n159|\tif req.Caller == CallerBackground {\n160|\t\treturn acquireBackground(req, socket)\n161|\t}\n162|\treturn acquireForeground(req, socket)\n163|}\n164|\n165|// acquireBackground implements the broker-or-refuse rule: it may\n166|// contact the already-running authenticated broker and its attested\n167|// server, and when neither exists it returns capability_unavailable\n168|// with typed realm/readiness details. Direct server creation is not\n169|// the else branch — this function has no path to the spawner, on\n170|// any platform — and the runtime directory is verified, never\n171|// created here. A missing leaf is the ordinary cold state (the\n172|// Runtime IPC root is a per-user temporary directory), so absence\n173|// maps to the typed unavailable with no broker probe and no spawn;\n174|// a leaf that exists but fails custody keeps its custody code.\n175|func acquireBackground(req Request, socket string) (Outcome, error) {\n176|\tif req.Deps.ProbeBroker == nil {\n177|\t\treturn Outcome{}, &Error{Code: CodeInvalidArguments, Detail: \"dependencies\"}\n178|\t}\n179|\tverr := VerifyRuntimeDir(req.Root, RuntimeDirName, req.Platform)\n180|\tif runtimeAbsent(verr) {\n181|\t\treturn Outcome{}, backgroundUnavailable(req, verr)\n182|\t}\n183|\tif verr != nil {\n184|\t\treturn Outcome{}, verr\n185|\t}\n186|\tstatus, err := req.Deps.ProbeBroker()\n187|\tif err != nil {\n188|\t\treturn Outcome{}, err\n189|\t}\n190|\tif err := CheckBrokerContact(status, req.Generation, currentUID()); err != nil {\n191|\t\t// The miss path creates nothing: it consults the creation\n192|\t\t// gate so the no-fallback rule is enforced by a call, not\n193|\t\t// by the absence of one. The gate refuses every background\n194|\t\t// caller; its refusal is expected here and the path reports\n195|\t\t// the typed unavailable the spec names. The else branch is\n196|\t\t// reachable only when the gate is weakened to admit a\n197|\t\t// background caller, and then it refuses with the creation\n198|\t\t// code instead of the typed unavailable, so the committed\n199|\t\t// background-miss tests redden.\n200|\t\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\n201|\t\t\treturn Outcome{}, backgroundUnavailable(req, err)\n202|\t\t}\n203|\t\treturn Outcome{}, &Error{Code: CodeBackgroundCreationRefused, Detail: \"background fallback\"}\n204|\t}\n205|\treturn Outcome{Via: ViaBroker, Socket: socket}, nil\n206|}\n207|\n208|// acquireForeground attaches to the running attested dedicated\n209|// server or spawns it. A running but unattested server refuses:\n210|// acquisition never attaches to a server whose landed admission is\n211|// missing or bound to another generation, and never repairs it here\n212|// — lifecycle owns that decision.\n213|func acquireForeground(req Request, socket string) (Outcome, error) {\n214|\tif req.Deps.ProbeServer == nil || req.Deps.Spawn == nil {\n215|\t\treturn Outcome{}, &Error{Code: CodeInvalidArguments, Detail: \"dependencies\"}\n216|\t}\n217|\tensured, err := EnsureRuntimeDir(req.Root, RuntimeDirName, req.Platform, nil)\n218|\tif err != nil {\n219|\t\treturn Outcome{}, err\n220|\t}\n221|\treport, err := req.Deps.ProbeServer(socket)\n222|\tif err != nil {\n223|\t\treturn Outcome{}, err\n224|\t}\n225|\tif report.Running {\n226|\t\tif err := CheckServerAttested(report.Admission, req.Generation); err != nil {\n227|\t\t\treturn Outcome{}, err\n228|\t\t}\n229|\t\treturn Outcome{Via: ViaAttached, Socket: socket}, nil\n230|\t}\n231|\targv, err := BuildArgv(ensured, socket, req.SessionID)\n232|\tif err != nil {\n233|\t\treturn Outcome{}, err\n234|\t}\n235|\tif err := req.Deps.Spawn(socket, argv); err != nil {\n236|\t\treturn Outcome{}, &Error{Code: CodeSpawnFailed, Detail: \"server spawn\"}\n237|\t}\n238|\treturn Outcome{Via: ViaSpawned, Socket: socket, Argv: argv}, nil\n239|}\n240|\n241|// runtimeAbsent reports whether err is the verify-side absent-leaf\n242|// refusal. Only the missing leaf counts — never a missing root, a\n243|// mode, ownership, kind, or symlink refusal: absence is the\n244|// readiness fact the background path maps to\n245|// capability_unavailable, while every unsafe-leaf refusal keeps its\n246|// custody code. A nil error is not absence.\n247|func runtimeAbsent(err error) bool {\n248|\tvar local *Error\n249|\tif !errors.As(err, &local) {\n250|\t\treturn false\n251|\t}\n252|\treturn local.Code == CodeUnsafeRuntimeDir && local.Detail == \"runtime absent\"\n253|}\n254|\n255|// checkCreationAllowed is the single choke point before every\n256|// direct server creation. A background caller never creates: on\n257|// macOS because server creation is credential-sensitive, and on\n258|// every platform because the background path must not fall back to\n259|// direct creation. The macOS credential-dependent case is one\n260|// fixture of this gate, not a narrower arm: narrowing the gate to\n261|// macOS or to credential-dependent servers would admit background\n262|// creation the no-fallback rule forbids. Foreground creation is\n263|// allowed on every platform; the credential binding it needs is\n264|// proven by the landed admission the server must present before\n265|// any attach.\n266|func checkCreationAllowed(caller Caller) error {\n267|\tif caller == CallerBackground {\n268|\t\treturn &Error{Code: CodeBackgroundCreationRefused, Detail: \"background creation\"}\n269|\t}\n270|\treturn nil\n271|}\n272|\n273|// backgroundUnavailable composes the typed capability_unavailable\n274|// refusal the spec names for the background miss, with the exact\n275|// Section 15.3 detail set. The constructor enforces the typed\n276|// details; a failure to render them is itself malformed input, not\n277|// an untyped refusal.\n278|func backgroundUnavailable(req Request, cause error) error {\n279|\tdetails := axerror.RealmEvidence{\n280|\t\tCapability:           realmCapability,\n281|\t\tCallerRealm:          req.Caller,\n282|\t\tBrokerState:          req.BrokerState,\n283|\t\tTmuxServerGeneration: req.Generation,\n284|\t\tRemediation:          req.Remediation,\n285|\t}\n286|\tfailure, err := axerror.NewRealmEvidenceUnavailable(axerror.Version130,\n287|\t\t\"no authenticated broker or attested tmux server\",\n288|\t\taxerror.NoIDs(), details, cause)\n289|\tif err != nil {\n290|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"realm details\"}\n291|\t}\n292|\treturn failure\n293|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c465","stream":{"kind":"session","id":"01a0c4fd-996a-7423-ba27-e5daf29de5a2"},"sequence":141,"recorded_at":1780531400000277,"record_type":"event","durability":"durable","causation_id":"e01e1bc2-95c9-4151-a1a6-6ebbbbe18d95","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e01e1bc2-95c9-4151-a1a6-6ebbbbe18d95","run_stream":{"kind":"run","id":"e01e1bc2-95c9-4151-a1a6-6ebbbbe18d95"},"call_id":"call_01a0c4fee87674e3bab14f0bd5e7723f","text":"Read text file `internal/tmuxserver/runtime.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"os\"\n5|\t\"strings\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n9|)\n10|\n11|// RuntimeDirName is the fixed leaf name of the AX tmux runtime\n12|// directory under the Runtime IPC root: pinned SPEC 806-808 selects\n13|// the dedicated server by `tmux -S <runtime>/tmux/ax.sock`, so the\n14|// leaf is `tmux`. It is AX-controlled vocabulary, never an ambient\n15|// or conventional tmux name.\n16|const RuntimeDirName = \"tmux\"\n17|\n18|// Hooks arms the crash boundaries of EnsureRuntimeDir. AfterMkdir\n19|// runs after the mkdir attempt resolves — the leaf created or\n20|// already present — and before verification and the parent fsync; a\n21|// crash there must leave a retry that converges to the one verified\n22|// directory. Hooks is nil in production.\n23|type Hooks struct {\n24|\tAfterMkdir func(dir string)\n25|}\n26|\n27|// EnsureRuntimeDir creates the owner-only runtime directory\n28|// root/name when absent and verifies it when present, returning the\n29|// joined path. Creation and verification enforce three independent\n30|// gates — containment, mode, ownership — and each refuses alone:\n31|//\n32|//   - containment: the root must be an absolute path on the platform\n33|//     grammar, the name must be one relative segment, and the commit\n34|//     opens the parent through a pinned directory handle and creates\n35|//     the leaf relative to that handle, so a symlinked intermediate\n36|//     directory cannot redirect the commit outside the root;\n37|//   - mode: the leaf must carry exactly 0700, enforced explicitly\n38|//     after creation because mkdir honors umask;\n39|//   - ownership: the leaf must belong to the effective UID.\n40|//\n41|// Lexical validation delegates to its landed owners (absolute root\n42|// and relative member to scalar, the join to secprim.Guard); the\n43|// descriptor-relative commit below is what this package owns, because\n44|// no landed helper commits a directory relative to a handle.\n45|//\n46|// On failure the returned path distinguishes the refusal phase: a\n47|// lexical refusal returns \"\", while a commit-phase refusal returns\n48|// the joined path alongside the error. Callers must check the error\n49|// first and never use the path when it is set; the split lets the\n50|// acquisition wiring narrow exactly the commit-phase class.\n51|func EnsureRuntimeDir(root, name string, platform scalar.Platform, hooks *Hooks) (string, error) {\n52|\tjoined, err := lexicalRuntimePath(root, name, platform)\n53|\tif err != nil {\n54|\t\treturn \"\", err\n55|\t}\n56|\treturn joined, commitRuntimeDir(root, name, joined, hooks)\n57|}\n58|\n59|// VerifyRuntimeDir enforces the three custody gates on an existing\n60|// runtime directory without creating it. Background acquisition calls\n61|// this instead of Ensure: the directory must already exist with exact\n62|// custody, and a missing directory refuses rather than being silently\n63|// created on the authorizing path. Foreground acquisition calls\n64|// Ensure, which provisions the directory it then verifies.\n65|func VerifyRuntimeDir(root, name string, platform scalar.Platform) error {\n66|\tif _, err := lexicalRuntimePath(root, name, platform); err != nil {\n67|\t\treturn err\n68|\t}\n69|\treturn verifyRuntimeDir(root, name)\n70|}\n71|\n72|// lexicalRuntimePath validates the root grammar, the name grammar,\n73|// and the lexical join. It answers the lexical question only; the\n74|// commit answers the filesystem question through a handle.\n75|func lexicalRuntimePath(root, name string, platform scalar.Platform) (string, error) {\n76|\tif _, err := scalar.ParsePlatform(string(platform)); err != nil {\n77|\t\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"runtime platform\"}\n78|\t}\n79|\t// Native Windows MUST NOT claim tmux or tmux resurrection\n80|\t// (pinned SPEC 1458), so the Windows platform refuses here on\n81|\t// every host, before any host-specific commit runs. Weakening\n82|\t// this arm reroutes a Windows request to the root refusal\n83|\t// instead of admitting it.\n84|\tif platform == scalar.PlatformWindows {\n85|\t\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"runtime platform\"}\n86|\t}\n87|\tif _, err := scalar.ParseAbsolutePath(platform, root); err != nil {\n88|\t\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"runtime root\"}\n89|\t}\n90|\tif err := checkRuntimeName(name); err != nil {\n91|\t\treturn \"\", err\n92|\t}\n93|\tguard, err := secprim.NewGuard(root, platform, []string{name})\n94|\tif err != nil {\n95|\t\treturn \"\", &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n96|\t}\n97|\tjoined, err := guard.Resolve(name)\n98|\tif err != nil {\n99|\t\treturn \"\", &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n100|\t}\n101|\treturn joined, nil\n102|}\n103|\n104|// checkRuntimeName admits exactly one relative path segment. The\n105|// shared grammar (absolute, parent, dot, empty, NUL, backslash,\n106|// encoded separators) is decided by scalar; this gate adds only the\n107|// single-segment rule scalar does not own, because the commit opens\n108|// the leaf relative to the pinned parent handle and a second segment\n109|// would name a path the handle walk never descends.\n110|func checkRuntimeName(name string) error {\n111|\tif _, err := scalar.ParseRelativePath(name); err != nil {\n112|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"runtime name\"}\n113|\t}\n114|\tif strings.Contains(name, \"/\") {\n115|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"runtime name\"}\n116|\t}\n117|\treturn nil\n118|}\n119|\n120|// sameDirectory compares two stat results for directory identity. It\n121|// is a variable only so seam-failure tests can force the\n122|// handle-mismatch path through the production entries: a handle that\n123|// names a different directory than the path cannot be staged without\n124|// a filesystem race, and without the seam the mismatch branch is\n125|// untestable. Production code never reassigns it.\n126|var sameDirectory = os.SameFile\n127|\n128|// handleBoundToPath reports whether the open directory handle refers\n129|// to the same directory as rootPath. It mirrors the private\n130|// secprim.guardRootMatches check, which no caller outside secprim\n131|// can invoke: a stat failure on either side is not a match, and an\n132|// unreadable root fails closed into the mismatch refusal rather\n133|// than admitting an unverifiable handle.\n134|func handleBoundToPath(handle *os.File, rootPath string) bool {\n135|\thandleInfo, err := handle.Stat()\n136|\tif err != nil || handleInfo == nil {\n137|\t\treturn false\n138|\t}\n139|\tpathInfo, err := os.Stat(rootPath)\n140|\tif err != nil || pathInfo == nil {\n141|\t\treturn false\n142|\t}\n143|\treturn sameDirectory(handleInfo, pathInfo)\n144|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
