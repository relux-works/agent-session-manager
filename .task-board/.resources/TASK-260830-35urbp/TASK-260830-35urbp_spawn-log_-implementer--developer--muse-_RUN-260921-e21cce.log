fy wiring; absence and every other custody refusal still refuse. Kill path: the entry contacts the broker past a widened mode.\",\n431|    ),\n432|    Mutant(\n433|        name=\"N-spawn-swallow\",\n434|        path=f\"{PACKAGE}/acquire.go\",\n435|        find=\"\\tif err := req.Deps.Spawn(socket, argv); err != nil {\\n\",\n436|        replace='\\tif err := req.Deps.Spawn(socket, argv); err != nil && err.Error() != \"exec failed\" {\\n',\n437|        count=1,\n438|        run=\"TestAcquireForegroundSpawnFailureReportsWithoutFallback\",\n439|        expect=\"KILLED\",\n440|        note=\"Admits exactly the fixture spawn failure as success; every other spawn failure still reports.\",\n441|    ),\n442|    Mutant(\n443|        name=\"N-probe-swallow-foreground\",\n444|        path=f\"{PACKAGE}/acquire.go\",\n445|        find=\"\\treport, err := req.Deps.ProbeServer(socket)\\n\\tif err != nil {\\n\",\n446|        replace='\\treport, err := req.Deps.ProbeServer(socket)\\n\\tif err != nil && err.Error() != \"probe boom\" {\\n',\n447|        count=1,\n448|        run=\"TestAcquireForegroundProbeFailurePassesThrough\",\n449|        expect=\"KILLED\",\n450|        note=\"Admits exactly the fixture probe failure as an absent server (then spawns); every other probe failure still passes through.\",\n451|    ),\n452|    Mutant(\n453|        name=\"N-probe-swallow-background\",\n454|        path=f\"{PACKAGE}/acquire.go\",\n455|        find=\"\\tstatus, err := req.Deps.ProbeBroker()\\n\\tif err != nil {\\n\",\n456|        replace='\\tstatus, err := req.Deps.ProbeBroker()\\n\\tif err != nil && err.Error() != \"probe boom\" {\\n',\n457|        count=1,\n458|        run=\"TestAcquireBackgroundProbeFailurePassesThrough\",\n459|        expect=\"KILLED\",\n460|        note=\"Admits exactly the fixture probe failure as a broker miss (then reports unavailable); every other probe failure still passes through.\",\n461|    ),\n462|    Mutant(\n463|        name=\"N-argv-socket\",\n464|        