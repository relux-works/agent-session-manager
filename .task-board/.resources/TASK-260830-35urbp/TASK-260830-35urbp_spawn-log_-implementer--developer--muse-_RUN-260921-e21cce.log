{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8e9","stream":{"kind":"session","id":"01a0c45a-c3aa-73a1-9c84-6d5fc23e6787"},"sequence":719,"recorded_at":1780531400001433,"record_type":"event","durability":"durable","causation_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","run_stream":{"kind":"run","id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d"},"task_stream":{"kind":"task","id":"01a0c45c-793a-7bf3-ab63-c24a5320495a"},"task_id":"01a0c45c-793a-7bf3-ab63-c24a5320495a","event":{"kind":"output","task_id":"01a0c45c-793a-7bf3-ab63-c24a5320495a","chunk":"Read text file `internal/tmuxserver/crash_unix_test.go`.\n1|//go:build darwin || linux\n2|\n3|package tmuxserver\n4|\n5|import (\n6|\t\"context\"\n7|\t\"errors\"\n8|\t\"os\"\n9|\t\"os/exec\"\n10|\t\"syscall\"\n11|\t\"testing\"\n12|\t\"time\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|)\n16|\n17|// Real process-termination evidence for the runtime-directory seam.\n18|// The child runs the genuine production EnsureRuntimeDir entry and\n19|// SIGKILLs itself in the AfterMkdir hook, after the mkdirat commit\n20|// and before verification and the parent fsync. The parent proves\n21|// the interrupted run left no half-custody behind: the retry\n22|// converges to the one verified owner-only directory.\n23|const (\n24|\tcrashChildMode = \"AX_TMUXSERVER_CRASH_MODE\"\n25|\tcrashChildRoot = \"AX_TMUXSERVER_CRASH_ROOT\"\n26|)\n27|\n28|func TestEnsureCrashChildSelfTerminates(t *testing.T) {\n29|\tif os.Getenv(crashChildMode) == \"ensure\" {\n30|\t\tensureCrashChild(t)\n31|\t\treturn\n32|\t}\n33|\troot := stateRoot(t)\n34|\tctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)\n35|\tdefer cancel()\n36|\tchild := exec.CommandContext(ctx, os.Args[0],\n37|\t\t\"-test.run=^TestEnsureCrashChildSelfTerminates$\",\n38|\t\t\"-test.count=1\",\n39|\t)\n40|\tchild.Env = append(os.Environ(),\n41|\t\tcrashChildMode+\"=ensure\",\n42|\t\tcrashChildRoot+\"=\"+root,\n43|\t)\n44|\trunErr := child.Run()\n45|\tvar exitErr *exec.ExitError\n46|\tif !errors.As(runErr, &exitErr) {\n47|\t\tt.Fatalf(\"child run = %v, want a signal-kill exit\", runErr)\n48|\t}\n49|\tstatus, ok := exitErr.Sys().(syscall.WaitStatus)\n50|\tif !ok || !status.Signaled() || status.Signal() != syscall.SIGKILL {\n51|\t\tt.Fatalf(\"child status = %v, want killed by SIGKILL\", exitErr)\n52|\t}\n53|\tdir, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n54|\tif err != nil {\n55|\t\tt.Fatalf(\"EnsureRuntimeDir() retry after kill error = %v\", err)\n56|\t}\n57|\tinfo, err := os.Lstat(dir)\n58|\tif err != nil {\n59|\t\tt.Fatal(err)\n60|\t}\n61|\tif !info.IsDir() || info.Mode().Perm() != 0o700 {\n62|\t\tt.Fatalf(\"dir after kill = %04o dir=%v, want 0700 dir\", info.Mode().Perm(), info.IsDir())\n63|\t}\n64|\tif err := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS); err != nil {\n65|\t\tt.Fatalf(\"VerifyRuntimeDir() after kill error = %v\", err)\n66|\t}\n67|\tagain, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n68|\tif err != nil {\n69|\t\tt.Fatal(err)\n70|\t}\n71|\tif again != dir {\n72|\t\tt.Fatalf(\"second retry = %q, want %q\", again, dir)\n73|\t}\n74|}\n75|\n76|func ensureCrashChild(t *testing.T) {\n77|\tt.Helper()\n78|\troot := os.Getenv(crashChildRoot)\n79|\thooks := &Hooks{AfterMkdir: func(dir string) {\n80|\t\t_ = syscall.Kill(syscall.Getpid(), syscall.SIGKILL)\n81|\t}}\n82|\t_, _ = EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, hooks)\n83|\t// If the hook failed to kill, fail loudly so the parent never\n84|\t// mistakes a clean exit for a kill.\n85|\tt.Fatal(\"crash child survived its kill hook\")\n86|}\n87|\n88|func TestAcquireForegroundSpawnIsIdempotentAcrossRetry(t *testing.T) {\n89|\troot := stateRoot(t)\n90|\tspawned := false\n91|\tspawns := 0\n92|\tmake := func() Request {\n93|\t\treq := validRequest(t, root)\n94|\t\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n95|\t\t\tif spawned {\n96|\t\t\t\treturn ServerReport{Running: true, Admission: boundAdmission()}, nil\n97|\t\t\t}\n98|\t\t\treturn ServerReport{}, nil\n99|\t\t}\n100|\t\treq.Deps.Spawn = func(socket string, argv []string) error {\n101|\t\t\tspawns++\n102|\t\t\tspawned = true\n103|\t\t\treturn nil\n104|\t\t}\n105|\t\treturn req\n106|\t}\n107|\tfirst, err := Acquire(make())\n108|\tif err != nil {\n109|\t\tt.Fatal(err)\n110|\t}\n111|\tif first.Via != \"spawned\" {\n112|\t\tt.Fatalf(\"first via = %q\", first.Via)\n113|\t}\n114|\tsecond, err := Acquire(make())\n115|\tif err != nil {\n116|\t\tt.Fatal(err)\n117|\t}\n118|\tif second.Via != \"attached-running\" {\n119|\t\tt.Fatalf(\"second via = %q, want attached-running\", second.Via)\n120|\t}\n121|\tif second.Socket != first.Socket {\n122|\t\tt.Fatalf(\"sockets differ: %q vs %q\", second.Socket, first.Socket)\n123|\t}\n124|\tif spawns != 1 {\n125|\t\tt.Fatalf(\"spawns = %d, want exactly 1\", spawns)\n126|\t}\n127|}","final_result":true}}}
