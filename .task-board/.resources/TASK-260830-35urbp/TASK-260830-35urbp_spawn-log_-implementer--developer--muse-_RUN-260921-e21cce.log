{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9f7","stream":{"kind":"session","id":"01a0c45a-c3aa-73a1-9c84-6d5fc23e6787"},"sequence":854,"recorded_at":1780531400001703,"record_type":"event","durability":"durable","causation_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","run_stream":{"kind":"run","id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d"},"task_stream":{"kind":"task","id":"01a0c45d-0306-7741-b069-7e21eb3f7fcf"},"task_id":"01a0c45d-0306-7741-b069-7e21eb3f7fcf","event":{"kind":"output","task_id":"01a0c45d-0306-7741-b069-7e21eb3f7fcf","chunk":"Read text file `internal/localstore/paths.go`.\n1|// Package localstore implements the AX owner-local path layout and immutable\n2|// SHA-256 blob sink. It does not advertise runtime platform support.\n3|package localstore\n4|\n5|import (\n6|\t\"bytes\"\n7|\t\"crypto/sha256\"\n8|\t_ \"embed\"\n9|\t\"encoding/json\"\n10|\t\"errors\"\n11|\t\"fmt\"\n12|\t\"io\"\n13|\t\"os\"\n14|\t\"path\"\n15|\t\"path/filepath\"\n16|\t\"runtime\"\n17|\t\"slices\"\n18|\t\"strings\"\n19|\t\"sync\"\n20|\n21|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n22|\t\"github.com/relux-works/agent-session-manager/internal/specpin\"\n23|)\n24|\n25|var (\n26|\tErrPathRegistry           = errors.New(\"AX path registry is invalid\")\n27|\tErrUnknownPathFlag        = errors.New(\"unknown AX path flag\")\n28|\tErrInvalidPath            = errors.New(\"invalid AX local path\")\n29|\tErrPathDefaultUnavailable = errors.New(\"AX platform path default is unavailable\")\n30|\tErrUnsafeOwnership        = errors.New(\"AX local path is not owner-only\")\n31|\tErrUnsupportedPlatform    = errors.New(\"AX local filesystem platform is unsupported\")\n32|)\n33|\n34|const PathRegistrySHA256 = \"1f7100bf212429bb519bf56d04e8c03b6bd2d2543e7307463a43fbe58e1eb9f0\"\n35|\n36|type PathClass string\n37|\n38|const (\n39|\tPathConfig  PathClass = \"config\"\n40|\tPathData    PathClass = \"data\"\n41|\tPathState   PathClass = \"state\"\n42|\tPathCache   PathClass = \"cache\"\n43|\tPathRuntime PathClass = \"runtime\"\n44|)\n45|\n46|type PathValueKind string\n47|\n48|const (\n49|\tPathValueConfigurationFile PathValueKind = \"configuration_file\"\n50|\tPathValueDirectory         PathValueKind = \"directory\"\n51|)\n52|\n53|type PathSource string\n54|\n55|const (\n56|\tPathSourceFlag        PathSource = \"flag\"\n57|\tPathSourceEnvironment PathSource = \"environment\"\n58|\tPathSourceDefault     PathSource = \"default\"\n59|)\n60|\n61|type PathDefinition struct {\n62|\tClass       PathClass\n63|\tFlag        string\n64|\tEnvironment string\n65|\tValueKind   PathValueKind\n66|}\n67|\n68|type ResolveRequest struct {\n69|\tPlatform    scalar.Platform\n70|\tFlags       map[string]string\n71|\tEnvironment map[string]string\n72|\t// LookupEnv is the captured environment seam used by production callers\n73|\t// that cannot materialize an ambient environment map. When set, it is\n74|\t// queried only for the registry/default variables needed by the selected\n75|\t// precedence path; unknown variables are never enumerated.\n76|\tLookupEnv    func(string) (string, bool)\n77|\tHomeDir      string\n78|\tTemporaryDir string\n79|\t// WorkingDir is optional for compatibility with the standalone localstore\n80|\t// resolver. Config's production loader supplies the captured directory so\n81|\t// relative explicit overrides are normalized by this resolver as one\n82|\t// canonical pair, rather than by a second path implementation.\n83|\tWorkingDir string\n84|}\n85|\n86|type ResolvedPath struct {\n87|\tClass  PathClass\n88|\tValue  scalar.AbsolutePath\n89|\tSource PathSource\n90|}\n91|\n92|type ResolvedPaths struct {\n93|\tplatform scalar.Platform\n94|\tpaths    map[PathClass]ResolvedPath\n95|}\n96|\n97|// PathResolutionError keeps the registry member and precedence layer attached\n98|// to a resolver refusal without exposing the selected machine-local value.\n99|// Compatibility adapters may translate the typed cause while preserving the\n100|// one canonical localstore resolution path.\n101|type PathResolutionError struct {\n102|\tClass  PathClass\n103|\tSource PathSource\n104|\tErr    error\n105|}\n106|\n107|func (err *PathResolutionError) Error() string {\n108|\treturn fmt.Sprintf(\"resolve %s path from %s: %v\", err.Class, err.Source, err.Err)\n109|}\n110|\n111|func (err *PathResolutionError) Unwrap() error { return err.Err }\n112|\n113|func (resolved ResolvedPaths) Platform() scalar.Platform { return resolved.platform }\n114|\n115|func (resolved ResolvedPaths) Path(class PathClass) (ResolvedPath, bool) {\n116|\tvalue, ok := resolved.paths[class]\n117|\treturn value, ok\n118|}\n119|\n120|func (resolved ResolvedPaths) Paths() []ResolvedPath {\n(more lines below)","final_result":true}}}
