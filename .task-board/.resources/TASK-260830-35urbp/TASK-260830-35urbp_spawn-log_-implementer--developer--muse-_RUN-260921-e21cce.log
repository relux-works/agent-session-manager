{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c531","stream":{"kind":"session","id":"01a0c45a-c3aa-73a1-9c84-6d5fc23e6787"},"sequence":243,"recorded_at":1780531400000481,"record_type":"event","durability":"durable","causation_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","run_stream":{"kind":"run","id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d"},"call_id":"call_01a0c45b545170c2bd81da6722186a8f","text":"Read text file `internal/tmuxserver/acquire.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n5|\t\"github.com/relux-works/agent-session-manager/internal/axpane\"\n6|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n7|)\n8|\n9|// Caller names the acquisition caller. The vocabulary is owned by\n10|// internal/axpane, which already gates the wrapper decision over it;\n11|// this package reuses its constants rather than retyping them.\n12|type Caller = string\n13|\n14|const (\n15|\t// CallerForeground is an interactive operator-side caller that\n16|\t// may create the dedicated server.\n17|\tCallerForeground = axpane.CallerForeground\n18|\t// CallerBackground is a background CLI, SSH RPC process,\n19|\t// daemon, or restore worker: it must never create a\n20|\t// credential-dependent tmux server, may contact an\n21|\t// already-running authenticated broker, and otherwise receives\n22|\t// capability_unavailable with no fallback to direct creation.\n23|\tCallerBackground = axpane.CallerBackground\n24|)\n25|\n26|// Acquisition outcomes name how the caller reached the dedicated\n27|// server. Exactly one applies; there is no combined or fallback\n28|// outcome.\n29|const (\n30|\t// ViaSpawned created the dedicated -S server on the foreground\n31|\t// path and returns its spawn argv.\n32|\tViaSpawned = \"spawned\"\n33|\t// ViaAttachedFound the dedicated server already running and\n34|\t// attested on the foreground path.\n35|\tViaAttached = \"attached-running\"\n36|\t// ViaBroker contacted the already-running authenticated Aqua\n37|\t// broker and its attested AX tmux server on the background\n38|\t// path. No local spawn argv exists on this path.\n39|\tViaBroker = \"broker\"\n40|)\n41|\n42|// realmCapability is the Section 4.D capability the background\n43|// typed refusal names: the exact instance passes the AX sentinel\n44|// and the provider-auth smoke without UI. The admission verdict is\n45|// the landed terminalbackend owner's; this package consumes it\n46|// through RealmAdmission and never re-decides it.\n47|const realmCapability = \"credential_capable_execution_realm\"\n48|\n49|// ServerReport is the live dedicated-server probe result: whether\n50|// the private socket answers, with the landed admission verdict over\n51|// the exact server when it does.\n52|type ServerReport struct {\n53|\tRunning   bool\n54|\tAdmission RealmAdmission\n55|}\n56|\n57|// Dependencies carries every external interaction acquisition\n58|// performs. This leaf ships the decision core and argv only: no\n59|// production probe or spawner implementation exists in the tree. The\n60|// exec/probe adapters — which report Reconcile/ResolveEvidence\n61|// verdicts and spawn through the built argv — and the server socket's\n62|// crash evidence are owned by the lifecycle leaf TASK-260830-1c28dz;\n63|// tests wire fakes. No probe runs without its dependency: a nil entry\n64|// refuses instead of reaching for a default.\n65|type Dependencies struct {\n66|\t// ProbeServer reports the dedicated socket's live state.\n67|\tProbeServer func(socket string) (ServerReport, error)\n68|\t// ProbeBroker reports the live Aqua broker state.\n69|\tProbeBroker func() (BrokerReport, error)\n70|\t// Spawn creates the dedicated server with the given -S argv.\n71|\tSpawn func(socket string, argv []string) error\n72|}\n73|\n74|// Request is the complete acquisition surface. There is deliberately\n75|// no member for a credential flag, a managername hint, or a cached\n76|// observation: the background creation rule needs no credential flag\n77|// because the background path never creates on any platform, and a\n78|// hint or cached observation never authorizes, so none is an input.\n79|type Request struct {\n80|\tCaller   Caller\n81|\tPlatform scalar.Platform\n82|\t// Root and Name select the runtime directory: Root is the AX\n83|\t// state root, Name is the runtime leaf (usually\n84|\t// RuntimeDirName). Foreground acquisition ensures the directory\n85|\t// idempotently; background acquisition verifies the existing\n86|\t// directory and never creates it.\n87|\tRoot string\n88|\tName string\n89|\t// Ambient carries the observed ambient socket facts for\n90|\t// evidence. Resolution never reads them; tests assert the\n91|\t// acquired socket equals none of them.\n92|\tAmbient Ambient\n93|\t// SocketOverride must be empty. Any caller-supplied socket —\n94|\t// whichever ambient vector supplied it — refuses.\n95|\tSocketOverride string\n96|\t// SessionID is the logical session the spawned server will\n97|\t// host, as canonical UUIDv7. It shapes spawn argv only.\n98|\tSessionID string\n99|\t// Generation, BrokerState, and Remediation are the typed\n100|\t// realm/readiness details the capability_unavailable refusal\n101|\t// carries. All three are required: an input that omits one\n102|\t// is malformed and refuses invalid_arguments instead of\n103|\t// emitting an untyped refusal. Generation is also the typed\n104|\t// generation every admission must bind to.\n105|\tGeneration  string\n106|\tBrokerState string\n107|\tRemediation string\n108|\tDeps        Dependencies\n109|}\n110|\n111|// Outcome is the one acquisition result.\n112|type Outcome struct {\n113|\tVia    string\n114|\tSocket string\n115|\t// Argv is the dedicated -S spawn argv. It is set only for\n116|\t// ViaSpawned: the broker path spawns nothing and the\n117|\t// attached path presents through sibling-owned attach\n118|\t// semantics, not through a second spawn vector.\n119|\tArgv []string\n120|}\n121|\n122|// Acquire resolves the dedicated server socket from the runtime\n123|// directory and reaches the server through the caller-appropriate\n124|// path. Foreground attaches to the running attested server or\n125|// spawns the dedicated -S server; background contacts the\n126|// already-running authenticated broker or receives the typed\n127|// capability_unavailable refusal, and never falls back to direct\n128|// server creation — there is no spawn call on the background path,\n129|// and every background test arms a spy spawner that fails the run\n130|// if it is ever invoked.\n131|//\n132|// Refusals precede side effects: malformed input, ambient reuse, and\n133|// missing dependencies all refuse before any directory is created,\n134|// and background acquisition verifies the runtime directory without\n135|// creating it, so a background caller performs no durable write.\n136|func Acquire(req Request) (Outcome, error) {\n137|\tif req.Caller != CallerForeground && req.Caller != CallerBackground {\n138|\t\treturn Outcome{}, &Error{Code: CodeInvalidArguments, Detail: \"caller\"}\n139|\t}\n140|\tif req.Generation == \"\" || req.BrokerState == \"\" || req.Remediation == \"\" {\n141|\t\treturn Outcome{}, &Error{Code: CodeInvalidArguments, Detail: \"realm details\"}\n142|\t}\n143|\tdir, err := lexicalRuntimePath(req.Root, req.Name, req.Platform)\n144|\tif err != nil {\n145|\t\treturn Outcome{}, err\n146|\t}\n147|\tsocket, err := ResolveSocket(dir, req.SocketOverride, req.Ambient)\n148|\tif err != nil {\n149|\t\treturn Outcome{}, err\n150|\t}\n151|\tif req.Caller == CallerBackground {\n152|\t\treturn acquireBackground(req, socket)\n153|\t}\n154|\treturn acquireForeground(req, socket)\n155|}\n156|\n157|// acquireBackground implements the broker-or-refuse rule: it may\n158|// contact the already-running authenticated broker and its attested\n159|// server, and when neither exists it returns capability_unavailable\n160|// with typed realm/readiness details. Direct server creation is not\n161|// the else branch — this function has no path to the spawner, on\n162|// any platform — and the runtime directory is verified, never\n163|// created here.\n164|func acquireBackground(req Request, socket string) (Outcome, error) {\n165|\tif req.Deps.ProbeBroker == nil {\n166|\t\treturn Outcome{}, &Error{Code: CodeInvalidArguments, Detail: \"dependencies\"}\n167|\t}\n168|\tif verr := VerifyRuntimeDir(req.Root, req.Name, req.Platform); verr != nil {\n169|\t\treturn Outcome{}, verr\n170|\t}\n171|\tstatus, err := req.Deps.ProbeBroker()\n172|\tif err != nil {\n173|\t\treturn Outcome{}, err\n174|\t}\n175|\tif err := CheckBrokerContact(status, req.Generation, currentUID()); err != nil {\n176|\t\t// The miss path creates nothing: it consults the creation\n177|\t\t// gate so the no-fallback rule is enforced by a call, not\n178|\t\t// by the absence of one. The gate refuses every background\n179|\t\t// caller; its refusal is expected here and the path reports\n180|\t\t// the typed unavailable the spec names. The else branch is\n181|\t\t// reachable only when the gate is weakened to admit a\n182|\t\t// background caller, and then it refuses with the creation\n183|\t\t// code instead of the typed unavailable, so the committed\n184|\t\t// background-miss tests redden.\n185|\t\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\n186|\t\t\treturn Outcome{}, backgroundUnavailable(req, err)\n187|\t\t}\n188|\t\treturn Outcome{}, &Error{Code: CodeBackgroundCreationRefused, Detail: \"background fallback\"}\n189|\t}\n190|\treturn Outcome{Via: ViaBroker, Socket: socket}, nil\n191|}\n192|\n193|// acquireForeground attaches to the running attested dedicated\n194|// server or spawns it. A running but unattested server refuses:\n195|// acquisition never attaches to a server whose landed admission is\n196|// missing or bound to another generation, and never repairs it here\n197|// — lifecycle owns that decision.\n198|func acquireForeground(req Request, socket string) (Outcome, error) {\n199|\tif req.Deps.ProbeServer == nil || req.Deps.Spawn == nil {\n200|\t\treturn Outcome{}, &Error{Code: CodeInvalidArguments, Detail: \"dependencies\"}\n201|\t}\n202|\tensured, err := EnsureRuntimeDir(req.Root, req.Name, req.Platform, nil)\n203|\tif err != nil {\n204|\t\treturn Outcome{}, err\n205|\t}\n206|\treport, err := req.Deps.ProbeServer(socket)\n207|\tif err != nil {\n208|\t\treturn Outcome{}, err\n209|\t}\n210|\tif report.Running {\n211|\t\tif err := CheckServerAttested(report.Admission, req.Generation); err != nil {\n212|\t\t\treturn Outcome{}, err\n213|\t\t}\n214|\t\treturn Outcome{Via: ViaAttached, Socket: socket}, nil\n215|\t}\n216|\targv, err := BuildArgv(ensured, socket, req.SessionID)\n217|\tif err != nil {\n218|\t\treturn Outcome{}, err\n219|\t}\n220|\tif err := req.Deps.Spawn(socket, argv); err != nil {\n221|\t\treturn Outcome{}, &Error{Code: CodeSpawnFailed, Detail: \"server spawn\"}\n222|\t}\n223|\treturn Outcome{Via: ViaSpawned, Socket: socket, Argv: argv}, nil\n224|}\n225|\n226|// checkCreationAllowed is the single choke point before every\n227|// direct server creation. A background caller never creates: on\n228|// macOS because server creation is credential-sensitive, and on\n229|// every platform because the background path must not fall back to\n230|// direct creation. The macOS credential-dependent case is one\n231|// fixture of this gate, not a narrower arm: narrowing the gate to\n232|// macOS or to credential-dependent servers would admit background\n233|// creation the no-fallback rule forbids. Foreground creation is\n234|// allowed on every platform; the credential binding it needs is\n235|// proven by the landed admission the server must present before\n236|// any attach.\n237|func checkCreationAllowed(caller Caller) error {\n238|\tif caller == CallerBackground {\n239|\t\treturn &Error{Code: CodeBackgroundCreationRefused, Detail: \"background creation\"}\n240|\t}\n241|\treturn nil\n242|}\n243|\n244|// backgroundUnavailable composes the typed capability_unavailable\n245|// refusal the spec names for the background miss, with the exact\n246|// Section 15.3 detail set. The constructor enforces the typed\n247|// details; a failure to render them is itself malformed input, not\n248|// an untyped refusal.\n249|func backgroundUnavailable(req Request, cause error) error {\n250|\tdetails := axerror.RealmEvidence{\n251|\t\tCapability:           realmCapability,\n252|\t\tCallerRealm:          req.Caller,\n253|\t\tBrokerState:          req.BrokerState,\n254|\t\tTmuxServerGeneration: req.Generation,\n255|\t\tRemediation:          req.Remediation,\n256|\t}\n257|\tfailure, err := axerror.NewRealmEvidenceUnavailable(axerror.Version130,\n258|\t\t\"no authenticated broker or attested tmux server\",\n259|\t\taxerror.NoIDs(), details, cause)\n260|\tif err != nil {\n261|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"realm details\"}\n262|\t}\n263|\treturn failure\n264|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c533","stream":{"kind":"session","id":"01a0c45a-c3aa-73a1-9c84-6d5fc23e6787"},"sequence":244,"recorded_at":1780531400000483,"record_type":"event","durability":"durable","causation_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","run_stream":{"kind":"run","id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d"},"call_id":"call_01a0c45b565874fc992a9f4c057eb170","text":"Read text file `internal/tmuxserver/runtime.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"os\"\n5|\t\"strings\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n9|)\n10|\n11|// RuntimeDirName is the fixed leaf name of the AX tmux runtime\n12|// directory under the AX state root. It is AX-controlled vocabulary,\n13|// never an ambient or conventional tmux name.\n14|const RuntimeDirName = \"ax-tmux\"\n15|\n16|// Hooks arms the crash boundaries of EnsureRuntimeDir. AfterMkdir\n17|// runs after the directory entry is committed and before the parent\n18|// fsync; a crash there must leave a retry that converges to the one\n19|// verified directory. Hooks is nil in production.\n20|type Hooks struct {\n21|\tAfterMkdir func(dir string)\n22|}\n23|\n24|// EnsureRuntimeDir creates the owner-only runtime directory\n25|// root/name when absent and verifies it when present, returning the\n26|// joined path. Creation and verification enforce three independent\n27|// gates — containment, mode, ownership — and each refuses alone:\n28|//\n29|//   - containment: the root must be an absolute path on the platform\n30|//     grammar, the name must be one relative segment, and the commit\n31|//     opens the parent through a pinned directory handle and creates\n32|//     the leaf relative to that handle, so a symlinked intermediate\n33|//     directory cannot redirect the commit outside the root;\n34|//   - mode: the leaf must carry exactly 0700, enforced explicitly\n35|//     after creation because mkdir honors umask;\n36|//   - ownership: the leaf must belong to the effective UID.\n37|//\n38|// Lexical validation delegates to its landed owners (absolute root\n39|// and relative member to scalar, the join to secprim.Guard); the\n40|// descriptor-relative commit below is what this package owns, because\n41|// no landed helper commits a directory relative to a handle.\n42|//\n43|// On failure the returned path distinguishes the refusal phase: a\n44|// lexical refusal returns \"\", while a commit-phase refusal returns\n45|// the joined path alongside the error. Callers must check the error\n46|// first and never use the path when it is set; the split lets the\n47|// acquisition wiring narrow exactly the commit-phase class.\n48|func EnsureRuntimeDir(root, name string, platform scalar.Platform, hooks *Hooks) (string, error) {\n49|\tjoined, err := lexicalRuntimePath(root, name, platform)\n50|\tif err != nil {\n51|\t\treturn \"\", err\n52|\t}\n53|\treturn joined, commitRuntimeDir(root, name, joined, hooks)\n54|}\n55|\n56|// VerifyRuntimeDir enforces the three custody gates on an existing\n57|// runtime directory without creating it. Background acquisition calls\n58|// this instead of Ensure: the directory must already exist with exact\n59|// custody, and a missing directory refuses rather than being silently\n60|// created on the authorizing path. Foreground acquisition calls\n61|// Ensure, which provisions the directory it then verifies.\n62|func VerifyRuntimeDir(root, name string, platform scalar.Platform) error {\n63|\tif _, err := lexicalRuntimePath(root, name, platform); err != nil {\n64|\t\treturn err\n65|\t}\n66|\treturn verifyRuntimeDir(root, name)\n67|}\n68|\n69|// lexicalRuntimePath validates the root grammar, the name grammar,\n70|// and the lexical join. It answers the lexical question only; the\n71|// commit answers the filesystem question through a handle.\n72|func lexicalRuntimePath(root, name string, platform scalar.Platform) (string, error) {\n73|\tif _, err := scalar.ParsePlatform(string(platform)); err != nil {\n74|\t\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"runtime platform\"}\n75|\t}\n76|\t// Native Windows MUST NOT claim tmux or tmux resurrection\n77|\t// (pinned SPEC 1458), so the Windows platform refuses here on\n78|\t// every host, before any host-specific commit runs. Weakening\n79|\t// this arm reroutes a Windows request to the root refusal\n80|\t// instead of admitting it.\n81|\tif platform == scalar.PlatformWindows {\n82|\t\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"runtime platform\"}\n83|\t}\n84|\tif _, err := scalar.ParseAbsolutePath(platform, root); err != nil {\n85|\t\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"runtime root\"}\n86|\t}\n87|\tif err := checkRuntimeName(name); err != nil {\n88|\t\treturn \"\", err\n89|\t}\n90|\tguard, err := secprim.NewGuard(root, platform, []string{name})\n91|\tif err != nil {\n92|\t\treturn \"\", &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n93|\t}\n94|\tjoined, err := guard.Resolve(name)\n95|\tif err != nil {\n96|\t\treturn \"\", &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n97|\t}\n98|\treturn joined, nil\n99|}\n100|\n101|// checkRuntimeName admits exactly one relative path segment. The\n102|// shared grammar (absolute, parent, dot, empty, NUL, backslash,\n103|// encoded separators) is decided by scalar; this gate adds only the\n104|// single-segment rule scalar does not own, because the commit opens\n105|// the leaf relative to the pinned parent handle and a second segment\n106|// would name a path the handle walk never descends.\n107|func checkRuntimeName(name string) error {\n108|\tif _, err := scalar.ParseRelativePath(name); err != nil {\n109|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"runtime name\"}\n110|\t}\n111|\tif strings.Contains(name, \"/\") {\n112|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"runtime name\"}\n113|\t}\n114|\treturn nil\n115|}\n116|\n117|// sameDirectory compares two stat results for directory identity. It\n118|// is a variable only so seam-failure tests can force the\n119|// handle-mismatch path through the production entries: a handle that\n120|// names a different directory than the path cannot be staged without\n121|// a filesystem race, and without the seam the mismatch branch is\n122|// untestable. Production code never reassigns it.\n123|var sameDirectory = os.SameFile\n124|\n125|// handleBoundToPath reports whether the open directory handle refers\n126|// to the same directory as rootPath. It mirrors the private\n127|// secprim.guardRootMatches check, which no caller outside secprim\n128|// can invoke: a stat failure on either side is not a match, and an\n129|// unreadable root fails closed into the mismatch refusal rather\n130|// than admitting an unverifiable handle.\n131|func handleBoundToPath(handle *os.File, rootPath string) bool {\n132|\thandleInfo, err := handle.Stat()\n133|\tif err != nil || handleInfo == nil {\n134|\t\treturn false\n135|\t}\n136|\tpathInfo, err := os.Stat(rootPath)\n137|\tif err != nil || pathInfo == nil {\n138|\t\treturn false\n139|\t}\n140|\treturn sameDirectory(handleInfo, pathInfo)\n141|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c535","stream":{"kind":"session","id":"01a0c45a-c3aa-73a1-9c84-6d5fc23e6787"},"sequence":245,"recorded_at":1780531400000485,"record_type":"event","durability":"durable","causation_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","run_stream":{"kind":"run","id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d"},"call_id":"call_01a0c45b581a72b68456fcedc4469571","text":"Read text file `internal/tmuxserver/socket.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"path/filepath\"\n5|)\n6|\n7|// SocketName is the fixed private socket leaf inside the runtime\n8|// directory. AX derives its server socket from this name under the\n9|// owner-only directory and from nothing else.\n10|const SocketName = \"ax-tmux.sock\"\n11|\n12|// Ambient environment names the four discovery vectors AX must never\n13|// use. TMUXEnv and TMUXTmpDir name the two environment variables\n14|// whose values may carry an ambient socket; InheritedSocket is a\n15|// socket path handed to the process out of band; DefaultPath is the\n16|// operator default socket path; ConventionalName is the bare\n17|// conventional socket name. No member of this struct ever selects\n18|// the acquisition socket: ResolveSocket derives the socket from the\n19|// runtime directory and refuses any explicit override.\n20|type Ambient struct {\n21|\tTMUXEnv          string\n22|\tTMUXTmpDir       string\n23|\tInheritedSocket  string\n24|\tDefaultPath      string\n25|\tConventionalName string\n26|}\n27|\n28|// Ambient environment variable names. Both are validated by the\n29|// landed environment-name grammar at the observation boundary, so a\n30|// misspelled variable cannot smuggle an ambient value past the\n31|// non-use proof.\n32|const (\n33|\t// EnvTMUX is the tmux(1) session environment variable.\n34|\tEnvTMUX = \"TMUX\"\n35|\t// EnvTMUXTmpDir is the tmux(1) socket-directory override.\n36|\tEnvTMUXTmpDir = \"TMUX_TMPDIR\"\n37|)\n38|\n39|// ConventionalSocketName is the operator default socket leaf that AX\n40|// must never resolve to.\n41|const ConventionalSocketName = \"default\"\n42|\n43|// ObserveAmbient records the ambient socket facts visible to the\n44|// caller without using any of them. The lookup is caller-supplied so\n45|// the production entry never reads the process environment itself:\n46|// ambient discovery cannot hide in an os.Getenv call this package\n47|// never makes. The observation is evidence only; resolution derives\n48|// the socket from the runtime directory and never reads it.\n49|func ObserveAmbient(lookup func(name string) (string, bool), inherited, defPath, conventional string) (Ambient, error) {\n50|\tobserved := Ambient{\n51|\t\tInheritedSocket:  inherited,\n52|\t\tDefaultPath:      defPath,\n53|\t\tConventionalName: conventional,\n54|\t}\n55|\tif lookup == nil {\n56|\t\treturn observed, nil\n57|\t}\n58|\tif value, ok := lookup(EnvTMUX); ok {\n59|\t\tobserved.TMUXEnv = value\n60|\t}\n61|\tif value, ok := lookup(EnvTMUXTmpDir); ok {\n62|\t\tobserved.TMUXTmpDir = value\n63|\t}\n64|\treturn observed, nil\n65|}\n66|\n67|// SocketPath derives the dedicated server socket from the runtime\n68|// directory. It is the only socket constructor: acquisition never\n69|// substitutes an ambient value for its result.\n70|func SocketPath(runtimeDir string) string {\n71|\treturn filepath.Join(runtimeDir, SocketName)\n72|}\n73|\n74|// ResolveSocket returns the acquisition socket for the runtime\n75|// directory. An explicit override refuses with the ambient code no\n76|// matter which vector supplied it: there is no override surface,\n77|// only the derived socket. The ambient observation is carried for\n78|// evidence and asserted disjoint from the result by the caller\n79|// tests; resolution never reads it.\n80|func ResolveSocket(runtimeDir string, override string, ambient Ambient) (string, error) {\n81|\tif override != \"\" {\n82|\t\treturn \"\", &Error{Code: CodeAmbientReuse, Detail: \"socket override\"}\n83|\t}\n84|\tsocket := SocketPath(runtimeDir)\n85|\tif err := checkAmbientDisjoint(socket, ambient); err != nil {\n86|\t\treturn \"\", err\n87|\t}\n88|\treturn socket, nil\n89|}\n90|\n91|// checkAmbientDisjoint refuses the degenerate case where an ambient\n92|// value already names the derived socket: using the socket then\n93|// would be indistinguishable from reusing the ambient server, so\n94|// acquisition refuses instead of proceeding on an ambiguous fact.\n95|// The comparison runs over cleaned spellings, so an ambient value\n96|// that names the socket through a `/./` segment or a doubled\n97|// separator refuses like the byte-identical spelling. A symlink\n98|// alias of the root that resolves to the same socket is not\n99|// detected and stays a stated bound.\n100|func checkAmbientDisjoint(socket string, ambient Ambient) error {\n101|\tfor _, candidate := range []string{\n102|\t\tambient.TMUXEnv,\n103|\t\tambient.TMUXTmpDir,\n104|\t\tambient.InheritedSocket,\n105|\t\tambient.DefaultPath,\n106|\t\tambient.ConventionalName,\n107|\t} {\n108|\t\tif candidate != \"\" && filepath.Clean(candidate) == socket {\n109|\t\t\treturn &Error{Code: CodeAmbientReuse, Detail: \"ambient collision\"}\n110|\t\t}\n111|\t}\n112|\treturn nil\n113|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c537","stream":{"kind":"session","id":"01a0c45a-c3aa-73a1-9c84-6d5fc23e6787"},"sequence":246,"recorded_at":1780531400000487,"record_type":"event","durability":"durable","causation_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","run_stream":{"kind":"run","id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d"},"call_id":"call_01a0c45b5a8375b1a95e060ff3a90001","text":"Read text file `internal/tmuxserver/readiness.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n5|)\n6|\n7|// RealmAdmission is the landed admission verdict over the exact tmux\n8|// server: the Reconcile/ResolveEvidence Admitted set plus the AX-known\n9|// raw generation the admission binds to. Production probes report this\n10|// verdict; tests model probe reports. This leaf never re-decides what\n11|// the admission already proves — signature verification, liveness,\n12|// expiry, and the sentinel/smoke requirement coverage are the landed\n13|// terminalbackend owner's verdict, consumed here through Has — and\n14|// composes it only with the generation equality the wrapper owner\n15|// (internal/axpane checkRealm) already enforces: the admission's raw\n16|// generation must equal the request's typed generation, or the proof\n17|// is stale and refuses.\n18|//\n19|// There is deliberately no member for a cached sentinel result, a\n20|// managername observation, or any attested-server boolean: none\n21|// authorizes, so none is an input. A cached observation replayed as a\n22|// live one is exactly a stale-generation admission, and it refuses on\n23|// the generation arm.\n24|type RealmAdmission struct {\n25|\t// Admitted is the landed admission verdict.\n26|\tAdmitted terminalbackend.Admitted\n27|\t// RawGeneration is the AX-known raw generation the admission\n28|\t// binds to.\n29|\tRawGeneration string\n30|}\n31|\n32|// CheckServerAttested admits exactly an attested dedicated server:\n33|// the landed admission holds the credential_capable_execution_realm\n34|// row AND the admission's raw generation equals the request's typed\n35|// generation. Each arm refuses alone: a missing row refuses even with\n36|// a bound generation, and a wrong generation refuses even with an\n37|// admitted row, so weakening either arm admits a server the committed\n38|// tests pin.\n39|func CheckServerAttested(admission RealmAdmission, wantGeneration string) error {\n40|\tif !admission.Admitted.Has(realmCapability) {\n41|\t\treturn &Error{Code: CodeReadinessNotAuthorizing, Detail: \"server attestation\"}\n42|\t}\n43|\tif wantGeneration == \"\" || admission.RawGeneration != wantGeneration {\n44|\t\treturn &Error{Code: CodeReadinessNotAuthorizing, Detail: \"server generation\"}\n45|\t}\n46|\treturn nil\n47|}\n48|\n49|// BrokerPrincipal is the authenticated Aqua broker identity the\n50|// background path decides over. Per Section 4.4 the broker exposes\n51|// only authenticated, same-user, generation-bound terminal readiness,\n52|// so the principal carries the authenticated UID and the generation\n53|// its readiness binds to as typed, bound facts — never a bare\n54|// boolean. The UID is compared against the process identity, and the\n55|// generation against the request's typed generation.\n56|type BrokerPrincipal struct {\n57|\t// UID is the broker's authenticated user identity.\n58|\tUID uint32\n59|\t// Generation is the generation the broker readiness binds to.\n60|\tGeneration string\n61|}\n62|\n63|// BrokerReport is the live Aqua broker report the background path\n64|// decides over: the authenticated principal plus the attested AX tmux\n65|// server admission. Either fact missing means neither exists for the\n66|// purpose of the broker-or-refuse rule.\n67|type BrokerReport struct {\n68|\tPrincipal BrokerPrincipal\n69|\tServer    RealmAdmission\n70|}\n71|\n72|// CheckBrokerContact admits exactly the background MAY case: a\n73|// same-user authenticated broker principal AND a generation-bound\n74|// principal AND the attested AX tmux server admission bound to the\n75|// same typed generation. Every other report — a foreign-user broker,\n76|// an unbound principal, an unattested server, a stale admission —\n77|// refuses, and the caller maps the refusal to the typed\n78|// capability_unavailable the spec names.\n79|func CheckBrokerContact(report BrokerReport, wantGeneration string, currentUID uint32) error {\n80|\tif report.Principal.UID != currentUID {\n81|\t\treturn &Error{Code: CodeReadinessNotAuthorizing, Detail: \"broker authentication\"}\n82|\t}\n83|\tif report.Principal.Generation == \"\" || report.Principal.Generation != wantGeneration {\n84|\t\treturn &Error{Code: CodeReadinessNotAuthorizing, Detail: \"broker generation\"}\n85|\t}\n86|\treturn CheckServerAttested(report.Server, wantGeneration)\n87|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
