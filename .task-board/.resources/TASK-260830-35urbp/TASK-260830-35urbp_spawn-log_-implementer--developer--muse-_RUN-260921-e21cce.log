{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c525","stream":{"kind":"session","id":"01a0c45a-c3aa-73a1-9c84-6d5fc23e6787"},"sequence":237,"recorded_at":1780531400000469,"record_type":"event","durability":"durable","causation_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","run_stream":{"kind":"run","id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d"},"task_stream":{"kind":"task","id":"01a0c45b-5d4d-73f3-b4c3-b3965793581b"},"task_id":"01a0c45b-5d4d-73f3-b4c3-b3965793581b","event":{"kind":"output","task_id":"01a0c45b-5d4d-73f3-b4c3-b3965793581b","chunk":"Read text file `internal/tmuxserver/acquire.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n5|\t\"github.com/relux-works/agent-session-manager/internal/axpane\"\n6|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n7|)\n8|\n9|// Caller names the acquisition caller. The vocabulary is owned by\n10|// internal/axpane, which already gates the wrapper decision over it;\n11|// this package reuses its constants rather than retyping them.\n12|type Caller = string\n13|\n14|const (\n15|\t// CallerForeground is an interactive operator-side caller that\n16|\t// may create the dedicated server.\n17|\tCallerForeground = axpane.CallerForeground\n18|\t// CallerBackground is a background CLI, SSH RPC process,\n19|\t// daemon, or restore worker: it must never create a\n20|\t// credential-dependent tmux server, may contact an\n21|\t// already-running authenticated broker, and otherwise receives\n22|\t// capability_unavailable with no fallback to direct creation.\n23|\tCallerBackground = axpane.CallerBackground\n24|)\n25|\n26|// Acquisition outcomes name how the caller reached the dedicated\n27|// server. Exactly one applies; there is no combined or fallback\n28|// outcome.\n29|const (\n30|\t// ViaSpawned created the dedicated -S server on the foreground\n31|\t// path and returns its spawn argv.\n32|\tViaSpawned = \"spawned\"\n33|\t// ViaAttachedFound the dedicated server already running and\n34|\t// attested on the foreground path.\n35|\tViaAttached = \"attached-running\"\n36|\t// ViaBroker contacted the already-running authenticated Aqua\n37|\t// broker and its attested AX tmux server on the background\n38|\t// path. No local spawn argv exists on this path.\n39|\tViaBroker = \"broker\"\n40|)\n41|\n42|// realmCapability is the Section 4.D capability the background\n43|// typed refusal names: the exact instance passes the AX sentinel\n44|// and the provider-auth smoke without UI. The admission verdict is\n45|// the landed terminalbackend owner's; this package consumes it\n46|// through RealmAdmission and never re-decides it.\n47|const realmCapability = \"credential_capable_execution_realm\"\n48|\n49|// ServerReport is the live dedicated-server probe result: whether\n50|// the private socket answers, with the landed admission verdict over\n51|// the exact server when it does.\n52|type ServerReport struct {\n53|\tRunning   bool\n54|\tAdmission RealmAdmission\n55|}\n56|\n57|// Dependencies carries every external interaction acquisition\n58|// performs. This leaf ships the decision core and argv only: no\n59|// production probe or spawner implementation exists in the tree. The\n60|// exec/probe adapters — which report Reconcile/ResolveEvidence\n61|// verdicts and spawn through the built argv — and the server socket's\n62|// crash evidence are owned by the lifecycle leaf TASK-260830-1c28dz;\n63|// tests wire fakes. No probe runs without its dependency: a nil entry\n64|// refuses instead of reaching for a default.\n65|type Dependencies struct {\n66|\t// ProbeServer reports the dedicated socket's live state.\n67|\tProbeServer func(socket string) (ServerReport, error)\n68|\t// ProbeBroker reports the live Aqua broker state.\n69|\tProbeBroker func() (BrokerReport, error)\n70|\t// Spawn creates the dedicated server with the given -S argv.\n71|\tSpawn func(socket string, argv []string) error\n72|}\n73|\n74|// Request is the complete acquisition surface. There is deliberately\n75|// no member for a credential flag, a managername hint, or a cached\n76|// observation: the background creation rule needs no credential flag\n77|// because the background path never creates on any platform, and a\n78|// hint or cached observation never authorizes, so none is an input.\n79|type Request struct {\n80|\tCaller   Caller\n81|\tPlatform scalar.Platform\n82|\t// Root and Name select the runtime directory: Root is the AX\n83|\t// state root, Name is the runtime leaf (usually\n84|\t// RuntimeDirName). Foreground acquisition ensures the directory\n85|\t// idempotently; background acquisition verifies the existing\n86|\t// directory and never creates it.\n87|\tRoot string\n88|\tName string\n89|\t// Ambient carries the observed ambient socket facts for\n90|\t// evidence. Resolution never reads them; tests assert the\n91|\t// acquired socket equals none of them.\n92|\tAmbient Ambient\n93|\t// SocketOverride must be empty. Any caller-supplied socket —\n94|\t// whichever ambient vector supplied it — refuses.\n95|\tSocketOverride string\n96|\t// SessionID is the logical session the spawned server will\n97|\t// host, as canonical UUIDv7. It shapes spawn argv only.\n98|\tSessionID string\n99|\t// Generation, BrokerState, and Remediation are the typed\n100|\t// realm/readiness details the capability_unavailable refusal\n101|\t// carries. All three are required: an input that omits one\n102|\t// is malformed and refuses invalid_arguments instead of\n103|\t// emitting an untyped refusal. Generation is also the typed\n104|\t// generation every admission must bind to.\n105|\tGeneration  string\n106|\tBrokerState string\n107|\tRemediation string\n108|\tDeps        Dependencies\n109|}\n110|\n111|// Outcome is the one acquisition result.\n112|type Outcome struct {\n113|\tVia    string\n114|\tSocket string\n115|\t// Argv is the dedicated -S spawn argv. It is set only for\n116|\t// ViaSpawned: the broker path spawns nothing and the\n117|\t// attached path presents through sibling-owned attach\n118|\t// semantics, not through a second spawn vector.\n119|\tArgv []string\n120|}\n121|\n122|// Acquire resolves the dedicated server socket from the runtime\n123|// directory and reaches the server through the caller-appropriate\n124|// path. Foreground attaches to the running attested server or\n125|// spawns the dedicated -S server; background contacts the\n126|// already-running authenticated broker or receives the typed\n127|// capability_unavailable refusal, and never falls back to direct\n128|// server creation — there is no spawn call on the background path,\n129|// and every background test arms a spy spawner that fails the run\n130|// if it is ever invoked.\n131|//\n132|// Refusals precede side effects: malformed input, ambient reuse, and\n133|// missing dependencies all refuse before any directory is created,\n134|// and background acquisition verifies the runtime directory without\n135|// creating it, so a background caller performs no durable write.\n136|func Acquire(req Request) (Outcome, error) {\n137|\tif req.Caller != CallerForeground && req.Caller != CallerBackground {\n138|\t\treturn Outcome{}, &Error{Code: CodeInvalidArguments, Detail: \"caller\"}\n139|\t}\n140|\tif req.Generation == \"\" || req.BrokerState == \"\" || req.Remediation == \"\" {\n141|\t\treturn Outcome{}, &Error{Code: CodeInvalidArguments, Detail: \"realm details\"}\n142|\t}\n143|\tdir, err := lexicalRuntimePath(req.Root, req.Name, req.Platform)\n144|\tif err != nil {\n145|\t\treturn Outcome{}, err\n146|\t}\n147|\tsocket, err := ResolveSocket(dir, req.SocketOverride, req.Ambient)\n148|\tif err != nil {\n149|\t\treturn Outcome{}, err\n150|\t}\n151|\tif req.Caller == CallerBackground {\n152|\t\treturn acquireBackground(req, socket)\n153|\t}\n154|\treturn acquireForeground(req, socket)\n155|}\n156|\n157|// acquireBackground implements the broker-or-refuse rule: it may\n158|// contact the already-running authenticated broker and its attested\n159|// server, and when neither exists it returns capability_unavailable\n160|// with typed realm/readiness details. Direct server creation is not\n161|// the else branch — this function has no path to the spawner, on\n162|// any platform — and the runtime directory is verified, never\n163|// created here.\n164|func acquireBackground(req Request, socket string) (Outcome, error) {\n165|\tif req.Deps.ProbeBroker == nil {\n166|\t\treturn Outcome{}, &Error{Code: CodeInvalidArguments, Detail: \"dependencies\"}\n167|\t}\n168|\tif verr := VerifyRuntimeDir(req.Root, req.Name, req.Platform); verr != nil {\n169|\t\treturn Outcome{}, verr\n170|\t}\n171|\tstatus, err := req.Deps.ProbeBroker()\n172|\tif err != nil {\n173|\t\treturn Outcome{}, err\n174|\t}\n175|\tif err := CheckBrokerContact(status, req.Generation, currentUID()); err != nil {\n176|\t\t// The miss path creates nothing: it consults the creation\n177|\t\t// gate so the no-fallback rule is enforced by a call, not\n178|\t\t// by the absence of one. The gate refuses every background\n179|\t\t// caller; its refusal is expected here and the path reports\n180|\t\t// the typed unavailable the spec names. The else branch is\n181|\t\t// reachable only when the gate is weakened to admit a\n182|\t\t// background caller, and then it refuses with the creation\n183|\t\t// code instead of the typed unavailable, so the committed\n184|\t\t// background-miss tests redden.\n185|\t\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\n186|\t\t\treturn Outcome{}, backgroundUnavailable(req, err)\n187|\t\t}\n188|\t\treturn Outcome{}, &Error{Code: CodeBackgroundCreationRefused, Detail: \"background fallback\"}\n189|\t}\n190|\treturn Outcome{Via: ViaBroker, Socket: socket}, nil\n191|}\n192|\n193|// acquireForeground attaches to the running attested dedicated\n194|// server or spawns it. A running but unattested server refuses:\n195|// acquisition never attaches to a server whose landed admission is\n196|// missing or bound to another generation, and never repairs it here\n197|// — lifecycle owns that decision.\n198|func acquireForeground(req Request, socket string) (Outcome, error) {\n199|\tif req.Deps.ProbeServer == nil || req.Deps.Spawn == nil {\n200|\t\treturn Outcome{}, &Error{Code: CodeInvalidArguments, Detail: \"dependencies\"}\n201|\t}\n202|\tensured, err := EnsureRuntimeDir(req.Root, req.Name, req.Platform, nil)\n203|\tif err != nil {\n204|\t\treturn Outcome{}, err\n205|\t}\n206|\treport, err := req.Deps.ProbeServer(socket)\n207|\tif err != nil {\n208|\t\treturn Outcome{}, err\n209|\t}\n210|\tif report.Running {\n211|\t\tif err := CheckServerAttested(report.Admission, req.Generation); err != nil {\n212|\t\t\treturn Outcome{}, err\n213|\t\t}\n214|\t\treturn Outcome{Via: ViaAttached, Socket: socket}, nil\n215|\t}\n216|\targv, err := BuildArgv(ensured, socket, req.SessionID)\n217|\tif err != nil {\n218|\t\treturn Outcome{}, err\n219|\t}\n220|\tif err := req.Deps.Spawn(socket, argv); err != nil {\n221|\t\treturn Outcome{}, &Error{Code: CodeSpawnFailed, Detail: \"server spawn\"}\n222|\t}\n223|\treturn Outcome{Via: ViaSpawned, Socket: socket, Argv: argv}, nil\n224|}\n225|\n226|// checkCreationAllowed is the single choke point before every\n227|// direct server creation. A background caller never creates: on\n228|// macOS because server creation is credential-sensitive, and on\n229|// every platform because the background path must not fall back to\n230|// direct creation. The macOS credential-dependent case is one\n231|// fixture of this gate, not a narrower arm: narrowing the gate to\n232|// macOS or to credential-dependent servers would admit background\n233|// creation the no-fallback rule forbids. Foreground creation is\n234|// allowed on every platform; the credential binding it needs is\n235|// proven by the landed admission the server must present before\n236|// any attach.\n237|func checkCreationAllowed(caller Caller) error {\n238|\tif caller == CallerBackground {\n239|\t\treturn &Error{Code: CodeBackgroundCreationRefused, Detail: \"background creation\"}\n240|\t}\n241|\treturn nil\n242|}\n243|\n244|// backgroundUnavailable composes the typed capability_unavailable\n245|// refusal the spec names for the background miss, with the exact\n246|// Section 15.3 detail set. The constructor enforces the typed\n247|// details; a failure to render them is itself malformed input, not\n248|// an untyped refusal.\n249|func backgroundUnavailable(req Request, cause error) error {\n250|\tdetails := axerror.RealmEvidence{\n251|\t\tCapability:           realmCapability,\n252|\t\tCallerRealm:          req.Caller,\n253|\t\tBrokerState:          req.BrokerState,\n254|\t\tTmuxServerGeneration: req.Generation,\n255|\t\tRemediation:          req.Remediation,\n256|\t}\n257|\tfailure, err := axerror.NewRealmEvidenceUnavailable(axerror.Version130,\n258|\t\t\"no authenticated broker or attested tmux server\",\n259|\t\taxerror.NoIDs(), details, cause)\n260|\tif err != nil {\n261|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"realm details\"}\n262|\t}\n263|\treturn failure\n264|}","final_result":true}}}
