{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c521","stream":{"kind":"session","id":"01a0c45a-c3aa-73a1-9c84-6d5fc23e6787"},"sequence":235,"recorded_at":1780531400000465,"record_type":"event","durability":"durable","causation_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","run_stream":{"kind":"run","id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d"},"task_stream":{"kind":"task","id":"01a0c45b-5d6d-7ea0-be78-471a63c95f44"},"task_id":"01a0c45b-5d6d-7ea0-be78-471a63c95f44","event":{"kind":"output","task_id":"01a0c45b-5d6d-7ea0-be78-471a63c95f44","chunk":"Read text file `internal/tmuxserver/runtime.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"os\"\n5|\t\"strings\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n9|)\n10|\n11|// RuntimeDirName is the fixed leaf name of the AX tmux runtime\n12|// directory under the AX state root. It is AX-controlled vocabulary,\n13|// never an ambient or conventional tmux name.\n14|const RuntimeDirName = \"ax-tmux\"\n15|\n16|// Hooks arms the crash boundaries of EnsureRuntimeDir. AfterMkdir\n17|// runs after the directory entry is committed and before the parent\n18|// fsync; a crash there must leave a retry that converges to the one\n19|// verified directory. Hooks is nil in production.\n20|type Hooks struct {\n21|\tAfterMkdir func(dir string)\n22|}\n23|\n24|// EnsureRuntimeDir creates the owner-only runtime directory\n25|// root/name when absent and verifies it when present, returning the\n26|// joined path. Creation and verification enforce three independent\n27|// gates — containment, mode, ownership — and each refuses alone:\n28|//\n29|//   - containment: the root must be an absolute path on the platform\n30|//     grammar, the name must be one relative segment, and the commit\n31|//     opens the parent through a pinned directory handle and creates\n32|//     the leaf relative to that handle, so a symlinked intermediate\n33|//     directory cannot redirect the commit outside the root;\n34|//   - mode: the leaf must carry exactly 0700, enforced explicitly\n35|//     after creation because mkdir honors umask;\n36|//   - ownership: the leaf must belong to the effective UID.\n37|//\n38|// Lexical validation delegates to its landed owners (absolute root\n39|// and relative member to scalar, the join to secprim.Guard); the\n40|// descriptor-relative commit below is what this package owns, because\n41|// no landed helper commits a directory relative to a handle.\n42|//\n43|// On failure the returned path distinguishes the refusal phase: a\n44|// lexical refusal returns \"\", while a commit-phase refusal returns\n45|// the joined path alongside the error. Callers must check the error\n46|// first and never use the path when it is set; the split lets the\n47|// acquisition wiring narrow exactly the commit-phase class.\n48|func EnsureRuntimeDir(root, name string, platform scalar.Platform, hooks *Hooks) (string, error) {\n49|\tjoined, err := lexicalRuntimePath(root, name, platform)\n50|\tif err != nil {\n51|\t\treturn \"\", err\n52|\t}\n53|\treturn joined, commitRuntimeDir(root, name, joined, hooks)\n54|}\n55|\n56|// VerifyRuntimeDir enforces the three custody gates on an existing\n57|// runtime directory without creating it. Background acquisition calls\n58|// this instead of Ensure: the directory must already exist with exact\n59|// custody, and a missing directory refuses rather than being silently\n60|// created on the authorizing path. Foreground acquisition calls\n61|// Ensure, which provisions the directory it then verifies.\n62|func VerifyRuntimeDir(root, name string, platform scalar.Platform) error {\n63|\tif _, err := lexicalRuntimePath(root, name, platform); err != nil {\n64|\t\treturn err\n65|\t}\n66|\treturn verifyRuntimeDir(root, name)\n67|}\n68|\n69|// lexicalRuntimePath validates the root grammar, the name grammar,\n70|// and the lexical join. It answers the lexical question only; the\n71|// commit answers the filesystem question through a handle.\n72|func lexicalRuntimePath(root, name string, platform scalar.Platform) (string, error) {\n73|\tif _, err := scalar.ParsePlatform(string(platform)); err != nil {\n74|\t\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"runtime platform\"}\n75|\t}\n76|\t// Native Windows MUST NOT claim tmux or tmux resurrection\n77|\t// (pinned SPEC 1458), so the Windows platform refuses here on\n78|\t// every host, before any host-specific commit runs. Weakening\n79|\t// this arm reroutes a Windows request to the root refusal\n80|\t// instead of admitting it.\n81|\tif platform == scalar.PlatformWindows {\n82|\t\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"runtime platform\"}\n83|\t}\n84|\tif _, err := scalar.ParseAbsolutePath(platform, root); err != nil {\n85|\t\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"runtime root\"}\n86|\t}\n87|\tif err := checkRuntimeName(name); err != nil {\n88|\t\treturn \"\", err\n89|\t}\n90|\tguard, err := secprim.NewGuard(root, platform, []string{name})\n91|\tif err != nil {\n92|\t\treturn \"\", &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n93|\t}\n94|\tjoined, err := guard.Resolve(name)\n95|\tif err != nil {\n96|\t\treturn \"\", &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n97|\t}\n98|\treturn joined, nil\n99|}\n100|\n101|// checkRuntimeName admits exactly one relative path segment. The\n102|// shared grammar (absolute, parent, dot, empty, NUL, backslash,\n103|// encoded separators) is decided by scalar; this gate adds only the\n104|// single-segment rule scalar does not own, because the commit opens\n105|// the leaf relative to the pinned parent handle and a second segment\n106|// would name a path the handle walk never descends.\n107|func checkRuntimeName(name string) error {\n108|\tif _, err := scalar.ParseRelativePath(name); err != nil {\n109|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"runtime name\"}\n110|\t}\n111|\tif strings.Contains(name, \"/\") {\n112|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"runtime name\"}\n113|\t}\n114|\treturn nil\n115|}\n116|\n117|// sameDirectory compares two stat results for directory identity. It\n118|// is a variable only so seam-failure tests can force the\n119|// handle-mismatch path through the production entries: a handle that\n120|// names a different directory than the path cannot be staged without\n121|// a filesystem race, and without the seam the mismatch branch is\n122|// untestable. Production code never reassigns it.\n123|var sameDirectory = os.SameFile\n124|\n125|// handleBoundToPath reports whether the open directory handle refers\n126|// to the same directory as rootPath. It mirrors the private\n127|// secprim.guardRootMatches check, which no caller outside secprim\n128|// can invoke: a stat failure on either side is not a match, and an\n129|// unreadable root fails closed into the mismatch refusal rather\n130|// than admitting an unverifiable handle.\n131|func handleBoundToPath(handle *os.File, rootPath string) bool {\n132|\thandleInfo, err := handle.Stat()\n133|\tif err != nil || handleInfo == nil {\n134|\t\treturn false\n135|\t}\n136|\tpathInfo, err := os.Stat(rootPath)\n137|\tif err != nil || pathInfo == nil {\n138|\t\treturn false\n139|\t}\n140|\treturn sameDirectory(handleInfo, pathInfo)\n141|}","final_result":true}}}
