{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c81b","stream":{"kind":"session","id":"01a0c45a-c3aa-73a1-9c84-6d5fc23e6787"},"sequence":616,"recorded_at":1780531400001227,"record_type":"event","durability":"durable","causation_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","run_stream":{"kind":"run","id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d"},"task_stream":{"kind":"task","id":"01a0c45c-532b-7ba2-a996-91c9e54c74df"},"task_id":"01a0c45c-532b-7ba2-a996-91c9e54c74df","event":{"kind":"output","task_id":"01a0c45c-532b-7ba2-a996-91c9e54c74df","chunk":"Read text file `internal/tmuxserver/tmuxserver_test.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n12|)\n13|\n14|const (\n15|\tfixtureSession       = \"0198f4c8-7d40-7e55-8e6f-1234567890ab\"\n16|\tfixtureGeneration    = \"generation-7\"\n17|\tfixtureStaleGen      = \"generation-6\"\n18|\tfixtureBroker        = \"absent\"\n19|\tfixtureRemedy        = \"sign in to the GUI realm and retry\"\n20|\tfixtureDecoyCapacity = \"headless_creation\"\n21|)\n22|\n23|// realmAdmitted models a probe-reported landed admission holding the\n24|// credential realm row: in production the probe reports the\n25|// Reconcile/ResolveEvidence verdict, and tests model the report.\n26|func realmAdmitted() terminalbackend.Admitted {\n27|\treturn terminalbackend.Admitted{Capabilities: []string{\"credential_capable_execution_realm\"}}\n28|}\n29|\n30|// boundAdmission models a live admission bound to the request's typed\n31|// generation.\n32|func boundAdmission() RealmAdmission {\n33|\treturn RealmAdmission{Admitted: realmAdmitted(), RawGeneration: fixtureGeneration}\n34|}\n35|\n36|// staleAdmission models yesterday's live proof replayed today: the\n37|// row is admitted but bound to the previous generation.\n38|func staleAdmission() RealmAdmission {\n39|\treturn RealmAdmission{Admitted: realmAdmitted(), RawGeneration: fixtureStaleGen}\n40|}\n41|\n42|// brokerReport models a live broker report: a same-user principal\n43|// bound to the typed generation plus the bound server admission.\n44|func brokerReport() BrokerReport {\n45|\treturn BrokerReport{\n46|\t\tPrincipal: BrokerPrincipal{UID: currentUID(), Generation: fixtureGeneration},\n47|\t\tServer:    boundAdmission(),\n48|\t}\n49|}\n50|\n51|// foreignUID stages a broker principal the same-user arm must refuse\n52|// without privilege: the test identity shifted out of range.\n53|func foreignUID() uint32 { return currentUID() + 100000 }\n54|\n55|func validRequest(t *testing.T, root string) Request {\n56|\tt.Helper()\n57|\treturn Request{\n58|\t\tCaller:      CallerForeground,\n59|\t\tPlatform:    scalar.PlatformMacOS,\n60|\t\tRoot:        root,\n61|\t\tName:        RuntimeDirName,\n62|\t\tSessionID:   fixtureSession,\n63|\t\tGeneration:  fixtureGeneration,\n64|\t\tBrokerState: fixtureBroker,\n65|\t\tRemediation: fixtureRemedy,\n66|\t}\n67|}\n68|\n69|func hostileAmbient() Ambient {\n70|\treturn Ambient{\n71|\t\tTMUXEnv:          \"/tmp/tmux-501/default,12345,0\",\n72|\t\tTMUXTmpDir:       \"/tmp/operator-tmux\",\n73|\t\tInheritedSocket:  \"/tmp/inherited.sock\",\n74|\t\tDefaultPath:      \"/tmp/tmux-501/default\",\n75|\t\tConventionalName: \"default\",\n76|\t}\n77|}\n78|\n79|func requireLocalError(t *testing.T, err error, code, detail string) {\n80|\tt.Helper()\n81|\tif err == nil {\n82|\t\tt.Fatalf(\"err = nil, want %s at %s\", code, detail)\n83|\t}\n84|\tvar local *Error\n85|\tif !errors.As(err, &local) {\n86|\t\tt.Fatalf(\"err type = %T (%v), want *tmuxserver.Error\", err, err)\n87|\t}\n88|\tif local.Code != code || local.Detail != detail {\n89|\t\tt.Fatalf(\"err = %s at %s, want %s at %s\", local.Code, local.Detail, code, detail)\n90|\t}\n91|}\n92|\n93|func requireCapabilityUnavailable(t *testing.T, err error, caller, broker, generation, remedy string) {\n94|\tt.Helper()\n95|\tif err == nil {\n96|\t\tt.Fatal(\"err = nil, want capability_unavailable\")\n97|\t}\n98|\tvar failure *axerror.Error\n99|\tif !errors.As(err, &failure) {\n100|\t\tt.Fatalf(\"err type = %T (%v), want *axerror.Error\", err, err)\n101|\t}\n102|\tif string(failure.Code()) != \"capability_unavailable\" {\n103|\t\tt.Fatalf(\"code = %q, want %q\", string(failure.Code()), \"capability_unavailable\")\n104|\t}\n105|\tif failure.ExitCode() != 6 {\n106|\t\tt.Fatalf(\"exit = %d, want 6\", failure.ExitCode())\n107|\t}\n108|\twant := map[string]string{\n109|\t\t\"capability\":             \"credential_capable_execution_realm\",\n110|\t\t\"caller_realm\":           caller,\n111|\t\t\"broker_state\":           broker,\n112|\t\t\"tmux_server_generation\": generation,\n113|\t\t\"remediation\":            remedy,\n114|\t}\n115|\tfor key, value := range want {\n116|\t\tgot, ok := failure.Detail(key)\n117|\t\tif !ok {\n118|\t\t\tt.Fatalf(\"missing typed detail %q\", key)\n119|\t\t}\n120|\t\tif got != value {\n121|\t\t\tt.Fatalf(\"detail %q = %v, want %q\", key, got, value)\n122|\t\t}\n123|\t}\n124|}\n125|\n126|type spawnSpy struct {\n127|\tcalls  int\n128|\tsocket string\n129|\targv   []string\n130|\terr    error\n131|}\n132|\n133|func (spy *spawnSpy) spawn(socket string, argv []string) error {\n134|\tspy.calls++\n135|\tspy.socket = socket\n136|\tspy.argv = append([]string(nil), argv...)\n137|\treturn spy.err\n138|}\n139|\n140|func stateRoot(t *testing.T) string {\n141|\tt.Helper()\n142|\troot := t.TempDir()\n143|\tif err := os.Chmod(root, 0o755); err != nil {\n144|\t\tt.Fatal(err)\n145|\t}\n146|\treturn root\n147|}\n148|\n149|func runtimeDir(t *testing.T, root string) string {\n150|\tt.Helper()\n151|\tdir, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n152|\tif err != nil {\n153|\t\tt.Fatal(err)\n154|\t}\n155|\treturn dir\n156|}\n157|\n158|func TestSocketPathDerivesOnlyFromRuntimeDir(t *testing.T) {\n159|\tdir := filepath.Join(t.TempDir(), RuntimeDirName)\n160|\tif got := SocketPath(dir); got != filepath.Join(dir, \"ax-tmux.sock\") {\n161|\t\tt.Fatalf(\"SocketPath = %q\", got)\n162|\t}\n163|}","final_result":true}}}
