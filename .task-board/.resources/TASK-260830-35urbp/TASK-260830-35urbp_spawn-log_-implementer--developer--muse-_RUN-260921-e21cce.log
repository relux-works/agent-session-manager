{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca71","stream":{"kind":"session","id":"01a0c45a-c3aa-73a1-9c84-6d5fc23e6787"},"sequence":915,"recorded_at":1780531400001825,"record_type":"event","durability":"durable","causation_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","run_stream":{"kind":"run","id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d"},"task_stream":{"kind":"task","id":"01a0c45d-2c50-7832-9ad7-810e1bffbd98"},"task_id":"01a0c45d-2c50-7832-9ad7-810e1bffbd98","event":{"kind":"output","task_id":"01a0c45d-2c50-7832-9ad7-810e1bffbd98","chunk":"{\n  \"chunk_id\": \"exec-14-1\",\n  \"command\": \"sed -n '1,80p' internal/hosttrust/custody_unix.go 2>/dev/null || ls internal/hosttrust/\",\n  \"description\": \"Read hosttrust custody precedent\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"//go:build !windows\\n\\npackage hosttrust\\n\\nimport (\\n\\t\\\"errors\\\"\\n\\t\\\"io/fs\\\"\\n\\t\\\"os\\\"\\n\\t\\\"syscall\\\"\\n)\\n\\n// platformModeOK reports whether Unix permission bits satisfy the exact\\n// owner-only requirement. Any group/world access already refuses here.\\nfunc platformModeOK(info fs.FileInfo, mode fs.FileMode) bool {\\n\\treturn info.Mode().Perm() == mode\\n}\\n\\n// secureStaged is a no-op on Unix: staging files are created with exact\\n// owner-only modes, which the caller verifies after install.\\nfunc secureStaged(_ string, _ bool) error { return nil }\\n\\n// verifyOwner enforces owner-only custody on Unix: the path must belong to\\n// the effective UID. Mode bits are checked by the caller against the exact\\n// 0700/0600 requirement, so any group/world access already refused there.\\nfunc verifyOwner(_ string, info fs.FileInfo) error {\\n\\tstat, ok := info.Sys().(*syscall.Stat_t)\\n\\tif !ok {\\n\\t\\treturn trustError(TrustError{Operation: \\\"inspect ownership\\\", Err: errors.Join(ErrTrustUnsafeCustody, errors.New(\\\"ownership metadata unavailable\\\"))})\\n\\t}\\n\\tif stat.Uid != uint32(os.Geteuid()) {\\n\\t\\treturn trustError(TrustError{Operation: \\\"inspect ownership\\\", Err: ErrTrustUnsafeCustody})\\n\\t}\\n\\treturn nil\\n}\\n\",\n  \"original_output_bytes\": 1161,\n  \"original_output_tokens\": 291,\n  \"truncated\": false\n}","final_result":true}}}
