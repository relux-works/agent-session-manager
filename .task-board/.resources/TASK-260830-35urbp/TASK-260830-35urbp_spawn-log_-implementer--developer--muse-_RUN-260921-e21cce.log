{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8ed","stream":{"kind":"session","id":"01a0c45a-c3aa-73a1-9c84-6d5fc23e6787"},"sequence":721,"recorded_at":1780531400001437,"record_type":"event","durability":"durable","causation_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","run_stream":{"kind":"run","id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d"},"task_stream":{"kind":"task","id":"01a0c45c-7902-7821-b148-dceeb7217af9"},"task_id":"01a0c45c-7902-7821-b148-dceeb7217af9","event":{"kind":"output","task_id":"01a0c45c-7902-7821-b148-dceeb7217af9","chunk":"Read text file `internal/tmuxserver/mutant_harness.py`.\n(499 line(s) above)\n500|        note=\"Admits exactly the PID-form session past our wiring of the landed UUIDv7 grammar; every other malformed session still refuses.\",\n501|    ),\n502|    Mutant(\n503|        name=\"N-deps-background\",\n504|        path=f\"{PACKAGE}/acquire.go\",\n505|        find=\"\\tif req.Deps.ProbeBroker == nil {\\n\",\n506|        replace=\"\\tif req.Deps.ProbeBroker == nil && req.Deps.Spawn == nil {\\n\",\n507|        count=1,\n508|        run=\"TestAcquireBackgroundNilBrokerWithSpawnRefuses\",\n509|        expect=\"KILLED\",\n510|        note=\"Admits exactly the nil-probe-with-spawn background request past the dependencies arm; the fully-nil request still refuses. Kill path: the admitted request reaches Verify and refuses with the custody code instead of the dependencies code.\",\n511|    ),\n512|    Mutant(\n513|        name=\"N-deps-foreground\",\n514|        path=f\"{PACKAGE}/acquire.go\",\n515|        find=\"\\tif req.Deps.ProbeServer == nil || req.Deps.Spawn == nil {\\n\",\n516|        replace=\"\\tif req.Deps.ProbeServer == nil && req.Deps.Spawn == nil {\\n\",\n517|        count=1,\n518|        run=\"TestAcquireForegroundNilSpawnWithProbeRefuses\",\n519|        expect=\"KILLED\",\n520|        note=\"Admits exactly the half-nil foreground dependencies past the arm; fully-nil dependencies still refuse. Kill path: the admitted request panics on the nil spawn, and the panic fails the test.\",\n521|    ),\n522|    Mutant(\n523|        name=\"D-background-fallback\",\n524|        path=f\"{PACKAGE}/acquire.go\",\n525|        find=\"\\t\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\n\\t\\t\\treturn Outcome{}, backgroundUnavailable(req, err)\\n\\t\\t}\\n\",\n526|        replace=\"\\t\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\n\\t\\t\\tif req.Deps.Spawn != nil {\\n\\t\\t\\t\\t_ = req.Deps.Spawn(socket, nil)\\n\\t\\t\\t}\\n\\t\\t\\treturn Outcome{}, backgroundUnavailable(req, err)\\n\\t\\t}\\n\",\n527|        count=1,\n528|        run=BG_MISS_LINUX,\n529|        expect=\"KILLED\",\n530|        note=\"SUPPLEMENTARY ADDITIVE, not a narrowing: plants the reviewer-shaped direct-creation call on the background miss path. Kill path: every background-miss spy asserts zero spawn calls.\",\n531|    ),\n532|    Mutant(\n533|        name=\"C-control\",\n534|        path=f\"{PACKAGE}/errors.go\",\n535|        find=\"// Error is a package-local refusal. Code is one of the Code*\",\n536|        replace=\"// Error is a package-local refusal (harness control: comment-only). Code is one of the Code*\",\n537|        count=1,\n538|        run=\"TestSocketPathDerivesOnlyFromRuntimeDir\",\n539|        expect=\"SURVIVED\",\n540|        note=\"Harmless control: a comment-only edit that must SURVIVE, proving the harness observes outcomes.\",\n541|    ),\n542|]\n543|\n544|\n545|def apply(mutant: Mutant, original: str) -> str:\n546|    return original.replace(mutant.find, mutant.replace)\n547|\n548|\n549|def run_mutant(mutant: Mutant, log_dir: Path | None) -> str:\n550|    target = REPO / mutant.path\n551|    original = target.read_text()\n552|    found = original.count(mutant.find)\n553|    if found != mutant.count:\n554|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\"\n555|    with tempfile.TemporaryDirectory() as staging:\n556|        backup = Path(staging) / \"backup\"\n557|        shutil.copy2(target, backup)\n558|        try:\n559|            target.write_text(apply(mutant, original))\n560|            run = subprocess.run(\n561|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n562|                cwd=REPO,\n563|                capture_output=True,\n564|                text=True,\n565|                timeout=300,\n566|            )\n567|        finally:\n568|            shutil.copy2(backup, target)\n569|    output = (run.stdout + run.stderr).strip()\n570|    if os.environ.get(\"AX_MUTANT_VERBOSE\") == \"1\":\n571|        print(f\"--- raw: {mutant.name}: exit {run.returncode} ---\", flush=True)\n572|        print(output, flush=True)\n573|        print(f\"--- end raw: {mutant.name} ---\", flush=True)\n574|    if log_dir is not None:\n575|        (log_dir / f\"{mutant.name}.log\").write_text(\n576|            f\"exit: {run.returncode}\\nrun: go test ./{PACKAGE}/ -run {mutant.run} -count=1\\n\\n{output}\\n\"\n577|        )\n578|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n579|        return f\"ERROR: {mutant.name}: build broke under the patch\"\n580|    if run.returncode == 0:\n581|        verdict = \"SURVIVED\"\n582|    elif '--- FAIL' in output or 'FAIL:' in output:\n583|        verdict = \"KILLED\"\n584|    else:\n585|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\"\n586|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n587|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note} [exit {run.returncode}]\"\n588|\n589|\n590|def main(argv: list[str]) -> int:\n591|    log_dir: Path | None = None\n592|    names = list(argv)\n593|    if \"--log-dir\" in names:\n594|        idx = names.index(\"--log-dir\")\n595|        if idx + 1 >= len(names):\n596|            print(\"--log-dir needs a directory\")\n597|            return 2\n598|        log_dir = Path(names[idx + 1])\n599|        log_dir.mkdir(parents=True, exist_ok=True)\n600|        del names[idx : idx + 2]\n601|    selected = [m for m in MUTANTS if not names or m.name in names]\n602|    if names and len(selected) != len(names):\n603|        unknown = sorted(set(names) - {m.name for m in selected})\n604|        print(f\"unknown mutants: {', '.join(unknown)}\")\n605|        return 2\n606|    failures = 0\n607|    for mutant in selected:\n608|        try:\n609|            line = run_mutant(mutant, log_dir)\n610|        except subprocess.TimeoutExpired:\n611|            line = f\"ERROR: {mutant.name}: killer timed out\"\n612|        print(line, flush=True)\n613|        if not line.startswith(\"ok:\"):\n614|            failures += 1\n615|    return 1 if failures else 0\n616|\n617|\n618|if __name__ == \"__main__\":\n619|    sys.exit(main(sys.argv[1:]))","final_result":true}}}
