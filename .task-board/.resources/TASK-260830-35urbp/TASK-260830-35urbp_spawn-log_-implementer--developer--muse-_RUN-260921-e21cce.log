{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c817","stream":{"kind":"session","id":"01a0c45a-c3aa-73a1-9c84-6d5fc23e6787"},"sequence":614,"recorded_at":1780531400001223,"record_type":"event","durability":"durable","causation_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","run_stream":{"kind":"run","id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d"},"task_stream":{"kind":"task","id":"01a0c45c-5348-7b83-aa6e-4097b6449746"},"task_id":"01a0c45c-5348-7b83-aa6e-4097b6449746","event":{"kind":"output","task_id":"01a0c45c-5348-7b83-aa6e-4097b6449746","chunk":"Read text file `internal/tmuxserver/socket_test.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"path/filepath\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|)\n8|\n9|func TestObserveAmbientRecordsWithoutUsing(t *testing.T) {\n10|\thostile := hostileAmbient()\n11|\tobserved, err := ObserveAmbient(func(name string) (string, bool) {\n12|\t\tswitch name {\n13|\t\tcase \"TMUX\":\n14|\t\t\treturn hostile.TMUXEnv, true\n15|\t\tcase \"TMUX_TMPDIR\":\n16|\t\t\treturn hostile.TMUXTmpDir, true\n17|\t\tdefault:\n18|\t\t\treturn \"\", false\n19|\t\t}\n20|\t}, hostile.InheritedSocket, hostile.DefaultPath, hostile.ConventionalName)\n21|\tif err != nil {\n22|\t\tt.Fatal(err)\n23|\t}\n24|\tif observed != hostile {\n25|\t\tt.Fatalf(\"observed = %+v, want %+v\", observed, hostile)\n26|\t}\n27|}\n28|\n29|func TestObserveAmbientNilLookupKeepsOutOfBand(t *testing.T) {\n30|\tobserved, err := ObserveAmbient(nil, \"/tmp/x.sock\", \"/tmp/tmux-501/default\", \"default\")\n31|\tif err != nil {\n32|\t\tt.Fatal(err)\n33|\t}\n34|\tif observed.TMUXEnv != \"\" || observed.TMUXTmpDir != \"\" {\n35|\t\tt.Fatalf(\"nil lookup observed env: %+v\", observed)\n36|\t}\n37|\tif observed.InheritedSocket != \"/tmp/x.sock\" {\n38|\t\tt.Fatalf(\"observed = %+v\", observed)\n39|\t}\n40|}\n41|\n42|func TestResolveSocketDerivesIgnoringAmbient(t *testing.T) {\n43|\tdir := runtimeDir(t, stateRoot(t))\n44|\tsocket, err := ResolveSocket(dir, \"\", hostileAmbient())\n45|\tif err != nil {\n46|\t\tt.Fatal(err)\n47|\t}\n48|\tif socket != SocketPath(dir) {\n49|\t\tt.Fatalf(\"socket = %q\", socket)\n50|\t}\n51|\tfor _, ambient := range []string{\n52|\t\thostileAmbient().TMUXEnv,\n53|\t\thostileAmbient().TMUXTmpDir,\n54|\t\thostileAmbient().InheritedSocket,\n55|\t\thostileAmbient().DefaultPath,\n56|\t\thostileAmbient().ConventionalName,\n57|\t} {\n58|\t\tif strings.Contains(socket, ambient) || socket == ambient {\n59|\t\t\tt.Fatalf(\"socket %q reuses ambient %q\", socket, ambient)\n60|\t\t}\n61|\t}\n62|}\n63|\n64|func TestResolveSocketRefusesEveryOverrideVector(t *testing.T) {\n65|\tdir := runtimeDir(t, stateRoot(t))\n66|\thostile := hostileAmbient()\n67|\tvectors := map[string]string{\n68|\t\t\"environment variable\": hostile.TMUXEnv,\n69|\t\t\"tmux tmpdir\":          hostile.TMUXTmpDir,\n70|\t\t\"inherited socket\":     hostile.InheritedSocket,\n71|\t\t\"default path\":         hostile.DefaultPath,\n72|\t\t\"conventional name\":    hostile.ConventionalName,\n73|\t}\n74|\tfor name, override := range vectors {\n75|\t\tt.Run(name, func(t *testing.T) {\n76|\t\t\t_, err := ResolveSocket(dir, override, Ambient{})\n77|\t\t\trequireLocalError(t, err, \"tmux_ambient_server_reuse\", \"socket override\")\n78|\t\t})\n79|\t}\n80|}\n81|\n82|func TestResolveSocketRefusesAmbientCollision(t *testing.T) {\n83|\tdir := runtimeDir(t, stateRoot(t))\n84|\tderived := SocketPath(dir)\n85|\tfor _, tc := range []struct {\n86|\t\tname    string\n87|\t\tambient Ambient\n88|\t}{\n89|\t\t{\"tmux env\", Ambient{TMUXEnv: derived}},\n90|\t\t{\"tmux tmpdir\", Ambient{TMUXTmpDir: derived}},\n91|\t\t{\"inherited socket\", Ambient{InheritedSocket: derived}},\n92|\t\t{\"default path\", Ambient{DefaultPath: derived}},\n93|\t\t{\"conventional name\", Ambient{ConventionalName: derived}},\n94|\t} {\n95|\t\tt.Run(tc.name, func(t *testing.T) {\n96|\t\t\t_, err := ResolveSocket(dir, \"\", tc.ambient)\n97|\t\t\trequireLocalError(t, err, \"tmux_ambient_server_reuse\", \"ambient collision\")\n98|\t\t})\n99|\t}\n100|}\n101|\n102|// The collision gate compares cleaned spellings: an ambient value that\n103|// names the derived socket through a `/./` segment or a doubled\n104|// separator refuses like the byte-identical spelling. Each alias is\n105|// asserted to clean to the derived socket so the row cannot pass on a\n106|// non-colliding value.\n107|func TestResolveSocketRefusesAmbientCollisionUncleanSpellings(t *testing.T) {\n108|\tdir := runtimeDir(t, stateRoot(t))\n109|\tderived := SocketPath(dir)\n110|\tfor _, tc := range []struct {\n111|\t\tname  string\n112|\t\talias string\n113|\t}{\n114|\t\t{\"dot segment\", dir + \"/./\" + SocketName},\n115|\t\t{\"doubled separator\", dir + \"//\" + SocketName},\n116|\t} {\n117|\t\tt.Run(tc.name, func(t *testing.T) {\n118|\t\t\tif got := filepath.Clean(tc.alias); got != derived {\n119|\t\t\t\tt.Fatalf(\"alias %q cleans to %q, want the derived socket %q\", tc.alias, got, derived)\n120|\t\t\t}\n121|\t\t\tif tc.alias == derived {\n122|\t\t\t\tt.Fatalf(\"alias %q is byte-identical; the row is vacuous\", tc.alias)\n123|\t\t\t}\n124|\t\t\t_, err := ResolveSocket(dir, \"\", Ambient{DefaultPath: tc.alias})\n125|\t\t\trequireLocalError(t, err, \"tmux_ambient_server_reuse\", \"ambient collision\")\n126|\t\t})\n127|\t}\n128|}","final_result":true}}}
