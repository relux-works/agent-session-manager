{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca2d","stream":{"kind":"session","id":"01a0c45a-c3aa-73a1-9c84-6d5fc23e6787"},"sequence":881,"recorded_at":1780531400001757,"record_type":"event","durability":"durable","causation_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","run_stream":{"kind":"run","id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d"},"task_stream":{"kind":"task","id":"01a0c45d-1d7d-7901-8eda-bfc293378363"},"task_id":"01a0c45d-1d7d-7901-8eda-bfc293378363","event":{"kind":"output","task_id":"01a0c45d-1d7d-7901-8eda-bfc293378363","chunk":"Read text file `internal/localstore/paths.go`.\n(229 line(s) above)\n230|\t\tif _, duplicate := seenFlags[document.Flag]; duplicate {\n231|\t\t\treturn nil, fmt.Errorf(\"%w: duplicate flag %q\", ErrPathRegistry, document.Flag)\n232|\t\t}\n233|\t\tif _, duplicate := seenEnvironment[document.Environment]; duplicate {\n234|\t\t\treturn nil, fmt.Errorf(\"%w: duplicate environment %q\", ErrPathRegistry, document.Environment)\n235|\t\t}\n236|\t\tseenClasses[document.Class] = struct{}{}\n237|\t\tseenFlags[document.Flag] = struct{}{}\n238|\t\tseenEnvironment[document.Environment] = struct{}{}\n239|\t\tdefinitions = append(definitions, PathDefinition(document))\n240|\t}\n241|\treturn definitions, nil\n242|}\n243|\n244|func validPathClass(class PathClass) bool {\n245|\tswitch class {\n246|\tcase PathConfig, PathData, PathState, PathCache, PathRuntime:\n247|\t\treturn true\n248|\tdefault:\n249|\t\treturn false\n250|\t}\n251|}\n252|\n253|func validPathValueKind(class PathClass, kind PathValueKind) bool {\n254|\tif class == PathConfig {\n255|\t\treturn kind == PathValueConfigurationFile\n256|\t}\n257|\treturn kind == PathValueDirectory\n258|}\n259|\n260|// ResolvePaths is the production deterministic path-resolution entry point.\n261|// Callers capture flags, environment, home, and temporary inputs once, then\n262|// keep the returned roots for the process lifetime.\n263|func ResolvePaths(request ResolveRequest) (ResolvedPaths, error) {\n264|\t// This early refusal keeps the public error anchored to the platform input.\n265|\t// It is independently subsumed by scalar.ParseAbsolutePath below, which\n266|\t// calls scalar.ParsePlatform for every row in the pinned non-empty registry.\n267|\tif _, err := scalar.ParsePlatform(request.Platform.String()); err != nil {\n268|\t\treturn ResolvedPaths{}, fmt.Errorf(\"%w: platform: %v\", ErrInvalidPath, err)\n269|\t}\n270|\tdefinitions, err := PathDefinitions()\n271|\tif err != nil {\n272|\t\treturn ResolvedPaths{}, err\n273|\t}\n274|\tknownFlags := make(map[string]struct{}, len(definitions))\n275|\tfor _, definition := range definitions {\n276|\t\tknownFlags[definition.Flag] = struct{}{}\n277|\t}\n278|\tfor flag := range request.Flags {\n279|\t\tif _, ok := knownFlags[flag]; !ok {\n280|\t\t\treturn ResolvedPaths{}, fmt.Errorf(\"%w: %s\", ErrUnknownPathFlag, flag)\n281|\t\t}\n282|\t}\n283|\tresolved := ResolvedPaths{platform: request.Platform, paths: make(map[PathClass]ResolvedPath, len(definitions))}\n284|\tfor _, definition := range definitions {\n285|\t\tcandidate := \"\"\n286|\t\tsource := PathSource(\"\")\n287|\t\tif value, present := request.Flags[definition.Flag]; present {\n288|\t\t\tif value == \"\" {\n289|\t\t\t\treturn ResolvedPaths{}, &PathResolutionError{\n290|\t\t\t\t\tClass:  definition.Class,\n291|\t\t\t\t\tSource: PathSourceFlag,\n292|\t\t\t\t\tErr:    fmt.Errorf(\"%w: %s must not be empty\", ErrInvalidPath, definition.Flag),\n293|\t\t\t\t}\n294|\t\t\t}\n295|\t\t\tcandidate = value\n296|\t\t\tsource = PathSourceFlag\n297|\t\t} else if value, present := environmentValue(request, definition.Environment); present && value != \"\" {\n298|\t\t\tcandidate = value\n299|\t\t\tsource = PathSourceEnvironment\n300|\t\t} else {\n301|\t\t\tcandidate, err = platformDefault(request, definition.Class)\n302|\t\t\tif err != nil {\n303|\t\t\t\treturn ResolvedPaths{}, &PathResolutionError{Class: definition.Class, Source: PathSourceDefault, Err: err}\n304|\t\t\t}\n305|\t\t\tsource = PathSourceDefault\n306|\t\t}\n307|\t\tcandidate, parseErr := makeAbsoluteCandidate(request.Platform, candidate, request.WorkingDir)\n308|\t\tif parseErr != nil {\n309|\t\t\treturn ResolvedPaths{}, &PathResolutionError{\n310|\t\t\t\tClass:  definition.Class,\n311|\t\t\t\tSource: source,\n312|\t\t\t\tErr:    fmt.Errorf(\"%w: %s: %v\", ErrInvalidPath, definition.Class, parseErr),\n313|\t\t\t}\n314|\t\t}\n315|\t\tabsolute, parseErr := scalar.ParseAbsolutePath(request.Platform, candidate)\n316|\t\tif parseErr != nil {\n317|\t\t\treturn ResolvedPaths{}, &PathResolutionError{\n318|\t\t\t\tClass:  definition.Class,\n319|\t\t\t\tSource: source,\n320|\t\t\t\tErr:    fmt.Errorf(\"%w: %s: %v\", ErrInvalidPath, definition.Class, parseErr),\n321|\t\t\t}\n322|\t\t}\n323|\t\tresolved.paths[definition.Class] = ResolvedPath{Class: definition.Class, Value: absolute, Source: source}\n324|\t}\n325|\treturn resolved, nil\n326|}\n327|\n328|func platformDefault(request ResolveRequest, class PathClass) (string, error) {\n329|\tjoin := func(elements ...string) string { return joinPlatform(request.Platform, elements...) }\n330|\tswitch request.Platform {\n331|\tcase scalar.PlatformMacOS:\n332|\t\tif class == PathRuntime {\n333|\t\t\ttemporary, err := requireAbsoluteInput(request.Platform, \"temporary directory\", request.TemporaryDir)\n334|\t\t\tif err != nil {\n335|\t\t\t\treturn \"\", err\n336|\t\t\t}\n337|\t\t\treturn join(temporary, \"ax\"), nil\n338|\t\t}\n339|\t\thome, err := requireAbsoluteInput(request.Platform, \"home directory\", request.HomeDir)\n340|\t\tif err != nil {\n341|\t\t\treturn \"\", err\n342|\t\t}\n343|\t\tswitch class {\n344|\t\tcase PathConfig:\n345|\t\t\tconfigBase, err := optionalAbsoluteEnvironment(request, \"XDG_CONFIG_HOME\", join(home, \".config\"))\n346|\t\t\tif err != nil {\n347|\t\t\t\treturn \"\", err\n348|\t\t\t}\n349|\t\t\treturn join(configBase, \"ax\", \"config.toml\"), nil\n350|\t\tcase PathData:\n351|\t\t\treturn join(home, \"Library\", \"Application Support\", \"ax\"), nil\n352|\t\tcase PathState:\n353|\t\t\treturn join(home, \"Library\", \"Application Support\", \"ax\", \"state\"), nil\n354|\t\tcase PathCache:\n355|\t\t\treturn join(home, \"Library\", \"Caches\", \"ax\"), nil\n356|\t\t}\n357|\tcase scalar.PlatformLinux, scalar.PlatformWSL2:\n358|\t\tif class == PathRuntime {\n359|\t\t\truntimeBase, present := environmentValue(request, \"XDG_RUNTIME_DIR\")\n(more lines below)","final_result":true}}}
