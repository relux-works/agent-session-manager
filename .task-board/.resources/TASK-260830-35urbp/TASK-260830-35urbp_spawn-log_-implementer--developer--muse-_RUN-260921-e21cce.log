{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c58d","stream":{"kind":"session","id":"01a0c45a-c3aa-73a1-9c84-6d5fc23e6787"},"sequence":289,"recorded_at":1780531400000573,"record_type":"event","durability":"durable","causation_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","run_stream":{"kind":"run","id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d"},"task_stream":{"kind":"task","id":"01a0c45b-6e28-71e2-a4ba-d87d26846550"},"task_id":"01a0c45b-6e28-71e2-a4ba-d87d26846550","event":{"kind":"output","task_id":"01a0c45b-6e28-71e2-a4ba-d87d26846550","chunk":"Read text file `internal/tmuxserver/runtime_unix.go`.\n1|//go:build !windows\n2|\n3|package tmuxserver\n4|\n5|import (\n6|\t\"errors\"\n7|\t\"os\"\n8|\n9|\t\"golang.org/x/sys/unix\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n12|)\n13|\n14|// commitRuntimeDir creates the leaf relative to the pinned root\n15|// handle and verifies exact custody on the opened descriptor. The\n16|// root itself must already exist: this entry creates exactly one\n17|// leaf and never builds parents, so a missing root refuses instead\n18|// of materializing an arbitrary ancestor chain with owner-only\n19|// modes. Mkdirat from the handle closes the validate-then-create\n20|// TOCTOU a path-string MkdirAll leaves open: descriptors pin what\n21|// they opened, and the leaf name is one grammar-checked segment.\n22|func commitRuntimeDir(root, name, joined string, hooks *Hooks) error {\n23|\t// No platform arm here: the lexical path already refused the\n24|\t// Windows platform on every host, so only unix platforms reach\n25|\t// this commit.\n26|\trootHandle, err := secprim.OpenNoFollowDir(root)\n27|\tif err != nil {\n28|\t\tif os.IsNotExist(err) || errors.Is(err, os.ErrNotExist) {\n29|\t\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"runtime root\"}\n30|\t\t}\n31|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n32|\t}\n33|\tdefer func() { _ = rootHandle.Close() }()\n34|\tif !handleBoundToPath(rootHandle, root) {\n35|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n36|\t}\n37|\trootFd := int(rootHandle.Fd())\n38|\tcreated := true\n39|\tif err := unix.Mkdirat(rootFd, name, 0o700); err != nil {\n40|\t\tif !errors.Is(err, unix.EEXIST) {\n41|\t\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime commit\"}\n42|\t\t}\n43|\t\tcreated = false\n44|\t}\n45|\tif hooks != nil && hooks.AfterMkdir != nil {\n46|\t\thooks.AfterMkdir(joined)\n47|\t}\n48|\tleafFd, err := unix.Openat(rootFd, name,\n49|\t\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\n50|\tif err != nil {\n51|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n52|\t}\n53|\tleaf := os.NewFile(uintptr(leafFd), joined)\n54|\tif created {\n55|\t\t// The mkdir mode honors umask, so the exact owner-only\n56|\t\t// mode is enforced explicitly on a leaf this call\n57|\t\t// created. An existing leaf is verified, never\n58|\t\t// repaired: silently narrowing a widened directory\n59|\t\t// would mask the custody violation.\n60|\t\tif err := unix.Fchmod(leafFd, 0o700); err != nil {\n61|\t\t\t_ = leaf.Close()\n62|\t\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\n63|\t\t}\n64|\t}\n65|\tinfo, err := leaf.Stat()\n66|\tif err != nil {\n67|\t\t_ = leaf.Close()\n68|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\n69|\t}\n70|\t// The openat O_DIRECTORY flag already refused a non-directory\n71|\t// leaf above; the mode comparison below is the load-bearing\n72|\t// arm this gate's tests and mutants pin.\n73|\tif info.Mode().Perm() != 0o700 {\n74|\t\t_ = leaf.Close()\n75|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\n76|\t}\n77|\tif err := verifyOwnership(info); err != nil {\n78|\t\t_ = leaf.Close()\n79|\t\treturn err\n80|\t}\n81|\t// The parent fsync persists the directory entry; without it a\n82|\t// crash after mkdir can lose the leaf on journaling filesystems.\n83|\tif err := unix.Fsync(rootFd); err != nil {\n84|\t\t_ = leaf.Close()\n85|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime commit\"}\n86|\t}\n87|\t_ = leaf.Close()\n88|\treturn nil\n89|}\n90|\n91|// verifyRuntimeDir enforces the three custody gates on an existing\n92|// leaf without creating it. A missing leaf refuses: absence on the\n93|// authorizing path is a fact, never a silent repair.\n94|func verifyRuntimeDir(root, name string) error {\n95|\t// No platform arm here, for the same reason as the commit arm\n96|\t// above: only unix platforms reach this verify.\n97|\trootHandle, err := secprim.OpenNoFollowDir(root)\n98|\tif err != nil {\n99|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n100|\t}\n101|\tdefer func() { _ = rootHandle.Close() }()\n102|\tif !handleBoundToPath(rootHandle, root) {\n103|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n104|\t}\n105|\tleafFd, err := unix.Openat(int(rootHandle.Fd()), name,\n106|\t\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\n107|\tif err != nil {\n108|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n109|\t}\n110|\tleaf := os.NewFile(uintptr(leafFd), name)\n111|\tdefer func() { _ = leaf.Close() }()\n112|\tinfo, err := leaf.Stat()\n113|\tif err != nil {\n114|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\n115|\t}\n116|\tif info.Mode().Perm() != 0o700 {\n117|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\n118|\t}\n119|\treturn verifyOwnership(info)\n120|}","final_result":true}}}
