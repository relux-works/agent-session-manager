{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c81f","stream":{"kind":"session","id":"01a0c45a-c3aa-73a1-9c84-6d5fc23e6787"},"sequence":618,"recorded_at":1780531400001231,"record_type":"event","durability":"durable","causation_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d","run_stream":{"kind":"run","id":"892d0e23-8edf-4e7b-8430-1bc89cf9b07d"},"task_stream":{"kind":"task","id":"01a0c45c-530b-7911-86f6-37d41b427feb"},"task_id":"01a0c45c-530b-7911-86f6-37d41b427feb","event":{"kind":"output","task_id":"01a0c45c-530b-7911-86f6-37d41b427feb","chunk":"Read text file `internal/tmuxserver/acquire_test.go`.\n(499 line(s) above)\n500|\t\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"runtime platform\")\n501|\t}\n502|}\n503|\n504|func TestAcquireRefusesMissingRealmDetails(t *testing.T) {\n505|\tbase := validRequest(t, stateRoot(t))\n506|\tfor _, tc := range []struct {\n507|\t\tname   string\n508|\t\tmutate func(*Request)\n509|\t}{\n510|\t\t{\"generation\", func(r *Request) { r.Generation = \"\" }},\n511|\t\t{\"broker state\", func(r *Request) { r.BrokerState = \"\" }},\n512|\t\t{\"remediation\", func(r *Request) { r.Remediation = \"\" }},\n513|\t} {\n514|\t\tt.Run(tc.name, func(t *testing.T) {\n515|\t\t\treq := base\n516|\t\t\ttc.mutate(&req)\n517|\t\t\t_, err := Acquire(req)\n518|\t\t\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"realm details\")\n519|\t\t})\n520|\t}\n521|}\n522|\n523|func TestAcquireRefusesMissingDependencies(t *testing.T) {\n524|\troot := stateRoot(t)\n525|\tforeground := validRequest(t, root)\n526|\t_, err := Acquire(foreground)\n527|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"dependencies\")\n528|\tbackground := validRequest(t, root)\n529|\tbackground.Caller = CallerBackground\n530|\t_, err = Acquire(background)\n531|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"dependencies\")\n532|}\n533|\n534|func TestAcquireCreatesRuntimeDirIdempotently(t *testing.T) {\n535|\troot := stateRoot(t)\n536|\tmake := func() Request {\n537|\t\treq := validRequest(t, root)\n538|\t\tspy := &spawnSpy{}\n539|\t\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n540|\t\t\treturn ServerReport{}, nil\n541|\t\t}\n542|\t\treq.Deps.Spawn = spy.spawn\n543|\t\treturn req\n544|\t}\n545|\tfirst, err := Acquire(make())\n546|\tif err != nil {\n547|\t\tt.Fatal(err)\n548|\t}\n549|\tsecond, err := Acquire(make())\n550|\tif err != nil {\n551|\t\tt.Fatal(err)\n552|\t}\n553|\tif first.Socket != second.Socket {\n554|\t\tt.Fatalf(\"sockets differ: %q vs %q\", first.Socket, second.Socket)\n555|\t}\n556|}\n557|\n558|func TestAcquireBackgroundNilBrokerWithSpawnRefuses(t *testing.T) {\n559|\troot := stateRoot(t)\n560|\treq := validRequest(t, root)\n561|\treq.Caller = CallerBackground\n562|\tspy := &spawnSpy{}\n563|\treq.Deps.Spawn = spy.spawn\n564|\t_, err := Acquire(req)\n565|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"dependencies\")\n566|\tif spy.calls != 0 {\n567|\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n568|\t}\n569|}\n570|\n571|func TestAcquireForegroundNilSpawnWithProbeRefuses(t *testing.T) {\n572|\troot := stateRoot(t)\n573|\treq := validRequest(t, root)\n574|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n575|\t\treturn ServerReport{}, nil\n576|\t}\n577|\t_, err := Acquire(req)\n578|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"dependencies\")\n579|}\n580|\n581|func TestCheckCreationAllowedRefusesBackground(t *testing.T) {\n582|\trequireLocalError(t, checkCreationAllowed(CallerBackground), \"tmux_background_creation_refused\", \"background creation\")\n583|\tif err := checkCreationAllowed(CallerForeground); err != nil {\n584|\t\tt.Fatalf(\"foreground creation refused: %v\", err)\n585|\t}\n586|}","final_result":true}}}
