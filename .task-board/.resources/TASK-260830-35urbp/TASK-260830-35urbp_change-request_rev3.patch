+        find="\tif err := secprim.CheckArgv(argv); err != nil {\n",
+        replace='\tif err := secprim.CheckArgv(argv); err != nil && argv[0] != "tmux" {\n',
+        count=1,
+        run="TestBuildArgvRefusesInvalidArgvShape",
+        expect="KILLED",
+        note="Admits exactly our tmux-headed spawn vector past the landed shape wiring; any other vector still refuses. Other failing shapes are unstageable through the fixed-shape builder and are disclosed, not pinned.",
+    ),
+    Mutant(
+        name="N-argv-session",
+        path=f"{PACKAGE}/argv.go",
+        find="\tsession, err := scalar.ParseUUIDv7(sessionID)\n\tif err != nil {\n",
+        replace='\tsession, err := scalar.ParseUUIDv7(sessionID)\n\tif err != nil && sessionID != "12345" {\n',
+        count=1,
+        run="(TestBuildArgvRefusesMalformedSession|TestAcquireForegroundRefusesMalformedSession)",
