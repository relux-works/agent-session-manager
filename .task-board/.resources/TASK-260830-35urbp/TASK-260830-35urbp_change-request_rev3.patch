+        find="\tif verr := VerifyRuntimeDir(req.Root, req.Name, req.Platform); verr != nil {\n\t\treturn Outcome{}, verr\n\t}\n",
+        replace='\tif verr := VerifyRuntimeDir(req.Root, req.Name, req.Platform); verr != nil && verr.Error() != "tmux server refused: tmux_unsafe_runtime_dir at runtime mode" {\n\t\treturn Outcome{}, verr\n\t}\n',
+        count=1,
+        run="TestAcquireBackgroundStagesVerifyCustodyRefusal",
+        expect="KILLED",
+        note="Admits exactly mode refusals past the background verify wiring; absence and every other custody refusal still refuse. Kill path: the entry contacts the broker past a widened mode.",
+    ),
+    Mutant(
+        name="N-spawn-swallow",
+        path=f"{PACKAGE}/acquire.go",
+        find="\tif err := req.Deps.Spawn(socket, argv); err != nil {\n",
+        replace='\tif err := req.Deps.Spawn(socket, argv); err != nil && err.Error() != "exec failed" {\n',
+        count=1,
+        run="TestAcquireForegroundSpawnFailureReportsWithoutFallback",
+        expect="KILLED",
+        note="Admits exactly the fixture spawn failure as success; every other spawn failure still reports.",
+    ),
+    Mutant(
+        name="N-probe-swallow-foreground",
+        path=f"{PACKAGE}/acquire.go",
+        find="\treport, err := req.Deps.ProbeServer(socket)\n\tif err != nil {\n",
+        replace='\treport, err := req.Deps.ProbeServer(socket)\n\tif err != nil && err.Error() != "probe boom" {\n',
+        count=1,
+        run="TestAcquireForegroundProbeFailurePassesThrough",
+        expect="KILLED",
+        note="Admits exactly the fixture probe failure as an absent server (then spawns); every other probe failure still passes through.",
+    ),
+    Mutant(
+        name="N-probe-swallow-background",
+        path=f"{PACKAGE}/acquire.go",
+        find="\tstatus, err := req.Deps.ProbeBroker()\n\tif err != nil {\n",
+        replace='\tstatus, err := req.Deps.ProbeBroker()\n\tif err != nil && err.Error() != "probe boom" {\n',
+        count=1,
+        run="TestAcquireBackgroundProbeFailurePassesThrough",
+        expect="KILLED",
