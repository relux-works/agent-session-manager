+    ),
+    Mutant(
+        name="N-deps-foreground",
+        path=f"{PACKAGE}/acquire.go",
+        find="\tif req.Deps.ProbeServer == nil || req.Deps.Spawn == nil {\n",
+        replace="\tif req.Deps.ProbeServer == nil && req.Deps.Spawn == nil {\n",
+        count=1,
