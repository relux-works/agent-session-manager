{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c73d","stream":{"kind":"session","id":"01a0c40c-7a6a-7610-adaa-109852fda585"},"sequence":505,"recorded_at":1780531400001005,"record_type":"event","durability":"durable","causation_id":"be2f90a4-329e-4dfe-906d-93614b40b7f2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"be2f90a4-329e-4dfe-906d-93614b40b7f2","run_stream":{"kind":"run","id":"be2f90a4-329e-4dfe-906d-93614b40b7f2"},"call_id":"call_01a0c40d9927709ba397b52c8f66863d","text":"Read text file `internal/tmuxserver/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for internal/tmuxserver.\n3|\n4|Every gate ships a narrowing mutant: the gate stays present and is\n5|weakened to admit exactly one member of the class it must reject, and\n6|the named killer tests must fail. A delete-only mutant proves only that\n7|the gate exists and is not accepted as evidence; row D-background-fallback\n8|is the one explicitly supplementary additive plant (the reviewer-shaped\n9|direct-creation call on the background path), labeled as such and not\n10|counted as any gate's narrowing.\n11|\n12|Each row runs M (mutate production files in place), R (run the scoped Go\n13|killers through the production entries), V (verdict from the Go exit code\n14|plus a FAIL kill-line: KILLED iff R fails with a test failure line,\n15|SURVIVED iff R passes, ERROR for anything else -- unapplied patches,\n16|build breaks, timeouts). M failures and R infrastructure errors are\n17|ERROR, never kills or survivals. Files are restored from backups after\n18|every row, pass or fail.\n19|\n20|Row C-control is the harmless control: a comment-only edit that must\n21|SURVIVE, proving the harness observes test outcomes instead of\n22|hard-coding kills.\n23|\n24|Usage:\n25|  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py\n26|  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py N-mode-create\n27|  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py --log-dir /tmp/mutant-logs\n28|  AX_MUTANT_VERBOSE=1 PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py N-mode-create\n29|\"\"\"\n30|\n31|import os\n32|import shutil\n33|import subprocess\n34|import sys\n35|import tempfile\n36|from dataclasses import dataclass\n37|from pathlib import Path\n38|\n39|REPO = Path(__file__).resolve().parents[2]\n40|PACKAGE = \"internal/tmuxserver\"\n41|\n42|\n43|@dataclass(frozen=True)\n44|class Mutant:\n45|    name: str\n46|    path: str\n47|    find: str\n48|    replace: str\n49|    count: int\n50|    run: str\n51|    expect: str\n52|    note: str\n53|\n54|\n55|BG_MISS = \"TestAcquireBackgroundMissReturnsTypedUnavailable\"\n56|BG_MISS_LINUX = \"(TestAcquireBackgroundMissReturnsTypedUnavailable|TestAcquireBackgroundMissOnLinuxAlsoRefusesWithoutFallback)\"\n57|OVERRIDE = \"TestAcquireRefusesEveryAmbientOverrideVector\"\n58|WIDENED = \"TestEnsureRuntimeDirRefusesWidenedMode\"\n59|COLLISION = \"(TestResolveSocketRefusesAmbientCollision|TestAcquireRefusesAmbientCollision)\"\n60|\n61|MUTANTS = [\n62|    Mutant(\n63|        name=\"N-mode-create\",\n64|        path=f\"{PACKAGE}/runtime_unix.go\",\n65|        find=\"\\t// leaf above; the mode comparison below is the load-bearing\\n\\t// arm this gate's tests and mutants pin.\\n\\tif info.Mode().Perm() != 0o700 {\\n\",\n66|        replace=\"\\t// leaf above; the mode comparison below is the load-bearing\\n\\t// arm this gate's tests and mutants pin.\\n\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o755 {\\n\",\n67|        count=1,\n68|        run=WIDENED,\n69|        expect=\"KILLED\",\n70|        note=\"Admits exactly 0755 at the create-path mode arm; other widened modes still refuse. Kill path: Ensure stops refusing.\",\n71|    ),\n72|    Mutant(\n73|        name=\"N-mode-verify\",\n74|        path=f\"{PACKAGE}/runtime_unix.go\",\n75|        find='\\tinfo, err := leaf.Stat()\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\\n\\t}\\n\\tif info.Mode().Perm() != 0o700 {\\n',\n76|        replace='\\tinfo, err := leaf.Stat()\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\\n\\t}\\n\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o755 {\\n',\n77|        count=1,\n78|        run=WIDENED,\n79|        expect=\"KILLED\",\n80|        note=\"Admits exactly 0755 at the verify-path mode arm; the create arm still refuses. Kill path: Verify stops refusing.\",\n81|    ),\n82|    Mutant(\n83|        name=\"N-fchmod-umask\",\n84|        path=f\"{PACKAGE}/runtime_unix.go\",\n85|        find=\"\\tif created {\\n\",\n86|        replace=\"\\tif created && os.Geteuid() == 0 {\\n\",\n87|        count=1,\n88|        run=\"TestEnsureRuntimeDirEnforcesModeUnderRestrictiveUmask\",\n89|        expect=\"KILLED\",\n90|        note=\"Admits exactly non-root creates past the explicit post-mkdirat chmod; root creates still chmod. Kill path: under umask 0177 the leaf stays 0600 and the mode gate refuses. Non-root load-bearing, like the same-shaped reviewer plant.\",\n91|    ),\n92|    Mutant(\n93|        name=\"N-ownership-uid\",\n94|        path=f\"{PACKAGE}/ownership_unix.go\",\n95|        find=\"\\tif stat.Uid != uint32(effectiveUID()) {\\n\",\n96|        replace=\"\\tif stat.Uid != uint32(effectiveUID()) && stat.Uid != uint32(effectiveUID())-100000 {\\n\",\n97|        count=1,\n98|        run=\"TestEnsureRuntimeDirRefusesForeignOwnership\",\n99|        expect=\"KILLED\",\n100|        note=\"Admits exactly the seam-shifted foreign UID; every other foreign UID still refuses.\",\n101|    ),\n102|    Mutant(\n103|        name=\"N-containment-slash\",\n104|        path=f\"{PACKAGE}/runtime.go\",\n105|        find='\\tif strings.Contains(name, \"/\") {\\n',\n106|        replace='\\tif strings.Contains(name, \"/\") && name != \"a/b\" {\\n',\n107|        count=1,\n108|        run=\"TestEnsureRuntimeDirRefusesBadNames\",\n109|        expect=\"KILLED\",\n110|        note=\"Admits exactly the nested a/b name past the single-segment arm; every other multi-segment name still refuses. Kill reroutes to the commit refusal.\",\n111|    ),\n112|    Mutant(\n113|        name=\"N-containment-mismatch\",\n114|        path=f\"{PACKAGE}/runtime.go\",\n115|        find=\"\\treturn sameDirectory(handleInfo, pathInfo)\\n\",\n116|        replace=\"\\treturn sameDirectory(handleInfo, pathInfo) || handleInfo.IsDir()\\n\",\n117|        count=1,\n118|        run=\"TestEnsureRuntimeDirRefusesHandleMismatch\",\n119|        expect=\"KILLED\",\n120|        note=\"Admits exactly directory handles past the handle-binding check; the mismatch still refuses for non-directories.\",\n121|    ),\n122|    Mutant(\n123|        name=\"N-containment-symlink\",\n124|        path=f\"{PACKAGE}/runtime_unix.go\",\n125|        find=\"\\tleafFd, err := unix.Openat(rootFd, name,\\n\\t\\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\",\n126|        replace=\"\\tleafFd, err := unix.Openat(rootFd, name,\\n\\t\\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\tif err != nil {\\n\\t\\tleafFd, err = unix.Openat(rootFd, name,\\n\\t\\t\\tunix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\t}\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\",\n127|        count=1,\n128|        run=\"TestEnsureRuntimeDirRefusesSymlinkLeaf\",\n129|        expect=\"KILLED\",\n130|        note=\"Admits exactly symlink leaves via an ELOOP fallback open; every other commit failure still refuses.\",\n131|    ),\n132|    Mutant(\n133|        name=\"N-containment-symlink-verify\",\n134|        path=f\"{PACKAGE}/runtime_unix.go\",\n135|        find=\"\\tleafFd, err := unix.Openat(int(rootHandle.Fd()), name,\\n\\t\\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\",\n136|        replace=\"\\tleafFd, err := unix.Openat(int(rootHandle.Fd()), name,\\n\\t\\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\tif err != nil {\\n\\t\\tleafFd, err = unix.Openat(int(rootHandle.Fd()), name,\\n\\t\\t\\tunix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\t}\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\",\n137|        count=1,\n138|        run=\"TestVerifyRuntimeDirRefusesSymlinkLeaf\",\n139|        expect=\"KILLED\",\n140|        note=\"Admits exactly symlink leaves via an ELOOP fallback open on the verify side; the commit side still refuses. Kill path: Verify follows the leaf and the mode gate passes on the target.\",\n141|    ),\n142|    Mutant(\n143|        name=\"N-root-wiring\",\n144|        path=f\"{PACKAGE}/runtime.go\",\n145|        find='\\tif _, err := scalar.ParseAbsolutePath(platform, root); err != nil {\\n\\t\\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"runtime root\"}\\n\\t}\\n',\n146|        replace='\\tif _, err := scalar.ParseAbsolutePath(platform, root); err != nil && root != \"relative/root\" {\\n\\t\\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"runtime root\"}\\n\\t}\\n',\n147|        count=1,\n148|        run=\"TestEnsureRuntimeDirRefusesBadRoots\",\n149|        expect=\"KILLED\",\n150|        note=\"Admits exactly the relative-root fixture past our wiring of the landed grammar; every other malformed root still refuses. Kill reroutes to the guard refusal.\",\n151|    ),\n152|    Mutant(\n153|        name=\"N-platform-wiring\",\n154|        path=f\"{PACKAGE}/runtime.go\",\n155|        find=\"\\tif _, err := scalar.ParsePlatform(string(platform)); err != nil {\\n\",\n156|        replace='\\tif _, err := scalar.ParsePlatform(string(platform)); err != nil && platform != \"plan9\" {\\n',\n157|        count=1,\n158|        run=\"TestEnsureRuntimeDirRefusesBadPlatform\",\n159|        expect=\"KILLED\",\n160|        note=\"Admits exactly the plan9 platform past our wiring of the landed vocabulary; every other unknown platform still refuses. Kill reroutes to the root refusal.\",\n161|    ),\n162|    Mutant(\n163|        name=\"N-platform-windows\",\n164|        path=f\"{PACKAGE}/runtime.go\",\n165|        find=\"\\tif platform == scalar.PlatformWindows {\\n\",\n166|        replace='\\tif platform == scalar.PlatformWindows && root != \"C:\\\\\\\\ax-state\" {\\n',\n167|        count=1,\n168|        run=\"TestEnsureRuntimeDirRefusesWindowsOnUnixHost\",\n169|        expect=\"KILLED\",\n170|        note=\"Admits exactly the C: fixture root past the lexical Windows refusal; every other Windows root still refuses there. Kill reroutes to the root refusal, which reports runtime root instead of runtime platform.\",\n171|    ),\n172|    Mutant(\n173|        name=\"N-override-env\",\n174|        path=f\"{PACKAGE}/socket.go\",\n175|        find='\\tif override != \"\" {\\n',\n176|        replace='\\tif override != \"\" && override != \"/tmp/tmux-501/default,12345,0\" {\\n',\n177|        count=1,\n178|        run=f\"{OVERRIDE}/environment_variable\",\n179|        expect=\"KILLED\",\n180|        note=\"Admits exactly the TMUX environment value as an override; the other four vectors still refuse.\",\n181|    ),\n182|    Mutant(\n183|        name=\"N-override-inherited\",\n184|        path=f\"{PACKAGE}/socket.go\",\n185|        find='\\tif override != \"\" {\\n',\n186|        replace='\\tif override != \"\" && override != \"/tmp/inherited.sock\" {\\n',\n187|        count=1,\n188|        run=f\"{OVERRIDE}/inherited_socket\",\n189|        expect=\"KILLED\",\n190|        note=\"Admits exactly the inherited socket as an override; the other four vectors still refuse.\",\n191|    ),\n192|    Mutant(\n193|        name=\"N-override-default\",\n194|        path=f\"{PACKAGE}/socket.go\",\n195|        find='\\tif override != \"\" {\\n',\n196|        replace='\\tif override != \"\" && override != \"/tmp/tmux-501/default\" {\\n',\n197|        count=1,\n198|        run=f\"{OVERRIDE}/default_path\",\n199|        expect=\"KILLED\",\n200|        note=\"Admits exactly the default path as an override; the other four vectors still refuse.\",\n201|    ),\n202|    Mutant(\n203|        name=\"N-override-conventional\",\n204|        path=f\"{PACKAGE}/socket.go\",\n205|        find='\\tif override != \"\" {\\n',\n206|        replace='\\tif override != \"\" && override != \"default\" {\\n',\n207|        count=1,\n208|        run=f\"{OVERRIDE}/conventional_name\",\n209|        expect=\"KILLED\",\n210|        note=\"Admits exactly the conventional name as an override; the other four vectors still refuse.\",\n211|    ),\n212|    Mutant(\n213|        name=\"N-override-tmpdir\",\n214|        path=f\"{PACKAGE}/socket.go\",\n215|        find='\\tif override != \"\" {\\n',\n216|        replace='\\tif override != \"\" && override != \"/tmp/operator-tmux\" {\\n',\n217|        count=1,\n218|        run=f\"{OVERRIDE}/tmux_tmpdir\",\n219|        expect=\"KILLED\",\n220|        note=\"Admits exactly the TMUX_TMPDIR value as an override — the member tmux uses to relocate its default socket directory; the other four vectors still refuse.\",\n221|    ),\n222|    Mutant(\n223|        name=\"N-collision\",\n224|        path=f\"{PACKAGE}/socket.go\",\n225|        find='\\tif candidate != \"\" && candidate == socket {\\n',\n226|        replace='\\tif candidate != \"\" && candidate == socket && candidate != ambient.DefaultPath {\\n',\n227|        count=1,\n228|        run=f\"{COLLISION}/default_path\",\n229|        expect=\"KILLED\",\n230|        note=\"Admits exactly the default-path collision; collisions on the other four ambient members still refuse.\",\n231|    ),\n232|    Mutant(\n233|        name=\"N-collision-inherited\",\n234|        path=f\"{PACKAGE}/socket.go\",\n235|        find='\\tif candidate != \"\" && candidate == socket {\\n',\n236|        replace='\\tif candidate != \"\" && candidate == socket && candidate != ambient.InheritedSocket {\\n',\n237|        count=1,\n238|        run=f\"{COLLISION}/inherited_socket\",\n239|        expect=\"KILLED\",\n240|        note=\"Admits exactly the inherited-socket collision; the other four members still refuse.\",\n241|    ),\n242|    Mutant(\n243|        name=\"N-collision-tmuxenv\",\n244|        path=f\"{PACKAGE}/socket.go\",\n245|        find='\\tif candidate != \"\" && candidate == socket {\\n',\n246|        replace='\\tif candidate != \"\" && candidate == socket && candidate != ambient.TMUXEnv {\\n',\n247|        count=1,\n248|        run=f\"{COLLISION}/tmux_env\",\n249|        expect=\"KILLED\",\n250|        note=\"Admits exactly the TMUX-env collision; the other four members still refuse.\",\n251|    ),\n252|    Mutant(\n253|        name=\"N-collision-tmpdir\",\n254|        path=f\"{PACKAGE}/socket.go\",\n255|        find='\\tif candidate != \"\" && candidate == socket {\\n',\n256|        replace='\\tif candidate != \"\" && candidate == socket && candidate != ambient.TMUXTmpDir {\\n',\n257|        count=1,\n258|        run=f\"{COLLISION}/tmux_tmpdir\",\n259|        expect=\"KILLED\",\n260|        note=\"Admits exactly the TMUX_TMPDIR collision; the other four members still refuse.\",\n261|    ),\n262|    Mutant(\n263|        name=\"N-collision-conventional\",\n264|        path=f\"{PACKAGE}/socket.go\",\n265|        find='\\tif candidate != \"\" && candidate == socket {\\n',\n266|        replace='\\tif candidate != \"\" && candidate == socket && candidate != ambient.ConventionalName {\\n',\n267|        count=1,\n268|        run=f\"{COLLISION}/conventional_name\",\n269|        expect=\"KILLED\",\n270|        note=\"Admits exactly the conventional-name collision; the other four members still refuse.\",\n271|    ),\n272|    Mutant(\n273|        name=\"N-realm-membership\",\n274|        path=f\"{PACKAGE}/readiness.go\",\n275|        find=\"\\tif !admission.Admitted.Has(realmCapability) {\\n\",\n276|        replace='\\tif !admission.Admitted.Has(realmCapability) && !admission.Admitted.Has(\"headless_creation\") {\\n',\n277|        count=1,\n278|        run=\"(TestCheckServerAttestedRefusesEachMissingConjunct|TestAcquireForegroundRefusesRunningUnattested)\",\n279|        expect=\"KILLED\",\n280|        note=\"Admits exactly decoy-capability admissions past the membership arm; every admission without the realm row still refuses. Kill path: the foreground entry attaches to a headless-only server.\",\n281|    ),\n282|    Mutant(\n283|        name=\"N-realm-generation\",\n284|        path=f\"{PACKAGE}/readiness.go\",\n285|        find=\"\\tif wantGeneration == \\\"\\\" || admission.RawGeneration != wantGeneration {\\n\",\n286|        replace='\\tif wantGeneration == \"\" || admission.RawGeneration != wantGeneration && admission.RawGeneration != \"generation-6\" {\\n',\n287|        count=1,\n288|        run=f\"(TestCheckServerAttestedRefusesEachMissingConjunct|TestAcquireForegroundRefusesWrongGenerationAdmission|{BG_MISS})\",\n289|        expect=\"KILLED\",\n290|        note=\"Admits exactly stale generation-6 admissions past the generation arm; every other unbound generation still refuses. Kill path: a replayed yesterday-proof attaches through both entries.\",\n291|    ),\n292|    Mutant(\n293|        name=\"N-broker-uid\",\n294|        path=f\"{PACKAGE}/readiness.go\",\n295|        find=\"\\tif report.Principal.UID != currentUID {\\n\",\n296|        replace=\"\\tif report.Principal.UID != currentUID && report.Principal.UID != currentUID+100000 {\\n\",\n297|        count=1,\n298|        run=f\"(TestCheckBrokerContactRefusesEachMissingFact|{BG_MISS})\",\n299|        expect=\"KILLED\",\n300|        note=\"Admits exactly the seam-shifted foreign UID past the same-user arm; every other foreign UID still refuses.\",\n301|    ),\n302|    Mutant(\n303|        name=\"N-broker-generation\",\n304|        path=f\"{PACKAGE}/readiness.go\",\n305|        find='\\tif report.Principal.Generation == \"\" || report.Principal.Generation != wantGeneration {\\n',\n306|        replace='\\tif report.Principal.Generation == \"\" || report.Principal.Generation != wantGeneration && report.Principal.Generation != \"generation-6\" {\\n',\n307|        count=1,\n308|        run=f\"(TestCheckBrokerContactRefusesEachMissingFact|TestAcquireBackgroundMissReturnsTypedUnavailable/generation-unbound_principal)\",\n309|        expect=\"KILLED\",\n310|        note=\"Admits exactly generation-6 broker principals past the principal-binding arm; every other unbound principal still refuses.\",\n311|    ),\n312|    Mutant(\n313|        name=\"N-creation-literal\",\n314|        path=f\"{PACKAGE}/acquire.go\",\n315|        find=\"\\tif caller == CallerBackground {\\n\",\n316|        replace='\\tif caller == \"Background\" {\\n',\n317|        count=1,\n318|        run=f\"(TestCheckCreationAllowedRefusesBackground|{BG_MISS_LINUX})\",\n319|        expect=\"KILLED\",\n320|        note=\"Admits exactly the background caller at the creation choke point; the gate still refuses the capitalized twin. Kill path: the background miss consults the gate by call and reports the creation code instead of the typed unavailable.\",\n321|    ),\n322|    Mutant(\n323|        name=\"N-caller-vocabulary\",\n324|        path=f\"{PACKAGE}/acquire.go\",\n325|        find=\"\\tif req.Caller != CallerForeground && req.Caller != CallerBackground {\\n\",\n326|        replace='\\tif req.Caller != CallerForeground && req.Caller != CallerBackground && req.Caller != \"operator\" {\\n',\n327|        count=1,\n328|        run=\"TestAcquireRefusesUnknownCaller\",\n329|        expect=\"KILLED\",\n330|        note=\"Admits exactly the operator caller past the vocabulary arm; every other unknown caller still refuses. Kill reroutes to the dependencies refusal.\",\n331|    ),\n332|    Mutant(\n333|        name=\"N-details-remediation\",\n334|        path=f\"{PACKAGE}/acquire.go\",\n335|        find='\\tif req.Generation == \"\" || req.BrokerState == \"\" || req.Remediation == \"\" {\\n',\n336|        replace='\\tif req.Generation == \"\" || req.BrokerState == \"\" {\\n',\n337|        count=1,\n338|        run=\"TestAcquireRefusesMissingRealmDetails\",\n339|        expect=\"KILLED\",\n340|        note=\"Admits exactly remediation-less requests past the typed-details arm; generation- and broker-less still refuse. Kill reroutes to the dependencies refusal.\",\n341|    ),\n342|    Mutant(\n343|        name=\"N-unattested-foreground\",\n344|        path=f\"{PACKAGE}/acquire.go\",\n345|        find=\"\\t\\tif err := CheckServerAttested(report.Admission, req.Generation); err != nil {\\n\\t\\t\\treturn Outcome{}, err\\n\\t\\t}\\n\",\n346|        replace='\\t\\tif err := CheckServerAttested(report.Admission, req.Generation); err != nil && err.Error() != \"tmux server refused: tmux_readiness_not_authorizing at server generation\" {\\n\\t\\t\\treturn Outcome{}, err\\n\\t\\t}\\n',\n347|        count=1,\n348|        run=\"TestAcquireForegroundRefusesWrongGenerationAdmission\",\n349|        expect=\"KILLED\",\n350|        note=\"Admits exactly generation-refused running servers to attach past the foreground wiring; membership refusals still refuse. Kill path: a stale admission attaches instead of refusing.\",\n351|    ),\n352|    Mutant(\n353|        name=\"N-acquire-commit-refusal\",\n354|        path=f\"{PACKAGE}/acquire.go\",\n355|        find=\"\\tensured, err := EnsureRuntimeDir(req.Root, req.Name, req.Platform, nil)\\n\\tif err != nil {\\n\",\n356|        replace=\"\\tensured, err := EnsureRuntimeDir(req.Root, req.Name, req.Platform, nil)\\n\\tif err != nil && ensured == \\\"\\\" {\\n\",\n357|        count=1,\n358|        run=\"TestAcquireForegroundStagesCommitPhaseCustodyRefusal\",\n359|        expect=\"KILLED\",\n360|        note=\"Admits exactly commit-phase custody refusals past the foreground wiring (commit failures carry the joined path; lexical failures carry \\\"\\\"); lexical refusals still refuse. Kill path: the entry probes and spawns past a widened mode.\",\n361|    ),\n362|    Mutant(\n363|        name=\"N-acquire-verify-refusal\",\n364|        path=f\"{PACKAGE}/acquire.go\",\n365|        find=\"\\tif verr := VerifyRuntimeDir(req.Root, req.Name, req.Platform); verr != nil {\\n\\t\\treturn Outcome{}, verr\\n\\t}\\n\",\n366|        replace='\\tif verr := VerifyRuntimeDir(req.Root, req.Name, req.Platform); verr != nil && verr.Error() != \"tmux server refused: tmux_unsafe_runtime_dir at runtime mode\" {\\n\\t\\treturn Outcome{}, verr\\n\\t}\\n',\n367|        count=1,\n368|        run=\"TestAcquireBackgroundStagesVerifyCustodyRefusal\",\n369|        expect=\"KILLED\",\n370|        note=\"Admits exactly mode refusals past the background verify wiring; absence and every other custody refusal still refuse. Kill path: the entry contacts the broker past a widened mode.\",\n371|    ),\n372|    Mutant(\n373|        name=\"N-spawn-swallow\",\n374|        path=f\"{PACKAGE}/acquire.go\",\n375|        find=\"\\tif err := req.Deps.Spawn(socket, argv); err != nil {\\n\",\n376|        replace='\\tif err := req.Deps.Spawn(socket, argv); err != nil && err.Error() != \"exec failed\" {\\n',\n377|        count=1,\n378|        run=\"TestAcquireForegroundSpawnFailureReportsWithoutFallback\",\n379|        expect=\"KILLED\",\n380|        note=\"Admits exactly the fixture spawn failure as success; every other spawn failure still reports.\",\n381|    ),\n382|    Mutant(\n383|        name=\"N-probe-swallow-foreground\",\n384|        path=f\"{PACKAGE}/acquire.go\",\n385|        find=\"\\treport, err := req.Deps.ProbeServer(socket)\\n\\tif err != nil {\\n\",\n386|        replace='\\treport, err := req.Deps.ProbeServer(socket)\\n\\tif err != nil && err.Error() != \"probe boom\" {\\n',\n387|        count=1,\n388|        run=\"TestAcquireForegroundProbeFailurePassesThrough\",\n389|        expect=\"KILLED\",\n390|        note=\"Admits exactly the fixture probe failure as an absent server (then spawns); every other probe failure still passes through.\",\n391|    ),\n392|    Mutant(\n393|        name=\"N-probe-swallow-background\",\n394|        path=f\"{PACKAGE}/acquire.go\",\n395|        find=\"\\tstatus, err := req.Deps.ProbeBroker()\\n\\tif err != nil {\\n\",\n396|        replace='\\tstatus, err := req.Deps.ProbeBroker()\\n\\tif err != nil && err.Error() != \"probe boom\" {\\n',\n397|        count=1,\n398|        run=\"TestAcquireBackgroundProbeFailurePassesThrough\",\n399|        expect=\"KILLED\",\n400|        note=\"Admits exactly the fixture probe failure as a broker miss (then reports unavailable); every other probe failure still passes through.\",\n401|    ),\n402|    Mutant(\n403|        name=\"N-argv-socket\",\n404|        path=f\"{PACKAGE}/argv.go\",\n405|        find=\"\\tif socket != SocketPath(runtimeDir) {\\n\",\n406|        replace='\\tif socket != SocketPath(runtimeDir) && socket != \"/tmp/tmux-501/default\" {\\n',\n407|        count=1,\n408|        run=\"TestBuildArgvRefusesAmbientSocket\",\n409|        expect=\"KILLED\",\n410|        note=\"Admits exactly the default path at the spawn-socket arm; every other ambient socket still refuses.\",\n411|    ),\n412|    Mutant(\n413|        name=\"N-argv-tmuxenv\",\n414|        path=f\"{PACKAGE}/argv.go\",\n415|        find=\"\\tif socket != SocketPath(runtimeDir) {\\n\",\n416|        replace='\\tif socket != SocketPath(runtimeDir) && socket != \"/tmp/tmux-501/default,12345,0\" {\\n',\n417|        count=1,\n418|        run=\"TestBuildArgvRefusesAmbientSocket/tmux_env_value\",\n419|        expect=\"KILLED\",\n420|        note=\"Admits exactly the TMUX environment value at the spawn-socket arm; every other ambient socket still refuses.\",\n421|    ),\n422|    Mutant(\n423|        name=\"N-argv-shape\",\n424|        path=f\"{PACKAGE}/argv.go\",\n425|        find=\"\\tif err := secprim.CheckArgv(argv); err != nil {\\n\",\n426|        replace='\\tif err := secprim.CheckArgv(argv); err != nil && argv[0] != \"tmux\" {\\n',\n427|        count=1,\n428|        run=\"TestBuildArgvRefusesInvalidArgvShape\",\n429|        expect=\"KILLED\",\n430|        note=\"Admits exactly our tmux-headed spawn vector past the landed shape wiring; any other vector still refuses. Other failing shapes are unstageable through the fixed-shape builder and are disclosed, not pinned.\",\n431|    ),\n432|    Mutant(\n433|        name=\"N-argv-session\",\n434|        path=f\"{PACKAGE}/argv.go\",\n435|        find=\"\\tsession, err := scalar.ParseUUIDv7(sessionID)\\n\\tif err != nil {\\n\",\n436|        replace='\\tsession, err := scalar.ParseUUIDv7(sessionID)\\n\\tif err != nil && sessionID != \"12345\" {\\n',\n437|        count=1,\n438|        run=\"(TestBuildArgvRefusesMalformedSession|TestAcquireForegroundRefusesMalformedSession)\",\n439|        expect=\"KILLED\",\n440|        note=\"Admits exactly the PID-form session past our wiring of the landed UUIDv7 grammar; every other malformed session still refuses.\",\n441|    ),\n442|    Mutant(\n443|        name=\"N-deps-background\",\n444|        path=f\"{PACKAGE}/acquire.go\",\n445|        find=\"\\tif req.Deps.ProbeBroker == nil {\\n\",\n446|        replace=\"\\tif req.Deps.ProbeBroker == nil && req.Deps.Spawn == nil {\\n\",\n447|        count=1,\n448|        run=\"TestAcquireBackgroundNilBrokerWithSpawnRefuses\",\n449|        expect=\"KILLED\",\n450|        note=\"Admits exactly the nil-probe-with-spawn background request past the dependencies arm; the fully-nil request still refuses. Kill path: the admitted request reaches Verify and refuses with the custody code instead of the dependencies code.\",\n451|    ),\n452|    Mutant(\n453|        name=\"N-deps-foreground\",\n454|        path=f\"{PACKAGE}/acquire.go\",\n455|        find=\"\\tif req.Deps.ProbeServer == nil || req.Deps.Spawn == nil {\\n\",\n456|        replace=\"\\tif req.Deps.ProbeServer == nil && req.Deps.Spawn == nil {\\n\",\n457|        count=1,\n458|        run=\"TestAcquireForegroundNilSpawnWithProbeRefuses\",\n459|        expect=\"KILLED\",\n460|        note=\"Admits exactly the half-nil foreground dependencies past the arm; fully-nil dependencies still refuse. Kill path: the admitted request panics on the nil spawn, and the panic fails the test.\",\n461|    ),\n462|    Mutant(\n463|        name=\"D-background-fallback\",\n464|        path=f\"{PACKAGE}/acquire.go\",\n465|        find=\"\\t\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\n\\t\\t\\treturn Outcome{}, backgroundUnavailable(req, err)\\n\\t\\t}\\n\",\n466|        replace=\"\\t\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\n\\t\\t\\tif req.Deps.Spawn != nil {\\n\\t\\t\\t\\t_ = req.Deps.Spawn(socket, nil)\\n\\t\\t\\t}\\n\\t\\t\\treturn Outcome{}, backgroundUnavailable(req, err)\\n\\t\\t}\\n\",\n467|        count=1,\n468|        run=BG_MISS_LINUX,\n469|        expect=\"KILLED\",\n470|        note=\"SUPPLEMENTARY ADDITIVE, not a narrowing: plants the reviewer-shaped direct-creation call on the background miss path. Kill path: every background-miss spy asserts zero spawn calls.\",\n471|    ),\n472|    Mutant(\n473|        name=\"C-control\",\n474|        path=f\"{PACKAGE}/errors.go\",\n475|        find=\"// Error is a package-local refusal. Code is one of the Code*\",\n476|        replace=\"// Error is a package-local refusal (harness control: comment-only). Code is one of the Code*\",\n477|        count=1,\n478|        run=\"TestSocketPathDerivesOnlyFromRuntimeDir\",\n479|        expect=\"SURVIVED\",\n480|        note=\"Harmless control: a comment-only edit that must SURVIVE, proving the harness observes outcomes.\",\n481|    ),\n482|]\n483|\n484|\n485|def apply(mutant: Mutant, original: str) -> str:\n486|    return original.replace(mutant.find, mutant.replace)\n487|\n488|\n489|def run_mutant(mutant: Mutant, log_dir: Path | None) -> str:\n490|    target = REPO / mutant.path\n491|    original = target.read_text()\n492|    found = original.count(mutant.find)\n493|    if found != mutant.count:\n494|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\"\n495|    with tempfile.TemporaryDirectory() as staging:\n496|        backup = Path(staging) / \"backup\"\n497|        shutil.copy2(target, backup)\n498|        try:\n499|            target.write_text(apply(mutant, original))\n500|            run = subprocess.run(\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c73f","stream":{"kind":"session","id":"01a0c40c-7a6a-7610-adaa-109852fda585"},"sequence":506,"recorded_at":1780531400001007,"record_type":"event","durability":"durable","causation_id":"be2f90a4-329e-4dfe-906d-93614b40b7f2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"be2f90a4-329e-4dfe-906d-93614b40b7f2","run_stream":{"kind":"run","id":"be2f90a4-329e-4dfe-906d-93614b40b7f2"},"call_id":"call_01a0c40d9ab3771284735f9f58e15fab","text":"Read text file `internal/tmuxserver/tmuxserver_test.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n12|)\n13|\n14|const (\n15|\tfixtureSession       = \"0198f4c8-7d40-7e55-8e6f-1234567890ab\"\n16|\tfixtureGeneration    = \"generation-7\"\n17|\tfixtureStaleGen      = \"generation-6\"\n18|\tfixtureBroker        = \"absent\"\n19|\tfixtureRemedy        = \"sign in to the GUI realm and retry\"\n20|\tfixtureDecoyCapacity = \"headless_creation\"\n21|)\n22|\n23|// realmAdmitted models a probe-reported landed admission holding the\n24|// credential realm row: in production the probe reports the\n25|// Reconcile/ResolveEvidence verdict, and tests model the report.\n26|func realmAdmitted() terminalbackend.Admitted {\n27|\treturn terminalbackend.Admitted{Capabilities: []string{\"credential_capable_execution_realm\"}}\n28|}\n29|\n30|// boundAdmission models a live admission bound to the request's typed\n31|// generation.\n32|func boundAdmission() RealmAdmission {\n33|\treturn RealmAdmission{Admitted: realmAdmitted(), RawGeneration: fixtureGeneration}\n34|}\n35|\n36|// staleAdmission models yesterday's live proof replayed today: the\n37|// row is admitted but bound to the previous generation.\n38|func staleAdmission() RealmAdmission {\n39|\treturn RealmAdmission{Admitted: realmAdmitted(), RawGeneration: fixtureStaleGen}\n40|}\n41|\n42|// brokerReport models a live broker report: a same-user principal\n43|// bound to the typed generation plus the bound server admission.\n44|func brokerReport() BrokerReport {\n45|\treturn BrokerReport{\n46|\t\tPrincipal: BrokerPrincipal{UID: currentUID(), Generation: fixtureGeneration},\n47|\t\tServer:    boundAdmission(),\n48|\t}\n49|}\n50|\n51|// foreignUID stages a broker principal the same-user arm must refuse\n52|// without privilege: the test identity shifted out of range.\n53|func foreignUID() uint32 { return currentUID() + 100000 }\n54|\n55|func validRequest(t *testing.T, root string) Request {\n56|\tt.Helper()\n57|\treturn Request{\n58|\t\tCaller:      CallerForeground,\n59|\t\tPlatform:    scalar.PlatformMacOS,\n60|\t\tRoot:        root,\n61|\t\tName:        RuntimeDirName,\n62|\t\tSessionID:   fixtureSession,\n63|\t\tGeneration:  fixtureGeneration,\n64|\t\tBrokerState: fixtureBroker,\n65|\t\tRemediation: fixtureRemedy,\n66|\t}\n67|}\n68|\n69|func hostileAmbient() Ambient {\n70|\treturn Ambient{\n71|\t\tTMUXEnv:          \"/tmp/tmux-501/default,12345,0\",\n72|\t\tTMUXTmpDir:       \"/tmp/operator-tmux\",\n73|\t\tInheritedSocket:  \"/tmp/inherited.sock\",\n74|\t\tDefaultPath:      \"/tmp/tmux-501/default\",\n75|\t\tConventionalName: \"default\",\n76|\t}\n77|}\n78|\n79|func requireLocalError(t *testing.T, err error, code, detail string) {\n80|\tt.Helper()\n81|\tif err == nil {\n82|\t\tt.Fatalf(\"err = nil, want %s at %s\", code, detail)\n83|\t}\n84|\tvar local *Error\n85|\tif !errors.As(err, &local) {\n86|\t\tt.Fatalf(\"err type = %T (%v), want *tmuxserver.Error\", err, err)\n87|\t}\n88|\tif local.Code != code || local.Detail != detail {\n89|\t\tt.Fatalf(\"err = %s at %s, want %s at %s\", local.Code, local.Detail, code, detail)\n90|\t}\n91|}\n92|\n93|func requireCapabilityUnavailable(t *testing.T, err error, caller, broker, generation, remedy string) {\n94|\tt.Helper()\n95|\tif err == nil {\n96|\t\tt.Fatal(\"err = nil, want capability_unavailable\")\n97|\t}\n98|\tvar failure *axerror.Error\n99|\tif !errors.As(err, &failure) {\n100|\t\tt.Fatalf(\"err type = %T (%v), want *axerror.Error\", err, err)\n101|\t}\n102|\tif string(failure.Code()) != \"capability_unavailable\" {\n103|\t\tt.Fatalf(\"code = %q, want %q\", string(failure.Code()), \"capability_unavailable\")\n104|\t}\n105|\tif failure.ExitCode() != 6 {\n106|\t\tt.Fatalf(\"exit = %d, want 6\", failure.ExitCode())\n107|\t}\n108|\twant := map[string]string{\n109|\t\t\"capability\":             \"credential_capable_execution_realm\",\n110|\t\t\"caller_realm\":           caller,\n111|\t\t\"broker_state\":           broker,\n112|\t\t\"tmux_server_generation\": generation,\n113|\t\t\"remediation\":            remedy,\n114|\t}\n115|\tfor key, value := range want {\n116|\t\tgot, ok := failure.Detail(key)\n117|\t\tif !ok {\n118|\t\t\tt.Fatalf(\"missing typed detail %q\", key)\n119|\t\t}\n120|\t\tif got != value {\n121|\t\t\tt.Fatalf(\"detail %q = %v, want %q\", key, got, value)\n122|\t\t}\n123|\t}\n124|}\n125|\n126|type spawnSpy struct {\n127|\tcalls  int\n128|\tsocket string\n129|\targv   []string\n130|\terr    error\n131|}\n132|\n133|func (spy *spawnSpy) spawn(socket string, argv []string) error {\n134|\tspy.calls++\n135|\tspy.socket = socket\n136|\tspy.argv = append([]string(nil), argv...)\n137|\treturn spy.err\n138|}\n139|\n140|func stateRoot(t *testing.T) string {\n141|\tt.Helper()\n142|\troot := t.TempDir()\n143|\tif err := os.Chmod(root, 0o755); err != nil {\n144|\t\tt.Fatal(err)\n145|\t}\n146|\treturn root\n147|}\n148|\n149|func runtimeDir(t *testing.T, root string) string {\n150|\tt.Helper()\n151|\tdir, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n152|\tif err != nil {\n153|\t\tt.Fatal(err)\n154|\t}\n155|\treturn dir\n156|}\n157|\n158|func TestSocketPathDerivesOnlyFromRuntimeDir(t *testing.T) {\n159|\tdir := filepath.Join(t.TempDir(), RuntimeDirName)\n160|\tif got := SocketPath(dir); got != filepath.Join(dir, \"ax-tmux.sock\") {\n161|\t\tt.Fatalf(\"SocketPath = %q\", got)\n162|\t}\n163|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
