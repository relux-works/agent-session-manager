{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c77b","stream":{"kind":"session","id":"01a0c40c-7a6a-7610-adaa-109852fda585"},"sequence":536,"recorded_at":1780531400001067,"record_type":"event","durability":"durable","causation_id":"be2f90a4-329e-4dfe-906d-93614b40b7f2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"be2f90a4-329e-4dfe-906d-93614b40b7f2","run_stream":{"kind":"run","id":"be2f90a4-329e-4dfe-906d-93614b40b7f2"},"call_id":"call_01a0c40da44f7201a0fa8cfabdf705fc","text":"Read text file `internal/tmuxserver/acquire_test.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n11|)\n12|\n13|var errProbeBoom = errors.New(\"probe boom\")\n14|\n15|func TestAcquireForegroundSpawnsDedicatedServer(t *testing.T) {\n16|\troot := stateRoot(t)\n17|\treq := validRequest(t, root)\n18|\treq.Ambient = hostileAmbient()\n19|\tspy := &spawnSpy{}\n20|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n21|\t\treturn ServerReport{}, nil\n22|\t}\n23|\treq.Deps.Spawn = spy.spawn\n24|\toutcome, err := Acquire(req)\n25|\tif err != nil {\n26|\t\tt.Fatal(err)\n27|\t}\n28|\tif outcome.Via != \"spawned\" {\n29|\t\tt.Fatalf(\"via = %q, want spawned\", outcome.Via)\n30|\t}\n31|\tif outcome.Socket != SocketPath(filepath.Join(root, RuntimeDirName)) {\n32|\t\tt.Fatalf(\"socket = %q\", outcome.Socket)\n33|\t}\n34|\tif spy.calls != 1 || spy.socket != outcome.Socket {\n35|\t\tt.Fatalf(\"spawn calls = %d socket = %q\", spy.calls, spy.socket)\n36|\t}\n37|\tif len(spy.argv) < 3 || spy.argv[0] != \"tmux\" || spy.argv[1] != \"-S\" || spy.argv[2] != outcome.Socket {\n38|\t\tt.Fatalf(\"spawn argv = %q\", spy.argv)\n39|\t}\n40|\tfor i, ambient := range []string{req.Ambient.TMUXEnv, req.Ambient.TMUXTmpDir, req.Ambient.InheritedSocket, req.Ambient.DefaultPath, req.Ambient.ConventionalName} {\n41|\t\tif ambient == \"\" {\n42|\t\t\tcontinue\n43|\t\t}\n44|\t\tif outcome.Socket == ambient {\n45|\t\t\tt.Fatalf(\"socket reuses ambient vector %d\", i)\n46|\t\t}\n47|\t\tfor _, arg := range spy.argv {\n48|\t\t\tif arg == ambient {\n49|\t\t\t\tt.Fatalf(\"argv carries ambient vector %d: %q\", i, arg)\n50|\t\t\t}\n51|\t\t}\n52|\t}\n53|\twantTail := []string{\"ax\", \"pane\", fixtureSession}\n54|\ttail := spy.argv[len(spy.argv)-3:]\n55|\tfor i := range wantTail {\n56|\t\tif tail[i] != wantTail[i] {\n57|\t\t\tt.Fatalf(\"argv tail = %q, want %q\", tail, wantTail)\n58|\t\t}\n59|\t}\n60|}\n61|\n62|func socketDir(t *testing.T, root string) string {\n63|\tt.Helper()\n64|\treturn runtimeDir(t, root)\n65|}\n66|\n67|func TestAcquireForegroundAttachesToRunningAttested(t *testing.T) {\n68|\troot := stateRoot(t)\n69|\treq := validRequest(t, root)\n70|\tspy := &spawnSpy{}\n71|\tprobed := \"\"\n72|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n73|\t\tprobed = socket\n74|\t\treturn ServerReport{Running: true, Admission: boundAdmission()}, nil\n75|\t}\n76|\treq.Deps.Spawn = spy.spawn\n77|\toutcome, err := Acquire(req)\n78|\tif err != nil {\n79|\t\tt.Fatal(err)\n80|\t}\n81|\tif outcome.Via != \"attached-running\" {\n82|\t\tt.Fatalf(\"via = %q\", outcome.Via)\n83|\t}\n84|\tif probed != outcome.Socket || outcome.Socket != SocketPath(socketDir(t, root)) {\n85|\t\tt.Fatalf(\"probed = %q socket = %q\", probed, outcome.Socket)\n86|\t}\n87|\tif spy.calls != 0 {\n88|\t\tt.Fatalf(\"spawn calls = %d, want 0 on attach\", spy.calls)\n89|\t}\n90|}\n91|\n92|func TestAcquireForegroundRefusesRunningUnattested(t *testing.T) {\n93|\troot := stateRoot(t)\n94|\treq := validRequest(t, root)\n95|\tspy := &spawnSpy{}\n96|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n97|\t\treturn ServerReport{Running: true, Admission: RealmAdmission{\n98|\t\t\tAdmitted:      terminalbackend.Admitted{Capabilities: []string{fixtureDecoyCapacity}},\n99|\t\t\tRawGeneration: fixtureGeneration,\n100|\t\t}}, nil\n101|\t}\n102|\treq.Deps.Spawn = spy.spawn\n103|\t_, err := Acquire(req)\n104|\trequireLocalError(t, err, \"tmux_readiness_not_authorizing\", \"server attestation\")\n105|\tif spy.calls != 0 {\n106|\t\tt.Fatalf(\"spawn calls = %d, want 0 on unattested\", spy.calls)\n107|\t}\n108|}\n109|\n110|// A stale admission — yesterday's live proof replayed against today's\n111|// typed generation — fakes no running attested server: attach refuses\n112|// on the generation arm with no spawn and no repair.\n113|func TestAcquireForegroundRefusesWrongGenerationAdmission(t *testing.T) {\n114|\troot := stateRoot(t)\n115|\treq := validRequest(t, root)\n116|\tspy := &spawnSpy{}\n117|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n118|\t\treturn ServerReport{Running: true, Admission: staleAdmission()}, nil\n119|\t}\n120|\treq.Deps.Spawn = spy.spawn\n121|\t_, err := Acquire(req)\n122|\trequireLocalError(t, err, \"tmux_readiness_not_authorizing\", \"server generation\")\n123|\tif spy.calls != 0 {\n124|\t\tt.Fatalf(\"spawn calls = %d, want 0 on stale admission\", spy.calls)\n125|\t}\n126|}\n127|\n128|func TestAcquireForegroundProbeFailurePassesThrough(t *testing.T) {\n129|\troot := stateRoot(t)\n130|\treq := validRequest(t, root)\n131|\tspy := &spawnSpy{}\n132|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n133|\t\treturn ServerReport{}, errProbeBoom\n134|\t}\n135|\treq.Deps.Spawn = spy.spawn\n136|\t_, err := Acquire(req)\n137|\tif !errors.Is(err, errProbeBoom) {\n138|\t\tt.Fatalf(\"err = %v, want the probe failure\", err)\n139|\t}\n140|\tif spy.calls != 0 {\n141|\t\tt.Fatalf(\"spawn calls = %d, want 0 on unknown\", spy.calls)\n142|\t}\n143|}\n144|\n145|func TestAcquireForegroundSpawnFailureReportsWithoutFallback(t *testing.T) {\n146|\troot := stateRoot(t)\n147|\treq := validRequest(t, root)\n148|\tspy := &spawnSpy{err: errors.New(\"exec failed\")}\n149|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n150|\t\treturn ServerReport{}, nil\n151|\t}\n152|\treq.Deps.Spawn = spy.spawn\n153|\t_, err := Acquire(req)\n154|\trequireLocalError(t, err, \"tmux_server_spawn_failed\", \"server spawn\")\n155|\tif spy.calls != 1 {\n156|\t\tt.Fatalf(\"spawn calls = %d, want exactly 1\", spy.calls)\n157|\t}\n158|}\n159|\n160|func TestAcquireForegroundRefusesMalformedSession(t *testing.T) {\n161|\troot := stateRoot(t)\n162|\treq := validRequest(t, root)\n163|\treq.SessionID = \"12345\"\n164|\tspy := &spawnSpy{}\n165|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n166|\t\treturn ServerReport{}, nil\n167|\t}\n168|\treq.Deps.Spawn = spy.spawn\n169|\t_, err := Acquire(req)\n170|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"session identity\")\n171|\tif spy.calls != 0 {\n172|\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n173|\t}\n174|}\n175|\n176|func TestAcquireBackgroundContactsBroker(t *testing.T) {\n177|\troot := stateRoot(t)\n178|\truntimeDir(t, root)\n179|\treq := validRequest(t, root)\n180|\treq.Caller = CallerBackground\n181|\treq.Platform = scalar.PlatformMacOS\n182|\tspy := &spawnSpy{}\n183|\tprobed := false\n184|\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n185|\t\tprobed = true\n186|\t\treturn brokerReport(), nil\n187|\t}\n188|\treq.Deps.Spawn = spy.spawn\n189|\toutcome, err := Acquire(req)\n190|\tif err != nil {\n191|\t\tt.Fatal(err)\n192|\t}\n193|\tif !probed {\n194|\t\tt.Fatal(\"broker was not probed\")\n195|\t}\n196|\tif outcome.Via != \"broker\" {\n197|\t\tt.Fatalf(\"via = %q\", outcome.Via)\n198|\t}\n199|\tif outcome.Socket != SocketPath(socketDir(t, root)) {\n200|\t\tt.Fatalf(\"socket = %q\", outcome.Socket)\n201|\t}\n202|\tif len(outcome.Argv) != 0 {\n203|\t\tt.Fatalf(\"broker outcome carries argv %q\", outcome.Argv)\n204|\t}\n205|\tif spy.calls != 0 {\n206|\t\tt.Fatalf(\"spawn calls = %d, want 0 on broker contact\", spy.calls)\n207|\t}\n208|}\n209|\n210|func TestAcquireBackgroundMissReturnsTypedUnavailable(t *testing.T) {\n211|\tlive := brokerReport()\n212|\tfor _, tc := range []struct {\n213|\t\tname   string\n214|\t\treport BrokerReport\n215|\t}{\n216|\t\t{\"no broker\", BrokerReport{}},\n217|\t\t{\"foreign-user broker\", BrokerReport{\n218|\t\t\tPrincipal: BrokerPrincipal{UID: foreignUID(), Generation: fixtureGeneration},\n219|\t\t\tServer:    boundAdmission(),\n220|\t\t}},\n221|\t\t{\"generation-unbound principal\", BrokerReport{\n222|\t\t\tPrincipal: BrokerPrincipal{UID: live.Principal.UID, Generation: fixtureStaleGen},\n223|\t\t\tServer:    boundAdmission(),\n224|\t\t}},\n225|\t\t{\"unattested server\", BrokerReport{\n226|\t\t\tPrincipal: live.Principal,\n227|\t\t\tServer:    RealmAdmission{RawGeneration: fixtureGeneration},\n228|\t\t}},\n229|\t\t{\"stale server admission\", BrokerReport{\n230|\t\t\tPrincipal: live.Principal,\n231|\t\t\tServer:    staleAdmission(),\n232|\t\t}},\n233|\t} {\n234|\t\tt.Run(tc.name, func(t *testing.T) {\n235|\t\t\troot := stateRoot(t)\n236|\t\t\truntimeDir(t, root)\n237|\t\t\treq := validRequest(t, root)\n238|\t\t\treq.Caller = CallerBackground\n239|\t\t\treq.Platform = scalar.PlatformMacOS\n240|\t\t\tspy := &spawnSpy{}\n241|\t\t\t// Even a spawner that would succeed must never run:\n242|\t\t\t// the miss path has no fallback to direct creation.\n243|\t\t\treq.Deps.Spawn = spy.spawn\n244|\t\t\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n245|\t\t\t\treturn tc.report, nil\n246|\t\t\t}\n247|\t\t\t_, err := Acquire(req)\n248|\t\t\trequireCapabilityUnavailable(t, err, \"background\", fixtureBroker, fixtureGeneration, fixtureRemedy)\n249|\t\t\tif spy.calls != 0 {\n250|\t\t\t\tt.Fatalf(\"spawn calls = %d, want 0 without fallback\", spy.calls)\n251|\t\t\t}\n252|\t\t})\n253|\t}\n254|}\n255|\n256|func TestAcquireBackgroundMissOnLinuxAlsoRefusesWithoutFallback(t *testing.T) {\n257|\troot := stateRoot(t)\n258|\truntimeDir(t, root)\n259|\treq := validRequest(t, root)\n260|\treq.Caller = CallerBackground\n261|\treq.Platform = scalar.PlatformLinux\n262|\tspy := &spawnSpy{}\n263|\treq.Deps.Spawn = spy.spawn\n264|\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n265|\t\treturn BrokerReport{}, nil\n266|\t}\n267|\t_, err := Acquire(req)\n268|\trequireCapabilityUnavailable(t, err, \"background\", fixtureBroker, fixtureGeneration, fixtureRemedy)\n269|\tif spy.calls != 0 {\n270|\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n271|\t}\n272|}\n273|\n274|// Background acquisition verifies the runtime directory instead of\n275|// creating it: a missing directory refuses, and the refusal leaves no\n276|// directory behind — a background caller performs no durable write.\n277|func TestAcquireBackgroundVerifiesWithoutCreating(t *testing.T) {\n278|\troot := stateRoot(t)\n279|\treq := validRequest(t, root)\n280|\treq.Caller = CallerBackground\n281|\tprobed := false\n282|\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n283|\t\tprobed = true\n284|\t\treturn brokerReport(), nil\n285|\t}\n286|\t_, err := Acquire(req)\n287|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n288|\tif probed {\n289|\t\tt.Fatal(\"broker was probed past a custody refusal\")\n290|\t}\n291|\tif _, statErr := os.Lstat(filepath.Join(root, RuntimeDirName)); !os.IsNotExist(statErr) {\n292|\t\tt.Fatalf(\"background refusal created the directory: stat err = %v\", statErr)\n293|\t}\n294|}\n295|\n296|// A commit-phase custody refusal staged through the foreground entry:\n297|// the suite widens the mode behind the entry's back, and acquisition\n298|// refuses without probing or spawning.\n299|func TestAcquireForegroundStagesCommitPhaseCustodyRefusal(t *testing.T) {\n300|\troot := stateRoot(t)\n301|\tdir, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n302|\tif err != nil {\n303|\t\tt.Fatal(err)\n304|\t}\n305|\tif err := os.Chmod(dir, 0o755); err != nil {\n306|\t\tt.Fatal(err)\n307|\t}\n308|\treq := validRequest(t, root)\n309|\tspy := &spawnSpy{}\n310|\tprobed := false\n311|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n312|\t\tprobed = true\n313|\t\treturn ServerReport{}, nil\n314|\t}\n315|\treq.Deps.Spawn = spy.spawn\n316|\t_, err = Acquire(req)\n317|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime mode\")\n318|\tif probed {\n319|\t\tt.Fatal(\"server was probed past a custody refusal\")\n320|\t}\n321|\tif spy.calls != 0 {\n322|\t\tt.Fatalf(\"spawn calls = %d, want 0 past a custody refusal\", spy.calls)\n323|\t}\n324|}\n325|\n326|// The background verify wiring refuses a widened directory through the\n327|// entry with no broker contact.\n328|func TestAcquireBackgroundStagesVerifyCustodyRefusal(t *testing.T) {\n329|\troot := stateRoot(t)\n330|\tdir, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n331|\tif err != nil {\n332|\t\tt.Fatal(err)\n333|\t}\n334|\tif err := os.Chmod(dir, 0o755); err != nil {\n335|\t\tt.Fatal(err)\n336|\t}\n337|\treq := validRequest(t, root)\n338|\treq.Caller = CallerBackground\n339|\tspy := &spawnSpy{}\n340|\tprobed := false\n341|\treq.Deps.Spawn = spy.spawn\n342|\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n343|\t\tprobed = true\n344|\t\treturn brokerReport(), nil\n345|\t}\n346|\t_, err = Acquire(req)\n347|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime mode\")\n348|\tif probed {\n349|\t\tt.Fatal(\"broker was probed past a custody refusal\")\n350|\t}\n351|\tif spy.calls != 0 {\n352|\t\tt.Fatalf(\"spawn calls = %d, want 0 past a custody refusal\", spy.calls)\n353|\t}\n354|}\n355|\n356|func TestAcquireBackgroundProbeFailurePassesThrough(t *testing.T) {\n357|\troot := stateRoot(t)\n358|\truntimeDir(t, root)\n359|\treq := validRequest(t, root)\n360|\treq.Caller = CallerBackground\n361|\tspy := &spawnSpy{}\n362|\treq.Deps.Spawn = spy.spawn\n363|\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n364|\t\treturn BrokerReport{}, errProbeBoom\n365|\t}\n366|\t_, err := Acquire(req)\n367|\tif !errors.Is(err, errProbeBoom) {\n368|\t\tt.Fatalf(\"err = %v, want the probe failure, not unavailable\", err)\n369|\t}\n370|\tif spy.calls != 0 {\n371|\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n372|\t}\n373|}\n374|\n375|func TestAcquireRefusesEveryAmbientOverrideVector(t *testing.T) {\n376|\thostile := hostileAmbient()\n377|\tvectors := map[string]string{\n378|\t\t\"environment variable\": hostile.TMUXEnv,\n379|\t\t\"tmux tmpdir\":          hostile.TMUXTmpDir,\n380|\t\t\"inherited socket\":     hostile.InheritedSocket,\n381|\t\t\"default path\":         hostile.DefaultPath,\n382|\t\t\"conventional name\":    hostile.ConventionalName,\n383|\t}\n384|\tfor name, override := range vectors {\n385|\t\tt.Run(name, func(t *testing.T) {\n386|\t\t\troot := stateRoot(t)\n387|\t\t\treq := validRequest(t, root)\n388|\t\t\tspy := &spawnSpy{}\n389|\t\t\treq.SocketOverride = override\n390|\t\t\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n391|\t\t\t\treturn ServerReport{}, nil\n392|\t\t\t}\n393|\t\t\treq.Deps.Spawn = spy.spawn\n394|\t\t\t_, err := Acquire(req)\n395|\t\t\trequireLocalError(t, err, \"tmux_ambient_server_reuse\", \"socket override\")\n396|\t\t\tif spy.calls != 0 {\n397|\t\t\t\tt.Fatalf(\"spawn calls = %d, want 0 on ambient refusal\", spy.calls)\n398|\t\t\t}\n399|\t\t\tif _, statErr := os.Lstat(filepath.Join(root, RuntimeDirName)); !os.IsNotExist(statErr) {\n400|\t\t\t\tt.Fatalf(\"ambient refusal created the directory: stat err = %v\", statErr)\n401|\t\t\t}\n402|\t\t})\n403|\t}\n404|}\n405|\n406|func TestAcquireRefusesAmbientCollision(t *testing.T) {\n407|\tfor _, tc := range []struct {\n408|\t\tname    string\n409|\t\tambient func(derived string) Ambient\n410|\t}{\n411|\t\t{\"tmux env\", func(derived string) Ambient { return Ambient{TMUXEnv: derived} }},\n412|\t\t{\"tmux tmpdir\", func(derived string) Ambient { return Ambient{TMUXTmpDir: derived} }},\n413|\t\t{\"inherited socket\", func(derived string) Ambient { return Ambient{InheritedSocket: derived} }},\n414|\t\t{\"default path\", func(derived string) Ambient { return Ambient{DefaultPath: derived} }},\n415|\t\t{\"conventional name\", func(derived string) Ambient { return Ambient{ConventionalName: derived} }},\n416|\t} {\n417|\t\tt.Run(tc.name, func(t *testing.T) {\n418|\t\t\troot := stateRoot(t)\n419|\t\t\tdir := socketDir(t, root)\n420|\t\t\treq := validRequest(t, root)\n421|\t\t\treq.Ambient = tc.ambient(SocketPath(dir))\n422|\t\t\tspy := &spawnSpy{}\n423|\t\t\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n424|\t\t\t\treturn ServerReport{}, nil\n425|\t\t\t}\n426|\t\t\treq.Deps.Spawn = spy.spawn\n427|\t\t\t_, err := Acquire(req)\n428|\t\t\trequireLocalError(t, err, \"tmux_ambient_server_reuse\", \"ambient collision\")\n429|\t\t\tif spy.calls != 0 {\n430|\t\t\t\tt.Fatalf(\"spawn calls = %d, want 0\", spy.calls)\n431|\t\t\t}\n432|\t\t})\n433|\t}\n434|}\n435|\n436|func TestAcquireRefusesUnknownCaller(t *testing.T) {\n437|\troot := stateRoot(t)\n438|\treq := validRequest(t, root)\n439|\treq.Caller = \"operator\"\n440|\t_, err := Acquire(req)\n441|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"caller\")\n442|}\n443|\n444|func TestAcquireRefusesWindowsPlatform(t *testing.T) {\n445|\troot := stateRoot(t)\n446|\tfor _, caller := range []Caller{CallerForeground, CallerBackground} {\n447|\t\treq := validRequest(t, root)\n448|\t\treq.Caller = caller\n449|\t\treq.Platform = scalar.PlatformWindows\n450|\t\treq.Root = `C:\\ax-state`\n451|\t\t_, err := Acquire(req)\n452|\t\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"runtime platform\")\n453|\t}\n454|}\n455|\n456|func TestAcquireRefusesMissingRealmDetails(t *testing.T) {\n457|\tbase := validRequest(t, stateRoot(t))\n458|\tfor _, tc := range []struct {\n459|\t\tname   string\n460|\t\tmutate func(*Request)\n461|\t}{\n462|\t\t{\"generation\", func(r *Request) { r.Generation = \"\" }},\n463|\t\t{\"broker state\", func(r *Request) { r.BrokerState = \"\" }},\n464|\t\t{\"remediation\", func(r *Request) { r.Remediation = \"\" }},\n465|\t} {\n466|\t\tt.Run(tc.name, func(t *testing.T) {\n467|\t\t\treq := base\n468|\t\t\ttc.mutate(&req)\n469|\t\t\t_, err := Acquire(req)\n470|\t\t\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"realm details\")\n471|\t\t})\n472|\t}\n473|}\n474|\n475|func TestAcquireRefusesMissingDependencies(t *testing.T) {\n476|\troot := stateRoot(t)\n477|\tforeground := validRequest(t, root)\n478|\t_, err := Acquire(foreground)\n479|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"dependencies\")\n480|\tbackground := validRequest(t, root)\n481|\tbackground.Caller = CallerBackground\n482|\t_, err = Acquire(background)\n483|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"dependencies\")\n484|}\n485|\n486|func TestAcquireCreatesRuntimeDirIdempotently(t *testing.T) {\n487|\troot := stateRoot(t)\n488|\tmake := func() Request {\n489|\t\treq := validRequest(t, root)\n490|\t\tspy := &spawnSpy{}\n491|\t\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n492|\t\t\treturn ServerReport{}, nil\n493|\t\t}\n494|\t\treq.Deps.Spawn = spy.spawn\n495|\t\treturn req\n496|\t}\n497|\tfirst, err := Acquire(make())\n498|\tif err != nil {\n499|\t\tt.Fatal(err)\n500|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
