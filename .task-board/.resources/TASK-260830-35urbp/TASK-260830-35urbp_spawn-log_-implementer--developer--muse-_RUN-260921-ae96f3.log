background_creation_refused\", \"background creation\")\n535|\tif err := checkCreationAllowed(CallerForeground); err != nil {\n536|\t\tt.Fatalf(\"foreground creation refused: %v\", err)\n537|\t}\n538|}","final_result":true}}}
