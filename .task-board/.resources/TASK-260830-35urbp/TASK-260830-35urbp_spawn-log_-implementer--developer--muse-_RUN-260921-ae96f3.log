{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c64f","stream":{"kind":"session","id":"01a0c40c-7a6a-7610-adaa-109852fda585"},"sequence":386,"recorded_at":1780531400000767,"record_type":"event","durability":"durable","causation_id":"be2f90a4-329e-4dfe-906d-93614b40b7f2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"be2f90a4-329e-4dfe-906d-93614b40b7f2","run_stream":{"kind":"run","id":"be2f90a4-329e-4dfe-906d-93614b40b7f2"},"call_id":"call_01a0c40d7022757cabbe019c6a42be67","text":"Read text file `internal/tmuxserver/runtime_unix.go`.\n1|//go:build !windows\n2|\n3|package tmuxserver\n4|\n5|import (\n6|\t\"errors\"\n7|\t\"os\"\n8|\n9|\t\"golang.org/x/sys/unix\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n12|)\n13|\n14|// commitRuntimeDir creates the leaf relative to the pinned root\n15|// handle and verifies exact custody on the opened descriptor. The\n16|// root itself must already exist: this entry creates exactly one\n17|// leaf and never builds parents, so a missing root refuses instead\n18|// of materializing an arbitrary ancestor chain with owner-only\n19|// modes. Mkdirat from the handle closes the validate-then-create\n20|// TOCTOU a path-string MkdirAll leaves open: descriptors pin what\n21|// they opened, and the leaf name is one grammar-checked segment.\n22|func commitRuntimeDir(root, name, joined string, hooks *Hooks) error {\n23|\t// No platform arm here: the lexical path already refused the\n24|\t// Windows platform on every host, so only unix platforms reach\n25|\t// this commit.\n26|\trootHandle, err := secprim.OpenNoFollowDir(root)\n27|\tif err != nil {\n28|\t\tif os.IsNotExist(err) || errors.Is(err, os.ErrNotExist) {\n29|\t\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"runtime root\"}\n30|\t\t}\n31|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n32|\t}\n33|\tdefer func() { _ = rootHandle.Close() }()\n34|\tif !handleBoundToPath(rootHandle, root) {\n35|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n36|\t}\n37|\trootFd := int(rootHandle.Fd())\n38|\tcreated := true\n39|\tif err := unix.Mkdirat(rootFd, name, 0o700); err != nil {\n40|\t\tif !errors.Is(err, unix.EEXIST) {\n41|\t\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime commit\"}\n42|\t\t}\n43|\t\tcreated = false\n44|\t}\n45|\tif hooks != nil && hooks.AfterMkdir != nil {\n46|\t\thooks.AfterMkdir(joined)\n47|\t}\n48|\tleafFd, err := unix.Openat(rootFd, name,\n49|\t\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\n50|\tif err != nil {\n51|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n52|\t}\n53|\tleaf := os.NewFile(uintptr(leafFd), joined)\n54|\tif created {\n55|\t\t// The mkdir mode honors umask, so the exact owner-only\n56|\t\t// mode is enforced explicitly on a leaf this call\n57|\t\t// created. An existing leaf is verified, never\n58|\t\t// repaired: silently narrowing a widened directory\n59|\t\t// would mask the custody violation.\n60|\t\tif err := unix.Fchmod(leafFd, 0o700); err != nil {\n61|\t\t\t_ = leaf.Close()\n62|\t\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\n63|\t\t}\n64|\t}\n65|\tinfo, err := leaf.Stat()\n66|\tif err != nil {\n67|\t\t_ = leaf.Close()\n68|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\n69|\t}\n70|\t// The openat O_DIRECTORY flag already refused a non-directory\n71|\t// leaf above; the mode comparison below is the load-bearing\n72|\t// arm this gate's tests and mutants pin.\n73|\tif info.Mode().Perm() != 0o700 {\n74|\t\t_ = leaf.Close()\n75|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\n76|\t}\n77|\tif err := verifyOwnership(info); err != nil {\n78|\t\t_ = leaf.Close()\n79|\t\treturn err\n80|\t}\n81|\t// The parent fsync persists the directory entry; without it a\n82|\t// crash after mkdir can lose the leaf on journaling filesystems.\n83|\tif err := unix.Fsync(rootFd); err != nil {\n84|\t\t_ = leaf.Close()\n85|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime commit\"}\n86|\t}\n87|\t_ = leaf.Close()\n88|\treturn nil\n89|}\n90|\n91|// verifyRuntimeDir enforces the three custody gates on an existing\n92|// leaf without creating it. A missing leaf refuses: absence on the\n93|// authorizing path is a fact, never a silent repair.\n94|func verifyRuntimeDir(root, name string) error {\n95|\t// No platform arm here, for the same reason as the commit arm\n96|\t// above: only unix platforms reach this verify.\n97|\trootHandle, err := secprim.OpenNoFollowDir(root)\n98|\tif err != nil {\n99|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n100|\t}\n101|\tdefer func() { _ = rootHandle.Close() }()\n102|\tif !handleBoundToPath(rootHandle, root) {\n103|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n104|\t}\n105|\tleafFd, err := unix.Openat(int(rootHandle.Fd()), name,\n106|\t\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\n107|\tif err != nil {\n108|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n109|\t}\n110|\tleaf := os.NewFile(uintptr(leafFd), name)\n111|\tdefer func() { _ = leaf.Close() }()\n112|\tinfo, err := leaf.Stat()\n113|\tif err != nil {\n114|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\n115|\t}\n116|\tif info.Mode().Perm() != 0o700 {\n117|\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\n118|\t}\n119|\treturn verifyOwnership(info)\n120|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c651","stream":{"kind":"session","id":"01a0c40c-7a6a-7610-adaa-109852fda585"},"sequence":387,"recorded_at":1780531400000769,"record_type":"event","durability":"durable","causation_id":"be2f90a4-329e-4dfe-906d-93614b40b7f2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"be2f90a4-329e-4dfe-906d-93614b40b7f2","run_stream":{"kind":"run","id":"be2f90a4-329e-4dfe-906d-93614b40b7f2"},"call_id":"call_01a0c40d71ad76798dd343d920700895","text":"Read text file `internal/tmuxserver/runtime.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"os\"\n5|\t\"strings\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n9|)\n10|\n11|// RuntimeDirName is the fixed leaf name of the AX tmux runtime\n12|// directory under the AX state root. It is AX-controlled vocabulary,\n13|// never an ambient or conventional tmux name.\n14|const RuntimeDirName = \"ax-tmux\"\n15|\n16|// Hooks arms the crash boundaries of EnsureRuntimeDir. AfterMkdir\n17|// runs after the directory entry is committed and before the parent\n18|// fsync; a crash there must leave a retry that converges to the one\n19|// verified directory. Hooks is nil in production.\n20|type Hooks struct {\n21|\tAfterMkdir func(dir string)\n22|}\n23|\n24|// EnsureRuntimeDir creates the owner-only runtime directory\n25|// root/name when absent and verifies it when present, returning the\n26|// joined path. Creation and verification enforce three independent\n27|// gates — containment, mode, ownership — and each refuses alone:\n28|//\n29|//   - containment: the root must be an absolute path on the platform\n30|//     grammar, the name must be one relative segment, and the commit\n31|//     opens the parent through a pinned directory handle and creates\n32|//     the leaf relative to that handle, so a symlinked intermediate\n33|//     directory cannot redirect the commit outside the root;\n34|//   - mode: the leaf must carry exactly 0700, enforced explicitly\n35|//     after creation because mkdir honors umask;\n36|//   - ownership: the leaf must belong to the effective UID.\n37|//\n38|// Lexical validation delegates to its landed owners (absolute root\n39|// and relative member to scalar, the join to secprim.Guard); the\n40|// descriptor-relative commit below is what this package owns, because\n41|// no landed helper commits a directory relative to a handle.\n42|//\n43|// On failure the returned path distinguishes the refusal phase: a\n44|// lexical refusal returns \"\", while a commit-phase refusal returns\n45|// the joined path alongside the error. Callers must check the error\n46|// first and never use the path when it is set; the split lets the\n47|// acquisition wiring narrow exactly the commit-phase class.\n48|func EnsureRuntimeDir(root, name string, platform scalar.Platform, hooks *Hooks) (string, error) {\n49|\tjoined, err := lexicalRuntimePath(root, name, platform)\n50|\tif err != nil {\n51|\t\treturn \"\", err\n52|\t}\n53|\treturn joined, commitRuntimeDir(root, name, joined, hooks)\n54|}\n55|\n56|// VerifyRuntimeDir enforces the three custody gates on an existing\n57|// runtime directory without creating it. Background acquisition calls\n58|// this instead of Ensure: the directory must already exist with exact\n59|// custody, and a missing directory refuses rather than being silently\n60|// created on the authorizing path. Foreground acquisition calls\n61|// Ensure, which provisions the directory it then verifies.\n62|func VerifyRuntimeDir(root, name string, platform scalar.Platform) error {\n63|\tif _, err := lexicalRuntimePath(root, name, platform); err != nil {\n64|\t\treturn err\n65|\t}\n66|\treturn verifyRuntimeDir(root, name)\n67|}\n68|\n69|// lexicalRuntimePath validates the root grammar, the name grammar,\n70|// and the lexical join. It answers the lexical question only; the\n71|// commit answers the filesystem question through a handle.\n72|func lexicalRuntimePath(root, name string, platform scalar.Platform) (string, error) {\n73|\tif _, err := scalar.ParsePlatform(string(platform)); err != nil {\n74|\t\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"runtime platform\"}\n75|\t}\n76|\t// Native Windows MUST NOT claim tmux or tmux resurrection\n77|\t// (pinned SPEC 1458), so the Windows platform refuses here on\n78|\t// every host, before any host-specific commit runs. Weakening\n79|\t// this arm reroutes a Windows request to the root refusal\n80|\t// instead of admitting it.\n81|\tif platform == scalar.PlatformWindows {\n82|\t\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"runtime platform\"}\n83|\t}\n84|\tif _, err := scalar.ParseAbsolutePath(platform, root); err != nil {\n85|\t\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"runtime root\"}\n86|\t}\n87|\tif err := checkRuntimeName(name); err != nil {\n88|\t\treturn \"\", err\n89|\t}\n90|\tguard, err := secprim.NewGuard(root, platform, []string{name})\n91|\tif err != nil {\n92|\t\treturn \"\", &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n93|\t}\n94|\tjoined, err := guard.Resolve(name)\n95|\tif err != nil {\n96|\t\treturn \"\", &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime containment\"}\n97|\t}\n98|\treturn joined, nil\n99|}\n100|\n101|// checkRuntimeName admits exactly one relative path segment. The\n102|// shared grammar (absolute, parent, dot, empty, NUL, backslash,\n103|// encoded separators) is decided by scalar; this gate adds only the\n104|// single-segment rule scalar does not own, because the commit opens\n105|// the leaf relative to the pinned parent handle and a second segment\n106|// would name a path the handle walk never descends.\n107|func checkRuntimeName(name string) error {\n108|\tif _, err := scalar.ParseRelativePath(name); err != nil {\n109|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"runtime name\"}\n110|\t}\n111|\tif strings.Contains(name, \"/\") {\n112|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"runtime name\"}\n113|\t}\n114|\treturn nil\n115|}\n116|\n117|// sameDirectory compares two stat results for directory identity. It\n118|// is a variable only so seam-failure tests can force the\n119|// handle-mismatch path through the production entries: a handle that\n120|// names a different directory than the path cannot be staged without\n121|// a filesystem race, and without the seam the mismatch branch is\n122|// untestable. Production code never reassigns it.\n123|var sameDirectory = os.SameFile\n124|\n125|// handleBoundToPath reports whether the open directory handle refers\n126|// to the same directory as rootPath. It mirrors the private\n127|// secprim.guardRootMatches check, which no caller outside secprim\n128|// can invoke: a stat failure on either side is not a match, and an\n129|// unreadable root fails closed into the mismatch refusal rather\n130|// than admitting an unverifiable handle.\n131|func handleBoundToPath(handle *os.File, rootPath string) bool {\n132|\thandleInfo, err := handle.Stat()\n133|\tif err != nil || handleInfo == nil {\n134|\t\treturn false\n135|\t}\n136|\tpathInfo, err := os.Stat(rootPath)\n137|\tif err != nil || pathInfo == nil {\n138|\t\treturn false\n139|\t}\n140|\treturn sameDirectory(handleInfo, pathInfo)\n141|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c653","stream":{"kind":"session","id":"01a0c40c-7a6a-7610-adaa-109852fda585"},"sequence":388,"recorded_at":1780531400000771,"record_type":"event","durability":"durable","causation_id":"be2f90a4-329e-4dfe-906d-93614b40b7f2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"be2f90a4-329e-4dfe-906d-93614b40b7f2","run_stream":{"kind":"run","id":"be2f90a4-329e-4dfe-906d-93614b40b7f2"},"call_id":"call_01a0c40d7326758da964f4cd4f85864b","text":"Read text file `internal/tmuxserver/readiness.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n5|)\n6|\n7|// RealmAdmission is the landed admission verdict over the exact tmux\n8|// server: the Reconcile/ResolveEvidence Admitted set plus the AX-known\n9|// raw generation the admission binds to. Production probes report this\n10|// verdict; tests model probe reports. This leaf never re-decides what\n11|// the admission already proves — signature verification, liveness,\n12|// expiry, and the sentinel/smoke requirement coverage are the landed\n13|// terminalbackend owner's verdict, consumed here through Has — and\n14|// composes it only with the generation equality the wrapper owner\n15|// (internal/axpane checkRealm) already enforces: the admission's raw\n16|// generation must equal the request's typed generation, or the proof\n17|// is stale and refuses.\n18|//\n19|// There is deliberately no member for a cached sentinel result, a\n20|// managername observation, or any attested-server boolean: none\n21|// authorizes, so none is an input. A cached observation replayed as a\n22|// live one is exactly a stale-generation admission, and it refuses on\n23|// the generation arm.\n24|type RealmAdmission struct {\n25|\t// Admitted is the landed admission verdict.\n26|\tAdmitted terminalbackend.Admitted\n27|\t// RawGeneration is the AX-known raw generation the admission\n28|\t// binds to.\n29|\tRawGeneration string\n30|}\n31|\n32|// CheckServerAttested admits exactly an attested dedicated server:\n33|// the landed admission holds the credential_capable_execution_realm\n34|// row AND the admission's raw generation equals the request's typed\n35|// generation. Each arm refuses alone: a missing row refuses even with\n36|// a bound generation, and a wrong generation refuses even with an\n37|// admitted row, so weakening either arm admits a server the committed\n38|// tests pin.\n39|func CheckServerAttested(admission RealmAdmission, wantGeneration string) error {\n40|\tif !admission.Admitted.Has(realmCapability) {\n41|\t\treturn &Error{Code: CodeReadinessNotAuthorizing, Detail: \"server attestation\"}\n42|\t}\n43|\tif wantGeneration == \"\" || admission.RawGeneration != wantGeneration {\n44|\t\treturn &Error{Code: CodeReadinessNotAuthorizing, Detail: \"server generation\"}\n45|\t}\n46|\treturn nil\n47|}\n48|\n49|// BrokerPrincipal is the authenticated Aqua broker identity the\n50|// background path decides over. Per Section 4.4 the broker exposes\n51|// only authenticated, same-user, generation-bound terminal readiness,\n52|// so the principal carries the authenticated UID and the generation\n53|// its readiness binds to as typed, bound facts — never a bare\n54|// boolean. The UID is compared against the process identity, and the\n55|// generation against the request's typed generation.\n56|type BrokerPrincipal struct {\n57|\t// UID is the broker's authenticated user identity.\n58|\tUID uint32\n59|\t// Generation is the generation the broker readiness binds to.\n60|\tGeneration string\n61|}\n62|\n63|// BrokerReport is the live Aqua broker report the background path\n64|// decides over: the authenticated principal plus the attested AX tmux\n65|// server admission. Either fact missing means neither exists for the\n66|// purpose of the broker-or-refuse rule.\n67|type BrokerReport struct {\n68|\tPrincipal BrokerPrincipal\n69|\tServer    RealmAdmission\n70|}\n71|\n72|// CheckBrokerContact admits exactly the background MAY case: a\n73|// same-user authenticated broker principal AND a generation-bound\n74|// principal AND the attested AX tmux server admission bound to the\n75|// same typed generation. Every other report — a foreign-user broker,\n76|// an unbound principal, an unattested server, a stale admission —\n77|// refuses, and the caller maps the refusal to the typed\n78|// capability_unavailable the spec names.\n79|func CheckBrokerContact(report BrokerReport, wantGeneration string, currentUID uint32) error {\n80|\tif report.Principal.UID != currentUID {\n81|\t\treturn &Error{Code: CodeReadinessNotAuthorizing, Detail: \"broker authentication\"}\n82|\t}\n83|\tif report.Principal.Generation == \"\" || report.Principal.Generation != wantGeneration {\n84|\t\treturn &Error{Code: CodeReadinessNotAuthorizing, Detail: \"broker generation\"}\n85|\t}\n86|\treturn CheckServerAttested(report.Server, wantGeneration)\n87|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c655","stream":{"kind":"session","id":"01a0c40c-7a6a-7610-adaa-109852fda585"},"sequence":389,"recorded_at":1780531400000773,"record_type":"event","durability":"durable","causation_id":"be2f90a4-329e-4dfe-906d-93614b40b7f2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"be2f90a4-329e-4dfe-906d-93614b40b7f2","run_stream":{"kind":"run","id":"be2f90a4-329e-4dfe-906d-93614b40b7f2"},"call_id":"call_01a0c40d74d0746f9d32dd3732ca702d","text":"Read text file `internal/tmuxserver/socket.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"path/filepath\"\n5|)\n6|\n7|// SocketName is the fixed private socket leaf inside the runtime\n8|// directory. AX derives its server socket from this name under the\n9|// owner-only directory and from nothing else.\n10|const SocketName = \"ax-tmux.sock\"\n11|\n12|// Ambient environment names the four discovery vectors AX must never\n13|// use. TMUXEnv and TMUXTmpDir name the two environment variables\n14|// whose values may carry an ambient socket; InheritedSocket is a\n15|// socket path handed to the process out of band; DefaultPath is the\n16|// operator default socket path; ConventionalName is the bare\n17|// conventional socket name. No member of this struct ever selects\n18|// the acquisition socket: ResolveSocket derives the socket from the\n19|// runtime directory and refuses any explicit override.\n20|type Ambient struct {\n21|\tTMUXEnv          string\n22|\tTMUXTmpDir       string\n23|\tInheritedSocket  string\n24|\tDefaultPath      string\n25|\tConventionalName string\n26|}\n27|\n28|// Ambient environment variable names. Both are validated by the\n29|// landed environment-name grammar at the observation boundary, so a\n30|// misspelled variable cannot smuggle an ambient value past the\n31|// non-use proof.\n32|const (\n33|\t// EnvTMUX is the tmux(1) session environment variable.\n34|\tEnvTMUX = \"TMUX\"\n35|\t// EnvTMUXTmpDir is the tmux(1) socket-directory override.\n36|\tEnvTMUXTmpDir = \"TMUX_TMPDIR\"\n37|)\n38|\n39|// ConventionalSocketName is the operator default socket leaf that AX\n40|// must never resolve to.\n41|const ConventionalSocketName = \"default\"\n42|\n43|// ObserveAmbient records the ambient socket facts visible to the\n44|// caller without using any of them. The lookup is caller-supplied so\n45|// the production entry never reads the process environment itself:\n46|// ambient discovery cannot hide in an os.Getenv call this package\n47|// never makes. The observation is evidence only; resolution derives\n48|// the socket from the runtime directory and never reads it.\n49|func ObserveAmbient(lookup func(name string) (string, bool), inherited, defPath, conventional string) (Ambient, error) {\n50|\tobserved := Ambient{\n51|\t\tInheritedSocket:  inherited,\n52|\t\tDefaultPath:      defPath,\n53|\t\tConventionalName: conventional,\n54|\t}\n55|\tif lookup == nil {\n56|\t\treturn observed, nil\n57|\t}\n58|\tif value, ok := lookup(EnvTMUX); ok {\n59|\t\tobserved.TMUXEnv = value\n60|\t}\n61|\tif value, ok := lookup(EnvTMUXTmpDir); ok {\n62|\t\tobserved.TMUXTmpDir = value\n63|\t}\n64|\treturn observed, nil\n65|}\n66|\n67|// SocketPath derives the dedicated server socket from the runtime\n68|// directory. It is the only socket constructor: acquisition never\n69|// substitutes an ambient value for its result.\n70|func SocketPath(runtimeDir string) string {\n71|\treturn filepath.Join(runtimeDir, SocketName)\n72|}\n73|\n74|// ResolveSocket returns the acquisition socket for the runtime\n75|// directory. An explicit override refuses with the ambient code no\n76|// matter which vector supplied it: there is no override surface,\n77|// only the derived socket. The ambient observation is carried for\n78|// evidence and asserted disjoint from the result by the caller\n79|// tests; resolution never reads it.\n80|func ResolveSocket(runtimeDir string, override string, ambient Ambient) (string, error) {\n81|\tif override != \"\" {\n82|\t\treturn \"\", &Error{Code: CodeAmbientReuse, Detail: \"socket override\"}\n83|\t}\n84|\tsocket := SocketPath(runtimeDir)\n85|\tif err := checkAmbientDisjoint(socket, ambient); err != nil {\n86|\t\treturn \"\", err\n87|\t}\n88|\treturn socket, nil\n89|}\n90|\n91|// checkAmbientDisjoint refuses the degenerate case where an ambient\n92|// value already names the derived socket: using the socket then\n93|// would be indistinguishable from reusing the ambient server, so\n94|// acquisition refuses instead of proceeding on an ambiguous fact.\n95|func checkAmbientDisjoint(socket string, ambient Ambient) error {\n96|\tfor _, candidate := range []string{\n97|\t\tambient.TMUXEnv,\n98|\t\tambient.TMUXTmpDir,\n99|\t\tambient.InheritedSocket,\n100|\t\tambient.DefaultPath,\n101|\t\tambient.ConventionalName,\n102|\t} {\n103|\t\tif candidate != \"\" && candidate == socket {\n104|\t\t\treturn &Error{Code: CodeAmbientReuse, Detail: \"ambient collision\"}\n105|\t\t}\n106|\t}\n107|\treturn nil\n108|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
