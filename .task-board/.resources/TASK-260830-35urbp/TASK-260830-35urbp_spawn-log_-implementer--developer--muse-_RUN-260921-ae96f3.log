jectIdentityRepresentationInvariant$ -fuzztime=100x -parallel=1\\n14 :: go test ./internal/canonicaljson -run=^$ -fuzz=^FuzzClosedIdentityShapeRefusal$ -fuzztime=100x -parallel=1\\n15 :: go test ./internal/canonicaljson -run=^$ -fuzz=^FuzzObservationEventRefusal$ -fuzztime=100x -parallel=1\\n16 :: go test ./internal/secconftest -run=^$ -fuzz=^FuzzCheckArgv$ -fuzztime=100x -parallel=1\\n17 :: go test ./internal/secconftest -run=^$ -fuzz=^FuzzCheckMemberPath$ -fuzztime=100x -parallel=1\\n18 :: go test ./internal/secconftest -run=^$ -fuzz=^FuzzIsEnvName$ -fuzztime=100x -parallel=1\\n19 :: go test ./internal/secconftest -run=^$ -fuzz=^FuzzRedactCorpus$ -fuzztime=100x -parallel=1\\n20 :: go test ./internal/secconftest -run=^$ -fuzz=^FuzzEscapeForTerminal$ -fuzztime=100x -parallel=1\\n21 :: go test ./internal/secconftest -run=^$ -fuzz=^FuzzRenderForTerminal$ -fuzztime=100x -parallel=1\\n22 :: go test ./internal/secconftest -run=^$ -fuzz=^FuzzGuardResolve$ -fuzztime=100x -parallel=1\\n23 :: go test ./internal/secconftest -run=^$ -fuzz=^FuzzDetectCaseCollision$ -fuzztime=100x -parallel=1\\n24 :: go run ./internal/traceability/cmd/tracecheck\\n25 :: go run ./internal/catalog/cmd/cataloggen -adopted -output internal/catalog/catalog_gen.go -check\\n26 :: GOOS=linux GOARCH=amd64 go build ./...\\n27 :: GOOS=windows GOARCH=amd64 go build ./...\\n28 :: git ls-files -z '*.json' | xargs -0 -n1 python3 -c 'import json,sys;json.load(open(sys.argv[1]))'\\n29 :: task-board validate\\n30 :: git diff --check\\n\",\n  \"original_output_bytes\": 2391,\n  \"original_output_tokens\": 598,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
