"\n524|    else:\n525|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\"\n526|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n527|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note} [exit {run.returncode}]\"\n528|\n529|\n530|def main(argv: list[str]) -> int:\n531|    log_dir: Path | None = None\n532|    names = list(argv)\n533|    if \"--log-dir\" in names:\n534|        idx = names.index(\"--log-dir\")\n535|        if idx + 1 >= len(names):\n536|            print(\"--log-dir needs a directory\")\n537|            return 2\n538|        log_dir = Path(names[idx + 1])\n539|        log_dir.mkdir(parents=True, exist_ok=True)\n540|        del names[idx : idx + 2]\n541|    selected = [m for m in MUTANTS if not names or m.name in names]\n542|    if names and len(selected) != len(names):\n543|        unknown = sorted(set(names) - {m.name for m in selected})\n544|        print(f\"unknown mutants: {', '.join(unknown)}\")\n545|        return 2\n546|    failures = 0\n547|    for mutant in selected:\n548|        try:\n549|            line = run_mutant(mutant, log_dir)\n550|        except subprocess.TimeoutExpired:\n551|            line = f\"ERROR: {mutant.name}: killer timed out\"\n552|        print(line, flush=True)\n553|        if not line.startswith(\"ok:\"):\n554|            failures += 1\n555|    return 1 if failures else 0\n556|\n557|\n558|if __name__ == \"__main__\":\n559|    sys.exit(main(sys.argv[1:]))","final_result":true}}}
