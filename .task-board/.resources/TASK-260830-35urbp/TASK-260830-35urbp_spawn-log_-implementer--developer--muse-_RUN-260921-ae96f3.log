{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca3f","stream":{"kind":"session","id":"01a0c40c-7a6a-7610-adaa-109852fda585"},"sequence":890,"recorded_at":1780531400001775,"record_type":"event","durability":"durable","causation_id":"be2f90a4-329e-4dfe-906d-93614b40b7f2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"be2f90a4-329e-4dfe-906d-93614b40b7f2","run_stream":{"kind":"run","id":"be2f90a4-329e-4dfe-906d-93614b40b7f2"},"task_stream":{"kind":"task","id":"01a0c410-3cf4-7051-9dd8-764159fe947e"},"task_id":"01a0c410-3cf4-7051-9dd8-764159fe947e","event":{"kind":"output","task_id":"01a0c410-3cf4-7051-9dd8-764159fe947e","chunk":"edited\nchanged lines: lines 91-108\n--- original\n+++ updated\n@@\n-// checkAmbientDisjoint refuses the degenerate case where an ambient\n-// value already names the derived socket: using the socket then\n-// would be indistinguishable from reusing the ambient server, so\n-// acquisition refuses instead of proceeding on an ambiguous fact.\n-func checkAmbientDisjoint(socket string, ambient Ambient) error {\n-\tfor _, candidate := range []string{\n-\t\tambient.TMUXEnv,\n-\t\tambient.TMUXTmpDir,\n-\t\tambient.InheritedSocket,\n-\t\tambient.DefaultPath,\n-\t\tambient.ConventionalName,\n-\t} {\n-\t\tif candidate != \"\" && candidate == socket {\n-\t\t\treturn &Error{Code: CodeAmbientReuse, Detail: \"ambient collision\"}\n-\t\t}\n-\t}\n-\treturn nil\n-}\n+// checkAmbientDisjoint refuses the degenerate case where an ambient\n+// value already names the derived socket: using the socket then\n+// would be indistinguishable from reusing the ambient server, so\n+// acquisition refuses instead of proceeding on an ambiguous fact.\n+// The comparison runs over cleaned spellings, so an ambient value\n+// that names the socket through a `/./` segment or a doubled\n+// separator refuses like the byte-identical spelling. A symlink\n+// alias of the root that resolves to the same socket is not\n+// detected and stays a stated bound.\n+func checkAmbientDisjoint(socket string, ambient Ambient) error {\n+\tfor _, candidate := range []string{\n+\t\tambient.TMUXEnv,\n+\t\tambient.TMUXTmpDir,\n+\t\tambient.InheritedSocket,\n+\t\tambient.DefaultPath,\n+\t\tambient.ConventionalName,\n+\t} {\n+\t\tif candidate != \"\" && filepath.Clean(candidate) == socket {\n+\t\t\treturn &Error{Code: CodeAmbientReuse, Detail: \"ambient collision\"}\n+\t\t}\n+\t}\n+\treturn nil\n+}\n","final_result":true}}}
