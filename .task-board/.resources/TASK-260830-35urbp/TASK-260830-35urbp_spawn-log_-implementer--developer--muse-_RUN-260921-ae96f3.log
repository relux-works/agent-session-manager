{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6f5","stream":{"kind":"session","id":"01a0c40c-7a6a-7610-adaa-109852fda585"},"sequence":469,"recorded_at":1780531400000933,"record_type":"event","durability":"durable","causation_id":"be2f90a4-329e-4dfe-906d-93614b40b7f2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"be2f90a4-329e-4dfe-906d-93614b40b7f2","run_stream":{"kind":"run","id":"be2f90a4-329e-4dfe-906d-93614b40b7f2"},"task_stream":{"kind":"task","id":"01a0c40d-93fb-7703-a9d4-541e980914ee"},"task_id":"01a0c40d-93fb-7703-a9d4-541e980914ee","event":{"kind":"output","task_id":"01a0c40d-93fb-7703-a9d4-541e980914ee","chunk":"Read text file `internal/tmuxserver/readiness_test.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"testing\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n7|)\n8|\n9|func TestCheckServerAttestedAdmitsBound(t *testing.T) {\n10|\tif err := CheckServerAttested(boundAdmission(), fixtureGeneration); err != nil {\n11|\t\tt.Fatal(err)\n12|\t}\n13|}\n14|\n15|func TestCheckServerAttestedRefusesEachMissingConjunct(t *testing.T) {\n16|\tfor _, tc := range []struct {\n17|\t\tname      string\n18|\t\tadmission RealmAdmission\n19|\t\twant      string\n20|\t\tdetail    string\n21|\t}{\n22|\t\t{\"no admission rows\", RealmAdmission{RawGeneration: fixtureGeneration}, fixtureGeneration, \"server attestation\"},\n23|\t\t{\"decoy capability only\", RealmAdmission{\n24|\t\t\tAdmitted:      terminalbackend.Admitted{Capabilities: []string{fixtureDecoyCapacity}},\n25|\t\t\tRawGeneration: fixtureGeneration,\n26|\t\t}, fixtureGeneration, \"server attestation\"},\n27|\t\t{\"stale generation admission\", staleAdmission(), fixtureGeneration, \"server generation\"},\n28|\t\t{\"empty raw generation\", RealmAdmission{Admitted: realmAdmitted()}, fixtureGeneration, \"server generation\"},\n29|\t\t{\"empty wanted generation\", boundAdmission(), \"\", \"server generation\"},\n30|\t} {\n31|\t\tt.Run(tc.name, func(t *testing.T) {\n32|\t\t\trequireLocalError(t, CheckServerAttested(tc.admission, tc.want), \"tmux_readiness_not_authorizing\", tc.detail)\n33|\t\t})\n34|\t}\n35|}\n36|\n37|func TestCheckBrokerContactAdmitsLiveReport(t *testing.T) {\n38|\tif err := CheckBrokerContact(brokerReport(), fixtureGeneration, currentUID()); err != nil {\n39|\t\tt.Fatal(err)\n40|\t}\n41|}\n42|\n43|func TestCheckBrokerContactRefusesEachMissingFact(t *testing.T) {\n44|\tlive := brokerReport()\n45|\tfor _, tc := range []struct {\n46|\t\tname   string\n47|\t\treport BrokerReport\n48|\t\tdetail string\n49|\t}{\n50|\t\t{\"no broker\", BrokerReport{}, \"broker authentication\"},\n51|\t\t{\"foreign-user broker\", BrokerReport{\n52|\t\t\tPrincipal: BrokerPrincipal{UID: foreignUID(), Generation: fixtureGeneration},\n53|\t\t\tServer:    boundAdmission(),\n54|\t\t}, \"broker authentication\"},\n55|\t\t{\"generation-unbound principal\", BrokerReport{\n56|\t\t\tPrincipal: BrokerPrincipal{UID: live.Principal.UID, Generation: fixtureStaleGen},\n57|\t\t\tServer:    boundAdmission(),\n58|\t\t}, \"broker generation\"},\n59|\t\t{\"empty principal generation\", BrokerReport{\n60|\t\t\tPrincipal: BrokerPrincipal{UID: live.Principal.UID},\n61|\t\t\tServer:    boundAdmission(),\n62|\t\t}, \"broker generation\"},\n63|\t\t{\"unattested server\", BrokerReport{\n64|\t\t\tPrincipal: live.Principal,\n65|\t\t\tServer:    RealmAdmission{RawGeneration: fixtureGeneration},\n66|\t\t}, \"server attestation\"},\n67|\t\t{\"stale server admission\", BrokerReport{\n68|\t\t\tPrincipal: live.Principal,\n69|\t\t\tServer:    staleAdmission(),\n70|\t\t}, \"server generation\"},\n71|\t} {\n72|\t\tt.Run(tc.name, func(t *testing.T) {\n73|\t\t\trequireLocalError(t, CheckBrokerContact(tc.report, fixtureGeneration, currentUID()), \"tmux_readiness_not_authorizing\", tc.detail)\n74|\t\t})\n75|\t}\n76|}","final_result":true}}}
