{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8cf","stream":{"kind":"session","id":"01a0c40c-7a6a-7610-adaa-109852fda585"},"sequence":706,"recorded_at":1780531400001407,"record_type":"event","durability":"durable","causation_id":"be2f90a4-329e-4dfe-906d-93614b40b7f2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"be2f90a4-329e-4dfe-906d-93614b40b7f2","run_stream":{"kind":"run","id":"be2f90a4-329e-4dfe-906d-93614b40b7f2"},"call_id":"call_01a0c40eca6777f5bc935a179d9fb290","text":"Read text file `/tmp/rev3ref/probes/zz_review_probe_test.go`.\n1|//go:build !windows\n2|\n3|package tmuxserver\n4|\n5|// Reviewer probes for CR-TASK-260830-35urbp-2 (RUN-260921-5a9d4b).\n6|// Each probe states its prediction in its name or comment; a probe that\n7|// PASSES confirms the prediction. None of these is a product edit: the\n8|// file lives only in the reviewer's isolated probe copy.\n9|\n10|import (\n11|\t\"errors\"\n12|\t\"os\"\n13|\t\"path/filepath\"\n14|\t\"strings\"\n15|\t\"syscall\"\n16|\t\"testing\"\n17|\t\"time\"\n18|\n19|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n20|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n21|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n22|)\n23|\n24|func probeForeground(t *testing.T, root string) (Request, *spawnSpy) {\n25|\tt.Helper()\n26|\treq := validRequest(t, root)\n27|\tspy := &spawnSpy{}\n28|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) { return ServerReport{}, nil }\n29|\treq.Deps.Spawn = spy.spawn\n30|\treturn req, spy\n31|}\n32|\n33|// P01: the collision gate compares strings, not paths. An ambient value\n34|// that names the derived socket through an unclean spelling walks past\n35|// it. Prediction: admitted (spawned), i.e. the gate is bypassed.\n36|func TestReviewProbeCollisionUncleanDotSpellingWalksThrough(t *testing.T) {\n37|\troot := stateRoot(t)\n38|\tdir := runtimeDir(t, root)\n39|\treq, spy := probeForeground(t, root)\n40|\talias := dir + \"/./\" + SocketName\n41|\tif filepath.Clean(alias) != SocketPath(dir) {\n42|\t\tt.Fatalf(\"alias %q does not clean to the derived socket\", alias)\n43|\t}\n44|\treq.Ambient = Ambient{DefaultPath: alias}\n45|\toutcome, err := Acquire(req)\n46|\tif err != nil {\n47|\t\tt.Fatalf(\"PREDICTION FAILED: unclean alias was refused: %v\", err)\n48|\t}\n49|\tif outcome.Via != \"spawned\" || spy.calls != 1 {\n50|\t\tt.Fatalf(\"outcome = %+v spawns=%d\", outcome, spy.calls)\n51|\t}\n52|\tt.Logf(\"CONFIRMED: ambient %q names the derived socket %q after Clean and is admitted\", alias, outcome.Socket)\n53|}\n54|\n55|// P02: same with a doubled separator.\n56|func TestReviewProbeCollisionDoubleSlashSpellingWalksThrough(t *testing.T) {\n57|\troot := stateRoot(t)\n58|\tdir := runtimeDir(t, root)\n59|\treq, _ := probeForeground(t, root)\n60|\talias := dir + \"//\" + SocketName\n61|\treq.Ambient = Ambient{InheritedSocket: alias}\n62|\tif _, err := Acquire(req); err != nil {\n63|\t\tt.Fatalf(\"PREDICTION FAILED: doubled-separator alias was refused: %v\", err)\n64|\t}\n65|\tt.Logf(\"CONFIRMED: %q admitted\", alias)\n66|}\n67|\n68|// P03: an ambient value that names the derived socket through a symlinked\n69|// root alias also walks through (realpath equivalence is not applied).\n70|func TestReviewProbeCollisionSymlinkAliasWalksThrough(t *testing.T) {\n71|\troot := stateRoot(t)\n72|\tdir := runtimeDir(t, root)\n73|\tlink := filepath.Join(t.TempDir(), \"alias-root\")\n74|\tif err := os.Symlink(root, link); err != nil {\n75|\t\tt.Fatal(err)\n76|\t}\n77|\talias := filepath.Join(link, RuntimeDirName, SocketName)\n78|\trealAliasDir, err := filepath.EvalSymlinks(filepath.Join(link, RuntimeDirName))\n79|\tif err != nil {\n80|\t\tt.Fatal(err)\n81|\t}\n82|\trealDir, err := filepath.EvalSymlinks(dir)\n83|\tif err != nil {\n84|\t\tt.Fatal(err)\n85|\t}\n86|\tif realAliasDir != realDir {\n87|\t\tt.Fatalf(\"alias dir %q resolves to %q, derived dir resolves to %q\", alias, realAliasDir, realDir)\n88|\t}\n89|\tif alias == SocketPath(dir) {\n90|\t\tt.Fatal(\"alias spelled identically; probe is vacuous\")\n91|\t}\n92|\treq, _ := probeForeground(t, root)\n93|\treq.Ambient = Ambient{TMUXEnv: alias}\n94|\tif _, err := Acquire(req); err != nil {\n95|\t\tt.Fatalf(\"PREDICTION FAILED: symlink alias was refused: %v\", err)\n96|\t}\n97|\tt.Logf(\"CONFIRMED: %q (resolves to the derived socket) admitted\", alias)\n98|}\n99|\n100|func runWithDeadline(t *testing.T, name string, fn func() error) error {\n101|\tt.Helper()\n102|\tdone := make(chan error, 1)\n103|\tgo func() { done <- fn() }()\n104|\tselect {\n105|\tcase err := <-done:\n106|\t\treturn err\n107|\tcase <-time.After(5 * time.Second):\n108|\t\tt.Fatalf(\"%s BLOCKED for 5s (a FIFO open without O_NONBLOCK/O_DIRECTORY hangs)\", name)\n109|\t\treturn nil\n110|\t}\n111|}\n112|\n113|// P04: a FIFO leaf refuses on the commit side without blocking.\n114|func TestReviewProbeFIFOLeafEnsureRefusesWithoutBlocking(t *testing.T) {\n115|\troot := stateRoot(t)\n116|\tif err := syscall.Mkfifo(filepath.Join(root, RuntimeDirName), 0o600); err != nil {\n117|\t\tt.Fatal(err)\n118|\t}\n119|\terr := runWithDeadline(t, \"EnsureRuntimeDir\", func() error {\n120|\t\t_, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n121|\t\treturn err\n122|\t})\n123|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n124|}\n125|\n126|// P05: a FIFO leaf refuses on the verify side without blocking.\n127|func TestReviewProbeFIFOLeafVerifyRefusesWithoutBlocking(t *testing.T) {\n128|\troot := stateRoot(t)\n129|\tif err := syscall.Mkfifo(filepath.Join(root, RuntimeDirName), 0o600); err != nil {\n130|\t\tt.Fatal(err)\n131|\t}\n132|\terr := runWithDeadline(t, \"VerifyRuntimeDir\", func() error {\n133|\t\treturn VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS)\n134|\t})\n135|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n136|}\n137|\n138|// P06: a FIFO root refuses on both entries without blocking.\n139|func TestReviewProbeFIFORootRefusesWithoutBlocking(t *testing.T) {\n140|\troot := filepath.Join(t.TempDir(), \"fifo-root\")\n141|\tif err := syscall.Mkfifo(root, 0o600); err != nil {\n142|\t\tt.Fatal(err)\n143|\t}\n144|\terr := runWithDeadline(t, \"EnsureRuntimeDir(fifo root)\", func() error {\n145|\t\t_, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n146|\t\treturn err\n147|\t})\n148|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n149|\terr = runWithDeadline(t, \"VerifyRuntimeDir(fifo root)\", func() error {\n150|\t\treturn VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS)\n151|\t})\n152|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n153|}\n154|\n155|// P07: bound B11 — a symlinked intermediate component inside the root\n156|// path is followed; the leaf lands under the link target.\n157|func TestReviewProbeSymlinkedIntermediateInRootIsFollowed(t *testing.T) {\n158|\ttarget := stateRoot(t)\n159|\tif err := os.Mkdir(filepath.Join(target, \"state\"), 0o755); err != nil {\n160|\t\tt.Fatal(err)\n161|\t}\n162|\tlink := filepath.Join(t.TempDir(), \"link\")\n163|\tif err := os.Symlink(target, link); err != nil {\n164|\t\tt.Fatal(err)\n165|\t}\n166|\troot := filepath.Join(link, \"state\")\n167|\tdir, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n168|\tif err != nil {\n169|\t\tt.Fatalf(\"PREDICTION FAILED (B11): symlinked intermediate refused: %v\", err)\n170|\t}\n171|\tif _, err := os.Lstat(filepath.Join(target, \"state\", RuntimeDirName)); err != nil {\n172|\t\tt.Fatalf(\"leaf not under the link target: %v\", err)\n173|\t}\n174|\tt.Logf(\"CONFIRMED B11: %q created through a symlinked intermediate\", dir)\n175|}\n176|\n177|// P08: the mode gate reads Perm() only; setgid/sticky bits on a 0700\n178|// leaf are admitted (observation, not a spec rule).\n179|func TestReviewProbeSetgidStickyBitsOnLeafAdmitted(t *testing.T) {\n180|\troot := stateRoot(t)\n181|\tdir := runtimeDir(t, root)\n182|\tif err := os.Chmod(dir, 0o700|os.ModeSetgid|os.ModeSticky); err != nil {\n183|\t\tt.Fatal(err)\n184|\t}\n185|\tinfo, err := os.Lstat(dir)\n186|\tif err != nil {\n187|\t\tt.Fatal(err)\n188|\t}\n189|\tt.Logf(\"leaf mode now %v\", info.Mode())\n190|\tif _, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil); err != nil {\n191|\t\tt.Fatalf(\"PREDICTION FAILED: setgid/sticky 0700 leaf refused: %v\", err)\n192|\t}\n193|\tif err := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS); err != nil {\n194|\t\tt.Fatalf(\"PREDICTION FAILED: verify refused: %v\", err)\n195|\t}\n196|\tt.Log(\"CONFIRMED: Perm()-only mode gate admits 0700 with setgid/sticky set\")\n197|}\n198|\n199|// P09: baseline for the reviewer plant R-verify-odirectory: a regular\n200|// 0700 file at the leaf refuses on the VERIFY side with the containment\n201|// detail (O_DIRECTORY at lookup). No committed test drives this arm.\n202|func TestReviewProbeVerifyRegularFileLeafRefuses(t *testing.T) {\n203|\troot := stateRoot(t)\n204|\tleaf := filepath.Join(root, RuntimeDirName)\n205|\tif err := os.WriteFile(leaf, []byte(\"x\"), 0o700); err != nil {\n206|\t\tt.Fatal(err)\n207|\t}\n208|\terr := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS)\n209|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n210|}\n211|\n212|// P09b: the same through the background production entry.\n213|func TestReviewProbeBackgroundRegularFileLeafRefusesThroughAcquire(t *testing.T) {\n214|\troot := stateRoot(t)\n215|\tleaf := filepath.Join(root, RuntimeDirName)\n216|\tif err := os.WriteFile(leaf, []byte(\"x\"), 0o700); err != nil {\n217|\t\tt.Fatal(err)\n218|\t}\n219|\treq := validRequest(t, root)\n220|\treq.Caller = CallerBackground\n221|\tprobed := false\n222|\treq.Deps.ProbeBroker = func() (BrokerReport, error) { probed = true; return brokerReport(), nil }\n223|\t_, err := Acquire(req)\n224|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n225|\tif probed {\n226|\t\tt.Fatal(\"broker probed past a non-directory leaf\")\n227|\t}\n228|}\n229|\n230|// P10: baseline for the reviewer plant R-attested-empty-generation: an\n231|// admission with an EMPTY raw generation against an EMPTY wanted\n232|// generation refuses on the generation arm. No committed test drives\n233|// both-empty (the committed rows each keep one side non-empty).\n234|func TestReviewProbeCheckServerAttestedBothGenerationsEmptyRefuses(t *testing.T) {\n235|\terr := CheckServerAttested(RealmAdmission{Admitted: realmAdmitted()}, \"\")\n236|\trequireLocalError(t, err, \"tmux_readiness_not_authorizing\", \"server generation\")\n237|}\n238|\n239|// P11: baseline for the reviewer plant R-broker-empty-generation.\n240|func TestReviewProbeCheckBrokerContactBothGenerationsEmptyRefuses(t *testing.T) {\n241|\treport := BrokerReport{\n242|\t\tPrincipal: BrokerPrincipal{UID: currentUID()},\n243|\t\tServer:    RealmAdmission{Admitted: realmAdmitted()},\n244|\t}\n245|\terr := CheckBrokerContact(report, \"\", currentUID())\n246|\trequireLocalError(t, err, \"tmux_readiness_not_authorizing\", \"broker generation\")\n247|}\n248|\n249|// P12: a request whose typed generation is newer than the broker's\n250|// live report refuses through Acquire with the request's generation in\n251|// the typed details.\n252|func TestReviewProbeBackgroundNewerRequestGenerationRefuses(t *testing.T) {\n253|\troot := stateRoot(t)\n254|\truntimeDir(t, root)\n255|\treq := validRequest(t, root)\n256|\treq.Caller = CallerBackground\n257|\treq.Generation = \"generation-8\"\n258|\tspy := &spawnSpy{}\n259|\treq.Deps.Spawn = spy.spawn\n260|\treq.Deps.ProbeBroker = func() (BrokerReport, error) { return brokerReport(), nil }\n261|\t_, err := Acquire(req)\n262|\trequireCapabilityUnavailable(t, err, \"background\", fixtureBroker, \"generation-8\", fixtureRemedy)\n263|\tif spy.calls != 0 {\n264|\t\tt.Fatalf(\"spawn calls = %d\", spy.calls)\n265|\t}\n266|}\n267|\n268|// P13: the foreground path never consults the broker probe.\n269|func TestReviewProbeForegroundNeverProbesBroker(t *testing.T) {\n270|\troot := stateRoot(t)\n271|\treq, _ := probeForeground(t, root)\n272|\treq.Deps.ProbeBroker = func() (BrokerReport, error) {\n273|\t\tt.Fatal(\"foreground path probed the broker\")\n274|\t\treturn BrokerReport{}, nil\n275|\t}\n276|\tif _, err := Acquire(req); err != nil {\n277|\t\tt.Fatal(err)\n278|\t}\n279|}\n280|\n281|// P14: backslash in the runtime name refuses at the name grammar.\n282|func TestReviewProbeNameBackslashRefused(t *testing.T) {\n283|\troot := stateRoot(t)\n284|\t_, err := EnsureRuntimeDir(root, `a\\b`, scalar.PlatformMacOS, nil)\n285|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"runtime name\")\n286|}\n287|\n288|// P15: a trailing-slash root — record the behaviour.\n289|func TestReviewProbeRootTrailingSlash(t *testing.T) {\n290|\troot := stateRoot(t)\n291|\tdir, err := EnsureRuntimeDir(root+\"/\", RuntimeDirName, scalar.PlatformMacOS, nil)\n292|\tt.Logf(\"trailing-slash root: dir=%q err=%v\", dir, err)\n293|}\n294|\n295|// P16: a whitespace override refuses (non-empty).\n296|func TestReviewProbeOverrideWhitespaceRefused(t *testing.T) {\n297|\troot := stateRoot(t)\n298|\treq, _ := probeForeground(t, root)\n299|\treq.SocketOverride = \" \"\n300|\t_, err := Acquire(req)\n301|\trequireLocalError(t, err, \"tmux_ambient_server_reuse\", \"socket override\")\n302|}\n303|\n304|// P17: background verify refuses foreign ownership through Acquire\n305|// before the broker is probed (row 7 extended to the entry wiring).\n306|func TestReviewProbeBackgroundForeignOwnershipRefusesThroughAcquire(t *testing.T) {\n307|\troot := stateRoot(t)\n308|\truntimeDir(t, root)\n309|\tprevious := effectiveUID\n310|\teffectiveUID = func() int { return previous() + 100000 }\n311|\tdefer func() { effectiveUID = previous }()\n312|\treq := validRequest(t, root)\n313|\treq.Caller = CallerBackground\n314|\tprobed := false\n315|\treq.Deps.ProbeBroker = func() (BrokerReport, error) { probed = true; return brokerReport(), nil }\n316|\t_, err := Acquire(req)\n317|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime ownership\")\n318|\tif probed {\n319|\t\tt.Fatal(\"broker probed past an ownership refusal\")\n320|\t}\n321|}\n322|\n323|// P18: an over-long remediation reaches the uncovered constructor arm\n324|// (acquire.go:260) and refuses invalid_arguments rather than returning\n325|// nil or an untyped refusal.\n326|func TestReviewProbeOverlongRemediationRefusesTyped(t *testing.T) {\n327|\troot := stateRoot(t)\n328|\truntimeDir(t, root)\n329|\treq := validRequest(t, root)\n330|\treq.Caller = CallerBackground\n331|\tfor name, remedy := range map[string]string{\n332|\t\t\"5000 chars\":    strings.Repeat(\"r\", 5000),\n333|\t\t\"100000 chars\":  strings.Repeat(\"r\", 100000),\n334|\t\t\"invalid utf-8\": \"retry \\xff\\xfe\",\n335|\t\t\"control char\":  \"retry\\x00now\",\n336|\t} {\n337|\t\tt.Run(name, func(t *testing.T) {\n338|\t\t\treq := req\n339|\t\t\treq.Remediation = remedy\n340|\t\t\tspy := &spawnSpy{}\n341|\t\t\treq.Deps.Spawn = spy.spawn\n342|\t\t\treq.Deps.ProbeBroker = func() (BrokerReport, error) { return BrokerReport{}, nil }\n343|\t\t\toutcome, err := Acquire(req)\n344|\t\t\tif err == nil {\n345|\t\t\t\tt.Fatalf(\"PREDICTION FAILED: remediation admitted: %+v\", outcome)\n346|\t\t\t}\n347|\t\t\tvar failure *axerror.Error\n348|\t\t\tif errors.As(err, &failure) {\n349|\t\t\t\tt.Logf(\"axerror %s (exit %d) wrapping %v\", failure.Code(), failure.ExitCode(), errors.Unwrap(err))\n350|\t\t\t} else {\n351|\t\t\t\tvar local *Error\n352|\t\t\t\tif errors.As(err, &local) {\n353|\t\t\t\t\tt.Logf(\"local refusal: %s at %s\", local.Code, local.Detail)\n354|\t\t\t\t} else {\n355|\t\t\t\t\tt.Logf(\"refused with %T: %v\", err, err)\n356|\t\t\t\t}\n357|\t\t\t}\n358|\t\t\tif spy.calls != 0 {\n359|\t\t\t\tt.Fatalf(\"spawn calls = %d\", spy.calls)\n360|\t\t\t}\n361|\t\t})\n362|\t}\n363|}\n364|\n365|// P19: bound B10 — a leaf stranded at 0600 (as if between mkdirat and\n366|// the explicit chmod under an owner-bit-stripping umask) never\n367|// converges: Ensure refuses on every retry.\n368|func TestReviewProbeStrandedNarrowLeafNeverConverges(t *testing.T) {\n369|\troot := stateRoot(t)\n370|\tif err := os.Mkdir(filepath.Join(root, RuntimeDirName), 0o600); err != nil {\n371|\t\tt.Fatal(err)\n372|\t}\n373|\tfor i := 0; i < 2; i++ {\n374|\t\t_, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n375|\t\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime mode\")\n376|\t}\n377|\tt.Log(\"CONFIRMED B10: a stranded 0600 leaf refuses on retry, never repaired\")\n378|}\n379|\n380|// P20: the uncovered Mkdirat error arm (non-EEXIST) is fail-closed: a\n381|// read-only root refuses with the commit detail.\n382|func TestReviewProbeReadOnlyRootRefusesCommit(t *testing.T) {\n383|\tif os.Geteuid() == 0 {\n384|\t\tt.Skip(\"root bypasses directory write permission\")\n385|\t}\n386|\troot := stateRoot(t)\n387|\tif err := os.Chmod(root, 0o500); err != nil {\n388|\t\tt.Fatal(err)\n389|\t}\n390|\tdefer func() { _ = os.Chmod(root, 0o755) }()\n391|\t_, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n392|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime commit\")\n393|}\n394|\n395|// P21: the broker hit path returns the derived socket and no argv even\n396|// when a spawner is wired (spawner unused).\n397|func TestReviewProbeBrokerHitCarriesNoArgvAndDerivedSocket(t *testing.T) {\n398|\troot := stateRoot(t)\n399|\tdir := runtimeDir(t, root)\n400|\treq := validRequest(t, root)\n401|\treq.Caller = CallerBackground\n402|\treq.Ambient = hostileAmbient()\n403|\tspy := &spawnSpy{}\n404|\treq.Deps.Spawn = spy.spawn\n405|\treq.Deps.ProbeBroker = func() (BrokerReport, error) { return brokerReport(), nil }\n406|\toutcome, err := Acquire(req)\n407|\tif err != nil {\n408|\t\tt.Fatal(err)\n409|\t}\n410|\tif outcome.Via != \"broker\" || outcome.Socket != SocketPath(dir) || outcome.Argv != nil || spy.calls != 0 {\n411|\t\tt.Fatalf(\"outcome = %+v spawns=%d\", outcome, spy.calls)\n412|\t}\n413|}\n414|\n415|// P22: a probe reporting an Admitted set with the realm row AND extra\n416|// rows admits (membership, not equality) — confirms Has semantics.\n417|func TestReviewProbeAdmittedSupersetAdmits(t *testing.T) {\n418|\troot := stateRoot(t)\n419|\treq, spy := probeForeground(t, root)\n420|\treq.Deps.ProbeServer = func(socket string) (ServerReport, error) {\n421|\t\treturn ServerReport{Running: true, Admission: RealmAdmission{\n422|\t\t\tAdmitted:      terminalbackend.Admitted{Capabilities: []string{\"durable_disconnect\", \"credential_capable_execution_realm\"}},\n423|\t\t\tRawGeneration: fixtureGeneration,\n424|\t\t}}, nil\n425|\t}\n426|\toutcome, err := Acquire(req)\n427|\tif err != nil {\n428|\t\tt.Fatal(err)\n429|\t}\n430|\tif outcome.Via != \"attached-running\" || spy.calls != 0 {\n431|\t\tt.Fatalf(\"outcome = %+v spawns=%d\", outcome, spy.calls)\n432|\t}\n433|}\n434|\n435|// P23: umask 0077 (owner bits preserved) — Ensure converges to 0700 and\n436|// a subsequent Verify admits.\n437|func TestReviewProbeUmask0077Converges(t *testing.T) {\n438|\troot := stateRoot(t)\n439|\tprevious := syscall.Umask(0o077)\n440|\tdefer syscall.Umask(previous)\n441|\tdir, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n442|\tif err != nil {\n443|\t\tt.Fatal(err)\n444|\t}\n445|\tinfo, err := os.Lstat(dir)\n446|\tif err != nil {\n447|\t\tt.Fatal(err)\n448|\t}\n449|\tif info.Mode().Perm() != 0o700 {\n450|\t\tt.Fatalf(\"mode = %04o\", info.Mode().Perm())\n451|\t}\n452|\tif err := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS); err != nil {\n453|\t\tt.Fatal(err)\n454|\t}\n455|}\n456|\n457|// P24: baseline for the reviewer plant R11b: a pre-existing 0600 leaf\n458|// refuses on the VERIFY side with the mode detail (\"exactly 0700\" on the\n459|// narrower side). No committed test drives a narrower-than-0700 leaf on\n460|// Verify.\n461|func TestReviewProbeVerifyNarrowerLeafRefuses(t *testing.T) {\n462|\troot := stateRoot(t)\n463|\tif err := os.Mkdir(filepath.Join(root, RuntimeDirName), 0o600); err != nil {\n464|\t\tt.Fatal(err)\n465|\t}\n466|\terr := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS)\n467|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime mode\")\n468|\tif err := os.Chmod(filepath.Join(root, RuntimeDirName), 0o500); err != nil {\n469|\t\tt.Fatal(err)\n470|\t}\n471|\terr = VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS)\n472|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime mode\")\n473|}\n474|\n475|// P25: the argv session token is the canonical (lowercase) UUID even when\n476|// the request spells it in uppercase — records whether the landed grammar\n477|// admits uppercase and whether BuildArgv canonicalizes.\n478|func TestReviewProbeArgvSessionCanonicalized(t *testing.T) {\n479|\tdir := runtimeDir(t, stateRoot(t))\n480|\tupper := strings.ToUpper(fixtureSession)\n481|\targv, err := BuildArgv(dir, SocketPath(dir), upper)\n482|\tif err != nil {\n483|\t\tt.Logf(\"uppercase session refused by the landed grammar: %v\", err)\n484|\t\treturn\n485|\t}\n486|\tt.Logf(\"argv session tokens: -s %q, tail %q\", argv[6], argv[9])\n487|\tif argv[6] != fixtureSession || argv[9] != fixtureSession {\n488|\t\tt.Fatalf(\"argv carries a non-canonical session spelling: %q\", argv)\n489|\t}\n490|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
