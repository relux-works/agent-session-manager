\tambient.TMUXEnv,\n+\t\tambient.TMUXTmpDir,\n+\t\tambient.InheritedSocket,\n+\t\tambient.DefaultPath,\n+\t\tambient.ConventionalName,\n+\t} {\n+\t\tif candidate != \"\" && filepath.Clean(candidate) == socket {\n+\t\t\treturn &Error{Code: CodeAmbientReuse, Detail: \"ambient collision\"}\n+\t\t}\n+\t}\n+\treturn nil\n+}\n","edit_facts":{"tool_name":"edit_file","path":"internal/tmuxserver/socket.go","added":23,"removed":18},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
