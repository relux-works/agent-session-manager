{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6fd","stream":{"kind":"session","id":"01a0c40c-7a6a-7610-adaa-109852fda585"},"sequence":473,"recorded_at":1780531400000941,"record_type":"event","durability":"durable","causation_id":"be2f90a4-329e-4dfe-906d-93614b40b7f2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"be2f90a4-329e-4dfe-906d-93614b40b7f2","run_stream":{"kind":"run","id":"be2f90a4-329e-4dfe-906d-93614b40b7f2"},"call_id":"call_01a0c40d8cf674bb88ae1da267bc4f7a","text":"Read text file `internal/tmuxserver/runtime_test.go`.\n1|//go:build !windows\n2|\n3|package tmuxserver\n4|\n5|import (\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"syscall\"\n9|\t\"testing\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|func TestEnsureRuntimeDirCreatesOwnerOnly(t *testing.T) {\n15|\troot := stateRoot(t)\n16|\tdir, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n17|\tif err != nil {\n18|\t\tt.Fatal(err)\n19|\t}\n20|\tif dir != filepath.Join(root, RuntimeDirName) {\n21|\t\tt.Fatalf(\"dir = %q\", dir)\n22|\t}\n23|\tinfo, err := os.Lstat(dir)\n24|\tif err != nil {\n25|\t\tt.Fatal(err)\n26|\t}\n27|\tif !info.IsDir() || info.Mode().Perm() != 0o700 {\n28|\t\tt.Fatalf(\"mode = %04o dir=%v, want 0700 dir\", info.Mode().Perm(), info.IsDir())\n29|\t}\n30|}\n31|\n32|func TestEnsureRuntimeDirIsIdempotent(t *testing.T) {\n33|\troot := stateRoot(t)\n34|\tfirst, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n35|\tif err != nil {\n36|\t\tt.Fatal(err)\n37|\t}\n38|\tsecond, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n39|\tif err != nil {\n40|\t\tt.Fatal(err)\n41|\t}\n42|\tif first != second {\n43|\t\tt.Fatalf(\"second = %q, want %q\", second, first)\n44|\t}\n45|\tinfo, err := os.Lstat(second)\n46|\tif err != nil {\n47|\t\tt.Fatal(err)\n48|\t}\n49|\tif info.Mode().Perm() != 0o700 {\n50|\t\tt.Fatalf(\"mode after re-ensure = %04o, want 0700\", info.Mode().Perm())\n51|\t}\n52|}\n53|\n54|func TestVerifyRuntimeDirAdmitsCompliant(t *testing.T) {\n55|\troot := stateRoot(t)\n56|\truntimeDir(t, root)\n57|\tif err := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS); err != nil {\n58|\t\tt.Fatal(err)\n59|\t}\n60|}\n61|\n62|func TestEnsureRuntimeDirRefusesWidenedMode(t *testing.T) {\n63|\troot := stateRoot(t)\n64|\tdir, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n65|\tif err != nil {\n66|\t\tt.Fatal(err)\n67|\t}\n68|\t// The suite widens the mode behind the entry's back; re-entry\n69|\t// must refuse, never silently repair.\n70|\tif err := os.Chmod(dir, 0o755); err != nil {\n71|\t\tt.Fatal(err)\n72|\t}\n73|\t_, err = EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n74|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime mode\")\n75|\tif err := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS); err != nil {\n76|\t\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime mode\")\n77|\t} else {\n78|\t\tt.Fatal(\"VerifyRuntimeDir admitted a 0755 directory\")\n79|\t}\n80|}\n81|\n82|func TestEnsureRuntimeDirRefusesNonDirectoryLeaf(t *testing.T) {\n83|\troot := stateRoot(t)\n84|\tleaf := filepath.Join(root, RuntimeDirName)\n85|\tif err := os.WriteFile(leaf, []byte(\"x\"), 0o600); err != nil {\n86|\t\tt.Fatal(err)\n87|\t}\n88|\t_, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n89|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n90|}\n91|\n92|func TestEnsureRuntimeDirRefusesSymlinkLeaf(t *testing.T) {\n93|\troot := stateRoot(t)\n94|\tescape := t.TempDir()\n95|\tleaf := filepath.Join(root, RuntimeDirName)\n96|\tif err := os.Symlink(escape, leaf); err != nil {\n97|\t\tt.Fatal(err)\n98|\t}\n99|\t_, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n100|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n101|}\n102|\n103|func TestEnsureRuntimeDirRefusesForeignOwnership(t *testing.T) {\n104|\troot := stateRoot(t)\n105|\truntimeDir(t, root)\n106|\tprevious := effectiveUID\n107|\teffectiveUID = func() int { return previous() + 100000 }\n108|\tdefer func() { effectiveUID = previous }()\n109|\t_, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n110|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime ownership\")\n111|\tif err := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS); err != nil {\n112|\t\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime ownership\")\n113|\t} else {\n114|\t\tt.Fatal(\"VerifyRuntimeDir admitted foreign ownership\")\n115|\t}\n116|}\n117|\n118|func TestEnsureRuntimeDirRefusesHandleMismatch(t *testing.T) {\n119|\troot := stateRoot(t)\n120|\tprevious := sameDirectory\n121|\tsameDirectory = func(_, _ os.FileInfo) bool { return false }\n122|\tdefer func() { sameDirectory = previous }()\n123|\t_, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n124|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n125|\tif err := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS); err != nil {\n126|\t\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n127|\t} else {\n128|\t\tt.Fatal(\"VerifyRuntimeDir admitted a handle mismatch\")\n129|\t}\n130|}\n131|\n132|func TestEnsureRuntimeDirRefusesSymlinkRoot(t *testing.T) {\n133|\treal := stateRoot(t)\n134|\tlink := filepath.Join(t.TempDir(), \"linkroot\")\n135|\tif err := os.Symlink(real, link); err != nil {\n136|\t\tt.Fatal(err)\n137|\t}\n138|\t_, err := EnsureRuntimeDir(link, RuntimeDirName, scalar.PlatformMacOS, nil)\n139|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n140|}\n141|\n142|func TestEnsureRuntimeDirRefusesBadRoots(t *testing.T) {\n143|\troot := stateRoot(t)\n144|\tfor _, tc := range []struct {\n145|\t\tname string\n146|\t\troot string\n147|\t}{\n148|\t\t{\"relative\", \"relative/root\"},\n149|\t\t{\"empty\", \"\"},\n150|\t\t{\"parent\", \"/tmp/../etc\"},\n151|\t\t{\"missing\", filepath.Join(root, \"no-such-root\")},\n152|\t} {\n153|\t\tt.Run(tc.name, func(t *testing.T) {\n154|\t\t\t_, err := EnsureRuntimeDir(tc.root, RuntimeDirName, scalar.PlatformMacOS, nil)\n155|\t\t\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"runtime root\")\n156|\t\t})\n157|\t}\n158|}\n159|\n160|func TestEnsureRuntimeDirRefusesBadNames(t *testing.T) {\n161|\troot := stateRoot(t)\n162|\tfor _, tc := range []struct {\n163|\t\tname  string\n164|\t\tvalue string\n165|\t}{\n166|\t\t{\"empty\", \"\"},\n167|\t\t{\"dot\", \".\"},\n168|\t\t{\"parent\", \"..\"},\n169|\t\t{\"nested\", \"a/b\"},\n170|\t\t{\"absolute\", \"/abs\"},\n171|\t\t{\"nul\", \"a\\x00b\"},\n172|\t} {\n173|\t\tt.Run(tc.name, func(t *testing.T) {\n174|\t\t\t_, err := EnsureRuntimeDir(root, tc.value, scalar.PlatformMacOS, nil)\n175|\t\t\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"runtime name\")\n176|\t\t})\n177|\t}\n178|}\n179|\n180|func TestEnsureRuntimeDirRefusesBadPlatform(t *testing.T) {\n181|\troot := stateRoot(t)\n182|\t_, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.Platform(\"plan9\"), nil)\n183|\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"runtime platform\")\n184|}\n185|\n186|func TestEnsureRuntimeDirRefusesWindowsOnUnixHost(t *testing.T) {\n187|\t// Native Windows MUST NOT claim tmux: the Windows platform\n188|\t// refuses at the lexical gate on every host, before any\n189|\t// host-specific commit runs.\n190|\tfor _, root := range []string{`C:\\ax-state`, `D:\\other-state`} {\n191|\t\t_, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformWindows, nil)\n192|\t\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"runtime platform\")\n193|\t}\n194|}\n195|\n196|func TestVerifyRuntimeDirRefusesSymlinkLeaf(t *testing.T) {\n197|\troot := stateRoot(t)\n198|\tescape := t.TempDir()\n199|\tleaf := filepath.Join(root, RuntimeDirName)\n200|\tif err := os.Symlink(escape, leaf); err != nil {\n201|\t\tt.Fatal(err)\n202|\t}\n203|\terr := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS)\n204|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n205|}\n206|\n207|// The explicit post-mkdirat mode enforcement is load-bearing: under a\n208|// restrictive umask the mkdir mode alone would leave a narrower leaf,\n209|// and only the explicit chmod converges to the exact owner-only mode.\n210|func TestEnsureRuntimeDirEnforcesModeUnderRestrictiveUmask(t *testing.T) {\n211|\troot := stateRoot(t)\n212|\tprevious := syscall.Umask(0o177)\n213|\tdefer syscall.Umask(previous)\n214|\tdir, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n215|\tif err != nil {\n216|\t\tt.Fatal(err)\n217|\t}\n218|\tinfo, err := os.Lstat(dir)\n219|\tif err != nil {\n220|\t\tt.Fatal(err)\n221|\t}\n222|\tif !info.IsDir() || info.Mode().Perm() != 0o700 {\n223|\t\tt.Fatalf(\"mode under umask 0177 = %04o dir=%v, want 0700 dir\", info.Mode().Perm(), info.IsDir())\n224|\t}\n225|}\n226|\n227|func TestVerifyRuntimeDirRefusesAbsence(t *testing.T) {\n228|\troot := stateRoot(t)\n229|\terr := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS)\n230|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n231|}\n232|\n233|func TestVerifyRuntimeDirRefusesBadLexical(t *testing.T) {\n234|\troot := stateRoot(t)\n235|\tif err := VerifyRuntimeDir(\"relative/root\", RuntimeDirName, scalar.PlatformMacOS); err != nil {\n236|\t\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"runtime root\")\n237|\t} else {\n238|\t\tt.Fatal(\"VerifyRuntimeDir admitted a relative root\")\n239|\t}\n240|\tif err := VerifyRuntimeDir(root, \"a/b\", scalar.PlatformMacOS); err != nil {\n241|\t\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"runtime name\")\n242|\t} else {\n243|\t\tt.Fatal(\"VerifyRuntimeDir admitted a nested name\")\n244|\t}\n245|\tif err := VerifyRuntimeDir(root, RuntimeDirName, scalar.Platform(\"plan9\")); err != nil {\n246|\t\trequireLocalError(t, err, \"tmux_invalid_arguments\", \"runtime platform\")\n247|\t} else {\n248|\t\tt.Fatal(\"VerifyRuntimeDir admitted an unknown platform\")\n249|\t}\n250|}\n251|\n252|func TestVerifyRuntimeDirRefusesMissingRoot(t *testing.T) {\n253|\troot := filepath.Join(stateRoot(t), \"no-such-root\")\n254|\terr := VerifyRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS)\n255|\trequireLocalError(t, err, \"tmux_unsafe_runtime_dir\", \"runtime containment\")\n256|}\n257|\n258|func TestLinuxAndWSL2ShareUnixCustody(t *testing.T) {\n259|\tfor _, platform := range []scalar.Platform{scalar.PlatformLinux, scalar.PlatformWSL2} {\n260|\t\troot := stateRoot(t)\n261|\t\tdir, err := EnsureRuntimeDir(root, RuntimeDirName, platform, nil)\n262|\t\tif err != nil {\n263|\t\t\tt.Fatalf(\"%s: %v\", platform, err)\n264|\t\t}\n265|\t\tinfo, err := os.Lstat(dir)\n266|\t\tif err != nil {\n267|\t\t\tt.Fatal(err)\n268|\t\t}\n269|\t\tif info.Mode().Perm() != 0o700 {\n270|\t\t\tt.Fatalf(\"%s: mode = %04o\", platform, info.Mode().Perm())\n271|\t\t}\n272|\t}\n273|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6ff","stream":{"kind":"session","id":"01a0c40c-7a6a-7610-adaa-109852fda585"},"sequence":474,"recorded_at":1780531400000943,"record_type":"event","durability":"durable","causation_id":"be2f90a4-329e-4dfe-906d-93614b40b7f2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"be2f90a4-329e-4dfe-906d-93614b40b7f2","run_stream":{"kind":"run","id":"be2f90a4-329e-4dfe-906d-93614b40b7f2"},"call_id":"call_01a0c40d8e1c72e0bfb378c55017ea98","text":"Read text file `internal/tmuxserver/readiness_test.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"testing\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n7|)\n8|\n9|func TestCheckServerAttestedAdmitsBound(t *testing.T) {\n10|\tif err := CheckServerAttested(boundAdmission(), fixtureGeneration); err != nil {\n11|\t\tt.Fatal(err)\n12|\t}\n13|}\n14|\n15|func TestCheckServerAttestedRefusesEachMissingConjunct(t *testing.T) {\n16|\tfor _, tc := range []struct {\n17|\t\tname      string\n18|\t\tadmission RealmAdmission\n19|\t\twant      string\n20|\t\tdetail    string\n21|\t}{\n22|\t\t{\"no admission rows\", RealmAdmission{RawGeneration: fixtureGeneration}, fixtureGeneration, \"server attestation\"},\n23|\t\t{\"decoy capability only\", RealmAdmission{\n24|\t\t\tAdmitted:      terminalbackend.Admitted{Capabilities: []string{fixtureDecoyCapacity}},\n25|\t\t\tRawGeneration: fixtureGeneration,\n26|\t\t}, fixtureGeneration, \"server attestation\"},\n27|\t\t{\"stale generation admission\", staleAdmission(), fixtureGeneration, \"server generation\"},\n28|\t\t{\"empty raw generation\", RealmAdmission{Admitted: realmAdmitted()}, fixtureGeneration, \"server generation\"},\n29|\t\t{\"empty wanted generation\", boundAdmission(), \"\", \"server generation\"},\n30|\t} {\n31|\t\tt.Run(tc.name, func(t *testing.T) {\n32|\t\t\trequireLocalError(t, CheckServerAttested(tc.admission, tc.want), \"tmux_readiness_not_authorizing\", tc.detail)\n33|\t\t})\n34|\t}\n35|}\n36|\n37|func TestCheckBrokerContactAdmitsLiveReport(t *testing.T) {\n38|\tif err := CheckBrokerContact(brokerReport(), fixtureGeneration, currentUID()); err != nil {\n39|\t\tt.Fatal(err)\n40|\t}\n41|}\n42|\n43|func TestCheckBrokerContactRefusesEachMissingFact(t *testing.T) {\n44|\tlive := brokerReport()\n45|\tfor _, tc := range []struct {\n46|\t\tname   string\n47|\t\treport BrokerReport\n48|\t\tdetail string\n49|\t}{\n50|\t\t{\"no broker\", BrokerReport{}, \"broker authentication\"},\n51|\t\t{\"foreign-user broker\", BrokerReport{\n52|\t\t\tPrincipal: BrokerPrincipal{UID: foreignUID(), Generation: fixtureGeneration},\n53|\t\t\tServer:    boundAdmission(),\n54|\t\t}, \"broker authentication\"},\n55|\t\t{\"generation-unbound principal\", BrokerReport{\n56|\t\t\tPrincipal: BrokerPrincipal{UID: live.Principal.UID, Generation: fixtureStaleGen},\n57|\t\t\tServer:    boundAdmission(),\n58|\t\t}, \"broker generation\"},\n59|\t\t{\"empty principal generation\", BrokerReport{\n60|\t\t\tPrincipal: BrokerPrincipal{UID: live.Principal.UID},\n61|\t\t\tServer:    boundAdmission(),\n62|\t\t}, \"broker generation\"},\n63|\t\t{\"unattested server\", BrokerReport{\n64|\t\t\tPrincipal: live.Principal,\n65|\t\t\tServer:    RealmAdmission{RawGeneration: fixtureGeneration},\n66|\t\t}, \"server attestation\"},\n67|\t\t{\"stale server admission\", BrokerReport{\n68|\t\t\tPrincipal: live.Principal,\n69|\t\t\tServer:    staleAdmission(),\n70|\t\t}, \"server generation\"},\n71|\t} {\n72|\t\tt.Run(tc.name, func(t *testing.T) {\n73|\t\t\trequireLocalError(t, CheckBrokerContact(tc.report, fixtureGeneration, currentUID()), \"tmux_readiness_not_authorizing\", tc.detail)\n74|\t\t})\n75|\t}\n76|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c701","stream":{"kind":"session","id":"01a0c40c-7a6a-7610-adaa-109852fda585"},"sequence":475,"recorded_at":1780531400000945,"record_type":"event","durability":"durable","causation_id":"be2f90a4-329e-4dfe-906d-93614b40b7f2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"be2f90a4-329e-4dfe-906d-93614b40b7f2","run_stream":{"kind":"run","id":"be2f90a4-329e-4dfe-906d-93614b40b7f2"},"call_id":"call_01a0c40d8f6a73528b4f5ce341987182","text":"Read text file `internal/tmuxserver/socket_test.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|)\n7|\n8|func TestObserveAmbientRecordsWithoutUsing(t *testing.T) {\n9|\thostile := hostileAmbient()\n10|\tobserved, err := ObserveAmbient(func(name string) (string, bool) {\n11|\t\tswitch name {\n12|\t\tcase \"TMUX\":\n13|\t\t\treturn hostile.TMUXEnv, true\n14|\t\tcase \"TMUX_TMPDIR\":\n15|\t\t\treturn hostile.TMUXTmpDir, true\n16|\t\tdefault:\n17|\t\t\treturn \"\", false\n18|\t\t}\n19|\t}, hostile.InheritedSocket, hostile.DefaultPath, hostile.ConventionalName)\n20|\tif err != nil {\n21|\t\tt.Fatal(err)\n22|\t}\n23|\tif observed != hostile {\n24|\t\tt.Fatalf(\"observed = %+v, want %+v\", observed, hostile)\n25|\t}\n26|}\n27|\n28|func TestObserveAmbientNilLookupKeepsOutOfBand(t *testing.T) {\n29|\tobserved, err := ObserveAmbient(nil, \"/tmp/x.sock\", \"/tmp/tmux-501/default\", \"default\")\n30|\tif err != nil {\n31|\t\tt.Fatal(err)\n32|\t}\n33|\tif observed.TMUXEnv != \"\" || observed.TMUXTmpDir != \"\" {\n34|\t\tt.Fatalf(\"nil lookup observed env: %+v\", observed)\n35|\t}\n36|\tif observed.InheritedSocket != \"/tmp/x.sock\" {\n37|\t\tt.Fatalf(\"observed = %+v\", observed)\n38|\t}\n39|}\n40|\n41|func TestResolveSocketDerivesIgnoringAmbient(t *testing.T) {\n42|\tdir := runtimeDir(t, stateRoot(t))\n43|\tsocket, err := ResolveSocket(dir, \"\", hostileAmbient())\n44|\tif err != nil {\n45|\t\tt.Fatal(err)\n46|\t}\n47|\tif socket != SocketPath(dir) {\n48|\t\tt.Fatalf(\"socket = %q\", socket)\n49|\t}\n50|\tfor _, ambient := range []string{\n51|\t\thostileAmbient().TMUXEnv,\n52|\t\thostileAmbient().TMUXTmpDir,\n53|\t\thostileAmbient().InheritedSocket,\n54|\t\thostileAmbient().DefaultPath,\n55|\t\thostileAmbient().ConventionalName,\n56|\t} {\n57|\t\tif strings.Contains(socket, ambient) || socket == ambient {\n58|\t\t\tt.Fatalf(\"socket %q reuses ambient %q\", socket, ambient)\n59|\t\t}\n60|\t}\n61|}\n62|\n63|func TestResolveSocketRefusesEveryOverrideVector(t *testing.T) {\n64|\tdir := runtimeDir(t, stateRoot(t))\n65|\thostile := hostileAmbient()\n66|\tvectors := map[string]string{\n67|\t\t\"environment variable\": hostile.TMUXEnv,\n68|\t\t\"tmux tmpdir\":          hostile.TMUXTmpDir,\n69|\t\t\"inherited socket\":     hostile.InheritedSocket,\n70|\t\t\"default path\":         hostile.DefaultPath,\n71|\t\t\"conventional name\":    hostile.ConventionalName,\n72|\t}\n73|\tfor name, override := range vectors {\n74|\t\tt.Run(name, func(t *testing.T) {\n75|\t\t\t_, err := ResolveSocket(dir, override, Ambient{})\n76|\t\t\trequireLocalError(t, err, \"tmux_ambient_server_reuse\", \"socket override\")\n77|\t\t})\n78|\t}\n79|}\n80|\n81|func TestResolveSocketRefusesAmbientCollision(t *testing.T) {\n82|\tdir := runtimeDir(t, stateRoot(t))\n83|\tderived := SocketPath(dir)\n84|\tfor _, tc := range []struct {\n85|\t\tname    string\n86|\t\tambient Ambient\n87|\t}{\n88|\t\t{\"tmux env\", Ambient{TMUXEnv: derived}},\n89|\t\t{\"tmux tmpdir\", Ambient{TMUXTmpDir: derived}},\n90|\t\t{\"inherited socket\", Ambient{InheritedSocket: derived}},\n91|\t\t{\"default path\", Ambient{DefaultPath: derived}},\n92|\t\t{\"conventional name\", Ambient{ConventionalName: derived}},\n93|\t} {\n94|\t\tt.Run(tc.name, func(t *testing.T) {\n95|\t\t\t_, err := ResolveSocket(dir, \"\", tc.ambient)\n96|\t\t\trequireLocalError(t, err, \"tmux_ambient_server_reuse\", \"ambient collision\")\n97|\t\t})\n98|\t}\n99|}","c