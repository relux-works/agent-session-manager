{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c805","stream":{"kind":"session","id":"01a0ae5d-13b2-70c2-be9d-d3c6350c7765"},"sequence":605,"recorded_at":1780531400001205,"record_type":"event","durability":"durable","causation_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","run_stream":{"kind":"run","id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28"},"call_id":"call_01a0ae61f31f739787a58fabcec56373","text":"Read text file `internal/rpcwire/hello.go`.\n1|package rpcwire\n2|\n3|import (\n4|\t\"crypto/rand\"\n5|\t\"encoding/base64\"\n6|\t\"encoding/json\"\n7|\t\"regexp\"\n8|\t\"slices\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|)\n12|\n13|var semver = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n14|\n15|// Hello is a structural claim, including the untrusted HostID and limits.\n16|// Received nonce randomness and freshness cannot be established by a codec.\n17|type Hello struct {\n18|\tHostID         string              `json:\"host_id\"`\n19|\tPlatform       string              `json:\"platform\"`\n20|\tAXVersion      string              `json:\"ax_version\"`\n21|\tNonce          string              `json:\"nonce\"`\n22|\tNonceEcho      string              `json:\"nonce_echo,omitempty\"`\n23|\tContracts      map[string][]string `json:\"contracts\"`\n24|\tMaxLineBytes   scalar.Uint53       `json:\"max_line_bytes\"`\n25|\tMaxObjectBytes scalar.Uint53       `json:\"max_object_bytes\"`\n26|}\n27|\n28|// NewNonce produces 256 random bits without accepting caller-supplied entropy.\n29|func NewNonce() string {\n30|\tvar nonce [32]byte\n31|\t_, _ = rand.Read(nonce[:]) // crypto/rand.Read is infallible in Go 1.25.\n32|\treturn base64.RawURLEncoding.EncodeToString(nonce[:])\n33|}\n34|\n35|// ContractProfile describes the pinned wire shape, not installed capabilities.\n36|// Returning a fresh map prevents one caller from changing another's validator.\n37|func ContractProfile(version string) (map[string][]string, error) {\n38|\tn, err := major(version)\n39|\tif err != nil {\n40|\t\treturn nil, err\n41|\t}\n42|\tm := map[string][]string{}\n43|\tfor _, key := range []string{\"rpc\", \"session_record\", \"session_event\", \"lease\", \"checkpoint\", \"workspace_group\", \"provider_identity\", \"blob\", \"transfer_manifest\", \"chunk\", \"materialization_plan\", \"tombstone\", \"tombstone_ack\", \"task_board_bundle\"} {\n44|\t\tm[key] = []string{\"1.0.0\"}\n45|\t}\n46|\tm[\"rpc\"] = []string{version}\n47|\tif n >= 3 {\n48|\t\tm[\"session_record\"] = []string{\"1.0.0\", \"2.0.0\", \"3.0.0\"}\n49|\t\tm[\"session_event\"] = []string{\"1.0.0\", \"2.0.0\", \"3.0.0\"}\n50|\t\tm[\"materialization_plan\"] = []string{\"1.0.0\", \"2.0.0\"}\n51|\t\tfor _, key := range []string{\"environment_observation\", \"native_session_observation\", \"session_inventory_batch\", \"conversation_lineage_link\", \"session_annotation\", \"session_enrichment_profile\", \"session_enrichment_job_request\", \"session_enrichment_job_receipt\", \"session_continuation_plan\", \"session_directory_operation_receipt\"} {\n52|\t\t\tm[key] = []string{\"1.0.0\"}\n53|\t\t}\n54|\t}\n55|\tif n >= 4 {\n56|\t\tm[\"session_event\"] = append(m[\"session_event\"], \"4.0.0\")\n57|\t\tm[\"terminal_backend_evidence\"] = []string{\"1.0.0\"}\n58|\t}\n59|\treturn m, nil\n60|}\n61|\n62|func validNonce(s string) bool {\n63|\tb, err := base64.RawURLEncoding.Strict().DecodeString(s)\n64|\treturn err == nil && len(b) >= 16 && base64.RawURLEncoding.EncodeToString(b) == s\n65|}\n66|func decodeHello(version string, data []byte, response bool) (Hello, error) {\n67|\tm, err := object(data)\n68|\tif err != nil {\n69|\t\treturn Hello{}, ErrHello\n70|\t}\n71|\tkeys := []string{\"host_id\", \"platform\", \"ax_version\", \"nonce\", \"contracts\", \"max_line_bytes\", \"max_object_bytes\"}\n72|\tif response {\n73|\t\tkeys = append(keys, \"nonce_echo\")\n74|\t}\n75|\tif !exact(m, keys...) {\n76|\t\treturn Hello{}, ErrHello\n77|\t}\n78|\tvar h Hello\n79|\tif json.Unmarshal(data, &h) != nil {\n80|\t\treturn Hello{}, ErrHello\n81|\t}\n82|\tif _, err = scalar.ParseUUIDv7(h.HostID); err != nil {\n83|\t\treturn Hello{}, ErrHello\n84|\t}\n85|\tif _, err = scalar.ParsePlatform(h.Platform); err != nil {\n86|\t\treturn Hello{}, ErrHello\n87|\t}\n88|\tif !semver.MatchString(h.AXVersion) || !validNonce(h.Nonce) || (response && !validNonce(h.NonceEcho)) {\n89|\t\treturn Hello{}, ErrHello\n90|\t}\n91|\tif h.MaxLineBytes.Uint64() < MaxLineBytes || h.MaxObjectBytes.Uint64() < MinObjectBytes {\n92|\t\treturn Hello{}, ErrHello\n93|\t}\n94|\tprofile, _ := ContractProfile(version)\n95|\tif len(h.Contracts) != len(profile) {\n96|\t\treturn Hello{}, ErrHello\n97|\t}\n98|\tfor key, expected := range profile {\n99|\t\tversions := h.Contracts[key]\n100|\t\tif len(versions) < 1 || len(versions) > 16 {\n101|\t\t\treturn Hello{}, ErrHello\n102|\t\t}\n103|\t\tfor i, v := range versions {\n104|\t\t\tif !semver.MatchString(v) || (i > 0 && versions[i-1] >= v) {\n105|\t\t\t\treturn Hello{}, ErrHello\n106|\t\t\t}\n107|\t\t}\n108|\t\t// v2 permits 1..16 supported versions for every required key; later\n109|\t\t// pinned maps specify exact arrays. Selecting a common minor is separate.\n110|\t\tif version != \"2.0.0\" && !slices.Equal(versions, expected) {\n111|\t\t\treturn Hello{}, ErrHello\n112|\t\t}\n113|\t}\n114|\treturn h, nil\n115|}\n116|\n117|func (r Request) Hello() (Hello, error) {\n118|\tif r.operation != \"hello\" {\n119|\t\treturn Hello{}, ErrHello\n120|\t}\n121|\treturn decodeHello(r.version, r.body, false)\n122|}\n123|func (r Response) Hello() (Hello, error) {\n124|\tif !r.OK() || r.request.operation != \"hello\" {\n125|\t\treturn Hello{}, ErrHello\n126|\t}\n127|\treturn decodeHello(r.request.version, r.body, true)\n128|}\n129|\n130|// Limits is only the smaller pair of structural offers. It is not a negotiated\n131|// or authenticated connection. The transport's fixed 8 MiB cap still applies.\n132|type Limits struct{ LineBytes, ObjectBytes uint64 }\n133|\n134|func OfferedLimits(request Request, response Response) (Limits, error) {\n135|\ta, err := request.Hello()\n136|\tif err != nil {\n137|\t\treturn Limits{}, err\n138|\t}\n139|\tb, err := response.Hello()\n140|\tif err != nil {\n141|\t\treturn Limits{}, err\n142|\t}\n143|\tif response.request.id != request.id || response.request.version != request.version || a.Nonce != b.NonceEcho {\n144|\t\treturn Limits{}, ErrCorrelation\n145|\t}\n146|\treturn Limits{min(a.MaxLineBytes.Uint64(), b.MaxLineBytes.Uint64()), min(a.MaxObjectBytes.Uint64(), b.MaxObjectBytes.Uint64())}, nil\n147|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c807","stream":{"kind":"session","id":"01a0ae5d-13b2-70c2-be9d-d3c6350c7765"},"sequence":606,"recorded_at":1780531400001207,"record_type":"event","durability":"durable","causation_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","run_stream":{"kind":"run","id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28"},"call_id":"call_01a0ae61f4b07745bcd841e02957c632","text":"Read text file `internal/hostchannel/refusal_test.go`.\n(221 line(s) above)\n222|func TestRefusesTLS12Offer(t *testing.T) {\n223|\tt.Run(\"server\", func(t *testing.T) {\n224|\t\tf := newFixture(t)\n225|\t\tclientConn, serverConn := net.Pipe()\n226|\t\tdefer clientConn.Close()\n227|\t\tdefer serverConn.Close()\n228|\t\tserved := serveAsync(serverConn, f.serverConfig(echoHandler(json.RawMessage(`{}`))))\n229|\t\trogue := tls.Client(clientConn, rogueClientConfig(t, f, f.certA, \"\", func(config *tls.Config) {\n230|\t\t\tconfig.MinVersion = tls.VersionTLS12\n231|\t\t\tconfig.MaxVersion = tls.VersionTLS12\n232|\t\t}))\n233|\t\tif err := rogue.Handshake(); err == nil {\n234|\t\t\tt.Fatal(\"TLS 1.2 handshake succeeded\")\n235|\t\t}\n236|\t\tif err := awaitErr(t, served); !errors.Is(err, hostchannel.ErrAuthenticationFailed) {\n237|\t\t\tt.Fatalf(\"Serve = %v\", err)\n238|\t\t}\n239|\t})\n240|\tt.Run(\"client\", func(t *testing.T) {\n241|\t\tf := newFixture(t)\n242|\t\tclientConn, serverConn := net.Pipe()\n243|\t\tdefer clientConn.Close()\n244|\t\tdefer serverConn.Close()\n245|\t\trogue := tls.Server(serverConn, rogueServerConfig(t, f, f.certB, func(config *tls.Config) {\n246|\t\t\tconfig.MinVersion = tls.VersionTLS12\n247|\t\t\tconfig.MaxVersion = tls.VersionTLS12\n248|\t\t}))\n249|\t\trogueErr := make(chan error, 1)\n250|\t\tgo func() { rogueErr <- rogue.Handshake() }()\n251|\t\tif _, err := hostchannel.Dial(clientConn, f.clientConfig()); !errors.Is(err, hostchannel.ErrAuthenticationFailed) {\n252|\t\t\tt.Fatalf(\"Dial = %v\", err)\n253|\t\t}\n254|\t\t<-rogueErr\n255|\t})\n256|}\n257|\n258|func TestRefusesWrongALPN(t *testing.T) {\n259|\tt.Run(\"server\", func(t *testing.T) {\n260|\t\tf := newFixture(t)\n261|\t\tclientConn, serverConn := net.Pipe()\n262|\t\tdefer clientConn.Close()\n263|\t\tdefer serverConn.Close()\n264|\t\tserved := serveAsync(serverConn, f.serverConfig(echoHandler(json.RawMessage(`{}`))))\n265|\t\trogue := tls.Client(clientConn, rogueClientConfig(t, f, f.certA, \"\", func(config *tls.Config) {\n266|\t\t\tconfig.NextProtos = []string{\"rogue-alpn\"}\n267|\t\t}))\n268|\t\tif err := rogue.Handshake(); err == nil {\n269|\t\t\tt.Fatal(\"wrong-ALPN handshake succeeded\")\n270|\t\t}\n271|\t\tif err := awaitErr(t, served); !errors.Is(err, hostchannel.ErrAuthenticationFailed) {\n272|\t\t\tt.Fatalf(\"Serve = %v\", err)\n273|\t\t}\n274|\t})\n275|\tt.Run(\"client\", func(t *testing.T) {\n276|\t\tf := newFixture(t)\n277|\t\tclientConn, serverConn := net.Pipe()\n278|\t\tdefer clientConn.Close()\n279|\t\tdefer serverConn.Close()\n280|\t\trogue := tls.Server(serverConn, rogueServerConfig(t, f, f.certB, func(config *tls.Config) {\n281|\t\t\tconfig.NextProtos = []string{\"rogue-alpn\"}\n282|\t\t}))\n283|\t\trogueErr := make(chan error, 1)\n284|\t\tgo func() { rogueErr <- rogue.Handshake() }()\n285|\t\tif _, err := hostchannel.Dial(clientConn, f.clientConfig()); !errors.Is(err, hostchannel.ErrAuthenticationFailed) {\n286|\t\t\tt.Fatalf(\"Dial = %v\", err)\n287|\t\t}\n288|\t\t<-rogueErr\n289|\t})\n290|}\n291|\n292|func TestRefusesMissingALPN(t *testing.T) {\n293|\tf := newFixture(t)\n294|\tclientConn, serverConn := net.Pipe()\n295|\tdefer clientConn.Close()\n296|\tdefer serverConn.Close()\n297|\tserved := serveAsync(serverConn, f.serverConfig(echoHandler(json.RawMessage(`{}`))))\n298|\trogue := tls.Client(clientConn, rogueClientConfig(t, f, f.certA, \"\", func(config *tls.Config) {\n299|\t\tconfig.NextProtos = nil\n300|\t}))\n301|\t_ = rogue.Handshake()\n302|\texpectRogueHandshakeFails(t, rogue)\n303|\tif err := awaitErr(t, served); !errors.Is(err, hostchannel.ErrAuthenticationFailed) {\n304|\t\tt.Fatalf(\"Serve = %v\", err)\n305|\t}\n306|}\n307|\n308|func TestRefusesResumption(t *testing.T) {\n309|\tf := newFixture(t)\n310|\tcache := tls.NewLRUClientSessionCache(16)\n311|\tfor round := 0; round < 2; round++ {\n312|\t\tclientConn, serverConn := net.Pipe()\n313|\t\tserved := serveAsync(serverConn, f.serverConfig(echoHandler(json.RawMessage(`{}`))))\n314|\t\trogue := tls.Client(clientConn, rogueClientConfig(t, f, f.certA, \"\", func(config *tls.Config) {\n315|\t\t\tconfig.ClientSessionCache = cache\n316|\t\t}))\n317|\t\tif err := rogue.Handshake(); err != nil {\n318|\t\t\tclientConn.Close()\n319|\t\t\tserverConn.Close()\n320|\t\t\tt.Fatalf(\"round %d handshake: %v\", round, err)\n321|\t\t}\n322|\t\tif rogue.ConnectionState().DidResume {\n323|\t\t\tclientConn.Close()\n324|\t\t\tserverConn.Close()\n325|\t\t\tt.Fatalf(\"round %d resumed\", round)\n326|\t\t}\n327|\t\trequest, line, _ := rogueHello(t, hostA, nil)\n328|\t\twriteRaw(t, rogue, line)\n329|\t\thelloLine, err := hostchannel.ReadLine(rogue)\n330|\t\tif err != nil {\n331|\t\t\tclientConn.Close()\n332|\t\t\tserverConn.Close()\n333|\t\t\tt.Fatalf(\"round %d hello: %v\", round, err)\n334|\t\t}\n335|\t\tif response, err := rpcwire.DecodeResponse(helloLine, request); err != nil || !response.OK() {\n336|\t\t\tclientConn.Close()\n337|\t\t\tserverConn.Close()\n338|\t\t\tt.Fatalf(\"round %d hello response: %+v, %v\", round, response, err)\n339|\t\t}\n340|\t\tclientConn.Close()\n341|\t\tserverConn.Close()\n342|\t\t_ = awaitErr(t, served)\n343|\t}\n344|}\n345|\n346|func TestRefusesPlaintextPreface(t *testing.T) {\n347|\tf := newFixture(t)\n348|\tclientConn, serverConn := net.Pipe()\n349|\tdefer clientConn.Close()\n350|\tdefer serverConn.Close()\n351|\tserved := serveAsync(serverConn, f.serverConfig(echoHandler(json.RawMessage(`{}`))))\n352|\tif _, err := clientConn.Write([]byte(\"GET / HTTP/1.0\\r\\n\\r\\n\")); err != nil {\n353|\t\tt.Fatalf(\"rogue write: %v\", err)\n354|\t}\n355|\t_ = clientConn.SetReadDeadline(time.Now().Add(10 * time.Second))\n356|\tfirst := make([]byte, 1)\n357|\t_, err := clientConn.Read(first)\n358|\tswitch {\n359|\tcase errors.Is(err, io.EOF) || errors.Is(err, io.ErrClosedPipe):\n360|\t\t// Closed without sending: permitted, only JSON is forbidden.\n361|\tcase err != nil:\n362|\t\tt.Fatalf(\"rogue read: %v\", err)\n363|\tcase first[0] == '{':\n364|\t\tt.Fatal(\"JSON sent before TLS completed\")\n365|\tcase first[0] != 0x15:\n366|\t\tt.Fatalf(\"preface reply = %x, want a TLS alert or close\", first)\n367|\t}\n368|\tif err := awaitErr(t, served); !errors.Is(err, hostchannel.ErrAuthenticationFailed) {\n369|\t\tt.Fatalf(\"Serve = %v\", err)\n370|\t}\n371|}\n372|\n373|func TestRefusesUnenrolledRoot(t *testing.T) {\n374|\tf := newFixture(t)\n375|\tattacker, err := hosttrust.IssueCredential(hostC, time.Now().UTC(), nil)\n376|\tif err != nil {\n377|\t\tt.Fatalf(\"IssueCredential: %v\", err)\n378|\t}\n379|\tattackerCert, err := hostchannel.CredentialFromIssued(attacker)\n380|\tif err != nil {\n381|\t\tt.Fatalf(\"CredentialFromIssued: %v\", err)\n382|\t}\n383|\tclientConn, serverConn := net.Pipe()\n384|\tdefer clientConn.Close()\n385|\tdefer serverConn.Close()\n386|\tserved := serveAsync(serverConn, f.serverConfig(echoHandler(json.RawMessage(`{}`))))\n387|\trogue := tls.Client(clientConn, rogueClientConfig(t, f, attackerCert, \"\", nil))\n388|\t_ = rogue.Handshake()\n389|\texpectRogueHandshakeFails(t, rogue)\n390|\tif err := awaitErr(t, served); !errors.Is(err, hostchannel.ErrAuthenticationFailed) {\n391|\t\tt.Fatalf(\"Serve = %v\", err)\n392|\t}\n393|}\n394|\n395|func TestRefusesRevokedLeaf(t *testing.T) {\n396|\tf := newFixture(t)\n397|\tissuedC, err := hosttrust.IssueCredential(hostC, time.Now().UTC(), nil)\n398|\tif err != nil {\n399|\t\tt.Fatalf(\"IssueCredential: %v\", err)\n400|\t}\n401|\tenroll(t, f.storeB, issuedC, hostC, time.Now().UTC())\n402|\tcertC, err := hostchannel.CredentialFromIssued(issuedC)\n403|\tif err != nil {\n404|\t\tt.Fatalf(\"CredentialFromIssued: %v\", err)\n405|\t}\n406|\tif err := f.storeB.Revoke(scalar.SHA256Digest(issuedC.LeafDER).String()); err != nil {\n407|\t\tt.Fatalf(\"Revoke: %v\", err)\n408|\t}\n409|\tclientConn, serverConn := net.Pipe()\n410|\tdefer clientConn.Close()\n411|\tdefer serverConn.Close()\n412|\tserved := serveAsync(serverConn, f.serverConfig(echoHandler(json.RawMessage(`{}`))))\n413|\trogue := tls.Client(clientConn, rogueClientConfig(t, f, certC, \"\", nil))\n414|\t_ = rogue.Handshake()\n415|\texpectRogueHandshakeFails(t, rogue)\n416|\tif err := awaitErr(t, served); !errors.Is(err, hostchannel.ErrAuthenticationFailed) {\n417|\t\tt.Fatalf(\"Serve = %v\", err)\n418|\t}\n419|}\n420|\n421|func TestRefusesRetiredPastRetireAt(t *testing.T) {\n422|\tf := newFixture(t)\n423|\tnow := time.Now().UTC()\n424|\tcredentialID := scalar.SHA256Digest(f.issuedA.LeafDER).String()\n425|\tif err := f.storeB.MarkRetiring(credentialID, now.Add(time.Hour), now); err != nil {\n426|\t\tt.Fatalf(\"MarkRetiring: %v\", err)\n427|\t}\n428|\tserverConfig := f.serverConfig(echoHandler(json.RawMessage(`{}`)))\n429|\tserverConfig.Now = func() time.Time { return now.Add(2 * time.Hour) }\n430|\tclientConn, serverConn := net.Pipe()\n431|\tdefer clientConn.Close()\n432|\tdefer serverConn.Close()\n433|\tserved := serveAsync(serverConn, serverConfig)\n434|\trogue := tls.Client(clientConn, rogueClientConfig(t, f, f.certA, \"\", nil))\n435|\t_ = rogue.Handshake()\n436|\texpectRogueHandshakeFails(t, rogue)\n437|\tif err := awaitErr(t, served); !errors.Is(err, hostchannel.ErrAuthenticationFailed) {\n438|\t\tt.Fatalf(\"Serve = %v\", err)\n439|\t}\n440|}\n441|\n442|func TestRefusesExpiredLeaf(t *testing.T) {\n443|\tf := newFixture(t)\n444|\tissuedAt := time.Now().UTC().Add(-100 * 24 * time.Hour)\n445|\taged, err := hosttrust.IssueCredential(hostC, issuedAt, nil)\n446|\tif err != nil {\n447|\t\tt.Fatalf(\"IssueCredential: %v\", err)\n448|\t}\n449|\tenroll(t, f.storeB, aged, hostC, issuedAt)\n450|\tcertC, err := hostchannel.CredentialFromIssued(aged)\n451|\tif err != nil {\n452|\t\tt.Fatalf(\"CredentialFromIssued: %v\", err)\n453|\t}\n454|\tclientConn, serverConn := net.Pipe()\n455|\tdefer clientConn.Close()\n456|\tdefer serverConn.Close()\n457|\tserved := serveAsync(serverConn, f.serverConfig(echoHandler(json.RawMessage(`{}`))))\n458|\trogue := tls.Client(clientConn, rogueClientConfig(t, f, certC, \"\", nil))\n459|\t_ = rogue.Handshake()\n460|\texpectRogueHandshakeFails(t, rogue)\n461|\tif err := awaitErr(t, served); !errors.Is(err, hostchannel.ErrAuthenticationFailed) {\n462|\t\tt.Fatalf(\"Serve = %v\", err)\n463|\t}\n464|}\n465|\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
