{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000dc75","stream":{"kind":"session","id":"01a0ae5d-13b2-70c2-be9d-d3c6350c7765"},"sequence":3221,"recorded_at":1780531400006437,"record_type":"event","durability":"durable","causation_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","run_stream":{"kind":"run","id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28"},"task_stream":{"kind":"task","id":"01a0ae94-f24b-7843-92c1-accc30bedbb1"},"task_id":"01a0ae94-f24b-7843-92c1-accc30bedbb1","event":{"kind":"output","task_id":"01a0ae94-f24b-7843-92c1-accc30bedbb1","chunk":"Read text file `internal/traceability/traceability.go`.\n(299 line(s) above)\n300|\tif err != nil {\n301|\t\treturn nil, fail(\"read required evidence %q: %v\", filename, err)\n302|\t}\n303|\treturn value, nil\n304|}\n305|\n306|func decodeOwnershipRegistry(candidate []byte) (ownershipRegistry, error) {\n307|\tvar decoded ownershipRegistry\n308|\tdecoder := json.NewDecoder(bytes.NewReader(candidate))\n309|\tdecoder.DisallowUnknownFields()\n310|\tif err := decoder.Decode(&decoded); err != nil {\n311|\t\treturn ownershipRegistry{}, fail(\"decode ownership registry: %v\", err)\n312|\t}\n313|\tvar trailing any\n314|\tif err := decoder.Decode(&trailing); !errors.Is(err, io.EOF) {\n315|\t\tif err == nil {\n316|\t\t\treturn ownershipRegistry{}, fail(\"decode ownership registry: multiple JSON values\")\n317|\t\t}\n318|\t\treturn ownershipRegistry{}, fail(\"decode ownership registry trailing data: %v\", err)\n319|\t}\n320|\treturn decoded, nil\n321|}\n322|\n323|func verifyOwnership(\n324|\trepository fs.FS,\n325|\tdocument *specdoc.Document,\n326|\tregistry ownershipRegistry,\n327|\tmanifest specpin.Manifest,\n328|\tcurrentCatalog catalog.Catalog,\n329|\tcompatibilityCatalog catalog.Catalog,\n330|\tassignedBindings []assignedSectionBinding,\n331|) (Report, error) {\n332|\tif registry.Format != ownershipFormat || registry.FormatVersion != ownershipFormatVersion {\n333|\t\treturn Report{}, fail(\"unsupported ownership registry format %q version %d\", registry.Format, registry.FormatVersion)\n334|\t}\n335|\tsource := registry.Source\n336|\tif source.Repository != manifest.Source.Repository ||\n337|\t\tsource.Release != manifest.Source.Release ||\n338|\t\tsource.Commit != manifest.Source.Commit ||\n339|\t\tsource.DocumentPath != manifest.Source.Document.Path ||\n340|\t\tsource.DocumentSHA256 != manifest.Source.Document.SHA256 {\n341|\t\treturn Report{}, fail(\"ownership registry source differs from verified normative lock\")\n342|\t}\n343|\n344|\texpected := map[ownershipKind]map[string]struct{}{\n345|\t\townershipContract:         expectedContracts(manifest.Contracts),\n346|\t\townershipNormativeSection: expectedNormativeSections(manifest, currentCatalog),\n347|\t\townershipSectionBinding:   expectedSectionBindingInventory(),\n348|\t\townershipFixture:          expectedFixtures(manifest, currentCatalog),\n349|\t}\n350|\trequiredSectionBindings, err := expectedCatalogSectionBindings(currentCatalog)\n351|\tif err != nil {\n352|\t\treturn Report{}, err\n353|\t}\n354|\trequired := map[ownershipKind]map[string]struct{}{\n355|\t\townershipContract:         expected[ownershipContract],\n356|\t\townershipNormativeSection: expected[ownershipNormativeSection],\n357|\t\townershipSectionBinding:   requiredSectionBindings,\n358|\t\townershipFixture:          expected[ownershipFixture],\n359|\t}\n360|\tselectedSectionBindings := map[string]struct{}(nil)\n361|\tif assignedBindings != nil {\n362|\t\trequired = cloneOwnershipSets(expected)\n363|\t\tselectedSectionBindings = make(map[string]struct{})\n364|\t\tfor _, binding := range assignedBindings {\n365|\t\t\tfor _, key := range binding.Keys {\n366|\t\t\t\tselectedSectionBindings[key] = struct{}{}\n367|\t\t\t}\n368|\t\t}\n369|\t\trequired[ownershipSectionBinding] = make(map[string]struct{})\n370|\t}\n371|\tchecker := newSourceChecker(repository)\n372|\tacceptanceIDs, err := verifyAcceptanceCases(checker, registry.AcceptanceCases)\n373|\tif err != nil {\n374|\t\treturn Report{}, err\n375|\t}\n376|\t// Coverage is measured over every registered section binding, not only the\n377|\t// assigned ones, so a sliver planted anywhere in the registry reddens both\n378|\t// production entry points rather than only the repository-wide one. It is\n379|\t// measured before ownership resolution so that a section moved to the\n380|\t// unowned disclosure to dodge the catalog's owner requirement is reported\n381|\t// as that dodge rather than as an ordinary missing owner.\n382|\tcoverage, err := verifySectionCoverage(document, registry.Ownership, acceptanceIDs)\n383|\tif err != nil {\n384|\t\treturn Report{}, err\n385|\t}\n386|\townedSections := make(map[string]struct{}, len(coverage))\n387|\tfor key := range coverage {\n388|\t\townedSections[key] = struct{}{}\n389|\t}\n390|\tunowned, err := verifyUnownedSections(\n391|\t\tregistry.UnownedSections, expected[ownershipSectionBinding], requiredSectionBindings, ownedSections)\n392|\tif err != nil {\n393|\t\treturn Report{}, err\n394|\t}\n395|\n396|\towned, err := verifyOwnershipGroups(checker, registry.Ownership, acceptanceIDs, expected, required, selectedSectionBindings)\n397|\tif err != nil {\n398|\t\treturn Report{}, err\n399|\t}\n400|\n401|\tfor _, binding := range assignedBindings {\n402|\t\tfor _, key := range binding.Keys {\n403|\t\t\tif entry, disclosed := unowned[key]; disclosed {\n404|\t\t\t\treturn Report{}, fail(\n405|\t\t\t\t\t\"assigned section %q binding %q is recorded unowned: %s\", binding.Scope, key, entry.Gap)\n406|\t\t\t}\n407|\t\t\tif _, ok := owned[ownershipSectionBinding][key]; !ok {\n408|\t\t\t\treturn Report{}, fail(\"assigned section %q binding %q has no scoped implementation owner\", binding.Scope, key)\n409|\t\t\t}\n410|\t\t\t// Admission requires full and nothing else. coverageUnmeasured is\n411|\t\t\t// deliberately not admitted: the gate cannot see the section's\n412|\t\t\t// obligations, and admitting on an unverifiable justification\n413|\t\t\t// sentence would be self-minted evidence for exactly the class this\n414|\t\t\t// gate exists to refuse. Absence of a scanner-visible clause is a\n415|\t\t\t// failure to measure, not a measured absence of obligation.\n416|\t\t\tmeasured := coverage[key]\n417|\t\t\tif measured.Level != coverageFull {\n418|\t\t\t\treturn Report{}, fail(\n419|\t\t\t\t\t\"assigned section %q binding %q discharges %s normative clauses, which is %s coverage; assigned-scope admission requires full: %s\",\n420|\t\t\t\t\tbinding.Scope, key, measured.Ratio(), measured.Level, measured.Gap)\n421|\t\t\t}\n422|\t\t}\n423|\t}\n424|\tfor _, contract := range compatibilityCatalog.Contracts {\n425|\t\tkey := contractKey(contract.Name, string(contract.ID))\n426|\t\tif _, ok := owned[ownershipContract][key]; !ok {\n427|\t\t\treturn Report{}, fail(\"compatibility contract %q has no implementation owner\", key)\n428|\t\t}\n429|\t}\n430|\n431|\tcanonical, err := json.Marshal(registry)\n432|\tif err != nil {\n433|\t\treturn Report{}, fail(\"encode canonical ownership registry: %v\", err)\n434|\t}\n435|\tdigest := sha256.Sum256(canonical)\n436|\tgotDigest := hex.EncodeToString(digest[:])\n437|\tif gotDigest != reviewedOwnershipCanonicalSHA256 {\n438|\t\treturn Report{}, fail(\"ownership registry projection digest %s differs from reviewed %s\", gotDigest, reviewedOwnershipCanonicalSHA256)\n439|\t}\n440|\n441|\treport := Report{\n442|\t\tContracts:              len(expected[ownershipContract]),\n443|\t\tNormativeSections:      len(expected[ownershipNormativeSection]),\n444|\t\tAcceptanceCases:        len(acceptanceIDs),\n445|\t\tFixtures:               len(expected[ownershipFixture]),\n446|\t\tCompatibilityContracts: len(compatibilityCatalog.Contracts),\n447|\t\tAssignedScopes:         len(assignedBindings),\n448|\t\tSectionBindings:        len(coverage),\n449|\t\tUnownedSections:        len(unowned),\n450|\t}\n451|\tfor _, measured := range coverage {\n452|\t\treport.NormativeClauses += measured.Total\n453|\t\treport.DischargedClauses += measured.Discharged\n454|\t\tswitch measured.Level {\n455|\t\tcase coverageFull:\n456|\t\t\treport.FullCoverage++\n457|\t\tcase coveragePartial:\n458|\t\t\treport.PartialCoverage++\n459|\t\tcase coverageSliver:\n460|\t\t\treport.SliverCoverage++\n461|\t\tcase coverageUnevidenced:\n462|\t\t\treport.UnevidencedCoverage++\n463|\t\tcase coverageUnmeasured:\n464|\t\t\treport.UnmeasuredCoverage++\n465|\t\t}\n466|\t}\n467|\treturn report, nil\n468|}\n469|\n470|// verifySectionCoverage measures every registered section binding against the\n471|// pinned document and refuses a coverage claim on any other ownership kind. A\n472|// contract or fixture owner has no section to be measured against, so a\n473|// coverage field there would be a claim the gate cannot check.\n474|func verifySectionCoverage(\n475|\tdocument *specdoc.Document,\n476|\tgroups []ownershipGroup,\n477|\tacceptanceIDs map[string]struct{},\n478|) (map[string]sectionCoverage, error) {\n479|\tresult := make(map[string]sectionCoverage)\n(more lines below)","final_result":true}}}
