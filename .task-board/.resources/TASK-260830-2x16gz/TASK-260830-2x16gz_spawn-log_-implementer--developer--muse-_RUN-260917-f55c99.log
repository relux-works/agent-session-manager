{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d2db","stream":{"kind":"session","id":"01a0ae5d-13b2-70c2-be9d-d3c6350c7765"},"sequence":1992,"recorded_at":1780531400003979,"record_type":"event","durability":"durable","causation_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","run_stream":{"kind":"run","id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28"},"task_stream":{"kind":"task","id":"01a0ae79-9e04-7811-a996-d297cce79b09"},"task_id":"01a0ae79-9e04-7811-a996-d297cce79b09","event":{"kind":"output","task_id":"01a0ae79-9e04-7811-a996-d297cce79b09","chunk":"edited\nchanged lines: lines 1332-1348\n--- original\n+++ updated\n@@\n-\t\twriteRaw(t, rogue, reply)\n-\t\tselect {\n-\t\tcase err := <-dialed:\n-\t\t\tif !errors.Is(err, hostchannel.ErrProtocol) {\n-\t\t\t\tt.Fatalf(\"Dial = %v\", err)\n-\t\t\t}\n-\t\t\tassertLocalFailure(t, err, \"incompatible_protocol\", 6)\n-\t\tcase <-time.After(30 * time.Second):\n-\t\t\tt.Fatal(\"Dial did not return\")\n-\t\t}\n-\t\tcensus.assertUnchanged(t, f)\n-\t})\n-}\n-\n-// ---------------------------------------------------------------------------\n-// AC-HOST-001 rows: timeout/race, custody, revocation/generation, role swap.\n-// ---------------------------------------------------------------------------\n+\t\twriteRaw(t, rogue, reply)\n+\t\tselect {\n+\t\tcase err := <-dialed:\n+\t\t\tif !errors.Is(err, hostchannel.ErrProtocol) {\n+\t\t\t\tt.Fatalf(\"Dial = %v\", err)\n+\t\t\t}\n+\t\t\tif errors.Is(err, hosttrust.ErrNotAllowlisted) {\n+\t\t\t\tt.Fatalf(\"Dial honored the drifted code: %v\", err)\n+\t\t\t}\n+\t\t\tassertLocalFailure(t, err, \"incompatible_protocol\", 6)\n+\t\tcase <-time.After(30 * time.Second):\n+\t\t\tt.Fatal(\"Dial did not return\")\n+\t\t}\n+\t\tcensus.assertUnchanged(t, f)\n+\t})\n+}\n","final_result":true}}}
