8|\tresult := make(map[string]struct{})\n719|\tfor _, identifier := range specpin.SectionInventoryV060() {\n720|\t\tresult[sectionBindingKey(identifier)] = struct{}{}\n721|\t}\n722|\treturn result\n723|}\n724|\n725|func expectedCatalogSectionBindings(value catalog.Catalog) (map[string]struct{}, error) {\n726|\tresult := make(map[string]struct{})\n727|\taddDefinition := func(normativeSection string, fixtures []string) error {\n728|\t\tfor _, expression := range strings.Split(normativeSection, \",\") {\n729|\t\t\texpression = strings.TrimSpace(expression)\n730|\t\t\tparts := strings.Split(expression, \"-\")\n731|\t\t\tif len(parts) > 2 || len(parts) == 0 {\n732|\t\t\t\treturn fail(\"catalog normative section %q is not an exact section or range\", normativeSection)\n733|\t\t\t}\n734|\t\t\tstart := canonicalNumericSection(strings.TrimSpace(parts[0]))\n735|\t\t\tend := start\n736|\t\t\tif len(parts) == 2 {\n737|\t\t\t\tend = canonicalNumericSection(strings.TrimSpace(parts[1]))\n738|\t\t\t}\n739|\t\t\tidentifiers, err := expandV060SectionRange(start, end)\n740|\t\t\tif err != nil {\n741|\t\t\t\treturn fail(\"catalog normative section %q: %v\", normativeSection, err)\n742|\t\t\t}\n743|\t\t\tfor _, identifier := range identifiers {\n744|\t\t\t\tresult[sectionBindingKey(identifier)] = struct{}{}\n745|\t\t\t}\n746|\t\t}\n747|\t\tfor _, fixture := range fixtures {\n748|\t\t\tmatch := catalogAppendixPattern.FindStringSubmatch(fixture)\n749|\t\t\tif match != nil {\n750|\t\t\t\tresult[sectionBindingKey(\"appendix-\"+strings.ToLower(match[1]))] = struct{}{}\n751|\t\t\t}\n752|\t\t}\n753|\t\treturn nil\n754|\t}\n755|\tfor _, operation := range value.Operations {\n756|\t\tif err := addDefinition(operation.NormativeSection, operation.FixtureFamilies); err != nil {\n757|\t\t\treturn nil, err\n758|\t\t}\n759|\t}\n760|\tfor _, capability := range value.Capabilities {\n761|\t\tif err := addDefinition(capability.NormativeSection, capability.FixtureFamilies); err != nil {\n762|\t\t\treturn nil, err\n763|\t\t}\n764|\t}\n765|\tfor _, event := range value.Events {\n766|\t\tif err := addDefinition(event.NormativeSection, event.FixtureFamilies); err != nil {\n767|\t\t\treturn nil, err\n768|\t\t}\n769|\t}\n770|\tfor _, item := range value.Errors {\n771|\t\tif err := addDefinition(item.NormativeSection, item.FixtureFamilies); err != nil {\n772|\t\t\treturn nil, err\n773|\t\t}\n774|\t}\n775|\treturn result, nil\n776|}\n777|\n778|func canonicalNumericSection(identifier string) string {\n779|\tparts := strings.Split(identifier, \".\")\n780|\tfor index := 1; index < len(parts); index++ {\n781|\t\tif len(parts[index]) != 1 {\n782|\t\t\tcontinue\n783|\t\t}\n784|\t\tcharacter := parts[index][0]\n785|\t\tif (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z') {\n786|\t\t\tparts[index] = strings.ToUpper(parts[index])\n787|\t\t}\n788|\t}\n789|\treturn strings.Join(parts, \".\")\n790|}\n791|\n792|func cloneOwnershipSets(source map[ownershipKind]map[string]struct{}) map[ownershipKind]map[string]struct{} {\n793|\tresult := make(map[ownershipKind]map[string]struct{}, len(source))\n794|\tfor kind, values := range source {\n795|\t\tcloned := make(map[string]struct{}, len(values))\n796|\t\tfor value := range values {\n797|\t\t\tcloned[value] = struct{}{}\n798|\t\t}\n799|\t\tresult[kind] = cloned\n800|\t}\n801|\treturn result\n802|}\n803|\n804|func verifyCatalogContracts(want []specpin.ContractPin, got []catalog.Contract) error {\n805|\tif len(got) != len(want) {\n806|\t\treturn fail(\"current catalog has %d contracts, verified source has %d\", len(got), len(want))\n807|\t}\n808|\tfor index := range want {\n809|\t\tif got[index].Name != want[index].Name || string(got[index].ID) != want[index].ID ||\n810|\t\t\t!equalStrings(got[index].Versions, want[index].Versions) {\n811|\t\t\treturn fail(\"current catalog contract row %d differs from verified source\", index)\n812|\t\t}\n813|\t}\n814|\treturn nil\n815|}\n816|\n817|func expectedContracts(contracts []specpin.ContractPin) map[string]struct{} {\n818|\tresult := make(map[string]struct{}, len(contracts))\n819|\tfor _, contract := range contracts {\n820|\t\tresult[contractKey(contract.Name, contract.ID)] = struct{}{}\n821|\t}\n822|\treturn result\n823|}\n824|\n825|func contractKey(name, id string) string {\n826|\treturn name + \" [\" + id + \"]\"\n827|}\n828|\n829|func expectedNormativeSections(manifest specpin.Manifest, value catalog.Catalog) map[string]struct{} {\n830|\tresult := make(map[string]struct{})\n831|\tfor _, section := range manifest.Source.NormativeScope {\n832|\t\tresult[\"source:\"+section] = struct{}{}\n833|\t}\n834|\tfor _, operation := range value.Operations {\n835|\t\tresult[\"catalog:\"+operation.NormativeSection] = struct{}{}\n836|\t}\n837|\tfor _, capability := range value.Capabilities {\n838|\t\tresult[\"catalog:\"+capability.NormativeSection] = struct{}{}\n839|\t}\n840|\tfor _, event := range value.Events {\n841|\t\tresult[\"catalog:\"+event.NormativeSection] = struct{}{}\n842|\t}\n843|\tfor _, item := range value.Errors {\n844|\t\tresult[\"catalog:\"+item.NormativeSection] = struct{}{}\n845|\t}\n846|\treturn result\n847|}\n848|\n849|func expectedFixtures(manifest specpin.Manifest, value catalog.Catalog) map[string]struct{} {\n850|\tresult := make(map[string]struct{})\n851|\tfor _, fixture := range manifest.Fixtures {\n852|\t\tresult[\"pin:\"+fixture.ID] = struct{}{}\n853|\t}\n854|\tadd := func(fixtures []string) {\n855|\t\tfor _, fixture := range fixtures {\n856|\t\t\tresult[\"catalog:\"+fixture] = struct{}{}\n857|\t\t}\n858|\t}\n859|\tfor _, operation := range value.Operations {\n860|\t\tadd(operation.FixtureFamilies)\n861|\t}\n862|\tfor _, capability := range value.Capabilities {\n863|\t\tadd(capability.FixtureFamilies)\n864|\t}\n865|\tfor _, event := range value.Events {\n866|\t\tadd(event.FixtureFamilies)\n867|\t}\n868|\tfor _, item := range value.Errors {\n869|\t\tadd(item.FixtureFamilies)\n870|\t}\n871|\treturn result\n872|}\n873|\n874|type sourceChecker struct {\n875|\trepository fs.FS\n876|\tfiles      map[string]*ast.File\n877|}\n878|\n879|func newSourceChecker(repository fs.FS) *sourceChecker {\n880|\treturn &sourceChecker{repository: repository, files: make(map[string]*ast.File)}\n881|}\n882|\n883|func (checker *sourceChecker) verify(reference codeReference, test bool) error {\n884|\tif reference.Path == \"\" || reference.Declaration == \"\" {\n885|\t\treturn errors.New(\"code reference has an empty path or declaration\")\n886|\t}\n887|\tclean := path.Clean(reference.Path)\n888|\tif clean != reference.Path || clean == \".\" || path.IsAbs(clean) || strings.HasPrefix(clean, \"../\") {\n889|\t\treturn fmt.Errorf(\"unsafe code reference path %q\", reference.Path)\n890|\t}\n891|\tif path.Ext(clean) != \".go\" {\n892|\t\treturn fmt.Errorf(\"code reference %q is not a Go source file\", clean)\n893|\t}\n894|\tif test {\n895|\t\tif !strings.HasSuffix(clean, \"_test.go\") || !isExecutableTestName(reference.Declaration) {\n896|\t\t\treturn fmt.Errorf(\"test owner %s:%s is not an executable Go test reference\", clean, reference.Declaration)\n897|\t\t}\n898|\t} else if strings.HasSuffix(clean, \"_test.go\") {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
