ptance case registry is empty\")\n507|\t}\n508|\tseen := make(map[string]struct{}, len(cases))\n509|\tfor index, acceptance := range cases {\n510|\t\tif acceptance.ID == \"\" {\n511|\t\t\treturn nil, fail(\"acceptance case %d has an empty id\", index)\n512|\t\t}\n513|\t\tif _, duplicate := seen[acceptance.ID]; duplicate {\n514|\t\t\treturn nil, fail(\"duplicate acceptance case %q\", acceptance.ID)\n515|\t\t}\n516|\t\tseen[acceptance.ID] = struct{}{}\n517|\t\tif err := checker.verify(acceptance.Production, false); err != nil {\n518|\t\t\treturn nil, fail(\"acceptance case %q production owner: %v\", acceptance.ID, err)\n519|\t\t}\n520|\t\tif len(acceptance.Tests) == 0 {\n521|\t\t\treturn nil, fail(\"acceptance case %q has no executable test owner\", acceptance.ID)\n522|\t\t}\n523|\t\ttestSeen := make(map[codeReference]struct{}, len(acceptance.Tests))\n524|\t\tfor _, test := range acceptance.Tests {\n525|\t\t\tif _, duplicate := testSeen[test]; duplicate {\n526|\t\t\t\treturn nil, fail(\"acceptance case %q repeats test owner %s:%s\", acceptance.ID, test.Path, test.Declaration)\n527|\t\t\t}\n528|\t\t\ttestSeen[test] = struct{}{}\n529|\t\t\tif err := checker.verify(test, true); err != nil {\n530|\t\t\t\treturn nil, fail(\"acceptance case %q test owner: %v\", acceptance.ID, err)\n531|\t\t\t}\n532|\t\t}\n533|\t}\n534|\treturn seen, nil\n535|}\n536|\n537|func verifyOwnershipGroups(\n538|\tchecker *sourceChecker,\n539|\tgroups []ownershipGroup,\n540|\tacceptanceIDs map[string]struct{},\n541|\tallowed map[ownershipKind]map[string]struct{},\n542|\trequired map[ownershipKind]map[string]struct{},\n543|\tselectedSectionBindings map[string]struct{},\n544|) (map[ownershipKind]map[string]struct{}, error) {\n545|\towned := map[ownershipKind]map[string]struct{}{\n546|\t\townershipContract:         make(map[string]struct{}),\n547|\t\townershipNormativeSection: make(map[string]struct{}),\n548|\t\townershipSectionBinding:   make(map[string]struct{}),\n549|\t\townershipFixture:          make(map[string]struct{}),\n550|\t}\n551|\tif len(groups) == 0 {\n552|\t\treturn nil, fail(\"implementation ownership registry is empty\")\n553|\t}\n554|\tfor index, group := range groups {\n555|\t\tif _, ok := allowed[group.Kind]; !ok {\n556|\t\t\treturn nil, fail(\"ownership group %d has unknown kind %q\", index, group.Kind)\n557|\t\t}\n558|\t\tif group.Kind == ownershipSectionBinding && selectedSectionBindings != nil {\n559|\t\t\tselected := false\n560|\t\t\tfor _, key := range group.Keys {\n561|\t\t\t\tif _, ok := selectedSectionBindings[key]; ok {\n562|\t\t\t\t\tselected = true\n563|\t\t\t\t\tbreak\n564|\t\t\t\t}\n565|\t\t\t}\n566|\t\t\tif !selected {\n567|\t\t\t\tcontinue\n568|\t\t\t}\n569|\t\t}\n570|\t\tif group.Kind == ownershipSectionBinding && len(group.Keys) != 1 {\n571|\t\t\treturn nil, fail(\"section binding ownership group %d has %d keys, want exactly one\", index, len(group.Keys))\n572|\t\t}\n573|\t\tif len(group.Keys) == 0 {\n574|\t\t\treturn nil, fail(\"ownership group %d (%s) has no registered keys\", index, group.Kind)\n575|\t\t}\n576|\t\tif err := checker.verify(group.Production, false); err != nil {\n577|\t\t\tif group.Kind == ownershipSectionBinding {\n578|\t\t\t\treturn nil, fail(\"section binding %q production owner: %v\", group.Keys[0], err)\n579|\t\t\t}\n580|\t\t\treturn nil, fail(\"ownership group %d (%s) production owner: %v\", index, group.Kind, err)\n581|\t\t}\n582|\t\tif len(group.AcceptanceCases) == 0 {\n583|\t\t\tif group.Kind == ownershipSectionBinding {\n584|\t\t\t\treturn nil, fail(\"section binding %q has no scope-specific acceptance owner\", group.Keys[0])\n585|\t\t\t}\n586|\t\t\treturn nil, fail(\"ownership group %d (%s) has no acceptance owner\", index, group.Kind)\n587|\t\t}\n588|\t\tcaseSeen := make(map[string]struct{}, len(group.AcceptanceCases))\n589|\t\tfor _, acceptanceID := range group.AcceptanceCases {\n590|\t\t\tif _, duplicate := caseSeen[acceptanceID]; duplicate {\n591|\t\t\t\treturn nil, fail(\"ownership group %d (%s) repeats acceptance case %q\", index, group.Kind, acceptanceID)\n592|\t\t\t}\n593|\t\t\tcaseSeen[acceptanceID] = struct{}{}\n594|\t\t\tif _, ok := acceptanceIDs[acceptanceID]; !ok {\n595|\t\t\t\tif group.Kind == ownershipSectionBinding {\n596|\t\t\t\t\treturn nil, fail(\"section binding %q references unregistered acceptance case %q\", group.Keys[0], acceptanceID)\n597|\t\t\t\t}\n598|\t\t\t\treturn nil, fail(\"ownership group %d (%s) references unregistered acceptance case %q\", index, group.Kind, acceptanceID)\n599|\t\t\t}\n600|\t\t}\n601|\t\tfor _, key := range group.Keys {\n602|\t\t\tif key == \"\" {\n603|\t\t\t\treturn nil, fail(\"ownership group %d (%s) has an empty key\", index, group.Kind)\n604|\t\t\t}\n605|\t\t\tif _, duplicate := owned[group.Kind][key]; duplicate {\n606|\t\t\t\treturn nil, fail(\"duplicate %s implementation owner for %q\", group.Kind, key)\n607|\t\t\t}\n608|\t\t\towned[group.Kind][key] = struct{}{}\n609|\t\t}\n610|\t}\n611|\tfor kind, wanted := range required {\n612|\t\tfor key := range wanted {\n613|\t\t\tif _, ok := owned[kind][key]; !ok {\n614|\t\t\t\treturn nil, fail(\"registered %s %q has no implementation owner\", kind, key)\n615|\t\t\t}\n616|\t\t}\n617|\t}\n618|\tfor kind, registered := range owned {\n619|\t\tfor key := range registered {\n620|\t\t\tif _, ok := allowed[kind][key]; !ok {\n621|\t\t\t\treturn nil, fail(\"implementation owner is self-minted for unknown %s %q\", kind, key)\n622|\t\t\t}\n623|\t\t}\n624|\t}\n625|\treturn owned, nil\n626|}\n627|\n628|func resolveAssignedSections(pinned []string, assigned []string) ([]assignedSectionBinding, error) {\n629|\tif assigned == nil {\n630|\t\treturn nil, nil\n631|\t}\n632|\tpinnedSet := make(map[string]struct{}, len(pinned))\n633|\tfor _, section := range pinned {\n634|\t\tpinnedSet[section] = struct{}{}\n635|\t}\n636|\tbindings := make([]assignedSectionBinding, 0, len(assigned))\n637|\tseen := make(map[string]struct{}, len(assigned))\n638|\tfor _, raw := range assigned {\n639|\t\