\t\t\treturn true\n1255|\t\t}\n1256|\t}\n1257|\treturn false\n1258|}\n1259|\n1260|// verifyUnownedSections checks the disclosed unimplemented sections. An entry\n1261|// must name a real section, must not also be owned, must not cover a section\n1262|// the generated catalog requires an owner for, and must state a gap and the\n1263|// evidence for it.\n1264|func verifyUnownedSections(\n1265|\tentries []unownedSection,\n1266|\tallowed map[string]struct{},\n1267|\trequiredByCatalog map[string]struct{},\n1268|\towned map[string]struct{},\n1269|) (map[string]unownedSection, error) {\n1270|\tresult := make(map[string]unownedSection, len(entries))\n1271|\tfor index, entry := range entries {\n1272|\t\tif entry.Key == \"\" {\n1273|\t\t\treturn nil, fail(\"unowned section %d has an empty key\", index)\n1274|\t\t}\n1275|\t\tif _, duplicate := result[entry.Key]; duplicate {\n1276|\t\t\treturn nil, fail(\"duplicate unowned section %q\", entry.Key)\n1277|\t\t}\n1278|\t\tif _, known := allowed[entry.Key]; !known {\n1279|\t\t\treturn nil, fail(\"unowned section %q is self-minted for an unknown section\", entry.Key)\n1280|\t\t}\n1281|\t\tif _, required := requiredByCatalog[entry.Key]; required {\n1282|\t\t\treturn nil, fail(\n1283|\t\t\t\t\"unowned section %q is required to have an implementation owner by the generated catalog\", entry.Key)\n1284|\t\t}\n1285|\t\tif _, conflict := owned[entry.Key]; conflict {\n1286|\t\t\treturn nil, fail(\"section %q is registered as both owned and unowned\", entry.Key)\n1287|\t\t}\n1288|\t\tdisplay, err := sectionDisplayName(entry.Key)\n1289|\t\tif err != nil {\n1290|\t\t\treturn nil, fail(\"unowned section %q: %v\", entry.Key, err)\n1291|\t\t}\n1292|\t\t// An unowned section has no production declaration by construction, so\n1293|\t\t// the gap is checked for length and a whole-identifier section mention\n1294|\t\t// only, and the separate evidence field carries the rest.\n1295|\t\tif err := verifyGapDiscloses(entry.Gap, display, \"\"); err != nil {\n1296|\t\t\treturn nil, fail(\"unowned section %q does not name what %s leaves unimplemented: %v\", entry.Key, display, err)\n1297|\t\t}\n1298|\t\tif len(entry.Evidence) < minimumGapLength {\n1299|\t\t\treturn nil, fail(\"unowned section %q states no evidence for its gap\", entry.Key)\n1300|\t\t}\n1301|\t\tresult[entry.Key] = entry\n1302|\t}\n1303|\treturn result, nil\n1304|}","final_result":true}}}
