 func() {\n838|\t\t\tclientConfig := f.clientConfig()\n839|\t\t\tclientConfig.HelloTimeout = 200 * time.Millisecond\n840|\t\t\tclient, err := hostchannel.Dial(clientConn, clientConfig)\n841|\t\t\tif err == nil {\n842|\t\t\t\t_ = client.Close()\n843|\t\t\t}\n844|\t\t\tdialed <- err\n845|\t\t}()\n846|\t\tif err := rogue.Handshake(); err != nil {\n847|\t\t\tt.Fatalf(\"handshake: %v\", err)\n848|\t\t}\n849|\t\t// The silent server still drains the hello; it just never answers.\n850|\t\tif _, err := hostchannel.ReadLine(rogue); err != nil {\n851|\t\t\tt.Fatalf(\"ReadLine(hello): %v\", err)\n852|\t\t}\n853|\t\tselect {\n854|\t\tcase err := <-dialed:\n855|\t\t\tif !errors.Is(err, hostchannel.ErrTransportFailure) {\n856|\t\t\t\tt.Fatalf(\"Dial = %v\", err)\n857|\t\t\t}\n858|\t\t\tif !strings.Contains(err.Error(), \"deadline\") {\n859|\t\t\t\tt.Fatalf(\"Dial = %v, want the deadline refusal\", err)\n860|\t\t\t}\n861|\t\tcase <-time.After(30 * time.Second):\n862|\t\t\tt.Fatal(\"Dial did not return\")\n863|\t\t}\n864|\t})\n865|}\n866|\n867|func TestOversizeHelloLine(t *testing.T) {\n868|\tf := newFixture(t)\n869|\tclientConn, serverConn := net.Pipe()\n870|\tdefer clientConn.Close()\n871|\tdefer serverConn.Close()\n872|\tserved := serveAsync(serverConn, f.serverConfig(echoHandler(json.RawMessage(`{}`))))\n873|\trogue := tls.Client(clientConn, rogueClientConfig(t, f, f.certA, \"\", nil))\n874|\tif err := rogue.Handshake(); err != nil {\n875|\t\tt.Fatalf(\"handshake: %v\", err)\n876|\t}\n877|\tjunk := bytes.Repeat([]byte(\"B\"), rpcwire.MaxLineBytes+10)\n878|\twrote := make(chan error, 1)\n879|\tgo func() {\n880|\t\t_, err := rogue.Write(append(junk, '\\n'))\n881|\t\twrote <- err\n882|\t}()\n883|\texpectClose(t, rogue)\n884|\tif err := awaitErr(t, served); !errors.Is(err, hostchannel.ErrUnframeableInput) {\n885|\t\tt.Fatalf(\"Serve = %v\", err)\n886|\t}\n887|\t<-wrote\n888|}\n889|\n890|func TestStaleGenerationAtDispatch(t *testing.T) {\n891|\tt.Run(\"server closes\", func(t *testing.T) {\n892|\t\tf := newFixture(t)\n893|\t\tclientConn, serverConn := net.Pipe()\n894|\t\tdefer clientConn.Close()\n895|\t\tdefer serverConn.Close()\n896|\t\tserved := serveAsync(serverConn, f.serverConfig(echoHandler(json.RawMessage(`{}`))))\n897|\t\tclient, err := hostchannel.Dial(clientConn, f.clientConfig())\n898|\t\tif err != nil {\n899|\t\t\tt.Fatalf(\"Dial: %v\", err)\n900|\t\t}\n901|\t\tdefer client.Close()\n902|\t\tissuedC, err := hosttrust.IssueCredential(hostC, time.Now().UTC(), nil)\n903|\t\tif err != nil {\n904|\t\t\tt.Fatalf(\"IssueCredential: %v\", err)\n905|\t\t}\n906|\t\tenroll(t, f.storeB, issuedC, hostC, time.Now().UTC())\n907|\t\tif _, err := client.Call(\"health.get\", json.RawMessage(`{}`)); !errors.Is(err, hostchannel.ErrTransportFailure) {\n908|\t\t\tt.Fatalf(\"Call = %v\", err)\n909|\t\t}\n910|\t\tif err := awaitErr(t, served); !errors.Is(err, hosttrust.ErrStaleGeneration) {\n911|\t\t\tt.Fatalf(\"Serve = %v\", err)\n912|\t\t} else if !strings.Contains(err.Error(), \"moved\") {\n913|\t\t\tt.Fatalf(\"Serve = %v, want the channel currency gate\", err)\n914|\t\t}\n915|\t})\n916|\tt.Run(\"client refuses to send\", func(t *testing.T) {\n917|\t\tf := newFixture(t)\n918|\t\tvar calls int\n919|\t\thandler := func(_ context.Context, _ rpcwire.Request, _ hostchannel.Binding, _ func(func() error) error) (json.RawMessage, error) {\n920|\t\t\tcalls++\n921|\t\t\treturn json.RawMessage(`{}`), nil\n922|\t\t}\n923|\t\tclientConn, serverConn := net.Pipe()\n924|\t\tdefer clientConn.Close()\n925|\t\tdefer serverConn.Close()\n926|\t\tserved := serveAsync(serverConn, f.serverConfig(handler))\n927|\t\tclient, err := hostchannel.Dial(clientConn, f.clientConfig())\n928|\t\tif err != nil {\n929|\t\t\tt.Fatalf(\"Dial: %v\", err)\n930|\t\t}\n931|\t\tdefer client.Close()\n932|\t\tif response, err := client.Call(\"health.get\", json.RawMessage(`{}`)); err != nil || !response.OK() {\n933|\t\t\tt.Fatalf(\"Call = %+v, %v\", response, err)\n934|\t\t}\n935|\t\tissuedC, err := hosttrust.IssueCredential(hostC, time.Now().UTC(), nil)\n936|\t\tif err != nil {\n937|\t\t\tt.Fatalf(\"IssueCredential: %v\", err)\n938|\t\t}\n939|\t\tenroll(t, f.storeA, issuedC, hostC, time.Now().UTC())\n940|\t\tif _, err := client.Call(\"health.get\", json.RawMessage(`{}`)); !errors.Is(err, hosttrust.ErrStaleGeneration) {\n941|\t\t\tt.Fatalf(\"second Call = %v\", err)\n942|\t\t}\n943|\t\tif calls != 1 {\n944|\t\t\tt.Fatalf(\"handler calls = %d, stale Call transmitted\", calls)\n945|\t\t}\n946|\t\tif err := client.Close(); err != nil {\n947|\t\t\tt.Fatalf(\"Close: %v\", err)\n948|\t\t}\n949|\t\t_ = awaitErr(t, served)\n950|\t})\n951|}\n952|\n953|func TestStaleGenerationAtMutation(t *testing.T) {\n954|\tf := newFixture(t)\n955|\tadmitted := make(chan struct{})\n956|\tcommitted := make(chan struct{})\n957|\tvar ran int\n958|\thandler := func(_ context.Context, _ rpcwire.Request, _ hostchannel.Binding, mutate func(func() error) error) (json.RawMessage, error) {\n959|\t\tclose(admitted)\n960|\t\t<-committed\n961|\t\tif err := mutate(func() error { ran++; return nil }); err != nil {\n962|\t\t\treturn nil, err\n963|\t\t}\n964|\t\treturn json.RawMessage(`{}`), nil\n965|\t}\n966|\tclientConn, serverConn := net.Pipe()\n967|\tdefer clientConn.Close()\n968|\tdefer serverConn.Close()\n969|\tserved := serveAsync(serverConn, f.serverConfig(handler))\n970|\tclient, err := hostchannel.Dial(clientConn, f.clientConfig())\n971|\tif err != nil {\n972|\t\tt.Fatalf(\"Dial: %v\", err)\n973|\t}\n974|\tdefer client.Close()\n975|\tcalled := make(chan error, 1)\n976|\tgo func() {\n977|\t\t_, err := client.Call(\"health.get\", json.RawMessage(`{}`))\n978|\t\tcalled <- err\n979|\t}()\n980|\tselect {\n981|\tcase <-admitted:\n982|\tcase <-time.After(30 * time.Second):\n983|\t\tt.Fatal(\"dispatch was not admitted\")\n984|\t}\n985|\tissuedC, err := hosttrust.IssueCredential(hostC, time.Now().UTC(), nil)\n986|\tif err != nil {\n987|\t\tt.Fatalf(\"IssueCredential: %v\", err)\n988|\t}\n989|\tenroll(t, f.storeB, issuedC, hostC, time.Now().UTC())\n990|\tclose(committed)\n991|\tselect {\n992|\tcase err := <-called:\n993|\t\tif !errors.Is(err, hostchannel.ErrTransportFailure) {\n994|\t\t\tt.Fatalf(\"Call = %v\", err)\n995|\t\t}\n996|\tcase <-time.After(30 * time.Second):\n997|\t\tt.Fatal(\"Call did not return\")\n998|\t}\n999|\tif ran != 0 {\n1000|\t\tt.Fatal(\"stale boundary ran\")\n1001|\t}\n1002|\tif err := awaitErr(t, served); !errors.Is(err, hosttrust.ErrStaleGeneration) {\n1003|\t\tt.Fatalf(\"Serve = %v\", err)\n1004|\t}\n1005|}\n1006|\n1007|func TestHandlerErrorFramedAndContinues(t *testing.T) {\n1008|\tf := newFixture(t)\n1009|\thandler := func(_ context.Context, request rpcwire.Request, _ hostchannel.Binding, _ func(func() error) error) (json.RawMessage, error) {\n1010|\t\tif request.Operation() == \"boom\" {\n1011|\t\t\treturn nil, errors.New(\"handler refused\")\n1012|\t\t}\n1013|\t\treturn json.RawMessage(`{}`), nil\n1014|\t}\n1015|\tclientConn, serverConn := net.Pipe()\n1016|\tdefer clientConn.Close()\n1017|\tdefer serverConn.Close()\n1018|\tserved := serveAsync(serverConn, f.serverConfig(handler))\n1019|\tclient, err := hostchannel.Dial(clientConn, f.clientConfig())\n1020|\tif err != nil {\n1021|\t\tt.Fatalf(\"Dial: %v\", err)\n1022|\t}\n1023|\tdefer client.Close()\n1024|\tresponse, err := client.Call(\"boom\", json.RawMessage(`{}`))\n1025|\tif err != nil {\n1026|\t\tt.Fatalf(\"Call(boom) = %v\", err)\n1027|\t}\n1028|\tif response.OK() {\n1029|\t\tt.Fatal(\"boom call succeeded\")\n1030|\t}\n1031|\tassertFailure(t, response.Failure(), \"incompatible_protocol\", 6)\n1032|\tresponse, err = client.Call(\"health.get\", json.RawMessage(`{}`))\n1033|\tif err != nil || !response.OK() {\n1034|\t\tt.Fatalf(\"Call after failure = %+v, %v\", response, err)\n1035|\t}\n1036|\tif err := client.Close(); err != nil {\n1037|\t\tt.Fatalf(\"Close: %v\", err)\n1038|\t}\n1039|\t_ = awaitErr(t, served)\n1040|}\n1041|\n1042|func TestRehelloIsPlainDispatch(t *testing.T) {\n1043|\tf := newFixture(t)\n1044|\tvar sawHello bool\n1045|\thandler := func(_ context.Context, request rpcwire.Request, _ hostchannel.Binding, _ func(func() error) error) (json.RawMessage, error) {\n1046|\t\tif request.Operation() == \"hello\" {\n1047|\t\t\tsawHello = true\n1048|\t\t\treturn nil, errors.New(\"no re-hello\")\n1049|\t\t}\n1050|\t\treturn json.RawMessage(`{}`), nil\n1051|\t}\n1052|\tclientConn, serverConn := net.Pipe()\n1053|\tdefer clientConn.Close()\n1054|\tdefer serverConn.Close()\n1055|\tserved := serveAsync(serverConn, f.serverConfig(handler))\n1056|\tclient, err := hostchannel.Dial(clientConn, f.clientConfig())\n1057|\tif err != nil {\n1058|\t\tt.Fatalf(\"Dial: %v\", err)\n1059|\t}\n1060|\tdefer client.Close()\n1061|\t_, line, _ := rogueHello(t, hostA, nil)\n1062|\trequest, err := rpcwire.DecodeRequest(line)\n1063|\tif err != nil {\n1064|\t\tt.Fatalf(\"DecodeRequest: %v\", err)\n1065|\t}\n1066|\tresponse, err := client.Call(\"hello\", request.Body())\n1067|\tif err != nil {\n1068|\t\tt.Fatalf(\"Call(hello) = %v\", err)\n1069|\t}\n1070|\tif response.OK() {\n1071|\t\tt.Fatal(\"re-hello succeeded\")\n1072|\t}\n1073|\tassertFailure(t, response.Failure(), \"incompatible_protocol\", 6)\n1074|\tif !sawHello {\n1075|\t\tt.Fatal(\"re-hello never reached the handler\")\n1076|\t}\n1077|\tresponse, err = client.Call(\"health.get\", json.RawMessage(`{}`))\n1078|\tif err != nil || !response.OK() {\n1079|\t\tt.Fatalf(\"Call after re-hello = %+v, %v\", response, err)\n1080|\t}\n1081|\tif err := client.Close(); err != nil {\n1082|\t\tt.Fatalf(\"Close: %v\", err)\n1083|\t}\n1084|\t_ = awaitErr(t, served)\n1085|}\n1086|\n1087|func TestHelloResponseCorrelation(t *testing.T) {\n1088|\tf := newFixture(t)\n1089|\tclientConn, serverConn := net.Pipe()\n1090|\tdefer clientConn.Close()\n1091|\tdefer serverConn.Close()\n1092|\trogue := tls.Server(serverConn, rogueServerConfig(t, f, f.certB, nil))\n1093|\tdialed := make(chan error, 1)\n1094|\tgo func() {\n1095|\t\tclient, err := hostchannel.Dial(clientConn, f.clientConfig())\n1096|\t\tif err == nil {\n1097|\t\t\t_ = client.Close()\n1098|\t\t}\n1099|\t\tdialed <- err\n1100|\t}()\n1101|\tif err := rogue.Handshake(); err != nil {\n1102|\t\tt.Fatalf(\"handshake: %v\", err)\n1103|\t}\n1104|\tline, err := hostchannel.ReadLine(rogue)\n1105|\tif err != nil {\n1106|\t\tt.Fatalf(\"ReadLine(hello): %v\", err)\n1107|\t}\n1108|\trequest, err := rpcwire.DecodeRequest(line)\n1109|\tif err != nil {\n1110|\t\tt.Fatalf(\"DecodeRequest: %v\", err)\n1111|\t}\n1112|\tsent, err := request.Hello()\n1113|\tif err != nil {\n1114|\t\tt.Fatalf(\"Hello: %v\", err)\n1115|\t}\n1116|\tcontracts, err := rpcwire.ContractProfile(\"5.0.0\")\n1117|\tif err != nil {\n1118|\t\tt.Fatalf(\"ContractProfile: %v\", err)\n1119|\t}\n1120|\tlineBytes, _ := scalar.NewUint53(rpcwire.MaxLineBytes)\n1121|\tobjectBytes, _ := scalar.NewUint53(rpcwire.MinObjectBytes)\n1122|\tbody, err := json.Marshal(rpcwire.Hello{\n1123|\t\tHostID: hostB, Platform: \"linux\", AXVersion: \"0.6.0\",\n1124|\t\tNonce: rpcwire.NewNonce(), NonceEcho: sent.Nonce, Contracts: contracts,\n1125|\t\tMaxLineBytes: lineBytes, MaxObjectBytes: objectBytes,\n1126|\t})\n1127|\tif err != nil {\n1128|\t\tt.Fatalf(\"marshal hello: %v\", err)\n1129|\t}\n1130|\totherID, err := hostchannel.NewRequestID()\n1131|\tif err != nil {\n1132|\t\tt.Fatalf(\"NewRequestID: %v\", err)\n1133|\t}\n1134|\treply, err := json.Marshal(map[string]any{\n1135|\t\t\"protocol\": \"urn:ax:protocol:rpc\", \"protocol_version\": \"5.0.0\",\n1136|\t\t\"request_id\": otherID, \"ok\": true, \"body\": json.RawMessage(body),\n1137|\t})\n1138|\tif err != nil {\n1139|\t\tt.Fatalf(\"marshal reply: %v\", err)\n1140|\t}\n1141|\twriteRaw(t, rogue, reply)\n1142|\tselect {\n1143|\tcase err := <-dialed:\n1144|\t\tif !errors.Is(err, hostchannel.ErrProtocol) {\n1145|\t\t\tt.Fatalf(\"Dial = %v\", err)\n1146|\t\t}\n1147|\tcase <-time.After(30 * time.Second):\n1148|\t\tt.Fatal(\"Dial did not return\")\n1149|\t}\n1150|}\n1