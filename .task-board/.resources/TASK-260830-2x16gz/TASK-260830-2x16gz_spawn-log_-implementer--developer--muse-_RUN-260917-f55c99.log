{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c48d","stream":{"kind":"session","id":"01a0ae5d-13b2-70c2-be9d-d3c6350c7765"},"sequence":161,"recorded_at":1780531400000317,"record_type":"event","durability":"durable","causation_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","run_stream":{"kind":"run","id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28"},"task_stream":{"kind":"task","id":"01a0ae5d-94e2-7442-a073-f4ff353ac500"},"task_id":"01a0ae5d-94e2-7442-a073-f4ff353ac500","event":{"kind":"output","task_id":"01a0ae5d-94e2-7442-a073-f4ff353ac500","chunk":"Read text file `internal/hostchannel/channel.go`.\n1|// Package hostchannel implements AX Section 11.10 Host Channel 1.0.0 over\n2|// Mesh RPC 5.0.0: mutual TLS 1.3 host authentication over an ordered binary\n3|// duplex stream, followed by an RPC-5 hello that is authorized against the\n4|// current hosttrust generation before any dispatch.\n5|//\n6|// The package owns the TLS profile, the hello exchange, per-dispatch and\n7|// per-mutation authorization boundaries, and the specified refusal framing.\n8|// It owns no SSH process, no CLI, no operation semantics beyond admission,\n9|// and no durable state: a channel run performs no file writes. Operation\n10|// bodies stay opaque; the caller-supplied Handler answers post-hello calls.\n11|package hostchannel\n12|\n13|import (\n14|\t\"bufio\"\n15|\t\"bytes\"\n16|\t\"context\"\n17|\t\"crypto/ecdsa\"\n18|\t\"crypto/rand\"\n19|\t\"crypto/tls\"\n20|\t\"crypto/x509\"\n21|\t\"encoding/binary\"\n22|\t\"errors\"\n23|\t\"fmt\"\n24|\t\"io\"\n25|\t\"net\"\n26|\t\"strings\"\n27|\t\"sync/atomic\"\n28|\t\"time\"\n29|\n30|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n31|\t\"github.com/relux-works/agent-session-manager/internal/hosttrust\"\n32|\t\"github.com/relux-works/agent-session-manager/internal/rpcwire\"\n33|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n34|)\n35|\n36|const (\n37|\t// ProtocolVersion is the only RPC major this channel frames.\n38|\tProtocolVersion = \"5.0.0\"\n39|\t// ALPN is the exact Section 11.10.1 application protocol identifier.\n40|\tALPN = \"ax-host/1\"\n41|\t// DefaultHandshakeTimeout and DefaultHelloTimeout are the specified\n42|\t// fixed 10-second wall-clock bounds. Configuration structs select them\n43|\t// with a zero duration; tests use small overrides.\n44|\tDefaultHandshakeTimeout = 10 * time.Second\n45|\tDefaultHelloTimeout     = 10 * time.Second\n46|\t// DefaultRequestTimeout is the Section 6.2 default RPC timeout used\n47|\t// when the caller supplies no configured value.\n48|\tDefaultRequestTimeout = 300 * time.Second\n49|\t// MaxHandshakeBytes caps incoming handshake bytes per side.\n50|\tMaxHandshakeBytes = 1024 * 1024\n51|\t// MaxAuthorityBytes is the TLS CertificateRequest authority-list bound\n52|\t// the encoded CA distinguished-name list must fit.\n53|\tMaxAuthorityBytes = 65535\n54|\t// HostSuffix is the only permitted DNS SAN parent. It is asserted\n55|\t// against issued leaf certificates by test, not trusted by spelling.\n56|\tHostSuffix = \".host.ax.invalid\"\n57|\t// DefaultWatchPoll is the generation-watch sampling interval.\n58|\tDefaultWatchPoll = 50 * time.Millisecond\n59|)\n60|\n61|var (\n62|\t// ErrInvalidConfig reports a local configuration, credential-store or\n63|\t// activation failure before launch. The initiator maps it to the\n64|\t// invalid_config Error (exit 3).\n65|\tErrInvalidConfig = errors.New(\"host channel configuration is invalid\")\n66|\t// ErrAuthenticationFailed reports a known peer certificate or\n67|\t// handshake authentication failure. The initiator maps it to the\n68|\t// authentication_failed Error (exit 7).\n69|\tErrAuthenticationFailed = errors.New(\"host channel peer authentication failed\")\n70|\t// ErrTransportFailure reports transport I/O, a deadline, a byte cap,\n71|\t// or an unclassified EOF. The initiator maps it to the\n72|\t// transport_failure Error (exit 8).\n73|\tErrTransportFailure = errors.New(\"host channel transport failed\")\n74|\t// ErrProtocol reports a contract mismatch the peer actually framed:\n75|\t// a structurally invalid hello, a pre-hello non-hello request, or a\n76|\t// correlated failure the peer chose. It maps to the\n77|\t// incompatible_protocol Error (exit 6) and is never inferred from EOF.\n78|\tErrProtocol = errors.New(\"host channel protocol mismatch\")\n79|\t// ErrUnframeableInput reports input that must close without a frame:\n80|\t// unparseable bytes, an oversize line, or a foreign RPC major.\n81|\tErrUnframeableInput = errors.New(\"host channel input is unframeable\")\n82|\t// ErrHelloRequired reports a valid pre-hello non-hello request. It maps\n83|\t// to the incompatible_protocol Error (exit 6) like every framed\n84|\t// pre-hello contract refusal, but keeps its own identity so tests can\n85|\t// tell the sequencing gate from a malformed hello.\n86|\tErrHelloRequired = errors.New(\"host channel requires hello first\")\n87|\t// ErrALPNMismatch reports a negotiated ALPN other than the host\n88|\t// channel, including a missing negotiation. The tls.Config selects the\n89|\t// advertisement; this check enforces presence, which configuration\n90|\t// alone cannot.\n91|\tErrALPNMismatch = errors.New(\"host channel ALPN mismatch\")\n92|\t// ErrUnexpectedResume reports a resumed TLS connection, which the\n93|\t// channel forbids even when the peer negotiates one.\n94|\tErrUnexpectedResume = errors.New(\"host channel resumed connection refused\")\n95|\t// ErrUnverifiedChain reports a handshake that reached the supplement\n96|\t// without a standard-verified chain. The supplement never replaces\n97|\t// standard chain/name/time/EKU verification.\n98|\tErrUnverifiedChain = errors.New(\"host channel chain verification missing\")\n99|\t// ErrNoEnrolledMatch reports a peer certificate with zero or multiple\n100|\t// exact enrolled leaf/root/key matches. SAN or CA membership alone\n101|\t// never suffices.\n102|\tErrNoEnrolledMatch = errors.New(\"host channel peer has no unique enrolled match\")\n103|\t// ErrPeerTrustState reports a uniquely matched entry that is revoked\n104|\t// or past its retire_at bound.\n105|\tErrPeerTrustState = errors.New(\"host channel peer trust state refuses admission\")\n106|\t// ErrPeerProfile reports a matched entry whose certificates fail the\n107|\t// Host Credential Profile 1 checks at handshake time.\n108|\tErrPeerProfile = errors.New(\"host channel peer credential profile refused\")\n109|)\n110|\n111|// LocalFailure maps a channel error to the initiator-local Structured Error\n112|// code and exit status of Section 11.10.1. The second result is false when\n113|// the error carries no initiator mapping.\n114|func LocalFailure(err error) (axerror.Code, int, bool) {\n115|\tswitch {\n116|\tcase errors.Is(err, ErrInvalidConfig):\n117|\t\treturn axerror.Code(\"invalid_config\"), 3, true\n118|\tcase errors.Is(err, ErrAuthenticationFailed),\n119|\t\terrors.Is(err, ErrALPNMismatch),\n120|\t\terrors.Is(err, hosttrust.ErrHostIdentityMismatch),\n121|\t\terrors.Is(err, hosttrust.ErrNotAllowlisted),\n122|\t\terrors.Is(err, hosttrust.ErrStaleGeneration),\n123|\t\terrors.Is(err, hosttrust.ErrAuthorizationRefused):\n124|\t\treturn axerror.Code(\"authentication_failed\"), 7, true\n125|\tcase errors.Is(err, ErrProtocol),\n126|\t\terrors.Is(err, ErrHelloRequired):\n127|\t\treturn axerror.Code(\"incompatible_protocol\"), 6, true\n128|\tcase errors.Is(err, ErrTransportFailure),\n129|\t\terrors.Is(err, ErrUnframeableInput):\n130|\t\treturn axerror.Code(\"transport_failure\"), 8, true\n131|\tdefault:\n132|\t\treturn \"\", 0, false\n133|\t}\n134|}\n135|\n136|// Stream is the ordered binary stdin/stdout carrier the TLS session runs\n137|// over. It is deliberately narrower than net.Conn: no listener, no PTY, no\n138|// deadlines. Timeouts are enforced by closing the stream.\n139|type Stream interface {\n140|\tio.Reader\n141|\tio.Writer\n142|\tClose() error\n143|}\n144|\n145|// ServerName derives the expected UUID-derived DNS SAN of a configured\n146|// destination. The SSH endpoint is never a name here.\n147|func ServerName(hostID string) (string, error) {\n148|\tparsed, err := scalar.ParseUUIDv7(hostID)\n149|\tif err != nil {\n150|\t\treturn \"\", fmt.Errorf(\"%w: %w\", ErrInvalidConfig, err)\n151|\t}\n152|\treturn parsed.String() + HostSuffix, nil\n153|}\n154|\n155|// NewRequestID mints one fresh UUIDv7 request correlator.\n156|func NewRequestID() (string, error) {\n157|\tvar id [16]byte\n158|\tbinary.BigEndian.PutUint64(id[:8], uint64(time.Now().UnixMilli())<<16)\n159|\tif _, err := rand.Read(id[8:]); err != nil {\n160|\t\treturn \"\", fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n161|\t}\n162|\tid[6] = id[6]&0x0f | 0x70\n163|\tid[8] = id[8]&0x3f | 0x80\n164|\tvar text strings.Builder\n165|\tconst digits = \"0123456789abcdef\"\n166|\tfor i, b := range id {\n167|\t\tif i == 4 || i == 6 || i == 8 || i == 10 {\n168|\t\t\ttext.WriteByte('-')\n169|\t\t}\n170|\t\ttext.WriteByte(digits[b>>4])\n171|\t\ttext.WriteByte(digits[b&0x0f])\n172|\t}\n173|\tparsed, err := scalar.ParseUUIDv7(text.String())\n174|\tif err != nil {\n175|\t\treturn \"\", fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n176|\t}\n177|\treturn parsed.String(), nil\n178|}\n179|\n180|// AuthorityListOverflow reports whether the encoded CA distinguished-name\n181|// list of the given subjects exceeds the TLS authority-list bound. The\n182|// encoding is the 2-byte vector length plus one 2-byte length prefix per\n183|// name. Activation refuses an overflowing pool instead of truncating it.\n184|func AuthorityListOverflow(subjects [][]byte) bool {\n185|\ttotal := 2\n186|\tfor _, subject := range subjects {\n187|\t\ttotal += 2 + len(subject)\n188|\t}\n189|\treturn total > MaxAuthorityBytes\n190|}\n191|\n192|// EnrollmentPool builds the TLS trust pool from exactly the enrolled,\n193|// non-revoked, currently profile-valid roots of the snapshot. The system\n194|// pool is never consulted. Revoked or expired entries are excluded;\n195|// activation refuses when the remaining authority list overflows.\n196|func EnrollmentPool(snapshot hosttrust.Snapshot, now time.Time) (*x509.CertPool, error) {\n197|\tpool := x509.NewCertPool()\n198|\tvar subjects [][]byte\n199|\tfor _, entry := range snapshot.Trust.Entries {\n200|\t\tif entry.State == hosttrust.EntryRevoked {\n201|\t\t\tcontinue\n202|\t\t}\n203|\t\tif err := hosttrust.VerifyProfile(entry.LeafDER, entry.RootDER, entry.HostID.String(), now); err != nil {\n204|\t\t\tcontinue\n205|\t\t}\n206|\t\troot, err := x509.ParseCertificate(entry.RootDER)\n207|\t\tif err != nil {\n208|\t\t\tcontinue\n209|\t\t}\n210|\t\tpool.AddCert(root)\n211|\t\tsubjects = append(subjects, root.RawSubject)\n212|\t}\n213|\tif AuthorityListOverflow(subjects) {\n214|\t\treturn nil, fmt.Errorf(\"%w: enrolled authority list exceeds the TLS bound\", ErrInvalidConfig)\n215|\t}\n216|\treturn pool, nil\n217|}\n218|\n219|// VerifiedPeer is the uniquely verified enrolled identity of a TLS peer.\n220|// DER bytes stay unexported so status and error paths cannot log them.\n221|type VerifiedPeer struct {\n222|\tHostID       string\n223|\tCredentialID string\n224|\tleafDER      []byte\n225|\trootDER      []byte\n226|}\n227|\n228|// VerifyFunc supplements a successful standard TLS verification with the\n229|// enrolled-identity checks. It never replaces standard verification.\n230|type VerifyFunc func(tls.ConnectionState) error\n231|\n232|// VerifyPeer returns the supplement plus the record it fills on success.\n233|// The TLS version is enforced once, by the tls.Config both builders share\n234|// below. The supplement requires the exact negotiated ALPN (configuration\n235|// alone cannot refuse a missing negotiation), no resumption, a\n236|// standard-verified chain, exactly one exact enrolled leaf/root/key match,\n237|// current profile validity, and an admitting trust state. UUID/SAN binding\n238|// comes from the profile check against the matched entry.\n239|func VerifyPeer(snapshot hosttrust.Snapshot, now time.Time) (VerifyFunc, *VerifiedPeer) {\n240|\tverified := &VerifiedPeer{}\n241|\tverify := func(state tls.ConnectionState) error {\n242|\t\tif state.NegotiatedProtocol != ALPN {\n243|\t\t\treturn ErrALPNMismatch\n244|\t\t}\n245|\t\tif state.DidResume {\n246|\t\t\treturn ErrUnexpectedResume\n247|\t\t}\n248|\t\tif len(state.VerifiedChains) == 0 || len(state.PeerCertificates) == 0 {\n249|\t\t\treturn ErrUnverifiedChain\n250|\t\t}\n251|\t\tleaf := state.PeerCertificates[0]\n252|\t\tchain := state.VerifiedChains[0]\n253|\t\troot := chain[len(chain)-1]\n254|\t\tspki := scalar.SHA256Digest(leaf.RawSubjectPublicKeyInfo).String()\n255|\t\tvar matched []hosttrust.CredentialEntry\n256|\t\tfor _, entry := range snapshot.Trust.Entries {\n257|\t\t\tif !bytes.Equal(entry.LeafDER, leaf.Raw) {\n258|\t\t\t\tcontinue\n259|\t\t\t}\n260|\t\t\tif !bytes.Equal(entry.RootDER, root.Raw) {\n261|\t\t\t\tcontinue\n262|\t\t\t}\n263|\t\t\tif entry.SPKIID.String() != spki {\n264|\t\t\t\tcontinue\n265|\t\t\t}\n266|\t\t\tmatched = append(matched, entry)\n267|\t\t}\n268|\t\tif len(matched) != 1 {\n269|\t\t\treturn ErrNoEnrolledMatch\n270|\t\t}\n271|\t\tentry := matched[0]\n272|\t\tif err := hosttrust.VerifyProfile(entry.LeafDER, entry.RootDER, entry.HostID.String(), now); err != nil {\n273|\t\t\treturn fmt.Errorf(\"%w: %w\", ErrPeerProfile, err)\n274|\t\t}\n275|\t\tswitch entry.State {\n276|\t\tcase hosttrust.EntryActive:\n277|\t\tcase hosttrust.EntryRetiring:\n278|\t\t\tif entry.RetireAt == nil {\n279|\t\t\t\treturn ErrPeerTrustState\n280|\t\t\t}\n281|\t\t\tretireAt, err := entry.RetireAt.Time()\n282|\t\t\tif err != nil || !now.Before(retireAt) {\n283|\t\t\t\treturn ErrPeerTrustState\n284|\t\t\t}\n285|\t\tdefault:\n286|\t\t\treturn ErrPeerTrustState\n287|\t\t}\n288|\t\tverified.HostID = entry.HostID.String()\n289|\t\tverified.CredentialID = entry.CredentialID.String()\n290|\t\tverified.leafDER = bytes.Clone(leaf.Raw)\n291|\t\tverified.rootDER = bytes.Clone(root.Raw)\n292|\t\treturn nil\n293|\t}\n294|\treturn verify, verified\n295|}\n296|\n297|// baseTLS carries the single shared enforcement of the TLS version floor\n298|// and ceiling, the exact ALPN, and mandatory verification. Both roles\n299|// build on it so no role can drift from the profile.\n300|func baseTLS() *tls.Config {\n301|\treturn &tls.Config{\n302|\t\tMinVersion:         tls.VersionTLS13,\n303|\t\tMaxVersion:         tls.VersionTLS13,\n304|\t\tNextProtos:         alpnProtocols(),\n305|\t\tInsecureSkipVerify: false,\n306|\t}\n307|}\n308|\n309|func alpnProtocols() []string { return []string{ALPN} }\n310|\n311|// ClientTLS builds the initiator TLS 1.3 client configuration: enrolled\n312|// roots only, no session cache, the exact ALPN, and the destination SAN as\n313|// server name. The supplement runs inside VerifyConnection.\n314|func ClientTLS(certificate tls.Certificate, pool *x509.CertPool, serverName string, verify VerifyFunc) *tls.Config {\n315|\tconfig := baseTLS()\n316|\tconfig.Certificates = []tls.Certificate{certificate}\n317|\tconfig.RootCAs = pool\n318|\tconfig.ServerName = serverName\n319|\tconfig.ClientSessionCache = nil\n320|\tconfig.VerifyConnection = verify\n321|\treturn config\n322|}\n323|\n324|// ServerTLS builds the responder TLS 1.3 server configuration: enrolled\n325|// roots only, mandatory verified client certificates, no session tickets,\n326|// the exact ALPN, and the supplement inside VerifyConnection.\n327|func ServerTLS(certificate tls.Certificate, pool *x509.CertPool, verify VerifyFunc) *tls.Config {\n328|\tconfig := baseTLS()\n329|\tconfig.Certificates = []tls.Certificate{certificate}\n330|\tconfig.ClientAuth = tls.RequireAndVerifyClientCert\n331|\tconfig.ClientCAs = pool\n332|\tconfig.SessionTicketsDisabled = true\n333|\tconfig.VerifyConnection = verify\n334|\treturn config\n335|}\n336|\n337|// HandshakeLimiter caps incoming handshake bytes while armed. The channel\n338|// disarms it immediately after local handshake success, so application\n339|// records never count against the handshake budget.\n340|type HandshakeLimiter struct {\n341|\treader io.Reader\n342|\tcount  int64\n343|\tarmed  atomic.Bool\n344|\texceed atomic.Bool\n345|\tlimit  int64\n346|}\n347|\n348|// NewHandshakeLimiter arms a 1 MiB incoming cap over the handshake stream.\n349|func NewHandshakeLimiter(reader io.Reader) *HandshakeLimiter {\n350|\tlimiter := &HandshakeLimiter{reader: reader, limit: MaxHandshakeBytes}\n351|\tlimiter.armed.Store(true)\n352|\treturn limiter\n353|}\n354|\n355|// Disarm ends handshake byte accounting after local handshake success.\n356|func (limiter *HandshakeLimiter) Disarm() { limiter.armed.Store(false) }\n357|\n358|// Exceeded reports whether the cap fired.\n359|func (limiter *HandshakeLimiter) Exceeded() bool { return limiter.exceed.Load() }\n360|\n361|func (limiter *HandshakeLimiter) Read(data []byte) (int, error) {\n362|\tn, err := limiter.reader.Read(data)\n363|\tif !limiter.armed.Load() {\n364|\t\treturn n, err\n365|\t}\n366|\tlimiter.count += int64(n)\n367|\tif limiter.count > limiter.limit {\n368|\t\tlimiter.exceed.Store(true)\n369|\t\treturn n, fmt.Errorf(\"%w: handshake byte cap exceeded\", ErrTransportFailure)\n370|\t}\n371|\treturn n, err\n372|}\n373|\n374|// streamConn adapts a Stream to the net.Conn shape crypto/tls requires.\n375|// Addresses are static pipe labels; deadlines are unsupported because the\n376|// channel enforces its bounds by closing the stream.\n377|type streamConn struct {\n378|\tStream\n379|}\n380|\n381|type pipeAddr string\n382|\n383|func (addr pipeAddr) Network() string { return \"pipe\" }\n384|func (addr pipeAddr) String() string  { return string(addr) }\n385|\n386|func (conn streamConn) LocalAddr() net.Addr  { return pipeAddr(\"local\") }\n387|func (conn streamConn) RemoteAddr() net.Addr { return pipeAddr(\"remote\") }\n388|func (conn streamConn) SetDeadline(_ time.Time) error {\n389|\treturn errors.New(\"host channel deadlines close the stream\")\n390|}\n391|func (conn streamConn) SetReadDeadline(_ time.Time) error {\n392|\treturn errors.New(\"host channel deadlines close the stream\")\n393|}\n394|func (conn streamConn) SetWriteDeadline(_ time.Time) error {\n395|\treturn errors.New(\"host channel deadlines close the stream\")\n396|}\n397|\n398|// RunHandshake completes the TLS handshake under a wall-clock deadline,\n399|// enforced by closing the stream even when the peer sends nothing. A fired\n400|// deadline, an exceeded byte cap, or a transport read failure maps to\n401|// ErrTransportFailure; every other handshake failure is peer\n402|// authentication. No application bytes may move before this returns nil.\n403|func RunHandshake(conn *tls.Conn, stream Stream, limiter *HandshakeLimiter, timeout time.Duration) error {\n404|\tdone := make(chan error, 1)\n405|\tgo func() { done <- conn.Handshake() }()\n406|\ttimer := time.NewTimer(timeout)\n407|\tdefer timer.Stop()\n408|\tselect {\n409|\tcase err := <-done:\n410|\t\tif err == nil {\n411|\t\t\treturn nil\n412|\t\t}\n413|\t\tif limiter != nil && limiter.Exceeded() {\n414|\t\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n415|\t\t}\n416|\t\treturn classifyHandshakeError(err)\n417|\tcase <-timer.C:\n418|\t\t_ = stream.Close()\n419|\t\terr := <-done\n420|\t\tif limiter != nil && limiter.Exceeded() {\n421|\t\t\treturn fmt.Errorf(\"%w: handshake deadline exceeded\", ErrTransportFailure)\n422|\t\t}\n423|\t\tif err == nil {\n424|\t\t\treturn fmt.Errorf(\"%w: handshake deadline exceeded\", ErrTransportFailure)\n425|\t\t}\n426|\t\treturn fmt.Errorf(\"%w: handshake deadline exceeded: %v\", ErrTransportFailure, classifyHandshakeError(err))\n427|\t}\n428|}\n429|\n430|func classifyHandshakeError(err error) error {\n431|\tif err == nil {\n432|\t\treturn nil\n433|\t}\n434|\tif errors.Is(err, ErrTransportFailure) {\n435|\t\treturn err\n436|\t}\n437|\t// A received TLS alert unwraps to an OpError whose Op is \"remote\n438|\t// error\": that is peer authentication, never transport I/O. Every\n439|\t// other OpError, a timeout, a closed conn, or an EOF variant is the\n440|\t// transport failing underneath the handshake.\n441|\tvar opErr *net.OpError\n442|\tif errors.As(err, &opErr) && opErr.Op != \"remote error\" {\n443|\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n444|\t}\n445|\tvar netErr net.Error\n446|\tif errors.As(err, &netErr) && netErr.Timeout() {\n447|\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n448|\t}\n449|\tif errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) || errors.Is(err, io.ErrClosedPipe) || errors.Is(err, net.ErrClosed) {\n450|\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n451|\t}\n452|\treturn fmt.Errorf(\"%w: %w\", ErrAuthenticationFailed, err)\n453|}\n454|\n455|// WriteLine sends one LF-terminated frame. The payload must already be a\n456|// single LF-free line within the wire bound; the check here is defensive.\n457|func WriteLine(writer io.Writer, line []byte) error {\n458|\tif len(line) == 0 || len(line) > rpcwire.MaxLineBytes || bytes.IndexByte(line, '\\n') >= 0 {\n459|\t\treturn ErrUnframeableInput\n460|\t}\n461|\tframe := make([]byte, 0, len(line)+1)\n462|\tframe = append(frame, line...)\n463|\tframe = append(frame, '\\n')\n464|\tif _, err := writer.Write(frame); err != nil {\n465|\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n466|\t}\n467|\treturn nil\n468|}\n469|\n470|// FrameReader decodes successive LF-terminated frames from one stream. It\n471|// must be the only reader on its stream: buffering may hold bytes past\n472|// the current frame. One FrameReader serves a whole connection.\n473|type FrameReader struct {\n474|\tbuffered *bufio.Reader\n475|}\n476|\n477|// NewFrameReader buffers one stream for successive frame reads.\n478|func NewFrameReader(reader io.Reader) *FrameReader {\n479|\treturn &FrameReader{buffered: bufio.NewReader(reader)}\n480|}\n481|\n482|// ReadLine reads one LF-terminated frame without the terminator. An\n483|// over-bound line or mid-line truncation is unframeable and must close\n484|// without a frame. A stream that ends with no frame bytes surfaces as\n485|// io.EOF for the transport mapping, including an abrupt end: zero bytes\n486|// is never a truncated frame.\n487|func (frames *FrameReader) ReadLine() ([]byte, error) {\n488|\tvar line []byte\n489|\tfor {\n490|\t\tchunk, err := frames.buffered.ReadSlice('\\n')\n491|\t\tif len(chunk) > 0 {\n492|\t\t\tif len(line)+len(chunk) > rpcwire.MaxLineBytes+1 {\n493|\t\t\t\treturn nil, ErrUnframeableInput\n494|\t\t\t}\n495|\t\t\tline = append(line, chunk...)\n496|\t\t}\n497|\t\tswitch {\n498|\t\tcase err == nil:\n499|\t\t\treturn line[:len(line)-1], nil\n500|\t\tcase errors.Is(err, bufio.ErrBufferFull):\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c48f","stream":{"kind":"session","id":"01a0ae5d-13b2-70c2-be9d-d3c6350c7765"},"sequence":162,"recorded_at":1780531400000319,"record_type":"event","durability":"durable","causation_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","run_stream":{"kind":"run","id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28"},"task_stream":{"kind":"task","id":"01a0ae5d-94e2-7442-a073-f4ff353ac500"},"task_id":"01a0ae5d-94e2-7442-a073-f4ff353ac500","event":{"kind":"completed","task_id":"01a0ae5d-94e2-7442-a073-f4ff353ac500"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c491","stream":{"kind":"session","id":"01a0ae5d-13b2-70c2-be9d-d3c6350c7765"},"sequence":163,"recorded_at":1780531400000321,"record_type":"event","durability":"durable","causation_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","run_stream":{"kind":"run","id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28"},"call_id":"call_01a0ae5d90a7721eabf629e6e70c72f2","text":"Read text file `internal/hostchannel/channel.go`.\n1|// Package hostchannel implements AX Section 11.10 Host Channel 1.0.0 over\n2|// Mesh RPC 5.0.0: mutual TLS 1.3 host authentication over an ordered binary\n3|// duplex stream, followed by an RPC-5 hello that is authorized against the\n4|// current hosttrust generation before any dispatch.\n5|//\n6|// The package owns the TLS profile, the hello exchange, per-dispatch and\n7|// per-mutation authorization boundaries, and the specified refusal framing.\n8|// It owns no SSH process, no CLI, no operation semantics beyond admission,\n9|// and no durable state: a channel run performs no file writes. Operation\n10|// bodies stay opaque; the caller-supplied Handler answers post-hello calls.\n11|package hostchannel\n12|\n13|import (\n14|\t\"bufio\"\n15|\t\"bytes\"\n16|\t\"context\"\n17|\t\"crypto/ecdsa\"\n18|\t\"crypto/rand\"\n19|\t\"crypto/tls\"\n20|\t\"crypto/x509\"\n21|\t\"encoding/binary\"\n22|\t\"errors\"\n23|\t\"fmt\"\n24|\t\"io\"\n25|\t\"net\"\n26|\t\"strings\"\n27|\t\"sync/atomic\"\n28|\t\"time\"\n29|\n30|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n31|\t\"github.com/relux-works/agent-session-manager/internal/hosttrust\"\n32|\t\"github.com/relux-works/agent-session-manager/internal/rpcwire\"\n33|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n34|)\n35|\n36|const (\n37|\t// ProtocolVersion is the only RPC major this channel frames.\n38|\tProtocolVersion = \"5.0.0\"\n39|\t// ALPN is the exact Section 11.10.1 application protocol identifier.\n40|\tALPN = \"ax-host/1\"\n41|\t// DefaultHandshakeTimeout and DefaultHelloTimeout are the specified\n42|\t// fixed 10-second wall-clock bounds. Configuration structs select them\n43|\t// with a zero duration; tests use small overrides.\n44|\tDefaultHandshakeTimeout = 10 * time.Second\n45|\tDefaultHelloTimeout     = 10 * time.Second\n46|\t// DefaultRequestTimeout is the Section 6.2 default RPC timeout used\n47|\t// when the caller supplies no configured value.\n48|\tDefaultRequestTimeout = 300 * time.Second\n49|\t// MaxHandshakeBytes caps incoming handshake bytes per side.\n50|\tMaxHandshakeBytes = 1024 * 1024\n51|\t// MaxAuthorityBytes is the TLS CertificateRequest authority-list bound\n52|\t// the encoded CA distinguished-name list must fit.\n53|\tMaxAuthorityBytes = 65535\n54|\t// HostSuffix is the only permitted DNS SAN parent. It is asserted\n55|\t// against issued leaf certificates by test, not trusted by spelling.\n56|\tHostSuffix = \".host.ax.invalid\"\n57|\t// DefaultWatchPoll is the generation-watch sampling interval.\n58|\tDefaultWatchPoll = 50 * time.Millisecond\n59|)\n60|\n61|var (\n62|\t// ErrInvalidConfig reports a local configuration, credential-store or\n63|\t// activation failure before launch. The initiator maps it to the\n64|\t// invalid_config Error (exit 3).\n65|\tErrInvalidConfig = errors.New(\"host channel configuration is invalid\")\n66|\t// ErrAuthenticationFailed reports a known peer certificate or\n67|\t// handshake authentication failure. The initiator maps it to the\n68|\t// authentication_failed Error (exit 7).\n69|\tErrAuthenticationFailed = errors.New(\"host channel peer authentication failed\")\n70|\t// ErrTransportFailure reports transport I/O, a deadline, a byte cap,\n71|\t// or an unclassified EOF. The initiator maps it to the\n72|\t// transport_failure Error (exit 8).\n73|\tErrTransportFailure = errors.New(\"host channel transport failed\")\n74|\t// ErrProtocol reports a contract mismatch the peer actually framed:\n75|\t// a structurally invalid hello, a pre-hello non-hello request, or a\n76|\t// correlated failure the peer chose. It maps to the\n77|\t// incompatible_protocol Error (exit 6) and is never inferred from EOF.\n78|\tErrProtocol = errors.New(\"host channel protocol mismatch\")\n79|\t// ErrUnframeableInput reports input that must close without a frame:\n80|\t// unparseable bytes, an oversize line, or a foreign RPC major.\n81|\tErrUnframeableInput = errors.New(\"host channel input is unframeable\")\n82|\t// ErrHelloRequired reports a valid pre-hello non-hello request. It maps\n83|\t// to the incompatible_protocol Error (exit 6) like every framed\n84|\t// pre-hello contract refusal, but keeps its own identity so tests can\n85|\t// tell the sequencing gate from a malformed hello.\n86|\tErrHelloRequired = errors.New(\"host channel requires hello first\")\n87|\t// ErrALPNMismatch reports a negotiated ALPN other than the host\n88|\t// channel, including a missing negotiation. The tls.Config selects the\n89|\t// advertisement; this check enforces presence, which configuration\n90|\t// alone cannot.\n91|\tErrALPNMismatch = errors.New(\"host channel ALPN mismatch\")\n92|\t// ErrUnexpectedResume reports a resumed TLS connection, which the\n93|\t// channel forbids even when the peer negotiates one.\n94|\tErrUnexpectedResume = errors.New(\"host channel resumed connection refused\")\n95|\t// ErrUnverifiedChain reports a handshake that reached the supplement\n96|\t// without a standard-verified chain. The supplement never replaces\n97|\t// standard chain/name/time/EKU verification.\n98|\tErrUnverifiedChain = errors.New(\"host channel chain verification missing\")\n99|\t// ErrNoEnrolledMatch reports a peer certificate with zero or multiple\n100|\t// exact enrolled leaf/root/key matches. SAN or CA membership alone\n101|\t// never suffices.\n102|\tErrNoEnrolledMatch = errors.New(\"host channel peer has no unique enrolled match\")\n103|\t// ErrPeerTrustState reports a uniquely matched entry that is revoked\n104|\t// or past its retire_at bound.\n105|\tErrPeerTrustState = errors.New(\"host channel peer trust state refuses admission\")\n106|\t// ErrPeerProfile reports a matched entry whose certificates fail the\n107|\t// Host Credential Profile 1 checks at handshake time.\n108|\tErrPeerProfile = errors.New(\"host channel peer credential profile refused\")\n109|)\n110|\n111|// LocalFailure maps a channel error to the initiator-local Structured Error\n112|// code and exit status of Section 11.10.1. The second result is false when\n113|// the error carries no initiator mapping.\n114|func LocalFailure(err error) (axerror.Code, int, bool) {\n115|\tswitch {\n116|\tcase errors.Is(err, ErrInvalidConfig):\n117|\t\treturn axerror.Code(\"invalid_config\"), 3, true\n118|\tcase errors.Is(err, ErrAuthenticationFailed),\n119|\t\terrors.Is(err, ErrALPNMismatch),\n120|\t\terrors.Is(err, hosttrust.ErrHostIdentityMismatch),\n121|\t\terrors.Is(err, hosttrust.ErrNotAllowlisted),\n122|\t\terrors.Is(err, hosttrust.ErrStaleGeneration),\n123|\t\terrors.Is(err, hosttrust.ErrAuthorizationRefused):\n124|\t\treturn axerror.Code(\"authentication_failed\"), 7, true\n125|\tcase errors.Is(err, ErrProtocol),\n126|\t\terrors.Is(err, ErrHelloRequired):\n127|\t\treturn axerror.Code(\"incompatible_protocol\"), 6, true\n128|\tcase errors.Is(err, ErrTransportFailure),\n129|\t\terrors.Is(err, ErrUnframeableInput):\n130|\t\treturn axerror.Code(\"transport_failure\"), 8, true\n131|\tdefault:\n132|\t\treturn \"\", 0, false\n133|\t}\n134|}\n135|\n136|// Stream is the ordered binary stdin/stdout carrier the TLS session runs\n137|// over. It is deliberately narrower than net.Conn: no listener, no PTY, no\n138|// deadlines. Timeouts are enforced by closing the stream.\n139|type Stream interface {\n140|\tio.Reader\n141|\tio.Writer\n142|\tClose() error\n143|}\n144|\n145|// ServerName derives the expected UUID-derived DNS SAN of a configured\n146|// destination. The SSH endpoint is never a name here.\n147|func ServerName(hostID string) (string, error) {\n148|\tparsed, err := scalar.ParseUUIDv7(hostID)\n149|\tif err != nil {\n150|\t\treturn \"\", fmt.Errorf(\"%w: %w\", ErrInvalidConfig, err)\n151|\t}\n152|\treturn parsed.String() + HostSuffix, nil\n153|}\n154|\n155|// NewRequestID mints one fresh UUIDv7 request correlator.\n156|func NewRequestID() (string, error) {\n157|\tvar id [16]byte\n158|\tbinary.BigEndian.PutUint64(id[:8], uint64(time.Now().UnixMilli())<<16)\n159|\tif _, err := rand.Read(id[8:]); err != nil {\n160|\t\treturn \"\", fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n161|\t}\n162|\tid[6] = id[6]&0x0f | 0x70\n163|\tid[8] = id[8]&0x3f | 0x80\n164|\tvar text strings.Builder\n165|\tconst digits = \"0123456789abcdef\"\n166|\tfor i, b := range id {\n167|\t\tif i == 4 || i == 6 || i == 8 || i == 10 {\n168|\t\t\ttext.WriteByte('-')\n169|\t\t}\n170|\t\ttext.WriteByte(digits[b>>4])\n171|\t\ttext.WriteByte(digits[b&0x0f])\n172|\t}\n173|\tparsed, err := scalar.ParseUUIDv7(text.String())\n174|\tif err != nil {\n175|\t\treturn \"\", fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n176|\t}\n177|\treturn parsed.String(), nil\n178|}\n179|\n180|// AuthorityListOverflow reports whether the encoded CA distinguished-name\n181|// list of the given subjects exceeds the TLS authority-list bound. The\n182|// encoding is the 2-byte vector length plus one 2-byte length prefix per\n183|// name. Activation refuses an overflowing pool instead of truncating it.\n184|func AuthorityListOverflow(subjects [][]byte) bool {\n185|\ttotal := 2\n186|\tfor _, subject := range subjects {\n187|\t\ttotal += 2 + len(subject)\n188|\t}\n189|\treturn total > MaxAuthorityBytes\n190|}\n191|\n192|// EnrollmentPool builds the TLS trust pool from exactly the enrolled,\n193|// non-revoked, currently profile-valid roots of the snapshot. The system\n194|// pool is never consulted. Revoked or expired entries are excluded;\n195|// activation refuses when the remaining authority list overflows.\n196|func EnrollmentPool(snapshot hosttrust.Snapshot, now time.Time) (*x509.CertPool, error) {\n197|\tpool := x509.NewCertPool()\n198|\tvar subjects [][]byte\n199|\tfor _, entry := range snapshot.Trust.Entries {\n200|\t\tif entry.State == hosttrust.EntryRevoked {\n201|\t\t\tcontinue\n202|\t\t}\n203|\t\tif err := hosttrust.VerifyProfile(entry.LeafDER, entry.RootDER, entry.HostID.String(), now); err != nil {\n204|\t\t\tcontinue\n205|\t\t}\n206|\t\troot, err := x509.ParseCertificate(entry.RootDER)\n207|\t\tif err != nil {\n208|\t\t\tcontinue\n209|\t\t}\n210|\t\tpool.AddCert(root)\n211|\t\tsubjects = append(subjects, root.RawSubject)\n212|\t}\n213|\tif AuthorityListOverflow(subjects) {\n214|\t\treturn nil, fmt.Errorf(\"%w: enrolled authority list exceeds the TLS bound\", ErrInvalidConfig)\n215|\t}\n216|\treturn pool, nil\n217|}\n218|\n219|// VerifiedPeer is the uniquely verified enrolled identity of a TLS peer.\n220|// DER bytes stay unexported so status and error paths cannot log them.\n221|type VerifiedPeer struct {\n222|\tHostID       string\n223|\tCredentialID string\n224|\tleafDER      []byte\n225|\trootDER      []byte\n226|}\n227|\n228|// VerifyFunc supplements a successful standard TLS verification with the\n229|// enrolled-identity checks. It never replaces standard verification.\n230|type VerifyFunc func(tls.ConnectionState) error\n231|\n232|// VerifyPeer returns the supplement plus the record it fills on success.\n233|// The TLS version is enforced once, by the tls.Config both builders share\n234|// below. The supplement requires the exact negotiated ALPN (configuration\n235|// alone cannot refuse a missing negotiation), no resumption, a\n236|// standard-verified chain, exactly one exact enrolled leaf/root/key match,\n237|// current profile validity, and an admitting trust state. UUID/SAN binding\n238|// comes from the profile check against the matched entry.\n239|func VerifyPeer(snapshot hosttrust.Snapshot, now time.Time) (VerifyFunc, *VerifiedPeer) {\n240|\tverified := &VerifiedPeer{}\n241|\tverify := func(state tls.ConnectionState) error {\n242|\t\tif state.NegotiatedProtocol != ALPN {\n243|\t\t\treturn ErrALPNMismatch\n244|\t\t}\n245|\t\tif state.DidResume {\n246|\t\t\treturn ErrUnexpectedResume\n247|\t\t}\n248|\t\tif len(state.VerifiedChains) == 0 || len(state.PeerCertificates) == 0 {\n249|\t\t\treturn ErrUnverifiedChain\n250|\t\t}\n251|\t\tleaf := state.PeerCertificates[0]\n252|\t\tchain := state.VerifiedChains[0]\n253|\t\troot := chain[len(chain)-1]\n254|\t\tspki := scalar.SHA256Digest(leaf.RawSubjectPublicKeyInfo).String()\n255|\t\tvar matched []hosttrust.CredentialEntry\n256|\t\tfor _, entry := range snapshot.Trust.Entries {\n257|\t\t\tif !bytes.Equal(entry.LeafDER, leaf.Raw) {\n258|\t\t\t\tcontinue\n259|\t\t\t}\n260|\t\t\tif !bytes.Equal(entry.RootDER, root.Raw) {\n261|\t\t\t\tcontinue\n262|\t\t\t}\n263|\t\t\tif entry.SPKIID.String() != spki {\n264|\t\t\t\tcontinue\n265|\t\t\t}\n266|\t\t\tmatched = append(matched, entry)\n267|\t\t}\n268|\t\tif len(matched) != 1 {\n269|\t\t\treturn ErrNoEnrolledMatch\n270|\t\t}\n271|\t\tentry := matched[0]\n272|\t\tif err := hosttrust.VerifyProfile(entry.LeafDER, entry.RootDER, entry.HostID.String(), now); err != nil {\n273|\t\t\treturn fmt.Errorf(\"%w: %w\", ErrPeerProfile, err)\n274|\t\t}\n275|\t\tswitch entry.State {\n276|\t\tcase hosttrust.EntryActive:\n277|\t\tcase hosttrust.EntryRetiring:\n278|\t\t\tif entry.RetireAt == nil {\n279|\t\t\t\treturn ErrPeerTrustState\n280|\t\t\t}\n281|\t\t\tretireAt, err := entry.RetireAt.Time()\n282|\t\t\tif err != nil || !now.Before(retireAt) {\n283|\t\t\t\treturn ErrPeerTrustState\n284|\t\t\t}\n285|\t\tdefault:\n286|\t\t\treturn ErrPeerTrustState\n287|\t\t}\n288|\t\tverified.HostID = entry.HostID.String()\n289|\t\tverified.CredentialID = entry.CredentialID.String()\n290|\t\tverified.leafDER = bytes.Clone(leaf.Raw)\n291|\t\tverified.rootDER = bytes.Clone(root.Raw)\n292|\t\treturn nil\n293|\t}\n294|\treturn verify, verified\n295|}\n296|\n297|// baseTLS carries the single shared enforcement of the TLS version floor\n298|// and ceiling, the exact ALPN, and mandatory verification. Both roles\n299|// build on it so no role can drift from the profile.\n300|func baseTLS() *tls.Config {\n301|\treturn &tls.Config{\n302|\t\tMinVersion:         tls.VersionTLS13,\n303|\t\tMaxVersion:         tls.VersionTLS13,\n304|\t\tNextProtos:         alpnProtocols(),\n305|\t\tInsecureSkipVerify: false,\n306|\t}\n307|}\n308|\n309|func alpnProtocols() []string { return []string{ALPN} }\n310|\n311|// ClientTLS builds the initiator TLS 1.3 client configuration: enrolled\n312|// roots only, no session cache, the exact ALPN, and the destination SAN as\n313|// server name. The supplement runs inside VerifyConnection.\n314|func ClientTLS(certificate tls.Certificate, pool *x509.CertPool, serverName string, verify VerifyFunc) *tls.Config {\n315|\tconfig := baseTLS()\n316|\tconfig.Certificates = []tls.Certificate{certificate}\n317|\tconfig.RootCAs = pool\n318|\tconfig.ServerName = serverName\n319|\tconfig.ClientSessionCache = nil\n320|\tconfig.VerifyConnection = verify\n321|\treturn config\n322|}\n323|\n324|// ServerTLS builds the responder TLS 1.3 server configuration: enrolled\n325|// roots only, mandatory verified client certificates, no session tickets,\n326|// the exact ALPN, and the supplement inside VerifyConnection.\n327|func ServerTLS(certificate tls.Certificate, pool *x509.CertPool, verify VerifyFunc) *tls.Config {\n328|\tconfig := baseTLS()\n329|\tconfig.Certificates = []tls.Certificate{certificate}\n330|\tconfig.ClientAuth = tls.RequireAndVerifyClientCert\n331|\tconfig.ClientCAs = pool\n332|\tconfig.SessionTicketsDisabled = true\n333|\tconfig.VerifyConnection = verify\n334|\treturn config\n335|}\n336|\n337|// HandshakeLimiter caps incoming handshake bytes while armed. The channel\n338|// disarms it immediately after local handshake success, so application\n339|// records never count against the handshake budget.\n340|type HandshakeLimiter struct {\n341|\treader io.Reader\n342|\tcount  int64\n343|\tarmed  atomic.Bool\n344|\texceed atomic.Bool\n345|\tlimit  int64\n346|}\n347|\n348|// NewHandshakeLimiter arms a 1 MiB incoming cap over the handshake stream.\n349|func NewHandshakeLimiter(reader io.Reader) *HandshakeLimiter {\n350|\tlimiter := &HandshakeLimiter{reader: reader, limit: MaxHandshakeBytes}\n351|\tlimiter.armed.Store(true)\n352|\treturn limiter\n353|}\n354|\n355|// Disarm ends handshake byte accounting after local handshake success.\n356|func (limiter *HandshakeLimiter) Disarm() { limiter.armed.Store(false) }\n357|\n358|// Exceeded reports whether the cap fired.\n359|func (limiter *HandshakeLimiter) Exceeded() bool { return limiter.exceed.Load() }\n360|\n361|func (limiter *HandshakeLimiter) Read(data []byte) (int, error) {\n362|\tn, err := limiter.reader.Read(data)\n363|\tif !limiter.armed.Load() {\n364|\t\treturn n, err\n365|\t}\n366|\tlimiter.count += int64(n)\n367|\tif limiter.count > limiter.limit {\n368|\t\tlimiter.exceed.Store(true)\n369|\t\treturn n, fmt.Errorf(\"%w: handshake byte cap exceeded\", ErrTransportFailure)\n370|\t}\n371|\treturn n, err\n372|}\n373|\n374|// streamConn adapts a Stream to the net.Conn shape crypto/tls requires.\n375|// Addresses are static pipe labels; deadlines are unsupported because the\n376|// channel enforces its bounds by closing the stream.\n377|type streamConn struct {\n378|\tStream\n379|}\n380|\n381|type pipeAddr string\n382|\n383|func (addr pipeAddr) Network() string { return \"pipe\" }\n384|func (addr pipeAddr) String() string  { return string(addr) }\n385|\n386|func (conn streamConn) LocalAddr() net.Addr  { return pipeAddr(\"local\") }\n387|func (conn streamConn) RemoteAddr() net.Addr { return pipeAddr(\"remote\") }\n388|func (conn streamConn) SetDeadline(_ time.Time) error {\n389|\treturn errors.New(\"host channel deadlines close the stream\")\n390|}\n391|func (conn streamConn) SetReadDeadline(_ time.Time) error {\n392|\treturn errors.New(\"host channel deadlines close the stream\")\n393|}\n394|func (conn streamConn) SetWriteDeadline(_ time.Time) error {\n395|\treturn errors.New(\"host channel deadlines close the stream\")\n396|}\n397|\n398|// RunHandshake completes the TLS handshake under a wall-clock deadline,\n399|// enforced by closing the stream even when the peer sends nothing. A fired\n400|// deadline, an exceeded byte cap, or a transport read failure maps to\n401|// ErrTransportFailure; every other handshake failure is peer\n402|// authentication. No application bytes may move before this returns nil.\n403|func RunHandshake(conn *tls.Conn, stream Stream, limiter *HandshakeLimiter, timeout time.Duration) error {\n404|\tdone := make(chan error, 1)\n405|\tgo func() { done <- conn.Handshake() }()\n406|\ttimer := time.NewTimer(timeout)\n407|\tdefer timer.Stop()\n408|\tselect {\n409|\tcase err := <-done:\n410|\t\tif err == nil {\n411|\t\t\treturn nil\n412|\t\t}\n413|\t\tif limiter != nil && limiter.Exceeded() {\n414|\t\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n415|\t\t}\n416|\t\treturn classifyHandshakeError(err)\n417|\tcase <-timer.C:\n418|\t\t_ = stream.Close()\n419|\t\terr := <-done\n420|\t\tif limiter != nil && limiter.Exceeded() {\n421|\t\t\treturn fmt.Errorf(\"%w: handshake deadline exceeded\", ErrTransportFailure)\n422|\t\t}\n423|\t\tif err == nil {\n424|\t\t\treturn fmt.Errorf(\"%w: handshake deadline exceeded\", ErrTransportFailure)\n425|\t\t}\n426|\t\treturn fmt.Errorf(\"%w: handshake deadline exceeded: %v\", ErrTransportFailure, classifyHandshakeError(err))\n427|\t}\n428|}\n429|\n430|func classifyHandshakeError(err error) error {\n431|\tif err == nil {\n432|\t\treturn nil\n433|\t}\n434|\tif errors.Is(err, ErrTransportFailure) {\n435|\t\treturn err\n436|\t}\n437|\t// A received TLS alert unwraps to an OpError whose Op is \"remote\n438|\t// error\": that is peer authentication, never transport I/O. Every\n439|\t// other OpError, a timeout, a closed conn, or an EOF variant is the\n440|\t// transport failing underneath the handshake.\n441|\tvar opErr *net.OpError\n442|\tif errors.As(err, &opErr) && opErr.Op != \"remote error\" {\n443|\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n444|\t}\n445|\tvar netErr net.Error\n446|\tif errors.As(err, &netErr) && netErr.Timeout() {\n447|\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n448|\t}\n449|\tif errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) || errors.Is(err, io.ErrClosedPipe) || errors.Is(err, net.ErrClosed) {\n450|\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n451|\t}\n452|\treturn fmt.Errorf(\"%w: %w\", ErrAuthenticationFailed, err)\n453|}\n454|\n455|// WriteLine sends one LF-terminated frame. The payload must already be a\n456|// single LF-free line within the wire bound; the check here is defensive.\n457|func WriteLine(writer io.Writer, line []byte) error {\n458|\tif len(line) == 0 || len(line) > rpcwire.MaxLineBytes || bytes.IndexByte(line, '\\n') >= 0 {\n459|\t\treturn ErrUnframeableInput\n460|\t}\n461|\tframe := make([]byte, 0, len(line)+1)\n462|\tframe = append(frame, line...)\n463|\tframe = append(frame, '\\n')\n464|\tif _, err := writer.Write(frame); err != nil {\n465|\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n466|\t}\n467|\treturn nil\n468|}\n469|\n470|// FrameReader decodes successive LF-terminated frames from one stream. It\n471|// must be the only reader on its stream: buffering may hold bytes past\n472|// the current frame. One FrameReader serves a whole connection.\n473|type FrameReader struct {\n474|\tbuffered *bufio.Reader\n475|}\n476|\n477|// NewFrameReader buffers one stream for successive frame reads.\n478|func NewFrameReader(reader io.Reader) *FrameReader {\n479|\treturn &FrameReader{buffered: bufio.NewReader(reader)}\n480|}\n481|\n482|// ReadLine reads one LF-terminated frame without the terminator. An\n483|// over-bound line or mid-line truncation is unframeable and must close\n484|// without a frame. A stream that ends with no frame bytes surfaces as\n485|// io.EOF for the transport mapping, including an abrupt end: zero bytes\n486|// is never a truncated frame.\n487|func (frames *FrameReader) ReadLine() ([]byte, error) {\n488|\tvar line []byte\n489|\tfor {\n490|\t\tchunk, err := frames.buffered.ReadSlice('\\n')\n491|\t\tif len(chunk) > 0 {\n492|\t\t\tif len(line)+len(chunk) > rpcwire.MaxLineBytes+1 {\n493|\t\t\t\treturn nil, ErrUnframeableInput\n494|\t\t\t}\n495|\t\t\tline = append(line, chunk...)\n496|\t\t}\n497|\t\tswitch {\n498|\t\tcase err == nil:\n499|\t\t\treturn line[:len(line)-1], nil\n500|\t\tcase errors.Is(err, bufio.ErrBufferFull):\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c493","stream":{"kind":"session","id":"01a0ae5d-13b2-70c2-be9d-d3c6350c7765"},"sequence":164,"recorded_at":1780531400000323,"record_type":"event","durability":"durable","causation_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","run_stream":{"kind":"run","id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28"},"call_id":"call_01a0ae5d921a70ab91cc40eac884d6be","text":"Read text file `internal/hostchannel/client.go`.\n1|package hostchannel\n2|\n3|import (\n4|\t\"crypto/tls\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"fmt\"\n8|\t\"time\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/hosttrust\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/rpcwire\"\n13|)\n14|\n15|// ClientConfig activates one initiator stream. ExpectedRemoteHostID is the\n16|// selected configured destination; the TLS server name and the hello\n17|// identity must both equal it. LocalHostID, LocalCredentialID, and\n18|// Allowlisted come from Configuration 4 like the server side. Zero\n19|// HandshakeTimeout, HelloTimeout, and RequestTimeout select the specified\n20|// defaults; nonzero values override them for tests. A nil Now selects the\n21|// UTC clock.\n22|type ClientConfig struct {\n23|\tStore                *hosttrust.Store\n24|\tCredential           tls.Certificate\n25|\tLocalHostID          string\n26|\tLocalCredentialID    string\n27|\tExpectedRemoteHostID string\n28|\tAllowlisted          []string\n29|\tPlatform             string\n30|\tAXVersion            string\n31|\tHandshakeTimeout     time.Duration\n32|\tHelloTimeout         time.Duration\n33|\tRequestTimeout       time.Duration\n34|\tNow                  func() time.Time\n35|}\n36|\n37|func (config ClientConfig) clock() func() time.Time {\n38|\tif config.Now != nil {\n39|\t\treturn config.Now\n40|\t}\n41|\treturn func() time.Time { return time.Now().UTC() }\n42|}\n43|\n44|func (config ClientConfig) handshakeTimeout() time.Duration {\n45|\tif config.HandshakeTimeout > 0 {\n46|\t\treturn config.HandshakeTimeout\n47|\t}\n48|\treturn DefaultHandshakeTimeout\n49|}\n50|\n51|func (config ClientConfig) helloTimeout() time.Duration {\n52|\tif config.HelloTimeout > 0 {\n53|\t\treturn config.HelloTimeout\n54|\t}\n55|\treturn DefaultHelloTimeout\n56|}\n57|\n58|func (config ClientConfig) requestTimeout() time.Duration {\n59|\tif config.RequestTimeout > 0 {\n60|\t\treturn config.RequestTimeout\n61|\t}\n62|\treturn DefaultRequestTimeout\n63|}\n64|\n65|// Client is one mutually authenticated initiator stream past hello\n66|// success. Calls recheck the current authorization generation before\n67|// sending; a moved generation refuses without transmitting.\n68|type Client struct {\n69|\tconn     *tls.Conn\n70|\tstream   Stream\n71|\tframes   *FrameReader\n72|\tstore    *hosttrust.Store\n73|\tbinding  Binding\n74|\tallow    []string\n75|\texpected string\n76|\ttimeout  time.Duration\n77|\tnow      func() time.Time\n78|}\n79|\n80|// Dial opens the initiator side over one stream: mutual TLS 1.3 against\n81|// the destination SAN, one hello, and current-generation authorization.\n82|// The hello success is validated before Dial returns; no other operation\n83|// moves first.\n84|func Dial(stream Stream, config ClientConfig) (*Client, error) {\n85|\tif stream == nil || config.Store == nil {\n86|\t\t_ = closeQuietly(stream)\n87|\t\treturn nil, ErrInvalidConfig\n88|\t}\n89|\tserverName, err := ServerName(config.ExpectedRemoteHostID)\n90|\tif err != nil {\n91|\t\t_ = closeQuietly(stream)\n92|\t\treturn nil, err\n93|\t}\n94|\tnow := config.clock()\n95|\tcurrent := now()\n96|\tsnapshot, err := config.Store.ReadSnapshot()\n97|\tif err != nil {\n98|\t\t_ = closeQuietly(stream)\n99|\t\treturn nil, fmt.Errorf(\"%w: trust snapshot unreadable: %v\", ErrInvalidConfig, err)\n100|\t}\n101|\tif err := checkLocalCredential(snapshot, config.Credential, config.LocalHostID, config.LocalCredentialID, current); err != nil {\n102|\t\t_ = closeQuietly(stream)\n103|\t\treturn nil, err\n104|\t}\n105|\tpool, err := EnrollmentPool(snapshot, current)\n106|\tif err != nil {\n107|\t\t_ = closeQuietly(stream)\n108|\t\treturn nil, err\n109|\t}\n110|\tif err := validateHelloTemplate(config.LocalHostID, config.Platform, config.AXVersion); err != nil {\n111|\t\t_ = closeQuietly(stream)\n112|\t\treturn nil, err\n113|\t}\n114|\tverify, verified := VerifyPeer(snapshot, current)\n115|\tlimiter := NewHandshakeLimiter(stream)\n116|\tconn := tls.Client(streamConn{Stream: cappedStream{Stream: stream, limiter: limiter}}, ClientTLS(config.Credential, pool, serverName, verify))\n117|\tif err := RunHandshake(conn, stream, limiter, config.handshakeTimeout()); err != nil {\n118|\t\t_ = stream.Close()\n119|\t\treturn nil, err\n120|\t}\n121|\tlimiter.Disarm()\n122|\n123|\tbody, err := helloBody(config.LocalHostID, config.Platform, config.AXVersion, rpcwire.NewNonce(), \"\")\n124|\tif err != nil {\n125|\t\t_ = stream.Close()\n126|\t\treturn nil, fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n127|\t}\n128|\trequestID, err := NewRequestID()\n129|\tif err != nil {\n130|\t\t_ = stream.Close()\n131|\t\treturn nil, err\n132|\t}\n133|\tline, err := rpcwire.EncodeRequest(ProtocolVersion, requestID, \"hello\", body)\n134|\tif err != nil {\n135|\t\t_ = stream.Close()\n136|\t\treturn nil, fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n137|\t}\n138|\trequest, err := rpcwire.DecodeRequest(line)\n139|\tif err != nil {\n140|\t\t_ = stream.Close()\n141|\t\treturn nil, fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n142|\t}\n143|\tframes := NewFrameReader(conn)\n144|\tif err := writeLineBounded(conn, stream, line, config.helloTimeout()); err != nil {\n145|\t\t_ = stream.Close()\n146|\t\treturn nil, err\n147|\t}\n148|\tresponseLine, err := readLineBounded(frames, stream, config.helloTimeout())\n149|\tif err != nil {\n150|\t\t_ = stream.Close()\n151|\t\treturn nil, err\n152|\t}\n153|\tresponse, err := rpcwire.DecodeResponse(responseLine, request)\n154|\tif err != nil {\n155|\t\t_ = stream.Close()\n156|\t\tif errors.Is(err, rpcwire.ErrVersion) || errors.Is(err, rpcwire.ErrFrame) {\n157|\t\t\treturn nil, fmt.Errorf(\"%w: peer hello reply is unframeable: %v\", ErrTransportFailure, err)\n158|\t\t}\n159|\t\treturn nil, fmt.Errorf(\"%w: %w\", ErrProtocol, err)\n160|\t}\n161|\tif !response.OK() {\n162|\t\t_ = stream.Close()\n163|\t\treturn nil, helloRefusal(response.Failure())\n164|\t}\n165|\thello, err := response.Hello()\n166|\tif err != nil {\n167|\t\t_ = stream.Close()\n168|\t\treturn nil, fmt.Errorf(\"%w: %w\", ErrProtocol, err)\n169|\t}\n170|\tfresh, err := config.Store.ReadSnapshot()\n171|\tif err != nil {\n172|\t\t_ = stream.Close()\n173|\t\treturn nil, fmt.Errorf(\"%w: generation read failed: %v\", ErrTransportFailure, err)\n174|\t}\n175|\tif fresh.Generation != snapshot.Generation {\n176|\t\t_ = stream.Close()\n177|\t\treturn nil, fmt.Errorf(\"authorization generation moved during hello: %w\", hosttrust.ErrStaleGeneration)\n178|\t}\n179|\tbinding := Binding{\n180|\t\tGeneration:         fresh.Generation,\n181|\t\tLocalHostID:        config.LocalHostID,\n182|\t\tLocalCredentialID:  config.LocalCredentialID,\n183|\t\tRemoteHostID:       verified.HostID,\n184|\t\tRemoteCredentialID: verified.CredentialID,\n185|\t\tHelloHostID:        hello.HostID,\n186|\t\tremoteLeafDER:      verified.leafDER,\n187|\t\tremoteRootDER:      verified.rootDER,\n188|\t}\n189|\tif err := config.Store.AuthorizeDispatch(fresh, binding.authRequest(config.Allowlisted, config.ExpectedRemoteHostID, now())); err != nil {\n190|\t\t_ = stream.Close()\n191|\t\treturn nil, fmt.Errorf(\"%w: %w\", ErrAuthenticationFailed, err)\n192|\t}\n193|\treturn &Client{\n194|\t\tconn:     conn,\n195|\t\tstream:   stream,\n196|\t\tframes:   frames,\n197|\t\tstore:    config.Store,\n198|\t\tbinding:  binding,\n199|\t\tallow:    append([]string(nil), config.Allowlisted...),\n200|\t\texpected: config.ExpectedRemoteHostID,\n201|\t\ttimeout:  config.requestTimeout(),\n202|\t\tnow:      now,\n203|\t}, nil\n204|}\n205|\n206|// helloRefusal maps a correlated hello failure frame to the initiator\n207|// error. Identity and allowlist refusals are authentication failures; a\n208|// contract refusal is a protocol mismatch.\n209|func helloRefusal(failure *axerror.Error) error {\n210|\tswitch failure.Code() {\n211|\tcase axerror.Code(\"host_identity_mismatch\"):\n212|\t\treturn fmt.Errorf(\"%w: peer refused hello identity\", hosttrust.ErrHostIdentityMismatch)\n213|\tcase axerror.Code(\"peer_not_allowlisted\"):\n214|\t\treturn fmt.Errorf(\"%w: peer is not allowlisted\", hosttrust.ErrNotAllowlisted)\n215|\tdefault:\n216|\t\treturn fmt.Errorf(\"%w: peer refused hello\", ErrProtocol)\n217|\t}\n218|}\n219|\n220|func closeQuietly(stream Stream) error {\n221|\tif stream == nil {\n222|\t\treturn nil\n223|\t}\n224|\treturn stream.Close()\n225|}\n226|\n227|// Binding reports the stream's authorization binding.\n228|func (client *Client) Binding() Binding { return client.binding }\n229|\n230|// PeerHostID reports the verified enrolled UUID of the responder.\n231|func (client *Client) PeerHostID() string { return client.binding.RemoteHostID }\n232|\n233|// ConnectionState exposes the negotiated TLS parameters for resumption\n234|// and version assertions.\n235|func (client *Client) ConnectionState() tls.ConnectionState { return client.conn.ConnectionState() }\n236|\n237|// Close ends the stream.\n238|func (client *Client) Close() error { return client.stream.Close() }\n239|\n240|// Call sends one post-hello request and returns the correlated response.\n241|// The current generation is rechecked before sending; a moved generation\n242|// refuses without transmitting. Framed failure responses return with a nil\n243|// error so the caller inspects the exact Error class and exit status. A\n244|// failed Call closes the stream: the exchange cannot resume mid-frame.\n245|func (client *Client) Call(operation string, body json.RawMessage) (rpcwire.Response, error) {\n246|\tfresh, err := client.store.ReadSnapshot()\n247|\tif err != nil {\n248|\t\treturn rpcwire.Response{}, fmt.Errorf(\"%w: generation read failed: %v\", ErrTransportFailure, err)\n249|\t}\n250|\tif fresh.Generation != client.binding.Generation {\n251|\t\treturn rpcwire.Response{}, fmt.Errorf(\"authorization generation moved: %w\", hosttrust.ErrStaleGeneration)\n252|\t}\n253|\trequestID, err := NewRequestID()\n254|\tif err != nil {\n255|\t\treturn rpcwire.Response{}, err\n256|\t}\n257|\tline, err := rpcwire.EncodeRequest(ProtocolVersion, requestID, operation, body)\n258|\tif err != nil {\n259|\t\treturn rpcwire.Response{}, err\n260|\t}\n261|\trequest, err := rpcwire.DecodeRequest(line)\n262|\tif err != nil {\n263|\t\treturn rpcwire.Response{}, err\n264|\t}\n265|\tif err := writeLineBounded(client.conn, client.stream, line, client.timeout); err != nil {\n266|\t\t_ = client.stream.Close()\n267|\t\treturn rpcwire.Response{}, err\n268|\t}\n269|\tresponseLine, err := readLineBounded(client.frames, client.stream, client.timeout)\n270|\tif err != nil {\n271|\t\t_ = client.stream.Close()\n272|\t\treturn rpcwire.Response{}, err\n273|\t}\n274|\tresponse, err := rpcwire.DecodeResponse(responseLine, request)\n275|\tif err != nil {\n276|\t\tif errors.Is(err, rpcwire.ErrVersion) || errors.Is(err, rpcwire.ErrFrame) {\n277|\t\t\treturn rpcwire.Response{}, fmt.Errorf(\"%w: peer reply is unframeable: %v\", ErrTransportFailure, err)\n278|\t\t}\n279|\t\treturn rpcwire.Response{}, fmt.Errorf(\"%w: %w\", ErrProtocol, err)\n280|\t}\n281|\treturn response, nil\n282|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
