idConfig)\n33|\t}\n34|\tif loaded.SourceVersion != config.Version4 {\n35|\t\treturn nil, fmt.Errorf(\"%w: host channel requires Configuration 4\", ErrInvalidConfig)\n36|\t}\n37|\tif loaded.Value.Mesh.HostChannel == nil {\n38|\t\treturn nil, fmt.Errorf(\"%w: Configuration 4 carries no host-channel binding\", ErrInvalidConfig)\n39|\t}\n40|\tdirectory, err := peeridentity.FromSnapshot(snapshot)\n41|\tif err != nil {\n42|\t\treturn nil, err\n43|\t}\n44|\ttarget, err := directory.Resolve(selector)\n45|\tif err != nil {\n46|\t\treturn nil, err\n47|\t}\n48|\treturn LaunchArgv(target)\n49|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5b3","stream":{"kind":"session","id":"01a0ae5d-13b2-70c2-be9d-d3c6350c7765"},"sequence":308,"recorded_at":1780531400000611,"record_type":"event","durability":"durable","causation_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","run_stream":{"kind":"run","id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28"},"call_id":"call_01a0ae5e175f705bbcdf34f61c9c2698","text":"Read text file `internal/hostchannel/verify_test.go`.\n1|package hostchannel_test\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"crypto/tls\"\n6|\t\"crypto/x509\"\n7|\t\"errors\"\n8|\t\"testing\"\n9|\t\"time\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/hostchannel\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/hosttrust\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|)\n15|\n16|// verifyEntry builds one enrolled entry from issued material through public\n17|// entries only. Flip selectors corrupt a single member for isolation.\n18|func verifyEntry(t *testing.T, issued hosttrust.IssuedCredential, state string, enrolledAt time.Time, retireAt *time.Time) hosttrust.CredentialEntry {\n19|\tt.Helper()\n20|\tleaf, err := x509.ParseCertificate(issued.LeafDER)\n21|\tif err != nil {\n22|\t\tt.Fatalf(\"parse leaf: %v\", err)\n23|\t}\n24|\tstamp, err := scalar.ParseTimestamp(enrolledAt.UTC().Format(\"2006-01-02T15:04:05.000Z\"))\n25|\tif err != nil {\n26|\t\tt.Fatalf(\"ParseTimestamp: %v\", err)\n27|\t}\n28|\tvar retireStamp *scalar.Timestamp\n29|\tif retireAt != nil {\n30|\t\tparsed, err := scalar.ParseTimestamp(retireAt.UTC().Format(\"2006-01-02T15:04:05.000Z\"))\n31|\t\tif err != nil {\n32|\t\t\tt.Fatalf(\"ParseTimestamp: %v\", err)\n33|\t\t}\n34|\t\tretireStamp = &parsed\n35|\t}\n36|\treturn hosttrust.CredentialEntry{\n37|\t\tHostID:       issued.HostID,\n38|\t\tCredentialID: scalar.SHA256Digest(issued.LeafDER),\n39|\t\tSPKIID:       scalar.SHA256Digest(leaf.RawSubjectPublicKeyInfo),\n40|\t\tRootID:       scalar.SHA256Digest(issued.RootDER),\n41|\t\tLeafDER:      bytes.Clone(issued.LeafDER),\n42|\t\tRootDER:      bytes.Clone(issued.RootDER),\n43|\t\tState:        state,\n44|\t\tEnrolledAt:   stamp,\n45|\t\tRetireAt:     retireStamp,\n46|\t}\n47|}\n48|\n49|func verifySnapshot(entries ...hosttrust.CredentialEntry) hosttrust.Snapshot {\n50|\treturn hosttrust.Snapshot{\n51|\t\tGeneration: 7,\n52|\t\tTrust:      hosttrust.TrustStore{Generation: 7, Entries: entries},\n53|\t}\n54|}\n55|\n56|func verifyState(t *testing.T, leafDER, rootDER []byte) tls.ConnectionState {\n57|\tt.Helper()\n58|\tleaf, err := x509.ParseCertificate(leafDER)\n59|\tif err != nil {\n60|\t\tt.Fatalf(\"parse leaf: %v\", err)\n61|\t}\n62|\troot, err := x509.ParseCertificate(rootDER)\n63|\tif err != nil {\n64|\t\tt.Fatalf(\"parse root: %v\", err)\n65|\t}\n66|\treturn tls.ConnectionState{\n67|\t\tVersion:            tls.VersionTLS13,\n68|\t\tNegotiatedProtocol: \"ax-host/1\",\n69|\t\tPeerCertificates:   []*x509.Certificate{leaf},\n70|\t\tVerifiedChains:     [][]*x509.Certificate{{leaf, root}},\n71|\t}\n72|}\n73|\n74|func TestVerifyPeerAdmitsEnrolled(t *testing.T) {\n75|\tnow := time.Now().UTC()\n76|\tissued, err := hosttrust.IssueCredential(hostA, now, nil)\n77|\tif err != nil {\n78|\t\tt.Fatalf(\"IssueCredential: %v\", err)\n79|\t}\n80|\tsnapshot := verifySnapshot(verifyEntry(t, issued, hosttrust.EntryActive, now, nil))\n81|\tverify, verified := hostchannel.VerifyPeer(snapshot, now)\n82|\tif err := verify(verifyState(t, issued.LeafDER, issued.RootDER)); err != nil {\n83|\t\tt.Fatalf(\"VerifyPeer: %v\", err)\n84|\t}\n85|\tif verified.HostID != hostA {\n86|\t\tt.Fatalf(\"verified host = %q\", verified.HostID)\n87|\t}\n88|\tif verified.CredentialID != scalar.SHA256Digest(issued.LeafDER).String() {\n89|\t\tt.Fatalf(\"verified credential = %q\", verified.CredentialID)\n90|\t}\n91|}\n92|\n93|func TestVerifyPeerRefusals(t *testing.T) {\n94|\tnow := time.Now().UTC()\n95|\tissued, err := hosttrust.IssueCredential(hostA, now, nil)\n96|\tif err != nil {\n97|\t\tt.Fatalf(\"IssueCredential: %v\", err)\n98|\t}\n99|\tattacker, err := hosttrust.IssueCredential(hostC, now, nil)\n100|\tif err != nil {\n101|\t\tt.Fatalf(\"IssueCredential: %v\", err)\n102|\t}\n103|\taged, err := hosttrust.IssueCredential(hostC, now.Add(-100*24*time.Hour), nil)\n104|\tif err != nil {\n105|\t\tt.Fatalf(\"IssueCredential: %v\", err)\n106|\t}\n107|\tentry := verifyEntry(t, issued, hosttrust.EntryActive, now, nil)\n108|\tzeroSPKI := \"sha256:\" + string(bytes.Repeat([]byte(\"0\"), 64))\n109|\n110|\tcases := []struct {\n111|\t\tname     string\n112|\t\tsnapshot hosttrust.Snapshot\n113|\t\tstate    func() tls.ConnectionState\n114|\t\twant     error\n115|\t}{\n116|\t\t{\"alpn\", verifySnapshot(entry), func() tls.ConnectionState {\n117|\t\t\tstate := verifyState(t, issued.LeafDER, issued.RootDER)\n118|\t\t\tstate.NegotiatedProtocol = \"rogue-alpn\"\n119|\t\t\treturn state\n120|\t\t}, hostchannel.ErrALPNMismatch},\n121|\t\t{\"missing-alpn\", verifySnapshot(entry), func() tls.ConnectionState {\n122|\t\t\tstate := verifyState(t, issued.LeafDER, issued.RootDER)\n123|\t\t\tstate.NegotiatedProtocol = \"\"\n124|\t\t\treturn state\n125|\t\t}, hostchannel.ErrALPNMismatch},\n126|\t\t{\"resumed\", verifySnapshot(entry), func() tls.ConnectionState {\n127|\t\t\tstate := verifyState(t, issued.LeafDER, issued.RootDER)\n128|\t\t\tstate.DidResume = true\n129|\t\t\treturn state\n130|\t\t}, hostchannel.ErrUnexpectedResume},\n131|\t\t{\"no-chains\", verifySnapshot(entry), func() tls.ConnectionState {\n132|\t\t\tstate := verifyState(t, issued.LeafDER, issued.RootDER)\n133|\t\t\tstate.VerifiedChains = nil\n134|\t\t\treturn state\n135|\t\t}, hostchannel.ErrUnverifiedChain},\n136|\t\t{\"no-certificates\", verifySnapshot(entry), func() tls.ConnectionState {\n137|\t\t\tstate := verifyState(t, issued.LeafDER, issued.RootDER)\n138|\t\t\tstate.VerifiedChains = nil\n139|\t\t\tstate.PeerCertificates = nil\n140|\t\t\treturn state\n141|\t\t}, hostchannel.ErrUnverifiedChain},\n142|\t\t{\"unknown-leaf\", verifySnapshot(entry), func() tls.ConnectionState {\n143|\t\t\treturn verifyState(t, attacker.LeafDER, attacker.RootDER)\n144|\t\t}, hostchannel.ErrNoEnrolledMatch},\n145|\t\t{\"double-match\", verifySnapshot(entry, func() hosttrust.CredentialEntry {\n146|\t\t\tclone := entry\n147|\t\t\tparsed, err := scalar.ParseUUIDv7(hostC)\n148|\t\t\tif err != nil {\n149|\t\t\t\tt.Fatalf(\"ParseUUIDv7: %v\", err)\n150|\t\t\t}\n151|\t\t\tclone.HostID = parsed\n152|\t\t\treturn clone\n153|\t\t}()), func() tls.ConnectionState {\n154|\t\t\treturn verifyState(t, issued.LeafDER, issued.RootDER)\n155|\t\t}, hostchannel.ErrNoEnrolledMatch},\n156|\t\t{\"leaf-flipped\", verifySnapshot(func() hosttrust.CredentialEntry {\n157|\t\t\tclone := entry\n158|\t\t\tclone.LeafDER = bytes.Clone(entry.LeafDER)\n159|\t\t\tclone.LeafDER[len(clone.LeafDER)-1] ^= 0x01\n160|\t\t\treturn clone\n161|\t\t}()), func() tls.ConnectionState {\n162|\t\t\treturn verifyState(t, issued.LeafDER, issued.RootDER)\n163|\t\t}, hostchannel.ErrNoEnrolledMatch},\n164|\t\t{\"root-flipped\", verifySnapshot(func() hosttrust.CredentialEntry {\n165|\t\t\tclone := entry\n166|\t\t\tclone.RootDER = bytes.Clone(entry.RootDER)\n167|\t\t\tclone.RootDER[len(clone.RootDER)-1] ^= 0x01\n168|\t\t\treturn clone\n169|\t\t}()), func() tls.ConnectionState {\n170|\t\t\treturn verifyState(t, issued.LeafDER, issued.RootDER)\n171|\t\t}, hostchannel.ErrNoEnrolledMatch},\n172|\t\t{\"spki-zero\", verifySnapshot(func() hosttrust.CredentialEntry {\n173|\t\t\tclone := entry\n174|\t\t\tdigest, err := scalar.ParseDigest(zeroSPKI)\n175|\t\t\tif err != nil {\n176|\t\t\t\tt.Fatalf(\"ParseDigest: %v\", err)\n177|\t\t\t}\n178|\t\t\tclone.SPKIID = digest\n179|\t\t\treturn clone\n180|\t\t}()), func() tls.ConnectionState {\n181|\t\t\treturn verifyState(t, issued.LeafDER, issued.RootDER)\n182|\t\t}, hostchannel.ErrNoEnrolledMatch},\n183|\t\t{\"revoked\", verifySnapshot(func() hosttrust.CredentialEntry {\n184|\t\t\tclone := entry\n185|\t\t\tclone.State = hosttrust.EntryRevoked\n186|\t\t\treturn clone\n187|\t\t}()), func() tls.ConnectionState {\n188|\t\t\treturn verifyState(t, issued.LeafDER, issued.RootDER)\n189|\t\t}, hostchannel.ErrPeerTrustState},\n190|\t\t{\"retiring-past\", verifySnapshot(func() hosttrust.CredentialEntry {\n191|\t\t\tpast := now.Add(-30 * time.Minute)\n192|\t\t\treturn verifyEntry(t, issued, hosttrust.EntryRetiring, now.Add(-time.Hour), &past)\n193|\t\t}()), func() tls.ConnectionState {\n194|\t\t\treturn verifyState(t, issued.LeafDER, issued.RootDER)\n195|\t\t}, hostchannel.ErrPeerTrustState},\n196|\t\t{\"retiring-nil\", verifySnapshot(func() hosttrust.CredentialEntry {\n197|\t\t\tclone := entry\n198|\t\t\tclone.State = hosttrust.EntryRetiring\n199|\t\t\tclone.RetireAt = nil\n200|\t\t\treturn clone\n201|\t\t}()), func() tls.ConnectionState {\n202|\t\t\treturn verifyState(t, issued.LeafDER, issued.RootDER)\n203|\t\t}, hostchannel.ErrPeerTrustState},\n204|\t\t{\"expired\", verifySnapshot(verifyEntry(t, aged, hosttrust.EntryActive, now.Add(-100*24*time.Hour), nil)), func() tls.ConnectionState {\n205|\t\t\treturn verifyState(t, aged.LeafDER, aged.RootDER)\n206|\t\t}, hostchannel.ErrPeerProfile},\n207|\t}\n208|\tfor _, tc := range cases {\n209|\t\tt.Run(tc.name, func(t *testing.T) {\n210|\t\t\tverify, _ := hostchannel.VerifyPeer(tc.snapshot, now)\n211|\t\t\tif err := verify(tc.state()); !errors.Is(err, tc.want) {\n212|\t\t\t\tt.Fatalf(\"VerifyPeer = %v, want %v\", err, tc.want)\n213|\t\t\t}\n214|\t\t})\n215|\t}\n216|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5b5","stream":{"kind":"session","id":"01a0ae5d-13b2-70c2-be9d-d3c6350c7765"},"sequence":309,"recorded_at":1780531400000613,"record_type":"event","durability":"durable","causation_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","run_stream":{"kind":"run","id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28"},"call_id":"call_01a0ae5e18f972188a316d6bcd5abc70","text":"Read text file `internal/hostchannel/mutations.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Host-channel gate overlays. Every kill requires a named behavioral failure.\n3|\n4|Each probe applies one or more exact-once edits to a pristine source file,\n5|then runs the FULL behavioral suite (never a static checker alone) under a\n6|go overlay; the sources on disk are never modified.\n7|\"\"\"\n8|import argparse\n9|import json\n10|from pathlib import Path\n11|import subprocess\n12|import sys\n13|ROOT = Path(__file__).resolve().parents[2]\n14|TESTS = \"Test\"\n15|C = \"internal/hostchannel/channel.go\"\n16|S = \"internal/hostchannel/server.go\"\n17|CL = \"internal/hostchannel/client.go\"\n18|PROBES = []\n19|BOUNDS = {\n20|    'client-cache': 'One-sided weakening is harmless: a caching client cannot resume against a server that issues no tickets, so the resumption suite still passes.',\n21|}\n22|def probe(name, path, edits, narrows, expected_test):\n23|    PROBES.append((name, path, edits, narrows, expected_test))\n24|def one(old, new):\n25|    return [(old, new)]\n26|\n27|ZSPKI = \"sha256:\" + \"0\" * 64\n28|probe('neutral', C, one('total := 2', 'total := 1 + 1'), 'Equivalent authority size', None)\n29|probe('known-bad', C, one('return parsed.String() + HostSuffix', 'return \"x-\" + parsed.String() + HostSuffix'), 'Wrong server name', 'TestServerNameMatchesIssuedLeaf')\n30|probe('alpn-supplement', C, one('if state.NegotiatedProtocol != ALPN {', 'if state.NegotiatedProtocol != ALPN && state.NegotiatedProtocol != \"rogue-alpn\" {'), 'Admits exactly rogue-alpn', 'TestVerifyPeerRefusals/alpn')\n31|probe('didresume', C, one('if state.DidResume {', 'if state.DidResume && len(state.VerifiedChains) == 0 {'), 'Admits resumed connections with chains', 'TestVerifyPeerRefusals/resumed')\n32|probe('chains', C, one('if len(state.VerifiedChains) == 0 || len(state.PeerCertificates) == 0 {', 'if len(state.VerifiedChains) == 0 && len(state.PeerCertificates) == 0 {'), 'Admits empty chains with a presented peer certificate', 'TestVerifyPeerRefusals/no-chains')\n33|probe('match-leaf', C, one('if !bytes.Equal(entry.LeafDER, leaf.Raw) {', 'if !bytes.HasPrefix(leaf.Raw, entry.LeafDER[:len(entry.LeafDER)-1]) {'), 'Admits a leaf differing only in its last byte', 'TestVerifyPeerRefusals/leaf-flipped')\n34|probe('match-root', C, one('if !bytes.Equal(entry.RootDER, root.Raw) {', 'if !bytes.HasPrefix(root.Raw, entry.RootDER[:len(entry.RootDER)-1]) {'), 'Admits a root differing only in its last byte', 'TestVerifyPeerRefusals/root-flipped')\n35|probe('match-spki', C, one('if entry.SPKIID.String() != spki {', 'if entry.SPKIID.String() != spki && entry.SPKIID.String() != \"%s\" {' % ZSPKI), 'Admits exactly the zero SPKI', 'TestVerifyPeerRefusals/spki-zero')\n36|probe('match-count', C, one('if len(matched) != 1 {', 'if len(matched) != 1 && len(matched) != 2 {'), 'Admits exactly a double match', 'TestVerifyPeerRefusals/double-match')\n37|probe('state-revoked', C, one('\\t\\tdefault:\\n\\t\\t\\treturn ErrPeerTrustState', '\\t\\tcase hosttrust.EntryRevoked:\\n\\t\\tdefault:\\n\\t\\t\\treturn ErrPeerTrustState'), 'Admits revoked entries while refusing other states', 'TestVerifyPeerRefusals/revoked')\n38|probe('state-retiring', C, one('if err != nil || !now.Before(retireAt) {', 'if err != nil || !now.Before(retireAt.Add(time.Hour)) {'), 'Admits entries up to one hour past retire_at', 'TestVerifyPeerRefusals/retiring-past')\n39|probe('profile', C, one('if err := hosttrust.VerifyProfile(entry.LeafDER, entry.RootDER, entry.HostID.String(), now); err != nil {\\n\\t\\t\\treturn fmt.Errorf(\"%w: %w\", ErrPeerProfile, err)', 'if err := hosttrust.VerifyProfile(entry.LeafDER, entry.RootDER, entry.HostID.String(), now); err != nil && entry.State != hosttrust.EntryActive {\\n\\t\\t\\treturn fmt.Errorf(\"%w: %w\", ErrPeerProfile, err)'), 'Admits profile-invalid active entries', 'TestVerifyPeerRefusals/expired')\n40|probe('hello-id-server', S, one('\\t\\tHelloHostID:        hello.HostID,\\n\\t\\tremoteLeafDER:      peerLeaf,', '\\t\\tHelloHostID:        peerHost,\\n\\t\\tremoteLeafDER:      peerLeaf,'), 'Substitutes the verified UUID for the received hello ID', 'TestRefusesHelloUUIDMismatch')\n41|probe('hello-id-client', CL, [\n42|    ('\\t\\tHelloHostID:        hello.HostID,\\n\\t\\tremoteLeafDER:      verified.leafDER,', '\\t\\tHelloHostID:        config.ExpectedRemoteHostID,\\n\\t\\tremoteLeafDER:      verified.leafDER,'),\n43|    ('\\thello, err := response.Hello()\\n\\tif err != nil {', '\\thello, err := response.Hello()\\n\\t_ = hello\\n\\tif err != nil {'),\n44|], 'Substitutes the expected destination for the received hello ID', 'TestRefusesServerHelloUUIDMismatch')\n45|probe('non-hello', S, one('if request.Operation() != \"hello\" {', 'if request.Operation() != \"hello\" && request.Operation() != \"health.get\" {'), 'Admits health.get before hello', 'TestRefusesNonHelloBeforeHello')\n46|probe('stale-dispatch', S, one('if fresh.Generation != binding.Generation {', 'if fresh.Generation != binding.Generation && fresh.Generation != binding.Generation+1 {'), 'Admits exactly one generation past the binding', 'TestStaleGenerationAtDispatch/server_closes')\n47|probe('stale-mutation', S, one('return config.Store.WithMutationAuthorization(binding.authRequest(config.Allowlisted, binding.RemoteHostID, now()), boundary)', 'fresh, freshErr := config.Store.ReadSnapshot()\\n\\t\\t\\tif freshErr != nil {\\n\\t\\t\\t\\treturn freshErr\\n\\t\\t\\t}\\n\\t\\t\\trebound := binding\\n\\t\\t\\trebound.Generation = fresh.Generation\\n\\t\\t\\treturn config.Store.WithMutationAuthorization(rebound.authRequest(config.Allowlisted, binding.RemoteHostID, now()), boundary)'), 'Refreshes the stale binding to the current generation before the boundary', 'TestStaleGenerationAtMutation')\n48|probe('handshake-cap', C, one('if limiter.count > limiter.limit {', 'if limiter.count > limiter.limit+1 {'), 'Admits exactly cap+1 handshake bytes', 'TestHandshakeLimiterBounds')\n49|probe('ca-bound', C, one('return total > MaxAuthorityBytes', 'return total > MaxAuthorityBytes+1'), 'Admits exactly a 65536-byte authority list', 'TestAuthorityListOverflow')\n50|probe('tls-min', C, one('MinVersion:         tls.VersionTLS13,', 'MinVersion:         tls.VersionTLS12,'), 'Admits TLS 1.2 in both roles', 'TestRefusesTLS12Offer/server')\n51|probe('tls-min-client', C, one('MinVersion:         tls.VersionTLS13,', 'MinVersion:         tls.VersionTLS12,'), 'Admits TLS 1.2 in both roles', 'TestRefusesTLS12Offer/client')\n52|probe('tickets', C, one('config.SessionTicketsDisabled = true', 'config.SessionTicketsDisabled = false'), 'Issues session tickets for resumption', 'TestRefusesResumption')\n53|probe('client-cache', C, one('config.ClientSessionCache = nil', 'config.ClientSessionCache = tls.NewLRUClientSessionCache(1)'), 'Caches client sessions while the server issues no tickets', None)\n54|probe('census-evasion', S, [\n55|    ('\\t\"errors\"\\n\\t\"fmt\"\\n\\t\"time\"', '\\t\"errors\"\\n\\t\"fmt\"\\n\\t\"os\"\\n\\t\"syscall\"\\n\\t\"time\"'),\n56|    ('\\treturn serveLoop(frames, stream, conn, config, binding)',\n57|     '\\tfd, _ := syscall.Open(os.TempDir()+\"/hc-evict\", syscall.O_CREAT|syscall.O_WRONLY, 0600)\\n\\tsyscall.Write(fd, []byte(\"x\"))\\n\\tsyscall.Close(fd)\\n\\treturn serveLoop(frames, stream, conn, config, binding)'),\n58|], 'Writes a temp file through tokens the static census does not list', 'TestRuntimeWriteCensus')\n59|\n60|def main():\n61|    parser = argparse.ArgumentParser(description=__doc__)\n62|    parser.add_argument(\"--output\", required=True)\n63|    parser.add_argument(\"--only\", help=\"Comma-separated probe names for a bounded follow-up\")\n64|    opts = parser.parse_args()\n65|    if opts.only and not set(opts.only.split(\",\")).issubset({p[0] for p in PROBES}):\n66|        parser.error(\"--only contains an unknown probe\")\n67|    out = Path(opts.output).resolve()\n68|    out.mkdir(parents=True, exist_ok=True)\n69|    results = []\n70|    unexpected = False\n71|    for name, path, edits, narrows, expected_test in PROBES:\n72|        if opts.only and name not in opts.only.split(\",\"):\n73|            continue\n74|        source = ROOT / path\n75|        original = source.read_bytes()\n76|        text = original.decode()\n77|        mutated = text\n78|        for old, new in edits:\n79|            if mutated.count(old) != 1:\n80|                raise RuntimeError(f\"{name}: plant must match exactly once, got {mutated.count(old)}\")\n81|            mutated = mutated.replace(old, new, 1)\n82|        folder = out / name\n83|        folder.mkdir(exist_ok=True)\n84|        replacement = folder / source.name\n85|        replacement.write_text(mutated)\n86|        overlay = folder / \"overlay.json\"\n87|        overlay.write_text(json.dumps({\"Replace\": {str(source): str(replacement)}}))\n88|        command = [\"go\", \"test\", \"-overlay\", str(overlay), \"./internal/hostchannel\", \"-count=1\", \"-json\", \"-timeout=300s\", \"-run\", TESTS]\n89|        proc = subprocess.run(command, cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=420)\n90|        (folder / \"test.log\").write_bytes(proc.stdout)\n91|        events = []\n92|        for line in proc.stdout.decode(errors=\"replace\").splitlines():\n93|            try:\n94|                events.append(json.loads(line))\n95|            except json.JSONDecodeError:\n96|                pass\n97|        failed = [e[\"Test\"] for e in events if e.get(\"Action\") == \"fail\" and \"Test\" in e]\n98|        passed = [e[\"Test\"] for e in events if e.get(\"Action\") == \"pass\" and \"Test\" in e]\n99|        killed = proc.returncode != 0 and bool(failed) and (expected_test is None or expected_test in failed)\n100|        if name == \"neutral\":\n101|            valid = proc.returncode == 0 and bool(passed)\n102|            state = \"neutral passed\" if valid else \"invalid control\"\n103|        elif name in BOUNDS:\n104|            valid = proc.returncode == 0 and bool(passed)\n105|            state = \"survived\" if valid else \"unexpected result\"\n106|        else:\n107|            valid = killed\n108|            state = \"killed\" if killed else \"survived\" if proc.returncode == 0 and passed else \"invalid instrument/compile failure\"\n109|        if not valid:\n110|            unexpected = True\n111|        if source.read_bytes() != original:\n112|            raise RuntimeError(f\"{name}: source changed during overlay run\")\n113|        row = {\"mutant\": name, \"narrowing\": narrows, \"exit_code\": proc.returncode, \"result\": state,\n114|               \"named_failing_tests\": failed, \"expected_test\": expected_test,\n115|               \"bound\": BOUNDS.get(name, \"\" if killed or name == \"neutral\" else \"No named failing test established; this gate member is unproven.\"),\n116|               \"command\": command}\n117|        results.append(row)\n118|        print(f\"{name}: {state}, exit={proc.returncode}, tests={','.join(failed)}\", flush=True)\n119|        (out / \"results.json\").write_text(json.dumps(results, indent=2) + \"\\n\")\n120|    rows = [\"| Mutant | What the gate is narrowed to admit | Named failing test | Exit | Result / surviving bound |\",\n121|            \"| --- | --- | --- | ---: | --- |\"]\n122|    for r in results:\n123|        tests = r[\"expected_test\"] if r[\"expected_test\"] in r[\"named_failing_tests\"] else \", \".join(r[\"named_failing_tests\"])\n124|        rows.append(f'| {r[\"mutant\"]} | {r[\"narrowing\"]} | {tests or \"none\"} | {r[\"exit_code\"]} | {r[\"result\"]}: {r[\"bound\"]} |')\n125|    (out / \"table.md\").write_text(\"\\n\".join(rows)+\"\\n\")\n126|    return int(unexpected)\n127|\n128|\n129|if __name__ == \"__main__\":\n130|    sys.exit(main())","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
