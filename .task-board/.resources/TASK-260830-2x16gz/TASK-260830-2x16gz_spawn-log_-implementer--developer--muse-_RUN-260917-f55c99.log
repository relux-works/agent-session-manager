{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8a9","stream":{"kind":"session","id":"01a0ae5d-13b2-70c2-be9d-d3c6350c7765"},"sequence":687,"recorded_at":1780531400001369,"record_type":"event","durability":"durable","causation_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","run_stream":{"kind":"run","id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28"},"task_stream":{"kind":"task","id":"01a0ae62-4ff4-7333-ae4c-fbaa293422d7"},"task_id":"01a0ae62-4ff4-7333-ae4c-fbaa293422d7","event":{"kind":"output","task_id":"01a0ae62-4ff4-7333-ae4c-fbaa293422d7","chunk":"{\n  \"chunk_id\": \"exec-17-1\",\n  \"command\": \"grep -n \\\"version\\\" internal/axerror/decode.go | head -20; echo ===; sed -n '1,60p' internal/hosttrust/rotate.go\",\n  \"description\": \"Check error version strictness and rotation\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"22:\\t// ErrVersionMismatch reports a supported version that is not the one the\\n24:\\tErrVersionMismatch = errors.New(\\\"structured error version differs from the bound version\\\")\\n27:// semverPattern accepts only a full, unpadded semantic version triple.\\n36:\\tSchemaVersion *string          `json:\\\"schema_version\\\"`\\n47:// version.\\n58:// code, retryable bit, details, or identifiers, so no part of a wrong-version\\n64:// version 1 object\\\", Section 17.1 scopes the same rule to \\\"within any\\n65:// negotiated major version\\\", and Section 17.2 lists \\\"rejects an unsupported\\n70:// Both orders refuse; only one of them tells the caller the version fact it\\n74:// that \\\"New error codes MAY be added in a compatible minor contract version\\\".\\n79:func Decode(version Version, data []byte) (*Error, error) {\\n80:\\tif !isRegisteredVersion(version) {\\n81:\\t\\treturn nil, fmt.Errorf(\\\"%w: %q\\\", ErrUnsupportedVersion, version)\\n90:\\tif err := verifyEnvelopeIdentity(identity, version); err != nil {\\n97:\\treturn decodeBody(version, document)\\n101:// version is resolved from the static binding table, never from the document,\\n102:// so a peer cannot select its own error version by writing one into the\\n105:\\tversion, err := BindingFor(contract)\\n109:\\treturn Decode(version, data)\\n194:// parseEnvelopeIdentity reads the schema and schema_version members without\\n===\\npackage hosttrust\\n\\nimport (\\n\\t\\\"crypto/x509\\\"\\n\\t\\\"encoding/pem\\\"\\n\\t\\\"errors\\\"\\n\\t\\\"path/filepath\\\"\\n\\t\\\"time\\\"\\n\\n\\t\\\"github.com/relux-works/agent-session-manager/internal/scalar\\\"\\n)\\n\\n// RotationBound is the maximum overlap of an old credential after the trust\\n// transition admits its replacement: 24 hours, and never past old leaf\\n// expiry. There is no overlap extension.\\nconst RotationBound = 24 * time.Hour\\n\\n// Rotate keeps the host UUID and creates a new credential with two fresh keys\\n// and certificates. The local atomic trust transition admits the new entry as\\n// active and marks the old entry retiring with a fixed retire_at no more than\\n// 24 hours after the transition and no later than old leaf expiry. No second\\n// rotation starts until the retiring entry is revoked. Failed enrollment\\n// leaves the new route unavailable, never auto-trusted.\\nfunc (store *Store) Rotate(hostID string, now time.Time) (newCredentialID string, retireAt time.Time, err error) {\\n\\tparsed, err := scalar.ParseUUIDv7(hostID)\\n\\tif err != nil {\\n\\t\\treturn \\\"\\\", time.Time{}, trustError(TrustError{Operation: \\\"rotate host\\\", Err: errors.Join(ErrRotationRefused, err)})\\n\\t}\\n\\tissued, err := IssueCredential(parsed.String(), now, nil)\\n\\tif err != nil {\\n\\t\\treturn \\\"\\\", time.Time{}, err\\n\\t}\\n\\tcredentialHex := scalar.SHA256Digest(issued.LeafDER).Hex()\\n\\tdirectory := filepath.Join(store.root, credentialsDir, credentialHex)\\n\\tif err := ensureOwnerDir(store.fs, directory, 0o700); err != nil {\\n\\t\\treturn \\\"\\\", time.Time{}, err\\n\\t}\\n\\tcommitted := false\\n\\tdefer cleanupCredentialDirectory(store.fs, directory, &committed)\\n\\tif err := writeCustodyFile(store, directory, certificateFile, pem.EncodeToMemory(&pem.Block{Type: \\\"CERTIFICATE\\\", Bytes: issued.LeafDER})); err != nil {\\n\\t\\treturn \\\"\\\", time.Time{}, err\\n\\t}\\n\\tif err := writeCustodyFile(store, directory, privateKeyFile, pem.EncodeToMemory(&pem.Block{Type: \\\"PRIVATE KEY\\\", Bytes: issued.LeafKeyDER})); err != nil {\\n\\t\\treturn \\\"\\\", time.Time{}, err\\n\\t}\\n\\tif err := writeCustodyFile(store, directory, rootFile, pem.EncodeToMemory(&pem.Block{Type: \\\"CERTIFICATE\\\", Bytes: issued.RootDER})); err != nil {\\n\\t\\treturn \\\"\\\", time.Time{}, err\\n\\t}\\n\\tenrolledAt, err := scalar.ParseTimestamp(now.UTC().Format(\\\"2006-01-02T15:04:05.000Z\\\"))\\n\\tif err != nil {\\n\\t\\treturn \\\"\\\", time.Time{}, trustError(TrustError{Operation: \\\"rotate timestamp\\\", Err: errors.Join(ErrRotationRefused, err)})\\n\\t}\\n\\tnewEntry := CredentialEntry{\\n\\t\\tHostID:       issued.HostID,\\n\\t\\tCredentialID: scalar.SHA256Digest(issued.LeafDER),\\n\\t\\tSPKIID:       scalar.SHA256Digest(mustSPKI(issued.LeafDER)),\\n\\t\\tRootID:       scalar.SHA256Digest(issued.RootDER),\\n\\t\\tLeafDER:      issued.LeafDER,\\n\\t\\tRootDER:      issued.RootDER,\\n\\t\\tState:        EntryActive,\\n\",\n  \"original_output_bytes\": 3992,\n  \"original_output_tokens\": 998,\n  \"truncated\": false\n}","final_result":true}}}
