{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d65b","stream":{"kind":"session","id":"01a0ae5d-13b2-70c2-be9d-d3c6350c7765"},"sequence":2440,"recorded_at":1780531400004875,"record_type":"event","durability":"durable","causation_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","run_stream":{"kind":"run","id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28"},"task_stream":{"kind":"task","id":"01a0ae7d-aaef-7f03-aa51-618504e1a0b8"},"task_id":"01a0ae7d-aaef-7f03-aa51-618504e1a0b8","event":{"kind":"output","task_id":"01a0ae7d-aaef-7f03-aa51-618504e1a0b8","chunk":"edited\nchanged lines: lines 1971-1977\n--- original\n+++ updated\n@@\n-\tif _, err := tryLoadSnapshot(t, legacy); err == nil {\n-\t\tt.Fatal(\"v4 without host_channel loaded\")\n-\t} else if !strings.Contains(err.Error(), \"host_channel\") {\n-\t\tt.Fatalf(\"loader refusal = %v, want the host_channel cause\", err)\n-\t} else {\n-\t\tt.Logf(\"loader refusal: %v\", err)\n-\t}\n+\t_, loadErr := tryLoadSnapshot(t, legacy)\n+\tif loadErr == nil {\n+\t\tt.Fatal(\"v4 without host_channel loaded\")\n+\t}\n+\tif !errors.Is(loadErr, config.ErrConfigValidation) {\n+\t\tt.Fatalf(\"loader refusal = %v, want a validation failure\", loadErr)\n+\t}\n+\t// The rendered message is redacted by design; the member cause travels\n+\t// the Unwrap chain.\n+\tseen := false\n+\tfor err := loadErr; err != nil; err = errors.Unwrap(err) {\n+\t\tif strings.Contains(err.Error(), \"host_channel\") {\n+\t\t\tseen = true\n+\t\t}\n+\t\tif joined, ok := err.(interface{ Unwrap() []error }); ok {\n+\t\t\tfor _, inner := range joined.Unwrap() {\n+\t\t\t\tif strings.Contains(inner.Error(), \"host_channel\") {\n+\t\t\t\t\tseen = true\n+\t\t\t\t}\n+\t\t\t}\n+\t\t}\n+\t}\n+\tif !seen {\n+\t\tt.Fatalf(\"loader refusal chain lacks the host_channel cause: %#v\", loadErr)\n+\t}\n+\tt.Logf(\"loader refusal chain pins mesh.host_channel: %v\", loadErr)\n","final_result":true}}}
