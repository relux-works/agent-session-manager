entConn, serverConn := net.Pipe()\n604|\tdefer clientConn.Close()\n605|\tdefer serverConn.Close()\n606|\tserved := serveAsync(serverConn, f.serverConfig(echoHandler(json.RawMessage(`{}`))))\n607|\trogue := tls.Client(clientConn, rogueClientConfig(t, f, f.certA, \"\", nil))\n608|\tif err := rogue.Handshake(); err != nil {\n609|\t\tt.Fatalf(\"handshake: %v\", err)\n610|\t}\n611|\tid, err := hostchannel.NewRequestID()\n612|\tif err != nil {\n613|\t\tt.Fatalf(\"NewRequestID: %v\", err)\n614|\t}\n615|\tline, err := rpcwire.EncodeRequest(\"5.0.0\", id, \"health.get\", json.RawMessage(`{}`))\n616|\tif err != nil {\n617|\t\tt.Fatalf(\"EncodeRequest: %v\", err)\n618|\t}\n619|\trequest, err := rpcwire.DecodeRequest(line)\n620|\tif err != nil {\n621|\t\tt.Fatalf(\"DecodeRequest: %v\", err)\n622|\t}\n623|\twriteRaw(t, rogue, line)\n624|\tassertFailure(t, readFailure(t, rogue, request, \"\"), \"incompatible_protocol\", 6)\n625|\tif err := awaitErr(t, served); !errors.Is(err, hostchannel.ErrHelloRequired) {\n626|\t\tt.Fatalf(\"Serve = %v\", err)\n627|\t}\n628|}\n629|\n630|func TestRefusesInvalidHello(t *testing.T) {\n631|\tcases := map[string]func(map[string]any){\n632|\t\t\"contract\": func(body map[string]any) {\n633|\t\t\tbody[\"contracts\"].(map[string]any)[\"rpc\"] = []string{\"4.0.0\"}\n634|\t\t},\n635|\t\t\"missing-key\": func(body map[string]any) {\n636|\t\t\tdelete(body[\"contracts\"].(map[string]any), \"lease\")\n637|\t\t},\n638|\t\t\"nonce\": func(body map[string]any) { body[\"nonce\"] = \"short\" },\n639|\t}\n640|\tfor name, edit := range cases {\n641|\t\tt.Run(name, func(t *testing.T) {\n642|\t\t\tf := newFixture(t)\n643|\t\t\tclientConn, serverConn := net.Pipe()\n644|\t\t\tdefer clientConn.Close()\n645|\t\t\tdefer serverConn.Close()\n646|\t\t\tserved := serveAsync(serverConn, f.serverConfig(echoHandler(json.RawMessage(`{}`))))\n647|\t\t\trogue := tls.Client(clientConn, rogueClientConfig(t, f, f.certA, \"\", nil))\n648|\t\t\tif err := rogue.Handshake(); err != nil {\n649|\t\t\t\tt.Fatalf(\"handshake: %v\", err)\n650|\t\t\t}\n651|\t\t\t_, line, sentID := rogueHello(t, hostA, edit)\n652|\t\t\twriteRaw(t, rogue, line)\n653|\t\t\tassertFailure(t, readFailure(t, rogue, rpcwire.Request{}, sentID), \"incompatible_protocol\", 6)\n654|\t\t\tif err := awaitErr(t, served); !errors.Is(err, hostchannel.ErrProtocol) {\n655|\t\t\t\tt.Fatalf(\"Serve = %v\", err)\n656|\t\t\t}\n657|\t\t})\n658|\t}\n659|}\n660|\n661|func TestForeignMajorClosesSilently(t *testing.T) {\n662|\tfor _, version := range []string{\"2.0.0\", \"4.0.0\"} {\n663|\t\tt.Run(version, func(t *testing.T) {\n664|\t\t\tf := newFixture(t)\n665|\t\t\tclientConn, serverConn := net.Pipe()\n666|\t\t\tdefer clientConn.Close()\n667|\t\t\tdefer serverConn.Close()\n668|\t\t\tserved := serveAsync(serverConn, f.serverConfig(echoHandler(json.RawMessage(`{}`))))\n669|\t\t\trogue := tls.Client(clientConn, rogueClientConfig(t, f, f.certA, \"\", nil))\n670|\t\t\tif err := rogue.Handshake(); err != nil {\n671|\t\t\t\tt.Fatalf(\"handshake: %v\", err)\n672|\t\t\t}\n673|\t\t\tcontracts, err := rpcwire.ContractProfile(version)\n674|\t\t\tif err != nil {\n675|\t\t\t\tt.Fatalf(\"ContractProfile: %v\", err)\n676|\t\t\t}\n677|\t\t\tlineBytes, _ := scalar.NewUint53(rpcwire.MaxLineBytes)\n678|\t\t\tobjectBytes, _ := scalar.NewUint53(rpcwire.MinObjectBytes)\n679|\t\t\tbody, err := json.Marshal(rpcwire.Hello{\n680|\t\t\t\tHostID: hostA, Platform: \"linux\", AXVersion: \"0.6.0\",\n681|\t\t\t\tNonce: rpcwire.NewNonce(), Contracts: contracts,\n682|\t\t\t\tMaxLineBytes: lineBytes, MaxObjectBytes: objectBytes,\n683|\t\t\t})\n684|\t\t\tif err != nil {\n685|\t\t\t\tt.Fatalf(\"marshal hello: %v\", err)\n686|\t\t\t}\n687|\t\t\tid, err := hostchannel.NewRequestID()\n688|\t\t\tif err != nil {\n689|\t\t\t\tt.Fatalf(\"NewRequestID: %v\", err)\n690|\t\t\t}\n691|\t\t\tline, err := rpcwire.EncodeRequest(version, id, \"hello\", body)\n692|\t\t\tif err != nil {\n693|\t\t\t\tt.Fatalf(\"EncodeRequest: %v\", err)\n694|\t\t\t}\n695|\t\t\twriteRaw(t, rogue, line)\n696|\t\t\texpectClose(t, rogue)\n697|\t\t\tif err := awaitErr(t, served); !errors.Is(err, hostchannel.ErrUnframeableInput) {\n698|\t\t\t\tt.Fatalf(\"Serve = %v\", err)\n699|\t\t\t}\n700|\t\t})\n701|\t}\n702|}\n703|\n704|func TestUnframeableHelloClosesSilently(t *testing.T) {\n705|\tf := newFixture(t)\n706|\tclientConn, serverConn := net.Pipe()\n707|\tdefer clientConn.Close()\n708|\tdefer serverConn.Close()\n709|\tserved := serveAsync(serverConn, f.serverConfig(echoHandler(json.RawMessage(`{}`))))\n710|\trogue := tls.Client(clientConn, rogueClientConfig(t, f, f.certA, \"\", nil))\n711|\tif err := rogue.Handshake(); err != nil {\n712|\t\tt.Fatalf(\"handshake: %v\", err)\n713|\t}\n714|\twriteRaw(t, rogue, []byte(`{\"protocol\":\"urn:ax:protocol:rpc\",`))\n715|\texpectClose(t, rogue)\n716|\tif err := awaitErr(t, served); !errors.Is(err, hostchannel.ErrUnframeableInput) {\n717|\t\tt.Fatalf(\"Serve = %v\", err)\n718|\t}\n719|}\n720|\n721|func TestHandshakeLimiterBounds(t *testing.T) {\n722|\texact := bytes.NewReader(bytes.Repeat([]byte{0xAA}, hostchannel.MaxHandshakeBytes))\n723|\tlimiter := hostchannel.NewHandshakeLimiter(exact)\n724|\tif _, err := io.Copy(io.Discard, limiter); err != nil {\n725|\t\tt.Fatalf(\"exact cap: %v\", err)\n726|\t}\n727|\tif limiter.Exceeded() {\n728|\t\tt.Fatal(\"exact cap latched exceeded\")\n729|\t}\n730|\tover := bytes.NewReader(bytes.Repeat([]byte{0xAA}, hostchannel.MaxHandshakeBytes+1))\n731|\tlimiter = hostchannel.NewHandshakeLimiter(over)\n732|\t_, err := io.Copy(io.Discard, limiter)\n733|\tif !errors.Is(err, hostchannel.ErrTransportFailure) {\n734|\t\tt.Fatalf(\"over cap: %v\", err)\n735|\t}\n736|\tif !strings.Contains(err.Error(), \"byte cap\") {\n737|\t\tt.Fatalf(\"over cap = %v, want the byte-cap refusal\", err)\n738|\t}\n739|\tif !limiter.Exceeded() {\n740|\t\tt.Fatal(\"exceeded not latched\")\n741|\t}\n742|\t// Disarming after local handshake success ends accounting: later\n743|\t// application bytes never count against the handshake budget.\n744|\tlarge := bytes.NewReader(bytes.Repeat([]byte{0xAA}, hostchannel.MaxHandshakeBytes+100))\n745|\tlimiter = hostchannel.NewHandshakeLimiter(large)\n746|\tif _, err := io.CopyN(io.Discard, limiter, 100); err != nil {\n747|\t\tt.Fatalf(\"prefix: %v\", err)\n748|\t}\n749|\tlimiter.Disarm()\n750|\tif _, err := io.Copy(io.Discard, limiter); err != nil {\n751|\t\tt.Fatalf(\"disarmed: %v\", err)\n752|\t}\n753|\tif limiter.Exceeded() {\n754|\t\tt.Fatal(\"disarmed limiter latched exceeded\")\n755|\t}\n756|}\n757|\n758|// countingStream measures hostile-path intake.\n759|type countingStream struct {\n760|\tnet.Conn\n761|\treads atomic.Int64\n762|}\n763|\n764|func (s *countingStream) Read(data []byte) (int, error) {\n765|\tn, err := s.Conn.Read(data)\n766|\ts.reads.Add(int64(n))\n767|\treturn n, err\n768|}\n769|\n770|func TestHandshakeIntakeIsBounded(t *testing.T) {\n771|\tf := newFixture(t)\n772|\tclientConn, serverConn := net.Pipe()\n773|\tdefer clientConn.Close()\n774|\tdefer serverConn.Close()\n775|\tcounted := &countingStream{Conn: serverConn}\n776|\tserved := serveAsync(counted, f.serverConfig(echoHandler(json.RawMessage(`{}`))))\n777|\twrote := make(chan error, 1)\n778|\tgo func() {\n779|\t\t_, err := clientConn.Write(bytes.Repeat([]byte(\"A\"), 4*1024*1024))\n780|\t\twrote <- err\n781|\t}()\n782|\tstart := time.Now()\n783|\terr := awaitErr(t, served)\n784|\tif elapsed := time.Since(start); elapsed > 5*time.Second {\n785|\t\tt.Fatalf(\"hostile handshake took %v\", elapsed)\n786|\t}\n787|\tif !errors.Is(err, hostchannel.ErrAuthenticationFailed) {\n788|\t\tt.Fatalf(\"Serve = %v\", err)\n789|\t}\n790|\tif got := counted.reads.Load(); got >= 64*1024 {\n791|\t\tt.Fatalf(\"hostile intake = %d bytes\", got)\n792|\t}\n793|\t<-wrote\n794|}\n795|\n796|func TestSilentPeerHandshakeDeadline(t *testing.T) {\n797|\tf := newFixture(t)\n798|\tclientConn, serverConn := net.Pipe()\n799|\tdefer clientConn.Close()\n800|\tdefer serverConn.Close()\n801|\tserverConfig := f.serverConfig(echoHandler(json.RawMessage(`{}`)))\n802|\tserverConfig.HandshakeTimeout = 200 * time.Millisecond\n803|\tserved := serveAsync(serverConn, serverConfig)\n804|\tif err := awaitErr(t, served); !errors.Is(err, hostchannel.ErrTransportFailure) {\n805|\t\tt.Fatalf(\"Serve = %v\", err)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
