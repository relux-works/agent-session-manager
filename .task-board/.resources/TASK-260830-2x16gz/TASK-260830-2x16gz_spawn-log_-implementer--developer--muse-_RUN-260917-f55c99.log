{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4f5","stream":{"kind":"session","id":"01a0ae5d-13b2-70c2-be9d-d3c6350c7765"},"sequence":213,"recorded_at":1780531400000421,"record_type":"event","durability":"durable","causation_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","run_stream":{"kind":"run","id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28"},"task_stream":{"kind":"task","id":"01a0ae5d-aeff-7580-a227-027774aec7db"},"task_id":"01a0ae5d-aeff-7580-a227-027774aec7db","event":{"kind":"output","task_id":"01a0ae5d-aeff-7580-a227-027774aec7db","chunk":"Read text file `internal/hostchannel/hostchannel_test.go`.\n1|package hostchannel_test\n2|\n3|import (\n4|\t\"context\"\n5|\t\"crypto/tls\"\n6|\t\"crypto/x509\"\n7|\t\"encoding/json\"\n8|\t\"errors\"\n9|\t\"fmt\"\n10|\t\"net\"\n11|\t\"path/filepath\"\n12|\t\"strings\"\n13|\t\"testing\"\n14|\t\"time\"\n15|\n16|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n17|\t\"github.com/relux-works/agent-session-manager/internal/hostchannel\"\n18|\t\"github.com/relux-works/agent-session-manager/internal/hosttrust\"\n19|\t\"github.com/relux-works/agent-session-manager/internal/localstore\"\n20|\t\"github.com/relux-works/agent-session-manager/internal/rpcwire\"\n21|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n22|)\n23|\n24|const (\n25|\thostA = \"0198f4c8-7d40-7e55-8e6f-1234567890aa\"\n26|\thostB = \"0198f4c8-7d40-7e55-8e6f-1234567890ab\"\n27|\thostC = \"0198f4c8-7d40-7e55-8e6f-1234567890ac\"\n28|)\n29|\n30|type fixture struct {\n31|\tnow     time.Time\n32|\tdirA    string\n33|\tdirB    string\n34|\tstoreA  *hosttrust.Store\n35|\tstoreB  *hosttrust.Store\n36|\tissuedA hosttrust.IssuedCredential\n37|\tissuedB hosttrust.IssuedCredential\n38|\tcertA   tls.Certificate\n39|\tcertB   tls.Certificate\n40|\tcredAID string\n41|\tcredBID string\n42|}\n43|\n44|func testPaths(t *testing.T, configPath, stateDir string) localstore.ResolvedPaths {\n45|\tt.Helper()\n46|\tpaths, err := localstore.ResolvePaths(localstore.ResolveRequest{\n47|\t\tPlatform: scalar.PlatformLinux,\n48|\t\tFlags: map[string]string{\n49|\t\t\t\"--config\":      configPath,\n50|\t\t\t\"--data-dir\":    filepath.Join(stateDir, \"data\"),\n51|\t\t\t\"--state-dir\":   stateDir,\n52|\t\t\t\"--cache-dir\":   filepath.Join(stateDir, \"cache\"),\n53|\t\t\t\"--runtime-dir\": filepath.Join(stateDir, \"runtime\"),\n54|\t\t},\n55|\t})\n56|\tif err != nil {\n57|\t\tt.Fatalf(\"ResolvePaths: %v\", err)\n58|\t}\n59|\treturn paths\n60|}\n61|\n62|func openStore(t *testing.T, stateDir string) *hosttrust.Store {\n63|\tt.Helper()\n64|\tstore, err := hosttrust.Open(testPaths(t, filepath.Join(stateDir, \"config.toml\"), stateDir))\n65|\tif err != nil {\n66|\t\tt.Fatalf(\"Open: %v\", err)\n67|\t}\n68|\tif _, err := store.Initialize(); err != nil {\n69|\t\tt.Fatalf(\"Initialize: %v\", err)\n70|\t}\n71|\treturn store\n72|}\n73|\n74|func enroll(t *testing.T, store *hosttrust.Store, issued hosttrust.IssuedCredential, hostID string, at time.Time) string {\n75|\tt.Helper()\n76|\tfingerprints, err := hosttrust.FingerprintsOf(issued.LeafDER, issued.RootDER)\n77|\tif err != nil {\n78|\t\tt.Fatalf(\"FingerprintsOf: %v\", err)\n79|\t}\n80|\tcredentialID, err := store.Enroll(hosttrust.EnrollInput{\n81|\t\tHostID:     hostID,\n82|\t\tLeafDER:    issued.LeafDER,\n83|\t\tRootDER:    issued.RootDER,\n84|\t\tAuthorized: fingerprints,\n85|\t\tEnrolledAt: at,\n86|\t})\n87|\tif err != nil {\n88|\t\tt.Fatalf(\"Enroll(%s): %v\", hostID, err)\n89|\t}\n90|\treturn credentialID\n91|}\n92|\n93|func newFixture(t *testing.T) *fixture {\n94|\tt.Helper()\n95|\tnow := time.Now().UTC().Truncate(time.Millisecond)\n96|\tf := &fixture{now: now, dirA: t.TempDir(), dirB: t.TempDir()}\n97|\tf.storeA = openStore(t, f.dirA)\n98|\tf.storeB = openStore(t, f.dirB)\n99|\tvar err error\n100|\tf.issuedA, err = hosttrust.IssueCredential(hostA, now, nil)\n101|\tif err != nil {\n102|\t\tt.Fatalf(\"IssueCredential A: %v\", err)\n103|\t}\n104|\tf.issuedB, err = hosttrust.IssueCredential(hostB, now, nil)\n105|\tif err != nil {\n106|\t\tt.Fatalf(\"IssueCredential B: %v\", err)\n107|\t}\n108|\tenroll(t, f.storeA, f.issuedA, hostA, now)\n109|\tenroll(t, f.storeA, f.issuedB, hostB, now)\n110|\tenroll(t, f.storeB, f.issuedA, hostA, now)\n111|\tenroll(t, f.storeB, f.issuedB, hostB, now)\n112|\tf.certA, err = hostchannel.CredentialFromIssued(f.issuedA)\n113|\tif err != nil {\n114|\t\tt.Fatalf(\"CredentialFromIssued A: %v\", err)\n115|\t}\n116|\tf.certB, err = hostchannel.CredentialFromIssued(f.issuedB)\n117|\tif err != nil {\n118|\t\tt.Fatalf(\"CredentialFromIssued B: %v\", err)\n119|\t}\n120|\tf.credAID = scalar.SHA256Digest(f.issuedA.LeafDER).String()\n121|\tf.credBID = scalar.SHA256Digest(f.issuedB.LeafDER).String()\n122|\treturn f\n123|}\n124|\n125|func (f *fixture) serverConfig(handler hostchannel.Handler) hostchannel.ServerConfig {\n126|\treturn hostchannel.ServerConfig{\n127|\t\tStore:             f.storeB,\n128|\t\tCredential:        f.certB,\n129|\t\tLocalHostID:       hostB,\n130|\t\tLocalCredentialID: f.credBID,\n131|\t\tAllowlisted:       []string{hostA},\n132|\t\tPlatform:          \"linux\",\n133|\t\tAXVersion:         \"0.6.0\",\n134|\t\tHandler:           handler,\n135|\t\tRequestTimeout:    5 * time.Second,\n136|\t}\n137|}\n138|\n139|func (f *fixture) clientConfig() hostchannel.ClientConfig {\n140|\treturn hostchannel.ClientConfig{\n141|\t\tStore:                f.storeA,\n142|\t\tCredential:           f.certA,\n143|\t\tLocalHostID:          hostA,\n144|\t\tLocalCredentialID:    f.credAID,\n145|\t\tExpectedRemoteHostID: hostB,\n146|\t\tAllowlisted:          []string{hostB},\n147|\t\tPlatform:             \"linux\",\n148|\t\tAXVersion:            \"0.6.0\",\n149|\t\tRequestTimeout:       5 * time.Second,\n150|\t}\n151|}\n152|\n153|func serveAsync(stream hostchannel.Stream, config hostchannel.ServerConfig) chan error {\n154|\tdone := make(chan error, 1)\n155|\tgo func() { done <- hostchannel.Serve(stream, config) }()\n156|\treturn done\n157|}\n158|\n159|func awaitErr(t *testing.T, done chan error) error {\n160|\tt.Helper()\n161|\tselect {\n162|\tcase err := <-done:\n163|\t\treturn err\n164|\tcase <-time.After(30 * time.Second):\n165|\t\tt.Fatal(\"timed out waiting for the server\")\n166|\t\treturn nil\n167|\t}\n168|}\n169|\n170|func echoHandler(body json.RawMessage) hostchannel.Handler {\n171|\treturn func(_ context.Context, _ rpcwire.Request, _ hostchannel.Binding, _ func(func() error) error) (json.RawMessage, error) {\n172|\t\treturn body, nil\n173|\t}\n174|}\n175|\n176|func TestFullHandshakeHelloAndOperation(t *testing.T) {\n177|\tf := newFixture(t)\n178|\tvar seen hostchannel.Binding\n179|\tvar calls int\n180|\thandler := func(_ context.Context, request rpcwire.Request, binding hostchannel.Binding, _ func(func() error) error) (json.RawMessage, error) {\n181|\t\tcalls++\n182|\t\tseen = binding\n183|\t\tif request.Operation() != \"health.get\" {\n184|\t\t\treturn nil, errors.New(\"unexpected operation\")\n185|\t\t}\n186|\t\treturn json.RawMessage(`{}`), nil\n187|\t}\n188|\tclientConn, serverConn := net.Pipe()\n189|\tdefer clientConn.Close()\n190|\tdefer serverConn.Close()\n191|\tserved := serveAsync(serverConn, f.serverConfig(handler))\n192|\tclient, err := hostchannel.Dial(clientConn, f.clientConfig())\n193|\tif err != nil {\n194|\t\tt.Fatalf(\"Dial: %v\", err)\n195|\t}\n196|\tdefer client.Close()\n197|\tstate := client.ConnectionState()\n198|\tif state.Version != tls.VersionTLS13 {\n199|\t\tt.Fatalf(\"negotiated TLS version = %x\", state.Version)\n200|\t}\n201|\tif state.NegotiatedProtocol != \"ax-host/1\" {\n202|\t\tt.Fatalf(\"negotiated ALPN = %q\", state.NegotiatedProtocol)\n203|\t}\n204|\tif state.DidResume {\n205|\t\tt.Fatal(\"connection resumed\")\n206|\t}\n207|\tif client.PeerHostID() != hostB {\n208|\t\tt.Fatalf(\"peer = %q\", client.PeerHostID())\n209|\t}\n210|\tif client.Binding().HelloHostID != hostB || client.Binding().RemoteHostID != hostB {\n211|\t\tt.Fatalf(\"client binding = %+v\", client.Binding())\n212|\t}\n213|\tresponse, err := client.Call(\"health.get\", json.RawMessage(`{}`))\n214|\tif err != nil {\n215|\t\tt.Fatalf(\"Call: %v\", err)\n216|\t}\n217|\tif !response.OK() || string(response.Body()) != `{}` {\n218|\t\tt.Fatalf(\"response = %+v\", response)\n219|\t}\n220|\tif calls != 1 {\n221|\t\tt.Fatalf(\"handler calls = %d\", calls)\n222|\t}\n223|\tif seen.RemoteHostID != hostA || seen.HelloHostID != hostA || seen.LocalHostID != hostB {\n224|\t\tt.Fatalf(\"server binding = %+v\", seen)\n225|\t}\n226|\tsnapshot, err := f.storeB.ReadSnapshot()\n227|\tif err != nil {\n228|\t\tt.Fatalf(\"ReadSnapshot: %v\", err)\n229|\t}\n230|\tif seen.Generation != snapshot.Generation {\n231|\t\tt.Fatalf(\"server bound generation %d, committed %d\", seen.Generation, snapshot.Generation)\n232|\t}\n233|\tif err := client.Close(); err != nil {\n234|\t\tt.Fatalf(\"Close: %v\", err)\n235|\t}\n236|\tif err := awaitErr(t, served); !errors.Is(err, hostchannel.ErrTransportFailure) {\n237|\t\tt.Fatalf(\"Serve after close = %v\", err)\n238|\t}\n239|}\n240|\n241|func TestInventoryRootsThroughChannel(t *testing.T) {\n242|\tf := newFixture(t)\n243|\thandler := func(_ context.Context, request rpcwire.Request, _ hostchannel.Binding, _ func(func() error) error) (json.RawMessage, error) {\n244|\t\tvar shape struct {\n245|\t\t\tNamespaces []string `json:\"namespaces\"`\n246|\t\t}\n247|\t\tif err := json.Unmarshal(request.Body(), &shape); err != nil {\n248|\t\t\treturn nil, err\n249|\t\t}\n250|\t\troots := make([]map[string]any, 0, len(shape.Namespaces))\n251|\t\tfor _, name := range shape.Namespaces {\n252|\t\t\troots = append(roots, map[string]any{\n253|\t\t\t\t\"namespace\": name,\n254|\t\t\t\t\"count\":     0,\n255|\t\t\t\t\"root_id\":   \"sha256:\" + strings.Repeat(\"0\", 64),\n256|\t\t\t})\n257|\t\t}\n258|\t\treturn json.Marshal(map[string]any{\"roots\": roots})\n259|\t}\n260|\tclientConn, serverConn := net.Pipe()\n261|\tdefer clientConn.Close()\n262|\tdefer serverConn.Close()\n263|\tserved := serveAsync(serverConn, f.serverConfig(handler))\n264|\tclient, err := hostchannel.Dial(clientConn, f.clientConfig())\n265|\tif err != nil {\n266|\t\tt.Fatalf(\"Dial: %v\", err)\n267|\t}\n268|\tdefer client.Close()\n269|\tnames, err := rpcwire.Namespaces(\"5.0.0\")\n270|\tif err != nil {\n271|\t\tt.Fatalf(\"Namespaces: %v\", err)\n272|\t}\n273|\tif len(names) != 8 {\n274|\t\tt.Fatalf(\"RPC-5 namespaces = %d\", len(names))\n275|\t}\n276|\tquery, err := json.Marshal(map[string]any{\"namespaces\": names})\n277|\tif err != nil {\n278|\t\tt.Fatalf(\"marshal: %v\", err)\n279|\t}\n280|\tresponse, err := client.Call(\"inventory.roots\", query)\n281|\tif err != nil {\n282|\t\tt.Fatalf(\"Call: %v\", err)\n283|\t}\n284|\tif !response.OK() {\n285|\t\tt.Fatalf(\"response failure = %+v\", response.Failure())\n286|\t}\n287|\tvar shape struct {\n288|\t\tRoots []rpcwire.Root `json:\"roots\"`\n289|\t}\n290|\tif err := json.Unmarshal(response.Body(), &shape); err != nil {\n291|\t\tt.Fatalf(\"decode roots: %v\", err)\n292|\t}\n293|\tif len(shape.Roots) != 8 || shape.Roots[0].Namespace != names[0] {\n294|\t\tt.Fatalf(\"roots = %+v\", shape.Roots)\n295|\t}\n296|\tif err := client.Close(); err != nil {\n297|\t\tt.Fatalf(\"Close: %v\", err)\n298|\t}\n299|\t_ = awaitErr(t, served)\n300|}\n301|\n302|func TestMutationBoundaryRunsFresh(t *testing.T) {\n303|\tf := newFixture(t)\n304|\tvar ran int\n305|\thandler := func(_ context.Context, _ rpcwire.Request, _ hostchannel.Binding, mutate func(func() error) error) (json.RawMessage, error) {\n306|\t\tif err := mutate(func() error { ran++; return nil }); err != nil {\n307|\t\t\treturn nil, err\n308|\t\t}\n309|\t\treturn json.RawMessage(`{}`), nil\n310|\t}\n311|\tclientConn, serverConn := net.Pipe()\n312|\tdefer clientConn.Close()\n313|\tdefer serverConn.Close()\n314|\tserved := serveAsync(serverConn, f.serverConfig(handler))\n315|\tclient, err := hostchannel.Dial(clientConn, f.clientConfig())\n316|\tif err != nil {\n317|\t\tt.Fatalf(\"Dial: %v\", err)\n318|\t}\n319|\tdefer client.Close()\n320|\tresponse, err := client.Call(\"health.get\", json.RawMessage(`{}`))\n321|\tif err != nil || !response.OK() {\n322|\t\tt.Fatalf(\"Call = %+v, %v\", response, err)\n323|\t}\n324|\tif ran != 1 {\n325|\t\tt.Fatalf(\"boundary ran %d times\", ran)\n326|\t}\n327|\tif err := client.Close(); err != nil {\n328|\t\tt.Fatalf(\"Close: %v\", err)\n329|\t}\n330|\t_ = awaitErr(t, served)\n331|}\n332|\n333|func TestRetiringCredentialAdmitsWithinBound(t *testing.T) {\n334|\tf := newFixture(t)\n335|\tnow := time.Now().UTC()\n336|\tcredentialID := scalar.SHA256Digest(f.issuedA.LeafDER).String()\n337|\tif err := f.storeB.MarkRetiring(credentialID, now.Add(time.Hour), now); err != nil {\n338|\t\tt.Fatalf(\"MarkRetiring: %v\", err)\n339|\t}\n340|\tclientConn, serverConn := net.Pipe()\n341|\tdefer clientConn.Close()\n342|\tdefer serverConn.Close()\n343|\tserved := serveAsync(serverConn, f.serverConfig(echoHandler(json.RawMessage(`{}`))))\n344|\tclient, err := hostchannel.Dial(clientConn, f.clientConfig())\n345|\tif err != nil {\n346|\t\tt.Fatalf(\"Dial with retiring peer: %v\", err)\n347|\t}\n348|\tdefer client.Close()\n349|\tif response, err := client.Call(\"health.get\", json.RawMessage(`{}`)); err != nil || !response.OK() {\n350|\t\tt.Fatalf(\"Call = %+v, %v\", response, err)\n351|\t}\n352|\tif err := client.Close(); err != nil {\n353|\t\tt.Fatalf(\"Close: %v\", err)\n354|\t}\n355|\t_ = awaitErr(t, served)\n356|}\n357|\n358|func TestServerNameMatchesIssuedLeaf(t *testing.T) {\n359|\tf := newFixture(t)\n360|\tleaf, err := x509.ParseCertificate(f.issuedB.LeafDER)\n361|\tif err != nil {\n362|\t\tt.Fatalf(\"parse leaf: %v\", err)\n363|\t}\n364|\tname, err := hostchannel.ServerName(hostB)\n365|\tif err != nil {\n366|\t\tt.Fatalf(\"ServerName: %v\", err)\n367|\t}\n368|\tif len(leaf.DNSNames) != 1 || leaf.DNSNames[0] != name {\n369|\t\tt.Fatalf(\"SAN = %q, ServerName = %q\", leaf.DNSNames, name)\n370|\t}\n371|\tif _, err := hostchannel.ServerName(\"not-a-uuid\"); !errors.Is(err, hostchannel.ErrInvalidConfig) {\n372|\t\tt.Fatalf(\"bad host ServerName = %v\", err)\n373|\t}\n374|}\n375|\n376|func TestNewRequestID(t *testing.T) {\n377|\tseen := map[string]struct{}{}\n378|\tfor i := 0; i < 100; i++ {\n379|\t\tid, err := hostchannel.NewRequestID()\n380|\t\tif err != nil {\n381|\t\t\tt.Fatalf(\"NewRequestID: %v\", err)\n382|\t\t}\n383|\t\tif _, err := scalar.ParseUUIDv7(id); err != nil {\n384|\t\t\tt.Fatalf(\"request ID %q is not UUIDv7: %v\", id, err)\n385|\t\t}\n386|\t\tif id[14] != '7' {\n387|\t\t\tt.Fatalf(\"request ID %q has no v7 nibble\", id)\n388|\t\t}\n389|\t\tif _, duplicate := seen[id]; duplicate {\n390|\t\t\tt.Fatalf(\"duplicate request ID %q\", id)\n391|\t\t}\n392|\t\tseen[id] = struct{}{}\n393|\t}\n394|}\n395|\n396|func TestLocalFailureMapping(t *testing.T) {\n397|\tcases := []struct {\n398|\t\terr  error\n399|\t\tcode string\n400|\t\texit int\n401|\t}{\n402|\t\t{hostchannel.ErrInvalidConfig, \"invalid_config\", 3},\n403|\t\t{hostchannel.ErrAuthenticationFailed, \"authentication_failed\", 7},\n404|\t\t{hostchannel.ErrTransportFailure, \"transport_failure\", 8},\n405|\t\t{hostchannel.ErrProtocol, \"incompatible_protocol\", 6},\n406|\t\t{hostchannel.ErrHelloRequired, \"incompatible_protocol\", 6},\n407|\t\t{hostchannel.ErrUnframeableInput, \"transport_failure\", 8},\n408|\t\t{hostchannel.ErrALPNMismatch, \"authentication_failed\", 7},\n409|\t\t{hosttrust.ErrHostIdentityMismatch, \"authentication_failed\", 7},\n410|\t\t{hosttrust.ErrNotAllowlisted, \"authentication_failed\", 7},\n411|\t\t{hosttrust.ErrStaleGeneration, \"authentication_failed\", 7},\n412|\t\t{hosttrust.ErrAuthorizationRefused, \"authentication_failed\", 7},\n413|\t}\n414|\tfor _, tc := range cases {\n415|\t\tcode, exit, ok := hostchannel.LocalFailure(tc.err)\n416|\t\tif !ok || string(code) != tc.code || exit != tc.exit {\n417|\t\t\tt.Fatalf(\"LocalFailure(%v) = %q/%d/%v\", tc.err, code, exit, ok)\n418|\t\t}\n419|\t\tregistryExit, err := axerror.ExitCodeFor(axerror.Version130, code)\n420|\t\tif err != nil || registryExit != tc.exit {\n421|\t\t\tt.Fatalf(\"registry exit for %q = %d, %v\", code, registryExit, err)\n422|\t\t}\n423|\t}\n424|\tif _, _, ok := hostchannel.LocalFailure(errors.New(\"boom\")); ok {\n425|\t\tt.Fatal(\"unknown error mapped\")\n426|\t}\n427|}\n428|\n429|func TestBindingRedaction(t *testing.T) {\n430|\tbinding := hostchannel.Binding{LocalHostID: hostA, RemoteHostID: hostB, HelloHostID: hostA}\n431|\tfor _, rendered := range []string{\n432|\t\tfmt.Sprintf(\"%v\", binding),\n433|\t\tfmt.Sprintf(\"%#v\", binding),\n434|\t\tfmt.Sprintf(\"%s\", binding),\n435|\t} {\n436|\t\tif strings.Contains(rendered, hostA) || strings.Contains(rendered, hostB) {\n437|\t\t\tt.Fatalf(\"binding leaks identity: %q\", rendered)\n438|\t\t}\n439|\t}\n440|}\n441|\n442|func TestAuthorityListOverflow(t *testing.T) {\n443|\tif hostchannel.AuthorityListOverflow(nil) {\n444|\t\tt.Fatal(\"empty list overflows\")\n445|\t}\n446|\tfitting := [][]byte{make([]byte, 65531)}\n447|\tif hostchannel.AuthorityListOverflow(fitting) {\n448|\t\tt.Fatal(\"65535-byte list overflows\")\n449|\t}\n450|\texact := [][]byte{make([]byte, 65532)}\n451|\tif !hostchannel.AuthorityListOverflow(exact) {\n452|\t\tt.Fatal(\"65536-byte list admitted\")\n453|\t}\n454|\tmany := make([][]byte, 2000)\n455|\tfor i := range many {\n456|\t\tmany[i] = make([]byte, 64)\n457|\t}\n458|\tif !hostchannel.AuthorityListOverflow(many) {\n459|\t\tt.Fatal(\"large list admitted\")\n460|\t}\n461|}\n462|\n463|func TestEnrollmentPoolExcludesRevoked(t *testing.T) {\n464|\tf := newFixture(t)\n465|\tif err := f.storeB.Revoke(scalar.SHA256Digest(f.issuedA.LeafDER).String()); err != nil {\n466|\t\tt.Fatalf(\"Revoke: %v\", err)\n467|\t}\n468|\tsnapshot, err := f.storeB.ReadSnapshot()\n469|\tif err != nil {\n470|\t\tt.Fatalf(\"ReadSnapshot: %v\", err)\n471|\t}\n472|\tpool, err := hostchannel.EnrollmentPool(snapshot, time.Now().UTC())\n473|\tif err != nil {\n474|\t\tt.Fatalf(\"EnrollmentPool: %v\", err)\n475|\t}\n476|\tif pool == nil || len(pool.Subjects()) != 1 {\n477|\t\tt.Fatalf(\"pool subjects = %d\", len(pool.Subjects()))\n478|\t}\n479|}\n480|\n481|func TestEnrollmentPoolRefusesOverflow(t *testing.T) {\n482|\tf := newFixture(t)\n483|\tsnapshot, err := f.storeB.ReadSnapshot()\n484|\tif err != nil {\n485|\t\tt.Fatalf(\"ReadSnapshot: %v\", err)\n486|\t}\n487|\tvar self hosttrust.CredentialEntry\n488|\tfor _, entry := range snapshot.Trust.Entries {\n489|\t\tif entry.HostID.String() == hostB {\n490|\t\t\tself = entry\n491|\t\t}\n492|\t}\n493|\tbloated := hosttrust.Snapshot{Generation: snapshot.Generation}\n494|\tfor i := 0; i < 2000; i++ {\n495|\t\tbloated.Trust.Entries = append(bloated.Trust.Entries, self)\n496|\t}\n497|\tif _, err := hostchannel.EnrollmentPool(bloated, time.Now().UTC()); !errors.Is(err, hostchannel.ErrInvalidConfig) {\n498|\t\tt.Fatalf(\"overflow pool = %v\", err)\n499|\t}\n500|}\n(more lines below)","final_result":true}}}
