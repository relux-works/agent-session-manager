{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000dc43","stream":{"kind":"session","id":"01a0ae5d-13b2-70c2-be9d-d3c6350c7765"},"sequence":3196,"recorded_at":1780531400006387,"record_type":"event","durability":"durable","causation_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","run_stream":{"kind":"run","id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28"},"task_stream":{"kind":"task","id":"01a0ae94-e00c-7e31-be8c-06bef089a563"},"task_id":"01a0ae94-e00c-7e31-be8c-06bef089a563","event":{"kind":"output","task_id":"01a0ae94-e00c-7e31-be8c-06bef089a563","chunk":"Read text file `internal/traceability/traceability.go`.\n(119 line(s) above)\n120|\tKeys            []string           `json:\"keys\"`\n121|\tProduction      codeReference      `json:\"production\"`\n122|\tAcceptanceCases []string           `json:\"acceptance_cases\"`\n123|\tCoverage        coverageLevel      `json:\"coverage,omitempty\"`\n124|\tGap             string             `json:\"gap,omitempty\"`\n125|\tClauses         []dischargedClause `json:\"clauses,omitempty\"`\n126|}\n127|\n128|// coverageLevel is how much of a bound section a binding claims to discharge.\n129|// The claim is not taken on trust: the level is recomputed from the clauses the\n130|// binding enumerates against the clause inventory the pinned specification\n131|// itself carries for that section, and a claim that differs from the measured\n132|// level is refused.\n133|type coverageLevel string\n134|\n135|const (\n136|\t// coverageFull means every normative clause the pinned section carries is\n137|\t// enumerated with a verified excerpt and an acceptance owner.\n138|\tcoverageFull coverageLevel = \"full\"\n139|\t// coveragePartial means at least half of them are.\n140|\tcoveragePartial coverageLevel = \"partial\"\n141|\t// coverageSliver means fewer than half are: the binding implements a corner\n142|\t// of the section it is registered against.\n143|\tcoverageSliver coverageLevel = \"sliver\"\n144|\t// coverageUnevidenced means the binding enumerates no clause at all. It says\n145|\t// the registry makes no clause-level claim, not that the implementation\n146|\t// covers nothing.\n147|\tcoverageUnevidenced coverageLevel = \"unevidenced\"\n148|\t// coverageUnmeasured means normativeKeywordPattern finds no clause line\n149|\t// under the section's heading or its subheadings, so the gate cannot\n150|\t// measure the section's obligations at all.\n151|\t//\n152|\t// It is deliberately NOT called \"declarative\", and it does NOT mean the\n153|\t// section carries no obligation. Nineteen of the 157 pinned headings are in\n154|\t// this class and every one of them has a substantive body: Section 15.2 is a\n155|\t// eighteen-row normative exit-code registry and Section 7.3 is the closed\n156|\t// Provider Manifest, both of which state their obligations as tables rather\n157|\t// than in uppercase RFC 2119 keywords. Treating that silence as \"nothing to\n158|\t// discharge\" is the same free pass this gate exists to remove, reached\n159|\t// through the scanner instead of through the label, so an unmeasured binding\n160|\t// carries the same mandatory gap as every other level below full and is\n161|\t// refused for assigned-scope admission.\n162|\tcoverageUnmeasured coverageLevel = \"unmeasured\"\n163|)\n164|\n165|// dischargedClause binds one normative clause of the pinned section to the\n166|// acceptance cases that discharge it. Every field is checked against the\n167|// hash-verified document: the identifier must index the section's own clause\n168|// inventory, the line must be the line that clause occupies, and the excerpt\n169|// must be that clause's text quoted verbatim, so a clause cannot be claimed\n170|// with a true sentence about something else.\n171|type dischargedClause struct {\n172|\tID              string   `json:\"id\"`\n173|\tLine            int      `json:\"line\"`\n174|\tExcerpt         string   `json:\"excerpt\"`\n175|\tAcceptanceCases []string `json:\"acceptance_cases\"`\n176|}\n177|\n178|// normativeClause is one RFC 2119 clause line of the pinned specification,\n179|// measured from the document rather than declared by the registry.\n180|type normativeClause struct {\n181|\tID   string\n182|\tLine int\n183|\tText string\n184|}\n185|\n186|type codeReference struct {\n187|\tPath        string `json:\"path\"`\n188|\tDeclaration string `json:\"declaration\"`\n189|}\n190|\n191|type assignedSectionBinding struct {\n192|\tScope string\n193|\tKeys  []string\n194|}\n195|\n196|var assignedSectionPattern = regexp.MustCompile(`^((?:20|1[0-9]|[1-9])(?:\\.(?:[0-9]+|[A-Za-z]))*)(?:-((?:20|1[0-9]|[1-9])(?:\\.(?:[0-9]+|[A-Za-z]))*))?$`)\n197|var catalogAppendixPattern = regexp.MustCompile(`(?i)^Appendix ([A-D]):`)\n198|\n199|// VerifyRepository is the production CI entry point. It verifies exact pinned\n200|// inputs, stale generated output, compatibility coverage, and every registered\n201|// ownership reference against the supplied repository filesystem.\n202|func VerifyRepository(repository fs.FS) (Report, error) {\n203|\treturn verifyRepository(repository, nil)\n204|}\n205|\n206|// VerifyAssignedSections is the production Story-scope entry point. Each exact\n207|// assigned subsection, or every heading in a same-section range, must have its\n208|// own scoped production declaration and executable acceptance-case link. A\n209|// pinned top-level source owner alone never satisfies assigned-scope admission.\n210|func VerifyAssignedSections(repository fs.FS, sections []string) (Report, error) {\n211|\tif len(sections) == 0 {\n212|\t\treturn Report{}, fail(\"assigned section scope is empty\")\n213|\t}\n214|\treturn verifyRepository(repository, sections)\n215|}\n216|\n217|func verifyRepository(repository fs.FS, assignedSections []string) (Report, error) {\n218|\tif repository == nil {\n219|\t\treturn Report{}, fail(\"repository filesystem is nil\")\n220|\t}\n221|\n222|\tlockBytes, err := readRequired(repository, contractLockPath)\n223|\tif err != nil {\n224|\t\treturn Report{}, err\n225|\t}\n226|\tmanifest, err := specpin.VerifyV060(lockBytes)\n227|\tif err != nil {\n228|\t\treturn Report{}, fail(\"verify normative source lock: %v\", err)\n229|\t}\n230|\n231|\tmetadataBytes, err := readRequired(repository, catalogMetadataPath)\n232|\tif err != nil {\n233|\t\treturn Report{}, err\n234|\t}\n235|\tgenerated, err := cataloggen.Generate(metadataBytes, lockBytes)\n236|\tif err != nil {\n237|\t\treturn Report{}, fail(\"verify reviewed catalog metadata: %v\", err)\n238|\t}\n239|\tcommittedGenerated, err := readRequired(repository, generatedCatalogPath)\n240|\tif err != nil {\n241|\t\treturn Report{}, err\n242|\t}\n243|\tif !bytes.Equal(generated, committedGenerated) {\n244|\t\treturn Report{}, fail(\"generated catalog is stale; run go generate ./internal/catalog\")\n245|\t}\n246|\n247|\tcurrentCatalog, err := catalog.ForRelease(catalog.ReleaseV060)\n248|\tif err != nil {\n249|\t\treturn Report{}, fail(\"load current catalog: %v\", err)\n250|\t}\n251|\tif err := verifyCatalogContracts(manifest.Contracts, currentCatalog.Contracts); err != nil {\n252|\t\treturn Report{}, err\n253|\t}\n254|\t// The legacy projection keeps the superseded v0.5.0 registry honest:\n255|\t// the generated catalog must still carry the exact historical rows the\n256|\t// adopted lock derives, so legacy support claims stay verifiable after\n257|\t// the authority moved to v0.6.0.\n258|\tlegacyContracts, err := manifest.ContractsForRelease(specpin.ReleaseV050)\n259|\tif err != nil {\n260|\t\treturn Report{}, fail(\"derive legacy catalog contracts: %v\", err)\n261|\t}\n262|\tlegacyCatalog, err := catalog.ForRelease(catalog.ReleaseV050)\n263|\tif err != nil {\n264|\t\treturn Report{}, fail(\"load legacy catalog: %v\", err)\n265|\t}\n266|\tif err := verifyCatalogContracts(legacyContracts, legacyCatalog.Contracts); err != nil {\n267|\t\treturn Report{}, err\n268|\t}\n269|\tcompatibilityCatalog, err := catalog.ForRelease(catalog.ReleaseV043)\n270|\tif err != nil {\n271|\t\treturn Report{}, fail(\"load compatibility catalog: %v\", err)\n272|\t}\n273|\n274|\tregistryBytes, err := readRequired(repository, ownershipRegistryPath)\n275|\tif err != nil {\n276|\t\treturn Report{}, err\n277|\t}\n278|\tregistry, err := decodeOwnershipRegistry(registryBytes)\n279|\tif err != nil {\n280|\t\treturn Report{}, err\n281|\t}\n282|\tbindings, err := resolveAssignedSections(manifest.Source.NormativeScope, assignedSections)\n283|\tif err != nil {\n284|\t\treturn Report{}, err\n285|\t}\n286|\tdocument, err := specdoc.LoadV060()\n287|\tif err != nil {\n288|\t\treturn Report{}, fail(\"load pinned specification document: %v\", err)\n289|\t}\n290|\tif manifest.Source.Document.SHA256 != specpin.DocumentSHA256V060 {\n291|\t\treturn Report{}, fail(\n292|\t\t\t\"verified normative lock document digest %s differs from the pinned clause source %s\",\n293|\t\t\tmanifest.Source.Document.SHA256, specpin.DocumentSHA256V060)\n294|\t}\n295|\treturn verifyOwnership(repository, document, registry, manifest, currentCatalog, compatibilityCatalog, bindings)\n296|}\n297|\n298|func readRequired(repository fs.FS, filename string) ([]byte, error) {\n299|\tvalue, err := fs.ReadFile(repository, filename)\n(more lines below)","final_result":true}}}
