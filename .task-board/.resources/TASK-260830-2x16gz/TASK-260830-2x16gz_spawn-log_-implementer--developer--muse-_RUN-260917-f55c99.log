 return time.Unix(0, nowNanos.Load()).UTC() }\n1242|\tclientConn, serverConn := net.Pipe()\n1243|\tdefer clientConn.Close()\n1244|\tdefer serverConn.Close()\n1245|\tserved := serveAsync(serverConn, serverConfig)\n1246|\tclient, err := hostchannel.Dial(clientConn, f.clientConfig())\n1247|\tif err != nil {\n1248|\t\tt.Fatalf(\"Dial: %v\", err)\n1249|\t}\n1250|\tdefer client.Close()\n1251|\tif response, err := client.Call(\"health.get\", json.RawMessage(`{}`)); err != nil || !response.OK() {\n1252|\t\tt.Fatalf(\"Call = %+v, %v\", response, err)\n1253|\t}\n1254|\tnowNanos.Store(now.Add(2 * time.Hour).UnixNano())\n1255|\tif _, err := client.Call(\"health.get\", json.RawMessage(`{}`)); !errors.Is(err, hostchannel.ErrTransportFailure) {\n1256|\t\tt.Fatalf(\"expired Call = %v\", err)\n1257|\t}\n1258|\tif err := awaitErr(t, served); !errors.Is(err, hosttrust.ErrAuthorizationRefused) {\n1259|\t\tt.Fatalf(\"Serve = %v\", err)\n1260|\t} else if errors.Is(err, hosttrust.ErrStaleGeneration) {\n1261|\t\tt.Fatalf(\"Serve is stale, want expiry: %v\", err)\n1262|\t}\n1263|}\n1264|\n1265|func TestHelloWriteDeadline(t *testing.T) {\n1266|\tf := newFixture(t)\n1267|\tclientConn, serverConn := net.Pipe()\n1268|\tdefer clientConn.Close()\n1269|\tdefer serverConn.Close()\n1270|\trogue := tls.Server(serverConn, rogueServerConfig(t, f, f.certB, nil))\n1271|\tdialed := make(chan error, 1)\n1272|\tgo func() {\n1273|\t\tclientConfig := f.clientConfig()\n1274|\t\tclientConfig.HelloTimeout = 200 * time.Millisecond\n1275|\t\tclient, err := hostchannel.Dial(clientConn, clientConfig)\n1276|\t\tif err == nil {\n1277|\t\t\t_ = client.Close()\n1278|\t\t}\n1279|\t\tdialed <- err\n1280|\t}()\n1281|\tif err := rogue.Handshake(); err != nil {\n1282|\t\tt.Fatalf(\"handshake: %v\", err)\n1283|\t}\n1284|\t// The rogue never reads the hello; the bounded write must fail, not hang.\n1285|\tselect {\n1286|\tcase err := <-dialed:\n1287|\t\tif !errors.Is(err, hostchannel.ErrTransportFailure) {\n1288|\t\t\tt.Fatalf(