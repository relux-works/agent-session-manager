eturn result, nil\n1092|}\n1093|\n1094|// coverageBucket is the measured coverage level. It is computed from the two\n1095|// counts and never read from the registry.\n1096|func coverageBucket(discharged, total int) coverageLevel {\n1097|\tswitch {\n1098|\tcase total == 0:\n1099|\t\treturn coverageUnmeasured\n1100|\tcase discharged == 0:\n1101|\t\treturn coverageUnevidenced\n1102|\tcase discharged >= total:\n1103|\t\treturn coverageFull\n1104|\tcase discharged*2 >= total:\n1105|\t\treturn coveragePartial\n1106|\tdefault:\n1107|\t\treturn coverageSliver\n1108|\t}\n1109|}\n1110|\n1111|// sectionCoverage is the measured result for one section binding.\n1112|type sectionCoverage struct {\n1113|\tKey        string\n1114|\tLevel      coverageLevel\n1115|\tDischarged int\n1116|\tTotal      int\n1117|\tGap        string\n1118|}\n1119|\n1120|// Ratio renders the measured coverage as the ratio it was computed from, so a\n1121|// report never has to describe coverage in prose.\n1122|func (coverage sectionCoverage) Ratio() string {\n1123|\treturn fmt.Sprintf(\"%d/%d\", coverage.Discharged, coverage.Total)\n1124|}\n1125|\n1126|// verifySectionBindingCoverage measures one section binding against the pinned\n1127|// document and refuses a declared level that differs from the measured one.\n1128|//\n1129|// This is the check that stops a binding from claiming a whole section while\n1130|// implementing a corner of it. It verifies what it can decide: that every\n1131|// enumerated clause is a real obligation of the claimed section, quoted\n1132|// verbatim at the line it occupies, and named by an acceptance case the binding\n1133|// itself registers; and that the declared level equals the measured ratio. It\n1134|// cannot decide that the named acceptance case exercises the clause's meaning —\n1135|// that residual is stated in README.md and in the coverage artifact.\n1136|func verifySectionBindingCoverage(\n1137|\tdocument *specdoc.Document,\n1138|\tgroup ownershipGroup,\n1139|\tacceptanceIDs map[string]struct{},\n1140|) (sectionCoverage, error) {\n1141|\tkey := group.Keys[0]\n1142|\tinventory, err := sectionClauseInventory(document, key)\n1143|\tif err != nil {\n1144|\t\treturn sectionCoverage{}, fail(\"section binding %q clause inventory: %v\", key, err)\n1145|\t}\n1146|\tbyIdentifier := make(map[string]normativeClause, len(inventory))\n1147|\tfor _, clause := range inventory {\n1148|\t\tbyIdentifier[clause.ID] = clause\n1149|\t}\n1150|\tgroupCases := make(map[string]struct{}, len(group.AcceptanceCases))\n1151|\tfor _, acceptanceID := range group.AcceptanceCases {\n1152|\t\tgroupCases[acceptanceID] = struct{}{}\n1153|\t}\n1154|\n1155|\tseen := make(map[string]struct{}, len(group.Clauses))\n1156|\tfor _, declared := range group.Clauses {\n1157|\t\tclause, known := byIdentifier[declared.ID]\n1158|\t\tif !known {\n1159|\t\t\treturn sectionCoverage{}, fail(\n1160|\t\t\t\t\"section binding %q discharges clause %q, which is not one of the %d normative clauses of the pinned section\",\n1161|\t\t\t\tkey, declared.ID, len(inventory))\n1162|\t\t}\n1163|\t\tif _, duplicate := seen[declared.ID]; duplicate {\n1164|\t\t\treturn sectionCoverage{}, fail(\"section binding %q repeats discharged clause %q\", key, declared.ID)\n1165|\t\t}\n1166|\t\tseen[declared.ID] = struct{}{}\n1167|\t\tif declared.Line != clause.Line {\n1168|\t\t\treturn sectionCoverage{}, fail(\n1169|\t\t\t\t\"section binding %q clause %q declares line %d, but the pinned clause is at line %d\",\n1170|\t\t\t\tkey, declared.ID, declared.Line, clause.Line)\n1171|\t\t}\n1172|\t\texcerpt := specdoc.Normalize(declared.Excerpt)\n1173|\t\tif excerpt == \"\" {\n1174|\t\t\treturn sectionCoverage{}, fail(\"section binding %q clause %q quotes an empty excerpt\", key, declared.ID)\n1175|\t\t}\n1176|\t\tif !normativeKeywordPattern.MatchString(excerpt) {\n1177|\t\t\treturn sectionCoverage{}, fail(\n1178|\t\t\t\t\"section binding %q clause %q quotes text that carries no RFC 2119 obligation\", key, declared.ID)\n1179|\t\t}\n1180|\t\tif !quoteBeginsAtLine(document, declared.Excerpt, clause.Line) {\n1181|\t\t\treturn sectionCoverage{}, fail(\n1182|\t\t\t\t\"section binding %q clause %q does not quote the pinned document verbatim at line %d\",\n1183|\t\t\t\tkey, declared.ID, clause.Line)\n1184|\t\t}\n1185|\t\tif len(declared.AcceptanceCases) == 0 {\n1186|\t\t\treturn sectionCoverage{}, fail(\n1187|\t\t\t\t\"section binding %q clause %q names no acceptance case that discharges it\", key, declared.ID)\n1188|\t\t}\n1189|\t\tcaseSeen := make(map[string]struct{}, len(declared.AcceptanceCases))\n1190|\t\tfor _, acceptanceID := range declared.AcceptanceCases {\n1191|\t\t\tif _, duplicate := caseSeen[acceptanceID]; duplicate {\n1192|\t\t\t\treturn sectionCoverage{}, fail(\n1193|\t\t\t\t\t\"section binding %q clause %q repeats acceptance case %q\", key, declared.ID, acceptanceID)\n1194|\t\t\t}\n1195|\t\t\tcaseSeen[acceptanceID] = struct{}{}\n1196|\t\t\tif _, registered := acceptanceIDs[acceptanceID]; !registered {\n1197|\t\t\t\treturn sectionCoverage{}, fail(\n1198|\t\t\t\t\t\"section binding %q clause %q references unregistered acceptance case %q\", key, declared.ID, acceptanceID)\n1199|\t\t\t}\n1200|\t\t\tif _, owned := groupCases[acceptanceID]; !owned {\n1201|\t\t\t\treturn sectionCoverage{}, fail(\n1202|\t\t\t\t\t\"section binding %q clause %q discharges through acceptance case %q, which the binding does not own\",\n1203|\t\t\t\t\tkey, declared.ID, acceptanceID)\n1204|\t\t\t}\n1205|\t\t}\n1206|\t}\n1207|\n1208|\tmeasured := coverageBucket(len(group.Clauses), len(inventory))\n1209|\tif group.Coverage == \"\" {\n1210|\t\treturn sectionCoverage{}, fail(\n1211|\t\t\t\"section binding %q declares no coverage level; the pinned section carries %d normative clauses and the binding enumerates %d\",\n1212|\t\t\tkey, len(inventory), len(group.Clauses))\n1213|\t}\n1214|\tif group.Coverage != measured {\n1215|\t\treturn sectionCoverage{}, fail(\n1216|\t\t\t\"section binding %q claims %s coverage but discharges %d of the %d normative clauses of the pinned section, which is %s coverage\",\n1217|\t\t\tkey, group.Coverage, len(group.Clauses), len(inventory), measured)\n1218|\t}\n1219|\tdisplay, err := sectionDisplayName(key)\n1220|\tif err != nil {\n1221|\t\treturn sectionCoverage{}, fail(\"section binding %q: %v\", key, err)\n1222|\t}\n1223|\t// Every level below full owes a gap, coverageUnmeasured included. Before\n1224|\t// this the gate refused a gap on the unmeasured bucket, so the bindings with\n1225|\t// the least evidence behind them were the only ones structurally forbidden\n1226|\t// from disclosing it.\n1227|\tswitch measured {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
