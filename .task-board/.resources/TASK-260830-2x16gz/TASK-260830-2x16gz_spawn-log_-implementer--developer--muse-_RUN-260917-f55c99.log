{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000db23","stream":{"kind":"session","id":"01a0ae5d-13b2-70c2-be9d-d3c6350c7765"},"sequence":3052,"recorded_at":1780531400006099,"record_type":"event","durability":"durable","causation_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","run_stream":{"kind":"run","id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28"},"task_stream":{"kind":"task","id":"01a0ae94-3b49-7c13-82d8-3b08ab20784f"},"task_id":"01a0ae94-3b49-7c13-82d8-3b08ab20784f","event":{"kind":"output","task_id":"01a0ae94-3b49-7c13-82d8-3b08ab20784f","chunk":"{\n  \"chunk_id\": \"exec-71-1\",\n  \"command\": \"PYTHONDONTWRITEBYTECODE=1 python3 -c \\\"\\nimport json\\nd = json.load(open('internal/traceability/ownership.v0.6.0.json'))\\nprint('unowned:', json.dumps(d['unowned_sections'], indent=1)[:1500])\\nprint()\\nn=0\\nfor o in d['ownership']:\\n    if o.get('kind')=='section_binding' and o.get('coverage') not in ('unevidenced',):\\n        print(json.dumps(o, indent=1)[:1200]); print('======'); n+=1\\n        if n>=3: break\\n\\\"; echo ===; grep -rn \\\"reviewedOwnershipCanonicalSHA256\\\\|ReviewedOwnership\\\" internal/traceability/*.go internal/traceability/cmd -l 2>/dev/null; grep -rn \\\"reviewedOwnershipCanonicalSHA256\\\" internal/ --include=\\\"*.go\\\" -l | head\",\n  \"description\": \"Check unowned sections and pin location\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"unowned: [\\n {\\n  \\\"key\\\": \\\"section:2.2\\\",\\n  \\\"gap\\\": \\\"Section 2.2 states the unconditional lease, replica, replication, tombstone and capability invariants of the product, and none of them is implemented here. The binding this entry replaces named validateSessionRecordCommon, which validates Session Record shape and the execution-profile enum value only.\\\",\\n  \\\"evidence\\\": \\\"The repository contains no lease, epoch, replica, takeover, tombstone or replication implementation: internal/canonicaljson validates record shape, internal/localstore stores immutable objects and rebuilds a local index, and the two acceptance cases the replaced binding named are canonical-identity cases.\\\"\\n },\\n {\\n  \\\"key\\\": \\\"section:18.4\\\",\\n  \\\"gap\\\": \\\"Section 18.4 requires audit retention - the exact Section 5.2 event types for lease change, force confirmation, managed replacement, task-board launch and adoption and tombstone issuance and resolution, and retention of the event and every referenced immutable object for as long as the Session Record. No retention, expiry or garbage-collection rule is implemented.\\\",\\n  \\\"evidence\\\": \\\"internal/localstore/projection.go opens, rebuilds and recovers the SQLite projection and installs immutable blobs; it declares no retention, expiry or garbage-collection behaviour, and the binding this entry replaces named OpenProjection with the same two storage acceptance cases already used by the Section 3.3 binding.\\\"\\n },\\n {\\n  \\\"key\\\": \\\"section:11.10.1\\\",\\n  \\\"gap\\\": \\\"Section 11.10.1 requires SSH host-chann\\n\\n{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:6.2\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/config/schema.go\\\",\\n  \\\"declaration\\\": \\\"Decode\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"config-versioned-readers\\\"\\n ],\\n \\\"coverage\\\": \\\"full\\\",\\n \\\"clauses\\\": [\\n  {\\n   \\\"id\\\": \\\"6.2#1\\\",\\n   \\\"line\\\": 2433,\\n   \\\"excerpt\\\": \\\"MUST be <code>conpty</code>. WSL2 configuration uses Linux paths and <code>platform = \\\\\\\"wsl2\\\\\\\"</code>.\\\",\\n   \\\"acceptance_cases\\\": [\\n    \\\"config-versioned-readers\\\"\\n   ]\\n  }\\n ]\\n}\\n======\\n{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:7.3\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/catalog/catalog.go\\\",\\n  \\\"declaration\\\": \\\"ForRelease\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"catalog-v050-exact\\\"\\n ],\\n \\\"coverage\\\": \\\"unmeasured\\\",\\n \\\"gap\\\": \\\"ForRelease only returns the reviewed typed catalog rows that reference 7.3; the RFC 2119 scanner measures no clause line under 7.3, because the closed Provider Manifest states its obligations as a required-member table, a 16-entry operation registry and exactly 7 capability names rather than in uppercase keywords, so the gate cannot measure this section - and the closed manifest is implemented in internal/provhost DecodeManifest, exercised by the provhost conformance suite.\\\"\\n}\\n======\\n{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:10.3\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/canonicaljson/closed_shapes.go\\\",\\n  \\\"declaration\\\": \\\"validateBlobDescriptor\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"scalar-bounded-integer-validation\\\",\\n  \\\"scalar-digest-validation\\\",\\n  \\\"canonical-identity-refusal\\\"\\n ],\\n \\\"coverage\\\": \\\"sliver\\\",\\n \\\"gap\\\": \\\"validateBlobDescriptor enforces the Section 10.3 chunk offset invariant, but the two receiver clauses - validate every chunk before marking it present, and validate the complete blob after assembly - have no implementation because no transfer receiver exists.\\\",\\n \\\"clauses\\\": [\\n  {\\n   \\\"id\\\": \\\"10.3#1\\\",\\n   \\\"line\\\": 4729,\\n   \\\"excerpt\\\": \\\"<code>chunk_id:digest</code>. It has no extension map. Offset MUST equal index times 4,194,304; every non-final chunk has that exact size.\\\",\\n   \\\"acceptance_cases\\\": [\\n    \\\"canonical-identity-refusal\\\"\\n   ]\\n  }\\n ]\\n}\\n======\\n===\\ninternal/traceability/traceability.go\\ninternal/traceability/cmd/tracecheck/main_test.go\\ninternal/traceability/cmd/tracecheck/main_test.go\\ninternal/traceability/traceability.go\\n\",\n  \"original_output_bytes\": 3781,\n  \"original_output_tokens\": 946,\n  \"truncated\": false\n}","final_result":true}}}
