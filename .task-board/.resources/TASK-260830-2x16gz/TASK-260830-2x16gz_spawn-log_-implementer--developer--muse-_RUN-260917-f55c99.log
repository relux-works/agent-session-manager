{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c55d","stream":{"kind":"session","id":"01a0ae5d-13b2-70c2-be9d-d3c6350c7765"},"sequence":265,"recorded_at":1780531400000525,"record_type":"event","durability":"durable","causation_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","run_stream":{"kind":"run","id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28"},"call_id":"call_01a0ae5dcbe77146bf3346f622dd3a06","text":"Read text file `internal/hostchannel/refusal_test.go`.\n1|package hostchannel_test\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"context\"\n6|\t\"crypto/tls\"\n7|\t\"encoding/json\"\n8|\t\"errors\"\n9|\t\"io\"\n10|\t\"net\"\n11|\t\"strings\"\n12|\t\"sync/atomic\"\n13|\t\"testing\"\n14|\t\"time\"\n15|\n16|\t\"github.com/relux-works/agent-session-manager/internal/config\"\n17|\n18|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n19|\t\"github.com/relux-works/agent-session-manager/internal/hostchannel\"\n20|\t\"github.com/relux-works/agent-session-manager/internal/hosttrust\"\n21|\t\"github.com/relux-works/agent-session-manager/internal/rpcwire\"\n22|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n23|)\n24|\n25|// rogueClientConfig builds a raw TLS client the tests drive by hand. The\n26|// pool comes from the production enrollment entry; mutate introduces the\n27|// single hostile deviation under test.\n28|func rogueClientConfig(t *testing.T, f *fixture, cert tls.Certificate, serverName string, mutate func(*tls.Config)) *tls.Config {\n29|\tt.Helper()\n30|\tsnapshot, err := f.storeA.ReadSnapshot()\n31|\tif err != nil {\n32|\t\tt.Fatalf(\"ReadSnapshot: %v\", err)\n33|\t}\n34|\tpool, err := hostchannel.EnrollmentPool(snapshot, time.Now().UTC())\n35|\tif err != nil {\n36|\t\tt.Fatalf(\"EnrollmentPool: %v\", err)\n37|\t}\n38|\tname := serverName\n39|\tif name == \"\" {\n40|\t\tname, err = hostchannel.ServerName(hostB)\n41|\t\tif err != nil {\n42|\t\t\tt.Fatalf(\"ServerName: %v\", err)\n43|\t\t}\n44|\t}\n45|\tconfig := &tls.Config{\n46|\t\tCertificates: []tls.Certificate{cert},\n47|\t\tRootCAs:      pool,\n48|\t\tServerName:   name,\n49|\t\tMinVersion:   tls.VersionTLS13,\n50|\t\tMaxVersion:   tls.VersionTLS13,\n51|\t\tNextProtos:   []string{\"ax-host/1\"},\n52|\t}\n53|\tif mutate != nil {\n54|\t\tmutate(config)\n55|\t}\n56|\treturn config\n57|}\n58|\n59|func rogueServerConfig(t *testing.T, f *fixture, cert tls.Certificate, mutate func(*tls.Config)) *tls.Config {\n60|\tt.Helper()\n61|\tsnapshot, err := f.storeB.ReadSnapshot()\n62|\tif err != nil {\n63|\t\tt.Fatalf(\"ReadSnapshot: %v\", err)\n64|\t}\n65|\tpool, err := hostchannel.EnrollmentPool(snapshot, time.Now().UTC())\n66|\tif err != nil {\n67|\t\tt.Fatalf(\"EnrollmentPool: %v\", err)\n68|\t}\n69|\tconfig := &tls.Config{\n70|\t\tCertificates:           []tls.Certificate{cert},\n71|\t\tClientAuth:             tls.RequireAndVerifyClientCert,\n72|\t\tClientCAs:              pool,\n73|\t\tMinVersion:             tls.VersionTLS13,\n74|\t\tMaxVersion:             tls.VersionTLS13,\n75|\t\tNextProtos:             []string{\"ax-host/1\"},\n76|\t\tSessionTicketsDisabled: true,\n77|\t}\n78|\tif mutate != nil {\n79|\t\tmutate(config)\n80|\t}\n81|\treturn config\n82|}\n83|\n84|// rogueHello builds a structurally valid RPC-5 hello line from public\n85|// entries, optionally reshaped by edit into an invalid frame.\n86|func rogueHello(t *testing.T, hostID string, edit func(map[string]any)) (rpcwire.Request, []byte, string) {\n87|\tt.Helper()\n88|\tcontracts, err := rpcwire.ContractProfile(\"5.0.0\")\n89|\tif err != nil {\n90|\t\tt.Fatalf(\"ContractProfile: %v\", err)\n91|\t}\n92|\tlineBytes, err := scalar.NewUint53(rpcwire.MaxLineBytes)\n93|\tif err != nil {\n94|\t\tt.Fatalf(\"NewUint53: %v\", err)\n95|\t}\n96|\tobjectBytes, err := scalar.NewUint53(rpcwire.MinObjectBytes)\n97|\tif err != nil {\n98|\t\tt.Fatalf(\"NewUint53: %v\", err)\n99|\t}\n100|\traw, err := json.Marshal(rpcwire.Hello{\n101|\t\tHostID: hostID, Platform: \"linux\", AXVersion: \"0.6.0\",\n102|\t\tNonce: rpcwire.NewNonce(), Contracts: contracts,\n103|\t\tMaxLineBytes: lineBytes, MaxObjectBytes: objectBytes,\n104|\t})\n105|\tif err != nil {\n106|\t\tt.Fatalf(\"marshal hello: %v\", err)\n107|\t}\n108|\tid, err := hostchannel.NewRequestID()\n109|\tif err != nil {\n110|\t\tt.Fatalf(\"NewRequestID: %v\", err)\n111|\t}\n112|\tvar body map[string]any\n113|\tif err := json.Unmarshal(raw, &body); err != nil {\n114|\t\tt.Fatalf(\"reshape hello: %v\", err)\n115|\t}\n116|\tif edit != nil {\n117|\t\tedit(body)\n118|\t\traw, err = json.Marshal(body)\n119|\t\tif err != nil {\n120|\t\t\tt.Fatalf(\"marshal edited hello: %v\", err)\n121|\t\t}\n122|\t}\n123|\tenvelope := map[string]any{\n124|\t\t\"protocol\": \"urn:ax:protocol:rpc\", \"protocol_version\": \"5.0.0\",\n125|\t\t\"request_id\": id, \"operation\": \"hello\", \"body\": json.RawMessage(raw),\n126|\t}\n127|\tline, err := json.Marshal(envelope)\n128|\tif err != nil {\n129|\t\tt.Fatalf(\"marshal envelope: %v\", err)\n130|\t}\n131|\trequest, err := rpcwire.DecodeRequest(line)\n132|\tif edit == nil && err != nil {\n133|\t\tt.Fatalf(\"DecodeRequest(rogue hello): %v\", err)\n134|\t}\n135|\treturn request, line, id\n136|}\n137|\n138|func writeRaw(t *testing.T, conn net.Conn, line []byte) {\n139|\tt.Helper()\n140|\tif _, err := conn.Write(append(line, '\\n')); err != nil {\n141|\t\tt.Fatalf(\"rogue write: %v\", err)\n142|\t}\n143|}\n144|\n145|// readFailure decodes the one encrypted refusal and proves the stream ends\n146|// there: a second frame must not follow.\n147|func readFailure(t *testing.T, conn net.Conn, request rpcwire.Request, sentID string) *axerror.Error {\n148|\tt.Helper()\n149|\t// A refused peer may already have closed; the deadline then fails and\n150|\t// the read below terminates on the closure instead.\n151|\t_ = conn.SetReadDeadline(time.Now().Add(10 * time.Second))\n152|\tline, err := hostchannel.ReadLine(conn)\n153|\tif err != nil {\n154|\t\tt.Fatalf(\"ReadLine(refusal): %v\", err)\n155|\t}\n156|\tif request.Operation() == \"\" {\n157|\t\tvar shape struct {\n158|\t\t\tVersion string          `json:\"protocol_version\"`\n159|\t\t\tID      string          `json:\"request_id\"`\n160|\t\t\tOK      bool            `json:\"ok\"`\n161|\t\t\tError   json.RawMessage `json:\"error\"`\n162|\t\t}\n163|\t\tif err := json.Unmarshal(line, &shape); err != nil {\n164|\t\t\tt.Fatalf(\"decode refusal: %v\", err)\n165|\t\t}\n166|\t\tif shape.Version != \"5.0.0\" || shape.ID != sentID || shape.OK {\n167|\t\t\tt.Fatalf(\"refusal correlation = %+v\", shape)\n168|\t\t}\n169|\t\tfailure, err := axerror.DecodeBound(axerror.ContainingContract{ID: \"urn:ax:protocol:rpc\", Major: 5}, shape.Error)\n170|\t\tif err != nil {\n171|\t\t\tt.Fatalf(\"DecodeBound: %v\", err)\n172|\t\t}\n173|\t\texpectClose(t, conn)\n174|\t\treturn failure\n175|\t}\n176|\tresponse, err := rpcwire.DecodeResponse(line, request)\n177|\tif err != nil {\n178|\t\tt.Fatalf(\"DecodeResponse(refusal): %v\", err)\n179|\t}\n180|\tif response.OK() {\n181|\t\tt.Fatal(\"refusal decoded as success\")\n182|\t}\n183|\texpectClose(t, conn)\n184|\treturn response.Failure()\n185|}\n186|\n187|func expectClose(t *testing.T, conn net.Conn) {\n188|\tt.Helper()\n189|\t_ = conn.SetReadDeadline(time.Now().Add(10 * time.Second))\n190|\tif _, err := hostchannel.ReadLine(conn); !errors.Is(err, io.EOF) {\n191|\t\tt.Fatalf(\"stream did not close: %v\", err)\n192|\t}\n193|}\n194|\n195|// expectRogueHandshakeFails proves a rogue cannot complete a handshake\n196|// against a refusing server. A TLS 1.3 client may report handshake success\n197|// before the server validates its flight, so the rogue reads next: the\n198|// read drains the server alert (which also releases the rendezvous pipe)\n199|// and must fail. Nothing is written: the server never reaches hello.\n200|func expectRogueHandshakeFails(t *testing.T, rogue *tls.Conn) {\n201|\tt.Helper()\n202|\t_ = rogue.SetReadDeadline(time.Now().Add(10 * time.Second))\n203|\tif _, err := rogue.Read(make([]byte, 4096)); err == nil {\n204|\t\tt.Fatal(\"rogue read succeeded against a refusing server\")\n205|\t}\n206|}\n207|\n208|func assertFailure(t *testing.T, failure *axerror.Error, code string, exit int) {\n209|\tt.Helper()\n210|\tif failure.Version() != axerror.Version130 {\n211|\t\tt.Fatalf(\"failure version = %s\", failure.Version())\n212|\t}\n213|\tif string(failure.Code()) != code || failure.ExitCode() != exit {\n214|\t\tt.Fatalf(\"failure = %q/%d\", failure.Code(), failure.ExitCode())\n215|\t}\n216|\tregistryExit, err := axerror.ExitCodeFor(axerror.Version130, failure.Code())\n217|\tif err != nil || registryExit != exit {\n218|\t\tt.Fatalf(\"registry exit for %q = %d, %v\", failure.Code(), registryExit, err)\n219|\t}\n220|}\n221|\n222|func TestRefusesTLS12Offer(t *testing.T) {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c55f","stream":{"kind":"session","id":"01a0ae5d-13b2-70c2-be9d-d3c6350c7765"},"sequence":266,"recorded_at":1780531400000527,"record_type":"event","durability":"durable","causation_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28","run_stream":{"kind":"run","id":"d399377e-e1e6-462b-bf26-c7cdc6c1ce28"},"call_id":"call_01a0ae5dcdf5706b95976a3c5ce1f074","text":"Read text file `internal/hostchannel/gates_test.go`.\n1|package hostchannel_test\n2|\n3|import (\n4|\t\"testing\"\n5|)\n6|\n7|// hcGates is the Section 11.10.4 closed gate registry as executable\n8|// fixture families. Each family names its positive vectors (admit exactly\n9|// the specified peer) and negative vectors (refuse exactly one hostile\n10|// deviation) driven through the production entries. The conformance matrix\n11|// in the task outcome traces every gate to these tests.\n12|var hcGates = map[string]struct {\n13|\tpositives []string\n14|\tnegatives []string\n15|}{\n16|\t\"HC-TLS\": {\n17|\t\tpositives: []string{\"TestFullHandshakeHelloAndOperation\"},\n18|\t\tnegatives: []string{\n19|\t\t\t\"TestRefusesTLS12Offer/server\", \"TestRefusesTLS12Offer/client\",\n20|\t\t\t\"TestRefusesWrongALPN/server\", \"TestRefusesWrongALPN/client\",\n21|\t\t\t\"TestRefusesMissingALPN\", \"TestRefusesResumption\",\n22|\t\t\t\"TestRefusesPlaintextPreface\", \"TestVerifyPeerRefusals/alpn\",\n23|\t\t\t\"TestVerifyPeerRefusals/missing-alpn\", \"TestVerifyPeerRefusals/resumed\",\n24|\t\t\t\"TestSilentPeerHandshakeDeadline\", \"TestHandshakeLimiterBounds\",\n25|\t\t\t\"TestHandshakeIntakeIsBounded\",\n26|\t\t},\n27|\t},\n28|\t\"HC-CERT\": {\n29|\t\tpositives: []string{\"TestVerifyPeerAdmitsEnrolled\", \"TestFullHandshakeHelloAndOperation\", \"TestCredentialFromIssued\", \"TestEnrollmentPoolExcludesRevoked\"},\n30|\t\tnegatives: []string{\n31|\t\t\t\"TestRefusesUnenrolledRoot\", \"TestRefusesRevokedLeaf\",\n32|\t\t\t\"TestRefusesRetiredPastRetireAt\", \"TestRefusesExpiredLeaf\",\n33|\t\t\t\"TestVerifyPeerRefusals/no-chains\", \"TestVerifyPeerRefusals/no-certificates\",\n34|\t\t\t\"TestVerifyPeerRefusals/unknown-leaf\", \"TestVerifyPeerRefusals/expired\",\n35|\t\t\t\"TestVerifyPeerRefusals/revoked\", \"TestVerifyPeerRefusals/retiring-past\",\n36|\t\t\t\"TestVerifyPeerRefusals/retiring-nil\", \"TestCredentialFromIssuedRefusals\",\n37|\t\t\t\"TestEnrollmentPoolRefusesOverflow\",\n38|\t\t},\n39|\t},\n40|\t\"HC-MAP\": {\n41|\t\tpositives: []string{\"TestVerifyPeerAdmitsEnrolled\", \"TestServerNameMatchesIssuedLeaf\"},\n42|\t\tnegatives: []string{\n43|\t\t\t\"TestVerifyPeerRefusals/double-match\", \"TestVerifyPeerRefusals/leaf-flipped\",\n44|\t\t\t\"TestVerifyPeerRefusals/root-flipped\", \"TestVerifyPeerRefusals/spki-zero\",\n45|\t\t\t\"TestRefusesWrongServerName\",\n46|\t\t},\n47|\t},\n48|\t\"HC-HELLO\": {\n49|\t\tpositives: []string{\"TestFullHandshakeHelloAndOperation\", \"TestInventoryRootsThroughChannel\", \"TestNewRequestID\", \"TestLocalFailureMapping\"},\n50|\t\tnegatives: []string{\n51|\t\t\t\"TestRefusesHelloUUIDMismatch\", \"TestRefusesServerHelloUUIDMismatch\",\n52|\t\t\t\"TestRefusesDestinationMismatch\", \"TestRefusesNotAllowlisted\",\n53|\t\t\t\"TestRefusesInvalidHello/contract\", \"TestRefusesInvalidHello/missing-key\",\n54|\t\t\t\"TestRefusesInvalidHello/nonce\", \"TestHelloResponseCorrelation\",\n55|\t\t\t\"TestHelloFailureMapping/host_identity_mismatch\", \"TestHelloFailureMapping/peer_not_allowlisted\",\n56|\t\t\t\"TestHelloFailureMapping/incompatible_protocol\", \"TestHelloDeadline/server\",\n57|\t\t\t\"TestHelloDeadline/client\", \"TestHelloWriteDeadline\",\n58|\t\t},\n59|\t},\n60|\t\"HC-DISPATCH\": {\n61|\t\tpositives: []string{\"TestFullHandshakeHelloAndOperation\", \"TestHandlerErrorFramedAndContinues\"},\n62|\t\tnegatives: []string{\n63|\t\t\t\"TestRefusesNonHelloBeforeHello\", \"TestForeignMajorClosesSilently/2.0.0\",\n64|\t\t\t\"TestForeignMajorClosesSilently/4.0.0\", \"TestUnframeableHelloClosesSilently\",\n65|\t\t\t\"TestOversizeHelloLine\", \"TestDispatchTimeout\", \"TestDispatchExpiryClosesWithoutFrame\",\n66|\t\t\t\"TestCallRefusesInvalidBody\", \"TestHandlerGarbageBodyCloses\",\n67|\t\t},\n68|\t},\n69|\t\"HC-MIGRATE\": {\n70|\t\tpositives: []string{\"TestLaunchForConfig\", \"TestServeArgvPinsChannelVersion\"},\n71|\t\tnegatives: []string{\n72|\t\t\t\"TestLaunchForConfigRefusesLegacy\", \"TestLaunchForConfigEmptySnapshot\",\n73|\t\t\t\"TestForeignMajorClosesSilently/2.0.0\", \"TestForeignMajorClosesSilently/4.0.0\",\n74|\t\t\t\"TestInvalidActivation\", \"TestLocalCredentialRefusals\",\n75|\t\t},\n76|\t},\n77|\t\"HC-LIFECYCLE\": {\n78|\t\tpositives: []string{\"TestRetiringCredentialAdmitsWithinBound\", \"TestMutationBoundaryRunsFresh\"},\n79|\t\tnegatives: []string{\"TestRefusesRevokedLeaf\", \"TestRefusesRetiredPastRetireAt\", \"TestRefusesExpiredLeaf\"},\n80|\t},\n81|\t\"HC-GENERATION\": {\n82|\t\tpositives: []string{\"TestMutationBoundaryRunsFresh\", \"TestFullHandshakeHelloAndOperation\", \"TestAuthorityListOverflow\"},\n83|\t\tnegatives: []string{\n84|\t\t\t\"TestStaleGenerationAtDispatch/server_closes\", \"TestStaleGenerationAtDispatch/client_refuses_to_send\",\n85|\t\t\t\"TestStaleGenerationAtMutation\", \"TestWatchGeneration\",\n86|\t\t},\n87|\t},\n88|\t\"HC-EXCLUDE\": {\n89|\t\tpositives: []string{\"TestRuntimeWriteCensus\", \"TestStaticWriteCensus\", \"TestBindingRedaction\"},\n90|\t\tnegatives: []string{\"census-evasion mutant (killed by TestRuntimeWriteCensus)\"},\n91|\t},\n92|\t\"HC-PARITY\": {\n93|\t\tpositives: []string{\"TestFullHandshakeHelloAndOperation (transport-agnostic Stream)\"},\n94|\t\tnegatives: []string{\"stated bound: no SSH-implementation branch exists in the package; the same TLS profile runs over any ordered binary Stream\"},\n95|\t},\n96|}\n97|\n98|func TestHCGateRegistryIsComplete(t *testing.T) {\n99|\twant := []string{\"HC-TLS\", \"HC-CERT\", \"HC-MAP\", \"HC-HELLO\", \"HC-DISPATCH\", \"HC-MIGRATE\", \"HC-LIFECYCLE\", \"HC-GENERATION\", \"HC-EXCLUDE\", \"HC-PARITY\"}\n100|\tif len(hcGates) != len(want) {\n101|\t\tt.Fatalf(\"registry carries %d gates, Section 11.10.4 defines %d\", len(hcGates), len(want))\n102|\t}\n103|\tfor _, gate := range want {\n104|\t\tfamily, ok := hcGates[gate]\n105|\t\tif !ok {\n106|\t\t\tt.Fatalf(\"gate %s missing\", gate)\n107|\t\t}\n108|\t\tif len(family.positives) == 0 || len(family.negatives) == 0 {\n109|\t\t\tt.Fatalf(\"gate %s lacks a positive or negative family\", gate)\n110|\t\t}\n111|\t}\n112|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
