{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6b3","stream":{"kind":"session","id":"01a0aeac-09f8-71f3-ab2b-385c63463936"},"sequence":436,"recorded_at":1780531400000867,"record_type":"event","durability":"durable","causation_id":"1b8b656f-1678-46e7-bb3f-f3a0982a1bf8","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"1b8b656f-1678-46e7-bb3f-f3a0982a1bf8","run_stream":{"kind":"run","id":"1b8b656f-1678-46e7-bb3f-f3a0982a1bf8"},"call_id":"call_01a0aead6faf723e991918707ed13b14","text":"{\n  \"chunk_id\": \"exec-15-1\",\n  \"command\": \"task-board spawn directives \\\"$TASK_BOARD_RUN_ID\\\" 2>&1 | head -n 20; echo \\\"===REFRESH-HELP===\\\"; task-board worktree refresh-candidate --help 2>&1 | head -n 40\",\n  \"description\": \"Check directives and refresh-candidate usage\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Active Goal: none (run is not goal-bound)\\nNo directives recorded for RUN-260917-6d15e6\\n===REFRESH-HELP===\\nExplicit recovery for an initial or rework leaf whose checkpoint diverged from current trunk.\\nRequires a live tracked producer for the initial or rework leaf and its exclusive Story lease.\\nAn initial leaf must provably have no CR; unknown or corrupt CR reads refuse.\\nThe complete working candidate is preserved exactly; incoming content must already\\nhave been combined by its producer. Staged changes and pending reviews refuse.\\nCheckpoints are replayed with signing in an isolated workspace. Durable intent\\nallows retry after branch, index or metadata interruption. Recovery never accepts\\na candidate: normal producer handoff and independent review are still required.\\nFor a regular-file conflict, prepare --replay-resolutions from the retained\\nreplay worktree parent directory resolution-template.json. Bind each resolution to REBASE_HEAD,\\nits unmerged path and the SHA-256 of the explicit replacement content. The tool\\nreplays from the unchanged original checkpoints and signs continuation; never\\nhand-commit the retained replay or edit workspace registry records.\\n\\nUsage:\\n  task-board worktree refresh-candidate <ELEMENT-ID> [flags]\\n\\nFlags:\\n  -h, --help                        help for refresh-candidate\\n      --replay-resolutions string   JSON file of checkpoint-bound conflict resolutions\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\",\n  \"original_output_bytes\": 2005,\n  \"original_output_tokens\": 502,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
