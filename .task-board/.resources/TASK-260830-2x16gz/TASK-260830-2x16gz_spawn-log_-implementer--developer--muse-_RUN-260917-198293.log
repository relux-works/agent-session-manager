\\njoint_test.go\\njoint.go\\nlifecycle_test.go\\nlock_init_test.go\\nlock_unix.go\\nlock_windows.go\\nmutations.py\\npath_pair.go\\nprofile_checks.go\\nprofile_test.go\\nprofile_verify.go\\nprofile.go\\nrotate.go\\ntransact.go\\ntrust_decode.go\\ntrust_encode.go\\ntrust_test.go\\ntrust.go\\n\\ninternal/rpcwire/:\\nenvelope_test.go\\nenvelope.go\\nhello.go\\ninventory.go\\nmutations.py\\nREADME.md\\ntestdata\\n===\\n{\\n  \\\"mode\\\": \\\"local\\\",\\n  \\\"local\\\": {\\n    \\\"board_dir\\\": \\\".task-board\\\"\\n  },\\n  \\\"version_control\\\": {\\n    \\\"confirm\\\": true,\\n    \\\"desired_commit_time\\\": \\\"current real time; AX does not backdate commits\\\"\\n  },\\n  \\\"spawn\\\": {\\n    \\\"enabled\\\": true,\\n    \\\"max_parallel\\\": 20,\\n    \\\"ceilings\\\": {\\n      \\\"contract_version\\\": \\\"spawn-policy-v4\\\",\\n      \\\"codex\\\": {\\n        \\\"entries\\\": [\\n          {\\n            \\\"criterion\\\": \\\"equal\\\",\\n            \\\"model\\\": \\\"gpt-6-astra\\\",\\n            \\\"reasoning_effort\\\": \\\"medium\\\"\\n          },\\n          {\\n            \\\"criterion\\\": \\\"equal\\\",\\n            \\\"model\\\": \\\"gpt-6-astra\\\",\\n            \\\"reasoning_effort\\\": \\\"high\\\"\\n          }\\n        ],\\n        \\\"resolution_model\\\": \\\"gpt-6-astra\\\",\\n        \\\"adjustment_confirmation\\\": \\\"none\\\",\\n        \\\"fast_mode\\\": true,\\n        \\\"roles\\\": {\\n          \\\"reviewer\\\": {\\n            \\\"entries\\\": [\\n              {\\n                \\\"criterion\\\": \\\"equal\\\",\\n                \\\"model\\\": \\\"gpt-6-astra\\\",\\n                \\\"reasoning_effort\\\": \\\"low\\\"\\n              },\\n              {\\n                \\\"criterion\\\": \\\"equal\\\",\\n                \\\"model\\\": \\\"gpt-6-astra\\\",\\n                \\\"reasoning_effort\\\": \\\"medium\\\"\\n              }\\n            ],\\n            \\\"resolution_model\\\": \\\"gpt-6-astra\\\",\