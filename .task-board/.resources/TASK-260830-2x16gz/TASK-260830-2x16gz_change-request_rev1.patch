+			if err := awaitErr(t, served); !errors.Is(err, hosttrust.ErrStaleGeneration) && !errors.Is(err, hosttrust.ErrAuthorizationRefused) {
+				t.Fatalf("Serve = %v", err)
+			}
+		}
+		if handler.count() != 1 {
+			t.Fatalf("handler calls = %d", handler.count())
+		}
