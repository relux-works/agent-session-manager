+		sent := make(chan error, 1)
+		go func() { sent <- s.Send(bytes.Repeat([]byte{'x'}, MaxLineBytes)) }()
+		cancel()
+		if err = <-sent; !errors.Is(err, context.Canceled) {
+			t.Fatal(err)
+		}
+		if s.cmd.ProcessState == nil {
+			t.Fatal("not reaped")
+		}
