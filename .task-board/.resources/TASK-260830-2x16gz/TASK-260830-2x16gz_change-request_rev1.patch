+				t.Fatalf("Call = %v", err)
+			}
+			assertLocalFailure(t, err, "incompatible_protocol", 6)
+		case <-time.After(30 * time.Second):
+			t.Fatal("Call did not return")
+		}
+		census.assertUnchanged(t, f)
+	})
+}
