+func TestHostileReplayNonceFreshness(t *testing.T) {
+	seen := map[string]struct{}{}
+	for i := 0; i < 256; i++ {
+		nonce := rpcwire.NewNonce()
+		if len(nonce) < 22 {
+			t.Fatalf("nonce %d too short: %q", i, nonce)
+		}
+		if _, duplicate := seen[nonce]; duplicate {
+			t.Fatalf("duplicate nonce at draw %d", i)
+		}
+		seen[nonce] = struct{}{}
+	}
+}
