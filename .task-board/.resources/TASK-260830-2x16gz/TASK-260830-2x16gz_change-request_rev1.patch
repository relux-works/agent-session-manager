+			t.Fatalf("generation %d -> %d, want exactly one commit", before.Generation, mid.Generation)
+		}
+		if _, _, err := f.storeA.Rotate(hostA, time.Now().UTC()); err == nil {
+			t.Fatal("second rotation admitted before revocation")
