+func lookPath(t *testing.T, names ...string) (string, bool) {
+	t.Helper()
+	for _, name := range names {
+		if path, err := exec.LookPath(name); err == nil {
+			return path, true
+		}
+		if filepath.IsAbs(name) {
+			if info, err := os.Stat(name); err == nil && !info.IsDir() && info.Mode()&0o111 != 0 {
+				return name, true
+			}
+		}
+	}
+	return "", false
+}
