and\n101|// assigned-scope admission refuses an unowned section and prints its gap.\n102|type unownedSection struct {\n103|\tKey      string `json:\"key\"`\n104|\tGap      string `json:\"gap\"`\n105|\tEvidence string `json:\"evidence\"`\n106|}\n107|\n108|type registrySource struct {\n109|\tRepository     string `json:\"repository\"`\n110|\tRelease        string `json:\"release\"`\n111|\tCommit         string `json:\"commit\"`\n112|\tDocumentPath   string `json:\"document_path\"`\n113|\tDocumentSHA256 string `json:\"document_sha256\"`\n114|}\n115|\n116|type acceptanceCase struct {\n117|\tID         string          `json:\"id\"`\n118|\tProduction codeReference   `json:\"production\"`\n119|\tTests      []codeReference `json:\"tests\"`\n120|}\n121|\n122|type ownershipGroup struct {\n123|\tKind            ownershipKind      `json:\"kind\"`\n124|\tKeys            []string           `json:\"keys\"`\n125|\tProduction      codeReference      `json:\"production\"`\n126|\tAcceptanceCases []string           `json:\"acceptance_cases\"`\n127|\tCoverage        coverageLevel      `json:\"coverage,omitempty\"`\n128|\tGap             string             `json:\"gap,omitempty\"`\n129|\tClauses         []dischargedClause `json:\"clauses,omitempty\"`\n130|}\n131|\n132|// coverageLevel is how much of a bound section a binding claims to discharge.\n133|// The claim is not taken on trust: the level is recomputed from the clauses the\n134|// binding enumerates against the clause inventory the pinned specification\n135|// itself carries for that section, and a claim that differs from the measured\n136|// level is refused.\n137|type coverageLevel string\n138|\n139|const (\n140|\t// coverageFull means every normative clause the pinned section carries is\n141|\t// enumerated with a verified excerpt and an acceptance owner.\n142|\tcoverageFull coverageLevel = \"full\"\n143|\t// coveragePartial means at least half of them are.\n144|\tcoveragePartial coverageLevel = \"partial\"\n145|\t// coverageSliver means fewer than half are: the binding implements a corner\n146|\t// of the section it is registered against.\n147|\tcoverageSliver coverageLevel = \"sliver\"\n148|\t// coverageUnevidenced means the binding enumerates no clause at all. It says\n149|\t// the registry makes no clause-level claim, not that the implementation\n150|\t// covers nothing.\n151|\tcoverageUnevidenced coverageLevel = \"unevidenced\"\n152|\t// coverageUnmeasured means normativeKeywordPattern finds no clause line\n153|\t// under the section's heading or its subheadings, so the gate cannot\n154|\t// measure the section's obligations at all.\n155|\t//\n156|\t// It is deliberately NOT called \"declarative\", and it does NOT mean the\n157|\t// section carries no obligation. Nineteen of the 157 pinned headings are in\n158|\t// this class and every one of them has a substantive body: Section 15.2 is a\n159|\t// eighteen-row normative exit-code registry and Section 7.3 is the closed\n(more lines below)","final_result":true}}}
