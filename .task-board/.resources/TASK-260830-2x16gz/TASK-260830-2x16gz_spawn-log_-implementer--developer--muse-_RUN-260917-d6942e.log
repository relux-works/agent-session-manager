{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9fd","stream":{"kind":"session","id":"01a0af73-29fd-7160-afe2-ea4709b071c8"},"sequence":857,"recorded_at":1780531400001709,"record_type":"event","durability":"durable","causation_id":"c700f538-d9a2-4b6d-a603-1bdd1bb0d054","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"c700f538-d9a2-4b6d-a603-1bdd1bb0d054","run_stream":{"kind":"run","id":"c700f538-d9a2-4b6d-a603-1bdd1bb0d054"},"task_stream":{"kind":"task","id":"01a0af77-e2d0-78d1-8d48-9f872b627be2"},"task_id":"01a0af77-e2d0-78d1-8d48-9f872b627be2","event":{"kind":"output","task_id":"01a0af77-e2d0-78d1-8d48-9f872b627be2","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/base-refresh/replay-1650024183/worktree/internal/traceability/traceability.go`.\n(379 line(s) above)\n380|\t// Coverage is measured over every registered section binding, not only the\n381|\t// assigned ones, so a sliver planted anywhere in the registry reddens both\n382|\t// production entry points rather than only the repository-wide one. It is\n383|\t// measured before ownership resolution so that a section moved to the\n384|\t// unowned disclosure to dodge the catalog's owner requirement is reported\n385|\t// as that dodge rather than as an ordinary missing owner.\n386|\tcoverage, err := verifySectionCoverage(document, registry.Ownership, acceptanceIDs)\n387|\tif err != nil {\n388|\t\treturn Report{}, err\n389|\t}\n390|\townedSections := make(map[string]struct{}, len(coverage))\n391|\tfor key := range coverage {\n392|\t\townedSections[key] = struct{}{}\n393|\t}\n394|\tunowned, err := verifyUnownedSections(\n395|\t\tregistry.UnownedSections, expected[ownershipSectionBinding], requiredSectionBindings, ownedSections)\n396|\tif err != nil {\n397|\t\treturn Report{}, err\n398|\t}\n399|\n400|\towned, err := verifyOwnershipGroups(checker, registry.Ownership, acceptanceIDs, expected, required, selectedSectionBindings)\n401|\tif err != nil {\n402|\t\treturn Report{}, err\n403|\t}\n404|\n405|\tfor _, binding := range assignedBindings {\n406|\t\tfor _, key := range binding.Keys {\n407|\t\t\tif entry, disclosed := unowned[key]; disclosed {\n408|\t\t\t\treturn Report{}, fail(\n409|\t\t\t\t\t\"assigned section %q binding %q is recorded unowned: %s\", binding.Scope, key, entry.Gap)\n410|\t\t\t}\n411|\t\t\tif _, ok := owned[ownershipSectionBinding][key]; !ok {\n412|\t\t\t\treturn Report{}, fail(\"assigned section %q binding %q has no scoped implementation owner\", binding.Scope, key)\n413|\t\t\t}\n414|\t\t\t// Admission requires full and nothing else. coverageUnmeasured is\n415|\t\t\t// deliberately not admitted: the gate cannot see the section's\n416|\t\t\t// obligations, and admitting on an unverifiable justification\n417|\t\t\t// sentence would be self-minted evidence for exactly the class this\n418|\t\t\t// gate exists to refuse. Absence of a scanner-visible clause is a\n419|\t\t\t// failure to measure, not a measured absence of obligation.\n420|\t\t\tmeasured := coverage[key]\n421|\t\t\tif measured.Level != coverageFull {\n422|\t\t\t\treturn Report{}, fail(\n423|\t\t\t\t\t\"assigned section %q binding %q discharges %s normative clauses, which is %s coverage; assigned-scope admission requires full: %s\",\n424|\t\t\t\t\tbinding.Scope, key, measured.Ratio(), measured.Level, measured.Gap)\n425|\t\t\t}\n426|\t\t}\n427|\t}\n428|\tfor _, contract := range compatibilityCatalog.Contracts {\n429|\t\tkey := contractKey(contract.Name, string(contract.ID))\n430|\t\tif _, ok := owned[ownershipContract][key]; !ok {\n431|\t\t\treturn Report{}, fail(\"compatibility contract %q has no implementation owner\", key)\n432|\t\t}\n433|\t}\n434|\n435|\tcanonical, err := json.Marshal(registry)\n436|\tif err != nil {\n437|\t\treturn Report{}, fail(\"encode canonical ownership registry: %v\", err)\n438|\t}\n439|\tdigest := sha256.Sum256(canonical)\n440|\tgotDigest := hex.EncodeToString(digest[:])\n441|\tif gotDigest != reviewedOwnershipCanonicalSHA256 {\n442|\t\treturn Report{}, fail(\"ownership registry projection digest %s differs from reviewed %s\", gotDigest, reviewedOwnershipCanonicalSHA256)\n443|\t}\n444|\n445|\treport := Report{\n446|\t\tContracts:              len(expected[ownershipContract]),\n447|\t\tNormativeSections:      len(expected[ownershipNormativeSection]),\n448|\t\tAcceptanceCases:        len(acceptanceIDs),\n449|\t\tFixtures:               len(expected[ownershipFixture]),\n450|\t\tCompatibilityContracts: len(compatibilityCatalog.Contracts),\n451|\t\tAssignedScopes:         len(assignedBindings),\n452|\t\tSectionBindings:        len(coverage),\n453|\t\tUnownedSections:        len(unowned),\n454|\t}\n455|\tfor _, measured := range coverage {\n456|\t\treport.NormativeClauses += measured.Total\n457|\t\treport.DischargedClauses += measured.Discharged\n458|\t\tswitch measured.Level {\n459|\t\tcase coverageFull:\n(more lines below)","final_result":true}}}
