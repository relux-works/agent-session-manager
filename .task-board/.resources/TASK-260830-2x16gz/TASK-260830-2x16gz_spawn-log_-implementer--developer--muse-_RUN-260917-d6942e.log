{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c825","stream":{"kind":"session","id":"01a0af73-29fd-7160-afe2-ea4709b071c8"},"sequence":621,"recorded_at":1780531400001237,"record_type":"event","durability":"durable","causation_id":"c700f538-d9a2-4b6d-a603-1bdd1bb0d054","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"c700f538-d9a2-4b6d-a603-1bdd1bb0d054","run_stream":{"kind":"run","id":"c700f538-d9a2-4b6d-a603-1bdd1bb0d054"},"task_stream":{"kind":"task","id":"01a0af75-9aec-7682-b73c-7f2c98b6ac77"},"task_id":"01a0af75-9aec-7682-b73c-7f2c98b6ac77","event":{"kind":"output","task_id":"01a0af75-9aec-7682-b73c-7f2c98b6ac77","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/base-refresh/replay-2841418579/worktree/internal/secprim/census_test.go`.\n(199 line(s) above)\n200|\tfor _, word := range secretTokens {\n201|\t\tif strings.Contains(lowered, word) {\n202|\t\t\tsites[pkg+\"|\"+kind+\"|\"+name] = true\n203|\t\t}\n204|\t}\n205|}\n206|\n207|// admitLocal records a function-local binding under every strong token:\n208|// every token except \"token\", which the JSON decoder vocabulary owns.\n209|func admitLocal(sites map[string]bool, pkg, name string) {\n210|\tlowered := strings.ToLower(name)\n211|\tfor _, word := range secretTokens {\n212|\t\tif word == \"token\" {\n213|\t\t\tcontinue\n214|\t\t}\n215|\t\tif strings.Contains(lowered, word) {\n216|\t\t\tsites[pkg+\"|local|\"+name] = true\n217|\t\t}\n218|\t}\n219|}\n220|\n221|// maxLiteralRunes bounds the literal arm: a literal longer than this is\n222|// prose documentation, not an identifier, key, or diagnostic atom, and\n223|// rostering it would turn every explanatory paragraph into a site. The\n224|// longest rostered diagnostic is 55 runes; the bound sits at 80.\n225|const maxLiteralRunes = 80\n226|\n227|// admitLiteral records a string literal under every token it contains.\n228|// The literal is unquoted when it parses; an unparseable literal is\n229|// recorded raw rather than dropped. Literals past maxLiteralRunes are\n230|// documentation prose, not sites.\n231|func admitLiteral(sites map[string]bool, pkg, raw string) {\n232|\tvalue, err := strconv.Unquote(raw)\n233|\tif err != nil {\n234|\t\tvalue = raw\n235|\t}\n236|\tif len([]rune(value)) > maxLiteralRunes {\n237|\t\treturn\n238|\t}\n239|\tlowered := strings.ToLower(value)\n240|\tfor _, word := range secretTokens {\n241|\t\tif strings.Contains(lowered, word) {\n242|\t\t\tsites[pkg+\"|lit|\"+value] = true\n243|\t\t}\n244|\t}\n245|}\n246|\n247|// TestSecretScanIgnoresComments pins the comment blindness both ways: a\n248|// token in a comment rosters nothing, so documentation cannot create\n249|// obligations, and (by construction of the syntax walk) nothing outside\n250|// code participates.\n251|func TestSecretScanIgnoresComments(t *testing.T) {\n252|\tt.Parallel()\n253|\tsyntax, err := parser.ParseFile(token.NewFileSet(), \"comment.go\", \"package x\\n// password credential token secret\\nvar clean = 1\\n\", 0)\n254|\tif err != nil {\n255|\t\tt.Fatal(err)\n256|\t}\n257|\tsites := map[string]bool{}\n258|\tast.Inspect(syntax, func(node ast.Node) bool {\n259|\t\tif identifier, ok := node.(*ast.Ident); ok {\n260|\t\t\tadmitName(sites, \"x\", \"decl\", identifier.Name)\n261|\t\t}\n262|\t\tif literal, ok := node.(*ast.BasicLit); ok && literal.Kind == token.STRING {\n263|\t\t\tadmitLiteral(sites, \"x\", literal.Value)\n264|\t\t}\n265|\t\treturn true\n266|\t})\n267|\tif len(sites) != 0 {\n268|\t\tt.Fatalf(\"comment tokens rostered sites %v\", sites)\n269|\t}\n270|}\n271|\n272|// secretSiteRow pairs derived secret sites sharing one disposition with\n273|// the witnesses that prove it. Every derived site appears in exactly one\n274|// row: a derived site with no row fails as unaccounted, and a row naming\n275|// a site production no longer derives fails as orphaned.\n276|type secretSiteRow struct {\n277|\tsites       []string\n278|\tdisposition string\n279|\twitnesses   []string // \"package.TestName\" entries, verified to exist\n280|}\n281|\n282|// secretSiteRows is the reviewed disposition half of the census. The\n283|// denominator is derived (deriveSecretSites); these rows say what each\n284|// site is and which test proves it stays that way.\n285|func secretSiteRows() []secretSiteRow {\n286|\treturn []secretSiteRow{\n287|\t\t{\n288|\t\t\tsites: []string{\n289|\t\t\t\t\"axerror|lit|access_token\", \"axerror|lit|api_key\",\n290|\t\t\t\t\"axerror|lit|cookie\", \"axerror|lit|cookies\",\n291|\t\t\t\t\"axerror|lit|credential\", \"axerror|lit|credentials\",\n292|\t\t\t\t\"axerror|lit|env_secret\", \"axerror|lit|environment secret\",\n293|\t\t\t\t\"axerror|lit|environment_secret\", \"axerror|lit|oauth_token\",\n294|\t\t\t\t\"axerror|lit|passphrase\", \"axerror|lit|password\",\n295|\t\t\t\t\"axerror|lit|private_key\", \"axerror|lit|refresh_token\",\n296|\t\t\t\t\"axerror|lit|secret\", \"axerror|lit|secrets\",\n297|\t\t\t\t\"axerror|lit|session_token\", \"axerror|lit|ssh_private_key\",\n298|\t\t\t\t\"axerror|lit|subscription_token\",\n299|\t\t\t\t\"axerror|lit|raw_transcript\", \"axerror|lit|transcript\",\n300|\t\t\t\t\"axerror|lit|scrollback\", \"axerror|lit|terminal_scrollback\",\n301|\t\t\t\t\"axerror|lit|raw transcript\",\n302|\t\t\t},\n303|\t\t\tdisposition: \"members of the axerror excludedDetailKeys refusal table: a Structured Error detail \" +\n304|\t\t\t\t\"naming one is refused before encoding, so no credential, transcript, environment secret, or \" +\n305|\t\t\t\t\"bundle key reaches the wire as a detail\",\n306|\t\t\twitnesses: []string{\"secprim.TestSecretAxerrorTableRefused\"},\n307|\t\t},\n308|\t\t{\n309|\t\t\t// The derived members of the secprim sensitiveKeyNames\n310|\t\t\t// scrubber table. \"auth_json\", \"authorization\", and \"dotenv\"\n311|\t\t\t// are table members too, but no instrument token fires on\n312|\t\t\t// them (the Authority blind spot pinned by\n313|\t\t\t// TestSecretScanBlindSpot); TestSensitiveKeyListIsReviewed\n314|\t\t\t// pins the whole table of 27 including those three, so the\n315|\t\t\t// table cannot gain or lose a member without reddening\n316|\t\t\t// there.\n317|\t\t\tsites: []string{\n318|\t\t\t\t\"secprim|lit|access_token\", \"secprim|lit|api_key\", \"secprim|lit|apikey\",\n319|\t\t\t\t\"secprim|lit|auth_token\", \"secprim|lit|bearer_token\",\n320|\t\t\t\t\"secprim|lit|client_secret\", \"secprim|lit|cookie\", \"secprim|lit|cookies\",\n321|\t\t\t\t\"secprim|lit|credential\", \"secprim|lit|credentials\",\n322|\t\t\t\t\"secprim|lit|env_secret\", \"secprim|lit|environment_secret\", \"secprim|lit|oauth_token\",\n323|\t\t\t\t\"secprim|lit|passphrase\", \"secprim|lit|passwd\", \"secprim|lit|password\",\n324|\t\t\t\t\"secprim|lit|private_key\", \"secprim|lit|refresh_token\", \"secprim|lit|secret\",\n325|\t\t\t\t\"secprim|lit|secrets\", \"secprim|lit|session_token\", \"secprim|lit|ssh_private_key\",\n326|\t\t\t\t\"secprim|lit|subscription_token\", \"secprim|lit|token\",\n327|\t\t\t},\n328|\t\t\tdisposition: \"members of the secprim sensitiveKeyNames scrubber table: a free-text key=value pair \" +\n329|\t\t\t\t\"naming one has its value masked by Redact before persistence or display\",\n330|\t\t\twitnesses: []string{\"secprim.TestSensitiveKeyListIsReviewed\", \"secprim.TestRedactSensitivePairs\"},\n331|\t\t},\n332|\t\t{\n333|\t\t\tsites: []string{\n334|\t\t\t\t\"secprim|decl|minSecretRunes\", \"secprim|decl|privateKeyBeginPrefix\",\n335|\t\t\t\t\"secprim|decl|privateKeyBeginSuffix\", \"secprim|decl|privateKeyEndPrefix\",\n336|\t\t\t\t\"secprim|decl|redactPrivateKeyBlocks\", \"secprim|decl|redactedPrivateKey\",\n337|\t\t\t\t\"secprim|param|secrets\",\n338|\t\t\t},\n339|\t\t\tdisposition: \"the scrubber machinery itself: private-key block shapes, the corpus bound, and the \" +\n340|\t\t\t\t\"caller-known secret values Redact removes rather than stores\",\n341|\t\t\twitnesses: []string{\"secprim.TestRedactPrivateKeyBlocks\", \"secprim.TestRedactCorpusValues\"},\n342|\t\t},\n343|\t\t{\n344|\t\t\tsites: []string{\n345|\t\t\t\t\"terminalbackend|lit|attach_credential\", \"terminalbackend|lit|relay_credential\",\n346|\t\t\t\t\"terminalbackend|lit|provider_credential\", \"terminalbackend|lit|evidence_secret\",\n347|\t\t\t\t\"terminalbackend|lit|credential_detail\", \"terminalbackend|lit|token\",\n348|\t\t\t\t\"terminalbackend|lit|scrollback\",\n349|\t\t\t},\n350|\t\t\tdisposition: \"members of the terminal replication-exclusion vocabulary: classified sensitive-owner-only \" +\n351|\t\t\t\t\"or forbidden, never transferred as live authority\",\n352|\t\t\twitnesses: []string{\"terminalbackend.TestReplicationClassificationIsClosed\"},\n353|\t\t},\n354|\t\t{\n355|\t\t\tsites: []string{\n356|\t\t\t\t\"terminalbackend|decl|credentialRealmCapability\",\n357|\t\t\t\t\"terminalbackend|lit|credential_capable_execution_realm\",\n358|\t\t\t\t\"terminalbackend|lit|credential_sentinel\",\n359|\t\t\t\t\"terminalbackend|lit|scrollback_retention\",\n360|\t\t\t},\n361|\t\t\tdisposition: \"capability vocabulary words: they name the credential-capable realm, its sentinel \" +\n362|\t\t\t\t\"evidence member, and the scrollback-retention policy, whose values are booleans, enums, and \" +\n363|\t\t\t\t\"retention facts, never secrets or transcript content\",\n364|\t\t\twitnesses: []string{\"terminalbackend.TestParseManifestAdmitsClosedFixture\"},\n365|\t\t},\n366|\t\t{\n367|\t\t\tsites: []string{\"sessadapter|lit|credential\"},\n368|\t\t\tdisposition: \"member of the closed capture-class vocabulary: naming the class a capture plan \" +\n369|\t\t\t\t\"excludes, not a credential value\",\n370|\t\t\twitnesses: []string{\"sessadapter.TestDecodeCapturePlanItemRules\"},\n371|\t\t},\n372|\t\t{\n373|\t\t\tsites: []string{\n374|\t\t\t\t\"provhost|lit|rollback_token\",\n375|\t\t\t\t\"provhost|lit|status rollback_token is not a string\",\n376|\t\t\t\t\"provhost|lit|status rollback_token is shorter than 256 bits\",\n377|\t\t\t\t\"provhost|lit|unknown status carries plan, token, or discovery\",\n378|\t\t\t\t\"provhost|lit|prepared status misses plan, token, or discovery\",\n379|\t\t\t\t\"provhost|lit|terminal status misses plan or discovery or keeps a token\",\n380|\t\t\t\t\"provhost|local|token\",\n381|\t\t\t},\n382|\t\t\tdisposition: \"the closed status member plus its charset/length gate: the decoded rollback token is \" +\n383|\t\t\t\t\"checked for 256-bit base64url shape only, and every refusal names the member, never the value\",\n384|\t\t\twitnesses: []string{\"provhost.TestDecodeStatusOutcomeRefusesMalformedBodies\"},\n385|\t\t},\n386|\t\t{\n387|\t\t\tsites: []string{\n388|\t\t\t\t\"scalar|lit|must not contain userinfo credentials\",\n389|\t\t\t\t\"scalar|lit|must not contain a password or token\",\n390|\t\t\t\t\"scalar|local|password\",\n391|\t\t\t},\n392|\t\t\tdisposition: \"the sanitized-Git-URL refusal: userinfo credentials and passwords are refused at parse, \" +\n393|\t\t\t\t\"and the decoded local is compared and dropped, never rendered\",\n394|\t\t\twitnesses: []string{\"scalar.TestSanitizedGitURLRefusesCredentialsAndLocalSchemes\"},\n395|\t\t},\n396|\t\t{\n397|\t\t\tsites: []string{\n398|\t\t\t\t\"canonicaljson|lit|contains_secrets\",\n399|\t\t\t\t\"canonicaljson|lit|Session Record Launch Plan contains_secrets must be false\",\n(more lines below)","final_result":true}}}
