5|\t\t\tsites: []string{\n426|\t\t\t\t\"config|field|TranscriptGrepEnabled\",\n427|\t\t\t\t`config|lit|toml:\"transcript_grep_enabled\"`,\n428|\t\t\t},\n429|\t\t\tdisposition: \"the explicit transcript-grep opt-in switch: an admitted boolean member, defaulting \" +\n430|\t\t\t\t\"to false, gating source-local bounded grep per Section 16.7 — not a transcript value\",\n431|\t\t\twitnesses: []string{\"config.TestLoadAcceptsExactV2DirectoryAndV3TerminalShapes\"},\n432|\t\t},\n433|\t\t{\n434|\t\t\tsites: []string{\n435|<<<<<<< HEAD\n436|\t\t\t\t\"provhost|decl|unrestrictedTokens\",\n437|\t\t\t},\n438|\t\t\tdisposition: \"the launch projection's refused argv-word set: Section 7.7 flag spellings plus \" +\n439|\t\t\t\t\"the codex alias and the Pi report string, matched as exact argv elements — words on a \" +\n440|\t\t\t\t\"command line, never a security token, credential, or secret value\",\n441|\t\t\twitnesses: []string{\"provhost.TestUnrestrictedTokensDeriveFromTable\"},\n442|=======\n443|\t\t\t\t\"config|decl|ErrMigrationV4Credential\",\n444|\t\t\t\t\"config|decl|checkCredentialWindow\",\n445|\t\t\t\t\"config|decl|previewCredentialHex\",\n446|\t\t\t\t\"config|field|CredentialID\",\n447|\t\t\t\t\"config|lit|configuration 4.0.0 selected credential is not admitted\",\n448|\t\t\t\t\"config|lit|credential outside validity window\",\n449|\t\t\t\t\"config|lit|mesh.host_channel.credential_id\",\n450|\t\t\t\t\"config|lit|select credential\",\n451|\t\t\t\t`config|lit|toml:\"credential_id\"`,\n452|\t\t\t\t\"config|local|credentialHex\",\n453|\t\t\t\t\"config|param|credentialID\",\n454|\t\t\t},\n455|\t\t\tdisposition: \"Configuration 4.0.0 credential-binding vocabulary: the mesh.host_channel.credential_id \" +\n456|\t\t\t\t\"digest member, its TOML key, the selected-credential plumbing (parameter, local, helpers) and \" +\n457|\t\t\t\t\"the static refusal clauses that name the member, never a value. CredentialID carries a SHA-256 \" +\n458|\t\t\t\t\"digest of public leaf bytes; validity windows compare parsed certificate times; custody files \" +\n459|\t\t\t\t\"are asserted outside replication by hosttrust tests\",\n460|\t\t\twitnesses: []string{\"config.TestDecodeConfiguration4\", \"config.TestPreviewV4CredentialGates\", \"config.TestApplyV4CustodyFailure\", \"hosttrust.TestNoSecretReplication\"},\n461|\t\t},\n462|\t\t{\n463|\t\t\tsites: []string{\n464|\t\t\t\t\"hosttrust|decl|CredentialEntry\",\n465|\t\t\t\t\"hosttrust|field|CredentialID\",\n466|\t\t\t\t\"hosttrust|field|LocalCredentialID\",\n467|\t\t\t\t`hosttrust|lit|,\"credential_id\":`,\n468|\t\t\t\t\"hosttrust|lit|credential_id\",\n469|\t\t\t\t\"hosttrust|local|credentialHex\",\n470|\t\t\t\t\"hosttrust|param|credentialHex\",\n471|\t\t\t\t\"hosttrust|param|credentialID\",\n472|\t\t\t\t\"hosttrust|param|newCredentialID\",\n473|\t\t\t},\n474|\t\t\tdisposition: \"credential-entry digest plumbing: entries bind a host UUID to SHA-256 digests of \" +\n475|\t\t\t\t\"public leaf/SPKI/root bytes plus the bytes themselves for profile verification. Digests name \" +\n476|\t\t\t\t\"public material; the private scalar never enters an entry, and formatting an entry renders \" +\n477|\t\t\t\t\"a static string\",\n478|\t\t\twitnesses: []string{\"hosttrust.TestDecodeTrustRoundTrip\", \"hosttrust.TestTrustRedaction\"},\n479|\t\t},\n480|\t\t{\n481|\t\t\tsites: []string{\n482|\t\t\t\t\"hosttrust|decl|CredentialDir\",\n483|\t\t\t\t\"hosttrust|decl|credentialsDir\",\n484|\t\t\t\t\"hosttrust|decl|privateKeyFile\",\n485|\t\t\t\t\"hosttrust|lit|/credentials/\",\n486|\t\t\t\t\"hosttrust|lit|credentials\",\n487|\t\t\t\t\"hosttrust|lit|resolve credential directory\",\n488|\t\t\t},\n489|\t\t\tdisposition: \"custody path vocabulary: the owner-only credentials directory layout and the \" +\n490|\t\t\t\t\"private-key filename constant. Paths are 0700/0600 verified at open; private-key.pem is \" +\n491|\t\t\t\t\"written once at issuance or rotation and asserted outside replication\",\n492|\t\t\twitnesses: []string{\"hosttrust.TestIssueSelfEnrollsActive\", \"hosttrust.TestNoSecretReplication\"},\n493|\t\t},\n494|\t\t{\n495|\t\t\tsites: []string{\n496|\t\t\t\t\"hosttrust|decl|ErrCredentialCustody\",\n497|\t\t\t\t\"hosttrust|decl|ErrCredentialProfile\",\n498|\t\t\t\t\"hosttrust|lit|decode credential_id\",\n499|\t\t\t\t\"hosttrust|lit|host credential custody check failed\",\n500|\t\t\t\t\"hosttrust|lit|host credential profile check failed\",\n501|\t\t\t\t\"hosttrust|lit|host credential revocation refused\",\n502|\t\t\t\t\"hosttrust|lit|host credential rotation refused\",\n503|\t\t\t\t\"hosttrust|lit|host trust credential entry\",\n504|\t\t\t\t\"hosttrust|lit|issue credential\",\n505|\t\t\t\t\"hosttrust|lit|issued host credential\",\n506|\t\t\t\t\"hosttrust|lit|retire credential\",\n507|\t\t\t\t\"hosttrust|lit|revoke credential\",\n508|\t\t\t\t\"hosttrust|lit|verify credential profile\",\n509|\t\t\t},\n510|\t\t\tdisposition: \"static refusal clauses and redacted renderings: operation names and error identities \" +\n511|\t\t\t\t\"that name the credential member, never a value. Renderings of entries, issued material and \" +\n512|\t\t\t\t\"requests emit fixed strings\",\n513|\t\t\twitnesses: []string{\"hosttrust.TestVerifyProfileRefusals\", \"hosttrust.TestTrustRedaction\", \"hosttrust.TestDecodeTrustRefusals\"},\n514|\t\t},\n515|\t\t{\n516|\t\t\tsites: []string{\n517|\t\t\t\t\"hosttrust|decl|IssueCredential\",\n518|\t\t\t\t\"hosttrust|decl|IssuedCredential\",\n519|\t\t\t},\n520|\t\t\tdisposition: \"local issuance entry points: fresh P-256 keys and profile-exact certificates with \" +\n521|\t\t\t\t\"the root key destroyed after signing. The leaf private key leaves issuance only into the \" +\n522|\t\t\t\t\"owner-only custody file\",\n523|\t\t\twitnesses: []string{\"hosttrust.TestIssueCredentialProfile\", \"hosttrust.TestIssueSelfEnrollsActive\"},\n524|\t\t},\n525|\t\t{\n526|\t\t\tsites: []string{\"hosttrust|decl|cleanupCredentialDirectory\"},\n527|\t\t\tdisposition: \"the failed-issua