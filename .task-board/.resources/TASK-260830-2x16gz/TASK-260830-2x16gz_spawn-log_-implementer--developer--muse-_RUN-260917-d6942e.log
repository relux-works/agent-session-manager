{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6ef","stream":{"kind":"session","id":"01a0af73-29fd-7160-afe2-ea4709b071c8"},"sequence":466,"recorded_at":1780531400000927,"record_type":"event","durability":"durable","causation_id":"c700f538-d9a2-4b6d-a603-1bdd1bb0d054","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"c700f538-d9a2-4b6d-a603-1bdd1bb0d054","run_stream":{"kind":"run","id":"c700f538-d9a2-4b6d-a603-1bdd1bb0d054"},"task_stream":{"kind":"task","id":"01a0af74-a8e7-7141-8991-ea44fe518c77"},"task_id":"01a0af74-a8e7-7141-8991-ea44fe518c77","event":{"kind":"output","task_id":"01a0af74-a8e7-7141-8991-ea44fe518c77","chunk":"{\n  \"chunk_id\": \"exec-14-1\",\n  \"command\": \"task-board worktree refresh-candidate --help 2>&1 | head -n 80\",\n  \"description\": \"Learn refresh-candidate usage\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Explicit recovery for an initial or rework leaf whose checkpoint diverged from current trunk.\\nRequires a live tracked producer for the initial or rework leaf and its exclusive Story lease.\\nAn initial leaf must provably have no CR; unknown or corrupt CR reads refuse.\\nThe complete working candidate is preserved exactly; incoming content must already\\nhave been combined by its producer. Staged changes and pending reviews refuse.\\nCheckpoints are replayed with signing in an isolated workspace. Durable intent\\nallows retry after branch, index or metadata interruption. Recovery never accepts\\na candidate: normal producer handoff and independent review are still required.\\nFor a regular-file conflict, prepare --replay-resolutions from the retained\\nreplay worktree parent directory resolution-template.json. Bind each resolution to REBASE_HEAD,\\nits unmerged path and the SHA-256 of the explicit replacement content. The tool\\nreplays from the unchanged original checkpoints and signs continuation; never\\nhand-commit the retained replay or edit workspace registry records.\\n\\nUsage:\\n  task-board worktree refresh-candidate <ELEMENT-ID> [flags]\\n\\nFlags:\\n  -h, --help                        help for refresh-candidate\\n      --replay-resolutions string   JSON file of checkpoint-bound conflict resolutions\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\",\n  \"original_output_bytes\": 1899,\n  \"original_output_tokens\": 475,\n  \"truncated\": false\n}","final_result":true}}}
