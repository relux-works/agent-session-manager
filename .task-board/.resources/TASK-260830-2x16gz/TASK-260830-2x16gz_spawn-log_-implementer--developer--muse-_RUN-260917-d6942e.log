ial\\\",\\\\n'), repr(theirs_side[:80])\\nassert theirs_side.endswith('witnesses: []string{\\\"hosttrust.TestIssueSelfEnrollsActive\\\", \\\"hosttrust.TestNoSecretReplication\\\"},\\\\n'), repr(theirs_side[-120:])\\nassert post.startswith(\\\"\\\\t\\\\t},\\\\n\\\"), repr(post[:20])\\n# Merge: trunk (HEAD) row first, then checkpoint rows as new rows.\\njoin = \\\"\\\\t\\\\t},\\\\n\\\\t\\\\t{\\\\n\\\\t\\\\t\\\\tsites: []string{\\\\n\\\"\\nmerged = pre + head_side + join + theirs_side + post\\nassert \\\"<<<<<<\\\" not in merged and \\\">>>>>>\\\" not in merged and \\\"\\\\n=======\\\\n\\\" not in merged\\nwith open(\\\"/tmp/rev3/census_test.resolved\\\", \\\"w\\\", encoding=\\\"utf-8\\\", newline=\\\"\\\") as f:\\n    f.write(merged)\\nprint(\\\"bytes:\\\", len(merged.encode(\\\"utf-8\\\")))\\nprint(\\\"sha256:\\\", hashlib.sha256(merged.encode(\\\"utf-8\\\")).hexdigest())\\nEOF\\nPYTHONDONTWRITEBYTECODE=1 python3 /tmp/rev3/merge_census.py\",\n  \"description\": \"Mechanically merge censustest conflict\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"bytes: 28287\\nsha256: 7a99d2da0aad39657c98d42f109c7672a01b1b84ce1f7988c6129781dc1bace5\\n\",\n  \"original_output_bytes\": 86,\n  \"original_output_tokens\": 22,\n  \"truncated\": false\n}","final_result":true}}}
