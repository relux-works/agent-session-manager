end((k, \\\"want-either\\\"))\\nassert not bad, bad\\nprint(\\\"ownership 3-way OK: leafmod=%d trunkmod=%d total=%d\\\" % (len(leafmod), len(trunkmod), len(mb)))\\ndef cases(x): return {a[\\\"id\\\"]: json.dumps(a, sort_keys=True) for a in x[\\\"acceptance_cases\\\"]}\\nma, ba, oa, ta = cases(d), cases(base), cases(ours), cases(theirs)\\nassert set(ma) == set(oa) | set(ta), sorted(set(ma) ^ (set(oa) | set(ta)))\\nleafmoda = {k for k in set(oa) & set(ba) if oa[k] != ba[k]}\\ntrunkmoda = {k for k in set(ta) & set(ba) if ta[k] != ba[k]}\\nprint(\\\"acceptance mods: leaf=%s trunk=%s\\\" % (sorted(leafmoda), sorted(trunkmoda)))\\nassert not (leafmoda & trunkmoda)\\nfor k in ma:\\n    if k in leafmoda: assert ma[k] == oa[k], k\\n    elif k in trunkmoda: assert ma[k] == ta[k], k\\n    else: assert ma[k] == oa.get(k, ma[k]) and ma[k] == ta.get(k, ma[k]), k\\nprint(\\\"acceptance 3-way OK: total=%d\\\" % len(ma))\\ndef un(x): return {u[\\\"key\\\"]: json.dumps(u, sort_keys=True) for u in x[\\\"unowned_sections\\\"]}\\nmu, bu, ou, tu = un(d), un(base), un(ours), un(theirs)\\nassert set(mu) == set(ou) & set(tu), sorted(set(mu) ^ (set(ou) & set(tu)))\\nfor k in mu:\\n    assert mu[k] == ou[k] == tu[k], k\\nprint(\\\"unowned OK:\\\", sorted(mu))\\nassert d[\\\"format\\\"] == base[\\\"format\\\"] and d[\\\"format_version\\\"] == base[\\\"format_version\\\"] and d[\\\"source\\\"] == base[\\\"source\\\"]\\nprint(\\\"header OK\\\")\\nEOF\\nPYTHONDONTWRITEBYTECODE=1 python3 /tmp/rev3/verify_registry.py\",\n  \"description\": \"Verify registry with correct 3-way logic\",\n  \"exit_code\": 1,\n  \"terminal_status\": \"failed\",\n  \"terminal_reason\": \"process exited with status 1\",\n  \"output\": \"ownership 3-way OK: leafmod=2 trunkmod=7 total=70\\nacceptance mods: leaf=[] trunk=[]\\nacceptance 3-way OK: total=132\\nTraceback (most recent call last):\\n  File \\\"/tmp/rev3/verify_registry.py\\\", line 39, in <module>\\n    assert mu[k] == ou[k] == tu[k], k\\n           ^^^^^^^^^^^^