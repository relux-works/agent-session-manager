{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c84f","stream":{"kind":"session","id":"01a0af73-29fd-7160-afe2-ea4709b071c8"},"sequence":642,"recorded_at":1780531400001279,"record_type":"event","durability":"durable","causation_id":"c700f538-d9a2-4b6d-a603-1bdd1bb0d054","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"c700f538-d9a2-4b6d-a603-1bdd1bb0d054","run_stream":{"kind":"run","id":"c700f538-d9a2-4b6d-a603-1bdd1bb0d054"},"task_stream":{"kind":"task","id":"01a0af75-e7cd-71f0-8015-95f804ed07ec"},"task_id":"01a0af75-e7cd-71f0-8015-95f804ed07ec","event":{"kind":"output","task_id":"01a0af75-e7cd-71f0-8015-95f804ed07ec","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/base-refresh/replay-2841418579/worktree/internal/secprim/census_test.go`.\n(535 line(s) above)\n536|// TestSecretSiteRosterIsComplete requires every derived secret site to\n537|// carry exactly one row and every row site to resolve to a derived site.\n538|// Removing a secret-bearing declaration, or adding one, reddens here in\n539|// exactly one direction.\n540|func TestSecretSiteRosterIsComplete(t *testing.T) {\n541|\tderived := deriveSecretSites(t)\n542|\trows := secretSiteRows()\n543|\tseen := map[string]bool{}\n544|\tfor _, row := range rows {\n545|\t\tfor _, site := range row.sites {\n546|\t\t\tif !derived[site] {\n547|\t\t\t\tt.Fatalf(\"orphaned census row site %q: production derives no such site\", site)\n548|\t\t\t}\n549|\t\t\tif seen[site] {\n550|\t\t\t\tt.Fatalf(\"duplicate census row site %q: one disposition per site\", site)\n551|\t\t\t}\n552|\t\t\tseen[site] = true\n553|\t\t}\n554|\t}\n555|\tvar missing []string\n556|\tfor site := range derived {\n557|\t\tif !seen[site] {\n558|\t\t\tmissing = append(missing, site)\n559|\t\t}\n560|\t}\n561|\tsort.Strings(missing)\n562|\tif len(missing) > 0 {\n563|\t\tt.Fatalf(\"derived secret sites with no disposition row:\\n  %s\", strings.Join(missing, \"\\n  \"))\n564|\t}\n565|}\n566|\n567|// TestSecretSiteWitnessesExist verifies every cited witness names a real\n568|// test function in its package, parsed from that package's test sources:\n569|// a renamed or deleted witness reddens here instead of citing a ghost.\n570|func TestSecretSiteWitnessesExist(t *testing.T) {\n571|\tt.Parallel()\n572|\tneeded := map[string]map[string]bool{}\n573|\tfor _, row := range secretSiteRows() {\n574|\t\tfor _, witness := range row.witnesses {\n575|\t\t\tparts := strings.Split(witness, \".\")\n576|\t\t\tif len(parts) != 2 {\n577|\t\t\t\tt.Fatalf(\"witness %q is not package.Test shaped\", witness)\n578|\t\t\t}\n579|\t\t\tif needed[parts[0]] == nil {\n580|\t\t\t\tneeded[parts[0]] = map[string]bool{}\n581|\t\t\t}\n582|\t\t\tneeded[parts[0]][parts[1]] = true\n583|\t\t}\n584|\t}\n585|\tfor pkg, names := range needed {\n586|\t\tfound := testFuncNames(t, pkg)\n587|\t\tfor name := range names {\n588|\t\t\tif !found[name] {\n589|\t\t\t\tt.Errorf(\"witness %s.%s does not exist; the census cites a ghost\", pkg, name)\n590|\t\t\t}\n591|\t\t}\n592|\t}\n593|}\n594|\n595|// testFuncNames parses a package's test files for test function names.\n596|// The walk is over declarations, so a name mentioned in a comment or a\n597|// string cannot satisfy it.\n598|func testFuncNames(t *testing.T, pkg string) map[string]bool {\n599|\tt.Helper()\n600|\tdirectory := filepath.Join(\"..\", pkg)\n601|\tif pkg == \"secprim\" {\n602|\t\tdirectory = \".\"\n603|\t}\n604|\tentries, err := os.ReadDir(directory)\n605|\tif err != nil {\n606|\t\tt.Fatalf(\"read %s: %v\", directory, err)\n607|\t}\n608|\tfound := map[string]bool{}\n609|\tscanned := false\n610|\tfor _, entry := range entries {\n611|\t\tname := entry.Name()\n612|\t\tif entry.IsDir() || !strings.HasSuffix(name, \"_test.go\") {\n613|\t\t\tcontinue\n614|\t\t}\n615|\t\tcontents, err := os.ReadFile(filepath.Join(directory, name))\n616|\t\tif err != nil {\n617|\t\t\tt.Fatal(err)\n618|\t\t}\n619|\t\tscanned = true\n620|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), name, contents, 0)\n621|\t\tif err != nil {\n622|\t\t\tt.Fatal(err)\n623|\t\t}\n624|\t\tfor _, declaration := range syntax.Decls {\n625|\t\t\tfunction, ok := declaration.(*ast.FuncDecl)\n626|\t\t\tif !ok || function.Recv != nil {\n627|\t\t\t\tcontinue\n628|\t\t\t}\n629|\t\t\tif strings.HasPrefix(function.Name.Name, \"Test\") {\n630|\t\t\t\tfound[function.Name.Name] = true\n631|\t\t\t}\n632|\t\t}\n633|\t}\n634|\tif !scanned {\n635|\t\tt.Fatalf(\"scanned no test files in %s; the witness check is blind\", pkg)\n636|\t}\n637|\treturn found\n638|}\n639|\n640|// TestSecretTokensAreProven requires every instrument token to fire on at\n641|// least one derived site: a token that matches nothing is dead ceremony,\n642|// and removing a live token orphans its sites in the roster above.\n643|func TestSecretTokensAreProven(t *testing.T) {\n644|\tt.Parallel()\n645|\tderived := deriveSecretSites(t)\n646|\tfor _, word := range secretTokens {\n647|\t\tfires := false\n648|\t\tfor site := range derived {\n649|\t\t\tif strings.Contains(strings.ToLower(site), word) {\n650|\t\t\t\tfires = true\n651|\t\t\t\tbreak\n652|\t\t\t}\n653|\t\t}\n654|\t\tif !fires {\n655|\t\t\tt.Errorf(\"token %q fires on no derived site; the instrument is blind to its class\", word)\n656|\t\t}\n657|\t}\n658|}\n659|\n660|// excludedAxerrorKeys parses the excludedDetailKeys table out of the\n661|// axerror package source, so the re-drive below follows the table instead\n662|// of retyping it: an added key is driven automatically, and a removed key\n663|// cannot be driven against a stale copy.\n664|func excludedAxerrorKeys(t *testing.T) []string {\n665|\tt.Helper()\n666|\tcontents, err := os.ReadFile(filepath.Join(\"..\", \"axerror\", \"details.go\"))\n667|\tif err != nil {\n668|\t\tt.Fatal(err)\n669|\t}\n670|\tsyntax, err := parser.ParseFile(token.NewFileSet(), \"details.go\", contents, 0)\n671|\tif err != nil {\n672|\t\tt.Fatal(err)\n673|\t}\n674|\tvar keys []string\n675|\tast.Inspect(syntax, func(node ast.Node) bool {\n676|\t\tspec, ok := node.(*ast.ValueSpec)\n677|\t\tif !ok || len(spec.Names) != 1 || spec.Names[0].Name != \"excludedDetailKeys\" {\n678|\t\t\treturn true\n679|\t\t}\n680|\t\tif len(spec.Values) != 1 {\n681|\t\t\tt.Fatal(\"excludedDetailKeys has no single initializer; the derivation is blind\")\n682|\t\t}\n683|\t\ttable, ok := spec.Values[0].(*ast.CompositeLit)\n684|\t\tif !ok {\n685|\t\t\tt.Fatal(\"excludedDetailKeys is not a composite literal; the derivation is blind\")\n686|\t\t}\n687|\t\tfor _, element := range table.Elts {\n688|\t\t\tpair, ok := element.(*ast.KeyValueExpr)\n689|\t\t\tif !ok {\n690|\t\t\t\tt.Fatal(\"excludedDetailKeys carries a non-pair element; the derivation is blind\")\n691|\t\t\t}\n692|\t\t\tliteral, ok := pair.Key.(*ast.BasicLit)\n693|\t\t\tif !ok || literal.Kind != token.STRING {\n694|\t\t\t\tt.Fatal(\"excludedDetailKeys carries a non-literal key; the derivation is blind\")\n695|\t\t\t}\n696|\t\t\tkey, err := strconv.Unquote(literal.Value)\n697|\t\t\tif err != nil {\n698|\t\t\t\tt.Fatal(err)\n699|\t\t\t}\n700|\t\t\tkeys = append(keys, key)\n701|\t\t}\n702|\t\treturn false\n703|\t})\n704|\tif len(keys) == 0 {\n705|\t\tt.Fatal(\"derived no excluded detail keys; the scanner is broken, not the table\")\n706|\t}\n707|\treturn keys\n708|}\n709|\n710|// TestSecretAxerrorTableRefused drives every key of the axerror exclusion\n711|// table through the production Structured Error constructor and requires\n712|// a refusal: the gate is proven on the table it owns, including the keys\n713|// (auth_json, bundle_*, transcript shapes) no census token fires on.\n714|func TestSecretAxerrorTableRefused(t *testing.T) {\n715|\tt.Parallel()\n716|\tfor _, key := range excludedAxerrorKeys(t) {\n717|\t\t_, err := axerror.New(axerror.Spec{\n718|\t\t\tVersion: axerror.Version100,\n719|\t\t\tCode:    \"provider_process_failed\",\n720|\t\t\tMessage: \"probe\",\n721|\t\t\tIDs:     axerror.NoIDs(),\n722|\t\t\tDetails: axerror.Details{key: \"value\"},\n723|\t\t})\n724|\t\tif err == nil {\n725|\t\t\tt.Errorf(\"axerror.New admitted excluded detail key %q\", key)\n726|\t\t\tcontinue\n727|\t\t}\n728|\t\tif !errors.Is(err, axerror.ErrInvalidDetails) {\n729|\t\t\tt.Errorf(\"axerror.New(%q) = %v, want ErrInvalidDetails\", key, err)\n730|\t\t}\n731|\t}\n732|}\n733|\n734|// TestSecretScanBlindSpot pins the deliberate Authority blind spot: bare\n735|// \"auth\"-substring declarations (authority identifiers, authorization\n736|// enums) are protocol vocabulary, never credential values, and the\n737|// instrument does not roster them. A secret named only with \"auth\" and\n738|// none of the instrument tokens would be missed; that residue is stated\n739|// here, not hidden.\n740|func TestSecretScanBlindSpot(t *testing.T) {\n741|\tt.Parallel()\n742|\tsites := map[string]bool{}\n743|\tadmitName(sites, \"x\", \"decl\", \"ScanRootAuthorityIDs\")\n744|\tadmitName(sites, \"x\", \"field\", \"AuthSubject\")\n745|\tadmitLocal(sites, \"x\", \"auth\")\n746|\tif len(sites) != 0 {\n747|\t\tt.Fatalf(\"blind-spot declarations rostered sites %v; the bound moved\", sites)\n748|\t}\n749|\t// And the instrument still sees the class it must roster.\n750|\tprove := map[string]bool{}\n751|\tadmitName(prove, \"x\", \"decl\", \"DBPassword\")\n752|\tif len(prove) != 1 {\n753|\t\tt.Fatalf(\"instrument missed a password declaration: %v\", prove)\n754|\t}\n755|}","final_result":true}}}
