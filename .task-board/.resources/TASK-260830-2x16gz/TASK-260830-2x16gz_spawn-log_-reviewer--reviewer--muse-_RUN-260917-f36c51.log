 section %q binding %q discharges %s normative clauses, which is %s coverage; assigned-scope admission requires full: %s\",\n420|\t\t\t\t\tbinding.Scope, key, measured.Ratio(), measured.Level, measured.Gap)\n421|\t\t\t}\n422|\t\t}\n423|\t}\n424|\tfor _, contract := range compatibilityCatalog.Contracts {\n425|\t\tkey := contractKey(contract.Name, string(contract.ID))\n426|\t\tif _, ok := owned[ownershipContract][key]; !ok {\n427|\t\t\treturn Report{}, fail(\"compatibility contract %q has no implementation owner\", key)\n428|\t\t}\n429|\t}\n430|\n431|\tcanonical, err := json.Marshal(registry)\n432|\tif err != nil {\n433|\t\treturn Report{}, fail(\"encode canonical ownership registry: %v\", err)\n434|\t}\n435|\tdigest := sha256.Sum256(canonical)\n436|\tgotDigest := hex.EncodeToString(digest[:])\n437|\tif gotDigest != reviewedOwnershipCanonicalSHA256 {\n438|\t\treturn Report{}, fail(\"ownership registry projection digest %s differs from reviewed %s\", gotDigest, reviewedOwnershipCanonicalSHA256)\n439|\t}\n440|\n441|\treport := Report{\n442|\t\tContracts:              len(expected[ownershipContract]),\n443|\t\tNormativeSections:      len(expected[ownershipNormativeSection]),\n444|\t\tAcceptanceCases:        len(acceptanceIDs),\n445|\t\tFixtures:               len(expected[ownershipFixture]),\n446|\t\tCompatibilityContracts: len(compatibilityCatalog.Contracts),\n447|\t\tAssignedScopes:         len(assignedBindings),\n448|\t\tSectionBindings:        len(coverage),\n449|\t\tUnownedSections:        len(unowned),\n450|\t}\n451|\tfor _, measured := range coverage {\n452|\t\treport.NormativeClauses += measured.Total\n453|\t\treport.DischargedClauses += measured.Discharged\n454|\t\tswitch measured.Level {\n455|\t\tcase coverageFull:\n456|\t\t\treport.FullCoverage++\n457|\t\tcase coveragePartial:\n458|\t\t\treport.PartialCoverage++\n459|\t\tcase coverageSliver:\n(more lines below)","final_result":true}}}
