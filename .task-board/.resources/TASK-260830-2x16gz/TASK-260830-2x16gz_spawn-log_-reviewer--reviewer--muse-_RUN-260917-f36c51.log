and ranks them by affinity\\\"},{\\\"name\\\":\\\"producer_role\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Opt-in exact producer-role filter\\\"},{\\\"name\\\":\\\"provider\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Provider lineage\\\",\\\"enum\\\":[\\\"codex\\\",\\\"claude\\\"]},{\\\"name\\\":\\\"kind\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Output kind\\\",\\\"enum\\\":[\\\"project\\\",\\\"role\\\",\\\"task\\\"]},{\\\"name\\\":\\\"state\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"default\\\":\\\"ready\\\",\\\"description\\\":\\\"Comma-separated lifecycle states\\\"},{\\\"name\\\":\\\"skip\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"default\\\":0,\\\"description\\\":\\\"Candidates to skip\\\"},{\\\"name\\\":\\\"take\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"default\\\":20,\\\"description\\\":\\\"Maximum candidates to return\\\"}],\\\"examples\\\":[\\\"context_candidates(element=TASK-260728-abc123, role=developer, provider=codex) { selection }\\\",\\\"context_candidates(element=TASK-260728-abc123, producer_role=solution-architect) { selection }\\\"]},\\\"context_retention\\\":{\\\"description\\\":\\\"Retention outlook:\\n[tool output bounded: strategy=head, original_bytes=44944, visible_bytes=40000]\\n<system-reminder>\\nFull output saved to: /Users/iv/.local/share/muse/sessions/2026/09/17/01a0aece-231f-7991-85b6-ba6bca7c9720/tool-outputs/01a0aece-528e-78b0-8d89-678c030b33d3/call_01a0aece4d897333a45bdf4c603ac6a0-bash.txt\\nFull output is longer than the visible window.\\nUse bash tools like head, tail, cat, sed, or grep to inspect and search the full output.\\n</system-reminder>\",\n  \"original_output_bytes\": 44944,\n  \"original_output_tokens\": 11236,\n  \"truncated\": true\n}","final_result":true}}}
