{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c773","stream":{"kind":"session","id":"01a0aece-231f-7991-85b6-ba6bca7c9720"},"sequence":532,"recorded_at":1780531400001059,"record_type":"event","durability":"durable","causation_id":"e70d9852-000b-4121-b33e-b53bebd87eae","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e70d9852-000b-4121-b33e-b53bebd87eae","run_stream":{"kind":"run","id":"e70d9852-000b-4121-b33e-b53bebd87eae"},"task_stream":{"kind":"task","id":"01a0aecf-1eb4-7bd0-8dd9-bb2f44ddc407"},"task_id":"01a0aecf-1eb4-7bd0-8dd9-bb2f44ddc407","event":{"kind":"output","task_id":"01a0aecf-1eb4-7bd0-8dd9-bb2f44ddc407","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1kiyj6/worktree/internal/hostchannel/channel.go`.\n(599 line(s) above)\n600|func CredentialFromIssued(issued hosttrust.IssuedCredential) (tls.Certificate, error) {\n601|\tkey, err := x509.ParsePKCS8PrivateKey(issued.LeafKeyDER)\n602|\tif err != nil {\n603|\t\treturn tls.Certificate{}, fmt.Errorf(\"%w: %w\", ErrInvalidConfig, err)\n604|\t}\n605|\tleaf, err := x509.ParseCertificate(issued.LeafDER)\n606|\tif err != nil {\n607|\t\treturn tls.Certificate{}, fmt.Errorf(\"%w: %w\", ErrInvalidConfig, err)\n608|\t}\n609|\tswitch key := key.(type) {\n610|\tcase *ecdsa.PrivateKey:\n611|\t\tif !key.PublicKey.Equal(leaf.PublicKey) {\n612|\t\t\treturn tls.Certificate{}, fmt.Errorf(\"%w: leaf key mismatch\", ErrInvalidConfig)\n613|\t\t}\n614|\tdefault:\n615|\t\treturn tls.Certificate{}, fmt.Errorf(\"%w: unexpected leaf key type\", ErrInvalidConfig)\n616|\t}\n617|\treturn tls.Certificate{Certificate: [][]byte{bytes.Clone(issued.LeafDER)}, PrivateKey: key, Leaf: leaf}, nil\n618|}\n619|\n620|// WatchGeneration blocks until the committed generation moves past the\n621|// bound one, the snapshot becomes unreadable, or the context ends. A moved\n622|// generation returns hosttrust.ErrStaleGeneration: the caller must close\n623|// the bound stream. Filesystem notifications alone never satisfy this\n624|// watch; only committed reads do. A nil error is never returned: context\n625|// expiry surfaces as the context error.\n626|func WatchGeneration(ctx context.Context, store *hosttrust.Store, bound uint64, poll time.Duration) error {\n627|\tif ctx == nil || store == nil {\n628|\t\treturn ErrInvalidConfig\n629|\t}\n630|\tif poll <= 0 {\n631|\t\tpoll = DefaultWatchPoll\n632|\t}\n633|\tticker := time.NewTicker(poll)\n634|\tdefer ticker.Stop()\n635|\tfor {\n636|\t\tselect {\n637|\t\tcase <-ctx.Done():\n638|\t\t\treturn ctx.Err()\n639|\t\tcase <-ticker.C:\n640|\t\t\tsnapshot, err := store.ReadSnapshot()\n641|\t\t\tif err != nil {\n642|\t\t\t\treturn fmt.Errorf(\"%w: generation read failed: %v\", ErrTransportFailure, err)\n643|\t\t\t}\n644|\t\t\tif snapshot.Generation != bound {\n645|\t\t\t\treturn fmt.Errorf(\"host channel generation moved: %w\", hosttrust.ErrStaleGeneration)\n646|\t\t\t}\n647|\t\t}\n648|\t}\n649|}","final_result":true}}}
