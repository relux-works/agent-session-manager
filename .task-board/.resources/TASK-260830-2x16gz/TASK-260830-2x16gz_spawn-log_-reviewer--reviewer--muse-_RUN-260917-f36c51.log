rs\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\",\\\"required\\\":true},{\\\"name\\\":\\\"item\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Checklist item number (1-based)\\\",\\\"required\\\":true}],\\\"examples\\\":[\\\"uncheck_item(TASK-260218-abc123, item=2)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":true},\\\"undefer_cr\\\":{\\\"description\\\":\\\"Clear the deferral marker set by defer_cr; the revision is landing backlog again\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID carrying the Change Request\\\",\\\"required\\\":true},{\\\"name\\\":\\\"revision\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Change Request revision being un-deferred (expected-revision CAS)\\\",\\\"required\\\":true}],\\\"examples\\\":[\\\"undefer_cr(STORY-260908-1s0ekw, revision=1)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false},\\\"unlink\\\":{\\\"description\\\":\\\"Remove dependency between elements\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element that was blocked\\\",\\\"required\\\":true},{\\\"name\\\":\\\"blocked_by\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element that was blocking\\\",\\\"required\\\":true}],\\\"examples\\\":[\\\"unlink(TASK-260218-abc123, blocked_by=TASK-260218-def456)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false},\\\"update_resource\\\":{\\\"description\\\":\\\"Replace an existing resource on an element\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\",\\\"required\\\":true},{\\\"name\\\":\\\"name\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Resource name to replace\\\",\\\"re