{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ce0b","stream":{"kind":"session","id":"01a0aece-231f-7991-85b6-ba6bca7c9720"},"sequence":1376,"recorded_at":1780531400002747,"record_type":"event","durability":"durable","causation_id":"e70d9852-000b-4121-b33e-b53bebd87eae","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e70d9852-000b-4121-b33e-b53bebd87eae","run_stream":{"kind":"run","id":"e70d9852-000b-4121-b33e-b53bebd87eae"},"task_stream":{"kind":"task","id":"01a0aedb-ff16-7b90-953f-1d787a54d15c"},"task_id":"01a0aedb-ff16-7b90-953f-1d787a54d15c","event":{"kind":"output","task_id":"01a0aedb-ff16-7b90-953f-1d787a54d15c","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1kiyj6/worktree/internal/hostchannel/hostile_test.go`.\n(65 line(s) above)\n66|// hostileCensus snapshots both fixture state trees for before/after\n67|// comparison. A channel run performs no file writes; revocation tests use\n68|// the trust-transition-aware assertion instead.\n69|type hostileCensus struct {\n70|\ta map[string][]byte\n71|\tb map[string][]byte\n72|}\n73|\n74|func censusHostile(t *testing.T, f *fixture) hostileCensus {\n75|\tt.Helper()\n76|\treturn hostileCensus{a: snapshotTree(t, f.dirA), b: snapshotTree(t, f.dirB)}\n77|}\n78|\n79|func (c hostileCensus) assertUnchanged(t *testing.T, f *fixture) {\n80|\tt.Helper()\n81|\tassertTreeEqual(t, f.dirA, c.a)\n82|\tassertTreeEqual(t, f.dirB, c.b)\n83|}\n84|\n85|func assertTreeEqual(t *testing.T, root string, before map[string][]byte) {\n86|\tt.Helper()\n87|\tafter := snapshotTree(t, root)\n88|\tif len(after) != len(before) {\n89|\t\tt.Fatalf(\"state file set changed under %s: %d -> %d files\", root, len(before), len(after))\n90|\t}\n91|\tfor name, want := range before {\n92|\t\tgot, ok := after[name]\n93|\t\tif !ok || !bytes.Equal(got, want) {\n94|\t\t\tt.Fatalf(\"state file %s changed\", name)\n95|\t\t}\n96|\t}\n97|}\n98|\n99|// hostileTimeouts bounds every phase of a hostile exchange so a hanging peer\n100|// fails the vector instead of the suite. Production defaults (10 s / 300 s)\n101|// stay covered by TestLocalCredentialRefusals/default_timeouts.\n102|func hostileTimeouts(client hostchannel.ClientConfig, server hostchannel.ServerConfig) (hostchannel.ClientConfig, hostchannel.ServerConfig) {\n103|\tclient.HandshakeTimeout = 5 * time.Second\n104|\tclient.HelloTimeout = 5 * time.Second\n105|\tclient.RequestTimeout = 5 * time.Second\n106|\tserver.HandshakeTimeout = 5 * time.Second\n107|\tserver.HelloTimeout = 5 * time.Second\n108|\tserver.RequestTimeout = 5 * time.Second\n109|\treturn client, server\n110|}\n111|\n112|// countingHandler answers post-hello calls, records how many ran, and keeps\n113|// the last binding for unchanged-binding assertions.\n114|type countingHandler struct {\n115|\tcalls   atomic.Int64\n116|\tlast    atomic.Value // hostchannel.Binding\n117|\tanswer  json.RawMessage\n118|\trefuse  map[string]bool\n119|\tonCall  func(binding hostchannel.Binding)\n120|\tentered chan<- struct{}\n121|\trelease <-chan struct{}\n122|}\n123|\n124|func (h *countingHandler) handler() hostchannel.Handler {\n125|\treturn func(_ context.Context, request rpcwire.Request, binding hostchannel.Binding, _ func(func() error) error) (json.RawMessage, error) {\n126|\t\th.calls.Add(1)\n127|\t\th.last.Store(binding)\n128|\t\tif h.entered != nil {\n129|\t\t\tselect {\n130|\t\t\tcase h.entered <- struct{}{}:\n131|\t\t\tdefault:\n132|\t\t\t}\n133|\t\t}\n134|\t\tif h.release != nil {\n135|\t\t\t<-h.release\n136|\t\t}\n137|\t\tif h.onCall != nil {\n138|\t\t\th.onCall(binding)\n139|\t\t}\n140|\t\tif h.refuse[request.Operation()] {\n141|\t\t\treturn nil, errors.New(\"hostile handler refused \" + request.Operation())\n142|\t\t}\n143|\t\tif len(h.answer) > 0 {\n144|\t\t\treturn h.answer, nil\n145|\t\t}\n146|\t\treturn json.RawMessage(`{}`), nil\n147|\t}\n148|}\n149|\n150|func (h *countingHandler) count() int { return int(h.calls.Load()) }\n151|\n152|func (h *countingHandler) binding() (hostchannel.Binding, bool) {\n153|\traw := h.last.Load()\n154|\tif raw == nil {\n155|\t\treturn hostchannel.Binding{}, false\n156|\t}\n157|\tbinding, ok := raw.(hostchannel.Binding)\n158|\treturn binding, ok\n159|}\n160|\n161|// reissue mints a fresh credential for an already-enrolled host UUID through\n162|// the production issuer: same host, new keys, new root. It is enrolled\n163|// nowhere until an explicit Enroll commits it.\n164|func reissue(t *testing.T, hostID string) hosttrust.IssuedCredential {\n165|\tt.Helper()\n(more lines below)","final_result":true}}}
