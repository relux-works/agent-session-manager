 error) {\n307|\tvar decoded ownershipRegistry\n308|\tdecoder := json.NewDecoder(bytes.NewReader(candidate))\n309|\tdecoder.DisallowUnknownFields()\n310|\tif err := decoder.Decode(&decoded); err != nil {\n311|\t\treturn ownershipRegistry{}, fail(\"decode ownership registry: %v\", err)\n312|\t}\n313|\tvar trailing any\n314|\tif err := decoder.Decode(&trailing); !errors.Is(err, io.EOF) {\n315|\t\tif err == nil {\n316|\t\t\treturn ownershipRegistry{}, fail(\"decode ownership registry: multiple JSON values\")\n317|\t\t}\n318|\t\treturn ownershipRegistry{}, fail(\"decode ownership registry trailing data: %v\", err)\n319|\t}\n320|\treturn decoded, nil\n321|}\n322|\n323|func verifyOwnership(\n324|\trepository fs.FS,\n325|\tdocument *specdoc.Document,\n326|\tregistry ownershipRegistry,\n327|\tmanifest specpin.Manifest,\n328|\tcurrentCatalog catalog.Catalog,\n329|\tcompatibilityCatalog catalog.Catalog,\n330|\tassignedBindings []assignedSectionBinding,\n331|) (Report, error) {\n332|\tif registry.Format != ownershipFormat || registry.FormatVersion != ownershipFormatVersion {\n333|\t\treturn Report{}, fail(\"unsupported ownership registry format %q version %d\", registry.Format, registry.FormatVersion)\n334|\t}\n335|\tsource := registry.Source\n336|\tif source.Repository != manifest.Source.Repository ||\n337|\t\tsource.Release != manifest.Source.Release ||\n338|\t\tsource.Commit != manifest.Source.Commit ||\n339|\t\tsource.DocumentPath != manifest.Source.Document.Path ||\n340|\t\tsource.DocumentSHA256 != manifest.Source.Document.SHA256 {\n341|\t\treturn Report{}, fail(\"ownership registry source differs from verified normative lock\")\n342|\t}\n343|\n344|\texpected := map[ownershipKind]map[string]struct{}{\n345|\t\townershipContract:         expectedContracts(manifest.Contracts),\n346|\t\townershipNormativeSection: expectedNormativeSections(manifest, currentCatalog),\n347|\t\townershipSectionBinding:   expectedSectionBindingInventory(),\n348|\t\townershipFixture:          expectedFixtures(manifest, currentCatalog),\n349|\t}\n350|\trequiredSectionBindings, err := expectedCatalogSectionBindings(currentCatalog)\n351|\tif err != nil {\n352|\t\treturn Report{}, err\n353|\t}\n354|\trequired := map[ownershipKind]map[string]struct{}{\n355|\t\townershipContract:         expected[ownershipContract],\n356|\t\townershipNormativeSection: expected[ownershipNormativeSection],\n357|\t\townershipSectionBinding:   requiredSectionBindings,\n358|\t\townershipFixture:          expected[ownershipFixture],\n359|\t}\n360|\tselectedSectionBindings := map[string]struct{}(nil)\n361|\tif assignedBindings != nil {\n362|\t\trequired = cloneOwnershipSets(expected)\n363|\t\tselectedSectionBindings = make(map[string]struct{})\n364|\t\tfor _, binding := range assignedBindings {\n365|\t\t\tfor _, key := range binding.Keys {\n366|\t\t\t\tselectedSectionBindings[key] = struct{}{}\n367|\t\t\t}\n368|\t\t}\n369|\t\trequired[ownershipSectionBinding] = make(map[string]struct{})\n370|\t}\n371|\tchecker := newSourceChecker(repository)\n372|\tacceptanceIDs, err := verifyAcceptanceCases(checker, registry.AcceptanceCases)\n373|\tif err != nil {\n374|\t\treturn Report{}, err\n375|\t}\n376|\t// Coverage is measured over every registered section binding, not only the\n377|\t// assigned ones, so a sliver planted anywhere in the registry reddens both\n378|\t// production entry points rather than only the repository-wide one. It is\n379|\t// measured before ownership resolution so that a section moved to the\n380|\t// unowned disclosure to dodge the catalog's owner requirement is reported\n381|\t// as that dodge rather than as an ordinary missing owner.\n382|\tcoverage, err := verifySectionCoverage(document, registry.Ownership, acceptanceIDs)\n383|\tif err != nil {\n384|\t\treturn Report{}, err\n385|\t}\n386|\townedSections := make(map[string]struct{}, len(coverage))\n387|\tfor key := range coverage {\n388|\t\townedSections[key] = struct{}{}\n389|\t}\n390|\tunowned, err := verifyUnownedSect