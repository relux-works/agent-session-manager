n1740|\t\t}\n1741|\t\tcorrupt[len(corrupt)/2] ^= 0xFF\n1742|\t\tif err := os.WriteFile(path, corrupt, 0o600); err != nil {\n1743|\t\t\tt.Fatalf(\"WriteFile: %v\", err)\n1744|\t\t}\n1745|\t\tdefer func() { _ = os.WriteFile(path, original, 0o600) }()\n1746|\t\tclientConn, serverConn := net.Pipe()\n1747|\t\tdefer clientConn.Close()\n1748|\t\tdefer serverConn.Close()\n1749|\t\t// A malformed store is an integrity failure, never an empty store:\n1750|\t\t// activation refuses before any byte moves.\n1751|\t\tserveErr := hostchannel.Serve(serverConn, f.serverConfig(echoHandler(json.RawMessage(`{}`))))\n1752|\t\tif !errors.Is(serveErr, hostchannel.ErrInvalidConfig) {\n1753|\t\t\tt.Fatalf(\"Serve = %v\", serveErr)\n1754|\t\t} else if !strings.Contains(serveErr.Error(), \"snapshot\") {\n1755|\t\t\tt.Fatalf(\"Serve = %v, want the snapshot integrity cause\", serveErr)\n1756|\t\t}\n1757|\t\tassertLocalFailure(t, serveErr, \"invalid_config\", 3)\n1758|\t\t// Restoring the bytes restores authority: nothing was silently\n1759|\t\t// repaired, migrated, or reported as absent.\n1760|\t\tif err := os.WriteFile(path, original, 0o600); err != nil {\n1761|\t\t\tt.Fatalf(\"WriteFile: %v\", err)\n1762|\t\t}\n1763|\t\tsnapshot, err := f.storeB.ReadSnapshot()\n1764|\t\tif err != nil {\n1765|\t\t\tt.Fatalf(\"ReadSnapshot after restore: %v\", err)\n1766|\t\t}\n1767|\t\tif len(snapshot.Trust.Entries) != 2 {\n1768|\t\t\tt.Fatalf(\"entries after restore = %d\", len(snapshot.Trust.Entries))\n1769|\t\t}\n(more lines below)","final_result":true}}}
