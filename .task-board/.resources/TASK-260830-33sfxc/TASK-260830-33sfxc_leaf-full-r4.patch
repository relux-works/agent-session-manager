+
+	"github.com/relux-works/agent-session-manager/internal/axerror"
+)
+
+// historicalCorpusDirectory holds the frozen envelopes this package's readers
+// must keep reading. They are checked-in bytes rather than objects a test
+// builds, because an envelope regenerated by today's writer proves that today's
+// writer and today's reader agree - which is a different and much weaker claim
+// than the one this corpus exists to make.
+const historicalCorpusDirectory = "testdata/historical"
+
+// historicalInvocation is one frozen observation of a completed `ax --json`
+// invocation: the exact stdout bytes an older writer produced, the command that
+// produced them, and the status the process exited with.
+//
+// Digest pins the file. Regenerating a fixture to make a test pass is the exact
+// failure this corpus is meant to catch, so changing the bytes has to be a
+// deliberate act that also moves the digest under review.
+type historicalInvocation struct {
+	file       string
+	digest     string
+	release    string
+	command    Command
+	exitStatus int
+
+	// refusal is the error today's reader must return for these bytes, or nil
+	// when the invocation must remain readable.
+	refusal error
+
+	// The machine answers a client must still get, for an admitted invocation.
+	succeeded      bool
+	code           axerror.Code
+	codeRegistered bool
+	retryable      bool
+	detailKeys     []string
+}
+
+// historicalCorpus is the reviewed corpus. Each entry names the specification
+// release whose writer could have produced the envelope, so an entry is a
+// compatibility claim about a published contract version rather than about a
+// file someone happened to add.
+var historicalCorpus = []historicalInvocation{
+	{
