+		{"schema_version", `"1.2.0"`},
+		{"code", `"observation_horizon_lost"`},
+		{"message", `"a second message"`},
+		{"exit_code", `9`},
+		{"retryable", `true`},
+		{"operation_id", `"0198f4c8-b180-7299-9273-1234567890ab"`},
+		{"session_id", `"0198f4c8-3e70-7a11-8a2b-1234567890ab"`},
+		{"details", `{"observed_sequence": "18"}`},
