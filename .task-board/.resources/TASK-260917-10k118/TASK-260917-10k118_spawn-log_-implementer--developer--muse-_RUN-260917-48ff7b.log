{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4d5","stream":{"kind":"session","id":"01a0b074-2d9a-7d23-a683-c8d705b137ba"},"sequence":197,"recorded_at":1780531400000389,"record_type":"event","durability":"durable","causation_id":"a105643e-74d8-47fc-98b0-dd8b6640f48f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a105643e-74d8-47fc-98b0-dd8b6640f48f","run_stream":{"kind":"run","id":"a105643e-74d8-47fc-98b0-dd8b6640f48f"},"call_id":"call_01a0b074ceb37767b224fea2836c42cd","text":"{\n  \"chunk_id\": \"exec-6-1\",\n  \"command\": \"task-board q 'TASK-260917-10k118' 2>&1 | head -n 100; echo \\\"===\\\"; task-board q --help 2>&1 | head -n 60\",\n  \"description\": \"Query task details\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"query error: an element ID is not an operation; use get(ID) { fields }\\n===\\nExecute queries against the board using a compact DSL.\\n\\nOperations:\\n  get(ID)              Get a single element by ID\\n  activity(ID, ...)    Read bounded, cursor-paginated element activity\\n  list(filters...)     List elements with filters\\n  count(filters...)    Count elements matching filters\\n  summary()            Board overview (counts + active/blocked)\\n  plan(scope?)         Execution phases; scope=[ID,ID,...] plans the union of subtrees\\n  agents(stale=N?)     Agent dashboard\\n  models(agent?)       Available models for spawn\\n  project_config()     Full active project board runtime config (always local)\\n  project_config(view=spawn-preflight, role=ROLE, agent=PROVIDER?)\\n                       Narrow effective child-spawn policy for one target\\n  provider_limits()    Machine-scoped provider rate-limit state (always local)\\n  provider_limits(identity=KEY|all_identities=true)\\n                       Report one indexed provider identity, or every one\\n  whoami()             Current remote URL and active user (always local)\\n  schema()             Introspect the full operations/fields/presets contract,\\n                       including the statement grammar (arguments, quoting,\\n                       projection, batching) under \\\"grammar\\\"\\n  schema(operation=NAME|mutation=NAME)\\n                       Return only one typed operation or mutation signature\\n                       plus a one-line \\\"syntax\\\" statement of the grammar\\n\\nField projection:\\n  { id status assignee }     Select specific fields\\n  { overview }               Use a base preset (minimal, default, overview, full, progress, planning)\\n  { observability-task }     Use project observability presets (project, epic, story, task)\\n  (omitted)                  Defaults to { id name status }\\n\\nBatching:\\n  Separate multiple queries with semicolons; results preserve source order\\n\\nSpawn policy projection:\\n  Full project_config reports the effective spawn-policy-v2/v3 contract,\\n  authority, normalized provider and role-effective policy, and exact config\\n  provenance. V2 additionally reports its frozen compatibility snapshot and a\\n  copy-ready v3 migration object; this is read-only evidence and never edits\\n  task-board.config.json. Spawn-preflight returns only the selected role policy\\n  and its actionable migration warning.\\n\\nOutput format:\\n  --format json       Standard JSON (default)\\n  --format compact    Compact tabular output (~40% fewer tokens)\\n                      plan() switches to the super-compact planning shape:\\n                      flat waves of IDs, one-line critical path, id->status map\\n\\nExamples:\\n  task-board q 'schema()'\\n  task-board q 'get(TASK-260211-abc) { id status assignee }'\\n  task-board q 'activity(TASK-260211-abc, limit=25, order=descending, view=effective)'\\n  task-board q 'list(type=task, status=development) { overview }'\\n  task-board q 'count(type=task, status=done)'\\n  task-board q 'summary()'\\n  task-board q 'summary() { observability-project }'\\n  task-board q 'get(STORY-1) { observability-story }'\\n  task-board q 'models()'\\n  task-board q 'models(agent=claude)'\\n  task-board q 'project_config()'\\n\",\n  \"original_output_bytes\": 3186,\n  \"original_output_tokens\": 797,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
