stry' >>\\\"$LOG\\\" 2>&1 \\\\\\n194:if go test ./internal/cataloggen/ -count=1 -run 'TestGenerateRefusesStaleV060Authority' >>\\\"$LOG\\\" 2>&1; then\\n197:  if go test ./internal/cataloggen/ -count=1 -run 'TestGenerateRefusesStaleV050Authority' >>\\\"$LOG\\\" 2>&1; then\\n204:go test ./internal/cataloggen/ -count=1 -run 'TestGenerateRefusesStaleV060Authority' >>\\\"$LOG\\\" 2>&1 \\\\\\n217:if go test ./internal/cigate/ -count=1 -run 'TestCheckReleaseRootsRefusesDrift' -v >\\\"$M5LOG\\\" 2>&1; then\\n231:go test ./internal/cigate/ -count=1 -run 'TestCheckReleaseRootsRefusesDrift' >>\\\"$LOG\\\" 2>&1 \\\\\\n244:if go test ./internal/traceability/ -count=1 -run 'TestVerifyRepositoryRejectsForgedOwnershipAndCapabilityClaims/valid_declaration_cannot_self-mint_ownership' >>\\\"$LOG\\\" 2>&1; then\\n247:  if go test ./internal/traceability/ -count=1 -run 'TestVerifyRepositoryRefusesOwnershipGapDriftAtDigestLayer' >>\\\"$LOG\\\" 2>&1; then\\n254:go test ./internal/traceability/ -count=1 -run 'TestVerifyRepositoryRejectsForgedOwnershipAndCapabilityClaims' >>\\\"$LOG\\\" 2>&1 \\\\\\n271:if go test ./internal/traceability/ -count=1 -run 'TestAdoptedBindingsRefuseSelfMintedImplementationClaims/section:14.1/production-points-to-test-code' >>\\\"$LOG\\\" 2>&1; then\\n274:  go test ./internal/traceability/ -count=1 -v >\\\"$M7LOG\\\" 2>&1 || true\\n\",\n  \"original_output_bytes\": 3974,\n  \"original_output_tokens\": 994,\n  \"truncated\": false\n}","final_result":true}}}
