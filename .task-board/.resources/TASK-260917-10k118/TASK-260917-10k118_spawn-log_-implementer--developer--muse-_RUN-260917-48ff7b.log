very excerpt verbatim, uniform per-region\\n    shifts +20/+79/+185/+281/+392).\\n 5. carried gap updates for 5.1/7.3/7.4/7.5/appendix-d (same rev2 text;\\n    trunk left those gaps untouched).\\n 6. new bindings section:13.1/13.10/14.1 (same rev2 text) -> 68 bindings.\\n 7. unowned carried (7 trunk entries); section:11.10.5 gap reworded per\\n    the 2x16gz reviewer P3 (\\\"Pending implementation owner\\\" ->\\n    \\\"Disclosure owner\\\" for source-evidence-only consumption).\\n\\nEvery change is asserted; run from the repository root. Formatting\\nround-trips through json.dumps(indent=2) exactly like the source file.\\n\\\"\\\"\\\"\\nimport collections\\nimport hashlib\\nimport json\\nimport sys\\n\\nSRC = '/tmp/n9r71p-rev3/trunk/internal/traceability/ownership.v0.6.0.json'\\nSRC_SHA256 = '212ae3215dd8a24cfe42c0b932919763f8bea5320d8b8dbe7718dafbddecb432'\\nDST = 'internal/traceability/ownership.v0.7.0.json'\\n\\nraw = open(SRC, 'rb').read()\\nactual = hashlib.sha256(raw).hexdigest()\\nassert actual == SRC_SHA256, (actual, SRC_SHA256)\\n\\nd = json.loads(raw.decode(), object_pairs_hook=collections.OrderedDict)\\n\\n# --- 1. source -> v0.7.0 (same reviewed source as rev2) --------------------\\nold_source = d['source']\\nassert old_source['release'] == 'v0.6.0', old_source\\nd['source'] = collections.OrderedDict([\\n    (\\\"repository\\\", \\\"relux-works/agent-session-manager-spec\\\"),\\n    (\\\"release\\\", \\\"v0.7.0\\\"),\\n    (\\\"commit\\\", \\\"32b3f2ba7c377248a53cd42389abbd2f1c321834\\\"),\\n    (\\\"document_path\\\", \\\"SPEC.md\\\"),\\n    (\\\"document_sha256\\\", \\\"c6b2fe64ee79ed697a96ed27a1679c80b8ee1eba137feb99e7738b4da289ddcf\\\"),\\n])\\n\\n# --- 2. acceptance cases: repoint v060, append 3 v070 --------------------\\ncases = collections.OrderedDict((c['id'], c) for c in d['acceptance_cases'])\\nassert len(cases) == 132, len(cases)\\n\\nv060 = cases['catalog-v060-exact']\\n...\\n39:raw = open(SRC, 'rb').read()\\n225:    \\\"the caller-plan planning-role step, the recorded-argv determinism rule and the persisted-extensions bound \\\"\\n257:json.dump(d, open(DST, 'w'), indent=2)\\n258:open(DST, 'a').write('\\\\n')\\n\",\n  \"original_output_bytes\": 3055,\n  \"original_output_tokens\": 764,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
