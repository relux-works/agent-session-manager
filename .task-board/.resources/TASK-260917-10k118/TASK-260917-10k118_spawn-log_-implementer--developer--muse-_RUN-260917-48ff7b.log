{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d8e5","stream":{"kind":"session","id":"01a0b074-2d9a-7d23-a683-c8d705b137ba"},"sequence":2765,"recorded_at":1780531400005525,"record_type":"event","durability":"durable","causation_id":"a105643e-74d8-47fc-98b0-dd8b6640f48f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a105643e-74d8-47fc-98b0-dd8b6640f48f","run_stream":{"kind":"run","id":"a105643e-74d8-47fc-98b0-dd8b6640f48f"},"task_stream":{"kind":"task","id":"01a0b087-5767-7ad1-93a0-c03b5dddb9d0"},"task_id":"01a0b087-5767-7ad1-93a0-c03b5dddb9d0","event":{"kind":"output","task_id":"01a0b087-5767-7ad1-93a0-c03b5dddb9d0","chunk":"{\n  \"chunk_id\": \"exec-91-1\",\n  \"command\": \"head -n 80 /tmp/evn9r71p/mutate-rev3.sh; echo \\\"===PIN-HARNESS===\\\"; head -n 60 /tmp/ev2yzf5d/mutate.sh\",\n  \"description\": \"Read inherited harness designs\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"#!/bin/bash\\n# Narrowing-mutant harness for TASK-260916-n9r71p (v0.7.0 catalog + ownership\\n# binding leaf). Each mutant weakens exactly one gate to admit exactly one\\n# member of the class it must reject; the named test must FAIL under the\\n# mutant while the narrowing-proof test still PASSES. M0 is the harmless\\n# SURVIVED control. The harness restores every file (trap on EXIT) and\\n# re-proves green after each mutant, so the tree is byte-identical\\n# afterwards. Run from the repository root: bash mutate.sh.\\n#\\n# M6 hardcodes D', the canonical digest of the declaration-swap plant used\\n# by TestVerifyRepositoryRejectsForgedOwnershipAndCapabilityClaims. D' is\\n# valid only for the final ownership.v0.7.0.json bytes; recompute it with\\n# ownership-digest.py (in the evidence tarball) if the registry changes.\\nset -u\\n# Run from the repository root (or set MUTATE_ROOT). The log stays in /tmp so\\n# the harness never dirties the tree it mutates.\\ncd \\\"${MUTATE_ROOT:-$PWD}\\\"\\nLOG=\\\"/tmp/n9r71p-mutate/mutate-n9r71p.log\\\"\\n: > \\\"$LOG\\\"\\n\\nFILES=(\\n  internal/cataloggen/generate.go\\n  internal/traceability/traceability.go\\n  internal/cigate/contracts.go\\n)\\nBACKUP_DIR=\\\"$(mktemp -d /tmp/n9r71p-mutate-backup.XXXXXX)\\\"\\nfor f in \\\"${FILES[@]}\\\"; do\\n  mkdir -p \\\"$BACKUP_DIR/$(dirname \\\"$f\\\")\\\"\\n  cp \\\"$f\\\" \\\"$BACKUP_DIR/$f\\\"\\ndone\\nrestore() {\\n  for f in \\\"${FILES[@]}\\\"; do cp \\\"$BACKUP_DIR/$f\\\" \\\"$f\\\"; done\\n}\\ntrap restore EXIT\\n\\npass=0\\nfail=0\\nreport() { # name verdict detail\\n  printf '%-4s %-9s %s\\\\n' \\\"$1\\\" \\\"$2\\\" \\\"$3\\\" | tee -a \\\"$LOG\\\"\\n  if [ \\\"$2\\\" = KILLED ] || [ \\\"$2\\\" = SURVIVED ]; then pass=$((pass+1)); else fail=$((fail+1)); fi\\n}\\n\\napply() { # name python-patch-file\\n  python3 \\\"$2\\\" >>\\\"$LOG\\\" 2>&1 || { echo \\\"PATCH FAILED: $1\\\" | tee -a \\\"$LOG\\\"; exit 3; }\\n}\\n\\n# --- M0: harmless operand-swap control (must SURVIVE: suite stays green) ---\\ncat > /tmp/n9r71p-m0.py <<'EOF'\\np = 'internal/traceability/traceability.go'\\nsrc = open(p).read()\\nold = '\\\\t\\\\tif got[index].Name != want[index].Name ||'\\nassert src.count(old) == 1\\nopen(p, 'w').write(src.replace(old, '\\\\t\\\\tif want[index].Name != got[index].Name ||'))\\nEOF\\napply M0 /tmp/n9r71p-m0.py\\nif go test ./internal/traceability/ -count=1 >>\\\"$LOG\\\" 2>&1; then\\n  report M0 SURVIVED \\\"operand-swap control: traceability suite green as designed\\\"\\nelse\\n  report M0 UNEXPECTED \\\"operand-swap control reddened the suite\\\"\\nfi\\nrestore\\n\\n# --- M1: cataloggen lock layer admits the v0.6.0 lock (one stale member) ---\\ncat > /tmp/n9r71p-m1.py <<'EOF'\\np = 'internal/cataloggen/generate.go'\\nsrc = open(p).read()\\nold = \\\"\\\"\\\"\\tmanifest, err := specpin.VerifyV070(contractLock)\\n\\tif err != nil {\\n\\t\\treturn nil, invalid(\\\"verify normative lock: %v\\\", err)\\n\\t}\\n\\\"\\\"\\\"\\nnew = \\\"\\\"\\\"\\tmanifest, err := specpin.VerifyV070(contractLock)\\n\\tif err != nil {\\n\\t\\tmanifest, err = specpin.VerifyV060(contractLock)\\n\\t}\\n\\tif err != nil {\\n\\t\\treturn nil, invalid(\\\"verify normative lock: %v\\\", err)\\n\\t}\\n\\\"\\\"\\\"\\nassert src.count(old) == 1\\n===PIN-HARNESS===\\n#!/bin/bash\\n# Narrowing-mutant harness for TASK-260916-2yzf5d (pin-reviewed-curator-spec-revision).\\n#\\n# Each plant weakens exactly one new v0.7.0 gate to admit exactly one member\\n# of the class it must reject; the gate stays present (no deletions).\\n# VerifyV070 is layered (semantic validation, then lock-digest comparison),\\n# so a narrowing mutant of that entry point spans both layers: the semantic\\n# check admits the one member and the digest check admits exactly that\\n# member's precomputed byte string (digests below were computed by replaying\\n# the named test's own mutation with encoding/json; a wrong precomputation\\n# reports NOT-KILLED instead of passing silently). The harness runs the FULL\\n# affected package suite per plant (behavioral projections included, not only\\n# the refusal subtest), records the raw `go test` log and subprocess exit per\\n# plant, then restores the tree and proves the restoration against a\\n# pre-harness snapshot. M0 is the harmless SURVIVED control: an applied\\n# behavior-preserving edit the suite must still accept.\\n#\\n# Usage: WORKTREE=<story worktree> ./mutate.sh\\n# Exit 0 only when M1..M5 are each KILLED by their named test (and nothing\\n# else fails) and M0 SURVIVES.\\nset -u\\nWORKTREE=\\\"${WORKTREE:?set WORKTREE to the story worktree}\\\"\\nOUT=\\\"${OUT:-$(dirname \\\"$0\\\")/mutant-logs}\\\"\\nmkdir -p \\\"$OUT\\\"\\ncd \\\"$WORKTREE\\\" || exit 1\\n\\nD_STALE_COMMIT=6169fcdcda7cc9d103da3a9797bcfbe484820a0c3a0abc3f629e721b1e834cf1\\nD_TRIMMED_PROVIDER=f389e08351afb6eafd85a7595830bdd95b910959a9ec627396154de384c57475\\nD_TRAILING_NEWLINE=6244bf557896a8bf625433d7f5a6ed1ae3e1100d11777fc3bdeb89fc15fbd394\\n\\nmkdir -p \\\"$OUT/snapshot\\\"\\ncp internal/specpin/pin.go \\\"$OUT/snapshot/pin.go\\\"\\ncp internal/specdoc/specdoc.go \\\"$OUT/snapshot/specdoc.go\\\"\\n\\npass=0\\nfail=0\\n\\napply_patch() { # <file> <find> <replace>\\n  python3 - \\\"$1\\\" \\\"$2\\\" \\\"$3\\\" <<'EOF'\\nimport sys\\npath, find, replace = sys.argv[1], sys.argv[2], sys.argv[3]\\ntext = open(path).read()\\nif text.count(find) != 1:\\n    print(f\\\"plant anchor matches {text.count(find)} times, want exactly 1\\\", file=sys.stderr)\\n    sys.exit(2)\\nopen(path, 'w').write(text.replace(find, replace))\\nEOF\\n}\\n\\n# plant <id> <file> <want: KILLED|SURVIVED> <fail-pattern> <fail-count> <patch-pairs...> -- <go-test-args...>\\nplant() {\\n  local id=\\\"$1\\\" file=\\\"$2\\\" want=\\\"$3\\\" pattern=\\\"$4\\\" count=\\\"$5\\\"\\n  shift 5\\n  echo \\\"=== $id ($file, want $want)\\\"\\n  cp \\\"$file\\\" \\\"$OUT/$id.orig\\\"\\n  while [ \\\"$1\\\" != \\\"--\\\" ]; do\\n    apply_patch \\\"$file\\\" \\\"$1\\\" \\\"$2\\\" || { echo \\\"$id: PLANT-FAILED\\\"; fail=$((fail+1)); cp \\\"$OUT/$id.orig\\\" \\\"$file\\\"; return; }\\n    shift 2\\n  done\\n  shift\\n\",\n  \"original_output_bytes\": 5438,\n  \"original_output_tokens\": 1360,\n  \"truncated\": false\n}","final_result":true}}}
