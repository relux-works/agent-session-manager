{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ce21","stream":{"kind":"session","id":"01a0b074-2d9a-7d23-a683-c8d705b137ba"},"sequence":1387,"recorded_at":1780531400002769,"record_type":"event","durability":"durable","causation_id":"a105643e-74d8-47fc-98b0-dd8b6640f48f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a105643e-74d8-47fc-98b0-dd8b6640f48f","run_stream":{"kind":"run","id":"a105643e-74d8-47fc-98b0-dd8b6640f48f"},"task_stream":{"kind":"task","id":"01a0b07b-e8a1-7372-9586-b1157ec73cbb"},"task_id":"01a0b07b-e8a1-7372-9586-b1157ec73cbb","event":{"kind":"output","task_id":"01a0b07b-e8a1-7372-9586-b1157ec73cbb","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260917-110onn/worktree/internal/traceability/readme_figures_pin_test.go`.\n1|package traceability\n2|\n3|import (\n4|\t\"os\"\n5|\t\"path/filepath\"\n6|\t\"regexp\"\n7|\t\"strconv\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|)\n11|\n12|// ownershipParagraphAnchor is the README heading whose first paragraph this\n13|// test measures. It is matched exactly rather than by keyword, so renaming the\n14|// heading reddens here instead of silently exempting the paragraph from\n15|// measurement.\n16|const ownershipParagraphAnchor = \"## Specification-to-Code Ownership Gate\"\n17|\n18|// publishedFigure is one number the ownership paragraph states, located by the\n19|// noun phrase that follows it and bound to the Report field it must equal. The\n20|// phrase is the identity: a figure is proven by naming what it counts, not by\n21|// its position in the sentence, so re-ordering the clause does not silently\n22|// re-point a pin at a different number.\n23|type publishedFigure struct {\n24|\tphrase  string\n25|\tmeasure func(Report) int\n26|}\n27|\n28|// publishedOwnershipFigures enumerates every figure the paragraph states. The\n29|// unpinned-figure guard below turns a deletion from this list into a red rather\n30|// than into a quietly smaller comparison, so the list is measured, not trusted.\n31|var publishedOwnershipFigures = []publishedFigure{\n32|\t{\"current contract rows\", func(report Report) int { return report.Contracts }},\n33|\t{\"pinned or catalog-referenced normative section keys\", func(report Report) int { return report.NormativeSections }},\n34|\t{\"executable acceptance cases\", func(report Report) int { return report.AcceptanceCases }},\n35|\t{\"exact section bindings\", func(report Report) int { return report.SectionBindings }},\n36|\t{\"disclosed unowned sections\", func(report Report) int { return report.UnownedSections }},\n37|\t{\"exact fixture identities\", func(report Report) int { return report.Fixtures }},\n38|\t{\"-contract subset\", func(report Report) int { return report.CompatibilityContracts }},\n39|}\n40|\n41|// ownershipParagraph returns the paragraph under the anchor, unwrapped onto one\n42|// line, together with the README line it starts at. It refuses a target it\n43|// cannot locate rather than skipping the comparison: a paragraph that silently\n44|// fell out of the measurement is exactly how the acceptance-case figure below\n45|// drifted from 73 to 74 without anything reddening.\n46|func ownershipParagraph(t *testing.T) (string, int) {\n47|\tt.Helper()\n48|\n49|\treadme, err := os.ReadFile(filepath.Join(\"..\", \"..\", \"README.md\"))\n50|\tif err != nil {\n51|\t\tt.Fatalf(\"read README.md: %v\", err)\n52|\t}\n53|\tlines := strings.Split(string(readme), \"\\n\")\n54|\tanchor := -1\n55|\tfor index, line := range lines {\n56|\t\tif strings.TrimSpace(line) == ownershipParagraphAnchor {\n57|\t\t\tif anchor >= 0 {\n58|\t\t\t\tt.Fatalf(\"README carries the heading %q twice, at lines %d and %d; the paragraph this test measures is ambiguous\",\n59|\t\t\t\t\townershipParagraphAnchor, anchor+1, index+1)\n60|\t\t\t}\n61|\t\t\tanchor = index\n62|\t\t}\n63|\t}\n64|\tif anchor < 0 {\n65|\t\tt.Fatalf(\"README no longer carries the heading %q\", ownershipParagraphAnchor)\n66|\t}\n67|\tstart := anchor + 1\n68|\tfor start < len(lines) && strings.TrimSpace(lines[start]) == \"\" {\n69|\t\tstart++\n70|\t}\n71|\tvar body []string\n72|\tfor index := start; index < len(lines); index++ {\n73|\t\ttext := strings.TrimSpace(lines[index])\n74|\t\tif text == \"\" {\n75|\t\t\tbreak\n76|\t\t}\n77|\t\tbody = append(body, text)\n78|\t}\n79|\tif len(body) == 0 {\n80|\t\tt.Fatalf(\"README carries no paragraph under %q\", ownershipParagraphAnchor)\n81|\t}\n82|\treturn strings.Join(body, \" \"), start + 1\n83|}\n84|\n85|// isVersionDigits reports whether the digit run beginning at offset belongs to a\n86|// dotted version or path token such as v0.5.0 or ownership.v0.5.0.json, rather\n87|// than being a figure the paragraph publishes. The rule is deliberately narrow:\n88|// only a run introduced by \"v\" or preceded by a dot that itself follows a digit\n89|// is exempt, so a published figure can never be excused as version text.\n90|func isVersionDigits(paragraph string, offset int) bool {\n91|\tif offset == 0 {\n92|\t\treturn false\n93|\t}\n94|\tswitch paragraph[offset-1] {\n95|\tcase 'v', 'V':\n96|\t\treturn true\n97|\tcase '.':\n98|\t\treturn offset >= 2 && paragraph[offset-2] >= '0' && paragraph[offset-2] <= '9'\n99|\t}\n100|\treturn false\n101|}\n102|\n103|// TestREADMEOwnershipFiguresAreDerivedFromTheMeasuredReport makes the published\n104|// ownership paragraph a measurement instead of prose beside one.\n105|//\n106|// This is the third time in this artifact that a figure published next to a\n107|// measurement drifted from it: LOGBOOK 1015 records the \"nineteen §15.2 rows\"\n108|// claim against an eighteen-row table, LOGBOOK 1157 records two of the four\n109|// published fan-in rows being wrong, and this paragraph published 73 executable\n110|// acceptance cases while the registry held 74 and tracecheck printed 74. The\n111|// tool for the class already existed - parsePublishedFanIn in\n112|// internal/axerror/exit_table_pin_test.go - and had simply never been pointed at\n113|// the neighbouring sentence.\n114|//\n115|// The fix is not to assert the corrected number somewhere else. It is to leave\n116|// no figure of the paragraph unmeasured: each is located by the phrase naming\n117|// what it counts, re-derived from VerifyRepository, and any number the paragraph\n118|// states that no pinned phrase consumed is reported as unmeasured rather than\n119|// ignored.\n120|func TestREADMEOwnershipFiguresAreDerivedFromTheMeasuredReport(t *testing.T) {\n121|\tt.Parallel()\n122|\n123|\treport, err := VerifyRepository(repositorySnapshot(t))\n124|\tif err != nil {\n125|\t\tt.Fatalf(\"VerifyRepository() error = %v\", err)\n126|\t}\n127|\tparagraph, line := ownershipParagraph(t)\n128|\n129|\tconsumed := make([]bool, len(paragraph))\n130|\tfor _, figure := range publishedOwnershipFigures {\n131|\t\tpattern := regexp.MustCompile(`([0-9]+) ?` + regexp.QuoteMeta(figure.phrase))\n132|\t\tmatches := pattern.FindAllStringSubmatchIndex(paragraph, -1)\n133|\t\tif len(matches) != 1 {\n134|\t\t\tt.Fatalf(\"README ownership paragraph at line %d states a figure for %q %d times, want exactly 1\",\n135|\t\t\t\tline, figure.phrase, len(matches))\n136|\t\t}\n137|\t\tdigits := paragraph[matches[0][2]:matches[0][3]]\n138|\t\tpublished, convErr := strconv.Atoi(digits)\n139|\t\tif convErr != nil {\n140|\t\t\tt.Fatalf(\"README ownership paragraph at line %d states a non-numeric figure %q for %q\",\n141|\t\t\t\tline, digits, figure.phrase)\n142|\t\t}\n143|\t\tif measured := figure.measure(report); published != measured {\n144|\t\t\tt.Fatalf(\"README ownership paragraph at line %d publishes %d %s; VerifyRepository measures %d\",\n145|\t\t\t\tline, published, strings.TrimPrefix(figure.phrase, \"-\"), measured)\n146|\t\t}\n147|\t\tfor offset := matches[0][2]; offset < matches[0][3]; offset++ {\n148|\t\t\tconsumed[offset] = true\n149|\t\t}\n150|\t}\n151|\n152|\t// Every remaining digit run must be version or path text. A figure nobody\n153|\t// pinned is reported here, so adding an unmeasured number to the paragraph -\n154|\t// or deleting a row from publishedOwnershipFigures - is a red.\n155|\tfor _, run := range regexp.MustCompile(`[0-9]+`).FindAllStringIndex(paragraph, -1) {\n156|\t\tif consumed[run[0]] || isVersionDigits(paragraph, run[0]) {\n157|\t\t\tcontinue\n158|\t\t}\n159|\t\tt.Fatalf(\"README ownership paragraph at line %d states the figure %q, which no pinned phrase measures; \"+\n160|\t\t\t\"give it a row in publishedOwnershipFigures or remove it from the paragraph\",\n161|\t\t\tline, paragraph[run[0]:run[1]])\n162|\t}\n163|}","final_result":true}}}
