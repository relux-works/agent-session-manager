package changerequest

import (
	"bytes"
	"crypto/sha256"
	"encoding/hex"
	"encoding/json"
	"fmt"
	"io"
	"os"
	"path"
	"path/filepath"
	"strings"
)

// ReplayResolutions authorizes only explicit conflict edits during preparation.
// Content is base64 in JSON; its digest is lowercase SHA-256 hex. It never
// authorizes edits to the live candidate or bypasses subsequent CR review.
type ReplayResolutions struct {
	Version          int                `json:"version"`
	BranchOID        string             `json:"branch_oid"`
	TrunkOID         string             `json:"trunk_oid"`
	CandidateTreeOID string             `json:"candidate_tree_oid"`
	Resolutions      []ReplayResolution `json:"resolutions"`
}

type ReplayResolution struct {
	CheckpointOID string `json:"checkpoint_oid"`
	Path          string `json:"path"`
	Content       []byte `json:"content"`
	SHA256        string `json:"sha256"`
}

type replayResolutionSet struct {
	entries map[string]ReplayResolution
	used    map[string]bool
}

func loadReplayResolutions(filename string, intent RefreshReplayIntent) (*replayResolutionSet, error) {
	set := &replayResolutionSet{entries: map[string]ReplayResolution{}, used: map[string]bool{}}
	if filename == "" {
		return set, nil
	}
	info, err := os.Lstat(filename)
	if err != nil {
		return nil, err
	}
	if !info.Mode().IsRegular() || info.Size() > 16<<20 {
		return nil, fmt.Errorf("replay resolutions require a regular file of at most 16 MiB")
	}
	data, err := os.ReadFile(filename)
	if err != nil {
		return nil, err
	}
	if len(data) > 16<<20 {
		return nil, fmt.Errorf("replay resolutions exceed 16 MiB")
	}
	var packet ReplayResolutions
	dec := json.NewDecoder(bytes.NewReader(data))
	dec.DisallowUnknownFields()
	if err := dec.Decode(&packet); err != nil {
		return nil, fmt.Errorf("replay resolutions: %w", err)
	}
	if err := dec.Decode(new(any)); err != io.EOF {
		return nil, fmt.Errorf("replay resolutions contain trailing data")
	}
	if packet.Version != 1 || packet.BranchOID != intent.BranchOID || packet.TrunkOID != intent.TrunkOID || packet.CandidateTreeOID != intent.CandidateTreeOID {
		return nil, fmt.Errorf("replay resolution authority mismatch")
	}
	if len(packet.Resolutions) == 0 {
		return nil, fmt.Errorf("replay resolutions are empty")
	}
	allowed := map[string]bool{}
	for _, oid := range intent.ReplayCommitOIDs {
		allowed[oid] = true
	}
	for _, entry := range packet.Resolutions {
		if !allowed[entry.CheckpointOID] {
			return nil, fmt.Errorf("replay resolution checkpoint is outside the original sequence")
		}
		if entry.Path == "" || path.IsAbs(entry.Path) || path.Clean(entry.Path) != entry.Path || strings.ContainsAny(entry.Path, "\\\x00\r\n\t") {
			return nil, fmt.Errorf("unsafe replay resolution path")
		}
		for _, component := range strings.Split(entry.Path, "/") {
			if component == "." || component == ".." || strings.EqualFold(component, ".git") {
				return nil, fmt.Errorf("unsafe replay resolution path")
			}
		}
		sum := sha256.Sum256(entry.Content)
		if hex.EncodeToString(sum[:]) != entry.SHA256 {
			return nil, fmt.Errorf("replay resolution content digest mismatch")
		}
		key := entry.CheckpointOID + ":" + entry.Path
		if _, exists := set.entries[key]; exists {
			return nil, fmt.Errorf("duplicate replay resolution")
		}
		set.entries[key] = entry
	}
	return set, nil
}

// resolve applies only supplied resolutions for the actual unmerged paths at
// REBASE_HEAD. Validate the entire conflict set before touching even the scratch
// worktree. The original candidate is never written here.
func (s *replayResolutionSet) resolve(g gitCmd) error {
	oid, err := g.run("rev-parse", "--verify", "REBASE_HEAD")
	if err != nil {
		return err
	}
	data, err := g.output("ls-files", "--unmerged", "-z")
	if err != nil {
		return err
	}
	paths := map[string]bool{}
	for _, row := range bytes.Split(data, []byte{0}) {
		if len(row) == 0 {
			continue
		}
		fields := bytes.SplitN(row, []byte{'\t'}, 2)
		if len(fields) != 2 {
			return fmt.Errorf("invalid unmerged index entry")
		}
		metadata := strings.Fields(string(fields[0]))
		if len(metadata) != 3 || (metadata[0] != "100644" && metadata[0] != "100755") {
			return fmt.Errorf("replay resolutions support regular-file conflicts only")
		}
		paths[string(fields[1])] = true
	}
	if len(paths) == 0 {
		return fmt.Errorf("replay stopped without resolvable conflicts")
	}
	for name := range paths {
		key := oid + ":" + name
		if _, ok := s.entries[key]; !ok || s.used[key] {
			return fmt.Errorf("missing unused replay resolution for %s at %s", name, oid)
		}
		current := g.dir
		parts := strings.Split(name, "/")
		for i, part := range parts {
			current = filepath.Join(current, part)
			info, err := os.Lstat(current)
			if err != nil {
				return err
			}
			if (i < len(parts)-1 && !info.IsDir()) || (i == len(parts)-1 && !info.Mode().IsRegular()) {
				return fmt.Errorf("unsafe replay resolution destination")
			}
		}
	}
	for name := range paths {
		key := oid + ":" + name
		entry := s.entries[key]
		if err := os.WriteFile(filepath.Join(g.dir, name), entry.Content, 0600); err != nil {
			return err
		}
		if _, err := g.run("--literal-pathspecs", "add", "--", name); err != nil {
			return err
		}
		s.used[key] = true
	}
	return nil
}

