+	releaseStage := make(chan struct{})
+	firstLockAttempt := make(chan struct{}, 1)
+	secondLockAttempt := make(chan struct{}, 1)
+	secondStaged := make(chan struct{}, 1)
+	var releaseOnce sync.Once
