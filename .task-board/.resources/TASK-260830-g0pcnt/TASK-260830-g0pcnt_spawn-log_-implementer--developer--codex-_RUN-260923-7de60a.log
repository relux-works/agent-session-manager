internal/tmuxserver/wrapper.go-101-	empty := WrapperRestoreOutcome{}
internal/tmuxserver/wrapper.go-102-	if lc == nil || lc.CurrentLease == nil || lc.CurrentGeneration == nil || lc.Now == nil ||
internal/tmuxserver/wrapper.go-103-		lc.Runner == nil || lc.Receipts == nil || lc.Bindings == nil || lc.Attach == nil || lc.States == nil {
