+	var firstInstallCount atomic.Int32
+
+	fx.lc.Attach.WithHooks(&termbind.AttachHooks{
+		BeforeAdmissionLock: func(string) { firstLockAttempt <- struct{}{} },
+		AfterStage: func(string) error {
+			firstStageCount.Add(1)
+			close(firstStaged)
+			<-releaseStage
