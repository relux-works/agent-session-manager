+
+type custodyModeOracleClass struct {
+	name   string
+	code   string
+	detail string
+}
+
+type custodyProjectedFileInfo struct {
+	os.FileInfo
+	mode os.FileMode
+}
+
+func (info custodyProjectedFileInfo) Mode() os.FileMode { return info.mode }
+
+// TestCustodyModeOracleAtProductionEntries compares every Unix low-12-bit
+// mode against the §3.2 oracle at Probe, Spawn, and Execute. The test uses
+// a mode projection over accessible private directories and a synthetic
+// socket FileInfo backed by an ordinary file, so no real socket is bound
+// or connected and no tmux process is started.
+func TestCustodyModeOracleAtProductionEntries(t *testing.T) {
+	classes := []custodyModeOracleClass{
+		{name: "socket_leaf", code: "tmux_unsafe_socket_path", detail: "socket permissions"},
+		{name: "runtime_tmux_dir", code: "tmux_unsafe_runtime_dir", detail: "runtime mode"},
+		{name: "root", code: "tmux_unsafe_socket_path", detail: "socket root"},
+		{name: "ancestor", code: "tmux_unsafe_socket_path", detail: "socket ancestor"},
+	}
+	entries := []string{"Probe", "Spawn", "Execute"}
+	const modeCount = 1 << 12
+
+	for _, class := range classes {
+		class := class
+		for _, entry := range entries {
+			entry := entry
+			t.Run(class.name+"/"+entry, func(t *testing.T) {
+				var root, socket, target string
+				var fx *lxFixture
+				if entry == "Execute" {
+					fx = newLifecycleFixture(t, fullLifecycleAdmitted())
+					root, socket = fx.root, fx.socket
+					recordBinding(t, fx, lxDigestA)
+				} else {
+					root, socket = lxProbeRoot(t)
+				}
+				switch class.name {
+				case "socket_leaf":
+					target = socket
+				case "runtime_tmux_dir":
+					target = filepath.Join(root, RuntimeDirName)
+				case "root":
+					target = root
+				case "ancestor":
+					target = filepath.Dir(root)
+				default:
+					t.Fatalf("unhandled custody class %q", class.name)
+				}
+				target = filepath.Clean(target)
+
+				var syntheticSocket custodyProjectedFileInfo
+				if class.name == "socket_leaf" {
+					backing, err := os.CreateTemp(t.TempDir(), "socket-identity-")
+					if err != nil {
+						t.Fatal(err)
+					}
+					if err := backing.Close(); err != nil {
+						t.Fatal(err)
+					}
+					backingInfo, err := os.Lstat(backing.Name())
+					if err != nil {
+						t.Fatal(err)
+					}
+					syntheticSocket = custodyProjectedFileInfo{
+						FileInfo: backingInfo,
+						mode:     backingInfo.Mode()&^os.ModeType | os.ModeSocket | 0o600,
+					}
+				previousLstat := lstatCustodySocket
+				lstatCustodySocket = func(path string) (os.FileInfo, error) {
+						if filepath.Clean(path) == target {
+							return syntheticSocket, nil
+						}
+						return os.Lstat(path)
+				}
+				t.Cleanup(func() { lstatCustodySocket = previousLstat })
+				previousIdentity := sameCustodyIdentity
+				sameCustodyIdentity = func(left, right os.FileInfo) bool {
+					if _, synthetic := left.(custodyProjectedFileInfo); synthetic {
+						leftStat, leftOK := left.Sys().(*syscall.Stat_t)
+						rightStat, rightOK := right.Sys().(*syscall.Stat_t)
+						return leftOK && rightOK && leftStat.Dev == rightStat.Dev && leftStat.Ino == rightStat.Ino
+					}
+					return os.SameFile(left, right)
+				}
+				t.Cleanup(func() { sameCustodyIdentity = previousIdentity })
+			}
+
+				var raw uint16
+				projectionHits := 0
+				previousProjection := custodyModeProjection
+				custodyModeProjection = func(path string, current os.FileMode) os.FileMode {
+					if filepath.Clean(path) == target {
+						projectionHits++
+						return projectUnixLowMode(current, raw)
+					}
+					return current
+				}
+				t.Cleanup(func() { custodyModeProjection = previousProjection })
+
+				checked := 0
+				for rawValue := 0; rawValue < modeCount; rawValue++ {
+					raw = uint16(rawValue)
+					projectionHits = 0
+					checked++
+					err, effects := runCustodyOracleEntry(t, entry, root, socket, fx)
+					if projectionHits == 0 {
+						t.Fatalf("mode %04o did not reach the %s predicate through %s", raw, class.name, entry)
+					}
+
+					if specCustodyModeAdmits(class.name, raw) {
+						if err != nil {
+							t.Fatalf("SPEC §3.2 oracle admits %s mode %04o, but %s refused: %v", class.name, raw, entry, err)
+						}
+						if effects == 0 {
+							t.Fatalf("%s admitted %s mode %04o but did not reach its fake next-stage effect", entry, class.name, raw)
+						}
+						continue
+					}
+					assertCustodyPermissionRefusal(t, err, class.code, class.detail)
+					if effects != 0 {
+						t.Fatalf("%s performed %d effect(s) before refusing %s mode %04o", entry, effects, class.name, raw)
+					}
+				}
+				if checked != modeCount {
+					t.Fatalf("enumerated %d Unix modes, want %d", checked, modeCount)
+				}
+			})
+		}
+	}
