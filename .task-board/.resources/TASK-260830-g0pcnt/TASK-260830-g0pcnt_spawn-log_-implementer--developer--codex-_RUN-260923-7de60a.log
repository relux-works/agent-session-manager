+		BeforeAdmissionLock: func(string) { firstLockAttempt <- struct{}{} },
+		AfterStage: func(string) error {
+			firstStageCount.Add(1)
+			close(firstStaged)
+			<-releaseStage
+			return nil
+		},
+		AfterInstall: func(string) error {
+			firstInstallCount.Add(1)
+			return nil
+		},
+	})
