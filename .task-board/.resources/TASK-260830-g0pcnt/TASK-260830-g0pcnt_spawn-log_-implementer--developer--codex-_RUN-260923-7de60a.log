index f5874b849a662a45314d33f9592fa5f3baafaa64..0a2b20cceed2d58355b84393c802f90d6061a466
--- a/internal/tmuxserver/lifecycle_attach_properties_unix_test.go
+++ b/internal/tmuxserver/lifecycle_attach_properties_unix_test.go
@@ -10,6 +10,8 @@
 	"os"
 	"path/filepath"
 	"reflect"
+	"sync"
+	"sync/atomic"
 	"syscall"
 	"testing"
 	"time"
@@ -232,6 +234,132 @@
