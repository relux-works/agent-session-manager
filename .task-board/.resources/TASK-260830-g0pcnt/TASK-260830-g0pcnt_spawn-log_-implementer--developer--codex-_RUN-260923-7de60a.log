+		PollInterval:       fx.lc.PollInterval,
+		ServerAdmission:    fx.lc.ServerAdmission,
+		LocalHostID:        fx.lc.LocalHostID,
+		LeaseRefresh:       fx.lc.LeaseRefresh,
