+// custody rule into a low-12-bit oracle: only sticky exempts group/other
+// writable ancestors; setuid and setgid never do.
+func specCustodyModeAdmits(class string, raw uint16) bool {
+	permissions := raw & 0o777
+	special := raw & 0o7000
