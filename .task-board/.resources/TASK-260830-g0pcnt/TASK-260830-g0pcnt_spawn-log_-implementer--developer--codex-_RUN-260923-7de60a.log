+		Root:               fx.lc.Root,
+		Platform:           fx.lc.Platform,
+		Runner:             fx.lc.Runner,
+		Receipts:           fx.lc.Receipts,
+		Bindings:           fx.lc.Bindings,
+		Attach:             secondStore,
