+
+func projectUnixLowMode(current os.FileMode, raw uint16) os.FileMode {
+	const lowModeMask = os.ModePerm | os.ModeSetuid | os.ModeSetgid | os.ModeSticky
+	mode := current &^ lowModeMask
+	mode |= os.FileMode(raw & 0o777)
+	if raw&0o4000 != 0 {
+		mode |= os.ModeSetuid
+	}
+	if raw&0o2000 != 0 {
+		mode |= os.ModeSetgid
+	}
+	if raw&0o1000 != 0 {
+		mode |= os.ModeSticky
+	}
+	return mode
+}
