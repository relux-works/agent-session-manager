+            path=f"{PACKAGE}/runtime_unix.go",
+            find="\treturn permissions&0o077 == 0 && permissions&0o700 == 0o700 &&\n\t\tmode&(os.ModeSetuid|os.ModeSetgid|os.ModeSticky) == 0\n",
+            replace="\treturn (permissions&0o077 == 0 && permissions&0o700 == 0o700 &&\n\t\tmode&(os.ModeSetuid|os.ModeSetgid|os.ModeSticky) == 0) ||\n\t\t(permissions == 0o750 && mode&(os.ModeSetuid|os.ModeSetgid|os.ModeSticky) == 0)\n",
