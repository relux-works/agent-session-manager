-	permissions := info.Mode().Perm()
-	if permissions&0o077 != 0 || permissions&0o600 != 0o600 {
+	if !ownerOnlySocketMode(mode) {
 		return &Error{Code: CodeUnsafeSocketPath, Detail: "socket permissions"}
 	}
 	pathed, err := lstatCustodySocket(socket)
