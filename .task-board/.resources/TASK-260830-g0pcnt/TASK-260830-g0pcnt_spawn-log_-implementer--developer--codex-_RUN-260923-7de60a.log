diff --git a/internal/tmuxserver/custody_permissions_unix_test.go b/internal/tmuxserver/custody_permissions_unix_test.go
index 8efd1af141e85459eff30cf8197d4bedd26439c1..3a11eaa0173188cefea071c516cddc4a096686bc
--- a/internal/tmuxserver/custody_permissions_unix_test.go
