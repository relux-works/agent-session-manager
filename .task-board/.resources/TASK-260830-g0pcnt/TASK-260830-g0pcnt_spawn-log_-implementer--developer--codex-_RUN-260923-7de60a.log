index 8efd1af141e85459eff30cf8197d4bedd26439c1..29d3c0804b21dc85d988cda0664de693780b4b9d
--- a/internal/tmuxserver/custody_permissions_unix_test.go
+++ b/internal/tmuxserver/custody_permissions_unix_test.go
@@ -7,6 +7,7 @@
 	"net"
 	"os"
