+			listener, err := net.Listen("unix", socket)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer listener.Close()
+			if err := os.Chmod(socket, refusal.mode); err != nil {
+				t.Fatal(err)
+			}
