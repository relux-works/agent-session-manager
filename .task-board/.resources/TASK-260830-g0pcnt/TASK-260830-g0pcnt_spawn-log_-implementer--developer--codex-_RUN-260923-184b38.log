from importlib.util import module_from_spec, spec_from_file_location
from pathlib import Path
import sys

root = Path.cwd()
harness_path = root / \"internal/tmuxserver/mutant_harness.py\"
spec = spec_from_file_location(\"task_g0pcnt_full_mutant_harness\", harness_path)
if spec is None or spec.loader is None:
    raise SystemExit(\"could not load mutant harness\")
harness = module_from_spec(spec)
sys.modules[spec.name] = harness
spec.loader.exec_module(harness)

round_id, group_id = sys.argv[1], int(sys.argv[2])
all_mutants = harness.MUTANTS
if len(all_mutants) "'!= 338:
    raise SystemExit(f"expected 338 shipped mutants, found {len(all_mutants)}")
if len({mutant.name for mutant in all_mutants}) != len(all_mutants):
    raise SystemExit("mutant names are not unique")
group_size = 40
start = (group_id - 1) * group_size
batch = all_mutants[start : start + group_size]
if not batch:
    raise SystemExit(f"empty group {group_id}")
log_dir = root / f".temp/TASK-260830-g0pcnt/full-harness-r{round_id}"
log_dir.mkdir(parents=True, exist_ok=True)
failures = 0
for mutant in batch:
    try:
        line = harness.run_mutant(mutant, log_dir)
    except Exception as exc:
        line = f"ERROR: {mutant.name}: {type(exc).__name__}: {exc}"
    print(line, flush=True)
    if not line.startswith("ok:"):
        failures += 1
print(f"group={group_id} round={round_id} range={start + 1}-{start + len(batch)} mutants={len(batch)} total={len(all_mutants)} failures={failures}", flush=True)
raise SystemExit(1 if failures else 0)
PY
