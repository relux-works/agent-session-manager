def custody_permission_mask_mutants() -> list[Mutant]:
    """Narrow every mask that rejects outside-owner socket custody bits.

    Ancestors intentionally allow non-writable read/execute bits and sticky
    directories under SPEC §3.2, so their actual unsafe mask is 0o022: only
    the group-write and other-write narrowings are meaningful there.
    """
    rows: list[Mutant] = []
    scopes = (
        (
            "socket",
            f"{PACKAGE}/bind.go",
            '\tif permissions&0o077 != 0 || permissions&0o600 != 0o600 {\n',
            "permissions&0o077",
            "socket_leaf",
        ),
        (
            "root",
            f"{PACKAGE}/bind.go",
            '\tif permissions&0o077 != 0 || permissions&0o700 != 0o700 {\n',
            "permissions&0o077",
            "root",
        ),
        (
            "runtime-dir",
            f"{PACKAGE}/runtime_unix.go",
            "return permissions&0o077 == 0 && permissions&0o700 == 0o700\n",
            "permissions&0o077",
            "runtime_tmux_dir",
        ),
    )
    bits = (
        ("group-read", "0o040", "group_read"),
        ("group-write", "0o020", "group_write"),
        ("group-execute", "0o010", "group_execute"),
        ("other-read", "0o004", "other_read"),
        ("other-write", "0o002", "other_write"),
        ("other-execute", "0o001", "other_execute"),
    )
    for scope, path, find, mask, component in scopes:
        def add(name: str, narrowed: str, killer_bits: tuple[str, ...], note: str) -> None:
            killer_re = "|".join(killer_bits)
            run = f"TestCustodyPermissionBitCensus/{component}/({killer_re})/(Probe|Spawn|Execute)"
            if scope == "socket" and name in ("drop-group-triplet", "drop-other-triplet"):
                # Exercise the reviewer's exact 0602/0604/0606/0620 cases
                # through every production entry for both triplet narrowings.
                run = "TestCustodyPermissionSocketLeafExactModes"
            rows.append(
                Mutant(
                    name=f"N-{scope}-mask-{name}",
                    path=path,
                    find=find,
                    replace=find.replace(mask, narrowed),
                    count=1,
                    run=run,
                    expect="KILLED",
                    note=note,
                )
            )

        add(
            "drop-group-triplet",
            "permissions&0o007",
            ("group_read",),
            (
                "Ignores the whole group permission triplet. The exact-mode test drives 0620 through Probe, Spawn and Execute."
                if scope == "socket"
                else f"Ignores the whole group permission triplet. The {component}/group_read census row runs through Probe, Spawn and Execute."
            ),
        )
        add(
            "drop-other-triplet",
            "permissions&0o070",
            ("other_read",),
            (
                "Ignores the whole other permission triplet. The exact-mode test drives 0602, 0604, and 0606 through Probe, Spawn and Execute."
                if scope == "socket"
                else f"Ignores the whole other permission triplet. The {component}/other_read census row runs through Probe, Spawn and Execute."
            ),
        )
        for label, bit, test_name in bits:
            add(
                f"drop-{label}",
                f"permissions&(0o077 &^ {bit})",
                (test_name,),
                f"Ignores only outside-owner bit {bit}. Its named census row runs through Probe, Spawn and Execute.",
            )

    ancestor_find = "\tif perm&0o022 == 0 {\n"
    for label, replacement, test_name in (
        ("group-write", "\tif perm&0o002 == 0 {\n", "group_write"),
        ("other-write", "\tif perm&0o020 == 0 {\n", "other_write"),
    ):
        rows.append(
            Mutant(
                name=f"N-ancestor-mask-drop-{label}",
                path=f"{PACKAGE}/bind.go",
                find=ancestor_find,
                replace=replacement,
                count=1,
                run=f"TestCustodyPermissionBitCensus/ancestor/{test_name}/(Probe|Spawn|Execute)",
                expect="KILLED",
                note=f"Drops only the {label} term from the ancestor write mask. The matching isolated bit row must refuse before Probe dial, Spawn runner, and Execute dispatch.",
            )
        )
    return rows


MUTANTS.extend(custody_permission_mask_mutants())


def apply(mutant: Mutant, original: str) -> str:
    return original.replace(mutant.find, mutant.replace)


