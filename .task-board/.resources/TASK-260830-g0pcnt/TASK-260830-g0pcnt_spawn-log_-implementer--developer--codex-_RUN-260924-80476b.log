+            path=f"{PACKAGE}/bind.go",
+            find="\tif custodyKindProjection != nil {\n\t\tmode = custodyKindProjection(path, mode)\n\t}\n\tif custodyModeProjection != nil {\n",
+            replace="\tif custodyKindProjection != nil {\n\t\tmode = custodyKindProjection(path, mode)\n\t}\n\tcomponents := strings.Split(path, \"/\")\n\tif mode.IsDir() && len(components) > 24 {\n\t\tmode &^= 0o022\n\t}\n\tif custodyModeProjection != nil {\n",
+            count=1,
+            run="TestCustodyAncestorWalk",
+            expect="KILLED",
+            note="Narrowing in custodyModeForPath derives a depth cap from len(strings.Split(path, \"/\")). The isolated ancestor-walk suite must kill it behaviorally and the transitive AST guard must identify the path-derived component count.",
+        ),
+        Mutant(
+            name="N-ancestor-walk-range-index-cap",
+            path=f"{PACKAGE}/bind.go",
+            find="\tif custodyKindProjection != nil {\n\t\tmode = custodyKindProjection(path, mode)\n\t}\n\tif custodyModeProjection != nil {\n",
+            replace="\tif custodyKindProjection != nil {\n\t\tmode = custodyKindProjection(path, mode)\n\t}\n\tif mode.IsDir() {\n\t\tfor componentIndex := range strings.Split(path, \"/\") {\n\t\t\tif componentIndex > 24 {\n\t\t\t\tmode &^= 0o022\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t}\n\tif custodyModeProjection != nil {\n",
+            count=1,
+            run="TestCustodyAncestorWalk",
+            expect="KILLED",
+            note="Narrowing in custodyModeForPath derives the cap from a range index over path components. The isolated ancestor-walk suite must kill it behaviorally and the transitive AST guard must mark the range index path-derived.",
+        ),
+        Mutant(
+            name="N-ancestor-walk-byte-length-cap",
+            path=f"{PACKAGE}/bind.go",
+            find="\tif custodyKindProjection != nil {\n\t\tmode = custodyKindProjection(path, mode)\n\t}\n\tif custodyModeProjection != nil {\n",
+            replace="\tif custodyKindProjection != nil {\n\t\tmode = custodyKindProjection(path, mode)\n\t}\n\tif mode.IsDir() && len([]byte(path)) > 24 {\n\t\tmode &^= 0o022\n\t}\n\tif custodyModeProjection != nil {\n",
+            count=1,
+            run="TestCustodyAncestorWalk",
+            expect="KILLED",
+            note="Narrowing in custodyModeForPath derives a cap from the byte length of path. The isolated ancestor-walk suite must kill it behaviorally and the transitive AST guard must propagate path taint through []byte conversion.",
+        ),
