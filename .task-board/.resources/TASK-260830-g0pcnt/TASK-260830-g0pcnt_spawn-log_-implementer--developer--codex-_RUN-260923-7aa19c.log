+        replace='\tinfo, err := leaf.Stat()\n\tif err != nil {\n\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: "runtime mode"}\n\t}\n\tif !ownerOnlyRuntimeDirMode(info.Mode().Perm()) && info.Mode().Perm() != 0o777 {\n',
