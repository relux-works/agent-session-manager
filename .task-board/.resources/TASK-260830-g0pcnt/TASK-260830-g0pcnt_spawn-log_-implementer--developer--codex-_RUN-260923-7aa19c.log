+
+// ownerOnlyRuntimeDirMode pins all three owner permissions and rejects
+// every group/other permission. SPEC §3.2 requires AX-owned runtime
+// directories to use mode 0700; a partial owner mode is not usable as
+// a runtime directory, and any outside-owner bit widens custody.
+func ownerOnlyRuntimeDirMode(permissions os.FileMode) bool {
+	permissions &= os.ModePerm
+	return permissions&0o077 == 0 && permissions&0o700 == 0o700
+}
