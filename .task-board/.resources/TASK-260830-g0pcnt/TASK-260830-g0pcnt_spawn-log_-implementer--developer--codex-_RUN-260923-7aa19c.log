def custody_permission_mask_mutants() -> list[Mutant]:
    """Narrow every mask that rejects outside-owner socket custody bits.

    Ancestors intentionally allow non-writable read/execute bits and sticky
    directories under SPEC §3.2, so their actual unsafe mask is 0o022: only
    the group-write and other-write narrowings are meaningful there.
    """
    rows: list[Mutant] = []
    scopes = (
        (
            "socket",
            f"{PACKAGE}/bind.go",
            '\tif permissions&0o077 != 0 || permissions&0o600 != 0o600 {\n',
            "permissions&0o077",
            "socket_leaf",
        ),
        (
            "root",
            f"{PACKAGE}/bind.go",
            '\tif permissions&0o077 != 0 || permissions&0o700 != 0o700 {\n',
            "permissions&0o077",
            "root",
        ),
        (
            "runtime-dir",
            f"{PACKAGE}/runtime_unix.go",
            "return permissions&0o077 == 0 && permissions&0o700 == 0o700\n",
            "permissions&0o077",
            "runtime_tmux_dir",
        ),
    )
    bits = (
        ("group-read", "0o040", "group_read"),
        ("group-write", "0o020", "group_write"),
        ("group-execute", "0o010", "group_execute"),
        ("other-read", "0o004", "other_read"),
        ("other-write", "0o002", "other_write"),
        ("other-execute", "0o001", "other_execute"),
    )
    for scope, path, find, mask, component in scopes:
        def add(name: str, narrowed: str, killer_bits: tuple[str, ...], note: str) -> None:
            killer_re = "|".join(killer_bits)
            rows.append(
                Mutant(
                    name=f"N-{scope}-mask-{name}",
                    path=path,
                    find=find,
                    replace=find.replace(mask, narrowed),
                    count=1,
                    run=f"TestCustodyPermissionBitCensus/{component}/({killer_re})/(Probe|Spawn|Execute)",
                    expect="KILLED",
                    note=note,
                )
            )

        add(
            "drop-group-triplet",
            "permissions&0o007",
            ("group_read",),
            "Ignores the whole group permission triplet. The bit census drives the literal group-read bit through Probe, Spawn and Execute.",
        )
        add(
            "drop-other-triplet",
            "permissions&0o070",
            ("other_read",),
            "Ignores the whole other permission triplet. The bit census drives the literal other-read bit through Probe, Spawn and Execute.",
        )
        for label, bit, test_name in bits:
            add(
                f"drop-{label}",
                f"permissions&(0o077 &^ {bit})",
                (test_name,),
                f"Ignores only outside-owner bit {bit}. Its named census row runs through Probe, Spawn and Execute.",
            )

    ancestor_find = "\tif perm&0o022 == 0 {\n"
    for label, replacement, test_name in (
        ("group-write", "\tif perm&0o002 == 0 {\n", "group_write"),
        ("other-write", "\tif perm&0o020 == 0 {\n", "other_write"),
    ):
        rows.append(
            Mutant(
                name=f"N-ancestor-mask-drop-{label}",
                path=f"{PACKAGE}/bind.go",
                find=ancestor_find,
                replace=replacement,
                count=1,
                run=f"TestCustodyPermissionBitCensus/ancestor/{test_name}/(Probe|Spawn|Execute)",
                expect="KILLED",
                note=f"Drops only the {label} term from the ancestor write mask. The matching isolated bit row must refuse before Probe dial, Spawn runner, and Execute dispatch.",
            )
        )
    return rows


MUTANTS.extend(custody_permission_mask_mutants())


def apply(mutant: Mutant, original: str) -> str:
    return original.replace(mutant.find, mutant.replace)


def run_mutant(mutant: Mutant, log_dir: Path | None) -> str:
    target = REPO / mutant.path
    original = target.read_text()
//
// The walk climbs the LEXICAL path and opens every ancestor through
// the landed no-follow owner: a symlink at any level — including an
// intermediate alias above an otherwise valid root — refuses, because
// writes through an alias land outside the verified tree. The walk
// never resolves: resolving first would verify one path and use
// another. Callers pass a canonical root (the runtime-root owner
// canonicalizes at creation); system-conventional symlinks such as
// macOS /tmp are resolved by the caller, never excused here.
func checkCustodyAncestors(root string) error {
	cleaned := filepath.Clean(root)
	for {
		parent := filepath.Dir(cleaned)
		if parent == cleaned {
			return nil
		}
		dir, err := secprim.OpenNoFollowDir(parent)
		if err != nil {
			return &Error{Code: CodeUnsafeSocketPath, Detail: "socket ancestor"}
		}
		info, statErr := dir.Stat()
		_ = dir.Close()
		if statErr != nil || !info.IsDir() {
			return &Error{Code: CodeUnsafeSocketPath, Detail: "socket ancestor"}
		}
		if writableByOthers(info) {
			return &Error{Code: CodeUnsafeSocketPath, Detail: "socket ancestor"}
		}
		if isFilesystemRoot(parent) {
			return nil
		}
		cleaned = parent
	}
}

// isFilesystemRoot reports the end of the ancestor walk: the cleaned
// path is the volume root (/ on unix; a drive root on Windows, which
// refuses upstream before this walk ever runs).
func isFilesystemRoot(path string) bool {
	return path == string(filepath.Separator) || strings.HasSuffix(path, ":\\")
}

// writableByOthers reports group/world writability without the sticky
// bit: system ancestors may expose read/execute bits for path traversal,
// and sticky directories (01777 /tmp) admit shared writes by design,
// while a plain 0777 or 0770 admits an unsafe rename.
func writableByOthers(info os.FileInfo) bool {
	perm := info.Mode().Perm()
	if perm&0o022 == 0 {
		return false
	}
	return info.Mode()&os.ModeSticky == 0
}

// lstatCustodySocket is a test seam for a socket path replacement
// between the attribute check and the identity recheck. Production
// always uses os.Lstat; no path resolution or symlink following is
// permitted.
var lstatCustodySocket = os.Lstat

// checkCustodySocket gates the socket path itself: absence is bindable;
// a present path must be a current-user-owned socket with owner
// read/write access and no group/other permissions. tmux may add the
// owner's execute bit while a session is attached, which does not widen
// access to another user; that mode remains safe. The socket identity
// must remain stable across validation. This refuses
// a symlink, foreign socket, permissive socket, or a replacement staged
// while custody is being checked before any bind/connect call.
func checkCustodySocket(socket string) error {
	info, err := lstatCustodySocket(socket)
	if err != nil {
		if os.IsNotExist(err) {
			return nil
		}
		return &Error{Code: CodeUnsafeSocketPath, Detail: "socket kind"}
	}
	if info.Mode().Type() != os.ModeSocket {
		return &Error{Code: CodeUnsafeSocketPath, Detail: "socket kind"}
	}
	if !ownershipMatches(info) {
		return &Error{Code: CodeUnsafeSocketPath, Detail: "socket ownership"}
	}
	permissions := info.Mode().Perm()
	if permissions&0o077 != 0 || permissions&0o600 != 0o600 {
		return &Error{Code: CodeUnsafeSocketPath, Detail: "socket permissions"}
	}
	pathed, err := lstatCustodySocket(socket)
	if err != nil || !sameCustodyIdentity(info, pathed) {
		return &Error{Code: CodeUnsafeSocketPath, Detail: "socket identity"}
	}
	return nil

