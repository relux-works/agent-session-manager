+func TestCustodyPermissionBitCensus(t *testing.T) {
+	classes := []custodyPermissionClass{
+		{
+			name: "socket_leaf", base: 0o600, code: "tmux_unsafe_socket_path", detail: "socket permissions",
+			refuse: func(os.FileMode) bool { return true },
