+func TestPerformEffectStopEscalates(t *testing.T) {
+	// Live, live, then absent after the kill escalation.
+	runner := newFakeRunner().
+		queue("has-session", "", 0).
+		queue("kill-session", "", 0).
+		queueFull("has-session", "", "can't find session: "+lxInstance, 1)
