+		t.Fatalf("mutation = %+v, want the committed proof", res.outcome.Mutation)
+	}
+	if res.outcome.BoundaryObservedAt != "" {
+		t.Fatalf("observed_at = %q, want no unrecorded report", res.outcome.BoundaryObservedAt)
+	}
+}
