+			return ServerReport{}, nil
+		}
+		req.Deps.Spawn = spy.spawn
+		return req
+	}
+	first, err := Acquire(make())
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, err := Acquire(make())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first.Socket != second.Socket {
