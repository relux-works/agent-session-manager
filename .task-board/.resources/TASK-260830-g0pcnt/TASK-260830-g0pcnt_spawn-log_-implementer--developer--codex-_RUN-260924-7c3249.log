+	}
+	t.Logf("PATH_MAX=%d; generated %d one-byte directories; runtime-root bytes=%d; deepest ancestor bytes=%d; ancestor positions=%d", unix.PathMax, oneByteDepth, len(root), len(filepath.Dir(root)), len(ancestors)-1)
