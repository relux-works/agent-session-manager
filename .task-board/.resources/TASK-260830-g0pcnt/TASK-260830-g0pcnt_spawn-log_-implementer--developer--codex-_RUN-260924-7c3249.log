+	})
+
+	parent := base
+	if len(parent)%2 == 0 {
+		parityBase := filepath.Join(parent, "xy")
+		if err := os.Mkdir(parityBase, 0o700); err != nil {
+			t.Fatalf("create PATH_MAX parity directory: %v", err)
