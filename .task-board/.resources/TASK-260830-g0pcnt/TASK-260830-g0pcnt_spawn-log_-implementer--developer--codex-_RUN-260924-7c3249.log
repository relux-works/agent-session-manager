+	if err := os.Mkdir(root, 0o700); err != nil {
+		t.Fatalf("create PATH_MAX runtime-root fixture at %d bytes: %v", len(root), err)
+	}
+	created = append(created, root)
+	return root, created, oneByteDepth
+}
