+		case *ast.SwitchStmt:
+			if custodyExprIsPathMetric(graph, function, current.Tag, pathValues, metricValues) {
+				violation = "path-derived length/depth switch"
+			}
+		}
+		if violation != "" {
+			violationLine = graph.fset.Position(node.Pos()).Line
+			return false
+		}
+		return true
+	})
