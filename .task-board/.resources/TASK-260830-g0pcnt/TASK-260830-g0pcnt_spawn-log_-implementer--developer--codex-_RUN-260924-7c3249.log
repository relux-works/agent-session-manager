+		fields := strings.Fields(line)
+		if len(fields) == 2 && fields[0] == "module" {
+			modulePath = fields[1]
+			break
+		}
+	}
+	if modulePath == "" {
+		t.Fatal("go.mod has no module declaration")
+	}
+
+	graph := &custodyASTCallGraph{
