+
+func custodyExprHasPath(expression ast.Expr, pathValues, metricValues map[string]bool) bool {
+	if expression == nil {
+		return false
+	}
+	switch current := expression.(type) {
+	case *ast.Ident:
+		return pathValues[current.Name] || metricValues[current.Name]
