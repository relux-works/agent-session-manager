+			if _, ok := reachable["tmuxserver.CheckSocketCustody"]; !ok {
+				t.Fatalf("production entry %s no longer reaches CheckSocketCustody", entry.key)
+			}
+			if _, ok := reachable["tmuxserver.checkCustodyAncestors"]; !ok {
