+func custodyReceiverName(function *ast.FuncDecl) string {
+	if function.Recv == nil || len(function.Recv.List) == 0 {
+		return ""
+	}
+	typeExpression := function.Recv.List[0].Type
+	for {
+		switch current := typeExpression.(type) {
+		case *ast.StarExpr:
+			typeExpression = current.X
+		case *ast.ParenExpr:
+			typeExpression = current.X
