+	if err := CheckSocketLength(deepSocket, scalar.PlatformMacOS); err == nil {
+		t.Fatalf("deep derived socket of %d bytes unexpectedly passed sun_path limit %d", len(deepSocket), sunPathLimitDarwin)
+	}
+}
