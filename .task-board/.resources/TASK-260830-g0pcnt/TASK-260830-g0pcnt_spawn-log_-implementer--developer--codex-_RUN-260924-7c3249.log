+func isCustodyPathLikeType(expression ast.Expr) bool {
+	switch current := expression.(type) {
+	case *ast.Ident:
+		return current.Name == "string"
+	case *ast.ArrayType:
+		return current.Len == nil && isCustodyPathLikeType(current.Elt)
+	case *ast.StarExpr:
