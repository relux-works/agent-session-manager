+	}
+	if len(root) != unix.PathMax-1 || len(filepath.Dir(root)) != unix.PathMax-3 {
+		t.Fatalf("fixture did not reach the deepest valid ancestor path: root=%d ancestor=%d PATH_MAX=%d", len(root), len(filepath.Dir(root)), unix.PathMax)
+	}
+	if len(created) == 0 {
