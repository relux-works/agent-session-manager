+	}
+	if identifier, ok := expression.(*ast.Ident); ok {
+		return metricValues[identifier.Name]
+	}
+	call, ok := expression.(*ast.CallExpr)
+	if !ok {
+		return false
+	}
+	name := custodyCallName(call.Fun)
+	pathArgument := false
+	for _, argument := range call.Args {
+		if custodyExprHasPath(argument, pathValues, metricValues) {
+			pathArgument = true
+			break
+		}
+	}
+	if !pathArgument {
+		return false
+	}
+	if custodyKnownPathMetricCall(name) {
+		return true
+	}
+	for _, key := range custodyASTCallTargets(graph, function, call.Fun) {
+		if custodyFunctionReturnsInt(graph.functions[key].declaration) {
+			return true
+		}
+	}
+	return false
+}
+
+func custodyKnownPathMetricCall(name string) bool {
+	switch name {
+	case "len", "Count", "RuneCountInString", "ComponentCount", "PathDepth", "Index", "LastIndex", "IndexByte", "LastIndexByte":
+		return true
+	default:
+		return false
+	}
+}
+
+func custodyExprReturnsString(graph *custodyASTCallGraph, function *custodyASTFunction, expression ast.Expr) bool {
+	call, ok := expression.(*ast.CallExpr)
