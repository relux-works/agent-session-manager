+				failPathDetailUses += custodyCountTargetCalls(graph, caller, call, key)
+			}
+			return true
+		})
+	}
+	return uses > 0 && uses == failPathDetailUses
+}
+
+func custodyTargetsContain(targets []string, expected string) bool {
+	for _, target := range targets {
