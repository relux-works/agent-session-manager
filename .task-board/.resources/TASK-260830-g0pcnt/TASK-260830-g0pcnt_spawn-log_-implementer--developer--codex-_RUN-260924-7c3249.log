+	}
+	if custodyKnownStringPathCall(custodyCallName(call.Fun)) {
+		return true
+	}
+	for _, key := range custodyASTCallTargets(graph, function, call.Fun) {
+		declaration := graph.functions[key].declaration
+		if declaration.Type.Results == nil {
+			continue
+		}
+		for _, field := range declaration.Type.Results.List {
