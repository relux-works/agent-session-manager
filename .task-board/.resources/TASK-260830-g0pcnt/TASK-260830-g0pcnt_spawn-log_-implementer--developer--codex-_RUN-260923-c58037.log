trunk_old = entries(old_base)
trunk_new = entries(new_base)
candidate = entries(candidate_tree)
backup_entries = entries(backup)
trunk_mismatches = [p for p in trunk_only if candidate.get(p) "'!= trunk_new.get(p)]
config_equal = candidate.get("task-board.config.json") == trunk_new.get("task-board.config.json")

backup_paths = sorted(set(run(["diff", "--name-only", "8d944c7", backup]).decode().splitlines()))
