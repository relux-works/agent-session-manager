    for item in raw.split(b\"\\0\"):
        if item:
            header, path = item.split(b\"\\t\", 1)
            mode, kind, oid = header.decode(\"ascii\").split()
            out[path.decode(\"utf-8\", \"surrogateescape\")] = (mode, kind, oid)
    return out

run([\"read-tree\", \"HEAD\"])
run([\"add\", \"-A\", \"--\", \".\"])
