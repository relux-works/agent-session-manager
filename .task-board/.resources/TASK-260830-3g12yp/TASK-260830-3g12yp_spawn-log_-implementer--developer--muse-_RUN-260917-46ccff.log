{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c82d","stream":{"kind":"session","id":"01a0adcf-af6f-7db0-8726-470499e8596b"},"sequence":625,"recorded_at":1780531400001245,"record_type":"event","durability":"durable","causation_id":"3b578cbb-cd1c-4970-859d-8c242cd48356","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3b578cbb-cd1c-4970-859d-8c242cd48356","run_stream":{"kind":"run","id":"3b578cbb-cd1c-4970-859d-8c242cd48356"},"task_stream":{"kind":"task","id":"01a0add1-2dad-7ae2-8778-4d60539b8f8b"},"task_id":"01a0add1-2dad-7ae2-8778-4d60539b8f8b","event":{"kind":"output","task_id":"01a0add1-2dad-7ae2-8778-4d60539b8f8b","chunk":"Read text file `internal/sessquery/lease_store_adopt_test.go`.\n1|// Lease-store adoption tests for TASK-260830-2f5393: records minted and\n2|// persisted through the sessrepo lease lifecycle must admit through the\n3|// unchanged query-layer admission (winningLeaseFor/BuildPlan) with the\n4|// same digest, epoch, lease ID, and holder the store reports. This is the\n5|// no-second-lease-model proof: the store and the selector share one\n6|// record shape and one tuple rule.\n7|package sessquery\n8|\n9|import (\n10|\t\"testing\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n14|)\n15|\n16|func TestLeaseStoreRecordsAdmitWithoutBehavioralChange(t *testing.T) {\n17|\treader := successorFixture(t)\n18|\tfirst, err := reader.Local.CreateLease(idA, sessrepo.CreateLeaseInput{LeaseID: lease, HolderHostID: hostA, IssuedByHostID: hostA, CreatedAt: \"2026-08-19T04:09:00.000Z\"})\n19|\tif err != nil {\n20|\t\tt.Fatalf(\"CreateLease error = %v\", err)\n21|\t}\n22|\tcheckpoint := checkpointWithHeads(t, checkpointRecordBytes(t, idA, 1, lease, hostA), headAtOrBefore(t, reader, idA, 1))\n23|\twithCheckpoints(reader, checkpoint)\n24|\tsecond, err := reader.Local.CompareAndSwapLease(idA, sessrepo.LeaseExpectation{RecordID: first.RecordID}, sessrepo.SuccessorLeaseInput{\n25|\t\tCreateLeaseInput: sessrepo.CreateLeaseInput{LeaseID: leaseB, HolderHostID: hostA, IssuedByHostID: hostA, CreatedAt: \"2026-08-19T04:09:00.000Z\"},\n26|\t\tReason:           \"graceful_takeover\",\n27|\t\tCheckpointID:     checkpointDigestOf(t, checkpoint),\n28|\t})\n29|\tif err != nil {\n30|\t\tt.Fatalf(\"CompareAndSwapLease error = %v\", err)\n31|\t}\n32|\tfirstBytes, err := reader.Local.GetLease(idA, first.RecordID)\n33|\tif err != nil {\n34|\t\tt.Fatalf(\"GetLease(first) error = %v\", err)\n35|\t}\n36|\tsecondBytes, err := reader.Local.GetLease(idA, second.RecordID)\n37|\tif err != nil {\n38|\t\tt.Fatalf(\"GetLease(second) error = %v\", err)\n39|\t}\n40|\treader.LeaseRecords = nil\n41|\twithLeases(reader, firstBytes, secondBytes)\n42|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n43|\tif plan.LeaseEpoch != 2 || plan.LeaseID != leaseB || plan.OwnerHostID != hostA || plan.LeaseRecordID != second.RecordID {\n44|\t\tt.Fatalf(\"store-minted succession plan = %+v, want epoch 2 %s %s %s\", plan, leaseB, hostA, second.RecordID)\n45|\t}\n46|\twinner, err := reader.winningLeaseFor(idA, \"direct\", reader.Local)\n47|\tif err != nil {\n48|\t\tt.Fatal(err)\n49|\t}\n50|\tstoreWinner, err := reader.Local.WinningLease(idA)\n51|\tif err != nil {\n52|\t\tt.Fatalf(\"WinningLease error = %v\", err)\n53|\t}\n54|\tif winner.Digest != storeWinner.RecordID || winner.Epoch != storeWinner.Epoch || winner.LeaseID != storeWinner.LeaseID || winner.HolderHostID != storeWinner.HolderHostID {\n55|\t\tt.Fatalf(\"admitted winner %+v disagrees with store winner %+v\", winner, storeWinner)\n56|\t}\n57|\tif err := reader.Revalidate(plan); err != nil {\n58|\t\tt.Fatalf(\"store-minted succession plan is not current: %v\", err)\n59|\t}\n60|}\n61|\n62|// TestLeaseTupleOrderAgreesWithSessstateCompare pins the cross-package\n63|// tuple rule: sessrepo.CompareLeaseTuple (which cannot import sessstate)\n64|// must order every corpus pair exactly like sessstate.Compare.\n65|func TestLeaseTupleOrderAgreesWithSessstateCompare(t *testing.T) {\n66|\tpairs := [][4]any{\n67|\t\t{uint64(1), lease, uint64(2), lease},\n68|\t\t{uint64(2), lease, uint64(1), leaseB},\n69|\t\t{uint64(2), lease, uint64(2), leaseB},\n70|\t\t{uint64(2), leaseB, uint64(2), lease},\n71|\t\t{uint64(3), leaseB, uint64(3), leaseB},\n72|\t\t{uint64(1), leaseB, uint64(1), lease},\n73|\t}\n74|\tsign := func(value int) int {\n75|\t\tswitch {\n76|\t\tcase value < 0:\n77|\t\t\treturn -1\n78|\t\tcase value > 0:\n79|\t\t\treturn 1\n80|\t\t}\n81|\t\treturn 0\n82|\t}\n83|\tfor _, pair := range pairs {\n84|\t\tepochA := pair[0].(uint64)\n85|\t\tleaseA := pair[1].(string)\n86|\t\tepochB := pair[2].(uint64)\n87|\t\tleaseB := pair[3].(string)\n88|\t\tgot := sign(sessrepo.CompareLeaseTuple(\n89|\t\t\tsessrepo.LeaseSummary{Epoch: epochA, LeaseID: leaseA},\n90|\t\t\tsessrepo.LeaseSummary{Epoch: epochB, LeaseID: leaseB},\n91|\t\t))\n92|\t\twant := sign(sessstate.Compare(\n93|\t\t\tsessstate.LeaseHead{Epoch: epochA, LeaseID: leaseA},\n94|\t\t\tsessstate.LeaseHead{Epoch: epochB, LeaseID: leaseB},\n95|\t\t))\n96|\t\tif got != want {\n97|\t\t\tt.Fatalf(\"tuple (%d %s) vs (%d %s): sessrepo = %d, sessstate = %d\", epochA, leaseA, epochB, leaseB, got, want)\n98|\t\t}\n99|\t}\n100|}","final_result":true}}}
