{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cfc3","stream":{"kind":"session","id":"01a0adcf-af6f-7db0-8726-470499e8596b"},"sequence":1596,"recorded_at":1780531400003187,"record_type":"event","durability":"durable","causation_id":"3b578cbb-cd1c-4970-859d-8c242cd48356","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3b578cbb-cd1c-4970-859d-8c242cd48356","run_stream":{"kind":"run","id":"3b578cbb-cd1c-4970-859d-8c242cd48356"},"task_stream":{"kind":"task","id":"01a0addc-74eb-7b32-8c2e-d7965524755e"},"task_id":"01a0addc-74eb-7b32-8c2e-d7965524755e","event":{"kind":"output","task_id":"01a0addc-74eb-7b32-8c2e-d7965524755e","chunk":"{\n  \"chunk_id\": \"exec-49-1\",\n  \"command\": \"sed -n '890,1010p' internal/sessstate/sessstate.go; echo \\\"===buildEvent===\\\"; grep -n \\\"func buildEvent\\\\|func mustAppend\\\\|lease_sequence\\\" internal/sessrepo/sessrepo_test.go | head\",\n  \"description\": \"Read union resolution and event builder\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"\\tfold.seenCheckpoint = true\\n\\tfold.projection.HasCheckpoint = true\\n\\tfold.projection.Newest = Checkpoint{ID: id, Kind: kind, EventID: eventID}\\n}\\n\\n// resolveWinner selects the winning lease over the authoritative chain\\n// leases and the union leases by the greatest (epoch, lease_id)\\n// tuple. A same-epoch tie resolves to the bytewise-greater lease ID;\\n// an off-chain union winner moves the reported winner but never\\n// rewrites authoritative state; union leases that lose are reported\\n// preserved-never-applied. With no union the chain head wins alone\\n// and no conflict is recorded.\\nfunc (fold *chainFold) resolveWinner(union []LeaseHead) error {\\n\\twinner := fold.current\\n\\tonChain := map[string]struct{}{}\\n\\tif fold.haveLease {\\n\\t\\tonChain[fold.current.LeaseID] = struct{}{}\\n\\t}\\n\\tfor _, lease := range fold.chainLeases() {\\n\\t\\tonChain[lease.LeaseID] = struct{}{}\\n\\t}\\n\\tbyEpoch := map[uint64]map[string]struct{}{}\\n\\tnote := func(lease LeaseHead) {\\n\\t\\tif byEpoch[lease.Epoch] == nil {\\n\\t\\t\\tbyEpoch[lease.Epoch] = map[string]struct{}{}\\n\\t\\t}\\n\\t\\tbyEpoch[lease.Epoch][lease.LeaseID] = struct{}{}\\n\\t}\\n\\tfor _, lease := range fold.chainLeases() {\\n\\t\\tnote(lease)\\n\\t}\\n\\toffChainWinner := false\\n\\tfor _, lease := range union {\\n\\t\\tif lease.IsZero() {\\n\\t\\t\\treturn refuse(ErrInvalidEvent, \\\"union carries an empty lease head\\\")\\n\\t\\t}\\n\\t\\tif _, err := scalar.ParseUUIDv4(lease.LeaseID); err != nil {\\n\\t\\t\\treturn refuse(ErrInvalidEvent, \\\"union lease %q is not a UUIDv4: %v\\\", lease.LeaseID, err)\\n\\t\\t}\\n\\t\\tnote(lease)\\n\\t\\tswitch Compare(lease, winner) {\\n\\t\\tcase 1:\\n\\t\\t\\twinner = lease\\n\\t\\t\\tif _, ok := onChain[lease.LeaseID]; !ok {\\n\\t\\t\\t\\toffChainWinner = true\\n\\t\\t\\t}\\n\\t\\tcase -1:\\n\\t\\t\\tfold.conflict(ConflictLosingBranchPreserved, ResolveRulePreservedNeverApplied,\\n\\t\\t\\t\\t\\\"union lease (%d, %s) loses to (%d, %s); its history stays preserved and never applies\\\",\\n\\t\\t\\t\\tlease.Epoch, lease.LeaseID, winner.Epoch, winner.LeaseID)\\n\\t\\tcase 0:\\n\\t\\t\\t// A duplicate union entry names the tuple already\\n\\t\\t\\t// selected: the winner and the off-chain flag stand.\\n\\t\\t\\t// Clearing here would drop a correctly recorded\\n\\t\\t\\t// union_supersedes_chain conflict (and its\\n\\t\\t\\t// divergent_history warning) on a repeated entry.\\n\\t\\t}\\n\\t}\\n\\tepochs := make([]uint64, 0, len(byEpoch))\\n\\tfor epoch := range byEpoch {\\n\\t\\tepochs = append(epochs, epoch)\\n\\t}\\n\\tsort.Slice(epochs, func(i, j int) bool { return epochs[i] < epochs[j] })\\n\\tfor _, epoch := range epochs {\\n\\t\\trivals := byEpoch[epoch]\\n\\t\\tif len(rivals) < 2 {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tordered := make([]string, 0, len(rivals))\\n\\t\\tfor id := range rivals {\\n\\t\\t\\tordered