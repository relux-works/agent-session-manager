{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d98b","stream":{"kind":"session","id":"01a0adcf-af6f-7db0-8726-470499e8596b"},"sequence":2848,"recorded_at":1780531400005691,"record_type":"event","durability":"durable","causation_id":"3b578cbb-cd1c-4970-859d-8c242cd48356","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3b578cbb-cd1c-4970-859d-8c242cd48356","run_stream":{"kind":"run","id":"3b578cbb-cd1c-4970-859d-8c242cd48356"},"task_stream":{"kind":"task","id":"01a0ade4-af45-7662-9494-c5acfde2f9b9"},"task_id":"01a0ade4-af45-7662-9494-c5acfde2f9b9","event":{"kind":"output","task_id":"01a0ade4-af45-7662-9494-c5acfde2f9b9","chunk":"{\n  \"chunk_id\": \"exec-71-1\",\n  \"command\": \"python3 - <<'EOF'\\nfrom pathlib import Path\\ngate = Path('internal/fencing/gate.go').read_text()\\nterm = Path('internal/fencing/terminate.go').read_text()\\ntok = Path('internal/fencing/token.go').read_text()\\nanchors = [\\n (gate, 'case OperationActivation, OperationInput, OperationMutation, OperationCheckpoint, OperationRestore:'),\\n (gate, 'if _, err := scalar.ParseUUIDv7(presented.SessionID); err != nil {'),\\n (gate, 'if presented.Epoch == 0 {'),\\n (gate, 'if _, err := scalar.ParseUUIDv4(presented.LeaseID); err != nil {'),\\n (gate, 'if observation.Winner.Epoch == 0 || !validLeaseID(observation.Winner.LeaseID) || !validHostID(observation.Winner.HolderHostID) {'),\\n (gate, '\\\\t\\\"errors\\\"\\\\n\\\\t\\\"fmt\\\"\\\\n\\\\t\\\"time\\\"'),\\n (gate, 'if presented.SessionID != observation.SessionID {'),\\n (gate, 'if !observation.HasWinner {'),\\n (gate, 'if !observation.Verified {'),\\n (gate, 'if observation.Ambiguous {'),\\n (gate, 'if observation.HandoffFailed {'),\\n (gate, 'if !observation.HasGrant {'),\\n (gate, 'if observation.Now.IsZero() {'),\\n (gate, 'sessrepo.CheckFencingExpiry(observation.Grant, observation.Policy, observation.Now)'),\\n (gate, 'if errors.Is(err, sessrepo.ErrFencingExpired) {'),\\n (gate, 'if observation.Winner.HolderHostID != observation.LocalHostID {'),\\n (gate, 'epochsEqual := presented.Epoch == observation.Winner.Epoch'),\\n (gate, 'if presented.LeaseID != observation.Winner.LeaseID {'),\\n (gate, 'return op == OperationActivation || op == OperationRestore'),\\n (tok, 'if token.seal == nil || token.seal.token == nil {'),\\n (tok, 'case ProviderQuiesce, ProviderCapture, ProviderMaterialize:'),\\n (term, 'if _, err := scalar.ParseUUIDv4(presented.LeaseID); err != nil {'),\\n (term, 'if winner.Epoch == 0 || !validLeaseID(winner.LeaseID) {'),\\n (term, 'if !hasWinner {'),\\n (term, 'if !forceRecovery {'),\\n (term, 'if !diagnosticsPreserved {'),\\n (term, 'if presented.SessionID != winner.SessionID {'),\\n (term, 'if presented.Epoch == winner.Epoch && presented.LeaseID == winner.LeaseID {'),\\n (gate, '// Arm order is precedence: malformed calls die first, then foreign'),\\n]\\nbad = [(a[:60], c) for (_, a), c in [((None, x[1]), x[0].count(x[1])) for x in anchors] if c != 1]\\nprint('BAD:', bad if bad else 'all anchors unique')\\nEOF\",\n  \"description\": \"Verify mutant anchors unique\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"BAD: all anchors unique\\n\",\n  \"original_output_bytes\": 24,\n  \"original_output_tokens\": 6,\n  \"truncated\": false\n}","final_result":true}}}
