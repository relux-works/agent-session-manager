{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4bb","stream":{"kind":"session","id":"01a0adcf-af6f-7db0-8726-470499e8596b"},"sequence":184,"recorded_at":1780531400000363,"record_type":"event","durability":"durable","causation_id":"3b578cbb-cd1c-4970-859d-8c242cd48356","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"3b578cbb-cd1c-4970-859d-8c242cd48356","run_stream":{"kind":"run","id":"3b578cbb-cd1c-4970-859d-8c242cd48356"},"call_id":"call_01a0add01e4e7655a27cc17ac297e3f8","text":"Read text file `internal/sessrepo/store.go`.\n1|package sessrepo\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"runtime\"\n8|\t\"sort\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|)\n12|\n13|// syncDirectory fsyncs a directory so a rename inside it survives a crash.\n14|// Opening a directory fails on Windows, where the rename itself is the\n15|// durability boundary; there the sync is skipped, never faked.\n16|func syncDirectory(path string) error {\n17|\tif runtime.GOOS == \"windows\" {\n18|\t\treturn nil\n19|\t}\n20|\tdirectory, err := os.Open(path)\n21|\tif err != nil {\n22|\t\treturn fmt.Errorf(\"open directory for fsync: %w\", err)\n23|\t}\n24|\tdefer func() { _ = directory.Close() }()\n25|\tif err := directory.Sync(); err != nil {\n26|\t\treturn fmt.Errorf(\"fsync directory: %w\", err)\n27|\t}\n28|\treturn nil\n29|}\n30|\n31|// GetRecord returns the byte-identical Session Record for a session,\n32|// re-verified through the canonical owner on every read.\n33|func (repository *Repository) GetRecord(sessionID string) ([]byte, error) {\n34|\trepository.mutex.Lock()\n35|\tdefer repository.mutex.Unlock()\n36|\tview, err := repository.loadSessionLocked(sessionID)\n37|\tif err != nil {\n38|\t\treturn nil, err\n39|\t}\n40|\treturn append([]byte(nil), view.record.raw...), nil\n41|}\n42|\n43|// GetEvent returns the byte-identical chained event for its digest.\n44|func (repository *Repository) GetEvent(sessionID, eventID string) ([]byte, error) {\n45|\tif _, err := scalar.ParseDigest(eventID); err != nil {\n46|\t\treturn nil, refuse(ErrUnknownEvent, \"malformed event id %q\", eventID)\n47|\t}\n48|\trepository.mutex.Lock()\n49|\tdefer repository.mutex.Unlock()\n50|\tview, err := repository.loadSessionLocked(sessionID)\n51|\tif err != nil {\n52|\t\treturn nil, err\n53|\t}\n54|\tfor _, indexed := range view.chain.Events {\n55|\t\tif indexed.EventID == eventID {\n56|\t\t\tblob, err := os.ReadFile(filepath.Join(view.directory, \"events\", blobFileName(eventID)))\n57|\t\t\tif err != nil {\n58|\t\t\t\treturn nil, fmt.Errorf(\"read chained event for session %s: %w\", sessionID, err)\n59|\t\t\t}\n60|\t\t\treturn blob, nil\n61|\t\t}\n62|\t}\n63|\treturn nil, refuse(ErrUnknownEvent, \"unknown event %q in session %s\", eventID, sessionID)\n64|}\n65|\n66|// ListEvents returns the chain summaries in authoritative order.\n67|func (repository *Repository) ListEvents(sessionID string) ([]EventSummary, error) {\n68|\trepository.mutex.Lock()\n69|\tdefer repository.mutex.Unlock()\n70|\tview, err := repository.loadSessionLocked(sessionID)\n71|\tif err != nil {\n72|\t\treturn nil, err\n73|\t}\n74|\treturn append([]EventSummary(nil), view.chain.Events...), nil\n75|}\n76|\n77|// ListSessions returns one summary per stored session in session-ID order,\n78|// healthy sessions first-class and parked sessions on the per-session\n79|// parked channel. A session whose bytes no longer verify never fails the\n80|// listing for its siblings: it is returned as a parked entry (Parked=true)\n81|// carrying the blocking reason and the same-operation retry the Section\n82|// 5.7 reducer and the Section 14.4 rendering leaves project into the\n83|// parked lifecycle state and its warnings. Only a failure to read the\n84|// sessions root itself is a listing error.\n85|//\n86|// Decision record (SPEC.md:9082, Section 13.13 recoverable_parked_state;\n87|// Section 14.4 per-session warnings): the prior closed-listing rule failed\n88|// the whole repository — one parked session removed every healthy sibling\n89|// from listing and name resolution, and only the byte-identical original\n90|// record healed it, so lost bytes bricked the repository permanently with\n91|// no per-session channel for downstream leaves to render. Per-session\n92|// parked reporting keeps healthy sessions listable and resolvable while\n93|// the parked session stays visible with its reason and retry. The tradeoff\n94|// is that callers must check Parked instead of relying on an error: a\n95|// listing with parked entries returns nil error by design. See doc.go for\n96|// the retry table and the operator remedy when no retry heals.\n97|func (repository *Repository) ListSessions() ([]SessionSummary, error) {\n98|\trepository.mutex.Lock()\n99|\tdefer repository.mutex.Unlock()\n100|\treturn repository.listSessionsLocked()\n101|}\n102|\n103|// Resolve implements the local steps of SPEC.md Section 2.3: an exact live\n104|// session name in the local index wins first; a UUID query routes to its\n105|// session; anything else is not found. Names display with original case\n106|// but collide under ASCII case folding because the allowed alphabet is\n107|// ASCII, and a colliding query fails with ErrNameAmbiguous. Parked\n108|// sessions never participate: listing reports them per session, but name\n109|// resolution routes only healthy sessions, so one parked sibling cannot\n110|// deny service to the rest. A query naming only a parked session is not\n111|// found. Peer-learned names and the interactive choice surface belong to\n112|// the name-resolution leaf, which builds on this entry.\n113|func (repository *Repository) Resolve(query string) (SessionSummary, error) {\n114|\trepository.mutex.Lock()\n115|\tdefer repository.mutex.Unlock()\n116|\tsummaries, err := repository.listSessionsLocked()\n117|\tif err != nil {\n118|\t\treturn SessionSummary{}, err\n119|\t}\n120|\tvar live []SessionSummary\n121|\tfor _, summary := range summaries {\n122|\t\tif !summary.Parked {\n123|\t\t\tlive = append(live, summary)\n124|\t\t}\n125|\t}\n126|\tvar folded []SessionSummary\n127|\tfor _, summary := range live {\n128|\t\tif asciiFold(summary.Name) == asciiFold(query) {\n129|\t\t\tfolded = append(folded, summary)\n130|\t\t}\n131|\t}\n132|\tif len(folded) > 1 {\n133|\t\treturn SessionSummary{}, refuse(ErrNameAmbiguous, \"name %q collides across %d sessions\", query, len(folded))\n134|\t}\n135|\tif len(folded) == 1 && folded[0].Name == query {\n136|\t\treturn folded[0], nil\n137|\t}\n138|\tif id, err := scalar.ParseUUIDv7(query); err == nil {\n139|\t\tfor _, summary := range live {\n140|\t\t\tif summary.SessionID == id.String() {\n141|\t\t\t\treturn summary, nil\n142|\t\t\t}\n143|\t\t}\n144|\t}\n145|\treturn SessionSummary{}, refuse(ErrNameNotFound, \"no live session named %q\", query)\n146|}\n147|\n148|// listSessionsLocked shares the listing scan with Resolve without\n149|// re-locking. Per-session load failures become parked entries; only the\n150|// root read is an error. Callers hold the repository mutex.\n151|func (repository *Repository) listSessionsLocked() ([]SessionSummary, error) {\n152|\tentries, err := os.ReadDir(repository.root)\n153|\tif err != nil {\n154|\t\treturn nil, refuse(ErrRepositoryPath, \"read sessions root: %v\", err)\n155|\t}\n156|\tvar summaries []SessionSummary\n157|\tfor _, entry := range entries {\n158|\t\tif !entry.IsDir() {\n159|\t\t\tcontinue\n160|\t\t}\n161|\t\tview, err := repository.loadSessionLocked(entry.Name())\n162|\t\tif err != nil {\n163|\t\t\tsummaries = append(summaries, parkedSummary(repository.sessionDir(entry.Name()), entry.Name(), err))\n164|\t\t\tcontinue\n165|\t\t}\n166|\t\tsummary := SessionSummary{SessionID: view.record.sessionID, RecordID: view.record.recordID, Name: view.record.name, Kind: view.record.kind, ProviderID: view.record.provider, EventCount: len(view.chain.Events)}\n167|\t\tif len(view.chain.Events) > 0 {\n168|\t\t\tsummary.TailEvent = view.chain.Events[len(view.chain.Events)-1].EventID\n169|\t\t}\n170|\t\tsummaries = append(summaries, summary)\n171|\t}\n172|\tsort.Slice(summaries, func(i, j int) bool { return summaries[i].SessionID < summaries[j].SessionID })\n173|\treturn summaries, nil\n174|}\n175|\n176|// retryHintForTornStore names the remedy when no same-operation retry can\n177|// heal: the parked bytes are not an interrupted create (the chain index is\n178|// present but the store no longer verifies), so CreateSession cannot\n179|// resume it. The operator remedy is documented in doc.go.\n180|const retryHintForTornStore = \"no CreateSession retry heals this state; see the operator remedy for parked sessions\"\n181|\n182|// parkedSummary builds the per-session parked channel for one load\n183|// failure: the session directory name is always reported, the blocking\n184|// reason names the recoverable_parked_state block with its per-session\n185|// cause, and the retry hint names the same-operation retry when one\n186|// exists. Identity members are filled from the parked record when it\n187|// still verifies; otherwise they stay empty. It reports parked state as\n188|// data and refuses nothing, so the refusal census is unchanged.\n189|func parkedSummary(directory, sessionID string, loadErr error) SessionSummary {\n190|\tsummary := SessionSummary{SessionID: sessionID, Parked: true, BlockingReason: \"recoverable_parked_state: \" + loadErr.Error()}\n191|\tif _, err := os.Stat(filepath.Join(directory, \"chain.json\")); os.IsNotExist(err) {\n192|\t\trecordBytes, readErr := os.ReadFile(filepath.Join(directory, \"record.json\"))\n193|\t\tif readErr != nil {\n194|\t\t\tif !os.IsNotExist(readErr) {\n195|\t\t\t\tsummary.RetryHint = retryHintForTornStore\n196|\t\t\t\treturn summary\n197|\t\t\t}\n198|\t\t\tsummary.RetryHint = retryHintForBareDirectory\n199|\t\t\treturn summary\n200|\t\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4bd","stream":{"kind":"session","id":"01a0adcf-af6f-7db0-8726-470499e8596b"},"sequence":185,"recorded_at":1780531400000365,"record_type":"event","durability":"durable","causation_id":"3b578cbb-cd1c-4970-859d-8c242cd48356","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"3b578cbb-cd1c-4970-859d-8c242cd48356","run_stream":{"kind":"run","id":"3b578cbb-cd1c-4970-859d-8c242cd48356"},"call_id":"call_01a0add0204a767985b7f504dbd2990c","text":"Read text file `internal/sessstate/sessstate.go`.\n1|package sessstate\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|\t\"sort\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n10|)\n11|\n12|// SessionState spellings in SPEC.md Section 5.7 declared order. Every\n13|// RPC and CLI field typed SessionState uses exactly this registry; the\n14|// spellings created, starting, and quiesced are not session lifecycle\n15|// states. The const block below is the single production source of the\n16|// registry: no other production literal may name a state spelling, so\n17|// the census derives the state space from these lines.\n18|const (\n19|\tStateCreating      State = \"creating\"\n20|\tStateRunning       State = \"running\"\n21|\tStateIdle          State = \"idle\"\n22|\tStateQuiescing     State = \"quiescing\"\n23|\tStateCheckpointing State = \"checkpointing\"\n24|\tStateStopped       State = \"stopped\"\n25|\tStateMaterializing State = \"materializing\"\n26|\tStateParked        State = \"parked\"\n27|\tStateFailed        State = \"failed\"\n28|\tStateStale         State = \"stale\"\n29|\tStateTombstoned    State = \"tombstoned\"\n30|)\n31|\n32|// State is one Section 5.7 lifecycle value.\n33|type State string\n34|\n35|// States returns the SessionState registry in Section 5.7 declared\n36|// order. It converts the const block above instead of retyping the\n37|// spellings, so every state literal lives exactly once in production\n38|// and the census can require that single source. Callers must not\n39|// invent spellings beside this list.\n40|func States() []string {\n41|\treturn []string{\n42|\t\tstring(StateCreating), string(StateRunning), string(StateIdle),\n43|\t\tstring(StateQuiescing), string(StateCheckpointing),\n44|\t\tstring(StateStopped), string(StateMaterializing),\n45|\t\tstring(StateParked), string(StateFailed), string(StateStale),\n46|\t\tstring(StateTombstoned),\n47|\t}\n48|}\n49|\n50|// allowedTransitions is the Section 5.7 transition table, the single\n51|// source the step gate enforces. A same-state restatement (a confirming\n52|// event while already in the target state) is not a transition and\n53|// needs no edge; every other move needs exactly the edge below.\n54|var allowedTransitions = map[State]map[State]struct{}{\n55|\tStateCreating: {\n56|\t\tStateRunning: {}, StateIdle: {}, StateFailed: {},\n57|\t},\n58|\tStateRunning: {\n59|\t\tStateIdle: {}, StateQuiescing: {}, StateFailed: {}, StateStale: {},\n60|\t},\n61|\tStateIdle: {\n62|\t\tStateRunning: {}, StateQuiescing: {}, StateCheckpointing: {},\n63|\t\tStateStopped: {}, StateStale: {},\n64|\t},\n65|\tStateQuiescing: {\n66|\t\tStateIdle: {}, StateCheckpointing: {}, StateFailed: {}, StateStale: {},\n67|\t},\n68|\tStateCheckpointing: {\n69|\t\tStateIdle: {}, StateStopped: {}, StateMaterializing: {}, StateFailed: {},\n70|\t},\n71|\tStateMaterializing: {\n72|\t\tStateStopped: {}, StateRunning: {}, StateParked: {}, StateFailed: {},\n73|\t},\n74|\tStateStopped: {\n75|\t\tStateMaterializing: {}, StateRunning: {}, StateParked: {}, StateTombstoned: {},\n76|\t},\n77|\tStateParked: {\n78|\t\tStateMaterializing: {}, StateRunning: {}, StateStopped: {}, StateStale: {},\n79|\t},\n80|\tStateFailed: {\n81|\t\tStateCreating: {}, StateStopped: {}, StateParked: {},\n82|\t\tStateMaterializing: {}, StateStale: {}, StateTombstoned: {},\n83|\t},\n84|\tStateStale: {\n85|\t\tStateStopped: {}, StateTombstoned: {},\n86|\t},\n87|}\n88|\n89|// initialTargets bounds the first event of a chain: a session opens in\n90|// one of these states, and only through its bootstrap event. Any other\n91|// first event is invalid_state_transition, not a silent default.\n92|var initialTargets = map[State]struct{}{\n93|\tStateCreating: {}, StateRunning: {}, StateIdle: {}, StateFailed: {},\n94|}\n95|\n96|// staleSources bounds the local-stale override the same way the table\n97|// bounds every other move into stale: the override applies only when\n98|// the winner projection stands in a state the table lets go stale,\n99|// otherwise the winner state stands with the lease conflict recorded.\n100|var staleSources = map[State]struct{}{\n101|\tStateRunning: {}, StateIdle: {}, StateQuiescing: {},\n102|\tStateFailed: {}, StateParked: {},\n103|}\n104|\n105|var (\n106|\tErrInvalidRecord     = errors.New(\"invalid session record\")\n107|\tErrInvalidEvent      = errors.New(\"invalid session event\")\n108|\tErrInvalidTransition = errors.New(\"invalid_state_transition\")\n109|\tErrIntegrity         = errors.New(\"integrity_failure\")\n110|\tErrDerivation        = errors.New(\"derivation input is corrupt\")\n111|\tErrUnknownSession    = errors.New(\"unknown session\")\n112|\tErrStaleLease        = errors.New(\"event lease epoch precedes the chain head\")\n113|\tErrDivergentLease    = errors.New(\"divergent lease branch cannot be authoritative\")\n114|)\n115|\n116|// refuse is the single refusal funnel every sessstate rejection flows\n117|// through. It is a var so the census TestMain can wrap it and record\n118|// the production file:line behind each exercised refusal. No production\n119|// path wraps a sentinel with fmt.Errorf directly.\n120|var refuse = func(sentinel error, format string, arguments ...any) error {\n121|\treturn fmt.Errorf(\"%w: %s\", sentinel, fmt.Sprintf(format, arguments...))\n122|}\n123|\n124|// LeaseHead is one observed fencing token: the winning-lease pair\n125|// carried by every owner-authored event and mutation.\n126|type LeaseHead struct {\n127|\tEpoch   uint64\n128|\tLeaseID string\n129|}\n130|\n131|// IsZero reports an unset lease head: no local lease was supplied.\n132|func (head LeaseHead) IsZero() bool {\n133|\treturn head.Epoch == 0 && head.LeaseID == \"\"\n134|}\n135|\n136|// Compare orders two lease heads by the Section 5.3 tuple rule: the\n137|// greatest (epoch, lease_id) wins, where lease_id uses bytewise UUID\n138|// order. Lease IDs are canonical lowercase UUIDv4, so string order is\n139|// bytewise order.\n140|func Compare(a, b LeaseHead) int {\n141|\tif a.Epoch != b.Epoch {\n142|\t\tif a.Epoch < b.Epoch {\n143|\t\t\treturn -1\n144|\t\t}\n145|\t\treturn 1\n146|\t}\n147|\tswitch {\n148|\tcase a.LeaseID < b.LeaseID:\n149|\t\treturn -1\n150|\tcase a.LeaseID > b.LeaseID:\n151|\t\treturn 1\n152|\t}\n153|\treturn 0\n154|}\n155|\n156|// Conflict kinds. A conflict is reported data, never an error: both\n157|// sides were individually admittable, so the projection names the rule\n158|// that resolved them.\n159|const (\n160|\t// ConflictSameEpochTie ResolveRuleGreatestLeaseIDWins: two distinct\n161|\t// leases share the winning epoch (concurrent force takeovers under\n162|\t// partition); the bytewise-greater lease ID wins.\n163|\tConflictSameEpochTie = \"same_epoch_tie\"\n164|\t// ConflictEpochGap ResolveRuleGreatestTupleWins: a successor epoch\n165|\t// skips its predecessor (epoch N to N+2 or more); the greatest\n166|\t// tuple still wins, and only an explicit takeover checkpoint heals\n167|\t// the gap.\n168|\tConflictEpochGap = \"epoch_gap\"\n169|\t// ConflictLosingBranchPreserved ResolveRulePreservedNeverApplied:\n170|\t// an observed lease loses the tuple comparison; its history stays\n171|\t// preserved but never affects authoritative state.\n172|\tConflictLosingBranchPreserved = \"losing_branch_preserved\"\n173|\t// ConflictProviderMismatch ResolveRuleRecordPinnedProviderWins:\n174|\t// a launch event names a provider other than the immutable Session\n175|\t// Record provider; the record value stays authoritative.\n176|\tConflictProviderMismatch = \"provider_mismatch\"\n177|\t// ConflictUnionSupersedesChain\n178|\t// ResolveRuleAuthoritativeStateUnchanged: the union winner is not\n179|\t// among the authoritative chain leases; the reported winner moves\n180|\t// but derived state does not until an explicit takeover lands.\n181|\tConflictUnionSupersedesChain = \"union_supersedes_chain\"\n182|)\n183|\n184|// Resolution rules named by conflicts.\n185|const (\n186|\tResolveRuleGreatestLeaseIDWins         = \"greatest-lease-id-wins\"\n187|\tResolveRuleGreatestTupleWins           = \"greatest-tuple-wins\"\n188|\tResolveRulePreservedNeverApplied       = \"preserved-never-applied\"\n189|\tResolveRuleRecordPinnedProviderWins    = \"record-pinned-provider-wins\"\n190|\tResolveRuleAuthoritativeStateUnchanged = \"authoritative-state-unchanged\"\n191|)\n192|\n193|// Conflict is one resolved lease or identity conflict.\n194|type Conflict struct {\n195|\tKind   string\n196|\tRule   string\n197|\tDetail string\n198|}\n199|\n200|// Checkpoint is the newest validated checkpoint the projection knows.\n201|type Checkpoint struct {\n202|\tID      string\n203|\tKind    string\n204|\tEventID string\n205|}\n206|\n207|// ProviderIdentity is the derived provider surface: the immutable\n208|// record provider, the newest launched version, and the newest\n209|// identified record with its confidence.\n210|type ProviderIdentity struct {\n211|\tID               string\n212|\tVersion          string\n213|\tIdentityRecordID string\n214|\tConfidence       string\n215|}\n216|\n217|// TerminalBinding is the current terminal surface: the newest\n218|// terminal.created or session.resumed binding. V1 bindings carry the\n219|// backend with the terminal or native session handle; v4 bindings\n220|// carry the binding digest with the backend and versions.\n221|type TerminalBinding struct {\n222|\tBackend         string\n223|\tBindingID       string\n224|\tTerminalID      string\n225|\tNativeSessionID string\n226|\tEventID         string\n227|}\n228|\n229|// ParkedFacts carries the per-session parked channel from sessrepo\n230|// into the projection: the recoverable_parked_state blocking reason\n231|// and the same-operation retry.\n232|type ParkedFacts struct {\n233|\tBlockingReason string\n234|\tRetryHint      string\n235|}\n236|\n237|// Record is the decoded Session Record surface the reducer reads.\n238|type Record struct {\n239|\tSessionID  string\n240|\tRecordID   string\n241|\tName       string\n242|\tKind       string\n243|\tProviderID string\n244|}\n245|\n246|// Event is one decoded authoritative Session Event: the routing\n247|// members plus the closed payload object admitted by the canonical\n248|// owner at decode time.\n249|type Event struct {\n250|\tID              string\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4bf","stream":{"kind":"session","id":"01a0adcf-af6f-7db0-8726-470499e8596b"},"sequence":186,"recorded_at":1780531400000367,"record_type":"event","durability":"durable","causation_id":"3b578cbb-cd1c-4970-859d-8c242cd48356","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"3b578cbb-cd1c-4970-859d-8c242cd48356","run_stream":{"kind":"run","id":"3b578cbb-cd1c-4970-859d-8c242cd48356"},"call_id":"call_01a0add021ed708da9157e1749f509d4","text":"Read text file `internal/sessquery/lease.go`.\n1|// Validated Lease Record admission for the v0.6.0 selector contract\n2|// (SPEC Sections 5.3 and 14.7.2).\n3|//\n4|// The reader carries canonical Lease Record bytes from the lease owner\n5|// in Reader.LeaseRecords. Each record is validated through the\n6|// canonicaljson owner (closed shape plus canonical self identity), and\n7|// the greatest (epoch, lease_id) winner per session supplies the plan\n8|// lease_record_id digest with its epoch, lease ID, and holder. Envelope\n9|// triples observed on event chains never substitute for these records:\n10|// a session with no admitted winning record refuses\n11|// selector_observation_unavailable, and malformed bytes refuse\n12|// invalid_config.\n13|package sessquery\n14|\n15|import (\n16|\t\"encoding/json\"\n17|\t\"fmt\"\n18|\n19|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n20|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n21|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n22|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n23|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n24|)\n25|\n26|const leaseRecordSchema = \"urn:ax:schema:lease\"\n27|\n28|// validatedLease is one admitted Lease Record: its canonical digest and\n29|// the members the selector binds.\n30|type validatedLease struct {\n31|\tDigest         string\n32|\tSessionID      string\n33|\tLeaseID        string\n34|\tEpoch          uint64\n35|\tHolderHostID   string\n36|\tPredecessor    string\n37|\tHasPredecessor bool\n38|\tCheckpoint     string\n39|\tHasCheckpoint  bool\n40|\tRaw            []byte\n41|}\n42|\n43|// checkpointRecordSchema is the exact Checkpoint Record schema the\n44|// winning-lease checkpoint gate admits.\n45|const checkpointRecordSchema = \"urn:ax:schema:checkpoint\"\n46|\n47|// validatedCheckpoint is the parsed canonical Checkpoint Record shape,\n48|// not yet an admitted authority capability: it carries the digest with\n49|// the session and lease it was taken under, plus the host that created\n50|// it. Section 5.4 binds lease_epoch/lease_id to the\n51|// referenced winning lease, so a successor's checkpoint names its\n52|// predecessor lease, and binds created_by_host_id to the current\n53|// lease holder: the holder of the lease the checkpoint names. The\n54|// persistence presence members carry which variant the record uses;\n55|// the referenced Session Record selects which variant is valid\n56|// (checkCheckpointPersistence), because canonical shape alone admits\n57|// either variant. EventHeads carries the authoritative event DAG\n58|// heads immediately before the checkpoint object; every required\n59|// checkpoint must resolve each head to a chained event for its\n60|// session at or before its bound lease\n61|// (checkCheckpointEventHeads), because a canonical checkpoint\n62|// naming an absent event or an event under a later lease cannot\n63|// establish Section 5.3/14.7.2 current complete authority. The same\n64|// closure must then admit the Section 2.4 profile authority\n65|// (checkCheckpointProfileAuthority), because a canonical checkpoint\n66|// over a corrupt profile history cannot fix the effective profile.\n67|type validatedCheckpoint struct {\n68|\tDigest              string\n69|\tSessionID           string\n70|\tLeaseEpoch          uint64\n71|\tLeaseID             string\n72|\tCreatorHostID       string\n73|\tHasProviderManifest bool\n74|\tHasTaskBoardBundle  bool\n75|\tEventHeads          []string\n76|\tRaw                 []byte\n77|}\n78|\n79|// checkpointSealToken is deliberately unexported and is created only by the\n80|// free admitCheckpoint constructor. The type-level census protects that\n81|// construction boundary across every production source file; the token then\n82|// makes a zero or field-assembled admittedCheckpoint unusable at runtime.\n83|type checkpointSealToken struct{}\n84|\n85|// checkpointSeal holds the facts that profile derivation may consume after\n86|// semantic admission. Its fields are private so callers cannot treat the\n87|// admitted representation as a public record-shaped DTO.\n88|type checkpointSeal struct {\n89|\ttoken               *checkpointSealToken\n90|\tdigest              string\n91|\tsessionID           string\n92|\tleaseEpoch          uint64\n93|\tleaseID             string\n94|\tcreatorHostID       string\n95|\thasProviderManifest bool\n96|\thasTaskBoardBundle  bool\n97|\teventHeads          []string\n98|}\n99|\n100|// admittedCheckpoint is the only checkpoint representation that profile\n101|// derivation may consume. A validatedCheckpoint is still a loader/admission\n102|// concern: canonical parsing alone does not establish its session, lease,\n103|// holder, persistence, event-head, or temporal authority. The unexported seal\n104|// is the capability; without its constructor-only token the value is not\n105|// admitted, even when a caller assembles the outer struct manually.\n106|type admittedCheckpoint struct {\n107|\tseal *checkpointSeal\n108|}\n109|\n110|func (checkpoint admittedCheckpoint) authority() (*checkpointSeal, error) {\n111|\tif checkpoint.seal == nil || checkpoint.seal.token == nil {\n112|\t\treturn nil, fmt.Errorf(\"%w: checkpoint authority seal is missing\", ErrObservationUnavailable)\n113|\t}\n114|\treturn checkpoint.seal, nil\n115|}\n116|\n117|// checkpointAdmission is the narrow capability handed to profile derivation\n118|// for a session.resumed reference. The derivation path can request a named\n119|// checkpoint, but it cannot obtain or consume a raw validated record.\n120|type checkpointAdmission func(checkpointID, sessionID string, summary sessrepo.EventSummary) (admittedCheckpoint, error)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
