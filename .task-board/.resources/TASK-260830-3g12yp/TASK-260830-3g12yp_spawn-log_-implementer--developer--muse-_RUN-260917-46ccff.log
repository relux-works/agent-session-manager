{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb91","stream":{"kind":"session","id":"01a0adcf-af6f-7db0-8726-470499e8596b"},"sequence":1059,"recorded_at":1780531400002113,"record_type":"event","durability":"durable","causation_id":"3b578cbb-cd1c-4970-859d-8c242cd48356","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3b578cbb-cd1c-4970-859d-8c242cd48356","run_stream":{"kind":"run","id":"3b578cbb-cd1c-4970-859d-8c242cd48356"},"task_stream":{"kind":"task","id":"01a0add2-6b0c-75a0-a71e-04aaaec4bd3b"},"task_id":"01a0add2-6b0c-75a0-a71e-04aaaec4bd3b","event":{"kind":"output","task_id":"01a0add2-6b0c-75a0-a71e-04aaaec4bd3b","chunk":"{\n  \"chunk_id\": \"exec-35-1\",\n  \"command\": \"sed -n '120,240p' .github/workflows/ci.yml\",\n  \"description\": \"Read rest of CI\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"      # nothing is a failure, not a pass.\\n      - name: Test\\n        run: |\\n          set +e\\n          go test ./... -v -count=1 > test.log 2>&1\\n          code=$?\\n          set -e\\n          cat test.log\\n          test $code -eq 0\\n          test \\\"$(grep -c '^ok' test.log)\\\" -gt 0\\n          test \\\"$(grep -c '^FAIL' test.log || true)\\\" -eq 0\\n          {\\n            echo \\\"## Suite skips\\\"\\n            echo \\\"\\\"\\n            echo \\\"Skipped: $(grep -c '^--- SKIP' test.log || true)\\\"\\n            grep '^--- SKIP' test.log || echo \\\"none\\\"\\n          } >> \\\"$GITHUB_STEP_SUMMARY\\\"\\n\\n  race:\\n    name: Race detector\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 15\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      - name: Test with race detector\\n        run: |\\n          set +e\\n          go test -race ./... -count=1 > race.log 2>&1\\n          code=$?\\n          set -e\\n          cat race.log\\n          test $code -eq 0\\n          test \\\"$(grep -c '^ok' race.log)\\\" -gt 0\\n\\n  coverage:\\n    name: Coverage numbers (reported, no floor)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 15\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      # Coverage is a number, not a gate: this job reports per-package\\n      # percentages and refuses only an unreadable or empty result.\\n      - name: Test with coverage\\n        run: |\\n          set +e\\n          go test ./... -cover -count=1 > cover.log 2>&1\\n          code=$?\\n          set -e\\n          cat cover.log\\n          test $code -eq 0\\n          test \\\"$(grep -c 'coverage: ' cover.log)\\\" -gt 0\\n          {\\n            echo \\\"## Coverage\\\"\\n            echo \\\"\\\"\\n            echo \\\"| Package | Coverage |\\\"\\n            echo \\\"| --- | --- |\\\"\\n            grep 'coverage: ' cover.log | sed -E 's/^(ok|---)[[:space:]]+([^[:space:]]+).*coverage: ([0-9.]+% of statements)/| `\\\\2` | \\\\3 |/' || true\\n            echo \\\"\\\"\\n            echo \\\"Packages without test files (stated bounds, not failures):\\\"\\n            echo \\\"\\\"\\n            grep 'no test files' cover.log || echo \\\"none\\\"\\n          } >> \\\"$GITHUB_STEP_SUMMARY\\\"\\n\\n  fixture-matrix:\\n    name: Conformance fixtures (${{ matrix.os }}, ${{ matrix.package }})\\n    runs-on: ${{ matrix.os }}\\n    timeout-minutes: 15\\n    strategy:\\n      fail-fast: false\\n      matrix:\\n        os: [ubuntu-latest, macos-latest]\\n        package: [internal/secprim, internal/secconftest]\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      # Verbose on purpose: the --- SKIP lines are the skip datum, and the\\n      # secconftest capabilities line witnesses the probe counters after the\\n      # whole suite. Skips are loud here by construction.\\n      - name: Run fixture package\\n        run: |\\n          set +e\\n          go test ./${{ matrix.package }} -count=1 -v > fixture.log 2>&1\\n          code=$?\\n          set -e\\n          grep '^--- SKIP' fixture.log || echo \\\"no skipped tests\\\"\\n          grep 'secconftest capabilities on' fixture.log || true\\n          {\\n            echo \\\"## Fixture run ${{ matrix.os }} ${{ matrix.package }}\\\"\\n            echo \\\"\\\"\\n            echo \\\"Skipped: $(grep -c '^--- SKIP' fixture.log || true)\\\"\\n          } >> \\\"$GITHUB_STEP_SUMMARY\\\"\\n          test $code -eq 0\\n          test \\\"$(grep -c '^--- PASS' fixture.log)\\\" -gt 0\\n\\n  fuzz-smoke:\\n    name: Fuzz smoke (derived targets)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 15\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\",\n  \"original_output_bytes\": 3783,\n  \"original_output_tokens\": 946,\n  \"truncated\": false\n}","final_result":true}}}
