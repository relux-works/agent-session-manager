{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6ab","stream":{"kind":"session","id":"01a0ae0f-ee07-7b81-b4d4-cf94ccb5debd"},"sequence":432,"recorded_at":1780531400000859,"record_type":"event","durability":"durable","causation_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","run_stream":{"kind":"run","id":"b7392d99-bbd5-4114-ba32-61509405cfc4"},"task_stream":{"kind":"task","id":"01a0ae10-a900-7623-aa1a-ca79b6e877fd"},"task_id":"01a0ae10-a900-7623-aa1a-ca79b6e877fd","event":{"kind":"output","task_id":"01a0ae10-a900-7623-aa1a-ca79b6e877fd","chunk":"Read text file `internal/fencing/gate_test.go`.\n1|package fencing\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"testing\"\n6|\t\"time\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n9|)\n10|\n11|// TestAuthorizeAdmitsWinnerExactEpochAllOperations drives the positive\n12|// row of every gate: the winning lease with the exact epoch mints a\n13|// sealed token through each of the five production entries, and the\n14|// token binds the exact triple to quiesce, capture, and materialize.\n15|func TestAuthorizeAdmitsWinnerExactEpochAllOperations(t *testing.T) {\n16|\tfor name, entry := range fenceEntries() {\n17|\t\tt.Run(name, func(t *testing.T) {\n18|\t\t\ttoken, err := entry.authorize(fencePresented(), fenceObservation())\n19|\t\t\tmustMint(t, token, err, name)\n20|\t\t})\n21|\t}\n22|}\n23|\n24|// TestAuthorizeRefusesUnknownOperation proves the operation enum is\n25|// closed: an action outside the five gated entries refuses\n26|// invalid_arguments instead of authorizing.\n27|func TestAuthorizeRefusesUnknownOperation(t *testing.T) {\n28|\t_, err := Authorize(\"bogus\", fencePresented(), fenceObservation())\n29|\tmustRefuse(t, err, ErrInvalidArguments, \"Authorize(bogus)\")\n30|}\n31|\n32|// TestAuthorizeRefusesMalformedPresented drives every malformed\n33|// presented-token vector through a launch and a non-launch entry:\n34|// malformed claims refuse invalid_arguments on both, never a fencing\n35|// class and never a park. The epoch-zero vectors pair the winner\n36|// lease (which the epoch gate would stale-report past the grammar)\n37|// with a malformed lease (which refuses at grammar under mutants).\n38|func TestAuthorizeRefusesMalformedPresented(t *testing.T) {\n39|\tvectors := map[string]PresentedToken{\n40|\t\t\"session_not_uuid\": {SessionID: \"not-a-uuid\", Epoch: 2, LeaseID: fenceLeaseA},\n41|\t\t\"session_empty\":    {SessionID: \"\", Epoch: 2, LeaseID: fenceLeaseA},\n42|\t\t\"epoch_zero\":       {SessionID: fenceSessionA, Epoch: 0, LeaseID: fenceLeaseA},\n43|\t\t\"epoch_zero_lease\": {SessionID: fenceSessionA, Epoch: 0, LeaseID: \"zzz\"},\n44|\t\t\"lease_not_uuid\":   {SessionID: fenceSessionA, Epoch: 2, LeaseID: \"zzz\"},\n45|\t\t\"lease_empty\":      {SessionID: fenceSessionA, Epoch: 2, LeaseID: \"\"},\n46|\t}\n47|\tfor name, entry := range fenceEntries() {\n48|\t\tfor vector, presented := range vectors {\n49|\t\t\tt.Run(name+\"/\"+vector, func(t *testing.T) {\n50|\t\t\t\t_, err := entry.authorize(presented, fenceObservation())\n51|\t\t\t\tmustRefuse(t, err, ErrInvalidArguments, name+\"/\"+vector)\n52|\t\t\t})\n53|\t\t}\n54|\t}\n55|}\n56|\n57|// TestAuthorizeRefusesGarbageWinner proves the winner is not trusted\n58|// past its grammar: a caller-built observation with a malformed\n59|// winning summary refuses invalid_arguments instead of authorizing\n60|// against garbage.\n61|func TestAuthorizeRefusesGarbageWinner(t *testing.T) {\n62|\tvectors := map[string]sessrepo.LeaseSummary{\n63|\t\t// The narrowing vector the winner mutant admits past the arm.\n64|\t\t\"epoch_zero_lease\": {SessionID: fenceSessionA, LeaseID: \"zzz\", Epoch: 0, HolderHostID: fenceHostA},\n65|\t\t// A second garbage shape that still refuses under the mutant.\n66|\t\t\"holder_malformed\": {SessionID: fenceSessionA, LeaseID: fenceLeaseA, Epoch: 2, HolderHostID: \"zzz\"},\n67|\t}\n68|\tfor name, entry := range fenceEntries() {\n69|\t\tfor vector, winner := range vectors {\n70|\t\t\tt.Run(name+\"/\"+vector, func(t *testing.T) {\n71|\t\t\t\tobservation := fenceObservation()\n72|\t\t\t\tobservation.Winner = winner\n73|\t\t\t\t_, err := entry.authorize(fencePresented(), observation)\n74|\t\t\t\tmustRefuse(t, err, ErrInvalidArguments, name+\"/\"+vector)\n75|\t\t\t})\n76|\t\t}\n77|\t}\n78|}\n79|\n80|// TestAuthorizeRefusesForeignSession drives the foreign-session row:\n81|// a token minted for another session never authorizes here. The B\n82|// session shares the first UUID segment with A (the vector the\n83|// prefix mutant admits); the C session shares nothing.\n84|func TestAuthorizeRefusesForeignSession(t *testing.T) {\n85|\tvectors := map[string]string{\n86|\t\t\"prefix_sharing\": fenceSessionB,\n87|\t\t\"fully_foreign\":  fenceSessionC,\n88|\t}\n89|\tfor name, entry := range fenceEntries() {\n90|\t\tfor vector, session := range vectors {\n91|\t\t\tt.Run(name+\"/\"+vector, func(t *testing.T) {\n92|\t\t\t\tpresented := fencePresented()\n93|\t\t\t\tpresented.SessionID = session\n94|\t\t\t\t_, err := entry.authorize(presented, fenceObservation())\n95|\t\t\t\tmustRefuse(t, err, ErrLeaseConflict, name+\"/\"+vector)\n96|\t\t\t})\n97|\t\t}\n98|\t}\n99|}\n100|\n101|// TestAuthorizeParksAndRefusesAbsentWinner drives the absent-lease\n102|// row: with no winning lease established, launch entries park with\n103|// restore_policy and an empty winning lease ID, while input,\n104|// mutation, and checkpoint refuse lease_conflict.\n105|func TestAuthorizeParksAndRefusesAbsentWinner(t *testing.T) {\n106|\tvectors := map[string]bool{\"verified\": true, \"unverified\": false}\n107|\tfor name, entry := range fenceEntries() {\n108|\t\tfor vector, verified := range vectors {\n109|\t\t\tt.Run(name+\"/\"+vector, func(t *testing.T) {\n110|\t\t\t\tobservation := fenceObservation()\n111|\t\t\t\tobservation.HasWinner = false\n112|\t\t\t\tobservation.Winner = sessrepo.LeaseSummary{}\n113|\t\t\t\tobservation.Verified = verified\n114|\t\t\t\t_, err := entry.authorize(fencePresented(), observation)\n115|\t\t\t\tif entry.launch {\n116|\t\t\t\t\tmustPark(t, err, ParkRestorePolicy, \"\", ErrLeaseConflict, name+\"/\"+vector)\n117|\t\t\t\t} else {\n118|\t\t\t\t\tmustRefuse(t, err, ErrLeaseConflict, name+\"/\"+vector)\n119|\t\t\t\t}\n120|\t\t\t})\n(more lines below)","final_result":true}}}
