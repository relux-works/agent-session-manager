{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cf15","stream":{"kind":"session","id":"01a0ae0f-ee07-7b81-b4d4-cf94ccb5debd"},"sequence":1509,"recorded_at":1780531400003013,"record_type":"event","durability":"durable","causation_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","run_stream":{"kind":"run","id":"b7392d99-bbd5-4114-ba32-61509405cfc4"},"task_stream":{"kind":"task","id":"01a0ae24-d0f9-7900-8cde-2ef7a3700351"},"task_id":"01a0ae24-d0f9-7900-8cde-2ef7a3700351","event":{"kind":"output","task_id":"01a0ae24-d0f9-7900-8cde-2ef7a3700351","chunk":"{\n  \"chunk_id\": \"exec-48-1\",\n  \"command\": \"sed -n '3495,3560p' internal/traceability/ownership.v0.6.0.json; echo =====; sed -n '4415,4480p' internal/traceability/ownership.v0.6.0.json\",\n  \"description\": \"Read 5.3 and 2.2 registry entries\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"      \\\"coverage\\\": \\\"unevidenced\\\",\\n      \\\"gap\\\": \\\"validateSessionEvent validates the Section 5.2 Session Event shape; the event authorship, ordering and epoch behaviour Section 5.2 requires is not implemented and no clause of Section 5.2 is enumerated.\\\"\\n    },\\n    {\\n      \\\"kind\\\": \\\"section_binding\\\",\\n      \\\"keys\\\": [\\n        \\\"section:5.3\\\"\\n      ],\\n      \\\"production\\\": {\\n        \\\"path\\\": \\\"internal/sessrepo/lease_store.go\\\",\\n        \\\"declaration\\\": \\\"CompareAndSwapLease\\\"\\n      },\\n      \\\"acceptance_cases\\\": [\\n        \\\"lease-record-lifecycle\\\",\\n        \\\"lease-fencing-revalidation\\\",\\n        \\\"lease-checkpoint-admission\\\",\\n        \\\"lease-divergent-preservation\\\",\\n        \\\"lease-union-resolution\\\",\\n        \\\"lease-fencing-gates\\\",\\n        \\\"core-record-identity-validation\\\"\\n      ],\\n      \\\"coverage\\\": \\\"partial\\\",\\n      \\\"gap\\\": \\\"CompareAndSwapLease with the fencing gates discharges 7 of the 8 Section 5.3 clauses; clause 5.3#5 (every new takeover lease MUST use max_observed_epoch + 1 from the initiator's union) stays unimplemented because the union maximum is caller-side input and no takeover flow exists in this repository yet.\\\",\\n      \\\"clauses\\\": [\\n        {\\n          \\\"id\\\": \\\"5.3#1\\\",\\n          \\\"line\\\": 1927,\\n          \\\"excerpt\\\": \\\"| <code>created_by_host_id</code> | UUIDv7 | MUST equal <code>issued_by_host_id</code> |\\\",\\n          \\\"acceptance_cases\\\": [\\n            \\\"core-record-identity-validation\\\"\\n          ]\\n        },\\n        {\\n          \\\"id\\\": \\\"5.3#2\\\",\\n          \\\"line\\\": 1957,\\n          \\\"excerpt\\\": \\\"tie-break. A valid epoch greater than 1 MUST name a known predecessor for the\\\",\\n          \\\"acceptance_cases\\\": [\\n            \\\"lease-record-lifecycle\\\",\\n            \\\"lease-checkpoint-admission\\\"\\n          ]\\n        },\\n        {\\n          \\\"id\\\": \\\"5.3#3\\\",\\n          \\\"line\\\": 1958,\\n          \\\"excerpt\\\": \\\"same session, MUST equal that predecessor's epoch plus one, and MUST reference\\\",\\n          \\\"acceptance_cases\\\": [\\n            \\\"lease-record-lifecycle\\\",\\n            \\\"lease-checkpoint-admission\\\"\\n          ]\\n        },\\n        {\\n          \\\"id\\\": \\\"5.3#4\\\",\\n          \\\"line\\\": 1960,\\n          \\\"excerpt\\\": \\\"<code>create</code> lease MUST have a null predecessor and MAY have a null\\\",\\n          \\\"acceptance_cases\\\": [\\n            \\\"lease-record-lifecycle\\\"\\n          ]\\n        },\\n        {\\n          \\\"id\\\": \\\"5.3#6\\\",\\n          \\\"line\\\": 1967,\\n          \\\"excerpt\\\": \\\"lease wins. Events under the losing same-epoch lease and all lower epochs MUST\\\",\\n          \\\"acceptance_cases\\\": [\\n            \\\"lease-divergent-preservation\\\",\\n            \\\"lease-union-resolution\\\"\\n          ]\\n=====\\n        \\\"cli-result-envelope-exact\\\"\\n      ],\\n      \\\"coverage\\\": \\\"unevidenced\\\",\\n      \\\"gap\\\": \\\"Emit formats historical CLI result envelopes only; the Section 14.7 literal first-at source-qualified selector resolution and the CLI Result 5.0.0 envelope are unimplemented. Pending implementation owner: TASK-260830-21gygk.\\\"\\n    },\\n    {\\n      \\\"kind\\\": \\\"section_binding\\\",\\n      \\\"keys\\\": [\\n        \\\"section:2.2\\\"\\n      ],\\n      \\\"production\\\": {\\n        \\\"path\\\": \\\"internal/fencing/gate.go\\\",\\n        \\\"declaration\\\": \\\"Authorize\\\"\\n      },\\n      \\\"acceptance_cases\\\": [\\n        \\\"lease-fencing-gates\\\",\\n        \\\"lease-fencing-park\\\",\\n        \\\"lease-divergent-preservation\\\",\\n        \\\"lease-union-resolution\\\"\\n      ],\\n      \\\"coverage\\\": \\\"sliver\\\",\\n      \\\"gap\\\": \\\"Authorize with the lease store discharges 4 of the 22 Section 2.2 clauses (one winning owner, replica restraint, winning-epoch carriage, losing-event rejection); clauses 2.2#5 through 2.2#22 stay unimplemented here: the replication, secret, SQLite, materialization, tombstone, profile, capability, bridge, sync, continuation, readiness, and exclusion invariants plus the directory-merge preamble have no implementation in this ownership story.\\\",\\n      \\\"clauses\\\": [\\n        {\\n          \\\"id\\\": \\\"2.2#1\\\",\\n          \\\"line\\\": 408,\\n          \\\"excerpt\\\": \\\"1. Every non-tombstoned logical session MUST have exactly one winning lease and\\\",\\n          \\\"acceptance_cases\\\": [\\n            \\\"lease-fencing-gates\\\"\\n          ]\\n        },\\n        {\\n          \\\"id\\\": \\\"2.2#2\\\",\\n          \\\"line\\\": 410,\\n          \\\"excerpt\\\": \\\"2. A replica MUST NOT launch, resume, accept input for, or publish authoritative\\\",\\n          \\\"acceptance_cases\\\": [\\n            \\\"lease-fencing-gates\\\",\\n            \\\"lease-fencing-park\\\"\\n          ]\\n        },\\n        {\\n          \\\"id\\\": \\\"2.2#3\\\",\\n          \\\"line\\\": 412,\\n          \\\"excerpt\\\": \\\"3. Every owner-authored event MUST carry the winning lease epoch and lease ID.\\\",\\n          \\\"acceptance_cases\\\": [\\n            \\\"lease-fencing-gates\\\"\\n          ]\\n        },\\n        {\\n          \\\"id\\\": \\\"2.2#4\\\",\\n          \\\"line\\\": 413,\\n          \\\"excerpt\\\": \\\"A peer MUST reject lower-epoch or losing same-epoch events from the\\\",\\n          \\\"acceptance_cases\\\": [\\n            \\\"lease-divergent-preservation\\\",\\n            \\\"lease-union-resolution\\\"\\n          ]\\n        }\\n      ]\\n    }\\n  ],\\n  \\\"unowned_sections\\\": [\\n    {\\n      \\\"key\\\": \\\"section:18.4\\\",\\n      \\\"gap\\\": \\\"Section 18.4 requires audit retention - the exact Section 5.2 event types for lease change, force confirmation, managed replacement, task-board launch and adoption and tombstone issuance and resolution, and retention of the event and every referenced immutable object for as long as the Session Record. No retention, expiry or garbage-collection rule is implemented.\\\",\\n      \\\"evidence\\\": \\\"internal/localstore/projection.go opens, rebuilds and recovers the SQLite projection and installs immutable blobs; it declares no retention, expiry or garbage-collection behaviour, and the binding this entry replaces named OpenProjection with the same two storage acceptance cases already used by the Section 3.3 binding.\\\"\\n    },\\n\",\n  \"original_output_bytes\": 5622,\n  \"original_output_tokens\": 1406,\n  \"truncated\": false\n}","final_result":true}}}
