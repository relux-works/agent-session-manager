{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c59d","stream":{"kind":"session","id":"01a0ae0f-ee07-7b81-b4d4-cf94ccb5debd"},"sequence":297,"recorded_at":1780531400000589,"record_type":"event","durability":"durable","causation_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","run_stream":{"kind":"run","id":"b7392d99-bbd5-4114-ba32-61509405cfc4"},"task_stream":{"kind":"task","id":"01a0ae10-6f2a-7ba0-aced-3b2129f8958f"},"task_id":"01a0ae10-6f2a-7ba0-aced-3b2129f8958f","event":{"kind":"output","task_id":"01a0ae10-6f2a-7ba0-aced-3b2129f8958f","chunk":"Read text file `internal/fencing/gate.go`.\n1|package fencing\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|\t\"time\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n10|)\n11|\n12|var (\n13|\t// ErrLeaseConflict is the Section 15 lease_conflict refusal at exit\n14|\t// 10: the presented fencing proof is not the winning authority for\n15|\t// this session (same-epoch loser, epoch beyond the winner, foreign\n16|\t// session, lapsed grant, or absent/ambiguous/unverified ownership on\n17|\t// a non-launch entry), or a forged capability reached a consumer.\n18|\tErrLeaseConflict = errors.New(\"lease_conflict\")\n19|\t// ErrNotOwner is the Section 15 not_owner refusal at exit 10: the\n20|\t// winning lease holder is a remote host and this entry is not a\n21|\t// launch, so there is no parked direction to take.\n22|\tErrNotOwner = errors.New(\"not_owner\")\n23|\t// ErrStaleOwner is the Section 15 stale_owner refusal at exit 10:\n24|\t// the presented epoch precedes the winning epoch on a non-launch\n25|\t// entry. Launch entries park with the stale_owner reason instead.\n26|\tErrStaleOwner = errors.New(\"stale_owner\")\n27|\t// ErrParked marks a park decision: the launch is refused and the\n28|\t// session must park carrying the session.parked reason and winning\n29|\t// lease ID. It always wraps the underlying Section 15 cause as\n30|\t// well, so errors.Is reports both the decision and the class.\n31|\tErrParked = errors.New(\"parked\")\n32|\t// ErrInvalidArguments is the Section 15 invalid_arguments refusal\n33|\t// at exit 2: the gate call itself is malformed (unknown operation,\n34|\t// malformed presented token or winning summary, missing grant,\n35|\t// missing clock reading, unusable policy, or unknown provider\n36|\t// operation). The caller fixes the call, not the ownership.\n37|\tErrInvalidArguments = errors.New(\"invalid_arguments\")\n38|\t// ErrLocalPreconditionFailed is the Section 15\n39|\t// local_precondition_failed refusal at exit 3, the class the\n40|\t// Section 4.C terminate-stale row names: terminate-stale without\n41|\t// explicit force recovery, without preserved diagnostics, without\n42|\t// an established winner, or against the live winning owner.\n43|\tErrLocalPreconditionFailed = errors.New(\"local_precondition_failed\")\n44|)\n45|\n46|// refuse is the single refusal funnel every fencing rejection flows\n47|// through. No production path wraps a sentinel with fmt.Errorf directly.\n48|var refuse = func(sentinel error, format string, arguments ...any) error {\n49|\treturn fmt.Errorf(\"%w: %s\", sentinel, fmt.Sprintf(format, arguments...))\n50|}\n51|\n52|// ParkReason is one Section 5.2 session.parked reason: the exact\n53|// vocabulary a park decision carries.\n54|type ParkReason string\n55|\n56|const (\n57|\t// ParkRemoteOwner parks because the winning lease holder is remote.\n58|\tParkRemoteOwner ParkReason = \"remote_owner\"\n59|\t// ParkStaleOwner parks because the local fencing proof loses to the\n60|\t// winning lease while the winner is local (a stale cache).\n61|\tParkStaleOwner ParkReason = \"stale_owner\"\n62|\t// ParkRestorePolicy parks because ownership cannot be verified:\n63|\t// no winning lease, unverified sync, ambiguous observations, or a\n64|\t// token from an epoch beyond the winner.\n65|\tParkRestorePolicy ParkReason = \"restore_policy\"\n66|\t// ParkFailedHandoff parks because the caller's handoff already\n67|\t// failed: a losing force lease must never activate.\n68|\tParkFailedHandoff ParkReason = \"failed_handoff\"\n69|)\n70|\n71|// parkRefusal carries a park decision: the session.parked reason, the\n72|// winning lease ID the parked event repeats (empty when no winner is\n73|// established), and the underlying Section 15 cause. It unwraps to both\n74|// ErrParked and the cause.\n75|type parkRefusal struct {\n76|\treason         ParkReason\n77|\twinningLeaseID string\n78|\tcause          error\n79|}\n80|\n81|func (refusal *parkRefusal) Error() string {\n82|\tif refusal.winningLeaseID == \"\" {\n83|\t\treturn fmt.Sprintf(\"%s: park (%s); no winning lease is established\", ErrParked, refusal.reason)\n84|\t}\n85|\treturn fmt.Sprintf(\"%s: park (%s) under winning lease %s: %v\", ErrParked, refusal.reason, refusal.winningLeaseID, refusal.cause)\n86|}\n87|\n88|func (refusal *parkRefusal) Unwrap() []error {\n89|\treturn []error{ErrParked, refusal.cause}\n90|}\n91|\n92|// IsParked reports whether err is a park decision rather than a hard\n93|// refusal. A parked launch must emit the session.parked vocabulary,\n94|// never start a runtime.\n95|func IsParked(err error) bool {\n96|\treturn errors.Is(err, ErrParked)\n97|}\n98|\n99|// ParkDetails extracts the session.parked vocabulary from a park\n100|// decision: the reason and the winning lease ID (empty when no winner\n101|// is established). It reports false for a hard refusal.\n102|func ParkDetails(err error) (ParkReason, string, bool) {\n103|\tvar parked *parkRefusal\n104|\tif !errors.As(err, &parked) {\n105|\t\treturn \"\", \"\", false\n106|\t}\n107|\treturn parked.reason, parked.winningLeaseID, true\n108|}\n109|\n110|// park builds the launch-class refusal for one ownership condition: the\n111|// parked reason with the Section 15 cause the same condition refuses\n112|// on a non-launch entry.\n113|func park(reason ParkReason, winningLeaseID string, cause error) error {\n114|\treturn &parkRefusal{reason: reason, winningLeaseID: winningLeaseID, cause: cause}\n115|}\n116|\n117|// Operation is one activation-class action the gate authorizes.\n118|type Operation string\n119|\n120|const (\n121|\t// OperationActivation gates provider activation and launch: only\n122|\t// the winning committed lease may create a destination runtime.\n123|\tOperationActivation Operation = \"activation\"\n124|\t// OperationInput gates provider input after attach (the\n125|\t// quiesce-input and attach direction): the owner revalidates\n126|\t// before accepting operator input.\n127|\tOperationInput Operation = \"input\"\n128|\t// OperationMutation gates owner-authored mutation: event append\n129|\t// and compare-and-swap succession carry the winning epoch.\n130|\tOperationMutation Operation = \"mutation\"\n131|\t// OperationCheckpoint gates checkpoint capture admission: a fresh\n132|\t// checkpoint is published under the current lease only.\n133|\tOperationCheckpoint Operation = \"checkpoint\"\n134|\t// OperationRestore gates terminal restore and the wrapper's first\n135|\t// start: ownership is compared before any provider resume.\n136|\tOperationRestore Operation = \"restore\"\n137|)\n138|\n139|// validOperation reports whether op names a gated action. Anything\n140|// else is a malformed gate call, never an authorized action.\n141|func validOperation(op Operation) bool {\n142|\tswitch op {\n143|\tcase OperationActivation, OperationInput, OperationMutation, OperationCheckpoint, OperationRestore:\n144|\t\treturn true\n145|\t}\n146|\treturn false\n147|}\n148|\n149|// launchClass reports whether op is a launch-class entry: activation\n150|// and restore park when ownership is remote, ambiguous, unverified,\n151|// or absent, while input, mutation, and checkpoint refuse outright.\n152|func launchClass(op Operation) bool {\n153|\treturn op == OperationActivation || op == OperationRestore\n154|}\n155|\n156|// PresentedToken is the caller's claimed fencing authority: the local\n157|// fencing token the wrapper compares, or the token a takeover, input,\n158|// mutation, or checkpoint caller holds. It is untrusted input: every\n159|// member is grammar-checked before any comparison runs.\n160|type PresentedToken struct {\n161|\tSessionID string\n162|\tEpoch     uint64\n163|\tLeaseID   string\n164|}\n165|\n166|// Observation carries the verified durable and sync facts the gate\n167|// decides over. Observe builds it from the repository; callers that\n168|// build it by hand (tests, modeled flows) must supply the same facts.\n169|// The winner is trusted only through its grammar: a malformed winning\n170|// summary refuses rather than authorizing against garbage.\n171|type Observation struct {\n172|\tSessionID string\n173|\t// Winner is the winning lease summary with its holder. It is\n174|\t// meaningful only when HasWinner is set.\n175|\tWinner    sessrepo.LeaseSummary\n176|\tHasWinner bool\n177|\t// LocalHostID is the host asking for authorization. An unknown or\n178|\t// empty local identity never equals the winning holder, so it\n179|\t// fails closed to the remote arm without a grammar check.\n180|\tLocalHostID string\n181|\t// Verified reports that a mesh lease refresh proved current\n182|\t// lease knowledge. Unverified ownership parks or refuses.\n183|\tVerified bool\n184|\t// Ambiguous reports conflicting ownership observations (a union\n185|\t// rival the local store cannot order). Ambiguity parks or refuses.\n186|\tAmbiguous bool\n187|\t// HandoffFailed reports that the caller's own handoff already\n188|\t// failed (a losing force lease before activation). A failed\n189|\t// handoff parks with failed_handoff instead of activating.\n190|\tHandoffFailed bool\n191|\t// Grant is the process-local authorization derived from a winning\n192|\t// lease, meaningful only when HasGrant is set. The gate re-checks\n193|\t// its expiry through the sessrepo owner on every call.\n194|\tGrant    sessrepo.FencingGrant\n195|\tHasGrant bool\n196|\t// Policy carries the configured lease refresh interval the\n197|\t// expiry arm enforces.\n198|\tPolicy sessrepo.FencingPolicy\n199|\t// Now is the caller's clock reading for the expiry arm. A grant\n200|\t// without a clock reading refuses rather than bypassing expiry.\n201|\tNow time.Time\n202|}\n203|\n204|// ObserveInput carries the caller-reported facts Observe combines with\n205|// the durable winning lease: sync state, handoff outcome, the\n206|// process-local fencing grant with its policy, and the clock reading.\n207|type ObserveInput struct {\n208|\tLocalHostID   string\n209|\tVerified      bool\n210|\tAmbiguous     bool\n211|\tHandoffFailed bool\n212|\tGrant         sessrepo.FencingGrant\n213|\tHasGrant      bool\n214|\tPolicy        sessrepo.FencingPolicy\n215|\tNow           time.Time\n216|}\n217|\n218|// Observe loads the winning lease for sessionID and combines it with\n219|// the caller's sync, handoff, grant, and clock facts into the\n220|// Observation Authorize decides over. The winner is the last summary\n221|// of the tuple-ordered ListLeases read, the same derivation\n222|// WinningLease returns, so no second winner rule exists here. A\n223|// session with no leases yet yields HasWinner false without an error:\n224|// absence is data the gate parks or refuses on. A repository failure\n225|// (including an unknown session) propagates unchanged.\n226|func Observe(repository *sessrepo.Repository, sessionID string, input ObserveInput) (Observation, error) {\n227|\tleases, err := repository.ListLeases(sessionID)\n228|\tif err != nil {\n229|\t\treturn Observation{}, err\n230|\t}\n231|\tobservation := Observation{\n232|\t\tSessionID:     sessionID,\n233|\t\tLocalHostID:   input.LocalHostID,\n234|\t\tVerified:      input.Verified,\n235|\t\tAmbiguous:     input.Ambiguous,\n236|\t\tHandoffFailed: input.HandoffFailed,\n237|\t\tGrant:         input.Grant,\n238|\t\tHasGrant:      input.HasGrant,\n239|\t\tPolicy:        input.Policy,\n240|\t\tNow:           input.Now,\n241|\t}\n242|\tif len(leases) > 0 {\n243|\t\tobservation.Winner = leases[len(leases)-1]\n244|\t\tobservation.HasWinner = true\n245|\t}\n246|\treturn observation, nil\n247|}\n248|\n249|// AuthorizeActivation gates provider activation and launch through the\n250|// fencing core.\n251|func AuthorizeActivation(presented PresentedToken, observation Observation) (LeaseToken, error) {\n252|\treturn Authorize(OperationActivation, presented, observation)\n253|}\n254|\n255|// AuthorizeInput gates provider input after attach through the fencing\n256|// core.\n257|func AuthorizeInput(presented PresentedToken, observation Observation) (LeaseToken, error) {\n258|\treturn Authorize(OperationInput, presented, observation)\n259|}\n260|\n261|// AuthorizeMutation gates owner-authored mutation through the fencing\n262|// core.\n263|func AuthorizeMutation(presented PresentedToken, observation Observation) (LeaseToken, error) {\n264|\treturn Authorize(OperationMutation, presented, observation)\n265|}\n266|\n267|// AuthorizeCheckpoint gates checkpoint capture admission through the\n268|// fencing core.\n269|func AuthorizeCheckpoint(presented PresentedToken, observation Observation) (LeaseToken, error) {\n270|\treturn Authorize(OperationCheckpoint, presented, observation)\n271|}\n272|\n273|// AuthorizeRestore gates terminal restore and the wrapper's first\n274|// start through the fencing core.\n275|func AuthorizeRestore(presented PresentedToken, observation Observation) (LeaseToken, error) {\n276|\treturn Authorize(OperationRestore, presented, observation)\n277|}\n278|\n279|// Authorize is the fencing core: every activation-class action passes\n280|// here. The presented token must name this session and equal the\n281|// winning (epoch, lease_id) tuple exactly; the fencing grant must be\n282|// present and unexpired; ownership must be verified, unambiguous, and\n283|// local. Launch-class entries (activation, restore) park with the\n284|// session.parked vocabulary when ownership is remote, ambiguous,\n285|// unverified, or absent; every other entry refuses outright. A passed\n286|// gate mints the sealed LeaseToken the provider operations bind; a\n287|// failed gate refuses with a Section 15 registered code and mints\n288|// nothing.\n289|//\n290|// Arm order is precedence: malformed calls die first, then foreign\n291|// sessions, then ownership presence and verifiability, then the\n292|// fencing grant, then ownership direction (the operative fact beats\n293|// the credential: a stale token under a remote winner parks remote,\n294|// it does not report stale), then the exact tuple match.\n295|func Authorize(operation Operation, presented PresentedToken, observation Observation) (LeaseToken, error) {\n296|\tif !validOperation(operation) {\n297|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"unknown fencing operation %q\", string(operation))\n298|\t}\n299|\tif _, err := scalar.ParseUUIDv7(presented.SessionID); err != nil {\n300|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"presented fencing token session %q is not a UUIDv7: %v\", presented.SessionID, err)\n301|\t}\n302|\tif presented.Epoch == 0 {\n303|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"presented fencing token carries epoch 0, want an epoch at or above 1\")\n304|\t}\n305|\tif _, err := scalar.ParseUUIDv4(presented.LeaseID); err != nil {\n306|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"presented fencing token lease %q is not a UUIDv4: %v\", presented.LeaseID, err)\n307|\t}\n308|\tif presented.SessionID != observation.SessionID {\n309|\t\treturn LeaseToken{}, refuse(ErrLeaseConflict, \"presented fencing token for session %s does not authorize session %s\", presented.SessionID, observation.SessionID)\n310|\t}\n311|\tif !observation.HasWinner {\n312|\t\tif launchClass(operation) {\n313|\t\t\treturn LeaseToken{}, park(ParkRestorePolicy, \"\", ErrLeaseConflict)\n314|\t\t}\n315|\t\treturn LeaseToken{}, refuse(ErrLeaseConflict, \"no winning lease is established for session %s\", observation.SessionID)\n316|\t}\n317|\tif observation.Winner.Epoch == 0 || !validLeaseID(observation.Winner.LeaseID) || !validHostID(observation.Winner.HolderHostID) {\n318|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"fencing observation for session %s carries no well-formed winning lease\", observation.SessionID)\n319|\t}\n320|\tif !observation.Verified {\n321|\t\tif launchClass(operation) {\n322|\t\t\treturn LeaseToken{}, park(ParkRestorePolicy, observation.Winner.LeaseID, ErrLeaseConflict)\n323|\t\t}\n324|\t\treturn LeaseToken{}, refuse(ErrLeaseConflict, \"ownership of session %s is unverified; refresh lease knowledge first\", observation.SessionID)\n325|\t}\n326|\tif observation.Ambiguous {\n327|\t\tif launchClass(operation) {\n328|\t\t\treturn LeaseToken{}, park(ParkRestorePolicy, observation.Winner.LeaseID, ErrLeaseConflict)\n329|\t\t}\n330|\t\treturn LeaseToken{}, refuse(ErrLeaseConflict, \"ownership of session %s is ambiguous; resolve the union rival first\", observation.SessionID)\n331|\t}\n332|\tif observation.HandoffFailed {\n333|\t\tif launchClass(operation) {\n334|\t\t\treturn LeaseToken{}, park(ParkFailedHandoff, observation.Winner.LeaseID, ErrLeaseConflict)\n335|\t\t}\n336|\t\treturn LeaseToken{}, refuse(ErrLeaseConflict, \"handoff for session %s already failed; a losing lease must never activate\", observation.SessionID)\n337|\t}\n338|\tif !observation.HasGrant {\n339|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"fencing observation for session %s carries no grant; validate the winning token first\", observation.SessionID)\n340|\t}\n341|\tif observation.Now.IsZero() {\n342|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"fencing observation for session %s carries no clock reading; expiry cannot be checked\", observation.SessionID)\n343|\t}\n344|\tif err := sessrepo.CheckFencingExpiry(observation.Grant, observation.Policy, observation.Now); err != nil {\n345|\t\tif errors.Is(err, sessrepo.ErrFencingExpired) {\n346|\t\t\treturn LeaseToken{}, refuse(ErrLeaseConflict, \"fencing grant for session %s lapsed; revalidate the winning token\", observation.SessionID)\n347|\t\t}\n348|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"fencing observation for session %s carries an unusable refresh policy\", observation.SessionID)\n349|\t}\n350|\tif observation.Winner.HolderHostID != observation.LocalHostID {\n351|\t\tif launchClass(operation) {\n352|\t\t\treturn LeaseToken{}, park(ParkRemoteOwner, observation.Winner.LeaseID, ErrNotOwner)\n353|\t\t}\n354|\t\treturn LeaseToken{}, refuse(ErrNotOwner, \"session %s is owned by remote host %s\", observation.SessionID, observation.Winner.HolderHostID)\n355|\t}\n356|\tepochsEqual := presented.Epoch == observation.Winner.Epoch\n357|\tif !epochsEqual {\n358|\t\tif presented.Epoch < observation.Winner.Epoch {\n359|\t\t\tif launchClass(operation) {\n360|\t\t\t\treturn LeaseToken{}, park(ParkStaleOwner, observation.Winner.LeaseID, ErrStaleOwner)\n361|\t\t\t}\n362|\t\t\treturn LeaseToken{}, refuse(ErrStaleOwner, \"presented epoch %d precedes winning epoch %d for session %s\", presented.Epoch, observation.Winner.Epoch, observation.SessionID)\n363|\t\t}\n364|\t\tif launchClass(operation) {\n365|\t\t\treturn LeaseToken{}, park(ParkRestorePolicy, observation.Winner.LeaseID, ErrLeaseConflict)\n366|\t\t}\n367|\t\treturn LeaseToken{}, refuse(ErrLeaseConflict, \"presented epoch %d names no known lease for session %s\", presented.Epoch, observation.SessionID)\n368|\t}\n369|\tif presented.LeaseID != observation.Winner.LeaseID {\n370|\t\tif launchClass(operation) {\n371|\t\t\treturn LeaseToken{}, park(ParkStaleOwner, observation.Winner.LeaseID, ErrLeaseConflict)\n372|\t\t}\n373|\t\treturn LeaseToken{}, refuse(ErrLeaseConflict, \"presented lease %s loses to winning lease %s at epoch %d\", presented.LeaseID, observation.Winner.LeaseID, observation.Winner.Epoch)\n374|\t}\n375|\treturn mintLeaseToken(observation.SessionID, observation.Winner.Epoch, observation.Winner.LeaseID), nil\n376|}\n377|\n378|// validLeaseID reports whether id parses as a fencing token UUID. The\n379|// scalar owner holds the grammar; this is only the boolean access the\n380|// combined winner arm needs.\n381|func validLeaseID(id string) bool {\n382|\t_, err := scalar.ParseUUIDv4(id)\n383|\treturn err == nil\n384|}\n385|\n386|// validHostID reports whether id parses as a host UUID. The scalar\n387|// owner holds the grammar; this is only the boolean access the\n388|// combined winner arm needs.\n389|func validHostID(id string) bool {\n390|\t_, err := scalar.ParseUUIDv7(id)\n391|\treturn err == nil\n392|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c59f","stream":{"kind":"session","id":"01a0ae0f-ee07-7b81-b4d4-cf94ccb5debd"},"sequence":298,"recorded_at":1780531400000591,"record_type":"event","durability":"durable","causation_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","run_stream":{"kind":"run","id":"b7392d99-bbd5-4114-ba32-61509405cfc4"},"task_stream":{"kind":"task","id":"01a0ae10-6f2a-7ba0-aced-3b2129f8958f"},"task_id":"01a0ae10-6f2a-7ba0-aced-3b2129f8958f","event":{"kind":"completed","task_id":"01a0ae10-6f2a-7ba0-aced-3b2129f8958f"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5a1","stream":{"kind":"session","id":"01a0ae0f-ee07-7b81-b4d4-cf94ccb5debd"},"sequence":299,"recorded_at":1780531400000593,"record_type":"event","durability":"durable","causation_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","run_stream":{"kind":"run","id":"b7392d99-bbd5-4114-ba32-61509405cfc4"},"task_stream":{"kind":"task","id":"01a0ae10-6ff5-7922-b4bf-72a87614cfc5"},"task_id":"01a0ae10-6ff5-7922-b4bf-72a87614cfc5","event":{"kind":"output","task_id":"01a0ae10-6ff5-7922-b4bf-72a87614cfc5","chunk":"Read text file `internal/fencing/doc.go`.\n1|// Package fencing gates every activation-class action on the winning\n2|// lease and the exact fencing epoch.\n3|//\n4|// Normative scope: AX v0.6.0 Section 2.2 global invariants (the winning\n5|// committed lease is the only authority that may create a destination\n6|// runtime; a fencing token is the winning lease_id + epoch pair carried\n7|// by every owner-authored event and mutation; force takeover fences the\n8|// prior owner logically), Section 5.3 Lease Record (epoch, predecessor,\n9|// holder, fencing token, revalidation before input, turn, checkpoint,\n10|// push, and resume), Sections 13.6-13.10 (graceful takeover, force\n11|// takeover, fork, stop, resume: which steps require the winning lease\n12|// and the exact epoch), the Section 4 terminal wrapper rule (compare the\n13|// local fencing token before launching a provider; park safely when\n14|// ownership is remote, ambiguous, or unverified), and the Section 7.5\n15|// Provider Protocol LeaseToken carried by quiesce, capture, and\n16|// materialize operations.\n17|//\n18|// Division of authority (no second lease model):\n19|//\n20|//   - The Lease Record shape, identity, and lifecycle (CreateLease,\n21|//     CompareAndSwapLease, WinningLease, VerifyFencingToken,\n22|//     CheckFencingExpiry, CompareLeaseTuple) are owned by\n23|//     internal/sessrepo. This package never mints, persists, orders, or\n24|//     revalidates a lease itself: Observe loads the winning summary\n25|//     through ListLeases, and the expiry arm calls CheckFencingExpiry.\n26|//   - The winning-tuple rule is owned by internal/sessstate (Compare).\n27|//     This package never compares two leases against each other; it\n28|//     compares one presented token for exact equality with the one\n29|//     winning summary the store reports.\n30|//   - Takeover, fork, stop, and resume transactions, terminal backends,\n31|//     and provider plugin processes are callers, not members: the gates\n32|//     model their entry points (AuthorizeActivation, AuthorizeInput,\n33|//     AuthorizeMutation, AuthorizeCheckpoint, AuthorizeRestore,\n34|//     AuthorizeTerminateStale) and the callers report their own sync,\n35|//     handoff, and grant facts through Observation.\n36|//\n37|// The gates are pure over durable inputs: they perform no writes, hold\n38|// no cache, and read no clock except the Now the caller supplies, so\n39|// there is no crash seam and no idempotency hazard to evidence beyond\n40|// the no-write test. Every refusal carries a Section 15 registered code\n41|// and nothing else: lease_conflict, not_owner, and stale_owner at exit\n42|// 10, invalid_arguments at exit 2, and local_precondition_failed at exit\n43|// 3. Launch-class entries (activation, restore) park instead of refusing\n44|// when ownership is remote, ambiguous, unverified, or absent, carrying\n45|// the Section 5.2 session.parked vocabulary\n46|// (remote_owner|stale_owner|restore_policy|failed_handoff) with the\n47|// winning lease ID; every other entry refuses outright.\n48|package fencing","final_result":true}}}
