{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c745","stream":{"kind":"session","id":"01a0ae0f-ee07-7b81-b4d4-cf94ccb5debd"},"sequence":509,"recorded_at":1780531400001013,"record_type":"event","durability":"durable","causation_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","run_stream":{"kind":"run","id":"b7392d99-bbd5-4114-ba32-61509405cfc4"},"task_stream":{"kind":"task","id":"01a0ae10-cd5c-7c82-8bdc-c113e2ba6ed3"},"task_id":"01a0ae10-cd5c-7c82-8bdc-c113e2ba6ed3","event":{"kind":"output","task_id":"01a0ae10-cd5c-7c82-8bdc-c113e2ba6ed3","chunk":"Read text file `internal/fencing/scenarios_test.go`.\n1|package fencing\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"crypto/sha256\"\n6|\t\"encoding/hex\"\n7|\t\"encoding/json\"\n8|\t\"errors\"\n9|\t\"io/fs\"\n10|\t\"os\"\n11|\t\"path/filepath\"\n12|\t\"sort\"\n13|\t\"strings\"\n14|\t\"testing\"\n15|\n16|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n17|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n18|)\n19|\n20|// buildFenceRecord derives a valid Session Record from the SPEC\n21|// example with the caller's session identity and name.\n22|func buildFenceRecord(t *testing.T, sessionID, name string) []byte {\n23|\tt.Helper()\n24|\tvar object map[string]any\n25|\tif err := json.Unmarshal([]byte(specRecordExample), &object); err != nil {\n26|\t\tt.Fatalf(\"unmarshal SPEC record example: %v\", err)\n27|\t}\n28|\tobject[\"session_id\"], object[\"subject_id\"], object[\"name\"] = sessionID, sessionID, name\n29|\treturn identifyFenceObject(t, object, \"record_id\")\n30|}\n31|\n32|func createdFencePayload(recordID string) map[string]any {\n33|\treturn map[string]any{\"session_record_id\": recordID, \"bootstrap_operation_id\": \"0198f4c8-7d40-7e55-8e6f-1234567890ab\", \"first_checkpoint_operation_id\": \"0198f4c8-7d40-7e55-8e6f-1234567890ac\"}\n34|}\n35|\n36|func idleFencePayload() map[string]any {\n37|\treturn map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true}\n38|}\n39|\n40|func resumedFencePayload() map[string]any {\n41|\treturn map[string]any{\"checkpoint_id\": fenceZeroDigest, \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"terminal_backend\": \"tmux\", \"native_session_id\": \"pane-1\"}\n42|}\n43|\n44|// appendFenceEvent appends one valid event at the given chain position\n45|// and returns its reference and bytes.\n46|func appendFenceEvent(t *testing.T, repository *sessrepo.Repository, sessionID string, predecessors []string, epoch uint64, leaseID string, sequence uint64, hostID, eventType string, payload map[string]any) (sessrepo.EventRef, []byte) {\n47|\tt.Helper()\n48|\traw := buildFenceEvent(t, sessionID, predecessors, epoch, leaseID, sequence, hostID, eventType, payload)\n49|\treference, err := repository.AppendEvent(sessionID, raw)\n50|\tif err != nil {\n51|\t\tt.Fatalf(\"AppendEvent(seq %d) error = %v\", sequence, err)\n52|\t}\n53|\treturn reference, raw\n54|}\n55|\n56|// observeFence builds the Observe input for a verified local grant.\n57|func observeFence(localHostID string) ObserveInput {\n58|\treturn ObserveInput{LocalHostID: localHostID, Verified: true, HasGrant: true, Grant: sessrepo.FencingGrant{SessionID: fenceSessionA, ValidatedAt: fenceValidatedAt}, Policy: fencePolicy, Now: fenceValidatedAt}\n59|}\n60|\n61|// plantForceTakeover builds the two-replica force-takeover fixture:\n62|// repoOld holds session A with the epoch-1 lease and its two-event\n63|// chain, repoNew holds the byte-identical base plus the epoch-2 force\n64|// lease and the resumed event under it. It returns both repositories\n65|// with the new replica's data root for blob assertions.\n66|func plantForceTakeover(t *testing.T) (repoOld, repoNew *sessrepo.Repository, rootNew string) {\n67|\tt.Helper()\n68|\tvar rootOld string\n69|\trepoOld, rootOld = openFenceRepository(t)\n70|\t_ = rootOld\n71|\trepoNew, rootNew = openFenceRepository(t)\n72|\trecord := createFenceSession(t, repoOld)\n73|\tif _, err := repoNew.CreateSession([]byte(specRecordExample)); err != nil {\n74|\t\tt.Fatalf(\"CreateSession(new) error = %v\", err)\n75|\t}\n76|\tbase := sessrepo.CreateLeaseInput{LeaseID: fenceLeaseOld, HolderHostID: fenceHostA, IssuedByHostID: fenceHostA, CreatedAt: fenceLeaseAt}\n77|\toldHead := mustCreateFenceLease(t, repoOld, fenceSessionA, base)\n78|\tnewHead := mustCreateFenceLease(t, repoNew, fenceSessionA, base)\n79|\tif oldHead.RecordID != newHead.RecordID {\n80|\t\tt.Fatalf(\"epoch-1 bases differ: %s vs %s\", oldHead.RecordID, newHead.RecordID)\n81|\t}\n82|\tcreated, _ := appendFenceEvent(t, repoOld, fenceSessionA, []string{record.RecordID}, 1, fenceLeaseOld, 1, fenceHostA, \"session.created\", createdFencePayload(record.RecordID))\n83|\tidle, _ := appendFenceEvent(t, repoOld, fenceSessionA, []string{created.EventID}, 1, fenceLeaseOld, 2, fenceHostA, \"session.idle\", idleFencePayload())\n84|\tif _, err := repoNew.AppendEvent(fenceSessionA, buildFenceEvent(t, fenceSessionA, []string{record.RecordID}, 1, fenceLeaseOld, 1, fenceHostA, \"session.created\", createdFencePayload(record.RecordID))); err != nil {\n85|\t\tt.Fatalf(\"AppendEvent(new created) error = %v\", err)\n86|\t}\n87|\tif _, err := repoNew.AppendEvent(fenceSessionA, buildFenceEvent(t, fenceSessionA, []string{created.EventID}, 1, fenceLeaseOld, 2, fenceHostA, \"session.idle\", idleFencePayload())); err != nil {\n88|\t\tt.Fatalf(\"AppendEvent(new idle) error = %v\", err)\n89|\t}\n90|\tmustSwapFenceLease(t, repoNew, fenceSessionA, sessrepo.LeaseExpectation{RecordID: newHead.RecordID}, sessrepo.SuccessorLeaseInput{\n91|\t\tCreateLeaseInput: sessrepo.CreateLeaseInput{LeaseID: fenceLeaseA, HolderHostID: fenceHostB, IssuedByHostID: fenceHostB, CreatedAt: fenceLeaseAt},\n92|\t\tReason:           \"force_takeover\",\n93|\t\tCheckpointID:     fenceZeroDigest,\n94|\t})\n95|\tappendFenceEvent(t, repoNew, fenceSessionA, []string{idle.EventID}, 2, fenceLeaseA, 1, fenceHostB, \"session.resumed\", resumedFencePayload())\n96|\treturn repoOld, repoNew, rootNew\n97|}\n98|\n99|// TestOldOwnerReconnectRejectedAfterForceTakeover drives the\n100|// old-owner-reconnect row through production entries: after a force\n101|// takeover, the old token is rejected from input, mutation, and\n102|// restore, the old wrapper parks remote, the losing events stay\n103|// preserved without application, and the sessstate union reports the\n104|// losing branch preserved while authoritative state stands.\n105|func TestOldOwnerReconnectRejectedAfterForceTakeover(t *testing.T) {\n106|\t_, repoNew, rootNew := plantForceTakeover(t)\n107|\told := PresentedToken{SessionID: fenceSessionA, Epoch: 1, LeaseID: fenceLeaseOld}\n108|\n109|\tt.Run(\"new_owner_rejects_old_token_as_stale\", func(t *testing.T) {\n110|\t\tobservation, err := Observe(repoNew, fenceSessionA, observeFence(fenceHostB))\n111|\t\tif err != nil {\n112|\t\t\tt.Fatalf(\"Observe error = %v\", err)\n113|\t\t}\n114|\t\t_, err = AuthorizeInput(old, observation)\n115|\t\tmustRefuse(t, err, ErrStaleOwner, \"reconnect/input\")\n116|\t\t_, err = AuthorizeMutation(old, observation)\n117|\t\tmustRefuse(t, err, ErrStaleOwner, \"reconnect/mutation\")\n118|\t\t_, err = AuthorizeCheckpoint(old, observation)\n119|\t\tmustRefuse(t, err, ErrStaleOwner, \"reconnect/checkpoint\")\n120|\t})\n(more lines below)","final_result":true}}}
