.go\\n     248 internal/fencing/fixtures_test.go\\n     479 internal/fencing/gate_test.go\\n     488 internal/fencing/scenarios_test.go\\n     149 internal/fencing/terminate_test.go\\n     117 internal/fencing/token_test.go\\n    4019 total\\n\",\n  \"original_output_bytes\": 1065,\n  \"original_output_tokens\": 267,\n  \"truncated\": false\n}","final_result":true}}}
