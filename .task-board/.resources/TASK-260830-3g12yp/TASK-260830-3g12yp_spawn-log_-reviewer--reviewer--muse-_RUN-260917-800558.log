{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d165","stream":{"kind":"session","id":"01a0ae0f-ee07-7b81-b4d4-cf94ccb5debd"},"sequence":1805,"recorded_at":1780531400003605,"record_type":"event","durability":"durable","causation_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","run_stream":{"kind":"run","id":"b7392d99-bbd5-4114-ba32-61509405cfc4"},"task_stream":{"kind":"task","id":"01a0ae26-8e00-7af1-a006-e74dfa156b4e"},"task_id":"01a0ae26-8e00-7af1-a006-e74dfa156b4e","event":{"kind":"output","task_id":"01a0ae26-8e00-7af1-a006-e74dfa156b4e","chunk":"Read text file `internal/fencing/scenarios_test.go`.\n(119 line(s) above)\n120|\t})\n121|\n122|\tt.Run(\"old_wrapper_parks_remote\", func(t *testing.T) {\n123|\t\tobservation, err := Observe(repoNew, fenceSessionA, observeFence(fenceHostA))\n124|\t\tif err != nil {\n125|\t\t\tt.Fatalf(\"Observe error = %v\", err)\n126|\t\t}\n127|\t\t_, err = AuthorizeRestore(old, observation)\n128|\t\tmustPark(t, err, ParkRemoteOwner, fenceLeaseA, ErrNotOwner, \"reconnect/restore\")\n129|\t\t_, err = AuthorizeActivation(old, observation)\n130|\t\tmustPark(t, err, ParkRemoteOwner, fenceLeaseA, ErrNotOwner, \"reconnect/activation\")\n131|\t})\n132|\n133|\tt.Run(\"losing_events_preserved_without_application\", func(t *testing.T) {\n134|\t\tbefore, err := repoNew.ListEvents(fenceSessionA)\n135|\t\tif err != nil {\n136|\t\t\tt.Fatalf(\"ListEvents error = %v\", err)\n137|\t\t}\n138|\t\tdivergent := buildFenceEvent(t, fenceSessionA, []string{before[len(before)-1].EventID}, 1, fenceLeaseOld, 3, fenceHostA, \"session.idle\", idleFencePayload())\n139|\t\t_, err = repoNew.AppendEvent(fenceSessionA, divergent)\n140|\t\tif !errors.Is(err, sessrepo.ErrStaleLease) {\n141|\t\t\tt.Fatalf(\"AppendEvent(divergent) error = %v, want stale lease\", err)\n142|\t\t}\n143|\t\tafter, err := repoNew.ListEvents(fenceSessionA)\n144|\t\tif err != nil {\n145|\t\t\tt.Fatalf(\"ListEvents error = %v\", err)\n146|\t\t}\n147|\t\tif len(after) != len(before) || after[len(after)-1].EventID != before[len(before)-1].EventID {\n148|\t\t\tt.Fatalf(\"chain moved under a losing append: %d events, tail %s\", len(after), after[len(after)-1].EventID)\n149|\t\t}\n150|\t\tvar decoded map[string]any\n151|\t\tif err := json.Unmarshal(divergent, &decoded); err != nil {\n152|\t\t\tt.Fatalf(\"unmarshal divergent event: %v\", err)\n153|\t\t}\n154|\t\teventID, _ := decoded[\"event_id\"].(string)\n155|\t\tblobPath := filepath.Join(rootNew, \"sessions\", fenceSessionA, \"events\", strings.TrimPrefix(eventID, \"sha256:\")+\".json\")\n156|\t\tstored, err := os.ReadFile(blobPath)\n157|\t\tif err != nil {\n158|\t\t\tt.Fatalf(\"read preserved divergent blob: %v\", err)\n159|\t\t}\n160|\t\tif !bytes.Equal(stored, divergent) {\n161|\t\t\tt.Fatal(\"preserved divergent blob differs from the refused bytes\")\n162|\t\t}\n163|\t})\n164|\n165|\tt.Run(\"union_preserves_losing_branch\", func(t *testing.T) {\n166|\t\trepoOld, _ := openFenceRepository(t)\n167|\t\trecord := createFenceSession(t, repoOld)\n168|\t\tbase := sessrepo.CreateLeaseInput{LeaseID: fenceLeaseOld, HolderHostID: fenceHostA, IssuedByHostID: fenceHostA, CreatedAt: fenceLeaseAt}\n169|\t\tmustCreateFenceLease(t, repoOld, fenceSessionA, base)\n170|\t\tcreated, _ := appendFenceEvent(t, repoOld, fenceSessionA, []string{record.RecordID}, 1, fenceLeaseOld, 1, fenceHostA, \"session.created\", createdFencePayload(record.RecordID))\n171|\t\tappendFenceEvent(t, repoOld, fenceSessionA, []string{created.EventID}, 1, fenceLeaseOld, 2, fenceHostA, \"session.idle\", idleFencePayload())\n172|\n173|\t\tplain, err := (&sessstate.Projector{Repo: repoOld}).Project(fenceSessionA)\n174|\t\tif err != nil {\n175|\t\t\tt.Fatalf(\"Project(chain) error = %v\", err)\n176|\t\t}\n177|\t\tif plain.State != sessstate.StateIdle {\n178|\t\t\tt.Fatalf(\"chain projection state = %s, want idle\", plain.State)\n179|\t\t}\n180|\t\tunion := []sessstate.LeaseHead{{Epoch: 2, LeaseID: fenceLeaseA}, {Epoch: 1, LeaseID: fenceLeaseOld}}\n181|\t\twithUnion, err := (&sessstate.Projector{Repo: repoOld, Union: union}).Project(fenceSessionA)\n182|\t\tif err != nil {\n183|\t\t\tt.Fatalf(\"Project(union) error = %v\", err)\n184|\t\t}\n185|\t\tif withUnion.Winner.Epoch != 2 || withUnion.Winner.LeaseID != fenceLeaseA {\n186|\t\t\tt.Fatalf(\"union winner = %+v, want the force lease\", withUnion.Winner)\n187|\t\t}\n188|\t\tif withUnion.State != sessstate.StateIdle {\n189|\t\t\tt.Fatalf(\"union projection state = %s, want idle: authoritative state must stand\", withUnion.State)\n190|\t\t}\n191|\t\tstaleView, err := (&sessstate.Projector{Repo: repoOld, Union: union, Local: sessstate.LeaseHead{Epoch: 1, LeaseID: fenceLeaseOld}, LocalHostID: fenceHostA}).Project(fenceSessionA)\n192|\t\tif err != nil {\n193|\t\t\tt.Fatalf(\"Project(union+local) error = %v\", err)\n194|\t\t}\n195|\t\tif staleView.State != sessstate.StateStale {\n196|\t\t\tt.Fatalf(\"old-owner projection state = %s, want stale\", staleView.State)\n197|\t\t}\n198|\t\tassertConflict(t, staleView, sessstate.ConflictLosingBranchPreserved)\n199|\t\tassertConflict(t, staleView, sessstate.ConflictUnionSupersedesChain)\n200|\t})\n201|}\n202|\n203|func assertConflict(t *testing.T, projection sessstate.Projection, kind string) {\n204|\tt.Helper()\n205|\tfor _, conflict := range projection.Conflicts {\n206|\t\tif conflict.Kind == kind {\n207|\t\t\treturn\n208|\t\t}\n209|\t}\n210|\tt.Fatalf(\"projection conflicts %v lack %s\", projection.Conflicts, kind)\n211|}\n212|\n213|// TestConcurrentForceTakeoversDeterministicWinner drives the\n214|// concurrent-takeover row: two force leases at the same epoch from\n215|// one base resolve to the bytewise-greater lease ID in either union\n216|// order under both tuple rules, the winner authorizes, and the loser\n217|// stops accepting input.\n218|func TestConcurrentForceTakeoversDeterministicWinner(t *testing.T) {\n219|\tbuild := func(t *testing.T, leaseID, holder string) *sessrepo.Repository {\n220|\t\tt.Helper()\n221|\t\trepository, _ := openFenceRepository(t)\n222|\t\tcreateFenceSession(t, repository)\n223|\t\tbase := mustCreateFenceLease(t, repository, fenceSessionA, sessrepo.CreateLeaseInput{LeaseID: fenceLeaseOld, HolderHostID: fenceHostA, IssuedByHostID: fenceHostA, CreatedAt: fenceLeaseAt})\n224|\t\tmustSwapFenceLease(t, repository, fenceSessionA, sessrepo.LeaseExpectation{RecordID: base.RecordID}, sessrepo.SuccessorLeaseInput{\n225|\t\t\tCreateLeaseInput: sessrepo.CreateLeaseInput{LeaseID: leaseID, HolderHostID: holder, IssuedByHostID: holder, CreatedAt: fenceLeaseAt},\n226|\t\t\tReason:           \"force_takeover\",\n227|\t\t\tCheckpointID:     fenceZeroDigest,\n228|\t\t})\n229|\t\treturn repository\n230|\t}\n231|\trepoX := build(t, fenceLeaseA, fenceHostB)\n232|\trepoY := build(t, fenceLeaseC2, fenceHostC)\n233|\theadX, err := repoX.WinningLease(fenceSessionA)\n234|\tif err != nil {\n235|\t\tt.Fatalf(\"WinningLease(X) error = %v\", err)\n236|\t}\n237|\theadY, err := repoY.WinningLease(fenceSessionA)\n238|\tif err != nil {\n239|\t\tt.Fatalf(\"WinningLease(Y) error = %v\", err)\n240|\t}\n241|\tfor _, order := range [][2]sessrepo.LeaseSummary{{headX, headY}, {headY, headX}} {\n242|\t\twinner := order[0]\n243|\t\tif sessrepo.CompareLeaseTuple(order[1], winner) > 0 {\n244|\t\t\twinner = order[1]\n245|\t\t}\n246|\t\tif winner.LeaseID != fenceLeaseC2 {\n247|\t\t\tt.Fatalf(\"union winner = %s, want the greater lease %s\", winner.LeaseID, fenceLeaseC2)\n248|\t\t}\n249|\t\tstateWinner := sessstate.LeaseHead{Epoch: order[0].Epoch, LeaseID: order[0].LeaseID}\n250|\t\tother := sessstate.LeaseHead{Epoch: order[1].Epoch, LeaseID: order[1].LeaseID}\n251|\t\tif sessstate.Compare(other, stateWinner) > 0 {\n252|\t\t\tstateWinner = other\n253|\t\t}\n254|\t\tif stateWinner.LeaseID != winner.LeaseID {\n255|\t\t\tt.Fatalf(\"sessstate winner %s disagrees with store winner %s\", stateWinner.LeaseID, winner.LeaseID)\n256|\t\t}\n257|\t}\n258|\t// The loser stops accepting input once it learns the union\n259|\t// winner: its same-epoch token loses the tie on the winning host.\n260|\tloser := PresentedToken{SessionID: fenceSessionA, Epoch: 2, LeaseID: fenceLeaseA}\n261|\tunion := ObserveInput{LocalHostID: fenceHostC, Verified: true, HasGrant: true, Grant: sessrepo.FencingGrant{SessionID: fenceSessionA, ValidatedAt: fenceValidatedAt}, Policy: fencePolicy, Now: fenceValidatedAt}\n262|\tobservation, err := Observe(repoY, fenceSessionA, union)\n263|\tif err != nil {\n264|\t\tt.Fatalf(\"Observe error = %v\", err)\n265|\t}\n266|\t_, err = AuthorizeInput(loser, observation)\n267|\tmustRefuse(t, err, ErrLeaseConflict, \"loser/input\")\n268|\t_, err = AuthorizeMutation(loser, observation)\n269|\tmustRefuse(t, err, ErrLeaseConflict, \"loser/mutation\")\n270|\tchampion := PresentedToken{SessionID: fenceSessionA, Epoch: 2, LeaseID: fenceLeaseC2}\n271|\ttoken, err := AuthorizeActivation(champion, observation)\n272|\tmustMintUnion(t, token, err, fenceLeaseC2)\n273|}\n274|\n275|// mustMintUnion is mustMint for a non-default winning lease: the\n276|// minted token binds the exact expected triple.\n277|func mustMintUnion(t *testing.T, token LeaseToken, err error, leaseID string) {\n278|\tt.Helper()\n279|\tif err != nil {\n280|\t\tt.Fatalf(\"union authorize error = %v, want a minted token\", err)\n281|\t}\n282|\tbound, err := token.Bind(ProviderCapture)\n283|\tif err != nil {\n284|\t\tt.Fatalf(\"Bind(capture) error = %v\", err)\n285|\t}\n286|\tif bound.SessionID != fenceSessionA || bound.Epoch != 2 || bound.LeaseID != leaseID {\n287|\t\tt.Fatalf(\"Bind(capture) = %+v, want the union winner\", bound)\n288|\t}\n289|}\n290|\n291|// TestLifecycleCallersPassTheGate models graceful takeover, fork,\n292|// stop, and resume as gate callers: each authorizes its entry point\n293|// with the winning lease and the exact epoch, and the replica resume\n294|// parks remote instead of starting a runtime.\n295|func TestLifecycleCallersPassTheGate(t *testing.T) {\n296|\tt.Run(\"graceful_takeover_commit\", func(t *testing.T) {\n297|\t\trepository, _ := openFenceRepository(t)\n298|\t\tcreateFenceSession(t, repository)\n299|\t\tfirst := mustCreateFenceLease(t, repository, fenceSessionA, sessrepo.CreateLeaseInput{LeaseID: fenceLeaseOld, HolderHostID: fenceHostA, IssuedByHostID: fenceHostA, CreatedAt: fenceLeaseAt})\n300|\t\tmustSwapFenceLease(t, repository, fenceSessionA, sessrepo.LeaseExpectation{RecordID: first.RecordID}, sessrepo.SuccessorLeaseInput{\n301|\t\t\tCreateLeaseInput: sessrepo.CreateLeaseInput{LeaseID: fenceLeaseA, HolderHostID: fenceHostB, IssuedByHostID: fenceHostB, CreatedAt: fenceLeaseAt},\n302|\t\t\tReason:           \"graceful_takeover\",\n303|\t\t\tCheckpointID:     fenceZeroDigest,\n304|\t\t})\n305|\t\tdestination, err := Observe(repository, fenceSessionA, observeFence(fenceHostB))\n306|\t\tif err != nil {\n307|\t\t\tt.Fatalf(\"Observe error = %v\", err)\n308|\t\t}\n309|\t\ttoken, err := AuthorizeMutation(PresentedToken{SessionID: fenceSessionA, Epoch: 2, LeaseID: fenceLeaseA}, destination)\n310|\t\tmustMint(t, token, err, \"takeover/commit\")\n311|\t\tsource, err := Observe(repository, fenceSessionA, observeFence(fenceHostA))\n312|\t\tif err != nil {\n313|\t\t\tt.Fatalf(\"Observe(source) error = %v\", err)\n314|\t\t}\n315|\t\t_, err = AuthorizeMutation(PresentedToken{SessionID: fenceSessionA, Epoch: 1, LeaseID: fenceLeaseOld}, source)\n316|\t\tmustRefuse(t, err, ErrNotOwner, \"takeover/source\")\n317|\t})\n318|\n319|\tt.Run(\"fork_epoch_one_activation\", func(t *testing.T) {\n(more lines below)","final_result":true}}}
