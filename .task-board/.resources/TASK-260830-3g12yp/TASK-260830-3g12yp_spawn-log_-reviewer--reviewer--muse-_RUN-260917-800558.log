replace(\\\"return TMP\\\",\\\"return 1\\\")))\\nrc = run([\\\"go\\\",\\\"test\\\",\\\"./internal/sessquery\\\",\\\"-run\\\",\\\"^TestLeaseTupleOrderAgreesWithSessstateCompare$\\\",\\\"-count=1\\\",\\\"-v\\\"],\\\"D1-sessrepo.log\\\")\\ntxt=(out/\\\"logs\\\"/\\\"D1-sessrepo.log\\\").read_text(); fails=re.findall(r\\\"^\\\\s*--- FAIL: (\\\\S+)\\\",txt,re.M)\\nres.append((\\\"D1-diverge-sessrepo-side\\\",\\\"KILLED\\\" if (rc!=0 and fails) else \\\"SURVIVED\\\",rc,fails[:2]))\\np.write_text(t)\\n# Diverge sessstate side: flip tie-break.\\nq = copy/\\\"internal/sessstate/sessstate.go\\\"; u = q.read_text()\\nassert u.count(old)==1\\nq.write_text(u.replace(old, old.replace(\\\"return -1\\\",\\\"return TMP\\\").replace(\\\"return 1\\\",\\\"return -1\\\").replace(\\\"return TMP\\\",\\\"return 1\\\")))\\nrc = run([\\\"go\\\",\\\"test\\\",\\\"./internal/sessquery\\\",\\\"-run\\\",\\\"^TestLeaseTupleOrderAgreesWithSessstateCompare$\\\",\\\"-count=1\\\",\\\"-v\\\"],\\\"D2-sessstate.log\\\")\\ntxt=(out/\\\"logs\\\"/\\\"D2-sessstate.log\\\").read_text(); fails=re.findall(r\\\"^\\\\s*--- FAIL: (\\\\S+)\\\",txt,re.M)\\nres.append((\\\"D2-diverge-sessstate-side\\\",\\\"KILLED\\\" if (rc!=0 and fails) else \\\"SURVIVED\\\",rc,fails[:2]))\\nq.write_text(u)\\nrc = run([\\\"go\\\",\\\"test\\\",\\\"./internal/sessquery\\\",\\\"-run\\\",\\\"^TestLeaseTupleOrderAgreesWithSessstateCompare$\\\",\\\"-count=1\\\"],\\\"after.log\\\")\\nres.append((\\\"control-after\\\",\\\"CONTROL\\\",rc))\\nprint(json.dumps(res,indent=1))\\nEOF\\nPYTHONDONTWRITEBYTECODE=1 python3 /tmp/rev-3g12yp/diverge.py\",\n  \"description\": \"Plant tie-break divergences on each side\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"[\\n [\\n  \\\"control-before\\\",\\n  \\\"CONTROL\\\",\\n  0\\n ],\\n [\\n  \\\"D1-diverge-sessrepo-side\\\",\\n  \\\"KILLED\\\",\\n  1,\\n  [\\n   \\\"TestLeaseTupleOrderAgreesWithSessstateCompare\\\"\\n  ]\\n ],\\n [\\n  \\\"D2-diverge-sessstate-side\\\",\\n  \\\"KILLED\\\",\\n  1,\\n  [\\n   \\\"TestLeaseTupleOrderAgreesWithSessstateCompare\\\"\\n  ]\\n ],\\n [\\n  \\\"control-after\\\",\\n  \\\"CONTROL\\\",\\n  0\\n ]\\n]\\n\",\n  \"original_output_bytes\": 317,\n  \"original_output_tokens\": 80,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
