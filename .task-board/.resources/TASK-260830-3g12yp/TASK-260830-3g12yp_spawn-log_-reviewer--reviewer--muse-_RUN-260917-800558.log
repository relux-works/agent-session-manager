{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c599","stream":{"kind":"session","id":"01a0ae0f-ee07-7b81-b4d4-cf94ccb5debd"},"sequence":295,"recorded_at":1780531400000585,"record_type":"event","durability":"durable","causation_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","run_stream":{"kind":"run","id":"b7392d99-bbd5-4114-ba32-61509405cfc4"},"task_stream":{"kind":"task","id":"01a0ae10-6f79-70f0-8f75-b40e819c72ff"},"task_id":"01a0ae10-6f79-70f0-8f75-b40e819c72ff","event":{"kind":"output","task_id":"01a0ae10-6f79-70f0-8f75-b40e819c72ff","chunk":"Read text file `internal/fencing/token.go`.\n1|package fencing\n2|\n3|// leaseSealToken is deliberately unexported and is minted only by the\n4|// free mintLeaseToken constructor below. The type-level census pins\n5|// that construction boundary across every production source file; the\n6|// token then makes a zero or field-assembled LeaseToken unusable at\n7|// runtime. There is no exported constructor and no exported field: a\n8|// caller outside this package cannot spell a live token.\n9|type leaseSealToken struct{}\n10|\n11|// leaseSeal holds the fenced authority a passed gate established: the\n12|// session with the exact winning (epoch, lease_id) tuple. Its fields\n13|// are private so callers cannot treat the minted projection as a\n14|// public record-shaped DTO.\n15|type leaseSeal struct {\n16|\ttoken   *leaseSealToken\n17|\tsession string\n18|\tepoch   uint64\n19|\tleaseID string\n20|}\n21|\n22|// LeaseToken is the sealed fencing capability Authorize mints for a\n23|// passed gate: the Section 7.5 LeaseToken projection\n24|// {session_id, lease_epoch, lease_id} for provider operations. A zero\n25|// value or a value assembled without the constructor-only seal token\n26|// is not authority, even when a caller fills the outer struct.\n27|type LeaseToken struct {\n28|\tseal *leaseSeal\n29|}\n30|\n31|// mintLeaseToken is the single constructor for a live LeaseToken. It\n32|// runs only at the end of Authorize, after every ownership, grant,\n33|// and tuple arm has passed.\n34|func mintLeaseToken(session string, epoch uint64, leaseID string) LeaseToken {\n35|\treturn LeaseToken{seal: &leaseSeal{token: &leaseSealToken{}, session: session, epoch: epoch, leaseID: leaseID}}\n36|}\n37|\n38|// authority opens the seal for the capability consumers. A missing\n39|// seal or seal token refuses lease_conflict before any other check,\n40|// so forgery can never degrade into a different class.\n41|func (token LeaseToken) authority() (*leaseSeal, error) {\n42|\tif token.seal == nil || token.seal.token == nil {\n43|\t\treturn nil, refuse(ErrLeaseConflict, \"fencing capability seal is missing\")\n44|\t}\n45|\treturn token.seal, nil\n46|}\n47|\n48|// ProviderOperation is one Section 7.5 provider operation that carries\n49|// the LeaseToken. Resume, stop, materialize-commit, and\n50|// native-store-plan carry the same triple on the wire; their callers\n51|// have no gate entry in this package yet, so binding them here would\n52|// be an untestable claim and stays a stated bound.\n53|type ProviderOperation string\n54|\n55|const (\n56|\t// ProviderQuiesce binds the token to a quiesce operation.\n57|\tProviderQuiesce ProviderOperation = \"quiesce\"\n58|\t// ProviderCapture binds the token to a capture operation.\n59|\tProviderCapture ProviderOperation = \"capture\"\n60|\t// ProviderMaterialize binds the token to a materialize operation.\n61|\tProviderMaterialize ProviderOperation = \"materialize\"\n62|)\n63|\n64|// validProviderOperation reports whether op is a bound provider\n65|// operation. Anything else is a malformed bind call.\n66|func validProviderOperation(op ProviderOperation) bool {\n67|\tswitch op {\n68|\tcase ProviderQuiesce, ProviderCapture, ProviderMaterialize:\n69|\t\treturn true\n70|\t}\n71|\treturn false\n72|}\n73|\n74|// ProviderLease is the wire projection of a bound capability: the\n75|// Section 7.5 LeaseToken triple with the operation it authorizes. It\n76|// carries no seal because it is evidence of one past authorization,\n77|// not authority for another; only Bind mints it, and only from a live\n78|// sealed token.\n79|type ProviderLease struct {\n80|\tSessionID string\n81|\tEpoch     uint64\n82|\tLeaseID   string\n83|\tOperation ProviderOperation\n84|}\n85|\n86|// Bind projects a live LeaseToken onto one provider operation. A zero\n87|// or forged token refuses lease_conflict; an unknown operation refuses\n88|// invalid_arguments. Only a token minted by a passed Authorize gate\n89|// reaches the projection.\n90|func (token LeaseToken) Bind(operation ProviderOperation) (ProviderLease, error) {\n91|\tseal, err := token.authority()\n92|\tif err != nil {\n93|\t\treturn ProviderLease{}, err\n94|\t}\n95|\tif !validProviderOperation(operation) {\n96|\t\treturn ProviderLease{}, refuse(ErrInvalidArguments, \"unknown provider operation %q\", string(operation))\n97|\t}\n98|\treturn ProviderLease{SessionID: seal.session, Epoch: seal.epoch, LeaseID: seal.leaseID, Operation: operation}, nil\n99|}","final_result":true}}}
