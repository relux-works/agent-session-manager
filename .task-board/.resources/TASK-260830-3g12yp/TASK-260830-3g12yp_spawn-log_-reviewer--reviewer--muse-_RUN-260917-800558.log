{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c661","stream":{"kind":"session","id":"01a0ae0f-ee07-7b81-b4d4-cf94ccb5debd"},"sequence":395,"recorded_at":1780531400000785,"record_type":"event","durability":"durable","causation_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","run_stream":{"kind":"run","id":"b7392d99-bbd5-4114-ba32-61509405cfc4"},"task_stream":{"kind":"task","id":"01a0ae10-98bb-72b3-bbbc-c5ffbd30e955"},"task_id":"01a0ae10-98bb-72b3-bbbc-c5ffbd30e955","event":{"kind":"output","task_id":"01a0ae10-98bb-72b3-bbbc-c5ffbd30e955","chunk":"Read text file `internal/fencing/codes_test.go`.\n1|package fencing\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n8|)\n9|\n10|// TestGateRefusalsUseRegisteredCodes proves every fencing refusal\n11|// carries a Section 15 registered code and nothing else: each\n12|// sentinel message constructs a Structured Error with its exact\n13|// pinned exit. A gate that invented a code outside the taxonomy\n14|// fails here.\n15|func TestGateRefusalsUseRegisteredCodes(t *testing.T) {\n16|\tvectors := map[string]struct {\n17|\t\tsentinel error\n18|\t\texit     int\n19|\t}{\n20|\t\t\"lease_conflict\":            {ErrLeaseConflict, 10},\n21|\t\t\"not_owner\":                 {ErrNotOwner, 10},\n22|\t\t\"stale_owner\":               {ErrStaleOwner, 10},\n23|\t\t\"invalid_arguments\":         {ErrInvalidArguments, 2},\n24|\t\t\"local_precondition_failed\": {ErrLocalPreconditionFailed, 3},\n25|\t}\n26|\tfor name, vector := range vectors {\n27|\t\tt.Run(name, func(t *testing.T) {\n28|\t\t\tfailure, err := axerror.New(axerror.Spec{\n29|\t\t\t\tVersion: axerror.Version100,\n30|\t\t\t\tCode:    axerror.Code(vector.sentinel.Error()),\n31|\t\t\t\tMessage: \"fencing refusal registration probe\",\n32|\t\t\t\tIDs:     axerror.NoIDs(),\n33|\t\t\t\tDetails: axerror.Details{},\n34|\t\t\t})\n35|\t\t\tif err != nil {\n36|\t\t\t\tt.Fatalf(\"axerror.New(%s) error = %v, want a registered code\", name, err)\n37|\t\t\t}\n38|\t\t\tif failure.ExitCode() != vector.exit {\n39|\t\t\t\tt.Fatalf(\"axerror.New(%s) exit = %d, want %d\", name, failure.ExitCode(), vector.exit)\n40|\t\t\t}\n41|\t\t})\n42|\t}\n43|}\n44|\n45|// TestParkDecisionCarriesSection15Cause proves a park decision is not\n46|// a new error class: every parked refusal unwraps to its underlying\n47|// registered cause alongside the parked marker.\n48|func TestParkDecisionCarriesSection15Cause(t *testing.T) {\n49|\tobservation := fenceObservation()\n50|\tobservation.Winner.HolderHostID = fenceHostC\n51|\t_, err := AuthorizeActivation(fencePresented(), observation)\n52|\tif !IsParked(err) {\n53|\t\tt.Fatalf(\"remote activation error = %v, want a park decision\", err)\n54|\t}\n55|\tmustRefuseCause(t, err, ErrNotOwner)\n56|}\n57|\n58|// mustRefuseCause fails unless err carries the sentinel through\n59|// errors.Is (park decisions included).\n60|func mustRefuseCause(t *testing.T, err error, sentinel error) {\n61|\tt.Helper()\n62|\tif err == nil {\n63|\t\tt.Fatalf(\"succeeded, want cause %v\", sentinel)\n64|\t}\n65|\tif !errors.Is(err, sentinel) {\n66|\t\tt.Fatalf(\"error = %v, want errors.Is %v\", err, sentinel)\n67|\t}\n68|}","final_result":true}}}
