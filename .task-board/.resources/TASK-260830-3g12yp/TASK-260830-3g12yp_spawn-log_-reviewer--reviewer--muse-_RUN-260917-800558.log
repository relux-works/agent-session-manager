{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d1f3","stream":{"kind":"session","id":"01a0ae0f-ee07-7b81-b4d4-cf94ccb5debd"},"sequence":1876,"recorded_at":1780531400003747,"record_type":"event","durability":"durable","causation_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","run_stream":{"kind":"run","id":"b7392d99-bbd5-4114-ba32-61509405cfc4"},"task_stream":{"kind":"task","id":"01a0ae26-b07c-7980-827a-b37b78420aaa"},"task_id":"01a0ae26-b07c-7980-827a-b37b78420aaa","event":{"kind":"output","task_id":"01a0ae26-b07c-7980-827a-b37b78420aaa","chunk":"Read text file `internal/fencing/scenarios_test.go`.\n(318 line(s) above)\n319|\tt.Run(\"fork_epoch_one_activation\", func(t *testing.T) {\n320|\t\trepository, _ := openFenceRepository(t)\n321|\t\tif _, err := repository.CreateSession(buildFenceRecord(t, fenceSessionB, \"payments-api-experiment\")); err != nil {\n322|\t\t\tt.Fatalf(\"CreateSession(fork) error = %v\", err)\n323|\t\t}\n324|\t\tmustCreateFenceLease(t, repository, fenceSessionB, sessrepo.CreateLeaseInput{LeaseID: fenceLeaseC, HolderHostID: fenceHostB, IssuedByHostID: fenceHostB, CreatedAt: fenceLeaseAt})\n325|\t\tinput := observeFence(fenceHostB)\n326|\t\tinput.Grant.SessionID = fenceSessionB\n327|\t\tobservation, err := Observe(repository, fenceSessionB, input)\n328|\t\tif err != nil {\n329|\t\t\tt.Fatalf(\"Observe error = %v\", err)\n330|\t\t}\n331|\t\ttoken, err := AuthorizeActivation(PresentedToken{SessionID: fenceSessionB, Epoch: 1, LeaseID: fenceLeaseC}, observation)\n332|\t\tif err != nil {\n333|\t\t\tt.Fatalf(\"fork activation error = %v\", err)\n334|\t\t}\n335|\t\tbound, err := token.Bind(ProviderCapture)\n336|\t\tif err != nil {\n337|\t\t\tt.Fatalf(\"Bind(capture) error = %v\", err)\n338|\t\t}\n339|\t\tif bound.SessionID != fenceSessionB || bound.Epoch != 1 || bound.LeaseID != fenceLeaseC {\n340|\t\t\tt.Fatalf(\"Bind(capture) = %+v, want the fork epoch-1 triple\", bound)\n341|\t\t}\n342|\t\t_, err = AuthorizeActivation(PresentedToken{SessionID: fenceSessionB, Epoch: 2, LeaseID: fenceLeaseC}, observation)\n343|\t\tmustPark(t, err, ParkRestorePolicy, fenceLeaseC, ErrLeaseConflict, \"fork/future_epoch\")\n344|\t})\n345|\n346|\tt.Run(\"stop_checkpoint\", func(t *testing.T) {\n347|\t\tobservation := fenceObservation()\n348|\t\ttoken, err := AuthorizeCheckpoint(fencePresented(), observation)\n349|\t\tmustMint(t, token, err, \"stop/checkpoint\")\n350|\t\t_, err = AuthorizeCheckpoint(PresentedToken{SessionID: fenceSessionA, Epoch: 1, LeaseID: fenceLeaseOld}, observation)\n351|\t\tmustRefuse(t, err, ErrStaleOwner, \"stop/stale\")\n352|\t})\n353|\n354|\tt.Run(\"owner_resume_and_replica_park\", func(t *testing.T) {\n355|\t\tobservation := fenceObservation()\n356|\t\ttoken, err := AuthorizeRestore(fencePresented(), observation)\n357|\t\tmustMint(t, token, err, \"resume/owner\")\n358|\t\treplica := fenceObservation()\n359|\t\treplica.LocalHostID = fenceHostC\n360|\t\t_, err = AuthorizeRestore(fencePresented(), replica)\n361|\t\tmustPark(t, err, ParkRemoteOwner, fenceLeaseA, ErrNotOwner, \"resume/replica\")\n362|\t})\n363|}\n364|\n365|// TestGatesPerformNoDurableWrites proves the crash/idempotency bound:\n366|// gates are pure over durable inputs, so authorizing (passing and\n367|// failing) through every entry changes no repository byte and decides\n368|// identically on every run.\n369|func TestGatesPerformNoDurableWrites(t *testing.T) {\n370|\trepository, root := openFenceRepository(t)\n371|\tcreateFenceSession(t, repository)\n372|\tfirst := mustCreateFenceLease(t, repository, fenceSessionA, sessrepo.CreateLeaseInput{LeaseID: fenceLeaseOld, HolderHostID: fenceHostA, IssuedByHostID: fenceHostA, CreatedAt: fenceLeaseAt})\n373|\tmustSwapFenceLease(t, repository, fenceSessionA, sessrepo.LeaseExpectation{RecordID: first.RecordID}, sessrepo.SuccessorLeaseInput{\n374|\t\tCreateLeaseInput: sessrepo.CreateLeaseInput{LeaseID: fenceLeaseA, HolderHostID: fenceHostA, IssuedByHostID: fenceHostA, CreatedAt: fenceLeaseAt},\n375|\t\tReason:           \"graceful_takeover\",\n376|\t\tCheckpointID:     fenceZeroDigest,\n377|\t})\n378|\tsnapshot := snapshotTree(t, root)\n379|\tdecide := func() []string {\n380|\t\tobservation, err := Observe(repository, fenceSessionA, observeFence(fenceHostA))\n381|\t\tif err != nil {\n382|\t\t\tt.Fatalf(\"Observe error = %v\", err)\n383|\t\t}\n384|\t\tvar verdicts []string\n385|\t\trecord := func(name string, err error) {\n386|\t\t\tif err == nil {\n387|\t\t\t\tverdicts = append(verdicts, name+\":allow\")\n388|\t\t\t} else {\n389|\t\t\t\tverdicts = append(verdicts, name+\":\"+classOf(err))\n390|\t\t\t}\n391|\t\t}\n392|\t\tentries := fenceEntries()\n393|\t\tvar names []string\n394|\t\tfor name := range entries {\n395|\t\t\tnames = append(names, name)\n396|\t\t}\n397|\t\tsort.Strings(names)\n398|\t\tfor _, name := range names {\n399|\t\t\tentry := entries[name]\n400|\t\t\ttoken, err := entry.authorize(fencePresented(), observation)\n401|\t\t\trecord(name+\"/exact\", err)\n402|\t\t\tif err == nil {\n403|\t\t\t\tif _, err := token.Bind(ProviderQuiesce); err != nil {\n404|\t\t\t\t\tt.Fatalf(\"%s Bind error = %v\", name, err)\n405|\t\t\t\t}\n406|\t\t\t}\n407|\t\t\t_, err = entry.authorize(PresentedToken{SessionID: fenceSessionA, Epoch: 1, LeaseID: fenceLeaseOld}, observation)\n408|\t\t\trecord(name+\"/stale\", err)\n409|\t\t}\n410|\t\t_, err = LeaseToken{}.Bind(ProviderCapture)\n411|\t\trecord(\"bind/forged\", err)\n412|\t\trecord(\"terminate/stale\", AuthorizeTerminateStale(PresentedToken{SessionID: fenceSessionA, Epoch: 1, LeaseID: fenceLeaseOld}, observation.Winner, true, true, true))\n413|\t\trecord(\"terminate/live\", AuthorizeTerminateStale(fencePresented(), observation.Winner, true, true, true))\n414|\t\treturn verdicts\n415|\t}\n416|\tfirstRun := decide()\n417|\tif !equalSnapshot(t, snapshotTree(t, root), snapshot) {\n418|\t\tt.Fatal(\"repository bytes moved under gate evaluation\")\n419|\t}\n420|\tsecondRun := decide()\n421|\tif strings.Join(firstRun, \"\\n\") != strings.Join(secondRun, \"\\n\") {\n422|\t\tt.Fatalf(\"verdicts differ across runs:\\n%s\\nvs\\n%s\", strings.Join(firstRun, \"\\n\"), strings.Join(secondRun, \"\\n\"))\n423|\t}\n424|\tif !equalSnapshot(t, snapshotTree(t, root), snapshot) {\n425|\t\tt.Fatal(\"repository bytes moved under repeated gate evaluation\")\n426|\t}\n427|}\n428|\n429|// classOf renders the Section 15 class of a gate refusal for the\n430|// determinism comparison: park decisions render with their reason.\n431|func classOf(err error) string {\n432|\tif reason, _, ok := ParkDetails(err); ok {\n433|\t\treturn \"park:\" + string(reason)\n434|\t}\n435|\tfor _, sentinel := range []error{ErrLeaseConflict, ErrNotOwner, ErrStaleOwner, ErrInvalidArguments, ErrLocalPreconditionFailed} {\n436|\t\tif errors.Is(err, sentinel) {\n437|\t\t\treturn sentinel.Error()\n438|\t\t}\n439|\t}\n440|\treturn \"unknown:\" + err.Error()\n441|}\n442|\n443|// snapshotTree hashes every file under the data root the repository\n444|// was opened on.\n445|func snapshotTree(t *testing.T, root string) map[string]string {\n446|\tt.Helper()\n447|\tout := map[string]string{}\n448|\terr := filepath.WalkDir(root, func(path string, entry fs.DirEntry, err error) error {\n449|\t\tif err != nil || entry.IsDir() {\n450|\t\t\treturn err\n451|\t\t}\n452|\t\traw, err := os.ReadFile(path)\n453|\t\tif err != nil {\n454|\t\t\treturn err\n455|\t\t}\n456|\t\tdigest := sha256.Sum256(raw)\n457|\t\trel, err := filepath.Rel(root, path)\n458|\t\tif err != nil {\n459|\t\t\treturn err\n460|\t\t}\n461|\t\tout[rel] = hex.EncodeToString(digest[:])\n462|\t\treturn nil\n463|\t})\n464|\tif err != nil {\n465|\t\tt.Fatalf(\"walk sessions root: %v\", err)\n466|\t}\n467|\treturn out\n468|}\n469|\n470|func equalSnapshot(t *testing.T, got, want map[string]string) bool {\n471|\tt.Helper()\n472|\tif len(got) != len(want) {\n473|\t\tt.Logf(\"snapshot sizes differ: %d vs %d\", len(got), len(want))\n474|\t\treturn false\n475|\t}\n476|\tvar keys []string\n477|\tfor key := range want {\n478|\t\tkeys = append(keys, key)\n479|\t}\n480|\tsort.Strings(keys)\n481|\tfor _, key := range keys {\n482|\t\tif got[key] != want[key] {\n483|\t\t\tt.Logf(\"snapshot differs at %s\", key)\n484|\t\t\treturn false\n485|\t\t}\n486|\t}\n487|\treturn true\n488|}","final_result":true}}}
