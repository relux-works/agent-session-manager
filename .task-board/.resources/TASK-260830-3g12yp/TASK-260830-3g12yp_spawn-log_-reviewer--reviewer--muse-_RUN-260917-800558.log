{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6af","stream":{"kind":"session","id":"01a0ae0f-ee07-7b81-b4d4-cf94ccb5debd"},"sequence":434,"recorded_at":1780531400000863,"record_type":"event","durability":"durable","causation_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","run_stream":{"kind":"run","id":"b7392d99-bbd5-4114-ba32-61509405cfc4"},"task_stream":{"kind":"task","id":"01a0ae10-a9df-79a0-8a8b-490779dddd74"},"task_id":"01a0ae10-a9df-79a0-8a8b-490779dddd74","event":{"kind":"output","task_id":"01a0ae10-a9df-79a0-8a8b-490779dddd74","chunk":"Read text file `internal/fencing/testdata/mutate.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Run isolated behavioral mutants for the fencing gates; never modify the managed Story checkout.\n3|Usage: python3 internal/fencing/testdata/mutate.py /absolute/evidence/directory [name-filter]\n4|Every subprocess runs directly, logs its real exit, and has a bounded timeout.\n5|The battery proves each fencing gate by narrowing, never by deletion:\n6|every N-mutant keeps its gate present and weakens it to admit exactly one\n7|member of the class the gate must reject, and a named behavioral test must\n8|fail. The T-mutant preserves the searched-for leaseSeal token while\n9|constructing through an alias, and the harness executes the full behavioral\n10|suite for it, not only the static census. An optional name-filter runs a\n11|subset (substring match); results merge by concatenating mutants JSON rows.\n12|\"\"\"\n13|import hashlib\n14|import json\n15|from pathlib import Path\n16|import re\n17|import shutil\n18|import subprocess\n19|import sys\n20|\n21|root = Path(__file__).resolve().parents[3]\n22|output = Path(sys.argv[1]).resolve()\n23|output.mkdir(parents=True, exist_ok=True)\n24|name_filter = sys.argv[2] if len(sys.argv) > 2 else \"\"\n25|tag = re.sub(r\"[^a-z0-9]+\", \"-\", name_filter.lower()).strip(\"-\") or \"full\"\n26|copy = output / (\"mutation-source-\" + tag)\n27|if copy.exists():\n28|    raise SystemExit(\"refusing to overwrite an existing mutation source\")\n29|copy.mkdir()\n30|shutil.copytree(root / \"internal\", copy / \"internal\")\n31|for name in (\"go.mod\", \"go.sum\", \"README.md\", \"LOGBOOK.md\"):\n32|    shutil.copy2(root / name, copy / name)\n33|results = []\n34|\n35|LEASEA = \"aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee\"\n36|LEASEC = \"cccccccc-dddd-4eee-8fff-111111111111\"\n37|SESSIONB = \"0198f4c8-3e70-7a11-8a2b-1234567890ac\"\n38|\n39|GATE_IMPORT = '\\t\"errors\"\\n\\t\"fmt\"\\n\\t\"time\"'\n40|GATE_IMPORT_STRINGS = '\\t\"errors\"\\n\\t\"fmt\"\\n\\t\"strings\"\\n\\t\"time\"'\n41|\n42|# Each mutant: (name, kind, file, edits|add-path+content, command, bound).\n43|# kind edit: [(old, new)] applied to file, each anchored exactly once.\n44|# kind add: writes path with content for the run, then removes it.\n45|MUTANTS = [\n46|    (\"N-op\", \"edit\", \"internal/fencing/gate.go\",\n47|     [(\"case OperationActivation, OperationInput, OperationMutation, OperationCheckpoint, OperationRestore:\",\n48|        'case OperationActivation, OperationInput, OperationMutation, OperationCheckpoint, OperationRestore, \"bogus\":')],\n49|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesUnknownOperation$\", \"-count=1\", \"-v\"],\n50|     \"Admit exactly the bogus operation past the enum; the token authorizes and the negative fails by success.\"),\n51|    (\"N-presented-session\", \"edit\", \"internal/fencing/gate.go\",\n52|     [(\"if _, err := scalar.ParseUUIDv7(presented.SessionID); err != nil {\",\n53|        'if _, err := scalar.ParseUUIDv7(presented.SessionID); err != nil && presented.SessionID != \"not-a-uuid\" {')],\n54|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesMalformedPresented$\", \"-count=1\", \"-v\"],\n55|     \"Admit exactly the not-a-uuid session; the refusal degrades to the foreign-session class.\"),\n56|    (\"N-presented-epoch\", \"edit\", \"internal/fencing/gate.go\",\n57|     [(\"if presented.Epoch == 0 {\",\n58|        'if presented.Epoch == 0 && presented.LeaseID != \"' + LEASEA + '\" {')],\n59|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesMalformedPresented$\", \"-count=1\", \"-v\"],\n60|     \"Admit exactly the epoch-zero winner-lease vector; the refusal degrades to the stale class.\"),\n61|    (\"N-presented-lease\", \"edit\", \"internal/fencing/gate.go\",\n62|     [(\"if _, err := scalar.ParseUUIDv4(presented.LeaseID); err != nil {\",\n63|        'if _, err := scalar.ParseUUIDv4(presented.LeaseID); err != nil && presented.LeaseID != \"zzz\" {')],\n64|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesMalformedPresented$\", \"-count=1\", \"-v\"],\n65|     \"Admit exactly the zzz token lease; the refusal degrades to the loser class.\"),\n66|    (\"N-winner\", \"edit\", \"internal/fencing/gate.go\",\n67|     [(\"if observation.Winner.Epoch == 0 || !validLeaseID(observation.Winner.LeaseID) || !validHostID(observation.Winner.HolderHostID) {\",\n68|        'if (observation.Winner.Epoch == 0 || !validLeaseID(observation.Winner.LeaseID) || !validHostID(observation.Winner.HolderHostID)) && !(observation.Winner.Epoch == 0 && observation.Winner.LeaseID == \"zzz\") {')],\n69|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesGarbageWinner$\", \"-count=1\", \"-v\"],\n70|     \"Admit exactly the epoch-zero zzz winner; the refusal degrades to the ahead class.\"),\n71|    (\"N-session-prefix\", \"edit\", \"internal/fencing/gate.go\",\n72|     [(GATE_IMPORT, GATE_IMPORT_STRINGS),\n73|      (\"if presented.SessionID != observation.SessionID {\",\n74|        'if strings.SplitN(presented.SessionID, \"-\", 2)[0] != strings.SplitN(observation.SessionID, \"-\", 2)[0] {')],\n75|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesForeignSession$\", \"-count=1\", \"-v\"],\n76|     \"Compare first UUID segments only; the prefix-sharing session authorizes while the fully foreign session still refuses.\"),\n77|    (\"N-absent\", \"edit\", \"internal/fencing/gate.go\",\n78|     [(\"if !observation.HasWinner {\",\n79|        \"if !observation.HasWinner && !observation.Verified {\")],\n80|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeParksAndRefusesAbsentWinner$\", \"-count=1\", \"-v\"],\n81|     \"Admit exactly the verified absence; the refusal degrades to the malformed-observation class.\"),\n82|    (\"N-verified\", \"edit\", \"internal/fencing/gate.go\",\n83|     [(\"if !observation.Verified {\",\n84|        \"if !observation.Verified && observation.Ambiguous {\")],\n85|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeParksAndRefusesUnverified$\", \"-count=1\", \"-v\"],\n86|     \"Admit exactly the unambiguous unverified observation; the token authorizes and the negative fails by success.\"),\n87|    (\"N-ambiguous\", \"edit\", \"internal/fencing/gate.go\",\n88|     [(\"if observation.Ambiguous {\",\n89|        \"if observation.Ambiguous && !observation.Verified {\")],\n90|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeParksAndRefusesAmbiguous$\", \"-count=1\", \"-v\"],\n91|     \"Admit exactly the verified ambiguity; the token authorizes and the negative fails by success.\"),\n92|    (\"N-handoff\", \"edit\", \"internal/fencing/gate.go\",\n93|     [(\"if observation.HandoffFailed {\",\n94|        \"if observation.HandoffFailed && !observation.Verified {\")],\n95|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeParksAndRefusesFailedHandoff$\", \"-count=1\", \"-v\"],\n96|     \"Admit exactly the verified failed handoff; the token authorizes and the negative fails by success.\"),\n97|    (\"N-grant\", \"edit\", \"internal/fencing/gate.go\",\n98|     [(\"if !observation.HasGrant {\",\n99|        \"if !observation.HasGrant && !observation.Verified {\")],\n100|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesMissingGrant$\", \"-count=1\", \"-v\"],\n101|     \"Admit exactly the verified grantless call; the refusal degrades to the lapsed-grant class.\"),\n102|    (\"N-clock\", \"edit\", \"internal/fencing/gate.go\",\n103|     [(\"if observation.Now.IsZero() {\",\n104|        \"if observation.Now.IsZero() && !observation.Grant.ValidatedAt.IsZero() {\")],\n105|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesMissingClock$\", \"-count=1\", \"-v\"],\n106|     \"Admit exactly the clockless never-validated grant; the token authorizes and the negative fails by success.\"),\n107|    (\"N-expiry\", \"edit\", \"internal/fencing/gate.go\",\n108|     [(\"sessrepo.CheckFencingExpiry(observation.Grant, observation.Policy, observation.Now)\",\n109|        \"sessrepo.CheckFencingExpiry(observation.Grant, sessrepo.FencingPolicy{RefreshInterval: observation.Policy.RefreshInterval + time.Hour}, observation.Now)\")],\n110|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesExpiredGrant$\", \"-count=1\", \"-v\"],\n111|     \"Extend the refresh interval by an hour; the lapsed-by-seconds grant authorizes while the never-validated grant still refuses.\"),\n112|    (\"N-expiry-map\", \"edit\", \"internal/fencing/gate.go\",\n113|     [(\"if errors.Is(err, sessrepo.ErrFencingExpired) {\",\n114|        \"if errors.Is(err, sessrepo.ErrInvalidLease) {\")],\n115|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesExpiredGrant$\", \"-count=1\", \"-v\"],\n116|     \"Swap the lapsed/unusable classes; both vectors change class and the test fails.\"),\n117|    (\"N-remote-prefix\", \"edit\", \"internal/fencing/gate.go\",\n118|     [(GATE_IMPORT, GATE_IMPORT_STRINGS),\n119|      (\"if observation.Winner.HolderHostID != observation.LocalHostID {\",\n120|        'if strings.SplitN(observation.Winner.HolderHostID, \"-\", 2)[0] != strings.SplitN(observation.LocalHostID, \"-\", 2)[0] {')],\n121|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeParksAndRefusesRemote$\", \"-count=1\", \"-v\"],\n122|     \"Compare first UUID segments only; the prefix-sharing remote holder authorizes while the fully remote holder still refuses.\"),\n123|    (\"N-epoch-gte\", \"edit\", \"internal/fencing/gate.go\",\n124|     [(\"epochsEqual := presented.Epoch == observation.Winner.Epoch\",\n125|        \"epochsEqual := presented.Epoch >= observation.Winner.Epoch\")],\n126|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesEpochBeyondWinner$|^TestAuthorizeRefusesLowerEpoch$\", \"-count=1\", \"-v\"],\n127|     \"Admit exactly the ahead epoch past the epoch arm; the lower-epoch vectors still refuse stale in the same run.\"),\n128|    (\"N-epoch-lte\", \"edit\", \"internal/fencing/gate.go\",\n129|     [(\"epochsEqual := presented.Epoch == observation.Winner.Epoch\",\n130|        \"epochsEqual := presented.Epoch <= observation.Winner.Epoch\")],\n131|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesEpochBeyondWinner$|^TestAuthorizeRefusesLowerEpoch$\", \"-count=1\", \"-v\"],\n132|     \"Admit exactly the lower epoch past the epoch arm; the ahead-epoch vectors still refuse in the same run.\"),\n133|    (\"N-lease-vector\", \"edit\", \"internal/fencing/gate.go\",\n134|     [(\"if presented.LeaseID != observation.Winner.LeaseID {\",\n135|        'if presented.LeaseID != observation.Winner.LeaseID && presented.LeaseID != \"' + LEASEC + '\" {')],\n136|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesSameEpochLoser$\", \"-count=1\", \"-v\"],\n137|     \"Admit exactly the standard loser; the prefix-sharing loser still refuses.\"),\n138|    (\"N-lease-prefix\", \"edit\", \"internal/fencing/gate.go\",\n139|     [(GATE_IMPORT, GATE_IMPORT_STRINGS),\n140|      (\"if presented.LeaseID != observation.Winner.LeaseID {\",\n141|        'if strings.SplitN(presented.LeaseID, \"-\", 2)[0] != strings.SplitN(observation.Winner.LeaseID, \"-\", 2)[0] {')],\n142|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesSameEpochLoser$\", \"-count=1\", \"-v\"],\n143|     \"Compare first UUID segments only; the prefix-sharing loser authorizes while the standard loser still refuses.\"),\n144|    (\"N-launch-add-input\", \"edit\", \"internal/fencing/gate.go\",\n145|     [(\"return op == OperationActivation || op == OperationRestore\",\n146|        \"return op == OperationActivation || op == OperationRestore || op == OperationInput\")],\n147|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeParksAndRefusesRemote$\", \"-count=1\", \"-v\"],\n148|     \"Park input instead of refusing: the remote input vector parks and the hard-refusal assertion fails.\"),\n149|    (\"N-launch-drop-restore\", \"edit\", \"internal/fencing/gate.go\",\n150|     [(\"return op == OperationActivation || op == OperationRestore\",\n151|        \"return op == OperationActivation\")],\n152|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeParksAndRefusesRemote$\", \"-count=1\", \"-v\"],\n153|     \"Refuse restore instead of parking: the remote restore vector refuses hard and the park assertion fails.\"),\n154|    (\"N-bind-seal\", \"edit\", \"internal/fencing/token.go\",\n155|     [(\"if token.seal == nil || token.seal.token == nil {\",\n156|        \"if token.seal == nil {\")],\n157|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestBindRefusesForgedToken$\", \"-count=1\", \"-v\"],\n158|     \"Admit exactly the field-assembled seal; the zero token still refuses.\"),\n159|    (\"N-bind-op\", \"edit\", \"internal/fencing/token.go\",\n160|     [(\"case ProviderQuiesce, ProviderCapture, ProviderMaterialize:\",\n161|        'case ProviderQuiesce, ProviderCapture, ProviderMaterialize, \"bogus\":')],\n162|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestBindRefusesUnknownOperation$\", \"-count=1\", \"-v\"],\n163|     \"Admit exactly the bogus provider operation; the projection mints and the negative fails by success.\"),\n164|    (\"N-term-presented\", \"edit\", \"internal/fencing/terminate.go\",\n165|     [(\"if _, err := scalar.ParseUUIDv4(presented.LeaseID); err != nil {\",\n166|        'if _, err := scalar.ParseUUIDv4(presented.LeaseID); err != nil && presented.LeaseID != \"zzz\" {')],\n167|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestTerminateStaleRefusesMalformedTarget$\", \"-count=1\", \"-v\"],\n168|     \"Admit exactly the zzz target lease; the termination authorizes and the negative fails by success.\"),\n169|    (\"N-term-winner\", \"edit\", \"internal/fencing/terminate.go\",\n170|     [(\"if winner.Epoch == 0 || !validLeaseID(winner.LeaseID) {\",\n171|        'if (winner.Epoch == 0 || !validLeaseID(winner.LeaseID)) && !(winner.Epoch == 0 && winner.LeaseID == \"zzz\") {')],\n172|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestTerminateStaleRefusesGarbageWinner$\", \"-count=1\", \"-v\"],\n173|     \"Admit exactly the epoch-zero zzz winner; the termination authorizes and the negative fails by success.\"),\n174|    (\"N-term-absent\", \"edit\", \"internal/fencing/terminate.go\",\n175|     [(\"if !hasWinner {\",\n176|        \"if !hasWinner && !forceRecovery {\")],\n177|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestTerminateStaleRefusesWithoutWinner$\", \"-count=1\", \"-v\"],\n178|     \"Admit exactly the forced winnerless call; the refusal degrades to the malformed-observation class.\"),\n179|    (\"N-term-force\", \"edit\", \"internal/fencing/terminate.go\",\n180|     [(\"if !forceRecovery {\",\n181|        \"if !forceRecovery && !diagnosticsPreserved {\")],\n182|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestTerminateStaleRefusesWithoutForce$\", \"-count=1\", \"-v\"],\n183|     \"Admit exactly the unforced diagnosed call; the termination authorizes and the negative fails by success.\"),\n184|    (\"N-term-diag\", \"edit\", \"internal/fencing/terminate.go\",\n185|     [(\"if !diagnosticsPreserved {\",\n186|        \"if !diagnosticsPreserved && !forceRecovery {\")],\n187|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestTerminateStaleRefusesWithoutDiagnostics$\", \"-count=1\", \"-v\"],\n188|     \"Admit exactly the undiagnosed forced call; the termination authorizes and the negative fails by success.\"),\n189|    (\"N-term-session\", \"edit\", \"internal/fencing/terminate.go\",\n190|     [(\"if presented.SessionID != winner.SessionID {\",\n191|        'if presented.SessionID != winner.SessionID && presented.SessionID != \"' + SESSIONB + '\" {')],\n192|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestTerminateStaleRefusesForeignSession$\", \"-count=1\", \"-v\"],\n193|     \"Admit exactly the prefix-sharing foreign target; the refusal degrades to the live-owner class.\"),\n194|    (\"N-term-live\", \"edit\", \"internal/fencing/terminate.go\",\n195|     [(\"if presented.Epoch == winner.Epoch && presented.LeaseID == winner.LeaseID {\",\n196|        \"if presented.Epoch == winner.Epoch && presented.LeaseID == winner.LeaseID && winner.Epoch != 1 {\")],\n197|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestTerminateStaleRefusesLiveOwner$\", \"-count=1\", \"-v\"],\n198|     \"Admit exactly the epoch-1 live owner; the epoch-2 owner still refuses.\"),\n199|    (\"T-census-alias\", \"add\", \"internal/fencing/zzplant.go\",\n200|     \"package fencing\\n\\ntype plantBackdoor = leaseSeal\\n\\nfunc plantAlias() LeaseToken { return LeaseToken{seal: &plantBackdoor{}} }\\n\",\n201|     [\"go\", \"test\", \"./internal/fencing\", \"-count=1\", \"-v\"],\n202|     \"Preserve the leaseSeal token while constructing through an alias; the census rejects the plant and the full behavioral suite runs.\"),\n203|    (\"C-harmless-comment\", \"edit\", \"internal/fencing/gate.go\",\n204|     [(\"// Arm order is precedence: malformed calls die first, then foreign\",\n205|        \"// Arm order is precedence: malformed calls die first, then foreign\\n// classifier control: comment only, no behavior change.\")],\n206|     [\"go\", \"test\", \"./internal/fencing\", \"-count=1\"],\n207|     \"Applied control: a behavior-preserving plant survives through the same instrument.\"),\n208|    (\"C-not-applied\", \"edit\", \"internal/fencing/gate.go\",\n209|     [(\"TOKEN_THAT_IS_NOT_PRESENT\", \"replacement\")],\n210|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeAdmitsWinnerExactEpochAllOperations$\", \"-count=1\", \"-v\"],\n211|     \"Application control: missing patch is not a killed mutant.\"),\n212|    (\"C-compile-failure\", \"edit\", \"internal/fencing/gate.go\",\n213|     [(\"package fencing\", \"package fencing\\nthis is invalid Go\")],\n214|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeAdmitsWinnerExactEpochAllOperations$\", \"-count=1\", \"-v\"],\n215|     \"Compilation control: no named failed behavioral test is not a kill.\"),\n216|]\n217|\n218|selected = [row for row in MUTANTS if name_filter in row[0]] if name_filter else MUTANTS\n219|if name_filter and not selected:\n220|    raise SystemExit(f\"no mutants match filter {name_filter!r}\")\n221|\n222|\n223|def run_command(label, command, log_name):\n224|    with (output / log_name).open(\"w\") as log:\n225|        process = subprocess.run(command, cwd=copy, stdout=log, stderr=subprocess.STDOUT, timeout=300)\n226|    return process.returncode\n227|\n228|\n229|with (output / f\"control-before-{tag}.log\").open(\"w\") as log:\n230|    before = subprocess.run([\"go\", \"test\", \"./internal/fencing\", \"-count=1\"], cwd=copy, stdout=log, stderr=subprocess.STDOUT, timeout=300)\n231|results.append(dict(mutant=f\"control-before-{tag}\", classification=\"CONTROL\", exit=before.returncode))\n232|if before.returncode:\n233|    raise SystemExit(\"baseline failed\")\n234|\n235|\n236|def classify(name, command, bound):\n237|    try:\n238|        with (output / (name + \".log\")).open(\"w\") as log:\n239|            process = subprocess.run(command, cwd=copy, stdout=log, stderr=subprocess.STDOUT, timeout=300)\n240|        text = (output / (name + \".log\")).read_text()\n241|        failures = re.findall(r\"^\\s*--- FAIL: ([^ ]+)\", text, re.M)\n242|        ran_tests = re.findall(r\"^=== RUN \", text, re.M)\n243|        # Non-verbose full-suite runs report failures as \"^--- FAIL:\" and\n244|        # \"FAIL\\tpackage\" lines without === RUN markers; accept either.\n245|        if not ran_tests:\n246|            ran_tests = re.findall(r\"^(ok|FAIL)\\s\", text, re.M)\n247|        classification = \"COMPILE_OR_HARNESS_FAILURE\" if not ran_tests else (\"SURVIVED\" if process.returncode == 0 else (\"KILLED\" if failures else \"COMPILE_OR_HARNESS_FAILURE\"))\n248|        results.append(dict(mutant=name, classification=classification, exit=process.returncode, failed_tests=failures, bound=bound, command=command))\n249|        print(name, classification, process.returncode, \", \".join(failures), flush=True)\n250|    except subprocess.TimeoutExpired:\n251|        results.append(dict(mutant=name, classification=\"TIMEOUT\", bound=bound, command=command))\n252|        print(name, \"TIMEOUT\", flush=True)\n253|\n254|\n255|def run_edit(name, path, edits, command, bound):\n256|    source = copy / path\n257|    original = source.read_text()\n258|    for old, _ in edits:\n259|        if original.count(old) != 1:\n260|            results.append(dict(mutant=name, classification=\"NOT_APPLIED\", count=original.count(old), bound=bound))\n261|            print(name, \"NOT_APPLIED\", original.count(old), flush=True)\n262|            return\n263|    changed = original\n264|    for old, new in edits:\n265|        changed = changed.replace(old, new)\n266|    source.write_text(changed)\n267|    try:\n268|        classify(name, command, bound)\n269|    finally:\n270|        source.write_text(original)\n271|        assert hashlib.sha256(source.read_bytes()).digest() == hashlib.sha256(original.encode()).digest()\n272|\n273|\n274|def run_add(name, path, content, command, bound):\n275|    target = copy / path\n276|    if target.exists():\n277|        results.append(dict(mutant=name, classification=\"NOT_APPLIED\", count=-1, bound=bound))\n278|        print(name, \"NOT_APPLIED exists\", flush=True)\n279|        return\n280|    target.write_text(content)\n281|    try:\n282|        classify(name, command, bound)\n283|    finally:\n284|        target.unlink(missing_ok=True)\n285|        assert not target.exists()\n286|\n287|\n288|for name, kind, path, payload, command, bound in selected:\n289|    if kind == \"edit\":\n290|        run_edit(name, path, payload, command, bound)\n291|    else:\n292|        run_add(name, path, payload, command, bound)\n293|\n294|with (output / f\"control-after-{tag}.log\").open(\"w\") as log:\n295|    after = subprocess.run([\"go\", \"test\", \"./internal/fencing\", \"-count=1\"], cwd=copy, stdout=log, stderr=subprocess.STDOUT, timeout=300)\n296|results.append(dict(mutant=f\"control-after-{tag}\", classification=\"CONTROL\", exit=after.returncode))\n297|(output / f\"mutants-{tag}.json\").write_text(json.dumps(results, indent=2) + \"\\n\")\n298|bad = [row for row in results if (row[\"mutant\"].startswith(\"N-\") or row[\"mutant\"].startswith(\"T-\")) and row[\"classification\"] != \"KILLED\"]\n299|raise SystemExit(1 if bad or after.returncode else 0)","final_result":true}}}
