{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c707","stream":{"kind":"session","id":"01a0ae0f-ee07-7b81-b4d4-cf94ccb5debd"},"sequence":478,"recorded_at":1780531400000951,"record_type":"event","durability":"durable","causation_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","run_stream":{"kind":"run","id":"b7392d99-bbd5-4114-ba32-61509405cfc4"},"call_id":"call_01a0ae10b25a77ff8f7a21bca0962333","text":"Read text file `internal/fencing/gate_test.go`.\n(119 line(s) above)\n120|\t\t\t})\n121|\t\t}\n122|\t}\n123|}\n124|\n125|// TestAuthorizeParksAndRefusesUnverified drives the unverified-sync\n126|// row: without a mesh lease refresh proving current knowledge,\n127|// launch entries park with restore_policy under the winner, while\n128|// the other entries refuse lease_conflict.\n129|func TestAuthorizeParksAndRefusesUnverified(t *testing.T) {\n130|\tvectors := map[string]bool{\"unambiguous\": false, \"ambiguous\": true}\n131|\tfor name, entry := range fenceEntries() {\n132|\t\tfor vector, ambiguous := range vectors {\n133|\t\t\tt.Run(name+\"/\"+vector, func(t *testing.T) {\n134|\t\t\t\tobservation := fenceObservation()\n135|\t\t\t\tobservation.Verified = false\n136|\t\t\t\tobservation.Ambiguous = ambiguous\n137|\t\t\t\t_, err := entry.authorize(fencePresented(), observation)\n138|\t\t\t\tif entry.launch {\n139|\t\t\t\t\tmustPark(t, err, ParkRestorePolicy, fenceLeaseA, ErrLeaseConflict, name+\"/\"+vector)\n140|\t\t\t\t} else {\n141|\t\t\t\t\tmustRefuse(t, err, ErrLeaseConflict, name+\"/\"+vector)\n142|\t\t\t\t}\n143|\t\t\t})\n144|\t\t}\n145|\t}\n146|}\n147|\n148|// TestAuthorizeParksAndRefusesAmbiguous drives the ambiguous-ownership\n149|// row: conflicting union observations park or refuse exactly like\n150|// unverified sync, naming the winner the park stands under.\n151|func TestAuthorizeParksAndRefusesAmbiguous(t *testing.T) {\n152|\tvectors := map[string]bool{\"verified\": true, \"unverified\": false}\n153|\tfor name, entry := range fenceEntries() {\n154|\t\tfor vector, verified := range vectors {\n155|\t\t\tt.Run(name+\"/\"+vector, func(t *testing.T) {\n156|\t\t\t\tobservation := fenceObservation()\n157|\t\t\t\tobservation.Ambiguous = true\n158|\t\t\t\tobservation.Verified = verified\n159|\t\t\t\t_, err := entry.authorize(fencePresented(), observation)\n160|\t\t\t\tif entry.launch {\n161|\t\t\t\t\tmustPark(t, err, ParkRestorePolicy, fenceLeaseA, ErrLeaseConflict, name+\"/\"+vector)\n162|\t\t\t\t} else {\n163|\t\t\t\t\tmustRefuse(t, err, ErrLeaseConflict, name+\"/\"+vector)\n164|\t\t\t\t}\n165|\t\t\t})\n166|\t\t}\n167|\t}\n168|}\n169|\n170|// TestAuthorizeParksAndRefusesFailedHandoff drives the failed-handoff\n171|// row: a caller whose own handoff already failed parks with\n172|// failed_handoff on launch entries instead of activating its losing\n173|// lease, and refuses lease_conflict elsewhere. The unverified vector\n174|// dies at the earlier verifiability arm instead, pinning the\n175|// precedence.\n176|func TestAuthorizeParksAndRefusesFailedHandoff(t *testing.T) {\n177|\tfor name, entry := range fenceEntries() {\n178|\t\tt.Run(name+\"/verified\", func(t *testing.T) {\n179|\t\t\tobservation := fenceObservation()\n180|\t\t\tobservation.HandoffFailed = true\n181|\t\t\t_, err := entry.authorize(fencePresented(), observation)\n182|\t\t\tif entry.launch {\n183|\t\t\t\tmustPark(t, err, ParkFailedHandoff, fenceLeaseA, ErrLeaseConflict, name+\"/verified\")\n184|\t\t\t} else {\n185|\t\t\t\tmustRefuse(t, err, ErrLeaseConflict, name+\"/verified\")\n186|\t\t\t}\n187|\t\t})\n188|\t\tt.Run(name+\"/unverified\", func(t *testing.T) {\n189|\t\t\tobservation := fenceObservation()\n190|\t\t\tobservation.HandoffFailed = true\n191|\t\t\tobservation.Verified = false\n192|\t\t\t_, err := entry.authorize(fencePresented(), observation)\n193|\t\t\tif entry.launch {\n194|\t\t\t\tmustPark(t, err, ParkRestorePolicy, fenceLeaseA, ErrLeaseConflict, name+\"/unverified\")\n195|\t\t\t} else {\n196|\t\t\t\tmustRefuse(t, err, ErrLeaseConflict, name+\"/unverified\")\n197|\t\t\t}\n198|\t\t})\n199|\t}\n200|}\n201|\n202|// TestAuthorizeRefusesMissingGrant proves a gate call without the\n203|// process-local fencing grant is malformed: the caller validates the\n204|// winning token first. The unverified vector dies at the earlier\n205|// verifiability arm instead, pinning the precedence.\n206|func TestAuthorizeRefusesMissingGrant(t *testing.T) {\n207|\tfor name, entry := range fenceEntries() {\n208|\t\tt.Run(name+\"/verified\", func(t *testing.T) {\n209|\t\t\tobservation := fenceObservation()\n210|\t\t\tobservation.HasGrant = false\n211|\t\t\tobservation.Grant = sessrepo.FencingGrant{}\n212|\t\t\t_, err := entry.authorize(fencePresented(), observation)\n213|\t\t\tmustRefuse(t, err, ErrInvalidArguments, name+\"/verified\")\n214|\t\t})\n215|\t\tt.Run(name+\"/unverified\", func(t *testing.T) {\n216|\t\t\tobservation := fenceObservation()\n217|\t\t\tobservation.HasGrant = false\n218|\t\t\tobservation.Grant = sessrepo.FencingGrant{}\n219|\t\t\tobservation.Verified = false\n220|\t\t\t_, err := entry.authorize(fencePresented(), observation)\n221|\t\t\tif entry.launch {\n222|\t\t\t\tmustPark(t, err, ParkRestorePolicy, fenceLeaseA, ErrLeaseConflict, name+\"/unverified\")\n223|\t\t\t} else {\n224|\t\t\t\tmustRefuse(t, err, ErrLeaseConflict, name+\"/unverified\")\n225|\t\t\t}\n226|\t\t})\n227|\t}\n228|}\n229|\n230|// TestAuthorizeRefusesMissingClock proves expiry cannot be bypassed\n231|// with a missing clock reading: a grant without Now refuses\n232|// invalid_arguments instead of reading as fresh.\n233|func TestAuthorizeRefusesMissingClock(t *testing.T) {\n234|\tvectors := map[string]time.Time{\n235|\t\t\"zero_validated\": {},\n236|\t\t\"set_validated\":  fenceValidatedAt,\n237|\t}\n238|\tfor name, entry := range fenceEntries() {\n239|\t\tfor vector, validated := range vectors {\n240|\t\t\tt.Run(name+\"/\"+vector, func(t *testing.T) {\n241|\t\t\t\tobservation := fenceObservation()\n242|\t\t\t\tobservation.Now = time.Time{}\n243|\t\t\t\tobservation.Grant.ValidatedAt = validated\n244|\t\t\t\t_, err := entry.authorize(fencePresented(), observation)\n245|\t\t\t\tmustRefuse(t, err, ErrInvalidArguments, name+\"/\"+vector)\n246|\t\t\t})\n247|\t\t}\n248|\t}\n249|}\n250|\n251|// TestAuthorizeRefusesExpiredGrant drives the expired-grant row\n252|// through the sessrepo expiry owner: a lapsed grant refuses\n253|// lease_conflict on every entry so the holder revalidates, a grant\n254|// validated exactly at the interval boundary is still current, and\n255|// an unusable refresh policy refuses invalid_arguments.\n256|func TestAuthorizeRefusesExpiredGrant(t *testing.T) {\n257|\tt.Run(\"lapsed\", func(t *testing.T) {\n258|\t\tfor name, entry := range fenceEntries() {\n259|\t\t\tt.Run(name, func(t *testing.T) {\n260|\t\t\t\tobservation := fenceObservation()\n261|\t\t\t\tobservation.Now = fenceValidatedAt.Add(time.Minute + time.Second)\n262|\t\t\t\t_, err := entry.authorize(fencePresented(), observation)\n263|\t\t\t\tmustRefuse(t, err, ErrLeaseConflict, name+\"/lapsed\")\n264|\t\t\t})\n265|\t\t}\n266|\t})\n267|\tt.Run(\"never_validated\", func(t *testing.T) {\n268|\t\tfor name, entry := range fenceEntries() {\n269|\t\t\tt.Run(name, func(t *testing.T) {\n270|\t\t\t\tobservation := fenceObservation()\n271|\t\t\t\tobservation.Grant.ValidatedAt = time.Time{}\n272|\t\t\t\t_, err := entry.authorize(fencePresented(), observation)\n273|\t\t\t\tmustRefuse(t, err, ErrLeaseConflict, name+\"/never_validated\")\n274|\t\t\t})\n275|\t\t}\n276|\t})\n277|\tt.Run(\"boundary_fresh\", func(t *testing.T) {\n278|\t\tfor name, entry := range fenceEntries() {\n279|\t\t\tt.Run(name, func(t *testing.T) {\n280|\t\t\t\tobservation := fenceObservation()\n281|\t\t\t\tobservation.Now = fenceValidatedAt.Add(time.Minute)\n282|\t\t\t\ttoken, err := entry.authorize(fencePresented(), observation)\n283|\t\t\t\tmustMint(t, token, err, name+\"/boundary_fresh\")\n284|\t\t\t})\n285|\t\t}\n286|\t})\n287|\tt.Run(\"zero_policy\", func(t *testing.T) {\n288|\t\tfor name, entry := range fenceEntries() {\n289|\t\t\tt.Run(name, func(t *testing.T) {\n290|\t\t\t\tobservation := fenceObservation()\n291|\t\t\t\tobservation.Policy = sessrepo.FencingPolicy{}\n292|\t\t\t\t_, err := entry.authorize(fencePresented(), observation)\n293|\t\t\t\tmustRefuse(t, err, ErrInvalidArguments, name+\"/zero_policy\")\n294|\t\t\t})\n295|\t\t}\n296|\t})\n297|}\n298|\n299|// TestAuthorizeParksAndRefusesRemote drives the remote-ownership row:\n300|// when the winning holder is not local, launch entries park with\n301|// remote_owner under the winner, while the other entries refuse\n302|// not_owner. Host B shares the first UUID segment with the local\n303|// host (the vector the prefix mutant admits); host C shares nothing.\n304|func TestAuthorizeParksAndRefusesRemote(t *testing.T) {\n305|\tvectors := map[string]string{\"prefix_sharing\": fenceHostB, \"fully_remote\": fenceHostC}\n306|\tfor name, entry := range fenceEntries() {\n307|\t\tfor vector, holder := range vectors {\n308|\t\t\tt.Run(name+\"/\"+vector, func(t *testing.T) {\n309|\t\t\t\tobservation := fenceObservation()\n310|\t\t\t\tobservation.Winner.HolderHostID = holder\n311|\t\t\t\t_, err := entry.authorize(fencePresented(), observation)\n312|\t\t\t\tif entry.launch {\n313|\t\t\t\t\tmustPark(t, err, ParkRemoteOwner, fenceLeaseA, ErrNotOwner, name+\"/\"+vector)\n314|\t\t\t\t} else {\n315|\t\t\t\t\tmustRefuse(t, err, ErrNotOwner, name+\"/\"+vector)\n316|\t\t\t\t}\n317|\t\t\t})\n318|\t\t}\n319|\t}\n320|}\n321|\n322|// TestAuthorizeRefusesLowerEpoch drives the lower-epoch row: a token\n323|// from a superseded epoch refuses stale_owner on input, mutation,\n324|// and checkpoint, and parks with stale_owner on launch entries. The\n325|// exact-lease vector carries the winning lease at the lower epoch\n326|// (which the weakened epoch gate would mint); the standard vector\n327|// carries the old superseded lease.\n328|func TestAuthorizeRefusesLowerEpoch(t *testing.T) {\n329|\tvectors := map[string]PresentedToken{\n330|\t\t\"standard\":    {SessionID: fenceSessionA, Epoch: 1, LeaseID: fenceLeaseOld},\n331|\t\t\"exact_lease\": {SessionID: fenceSessionA, Epoch: 1, LeaseID: fenceLeaseA},\n332|\t}\n333|\tfor name, entry := range fenceEntries() {\n334|\t\tfor vector, presented := range vectors {\n335|\t\t\tt.Run(name+\"/\"+vector, func(t *testing.T) {\n336|\t\t\t\t_, err := entry.authorize(presented, fenceObservation())\n337|\t\t\t\tif entry.launch {\n338|\t\t\t\t\tmustPark(t, err, ParkStaleOwner, fenceLeaseA, ErrStaleOwner, name+\"/\"+vector)\n339|\t\t\t\t} else {\n340|\t\t\t\t\tmustRefuse(t, err, ErrStaleOwner, name+\"/\"+vector)\n341|\t\t\t\t}\n342|\t\t\t})\n343|\t\t}\n344|\t}\n345|}\n346|\n347|// TestAuthorizeRefusesEpochBeyondWinner drives the epoch-ahead row: a\n348|// token from an epoch beyond the winner names no known lease. Launch\n349|// entries park with restore_policy because the future token is\n350|// unverifiable; the other entries refuse lease_conflict.\n351|func TestAuthorizeRefusesEpochBeyondWinner(t *testing.T) {\n352|\tvectors := map[string]PresentedToken{\n353|\t\t\"exact_lease\": {SessionID: fenceSessionA, Epoch: 9, LeaseID: fenceLeaseA},\n354|\t\t\"other_lease\": {SessionID: fenceSessionA, Epoch: 9, LeaseID: fenceLeaseC},\n355|\t}\n356|\tfor name, entry := range fenceEntries() {\n357|\t\tfor vector, presented := range vectors {\n358|\t\t\tt.Run(name+\"/\"+vector, func(t *testing.T) {\n359|\t\t\t\t_, err := entry.authorize(presented, fenceObservation())\n360|\t\t\t\tif entry.launch {\n361|\t\t\t\t\tmustPark(t, err, ParkRestorePolicy, fenceLeaseA, ErrLeaseConflict, name+\"/\"+vector)\n362|\t\t\t\t} else {\n363|\t\t\t\t\tmustRefuse(t, err, ErrLeaseConflict, name+\"/\"+vector)\n364|\t\t\t\t}\n365|\t\t\t})\n366|\t\t}\n367|\t}\n368|}\n369|\n370|// TestAuthorizeRefusesSameEpochLoser drives the same-epoch-loser row:\n371|// a token that loses the lease tie at the winning epoch refuses\n372|// lease_conflict on input, mutation, and checkpoint, and parks with\n373|// stale_owner on launch entries. Lease C2 shares the first UUID\n374|// segment with the winner (the vector the prefix mutant admits);\n375|// lease C shares nothing (the vector the carve-out mutant admits).\n376|func TestAuthorizeRefusesSameEpochLoser(t *testing.T) {\n377|\tvectors := map[string]string{\"standard\": fenceLeaseC, \"prefix_sharing\": fenceLeaseC2}\n378|\tfor name, entry := range fenceEntries() {\n379|\t\tfor vector, lease := range vectors {\n380|\t\t\tt.Run(name+\"/\"+vector, func(t *testing.T) {\n381|\t\t\t\tpresented := fencePresented()\n382|\t\t\t\tpresented.LeaseID = lease\n383|\t\t\t\t_, err := entry.authorize(presented, fenceObservation())\n384|\t\t\t\tif entry.launch {\n385|\t\t\t\t\tmustPark(t, err, ParkStaleOwner, fenceLeaseA, ErrLeaseConflict, name+\"/\"+vector)\n386|\t\t\t\t} else {\n387|\t\t\t\t\tmustRefuse(t, err, ErrLeaseConflict, name+\"/\"+vector)\n388|\t\t\t\t}\n389|\t\t\t})\n390|\t\t}\n391|\t}\n392|}\n393|\n394|// TestAuthorizePrecedence pins the arm order where two arms could\n395|// fire: the operative ownership fact beats the presented credential,\n396|// and malformed calls die before any ownership question is asked.\n397|func TestAuthorizePrecedence(t *testing.T) {\n398|\tstale := PresentedToken{SessionID: fenceSessionA, Epoch: 1, LeaseID: fenceLeaseOld}\n399|\tt.Run(\"direction_beats_credential\", func(t *testing.T) {\n400|\t\tobservation := fenceObservation()\n401|\t\tobservation.Winner.HolderHostID = fenceHostC\n402|\t\t_, err := AuthorizeActivation(stale, observation)\n403|\t\tmustPark(t, err, ParkRemoteOwner, fenceLeaseA, ErrNotOwner, \"activation/direction_beats_credential\")\n404|\t\t_, err = AuthorizeMutation(stale, observation)\n405|\t\tmustRefuse(t, err, ErrNotOwner, \"mutation/direction_beats_credential\")\n406|\t})\n407|\tt.Run(\"verifiability_beats_credential\", func(t *testing.T) {\n408|\t\tobservation := fenceObservation()\n409|\t\tobservation.Verified = false\n410|\t\t_, err := AuthorizeRestore(stale, observation)\n411|\t\tmustPark(t, err, ParkRestorePolicy, fenceLeaseA, ErrLeaseConflict, \"restore/verifiability_beats_credential\")\n412|\t\t_, err = AuthorizeInput(stale, observation)\n413|\t\tmustRefuse(t, err, ErrLeaseConflict, \"input/verifiability_beats_credential\")\n414|\t})\n415|\tt.Run(\"grammar_beats_ownership\", func(t *testing.T) {\n416|\t\tobservation := fenceObservation()\n417|\t\tobservation.Winner.HolderHostID = fenceHostC\n418|\t\tmalformed := PresentedToken{SessionID: \"not-a-uuid\", Epoch: 2, LeaseID: fenceLeaseA}\n419|\t\t_, err := AuthorizeActivation(malformed, observation)\n420|\t\tmustRefuse(t, err, ErrInvalidArguments, \"activation/grammar_beats_ownership\")\n421|\t})\n422|\tt.Run(\"absence_beats_stale_token\", func(t *testing.T) {\n423|\t\tobservation := fenceObservation()\n424|\t\tobservation.HasWinner = false\n425|\t\tobservation.Winner = sessrepo.LeaseSummary{}\n426|\t\t_, err := AuthorizeActivation(stale, observation)\n427|\t\tmustPark(t, err, ParkRestorePolicy, \"\", ErrLeaseConflict, \"activation/absence_beats_stale_token\")\n428|\t})\n429|}\n430|\n431|// TestObserveLoadsWinningLease drives the repository-backed\n432|// observation entry: the winner is the store head, a session with no\n433|// leases yields no winner without an error, and an unknown session\n434|// propagates the repository refusal.\n435|func TestObserveLoadsWinningLease(t *testing.T) {\n436|\tt.Run(\"winner_is_store_head\", func(t *testing.T) {\n437|\t\trepository, _ := openFenceRepository(t)\n438|\t\tcreateFenceSession(t, repository)\n439|\t\tfirst := mustCreateFenceLease(t, repository, fenceSessionA, sessrepo.CreateLeaseInput{LeaseID: fenceLeaseOld, HolderHostID: fenceHostA, IssuedByHostID: fenceHostA, CreatedAt: fenceLeaseAt})\n440|\t\tsecond := mustSwapFenceLease(t, repository, fenceSessionA, sessrepo.LeaseExpectation{RecordID: first.RecordID}, sessrepo.SuccessorLeaseInput{\n441|\t\t\tCreateLeaseInput: sessrepo.CreateLeaseInput{LeaseID: fenceLeaseA, HolderHostID: fenceHostA, IssuedByHostID: fenceHostA, CreatedAt: fenceLeaseAt},\n442|\t\t\tReason:           \"graceful_takeover\",\n443|\t\t\tCheckpointID:     fenceZeroDigest,\n444|\t\t})\n445|\t\tobservation, err := Observe(repository, fenceSessionA, ObserveInput{LocalHostID: fenceHostA, Verified: true, HasGrant: true, Grant: sessrepo.FencingGrant{SessionID: fenceSessionA, ValidatedAt: fenceValidatedAt}, Policy: fencePolicy, Now: fenceValidatedAt})\n446|\t\tif err != nil {\n447|\t\t\tt.Fatalf(\"Observe error = %v\", err)\n448|\t\t}\n449|\t\tif !observation.HasWinner {\n450|\t\t\tt.Fatal(\"Observe reports no winner past a succession\")\n451|\t\t}\n452|\t\tif observation.Winner.Epoch != 2 || observation.Winner.LeaseID != fenceLeaseA || observation.Winner.HolderHostID != fenceHostA || observation.Winner.RecordID != second.RecordID {\n453|\t\t\tt.Fatalf(\"Observe winner = %+v, want the store head %+v\", observation.Winner, second)\n454|\t\t}\n455|\t\ttoken, err := AuthorizeMutation(fencePresented(), observation)\n456|\t\tmustMint(t, token, err, \"Observe/AuthorizeMutation\")\n457|\t})\n458|\tt.Run(\"no_leases_yields_no_winner\", func(t *testing.T) {\n459|\t\trepository, _ := openFenceRepository(t)\n460|\t\tcreateFenceSession(t, repository)\n461|\t\tobservation, err := Observe(repository, fenceSessionA, ObserveInput{LocalHostID: fenceHostA, Verified: true})\n462|\t\tif err != nil {\n463|\t\t\tt.Fatalf(\"Observe error = %v\", err)\n464|\t\t}\n465|\t\tif observation.HasWinner {\n466|\t\t\tt.Fatalf(\"Observe winner = %+v, want no winner\", observation.Winner)\n467|\t\t}\n468|\t})\n469|\tt.Run(\"unknown_session_propagates\", func(t *testing.T) {\n470|\t\trepository, _ := openFenceRepository(t)\n471|\t\t_, err := Observe(repository, fenceSessionA, ObserveInput{LocalHostID: fenceHostA, Verified: true})\n472|\t\tif err == nil {\n473|\t\t\tt.Fatal(\"Observe(unknown session) succeeded\")\n474|\t\t}\n475|\t\tif !errors.Is(err, sessrepo.ErrUnknownSession) {\n476|\t\t\tt.Fatalf(\"Observe(unknown session) error = %v, want the repository refusal\", err)\n477|\t\t}\n478|\t})\n479|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c709","stream":{"kind":"session","id":"01a0ae0f-ee07-7b81-b4d4-cf94ccb5debd"},"sequence":479,"recorded_at":1780531400000953,"record_type":"event","durability":"durable","causation_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","run_stream":{"kind":"run","id":"b7392d99-bbd5-4114-ba32-61509405cfc4"},"call_id":"call_01a0ae10b32971e187f68b2347aebae0","text":"Read text file `internal/fencing/token_test.go`.\n1|package fencing\n2|\n3|import (\n4|\t\"testing\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n7|)\n8|\n9|// TestBindProjectsMintedToken proves the provider projection carries\n10|// the exact winning triple: only a token minted by a passed gate\n11|// binds to quiesce, capture, and materialize.\n12|func TestBindProjectsMintedToken(t *testing.T) {\n13|\ttoken, err := AuthorizeMutation(fencePresented(), fenceObservation())\n14|\tif err != nil {\n15|\t\tt.Fatalf(\"AuthorizeMutation error = %v\", err)\n16|\t}\n17|\tfor _, operation := range []ProviderOperation{ProviderQuiesce, ProviderCapture, ProviderMaterialize} {\n18|\t\tbound, err := token.Bind(operation)\n19|\t\tif err != nil {\n20|\t\t\tt.Fatalf(\"Bind(%s) error = %v\", operation, err)\n21|\t\t}\n22|\t\tif bound.SessionID != fenceSessionA || bound.Epoch != 2 || bound.LeaseID != fenceLeaseA || bound.Operation != operation {\n23|\t\t\tt.Fatalf(\"Bind(%s) = %+v, want the winning triple\", operation, bound)\n24|\t\t}\n25|\t}\n26|}\n27|\n28|// TestBindRefusesUnknownOperation proves the provider operation enum\n29|// is closed: resume, stop, and bogus names refuse invalid_arguments\n30|// even with a live token.\n31|func TestBindRefusesUnknownOperation(t *testing.T) {\n32|\ttoken, err := AuthorizeMutation(fencePresented(), fenceObservation())\n33|\tif err != nil {\n34|\t\tt.Fatalf(\"AuthorizeMutation error = %v\", err)\n35|\t}\n36|\tfor _, operation := range []ProviderOperation{\"bogus\", \"resume\", \"stop\"} {\n37|\t\t_, err := token.Bind(operation)\n38|\t\tmustRefuse(t, err, ErrInvalidArguments, \"Bind(\"+string(operation)+\")\")\n39|\t}\n40|}\n41|\n42|// TestBindRefusesForgedToken proves the sealed capability cannot be\n43|// assembled by hand: a zero token and a token whose seal carries\n44|// every field but the constructor-only seal token refuse\n45|// lease_conflict on every provider operation before any other check.\n46|func TestBindRefusesForgedToken(t *testing.T) {\n47|\tforged := LeaseToken{seal: &leaseSeal{session: fenceSessionA, epoch: 2, leaseID: fenceLeaseA}}\n48|\tfor _, operation := range []ProviderOperation{ProviderQuiesce, ProviderCapture, ProviderMaterialize} {\n49|\t\t_, err := LeaseToken{}.Bind(operation)\n50|\t\tmustRefuse(t, err, ErrLeaseConflict, \"zero/Bind(\"+string(operation)+\")\")\n51|\t\t_, err = forged.Bind(operation)\n52|\t\tmustRefuse(t, err, ErrLeaseConflict, \"forged/Bind(\"+string(operation)+\")\")\n53|\t}\n54|}\n55|\n56|// TestMintedTokenIsStableAcrossEntries proves every production entry\n57|// mints the same projection for the same observation: the capability\n58|// carries the authority, not the entry that admitted it.\n59|func TestMintedTokenIsStableAcrossEntries(t *testing.T) {\n60|\tvar first ProviderLease\n61|\tfor name, entry := range fenceEntries() {\n62|\t\ttoken, err := entry.authorize(fencePresented(), fenceObservation())\n63|\t\tif err != nil {\n64|\t\t\tt.Fatalf(\"%s error = %v\", name, err)\n65|\t\t}\n66|\t\tbound, err := token.Bind(ProviderCapture)\n67|\t\tif err != nil {\n68|\t\t\tt.Fatalf(\"%s Bind(capture) error = %v\", name, err)\n69|\t\t}\n70|\t\tif first.SessionID == \"\" {\n71|\t\t\tfirst = bound\n72|\t\t\tcontinue\n73|\t\t}\n74|\t\tif bound != first {\n75|\t\t\tt.Fatalf(\"%s Bind(capture) = %+v, want %+v\", name, bound, first)\n76|\t\t}\n77|\t}\n78|}\n79|\n80|// TestAuthorizeEndToEndOverRepository drives the full production path\n81|// against a real store: observe, authorize, lose the lease to a rival\n82|// succession, re-observe, and prove the old token is now stale while\n83|// the rival token authorizes.\n84|func TestAuthorizeEndToEndOverRepository(t *testing.T) {\n85|\trepository, _ := openFenceRepository(t)\n86|\tcreateFenceSession(t, repository)\n87|\tfirst := mustCreateFenceLease(t, repository, fenceSessionA, sessrepo.CreateLeaseInput{LeaseID: fenceLeaseOld, HolderHostID: fenceHostA, IssuedByHostID: fenceHostA, CreatedAt: fenceLeaseAt})\n88|\tinput := ObserveInput{LocalHostID: fenceHostA, Verified: true, HasGrant: true, Grant: sessrepo.FencingGrant{SessionID: fenceSessionA, ValidatedAt: fenceValidatedAt}, Policy: fencePolicy, Now: fenceValidatedAt}\n89|\tobservation, err := Observe(repository, fenceSessionA, input)\n90|\tif err != nil {\n91|\t\tt.Fatalf(\"Observe error = %v\", err)\n92|\t}\n93|\told := PresentedToken{SessionID: fenceSessionA, Epoch: 1, LeaseID: fenceLeaseOld}\n94|\tif _, err := AuthorizeMutation(old, observation); err != nil {\n95|\t\tt.Fatalf(\"AuthorizeMutation(epoch 1) error = %v\", err)\n96|\t}\n97|\tmustSwapFenceLease(t, repository, fenceSessionA, sessrepo.LeaseExpectation{RecordID: first.RecordID}, sessrepo.SuccessorLeaseInput{\n98|\t\tCreateLeaseInput: sessrepo.CreateLeaseInput{LeaseID: fenceLeaseA, HolderHostID: fenceHostB, IssuedByHostID: fenceHostB, CreatedAt: fenceLeaseAt},\n99|\t\tReason:           \"force_takeover\",\n100|\t\tCheckpointID:     fenceZeroDigest,\n101|\t})\n102|\tobservation, err = Observe(repository, fenceSessionA, input)\n103|\tif err != nil {\n104|\t\tt.Fatalf(\"Observe after succession error = %v\", err)\n105|\t}\n106|\t_, err = AuthorizeMutation(old, observation)\n107|\tmustRefuse(t, err, ErrNotOwner, \"old token after succession is remote before it is stale\")\n108|\trival := PresentedToken{SessionID: fenceSessionA, Epoch: 2, LeaseID: fenceLeaseA}\n109|\trivalInput := input\n110|\trivalInput.LocalHostID = fenceHostB\n111|\trivalObservation, err := Observe(repository, fenceSessionA, rivalInput)\n112|\tif err != nil {\n113|\t\tt.Fatalf(\"Observe(rival) error = %v\", err)\n114|\t}\n115|\ttoken, err := AuthorizeActivation(rival, rivalObservation)\n116|\tmustMint(t, token, err, \"rival token after succession\")\n117|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c70b","stream":{"kind":"session","id":"01a0ae0f-ee07-7b81-b4d4-cf94ccb5debd"},"sequence":480,"recorded_at":1780531400000955,"record_type":"event","durability":"durable","causation_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","run_stream":{"kind":"run","id":"b7392d99-bbd5-4114-ba32-61509405cfc4"},"call_id":"call_01a0ae10b39f75e2a8f12d33c7a82bad","text":"Read text file `internal/fencing/terminate_test.go`.\n1|package fencing\n2|\n3|import (\n4|\t\"testing\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n7|)\n8|\n9|// fenceWinner returns the epoch-2 winning summary the terminate tests\n10|// judge staleness against.\n11|func fenceWinner() sessrepo.LeaseSummary {\n12|\treturn sessrepo.LeaseSummary{SessionID: fenceSessionA, LeaseID: fenceLeaseA, Epoch: 2, HolderHostID: fenceHostA}\n13|}\n14|\n15|// TestTerminateStaleAuthorizesFencedTarget proves explicit force\n16|// recovery with preserved diagnostics authorizes terminating a\n17|// fenced process: a lower-epoch target, a same-epoch divergent\n18|// target, and a target from an epoch beyond the winner are all not\n19|// the live owner.\n20|func TestTerminateStaleAuthorizesFencedTarget(t *testing.T) {\n21|\twinner := fenceWinner()\n22|\ttargets := map[string]PresentedToken{\n23|\t\t\"lower_epoch\":    {SessionID: fenceSessionA, Epoch: 1, LeaseID: fenceLeaseOld},\n24|\t\t\"divergent\":      {SessionID: fenceSessionA, Epoch: 2, LeaseID: fenceLeaseC},\n25|\t\t\"beyond_winner\":  {SessionID: fenceSessionA, Epoch: 9, LeaseID: fenceLeaseC},\n26|\t\t\"prefix_sharing\": {SessionID: fenceSessionA, Epoch: 2, LeaseID: fenceLeaseC2},\n27|\t}\n28|\tfor name, target := range targets {\n29|\t\tt.Run(name, func(t *testing.T) {\n30|\t\t\tif err := AuthorizeTerminateStale(target, winner, true, true, true); err != nil {\n31|\t\t\t\tt.Fatalf(\"AuthorizeTerminateStale(%s) error = %v, want authorization\", name, err)\n32|\t\t\t}\n33|\t\t})\n34|\t}\n35|}\n36|\n37|// TestTerminateStaleRefusesWithoutForce proves terminate-stale\n38|// without explicit force recovery refuses local_precondition_failed,\n39|// even with diagnostics preserved.\n40|func TestTerminateStaleRefusesWithoutForce(t *testing.T) {\n41|\twinner := fenceWinner()\n42|\tstale := PresentedToken{SessionID: fenceSessionA, Epoch: 1, LeaseID: fenceLeaseOld}\n43|\tvectors := map[string]bool{\"diagnostics\": true, \"no_diagnostics\": false}\n44|\tfor name, diagnostics := range vectors {\n45|\t\tt.Run(name, func(t *testing.T) {\n46|\t\t\terr := AuthorizeTerminateStale(stale, winner, true, false, diagnostics)\n47|\t\t\tmustRefuse(t, err, ErrLocalPreconditionFailed, \"no_force/\"+name)\n48|\t\t})\n49|\t}\n50|}\n51|\n52|// TestTerminateStaleRefusesWithoutDiagnostics proves terminate-stale\n53|// before diagnostics are preserved refuses\n54|// local_precondition_failed, even under explicit force recovery.\n55|func TestTerminateStaleRefusesWithoutDiagnostics(t *testing.T) {\n56|\twinner := fenceWinner()\n57|\tstale := PresentedToken{SessionID: fenceSessionA, Epoch: 1, LeaseID: fenceLeaseOld}\n58|\tvectors := map[string]bool{\"force\": true, \"no_force\": false}\n59|\tfor name, force := range vectors {\n60|\t\tt.Run(name, func(t *testing.T) {\n61|\t\t\terr := AuthorizeTerminateStale(stale, winner, true, force, false)\n62|\t\t\tmustRefuse(t, err, ErrLocalPreconditionFailed, \"no_diagnostics/\"+name)\n63|\t\t})\n64|\t}\n65|}\n66|\n67|// TestTerminateStaleRefusesWithoutWinner proves staleness cannot be\n68|// judged without an established winner: terminate-stale refuses\n69|// local_precondition_failed.\n70|func TestTerminateStaleRefusesWithoutWinner(t *testing.T) {\n71|\tstale := PresentedToken{SessionID: fenceSessionA, Epoch: 1, LeaseID: fenceLeaseOld}\n72|\tvectors := map[string]bool{\"force\": true, \"no_force\": false}\n73|\tfor name, force := range vectors {\n74|\t\tt.Run(name, func(t *testing.T) {\n75|\t\t\terr := AuthorizeTerminateStale(stale, sessrepo.LeaseSummary{}, false, force, true)\n76|\t\t\tmustRefuse(t, err, ErrLocalPreconditionFailed, \"no_winner/\"+name)\n77|\t\t})\n78|\t}\n79|}\n80|\n81|// TestTerminateStaleRefusesLiveOwner proves terminate-stale must\n82|// never terminate the live winning owner: an exact winning target\n83|// refuses local_precondition_failed at both epoch 1 and epoch 2.\n84|func TestTerminateStaleRefusesLiveOwner(t *testing.T) {\n85|\tt.Run(\"epoch_two\", func(t *testing.T) {\n86|\t\twinner := fenceWinner()\n87|\t\tlive := PresentedToken{SessionID: fenceSessionA, Epoch: 2, LeaseID: fenceLeaseA}\n88|\t\terr := AuthorizeTerminateStale(live, winner, true, true, true)\n89|\t\tmustRefuse(t, err, ErrLocalPreconditionFailed, \"live_owner/epoch_two\")\n90|\t})\n91|\tt.Run(\"epoch_one\", func(t *testing.T) {\n92|\t\twinner := sessrepo.LeaseSummary{SessionID: fenceSessionA, LeaseID: fenceLeaseOld, Epoch: 1, HolderHostID: fenceHostA}\n93|\t\tlive := PresentedToken{SessionID: fenceSessionA, Epoch: 1, LeaseID: fenceLeaseOld}\n94|\t\terr := AuthorizeTerminateStale(live, winner, true, true, true)\n95|\t\tmustRefuse(t, err, ErrLocalPreconditionFailed, \"live_owner/epoch_one\")\n96|\t})\n97|}\n98|\n99|// TestTerminateStaleRefusesForeignSession proves a target bound to\n100|// another session is not fenced by this winner: terminate-stale\n101|// refuses lease_conflict.\n102|func TestTerminateStaleRefusesForeignSession(t *testing.T) {\n103|\twinner := fenceWinner()\n104|\tvectors := map[string]PresentedToken{\n105|\t\t\"prefix_sharing\": {SessionID: fenceSessionB, Epoch: 2, LeaseID: fenceLeaseA},\n106|\t\t\"fully_foreign\":  {SessionID: fenceSessionC, Epoch: 9, LeaseID: fenceLeaseC},\n107|\t}\n108|\tfor name, target := range vectors {\n109|\t\tt.Run(name, func(t *testing.T) {\n110|\t\t\terr := AuthorizeTerminateStale(target, winner, true, true, true)\n111|\t\t\tmustRefuse(t, err, ErrLeaseConflict, \"foreign/\"+name)\n112|\t\t})\n113|\t}\n114|}\n115|\n116|// TestTerminateStaleRefusesMalformedTarget proves malformed targets\n117|// refuse invalid_arguments before any force or staleness question.\n118|func TestTerminateStaleRefusesMalformedTarget(t *testing.T) {\n119|\twinner := fenceWinner()\n120|\tvectors := map[string]PresentedToken{\n121|\t\t\"session_not_uuid\": {SessionID: \"not-a-uuid\", Epoch: 2, LeaseID: fenceLeaseA},\n122|\t\t\"epoch_zero\":       {SessionID: fenceSessionA, Epoch: 0, LeaseID: fenceLeaseA},\n123|\t\t\"lease_not_uuid\":   {SessionID: fenceSessionA, Epoch: 2, LeaseID: \"zzz\"},\n124|\t\t\"lease_empty\":      {SessionID: fenceSessionA, Epoch: 2, LeaseID: \"\"},\n125|\t}\n126|\tfor name, target := range vectors {\n127|\t\tt.Run(name, func(t *testing.T) {\n128|\t\t\terr := AuthorizeTerminateStale(target, winner, true, true, true)\n129|\t\t\tmustRefuse(t, err, ErrInvalidArguments, \"malformed/\"+name)\n130|\t\t})\n131|\t}\n132|}\n133|\n134|// TestTerminateStaleRefusesGarbageWinner proves staleness is never\n135|// judged against a malformed winner: garbage authority refuses\n136|// invalid_arguments.\n137|func TestTerminateStaleRefusesGarbageWinner(t *testing.T) {\n138|\tstale := PresentedToken{SessionID: fenceSessionA, Epoch: 1, LeaseID: fenceLeaseOld}\n139|\tvectors := map[string]sessrepo.LeaseSummary{\n140|\t\t\"epoch_zero_lease\": {SessionID: fenceSessionA, LeaseID: \"zzz\", Epoch: 0, HolderHostID: fenceHostA},\n141|\t\t\"lease_malformed\":  {SessionID: fenceSessionA, LeaseID: \"zzz\", Epoch: 2, HolderHostID: fenceHostA},\n142|\t}\n143|\tfor name, winner := range vectors {\n144|\t\tt.Run(name, func(t *testing.T) {\n145|\t\t\terr := AuthorizeTerminateStale(stale, winner, true, true, true)\n146|\t\t\tmustRefuse(t, err, ErrInvalidArguments, \"garbage_winner/\"+name)\n147|\t\t})\n148|\t}\n149|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
