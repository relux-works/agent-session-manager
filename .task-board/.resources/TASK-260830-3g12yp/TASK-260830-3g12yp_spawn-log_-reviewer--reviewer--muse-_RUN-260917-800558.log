{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c665","stream":{"kind":"session","id":"01a0ae0f-ee07-7b81-b4d4-cf94ccb5debd"},"sequence":397,"recorded_at":1780531400000789,"record_type":"event","durability":"durable","causation_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b7392d99-bbd5-4114-ba32-61509405cfc4","run_stream":{"kind":"run","id":"b7392d99-bbd5-4114-ba32-61509405cfc4"},"task_stream":{"kind":"task","id":"01a0ae10-9965-7ac2-86a7-5b6ef986f1c0"},"task_id":"01a0ae10-9965-7ac2-86a7-5b6ef986f1c0","event":{"kind":"output","task_id":"01a0ae10-9965-7ac2-86a7-5b6ef986f1c0","chunk":"Read text file `internal/fencing/census_test.go`.\n1|package fencing\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/token\"\n6|\t\"os/exec\"\n7|\t\"path/filepath\"\n8|\t\"runtime\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/invcore\"\n14|)\n15|\n16|// sealConstructorFile is the only production file that may name the\n17|// seal types or assemble a non-empty LeaseToken.\n18|const sealConstructorFile = \"token.go\"\n19|\n20|// auditSealBoundary derives every seal-construction reference outside\n21|// the constructor file: any occurrence of the seal idents, and any\n22|// non-empty LeaseToken composite literal. The walk is over AST\n23|// idents, so comments and string literals that mention the seal are\n24|// not references. A display name and parsed file let the same audit\n25|// run over control plants.\n26|func auditSealBoundary(display string, syntax *ast.File, fileSet *token.FileSet) []string {\n27|\tvar violations []string\n28|\tposition := func(node ast.Node) string {\n29|\t\tplace := fileSet.Position(node.Pos())\n30|\t\treturn display + \":\" + strconv.Itoa(place.Line)\n31|\t}\n32|\tast.Inspect(syntax, func(node ast.Node) bool {\n33|\t\tident, ok := node.(*ast.Ident)\n34|\t\tif ok && (ident.Name == \"leaseSeal\" || ident.Name == \"leaseSealToken\") {\n35|\t\t\tviolations = append(violations, \"seal type reference outside \"+sealConstructorFile+\": \"+position(ident))\n36|\t\t\treturn true\n37|\t\t}\n38|\t\tliteral, ok := node.(*ast.CompositeLit)\n39|\t\tif !ok || len(literal.Elts) == 0 {\n40|\t\t\treturn true\n41|\t\t}\n42|\t\tif ident, ok := literal.Type.(*ast.Ident); ok && ident.Name == \"LeaseToken\" {\n43|\t\t\tviolations = append(violations, \"non-empty LeaseToken literal outside \"+sealConstructorFile+\": \"+position(literal))\n44|\t\t}\n45|\t\treturn true\n46|\t})\n47|\treturn violations\n48|}\n49|\n50|// TestLeaseTokenConstructorCensus pins the sealed-capability\n51|// construction boundary: only token.go names the seal types or\n52|// assembles a non-empty LeaseToken, and token.go carries exactly one\n53|// mint site. gate.go's empty LeaseToken{} refusals are not authority\n54|// and stay allowed.\n55|func TestLeaseTokenConstructorCensus(t *testing.T) {\n56|\tfiles, fileSet := invcore.MustScanProduction(t, \".\")\n57|\tvar violations []string\n58|\tmints := 0\n59|\tfor _, file := range files {\n60|\t\tif file.Name == sealConstructorFile {\n61|\t\t\tmints += strings.Count(string(file.Source), \"&leaseSealToken{}\")\n62|\t\t\tcontinue\n63|\t\t}\n64|\t\tviolations = append(violations, auditSealBoundary(file.Name, file.Syntax, fileSet)...)\n65|\t}\n66|\tfor _, violation := range violations {\n67|\t\tt.Error(violation)\n68|\t}\n69|\tif mints != 1 {\n70|\t\tt.Errorf(\"mint sites = %d, want exactly one &leaseSealToken{} in %s\", mints, sealConstructorFile)\n71|\t}\n72|}\n73|\n74|// sealPlants rosters the control plants the census must accept or\n75|// reject. The alias plant preserves the searched-for token\n76|// (leaseSeal) while constructing through a renamed spelling: a\n77|// text search for the construction shape would miss it, so the\n78|// ident-based audit must still reject it.\n79|func sealPlants() map[string]struct {\n80|\tsource string\n81|\treject bool\n82|} {\n83|\treturn map[string]struct {\n84|\t\tsource string\n85|\t\treject bool\n86|\t}{\n87|\t\t\"comment_mentions_seal\": {\n88|\t\t\tsource: \"package fencing\\n\\n// leaseSeal and leaseSealToken are constructor-only; LeaseToken{seal: x} never appears here.\\nfunc plantComment() {}\\n\",\n89|\t\t\treject: false,\n90|\t\t},\n91|\t\t\"string_mentions_seal\": {\n92|\t\t\tsource: \"package fencing\\n\\nvar plantString = \\\"leaseSeal{token: &leaseSealToken{}}\\\"\\n\\nfunc plantUse() string { return plantString }\\n\",\n93|\t\t\treject: false,\n94|\t\t},\n95|\t\t\"alias_backdoor\": {\n96|\t\t\tsource: \"package fencing\\n\\ntype plantBackdoor = leaseSeal\\n\\nfunc plantAlias() LeaseToken { return LeaseToken{seal: &plantBackdoor{}} }\\n\",\n97|\t\t\treject: true,\n98|\t\t},\n99|\t\t\"direct_forgery\": {\n100|\t\t\tsource: \"package fencing\\n\\nfunc plantDirect() LeaseToken { return LeaseToken{seal: &leaseSeal{token: &leaseSealToken{}}} }\\n\",\n101|\t\t\treject: true,\n102|\t\t},\n103|\t\t\"shadowed_seal\": {\n104|\t\t\tsource: \"package fencing\\n\\ntype leaseSeal struct{ note string }\\n\\nfunc plantShadow() string { return leaseSeal{note: \\\"x\\\"}.note }\\n\",\n105|\t\t\treject: true,\n106|\t\t},\n107|\t}\n108|}\n109|\n110|// TestLeaseTokenCensusPlants executes the control plants through the\n111|// same audit the production census runs: comment and string mentions\n112|// of the seal are not references, while alias, direct, and shadowing\n113|// forgeries are rejected.\n114|func TestLeaseTokenCensusPlants(t *testing.T) {\n115|\tfor name, plant := range sealPlants() {\n116|\t\tt.Run(name, func(t *testing.T) {\n117|\t\t\tsyntax, fileSet, failure := invcore.ParseSource(\"plant.go\", []byte(plant.source))\n118|\t\t\tif failure != \"\" {\n119|\t\t\t\tt.Fatalf(\"parse plant: %s\", failure)\n120|\t\t\t}\n121|\t\t\tviolations := auditSealBoundary(\"plant.go\", syntax, fileSet)\n122|\t\t\tif plant.reject && len(violations) == 0 {\n123|\t\t\t\tt.Fatalf(\"plant %s accepted, want rejection\", name)\n124|\t\t\t}\n125|\t\t\tif !plant.reject && len(violations) != 0 {\n126|\t\t\t\tt.Fatalf(\"plant %s rejected: %v\", name, violations)\n127|\t\t\t}\n128|\t\t})\n129|\t}\n130|}\n131|\n132|// TestLeaseTokenUnforgeableOutsidePackage proves the seal cannot be\n133|// spelled from outside: a fixture package that assembles a LeaseToken\n134|// by field name fails to build, while a fixture that uses only the\n135|// public Authorize/Bind surface builds cleanly.\n136|func TestLeaseTokenUnforgeableOutsidePackage(t *testing.T) {\n137|\t_, file, _, ok := runtime.Caller(0)\n138|\tif !ok {\n139|\t\tt.Fatal(\"cannot locate test file\")\n140|\t}\n141|\tdir := filepath.Dir(file)\n142|\tbuild := func(t *testing.T, target string) (int, string) {\n143|\t\tt.Helper()\n144|\t\tcommand := exec.Command(\"go\", \"build\", target)\n145|\t\tcommand.Dir = filepath.Join(dir, \"..\", \"..\")\n146|\t\toutput, err := command.CombinedOutput()\n147|\t\tif err == nil {\n148|\t\t\treturn 0, string(output)\n149|\t\t}\n150|\t\texit, ok := err.(*exec.ExitError)\n151|\t\tif !ok {\n152|\t\t\tt.Fatalf(\"go build %s: %v\", target, err)\n153|\t\t}\n154|\t\treturn exit.ExitCode(), string(output)\n155|\t}\n156|\tif code, output := build(t, \"./internal/fencing/testdata/use\"); code != 0 {\n157|\t\tt.Fatalf(\"public-surface fixture fails to build (exit %d): %s\", code, output)\n158|\t}\n159|\tcode, output := build(t, \"./internal/fencing/testdata/forge\")\n160|\tif code == 0 {\n161|\t\tt.Fatal(\"forgery fixture builds, want a compile failure on the unexported seal\")\n162|\t}\n163|\tif !strings.Contains(output, \"seal\") && !strings.Contains(output, \"unknown field\") {\n164|\t\tt.Fatalf(\"forgery build fails without naming the seal (exit %d): %s\", code, output)\n165|\t}\n166|}","final_result":true}}}
