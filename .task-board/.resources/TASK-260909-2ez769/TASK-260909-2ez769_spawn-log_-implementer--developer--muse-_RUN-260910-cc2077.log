 signs continuation; never\\nhand-commit the retained replay or edit workspace registry records.\\n\\nUsage:\\n  task-board worktree refresh-candidate <ELEMENT-ID> [flags]\\n\\nFlags:\\n  -h, --help                        help for refresh-candidate\\n      --replay-resolutions string   JSON file of checkpoint-bound conflict resolutions\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n===WORKTREE-STATUS===\\nSTORY-260830-1i3qu7  active\\n  path:       .temp/STORY-260830-1i3qu7/worktree (present)\\n  branch:     task-board/story/STORY-260830-1i3qu7 (present)\\n  base:       main\\n  tip:        7f90e5858cd8346228f7aa687252266f1c133244\\n  tree:       dirty\\n  blocked:    managed worktree has uncommitted or untracked changes\\n  change-req: TASK-260830-2ciy0s rev 3 checkpointed (repository_delta=present, 35 changed path(s))\\n  change-req: TASK-260830-2uowwk rev 2 accepted (repository_delta=present, 60 changed path(s))\\n  change-req: TASK-260830-7a0s2c rev 3 checkpointed (repository_delta=present, 19 changed path(s))\\nSTORY-260830-1kiyj6  active\\n  path:       .temp/STORY-260830-1kiyj6/worktree (present)\\n  branch:     task-board/story/STORY-260830-1kiyj6 (present)\\n  base:       main\\n  tip:        c1eff016dce2e55c4e2c1828d5c20f3da84118bc\\n  tree:       dirty\\n  lease:      held by RUN-260910-cc2077\\n  blocked:    story lease is held by run RUN-260910-cc2077\\n  blocked:    managed worktree has uncommitted or untracked changes\\n  change-req: TASK-260830-1tvg8e rev 1 checkpointed (repository_delta=present, 13 changed path(s))\\n  change-req: TASK-260830-2u34k1 rev 1 checkpointed (repository_delta=present, 12 changed path(s))\\nSTORY-260830-2dy8oj  active\\n  path:       .temp/STORY-260830-2dy8oj/worktree (missing)\\n  branch:     task-board/story/STORY-260830-2dy8oj (present)\\n  base:       main\\n  tip:        81305c8886ead674122f498ad2124051257c9467\\n  tree:       not checked out\\n  change-req: TASK-260830-3amrl9 rev 8 checkpointed (repository_delta=present, 14 changed path(s))\\n  change-req: TASK-260830-3ps1b1 rev 6 checkpointed (repository_delta=present, 19 changed path(s))\\nSTORY-260830-2jylym  active\\n  path:       .temp/STORY-260830-2jylym/worktree (missing)\\n  branch:     task-board/story/STORY-260830-2jylym (present)\\n  base:       main\\n  tip:        adca16af03663682ec57993122c22c667813afc9\\n  tree:       not checked out\\n  change-req: TASK-260830-1bipsa rev 1 checkpointed (repository_delta=empty, 0 changed path(s))\\n  change-req: TASK-260830-33sfxc rev 7 accepted (repository_delta=present, 73 changed path(s))\\n  change-req: TASK-260830-34elja rev 2 checkpointed (repository_delta=empty, 0 changed path(s))\\nSTORY-260830-2wdm5e  active\\n  path:       .temp/STORY-260830-2wdm5e/worktree (missing)\\n  branch:     task-board/story/STORY-260830-2wdm5e (present)\\n  base:       main\\n  tip:        ad7275181ca82fc3fa29544e3893923a92d7b9d5\\n  tree:       not checked out\\n  change-req: TASK-260830-1pbx0c rev 6 checkpointed (repository_delta=present, 12 changed path(s))\\n  change-req: TASK-260830-236x9n rev 5 checkpointed (repository_delta=present, 19 changed path(s))\\n  change-req: TASK-260830-8x76g1 rev 16 accepted (repository_delta=present, 71 changed path(s))\\nSTORY-260830-323tpq  active\\n  path:       .temp/STORY-260830-323tpq/worktree (missing)\\n  branch:     task-board/story/STORY-260830-323tpq (present)\\n  base:       m