{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cae3","stream":{"kind":"session","id":"01a088d0-e609-7bb2-8da2-c35b2ea0a045"},"sequence":972,"recorded_at":1780531400001939,"record_type":"event","durability":"durable","causation_id":"f897871b-85d1-4704-870d-e5ea0ee901cf","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f897871b-85d1-4704-870d-e5ea0ee901cf","run_stream":{"kind":"run","id":"f897871b-85d1-4704-870d-e5ea0ee901cf"},"task_stream":{"kind":"task","id":"01a088d4-48aa-7742-875a-1885cf3c0f20"},"task_id":"01a088d4-48aa-7742-875a-1885cf3c0f20","event":{"kind":"output","task_id":"01a088d4-48aa-7742-875a-1885cf3c0f20","chunk":"{\n  \"chunk_id\": \"exec-35-1\",\n  \"command\": \"grep -n \\\"host-channel\\\\|host_channel\\\\|trust\\\\|Trust\\\" internal/localstore/paths.go internal/config/*.go 2>&1 | grep -v _test | head -n 20\\necho \\\"===LOCALSTORE-OWNERSHIP===\\\"\\nhead -n 60 internal/localstore/ownership_unix.go 2>&1\\necho \\\"===SECTRANSPORT-HEAD===\\\"\\nhead -n 80 internal/sshtransport/transport.go 2>&1\",\n  \"description\": \"Check trust paths, ownership, transport surface\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"internal/config/schema.go:109:\\tRequireExplicitTrust bool\\ninternal/config/schema.go:192:\\tExternalTrust                []ExternalExecutableTrust\\ninternal/config/schema.go:196:type ExternalExecutableTrust struct {\\ninternal/config/schema.go:312:\\tRequireExplicitTrust *bool    `toml:\\\"require_explicit_trust\\\"`\\ninternal/config/schema.go:335:\\tExternalTrust              []rawExternalExecutableTrust `toml:\\\"external_trust\\\"`\\ninternal/config/schema.go:339:type rawExternalExecutableTrust struct {\\ninternal/config/validation.go:127:\\tfor index, entry := range terminal.ExternalTrust {\\ninternal/config/validation.go:129:\\t\\t\\treturn configError(fmt.Sprintf(\\\"terminal.external_trust[%d] required member\\\", index), 