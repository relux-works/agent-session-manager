{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000e331","stream":{"kind":"session","id":"01a088d0-e609-7bb2-8da2-c35b2ea0a045"},"sequence":4083,"recorded_at":1780531400008161,"record_type":"event","durability":"durable","causation_id":"f897871b-85d1-4704-870d-e5ea0ee901cf","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f897871b-85d1-4704-870d-e5ea0ee901cf","run_stream":{"kind":"run","id":"f897871b-85d1-4704-870d-e5ea0ee901cf"},"task_stream":{"kind":"task","id":"01a088e3-eaa3-7210-b96a-92c563161fa4"},"task_id":"01a088e3-eaa3-7210-b96a-92c563161fa4","event":{"kind":"output","task_id":"01a088e3-eaa3-7210-b96a-92c563161fa4","chunk":"edited\nchanged lines: lines 137-151\n--- original\n+++ updated\n@@\n-func ensureOwnerDir(filesystem FileSystem, path string, mode fs.FileMode) error {\n-\tif err := filesystem.MkdirAll(path, mode); err != nil {\n-\t\treturn trustError(TrustError{Operation: \"create directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n-\t}\n-\t// MkdirAll honors umask and leaves existing modes untouched, so the exact\n-\t// owner-only mode is always enforced explicitly after creation.\n-\tif err := filesystem.Chmod(path, mode); err != nil {\n-\t\treturn trustError(TrustError{Operation: \"create directory\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n-\t}\n-\tinfo, err := filesystem.Lstat(path)\n-\tif err != nil {\n-\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n-\t}\n-\treturn verifyOwnerDir(path, info, mode)\n-}\n+func ensureOwnerDir(filesystem FileSystem, path string, mode fs.FileMode) error {\n+\tinfo, err := filesystem.Lstat(path)\n+\tif err != nil && !os.IsNotExist(err) {\n+\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n+\t}\n+\tif err == nil {\n+\t\t// An existing directory is verified, never repaired: silently\n+\t\t// narrowing a widened directory would mask the custody violation.\n+\t\treturn verifyOwnerDir(path, info, mode)\n+\t}\n+\tif err := filesystem.MkdirAll(path, mode); err != nil {\n+\t\treturn trustError(TrustError{Operation: \"create directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n+\t}\n+\t// MkdirAll honors umask, so the exact owner-only mode is enforced\n+\t// explicitly after creation.\n+\tif err := filesystem.Chmod(path, mode); err != nil {\n+\t\treturn trustError(TrustError{Operation: \"create directory\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n+\t}\n+\tinfo, err = filesystem.Lstat(path)\n+\tif err != nil {\n+\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n+\t}\n+\treturn verifyOwnerDir(path, info, mode)\n+}\n","final_result":true}}}
