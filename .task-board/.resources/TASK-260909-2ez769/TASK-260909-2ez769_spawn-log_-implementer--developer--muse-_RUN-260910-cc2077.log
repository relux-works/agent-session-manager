{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb4b","stream":{"kind":"session","id":"01a088d0-e609-7bb2-8da2-c35b2ea0a045"},"sequence":1024,"recorded_at":1780531400002043,"record_type":"event","durability":"durable","causation_id":"f897871b-85d1-4704-870d-e5ea0ee901cf","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f897871b-85d1-4704-870d-e5ea0ee901cf","run_stream":{"kind":"run","id":"f897871b-85d1-4704-870d-e5ea0ee901cf"},"task_stream":{"kind":"task","id":"01a088d5-7434-7e20-965a-bdeab8c766e5"},"task_id":"01a088d5-7434-7e20-965a-bdeab8c766e5","event":{"kind":"output","task_id":"01a088d5-7434-7e20-965a-bdeab8c766e5","chunk":"{\n  \"chunk_id\": \"exec-37-1\",\n  \"command\": \"ls internal/scalar/ 2>&1\\ngrep -n \\\"func.*Digest\\\\|func.*UUID\\\\|type Digest\\\\|func.*Timestamp\\\\|UUIDv7\\\\|uuid7\\\" internal/scalar/*.go 2>&1 | grep -v _test | head -n 25\\necho \\\"===HOSTID-VALIDATION===\\\"\\ngrep -n \\\"HostID\\\\|hostID\\\\|uuid\\\" internal/config/validation.go 2>&1 | head -n 20\\necho \\\"===LOADER-INPUTS-SNAPSHOT===\\\"\\nsed -n '100,215p' internal/config/loader.go 2>&1\",\n  \"description\": \"Inspect scalar, hostID validation, loader\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"fuzz_test.go\\ngit.go\\ngit_test.go\\ninteger.go\\nnames.go\\npath.go\\nscalar.go\\nscalar_test.go\\ntestdata\\ntime_digest.go\\nuuid.go\\ninternal/scalar/time_digest.go:16:func ParseTimestamp(value string) (Timestamp, error) {\\ninternal/scalar/time_digest.go:31:func (value Timestamp) String() string { return value.value }\\ninternal/scalar/time_digest.go:33:func (value Timestamp) MarshalText() ([]byte, error) {\\ninternal/scalar/time_digest.go:40:func (value *Timestamp) UnmarshalText(data []byte) error {\\ninternal/scalar/time_digest.go:49:func (value Timestamp) Time() (time.Time, error) {\\ninternal/scalar/time_digest.go:61:func parseTimestampInstant(value string) (time.Time, error) {\\ninternal/scalar/time_digest.go:110:func (value Timestamp) MarshalJSON() ([]byte, error) {\\ninternal/scalar/time_digest.go:117:func (value *Timestamp) UnmarshalJSON(data []byte) error {\\ninternal/scalar/time_digest.go:130:type Digest struct{ value string }\\ninternal/scalar/time_digest.go:132:func ParseDigest(value string) (Digest, error) {\\ninternal/scalar/time_digest.go:144:func SHA256Digest(value []byte) Digest {\\ninternal/scalar/time_digest.go:149:func (value Digest) String() string { return value.value }\\ninternal/scalar/time_digest.go:150:func (value Digest) Hex() string    { return strings.TrimPrefix(value.value, \\\"sha256:\\\") }\\ninternal/scalar/time_digest.go:152:func (value Digest) MarshalText() ([]byte, error) {\\ninternal/scalar/time_digest.go:159:func (value *Digest) UnmarshalText(data []byte) error {\\ninternal/scalar/time_digest.go:168:func (value Digest) MarshalJSON() ([]byte, error) {\\ninternal/scalar/time_digest.go:175:func (value *Digest) UnmarshalJSON(data []byte) error {\\ninternal/scalar/uuid.go:5:type UUIDv7 struct{ value string }\\ninternal/scalar/uuid.go:8:func ParseUUIDv7(value string) (UUIDv7, error) {\\ninternal/scalar/uuid.go:10:\\t\\treturn UUIDv7{}, err\\ninternal/scalar/uuid.go:12:\\treturn UUIDv7{value: value}, nil\\ninternal/scalar/uuid.go:15:func ParseUUIDv4(value string) (UUIDv4, error) {\\ninternal/scalar/uuid.go:22:func validateUUID(value string, version byte) error {\\ninternal/scalar/uuid.go:47:func (value UUIDv7) String() string { return value.value }\\ninternal/scalar/uuid.go:48:func (value UUIDv4) String() string { return value.value }\\n===HOSTID-VALIDATION===\\n40:\\t\\tSchema: raw.Schema, SchemaVersion: raw.SchemaVersion, HostID: raw.HostID,\\n64:\\t\\tSchema: raw.Schema, SchemaVersion: raw.SchemaVersion, HostID: raw.HostID,\\n91:\\t\\tSchema: raw.Schema, SchemaVersion: raw.SchemaVersion, HostID: raw.HostID,\\n119:\\t\\tif entry.HostID == nil || entry.EnvironmentObservations == nil || entry.NativeObservations == nil || entry.ManualMetadata == nil || entry.GeneratedMetadata == nil || entry.JobOperationStatus == nil || entry.Extensions == nil {\\n141:\\tif raw.HostID == nil || raw.HostName == nil || raw.Platform == nil {\\n150:\\t\\tHostID: *raw.HostID, HostName: *raw.HostName, Platform: platform,\\n178:\\t\\tif peer.HostID == nil || peer.Name == nil || peer.Endpoint == nil || peer.Platform == nil {\\n186:\\t\\t\\tHostID: *peer.HostID, Name: *peer.Name, Endpoint: *peer.Endpoint,\\n353:\\t\\tif entry.HostID != nil {\\n354:\\t\\t\\tvalue.HostID = *entry.HostID\\n382:\\tif _, err := scalar.ParseUUIDv7(configuration.HostID); err != nil {\\n432:\\thostIDs, names := map[string]struct{}{configuration.HostID: {}}, map[string]struct{}{}\\n435:\\t\\tif _, err := scalar.ParseUUIDv7(peer.HostID); err != nil {\\n438:\\t\\tif _, exists := hostIDs[peer.HostID]; exists {\\n441:\\t\\thostIDs[peer.HostID] = struct{}{}\\n633:\\t\\tif _, err := scalar.ParseUUIDv7(entry.HostID); err != nil {\\n636:\\t\\tif _, exists := disclosureIDs[entry.HostID]; exists {\\n639:\\t\\tdisclosureIDs[entry.HostID] = struct{}{}\\n===LOADER-INPUTS-SNAPSHOT===\\n// Inputs captures all process inputs read during one resolution.\\ntype Inputs struct {\\n\\tPlatform        scalar.Platform\\n\\tHomeDir         string\\n\\tTempDir         string\\n\\tWorkingDir      string\\n\\tBackendSettings BackendSettingsValidator\\n\\tLookupEnv       func(string) (string, bool)\\n\\tStat            func(string) (fs.FileInfo, error)\\n\\tReadFile        func(string) ([]byte, error)\\n\\thomeDirError    error\\n}\\n\\n// Snapshot contains one immutable path decision and selected TOML document.\\ntype Snapshot struct {\\n\\tpaths         ResolvedPaths\\n\\tdocument      []byte\\n\\tconfiguration *LoadedConfiguration\\n\\tconfigPresent bool\\n}\\n\\nfunc (snapshot Snapshot) Paths() ResolvedPaths {\\n\\treturn ResolvedPaths{values: snapshot.paths.All()}\\n}\\n\\nfunc (snapshot Snapshot) Document() []byte {\\n\\treturn append([]byte(nil), snapshot.document...)\\n}\\n\\n// ConfigPresent distinguishes an existing empty configuration document from\\n// an admissible not-yet-created configuration path.\\nfunc (snapshot Snapshot) ConfigPresent() bool {\\n\\treturn snapshot.configPresent\\n}\\n\\n// Configuration returns an isolated current-model translation when a selected\\n// configuration file existed and passed exact versioned validation.\\nfunc (snapshot Snapshot) Configuration() (LoadedConfiguration, bool) {\\n\\tif snapshot.configuration == nil {\\n\\t\\treturn LoadedConfiguration{}, false\\n\\t}\\n\\treturn LoadedConfiguration{\\n\\t\\tSourceVersion: snapshot.configuration.SourceVersion,\\n\\t\\tValue:         cloneConfiguration(snapshot.configuration.Value),\\n\\t}, true\\n}\\n\\n// Error reports a failed class/layer without echoing machine-local values.\\n// Wrapped details remain available to errors.Is/errors.As through Unwrap, but\\n// are deliberately excluded from the rendered message because OS and\\n// filesystem errors may contain selected paths.\\ntype Error struct {\\n\\tOperation string\\n\\tClass     PathClass\\n\\tSource    Source\\n\\tErr       error\\n}\\n\\nfunc (err *Error) Error() string {\\n\\tif err.Class == \\\"\\\" {\\n\\t\\treturn fmt.Sprintf(\\\"configuration %s failed\\\", err.Operation)\\n\\t}\\n\\tif err.Source == \\\"\\\" {\\n\\t\\treturn fmt.Sprintf(\\\"configuration %s for %s failed\\\", err.Operation, err.Class)\\n\\t}\\n\\treturn fmt.Sprintf(\\\"configuration %s for %s from %s failed\\\", err.Operation, err.Class, err.Source)\\n}\\n\\nfunc (err *Error) Unwrap() error { return err.Err }\\n\\n// OSInputs captures real process inputs once. The caller supplies the exact\\n// runtime-probed AX platform so WSL2 is never guessed from GOOS.\\nfunc OSInputs(platform scalar.Platform) (Inputs, error) {\\n\\tif _, err := scalar.ParsePlatform(platform.String()); err != nil {\\n\\t\\treturn Inputs{}, loaderError(Error{Operation: \\\"capture OS inputs\\\", Err