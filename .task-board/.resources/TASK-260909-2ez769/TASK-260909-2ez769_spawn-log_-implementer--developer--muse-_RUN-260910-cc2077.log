{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000de01","stream":{"kind":"session","id":"01a088d0-e609-7bb2-8da2-c35b2ea0a045"},"sequence":3419,"recorded_at":1780531400006833,"record_type":"event","durability":"durable","causation_id":"f897871b-85d1-4704-870d-e5ea0ee901cf","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f897871b-85d1-4704-870d-e5ea0ee901cf","run_stream":{"kind":"run","id":"f897871b-85d1-4704-870d-e5ea0ee901cf"},"task_stream":{"kind":"task","id":"01a088e1-7fb0-7e42-9525-708602abb12d"},"task_id":"01a088e1-7fb0-7e42-9525-708602abb12d","event":{"kind":"output","task_id":"01a088e1-7fb0-7e42-9525-708602abb12d","chunk":"edited\nchanged lines: line 241\n--- original\n+++ updated\n@@\n-func checkSortedUnique(entries []CredentialEntry) error {\n+// rejectDuplicateKeys refuses JSON objects that repeat a key. encoding/json\n+// keeps only the last duplicate silently, which would let a partial or\n+// downgraded state hide behind an earlier key, so the token stream is\n+// audited before decoding.\n+func rejectDuplicateKeys(document []byte) error {\n+\tdecoder := json.NewDecoder(bytes.NewReader(document))\n+\tvar stack [][]string\n+\tpush := func() { stack = append(stack, nil) }\n+\tpop := func() { stack = stack[:len(stack)-1] }\n+\texpectKey := []bool{}\n+\tinObject := func() bool { return len(expectKey) > 0 && !expectKey[len(expectKey)-1] }\n+\tfor {\n+\t\ttoken, err := decoder.Token()\n+\t\tif err != nil {\n+\t\t\tif err.Error() == \"EOF\" {\n+\t\t\t\tbreak\n+\t\t\t}\n+\t\t\treturn trustError(TrustError{Operation: \"decode document\", Err: errors.Join(ErrTrustDecode, err)})\n+\t\t}\n+\t\tswitch typed := token.(type) {\n+\t\tcase json.Delim:\n+\t\t\tswitch typed {\n+\t\t\tcase '{':\n+\t\t\t\tpush()\n+\t\t\t\texpectKey = append(expectKey, true)\n+\t\t\tcase '}':\n+\t\t\t\tif len(stack) == 0 {\n+\t\t\t\t\treturn trustError(TrustError{Operation: \"decode document\", Err: ErrTrustDecode})\n+\t\t\t\t}\n+\t\t\t\tpop()\n+\t\t\t\texpectKey = expectKey[:len(expectKey)-1]\n+\t\t\tcase '[':\n+\t\t\t\texpectKey = append(expectKey, false)\n+\t\t\tcase ']':\n+\t\t\t\tif len(expectKey) == 0 {\n+\t\t\t\t\treturn trustError(TrustError{Operation: \"decode document\", Err: ErrTrustDecode})\n+\t\t\t\t}\n+\t\t\t\texpectKey = expectKey[:len(expectKey)-1]\n+\t\t\t}\n+\t\tcase string:\n+\t\t\tif inObject() {\n+\t\t\t\tfor _, seen := range stack[len(stack)-1] {\n+\t\t\t\t\tif seen == typed {\n+\t\t\t\t\t\treturn trustError(TrustError{Operation: \"decode document\", Err: ErrTrustValidation})\n+\t\t\t\t\t}\n+\t\t\t\t}\n+\t\t\t\tstack[len(stack)-1] = append(stack[len(stack)-1], typed)\n+\t\t\t\texpectKey[len(expectKey)-1] = false\n+\t\t\t} else if len(expectKey) > 0 {\n+\t\t\t\texpectKey[len(expectKey)-1] = true\n+\t\t\t}\n+\t\tdefault:\n+\t\t\tif len(expectKey) > 0 && !expectKey[len(expectKey)-1] {\n+\t\t\t\t// Value inside an array or after a key: after a key the\n+\t\t\t\t// next token starts a new key.\n+\t\t\t\tif !inArrayContext(expectKey) {\n+\t\t\t\t\texpectKey[len(expectKey)-1] = true\n+\t\t\t\t}\n+\t\t\t}\n+\t\t}\n+\t}\n+\tif len(stack) != 0 {\n+\t\treturn trustError(TrustError{Operation: \"decode document\", Err: ErrTrustDecode})\n+\t}\n+\treturn nil\n+}\n+\n+func inArrayContext(expectKey []bool) bool {\n+\treturn len(expectKey) > 0 && !expectKey[len(expectKey)-1] && arrayDepth(expectKey)\n+}\n+\n+func arrayDepth(expectKey []bool) bool {\n+\t// Only the innermost frame matters: false means array element position.\n+\treturn true\n+}\n+\n+func checkSortedUnique(entries []CredentialEntry) error {\n","final_result":true}}}
