{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d27b","stream":{"kind":"session","id":"01a088d0-e609-7bb2-8da2-c35b2ea0a045"},"sequence":1944,"recorded_at":1780531400003883,"record_type":"event","durability":"durable","causation_id":"f897871b-85d1-4704-870d-e5ea0ee901cf","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f897871b-85d1-4704-870d-e5ea0ee901cf","run_stream":{"kind":"run","id":"f897871b-85d1-4704-870d-e5ea0ee901cf"},"call_id":"call_01a088da2f727c70ba81b2e185f08e9b","text":"Read text file `internal/hosttrust/transact.go`.\n(89 line(s) above)\n90|func transact(filesystem FileSystem, root string, lock *fileLock, fn TransactionFunc) error {\n91|\tunlock, err := lock.exclusive()\n92|\tif err != nil {\n93|\t\treturn trustError(TrustError{Operation: \"lock transaction\", Err: errors.Join(ErrTrustDurability, err)})\n94|\t}\n95|\tdefer unlock()\n96|\tpath := filepath.Join(root, trustFileName)\n97|\tvar committed TrustStore\n98|\tinfo, err := filesystem.Lstat(path)\n99|\tif err != nil {\n100|\t\tif os.IsNotExist(err) {\n101|\t\t\treturn trustError(TrustError{Operation: \"read committed trust\", Err: ErrTrustStoreMissing})\n102|\t\t}\n103|\t\treturn trustError(TrustError{Operation: \"read committed trust\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n104|\t} else {\n105|\t\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n106|\t\t\treturn err\n107|\t\t}\n108|\t\tdocument, err := filesystem.ReadFile(path)\n109|\t\tif err != nil {\n110|\t\t\treturn trustError(TrustError{Operation: \"read committed trust\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n111|\t\t}\n112|\t\t\tcommitted, err = DecodeTrust(document)\n113|\t\tif err != nil {\n114|\t\t\treturn err\n115|\t\t}\n116|\t}\n117|\tnext := committed\n118|\tnext.Entries = append([]CredentialEntry(nil), committed.Entries...)\n119|\tif err := fn(&next); err != nil {\n120|\t\treturn err\n121|\t}\n122|\tif next.Generation != committed.Generation {\n123|\t\treturn trustError(TrustError{Operation: \"commit generation\", Err: ErrTrustDurability})\n124|\t}\n125|\tif committed.Generation >= MaxGeneration {\n126|\t\treturn trustError(TrustError{Operation: \"commit generation\", Err: ErrGenerationExhausted})\n127|\t}\n128|\tnext.Generation = committed.Generation + 1\n129|\tdocument, err := EncodeTrust(next)\n130|\tif err != nil {\n131|\t\treturn err\n132|\t}\n133|\tif err := commitDocument(filesystem, root, path, document); err != nil {\n134|\t\treturn err\n135|\t}\n136|\treturn nil\n137|}\n138|\n139|// commitDocument stages bytes in a temp file with fsync, atomically renames\n140|// over the target, and fsyncs the directory. On restart only the last fully\n141|// committed file is selected; staged files are ignored by every reader.\n142|func commitDocument(filesystem FileSystem, root, path string, document []byte) error {\n143|\tstaged, err := filesystem.CreateTemp(root, stagePrefix+\"*\", 0o600)\n144|\tif err != nil {\n145|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n146|\t}\n147|\tname := staged.Name()\n148|\tfailed := true\n149|\tdefer func() {\n150|\t\tif failed {\n151|\t\t\t_ = filesystem.Remove(name)\n152|\t\t}\n153|\t}()\n154|\tif err := writeAll(staged, document); err != nil {\n155|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n156|\t}\n157|\tif err := staged.Sync(); err != nil {\n158|\t\t_ = staged.Close()\n159|\t\treturn trustError(TrustError{Operation: \"sync trust\", Err: errors.Join(ErrTrustDurability, err)})\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
