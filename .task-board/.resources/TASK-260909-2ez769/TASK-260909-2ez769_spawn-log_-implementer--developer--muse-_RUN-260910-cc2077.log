 committed.Generation >= MaxGeneration {\n127|\t\treturn trustError(TrustError{Operation: \"commit generation\", Err: ErrGenerationExhausted})\n128|\t}\n129|\tnext.Generation = committed.Generation + 1\n130|\tdocument, err := EncodeTrust(next)\n131|\tif err != nil {\n132|\t\treturn err\n133|\t}\n134|\tif err := commitDocument(filesystem, root, path, document); err != nil {\n135|\t\treturn err\n136|\t}\n137|\treturn nil\n138|}\n139|\n140|// commitDocument stages bytes in a temp file with fsync, atomically renames\n141|// over the target, and fsyncs the directory. On restart only the last fully\n142|// committed file is selected; staged files are ignored by every reader.\n143|func commitDocument(filesystem FileSystem, root, path string, document []byte) error {\n144|\tstaged, err := filesystem.CreateTemp(root, stagePrefix+\"*\", 0o600)\n145|\tif err != nil {\n(more lines below)","final_result":true}}}
