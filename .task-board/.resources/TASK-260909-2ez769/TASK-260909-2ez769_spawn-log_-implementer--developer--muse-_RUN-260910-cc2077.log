{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ed9f","stream":{"kind":"session","id":"01a088d0-e609-7bb2-8da2-c35b2ea0a045"},"sequence":5418,"recorded_at":1780531400010831,"record_type":"event","durability":"durable","causation_id":"f897871b-85d1-4704-870d-e5ea0ee901cf","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f897871b-85d1-4704-870d-e5ea0ee901cf","run_stream":{"kind":"run","id":"f897871b-85d1-4704-870d-e5ea0ee901cf"},"task_stream":{"kind":"task","id":"01a088ea-48ea-70b1-af69-809781f81a8c"},"task_id":"01a088ea-48ea-70b1-af69-809781f81a8c","event":{"kind":"output","task_id":"01a088ea-48ea-70b1-af69-809781f81a8c","chunk":"{\n  \"chunk_id\": \"exec-100-1\",\n  \"command\": \"sed -n '195,250p' internal/config/refusal_inventory_test.go 2>&1\",\n  \"description\": \"Read site collection logic\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"\\t\\tcase 0:\\n\\t\\t\\tinventory.Uninstrumented = append(inventory.Uninstrumented, name)\\n\\t\\tdefault:\\n\\t\\t\\tinventory.Duplicated = append(inventory.Duplicated, name)\\n\\t\\t}\\n\\t}\\n\\n\\tfor _, file := range files {\\n\\t\\tpermitted := map[ast.Node]struct{}{}\\n\\t\\tast.Inspect(file.syntax, func(node ast.Node) bool {\\n\\t\\t\\tcall, ok := node.(*ast.CallExpr)\\n\\t\\t\\tif !ok {\\n\\t\\t\\t\\treturn true\\n\\t\\t\\t}\\n\\t\\t\\tidentifier, ok := call.Fun.(*ast.Ident)\\n\\t\\t\\tif !ok {\\n\\t\\t\\t\\treturn true\\n\\t\\t\\t}\\n\\t\\t\\tif _, ok := inventory.Constructors[identifier.Name]; !ok {\\n\\t\\t\\t\\treturn true\\n\\t\\t\\t}\\n\\t\\t\\tposition := fileSet.Position(call.Pos())\\n\\t\\t\\tfor _, argument := range call.Args {\\n\\t\\t\\t\\tpermitted[unwrapUnary(argument)] = struct{}{}\\n\\t\\t\\t}\\n\\t\\t\\tif !strings.Contains(file.lines[position.Line-1], \\\"config-refusal-subsumed:\\\") {\\n\\t\\t\\t\\tinventory.Sites = append(inventory.Sites, fmt.Sprintf(\\\"%s:%d\\\", file.name, position.Line))\\n\\t\\t\\t}\\n\\t\\t\\treturn true\\n\\t\\t})\\n\\t\\tast.Inspect(file.syntax, func(node ast.Node) bool {\\n\\t\\t\\tcomposite, ok := node.(*ast.CompositeLit)\\n\\t\\t\\tif !ok {\\n\\t\\t\\t\\treturn true\\n\\t\\t\\t}\\n\\t\\t\\tidentifier, ok := composite.Type.(*ast.Ident)\\n\\t\\t\\tif !ok {\\n\\t\\t\\t\\treturn true\\n\\t\\t\\t}\\n\\t\\t\\tif _, ok := errorTypes[identifier.Name]; !ok {\\n\\t\\t\\t\\treturn true\\n\\t\\t\\t}\\n\\t\\t\\tif _, ok := permitted[ast.Node(composite)]; ok {\\n\\t\\t\\t\\treturn true\\n\\t\\t\\t}\\n\\t\\t\\tfor name, bounds := range constructorRanges {\\n\\t\\t\\t\\tif inventory.Constructors[name] == identifier.Name && composite.Pos() >= bounds[0] && composite.End() <= bounds[1] {\\n\\t\\t\\t\\t\\treturn true\\n\\t\\t\\t\\t}\\n\\t\\t\\t}\\n\\t\\t\\tposition := fileSet.Position(composite.Pos())\\n\\t\\t\\tinventory.StrayLiterals = append(inventory.StrayLiterals, fmt.Sprintf(\\\"%s:%d %s\\\", file.name, position.Line, identifier.Name))\\n\\t\\t\\treturn true\\n\\t\\t})\\n\\t}\\n\\tsort.Strings(inventory.Sites)\\n\",\n  \"original_output_bytes\": 1639,\n  \"original_output_tokens\": 410,\n  \"truncated\": false\n}","final_result":true}}}
