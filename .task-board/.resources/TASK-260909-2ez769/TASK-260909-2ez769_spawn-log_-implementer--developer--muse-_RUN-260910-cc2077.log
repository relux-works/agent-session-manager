{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca3b","stream":{"kind":"session","id":"01a088d0-e609-7bb2-8da2-c35b2ea0a045"},"sequence":888,"recorded_at":1780531400001771,"record_type":"event","durability":"durable","causation_id":"f897871b-85d1-4704-870d-e5ea0ee901cf","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f897871b-85d1-4704-870d-e5ea0ee901cf","run_stream":{"kind":"run","id":"f897871b-85d1-4704-870d-e5ea0ee901cf"},"task_stream":{"kind":"task","id":"01a088d4-0d7a-75f3-8f20-f7a1d2d500b0"},"task_id":"01a088d4-0d7a-75f3-8f20-f7a1d2d500b0","event":{"kind":"output","task_id":"01a088d4-0d7a-75f3-8f20-f7a1d2d500b0","chunk":"Read text file `internal/config/migration.go`.\n(399 line(s) above)\n400|}\n401|\n402|// Indirections keep compatibility-envelope parsing in this file while using\n403|// the same TOML implementation as Decode.\n404|var tomlDecode = func(document []byte, destination any) error {\n405|\treturn toml.Unmarshal(document, destination)\n406|}\n407|\n408|// migrationError is the only construction site for *MigrationError, for the\n409|// same reason loaderError is the only construction site for *Error.\n410|var migrationError = func(value MigrationError) error {\n411|\treturn &value\n412|}","final_result":true}}}
