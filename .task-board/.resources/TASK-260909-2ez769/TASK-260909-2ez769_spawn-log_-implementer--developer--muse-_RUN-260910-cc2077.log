{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000dfb3","stream":{"kind":"session","id":"01a088d0-e609-7bb2-8da2-c35b2ea0a045"},"sequence":3636,"recorded_at":1780531400007267,"record_type":"event","durability":"durable","causation_id":"f897871b-85d1-4704-870d-e5ea0ee901cf","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f897871b-85d1-4704-870d-e5ea0ee901cf","run_stream":{"kind":"run","id":"f897871b-85d1-4704-870d-e5ea0ee901cf"},"task_stream":{"kind":"task","id":"01a088e2-6f54-7263-abfa-f77bbbd67061"},"task_id":"01a088e2-6f54-7263-abfa-f77bbbd67061","event":{"kind":"output","task_id":"01a088e2-6f54-7263-abfa-f77bbbd67061","chunk":"{\n  \"chunk_id\": \"exec-72-1\",\n  \"command\": \"cat > internal/hosttrust/probe_test.go <<'EOF'\\npackage hosttrust\\n\\nimport (\\n\\t\\\"crypto/ecdsa\\\"\\n\\t\\\"crypto/elliptic\\\"\\n\\t\\\"crypto/rand\\\"\\n\\t\\\"crypto/x509\\\"\\n\\t\\\"crypto/x509/pkix\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"math/big\\\"\\n\\t\\\"testing\\\"\\n\\t\\\"time\\\"\\n)\\n\\nfunc TestProbeIssuedShape(t *testing.T) {\\n\\tkey, _ := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)\\n\\ttmpl := &x509.Certificate{\\n\\t\\tSerialNumber:          big.NewInt(1),\\n\\t\\tSubject:               pkix.Name{CommonName: \\\"AX Host Root x\\\"},\\n\\t\\tNotBefore:             time.Now().Add(-time.Hour),\\n\\t\\tNotAfter:              time.Now().Add(time.Hour),\\n\\t\\tKeyUsage:              x509.KeyUsageCertSign,\\n\\t\\tBasicConstraintsValid: true,\\n\\t\\tIsCA:                  true,\\n\\t\\tMaxPathLen:            0,\\n\\t\\tMaxPathLenZero:        true,\\n\\t}\\n\\tder, err := x509.CreateCertificate(rand.Reader, tmpl, tmpl, &key.PublicKey, key)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tcert, err := x509.ParseCertificate(der)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tfmt.Printf(\\\"Names=%d ExtraNames=%v IssuerNames=%d Country=%v Org=%v\\\\n\\\", len(cert.Subject.Names), cert.Subject.ExtraNames, len(cert.Issuer.Names), cert.Subject.Country, cert.Subject.Organization)\\n\\tfor _, atv := range cert.Subject.Names {\\n\\t\\tfmt.Printf(\\\"ATV type=%v value=%v\\\\n\\\", atv.Type, atv.Value)\\n\\t}\\n}\\nEOF\\ngo test ./internal/hosttrust/ -run TestProbeIssuedShape -count=1 -v 2>&1 | head -n 12\",\n  \"description\": \"Probe Go x509 parsed name shape\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"=== RUN   TestProbeIssuedShape\\nNames=1 ExtraNames=[] IssuerNames=1 Country=[] Org=[]\\nATV type=2.5.4.3 value=AX Host Root x\\n--- PASS: TestProbeIssuedShape (0.00s)\\nPASS\\nok  \\tgithub.com/relux-works/agent-session-manager/internal/hosttrust\\t0.640s\\n\",\n  \"original_output_bytes\": 243,\n  \"original_output_tokens\": 61,\n  \"truncated\": false\n}","final_result":true}}}
