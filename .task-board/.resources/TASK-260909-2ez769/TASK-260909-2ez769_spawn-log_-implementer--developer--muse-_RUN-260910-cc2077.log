{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cbb1","stream":{"kind":"session","id":"01a088d0-e609-7bb2-8da2-c35b2ea0a045"},"sequence":1075,"recorded_at":1780531400002145,"record_type":"event","durability":"durable","causation_id":"f897871b-85d1-4704-870d-e5ea0ee901cf","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f897871b-85d1-4704-870d-e5ea0ee901cf","run_stream":{"kind":"run","id":"f897871b-85d1-4704-870d-e5ea0ee901cf"},"task_stream":{"kind":"task","id":"01a088d5-863e-7f01-8c05-8d68933c5ba7"},"task_id":"01a088d5-863e-7f01-8c05-8d68933c5ba7","event":{"kind":"output","task_id":"01a088d5-863e-7f01-8c05-8d68933c5ba7","chunk":"{\n  \"chunk_id\": \"exec-40-1\",\n  \"command\": \"cat internal/scalar/uuid.go internal/scalar/time_digest.go 2>&1 | head -n 200\",\n  \"description\": \"Read scalar UUID, timestamp, digest\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"package scalar\\n\\nimport \\\"encoding/json\\\"\\n\\ntype UUIDv7 struct{ value string }\\ntype UUIDv4 struct{ value string }\\n\\nfunc ParseUUIDv7(value string) (UUIDv7, error) {\\n\\tif err := validateUUID(value, '7'); err != nil {\\n\\t\\treturn UUIDv7{}, err\\n\\t}\\n\\treturn UUIDv7{value: value}, nil\\n}\\n\\nfunc ParseUUIDv4(value string) (UUIDv4, error) {\\n\\tif err := validateUUID(value, '4'); err != nil {\\n\\t\\treturn UUIDv4{}, err\\n\\t}\\n\\treturn UUIDv4{value: value}, nil\\n}\\n\\nfunc validateUUID(value string, version byte) error {\\n\\tif len(value) != 36 || value[8] != '-' || value[13] != '-' || value[18] != '-' || value[23] != '-' {\\n\\t\\treturn invalid(\\\"UUIDv\\\"+string(version), \\\"must use canonical 8-4-4-4-12 form\\\")\\n\\t}\\n\\tfor index := range value {\\n\\t\\tif index == 8 || index == 13 || index == 18 || index == 23 {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tif !isLowerHex(value[index]) {\\n\\t\\t\\treturn invalid(\\\"UUIDv\\\"+string(version), \\\"must contain lowe