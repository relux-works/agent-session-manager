  \\\"sha256\\\": \\\"c0424738e542c397034797e9d9b2e08a224d7381272810bd9f55f03298ac8147\\\",\\n      \\\"bytes\\\": 6279,\\n      \\\"untracked\\\": true\\n    },\\n    {\\n      \\\"path\\\": \\\"internal/rpcwire/envelope.go\\\",\\n      \\\"sha256\\\": \\\"0e322f0e349c57d4571bcf2d3cad4821f5fa0821f9b4e77e8589f93b7cb979d5\\\",\\n      \\\"bytes\\\": 8404,\\n      \\\"untracked\\\": true\\n    },\\n    {\\n      \\\"path\\\": \\\"internal/rpcwire/envelope_test.go\\\",\\n      \\\"sha256\\\": \\\"dfddedd01bea7a0963b4d556ea964c63043c2b9b3a51cb202596f7d32310c623\\\",\\n      \\\"bytes\\\": 18975,\\n      \\\"untracked\\\": true\\n    },\\n    {\\n      \\\"path\\\": \\\"internal/rpcwire/hello.go\\\",\\n      \\\"sha256\\\": \\\"f5f9b47f7c47ad51ed84f72d7b689f2287e33aa2d288f4d1b529c74e75d3c258\\\",\\n      \\\"bytes\\\": 5379,\\n      \\\"untracked\\\": true\\n    },\\n    {\\n      \\\"path\\\": \\\"internal/rpcwire/inventory.go\\\",\\n      \\\"sha256\\\": \\\"9292376341a67da7f5c9d0071bb92c4b8f0f6cba7eb9facfe4f17344215e9257\\\",\\n      \\\"bytes\\\": 2149,\\n      \\\"untracked\\\": true\\n    },\\n    {\\n      \\\"path\\\": \\\"internal/rpcwire/mutations.py\\\",\\n      \\\"sha256\\\": \\\"ea5cb417be7fcaec40a83638adb8a7628352165068f70d7e97aa316b726044d1\\\",\\n      \\\"bytes\\\": 10690,\\n      \\\"untracked\\\": true\\n    },\\n    {\\n      \\\"path\\\": \\\"internal/rpcwire/testdata/contracts-v3.json\\\",\\n      \\\"sha256\\\": \\\"0887f72cc115915d4a330bb2d3e41ccf1dc1094f71f145dec49c8a9c96535a66\\\",\\n      \\\"bytes\\\": 879,\\n      \\\"untracked\\\": true\\n    },\\n    {\\n      \\\"path\\\": \\\"internal/rpcwire/testdata/contracts-v4.json\\\",\\n      \\\"sha256\\\": \\\"00802985148e84b49a6bfd4351f83124bdca9224cb541617531bc4762cd4277f\\\",\\n      \\\"bytes\\\": 930,\\n      \\\"untracked\\\": true\\n    },\\n    {\\n      \\\"path\\\": \\\"internal/rpcwire/testdata/hello-request-v2.json\\\",\\n      \\\"sha256\\\": \\\"3c92c8a84eac5a9b423c663b9e4d9f6f0b566