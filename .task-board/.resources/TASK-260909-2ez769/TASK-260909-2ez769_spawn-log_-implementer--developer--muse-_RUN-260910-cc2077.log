imePlatform.String()); err != nil {\n424|\t\treturn LoadedConfiguration{}, configError(\"platform\", ErrConfigValidation)\n425|\t}\n426|\tvar envelope rawEnvelope\n427|\tif err := toml.NewDecoder(bytes.NewReader(document)).Decode(&envelope); err != nil {\n428|\t\treturn LoadedConfiguration{}, configError(\"TOML\", errors.Join(ErrConfigDecode, err))\n429|\t}\n430|\tif envelope.Schema != SchemaID {\n431|\t\treturn LoadedConfiguration{}, configError(\"schema\", ErrConfigValidation)\n432|\t}\n433|\n434|\tvar value Configuration\n435|\tvar err error\n436|\tswitch envelope.SchemaVersion {\n437|\tcase Version1:\n438|\t\tvar raw rawV1\n439|\t\tif err = decodeStrict(document, &raw); err == nil {\n440|\t\t\tvalue, err = translateV1(raw, context)\n441|\t\t}\n442|\tcase Version2:\n443|\t\tvar raw rawV2\n444|\t\tif err = decodeStrict(document, &raw); err == nil {\n445|\t\t\tvalue, err = translateV2(raw, context)\n446|\t\t}\n447|\tcase CurrentVersion:\n448|\t\tvar raw rawV3\n449|\t\tif err = decodeStrict(document, &raw); err == nil {\n450|\t\t\tvalue, err = translateV3(raw, context)\n451|\t\t}\n452|\tdefault:\n453|\t\treturn LoadedConfiguration{}, configError(\"schema_version\", ErrUnsupportedConfigVersion)\n454|\t}\n455|\tif err != nil {\n456|\t\treturn LoadedConfiguration{}, err\n457|\t}\n458|\treturn LoadedConfiguration{SourceVersion: envelope.SchemaVersion, Value: value}, nil\n459|}\n460|\n461|func decodeStrict(document []byte, destination any) error {\n462|\tdecoder := toml.NewDecoder(bytes.NewReader(document)).DisallowUnknownFields()\n463|\tif err := decoder.Decode(destination); err != nil {\n464|\t\treturn configError(\"closed TOML shape\", errors.Join(ErrConfigDecode, err))\n465|\t}\n466|\tvar shape map[string]any\n467|\tif err := toml.Unmarshal(document, &shape); err != nil {\n468|\t\treturn configError(\"closed TOML shape\", errors.Join(ErrConfigDecode, err)) // config-refusal-subsumed: envelope TOML syntax parse\n469|\t}\n470|\trestorePresentEmptyMaps(reflect.ValueOf(destination), reflect.ValueOf(shape))\n471|\treturn nil\n472|}\n473|\n474|// restorePresentEmptyMaps repairs a go-toml decoding ambiguity without\n475|// weakening required-member validation. go-toml leaves a map field nil for a\n476|// present but empty table such as [entry.extensions], which is otherwise\n477|// indistinguishable from an absent required member in the typed value. The\n478|// generic document shape retains table presence, so this schema-driven walk\n479|// initializes only map members that were actually present in the source.\n480|func restorePresentEmptyMaps(destination, source reflect.Value) {\n481|\tdestination = indirectValue(destination)\n482|\tsource = indirectValue(source)\n483|\tif !destination.IsValid() || !source.IsValid() {\n484|\t\treturn\n485|\t}\n486|\n487|\tswitch destination.Kind() {\n488|\tcase reflect.Struct:\n489|\t\tif source.Kind() != reflect.Map || source.Type().Key().Kind() != reflect.String {\n490|\t\t\treturn\n491|\t\t}\n492|\t\tfor index := 0; index < destination.NumField(); index++ {\n493|\t\t\tfieldType := destination.Type().Field(index)\n494|\t\t\tname := strings.Split(fieldType.Tag.Get(\"toml\"), \",\")[0]\n495|\t\t\tif name == \"\" || name == \"-\" {\n496|\t\t\t\tcontinue\n497|\t\t\t}\n498|\t\t\tsourceField := source.MapIndex(reflect.ValueOf(name).Convert(source.Type().Key()))\n499|\t\t\tif !sourceField.IsValid() {\n500|\t\t\t\tcontinue\n501|\t\t\t}\n502|\t\t\tdestinationField := destination.Field(index)\n503|\t\t\tunwrappedSource := indirectValue(sourceField)\n504|\t\t\tif destinationField.Kind() == reflect.Map {\n505|\t\t\t\tif destinationField.IsNil() && unwrappedSource.IsValid() && unwrappedSource.Kind() == reflect.Map {\n506|\t\t\t\t\tdestinationField.Set(reflect.MakeMap(destinationField.Type()))\n507|\t\t\t\t}\n508|\t\t\t\tcontinue\n509|\t\t\t}\n510|\t\t\trestorePresentEmptyMaps(destinationField, sourceField)\n511|\t\t}\n512|\tcase reflect.Slice:\n513|\t\tif source.Kind() != reflect.Slice {\n514|\t\t\treturn\n515|\t\t}\n516|\t\tlimit := destination.Len()\n517|\t\tif source.Len() < limit {\n518|\t\t\tlimit = source.Len()\n519|\t\t}\n520|\t\tfor index := 0; index < limit; index++ {\n521|\t\t\trestorePresentEmptyMaps(destination.Index(index), source.Index(index))\n522|\t\t}\n523|\t}\n524|}\n525|\n526|func indirectValue(value reflect.Value) reflect.Value {\n527|\tfor value.IsValid() && (value.Kind() == reflect.Interface || value.Kind() == reflect.Pointer) {\n528|\t\tif value.IsNil() {\n529|\t\t\treturn reflect.Value{}\n(more lines below)","final_result":true}}}
