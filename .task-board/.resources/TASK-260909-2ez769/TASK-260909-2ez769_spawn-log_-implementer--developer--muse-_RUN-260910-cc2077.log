{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000e03b","stream":{"kind":"session","id":"01a088d0-e609-7bb2-8da2-c35b2ea0a045"},"sequence":3704,"recorded_at":1780531400007403,"record_type":"event","durability":"durable","causation_id":"f897871b-85d1-4704-870d-e5ea0ee901cf","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f897871b-85d1-4704-870d-e5ea0ee901cf","run_stream":{"kind":"run","id":"f897871b-85d1-4704-870d-e5ea0ee901cf"},"task_stream":{"kind":"task","id":"01a088e2-9f34-7e73-95a1-9eafe4f0d713"},"task_id":"01a088e2-9f34-7e73-95a1-9eafe4f0d713","event":{"kind":"output","task_id":"01a088e2-9f34-7e73-95a1-9eafe4f0d713","chunk":"edited\nchanged lines: lines 3-8\n--- original\n+++ updated\n@@\n-import (\n-\t\"bytes\"\n-\t\"crypto/ecdsa\"\n-\t\"crypto/elliptic\"\n-\t\"crypto/x509\"\n-)\n+import (\n+\t\"bytes\"\n+\t\"crypto/ecdsa\"\n+\t\"crypto/elliptic\"\n+\t\"crypto/x509\"\n+\t\"crypto/x509/pkix\"\n+\t\"encoding/asn1\"\n+)\n+\n+var oidCommonName = asn1.ObjectIdentifier{2, 5, 4, 3}\n+\n+// subjectIsOnlyCN accepts exactly the profile subject: the expected common\n+// name and no other subject attribute. The parsed CN is itself one ATV in\n+// Names, so CN-only means precisely one ATV with the CN OID and value.\n+func subjectIsOnlyCN(name pkix.Name, commonName string) bool {\n+\tif name.CommonName != commonName || name.SerialNumber != \"\" {\n+\t\treturn false\n+\t}\n+\tif len(name.Country) != 0 || len(name.Organization) != 0 || len(name.OrganizationalUnit) != 0 {\n+\t\treturn false\n+\t}\n+\tif len(name.Locality) != 0 || len(name.Province) != 0 || len(name.StreetAddress) != 0 || len(name.PostalCode) != 0 {\n+\t\treturn false\n+\t}\n+\tif len(name.ExtraNames) != 0 || len(name.Names) != 1 {\n+\t\treturn false\n+\t}\n+\tif !name.Names[0].Type.Equal(oidCommonName) {\n+\t\treturn false\n+\t}\n+\tvalue, ok := name.Names[0].Value.(string)\n+\treturn ok && value == commonName\n+}\n","final_result":true}}}
