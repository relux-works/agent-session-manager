ode is deliberately narrower than runtime capability state.\n80|type CompatibilityMode string\n81|\n82|const (\n83|\tCompatibilityCompatible CompatibilityMode = \"compatible\"\n84|\tCompatibilityReadOnly   CompatibilityMode = \"read-only-diagnostic\"\n85|)\n86|\n87|// CompatibilityAssessment contains only envelope facts needed to prevent a\n88|// downgraded writer. It exposes no decoded Configuration and performs no I/O.\n89|type CompatibilityAssessment struct {\n90|\tReaderVersion string\n91|\tSourceVersion string\n92|\tMode          CompatibilityMode\n93|}\n94|\n95|// AssessCompatibility determines whether a known reader may open the document\n96|// normally or must remain read-only. Newer documents are not decoded or\n97|// rewritten, so fields unknown to the older reader remain untouched.\n98|func AssessCompatibility(document []byte, readerVersion string) (CompatibilityAssessment, error) {\n99|\treader, ok := knownConfigVersion(readerVersion)\n100|\tif !ok {\n101|\t\treturn CompatibilityAssessment{}, migrationError(MigrationError{Operation: \"assess reader\", Err: ErrCompatibilityReader})\n102|\t}\n103|\tvar envelope rawEnvelope\n104|\tif err := decodeEnvelope(document, &envelope); err != nil {\n105|\t\treturn CompatibilityAssessment{}, err\n106|\t}\n107|\tif envelope.Schema != SchemaID {\n108|\t\treturn CompatibilityAssessment{}, configError(\"schema\", ErrConfigValidation)\n109|\t}\n110|\tsource, err := parseSemverCore(envelope.SchemaVersion)\n111|\tif err != nil {\n112|\t\treturn CompatibilityAssessment{}, configError(\"schema_version\", errors.Join(ErrCompatibilityAssessment, err))\n113|\t}\n114|\tmode := CompatibilityCompatible\n115|\tif compareSemver(source, reader) > 0 {\n116|\t\tmode = CompatibilityReadOnly\n117|\t} else if _, known := knownConfigVersion(envelope.SchemaVersion); !known {\n118|\t\treturn CompatibilityAssessment{}, configError(\"schema_version\", ErrUnsupportedConfigVersion)\n119|\t}\n120|\treturn CompatibilityAssessment{ReaderVersion: readerVersion, SourceVersion: envelope.SchemaVersion, Mode: mode}, nil\n121|}\n122|\n123|type semverCore struct{ major, minor, patch uint64 }\n124|\n125|func knownConfigVersion(value string) (semverCore, bool) {\n126|\tswitch value {\n127|\tcase Version1, Version2, CurrentVersion:\n128|\t\tparsed, _ := parseSemverCore(value)\n129|\t\treturn parsed, true\n130|\tdefault:\n131|\t\treturn semverCore{}, false\n132|\t}\n133|}\n134|\n135|func parseSemverCore(value string) (semverCore, error) {\n136|\tparts := strings.Split(value, \".\")\n137|\tif len(parts) != 3 {\n138|\t\treturn semverCore{}, ErrUnsupportedConfigVersion\n139|\t}\n140|\tvalues := make([]uint64, 3)\n141|\tfor index, part := range parts {\n142|\t\tif part == \"\" || (len(part) > 1 && part[0] == '0') {\n143|\t\t\treturn semverCore{}, ErrUnsupportedConfigVersion\n144|\t\t}\n145|\t\tparsed, err := strconv.ParseUint(part, 10, 64)\n146|\t\tif err != nil {\n147|\t\t\treturn semverCore{}, ErrUnsupportedConfigVersion\n148|\t\t}\n149|\t\tvalues[index] = parsed\n150|\t}\n151|\treturn semverCore{major: values[0], minor: values[1], patch: values[2]}, nil\n152|}\n153|\n154|func compareSemver(left, right semverCore) int {\n155|\tif left.major != right.major {\n156|\t\tif left.major < right.major {\n157|\t\t\treturn -1\n158|\t\t}\n159|\t\treturn 1\n160|\t}\n161|\tif left.minor != right.minor {\n162|\t\tif left.minor < right.minor {\n163|\t\t\treturn -1\n164|\t\t}\n165|\t\treturn 1\n166|\t}\n167|\tif left.patch != right.patch {\n168|\t\tif left.patch < right.patch {\n169|\t\t\treturn -1\n170|\t\t}\n171|\t\treturn 1\n172|\t}\n173|\treturn 0\n174|}\n175|\n176|func decodeEnvelope(document []byte, envelope *rawEnvelope) error {\n177|\tif err := tomlDecode(document, envelope); err != nil {\n178|\t\treturn configError(\"TOML\", errors.Join(ErrConfigDecode, err))\n179|\t}\n180|\treturn nil\n181|}\n182|\n183|func migrate(inputs Inputs, overrides Overrides, options MigrationOptions, filesystem migrationFileSystem) (MigrationResult, error) {\n184|\ttarget, targetKnown := knownConfigVersion(options.TargetVersion)\n185|\tif !targetKnown || options.TargetVersion == Version1 {\n186|\t\treturn MigrationResult{}, migrationError(MigrationError{Operation: \"select target\", Err: ErrMigrationTarget})\n187|\t}\n188|\tsnapshot, err := Load(inputs, overrides)\n189|\tif err != nil {\n190|\t\treturn MigrationResult{}, err\n191|\t}\n192|\tloaded, decoded := snapshot.Configuration()\n193|\tif !snapshot.ConfigPresent() || !decoded {\n194|\t\treturn MigrationResult{}, migrationError(MigrationError{Operation: \"load source\", Err: ErrMigrationSourceAbsent})\n195|\t}\n196|\tsource, _ := knownConfigVersion(loaded.SourceVersion)\n197|\tresult := MigrationResult{SourceVersion: loaded.SourceVersion, TargetVersion: options.TargetVersion}\n198|\tif compareSemver(source, target) > 0 {\n199|\t\treturn result, migrationError(MigrationError{Operation: \"select target\", Err: ErrMigrationDowngrade})\n200|\t}\n201|\tif compareSemver(source, target) == 0 {\n202|\t\treturn result, nil\n203|\t}\n204|\tif loaded.SourceVersion == Version1 {\n205|\t\tif !oneOf(options.GeneratedSummaryUpgradeChoice, \"local_only\", \"mesh_sanitized\", \"reference_only\") {\n206|\t\t\treturn result, migrationError(MigrationError{Operation: \"validate disclosure choice\", Err: ErrMigrationChoiceRequired})\n207|\t\t}\n208|\t\tloaded.Value.Directory.GeneratedSummaryUpgradeChoice = options.GeneratedSummaryUpgradeChoice\n209|\t}\n210|\tcontext := DecodeContext{RuntimePlatform: inputs.Platform, BackendSettings: inputs.BackendSettings}\n211|\tvar replacement []byte\n212|\tswitch options.TargetVersion {\n213|\tcase Version2:\n214|\t\treplacement, err = encodeVersion2(loaded.Value, context)\n215|\tcase CurrentVersion:\n216|\t\treplacement, err = EncodeCurrent(loaded.Value, context)\n217|\t}\n218|\tif err != nil {\n219|\t\treturn result, migrationError(MigrationError{Operation: \"encode target\", Err: err}) // config-refusal-subsumed: every encoder refusal below this propagation is pinned on its own clause, at writer.go terminal.backend and writer.go v2 wire TOML for the v2 encoder, at writer.go v2 re-read for its defence-in-depth round trip, and by the EncodeCurrent validation suite for v3\n220|\t}\n221|\tselected, _ := snapshot.Paths().Path(ConfigFile)\n222|\tfilename := selected.Value.String()\n223|\tbackup := filename + \".bak.\" + loaded.SourceVersion\n224|\tresult.BackupPath = backup\n225|\tif err := replaceDurably(filesystem, filename, backup, snapshot.Document(), replacement); err != nil {\n226|\t\treturn result, err\n227|\t}\n228|\tresult.Changed = true\n229|\treturn result, nil\n230|}\n231|\n232|type migrationFile interface {\n233|\tio.Writer\n234|\tName() string\n235|\tChmod(fs.FileMode) error\n236|\tSync() error\n237|\tClose() error\n238|}\n239|\n240|type migrationDirectory interface {\n241|\tSync() error\n242|\tClose() error\n243|}\n244|\n245|type migrationFileSystem interface {\n246|\tCreateTemp(string, string) (migrationFile, error)\n247|\tLink(string, string) error\n248|\tReadFile(string) ([]byte, error)\n249|\tStat(string) (fs.FileInfo, error)\n250|\tRemove(string) error\n251|\tRename(string, string) error\n252|\tOpenDirectory(string) (migrationDirectory, error)\n253|}\n254|\n255|type osMigrationFileSystem struct{}\n256|\n257|func (osMigrationFileSystem) CreateTemp(dir, pattern string) (migrationFile, error) {\n258|\treturn os.CreateTemp(dir, pattern)\n259|}\n260|func (osMigrationFileSystem) Link(oldname, newname string) error   { return os.Link(oldname, newname) }\n261|func (osMigrationFileSystem) ReadFile(name string) ([]byte, error) { return os.ReadFile(name) }\n262|\n263|// Stat does not follow a symlink, unlike the symlink-following read-side seam\n264|// in OSInputs. Durable migration replaces the selected file with an atomic\n265|// rename, which replaces a symlink itself rather than its target: migrating a\n266|// symlinked configuration would silently detach the operator's link and leave\n267|// the real document holding stale bytes next to a backup of the resolved\n268|// target. The specification is silent here, so the mutating path fails closed\n269|// with ErrConfigNotRegular instead of guessing which file the operator meant.\n270|func (osMigrationFileSystem) Stat(name string) (fs.FileInfo, error) { return os.Lstat(name) }\n271|func (osMigrationFileSystem) Remove(name string) error              { return os.Remove(name) }\n272|func (osMigrationFileSystem) Rename(oldname, newname string) error {\n273|\treturn os.Rename(oldname, newname)\n274|}\n275|func (osMigrationFileSystem) OpenDirectory(name string) (migrationDirectory, error) {\n276|\treturn os.Open(name)\n277|}\n278|\n279|func replaceDurably(filesystem migrationFileSystem, filename, backup string, original, replacement []byte) error {\n280|\tdirectory := filepath.Dir(filename)\n281|\t// Re-inspect the selected file before anything durable is written. Load\n282|\t// resolved and validated it through the symlink-following read seam; this\n283|\t// mutating seam does not follow symlinks, so a selected file that is not\n284|\t// itself a regular file is refused here rather than after a backup has\n285|\t// already been published. A refused migration therefore leaves the\n286|\t// directory exactly as it found it, and the captured permission bits are\n287|\t// the ones the replacement inherits.\n288|\tinfo, err := filesystem.Stat(filename)\n289|\tif err != nil {\n290|\t\treturn migrationError(MigrationError{Operation: \"inspect source mode\", Err: errors.Join(ErrMigrationWrite, err)})\n291|\t}\n292|\tif !info.Mode().IsRegular() {\n293|\t\treturn migrationError(MigrationError{Operation: \"inspect source mode\", Err: errors.Join(ErrMigrationWrite, ErrConfigNotRegular)})\n294|\t}\n295|\tbackupTemp, err := writeTempFile(filesystem, directory, \".ax-config-backup-*\", original, 0o600)\n296|\tif err != nil {\n297|\t\treturn migrationError(MigrationError{Operation: \"write backup\", Err: errors.Join(ErrMigrationBackup, err)})\n298|\t}\n299|\tif err := filesystem.Link(backupTemp, backup); err != nil {\n300|\t\tif !errors.Is(err, fs.ErrExist) {\n301|\t\t\t_ = filesystem.Remove(backupTemp)\n302|\t\t\treturn migrationError(MigrationError{Operation: \"publish backup\", Err: errors.Join(ErrMigrationBackup, err)})\n303|\t\t}\n304|\t\texisting, readErr := filesystem.ReadFile(backup)\n305|\t\tinfo, statErr := filesystem.Stat(backup)\n306|\t\tif readErr != nil || statErr != nil || !bytes.Equal(existing, original) || info.Mode().Perm()&0o077 != 0 {\n307|\t\t\t_ = filesystem.Remove(backupTemp)\n308|\t\t\treturn migrationError(MigrationError{Operation: \"verify backup\", Err: ErrMigrationBackup})\n309|\t\t}\n310|\t}\n311|\tif err := filesystem.Remove(backupTemp); err != nil && !errors.Is(err, fs.ErrNotExist) {\n312|\t\treturn migrationError(MigrationError{Operation: \"remove backup staging file\", Err: errors.Join(ErrMigrationBackup, err)})\n313|\t}\n314|\t// Retry the directory sync even when an exact backup already exists: it may\n315|\t// be the visible result of an interrupted run whose directory fsync failed.\n316|\tif err := syncDirectory(filesystem, directory); err != nil {\n317|\t\treturn migrationError(MigrationError{Operation: \"sync backup directory\", Err: errors.Join(ErrMigrationSync, err)})\n318|\t}\n319|\n320|\treplacementTemp, err := writeTempFile(filesystem, directory, \".ax-config-migrate-*\", replacement, info.Mode().Perm())\n321|\tif err != nil {\n322|\t\treturn migrationError(MigrationError{Operation: \"write replacement\", Err: errors.Join(ErrMigrationWrite, err)})\n323|\t}\n324|\tif err := filesystem.Rename(replacementTemp, filename); err != nil {\n325|\t\t_ = filesystem.Remove(replacementTemp)\n326|\t\treturn migrationError(MigrationError{Operation: \"replace source\", Err: errors.Join(ErrMigrationReplace, err)})\n327|\t}\n328|\tif err := syncDirectory(filesystem, directory); err == nil {\n329|\t\treturn nil\n330|\t} else {\n331|\t\tsyncErr := err\n332|\t\trollbackTemp, rollbackErr := writeTempFile(filesystem, directory, \".ax-config-rollback-*\", original, info.Mode().Perm())\n333|\t\tif rollbackErr == nil {\n334|\t\t\trollbackErr = filesystem.Rename(rollbackTemp, filename)\n335|\t\t}\n336|\t\tif rollbackErr == nil {\n337|\t\t\trollbackErr = syncDirectory(filesystem, directory)\n338|\t\t}\n339|\t\tif rollbackErr != nil {\n340|\t\t\tif rollbackTemp != \"\" {\n341|\t\t\t\t_ = filesystem.Remove(rollbackTemp)\n342|\t\t\t}\n343|\t\t\treturn migrationError(MigrationError{Operation: \"recover source after sync\", Err: errors.Join(ErrMigrationSync, ErrMigrationRecovery, syncErr, rollbackErr)})\n344|\t\t}\n345|\t\treturn migrationError(MigrationError{Operation: \"sync replacement directory\", Err: errors.Join(ErrMigrationSync, syncErr)})\n346|\t}\n347|}\n348|\n349|func writeTempFile(filesystem migrationFileSystem, directory, pattern string, document []byte, mode fs.FileMode) (name string, err error) {\n350|\tfile, err := filesystem.CreateTemp(directory, pattern)\n351|\tif err != nil {\n352|\t\treturn \"\", err\n353|\t}\n354|\tname = file.Name()\n355|\tclean := func(cause error) (string, error) {\n356|\t\t_ = file.Close()\n357|\t\t_ = filesystem.Remove(name)\n358|\t\treturn \"\", cause\n359|\t}\n360|\tif err := file.Chmod(mode); err != nil {\n361|\t\treturn clean(err)\n362|\t}\n363|\tif err := writeAll(file, document); err != nil {\n364|\t\treturn clean(err)\n365|\t}\n366|\tif err := file.Sync(); err != nil {\n367|\t\treturn clean(err)\n368|\t}\n369|\tif err := file.Close(); err != nil {\n370|\t\t_ = filesystem.Remove(name)\n371|\t\treturn \"\", err\n372|\t}\n373|\treturn name, nil\n374|}\n375|\n376|func writeAll(writer io.Writer, document []byte) error {\n377|\tfor len(document) > 0 {\n378|\t\twritten, err := writer.Write(document)\n379|\t\tif err != nil {\n380|\t\t\treturn err\n381|\t\t}\n382|\t\tif written == 0 {\n383|\t\t\treturn io.ErrShortWrite\n384|\t\t}\n385|\t\tdocument = document[written:]\n386|\t}\n387|\treturn nil\n388|}\n389|\n390|func syncDirectory(filesystem migrationFileSystem, directory string) error {\n391|\thandle, err := filesystem.OpenDirectory(directory)\n392|\tif err != nil {\n393|\t\treturn err\n394|\t}\n395|\tif err := handle.Sync(); err != nil {\n396|\t\t_ = handle.Close()\n397|\t\treturn err\n398|\t}\n399|\treturn handle.Close()\n400|}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca03","stream":{"kind":"session","id":"01a088d0-e609-7bb2-8da2-c35b2ea0a045"},"sequence":860,"recorded_at":1780531400001715,"record_type":"event","durability":"durable","causation_id":"f897871b-85d1-4704-870d-e5ea0ee901cf","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f897871b-85d1-4704-870d-e5ea0ee901cf","run_stream":{"kind":"run","id":"f897871b-85d1-4704-870d-e5ea0ee901cf"},"call_id":"call_01a088d3f7797e908839cfc6a145a9be","text":"Read text file `internal/peeridentity/identity.go`.\n1|// Package peeridentity resolves explicitly configured mesh identities. It does\n2|// not discover hosts, authenticate SSH connections, or read key material.\n3|package peeridentity\n4|\n5|import (\n6|\t\"errors\"\n7|\t\"fmt\"\n8|\t\"strings\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/config\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|var (\n15|\tErrConfigurationRequired = errors.New(\"peer identity requires an existing valid configuration\")\n16|\tErrNotAllowlisted        = errors.New(\"peer_not_allowlisted\")\n17|\tErrAmbiguousAlias        = errors.New(\"peer alias is ambiguous with a configured host ID\")\n18|\tErrHostIdentityMismatch  = errors.New(\"host_identity_mismatch\")\n19|\tErrDisclosureDenied      = errors.New(\"peer metadata disclosure refused\")\n20|\tErrSSHArgvTooLarge       = errors.New(\"peer SSH argv exceeds configuration byte bound\")\n21|)\n22|\n23|// Directory is an immutable configuration snapshot. Its zero value admits no\n24|// peers. Construct it with Load or FromSnapshot, never from a discovered host.\n25|type Directory struct {\n26|\tlocal         Host\n27|\tpeers         []config.Peer\n28|\tsourceVersion string\n29|\tdefaultPolicy string\n30|\tsummaryChoice string\n31|\tdisclosure    []config.DirectoryPeerDisclosure\n32|}\n33|\n34|// Host is stable identity plus a display alias, not authentication evidence.\n35|type Host struct {\n36|\tID       string\n37|\tName     string\n38|\tPlatform scalar.Platform\n39|}\n40|\n41|// Load uses the canonical configuration loader, including path precedence and\n42|// failed-read handling. Missing configuration never creates a host identity.\n43|func Load(inputs config.Inputs, overrides config.Overrides) (Directory, error) {\n44|\tsnapshot, err := config.Load(inputs, overrides)\n45|\tif err != nil {\n46|\t\treturn Directory{}, err\n47|\t}\n48|\treturn FromSnapshot(snapshot)\n49|}\n50|\n51|// FromSnapshot reuses the process-lifetime configuration decision. Snapshot's\n52|// private state prevents an unvalidated Configuration from becoming an allowlist.\n53|func FromSnapshot(snapshot config.Snapshot) (Directory, error) {\n54|\tloaded, ok := snapshot.Configuration()\n55|\tif !ok {\n56|\t\treturn Directory{}, ErrConfigurationRequired\n57|\t}\n58|\tc := loaded.Value\n59|\treturn Directory{\n60|\t\tlocal: Host{c.HostID, c.HostName, c.Platform}, peers: c.Mesh.Peers,\n61|\t\tsourceVersion: loaded.SourceVersion, defaultPolicy: c.Directory.DefaultMetadataPolicy,\n62|\t\tsummaryChoice: c.Directory.GeneratedSummaryUpgradeChoice, disclosure: c.DirectoryPeerDisclosure,\n63|\t}, nil\n64|}\n65|\n66|func (d Directory) Local() Host { return d.local }\n67|\n68|// Formatting a directory must not expose its retained SSH execution inputs.\n69|func (d Directory) String() string                    { return \"configured peer directory\" }\n70|func (d Directory) GoString() string                  { return d.String() }\n71|func (d Directory) Format(state fmt.State, verb rune) { _, _ = state.Write([]byte(d.String())) }\n72|\n73|// Resolve selects an exact configured host ID or exact display alias. Aliases\n74|// are not case-folded or normalized. A name equal to another peer's ID is\n75|// ambiguous, even though the two individually unique registries are valid.\n76|func (d Directory) Resolve(selector string) (Target, error) {\n77|\tmatch := -1\n78|\tfor i, peer := range d.peers {\n79|\t\tif peer.HostID != selector && peer.Name != selector {\n80|\t\t\tcontinue\n81|\t\t}\n82|\t\tif match >= 0 {\n83|\t\t\treturn Target{}, ErrAmbiguousAlias\n84|\t\t}\n85|\t\tmatch = i\n86|\t}\n87|\tif match < 0 {\n88|\t\treturn Target{}, ErrNotAllowlisted\n89|\t}\n90|\tpeer := d.peers[match]\n91|\treturn Target{host: Host{peer.HostID, peer.Name, peer.Platform}, endpoint: peer.Endpoint,\n92|\t\targs: append([]string(nil), peer.SSHArgs...)}, nil\n93|}\n94|\n95|// Target can only be obtained from a Directory. It is a connection plan, never\n96|// proof that SSH authenticated a host or that a peer's protocol assertion is true.\n97|// Endpoint and identity-file selectors are machine-local execution inputs; the\n98|// formatting methods deliberately exclude them from logs and diagnostics.\n99|type Target struct {\n100|\thost     Host\n101|\tendpoint string\n102|\targs     []string\n103|}\n104|\n105|func (t Target) Host() Host                        { return t.host }\n106|func (t Target) String() string                    { return \"configured SSH target\" }\n107|func (t Target) GoString() string                  { return t.String() }\n108|func (t Target) Format(state fmt.State, verb rune) { _, _ = state.Write([]byte(t.String())) }\n109|\n110|// KeyProvenance reports the authority boundary, not an observed key or a\n111|// fingerprint. The pinned contract delegates both host-key and user-key policy\n112|// to external SSH. No AX key registry, private-key reader, or verification flag\n113|// is invented here. Empty targets have no provenance.\n114|func (t Target) KeyProvenance() string {\n115|\tif t.endpoint == \"\" {\n116|\t\treturn \"\"\n117|\t}\n118|\treturn \"external_ssh\"\n119|}\n120|\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
