tHostA}, testNow), ErrNotAllowlisted},\n107|\t\t{\"hello mismatch\", dispatchRequest(localSnap, localCredential, peerCredential, testHostC, leafDER, rootDER, allowlist, testNow), ErrHostIdentityMismatch},\n108|\t\t{\"wrong destination\", func() AuthRequest {\n109|\t\t\trequest := dispatchRequest(localSnap, localCredential, peerCredential, testHostB, leafDER, rootDER, allowlist, testNow)\n110|\t\t\trequest.ExpectedRemoteHostID = testHostC\n111|\t\t\treturn request\n112|\t\t}(), ErrHostIdentityMismatch},\n113|\t\t{\"expired credentials\", dispatchRequest(localSnap, localCredential, peerCredential, testHostB, leafDER, rootDER, allowlist, testNow.Add(91*24*time.Hour)), ErrAuthorizationRefused},\n114|\t}\n115|\tfor _, test := range tests {\n116|\t\tt.Run(test.name, func(t *testing.T) {\n117|\t\t\tif err := local.AuthorizeDispatch(localSnap, test.request); err == nil {\n118|\t\t\t\tt.Fatalf(\"AuthorizeDispatch(%s) succeeded, want refusal\", test.name)\n119|\t\t\t} else if !errors.Is(err, test.want) {\n120|\t\t\t\tt.Fatalf(\"AuthorizeDispatch(%s) error = %v, want %v\", test.name, err, test.want)\n121|\t\t\t}\n122|\t\t})\n123|\t}\n124|}\n125|\n126|func TestRevocationClosesAuthorization(t *testing.T) {\n127|\tlocal, peer, localCredential, peerCredential, localSnap, _ := twoHostFixture(t)\n128|\tleafDER, rootDER := peerMaterialForTest(t, peer, peerCredential)\n129|\tallowlist := []string{testHostA, testHostB}\n130|\trequest := dispatchRequest(localSnap, localCredential, peerCredential, testHostB, leafDER, rootDER, allowlist, testNow)\n131|\tif err := local.AuthorizeDispatch(localSnap, request); err != nil {\n132|\t\tt.Fatalf(\"pre-revocation AuthorizeDispatch error = %v\", err)\n133|\t}\n134|\tif err := local.Revoke(peerCredential); err != nil {\n135|\t\tt.Fatalf(\"Revoke error = %v\", err)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
