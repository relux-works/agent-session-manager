{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cae1","stream":{"kind":"session","id":"01a0ad6d-f2e1-7d43-9e77-843c8eea6221"},"sequence":971,"recorded_at":1780531400001937,"record_type":"event","durability":"durable","causation_id":"9d656e52-9607-486f-955f-021a4f63ae37","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9d656e52-9607-486f-955f-021a4f63ae37","run_stream":{"kind":"run","id":"9d656e52-9607-486f-955f-021a4f63ae37"},"task_stream":{"kind":"task","id":"01a0ad73-22d3-7020-a785-ff116b6be2ab"},"task_id":"01a0ad73-22d3-7020-a785-ff116b6be2ab","event":{"kind":"output","task_id":"01a0ad73-22d3-7020-a785-ff116b6be2ab","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1kiyj6/worktree/internal/config/writepath_census_test.go`.\n(559 line(s) above)\n560|}\n561|\n562|// TestWritePathCensusRejectsUnlistedInterfaceCallSite copies the production\n563|// source into an isolated module, plants two real filesystem renames in\n564|// replaceDurably at new positions, and runs the production census plus a\n565|// valid-hold witness. The pre-hold plant proves ordering; the post-hold plant\n566|// proves that an unlisted site cannot inherit authorization from the same\n567|// interface method. The test expects the child census to fail while the\n568|// witness succeeds, so a site-admission mutant is observable behaviorally.\n569|func TestWritePathCensusRejectsUnlistedInterfaceCallSite(t *testing.T) {\n570|\tproject := filepath.Join(t.TempDir(), \"project\")\n571|\tcopyCensusProject(t, censusModuleRoot(), project)\n572|\tapplyCensusMutationOverlay(t, project)\n573|\n574|\tmigrationPath := filepath.Join(project, \"internal\", \"config\", \"migration.go\")\n575|\tsource, err := os.ReadFile(migrationPath)\n576|\tif err != nil {\n577|\t\tt.Fatal(err)\n578|\t}\n579|\tconst holdGuard = \"\\tif err := requireHoldForConfig(hold, paths); err != nil {\\n\\t\\treturn err\\n\\t}\"\n580|\tconst plantedGuard = \"\\tif backup == \\\"reviewer-pre-hold\\\" { return filesystem.Rename(string(original), string(replacement)) }; if err := requireHoldForConfig(hold, paths); err != nil {\\n\\t\\treturn err\\n\\t}; if backup == \\\"reviewer-post-hold\\\" { return filesystem.Rename(string(original), string(replacement)) }\"\n581|\tif !strings.Contains(string(source), holdGuard) {\n582|\t\tt.Fatal(\"replaceDurably hold guard was not found in the census plant source\")\n583|\t}\n584|\tplanted := strings.Replace(string(source), holdGuard, plantedGuard, 1)\n585|\tif err := os.WriteFile(migrationPath, []byte(planted), 0o600); err != nil {\n586|\t\tt.Fatal(err)\n587|\t}\n588|\n589|\twitness := `package config\n590|\n591|import (\n592|\t\"os\"\n593|\t\"path/filepath\"\n594|\t\"testing\"\n595|\n596|\t\"github.com/relux-works/agent-session-manager/internal/hosttrust\"\n597|\t\"github.com/relux-works/agent-session-manager/internal/localstore\"\n598|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n599|)\n600|\n601|func TestReviewerUnlistedSiteExecutes(t *testing.T) {\n602|\tdirectory := t.TempDir()\n603|\tconfigPath := filepath.Join(directory, \"config.toml\")\n604|\tstatePath := filepath.Join(directory, \"state\")\n605|\tif err := os.WriteFile(configPath, []byte(\"configuration\"), 0o600); err != nil {\n606|\t\tt.Fatal(err)\n607|\t}\n608|\tpaths, err := localstore.ResolvePaths(localstore.ResolveRequest{\n609|\t\tPlatform: scalar.PlatformLinux,\n610|\t\tFlags: map[string]string{\n611|\t\t\t\"--config\": configPath, \"--data-dir\": filepath.Join(statePath, \"data\"),\n612|\t\t\t\"--state-dir\": statePath, \"--cache-dir\": filepath.Join(statePath, \"cache\"),\n613|\t\t\t\"--runtime-dir\": filepath.Join(statePath, \"runtime\"),\n614|\t\t},\n615|\t})\n616|\tif err != nil {\n617|\t\tt.Fatal(err)\n618|\t}\n619|\tstore, err := hosttrust.Open(paths)\n620|\tif err != nil {\n621|\t\tt.Fatal(err)\n622|\t}\n623|\tif err := store.EnsureConfigBinding(paths); err != nil {\n624|\t\tt.Fatal(err)\n625|\t}\n626|\tfor _, branch := range []string{\"reviewer-pre-hold\", \"reviewer-post-hold\"} {\n627|\t\toriginal := filepath.Join(directory, branch+\"-original\")\n628|\t\treplacement := filepath.Join(directory, branch+\"-replacement\")\n629|\t\tif err := os.WriteFile(original, []byte(\"old\"), 0o600); err != nil {\n630|\t\t\tt.Fatal(err)\n631|\t\t}\n632|\t\tif err := store.WithExclusiveHoldForConfig(paths, func(hold hosttrust.HeldExclusive) error {\n633|\t\t\treturn replaceDurably(hold, osMigrationFileSystem{}, paths, branch, []byte(original), []byte(replacement))\n634|\t\t}); err != nil {\n635|\t\t\tt.Fatalf(\"replaceDurably(%s) = %v\", branch, err)\n636|\t\t}\n637|\t\tcontents, err := os.ReadFile(replacement)\n638|\t\tif err != nil {\n639|\t\t\tt.Fatal(err)\n640|\t\t}\n641|\t\tif string(contents) != \"old\" {\n642|\t\t\tt.Fatalf(\"%s witness contents = %q, want old\", branch, contents)\n643|\t\t}\n644|\t}\n645|}\n646|`\n647|\twitnessPath := filepath.Join(project, \"internal\", \"config\", \"reviewer_callsite_regression_test.go\")\n648|\tif err := os.WriteFile(witnessPath, []byte(witness), 0o600); err != nil {\n649|\t\tt.Fatal(err)\n650|\t}\n651|\tchild := exec.Command(\"go\", \"test\", \"./internal/config\", \"-run\", \"^(TestWritePathCensusGate|TestReviewerUnlistedSiteExecutes)$\", \"-count=1\", \"-v\")\n652|\tchild.Dir = project\n653|\tchild.Env = append(os.Environ(), \"GOTOOLCHAIN=local\")\n654|\toutput, childErr := child.CombinedOutput()\n655|\tif childErr == nil {\n656|\t\tt.Fatalf(\"planted census child succeeded; gate admitted an unlisted site:\\n%s\", output)\n657|\t}\n658|\tif !strings.Contains(string(output), \"--- PASS: TestReviewerUnlistedSiteExecutes\") {\n659|\t\tt.Fatalf(\"planted child did not execute the real rename witness (err=%v):\\n%s\", childErr, output)\n660|\t}\n661|\tif !strings.Contains(string(output), \"write-path census violation\") {\n662|\t\tt.Fatalf(\"planted child failed without a census violation (err=%v):\\n%s\", childErr, output)\n663|\t}\n664|}\n665|\n666|// applyCensusMutationOverlay propagates the mutation harness's source overlay\n667|// into the isolated child module. Without this handoff the child would test\n668|// the on-disk baseline while the parent tests the mutant, making a behavioral\n669|// mutant appear killed for the wrong reason. Non-census overlays are ignored.\n670|func applyCensusMutationOverlay(t *testing.T, project string) {\n671|\tt.Helper()\n672|\toverlayPath := os.Getenv(\"CENSUS_MUTATION_OVERLAY\")\n673|\tif overlayPath == \"\" {\n674|\t\treturn\n675|\t}\n676|\tcontents, err := os.ReadFile(overlayPath)\n677|\tif err != nil {\n678|\t\tt.Fatalf(\"read census mutation overlay: %v\", err)\n679|\t}\n680|\tvar overlay struct {\n681|\t\tReplace map[string]string `json:\"Replace\"`\n682|\t}\n683|\tif err := json.Unmarshal(contents, &overlay); err != nil {\n684|\t\tt.Fatalf(\"decode census mutation overlay: %v\", err)\n685|\t}\n686|\tfor source, replacement := range overlay.Replace {\n687|\t\tif filepath.Base(source) != \"writepath_census_types_test.go\" {\n688|\t\t\tcontinue\n689|\t\t}\n690|\t\tmutated, err := os.ReadFile(replacement)\n691|\t\tif err != nil {\n692|\t\t\tt.Fatalf(\"read census mutation replacement: %v\", err)\n693|\t\t}\n694|\t\ttarget := filepath.Join(project, \"internal\", \"config\", \"writepath_census_types_test.go\")\n695|\t\tif err := os.WriteFile(target, mutated, 0o600); err != nil {\n696|\t\t\tt.Fatalf(\"install census mutation replacement: %v\", err)\n697|\t\t}\n698|\t\treturn\n699|\t}\n700|}\n701|\n702|func copyCensusProject(t *testing.T, sourceRoot, destinationRoot string) {\n703|\tt.Helper()\n704|\tif err := filepath.WalkDir(sourceRoot, func(path string, entry fs.DirEntry, walkErr error) error {\n705|\t\tif walkErr != nil {\n706|\t\t\treturn walkErr\n707|\t\t}\n708|\t\trelative, err := filepath.Rel(sourceRoot, path)\n709|\t\tif err != nil {\n710|\t\t\treturn err\n711|\t\t}\n712|\t\tif relative == \".\" {\n713|\t\t\treturn os.MkdirAll(destinationRoot, 0o700)\n714|\t\t}\n715|\t\tif relative == \".git\" || relative == \".temp\" || relative == \".task-board\" {\n716|\t\t\tif entry.IsDir() {\n717|\t\t\t\treturn fs.SkipDir\n718|\t\t\t}\n719|\t\t\treturn nil\n720|\t\t}\n721|\t\tif relative != \"go.mod\" && relative != \"go.sum\" && relative != \"internal\" && !strings.HasPrefix(relative, \"internal\"+string(filepath.Separator)) {\n722|\t\t\tif entry.IsDir() {\n723|\t\t\t\treturn fs.SkipDir\n724|\t\t\t}\n725|\t\t\treturn nil\n726|\t\t}\n727|\t\ttarget := filepath.Join(destinationRoot, relative)\n728|\t\tif entry.IsDir() {\n729|\t\t\treturn os.MkdirAll(target, 0o700)\n730|\t\t}\n731|\t\tif entry.Type()&os.ModeSymlink != 0 || !entry.Type().IsRegular() {\n732|\t\t\treturn nil\n733|\t\t}\n734|\t\tcontents, err := os.ReadFile(path)\n735|\t\tif err != nil {\n736|\t\t\treturn err\n737|\t\t}\n738|\t\treturn os.WriteFile(target, contents, 0o600)\n739|\t}); err != nil {\n740|\t\tt.Fatalf(\"copy census project: %v\", err)\n741|\t}\n742|}\n743|\n744|// The type-aware gate fails closed when it cannot resolve a callee. A\n745|// source-only scanner would silently treat this unresolved call as harmless.\n746|func TestWritePathCensusFailsClosedOnUnresolvedCallee(t *testing.T) {\n747|\tdir := t.TempDir()\n748|\tpath := filepath.Join(dir, \"unresolved.go\")\n749|\tif err := os.WriteFile(path, []byte(\"package censuscontrol\\nfunc rogue() { unknownCallee() }\\n\"), 0o600); err != nil {\n750|\t\tt.Fatal(err)\n751|\t}\n752|\tif _, err := loadCensusTypeUnit(dir); err == nil {\n753|\t\tt.Fatal(\"write-path census accepted an unresolved callee\")\n754|\t}\n755|}\n756|\n757|// The control plant: the gate must flag a new unlocked caller in a\n758|// synthetic package while passing the censused shapes.\n759|func TestWritePathGateFlagsUnlockedCaller(t *testing.T) {\n760|\tt.Helper()\n761|\twrite := func(t *testing.T, dir, name, body string) {\n762|\t\tt.Helper()\n763|\t\tpath := filepath.Join(dir, name)\n764|\t\tcontent := \"package censuscontrol\\n\\n\" + body\n765|\t\tif err := os.WriteFile(path, []byte(content), 0o600); err != nil {\n766|\t\t\tt.Fatal(err)\n767|\t\t}\n768|\t}\n769|\tt.Run(\"flags unlocked pair write\", func(t *testing.T) {\n770|\t\tdir := t.TempDir()\n771|\t\twrite(t, dir, \"rogue.go\", \"func replaceDurably() {}\\nfunc rogueApply() {\\n\\treplaceDurably()\\n}\\n\")\n772|\t\tviolations := censusViolations(t, dir)\n773|\t\tif len(violations) != 1 || !strings.Contains(violations[0], \"rogueApply\") {\n774|\t\t\tt.Fatalf(\"gate violations = %v, want exactly the rogueApply caller\", violations)\n775|\t\t}\n776|\t})\n777|\tt.Run(\"flags unlocked trust write\", func(t *testing.T) {\n778|\t\tdir := t.TempDir()\n779|\t\twrite(t, dir, \"rogue.go\", \"func commitDocument() {}\\nfunc rogueBump() {\\n\\tcommitDocument()\\n}\\n\")\n780|\t\tviolations := censusViolations(t, dir)\n781|\t\tif len(violations) != 1 || !strings.Contains(violations[0], \"rogueBump\") {\n782|\t\t\tt.Fatalf(\"gate violations = %v, want exactly the rogueBump caller\", violations)\n783|\t\t}\n784|\t})\n785|\tt.Run(\"flags unlocked raw rename\", func(t *testing.T) {\n786|\t\tdir := t.TempDir()\n787|\t\twrite(t, dir, \"rogue.go\", \"type seam interface{ Rename(a, b string) }\\nfunc rogueRename(s seam) {\\n\\ts.Rename(\\\"a\\\", \\\"b\\\")\\n}\\n\")\n788|\t\tviolations := censusViolations(t, dir)\n789|\t\tif len(violations) != 1 || !strings.Contains(violations[0], \"rogueRename\") {\n790|\t\t\tt.Fatalf(\"gate violations = %v, want exactly the rogueRename caller\", violations)\n791|\t\t}\n792|\t})\n793|\tt.Run(\"passes censused shapes\", func(t *testing.T) {\n794|\t\tdir := t.TempDir()\n795|\t\twrite(t, dir, \"clean.go\", \"func replaceDurably() {}\\nfunc writeTempReplace() {}\\n\"+\n796|\t\t\t\"type store struct{}\\nfunc (s store) JointCommit(a, b, c func() error) {}\\n\"+\n797|\t\t\t\"func (s store) WithExclusiveHold(fn func(int)) {}\\n\"+\n798|\t\t\t\"func migrate(s store) {\\n\\ts.WithExclusiveHold(func(hold int) {\\n\\t\\treplaceDurably()\\n\\t})\\n}\\n\"+\n799|\t\t\t\"func applyV4(s store) {\\n\\ts.JointCommit(func() error { return nil }, func() error {\\n\\t\\treplaceDurably()\\n\\t\\treturn nil\\n\\t}, func() error {\\n\\t\\twriteTempReplace()\\n\\t\\treturn nil\\n\\t})\\n}\\n\")\n(more lines below)","final_result":true}}}
