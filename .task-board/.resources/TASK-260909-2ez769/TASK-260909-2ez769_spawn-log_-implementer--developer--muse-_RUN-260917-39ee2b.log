as a value in %s\", position.Filename, position.Line, helper, functionName))\n1059|\t\treturn\n1060|\t}\n1061|\tif censusIsOSMutation(function) || censusIsRawMutation(function) {\n1062|\t\tposition := scanner.unit.fset.Position(selector.Pos())\n1063|\t\tscanner.result = append(scanner.result, fmt.Sprintf(\"%s:%d: filesystem mutation function %s escapes as a value in %s\", position.Filename, position.Line, function.Name(), functionName))\n1064|\t}\n1065|}\n1066|\n1067|func (scanner *censusTypeScanner) allowedInterfaceCall(current *types.Func, node ast.Node, object types.Object) bool {\n1068|\tif !scanner.allowedInterfaceMethods[current][object] {\n1069|\t\treturn false\n1070|\t}\n1071|\tposition := scanner.unit.fset.Position(node.Pos())\n1072|\tfor site := range scanner.allowedInterfaceSites[current] {\n1073|\t\tif filepath.Base(position.Filename) != site.file || position.Line != site.line || position.Column != site.column {\n1074|\t\t\tcontinue\n1075|\t\t}\n1076|\t\tif !censusAllowedInterfaceMethod(object, []censusInterfaceMethod{site.method}) {\n1077|\t\t\tcontinue\n1078|\t\t}\n1079|\t\tif censusInterfaceCallHoldRequirements[censusFunctionOf(current)] && !scanner.interfaceCallDominatedByHold(current, node) {\n1080|\t\t\treturn false\n1081|\t\t}\n1082|\t\treturn true\n1083|\t}\n1084|\treturn false\n1085|}\n1086|\n1087|func (scanner *censusTypeScanner) interfaceCallDominatedByHold(current *types.Func, node ast.Node) bool {\n1088|\tfunctionDecl := scanner.functionDecls[current]\n1089|\tif functionDecl == nil || functionDecl.Body == nil {\n1090|\t\treturn false\n1091|\t}\n1092|\ttargetIndex := -1\n1093|\tfor index, statement := range functionDecl.Body.List {\n1094|\t\tif containsNode(statement, node) {\n1095|\t\t\ttargetIndex = index\n1096|\t\t\tbreak\n1097|\t\t}\n1098|\t}\n1099|\tif targetIndex < 0 {\n1100|\t\treturn false\n1101|\t}\n1102|\tfor _, statement := range functionDecl.Body.List[:targetIndex] {\n1103|\t\tif censusIsFailFastHoldGuard(statement, scanner) {\n11