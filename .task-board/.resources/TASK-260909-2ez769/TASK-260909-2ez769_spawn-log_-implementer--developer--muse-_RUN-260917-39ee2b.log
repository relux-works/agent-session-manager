ows, \"exit_code\": proc.returncode, \"result\": state,\n92|               \"named_failing_tests\": failed, \"expected_test\": expected_test,\n93|               \"bound\": BOUNDS.get(name, \"\" if killed or name == \"neutral\" else \"No named failing test established; this gate member is unproven.\"),\n94|               \"command\": command}\n95|        results.append(row)\n96|        print(f\"{name}: {state}, exit={proc.returncode}, tests={','.join(failed)}\", flush=True)\n97|        (out / \"results.json\").write_text(json.dumps(results, indent=2) + \"\\n\")\n98|    rows = [\"| Mutant | What the gate is narrowed to admit | Named failing test | Exit | Result / surviving bound |\",\n99|            \"| --- | --- | --- | ---: | --- |\"]\n100|    for r in results:\n101|        tests = r[\"expected_test\"] if r[\"expected_test\"] in r[\"named_failing_tests\"] else \", \".join(r[\"named_failing_tests\"])\n102|        rows.append(f'| {r[\"mutant\"]} | {r[\"narrowing\"]} | {tests or \"none\"} | {r[\"exit_code\"]} | {r[\"result\"]}: {r[\"bound\"]} |')\n103|    (out / \"table.md\").write_text(\"\\n\".join(rows)+\"\\n\")\n104|    return int(unexpected)\n105|\n106|\n107|if __name__ == \"__main__\":\n108|    sys.exit(main())","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
