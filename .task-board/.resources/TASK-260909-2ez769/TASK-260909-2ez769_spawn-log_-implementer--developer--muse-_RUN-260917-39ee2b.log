r.allowedFunctionValues[object] = true\n680|\t\t\t}\n681|\t\t}\n682|\t}\n683|\tfor _, object := range unit.info.Uses {\n684|\t\tvariable, ok := object.(*types.Var)\n685|\t\tif !ok || variable.Pkg() == nil {\n686|\t\t\tcontinue\n687|\t\t}\n688|\t\tif censusAllowedExternalFunctionValues[variable.Pkg().Path()][variable.Name()] {\n689|\t\t\tscanner.allowedFunctionValues[variable] = true\n690|\t\t}\n691|\t}\n692|\tfor _, file := range unit.files {\n693|\t\tfor _, declaration := range file.Decls {\n694|\t\t\tif general, ok := declaration.(*ast.GenDecl); ok && general.Tok == token.TYPE {\n695|\t\t\t\tfor _, specification := range general.Specs {\n696|\t\t\t\t\ttypeSpec, ok := specification.(*ast.TypeSpec)\n697|\t\t\t\t\tif !ok {\n698|\t\t\t\t\t\tcontinue\n699|\t\t\t\t\t}\n700|\t\t\t\t\tstructure, ok := typeSpec.Type.(*ast.StructType)\n701|\t\t\t\t\tif !ok {\n702|\t\t\t\t\t\tcontinue\n703|\t\t\t\t\t}\n704|\t\t\t\t\tfor _, field := range structure.Fields.List {\n705|\t\t\t\t\t\tfor _, identifier := range field.Names {\n706|\t\t\t\t\t\t\tobject := unit.info.Defs[identifier]\n707|\t\t\t\t\t\t\tif censusAllowedFunctionFields[censusFunctionField{pkgPath: unit.pkg.Path(), typeName: typeSpec.Name.Name, name: identifier.Name}] {\n708|\t\t\t\t\t\t\t\tscanner.allowedFunctionValues[object] = true\n709|\t\t\t\t\t\t\t}\n710|\t\t\t\t\t\t}\n711|\t\t\t\t\t}\n712|\t\t\t\t}\n713|\t\t\t}\n714|\t\t\tfunctionDecl, ok := declaration.(*ast.FuncDecl)\n715|\t\t\tif !ok || functionDecl.Name == nil {\n716|\t\t\t\tcontinue\n717|\t\t\t}\n718|\t\t\tfunction, ok := unit.info.Defs[functionDecl.Name].(*types.Func)\n719|\t\t\tif !ok {\n720|\t\t\t\tcontinue\n721|\t\t\t}\n722|\t\t\tscanner.functionDecls[function] = functionDecl\n723|\t\t\tpolicy, hasPolicy := censusIndirectPolicies[censusFunctionOf(function)]\n724|\t\t\tmethods := censusRequiredInterfaceMethods[censusFunctionOf(function)]\n725|\t\t\tif !hasPolicy && len(methods) == 0 {\n726|\t\t\t\tcontinue\n727|\t\t\t}\n728|\t\t\tif len(methods) != 0 {\n729|