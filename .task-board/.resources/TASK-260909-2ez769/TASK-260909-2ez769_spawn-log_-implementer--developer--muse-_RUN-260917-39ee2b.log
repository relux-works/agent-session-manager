\"github.com/relux-works/agent-session-manager/internal/config\", name: \"writeTempReplace\"}:                          true,\n616|\t{pkgPath: \"github.com/relux-works/agent-session-manager/internal/hosttrust\", name: \"commitDocument\"}:                         true,\n617|\t{pkgPath: \"github.com/relux-works/agent-session-manager/internal/hosttrust\", receiver: \"Store\", name: \"commitConfigBinding\"}: true,\n618|}\n619|\n620|// These package variables are test seams or immutable error constructors,\n621|// not filesystem writers. Their declaration objects are admitted explicitly;\n622|// arbitrary function-valued variables remain rejected at call sites.\n623|var censusAllowedFunctionValues = map[string]map[string]bool{\n624|\t\"github.com/relux-works/agent-session-manager/internal/config\": {\n625|\t\t\"tomlDecode\": true, \"migrationError\": true, \"configError\": true, \"loaderError\": true,\n626|\t\t\"terminalCapabilitySet\": true,\n627|\t},\n628|\t\"github.com/relux-works/agent-session-manager/internal/hosttrust\": {\n629|\t\t\"trustError\": true,\n630|\t},\n631|}\n632|\n633|// These standard-library function variables are immutable constructors or\n634|// curve selectors, not mutation entry points. They are admitted by the exact\n635|// declaration object resolved from the loaded package, never by a signature.\n636|var censusAllowedExternalFunctionValues = map[string]map[string]bool{\n637|\t\"crypto/elliptic\": {\"P256\": true},\n638|}\n639|\n640|// The terminal capability set is an immutable package initializer whose\n641|// expression is an immediately-invoked function literal. Keep that one\n642|// initializer explicit; arbitrary immediate function calls remain rejected.\n643|var censusAllowedFunctionInitializers = map[string]map[string]bool{\n644|\t\"github.com/relux-works/agent-session-manager/internal/config\": {\"var terminalCapabilitySet\": true},\n645|}\n646|\n647|type censusFunctionField struct {\n648|\tpkgPath  string\n649|\ttypeName string\n650|\tname     string\n651|}\n652|\n653|// sshValueRule.permits is a pure validator callback. The scanner records its\n654|// resolved field object below; an unrelated function-valued field remains\n655|// rejected even if it has the same shape elsewhere.\n656|var censusAllowedFunctionFields = map[censusFunctionField]bool{\n657|\t{pkgPath: \"github.com/relux-works/agent-session-manager/internal/config\", typeName: \"sshOptionRule\", name: \"permits\"}: true,\n658|\t{pkgPath: \"github.com/relux-works/agent-session-manager/internal/config\", typeName: \"Inputs\", name: \"LookupEnv\"}:      true,\n659|\t{pkgPath: \"github.com/relux-works/agent-session-manager/internal/config\", typeName: \"Inputs\", name: \"Stat\"}:           true,\n660|\t{pkgPath: \"github.com/relux-works/agent-session-manager/internal/config\", typeName: \"Inputs\", name: \"ReadFile\"}:       true,\n661|}\n662|\n663|func newCensusTypeScanner(unit censusTypeUnit, gated map[*types.Func]string) censusTypeScanner {\n664|\tscanner := censusTypeScanner{\n665|\t\tunit: unit, gated: gated,\n666|\t\tallowedIndirectObjects:  map[*types.Func]map[types.Object]bool{},\n667|\t\tallowedInterfaceMethods: map[*types.Func]map[types.Object]bool{},\n668|\t\tallowedInterfaceSites:   map[*types.Func]map[censusInterfaceCallSite]bool{},\n669|\t\tallowedFunctionValues:   map[types.Object]bool{},\n670|\t\tallowedInitializers:     map[string]bool{},\n671|\t\tfunctionDecls:           map[*types.Func]*ast.FuncDecl{},\n672|\t}\n673|\tfor name := range censusAllowedFunctionInitializers[unit.pkg.Path()] {\n674|\t\tscanner.allowedInitializers[name] = true\n675|\t}\n676|\tif unit.pkg != nil && unit.pkg.Scope() != nil {\n677|\t\tfor name := range censusAllowedFunctionValues[unit.pkg.Path()] {\n678|\t\t\tif object := unit.pkg.Scope().Lookup(name); object != nil {\n679|\t\t\t\tscanner.allowedFunctionValues[object] = true\n680|\t\t\t}\n681|\t\t}\n682|\t}\n683|\tfor _, object := range unit.info.Uses {\n684|\t\tvariable, ok := object.(*types.Var)\n685|\t\tif !ok || variable.Pkg() == nil {\n686|\t\t\tcontinue\n687|\t\t}\n688|\t\tif censusAllowedExternalFunctionValues[variable.Pkg().Path()][variable.Name()] {\n689|\t\t\tscanner.allowedFunctionValues[variable] = true\n690|\t\t}\n691|\t}\n692|\tfor _, file := range unit.files {\n693|\t\tfor _, declaration := range file.Decls {\n694|\t\t\tif general, ok := declaration.(*ast.GenDecl); ok && general.Tok == token.TYPE {\n695|\t\t\t\tfor _, specification := range general.Specs {\n696|\t\t\t\t\ttypeSpec, ok := specification.(*ast.TypeSpec)\n697|\t\t\t\t\tif !ok {\n698|\t\t\t\t\t\tcontinue\n699|\t\t\t\t\t}\n700|\t\t\t\t\tstructure, ok := typeSpec.Type.(*ast.StructType)\n701|\t\t\t\t\tif !ok {\n702|\t\t\t\t\t\tcontinue\n703|\t\t\t\t\t}\n704|\t\t\t\t\tfor _, field := range structure.Fields.List {\n705|\t\t\t\t\t\tfor _, identifier := range field.Names {\n706|\t\t\t\t\t\t\tobject := unit.info.Defs[identifier]\n707|\t\t\t\t\t\t\tif censusAllowedFunctionFields[censusFunctionField{pkgPath: unit.pkg.Path(), typeName: typeSpec.Name.Name, name: identifier.Name}] {\n708|\t\t\t\t\t\t\t\tscanner.allowedFunctionValues[object] = true\n709|\t\t\t\t\t\t\t}\n710|\t\t\t\t\t\t}\n711|\t\t\t\t\t}\n712|\t\t\t\t}\n713|\t\t\t}\n714|\t\t\tfunctionDecl, ok := declaration.(*ast.FuncDecl)\n715|\t\t\tif !ok || functionDecl.Name == nil {\n716|\t\t\t\tcontinue\n717|\t\t\t}\n718|\t\t\tfunction, ok := unit.info.Defs[functionDecl.Name].(*types.Func)\n719|\t\t\tif !ok {\n720|\t\t\t\tcontinue\n721|\t\t\t}\n722|\t\t\tscanner.functionDecls[function] = functionDecl\n723|\t\t\tpolicy, hasPolicy := censusIndirectPolicies[censusFunctionOf(function)]\n724|\t\t\tmethods := censusRequiredInterfaceMethods[censusFunctionOf(function)]\n725|\t\t\tif !hasPolicy && len(methods) == 0 {\n726|\t\t\t\tcontinue\n727|\t\t\t}\n728|\t\t\tif len(methods) != 0 {\n729|\t\t\t\tallowedMethods := map[types.Object]bool{}\n730|\t\t\t\tfor _, selection := range unit.info.Selections {\n731|\t\t\t\t\tif censusAllowedInterfaceMethod(selection.Obj(), methods) {\n732|\t\t\t\t\t\tallowedMethods[selection.Obj()] = true\n733|\t\t\t\t\t}\n734|\t\t\t\t}\n735|\t\t\t\tallowedSites := map[censusInterfaceCallSite]bool{}\n736|\t\t\t\tfor _, site := range censusRequiredInterfaceCallSites[censusFunctionOf(function)] {\n737|\t\t\t\t\tallowedSites[site] = true\n738|\t\t\t\t}\n739|\t\t\t\tscanner.allowedInterfaceMethods[function] = allowedMethods\n740|\t\t\t\tscanner.allowedInterfaceSites[function] = allowedSites\n741|\t\t\t}\n742|\t\t\tsignature, ok := function.Type().(*types.Signature)\n743|\t\t\tif !ok {\n744|\t\t\t\tcontinue\n745|\t\t\t}\n746|\t\t\tallowed := map[types.Object]bool{}\n747|\t\t\tfor index := 0; index < signature.Params().Len(); index++ {\n748|\t\t\t\tparameter := signature.Params().At(index)\n749|\t\t\t\tif policy.parameters[parameter.Name()] {\n750|\t\t\t\t\tallowed[parameter] = true\n751|\t\t\t\t}\n752|\t\t\t}\n753|\t\t\tif len(policy.locals) != 0 && functionDecl.Body != nil {\n754|\t\t\t\tast.Inspect(functionDecl.Body, func(node ast.Node) bool {\n755|\t\t\t\t\tidentifier, ok := node.(*ast.Ident)\n756|\t\t\t\t\tif !ok || !policy.locals[identifier.Name] {\n757|\t\t\t\t\t\treturn true\n758|\t\t\t\t\t}\n759|\t\t\t\t\tif variable, ok := unit.info.Uses[identifier].(*types.Var); ok {\n760|\t\t\t\t\t\tallowed[variable] = true\n761|\t\t\t\t\t}\n762|\t\t\t\t\treturn true\n763|\t\t\t\t})\n764|\t\t\t}\n765|\t\t\tif len(allowed) != 0 {\n766|\t\t\t\tscanner.allowedIndirectObjects[function] = allowed\n767|\t\t\t}\n768|\t\t}\n769|\t}\n770|\treturn scanner\n771|}\n772|\n773|func (scanner *censusTypeScanner) scan() []string {\n774|\tfor _, file := range scanner.unit.files {\n775|\t\tfor _, declaration := range file.Decls {\n776|\t\t\tswitch value := declaration.(type) {\n777|\t\t\tcase *ast.FuncDecl:\n778|\t\t\t\tif value.Body == nil || scanner.isBackendMethod(value) {\n779|\t\t\t\t\tcontinue\n780|\t\t\t\t}\n781|\t\t\t\tfunction := censusObject(scanner.unit.info.Defs[value.Name])\n782|\t\t\t\tscanner.walk(value.Body, value.Name.Name, function)\n783|\t\t\tcase *ast.GenDecl:\n784|\t\t\t\tfor _, specification := range value.Specs {\n785|\t\t\t\t\tvariables, ok := specification.(*ast.ValueSpec)\n786|\t\t\t\t\tif !ok {\n787|\t\t\t\t\t\tcontinue\n788|\t\t\t\t\t}\n789|\t\t\t\t\tfor _, initializer := range variables.Values {\n790|\t\t\t\t\t\tname := \"package initializer\"\n791|\t\t\t\t\t\tif len(variables.Names) == len(variables.Values) {\n792|\t\t\t\t\t\t\tfor index, variable := range variables.Values {\n793|\t\t\t\t\t\t\t\tif variable == initializer && index < len(variables.Names) {\n794|\t\t\t\t\t\t\t\t\tname = \"var \" + variables.Names[index].Name\n795|\t\t\t\t\t\t\t\t}\n796|\t\t\t\t\t\t\t}\n797|\t\t\t\t\t\t}\n798|\t\t\t\t\t\tscanner.walk(initializer, name, nil)\n799|\t\t\t\t\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
