ble is\n33|// an exact closed two-field shape. The config-side record is authoritative;\n34|// the state-root field binds that exact target to one store coordination root.\n35|// Neither sidecar enters the configuration or any replication surface.\n36|type ConfigBinding struct {\n37|\tSchema        string `json:\"schema\"`\n38|\tSchemaVersion string `json:\"schema_version\"`\n39|\tConfigPath    string `json:\"config_path\"`\n40|\tStateRoot     string `json:\"state_root\"`\n41|}\n42|\n43|// bindingPath is the derived store-side index path. It is intentionally kept\n44|// separate from configBindingPath: callers must not be able to turn a\n45|// caller-selected store index into authority for a different configuration.\n46|func bindingPath(root string) string { return filepath.Join(root, configBindingFileName) }\n47|\n48|func configBindingPath(configPath string) string { return configPath + configBindingTargetSuffix }\n49|\n50|func configBindingLockPath(configPath string) string { return configPath + configBindingLockSuffix }\n51|\n52|func encodeConfigBinding(path, stateRoot string) ([]byte, error) {\n53|\tif err := validateBindingPath(path); err != nil {\n54|\t\treturn nil, err\n55|\t}\n56|\tif err := validateBindingStateRoot(stateRoot); err != nil {\n57|\t\treturn nil, err\n58|\t}\n59|\tdocument, err := json.Marshal(ConfigBinding{\n60|\t\tSchema:        configBindingSchema,\n61|\t\tSchemaVersion: configBindingVersion,\n62|\t\tConfigPath:    path,\n63|\t\tStateRoot:     stateRoot,\n64|\t})\n65|\tif err != nil {\n66|\t\treturn nil, trustError(TrustError{Operation: \"encode configuration binding\", Err: errors.Join(ErrTrustDurability, err)})\n67|\t}\n68|\treturn document, nil\n69|}\n70|\n71|// decodeConfigBinding keeps the historical path-only helper for tests and\n72|// diagnostics. All authority checks use decodeConfigBindingRecord so the\n73|// state-root association cannot be discarded accidentally.\n74|func decodeConfigBinding(document []byte) (string, error) {\n75|\tbinding, err := decodeConfigBindingRecord(document)\n76|\tif err != nil {\n77|\t\treturn \"\", err\n78|\t}\n79|\treturn binding.ConfigPath, nil\n80|}\n81|\n82|func decodeConfigBindingRecord(document []byte) (ConfigBinding, error) {\n83|\tif err := rejectDuplicateKeys(document); err != nil {\n84|\t\treturn ConfigBinding{}, err\n85|\t}\n86|\tvar shape map[string]json.RawMessage\n87|\tdecoder := json.NewDecoder(bytes.NewReader(document))\n88|\tif err := decoder.Decode(&shape); err != nil {\n89|\t\treturn ConfigBinding{}, trustError(TrustError{Operation: \"decode configuration binding\", Err: errors.Join(ErrTrustDecode, err)})\n90|\t}\n91|\tvar trailing any\n92|\tif err := decoder.Decode(&trailing); !errors.Is(err, io.EOF) {\n93|\t\tif err == nil {\n94|\t\t\treturn ConfigBinding{}, trustError(TrustError{Operation: \"decode configuration binding\", Err: ErrTrustDecode})\n95|\t\t}\n96|\t\treturn ConfigBinding{}, trustError(TrustError{Operation: \"decode configuration binding\", Err: errors.Join(ErrTrustDecode, err)})\n97|\t}\n98|\tif len(shape) != 4 {\n99|\t\treturn ConfigBinding{}, trustError(TrustError{Operation: \"decode configuration binding\", Err: ErrTrustValidation})\n100|\t}\n101|\tfor key := range shape {\n102|\t\tswitch key {\n103|\t\tcase \"schema\", \"schema_version\", \"config_path\", \"state_root\":\n104|\t\tdefault:\n105|\t\t\treturn ConfigBinding{}, trustError(TrustError{Operation: \"decode configuration binding\", Err: ErrTrustValidation})\n106|\t\t}\n107|\t}\n108|\tvar binding ConfigBinding\n109|\tdecoder = json.NewDecoder(bytes.NewReader(document))\n110|\tdecoder.DisallowUnknownFields()\n111|\tif err := decoder.Decode(&binding); err != nil {\n112|\t\treturn ConfigBinding{}, trustError(TrustError{Operation: \"decode configuration binding\", Err: errors.Join(ErrTrustDecode, err)})\n113|\t}\n114|\tif binding.Schema != configBindingSchema || binding.SchemaVersion != configBindingVersion {\n115|\t\treturn ConfigBinding{}, trustError(TrustError{Operation: \"decode configuration binding\", Err: ErrTrustValidation})\n116|\t}\n117|\tif err := validateBindingPath(binding.ConfigPath); err != nil {\n118|\t\treturn ConfigBinding{}, err\n119|\t}\n120|\tif err := validateBindingStateRoot(binding.StateRoot); err != nil {\n121|\t\treturn ConfigBinding{}, err\n122|\t}\n123|\treturn binding, nil\n124|}\n125|\n126|func validateBindingPath(path string) error {\n127|\tcanonical, err := absoluteClean(path)\n128|\tif err != nil || canonical != path {\n129|\t\treturn trustError(TrustError{Operation: \"validate configuration binding\", Err: ErrTrustValidation})\n130|\t}\n131|\treturn nil\n132|}\n133|\n134|func validateBindingStateRoot(stateRoot string) error {\n135|\tcanonical, err := absoluteClean(stateRoot)\n136|\tif err != nil || canonical != stateRoot {\n137|\t\treturn trustError(TrustError{Operation: \"validate configuration binding state root\", Err: ErrTrustValidation})\n138|\t}\n139|\treturn nil\n140|}\n141|\n142|// loadBindingAt reads one exact closed owner-only binding document. Absence\n143|// is returned explicitly; a present but partial, unreadable, downgraded or\n144|// ambiguous document refuses closed.\n145|func loadBindingAt(filesystem FileSystem, path string) (ConfigBinding, bool, error) {\n146|\tinfo, err := filesystem.Lstat(path)\n147|\tif err != nil {\n148|\t\tif os.IsNotExist(err) {\n149|\t\t\treturn ConfigBinding{}, false, nil\n150|\t\t}\n151|\t\treturn ConfigBinding{}, false, trustError(TrustError{Operation: \"read configuration binding\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n152|\t}\n153|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n154|\t\treturn ConfigBinding{}, false, err\n155|\t}\n156|\tdocument, err := filesystem.ReadFile(path)\n157|\tif err != nil {\n158|\t\treturn ConfigBinding{}, false, trustError(TrustError{Operation: \"read configuration binding\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n159|\t}\n160|\tbinding, err := decodeConfigBindingRecord(document)\n161|\tif err != nil {\n162|\t\treturn ConfigBinding{}, false, err\n163|\t}\n164|\treturn binding, true, nil\n165|}\n166|\n167|// loadConfigBinding reads the derived store-side index. The returned path is\n168|// intentionally insufficient for authority; callers that authorize a target\n169|// must use loadTargetConfigBinding and compare StateRoot to their store.\n170|func loadConfigBinding(filesystem FileSystem, root string) (string, error) {\n171|\tbinding, present, err := loadBindingAt(filesystem, bindingPath(root))\n172|\tif err != nil {\n173|\t\treturn \"\", err\n174|\t}\n175|\tif !present {\n176|\t\treturn \"\", nil\n177|\t}\n178|\treturn binding.ConfigPath, nil\n179|}\n180|\n181|func loadStoreConfigBinding(filesystem FileSystem, root string) (ConfigBinding, bool, error) {\n182|\treturn loadBindingAt(filesystem, bindingPath(root))\n183|}\n184|\n185|func loadTargetConfigBinding(filesystem FileSystem, configPath string) (ConfigBinding, bool, error) {\n186|\treturn loadBindingAt(filesystem, configBindingPath(configPath))\n187|}\n188|\n189|func storeStateRoot(root string) (string, error) {\n190|\tstateRoot, err := canonicalExistingPath(filepath.Dir(root))\n191|\tif err != nil {\n192|\t\treturn \"\", trustError(TrustError{Operation: \"resolve store state root\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n193|\t}\n194|\treturn stateRoot, nil\n195|}\n196|\n197|func validateBindingForStore(binding ConfigBinding, canonical, root string) error {\n198|\tstateRoot, err := storeStateRoot(root)\n199|\tif err != nil {\n200|\t\treturn err\n201|\t}\n202|\tif binding.ConfigPath != canonical || binding.StateRoot != stateRoot {\n203|\t\treturn trustError(TrustError{Operation: \"validate configuration binding\", Err: ErrExclusiveHoldResourceMismatch})\n204|\t}\n205|\treturn nil\n206|}\n207|\n208|// ensureConfigBindingLocked converges an immutable binding while the caller\n209|// holds the store's exclusive authorization lock. The config-side record and\n210|// its bootstrap lock are the authority: a second Store cannot claim the\n211|// same target by supplying a different stateDir. The store-side index is\n212|// written only as a derived cache after the authoritative record is present.\n213|func (store *Store) ensureConfigBindingLocked(hold HeldExclusive, paths localstore.ResolvedPaths) (HeldExclusive, error) {\n214|\tif err := requireHoldForRoot(hold, store.root); err != nil {\n215|\t\treturn HeldExclusive{}, err\n216|\t}\n217|\tif _, _, err := store.validateResolvedPair(paths); err != nil {\n218|\t\treturn HeldExclusive{}, err\n219|\t}\n220|\tcanonical, err := canonicalResolvedConfigPath(paths)\n221|\tif err != nil {\n222|\t\treturn HeldExclusive{}, err\n223|\t}\n224|\tif err := validateBindingPath(canonical); err != nil {\n225|\t\treturn HeldExclusive{}, err\n226|\t}\n227|\tstateRoot, err := resolvedStateRoot(paths)\n228|\tif err != nil {\n229|\t\treturn HeldExclusive{}, err\n230|\t}\n231|\tbootstrapLock, err := openLock(store.fs, configBindingLockPath(canonical))\n232|\tif err != nil {\n233|\t\treturn HeldExclusive{}, trustError(TrustError{Operation: \"open configuration binding lock\", Err: err})\n234|\t}\n235|\tunlockBootstrap, err := bootstrapLock.exclusive()\n236|\tif err != nil {\n237|\t\treturn HeldExclusive{}, trustError(TrustError{Operation: \"lock configuration binding\", Err: errors.Join(ErrTrustDurability, err)})\n238|\t}\n239|\tdefer unlockBootstrap()\n240|\n241|\t// Inspect the store-side association before publishing anything at the\n242|\t// target. A Store can have been opened while unbound, then another handle\n243|\t// can bind the shared root before this request reaches the bootstrap lock.\n244|\t// The existing store association is authoritative for that root; discovering\n245|\t// a mismatch must therefore be side-effect free.\n246|\tstoreBinding, storePresent, err := loadStoreConfigBinding(store.fs, store.root)\n247|\tif err != nil {\n248|\t\treturn HeldExclusive{}, err\n249|\t}\n250|\tif storePresent {\n251|\t\tif err := validateBindingForStore(storeBinding, canonical, store.root); err != nil {\n252|\t\t\treturn HeldExclusive{}, err\n253|\t\t}\n254|\t}\n255|\n256|\tbinding, present, err := loadTargetConfigBinding(store.fs, canonical)\n257|\tif err != nil {\n258|\t\treturn HeldExclusive{}, err\n259|\t}\n260|\tif present {\n261|\t\tif err := validateBindingForStore(binding, canonical, store.root); err != nil {\n262|\t\t\treturn HeldExclusive{}, err\n263|\t\t}\n264|\t\tif storePresent && (binding.ConfigPath != storeBinding.ConfigPath || binding.StateRoot != storeBinding.StateRoot) {\n265|\t\t\treturn HeldExclusive{}, trustError(TrustError{Operation: \"validate configuration binding\", Err: ErrExclusiveHoldResourceMismatch})\n266|\t\t}\n267|\t} else if storePresent {\n268|\t\t// An existing derived index without its authoritative target record is\n269|\t\t// incoherent. Refuse closed; do not recreate the target from the cache.\n270|\t\treturn HeldExclusive{}, trustError(TrustError{Operation: \"validate configuration binding\", Err: ErrExclusiveHoldResourceMismatch})\n271|\t} else {\n272|\t\tdocument, err := encodeConfigBinding(canonical, stateRoot)\n273|\t\tif err != nil {\n274|\t\t\treturn HeldExclusive{}, err\n275|\t\t}\n276|\t\tif err := store.commitConfigBinding(hold, paths, document); err != nil {\n277|\t\t\treturn HeldExclusive{}, err\n278|\t\t}\n279|\t\tbinding = ConfigBinding{Schema: configBindingSchema, SchemaVersion: configBindingVersion, ConfigPath: canonical, StateRoot: stateRoot}\n280|\t}\n281|\n282|\t// Persist the derived state-side index only after the config-side\n283|\t// association is durable. A crash between the two leaves a safe partial\n284|\t// state: readers cannot use the target without repairing it explicitly.\n285|\tif !storePresent {\n286|\t\tdocument, err := json.Marshal(binding)\n287|\t\tif err != nil {\n288|\t\t\treturn HeldExclusive{}, trustError(TrustError{Operation: \"encode configuration binding\", Err: errors.Join(ErrTrustDurability, err)})\n289|\t\t}\n290|\t\tif err := commitDocument(hold, store.fs, store.root, bindingPath(store.root), document); err != nil {\n291|\t\t\treturn HeldExclusive{}, err\n292|\t\t}\n293|\t}\n294|\tstore.configPath = canonical\n295|\treturn HeldExclusive{hold: hold.hold, configPath: canonical, stateRoot: stateRoot, configAssociation: true}, nil\n296|}\n297|\n298|// commitConfigBinding publishes the authoritative target-side association\n299|// with the same staged-write, fsync, atomic-rename and directory-fsync\n300|// discipline as trust.json. The store hold proves the owning trust resource;\n301|// the per-target bootstrap lock serializes first association across stores.\n302|func (store *Store) commitConfigBinding(hold HeldExclusive, paths localstore.ResolvedPaths, document []byte) error {\n303|\tif err := requireHoldForRoot(hold, store.root); err != nil {\n304|\t\treturn err\n305|\t}\n306|\tif _, _, err := store.validateResolvedPair(paths); err != nil {\n307|\t\treturn err\n308|\t}\n309|\tconfigPath, err := canonicalResolvedConfigPath(paths)\n310|\tif err != nil {\n311|\t\treturn err\n312|\t}\n313|\tdirectory := filepath.Dir(configPath)\n314|\t// The selected configuration directory is operator-owned input and may\n315|\t// legitimately be shared with other configuration files. The binding\n316|\t// record and its bootstrap lock are the owner-only control files; do not\n317|\t// silently impose Host Trust Store's 0700 directory custody on that\n318|\t// unrelated directory.\n319|\tstaged, err := store.fs.CreateTemp(directory, configBindingStagePrefix+\"*\", 0o600)\n320|\tif err != nil {\n321|\t\treturn trustError(TrustError{Operation: \"stage configuration binding\", Err: errors.Join(ErrTrustDurability, err)})\n322|\t}\n323|\tname := staged.Name()\n324|\tfailed := true\n325|\tdefer cleanupStagedFile(store.fs, name, &failed)\n326|\tif err := writeAll(staged, document); err != nil {\n327|\t\treturn trustError(TrustError{Operation: \"stage configuration binding\", Err: errors.Join(ErrTrustDurability, err)})\n328|\t}\n329|\tif err := staged.Sync(); err != nil {\n330|\t\t_ = staged.Close()\n331|\t\treturn trustError(TrustError{Operation: \"sync configuration binding\", Err: errors.Join(ErrTrustDurability, err)})\n332|\t}\n333|\tif err := staged.Close(); err != nil {\n334|\t\treturn trustError(TrustError{Operation: \"sync configuration binding\", Err: errors.Join(ErrTrustDurability, err)})\n335|\t}\n336|\tif err := store.fs.Chmod(name, 0o600); err != nil {\n337|\t\treturn trustError(TrustError{Operation: \"stage configuration binding\", Err: errors.Join(ErrTrustDurability, err)})\n338|\t}\n339|\tif err := secureStaged(name, false); err != nil {\n340|\t\treturn err\n341|\t}\n342|\tif err := store.fs.Rename(name, configBindingPath(configPath)); err != nil {\n343|\t\treturn trustError(TrustError{Operation: \"replace configuration binding\", Err: errors.Join(ErrTrustDurability, err)})\n344|\t}\n345|\tif err := syncDir(store.fs, directory); err != nil {\n346|\t\treturn trustError(TrustError{Operation: \"sync configuration binding directory\", Err: errors.Join(ErrTrustDurability, err)})\n347|\t}\n348|\tfailed = false\n349|\treturn nil\n350|}\n351|\n352|// boundConfigHoldLocked returns a configuration-bound capability only when\n353|// the authoritative config-side association already exists and repeats the\n354|// marker's canonical target and this store's coordination root. JointCommit\n355|// never bootstraps a new association from a marker.\n356|func (store *Store) boundConfigHoldLocked(hold HeldExclusive, paths localstore.ResolvedPaths) (HeldExclusive, error) {\n357|\tif err := requireHoldForRoot(hold, store.root); err != nil {\n358|\t\treturn HeldExclusive{}, err\n359|\t}\n360|\tif _, _, err := store.validateResolvedPair(paths); err != nil {\n361|\t\treturn HeldExclusive{}, err\n362|\t}\n363|\tcanonical, err := canonicalResolvedConfigPath(paths)\n364|\tif err != nil {\n365|\t\treturn HeldExclusive{}, err\n366|\t}\n367|\tif err := validateBindingPath(canonical); err != nil {\n368|\t\treturn HeldExclusive{}, err\n369|\t}\n370|\tbinding, present, err := loadTargetConfigBinding(store.fs, canonical)\n371|\tif err != nil {\n372|\t\treturn HeldExclusive{}, err\n373|\t}\n374|\tif !present {\n375|\t\treturn HeldExclusive{}, trustError(TrustError{Operation: \"validate configuration hold resource\", Err: ErrExclusiveHoldResourceMismatch})\n376|\t}\n377|\tif err := validateBindingForStore(binding, canonical, store.root); err != nil {\n378|\t\treturn HeldExclusive{}, err\n379|\t}\n380|\tstore.configPath = canonical\n381|\treturn HeldExclusive{hold: hold.hold, configPath: canonical, stateRoot: binding.StateRoot, configAssociation: true}, nil\n382|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
