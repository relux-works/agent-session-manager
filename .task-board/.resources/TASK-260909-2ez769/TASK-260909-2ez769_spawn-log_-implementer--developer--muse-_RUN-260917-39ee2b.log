{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c881","stream":{"kind":"session","id":"01a0ad6d-f2e1-7d43-9e77-843c8eea6221"},"sequence":667,"recorded_at":1780531400001329,"record_type":"event","durability":"durable","causation_id":"9d656e52-9607-486f-955f-021a4f63ae37","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9d656e52-9607-486f-955f-021a4f63ae37","run_stream":{"kind":"run","id":"9d656e52-9607-486f-955f-021a4f63ae37"},"task_stream":{"kind":"task","id":"01a0ad70-bb6f-7363-9bd9-ab205210af9f"},"task_id":"01a0ad70-bb6f-7363-9bd9-ab205210af9f","event":{"kind":"output","task_id":"01a0ad70-bb6f-7363-9bd9-ab205210af9f","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1kiyj6/worktree/internal/config/writepath_census_types_test.go`.\n(799 line(s) above)\n800|\t\t\t\t}\n801|\t\t\t}\n802|\t\t}\n803|\t}\n804|\treturn scanner.result\n805|}\n806|\n807|func (scanner *censusTypeScanner) isBackendMethod(function *ast.FuncDecl) bool {\n808|\tobject, ok := scanner.unit.info.Defs[function.Name].(*types.Func)\n809|\tif !ok {\n810|\t\treturn false\n811|\t}\n812|\treturn censusBackendDefinition(object)\n813|}\n814|\n815|func censusObject(object types.Object) *types.Func {\n816|\tfunction, _ := object.(*types.Func)\n817|\treturn function\n818|}\n819|\n820|func censusFunctionOf(object *types.Func) censusFunction {\n821|\tif object == nil {\n822|\t\treturn censusFunction{}\n823|\t}\n824|\tfunction := censusFunction{name: object.Name()}\n825|\tif object.Pkg() != nil {\n826|\t\tfunction.pkgPath = object.Pkg().Path()\n827|\t}\n828|\tif signature, ok := object.Type().(*types.Signature); ok && signature.Recv() != nil {\n829|\t\tfunction.receiver = censusNamedType(signature.Recv().Type())\n830|\t}\n831|\treturn function\n832|}\n833|\n834|// censusAllowedDefinition matches the allowlist by the resolved definition\n835|// identity, not by a bare spelling. The package path and receiver are part of\n836|// the key; a same-named helper in another package or a newly added receiver\n837|// method is scanned as a new write path. Synthetic plants use the empty\n838|// censuscontrol package as a shape-only package, so they retain the original\n839|// receiver-independent control semantics.\n840|func censusAllowedDefinition(helper, current *types.Func, allowed map[string]bool) bool {\n841|\tif helper == nil || current == nil || helper.Pkg() == nil || current.Pkg() == nil {\n842|\t\treturn false\n843|\t}\n844|\tif helper.Pkg().Path() != current.Pkg().Path() || !allowed[current.Name()] {\n845|\t\treturn false\n846|\t}\n847|\tif current.Pkg().Path() == \"censuscontrol\" {\n848|\t\treturn true\n849|\t}\n850|\texpected, hasExpected := censusExpectedReceivers[current.Name()]\n851|\tif !hasExpected {\n852|\t\treturn current.Type().(*types.Signature).Recv() == nil\n853|\t}\n854|\treturn censusNamedType(current.Type().(*types.Signature).Recv().Type()) == expected\n855|}\n856|\n857|var censusExpectedReceivers = map[string]string{\n858|\t\"Initialize\":                \"Store\",\n859|\t\"JointCommit\":               \"Store\",\n860|\t\"Issue\":                     \"Store\",\n861|\t\"Rotate\":                    \"Store\",\n862|\t\"MarkRetiring\":              \"Store\",\n863|\t\"Revoke\":                    \"Store\",\n864|\t\"ensureConfigBindingLocked\": \"Store\",\n865|\t\"commitConfigBinding\":       \"Store\",\n866|}\n867|\n868|func censusNamedType(typ types.Type) string {\n869|\tswitch value := typ.(type) {\n870|\tcase *types.Pointer:\n871|\t\treturn censusNamedType(value.Elem())\n872|\tcase *types.Named:\n873|\t\treturn value.Obj().Name()\n874|\tdefault:\n875|\t\treturn \"\"\n876|\t}\n877|}\n878|\n879|func censusBackendDefinition(object *types.Func) bool {\n880|\tfunction := censusFunctionOf(object)\n881|\tif !censusBackendPackages[function.pkgPath] {\n882|\t\treturn false\n883|\t}\n884|\tmethods, ok := censusBackendMethods[function.receiver]\n