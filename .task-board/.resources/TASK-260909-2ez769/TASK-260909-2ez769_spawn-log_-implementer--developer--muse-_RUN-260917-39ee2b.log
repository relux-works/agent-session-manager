{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7f7","stream":{"kind":"session","id":"01a0ad6d-f2e1-7d43-9e77-843c8eea6221"},"sequence":598,"recorded_at":1780531400001191,"record_type":"event","durability":"durable","causation_id":"9d656e52-9607-486f-955f-021a4f63ae37","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"9d656e52-9607-486f-955f-021a4f63ae37","run_stream":{"kind":"run","id":"9d656e52-9607-486f-955f-021a4f63ae37"},"call_id":"call_01a0ad708a6574e6bd399bd0721c3cc9","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1kiyj6/worktree/internal/config/writepath_census_types_test.go`.\n1|package config\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"go/ast\"\n6|\t\"go/importer\"\n7|\t\"go/parser\"\n8|\t\"go/token\"\n9|\t\"go/types\"\n10|\t\"path/filepath\"\n11|\t\"runtime\"\n12|\t\"sort\"\n13|\t\"strings\"\n14|\t\"testing\"\n15|\n16|\t\"golang.org/x/tools/go/packages\"\n17|)\n18|\n19|// censusTypedViolations is the authoritative write-path gate. It resolves\n20|// package, method, alias-import and function-value identity through go/types;\n21|// spelling a package \"os\" or hiding a writer behind a closure does not evade\n22|// the gate. The loader evaluates the current Go build context; build-tagged\n23|// or platform-specific sources require a separate invocation under that\n24|// context. Unknown indirect callees fail closed unless they are inside one of\n25|// the exact censused definitions. The older syntax walker remains in\n26|// writepath_census_test.go as a small reference implementation for historical\n27|// evidence, but all tests use this symbol-aware implementation.\n28|func censusTypedViolations(t *testing.T, dirs ...string) []string {\n29|\tt.Helper()\n30|\tvar units []censusTypeUnit\n31|\tfor _, dir := range dirs {\n32|\t\tunit, err := loadCensusTypeUnit(dir)\n33|\t\tif err != nil {\n34|\t\t\tt.Fatalf(\"load write-path census package %s: %v\", dir, err)\n35|\t\t}\n36|\t\tunits = append(units, unit)\n37|\t}\n38|\tgated := censusGatedFunctions(units)\n39|\tvar violations []string\n40|\tfor _, unit := range units {\n41|\t\tscanner := newCensusTypeScanner(unit, gated)\n42|\t\tviolations = append(violations, scanner.scan()...)\n43|\t}\n44|\tsort.Strings(violations)\n45|\treturn violations\n46|}\n47|\n48|type censusTypeUnit struct {\n49|\tdir   string\n50|\tfset  *token.FileSet\n51|\tfiles []*ast.File\n52|\tinfo  *types.Info\n53|\tpkg   *types.Package\n54|}\n55|\n56|func loadCensusTypeUnit(dir string) (censusTypeUnit, error) {\n57|\troot := censusModuleRoot()\n58|\tabsolute, err := filepath.Abs(dir)\n59|\tif err != nil {\n60|\t\treturn censusTypeUnit{}, err\n61|\t}\n62|\tif absolute == root || strings.HasPrefix(absolute, root+string(filepath.Separator)) {\n63|\t\tloaded, err := packages.Load(&packages.Config{\n64|\t\t\tMode:  packages.NeedName | packages.NeedFiles | packages.NeedSyntax | packages.NeedTypes | packages.NeedTypesInfo | packages.NeedDeps,\n65|\t\t\tDir:   absolute,\n66|\t\t\tTests: false,\n67|\t\t}, \".\")\n68|\t\tif err != nil {\n69|\t\t\treturn censusTypeUnit{}, err\n70|\t\t}\n71|\t\tif len(loaded) != 1 {\n72|\t\t\treturn censusTypeUnit{}, fmt.Errorf(\"expected one package, got %d\", len(loaded))\n73|\t\t}\n74|\t\tpkg := loaded[0]\n75|\t\tif len(pkg.Errors) != 0 {\n76|\t\t\treturn censusTypeUnit{}, fmt.Errorf(\"type-check errors: %v\", pkg.Errors)\n77|\t\t}\n78|\t\tif pkg.Fset == nil || pkg.Types == nil || pkg.TypesInfo == nil {\n79|\t\t\treturn censusTypeUnit{}, fmt.Errorf(\"incomplete go/packages type information\")\n80|\t\t}\n81|\t\treturn censusTypeUnit{dir: absolute, fset: pkg.Fset, files: pkg.Syntax, info: pkg.TypesInfo, pkg: pkg.Types}, nil\n82|\t}\n83|\n84|\tentries, err := filepath.Glob(filepath.Join(absolute, \"*.go\"))\n85|\tif err != nil {\n86|\t\treturn censusTypeUnit{}, err\n87|\t}\n88|\tsort.Strings(entries)\n89|\tfset := token.NewFileSet()\n90|\tvar files []*ast.File\n91|\tfor _, path := range entries {\n92|\t\tif strings.HasSuffix(path, \"_test.go\") {\n93|\t\t\tcontinue\n94|\t\t}\n95|\t\tfile, err := parser.ParseFile(fset, path, nil, parser.AllErrors)\n96|\t\tif err != nil {\n97|\t\t\treturn censusTypeUnit{}, err\n98|\t\t}\n99|\t\tfiles = append(files, file)\n100|\t}\n101|\tif len(files) == 0 {\n102|\t\treturn censusTypeUnit{}, fmt.Errorf(\"no production Go files\")\n103|\t}\n104|\tinfo := &types.Info{\n105|\t\tTypes:      map[ast.Expr]types.TypeAndValue{},\n106|\t\tDefs:       map[*ast.Ident]types.Object{},\n107|\t\tUses:       map[*ast.Ident]types.Object{},\n108|\t\tSelections: map[*ast.SelectorExpr]*types.Selection{},\n109|\t\tScopes:     map[ast.Node]*types.Scope{},\n110|\t}\n111|\tconf := types.Config{Importer: importer.Default()}\n112|\tpkg, err := conf.Check(\"censuscontrol\", fset, files, info)\n113|\tif err != nil {\n114|\t\treturn censusTypeUnit{}, err\n115|\t}\n116|\treturn censusTypeUnit{dir: absolute, fset: fset, files: files, info: info, pkg: pkg}, nil\n117|}\n118|\n119|func censusModuleRoot() string {\n120|\t_, file, _, ok := runtimeCensusCaller()\n121|\tif !ok {\n122|\t\treturn \"\"\n123|\t}\n124|\treturn filepath.Clean(filepath.Join(filepath.Dir(file), \"..\", \"..\"))\n125|}\n126|\n127|// Kept as a tiny indirection so the production census code remains easy to\n128|// execute in a test without importing runtime in the old syntax-only file.\n129|var runtimeCensusCaller = func() (uintptr, string, int, bool) {\n130|\treturn runtimeCaller(0)\n131|}\n132|\n133|func runtimeCaller(skip int) (uintptr, string, int, bool) {\n134|\treturn runtime.Caller(skip + 1)\n135|}\n136|\n137|type censusFunction struct {\n138|\tname     string\n139|\tpkgPath  string\n140|\treceiver string\n141|}\n142|\n143|func censusGatedFunctions(units []censusTypeUnit) map[*types.Func]string {\n144|\tresult := map[*types.Func]string{}\n145|\tfor _, unit := range units {\n146|\t\tfor _, file := range unit.files {\n147|\t\t\tfor _, declaration := range file.Decls {\n148|\t\t\t\tfunction, ok := declaration.(*ast.FuncDecl)\n149|\t\t\t\tif !ok || function.Name == nil {\n150|\t\t\t\t\tcontinue\n151|\t\t\t\t}\n152|\t\t\t\tobject, ok := unit.info.Defs[function.Name].(*types.Func)\n153|\t\t\t\tif !ok || !censusGatedName(object.Name()) {\n154|\t\t\t\t\tcontinue\n155|\t\t\t\t}\n156|\t\t\t\tresult[object] = object.Name()\n157|\t\t\t}\n158|\t\t}\n159|\t}\n160|\treturn result\n161|}\n162|\n163|func censusGatedName(name string) bool {\n164|\tif censusPairHelpers[name] || censusGatedIdents[name] {\n165|\t\treturn true\n166|\t}\n167|\tif _, ok := censusTrustHelpers[name]; ok {\n168|\t\treturn true\n169|\t}\n170|\tif _, ok := censusCustodyHelpers[name]; ok {\n171|\t\treturn true\n172|\t}\n173|\treturn false\n174|}\n175|\n176|type censusTypeScanner struct {\n177|\tunit                    censusTypeUnit\n178|\tgated                   map[*types.Func]string\n179|\tallowedIndirectObjects  map[*types.Func]map[types.Object]bool\n180|\tallowedInterfaceMethods map[*types.Func]map[types.Object]bool\n181|\tallowedInterfaceSites   map[*types.Func]map[censusInterfaceCallSite]bool\n182|\tallowedFunctionValues   map[types.Object]bool\n183|\tallowedInitializers     map[string]bool\n184|\tfunctionDecls           map[*types.Func]*ast.FuncDecl\n185|\tresult                  []string\n186|}\n187|\n188|type censusIndirectPolicy struct {\n189|\tparameters map[string]bool\n190|\tlocals     map[string]bool\n191|}\n192|\n193|// censusInterfaceMethod identifies one explicitly required interface edge.\n194|// The scanner resolves this descriptor to the loaded selection's concrete\n195|// *types.Func object and stores that object in the per-definition allowlist.\n196|// Calls are admitted only when that object and its exact source call site are\n197|// both present in the reviewed inventory, never by a boolean attached to the\n198|// containing definition or by a method-name heuristic.\n199|type censusInterfaceMethod struct {\n200|\tpkgPath  string\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
