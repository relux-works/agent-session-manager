A conversion has no callable object and is harmless by definition;\n934|\t\t// every other unresolved callee, including an immediate function\n935|\t\t// literal, is an unknown indirect edge and fails closed.\n936|\t\tif typeAndValue, ok := scanner.unit.info.Types[call.Fun]; ok && typeAndValue.IsType() {\n937|\t\t\treturn\n938|\t\t}\n939|\t\tif _, immediate := call.Fun.(*ast.FuncLit); immediate && scanner.allowedInitializers[functionName] {\n940|\t\t\treturn\n941|\t\t}\n942|\t\tscanner.add(call, \"unresolved call callee in \"+functionName)\n943|\t\treturn\n944|\t}\n945|\tfunction, ok := object.(*types.Func)\n946|\tif !ok {\n947|\t\tswitch object.(type) {\n948|\t\tcase *types.Builtin, *types.TypeName:\n949|\t\t\treturn\n950|\t\t}\n951|\t\tif scanner.allowedFunctionValues[object] {\n952|\t\t\treturn\n953|\t\t}\n954|\t\tif !scanner.allowedIndirectObjects[current][object] {\n955|\t\t\tscanner.add(call, \"indirect call callee is not an allowlisted declaration in \"+functionName)\n956|\t\t}\n957|\t\treturn\n958|\t}\n959|\tif helper, isGated := scanner.gated[function]; isGated {\n960|\t\tscanner.checkGatedCall(call, stack, functionName, helper, function, current)\n961|\t\treturn\n962|\t}\n963|\tif censusIsOSMutation(function) {\n964|\t\tscanner.add(call, \"direct os mutation outside the exact backend definition in \"+functionName)\n965|\t\treturn\n966|\t}\n967|\tif censusIsRawMutation(function) {\n968|\t\tallowed := censusRawMutations[function.Name()]\n969|\t\tif !censusAllowedDefinition(function, current, allowed) {\n970|\t\t\tscanner.add(call, \"filesystem mutation method outside the censused writer in \"+functionName)\n971|\t\t}\n972|\t}\n973|}\n974|\n975|func (scanner *censusTypeScanner) checkGatedCall(call *ast.CallExpr, stack []ast.Node, functionName, helper string, helperFunction, current *types.Func) {\n976|\tposition := scanner.unit.fset.Position(call.Pos())\n977|\tif censusPairHelpers[helper] {\n978|\t\tif scanner.insideHoldClosure(stack) {\n979|\t\t\treturn\n980