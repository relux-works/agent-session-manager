ensusTypeScanner) expressionObject(expression ast.Expr) types.Object {\n1168|\tswitch value := expression.(type) {\n1169|\tcase *ast.Ident:\n1170|\t\treturn scanner.unit.info.Uses[value]\n1171|\tcase *ast.SelectorExpr:\n1172|\t\treturn scanner.selectorObject(value)\n1173|\tcase *ast.ParenExpr:\n1174|\t\treturn scanner.expressionObject(value.X)\n1175|\tcase *ast.IndexExpr:\n1176|\t\treturn scanner.expressionObject(value.X)\n1177|\tcase *ast.IndexListExpr:\n1178|\t\treturn scanner.expressionObject(value.X)\n1179|\t}\n1180|\treturn nil\n1181|}\n1182|\n1183|func (scanner *censusTypeScanner) selectorObject(selector *ast.SelectorExpr) types.Object {\n1184|\tif selection := scanner.unit.info.Selections[selector]; selection != nil {\n1185|\t\treturn selection.Obj()\n1186|\t}\n1187|\treturn scanner.unit.info.Uses[selector.Sel]\n1188|}\n1189|\n1190|func (scanner *censusTypeScanner) interfaceMethodObject(expression ast.Expr) (types.Object, bool) {\n1191|\tselector, ok := interfaceSelector(expression)\n1192|\tif !ok {\n1193|\t\treturn nil, false\n1194|\t}\n1195|\tselection := scanner.unit.info.Selections[selector]\n1196|\tif selection == nil || !censusIsInterfaceType(selection.Recv()) {\n1197|\t\treturn nil, false\n1198|\t}\n1199|\treturn selection.Obj(), true\n1200|}\n1201|\n1202|func (scanner *censusTypeScanner) isInterfaceSelector(selector *ast.SelectorExpr) bool {\n1203|\t_, ok := scanner.interfaceMethodObject(selector)\n1204|\treturn ok\n1205|}\n1206|\n1207|func interfaceSelector(expression ast.Expr) (*ast.SelectorExpr, bool) {\n1208|\tfor {\n1209|\t\tswitch value := expression.(type) {\n1210|\t\tcase *ast.SelectorExpr:\n1211|\t\t\treturn value, true\n1212|\t\tcase *ast.ParenExpr:\n1213|\t\t\texpression = value.X\n1214|\t\tdefault:\n1215|\t\t\treturn nil, false\n1216|\t\t}\n1217|\t}\n1218|}\n1219|\n1220|func censusAllowedInterfaceMethod(object types.Object, methods []censusInterfaceMethod) bool {\n1221|\tfunction, ok := object.(*types.Func)\n1222|\tif !ok || function.Pkg() == nil {\n1223|\t\treturn false\n1224|\t}\n1225|\tsignature, ok := function.Type().(*types.Signature)\n1226|\tif !ok || signature.Recv() == nil {\n1227|\t\treturn false\n1228|\t}\n1229|\treceiver := censusNamedType(signature.Recv().Type())\n1230|\tif receiver == \"\" {\n1231|\t\treceiver = types.TypeString(signature.Recv().Type(), nil)\n1232|\t}\n1233|\tfor _, method := range methods {\n1234|\t\tif method.pkgPath == function.Pkg().Path() && method.receiver == receiver && method.name == function.Name() {\n1235|\t\t\treturn true\n1236|\t\t}\n1237|\t}\n1238|\treturn false\n1239|}\n1240|\n1241|func censusIsInterfaceType(typ types.Type) bool {\n1242|\tswitch value := typ.(type) {\n1243|\tcase *types.Pointer:\n1244|\t\treturn censusIsInterfaceType(value.Elem())\n1245|\tcase *types.Named:\n1246|\t\treturn censusIsInterfaceType(value.Underlying())\n1247|\tcase *types.Interface:\n1248|\t\treturn true\n1249|\tcase *types.TypeParam:\n1250|\t\treturn true\n1251|\tdefault:\n1252|\t\treturn false\n1253|\t}\n1254|}\n1255|\n1256|func (scanner *censusTypeScanner) isCallCallee(node ast.Node, stack []ast.Node) bool {\n1257|\tfor index := len(stack) - 1; index > 0; index-- {\n1258|\t\tcall, ok := stack[index-1].(*ast.CallExpr)\n1259|\t\tif ok && call.Fun == node {\n1260|\t\t\treturn true\n1261|\t\t}\n1262|\t\tif call, ok := stack[index-1].(*ast.CallExpr); ok {\n1263|\t\t\tif containsNode(call.Fun, node) {\n1264|\t\t\t\treturn true\n1265|\t\t\t}\n1266|\t\t}\n1267|\t\tif _, ok := stack[index-1].(*ast.FuncLit); ok {\n1268|\t\t\tbreak\n1269|\t\t}\n1270|\t}\n1271|\treturn false\n1272|}\n1273|\n1274|func (scanner *censusTypeScanner) isSelectorName(identifier *ast.Ident, stack []ast.Node) bool {\n1275|\tfor index := len(stack) - 1; index >= 0; index-- {\n1276|\t\tselector, ok := stack[index].(*ast.SelectorExpr)\n1277|\t\tif ok && selector.Sel == identifier {\n1278|\t\t\treturn true\n1279|\t\t}\n1280|\t}\n1281|\treturn false\n1282|}\n1283|\n1284|func containsNode(root ast.Node, needle ast.Node) bool {\n1285|\tfound := false\n1286|\tast.Inspect(root, func(node ast.Node) bool {\n1287|\t\tif node == needle {\n1288|\t\t\tfound = true\n1289|\t\t\treturn false\n1290|\t\t}\n1291|\t\treturn !found\n1292|\t})\n1293|\treturn found\n1294|}\n1295|\n1296|func (scanner *censusTypeScanner) insideHoldClosure(stack []ast.Node) bool {\n1297|\tfor index := len(stack) - 1; index >= 0; index-- {\n1298|\t\tliteral, ok := stack[index].(*ast.FuncLit)\n1299|\t\tif !ok {\n1300|\t\t\tcontinue\n1301|\t\t}\n1302|\t\tif index == 0 {\n1303|\t\t\treturn false\n1304|\t\t}\n1305|\t\tcall, ok := stack[index-1].(*ast.CallExpr)\n1306|\t\tif !ok || !scanner.isHoldEntryCall(call) {\n1307|\t\t\treturn false\n1308|\t\t}\n1309|\t\tfor _, argument := range call.Args {\n1310|\t\t\tif argument == literal {\n1311|\t\t\t\treturn true\n1312|\t\t\t}\n1313|\t\t}\n1314|\t\treturn false\n1315|\t}\n1316|\treturn false\n1317|}\n1318|\n1319|func (scanner *censusTypeScanner) isHoldEntryCall(call *ast.CallExpr) bool {\n1320|\tobject, resolved := scanner.callObject(call)\n1321|\tif !resolved {\n1322|\t\treturn false\n1323|\t}\n1324|\tfunction, ok := object.(*types.Func)\n1325|\tif !ok {\n1326|\t\treturn false\n1327|\t}\n1328|\treturn censusHoldEntries[censusFunctionOf(function)]\n1329|}\n1330|\n1331|func (scanner *censusTypeScanner) add(node ast.Node, message string) {\n1332|\tposition := scanner.unit.fset.Position(node.Pos())\n1333|\tscanner.result = append(scanner.result, fmt.Sprintf(\"%s:%d: %s\", position.Filename, position.Line, message))\n1334|}\n1335|\n1336|func censusIsOSMutation(function *types.Func) bool {\n1337|\treturn function != nil && function.Pkg() != nil && function.Pkg().Path() == \"os\" && censusOSMutations[function.Name()]\n1338|}\n1339|\n1340|func censusIsRawMutation(function *types.Func) bool {\n1341|\tif function == nil || censusIsOSMutation(function) {\n1342|\t\treturn false\n1343|\t}\n1344|\tif _, ok := censusRawMutations[function.Name()]; ok {\n1345|\t\treturn function.Type() != nil && function.Type().(*types.Signature).Recv() != nil\n1346|\t}\n1347|\treturn function.Name() == \"CreateExclusive\"\n1348|}\n1349|\n1350|var censusHoldEntries = map[censusFunction]bool{\n1351|\t{pkgPath: \"github.com/relux-works/agent-session-manager/internal/hosttrust\", receiver: \"Store\", name: \"JointCommit\"}:                true,\n1352|\t{pkgPath: \"github.com/relux-works/agent-session-manager/internal/hosttrust\", receiver: \"Store\", name: \"WithExclusiveHold\"}:          true,\n1353|\t{pkgPath: \"github.com/relux-works/agent-session-manager/internal/hosttrust\", receiver: \"Store\", name: \"WithExclusiveHoldForConfig\"}: true,\n1354|\t{pkgPath: \"censuscontrol\", receiver: \"store\", name: \"JointCommit\"}:                                                                  true,\n1355|\t{pkgPath: \"censuscontrol\", receiver: \"store\", name: \"WithExclusiveHold\"}:                                                            true,\n1356|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
