+func replaceOnce(document, old, replacement string) string {
+	for index := 0; index+len(old) <= len(document); index++ {
+		if document[index:index+len(old)] == old {
+			return document[:index] + replacement + document[index+len(old):]
+		}
+	}
+	return document
+}
