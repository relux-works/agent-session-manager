+func openPathsForTest(t *testing.T, configPath, stateDir string) *Store {
+	t.Helper()
+	store, err := Open(resolvedPathsForTest(t, configPath, stateDir))
+	if err != nil {
+		t.Fatalf("Open(%s) error = %v", stateDir, err)
