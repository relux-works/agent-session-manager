+	}
+	if loaded.SourceVersion != CurrentVersion || coherent.Generation != before {
+		t.Fatalf("compensated pair is version %q generation %d, want %s/%d",
+			loaded.SourceVersion, coherent.Generation, CurrentVersion, before)
+	}
