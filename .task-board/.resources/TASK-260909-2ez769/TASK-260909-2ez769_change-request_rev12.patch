+func TestRollbackV4TrustCommitRecoveryFailure(t *testing.T) {
+	fixture := setupV4Fixture(t, testPeerID)
+	preview, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now)
