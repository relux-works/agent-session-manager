   517		}
   518		if _, err := hosttrust.Open(fixture.stateDir); err == nil {
   519			t.Fatal("openStore(failed restore) succeeded, want refusal")
   520		} else if !errors.Is(err, hosttrust.ErrGenerationExhausted) {
   521			t.Fatalf("openStore error = %v, want ErrGenerationExhausted", err)
   522		}
   523	}
