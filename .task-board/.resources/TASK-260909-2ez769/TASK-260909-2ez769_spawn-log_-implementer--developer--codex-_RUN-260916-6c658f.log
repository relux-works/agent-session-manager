+// censusIsCensusedDefinition identifies the narrow set of production and
+// synthetic definitions whose bodies are already covered by a stronger
+// helper-specific rule. Calls through a function value, interface method or
+// other indirect target are tolerated only in these definitions; ordinary
+// callers must be rejected because go/types cannot prove the target's effect.
+func censusIsCensusedDefinition(function *types.Func) bool {
+	if function == nil || function.Pkg() == nil {
+		return false
+	}
+	if censusBackendDefinition(function) {
+		return true
+	}
+	if censusPairHelpers[function.Name()] || censusGatedIdents[function.Name()] {
+		return true
+	}
+	if censusCensusedWriterNames[function.Pkg().Path()][function.Name()] {
+		return true
+	}
+	for _, allowed := range censusTrustHelpers {
+		if censusAllowedDefinition(function, function, allowed) {
+			return true
+		}
+	}
+	for _, allowed := range censusCustodyHelpers {
+		if censusAllowedDefinition(function, function, allowed) {
+			return true
+		}
+	}
+	return false
