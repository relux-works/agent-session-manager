  if string(after)!=string(replacement){t.Fatal("witness failed")}
  t.Fatal("foreign store token replaced target configuration while another goroutine exclusively held target store")
 }
}
package config
import "github.com/relux-works/agent-session-manager/internal/hosttrust"
func reviewerForeignWrite(other *hosttrust.Store, filename string, replacement []byte) error {
 return other.WithExclusiveHoldForConfig(filename, func(hold hosttrust.HeldExclusive) error {
  _, err := writeTempReplace(hold, osMigrationFileSystem{}, filename, replacement)
  return err
 })
