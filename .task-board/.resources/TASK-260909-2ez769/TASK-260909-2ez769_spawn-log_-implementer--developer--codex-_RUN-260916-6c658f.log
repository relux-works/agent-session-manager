+// path is canonicalized here, before any hold is minted; callers cannot bind
+// a generic store to an arbitrary target later through
+// WithExclusiveHoldForConfig.
+func OpenForConfig(stateDir, configPath string) (*Store, error) {
+	canonical, err := canonicalExistingPath(configPath)
+	if err != nil {
+		return nil, trustError(TrustError{Operation: "open configured store", Err: errors.Join(ErrInvalidStoreContext, err)})
+	}
+	store, err := openStore(stateDir, osFileSystem{})
+	if err != nil {
+		return nil, err
+	}
+	store.configPath = canonical
+	return store, nil
