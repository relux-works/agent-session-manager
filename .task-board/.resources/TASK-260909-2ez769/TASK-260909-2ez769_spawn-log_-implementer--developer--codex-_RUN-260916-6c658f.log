+func censusIsInterfaceType(typ types.Type) bool {
+	switch value := typ.(type) {
+	case *types.Pointer:
+		return censusIsInterfaceType(value.Elem())
+	case *types.Named:
+		return censusIsInterfaceType(value.Underlying())
+	case *types.Interface:
+		return true
+	default:
+		return false
+	}
+}
