+
+func censusPotentialMutationType(typ types.Type) bool {
+	switch value := typ.(type) {
+	case *types.Named:
+		return censusPotentialMutationType(value.Underlying())
+	case *types.Pointer:
+		return censusPotentialMutationType(value.Elem())
+	case *types.Slice:
+		return censusPotentialMutationType(value.Elem())
+	case *types.Array:
+		return censusPotentialMutationType(value.Elem())
+	case *types.Signature:
+		return censusPotentialMutationSignature(value)
+	default:
+		return false
+	}
+}
+
+func censusPotentialMutationSignature(signature *types.Signature) bool {
+	if signature == nil || signature.Params().Len() < 2 {
+		return false
+	}
+	first, ok := signature.Params().At(0).Type().(*types.Basic)
+	if !ok || first.Kind() != types.String {
+		return false
+	}
+	return censusIsByteSlice(signature.Params().At(1).Type())
+}
+
+func censusIsByteSlice(typ types.Type) bool {
+	switch value := typ.(type) {
+	case *types.Named:
+		return censusIsByteSlice(value.Underlying())
+	case *types.Slice:
+		basic, ok := value.Elem().(*types.Basic)
+		return ok && basic.Kind() == types.Byte
+	default:
+		return false
+	}
+}
+
+func censusKnownNonFunctionCall(expression ast.Expr) bool {
+	switch value := expression.(type) {
+	case *ast.ArrayType, *ast.ChanType, *ast.Ellipsis, *ast.FuncType, *ast.InterfaceType, *ast.MapType, *ast.StructType:
+		return true
