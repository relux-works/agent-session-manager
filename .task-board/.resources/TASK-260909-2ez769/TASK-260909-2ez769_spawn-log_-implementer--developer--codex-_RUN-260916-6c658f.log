		if current.Generation != snapshot.Generation {
			return errors.New("generation moved")
		}
		return nil
	}
	generation, err := store.JointCommit(marker, revalidate, replace, unexpectedRestore)
	if err != nil {
		t.Fatalf("JointCommit error = %v", err)
	}
