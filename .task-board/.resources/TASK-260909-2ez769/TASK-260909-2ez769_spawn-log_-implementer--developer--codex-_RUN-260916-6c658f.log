@@ -0,0 +1,28 @@
+package config
+
+import (
+	"fmt"
+	"go/ast"
+	"testing"
+)
+
+func TestDebugCensusObjects(t *testing.T) {
+	unit, err := loadCensusTypeUnit(".")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, file := range unit.files {
+		ast.Inspect(file, func(node ast.Node) bool {
+			call, ok := node.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			if unit.fset.Position(call.Pos()).Filename == "" {
+				return true
+			}
+			object := unit.info.Uses[call.Fun.(*ast.SelectorExpr).Sel]
+			fmt.Printf("%s fun=%T sel=%v object=%T %v\n", unit.fset.Position(call.Pos()), call.Fun, call.Fun, object, object)
+			return true
+		})
+	}
+}
