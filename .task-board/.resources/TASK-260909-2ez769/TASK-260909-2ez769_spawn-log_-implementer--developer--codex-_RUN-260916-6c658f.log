+func (scanner *censusTypeScanner) callUsesInterfaceMethod(call *ast.CallExpr) bool {
+	selector, ok := call.Fun.(*ast.SelectorExpr)
+	if !ok {
+		return false
+	}
+	selection := scanner.unit.info.Selections[selector]
+	if selection == nil {
+		return false
+	}
+	return censusIsInterfaceType(selection.Recv())
+}
+
+func censusIsInterfaceType(typ types.Type) bool {
+	switch value := typ.(type) {
+	case *types.Pointer:
+		return censusIsInterfaceType(value.Elem())
+	case *types.Named:
+		return censusIsInterfaceType(value.Underlying())
+	case *types.Interface:
+		return true
+	default:
+		return false
+	}
+}
