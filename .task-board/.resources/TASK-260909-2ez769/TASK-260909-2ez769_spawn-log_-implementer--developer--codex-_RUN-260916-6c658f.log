func jointFixture(t *testing.T, source, replacement []byte) (*Store, string, Snapshot) {
	t.Helper()
	directory := t.TempDir()
	configPath := filepath.Join(directory, "config.toml")
	if err := os.WriteFile(configPath, source, 0o600); err != nil {
