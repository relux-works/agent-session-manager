   236			t.Fatal(err)
   237		}
   238		marker := hosttrust.PendingCommit{
   239			Schema:            "urn:ax:schema:host-pending-commit",
   240			SchemaVersion:     "1.0.0",
   410		exit, ok := err.(*exec.ExitError)
   411		if !ok || exit.ExitCode() != 77 {
   412			t.Fatalf("child did not crash at the replacement seam: %v %s", err, output)
   413		}
   414		// Restart recovery must converge the pair: admitting the new Config4
   415		// with the old generation fails the test. Every read here must
   416		// succeed: a Load, Configuration, Open or ReadSnapshot error is a
   417		// failed convergence, not a pass, so each fails explicitly instead of
   418		// returning silently.
   419		loaded, err := Load(fixture.inputs, nil)
   420		if err != nil {
   421			t.Fatalf("Load after child exit 77 error = %v", err)
   422		}
   423		configuration, ok := loaded.Configuration()
   424		if !ok {
   425			t.Fatal("Load after child exit 77 has no configuration")
   426		}
   427		reopened, err := hosttrust.Open(fixture.stateDir)
   428		if err != nil {
   429			t.Fatalf("hosttrust.Open after child exit 77 error = %v", err)
   430		}
   431		snapshot, err := reopened.ReadSnapshot()
   432		if err != nil {
   433			t.Fatalf("ReadSnapshot after child exit 77 error = %v", err)
   434		}
   435		if configuration.SourceVersion == Version4 && snapshot.Generation == before {
   436			t.Fatalf("restart admits new Config4 with old generation %d after child exit 77", before)
   437		}
   438		if configuration.SourceVersion != Version4 || snapshot.Generation != before+1 {
   439			t.Fatalf("restart converged to version %q generation %d, want 4.0.0/%d", configuration.SourceVersion, snapshot.Generation, before+1)
   440		}
   500		// The config replacement succeeds but the generation bump is refused at
   501		// the uint53 ceiling, and the source restore fails too: the error must
   502		// report the compound failure, never silent success. Rename 1 installs
   503		// the replacement; rename 2 (the restore) is faulted.
   504		failing := &faultMigrationFileSystem{failRenameCall: 2}
   505		if _, err := applyV4(fixture.inputs, nil, preview, true, fixture.now, failing, openStoreForConfig); err == nil {
   506			t.Fatal("ApplyV4(compound durability failure) succeeded, want failure")
   507		} else if !errors.Is(err, ErrMigrationRecovery) {
   508			t.Fatalf("ApplyV4(compound) error = %v, want recovery failure", err)
   509		}
   510		// The replacement stayed durable with the marker kept for operator
   511		// resolution. Recovery cannot converge it either: the forward bump
   512		// refuses again at the exhausted ceiling, so the open fails and the
   513		// marker stays instead of converging silently.
   514		channel := filepath.Join(fixture.stateDir, "host-channel")
   515		if _, err := os.Lstat(filepath.Join(channel, "pending-commit.json")); err != nil {
