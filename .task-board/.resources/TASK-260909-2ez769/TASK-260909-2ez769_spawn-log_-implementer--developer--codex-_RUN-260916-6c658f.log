+func censusIsFmtStateWrite(function *types.Func) bool {
+	if function == nil || function.Name() != "Write" {
+		return false
+	}
+	signature, ok := function.Type().(*types.Signature)
+	if !ok || signature.Recv() == nil {
+		return false
+	}
+	typ := signature.Recv().Type()
+	for {
+		named, ok := typ.(*types.Named)
+		if ok {
+			object := named.Obj()
+			return object.Name() == "State" && object.Pkg() != nil && object.Pkg().Path() == "fmt"
+		}
+		pointer, ok := typ.(*types.Pointer)
+		if !ok {
+			return false
+		}
+		typ = pointer.Elem()
+	}
