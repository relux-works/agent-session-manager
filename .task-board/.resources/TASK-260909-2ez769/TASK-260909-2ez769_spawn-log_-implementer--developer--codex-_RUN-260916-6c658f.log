+// cannot retarget a generic hold or bind an unrelated absolute path while
+// acquiring the lock. This is the resource boundary used by config's
+// requireHoldForConfig.
+func (store *Store) bindConfigPath(hold HeldExclusive, requested string) (HeldExclusive, error) {
+	if err := requireHoldForRoot(hold, store.root); err != nil {
+		return HeldExclusive{}, err
+	}
+	if store.configPath == "" {
+		return HeldExclusive{}, trustError(TrustError{Operation: "bind configuration hold resource", Err: ErrExclusiveHoldResourceMismatch})
+	}
+	canonical, err := canonicalExistingPath(requested)
+	if err != nil || canonical != store.configPath {
+		return HeldExclusive{}, trustError(TrustError{Operation: "bind configuration hold resource", Err: ErrExclusiveHoldResourceMismatch})
