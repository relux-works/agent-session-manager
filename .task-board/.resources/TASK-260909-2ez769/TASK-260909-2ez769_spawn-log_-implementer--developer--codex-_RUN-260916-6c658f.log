+func censusPotentialMutationFunction(function *types.Func) bool {
+	if function == nil {
+		return false
+	}
+	if censusIsOSMutation(function) || censusIsRawMutation(function) {
+		return true
+	}
+	name := strings.ToLower(function.Name())
