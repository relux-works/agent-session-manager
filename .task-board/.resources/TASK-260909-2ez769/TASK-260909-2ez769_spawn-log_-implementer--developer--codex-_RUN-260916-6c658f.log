@@ -0,0 +1,34 @@
+package config
+
+import (
+	"fmt"
+	"go/ast"
+	"testing"
+)
+
+func TestDebugCensusObjects(t *testing.T) {
+	unit, err := loadCensusTypeUnit(".")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, file := range unit.files {
+		ast.Inspect(file, func(node ast.Node) bool {
+			call, ok := node.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			if unit.fset.Position(call.Pos()).Filename == "" {
+				return true
+			}
+			var object any
+			switch fun := call.Fun.(type) {
+			case *ast.SelectorExpr:
+				object = unit.info.Uses[fun.Sel]
+			case *ast.Ident:
+				object = unit.info.Uses[fun]
+			}
+			fmt.Printf("%s fun=%T object=%T %v\n", unit.fset.Position(call.Pos()), call.Fun, object, object)
+			return true
+		})
+	}
+}
