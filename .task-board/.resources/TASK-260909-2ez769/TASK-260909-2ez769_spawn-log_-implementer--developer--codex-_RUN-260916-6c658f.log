-func (held HeldExclusive) bindConfigPath(path string) (HeldExclusive, error) {
-	if err := requireHold(held); err != nil {
-		return HeldExclusive{}, err
+// canonicalExistingPath returns the identity used by the pair writer. The
+// identity follows symlinks before comparing paths, and a missing/unreadable
+// target is a refusal rather than an invitation to mint a new binding.
+func canonicalExistingPath(path string) (string, error) {
+	if path == "" || !filepath.IsAbs(path) {
+		return "", ErrInvalidStoreContext
 	}
-	canonical, err := absoluteClean(path)
+	abs, err := filepath.Abs(filepath.Clean(path))
 	if err != nil {
-		return HeldExclusive{}, trustError(TrustError{Operation: "bind configuration hold resource", Err: ErrExclusiveHoldResourceMismatch})
+		return "", err
 	}
-	if held.configPath != "" && held.configPath != canonical {
-		return HeldExclusive{}, trustError(TrustError{Operation: "bind configuration hold resource", Err: ErrExclusiveHoldResourceMismatch})
+	resolved, err := filepath.EvalSymlinks(abs)
+	if err != nil {
+		return "", err
 	}
-	return HeldExclusive{hold: held.hold, configPath: canonical}, nil
+	return filepath.Clean(resolved), nil
 }
 
 // exclusiveHold acquires the exclusive authorization lock and returns the
@@ -151,10 +155,29 @@
 		return trustError(TrustError{Operation: "run exclusive hold", Err: ErrAuthorizationRefused})
 	}
 	if configPath != "" {
-		hold, err = hold.bindConfigPath(configPath)
+		hold, err = store.bindConfigPath(hold, configPath)
 		if err != nil {
 			return err
 		}
 	}
 	return fn(hold)
 }
+
+// bindConfigPath derives the pair binding from the Store that minted the
+// hold. The caller may only repeat the store-owned configuration path; it
+// cannot retarget a generic hold or bind an unrelated absolute path while
+// acquiring the lock. This is the resource boundary used by config's
+// requireHoldForConfig.
+func (store *Store) bindConfigPath(hold HeldExclusive, requested string) (HeldExclusive, error) {
+	if err := requireHoldForRoot(hold, store.root); err != nil {
+		return HeldExclusive{}, err
+	}
+	if store.configPath == "" {
+		return HeldExclusive{}, trustError(TrustError{Operation: "bind configuration hold resource", Err: ErrExclusiveHoldResourceMismatch})
+	}
+	canonical, err := canonicalExistingPath(requested)
+	if err != nil || canonical != store.configPath {
+		return HeldExclusive{}, trustError(TrustError{Operation: "bind configuration hold resource", Err: ErrExclusiveHoldResourceMismatch})
+	}
+	return HeldExclusive{hold: hold.hold, configPath: store.configPath}, nil
+}
