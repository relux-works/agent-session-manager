diff --git a/internal/config/debug_census_test.go b/internal/config/debug_census_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..650e9e3d9d82bf19888ee7826a5123c912e8ae8a
--- /dev/null
+++ b/internal/config/debug_census_test.go
@@ -0,0 +1,51 @@
+package config
+
+import (
+	"fmt"
+	"go/ast"
+	"go/types"
+	"testing"
+)
+
+func TestDebugCensusIndirectCalls(t *testing.T) {
+	for _, dir := range []string{".", "../hosttrust"} {
+		unit, err := loadCensusTypeUnit(dir)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, file := range unit.files {
+			ast.Inspect(file, func(node ast.Node) bool {
+				call, ok := node.(*ast.CallExpr)
+				if !ok {
+					return true
+				}
+				var object types.Object
+				switch fun := call.Fun.(type) {
+				case *ast.Ident:
+					object = unit.info.Uses[fun]
+				case *ast.SelectorExpr:
+					object = unit.info.Uses[fun.Sel]
+				}
+				if selector, ok := call.Fun.(*ast.SelectorExpr); ok {
+					object = unit.info.Uses[selector.Sel]
+					if selection := unit.info.Selections[selector]; selection != nil {
+						object = selection.Obj()
+						if object == nil {
+							return true
+						}
+						if fn, ok := object.(*types.Func); ok {
+							receiver := fn.Type().(*types.Signature).Recv().Type()
+							if censusIsInterfaceType(receiver) {
+								fmt.Printf("%s interface=%s recv=%s\n", unit.fset.Position(call.Pos()), fn.Name(), censusNamedType(receiver))
+							}
+						}
+					}
+				}
+				if variable, ok := object.(*types.Var); ok {
+					fmt.Printf("%s var=%s type=%s\n", unit.fset.Position(call.Pos()), variable.Name(), variable.Type())
+				}
+				return true
+			})
+		}
+	}
+}
