{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d2f7","stream":{"kind":"session","id":"01a0ada8-0185-76f0-8192-f6e1be48611d"},"sequence":2006,"recorded_at":1780531400004007,"record_type":"event","durability":"durable","causation_id":"e58530cc-c434-4c84-a6d6-35c15a8ccfca","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e58530cc-c434-4c84-a6d6-35c15a8ccfca","run_stream":{"kind":"run","id":"e58530cc-c434-4c84-a6d6-35c15a8ccfca"},"task_stream":{"kind":"task","id":"01a0adc2-0203-7fa2-ba22-cc903e7550e2"},"task_id":"01a0adc2-0203-7fa2-ba22-cc903e7550e2","event":{"kind":"output","task_id":"01a0adc2-0203-7fa2-ba22-cc903e7550e2","chunk":"Read text file `/Users/iv/rev12work/candidate/internal/hosttrust/binding_rebind_test.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"io/fs\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"sync\"\n9|\t\"testing\"\n10|)\n11|\n12|// TestReviewerRefusedRebindLeavesTargetUnclaimed drives the production\n13|// enrollment entry point with two Stores opened before either configuration is\n14|// bound. A rejected request must not publish a target-side claim as a side\n15|// effect of discovering that the shared store is already bound.\n16|func TestReviewerRefusedRebindLeavesTargetUnclaimed(t *testing.T) {\n17|\tdirectory := t.TempDir()\n18|\tconfigA := filepath.Join(directory, \"a.toml\")\n19|\tconfigB := filepath.Join(directory, \"b.toml\")\n20|\tfor _, path := range []string{configA, configB} {\n21|\t\tif err := os.WriteFile(path, []byte(\"source\"), 0o600); err != nil {\n22|\t\t\tt.Fatal(err)\n23|\t\t}\n24|\t}\n25|\tstate := filepath.Join(directory, \"shared-state\")\n26|\tpathsA := resolvedPathsForTest(t, configA, state)\n27|\tpathsB := resolvedPathsForTest(t, configB, state)\n28|\tstoreA := openPathsForTest(t, configA, state)\n29|\tstoreB := openPathsForTest(t, configB, state)\n30|\tif err := storeA.EnsureConfigBinding(pathsA); err != nil {\n31|\t\tt.Fatalf(\"EnsureConfigBinding(A/shared-state) = %v\", err)\n32|\t}\n33|\tif err := storeB.EnsureConfigBinding(pathsB); !errors.Is(err, ErrExclusiveHoldResourceMismatch) {\n34|\t\tt.Fatalf(\"EnsureConfigBinding(B/shared-state) = %v, want resource mismatch\", err)\n35|\t}\n36|\n37|\tcanonicalB, err := canonicalExistingPath(configB)\n38|\tif err != nil {\n39|\t\tt.Fatal(err)\n40|\t}\n41|\tif _, err := os.Lstat(configBindingPath(canonicalB)); !os.IsNotExist(err) {\n42|\t\tt.Fatalf(\"rejected B target sidecar = %v, want absent\", err)\n43|\t}\n44|\tcanonicalA, err := canonicalExistingPath(configA)\n45|\tif err != nil {\n46|\t\tt.Fatal(err)\n47|\t}\n48|\tboundA, present, err := loadTargetConfigBinding(osFileSystem{}, canonicalA)\n49|\tif err != nil {\n50|\t\tt.Fatal(err)\n51|\t}\n52|\tif !present || boundA.ConfigPath != canonicalA || boundA.StateRoot != mustCanonicalPathForTest(t, state) {\n53|\t\tt.Fatalf(\"accepted A binding after rejected B = %#v (present=%v), want the original pair\", boundA, present)\n54|\t}\n55|\tboundStore, present, err := loadStoreConfigBinding(osFileSystem{}, storeA.Root())\n56|\tif err != nil {\n57|\t\tt.Fatal(err)\n58|\t}\n59|\tif !present || boundStore.ConfigPath != canonicalA || boundStore.StateRoot != mustCanonicalPathForTest(t, state) {\n60|\t\tt.Fatalf(\"store binding after rejected B = %#v (present=%v), want the original pair\", boundStore, present)\n61|\t}\n62|\n63|\t// If the rejected request left a sidecar behind, this otherwise independent\n64|\t// state root would be incorrectly refused by the next legitimate enrollment.\n65|\tforeignState := filepath.Join(directory, \"foreign-state\")\n66|\tforeignPaths := resolvedPathsForTest(t, configB, foreignState)\n67|\tforeign := openPathsForTest(t, configB, foreignState)\n68|\tif err := foreign.EnsureConfigBinding(foreignPaths); err != nil {\n69|\t\tt.Fatalf(\"EnsureConfigBinding(B/foreign-state) = %v, want success after refused shared request\", err)\n70|\t}\n71|}\n72|\n73|// TestCompetingFirstBindingsPublishExactlyOneAssociation drives the same\n74|// target through two independently opened stores. The per-target bootstrap\n75|// lock and the state-root check must produce one winner and one side-effect\n76|// free refusal.\n77|func TestCompetingFirstBindingsPublishExactlyOneAssociation(t *testing.T) {\n78|\tdirectory := t.TempDir()\n79|\tconfigPath := filepath.Join(directory, \"config.toml\")\n80|\tif err := os.WriteFile(configPath, []byte(\"source\"), 0o600); err != nil {\n81|\t\tt.Fatal(err)\n82|\t}\n83|\tstateA := filepath.Join(directory, \"state-a\")\n84|\tstateB := filepath.Join(directory, \"state-b\")\n85|\tpathsA := resolvedPathsForTest(t, configPath, stateA)\n86|\tpathsB := resolvedPathsForTest(t, configPath, stateB)\n87|\tstoreA := openPathsForTest(t, configPath, stateA)\n88|\tstoreB := openPathsForTest(t, configPath, stateB)\n89|\n90|\tstart := make(chan struct{})\n91|\tresults := make(chan error, 2)\n92|\tvar wait sync.WaitGroup\n93|\twait.Add(2)\n94|\tgo func() {\n95|\t\tdefer wait.Done()\n96|\t\t<-start\n97|\t\tresults <- storeA.EnsureConfigBinding(pathsA)\n98|\t}()\n99|\tgo func() {\n100|\t\tdefer wait.Done()\n101|\t\t<-start\n102|\t\tresults <- storeB.EnsureConfigBinding(pathsB)\n103|\t}()\n104|\tclose(start)\n105|\twait.Wait()\n106|\tclose(results)\n107|\n108|\tvar successes, refusals int\n109|\tfor err := range results {\n110|\t\tswitch {\n111|\t\tcase err == nil:\n112|\t\t\tsuccesses++\n113|\t\tcase errors.Is(err, ErrExclusiveHoldResourceMismatch):\n114|\t\t\trefusals++\n115|\t\tdefault:\n116|\t\t\tt.Fatalf(\"competing EnsureConfigBinding error = %v, want success or resource mismatch\", err)\n117|\t\t}\n118|\t}\n119|\tif successes != 1 || refusals != 1 {\n120|\t\tt.Fatalf(\"competing binding outcomes = %d successes/%d refusals, want 1/1\", successes, refusals)\n121|\t}\n122|\n123|\tcanonical, err := canonicalExistingPath(configPath)\n124|\tif err != nil {\n125|\t\tt.Fatal(err)\n126|\t}\n127|\tbinding, present, err := loadTargetConfigBinding(osFileSystem{}, canonical)\n128|\tif err != nil {\n129|\t\tt.Fatal(err)\n130|\t}\n131|\tif !present {\n132|\t\tt.Fatal(\"competing binding requests left no target association\")\n133|\t}\n134|\tif binding.StateRoot != mustCanonicalPathForTest(t, stateA) && binding.StateRoot != mustCanonicalPathForTest(t, stateB) {\n135|\t\tt.Fatalf(\"winning state root = %q, want %q or %q\", binding.StateRoot, mustCanonicalPathForTest(t, stateA), mustCanonicalPathForTest(t, stateB))\n136|\t}\n137|\tfor name, store := range map[string]*Store{\"A\": storeA, \"B\": storeB} {\n138|\t\tstoreBinding, present, err := loadStoreConfigBinding(osFileSystem{}, store.Root())\n139|\t\tif err != nil {\n140|\t\t\tt.Fatal(err)\n141|\t\t}\n142|\t\twantPresent := storeBinding.StateRoot == binding.StateRoot\n143|\t\tif present != wantPresent {\n144|\t\t\tt.Fatalf(\"competing store %s index presence = %v with binding %#v, want %v\", name, present, storeBinding, wantPresent)\n145|\t\t}\n146|\t\tif present && (storeBinding.ConfigPath != binding.ConfigPath || storeBinding.StateRoot != binding.StateRoot) {\n147|\t\t\tt.Fatalf(\"competing store %s index = %#v, want winner %#v\", name, storeBinding, binding)\n148|\t\t}\n149|\t}\n150|}\n151|\n152|// failStoreBindingRenameFS simulates a crash/failure after the authoritative\n153|// target sidecar is durable but before its derived store index is published.\n154|// The exact store-index rename is the only injected failure.\n155|type failStoreBindingRenameFS struct {\n156|\tFileSystem\n157|}\n158|\n159|func (filesystem failStoreBindingRenameFS) Rename(oldname, newname string) error {\n160|\tif filepath.Base(newname) == configBindingFileName {\n161|\t\treturn errors.New(\"injected store binding index rename failure\")\n162|\t}\n163|\treturn filesystem.FileSystem.Rename(oldname, newname)\n164|}\n165|\n166|func (filesystem failStoreBindingRenameFS) CreateTemp(dir, pattern string, mode fs.FileMode) (StagedFile, error) {\n167|\treturn filesystem.FileSystem.CreateTemp(dir, pattern, mode)\n168|}\n169|\n170|// TestInterruptedFirstBindingIsRepairedAfterReopen preserves the target-side\n171|// record across a failed derived-index commit, then reopens the store and\n172|// drives the explicit repair path. The target is never rebound to a different\n173|// state root, and the repair publishes only the missing index.\n174|func TestInterruptedFirstBindingIsRepairedAfterReopen(t *testing.T) {\n175|\tdirectory := t.TempDir()\n176|\tconfigPath := filepath.Join(directory, \"config.toml\")\n177|\tif err := os.WriteFile(configPath, []byte(\"source\"), 0o600); err != nil {\n178|\t\tt.Fatal(err)\n179|\t}\n180|\tstate := filepath.Join(directory, \"state\")\n181|\tpaths := resolvedPathsForTest(t, configPath, state)\n182|\tstore := openPathsForTest(t, configPath, state)\n183|\tstore.fs = failStoreBindingRenameFS{FileSystem: store.fs}\n184|\tif err := store.EnsureConfigBinding(paths); !errors.Is(err, ErrTrustDurability) {\n185|\t\tt.Fatalf(\"EnsureConfigBinding(injected index failure) = %v, want durability error\", err)\n186|\t}\n187|\tcanonical, err := canonicalExistingPath(configPath)\n188|\tif err != nil {\n189|\t\tt.Fatal(err)\n190|\t}\n191|\tif _, err := os.Lstat(configBindingPath(canonical)); err != nil {\n192|\t\tt.Fatalf(\"target sidecar after injected index failure: %v\", err)\n193|\t}\n194|\tif _, err := os.Lstat(bindingPath(store.Root())); !os.IsNotExist(err) {\n195|\t\tt.Fatalf(\"store index after injected index failure = %v, want absent\", err)\n196|\t}\n197|\n198|\treopened, err := Open(paths)\n199|\tif err != nil {\n200|\t\tt.Fatalf(\"Open after interrupted first binding = %v\", err)\n201|\t}\n202|\tif err := reopened.EnsureConfigBinding(paths); err != nil {\n203|\t\tt.Fatalf(\"EnsureConfigBinding repair after reopen = %v\", err)\n204|\t}\n205|\tif _, err := os.Lstat(bindingPath(reopened.Root())); err != nil {\n206|\t\tt.Fatalf(\"store index after repair: %v\", err)\n207|\t}\n208|\tif err := reopened.ValidateBoundConfigPath(paths); err != nil {\n209|\t\tt.Fatalf(\"ValidateBoundConfigPath after repair = %v\", err)\n210|\t}\n211|}\n212|\n213|func mustCanonicalPathForTest(t *testing.T, path string) string {\n214|\tt.Helper()\n215|\tcanonical, err := canonicalExistingPath(path)\n216|\tif err != nil {\n217|\t\tt.Fatal(err)\n218|\t}\n219|\treturn canonical\n220|}","final_result":true}}}
