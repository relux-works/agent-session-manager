{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7f3","stream":{"kind":"session","id":"01a0ada8-0185-76f0-8192-f6e1be48611d"},"sequence":596,"recorded_at":1780531400001187,"record_type":"event","durability":"durable","causation_id":"e58530cc-c434-4c84-a6d6-35c15a8ccfca","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e58530cc-c434-4c84-a6d6-35c15a8ccfca","run_stream":{"kind":"run","id":"e58530cc-c434-4c84-a6d6-35c15a8ccfca"},"call_id":"call_01a0ada959517105a236dd4ee140e1e9","text":"Read text file `/tmp/rev12/candidate/internal/config/writepath_census_test.go`.\n(539 line(s) above)\n540|\treturn violations\n541|}\n542|\n543|func censusPackageDirs(t *testing.T) (configDir, trustDir string) {\n544|\tt.Helper()\n545|\t_, file, _, ok := runtime.Caller(0)\n546|\tif !ok {\n547|\t\tt.Fatal(\"runtime.Caller failed\")\n548|\t}\n549|\tconfigDir = filepath.Dir(file)\n550|\ttrustDir = filepath.Join(configDir, \"..\", \"hosttrust\")\n551|\treturn configDir, trustDir\n552|}\n553|\n554|func TestWritePathCensusGate(t *testing.T) {\n555|\tconfigDir, trustDir := censusPackageDirs(t)\n556|\tviolations := censusViolations(t, configDir, trustDir)\n557|\tfor _, violation := range violations {\n558|\t\tt.Errorf(\"write-path census violation: %s\", violation)\n559|\t}\n560|}\n561|\n562|// TestWritePathCensusRejectsUnlistedInterfaceCallSite copies the production\n563|// source into an isolated module, plants two real filesystem renames in\n564|// replaceDurably at new positions, and runs the production census plus a\n565|// valid-hold witness. The pre-hold plant proves ordering; the post-hold plant\n566|// proves that an unlisted site cannot inherit authorization from the same\n567|// interface method. The test expects the child census to fail while the\n568|// witness succeeds, so a site-admission mutant is observable behaviorally.\n569|func TestWritePathCensusRejectsUnlistedInterfaceCallSite(t *testing.T) {\n570|\tproject := filepath.Join(t.TempDir(), \"project\")\n571|\tcopyCensusProject(t, censusModuleRoot(), project)\n572|\tapplyCensusMutationOverlay(t, project)\n573|\n574|\tmigrationPath := filepath.Join(project, \"internal\", \"config\", \"migration.go\")\n575|\tsource, err := os.ReadFile(migrationPath)\n576|\tif err != nil {\n577|\t\tt.Fatal(err)\n578|\t}\n579|\tconst holdGuard = \"\\tif err := requireHoldForConfig(hold, paths); err != nil {\\n\\t\\treturn err\\n\\t}\"\n580|\tconst plantedGuard = \"\\tif backup == \\\"reviewer-pre-hold\\\" { return filesystem.Rename(string(original), string(replacement)) }; if err := requireHoldForConfig(hold, paths); err != nil {\\n\\t\\treturn err\\n\\t}; if backup == \\\"reviewer-post-hold\\\" { return filesystem.Rename(string(original), string(replacement)) }\"\n581|\tif !strings.Contains(string(source), holdGuard) {\n582|\t\tt.Fatal(\"replaceDurably hold guard was not found in the census plant source\")\n583|\t}\n584|\tplanted := strings.Replace(string(source), holdGuard, plantedGuard, 1)\n585|\tif err := os.WriteFile(migrationPath, []byte(planted), 0o600); err != nil {\n586|\t\tt.Fatal(err)\n587|\t}\n588|\n589|\twitness := `package config\n590|\n591|import (\n592|\t\"os\"\n593|\t\"path/filepath\"\n594|\t\"testing\"\n595|\n596|\t\"github.com/relux-works/agent-session-manager/internal/hosttrust\"\n597|\t\"github.com/relux-works/agent-session-manager/internal/localstore\"\n598|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n599|)\n600|\n601|func TestReviewerUnlistedSiteExecutes(t *testing.T) {\n602|\tdirectory := t.TempDir()\n603|\tconfigPath := filepath.Join(directory, \"config.toml\")\n604|\tstatePath := filepath.Join(directory, \"state\")\n605|\tif err := os.WriteFile(configPath, []byte(\"configuration\"), 0o600); err != nil {\n606|\t\tt.Fatal(err)\n607|\t}\n608|\tpaths, err := localstore.ResolvePaths(localstore.ResolveRequest{\n609|\t\tPlatform: scalar.PlatformLinux,\n610|\t\tFlags: map[string]string{\n611|\t\t\t\"--config\": configPath, \"--data-dir\": filepath.Join(statePath, \"data\"),\n612|\t\t\t\"--state-dir\": statePath, \"--cache-dir\": filepath.Join(statePath, \"cache\"),\n613|\t\t\t\"--runtime-dir\": filepath.Join(statePath, \"runtime\"),\n614|\t\t},\n615|\t})\n616|\tif err != nil {\n617|\t\tt.Fatal(err)\n618|\t}\n619|\tstore, err := hosttrust.Open(paths)\n620|\tif err != nil {\n621|\t\tt.Fatal(err)\n622|\t}\n623|\tif err := store.EnsureConfigBinding(paths); err != nil {\n624|\t\tt.Fatal(err)\n625|\t}\n626|\tfor _, branch := range []string{\"reviewer-pre-hold\", \"reviewer-post-hold\"} {\n627|\t\toriginal := filepath.Join(directory, branch+\"-original\")\n628|\t\treplacement := filepath.Join(directory, branch+\"-replacement\")\n629|\t\tif err := os.WriteFile(original, []byte(\"old\"), 0o600); err != nil {\n630|\t\t\tt.Fatal(err)\n631|\t\t}\n632|\t\tif err := store.WithExclusiveHoldForConfig(paths, func(hold hosttrust.HeldExclusive) error {\n633|\t\t\treturn replaceDurably(hold, osMigrationFileSystem{}, paths, branch, []byte(original), []byte(replacement))\n634|\t\t}); err != nil {\n635|\t\t\tt.Fatalf(\"replaceDurably(%s) = %v\", branch, err)\n636|\t\t}\n637|\t\tcontents, err := os.ReadFile(replacement)\n638|\t\tif err != nil {\n639|\t\t\tt.Fatal(err)\n640|\t\t}\n641|\t\tif string(contents) != \"old\" {\n642|\t\t\tt.Fatalf(\"%s witness contents = %q, want old\", branch, contents)\n643|\t\t}\n644|\t}\n645|}\n646|`\n647|\twitnessPath := filepath.Join(project, \"internal\", \"config\", \"reviewer_callsite_regression_test.go\")\n648|\tif err := os.WriteFile(witnessPath, []byte(witness), 0o600); err != nil {\n649|\t\tt.Fatal(err)\n650|\t}\n651|\tchild := exec.Command(\"go\", \"test\", \"./internal/config\", \"-run\", \"^(TestWritePathCensusGate|TestReviewerUnlistedSiteExecutes)$\", \"-count=1\", \"-v\")\n652|\tchild.Dir = project\n653|\tchild.Env = append(os.Environ(), \"GOTOOLCHAIN=local\")\n654|\toutput, childErr := child.CombinedOutput()\n655|\tif childErr == nil {\n656|\t\tt.Fatalf(\"planted census child succeeded; gate admitted an unlisted site:\\n%s\", output)\n657|\t}\n658|\tif !strings.Contains(string(output), \"--- PASS: TestReviewerUnlistedSiteExecutes\") {\n659|\t\tt.Fatalf(\"planted child did not execute the real rename witness (err=%v):\\n%s\", childErr, output)\n660|\t}\n661|\tif !strings.Contains(string(output), \"write-path census violation\") {\n662|\t\tt.Fatalf(\"planted child failed without a census violation (err=%v):\\n%s\", childErr, output)\n663|\t}\n664|}\n665|\n666|// applyCensusMutationOverlay propagates the mutation harness's source overlay\n667|// into the isolated child module. Without this handoff the child would test\n668|// the on-disk baseline while the parent tests the mutant, making a behavioral\n669|// mutant appear killed for the wrong reason. Non-census overlays are ignored.\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
