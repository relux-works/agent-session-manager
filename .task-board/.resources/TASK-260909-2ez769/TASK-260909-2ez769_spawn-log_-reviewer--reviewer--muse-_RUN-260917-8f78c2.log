{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d691","stream":{"kind":"session","id":"01a0ada8-0185-76f0-8192-f6e1be48611d"},"sequence":2467,"recorded_at":1780531400004929,"record_type":"event","durability":"durable","causation_id":"e58530cc-c434-4c84-a6d6-35c15a8ccfca","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e58530cc-c434-4c84-a6d6-35c15a8ccfca","run_stream":{"kind":"run","id":"e58530cc-c434-4c84-a6d6-35c15a8ccfca"},"task_stream":{"kind":"task","id":"01a0adce-9fe6-76f3-8c10-67379890c511"},"task_id":"01a0adce-9fe6-76f3-8c10-67379890c511","event":{"kind":"output","task_id":"01a0adce-9fe6-76f3-8c10-67379890c511","chunk":"{\n  \"chunk_id\": \"exec-82-1\",\n  \"command\": \"grep -n \\\"func TestTrustRedaction\\\" -A 25 /Users/iv/rev12work/candidate/internal/hosttrust/trust_test.go | head -30; grep -n \\\"func TestApplyV4StaleSource\\\" /Users/iv/rev12work/candidate/internal/config/*_test.go | head -3\",\n  \"description\": \"Check redaction test and stale-source test\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"220:func TestTrustRedaction(t *testing.T) {\\n221-\\tissued := issueForTest(t, testHostA, testNow)\\n222-\\tstore := TrustStore{Generation: 1, Entries: []CredentialEntry{entryForTest(t, issued, EntryActive, testNow, nil)}}\\n223-\\tsnapshot := Snapshot{Generation: 1, Trust: store}\\n224-\\tmaterial := EnrollmentMaterial{HostID: testHostA, CredentialID: \\\"sha256:00\\\", LeafDER: issued.LeafDER, RootDER: issued.RootDER}\\n225-\\trequest := AuthRequest{LocalHostID: testHostA, LocalCredentialID: \\\"sha256:00\\\", RemoteLeafDER: issued.LeafDER, Allowlisted: []string{testHostB}, HelloHostID: testHostB}\\n226-\\tformatted := []string{\\n227-\\t\\tstore.String(), store.GoString(), sprintfForTest(snapshot), sprintfForTest(store.Entries[0]),\\n228-\\t\\tissued.String(), issued.GoString(), sprintfForTest(material), sprintfForTest(request), sprintfForTest(snapshot),\\n229-\\t}\\n230-\\tfor _, rendered := range formatted {\\n231-\\t\\tfor _, secret := range []string{testHostA, testHostB, \\\"sha256:\\\", \\\"PRIVATE\\\", \\\"CERTIFICATE\\\"} {\\n232-\\t\\t\\tif strings.Contains(rendered, secret) {\\n233-\\t\\t\\t\\tt.Fatalf(\\\"redacted rendering %q exposes %q\\\", rendered, secret)\\n234-\\t\\t\\t}\\n235-\\t\\t}\\n236-\\t}\\n237-\\trefusal := trustError(TrustError{Operation: \\\"decode document\\\", Err: ErrTrustDecode})\\n238-\\tif strings.Contains(refusal.Error(), testHostA) || !errors.Is(refusal, ErrTrustDecode) {\\n239-\\t\\tt.Fatalf(\\\"TrustError rendering leaks or breaks unwrapping: %q\\\", refusal.Error())\\n240-\\t}\\n241-}\\n242-\\n243-// joinEntriesForTest renders a trust document from entries without the\\n244-// EncodeTrust round trip, so mapping-ambiguous pairs reach DecodeTrust.\\n245-// Entries render in encoder order: an unsorted pair would refuse on ordering\\n/Users/iv/rev12work/candidate/internal/config/migration_v4_apply_test.go:133:func TestApplyV4StaleSource(t *testing.T) {\\n\",\n  \"original_output_bytes\": 1757,\n  \"original_output_tokens\": 440,\n  \"truncated\": false\n}","final_result":true}}}
