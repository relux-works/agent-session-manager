{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d6f7","stream":{"kind":"session","id":"01a0ada8-0185-76f0-8192-f6e1be48611d"},"sequence":2518,"recorded_at":1780531400005031,"record_type":"event","durability":"durable","causation_id":"e58530cc-c434-4c84-a6d6-35c15a8ccfca","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e58530cc-c434-4c84-a6d6-35c15a8ccfca","run_stream":{"kind":"run","id":"e58530cc-c434-4c84-a6d6-35c15a8ccfca"},"task_stream":{"kind":"task","id":"01a0adce-dd56-7fa1-af14-c939ec5bbc8a"},"task_id":"01a0adce-dd56-7fa1-af14-c939ec5bbc8a","event":{"kind":"output","task_id":"01a0adce-dd56-7fa1-af14-c939ec5bbc8a","chunk":"Read text file `/Users/iv/rev12work/candidate/internal/config/migration_v4_apply.go`.\n(189 line(s) above)\n190|func rollbackV4(inputs Inputs, overrides Overrides, options RollbackV4Options,\n191|\tfilesystem migrationFileSystem, openStore storeOpener) (V4ApplyResult, error) {\n192|\tif !options.AcknowledgeNoHostChannelAssurance {\n193|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"acknowledge rollback\", Err: ErrRollbackV4AckRequired})\n194|\t}\n195|\tsnapshot, err := Load(inputs, overrides)\n196|\tif err != nil {\n197|\t\treturn V4ApplyResult{}, err\n198|\t}\n199|\tloaded, decoded := snapshot.Configuration()\n200|\tif !snapshot.ConfigPresent() || !decoded {\n201|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"load source\", Err: ErrMigrationSourceAbsent})\n202|\t}\n203|\tlocalPaths := snapshot.LocalPaths()\n204|\tfilename, err := configPathFromLocalPaths(localPaths)\n205|\tif err != nil {\n206|\t\treturn V4ApplyResult{}, err\n207|\t}\n208|\tbackup := options.BackupPath\n209|\tif backup == \"\" {\n210|\t\tbackup = filename + \".bak.\" + CurrentVersion\n211|\t}\n212|\tbackupBytes, err := filesystem.ReadFile(backup)\n213|\tif err != nil {\n214|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"read backup\", Err: errors.Join(ErrRollbackV4Backup, err)})\n215|\t}\n216|\tcontext := DecodeContext{RuntimePlatform: inputs.Platform, BackendSettings: inputs.BackendSettings}\n217|\tbackupLoaded, err := Decode(backupBytes, context)\n218|\tif err != nil {\n219|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate backup\", Err: errors.Join(ErrRollbackV4Backup, err)})\n220|\t}\n221|\tif backupLoaded.SourceVersion == Version4 {\n222|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate backup\", Err: ErrRollbackV4Backup})\n223|\t}\n224|\tif bytes.Equal(snapshot.Document(), backupBytes) {\n225|\t\treturn V4ApplyResult{Migration: MigrationResult{SourceVersion: loaded.SourceVersion, TargetVersion: backupLoaded.SourceVersion, BackupPath: backup}}, nil\n226|\t}\n227|\tstore, err := openStore(localPaths)\n228|\tif err != nil {\n229|\t\treturn V4ApplyResult{}, err\n230|\t}\n231|\tif err := store.EnsureConfigBinding(localPaths); err != nil {\n232|\t\treturn V4ApplyResult{}, err\n233|\t}\n234|\tpreRollback := filename + \".pre-rollback.\" + loaded.SourceVersion\n235|\tmarker := hosttrust.PendingCommit{\n236|\t\tSchema:            \"urn:ax:schema:host-pending-commit\",\n237|\t\tSchemaVersion:     \"1.0.0\",\n238|\t\tOperation:         hosttrust.JointRollbackV4,\n239|\t\tConfigPath:        filename,\n240|\t\tSourceSHA256:      hosttrust.SHA256HexOf(snapshot.Document()),\n241|\t\tReplacementSHA256: hosttrust.SHA256HexOf(backupBytes),\n242|\t\tBackupPath:        preRollback,\n243|\t}\n244|\t// The source generation pins inside the transaction: reread the trust\n245|\t// there so a concurrent commit cannot slip between this read and the\n246|\t// replacement.\n247|\tcurrent, err := store.ReadSnapshot()\n248|\tif err != nil {\n249|\t\treturn V4ApplyResult{}, err\n250|\t}\n251|\tmarker.SourceGeneration = current.Generation\n252|\tgeneration, err := store.JointCommit(localPaths, marker,\n253|\t\tfunc(current hosttrust.TrustStore) error {\n254|\t\t\treturn revalidateRollbackV4(inputs, overrides, snapshot.Document(), backupBytes, backupLoaded.SourceVersion, marker.SourceGeneration, current)\n255|\t\t},\n256|\t\tfunc(hold hosttrust.HeldExclusive) error {\n257|\t\t\treturn replaceDurably(hold, filesystem, localPaths, preRollback, snapshot.Document(), backupBytes)\n258|\t\t},\n259|\t\tfunc(hold hosttrust.HeldExclusive) error {\n260|\t\t\t_, err := writeTempReplace(hold, filesystem, localPaths, snapshot.Document())\n261|\t\t\treturn err\n262|\t\t})\n263|\tif err != nil {\n264|\t\tif errors.Is(err, errRollbackConverged) {\n265|\t\t\treturn V4ApplyResult{Migration: MigrationResult{SourceVersion: loaded.SourceVersion, TargetVersion: backupLoaded.SourceVersion, BackupPath: backup}}, nil\n266|\t\t}\n267|\t\tif errors.Is(err, hosttrust.ErrJointCompensationFailed) {\n268|\t\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"compensate joint commit\", Err: errors.Join(ErrMigrationSync, ErrMigrationRecovery, err)})\n269|\t\t}\n270|\t\treturn V4ApplyResult{}, err\n271|\t}\n272|\treturn V4ApplyResult{\n273|\t\tMigration:  MigrationResult{SourceVersion: loaded.SourceVersion, TargetVersion: backupLoaded.SourceVersion, BackupPath: preRollback, Changed: true},\n274|\t\tGeneration: generation,\n275|\t}, nil\n276|}\n277|\n278|// revalidateRollbackV4 repeats the rollback pins inside the joint\n279|// transaction: the current document is still the pinned source, still\n280|// differs from the backup, the backup still decodes below v4, and the trust\n281|// generation has not moved. A converged target (current equals backup) is\n282|// the no-op success, not a commit: it returns errRollbackConverged before\n283|// any marker is staged.\n284|func revalidateRollbackV4(inputs Inputs, overrides Overrides, sourceDocument, backupBytes []byte, backupVersion string, expectedGeneration uint64, current hosttrust.TrustStore) error {\n285|\tsnapshot, err := Load(inputs, overrides)\n286|\tif err != nil {\n287|\t\treturn err\n288|\t}\n289|\tloaded, decoded := snapshot.Configuration()\n290|\tif !snapshot.ConfigPresent() || !decoded {\n291|\t\treturn migrationError(MigrationError{Operation: \"load source\", Err: ErrMigrationSourceAbsent})\n292|\t}\n293|\t_ = loaded\n294|\tif bytes.Equal(snapshot.Document(), backupBytes) {\n(more lines below)","final_result":true}}}
