{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d695","stream":{"kind":"session","id":"01a0ada8-0185-76f0-8192-f6e1be48611d"},"sequence":2469,"recorded_at":1780531400004933,"record_type":"event","durability":"durable","causation_id":"e58530cc-c434-4c84-a6d6-35c15a8ccfca","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e58530cc-c434-4c84-a6d6-35c15a8ccfca","run_stream":{"kind":"run","id":"e58530cc-c434-4c84-a6d6-35c15a8ccfca"},"call_id":"call_01a0adce9b60768482315792c565ecb8","text":"Read text file `/Users/iv/rev12work/candidate/internal/config/migration_v4_apply.go`.\n(37 line(s) above)\n38|func applyV4(inputs Inputs, overrides Overrides, preview V4Preview, confirm bool, now time.Time,\n39|\tfilesystem migrationFileSystem, openStore storeOpener) (V4ApplyResult, error) {\n40|\tif !confirm {\n41|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"confirm preview\", Err: ErrMigrationV4ConfirmRequired})\n42|\t}\n43|\tif preview.SourceVersion != CurrentVersion || len(preview.SourceDocument) == 0 || len(preview.Replacement) == 0 {\n44|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate preview\", Err: ErrMigrationV4PreviewMismatch})\n45|\t}\n46|\t// Unlocked fast-fail checks first; the same pins are revalidated inside\n47|\t// the joint transaction below, closing the concurrent-change window\n48|\t// between this read and the commit.\n49|\tsnapshot, err := Load(inputs, overrides)\n50|\tif err != nil {\n51|\t\treturn V4ApplyResult{}, err\n52|\t}\n53|\tloaded, decoded := snapshot.Configuration()\n54|\tif !snapshot.ConfigPresent() || !decoded {\n55|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"load source\", Err: ErrMigrationSourceAbsent})\n56|\t}\n57|\tif loaded.SourceVersion != CurrentVersion {\n58|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"select source\", Err: ErrMigrationV4Source})\n59|\t}\n60|\tif !bytes.Equal(snapshot.Document(), preview.SourceDocument) {\n61|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate preview source\", Err: ErrMigrationV4StaleSource})\n62|\t}\n63|\tlocalPaths := snapshot.LocalPaths()\n64|\tfilename, err := configPathFromLocalPaths(localPaths)\n65|\tif err != nil {\n66|\t\treturn V4ApplyResult{}, err\n67|\t}\n68|\tstore, err := openStore(localPaths)\n69|\tif err != nil {\n70|\t\treturn V4ApplyResult{}, err\n71|\t}\n72|\tif err := store.EnsureConfigBinding(localPaths); err != nil {\n73|\t\treturn V4ApplyResult{}, err\n74|\t}\n75|\tcurrent, err := store.ReadSnapshot()\n76|\tif err != nil {\n77|\t\treturn V4ApplyResult{}, err\n78|\t}\n79|\tif current.Generation != preview.SourceGeneration {\n80|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate preview generation\", Err: ErrMigrationV4StaleGeneration})\n81|\t}\n82|\trendered, err := renderV4Preview(snapshot.Document(), loaded.Value, current, preview.CredentialID, preview.DroppedPeers, now, inputs)\n83|\tif err != nil {\n84|\t\treturn V4ApplyResult{}, err\n85|\t}\n86|\tif !bytes.Equal(rendered.Replacement, preview.Replacement) {\n87|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate preview bytes\", Err: ErrMigrationV4PreviewMismatch})\n88|\t}\n89|\t// The custody files behind the selected credential must validate before\n90|\t// use, exactly as Section 11.10.2 requires for local identity.\n91|\tcredentialHex := previewCredentialHex(preview.CredentialID)\n92|\tif err := store.ValidateCustody(credentialHex, loaded.Value.HostID, now); err != nil {\n93|\t\treturn V4ApplyResult{}, err\n94|\t}\n95|\tbackup := filename + \".bak.\" + loaded.SourceVersion\n96|\t// filename is the selected snapshot path, a scalar.AbsolutePath by\n97|\t// loader construction; JointCommit still revalidates the absolute\n98|\t// marker path before staging anything.\n99|\tmarker := hosttrust.PendingCommit{\n100|\t\tSchema:            \"urn:ax:schema:host-pending-commit\",\n101|\t\tSchemaVersion:     \"1.0.0\",\n102|\t\tOperation:         hosttrust.JointApplyV4,\n103|\t\tConfigPath:        filename,\n104|\t\tSourceSHA256:      hosttrust.SHA256HexOf(preview.SourceDocument),\n105|\t\tReplacementSHA256: hosttrust.SHA256HexOf(preview.Replacement),\n106|\t\tSourceGeneration:  preview.SourceGeneration,\n107|\t\tBackupPath:        backup,\n108|\t}\n109|\tgeneration, err := store.JointCommit(localPaths, marker,\n110|\t\tfunc(current hosttrust.TrustStore) error {\n111|\t\t\treturn revalidateApplyV4(inputs, overrides, store, preview, current, now)\n112|\t\t},\n113|\t\tfunc(hold hosttrust.HeldExclusive) error {\n114|\t\t\treturn replaceDurably(hold, filesystem, localPaths, backup, preview.SourceDocument, preview.Replacement)\n115|\t\t},\n116|\t\tfunc(hold hosttrust.HeldExclusive) error {\n117|\t\t\t_, err := writeTempReplace(hold, filesystem, localPaths, preview.SourceDocument)\n118|\t\t\treturn err\n119|\t\t})\n120|\tif err != nil {\n121|\t\tif errors.Is(err, hosttrust.ErrJointCompensationFailed) {\n122|\t\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"compensate joint commit\", Err: errors.Join(ErrMigrationSync, ErrMigrationRecovery, err)})\n123|\t\t}\n124|\t\treturn V4ApplyResult{}, err\n125|\t}\n126|\treturn V4ApplyResult{\n127|\t\tMigration:  MigrationResult{SourceVersion: loaded.SourceVersion, TargetVersion: Version4, BackupPath: backup, Changed: true},\n128|\t\tGeneration: generation,\n129|\t}, nil\n130|}\n131|\n132|// revalidateApplyV4 repeats the confirmed pins inside the joint transaction:\n133|// current source bytes, source version, preview rendering, generation and\n134|// credential custody. It runs under the exclusive authorization lock, so a\n135|// concurrent trust or config commit cannot slip between validation and the\n136|// replacement.\n137|func revalidateApplyV4(inputs Inputs, overrides Overrides, store *hosttrust.Store, preview V4Preview, current hosttrust.TrustStore, now time.Time) error {\n138|\tsnapshot, err := Load(inputs, overrides)\n139|\tif err != nil {\n140|\t\treturn err\n141|\t}\n142|\tloaded, decoded := snapshot.Configuration()\n143|\tif !snapshot.ConfigPresent() || !decoded {\n144|\t\treturn migrationError(MigrationError{Operation: \"load source\", Err: ErrMigrationSourceAbsent})\n145|\t}\n146|\tif loaded.SourceVersion != CurrentVersion {\n147|\t\treturn migrationError(MigrationError{Operation: \"select source\", Err: ErrMigrationV4Source})\n148|\t}\n149|\tif !bytes.Equal(snapshot.Document(), preview.SourceDocument) {\n150|\t\treturn migrationError(MigrationError{Operation: \"validate preview source\", Err: ErrMigrationV4StaleSource})\n151|\t}\n152|\tif current.Generation != preview.SourceGeneration {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
