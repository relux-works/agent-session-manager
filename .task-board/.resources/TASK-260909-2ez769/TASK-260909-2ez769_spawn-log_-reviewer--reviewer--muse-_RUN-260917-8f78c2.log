{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ce53","stream":{"kind":"session","id":"01a0ada8-0185-76f0-8192-f6e1be48611d"},"sequence":1412,"recorded_at":1780531400002819,"record_type":"event","durability":"durable","causation_id":"e58530cc-c434-4c84-a6d6-35c15a8ccfca","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e58530cc-c434-4c84-a6d6-35c15a8ccfca","run_stream":{"kind":"run","id":"e58530cc-c434-4c84-a6d6-35c15a8ccfca"},"task_stream":{"kind":"task","id":"01a0adb4-4840-75a1-b1bb-eae70ce10344"},"task_id":"01a0adb4-4840-75a1-b1bb-eae70ce10344","event":{"kind":"output","task_id":"01a0adb4-4840-75a1-b1bb-eae70ce10344","chunk":"Read text file `/tmp/rev12/candidate/internal/hosttrust/hold.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"path/filepath\"\n6|\t\"sync/atomic\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/localstore\"\n9|)\n10|\n11|// HeldExclusive is the unforgeable capability proving the holder acquired\n12|// the exclusive authorization lock and that the hold is still live. Only\n13|// the lock acquisition path (exclusiveHold) constructs a genuine value;\n14|// every other package sees an opaque struct it can pass along but never\n15|// forge: the zero value and any use-after-release refuse wherever a hold\n16|// is required.\n17|//\n18|// A hold proves serialization, not protocol: helpers that mutate the\n19|// config-plus-trust pair require a live hold (fail closed without one),\n20|// while the write-path census gate statically restricts which call sites\n21|// may perform pair mutations at all.\n22|type HeldExclusive struct {\n23|\thold              *exclusiveHold\n24|\tconfigPath        string\n25|\tstateRoot         string\n26|\tconfigAssociation bool\n27|}\n28|\n29|// exclusiveHold is the liveness cell behind one HeldExclusive. The unlock\n30|// wrapper marks it released, so a token stashed past its hold refuses\n31|// instead of authorizing a write outside the exclusion window.\n32|type exclusiveHold struct {\n33|\treleased atomic.Bool\n34|\troot     string\n35|}\n36|\n37|// Valid reports a genuine live hold: constructed by the lock acquisition\n38|// path and not yet released.\n39|func (held HeldExclusive) Valid() bool {\n40|\treturn held.hold != nil && !held.hold.released.Load()\n41|}\n42|\n43|// IsZero reports the zero value, which never authorizes a write. It lets\n44|// narrowing tests distinguish a forged/absent token from a released one.\n45|func (held HeldExclusive) IsZero() bool {\n46|\treturn held.hold == nil\n47|}\n48|\n49|// requireHold refuses a pair mutation attempted without a live exclusive\n50|// hold. It is the single enforcement point behind every token-gated\n51|// helper; weakening it admits exactly the ungated writes the narrowing\n52|// plants cover.\n53|func requireHold(hold HeldExclusive) error {\n54|\tif !hold.Valid() {\n55|\t\treturn trustError(TrustError{Operation: \"require exclusive hold\", Err: ErrExclusiveHoldRequired})\n56|\t}\n57|\treturn nil\n58|}\n59|\n60|// requireHoldForRoot proves both liveness and the exact machine-local trust\n61|// resource that the helper is about to mutate. A live capability from a\n62|// different Store is not interchangeable, even when both stores happen to\n63|// be held by the same goroutine.\n64|func requireHoldForRoot(hold HeldExclusive, root string) error {\n65|\tif err := requireHold(hold); err != nil {\n66|\t\treturn err\n67|\t}\n68|\tcanonical, err := absoluteClean(root)\n69|\tif err != nil || hold.hold.root != canonical {\n70|\t\treturn trustError(TrustError{Operation: \"require exclusive hold resource\", Err: ErrExclusiveHoldResourceMismatch})\n71|\t}\n72|\treturn nil\n73|}\n74|\n75|// ValidateConfigPaths proves that a live capability was bound by this store's\n76|// durable immutable configuration association to the exact path it is about\n77|// to replace. Generic stores intentionally mint no configuration binding, so\n78|// a token from an unrelated store cannot authorize a pair write by accident.\n79|func (held HeldExclusive) ValidateConfigPaths(paths localstore.ResolvedPaths) error {\n80|\tif err := requireHold(held); err != nil {\n81|\t\treturn err\n82|\t}\n83|\tcanonical, err := canonicalResolvedConfigPath(paths)\n84|\tstateRoot, stateErr := resolvedStateRoot(paths)\n85|\tif err != nil || stateErr != nil || !held.configAssociation || held.configPath == \"\" || held.stateRoot == \"\" || held.configPath != canonical || held.stateRoot != stateRoot {\n86|\t\treturn trustError(TrustError{Operation: \"require configuration hold resource\", Err: ErrExclusiveHoldResourceMismatch})\n87|\t}\n88|\treturn nil\n89|}\n90|\n91|func absoluteClean(path string) (string, error) {\n92|\tif path == \"\" || !filepath.IsAbs(path) {\n93|\t\treturn \"\", ErrInvalidStoreContext\n94|\t}\n95|\treturn filepath.Clean(path), nil\n96|}\n97|\n98|// canonicalExistingPath returns the identity used by the pair writer. The\n99|// identity follows symlinks before comparing paths, and a missing/unreadable\n100|// target is a refusal rather than an invitation to mint a new binding.\n101|func canonicalExistingPath(path string) (string, error) {\n102|\tif path == \"\" || !filepath.IsAbs(path) {\n103|\t\treturn \"\", ErrInvalidStoreContext\n104|\t}\n105|\tabs, err := filepath.Abs(filepath.Clean(path))\n106|\tif err != nil {\n107|\t\treturn \"\", err\n108|\t}\n109|\tresolved, err := filepath.EvalSymlinks(abs)\n110|\tif err != nil {\n111|\t\treturn \"\", err\n112|\t}\n113|\treturn filepath.Clean(resolved), nil\n114|}\n115|\n116|// exclusiveHold acquires the exclusive authorization lock and returns the\n117|// capability proving the hold plus its release function. The release marks\n118|// the capability expired before unlocking, so no write can slip outside\n119|// the exclusion window it was authorized under.\n120|func (lock *fileLock) exclusiveHold() (HeldExclusive, func(), error) {\n(more lines below)","final_result":true}}}
