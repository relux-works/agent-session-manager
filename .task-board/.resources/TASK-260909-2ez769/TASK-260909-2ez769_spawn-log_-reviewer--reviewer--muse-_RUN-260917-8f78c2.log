VATE\\\", \\\"CERTIFICATE\\\"} {\\n232-\\t\\t\\tif strings.Contains(rendered, secret) {\\n233-\\t\\t\\t\\tt.Fatalf(\\\"redacted rendering %q exposes %q\\\", rendered, secret)\\n234-\\t\\t\\t}\\n235-\\t\\t}\\n236-\\t}\\n237-\\trefusal := trustError(TrustError{Operation: \\\"decode document\\\", Err: ErrTrustDecode})\\n238-\\tif strings.Contains(refusal.Error(), testHostA) || !errors.Is(refusal, ErrTrustDecode) {\\n239-\\t\\tt.Fatalf(\\\"TrustError rendering leaks or breaks unwrapping: %q\\\", refusal.Error())\\n240-\\t}\\n241-}\\n242-\\n243-// joinEntriesForTest renders a trust document from entries without the\\n244-// EncodeTrust round trip, so mapping-ambiguous pairs reach DecodeTrust.\\n245-// Entries render in encoder order: an unsorted pair would refuse on ordering\\n/Users/iv/rev12work/candidate/internal/config/migration_v4_apply_test.go:133:func TestApplyV4StaleSource(t *testing.T) {\\n\",\n  \"original_output_bytes\": 1757,\n  \"original_output_tokens\": 440,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
