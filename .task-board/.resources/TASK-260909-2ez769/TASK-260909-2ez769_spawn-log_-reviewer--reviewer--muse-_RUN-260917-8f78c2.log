{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d413","stream":{"kind":"session","id":"01a0ada8-0185-76f0-8192-f6e1be48611d"},"sequence":2148,"recorded_at":1780531400004291,"record_type":"event","durability":"durable","causation_id":"e58530cc-c434-4c84-a6d6-35c15a8ccfca","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e58530cc-c434-4c84-a6d6-35c15a8ccfca","run_stream":{"kind":"run","id":"e58530cc-c434-4c84-a6d6-35c15a8ccfca"},"task_stream":{"kind":"task","id":"01a0adc2-73c0-7692-ab6b-dd062f8c0d33"},"task_id":"01a0adc2-73c0-7692-ab6b-dd062f8c0d33","event":{"kind":"output","task_id":"01a0adc2-73c0-7692-ab6b-dd062f8c0d33","chunk":"Read text file `/Users/iv/rev12work/candidate/internal/hosttrust/binding.go`.\n(204 line(s) above)\n205|\treturn nil\n206|}\n207|\n208|// ensureConfigBindingLocked converges an immutable binding while the caller\n209|// holds the store's exclusive authorization lock. The config-side record and\n210|// its bootstrap lock are the authority: a second Store cannot claim the\n211|// same target by supplying a different stateDir. The store-side index is\n212|// written only as a derived cache after the authoritative record is present.\n213|func (store *Store) ensureConfigBindingLocked(hold HeldExclusive, paths localstore.ResolvedPaths) (HeldExclusive, error) {\n214|\tif err := requireHoldForRoot(hold, store.root); err != nil {\n215|\t\treturn HeldExclusive{}, err\n216|\t}\n217|\tif _, _, err := store.validateResolvedPair(paths); err != nil {\n218|\t\treturn HeldExclusive{}, err\n219|\t}\n220|\tcanonical, err := canonicalResolvedConfigPath(paths)\n221|\tif err != nil {\n222|\t\treturn HeldExclusive{}, err\n223|\t}\n224|\tif err := validateBindingPath(canonical); err != nil {\n225|\t\treturn HeldExclusive{}, err\n226|\t}\n227|\tstateRoot, err := resolvedStateRoot(paths)\n228|\tif err != nil {\n229|\t\treturn HeldExclusive{}, err\n230|\t}\n231|\tbootstrapLock, err := openLock(store.fs, configBindingLockPath(canonical))\n232|\tif err != nil {\n233|\t\treturn HeldExclusive{}, trustError(TrustError{Operation: \"open configuration binding lock\", Err: err})\n234|\t}\n235|\tunlockBootstrap, err := bootstrapLock.exclusive()\n236|\tif err != nil {\n237|\t\treturn HeldExclusive{}, trustError(TrustError{Operation: \"lock configuration binding\", Err: errors.Join(ErrTrustDurability, err)})\n238|\t}\n239|\tdefer unlockBootstrap()\n240|\n241|\t// Inspect the store-side association before publishing anything at the\n242|\t// target. A Store can have been opened while unbound, then another handle\n243|\t// can bind the shared root before this request reaches the bootstrap lock.\n244|\t// The existing store association is authoritative for that root; discovering\n245|\t// a mismatch must therefore be side-effect free.\n246|\tstoreBinding, storePresent, err := loadStoreConfigBinding(store.fs, store.root)\n247|\tif err != nil {\n248|\t\treturn HeldExclusive{}, err\n249|\t}\n250|\tif storePresent {\n251|\t\tif err := validateBindingForStore(storeBinding, canonical, store.root); err != nil {\n252|\t\t\treturn HeldExclusive{}, err\n253|\t\t}\n254|\t}\n255|\n256|\tbinding, present, err := loadTargetConfigBinding(store.fs, canonical)\n257|\tif err != nil {\n258|\t\treturn HeldExclusive{}, err\n259|\t}\n260|\tif present {\n261|\t\tif err := validateBindingForStore(binding, canonical, store.root); err != nil {\n262|\t\t\treturn HeldExclusive{}, err\n263|\t\t}\n264|\t\tif storePresent && (binding.ConfigPath != storeBinding.ConfigPath || binding.StateRoot != storeBinding.StateRoot) {\n265|\t\t\treturn HeldExclusive{}, trustError(TrustError{Operation: \"validate configuration binding\", Err: ErrExclusiveHoldResourceMismatch})\n266|\t\t}\n267|\t} else if storePresent {\n268|\t\t// An existing derived index without its authoritative target record is\n269|\t\t// incoherent. Refuse closed; do not recreate the target from the cache.\n270|\t\treturn HeldExclusive{}, trustError(TrustError{Operation: \"validate configuration binding\", Err: ErrExclusiveHoldResourceMismatch})\n271|\t} else {\n272|\t\tdocument, err := encodeConfigBinding(canonical, stateRoot)\n273|\t\tif err != nil {\n274|\t\t\treturn HeldExclusive{}, err\n275|\t\t}\n276|\t\tif err := store.commitConfigBinding(hold, paths, document); err != nil {\n277|\t\t\treturn HeldExclusive{}, err\n278|\t\t}\n279|\t\tbinding = ConfigBinding{Schema: configBindingSchema, SchemaVersion: configBindingVersion, ConfigPath: canonical, StateRoot: stateRoot}\n280|\t}\n281|\n282|\t// Persist the derived state-side index only after the config-side\n283|\t// association is durable. A crash between the two leaves a safe partial\n284|\t// state: readers cannot use the target without repairing it explicitly.\n285|\tif !storePresent {\n286|\t\tdocument, err := json.Marshal(binding)\n287|\t\tif err != nil {\n288|\t\t\treturn HeldExclusive{}, trustError(TrustError{Operation: \"encode configuration binding\", Err: errors.Join(ErrTrustDurability, err)})\n289|\t\t}\n290|\t\tif err := commitDocument(hold, store.fs, store.root, bindingPath(store.root), document); err != nil {\n291|\t\t\treturn HeldExclusive{}, err\n292|\t\t}\n293|\t}\n294|\tstore.configPath = canonical\n295|\treturn HeldExclusive{hold: hold.hold, configPath: canonical, stateRoot: stateRoot, configAssociation: true}, nil\n296|}\n297|\n298|// commitConfigBinding publishes the authoritative target-side association\n299|// with the same staged-write, fsync, atomic-rename and directory-fsync\n300|// discipline as trust.json. The store hold proves the owning trust resource;\n301|// the per-target bootstrap lock serializes first association across stores.\n302|func (store *Store) commitConfigBinding(hold HeldExclusive, paths localstore.ResolvedPaths, document []byte) error {\n303|\tif err := requireHoldForRoot(hold, store.root); err != nil {\n304|\t\treturn err\n305|\t}\n306|\tif _, _, err := store.validateResolvedPair(paths); err != nil {\n307|\t\treturn err\n308|\t}\n309|\tconfigPath, err := canonicalResolvedConfigPath(paths)\n310|\tif err != nil {\n311|\t\treturn err\n312|\t}\n313|\tdirectory := filepath.Dir(configPath)\n314|\t// The selected configuration directory is operator-owned input and may\n315|\t// legitimately be shared with other configuration files. The binding\n316|\t// record and its bootstrap lock are the owner-only control files; do not\n317|\t// silently impose Host Trust Store's 0700 directory custody on that\n318|\t// unrelated directory.\n319|\tstaged, err := store.fs.CreateTemp(directory, configBindingStagePrefix+\"*\", 0o600)\n320|\tif err != nil {\n321|\t\treturn trustError(TrustError{Operation: \"stage configuration binding\", Err: errors.Join(ErrTrustDurability, err)})\n322|\t}\n323|\tname := staged.Name()\n324|\tfailed := true\n325|\tdefer cleanupStagedFile(store.fs, name, &failed)\n326|\tif err := writeAll(staged, document); err != nil {\n327|\t\treturn trustError(TrustError{Operation: \"stage configuration binding\", Err: errors.Join(ErrTrustDurability, err)})\n328|\t}\n329|\tif err := staged.Sync(); err != nil {\n330|\t\t_ = staged.Close()\n331|\t\treturn trustError(TrustError{Operation: \"sync configuration binding\", Err: errors.Join(ErrTrustDurability, err)})\n332|\t}\n333|\tif err := staged.Close(); err != nil {\n334|\t\treturn trustError(TrustError{Operation: \"sync configuration binding\", Err: errors.Join(ErrTrustDurability, err)})\n335|\t}\n336|\tif err := store.fs.Chmod(name, 0o600); err != nil {\n337|\t\treturn trustError(TrustError{Operation: \"stage configuration binding\", Err: errors.Join(ErrTrustDurability, err)})\n338|\t}\n339|\tif err := secureStaged(name, false); err != nil {\n340|\t\treturn err\n341|\t}\n342|\tif err := store.fs.Rename(name, configBindingPath(configPath)); err != nil {\n343|\t\treturn trustError(TrustError{Operation: \"replace configuration binding\", Err: errors.Join(ErrTrustDurability, err)})\n344|\t}\n345|\tif err := syncDir(store.fs, directory); err != nil {\n346|\t\treturn trustError(TrustError{Operation: \"sync configuration binding directory\", Err: errors.Join(ErrTrustDurability, err)})\n347|\t}\n348|\tfailed = false\n349|\treturn nil\n(more lines below)","final_result":true}}}
