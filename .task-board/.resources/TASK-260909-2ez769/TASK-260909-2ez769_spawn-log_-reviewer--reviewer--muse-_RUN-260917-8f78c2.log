ry the directory sync even when an exact backup already exists: it may\n433|\t// be the visible result of an interrupted run whose directory fsync failed.\n434|\tif err := syncDirectory(filesystem, directory); err != nil {\n435|\t\treturn migrationError(MigrationError{Operation: \"sync backup directory\", Err: errors.Join(ErrMigrationSync, err)})\n436|\t}\n437|\n438|\treplacementTemp, err := writeTempFile(filesystem, directory, \".ax-config-migrate-*\", replacement, info.Mode().Perm())\n439|\tif err != nil {\n440|\t\treturn migrationError(MigrationError{Operation: \"write replacement\", Err: errors.Join(ErrMigrationWrite, err)})\n441|\t}\n442|\tif err := filesystem.Rename(replacementTemp, filename); err != nil {\n443|\t\t_ = filesystem.Remove(replacementTemp)\n444|\t\treturn migrationError(MigrationError{Operation: \"replace source\", Err: errors.Join(ErrMigrationReplace, err)})\n445|\t}\n446|\tif err := syncDirectory(filesystem, directory); err == nil {\n447|\t\treturn nil\n448|\t} else {\n449|\t\tsyncErr := err\n450|\t\trollbackTemp, rollbackErr := writeTempFile(filesystem, directory, \".ax-config-rollback-*\", original, info.Mode().Perm())\n451|\t\tif rollbackErr == nil {\n452|\t\t\trollbackErr = filesystem.Rename(rollbackTemp, filename)\n453|\t\t}\n454|\t\tif rollbackErr == nil {\n455|\t\t\trollbackErr = syncDirectory(filesystem, directory)\n456|\t\t}\n457|\t\tif rollbackErr != nil {\n458|\t\t\tif rollbackTemp != \"\" {\n459|\t\t\t\t_ = filesystem.Remove(rollbackTemp)\n460|\t\t\t}\n461|\t\t\treturn migrationError(MigrationError{Operation: \"recover source after sync\", Err: errors.Join(ErrMigrationSync, ErrMigrationRecovery, syncErr, rollbackErr)})\n462|\t\t}\n463|\t\treturn migrationError(MigrationError{Operation: \"sync replacement directory\", Err: errors.Join(ErrMigrationSync, syncErr)})\n464|\t}\n465|}\n466|\n467|func writeTempFile(filesystem migrationFileSystem, directory, pattern string, document []byte, mode fs.FileMode) (name string, err error) {\n468|\tfile, err := filesystem.CreateTemp(directory, pattern)\n469|\tif err != nil {\n470|\t\treturn \"\", err\n471|\t}\n472|\tname = file.Name()\n473|\tclean := func(cause error) (string, error) {\n474|\t\t_ = file.Close()\n475|\t\t_ = filesystem.Remove(name)\n476|\t\treturn \"\", cause\n(more lines below)","final_result":true}}}
