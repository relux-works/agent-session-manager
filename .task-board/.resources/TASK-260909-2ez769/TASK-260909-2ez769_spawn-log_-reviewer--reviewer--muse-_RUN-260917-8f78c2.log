trustError(TrustError{Operation: \"decode entries\", Err: ErrTrustValidation})\n138|\t\t}\n139|\t\troots[entry.RootID.String()] = struct{}{}\n140|\t}\n141|\treturn nil\n142|}","final_result":true}}}
