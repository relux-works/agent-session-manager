{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca05","stream":{"kind":"session","id":"01a0aa3d-f870-72c3-b067-9f985ccf069d"},"sequence":861,"recorded_at":1780531400001717,"record_type":"event","durability":"durable","causation_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","run_stream":{"kind":"run","id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01"},"call_id":"call_01a0aa400d0076b8a5f8e162b1f3400d","text":"Read text file `internal/hosttrust/authorize_test.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"crypto/x509\"\n5|\t\"errors\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\t\"time\"\n11|)\n12|\n13|func twoHostFixture(t *testing.T) (local, peer *Store, localCredential, peerCredential string, localSnap, peerSnap Snapshot) {\n14|\tt.Helper()\n15|\tlocal = setupStoreForTest(t)\n16|\tpeer = setupStoreForTest(t)\n17|\tvar err error\n18|\tlocalCredential, err = local.Issue(testHostA, testNow)\n19|\tif err != nil {\n20|\t\tt.Fatal(err)\n21|\t}\n22|\tpeerCredential = enrollPeerForTest(t, local, peer, testHostB, testNow)\n23|\tenrollPeerForTest(t, peer, local, testHostA, testNow)\n24|\tlocalSnap, err = local.ReadSnapshot()\n25|\tif err != nil {\n26|\t\tt.Fatal(err)\n27|\t}\n28|\tpeerSnap, err = peer.ReadSnapshot()\n29|\tif err != nil {\n30|\t\tt.Fatal(err)\n31|\t}\n32|\treturn local, peer, localCredential, peerCredential, localSnap, peerSnap\n33|}\n34|\n35|func peerMaterialForTest(t *testing.T, peer *Store, credential string) (leafDER, rootDER []byte) {\n36|\tt.Helper()\n37|\tsnapshot, err := peer.ReadSnapshot()\n38|\tif err != nil {\n39|\t\tt.Fatal(err)\n40|\t}\n41|\tmaterial, err := ExportEnrollment(snapshot, credential)\n42|\tif err != nil {\n43|\t\tt.Fatal(err)\n44|\t}\n45|\treturn material.LeafDER, material.RootDER\n46|}\n47|\n48|func dispatchRequest(localSnap Snapshot, localCredential, peerCredential, hello string, leafDER, rootDER []byte, allowlist []string, now time.Time) AuthRequest {\n49|\treturn AuthRequest{\n50|\t\tSnapshotGeneration:   localSnap.Generation,\n51|\t\tLocalHostID:          testHostA,\n52|\t\tLocalCredentialID:    localCredential,\n53|\t\tRemoteLeafDER:        leafDER,\n54|\t\tRemoteRootDER:        rootDER,\n55|\t\tExpectedRemoteHostID: testHostB,\n56|\t\tAllowlisted:          allowlist,\n57|\t\tHelloHostID:          hello,\n58|\t\tNow:                  now,\n59|\t}\n60|}\n61|\n62|func TestAuthorizeDispatchHappyPath(t *testing.T) {\n63|\tlocal, peer, localCredential, peerCredential, localSnap, _ := twoHostFixture(t)\n64|\tleafDER, rootDER := peerMaterialForTest(t, peer, peerCredential)\n65|\trequest := dispatchRequest(localSnap, localCredential, peerCredential, testHostB, leafDER, rootDER, []string{testHostA, testHostB}, testNow)\n66|\tif err := local.AuthorizeDispatch(localSnap, request); err != nil {\n67|\t\tt.Fatalf(\"AuthorizeDispatch error = %v\", err)\n68|\t}\n69|}\n70|\n71|func TestAuthorizeDispatchRefusals(t *testing.T) {\n72|\tlocal, peer, localCredential, peerCredential, localSnap, _ := twoHostFixture(t)\n73|\tleafDER, rootDER := peerMaterialForTest(t, peer, peerCredential)\n74|\tother := issueForTest(t, testHostC, testNow)\n75|\tstranger := setupStoreForTest(t)\n76|\tstrangerCredential, err := stranger.Issue(testHostC, testNow)\n77|\tif err != nil {\n78|\t\tt.Fatal(err)\n79|\t}\n80|\tstrangerSnap, err := stranger.ReadSnapshot()\n81|\tif err != nil {\n82|\t\tt.Fatal(err)\n83|\t}\n84|\tstrangerMaterial, err := ExportEnrollment(strangerSnap, strangerCredential)\n85|\tif err != nil {\n86|\t\tt.Fatal(err)\n87|\t}\n88|\tallowlist := []string{testHostA, testHostB}\n89|\tstaleSnap := Snapshot{Generation: localSnap.Generation - 1, Trust: localSnap.Trust}\n90|\tfutureSnap := Snapshot{Generation: localSnap.Generation + 1, Trust: localSnap.Trust}\n91|\tmismatched := dispatchRequest(localSnap, localCredential, peerCredential, testHostB, leafDER, rootDER, allowlist, testNow)\n92|\tmismatched.SnapshotGeneration = localSnap.Generation - 1\n93|\ttests := []struct {\n94|\t\tname     string\n95|\t\tsnapshot Snapshot\n96|\t\trequest  AuthRequest\n97|\t\twant     error\n98|\t}{\n99|\t\t{\"stale generation\", staleSnap, dispatchRequest(staleSnap, localCredential, peerCredential, testHostB, leafDER, rootDER, allowlist, testNow), ErrStaleGeneration},\n100|\t\t{\"future generation\", futureSnap, dispatchRequest(futureSnap, localCredential, peerCredential, testHostB, leafDER, rootDER, allowlist, testNow), ErrStaleGeneration},\n101|\t\t{\"refreshed number on old snapshot\", localSnap, mismatched, ErrStaleGeneration},\n102|\t\t{\"unknown local credential\", localSnap, dispatchRequest(localSnap, peerCredential, peerCredential, testHostB, leafDER, rootDER, allowlist, testNow), ErrAuthorizationRefused},\n103|\t\t{\"unknown remote bytes\", localSnap, dispatchRequest(localSnap, localCredential, peerCredential, testHostB, other.LeafDER, other.RootDER, allowlist, testNow), ErrAuthorizationRefused},\n104|\t\t{\"unenrolled remote\", localSnap, dispatchRequest(localSnap, localCredential, peerCredential, testHostC, strangerMaterial.LeafDER, strangerMaterial.RootDER, allowlist, testNow), ErrAuthorizationRefused},\n105|\t\t{\"leaf root mismatch\", localSnap, dispatchRequest(localSnap, localCredential, peerCredential, testHostB, leafDER, other.RootDER, allowlist, testNow), ErrAuthorizationRefused},\n106|\t\t{\"not allowlisted\", localSnap, dispatchRequest(localSnap, localCredential, peerCredential, testHostB, leafDER, rootDER, []string{testHostA}, testNow), ErrNotAllowlisted},\n107|\t\t{\"hello mismatch\", localSnap, dispatchRequest(localSnap, localCredential, peerCredential, testHostC, leafDER, rootDER, allowlist, testNow), ErrHostIdentityMismatch},\n108|\t\t{\"wrong destination\", localSnap, func() AuthRequest {\n109|\t\t\trequest := dispatchRequest(localSnap, localCredential, peerCredential, testHostB, leafDER, rootDER, allowlist, testNow)\n110|\t\t\trequest.ExpectedRemoteHostID = testHostC\n111|\t\t\treturn request\n112|\t\t}(), ErrHostIdentityMismatch},\n113|\t\t{\"expired credentials\", localSnap, dispatchRequest(localSnap, localCredential, peerCredential, testHostB, leafDER, rootDER, allowlist, testNow.Add(91*24*time.Hour)), ErrAuthorizationRefused},\n114|\t}\n115|\tfor _, test := range tests {\n116|\t\tt.Run(test.name, func(t *testing.T) {\n117|\t\t\tif err := local.AuthorizeDispatch(test.snapshot, test.request); err == nil {\n118|\t\t\t\tt.Fatalf(\"AuthorizeDispatch(%s) succeeded, want refusal\", test.name)\n119|\t\t\t} else if !errors.Is(err, test.want) {\n120|\t\t\t\tt.Fatalf(\"AuthorizeDispatch(%s) error = %v, want %v\", test.name, err, test.want)\n121|\t\t\t}\n122|\t\t})\n123|\t}\n124|}\n125|\n126|func TestRevocationClosesAuthorization(t *testing.T) {\n127|\tlocal, peer, localCredential, peerCredential, localSnap, _ := twoHostFixture(t)\n128|\tleafDER, rootDER := peerMaterialForTest(t, peer, peerCredential)\n129|\tallowlist := []string{testHostA, testHostB}\n130|\trequest := dispatchRequest(localSnap, localCredential, peerCredential, testHostB, leafDER, rootDER, allowlist, testNow)\n131|\tif err := local.AuthorizeDispatch(localSnap, request); err != nil {\n132|\t\tt.Fatalf(\"pre-revocation AuthorizeDispatch error = %v\", err)\n133|\t}\n134|\tif err := local.Revoke(peerCredential); err != nil {\n135|\t\tt.Fatalf(\"Revoke error = %v\", err)\n136|\t}\n137|\t// The bound snapshot is stale: work prepared under the old generation\n138|\t// cannot gain new authority by refreshing a cached number.\n139|\tif err := local.AuthorizeDispatch(localSnap, request); err == nil {\n140|\t\tt.Fatal(\"post-revocation AuthorizeDispatch(stale snapshot) succeeded, want refusal\")\n141|\t} else if !errors.Is(err, ErrStaleGeneration) {\n142|\t\tt.Fatalf(\"post-revocation error = %v, want ErrStaleGeneration\", err)\n143|\t}\n144|\tfresh, err := local.ReadSnapshot()\n145|\tif err != nil {\n146|\t\tt.Fatal(err)\n147|\t}\n148|\tfreshRequest := request\n149|\tfreshRequest.SnapshotGeneration = fresh.Generation\n150|\tif err := local.AuthorizeDispatch(fresh, freshRequest); err == nil {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca07","stream":{"kind":"session","id":"01a0aa3d-f870-72c3-b067-9f985ccf069d"},"sequence":862,"recorded_at":1780531400001719,"record_type":"event","durability":"durable","causation_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","run_stream":{"kind":"run","id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01"},"call_id":"call_01a0aa400fbd712fabe2b14714c4b068","text":"Read text file `internal/hosttrust/dacl_test.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"os\"\n5|\t\"path/filepath\"\n6|\t\"testing\"\n7|)\n8|\n9|func TestMatchExcludedFromReplication(t *testing.T) {\n10|\tcredentialFile := hostChannelDir + \"/credentials/abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789/private-key.pem\"\n11|\ttests := []struct {\n12|\t\tname     string\n13|\t\tpath     string\n14|\t\texcluded bool\n15|\t}{\n16|\t\t{\"trust document\", hostChannelDir + \"/trust.json\", true},\n17|\t\t{\"joint marker\", hostChannelDir + \"/pending-commit.json\", true},\n18|\t\t{\"credential directory\", hostChannelDir + \"/credentials/\", true},\n19|\t\t{\"private key\", credentialFile, true},\n20|\t\t{\"certificate\", hostChannelDir + \"/credentials/abcdef/certificate.pem\", true},\n21|\t\t{\"lock\", hostChannelDir + \"/lock\", true},\n22|\t\t{\"trust staging\", hostChannelDir + \"/.trust-stage-12345\", true},\n23|\t\t{\"custody staging\", hostChannelDir + \"/credentials/abcdef/.custody-stage-1\", true},\n24|\t\t{\"lock staging\", hostChannelDir + \"/lock-stage-9\", true},\n25|\t\t{\"unrelated state\", \"sessions/index.json\", false},\n26|\t\t{\"bare trust name elsewhere\", \"other/trust.json\", false},\n27|\t\t{\"empty\", \"\", false},\n28|\t\t{\"dot\", \".\", false},\n29|\t\t{\"escape\", \"../outside\", true},\n30|\t\t{\"nested escape\", \"host-channel/../../outside\", true},\n31|\t\t{\"absolute\", \"/etc/host-channel/trust.json\", true},\n32|\t}\n33|\tfor _, test := range tests {\n34|\t\tt.Run(test.name, func(t *testing.T) {\n35|\t\t\tif got := MatchExcludedFromReplication(test.path); got != test.excluded {\n36|\t\t\t\tt.Fatalf(\"MatchExcludedFromReplication(%q) = %v, want %v\", test.path, got, test.excluded)\n37|\t\t\t}\n38|\t\t})\n39|\t}\n40|}\n41|\n42|func TestExcludedConfigDirName(t *testing.T) {\n43|\ttests := []struct {\n44|\t\tname     string\n45|\t\tbase     string\n46|\t\texcluded bool\n47|\t}{\n48|\t\t{\"versioned backup\", \"config.toml.bak.3.0.0\", true},\n49|\t\t{\"pre-rollback copy\", \"config.toml.pre-rollback.4.0.0\", true},\n50|\t\t{\"backup staging\", \".ax-config-backup-123\", true},\n51|\t\t{\"migration staging\", \".ax-config-migrate-1\", true},\n52|\t\t{\"restore staging\", \".ax-config-restore-2\", true},\n53|\t\t{\"rollback staging\", \".ax-config-rollback-3\", true},\n54|\t\t{\"live configuration\", \"config.toml\", false},\n55|\t\t{\"unrelated\", \"notes.txt\", false},\n56|\t}\n57|\tfor _, test := range tests {\n58|\t\tt.Run(test.name, func(t *testing.T) {\n59|\t\t\tif got := ExcludedConfigDirName(test.base); got != test.excluded {\n60|\t\t\t\tt.Fatalf(\"ExcludedConfigDirName(%q) = %v, want %v\", test.base, got, test.excluded)\n61|\t\t\t}\n62|\t\t})\n63|\t}\n64|}\n65|\n66|func TestCustodyLayoutFullyExcluded(t *testing.T) {\n67|\tlocal, _, _, _, _, _ := twoHostFixture(t)\n68|\troot := filepath.Dir(filepath.Dir(local.TrustPath()))\n69|\tvar checked int\n70|\terr := filepath.Walk(root, func(path string, info os.FileInfo, err error) error {\n71|\t\tif err != nil {\n72|\t\t\treturn err\n73|\t\t}\n74|\t\tif info.IsDir() {\n75|\t\t\treturn nil\n76|\t\t}\n77|\t\trelative, err := filepath.Rel(root, path)\n78|\t\tif err != nil {\n79|\t\t\treturn err\n80|\t\t}\n81|\t\tchecked++\n82|\t\tif !MatchExcludedFromReplication(filepath.ToSlash(relative)) {\n83|\t\t\tt.Errorf(\"custody file %q escapes replication exclusion\", relative)\n84|\t\t}\n85|\t\treturn nil\n86|\t})\n87|\tif err != nil {\n88|\t\tt.Fatal(err)\n89|\t}\n90|\tif checked == 0 {\n91|\t\tt.Fatal(\"no custody files walked\")\n92|\t}\n93|}\n94|\n95|func TestEnrollmentExportNotExcluded(t *testing.T) {\n96|\t// Explicitly selected public enrollment material is the only operator\n97|\t// exchange outside replication: the matcher must not swallow it. The\n98|\t// material itself travels as explicit fields, never as a state-dir\n99|\t// path, so no state-relative path may claim to carry it.\n100|\tlocal, _, _, peerCredential, _, _ := twoHostFixture(t)\n101|\tsnapshot, err := local.ReadSnapshot()\n102|\tif err != nil {\n103|\t\tt.Fatal(err)\n104|\t}\n105|\tmaterial, err := ExportEnrollment(snapshot, peerCredential)\n106|\tif err != nil {\n107|\t\tt.Fatal(err)\n108|\t}\n109|\tif len(material.LeafDER) == 0 || len(material.RootDER) == 0 {\n110|\t\tt.Fatal(\"ExportEnrollment returned empty public bytes\")\n111|\t}\n112|}\n113|\n114|func TestOwnerOnlyGrants(t *testing.T) {\n115|\towner := \"S-1-5-21-1-2-3-1001\"\n116|\tother := \"S-1-5-21-1-2-3-1002\"\n117|\tsystem := \"S-1-5-18\"\n118|\ttests := []struct {\n119|\t\tname  string\n120|\t\towner string\n121|\t\taces  []allowedACE\n122|\t\twant  bool\n123|\t}{\n124|\t\t{\"owner-only allow\", owner, []allowedACE{{kind: aceAllow, sid: owner}}, true},\n125|\t\t{\"other-principal allow\", owner, []allowedACE{{kind: aceAllow, sid: owner}, {kind: aceAllow, sid: other}}, false},\n126|\t\t{\"inherited system allow\", owner, []allowedACE{{kind: aceAllow, sid: owner}, {kind: aceAllow, sid: system}}, false},\n127|\t\t{\"world allow\", owner, []allowedACE{{kind: aceAllow, sid: \"S-1-1-0\"}}, false},\n128|\t\t{\"empty DACL\", owner, nil, false},\n129|\t\t{\"deny-only DACL\", owner, []allowedACE{{kind: aceDeny, sid: other}}, false},\n130|\t\t{\"deny other plus allow owner\", owner, []allowedACE{{kind: aceDeny, sid: other}, {kind: aceAllow, sid: owner}}, true},\n131|\t\t{\"unknown entry type\", owner, []allowedACE{{kind: aceAllow, sid: owner}, {kind: aceOther, sid: owner}}, false},\n132|\t\t{\"empty owner\", \"\", []allowedACE{{kind: aceAllow, sid: owner}}, false},\n133|\t}\n134|\tfor _, test := range tests {\n135|\t\tt.Run(test.name, func(t *testing.T) {\n136|\t\t\tif got := ownerOnlyGrants(test.owner, test.aces); got != test.want {\n137|\t\t\t\tt.Fatalf(\"ownerOnlyGrants(%s) = %v, want %v\", test.name, got, test.want)\n138|\t\t\t}\n139|\t\t})\n140|\t}\n141|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
