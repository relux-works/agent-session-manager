{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca49","stream":{"kind":"session","id":"01a0aa3d-f870-72c3-b067-9f985ccf069d"},"sequence":895,"recorded_at":1780531400001785,"record_type":"event","durability":"durable","causation_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","run_stream":{"kind":"run","id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01"},"call_id":"call_01a0aa40208d77268da9937554ba5f6e","text":"Read text file `internal/hosttrust/mutations.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Host trust behavioral overlays; no source-only or compile-error kills.\"\"\"\n3|import argparse\n4|import json\n5|from pathlib import Path\n6|import subprocess\n7|import sys\n8|\n9|ROOT = Path(__file__).resolve().parents[2]\n10|TRUST = \"internal/hosttrust/trust.go\"\n11|DECODE = \"internal/hosttrust/trust_decode.go\"\n12|ENROLL = \"internal/hosttrust/enroll.go\"\n13|ROTATE = \"internal/hosttrust/rotate.go\"\n14|AUTHORIZE = \"internal/hosttrust/authorize.go\"\n15|JOINT = \"internal/hosttrust/joint.go\"\n16|CUSTODY = \"internal/hosttrust/custody.go\"\n17|CUSTODY_UNIX = \"internal/hosttrust/custody_unix.go\"\n18|PROFILE = \"internal/hosttrust/profile_verify.go\"\n19|TRANSACT = \"internal/hosttrust/transact.go\"\n20|TESTS = \"Test\"\n21|PROBES = [\n22| (\"neutral\", TRANSACT, \"next.Generation = committed.Generation + 1\", \"next.Generation = committed.Generation + 1 + 0\", \"Equivalent generation increment\", None),\n23| (\"gen-ceiling\", DECODE, \"if parsed == 0 || parsed > MaxGeneration {\", \"if parsed == 0 || parsed > MaxGeneration+1 {\", \"Admits exactly generation 2^53\", \"TestDecodeTrustRefusals/generation_uint53_ceiling\"),\n24| (\"dup-credid\", DECODE, \"if previous >= current {\", \"if previous == current {\", \"Admits unsorted-but-distinct entries while keeping duplicate refusal; the mapping gate now subsumes the identical-entry case\", \"TestDecodeTrustRefusals/unsorted_entries\"),\n25| (\"unknown-field\", TRUST, 'case \"schema\", \"schema_version\", \"generation\", \"entries\":', 'case \"schema\", \"schema_version\", \"generation\", \"entries\", \"comment\":', \"Admits exactly one unknown field\", \"TestDecodeTrustRefusals/unknown_root_field\"),\n26| (\"per-host-bound\", ENROLL, \"if live >= 2 {\", \"if live >= 3 {\", \"Admits exactly the third non-revoked credential\", \"TestEnrollBoundsPerHost\"),\n27| (\"rotation-expiry\", ROTATE, \"deadline = oldLeaf.NotAfter\", \"deadline = oldLeaf.NotAfter.Add(time.Hour)\", \"Extends overlap one hour past old leaf expiry\", \"TestRotateCapsAtLeafExpiry\"),\n28| (\"revoke-state\", ROTATE, \"trust.Entries[index].State = EntryRevoked\", \"trust.Entries[index].State = EntryRetiring\", \"Weakens the terminal state to retiring, admitting re-revocation\", \"TestRevokeTombstone\"),\n29| (\"retire-bound\", ROTATE, \"fixed.After(now.Add(RotationBound))\", \"fixed.After(now.Add(48 * time.Hour))\", \"Admits exactly the 24-48h overlap window\", \"TestMarkRetiringBounds/past_24h_bound\"),\n30| (\"stale-direction\", AUTHORIZE, \"if snapshot.Generation != current.Generation {\", \"if snapshot.Generation > current.Generation {\", \"Admits stale-older snapshots while refusing newer\", \"TestAuthorizeDispatchRefusals/stale_generation\"),\n31| (\"stale-mutation-refresh\", AUTHORIZE, \"if request.SnapshotGeneration != current.Generation {\", \"if request.SnapshotGeneration > current.Generation {\", \"Admits older mutation bindings while refusing newer\", \"TestWithMutationAuthorizationRefusesStaleGeneration\"),\n32| (\"joint-marker-stale\", JOINT, \"if marker.SourceGeneration != committed.Generation {\", \"if marker.SourceGeneration > committed.Generation {\", \"Admits older pinned generations into the joint commit\", \"TestJointCommitRefusesStaleMarkerGeneration\"),\n33| (\"recover-diverged\", JOINT, \"case marker.SourceGeneration + 1:\", \"case marker.SourceGeneration + 1, marker.SourceGeneration + 2:\", \"Completes forward under a diverged generation\", \"TestRecoverRefusesDivergedGeneration\"),\n34| (\"custody-0644\", CUSTODY_UNIX, \"return info.Mode().Perm() == mode\", \"return info.Mode().Perm() == mode || info.Mode().Perm() == 0o644\", \"Admits exactly world-readable 0644 files\", \"TestCustodyRefusals/world_readable_trust_file\"),\n35| (\"expiry-grace\", PROFILE, \"instant.After(certificate.NotAfter)\", \"instant.After(certificate.NotAfter.Add(time.Second))\", \"Admits exactly one second past expiry\", \"TestVerifyProfileRefusesJustPastExpiry\"),\n36| (\"exhaustion\", TRANSACT, \"if committed.Generation >= MaxGeneration {\", \"if committed.Generation > MaxGeneration {\", \"Admits the ceiling generation into the commit path\", \"TestGenerationExhaustionRefusesMutation\"),\n37| (\"digest-root-swap\", DECODE, \"if scalar.SHA256Digest(entry.LeafDER).String() != entry.CredentialID.String() {\", \"if scalar.SHA256Digest(entry.LeafDER).String() != entry.CredentialID.String() && scalar.SHA256Digest(entry.RootDER).String() != entry.CredentialID.String() {\", \"Admits exactly stores naming the root digest as credential_id\", \"TestDecodeTrustRefusals/credential_id_not_leaf_digest\"),\n38| (\"unique-root-pair\", TRUST, \"if _, duplicate := roots[entry.RootID.String()]; duplicate {\", \"if _, duplicate := roots[entry.RootID.String()]; duplicate && len(entries) > 2 {\", \"Admits exactly the minimal two-entry root duplicate\", \"TestDecodeTrustRefusals/duplicate_root_across_entries\"),\n39| (\"retire-expiry\", ROTATE, \"if fixed.After(oldLeaf.NotAfter) {\", \"if fixed.After(oldLeaf.NotAfter.Add(time.Hour)) {\", \"Admits retire_at up to one hour past old leaf expiry\", \"TestMarkRetiringCapsAtLeafExpiry\"),\n40| (\"custody-binding\", ENROLL, \"if scalar.SHA256Digest(leaf.Raw).Hex() != credentialHex {\", \"if scalar.SHA256Digest(leaf.Raw).Hex() != credentialHex && scalar.SHA256Digest(rootBlock.Bytes).Hex() != credentialHex {\", \"Admits exactly directories named by the root digest\", \"TestValidateCustodyBindsDirectory\"),\n41|]\n42|\n43|BOUNDS = {\n44| \"neutral\": \"Equivalent arithmetic; no independent kill claimed.\",\n45|}\n46|\n47|def main():\n48|    parser = argparse.ArgumentParser(description=__doc__)\n49|    parser.add_argument(\"--output\", required=True)\n50|    parser.add_argument(\"--only\", help=\"Comma-separated probe names for a bounded follow-up\")\n51|    opts = parser.parse_args()\n52|    if opts.only and not set(opts.only.split(\",\")).issubset({p[0] for p in PROBES}):\n53|        parser.error(\"--only contains an unknown probe\")\n54|    out = Path(opts.output).resolve()\n55|    out.mkdir(parents=True, exist_ok=True)\n56|    results = []\n57|    unexpected = False\n58|    for name, path, old, new, narrows, expected_test in PROBES:\n59|        if opts.only and name not in opts.only.split(\",\"):\n60|            continue\n61|        source = ROOT / path\n62|        original = source.read_bytes()\n63|        text = original.decode()\n64|        if text.count(old) != 1:\n65|            raise RuntimeError(f\"{name}: plant must match exactly once, got {text.count(old)}\")\n66|        folder = out / name\n67|        folder.mkdir(exist_ok=True)\n68|        replacement = folder / source.name\n69|        replacement.write_text(text.replace(old, new, 1))\n70|        overlay = folder / \"overlay.json\"\n71|        overlay.write_text(json.dumps({\"Replace\": {str(source): str(replacement)}}))\n72|        command = [\"go\", \"test\", \"-overlay\", str(overlay), \"./internal/hosttrust\", \"-count=1\", \"-json\", \"-timeout=120s\", \"-run\", TESTS]\n73|        proc = subprocess.run(command, cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=300)\n74|        (folder / \"test.log\").write_bytes(proc.stdout)\n75|        events = []\n76|        for line in proc.stdout.decode(errors=\"replace\").splitlines():\n77|            try:\n78|                events.append(json.loads(line))\n79|            except json.JSONDecodeError:\n80|                pass\n81|        failed = [e[\"Test\"] for e in events if e.get(\"Action\") == \"fail\" and \"Test\" in e]\n82|        passed = [e[\"Test\"] for e in events if e.get(\"Action\") == \"pass\" and \"Test\" in e]\n83|        killed = proc.returncode != 0 and bool(failed) and (expected_test is None or expected_test in failed)\n84|        if name == \"neutral\":\n85|            valid = proc.returncode == 0 and bool(passed)\n86|            state = \"neutral passed\" if valid else \"invalid control\"\n87|        elif name in BOUNDS:\n88|            valid = proc.returncode == 0 and bool(passed)\n89|            state = \"survived\" if valid else \"unexpected result\"\n90|        else:\n91|            valid = killed\n92|            state = \"killed\" if killed else \"survived\" if proc.returncode == 0 and passed else \"invalid instrument/compile failure\"\n93|        if not valid:\n94|            unexpected = True\n95|        if source.read_bytes() != original:\n96|            raise RuntimeError(f\"{name}: source changed during overlay run\")\n97|        row = {\"mutant\": name, \"narrowing\": narrows, \"exit_code\": proc.returncode, \"result\": state,\n98|               \"named_failing_tests\": failed, \"expected_test\": expected_test,\n99|               \"bound\": BOUNDS.get(name, \"\" if killed or name == \"neutral\" else \"No named failing test established; this gate member is unproven.\"),\n100|               \"command\": command}\n101|        results.append(row)\n102|        print(f\"{name}: {state}, exit={proc.returncode}, tests={','.join(failed)}\", flush=True)\n103|        (out / \"results.json\").write_text(json.dumps(results, indent=2) + \"\\n\")\n104|    rows = [\"| Mutant | What the gate is narrowed to admit | Named failing test | Exit | Result / surviving bound |\",\n105|            \"| --- | --- | --- | ---: | --- |\"]\n106|    for r in results:\n107|        tests = r[\"expected_test\"] if r[\"expected_test\"] in r[\"named_failing_tests\"] else \", \".join(r[\"named_failing_tests\"])\n108|        rows.append(f'| {r[\"mutant\"]} | {r[\"narrowing\"]} | {tests or \"none\"} | {r[\"exit_code\"]} | {r[\"result\"]}: {r[\"bound\"]} |')\n109|    (out / \"table.md\").write_text(\"\\n\".join(rows)+\"\\n\")\n110|    return int(unexpected)\n111|\n112|\n113|if __name__ == \"__main__\":\n114|    sys.exit(main())","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
