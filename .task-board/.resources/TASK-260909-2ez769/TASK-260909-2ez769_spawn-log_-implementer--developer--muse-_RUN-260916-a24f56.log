{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cbbb","stream":{"kind":"session","id":"01a0aa3d-f870-72c3-b067-9f985ccf069d"},"sequence":1080,"recorded_at":1780531400002155,"record_type":"event","durability":"durable","causation_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","run_stream":{"kind":"run","id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01"},"task_stream":{"kind":"task","id":"01a0aa40-dfb1-7fc2-a85c-0424b5517a81"},"task_id":"01a0aa40-dfb1-7fc2-a85c-0424b5517a81","event":{"kind":"output","task_id":"01a0aa40-dfb1-7fc2-a85c-0424b5517a81","chunk":"Read text file `internal/config/migration.go`.\n(249 line(s) above)\n250|\n251|type migrationDirectory interface {\n252|\tSync() error\n253|\tClose() error\n254|}\n255|\n256|type migrationFileSystem interface {\n257|\tCreateTemp(string, string) (migrationFile, error)\n258|\tLink(string, string) error\n259|\tReadFile(string) ([]byte, error)\n260|\tStat(string) (fs.FileInfo, error)\n261|\tRemove(string) error\n262|\tRename(string, string) error\n263|\tOpenDirectory(string) (migrationDirectory, error)\n264|}\n265|\n266|type osMigrationFileSystem struct{}\n267|\n268|func (osMigrationFileSystem) CreateTemp(dir, pattern string) (migrationFile, error) {\n269|\treturn os.CreateTemp(dir, pattern)\n270|}\n271|func (osMigrationFileSystem) Link(oldname, newname string) error   { return os.Link(oldname, newname) }\n272|func (osMigrationFileSystem) ReadFile(name string) ([]byte, error) { return os.ReadFile(name) }\n273|\n274|// Stat does not follow a symlink, unlike the symlink-following read-side seam\n275|// in OSInputs. Durable migration replaces the selected file with an atomic\n276|// rename, which replaces a symlink itself rather than its target: migrating a\n277|// symlinked configuration would silently detach the operator's link and leave\n278|// the real document holding stale bytes next to a backup of the resolved\n279|// target. The specification is silent here, so the mutating path fails closed\n280|// with ErrConfigNotRegular instead of guessing which file the operator meant.\n281|func (osMigrationFileSystem) Stat(name string) (fs.FileInfo, error) { return os.Lstat(name) }\n282|func (osMigrationFileSystem) Remove(name string) error              { return os.Remove(name) }\n283|func (osMigrationFileSystem) Rename(oldname, newname string) error {\n284|\treturn os.Rename(oldname, newname)\n285|}\n286|func (osMigrationFileSystem) OpenDirectory(name string) (migrationDirectory, error) {\n287|\treturn os.Open(name)\n288|}\n289|\n290|func replaceDurably(filesystem migrationFileSystem, filename, backup string, original, replacement []byte) error {\n291|\tdirectory := filepath.Dir(filename)\n292|\t// Re-inspect the selected file before anything durable is written. Load\n293|\t// resolved and validated it through the symlink-following read seam; this\n294|\t// mutating seam does not follow symlinks, so a selected file that is not\n295|\t// itself a regular file is refused here rather than after a backup has\n296|\t// already been published. A refused migration therefore leaves the\n297|\t// directory exactly as it found it, and the captured permission bits are\n298|\t// the ones the replacement inherits.\n299|\tinfo, err := filesystem.Stat(filename)\n300|\tif err != nil {\n301|\t\treturn migrationError(MigrationError{Operation: \"inspect source mode\", Err: errors.Join(ErrMigrationWrite, err)})\n302|\t}\n303|\tif !info.Mode().IsRegular() {\n304|\t\treturn migrationError(MigrationError{Operation: \"inspect source mode\", Err: errors.Join(ErrMigrationWrite, ErrConfigNotRegular)})\n305|\t}\n306|\tbackupTemp, err := writeTempFile(filesystem, directory, \".ax-config-backup-*\", original, 0o600)\n307|\tif err != nil {\n308|\t\treturn migrationError(MigrationError{Operation: \"write backup\", Err: errors.Join(ErrMigrationBackup, err)})\n309|\t}\n310|\tif err := filesystem.Link(backupTemp, backup); err != nil {\n311|\t\tif !errors.Is(err, fs.ErrExist) {\n312|\t\t\t_ = filesystem.Remove(backupTemp)\n313|\t\t\treturn migrationError(MigrationError{Operation: \"publish backup\", Err: errors.Join(ErrMigrationBackup, err)})\n314|\t\t}\n315|\t\texisting, readErr := filesystem.ReadFile(backup)\n316|\t\tinfo, statErr := filesystem.Stat(backup)\n317|\t\tif readErr != nil || statErr != nil || !bytes.Equal(existing, original) || info.Mode().Perm()&0o077 != 0 {\n318|\t\t\t_ = filesystem.Remove(backupTemp)\n319|\t\t\treturn migrationError(MigrationError{Operation: \"verify backup\", Err: ErrMigrationBackup})\n320|\t\t}\n321|\t}\n322|\tif err := filesystem.Remove(backupTemp); err != nil && !errors.Is(err, fs.ErrNotExist) {\n323|\t\treturn migrationError(MigrationError{Operation: \"remove backup staging file\", Err: errors.Join(ErrMigrationBackup, err)})\n324|\t}\n325|\t// Retry the directory sync even when an exact backup already exists: it may\n326|\t// be the visible result of an interrupted run whose directory fsync failed.\n327|\tif err := syncDirectory(filesystem, directory); err != nil {\n328|\t\treturn migrationError(MigrationError{Operation: \"sync backup directory\", Err: errors.Join(ErrMigrationSync, err)})\n329|\t}\n330|\n331|\treplacementTemp, err := writeTempFile(filesystem, directory, \".ax-config-migrate-*\", replacement, info.Mode().Perm())\n332|\tif err != nil {\n333|\t\treturn migrationError(MigrationError{Operation: \"write replacement\", Err: errors.Join(ErrMigrationWrite, err)})\n334|\t}\n335|\tif err := filesystem.Rename(replacementTemp, filename); err != nil {\n336|\t\t_ = filesystem.Remove(replacementTemp)\n337|\t\treturn migrationError(MigrationError{Operation: \"replace source\", Err: errors.Join(ErrMigrationReplace, err)})\n338|\t}\n339|\tif err := syncDirectory(filesystem, directory); err == nil {\n340|\t\treturn nil\n341|\t} else {\n342|\t\tsyncErr := err\n343|\t\trollbackTemp, rollbackErr := writeTempFile(filesystem, directory, \".ax-config-rollback-*\", original, info.Mode().Perm())\n344|\t\tif rollbackErr == nil {\n345|\t\t\trollbackErr = filesystem.Rename(rollbackTemp, filename)\n346|\t\t}\n347|\t\tif rollbackErr == nil {\n348|\t\t\trollbackErr = syncDirectory(filesystem, directory)\n349|\t\t}\n350|\t\tif rollbackErr != nil {\n351|\t\t\tif rollbackTemp != \"\" {\n352|\t\t\t\t_ = filesystem.Remove(rollbackTemp)\n353|\t\t\t}\n354|\t\t\treturn migrationError(MigrationError{Operation: \"recover source after sync\", Err: errors.Join(ErrMigrationSync, ErrMigrationRecovery, syncErr, rollbackErr)})\n355|\t\t}\n356|\t\treturn migrationError(MigrationError{Operation: \"sync replacement directory\", Err: errors.Join(ErrMigrationSync, syncErr)})\n357|\t}\n358|}\n359|\n360|func writeTempFile(filesystem migrationFileSystem, directory, pattern string, document []byte, mode fs.FileMode) (name string, err error) {\n361|\tfile, err := filesystem.CreateTemp(directory, pattern)\n362|\tif err != nil {\n363|\t\treturn \"\", err\n364|\t}\n365|\tname = file.Name()\n366|\tclean := func(cause error) (string, error) {\n367|\t\t_ = file.Close()\n368|\t\t_ = filesystem.Remove(name)\n369|\t\treturn \"\", cause\n370|\t}\n371|\tif err := file.Chmod(mode); err != nil {\n372|\t\treturn clean(err)\n373|\t}\n374|\tif err := writeAll(file, document); err != nil {\n375|\t\treturn clean(err)\n376|\t}\n377|\tif err := file.Sync(); err != nil {\n378|\t\treturn clean(err)\n379|\t}\n380|\tif err := file.Close(); err != nil {\n381|\t\t_ = filesystem.Remove(name)\n382|\t\treturn \"\", err\n383|\t}\n384|\treturn name, nil\n385|}\n386|\n387|func writeAll(writer io.Writer, document []byte) error {\n388|\tfor len(document) > 0 {\n389|\t\twritten, err := writer.Write(document)\n390|\t\tif err != nil {\n391|\t\t\treturn err\n392|\t\t}\n393|\t\tif written == 0 {\n394|\t\t\treturn io.ErrShortWrite\n395|\t\t}\n396|\t\tdocument = document[written:]\n397|\t}\n398|\treturn nil\n399|}\n400|\n401|func syncDirectory(filesystem migrationFileSystem, directory string) error {\n402|\thandle, err := filesystem.OpenDirectory(directory)\n403|\tif err != nil {\n404|\t\treturn err\n405|\t}\n406|\tif err := handle.Sync(); err != nil {\n407|\t\t_ = handle.Close()\n408|\t\treturn err\n409|\t}\n410|\treturn handle.Close()\n411|}\n412|\n413|// Indirections keep compatibility-envelope parsing in this file while using\n414|// the same TOML implementation as Decode.\n415|var tomlDecode = func(document []byte, destination any) error {\n416|\treturn toml.Unmarshal(document, destination)\n417|}\n418|\n419|// migrationError is the only construction site for *MigrationError, for the\n420|// same reason loaderError is the only construction site for *Error.\n421|var migrationError = func(value MigrationError) error {\n422|\treturn &value\n423|}","final_result":true}}}
