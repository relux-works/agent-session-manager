{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c953","stream":{"kind":"session","id":"01a0aa3d-f870-72c3-b067-9f985ccf069d"},"sequence":772,"recorded_at":1780531400001539,"record_type":"event","durability":"durable","causation_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","run_stream":{"kind":"run","id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01"},"call_id":"call_01a0aa3fdb4d73a18725d1be3fd5e441","text":"Read text file `internal/hosttrust/enroll.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"crypto/ecdsa\"\n6|\t\"crypto/x509\"\n7|\t\"encoding/pem\"\n8|\t\"errors\"\n9|\t\"path/filepath\"\n10|\t\"time\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|)\n14|\n15|// EnrollInput is the explicit local operator authorization of one enrollment\n16|// tuple plus the imported public bytes. The Authorized fingerprints must come\n17|// from an independent authenticated out-of-band channel: SSH discovery, a\n18|// first hello, a remote claim, or a certificate being self-signed is never\n19|// approval, and this function cannot tell where the caller got them. What it\n20|// guarantees is that the imported bytes reproduce the authorized tuple and\n21|// the profile before anything commits.\n22|type EnrollInput struct {\n23|\tHostID     string\n24|\tLeafDER    []byte\n25|\tRootDER    []byte\n26|\tAuthorized Fingerprints\n27|\tEnrolledAt time.Time\n28|}\n29|\n30|// Enroll commits one active peer credential after verifying the authorized\n31|// tuple, the profile, lifetimes, and the cross-entry uniqueness rules.\n32|// Enrollment is one-directional: it never implies reciprocity.\n33|func (store *Store) Enroll(input EnrollInput) (string, error) {\n34|\tparsed, err := scalar.ParseUUIDv7(input.HostID)\n35|\tif err != nil {\n36|\t\treturn \"\", trustError(TrustError{Operation: \"enroll host\", Err: errors.Join(ErrEnrollmentRefused, err)})\n37|\t}\n38|\tobserved, err := FingerprintsOf(input.LeafDER, input.RootDER)\n39|\tif err != nil {\n40|\t\treturn \"\", err\n41|\t}\n42|\tif observed != input.Authorized {\n43|\t\treturn \"\", trustError(TrustError{Operation: \"enroll fingerprints\", Err: ErrEnrollmentRefused})\n44|\t}\n45|\tif err := VerifyProfile(input.LeafDER, input.RootDER, parsed.String(), input.EnrolledAt); err != nil {\n46|\t\treturn \"\", err\n47|\t}\n48|\tenrolledAt, err := scalar.ParseTimestamp(input.EnrolledAt.UTC().Format(\"2006-01-02T15:04:05.000Z\"))\n49|\tif err != nil {\n50|\t\treturn \"\", trustError(TrustError{Operation: \"enroll timestamp\", Err: errors.Join(ErrEnrollmentRefused, err)})\n51|\t}\n52|\tentry := CredentialEntry{\n53|\t\tHostID:       parsed,\n54|\t\tCredentialID: scalar.SHA256Digest(input.LeafDER),\n55|\t\tSPKIID:       scalar.SHA256Digest(mustSPKI(input.LeafDER)),\n56|\t\tRootID:       scalar.SHA256Digest(input.RootDER),\n57|\t\tLeafDER:      append([]byte(nil), input.LeafDER...),\n58|\t\tRootDER:      append([]byte(nil), input.RootDER...),\n59|\t\tState:        EntryActive,\n60|\t\tEnrolledAt:   enrolledAt,\n61|\t}\n62|\tif err := store.transact(func(trust *TrustStore) error {\n63|\t\treturn admitEntry(trust, entry)\n64|\t}); err != nil {\n65|\t\treturn \"\", err\n66|\t}\n67|\treturn entry.CredentialID.String(), nil\n68|}\n69|\n70|func mustSPKI(leafDER []byte) []byte {\n71|\tleaf, err := x509.ParseCertificate(leafDER)\n72|\tif err != nil {\n73|\t\treturn nil\n74|\t}\n75|\treturn leaf.RawSubjectPublicKeyInfo\n76|}\n77|\n78|// admitEntry enforces the cross-entry rules across all entries including\n79|// revoked tombstones: a leaf, leaf public key or root must never map to more\n80|// than one host UUID, duplicate roots are invalid even for the same UUID, and\n81|// at most two non-revoked credentials may belong to one host.\n82|func admitEntry(trust *TrustStore, entry CredentialEntry) error {\n83|\tif len(trust.Entries) >= MaxEntries {\n84|\t\treturn trustError(TrustError{Operation: \"admit entry\", Err: ErrEnrollmentRefused})\n85|\t}\n86|\tvar live uint64\n87|\tfor _, existing := range trust.Entries {\n88|\t\tif bytes.Equal(existing.LeafDER, entry.LeafDER) {\n89|\t\t\treturn trustError(TrustError{Operation: \"admit entry\", Err: ErrEnrollmentRefused})\n90|\t\t}\n91|\t\tif existing.SPKIID.String() == entry.SPKIID.String() {\n92|\t\t\treturn trustError(TrustError{Operation: \"admit entry\", Err: ErrEnrollmentRefused})\n93|\t\t}\n94|\t\tif existing.RootID.String() == entry.RootID.String() {\n95|\t\t\treturn trustError(TrustError{Operation: \"admit entry\", Err: ErrEnrollmentRefused})\n96|\t\t}\n97|\t\tif existing.CredentialID.String() == entry.CredentialID.String() {\n98|\t\t\treturn trustError(TrustError{Operation: \"admit entry\", Err: ErrEnrollmentRefused})\n99|\t\t}\n100|\t\tif existing.HostID.String() == entry.HostID.String() && existing.State != EntryRevoked {\n101|\t\t\tlive++\n102|\t\t}\n103|\t}\n104|\tif live >= 2 {\n105|\t\treturn trustError(TrustError{Operation: \"admit entry\", Err: ErrEnrollmentRefused})\n106|\t}\n107|\ttrust.Entries = append(trust.Entries, entry)\n108|\treturn nil\n109|}\n110|\n111|// Issue creates a local credential: fresh keys and profile-exact\n112|// certificates, owner-only custody files, and a self-enrolled active entry,\n113|// committed atomically in that order. Custody files are written before the\n114|// trust commit so a crash can only leave inert files without authority, never\n115|// authority without verifiable custody; a failed trust commit removes the\n116|// staged credential directory again.\n117|func (store *Store) Issue(hostID string, now time.Time) (string, error) {\n118|\tissued, err := IssueCredential(hostID, now, nil)\n119|\tif err != nil {\n120|\t\treturn \"\", err\n121|\t}\n122|\tcredentialHex := scalar.SHA256Digest(issued.LeafDER).Hex()\n123|\tdirectory := filepath.Join(store.root, credentialsDir, credentialHex)\n124|\tif err := ensureOwnerDir(store.fs, directory, 0o700); err != nil {\n125|\t\treturn \"\", err\n126|\t}\n127|\tcommitted := false\n128|\tdefer func() {\n129|\t\tif !committed {\n130|\t\t\t_ = store.fs.Remove(filepath.Join(directory, certificateFile))\n131|\t\t\t_ = store.fs.Remove(filepath.Join(directory, privateKeyFile))\n132|\t\t\t_ = store.fs.Remove(filepath.Join(directory, rootFile))\n133|\t\t\t_ = store.fs.Remove(directory)\n134|\t\t}\n135|\t}()\n136|\tif err := writeCustodyFile(store, directory, certificateFile, pem.EncodeToMemory(&pem.Block{Type: \"CERTIFICATE\", Bytes: issued.LeafDER})); err != nil {\n137|\t\treturn \"\", err\n138|\t}\n139|\tif err := writeCustodyFile(store, directory, privateKeyFile, pem.EncodeToMemory(&pem.Block{Type: \"PRIVATE KEY\", Bytes: issued.LeafKeyDER})); err != nil {\n140|\t\treturn \"\", err\n141|\t}\n142|\tif err := writeCustodyFile(store, directory, rootFile, pem.EncodeToMemory(&pem.Block{Type: \"CERTIFICATE\", Bytes: issued.RootDER})); err != nil {\n143|\t\treturn \"\", err\n144|\t}\n145|\tenrolledAt, err := scalar.ParseTimestamp(now.UTC().Format(\"2006-01-02T15:04:05.000Z\"))\n146|\tif err != nil {\n147|\t\treturn \"\", trustError(TrustError{Operation: \"issue timestamp\", Err: errors.Join(ErrCredentialProfile, err)})\n148|\t}\n149|\tentry := CredentialEntry{\n150|\t\tHostID:       issued.HostID,\n151|\t\tCredentialID: scalar.SHA256Digest(issued.LeafDER),\n152|\t\tSPKIID:       scalar.SHA256Digest(mustSPKI(issued.LeafDER)),\n153|\t\tRootID:       scalar.SHA256Digest(issued.RootDER),\n154|\t\tLeafDER:      issued.LeafDER,\n155|\t\tRootDER:      issued.RootDER,\n156|\t\tState:        EntryActive,\n157|\t\tEnrolledAt:   enrolledAt,\n158|\t}\n159|\tif err := store.transact(func(trust *TrustStore) error {\n160|\t\treturn admitEntry(trust, entry)\n161|\t}); err != nil {\n162|\t\treturn \"\", err\n163|\t}\n164|\tcommitted = true\n165|\treturn entry.CredentialID.String(), nil\n166|}\n167|\n168|func writeCustodyFile(store *Store, directory, name string, contents []byte) error {\n169|\tstaged, err := store.fs.CreateTemp(directory, \".custody-stage-*\", 0o600)\n170|\tif err != nil {\n171|\t\treturn trustError(TrustError{Operation: \"write custody file\", Err: errors.Join(ErrTrustDurability, err)})\n172|\t}\n173|\tstaging := staged.Name()\n174|\t// On platforms where mode bits do not govern access, install the\n175|\t// owner-only ACL before the key material is written.\n176|\tif err := secureStaged(staging, false); err != nil {\n177|\t\t_ = staged.Close()\n178|\t\t_ = store.fs.Remove(staging)\n179|\t\treturn err\n180|\t}\n181|\tfailed := true\n182|\tdefer func() {\n183|\t\tif failed {\n184|\t\t\t_ = store.fs.Remove(staging)\n185|\t\t}\n186|\t}()\n187|\tif err := writeAll(staged, contents); err != nil {\n188|\t\t_ = staged.Close()\n189|\t\treturn trustError(TrustError{Operation: \"write custody file\", Err: errors.Join(ErrTrustDurability, err)})\n190|\t}\n191|\tif err := staged.Sync(); err != nil {\n192|\t\t_ = staged.Close()\n193|\t\treturn trustError(TrustError{Operation: \"sync custody file\", Err: errors.Join(ErrTrustDurability, err)})\n194|\t}\n195|\tif err := staged.Close(); err != nil {\n196|\t\treturn trustError(TrustError{Operation: \"sync custody file\", Err: errors.Join(ErrTrustDurability, err)})\n197|\t}\n198|\ttarget := filepath.Join(directory, name)\n199|\tif err := store.fs.Rename(staging, target); err != nil {\n200|\t\treturn trustError(TrustError{Operation: \"install custody file\", Err: errors.Join(ErrTrustDurability, err)})\n201|\t}\n202|\tinfo, err := store.fs.Lstat(target)\n203|\tif err != nil {\n204|\t\treturn trustError(TrustError{Operation: \"inspect custody file\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n205|\t}\n206|\tif err := verifyOwnerFile(target, info, 0o600); err != nil {\n207|\t\treturn err\n208|\t}\n209|\tfailed = false\n210|\treturn nil\n211|}\n212|\n213|// ValidateCustody checks the local credential files before use: owner-only\n214|// regular files, parseable PEMs, private/public match, profile, and the\n215|// configured host binding. No other file may select identity.\n216|func (store *Store) ValidateCustody(credentialHex, hostID string, now time.Time) error {\n217|\tconst operation = \"validate custody\"\n218|\tdirectory, err := store.CredentialDir(credentialHex)\n219|\tif err != nil {\n220|\t\treturn err\n221|\t}\n222|\tleafPEM, err := readOwnerFile(store, filepath.Join(directory, certificateFile))\n223|\tif err != nil {\n224|\t\treturn err\n225|\t}\n226|\tkeyPEM, err := readOwnerFile(store, filepath.Join(directory, privateKeyFile))\n227|\tif err != nil {\n228|\t\treturn err\n229|\t}\n230|\trootPEM, err := readOwnerFile(store, filepath.Join(directory, rootFile))\n231|\tif err != nil {\n232|\t\treturn err\n233|\t}\n234|\tleafBlock, _ := pem.Decode(leafPEM)\n235|\tkeyBlock, _ := pem.Decode(keyPEM)\n236|\trootBlock, _ := pem.Decode(rootPEM)\n237|\tif leafBlock == nil || keyBlock == nil || rootBlock == nil {\n238|\t\treturn trustError(TrustError{Operation: operation, Err: ErrCredentialCustody})\n239|\t}\n240|\tleaf, err := x509.ParseCertificate(leafBlock.Bytes)\n241|\tif err != nil {\n242|\t\treturn trustError(TrustError{Operation: operation, Err: errors.Join(ErrCredentialCustody, err)})\n243|\t}\n244|\t// The contained leaf must reproduce the credential directory: no other\n245|\t// file may select identity, including a valid credential filed under a\n246|\t// different credential's name.\n247|\tif scalar.SHA256Digest(leaf.Raw).Hex() != credentialHex {\n248|\t\treturn trustError(TrustError{Operation: operation, Err: ErrCredentialCustody})\n249|\t}\n250|\troot, err := x509.ParseCertificate(rootBlock.Bytes)\n251|\tif err != nil {\n252|\t\treturn trustError(TrustError{Operation: operation, Err: errors.Join(ErrCredentialCustody, err)})\n253|\t}\n254|\tkey, err := x509.ParsePKCS8PrivateKey(keyBlock.Bytes)\n255|\tif err != nil {\n256|\t\treturn trustError(TrustError{Operation: operation, Err: errors.Join(ErrCredentialCustody, err)})\n257|\t}\n258|\tprivate, ok := key.(*ecdsa.PrivateKey)\n259|\tif !ok {\n260|\t\treturn trustError(TrustError{Operation: operation, Err: ErrCredentialCustody})\n261|\t}\n262|\tpublic, ok := leaf.PublicKey.(*ecdsa.PublicKey)\n263|\tif !ok {\n264|\t\treturn trustError(TrustError{Operation: operation, Err: ErrCredentialCustody})\n265|\t}\n266|\tif private.PublicKey.X.Cmp(public.X) != 0 || private.PublicKey.Y.Cmp(public.Y) != 0 {\n267|\t\treturn trustError(TrustError{Operation: operation, Err: ErrCredentialCustody})\n268|\t}\n269|\treturn VerifyProfile(leaf.Raw, root.Raw, hostID, now)\n270|}\n271|\n272|func readOwnerFile(store *Store, path string) ([]byte, error) {\n273|\tinfo, err := store.fs.Lstat(path)\n274|\tif err != nil {\n275|\t\treturn nil, trustError(TrustError{Operation: \"read custody file\", Err: errors.Join(ErrCredentialCustody, err)})\n276|\t}\n277|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n278|\t\treturn nil, err\n279|\t}\n280|\tcontents, err := store.fs.ReadFile(path)\n281|\tif err != nil {\n282|\t\treturn nil, trustError(TrustError{Operation: \"read custody file\", Err: errors.Join(ErrCredentialCustody, err)})\n283|\t}\n284|\treturn contents, nil\n285|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c955","stream":{"kind":"session","id":"01a0aa3d-f870-72c3-b067-9f985ccf069d"},"sequence":773,"recorded_at":1780531400001541,"record_type":"event","durability":"durable","causation_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","run_stream":{"kind":"run","id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01"},"call_id":"call_01a0aa3fdce97218a69f11f0c5088c83","text":"Read text file `internal/hosttrust/trust.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"fmt\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|const (\n13|\t// TrustSchemaID is the exact Host Trust Store schema identity.\n14|\tTrustSchemaID = \"urn:ax:schema:host-trust-store\"\n15|\t// TrustSchemaVersion is the only accepted trust store version.\n16|\tTrustSchemaVersion = \"1.0.0\"\n17|\t// MaxGeneration is the uint53 ceiling. A committed store at this\n18|\t// generation refuses every further mutation.\n19|\tMaxGeneration = uint64(1<<53 - 1)\n20|\t// MaxEntries bounds CredentialEntry[0..4096].\n21|\tMaxEntries = 4096\n22|\t// MaxDERBytes bounds each decoded leaf_der/root_der payload.\n23|\tMaxDERBytes = 16384\n24|)\n25|\n26|const (\n27|\t// EntryActive admits the credential for new streams.\n28|\tEntryActive = \"active\"\n29|\t// EntryRetiring admits only pre-rotation streams until retire_at.\n30|\tEntryRetiring = \"retiring\"\n31|\t// EntryRevoked forbids all future admissions. Public bytes are retained\n32|\t// permanently as a reuse tombstone.\n33|\tEntryRevoked = \"revoked\"\n34|)\n35|\n36|// CredentialEntry is one enrolled credential. retire_at is non-null exactly\n37|// for retiring entries and later than enrolled_at.\n38|type CredentialEntry struct {\n39|\tHostID       scalar.UUIDv7\n40|\tCredentialID scalar.Digest\n41|\tSPKIID       scalar.Digest\n42|\tRootID       scalar.Digest\n43|\tLeafDER      []byte\n44|\tRootDER      []byte\n45|\tState        string\n46|\tEnrolledAt   scalar.Timestamp\n47|\tRetireAt     *scalar.Timestamp\n48|}\n49|\n50|// TrustStore is the decoded Host Trust Store 1.0.0 document. Generation is\n51|// greater than zero and increments by one per committed trust/config\n52|// authorization change.\n53|type TrustStore struct {\n54|\tGeneration uint64\n55|\tEntries    []CredentialEntry\n56|}\n57|\n58|// Formatting a store or entry must never expose digests, UUIDs, DER bytes or\n59|// timestamps: custody material never enters logs, snapshots or diagnostics.\n60|func (TrustStore) String() string                    { return \"host trust store\" }\n61|func (TrustStore) GoString() string                  { return \"host trust store\" }\n62|func (TrustStore) Format(state fmt.State, verb rune) { _, _ = state.Write([]byte(\"host trust store\")) }\n63|\n64|func (CredentialEntry) String() string   { return \"host trust credential entry\" }\n65|func (CredentialEntry) GoString() string { return \"host trust credential entry\" }\n66|func (CredentialEntry) Format(state fmt.State, verb rune) {\n67|\t_, _ = state.Write([]byte(\"host trust credential entry\"))\n68|}\n69|\n70|// DecodeTrust is the exact closed Host Trust Store 1.0.0 reader. Unknown,\n71|// missing, duplicate-key, malformed, partial or downgraded state is refused,\n72|// never read as an empty store and never given legacy meaning.\n73|func DecodeTrust(document []byte) (TrustStore, error) {\n74|\tif err := rejectDuplicateKeys(document); err != nil {\n75|\t\treturn TrustStore{}, err\n76|\t}\n77|\tvar shape map[string]json.RawMessage\n78|\tdecoder := json.NewDecoder(bytes.NewReader(document))\n79|\tif err := decoder.Decode(&shape); err != nil {\n80|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"decode document\", Err: errors.Join(ErrTrustDecode, err)})\n81|\t}\n82|\tif decoder.More() {\n83|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"decode document\", Err: ErrTrustDecode})\n84|\t}\n85|\tfor key := range shape {\n86|\t\tswitch key {\n87|\t\tcase \"schema\", \"schema_version\", \"generation\", \"entries\":\n88|\t\tdefault:\n89|\t\t\treturn TrustStore{}, trustError(TrustError{Operation: \"decode document\", Err: errors.Join(ErrTrustValidation, fmt.Errorf(\"unknown field\"))})\n90|\t\t}\n91|\t}\n92|\tvar schema, version string\n93|\tif err := decodeExactString(shape, \"schema\", &schema); err != nil {\n94|\t\treturn TrustStore{}, err\n95|\t}\n96|\tif schema != TrustSchemaID {\n97|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"decode schema\", Err: ErrTrustValidation})\n98|\t}\n99|\tif err := decodeExactString(shape, \"schema_version\", &version); err != nil {\n100|\t\treturn TrustStore{}, err\n101|\t}\n102|\tif version != TrustSchemaVersion {\n103|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"decode schema version\", Err: ErrTrustValidation})\n104|\t}\n105|\tgeneration, err := decodeGeneration(shape)\n106|\tif err != nil {\n107|\t\treturn TrustStore{}, err\n108|\t}\n109|\tentries, err := decodeEntries(shape)\n110|\tif err != nil {\n111|\t\treturn TrustStore{}, err\n112|\t}\n113|\tstore := TrustStore{Generation: generation, Entries: entries}\n114|\tif err := checkSortedUnique(store.Entries); err != nil {\n115|\t\treturn TrustStore{}, err\n116|\t}\n117|\tif err := checkMappingUnique(store.Entries); err != nil {\n118|\t\treturn TrustStore{}, err\n119|\t}\n120|\treturn store, nil\n121|}\n122|\n123|// checkMappingUnique enforces the cross-entry rules at read time, across all\n124|// entries including revoked tombstones: a leaf, leaf public key or root must\n125|// never map twice, even for the same host UUID. Identical leaf bytes imply an\n126|// identical credential_id, which the ordering check already refuses, so the\n127|// leaf member needs no separate comparison here.\n128|func checkMappingUnique(entries []CredentialEntry) error {\n129|\tkeys := make(map[string]struct{}, len(entries))\n130|\troots := make(map[string]struct{}, len(entries))\n131|\tfor _, entry := range entries {\n132|\t\tif _, duplicate := keys[entry.SPKIID.String()]; duplicate {\n133|\t\t\treturn trustError(TrustError{Operation: \"decode entries\", Err: ErrTrustValidation})\n134|\t\t}\n135|\t\tkeys[entry.SPKIID.String()] = struct{}{}\n136|\t\tif _, duplicate := roots[entry.RootID.String()]; duplicate {\n137|\t\t\treturn trustError(TrustError{Operation: \"decode entries\", Err: ErrTrustValidation})\n138|\t\t}\n139|\t\troots[entry.RootID.String()] = struct{}{}\n140|\t}\n141|\treturn nil\n142|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
