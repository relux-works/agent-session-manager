{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cbb7","stream":{"kind":"session","id":"01a0aa3d-f870-72c3-b067-9f985ccf069d"},"sequence":1078,"recorded_at":1780531400002151,"record_type":"event","durability":"durable","causation_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","run_stream":{"kind":"run","id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01"},"task_stream":{"kind":"task","id":"01a0aa40-dff8-7271-9a4d-8f2ae1471944"},"task_id":"01a0aa40-dff8-7271-9a4d-8f2ae1471944","event":{"kind":"output","task_id":"01a0aa40-dff8-7271-9a4d-8f2ae1471944","chunk":"Read text file `internal/hosttrust/custody_test.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"io/fs\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|)\n11|\n12|func openForTest(t *testing.T, stateDir string) *Store {\n13|\tt.Helper()\n14|\tstore, err := Open(stateDir)\n15|\tif err != nil {\n16|\t\tt.Fatalf(\"Open(%s) error = %v\", stateDir, err)\n17|\t}\n18|\treturn store\n19|}\n20|\n21|func TestOpenCreatesOwnerOnlyLayout(t *testing.T) {\n22|\tstate := t.TempDir()\n23|\tstore := openForTest(t, state)\n24|\troot := filepath.Join(state, hostChannelDir)\n25|\tfor _, dir := range []string{root, filepath.Join(root, credentialsDir)} {\n26|\t\tinfo, err := os.Lstat(dir)\n27|\t\tif err != nil {\n28|\t\t\tt.Fatalf(\"Lstat(%s) error = %v\", dir, err)\n29|\t\t}\n30|\t\tif !info.IsDir() || info.Mode().Perm() != 0o700 {\n31|\t\t\tt.Fatalf(\"directory %s mode = %04o, want 0700\", dir, info.Mode().Perm())\n32|\t\t}\n33|\t}\n34|\tsnapshot, err := store.Initialize()\n35|\tif err != nil {\n36|\t\tt.Fatalf(\"Initialize error = %v\", err)\n37|\t}\n38|\tif snapshot.Generation != 1 || len(snapshot.Trust.Entries) != 0 {\n39|\t\tt.Fatalf(\"Initialize = gen %d entries %d, want 1/0\", snapshot.Generation, len(snapshot.Trust.Entries))\n40|\t}\n41|\tinfo, err := os.Lstat(store.TrustPath())\n42|\tif err != nil {\n43|\t\tt.Fatalf(\"Lstat(trust.json) error = %v\", err)\n44|\t}\n45|\tif !info.Mode().IsRegular() || info.Mode().Perm() != 0o600 {\n46|\t\tt.Fatalf(\"trust.json mode = %04o, want 0600\", info.Mode().Perm())\n47|\t}\n48|\tlockInfo, err := os.Lstat(filepath.Join(root, lockFileName))\n49|\tif err != nil {\n50|\t\tt.Fatalf(\"Lstat(lock) error = %v\", err)\n51|\t}\n52|\tif lockInfo.Mode().Perm() != 0o600 {\n53|\t\tt.Fatalf(\"lock mode = %04o, want 0600\", lockInfo.Mode().Perm())\n54|\t}\n55|\t// A second explicit setup refuses: it never overwrites committed authority.\n56|\tif _, err := store.Initialize(); err == nil {\n57|\t\tt.Fatal(\"second Initialize succeeded, want refusal\")\n58|\t}\n59|}\n60|\n61|func TestOpenRefusesRelativeStateDir(t *testing.T) {\n62|\tif _, err := Open(\"relative/state\"); err == nil {\n63|\t\tt.Fatal(\"Open(relative) succeeded, want refusal\")\n64|\t} else if !errors.Is(err, ErrInvalidStoreContext) {\n65|\t\tt.Fatalf(\"Open(relative) error = %v\", err)\n66|\t}\n67|}\n68|\n69|func TestReadSnapshotMissingStore(t *testing.T) {\n70|\tstate := t.TempDir()\n(more lines below)","final_result":true}}}
