\t\treturn migrationError(MigrationError{Operation: \"publish backup\", Err: errors.Join(ErrMigrationBackup, err)})\n314|\t\t}\n315|\t\texisting, readErr := filesystem.ReadFile(backup)\n316|\t\tinfo, statErr := filesystem.Stat(backup)\n317|\t\tif readErr != nil || statErr != nil || !bytes.Equal(existing, original) || info.Mode().Perm()&0o077 != 0 {\n318|\t\t\t_ = filesystem.Remove(backupTemp)\n319|\t\t\treturn migrationError(MigrationError{Operation: \"verify backup\", Err: ErrMigrationBackup})\n320|\t\t}\n321|\t}\n322|\tif err := filesystem.Remove(backupTemp); err != nil && !errors.Is(err, fs.ErrNotExist) {\n323|\t\treturn migrationError(MigrationError{Operation: \"remove backup staging file\", Err: errors.Join(ErrMigrationBackup, err)})\n324|\t}\n325|\t// Retry the directory sync even when an exact backup already exists: it may\n326|\t// be the visible result of an interrupted run whose directory fsync failed.\n327|\tif err := syncDirectory(filesystem, directory); err != nil {\n328|\t\treturn migrationError(MigrationError{Operation: \"sync backup directory\", Err: errors.Join(ErrMigrationSync, err)})\n329|\t}\n330|\n331|\treplacementTemp, err := writeTempFile(filesystem, directory, \".ax-config-migrate-*\", replacement, info.Mode().Perm())\n332|\tif err != nil {\n333|\t\treturn migrationError(MigrationError{Operation: \"write replacement\", Err: errors.Join(ErrMigrationWrite, err)})\n334|\t}\n335|\tif err := filesystem.Rename(replacementTemp, filename); err != nil {\n336|\t\t_ = filesystem.Remove(replacementTemp)\n337|\t\treturn migrationError(MigrationError{Operation: \"replace source\", Err: errors.Join(ErrMigrationReplace, err)})\n338|\t}\n339|\tif err := syncDirectory(filesystem, directory); err == nil {\n340|\t\treturn nil\n341|\t} else {\n342|\t\tsyncErr := err\n343|\t\trollbackTemp, rollbackErr := writeTempFile(filesystem, directory, \".ax-config-rollback-*\", original, info.Mode().Perm())\n344|\t\tif rollbackErr == nil {\n345|\t\t\trollbackErr = filesystem.Rename(rollbackTemp, filename)\n346|\t\t}\n347|\t\tif rollbackErr == nil {\n348|\t\t\trollbackErr = syncDirectory(filesystem, directory)\n349|\t\t}\n350|\t\tif rollbackErr != nil {\n351|\t\t\tif rollbackTemp != \"\" {\n352|\t\t\t\t_ = filesystem.Remove(rollbackTemp)\n353|\t\t\t}\n354|\t\t\treturn migrationError(MigrationError{Operation: \"recover source after sync\", Err: errors.Join(ErrMigrationSync, ErrMigrationRecovery, syncErr, rollbackErr)})\n355|\t\t}\n356|\t\treturn migrationError(MigrationError{Operation: \"sync replacement directory\", Err: errors.Join(ErrMigrationSync, syncErr)})\n357|\t}\n358|}\n359|\n360|func writeTempFile(filesystem migrationFileSystem, directory, pattern string, document []byte, mode fs.FileMode) (name string, err error) {\n361|\tfile, err := filesystem.CreateTemp(directory, pattern)\n362|\tif err != nil {\n363|\t\treturn \"\", err\n364|\t}\n365|\tname = file.Name()\n366|\tclean := func(cause error) (string, error) {\n367|\t\t_ = file.Close()\n368|\t\t_ = filesystem.Remove(name)\n369|\t\treturn \"\", cause\n370|\t}\n371|\tif err := file.Chmod(mode); err != nil {\n372|\t\treturn clean(err)\n373|\t}\n374|\tif err := writeAll(file, document); err != nil {\n375|\t\treturn clean(err)\n376|\t}\n377|\tif err := file.Sync(); err != nil {\n378|\t\treturn clean(err)\n379|\t}\n380|\tif err := file.Close(); err != nil {\n381|\t\t_ = filesystem.Remove(name)\n382|\t\treturn \"\", err\n383|\t}\n384|\treturn name, nil\n385|}\n386|\n387|func writeAll(writer io.Writer, document []byte) error {\n388|\tfor len(document) > 0 {\n389|\t\twritten, err := writer.Write(document)\n390|\t\tif err != nil {\n391|\t\t\treturn err\n392|\t\t}\n393|\t\tif written == 0 {\n394|\t\t\treturn io.ErrShortWrite\n395|\t\t}\n396|\t\tdocument = document[written:]\n397|\t}\n398|\treturn nil\n399|}\n400|\n401|func syncDirectory(filesystem migrationFileSystem, directory string) error {\n402|\thandle, err := filesystem.OpenDirectory(directory)\n403|\tif err != nil {\n404|\t\treturn err\n405|\t}\n406|\tif err := handle.Sync(); err != nil {\n407|\t\t_ = handle.Close()\n408|\t\treturn err\n409|\t}\n410|\treturn handle.Close()\n411|}\n412|\n413|// Indirections keep compatibility-envelope parsing in this file while using\n414|// the same TOML implementation as Decode.\n415|var tomlDecode = func(document []byte, destination any) error {\n416|\treturn toml.Unmarshal(document, destination)\n417|}\n418|\n419|// migrationError is the only construction site for *MigrationError, for the\n420|// same reason loaderError is the only construction site for *Error.\n421|var migrationError = func(value MigrationError) error {\n422|\treturn &value\n423|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
