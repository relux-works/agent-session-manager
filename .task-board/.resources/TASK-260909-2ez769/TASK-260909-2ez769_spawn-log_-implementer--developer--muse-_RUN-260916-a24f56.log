{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c821","stream":{"kind":"session","id":"01a0aa3d-f870-72c3-b067-9f985ccf069d"},"sequence":619,"recorded_at":1780531400001233,"record_type":"event","durability":"durable","causation_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","run_stream":{"kind":"run","id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01"},"task_stream":{"kind":"task","id":"01a0aa3f-a165-7702-8930-154cc7187c71"},"task_id":"01a0aa3f-a165-7702-8930-154cc7187c71","event":{"kind":"output","task_id":"01a0aa3f-a165-7702-8930-154cc7187c71","chunk":"Read text file `internal/hosttrust/custody.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"io\"\n6|\t\"io/fs\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|)\n10|\n11|const (\n12|\thostChannelDir  = \"host-channel\"\n13|\ttrustFileName   = \"trust.json\"\n14|\tlockFileName    = \"lock\"\n15|\tcredentialsDir  = \"credentials\"\n16|\tcertificateFile = \"certificate.pem\"\n17|\tprivateKeyFile  = \"private-key.pem\"\n18|\trootFile        = \"root.pem\"\n19|\tstagePrefix     = \".trust-stage-\"\n20|)\n21|\n22|// FileSystem abstracts durable writes so crash and fault paths are testable\n23|// without touching the operator disk. The OS implementation is the only\n24|// production backend.\n25|type FileSystem interface {\n26|\tCreateTemp(dir, pattern string, mode fs.FileMode) (StagedFile, error)\n27|\tReadFile(name string) ([]byte, error)\n28|\tLstat(name string) (fs.FileInfo, error)\n29|\tStat(name string) (fs.FileInfo, error)\n30|\tRemove(name string) error\n31|\tRename(oldname, newname string) error\n32|\tMkdirAll(path string, mode fs.FileMode) error\n33|\tChmod(name string, mode fs.FileMode) error\n34|\tOpenDirectory(name string) (SyncedDirectory, error)\n35|\tReadDir(name string) ([]fs.DirEntry, error)\n36|}\n37|\n38|// StagedFile is one temp staging file awaiting fsync and atomic rename.\n39|type StagedFile interface {\n40|\tio.Writer\n41|\tName() string\n42|\tChmod(fs.FileMode) error\n43|\tSync() error\n44|\tClose() error\n45|}\n46|\n47|// SyncedDirectory fsyncs a directory entry after renames.\n48|type SyncedDirectory interface {\n49|\tSync() error\n50|\tClose() error\n51|}\n52|\n53|type osFileSystem struct{}\n54|\n55|func (osFileSystem) CreateTemp(dir, pattern string, mode fs.FileMode) (StagedFile, error) {\n56|\tfile, err := os.CreateTemp(dir, pattern)\n57|\tif err != nil {\n58|\t\treturn nil, err\n59|\t}\n60|\tif err := file.Chmod(mode); err != nil {\n61|\t\t_ = file.Close()\n62|\t\t_ = os.Remove(file.Name())\n63|\t\treturn nil, err\n64|\t}\n65|\treturn file, nil\n66|}\n67|\n68|func (osFileSystem) ReadFile(name string) ([]byte, error)   { return os.ReadFile(name) }\n69|func (osFileSystem) Lstat(name string) (fs.FileInfo, error) { return os.Lstat(name) }\n70|func (osFileSystem) Stat(name string) (fs.FileInfo, error)  { return os.Stat(name) }\n71|func (osFileSystem) Remove(name string) error               { return os.Remove(name) }\n72|func (osFileSystem) Rename(oldname, newname string) error   { return os.Rename(oldname, newname) }\n73|\n74|func (osFileSystem) MkdirAll(path string, mode fs.FileMode) error { return os.MkdirAll(path, mode) }\n75|func (osFileSystem) Chmod(name string, mode fs.FileMode) error    { return os.Chmod(name, mode) }\n76|\n77|func (osFileSystem) OpenDirectory(name string) (SyncedDirectory, error) { return os.Open(name) }\n78|func (osFileSystem) ReadDir(name string) ([]fs.DirEntry, error)         { return os.ReadDir(name) }\n79|\n80|// Store is machine-local Host Channel authority rooted at\n81|// STATE_DIR/host-channel. The zero value is unusable; construct with Open.\n82|type Store struct {\n83|\troot string\n84|\tfs   FileSystem\n85|\tlock *fileLock\n86|}\n87|\n88|// Open validates owner-only custody of STATE_DIR/host-channel, creating the\n89|// directory skeleton with exact 0700/0600 modes when absent. Every open\n90|// re-verifies custody: symlink escapes, foreign ownership and group/world\n91|// access refuse with ErrTrustUnsafeCustody.\n92|func Open(stateDir string) (*Store, error) { return openStore(stateDir, osFileSystem{}) }\n93|\n94|func openStore(stateDir string, filesystem FileSystem) (*Store, error) {\n95|\tif filesystem == nil {\n96|\t\treturn nil, trustError(TrustError{Operation: \"open store\", Err: ErrInvalidStoreContext})\n97|\t}\n98|\tif !filepath.IsAbs(stateDir) {\n99|\t\treturn nil, trustError(TrustError{Operation: \"open store\", Err: ErrInvalidStoreContext})\n100|\t}\n101|\troot := filepath.Join(stateDir, hostChannelDir)\n102|\tif err := ensureOwnerDir(filesystem, root, 0o700); err != nil {\n103|\t\treturn nil, err\n104|\t}\n105|\tif err := ensureOwnerDir(filesystem, filepath.Join(root, credentialsDir), 0o700); err != nil {\n106|\t\treturn nil, err\n107|\t}\n108|\tlock, err := openLock(filesystem, filepath.Join(root, lockFileName))\n109|\tif err != nil {\n110|\t\treturn nil, err\n111|\t}\n112|\tstore := &Store{root: root, fs: filesystem, lock: lock}\n113|\t// Converge one interrupted joint config-plus-trust commit, if any: a\n114|\t// crash between the configuration replacement and the generation bump\n115|\t// must complete forward or abort on restart, never admit the new\n116|\t// configuration with the old generation. A refused recovery fails the\n117|\t// open so incoherent state cannot be used.\n118|\tif _, err := store.Recover(); err != nil {\n119|\t\treturn nil, err\n120|\t}\n121|\treturn store, nil\n122|}\n123|\n124|// Root reports the validated host-channel directory. It carries no secrets.\n125|func (store *Store) Root() string { return store.root }\n126|\n127|// TrustPath reports the trust.json path for operator diagnostics. Reading or\n128|// writing it directly bypasses the authorization lock; use transactions.\n129|func (store *Store) TrustPath() string { return filepath.Join(store.root, trustFileName) }\n130|\n131|// CredentialDir reports the custody directory for one credential ID hex. It\n132|// carries no key material.\n133|func (store *Store) CredentialDir(credentialHex string) (string, error) {\n134|\tif len(credentialHex) != 64 {\n135|\t\treturn \"\", trustError(TrustError{Operation: \"resolve credential directory\", Err: ErrCredentialCustody})\n136|\t}\n137|\tfor _, unit := range credentialHex {\n138|\t\tif (unit < '0' || unit > '9') && (unit < 'a' || unit > 'f') {\n139|\t\t\treturn \"\", trustError(TrustError{Operation: \"resolve credential directory\", Err: ErrCredentialCustody})\n140|\t\t}\n141|\t}\n142|\treturn filepath.Join(store.root, credentialsDir, credentialHex), nil\n143|}\n144|\n145|func ensureOwnerDir(filesystem FileSystem, path string, mode fs.FileMode) error {\n146|\tinfo, err := filesystem.Lstat(path)\n147|\tif err != nil && !os.IsNotExist(err) {\n148|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n149|\t}\n150|\tif err == nil {\n151|\t\t// An existing directory is verified, never repaired: silently\n152|\t\t// narrowing a widened directory would mask the custody violation.\n153|\t\treturn verifyOwnerDir(path, info, mode)\n154|\t}\n155|\tif err := filesystem.MkdirAll(path, mode); err != nil {\n156|\t\treturn trustError(TrustError{Operation: \"create directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n157|\t}\n158|\t// MkdirAll honors umask, so the exact owner-only mode is enforced\n159|\t// explicitly after creation.\n160|\tif err := filesystem.Chmod(path, mode); err != nil {\n161|\t\treturn trustError(TrustError{Operation: \"create directory\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n162|\t}\n163|\t// On platforms where mode bits do not govern access, install the\n164|\t// owner-only ACL at creation: verification below would otherwise\n165|\t// refuse the directory the store just created.\n166|\tif err := secureStaged(path, true); err != nil {\n167|\t\treturn err\n168|\t}\n169|\tinfo, err = filesystem.Lstat(path)\n170|\tif err != nil {\n171|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n172|\t}\n173|\treturn verifyOwnerDir(path, info, mode)\n174|}\n175|\n176|func verifyOwnerDir(path string, info fs.FileInfo, mode fs.FileMode) error {\n177|\tif !info.IsDir() {\n178|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: ErrTrustUnsafeCustody})\n179|\t}\n180|\tif info.Mode()&fs.ModeSymlink != 0 {\n181|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: ErrTrustUnsafeCustody})\n182|\t}\n183|\t// Permission bits are a Unix signal only: on Windows the DACL governs and\n184|\t// Go synthesizes mode bits from the read-only attribute, so an exact\n185|\t// comparison would refuse every Windows path. verifyOwner enforces the\n186|\t// owner-only DACL there.\n187|\tif !platformModeOK(info, mode) {\n188|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: ErrTrustUnsafeCustody})\n189|\t}\n190|\treturn verifyOwner(path, info)\n191|}\n192|\n193|func verifyOwnerFile(path string, info fs.FileInfo, mode fs.FileMode) error {\n194|\tif !info.Mode().IsRegular() {\n195|\t\treturn trustError(TrustError{Operation: \"inspect file\", Err: ErrTrustUnsafeCustody})\n196|\t}\n197|\tif info.Mode()&fs.ModeSymlink != 0 {\n198|\t\treturn trustError(TrustError{Operation: \"inspect file\", Err: ErrTrustUnsafeCustody})\n199|\t}\n200|\tif !platformModeOK(info, mode) {\n201|\t\treturn trustError(TrustError{Operation: \"inspect file\", Err: ErrTrustUnsafeCustody})\n202|\t}\n203|\treturn verifyOwner(path, info)\n204|}","final_result":true}}}
