n56|  preview,err:=PreviewV4(inputs,nil,snap,self,nil,now);if err!=nil{t.Fatal(err)}\n57|  _,err=applyV4(inputs,nil,preview,true,now,reviewerCrashFS{target:filename},hosttrust.Open)\n58|  t.Fatalf(\"crash seam not reached: %v\",err)\n59| }\n60| fixture:=setupV4Fixture(t,testPeerID)\n61| before:=fixture.trust(t).Generation\n62| command:=exec.Command(os.Args[0],\"-test.run=^TestReviewerCrashReopenConverges$\")\n63| command.Env=append(os.Environ(),\"AX_REVIEW_REOPEN_FIXTURE=\"+fixture.directory)\n64| output,err:=command.CombinedOutput()\n65| exit,ok:=err.(*exec.ExitError);if !ok||exit.ExitCode()!=77{t.Fatalf(\"child did not crash at seam: %v %s\",err,output)}\n66| loaded,err:=Load(fixture.inputs,nil);if err!=nil{t.Fatal(err)}\n67| configuration,ok:=loaded.Configuration();if !ok{t.Fatal(\"missing config\")}\n68| reopened,err:=hosttrust.Open(fixture.stateDir);if err!=nil{t.Fatal(err)}\n69| snap,err:=reopened.ReadSnapshot();if err!=nil{t.Fatal(err)}\n70| if configuration.SourceVersion==Version4 && snap.Generation==before {t.Fatalf(\"restart admits new Config4 with old generation %d after child exit 77\",before)}\n71|}\n72|\n73|func TestReviewerRollbackCrashSurvivingReader(t *testing.T) {\n74| if dir:=os.Getenv(\"AX_REVIEW_ROLLBACK_FIXTURE\");dir!=\"\" {\n75|  filename:=filepath.Join(dir,\"config.toml\")\n76|  state:=filepath.Join(dir,\"state\")\n77|  inputs:=Inputs{Platform:scalar.PlatformMacOS,HomeDir:dir,TempDir:dir,WorkingDir:dir,Stat:os.Stat,ReadFile:os.ReadFile,LookupEnv:func(k string)(string,bool){if k==\"AX_CONFIG\"{return filename,true};if k==\"AX_STATE_DIR\"{return state,true};return \"\",false}}\n78|  store,err:=hosttrust.Open(state);if err!=nil{t.Fatal(err)}\n79|  snap,err:=store.ReadSnapshot();if err!=nil{t.Fatal(err)}\n80|  _ = snap\n81|  _,err=rollbackV4(inputs,nil,RollbackV4Options{AcknowledgeNoHostChannelAssurance:true},reviewerCrashFS{target:filename},hosttrust.Open)\n82|  t.Fatalf(\"crash seam not reached: %v\",err)\n83| }\n84| fixture:=setupV4Fixture(t,testPeerID)\n85| preview,err:=PreviewV4(fixture.inputs,nil,fixture.trust(t),fixture.self,nil,fixture.now);if err!=nil{t.Fatal(err)}\n86| if _,err:=ApplyV4(fixture.inputs,nil,preview,true,fixture.now);err!=nil{t.Fatal(err)}\n87| before:=fixture.trust(t).Generation\n88| command:=exec.Command(os.Args[0],\"-test.run=^TestReviewerRollbackCrashSurvivingReader$\")\n89| command.Env=append(os.Environ(),\"AX_REVIEW_ROLLBACK_FIXTURE=\"+fixture.directory)\n90| output,err:=command.CombinedOutput()\n91| exit,ok:=err.(*exec.ExitError);if !ok||exit.ExitCode()!=77{t.Fatalf(\"child did not crash at seam: %v %s\",err,output)}\n92| coherent,err:=LoadCoherent(fixture.inputs,nil,fixture.store)\n93| if err==nil && coherent.Generation==before { t.Fatalf(\"surviving Store admits new config with old generation %d\",before) }\n94| loaded,err:=Load(fixture.inputs,nil);if err!=nil{t.Fatal(err)}\n95| configuration,ok:=loaded.Configuration();if !ok{t.Fatal(\"missing configuration\")}\n96| reopened,err:=hosttrust.Open(fixture.stateDir);if err!=nil{t.Fatal(err)}\n97| snap,err:=reopened.ReadSnapshot();if err!=nil{t.Fatal(err)}\n98| if configuration.SourceVersion==Version4 && snap.Generation==before {t.Fatalf(\"restart admits new Config4 with old generation %d after child exit 77\",before)}\n99|}\n100|","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c697","stream":{"kind":"session","id":"01a0aa3d-f870-72c3-b067-9f985ccf069d"},"sequence":422,"recorded_at":1780531400000839,"record_type":"event","durability":"durable","causation_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","run_stream":{"kind":"run","id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01"},"call_id":"call_01a0aa3f1c0072eda801e6b0e88207b9","text":"Read text file `/tmp/rev4/probes/reviewer_lock_test.go`.\n1|package hosttrust\n2|\n3|import (\n4| \"io/fs\"\n5| \"os\"\n6| \"os/exec\"\n7| \"path/filepath\"\n8| \"testing\"\n9| \"time\"\n10|)\n11|\n12|type reviewerInitFS struct { osFileSystem; dir string }\n13|func (f reviewerInitFS) Lstat(path string)(fs.FileInfo,error){\n14| info,err:=f.osFileSystem.Lstat(path)\n15| if filepath.Base(path)==lockFileName && os.IsNotExist(err){\n16|  if e:=os.WriteFile(filepath.Join(f.dir,\"observed\"),[]byte(\"ready\"),0600);e!=nil{panic(e)}\n17|  deadline:=time.Now().Add(5*time.Second)\n18|  for {if _,e:=os.Stat(filepath.Join(f.dir,\"continue\"));e==nil{break}; if time.Now().After(deadline){panic(\"barrier timed out\")};time.Sleep(5*time.Millisecond)}\n19| }\n20| return info,err\n21|}\n22|func TestReviewerCrossProcessLockInitialization(t *testing.T){\n23| if dir:=os.Getenv(\"AX_REVIEW_LOCK_INIT\");dir!=\"\" {\n24|  if _,err:=openStore(dir,reviewerInitFS{dir:dir});err!=nil{t.Fatal(err)}\n25|  return\n26| }\n27| dir:=t.TempDir()\n28| cmd:=exec.Command(os.Args[0],\"-test.run=^TestReviewerCrossProcessLockInitialization$\",\"-test.timeout=10s\")\n29| cmd.Env=append(os.Environ(),\"AX_REVIEW_LOCK_INIT=\"+dir)\n30| if err:=cmd.Start();err!=nil{t.Fatal(err)}\n31| defer func(){_ = cmd.Process.Kill()}()\n32| deadline:=time.Now().Add(5*time.Second)\n33| for {if _,err:=os.Stat(filepath.Join(dir,\"observed\"));err==nil{break};if time.Now().After(deadline){t.Fatal(\"child did not reach absent-lock barrier\")};time.Sleep(5*time.Millisecond)}\n34| store,err:=Open(dir);if err!=nil{t.Fatal(err)}\n35| if _,err:=store.Initialize();err!=nil{t.Fatal(err)}\n36| release,err:=store.lock.exclusive();if err!=nil{t.Fatal(err)}\n37| old,err:=os.Stat(store.lock.path);if err!=nil{t.Fatal(err)}\n38| if err:=os.WriteFile(filepath.Join(dir,\"continue\"),[]byte(\"go\"),0600);err!=nil{t.Fatal(err)}\n39| done:=make(chan error,1);go func(){done<-cmd.Wait()}()\n40| var early bool\n41| select{case err= <-done:early=true;case <-time.After(300*time.Millisecond):}\n42| release()\n43| if !early{err= <-done}\n44| if err!=nil{t.Fatal(err)}\n45| fresh,err:=os.Stat(store.lock.path);if err!=nil{t.Fatal(err)}\n46| if early || !os.SameFile(old,fresh){t.Fatalf(\"concurrent Open replaced held authorization lock: returnedWhileHeld=%v sameInode=%v\",early,os.SameFile(old,fresh))}\n47|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
