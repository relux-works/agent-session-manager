{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb0b","stream":{"kind":"session","id":"01a0aa3d-f870-72c3-b067-9f985ccf069d"},"sequence":992,"recorded_at":1780531400001979,"record_type":"event","durability":"durable","causation_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","run_stream":{"kind":"run","id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01"},"task_stream":{"kind":"task","id":"01a0aa40-ac9f-7eb3-917e-89a975c606b3"},"task_id":"01a0aa40-ac9f-7eb3-917e-89a975c606b3","event":{"kind":"output","task_id":"01a0aa40-ac9f-7eb3-917e-89a975c606b3","chunk":"Read text file `internal/hosttrust/lifecycle_test.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"crypto/x509\"\n5|\t\"errors\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"testing\"\n9|\t\"time\"\n10|)\n11|\n12|func setupStoreForTest(t *testing.T) *Store {\n13|\tt.Helper()\n14|\tstore := openForTest(t, t.TempDir())\n15|\tif _, err := store.Initialize(); err != nil {\n16|\t\tt.Fatalf(\"Initialize error = %v\", err)\n17|\t}\n18|\treturn store\n19|}\n20|\n21|// enrollPeerForTest runs the explicit out-of-band flow: the issuer issues\n22|// locally, exports selected public material, and the operator authorizes the\n23|// observed tuple in the enrolling store after independent verification.\n24|func enrollPeerForTest(t *testing.T, store *Store, issuer *Store, hostID string, at time.Time) string {\n25|\tt.Helper()\n26|\tpeerCredential, err := issuer.Issue(hostID, at)\n27|\tif err != nil {\n28|\t\tt.Fatalf(\"peer Issue error = %v\", err)\n29|\t}\n30|\tpeerSnapshot, err := issuer.ReadSnapshot()\n31|\tif err != nil {\n32|\t\tt.Fatalf(\"peer ReadSnapshot error = %v\", err)\n33|\t}\n34|\tmaterial, err := ExportEnrollment(peerSnapshot, peerCredential)\n35|\tif err != nil {\n36|\t\tt.Fatalf(\"ExportEnrollment error = %v\", err)\n37|\t}\n38|\tif len(material.LeafDER) == 0 || len(material.RootDER) == 0 {\n39|\t\tt.Fatal(\"ExportEnrollment returned empty public bytes\")\n40|\t}\n41|\t// The operator verifies the tuple over the independent channel; the test\n42|\t// models a correct verification by authorizing the observed fingerprints.\n43|\tenrolled, err := store.Enroll(EnrollInput{\n44|\t\tHostID:     material.HostID,\n45|\t\tLeafDER:    material.LeafDER,\n46|\t\tRootDER:    material.RootDER,\n47|\t\tAuthorized: material.Fingerprints,\n48|\t\tEnrolledAt: at,\n49|\t})\n50|\tif err != nil {\n51|\t\tt.Fatalf(\"Enroll error = %v\", err)\n52|\t}\n53|\tif enrolled != peerCredential {\n54|\t\tt.Fatalf(\"Enroll = %s, want %s\", enrolled, peerCredential)\n55|\t}\n56|\treturn enrolled\n57|}\n58|\n59|func TestIssueSelfEnrollsActive(t *testing.T) {\n60|\tstore := setupStoreForTest(t)\n(more lines below)","final_result":true}}}
