{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c87b","stream":{"kind":"session","id":"01a0aa3d-f870-72c3-b067-9f985ccf069d"},"sequence":664,"recorded_at":1780531400001323,"record_type":"event","durability":"durable","causation_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","run_stream":{"kind":"run","id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01"},"task_stream":{"kind":"task","id":"01a0aa3f-b1c1-7432-a331-07d78144117c"},"task_id":"01a0aa3f-b1c1-7432-a331-07d78144117c","event":{"kind":"output","task_id":"01a0aa3f-b1c1-7432-a331-07d78144117c","chunk":"Read text file `internal/hosttrust/custody_windows.go`.\n1|//go:build windows\n2|\n3|package hosttrust\n4|\n5|import (\n6|\t\"encoding/binary\"\n7|\t\"errors\"\n8|\t\"io/fs\"\n9|\t\"os/user\"\n10|\t\"unsafe\"\n11|\n12|\t\"golang.org/x/sys/windows\"\n13|)\n14|\n15|// platformModeOK always holds on Windows: Go synthesizes mode bits from the\n16|// read-only attribute, so an exact comparison would refuse every path. The\n17|// owner-only DACL governs instead and is enforced by verifyOwner below.\n18|func platformModeOK(_ fs.FileInfo, _ fs.FileMode) bool { return true }\n19|\n20|// secureStaged installs the owner-only DACL on a newly created path. Staging\n21|// files and directories inherit the parent ACL by default, which typically\n22|// grants SYSTEM and Administrators: without this step every file the store\n23|// creates would fail its own verification below.\n24|func secureStaged(path string, dir bool) error {\n25|\tif err := installOwnerOnlyACL(path, dir); err != nil {\n26|\t\treturn trustError(TrustError{Operation: \"secure custody\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n27|\t}\n28|\treturn nil\n29|}\n30|\n31|// verifyOwner enforces owner-only custody on Windows: reparse-point escapes\n32|// refuse, the file owner SID must equal the process user SID, and the DACL\n33|// must grant access exclusively to that owner. Ownership alone does not\n34|// establish grants, so every allow entry is audited, including inherited\n35|// ones: a parent that grants SYSTEM, Administrators or any other principal\n36|// refuses until the operator removes the grant. A null DACL (full access\n37|// for everyone) and an empty or deny-only DACL (unusable) refuse as well.\n38|func verifyOwner(path string, info fs.FileInfo) error {\n39|\tif info.Mode()&fs.ModeSymlink != 0 {\n40|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: ErrTrustUnsafeCustody})\n41|\t}\n42|\tname, err := windows.UTF16PtrFromString(path)\n43|\tif err != nil {\n44|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n45|\t}\n46|\tattributes, err := windows.GetFileAttributes(name)\n47|\tif err != nil {\n48|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n49|\t}\n50|\tif attributes&windows.FILE_ATTRIBUTE_REPARSE_POINT != 0 {\n51|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: ErrTrustUnsafeCustody})\n52|\t}\n53|\tcurrent, err := user.Current()\n54|\tif err != nil {\n55|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n56|\t}\n57|\tuserSID, err := windows.StringToSid(current.Uid)\n58|\tif err != nil {\n59|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n60|\t}\n61|\tdescriptor, err := windows.GetNamedSecurityInfo(path, windows.SE_FILE_OBJECT, windows.OWNER_SECURITY_INFORMATION|windows.DACL_SECURITY_INFORMATION)\n62|\tif err != nil {\n63|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n64|\t}\n65|\towner, _, err := descriptor.Owner()\n66|\tif err != nil {\n67|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n68|\t}\n69|\tif owner == nil || !owner.Equals(userSID) {\n70|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: ErrTrustUnsafeCustody})\n71|\t}\n72|\tdacl, _, err := descriptor.DACL()\n73|\tif err != nil {\n74|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n75|\t}\n76|\tif dacl == nil {\n77|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: ErrTrustUnsafeCustody})\n78|\t}\n79|\taces, err := extractAllowedACEs(dacl)\n80|\tif err != nil {\n81|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n82|\t}\n83|\tif !ownerOnlyGrants(owner.String(), aces) {\n84|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: ErrTrustUnsafeCustody})\n85|\t}\n86|\treturn nil\n87|}\n88|\n89|// extractAllowedACEs translates the native DACL into the platform-independent\n90|// audit shape. Unknown entry types fail closed through aceOther.\n91|func extractAllowedACEs(dacl *windows.ACL) ([]allowedACE, error) {\n92|\tvar aces []allowedACE\n93|\tfor index := uint32(0); index < uint32(dacl.AceCount); index++ {\n94|\t\tvar raw *windows.ACCESS_ALLOWED_ACE\n95|\t\tif err := windows.GetAce(dacl, index, &raw); err != nil {\n96|\t\t\treturn nil, err\n97|\t\t}\n98|\t\tif raw == nil {\n99|\t\t\treturn nil, errors.New(\"absent access entry\")\n100|\t\t}\n101|\t\tswitch raw.Header.AceType {\n102|\t\tcase windows.ACCESS_DENIED_ACE_TYPE:\n103|\t\t\taces = append(aces, allowedACE{kind: aceDeny})\n104|\t\t\tcontinue\n105|\t\tcase windows.ACCESS_ALLOWED_ACE_TYPE:\n106|\t\tdefault:\n107|\t\t\taces = append(aces, allowedACE{kind: aceOther})\n108|\t\t\tcontinue\n109|\t\t}\n110|\t\tsid := (*windows.SID)(unsafe.Pointer(&raw.SidStart))\n111|\t\taces = append(aces, allowedACE{kind: aceAllow, sid: sid.String()})\n112|\t}\n113|\treturn aces, nil\n114|}\n115|\n116|// installOwnerOnlyACL replaces the DACL with one protected owner-only grant:\n117|// full access for the process user SID and nothing for anyone else. The\n118|// protected flag blocks inherited grants from the parent, which otherwise\n119|// reintroduce SYSTEM and Administrators. Directory grants carry container\n120|// and object inheritance so paths the store creates later start owner-only\n121|// too; every creation is still verified explicitly after install.\n122|func installOwnerOnlyACL(path string, dir bool) error {\n123|\tcurrent, err := user.Current()\n124|\tif err != nil {\n125|\t\treturn err\n126|\t}\n127|\tsid, err := windows.StringToSid(current.Uid)\n128|\tif err != nil {\n129|\t\treturn err\n130|\t}\n131|\tsidLen := windows.GetLengthSid(sid)\n132|\taceSize := uint16(8 + sidLen)\n133|\tbuffer := make([]byte, 8+int(aceSize))\n134|\tbuffer[0] = 2 // ACL_REVISION\n135|\tbinary.LittleEndian.PutUint16(buffer[2:], 8+aceSize)\n136|\tbinary.LittleEndian.PutUint16(buffer[4:], 1)\n137|\tbuffer[8] = windows.ACCESS_ALLOWED_ACE_TYPE\n138|\tif dir {\n139|\t\tbuffer[9] = windows.OBJECT_INHERIT_ACE | windows.CONTAINER_INHERIT_ACE\n140|\t}\n141|\tbinary.LittleEndian.PutUint16(buffer[10:], aceSize)\n142|\tbinary.LittleEndian.PutUint32(buffer[12:], uint32(windows.GENERIC_ALL))\n143|\tdestination := (*windows.SID)(unsafe.Pointer(&buffer[16]))\n144|\tif err := windows.CopySid(sidLen, destination, sid); err != nil {\n145|\t\treturn err\n146|\t}\n147|\tacl := (*windows.ACL)(unsafe.Pointer(&buffer[0]))\n148|\treturn windows.SetNamedSecurityInfo(path, windows.SE_FILE_OBJECT,\n149|\t\twindows.DACL_SECURITY_INFORMATION|windows.PROTECTED_DACL_SECURITY_INFORMATION,\n150|\t\tnil, nil, acl, nil)\n151|}","final_result":true}}}
