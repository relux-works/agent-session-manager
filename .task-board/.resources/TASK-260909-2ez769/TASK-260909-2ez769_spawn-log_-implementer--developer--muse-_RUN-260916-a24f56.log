, \"TestRevalidateApplyV4PreviewMismatch\"),\n19| (\"confirm-drops\", APPLY, \"if !confirm {\", \"if !confirm && len(preview.DroppedPeers) == 0 {\", \"Admits exactly unconfirmed previews that drop peers\", \"TestApplyV4ConfirmRequiredWithDrops\"),\n20| (\"apply-gen-direction\", APPLY, 'if current.Generation != preview.SourceGeneration {\\n\\t\\treturn migrationError(MigrationError{Operation: \"validate preview generation\", Err: ErrMigrationV4StaleGeneration})', 'if current.Generation < preview.SourceGeneration {\\n\\t\\treturn migrationError(MigrationError{Operation: \"validate preview generation\", Err: ErrMigrationV4StaleGeneration})', \"Admits newer generations into the in-lock apply revalidation\", \"TestRevalidateApplyV4StaleGeneration\"),\n21| (\"v4-explicit-label\", MIGRATION, 'migrationError(MigrationError{Operation: \"select target\", Err: ErrMigrationV4Explicit})', 'migrationError(MigrationError{Operation: \"select target\", Err: ErrMigrationTarget})', \"LABEL-PRECISION, not a semantic admission: mislabels the explicit-preview refusal; named test pins the exact error\", \"TestMigrateRefusesV4Target\"),\n22|]\n23|\n24|BOUNDS = {\n25| \"neutral\": \"Equivalent arithmetic; no independent kill claimed.\",\n26|}\n27|\n28|def main():\n29|    parser = argparse.ArgumentParser(description=__doc__)\n30|    parser.add_argument(\"--output\", required=True)\n31|    parser.add_argument(\"--only\", help=\"Comma-separated probe names for a bounded follow-up\")\n32|    opts = parser.parse_args()\n33|    if opts.only and not set(opts.only.split(\",\")).issubset({p[0] for p in PROBES}):\n34|        parser.error(\"--only contains an unknown probe\")\n35|    out = Path(opts.output).resolve()\n36|    out.mkdir(parents=True, exist_ok=True)\n37|    results = []\n38|    unexpected = False\n39|    for name, path, old, new, narrows, expected_test in PROBES:\n40|        if opts.only and name not in opts.only.split(\",\"):\n41|            continue\n42|        source = ROOT / path\n43|        original = source.read_bytes()\n44|        text = original.decode()\n45|        if text.count(old) != 1:\n46|            raise RuntimeError(f\"{name}: plant must match exactly once, got {text.count(old)}\")\n47|        folder = out / name\n48|        folder.mkdir(exist_ok=True)\n49|        replacement = folder / source.name\n50|        replacement.write_text(text.replace(old, new, 1))\n51|        overlay = folder / \"overlay.json\"\n52|        overlay.write_text(json.dumps({\"Replace\": {str(source): str(replacement)}}))\n53|        command = [\"go\", \"test\", \"-overlay\", str(overlay), \"./internal/config\", \"-count=1\", \"-json\", \"-timeout=120s\", \"-run\", TESTS]\n54|        proc = subprocess.run(command, cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=300)\n55|        (folder / \"test.log\").write_bytes(proc.stdout)\n56|        events = []\n57|        for line in proc.stdout.decode(errors=\"replace\").splitlines():\n58|            try:\n59|                events.append(json.loads(line))\n60|            except json.JSONDecodeError:\n61|                pass\n62|        failed = [e[\"Test\"] for e in events if e.get(\"Action\") == \"fail\" and \"Test\" in e]\n63|        passed = [e[\"Test\"] for e in events if e.get(\"Action\") == \"pass\" and \"Test\" in e]\n64|        killed = proc.returncode != 0 and bool(failed) and (expected_test is None or expected_test in failed)\n65|        if name == \"neutral\":\n66|            valid = proc.returncode == 0 and bool(passed)\n67|            state = \"neutral passed\" if valid else \"invalid control\"\n68|        elif name in BOUNDS:\n69|            valid = proc.returncode == 0 and bool(passed)\n70|            state = \"survived\" if valid else \"unexpected result\"\n71|        else:\n72|            valid = killed\n73|            state = \"killed\" if killed else \"survived\" if proc.returncode == 0 and passed else \"invalid instrument/compile failure\"\n74|        if not valid:\n75|            unexpected = True\n76|        if source.read_bytes() != original:\n77|            raise RuntimeError(f\"{name}: source changed during overlay run\")\n78|        row = {\"mutant\": name, \"narrowing\": narrows, \"exit_code\": proc.returncode, \"result\": state,\n79|               \"named_failing_tests\": failed, \"expected_test\": expected_test,\n80|               \"bound\": BOUNDS.get(name, \"\" if killed or name == \"neutral\" else \"No named failing test established; this gate member is unproven.\"),\n81|               \"command\": command}\n82|        results.append(row)\n83|        print(f\"{name}: {state}, exit={proc.returncode}, tests={','.join(failed)}\", flush=True)\n84|        (out / \"results.json\").write_text(json.dumps(results, indent=2) + \"\\n\")\n85|    rows = [\"| Mutant | What the gate is narrowed to admit | Named failing test | Exit | Result / surviving bound |\",\n86|            \"| --- | --- | --- | ---: | --- |\"]\n87|    for r in results:\n88|        tests = r[\"expected_test\"] if r[\"expected_test\"] in r[\"named_failing_tests\"] else \", \".join(r[\"named_failing_tests\"])\n89|        rows.append(f'| {r[\"mutant\"]} | {r[\"narrowing\"]} | {tests or \"none\"} | {r[\"exit_code\"]} | {r[\"result\"]}: {r[\"bound\"]} |')\n90|    (out / \"table.md\").write_text(\"\\n\".join(rows)+\"\\n\")\n91|    return int(unexpected)\n92|\n93|\n94|if __name__ == \"__main__\":\n95|    sys.exit(main())","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
