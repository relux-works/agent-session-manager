{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c90b","stream":{"kind":"session","id":"01a0aa3d-f870-72c3-b067-9f985ccf069d"},"sequence":736,"recorded_at":1780531400001467,"record_type":"event","durability":"durable","causation_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","run_stream":{"kind":"run","id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01"},"task_stream":{"kind":"task","id":"01a0aa3f-cd89-71b0-8e0d-4a9b23a8bd24"},"task_id":"01a0aa3f-cd89-71b0-8e0d-4a9b23a8bd24","event":{"kind":"output","task_id":"01a0aa3f-cd89-71b0-8e0d-4a9b23a8bd24","chunk":"Read text file `internal/config/migration_v4_apply_test.go`.\n(379 line(s) above)\n380|\t\t\t}\n381|\t\t\treturn \"\", false\n382|\t\t}}\n383|\t\tstore, err := hosttrust.Open(state)\n384|\t\tif err != nil {\n385|\t\t\tt.Fatal(err)\n386|\t\t}\n387|\t\tsnapshot, err := store.ReadSnapshot()\n388|\t\tif err != nil {\n389|\t\t\tt.Fatal(err)\n390|\t\t}\n391|\t\tvar self string\n392|\t\tfor _, entry := range snapshot.Trust.Entries {\n393|\t\t\tif entry.HostID.String() == testHostID {\n394|\t\t\t\tself = entry.CredentialID.String()\n395|\t\t\t}\n396|\t\t}\n397|\t\tnow := time.Now().UTC()\n398|\t\tpreview, err := PreviewV4(inputs, nil, snapshot, self, nil, now)\n399|\t\tif err != nil {\n400|\t\t\tt.Fatal(err)\n401|\t\t}\n402|\t\t_, err = applyV4(inputs, nil, preview, true, now, crashAfterReplaceFileSystem{target: filename}, hosttrust.Open)\n403|\t\tt.Fatalf(\"crash seam not reached: %v\", err)\n404|\t}\n405|\tfixture := setupV4Fixture(t, testPeerID)\n406|\tbefore := fixture.trust(t).Generation\n407|\tcommand := exec.Command(os.Args[0], \"-test.run=^TestApplyV4CrashConvergesGeneration$\")\n408|\tcommand.Env = append(os.Environ(), \"AX_V4_CRASH_FIXTURE=\"+fixture.directory)\n409|\toutput, err := command.CombinedOutput()\n410|\texit, ok := err.(*exec.ExitError)\n411|\tif !ok || exit.ExitCode() != 77 {\n412|\t\tt.Fatalf(\"child did not crash at the replacement seam: %v %s\", err, output)\n413|\t}\n414|\t// Restart recovery must converge the pair: admitting the new Config4\n415|\t// with the old generation fails the test.\n416|\tloaded, err := Load(fixture.inputs, nil)\n417|\tif err != nil {\n418|\t\treturn\n419|\t}\n420|\tconfiguration, ok := loaded.Configuration()\n421|\tif !ok {\n422|\t\treturn\n423|\t}\n424|\treopened, err := hosttrust.Open(fixture.stateDir)\n425|\tif err != nil {\n426|\t\treturn\n427|\t}\n428|\tsnapshot, err := reopened.ReadSnapshot()\n429|\tif err != nil {\n430|\t\treturn\n431|\t}\n432|\tif configuration.SourceVersion == Version4 && snapshot.Generation == before {\n433|\t\tt.Fatalf(\"restart admits new Config4 with old generation %d after child exit 77\", before)\n434|\t}\n435|\tif configuration.SourceVersion != Version4 || snapshot.Generation != before+1 {\n436|\t\tt.Fatalf(\"restart converged to version %q generation %d, want 4.0.0/%d\", configuration.SourceVersion, snapshot.Generation, before+1)\n437|\t}\n438|}\n439|\n440|func TestApplyV4MarkerStagingFailureAborts(t *testing.T) {\n441|\tif os.Geteuid() == 0 {\n442|\t\tt.Skip(\"permission-bit staging does not bind the superuser\")\n443|\t}\n444|\tfixture := setupV4Fixture(t, testPeerID)\n445|\tpreview, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now)\n446|\tif err != nil {\n447|\t\tt.Fatalf(\"PreviewV4 error = %v\", err)\n448|\t}\n449|\t// The joint marker cannot stage in an unwritable trust directory: the\n450|\t// commit aborts before the configuration is touched, with no marker\n451|\t// left behind. The store opens before the directory loses its write\n452|\t// bit, so the failure lands in the commit, not in the open.\n453|\tchannel := filepath.Join(fixture.stateDir, \"host-channel\")\n454|\tpreopened, err := hosttrust.Open(fixture.stateDir)\n455|\tif err != nil {\n456|\t\tt.Fatal(err)\n457|\t}\n458|\tif err := os.Chmod(channel, 0o500); err != nil {\n459|\t\tt.Fatal(err)\n460|\t}\n461|\tdefer func() { _ = os.Chmod(channel, 0o700) }()\n462|\topenHook := func(string) (*hosttrust.Store, error) { return preopened, nil }\n463|\tsource, err := os.ReadFile(fixture.filename)\n464|\tif err != nil {\n465|\t\tt.Fatal(err)\n466|\t}\n467|\tif _, err := applyV4(fixture.inputs, nil, preview, true, fixture.now, osMigrationFileSystem{}, openHook); err == nil {\n468|\t\tt.Fatal(\"ApplyV4(unwritable trust dir) succeeded, want failure\")\n469|\t} else if !errors.Is(err, hosttrust.ErrTrustDurability) {\n470|\t\tt.Fatalf(\"ApplyV4(staging) error = %v, want durability failure\", err)\n471|\t}\n472|\tafter, err := os.ReadFile(fixture.filename)\n473|\tif err != nil {\n474|\t\tt.Fatal(err)\n475|\t}\n476|\tif !bytes.Equal(after, source) {\n477|\t\tt.Fatal(\"aborted joint commit mutated the configuration\")\n478|\t}\n479|\tif _, err := os.Lstat(filepath.Join(channel, \"pending-commit.json\")); !os.IsNotExist(err) {\n480|\t\tt.Fatalf(\"joint marker remains after aborted commit: %v\", err)\n481|\t}\n482|}\n483|\n484|func TestApplyV4TrustCommitRecoveryFailure(t *testing.T) {\n485|\tfixture := setupV4Fixture(t, testPeerID)\n486|\tcrownTrustAtExhaustion(t, fixture)\n487|\tpreview, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now)\n488|\tif err != nil {\n489|\t\tt.Fatalf(\"PreviewV4 error = %v\", err)\n490|\t}\n491|\tif preview.SourceGeneration != hosttrust.MaxGeneration {\n492|\t\tt.Fatalf(\"preview generation = %d, want the exhausted ceiling\", preview.SourceGeneration)\n493|\t}\n494|\t// The config replacement succeeds but the generation bump is refused at\n495|\t// the uint53 ceiling, and the source restore fails too: the error must\n496|\t// report the compound failure, never silent success. Rename 1 installs\n497|\t// the replacement; rename 2 (the restore) is faulted.\n498|\tfailing := &faultMigrationFileSystem{failRenameCall: 2}\n499|\tif _, err := applyV4(fixture.inputs, nil, preview, true, fixture.now, failing, hosttrust.Open); err == nil {\n(more lines below)","final_result":true}}}
