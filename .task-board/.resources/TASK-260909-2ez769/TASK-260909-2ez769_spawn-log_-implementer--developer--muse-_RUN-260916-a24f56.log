{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c79f","stream":{"kind":"session","id":"01a0aa3d-f870-72c3-b067-9f985ccf069d"},"sequence":554,"recorded_at":1780531400001103,"record_type":"event","durability":"durable","causation_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","run_stream":{"kind":"run","id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01"},"call_id":"call_01a0aa3f8006716099dd66238f095691","text":"Read text file `internal/hosttrust/transact.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|)\n8|\n9|// Snapshot is one coherent committed read: trust bytes plus the generation\n10|// that authorized them. Streams and dispatches bind this generation; any use\n11|// must re-check currency before crossing a side-effect boundary.\n12|type Snapshot struct {\n13|\tGeneration uint64\n14|\tTrust      TrustStore\n15|}\n16|\n17|// TransactionFunc mutates a copy of the committed trust. Returning nil\n18|// commits with generation+1; returning an error aborts with no durable effect.\n19|type TransactionFunc func(trust *TrustStore) error\n20|\n21|// ReadSnapshot obtains one coherent committed snapshot under a shared lock.\n22|// A missing store is ErrTrustStoreMissing, never an empty store. Unreadable,\n23|// malformed or partially read state refuses; leftover staging files from\n24|// crashed commits are ignored and never selected.\n25|func (store *Store) ReadSnapshot() (Snapshot, error) {\n26|\treturn readSnapshot(store.fs, store.root, store.lock)\n27|}\n28|\n29|// WithSharedSnapshot runs fn under the shared authorization lock with the\n30|// committed trust, so a config-plus-trust pair observed inside fn is\n31|// coherent: no trust or config commit can land between the trust read and\n32|// fn's own reads. Callers must not acquire the lock again inside fn;\n33|// internal reads there use the supplied committed value directly.\n34|func (store *Store) WithSharedSnapshot(fn func(current TrustStore) error) error {\n35|\tunlock, err := store.lock.shared()\n36|\tif err != nil {\n37|\t\treturn trustError(TrustError{Operation: \"lock snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n38|\t}\n39|\tdefer unlock()\n40|\tsnapshot, err := readSnapshotLocked(store.fs, store.root)\n41|\tif err != nil {\n42|\t\treturn err\n43|\t}\n44|\tcommitted := snapshot.Trust\n45|\tif fn == nil {\n46|\t\treturn trustError(TrustError{Operation: \"read snapshot\", Err: ErrAuthorizationRefused})\n47|\t}\n48|\treturn fn(committed)\n49|}\n50|\n51|func readSnapshot(filesystem FileSystem, root string, lock *fileLock) (Snapshot, error) {\n52|\tunlock, err := lock.shared()\n53|\tif err != nil {\n54|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"lock snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n55|\t}\n56|\tdefer unlock()\n57|\treturn readSnapshotLocked(filesystem, root)\n58|}\n59|\n60|// readSnapshotLocked reads one coherent committed snapshot assuming the\n61|// caller already holds the shared or exclusive authorization lock.\n62|func readSnapshotLocked(filesystem FileSystem, root string) (Snapshot, error) {\n63|\tpath := filepath.Join(root, trustFileName)\n64|\tinfo, err := filesystem.Lstat(path)\n65|\tif err != nil {\n66|\t\tif os.IsNotExist(err) {\n67|\t\t\treturn Snapshot{}, trustError(TrustError{Operation: \"read snapshot\", Err: ErrTrustStoreMissing})\n68|\t\t}\n69|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"read snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n70|\t}\n71|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n72|\t\treturn Snapshot{}, err\n73|\t}\n74|\tdocument, err := filesystem.ReadFile(path)\n75|\tif err != nil {\n76|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"read snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n77|\t}\n78|\tstore, err := DecodeTrust(document)\n79|\tif err != nil {\n80|\t\treturn Snapshot{}, err\n81|\t}\n82|\treturn Snapshot{Generation: store.Generation, Trust: store}, nil\n83|}\n84|\n85|// Initialize creates the explicit empty generation-1 store. It refuses when\n86|// trust.json already exists: setup never overwrites committed authority.\n87|func (store *Store) Initialize() (Snapshot, error) {\n88|\tunlock, err := store.lock.exclusive()\n89|\tif err != nil {\n90|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"lock initialize\", Err: errors.Join(ErrTrustDurability, err)})\n91|\t}\n92|\tdefer unlock()\n93|\tpath := filepath.Join(store.root, trustFileName)\n94|\tif _, err := store.fs.Lstat(path); err == nil {\n95|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"initialize store\", Err: ErrTrustDurability})\n96|\t} else if !os.IsNotExist(err) {\n97|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"initialize store\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n98|\t}\n99|\tdocument, err := EncodeTrust(TrustStore{Generation: 1})\n100|\tif err != nil {\n101|\t\treturn Snapshot{}, err\n102|\t}\n103|\tif err := commitDocument(store.fs, store.root, path, document); err != nil {\n104|\t\treturn Snapshot{}, err\n105|\t}\n106|\t// The exclusive lock is still held: read without re-acquiring, since a\n107|\t// second acquisition in this goroutine would block on the held lock.\n108|\treturn readSnapshotLocked(store.fs, store.root)\n109|}\n110|\n111|// transact runs one crash-durable generation transaction under the exclusive\n112|// cross-process lock: load committed state, apply fn, encode, stage with\n113|// fsync, atomic rename, directory fsync. A missing store refuses with\n114|// ErrTrustStoreMissing: only explicit Initialize commits generation 1. Any\n115|// other malformed state refuses before fn runs.\n116|func (store *Store) transact(fn TransactionFunc) error {\n117|\treturn transact(store.fs, store.root, store.lock, fn)\n118|}\n119|\n120|func transact(filesystem FileSystem, root string, lock *fileLock, fn TransactionFunc) error {\n121|\tunlock, err := lock.exclusive()\n122|\tif err != nil {\n123|\t\treturn trustError(TrustError{Operation: \"lock transaction\", Err: errors.Join(ErrTrustDurability, err)})\n124|\t}\n125|\tdefer unlock()\n126|\treturn transactLocked(filesystem, root, fn)\n127|}\n128|\n129|// transactLocked runs one crash-durable generation transaction assuming the\n130|// caller already holds the exclusive authorization lock. Joint commits and\n131|// recovery use it to sequence the marker, the external replacement and the\n132|// bump under a single hold.\n133|func transactLocked(filesystem FileSystem, root string, fn TransactionFunc) error {\n134|\tcommitted, err := loadCommitted(filesystem, root)\n135|\tif err != nil {\n136|\t\treturn err\n137|\t}\n138|\tnext := committed\n139|\tnext.Entries = append([]CredentialEntry(nil), committed.Entries...)\n140|\tif err := fn(&next); err != nil {\n141|\t\treturn err\n142|\t}\n143|\tif next.Generation != committed.Generation {\n144|\t\treturn trustError(TrustError{Operation: \"commit generation\", Err: ErrTrustDurability})\n145|\t}\n146|\tif committed.Generation >= MaxGeneration {\n147|\t\treturn trustError(TrustError{Operation: \"commit generation\", Err: ErrGenerationExhausted})\n148|\t}\n149|\tnext.Generation = committed.Generation + 1\n150|\tencoded, err := EncodeTrust(next)\n151|\tif err != nil {\n152|\t\treturn err\n153|\t}\n154|\tif err := commitDocument(filesystem, root, filepath.Join(root, trustFileName), encoded); err != nil {\n155|\t\treturn err\n156|\t}\n157|\treturn nil\n158|}\n159|\n160|// loadCommitted reads the committed trust without acquiring the lock: the\n161|// caller must already hold the shared or exclusive authorization lock.\n162|func loadCommitted(filesystem FileSystem, root string) (TrustStore, error) {\n163|\tpath := filepath.Join(root, trustFileName)\n164|\tinfo, err := filesystem.Lstat(path)\n165|\tif err != nil {\n166|\t\tif os.IsNotExist(err) {\n167|\t\t\treturn TrustStore{}, trustError(TrustError{Operation: \"read committed trust\", Err: ErrTrustStoreMissing})\n168|\t\t}\n169|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"read committed trust\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n170|\t}\n171|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n172|\t\treturn TrustStore{}, err\n173|\t}\n174|\tdocument, err := filesystem.ReadFile(path)\n175|\tif err != nil {\n176|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"read committed trust\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n177|\t}\n178|\tdecoded, err := DecodeTrust(document)\n179|\tif err != nil {\n180|\t\treturn TrustStore{}, err\n181|\t}\n182|\treturn decoded, nil\n183|}\n184|\n185|// commitDocument stages bytes in a temp file with fsync, atomically renames\n186|// over the target, and fsyncs the directory. On restart only the last fully\n187|// committed file is selected; staged files are ignored by every reader.\n188|func commitDocument(filesystem FileSystem, root, path string, document []byte) error {\n189|\tstaged, err := filesystem.CreateTemp(root, stagePrefix+\"*\", 0o600)\n190|\tif err != nil {\n191|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n192|\t}\n193|\tname := staged.Name()\n194|\tfailed := true\n195|\tdefer func() {\n196|\t\tif failed {\n197|\t\t\t_ = filesystem.Remove(name)\n198|\t\t}\n199|\t}()\n200|\tif err := writeAll(staged, document); err != nil {\n201|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n202|\t}\n203|\tif err := staged.Sync(); err != nil {\n204|\t\t_ = staged.Close()\n205|\t\treturn trustError(TrustError{Operation: \"sync trust\", Err: errors.Join(ErrTrustDurability, err)})\n206|\t}\n207|\tif err := staged.Close(); err != nil {\n208|\t\treturn trustError(TrustError{Operation: \"sync trust\", Err: errors.Join(ErrTrustDurability, err)})\n209|\t}\n210|\tif err := filesystem.Chmod(name, 0o600); err != nil {\n211|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n212|\t}\n213|\t// On platforms where mode bits do not govern access, install the\n214|\t// owner-only ACL before the staging file becomes visible under load.\n215|\tif err := secureStaged(name, false); err != nil {\n216|\t\treturn err\n217|\t}\n218|\tif err := filesystem.Rename(name, path); err != nil {\n219|\t\treturn trustError(TrustError{Operation: \"replace trust\", Err: errors.Join(ErrTrustDurability, err)})\n220|\t}\n221|\tif err := syncDir(filesystem, root); err != nil {\n222|\t\treturn trustError(TrustError{Operation: \"sync trust directory\", Err: errors.Join(ErrTrustDurability, err)})\n223|\t}\n224|\tfailed = false\n225|\treturn nil\n226|}\n227|\n228|func writeAll(writer interface{ Write([]byte) (int, error) }, document []byte) error {\n229|\tfor len(document) > 0 {\n230|\t\twritten, err := writer.Write(document)\n231|\t\tif err != nil {\n232|\t\t\treturn err\n233|\t\t}\n234|\t\tif written == 0 {\n235|\t\t\treturn errors.New(\"short trust write\")\n236|\t\t}\n237|\t\tdocument = document[written:]\n238|\t}\n239|\treturn nil\n240|}\n241|\n242|func syncDir(filesystem FileSystem, root string) error {\n243|\thandle, err := filesystem.OpenDirectory(root)\n244|\tif err != nil {\n245|\t\treturn err\n246|\t}\n247|\tif err := handle.Sync(); err != nil {\n248|\t\t_ = handle.Close()\n249|\t\treturn err\n250|\t}\n251|\treturn handle.Close()\n252|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
