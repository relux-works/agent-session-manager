{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c825","stream":{"kind":"session","id":"01a0aa3d-f870-72c3-b067-9f985ccf069d"},"sequence":621,"recorded_at":1780531400001237,"record_type":"event","durability":"durable","causation_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","run_stream":{"kind":"run","id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01"},"task_stream":{"kind":"task","id":"01a0aa3f-a11c-7801-9fd8-bac808a34877"},"task_id":"01a0aa3f-a11c-7801-9fd8-bac808a34877","event":{"kind":"output","task_id":"01a0aa3f-a11c-7801-9fd8-bac808a34877","chunk":"Read text file `internal/hosttrust/lock_windows.go`.\n1|//go:build windows\n2|\n3|package hosttrust\n4|\n5|import (\n6|\t\"errors\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"sync\"\n10|\n11|\t\"golang.org/x/sys/windows\"\n12|)\n13|\n14|// fileLock is the machine-local cross-process authorization lock shared by\n15|// trust changes and Configuration 4.0.0 peer/credential changes. Readers hold\n16|// it shared; transactions hold it exclusive.\n17|//\n18|// Every acquisition opens its own handle: Windows byte-range locks attach to\n19|// the file object, so goroutines sharing one retained handle would not\n20|// serialize. Per-acquisition handles make both same-process goroutines and\n21|// separate processes block on a held exclusive lock. A caller must never\n22|// request a second acquisition while holding one in the same goroutine;\n23|// internal reads nested inside a holder use handle-direct unlocked reads\n24|// instead of re-acquiring.\n25|type fileLock struct {\n26|\tpath string\n27|}\n28|\n29|// lockInitMu serializes concurrent creation of the lock file itself.\n30|var lockInitMu sync.Mutex\n31|\n32|func openLock(filesystem FileSystem, path string) (*fileLock, error) {\n33|\tlockInitMu.Lock()\n34|\tdefer lockInitMu.Unlock()\n35|\tinfo, err := filesystem.Lstat(path)\n36|\tif err != nil {\n37|\t\tif !os.IsNotExist(err) {\n38|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n39|\t\t}\n40|\t\tstaged, err := filesystem.CreateTemp(filepath.Dir(path), \"lock-stage-*\", 0o600)\n41|\t\tif err != nil {\n42|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n43|\t\t}\n44|\t\tname := staged.Name()\n45|\t\t_ = staged.Close()\n46|\t\tif err := filesystem.Rename(name, path); err != nil {\n47|\t\t\t_ = filesystem.Remove(name)\n48|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n49|\t\t}\n50|\t\tif err := filesystem.Chmod(path, 0o600); err != nil {\n51|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n52|\t\t}\n53|\t\tif err := secureStaged(path, false); err != nil {\n54|\t\t\treturn nil, err\n55|\t\t}\n56|\t\tinfo, err = filesystem.Lstat(path)\n57|\t\tif err != nil {\n58|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n59|\t\t}\n60|\t}\n61|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n62|\t\treturn nil, err\n63|\t}\n64|\treturn &fileLock{path: path}, nil\n65|}\n66|\n67|func openLockHandle(path string) (windows.Handle, error) {\n68|\tname, err := windows.UTF16PtrFromString(path)\n69|\tif err != nil {\n70|\t\treturn 0, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n71|\t}\n72|\thandle, err := windows.CreateFile(name, windows.GENERIC_READ|windows.GENERIC_WRITE,\n73|\t\twindows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING,\n74|\t\twindows.FILE_ATTRIBUTE_NORMAL, 0)\n75|\tif err != nil {\n76|\t\treturn 0, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n77|\t}\n78|\treturn handle, nil\n79|}\n80|\n81|func (lock *fileLock) shared() (func(), error) {\n82|\thandle, err := openLockHandle(lock.path)\n83|\tif err != nil {\n84|\t\treturn nil, err\n85|\t}\n86|\toverlapped := new(windows.Overlapped)\n87|\tif err := windows.LockFileEx(handle, 0, 0, 1, 0, overlapped); err != nil {\n88|\t\t_ = windows.CloseHandle(handle)\n89|\t\treturn nil, err\n90|\t}\n91|\treturn func() {\n92|\t\t_ = windows.UnlockFileEx(handle, 0, 1, 0, overlapped)\n93|\t\t_ = windows.CloseHandle(handle)\n94|\t}, nil\n95|}\n96|\n97|func (lock *fileLock) exclusive() (func(), error) {\n98|\thandle, err := openLockHandle(lock.path)\n99|\tif err != nil {\n100|\t\treturn nil, err\n101|\t}\n102|\toverlapped := new(windows.Overlapped)\n103|\tif err := windows.LockFileEx(handle, windows.LOCKFILE_EXCLUSIVE_LOCK, 0, 1, 0, overlapped); err != nil {\n104|\t\t_ = windows.CloseHandle(handle)\n105|\t\treturn nil, err\n106|\t}\n107|\treturn func() {\n108|\t\t_ = windows.UnlockFileEx(handle, 0, 1, 0, overlapped)\n109|\t\t_ = windows.CloseHandle(handle)\n110|\t}, nil\n111|}","final_result":true}}}
