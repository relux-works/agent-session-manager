he pair: admitting the new Config4\n415|\t// with the old generation fails the test.\n416|\tloaded, err := Load(fixture.inputs, nil)\n417|\tif err != nil {\n418|\t\treturn\n419|\t}\n420|\tconfiguration, ok := loaded.Configuration()\n421|\tif !ok {\n422|\t\treturn\n423|\t}\n424|\treopened, err := hosttrust.Open(fixture.stateDir)\n425|\tif err != nil {\n426|\t\treturn\n427|\t}\n428|\tsnapshot, err := reopened.ReadSnapshot()\n429|\tif err != nil {\n430|\t\treturn\n431|\t}\n432|\tif configuration.SourceVersion == Version4 && snapshot.Generation == before {\n433|\t\tt.Fatalf(\"restart admits new Config4 with old generation %d after child exit 77\", before)\n434|\t}\n435|\tif configuration.SourceVersion != Version4 || snapshot.Generation != before+1 {\n436|\t\tt.Fatalf(\"restart converged to version %q generation %d, want 4.0.0/%d\", configuration.SourceVersion, snapshot.Generation, before+1)\n437|\t}\n438|}\n439|\n440|func TestApplyV4MarkerStagingFailureAborts(t *testing.T) {\n441|\tif os.Geteuid() == 0 {\n442|\t\tt.Skip(\"permission-bit staging does not bind the superuser\")\n443|\t}\n444|\tfixture := setupV4Fixture(t, testPeerID)\n445|\tpreview, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now)\n446|\tif err != nil {\n447|\t\tt.Fatalf(\"PreviewV4 error = %v\", err)\n448|\t}\n449|\t// The joint marker cannot stage in an unwritable trust directory: the\n450|\t// commit aborts before the configuration is touched, with no marker\n451|\t// left behind. The store opens before the directory loses its write\n452|\t// bit, so the failure lands in the commit, not in the open.\n453|\tchannel := filepath.Join(fixture.stateDir, \"host-channel\")\n454|\tpreopened, err := hosttrust.Open(fixture.stateDir)\n455|\tif err != nil {\n456|\t\tt.Fatal(err)\n457|\t}\n458|\tif err := os.Chmod(channel, 0o500); err != nil {\n459|\t\tt.Fatal(err)\n460|\t}\n461|\tdefer func() { _ = os.Chmod(channel, 0o700) }()\n462|\topenHook := func(string) (*hosttrust.Store, error) { return preopened, nil }\n463|\tsource, err := os.ReadFile(fixture.filename)\n464|\tif err != nil {\n465|\t\tt.Fatal(err)\n466|\t}\n467|\tif _, err := applyV4(fixture.inputs, nil, preview, true, fixture.now, osMigrationFileSystem{}, openHook); err == nil {\n468|\t\tt.Fatal(\"ApplyV4(unwritable trust dir) succeeded, want failure\")\n469|\t} else if !errors.Is(err, hosttrust.ErrTrustDurability) {\n470|\t\tt.Fatalf(\"ApplyV4(staging) error = %v, want durability failure\", err)\n471|\t}\n472|\tafter, err := os.ReadFile(fixture.filename)\n473|\tif err != nil {\n474|\t\tt.Fatal(err)\n475|\t}\n476|\tif !bytes.Equal(after, source) {\n477|\t\tt.Fatal(\"aborted joint commit mutated the configuration\")\n478|\t}\n479|\tif _, err := os.Lstat(filepath.Join(channel, \"pending-commit.json\")); !os.IsNotExist(err) {\n480|\t\tt.Fatalf(\"joint marker remains after aborted commit: %v\", err)\n481|\t}\n482|}\n483|\n484|func TestApplyV4TrustCommitRecoveryFailure(t *testing.T) {\n485|\tfixture := setupV4Fixture(t, testPeerID)\n486|\tcrownTrustAtExhaustion(t, fixture)\n487|\tpreview, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now)\n488|\tif err != nil {\n489|\t\tt.Fatalf(\"PreviewV4 error = %v\", err)\n490|\t}\n491|\tif preview.SourceGeneration != hosttrust.MaxGeneration {\n492|\t\tt.Fatalf(\"preview generation = %d, want the exhausted ceiling\", preview.SourceGeneration)\n493|\t}\n494|\t// The config replacement succeeds but the generation bump is refused at\n495|\t// the uint53 ceiling, and the source restore fails too: the error must\n496|\t// report the compound failure, never silent success. Rename 1 installs\n497|\t// the replacement; rename 2 (the restore) is faulted.\n498|\tfailing := &faultMigrationFileSystem{failRenameCall: 2}\n499|\tif _, err := applyV4(fixture.inputs, nil, preview, true, fixture.now, failing, hosttrust.Open); err == nil {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c911","stream":{"kind":"session","id":"01a0aa3d-f870-72c3-b067-9f985ccf069d"},"sequence":739,"recorded_at":1780531400001473,"record_type":"event","durability":"durable","causation_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","run_stream":{"kind":"run","id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01"},"call_id":"call_01a0aa3fcb547792ae27fa785e6d69aa","text":"Read text file `internal/hosttrust/errors.go`.\n1|package hosttrust\n2|\n3|import \"errors\"\n4|\n5|var (\n6|\t// ErrTrustDecode reports JSON syntax or shape failures without\n7|\t// echoing machine-local bytes. Rendered messages stay static.\n8|\tErrTrustDecode = errors.New(\"host trust document decode failed\")\n9|\t// ErrTrustValidation reports a well-formed document that violates the\n10|\t// closed Host Trust Store 1.0.0 contract.\n11|\tErrTrustValidation = errors.New(\"host trust document validation failed\")\n12|\t// ErrTrustStoreMissing reports a missing store. It is never an empty\n13|\t// store: callers must run explicit setup instead of inferring one.\n14|\tErrTrustStoreMissing = errors.New(\"host trust store is missing\")\n15|\t// ErrTrustStoreUnreadable reports permission, ownership or I/O failures.\n16|\tErrTrustStoreUnreadable = errors.New(\"host trust store is unreadable\")\n17|\t// ErrTrustUnsafeCustody reports owner-only violations: group/world\n18|\t// access, foreign ownership, or symlink/reparse escapes.\n19|\tErrTrustUnsafeCustody = errors.New(\"host trust custody is not owner-only\")\n20|\t// ErrTrustDurability reports a failed atomic commit. A failed commit is\n21|\t// a failure, never absence or success.\n22|\tErrTrustDurability = errors.New(\"host trust durable commit failed\")\n23|\t// ErrGenerationExhausted reports a mutation refused because the uint53\n24|\t// generation counter cannot increment again.\n25|\tErrGenerationExhausted = errors.New(\"host trust generation exhausted\")\n26|\t// ErrStaleGeneration reports a dispatch or mutation attempted under a\n27|\t// superseded authorization generation.\n28|\tErrStaleGeneration = errors.New(\"host trust authorization generation is stale\")\n29|\t// ErrEnrollmentRefused reports an enrollment tuple the operator\n30|\t// authorization or the uniqueness rules reject.\n31|\tErrEnrollmentRefused = errors.New(\"host trust enrollment refused\")\n32|\t// ErrRotationRefused reports a rotation outside the fresh-key bounded\n33|\t// window: same-key renewal, a second rotation over a retiring entry, or\n34|\t// more than two non-revoked credentials for one host.\n35|\tErrRotationRefused = errors.New(\"host credential rotation refused\")\n36|\t// ErrRevocationRefused reports a revocation with nothing to revoke.\n37|\tErrRevocationRefused = errors.New(\"host credential revocation refused\")\n38|\t// ErrCredentialProfile reports issued or imported bytes outside Host\n39|\t// Credential Profile 1.\n40|\tErrCredentialProfile = errors.New(\"host credential profile check failed\")\n41|\t// ErrCredentialCustody reports private/public mismatch, wrong host\n42|\t// binding, or unreadable custody files at use time.\n43|\tErrCredentialCustody = errors.New(\"host credential custody check failed\")\n44|\t// ErrAuthorizationRefused reports a dispatch or mutation boundary that\n45|\t// fails current-generation, validity, allowlist or hello checks.\n46|\tErrAuthorizationRefused = errors.New(\"host channel authorization refused\")\n47|\t// ErrNotAllowlisted reports a TLS-authenticated peer that is not on the\n48|\t// local allowlist. The string is the spec refusal identity shared with\n49|\t// peeridentity.ErrNotAllowlisted; hosttrust cannot import peeridentity\n50|\t// (import cycle), so a test pins the two strings equal.\n51|\tErrNotAllowlisted = errors.New(\"peer_not_allowlisted\")\n52|\t// ErrHostIdentityMismatch reports a hello host ID that differs from the\n53|\t// uniquely verified enrolled host UUID. The string is the spec refusal\n54|\t// identity shared with peeridentity.ErrHostIdentityMismatch; pinned\n55|\t// equal by test for the same reason as ErrNotAllowlisted.\n56|\tErrHostIdentityMismatch = errors.New(\"host_identity_mismatch\")\n57|\t// ErrInvalidStoreContext reports a store rooted outside an absolute\n58|\t// state directory or otherwise unusable as machine-local authority.\n59|\tErrInvalidStoreContext = errors.New(\"invalid host trust store context\")\n60|\t// ErrJointReplacementDurable reports a joint commit whose external\n61|\t// replacement is durable but whose generation bump failed. The intent\n62|\t// marker is kept: the caller must restore the source bytes and converge\n63|\t// through Recover, which then aborts cleanly.\n64|\tErrJointReplacementDurable = errors.New(\"host trust joint replacement durable without generation\")\n65|\t// ErrJointIntervened reports a joint config-plus-trust commit that\n66|\t// cannot converge: the configuration or the generation moved outside\n67|\t// the confirmed pins while the intent marker was outstanding. The\n68|\t// marker is kept for operator resolution; the restart refuses.\n69|\tErrJointIntervened = errors.New(\"host trust joint commit was superseded\")\n70|)\n71|\n72|// TrustError renders a static clause without machine-local values, paths,\n73|// fingerprints, UUIDs or key material. Wrapped details stay available to\n74|// errors.Is/errors.As through Unwrap.\n75|type TrustError struct {\n76|\tOperation string\n77|\tErr       error\n78|}\n79|\n80|func (err *TrustError) Error() string { return \"host trust \" + err.Operation + \" failed\" }\n81|func (err *TrustError) Unwrap() error { return err.Err }\n82|\n83|// trustError is the only construction site for *TrustError.\n84|var trustError = func(value TrustError) error { return &value }","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
