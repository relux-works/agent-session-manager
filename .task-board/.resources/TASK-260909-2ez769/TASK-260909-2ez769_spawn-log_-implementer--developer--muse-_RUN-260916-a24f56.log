Kill()}()\n32| deadline:=time.Now().Add(5*time.Second)\n33| for {if _,err:=os.Stat(filepath.Join(dir,\"observed\"));err==nil{break};if time.Now().After(deadline){t.Fatal(\"child did not reach absent-lock barrier\")};time.Sleep(5*time.Millisecond)}\n34| store,err:=Open(dir);if err!=nil{t.Fatal(err)}\n35| if _,err:=store.Initialize();err!=nil{t.Fatal(err)}\n36| release,err:=store.lock.exclusive();if err!=nil{t.Fatal(err)}\n37| old,err:=os.Stat(store.lock.path);if err!=nil{t.Fatal(err)}\n38| if err:=os.WriteFile(filepath.Join(dir,\"continue\"),[]byte(\"go\"),0600);err!=nil{t.Fatal(err)}\n39| done:=make(chan error,1);go func(){done<-cmd.Wait()}()\n40| var early bool\n41| select{case err= <-done:early=true;case <-time.After(300*time.Millisecond):}\n42| release()\n43| if !early{err= <-done}\n44| if err!=nil{t.Fatal(err)}\n45| fresh,err:=os.Stat(store.lock.path);if err!=nil{t.Fatal(err)}\n46| if early || !os.SameFile(old,fresh){t.Fatalf(\"concurrent Open replaced held authorization lock: returnedWhileHeld=%v sameInode=%v\",early,os.SameFile(old,fresh))}\n47|}","final_result":true}}}
