{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6d1","stream":{"kind":"session","id":"01a0aa3d-f870-72c3-b067-9f985ccf069d"},"sequence":451,"recorded_at":1780531400000897,"record_type":"event","durability":"durable","causation_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","run_stream":{"kind":"run","id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01"},"call_id":"call_01a0aa3f2641727789b276e7af0dee80","text":"Read text file `/tmp/rev4/probes/reviewer_probe_test.go`.\n1|package hosttrust\n2|\n3|import (\n4| \"testing\"\n5| \"path/filepath\"\n6| \"time\"\n7|)\n8|\n9|func TestReviewerStaleMutation(t *testing.T) {\n10| local, peer, lc, pc, snap, _ := twoHostFixture(t)\n11| leaf, root := peerMaterialForTest(t, peer, pc)\n12| req := dispatchRequest(snap, lc, pc, testHostB, leaf, root, []string{testHostA,testHostB}, testNow)\n13| if _, err := local.Issue(testHostC, testNow); err != nil {t.Fatal(err)}\n14| called := false\n15| err := local.WithMutationAuthorization(req, func() error{called=true; return nil})\n16| if err == nil || called {t.Fatalf(\"stale generation admitted: err=%v boundary=%v\",err,called)}\n17|}\n18|\n19|func TestReviewerRevocationDuringBoundary(t *testing.T) {\n20| local, peer, lc, pc, snap, _ := twoHostFixture(t)\n21| leaf, root := peerMaterialForTest(t, peer, pc)\n22| req := dispatchRequest(snap, lc, pc, testHostB, leaf, root, []string{testHostA,testHostB}, testNow)\n23| entered, release := make(chan struct{}), make(chan struct{})\n24| boundaryDone := make(chan error,1)\n25| go func(){boundaryDone <- local.WithMutationAuthorization(req,func() error{close(entered); <-release; return nil})}()\n26| <-entered\n27| revoked := make(chan error,1)\n28| go func(){revoked <- local.Revoke(pc)}()\n29| var early bool\n30| var revokeErr error\n31| select {case revokeErr= <-revoked: early=true; case <-time.After(250*time.Millisecond):}\n32| close(release)\n33| if err:= <-boundaryDone;err!=nil{t.Fatal(err)}\n34| if !early {revokeErr= <-revoked}\n35| if revokeErr !=nil {t.Fatal(revokeErr)}\n36| if early {t.Fatal(\"revocation reported success while mutation boundary still held prior authorization\")}\n37|}\n38|\n39|func TestReviewerSeparateStoreRevocationDuringBoundary(t *testing.T) {\n40| local, peer, lc, pc, snap, _ := twoHostFixture(t)\n41| leaf, root := peerMaterialForTest(t, peer, pc)\n42| req := dispatchRequest(snap, lc, pc, testHostB, leaf, root, []string{testHostA,testHostB}, testNow)\n43| other,err:=Open(filepath.Dir(local.Root()));if err!=nil{t.Fatal(err)}\n44| entered, release := make(chan struct{}), make(chan struct{})\n45| boundaryDone := make(chan error,1)\n46| go func(){boundaryDone <- local.WithMutationAuthorization(req,func() error{close(entered); <-release; return nil})}()\n47| <-entered\n48| revoked := make(chan error,1)\n49| go func(){revoked <- other.Revoke(pc)}()\n50| var early bool\n51| var revokeErr error\n52| select {case revokeErr= <-revoked: early=true; case <-time.After(250*time.Millisecond):}\n53| close(release)\n54| if err:= <-boundaryDone;err!=nil{t.Fatal(err)}\n55| if !early {revokeErr= <-revoked}\n56| if revokeErr !=nil {t.Fatal(revokeErr)}\n57| if early {t.Fatal(\"revocation reported success while mutation boundary still held prior authorization\")}\n58|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6d3","stream":{"kind":"session","id":"01a0aa3d-f870-72c3-b067-9f985ccf069d"},"sequence":452,"recorded_at":1780531400000899,"record_type":"event","durability":"durable","causation_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","run_stream":{"kind":"run","id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01"},"call_id":"call_01a0aa3f27e171e7a38f0825e5c05672","text":"Read text file `/tmp/rev4/REPRODUCE.md`.\n1|# Reproduce reviewer probes\n2|\n3|Extract the exact tree in a scratch directory under the repository .temp:\n4|\n5|    git archive 2c8909c9c7425bb3a90c00b8db3762f43b4dbf39 | tar -x -C <scratch>\n6|\n7|Copy probes/reviewer_probe_test.go and probes/reviewer_lock_test.go into\n8|<scratch>/internal/hosttrust/; copy probes/reviewer_crash_test.go into\n9|<scratch>/internal/config/. These are fixture-only tests, not production edits.\n10|From scratch run:\n11|\n12|    go test ./internal/hosttrust -count=1 -run '^TestReviewer(StaleMutation|RevocationDuringBoundary|SeparateStoreRevocationDuringBoundary)$' -v\n13|    go test ./internal/hosttrust -count=1 -run '^TestReviewerCrossProcessLockInitialization$' -v\n14|    go test ./internal/config -count=1 -run '^TestReviewer' -v\n15|\n16|Observed exits: 0, 1, 1 respectively. The crash parent asserts child exit 77.\n17|The lock test pauses the child's filesystem observation until the parent holds\n18|the first-created lock, then demonstrates replacement of that inode.\n19|\n20|Before mutation runs, remove only these added test files from discovery:\n21|\n22|    python3 internal/hosttrust/mutations.py --output <output> --only neutral,stale-mutation-refresh,joint-marker-stale,recover-diverged\n23|\n24|Observed harness exit 0; neutral exit 0, three named mutant tests exit 1.\n25|Baseline without probes: go test ./internal/hosttrust ./internal/config\n26|./internal/peeridentity -count=1 -cover (exit 0).\n27|\n28|All executions used Go 1.25.5 darwin/arm64. This evidence tests process crashes,\n29|not power loss, and is not native Windows validation.","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
