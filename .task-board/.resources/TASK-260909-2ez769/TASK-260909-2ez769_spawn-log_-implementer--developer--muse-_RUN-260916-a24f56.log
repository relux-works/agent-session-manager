{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c88d","stream":{"kind":"session","id":"01a0aa3d-f870-72c3-b067-9f985ccf069d"},"sequence":673,"recorded_at":1780531400001341,"record_type":"event","durability":"durable","causation_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","run_stream":{"kind":"run","id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01"},"call_id":"call_01a0aa3fab4b75b998c1a7e70b156bc6","text":"Read text file `internal/hosttrust/custody_windows.go`.\n1|//go:build windows\n2|\n3|package hosttrust\n4|\n5|import (\n6|\t\"encoding/binary\"\n7|\t\"errors\"\n8|\t\"io/fs\"\n9|\t\"os/user\"\n10|\t\"unsafe\"\n11|\n12|\t\"golang.org/x/sys/windows\"\n13|)\n14|\n15|// platformModeOK always holds on Windows: Go synthesizes mode bits from the\n16|// read-only attribute, so an exact comparison would refuse every path. The\n17|// owner-only DACL governs instead and is enforced by verifyOwner below.\n18|func platformModeOK(_ fs.FileInfo, _ fs.FileMode) bool { return true }\n19|\n20|// secureStaged installs the owner-only DACL on a newly created path. Staging\n21|// files and directories inherit the parent ACL by default, which typically\n22|// grants SYSTEM and Administrators: without this step every file the store\n23|// creates would fail its own verification below.\n24|func secureStaged(path string, dir bool) error {\n25|\tif err := installOwnerOnlyACL(path, dir); err != nil {\n26|\t\treturn trustError(TrustError{Operation: \"secure custody\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n27|\t}\n28|\treturn nil\n29|}\n30|\n31|// verifyOwner enforces owner-only custody on Windows: reparse-point escapes\n32|// refuse, the file owner SID must equal the process user SID, and the DACL\n33|// must grant access exclusively to that owner. Ownership alone does not\n34|// establish grants, so every allow entry is audited, including inherited\n35|// ones: a parent that grants SYSTEM, Administrators or any other principal\n36|// refuses until the operator removes the grant. A null DACL (full access\n37|// for everyone) and an empty or deny-only DACL (unusable) refuse as well.\n38|func verifyOwner(path string, info fs.FileInfo) error {\n39|\tif info.Mode()&fs.ModeSymlink != 0 {\n40|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: ErrTrustUnsafeCustody})\n41|\t}\n42|\tname, err := windows.UTF16PtrFromString(path)\n43|\tif err != nil {\n44|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n45|\t}\n46|\tattributes, err := windows.GetFileAttributes(name)\n47|\tif err != nil {\n48|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n49|\t}\n50|\tif attributes&windows.FILE_ATTRIBUTE_REPARSE_POINT != 0 {\n51|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: ErrTrustUnsafeCustody})\n52|\t}\n53|\tcurrent, err := user.Current()\n54|\tif err != nil {\n55|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n56|\t}\n57|\tuserSID, err := windows.StringToSid(current.Uid)\n58|\tif err != nil {\n59|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n60|\t}\n61|\tdescriptor, err := windows.GetNamedSecurityInfo(path, windows.SE_FILE_OBJECT, windows.OWNER_SECURITY_INFORMATION|windows.DACL_SECURITY_INFORMATION)\n62|\tif err != nil {\n63|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n64|\t}\n65|\towner, _, err := descriptor.Owner()\n66|\tif err != nil {\n67|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n68|\t}\n69|\tif owner == nil || !owner.Equals(userSID) {\n70|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: ErrTrustUnsafeCustody})\n71|\t}\n72|\tdacl, _, err := descriptor.DACL()\n73|\tif err != nil {\n74|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n75|\t}\n76|\tif dacl == nil {\n77|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: ErrTrustUnsafeCustody})\n78|\t}\n79|\taces, err := extractAllowedACEs(dacl)\n80|\tif err != nil {\n81|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n82|\t}\n83|\tif !ownerOnlyGrants(owner.String(), aces) {\n84|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: ErrTrustUnsafeCustody})\n85|\t}\n86|\treturn nil\n87|}\n88|\n89|// extractAllowedACEs translates the native DACL into the platform-independent\n90|// audit shape. Unknown entry types fail closed through aceOther.\n91|func extractAllowedACEs(dacl *windows.ACL) ([]allowedACE, error) {\n92|\tvar aces []allowedACE\n93|\tfor index := uint32(0); index < uint32(dacl.AceCount); index++ {\n94|\t\tvar raw *windows.ACCESS_ALLOWED_ACE\n95|\t\tif err := windows.GetAce(dacl, index, &raw); err != nil {\n96|\t\t\treturn nil, err\n97|\t\t}\n98|\t\tif raw == nil {\n99|\t\t\treturn nil, errors.New(\"absent access entry\")\n100|\t\t}\n101|\t\tswitch raw.Header.AceType {\n102|\t\tcase windows.ACCESS_DENIED_ACE_TYPE:\n103|\t\t\taces = append(aces, allowedACE{kind: aceDeny})\n104|\t\t\tcontinue\n105|\t\tcase windows.ACCESS_ALLOWED_ACE_TYPE:\n106|\t\tdefault:\n107|\t\t\taces = append(aces, allowedACE{kind: aceOther})\n108|\t\t\tcontinue\n109|\t\t}\n110|\t\tsid := (*windows.SID)(unsafe.Pointer(&raw.SidStart))\n111|\t\taces = append(aces, allowedACE{kind: aceAllow, sid: sid.String()})\n112|\t}\n113|\treturn aces, nil\n114|}\n115|\n116|// installOwnerOnlyACL replaces the DACL with one protected owner-only grant:\n117|// full access for the process user SID and nothing for anyone else. The\n118|// protected flag blocks inherited grants from the parent, which otherwise\n119|// reintroduce SYSTEM and Administrators. Directory grants carry container\n120|// and object inheritance so paths the store creates later start owner-only\n121|// too; every creation is still verified explicitly after install.\n122|func installOwnerOnlyACL(path string, dir bool) error {\n123|\tcurrent, err := user.Current()\n124|\tif err != nil {\n125|\t\treturn err\n126|\t}\n127|\tsid, err := windows.StringToSid(current.Uid)\n128|\tif err != nil {\n129|\t\treturn err\n130|\t}\n131|\tsidLen := windows.GetLengthSid(sid)\n132|\taceSize := uint16(8 + sidLen)\n133|\tbuffer := make([]byte, 8+int(aceSize))\n134|\tbuffer[0] = 2 // ACL_REVISION\n135|\tbinary.LittleEndian.PutUint16(buffer[2:], 8+aceSize)\n136|\tbinary.LittleEndian.PutUint16(buffer[4:], 1)\n137|\tbuffer[8] = windows.ACCESS_ALLOWED_ACE_TYPE\n138|\tif dir {\n139|\t\tbuffer[9] = windows.OBJECT_INHERIT_ACE | windows.CONTAINER_INHERIT_ACE\n140|\t}\n141|\tbinary.LittleEndian.PutUint16(buffer[10:], aceSize)\n142|\tbinary.LittleEndian.PutUint32(buffer[12:], uint32(windows.GENERIC_ALL))\n143|\tdestination := (*windows.SID)(unsafe.Pointer(&buffer[16]))\n144|\tif err := windows.CopySid(sidLen, destination, sid); err != nil {\n145|\t\treturn err\n146|\t}\n147|\tacl := (*windows.ACL)(unsafe.Pointer(&buffer[0]))\n148|\treturn windows.SetNamedSecurityInfo(path, windows.SE_FILE_OBJECT,\n149|\t\twindows.DACL_SECURITY_INFORMATION|windows.PROTECTED_DACL_SECURITY_INFORMATION,\n150|\t\tnil, nil, acl, nil)\n151|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c88f","stream":{"kind":"session","id":"01a0aa3d-f870-72c3-b067-9f985ccf069d"},"sequence":674,"recorded_at":1780531400001343,"record_type":"event","durability":"durable","causation_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","run_stream":{"kind":"run","id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01"},"call_id":"call_01a0aa3face0727b8b6d83e6504a7c00","text":"Read text file `internal/hosttrust/dacl.go`.\n1|package hosttrust\n2|\n3|// aceKind classifies one DACL entry for the owner-only audit. Only explicit\n4|// allow entries grant access; deny entries grant nothing; any other entry\n5|// type has unknown grant semantics and fails closed.\n6|type aceKind int\n7|\n8|const (\n9|\taceAllow aceKind = iota\n10|\taceDeny\n11|\taceOther\n12|)\n13|\n14|// allowedACE is one DACL entry in platform-independent form: the grant kind\n15|// plus the trustee SID in string form. Platform extractors translate native\n16|// ACEs into this shape; ownerOnlyGrants decides them without native calls,\n17|// so the audit logic itself runs on every platform under test.\n18|type allowedACE struct {\n19|\tkind aceKind\n20|\tsid  string\n21|}\n22|\n23|// ownerOnlyGrants reports whether a DACL grants access exclusively to owner:\n24|// every allow entry names the owner SID, and at least one such entry exists\n25|// (an empty or deny-only DACL is unusable and refuses). Deny entries are\n26|// skipped: they grant nothing. Any other entry type refuses.\n27|func ownerOnlyGrants(owner string, aces []allowedACE) bool {\n28|\tif owner == \"\" {\n29|\t\treturn false\n30|\t}\n31|\tgranted := false\n32|\tfor _, ace := range aces {\n33|\t\tswitch ace.kind {\n34|\t\tcase aceDeny:\n35|\t\t\tcontinue\n36|\t\tcase aceAllow:\n37|\t\t\tif ace.sid != owner {\n38|\t\t\t\treturn false\n39|\t\t\t}\n40|\t\t\tgranted = true\n41|\t\tdefault:\n42|\t\t\treturn false\n43|\t\t}\n44|\t}\n45|\treturn granted\n46|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c891","stream":{"kind":"session","id":"01a0aa3d-f870-72c3-b067-9f985ccf069d"},"sequence":675,"recorded_at":1780531400001345,"record_type":"event","durability":"durable","causation_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","run_stream":{"kind":"run","id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01"},"call_id":"call_01a0aa3fae9e737981fd5e9bbdd123b5","text":"Read text file `internal/hosttrust/export.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"path\"\n6|\t\"path/filepath\"\n7|\t\"strings\"\n8|)\n9|\n10|// EnrollmentMaterial is the explicitly selected public enrollment material an\n11|// operator exchanges out of band. It carries no private key: only\n12|// certificate.pem and root.pem bytes leave the store, never private-key.pem,\n13|// trust internals, backups or authorization caches.\n14|type EnrollmentMaterial struct {\n15|\tHostID       string\n16|\tCredentialID string\n17|\tLeafDER      []byte\n18|\tRootDER      []byte\n19|\tFingerprints Fingerprints\n20|}\n21|\n22|// Formatting enrollment material redacts DER bytes by default; the operator\n23|// exports explicit fields, never a log line.\n24|func (EnrollmentMaterial) String() string   { return \"host enrollment material\" }\n25|func (EnrollmentMaterial) GoString() string { return \"host enrollment material\" }\n26|func (EnrollmentMaterial) Format(state fmt.State, verb rune) {\n27|\t_, _ = state.Write([]byte(\"host enrollment material\"))\n28|}\n29|\n30|// ExportEnrollment selects the public bytes of one non-revoked entry for\n31|// out-of-band exchange. Revoked tombstones never redistribute: exporting one\n32|// refuses.\n33|func ExportEnrollment(snapshot Snapshot, credentialID string) (EnrollmentMaterial, error) {\n34|\tentry, found := findEntry(snapshot.Trust, credentialID)\n35|\tif !found {\n36|\t\treturn EnrollmentMaterial{}, trustError(TrustError{Operation: \"export enrollment\", Err: ErrEnrollmentRefused})\n37|\t}\n38|\tif entry.State == EntryRevoked {\n39|\t\treturn EnrollmentMaterial{}, trustError(TrustError{Operation: \"export enrollment\", Err: ErrEnrollmentRefused})\n40|\t}\n41|\tfingerprints, err := FingerprintsOf(entry.LeafDER, entry.RootDER)\n42|\tif err != nil {\n43|\t\treturn EnrollmentMaterial{}, err\n44|\t}\n45|\treturn EnrollmentMaterial{\n46|\t\tHostID:       entry.HostID.String(),\n47|\t\tCredentialID: entry.CredentialID.String(),\n48|\t\tLeafDER:      append([]byte(nil), entry.LeafDER...),\n49|\t\tRootDER:      append([]byte(nil), entry.RootDER...),\n50|\t\tFingerprints: fingerprints,\n51|\t}, nil\n52|}\n53|\n54|// ExcludedFromReplication lists the STATE_DIR-relative paths that must never\n55|// enter replication, snapshots, cloning, Session Directory, logs or exported\n56|// diagnostic bundles. Credential, trust, backup, private-key and\n57|// authorization-cache material stays machine-local; operators exchange only\n58|// explicitly selected public enrollment material outside replication.\n59|func ExcludedFromReplication() []string {\n60|\treturn []string{\n61|\t\thostChannelDir + \"/trust.json\",\n62|\t\thostChannelDir + \"/pending-commit.json\",\n63|\t\thostChannelDir + \"/credentials/\",\n64|\t\thostChannelDir + \"/lock\",\n65|\t}\n66|}\n67|\n68|// MatchExcludedFromReplication reports whether a STATE_DIR-relative path\n69|// must stay out of replication, snapshots, cloning, Session Directory, logs\n70|// and exported diagnostic bundles. It covers the listed control paths plus\n71|// transient staging files, which carry the same material under rotating\n72|// names. Any path that escapes the state directory fails closed as\n73|// excluded. Every replication, snapshot, clone or diagnostic export surface\n74|// must consult this matcher (and ExcludedConfigDirName for configuration\n75|// directory files) and drop matches; ExportEnrollment material is\n76|// deliberately NOT excluded, since explicitly selected public bytes are the\n77|// only operator exchange outside replication.\n78|func MatchExcludedFromReplication(relative string) bool {\n79|\tif relative == \"\" || relative == \".\" {\n80|\t\treturn false\n81|\t}\n82|\tslash := filepath.ToSlash(relative)\n83|\tif path.IsAbs(slash) {\n84|\t\treturn true\n85|\t}\n86|\tfor _, segment := range strings.Split(slash, \"/\") {\n87|\t\tif segment == \"..\" {\n88|\t\t\treturn true\n89|\t\t}\n90|\t}\n91|\ttrimmed := path.Clean(slash)\n92|\tfor _, listed := range ExcludedFromReplication() {\n93|\t\tclean := path.Clean(listed)\n94|\t\tif trimmed == clean || strings.HasPrefix(trimmed, clean+\"/\") {\n95|\t\t\treturn true\n96|\t\t}\n97|\t}\n98|\tbase := path.Base(trimmed)\n99|\tfor _, prefix := range []string{stagePrefix, \".custody-stage-\", \"lock-stage-\"} {\n100|\t\tif strings.HasPrefix(base, prefix) {\n101|\t\t\treturn true\n102|\t\t}\n103|\t}\n104|\treturn false\n105|}\n106|\n107|// ExcludedConfigDirName reports whether a configuration-directory file name\n108|// carries trust-adjacent material that must stay out of replication: owner-only\n109|// backups, pre-rollback copies and transient migration staging files. Backup\n110|// names embed the source version (\".bak.<version>\"), so the match is by\n111|// infix, pinned against the names replaceDurably actually publishes.\n112|func ExcludedConfigDirName(base string) bool {\n113|\tname := path.Base(filepath.ToSlash(base))\n114|\tif strings.Contains(name, \".pre-rollback.\") {\n115|\t\treturn true\n116|\t}\n117|\tif strings.HasPrefix(name, \".ax-config-\") {\n118|\t\treturn true\n119|\t}\n120|\tif strings.Contains(name, \".bak.\") {\n121|\t\treturn true\n122|\t}\n123|\treturn false\n124|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
