{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cacb","stream":{"kind":"session","id":"01a0aa3d-f870-72c3-b067-9f985ccf069d"},"sequence":960,"recorded_at":1780531400001915,"record_type":"event","durability":"durable","causation_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","run_stream":{"kind":"run","id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01"},"task_stream":{"kind":"task","id":"01a0aa40-9af8-7b13-9b9a-3c31d75d2e5e"},"task_id":"01a0aa40-9af8-7b13-9b9a-3c31d75d2e5e","event":{"kind":"output","task_id":"01a0aa40-9af8-7b13-9b9a-3c31d75d2e5e","chunk":"Read text file `internal/hosttrust/joint_test.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"testing\"\n8|\t\"time\"\n9|)\n10|\n11|func jointFixture(t *testing.T, source, replacement []byte) (*Store, string, Snapshot) {\n12|\tt.Helper()\n13|\tdirectory := t.TempDir()\n14|\tconfigPath := filepath.Join(directory, \"config.toml\")\n15|\tif err := os.WriteFile(configPath, source, 0o600); err != nil {\n16|\t\tt.Fatal(err)\n17|\t}\n18|\tstore := setupStoreForTest(t)\n19|\tsnapshot, err := store.ReadSnapshot()\n20|\tif err != nil {\n21|\t\tt.Fatal(err)\n22|\t}\n23|\treturn store, configPath, snapshot\n24|}\n25|\n26|func jointMarker(configPath string, source, replacement []byte, generation uint64) PendingCommit {\n27|\treturn PendingCommit{\n28|\t\tSchema:            \"urn:ax:schema:host-pending-commit\",\n29|\t\tSchemaVersion:     \"1.0.0\",\n30|\t\tOperation:         JointApplyV4,\n31|\t\tConfigPath:        configPath,\n32|\t\tSourceSHA256:      SHA256HexOf(source),\n33|\t\tReplacementSHA256: SHA256HexOf(replacement),\n34|\t\tSourceGeneration:  generation,\n35|\t\tBackupPath:        configPath + \".bak.3.0.0\",\n36|\t}\n37|}\n38|\n39|func TestJointCommitHappyPath(t *testing.T) {\n40|\tsource := []byte(\"source configuration\\n\")\n41|\treplacement := []byte(\"replacement configuration\\n\")\n42|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n43|\tmarker := jointMarker(configPath, source, replacement, snapshot.Generation)\n44|\treplace := func() error { return os.WriteFile(configPath, replacement, 0o600) }\n45|\trevalidate := func(current TrustStore) error {\n46|\t\tif current.Generation != snapshot.Generation {\n47|\t\t\treturn errors.New(\"generation moved\")\n48|\t\t}\n49|\t\treturn nil\n50|\t}\n51|\tgeneration, err := store.JointCommit(marker, revalidate, replace)\n52|\tif err != nil {\n53|\t\tt.Fatalf(\"JointCommit error = %v\", err)\n54|\t}\n55|\tif generation != snapshot.Generation+1 {\n56|\t\tt.Fatalf(\"JointCommit generation = %d, want %d\", generation, snapshot.Generation+1)\n57|\t}\n58|\tinstalled, err := os.ReadFile(configPath)\n59|\tif err != nil {\n60|\t\tt.Fatal(err)\n61|\t}\n62|\tif string(installed) != string(replacement) {\n63|\t\tt.Fatal(\"JointCommit did not install the replacement\")\n64|\t}\n65|\tif _, err := os.Lstat(pendingPath(store.root)); !os.IsNotExist(err) {\n66|\t\tt.Fatalf(\"joint marker remains after commit: %v\", err)\n67|\t}\n68|\tfresh, err := store.ReadSnapshot()\n69|\tif err != nil {\n70|\t\tt.Fatal(err)\n71|\t}\n72|\tif fresh.Generation != generation {\n73|\t\tt.Fatalf(\"committed generation = %d, want %d\", fresh.Generation, generation)\n74|\t}\n75|}\n76|\n77|func TestJointCommitRevalidatesStaleGeneration(t *testing.T) {\n78|\tsource := []byte(\"source configuration\\n\")\n79|\treplacement := []byte(\"replacement configuration\\n\")\n80|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n81|\t// A concurrent trust commit moves the generation before the joint\n82|\t// commit runs: the in-lock revalidation must refuse the stale pins.\n83|\tpeer := setupStoreForTest(t)\n84|\tenrollPeerForTest(t, store, peer, testHostC, testNow)\n85|\tmarker := jointMarker(configPath, source, replacement, snapshot.Generation)\n86|\tcalled := false\n87|\t_, err := store.JointCommit(marker,\n88|\t\tfunc(current TrustStore) error {\n89|\t\t\tif current.Generation != snapshot.Generation {\n90|\t\t\t\treturn trustError(TrustError{Operation: \"validate preview generation\", Err: ErrStaleGeneration})\n91|\t\t\t}\n92|\t\t\treturn nil\n93|\t\t},\n94|\t\tfunc() error {\n95|\t\t\tcalled = true\n96|\t\t\treturn nil\n97|\t\t})\n98|\tif err == nil || called {\n99|\t\tt.Fatalf(\"JointCommit(stale) admitted: err=%v replace=%v\", err, called)\n100|\t} else if !errors.Is(err, ErrStaleGeneration) {\n101|\t\tt.Fatalf(\"JointCommit(stale) error = %v, want ErrStaleGeneration\", err)\n102|\t}\n103|\tif _, err := os.Lstat(pendingPath(store.root)); !os.IsNotExist(err) {\n104|\t\tt.Fatalf(\"joint marker remains after refused commit: %v\", err)\n105|\t}\n106|\tinstalled, err := os.ReadFile(configPath)\n107|\tif err != nil {\n108|\t\tt.Fatal(err)\n109|\t}\n110|\tif string(installed) != string(source) {\n111|\t\tt.Fatal(\"refused joint commit mutated the configuration\")\n112|\t}\n113|}\n114|\n115|func TestJointCommitReplaceFailureAborts(t *testing.T) {\n116|\tsource := []byte(\"source configuration\\n\")\n117|\treplacement := []byte(\"replacement configuration\\n\")\n118|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n119|\tmarker := jointMarker(configPath, source, replacement, snapshot.Generation)\n120|\treplaceErr := errors.New(\"replacement unavailable\")\n121|\t_, err := store.JointCommit(marker,\n122|\t\tfunc(TrustStore) error { return nil },\n123|\t\tfunc() error { return replaceErr })\n124|\tif err == nil {\n125|\t\tt.Fatal(\"JointCommit(failing replace) succeeded, want refusal\")\n126|\t} else if !errors.Is(err, replaceErr) {\n127|\t\tt.Fatalf(\"JointCommit error = %v, want the replace failure\", err)\n128|\t}\n129|\tfresh, err := store.ReadSnapshot()\n130|\tif err != nil {\n131|\t\tt.Fatal(err)\n132|\t}\n133|\tif fresh.Generation != snapshot.Generation {\n134|\t\tt.Fatalf(\"aborted joint commit moved generation to %d\", fresh.Generation)\n135|\t}\n136|\tif _, err := os.Lstat(pendingPath(store.root)); !os.IsNotExist(err) {\n137|\t\tt.Fatalf(\"joint marker remains after aborted commit: %v\", err)\n138|\t}\n139|}\n140|\n(more lines below)","final_result":true}}}
