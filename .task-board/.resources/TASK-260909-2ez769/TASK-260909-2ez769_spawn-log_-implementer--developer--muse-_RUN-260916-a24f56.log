{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb51","stream":{"kind":"session","id":"01a0aa3d-f870-72c3-b067-9f985ccf069d"},"sequence":1027,"recorded_at":1780531400002049,"record_type":"event","durability":"durable","causation_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","run_stream":{"kind":"run","id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01"},"call_id":"call_01a0aa40b57371c7b335daef5c2e4265","text":"{\n  \"chunk_id\": \"exec-21-1\",\n  \"command\": \"grep -n \\\"openForTest\\\\|func (store \\\\*Store) Revoke\\\\|func (store \\\\*Store) Rotate\\\\|func (store \\\\*Store) MarkRetiring\\\" internal/hosttrust/*.go | grep -v _test; echo ===; sed -n '1,80p' internal/hosttrust/rotate.go\",\n  \"description\": \"Find test opener and rotation entry points\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"internal/hosttrust/rotate.go:24:func (store *Store) Rotate(hostID string, now time.Time) (newCredentialID string, retireAt time.Time, err error) {\\ninternal/hosttrust/rotate.go:137:func (store *Store) MarkRetiring(credentialID string, retireAt, now time.Time) error {\\ninternal/hosttrust/rotate.go:191:func (store *Store) Revoke(credentialID string) error {\\n===\\npackage hosttrust\\n\\nimport (\\n\\t\\\"crypto/x509\\\"\\n\\t\\\"encoding/pem\\\"\\n\\t\\\"errors\\\"\\n\\t\\\"path/filepath\\\"\\n\\t\\\"time\\\"\\n\\n\\t\\\"github.com/relux-works/agent-session-manager/internal/scalar\\\"\\n)\\n\\n// RotationBound is the maximum overlap of an old credential after the trust\\n// transition admits its replacement: 24 hours, and never past old leaf\\n// expiry. There is no overlap extension.\\nconst RotationBound = 24 * time.Hour\\n\\n// Rotate keeps the host UUID and creates a new credential with two fresh keys\\n// and certificates. The local atomic trust transition admits the new entry as\\n// active and marks the old entry retiring with a fixed retire_at no more than\\n// 24 hours after the transition and no later than old leaf expiry. No second\\n// rotation starts until the retiring entry is revoked. Failed enrollment\\n// leaves the new route unavailable, never auto-trusted.\\nfunc (store *Store) Rotate(hostID string, now time.Time) (newCredentialID string, retireAt time.Time, err error) {\\n\\tparsed, err := scalar.ParseUUIDv7(hostID)\\n\\tif err != nil {\\n\\t\\treturn \\\"\\\", time.Time{}, trustError(TrustError{Operation: \\\"rotate host\\\", Err: errors.Join(ErrRotationRefused, err)})\\n\\t}\\n\\tissued, err := IssueCredential(parsed.String(), now, nil)\\n\\tif err != nil {\\n\\t\\treturn \\\"\\\", time.Time{}, err\\n\\t}\\n\\tcredentialHex := scalar.SHA256Digest(issued.LeafDER).Hex()\\n\\tdirectory := filepath.Join(store.root, credentialsDir, credentialHex)\\n\\tif err := ensureOwnerDir(store.fs, directory, 0o700); err != nil {\\n\\t\\treturn \\\"\\\", time.Time{}, err\\n\\t}\\n\\tcommitted := false\\n\\tdefer func() {\\n\\t\\tif !committed {\\n\\t\\t\\t_ = store.fs.Remove(filepath.Join(directory, certificateFile))\\n\\t\\t\\t_ = store.fs.Remove(filepath.Join(directory, privateKeyFile))\\n\\t\\t\\t_ = store.fs.Remove(filepath.Join(directory, rootFile))\\n\\t\\t\\t_ = store.fs.Remove(directory)\\n\\t\\t}\\n\\t}()\\n\\tif err := writeCustodyFile(store, directory, certificateFile, pem.EncodeToMemory(&pem.Block{Type: \\\"CERTIFICATE\\\", Bytes: issued.LeafDER})); err != nil {\\n\\t\\treturn \\\"\\\", time.Time{}, err\\n\\t}\\n\\tif err := writeCustodyFile(store, directory, privateKeyFile, pem.EncodeToMemory(&pem.Block{Type: \\\"PRIVATE KEY\\\", Bytes: issued.LeafKeyDER})); err != nil {\\n\\t\\treturn \\\"\\\", time.Time{}, err\\n\\t}\\n\\tif err := writeCustodyFile(store, directory, rootFile, pem.EncodeToMemory(&pem.Block{Type: \\\"CERTIFICATE\\\", Bytes: issued.RootDER})); err != nil {\\n\\t\\treturn \\\"\\\", time.Time{}, err\\n\\t}\\n\\tenrolledAt, err := scalar.ParseTimestamp(now.UTC().Format(\\\"2006-01-02T15:04:05.000Z\\\"))\\n\\tif err != nil {\\n\\t\\treturn \\\"\\\", time.Time{}, trustError(TrustError{Operation: \\\"rotate timestamp\\\", Err: errors.Join(ErrRotationRefused, err)})\\n\\t}\\n\\tnewEntry := CredentialEntry{\\n\\t\\tHostID:       issued.HostID,\\n\\t\\tCredentialID: scalar.SHA256Digest(issued.LeafDER),\\n\\t\\tSPKIID:       scalar.SHA256Digest(mustSPKI(issued.LeafDER)),\\n\\t\\tRootID:       scalar.SHA256Digest(issued.RootDER),\\n\\t\\tLeafDER:      issued.LeafDER,\\n\\t\\tRootDER:      issued.RootDER,\\n\\t\\tState:        EntryActive,\\n\\t\\tEnrolledAt:   enrolledAt,\\n\\t}\\n\\tvar fixedRetireAt time.Time\\n\\tif err := store.transact(func(trust *TrustStore) error {\\n\\t\\told, err := rotationPredecessor(trust, parsed.String())\\n\\t\\tif err != nil {\\n\\t\\t\\treturn err\\n\\t\\t}\\n\\t\\toldLeaf, err := x509.ParseCertificate(old.LeafDER)\\n\\t\\tif err != nil {\\n\\t\\t\\treturn trustError(TrustError{Operation: \\\"rotate predecessor\\\", Err: errors.Join(ErrRotationRefused, err)})\\n\\t\\t}\\n\\t\\tdeadline := now.Add(RotationBound)\\n\",\n  \"original_output_bytes\": 3661,\n  \"original_output_tokens\": 916,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb53","stream":{"kind":"session","id":"01a0aa3d-f870-72c3-b067-9f985ccf069d"},"sequence":1028,"recorded_at":1780531400002051,"record_type":"event","durability":"durable","causation_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","run_stream":{"kind":"run","id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01"},"call_id":"call_01a0aa40bade7590a6001f7c75800cc9","text":"Read text file `internal/config/migration_v4.go`.\n1|package config\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"time\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/hosttrust\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|var (\n12|\t// ErrMigrationV4ConfirmRequired reports an ApplyV4 call without explicit\n13|\t// operator confirmation of the exact preview.\n14|\tErrMigrationV4ConfirmRequired = errors.New(\"configuration 4.0.0 apply requires explicit confirmation\")\n15|\t// ErrMigrationV4StaleSource reports a preview applied after the selected\n16|\t// configuration changed. The operator must preview again.\n17|\tErrMigrationV4StaleSource = errors.New(\"configuration 4.0.0 preview source changed\")\n18|\t// ErrMigrationV4StaleGeneration reports a preview applied after the\n19|\t// trust generation moved. The operator must preview again.\n20|\tErrMigrationV4StaleGeneration = errors.New(\"configuration 4.0.0 preview trust generation changed\")\n21|\t// ErrMigrationV4PreviewMismatch reports preview bytes that do not match\n22|\t// the replacement rendered from current state. Only the exact preview\n23|\t// applies.\n24|\tErrMigrationV4PreviewMismatch = errors.New(\"configuration 4.0.0 preview does not match current state\")\n25|\t// ErrMigrationV4Credential reports a selected credential that is\n26|\t// missing, not enrolled for the local host, not active, or outside its\n27|\t// validity window.\n28|\tErrMigrationV4Credential = errors.New(\"configuration 4.0.0 selected credential is not admitted\")\n29|\t// ErrMigrationV4PeerEnrollment reports retained peers without a complete\n30|\t// local enrollment. A missing peer enrollment blocks activation; the\n31|\t// operator may explicitly remove a peer from the preview instead.\n32|\tErrMigrationV4PeerEnrollment = errors.New(\"configuration 4.0.0 peer enrollment incomplete\")\n33|\t// ErrMigrationV4DropUnknown reports an explicit peer removal naming a\n34|\t// host that is not a configured peer. Silent drops are impossible: only\n35|\t// named configured peers leave the preview.\n36|\tErrMigrationV4DropUnknown = errors.New(\"configuration 4.0.0 explicit peer removal names an unknown peer\")\n37|\t// ErrRollbackV4AckRequired reports a rollback without acknowledgement\n38|\t// that the legacy installation has no Host Channel assurance.\n39|\tErrRollbackV4AckRequired = errors.New(\"configuration rollback requires no-host-channel-assurance acknowledgement\")\n40|\t// ErrRollbackV4Backup reports a missing, unreadable or undecodable\n41|\t// rollback backup. Rollback replaces configuration only from the\n42|\t// preserved backup bytes.\n43|\tErrRollbackV4Backup = errors.New(\"configuration rollback backup is missing or invalid\")\n44|\t// ErrRollbackV4StaleSource reports a rollback attempted after the\n45|\t// selected configuration changed. The operator must start over from\n46|\t// the current state.\n47|\tErrRollbackV4StaleSource = errors.New(\"configuration rollback source changed\")\n48|\t// ErrRollbackV4StaleGeneration reports a rollback attempted after the\n49|\t// trust generation moved. The operator must start over from the\n50|\t// current state.\n51|\tErrRollbackV4StaleGeneration = errors.New(\"configuration rollback trust generation changed\")\n52|)\n53|\n54|// V4Preview is the exact Config-4 replacement an operator confirms.\n55|// SourceDocument and SourceGeneration pin the state the preview was rendered\n56|// from; Replacement is the only byte sequence ApplyV4 installs. RetainedPeers\n57|// and DroppedPeers name every configured peer exactly once; BlockingPeers is\n58|// empty on success and names the unenrolled peers on refusal.\n59|type V4Preview struct {\n60|\tSourceVersion    string\n61|\tSourceDocument   []byte\n62|\tSourceGeneration uint64\n63|\tCredentialID     string\n64|\tReplacement      []byte\n65|\tRetainedPeers    []string\n66|\tDroppedPeers     []string\n67|\tBlockingPeers    []string\n68|}\n69|\n70|// V4ApplyResult reports a durable Config-4 apply with the committed trust\n71|// generation that authorizes the new streams.\n72|type V4ApplyResult struct {\n73|\tMigration  MigrationResult\n74|\tGeneration uint64\n75|}\n76|\n77|// RollbackV4Options carries the explicit operator acknowledgement. Without\n78|// AcknowledgeNoHostChannelAssurance the rollback refuses: returning to a\n79|// legacy installation abandons Host Channel assurance, and that is never a\n80|// connection retry.\n81|type RollbackV4Options struct {\n82|\tAcknowledgeNoHostChannelAssurance bool\n83|\tBackupPath                        string\n84|}\n85|\n86|// PreviewV4 renders the exact Config-4 replacement for an explicit operator\n87|// decision. Migration is never first-connect behavior: the source must\n88|// already be Configuration 3.0.0 (older inputs first use the existing\n89|// explicit migrations), the selected credential must be actively enrolled for\n90|// the local host, and every retained peer must be completely enrolled\n91|// locally. The preview commits nothing.\n92|func PreviewV4(inputs Inputs, overrides Overrides, trust hosttrust.Snapshot, credentialID string, dropPeers []string, now time.Time) (V4Preview, error) {\n93|\tsnapshot, err := Load(inputs, overrides)\n94|\tif err != nil {\n95|\t\treturn V4Preview{}, err\n96|\t}\n97|\tloaded, decoded := snapshot.Configuration()\n98|\tif !snapshot.ConfigPresent() || !decoded {\n99|\t\treturn V4Preview{}, migrationError(MigrationError{Operation: \"load source\", Err: ErrMigrationSourceAbsent})\n100|\t}\n101|\tif loaded.SourceVersion != CurrentVersion {\n102|\t\treturn V4Preview{}, migrationError(MigrationError{Operation: \"select source\", Err: ErrMigrationV4Source})\n103|\t}\n104|\tpreview, err := renderV4Preview(snapshot.Document(), loaded.Value, trust, credentialID, dropPeers, now, inputs)\n105|\tif err != nil {\n106|\t\treturn preview, err\n107|\t}\n108|\treturn preview, nil\n109|}\n110|\n111|func renderV4Preview(document []byte, value Configuration, trust hosttrust.Snapshot, credentialID string, dropPeers []string, now time.Time, inputs Inputs) (V4Preview, error) {\n112|\tpreview := V4Preview{\n113|\t\tSourceVersion:    CurrentVersion,\n114|\t\tSourceDocument:   append([]byte(nil), document...),\n115|\t\tSourceGeneration: trust.Generation,\n116|\t\tCredentialID:     credentialID,\n117|\t}\n118|\tdigest, err := scalar.ParseDigest(credentialID)\n119|\tif err != nil {\n120|\t\treturn preview, migrationError(MigrationError{Operation: \"select credential\", Err: errors.Join(ErrMigrationV4Credential, err)})\n121|\t}\n122|\tlocal, found := findTrustEntry(trust, digest.String())\n123|\tif !found || local.HostID.String() != value.HostID || local.State != hosttrust.EntryActive {\n124|\t\treturn preview, migrationError(MigrationError{Operation: \"select credential\", Err: ErrMigrationV4Credential})\n125|\t}\n126|\tif err := checkCredentialWindow(local.LeafDER, local.RootDER, now); err != nil {\n127|\t\treturn preview, migrationError(MigrationError{Operation: \"select credential\", Err: errors.Join(ErrMigrationV4Credential, err)})\n128|\t}\n129|\tdropped := map[string]struct{}{}\n130|\tfor _, peer := range dropPeers {\n131|\t\tif _, exists := dropped[peer]; exists {\n132|\t\t\treturn preview, migrationError(MigrationError{Operation: \"select removals\", Err: ErrMigrationV4DropUnknown})\n133|\t\t}\n134|\t\tdropped[peer] = struct{}{}\n135|\t}\n136|\tvar retained []Peer\n137|\tfor _, peer := range value.Mesh.Peers {\n138|\t\tif _, remove := dropped[peer.HostID]; remove {\n139|\t\t\tpreview.DroppedPeers = append(preview.DroppedPeers, peer.HostID)\n140|\t\t\tcontinue\n141|\t\t}\n142|\t\tif _, remove := dropped[peer.Name]; remove {\n143|\t\t\treturn preview, migrationError(MigrationError{Operation: \"select removals\", Err: ErrMigrationV4DropUnknown})\n144|\t\t}\n145|\t\tpreview.RetainedPeers = append(preview.RetainedPeers, peer.HostID)\n146|\t\tretained = append(retained, peer)\n147|\t}\n148|\tfor peer := range dropped {\n149|\t\tknown := false\n150|\t\tfor _, candidate := range value.Mesh.Peers {\n151|\t\t\tif candidate.HostID == peer {\n152|\t\t\t\tknown = true\n153|\t\t\t\tbreak\n154|\t\t\t}\n155|\t\t}\n156|\t\tif !known {\n157|\t\t\treturn preview, migrationError(MigrationError{Operation: \"select removals\", Err: ErrMigrationV4DropUnknown})\n158|\t\t}\n159|\t}\n160|\tfor _, peer := range retained {\n161|\t\tif !peerEnrolled(trust, peer.HostID, now) {\n162|\t\t\tpreview.BlockingPeers = append(preview.BlockingPeers, peer.HostID)\n163|\t\t}\n164|\t}\n165|\tif len(preview.BlockingPeers) > 0 {\n166|\t\treturn preview, migrationError(MigrationError{Operation: \"validate peer enrollment\", Err: ErrMigrationV4PeerEnrollment})\n167|\t}\n168|\tnext := value\n169|\tnext.Mesh.Transport = TransportSSHTLS13\n170|\tnext.Mesh.HostChannel = &HostChannel{Version: HostChannelVersion, CredentialID: digest.String()}\n171|\tnext.Mesh.Peers = retained\n172|\tcontext := DecodeContext{RuntimePlatform: inputs.Platform, BackendSettings: inputs.BackendSettings}\n173|\treplacement, err := EncodeVersion4(next, context)\n174|\tif err != nil {\n175|\t\treturn preview, migrationError(MigrationError{Operation: \"encode target\", Err: err}) // config-refusal-subsumed: the preview pre-validates credential, enrollment, removals and source under the same context, so the v4 encoder admits only values its own clauses already accepted; any refusal here repeats a clause pinned above\n176|\t}\n177|\tpreview.Replacement = replacement\n178|\treturn preview, nil\n179|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
