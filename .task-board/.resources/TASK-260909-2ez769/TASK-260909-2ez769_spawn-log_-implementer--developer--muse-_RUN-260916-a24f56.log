{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c82d","stream":{"kind":"session","id":"01a0aa3d-f870-72c3-b067-9f985ccf069d"},"sequence":625,"recorded_at":1780531400001245,"record_type":"event","durability":"durable","causation_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","run_stream":{"kind":"run","id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01"},"call_id":"call_01a0aa3f9acc70108e0447b6ec6eba62","text":"Read text file `internal/hosttrust/lock_unix.go`.\n1|//go:build darwin || linux\n2|\n3|package hosttrust\n4|\n5|import (\n6|\t\"errors\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"sync\"\n10|\n11|\t\"golang.org/x/sys/unix\"\n12|)\n13|\n14|// fileLock is the machine-local cross-process authorization lock shared by\n15|// trust changes and Configuration 4.0.0 peer/credential changes. Readers hold\n16|// it shared; transactions hold it exclusive, so a revocation or config commit\n17|// can never land between a dispatch check and its side-effect boundary.\n18|//\n19|// Every acquisition opens its own file description: flock locks attach to the\n20|// open file description, so goroutines sharing one retained descriptor would\n21|// not serialize. Per-acquisition descriptors make both same-process\n22|// goroutines and separate processes block on a held exclusive lock. A caller\n23|// must never request a second acquisition while holding one in the same\n24|// goroutine; internal reads nested inside a holder use descriptor-direct\n25|// unlocked reads instead of re-acquiring.\n26|type fileLock struct {\n27|\tpath string\n28|}\n29|\n30|// lockInitMu serializes concurrent creation of the lock file itself.\n31|var lockInitMu sync.Mutex\n32|\n33|func openLock(filesystem FileSystem, path string) (*fileLock, error) {\n34|\tlockInitMu.Lock()\n35|\tdefer lockInitMu.Unlock()\n36|\tinfo, err := filesystem.Lstat(path)\n37|\tif err != nil {\n38|\t\tif !os.IsNotExist(err) {\n39|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n40|\t\t}\n41|\t\tstaged, err := filesystem.CreateTemp(filepath.Dir(path), \"lock-stage-*\", 0o600)\n42|\t\tif err != nil {\n43|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n44|\t\t}\n45|\t\tname := staged.Name()\n46|\t\t_ = staged.Close()\n47|\t\tif err := filesystem.Rename(name, path); err != nil {\n48|\t\t\t_ = filesystem.Remove(name)\n49|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n50|\t\t}\n51|\t\tif err := filesystem.Chmod(path, 0o600); err != nil {\n52|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n53|\t\t}\n54|\t\tif err := secureStaged(path, false); err != nil {\n55|\t\t\treturn nil, err\n56|\t\t}\n57|\t\tinfo, err = filesystem.Lstat(path)\n58|\t\tif err != nil {\n59|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n60|\t\t}\n61|\t}\n62|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n63|\t\treturn nil, err\n64|\t}\n65|\treturn &fileLock{path: path}, nil\n66|}\n67|\n68|// openLockFD opens one private file description for a single acquisition.\n69|// O_NOFOLLOW refuses symlink escapes at open time; the descriptor never\n70|// follows a link swapped in after Lstat.\n71|func openLockFD(path string) (int, error) {\n72|\tfd, err := unix.Open(path, unix.O_RDWR|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)\n73|\tif err != nil {\n74|\t\tjoined := errors.Join(ErrTrustStoreUnreadable, err)\n75|\t\tif errors.Is(err, unix.ELOOP) {\n76|\t\t\tjoined = errors.Join(ErrTrustUnsafeCustody, err)\n77|\t\t}\n78|\t\treturn -1, trustError(TrustError{Operation: \"open lock\", Err: joined})\n79|\t}\n80|\treturn fd, nil\n81|}\n82|\n83|func (lock *fileLock) shared() (func(), error) {\n84|\tfd, err := openLockFD(lock.path)\n85|\tif err != nil {\n86|\t\treturn nil, err\n87|\t}\n88|\tif err := unix.Flock(fd, unix.LOCK_SH); err != nil {\n89|\t\t_ = unix.Close(fd)\n90|\t\treturn nil, err\n91|\t}\n92|\treturn func() {\n93|\t\t_ = unix.Flock(fd, unix.LOCK_UN)\n94|\t\t_ = unix.Close(fd)\n95|\t}, nil\n96|}\n97|\n98|func (lock *fileLock) exclusive() (func(), error) {\n99|\tfd, err := openLockFD(lock.path)\n100|\tif err != nil {\n101|\t\treturn nil, err\n102|\t}\n103|\tif err := unix.Flock(fd, unix.LOCK_EX); err != nil {\n104|\t\t_ = unix.Close(fd)\n105|\t\treturn nil, err\n106|\t}\n107|\treturn func() {\n108|\t\t_ = unix.Flock(fd, unix.LOCK_UN)\n109|\t\t_ = unix.Close(fd)\n110|\t}, nil\n111|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c82f","stream":{"kind":"session","id":"01a0aa3d-f870-72c3-b067-9f985ccf069d"},"sequence":626,"recorded_at":1780531400001247,"record_type":"event","durability":"durable","causation_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","run_stream":{"kind":"run","id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01"},"call_id":"call_01a0aa3f9cc471278f6e660204fbf1ea","text":"Read text file `internal/hosttrust/lock_windows.go`.\n1|//go:build windows\n2|\n3|package hosttrust\n4|\n5|import (\n6|\t\"errors\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"sync\"\n10|\n11|\t\"golang.org/x/sys/windows\"\n12|)\n13|\n14|// fileLock is the machine-local cross-process authorization lock shared by\n15|// trust changes and Configuration 4.0.0 peer/credential changes. Readers hold\n16|// it shared; transactions hold it exclusive.\n17|//\n18|// Every acquisition opens its own handle: Windows byte-range locks attach to\n19|// the file object, so goroutines sharing one retained handle would not\n20|// serialize. Per-acquisition handles make both same-process goroutines and\n21|// separate processes block on a held exclusive lock. A caller must never\n22|// request a second acquisition while holding one in the same goroutine;\n23|// internal reads nested inside a holder use handle-direct unlocked reads\n24|// instead of re-acquiring.\n25|type fileLock struct {\n26|\tpath string\n27|}\n28|\n29|// lockInitMu serializes concurrent creation of the lock file itself.\n30|var lockInitMu sync.Mutex\n31|\n32|func openLock(filesystem FileSystem, path string) (*fileLock, error) {\n33|\tlockInitMu.Lock()\n34|\tdefer lockInitMu.Unlock()\n35|\tinfo, err := filesystem.Lstat(path)\n36|\tif err != nil {\n37|\t\tif !os.IsNotExist(err) {\n38|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n39|\t\t}\n40|\t\tstaged, err := filesystem.CreateTemp(filepath.Dir(path), \"lock-stage-*\", 0o600)\n41|\t\tif err != nil {\n42|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n43|\t\t}\n44|\t\tname := staged.Name()\n45|\t\t_ = staged.Close()\n46|\t\tif err := filesystem.Rename(name, path); err != nil {\n47|\t\t\t_ = filesystem.Remove(name)\n48|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n49|\t\t}\n50|\t\tif err := filesystem.Chmod(path, 0o600); err != nil {\n51|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n52|\t\t}\n53|\t\tif err := secureStaged(path, false); err != nil {\n54|\t\t\treturn nil, err\n55|\t\t}\n56|\t\tinfo, err = filesystem.Lstat(path)\n57|\t\tif err != nil {\n58|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n59|\t\t}\n60|\t}\n61|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n62|\t\treturn nil, err\n63|\t}\n64|\treturn &fileLock{path: path}, nil\n65|}\n66|\n67|func openLockHandle(path string) (windows.Handle, error) {\n68|\tname, err := windows.UTF16PtrFromString(path)\n69|\tif err != nil {\n70|\t\treturn 0, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n71|\t}\n72|\thandle, err := windows.CreateFile(name, windows.GENERIC_READ|windows.GENERIC_WRITE,\n73|\t\twindows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING,\n74|\t\twindows.FILE_ATTRIBUTE_NORMAL, 0)\n75|\tif err != nil {\n76|\t\treturn 0, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n77|\t}\n78|\treturn handle, nil\n79|}\n80|\n81|func (lock *fileLock) shared() (func(), error) {\n82|\thandle, err := openLockHandle(lock.path)\n83|\tif err != nil {\n84|\t\treturn nil, err\n85|\t}\n86|\toverlapped := new(windows.Overlapped)\n87|\tif err := windows.LockFileEx(handle, 0, 0, 1, 0, overlapped); err != nil {\n88|\t\t_ = windows.CloseHandle(handle)\n89|\t\treturn nil, err\n90|\t}\n91|\treturn func() {\n92|\t\t_ = windows.UnlockFileEx(handle, 0, 1, 0, overlapped)\n93|\t\t_ = windows.CloseHandle(handle)\n94|\t}, nil\n95|}\n96|\n97|func (lock *fileLock) exclusive() (func(), error) {\n98|\thandle, err := openLockHandle(lock.path)\n99|\tif err != nil {\n100|\t\treturn nil, err\n101|\t}\n102|\toverlapped := new(windows.Overlapped)\n103|\tif err := windows.LockFileEx(handle, windows.LOCKFILE_EXCLUSIVE_LOCK, 0, 1, 0, overlapped); err != nil {\n104|\t\t_ = windows.CloseHandle(handle)\n105|\t\treturn nil, err\n106|\t}\n107|\treturn func() {\n108|\t\t_ = windows.UnlockFileEx(handle, 0, 1, 0, overlapped)\n109|\t\t_ = windows.CloseHandle(handle)\n110|\t}, nil\n111|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c831","stream":{"kind":"session","id":"01a0aa3d-f870-72c3-b067-9f985ccf069d"},"sequence":627,"recorded_at":1780531400001249,"record_type":"event","durability":"durable","causation_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01","run_stream":{"kind":"run","id":"293ce3c3-411f-4a5d-bb7d-d441c56eec01"},"call_id":"call_01a0aa3f9e8d756483e86cabd7ff0b68","text":"Read text file `internal/hosttrust/custody.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"io\"\n6|\t\"io/fs\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|)\n10|\n11|const (\n12|\thostChannelDir  = \"host-channel\"\n13|\ttrustFileName   = \"trust.json\"\n14|\tlockFileName    = \"lock\"\n15|\tcredentialsDir  = \"credentials\"\n16|\tcertificateFile = \"certificate.pem\"\n17|\tprivateKeyFile  = \"private-key.pem\"\n18|\trootFile        = \"root.pem\"\n19|\tstagePrefix     = \".trust-stage-\"\n20|)\n21|\n22|// FileSystem abstracts durable writes so crash and fault paths are testable\n23|// without touching the operator disk. The OS implementation is the only\n24|// production backend.\n25|type FileSystem interface {\n26|\tCreateTemp(dir, pattern string, mode fs.FileMode) (StagedFile, error)\n27|\tReadFile(name string) ([]byte, error)\n28|\tLstat(name string) (fs.FileInfo, error)\n29|\tStat(name string) (fs.FileInfo, error)\n30|\tRemove(name string) error\n31|\tRename(oldname, newname string) error\n32|\tMkdirAll(path string, mode fs.FileMode) error\n33|\tChmod(name string, mode fs.FileMode) error\n34|\tOpenDirectory(name string) (SyncedDirectory, error)\n35|\tReadDir(name string) ([]fs.DirEntry, error)\n36|}\n37|\n38|// StagedFile is one temp staging file awaiting fsync and atomic rename.\n39|type StagedFile interface {\n40|\tio.Writer\n41|\tName() string\n42|\tChmod(fs.FileMode) error\n43|\tSync() error\n44|\tClose() error\n45|}\n46|\n47|// SyncedDirectory fsyncs a directory entry after renames.\n48|type SyncedDirectory interface {\n49|\tSync() error\n50|\tClose() error\n51|}\n52|\n53|type osFileSystem struct{}\n54|\n55|func (osFileSystem) CreateTemp(dir, pattern string, mode fs.FileMode) (StagedFile, error) {\n56|\tfile, err := os.CreateTemp(dir, pattern)\n57|\tif err != nil {\n58|\t\treturn nil, err\n59|\t}\n60|\tif err := file.Chmod(mode); err != nil {\n61|\t\t_ = file.Close()\n62|\t\t_ = os.Remove(file.Name())\n63|\t\treturn nil, err\n64|\t}\n65|\treturn file, nil\n66|}\n67|\n68|func (osFileSystem) ReadFile(name string) ([]byte, error)   { return os.ReadFile(name) }\n69|func (osFileSystem) Lstat(name string) (fs.FileInfo, error) { return os.Lstat(name) }\n70|func (osFileSystem) Stat(name string) (fs.FileInfo, error)  { return os.Stat(name) }\n71|func (osFileSystem) Remove(name string) error               { return os.Remove(name) }\n72|func (osFileSystem) Rename(oldname, newname string) error   { return os.Rename(oldname, newname) }\n73|\n74|func (osFileSystem) MkdirAll(path string, mode fs.FileMode) error { return os.MkdirAll(path, mode) }\n75|func (osFileSystem) Chmod(name string, mode fs.FileMode) error    { return os.Chmod(name, mode) }\n76|\n77|func (osFileSystem) OpenDirectory(name string) (SyncedDirectory, error) { return os.Open(name) }\n78|func (osFileSystem) ReadDir(name string) ([]fs.DirEntry, error)         { return os.ReadDir(name) }\n79|\n80|// Store is machine-local Host Channel authority rooted at\n81|// STATE_DIR/host-channel. The zero value is unusable; construct with Open.\n82|type Store struct {\n83|\troot string\n84|\tfs   FileSystem\n85|\tlock *fileLock\n86|}\n87|\n88|// Open validates owner-only custody of STATE_DIR/host-channel, creating the\n89|// directory skeleton with exact 0700/0600 modes when absent. Every open\n90|// re-verifies custody: symlink escapes, foreign ownership and group/world\n91|// access refuse with ErrTrustUnsafeCustody.\n92|func Open(stateDir string) (*Store, error) { return openStore(stateDir, osFileSystem{}) }\n93|\n94|func openStore(stateDir string, filesystem FileSystem) (*Store, error) {\n95|\tif filesystem == nil {\n96|\t\treturn nil, trustError(TrustError{Operation: \"open store\", Err: ErrInvalidStoreContext})\n97|\t}\n98|\tif !filepath.IsAbs(stateDir) {\n99|\t\treturn nil, trustError(TrustError{Operation: \"open store\", Err: ErrInvalidStoreContext})\n100|\t}\n101|\troot := filepath.Join(stateDir, hostChannelDir)\n102|\tif err := ensureOwnerDir(filesystem, root, 0o700); err != nil {\n103|\t\treturn nil, err\n104|\t}\n105|\tif err := ensureOwnerDir(filesystem, filepath.Join(root, credentialsDir), 0o700); err != nil {\n106|\t\treturn nil, err\n107|\t}\n108|\tlock, err := openLock(filesystem, filepath.Join(root, lockFileName))\n109|\tif err != nil {\n110|\t\treturn nil, err\n111|\t}\n112|\tstore := &Store{root: root, fs: filesystem, lock: lock}\n113|\t// Converge one interrupted joint config-plus-trust commit, if any: a\n114|\t// crash between the configuration replacement and the generation bump\n115|\t// must complete forward or abort on restart, never admit the new\n116|\t// configuration with the old generation. A refused recovery fails the\n117|\t// open so incoherent state cannot be used.\n118|\tif _, err := store.Recover(); err != nil {\n119|\t\treturn nil, err\n120|\t}\n121|\treturn store, nil\n122|}\n123|\n124|// Root reports the validated host-channel directory. It carries no secrets.\n125|func (store *Store) Root() string { return store.root }\n126|\n127|// TrustPath reports the trust.json path for operator diagnostics. Reading or\n128|// writing it directly bypasses the authorization lock; use transactions.\n129|func (store *Store) TrustPath() string { return filepath.Join(store.root, trustFileName) }\n130|\n131|// CredentialDir reports the custody directory for one credential ID hex. It\n132|// carries no key material.\n133|func (store *Store) CredentialDir(credentialHex string) (string, error) {\n134|\tif len(credentialHex) != 64 {\n135|\t\treturn \"\", trustError(TrustError{Operation: \"resolve credential directory\", Err: ErrCredentialCustody})\n136|\t}\n137|\tfor _, unit := range credentialHex {\n138|\t\tif (unit < '0' || unit > '9') && (unit < 'a' || unit > 'f') {\n139|\t\t\treturn \"\", trustError(TrustError{Operation: \"resolve credential directory\", Err: ErrCredentialCustody})\n140|\t\t}\n141|\t}\n142|\treturn filepath.Join(store.root, credentialsDir, credentialHex), nil\n143|}\n144|\n145|func ensureOwnerDir(filesystem FileSystem, path string, mode fs.FileMode) error {\n146|\tinfo, err := filesystem.Lstat(path)\n147|\tif err != nil && !os.IsNotExist(err) {\n148|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n149|\t}\n150|\tif err == nil {\n151|\t\t// An existing directory is verified, never repaired: silently\n152|\t\t// narrowing a widened directory would mask the custody violation.\n153|\t\treturn verifyOwnerDir(path, info, mode)\n154|\t}\n155|\tif err := filesystem.MkdirAll(path, mode); err != nil {\n156|\t\treturn trustError(TrustError{Operation: \"create directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n157|\t}\n158|\t// MkdirAll honors umask, so the exact owner-only mode is enforced\n159|\t// explicitly after creation.\n160|\tif err := filesystem.Chmod(path, mode); err != nil {\n161|\t\treturn trustError(TrustError{Operation: \"create directory\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n162|\t}\n163|\t// On platforms where mode bits do not govern access, install the\n164|\t// owner-only ACL at creation: verification below would otherwise\n165|\t// refuse the directory the store just created.\n166|\tif err := secureStaged(path, true); err != nil {\n167|\t\treturn err\n168|\t}\n169|\tinfo, err = filesystem.Lstat(path)\n170|\tif err != nil {\n171|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n172|\t}\n173|\treturn verifyOwnerDir(path, info, mode)\n174|}\n175|\n176|func verifyOwnerDir(path string, info fs.FileInfo, mode fs.FileMode) error {\n177|\tif !info.IsDir() {\n178|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: ErrTrustUnsafeCustody})\n179|\t}\n180|\tif info.Mode()&fs.ModeSymlink != 0 {\n181|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: ErrTrustUnsafeCustody})\n182|\t}\n183|\t// Permission bits are a Unix signal only: on Windows the DACL governs and\n184|\t// Go synthesizes mode bits from the read-only attribute, so an exact\n185|\t// comparison would refuse every Windows path. verifyOwner enforces the\n186|\t// owner-only DACL there.\n187|\tif !platformModeOK(info, mode) {\n188|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: ErrTrustUnsafeCustody})\n189|\t}\n190|\treturn verifyOwner(path, info)\n191|}\n192|\n193|func verifyOwnerFile(path string, info fs.FileInfo, mode fs.FileMode) error {\n194|\tif !info.Mode().IsRegular() {\n195|\t\treturn trustError(TrustError{Operation: \"inspect file\", Err: ErrTrustUnsafeCustody})\n196|\t}\n197|\tif info.Mode()&fs.ModeSymlink != 0 {\n198|\t\treturn trustError(TrustError{Operation: \"inspect file\", Err: ErrTrustUnsafeCustody})\n199|\t}\n200|\tif !platformModeOK(info, mode) {\n201|\t\treturn trustError(TrustError{Operation: \"inspect file\", Err: ErrTrustUnsafeCustody})\n202|\t}\n203|\treturn verifyOwner(path, info)\n204|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
