{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9b1","stream":{"kind":"session","id":"01a08900-d199-7822-974c-1de7f95bc0fc"},"sequence":819,"recorded_at":1780531400001633,"record_type":"event","durability":"durable","causation_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","run_stream":{"kind":"run","id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef"},"task_stream":{"kind":"task","id":"01a08903-ac51-7ed2-b503-dc696ecb248b"},"task_id":"01a08903-ac51-7ed2-b503-dc696ecb248b","event":{"kind":"output","task_id":"01a08903-ac51-7ed2-b503-dc696ecb248b","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1kiyj6/worktree/internal/hosttrust/export.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"fmt\"\n5|)\n6|\n7|// EnrollmentMaterial is the explicitly selected public enrollment material an\n8|// operator exchanges out of band. It carries no private key: only\n9|// certificate.pem and root.pem bytes leave the store, never private-key.pem,\n10|// trust internals, backups or authorization caches.\n11|type EnrollmentMaterial struct {\n12|\tHostID       string\n13|\tCredentialID string\n14|\tLeafDER      []byte\n15|\tRootDER      []byte\n16|\tFingerprints Fingerprints\n17|}\n18|\n19|// Formatting enrollment material redacts DER bytes by default; the operator\n20|// exports explicit fields, never a log line.\n21|func (EnrollmentMaterial) String() string   { return \"host enrollment material\" }\n22|func (EnrollmentMaterial) GoString() string { return \"host enrollment material\" }\n23|func (EnrollmentMaterial) Format(state fmt.State, verb rune) {\n24|\t_, _ = state.Write([]byte(\"host enrollment material\"))\n25|}\n26|\n27|// ExportEnrollment selects the public bytes of one non-revoked entry for\n28|// out-of-band exchange. Revoked tombstones never redistribute: exporting one\n29|// refuses.\n30|func ExportEnrollment(snapshot Snapshot, credentialID string) (EnrollmentMaterial, error) {\n31|\tentry, found := findEntry(snapshot.Trust, credentialID)\n32|\tif !found {\n33|\t\treturn EnrollmentMaterial{}, trustError(TrustError{Operation: \"export enrollment\", Err: ErrEnrollmentRefused})\n34|\t}\n35|\tif entry.State == EntryRevoked {\n36|\t\treturn EnrollmentMaterial{}, trustError(TrustError{Operation: \"export enrollment\", Err: ErrEnrollmentRefused})\n37|\t}\n38|\tfingerprints, err := FingerprintsOf(entry.LeafDER, entry.RootDER)\n39|\tif err != nil {\n40|\t\treturn EnrollmentMaterial{}, err\n41|\t}\n42|\treturn EnrollmentMaterial{\n43|\t\tHostID:       entry.HostID.String(),\n44|\t\tCredentialID: entry.CredentialID.String(),\n45|\t\tLeafDER:      append([]byte(nil), entry.LeafDER...),\n46|\t\tRootDER:      append([]byte(nil), entry.RootDER...),\n47|\t\tFingerprints: fingerprints,\n48|\t}, nil\n49|}\n50|\n51|// ExcludedFromReplication lists the STATE_DIR-relative paths that must never\n52|// enter replication, snapshots, cloning, Session Directory, logs or exported\n53|// diagnostic bundles. Credential, trust, backup, private-key and\n54|// authorization-cache material stays machine-local; operators exchange only\n55|// explicitly selected public enrollment material outside replication.\n56|func ExcludedFromReplication() []string {\n57|\treturn []string{\n58|\t\thostChannelDir + \"/trust.json\",\n59|\t\thostChannelDir + \"/credentials/\",\n60|\t\thostChannelDir + \"/lock\",\n61|\t}\n62|}","final_result":true}}}
