portEnrollment error = %v\", err)\n37|\t}\n38|\tif len(material.LeafDER) == 0 || len(material.RootDER) == 0 {\n39|\t\tt.Fatal(\"ExportEnrollment returned empty public bytes\")\n40|\t}\n41|\t// The operator verifies the tuple over the independent channel; the test\n42|\t// models a correct verification by authorizing the observed fingerprints.\n43|\tenrolled, err := store.Enroll(EnrollInput{\n44|\t\tHostID:     material.HostID,\n45|\t\tLeafDER:    material.LeafDER,\n46|\t\tRootDER:    material.RootDER,\n47|\t\tAuthorized: material.Fingerprints,\n48|\t\tEnrolledAt: at,\n49|\t})\n50|\tif err != nil {\n51|\t\tt.Fatalf(\"Enroll error = %v\", err)\n52|\t}\n53|\tif enrolled != peerCredential {\n54|\t\tt.Fatalf(\"Enroll = %s, want %s\", enrolled, peerCredential)\n55|\t}\n56|\treturn enrolled\n57|}\n58|\n59|func TestIssueSelfEnrollsActive(t *testing.T) {\n60|\tstore := setupStoreForTest(t)\n(more lines below)","final_result":true}}}
