{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c959","stream":{"kind":"session","id":"01a08900-d199-7822-974c-1de7f95bc0fc"},"sequence":775,"recorded_at":1780531400001545,"record_type":"event","durability":"durable","causation_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","run_stream":{"kind":"run","id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef"},"call_id":"call_01a089034c1b737192a8b3872f0939a1","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1kiyj6/worktree/internal/hosttrust/authorize.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"errors\"\n6|\t\"fmt\"\n7|\t\"time\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// AuthRequest carries one dispatch or mutation-boundary authorization check.\n13|// SnapshotGeneration binds the stream to the coherent snapshot it was opened\n14|// under; LocalCredentialID and the remote DER bytes select the exact enrolled\n15|// entries; Allowlisted is the local mesh allowlist; HelloHostID is the\n16|// authenticated hello identity; ExpectedRemoteHostID is the selected\n17|// configured destination on the client.\n18|type AuthRequest struct {\n19|\tSnapshotGeneration   uint64\n20|\tLocalHostID          string\n21|\tLocalCredentialID    string\n22|\tRemoteLeafDER        []byte\n23|\tRemoteRootDER        []byte\n24|\tExpectedRemoteHostID string\n25|\tAllowlisted          []string\n26|\tHelloHostID          string\n27|\tNow                  time.Time\n28|}\n29|\n30|// Formatting an authorization request must never expose DER bytes, UUIDs,\n31|// digests or allowlists.\n32|func (AuthRequest) String() string   { return \"host channel authorization request\" }\n33|func (AuthRequest) GoString() string { return \"host channel authorization request\" }\n34|func (AuthRequest) Format(state fmt.State, verb rune) {\n35|\t_, _ = state.Write([]byte(\"host channel authorization request\"))\n36|}\n37|\n38|// Formatting a snapshot must never expose the entries it binds.\n39|func (Snapshot) String() string   { return \"host trust snapshot\" }\n40|func (Snapshot) GoString() string { return \"host trust snapshot\" }\n41|func (Snapshot) Format(state fmt.State, verb rune) {\n42|\t_, _ = state.Write([]byte(\"host trust snapshot\"))\n43|}\n44|\n45|// AuthorizeDispatch checks current generation, local credential validity,\n46|// allowlist membership and authenticated hello under the shared authorization\n47|// lock, so a revocation or config commit cannot land between the check and\n48|// the dispatch it admits. Work prepared under an old generation cannot gain\n49|// new authority by refreshing a cached number: a stale snapshot refuses.\n50|func (store *Store) AuthorizeDispatch(snapshot Snapshot, request AuthRequest) error {\n51|\tunlock, err := store.lock.shared()\n52|\tif err != nil {\n53|\t\treturn trustError(TrustError{Operation: \"authorize dispatch\", Err: errors.Join(ErrAuthorizationRefused, err)})\n54|\t}\n55|\tdefer unlock()\n56|\tcurrent, err := readCommitted(store)\n57|\tif err != nil {\n58|\t\treturn err\n59|\t}\n60|\t// The stream binding must match the snapshot it was opened under: work\n61|\t// prepared under an old generation cannot gain new authority by\n62|\t// refreshing a cached number.\n63|\tif request.SnapshotGeneration != snapshot.Generation {\n64|\t\treturn trustError(TrustError{Operation: \"authorize generation\", Err: ErrStaleGeneration})\n65|\t}\n66|\tif snapshot.Generation != current.Generation {\n67|\t\treturn trustError(TrustError{Operation: \"authorize generation\", Err: ErrStaleGeneration})\n68|\t}\n69|\treturn checkAuthorization(snapshot.Trust, request)\n70|}\n71|\n72|func readCommitted(store *Store) (TrustStore, error) {\n73|\tpath := store.TrustPath()\n74|\tinfo, err := store.fs.Lstat(path)\n75|\tif err != nil {\n76|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"authorize generation\", Err: errors.Join(ErrAuthorizationRefused, err)})\n77|\t}\n78|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n79|\t\treturn TrustStore{}, err\n80|\t}\n81|\tdocument, err := store.fs.ReadFile(path)\n82|\tif err != nil {\n83|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"authorize generation\", Err: errors.Join(ErrAuthorizationRefused, err)})\n84|\t}\n85|\tcommitted, err := DecodeTrust(document)\n86|\tif err != nil {\n87|\t\treturn TrustStore{}, err\n88|\t}\n89|\treturn committed, nil\n90|}\n91|\n92|func checkAuthorization(trust TrustStore, request AuthRequest) error {\n93|\tconst operation = \"authorize dispatch\"\n94|\tlocal, found := findEntry(trust, request.LocalCredentialID)\n95|\tif !found {\n96|\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n97|\t}\n98|\tif local.HostID.String() != request.LocalHostID || local.State != EntryActive {\n99|\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n100|\t}\n101|\tif err := VerifyProfile(local.LeafDER, local.RootDER, local.HostID.String(), request.Now); err != nil {\n102|\t\treturn trustError(TrustError{Operation: operation, Err: errors.Join(ErrAuthorizationRefused, err)})\n103|\t}\n104|\tremote, found := matchRemote(trust, request.RemoteLeafDER, request.RemoteRootDER)\n105|\tif !found {\n106|\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n107|\t}\n108|\tif err := VerifyProfile(remote.LeafDER, remote.RootDER, remote.HostID.String(), request.Now); err != nil {\n109|\t\treturn trustError(TrustError{Operation: operation, Err: errors.Join(ErrAuthorizationRefused, err)})\n110|\t}\n111|\tif remote.State == EntryRevoked {\n112|\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n113|\t}\n114|\tif remote.State == EntryRetiring {\n115|\t\tif remote.RetireAt == nil {\n116|\t\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n117|\t\t}\n118|\t\tretireAt, err := remote.RetireAt.Time()\n119|\t\tif err != nil || !request.Now.Before(retireAt) {\n120|\t\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n121|\t\t}\n122|\t}\n123|\tallowlisted := false\n124|\tfor _, hostID := range request.Allowlisted {\n125|\t\tif hostID == remote.HostID.String() {\n126|\t\t\tallowlisted = true\n127|\t\t\tbreak\n128|\t\t}\n129|\t}\n130|\tif !allowlisted {\n131|\t\treturn trustError(TrustError{Operation: operation, Err: ErrNotAllowlisted})\n132|\t}\n133|\tif request.HelloHostID != remote.HostID.String() || remote.HostID.String() != request.ExpectedRemoteHostID {\n134|\t\treturn trustError(TrustError{Operation: operation, Err: ErrHostIdentityMismatch})\n135|\t}\n136|\treturn nil\n137|}\n138|\n139|func findEntry(trust TrustStore, credentialID string) (CredentialEntry, bool) {\n140|\tfor _, entry := range trust.Entries {\n141|\t\tif entry.CredentialID.String() == credentialID {\n142|\t\t\treturn entry, true\n143|\t\t}\n144|\t}\n145|\treturn CredentialEntry{}, false\n146|}\n147|\n148|// matchRemote yields the verified UUID only on an exact leaf/root/SPKI match\n149|// against one currently admitted entry. Zero or multiple matches refuse; SAN\n150|// alone and CA membership alone are insufficient, which the byte-exact triple\n151|// comparison enforces structurally.\n152|func matchRemote(trust TrustStore, leafDER, rootDER []byte) (CredentialEntry, bool) {\n153|\tspki := spkiOf(leafDER)\n154|\tvar matched []CredentialEntry\n155|\tfor _, entry := range trust.Entries {\n156|\t\tif !bytes.Equal(entry.LeafDER, leafDER) || !bytes.Equal(entry.RootDER, rootDER) {\n157|\t\t\tcontinue\n158|\t\t}\n159|\t\tif spki == \"\" || entry.SPKIID.String() != spki {\n160|\t\t\tcontinue\n161|\t\t}\n162|\t\tmatched = append(matched, entry)\n163|\t}\n164|\tif len(matched) != 1 {\n165|\t\treturn CredentialEntry{}, false\n166|\t}\n167|\treturn matched[0], true\n168|}\n169|\n170|func spkiOf(leafDER []byte) string {\n171|\tder := mustSPKI(leafDER)\n172|\tif len(der) == 0 {\n173|\t\treturn \"\"\n174|\t}\n175|\treturn scalar.SHA256Digest(der).String()\n176|}\n177|\n178|// WithMutationAuthorization rechecks generation, credential validity,\n179|// allowlist membership and authenticated hello under the exclusive\n180|// authorization lock immediately before the externally visible side-effect\n181|// boundary, then runs the boundary while still holding the lock. The\n182|// generation check and the boundary serialize with revocation and config\n183|// commits. Boundaries must be bounded: long provider calls must not hold the\n184|// authorization lock across unbounded work.\n185|func (store *Store) WithMutationAuthorization(request AuthRequest, boundary func() error) error {\n186|\tunlock, err := store.lock.exclusive()\n187|\tif err != nil {\n188|\t\treturn trustError(TrustError{Operation: \"authorize mutation\", Err: errors.Join(ErrAuthorizationRefused, err)})\n189|\t}\n190|\tdefer unlock()\n191|\tcurrent, err := readCommitted(store)\n192|\tif err != nil {\n193|\t\treturn err\n194|\t}\n195|\tfresh := request\n196|\tfresh.SnapshotGeneration = current.Generation\n197|\tif err := checkAuthorization(current, fresh); err != nil {\n198|\t\treturn err\n199|\t}\n200|\tif boundary == nil {\n201|\t\treturn trustError(TrustError{Operation: \"authorize mutation\", Err: ErrAuthorizationRefused})\n202|\t}\n203|\treturn boundary()\n204|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c95b","stream":{"kind":"session","id":"01a08900-d199-7822-974c-1de7f95bc0fc"},"sequence":776,"recorded_at":1780531400001547,"record_type":"event","durability":"durable","causation_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","run_stream":{"kind":"run","id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef"},"call_id":"call_01a089034d1972e0bfe2a8590d73f7b4","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1kiyj6/worktree/internal/hosttrust/trust_encode.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/base64\"\n6|\t\"encoding/json\"\n7|\t\"errors\"\n8|\t\"sort\"\n9|\t\"strconv\"\n10|)\n11|\n12|// EncodeTrust renders the canonical Host Trust Store 1.0.0 bytes: compact\n13|// JSON, fixed field order, entries sorted by credential_id. Encoding the same\n14|// store twice yields identical bytes. It never writes a file; durable commits\n15|// belong to the store transaction.\n16|func EncodeTrust(store TrustStore) ([]byte, error) {\n17|\tif store.Generation == 0 || store.Generation > MaxGeneration {\n18|\t\treturn nil, trustError(TrustError{Operation: \"encode generation\", Err: ErrTrustValidation})\n19|\t}\n20|\tif len(store.Entries) > MaxEntries {\n21|\t\treturn nil, trustError(TrustError{Operation: \"encode entries\", Err: ErrTrustValidation})\n22|\t}\n23|\tentries := append([]CredentialEntry(nil), store.Entries...)\n24|\tsort.Slice(entries, func(i, j int) bool {\n25|\t\treturn entries[i].CredentialID.String() < entries[j].CredentialID.String()\n26|\t})\n27|\tfor index := 1; index < len(entries); index++ {\n28|\t\tif entries[index-1].CredentialID.String() == entries[index].CredentialID.String() {\n29|\t\t\treturn nil, trustError(TrustError{Operation: \"encode entries\", Err: ErrTrustValidation})\n30|\t\t}\n31|\t}\n32|\tvar output bytes.Buffer\n33|\toutput.WriteString(`{\"schema\":` + quoteJSON(TrustSchemaID))\n34|\toutput.WriteString(`,\"schema_version\":` + quoteJSON(TrustSchemaVersion))\n35|\toutput.WriteString(`,\"generation\":` + strconv.FormatUint(store.Generation, 10))\n36|\toutput.WriteString(`,\"entries\":[`)\n37|\tfor index, entry := range entries {\n38|\t\tif index > 0 {\n39|\t\t\toutput.WriteByte(',')\n40|\t\t}\n41|\t\tencoded, err := encodeEntry(entry)\n42|\t\tif err != nil {\n43|\t\t\treturn nil, err\n44|\t\t}\n45|\t\toutput.Write(encoded)\n46|\t}\n47|\toutput.WriteString(`]}`)\n48|\tdocument := output.Bytes()\n49|\tif _, err := DecodeTrust(document); err != nil {\n50|\t\treturn nil, trustError(TrustError{Operation: \"encode round trip\", Err: errors.Join(ErrTrustValidation, err)})\n51|\t}\n52|\treturn document, nil\n53|}\n54|\n55|func encodeEntry(entry CredentialEntry) ([]byte, error) {\n56|\tif entry.State != EntryActive && entry.State != EntryRetiring && entry.State != EntryRevoked {\n57|\t\treturn nil, trustError(TrustError{Operation: \"encode state\", Err: ErrTrustValidation})\n58|\t}\n59|\tif entry.State == EntryRetiring && entry.RetireAt == nil {\n60|\t\treturn nil, trustError(TrustError{Operation: \"encode retire_at\", Err: ErrTrustValidation})\n61|\t}\n62|\tif entry.State != EntryRetiring && entry.RetireAt != nil {\n63|\t\treturn nil, trustError(TrustError{Operation: \"encode retire_at\", Err: ErrTrustValidation})\n64|\t}\n65|\tif len(entry.LeafDER) == 0 || len(entry.LeafDER) > MaxDERBytes || len(entry.RootDER) == 0 || len(entry.RootDER) > MaxDERBytes {\n66|\t\treturn nil, trustError(TrustError{Operation: \"encode certificate bytes\", Err: ErrTrustValidation})\n67|\t}\n68|\tretireAt := \"null\"\n69|\tif entry.RetireAt != nil {\n70|\t\tretireAt = quoteJSON(entry.RetireAt.String())\n71|\t}\n72|\tvar output bytes.Buffer\n73|\toutput.WriteString(`{\"host_id\":` + quoteJSON(entry.HostID.String()))\n74|\toutput.WriteString(`,\"credential_id\":` + quoteJSON(entry.CredentialID.String()))\n75|\toutput.WriteString(`,\"spki_id\":` + quoteJSON(entry.SPKIID.String()))\n76|\toutput.WriteString(`,\"root_id\":` + quoteJSON(entry.RootID.String()))\n77|\toutput.WriteString(`,\"leaf_der\":` + quoteJSON(base64.RawURLEncoding.EncodeToString(entry.LeafDER)))\n78|\toutput.WriteString(`,\"root_der\":` + quoteJSON(base64.RawURLEncoding.EncodeToString(entry.RootDER)))\n79|\toutput.WriteString(`,\"state\":` + quoteJSON(entry.State))\n80|\toutput.WriteString(`,\"enrolled_at\":` + quoteJSON(entry.EnrolledAt.String()))\n81|\toutput.WriteString(`,\"retire_at\":` + retireAt + `}`)\n82|\treturn output.Bytes(), nil\n83|}\n84|\n85|func quoteJSON(value string) string {\n86|\tencoded, err := json.Marshal(value)\n87|\tif err != nil {\n88|\t\treturn `\"\"`\n89|\t}\n90|\treturn string(encoded)\n91|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
