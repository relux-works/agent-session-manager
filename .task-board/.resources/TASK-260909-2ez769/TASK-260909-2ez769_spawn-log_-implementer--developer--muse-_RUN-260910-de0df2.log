{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c853","stream":{"kind":"session","id":"01a08900-d199-7822-974c-1de7f95bc0fc"},"sequence":644,"recorded_at":1780531400001283,"record_type":"event","durability":"durable","causation_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","run_stream":{"kind":"run","id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef"},"task_stream":{"kind":"task","id":"01a08902-c5ab-7773-9466-2d25ae079109"},"task_id":"01a08902-c5ab-7773-9466-2d25ae079109","event":{"kind":"output","task_id":"01a08902-c5ab-7773-9466-2d25ae079109","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1kiyj6/worktree/internal/hosttrust/profile.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"crypto/ecdsa\"\n5|\t\"crypto/elliptic\"\n6|\t\"crypto/rand\"\n7|\t\"crypto/x509\"\n8|\t\"crypto/x509/pkix\"\n9|\t\"errors\"\n10|\t\"io\"\n11|\t\"time\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|)\n15|\n16|const (\n17|\t// ProfileVersion is the Host Credential Profile 1 marker used in\n18|\t// mesh.host_channel.version and nowhere else.\n19|\tProfileVersion = \"1.0.0\"\n20|\t// RootLifetime is notBefore plus 366 days.\n21|\tRootLifetime = 366 * 24 * time.Hour\n22|\t// LeafLifetime is notBefore plus 90 days.\n23|\tLeafLifetime = 90 * 24 * time.Hour\n24|\t// IssuanceSkew moves notBefore 300 seconds before issuance time.\n25|\tIssuanceSkew = 300 * time.Second\n26|\t// hostSuffix is the only permitted DNS SAN parent.\n27|\thostSuffix = \".host.ax.invalid\"\n28|)\n29|\n30|func rootCommonName(hostID string) string { return \"AX Host Root \" + hostID }\n31|func leafCommonName(hostID string) string { return \"AX Host \" + hostID }\n32|func hostDNSName(hostID string) string    { return hostID + hostSuffix }\n33|\n34|// Fingerprints identifies the operator-authorized enrollment tuple: SHA-256\n35|// of the leaf DER, of the leaf SubjectPublicKeyInfo DER, and of the root DER.\n36|type Fingerprints struct {\n37|\tLeaf string\n38|\tSPKI string\n39|\tRoot string\n40|}\n41|\n42|// IssuedCredential carries freshly issued public bytes plus the leaf private\n43|// key for exactly one custody write. The root private key is never returned:\n44|// issuance destroys it after signing.\n45|type IssuedCredential struct {\n46|\tHostID     scalar.UUIDv7\n47|\tLeafDER    []byte\n48|\tRootDER    []byte\n49|\tLeafKeyDER []byte\n50|}\n51|\n52|// Formatting issued material must never expose keys, DER bytes or identity.\n53|func (IssuedCredential) String() string   { return \"issued host credential\" }\n54|func (IssuedCredential) GoString() string { return \"issued host credential\" }\n55|\n56|// FingerprintsOf derives the enrollment tuple from public bytes.\n57|func FingerprintsOf(leafDER, rootDER []byte) (Fingerprints, error) {\n58|\tleaf, err := x509.ParseCertificate(leafDER)\n59|\tif err != nil {\n60|\t\treturn Fingerprints{}, trustError(TrustError{Operation: \"fingerprint leaf\", Err: errors.Join(ErrCredentialProfile, err)})\n61|\t}\n62|\tif _, err := x509.ParseCertificate(rootDER); err != nil {\n63|\t\treturn Fingerprints{}, trustError(TrustError{Operation: \"fingerprint root\", Err: errors.Join(ErrCredentialProfile, err)})\n64|\t}\n65|\treturn Fingerprints{\n66|\t\tLeaf: scalar.SHA256Digest(leafDER).String(),\n67|\t\tSPKI: scalar.SHA256Digest(leaf.RawSubjectPublicKeyInfo).String(),\n68|\t\tRoot: scalar.SHA256Digest(rootDER).String(),\n69|\t}, nil\n70|}\n71|\n72|// IssueCredential generates two distinct local CSPRNG ECDSA P-256 key pairs,\n73|// a self-signed root CA and the leaf it signs, exactly per Host Credential\n74|// Profile 1. The root private key is destroyed before return: it is zeroed in\n75|// memory and never serialized, stored or returned.\n76|func IssueCredential(hostID string, now time.Time, randomness io.Reader) (IssuedCredential, error) {\n77|\tparsed, err := scalar.ParseUUIDv7(hostID)\n78|\tif err != nil {\n79|\t\treturn IssuedCredential{}, trustError(TrustError{Operation: \"issue credential\", Err: errors.Join(ErrCredentialProfile, err)})\n80|\t}\n81|\tif randomness == nil {\n82|\t\trandomness = rand.Reader\n83|\t}\n84|\trootKey, err := ecdsa.GenerateKey(elliptic.P256(), randomness)\n85|\tif err != nil {\n86|\t\treturn IssuedCredential{}, trustError(TrustError{Operation: \"issue root key\", Err: errors.Join(ErrCredentialProfile, err)})\n87|\t}\n88|\tleafKey, err := ecdsa.GenerateKey(elliptic.P256(), randomness)\n89|\tif err != nil {\n90|\t\tzeroECDSAKey(rootKey)\n91|\t\treturn IssuedCredential{}, trustError(TrustError{Operation: \"issue leaf key\", Err: errors.Join(ErrCredentialProfile, err)})\n92|\t}\n93|\trootSerial, err := randomSerial(randomness)\n94|\tif err != nil {\n95|\t\tzeroECDSAKey(rootKey)\n96|\t\tzeroECDSAKey(leafKey)\n97|\t\treturn IssuedCredential{}, trustError(TrustError{Operation: \"issue serial\", Err: errors.Join(ErrCredentialProfile, err)})\n98|\t}\n99|\tleafSerial, err := randomSerial(randomness)\n100|\tif err != nil {\n101|\t\tzeroECDSAKey(rootKey)\n102|\t\tzeroECDSAKey(leafKey)\n103|\t\treturn IssuedCredential{}, trustError(TrustError{Operation: \"issue serial\", Err: errors.Join(ErrCredentialProfile, err)})\n104|\t}\n105|\tfor leafSerial.Cmp(rootSerial) == 0 {\n106|\t\tleafSerial, err = randomSerial(randomness)\n107|\t\tif err != nil {\n108|\t\t\tzeroECDSAKey(rootKey)\n109|\t\t\tzeroECDSAKey(leafKey)\n110|\t\t\treturn IssuedCredential{}, trustError(TrustError{Operation: \"issue serial\", Err: errors.Join(ErrCredentialProfile, err)})\n111|\t\t}\n112|\t}\n113|\tnotBefore := now.UTC().Add(-IssuanceSkew)\n114|\trootTemplate := &x509.Certificate{\n115|\t\tSerialNumber:          rootSerial,\n116|\t\tSubject:               pkix.Name{CommonName: rootCommonName(parsed.String())},\n117|\t\tNotBefore:             notBefore,\n118|\t\tNotAfter:              notBefore.Add(RootLifetime),\n119|\t\tKeyUsage:              x509.KeyUsageCertSign,\n120|\t\tBasicConstraintsValid: true,\n121|\t\tIsCA:                  true,\n122|\t\tMaxPathLen:            0,\n123|\t\tMaxPathLenZero:        true,\n124|\t}\n125|\trootSKI, err := subjectKeyID(&rootKey.PublicKey)\n126|\tif err != nil {\n127|\t\tzeroECDSAKey(rootKey)\n128|\t\tzeroECDSAKey(leafKey)\n129|\t\treturn IssuedCredential{}, trustError(TrustError{Operation: \"issue root ski\", Err: errors.Join(ErrCredentialProfile, err)})\n130|\t}\n131|\trootTemplate.SubjectKeyId = rootSKI\n132|\trootTemplate.AuthorityKeyId = rootSKI\n133|\trootDER, err := x509.CreateCertificate(randomness, rootTemplate, rootTemplate, &rootKey.PublicKey, rootKey)\n134|\tif err != nil {\n135|\t\tzeroECDSAKey(rootKey)\n136|\t\tzeroECDSAKey(leafKey)\n137|\t\treturn IssuedCredential{}, trustError(TrustError{Operation: \"issue root certificate\", Err: errors.Join(ErrCredentialProfile, err)})\n138|\t}\n139|\tleafTemplate := &x509.Certificate{\n140|\t\tSerialNumber:          leafSerial,\n141|\t\tSubject:               pkix.Name{CommonName: leafCommonName(parsed.String())},\n142|\t\tNotBefore:             notBefore,\n143|\t\tNotAfter:              notBefore.Add(LeafLifetime),\n144|\t\tKeyUsage:              x509.KeyUsageDigitalSignature,\n145|\t\tExtKeyUsage:           []x509.ExtKeyUsage{x509.ExtKeyUsageClientAuth, x509.ExtKeyUsageServerAuth},\n146|\t\tBasicConstraintsValid: true,\n147|\t\tIsCA:                  false,\n148|\t\tDNSNames:              []string{hostDNSName(parsed.String())},\n149|\t}\n150|\tleafSKI, err := subjectKeyID(&leafKey.PublicKey)\n151|\tif err != nil {\n152|\t\tzeroECDSAKey(rootKey)\n153|\t\tzeroECDSAKey(leafKey)\n154|\t\treturn IssuedCredential{}, trustError(TrustError{Operation: \"issue leaf ski\", Err: errors.Join(ErrCredentialProfile, err)})\n155|\t}\n156|\tleafTemplate.SubjectKeyId = leafSKI\n157|\tleafTemplate.AuthorityKeyId = rootSKI\n158|\tleafDER, err := x509.CreateCertificate(randomness, leafTemplate, rootTemplate, &leafKey.PublicKey, rootKey)\n159|\tzeroECDSAKey(rootKey)\n160|\tif err != nil {\n161|\t\tzeroECDSAKey(leafKey)\n162|\t\treturn IssuedCredential{}, trustError(TrustError{Operation: \"issue leaf certificate\", Err: errors.Join(ErrCredentialProfile, err)})\n163|\t}\n164|\tleafKeyDER, err := x509.MarshalPKCS8PrivateKey(leafKey)\n165|\tzeroECDSAKey(leafKey)\n166|\tif err != nil {\n167|\t\treturn IssuedCredential{}, trustError(TrustError{Operation: \"issue leaf key encoding\", Err: errors.Join(ErrCredentialProfile, err)})\n168|\t}\n169|\tissued := IssuedCredential{HostID: parsed, LeafDER: leafDER, RootDER: rootDER, LeafKeyDER: leafKeyDER}\n170|\tif err := VerifyProfile(issued.LeafDER, issued.RootDER, parsed.String(), now); err != nil {\n171|\t\treturn IssuedCredential{}, err\n172|\t}\n173|\treturn issued, nil\n174|}","final_result":true}}}
