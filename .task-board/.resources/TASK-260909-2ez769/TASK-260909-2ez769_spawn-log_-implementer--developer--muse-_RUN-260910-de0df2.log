tion: \"decode entries\", Err: ErrTrustValidation})\n+\t\t}\n+\t\troots[entry.RootID.String()] = struct{}{}\n+\t}\n+\treturn nil\n+}\n","edit_facts":{"tool_name":"edit_file","path":"/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1kiyj6/worktree/internal/hosttrust/trust.go","added":30,"removed":6},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
