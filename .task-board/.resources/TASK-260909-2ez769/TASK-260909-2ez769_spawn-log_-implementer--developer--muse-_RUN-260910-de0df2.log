35|\n36|// CredentialEntry is one enrolled credential. retire_at is non-null exactly\n37|// for retiring entries and later than enrolled_at.\n38|type CredentialEntry struct {\n39|\tHostID       scalar.UUIDv7\n40|\tCredentialID scalar.Digest\n41|\tSPKIID       scalar.Digest\n42|\tRootID       scalar.Digest\n43|\tLeafDER      []byte\n44|\tRootDER      []byte\n45|\tState        string\n46|\tEnrolledAt   scalar.Timestamp\n47|\tRetireAt     *scalar.Timestamp\n48|}\n49|\n50|// TrustStore is the decoded Host Trust Store 1.0.0 document. Generation is\n51|// greater than zero and increments by one per committed trust/config\n52|// authorization change.\n53|type TrustStore struct {\n54|\tGeneration uint64\n55|\tEntries    []CredentialEntry\n56|}\n57|\n58|// Formatting a store or entry must never expose digests, UUIDs, DER bytes or\n59|// timestamps: custody material never enters logs, snapshots or diagnostics.\n60|func (TrustStore) String() string                    { return \"host trust store\" }\n61|func (TrustStore) GoString() string                  { return \"host trust store\" }\n62|func (TrustStore) Format(state fmt.State, verb rune) { _, _ = state.Write([]byte(\"host trust store\")) }\n63|\n64|func (CredentialEntry) String() string   { return \"host trust credential entry\" }\n65|func (CredentialEntry) GoString() string { return \"host trust credential entry\" }\n66|func (CredentialEntry) Format(state fmt.State, verb rune) {\n67|\t_, _ = state.Write([]byte(\"host trust credential entry\"))\n68|}\n69|\n70|// DecodeTrust is the exact closed Host Trust Store 1.0.0 reader. Unknown,\n71|// missing, duplicate-key, malformed, partial or downgraded state is refused,\n72|// never read as an empty store and never given legacy meaning.\n73|func DecodeTrust(document []byte) (TrustStore, error) {\n74|\tif err := rejectDuplicateKeys(document); err != nil {\n75|\t\treturn TrustStore{}, err\n76|\t}\n77|\tvar shape map[string]json.RawMessage\n78|\tdecoder := json.NewDecoder(bytes.NewReader(document))\n79|\tif err := decoder.Decode(&shape); err != nil {\n80|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"decode document\", Err: errors.Join(ErrTrustDecode, err)})\n81|\t}\n82|\tif decoder.More() {\n83|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"decode document\", Err: ErrTrustDecode})\n84|\t}\n85|\tfor key := range shape {\n86|\t\tswitch key {\n87|\t\tcase \"schema\", \"schema_version\", \"generation\", \"entries\":\n88|\t\tdefault:\n89|\t\t\treturn TrustStore{}, trustError(TrustError{Operation: \"decode document\", Err: errors.Join(ErrTrustValidation, fmt.Errorf(\"unknown field\"))})\n90|\t\t}\n91|\t}\n92|\tvar schema, version string\n93|\tif err := decodeExactString(shape, \"schema\", &schema); err != nil {\n94|\t\treturn TrustStore{}, err\n95|\t}\n96|\tif schema != TrustSchemaID {\n97|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"decode schema\", Err: ErrTrustValidation})\n98|\t}\n99|\tif err := decodeExactString(shape, \"schema_version\", &version); err != nil {\n100|\t\treturn TrustStore{}, err\n101|\t}\n102|\tif version != TrustSchemaVersion {\n103|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"decode schema version\", Err: ErrTrustValidation})\n104|\t}\n105|\tgeneration, err := decodeGeneration(shape)\n106|\tif err != nil {\n107|\t\treturn TrustStore{}, err\n108|\t}\n109|\tentries, err := decodeEntries(shape)\n110|\tif err != nil {\n111|\t\treturn TrustStore{}, err\n112|\t}\n113|\tstore := TrustStore{Generation: generation, Entries: entries}\n114|\tif err := checkSortedUnique(store.Entries); err != nil {\n115|\t\treturn TrustStore{}, err\n116|\t}\n117|\treturn store, nil\n118|}","final_result":true}}}
