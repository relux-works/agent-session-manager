{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cba7","stream":{"kind":"session","id":"01a08900-d199-7822-974c-1de7f95bc0fc"},"sequence":1070,"recorded_at":1780531400002135,"record_type":"event","durability":"durable","causation_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","run_stream":{"kind":"run","id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef"},"task_stream":{"kind":"task","id":"01a08905-468a-7f13-af5c-98c897a6f70f"},"task_id":"01a08905-468a-7f13-af5c-98c897a6f70f","event":{"kind":"output","task_id":"01a08905-468a-7f13-af5c-98c897a6f70f","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1kiyj6/worktree/internal/hosttrust/mutations.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Host trust behavioral overlays; no source-only or compile-error kills.\"\"\"\n3|import argparse\n4|import json\n5|from pathlib import Path\n6|import subprocess\n7|import sys\n8|\n9|ROOT = Path(__file__).resolve().parents[2]\n10|TRUST = \"internal/hosttrust/trust.go\"\n11|DECODE = \"internal/hosttrust/trust_decode.go\"\n12|ENROLL = \"internal/hosttrust/enroll.go\"\n13|ROTATE = \"internal/hosttrust/rotate.go\"\n14|AUTHORIZE = \"internal/hosttrust/authorize.go\"\n15|CUSTODY = \"internal/hosttrust/custody.go\"\n16|PROFILE = \"internal/hosttrust/profile_verify.go\"\n17|TRANSACT = \"internal/hosttrust/transact.go\"\n18|TESTS = \"Test\"\n19|PROBES = [\n20| (\"neutral\", TRANSACT, \"next.Generation = committed.Generation + 1\", \"next.Generation = committed.Generation + 1 + 0\", \"Equivalent generation increment\", None),\n21| (\"gen-ceiling\", DECODE, \"if parsed == 0 || parsed > MaxGeneration {\", \"if parsed == 0 || parsed > MaxGeneration+1 {\", \"Admits exactly generation 2^53\", \"TestDecodeTrustRefusals/generation_uint53_ceiling\"),\n22| (\"dup-credid\", DECODE, \"if previous >= current {\", \"if previous > current {\", \"Admits duplicate credential_id while keeping order\", \"TestDecodeTrustRefusals/duplicate_credential_id\"),\n23| (\"unknown-field\", TRUST, 'case \"schema\", \"schema_version\", \"generation\", \"entries\":', 'case \"schema\", \"schema_version\", \"generation\", \"entries\", \"comment\":', \"Admits exactly one unknown field\", \"TestDecodeTrustRefusals/unknown_root_field\"),\n24| (\"per-host-bound\", ENROLL, \"if live >= 2 {\", \"if live >= 3 {\", \"Admits exactly the third non-revoked credential\", \"TestEnrollBoundsPerHost\"),\n25| (\"rotation-expiry\", ROTATE, \"deadline = oldLeaf.NotAfter\", \"deadline = oldLeaf.NotAfter.Add(time.Hour)\", \"Extends overlap one hour past old leaf expiry\", \"TestRotateCapsAtLeafExpiry\"),\n26| (\"revoke-state\", ROTATE, \"trust.Entries[index].State = EntryRevoked\", \"trust.Entries[index].State = EntryRetiring\", \"Weakens the terminal state to retiring, admitting re-revocation\", \"TestRevokeTombstone\"),\n27| (\"retire-bound\", ROTATE, \"fixed.After(now.Add(RotationBound))\", \"fixed.After(now.Add(48 * time.Hour))\", \"Admits exactly the 24-48h overlap window\", \"TestMarkRetiringBounds/past_24h_bound\"),\n28| (\"stale-direction\", AUTHORIZE, \"if snapshot.Generation != current.Generation {\", \"if snapshot.Generation > current.Generation {\", \"Admits stale-older snapshots while refusing newer\", \"TestAuthorizeDispatchRefusals/stale_generation\"),\n29| (\"custody-0644\", CUSTODY, 'if info.Mode().Perm() != mode {\\n\\t\\treturn trustError(TrustError{Operation: \"inspect file\", Err: ErrTrustUnsafeCustody})', 'if info.Mode().Perm() != mode && info.Mode().Perm() != 0o644 {\\n\\t\\treturn trustError(TrustError{Operation: \"inspect file\", Err: ErrTrustUnsafeCustody})', \"Admits exactly world-readable 0644 files\", \"TestCustodyRefusals/world_readable_trust_file\"),\n30| (\"expiry-grace\", PROFILE, \"instant.After(certificate.NotAfter)\", \"instant.After(certificate.NotAfter.Add(time.Second))\", \"Admits exactly one second past expiry\", \"TestVerifyProfileRefusesJustPastExpiry\"),\n31| (\"exhaustion\", TRANSACT, \"if committed.Generation >= MaxGeneration {\", \"if committed.Generation > MaxGeneration {\", \"Admits the ceiling generation into the commit path\", \"TestGenerationExhaustionRefusesMutation\"),\n32|]\n33|\n34|BOUNDS = {\n35| \"neutral\": \"Equivalent arithmetic; no independent kill claimed.\",\n36|}\n37|\n38|def main():\n39|    parser = argparse.ArgumentParser(description=__doc__)\n40|    parser.add_argument(\"--output\", required=True)\n41|    parser.add_argument(\"--only\", help=\"Comma-separated probe names for a bounded follow-up\")\n42|    opts = parser.parse_args()\n43|    if opts.only and not set(opts.only.split(\",\")).issubset({p[0] for p in PROBES}):\n44|        parser.error(\"--only contains an unknown probe\")\n45|    out = Path(opts.output).resolve()\n46|    out.mkdir(parents=True, exist_ok=True)\n47|    results = []\n48|    unexpected = False\n49|    for name, path, old, new, narrows, expected_test in PROBES:\n50|        if opts.only and name not in opts.only.split(\",\"):\n51|            continue\n52|        source = ROOT / path\n53|        original = source.read_bytes()\n54|        text = original.decode()\n55|        if text.count(old) != 1:\n56|            raise RuntimeError(f\"{name}: plant must match exactly once, got {text.count(old)}\")\n57|        folder = out / name\n58|        folder.mkdir(exist_ok=True)\n59|        replacement = folder / source.name\n60|        replacement.write_text(text.replace(old, new, 1))\n61|        overlay = folder / \"overlay.json\"\n62|        overlay.write_text(json.dumps({\"Replace\": {str(source): str(replacement)}}))\n63|        command = [\"go\", \"test\", \"-overlay\", str(overlay), \"./internal/hosttrust\", \"-count=1\", \"-json\", \"-timeout=120s\", \"-run\", TESTS]\n64|        proc = subprocess.run(command, cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=300)\n65|        (folder / \"test.log\").write_bytes(proc.stdout)\n66|        events = []\n67|        for line in proc.stdout.decode(errors=\"replace\").splitlines():\n68|            try:\n69|                events.append(json.loads(line))\n70|            except json.JSONDecodeError:\n71|                pass\n72|        failed = [e[\"Test\"] for e in events if e.get(\"Action\") == \"fail\" and \"Test\" in e]\n73|        passed = [e[\"Test\"] for e in events if e.get(\"Action\") == \"pass\" and \"Test\" in e]\n74|        killed = proc.returncode != 0 and bool(failed) and (expected_test is None or expected_test in failed)\n75|        if name == \"neutral\":\n76|            valid = proc.returncode == 0 and bool(passed)\n77|            state = \"neutral passed\" if valid else \"invalid control\"\n78|        elif name in BOUNDS:\n79|            valid = proc.returncode == 0 and bool(passed)\n80|            state = \"survived\" if valid else \"unexpected result\"\n81|        else:\n82|            valid = killed\n83|            state = \"killed\" if killed else \"survived\" if proc.returncode == 0 and passed else \"invalid instrument/compile failure\"\n84|        if not valid:\n85|            unexpected = True\n86|        if source.read_bytes() != original:\n87|            raise RuntimeError(f\"{name}: source changed during overlay run\")\n88|        row = {\"mutant\": name, \"narrowing\": narrows, \"exit_code\": proc.returncode, \"result\": state,\n89|               \"named_failing_tests\": failed, \"expected_test\": expected_test,\n90|               \"bound\": BOUNDS.get(name, \"\" if killed or name == \"neutral\" else \"No named failing test established; this gate member is unproven.\"),\n91|               \"command\": command}\n92|        results.append(row)\n93|        print(f\"{name}: {state}, exit={proc.returncode}, tests={','.join(failed)}\", flush=True)\n94|        (out / \"results.json\").write_text(json.dumps(results, indent=2) + \"\\n\")\n95|    rows = [\"| Mutant | What the gate is narrowed to admit | Named failing test | Exit | Result / surviving bound |\",\n96|            \"| --- | --- | --- | ---: | --- |\"]\n97|    for r in results:\n98|        tests = r[\"expected_test\"] if r[\"expected_test\"] in r[\"named_failing_tests\"] else \", \".join(r[\"named_failing_tests\"])\n99|        rows.append(f'| {r[\"mutant\"]} | {r[\"narrowing\"]} | {tests or \"none\"} | {r[\"exit_code\"]} | {r[\"result\"]}: {r[\"bound\"]} |')\n100|    (out / \"table.md\").write_text(\"\\n\".join(rows)+\"\\n\")\n101|    return int(unexpected)\n102|\n103|\n104|if __name__ == \"__main__\":\n105|    sys.exit(main())","final_result":true}}}
