rustError{Operation: \"decode generation\", Err: ErrTrustValidation})\n42|\t}\n43|\tvar value any\n44|\tif err := strictJSONDecoder(raw).Decode(&value); err != nil {\n45|\t\treturn 0, trustError(TrustError{Operation: \"decode generation\", Err: errors.Join(ErrTrustDecode, err)})\n46|\t}\n47|\t// A JSON string holding digits is not a uint53: generation must be a\n48|\t// bare JSON number.\n49|\tnumber, ok := value.(json.Number)\n50|\tif !ok {\n51|\t\treturn 0, trustError(TrustError{Operation: \"decode generation\", Err: ErrTrustValidation})\n52|\t}\n53|\ttext := number.String()\n54|\tif text == \"\" {\n55|\t\treturn 0, trustError(TrustError{Operation: \"decode generation\", Err: ErrTrustValidation})\n56|\t}\n57|\tfor _, digit := range text {\n58|\t\tif digit < '0' || digit > '9' {\n59|\t\t\treturn 0, trustError(TrustError{Operation: \"decode generation\", Err: ErrTrustValidation})\n60|\t\t}\n61|\t}\n62|\tparsed, err := strconv.ParseUint(text, 10, 64)\n63|\tif err != nil {\n64|\t\treturn 0, trustError(TrustError{Operation: \"decode generation\", Err: ErrTrustValidation})\n65|\t}\n66|\tif parsed == 0 || parsed > MaxGeneration {\n67|\t\treturn 0, trustError(TrustError{Operation: \"decode generation\", Err: ErrTrustValidation})\n68|\t}\n69|\treturn parsed, nil\n70|}\n71|\n72|func decodeEntries(shape map[string]json.RawMessage) ([]CredentialEntry, error) {\n73|\traw, ok := shape[\"entries\"]\n74|\tif !ok {\n75|\t\treturn nil, trustError(TrustError{Operation: \"decode entries\", Err: ErrTrustValidation})\n76|\t}\n77|\tvar items []map[string]json.RawMessage\n78|\tdecoder := strictJSONDecoder(raw)\n79|\tif err := decoder.Decode(&items); err != nil {\n80|\t\treturn nil, trustError(TrustError{Operation: \"decode entries\", Err: errors.Join(ErrTrustDecode, err)})\n81|\t}\n82|\tif items == nil {\n83|\t\treturn nil, trustError(TrustError{Operation: \"decode entries\", Err: ErrTrustValidation})\n84|\t}\n85|\tif len(items) > MaxEntries {\n86|\t\treturn nil, trustError(TrustError{Operation: \"decode entries\", Err: ErrTrustValidation})\n87|\t}\n88|\tentries := make([]CredentialEntry, 0, len(items))\n89|\tfor index := range items {\n90|\t\tentry, err := decodeEntry(items[index])\n91|\t\tif err != nil {\n92|\t\t\treturn nil, err\n93|\t\t}\n94|\t\tentries = append(entries, entry)\n95|\t}\n96|\treturn entries, nil\n97|}\n98|\n99|func decodeEntry(shape map[string]json.RawMessage) (CredentialEntry, error) {\n100|\tif len(shape) != len(entryFields) {\n101|\t\treturn CredentialEntry{}, trustError(TrustError{Operation: \"decode entry\", Err: ErrTrustValidation})\n102|\t}\n103|\tfor _, field := range entryFields {\n104|\t\tif _, ok := shape[field]; !ok {\n105|\t\t\treturn CredentialEntry{}, trustError(TrustError{Operation: \"decode entry\", Err: ErrTrustValidation})\n106|\t\t}\n107|\t}\n108|\tvar entry CredentialEntry\n109|\tif err := decodeEntryString(shape, \"host_id\", func(value string) error {\n110|\t\tparsed, err := scalar.ParseUUIDv7(value)\n111|\t\tif err != nil {\n112|\t\t\treturn err\n113|\t\t}\n114|\t\tentry.HostID = parsed\n115|\t\treturn nil\n116|\t}); err != nil {\n117|\t\treturn CredentialEntry{}, err\n118|\t}\n119|\tfor _, field := range []string{\"credential_id\", \"spki_id\", \"root_id\"} {\n120|\t\tif err := decodeEntryDigest(shape, field, &entry, field); err != nil {\n121|\t\t\treturn CredentialEntry{}, err\n122|\t\t}\n123|\t}\n124|\tvar leafDER, rootDER []byte\n125|\tfor _, field := range []string{\"leaf_der\", \"root_der\"} {\n126|\t\tder, err := decodeEntryDER(shape, field)\n127|\t\tif err != nil {\n128|\t\t\treturn CredentialEntry{}, err\n129|\t\t}\n130|\t\tif field == \"leaf_der\" {\n131|\t\t\tleafDER = der\n132|\t\t} else {\n133|\t\t\trootDER = der\n134|\t\t}\n135|\t}\n136|\tentry.LeafDER = leafDER\n137|\tentry.RootDER = rootDER\n138|\tif err := decodeEntryString(shape, \"state\", func(value string) error {\n139|\t\tswitch value {\n140|\t\tcase EntryActive, EntryRetiring, EntryRevoked:\n141|\t\t\tentry.State = value\n142|\t\t\treturn nil\n143|\t\tdefault:\n144|\t\t\treturn ErrTrustValidation\n145|\t\t}\n146|\t}); err != nil {\n147|\t\treturn CredentialEntry{}, err\n148|\t}\n149|\tif err := decodeEntryString(shape, \"enrolled_at\", func(value string) error {\n150|\t\tparsed, err := scalar.ParseTimestamp(value)\n151|\t\tif err != nil {\n152|\t\t\treturn err\n153|\t\t}\n154|\t\tentry.EnrolledAt = parsed\n155|\t\treturn nil\n156|\t}); err != nil {\n157|\t\treturn CredentialEntry{}, err\n158|\t}\n159|\tretireRaw := shape[\"retire_at\"]\n160|\tif string(retireRaw) == \"null\" {\n161|\t\tif entry.State == EntryRetiring {\n162|\t\t\treturn CredentialEntry{}, trustError(TrustError{Operation: \"decode retire_at\", Err: ErrTrustValidation})\n163|\t\t}\n164|\t} else {\n165|\t\tvar text string\n166|\t\tif err := strictJSONDecoder(retireRaw).Decode(&text); err != nil {\n167|\t\t\treturn CredentialEntry{}, trustError(TrustError{Operation: \"decode retire_at\", Err: errors.Join(ErrTrustDecode, err)})\n168|\t\t}\n169|\t\tparsed, err := scalar.ParseTimestamp(text)\n170|\t\tif err != nil {\n171|\t\t\treturn CredentialEntry{}, trustError(TrustError{Operation: \"decode retire_at\", Err: errors.Join(ErrTrustDecode, err)})\n172|\t\t}\n173|\t\tif entry.State != EntryRetiring {\n174|\t\t\treturn CredentialEntry{}, trustError(TrustError{Operation: \"decode retire_at\", Err: ErrTrustValidation})\n175|\t\t}\n176|\t\tentry.RetireAt = &parsed\n177|\t}\n178|\tif entry.RetireAt != nil {\n179|\t\tretireAt, err := entry.RetireAt.Time()\n180|\t\tif err != nil {\n181|\t\t\treturn CredentialEntry{}, trustError(TrustError{Operation: \"decode retire_at\", Err: errors.Join(ErrTrustDecode, err)})\n182|\t\t}\n183|\t\tenrolledAt, err := entry.EnrolledAt.Time()\n184|\t\tif err != nil {\n185|\t\t\treturn CredentialEntry{}, trustError(TrustError{Operation: \"decode enrolled_at\", Err: errors.Join(ErrTrustDecode, err)})\n186|\t\t}\n187|\t\tif !retireAt.After(enrolledAt) {\n188|\t\t\treturn CredentialEntry{}, trustError(TrustError{Operation: \"decode retire_at\", Err: ErrTrustValidation})\n189|\t\t}\n190|\t}\n191|\tif _, err := x509.ParseCertificate(entry.LeafDER); err != nil {\n192|\t\treturn CredentialEntry{}, trustError(TrustError{Operation: \"decode leaf_der\", Err: errors.Join(ErrTrustDecode, err)})\n193|\t}\n194|\tif _, err := x509.ParseCertificate(entry.RootDER); err != nil {\n195|\t\treturn CredentialEntry{}, trustError(TrustError{Operation: \"decode root_der\", Err: errors.Join(ErrTrustDecode, err)})\n196|\t}\n197|\treturn entry, nil\n198|}\n199|\n200|func decodeEntryString(shape map[string]json.RawMessage, field string, accept func(string) error) error {\n201|\tvar value string\n202|\tif err := strictJSONDecoder(shape[field]).Decode(&value); err != nil {\n203|\t\treturn trustError(TrustError{Operation: \"decode \" + field, Err: errors.Join(ErrTrustDecode, err)})\n204|\t}\n205|\tif err := accept(value); err != nil {\n206|\t\treturn trustError(TrustError{Operation: \"decode \" + field, Err: errors.Join(ErrTrustValidation, err)})\n207|\t}\n208|\treturn nil\n209|}\n210|\n211|func decodeEntryDigest(shape map[string]json.RawMessage, field string, entry *CredentialEntry, target string) error {\n212|\treturn decodeEntryString(shape, field, func(value string) error {\n213|\t\tparsed, err := scalar.ParseDigest(value)\n214|\t\tif err != nil {\n215|\t\t\treturn err\n216|\t\t}\n217|\t\tswitch target {\n218|\t\tcase \"credential_id\":\n219|\t\t\tentry.CredentialID = parsed\n220|\t\tcase \"spki_id\":\n221|\t\t\tentry.SPKIID = parsed\n222|\t\tcase \"root_id\":\n223|\t\t\tentry.RootID = parsed\n224|\t\t}\n225|\t\treturn nil\n226|\t})\n227|}\n228|\n229|func decodeEntryDER(shape map[string]json.RawMessage, field string) ([]byte, error) {\n230|\tvar encoded string\n231|\tif err := strictJSONDecoder(shape[field]).Decode(&encoded); err != nil {\n232|\t\treturn nil, trustError(TrustError{Operation: \"decode \" + field, Err: errors.Join(ErrTrustDecode, err)})\n233|\t}\n234|\t// base64url unpadded canonical: reject padded, standard-alphabet and\n235|\t// whitespace variants by re-encoding the decoded bytes.\n236|\tder, err := base64.RawURLEncoding.DecodeString(encoded)\n237|\tif err != nil {\n238|\t\treturn nil, trustError(TrustError{Operation: \"decode \" + field, Err: errors.Join(ErrTrustDecode, err)})\n239|\t}\n240|\tif len(der) == 0 || len(der) > MaxDERBytes {\n241|\t\treturn nil, trustError(TrustError{Operation: \"decode \" + field, Err: ErrTrustValidation})\n242|\t}\n243|\tif base64.RawURLEncoding.EncodeToString(der) != encoded {\n244|\t\treturn nil, trustError(TrustError{Operation: \"decode \" + field, Err: ErrTrustValidation})\n245|\t}\n246|\treturn der, nil\n247|}\n248|\n249|// rejectDuplicateKeys refuses JSON objects that repeat a key. encoding/json\n250|// keeps only the last duplicate silently, which would let a partial or\n251|// downgraded state hide behind an earlier key, so the token stream is\n252|// audited before decoding.\n253|func rejectDuplicateKeys(document []byte) error {\n254|\ttype frame struct {\n255|\t\tobject    bool\n256|\t\texpectKey bool\n257|\t\tkeys      map[string]struct{}\n258|\t}\n259|\tvar stack []frame\n260|\tdecoder := json.NewDecoder(bytes.NewReader(document))\n261|\tfor {\n262|\t\ttoken, err := decoder.Token()\n263|\t\tif err != nil {\n264|\t\t\tif errors.Is(err, io.EOF) {\n265|\t\t\t\tbreak\n266|\t\t\t}\n267|\t\t\treturn trustError(TrustError{Operation: \"decode document\", Err: errors.Join(ErrTrustDecode, err)})\n268|\t\t}\n269|\t\tif delim, ok := token.(json.Delim); ok {\n270|\t\t\tswitch delim {\n271|\t\t\tcase '{':\n272|\t\t\t\tstack = append(stack, frame{object: true, expectKey: true, keys: map[string]struct{}{}})\n273|\t\t\tcase '[':\n274|\t\t\t\tstack = append(stack, frame{})\n275|\t\t\tcase '}', ']':\n276|\t\t\t\tif len(stack) == 0 {\n277|\t\t\t\t\treturn trustError(TrustError{Operation: \"decode document\", Err: ErrTrustDecode})\n278|\t\t\t\t}\n279|\t\t\t\twantObject := delim == '}'\n280|\t\t\t\tif stack[len(stack)-1].object != wantObject {\n281|\t\t\t\t\treturn trustError(TrustError{Operation: \"decode document\", Err: ErrTrustDecode})\n282|\t\t\t\t}\n283|\t\t\t\tstack = stack[:len(stack)-1]\n284|\t\t\t\t// A closed nested value completes its parent's key: the\n285|\t\t\t\t// parent object expects the next key.\n286|\t\t\t\tif len(stack) > 0 && stack[len(stack)-1].object {\n287|\t\t\t\t\tstack[len(stack)-1].expectKey = true\n288|\t\t\t\t}\n289|\t\t\t}\n290|\t\t\tcontinue\n291|\t\t}\n292|\t\tif len(stack) == 0 {\n293|\t\t\tcontinue\n294|\t\t}\n295|\t\ttop := &stack[len(stack)-1]\n296|\t\ttext, isString := token.(string)\n297|\t\tif top.object && top.expectKey {\n298|\t\t\tif !isString {\n299|\t\t\t\treturn trustError(TrustError{Operation: \"decode document\", Err: ErrTrustDecode})\n300|\t\t\t}\n301|\t\t\tif _, seen := top.keys[text]; seen {\n302|\t\t\t\treturn trustError(TrustError{Operation: \"decode document\", Err: ErrTrustValidation})\n303|\t\t\t}\n304|\t\t\ttop.keys[text] = struct{}{}\n305|\t\t\ttop.expectKey = false\n306|\t\t\tcontinue\n307|\t\t}\n308|\t\tif top.object {\n309|\t\t\ttop.expectKey = true\n310|\t\t}\n311|\t}\n312|\tif len(stack) != 0 {\n313|\t\treturn trustError(TrustError{Operation: \"decode document\", Err: ErrTrustDecode})\n314|\t}\n315|\treturn nil\n316|}\n317|\n318|func checkSortedUnique(entries []CredentialEntry) error {\n319|\tfor index := 1; index < len(entries); index++ {\n320|\t\tprevious := entries[index-1].CredentialID.String()\n321|\t\tcurrent := entries[index].CredentialID.String()\n322|\t\tif previous >= current {\n323|\t\t\treturn trustError(TrustError{Operation: \"decode entries\", Err: ErrTrustValidation})\n324|\t\t}\n325|\t}\n326|\treturn nil\n327|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
