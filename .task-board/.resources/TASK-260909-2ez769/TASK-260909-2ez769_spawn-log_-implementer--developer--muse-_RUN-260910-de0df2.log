{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb11","stream":{"kind":"session","id":"01a08900-d199-7822-974c-1de7f95bc0fc"},"sequence":995,"recorded_at":1780531400001985,"record_type":"event","durability":"durable","causation_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","run_stream":{"kind":"run","id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef"},"task_stream":{"kind":"task","id":"01a08904-a213-7ca2-a8fe-cab6f6470d4d"},"task_id":"01a08904-a213-7ca2-a8fe-cab6f6470d4d","event":{"kind":"output","task_id":"01a08904-a213-7ca2-a8fe-cab6f6470d4d","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1kiyj6/worktree/internal/config/migration.go`.\n(199 line(s) above)\n200|\tif err != nil {\n201|\t\treturn MigrationResult{}, err\n202|\t}\n203|\tloaded, decoded := snapshot.Configuration()\n204|\tif !snapshot.ConfigPresent() || !decoded {\n205|\t\treturn MigrationResult{}, migrationError(MigrationError{Operation: \"load source\", Err: ErrMigrationSourceAbsent})\n206|\t}\n207|\tsource, _ := knownConfigVersion(loaded.SourceVersion)\n208|\tresult := MigrationResult{SourceVersion: loaded.SourceVersion, TargetVersion: options.TargetVersion}\n209|\tif compareSemver(source, target) > 0 {\n210|\t\treturn result, migrationError(MigrationError{Operation: \"select target\", Err: ErrMigrationDowngrade})\n211|\t}\n212|\tif compareSemver(source, target) == 0 {\n213|\t\treturn result, nil\n214|\t}\n215|\tif loaded.SourceVersion == Version1 {\n216|\t\tif !oneOf(options.GeneratedSummaryUpgradeChoice, \"local_only\", \"mesh_sanitized\", \"reference_only\") {\n217|\t\t\treturn result, migrationError(MigrationError{Operation: \"validate disclosure choice\", Err: ErrMigrationChoiceRequired})\n218|\t\t}\n219|\t\tloaded.Value.Directory.GeneratedSummaryUpgradeChoice = options.GeneratedSummaryUpgradeChoice\n220|\t}\n221|\tcontext := DecodeContext{RuntimePlatform: inputs.Platform, BackendSettings: inputs.BackendSettings}\n222|\tvar replacement []byte\n223|\tswitch options.TargetVersion {\n224|\tcase Version2:\n225|\t\treplacement, err = encodeVersion2(loaded.Value, context)\n226|\tcase CurrentVersion:\n227|\t\treplacement, err = EncodeCurrent(loaded.Value, context)\n228|\t}\n229|\tif err != nil {\n230|\t\treturn result, migrationError(MigrationError{Operation: \"encode target\", Err: err}) // config-refusal-subsumed: every encoder refusal below this propagation is pinned on its own clause, at writer.go terminal.backend and writer.go v2 wire TOML for the v2 encoder, at writer.go v2 re-read for its defence-in-depth round trip, and by the EncodeCurrent validation suite for v3\n231|\t}\n232|\tselected, _ := snapshot.Paths().Path(ConfigFile)\n233|\tfilename := selected.Value.String()\n234|\tbackup := filename + \".bak.\" + loaded.SourceVersion\n235|\tresult.BackupPath = backup\n236|\tif err := replaceDurably(filesystem, filename, backup, snapshot.Document(), replacement); err != nil {\n237|\t\treturn result, err\n238|\t}\n239|\tresult.Changed = true\n240|\treturn result, nil\n241|}\n242|\n243|type migrationFile interface {\n244|\tio.Writer\n245|\tName() string\n246|\tChmod(fs.FileMode) error\n247|\tSync() error\n248|\tClose() error\n249|}\n250|\n251|type migrationDirectory interface {\n252|\tSync() error\n253|\tClose() error\n254|}\n255|\n256|type migrationFileSystem interface {\n257|\tCreateTemp(string, string) (migrationFile, error)\n258|\tLink(string, string) error\n259|\tReadFile(string) ([]byte, error)\n260|\tStat(string) (fs.FileInfo, error)\n261|\tRemove(string) error\n262|\tRename(string, string) error\n263|\tOpenDirectory(string) (migrationDirectory, error)\n264|}\n265|\n266|type osMigrationFileSystem struct{}\n267|\n268|func (osMigrationFileSystem) CreateTemp(dir, pattern string) (migrationFile, error) {\n269|\treturn os.CreateTemp(dir, pattern)\n270|}\n271|func (osMigrationFileSystem) Link(oldname, newname string) error   { return os.Link(oldname, newname) }\n272|func (osMigrationFileSystem) ReadFile(name string) ([]byte, error) { return os.ReadFile(name) }\n273|\n274|// Stat does not follow a symlink, unlike the symlink-following read-side seam\n275|// in OSInputs. Durable migration replaces the selected file with an atomic\n276|// rename, which replaces a symlink itself rather than its target: migrating a\n277|// symlinked configuration would silently detach the operator's link and leave\n278|// the real document holding stale bytes next to a backup of the resolved\n279|// target. The specification is silent here, so the mutating path fails closed\n280|// with ErrConfigNotRegular instead of guessing which file the operator meant.\n281|func (osMigrationFileSystem) Stat(name string) (fs.FileInfo, error) { return os.Lstat(name) }\n282|func (osMigrationFileSystem) Remove(name string) error              { return os.Remove(name) }\n283|func (osMigrationFileSystem) Rename(oldname, newname string) error {\n284|\treturn os.Rename(oldname, newname)\n285|}\n286|func (osMigrationFileSystem) OpenDirectory(name string) (migrationDirectory, error) {\n287|\treturn os.Open(name)\n288|}\n289|\n290|func replaceDurably(filesystem migrationFileSystem, filename, backup string, original, replacement []byte) error {\n291|\tdirectory := filepath.Dir(filename)\n292|\t// Re-inspect the selected file before anything durable is written. Load\n293|\t// resolved and validated it through the symlink-following read seam; this\n294|\t// mutating seam does not follow symlinks, so a selected file that is not\n295|\t// itself a regular file is refused here rather than after a backup has\n296|\t// already been published. A refused migration therefore leaves the\n297|\t// directory exactly as it found it, and the captured permission bits are\n298|\t// the ones the replacement inherits.\n299|\tinfo, err := filesystem.Stat(filename)\n300|\tif err != nil {\n301|\t\treturn migrationError(MigrationError{Operation: \"inspect source mode\", Err: errors.Join(ErrMigrationWrite, err)})\n302|\t}\n303|\tif !info.Mode().IsRegular() {\n304|\t\treturn migrationError(MigrationError{Operation: \"inspect source mode\", Err: errors.Join(ErrMigrationWrite, ErrConfigNotRegular)})\n305|\t}\n306|\tbackupTemp, err := writeTempFile(filesystem, directory, \".ax-config-backup-*\", original, 0o600)\n307|\tif err != nil {\n308|\t\treturn migrationError(MigrationError{Operation: \"write backup\", Err: errors.Join(ErrMigrationBackup, err)})\n309|\t}\n310|\tif err := filesystem.Link(backupTemp, backup); err != nil {\n311|\t\tif !errors.Is(err, fs.ErrExist) {\n312|\t\t\t_ = filesystem.Remove(backupTemp)\n313|\t\t\treturn migrationError(MigrationError{Operation: \"publish backup\", Err: errors.Join(ErrMigrationBackup, err)})\n314|\t\t}\n315|\t\texisting, readErr := filesystem.ReadFile(backup)\n316|\t\tinfo, statErr := filesystem.Stat(backup)\n317|\t\tif readErr != nil || statErr != nil || !bytes.Equal(existing, original) || info.Mode().Perm()&0o077 != 0 {\n318|\t\t\t_ = filesystem.Remove(backupTemp)\n319|\t\t\treturn migrationError(MigrationError{Operation: \"verify backup\", Err: ErrMigrationBackup})\n320|\t\t}\n321|\t}\n322|\tif err := filesystem.Remove(backupTemp); err != nil && !errors.Is(err, fs.ErrNotExist) {\n323|\t\treturn migrationError(MigrationError{Operation: \"remove backup staging file\", Err: errors.Join(ErrMigrationBackup, err)})\n324|\t}\n325|\t// Retry the directory sync even when an exact backup already exists: it may\n326|\t// be the visible result of an interrupted run whose directory fsync failed.\n327|\tif err := syncDirectory(filesystem, directory); err != nil {\n328|\t\treturn migrationError(MigrationError{Operation: \"sync backup directory\", Err: errors.Join(ErrMigrationSync, err)})\n329|\t}\n(more lines below)","final_result":true}}}
