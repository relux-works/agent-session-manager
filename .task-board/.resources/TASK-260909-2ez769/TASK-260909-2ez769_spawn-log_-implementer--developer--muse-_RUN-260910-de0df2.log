{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c893","stream":{"kind":"session","id":"01a08900-d199-7822-974c-1de7f95bc0fc"},"sequence":676,"recorded_at":1780531400001347,"record_type":"event","durability":"durable","causation_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","run_stream":{"kind":"run","id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef"},"call_id":"call_01a08902e4e97472883cc57de83d6f16","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1kiyj6/worktree/internal/hosttrust/profile_checks.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"crypto/ecdsa\"\n6|\t\"crypto/elliptic\"\n7|\t\"crypto/x509\"\n8|\t\"crypto/x509/pkix\"\n9|\t\"encoding/asn1\"\n10|)\n11|\n12|var oidCommonName = asn1.ObjectIdentifier{2, 5, 4, 3}\n13|\n14|// subjectIsOnlyCN accepts exactly the profile subject: the expected common\n15|// name and no other subject attribute. The parsed CN is itself one ATV in\n16|// Names, so CN-only means precisely one ATV with the CN OID and value.\n17|func subjectIsOnlyCN(name pkix.Name, commonName string) bool {\n18|\tif name.CommonName != commonName || name.SerialNumber != \"\" {\n19|\t\treturn false\n20|\t}\n21|\tif len(name.Country) != 0 || len(name.Organization) != 0 || len(name.OrganizationalUnit) != 0 {\n22|\t\treturn false\n23|\t}\n24|\tif len(name.Locality) != 0 || len(name.Province) != 0 || len(name.StreetAddress) != 0 || len(name.PostalCode) != 0 {\n25|\t\treturn false\n26|\t}\n27|\tif len(name.ExtraNames) != 0 || len(name.Names) != 1 {\n28|\t\treturn false\n29|\t}\n30|\tif !name.Names[0].Type.Equal(oidCommonName) {\n31|\t\treturn false\n32|\t}\n33|\tvalue, ok := name.Names[0].Value.(string)\n34|\treturn ok && value == commonName\n35|}\n36|\n37|func checkP256Point(certificate *x509.Certificate) error {\n38|\tkey, ok := certificate.PublicKey.(*ecdsa.PublicKey)\n39|\tif !ok {\n40|\t\treturn ErrCredentialProfile\n41|\t}\n42|\tif key.Curve != elliptic.P256() {\n43|\t\treturn ErrCredentialProfile\n44|\t}\n45|\tif !elliptic.P256().IsOnCurve(key.X, key.Y) {\n46|\t\treturn ErrCredentialProfile\n47|\t}\n48|\treturn nil\n49|}\n50|\n51|func hasExactlyClientServerEKU(leaf *x509.Certificate) bool {\n52|\tif len(leaf.ExtKeyUsage) != 2 || len(leaf.UnknownExtKeyUsage) != 0 {\n53|\t\treturn false\n54|\t}\n55|\tvar client, server bool\n56|\tfor _, usage := range leaf.ExtKeyUsage {\n57|\t\tswitch usage {\n58|\t\tcase x509.ExtKeyUsageClientAuth:\n59|\t\t\tclient = true\n60|\t\tcase x509.ExtKeyUsageServerAuth:\n61|\t\t\tserver = true\n62|\t\tdefault:\n63|\t\t\treturn false\n64|\t\t}\n65|\t}\n66|\treturn client && server\n67|}\n68|\n69|// checkNoExtraNames refuses every name and dependency outside the profile:\n70|// no wildcard or CN-only identity, no alternative UUID, no extra subject\n71|// attribute, no other SAN type, and no AIA fetch, CRL URL or OCSP endpoint.\n72|func checkNoExtraNames(certificate *x509.Certificate) error {\n73|\tif len(certificate.EmailAddresses) != 0 || len(certificate.IPAddresses) != 0 || len(certificate.URIs) != 0 {\n74|\t\treturn ErrCredentialProfile\n75|\t}\n76|\tif len(certificate.OCSPServer) != 0 || len(certificate.IssuingCertificateURL) != 0 {\n77|\t\treturn ErrCredentialProfile\n78|\t}\n79|\tif len(certificate.DNSNames) != 0 {\n80|\t\tfor _, name := range certificate.DNSNames {\n81|\t\t\tfor _, unit := range name {\n82|\t\t\t\tif unit == '*' {\n83|\t\t\t\t\treturn ErrCredentialProfile\n84|\t\t\t\t}\n85|\t\t\t}\n86|\t\t}\n87|\t}\n88|\tif len(certificate.CRLDistributionPoints) != 0 {\n89|\t\treturn ErrCredentialProfile\n90|\t}\n91|\tif len(certificate.PolicyIdentifiers) != 0 || len(certificate.PermittedDNSDomains) != 0 {\n92|\t\treturn ErrCredentialProfile\n93|\t}\n94|\treturn nil\n95|}\n96|\n97|func checkKeyIdentifiers(leaf, root *x509.Certificate) error {\n98|\tleafKey, ok := leaf.PublicKey.(*ecdsa.PublicKey)\n99|\tif !ok {\n100|\t\treturn ErrCredentialProfile\n101|\t}\n102|\trootKey, ok := root.PublicKey.(*ecdsa.PublicKey)\n103|\tif !ok {\n104|\t\treturn ErrCredentialProfile\n105|\t}\n106|\tleafSKI, err := subjectKeyID(leafKey)\n107|\tif err != nil {\n108|\t\treturn ErrCredentialProfile\n109|\t}\n110|\trootSKI, err := subjectKeyID(rootKey)\n111|\tif err != nil {\n112|\t\treturn ErrCredentialProfile\n113|\t}\n114|\tif !bytes.Equal(leaf.SubjectKeyId, leafSKI) || !bytes.Equal(root.SubjectKeyId, rootSKI) {\n115|\t\treturn ErrCredentialProfile\n116|\t}\n117|\tif !bytes.Equal(leaf.AuthorityKeyId, rootSKI) || !bytes.Equal(root.AuthorityKeyId, rootSKI) {\n118|\t\treturn ErrCredentialProfile\n119|\t}\n120|\treturn nil\n121|}\n122|\n123|func checkSerials(leaf, root *x509.Certificate) error {\n124|\tif leaf.SerialNumber == nil || root.SerialNumber == nil {\n125|\t\treturn ErrCredentialProfile\n126|\t}\n127|\tif leaf.SerialNumber.Sign() <= 0 || root.SerialNumber.Sign() <= 0 {\n128|\t\treturn ErrCredentialProfile\n129|\t}\n130|\tif len(leaf.SerialNumber.Bytes()) > 20 || len(root.SerialNumber.Bytes()) > 20 {\n131|\t\treturn ErrCredentialProfile\n132|\t}\n133|\tif leaf.SerialNumber.Cmp(root.SerialNumber) == 0 {\n134|\t\treturn ErrCredentialProfile\n135|\t}\n136|\treturn nil\n137|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
