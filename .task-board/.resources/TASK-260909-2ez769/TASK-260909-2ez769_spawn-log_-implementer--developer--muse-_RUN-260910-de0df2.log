{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8d3","stream":{"kind":"session","id":"01a08900-d199-7822-974c-1de7f95bc0fc"},"sequence":708,"recorded_at":1780531400001411,"record_type":"event","durability":"durable","causation_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","run_stream":{"kind":"run","id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef"},"task_stream":{"kind":"task","id":"01a08902-f4d3-71b3-8fdd-924a27bdad7e"},"task_id":"01a08902-f4d3-71b3-8fdd-924a27bdad7e","event":{"kind":"output","task_id":"01a08902-f4d3-71b3-8fdd-924a27bdad7e","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1kiyj6/worktree/internal/hosttrust/enroll.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"crypto/ecdsa\"\n6|\t\"crypto/x509\"\n7|\t\"encoding/pem\"\n8|\t\"errors\"\n9|\t\"path/filepath\"\n10|\t\"time\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|)\n14|\n15|// EnrollInput is the explicit local operator authorization of one enrollment\n16|// tuple plus the imported public bytes. The Authorized fingerprints must come\n17|// from an independent authenticated out-of-band channel: SSH discovery, a\n18|// first hello, a remote claim, or a certificate being self-signed is never\n19|// approval, and this function cannot tell where the caller got them. What it\n20|// guarantees is that the imported bytes reproduce the authorized tuple and\n21|// the profile before anything commits.\n22|type EnrollInput struct {\n23|\tHostID     string\n24|\tLeafDER    []byte\n25|\tRootDER    []byte\n26|\tAuthorized Fingerprints\n27|\tEnrolledAt time.Time\n28|}\n29|\n30|// Enroll commits one active peer credential after verifying the authorized\n31|// tuple, the profile, lifetimes, and the cross-entry uniqueness rules.\n32|// Enrollment is one-directional: it never implies reciprocity.\n33|func (store *Store) Enroll(input EnrollInput) (string, error) {\n34|\tparsed, err := scalar.ParseUUIDv7(input.HostID)\n35|\tif err != nil {\n36|\t\treturn \"\", trustError(TrustError{Operation: \"enroll host\", Err: errors.Join(ErrEnrollmentRefused, err)})\n37|\t}\n38|\tobserved, err := FingerprintsOf(input.LeafDER, input.RootDER)\n39|\tif err != nil {\n40|\t\treturn \"\", err\n41|\t}\n42|\tif observed != input.Authorized {\n43|\t\treturn \"\", trustError(TrustError{Operation: \"enroll fingerprints\", Err: ErrEnrollmentRefused})\n44|\t}\n45|\tif err := VerifyProfile(input.LeafDER, input.RootDER, parsed.String(), input.EnrolledAt); err != nil {\n46|\t\treturn \"\", err\n47|\t}\n48|\tenrolledAt, err := scalar.ParseTimestamp(input.EnrolledAt.UTC().Format(\"2006-01-02T15:04:05.000Z\"))\n49|\tif err != nil {\n50|\t\treturn \"\", trustError(TrustError{Operation: \"enroll timestamp\", Err: errors.Join(ErrEnrollmentRefused, err)})\n51|\t}\n52|\tentry := CredentialEntry{\n53|\t\tHostID:       parsed,\n54|\t\tCredentialID: scalar.SHA256Digest(input.LeafDER),\n55|\t\tSPKIID:       scalar.SHA256Digest(mustSPKI(input.LeafDER)),\n56|\t\tRootID:       scalar.SHA256Digest(input.RootDER),\n57|\t\tLeafDER:      append([]byte(nil), input.LeafDER...),\n58|\t\tRootDER:      append([]byte(nil), input.RootDER...),\n59|\t\tState:        EntryActive,\n60|\t\tEnrolledAt:   enrolledAt,\n61|\t}\n62|\tif err := store.transact(func(trust *TrustStore) error {\n63|\t\treturn admitEntry(trust, entry)\n64|\t}); err != nil {\n65|\t\treturn \"\", err\n66|\t}\n67|\treturn entry.CredentialID.String(), nil\n68|}\n69|\n70|func mustSPKI(leafDER []byte) []byte {\n71|\tleaf, err := x509.ParseCertificate(leafDER)\n72|\tif err != nil {\n73|\t\treturn nil\n74|\t}\n75|\treturn leaf.RawSubjectPublicKeyInfo\n76|}\n77|\n78|// admitEntry enforces the cross-entry rules across all entries including\n79|// revoked tombstones: a leaf, leaf public key or root must never map to more\n80|// than one host UUID, duplicate roots are invalid even for the same UUID, and\n81|// at most two non-revoked credentials may belong to one host.\n82|func admitEntry(trust *TrustStore, entry CredentialEntry) error {\n83|\tif len(trust.Entries) >= MaxEntries {\n84|\t\treturn trustError(TrustError{Operation: \"admit entry\", Err: ErrEnrollmentRefused})\n85|\t}\n86|\tvar live uint64\n87|\tfor _, existing := range trust.Entries {\n88|\t\tif bytes.Equal(existing.LeafDER, entry.LeafDER) {\n89|\t\t\treturn trustError(TrustError{Operation: \"admit entry\", Err: ErrEnrollmentRefused})\n90|\t\t}\n91|\t\tif existing.SPKIID.String() == entry.SPKIID.String() {\n92|\t\t\treturn trustError(TrustError{Operation: \"admit entry\", Err: ErrEnrollmentRefused})\n93|\t\t}\n94|\t\tif existing.RootID.String() == entry.RootID.String() {\n95|\t\t\treturn trustError(TrustError{Operation: \"admit entry\", Err: ErrEnrollmentRefused})\n96|\t\t}\n97|\t\tif existing.CredentialID.String() == entry.CredentialID.String() {\n98|\t\t\treturn trustError(TrustError{Operation: \"admit entry\", Err: ErrEnrollmentRefused})\n99|\t\t}\n100|\t\tif existing.HostID.String() == entry.HostID.String() && existing.State != EntryRevoked {\n101|\t\t\tlive++\n102|\t\t}\n103|\t}\n104|\tif live >= 2 {\n105|\t\treturn trustError(TrustError{Operation: \"admit entry\", Err: ErrEnrollmentRefused})\n106|\t}\n107|\ttrust.Entries = append(trust.Entries, entry)\n108|\treturn nil\n109|}\n110|\n111|// Issue creates a local credential: fresh keys and profile-exact\n112|// certificates, owner-only custody files, and a self-enrolled active entry,\n113|// committed atomically in that order. Custody files are written before the\n114|// trust commit so a crash can only leave inert files without authority, never\n115|// authority without verifiable custody; a failed trust commit removes the\n116|// staged credential directory again.\n117|func (store *Store) Issue(hostID string, now time.Time) (string, error) {\n118|\tissued, err := IssueCredential(hostID, now, nil)\n119|\tif err != nil {\n120|\t\treturn \"\", err\n121|\t}\n122|\tcredentialHex := scalar.SHA256Digest(issued.LeafDER).Hex()\n123|\tdirectory := filepath.Join(store.root, credentialsDir, credentialHex)\n124|\tif err := ensureOwnerDir(store.fs, directory, 0o700); err != nil {\n125|\t\treturn \"\", err\n126|\t}\n127|\tcommitted := false\n128|\tdefer func() {\n129|\t\tif !committed {\n130|\t\t\t_ = store.fs.Remove(filepath.Join(directory, certificateFile))\n131|\t\t\t_ = store.fs.Remove(filepath.Join(directory, privateKeyFile))\n132|\t\t\t_ = store.fs.Remove(filepath.Join(directory, rootFile))\n133|\t\t\t_ = store.fs.Remove(directory)\n134|\t\t}\n135|\t}()\n136|\tif err := writeCustodyFile(store, directory, certificateFile, pem.EncodeToMemory(&pem.Block{Type: \"CERTIFICATE\", Bytes: issued.LeafDER})); err != nil {\n137|\t\treturn \"\", err\n138|\t}\n139|\tif err := writeCustodyFile(store, directory, privateKeyFile, pem.EncodeToMemory(&pem.Block{Type: \"PRIVATE KEY\", Bytes: issued.LeafKeyDER})); err != nil {\n140|\t\treturn \"\", err\n141|\t}\n142|\tif err := writeCustodyFile(store, directory, rootFile, pem.EncodeToMemory(&pem.Block{Type: \"CERTIFICATE\", Bytes: issued.RootDER})); err != nil {\n143|\t\treturn \"\", err\n144|\t}\n145|\tenrolledAt, err := scalar.ParseTimestamp(now.UTC().Format(\"2006-01-02T15:04:05.000Z\"))\n146|\tif err != nil {\n147|\t\treturn \"\", trustError(TrustError{Operation: \"issue timestamp\", Err: errors.Join(ErrCredentialProfile, err)})\n148|\t}\n149|\tentry := CredentialEntry{\n150|\t\tHostID:       issued.HostID,\n151|\t\tCredentialID: scalar.SHA256Digest(issued.LeafDER),\n152|\t\tSPKIID:       scalar.SHA256Digest(mustSPKI(issued.LeafDER)),\n153|\t\tRootID:       scalar.SHA256Digest(issued.RootDER),\n154|\t\tLeafDER:      issued.LeafDER,\n155|\t\tRootDER:      issued.RootDER,\n156|\t\tState:        EntryActive,\n157|\t\tEnrolledAt:   enrolledAt,\n158|\t}\n159|\tif err := store.transact(func(trust *TrustStore) error {\n160|\t\treturn admitEntry(trust, entry)\n161|\t}); err != nil {\n162|\t\treturn \"\", err\n163|\t}\n164|\tcommitted = true\n165|\treturn entry.CredentialID.String(), nil\n166|}\n167|\n168|func writeCustodyFile(store *Store, directory, name string, contents []byte) error {\n169|\tstaged, err := store.fs.CreateTemp(directory, \".custody-stage-*\", 0o600)\n170|\tif err != nil {\n171|\t\treturn trustError(TrustError{Operation: \"write custody file\", Err: errors.Join(ErrTrustDurability, err)})\n172|\t}\n173|\tstaging := staged.Name()\n174|\tfailed := true\n175|\tdefer func() {\n176|\t\tif failed {\n177|\t\t\t_ = store.fs.Remove(staging)\n178|\t\t}\n179|\t}()\n180|\tif err := writeAll(staged, contents); err != nil {\n181|\t\t_ = staged.Close()\n182|\t\treturn trustError(TrustError{Operation: \"write custody file\", Err: errors.Join(ErrTrustDurability, err)})\n183|\t}\n184|\tif err := staged.Sync(); err != nil {\n185|\t\t_ = staged.Close()\n186|\t\treturn trustError(TrustError{Operation: \"sync custody file\", Err: errors.Join(ErrTrustDurability, err)})\n187|\t}\n188|\tif err := staged.Close(); err != nil {\n189|\t\treturn trustError(TrustError{Operation: \"sync custody file\", Err: errors.Join(ErrTrustDurability, err)})\n190|\t}\n191|\ttarget := filepath.Join(directory, name)\n192|\tif err := store.fs.Rename(staging, target); err != nil {\n193|\t\treturn trustError(TrustError{Operation: \"install custody file\", Err: errors.Join(ErrTrustDurability, err)})\n194|\t}\n195|\tinfo, err := store.fs.Lstat(target)\n196|\tif err != nil {\n197|\t\treturn trustError(TrustError{Operation: \"inspect custody file\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n198|\t}\n199|\tif err := verifyOwnerFile(target, info, 0o600); err != nil {\n200|\t\treturn err\n201|\t}\n202|\tfailed = false\n203|\treturn nil\n204|}\n205|\n206|// ValidateCustody checks the local credential files before use: owner-only\n207|// regular files, parseable PEMs, private/public match, profile, and the\n208|// configured host binding. No other file may select identity.\n209|func (store *Store) ValidateCustody(credentialHex, hostID string, now time.Time) error {\n210|\tconst operation = \"validate custody\"\n211|\tdirectory, err := store.CredentialDir(credentialHex)\n212|\tif err != nil {\n213|\t\treturn err\n214|\t}\n215|\tleafPEM, err := readOwnerFile(store, filepath.Join(directory, certificateFile))\n216|\tif err != nil {\n217|\t\treturn err\n218|\t}\n219|\tkeyPEM, err := readOwnerFile(store, filepath.Join(directory, privateKeyFile))\n220|\tif err != nil {\n221|\t\treturn err\n222|\t}\n223|\trootPEM, err := readOwnerFile(store, filepath.Join(directory, rootFile))\n224|\tif err != nil {\n225|\t\treturn err\n226|\t}\n227|\tleafBlock, _ := pem.Decode(leafPEM)\n228|\tkeyBlock, _ := pem.Decode(keyPEM)\n229|\trootBlock, _ := pem.Decode(rootPEM)\n230|\tif leafBlock == nil || keyBlock == nil || rootBlock == nil {\n231|\t\treturn trustError(TrustError{Operation: operation, Err: ErrCredentialCustody})\n232|\t}\n233|\tleaf, err := x509.ParseCertificate(leafBlock.Bytes)\n234|\tif err != nil {\n235|\t\treturn trustError(TrustError{Operation: operation, Err: errors.Join(ErrCredentialCustody, err)})\n236|\t}\n237|\troot, err := x509.ParseCertificate(rootBlock.Bytes)\n238|\tif err != nil {\n239|\t\treturn trustError(TrustError{Operation: operation, Err: errors.Join(ErrCredentialCustody, err)})\n240|\t}\n241|\tkey, err := x509.ParsePKCS8PrivateKey(keyBlock.Bytes)\n242|\tif err != nil {\n243|\t\treturn trustError(TrustError{Operation: operation, Err: errors.Join(ErrCredentialCustody, err)})\n244|\t}\n245|\tprivate, ok := key.(*ecdsa.PrivateKey)\n246|\tif !ok {\n247|\t\treturn trustError(TrustError{Operation: operation, Err: ErrCredentialCustody})\n248|\t}\n249|\tpublic, ok := leaf.PublicKey.(*ecdsa.PublicKey)\n250|\tif !ok {\n251|\t\treturn trustError(TrustError{Operation: operation, Err: ErrCredentialCustody})\n252|\t}\n253|\tif private.PublicKey.X.Cmp(public.X) != 0 || private.PublicKey.Y.Cmp(public.Y) != 0 {\n254|\t\treturn trustError(TrustError{Operation: operation, Err: ErrCredentialCustody})\n255|\t}\n256|\treturn VerifyProfile(leaf.Raw, root.Raw, hostID, now)\n257|}\n258|\n259|func readOwnerFile(store *Store, path string) ([]byte, error) {\n260|\tinfo, err := store.fs.Lstat(path)\n261|\tif err != nil {\n262|\t\treturn nil, trustError(TrustError{Operation: \"read custody file\", Err: errors.Join(ErrCredentialCustody, err)})\n263|\t}\n264|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n265|\t\treturn nil, err\n266|\t}\n267|\tcontents, err := store.fs.ReadFile(path)\n268|\tif err != nil {\n269|\t\treturn nil, trustError(TrustError{Operation: \"read custody file\", Err: errors.Join(ErrCredentialCustody, err)})\n270|\t}\n271|\treturn contents, nil\n272|}","final_result":true}}}
