es[index].CredentialID.String() {\n29|\t\t\treturn nil, trustError(TrustError{Operation: \"encode entries\", Err: ErrTrustValidation})\n30|\t\t}\n31|\t}\n32|\tvar output bytes.Buffer\n33|\toutput.WriteString(`{\"schema\":` + quoteJSON(TrustSchemaID))\n34|\toutput.WriteString(`,\"schema_version\":` + quoteJSON(TrustSchemaVersion))\n35|\toutput.WriteString(`,\"generation\":` + strconv.FormatUint(store.Generation, 10))\n36|\toutput.WriteString(`,\"entries\":[`)\n37|\tfor index, entry := range entries {\n38|\t\tif index > 0 {\n39|\t\t\toutput.WriteByte(',')\n40|\t\t}\n41|\t\tencoded, err := encodeEntry(entry)\n42|\t\tif err != nil {\n43|\t\t\treturn nil, err\n44|\t\t}\n45|\t\toutput.Write(encoded)\n46|\t}\n47|\toutput.WriteString(`]}`)\n48|\tdocument := output.Bytes()\n49|\tif _, err := DecodeTrust(document); err != nil {\n50|\t\treturn nil, trustError(TrustError{Operation: \"encode round trip\", Err: errors.Join(ErrTrustValidation, err)})\n51|\t}\n52|\treturn document, nil\n53|}\n54|\n55|func encodeEntry(entry CredentialEntry) ([]byte, error) {\n56|\tif entry.State != EntryActive && entry.State != EntryRetiring && entry.State != EntryRevoked {\n57|\t\treturn nil, trustError(TrustError{Operation: \"encode state\", Err: ErrTrustValidation})\n58|\t}\n59|\tif entry.State == EntryRetiring && entry.RetireAt == nil {\n60|\t\treturn nil, trustError(TrustError{Operation: \"encode retire_at\", Err: ErrTrustValidation})\n61|\t}\n62|\tif entry.State != EntryRetiring && entry.RetireAt != nil {\n63|\t\treturn nil, trustError(TrustError{Operation: \"encode retire_at\", Err: ErrTrustValidation})\n64|\t}\n65|\tif len(entry.LeafDER) == 0 || len(entry.LeafDER) > MaxDERBytes || len(entry.RootDER) == 0 || len(entry.RootDER) > MaxDERBytes {\n66|\t\treturn nil, trustError(TrustError{Operation: \"encode certificate bytes\", Err: ErrTrustValidation})\n67|\t}\n68|\tretireAt := \"null\"\n69|\tif entry.RetireAt != nil {\n70|\t\tretireAt = quoteJSON(entry.RetireAt.String())\n71|\t}\n72|\tvar output bytes.Buffer\n73|\toutput.WriteString(`{\"host_id\":` + quoteJSON(entry.HostID.String()))\n74|\toutput.WriteString(`,\"credential_id\":` + quoteJSON(entry.CredentialID.String()))\n75|\toutput.WriteString(`,\"spki_id\":` + quoteJSON(entry.SPKIID.String()))\n76|\toutput.WriteString(`,\"root_id\":` + quoteJSON(entry.RootID.String()))\n77|\toutput.WriteString(`,\"leaf_der\":` + quoteJSON(base64.RawURLEncoding.EncodeToString(entry.LeafDER)))\n78|\toutput.WriteString(`,\"root_der\":` + quoteJSON(base64.RawURLEncoding.EncodeToString(entry.RootDER)))\n79|\toutput.WriteString(`,\"state\":` + quoteJSON(entry.State))\n80|\toutput.WriteString(`,\"enrolled_at\":` + quoteJSON(entry.EnrolledAt.String()))\n81|\toutput.WriteString(`,\"retire_at\":` + retireAt + `}`)\n82|\treturn output.Bytes(), nil\n83|}\n84|\n85|func quoteJSON(value string) string {\n86|\tencoded, err := json.Marshal(value)\n87|\tif err != nil {\n88|\t\treturn `\"\"`\n89|\t}\n90|\treturn string(encoded)\n91|}","final_result":true}}}
