{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c90f","stream":{"kind":"session","id":"01a08900-d199-7822-974c-1de7f95bc0fc"},"sequence":738,"recorded_at":1780531400001471,"record_type":"event","durability":"durable","causation_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","run_stream":{"kind":"run","id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef"},"task_stream":{"kind":"task","id":"01a08903-1991-73b1-bc71-fc4e8dbf850e"},"task_id":"01a08903-1991-73b1-bc71-fc4e8dbf850e","event":{"kind":"output","task_id":"01a08903-1991-73b1-bc71-fc4e8dbf850e","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1kiyj6/worktree/internal/hosttrust/rotate.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"crypto/x509\"\n5|\t\"encoding/pem\"\n6|\t\"errors\"\n7|\t\"path/filepath\"\n8|\t\"time\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|)\n12|\n13|// RotationBound is the maximum overlap of an old credential after the trust\n14|// transition admits its replacement: 24 hours, and never past old leaf\n15|// expiry. There is no overlap extension.\n16|const RotationBound = 24 * time.Hour\n17|\n18|// Rotate keeps the host UUID and creates a new credential with two fresh keys\n19|// and certificates. The local atomic trust transition admits the new entry as\n20|// active and marks the old entry retiring with a fixed retire_at no more than\n21|// 24 hours after the transition and no later than old leaf expiry. No second\n22|// rotation starts until the retiring entry is revoked. Failed enrollment\n23|// leaves the new route unavailable, never auto-trusted.\n24|func (store *Store) Rotate(hostID string, now time.Time) (newCredentialID string, retireAt time.Time, err error) {\n25|\tparsed, err := scalar.ParseUUIDv7(hostID)\n26|\tif err != nil {\n27|\t\treturn \"\", time.Time{}, trustError(TrustError{Operation: \"rotate host\", Err: errors.Join(ErrRotationRefused, err)})\n28|\t}\n29|\tissued, err := IssueCredential(parsed.String(), now, nil)\n30|\tif err != nil {\n31|\t\treturn \"\", time.Time{}, err\n32|\t}\n33|\tcredentialHex := scalar.SHA256Digest(issued.LeafDER).Hex()\n34|\tdirectory := filepath.Join(store.root, credentialsDir, credentialHex)\n35|\tif err := ensureOwnerDir(store.fs, directory, 0o700); err != nil {\n36|\t\treturn \"\", time.Time{}, err\n37|\t}\n38|\tcommitted := false\n39|\tdefer func() {\n40|\t\tif !committed {\n41|\t\t\t_ = store.fs.Remove(filepath.Join(directory, certificateFile))\n42|\t\t\t_ = store.fs.Remove(filepath.Join(directory, privateKeyFile))\n43|\t\t\t_ = store.fs.Remove(filepath.Join(directory, rootFile))\n44|\t\t\t_ = store.fs.Remove(directory)\n45|\t\t}\n46|\t}()\n47|\tif err := writeCustodyFile(store, directory, certificateFile, pem.EncodeToMemory(&pem.Block{Type: \"CERTIFICATE\", Bytes: issued.LeafDER})); err != nil {\n48|\t\treturn \"\", time.Time{}, err\n49|\t}\n50|\tif err := writeCustodyFile(store, directory, privateKeyFile, pem.EncodeToMemory(&pem.Block{Type: \"PRIVATE KEY\", Bytes: issued.LeafKeyDER})); err != nil {\n51|\t\treturn \"\", time.Time{}, err\n52|\t}\n53|\tif err := writeCustodyFile(store, directory, rootFile, pem.EncodeToMemory(&pem.Block{Type: \"CERTIFICATE\", Bytes: issued.RootDER})); err != nil {\n54|\t\treturn \"\", time.Time{}, err\n55|\t}\n56|\tenrolledAt, err := scalar.ParseTimestamp(now.UTC().Format(\"2006-01-02T15:04:05.000Z\"))\n57|\tif err != nil {\n58|\t\treturn \"\", time.Time{}, trustError(TrustError{Operation: \"rotate timestamp\", Err: errors.Join(ErrRotationRefused, err)})\n59|\t}\n60|\tnewEntry := CredentialEntry{\n61|\t\tHostID:       issued.HostID,\n62|\t\tCredentialID: scalar.SHA256Digest(issued.LeafDER),\n63|\t\tSPKIID:       scalar.SHA256Digest(mustSPKI(issued.LeafDER)),\n64|\t\tRootID:       scalar.SHA256Digest(issued.RootDER),\n65|\t\tLeafDER:      issued.LeafDER,\n66|\t\tRootDER:      issued.RootDER,\n67|\t\tState:        EntryActive,\n68|\t\tEnrolledAt:   enrolledAt,\n69|\t}\n70|\tvar fixedRetireAt time.Time\n71|\tif err := store.transact(func(trust *TrustStore) error {\n72|\t\told, err := rotationPredecessor(trust, parsed.String())\n73|\t\tif err != nil {\n74|\t\t\treturn err\n75|\t\t}\n76|\t\toldLeaf, err := x509.ParseCertificate(old.LeafDER)\n77|\t\tif err != nil {\n78|\t\t\treturn trustError(TrustError{Operation: \"rotate predecessor\", Err: errors.Join(ErrRotationRefused, err)})\n79|\t\t}\n80|\t\tdeadline := now.Add(RotationBound)\n81|\t\tif oldLeaf.NotAfter.Before(deadline) {\n82|\t\t\tdeadline = oldLeaf.NotAfter\n83|\t\t}\n84|\t\tif !deadline.After(now) {\n85|\t\t\treturn trustError(TrustError{Operation: \"rotate window\", Err: ErrRotationRefused})\n86|\t\t}\n87|\t\tstamp, err := scalar.ParseTimestamp(deadline.UTC().Format(\"2006-01-02T15:04:05.000Z\"))\n88|\t\tif err != nil {\n89|\t\t\treturn trustError(TrustError{Operation: \"rotate window\", Err: errors.Join(ErrRotationRefused, err)})\n90|\t\t}\n91|\t\tfixedRetireAt, err = stamp.Time()\n92|\t\tif err != nil {\n93|\t\t\treturn trustError(TrustError{Operation: \"rotate window\", Err: errors.Join(ErrRotationRefused, err)})\n94|\t\t}\n95|\t\tfor index := range trust.Entries {\n96|\t\t\tif trust.Entries[index].CredentialID.String() == old.CredentialID.String() {\n97|\t\t\t\ttrust.Entries[index].State = EntryRetiring\n98|\t\t\t\tretiring := stamp\n99|\t\t\t\ttrust.Entries[index].RetireAt = &retiring\n100|\t\t\t}\n101|\t\t}\n102|\t\treturn admitEntry(trust, newEntry)\n103|\t}); err != nil {\n104|\t\treturn \"\", time.Time{}, err\n105|\t}\n106|\tcommitted = true\n107|\treturn newEntry.CredentialID.String(), fixedRetireAt, nil\n108|}\n109|\n110|// rotationPredecessor selects the single active credential of a host. A\n111|// retiring entry blocks a second rotation; zero or multiple active entries\n112|// refuse.\n113|func rotationPredecessor(trust *TrustStore, hostID string) (CredentialEntry, error) {\n114|\tvar active []CredentialEntry\n115|\tfor _, entry := range trust.Entries {\n116|\t\tif entry.HostID.String() != hostID {\n117|\t\t\tcontinue\n118|\t\t}\n119|\t\tswitch entry.State {\n120|\t\tcase EntryRetiring:\n121|\t\t\treturn CredentialEntry{}, trustError(TrustError{Operation: \"rotate predecessor\", Err: ErrRotationRefused})\n122|\t\tcase EntryActive:\n123|\t\t\tactive = append(active, entry)\n124|\t\t}\n125|\t}\n126|\tif len(active) != 1 {\n127|\t\treturn CredentialEntry{}, trustError(TrustError{Operation: \"rotate predecessor\", Err: ErrRotationRefused})\n128|\t}\n129|\treturn active[0], nil\n130|}\n131|\n132|// MarkRetiring records a peer's announced rotation locally: the operator\n133|// caught up out of band, enrolled the peer's new tuple, and now bounds the\n134|// old credential with a fixed retire_at. The bound is no more than 24 hours\n135|// after this transition and later than enrollment; there is no overlap\n136|// extension, and only an active entry may retire.\n137|func (store *Store) MarkRetiring(credentialID string, retireAt, now time.Time) error {\n138|\tdigest, err := scalar.ParseDigest(credentialID)\n139|\tif err != nil {\n140|\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: errors.Join(ErrRotationRefused, err)})\n141|\t}\n142|\tstamp, err := scalar.ParseTimestamp(retireAt.UTC().Format(\"2006-01-02T15:04:05.000Z\"))\n143|\tif err != nil {\n144|\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: errors.Join(ErrRotationRefused, err)})\n145|\t}\n146|\treturn store.transact(func(trust *TrustStore) error {\n147|\t\tfor index := range trust.Entries {\n148|\t\t\tif trust.Entries[index].CredentialID.String() != digest.String() {\n149|\t\t\t\tcontinue\n150|\t\t\t}\n151|\t\t\tentry := &trust.Entries[index]\n152|\t\t\tif entry.State != EntryActive {\n153|\t\t\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: ErrRotationRefused})\n154|\t\t\t}\n155|\t\t\tenrolledAt, err := entry.EnrolledAt.Time()\n156|\t\t\tif err != nil {\n157|\t\t\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: errors.Join(ErrRotationRefused, err)})\n158|\t\t\t}\n159|\t\t\tfixed, err := stamp.Time()\n160|\t\t\tif err != nil {\n161|\t\t\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: errors.Join(ErrRotationRefused, err)})\n162|\t\t\t}\n163|\t\t\tif !fixed.After(now) || !fixed.After(enrolledAt) || fixed.After(now.Add(RotationBound)) {\n164|\t\t\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: ErrRotationRefused})\n165|\t\t\t}\n166|\t\t\tentry.State = EntryRetiring\n167|\t\t\tentry.RetireAt = &stamp\n168|\t\t\treturn nil\n169|\t\t}\n170|\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: ErrRotationRefused})\n171|\t})\n172|}\n173|\n174|// Revoke is an explicit local atomic transition to revoked. It increments\n175|// the generation, forbids all future admissions of that key, and retains the\n176|// public bytes permanently as a reuse tombstone. Revoking an already revoked\n177|// entry refuses: a failed commit reports failure, never absence or success.\n178|// Revocation is local: the operator must distribute it explicitly to every\n179|// peer, and loss or compromise requires revocation plus new out-of-band\n180|// enrollment, never same-key recovery.\n181|func (store *Store) Revoke(credentialID string) error {\n182|\tdigest, err := scalar.ParseDigest(credentialID)\n183|\tif err != nil {\n184|\t\treturn trustError(TrustError{Operation: \"revoke credential\", Err: errors.Join(ErrRevocationRefused, err)})\n185|\t}\n186|\treturn store.transact(func(trust *TrustStore) error {\n187|\t\tfor index := range trust.Entries {\n188|\t\t\tif trust.Entries[index].CredentialID.String() != digest.String() {\n189|\t\t\t\tcontinue\n190|\t\t\t}\n191|\t\t\tif trust.Entries[index].State == EntryRevoked {\n192|\t\t\t\treturn trustError(TrustError{Operation: \"revoke credential\", Err: ErrRevocationRefused})\n193|\t\t\t}\n194|\t\t\ttrust.Entries[index].State = EntryRevoked\n195|\t\t\ttrust.Entries[index].RetireAt = nil\n196|\t\t\treturn nil\n197|\t\t}\n198|\t\treturn trustError(TrustError{Operation: \"revoke credential\", Err: ErrRevocationRefused})\n199|\t})\n200|}","final_result":true}}}
