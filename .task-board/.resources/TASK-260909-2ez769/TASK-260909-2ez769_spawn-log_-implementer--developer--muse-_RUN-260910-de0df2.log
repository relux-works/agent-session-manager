{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d457","stream":{"kind":"session","id":"01a08900-d199-7822-974c-1de7f95bc0fc"},"sequence":2182,"recorded_at":1780531400004359,"record_type":"event","durability":"durable","causation_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","run_stream":{"kind":"run","id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef"},"task_stream":{"kind":"task","id":"01a0890c-c636-77c0-b625-723d0ff5b14e"},"task_id":"01a0890c-c636-77c0-b625-723d0ff5b14e","event":{"kind":"output","task_id":"01a0890c-c636-77c0-b625-723d0ff5b14e","chunk":"edited\nchanged lines: lines 243-264\n--- original\n+++ updated\n@@\n-// joinEntriesForTest renders a trust document from entries without the\n-// EncodeTrust round trip, so mapping-ambiguous pairs reach DecodeTrust.\n-func joinEntriesForTest(t *testing.T, entries ...CredentialEntry) []byte {\n-\tt.Helper()\n-\t// Encoder order isolates the mapping gate: an unsorted pair would\n-\t// refuse on ordering before uniqueness is examined.\n-\tsort.Slice(entries, func(i, j int) bool {\n-\t\treturn entries[i].CredentialID.String() < entries[j].CredentialID.String()\n-\t})\n-\tdocument := `{\"schema\":\"urn:ax:schema:host-trust-store\",\"schema_version\":\"1.0.0\",\"generation\":1,\"entries\":[`\n-\tfor index, entry := range entries {\n-\t\tencoded, err := encodeEntry(entry)\n-\t\tif err != nil {\n-\t\t\tt.Fatalf(\"encodeEntry error = %v\", err)\n-\t\t}\n-\t\tif index > 0 {\n-\t\t\tdocument += \",\"\n-\t\t}\n-\t\tdocument += string(encoded)\n-\t}\n-\treturn []byte(document + \"]}\")\n-}\n+// joinEntriesForTest renders a trust document from entries without the\n+// EncodeTrust round trip, so mapping-ambiguous pairs reach DecodeTrust.\n+// Entries render in encoder order: an unsorted pair would refuse on ordering\n+// before uniqueness is examined.\n+func joinEntriesForTest(t *testing.T, entries ...CredentialEntry) []byte {\n+\tt.Helper()\n+\tordered := append([]CredentialEntry(nil), entries...)\n+\tsort.Slice(ordered, func(i, j int) bool {\n+\t\treturn ordered[i].CredentialID.String() < ordered[j].CredentialID.String()\n+\t})\n+\treturn joinUnsortedForTest(t, ordered...)\n+}\n+\n+// joinUnsortedForTest renders entries in the given order, so a descending\n+// pair reaches the ordering check.\n+func joinUnsortedForTest(t *testing.T, entries ...CredentialEntry) []byte {\n+\tt.Helper()\n+\tdocument := `{\"schema\":\"urn:ax:schema:host-trust-store\",\"schema_version\":\"1.0.0\",\"generation\":1,\"entries\":[`\n+\tfor index, entry := range entries {\n+\t\tencoded, err := encodeEntry(entry)\n+\t\tif err != nil {\n+\t\t\tt.Fatalf(\"encodeEntry error = %v\", err)\n+\t\t}\n+\t\tif index > 0 {\n+\t\t\tdocument += \",\"\n+\t\t}\n+\t\tdocument += string(encoded)\n+\t}\n+\treturn []byte(document + \"]}\")\n+}\n","final_result":true}}}
