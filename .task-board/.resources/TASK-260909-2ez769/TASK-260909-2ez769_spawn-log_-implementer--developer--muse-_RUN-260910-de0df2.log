{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d453","stream":{"kind":"session","id":"01a08900-d199-7822-974c-1de7f95bc0fc"},"sequence":2180,"recorded_at":1780531400004355,"record_type":"event","durability":"durable","causation_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","run_stream":{"kind":"run","id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef"},"task_stream":{"kind":"task","id":"01a0890c-c5ea-7a92-bfef-b5a03a62f4d8"},"task_id":"01a0890c-c5ea-7a92-bfef-b5a03a62f4d8","event":{"kind":"output","task_id":"01a0890c-c5ea-7a92-bfef-b5a03a62f4d8","chunk":"edited\nchanged lines: lines 49-69\n--- original\n+++ updated\n@@\n-\t// Swapping two sorted entries yields an unsorted store.\n-\tother := issueForTest(t, testHostB, testNow)\n-\tpair := TrustStore{Generation: 1, Entries: []CredentialEntry{\n-\t\tentryForTest(t, issued, EntryActive, testNow, nil),\n-\t\tentryForTest(t, other, EntryActive, testNow, nil),\n-\t}}\n-\tpairDocument := string(encodeForTest(t, pair))\n-\tseparator := `},{\"host_id\"`\n-\tmiddle := strings.Index(pairDocument, separator)\n-\tif middle < 0 {\n-\t\tt.Fatal(\"pair fixture has no second entry\")\n-\t}\n-\thead := pairDocument[:middle]\n-\ttail := pairDocument[middle+len(separator):]\n-\tprefix := `\"entries\":[`\n-\tat := strings.Index(head, prefix) + len(prefix)\n-\tfirst, second := head[at:], tail[:len(tail)-2]\n-\tunsortedDocument := head[:at] + second + `},{\"host_id` + first + `]}`\n-\tif unsortedDocument == pairDocument {\n-\t\tt.Fatal(\"swap fixture did not reorder entries\")\n-\t}\n+\t// Two valid entries in descending credential_id order: every gate but\n+\t// the ordering check admits the pair, so only sorting refuses.\n+\tother := issueForTest(t, testHostB, testNow)\n+\torderedA := entryForTest(t, issued, EntryActive, testNow, nil)\n+\torderedB := entryForTest(t, other, EntryActive, testNow, nil)\n+\tdescending, ascending := orderedA, orderedB\n+\tif descending.CredentialID.String() < ascending.CredentialID.String() {\n+\t\tdescending, ascending = ascending, descending\n+\t}\n+\tif descending.CredentialID.String() == ascending.CredentialID.String() {\n+\t\tt.Fatal(\"descending fixture entries collide\")\n+\t}\n+\tunsortedDocument := string(joinUnsortedForTest(t, descending, ascending))\n","final_result":true}}}
