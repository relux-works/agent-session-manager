t} else if !errors.Is(err, ErrTrustUnsafeCustody) {\n116|\t\t\t\t\tt.Fatalf(\"ReadSnapshot(%s) error = %v, want ErrTrustUnsafeCustody\", test.name, err)\n117|\t\t\t\t}\n118|\t\t\t} else if !errors.Is(err, ErrTrustUnsafeCustody) {\n119|\t\t\t\tt.Fatalf(\"Open(%s) error = %v, want ErrTrustUnsafeCustody\", test.name, err)\n120|\t\t\t}\n121|\t\t})\n122|\t}\n123|}\n124|\n125|func TestTrustSymlinkRefused(t *testing.T) {\n126|\tstate := t.TempDir()\n127|\tstore := openForTest(t, state)\n128|\tif _, err := store.Initialize(); err != nil {\n129|\t\tt.Fatal(err)\n130|\t}\n131|\tshadow := filepath.Join(state, \"shadow.json\")\n132|\tif err := os.WriteFile(shadow, []byte(\"{}\"), 0o600); err != nil {\n133|\t\tt.Fatal(err)\n134|\t}\n135|\tif err := os.Remove(store.TrustPath()); err != nil {\n136|\t\tt.Fatal(err)\n137|\t}\n138|\tif err := os.Symlink(shadow, store.TrustPath()); err != nil {\n139|\t\tt.Fatal(err)\n140|\t}\n141|\tif _, err := store.ReadSnapshot(); err == nil {\n142|\t\tt.Fatal(\"ReadSnapshot(symlink) succeeded, want refusal\")\n143|\t} else if !errors.Is(err, ErrTrustUnsafeCustody) {\n144|\t\tt.Fatalf(\"ReadSnapshot(symlink) error = %v, want ErrTrustUnsafeCustody\", err)\n145|\t}\n146|}\n147|\n148|func TestCorruptTrustRefusedNeverEmpty(t *testing.T) {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
