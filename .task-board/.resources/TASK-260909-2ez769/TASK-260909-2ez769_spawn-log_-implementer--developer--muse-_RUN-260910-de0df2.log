38|func decodeGeneration(shape map[string]json.RawMessage) (uint64, error) {\n39|\traw, ok := shape[\"generation\"]\n40|\tif !ok {\n41|\t\treturn 0, trustError(TrustError{Operation: \"decode generation\", Err: ErrTrustValidation})\n42|\t}\n43|\tvar value any\n44|\tif err := strictJSONDecoder(raw).Decode(&value); err != nil {\n45|\t\treturn 0, trustError(TrustError{Operation: \"decode generation\", Err: errors.Join(ErrTrustDecode, err)})\n46|\t}\n47|\t// A JSON string holding digits is not a uint53: generation must be a\n48|\t// bare JSON number.\n49|\tnumber, ok := value.(json.Number)\n50|\tif !ok {\n51|\t\treturn 0, trustError(TrustError{Operation: \"decode generation\", Err: ErrTrustValidation})\n52|\t}\n53|\ttext := number.String()\n54|\tif text == \"\" {\n55|\t\treturn 0, trustError(TrustError{Operation: \"decode generation\", Err: ErrTrustValidation})\n56|\t}\n57|\tfor _, digit := range text {\n58|\t\tif digit < '0' || digit > '9' {\n59|\t\t\treturn 0, trustError(TrustError{Operation: \"decode generation\", Err: ErrTrustValidation})\n60|\t\t}\n61|\t}\n62|\tparsed, err := strconv.ParseUint(text, 10, 64)\n63|\tif err != nil {\n64|\t\treturn 0, trustError(TrustError{Operation: \"decode generation\", Err: ErrTrustValidation})\n65|\t}\n66|\tif parsed == 0 || parsed > MaxGeneration {\n67|\t\treturn 0, trustError(TrustError{Operation: \"decode generation\", Err: ErrTrustValidation})\n68|\t}\n69|\treturn parsed, nil\n70|}\n71|\n72|func decodeEntries(shape map[string]json.RawMessage) ([]CredentialEntry, error) {\n73|\traw, ok := shape[\"entries\"]\n74|\tif !ok {\n75|\t\treturn nil, trustError(TrustError{Operation: \"decode entries\", Err: ErrTrustValidation})\n76|\t}\n77|\tvar items []map[string]json.RawMessage\n78|\tdecoder := strictJSONDecoder(raw)\n79|\tif err := decoder.Decode(&items); err != nil {\n80|\t\treturn nil, trustError(TrustError{Operation: \"decode entries\", Err: errors.Join(ErrTrustDecode, err)})\n81|\t}\n82|\tif items == nil {\n83|\t\treturn nil, trustError(TrustError{Operation: \"decode entries\", Err: ErrTrustValidation})\n84|\t}\n85|\tif len(items) > MaxEntries {\n86|\t\treturn nil, trustError(TrustError{Operation: \"decode entries\", Err: ErrTrustValidation})\n87|\t}\n88|\tentries := make([]CredentialEntry, 0, len(items))\n89|\tfor index := range items {\n90|\t\tentry, err := decodeEntry(items[index])\n91|\t\tif err != nil {\n92|\t\t\treturn nil, err\n93|\t\t}\n94|\t\tentries = append(entries, entry)\n95|\t}\n96|\treturn entries, nil\n97|}\n98|\n99|func decodeEntry(shape map[string]json.RawMessage) (CredentialEntry, error) {\n100|\tif len(shape) != len(entryFields) {\n101|\t\treturn CredentialEntry{}, trustError(TrustError{Operation: \"decode entry\", Err: ErrTrustValidation})\n102|\t}\n103|\tfor _, field := range entryFields {\n104|\t\tif _, ok := shape[field]; !ok {\n105|\t\t\treturn CredentialEntry{}, trustError(TrustError{Operation: \"decode entry\", Err: ErrTrustValidation})\n106|\t\t}\n107|\t}\n108|\tvar entry CredentialEntry\n109|\tif err := decodeEntryString(shape, \"host_id\", func(value string) error {\n110|\t\tparsed, err := scalar.ParseUUIDv7(value)\n111|\t\tif err != nil {\n112|\t\t\treturn err\n113|\t\t}\n114|\t\tentry.HostID = parsed\n115|\t\treturn nil\n116|\t}); err != nil {\n117|\t\treturn CredentialEntry{}, err\n118|\t}\n119|\tfor _, field := range []string{\"credential_id\", \"spki_id\", \"root_id\"} {\n120|\t\tif err := decodeEntryDigest(shape, field, &entry, field); err != nil {\n121|\t\t\treturn CredentialEntry{}, err\n122|\t\t}\n123|\t}\n124|\tvar leafDER, rootDER []byte\n125|\tfor _, field := range []string{\"leaf_der\", \"root_der\"} {\n126|\t\tder, err := decodeEntryDER(shape, field)\n127|\t\tif err != nil {\n128|\t\t\treturn CredentialEntry{}, err\n129|\t\t}\n130|\t\tif field == \"leaf_der\" {\n131|\t\t\tleafDER = der\n132|\t\t} else {\n133|\t\t\trootDER = der\n134|\t\t}\n135|\t}\n136|\tentry.LeafDER = leafDER\n137|\tentry.RootDER = rootDER\n138|\tif err := decodeEntryString(shape, \"state\", func(value string) error {\n139|\t\tswitch value {\n140|\t\tcase EntryActive, EntryRetiring, EntryRevoked:\n141|\t\t\tentry.State = value\n142|\t\t\treturn nil\n143|\t\tdefault:\n144|\t\t\treturn ErrTrustValidation\n145|\t\t}\n146|\t}); err != nil {\n147|\t\treturn CredentialEntry{}, err\n148|\t}\n149|\tif err := decodeEntryString(shape, \"enrolled_at\", func(value string) error {\n150|\t\tparsed, err := scalar.ParseTimestamp(value)\n151|\t\tif err != nil {\n152|\t\t\treturn err\n153|\t\t}\n154|\t\tentry.EnrolledAt = parsed\n155|\t\treturn nil\n156|\t}); err != nil {\n157|\t\treturn CredentialEntry{}, err\n158|\t}\n159|\tretireRaw := shape[\"retire_at\"]\n160|\tif string(retireRaw) == \"null\" {\n161|\t\tif entry.State == EntryRetiring {\n162|\t\t\treturn CredentialEntry{}, trustError(TrustError{Operation: \"decode retire_at\", Err: ErrTrustValidation})\n163|\t\t}\n164|\t} else {\n165|\t\tvar text string\n166|\t\tif err := strictJSONDecoder(retireRaw).Decode(&text); err != nil {\n167|\t\t\treturn CredentialEntry{}, trustError(TrustError{Operation: \"decode retire_at\", Err: errors.Join(ErrTrustDecode, err)})\n168|\t\t}\n169|\t\tparsed, err := scalar.ParseTimestamp(text)\n170|\t\tif err != nil {\n171|\t\t\treturn CredentialEntry{}, trustError(TrustError{Operation: \"decode retire_at\", Err: errors.Join(ErrTrustDecode, err)})\n172|\t\t}\n173|\t\tif entry.State != EntryRetiring {\n174|\t\t\treturn CredentialEntry{}, trustError(TrustError{Operation: \"decode retire_at\", Err: ErrTrustValidation})\n175|\t\t}\n176|\t\tentry.RetireAt = &parsed\n177|\t}\n178|\tif entry.RetireAt != nil {\n179|\t\tretireAt, err := entry.RetireAt.Time()\n180|\t\tif err != nil {\n181|\t\t\treturn CredentialEntry{}, trustError(TrustError{Operation: \"decode retire_at\", Err: errors.Join(ErrTrustDecode, err)})\n182|\t\t}\n183|\t\tenrolledAt, err := entry.EnrolledAt.Time()\n184|\t\tif err != nil {\n185|\t\t\treturn CredentialEntry{}, trustError(TrustError{Operation: \"decode enrolled_a