{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9fd","stream":{"kind":"session","id":"01a08900-d199-7822-974c-1de7f95bc0fc"},"sequence":857,"recorded_at":1780531400001709,"record_type":"event","durability":"durable","causation_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","run_stream":{"kind":"run","id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef"},"task_stream":{"kind":"task","id":"01a08903-c8b3-79d0-a2c6-f1984ee1c2ff"},"task_id":"01a08903-c8b3-79d0-a2c6-f1984ee1c2ff","event":{"kind":"output","task_id":"01a08903-c8b3-79d0-a2c6-f1984ee1c2ff","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1kiyj6/worktree/internal/config/migration_v4_apply.go`.\n1|package config\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"errors\"\n6|\t\"time\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/hosttrust\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// ApplyV4OS captures real process inputs and performs one explicit durable\n13|// Configuration 4.0.0 migration. The caller supplies the exact confirmed\n14|// preview from PreviewV4; confirm must be true.\n15|func ApplyV4OS(platform scalar.Platform, overrides Overrides, preview V4Preview, confirm bool, now time.Time) (V4ApplyResult, error) {\n16|\tinputs, err := OSInputs(platform)\n17|\tif err != nil {\n18|\t\treturn V4ApplyResult{}, err\n19|\t}\n20|\treturn applyV4(inputs, overrides, preview, confirm, now, osMigrationFileSystem{}, hosttrust.Open)\n21|}\n22|\n23|// ApplyV4 is the dependency-injected production entry point. It writes only\n24|// the selected configuration file, a deterministic source-version backup in\n25|// the same directory, and one trust generation bump under the shared\n26|// authorization lock.\n27|func ApplyV4(inputs Inputs, overrides Overrides, preview V4Preview, confirm bool, now time.Time) (V4ApplyResult, error) {\n28|\treturn applyV4(inputs, overrides, preview, confirm, now, osMigrationFileSystem{}, hosttrust.Open)\n29|}\n30|\n31|func applyV4(inputs Inputs, overrides Overrides, preview V4Preview, confirm bool, now time.Time,\n32|\tfilesystem migrationFileSystem, openStore func(string) (*hosttrust.Store, error)) (V4ApplyResult, error) {\n33|\tif !confirm {\n34|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"confirm preview\", Err: ErrMigrationV4ConfirmRequired})\n35|\t}\n36|\tif preview.SourceVersion != CurrentVersion || len(preview.SourceDocument) == 0 || len(preview.Replacement) == 0 {\n37|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate preview\", Err: ErrMigrationV4PreviewMismatch})\n38|\t}\n39|\tsnapshot, err := Load(inputs, overrides)\n40|\tif err != nil {\n41|\t\treturn V4ApplyResult{}, err\n42|\t}\n43|\tloaded, decoded := snapshot.Configuration()\n44|\tif !snapshot.ConfigPresent() || !decoded {\n45|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"load source\", Err: ErrMigrationSourceAbsent})\n46|\t}\n47|\tif loaded.SourceVersion != CurrentVersion {\n48|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"select source\", Err: ErrMigrationV4Source})\n49|\t}\n50|\tif !bytes.Equal(snapshot.Document(), preview.SourceDocument) {\n51|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate preview source\", Err: ErrMigrationV4StaleSource})\n52|\t}\n53|\tselected, _ := snapshot.Paths().Path(ConfigFile)\n54|\tfilename := selected.Value.String()\n55|\tstateDir := stateDirOf(snapshot)\n56|\tstore, err := openStore(stateDir)\n57|\tif err != nil {\n58|\t\treturn V4ApplyResult{}, err\n59|\t}\n60|\tcurrent, err := store.ReadSnapshot()\n61|\tif err != nil {\n62|\t\treturn V4ApplyResult{}, err\n63|\t}\n64|\tif current.Generation != preview.SourceGeneration {\n65|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate preview generation\", Err: ErrMigrationV4StaleGeneration})\n66|\t}\n67|\trendered, err := renderV4Preview(snapshot.Document(), loaded.Value, current, preview.CredentialID, preview.DroppedPeers, now, inputs)\n68|\tif err != nil {\n69|\t\treturn V4ApplyResult{}, err\n70|\t}\n71|\tif !bytes.Equal(rendered.Replacement, preview.Replacement) {\n72|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate preview bytes\", Err: ErrMigrationV4PreviewMismatch})\n73|\t}\n74|\t// The custody files behind the selected credential must validate before\n75|\t// use, exactly as Section 11.10.2 requires for local identity.\n76|\tcredentialHex := previewCredentialHex(preview.CredentialID)\n77|\tif err := store.ValidateCustody(credentialHex, loaded.Value.HostID, now); err != nil {\n78|\t\treturn V4ApplyResult{}, err\n79|\t}\n80|\tbackup := filename + \".bak.\" + loaded.SourceVersion\n81|\treplaced := false\n82|\tgeneration, err := store.CommitConfigChange(func() error {\n83|\t\tif err := replaceDurably(filesystem, filename, backup, snapshot.Document(), preview.Replacement); err != nil {\n84|\t\t\treturn err\n85|\t\t}\n86|\t\treplaced = true\n87|\t\treturn nil\n88|\t})\n89|\tif err != nil {\n90|\t\tif replaced {\n91|\t\t\trecovery, rollbackErr := writeTempReplace(filesystem, filename, snapshot.Document())\n92|\t\t\tif rollbackErr != nil {\n93|\t\t\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"recover source after trust commit\", Err: errors.Join(ErrMigrationSync, ErrMigrationRecovery, err, rollbackErr)})\n94|\t\t\t}\n95|\t\t\t_ = recovery\n96|\t\t}\n97|\t\treturn V4ApplyResult{}, err\n98|\t}\n99|\treturn V4ApplyResult{\n100|\t\tMigration:  MigrationResult{SourceVersion: loaded.SourceVersion, TargetVersion: Version4, BackupPath: backup, Changed: true},\n101|\t\tGeneration: generation,\n102|\t}, nil\n103|}\n104|\n105|// RollbackV4OS captures real process inputs and performs one explicit\n106|// operator rollback: stopping every host channel is the operator's act, and\n107|// this call replaces configuration from the preserved backup and bumps the\n108|// trust generation so stale-generation streams cannot survive.\n109|func RollbackV4OS(platform scalar.Platform, overrides Overrides, options RollbackV4Options) (V4ApplyResult, error) {\n110|\tinputs, err := OSInputs(platform)\n111|\tif err != nil {\n112|\t\treturn V4ApplyResult{}, err\n113|\t}\n114|\treturn rollbackV4(inputs, overrides, options, osMigrationFileSystem{}, hosttrust.Open)\n115|}\n116|\n117|// RollbackV4 is the dependency-injected production entry point.\n118|func RollbackV4(inputs Inputs, overrides Overrides, options RollbackV4Options) (V4ApplyResult, error) {\n119|\treturn rollbackV4(inputs, overrides, options, osMigrationFileSystem{}, hosttrust.Open)\n120|}\n121|\n122|func rollbackV4(inputs Inputs, overrides Overrides, options RollbackV4Options,\n123|\tfilesystem migrationFileSystem, openStore func(string) (*hosttrust.Store, error)) (V4ApplyResult, error) {\n124|\tif !options.AcknowledgeNoHostChannelAssurance {\n125|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"acknowledge rollback\", Err: ErrRollbackV4AckRequired})\n126|\t}\n127|\tsnapshot, err := Load(inputs, overrides)\n128|\tif err != nil {\n129|\t\treturn V4ApplyResult{}, err\n130|\t}\n131|\tloaded, decoded := snapshot.Configuration()\n132|\tif !snapshot.ConfigPresent() || !decoded {\n133|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"load source\", Err: ErrMigrationSourceAbsent})\n134|\t}\n135|\tselected, _ := snapshot.Paths().Path(ConfigFile)\n136|\tfilename := selected.Value.String()\n137|\tbackup := options.BackupPath\n138|\tif backup == \"\" {\n139|\t\tbackup = filename + \".bak.\" + CurrentVersion\n140|\t}\n141|\tbackupBytes, err := filesystem.ReadFile(backup)\n142|\tif err != nil {\n143|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"read backup\", Err: errors.Join(ErrRollbackV4Backup, err)})\n144|\t}\n145|\tcontext := DecodeContext{RuntimePlatform: inputs.Platform, BackendSettings: inputs.BackendSettings}\n146|\tbackupLoaded, err := Decode(backupBytes, context)\n147|\tif err != nil {\n148|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate backup\", Err: errors.Join(ErrRollbackV4Backup, err)})\n149|\t}\n150|\tif backupLoaded.SourceVersion == Version4 {\n151|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate backup\", Err: ErrRollbackV4Backup})\n152|\t}\n153|\tif bytes.Equal(snapshot.Document(), backupBytes) {\n154|\t\treturn V4ApplyResult{Migration: MigrationResult{SourceVersion: loaded.SourceVersion, TargetVersion: backupLoaded.SourceVersion, BackupPath: backup}}, nil\n155|\t}\n156|\tstore, err := openStore(stateDirOf(snapshot))\n157|\tif err != nil {\n158|\t\treturn V4ApplyResult{}, err\n159|\t}\n160|\tpreRollback := filename + \".pre-rollback.\" + loaded.SourceVersion\n161|\treplaced := false\n162|\tgeneration, err := store.CommitConfigChange(func() error {\n163|\t\tif err := replaceDurably(filesystem, filename, preRollback, snapshot.Document(), backupBytes); err != nil {\n164|\t\t\treturn err\n165|\t\t}\n166|\t\treplaced = true\n167|\t\treturn nil\n168|\t})\n169|\tif err != nil {\n170|\t\tif replaced {\n171|\t\t\t_, rollbackErr := writeTempReplace(filesystem, filename, snapshot.Document())\n172|\t\t\tif rollbackErr != nil {\n173|\t\t\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"recover source after trust commit\", Err: errors.Join(ErrMigrationSync, ErrMigrationRecovery, err, rollbackErr)})\n174|\t\t\t}\n175|\t\t}\n176|\t\treturn V4ApplyResult{}, err\n177|\t}\n178|\treturn V4ApplyResult{\n179|\t\tMigration:  MigrationResult{SourceVersion: loaded.SourceVersion, TargetVersion: backupLoaded.SourceVersion, BackupPath: preRollback, Changed: true},\n180|\t\tGeneration: generation,\n181|\t}, nil\n182|}","final_result":true}}}
