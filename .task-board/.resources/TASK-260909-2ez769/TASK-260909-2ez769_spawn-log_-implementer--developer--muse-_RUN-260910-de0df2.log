eTrust(retiring with null retire_at) succeeded, want refusal\")\n124|\t}\n125|}\n126|\n127|func TestEncodeTrustRefusals(t *testing.T) {\n128|\tissued := issueForTest(t, testHostA, testNow)\n129|\tactive := entryForTest(t, issued, EntryActive, testNow, nil)\n130|\tretire := testNow.Add(time.Hour)\n131|\tretiring := entryForTest(t, issued, EntryRetiring, testNow, &retire)\n132|\ttests := []struct {\n133|\t\tname  string\n134|\t\tstore TrustStore\n135|\t}{\n136|\t\t{\"generation zero\", TrustStore{Generation: 0, Entries: []CredentialEntry{active}}},\n137|\t\t{\"generation exhausted\", TrustStore{Generation: MaxGeneration + 1, Entries: []CredentialEntry{active}}},\n138|\t\t{\"duplicate entries\", TrustStore{Generation: 1, Entries: []CredentialEntry{active, active}}},\n139|\t\t{\"retiring without retire_at\", TrustStore{Generation: 1, Entries: []CredentialEntry{entryForTest(t, issued, EntryRetiring, testNow, nil)}}},\n140|\t\t{\"revoked with retire_at\", TrustStore{Generation: 1, Entries: []CredentialEntry{retiring}}},\n141|\t}\n142|\tfor index := range tests {\n143|\t\t// The revoked case reuses the retiring entry value with revoked state.\n144|\t\tif tests[index].name == \"revoked with retire_at\" {\n145|\t\t\ttests[index].store.Entries[0].State = EntryRevoked\n146|\t\t}\n147|\t}\n148|\tfor _, test := range tests {\n149|\t\tt.Run(test.name, func(t *testing.T) {\n150|\t\t\tif _, err := EncodeTrust(test.store); err == nil {\n151|\t\t\t\tt.Fatalf(\"EncodeTrust(%s) succeeded, want refusal\", test.name)\n152|\t\t\t}\n153|\t\t})\n154|\t}\n155|}\n156|\n157|func TestEncodeTrustGenerationCeiling(t *testing.T) {\n158|\tissued := issueForTest(t, testHostA, testNow)\n159|\tstore := TrustStore{Generation: MaxGeneration, Entries: []CredentialEntry{entryForTest(t, issued, EntryActive, testNow, nil)}}\n160|\tdocument, err := EncodeTrust(store)\n161|\tif err != nil {\n162|\t\tt.Fatalf(\"EncodeTrust(max generation) error = %v\", err)\n163|\t}\n164|\tdecoded, err := DecodeTrust(document)\n165|\tif err != nil {\n166|\t\tt.Fatalf(\"DecodeTrust(max generation) error = %v\", err)\n167|\t}\n168|\tif decoded.Generation != MaxGeneration {\n169|\t\tt.Fatalf(\"DecodeTrust generation = %d, want %d\", decoded.Generation, uint64(MaxGeneration))\n170|\t}\n171|}\n172|\n173|func TestTrustRedaction(t *testing.T) {\n174|\tissued := issueForTest(t, testHostA, testNow)\n175|\tstore := TrustStore{Generation: 1, Entries: []CredentialEntry{entryForTest(t, issued, EntryActive, testNow, nil)}}\n176|\tsnapshot := Snapshot{Generation: 1, Trust: store}\n177|\tmaterial := EnrollmentMaterial{HostID: testHostA, CredentialID: \"sha256:00\", LeafDER: issued.LeafDER, RootDER: issued.RootDER}\n178|\trequest := AuthRequest{LocalHostID: testHostA, LocalCredentialID: \"sha256:00\", RemoteLeafDER: issued.LeafDER, Allowlisted: []string{testHostB}, HelloHostID: testHostB}\n179|\tformatted := []string{\n180|\t\tstore.String(), store.GoString(), sprintfForTest(snapshot), sprintfForTest(store.Entries[0]),\n181|\t\tissued.String(), issued.GoString(), sprintfForTest(material), sprintfForTest(request), sprintfForTest(snapshot),\n182|\t}\n183|\tfor _, rendered := range formatted {\n184|\t\tfor _, secret := range []string{testHostA, testHostB, \"sha256:\", \"PRIVATE\", \"CERTIFICATE\"} {\n185|\t\t\tif strings.Contains(rendered, secret) {\n186|\t\t\t\tt.Fatalf(\"redacted rendering %q exposes %q\", rendered, secret)\n187|\t\t\t}\n188|\t\t}\n189|\t}\n190|\trefusal := trustError(TrustError{Operation: \"decode document\", Err: ErrTrustDecode})\n191|\tif strings.Contains(refusal.Error(), testHostA) || !errors.Is(refusal, ErrTrustDecode) {\n192|\t\tt.Fatalf(\"TrustError rendering leaks or breaks unwrapping: %q\", refusal.Error())\n193|\t}\n194|}\n195|\n196|func sprintfForTest(value fmt.Formatter) string {\n197|\t// %v and %s dispatch to Format, so the static rendering is exercised,\n198|\t// not just String.\n199|\treturn fmt.Sprintf(\"%v|%s|%+v\", value, value, value)\n200|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
