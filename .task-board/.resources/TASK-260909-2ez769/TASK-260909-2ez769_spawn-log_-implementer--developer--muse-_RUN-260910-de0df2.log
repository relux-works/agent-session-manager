mote\\n  m                      Execute a mutation (write operation)\\n  migrate-keychain       Import legacy remote credentials into macOS Keychain\\n  migrate-project-config Preview or apply guarded deprecated project-config alias migration\\n  plan                   Show execution plan with phases and critical path\\n  q                      Query the board with a mini DSL\\n  repair-links           List or remove unsupported container dependency links\\n  resource               Upload, update, download, and delete board resources\\n  self-update            Update task-board to the latest version\\n  session                Inspect and stop Task-board Session Manager sessions\\n  spawn                  Queue an agent spawn run for a board task\\n  switch-user            Switch active user for current remote\\n  tree                   Show board as hierarchical tree\\n  tui                    Launch interactive TUI\\n  validate               Validate board structure\\n  whoami                 Show current remote and active user\\n  worktree               Inspect and repair managed Story workspaces\\n\\nFlags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n  -h, --help                     help for task-board\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n  -v, --version                  version for task-board\\n\\nUse \\\"task-board [command] --help\\\" for more information about a command.\\n===\\n{\\\"defaultFields\\\":[\\\"id\\\",\\\"name\\\",\\\"status\\\"],\\\"fields\\\":[\\\"id\\\",\\\"type\\\",\\\"name\\\",\\\"title\\\",\\\"status\\\",\\\"integrationCheckpointed\\\",\\\"review\\\",\\\"task_class\\\",\\\"estimate\\\",\\\"observability\\\",\\\"parent\\\",\\\"assignee\\\",\\\"description\\\",\\\"scope\\\",\\\"ac\\\",\\\"blockedBy\\\",\\\"blocks\\\",\\\"derivedBlockedBy\\\",\\\"derivedBlocks\\\",\\\"checklist\\\",\\\"notes\\\",\\\"created\\\",\\\"updated\\\",\\\"isBlocked\\\",\\\"isAdvisoryBlocked\\\",\\\"children\\\",\\\"preconditionResources\\\",\\\"outcomeResources\\\",\\\"identity\\\",\\\"binding\\\",\\\"lineage\\\",\\\"lifecycle\\\",\\\"freshness\\\",\\\"actualization\\\",\\\"security\\\",\\\"payload\\\"],\\\"grammar\\\":{\\\"statement\\\":\\\"OPERATION(ARGUMENTS) { PROJECTION }; the projection block is optional\\\",\\\"batch\\\":\\\"STATEMENT; STATEMENT — statements separated by ';', results keep source order\\\",\\\"arguments\\\":\\\"comma-separated arguments: the first bare positional value is the element/identifier argument; remaining arguments use key=value; no operators or lists (not key in [a,b], not key!=value)\\\",\\\"values\\\":\\\"a bare identifier (letters, digits, '_', '-', '.', '/'), an int, a bool (true|false), or a \\\\\\\"double-quoted string\\\\\\\"; quote any value containing spaces, commas or parentheses\\\",\\\"escapes\\\":[\\\"\\\\\\\\\\\\\\\"\\\",\\\"\\\\\\\\\\\\\\\\\\\",\\\"\\\\\\\\n\\\",\\\"\\\\\\\\t\\\"],\\\"projection\\\":\\\"field projection: { field preset ... } — space-separated field names and preset names inside braces; omitted means the default fields\\\",\\\"tokens\\\":[\\\"identifier\\\",\\\"string\\\",\\\"'('\\\",\\\"')'\\\",\\\"'{'\\\",\\\"'}'\\\",\\\"'='\\\",\\\"','\\\",\\\"';'\\\",\\\"end of input\\\"],\\\"examples\\\":[\\\"op()\\\",\\\"op(key=value)\\\",\\\"op(key=value, other=42, flag=true)\\\",\\\"op(key=\\\\\\\"quoted value with \\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\\ \\\\\\\\n \\\\\\\\t\\\\\\\")\\\",\\\"op(positional)\\\",\\\"op() { field preset }\\\",\\\"op(key=value) { field }; other()\\\"]},\\\"mutationMetadata\\\":{\\\"accept_cr\\\":{\\\"description\\\":\\\"Record an evidence-backed reviewer acceptance and route the element to integrating\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID carrying the Change Request\\\",\\\"required\\\":true},{\\\"name\\\":\\\"revision\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Change Request revision being accepted (expected-revision CAS)\\\",\\\"required\\\":true},{\\\"name\\\":\\\"evidence\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Task-scoped outcome resource name carrying the verdict evidence\\\",\\\"required\\\":true}],\\\"examples\\\":[\\\"accept_cr(TASK-260803-323q82, revision=2, evidence=TASK-260803-323q82_review-verdict-rev2.md)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false},\\\"add_checklist_item\\\":{\\\"description\\\":\\\"Add a new checklist item\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\",\\\"required\\\":true},{\\\"name\\\":\\\"text\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Checklist item text\\\",\\\"required\\\":true}],\\\"examples\\\":[\\\"add_checklist_item(TASK-260218-abc123, text=\\\\\\\"Write unit tests\\\\\\\")\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false},\\\"add_resource\\\":{\\\"description\\\":\\\"Add a text resource to an element\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\",\\\"required\\\":true},{\\\"name\\\":\\\"name\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Resource name (e.g. research.md)\\\",\\\"required\\\":true},{\\\"name\\\":\\\"content\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Resource content (text); required if path is not provided\\\"},{\\\"name\\\":\\\"path\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Client-local file path (remote CLI inlines content; board-server rejects raw paths)\\\"},{\\\"name\\\":\\\"type\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"default\\\":\\\"outcome\\\",\\\"description\\\":\\\"Resource type\\\",\\\"enum\\\":[\\\"precondition\\\",\\\"outcome\\\"]},{\\\"name\\\":\\\"description\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"One-line description\\\"}],\\\"examples\\\":[\\\"add_resource(TASK-260218-abc123, name=\\\\\\\"research.md\\\\\\\", content=\\\\\\\"...\\\\\\\", type=outcome)\\\",\\\"add_resource(TASK-260218-abc123, name=\\\\\\\"spec.md\\\\\\\", path=\\\\\\\".temp/spec.md\\\\\\\", type=precondition)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false},\\\"assign\\\":{\\\"description\\\":\\\"Assign an agent to an element\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\",\\\"required\\\":true},{\\\"name\\\":\\\"agent\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Agent name\\\",\\\"required\\\":true}],\\\"examples\\\":[\\\"assign(TASK-260218-abc123, agent=claude-opus)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":true},\\\"audit_context_validation\\\":{\\\"description\\\":\\\"Run one no-model validation audit over a ready context and apply its consequence\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"CTX identifier\\\",\\\"required\\\":true},{\\\"name\\\":\\\"expected_revision\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Observed record revision\\\"},{\\\"name\\\":\\\"trigger\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"default\\\":\\\"daily_audit\\\",\\\"description\\\":\\\"Audit to run; the model gate is not reachable here\\\",\\\"enum\\\":[\\\"daily_audit\\\",\\\"deep_audit\\\",\\\"fork_preflight\\\",\\\"validator_policy_change\\\"]},{\\\"name\\\":\\\"payload_sha256\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Observed payload digest\\\"},{\\\"name\\\":\\\"coverage_manifest_sha256\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Observed manifest digest; a deep audit needs it\\\"},{\\\"name\\\":\\\"anchor_commit\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Observed anchor commit; a deep audit needs it\\\"},{\\\"name\\\":\\\"boundary_drift\\\",\\\"type\\\":\\\"bool\\\",\\\"optional\\\":true,\\\"default\\\":false,\\\"description\\\":\\\"In-boundary change the caller detected\\\"},{\\\"name\\\":\\\"finding\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Post-publication finding; quarantines\\\",\\\"enum\\\":[\\\"known_falsehood\\\",\\\"contaminated\\\",\\\"integrity_failed\\\"]},{\\\"name\\\":\\\"at\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"RFC3339 audit instant\\\"}],\\\"examples\\\":[\\\"audit_context_validation(CTX-260728-a1b2c3, trigger=daily_audit)\\\",\\\"audit_context_validation(CTX-260728-a1b2c3, trigger=deep_audit, coverage_manifest_sha256=abc123, anchor_commit=def456)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false},\\\"check_item\\\":{\\\"description\\\":\\\"Check a checklist item\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\",\\\"required\\\":true},{\\\"name\\\":\\\"item\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Checklist item number (1-based)\\\",\\\"required\\\":true}],\\\"examples\\\":[\\\"check_item(TASK-260218-abc123, item=1)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":true},\\\"collect_context_retention\\\":{\\\"description\\\":\\\"Retire what a never-pruning provider left behind and name the payloads\",\n  \"original_output_bytes\": 8986,\n  \"original_output_tokens\": 2247,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
