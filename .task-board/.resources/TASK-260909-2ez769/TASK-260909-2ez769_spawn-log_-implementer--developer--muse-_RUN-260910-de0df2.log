en lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n36|\t\t}\n37|\t\tif err := filesystem.Chmod(path, 0o600); err != nil {\n38|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n39|\t\t}\n40|\t\tinfo, err = filesystem.Lstat(path)\n41|\t\tif err != nil {\n42|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n43|\t\t}\n44|\t}\n45|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n46|\t\treturn nil, err\n47|\t}\n48|\t// O_NOFOLLOW refuses symlink escapes at open time; the descriptor never\n49|\t// follows a link swapped in after Lstat.\n50|\tfd, err := unix.Open(path, unix.O_RDWR|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)\n51|\tif err != nil {\n52|\t\tjoined := errors.Join(ErrTrustStoreUnreadable, err)\n53|\t\tif errors.Is(err, unix.ELOOP) {\n54|\t\t\tjoined = errors.Join(ErrTrustUnsafeCustody, err)\n55|\t\t}\n56|\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: joined})\n57|\t}\n58|\treturn &fileLock{file: os.NewFile(uintptr(fd), path)}, nil\n59|}\n60|\n61|func (lock *fileLock) shared() (func(), error) {\n62|\tif err := unix.Flock(int(lock.file.Fd()), unix.LOCK_SH); err != nil {\n63|\t\treturn nil, err\n64|\t}\n65|\treturn func() { _ = unix.Flock(int(lock.file.Fd()), unix.LOCK_UN) }, nil\n66|}\n67|\n68|func (lock *fileLock) exclusive() (func(), error) {\n69|\tif err := unix.Flock(int(lock.file.Fd()), unix.LOCK_EX); err != nil {\n70|\t\treturn nil, err\n71|\t}\n72|\treturn func() { _ = unix.Flock(int(lock.file.Fd()), unix.LOCK_UN) }, nil\n73|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
