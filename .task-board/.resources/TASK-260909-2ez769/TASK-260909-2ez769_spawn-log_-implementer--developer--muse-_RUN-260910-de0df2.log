entialEntry\",\n457|\t\t\t\t\"hosttrust|field|CredentialID\",\n458|\t\t\t\t\"hosttrust|field|LocalCredentialID\",\n459|\t\t\t\t`hosttrust|lit|,\"credential_id\":`,\n460|\t\t\t\t\"hosttrust|lit|credential_id\",\n461|\t\t\t\t\"hosttrust|local|credentialHex\",\n462|\t\t\t\t\"hosttrust|param|credentialHex\",\n463|\t\t\t\t\"hosttrust|param|credentialID\",\n464|\t\t\t\t\"hosttrust|param|newCredentialID\",\n465|\t\t\t},\n466|\t\t\tdisposition: \"credential-entry digest plumbing: entries bind a host UUID to SHA-256 digests of \" +\n467|\t\t\t\t\"public leaf/SPKI/root bytes plus the bytes themselves for profile verification. Digests name \" +\n468|\t\t\t\t\"public material; the private scalar never enters an entry, and formatting an entry renders \" +\n469|\t\t\t\t\"a static string\",\n470|\t\t\twitnesses: []string{\"hosttrust.TestDecodeTrustRoundTrip\", \"hosttrust.TestTrustRedaction\"},\n471|\t\t},\n472|\t\t{\n473|\t\t\tsites: []string{\n474|\t\t\t\t\"hosttrust|decl|CredentialDir\",\n475|\t\t\t\t\"hosttrust|decl|credentialsDir\",\n476|\t\t\t\t\"hosttrust|decl|privateKeyFile\",\n477|\t\t\t\t\"hosttrust|lit|/credentials/\",\n478|\t\t\t\t\"hosttrust|lit|credentials\",\n479|\t\t\t\t\"hosttrust|lit|resolve credential directory\",\n480|\t\t\t},\n481|\t\t\tdisposition: \"custody path vocabulary: the owner-only credentials directory layout and the \" +\n482|\t\t\t\t\"private-key filename constant. Paths are 0700/0600 verified at open; private-key.pem is \" +\n483|\t\t\t\t\"written once at issuance or rotation and asserted outside replication\",\n484|\t\t\twitnesses: []string{\"hosttrust.TestIssueSelfEnrollsActive\", \"hosttrust.TestNoSecretReplication\"},\n485|\t\t},\n486|\t\t{\n487|\t\t\tsites: []string{\n488|\t\t\t\t\"hosttrust|decl|ErrCredentialCustody\",\n489|\t\t\t\t\"hosttrust|decl|ErrCredentialProfile\",\n490|\t\t\t\t\"hosttrust|lit|host credential custody check failed\",\n491|\t\t\t\t\"hosttrust|lit|host credential profile check failed\",\n492|\t\t\t\t\"hosttrust|lit|host credential revocation refused\",\n493|\t\t\t\t\"hosttrust|lit|host credential rotation refused\",\n494|\t\t\t\t\"hosttrust|lit|host trust credential entry\",\n495|\t\t\t\t\"hosttrust|lit|issue credential\",\n496|\t\t\t\t\"hosttrust|lit|issued host credential\",\n497|\t\t\t\t\"hosttrust|lit|retire credential\",\n498|\t\t\t\t\"hosttrust|lit|revoke credential\",\n499|\t\t\t\t\"hosttrust|lit|verify credential profile\",\n500|\t\t\t},\n501|\t\t\tdisposition: \"static refusal clauses and redacted renderings: operation names and error identities \" +\n502|\t\t\t\t\"that name the credential member, never a value. Renderings of entries, issued material and \" +\n503|\t\t\t\t\"requests emit fixed strings\",\n504|\t\t\twitnesses: []string{\"hosttrust.TestVerifyProfileRefusals\", \"hosttrust.TestTrustRedaction\"},\n505|\t\t},\n506|\t\t{\n507|\t\t\tsites: []string{\n508|\t\t\t\t\"hosttrust|decl|IssueCredential\",\n509|\t\t\t\t\"hosttrust|decl|IssuedCredential\",\n510|\t\t\t},\n511|\t\t\tdisposition: \"local issuance entry points: fresh P-256 keys and profile-exact certificates with \" +\n512|\t\t\t\t\"the root key destroyed after signing. The leaf private key leaves issuance only into the \" +\n513|\t\t\t\t\"owner-only custody file\",\n514|\t\t\twitnesses: []string{\"hosttrust.TestIssueCredentialProfile\", \"hosttrust.TestIssueSelfEnrollsActive\"},\n515|\t\t},\n516|\t}\n517|}\n518|\n519|// TestSecretSiteRosterIsComplete requires every derived secret site to\n520|// carry exactly one row and every row site to resolve to a derived site.\n521|// Removing a secret-bearing declaration, or adding one, reddens here in\n522|// exactly one direction.\n523|func TestSecretSiteRosterIsComplete(t *testing.T) {\n524|\tderived := deriveSecretSites(t)\n525|\trows := secretSiteRows()\n526|\tseen := map[string]bool{}\n527|\tfor _, row := range rows {\n528|\t\tfor _, site := range row.sites {\n529|\t\t\tif !derived[site] {\n530|\t\t\t\tt.Fatalf(\"orphaned census row site %q: production derives no 