schema:host-trust-store\",\"schema_version\":\"1.0.0\",\"generation\":1,\"entries\":null}`\n24|\tmissingEntriesDocument := `{\"schema\":\"urn:ax:schema:host-trust-store\",\"schema_version\":\"1.0.0\",\"generation\":1}`\n25|\tnoRetireDocument := strings.Replace(validDocument, `\"retire_at\":null`, `\"retire_at\":\"2026-09-10T13:00:00.000Z\"`, 1)\n26|\n27|\t// A retiring entry whose retire_at equals enrolled_at violates the\n28|\t// strict later-than rule. EncodeTrust cannot produce it (its round trip\n29|\t// refuses), so the fixture rewrites a valid retiring document.\n30|\tretire := testNow.Add(time.Hour)\n31|\tretiring := TrustStore{Generation: 1, Entries: []CredentialEntry{entryForTest(t, issued, EntryRetiring, testNow, &retire)}}\n32|\tequalWindowDocument := strings.Replace(string(encodeForTest(t, retiring)),\n33|\t\t`\"retire_at\":\"`+testTimestamp(retire).String()+`\"`, `\"retire_at\":\"`+testTimestamp(testNow).String()+`\"`, 1)\n34|\n35|\t// Two identical entries share one credential_id.\n36|\tentryJSON := validDocument[strings.Index(validDocument, `\"entries\":[`)+len(`\"entries\":[`):]\n37|\tentryJSON = entryJSON[:len(entryJSON)-2]\n38|\tduplicateEntryDocument := strings.Replace(validDocument, `\"entries\":[`+entryJSON+`]`, `\"entries\":[`+entryJSON+`,`+entryJSON+`]`, 1)\n39|\n40|\t// Swapping two sorted entries yields an unsorted store.\n41|\tother := issueForTest(t, testHostB, testNow)\n42|\tpair := TrustStore{Generation: 1, Entries: []CredentialEntry{\n43|\t\tentryForTest(t, issued, EntryActive, testNow, nil),\n44|\t\tentryForTest(t, other, EntryActive, testNow, nil),\n45|\t}}\n46|\tpairDocument := string(encodeForTest(t, pair))\n47|\tseparator := `},{\"host_id\"`\n48|\tmiddle := strings.Index(pairDocument, separator)\n49|\tif middle < 0 {\n50|\t\tt.Fatal(\"pair fixture has no second entry\")\n51|\t}\n52|\thead := pairDocument[:middle]\n53|\ttail := pairDocument[middle+len(separator):]\n54|\tprefix := `\"entries\":[`\n55|\tat := strings.Index(head, prefix) + len(prefix)\n56|\tfirst, second := head[at:], tail[:len(tail)-2]\n57|\tunsortedDocument := head[:at] + second + `},{\"host_id` + first + `]}`\n58|\tif unsortedDocument == pairDocument {\n59|\t\tt.Fatal(\"swap fixture did not reorder entries\")\n60|\t}\n61|\n62|\ttests := []struct {\n63|\t\tname     string\n64|\t\tdocument string\n65|\t}{\n66|\t\t{\"empty\", \"\"},\n67|\t\t{\"not json\", \"not json\"},\n68|\t\t{\"array\", \"[]\"},\n69|\t\t{\"trailing garbage\", validDocument + \" {}\"},\n70|\t\t{\"duplicate root key\", duplicateKeyDocument},\n71|\t\t{\"duplicate nested key\", nestedDuplicateDocument},\n72|\t\t{\"unknown root field\", strings.Replace(validDocument, `\"generation\":1`, `\"generation\":1,\"comment\":\"hi\"`, 1)},\n73|\t\t{\"missing schema\", strings.Replace(validDocument, `\"schema\":\"urn:ax:schema:host-trust-store\",`, ``, 1)},\n74|\t\t{\"wrong schema\", strings.Replace(validDocument, `urn:ax:schema:host-trust-store`, `urn:ax:schema:config`, 1)},\n75|\t\t{\"downgraded version\", strings.Replace(validDocument, `\"schema_version\":\"1.0.0\"`, `\"schema_version\":\"0.9.0\"`, 1)},\n76|\t\t{\"missing version\", strings.Replace(validDocument, `\"schema_version\":\"1.0.0\",`, ``, 1)},\n77|\t\t{\"generation zero\", strings.Replace(validDocument, `\"generation\":1`, `\"generation\":0`, 1)},\n78|\t\t{\"generation uint53 ceiling\", strings.Replace(validDocument, `\"generation\":1`, `\"generation\":9007199254740992`, 1)},\n79|\t\t{\"generation fraction\", strings.Replace(validDocument, `\"generation\":1`, `\"generation\":1.5`, 1)},\n80|\t\t{\"generation string value\", strings.Replace(validDocument, `\"generation\":1`, `\"generation\":\"1\"`, 1)},\n81|\t\t{\"generation negative\", strings.Replace(validDocument, `\"generation\":1`, `\"generation\":-1`, 1)},\n82|\t\t{\"entries null\", nullEntriesDocument},\n83|\t\t{\"missing entries\", missingEntriesDocument},\n84|\t\t{\"unknown entry field\", strings.Replace(validDocument, `\"state\":\"active\"`, `\"state\":\