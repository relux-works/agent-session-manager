ireAt != nil {\n38|\t\tstamp := testTimestamp(*retireAt)\n39|\t\tretireStamp = &stamp\n40|\t}\n41|\treturn CredentialEntry{\n42|\t\tHostID:       issued.HostID,\n43|\t\tCredentialID: scalar.SHA256Digest(issued.LeafDER),\n44|\t\tSPKIID:       scalar.SHA256Digest(mustSPKI(issued.LeafDER)),\n45|\t\tRootID:       scalar.SHA256Digest(issued.RootDER),\n46|\t\tLeafDER:      append([]byte(nil), issued.LeafDER...),\n47|\t\tRootDER:      append([]byte(nil), issued.RootDER...),\n48|\t\tState:        state,\n49|\t\tEnrolledAt:   testTimestamp(enrolledAt),\n50|\t\tRetireAt:     retireStamp,\n51|\t}\n52|}\n53|\n54|func encodeForTest(t *testing.T, store TrustStore) []byte {\n55|\tt.Helper()\n56|\tdocument, err := EncodeTrust(store)\n57|\tif err != nil {\n58|\t\tt.Fatalf(\"EncodeTrust error = %v\", err)\n59|\t}\n60|\treturn document\n61|}\n62|\n63|func TestDecodeTrustRoundTrip(t *testing.T) {\n64|\tissuedA := issueForTest(t, testHostA, testNow)\n65|\tissuedB := issueForTest(t, testHostB, testNow)\n66|\tretire := testNow.Add(time.Hour)\n67|\tstore := TrustStore{Generation: 3, Entries: []CredentialEntry{\n68|\t\tentryForTest(t, issuedB, EntryActive, testNow, nil),\n69|\t\tentryForTest(t, issuedA, EntryRetiring, testNow.Add(-time.Hour), &retire),\n70|\t}}\n71|\tdocument := encodeForTest(t, store)\n72|\tdecoded, err := DecodeTrust(document)\n73|\tif err != nil {\n74|\t\tt.Fatalf(\"DecodeTrust error = %v\", err)\n75|\t}\n76|\tif decoded.Generation != 3 || len(decoded.Entries) != 2 {\n77|\t\tt.Fatalf(\"DecodeTrust = gen %d entries %d, want 3/2\", decoded.Generation, len(decoded.Entries))\n78|\t}\n79|\tif decoded.Entries[0].CredentialID.String() > decoded.Entries[1].CredentialID.String() {\n80|\t\tt.Fatal(\"DecodeTrust entries are not sorted by credential_id\")\n81|\t}\n82|\tagain, err := EncodeTrust(decoded)\n83|\tif err != nil {\n84|\t\tt.Fatalf(\"EncodeTrust(decoded) error = %v\", err)\n85|\t}\n86|\tredocoded, err := DecodeTrust(again)\n87|\tif err != nil {\n88|\t\tt.Fatalf(\"DecodeTrust(re-encoded) error = %v\", err)\n89|\t}\n90|\tif redocoded.Generation != decoded.Generation || len(redocoded.Entries) != len(decoded.Entries) {\n91|\t\tt.Fatal(\"trust document is not stable across encode/decode\")\n92|\t}\n93|}","final_result":true}}}
