{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c84f","stream":{"kind":"session","id":"01a08900-d199-7822-974c-1de7f95bc0fc"},"sequence":642,"recorded_at":1780531400001279,"record_type":"event","durability":"durable","causation_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","run_stream":{"kind":"run","id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef"},"task_stream":{"kind":"task","id":"01a08902-c5ea-7c03-b831-baca01025ba6"},"task_id":"01a08902-c5ea-7c03-b831-baca01025ba6","event":{"kind":"output","task_id":"01a08902-c5ea-7c03-b831-baca01025ba6","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1kiyj6/worktree/internal/hosttrust/profile_verify.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"crypto/ecdsa\"\n5|\t\"crypto/sha1\"\n6|\t\"crypto/x509\"\n7|\t\"encoding/asn1\"\n8|\t\"errors\"\n9|\t\"io\"\n10|\t\"math/big\"\n11|\t\"time\"\n12|)\n13|\n14|func randomSerial(randomness io.Reader) (*big.Int, error) {\n15|\tserial := make([]byte, 16)\n16|\tif _, err := io.ReadFull(randomness, serial); err != nil {\n17|\t\treturn nil, err\n18|\t}\n19|\tvalue := new(big.Int).SetBytes(serial)\n20|\tif value.Sign() == 0 {\n21|\t\tvalue.SetInt64(1)\n22|\t}\n23|\treturn value, nil\n24|}\n25|\n26|func subjectKeyID(key *ecdsa.PublicKey) ([]byte, error) {\n27|\tder, err := x509.MarshalPKIXPublicKey(key)\n28|\tif err != nil {\n29|\t\treturn nil, err\n30|\t}\n31|\tvar info struct {\n32|\t\tAlgorithm        asn1.RawValue\n33|\t\tSubjectPublicKey asn1.BitString\n34|\t}\n35|\tif _, err := asn1.Unmarshal(der, &info); err != nil {\n36|\t\treturn nil, err\n37|\t}\n38|\tsum := sha1.Sum(info.SubjectPublicKey.Bytes)\n39|\treturn sum[:], nil\n40|}\n41|\n42|// zeroECDSAKey best-effort destroys private scalar material after issuance.\n43|// The root key is additionally never serialized, stored or returned.\n44|func zeroECDSAKey(key *ecdsa.PrivateKey) {\n45|\tif key == nil || key.D == nil {\n46|\t\treturn\n47|\t}\n48|\tbits := key.D.Bits()\n49|\tfor index := range bits {\n50|\t\tbits[index] = 0\n51|\t}\n52|\tkey.D = new(big.Int)\n53|}\n54|\n55|// VerifyProfile checks the exact Host Credential Profile 1 fields for a leaf\n56|// and root pair at enrollment and handshake time: signatures, exact subject\n57|// and issuer names, critical basic constraints and key usages, exact EKU set,\n58|// the single DNS SAN, validity windows against the actual local UTC time\n59|// (inclusive, no skew or grace), P-256 points, SKI/AKI construction, and the\n60|// absence of intermediates, AIA/CRL/OCSP dependencies and extra attributes.\n61|func VerifyProfile(leafDER, rootDER []byte, hostID string, now time.Time) error {\n62|\tconst operation = \"verify credential profile\"\n63|\tleaf, err := x509.ParseCertificate(leafDER)\n64|\tif err != nil {\n65|\t\treturn trustError(TrustError{Operation: operation, Err: errors.Join(ErrCredentialProfile, err)})\n66|\t}\n67|\troot, err := x509.ParseCertificate(rootDER)\n68|\tif err != nil {\n69|\t\treturn trustError(TrustError{Operation: operation, Err: errors.Join(ErrCredentialProfile, err)})\n70|\t}\n71|\tif err := checkP256Point(leaf); err != nil {\n72|\t\treturn trustError(TrustError{Operation: operation, Err: err})\n73|\t}\n74|\tif err := checkP256Point(root); err != nil {\n75|\t\treturn trustError(TrustError{Operation: operation, Err: err})\n76|\t}\n77|\tif leaf.Version != 3 || root.Version != 3 {\n78|\t\treturn trustError(TrustError{Operation: operation, Err: ErrCredentialProfile})\n79|\t}\n80|\tif leaf.SignatureAlgorithm != x509.ECDSAWithSHA256 || root.SignatureAlgorithm != x509.ECDSAWithSHA256 {\n81|\t\treturn trustError(TrustError{Operation: operation, Err: ErrCredentialProfile})\n82|\t}\n83|\tif leaf.PublicKeyAlgorithm != x509.ECDSA || root.PublicKeyAlgorithm != x509.ECDSA {\n84|\t\treturn trustError(TrustError{Operation: operation, Err: ErrCredentialProfile})\n85|\t}\n86|\tif err := root.CheckSignatureFrom(root); err != nil {\n87|\t\treturn trustError(TrustError{Operation: operation, Err: errors.Join(ErrCredentialProfile, err)})\n88|\t}\n89|\tif err := leaf.CheckSignatureFrom(root); err != nil {\n90|\t\treturn trustError(TrustError{Operation: operation, Err: errors.Join(ErrCredentialProfile, err)})\n91|\t}\n92|\tif !subjectIsOnlyCN(leaf.Subject, leafCommonName(hostID)) {\n93|\t\treturn trustError(TrustError{Operation: operation, Err: ErrCredentialProfile})\n94|\t}\n95|\tif !subjectIsOnlyCN(root.Subject, rootCommonName(hostID)) {\n96|\t\treturn trustError(TrustError{Operation: operation, Err: ErrCredentialProfile})\n97|\t}\n98|\tif !subjectIsOnlyCN(leaf.Issuer, root.Subject.CommonName) {\n99|\t\treturn trustError(TrustError{Operation: operation, Err: ErrCredentialProfile})\n100|\t}\n101|\tif !root.BasicConstraintsValid || !root.IsCA || !root.MaxPathLenZero || root.MaxPathLen != 0 {\n102|\t\treturn trustError(TrustError{Operation: operation, Err: ErrCredentialProfile})\n103|\t}\n104|\tif !leaf.BasicConstraintsValid || leaf.IsCA {\n105|\t\treturn trustError(TrustError{Operation: operation, Err: ErrCredentialProfile})\n106|\t}\n107|\tif root.KeyUsage != x509.KeyUsageCertSign {\n108|\t\treturn trustError(TrustError{Operation: operation, Err: ErrCredentialProfile})\n109|\t}\n110|\tif leaf.KeyUsage != x509.KeyUsageDigitalSignature {\n111|\t\treturn trustError(TrustError{Operation: operation, Err: ErrCredentialProfile})\n112|\t}\n113|\tif len(root.ExtKeyUsage) != 0 || len(root.UnknownExtKeyUsage) != 0 {\n114|\t\treturn trustError(TrustError{Operation: operation, Err: ErrCredentialProfile})\n115|\t}\n116|\tif !hasExactlyClientServerEKU(leaf) {\n117|\t\treturn trustError(TrustError{Operation: operation, Err: ErrCredentialProfile})\n118|\t}\n119|\tif len(leaf.DNSNames) != 1 || leaf.DNSNames[0] != hostDNSName(hostID) {\n120|\t\treturn trustError(TrustError{Operation: operation, Err: ErrCredentialProfile})\n121|\t}\n122|\tif err := checkNoExtraNames(leaf); err != nil {\n123|\t\treturn trustError(TrustError{Operation: operation, Err: err})\n124|\t}\n125|\tif err := checkNoExtraNames(root); err != nil {\n126|\t\treturn trustError(TrustError{Operation: operation, Err: err})\n127|\t}\n128|\tif err := checkKeyIdentifiers(leaf, root); err != nil {\n129|\t\treturn trustError(TrustError{Operation: operation, Err: err})\n130|\t}\n131|\tif err := checkSerials(leaf, root); err != nil {\n132|\t\treturn trustError(TrustError{Operation: operation, Err: err})\n133|\t}\n134|\tinstant := now.UTC()\n135|\tfor _, certificate := range []*x509.Certificate{leaf, root} {\n136|\t\tif instant.Before(certificate.NotBefore) || instant.After(certificate.NotAfter) {\n137|\t\t\treturn trustError(TrustError{Operation: operation, Err: ErrCredentialProfile})\n138|\t\t}\n139|\t}\n140|\tif len(leaf.UnhandledCriticalExtensions) != 0 || len(root.UnhandledCriticalExtensions) != 0 {\n141|\t\treturn trustError(TrustError{Operation: operation, Err: ErrCredentialProfile})\n142|\t}\n143|\treturn nil\n144|}","final_result":true}}}
