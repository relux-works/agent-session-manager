{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c913","stream":{"kind":"session","id":"01a08900-d199-7822-974c-1de7f95bc0fc"},"sequence":740,"recorded_at":1780531400001475,"record_type":"event","durability":"durable","causation_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","run_stream":{"kind":"run","id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef"},"call_id":"call_01a08903148177228780d8a78bb5796b","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1kiyj6/worktree/internal/hosttrust/rotate.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"crypto/x509\"\n5|\t\"encoding/pem\"\n6|\t\"errors\"\n7|\t\"path/filepath\"\n8|\t\"time\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|)\n12|\n13|// RotationBound is the maximum overlap of an old credential after the trust\n14|// transition admits its replacement: 24 hours, and never past old leaf\n15|// expiry. There is no overlap extension.\n16|const RotationBound = 24 * time.Hour\n17|\n18|// Rotate keeps the host UUID and creates a new credential with two fresh keys\n19|// and certificates. The local atomic trust transition admits the new entry as\n20|// active and marks the old entry retiring with a fixed retire_at no more than\n21|// 24 hours after the transition and no later than old leaf expiry. No second\n22|// rotation starts until the retiring entry is revoked. Failed enrollment\n23|// leaves the new route unavailable, never auto-trusted.\n24|func (store *Store) Rotate(hostID string, now time.Time) (newCredentialID string, retireAt time.Time, err error) {\n25|\tparsed, err := scalar.ParseUUIDv7(hostID)\n26|\tif err != nil {\n27|\t\treturn \"\", time.Time{}, trustError(TrustError{Operation: \"rotate host\", Err: errors.Join(ErrRotationRefused, err)})\n28|\t}\n29|\tissued, err := IssueCredential(parsed.String(), now, nil)\n30|\tif err != nil {\n31|\t\treturn \"\", time.Time{}, err\n32|\t}\n33|\tcredentialHex := scalar.SHA256Digest(issued.LeafDER).Hex()\n34|\tdirectory := filepath.Join(store.root, credentialsDir, credentialHex)\n35|\tif err := ensureOwnerDir(store.fs, directory, 0o700); err != nil {\n36|\t\treturn \"\", time.Time{}, err\n37|\t}\n38|\tcommitted := false\n39|\tdefer func() {\n40|\t\tif !committed {\n41|\t\t\t_ = store.fs.Remove(filepath.Join(directory, certificateFile))\n42|\t\t\t_ = store.fs.Remove(filepath.Join(directory, privateKeyFile))\n43|\t\t\t_ = store.fs.Remove(filepath.Join(directory, rootFile))\n44|\t\t\t_ = store.fs.Remove(directory)\n45|\t\t}\n46|\t}()\n47|\tif err := writeCustodyFile(store, directory, certificateFile, pem.EncodeToMemory(&pem.Block{Type: \"CERTIFICATE\", Bytes: issued.LeafDER})); err != nil {\n48|\t\treturn \"\", time.Time{}, err\n49|\t}\n50|\tif err := writeCustodyFile(store, directory, privateKeyFile, pem.EncodeToMemory(&pem.Block{Type: \"PRIVATE KEY\", Bytes: issued.LeafKeyDER})); err != nil {\n51|\t\treturn \"\", time.Time{}, err\n52|\t}\n53|\tif err := writeCustodyFile(store, directory, rootFile, pem.EncodeToMemory(&pem.Block{Type: \"CERTIFICATE\", Bytes: issued.RootDER})); err != nil {\n54|\t\treturn \"\", time.Time{}, err\n55|\t}\n56|\tenrolledAt, err := scalar.ParseTimestamp(now.UTC().Format(\"2006-01-02T15:04:05.000Z\"))\n57|\tif err != nil {\n58|\t\treturn \"\", time.Time{}, trustError(TrustError{Operation: \"rotate timestamp\", Err: errors.Join(ErrRotationRefused, err)})\n59|\t}\n60|\tnewEntry := CredentialEntry{\n61|\t\tHostID:       issued.HostID,\n62|\t\tCredentialID: scalar.SHA256Digest(issued.LeafDER),\n63|\t\tSPKIID:       scalar.SHA256Digest(mustSPKI(issued.LeafDER)),\n64|\t\tRootID:       scalar.SHA256Digest(issued.RootDER),\n65|\t\tLeafDER:      issued.LeafDER,\n66|\t\tRootDER:      issued.RootDER,\n67|\t\tState:        EntryActive,\n68|\t\tEnrolledAt:   enrolledAt,\n69|\t}\n70|\tvar fixedRetireAt time.Time\n71|\tif err := store.transact(func(trust *TrustStore) error {\n72|\t\told, err := rotationPredecessor(trust, parsed.String())\n73|\t\tif err != nil {\n74|\t\t\treturn err\n75|\t\t}\n76|\t\toldLeaf, err := x509.ParseCertificate(old.LeafDER)\n77|\t\tif err != nil {\n78|\t\t\treturn trustError(TrustError{Operation: \"rotate predecessor\", Err: errors.Join(ErrRotationRefused, err)})\n79|\t\t}\n80|\t\tdeadline := now.Add(RotationBound)\n81|\t\tif oldLeaf.NotAfter.Before(deadline) {\n82|\t\t\tdeadline = oldLeaf.NotAfter\n83|\t\t}\n84|\t\tif !deadline.After(now) {\n85|\t\t\treturn trustError(TrustError{Operation: \"rotate window\", Err: ErrRotationRefused})\n86|\t\t}\n87|\t\tstamp, err := scalar.ParseTimestamp(deadline.UTC().Format(\"2006-01-02T15:04:05.000Z\"))\n88|\t\tif err != nil {\n89|\t\t\treturn trustError(TrustError{Operation: \"rotate window\", Err: errors.Join(ErrRotationRefused, err)})\n90|\t\t}\n91|\t\tfixedRetireAt, err = stamp.Time()\n92|\t\tif err != nil {\n93|\t\t\treturn trustError(TrustError{Operation: \"rotate window\", Err: errors.Join(ErrRotationRefused, err)})\n94|\t\t}\n95|\t\tfor index := range trust.Entries {\n96|\t\t\tif trust.Entries[index].CredentialID.String() == old.CredentialID.String() {\n97|\t\t\t\ttrust.Entries[index].State = EntryRetiring\n98|\t\t\t\tretiring := stamp\n99|\t\t\t\ttrust.Entries[index].RetireAt = &retiring\n100|\t\t\t}\n101|\t\t}\n102|\t\treturn admitEntry(trust, newEntry)\n103|\t}); err != nil {\n104|\t\treturn \"\", time.Time{}, err\n105|\t}\n106|\tcommitted = true\n107|\treturn newEntry.CredentialID.String(), fixedRetireAt, nil\n108|}\n109|\n110|// rotationPredecessor selects the single active credential of a host. A\n111|// retiring entry blocks a second rotation; zero or multiple active entries\n112|// refuse.\n113|func rotationPredecessor(trust *TrustStore, hostID string) (CredentialEntry, error) {\n114|\tvar active []CredentialEntry\n115|\tfor _, entry := range trust.Entries {\n116|\t\tif entry.HostID.String() != hostID {\n117|\t\t\tcontinue\n118|\t\t}\n119|\t\tswitch entry.State {\n120|\t\tcase EntryRetiring:\n121|\t\t\treturn CredentialEntry{}, trustError(TrustError{Operation: \"rotate predecessor\", Err: ErrRotationRefused})\n122|\t\tcase EntryActive:\n123|\t\t\tactive = append(active, entry)\n124|\t\t}\n125|\t}\n126|\tif len(active) != 1 {\n127|\t\treturn CredentialEntry{}, trustError(TrustError{Operation: \"rotate predecessor\", Err: ErrRotationRefused})\n128|\t}\n129|\treturn active[0], nil\n130|}\n131|\n132|// MarkRetiring records a peer's announced rotation locally: the operator\n133|// caught up out of band, enrolled the peer's new tuple, and now bounds the\n134|// old credential with a fixed retire_at. The bound is no more than 24 hours\n135|// after this transition and later than enrollment; there is no overlap\n136|// extension, and only an active entry may retire.\n137|func (store *Store) MarkRetiring(credentialID string, retireAt, now time.Time) error {\n138|\tdigest, err := scalar.ParseDigest(credentialID)\n139|\tif err != nil {\n140|\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: errors.Join(ErrRotationRefused, err)})\n141|\t}\n142|\tstamp, err := scalar.ParseTimestamp(retireAt.UTC().Format(\"2006-01-02T15:04:05.000Z\"))\n143|\tif err != nil {\n144|\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: errors.Join(ErrRotationRefused, err)})\n145|\t}\n146|\treturn store.transact(func(trust *TrustStore) error {\n147|\t\tfor index := range trust.Entries {\n148|\t\t\tif trust.Entries[index].CredentialID.String() != digest.String() {\n149|\t\t\t\tcontinue\n150|\t\t\t}\n151|\t\t\tentry := &trust.Entries[index]\n152|\t\t\tif entry.State != EntryActive {\n153|\t\t\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: ErrRotationRefused})\n154|\t\t\t}\n155|\t\t\tenrolledAt, err := entry.EnrolledAt.Time()\n156|\t\t\tif err != nil {\n157|\t\t\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: errors.Join(ErrRotationRefused, err)})\n158|\t\t\t}\n159|\t\t\tfixed, err := stamp.Time()\n160|\t\t\tif err != nil {\n161|\t\t\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: errors.Join(ErrRotationRefused, err)})\n162|\t\t\t}\n163|\t\t\tif !fixed.After(now) || !fixed.After(enrolledAt) || fixed.After(now.Add(RotationBound)) {\n164|\t\t\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: ErrRotationRefused})\n165|\t\t\t}\n166|\t\t\tentry.State = EntryRetiring\n167|\t\t\tentry.RetireAt = &stamp\n168|\t\t\treturn nil\n169|\t\t}\n170|\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: ErrRotationRefused})\n171|\t})\n172|}\n173|\n174|// Revoke is an explicit local atomic transition to revoked. It increments\n175|// the generation, forbids all future admissions of that key, and retains the\n176|// public bytes permanently as a reuse tombstone. Revoking an already revoked\n177|// entry refuses: a failed commit reports failure, never absence or success.\n178|// Revocation is local: the operator must distribute it explicitly to every\n179|// peer, and loss or compromise requires revocation plus new out-of-band\n180|// enrollment, never same-key recovery.\n181|func (store *Store) Revoke(credentialID string) error {\n182|\tdigest, err := scalar.ParseDigest(credentialID)\n183|\tif err != nil {\n184|\t\treturn trustError(TrustError{Operation: \"revoke credential\", Err: errors.Join(ErrRevocationRefused, err)})\n185|\t}\n186|\treturn store.transact(func(trust *TrustStore) error {\n187|\t\tfor index := range trust.Entries {\n188|\t\t\tif trust.Entries[index].CredentialID.String() != digest.String() {\n189|\t\t\t\tcontinue\n190|\t\t\t}\n191|\t\t\tif trust.Entries[index].State == EntryRevoked {\n192|\t\t\t\treturn trustError(TrustError{Operation: \"revoke credential\", Err: ErrRevocationRefused})\n193|\t\t\t}\n194|\t\t\ttrust.Entries[index].State = EntryRevoked\n195|\t\t\ttrust.Entries[index].RetireAt = nil\n196|\t\t\treturn nil\n197|\t\t}\n198|\t\treturn trustError(TrustError{Operation: \"revoke credential\", Err: ErrRevocationRefused})\n199|\t})\n200|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c915","stream":{"kind":"session","id":"01a08900-d199-7822-974c-1de7f95bc0fc"},"sequence":741,"recorded_at":1780531400001477,"record_type":"event","durability":"durable","causation_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef","run_stream":{"kind":"run","id":"0a8bdc02-b2cf-4bed-86b9-db3127962aef"},"call_id":"call_01a0890315da73b2a72eda9fb56c8c6c","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1kiyj6/worktree/internal/hosttrust/transact.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|)\n8|\n9|// Snapshot is one coherent committed read: trust bytes plus the generation\n10|// that authorized them. Streams and dispatches bind this generation; any use\n11|// must re-check currency before crossing a side-effect boundary.\n12|type Snapshot struct {\n13|\tGeneration uint64\n14|\tTrust      TrustStore\n15|}\n16|\n17|// TransactionFunc mutates a copy of the committed trust. Returning nil\n18|// commits with generation+1; returning an error aborts with no durable effect.\n19|type TransactionFunc func(trust *TrustStore) error\n20|\n21|// ReadSnapshot obtains one coherent committed snapshot under a shared lock.\n22|// A missing store is ErrTrustStoreMissing, never an empty store. Unreadable,\n23|// malformed or partially read state refuses; leftover staging files from\n24|// crashed commits are ignored and never selected.\n25|func (store *Store) ReadSnapshot() (Snapshot, error) {\n26|\treturn readSnapshot(store.fs, store.root, store.lock)\n27|}\n28|\n29|func readSnapshot(filesystem FileSystem, root string, lock *fileLock) (Snapshot, error) {\n30|\tunlock, err := lock.shared()\n31|\tif err != nil {\n32|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"lock snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n33|\t}\n34|\tdefer unlock()\n35|\tpath := filepath.Join(root, trustFileName)\n36|\tinfo, err := filesystem.Lstat(path)\n37|\tif err != nil {\n38|\t\tif os.IsNotExist(err) {\n39|\t\t\treturn Snapshot{}, trustError(TrustError{Operation: \"read snapshot\", Err: ErrTrustStoreMissing})\n40|\t\t}\n41|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"read snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n42|\t}\n43|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n44|\t\treturn Snapshot{}, err\n45|\t}\n46|\tdocument, err := filesystem.ReadFile(path)\n47|\tif err != nil {\n48|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"read snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n49|\t}\n50|\tstore, err := DecodeTrust(document)\n51|\tif err != nil {\n52|\t\treturn Snapshot{}, err\n53|\t}\n54|\treturn Snapshot{Generation: store.Generation, Trust: store}, nil\n55|}\n56|\n57|// Initialize creates the explicit empty generation-1 store. It refuses when\n58|// trust.json already exists: setup never overwrites committed authority.\n59|func (store *Store) Initialize() (Snapshot, error) {\n60|\tunlock, err := store.lock.exclusive()\n61|\tif err != nil {\n62|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"lock initialize\", Err: errors.Join(ErrTrustDurability, err)})\n63|\t}\n64|\tdefer unlock()\n65|\tpath := filepath.Join(store.root, trustFileName)\n66|\tif _, err := store.fs.Lstat(path); err == nil {\n67|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"initialize store\", Err: ErrTrustDurability})\n68|\t} else if !os.IsNotExist(err) {\n69|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"initialize store\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n70|\t}\n71|\tdocument, err := EncodeTrust(TrustStore{Generation: 1})\n72|\tif err != nil {\n73|\t\treturn Snapshot{}, err\n74|\t}\n75|\tif err := commitDocument(store.fs, store.root, path, document); err != nil {\n76|\t\treturn Snapshot{}, err\n77|\t}\n78|\treturn store.ReadSnapshot()\n79|}\n80|\n81|// CommitConfigChange shares the machine-local cross-process authorization\n82|// lock and crash-durable generation transaction with Configuration 4.0.0\n83|// peer/credential changes. It holds the exclusive lock while fn performs the\n84|// durable config replacement, then commits a generation bump for the config\n85|// authorization change. A fn failure aborts with no generation change; the\n86|// caller owns config-side recovery when the later trust commit fails.\n87|func (store *Store) CommitConfigChange(fn func() error) (uint64, error) {\n88|\tvar generation uint64\n89|\terr := store.transact(func(trust *TrustStore) error {\n90|\t\tif err := fn(); err != nil {\n91|\t\t\treturn err\n92|\t\t}\n93|\t\tgeneration = trust.Generation + 1\n94|\t\treturn nil\n95|\t})\n96|\tif err != nil {\n97|\t\treturn 0, err\n98|\t}\n99|\treturn generation, nil\n100|}\n101|\n102|// transact runs one crash-durable generation transaction under the exclusive\n103|// cross-process lock: load committed state, apply fn, encode, stage with\n104|// fsync, atomic rename, directory fsync. A missing store reads as the empty\n105|// pre-generation state so Initialize can commit generation 1; any other\n106|// malformed state refuses before fn runs.\n107|func (store *Store) transact(fn TransactionFunc) error {\n108|\treturn transact(store.fs, store.root, store.lock, fn)\n109|}\n110|\n111|func transact(filesystem FileSystem, root string, lock *fileLock, fn TransactionFunc) error {\n112|\tunlock, err := lock.exclusive()\n113|\tif err != nil {\n114|\t\treturn trustError(TrustError{Operation: \"lock transaction\", Err: errors.Join(ErrTrustDurability, err)})\n115|\t}\n116|\tdefer unlock()\n117|\tpath := filepath.Join(root, trustFileName)\n118|\tvar committed TrustStore\n119|\tinfo, err := filesystem.Lstat(path)\n120|\tif err != nil {\n121|\t\tif os.IsNotExist(err) {\n122|\t\t\treturn trustError(TrustError{Operation: \"read committed trust\", Err: ErrTrustStoreMissing})\n123|\t\t}\n124|\t\treturn trustError(TrustError{Operation: \"read committed trust\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n125|\t}\n126|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n127|\t\treturn err\n128|\t}\n129|\tdocument, err := filesystem.ReadFile(path)\n130|\tif err != nil {\n131|\t\treturn trustError(TrustError{Operation: \"read committed trust\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n132|\t}\n133|\tvar decoded TrustStore\n134|\tdecoded, err = DecodeTrust(document)\n135|\tif err != nil {\n136|\t\treturn err\n137|\t}\n138|\tcommitted = decoded\n139|\tnext := committed\n140|\tnext.Entries = append([]CredentialEntry(nil), committed.Entries...)\n141|\tif err := fn(&next); err != nil {\n142|\t\treturn err\n143|\t}\n144|\tif next.Generation != committed.Generation {\n145|\t\treturn trustError(TrustError{Operation: \"commit generation\", Err: ErrTrustDurability})\n146|\t}\n147|\tif committed.Generation >= MaxGeneration {\n148|\t\treturn trustError(TrustError{Operation: \"commit generation\", Err: ErrGenerationExhausted})\n149|\t}\n150|\tnext.Generation = committed.Generation + 1\n151|\tencoded, err := EncodeTrust(next)\n152|\tif err != nil {\n153|\t\treturn err\n154|\t}\n155|\tdocument = encoded\n156|\tif err := commitDocument(filesystem, root, path, document); err != nil {\n157|\t\treturn err\n158|\t}\n159|\treturn nil\n160|}\n161|\n162|// commitDocument stages bytes in a temp file with fsync, atomically renames\n163|// over the target, and fsyncs the directory. On restart only the last fully\n164|// committed file is selected; staged files are ignored by every reader.\n165|func commitDocument(filesystem FileSystem, root, path string, document []byte) error {\n166|\tstaged, err := filesystem.CreateTemp(root, stagePrefix+\"*\", 0o600)\n167|\tif err != nil {\n168|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n169|\t}\n170|\tname := staged.Name()\n171|\tfailed := true\n172|\tdefer func() {\n173|\t\tif failed {\n174|\t\t\t_ = filesystem.Remove(name)\n175|\t\t}\n176|\t}()\n177|\tif err := writeAll(staged, document); err != nil {\n178|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n179|\t}\n180|\tif err := staged.Sync(); err != nil {\n181|\t\t_ = staged.Close()\n182|\t\treturn trustError(TrustError{Operation: \"sync trust\", Err: errors.Join(ErrTrustDurability, err)})\n183|\t}\n184|\tif err := staged.Close(); err != nil {\n185|\t\treturn trustError(TrustError{Operation: \"sync trust\", Err: errors.Join(ErrTrustDurability, err)})\n186|\t}\n187|\tif err := filesystem.Chmod(name, 0o600); err != nil {\n188|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n189|\t}\n190|\tif err := filesystem.Rename(name, path); err != nil {\n191|\t\treturn trustError(TrustError{Operation: \"replace trust\", Err: errors.Join(ErrTrustDurability, err)})\n192|\t}\n193|\tif err := syncDir(filesystem, root); err != nil {\n194|\t\treturn trustError(TrustError{Operation: \"sync trust directory\", Err: errors.Join(ErrTrustDurability, err)})\n195|\t}\n196|\tfailed = false\n197|\treturn nil\n198|}\n199|\n200|func writeAll(writer interface{ Write([]byte) (int, error) }, document []byte) error {\n201|\tfor len(document) > 0 {\n202|\t\twritten, err := writer.Write(document)\n203|\t\tif err != nil {\n204|\t\t\treturn err\n205|\t\t}\n206|\t\tif written == 0 {\n207|\t\t\treturn errors.New(\"short trust write\")\n208|\t\t}\n209|\t\tdocument = document[written:]\n210|\t}\n211|\treturn nil\n212|}\n213|\n214|func syncDir(filesystem FileSystem, root string) error {\n215|\thandle, err := filesystem.OpenDirectory(root)\n216|\tif err != nil {\n217|\t\treturn err\n218|\t}\n219|\tif err := handle.Sync(); err != nil {\n220|\t\t_ = handle.Close()\n221|\t\treturn err\n222|\t}\n223|\treturn handle.Close()\n224|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
