n: translating one down to\n56|\t\t\t\t// 3.0.0 would silently drop the mandatory mesh.transport\n57|\t\t\t\t// and mesh.host_channel members, so Load must refuse with\n58|\t\t\t\t// the unsupported-version refusal instead of translating.\n59|\t\t\t\tif _, err := loadConfigDocument(document, scalar.PlatformMacOS, nil); !errors.Is(err, ErrUnsupportedConfigVersion) {\n60|\t\t\t\t\tt.Fatalf(\"Load(%s) error = %v, want unsupported-version refusal\", version, err)\n61|\t\t\t\t}\n62|\t\t\t\treturn\n63|\t\t\t}\n64|\t\t\tsnapshot, err := loadConfigDocument(document, scalar.PlatformMacOS, nil)\n65|\t\t\tif err != nil {\n66|\t\t\t\tt.Fatalf(\"Load(%s) error = %v\", version, err)\n67|\t\t\t}\n68|\t\t\tloaded, ok := snapshot.Configuration()\n69|\t\t\tif !ok {\n70|\t\t\t\tt.Fatalf(\"Load(%s).Configuration() missing\", version)\n71|\t\t\t}\n72|\t\t\tif loaded.SourceVersion != version || loaded.Value.SchemaVersion != CurrentVersion {\n73|\t\t\t\tt.Fatalf(\"Load(%s) versions = source %q/current %q\", version, loaded.SourceVersion, loaded.Value.SchemaVersion)\n74|\t\t\t}\n75|\t\t\tif got := loaded.Value.Terminal.BackendID; got != \"ax.tmux\" {\n76|\t\t\t\tt.Fatalf(\"Load(%s) legacy/current terminal backend = %q, want ax.tmux\", version, got)\n77|\t\t\t}\n78|\t\t\tif loaded.Value.Directory.Mode != \"on_demand\" || loaded.Value.Directory.DefaultMetadataPolicy != \"local_only\" {\n79|\t\t\t\tt.Fatalf(\"Load(%s) did not apply safe current directory defaults: %#v\", version, loaded.Value.Directory)\n80|\t\t\t}\n81|\t\t})\n82|\t}\n83|}\n84|\n85|func TestLoadAcceptsExactV2DirectoryAndV3TerminalShapes(t *testing.T) {\n86|\tt.Parallel()\n87|\n88|\tv2 := string(minimalValidConfigVersion(scalar.PlatformMacOS, Version2)) + `\n89|[directory]\n90|enabled = true\n91|mode = \"service\"\n92|scan_interval_seconds = 5\n93|scan_debounce_seconds = 0\n94|scan_concurrency = 32\n95|fresh_current_seconds = 1\n96|fresh_aging_seconds = 2\n97|fresh_stale_seconds = 3\n98|plan_expiry_seconds = 30\n99|default_metadata_policy = \"reference_only\"\n100|generated_summary_upgrade_choice = \"local_only\"\n101|default_enrichment_profile_id = \"` + testDigest + `\"\n102|query_page_default = 1\n103|query_page_max = 1\n104|query_batch_max = 1\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d423","stream":{"kind":"session","id":"01a08929-2295-79c3-b516-94fb67387c85"},"sequence":2156,"recorded_at":1780531400004307,"record_type":"event","durability":"durable","causation_id":"d85af3b0-d1fc-4877-88c4-7da3d8622a21","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d85af3b0-d1fc-4877-88c4-7da3d8622a21","run_stream":{"kind":"run","id":"d85af3b0-d1fc-4877-88c4-7da3d8622a21"},"call_id":"call_01a08934c4227bc38ca5fb2bda0282ef","text":"Read text file `internal/config/schema_test.go`.\n(174 line(s) above)\n175|}\n176|\n177|func TestLoadRefusesUnknownClosedMembersUnsupportedVersionsAndMalformedReads(t *testing.T) {\n178|\tt.Parallel()\n179|\n180|\tfor _, version := range []string{Version1, Version2, CurrentVersion} {\n181|\t\tversion := version\n182|\t\tt.Run(version+\" unknown root\", func(t *testing.T) {\n183|\t\t\tdocument := append(minimalValidConfigVersion(scalar.PlatformMacOS, version), []byte(\"unknown = true\\n\")...)\n184|\t\t\t_, err := loadConfigDocument(document, scalar.PlatformMacOS, nil)\n185|\t\t\tif !errors.Is(err, ErrConfigDecode) {\n186|\t\t\t\tt.Fatalf(\"Load(%s unknown root) error = %v, want ErrConfigDecode\", version, err)\n187|\t\t\t}\n188|\t\t})\n189|\t}\n190|\tfor name, document := range map[string][]byte{\n191|\t\t\"unsupported major\": minimalValidConfigVersion(scalar.PlatformMacOS, \"4.0.0\"),\n192|\t\t\"unsupported minor\": minimalValidConfigVersion(scalar.PlatformMacOS, \"3.1.0\"),\n193|\t\t\"wrong schema\":      []byte(\"schema = \\\"urn:ax:schema:not-config\\\"\\nschema_version = \\\"1.0.0\\\"\\n\"),\n194|\t\t\"duplicate member\":  append(minimalValidConfigVersion(scalar.PlatformMacOS, Version1), []byte(\"host_name = \\\"second\\\"\\n\")...),\n195|\t\t\"partial read\":      []byte(\"schema = \\\"urn:ax:schema:config\\\"\\nschema_version = \\\"1.0.0\\\"\\nhost_id =\"),\n196|\t} {\n197|\t\tname, document := name, document\n198|\t\tt.Run(name, func(t *testing.T) {\n199|\t\t\t_, err := loadConfigDocument(document, scalar.PlatformMacOS, nil)\n200|\t\t\tif err == nil {\n201|\t\t\t\tt.Fatalf(\"Load(%s) accepted invalid document\", name)\n202|\t\t\t}\n203|\t\t})\n204|\t}\n205|\tt.Run(\"platform differs from runtime probe\", func(t *testing.T) {\n206|\t\t_, err := loadConfigDocument(minimalValidConfigVersion(scalar.PlatformLinux, CurrentVersion), scalar.PlatformMacOS, nil)\n207|\t\tif !errors.Is(err, ErrConfigValidation) {\n208|\t\t\tt.Fatalf(\"Load(platform mismatch) error = %v, want ErrConfigValidation\", err)\n209|\t\t}\n210|\t})\n211|\tt.Run(\"built-in backend unsupported on platform\", func(t *testing.T) {\n212|\t\tdocument := append(minimalValidConfigVersion(scalar.PlatformWindows, CurrentVersion), []byte(\"\\n[terminal]\\nbackend_id = \\\"ax.tmux\\\"\\n\")...)\n213|\t\t_, err := Decode(document, DecodeContext{RuntimePlatform: scalar.PlatformWindows})\n214|\t\tif !errors.Is(err, ErrConfigValidation) {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
