{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d29b","stream":{"kind":"session","id":"01a08929-2295-79c3-b516-94fb67387c85"},"sequence":1960,"recorded_at":1780531400003915,"record_type":"event","durability":"durable","causation_id":"d85af3b0-d1fc-4877-88c4-7da3d8622a21","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d85af3b0-d1fc-4877-88c4-7da3d8622a21","run_stream":{"kind":"run","id":"d85af3b0-d1fc-4877-88c4-7da3d8622a21"},"task_stream":{"kind":"task","id":"01a08933-cb92-7642-bb40-55fdc78e4a13"},"task_id":"01a08933-cb92-7642-bb40-55fdc78e4a13","event":{"kind":"output","task_id":"01a08933-cb92-7642-bb40-55fdc78e4a13","chunk":"Read text file `internal/config/compatibility_regression_test.go`.\n1|package config\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|\t\"reflect\"\n7|\t\"sort\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\n11|\t\"github.com/pelletier/go-toml/v2\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|)\n15|\n16|// Version4 labels adopted census rows whose runtime reader is not implemented.\n17|const Version4 = \"4.0.0\"\n18|\n19|type closedMapMemberCase struct {\n20|\tconfigure func(*Configuration) BackendSettingsValidator\n21|\tomit      func(*rawV3)\n22|\tclause    string\n23|}\n24|\n25|func closedMapMemberCases() map[string]closedMapMemberCase {\n26|\treturn map[string]closedMapMemberCase{\n27|\t\t\"directory_installations[].extensions\": {\n28|\t\t\tconfigure: func(configuration *Configuration) BackendSettingsValidator {\n29|\t\t\t\tconfiguration.DirectoryInstallations[0].Extensions = map[string]any{}\n30|\t\t\t\treturn nil\n31|\t\t\t},\n32|\t\t\tomit:   func(raw *rawV3) { raw.DirectoryInstallations[0].Extensions = nil },\n33|\t\t\tclause: \"directory_installations[0] required member\",\n34|\t\t},\n35|\t\t\"directory_enrichment_profiles[].extensions\": {\n36|\t\t\tconfigure: func(configuration *Configuration) BackendSettingsValidator {\n37|\t\t\t\tconfiguration.DirectoryEnrichmentProfiles = []DirectoryEnrichmentProfile{{\n38|\t\t\t\t\tProfileID: testDigest, Enabled: true, MaxConcurrency: 1,\n39|\t\t\t\t\tMetadataPolicy: \"local_only\", Extensions: map[string]any{},\n40|\t\t\t\t}}\n41|\t\t\t\treturn nil\n42|\t\t\t},\n43|\t\t\tomit:   func(raw *rawV3) { raw.DirectoryEnrichmentProfiles[0].Extensions = nil },\n44|\t\t\tclause: \"directory_enrichment_profiles[0] required member\",\n45|\t\t},\n46|\t\t\"directory_peer_disclosure[].extensions\": {\n47|\t\t\tconfigure: func(configuration *Configuration) BackendSettingsValidator {\n48|\t\t\t\tconfiguration.DirectoryPeerDisclosure = []DirectoryPeerDisclosure{{\n49|\t\t\t\t\tHostID: testPeerID, EnvironmentObservations: \"local_only\", NativeObservations: \"local_only\",\n50|\t\t\t\t\tManualMetadata: \"local_only\", GeneratedMetadata: \"local_only\", JobOperationStatus: \"local_only\",\n51|\t\t\t\t\tExtensions: map[string]any{},\n52|\t\t\t\t}}\n53|\t\t\t\treturn nil\n54|\t\t\t},\n55|\t\t\tomit:   func(raw *rawV3) { raw.DirectoryPeerDisclosure[0].Extensions = nil },\n56|\t\t\tclause: \"directory_peer_disclosure[0] required member\",\n57|\t\t},\n58|\t\t\"terminal.backend_config[].settings\": {\n59|\t\t\tconfigure: func(configuration *Configuration) BackendSettingsValidator {\n60|\t\t\t\tconfiguration.Terminal.BackendConfig = []BackendConfig{{\n61|\t\t\t\t\tBackendID: \"ax.tmux\", ConfigVersion: \"1.0.0\", Settings: map[string]any{},\n62|\t\t\t\t}}\n63|\t\t\t\treturn acceptBackendSettings{}\n64|\t\t\t},\n65|\t\t\tomit:   func(raw *rawV3) { raw.Terminal.BackendConfig[0].Settings = nil },\n66|\t\t\tclause: \"terminal.backend_config[0] required member\",\n67|\t\t},\n68|\t}\n69|}\n70|\n71|func TestEveryClosedMapMemberRoundTripsAnExplicitEmptyObjectAtProductionEntry(t *testing.T) {\n72|\tt.Parallel()\n73|\n74|\tcases := closedMapMemberCases()\n75|\n76|\tderived := closedMapMemberPaths(reflect.TypeFor[rawV3]())\n77|\trequireClosedMapMemberCaseCompleteness(t, cases, derived)\n78|\n79|\tfor _, path := range derived {\n80|\t\tpath := path\n81|\t\tt.Run(path, func(t *testing.T) {\n82|\t\t\tconfiguration := validCurrentConfiguration()\n83|\t\t\tsettings := cases[path].configure(&configuration)\n84|\t\t\tcontext := DecodeContext{RuntimePlatform: scalar.PlatformMacOS, BackendSettings: settings}\n85|\t\t\tencoded, err := EncodeCurrent(configuration, context)\n86|\t\t\tif err != nil {\n87|\t\t\t\tt.Fatalf(\"EncodeCurrent(%s empty object) error = %v\", path, err)\n88|\t\t\t}\n89|\t\t\tsnapshot, err := loadConfigDocument(encoded, scalar.PlatformMacOS, settings)\n90|\t\t\tif err != nil {\n91|\t\t\t\tt.Fatalf(\"Load(EncodeCurrent(%s empty object)) error = %v\\n%s\", path, err, encoded)\n92|\t\t\t}\n93|\t\t\tloaded, ok := snapshot.Configuration()\n94|\t\t\tif !ok || loaded.SourceVersion != CurrentVersion {\n95|\t\t\t\tt.Fatalf(\"Load(EncodeCurrent(%s)).Configuration() = %#v, present=%v\", path, loaded, ok)\n96|\t\t\t}\n97|\t\t})\n98|\t}\n99|}\n100|\n101|func TestLoadRefusesEveryAbsentRequiredClosedMapMemberAtProductionEntry(t *testing.T) {\n102|\tt.Parallel()\n103|\n104|\tcases := closedMapMemberCases()\n105|\tderived := closedMapMemberPaths(reflect.TypeFor[rawV3]())\n106|\trequireClosedMapMemberCaseCompleteness(t, cases, derived)\n107|\n108|\tfor _, path := range derived {\n109|\t\tpath := path\n110|\t\tt.Run(path, func(t *testing.T) {\n111|\t\t\tconfiguration := validCurrentConfiguration()\n112|\t\t\ttestCase := cases[path]\n113|\t\t\tsettings := testCase.configure(&configuration)\n114|\t\t\traw := currentWire(configuration)\n115|\n116|\t\t\tcomplete, err := toml.Marshal(raw)\n117|\t\t\tif err != nil {\n118|\t\t\t\tt.Fatalf(\"marshal complete %s fixture: %v\", path, err)\n119|\t\t\t}\n120|\t\t\tif _, err := loadConfigDocument(complete, scalar.PlatformMacOS, settings); err != nil {\n121|\t\t\t\tt.Fatalf(\"complete %s fixture is not valid: %v\", path, err)\n122|\t\t\t}\n123|\n124|\t\t\ttestCase.omit(&raw)\n125|\t\t\tomitted, err := toml.Marshal(raw)\n126|\t\t\tif err != nil {\n127|\t\t\t\tt.Fatalf(\"marshal %s omission fixture: %v\", path, err)\n128|\t\t\t}\n129|\t\t\t_, err = loadConfigDocument(omitted, scalar.PlatformMacOS, settings)\n130|\t\t\trequireConfigClause(t, err, testCase.clause)\n131|\t\t})\n132|\t}\n133|}\n134|\n135|func TestLoadTreatsInlineAndMultilineEmptyClosedMapsAsPresent(t *testing.T) {\n136|\tt.Parallel()\n137|\n138|\tprefix := string(minimalValidConfigVersion(scalar.PlatformMacOS, Version2)) + `\n139|[[directory_installations]]\n140|installation_id = \"` + testDigest + `\"\n141|environment_id = \"local\"\n142|provider_id = \"codex\"\n143|adapter_id = \"codex-local\"\n144|scan_root_authority_ids = [\"` + testDigest + `\"]\n145|enabled = true\n146|`\n147|\tfor name, suffix := range map[string]string{\n148|\t\t\"inline object\":         \"extensions = {}\\n\",\n149|\t\t\"multiline empty table\": \"[directory_installations.extensions]\\n\",\n150|\t} {\n151|\t\tname, suffix := name, suffix\n152|\t\tt.Run(name, func(t *testing.T) {\n153|\t\t\tif _, err := loadConfigDocument([]byte(prefix+suffix), scalar.PlatformMacOS, nil); err != nil {\n154|\t\t\t\tt.Fatalf(\"Load(%s empty object) error = %v\", name, err)\n155|\t\t\t}\n156|\t\t})\n157|\t}\n158|}\n159|\n160|func TestEveryPinnedReaderHasPositiveNativeWindowsAndWSL2Lanes(t *testing.T) {\n161|\tt.Parallel()\n162|\n163|\tfor _, version := range pinnedConfigurationVersions(t) {\n164|\t\tversion := version\n165|\t\tfor _, platformCase := range []struct {\n166|\t\t\tplatform scalar.Platform\n167|\t\t\tpath     string\n168|\t\t\tbackend  string\n169|\t\t}{\n170|\t\t\t{platform: scalar.PlatformWindows, path: `D:\\Developer\\ReluxWorks`, backend: \"ax.conpty\"},\n171|\t\t\t{platform: scalar.PlatformWSL2, path: \"/srv/relux\", backend: \"ax.tmux\"},\n172|\t\t} {\n173|\t\t\tplatformCase := platformCase\n174|\t\t\tt.Run(version+\"/\"+platformCase.platform.String(), func(t *testing.T) {\n175|\t\t\t\tdocument := append(minimalValidConfigVersion(platformCase.platform, version), []byte(fmt.Sprintf(`\n176|[[workspace_roots]]\n177|logical_root = \"relux\"\n178|path = %q\n179|`, platformCase.path))...)\n180|\t\t\t\tif version == Version4 {\n181|\t\t\t\t\t// SPEC 6.6: a 3.0.0 reader refuses 4.0.0 documents on\n182|\t\t\t\t\t// every platform lane rather than selecting legacy\n183|\t\t\t\t\t// behavior for a mesh it cannot secure.\n184|\t\t\t\t\tif _, err := loadConfigDocument(document, platformCase.platform, nil); !errors.Is(err, ErrUnsupportedConfigVersion) {\n185|\t\t\t\t\t\tt.Fatalf(\"Load(%s %s native path) error = %v, want unsupported-version refusal\", version, platformCase.platform, err)\n186|\t\t\t\t\t}\n187|\t\t\t\t\treturn\n188|\t\t\t\t}\n189|\t\t\t\tsnapshot, err := loadConfigDocument(document, platformCase.platform, nil)\n190|\t\t\t\tif err != nil {\n191|\t\t\t\t\tt.Fatalf(\"Load(%s %s native path) error = %v\", version, platformCase.platform, err)\n192|\t\t\t\t}\n193|\t\t\t\tloaded, ok := snapshot.Configuration()\n194|\t\t\t\tif !ok || loaded.Value.Terminal.BackendID != platformCase.backend {\n195|\t\t\t\t\tt.Fatalf(\"Load(%s %s) backend = %q, present=%v, want %q\", version, platformCase.platform, loaded.Value.Terminal.BackendID, ok, platformCase.backend)\n196|\t\t\t\t}\n197|\t\t\t})\n198|\t\t}\n199|\t}\n200|}\n201|\n202|func TestLegacyConPTYTranslationIsPinnedForEveryLegacyReader(t *testing.T) {\n203|\tt.Parallel()\n204|\n205|\tfor _, version := range pinnedConfigurationVersions(t) {\n206|\t\tif version == CurrentVersion {\n207|\t\t\tcontinue\n208|\t\t}\n209|\t\tdocument := append(minimalValidConfigVersion(scalar.PlatformWindows, version), []byte(\"\\n[terminal]\\nbackend = \\\"conpty\\\"\\n\")...)\n210|\t\tif version == Version4 {\n211|\t\t\t// SPEC 6.6: the version refusal fires before any member\n212|\t\t\t// translation, so even a familiar terminal table on a 4.0.0\n213|\t\t\t// document is refused rather than read as legacy.\n214|\t\t\tif _, err := loadConfigDocument(document, scalar.PlatformWindows, nil); !errors.Is(err, ErrUnsupportedConfigVersion) {\n215|\t\t\t\tt.Fatalf(\"Load(%s explicit conpty) error = %v, want unsupported-version refusal\", version, err)\n216|\t\t\t}\n217|\t\t\tcontinue\n218|\t\t}\n219|\t\tsnapshot, err := loadConfigDocument(document, scalar.PlatformWindows, nil)\n220|\t\tif err != nil {\n221|\t\t\tt.Fatalf(\"Load(%s explicit conpty) error = %v\", version, err)\n222|\t\t}\n223|\t\tloaded, _ := snapshot.Configuration()\n224|\t\tif loaded.Value.Terminal.BackendID != \"ax.conpty\" {\n225|\t\t\tt.Fatalf(\"Load(%s explicit conpty) backend = %q\", version, loaded.Value.Terminal.BackendID)\n226|\t\t}\n227|\t}\n228|}\n229|\n230|func TestPeerWorkspaceRootValidationUsesPeerPlatformAndPinsEveryNestedClause(t *testing.T) {\n231|\tt.Parallel()\n232|\n233|\tvalidWindowsPeer := func() Configuration {\n234|\t\tconfiguration := validCurrentConfiguration()\n235|\t\tconfiguration.Mesh.Peers[0].Platform = scalar.PlatformWindows\n236|\t\tconfiguration.Mesh.Peers[0].WorkspaceRoots = []WorkspaceRoot{{LogicalRoot: \"relux\", Path: `D:\\Developer\\ReluxWorks`}}\n237|\t\treturn configuration\n238|\t}\n239|\tif _, err := EncodeCurrent(validWindowsPeer(), DecodeContext{RuntimePlatform: scalar.PlatformMacOS}); err != nil {\n240|\t\tt.Fatalf(\"EncodeCurrent(native Windows peer root) error = %v\", err)\n241|\t}\n242|\n243|\ttests := []struct {\n244|\t\tname, clause string\n245|\t\tmutate       func(*Configuration)\n246|\t}{\n247|\t\t{name: \"peer path grammar\", clause: \"mesh.peers[0].workspace_roots[0].path\", mutate: func(value *Configuration) {\n248|\t\t\tvalue.Mesh.Peers[0].WorkspaceRoots[0].Path = \"/srv/relux\"\n249|\t\t}},\n250|\t\t{name: \"peer logical-root grammar\", clause: \"mesh.peers[0].workspace_roots[0].logical_root\", mutate: func(value *Configuration) {\n251|\t\t\tvalue.Mesh.Peers[0].WorkspaceRoots[0].LogicalRoot = \"Relux\"\n252|\t\t}},\n253|\t\t{name: \"peer duplicate logical root\", clause: \"mesh.peers[0].workspace_roots duplicate logical_root\", mutate: func(value *Configuration) {\n254|\t\t\tvalue.Mesh.Peers[0].WorkspaceRoots = append(value.Mesh.Peers[0].WorkspaceRoots, value.Mesh.Peers[0].WorkspaceRoots[0])\n255|\t\t}},\n256|\t}\n257|\tfor _, test := range tests {\n258|\t\ttest := test\n259|\t\tt.Run(test.name, func(t *testing.T) {\n260|\t\t\tconfiguration := validWindowsPeer()\n261|\t\t\ttest.mutate(&configuration)\n262|\t\t\t_, err := EncodeCurrent(configuration, DecodeContext{RuntimePlatform: scalar.PlatformMacOS})\n263|\t\t\trequireConfigClause(t, err, test.clause)\n264|\t\t})\n265|\t}\n266|}\n267|\n268|func TestPreviouslyUnpinnedConfigurationBoundsAtProductionEntry(t *testing.T) {\n269|\tt.Parallel()\n270|\n271|\tt.Run(\"scan authority minimum\", func(t *testing.T) {\n272|\t\tconfiguration := validCurrentConfiguration()\n273|\t\tconfiguration.DirectoryInstallations[0].ScanRootAuthorityIDs = []string{}\n274|\t\t_, err := EncodeCurrent(configuration, DecodeContext{RuntimePlatform: scalar.PlatformMacOS})\n275|\t\trequireConfigClause(t, err, \"directory_installations[0].scan_root_authority_ids\")\n276|\t})\n277|\n278|\tt.Run(\"logical-root grammar independent of length\", func(t *testing.T) {\n279|\t\tfor _, logicalRoot := range []string{\"Relux\", \"1relux\"} {\n280|\t\t\tconfiguration := validCurrentConfiguration()\n281|\t\t\tconfiguration.WorkspaceRoots[0].LogicalRoot = logicalRoot\n282|\t\t\t_, err := EncodeCurrent(configuration, DecodeContext{RuntimePlatform: scalar.PlatformMacOS})\n283|\t\t\trequireConfigClause(t, err, \"workspace_roots[0].logical_root\")\n284|\t\t}\n285|\t})\n286|\n287|\tt.Run(\"extension namespace grammar subsumes the three-byte minimum\", func(t *testing.T) {\n288|\t\tat := validCurrentConfiguration()\n289|\t\tat.DirectoryInstallations[0].Extensions = map[string]any{\"a.b\": true}\n290|\t\tif _, err := EncodeCurrent(at, DecodeContext{RuntimePlatform: scalar.PlatformMacOS}); err != nil {\n291|\t\t\tt.Fatalf(\"EncodeCurrent(shortest reverse-DNS extension key) error = %v\", err)\n292|\t\t}\n293|\t\tpast := validCurrentConfiguration()\n294|\t\tpast.DirectoryInstallations[0].Extensions = map[string]any{\"ab\": true}\n295|\t\t_, err := EncodeCurrent(past, DecodeContext{RuntimePlatform: scalar.PlatformMacOS})\n296|\t\trequireConfigClause(t, err, \"directory_installations[0].extensions\")\n297|\t})\n298|\n299|\tt.Run(\"extension int64 safe-integer bound\", func(t *testing.T) {\n300|\t\tat := validCurrentConfiguration()\n301|\t\tat.DirectoryInstallations[0].Extensions = map[string]any{\"works.relux.number\": int64(scalar.MaxSafeInteger)}\n302|\t\tif _, err := EncodeCurrent(at, DecodeContext{RuntimePlatform: scalar.PlatformMacOS}); err != nil {\n303|\t\t\tt.Fatalf(\"EncodeCurrent(extension int64 at safe limit) error = %v\", err)\n304|\t\t}\n305|\t\tpast := validCurrentConfiguration()\n306|\t\tpast.DirectoryInstallations[0].Extensions = map[string]any{\"works.relux.number\": int64(scalar.MaxSafeInteger + 1)}\n307|\t\t_, err := EncodeCurrent(past, DecodeContext{RuntimePlatform: scalar.PlatformMacOS})\n308|\t\trequireConfigClause(t, err, \"directory_installations[0].extensions\")\n309|\t})\n310|}\n311|\n312|func closedMapMemberPaths(root reflect.Type) []string {\n313|\tclosedMap := reflect.TypeFor[map[string]any]()\n314|\tvar paths []string\n315|\tvar visit func(reflect.Type, string)\n316|\tvisit = func(value reflect.Type, prefix string) {\n317|\t\tif value.Kind() == reflect.Pointer {\n318|\t\t\tvalue = value.Elem()\n319|\t\t}\n320|\t\tif value.Kind() != reflect.Struct {\n321|\t\t\treturn\n322|\t\t}\n323|\t\tfor index := 0; index < value.NumField(); index++ {\n324|\t\t\tfield := value.Field(index)\n325|\t\t\tname := strings.Split(field.Tag.Get(\"toml\"), \",\")[0]\n326|\t\t\tif name == \"\" || name == \"-\" {\n327|\t\t\t\tcontinue\n328|\t\t\t}\n329|\t\t\tpath := name\n330|\t\t\tif prefix != \"\" {\n331|\t\t\t\tpath = prefix + \".\" + name\n332|\t\t\t}\n333|\t\t\tfieldType := field.Type\n334|\t\t\tif fieldType == closedMap {\n335|\t\t\t\tpaths = append(paths, path)\n336|\t\t\t\tcontinue\n337|\t\t\t}\n338|\t\t\tif fieldType.Kind() == reflect.Slice && fieldType.Elem().Kind() == reflect.Struct {\n339|\t\t\t\tvisit(fieldType.Elem(), path+\"[]\")\n340|\t\t\t\tcontinue\n341|\t\t\t}\n342|\t\t\tvisit(fieldType, path)\n343|\t\t}\n344|\t}\n345|\tvisit(root, \"\")\n346|\tsort.Strings(paths)\n347|\treturn paths\n348|}\n349|\n350|func requireClosedMapMemberCaseCompleteness(t *testing.T, cases map[string]closedMapMemberCase, derived []string) {\n351|\tt.Helper()\n352|\tdeclared := make([]string, 0, len(cases))\n353|\tfor path := range cases {\n354|\t\tdeclared = append(declared, path)\n355|\t}\n356|\tsort.Strings(declared)\n357|\tif !reflect.DeepEqual(declared, derived) {\n358|\t\tt.Fatalf(\"closed-map cases = %v, rawV3 closed map members = %v\", declared, derived)\n359|\t}\n360|}\n361|\n362|func pinnedConfigurationVersions(t *testing.T) []string {\n363|\tt.Helper()\n364|\tfor _, contract := range catalog.Current().Contracts {\n365|\t\tif contract.ID == catalog.ContractID(SchemaID) {\n366|\t\t\treturn append([]string(nil), contract.Versions...)\n367|\t\t}\n368|\t}\n369|\tt.Fatal(\"pinned catalog has no Configuration contract\")\n370|\treturn nil\n371|}","final_result":true}}}
