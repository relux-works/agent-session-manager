{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d419","stream":{"kind":"session","id":"01a08929-2295-79c3-b516-94fb67387c85"},"sequence":2151,"recorded_at":1780531400004297,"record_type":"event","durability":"durable","causation_id":"d85af3b0-d1fc-4877-88c4-7da3d8622a21","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d85af3b0-d1fc-4877-88c4-7da3d8622a21","run_stream":{"kind":"run","id":"d85af3b0-d1fc-4877-88c4-7da3d8622a21"},"task_stream":{"kind":"task","id":"01a08934-c62e-7d01-bdf1-c950bdc759b4"},"task_id":"01a08934-c62e-7d01-bdf1-c950bdc759b4","event":{"kind":"output","task_id":"01a08934-c62e-7d01-bdf1-c950bdc759b4","chunk":"Read text file `internal/config/schema_test.go`.\n(24 line(s) above)\n25|\tcurrent := catalog.Current()\n26|\tvar expected []string\n27|\tfor _, contract := range current.Contracts {\n28|\t\tif contract.ID == catalog.ContractID(SchemaID) {\n29|\t\t\texpected = append([]string(nil), contract.Versions...)\n30|\t\t\tbreak\n31|\t\t}\n32|\t}\n33|\tif len(expected) == 0 {\n34|\t\tt.Fatal(\"pinned catalog has no Configuration contract\")\n35|\t}\n36|\tfixtures := map[string][]byte{\n37|\t\tVersion1:       minimalValidConfigVersion(scalar.PlatformMacOS, Version1),\n38|\t\tVersion2:       minimalValidConfigVersion(scalar.PlatformMacOS, Version2),\n39|\t\tCurrentVersion: minimalValidConfigVersion(scalar.PlatformMacOS, CurrentVersion),\n40|\t\tVersion4:       minimalValidConfigVersion(scalar.PlatformMacOS, Version4),\n41|\t}\n42|\tif len(fixtures) != len(expected) {\n43|\t\tt.Fatalf(\"reader fixture registry has %d versions, pinned catalog requires %v\", len(fixtures), expected)\n44|\t}\n45|\tfor _, version := range expected {\n46|\t\tversion := version\n47|\t\tt.Run(version, func(t *testing.T) {\n48|\t\t\tt.Parallel()\n49|\t\t\tdocument, ok := fixtures[version]\n50|\t\t\tif !ok {\n51|\t\t\t\tt.Fatalf(\"pinned Configuration version %s has no production reader fixture\", version)\n52|\t\t\t}\n53|\t\t\tif version == Version4 {\n54|\t\t\t\t// SPEC 6.6 makes a 4.0.0 document on a 3.0.0 reader a\n55|\t\t\t\t// refusal, never legacy selection: translating one down to\n56|\t\t\t\t// 3.0.0 would silently drop the mandatory mesh.transport\n57|\t\t\t\t// and mesh.host_channel members, so Load must refuse with\n58|\t\t\t\t// the unsupported-version refusal instead of translating.\n59|\t\t\t\tif _, err := loadConfigDocument(document, scalar.PlatformMacOS, nil); !errors.Is(err, ErrUnsupportedConfigVersion) {\n60|\t\t\t\t\tt.Fatalf(\"Load(%s) error = %v, want unsupported-version refusal\", version, err)\n61|\t\t\t\t}\n62|\t\t\t\treturn\n63|\t\t\t}\n64|\t\t\tsnapshot, err := loadConfigDocument(document, scalar.PlatformMacOS, nil)\n65|\t\t\tif err != nil {\n66|\t\t\t\tt.Fatalf(\"Load(%s) error = %v\", version, err)\n67|\t\t\t}\n68|\t\t\tloaded, ok := snapshot.Configuration()\n69|\t\t\tif !ok {\n70|\t\t\t\tt.Fatalf(\"Load(%s).Configuration() missing\", version)\n71|\t\t\t}\n72|\t\t\tif loaded.SourceVersion != version || loaded.Value.SchemaVersion != CurrentVersion {\n73|\t\t\t\tt.Fatalf(\"Load(%s) versions = source %q/current %q\", version, loaded.SourceVersion, loaded.Value.SchemaVersion)\n74|\t\t\t}\n75|\t\t\tif got := loaded.Value.Terminal.BackendID; got != \"ax.tmux\" {\n76|\t\t\t\tt.Fatalf(\"Load(%s) legacy/current terminal backend = %q, want ax.tmux\", version, got)\n77|\t\t\t}\n78|\t\t\tif loaded.Value.Directory.Mode != \"on_demand\" || loaded.Value.Directory.DefaultMetadataPolicy != \"local_only\" {\n79|\t\t\t\tt.Fatalf(\"Load(%s) did not apply safe current directory defaults: %#v\", version, loaded.Value.Directory)\n80|\t\t\t}\n81|\t\t})\n82|\t}\n83|}\n84|\n85|func TestLoadAcceptsExactV2DirectoryAndV3TerminalShapes(t *testing.T) {\n86|\tt.Parallel()\n87|\n88|\tv2 := string(minimalValidConfigVersion(scalar.PlatformMacOS, Version2)) + `\n89|[directory]\n90|enabled = true\n91|mode = \"service\"\n92|scan_interval_seconds = 5\n93|scan_debounce_seconds = 0\n94|scan_concurrency = 32\n95|fresh_current_seconds = 1\n96|fresh_aging_seconds = 2\n97|fresh_stale_seconds = 3\n98|plan_expiry_seconds = 30\n99|default_metadata_policy = \"reference_only\"\n100|generated_summary_upgrade_choice = \"local_only\"\n101|default_enrichment_profile_id = \"` + testDigest + `\"\n102|query_page_default = 1\n103|query_page_max = 1\n104|query_batch_max = 1\n(more lines below)","final_result":true}}}
