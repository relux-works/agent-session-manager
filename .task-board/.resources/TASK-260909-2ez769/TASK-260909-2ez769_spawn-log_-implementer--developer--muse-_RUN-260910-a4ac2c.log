     []byte(\"schema = \\\"urn:ax:schema:config\\\"\\nschema_version = \\\"1.0.0\\\"\\nhost_id =\"),\n196|\t} {\n197|\t\tname, document := name, document\n198|\t\tt.Run(name, func(t *testing.T) {\n199|\t\t\t_, err := loadConfigDocument(document, scalar.PlatformMacOS, nil)\n200|\t\t\tif err == nil {\n201|\t\t\t\tt.Fatalf(\"Load(%s) accepted invalid document\", name)\n202|\t\t\t}\n203|\t\t})\n204|\t}\n205|\tt.Run(\"platform differs from runtime probe\", func(t *testing.T) {\n206|\t\t_, err := loadConfigDocument(minimalValidConfigVersion(scalar.PlatformLinux, CurrentVersion), scalar.PlatformMacOS, nil)\n207|\t\tif !errors.Is(err, ErrConfigValidation) {\n208|\t\t\tt.Fatalf(\"Load(platform mismatch) error = %v, want ErrConfigValidation\", err)\n209|\t\t}\n210|\t})\n211|\tt.Run(\"built-in backend unsupported on platform\", func(t *testing.T) {\n212|\t\tdocument := append(minimalValidConfigVersion(scalar.PlatformWindows, CurrentVersion), []byte(\"\\n[terminal]\\nbackend_id = \\\"ax.tmux\\\"\\n\")...)\n213|\t\t_, err := Decode(document, DecodeContext{RuntimePlatform: scalar.PlatformWindows})\n214|\t\tif !errors.Is(err, ErrConfigValidation) {\n(more lines below)","final_result":true}}}
