{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d545","stream":{"kind":"session","id":"01a08929-2295-79c3-b516-94fb67387c85"},"sequence":2301,"recorded_at":1780531400004597,"record_type":"event","durability":"durable","causation_id":"d85af3b0-d1fc-4877-88c4-7da3d8622a21","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d85af3b0-d1fc-4877-88c4-7da3d8622a21","run_stream":{"kind":"run","id":"d85af3b0-d1fc-4877-88c4-7da3d8622a21"},"task_stream":{"kind":"task","id":"01a08935-5dae-7333-8761-6231671a1f9a"},"task_id":"01a08935-5dae-7333-8761-6231671a1f9a","event":{"kind":"output","task_id":"01a08935-5dae-7333-8761-6231671a1f9a","chunk":"Read text file `internal/config/schema_v4_test.go`.\n1|package config\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|func validV4Configuration() Configuration {\n13|\tconfiguration := validCurrentConfiguration()\n14|\tconfiguration.SchemaVersion = Version4\n15|\tconfiguration.Mesh.Transport = TransportSSHTLS13\n16|\tconfiguration.Mesh.HostChannel = &HostChannel{Version: HostChannelVersion, CredentialID: testDigest}\n17|\treturn configuration\n18|}\n19|\n20|func decodeContextForTest() DecodeContext {\n21|\treturn DecodeContext{RuntimePlatform: scalar.PlatformMacOS}\n22|}\n23|\n24|func TestDecodeConfiguration4(t *testing.T) {\n25|\tdocument, err := EncodeVersion4(validV4Configuration(), decodeContextForTest())\n26|\tif err != nil {\n27|\t\tt.Fatalf(\"EncodeVersion4 error = %v\", err)\n28|\t}\n29|\tloaded, err := Decode(document, decodeContextForTest())\n30|\tif err != nil {\n31|\t\tt.Fatalf(\"Decode(v4) error = %v\", err)\n32|\t}\n33|\tif loaded.SourceVersion != Version4 {\n34|\t\tt.Fatalf(\"Decode(v4) source = %q, want 4.0.0\", loaded.SourceVersion)\n35|\t}\n36|\tif loaded.Value.Mesh.Transport != TransportSSHTLS13 {\n37|\t\tt.Fatalf(\"Decode(v4) transport = %q\", loaded.Value.Mesh.Transport)\n38|\t}\n39|\tchannel := loaded.Value.Mesh.HostChannel\n40|\tif channel == nil || channel.Version != HostChannelVersion || channel.CredentialID != testDigest {\n41|\t\tt.Fatalf(\"Decode(v4) host_channel = %+v\", channel)\n42|\t}\n43|\t// Retained Configuration 3.0.0 members survive the migration shape.\n44|\tif len(loaded.Value.Mesh.Peers) != 1 || loaded.Value.HostName != \"fixture-host\" {\n45|\t\tt.Fatalf(\"Decode(v4) dropped retained members: %+v\", loaded.Value.Mesh.Peers)\n46|\t}\n47|}\n48|\n49|func TestDecodeConfiguration4Refusals(t *testing.T) {\n50|\tbase, err := EncodeVersion4(validV4Configuration(), decodeContextForTest())\n51|\tif err != nil {\n52|\t\tt.Fatalf(\"EncodeVersion4 error = %v\", err)\n53|\t}\n54|\tvalid := string(base)\n55|\ttests := []struct {\n56|\t\tname     string\n57|\t\tdocument string\n58|\t}{\n59|\t\t{\"missing transport\", strings.Replace(valid, \"transport = 'ssh_tls13'\\n\", \"\", 1)},\n60|\t\t{\"legacy transport\", strings.Replace(valid, `transport = 'ssh_tls13'`, `transport = 'ssh'`, 1)},\n61|\t\t{\"unknown transport\", strings.Replace(valid, `transport = 'ssh_tls13'`, `transport = 'quic'`, 1)},\n62|\t\t{\"missing host_channel\", strings.Replace(valid, \"[mesh.host_channel]\\nversion = '1.0.0'\\ncredential_id = '\"+testDigest+\"'\\n\", \"\", 1)},\n63|\t\t{\"missing channel version\", strings.Replace(valid, \"version = '1.0.0'\\n\", \"\", 1)},\n64|\t\t{\"missing credential_id\", strings.Replace(valid, \"credential_id = '\"+testDigest+\"'\\n\", \"\", 1)},\n65|\t\t{\"wrong channel version\", strings.Replace(valid, `version = '1.0.0'`, `version = '2.0.0'`, 1)},\n66|\t\t{\"bad credential_id\", strings.Replace(valid, \"credential_id = '\"+testDigest+\"'\", `credential_id = 'md5:00'`, 1)},\n67|\t\t{\"unknown mesh key\", strings.Replace(valid, \"[mesh]\\n\", \"[mesh]\\npeer_override = true\\n\", 1)},\n68|\t\t{\"per peer override\", strings.Replace(valid, \"[[mesh.peers]]\", \"[mesh.peers.host_channel]\\nversion = '1.0.0'\\n[[mesh.peers]]\", 1)},\n69|\t\t{\"unknown root key\", strings.Replace(valid, \"platform = 'macos'\\n\", \"platform = 'macos'\\ncertificate = 'bytes'\\n\", 1)},\n70|\t\t{\"credential bytes in toml\", valid + \"[mesh.tls_identity]\\ncertificate_pem = 'x'\\n\"},\n71|\t}\n72|\tfor _, test := range tests {\n73|\t\tt.Run(test.name, func(t *testing.T) {\n74|\t\t\tif _, err := Decode([]byte(test.document), decodeContextForTest()); err == nil {\n75|\t\t\t\tt.Fatalf(\"Decode(v4 %s) succeeded, want refusal\", test.name)\n76|\t\t\t} else {\n77|\t\t\t\tvar refusal *DocumentError\n78|\t\t\t\tif !errors.As(err, &refusal) {\n79|\t\t\t\t\tt.Fatalf(\"Decode(v4 %s) error type = %T, want *DocumentError\", test.name, err)\n80|\t\t\t\t}\n81|\t\t\t}\n82|\t\t})\n83|\t}\n84|}\n85|\n86|func TestDecodeConfiguration4MemberGates(t *testing.T) {\n87|\tbase, err := EncodeVersion4(validV4Configuration(), decodeContextForTest())\n88|\tif err != nil {\n89|\t\tt.Fatalf(\"EncodeVersion4 error = %v\", err)\n90|\t}\n91|\tvalid := string(base)\n92|\ttests := []struct {\n93|\t\tname     string\n94|\t\tdocument string\n95|\t}{\n96|\t\t{\"bad host_id\", strings.Replace(valid, \"host_id = '0198f4c8-4a10-7b22-8b3c-1234567890ab'\", \"host_id = 'not-a-uuid'\", 1)},\n97|\t\t{\"bad host_name\", strings.Replace(valid, \"host_name = 'fixture-host'\", \"host_name = ''\", 1)},\n98|\t\t{\"platform mismatch\", strings.Replace(valid, \"platform = 'macos'\", \"platform = 'linux'\", 1)},\n99|\t\t{\"bad service interval\", strings.Replace(valid, \"health_interval_seconds = 30\", \"health_interval_seconds = 4\", 1)},\n100|\t}\n101|\tfor _, test := range tests {\n102|\t\tt.Run(test.name, func(t *testing.T) {\n103|\t\t\tif _, err := Decode([]byte(test.document), decodeContextForTest()); err == nil {\n104|\t\t\t\tt.Fatalf(\"Decode(v4 %s) succeeded, want refusal\", test.name)\n105|\t\t\t} else if !errors.Is(err, ErrConfigValidation) {\n106|\t\t\t\tt.Fatalf(\"Decode(v4 %s) error = %v\", test.name, err)\n107|\t\t\t}\n108|\t\t})\n109|\t}\n110|}\n111|\n112|func TestValidateConfigurationV4SchemaGate(t *testing.T) {\n113|\t// Both producers set Version4 before validating, so a mislabeled value\n114|\t// can only arrive through direct misuse. The gate stays and is pinned.\n115|\tconfiguration := validV4Configuration()\n116|\tconfiguration.SchemaVersion = CurrentVersion\n117|\tif err := validateConfigurationV4(&configuration, decodeContextForTest()); err == nil {\n118|\t\tt.Fatal(\"validateConfigurationV4(mislabeled value) succeeded, want refusal\")\n119|\t} else if !errors.Is(err, ErrConfigValidation) {\n120|\t\tt.Fatalf(\"validateConfigurationV4 error = %v\", err)\n121|\t}\n122|}\n123|\n124|func TestValidateMeshV4NilChannel(t *testing.T) {\n125|\t// Decode and EncodeVersion4 both guarantee a non-nil binding before this\n126|\t// check, so only direct misuse reaches it. The guard stays and is pinned.\n127|\tconfiguration := validV4Configuration()\n128|\tconfiguration.Mesh.HostChannel = nil\n129|\tif err := validateMeshV4(&configuration); err == nil {\n130|\t\tt.Fatal(\"validateMeshV4(nil channel) succeeded, want refusal\")\n(more lines below)","final_result":true}}}
