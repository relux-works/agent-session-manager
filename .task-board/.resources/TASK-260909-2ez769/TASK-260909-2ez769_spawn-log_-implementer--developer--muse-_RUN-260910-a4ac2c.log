nt: ErrConfigDecode},\n257|\t\t// A newer document takes the read-only branch, which never consults the\n258|\t\t// known-version set, so the canonical-core check is the only thing\n259|\t\t// standing between \"01.0.0\" and a successful assessment.\n260|\t\t{name: \"non-canonical newer version\", document: strings.Replace(string(minimalValidConfigVersion(scalar.PlatformMacOS, CurrentVersion)), CurrentVersion, \"04.0.0\", 1), reader: CurrentVersion, want: ErrCompatibilityAssessment},\n261|\t\t{name: \"non-canonical older version\", document: strings.Replace(string(minimalValidConfigVersion(scalar.PlatformMacOS, Version1)), Version1, \"01.0.0\", 1), reader: CurrentVersion, want: ErrCompatibilityAssessment},\n262|\t}\n263|\tfor _, test := range tests {\n264|\t\tt.Run(test.name, func(t *testing.T) {\n265|\t\t\t_, err := AssessCompatibility([]byte(test.document), test.reader)\n266|\t\t\tif !errors.Is(err, test.want) {\n267|\t\t\t\tt.Fatalf(\"AssessCompatibility() error = %v, want %v\", err, test.want)\n268|\t\t\t}\n269|\t\t})\n270|\t}\n271|}\n272|\n273|// TestMigrateFsyncsEveryStagedFileBeforeItBecomesVisible pins the file half of\n274|// the durability contract in the widening direction. SPEC 6.4 requires that\n275|// migration \"writes a complete v2 file to a same-directory temporary file,\n276|// fsyncs it and the directory, and atomically replaces the original\", so every\n277|// file this migration stages must be fsynced, not just the last one. Narrowing\n278|// the production entry to fsync one of the two staged files leaves the counts\n279|// unequal; deleting the fsync outright is caught by the paired injected\n280|// failures in TestMigrateLeavesTheSourceIntactAtEveryDurableFailurePoint.\n281|func TestMigrateFsyncsEveryStagedFileBeforeItBecomesVisible(t *testing.T) {\n282|\tdirectory, filename, _ := seedMigrationSource(t, Version1)\n283|\tfilesystem := &faultMigrationFileSystem{}\n284|\n285|\tresult, err := migrate(migrationInputs(directory, filename), nil, MigrationOptions{\n286|\t\tTargetVersion: CurrentVersion, GeneratedSummaryUpgradeChoice: \"local_only\",\n287|\t}, filesystem)\n288|\tif err != nil || !result.Changed {\n289|\t\tt.Fatalf(\"Migrate(v1 to %s) = %#v, %v\", CurrentVersion, result, err)\n290|\t}\n291|\tif filesystem.createTempCalls != 2 {\n292|\t\tt.Fatalf(\"staged files = %d, want 2 (backup, replacement)\", filesystem.createTempCalls)\n293|\t}\n294|\tif filesystem.fileSyncCalls != filesystem.createTempCalls {\n295|\t\tt.Fatalf(\"file fsyncs = %d for %d staged files; every staged file must be fsynced before it becomes visible\",\n296|\t\t\tfilesystem.fileSyncCalls, filesystem.createTempCalls)\n297|\t}\n298|}\n299|\n300|// TestAssessCompatibilityPinsEveryPinnedVersionPairAtTheProductionEntry drives\n301|// the full cross-product of pinned Configuration versions through the real\n302|// AssessCompatibility entry. The expected mode is derived from the pinned\n303|// catalog's declared major versions rather than from the production comparison,\n304|// so the case SPEC 6.5 names literally - \"A v1/v2 binary opening v3 is\n305|// read-only diagnostic\" - is asserted at both the one-major and two-major step,\n306|// and every same-or-older implemented reader pair is compatible. Adopted\n307|// census versions with no runtime reader are explicitly refused.\n308|func TestAssessCompatibilityPinsEveryPinnedVersionPairAtTheProductionEntry(t *testing.T) {\n309|\tversions := pinnedConfigurationVersions(t)\n310|\tif len(versions) < 2 {\n311|\t\tt.Fatalf(\"pinned catalog declares %d Configuration versions, need at least two to bound a downgrade\", len(versions))\n312|\t}\n313|\treadOnlyPairs, compatiblePairs, refusedReaders := 0, 0, 0\n314|\tfor _, source := range versions {\n315|\t\tfor _, reader := range versions {\n316|\t\t\tsource, reader := source, reader\n317|\t\t\tt.Run(\"document_\"+source+\"_reader_\"+reader, func(t *testing.T) {\n318|\t\t\t\twant := CompatibilityCompatible\n319|\t\t\t\tif majorVersionForTest(t, source) > majorVersionForTest(t, reader) {\n320|\t\t\t\t\twant = CompatibilityReadOnly\n321|\t\t\t\t}\n322|\t\t\t\tdocument := minimalValidConfigVersion(scalar.PlatformMacOS, source)\n323|\t\t\t\toriginal := append([]byte(nil), document...)\n324|\t\t\t\tassessment, err := AssessCompatibility(document, reader)\n325|\t\t\t\tif reader == Version4 {\n326|\t\t\t\t\tif !errors.Is(err, ErrCompatibilityReader) {\n327|\t\t\t\t\t\tt.Fatalf(\"AssessCompatibility(%s, unimplemented reader %s) = %#v, %v; want reader refusal\", source, reader, assessment, err)\n328|\t\t\t\t\t}\n329|\t\t\t\t\tif !bytes.Equal(document, original) {\n330|\t\t\t\t\t\tt.Fatal(\"reader refusal mutated source bytes\")\n331|\t\t\t\t\t}\n332|\t\t\t\t\treturn\n333|\t\t\t\t}\n334|\t\t\t\tif err != nil {\n335|\t\t\t\t\tt.Fatalf(\"AssessCompatibility(%s document, %s reader) error = %v\", source, reader, err)\n336|\t\t\t\t}\n337|\t\t\t\tif assessment.Mode != want {\n338|\t\t\t\t\tt.Fatalf(\"AssessCompatibility(%s document, %s reader).Mode = %q, want %q\", source, reader, assessment.Mode, want)\n339|\t\t\t\t}\n340|\t\t\t\tif assessment.SourceVersion != source || assessment.ReaderVersion != reader {\n341|\t\t\t\t\tt.Fatalf(\"assessment envelope facts = %#v\", assessment)\n342|\t\t\t\t}\n343|\t\t\t\tif !bytes.Equal(document, original) {\n344|\t\t\t\t\tt.Fatal(\"compatibility assessment mutated the source bytes\")\n345|\t\t\t\t}\n346|\t\t\t})\n347|\t\t\tif reader == Version4 {\n348|\t\t\t\trefusedReaders++\n349|\t\t\t} else if majorVersionForTest(t, source) > majorVersionForTest(t, reader) {\n350|\t\t\t\treadOnlyPairs++\n351|\t\t\t} else {\n352|\t\t\t\tcompatiblePairs++\n353|\t\t\t}\n354|\t\t}\n355|\t}\n356|\t// Both branches must be exercised, so a gate that answered a single mode\n357|\t// for every pair cannot pass by covering only one side.\n358|\tif readOnlyPairs != 6 || compatiblePairs != 6 || refusedReaders != 4 {\n359|\t\tt.Fatalf(\"16 version pairs: read-only=%d compatible=%d refused-reader=%d; want 6/6/4\", readOnlyPairs, compatiblePairs, refusedReaders)\n360|\t}\n361|}\n362|\n363|// majorVersionForTest parses a major version without reusing the production\n364|// comparison the cross-product is meant to bound.\n365|func majorVersionForTest(t *testing.T, version string) uint64 {\n366|\tt.Helper()\n367|\tmajor, _, found := strings.Cut(version, \".\")\n368|\tif !found {\n369|\t\tt.Fatalf(\"pinned version %q is not dotted\", version)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d473","stream":{"kind":"session","id":"01a08929-2295-79c3-b516-94fb67387c85"},"sequence":2196,"recorded_at":1780531400004387,"record_type":"event","durability":"durable","causation_id":"d85af3b0-d1fc-4877-88c4-7da3d8622a21","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d85af3b0-d1fc-4877-88c4-7da3d8622a21","run_stream":{"kind":"run","id":"d85af3b0-d1fc-4877-88c4-7da3d8622a21"},"call_id":"call_01a08934e1487c93b8fcbd17d07a3aaf","text":"Read text file `internal/config/migration_refusal_test.go`.\n1|package config\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"errors\"\n6|\t\"io\"\n7|\t\"io/fs\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"testing\"\n11|\t\"time\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|)\n15|\n16|// TestMigrateRefusesEveryTargetOutsideTheUpgradeVocabulary drives the real\n17|// Migrate entry. The Version1 case isolates the non-upgrade-target clause: it\n18|// is a known configuration version, so no earlier disjunct can refuse it.\n19|func TestMigrateRefusesEveryTargetOutsideTheUpgradeVocabulary(t *testing.T) {\n20|\trefused := map[string]string{\n21|\t\t\"empty target\":                     \"\",\n22|\t\t\"unknown newer target\":             \"9.9.9\",\n23|\t\t\"adopted but unimplemented target\": Version4,\n24|\t\t\"unknown patch target\":             \"3.0.1\",\n25|\t\t\"non-semver target\":                \"v3\",\n26|\t\t\"known but not an upgrade target\":  Version1,\n27|\t}\n28|\tfor name, target := range refused {\n29|\t\tname, target := name, target\n30|\t\tt.Run(name, func(t *testing.T) {\n31|\t\t\tdirectory, filename, original := seedMigrationSource(t, Version2)\n32|\t\t\t_, err := Migrate(migrationInputs(directory, filename), nil, MigrationOptions{TargetVersion: target})\n33|\t\t\tif !errors.Is(err, ErrMigrationTarget) {\n34|\t\t\t\tt.Fatalf(\"Migrate(target=%q) error = %v, want ErrMigrationTarget\", target, err)\n35|\t\t\t}\n36|\t\t\tassertMigrationSourceUntouched(t, filename, original)\n37|\t\t\tassertNoMigrationArtifacts(t, directory, filename)\n38|\t\t})\n39|\t}\n40|\n41|\t// Positive control: the two accepted targets are not refused, so the gate\n42|\t// is a vocabulary and not a blanket rejection.\n43|\tfor _, target := range []string{Version2, CurrentVersion} {\n44|\t\tdirectory, filename, _ := seedMigrationSource(t, Version1)\n45|\t\tresult, err := Migrate(migrationInputs(directory, filename), nil, MigrationOptions{\n46|\t\t\tTargetVersion: target, GeneratedSummaryUpgradeChoice: \"local_only\",\n47|\t\t})\n48|\t\tif err != nil || !result.Changed {\n49|\t\t\tt.Fatalf(\"Migrate(target=%q) = %#v, %v\", target, result, err)\n50|\t\t}\n51|\t}\n52|}\n53|\n54|// TestMigrateRefusesAbsentSourceWithoutWriting covers the load-source guard on\n55|// an admissible but not-yet-created configuration path, which Load itself\n56|// accepts rather than refuses.\n57|func TestMigrateRefusesAbsentSourceWithoutWriting(t *testing.T) {\n58|\tdirectory := t.TempDir()\n59|\tfilename := filepath.Join(directory, \"config.toml\")\n60|\n61|\tsnapshot, err := Load(migrationInputs(directory, filename), nil)\n62|\tif err != nil || snapshot.ConfigPresent() {\n63|\t\tt.Fatalf(\"Load(absent source) = present %v, %v; the migration guard must be the only refusal\", snapshot.ConfigPresent(), err)\n64|\t}\n65|\t_, err = Migrate(migrationInputs(directory, filename), nil, MigrationOptions{TargetVersion: CurrentVersion})\n66|\tif !errors.Is(err, ErrMigrationSourceAbsent) {\n67|\t\tt.Fatalf(\"Migrate(absent source) error = %v, want ErrMigrationSourceAbsent\", err)\n68|\t}\n69|\tif _, statErr := os.Stat(filename); !errors.Is(statErr, fs.ErrNotExist) {\n70|\t\tt.Fatalf(\"Migrate(absent source) created the selected file: %v\", statErr)\n71|\t}\n72|\tassertNoMigrationArtifacts(t, directory, filename)\n73|}\n74|\n75|// TestMigrateRefusesDisclosureChoiceOutsideTheClosedVocabulary proves the\n76|// generated-summary gate in both directions at the production entry.\n77|func TestMigrateRefusesDisclosureChoiceOutsideTheClosedVocabulary(t *testing.T) {\n78|\trefused := map[string]string{\n79|\t\t\"absent choice\":       \"\",\n80|\t\t\"unlisted value\":      \"public\",\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
