, deterministic filters\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"element\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Board element the binding is resolved against\\\"},{\\\"name\\\":\\\"relation\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"default\\\":\\\"exact\\\",\\\"description\\\":\\\"Binding relation to the element\\\",\\\"enum\\\":[\\\"exact\\\",\\\"ancestors\\\",\\\"descendants\\\",\\\"any\\\"]},{\\\"name\\\":\\\"provider\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Provider lineage\\\",\\\"enum\\\":[\\\"codex\\\",\\\"claude\\\"]},{\\\"name\\\":\\\"role\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Producer role that published the snapshot\\\"},{\\\"name\\\":\\\"kind\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Output kind\\\",\\\"enum\\\":[\\\"project\\\",\\\"role\\\",\\\"task\\\"]},{\\\"name\\\":\\\"state\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Comma-separated lifecycle states\\\",\\\"enum\\\":[\\\"building\\\",\\\"ready\\\",\\\"stale\\\",\\\"retired\\\"]},{\\\"name\\\":\\\"skip\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"default\\\":0,\\\"description\\\":\\\"Records to skip\\\"},{\\\"name\\\":\\\"take\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"default\\\":20,\\\"description\\\":\\\"Maximum records to return\\\"}],\\\"examples\\\":[\\\"contexts(element=TASK-260728-abc123, relation=ancestors, role=developer, provider=codex, state=ready, skip=0, take=20) { selection }\\\",\\\"contexts(state=building) { identity lifecycle }\\\"]},\\\"count\\\":{\\\"description\\\":\\\"Count elements matching filters\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"type\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Filter by element type (epic, story, task, bug)\\\"},{\\\"name\\\":\\\"status\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"d