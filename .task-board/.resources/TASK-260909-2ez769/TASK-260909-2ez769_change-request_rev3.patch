+		t.Fatalf("key provenance = %q", target.KeyProvenance())
+	}
+	if _, err := peers.Resolve("unknown-host"); err == nil {
+		t.Fatal("Resolve(unknown) succeeded on a v4 mesh, want refusal")
+	}
+}
