    75	}
    76	
    77	// isLockExistsError reports a lost creation race: the lock file already
    78	// exists, so the caller must open it rather than publish over it.
    79	func isLockExistsError(err error) bool {
    80		return os.IsExist(err) || errors.Is(err, windows.ERROR_FILE_EXISTS) || errors.Is(err, windows.ERROR_ALREADY_EXISTS)
    81	}
    82	
    83	func openLockHandle(path string) (windows.Handle, error) {
    84		name, err := windows.UTF16PtrFromString(path)
    85		if err != nil {
    86			return 0, trustError(TrustError{Operation: "open lock", Err: errors.Join(ErrTrustStoreUnreadable, err)})
    87		}
    88		handle, err := windows.CreateFile(name, windows.GENERIC_READ|windows.GENERIC_WRITE,
    89			windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING,
    90			windows.FILE_ATTRIBUTE_NORMAL, 0)
    91		if err != nil {
    92			return 0, trustError(TrustError{Operation: "open lock", Err: errors.Join(ErrTrustStoreUnreadable, err)})
    93		}
    94		return handle, nil
    95	}
    96	
    97	func (lock *fileLock) shared() (func(), error) {
    98		handle, err := openLockHandle(lock.path)
    99		if err != nil {
   100			return nil, err
   101		}
   102		overlapped := new(windows.Overlapped)
   103		if err := windows.LockFileEx(handle, 0, 0, 1, 0, overlapped); err != nil {
   104			_ = windows.CloseHandle(handle)
   105			return nil, err
   106		}
   107		return func() {
   108			_ = windows.UnlockFileEx(handle, 0, 1, 0, overlapped)
   109			_ = windows.CloseHandle(handle)
   110		}, nil
   111	}
   112	
   113	func (lock *fileLock) exclusive() (func(), error) {
   114		handle, err := openLockHandle(lock.path)
   115		if err != nil {
   116			return nil, err
   117		}
   118		overlapped := new(windows.Overlapped)
   119		if err := windows.LockFileEx(handle, windows.LOCKFILE_EXCLUSIVE_LOCK, 0, 1, 0, overlapped); err != nil {
   120			_ = windows.CloseHandle(handle)
   121			return nil, err
   122		}
   123		return func() {
   124			_ = windows.UnlockFileEx(handle, 0, 1, 0, overlapped)
   125			_ = windows.CloseHandle(handle)
   126		}, nil
   127	}
