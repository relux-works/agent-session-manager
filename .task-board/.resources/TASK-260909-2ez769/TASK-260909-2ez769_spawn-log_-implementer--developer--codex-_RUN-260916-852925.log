+		close(release)
+		t.Fatal(err)
+	}
+	writeErr := other.WithExclusiveHold(func(hold hosttrust.HeldExclusive) error {
+		_, err := writeTempReplace(hold, osMigrationFileSystem{}, fixture.filename, []byte("foreign replacement\n"))
+		return err
+	})
+	close(release)
+	if err := <-holderDone; err != nil {
+		t.Fatalf("target holder error = %v", err)
+	}
