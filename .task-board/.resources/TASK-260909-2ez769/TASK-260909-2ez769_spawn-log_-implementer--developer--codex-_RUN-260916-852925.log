     2	
     3	import (
     4		"errors"
     5		"os"
     6		"path/filepath"
     7	)
     8	
     9	// Snapshot is one coherent committed read: trust bytes plus the generation
    10	// that authorized them. Streams and dispatches bind this generation; any use
    11	// must re-check currency before crossing a side-effect boundary.
    12	type Snapshot struct {
    13		Generation uint64
    14		Trust      TrustStore
    15	}
    16	
    17	// TransactionFunc mutates a copy of the committed trust. Returning nil
    18	// commits with generation+1; returning an error aborts with no durable effect.
    19	type TransactionFunc func(trust *TrustStore) error
    20	
    21	// ReadSnapshot obtains one coherent committed snapshot under a shared lock.
    22	// A missing store is ErrTrustStoreMissing, never an empty store. Unreadable,
    23	// malformed or partially read state refuses; leftover staging files from
    24	// crashed commits are ignored and never selected.
    25	func (store *Store) ReadSnapshot() (Snapshot, error) {
    26		return readSnapshot(store.fs, store.root, store.lock)
    27	}
    28	
    29	// WithSharedSnapshot runs fn under the authorization lock with the
    30	// committed trust, so a config-plus-trust pair observed inside fn is
    31	// coherent: no trust or config commit can land between the trust read and
    32	// fn's own reads. Pending joint intent converges before fn runs, so a
    33	// surviving process observes the same converged pair as a reopened store.
    34	// Callers must not acquire the lock again inside fn; internal reads there
    35	// use the supplied committed value directly.
    36	func (store *Store) WithSharedSnapshot(fn func(current TrustStore) error) error {
    37		unlock, err := lockForConvergedRead(store.fs, store.root, store.lock)
    38		if err != nil {
    39			return err
    40		}
    41		defer unlock()
    42		snapshot, err := readSnapshotLocked(store.fs, store.root)
    43		if err != nil {
    44			return err
    45		}
    46		committed := snapshot.Trust
    47		if fn == nil {
    48			return trustError(TrustError{Operation: "read snapshot", Err: ErrAuthorizationRefused})
    49		}
    50		return fn(committed)
    51	}
    52	
    53	func readSnapshot(filesystem FileSystem, root string, lock *fileLock) (Snapshot, error) {
    54		unlock, err := lockForConvergedRead(filesystem, root, lock)
    55		if err != nil {
    56			return Snapshot{}, err
    57		}
    58		defer unlock()
    59		return readSnapshotLocked(filesystem, root)
    60	}
    61	
    62	// lockForConvergedRead holds the authorization lock for one coherent read,
    63	// converging pending joint intent first. The fast path keeps the shared
    64	// lock when no marker is present: staging a marker needs the exclusive
    65	// lock, so absence observed under shared hold still holds at the read.
    66	// When a marker is present the shared lock is released before the
    67	// exclusive lock is acquired (a held shared lock can never upgrade in
    68	// place without risking a cross-process upgrade deadlock), the leftover
    69	// converges or refuses, and the read proceeds under the exclusive hold.
    70	// Convergence may move the generation forward; callers compare request
    71	// bindings against the converged read, never by refreshing a stale number.
    72	func lockForConvergedRead(filesystem FileSystem, root string, lock *fileLock) (func(), error) {
    73		unlock, err := lock.shared()
    74		if err != nil {
    75			return nil, trustError(TrustError{Operation: "lock snapshot", Err: errors.Join(ErrTrustStoreUnreadable, err)})
    76		}
    77		present, err := markerPresent(filesystem, root)
    78		if err != nil {
    79			unlock()
    80			return nil, err
    81		}
    82		if !present {
    83			return unlock, nil
    84		}
    85		unlock()
    86		hold, exclusiveUnlock, err := lock.exclusiveHold()
    87		if err != nil {
    88			return nil, trustError(TrustError{Operation: "lock snapshot", Err: errors.Join(ErrTrustStoreUnreadable, err)})
