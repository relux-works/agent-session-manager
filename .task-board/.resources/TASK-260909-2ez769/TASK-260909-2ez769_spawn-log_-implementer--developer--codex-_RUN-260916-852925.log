   358	}
   359	
   360	// replaceDurably publishes a byte-exact backup of the pre-migration
   361	// configuration document, then installs the replacement, under a live
   362	// exclusive authorization hold. A forged, absent or released hold refuses
   363	// before anything durable is written. Backup contents classification: the
   364	// backup is a copy of configuration bytes only (host and peer UUIDs,
   365	// names, endpoints, SSH arguments) and never carries private key
   366	// material, which lives exclusively under
   367	// STATE_DIR/host-channel/credentials/. The custody contract for backups is:
   368	// staged 0600 with group/world-clean verification (Unix owner-only), and
   369	// published names matched by hosttrust.ExcludedConfigDirName so every
   370	// replication, snapshot, clone or diagnostic surface must drop them. On
   371	// Windows the backup DACL inherits the user-profile ACL; that inheritance
   372	// is a stated bound, not owner-only evidence.
   373	func replaceDurably(hold hosttrust.HeldExclusive, filesystem migrationFileSystem, filename, backup string, original, replacement []byte) error {
   374		if err := requireHold(hold); err != nil {
   375			return err
   376		}
   377		directory := filepath.Dir(filename)
   378		// Re-inspect the selected file before anything durable is written. Load
   379		// resolved and validated it through the symlink-following read seam; this
   380		// mutating seam does not follow symlinks, so a selected file that is not
   381		// itself a regular file is refused here rather than after a backup has
   382		// already been published. A refused migration therefore leaves the
   383		// directory exactly as it found it, and the captured permission bits are
   384		// the ones the replacement inherits.
   385		info, err := filesystem.Stat(filename)
   386		if err != nil {
   387			return migrationError(MigrationError{Operation: "inspect source mode", Err: errors.Join(ErrMigrationWrite, err)})
   388		}
   389		if !info.Mode().IsRegular() {
   390			return migrationError(MigrationError{Operation: "inspect source mode", Err: errors.Join(ErrMigrationWrite, ErrConfigNotRegular)})
   391		}
   392		backupTemp, err := writeTempFile(filesystem, directory, ".ax-config-backup-*", original, 0o600)
   393		if err != nil {
   394			return migrationError(MigrationError{Operation: "write backup", Err: errors.Join(ErrMigrationBackup, err)})
   395		}
   396		if err := filesystem.Link(backupTemp, backup); err != nil {
   397			if !errors.Is(err, fs.ErrExist) {
   398				_ = filesystem.Remove(backupTemp)
   399				return migrationError(MigrationError{Operation: "publish backup", Err: errors.Join(ErrMigrationBackup, err)})
   400			}
   401			existing, readErr := filesystem.ReadFile(backup)
   402			info, statErr := filesystem.Stat(backup)
   403			if readErr != nil || statErr != nil || !bytes.Equal(existing, original) || info.Mode().Perm()&0o077 != 0 {
   404				_ = filesystem.Remove(backupTemp)
   405				return migrationError(MigrationError{Operation: "verify backup", Err: ErrMigrationBackup})
   406			}
   407		}
   408		if err := filesystem.Remove(backupTemp); err != nil && !errors.Is(err, fs.ErrNotExist) {
   409			return migrationError(MigrationError{Operation: "remove backup staging file", Err: errors.Join(ErrMigrationBackup, err)})
   410		}
   411		// Retry the directory sync even when an exact backup already exists: it may
   412		// be the visible result of an interrupted run whose directory fsync failed.
   413		if err := syncDirectory(filesystem, directory); err != nil {
   414			return migrationError(MigrationError{Operation: "sync backup directory", Err: errors.Join(ErrMigrationSync, err)})
   415		}
   416	
   417		replacementTemp, err := writeTempFile(filesystem, directory, ".ax-config-migrate-*", replacement, info.Mode().Perm())
   418		if err != nil {
   419			return migrationError(MigrationError{Operation: "write replacement", Err: errors.Join(ErrMigrationWrite, err)})
   420		}
   421		if err := filesystem.Rename(replacementTemp, filename); err != nil {
   422			_ = filesystem.Remove(replacementTemp)
   423			return migrationError(MigrationError{Operation: "replace source", Err: errors.Join(ErrMigrationReplace, err)})
   424		}
   425		if err := syncDirectory(filesystem, directory); err == nil {
   426			return nil
   427		} else {
   428			syncErr := err
   429			rollbackTemp, rollbackErr := writeTempFile(filesystem, directory, ".ax-config-rollback-*", original, info.Mode().Perm())
   430			if rollbackErr == nil {
   431				rollbackErr = filesystem.Rename(rollbackTemp, filename)
   432			}
   433			if rollbackErr == nil {
   434				rollbackErr = syncDirectory(filesystem, directory)
   435			}
   436			if rollbackErr != nil {
   437				if rollbackTemp != "" {
   438					_ = filesystem.Remove(rollbackTemp)
   439				}
   440				return migrationError(MigrationError{Operation: "recover source after sync", Err: errors.Join(ErrMigrationSync, ErrMigrationRecovery, syncErr, rollbackErr)})
   441			}
   442			return migrationError(MigrationError{Operation: "sync replacement directory", Err: errors.Join(ErrMigrationSync, syncErr)})
   443		}
   444	}
   445	
   446	func writeTempFile(filesystem migrationFileSystem, directory, pattern string, document []byte, mode fs.FileMode) (name string, err error) {
   447		file, err := filesystem.CreateTemp(directory, pattern)
   448		if err != nil {
   449			return "", err
   450		}
   451		name = file.Name()
   452		clean := func(cause error) (string, error) {
   453			_ = file.Close()
   454			_ = filesystem.Remove(name)
   455			return "", cause
   456		}
   457		if err := file.Chmod(mode); err != nil {
   458			return clean(err)
   459		}
   460		if err := writeAll(file, document); err != nil {
   461			return clean(err)
   462		}
   463		if err := file.Sync(); err != nil {
   464			return clean(err)
   465		}
   466		if err := file.Close(); err != nil {
   467			_ = filesystem.Remove(name)
   468			return "", err
   469		}
   470		return name, nil
   471	}
   472	
   473	func writeAll(writer io.Writer, document []byte) error {
   474		for len(document) > 0 {
   475			written, err := writer.Write(document)
   476			if err != nil {
   477				return err
   478			}
   479			if written == 0 {
   480				return io.ErrShortWrite
   481			}
   482			document = document[written:]
   483		}
   484		return nil
   485	}
   486	
   487	func syncDirectory(filesystem migrationFileSystem, directory string) error {
   488		handle, err := filesystem.OpenDirectory(directory)
   489		if err != nil {
   490			return err
   491		}
   492		if err := handle.Sync(); err != nil {
   493			_ = handle.Close()
   494			return err
   495		}
   496		return handle.Close()
   497	}
   498	
   499	// Indirections keep compatibility-envelope parsing in this file while using
   500	// the same TOML implementation as Decode.
   501	var tomlDecode = func(document []byte, destination any) error {
   502		return toml.Unmarshal(document, destination)
   503	}
   504	
   505	// migrationError is the only construction site for *MigrationError, for the
   506	// same reason loaderError is the only construction site for *Error.
   507	var migrationError = func(value MigrationError) error {
   508		return &value
   509	}

