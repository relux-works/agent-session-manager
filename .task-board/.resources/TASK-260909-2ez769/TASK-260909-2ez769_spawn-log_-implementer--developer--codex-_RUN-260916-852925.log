+			t.Fatal(err)
+		}
+		if err := censusGenericWitness(path, []byte("generic replacement")); err != nil {
+			t.Fatal(err)
+		}
+		got, err := os.ReadFile(path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if string(got) != "generic replacement" {
+			t.Fatalf("function-value witness installed %q, want generic replacement", got)
+		}
+	})
