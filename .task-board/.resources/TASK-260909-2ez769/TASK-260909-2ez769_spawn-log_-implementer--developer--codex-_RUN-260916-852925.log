    60	BOUNDS = {
    61	 "neutral": "Equivalent arithmetic; no independent kill claimed.",
    62	}
    63	
    64	def main():
    65	    parser = argparse.ArgumentParser(description=__doc__)
    66	    parser.add_argument("--output", required=True)
    67	    parser.add_argument("--only", help="Comma-separated probe names for a bounded follow-up")
    68	    opts = parser.parse_args()
    69	    if opts.only and not set(opts.only.split(",")).issubset({p[0] for p in PROBES}):
    70	        parser.error("--only contains an unknown probe")
    71	    out = Path(opts.output).resolve()
    72	    out.mkdir(parents=True, exist_ok=True)
    73	    results = []
    74	    unexpected = False
    75	    for name, path, old, new, narrows, expected_test in PROBES:
    76	        if opts.only and name not in opts.only.split(","):
    77	            continue
    78	        source = ROOT / path
    79	        original = source.read_bytes()
    80	        text = original.decode()
    81	        if text.count(old) != 1:
    82	            raise RuntimeError(f"{name}: plant must match exactly once, got {text.count(old)}")
    83	        folder = out / name
    84	        folder.mkdir(exist_ok=True)
    85	        replacement = folder / source.name
    86	        replacement.write_text(text.replace(old, new, 1))
    87	        overlay = folder / "overlay.json"
    88	        overlay.write_text(json.dumps({"Replace": {str(source): str(replacement)}}))
    89	        command = ["go", "test", "-overlay", str(overlay), "./internal/hosttrust", "-count=1", "-json", "-timeout=120s", "-run", TESTS]
    90	        proc = subprocess.run(command, cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=300)
    91	        (folder / "test.log").write_bytes(proc.stdout)
    92	        events = []
    93	        for line in proc.stdout.decode(errors="replace").splitlines():
    94	            try:
    95	                events.append(json.loads(line))
    96	            except json.JSONDecodeError:
    97	                pass
    98	        failed = [e["Test"] for e in events if e.get("Action") == "fail" and "Test" in e]
    99	        passed = [e["Test"] for e in events if e.get("Action") == "pass" and "Test" in e]
   100	        killed = proc.returncode != 0 and bool(failed) and (expected_test is None or expected_test in failed)
   101	        if name == "neutral":
   102	            valid = proc.returncode == 0 and bool(passed)
   103	            state = "neutral passed" if valid else "invalid control"
   104	        elif name in BOUNDS:
   105	            valid = proc.returncode == 0 and bool(passed)
   106	            state = "survived" if valid else "unexpected result"
   107	        else:
   108	            valid = killed
   109	            state = "killed" if killed else "survived" if proc.returncode == 0 and passed else "invalid instrument/compile failure"
   110	        if not valid:
   111	            unexpected = True
   112	        if source.read_bytes() != original:
   113	            raise RuntimeError(f"{name}: source changed during overlay run")
   114	        row = {"mutant": name, "narrowing": narrows, "exit_code": proc.returncode, "result": state,
   115	               "named_failing_tests": failed, "expected_test": expected_test,
   116	               "bound": BOUNDS.get(name, "" if killed or name == "neutral" else "No named failing test established; this gate member is unproven."),
   117	               "command": command}
   118	        results.append(row)
   119	        print(f"{name}: {state}, exit={proc.returncode}, tests={','.join(failed)}", flush=True)
   120	        (out / "results.json").write_text(json.dumps(results, indent=2) + "\n")
   121	    rows = ["| Mutant | What the gate is narrowed to admit | Named failing test | Exit | Result / surviving bound |",
   122	            "| --- | --- | --- | ---: | --- |"]
   123	    for r in results:
   124	        tests = r["expected_test"] if r["expected_test"] in r["named_failing_tests"] else ", ".join(r["named_failing_tests"])
   125	        rows.append(f'| {r["mutant"]} | {r["narrowing"]} | {tests or "none"} | {r["exit_code"]} | {r["result"]}: {r["bound"]} |')
   126	    (out / "table.md").write_text("\n".join(rows)+"\n")
   127	    return int(unexpected)
   128	
   129	
   130	if __name__ == "__main__":
   131	    sys.exit(main())

