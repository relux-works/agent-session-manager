     8	
     9		"github.com/relux-works/agent-session-manager/internal/scalar"
    10	)
    11	
    12	const (
    13		// TrustSchemaID is the exact Host Trust Store schema identity.
    14		TrustSchemaID = "urn:ax:schema:host-trust-store"
    15		// TrustSchemaVersion is the only accepted trust store version.
    16		TrustSchemaVersion = "1.0.0"
    17		// MaxGeneration is the uint53 ceiling. A committed store at this
    18		// generation refuses every further mutation.
    19		MaxGeneration = uint64(1<<53 - 1)
    20		// MaxEntries bounds CredentialEntry[0..4096].
    21		MaxEntries = 4096
    22		// MaxDERBytes bounds each decoded leaf_der/root_der payload.
    23		MaxDERBytes = 16384
    24	)
    25	
    26	const (
    27		// EntryActive admits the credential for new streams.
    28		EntryActive = "active"
    29		// EntryRetiring admits only pre-rotation streams until retire_at.
    30		EntryRetiring = "retiring"
    31		// EntryRevoked forbids all future admissions. Public bytes are retained
    32		// permanently as a reuse tombstone.
    33		EntryRevoked = "revoked"
    34	)
    35	
    36	// CredentialEntry is one enrolled credential. retire_at is non-null exactly
    37	// for retiring entries and later than enrolled_at.
    38	type CredentialEntry struct {
    39		HostID       scalar.UUIDv7
    40		CredentialID scalar.Digest
    41		SPKIID       scalar.Digest
    42		RootID       scalar.Digest
    43		LeafDER      []byte
    44		RootDER      []byte
    45		State        string
    46		EnrolledAt   scalar.Timestamp
    47		RetireAt     *scalar.Timestamp
    48	}
    49	
    50	// TrustStore is the decoded Host Trust Store 1.0.0 document. Generation is
    51	// greater than zero and increments by one per committed trust/config
    52	// authorization change.
    53	type TrustStore struct {
    54		Generation uint64
    55		Entries    []CredentialEntry
    56	}
    57	
    58	// Formatting a store or entry must never expose digests, UUIDs, DER bytes or
    59	// timestamps: custody material never enters logs, snapshots or diagnostics.
    60	func (TrustStore) String() string                    { return "host trust store" }
    61	func (TrustStore) GoString() string                  { return "host trust store" }
    62	func (TrustStore) Format(state fmt.State, verb rune) { _, _ = state.Write([]byte("host trust store")) }
    63	
    64	func (CredentialEntry) String() string   { return "host trust credential entry" }
    65	func (CredentialEntry) GoString() string { return "host trust credential entry" }
    66	func (CredentialEntry) Format(state fmt.State, verb rune) {
    67		_, _ = state.Write([]byte("host trust credential entry"))
    68	}
    69	
    70	// DecodeTrust is the exact closed Host Trust Store 1.0.0 reader. Unknown,
    71	// missing, duplicate-key, malformed, partial or downgraded state is refused,
    72	// never read as an empty store and never given legacy meaning.
    73	func DecodeTrust(document []byte) (TrustStore, error) {
    74		if err := rejectDuplicateKeys(document); err != nil {
    75			return TrustStore{}, err
    76		}
    77		var shape map[string]json.RawMessage
    78		decoder := json.NewDecoder(bytes.NewReader(document))
    79		if err := decoder.Decode(&shape); err != nil {
    80			return TrustStore{}, trustError(TrustError{Operation: "decode document", Err: errors.Join(ErrTrustDecode, err)})
    81		}
    82		if decoder.More() {
    83			return TrustStore{}, trustError(TrustError{Operation: "decode document", Err: ErrTrustDecode})
    84		}
    85		for key := range shape {
    86			switch key {
    87			case "schema", "schema_version", "generation", "entries":
    88			default:
    89				return TrustStore{}, trustError(TrustError{Operation: "decode document", Err: errors.Join(ErrTrustValidation, fmt.Errorf("unknown field"))})
    90			}
    91		}
    92		var schema, version string
    93		if err := decodeExactString(shape, "schema", &schema); err != nil {
    94			return TrustStore{}, err
    95		}
    96		if schema != TrustSchemaID {
    97			return TrustStore{}, trustError(TrustError{Operation: "decode schema", Err: ErrTrustValidation})
    98		}
    99		if err := decodeExactString(shape, "schema_version", &version); err != nil {
   100			return TrustStore{}, err
   101		}
   102		if version != TrustSchemaVersion {
   103			return TrustStore{}, trustError(TrustError{Operation: "decode schema version", Err: ErrTrustValidation})
   104		}
   105		generation, err := decodeGeneration(shape)
   106		if err != nil {
   107			return TrustStore{}, err
   108		}
   109		entries, err := decodeEntries(shape)
   110		if err != nil {
   111			return TrustStore{}, err
   112		}
   113		store := TrustStore{Generation: generation, Entries: entries}
   114		if err := checkSortedUnique(store.Entries); err != nil {
   115			return TrustStore{}, err
   116		}
   117		if err := checkMappingUnique(store.Entries); err != nil {
   118			return TrustStore{}, err
   119		}
   120		return store, nil
   121	}
   122	
   123	// checkMappingUnique enforces the cross-entry rules at read time, across all
   124	// entries including revoked tombstones: a leaf, leaf public key or root must
   125	// never map twice, even for the same host UUID. Identical leaf bytes imply an
   126	// identical credential_id, which the ordering check already refuses, so the
   127	// leaf member needs no separate comparison here.
   128	func checkMappingUnique(entries []CredentialEntry) error {
   129		keys := make(map[string]struct{}, len(entries))
   130		roots := make(map[string]struct{}, len(entries))
   131		for _, entry := range entries {
   132			if _, duplicate := keys[entry.SPKIID.String()]; duplicate {
   133				return trustError(TrustError{Operation: "decode entries", Err: ErrTrustValidation})
   134			}
   135			keys[entry.SPKIID.String()] = struct{}{}
   136			if _, duplicate := roots[entry.RootID.String()]; duplicate {
   137				return trustError(TrustError{Operation: "decode entries", Err: ErrTrustValidation})
   138			}
   139			roots[entry.RootID.String()] = struct{}{}
   140		}
   141		return nil
   142	}
