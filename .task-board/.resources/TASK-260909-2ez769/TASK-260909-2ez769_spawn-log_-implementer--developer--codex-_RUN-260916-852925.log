   109	func TestPreviewV4HappyPath(t *testing.T) {
   110		fixture := setupV4Fixture(t, testPeerID)
   111		preview, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now)
   112		if err != nil {
   113			t.Fatalf("PreviewV4 error = %v", err)
   114		}
   115		if preview.SourceVersion != CurrentVersion || preview.CredentialID != fixture.self {
   116			t.Fatalf("preview identity = %+v", preview.SourceVersion)
   117		}
   118		if len(preview.RetainedPeers) != 1 || preview.RetainedPeers[0] != testPeerID {
   119			t.Fatalf("retained peers = %v", preview.RetainedPeers)
   120		}
   121		if len(preview.DroppedPeers) != 0 || len(preview.BlockingPeers) != 0 {
   122			t.Fatalf("dropped = %v blocking = %v, want empty", preview.DroppedPeers, preview.BlockingPeers)
   123		}
   124		loaded, err := Decode(preview.Replacement, DecodeContext{RuntimePlatform: scalar.PlatformMacOS})
   125		if err != nil {
   126			t.Fatalf("Decode(preview) error = %v", err)
   127		}
   128		if loaded.SourceVersion != Version4 || loaded.Value.Mesh.Transport != TransportSSHTLS13 {
   129			t.Fatalf("preview decodes as %q/%q, want 4.0.0/ssh_tls13", loaded.SourceVersion, loaded.Value.Mesh.Transport)
   130		}
   131		if loaded.Value.Mesh.HostChannel == nil || loaded.Value.Mesh.HostChannel.CredentialID != fixture.self {
   132			t.Fatalf("preview host_channel = %+v", loaded.Value.Mesh.HostChannel)
   133		}
   134		if len(loaded.Value.Mesh.Peers) != 1 || loaded.Value.HostName != "fixture-host" {
   135			t.Fatal("preview dropped retained Config-3 fields")
   136		}
   137		current, err := os.ReadFile(fixture.filename)
   138		if err != nil {
   139			t.Fatal(err)
   140		}
   141		if !bytes.Equal(preview.SourceDocument, current) {
   142			t.Fatal("preview source does not pin the current bytes")
   143		}
   144	}
