   537	// censusExprViolations judges one package-level initializer expression:
   538	// a bare gated helper there escapes, and a call there is judged by the
   539	// call rule against the variable name.
   540	func censusExprViolations(fileset *token.FileSet, expression ast.Expr, name string, aliases map[string]string) []string {
   541		var violations []string
   542		if call, ok := expression.(*ast.CallExpr); ok {
   543			if violation := censusCallViolation(fileset, call, []ast.Node{expression}, name, aliases); violation != "" {
   544				violations = append(violations, violation)
   545			}
   546			return violations
   547		}
   548		if _, ok := expression.(*ast.FuncLit); !ok {
   549			if violation := censusEscapeViolation(fileset, expression, name, aliases, "package initializer"); violation != "" {
   550				violations = append(violations, violation)
   551			}
   552		}
   553		return violations
   554	}
