    13	// CoherentSnapshot is one coherent configuration-plus-trust read: the
    14	// trust generation and the configuration document observed under the same
    15	// shared authorization hold, so no trust or config commit can land between
    16	// them. Streams and dispatches bind Generation; any use must re-check
    17	// currency before crossing a side-effect boundary.
    18	type CoherentSnapshot struct {
    19		Config     Snapshot
    20		Trust      hosttrust.TrustStore
    21		Generation uint64
    22	}
    23	
    24	// LoadCoherent is the production pairing for readers that must never mix an
    25	// old allowlist with new credentials (Section 11.10.3): it holds the
    26	// authorization lock across the committed trust read and the configuration
    27	// load, converging pending joint intent first so a surviving reader
    28	// observes the same pair as a reopened store. PreviewV4 callers that hold
    29	// only a separately read trust snapshot should obtain the pair here
    30	// instead.
    31	func LoadCoherent(inputs Inputs, overrides Overrides, store *hosttrust.Store) (CoherentSnapshot, error) {
    32		var coherent CoherentSnapshot
    33		if store == nil {
    34			return CoherentSnapshot{}, migrationError(MigrationError{Operation: "load coherent snapshot", Err: hosttrust.ErrTrustStoreMissing})
    35		}
    36		if err := store.WithSharedSnapshot(func(current hosttrust.TrustStore) error {
    37			snapshot, err := Load(inputs, overrides)
    38			if err != nil {
    39				return err
    40			}
    41			coherent = CoherentSnapshot{Config: snapshot, Trust: current, Generation: current.Generation}
    42			return nil
    43		}); err != nil {
    44			return CoherentSnapshot{}, err
    45		}
    46		return coherent, nil
    47	}
