+	}
+	canonical, err := absoluteClean(path)
+	if err != nil || held.configPath == "" || held.configPath != canonical {
+		return trustError(TrustError{Operation: "require configuration hold resource", Err: ErrExclusiveHoldResourceMismatch})
+	}
