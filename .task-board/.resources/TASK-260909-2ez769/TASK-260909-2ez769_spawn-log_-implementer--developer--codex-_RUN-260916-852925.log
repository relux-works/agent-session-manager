   100		}()
   101		select {
   102		case <-entered:
   103		case <-time.After(10 * time.Second):
   104			t.Fatal("hold boundary did not start")
   105		}
   106		revoked := make(chan error, 1)
   107		go func() { revoked <- store.Revoke(credential) }()
   108		select {
   109		case err := <-revoked:
   110			t.Fatalf("revocation completed while the exclusive hold was live: err=%v", err)
   111		case <-time.After(250 * time.Millisecond):
   112		}
   113		close(release)
   114		if err := <-holderDone; err != nil {
   115			t.Fatal(err)
   116		}
   117		select {
   118		case err := <-revoked:
   119			if err != nil {
   120				t.Fatal(err)
   121			}
   122		case <-time.After(10 * time.Second):
   123			t.Fatal("revocation did not complete after the hold released")
   124		}
   125	}
   126	
   127	// WithExclusiveHold converges leftover joint intent before running its
   128	// boundary, so a legacy migration coordinated through it never builds
   129	// beside an unresolved marker.
   130	func TestWithExclusiveHoldConvergesLeftover(t *testing.T) {
   131		source := []byte("source configuration\n")
   132		replacement := []byte("replacement configuration\n")
   133		store, configPath, snapshot := jointFixture(t, source, replacement)
   134		stageJointMarker(t, store, jointMarker(configPath, source, replacement, snapshot.Generation))
   135		called := false
   136		if err := store.WithExclusiveHold(func(HeldExclusive) error {
   137			called = true
   138			return nil
   139		}); err != nil {
   140			t.Fatal(err)
   141		}
   142		if !called {
   143			t.Fatal("WithExclusiveHold did not run its boundary")
   144		}
   145		assertMarkerGone(t, store)
   146	}
   147	
   148	// resolveFailedReplace must not discard intent when the replacement is
   149	// durable despite the reported failure: the marker is kept (the restore
   150	// fails here) and a surviving reader converges forward instead of
   151	// admitting the replacement at the old generation. The
   152	// resolve-source-skip narrowing plant treats durable replacement as
   153	// intact; it is killed here because the marker is then gone and the
   154	// surviving read admits the old generation.
   155	func TestResolveFailedReplaceKeepsMarker(t *testing.T) {
   156		source := []byte("source configuration\n")
   157		replacement := []byte("replacement configuration\n")
   158		store, configPath, snapshot := jointFixture(t, source, replacement)
   159		marker := jointMarker(configPath, source, replacement, snapshot.Generation)
   160		restoreErr := errors.New("injected restore failure")
   161		_, err := store.JointCommit(marker,
   162			func(TrustStore) error { return nil },
   163			func(HeldExclusive) error {
   164				if err := os.WriteFile(configPath, replacement, 0o600); err != nil {
   165					return err
   166				}
   167				return errors.New("injected replace failure after durable rename")
   168			},
   169			func(HeldExclusive) error { return restoreErr })
   170		if !errors.Is(err, ErrJointCompensationFailed) {
   171			t.Fatalf("JointCommit err = %v, want %v", err, ErrJointCompensationFailed)
   172		}
   173		assertMarkerKept(t, store)
   174		converged, err := store.ReadSnapshot()
   175		if err != nil {
   176			t.Fatalf("surviving ReadSnapshot err = %v, want forward convergence", err)
   177		}
   178		if converged.Generation != snapshot.Generation+1 {
   179			t.Fatalf("surviving generation = %d, want %d", converged.Generation, snapshot.Generation+1)
   180		}
   181		assertMarkerGone(t, store)
   182		installed, err := os.ReadFile(configPath)
   183		if err != nil {
   184			t.Fatal(err)
   185		}
   186		if string(installed) != string(replacement) {
   187			t.Fatal("converged pair does not carry the durable replacement")
   188		}
   189	}

