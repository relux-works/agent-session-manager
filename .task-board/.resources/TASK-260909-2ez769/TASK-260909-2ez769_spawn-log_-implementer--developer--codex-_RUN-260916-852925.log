+func (held HeldExclusive) ValidateConfigPath(path string) error {
+	if err := requireHold(held); err != nil {
+		return err
+	}
+	canonical, err := absoluteClean(path)
+	if err != nil || held.configPath == "" || held.configPath != canonical {
