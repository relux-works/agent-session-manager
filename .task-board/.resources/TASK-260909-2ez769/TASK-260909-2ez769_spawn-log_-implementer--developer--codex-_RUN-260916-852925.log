    93	// CompatibilityMode is deliberately narrower than runtime capability state.
    94	type CompatibilityMode string
    95	
    96	const (
    97		CompatibilityCompatible CompatibilityMode = "compatible"
    98		CompatibilityReadOnly   CompatibilityMode = "read-only-diagnostic"
    99	)
   100	
   101	// CompatibilityAssessment contains only envelope facts needed to prevent a
   102	// downgraded writer. It exposes no decoded Configuration and performs no I/O.
   103	type CompatibilityAssessment struct {
   104		ReaderVersion string
   105		SourceVersion string
   106		Mode          CompatibilityMode
   107	}
   108	
   109	// AssessCompatibility determines whether a known reader may open the document
   110	// normally or must remain read-only. Newer documents are not decoded or
   111	// rewritten, so fields unknown to the older reader remain untouched.
   112	func AssessCompatibility(document []byte, readerVersion string) (CompatibilityAssessment, error) {
   113		reader, ok := knownConfigVersion(readerVersion)
   114		if !ok {
   115			return CompatibilityAssessment{}, migrationError(MigrationError{Operation: "assess reader", Err: ErrCompatibilityReader})
   116		}
   117		var envelope rawEnvelope
   118		if err := decodeEnvelope(document, &envelope); err != nil {
   119			return CompatibilityAssessment{}, err
   120		}
   121		if envelope.Schema != SchemaID {
   122			return CompatibilityAssessment{}, configError("schema", ErrConfigValidation)
   123		}
   124		source, err := parseSemverCore(envelope.SchemaVersion)
   125		if err != nil {
   126			return CompatibilityAssessment{}, configError("schema_version", errors.Join(ErrCompatibilityAssessment, err))
   127		}
   128		mode := CompatibilityCompatible
   129		if compareSemver(source, reader) > 0 {
   130			mode = CompatibilityReadOnly
   131		} else if _, known := knownConfigVersion(envelope.SchemaVersion); !known {
   132			return CompatibilityAssessment{}, configError("schema_version", ErrUnsupportedConfigVersion)
   133		}
   134		return CompatibilityAssessment{ReaderVersion: readerVersion, SourceVersion: envelope.SchemaVersion, Mode: mode}, nil
   135	}
   136	
   137	type semverCore struct{ major, minor, patch uint64 }
   138	
   139	func knownConfigVersion(value string) (semverCore, bool) {
   140		switch value {
   141		case Version1, Version2, CurrentVersion, Version4:
   142			parsed, _ := parseSemverCore(value)
   143			return parsed, true
   144		default:
   145			return semverCore{}, false
   146		}
   147	}
   148	
   149	func parseSemverCore(value string) (semverCore, error) {
   150		parts := strings.Split(value, ".")
   151		if len(parts) != 3 {
   152			return semverCore{}, ErrUnsupportedConfigVersion
   153		}
   154		values := make([]uint64, 3)
   155		for index, part := range parts {
   156			if part == "" || (len(part) > 1 && part[0] == '0') {
   157				return semverCore{}, ErrUnsupportedConfigVersion
   158			}
   159			parsed, err := strconv.ParseUint(part, 10, 64)
   160			if err != nil {
   161				return semverCore{}, ErrUnsupportedConfigVersion
   162			}
   163			values[index] = parsed
   164		}
   165		return semverCore{major: values[0], minor: values[1], patch: values[2]}, nil
   166	}
   167	
   168	func compareSemver(left, right semverCore) int {
   169		if left.major != right.major {
   170			if left.major < right.major {
   171				return -1
   172			}
   173			return 1
   174		}
   175		if left.minor != right.minor {
   176			if left.minor < right.minor {
   177				return -1
   178			}
   179			return 1
   180		}
   181		if left.patch != right.patch {
   182			if left.patch < right.patch {
   183				return -1
   184			}
   185			return 1
   186		}
   187		return 0
   188	}
   189	
   190	func decodeEnvelope(document []byte, envelope *rawEnvelope) error {
   191		if err := tomlDecode(document, envelope); err != nil {
   192			return configError("TOML", errors.Join(ErrConfigDecode, err))
   193		}
   194		return nil
   195	}
   196	
   197	func migrate(inputs Inputs, overrides Overrides, options MigrationOptions, filesystem migrationFileSystem) (MigrationResult, error) {
   198		target, targetKnown := knownConfigVersion(options.TargetVersion)
   199		if !targetKnown || options.TargetVersion == Version1 {
   200			return MigrationResult{}, migrationError(MigrationError{Operation: "select target", Err: ErrMigrationTarget})
   201		}
   202		if options.TargetVersion == Version4 {
   203			return MigrationResult{}, migrationError(MigrationError{Operation: "select target", Err: ErrMigrationV4Explicit})
   204		}
   205		snapshot, err := Load(inputs, overrides)
   206		if err != nil {
   207			return MigrationResult{}, err
   208		}
   209		loaded, decoded := snapshot.Configuration()
   210		if !snapshot.ConfigPresent() || !decoded {
   211			return MigrationResult{}, migrationError(MigrationError{Operation: "load source", Err: ErrMigrationSourceAbsent})
   212		}
   213		source, _ := knownConfigVersion(loaded.SourceVersion)
   214		result := MigrationResult{SourceVersion: loaded.SourceVersion, TargetVersion: options.TargetVersion}
   215		if compareSemver(source, target) > 0 {
   216			return result, migrationError(MigrationError{Operation: "select target", Err: ErrMigrationDowngrade})
   217		}
   218		if compareSemver(source, target) == 0 {
   219			return result, nil
   220		}
   221		if loaded.SourceVersion == Version1 {
   222			if !oneOf(options.GeneratedSummaryUpgradeChoice, "local_only", "mesh_sanitized", "reference_only") {
   223				return result, migrationError(MigrationError{Operation: "validate disclosure choice", Err: ErrMigrationChoiceRequired})
   224			}
   225			loaded.Value.Directory.GeneratedSummaryUpgradeChoice = options.GeneratedSummaryUpgradeChoice
   226		}
   227		context := DecodeContext{RuntimePlatform: inputs.Platform, BackendSettings: inputs.BackendSettings}
   228		var replacement []byte
   229		switch options.TargetVersion {
   230		case Version2:
   231			replacement, err = encodeVersion2(loaded.Value, context)
   232		case CurrentVersion:
   233			replacement, err = EncodeCurrent(loaded.Value, context)
   234		}
   235		if err != nil {
   236			return result, migrationError(MigrationError{Operation: "encode target", Err: err}) // config-refusal-subsumed: every encoder refusal below this propagation is pinned on its own clause, at writer.go terminal.backend and writer.go v2 wire TOML for the v2 encoder, at writer.go v2 re-read for its defence-in-depth round trip, and by the EncodeCurrent validation suite for v3
   237		}
   238		selected, _ := snapshot.Paths().Path(ConfigFile)
   239		filename := selected.Value.String()
   240		backup := filename + ".bak." + loaded.SourceVersion
   241		result.BackupPath = backup
   242		// A successful Load always resolves the state directory, so the
   243		// coordinating store always exists: opening it converges interrupted
   244		// joint intent and creates the owner-only skeleton when absent.
   245		store, err := openLegacyStore(stateDirOf(snapshot))
   246		if err != nil {
   247			return result, err
   248		}
   249		// The durable replacement runs inside the shared authorization
   250		// transaction: the exclusive hold serializes this writer with joint
   251		// commits and other legacy migrations, and the source revalidation
   252		// under the hold refuses a delayed write whose source already moved
   253		// (including a completed Configuration 4.0.0 commit).
   254		if err := store.WithExclusiveHold(func(hold hosttrust.HeldExclusive) error {
   255			if err := revalidateLegacySource(inputs, overrides, snapshot); err != nil {
   256				return err
   257			}
   258			return replaceDurably(hold, filesystem, filename, backup, snapshot.Document(), replacement)
   259		}); err != nil {
   260			return result, err
   261		}
   262		result.Changed = true
   263		return result, nil
   264	}
   265	
   266	// openLegacyStore opens the machine-local store coordinating one legacy
   267	// migration with joint commits. Opening converges interrupted joint
   268	// intent and creates the owner-only store skeleton when absent; a store
   269	// that cannot open (unsafe custody, unresolvable intent) fails the
   270	// migration closed instead of writing beside unknown authority.
   271	func openLegacyStore(stateDir string) (*hosttrust.Store, error) {
   272		store, err := hosttrust.Open(stateDir)
   273		if err != nil {
   274			return nil, migrationError(MigrationError{Operation: "open trust store", Err: err})
   275		}
   276		return store, nil
   277	}
   278	
   279	// revalidateLegacySource repeats the selected source pins inside the
   280	// authorization transaction: the current document must still carry the
   281	// selected version and byte-exact bytes. It runs under the exclusive
   282	// hold, so no trust or config commit can land between this revalidation
   283	// and the replacement it guards.
   284	func revalidateLegacySource(inputs Inputs, overrides Overrides, snapshot Snapshot) error {
   285		current, err := Load(inputs, overrides)
   286		if err != nil {
   287			return err
   288		}
   289		currentLoaded, decoded := current.Configuration()
   290		if !current.ConfigPresent() || !decoded {
   291			return migrationError(MigrationError{Operation: "revalidate source", Err: ErrMigrationSourceAbsent})
   292		}
   293		loaded, _ := snapshot.Configuration()
   294		if currentLoaded.SourceVersion != loaded.SourceVersion {
   295			return migrationError(MigrationError{Operation: "revalidate source", Err: ErrMigrationStaleSource})
   296		}
   297		if !bytes.Equal(current.Document(), snapshot.Document()) {
   298			return migrationError(MigrationError{Operation: "revalidate source", Err: ErrMigrationStaleSource})
   299		}
   300		return nil
   301	}
   302	
   303	// requireHold refuses a pair mutation attempted without a live exclusive
   304	// authorization hold. The hold itself is constructed only by the lock
   305	// acquisition path; this package can pass it along but never forge one.
   306	func requireHold(hold hosttrust.HeldExclusive) error {
   307		if !hold.Valid() {
   308			return migrationError(MigrationError{Operation: "require exclusive hold", Err: hosttrust.ErrExclusiveHoldRequired})
   309		}
   310		return nil
   311	}
