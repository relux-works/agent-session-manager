    13	PREVIEW = "internal/config/migration_v4.go"
    14	TESTS = "Test"
    15	PROBES = [
    16	 ("neutral", PREVIEW, "SourceGeneration: trust.Generation,", "SourceGeneration: trust.Generation + 0,", "Equivalent generation pin", None),
    17	 ("transport-ssh", VALIDATION, "if mesh.Transport != TransportSSHTLS13 {", "if mesh.Transport != TransportSSHTLS13 && mesh.Transport != TransportSSH {", "Admits exactly the legacy ssh transport as v4", "TestDecodeConfiguration4Refusals/legacy_transport"),
    18	 ("preview-length", APPLY, 'if !bytes.Equal(rendered.Replacement, preview.Replacement) {\n\t\treturn migrationError(MigrationError{Operation: "validate preview bytes", Err: ErrMigrationV4PreviewMismatch})', 'if len(rendered.Replacement) != len(preview.Replacement) {\n\t\treturn migrationError(MigrationError{Operation: "validate preview bytes", Err: ErrMigrationV4PreviewMismatch})', "Admits same-length tampered previews at the in-lock revalidation", "TestRevalidateApplyV4PreviewMismatch"),
    19	 ("confirm-drops", APPLY, "if !confirm {", "if !confirm && len(preview.DroppedPeers) == 0 {", "Admits exactly unconfirmed previews that drop peers", "TestApplyV4ConfirmRequiredWithDrops"),
    20	 ("apply-gen-direction", APPLY, 'if current.Generation != preview.SourceGeneration {\n\t\treturn migrationError(MigrationError{Operation: "validate preview generation", Err: ErrMigrationV4StaleGeneration})', 'if current.Generation < preview.SourceGeneration {\n\t\treturn migrationError(MigrationError{Operation: "validate preview generation", Err: ErrMigrationV4StaleGeneration})', "Admits newer generations into the in-lock apply revalidation", "TestRevalidateApplyV4StaleGeneration"),
    21	 ("v4-explicit-label", MIGRATION, 'migrationError(MigrationError{Operation: "select target", Err: ErrMigrationV4Explicit})', 'migrationError(MigrationError{Operation: "select target", Err: ErrMigrationTarget})', "LABEL-PRECISION, not a semantic admission: mislabels the explicit-preview refusal; named test pins the exact error", "TestMigrateRefusesV4Target"),
    22	 ("compensate-source-swap", APPLY, "writeTempReplace(hold, filesystem, filename, preview.SourceDocument)", "writeTempReplace(hold, filesystem, filename, preview.Replacement)", "Restores the replacement instead of the source: admits exactly the no-op apply restore", "TestApplyV4CompensatesBumpFailure"),
    23	 ("compensate-rollback-source-swap", APPLY, "writeTempReplace(hold, filesystem, filename, snapshot.Document())", "writeTempReplace(hold, filesystem, filename, backupBytes)", "Restores the backup instead of the source: admits exactly the no-op rollback restore", "TestRollbackV4CompensatesBumpFailure"),
    24	 ("replace-require-skip", MIGRATION, "if !hold.Valid() {", "if !hold.Valid() && !hold.IsZero() {", "Admits exactly the zero token into the config pair writers", "TestReplaceDurablyRefusesZeroHold"),
    25	 ("legacy-revalidate-skip", MIGRATION, "\tif !bytes.Equal(current.Document(), snapshot.Document()) {\n\t\treturn migrationError(MigrationError{Operation: \"revalidate source\", Err: ErrMigrationStaleSource})\n\t}\n", "", "Drops the byte comparison while keeping the version check: admits exactly same-version source changes", "TestRevalidateLegacySourceRefusesChangedBytes"),
    26	 ("replace-restore-skip", MIGRATION, "\t\t\trollbackErr = filesystem.Rename(rollbackTemp, filename)", "\t\t\trollbackErr = filesystem.Remove(rollbackTemp)", "Cleans the restore staging instead of reinstalling it: admits exactly unrestored post-rename sync failures", "TestMigrateRecoversOriginalAfterPostReplaceDirectorySyncFailureAndRetries"),
    27	]
    28	
    29	BOUNDS = {
    30	 "neutral": "Equivalent arithmetic; no independent kill claimed.",
    31	}
    32	
    33	def main():
    34	    parser = argparse.ArgumentParser(description=__doc__)
    35	    parser.add_argument("--output", required=True)
    36	    parser.add_argument("--only", help="Comma-separated probe names for a bounded follow-up")
    37	    opts = parser.parse_args()
    38	    if opts.only and not set(opts.only.split(",")).issubset({p[0] for p in PROBES}):
    39	        parser.error("--only contains an unknown probe")
    40	    out = Path(opts.output).resolve()
    41	    out.mkdir(parents=True, exist_ok=True)
    42	    results = []
    43	    unexpected = False
    44	    for name, path, old, new, narrows, expected_test in PROBES:
    45	        if opts.only and name not in opts.only.split(","):
    46	            continue
    47	        source = ROOT / path
    48	        original = source.read_bytes()
    49	        text = original.decode()
    50	        if text.count(old) != 1:
    51	            raise RuntimeError(f"{name}: plant must match exactly once, got {text.count(old)}")
    52	        folder = out / name
    53	        folder.mkdir(exist_ok=True)
    54	        replacement = folder / source.name
    55	        replacement.write_text(text.replace(old, new, 1))
    56	        overlay = folder / "overlay.json"
    57	        overlay.write_text(json.dumps({"Replace": {str(source): str(replacement)}}))
    58	        command = ["go", "test", "-overlay", str(overlay), "./internal/config", "-count=1", "-json", "-timeout=120s", "-run", TESTS]
    59	        proc = subprocess.run(command, cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=300)
    60	        (folder / "test.log").write_bytes(proc.stdout)
    61	        events = []
    62	        for line in proc.stdout.decode(errors="replace").splitlines():
    63	            try:
    64	                events.append(json.loads(line))
    65	            except json.JSONDecodeError:
    66	                pass
    67	        failed = [e["Test"] for e in events if e.get("Action") == "fail" and "Test" in e]
    68	        passed = [e["Test"] for e in events if e.get("Action") == "pass" and "Test" in e]
    69	        killed = proc.returncode != 0 and bool(failed) and (expected_test is None or expected_test in failed)
    70	        if name == "neutral":
    71	            valid = proc.returncode == 0 and bool(passed)
    72	            state = "neutral passed" if valid else "invalid control"
    73	        elif name in BOUNDS:
    74	            valid = proc.returncode == 0 and bool(passed)
    75	            state = "survived" if valid else "unexpected result"
    76	        else:
    77	            valid = killed
    78	            state = "killed" if killed else "survived" if proc.returncode == 0 and passed else "invalid instrument/compile failure"
    79	        if not valid:
    80	            unexpected = True
    81	        if source.read_bytes() != original:
    82	            raise RuntimeError(f"{name}: source changed during overlay run")
    83	        row = {"mutant": name, "narrowing": narrows, "exit_code": proc.returncode, "result": state,
    84	               "named_failing_tests": failed, "expected_test": expected_test,
    85	               "bound": BOUNDS.get(name, "" if killed or name == "neutral" else "No named failing test established; this gate member is unproven."),
    86	               "command": command}
    87	        results.append(row)
    88	        print(f"{name}: {state}, exit={proc.returncode}, tests={','.join(failed)}", flush=True)
    89	        (out / "results.json").write_text(json.dumps(results, indent=2) + "\n")
    90	    rows = ["| Mutant | What the gate is narrowed to admit | Named failing test | Exit | Result / surviving bound |",
    91	            "| --- | --- | --- | ---: | --- |"]
    92	    for r in results:
    93	        tests = r["expected_test"] if r["expected_test"] in r["named_failing_tests"] else ", ".join(r["named_failing_tests"])
    94	        rows.append(f'| {r["mutant"]} | {r["narrowing"]} | {tests or "none"} | {r["exit_code"]} | {r["result"]}: {r["bound"]} |')
    95	    (out / "table.md").write_text("\n".join(rows)+"\n")
    96	    return int(unexpected)
    97	
    98	
    99	if __name__ == "__main__":
   100	    sys.exit(main())

