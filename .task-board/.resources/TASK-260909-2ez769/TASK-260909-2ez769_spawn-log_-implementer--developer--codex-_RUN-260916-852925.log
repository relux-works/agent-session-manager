   343	
   344	// Stat does not follow a symlink, unlike the symlink-following read-side seam
   345	// in OSInputs. Durable migration replaces the selected file with an atomic
   346	// rename, which replaces a symlink itself rather than its target: migrating a
   347	// symlinked configuration would silently detach the operator's link and leave
   348	// the real document holding stale bytes next to a backup of the resolved
   349	// target. The specification is silent here, so the mutating path fails closed
   350	// with ErrConfigNotRegular instead of guessing which file the operator meant.
   351	func (osMigrationFileSystem) Stat(name string) (fs.FileInfo, error) { return os.Lstat(name) }
   352	func (osMigrationFileSystem) Remove(name string) error              { return os.Remove(name) }
   353	func (osMigrationFileSystem) Rename(oldname, newname string) error {
   354		return os.Rename(oldname, newname)
   355	}
