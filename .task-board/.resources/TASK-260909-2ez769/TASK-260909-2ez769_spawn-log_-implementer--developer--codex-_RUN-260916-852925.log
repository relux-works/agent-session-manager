+		hold = current
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if err := hold.ValidateConfigPath(filepath.Join(t.TempDir(), "config.toml")); !errors.Is(err, ErrExclusiveHoldResourceMismatch) {
+		t.Fatalf("ValidateConfigPath(unbound) err = %v, want %v", err, ErrExclusiveHoldResourceMismatch)
+	}
+}
