    31	// openLock attaches to the shared lock file, creating it exactly once
    32	// across all processes. Creation is atomic and non-replacing (CREATE_NEW):
    33	// a process that observes absence while another process creates the lock
    34	// loses the race and opens the existing file instead of replacing a live
    35	// lock, so concurrent first-open can never split the authorization lock
    36	// across two files.
    37	func openLock(filesystem FileSystem, path string) (*fileLock, error) {
    38		lockInitMu.Lock()
    39		defer lockInitMu.Unlock()
    40		_, err := filesystem.Lstat(path)
