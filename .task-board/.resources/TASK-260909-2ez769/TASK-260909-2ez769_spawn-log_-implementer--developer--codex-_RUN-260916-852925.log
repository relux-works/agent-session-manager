    61	func findTrustEntry(trust hosttrust.Snapshot, credentialID string) (hosttrust.CredentialEntry, bool) {
    62		for _, entry := range trust.Trust.Entries {
    63			if entry.CredentialID.String() == credentialID {
    64				return entry, true
    65			}
    66		}
    67		return hosttrust.CredentialEntry{}, false
    68	}
    69	
    70	// checkCredentialWindow enforces current validity of both certificates
    71	// against the actual local UTC time, inclusively within notBefore/notAfter
    72	// with no extra acceptance skew or expiry grace.
    73	func checkCredentialWindow(leafDER, rootDER []byte, now time.Time) error {
    74		leaf, err := x509.ParseCertificate(leafDER)
    75		if err != nil {
    76			return err
    77		}
    78		root, err := x509.ParseCertificate(rootDER)
    79		if err != nil {
    80			return err
    81		}
    82		instant := now.UTC()
    83		for _, certificate := range []*x509.Certificate{leaf, root} {
    84			if instant.Before(certificate.NotBefore) || instant.After(certificate.NotAfter) {
    85				return errors.New("credential outside validity window")
    86			}
    87		}
    88		return nil
    89	}
    90	
    91	func peerEnrolled(trust hosttrust.Snapshot, hostID string, now time.Time) bool {
    92		for _, entry := range trust.Trust.Entries {
    93			if entry.HostID.String() != hostID || entry.State != hosttrust.EntryActive {
    94				continue
    95			}
    96			if checkCredentialWindow(entry.LeafDER, entry.RootDER, now) == nil {
    97				return true
    98			}
    99		}
   100		return false
   101	}
   102	
   103	// writeTempReplace durably restores document over filename after a trust
   104	// commit failure. It is recovery, not a migration: no backup is published.
   105	// It runs only from the JointCommit restore closures under the exclusive
   106	// authorization hold (see the write-path census); the census gate fails
   107	// any other caller, and a forged, absent or released hold refuses before
   108	// anything is staged.
   109	func writeTempReplace(hold hosttrust.HeldExclusive, filesystem migrationFileSystem, filename string, document []byte) (string, error) {
   110		if err := requireHold(hold); err != nil {
   111			return "", err
   112		}
   113		directory := filepath.Dir(filename)
   114		staged, err := writeTempFile(filesystem, directory, ".ax-config-restore-*", document, 0o600)
   115		if err != nil {
   116			return "", err
   117		}
   118		if err := filesystem.Rename(staged, filename); err != nil {
   119			_ = filesystem.Remove(staged)
   120			return "", err
   121		}
   122		if err := syncDirectory(filesystem, directory); err != nil {
   123			return "", err
   124		}
   125		return staged, nil
   126	}

