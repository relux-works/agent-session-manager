    99	
   100	// Open validates owner-only custody of STATE_DIR/host-channel, creating the
   101	// directory skeleton with exact 0700/0600 modes when absent. Every open
   102	// re-verifies custody: symlink escapes, foreign ownership and group/world
   103	// access refuse with ErrTrustUnsafeCustody.
   104	func Open(stateDir string) (*Store, error) { return openStore(stateDir, osFileSystem{}) }
   105	
   106	func openStore(stateDir string, filesystem FileSystem) (*Store, error) {
   107		if filesystem == nil {
   108			return nil, trustError(TrustError{Operation: "open store", Err: ErrInvalidStoreContext})
   109		}
   110		if !filepath.IsAbs(stateDir) {
   111			return nil, trustError(TrustError{Operation: "open store", Err: ErrInvalidStoreContext})
   112		}
   113		root := filepath.Join(stateDir, hostChannelDir)
   114		if err := ensureOwnerDir(filesystem, root, 0o700); err != nil {
   115			return nil, err
   116		}
   117		if err := ensureOwnerDir(filesystem, filepath.Join(root, credentialsDir), 0o700); err != nil {
   118			return nil, err
   119		}
   120		lock, err := openLock(filesystem, filepath.Join(root, lockFileName))
   121		if err != nil {
   122			return nil, err
   123		}
   124		store := &Store{root: root, fs: filesystem, lock: lock}
   125		// Converge one interrupted joint config-plus-trust commit, if any: a
   126		// crash between the configuration replacement and the generation bump
   127		// must complete forward or abort on restart, never admit the new
   128		// configuration with the old generation. A refused recovery fails the
   129		// open so incoherent state cannot be used.
   130		if _, err := store.Recover(); err != nil {
   131			return nil, err
   132		}
   133		return store, nil
   134	}
