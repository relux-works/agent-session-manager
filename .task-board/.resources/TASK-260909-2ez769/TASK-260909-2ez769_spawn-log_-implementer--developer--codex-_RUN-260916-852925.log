     3	package hosttrust
     4	
     5	import (
     6		"errors"
     7		"os"
     8		"sync"
     9	
    10		"golang.org/x/sys/unix"
    11	)
    12	
    13	// fileLock is the machine-local cross-process authorization lock shared by
    14	// trust changes and Configuration 4.0.0 peer/credential changes. Readers hold
    15	// it shared; transactions hold it exclusive, so a revocation or config commit
    16	// can never land between a dispatch check and its side-effect boundary.
    17	//
    18	// Every acquisition opens its own file description: flock locks attach to the
    19	// open file description, so goroutines sharing one retained descriptor would
    20	// not serialize. Per-acquisition descriptors make both same-process
    21	// goroutines and separate processes block on a held exclusive lock. A caller
    22	// must never request a second acquisition while holding one in the same
    23	// goroutine; internal reads nested inside a holder use descriptor-direct
    24	// unlocked reads instead of re-acquiring.
    25	type fileLock struct {
    26		path string
    27	}
    28	
    29	// lockInitMu serializes concurrent creation of the lock file itself.
    30	var lockInitMu sync.Mutex
    31	
    32	// openLock attaches to the shared lock file, creating it exactly once
    33	// across all processes. Creation is atomic and non-replacing
    34	// (O_CREAT|O_EXCL): a process that observes absence while another process
    35	// creates the lock loses the race and opens the existing inode instead of
    36	// renaming over a live lock, so concurrent first-open can never split the
    37	// authorization lock across two inodes.
    38	func openLock(filesystem FileSystem, path string) (*fileLock, error) {
    39		lockInitMu.Lock()
    40		defer lockInitMu.Unlock()
    41		_, err := filesystem.Lstat(path)
    42		if err == nil {
    43			if err := verifyLockFile(filesystem, path); err != nil {
    44				return nil, err
    45			}
    46			return &fileLock{path: path}, nil
    47		}
    48		if !os.IsNotExist(err) {
    49			return nil, trustError(TrustError{Operation: "open lock", Err: errors.Join(ErrTrustStoreUnreadable, err)})
    50		}
    51		if err := filesystem.CreateExclusive(path, 0o600); err != nil {
    52			// Lost the creation race: another process published the lock
    53			// first. Open the existing inode; never replace it.
    54			if !isLockExistsError(err) {
    55				return nil, trustError(TrustError{Operation: "open lock", Err: errors.Join(ErrTrustStoreUnreadable, err)})
    56			}
    57			if err := verifyLockFile(filesystem, path); err != nil {
    58				return nil, err
    59			}
    60			return &fileLock{path: path}, nil
    61		}
    62		if err := filesystem.Chmod(path, 0o600); err != nil {
    63			return nil, trustError(TrustError{Operation: "open lock", Err: errors.Join(ErrTrustUnsafeCustody, err)})
    64		}
    65		if err := secureStaged(path, false); err != nil {
    66			return nil, err
    67		}
    68		info, err := filesystem.Lstat(path)
    69		if err != nil {
    70			return nil, trustError(TrustError{Operation: "open lock", Err: errors.Join(ErrTrustStoreUnreadable, err)})
    71		}
    72		if err := verifyOwnerFile(path, info, 0o600); err != nil {
    73			return nil, err
    74		}
    75		return &fileLock{path: path}, nil
    76	}
    77	
    78	// isLockExistsError reports a lost creation race: the lock file already
    79	// exists, so the caller must open it rather than publish over it.
    80	func isLockExistsError(err error) bool {
    81		return os.IsExist(err) || errors.Is(err, unix.EEXIST)
    82	}
    83	
    84	// openLockFD opens one private file description for a single acquisition.
    85	// O_NOFOLLOW refuses symlink escapes at open time; the descriptor never
    86	// follows a link swapped in after Lstat.
    87	func openLockFD(path string) (int, error) {
    88		fd, err := unix.Open(path, unix.O_RDWR|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
    89		if err != nil {
    90			joined := errors.Join(ErrTrustStoreUnreadable, err)
    91			if errors.Is(err, unix.ELOOP) {
    92				joined = errors.Join(ErrTrustUnsafeCustody, err)
    93			}
    94			return -1, trustError(TrustError{Operation: "open lock", Err: joined})
    95		}
    96		return fd, nil
    97	}
    98	
    99	func (lock *fileLock) shared() (func(), error) {
   100		fd, err := openLockFD(lock.path)
   101		if err != nil {
   102			return nil, err
   103		}
   104		if err := unix.Flock(fd, unix.LOCK_SH); err != nil {
   105			_ = unix.Close(fd)
   106			return nil, err
   107		}
   108		return func() {
   109			_ = unix.Flock(fd, unix.LOCK_UN)
   110			_ = unix.Close(fd)
   111		}, nil
   112	}
   113	
   114	func (lock *fileLock) exclusive() (func(), error) {
   115		fd, err := openLockFD(lock.path)
   116		if err != nil {
   117			return nil, err
   118		}
   119		if err := unix.Flock(fd, unix.LOCK_EX); err != nil {
   120			_ = unix.Close(fd)
   121			return nil, err
   122		}
   123		return func() {
   124			_ = unix.Flock(fd, unix.LOCK_UN)
   125			_ = unix.Close(fd)
   126		}, nil
   127	}
