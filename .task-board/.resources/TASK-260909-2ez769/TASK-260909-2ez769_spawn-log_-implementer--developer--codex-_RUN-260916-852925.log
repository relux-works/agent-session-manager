    13		"github.com/pelletier/go-toml/v2"
    14		"github.com/relux-works/agent-session-manager/internal/hosttrust"
    15		"github.com/relux-works/agent-session-manager/internal/scalar"
    16	)
    17	
    18	var (
    19		ErrMigrationTarget         = errors.New("unsupported configuration migration target")
    20		ErrMigrationDowngrade      = errors.New("configuration migration would downgrade")
    21		ErrMigrationChoiceRequired = errors.New("generated-summary disclosure choice required")
    22		ErrMigrationSourceAbsent   = errors.New("configuration migration source is absent")
    23		ErrMigrationBackup         = errors.New("configuration migration backup failed")
    24		ErrMigrationWrite          = errors.New("configuration migration write failed")
    25		ErrMigrationSync           = errors.New("configuration migration sync failed")
    26		ErrMigrationReplace        = errors.New("configuration migration atomic replace failed")
    27		ErrMigrationRecovery       = errors.New("configuration migration recovery failed")
    28		ErrCompatibilityReader     = errors.New("unsupported configuration reader version")
    29		ErrCompatibilityAssessment = errors.New("configuration compatibility assessment failed")
    30		// ErrMigrationV4Explicit reports a direct Migrate call targeting
    31		// Configuration 4.0.0. Migration to v4 is never a one-shot upgrade: it
    32		// requires PreviewV4, explicit operator confirmation, and ApplyV4.
    33		ErrMigrationV4Explicit = errors.New("configuration 4.0.0 migration requires explicit preview and confirmation")
    34		// ErrMigrationV4Source reports a v4 migration requested from a
    35		// Configuration 1.0.0 or 2.0.0 source. Older inputs first use the
    36		// existing explicit migrations to Configuration 3.0.0.
    37		ErrMigrationV4Source = errors.New("configuration 4.0.0 migration requires a configuration 3.0.0 source")
    38		// ErrMigrationStaleSource reports a legacy migration whose source
    39		// changed between selection and the durable replacement: another
    40		// migration or a joint Configuration 4.0.0 commit landed first. The
    41		// delayed write refuses instead of overwriting the committed state.
    42		ErrMigrationStaleSource = errors.New("configuration migration source changed during migration")
    43	)
    44	
    45	// MigrationOptions are the explicit choices supplied by the ax migrate config
    46	// owner. Major-version migration is never invoked from Load or startup.
    47	type MigrationOptions struct {
    48		TargetVersion                 string
    49		GeneratedSummaryUpgradeChoice string
    50	}
    51	
    52	// MigrationResult reports durable migration without claiming CLI or doctor
    53	// availability. Changed is false for an already-target-version document.
    54	// BackupPath is the deterministic name the backup takes and is only guaranteed
    55	// to exist on disk when Migrate returned a nil error; a caller must not treat
    56	// it as a readable path after a refusal.
