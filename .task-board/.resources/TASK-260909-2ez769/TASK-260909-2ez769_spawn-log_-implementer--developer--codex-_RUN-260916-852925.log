+	store := setupStoreForTest(t)
+	var validationErr error
+	if err := store.WithExclusiveHold(func(hold HeldExclusive) error {
+		validationErr = hold.ValidateConfigPath(filepath.Join(t.TempDir(), "config.toml"))
