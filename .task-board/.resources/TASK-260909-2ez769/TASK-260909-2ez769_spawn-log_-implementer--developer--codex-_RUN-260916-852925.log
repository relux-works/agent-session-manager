   119		if err := unix.Flock(fd, unix.LOCK_EX); err != nil {
   120			_ = unix.Close(fd)
   121			return nil, err
   122		}
   123		return func() {
   124			_ = unix.Flock(fd, unix.LOCK_UN)
   125			_ = unix.Close(fd)
   126		}, nil
   127	}

=== lock windows ===
     1	//go:build windows
     2	
     3	package hosttrust
     4	
     5	import (
     6		"errors"
     7		"os"
     8		"sync"
     9	
    10		"golang.org/x/sys/windows"
    11	)
    12	
    13	// fileLock is the machine-local cross-process authorization lock shared by
    14	// trust changes and Configuration 4.0.0 peer/credential changes. Readers hold
    15	// it shared; transactions hold it exclusive.
    16	//
    17	// Every acquisition opens its own handle: Windows byte-range locks attach to
    18	// the file object, so goroutines sharing one retained handle would not
    19	// serialize. Per-acquisition handles make both same-process goroutines and
    20	// separate processes block on a held exclusive lock. A caller must never
    21	// request a second acquisition while holding one in the same goroutine;
    22	// internal reads nested inside a holder use handle-direct unlocked reads
    23	// instead of re-acquiring.
    24	type fileLock struct {
    25		path string
    26	}
    27	
    28	// lockInitMu serializes concurrent creation of the lock file itself.
    29	var lockInitMu sync.Mutex
    30	
    31	// openLock attaches to the shared lock file, creating it exactly once
    32	// across all processes. Creation is atomic and non-replacing (CREATE_NEW):
    33	// a process that observes absence while another process creates the lock
    34	// loses the race and opens the existing file instead of replacing a live
    35	// lock, so concurrent first-open can never split the authorization lock
    36	// across two files.
    37	func openLock(filesystem FileSystem, path string) (*fileLock, error) {
    38		lockInitMu.Lock()
    39		defer lockInitMu.Unlock()
    40		_, err := filesystem.Lstat(path)
    41		if err == nil {
    42			if err := verifyLockFile(filesystem, path); err != nil {
    43				return nil, err
    44			}
    45			return &fileLock{path: path}, nil
    46		}
    47		if !os.IsNotExist(err) {
    48			return nil, trustError(TrustError{Operation: "open lock", Err: errors.Join(ErrTrustStoreUnreadable, err)})
    49		}
    50		if err := filesystem.CreateExclusive(path, 0o600); err != nil {
    51			// Lost the creation race: another process published the lock
    52			// first. Open the existing file; never replace it.
    53			if !isLockExistsError(err) {
    54				return nil, trustError(TrustError{Operation: "open lock", Err: errors.Join(ErrTrustStoreUnreadable, err)})
    55			}
    56			if err := verifyLockFile(filesystem, path); err != nil {
    57				return nil, err
    58			}
    59			return &fileLock{path: path}, nil
    60		}
    61		if err := filesystem.Chmod(path, 0o600); err != nil {
    62			return nil, trustError(TrustError{Operation: "open lock", Err: errors.Join(ErrTrustUnsafeCustody, err)})
    63		}
    64		if err := secureStaged(path, false); err != nil {
    65			return nil, err
    66		}
    67		info, err := filesystem.Lstat(path)
    68		if err != nil {
    69			return nil, trustError(TrustError{Operation: "open lock", Err: errors.Join(ErrTrustStoreUnreadable, err)})
    70		}
    71		if err := verifyOwnerFile(path, info, 0o600); err != nil {
    72			return nil, err
    73		}
    74		return &fileLock{path: path}, nil
    75	}
    76	
    77	// isLockExistsError reports a lost creation race: the lock file already
    78	// exists, so the caller must open it rather than publish over it.
    79	func isLockExistsError(err error) bool {
    80		return os.IsExist(err) || errors.Is(err, windows.ERROR_FILE_EXISTS) || errors.Is(err, windows.ERROR_ALREADY_EXISTS)
    81	}
    82	
    83	func openLockHandle(path string) (windows.Handle, error) {
    84		name, err := windows.UTF16PtrFromString(path)
    85		if err != nil {
    86			return 0, trustError(TrustError{Operation: "open lock", Err: errors.Join(ErrTrustStoreUnreadable, err)})
    87		}
    88		handle, err := windows.CreateFile(name, windows.GENERIC_READ|windows.GENERIC_WRITE,
    89			windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING,
    90			windows.FILE_ATTRIBUTE_NORMAL, 0)
    91		if err != nil {
    92			return 0, trustError(TrustError{Operation: "open lock", Err: errors.Join(ErrTrustStoreUnreadable, err)})
    93		}
    94		return handle, nil
    95	}
    96	
    97	func (lock *fileLock) shared() (func(), error) {
    98		handle, err := openLockHandle(lock.path)
    99		if err != nil {
   100			return nil, err
   101		}
   102		overlapped := new(windows.Overlapped)
   103		if err := windows.LockFileEx(handle, 0, 0, 1, 0, overlapped); err != nil {
   104			_ = windows.CloseHandle(handle)
   105			return nil, err
   106		}
   107		return func() {
   108			_ = windows.UnlockFileEx(handle, 0, 1, 0, overlapped)
   109			_ = windows.CloseHandle(handle)
   110		}, nil
   111	}
   112	
   113	func (lock *fileLock) exclusive() (func(), error) {
   114		handle, err := openLockHandle(lock.path)
   115		if err != nil {
   116			return nil, err
   117		}
   118		overlapped := new(windows.Overlapped)
   119		if err := windows.LockFileEx(handle, windows.LOCKFILE_EXCLUSIVE_LOCK, 0, 1, 0, overlapped); err != nil {
   120			_ = windows.CloseHandle(handle)
   121			return nil, err
   122		}
   123		return func() {
   124			_ = windows.UnlockFileEx(handle, 0, 1, 0, overlapped)
   125			_ = windows.CloseHandle(handle)
   126		}, nil
   127	}

=== enroll/store types ===
     1	package hosttrust
     2	
     3	import (
     4		"bytes"
     5		"crypto/ecdsa"
     6		"crypto/x509"
     7		"encoding/pem"
     8		"errors"
     9		"path/filepath"
    10		"time"
    11	
    12		"github.com/relux-works/agent-session-manager/internal/scalar"
    13	)
    14	
    15	// EnrollInput is the explicit local operator authorization of one enrollment
    16	// tuple plus the imported public bytes. The Authorized fingerprints must come
    17	// from an independent authenticated out-of-band channel: SSH discovery, a
    18	// first hello, a remote claim, or a certificate being self-signed is never
    19	// approval, and this function cannot tell where the caller got them. What it
    20	// guarantees is that the imported bytes reproduce the authorized tuple and
    21	// the profile before anything commits.
    22	type EnrollInput struct {
    23		HostID     string
    24		LeafDER    []byte
    25		RootDER    []byte
    26		Authorized Fingerprints
    27		EnrolledAt time.Time
    28	}
    29	
    30	// Enroll commits one active peer credential after verifying the authorized
    31	// tuple, the profile, lifetimes, and the cross-entry uniqueness rules.
    32	// Enrollment is one-directional: it never implies reciprocity.
    33	func (store *Store) Enroll(input EnrollInput) (string, error) {
    34		parsed, err := scalar.ParseUUIDv7(input.HostID)
    35		if err != nil {
    36			return "", trustError(TrustError{Operation: "enroll host", Err: errors.Join(ErrEnrollmentRefused, err)})
    37		}
    38		observed, err := FingerprintsOf(input.LeafDER, input.RootDER)
    39		if err != nil {
    40			return "", err
    41		}
    42		if observed != input.Authorized {
    43			return "", trustError(TrustError{Operation: "enroll fingerprints", Err: ErrEnrollmentRefused})
    44		}
    45		if err := VerifyProfile(input.LeafDER, input.RootDER, parsed.String(), input.EnrolledAt); err != nil {
    46			return "", err
    47		}
    48		enrolledAt, err := scalar.ParseTimestamp(input.EnrolledAt.UTC().Format("2006-01-02T15:04:05.000Z"))
    49		if err != nil {
    50			return "", trustError(TrustError{Operation: "enroll timestamp", Err: errors.Join(ErrEnrollmentRefused, err)})
    51		}
    52		entry := CredentialEntry{
    53			HostID:       parsed,
    54			CredentialID: scalar.SHA256Digest(input.LeafDER),
    55			SPKIID:       scalar.SHA256Digest(mustSPKI(input.LeafDER)),
    56			RootID:       scalar.SHA256Digest(input.RootDER),
    57			LeafDER:      append([]byte(nil), input.LeafDER...),
    58			RootDER:      append([]byte(nil), input.RootDER...),
    59			State:        EntryActive,
    60			EnrolledAt:   enrolledAt,
    61		}
    62		if err := store.transact(func(trust *TrustStore) error {
    63			return admitEntry(trust, entry)
    64		}); err != nil {
    65			return "", err
    66		}
    67		return entry.CredentialID.String(), nil
    68	}
    69	
    70	func mustSPKI(leafDER []byte) []byte {
    71		leaf, err := x509.ParseCertificate(leafDER)
    72		if err != nil {
    73			return nil
    74		}
    75		return leaf.RawSubjectPublicKeyInfo
    76	}
    77	
    78	// admitEntry enforces the cross-entry rules across all entries including
    79	// revoked tombstones: a leaf, leaf public key or root must never map to more
    80	// than one host UUID, duplicate roots are invalid even for the same UUID, and
    81	// at most two non-revoked credentials may belong to one host.
    82	func admitEntry(trust *TrustStore, entry CredentialEntry) error {
    83		if len(trust.Entries) >= MaxEntries {
    84			return trustError(TrustError{Operation: "admit entry", Err: ErrEnrollmentRefused})
    85		}
    86		var live uint64
    87		for _, existing := range trust.Entries {
    88			if bytes.Equal(existing.LeafDER, entry.LeafDER) {
    89				return trustError(TrustError{Operation: "admit entry", Err: ErrEnrollmentRefused})
    90			}
    91			if existing.SPKIID.String() == entry.SPKIID.String() {
    92				return trustError(TrustError{Operation: "admit entry", Err: ErrEnrollmentRefused})
    93			}
    94			if existing.RootID.String() == entry.RootID.String() {
    95				return trustError(TrustError{Operation: "admit entry", Err: ErrEnrollmentRefused})
    96			}
    97			if existing.CredentialID.String() == entry.CredentialID.String() {
    98				return trustError(TrustError{Operation: "admit entry", Err: ErrEnrollmentRefused})
    99			}
   100			if existing.HostID.String() == entry.HostID.String() && existing.State != EntryRevoked {
   101				live++
   102			}
   103		}
   104		if live >= 2 {
   105			return trustError(TrustError{Operation: "admit entry", Err: ErrEnrollmentRefused})
   106		}
   107		trust.Entries = append(trust.Entries, entry)
   108		return nil
   109	}
   110	
   111	// Issue creates a local credential: fresh keys and profile-exact
   112	// certificates, owner-only custody files, and a self-enrolled active entry,
   113	// committed atomically in that order. Custody files are written before the
   114	// trust commit so a crash can only leave inert files without authority, never
   115	// authority without verifiable custody; a failed trust commit removes the
   116	// staged credential directory again.
   117	func (store *Store) Issue(hostID string, now time.Time) (string, error) {
   118		issued, err := IssueCredential(hostID, now, nil)
   119		if err != nil {
   120			return "", err
   121		}
   122		credentialHex := scalar.SHA256Digest(issued.LeafDER).Hex()
   123		directory := filepath.Join(store.root, credentialsDir, credentialHex)
   124		if err := ensureOwnerDir(store.fs, directory, 0o700); err != nil {
   125			return "", err
   126		}
   127		committed := false
   128		defer func() {
   129			if !committed {
   130				_ = store.fs.Remove(filepath.Join(directory, certificateFile))
   131				_ = store.fs.Remove(filepath.Join(directory, privateKeyFile))
   132				_ = store.fs.Remove(filepath.Join(directory, rootFile))
   133				_ = store.fs.Remove(directory)
   134			}
   135		}()
   136		if err := writeCustodyFile(store, directory, certificateFile, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: issued.LeafDER})); err != nil {
   137			return "", err
   138		}
   139		if err := writeCustodyFile(store, directory, privateKeyFile, pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: issued.LeafKeyDER})); err != nil {
   140			return "", err
   141		}
   142		if err := writeCustodyFile(store, directory, rootFile, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: issued.RootDER})); err != nil {
   143			return "", err
   144		}
   145		enrolledAt, err := scalar.ParseTimestamp(now.UTC().Format("2006-01-02T15:04:05.000Z"))
   146		if err != nil {
   147			return "", trustError(TrustError{Operation: "issue timestamp", Err: errors.Join(ErrCredentialProfile, err)})
   148		}
   149		entry := CredentialEntry{
   150			HostID:       issued.HostID,
   151			CredentialID: scalar.SHA256Digest(issued.LeafDER),
   152			SPKIID:       scalar.SHA256Digest(mustSPKI(issued.LeafDER)),
   153			RootID:       scalar.SHA256Digest(issued.RootDER),
   154			LeafDER:      issued.LeafDER,
   155			RootDER:      issued.RootDER,
   156			State:        EntryActive,
   157			EnrolledAt:   enrolledAt,
   158		}
   159		if err := store.transact(func(trust *TrustStore) error {
   160			return admitEntry(trust, entry)
   161		}); err != nil {
   162			return "", err
   163		}
   164		committed = true
   165		return entry.CredentialID.String(), nil
   166	}
   167	
   168	func writeCustodyFile(store *Store, directory, name string, contents []byte) error {
   169		staged, err := store.fs.CreateTemp(directory, ".custody-stage-*", 0o600)
   170		if err != nil {
   171			return trustError(TrustError{Operation: "write custody file", Err: errors.Join(ErrTrustDurability, err)})
   172		}
   173		staging := staged.Name()
   174		// On platforms where mode bits do not govern access, install the
   175		// owner-only ACL before the key material is written.
   176		if err := secureStaged(staging, false); err != nil {
   177			_ = staged.Close()
   178			_ = store.fs.Remove(staging)
   179			return err
   180		}
   181		failed := true
   182		defer func() {
   183			if failed {
   184				_ = store.fs.Remove(staging)
   185			}
   186		}()
   187		if err := writeAll(staged, contents); err != nil {
   188			_ = staged.Close()
   189			return trustError(TrustError{Operation: "write custody file", Err: errors.Join(ErrTrustDurability, err)})
   190		}
   191		if err := staged.Sync(); err != nil {
   192			_ = staged.Close()
   193			return trustError(TrustError{Operation: "sync custody file", Err: errors.Join(ErrTrustDurability, err)})
   194		}
   195		if err := staged.Close(); err != nil {
   196			return trustError(TrustError{Operation: "sync custody file", Err: errors.Join(ErrTrustDurability, err)})
   197		}
   198		target := filepath.Join(directory, name)
   199		if err := store.fs.Rename(staging, target); err != nil {
   200			return trustError(TrustError{Operation: "install custody file", Err: errors.Join(ErrTrustDurability, err)})
   201		}
   202		info, err := store.fs.Lstat(target)
   203		if err != nil {
   204			return trustError(TrustError{Operation: "inspect custody file", Err: errors.Join(ErrTrustStoreUnreadable, err)})
   205		}
   206		if err := verifyOwnerFile(target, info, 0o600); err != nil {
   207			return err
   208		}
   209		failed = false
   210		return nil
   211	}
   212	
   213	// ValidateCustody checks the local credential files before use: owner-only
   214	// regular files, parseable PEMs, private/public match, profile, and the
   215	// configured host binding. No other file may select identity.
   216	func (store *Store) ValidateCustody(credentialHex, hostID string, now time.Time) error {
   217		const operation = "validate custody"
   218		directory, err := store.CredentialDir(credentialHex)
   219		if err != nil {
   220			return err
   221		}
   222		leafPEM, err := readOwnerFile(store, filepath.Join(directory, certificateFile))
   223		if err != nil {
   224			return err
   225		}
   226		keyPEM, err := readOwnerFile(store, filepath.Join(directory, privateKeyFile))
   227		if err != nil {
   228			return err
   229		}
   230		rootPEM, err := readOwnerFile(store, filepath.Join(directory, rootFile))
   231		if err != nil {
   232			return err
   233		}
   234		leafBlock, _ := pem.Decode(leafPEM)
   235		keyBlock, _ := pem.Decode(keyPEM)
   236		rootBlock, _ := pem.Decode(rootPEM)
   237		if leafBlock == nil || keyBlock == nil || rootBlock == nil {
   238			return trustError(TrustError{Operation: operation, Err: ErrCredentialCustody})
   239		}
   240		leaf, err := x509.ParseCertificate(leafBlock.Bytes)
   241		if err != nil {
   242			return trustError(TrustError{Operation: operation, Err: errors.Join(ErrCredentialCustody, err)})
   243		}
   244		// The contained leaf must reproduce the credential directory: no other
   245		// file may select identity, including a valid credential filed under a
   246		// different credential's name.
   247		if scalar.SHA256Digest(leaf.Raw).Hex() != credentialHex {
   248			return trustError(TrustError{Operation: operation, Err: ErrCredentialCustody})
   249		}
   250		root, err := x509.ParseCertificate(rootBlock.Bytes)
   251		if err != nil {
   252			return trustError(TrustError{Operation: operation, Err: errors.Join(ErrCredentialCustody, err)})
   253		}
   254		key, err := x509.ParsePKCS8PrivateKey(keyBlock.Bytes)
   255		if err != nil {
   256			return trustError(TrustError{Operation: operation, Err: errors.Join(ErrCredentialCustody, err)})
   257		}
   258		private, ok := key.(*ecdsa.PrivateKey)
   259		if !ok {
   260			return trustError(TrustError{Operation: operation, Err: ErrCredentialCustody})
   261		}
   262		public, ok := leaf.PublicKey.(*ecdsa.PublicKey)
   263		if !ok {
   264			return trustError(TrustError{Operation: operation, Err: ErrCredentialCustody})
   265		}
   266		if private.PublicKey.X.Cmp(public.X) != 0 || private.PublicKey.Y.Cmp(public.Y) != 0 {
   267			return trustError(TrustError{Operation: operation, Err: ErrCredentialCustody})
   268		}
   269		return VerifyProfile(leaf.Raw, root.Raw, hostID, now)
   270	}
   271	
   272	func readOwnerFile(store *Store, path string) ([]byte, error) {
   273		info, err := store.fs.Lstat(path)
   274		if err != nil {
   275			return nil, trustError(TrustError{Operation: "read custody file", Err: errors.Join(ErrCredentialCustody, err)})
   276		}
   277		if err := verifyOwnerFile(path, info, 0o600); err != nil {
   278			return nil, err
   279		}
   280		contents, err := store.fs.ReadFile(path)

