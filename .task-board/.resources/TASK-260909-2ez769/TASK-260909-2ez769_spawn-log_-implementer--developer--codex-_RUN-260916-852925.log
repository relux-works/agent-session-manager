   431	// censusCallTarget resolves a call to its helper name and whether it is
   432	// a direct standard-library call (os.X), a seam/ordinary selector call,
   433	// or a plain identifier call (with alias resolution).
   434	func censusCallTarget(call *ast.CallExpr, aliases map[string]string) (name string, osDirect bool, ok bool) {
   435		switch function := call.Fun.(type) {
   436		case *ast.Ident:
   437			if helper, bound := aliases[function.Name]; bound {
   438				return helper, false, true
   439			}
   440			return function.Name, false, true
   441		case *ast.SelectorExpr:
   442			if ident, ok := function.X.(*ast.Ident); ok && ident.Name == "os" {
   443				return function.Sel.Name, true, true
   444			}
   445			if ident, ok := function.X.(*ast.Ident); ok && censusPackageIdents[ident.Name] {
   446				return "", false, false
   447			}
   448			return function.Sel.Name, false, true
   449		default:
   450			return "", false, false
   451		}
   452	}
   453	
   454	func censusCallViolation(fileset *token.FileSet, call *ast.CallExpr, ancestors []ast.Node, funcName string, aliases map[string]string) string {
   455		name, osDirect, ok := censusCallTarget(call, aliases)
   456		if !ok {
   457			return ""
   458		}
   459		position := fileset.Position(call.Pos())
   460		locate := func() string {
   461			return fmt.Sprintf("%s:%d: %s call in %s", position.Filename, position.Line, name, funcName)
   462		}
   463		if osDirect {
   464			// Backend definitions never reach this walk (their bodies are
   465			// skipped), so any direct os mutation here is a rogue writer.
   466			if censusOSMutations[name] {
   467				return censusViolation("%s is a direct os mutation outside the backend definitions", locate())
   468			}
   469			return ""
   470		}
   471		if censusPairHelpers[name] {
   472			if censusInsideHoldClosure(ancestors) {
   473				return ""
   474			}
   475			return censusViolation("%s is outside a JointCommit/WithExclusiveHold closure", locate())
   476		}
   477		if allowed, gated := censusTrustHelpers[name]; gated {
   478			if allowed[funcName] {
   479				return ""
   480			}
   481			return censusViolation("%s is outside the censused lock-held writers", locate())
   482		}
   483		if allowed, gated := censusCustodyHelpers[name]; gated {
   484			if allowed[funcName] {
   485				return ""
   486			}
   487			return censusViolation("%s is outside the censused custody sites", locate())
   488		}
   489		if allowed, gated := censusRawMutations[name]; gated {
   490			if allowed[funcName] {
   491				return ""
   492			}
   493			return censusViolation("%s is outside the censused mutation helpers", locate())
   494		}
   495		return ""
   496	}
   497	
   498	// censusInsideHoldClosure reports whether the call sits in a function
   499	// literal passed directly as a hold-entry argument (JointCommit or
   500	// WithExclusiveHold). Ancestors run outermost-first, so the literal's
   501	// parent is the preceding entry; the nearest literal decides,
   502	// conservatively.
   503	func censusInsideHoldClosure(ancestors []ast.Node) bool {
   504		for index := len(ancestors) - 1; index >= 0; index-- {
   505			literal, ok := ancestors[index].(*ast.FuncLit)
   506			if !ok {
   507				continue
   508			}
   509			if index == 0 {
   510				return false
   511			}
   512			parent, ok := ancestors[index-1].(*ast.CallExpr)
   513			if !ok || !censusIsHoldEntryCall(parent) {
   514				return false
   515			}
   516			for _, argument := range parent.Args {
   517				if argument == ast.Node(literal) {
   518					return true
   519				}
   520			}
   521			return false
   522		}
   523		return false
   524	}
   525	
   526	func censusIsHoldEntryCall(call *ast.CallExpr) bool {
   527		switch function := call.Fun.(type) {
   528		case *ast.Ident:
   529			return function.Name == "JointCommit" || function.Name == "WithExclusiveHold"
   530		case *ast.SelectorExpr:
   531			return function.Sel.Name == "JointCommit" || function.Sel.Name == "WithExclusiveHold"
   532		default:
   533			return false
   534		}
   535	}
