    12	// Pair writers require a live exclusive hold: a forged, absent or released
    13	// token refuses before anything durable is written. These tests pin the
    14	// fail-closed boundary the replace-require-skip narrowing plant attacks
    15	// (it admits exactly the zero token).
    16	
    17	func writeHoldTestFile(t *testing.T, directory, name string, document []byte) string {
    18		t.Helper()
    19		path := filepath.Join(directory, name)
    20		if err := os.WriteFile(path, document, 0o600); err != nil {
    21			t.Fatal(err)
    22		}
    23		return path
    24	}
    25	
    26	func assertHoldTestDirClean(t *testing.T, directory, filename string, original []byte) {
    27		t.Helper()
    28		after, err := os.ReadFile(filename)
    29		if err != nil {
    30			t.Fatal(err)
    31		}
    32		if string(after) != string(original) {
    33			t.Fatal("refused pair write changed the configuration file")
    34		}
    35		entries, err := os.ReadDir(directory)
    36		if err != nil {
    37			t.Fatal(err)
    38		}
    39		for _, entry := range entries {
    40			if entry.Name() != "config.toml" {
    41				t.Fatalf("refused pair write left %q", entry.Name())
    42			}
    43		}
    44	}
    45	
    46	func TestReplaceDurablyRefusesZeroHold(t *testing.T) {
    47		directory := t.TempDir()
    48		original := []byte("original configuration\n")
    49		filename := writeHoldTestFile(t, directory, "config.toml", original)
    50		err := replaceDurably(hosttrust.HeldExclusive{}, osMigrationFileSystem{}, filename, filename+".bak.3.0.0", original, []byte("replacement\n"))
    51		if !errors.Is(err, hosttrust.ErrExclusiveHoldRequired) {
    52			t.Fatalf("replaceDurably(zero hold) err = %v, want %v", err, hosttrust.ErrExclusiveHoldRequired)
    53		}
    54		assertHoldTestDirClean(t, directory, filename, original)
    55	}
    56	
    57	func TestReplaceDurablyRefusesReleasedHold(t *testing.T) {
    58		fixture := setupV4Fixture(t)
    59		var released hosttrust.HeldExclusive
    60		if err := fixture.store.WithExclusiveHold(func(hold hosttrust.HeldExclusive) error {
    61			released = hold
    62			return nil
    63		}); err != nil {
    64			t.Fatal(err)
    65		}
    66		if released.IsZero() {
    67			t.Fatal("captured hold is zero, want a genuine released hold")
    68		}
    69		directory := t.TempDir()
    70		original := []byte("original configuration\n")
    71		filename := writeHoldTestFile(t, directory, "config.toml", original)
    72		err := replaceDurably(released, osMigrationFileSystem{}, filename, filename+".bak.3.0.0", original, []byte("replacement\n"))
    73		if !errors.Is(err, hosttrust.ErrExclusiveHoldRequired) {
    74			t.Fatalf("replaceDurably(released hold) err = %v, want %v", err, hosttrust.ErrExclusiveHoldRequired)
    75		}
    76		assertHoldTestDirClean(t, directory, filename, original)
    77	}
    78	
    79	func TestWriteTempReplaceRefusesZeroHold(t *testing.T) {
    80		directory := t.TempDir()
    81		original := []byte("original configuration\n")
    82		filename := writeHoldTestFile(t, directory, "config.toml", original)
    83		if _, err := writeTempReplace(hosttrust.HeldExclusive{}, osMigrationFileSystem{}, filename, []byte("restored\n")); !errors.Is(err, hosttrust.ErrExclusiveHoldRequired) {
    84			t.Fatalf("writeTempReplace(zero hold) err = %v, want %v", err, hosttrust.ErrExclusiveHoldRequired)
    85		}
    86		assertHoldTestDirClean(t, directory, filename, original)
