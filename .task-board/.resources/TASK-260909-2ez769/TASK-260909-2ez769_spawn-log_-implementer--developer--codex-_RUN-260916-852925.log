diff --git a/internal/hosttrust/hold.go b/internal/hosttrust/hold.go
index 036077fb24ee5ef4cf72773a0c5d68add21fd08b..e92b8792d8efec6b5898e02e9524c78dab05abd8
--- a/internal/hosttrust/hold.go
+++ b/internal/hosttrust/hold.go
@@ -2,6 +2,7 @@
 
 import (
