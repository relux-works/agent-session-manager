+	if err := os.WriteFile(path, []byte("package censuscontrol\nfunc rogue() { unknownCallee() }\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := loadCensusTypeUnit(dir); err == nil {
+		t.Fatal("write-path census accepted an unresolved callee")
+	}
+}
+
