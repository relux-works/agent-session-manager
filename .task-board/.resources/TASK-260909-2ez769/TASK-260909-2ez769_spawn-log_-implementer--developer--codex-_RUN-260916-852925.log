+
+func censusReturnedClosureWitness(path string, data []byte) error {
+	writer := func() func(string, []byte) error {
+		return func(path string, data []byte) error { return os.WriteFile(path, data, 0o600) }
+	}()
+	return writer(path, data)
+}
+
