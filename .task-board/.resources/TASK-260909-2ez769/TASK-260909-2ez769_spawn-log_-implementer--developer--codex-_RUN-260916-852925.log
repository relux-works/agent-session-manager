+
+func (scanner *censusTypeScanner) visitSelectorValue(selector *ast.SelectorExpr, stack []ast.Node, functionName string) {
+	object := scanner.selectorObject(selector)
+	function, ok := object.(*types.Func)
+	if !ok {
+		return
+	}
