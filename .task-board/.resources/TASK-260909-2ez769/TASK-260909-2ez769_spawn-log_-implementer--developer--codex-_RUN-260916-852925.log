+	}); err != nil {
+		t.Fatal(err)
+	}
+	if !errors.Is(validationErr, ErrExclusiveHoldResourceMismatch) {
+		t.Fatalf("ValidateConfigPath(unbound) err = %v, want %v", validationErr, ErrExclusiveHoldResourceMismatch)
+	}
+}
