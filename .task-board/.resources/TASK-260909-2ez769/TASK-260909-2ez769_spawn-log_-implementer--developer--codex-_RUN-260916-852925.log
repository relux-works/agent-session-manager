   377		if !ok {
   378			return
   379		}
   380		helper, gated := scanner.gated[object]
   381		if !gated || scanner.isCallCallee(identifier, stack) || scanner.isSelectorName(identifier, stack) {
   382			return
   383		}
   384		position := scanner.unit.fset.Position(identifier.Pos())
   385		scanner.result = append(scanner.result, fmt.Sprintf("%s:%d: gated helper %s escapes as a value in %s", position.Filename, position.Line, helper, functionName))
   386	}
   387	
   388	func (scanner *censusTypeScanner) visitSelectorValue(selector *ast.SelectorExpr, stack []ast.Node, functionName string) {
   389		object := scanner.selectorObject(selector)
   390		function, ok := object.(*types.Func)
   391		if !ok {
   392			return
   393		}
   394		if censusIsOSMutation(function) || censusIsRawMutation(function) {
   395			position := scanner.unit.fset.Position(selector.Pos())
   396			scanner.result = append(scanner.result, fmt.Sprintf("%s:%d: filesystem mutation function %s escapes as a value in %s", position.Filename, position.Line, function.Name(), functionName))
   397		}
   398	}
   399	
   400	func (scanner *censusTypeScanner) callObject(call *ast.CallExpr) (types.Object, bool) {
   401		object := scanner.expressionObject(call.Fun)
   402		if object != nil {
   403			return object, true
   404		}
   405		return nil, scanner.unit.info.TypeOf(call.Fun) != nil
   406	}
   407	
   408	func (scanner *censusTypeScanner) expressionObject(expression ast.Expr) types.Object {
   409		switch value := expression.(type) {
   410		case *ast.Ident:
   411			return scanner.unit.info.Uses[value]
   412		case *ast.SelectorExpr:
   413			return scanner.selectorObject(value)
   414		case *ast.ParenExpr:
   415			return scanner.expressionObject(value.X)
   416		case *ast.IndexExpr:
   417			return scanner.expressionObject(value.X)
   418		case *ast.IndexListExpr:
   419			return scanner.expressionObject(value.X)
   420		}
   421		return nil
   422	}
   423	
   424	func (scanner *censusTypeScanner) selectorObject(selector *ast.SelectorExpr) types.Object {
   425		if selection := scanner.unit.info.Selections[selector]; selection != nil {
   426			return selection.Obj()
   427		}
   428		return scanner.unit.info.Uses[selector.Sel]
   429	}
   430	

