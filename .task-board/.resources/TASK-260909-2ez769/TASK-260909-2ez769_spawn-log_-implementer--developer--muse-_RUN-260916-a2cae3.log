{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c96d","stream":{"kind":"session","id":"01a0ac04-3aa6-7f83-a640-4d27d55c8cba"},"sequence":785,"recorded_at":1780531400001565,"record_type":"event","durability":"durable","causation_id":"792618d5-7c92-47f4-9c2f-44170e04457d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"792618d5-7c92-47f4-9c2f-44170e04457d","run_stream":{"kind":"run","id":"792618d5-7c92-47f4-9c2f-44170e04457d"},"task_stream":{"kind":"task","id":"01a0ac06-a147-7ca1-81f8-089e05e4cfa0"},"task_id":"01a0ac06-a147-7ca1-81f8-089e05e4cfa0","event":{"kind":"output","task_id":"01a0ac06-a147-7ca1-81f8-089e05e4cfa0","chunk":"Read text file `internal/config/migration_v4_helpers.go`.\n1|package config\n2|\n3|import (\n4|\t\"crypto/x509\"\n5|\t\"errors\"\n6|\t\"path/filepath\"\n7|\t\"strings\"\n8|\t\"time\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/hosttrust\"\n11|)\n12|\n13|// CoherentSnapshot is one coherent configuration-plus-trust read: the\n14|// trust generation and the configuration document observed under the same\n15|// shared authorization hold, so no trust or config commit can land between\n16|// them. Streams and dispatches bind Generation; any use must re-check\n17|// currency before crossing a side-effect boundary.\n18|type CoherentSnapshot struct {\n19|\tConfig     Snapshot\n20|\tTrust      hosttrust.TrustStore\n21|\tGeneration uint64\n22|}\n23|\n24|// LoadCoherent is the production pairing for readers that must never mix an\n25|// old allowlist with new credentials (Section 11.10.3): it holds the\n26|// authorization lock across the committed trust read and the configuration\n27|// load, converging pending joint intent first so a surviving reader\n28|// observes the same pair as a reopened store. PreviewV4 callers that hold\n29|// only a separately read trust snapshot should obtain the pair here\n30|// instead.\n31|func LoadCoherent(inputs Inputs, overrides Overrides, store *hosttrust.Store) (CoherentSnapshot, error) {\n32|\tvar coherent CoherentSnapshot\n33|\tif store == nil {\n34|\t\treturn CoherentSnapshot{}, migrationError(MigrationError{Operation: \"load coherent snapshot\", Err: hosttrust.ErrTrustStoreMissing})\n35|\t}\n36|\tif err := store.WithSharedSnapshot(func(current hosttrust.TrustStore) error {\n37|\t\tsnapshot, err := Load(inputs, overrides)\n38|\t\tif err != nil {\n39|\t\t\treturn err\n40|\t\t}\n41|\t\tcoherent = CoherentSnapshot{Config: snapshot, Trust: current, Generation: current.Generation}\n42|\t\treturn nil\n43|\t}); err != nil {\n44|\t\treturn CoherentSnapshot{}, err\n45|\t}\n46|\treturn coherent, nil\n47|}\n48|\n49|func stateDirOf(snapshot Snapshot) string {\n50|\tpath, ok := snapshot.Paths().Path(StateRoot)\n51|\tif !ok {\n52|\t\treturn \"\"\n53|\t}\n54|\treturn path.Value.String()\n55|}\n56|\n57|func previewCredentialHex(credentialID string) string {\n58|\treturn strings.TrimPrefix(credentialID, \"sha256:\")\n59|}\n60|\n61|func findTrustEntry(trust hosttrust.Snapshot, credentialID string) (hosttrust.CredentialEntry, bool) {\n62|\tfor _, entry := range trust.Trust.Entries {\n63|\t\tif entry.CredentialID.String() == credentialID {\n64|\t\t\treturn entry, true\n65|\t\t}\n66|\t}\n67|\treturn hosttrust.CredentialEntry{}, false\n68|}\n69|\n70|// checkCredentialWindow enforces current validity of both certificates\n71|// against the actual local UTC time, inclusively within notBefore/notAfter\n72|// with no extra acceptance skew or expiry grace.\n73|func checkCredentialWindow(leafDER, rootDER []byte, now time.Time) error {\n74|\tleaf, err := x509.ParseCertificate(leafDER)\n75|\tif err != nil {\n76|\t\treturn err\n77|\t}\n78|\troot, err := x509.ParseCertificate(rootDER)\n79|\tif err != nil {\n80|\t\treturn err\n81|\t}\n82|\tinstant := now.UTC()\n83|\tfor _, certificate := range []*x509.Certificate{leaf, root} {\n84|\t\tif instant.Before(certificate.NotBefore) || instant.After(certificate.NotAfter) {\n85|\t\t\treturn errors.New(\"credential outside validity window\")\n86|\t\t}\n87|\t}\n88|\treturn nil\n89|}\n90|\n91|func peerEnrolled(trust hosttrust.Snapshot, hostID string, now time.Time) bool {\n92|\tfor _, entry := range trust.Trust.Entries {\n93|\t\tif entry.HostID.String() != hostID || entry.State != hosttrust.EntryActive {\n94|\t\t\tcontinue\n95|\t\t}\n96|\t\tif checkCredentialWindow(entry.LeafDER, entry.RootDER, now) == nil {\n97|\t\t\treturn true\n98|\t\t}\n99|\t}\n100|\treturn false\n101|}\n102|\n103|// writeTempReplace durably restores document over filename after a trust\n104|// commit failure. It is recovery, not a migration: no backup is published.\n105|// It runs only from the JointCommit restore closures under the exclusive\n106|// authorization hold (see the write-path census); the census gate fails\n107|// any other caller, and a forged, absent or released hold refuses before\n108|// anything is staged.\n109|func writeTempReplace(hold hosttrust.HeldExclusive, filesystem migrationFileSystem, filename string, document []byte) (string, error) {\n110|\tif err := requireHold(hold); err != nil {\n111|\t\treturn \"\", err\n112|\t}\n113|\tdirectory := filepath.Dir(filename)\n114|\tstaged, err := writeTempFile(filesystem, directory, \".ax-config-restore-*\", document, 0o600)\n115|\tif err != nil {\n116|\t\treturn \"\", err\n117|\t}\n118|\tif err := filesystem.Rename(staged, filename); err != nil {\n119|\t\t_ = filesystem.Remove(staged)\n120|\t\treturn \"\", err\n121|\t}\n122|\tif err := syncDirectory(filesystem, directory); err != nil {\n123|\t\treturn \"\", err\n124|\t}\n125|\treturn staged, nil\n126|}","final_result":true}}}
