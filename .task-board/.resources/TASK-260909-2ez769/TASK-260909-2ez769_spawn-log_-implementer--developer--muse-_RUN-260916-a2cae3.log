{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca53","stream":{"kind":"session","id":"01a0ac04-3aa6-7f83-a640-4d27d55c8cba"},"sequence":900,"recorded_at":1780531400001795,"record_type":"event","durability":"durable","causation_id":"792618d5-7c92-47f4-9c2f-44170e04457d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"792618d5-7c92-47f4-9c2f-44170e04457d","run_stream":{"kind":"run","id":"792618d5-7c92-47f4-9c2f-44170e04457d"},"task_stream":{"kind":"task","id":"01a0ac06-e998-71c2-95b4-ab08d8eab0a9"},"task_id":"01a0ac06-e998-71c2-95b4-ab08d8eab0a9","event":{"kind":"output","task_id":"01a0ac06-e998-71c2-95b4-ab08d8eab0a9","chunk":"Read text file `internal/hosttrust/hold_test.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"testing\"\n8|\t\"time\"\n9|)\n10|\n11|// The hold is unforgeable outside the lock acquisition path: a forged,\n12|// absent or released token refuses before anything is written. These tests\n13|// pin the fail-closed boundary the hold-require-skip narrowing plant\n14|// attacks (it admits exactly the zero token).\n15|\n16|func TestCommitDocumentRefusesZeroHold(t *testing.T) {\n17|\tstore := setupStoreForTest(t)\n18|\ttarget := filepath.Join(store.root, trustFileName)\n19|\tbefore, err := os.ReadFile(target)\n20|\tif err != nil {\n21|\t\tt.Fatal(err)\n22|\t}\n23|\tdocument, err := EncodeTrust(TrustStore{Generation: 99})\n24|\tif err != nil {\n25|\t\tt.Fatal(err)\n26|\t}\n27|\tif err := commitDocument(HeldExclusive{}, store.fs, store.root, target, document); !errors.Is(err, ErrExclusiveHoldRequired) {\n28|\t\tt.Fatalf(\"commitDocument(zero hold) err = %v, want %v\", err, ErrExclusiveHoldRequired)\n29|\t}\n30|\tafter, err := os.ReadFile(target)\n31|\tif err != nil {\n32|\t\tt.Fatal(err)\n33|\t}\n34|\tif string(after) != string(before) {\n35|\t\tt.Fatal(\"commitDocument(zero hold) changed the committed document\")\n36|\t}\n37|\tentries, err := os.ReadDir(store.root)\n38|\tif err != nil {\n39|\t\tt.Fatal(err)\n40|\t}\n41|\tfor _, entry := range entries {\n42|\t\tif len(entry.Name()) >= len(stagePrefix) && entry.Name()[:len(stagePrefix)] == stagePrefix {\n43|\t\t\tt.Fatalf(\"commitDocument(zero hold) left staging file %q\", entry.Name())\n44|\t\t}\n45|\t}\n46|}\n47|\n48|func TestCommitDocumentRefusesReleasedHold(t *testing.T) {\n49|\tstore := setupStoreForTest(t)\n50|\thold, unlock, err := store.lock.exclusiveHold()\n51|\tif err != nil {\n52|\t\tt.Fatal(err)\n53|\t}\n54|\tunlock()\n55|\tdocument, err := EncodeTrust(TrustStore{Generation: 99})\n56|\tif err != nil {\n57|\t\tt.Fatal(err)\n58|\t}\n59|\tif err := commitDocument(hold, store.fs, store.root, filepath.Join(store.root, trustFileName), document); !errors.Is(err, ErrExclusiveHoldRequired) {\n60|\t\tt.Fatalf(\"commitDocument(released hold) err = %v, want %v\", err, ErrExclusiveHoldRequired)\n61|\t}\n62|\tsnapshot, err := store.ReadSnapshot()\n63|\tif err != nil {\n64|\t\tt.Fatal(err)\n65|\t}\n66|\tif snapshot.Generation == 99 {\n67|\t\tt.Fatal(\"commitDocument(released hold) changed the committed generation\")\n68|\t}\n69|}\n70|\n71|func TestRemoveMarkerLockedRefusesZeroHold(t *testing.T) {\n72|\tsource := []byte(\"source configuration\\n\")\n73|\treplacement := []byte(\"replacement configuration\\n\")\n74|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n75|\tstageJointMarker(t, store, jointMarker(configPath, source, replacement, snapshot.Generation))\n76|\tif err := removeMarkerLocked(HeldExclusive{}, store.fs, store.root); !errors.Is(err, ErrExclusiveHoldRequired) {\n77|\t\tt.Fatalf(\"removeMarkerLocked(zero hold) err = %v, want %v\", err, ErrExclusiveHoldRequired)\n78|\t}\n79|\tassertMarkerKept(t, store)\n80|}\n81|\n82|// WithExclusiveHold must actually serialize: a transaction racing a held\n83|// hold waits it out instead of landing beside it. The hold-no-lock\n84|// narrowing plant runs the boundary with a genuine token but no lock; it\n85|// is killed here because the racing revocation then completes early.\n86|func TestWithExclusiveHoldSerializesWithTransaction(t *testing.T) {\n87|\tstore := setupStoreForTest(t)\n88|\tcredential, err := store.Issue(testHostA, testNow)\n89|\tif err != nil {\n90|\t\tt.Fatal(err)\n91|\t}\n92|\tentered, release := make(chan struct{}), make(chan struct{})\n93|\tholderDone := make(chan error, 1)\n94|\tgo func() {\n95|\t\tholderDone <- store.WithExclusiveHold(func(HeldExclusive) error {\n96|\t\t\tclose(entered)\n97|\t\t\t<-release\n98|\t\t\treturn nil\n99|\t\t})\n100|\t}()\n101|\tselect {\n102|\tcase <-entered:\n103|\tcase <-time.After(10 * time.Second):\n104|\t\tt.Fatal(\"hold boundary did not start\")\n105|\t}\n106|\trevoked := make(chan error, 1)\n107|\tgo func() { revoked <- store.Revoke(credential) }()\n108|\tselect {\n109|\tcase err := <-revoked:\n110|\t\tt.Fatalf(\"revocation completed while the exclusive hold was live: err=%v\", err)\n111|\tcase <-time.After(250 * time.Millisecond):\n112|\t}\n113|\tclose(release)\n114|\tif err := <-holderDone; err != nil {\n115|\t\tt.Fatal(err)\n116|\t}\n117|\tselect {\n118|\tcase err := <-revoked:\n119|\t\tif err != nil {\n120|\t\t\tt.Fatal(err)\n121|\t\t}\n122|\tcase <-time.After(10 * time.Second):\n123|\t\tt.Fatal(\"revocation did not complete after the hold released\")\n124|\t}\n125|}\n126|\n127|// WithExclusiveHold converges leftover joint intent before running its\n128|// boundary, so a legacy migration coordinated through it never builds\n129|// beside an unresolved marker.\n130|func TestWithExclusiveHoldConvergesLeftover(t *testing.T) {\n131|\tsource := []byte(\"source configuration\\n\")\n132|\treplacement := []byte(\"replacement configuration\\n\")\n133|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n134|\tstageJointMarker(t, store, jointMarker(configPath, source, replacement, snapshot.Generation))\n135|\tcalled := false\n136|\tif err := store.WithExclusiveHold(func(HeldExclusive) error {\n137|\t\tcalled = true\n138|\t\treturn nil\n139|\t}); err != nil {\n140|\t\tt.Fatal(err)\n141|\t}\n142|\tif !called {\n143|\t\tt.Fatal(\"WithExclusiveHold did not run its boundary\")\n144|\t}\n145|\tassertMarkerGone(t, store)\n146|}\n147|\n148|// resolveFailedReplace must not discard intent when the replacement is\n149|// durable despite the reported failure: the marker is kept (the restore\n150|// fails here) and a surviving reader converges forward instead of\n151|// admitting the replacement at the old generation. The\n152|// resolve-source-skip narrowing plant treats durable replacement as\n153|// intact; it is killed here because the marker is then gone and the\n154|// surviving read admits the old generation.\n155|func TestResolveFailedReplaceKeepsMarker(t *testing.T) {\n156|\tsource := []byte(\"source configuration\\n\")\n157|\treplacement := []byte(\"replacement configuration\\n\")\n158|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n159|\tmarker := jointMarker(configPath, source, replacement, snapshot.Generation)\n160|\trestoreErr := errors.New(\"injected restore failure\")\n161|\t_, err := store.JointCommit(marker,\n162|\t\tfunc(TrustStore) error { return nil },\n163|\t\tfunc(HeldExclusive) error {\n164|\t\t\tif err := os.WriteFile(configPath, replacement, 0o600); err != nil {\n165|\t\t\t\treturn err\n166|\t\t\t}\n167|\t\t\treturn errors.New(\"injected replace failure after durable rename\")\n168|\t\t},\n169|\t\tfunc(HeldExclusive) error { return restoreErr })\n170|\tif !errors.Is(err, ErrJointCompensationFailed) {\n171|\t\tt.Fatalf(\"JointCommit err = %v, want %v\", err, ErrJointCompensationFailed)\n172|\t}\n173|\tassertMarkerKept(t, store)\n174|\tconverged, err := store.ReadSnapshot()\n175|\tif err != nil {\n176|\t\tt.Fatalf(\"surviving ReadSnapshot err = %v, want forward convergence\", err)\n177|\t}\n178|\tif converged.Generation != snapshot.Generation+1 {\n179|\t\tt.Fatalf(\"surviving generation = %d, want %d\", converged.Generation, snapshot.Generation+1)\n180|\t}\n181|\tassertMarkerGone(t, store)\n182|\tinstalled, err := os.ReadFile(configPath)\n183|\tif err != nil {\n184|\t\tt.Fatal(err)\n185|\t}\n186|\tif string(installed) != string(replacement) {\n187|\t\tt.Fatal(\"converged pair does not carry the durable replacement\")\n188|\t}\n189|}","final_result":true}}}
