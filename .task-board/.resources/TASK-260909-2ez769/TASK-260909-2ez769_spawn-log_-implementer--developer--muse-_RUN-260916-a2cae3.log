{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c935","stream":{"kind":"session","id":"01a0ac04-3aa6-7f83-a640-4d27d55c8cba"},"sequence":757,"recorded_at":1780531400001509,"record_type":"event","durability":"durable","causation_id":"792618d5-7c92-47f4-9c2f-44170e04457d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"792618d5-7c92-47f4-9c2f-44170e04457d","run_stream":{"kind":"run","id":"792618d5-7c92-47f4-9c2f-44170e04457d"},"task_stream":{"kind":"task","id":"01a0ac06-951d-72c1-8bf1-e5fdf6e116bd"},"task_id":"01a0ac06-951d-72c1-8bf1-e5fdf6e116bd","event":{"kind":"output","task_id":"01a0ac06-951d-72c1-8bf1-e5fdf6e116bd","chunk":"Read text file `internal/hosttrust/joint.go`.\n(499 line(s) above)\n500|// transaction entry point converges here under the authorization lock,\n501|// while recovery itself stays the single convergence implementation. The\n502|// caller must hold the exclusive lock: convergence can bump the generation\n503|// and remove the marker. Shared-lock readers upgrade to exclusive when a\n504|// marker is present (see readSnapshot); when no marker is present the\n505|// shared fast path needs no write. A refused recovery fails the caller\n506|// with the marker kept for operator resolution.\n507|func convergeLocked(hold HeldExclusive, filesystem FileSystem, root string) error {\n508|\tpresent, err := markerPresent(filesystem, root)\n509|\tif err != nil {\n510|\t\treturn err\n511|\t}\n512|\tif !present {\n513|\t\treturn nil\n514|\t}\n515|\t_, err = recoverLocked(hold, filesystem, root)\n516|\treturn err\n517|}\n518|\n519|func removeMarkerLocked(hold HeldExclusive, filesystem FileSystem, root string) error {\n520|\tif err := requireHold(hold); err != nil {\n521|\t\treturn err\n522|\t}\n523|\tif err := filesystem.Remove(pendingPath(root)); err != nil && !os.IsNotExist(err) {\n524|\t\treturn trustError(TrustError{Operation: \"remove joint marker\", Err: errors.Join(ErrTrustDurability, err)})\n525|\t}\n526|\tif err := syncDir(filesystem, root); err != nil {\n527|\t\treturn trustError(TrustError{Operation: \"sync joint marker directory\", Err: errors.Join(ErrTrustDurability, err)})\n528|\t}\n529|\treturn nil\n530|}","final_result":true}}}
