{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8ff","stream":{"kind":"session","id":"01a0ac04-3aa6-7f83-a640-4d27d55c8cba"},"sequence":730,"recorded_at":1780531400001455,"record_type":"event","durability":"durable","causation_id":"792618d5-7c92-47f4-9c2f-44170e04457d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"792618d5-7c92-47f4-9c2f-44170e04457d","run_stream":{"kind":"run","id":"792618d5-7c92-47f4-9c2f-44170e04457d"},"task_stream":{"kind":"task","id":"01a0ac06-86d9-72e2-9935-755fd8b36075"},"task_id":"01a0ac06-86d9-72e2-9935-755fd8b36075","event":{"kind":"output","task_id":"01a0ac06-86d9-72e2-9935-755fd8b36075","chunk":"Read text file `internal/hosttrust/joint.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"crypto/sha256\"\n6|\t\"encoding/hex\"\n7|\t\"encoding/json\"\n8|\t\"errors\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\t\"strconv\"\n12|)\n13|\n14|// pendingCommitFileName is the durable intent marker for one joint\n15|// config-plus-trust commit. It lives beside trust.json under the same\n16|// owner-only custody and crash-durable write discipline.\n17|const pendingCommitFileName = \"pending-commit.json\"\n18|\n19|// Joint operations coupled to a trust generation bump.\n20|const (\n21|\tJointApplyV4    = \"apply-v4\"\n22|\tJointRollbackV4 = \"rollback-v4\"\n23|)\n24|\n25|// PendingCommit is the durable intent record for one joint commit. The\n26|// hashes pin the exact configuration bytes the operator confirmed; the\n27|// source generation pins the trust state they were rendered against. Only\n28|// the confirmed replacement may complete forward; anything else aborts or\n29|// refuses on restart.\n30|type PendingCommit struct {\n31|\tSchema            string `json:\"schema\"`\n32|\tSchemaVersion     string `json:\"schema_version\"`\n33|\tOperation         string `json:\"operation\"`\n34|\tConfigPath        string `json:\"config_path\"`\n35|\tSourceSHA256      string `json:\"source_sha256\"`\n36|\tReplacementSHA256 string `json:\"replacement_sha256\"`\n37|\tSourceGeneration  uint64 `json:\"source_generation\"`\n38|\tBackupPath        string `json:\"backup_path\"`\n39|}\n40|\n41|// SHA256HexOf returns the lowercase hex SHA-256 of document bytes for\n42|// marker pins. It exposes no key material: markers pin configuration bytes\n43|// only, never credentials.\n44|func SHA256HexOf(document []byte) string {\n45|\tdigest := sha256.Sum256(document)\n46|\treturn hex.EncodeToString(digest[:])\n47|}\n48|\n49|func encodePendingCommit(marker PendingCommit) ([]byte, error) {\n50|\tif err := checkPendingCommit(marker); err != nil {\n51|\t\treturn nil, err\n52|\t}\n53|\tdocument, err := json.Marshal(marker)\n54|\tif err != nil {\n55|\t\treturn nil, trustError(TrustError{Operation: \"encode joint commit\", Err: errors.Join(ErrTrustDurability, err)})\n56|\t}\n57|\treturn document, nil\n58|}\n59|\n60|func checkPendingCommit(marker PendingCommit) error {\n61|\tconst operation = \"validate joint commit\"\n62|\tif marker.Schema != \"urn:ax:schema:host-pending-commit\" || marker.SchemaVersion != \"1.0.0\" {\n63|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n64|\t}\n65|\tif marker.Operation != JointApplyV4 && marker.Operation != JointRollbackV4 {\n66|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n67|\t}\n68|\tif !filepath.IsAbs(marker.ConfigPath) || marker.BackupPath == \"\" {\n69|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n70|\t}\n71|\tfor _, digest := range []string{marker.SourceSHA256, marker.ReplacementSHA256} {\n72|\t\traw, err := hex.DecodeString(digest)\n73|\t\tif err != nil || len(raw) != sha256.Size {\n74|\t\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n75|\t\t}\n76|\t}\n77|\tif marker.SourceSHA256 == marker.ReplacementSHA256 {\n78|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n79|\t}\n80|\tif marker.SourceGeneration == 0 || marker.SourceGeneration > MaxGeneration {\n81|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n82|\t}\n83|\treturn nil\n84|}\n85|\n86|func decodePendingCommit(document []byte) (PendingCommit, error) {\n87|\tvar marker PendingCommit\n88|\tif err := rejectDuplicateKeys(document); err != nil {\n89|\t\treturn PendingCommit{}, err\n90|\t}\n91|\t// The generation must be a bare JSON number, never a quoted string:\n92|\t// validate it through the same uint53 discipline as the trust document\n93|\t// before the struct decode, so a quoted number refuses as invalid\n94|\t// state rather than as a syntax error.\n95|\traw := map[string]json.RawMessage{}\n96|\tdecoder := json.NewDecoder(bytes.NewReader(document))\n97|\tdecoder.UseNumber()\n98|\tif err := decoder.Decode(&raw); err != nil {\n99|\t\treturn PendingCommit{}, trustError(TrustError{Operation: \"decode joint commit\", Err: errors.Join(ErrTrustDecode, err)})\n100|\t}\n101|\tgeneration, err := decodeMarkerGeneration(raw)\n102|\tif err != nil {\n103|\t\treturn PendingCommit{}, err\n104|\t}\n105|\tdecoder = json.NewDecoder(bytes.NewReader(document))\n106|\tdecoder.DisallowUnknownFields()\n107|\tdecoder.UseNumber()\n108|\tif err := decoder.Decode(&marker); err != nil {\n109|\t\treturn PendingCommit{}, trustError(TrustError{Operation: \"decode joint commit\", Err: errors.Join(ErrTrustDecode, err)})\n110|\t}\n111|\tif decoder.More() {\n112|\t\treturn PendingCommit{}, trustError(TrustError{Operation: \"decode joint commit\", Err: ErrTrustDecode})\n113|\t}\n114|\tmarker.SourceGeneration = generation\n115|\tif err := checkPendingCommit(marker); err != nil {\n116|\t\treturn PendingCommit{}, err\n117|\t}\n118|\treturn marker, nil\n119|}\n120|\n121|func parseUint53(text string) (uint64, error) {\n122|\tif text == \"\" {\n123|\t\treturn 0, errors.New(\"empty generation number\")\n124|\t}\n125|\tfor _, digit := range text {\n126|\t\tif digit < '0' || digit > '9' {\n127|\t\t\treturn 0, errors.New(\"non-digit generation number\")\n128|\t\t}\n129|\t}\n130|\tparsed, err := strconv.ParseUint(text, 10, 64)\n131|\tif err != nil {\n132|\t\treturn 0, err\n133|\t}\n134|\tif parsed == 0 || parsed > MaxGeneration {\n135|\t\treturn 0, errors.New(\"generation outside uint53\")\n136|\t}\n137|\treturn parsed, nil\n138|}\n139|\n140|func decodeMarkerGeneration(shape map[string]json.RawMessage) (uint64, error) {\n141|\traw, ok := shape[\"source_generation\"]\n142|\tif !ok {\n143|\t\treturn 0, trustError(TrustError{Operation: \"decode joint generation\", Err: ErrTrustValidation})\n144|\t}\n145|\tvar value any\n146|\tif err := strictJSONDecoder(raw).Decode(&value); err != nil {\n147|\t\treturn 0, trustError(TrustError{Operation: \"decode joint generation\", Err: errors.Join(ErrTrustDecode, err)})\n148|\t}\n149|\tnumber, ok := value.(json.Number)\n150|\tif !ok {\n151|\t\treturn 0, trustError(TrustError{Operation: \"decode joint generation\", Err: ErrTrustValidation})\n152|\t}\n153|\tparsed, err := parseUint53(number.String())\n154|\tif err != nil {\n155|\t\treturn 0, trustError(TrustError{Operation: \"decode joint generation\", Err: ErrTrustValidation})\n156|\t}\n157|\treturn parsed, nil\n158|}\n159|\n160|// JointCommit runs one crash-atomic authorization-generation commit coupled\n161|// to an external durable replacement (Configuration 4.0.0 apply or\n162|// rollback). Under a single exclusive hold it converges any leftover\n163|// intent, revalidates the confirmed pins against committed trust, stages\n164|// the durable intent marker, runs replace (the configuration file\n165|// replacement), bumps the generation, and removes the marker.\n166|//\n167|//   - Leftover intent from a crashed commit converges first: a marker the\n168|//     replacement committed completes forward (moving the generation, so\n169|//     stale markers still refuse below); an unreplaced marker aborts. A\n170|//     refused leftover fails the commit with the marker kept.\n171|//   - revalidate runs inside the lock: the preview, source and generation\n172|//     checks it repeats there close the concurrent-change window between\n173|//     the unlocked fast-fail checks and the commit.\n174|//   - A replace failure resolves against the confirmed pins before the\n175|//     marker moves: the configuration still equal to the source hash\n176|//     aborts with no generation change and the original error, while a\n177|//     replacement that landed despite the failure (or state that can no\n178|//     longer be proven) runs the same compensation protocol as a failed\n179|//     bump, restoring the source or keeping the marker for operator\n180|//     resolution. An error alone never proves the configuration is\n181|//     untouched.\n182|//   - A trust-commit failure after replace compensates under the same\n183|//     hold: the marker and the configuration are revalidated against the\n184|//     confirmed pins, restore reinstalls the source bytes, and the marker\n185|//     aborts with no generation change. Compensation never releases the\n186|//     hold, so no surviving reader, writer or held boundary can converge\n187|//     the replacement between the failure and the restore. A compensation\n188|//     that cannot complete keeps the marker for operator resolution and\n189|//     joins ErrJointCompensationFailed. The committed trust itself is never\n190|//     re-read for the decision: the fault that broke the bump (for example\n191|//     failed custody) must not break the abort, and an apparently durable\n192|//     bump is still unproven exactly because its commit reported failure.\n193|//   - Marker-removal failure after a durable bump still returns success:\n194|//     the joint state is already forward-complete, and the next converged\n195|//     read or open removes the marker.\n196|//\n197|// Only process crashes are covered by the restart protocol below; power\n198|// loss additionally depends on the disk honoring fsync, which no test here\n199|// can establish. Crash tests terminate a real child process at the\n200|// replacement seam and re-read through surviving and reopened stores.\n201|//\n202|// The replace and restore closures receive the live hold to pass to\n203|// token-gated pair writers; only closures invoked by this commit ever see\n204|// a genuine hold.\n205|func (store *Store) JointCommit(marker PendingCommit, revalidate func(current TrustStore) error, replace func(HeldExclusive) error, restore func(HeldExclusive) error) (uint64, error) {\n206|\tconst operation = \"joint commit\"\n207|\tif revalidate == nil || replace == nil || restore == nil {\n208|\t\treturn 0, trustError(TrustError{Operation: operation, Err: ErrTrustDurability})\n209|\t}\n210|\thold, unlock, err := store.lock.exclusiveHold()\n211|\tif err != nil {\n212|\t\treturn 0, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustDurability, err)})\n213|\t}\n214|\tdefer unlock()\n215|\tif err := convergeLocked(hold, store.fs, store.root); err != nil {\n216|\t\treturn 0, err\n217|\t}\n218|\tcommitted, err := loadCommitted(store.fs, store.root)\n219|\tif err != nil {\n220|\t\treturn 0, err\n221|\t}\n222|\tif err := revalidate(committed); err != nil {\n223|\t\treturn 0, err\n224|\t}\n225|\tif marker.SourceGeneration != committed.Generation {\n226|\t\treturn 0, trustError(TrustError{Operation: operation, Err: ErrStaleGeneration})\n227|\t}\n228|\tif err := checkPendingCommit(marker); err != nil {\n229|\t\treturn 0, err\n230|\t}\n231|\tif _, err := store.fs.Lstat(pendingPath(store.root)); err == nil {\n232|\t\treturn 0, trustError(TrustError{Operation: operation, Err: ErrJointIntervened})\n233|\t} else if !os.IsNotExist(err) {\n234|\t\treturn 0, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n235|\t}\n236|\tencoded, err := encodePendingCommit(marker)\n237|\tif err != nil {\n238|\t\treturn 0, err\n239|\t}\n240|\tif err := commitDocument(hold, store.fs, store.root, pendingPath(store.root), encoded); err != nil {\n241|\t\treturn 0, err\n242|\t}\n243|\tif err := replace(hold); err != nil {\n244|\t\treturn 0, resolveFailedReplace(hold, store.fs, store.root, marker, err, restore)\n245|\t}\n246|\tvar generation uint64\n247|\tif err := transactLocked(hold, store.fs, store.root, func(trust *TrustStore) error {\n248|\t\tgeneration = trust.Generation + 1\n249|\t\treturn nil\n250|\t}); err != nil {\n251|\t\treturn 0, compensateLocked(hold, store.fs, store.root, marker, err, restore)\n252|\t}\n253|\t// The replacement and the bump are both durable: converge the marker\n254|\t// removal on next open when this cleanup itself is interrupted.\n255|\t_ = removeMarkerLocked(hold, store.fs, store.root)\n256|\treturn generation, nil\n257|}\n258|\n259|// resolveFailedReplace resolves a joint commit whose replace closure\n260|// reported failure. A replace error does not prove the configuration is\n261|// unchanged: the replacement rename may have landed with a later sync or\n262|// restoration step failing. Only configuration still equal to the source\n263|// pin aborts with the marker removed and the original error; anything\n264|// else (durable replacement, diverged bytes, unreadable state) runs the\n265|// common compensation protocol, which restores the source when it can be\n266|// proven and otherwise keeps the marker so readers refuse or converge\n267|// instead of admitting a changed configuration at the old generation.\n268|// The caller must hold the exclusive lock: no writer can move the\n269|// configuration between this resolution and the compensation it runs.\n270|func resolveFailedReplace(hold HeldExclusive, filesystem FileSystem, root string, intent PendingCommit, replaceErr error, restore func(HeldExclusive) error) error {\n271|\tconfiguration, err := filesystem.ReadFile(intent.ConfigPath)\n272|\tif err == nil && SHA256HexOf(configuration) == intent.SourceSHA256 {\n273|\t\t_ = removeMarkerLocked(hold, filesystem, root)\n274|\t\treturn replaceErr\n275|\t}\n276|\treturn compensateLocked(hold, filesystem, root, intent, replaceErr, restore)\n277|}\n278|\n279|// compensateLocked converges a joint commit whose replacement is durable\n280|// but whose generation bump failed with commitErr. The caller must hold\n281|// the exclusive authorization lock across the whole compensation: the\n282|// marker and the configuration are revalidated against the confirmed\n283|// intent, restore reinstalls the source bytes, and the marker aborts with\n284|// no generation change. Because the hold never lapses, no surviving\n285|// reader, writer or held boundary can converge the replacement between\n286|// the failure and the restore; the only way out is the clean abort or a\n287|// refused compensation with the marker kept.\n288|//\n289|//   - The marker is re-read and compared pin-for-pin with the staged\n290|//     intent: no in-protocol path changes it under the hold, so a\n291|//     mismatch, an undecodable marker or an unreadable marker path is an\n292|//     intervention that refuses with the marker kept. A vanished marker\n293|//     is the operator/sabotage remainder: the in-memory intent still pins\n294|//     the decision, and the marker is re-staged when the configuration\n295|//     matches neither pin so restart recovery resolves the pair instead\n296|//     of admitting it silently.\n297|//   - Configuration equal to the replacement hash runs restore, whose\n298|//     result is verified against the source hash before the marker\n299|//     aborts: a restore that reports success without reinstalling the\n300|//     source refuses as an intervention. Configuration already equal to\n301|//     the source hash aborts without running the restore.\n302|//   - A restore failure, an unreadable configuration, or configuration\n303|//     matching neither pin keeps the marker for operator resolution and\n304|//     joins ErrJointCompensationFailed. The configuration then stays at\n305|//     the replacement, which restart recovery completes forward once the\n306|//     underlying fault heals.\n307|func compensateLocked(hold HeldExclusive, filesystem FileSystem, root string, intent PendingCommit, commitErr error, restore func(HeldExclusive) error) error {\n308|\tconst operation = \"compensate joint commit\"\n309|\tfailed := func(cause error) error {\n310|\t\treturn trustError(TrustError{Operation: operation, Err: errors.Join(ErrJointReplacementDurable, ErrJointCompensationFailed, commitErr, cause)})\n311|\t}\n312|\treread, present, err := readCompensationMarker(filesystem, root)\n313|\tif err != nil {\n314|\t\treturn failed(err)\n315|\t}\n316|\tif present && reread != intent {\n317|\t\treturn failed(trustError(TrustError{Operation: \"validate joint marker\", Err: ErrJointIntervened}))\n318|\t}\n319|\tconfiguration, err := filesystem.ReadFile(intent.ConfigPath)\n320|\tif err != nil {\n321|\t\treturn failed(trustError(TrustError{Operation: \"read joint configuration\", Err: errors.Join(ErrTrustStoreUnreadable, err)}))\n322|\t}\n323|\tswitch SHA256HexOf(configuration) {\n324|\tcase intent.ReplacementSHA256:\n325|\t\tif err := restore(hold); err != nil {\n326|\t\t\treturn failed(err)\n327|\t\t}\n328|\t\trestored, err := filesystem.ReadFile(intent.ConfigPath)\n329|\t\tif err != nil {\n330|\t\t\treturn failed(trustError(TrustError{Operation: \"read joint configuration\", Err: errors.Join(ErrTrustStoreUnreadable, err)}))\n331|\t\t}\n332|\t\tif SHA256HexOf(restored) != intent.SourceSHA256 {\n333|\t\t\treturn failed(trustError(TrustError{Operation: \"validate joint restore\", Err: ErrJointIntervened}))\n334|\t\t}\n335|\tcase intent.SourceSHA256:\n336|\t\t// The replacement never landed: abort without running the\n337|\t\t// restore, which would only rewrite identical bytes.\n338|\tdefault:\n339|\t\tif !present {\n340|\t\t\t// Re-stage the intent so restart recovery resolves the\n341|\t\t\t// diverged pair instead of admitting it silently.\n342|\t\t\tif encoded, err := encodePendingCommit(intent); err == nil {\n343|\t\t\t\t_ = commitDocument(hold, filesystem, root, pendingPath(root), encoded)\n344|\t\t\t}\n345|\t\t}\n346|\t\treturn failed(trustError(TrustError{Operation: \"validate joint configuration\", Err: ErrJointIntervened}))\n347|\t}\n348|\tif present {\n349|\t\tif err := removeMarkerLocked(hold, filesystem, root); err != nil {\n350|\t\t\treturn failed(err)\n351|\t\t}\n352|\t}\n353|\treturn trustError(TrustError{Operation: \"commit joint generation\", Err: errors.Join(ErrJointReplacementDurable, commitErr)})\n354|}\n355|\n356|// readCompensationMarker re-reads the outstanding intent marker for\n357|// in-hold compensation. Absence is reported, never assumed from a failed\n358|// inspection; an existing marker is custody-verified and decoded exactly\n359|// like recovery verifies it. The present flag is meaningful only when err\n360|// is nil.\n361|func readCompensationMarker(filesystem FileSystem, root string) (marker PendingCommit, present bool, err error) {\n362|\tconst operation = \"read joint marker\"\n363|\tpath := pendingPath(root)\n364|\tinfo, statErr := filesystem.Lstat(path)\n365|\tif statErr != nil {\n366|\t\tif os.IsNotExist(statErr) {\n367|\t\t\treturn PendingCommit{}, false, nil\n368|\t\t}\n369|\t\treturn PendingCommit{}, false, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, statErr)})\n370|\t}\n371|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n372|\t\treturn PendingCommit{}, false, err\n373|\t}\n374|\tdocument, err := filesystem.ReadFile(path)\n375|\tif err != nil {\n376|\t\treturn PendingCommit{}, false, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n377|\t}\n378|\tmarker, err = decodePendingCommit(document)\n379|\tif err != nil {\n380|\t\treturn PendingCommit{}, false, err\n381|\t}\n382|\treturn marker, true, nil\n383|}\n384|\n385|// RecoverResult reports what one recovery pass found.\n386|type RecoverResult struct {\n387|\t// Found reports a marker was present at all.\n388|\tFound bool\n389|\t// Completed reports the replacement had committed and the generation\n390|\t// converged forward to source plus one (or already had).\n391|\tCompleted bool\n392|\t// Aborted reports the replacement had not committed: the marker was\n393|\t// removed with no generation change.\n394|\tAborted bool\n395|}\n396|\n397|// Recover converges one interrupted joint commit found on disk. It runs\n398|// automatically on Open, and is safe to call directly. Every other read,\n399|// admission and transaction entry point converges through the same logic\n400|// before exposing a snapshot (see convergeLocked), so surviving processes\n401|// converge exactly like reopened ones. In-hold error compensation (see\n402|// compensateLocked) aborts without a separate recovery pass; Recover\n403|// converges only markers a crash left behind:\n404|//\n405|//   - configuration equal to the replacement hash completes forward: a\n406|//     trust at the source generation bumps to source plus one; a trust\n407|//     already there only removes the marker.\n408|//   - configuration equal to the source hash aborts: the marker is removed\n409|//     with no generation change.\n410|//   - anything else (operator edit mid-flight, unreadable state) refuses\n411|//     and keeps the marker for operator resolution.\n412|//\n413|// A refused recovery fails the caller, so no reader can silently admit new\n414|// configuration with an old generation.\n415|func (store *Store) Recover() (RecoverResult, error) {\n416|\thold, unlock, err := store.lock.exclusiveHold()\n417|\tif err != nil {\n418|\t\treturn RecoverResult{}, trustError(TrustError{Operation: \"recover joint commit\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n419|\t}\n420|\tdefer unlock()\n421|\treturn recoverLocked(hold, store.fs, store.root)\n422|}\n423|\n424|func recoverLocked(hold HeldExclusive, filesystem FileSystem, root string) (RecoverResult, error) {\n425|\tconst operation = \"recover joint commit\"\n426|\tpath := pendingPath(root)\n427|\tif _, err := filesystem.Lstat(path); err != nil {\n428|\t\tif os.IsNotExist(err) {\n429|\t\t\treturn RecoverResult{}, nil\n430|\t\t}\n431|\t\treturn RecoverResult{}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n432|\t}\n433|\tinfo, err := filesystem.Lstat(path)\n434|\tif err != nil {\n435|\t\treturn RecoverResult{}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n436|\t}\n437|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n438|\t\treturn RecoverResult{}, err\n439|\t}\n440|\tdocument, err := filesystem.ReadFile(path)\n441|\tif err != nil {\n442|\t\treturn RecoverResult{}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n443|\t}\n444|\tmarker, err := decodePendingCommit(document)\n445|\tif err != nil {\n446|\t\treturn RecoverResult{Found: true}, err\n447|\t}\n448|\tconfiguration, err := filesystem.ReadFile(marker.ConfigPath)\n449|\tif err != nil {\n450|\t\treturn RecoverResult{Found: true}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n451|\t}\n452|\tswitch SHA256HexOf(configuration) {\n453|\tcase marker.ReplacementSHA256:\n454|\t\tcommitted, err := loadCommitted(filesystem, root)\n455|\t\tif err != nil {\n456|\t\t\treturn RecoverResult{Found: true}, err\n457|\t\t}\n458|\t\tswitch committed.Generation {\n459|\t\tcase marker.SourceGeneration:\n460|\t\t\tif err := transactLocked(hold, filesystem, root, func(*TrustStore) error { return nil }); err != nil {\n461|\t\t\t\treturn RecoverResult{Found: true}, err\n462|\t\t\t}\n463|\t\tcase marker.SourceGeneration + 1:\n464|\t\tdefault:\n465|\t\t\treturn RecoverResult{Found: true}, trustError(TrustError{Operation: operation, Err: ErrJointIntervened})\n466|\t\t}\n467|\t\tif err := removeMarkerLocked(hold, filesystem, root); err != nil {\n468|\t\t\treturn RecoverResult{Found: true}, err\n469|\t\t}\n470|\t\treturn RecoverResult{Found: true, Completed: true}, nil\n471|\tcase marker.SourceSHA256:\n472|\t\tif err := removeMarkerLocked(hold, filesystem, root); err != nil {\n473|\t\t\treturn RecoverResult{Found: true}, err\n474|\t\t}\n475|\t\treturn RecoverResult{Found: true, Aborted: true}, nil\n476|\tdefault:\n477|\t\treturn RecoverResult{Found: true}, trustError(TrustError{Operation: operation, Err: ErrJointIntervened})\n478|\t}\n479|}\n480|\n481|func pendingPath(root string) string { return filepath.Join(root, pendingCommitFileName) }\n482|\n483|// markerPresent reports whether a joint-commit intent marker is\n484|// outstanding. Absence must be established, never assumed: an unreadable\n485|// marker path refuses instead of reporting no marker.\n486|func markerPresent(filesystem FileSystem, root string) (bool, error) {\n487|\t_, err := filesystem.Lstat(pendingPath(root))\n488|\tif err == nil {\n489|\t\treturn true, nil\n490|\t}\n491|\tif os.IsNotExist(err) {\n492|\t\treturn false, nil\n493|\t}\n494|\treturn false, trustError(TrustError{Operation: \"inspect joint commit\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n495|}\n496|\n497|// convergeLocked converges one interrupted joint commit, if any, before\n498|// the caller exposes a snapshot or runs a boundary. It is the general\n499|// admission barrier for pending intent: every read, admission and\n500|// transaction entry point converges here under the authorization lock,\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c901","stream":{"kind":"session","id":"01a0ac04-3aa6-7f83-a640-4d27d55c8cba"},"sequence":731,"recorded_at":1780531400001457,"record_type":"event","durability":"durable","causation_id":"792618d5-7c92-47f4-9c2f-44170e04457d","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"792618d5-7c92-47f4-9c2f-44170e04457d","run_stream":{"kind":"run","id":"792618d5-7c92-47f4-9c2f-44170e04457d"},"task_stream":{"kind":"task","id":"01a0ac06-86d9-72e2-9935-755fd8b36075"},"task_id":"01a0ac06-86d9-72e2-9935-755fd8b36075","event":{"kind":"completed","task_id":"01a0ac06-86d9-72e2-9935-755fd8b36075"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c903","stream":{"kind":"session","id":"01a0ac04-3aa6-7f83-a640-4d27d55c8cba"},"sequence":732,"recorded_at":1780531400001459,"record_type":"event","durability":"durable","causation_id":"792618d5-7c92-47f4-9c2f-44170e04457d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"792618d5-7c92-47f4-9c2f-44170e04457d","run_stream":{"kind":"run","id":"792618d5-7c92-47f4-9c2f-44170e04457d"},"call_id":"call_01a0ac0684537032b580d48d514b5840","text":"Read text file `internal/hosttrust/joint.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"crypto/sha256\"\n6|\t\"encoding/hex\"\n7|\t\"encoding/json\"\n8|\t\"errors\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\t\"strconv\"\n12|)\n13|\n14|// pendingCommitFileName is the durable intent marker for one joint\n15|// config-plus-trust commit. It lives beside trust.json under the same\n16|// owner-only custody and crash-durable write discipline.\n17|const pendingCommitFileName = \"pending-commit.json\"\n18|\n19|// Joint operations coupled to a trust generation bump.\n20|const (\n21|\tJointApplyV4    = \"apply-v4\"\n22|\tJointRollbackV4 = \"rollback-v4\"\n23|)\n24|\n25|// PendingCommit is the durable intent record for one joint commit. The\n26|// hashes pin the exact configuration bytes the operator confirmed; the\n27|// source generation pins the trust state they were rendered against. Only\n28|// the confirmed replacement may complete forward; anything else aborts or\n29|// refuses on restart.\n30|type PendingCommit struct {\n31|\tSchema            string `json:\"schema\"`\n32|\tSchemaVersion     string `json:\"schema_version\"`\n33|\tOperation         string `json:\"operation\"`\n34|\tConfigPath        string `json:\"config_path\"`\n35|\tSourceSHA256      string `json:\"source_sha256\"`\n36|\tReplacementSHA256 string `json:\"replacement_sha256\"`\n37|\tSourceGeneration  uint64 `json:\"source_generation\"`\n38|\tBackupPath        string `json:\"backup_path\"`\n39|}\n40|\n41|// SHA256HexOf returns the lowercase hex SHA-256 of document bytes for\n42|// marker pins. It exposes no key material: markers pin configuration bytes\n43|// only, never credentials.\n44|func SHA256HexOf(document []byte) string {\n45|\tdigest := sha256.Sum256(document)\n46|\treturn hex.EncodeToString(digest[:])\n47|}\n48|\n49|func encodePendingCommit(marker PendingCommit) ([]byte, error) {\n50|\tif err := checkPendingCommit(marker); err != nil {\n51|\t\treturn nil, err\n52|\t}\n53|\tdocument, err := json.Marshal(marker)\n54|\tif err != nil {\n55|\t\treturn nil, trustError(TrustError{Operation: \"encode joint commit\", Err: errors.Join(ErrTrustDurability, err)})\n56|\t}\n57|\treturn document, nil\n58|}\n59|\n60|func checkPendingCommit(marker PendingCommit) error {\n61|\tconst operation = \"validate joint commit\"\n62|\tif marker.Schema != \"urn:ax:schema:host-pending-commit\" || marker.SchemaVersion != \"1.0.0\" {\n63|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n64|\t}\n65|\tif marker.Operation != JointApplyV4 && marker.Operation != JointRollbackV4 {\n66|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n67|\t}\n68|\tif !filepath.IsAbs(marker.ConfigPath) || marker.BackupPath == \"\" {\n69|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n70|\t}\n71|\tfor _, digest := range []string{marker.SourceSHA256, marker.ReplacementSHA256} {\n72|\t\traw, err := hex.DecodeString(digest)\n73|\t\tif err != nil || len(raw) != sha256.Size {\n74|\t\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n75|\t\t}\n76|\t}\n77|\tif marker.SourceSHA256 == marker.ReplacementSHA256 {\n78|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n79|\t}\n80|\tif marker.SourceGeneration == 0 || marker.SourceGeneration > MaxGeneration {\n81|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n82|\t}\n83|\treturn nil\n84|}\n85|\n86|func decodePendingCommit(document []byte) (PendingCommit, error) {\n87|\tvar marker PendingCommit\n88|\tif err := rejectDuplicateKeys(document); err != nil {\n89|\t\treturn PendingCommit{}, err\n90|\t}\n91|\t// The generation must be a bare JSON number, never a quoted string:\n92|\t// validate it through the same uint53 discipline as the trust document\n93|\t// before the struct decode, so a quoted number refuses as invalid\n94|\t// state rather than as a syntax error.\n95|\traw := map[string]json.RawMessage{}\n96|\tdecoder := json.NewDecoder(bytes.NewReader(document))\n97|\tdecoder.UseNumber()\n98|\tif err := decoder.Decode(&raw); err != nil {\n99|\t\treturn PendingCommit{}, trustError(TrustError{Operation: \"decode joint commit\", Err: errors.Join(ErrTrustDecode, err)})\n100|\t}\n101|\tgeneration, err := decodeMarkerGeneration(raw)\n102|\tif err != nil {\n103|\t\treturn PendingCommit{}, err\n104|\t}\n105|\tdecoder = json.NewDecoder(bytes.NewReader(document))\n106|\tdecoder.DisallowUnknownFields()\n107|\tdecoder.UseNumber()\n108|\tif err := decoder.Decode(&marker); err != nil {\n109|\t\treturn PendingCommit{}, trustError(TrustError{Operation: \"decode joint commit\", Err: errors.Join(ErrTrustDecode, err)})\n110|\t}\n111|\tif decoder.More() {\n112|\t\treturn PendingCommit{}, trustError(TrustError{Operation: \"decode joint commit\", Err: ErrTrustDecode})\n113|\t}\n114|\tmarker.SourceGeneration = generation\n115|\tif err := checkPendingCommit(marker); err != nil {\n116|\t\treturn PendingCommit{}, err\n117|\t}\n118|\treturn marker, nil\n119|}\n120|\n121|func parseUint53(text string) (uint64, error) {\n122|\tif text == \"\" {\n123|\t\treturn 0, errors.New(\"empty generation number\")\n124|\t}\n125|\tfor _, digit := range text {\n126|\t\tif digit < '0' || digit > '9' {\n127|\t\t\treturn 0, errors.New(\"non-digit generation number\")\n128|\t\t}\n129|\t}\n130|\tparsed, err := strconv.ParseUint(text, 10, 64)\n131|\tif err != nil {\n132|\t\treturn 0, err\n133|\t}\n134|\tif parsed == 0 || parsed > MaxGeneration {\n135|\t\treturn 0, errors.New(\"generation outside uint53\")\n136|\t}\n137|\treturn parsed, nil\n138|}\n139|\n140|func decodeMarkerGeneration(shape map[string]json.RawMessage) (uint64, error) {\n141|\traw, ok := shape[\"source_generation\"]\n142|\tif !ok {\n143|\t\treturn 0, trustError(TrustError{Operation: \"decode joint generation\", Err: ErrTrustValidation})\n144|\t}\n145|\tvar value any\n146|\tif err := strictJSONDecoder(raw).Decode(&value); err != nil {\n147|\t\treturn 0, trustError(TrustError{Operation: \"decode joint generation\", Err: errors.Join(ErrTrustDecode, err)})\n148|\t}\n149|\tnumber, ok := value.(json.Number)\n150|\tif !ok {\n151|\t\treturn 0, trustError(TrustError{Operation: \"decode joint generation\", Err: ErrTrustValidation})\n152|\t}\n153|\tparsed, err := parseUint53(number.String())\n154|\tif err != nil {\n155|\t\treturn 0, trustError(TrustError{Operation: \"decode joint generation\", Err: ErrTrustValidation})\n156|\t}\n157|\treturn parsed, nil\n158|}\n159|\n160|// JointCommit runs one crash-atomic authorization-generation commit coupled\n161|// to an external durable replacement (Configuration 4.0.0 apply or\n162|// rollback). Under a single exclusive hold it converges any leftover\n163|// intent, revalidates the confirmed pins against committed trust, stages\n164|// the durable intent marker, runs replace (the configuration file\n165|// replacement), bumps the generation, and removes the marker.\n166|//\n167|//   - Leftover intent from a crashed commit converges first: a marker the\n168|//     replacement committed completes forward (moving the generation, so\n169|//     stale markers still refuse below); an unreplaced marker aborts. A\n170|//     refused leftover fails the commit with the marker kept.\n171|//   - revalidate runs inside the lock: the preview, source and generation\n172|//     checks it repeats there close the concurrent-change window between\n173|//     the unlocked fast-fail checks and the commit.\n174|//   - A replace failure resolves against the confirmed pins before the\n175|//     marker moves: the configuration still equal to the source hash\n176|//     aborts with no generation change and the original error, while a\n177|//     replacement that landed despite the failure (or state that can no\n178|//     longer be proven) runs the same compensation protocol as a failed\n179|//     bump, restoring the source or keeping the marker for operator\n180|//     resolution. An error alone never proves the configuration is\n181|//     untouched.\n182|//   - A trust-commit failure after replace compensates under the same\n183|//     hold: the marker and the configuration are revalidated against the\n184|//     confirmed pins, restore reinstalls the source bytes, and the marker\n185|//     aborts with no generation change. Compensation never releases the\n186|//     hold, so no surviving reader, writer or held boundary can converge\n187|//     the replacement between the failure and the restore. A compensation\n188|//     that cannot complete keeps the marker for operator resolution and\n189|//     joins ErrJointCompensationFailed. The committed trust itself is never\n190|//     re-read for the decision: the fault that broke the bump (for example\n191|//     failed custody) must not break the abort, and an apparently durable\n192|//     bump is still unproven exactly because its commit reported failure.\n193|//   - Marker-removal failure after a durable bump still returns success:\n194|//     the joint state is already forward-complete, and the next converged\n195|//     read or open removes the marker.\n196|//\n197|// Only process crashes are covered by the restart protocol below; power\n198|// loss additionally depends on the disk honoring fsync, which no test here\n199|// can establish. Crash tests terminate a real child process at the\n200|// replacement seam and re-read through surviving and reopened stores.\n201|//\n202|// The replace and restore closures receive the live hold to pass to\n203|// token-gated pair writers; only closures invoked by this commit ever see\n204|// a genuine hold.\n205|func (store *Store) JointCommit(marker PendingCommit, revalidate func(current TrustStore) error, replace func(HeldExclusive) error, restore func(HeldExclusive) error) (uint64, error) {\n206|\tconst operation = \"joint commit\"\n207|\tif revalidate == nil || replace == nil || restore == nil {\n208|\t\treturn 0, trustError(TrustError{Operation: operation, Err: ErrTrustDurability})\n209|\t}\n210|\thold, unlock, err := store.lock.exclusiveHold()\n211|\tif err != nil {\n212|\t\treturn 0, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustDurability, err)})\n213|\t}\n214|\tdefer unlock()\n215|\tif err := convergeLocked(hold, store.fs, store.root); err != nil {\n216|\t\treturn 0, err\n217|\t}\n218|\tcommitted, err := loadCommitted(store.fs, store.root)\n219|\tif err != nil {\n220|\t\treturn 0, err\n221|\t}\n222|\tif err := revalidate(committed); err != nil {\n223|\t\treturn 0, err\n224|\t}\n225|\tif marker.SourceGeneration != committed.Generation {\n226|\t\treturn 0, trustError(TrustError{Operation: operation, Err: ErrStaleGeneration})\n227|\t}\n228|\tif err := checkPendingCommit(marker); err != nil {\n229|\t\treturn 0, err\n230|\t}\n231|\tif _, err := store.fs.Lstat(pendingPath(store.root)); err == nil {\n232|\t\treturn 0, trustError(TrustError{Operation: operation, Err: ErrJointIntervened})\n233|\t} else if !os.IsNotExist(err) {\n234|\t\treturn 0, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n235|\t}\n236|\tencoded, err := encodePendingCommit(marker)\n237|\tif err != nil {\n238|\t\treturn 0, err\n239|\t}\n240|\tif err := commitDocument(hold, store.fs, store.root, pendingPath(store.root), encoded); err != nil {\n241|\t\treturn 0, err\n242|\t}\n243|\tif err := replace(hold); err != nil {\n244|\t\treturn 0, resolveFailedReplace(hold, store.fs, store.root, marker, err, restore)\n245|\t}\n246|\tvar generation uint64\n247|\tif err := transactLocked(hold, store.fs, store.root, func(trust *TrustStore) error {\n248|\t\tgeneration = trust.Generation + 1\n249|\t\treturn nil\n250|\t}); err != nil {\n251|\t\treturn 0, compensateLocked(hold, store.fs, store.root, marker, err, restore)\n252|\t}\n253|\t// The replacement and the bump are both durable: converge the marker\n254|\t// removal on next open when this cleanup itself is interrupted.\n255|\t_ = removeMarkerLocked(hold, store.fs, store.root)\n256|\treturn generation, nil\n257|}\n258|\n259|// resolveFailedReplace resolves a joint commit whose replace closure\n260|// reported failure. A replace error does not prove the configuration is\n261|// unchanged: the replacement rename may have landed with a later sync or\n262|// restoration step failing. Only configuration still equal to the source\n263|// pin aborts with the marker removed and the original error; anything\n264|// else (durable replacement, diverged bytes, unreadable state) runs the\n265|// common compensation protocol, which restores the source when it can be\n266|// proven and otherwise keeps the marker so readers refuse or converge\n267|// instead of admitting a changed configuration at the old generation.\n268|// The caller must hold the exclusive lock: no writer can move the\n269|// configuration between this resolution and the compensation it runs.\n270|func resolveFailedReplace(hold HeldExclusive, filesystem FileSystem, root string, intent PendingCommit, replaceErr error, restore func(HeldExclusive) error) error {\n271|\tconfiguration, err := filesystem.ReadFile(intent.ConfigPath)\n272|\tif err == nil && SHA256HexOf(configuration) == intent.SourceSHA256 {\n273|\t\t_ = removeMarkerLocked(hold, filesystem, root)\n274|\t\treturn replaceErr\n275|\t}\n276|\treturn compensateLocked(hold, filesystem, root, intent, replaceErr, restore)\n277|}\n278|\n279|// compensateLocked converges a joint commit whose replacement is durable\n280|// but whose generation bump failed with commitErr. The caller must hold\n281|// the exclusive authorization lock across the whole compensation: the\n282|// marker and the configuration are revalidated against the confirmed\n283|// intent, restore reinstalls the source bytes, and the marker aborts with\n284|// no generation change. Because the hold never lapses, no surviving\n285|// reader, writer or held boundary can converge the replacement between\n286|// the failure and the restore; the only way out is the clean abort or a\n287|// refused compensation with the marker kept.\n288|//\n289|//   - The marker is re-read and compared pin-for-pin with the staged\n290|//     intent: no in-protocol path changes it under the hold, so a\n291|//     mismatch, an undecodable marker or an unreadable marker path is an\n292|//     intervention that refuses with the marker kept. A vanished marker\n293|//     is the operator/sabotage remainder: the in-memory intent still pins\n294|//     the decision, and the marker is re-staged when the configuration\n295|//     matches neither pin so restart recovery resolves the pair instead\n296|//     of admitting it silently.\n297|//   - Configuration equal to the replacement hash runs restore, whose\n298|//     result is verified against the source hash before the marker\n299|//     aborts: a restore that reports success without reinstalling the\n300|//     source refuses as an intervention. Configuration already equal to\n301|//     the source hash aborts without running the restore.\n302|//   - A restore failure, an unreadable configuration, or configuration\n303|//     matching neither pin keeps the marker for operator resolution and\n304|//     joins ErrJointCompensationFailed. The configuration then stays at\n305|//     the replacement, which restart recovery completes forward once the\n306|//     underlying fault heals.\n307|func compensateLocked(hold HeldExclusive, filesystem FileSystem, root string, intent PendingCommit, commitErr error, restore func(HeldExclusive) error) error {\n308|\tconst operation = \"compensate joint commit\"\n309|\tfailed := func(cause error) error {\n310|\t\treturn trustError(TrustError{Operation: operation, Err: errors.Join(ErrJointReplacementDurable, ErrJointCompensationFailed, commitErr, cause)})\n311|\t}\n312|\treread, present, err := readCompensationMarker(filesystem, root)\n313|\tif err != nil {\n314|\t\treturn failed(err)\n315|\t}\n316|\tif present && reread != intent {\n317|\t\treturn failed(trustError(TrustError{Operation: \"validate joint marker\", Err: ErrJointIntervened}))\n318|\t}\n319|\tconfiguration, err := filesystem.ReadFile(intent.ConfigPath)\n320|\tif err != nil {\n321|\t\treturn failed(trustError(TrustError{Operation: \"read joint configuration\", Err: errors.Join(ErrTrustStoreUnreadable, err)}))\n322|\t}\n323|\tswitch SHA256HexOf(configuration) {\n324|\tcase intent.ReplacementSHA256:\n325|\t\tif err := restore(hold); err != nil {\n326|\t\t\treturn failed(err)\n327|\t\t}\n328|\t\trestored, err := filesystem.ReadFile(intent.ConfigPath)\n329|\t\tif err != nil {\n330|\t\t\treturn failed(trustError(TrustError{Operation: \"read joint configuration\", Err: errors.Join(ErrTrustStoreUnreadable, err)}))\n331|\t\t}\n332|\t\tif SHA256HexOf(restored) != intent.SourceSHA256 {\n333|\t\t\treturn failed(trustError(TrustError{Operation: \"validate joint restore\", Err: ErrJointIntervened}))\n334|\t\t}\n335|\tcase intent.SourceSHA256:\n336|\t\t// The replacement never landed: abort without running the\n337|\t\t// restore, which would only rewrite identical bytes.\n338|\tdefault:\n339|\t\tif !present {\n340|\t\t\t// Re-stage the intent so restart recovery resolves the\n341|\t\t\t// diverged pair instead of admitting it silently.\n342|\t\t\tif encoded, err := encodePendingCommit(intent); err == nil {\n343|\t\t\t\t_ = commitDocument(hold, filesystem, root, pendingPath(root), encoded)\n344|\t\t\t}\n345|\t\t}\n346|\t\treturn failed(trustError(TrustError{Operation: \"validate joint configuration\", Err: ErrJointIntervened}))\n347|\t}\n348|\tif present {\n349|\t\tif err := removeMarkerLocked(hold, filesystem, root); err != nil {\n350|\t\t\treturn failed(err)\n351|\t\t}\n352|\t}\n353|\treturn trustError(TrustError{Operation: \"commit joint generation\", Err: errors.Join(ErrJointReplacementDurable, commitErr)})\n354|}\n355|\n356|// readCompensationMarker re-reads the outstanding intent marker for\n357|// in-hold compensation. Absence is reported, never assumed from a failed\n358|// inspection; an existing marker is custody-verified and decoded exactly\n359|// like recovery verifies it. The present flag is meaningful only when err\n360|// is nil.\n361|func readCompensationMarker(filesystem FileSystem, root string) (marker PendingCommit, present bool, err error) {\n362|\tconst operation = \"read joint marker\"\n363|\tpath := pendingPath(root)\n364|\tinfo, statErr := filesystem.Lstat(path)\n365|\tif statErr != nil {\n366|\t\tif os.IsNotExist(statErr) {\n367|\t\t\treturn PendingCommit{}, false, nil\n368|\t\t}\n369|\t\treturn PendingCommit{}, false, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, statErr)})\n370|\t}\n371|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n372|\t\treturn PendingCommit{}, false, err\n373|\t}\n374|\tdocument, err := filesystem.ReadFile(path)\n375|\tif err != nil {\n376|\t\treturn PendingCommit{}, false, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n377|\t}\n378|\tmarker, err = decodePendingCommit(document)\n379|\tif err != nil {\n380|\t\treturn PendingCommit{}, false, err\n381|\t}\n382|\treturn marker, true, nil\n383|}\n384|\n385|// RecoverResult reports what one recovery pass found.\n386|type RecoverResult struct {\n387|\t// Found reports a marker was present at all.\n388|\tFound bool\n389|\t// Completed reports the replacement had committed and the generation\n390|\t// converged forward to source plus one (or already had).\n391|\tCompleted bool\n392|\t// Aborted reports the replacement had not committed: the marker was\n393|\t// removed with no generation change.\n394|\tAborted bool\n395|}\n396|\n397|// Recover converges one interrupted joint commit found on disk. It runs\n398|// automatically on Open, and is safe to call directly. Every other read,\n399|// admission and transaction entry point converges through the same logic\n400|// before exposing a snapshot (see convergeLocked), so surviving processes\n401|// converge exactly like reopened ones. In-hold error compensation (see\n402|// compensateLocked) aborts without a separate recovery pass; Recover\n403|// converges only markers a crash left behind:\n404|//\n405|//   - configuration equal to the replacement hash completes forward: a\n406|//     trust at the source generation bumps to source plus one; a trust\n407|//     already there only removes the marker.\n408|//   - configuration equal to the source hash aborts: the marker is removed\n409|//     with no generation change.\n410|//   - anything else (operator edit mid-flight, unreadable state) refuses\n411|//     and keeps the marker for operator resolution.\n412|//\n413|// A refused recovery fails the caller, so no reader can silently admit new\n414|// configuration with an old generation.\n415|func (store *Store) Recover() (RecoverResult, error) {\n416|\thold, unlock, err := store.lock.exclusiveHold()\n417|\tif err != nil {\n418|\t\treturn RecoverResult{}, trustError(TrustError{Operation: \"recover joint commit\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n419|\t}\n420|\tdefer unlock()\n421|\treturn recoverLocked(hold, store.fs, store.root)\n422|}\n423|\n424|func recoverLocked(hold HeldExclusive, filesystem FileSystem, root string) (RecoverResult, error) {\n425|\tconst operation = \"recover joint commit\"\n426|\tpath := pendingPath(root)\n427|\tif _, err := filesystem.Lstat(path); err != nil {\n428|\t\tif os.IsNotExist(err) {\n429|\t\t\treturn RecoverResult{}, nil\n430|\t\t}\n431|\t\treturn RecoverResult{}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n432|\t}\n433|\tinfo, err := filesystem.Lstat(path)\n434|\tif err != nil {\n435|\t\treturn RecoverResult{}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n436|\t}\n437|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n438|\t\treturn RecoverResult{}, err\n439|\t}\n440|\tdocument, err := filesystem.ReadFile(path)\n441|\tif err != nil {\n442|\t\treturn RecoverResult{}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n443|\t}\n444|\tmarker, err := decodePendingCommit(document)\n445|\tif err != nil {\n446|\t\treturn RecoverResult{Found: true}, err\n447|\t}\n448|\tconfiguration, err := filesystem.ReadFile(marker.ConfigPath)\n449|\tif err != nil {\n450|\t\treturn RecoverResult{Found: true}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n451|\t}\n452|\tswitch SHA256HexOf(configuration) {\n453|\tcase marker.ReplacementSHA256:\n454|\t\tcommitted, err := loadCommitted(filesystem, root)\n455|\t\tif err != nil {\n456|\t\t\treturn RecoverResult{Found: true}, err\n457|\t\t}\n458|\t\tswitch committed.Generation {\n459|\t\tcase marker.SourceGeneration:\n460|\t\t\tif err := transactLocked(hold, filesystem, root, func(*TrustStore) error { return nil }); err != nil {\n461|\t\t\t\treturn RecoverResult{Found: true}, err\n462|\t\t\t}\n463|\t\tcase marker.SourceGeneration + 1:\n464|\t\tdefault:\n465|\t\t\treturn RecoverResult{Found: true}, trustError(TrustError{Operation: operation, Err: ErrJointIntervened})\n466|\t\t}\n467|\t\tif err := removeMarkerLocked(hold, filesystem, root); err != nil {\n468|\t\t\treturn RecoverResult{Found: true}, err\n469|\t\t}\n470|\t\treturn RecoverResult{Found: true, Completed: true}, nil\n471|\tcase marker.SourceSHA256:\n472|\t\tif err := removeMarkerLocked(hold, filesystem, root); err != nil {\n473|\t\t\treturn RecoverResult{Found: true}, err\n474|\t\t}\n475|\t\treturn RecoverResult{Found: true, Aborted: true}, nil\n476|\tdefault:\n477|\t\treturn RecoverResult{Found: true}, trustError(TrustError{Operation: operation, Err: ErrJointIntervened})\n478|\t}\n479|}\n480|\n481|func pendingPath(root string) string { return filepath.Join(root, pendingCommitFileName) }\n482|\n483|// markerPresent reports whether a joint-commit intent marker is\n484|// outstanding. Absence must be established, never assumed: an unreadable\n485|// marker path refuses instead of reporting no marker.\n486|func markerPresent(filesystem FileSystem, root string) (bool, error) {\n487|\t_, err := filesystem.Lstat(pendingPath(root))\n488|\tif err == nil {\n489|\t\treturn true, nil\n490|\t}\n491|\tif os.IsNotExist(err) {\n492|\t\treturn false, nil\n493|\t}\n494|\treturn false, trustError(TrustError{Operation: \"inspect joint commit\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n495|}\n496|\n497|// convergeLocked converges one interrupted joint commit, if any, before\n498|// the caller exposes a snapshot or runs a boundary. It is the general\n499|// admission barrier for pending intent: every read, admission and\n500|// transaction entry point converges here under the authorization lock,\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
