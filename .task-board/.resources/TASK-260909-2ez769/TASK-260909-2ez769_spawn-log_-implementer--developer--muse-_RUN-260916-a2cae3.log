{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca21","stream":{"kind":"session","id":"01a0ac04-3aa6-7f83-a640-4d27d55c8cba"},"sequence":875,"recorded_at":1780531400001745,"record_type":"event","durability":"durable","causation_id":"792618d5-7c92-47f4-9c2f-44170e04457d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"792618d5-7c92-47f4-9c2f-44170e04457d","run_stream":{"kind":"run","id":"792618d5-7c92-47f4-9c2f-44170e04457d"},"call_id":"call_01a0ac06ce4671c2802bf2d2bdbbbfd3","text":"Read text file `internal/config/writepath_census_test.go`.\n(499 line(s) above)\n500|// WithExclusiveHold). Ancestors run outermost-first, so the literal's\n501|// parent is the preceding entry; the nearest literal decides,\n502|// conservatively.\n503|func censusInsideHoldClosure(ancestors []ast.Node) bool {\n504|\tfor index := len(ancestors) - 1; index >= 0; index-- {\n505|\t\tliteral, ok := ancestors[index].(*ast.FuncLit)\n506|\t\tif !ok {\n507|\t\t\tcontinue\n508|\t\t}\n509|\t\tif index == 0 {\n510|\t\t\treturn false\n511|\t\t}\n512|\t\tparent, ok := ancestors[index-1].(*ast.CallExpr)\n513|\t\tif !ok || !censusIsHoldEntryCall(parent) {\n514|\t\t\treturn false\n515|\t\t}\n516|\t\tfor _, argument := range parent.Args {\n517|\t\t\tif argument == ast.Node(literal) {\n518|\t\t\t\treturn true\n519|\t\t\t}\n520|\t\t}\n521|\t\treturn false\n522|\t}\n523|\treturn false\n524|}\n525|\n526|func censusIsHoldEntryCall(call *ast.CallExpr) bool {\n527|\tswitch function := call.Fun.(type) {\n528|\tcase *ast.Ident:\n529|\t\treturn function.Name == \"JointCommit\" || function.Name == \"WithExclusiveHold\"\n530|\tcase *ast.SelectorExpr:\n531|\t\treturn function.Sel.Name == \"JointCommit\" || function.Sel.Name == \"WithExclusiveHold\"\n532|\tdefault:\n533|\t\treturn false\n534|\t}\n535|}\n536|\n537|// censusExprViolations judges one package-level initializer expression:\n538|// a bare gated helper there escapes, and a call there is judged by the\n539|// call rule against the variable name.\n540|func censusExprViolations(fileset *token.FileSet, expression ast.Expr, name string, aliases map[string]string) []string {\n541|\tvar violations []string\n542|\tif call, ok := expression.(*ast.CallExpr); ok {\n543|\t\tif violation := censusCallViolation(fileset, call, []ast.Node{expression}, name, aliases); violation != \"\" {\n544|\t\t\tviolations = append(violations, violation)\n545|\t\t}\n546|\t\treturn violations\n547|\t}\n548|\tif _, ok := expression.(*ast.FuncLit); !ok {\n549|\t\tif violation := censusEscapeViolation(fileset, expression, name, aliases, \"package initializer\"); violation != \"\" {\n550|\t\t\tviolations = append(violations, violation)\n551|\t\t}\n552|\t}\n553|\treturn violations\n554|}\n555|\n556|func censusPackageDirs(t *testing.T) (configDir, trustDir string) {\n557|\tt.Helper()\n558|\t_, file, _, ok := runtime.Caller(0)\n559|\tif !ok {\n560|\t\tt.Fatal(\"runtime.Caller failed\")\n561|\t}\n562|\tconfigDir = filepath.Dir(file)\n563|\ttrustDir = filepath.Join(configDir, \"..\", \"hosttrust\")\n564|\treturn configDir, trustDir\n565|}\n566|\n567|func TestWritePathCensusGate(t *testing.T) {\n568|\tconfigDir, trustDir := censusPackageDirs(t)\n569|\tviolations := censusViolations(t, configDir, trustDir)\n570|\tfor _, violation := range violations {\n571|\t\tt.Errorf(\"write-path census violation: %s\", violation)\n572|\t}\n573|}\n574|\n575|// The control plant: the gate must flag a new unlocked caller in a\n576|// synthetic package while passing the censused shapes.\n577|func TestWritePathGateFlagsUnlockedCaller(t *testing.T) {\n578|\tt.Helper()\n579|\twrite := func(t *testing.T, dir, name, body string) {\n580|\t\tt.Helper()\n581|\t\tpath := filepath.Join(dir, name)\n582|\t\tcontent := \"package censuscontrol\\n\\n\" + body\n583|\t\tif err := os.WriteFile(path, []byte(content), 0o600); err != nil {\n584|\t\t\tt.Fatal(err)\n585|\t\t}\n586|\t}\n587|\tt.Run(\"flags unlocked pair write\", func(t *testing.T) {\n588|\t\tdir := t.TempDir()\n589|\t\twrite(t, dir, \"rogue.go\", \"func replaceDurably() {}\\nfunc rogueApply() {\\n\\treplaceDurably()\\n}\\n\")\n590|\t\tviolations := censusViolations(t, dir)\n591|\t\tif len(violations) != 1 || !strings.Contains(violations[0], \"rogueApply\") {\n592|\t\t\tt.Fatalf(\"gate violations = %v, want exactly the rogueApply caller\", violations)\n593|\t\t}\n594|\t})\n595|\tt.Run(\"flags unlocked trust write\", func(t *testing.T) {\n596|\t\tdir := t.TempDir()\n597|\t\twrite(t, dir, \"rogue.go\", \"func commitDocument() {}\\nfunc rogueBump() {\\n\\tcommitDocument()\\n}\\n\")\n598|\t\tviolations := censusViolations(t, dir)\n599|\t\tif len(violations) != 1 || !strings.Contains(violations[0], \"rogueBump\") {\n600|\t\t\tt.Fatalf(\"gate violations = %v, want exactly the rogueBump caller\", violations)\n601|\t\t}\n602|\t})\n603|\tt.Run(\"flags unlocked raw rename\", func(t *testing.T) {\n604|\t\tdir := t.TempDir()\n605|\t\twrite(t, dir, \"rogue.go\", \"type seam interface{ Rename(a, b string) }\\nfunc rogueRename(s seam) {\\n\\ts.Rename(\\\"a\\\", \\\"b\\\")\\n}\\n\")\n606|\t\tviolations := censusViolations(t, dir)\n607|\t\tif len(violations) != 1 || !strings.Contains(violations[0], \"rogueRename\") {\n608|\t\t\tt.Fatalf(\"gate violations = %v, want exactly the rogueRename caller\", violations)\n609|\t\t}\n610|\t})\n611|\tt.Run(\"passes censused shapes\", func(t *testing.T) {\n612|\t\tdir := t.TempDir()\n613|\t\twrite(t, dir, \"clean.go\", \"func replaceDurably() {}\\nfunc writeTempReplace() {}\\n\"+\n614|\t\t\t\"type store struct{}\\nfunc (s store) JointCommit(a, b, c func() error) {}\\n\"+\n615|\t\t\t\"func (s store) WithExclusiveHold(fn func(int)) {}\\n\"+\n616|\t\t\t\"func migrate(s store) {\\n\\ts.WithExclusiveHold(func(hold int) {\\n\\t\\treplaceDurably()\\n\\t})\\n}\\n\"+\n617|\t\t\t\"func applyV4(s store) {\\n\\ts.JointCommit(func() error { return nil }, func() error {\\n\\t\\treplaceDurably()\\n\\t\\treturn nil\\n\\t}, func() error {\\n\\t\\twriteTempReplace()\\n\\t\\treturn nil\\n\\t})\\n}\\n\")\n618|\t\tif violations := censusViolations(t, dir); len(violations) != 0 {\n619|\t\t\tt.Fatalf(\"gate violations = %v, want none for censused shapes\", violations)\n620|\t\t}\n621|\t})\n622|}\n623|\n624|// Executable rogue controls: each evasion shape the CR6 review\n625|// demonstrated (plus two producer shapes) is committed here twice —\n626|// once as the exact production-position source the gate must flag, and\n627|// once as proof that the flagged construct really mutates. Shapes that\n628|// call a token-gated helper cannot compile in production position after\n629|// rev7 (the helper requires a live hold only the lock path forges);\n630|// their behavioral backstop is the zero-hold runtime refusal pinned\n631|// below. Shapes that compile (direct os mutations) execute here against\n632|// real temporary files and must change bytes.\n633|func TestWritePathGateFlagsExecutableRogues(t *testing.T) {\n634|\twrite := func(t *testing.T, dir, name, body string) {\n635|\t\tt.Helper()\n636|\t\tpath := filepath.Join(dir, name)\n637|\t\tcontent := \"package censuscontrol\\n\\n\" + body\n638|\t\tif err := os.WriteFile(path, []byte(content), 0o600); err != nil {\n639|\t\t\tt.Fatal(err)\n640|\t\t}\n641|\t}\n642|\tassertFlagged := func(t *testing.T, shape, source, marker string) {\n643|\t\tt.Helper()\n644|\t\tdir := t.TempDir()\n645|\t\twrite(t, dir, \"reviewer_rogue.go\", source)\n646|\t\tviolations := censusViolations(t, dir)\n647|\t\tmatched := false\n648|\t\tfor _, violation := range violations {\n649|\t\t\tif strings.Contains(violation, marker) {\n650|\t\t\t\tmatched = true\n651|\t\t\t}\n652|\t\t}\n653|\t\tif !matched {\n654|\t\t\tt.Fatalf(\"%s: gate violations = %v, want one mentioning %q\", shape, violations, marker)\n655|\t\t}\n656|\t}\n657|\n658|\tt.Run(\"direct control\", func(t *testing.T) {\n659|\t\tassertFlagged(t, \"direct control\",\n660|\t\t\t\"func reviewerRogue(path string, data []byte) error { _, err := writeTempReplace(osMigrationFileSystem{}, path, data); return err }\\n\",\n661|\t\t\t\"reviewerRogue\")\n662|\t})\n663|\tt.Run(\"package var closure\", func(t *testing.T) {\n664|\t\tassertFlagged(t, \"package var closure\",\n665|\t\t\t\"var reviewerRogue = func(path string, data []byte) error { _, err := writeTempReplace(osMigrationFileSystem{}, path, data); return err }\\n\",\n666|\t\t\t\"reviewerRogue\")\n667|\t})\n668|\tt.Run(\"local helper alias\", func(t *testing.T) {\n669|\t\tassertFlagged(t, \"local helper alias\",\n670|\t\t\t\"func reviewerRogue(path string, data []byte) error { writer := writeTempReplace; _, err := writer(osMigrationFileSystem{}, path, data); return err }\\n\",\n671|\t\t\t\"reviewerRogue\")\n672|\t})\n673|\tt.Run(\"method os rename\", func(t *testing.T) {\n674|\t\tassertFlagged(t, \"method os rename\",\n675|\t\t\t\"import \\\"os\\\"\\ntype reviewerRogueWriter struct{}\\nfunc (reviewerRogueWriter) replace(path string, data []byte) error { return os.Rename(path+\\\".replacement\\\", path) }\\nfunc reviewerRogue(path string, data []byte) error { return (reviewerRogueWriter{}).replace(path,data) }\\n\",\n676|\t\t\t\"replace\")\n677|\t\t// The flagged construct executes: the same method shape replaces\n678|\t\t// a real file through os.Rename.\n679|\t\tpath := filepath.Join(t.TempDir(), \"config.toml\")\n680|\t\tif err := os.WriteFile(path, []byte(\"old configuration\"), 0o600); err != nil {\n681|\t\t\tt.Fatal(err)\n682|\t\t}\n683|\t\tif err := os.WriteFile(path+\".replacement\", []byte(\"unlocked replacement\"), 0o600); err != nil {\n684|\t\t\tt.Fatal(err)\n685|\t\t}\n686|\t\tif err := (censusRogueWriter{}).replace(path, nil); err != nil {\n687|\t\t\tt.Fatal(err)\n688|\t\t}\n689|\t\tgot, err := os.ReadFile(path)\n690|\t\tif err != nil {\n691|\t\t\tt.Fatal(err)\n692|\t\t}\n693|\t\tif string(got) != \"unlocked replacement\" {\n694|\t\t\tt.Fatal(\"method-receiver os.Rename witness did not change the file\")\n695|\t\t}\n696|\t})\n697|\tt.Run(\"direct os write\", func(t *testing.T) {\n698|\t\tassertFlagged(t, \"direct os write\",\n699|\t\t\t\"import \\\"os\\\"\\nfunc reviewerRogue(path string, data []byte) error { return os.WriteFile(path, data, 0600) }\\n\",\n700|\t\t\t\"reviewerRogue\")\n701|\t\t// The flagged construct executes: os.WriteFile replaces a real\n702|\t\t// file with no helper involved.\n703|\t\tpath := filepath.Join(t.TempDir(), \"config.toml\")\n704|\t\tif err := os.WriteFile(path, []byte(\"old configuration\"), 0o600); err != nil {\n705|\t\t\tt.Fatal(err)\n706|\t\t}\n707|\t\tif err := os.WriteFile(path, []byte(\"direct replacement\"), 0o600); err != nil {\n708|\t\t\tt.Fatal(err)\n709|\t\t}\n710|\t\tgot, err := os.ReadFile(path)\n711|\t\tif err != nil {\n712|\t\t\tt.Fatal(err)\n713|\t\t}\n714|\t\tif string(got) != \"direct replacement\" {\n715|\t\t\tt.Fatal(\"direct os.WriteFile witness did not change the file\")\n716|\t\t}\n717|\t})\n718|\tt.Run(\"backend receiver rogue\", func(t *testing.T) {\n719|\t\tassertFlagged(t, \"backend receiver rogue\",\n720|\t\t\t\"func (osMigrationFileSystem) rogueWrite(path string, data []byte) error { _, err := writeTempReplace(osMigrationFileSystem{}, path, data); return err }\\n\",\n721|\t\t\t\"rogueWrite\")\n722|\t})\n723|\tt.Run(\"token gated shapes refuse at runtime\", func(t *testing.T) {\n724|\t\t// The helper-calling shapes above cannot forge a live hold, so\n725|\t\t// even their compilable zero-token form fails closed here.\n726|\t\tpath := filepath.Join(t.TempDir(), \"config.toml\")\n727|\t\tif err := os.WriteFile(path, []byte(\"old configuration\"), 0o600); err != nil {\n728|\t\t\tt.Fatal(err)\n729|\t\t}\n730|\t\tif _, err := writeTempReplace(zeroHoldForCensusTest(), osMigrationFileSystem{}, path, []byte(\"rogue replacement\")); err == nil {\n731|\t\t\tt.Fatal(\"writeTempReplace(zero hold) succeeded, want refusal\")\n732|\t\t}\n733|\t\tgot, err := os.ReadFile(path)\n734|\t\tif err != nil {\n735|\t\t\tt.Fatal(err)\n736|\t\t}\n737|\t\tif string(got) != \"old configuration\" {\n738|\t\t\tt.Fatal(\"zero-hold writeTempReplace changed the file\")\n739|\t\t}\n740|\t})\n741|}\n742|\n743|// censusRogueWriter mirrors the method-receiver evasion shape so the\n744|// control above executes the construct the gate flags. It lives in a\n745|// test file: fixtures write directly by design and are outside the gate.\n746|type censusRogueWriter struct{}\n747|\n748|func (censusRogueWriter) replace(path string, data []byte) error {\n749|\treturn os.Rename(path+\".replacement\", path)\n750|}\n751|\n752|// zeroHoldForCensusTest is the compilable form of a forged hold: the\n753|// zero value, which every token-gated helper must refuse.\n754|func zeroHoldForCensusTest() hosttrust.HeldExclusive {\n755|\treturn hosttrust.HeldExclusive{}\n756|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
