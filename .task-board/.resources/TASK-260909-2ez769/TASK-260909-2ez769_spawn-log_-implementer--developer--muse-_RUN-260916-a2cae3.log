{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9c1","stream":{"kind":"session","id":"01a0ac04-3aa6-7f83-a640-4d27d55c8cba"},"sequence":827,"recorded_at":1780531400001649,"record_type":"event","durability":"durable","causation_id":"792618d5-7c92-47f4-9c2f-44170e04457d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"792618d5-7c92-47f4-9c2f-44170e04457d","run_stream":{"kind":"run","id":"792618d5-7c92-47f4-9c2f-44170e04457d"},"task_stream":{"kind":"task","id":"01a0ac06-bc48-7c20-be32-4cb7021c10fb"},"task_id":"01a0ac06-bc48-7c20-be32-4cb7021c10fb","event":{"kind":"output","task_id":"01a0ac06-bc48-7c20-be32-4cb7021c10fb","chunk":"Read text file `internal/config/migration.go`.\n(199 line(s) above)\n200|\t\treturn MigrationResult{}, migrationError(MigrationError{Operation: \"select target\", Err: ErrMigrationTarget})\n201|\t}\n202|\tif options.TargetVersion == Version4 {\n203|\t\treturn MigrationResult{}, migrationError(MigrationError{Operation: \"select target\", Err: ErrMigrationV4Explicit})\n204|\t}\n205|\tsnapshot, err := Load(inputs, overrides)\n206|\tif err != nil {\n207|\t\treturn MigrationResult{}, err\n208|\t}\n209|\tloaded, decoded := snapshot.Configuration()\n210|\tif !snapshot.ConfigPresent() || !decoded {\n211|\t\treturn MigrationResult{}, migrationError(MigrationError{Operation: \"load source\", Err: ErrMigrationSourceAbsent})\n212|\t}\n213|\tsource, _ := knownConfigVersion(loaded.SourceVersion)\n214|\tresult := MigrationResult{SourceVersion: loaded.SourceVersion, TargetVersion: options.TargetVersion}\n215|\tif compareSemver(source, target) > 0 {\n216|\t\treturn result, migrationError(MigrationError{Operation: \"select target\", Err: ErrMigrationDowngrade})\n217|\t}\n218|\tif compareSemver(source, target) == 0 {\n219|\t\treturn result, nil\n220|\t}\n221|\tif loaded.SourceVersion == Version1 {\n222|\t\tif !oneOf(options.GeneratedSummaryUpgradeChoice, \"local_only\", \"mesh_sanitized\", \"reference_only\") {\n223|\t\t\treturn result, migrationError(MigrationError{Operation: \"validate disclosure choice\", Err: ErrMigrationChoiceRequired})\n224|\t\t}\n225|\t\tloaded.Value.Directory.GeneratedSummaryUpgradeChoice = options.GeneratedSummaryUpgradeChoice\n226|\t}\n227|\tcontext := DecodeContext{RuntimePlatform: inputs.Platform, BackendSettings: inputs.BackendSettings}\n228|\tvar replacement []byte\n229|\tswitch options.TargetVersion {\n230|\tcase Version2:\n231|\t\treplacement, err = encodeVersion2(loaded.Value, context)\n232|\tcase CurrentVersion:\n233|\t\treplacement, err = EncodeCurrent(loaded.Value, context)\n234|\t}\n235|\tif err != nil {\n236|\t\treturn result, migrationError(MigrationError{Operation: \"encode target\", Err: err}) // config-refusal-subsumed: every encoder refusal below this propagation is pinned on its own clause, at writer.go terminal.backend and writer.go v2 wire TOML for the v2 encoder, at writer.go v2 re-read for its defence-in-depth round trip, and by the EncodeCurrent validation suite for v3\n237|\t}\n238|\tselected, _ := snapshot.Paths().Path(ConfigFile)\n239|\tfilename := selected.Value.String()\n240|\tbackup := filename + \".bak.\" + loaded.SourceVersion\n241|\tresult.BackupPath = backup\n242|\t// A successful Load always resolves the state directory, so the\n243|\t// coordinating store always exists: opening it converges interrupted\n244|\t// joint intent and creates the owner-only skeleton when absent.\n245|\tstore, err := openLegacyStore(stateDirOf(snapshot))\n246|\tif err != nil {\n247|\t\treturn result, err\n248|\t}\n249|\t// The durable replacement runs inside the shared authorization\n250|\t// transaction: the exclusive hold serializes this writer with joint\n251|\t// commits and other legacy migrations, and the source revalidation\n252|\t// under the hold refuses a delayed write whose source already moved\n253|\t// (including a completed Configuration 4.0.0 commit).\n254|\tif err := store.WithExclusiveHold(func(hold hosttrust.HeldExclusive) error {\n255|\t\tif err := revalidateLegacySource(inputs, overrides, snapshot); err != nil {\n256|\t\t\treturn err\n257|\t\t}\n258|\t\treturn replaceDurably(hold, filesystem, filename, backup, snapshot.Document(), replacement)\n259|\t}); err != nil {\n260|\t\treturn result, err\n261|\t}\n262|\tresult.Changed = true\n263|\treturn result, nil\n264|}\n265|\n266|// openLegacyStore opens the machine-local store coordinating one legacy\n267|// migration with joint commits. Opening converges interrupted joint\n268|// intent and creates the owner-only store skeleton when absent; a store\n269|// that cannot open (unsafe custody, unresolvable intent) fails the\n270|// migration closed instead of writing beside unknown authority.\n271|func openLegacyStore(stateDir string) (*hosttrust.Store, error) {\n272|\tstore, err := hosttrust.Open(stateDir)\n273|\tif err != nil {\n274|\t\treturn nil, migrationError(MigrationError{Operation: \"open trust store\", Err: err})\n275|\t}\n276|\treturn store, nil\n277|}\n278|\n279|// revalidateLegacySource repeats the selected source pins inside the\n280|// authorization transaction: the current document must still carry the\n281|// selected version and byte-exact bytes. It runs under the exclusive\n282|// hold, so no trust or config commit can land between this revalidation\n283|// and the replacement it guards.\n284|func revalidateLegacySource(inputs Inputs, overrides Overrides, snapshot Snapshot) error {\n285|\tcurrent, err := Load(inputs, overrides)\n286|\tif err != nil {\n287|\t\treturn err\n288|\t}\n289|\tcurrentLoaded, decoded := current.Configuration()\n290|\tif !current.ConfigPresent() || !decoded {\n291|\t\treturn migrationError(MigrationError{Operation: \"revalidate source\", Err: ErrMigrationSourceAbsent})\n292|\t}\n293|\tloaded, _ := snapshot.Configuration()\n294|\tif currentLoaded.SourceVersion != loaded.SourceVersion {\n295|\t\treturn migrationError(MigrationError{Operation: \"revalidate source\", Err: ErrMigrationStaleSource})\n296|\t}\n297|\tif !bytes.Equal(current.Document(), snapshot.Document()) {\n298|\t\treturn migrationError(MigrationError{Operation: \"revalidate source\", Err: ErrMigrationStaleSource})\n299|\t}\n300|\treturn nil\n301|}\n302|\n303|// requireHold refuses a pair mutation attempted without a live exclusive\n304|// authorization hold. The hold itself is constructed only by the lock\n305|// acquisition path; this package can pass it along but never forge one.\n306|func requireHold(hold hosttrust.HeldExclusive) error {\n307|\tif !hold.Valid() {\n308|\t\treturn migrationError(MigrationError{Operation: \"require exclusive hold\", Err: hosttrust.ErrExclusiveHoldRequired})\n309|\t}\n310|\treturn nil\n311|}\n312|\n313|type migrationFile interface {\n314|\tio.Writer\n315|\tName() string\n316|\tChmod(fs.FileMode) error\n317|\tSync() error\n318|\tClose() error\n319|}\n320|\n321|type migrationDirectory interface {\n322|\tSync() error\n323|\tClose() error\n324|}\n325|\n326|type migrationFileSystem interface {\n327|\tCreateTemp(string, string) (migrationFile, error)\n328|\tLink(string, string) error\n329|\tReadFile(string) ([]byte, error)\n330|\tStat(string) (fs.FileInfo, error)\n331|\tRemove(string) error\n332|\tRename(string, string) error\n333|\tOpenDirectory(string) (migrationDirectory, error)\n334|}\n335|\n336|type osMigrationFileSystem struct{}\n337|\n338|func (osMigrationFileSystem) CreateTemp(dir, pattern string) (migrationFile, error) {\n339|\treturn os.CreateTemp(dir, pattern)\n340|}\n341|func (osMigrationFileSystem) Link(oldname, newname string) error   { return os.Link(oldname, newname) }\n342|func (osMigrationFileSystem) ReadFile(name string) ([]byte, error) { return os.ReadFile(name) }\n343|\n344|// Stat does not follow a symlink, unlike the symlink-following read-side seam\n345|// in OSInputs. Durable migration replaces the selected file with an atomic\n346|// rename, which replaces a symlink itself rather than its target: migrating a\n347|// symlinked configuration would silently detach the operator's link and leave\n348|// the real document holding stale bytes next to a backup of the resolved\n349|// target. The specification is silent here, so the mutating path fails closed\n350|// with ErrConfigNotRegular instead of guessing which file the operator meant.\n351|func (osMigrationFileSystem) Stat(name string) (fs.FileInfo, error) { return os.Lstat(name) }\n352|func (osMigrationFileSystem) Remove(name string) error              { return os.Remove(name) }\n353|func (osMigrationFileSystem) Rename(oldname, newname string) error {\n354|\treturn os.Rename(oldname, newname)\n355|}\n356|func (osMigrationFileSystem) OpenDirectory(name string) (migrationDirectory, error) {\n357|\treturn os.Open(name)\n358|}\n359|\n360|// replaceDurably publishes a byte-exact backup of the pre-migration\n361|// configuration document, then installs the replacement, under a live\n362|// exclusive authorization hold. A forged, absent or released hold refuses\n363|// before anything durable is written. Backup contents classification: the\n364|// backup is a copy of configuration bytes only (host and peer UUIDs,\n365|// names, endpoints, SSH arguments) and never carries private key\n366|// material, which lives exclusively under\n367|// STATE_DIR/host-channel/credentials/. The custody contract for backups is:\n368|// staged 0600 with group/world-clean verification (Unix owner-only), and\n369|// published names matched by hosttrust.ExcludedConfigDirName so every\n370|// replication, snapshot, clone or diagnostic surface must drop them. On\n371|// Windows the backup DACL inherits the user-profile ACL; that inheritance\n372|// is a stated bound, not owner-only evidence.\n373|func replaceDurably(hold hosttrust.HeldExclusive, filesystem migrationFileSystem, filename, backup string, original, replacement []byte) error {\n374|\tif err := requireHold(hold); err != nil {\n375|\t\treturn err\n376|\t}\n377|\tdirectory := filepath.Dir(filename)\n378|\t// Re-inspect the selected file before anything durable is written. Load\n379|\t// resolved and validated it through the symlink-following read seam; this\n380|\t// mutating seam does not follow symlinks, so a selected file that is not\n381|\t// itself a regular file is refused here rather than after a backup has\n382|\t// already been published. A refused migration therefore leaves the\n383|\t// directory exactly as it found it, and the captured permission bits are\n384|\t// the ones the replacement inherits.\n385|\tinfo, err := filesystem.Stat(filename)\n386|\tif err != nil {\n387|\t\treturn migrationError(MigrationError{Operation: \"inspect source mode\", Err: errors.Join(ErrMigrationWrite, err)})\n388|\t}\n389|\tif !info.Mode().IsRegular() {\n390|\t\treturn migrationError(MigrationError{Operation: \"inspect source mode\", Err: errors.Join(ErrMigrationWrite, ErrConfigNotRegular)})\n391|\t}\n392|\tbackupTemp, err := writeTempFile(filesystem, directory, \".ax-config-backup-*\", original, 0o600)\n393|\tif err != nil {\n394|\t\treturn migrationError(MigrationError{Operation: \"write backup\", Err: errors.Join(ErrMigrationBackup, err)})\n395|\t}\n396|\tif err := filesystem.Link(backupTemp, backup); err != nil {\n397|\t\tif !errors.Is(err, fs.ErrExist) {\n398|\t\t\t_ = filesystem.Remove(backupTemp)\n399|\t\t\treturn migrationError(MigrationError{Operation: \"publish backup\", Err: errors.Join(ErrMigrationBackup, err)})\n400|\t\t}\n401|\t\texisting, readErr := filesystem.ReadFile(backup)\n402|\t\tinfo, statErr := filesystem.Stat(backup)\n403|\t\tif readErr != nil || statErr != nil || !bytes.Equal(existing, original) || info.Mode().Perm()&0o077 != 0 {\n404|\t\t\t_ = filesystem.Remove(backupTemp)\n405|\t\t\treturn migrationError(MigrationError{Operation: \"verify backup\", Err: ErrMigrationBackup})\n406|\t\t}\n407|\t}\n408|\tif err := filesystem.Remove(backupTemp); err != nil && !errors.Is(err, fs.ErrNotExist) {\n409|\t\treturn migrationError(MigrationError{Operation: \"remove backup staging file\", Err: errors.Join(ErrMigrationBackup, err)})\n410|\t}\n411|\t// Retry the directory sync even when an exact backup already exists: it may\n412|\t// be the visible result of an interrupted run whose directory fsync failed.\n413|\tif err := syncDirectory(filesystem, directory); err != nil {\n414|\t\treturn migrationError(MigrationError{Operation: \"sync backup directory\", Err: errors.Join(ErrMigrationSync, err)})\n415|\t}\n416|\n417|\treplacementTemp, err := writeTempFile(filesystem, directory, \".ax-config-migrate-*\", replacement, info.Mode().Perm())\n418|\tif err != nil {\n419|\t\treturn migrationError(MigrationError{Operation: \"write replacement\", Err: errors.Join(ErrMigrationWrite, err)})\n(more lines below)","final_result":true}}}
