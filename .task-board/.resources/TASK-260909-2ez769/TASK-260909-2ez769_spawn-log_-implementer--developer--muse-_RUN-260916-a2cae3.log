{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c939","stream":{"kind":"session","id":"01a0ac04-3aa6-7f83-a640-4d27d55c8cba"},"sequence":759,"recorded_at":1780531400001513,"record_type":"event","durability":"durable","causation_id":"792618d5-7c92-47f4-9c2f-44170e04457d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"792618d5-7c92-47f4-9c2f-44170e04457d","run_stream":{"kind":"run","id":"792618d5-7c92-47f4-9c2f-44170e04457d"},"task_stream":{"kind":"task","id":"01a0ac06-957d-7213-b2fc-3fb7c80fde8b"},"task_id":"01a0ac06-957d-7213-b2fc-3fb7c80fde8b","event":{"kind":"output","task_id":"01a0ac06-957d-7213-b2fc-3fb7c80fde8b","chunk":"Read text file `internal/hosttrust/transact.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|)\n8|\n9|// Snapshot is one coherent committed read: trust bytes plus the generation\n10|// that authorized them. Streams and dispatches bind this generation; any use\n11|// must re-check currency before crossing a side-effect boundary.\n12|type Snapshot struct {\n13|\tGeneration uint64\n14|\tTrust      TrustStore\n15|}\n16|\n17|// TransactionFunc mutates a copy of the committed trust. Returning nil\n18|// commits with generation+1; returning an error aborts with no durable effect.\n19|type TransactionFunc func(trust *TrustStore) error\n20|\n21|// ReadSnapshot obtains one coherent committed snapshot under a shared lock.\n22|// A missing store is ErrTrustStoreMissing, never an empty store. Unreadable,\n23|// malformed or partially read state refuses; leftover staging files from\n24|// crashed commits are ignored and never selected.\n25|func (store *Store) ReadSnapshot() (Snapshot, error) {\n26|\treturn readSnapshot(store.fs, store.root, store.lock)\n27|}\n28|\n29|// WithSharedSnapshot runs fn under the authorization lock with the\n30|// committed trust, so a config-plus-trust pair observed inside fn is\n31|// coherent: no trust or config commit can land between the trust read and\n32|// fn's own reads. Pending joint intent converges before fn runs, so a\n33|// surviving process observes the same converged pair as a reopened store.\n34|// Callers must not acquire the lock again inside fn; internal reads there\n35|// use the supplied committed value directly.\n36|func (store *Store) WithSharedSnapshot(fn func(current TrustStore) error) error {\n37|\tunlock, err := lockForConvergedRead(store.fs, store.root, store.lock)\n38|\tif err != nil {\n39|\t\treturn err\n40|\t}\n41|\tdefer unlock()\n42|\tsnapshot, err := readSnapshotLocked(store.fs, store.root)\n43|\tif err != nil {\n44|\t\treturn err\n45|\t}\n46|\tcommitted := snapshot.Trust\n47|\tif fn == nil {\n48|\t\treturn trustError(TrustError{Operation: \"read snapshot\", Err: ErrAuthorizationRefused})\n49|\t}\n50|\treturn fn(committed)\n51|}\n52|\n53|func readSnapshot(filesystem FileSystem, root string, lock *fileLock) (Snapshot, error) {\n54|\tunlock, err := lockForConvergedRead(filesystem, root, lock)\n55|\tif err != nil {\n56|\t\treturn Snapshot{}, err\n57|\t}\n58|\tdefer unlock()\n59|\treturn readSnapshotLocked(filesystem, root)\n60|}\n61|\n62|// lockForConvergedRead holds the authorization lock for one coherent read,\n63|// converging pending joint intent first. The fast path keeps the shared\n64|// lock when no marker is present: staging a marker needs the exclusive\n65|// lock, so absence observed under shared hold still holds at the read.\n66|// When a marker is present the shared lock is released before the\n67|// exclusive lock is acquired (a held shared lock can never upgrade in\n68|// place without risking a cross-process upgrade deadlock), the leftover\n69|// converges or refuses, and the read proceeds under the exclusive hold.\n70|// Convergence may move the generation forward; callers compare request\n71|// bindings against the converged read, never by refreshing a stale number.\n72|func lockForConvergedRead(filesystem FileSystem, root string, lock *fileLock) (func(), error) {\n73|\tunlock, err := lock.shared()\n74|\tif err != nil {\n75|\t\treturn nil, trustError(TrustError{Operation: \"lock snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n76|\t}\n77|\tpresent, err := markerPresent(filesystem, root)\n78|\tif err != nil {\n79|\t\tunlock()\n80|\t\treturn nil, err\n81|\t}\n82|\tif !present {\n83|\t\treturn unlock, nil\n84|\t}\n85|\tunlock()\n86|\thold, exclusiveUnlock, err := lock.exclusiveHold()\n87|\tif err != nil {\n88|\t\treturn nil, trustError(TrustError{Operation: \"lock snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n89|\t}\n90|\tunlock = exclusiveUnlock\n91|\tif err := convergeLocked(hold, filesystem, root); err != nil {\n92|\t\tunlock()\n93|\t\treturn nil, err\n94|\t}\n95|\treturn unlock, nil\n96|}\n97|\n98|// readSnapshotLocked reads one coherent committed snapshot assuming the\n99|// caller already holds the authorization lock and has converged pending\n100|// joint intent (see lockForConvergedRead): reading beside an unresolved\n101|// marker would admit a superseded generation with replaced configuration.\n102|func readSnapshotLocked(filesystem FileSystem, root string) (Snapshot, error) {\n103|\tpath := filepath.Join(root, trustFileName)\n104|\tinfo, err := filesystem.Lstat(path)\n105|\tif err != nil {\n106|\t\tif os.IsNotExist(err) {\n107|\t\t\treturn Snapshot{}, trustError(TrustError{Operation: \"read snapshot\", Err: ErrTrustStoreMissing})\n108|\t\t}\n109|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"read snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n110|\t}\n111|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n112|\t\treturn Snapshot{}, err\n113|\t}\n114|\tdocument, err := filesystem.ReadFile(path)\n115|\tif err != nil {\n116|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"read snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n117|\t}\n118|\tstore, err := DecodeTrust(document)\n119|\tif err != nil {\n120|\t\treturn Snapshot{}, err\n121|\t}\n122|\treturn Snapshot{Generation: store.Generation, Trust: store}, nil\n123|}\n124|\n125|// Initialize creates the explicit empty generation-1 store. It refuses when\n126|// trust.json already exists: setup never overwrites committed authority.\n127|// Pending joint intent converges first, so setup never builds beside an\n128|// unresolved marker.\n129|func (store *Store) Initialize() (Snapshot, error) {\n130|\thold, unlock, err := store.lock.exclusiveHold()\n131|\tif err != nil {\n132|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"lock initialize\", Err: errors.Join(ErrTrustDurability, err)})\n133|\t}\n134|\tdefer unlock()\n135|\tif err := convergeLocked(hold, store.fs, store.root); err != nil {\n136|\t\treturn Snapshot{}, err\n137|\t}\n138|\tpath := filepath.Join(store.root, trustFileName)\n139|\tif _, err := store.fs.Lstat(path); err == nil {\n140|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"initialize store\", Err: ErrTrustDurability})\n141|\t} else if !os.IsNotExist(err) {\n142|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"initialize store\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n143|\t}\n144|\tdocument, err := EncodeTrust(TrustStore{Generation: 1})\n145|\tif err != nil {\n146|\t\treturn Snapshot{}, err\n147|\t}\n148|\tif err := commitDocument(hold, store.fs, store.root, path, document); err != nil {\n149|\t\treturn Snapshot{}, err\n150|\t}\n151|\t// The exclusive lock is still held: read without re-acquiring, since a\n152|\t// second acquisition in this goroutine would block on the held lock.\n153|\treturn readSnapshotLocked(store.fs, store.root)\n154|}\n155|\n156|// transact runs one crash-durable generation transaction under the exclusive\n157|// cross-process lock: load committed state, apply fn, encode, stage with\n158|// fsync, atomic rename, directory fsync. A missing store refuses with\n159|// ErrTrustStoreMissing: only explicit Initialize commits generation 1. Any\n160|// other malformed state refuses before fn runs.\n161|func (store *Store) transact(fn TransactionFunc) error {\n162|\treturn transact(store.fs, store.root, store.lock, fn)\n163|}\n164|\n165|func transact(filesystem FileSystem, root string, lock *fileLock, fn TransactionFunc) error {\n166|\thold, unlock, err := lock.exclusiveHold()\n167|\tif err != nil {\n168|\t\treturn trustError(TrustError{Operation: \"lock transaction\", Err: errors.Join(ErrTrustDurability, err)})\n169|\t}\n170|\tdefer unlock()\n171|\tif err := convergeLocked(hold, filesystem, root); err != nil {\n172|\t\treturn err\n173|\t}\n174|\treturn transactLocked(hold, filesystem, root, fn)\n175|}\n176|\n177|// transactLocked runs one crash-durable generation transaction assuming the\n178|// caller already holds the exclusive authorization lock. Joint commits and\n179|// recovery use it to sequence the marker, the external replacement and the\n180|// bump under a single hold. The hold proves the exclusion window the bump\n181|// commits under; without it the bump refuses.\n182|func transactLocked(hold HeldExclusive, filesystem FileSystem, root string, fn TransactionFunc) error {\n183|\tif err := requireHold(hold); err != nil {\n184|\t\treturn err\n185|\t}\n186|\tcommitted, err := loadCommitted(filesystem, root)\n187|\tif err != nil {\n188|\t\treturn err\n189|\t}\n190|\tnext := committed\n191|\tnext.Entries = append([]CredentialEntry(nil), committed.Entries...)\n192|\tif err := fn(&next); err != nil {\n193|\t\treturn err\n194|\t}\n195|\tif next.Generation != committed.Generation {\n196|\t\treturn trustError(TrustError{Operation: \"commit generation\", Err: ErrTrustDurability})\n197|\t}\n198|\tif committed.Generation >= MaxGeneration {\n199|\t\treturn trustError(TrustError{Operation: \"commit generation\", Err: ErrGenerationExhausted})\n200|\t}\n201|\tnext.Generation = committed.Generation + 1\n202|\tencoded, err := EncodeTrust(next)\n203|\tif err != nil {\n204|\t\treturn err\n205|\t}\n206|\tif err := commitDocument(hold, filesystem, root, filepath.Join(root, trustFileName), encoded); err != nil {\n207|\t\treturn err\n208|\t}\n209|\treturn nil\n210|}\n211|\n212|// loadCommitted reads the committed trust without acquiring the lock: the\n213|// caller must already hold the authorization lock, and (outside recovery\n214|// itself) must have converged pending joint intent first.\n215|func loadCommitted(filesystem FileSystem, root string) (TrustStore, error) {\n216|\tpath := filepath.Join(root, trustFileName)\n217|\tinfo, err := filesystem.Lstat(path)\n218|\tif err != nil {\n219|\t\tif os.IsNotExist(err) {\n220|\t\t\treturn TrustStore{}, trustError(TrustError{Operation: \"read committed trust\", Err: ErrTrustStoreMissing})\n221|\t\t}\n222|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"read committed trust\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n223|\t}\n224|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n225|\t\treturn TrustStore{}, err\n226|\t}\n227|\tdocument, err := filesystem.ReadFile(path)\n228|\tif err != nil {\n229|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"read committed trust\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n230|\t}\n231|\tdecoded, err := DecodeTrust(document)\n232|\tif err != nil {\n233|\t\treturn TrustStore{}, err\n234|\t}\n235|\treturn decoded, nil\n236|}\n237|\n238|// commitDocument stages bytes in a temp file with fsync, atomically renames\n239|// over the target, and fsyncs the directory. On restart only the last fully\n240|// committed file is selected; staged files are ignored by every reader.\n241|// The hold proves the live exclusion window the commit lands under; a\n242|// forged, absent or released hold refuses before anything is staged.\n243|func commitDocument(hold HeldExclusive, filesystem FileSystem, root, path string, document []byte) error {\n244|\tif err := requireHold(hold); err != nil {\n245|\t\treturn err\n246|\t}\n247|\tstaged, err := filesystem.CreateTemp(root, stagePrefix+\"*\", 0o600)\n248|\tif err != nil {\n249|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n250|\t}\n251|\tname := staged.Name()\n252|\tfailed := true\n253|\tdefer func() {\n254|\t\tif failed {\n255|\t\t\t_ = filesystem.Remove(name)\n256|\t\t}\n257|\t}()\n258|\tif err := writeAll(staged, document); err != nil {\n259|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n260|\t}\n261|\tif err := staged.Sync(); err != nil {\n262|\t\t_ = staged.Close()\n263|\t\treturn trustError(TrustError{Operation: \"sync trust\", Err: errors.Join(ErrTrustDurability, err)})\n264|\t}\n265|\tif err := staged.Close(); err != nil {\n266|\t\treturn trustError(TrustError{Operation: \"sync trust\", Err: errors.Join(ErrTrustDurability, err)})\n267|\t}\n268|\tif err := filesystem.Chmod(name, 0o600); err != nil {\n269|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n270|\t}\n271|\t// On platforms where mode bits do not govern access, install the\n272|\t// owner-only ACL before the staging file becomes visible under load.\n273|\tif err := secureStaged(name, false); err != nil {\n274|\t\treturn err\n275|\t}\n276|\tif err := filesystem.Rename(name, path); err != nil {\n277|\t\treturn trustError(TrustError{Operation: \"replace trust\", Err: errors.Join(ErrTrustDurability, err)})\n278|\t}\n279|\tif err := syncDir(filesystem, root); err != nil {\n280|\t\treturn trustError(TrustError{Operation: \"sync trust directory\", Err: errors.Join(ErrTrustDurability, err)})\n281|\t}\n282|\tfailed = false\n283|\treturn nil\n284|}\n285|\n286|func writeAll(writer interface{ Write([]byte) (int, error) }, document []byte) error {\n287|\tfor len(document) > 0 {\n288|\t\twritten, err := writer.Write(document)\n289|\t\tif err != nil {\n290|\t\t\treturn err\n291|\t\t}\n292|\t\tif written == 0 {\n293|\t\t\treturn errors.New(\"short trust write\")\n294|\t\t}\n295|\t\tdocument = document[written:]\n296|\t}\n297|\treturn nil\n298|}\n299|\n300|func syncDir(filesystem FileSystem, root string) error {\n301|\thandle, err := filesystem.OpenDirectory(root)\n302|\tif err != nil {\n303|\t\treturn err\n304|\t}\n305|\tif err := handle.Sync(); err != nil {\n306|\t\t_ = handle.Close()\n307|\t\treturn err\n308|\t}\n309|\treturn handle.Close()\n310|}","final_result":true}}}
