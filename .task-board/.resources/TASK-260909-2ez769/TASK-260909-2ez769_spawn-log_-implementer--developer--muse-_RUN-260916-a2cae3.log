{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9eb","stream":{"kind":"session","id":"01a0ac04-3aa6-7f83-a640-4d27d55c8cba"},"sequence":848,"recorded_at":1780531400001691,"record_type":"event","durability":"durable","causation_id":"792618d5-7c92-47f4-9c2f-44170e04457d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"792618d5-7c92-47f4-9c2f-44170e04457d","run_stream":{"kind":"run","id":"792618d5-7c92-47f4-9c2f-44170e04457d"},"task_stream":{"kind":"task","id":"01a0ac06-c584-74d0-b0fc-0569ae787f3e"},"task_id":"01a0ac06-c584-74d0-b0fc-0569ae787f3e","event":{"kind":"output","task_id":"01a0ac06-c584-74d0-b0fc-0569ae787f3e","chunk":"Read text file `internal/config/writepath_census_test.go`.\n1|package config\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"go/ast\"\n6|\t\"go/parser\"\n7|\t\"go/token\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"runtime\"\n11|\t\"sort\"\n12|\t\"strings\"\n13|\t\"testing\"\n14|\n15|\t\"github.com/relux-works/agent-session-manager/internal/hosttrust\"\n16|)\n17|\n18|// This file enforces the rev7 write-path census statically: every\n19|// filesystem mutation of the config-plus-trust pair must happen through\n20|// an allowlisted helper from a lock-held context, and every pair writer\n21|// additionally requires a live exclusive-hold capability at runtime (see\n22|// hosttrust.HeldExclusive). The census itself is the board outcome\n23|// TASK-260909-2ez769_write-path-census-rev7.md; this gate fails when a\n24|// pair mutation appears outside the censused rows.\n25|//\n26|// Rules (see the census for the per-row rationale):\n27|//   A. config pair writes (replaceDurably, writeTempReplace) run only\n28|//      inside a closure passed directly to a hold entry (hosttrust\n29|//      JointCommit or WithExclusiveHold), which holds the exclusive\n30|//      authorization lock across revalidation, replacement and\n31|//      compensation. Legacy migrate coordinates through\n32|//      WithExclusiveHold like every other writer; there is no unlocked\n33|//      exemption.\n34|//   B. trust/marker writes (commitDocument, removeMarkerLocked) run only\n35|//      in JointCommit, transactLocked, Initialize, recoverLocked,\n36|//      resolveFailedReplace and compensateLocked, all under the\n37|//      exclusive hold.\n38|//   C. credential-file writes (writeCustodyFile) run only in Issue and\n39|//      Rotate, which stage inert files before the admitting trust commit.\n40|//   D. raw filesystem entry mutations (Rename, Remove, CreateTemp,\n41|//      CreateExclusive, Link) run only inside the helpers above, their\n42|//      staging/cleanup sites, and the atomic lock publication. Mode and\n43|//      directory setup (Chmod, MkdirAll) is custody, covered by the\n44|//      custody tests, not by this gate.\n45|//   E. custody constructors (ensureOwnerDir, secureStaged) run only at\n46|//      the censused setup/install sites.\n47|//   F. config staging (writeTempFile) runs only inside the pair writers.\n48|//   G. direct standard-library mutations (os.Rename, os.Remove,\n49|//      os.RemoveAll, os.Create, os.CreateTemp, os.OpenFile, os.WriteFile,\n50|//      os.MkdirTemp, os.Link, os.Symlink, os.Truncate) run only inside\n51|//      the filesystem backend definitions (the osFileSystem and\n52|//      osMigrationFileSystem method sets); every other occurrence,\n53|//      including method receivers and wrapper indirection, is a\n54|//      violation.\n55|//   H. gated helpers never escape as values: binding one to a variable,\n56|//      field or parameter, passing one as an argument, or returning one\n57|//      is a violation unless the binding sits in a censused definition.\n58|//      The gate resolves local aliases transitively and scans package\n59|//      variable initializers as well as function bodies.\n60|//\n61|// The control TestWritePathGateFlagsUnlockedCaller proves the gate sees\n62|// new unlocked callers in the three original shapes; the executable\n63|// controls TestWritePathGateFlagsExecutableRogues prove it sees the four\n64|// CR6 reviewer evasion shapes plus two producer shapes, each paired with\n65|// proof that the flagged construct really mutates. The hold-require-skip\n66|// and replace-require-skip mutation plants prove the runtime capability\n67|// behaviorally.\n68|\n69|var censusPairHelpers = map[string]bool{\n70|\t\"replaceDurably\":   true,\n71|\t\"writeTempReplace\": true,\n72|}\n73|\n74|var censusTrustHelpers = map[string]map[string]bool{\n75|\t\"commitDocument\": {\n76|\t\t\"transactLocked\": true, \"Initialize\": true, \"JointCommit\": true, \"compensateLocked\": true,\n77|\t},\n78|\t\"removeMarkerLocked\": {\n79|\t\t\"JointCommit\": true, \"recoverLocked\": true, \"compensateLocked\": true, \"resolveFailedReplace\": true,\n80|\t},\n81|}\n82|\n83|var censusCustodyHelpers = map[string]map[string]bool{\n84|\t\"writeCustodyFile\": {\"Issue\": true, \"Rotate\": true},\n85|\t\"writeTempFile\":    {\"replaceDurably\": true, \"writeTempReplace\": true},\n86|\t\"ensureOwnerDir\":   {\"openStore\": true, \"Issue\": true, \"Rotate\": true},\n87|\t\"secureStaged\":     {\"commitDocument\": true, \"writeCustodyFile\": true, \"ensureOwnerDir\": true, \"openLock\": true},\n88|}\n89|\n90|var censusRawMutations = map[string]map[string]bool{\n91|\t\"Rename\": {\n92|\t\t\"commitDocument\": true, \"writeCustodyFile\": true, \"replaceDurably\": true, \"writeTempReplace\": true,\n93|\t},\n94|\t\"Remove\": {\n95|\t\t\"commitDocument\": true, \"writeCustodyFile\": true, \"Issue\": true, \"Rotate\": true,\n96|\t\t\"removeMarkerLocked\": true, \"writeTempFile\": true, \"writeTempReplace\": true, \"replaceDurably\": true,\n97|\t},\n98|\t\"CreateTemp\": {\n99|\t\t\"commitDocument\": true, \"writeCustodyFile\": true, \"writeTempFile\": true,\n100|\t},\n101|\t\"CreateExclusive\": {\"openLock\": true},\n102|\t\"Link\":            {\"replaceDurably\": true},\n103|}\n104|\n105|// censusGatedIdents are the helper names that must never escape as\n106|// values (rule H) and whose local aliases resolve to the helper itself.\n107|var censusGatedIdents = map[string]bool{\n108|\t\"replaceDurably\": true, \"writeTempReplace\": true, \"writeTempFile\": true,\n109|\t\"commitDocument\": true, \"removeMarkerLocked\": true,\n110|\t\"writeCustodyFile\": true, \"ensureOwnerDir\": true, \"secureStaged\": true,\n111|}\n112|\n113|// censusOSMutations are the standard-library entry points that create,\n114|// replace, remove or rename files. They run only inside the backend\n115|// definitions (rule G). Reads (ReadFile, Stat, Lstat, ReadDir, Open),\n116|// custody setup (Mkdir, MkdirAll, Chmod, Chtimes) and process control\n117|// (Getenv, Exit, Args) are outside this rule.\n118|var censusOSMutations = map[string]bool{\n119|\t\"Rename\": true, \"Remove\": true, \"RemoveAll\": true, \"Create\": true,\n120|\t\"CreateTemp\": true, \"OpenFile\": true, \"WriteFile\": true, \"MkdirTemp\": true,\n121|\t\"Link\": true, \"Symlink\": true, \"Truncate\": true,\n122|}\n123|\n124|// censusBackendMethods are the production filesystem backend\n125|// definitions: their bodies implement the seams, so calls inside them\n126|// are the definition of the interface, not new write paths. The\n127|// exemption matches exact (receiver, method) pairs: a new method on a\n128|// backend receiver is scanned like any other function, so a rogue\n129|// cannot hide behind a backend receiver.\n130|var censusBackendMethods = map[string]map[string]bool{\n131|\t\"osFileSystem\": {\n132|\t\t\"CreateTemp\": true, \"CreateExclusive\": true, \"ReadFile\": true,\n133|\t\t\"Lstat\": true, \"Stat\": true, \"Remove\": true, \"Rename\": true,\n134|\t\t\"MkdirAll\": true, \"Chmod\": true, \"OpenDirectory\": true, \"ReadDir\": true,\n135|\t},\n136|\t\"osMigrationFileSystem\": {\n137|\t\t\"CreateTemp\": true, \"Link\": true, \"ReadFile\": true, \"Stat\": true,\n138|\t\t\"Remove\": true, \"Rename\": true, \"OpenDirectory\": true,\n139|\t},\n140|}\n141|\n142|// censusPackageIdents are package qualifiers whose selectors are judged\n143|// by the os-direct rule (for os) or ignored (pure helpers with no\n144|// filesystem entry points).\n145|var censusPackageIdents = map[string]bool{\n146|\t\"os\": true, \"filepath\": true, \"unix\": true, \"windows\": true,\n147|\t\"strings\": true, \"bytes\": true, \"errors\": true, \"fmt\": true,\n148|}\n149|\n150|func censusViolation(format string, args ...any) string {\n151|\treturn fmt.Sprintf(format, args...)\n152|}\n153|\n154|// censusViolations scans the non-test Go sources under dirs and reports\n155|// every pair mutation outside the censused rows.\n156|func censusViolations(t *testing.T, dirs ...string) []string {\n157|\tt.Helper()\n158|\tvar violations []string\n159|\tfor _, dir := range dirs {\n160|\t\tfileset := token.NewFileSet()\n161|\t\t// Parse non-test files individually: test files stage fixtures\n162|\t\t// through direct writes by design and are not production paths.\n163|\t\tentries, err := filepath.Glob(filepath.Join(dir, \"*.go\"))\n164|\t\tif err != nil {\n165|\t\t\tt.Fatalf(\"glob %s: %v\", dir, err)\n166|\t\t}\n167|\t\tfor _, path := range entries {\n168|\t\t\tif strings.HasSuffix(path, \"_test.go\") {\n169|\t\t\t\tcontinue\n170|\t\t\t}\n171|\t\t\tfile, err := parser.ParseFile(fileset, path, nil, 0)\n172|\t\t\tif err != nil {\n173|\t\t\t\tt.Fatalf(\"parse %s: %v\", path, err)\n174|\t\t\t}\n175|\t\t\tviolations = append(violations, censusFileViolations(fileset, file)...)\n176|\t\t}\n177|\t}\n178|\tsort.Strings(violations)\n179|\treturn violations\n180|}\n181|\n182|func censusFileViolations(fileset *token.FileSet, file *ast.File) []string {\n183|\tvar violations []string\n184|\tfor _, decl := range file.Decls {\n185|\t\tswitch value := decl.(type) {\n186|\t\tcase *ast.FuncDecl:\n187|\t\t\tif value.Body == nil {\n188|\t\t\t\tcontinue\n189|\t\t\t}\n190|\t\t\tif censusIsBackendMethod(value) {\n191|\t\t\t\tcontinue\n192|\t\t\t}\n193|\t\t\tviolations = append(violations, censusBodyViolations(fileset, value.Body, value.Name.Name)...)\n194|\t\tcase *ast.GenDecl:\n195|\t\t\t// Package variable initializers can hide executable writers\n196|\t\t\t// (a function literal calling a gated helper) or leak a\n197|\t\t\t// helper as a value; both are violations outside censused\n198|\t\t\t// definitions.\n199|\t\t\tfor _, spec := range value.Specs {\n200|\t\t\t\tvalues, ok := spec.(*ast.ValueSpec)\n201|\t\t\t\tif !ok {\n202|\t\t\t\t\tcontinue\n203|\t\t\t\t}\n204|\t\t\t\tname := \"package var\"\n205|\t\t\t\tif len(values.Names) > 0 {\n206|\t\t\t\t\tname = \"var \" + values.Names[0].Name\n207|\t\t\t\t}\n208|\t\t\t\tfor _, initializer := range values.Values {\n209|\t\t\t\t\tviolations = append(violations, censusExprViolations(fileset, initializer, name, nil)...)\n210|\t\t\t\t\tif literal, ok := initializer.(*ast.FuncLit); ok {\n211|\t\t\t\t\t\tviolations = append(violations, censusBodyViolations(fileset, literal.Body, name)...)\n212|\t\t\t\t\t}\n213|\t\t\t\t}\n214|\t\t\t}\n215|\t\t}\n216|\t}\n217|\treturn violations\n218|}\n219|\n220|func censusIsBackendMethod(function *ast.FuncDecl) bool {\n221|\tif function.Recv == nil {\n222|\t\treturn false\n223|\t}\n224|\tfor _, field := range function.Recv.List {\n225|\t\tname := censusTypeName(field.Type)\n226|\t\tif methods, ok := censusBackendMethods[name]; ok && methods[function.Name.Name] {\n227|\t\t\treturn true\n228|\t\t}\n229|\t}\n230|\treturn false\n231|}\n232|\n233|func censusTypeName(expression ast.Expr) string {\n234|\tswitch value := expression.(type) {\n235|\tcase *ast.Ident:\n236|\t\treturn value.Name\n237|\tcase *ast.StarExpr:\n238|\t\treturn censusTypeName(value.X)\n239|\tdefault:\n240|\t\treturn \"\"\n241|\t}\n242|}\n243|\n244|// censusBodyViolations attributes every gated call and helper escape in\n245|// one function body to its enclosing declaration. Aliases bind\n246|// body-wide (fail closed): any local name once bound to a gated helper\n247|// resolves to that helper for the whole body.\n248|func censusBodyViolations(fileset *token.FileSet, body *ast.BlockStmt, funcName string) []string {\n249|\taliases := censusCollectAliases(body)\n250|\tvar violations []string\n251|\tviolations = append(violations, censusWalk(fileset, body, []ast.Node{body}, funcName, aliases)...)\n252|\treturn violations\n253|}\n254|\n255|// censusCollectAliases binds local names to gated helpers through\n256|// :=, var and plain assignments, transitively (an alias of an alias\n257|// resolves to the helper). Only simple single-value bindings count;\n258|// anything else is ignored, never assumed benign elsewhere.\n259|func censusCollectAliases(body *ast.BlockStmt) map[string]string {\n260|\tbound := map[string]string{}\n261|\tresolve := func(expression ast.Expr) (string, bool) {\n262|\t\tident, ok := expression.(*ast.Ident)\n263|\t\tif !ok {\n264|\t\t\treturn \"\", false\n265|\t\t}\n266|\t\tif censusGatedIdents[ident.Name] {\n267|\t\t\treturn ident.Name, true\n268|\t\t}\n269|\t\ttarget, ok := bound[ident.Name]\n270|\t\treturn target, ok\n271|\t}\n272|\tbind := func(target ast.Expr, value ast.Expr) {\n273|\t\tident, ok := target.(*ast.Ident)\n274|\t\tif !ok {\n275|\t\t\treturn\n276|\t\t}\n277|\t\tif helper, ok := resolve(value); ok {\n278|\t\t\tbound[ident.Name] = helper\n279|\t\t}\n280|\t}\n281|\tfor range 4 {\n282|\t\tchanged := false\n283|\t\tast.Inspect(body, func(node ast.Node) bool {\n284|\t\t\tswitch value := node.(type) {\n285|\t\t\tcase *ast.AssignStmt:\n286|\t\t\t\tif len(value.Lhs) == 1 && len(value.Rhs) == 1 {\n287|\t\t\t\t\tbefore := len(bound)\n288|\t\t\t\t\tbind(value.Lhs[0], value.Rhs[0])\n289|\t\t\t\t\tchanged = changed || len(bound) != before\n290|\t\t\t\t}\n291|\t\t\tcase *ast.ValueSpec:\n292|\t\t\t\tif len(value.Names) == 1 && len(value.Values) == 1 {\n293|\t\t\t\t\tbefore := len(bound)\n294|\t\t\t\t\tbind(value.Names[0], value.Values[0])\n295|\t\t\t\t\tchanged = changed || len(bound) != before\n296|\t\t\t\t}\n297|\t\t\t}\n298|\t\t\treturn true\n299|\t\t})\n300|\t\tif !changed {\n301|\t\t\tbreak\n302|\t\t}\n303|\t}\n304|\treturn bound\n305|}\n306|\n307|func censusWalk(fileset *token.FileSet, node ast.Node, ancestors []ast.Node, funcName string, aliases map[string]string) []string {\n308|\tvar violations []string\n309|\tpush := append(ancestors, node)\n310|\tswitch value := node.(type) {\n311|\tcase *ast.FuncLit:\n312|\t\t// Nested literals share the body's alias map (fail closed);\n313|\t\t// the enclosing declaration still attributes the violation.\n314|\tcase *ast.CallExpr:\n315|\t\tif violation := censusCallViolation(fileset, value, push, funcName, aliases); violation != \"\" {\n316|\t\t\tviolations = append(violations, violation)\n317|\t\t}\n318|\t\t// A gated helper passed as an argument escapes to whatever the\n319|\t\t// callee does with it; only hold-entry closures may receive\n320|\t\t// pair-writing behavior, and they take closures, never bare\n321|\t\t// helpers.\n322|\t\tfor _, argument := range value.Args {\n323|\t\t\tif violation := censusEscapeViolation(fileset, argument, funcName, aliases, \"argument\"); violation != \"\" {\n324|\t\t\t\tviolations = append(violations, violation)\n325|\t\t\t}\n326|\t\t}\n327|\tcase *ast.AssignStmt:\n328|\t\tfor _, right := range value.Rhs {\n329|\t\t\tif _, ok := right.(*ast.CallExpr); ok {\n330|\t\t\t\tcontinue\n331|\t\t\t}\n332|\t\t\tif violation := censusEscapeViolation(fileset, right, funcName, aliases, \"assignment\"); violation != \"\" {\n333|\t\t\t\tviolations = append(violations, violation)\n334|\t\t\t}\n335|\t\t}\n336|\tcase *ast.ValueSpec:\n337|\t\tfor _, initializer := range value.Values {\n338|\t\t\tif _, ok := initializer.(*ast.CallExpr); ok {\n339|\t\t\t\tcontinue\n340|\t\t\t}\n341|\t\t\tif violation := censusEscapeViolation(fileset, initializer, funcName, aliases, \"initializer\"); violation != \"\" {\n342|\t\t\t\tviolations = append(violations, violation)\n343|\t\t\t}\n344|\t\t}\n345|\tcase *ast.ReturnStmt:\n346|\t\tfor _, result := range value.Results {\n347|\t\t\tif _, ok := result.(*ast.CallExpr); ok {\n348|\t\t\t\tcontinue\n349|\t\t\t}\n350|\t\t\tif violation := censusEscapeViolation(fileset, result, funcName, aliases, \"return\"); violation != \"\" {\n351|\t\t\t\tviolations = append(violations, violation)\n352|\t\t\t}\n353|\t\t}\n354|\tcase *ast.KeyValueExpr:\n355|\t\tif _, ok := value.Value.(*ast.CallExpr); !ok {\n356|\t\t\tif violation := censusEscapeViolation(fileset, value.Value, funcName, aliases, \"field\"); violation != \"\" {\n357|\t\t\t\tviolations = append(violations, violation)\n358|\t\t\t}\n359|\t\t}\n360|\t}\n361|\tfor _, child := range censusChildren(node) {\n362|\t\tviolations = append(violations, censusWalk(fileset, child, push, funcName, aliases)...)\n363|\t}\n364|\treturn violations\n365|}\n366|\n367|// censusEscapeViolation flags a gated helper flowing as a value. Direct\n368|// references and resolved aliases both count. Call targets are excluded:\n369|// a call is judged by the call rule, so a censused call nested in the\n370|// expression (for example inside a hold-entry closure argument) must not\n371|// double-flag as an escape. Selector and field names are excluded as\n372|// well: only value positions count.\n373|func censusEscapeViolation(fileset *token.FileSet, expression ast.Expr, funcName string, aliases map[string]string, where string) string {\n374|\texcluded := map[*ast.Ident]bool{}\n375|\tast.Inspect(expression, func(node ast.Node) bool {\n376|\t\tswitch value := node.(type) {\n377|\t\tcase *ast.CallExpr:\n378|\t\t\tswitch fun := value.Fun.(type) {\n379|\t\t\tcase *ast.Ident:\n380|\t\t\t\texcluded[fun] = true\n381|\t\t\tcase *ast.SelectorExpr:\n382|\t\t\t\texcluded[fun.Sel] = true\n383|\t\t\t}\n384|\t\tcase *ast.SelectorExpr:\n385|\t\t\texcluded[value.Sel] = true\n386|\t\tcase *ast.KeyValueExpr:\n387|\t\t\tif ident, ok := value.Key.(*ast.Ident); ok {\n388|\t\t\t\texcluded[ident] = true\n389|\t\t\t}\n390|\t\t}\n391|\t\treturn true\n392|\t})\n393|\tfound := \"\"\n394|\tast.Inspect(expression, func(node ast.Node) bool {\n395|\t\tident, ok := node.(*ast.Ident)\n396|\t\tif !ok || excluded[ident] {\n397|\t\t\treturn true\n398|\t\t}\n399|\t\tif ident.Name == \"nil\" {\n400|\t\t\treturn true\n401|\t\t}\n402|\t\tif censusGatedIdents[ident.Name] {\n403|\t\t\tfound = ident.Name\n404|\t\t\treturn false\n405|\t\t}\n406|\t\tif helper, ok := aliases[ident.Name]; ok {\n407|\t\t\tfound = helper + \" (via alias \" + ident.Name + \")\"\n408|\t\t\treturn false\n409|\t\t}\n410|\t\treturn true\n411|\t})\n412|\tif found == \"\" {\n413|\t\treturn \"\"\n414|\t}\n415|\tposition := fileset.Position(expression.Pos())\n416|\treturn censusViolation(\"%s:%d: gated helper %s escapes as %s in %s\", position.Filename, position.Line, found, where, funcName)\n417|}\n418|\n419|func censusChildren(node ast.Node) []ast.Node {\n420|\tvar children []ast.Node\n421|\tast.Inspect(node, func(child ast.Node) bool {\n422|\t\tif child == nil || child == node {\n423|\t\t\treturn true\n424|\t\t}\n425|\t\tchildren = append(children, child)\n426|\t\treturn false\n427|\t})\n428|\treturn children\n429|}\n430|\n431|// censusCallTarget resolves a call to its helper name and whether it is\n432|// a direct standard-library call (os.X), a seam/ordinary selector call,\n433|// or a plain identifier call (with alias resolution).\n434|func censusCallTarget(call *ast.CallExpr, aliases map[string]string) (name string, osDirect bool, ok bool) {\n435|\tswitch function := call.Fun.(type) {\n436|\tcase *ast.Ident:\n437|\t\tif helper, bound := aliases[function.Name]; bound {\n438|\t\t\treturn helper, false, true\n439|\t\t}\n440|\t\treturn function.Name, false, true\n441|\tcase *ast.SelectorExpr:\n442|\t\tif ident, ok := function.X.(*ast.Ident); ok && ident.Name == \"os\" {\n443|\t\t\treturn function.Sel.Name, true, true\n444|\t\t}\n445|\t\tif ident, ok := function.X.(*ast.Ident); ok && censusPackageIdents[ident.Name] {\n446|\t\t\treturn \"\", false, false\n447|\t\t}\n448|\t\treturn function.Sel.Name, false, true\n449|\tdefault:\n450|\t\treturn \"\", false, false\n451|\t}\n452|}\n453|\n454|func censusCallViolation(fileset *token.FileSet, call *ast.CallExpr, ancestors []ast.Node, funcName string, aliases map[string]string) string {\n455|\tname, osDirect, ok := censusCallTarget(call, aliases)\n456|\tif !ok {\n457|\t\treturn \"\"\n458|\t}\n459|\tposition := fileset.Position(call.Pos())\n460|\tlocate := func() string {\n461|\t\treturn fmt.Sprintf(\"%s:%d: %s call in %s\", position.Filename, position.Line, name, funcName)\n462|\t}\n463|\tif osDirect {\n464|\t\t// Backend definitions never reach this walk (their bodies are\n465|\t\t// skipped), so any direct os mutation here is a rogue writer.\n466|\t\tif censusOSMutations[name] {\n467|\t\t\treturn censusViolation(\"%s is a direct os mutation outside the backend definitions\", locate())\n468|\t\t}\n469|\t\treturn \"\"\n470|\t}\n471|\tif censusPairHelpers[name] {\n472|\t\tif censusInsideHoldClosure(ancestors) {\n473|\t\t\treturn \"\"\n474|\t\t}\n475|\t\treturn censusViolation(\"%s is outside a JointCommit/WithExclusiveHold closure\", locate())\n476|\t}\n477|\tif allowed, gated := censusTrustHelpers[name]; gated {\n478|\t\tif allowed[funcName] {\n479|\t\t\treturn \"\"\n480|\t\t}\n481|\t\treturn censusViolation(\"%s is outside the censused lock-held writers\", locate())\n482|\t}\n483|\tif allowed, gated := censusCustodyHelpers[name]; gated {\n484|\t\tif allowed[funcName] {\n485|\t\t\treturn \"\"\n486|\t\t}\n487|\t\treturn censusViolation(\"%s is outside the censused custody sites\", locate())\n488|\t}\n489|\tif allowed, gated := censusRawMutations[name]; gated {\n490|\t\tif allowed[funcName] {\n491|\t\t\treturn \"\"\n492|\t\t}\n493|\t\treturn censusViolation(\"%s is outside the censused mutation helpers\", locate())\n494|\t}\n495|\treturn \"\"\n496|}\n497|\n498|// censusInsideHoldClosure reports whether the call sits in a function\n499|// literal passed directly as a hold-entry argument (JointCommit or\n500|// WithExclusiveHold). Ancestors run outermost-first, so the literal's\n(more lines below)","final_result":true}}}
