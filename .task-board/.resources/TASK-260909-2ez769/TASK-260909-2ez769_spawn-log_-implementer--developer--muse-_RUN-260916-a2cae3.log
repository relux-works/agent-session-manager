{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000caa1","stream":{"kind":"session","id":"01a0ac04-3aa6-7f83-a640-4d27d55c8cba"},"sequence":939,"recorded_at":1780531400001873,"record_type":"event","durability":"durable","causation_id":"792618d5-7c92-47f4-9c2f-44170e04457d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"792618d5-7c92-47f4-9c2f-44170e04457d","run_stream":{"kind":"run","id":"792618d5-7c92-47f4-9c2f-44170e04457d"},"call_id":"call_01a0ac06f270745aa1666bd2db1b6280","text":"Read text file `internal/hosttrust/custody.go`.\n(59 line(s) above)\n60|\tfile, err := os.CreateTemp(dir, pattern)\n61|\tif err != nil {\n62|\t\treturn nil, err\n63|\t}\n64|\tif err := file.Chmod(mode); err != nil {\n65|\t\t_ = file.Close()\n66|\t\t_ = os.Remove(file.Name())\n67|\t\treturn nil, err\n68|\t}\n69|\treturn file, nil\n70|}\n71|\n72|func (osFileSystem) CreateExclusive(path string, mode fs.FileMode) error {\n73|\tfile, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, mode)\n74|\tif err != nil {\n75|\t\treturn err\n76|\t}\n77|\treturn file.Close()\n78|}\n79|\n80|func (osFileSystem) ReadFile(name string) ([]byte, error)   { return os.ReadFile(name) }\n81|func (osFileSystem) Lstat(name string) (fs.FileInfo, error) { return os.Lstat(name) }\n82|func (osFileSystem) Stat(name string) (fs.FileInfo, error)  { return os.Stat(name) }\n83|func (osFileSystem) Remove(name string) error               { return os.Remove(name) }\n84|func (osFileSystem) Rename(oldname, newname string) error   { return os.Rename(oldname, newname) }\n85|\n86|func (osFileSystem) MkdirAll(path string, mode fs.FileMode) error { return os.MkdirAll(path, mode) }\n87|func (osFileSystem) Chmod(name string, mode fs.FileMode) error    { return os.Chmod(name, mode) }\n88|\n89|func (osFileSystem) OpenDirectory(name string) (SyncedDirectory, error) { return os.Open(name) }\n90|func (osFileSystem) ReadDir(name string) ([]fs.DirEntry, error)         { return os.ReadDir(name) }\n91|\n92|// Store is machine-local Host Channel authority rooted at\n93|// STATE_DIR/host-channel. The zero value is unusable; construct with Open.\n94|type Store struct {\n95|\troot string\n96|\tfs   FileSystem\n97|\tlock *fileLock\n98|}\n99|\n100|// Open validates owner-only custody of STATE_DIR/host-channel, creating the\n101|// directory skeleton with exact 0700/0600 modes when absent. Every open\n102|// re-verifies custody: symlink escapes, foreign ownership and group/world\n103|// access refuse with ErrTrustUnsafeCustody.\n104|func Open(stateDir string) (*Store, error) { return openStore(stateDir, osFileSystem{}) }\n105|\n106|func openStore(stateDir string, filesystem FileSystem) (*Store, error) {\n107|\tif filesystem == nil {\n108|\t\treturn nil, trustError(TrustError{Operation: \"open store\", Err: ErrInvalidStoreContext})\n109|\t}\n110|\tif !filepath.IsAbs(stateDir) {\n111|\t\treturn nil, trustError(TrustError{Operation: \"open store\", Err: ErrInvalidStoreContext})\n112|\t}\n113|\troot := filepath.Join(stateDir, hostChannelDir)\n114|\tif err := ensureOwnerDir(filesystem, root, 0o700); err != nil {\n115|\t\treturn nil, err\n116|\t}\n117|\tif err := ensureOwnerDir(filesystem, filepath.Join(root, credentialsDir), 0o700); err != nil {\n118|\t\treturn nil, err\n119|\t}\n120|\tlock, err := openLock(filesystem, filepath.Join(root, lockFileName))\n121|\tif err != nil {\n122|\t\treturn nil, err\n123|\t}\n124|\tstore := &Store{root: root, fs: filesystem, lock: lock}\n125|\t// Converge one interrupted joint config-plus-trust commit, if any: a\n126|\t// crash between the configuration replacement and the generation bump\n127|\t// must complete forward or abort on restart, never admit the new\n128|\t// configuration with the old generation. A refused recovery fails the\n129|\t// open so incoherent state cannot be used.\n130|\tif _, err := store.Recover(); err != nil {\n131|\t\treturn nil, err\n132|\t}\n133|\treturn store, nil\n134|}\n135|\n136|// Root reports the validated host-channel directory. It carries no secrets.\n137|func (store *Store) Root() string { return store.root }\n138|\n139|// TrustPath reports the trust.json path for operator diagnostics. Reading or\n140|// writing it directly bypasses the authorization lock; use transactions.\n141|func (store *Store) TrustPath() string { return filepath.Join(store.root, trustFileName) }\n142|\n143|// PendingCommitPath reports the pending-commit.json path for operator\n144|// diagnostics. A marker left here after a crash converges automatically on\n145|// the next converged read; a marker that refuses convergence needs\n146|// operator resolution and must never be deleted blindly.\n147|func (store *Store) PendingCommitPath() string { return pendingPath(store.root) }\n148|\n149|// CredentialDir reports the custody directory for one credential ID hex. It\n150|// carries no key material.\n151|func (store *Store) CredentialDir(credentialHex string) (string, error) {\n152|\tif len(credentialHex) != 64 {\n153|\t\treturn \"\", trustError(TrustError{Operation: \"resolve credential directory\", Err: ErrCredentialCustody})\n154|\t}\n155|\tfor _, unit := range credentialHex {\n156|\t\tif (unit < '0' || unit > '9') && (unit < 'a' || unit > 'f') {\n157|\t\t\treturn \"\", trustError(TrustError{Operation: \"resolve credential directory\", Err: ErrCredentialCustody})\n158|\t\t}\n159|\t}\n160|\treturn filepath.Join(store.root, credentialsDir, credentialHex), nil\n161|}\n162|\n163|func ensureOwnerDir(filesystem FileSystem, path string, mode fs.FileMode) error {\n164|\tinfo, err := filesystem.Lstat(path)\n165|\tif err != nil && !os.IsNotExist(err) {\n166|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n167|\t}\n168|\tif err == nil {\n169|\t\t// An existing directory is verified, never repaired: silently\n170|\t\t// narrowing a widened directory would mask the custody violation.\n171|\t\treturn verifyOwnerDir(path, info, mode)\n172|\t}\n173|\tif err := filesystem.MkdirAll(path, mode); err != nil {\n174|\t\treturn trustError(TrustError{Operation: \"create directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n175|\t}\n176|\t// MkdirAll honors umask, so the exact owner-only mode is enforced\n177|\t// explicitly after creation.\n178|\tif err := filesystem.Chmod(path, mode); err != nil {\n179|\t\treturn trustError(TrustError{Operation: \"create directory\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n180|\t}\n181|\t// On platforms where mode bits do not govern access, install the\n182|\t// owner-only ACL at creation: verification below would otherwise\n183|\t// refuse the directory the store just created.\n184|\tif err := secureStaged(path, true); err != nil {\n185|\t\treturn err\n186|\t}\n187|\tinfo, err = filesystem.Lstat(path)\n188|\tif err != nil {\n189|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n190|\t}\n191|\treturn verifyOwnerDir(path, info, mode)\n192|}\n193|\n194|func verifyOwnerDir(path string, info fs.FileInfo, mode fs.FileMode) error {\n195|\tif !info.IsDir() {\n196|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: ErrTrustUnsafeCustody})\n197|\t}\n198|\tif info.Mode()&fs.ModeSymlink != 0 {\n199|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: ErrTrustUnsafeCustody})\n200|\t}\n201|\t// Permission bits are a Unix signal only: on Windows the DACL governs and\n202|\t// Go synthesizes mode bits from the read-only attribute, so an exact\n203|\t// comparison would refuse every Windows path. verifyOwner enforces the\n204|\t// owner-only DACL there.\n205|\tif !platformModeOK(info, mode) {\n206|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: ErrTrustUnsafeCustody})\n207|\t}\n208|\treturn verifyOwner(path, info)\n209|}\n210|\n211|// lockVerifyBudget bounds verification retries on an existing lock file.\n212|// A concurrent first-opener can observe the lock between its atomic\n213|// creation and the creator's mode/ACL install; the window is one Chmod and\n214|// one ACL install, so a fraction of a second closes it on any supported\n215|// platform. Genuine custody violations still refuse once the budget\n216|// expires.\n217|const lockVerifyBudget = 500 * time.Millisecond\n218|\n219|const lockVerifyRetry = 5 * time.Millisecond\n220|\n221|// verifyLockFile verifies owner-only custody of an existing lock file. A\n222|// non-regular file refuses immediately: lock creation only ever publishes\n223|// regular files, so a symlink or directory at the path can never be a\n224|// half-installed lock. Other verification failures retry within the\n225|// budget before refusing, so a racing first-open never fails spuriously.\n226|func verifyLockFile(filesystem FileSystem, path string) error {\n227|\tdeadline := time.Now().Add(lockVerifyBudget)\n228|\tfor {\n229|\t\tinfo, err := filesystem.Lstat(path)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000caa3","stream":{"kind":"session","id":"01a0ac04-3aa6-7f83-a640-4d27d55c8cba"},"sequence":940,"recorded_at":1780531400001875,"record_type":"event","durability":"durable","causation_id":"792618d5-7c92-47f4-9c2f-44170e04457d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"792618d5-7c92-47f4-9c2f-44170e04457d","run_stream":{"kind":"run","id":"792618d5-7c92-47f4-9c2f-44170e04457d"},"call_id":"call_01a0ac06f500733dac0ee22a39b6ab04","text":"Read text file `internal/hosttrust/lock_unix.go`.\n1|//go:build darwin || linux\n2|\n3|package hosttrust\n4|\n5|import (\n6|\t\"errors\"\n7|\t\"os\"\n8|\t\"sync\"\n9|\n10|\t\"golang.org/x/sys/unix\"\n11|)\n12|\n13|// fileLock is the machine-local cross-process authorization lock shared by\n14|// trust changes and Configuration 4.0.0 peer/credential changes. Readers hold\n15|// it shared; transactions hold it exclusive, so a revocation or config commit\n16|// can never land between a dispatch check and its side-effect boundary.\n17|//\n18|// Every acquisition opens its own file description: flock locks attach to the\n19|// open file description, so goroutines sharing one retained descriptor would\n20|// not serialize. Per-acquisition descriptors make both same-process\n21|// goroutines and separate processes block on a held exclusive lock. A caller\n22|// must never request a second acquisition while holding one in the same\n23|// goroutine; internal reads nested inside a holder use descriptor-direct\n24|// unlocked reads instead of re-acquiring.\n25|type fileLock struct {\n26|\tpath string\n27|}\n28|\n29|// lockInitMu serializes concurrent creation of the lock file itself.\n30|var lockInitMu sync.Mutex\n31|\n32|// openLock attaches to the shared lock file, creating it exactly once\n33|// across all processes. Creation is atomic and non-replacing\n34|// (O_CREAT|O_EXCL): a process that observes absence while another process\n35|// creates the lock loses the race and opens the existing inode instead of\n36|// renaming over a live lock, so concurrent first-open can never split the\n37|// authorization lock across two inodes.\n38|func openLock(filesystem FileSystem, path string) (*fileLock, error) {\n39|\tlockInitMu.Lock()\n40|\tdefer lockInitMu.Unlock()\n41|\t_, err := filesystem.Lstat(path)\n42|\tif err == nil {\n43|\t\tif err := verifyLockFile(filesystem, path); err != nil {\n44|\t\t\treturn nil, err\n45|\t\t}\n46|\t\treturn &fileLock{path: path}, nil\n47|\t}\n48|\tif !os.IsNotExist(err) {\n49|\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n50|\t}\n51|\tif err := filesystem.CreateExclusive(path, 0o600); err != nil {\n52|\t\t// Lost the creation race: another process published the lock\n53|\t\t// first. Open the existing inode; never replace it.\n54|\t\tif !isLockExistsError(err) {\n55|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n56|\t\t}\n57|\t\tif err := verifyLockFile(filesystem, path); err != nil {\n58|\t\t\treturn nil, err\n59|\t\t}\n60|\t\treturn &fileLock{path: path}, nil\n61|\t}\n62|\tif err := filesystem.Chmod(path, 0o600); err != nil {\n63|\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n64|\t}\n65|\tif err := secureStaged(path, false); err != nil {\n66|\t\treturn nil, err\n67|\t}\n68|\tinfo, err := filesystem.Lstat(path)\n69|\tif err != nil {\n70|\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n71|\t}\n72|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n73|\t\treturn nil, err\n74|\t}\n75|\treturn &fileLock{path: path}, nil\n76|}\n77|\n78|// isLockExistsError reports a lost creation race: the lock file already\n79|// exists, so the caller must open it rather than publish over it.\n80|func isLockExistsError(err error) bool {\n81|\treturn os.IsExist(err) || errors.Is(err, unix.EEXIST)\n82|}\n83|\n84|// openLockFD opens one private file description for a single acquisition.\n85|// O_NOFOLLOW refuses symlink escapes at open time; the descriptor never\n86|// follows a link swapped in after Lstat.\n87|func openLockFD(path string) (int, error) {\n88|\tfd, err := unix.Open(path, unix.O_RDWR|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)\n89|\tif err != nil {\n90|\t\tjoined := errors.Join(ErrTrustStoreUnreadable, err)\n91|\t\tif errors.Is(err, unix.ELOOP) {\n92|\t\t\tjoined = errors.Join(ErrTrustUnsafeCustody, err)\n93|\t\t}\n94|\t\treturn -1, trustError(TrustError{Operation: \"open lock\", Err: joined})\n95|\t}\n96|\treturn fd, nil\n97|}\n98|\n99|func (lock *fileLock) shared() (func(), error) {\n100|\tfd, err := openLockFD(lock.path)\n101|\tif err != nil {\n102|\t\treturn nil, err\n103|\t}\n104|\tif err := unix.Flock(fd, unix.LOCK_SH); err != nil {\n105|\t\t_ = unix.Close(fd)\n106|\t\treturn nil, err\n107|\t}\n108|\treturn func() {\n109|\t\t_ = unix.Flock(fd, unix.LOCK_UN)\n110|\t\t_ = unix.Close(fd)\n111|\t}, nil\n112|}\n113|\n114|func (lock *fileLock) exclusive() (func(), error) {\n115|\tfd, err := openLockFD(lock.path)\n116|\tif err != nil {\n117|\t\treturn nil, err\n118|\t}\n119|\tif err := unix.Flock(fd, unix.LOCK_EX); err != nil {\n120|\t\t_ = unix.Close(fd)\n121|\t\treturn nil, err\n122|\t}\n123|\treturn func() {\n124|\t\t_ = unix.Flock(fd, unix.LOCK_UN)\n125|\t\t_ = unix.Close(fd)\n126|\t}, nil\n127|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
