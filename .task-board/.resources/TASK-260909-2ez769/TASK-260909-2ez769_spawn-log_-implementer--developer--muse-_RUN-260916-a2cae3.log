re.root, store.lock, fn)\n163|}\n164|\n165|func transact(filesystem FileSystem, root string, lock *fileLock, fn TransactionFunc) error {\n166|\thold, unlock, err := lock.exclusiveHold()\n167|\tif err != nil {\n168|\t\treturn trustError(TrustError{Operation: \"lock transaction\", Err: errors.Join(ErrTrustDurability, err)})\n169|\t}\n170|\tdefer unlock()\n171|\tif err := convergeLocked(hold, filesystem, root); err != nil {\n172|\t\treturn err\n173|\t}\n174|\treturn transactLocked(hold, filesystem, root, fn)\n175|}\n176|\n177|// transactLocked runs one crash-durable generation transaction assuming the\n178|// caller already holds the exclusive authorization lock. Joint commits and\n179|// recovery use it to sequence the marker, the external replacement and the\n180|// bump under a single hold. The hold proves the exclusion window the bump\n181|// commits under; without it the bump refuses.\n182|func transactLocked(hold HeldExclusive, filesystem FileSystem, root string, fn TransactionFunc) error {\n183|\tif err := requireHold(hold); err != nil {\n184|\t\treturn err\n185|\t}\n186|\tcommitted, err := loadCommitted(filesystem, root)\n187|\tif err != nil {\n188|\t\treturn err\n189|\t}\n190|\tnext := committed\n191|\tnext.Entries = append([]CredentialEntry(nil), committed.Entries...)\n192|\tif err := fn(&next); err != nil {\n193|\t\treturn err\n194|\t}\n195|\tif next.Generation != committed.Generation {\n196|\t\treturn trustError(TrustError{Operation: \"commit generation\", Err: ErrTrustDurability})\n197|\t}\n198|\tif committed.Generation >= MaxGeneration {\n199|\t\treturn trustError(TrustError{Operation: \"commit generation\", Err: ErrGenerationExhausted})\n200|\t}\n201|\tnext.Generation = committed.Generation + 1\n202|\tencoded, err := EncodeTrust(next)\n203|\tif err != nil {\n204|\t\treturn err\n205|\t}\n206|\tif err := commitDocument(hold, filesystem, root, filepath.Join(root, trustFileName), encoded); err != nil {\n207|\t\treturn err\n208|\t}\n209|\treturn nil\n210|}\n211|\n212|// loadCommitted reads the committed trust without acquiring the lock: the\n213|// caller must already hold the authorization lock, and (outside recovery\n214|// itself) must have converged pending joint intent first.\n215|func loadCommitted(filesystem FileSystem, root string) (TrustStore, error) {\n216|\tpath := filepath.Join(root, trustFileName)\n217|\tinfo, err := filesystem.Lstat(path)\n218|\tif err != nil {\n219|\t\tif os.IsNotExist(err) {\n220|\t\t\treturn TrustStore{}, trustError(TrustError{Operation: \"read committed trust\", Err: ErrTrustStoreMissing})\n221|\t\t}\n222|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"read committed trust\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n223|\t}\n224|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n225|\t\treturn TrustStore{}, err\n226|\t}\n227|\tdocument, err := filesystem.ReadFile(path)\n228|\tif err != nil {\n229|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"read committed trust\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n230|\t}\n231|\tdecoded, err := DecodeTrust(document)\n232|\tif err != nil {\n233|\t\treturn TrustStore{}, err\n234|\t}\n235|\treturn decoded, nil\n236|}\n237|\n238|// commitDocument stages bytes in a temp file with fsync, atomically renames\n239|// over the target, and fsyncs the directory. On restart only the last fully\n240|// committed file is selected; staged files are ignored by every reader.\n241|// The hold proves the live exclusion window the commit lands under; a\n242|// forged, absent or released hold refuses before anything is staged.\n243|func commitDocument(hold HeldExclusive, filesystem FileSystem, root, path string, document []byte) error {\n244|\tif err := requireHold(hold); err != nil {\n245|\t\treturn err\n246|\t}\n247|\tstaged, err := filesystem.CreateTemp(root, stagePrefix+\"*\", 0o600)\n248|\tif err != nil {\n249|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n250|\t}\n251|\tname := staged.Name()\n252|\tfailed := true\n253|\tdefer func() {\n254|\t\tif failed {\n255|\t\t\t_ = filesystem.Remove(name)\n256|\t\t}\n257|\t}()\n258|\tif err := writeAll(staged, document); err != nil {\n259|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n260|\t}\n261|\tif err := staged.Sync(); err != nil {\n262|\t\t_ = staged.Close()\n263|\t\treturn trustError(TrustError{Operation: \"sync trust\", Err: errors.Join(ErrTrustDurability, err)})\n264|\t}\n265|\tif err := staged.Close(); err != nil {\n266|\t\treturn trustError(TrustError{Operation: \"sync trust\", Err: errors.Join(ErrTrustDurability, err)})\n267|\t}\n268|\tif err := filesystem.Chmod(name, 0o600); err != nil {\n269|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n270|\t}\n271|\t// On platforms where mode bits do not govern access, install the\n272|\t// owner-only ACL before the staging file becomes visible under load.\n273|\tif err := secureStaged(name, false); err != nil {\n274|\t\treturn err\n275|\t}\n276|\tif err := filesystem.Rename(name, path); err != nil {\n277|\t\treturn trustError(TrustError{Operation: \"replace trust\", Err: errors.Join(ErrTrustDurability, err)})\n278|\t}\n279|\tif err := syncDir(filesystem, root); err != nil {\n280|\t\treturn trustError(TrustError{Operation: \"sync trust directory\", Err: errors.Join(ErrTrustDurability, err)})\n281|\t}\n282|\tfailed = false\n283|\treturn nil\n284|}\n285|\n286|func writeAll(writer interface{ Write([]byte) (int, error) }, document []byte) error {\n287|\tfor len(document) > 0 {\n288|\t\twritten, err := writer.Write(document)\n289|\t\tif err != nil {\n290|\t\t\treturn err\n291|\t\t}\n292|\t\tif written == 0 {\n293|\t\t\treturn errors.New(\"short trust write\")\n294|\t\t}\n295|\t\tdocument = document[written:]\n296|\t}\n297|\treturn nil\n298|}\n299|\n300|func syncDir(filesystem FileSystem, root string) error {\n301|\thandle, err := filesystem.OpenDirectory(root)\n302|\tif err != nil {\n303|\t\treturn err\n304|\t}\n305|\tif err := handle.Sync(); err != nil {\n306|\t\t_ = handle.Close()\n307|\t\treturn err\n308|\t}\n309|\treturn handle.Close()\n310|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
