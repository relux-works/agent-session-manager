{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c765","stream":{"kind":"session","id":"01a0ac04-3aa6-7f83-a640-4d27d55c8cba"},"sequence":525,"recorded_at":1780531400001045,"record_type":"event","durability":"durable","causation_id":"792618d5-7c92-47f4-9c2f-44170e04457d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"792618d5-7c92-47f4-9c2f-44170e04457d","run_stream":{"kind":"run","id":"792618d5-7c92-47f4-9c2f-44170e04457d"},"task_stream":{"kind":"task","id":"01a0ac05-b426-7011-beb6-78786a878959"},"task_id":"01a0ac05-b426-7011-beb6-78786a878959","event":{"kind":"output","task_id":"01a0ac05-b426-7011-beb6-78786a878959","chunk":"{\n  \"chunk_id\": \"exec-15-1\",\n  \"command\": \"cd /tmp/rev7ev && cat census-results.json 2>&1; echo \\\"===foreign hold probe===\\\"; ls probes/config/ 2>&1; echo \\\"===capability test===\\\"; cat probes/config/reviewer_capability_test.go 2>&1 | head -n 120\",\n  \"description\": \"Read census results and foreign hold probe\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"[\\n  {\\n    \\\"plant\\\": \\\"direct_control\\\",\\n    \\\"exit\\\": 1,\\n    \\\"witness_pass\\\": true,\\n    \\\"gate_pass\\\": false\\n  },\\n  {\\n    \\\"plant\\\": \\\"map_function_value\\\",\\n    \\\"exit\\\": 0,\\n    \\\"witness_pass\\\": true,\\n    \\\"gate_pass\\\": true\\n  },\\n  {\\n    \\\"plant\\\": \\\"alias_import\\\",\\n    \\\"exit\\\": 0,\\n    \\\"witness_pass\\\": true,\\n    \\\"gate_pass\\\": true\\n  },\\n  {\\n    \\\"plant\\\": \\\"returned_closure_initializer\\\",\\n    \\\"exit\\\": 0,\\n    \\\"witness_pass\\\": true,\\n    \\\"gate_pass\\\": true\\n  },\\n  {\\n    \\\"plant\\\": \\\"backend_method_value\\\",\\n    \\\"exit\\\": 0,\\n    \\\"witness_pass\\\": true,\\n    \\\"gate_pass\\\": true\\n  }\\n]===foreign hold probe===\\nreviewer_capability_test.go\\nreviewer_crash_test.go\\nreviewer_failed_restore_race_test.go\\nreviewer_foreign_writer.go\\nreviewer_legacy_test.go\\nreviewer_partial_test.go\\n===capability test===\\npackage config\\nimport (\\n \\\"os\\\"\\n \\\"path/filepath\\\"\\n \\\"testing\\\"\\n \\\"time\\\"\\n \\\"github.com/relux-works/agent-session-manager/internal/hosttrust\\\"\\n)\\nfunc TestReviewerForeignHoldCannotWriteLockedPair(t *testing.T) {\\n fixture:=setupV4Fixture(t,testPeerID)\\n other,err:=hosttrust.Open(filepath.Join(t.TempDir(),\\\"other-state\\\"));if err!=nil{t.Fatal(err)}\\n before,err:=os.ReadFile(fixture.filename);if err!=nil{t.Fatal(err)}\\n replacement:=append(append([]byte{},before...),[]byte(\\\"\\\\n# foreign lock write\\\\n\\\")...)\\n entered,release:=make(chan struct{}),make(chan struct{})\\n done:=make(chan error,1)\\n go func(){done<-fixture.store.WithExclusiveHold(func(hosttrust.HeldExclusive)error{close(entered);<-release;return nil})}()\\n select{case <-entered:case <-time.After(5*time.Second):t.Fatal(\\\"target hold not acquired\\\")}\\n defer func(){close(release);if e:=<-done;e!=nil{t.Error(e)}}()\\n // This goroutine receives only the unrelated store. The target's holder\\n // remains blocked in a separate goroutine and never lends its token.\\n writeErr:=reviewerForeignWrite(other,fixture.filename,replacement)\\n if writeErr==nil{\\n  after,e:=os.ReadFile(fixture.filename);if e!=nil{t.Fatal(e)}\\n  if string(after)!=string(replacement){t.Fatal(\\\"witness failed\\\")}\\n  t.Fatal(\\\"foreign store token replaced target configuration while another goroutine exclusively held target store\\\")\\n }\\n}\\n\",\n  \"original_output_bytes\": 2092,\n  \"original_output_tokens\": 523,\n  \"truncated\": false\n}","final_result":true}}}
