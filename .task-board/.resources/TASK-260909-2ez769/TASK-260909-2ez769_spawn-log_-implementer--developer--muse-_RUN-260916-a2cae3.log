{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8cf","stream":{"kind":"session","id":"01a0ac04-3aa6-7f83-a640-4d27d55c8cba"},"sequence":706,"recorded_at":1780531400001407,"record_type":"event","durability":"durable","causation_id":"792618d5-7c92-47f4-9c2f-44170e04457d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"792618d5-7c92-47f4-9c2f-44170e04457d","run_stream":{"kind":"run","id":"792618d5-7c92-47f4-9c2f-44170e04457d"},"task_stream":{"kind":"task","id":"01a0ac06-7e1f-7d81-8841-d488b1647c69"},"task_id":"01a0ac06-7e1f-7d81-8841-d488b1647c69","event":{"kind":"output","task_id":"01a0ac06-7e1f-7d81-8841-d488b1647c69","chunk":"Read text file `internal/hosttrust/hold.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"sync/atomic\"\n6|)\n7|\n8|// HeldExclusive is the unforgeable capability proving the holder acquired\n9|// the exclusive authorization lock and that the hold is still live. Only\n10|// the lock acquisition path (exclusiveHold) constructs a genuine value;\n11|// every other package sees an opaque struct it can pass along but never\n12|// forge: the zero value and any use-after-release refuse wherever a hold\n13|// is required.\n14|//\n15|// A hold proves serialization, not protocol: helpers that mutate the\n16|// config-plus-trust pair require a live hold (fail closed without one),\n17|// while the write-path census gate statically restricts which call sites\n18|// may perform pair mutations at all.\n19|type HeldExclusive struct {\n20|\thold *exclusiveHold\n21|}\n22|\n23|// exclusiveHold is the liveness cell behind one HeldExclusive. The unlock\n24|// wrapper marks it released, so a token stashed past its hold refuses\n25|// instead of authorizing a write outside the exclusion window.\n26|type exclusiveHold struct {\n27|\treleased atomic.Bool\n28|}\n29|\n30|// Valid reports a genuine live hold: constructed by the lock acquisition\n31|// path and not yet released.\n32|func (held HeldExclusive) Valid() bool {\n33|\treturn held.hold != nil && !held.hold.released.Load()\n34|}\n35|\n36|// IsZero reports the zero value, which never authorizes a write. It lets\n37|// narrowing tests distinguish a forged/absent token from a released one.\n38|func (held HeldExclusive) IsZero() bool {\n39|\treturn held.hold == nil\n40|}\n41|\n42|// requireHold refuses a pair mutation attempted without a live exclusive\n43|// hold. It is the single enforcement point behind every token-gated\n44|// helper; weakening it admits exactly the ungated writes the narrowing\n45|// plants cover.\n46|func requireHold(hold HeldExclusive) error {\n47|\tif !hold.Valid() {\n48|\t\treturn trustError(TrustError{Operation: \"require exclusive hold\", Err: ErrExclusiveHoldRequired})\n49|\t}\n50|\treturn nil\n51|}\n52|\n53|// exclusiveHold acquires the exclusive authorization lock and returns the\n54|// capability proving the hold plus its release function. The release marks\n55|// the capability expired before unlocking, so no write can slip outside\n56|// the exclusion window it was authorized under.\n57|func (lock *fileLock) exclusiveHold() (HeldExclusive, func(), error) {\n58|\tunlock, err := lock.exclusive()\n59|\tif err != nil {\n60|\t\treturn HeldExclusive{}, nil, err\n61|\t}\n62|\tstate := &exclusiveHold{}\n63|\treturn HeldExclusive{hold: state}, func() {\n64|\t\tstate.released.Store(true)\n65|\t\tunlock()\n66|\t}, nil\n67|}\n68|\n69|// WithExclusiveHold runs fn under the exclusive authorization lock with\n70|// the capability proving the hold. Pending joint intent converges first,\n71|// so fn never runs beside unresolved intent; fn receives the live hold to\n72|// pass to token-gated pair writers. Legacy configuration migration uses\n73|// this to serialize with joint commits; credential lifecycle and joint\n74|// commits take their holds through their own entries.\n75|func (store *Store) WithExclusiveHold(fn func(HeldExclusive) error) error {\n76|\thold, unlock, err := store.lock.exclusiveHold()\n77|\tif err != nil {\n78|\t\treturn trustError(TrustError{Operation: \"lock exclusive hold\", Err: errors.Join(ErrTrustDurability, err)})\n79|\t}\n80|\tdefer unlock()\n81|\tif err := convergeLocked(hold, store.fs, store.root); err != nil {\n82|\t\treturn err\n83|\t}\n84|\tif fn == nil {\n85|\t\treturn trustError(TrustError{Operation: \"run exclusive hold\", Err: ErrAuthorizationRefused})\n86|\t}\n87|\treturn fn(hold)\n88|}","final_result":true}}}
