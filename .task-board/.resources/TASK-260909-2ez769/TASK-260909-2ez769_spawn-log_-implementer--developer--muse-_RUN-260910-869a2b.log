{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000deb9","stream":{"kind":"session","id":"01a08946-5fbe-7830-b2e8-af2616179f48"},"sequence":3511,"recorded_at":1780531400007017,"record_type":"event","durability":"durable","causation_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","run_stream":{"kind":"run","id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f"},"task_stream":{"kind":"task","id":"01a08956-c61d-78a1-b3a5-ba4218740bef"},"task_id":"01a08956-c61d-78a1-b3a5-ba4218740bef","event":{"kind":"output","task_id":"01a08956-c61d-78a1-b3a5-ba4218740bef","chunk":"edited\nchanged lines: lines 213-218\n--- original\n+++ updated\n@@\n-\t// On platforms where mode bits do not govern access, install the\n-\t// owner-only ACL before the staging file becomes visible under load.\n-\tsecureStaged(name, false)\n-\tif err := filesystem.Rename(name, path); err != nil {\n-\t\treturn trustError(TrustError{Operation: \"replace trust\", Err: errors.Join(ErrTrustDurability, err)})\n-\t}\n+\t// On platforms where mode bits do not govern access, install the\n+\t// owner-only ACL before the staging file becomes visible under load.\n+\tif err := secureStaged(name, false); err != nil {\n+\t\treturn err\n+\t}\n+\tif err := filesystem.Rename(name, path); err != nil {\n+\t\treturn trustError(TrustError{Operation: \"replace trust\", Err: errors.Join(ErrTrustDurability, err)})\n+\t}\n","final_result":true}}}
