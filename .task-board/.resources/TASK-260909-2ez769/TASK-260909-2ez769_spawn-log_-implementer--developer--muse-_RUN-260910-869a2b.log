(current hosttrust.TrustStore) error {\n+\t\tsnapshot, err := Load(inputs, overrides)\n+\t\tif err != nil {\n+\t\t\treturn err\n+\t\t}\n+\t\tcoherent = CoherentSnapshot{Config: snapshot, Trust: current, Generation: current.Generation}\n+\t\treturn nil\n+\t}); err != nil {\n+\t\treturn CoherentSnapshot{}, err\n+\t}\n+\treturn coherent, nil\n+}\n+\n+func stateDirOf(snapshot Snapshot) string {\n","final_result":true}}}
