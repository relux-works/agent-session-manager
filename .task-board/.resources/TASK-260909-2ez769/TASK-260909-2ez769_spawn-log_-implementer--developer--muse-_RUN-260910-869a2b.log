{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c721","stream":{"kind":"session","id":"01a08946-5fbe-7830-b2e8-af2616179f48"},"sequence":491,"recorded_at":1780531400000977,"record_type":"event","durability":"durable","causation_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","run_stream":{"kind":"run","id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f"},"call_id":"call_01a0894722ef77339ef15ad69ffd64fa","text":"Read text file `internal/hosttrust/custody.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"io\"\n6|\t\"io/fs\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|)\n10|\n11|const (\n12|\thostChannelDir  = \"host-channel\"\n13|\ttrustFileName   = \"trust.json\"\n14|\tlockFileName    = \"lock\"\n15|\tcredentialsDir  = \"credentials\"\n16|\tcertificateFile = \"certificate.pem\"\n17|\tprivateKeyFile  = \"private-key.pem\"\n18|\trootFile        = \"root.pem\"\n19|\tstagePrefix     = \".trust-stage-\"\n20|)\n21|\n22|// FileSystem abstracts durable writes so crash and fault paths are testable\n23|// without touching the operator disk. The OS implementation is the only\n24|// production backend.\n25|type FileSystem interface {\n26|\tCreateTemp(dir, pattern string, mode fs.FileMode) (StagedFile, error)\n27|\tReadFile(name string) ([]byte, error)\n28|\tLstat(name string) (fs.FileInfo, error)\n29|\tStat(name string) (fs.FileInfo, error)\n30|\tRemove(name string) error\n31|\tRename(oldname, newname string) error\n32|\tMkdirAll(path string, mode fs.FileMode) error\n33|\tChmod(name string, mode fs.FileMode) error\n34|\tOpenDirectory(name string) (SyncedDirectory, error)\n35|\tReadDir(name string) ([]fs.DirEntry, error)\n36|}\n37|\n38|// StagedFile is one temp staging file awaiting fsync and atomic rename.\n39|type StagedFile interface {\n40|\tio.Writer\n41|\tName() string\n42|\tChmod(fs.FileMode) error\n43|\tSync() error\n44|\tClose() error\n45|}\n46|\n47|// SyncedDirectory fsyncs a directory entry after renames.\n48|type SyncedDirectory interface {\n49|\tSync() error\n50|\tClose() error\n51|}\n52|\n53|type osFileSystem struct{}\n54|\n55|func (osFileSystem) CreateTemp(dir, pattern string, mode fs.FileMode) (StagedFile, error) {\n56|\tfile, err := os.CreateTemp(dir, pattern)\n57|\tif err != nil {\n58|\t\treturn nil, err\n59|\t}\n60|\tif err := file.Chmod(mode); err != nil {\n61|\t\t_ = file.Close()\n62|\t\t_ = os.Remove(file.Name())\n63|\t\treturn nil, err\n64|\t}\n65|\treturn file, nil\n66|}\n67|\n68|func (osFileSystem) ReadFile(name string) ([]byte, error)   { return os.ReadFile(name) }\n69|func (osFileSystem) Lstat(name string) (fs.FileInfo, error) { return os.Lstat(name) }\n70|func (osFileSystem) Stat(name string) (fs.FileInfo, error)  { return os.Stat(name) }\n71|func (osFileSystem) Remove(name string) error               { return os.Remove(name) }\n72|func (osFileSystem) Rename(oldname, newname string) error   { return os.Rename(oldname, newname) }\n73|\n74|func (osFileSystem) MkdirAll(path string, mode fs.FileMode) error { return os.MkdirAll(path, mode) }\n75|func (osFileSystem) Chmod(name string, mode fs.FileMode) error    { return os.Chmod(name, mode) }\n76|\n77|func (osFileSystem) OpenDirectory(name string) (SyncedDirectory, error) { return os.Open(name) }\n78|func (osFileSystem) ReadDir(name string) ([]fs.DirEntry, error)         { return os.ReadDir(name) }\n79|\n80|// Store is machine-local Host Channel authority rooted at\n81|// STATE_DIR/host-channel. The zero value is unusable; construct with Open.\n82|type Store struct {\n83|\troot string\n84|\tfs   FileSystem\n85|\tlock *fileLock\n86|}\n87|\n88|// Open validates owner-only custody of STATE_DIR/host-channel, creating the\n89|// directory skeleton with exact 0700/0600 modes when absent. Every open\n90|// re-verifies custody: symlink escapes, foreign ownership and group/world\n91|// access refuse with ErrTrustUnsafeCustody.\n92|func Open(stateDir string) (*Store, error) { return openStore(stateDir, osFileSystem{}) }\n93|\n94|func openStore(stateDir string, filesystem FileSystem) (*Store, error) {\n95|\tif filesystem == nil {\n96|\t\treturn nil, trustError(TrustError{Operation: \"open store\", Err: ErrInvalidStoreContext})\n97|\t}\n98|\tif !filepath.IsAbs(stateDir) {\n99|\t\treturn nil, trustError(TrustError{Operation: \"open store\", Err: ErrInvalidStoreContext})\n100|\t}\n101|\troot := filepath.Join(stateDir, hostChannelDir)\n102|\tif err := ensureOwnerDir(filesystem, root, 0o700); err != nil {\n103|\t\treturn nil, err\n104|\t}\n105|\tif err := ensureOwnerDir(filesystem, filepath.Join(root, credentialsDir), 0o700); err != nil {\n106|\t\treturn nil, err\n107|\t}\n108|\tlock, err := openLock(filesystem, filepath.Join(root, lockFileName))\n109|\tif err != nil {\n110|\t\treturn nil, err\n111|\t}\n112|\treturn &Store{root: root, fs: filesystem, lock: lock}, nil\n113|}\n114|\n115|// Root reports the validated host-channel directory. It carries no secrets.\n116|func (store *Store) Root() string { return store.root }\n117|\n118|// TrustPath reports the trust.json path for operator diagnostics. Reading or\n119|// writing it directly bypasses the authorization lock; use transactions.\n120|func (store *Store) TrustPath() string { return filepath.Join(store.root, trustFileName) }\n121|\n122|// CredentialDir reports the custody directory for one credential ID hex. It\n123|// carries no key material.\n124|func (store *Store) CredentialDir(credentialHex string) (string, error) {\n125|\tif len(credentialHex) != 64 {\n126|\t\treturn \"\", trustError(TrustError{Operation: \"resolve credential directory\", Err: ErrCredentialCustody})\n127|\t}\n128|\tfor _, unit := range credentialHex {\n129|\t\tif (unit < '0' || unit > '9') && (unit < 'a' || unit > 'f') {\n130|\t\t\treturn \"\", trustError(TrustError{Operation: \"resolve credential directory\", Err: ErrCredentialCustody})\n131|\t\t}\n132|\t}\n133|\treturn filepath.Join(store.root, credentialsDir, credentialHex), nil\n134|}\n135|\n136|func ensureOwnerDir(filesystem FileSystem, path string, mode fs.FileMode) error {\n137|\tinfo, err := filesystem.Lstat(path)\n138|\tif err != nil && !os.IsNotExist(err) {\n139|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n140|\t}\n141|\tif err == nil {\n142|\t\t// An existing directory is verified, never repaired: silently\n143|\t\t// narrowing a widened directory would mask the custody violation.\n144|\t\treturn verifyOwnerDir(path, info, mode)\n145|\t}\n146|\tif err := filesystem.MkdirAll(path, mode); err != nil {\n147|\t\treturn trustError(TrustError{Operation: \"create directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n148|\t}\n149|\t// MkdirAll honors umask, so the exact owner-only mode is enforced\n150|\t// explicitly after creation.\n151|\tif err := filesystem.Chmod(path, mode); err != nil {\n152|\t\treturn trustError(TrustError{Operation: \"create directory\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n153|\t}\n154|\tinfo, err = filesystem.Lstat(path)\n155|\tif err != nil {\n156|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n157|\t}\n158|\treturn verifyOwnerDir(path, info, mode)\n159|}\n160|\n161|func verifyOwnerDir(path string, info fs.FileInfo, mode fs.FileMode) error {\n162|\tif !info.IsDir() {\n163|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: ErrTrustUnsafeCustody})\n164|\t}\n165|\tif info.Mode()&fs.ModeSymlink != 0 {\n166|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: ErrTrustUnsafeCustody})\n167|\t}\n168|\tif info.Mode().Perm() != mode {\n169|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: ErrTrustUnsafeCustody})\n170|\t}\n171|\treturn verifyOwner(path, info)\n172|}\n173|\n174|func verifyOwnerFile(path string, info fs.FileInfo, mode fs.FileMode) error {\n175|\tif !info.Mode().IsRegular() {\n176|\t\treturn trustError(TrustError{Operation: \"inspect file\", Err: ErrTrustUnsafeCustody})\n177|\t}\n178|\tif info.Mode()&fs.ModeSymlink != 0 {\n179|\t\treturn trustError(TrustError{Operation: \"inspect file\", Err: ErrTrustUnsafeCustody})\n180|\t}\n181|\tif info.Mode().Perm() != mode {\n182|\t\treturn trustError(TrustError{Operation: \"inspect file\", Err: ErrTrustUnsafeCustody})\n183|\t}\n184|\treturn verifyOwner(path, info)\n185|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c723","stream":{"kind":"session","id":"01a08946-5fbe-7830-b2e8-af2616179f48"},"sequence":492,"recorded_at":1780531400000979,"record_type":"event","durability":"durable","causation_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","run_stream":{"kind":"run","id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f"},"call_id":"call_01a08947239d7863b5b4b889310feb9f","text":"Read text file `internal/hosttrust/rotate.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"crypto/x509\"\n5|\t\"encoding/pem\"\n6|\t\"errors\"\n7|\t\"path/filepath\"\n8|\t\"time\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|)\n12|\n13|// RotationBound is the maximum overlap of an old credential after the trust\n14|// transition admits its replacement: 24 hours, and never past old leaf\n15|// expiry. There is no overlap extension.\n16|const RotationBound = 24 * time.Hour\n17|\n18|// Rotate keeps the host UUID and creates a new credential with two fresh keys\n19|// and certificates. The local atomic trust transition admits the new entry as\n20|// active and marks the old entry retiring with a fixed retire_at no more than\n21|// 24 hours after the transition and no later than old leaf expiry. No second\n22|// rotation starts until the retiring entry is revoked. Failed enrollment\n23|// leaves the new route unavailable, never auto-trusted.\n24|func (store *Store) Rotate(hostID string, now time.Time) (newCredentialID string, retireAt time.Time, err error) {\n25|\tparsed, err := scalar.ParseUUIDv7(hostID)\n26|\tif err != nil {\n27|\t\treturn \"\", time.Time{}, trustError(TrustError{Operation: \"rotate host\", Err: errors.Join(ErrRotationRefused, err)})\n28|\t}\n29|\tissued, err := IssueCredential(parsed.String(), now, nil)\n30|\tif err != nil {\n31|\t\treturn \"\", time.Time{}, err\n32|\t}\n33|\tcredentialHex := scalar.SHA256Digest(issued.LeafDER).Hex()\n34|\tdirectory := filepath.Join(store.root, credentialsDir, credentialHex)\n35|\tif err := ensureOwnerDir(store.fs, directory, 0o700); err != nil {\n36|\t\treturn \"\", time.Time{}, err\n37|\t}\n38|\tcommitted := false\n39|\tdefer func() {\n40|\t\tif !committed {\n41|\t\t\t_ = store.fs.Remove(filepath.Join(directory, certificateFile))\n42|\t\t\t_ = store.fs.Remove(filepath.Join(directory, privateKeyFile))\n43|\t\t\t_ = store.fs.Remove(filepath.Join(directory, rootFile))\n44|\t\t\t_ = store.fs.Remove(directory)\n45|\t\t}\n46|\t}()\n47|\tif err := writeCustodyFile(store, directory, certificateFile, pem.EncodeToMemory(&pem.Block{Type: \"CERTIFICATE\", Bytes: issued.LeafDER})); err != nil {\n48|\t\treturn \"\", time.Time{}, err\n49|\t}\n50|\tif err := writeCustodyFile(store, directory, privateKeyFile, pem.EncodeToMemory(&pem.Block{Type: \"PRIVATE KEY\", Bytes: issued.LeafKeyDER})); err != nil {\n51|\t\treturn \"\", time.Time{}, err\n52|\t}\n53|\tif err := writeCustodyFile(store, directory, rootFile, pem.EncodeToMemory(&pem.Block{Type: \"CERTIFICATE\", Bytes: issued.RootDER})); err != nil {\n54|\t\treturn \"\", time.Time{}, err\n55|\t}\n56|\tenrolledAt, err := scalar.ParseTimestamp(now.UTC().Format(\"2006-01-02T15:04:05.000Z\"))\n57|\tif err != nil {\n58|\t\treturn \"\", time.Time{}, trustError(TrustError{Operation: \"rotate timestamp\", Err: errors.Join(ErrRotationRefused, err)})\n59|\t}\n60|\tnewEntry := CredentialEntry{\n61|\t\tHostID:       issued.HostID,\n62|\t\tCredentialID: scalar.SHA256Digest(issued.LeafDER),\n63|\t\tSPKIID:       scalar.SHA256Digest(mustSPKI(issued.LeafDER)),\n64|\t\tRootID:       scalar.SHA256Digest(issued.RootDER),\n65|\t\tLeafDER:      issued.LeafDER,\n66|\t\tRootDER:      issued.RootDER,\n67|\t\tState:        EntryActive,\n68|\t\tEnrolledAt:   enrolledAt,\n69|\t}\n70|\tvar fixedRetireAt time.Time\n71|\tif err := store.transact(func(trust *TrustStore) error {\n72|\t\told, err := rotationPredecessor(trust, parsed.String())\n73|\t\tif err != nil {\n74|\t\t\treturn err\n75|\t\t}\n76|\t\toldLeaf, err := x509.ParseCertificate(old.LeafDER)\n77|\t\tif err != nil {\n78|\t\t\treturn trustError(TrustError{Operation: \"rotate predecessor\", Err: errors.Join(ErrRotationRefused, err)})\n79|\t\t}\n80|\t\tdeadline := now.Add(RotationBound)\n81|\t\tif oldLeaf.NotAfter.Before(deadline) {\n82|\t\t\tdeadline = oldLeaf.NotAfter\n83|\t\t}\n84|\t\tif !deadline.After(now) {\n85|\t\t\treturn trustError(TrustError{Operation: \"rotate window\", Err: ErrRotationRefused})\n86|\t\t}\n87|\t\tstamp, err := scalar.ParseTimestamp(deadline.UTC().Format(\"2006-01-02T15:04:05.000Z\"))\n88|\t\tif err != nil {\n89|\t\t\treturn trustError(TrustError{Operation: \"rotate window\", Err: errors.Join(ErrRotationRefused, err)})\n90|\t\t}\n91|\t\tfixedRetireAt, err = stamp.Time()\n92|\t\tif err != nil {\n93|\t\t\treturn trustError(TrustError{Operation: \"rotate window\", Err: errors.Join(ErrRotationRefused, err)})\n94|\t\t}\n95|\t\tfor index := range trust.Entries {\n96|\t\t\tif trust.Entries[index].CredentialID.String() == old.CredentialID.String() {\n97|\t\t\t\ttrust.Entries[index].State = EntryRetiring\n98|\t\t\t\tretiring := stamp\n99|\t\t\t\ttrust.Entries[index].RetireAt = &retiring\n100|\t\t\t}\n101|\t\t}\n102|\t\treturn admitEntry(trust, newEntry)\n103|\t}); err != nil {\n104|\t\treturn \"\", time.Time{}, err\n105|\t}\n106|\tcommitted = true\n107|\treturn newEntry.CredentialID.String(), fixedRetireAt, nil\n108|}\n109|\n110|// rotationPredecessor selects the single active credential of a host. A\n111|// retiring entry blocks a second rotation; zero or multiple active entries\n112|// refuse.\n113|func rotationPredecessor(trust *TrustStore, hostID string) (CredentialEntry, error) {\n114|\tvar active []CredentialEntry\n115|\tfor _, entry := range trust.Entries {\n116|\t\tif entry.HostID.String() != hostID {\n117|\t\t\tcontinue\n118|\t\t}\n119|\t\tswitch entry.State {\n120|\t\tcase EntryRetiring:\n121|\t\t\treturn CredentialEntry{}, trustError(TrustError{Operation: \"rotate predecessor\", Err: ErrRotationRefused})\n122|\t\tcase EntryActive:\n123|\t\t\tactive = append(active, entry)\n124|\t\t}\n125|\t}\n126|\tif len(active) != 1 {\n127|\t\treturn CredentialEntry{}, trustError(TrustError{Operation: \"rotate predecessor\", Err: ErrRotationRefused})\n128|\t}\n129|\treturn active[0], nil\n130|}\n131|\n132|// MarkRetiring records a peer's announced rotation locally: the operator\n133|// caught up out of band, enrolled the peer's new tuple, and now bounds the\n134|// old credential with a fixed retire_at. The bound is no more than 24 hours\n135|// after this transition, later than enrollment, and no later than old leaf\n136|// expiry; there is no overlap extension, and only an active entry may retire.\n137|func (store *Store) MarkRetiring(credentialID string, retireAt, now time.Time) error {\n138|\tdigest, err := scalar.ParseDigest(credentialID)\n139|\tif err != nil {\n140|\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: errors.Join(ErrRotationRefused, err)})\n141|\t}\n142|\tstamp, err := scalar.ParseTimestamp(retireAt.UTC().Format(\"2006-01-02T15:04:05.000Z\"))\n143|\tif err != nil {\n144|\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: errors.Join(ErrRotationRefused, err)})\n145|\t}\n146|\treturn store.transact(func(trust *TrustStore) error {\n147|\t\tfor index := range trust.Entries {\n148|\t\t\tif trust.Entries[index].CredentialID.String() != digest.String() {\n149|\t\t\t\tcontinue\n150|\t\t\t}\n151|\t\t\tentry := &trust.Entries[index]\n152|\t\t\tif entry.State != EntryActive {\n153|\t\t\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: ErrRotationRefused})\n154|\t\t\t}\n155|\t\t\tenrolledAt, err := entry.EnrolledAt.Time()\n156|\t\t\tif err != nil {\n157|\t\t\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: errors.Join(ErrRotationRefused, err)})\n158|\t\t\t}\n159|\t\t\tfixed, err := stamp.Time()\n160|\t\t\tif err != nil {\n161|\t\t\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: errors.Join(ErrRotationRefused, err)})\n162|\t\t\t}\n163|\t\t\tif !fixed.After(now) || !fixed.After(enrolledAt) || fixed.After(now.Add(RotationBound)) {\n164|\t\t\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: ErrRotationRefused})\n165|\t\t\t}\n166|\t\t\t// The bound stops no later than old leaf expiry, like the local\n167|\t\t\t// rotation transition: admission already ends at expiry, so a\n168|\t\t\t// later retire_at would promise an overlap that cannot admit.\n169|\t\t\toldLeaf, err := x509.ParseCertificate(entry.LeafDER)\n170|\t\t\tif err != nil {\n171|\t\t\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: errors.Join(ErrRotationRefused, err)})\n172|\t\t\t}\n173|\t\t\tif fixed.After(oldLeaf.NotAfter) {\n174|\t\t\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: ErrRotationRefused})\n175|\t\t\t}\n176|\t\t\tentry.State = EntryRetiring\n177|\t\t\tentry.RetireAt = &stamp\n178|\t\t\treturn nil\n179|\t\t}\n180|\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: ErrRotationRefused})\n181|\t})\n182|}\n183|\n184|// Revoke is an explicit local atomic transition to revoked. It increments\n185|// the generation, forbids all future admissions of that key, and retains the\n186|// public bytes permanently as a reuse tombstone. Revoking an already revoked\n187|// entry refuses: a failed commit reports failure, never absence or success.\n188|// Revocation is local: the operator must distribute it explicitly to every\n189|// peer, and loss or compromise requires revocation plus new out-of-band\n190|// enrollment, never same-key recovery.\n191|func (store *Store) Revoke(credentialID string) error {\n192|\tdigest, err := scalar.ParseDigest(credentialID)\n193|\tif err != nil {\n194|\t\treturn trustError(TrustError{Operation: \"revoke credential\", Err: errors.Join(ErrRevocationRefused, err)})\n195|\t}\n196|\treturn store.transact(func(trust *TrustStore) error {\n197|\t\tfor index := range trust.Entries {\n198|\t\t\tif trust.Entries[index].CredentialID.String() != digest.String() {\n199|\t\t\t\tcontinue\n200|\t\t\t}\n201|\t\t\tif trust.Entries[index].State == EntryRevoked {\n202|\t\t\t\treturn trustError(TrustError{Operation: \"revoke credential\", Err: ErrRevocationRefused})\n203|\t\t\t}\n204|\t\t\ttrust.Entries[index].State = EntryRevoked\n205|\t\t\ttrust.Entries[index].RetireAt = nil\n206|\t\t\treturn nil\n207|\t\t}\n208|\t\treturn trustError(TrustError{Operation: \"revoke credential\", Err: ErrRevocationRefused})\n209|\t})\n210|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
