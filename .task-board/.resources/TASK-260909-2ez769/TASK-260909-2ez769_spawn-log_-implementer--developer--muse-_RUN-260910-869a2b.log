{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8eb","stream":{"kind":"session","id":"01a08946-5fbe-7830-b2e8-af2616179f48"},"sequence":720,"recorded_at":1780531400001435,"record_type":"event","durability":"durable","causation_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","run_stream":{"kind":"run","id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f"},"call_id":"call_01a0894933d47802bd36bcf72ba2cce5","text":"Read text file `internal/hosttrust/fixtures_test.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"testing\"\n5|\t\"time\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|)\n9|\n10|var (\n11|\ttestNow   = time.Date(2026, time.September, 10, 12, 0, 0, 0, time.UTC)\n12|\ttestHostA = \"0198f4c8-7d40-7e55-8e6f-1234567890aa\"\n13|\ttestHostB = \"0198f4c8-7d40-7e55-8e6f-1234567890ab\"\n14|\ttestHostC = \"0198f4c8-7d40-7e55-8e6f-1234567890ac\"\n15|)\n16|\n17|func testTimestamp(value time.Time) scalar.Timestamp {\n18|\tstamp, err := scalar.ParseTimestamp(value.UTC().Format(\"2006-01-02T15:04:05.000Z\"))\n19|\tif err != nil {\n20|\t\tpanic(err)\n21|\t}\n22|\treturn stamp\n23|}\n24|\n25|func issueForTest(t *testing.T, hostID string, now time.Time) IssuedCredential {\n26|\tt.Helper()\n27|\tissued, err := IssueCredential(hostID, now, nil)\n28|\tif err != nil {\n29|\t\tt.Fatalf(\"IssueCredential(%s) error = %v\", hostID, err)\n30|\t}\n31|\treturn issued\n32|}\n33|\n34|func entryForTest(t *testing.T, issued IssuedCredential, state string, enrolledAt time.Time, retireAt *time.Time) CredentialEntry {\n35|\tt.Helper()\n36|\tvar retireStamp *scalar.Timestamp\n37|\tif retireAt != nil {\n38|\t\tstamp := testTimestamp(*retireAt)\n39|\t\tretireStamp = &stamp\n40|\t}\n41|\treturn CredentialEntry{\n42|\t\tHostID:       issued.HostID,\n43|\t\tCredentialID: scalar.SHA256Digest(issued.LeafDER),\n44|\t\tSPKIID:       scalar.SHA256Digest(mustSPKI(issued.LeafDER)),\n45|\t\tRootID:       scalar.SHA256Digest(issued.RootDER),\n46|\t\tLeafDER:      append([]byte(nil), issued.LeafDER...),\n47|\t\tRootDER:      append([]byte(nil), issued.RootDER...),\n48|\t\tState:        state,\n49|\t\tEnrolledAt:   testTimestamp(enrolledAt),\n50|\t\tRetireAt:     retireStamp,\n51|\t}\n52|}\n53|\n54|func encodeForTest(t *testing.T, store TrustStore) []byte {\n55|\tt.Helper()\n56|\tdocument, err := EncodeTrust(store)\n57|\tif err != nil {\n58|\t\tt.Fatalf(\"EncodeTrust error = %v\", err)\n59|\t}\n60|\treturn document\n61|}\n62|\n63|func TestDecodeTrustRoundTrip(t *testing.T) {\n64|\tissuedA := issueForTest(t, testHostA, testNow)\n65|\tissuedB := issueForTest(t, testHostB, testNow)\n66|\tretire := testNow.Add(time.Hour)\n67|\tstore := TrustStore{Generation: 3, Entries: []CredentialEntry{\n68|\t\tentryForTest(t, issuedB, EntryActive, testNow, nil),\n69|\t\tentryForTest(t, issuedA, EntryRetiring, testNow.Add(-time.Hour), &retire),\n70|\t}}\n71|\tdocument := encodeForTest(t, store)\n72|\tdecoded, err := DecodeTrust(document)\n73|\tif err != nil {\n74|\t\tt.Fatalf(\"DecodeTrust error = %v\", err)\n75|\t}\n76|\tif decoded.Generation != 3 || len(decoded.Entries) != 2 {\n77|\t\tt.Fatalf(\"DecodeTrust = gen %d entries %d, want 3/2\", decoded.Generation, len(decoded.Entries))\n78|\t}\n79|\tif decoded.Entries[0].CredentialID.String() > decoded.Entries[1].CredentialID.String() {\n80|\t\tt.Fatal(\"DecodeTrust entries are not sorted by credential_id\")\n81|\t}\n82|\tagain, err := EncodeTrust(decoded)\n83|\tif err != nil {\n84|\t\tt.Fatalf(\"EncodeTrust(decoded) error = %v\", err)\n85|\t}\n86|\tredocoded, err := DecodeTrust(again)\n87|\tif err != nil {\n88|\t\tt.Fatalf(\"DecodeTrust(re-encoded) error = %v\", err)\n89|\t}\n90|\tif redocoded.Generation != decoded.Generation || len(redocoded.Entries) != len(decoded.Entries) {\n91|\t\tt.Fatal(\"trust document is not stable across encode/decode\")\n92|\t}\n93|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
