{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c765","stream":{"kind":"session","id":"01a08946-5fbe-7830-b2e8-af2616179f48"},"sequence":525,"recorded_at":1780531400001045,"record_type":"event","durability":"durable","causation_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","run_stream":{"kind":"run","id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f"},"call_id":"call_01a089472f6a7fe381293e872495d488","text":"Read text file `internal/hosttrust/custody_unix.go`.\n1|//go:build !windows\n2|\n3|package hosttrust\n4|\n5|import (\n6|\t\"errors\"\n7|\t\"io/fs\"\n8|\t\"os\"\n9|\t\"syscall\"\n10|)\n11|\n12|// verifyOwner enforces owner-only custody on Unix: the path must belong to\n13|// the effective UID. Mode bits are checked by the caller against the exact\n14|// 0700/0600 requirement, so any group/world access already refused there.\n15|func verifyOwner(_ string, info fs.FileInfo) error {\n16|\tstat, ok := info.Sys().(*syscall.Stat_t)\n17|\tif !ok {\n18|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: errors.Join(ErrTrustUnsafeCustody, errors.New(\"ownership metadata unavailable\"))})\n19|\t}\n20|\tif stat.Uid != uint32(os.Geteuid()) {\n21|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: ErrTrustUnsafeCustody})\n22|\t}\n23|\treturn nil\n24|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
