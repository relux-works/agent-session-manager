{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d431","stream":{"kind":"session","id":"01a08946-5fbe-7830-b2e8-af2616179f48"},"sequence":2163,"recorded_at":1780531400004321,"record_type":"event","durability":"durable","causation_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","run_stream":{"kind":"run","id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f"},"call_id":"call_01a0894f9ee57f90a64615ef219e8f34","text":"edited\nchanged lines: lines 286-315\n--- original\n+++ updated\n@@\n-// revalidateRollbackV4 repeats the rollback pins inside the joint\n-// transaction: the current document still differs from the backup, the\n-// backup still decodes below v4, and the trust generation has not moved. A\n-// converged target (current equals backup) is the no-op success, not a\n-// commit: it returns errRollbackConverged before any marker is staged.\n-func revalidateRollbackV4(inputs Inputs, overrides Overrides, filename, backup string, backupBytes []byte, backupVersion string, current hosttrust.TrustStore) error {\n-\tsnapshot, err := Load(inputs, overrides)\n-\tif err != nil {\n-\t\treturn err\n-\t}\n-\tloaded, decoded := snapshot.Configuration()\n-\tif !snapshot.ConfigPresent() || !decoded {\n-\t\treturn migrationError(MigrationError{Operation: \"load source\", Err: ErrMigrationSourceAbsent})\n-\t}\n-\tif bytes.Equal(snapshot.Document(), backupBytes) {\n-\t\treturn errRollbackConverged\n-\t}\n-\tcontext := DecodeContext{RuntimePlatform: inputs.Platform, BackendSettings: inputs.BackendSettings}\n-\tbackupLoaded, err := Decode(backupBytes, context)\n-\tif err != nil {\n-\t\treturn migrationError(MigrationError{Operation: \"validate backup\", Err: errors.Join(ErrRollbackV4Backup, err)})\n-\t}\n-\tif backupLoaded.SourceVersion == Version4 || backupLoaded.SourceVersion != backupVersion {\n-\t\treturn migrationError(MigrationError{Operation: \"validate backup\", Err: ErrRollbackV4Backup})\n-\t}\n-\t_ = filename\n-\t_ = backup\n-\t_ = loaded\n-\treturn nil\n-}\n+// revalidateRollbackV4 repeats the rollback pins inside the joint\n+// transaction: the current document is still the pinned source, still\n+// differs from the backup, the backup still decodes below v4, and the trust\n+// generation has not moved. A converged target (current equals backup) is\n+// the no-op success, not a commit: it returns errRollbackConverged before\n+// any marker is staged.\n+func revalidateRollbackV4(inputs Inputs, overrides Overrides, sourceDocument, backupBytes []byte, backupVersion string, expectedGeneration uint64, current hosttrust.TrustStore) error {\n+\tsnapshot, err := Load(inputs, overrides)\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tloaded, decoded := snapshot.Configuration()\n+\tif !snapshot.ConfigPresent() || !decoded {\n+\t\treturn migrationError(MigrationError{Operation: \"load source\", Err: ErrMigrationSourceAbsent})\n+\t}\n+\t_ = loaded\n+\tif bytes.Equal(snapshot.Document(), backupBytes) {\n+\t\treturn errRollbackConverged\n+\t}\n+\tif !bytes.Equal(snapshot.Document(), sourceDocument) {\n+\t\treturn migrationError(MigrationError{Operation: \"validate rollback source\", Err: ErrRollbackV4StaleSource})\n+\t}\n+\tif current.Generation != expectedGeneration {\n+\t\treturn migrationError(MigrationError{Operation: \"validate rollback generation\", Err: ErrRollbackV4StaleGeneration})\n+\t}\n+\tcontext := DecodeContext{RuntimePlatform: inputs.Platform, BackendSettings: inputs.BackendSettings}\n+\tbackupLoaded, err := Decode(backupBytes, context)\n+\tif err != nil {\n+\t\treturn migrationError(MigrationError{Operation: \"validate backup\", Err: errors.Join(ErrRollbackV4Backup, err)})\n+\t}\n+\tif backupLoaded.SourceVersion == Version4 || backupLoaded.SourceVersion != backupVersion {\n+\t\treturn migrationError(MigrationError{Operation: \"validate backup\", Err: ErrRollbackV4Backup})\n+\t}\n+\treturn nil\n+}\n","edit_facts":{"tool_name":"edit_file","path":"internal/config/migration_v4_apply.go","added":35,"removed":30},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d433","stream":{"kind":"session","id":"01a08946-5fbe-7830-b2e8-af2616179f48"},"sequence":2164,"recorded_at":1780531400004323,"record_type":"event","durability":"durable","causation_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","run_stream":{"kind":"run","id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f"},"call_id":"call_01a0894fa75575529cfaa0d3d03711dc","text":"edited\nchanged lines: lines 40-43\n--- original\n+++ updated\n@@\n-\t// ErrRollbackV4Backup reports a missing, unreadable or undecodable\n-\t// rollback backup. Rollback replaces configuration only from the\n-\t// preserved backup bytes.\n-\tErrRollbackV4Backup = errors.New(\"configuration rollback backup is missing or invalid\")\n+\t// ErrRollbackV4Backup reports a missing, unreadable or undecodable\n+\t// rollback backup. Rollback replaces configuration only from the\n+\t// preserved backup bytes.\n+\tErrRollbackV4Backup = errors.New(\"configuration rollback backup is missing or invalid\")\n+\t// ErrRollbackV4StaleSource reports a rollback attempted after the\n+\t// selected configuration changed. The operator must start over from\n+\t// the current state.\n+\tErrRollbackV4StaleSource = errors.New(\"configuration rollback source changed\")\n+\t// ErrRollbackV4StaleGeneration reports a rollback attempted after the\n+\t// trust generation moved. The operator must start over from the\n+\t// current state.\n+\tErrRollbackV4StaleGeneration = errors.New(\"configuration rollback trust generation changed\")\n","edit_facts":{"tool_name":"edit_file","path":"internal/config/migration_v4.go","added":12,"removed":4},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
