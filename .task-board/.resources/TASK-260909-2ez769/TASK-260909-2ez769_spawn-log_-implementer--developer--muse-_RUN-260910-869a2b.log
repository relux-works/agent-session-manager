{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c56f","stream":{"kind":"session","id":"01a08946-5fbe-7830-b2e8-af2616179f48"},"sequence":274,"recorded_at":1780531400000543,"record_type":"event","durability":"durable","causation_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","run_stream":{"kind":"run","id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f"},"task_stream":{"kind":"task","id":"01a08946-d7ac-7051-a1e0-11668e769514"},"task_id":"01a08946-d7ac-7051-a1e0-11668e769514","event":{"kind":"output","task_id":"01a08946-d7ac-7051-a1e0-11668e769514","chunk":"Read text file `internal/hosttrust/transact.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|)\n8|\n9|// Snapshot is one coherent committed read: trust bytes plus the generation\n10|// that authorized them. Streams and dispatches bind this generation; any use\n11|// must re-check currency before crossing a side-effect boundary.\n12|type Snapshot struct {\n13|\tGeneration uint64\n14|\tTrust      TrustStore\n15|}\n16|\n17|// TransactionFunc mutates a copy of the committed trust. Returning nil\n18|// commits with generation+1; returning an error aborts with no durable effect.\n19|type TransactionFunc func(trust *TrustStore) error\n20|\n21|// ReadSnapshot obtains one coherent committed snapshot under a shared lock.\n22|// A missing store is ErrTrustStoreMissing, never an empty store. Unreadable,\n23|// malformed or partially read state refuses; leftover staging files from\n24|// crashed commits are ignored and never selected.\n25|func (store *Store) ReadSnapshot() (Snapshot, error) {\n26|\treturn readSnapshot(store.fs, store.root, store.lock)\n27|}\n28|\n29|func readSnapshot(filesystem FileSystem, root string, lock *fileLock) (Snapshot, error) {\n30|\tunlock, err := lock.shared()\n31|\tif err != nil {\n32|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"lock snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n33|\t}\n34|\tdefer unlock()\n35|\tpath := filepath.Join(root, trustFileName)\n36|\tinfo, err := filesystem.Lstat(path)\n37|\tif err != nil {\n38|\t\tif os.IsNotExist(err) {\n39|\t\t\treturn Snapshot{}, trustError(TrustError{Operation: \"read snapshot\", Err: ErrTrustStoreMissing})\n40|\t\t}\n41|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"read snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n42|\t}\n43|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n44|\t\treturn Snapshot{}, err\n45|\t}\n46|\tdocument, err := filesystem.ReadFile(path)\n47|\tif err != nil {\n48|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"read snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n49|\t}\n50|\tstore, err := DecodeTrust(document)\n51|\tif err != nil {\n52|\t\treturn Snapshot{}, err\n53|\t}\n54|\treturn Snapshot{Generation: store.Generation, Trust: store}, nil\n55|}\n56|\n57|// Initialize creates the explicit empty generation-1 store. It refuses when\n58|// trust.json already exists: setup never overwrites committed authority.\n59|func (store *Store) Initialize() (Snapshot, error) {\n60|\tunlock, err := store.lock.exclusive()\n61|\tif err != nil {\n62|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"lock initialize\", Err: errors.Join(ErrTrustDurability, err)})\n63|\t}\n64|\tdefer unlock()\n65|\tpath := filepath.Join(store.root, trustFileName)\n66|\tif _, err := store.fs.Lstat(path); err == nil {\n67|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"initialize store\", Err: ErrTrustDurability})\n68|\t} else if !os.IsNotExist(err) {\n69|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"initialize store\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n70|\t}\n71|\tdocument, err := EncodeTrust(TrustStore{Generation: 1})\n72|\tif err != nil {\n73|\t\treturn Snapshot{}, err\n74|\t}\n75|\tif err := commitDocument(store.fs, store.root, path, document); err != nil {\n76|\t\treturn Snapshot{}, err\n77|\t}\n78|\treturn store.ReadSnapshot()\n79|}\n80|\n81|// CommitConfigChange shares the machine-local cross-process authorization\n82|// lock and crash-durable generation transaction with Configuration 4.0.0\n83|// peer/credential changes. It holds the exclusive lock while fn performs the\n84|// durable config replacement, then commits a generation bump for the config\n85|// authorization change. A fn failure aborts with no generation change; the\n86|// caller owns config-side recovery when the later trust commit fails.\n87|func (store *Store) CommitConfigChange(fn func() error) (uint64, error) {\n88|\tvar generation uint64\n89|\terr := store.transact(func(trust *TrustStore) error {\n90|\t\tif err := fn(); err != nil {\n91|\t\t\treturn err\n92|\t\t}\n93|\t\tgeneration = trust.Generation + 1\n94|\t\treturn nil\n95|\t})\n96|\tif err != nil {\n97|\t\treturn 0, err\n98|\t}\n99|\treturn generation, nil\n100|}\n101|\n102|// transact runs one crash-durable generation transaction under the exclusive\n103|// cross-process lock: load committed state, apply fn, encode, stage with\n104|// fsync, atomic rename, directory fsync. A missing store refuses with\n105|// ErrTrustStoreMissing: only explicit Initialize commits generation 1. Any\n106|// other malformed state refuses before fn runs.\n107|func (store *Store) transact(fn TransactionFunc) error {\n108|\treturn transact(store.fs, store.root, store.lock, fn)\n109|}\n110|\n111|func transact(filesystem FileSystem, root string, lock *fileLock, fn TransactionFunc) error {\n112|\tunlock, err := lock.exclusive()\n113|\tif err != nil {\n114|\t\treturn trustError(TrustError{Operation: \"lock transaction\", Err: errors.Join(ErrTrustDurability, err)})\n115|\t}\n116|\tdefer unlock()\n117|\tpath := filepath.Join(root, trustFileName)\n118|\tvar committed TrustStore\n119|\tinfo, err := filesystem.Lstat(path)\n120|\tif err != nil {\n121|\t\tif os.IsNotExist(err) {\n122|\t\t\treturn trustError(TrustError{Operation: \"read committed trust\", Err: ErrTrustStoreMissing})\n123|\t\t}\n124|\t\treturn trustError(TrustError{Operation: \"read committed trust\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n125|\t}\n126|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n127|\t\treturn err\n128|\t}\n129|\tdocument, err := filesystem.ReadFile(path)\n130|\tif err != nil {\n131|\t\treturn trustError(TrustError{Operation: \"read committed trust\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n132|\t}\n133|\tvar decoded TrustStore\n134|\tdecoded, err = DecodeTrust(document)\n135|\tif err != nil {\n136|\t\treturn err\n137|\t}\n138|\tcommitted = decoded\n139|\tnext := committed\n140|\tnext.Entries = append([]CredentialEntry(nil), committed.Entries...)\n141|\tif err := fn(&next); err != nil {\n142|\t\treturn err\n143|\t}\n144|\tif next.Generation != committed.Generation {\n145|\t\treturn trustError(TrustError{Operation: \"commit generation\", Err: ErrTrustDurability})\n146|\t}\n147|\tif committed.Generation >= MaxGeneration {\n148|\t\treturn trustError(TrustError{Operation: \"commit generation\", Err: ErrGenerationExhausted})\n149|\t}\n150|\tnext.Generation = committed.Generation + 1\n151|\tencoded, err := EncodeTrust(next)\n152|\tif err != nil {\n153|\t\treturn err\n154|\t}\n155|\tdocument = encoded\n156|\tif err := commitDocument(filesystem, root, path, document); err != nil {\n157|\t\treturn err\n158|\t}\n159|\treturn nil\n160|}\n161|\n162|// commitDocument stages bytes in a temp file with fsync, atomically renames\n163|// over the target, and fsyncs the directory. On restart only the last fully\n164|// committed file is selected; staged files are ignored by every reader.\n165|func commitDocument(filesystem FileSystem, root, path string, document []byte) error {\n166|\tstaged, err := filesystem.CreateTemp(root, stagePrefix+\"*\", 0o600)\n167|\tif err != nil {\n168|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n169|\t}\n170|\tname := staged.Name()\n171|\tfailed := true\n172|\tdefer func() {\n173|\t\tif failed {\n174|\t\t\t_ = filesystem.Remove(name)\n175|\t\t}\n176|\t}()\n177|\tif err := writeAll(staged, document); err != nil {\n178|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n179|\t}\n180|\tif err := staged.Sync(); err != nil {\n181|\t\t_ = staged.Close()\n182|\t\treturn trustError(TrustError{Operation: \"sync trust\", Err: errors.Join(ErrTrustDurability, err)})\n183|\t}\n184|\tif err := staged.Close(); err != nil {\n185|\t\treturn trustError(TrustError{Operation: \"sync trust\", Err: errors.Join(ErrTrustDurability, err)})\n186|\t}\n187|\tif err := filesystem.Chmod(name, 0o600); err != nil {\n188|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n189|\t}\n190|\tif err := filesystem.Rename(name, path); err != nil {\n191|\t\treturn trustError(TrustError{Operation: \"replace trust\", Err: errors.Join(ErrTrustDurability, err)})\n192|\t}\n193|\tif err := syncDir(filesystem, root); err != nil {\n194|\t\treturn trustError(TrustError{Operation: \"sync trust directory\", Err: errors.Join(ErrTrustDurability, err)})\n195|\t}\n196|\tfailed = false\n197|\treturn nil\n198|}\n199|\n200|func writeAll(writer interface{ Write([]byte) (int, error) }, document []byte) error {\n201|\tfor len(document) > 0 {\n202|\t\twritten, err := writer.Write(document)\n203|\t\tif err != nil {\n204|\t\t\treturn err\n205|\t\t}\n206|\t\tif written == 0 {\n207|\t\t\treturn errors.New(\"short trust write\")\n208|\t\t}\n209|\t\tdocument = document[written:]\n210|\t}\n211|\treturn nil\n212|}\n213|\n214|func syncDir(filesystem FileSystem, root string) error {\n215|\thandle, err := filesystem.OpenDirectory(root)\n216|\tif err != nil {\n217|\t\treturn err\n218|\t}\n219|\tif err := handle.Sync(); err != nil {\n220|\t\t_ = handle.Close()\n221|\t\treturn err\n222|\t}\n223|\treturn handle.Close()\n224|}","final_result":true}}}
