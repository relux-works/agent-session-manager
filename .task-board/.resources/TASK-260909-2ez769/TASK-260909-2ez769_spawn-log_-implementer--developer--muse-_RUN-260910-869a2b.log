:= ApplyV4(fixture.inputs, nil, preview, false, fixture.now); err == nil {\\n99-\\t\\tt.Fatal(\\\"ApplyV4(unconfirmed) succeeded, want refusal\\\")\\n100-\\t} else if !errors.Is(err, ErrMigrationV4ConfirmRequired) {\\n101-\\t\\tt.Fatalf(\\\"ApplyV4(unconfirmed) error = %v\\\", err)\\n102-\\t}\\n103-\\tafter, err := os.ReadFile(fixture.filename)\\n104-\\tif err != nil {\\n105-\\t\\tt.Fatal(err)\\n106-\\t}\\n107-\\tif !bytes.Equal(after, source) {\\n108-\\t\\tt.Fatal(\\\"unconfirmed apply mutated the configuration\\\")\\n109-\\t}\\n110-}\\n111-\\n112-func TestApplyV4ConfirmRequiredWithDrops(t *testing.T) {\\n113-\\t// Confirmation is unconditional: even a preview that drops every peer\\n114-\\t// refuses without it.\\n115:\\tfixture := setupV4Fixture(t, testPeerID)\\n116-\\tpreview, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, []string{testPeerID}, fixture.now)\\n117-\\tif err != nil {\\n118-\\t\\tt.Fatalf(\\\"PreviewV4(drop) error = %v\\\", err)\\n119-\\t}\\n120-\\tif len(preview.DroppedPeers) != 1 {\\n121-\\t\\tt.Fatalf(\\\"dropped = %v, want one peer\\\", preview.DroppedPeers)\\n122-\\t}\\n123-\\tif _, err := ApplyV4(fixture.inputs, nil, preview, false, fixture.now); err == nil {\\n124-\\t\\tt.Fatal(\\\"ApplyV4(unconfirmed with drops) succeeded, want refusal\\\")\\n\",\n  \"original_output_bytes\": 7310,\n  \"original_output_tokens\": 1828,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
