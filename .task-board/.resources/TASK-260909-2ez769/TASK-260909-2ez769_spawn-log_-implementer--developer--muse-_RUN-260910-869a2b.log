{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c79f","stream":{"kind":"session","id":"01a08946-5fbe-7830-b2e8-af2616179f48"},"sequence":554,"recorded_at":1780531400001103,"record_type":"event","durability":"durable","causation_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","run_stream":{"kind":"run","id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f"},"task_stream":{"kind":"task","id":"01a08947-3fe5-7980-bebf-366b54e50fae"},"task_id":"01a08947-3fe5-7980-bebf-366b54e50fae","event":{"kind":"output","task_id":"01a08947-3fe5-7980-bebf-366b54e50fae","chunk":"Read text file `internal/config/migration_v4_helpers.go`.\n1|package config\n2|\n3|import (\n4|\t\"crypto/x509\"\n5|\t\"errors\"\n6|\t\"path/filepath\"\n7|\t\"strings\"\n8|\t\"time\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/hosttrust\"\n11|)\n12|\n13|func stateDirOf(snapshot Snapshot) string {\n14|\tpath, ok := snapshot.Paths().Path(StateRoot)\n15|\tif !ok {\n16|\t\treturn \"\"\n17|\t}\n18|\treturn path.Value.String()\n19|}\n20|\n21|func previewCredentialHex(credentialID string) string {\n22|\treturn strings.TrimPrefix(credentialID, \"sha256:\")\n23|}\n24|\n25|func findTrustEntry(trust hosttrust.Snapshot, credentialID string) (hosttrust.CredentialEntry, bool) {\n26|\tfor _, entry := range trust.Trust.Entries {\n27|\t\tif entry.CredentialID.String() == credentialID {\n28|\t\t\treturn entry, true\n29|\t\t}\n30|\t}\n31|\treturn hosttrust.CredentialEntry{}, false\n32|}\n33|\n34|// checkCredentialWindow enforces current validity of both certificates\n35|// against the actual local UTC time, inclusively within notBefore/notAfter\n36|// with no extra acceptance skew or expiry grace.\n37|func checkCredentialWindow(leafDER, rootDER []byte, now time.Time) error {\n38|\tleaf, err := x509.ParseCertificate(leafDER)\n39|\tif err != nil {\n40|\t\treturn err\n41|\t}\n42|\troot, err := x509.ParseCertificate(rootDER)\n43|\tif err != nil {\n44|\t\treturn err\n45|\t}\n46|\tinstant := now.UTC()\n47|\tfor _, certificate := range []*x509.Certificate{leaf, root} {\n48|\t\tif instant.Before(certificate.NotBefore) || instant.After(certificate.NotAfter) {\n49|\t\t\treturn errors.New(\"credential outside validity window\")\n50|\t\t}\n51|\t}\n52|\treturn nil\n53|}\n54|\n55|func peerEnrolled(trust hosttrust.Snapshot, hostID string, now time.Time) bool {\n56|\tfor _, entry := range trust.Trust.Entries {\n57|\t\tif entry.HostID.String() != hostID || entry.State != hosttrust.EntryActive {\n58|\t\t\tcontinue\n59|\t\t}\n60|\t\tif checkCredentialWindow(entry.LeafDER, entry.RootDER, now) == nil {\n61|\t\t\treturn true\n62|\t\t}\n63|\t}\n64|\treturn false\n65|}\n66|\n67|// writeTempReplace durably restores document over filename after a trust\n68|// commit failure. It is recovery, not a migration: no backup is published.\n69|func writeTempReplace(filesystem migrationFileSystem, filename string, document []byte) (string, error) {\n70|\tdirectory := filepath.Dir(filename)\n71|\tstaged, err := writeTempFile(filesystem, directory, \".ax-config-restore-*\", document, 0o600)\n72|\tif err != nil {\n73|\t\treturn \"\", err\n74|\t}\n75|\tif err := filesystem.Rename(staged, filename); err != nil {\n76|\t\t_ = filesystem.Remove(staged)\n77|\t\treturn \"\", err\n78|\t}\n79|\tif err := syncDirectory(filesystem, directory); err != nil {\n80|\t\treturn \"\", err\n81|\t}\n82|\treturn staged, nil\n83|}","final_result":true}}}
