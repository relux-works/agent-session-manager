{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c577","stream":{"kind":"session","id":"01a08946-5fbe-7830-b2e8-af2616179f48"},"sequence":278,"recorded_at":1780531400000551,"record_type":"event","durability":"durable","causation_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","run_stream":{"kind":"run","id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f"},"call_id":"call_01a08946d34b717297e6650c25f982a4","text":"Read text file `internal/hosttrust/authorize.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"errors\"\n6|\t\"fmt\"\n7|\t\"time\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// AuthRequest carries one dispatch or mutation-boundary authorization check.\n13|// SnapshotGeneration binds the stream to the coherent snapshot it was opened\n14|// under; LocalCredentialID and the remote DER bytes select the exact enrolled\n15|// entries; Allowlisted is the local mesh allowlist; HelloHostID is the\n16|// authenticated hello identity; ExpectedRemoteHostID is the selected\n17|// configured destination on the client.\n18|type AuthRequest struct {\n19|\tSnapshotGeneration   uint64\n20|\tLocalHostID          string\n21|\tLocalCredentialID    string\n22|\tRemoteLeafDER        []byte\n23|\tRemoteRootDER        []byte\n24|\tExpectedRemoteHostID string\n25|\tAllowlisted          []string\n26|\tHelloHostID          string\n27|\tNow                  time.Time\n28|}\n29|\n30|// Formatting an authorization request must never expose DER bytes, UUIDs,\n31|// digests or allowlists.\n32|func (AuthRequest) String() string   { return \"host channel authorization request\" }\n33|func (AuthRequest) GoString() string { return \"host channel authorization request\" }\n34|func (AuthRequest) Format(state fmt.State, verb rune) {\n35|\t_, _ = state.Write([]byte(\"host channel authorization request\"))\n36|}\n37|\n38|// Formatting a snapshot must never expose the entries it binds.\n39|func (Snapshot) String() string   { return \"host trust snapshot\" }\n40|func (Snapshot) GoString() string { return \"host trust snapshot\" }\n41|func (Snapshot) Format(state fmt.State, verb rune) {\n42|\t_, _ = state.Write([]byte(\"host trust snapshot\"))\n43|}\n44|\n45|// AuthorizeDispatch checks current generation, local credential validity,\n46|// allowlist membership and authenticated hello against one committed read\n47|// held under the shared authorization lock. The check observes a coherent\n48|// snapshot, but the dispatch itself runs after the lock releases, so the\n49|// caller must bind the admitted generation to the stream and enforce the\n50|// one-second invalidation on commit: re-check currency before sending, and\n51|// close stale-generation streams on watchdog, never on notifications alone.\n52|// Mutation side effects additionally require WithMutationAuthorization, which\n53|// holds the exclusive lock across the recheck and the boundary. Work prepared\n54|// under an old generation cannot gain new authority by refreshing a cached\n55|// number: a stale snapshot refuses.\n56|func (store *Store) AuthorizeDispatch(snapshot Snapshot, request AuthRequest) error {\n57|\tunlock, err := store.lock.shared()\n58|\tif err != nil {\n59|\t\treturn trustError(TrustError{Operation: \"authorize dispatch\", Err: errors.Join(ErrAuthorizationRefused, err)})\n60|\t}\n61|\tdefer unlock()\n62|\tcurrent, err := readCommitted(store)\n63|\tif err != nil {\n64|\t\treturn err\n65|\t}\n66|\t// The stream binding must match the snapshot it was opened under: work\n67|\t// prepared under an old generation cannot gain new authority by\n68|\t// refreshing a cached number.\n69|\tif request.SnapshotGeneration != snapshot.Generation {\n70|\t\treturn trustError(TrustError{Operation: \"authorize generation\", Err: ErrStaleGeneration})\n71|\t}\n72|\tif snapshot.Generation != current.Generation {\n73|\t\treturn trustError(TrustError{Operation: \"authorize generation\", Err: ErrStaleGeneration})\n74|\t}\n75|\treturn checkAuthorization(snapshot.Trust, request)\n76|}\n77|\n78|func readCommitted(store *Store) (TrustStore, error) {\n79|\tpath := store.TrustPath()\n80|\tinfo, err := store.fs.Lstat(path)\n81|\tif err != nil {\n82|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"authorize generation\", Err: errors.Join(ErrAuthorizationRefused, err)})\n83|\t}\n84|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n85|\t\treturn TrustStore{}, err\n86|\t}\n87|\tdocument, err := store.fs.ReadFile(path)\n88|\tif err != nil {\n89|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"authorize generation\", Err: errors.Join(ErrAuthorizationRefused, err)})\n90|\t}\n91|\tcommitted, err := DecodeTrust(document)\n92|\tif err != nil {\n93|\t\treturn TrustStore{}, err\n94|\t}\n95|\treturn committed, nil\n96|}\n97|\n98|func checkAuthorization(trust TrustStore, request AuthRequest) error {\n99|\tconst operation = \"authorize dispatch\"\n100|\tlocal, found := findEntry(trust, request.LocalCredentialID)\n101|\tif !found {\n102|\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n103|\t}\n104|\tif local.HostID.String() != request.LocalHostID || local.State != EntryActive {\n105|\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n106|\t}\n107|\tif err := VerifyProfile(local.LeafDER, local.RootDER, local.HostID.String(), request.Now); err != nil {\n108|\t\treturn trustError(TrustError{Operation: operation, Err: errors.Join(ErrAuthorizationRefused, err)})\n109|\t}\n110|\tremote, found := matchRemote(trust, request.RemoteLeafDER, request.RemoteRootDER)\n111|\tif !found {\n112|\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n113|\t}\n114|\tif err := VerifyProfile(remote.LeafDER, remote.RootDER, remote.HostID.String(), request.Now); err != nil {\n115|\t\treturn trustError(TrustError{Operation: operation, Err: errors.Join(ErrAuthorizationRefused, err)})\n116|\t}\n117|\tif remote.State == EntryRevoked {\n118|\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n119|\t}\n120|\tif remote.State == EntryRetiring {\n121|\t\tif remote.RetireAt == nil {\n122|\t\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n123|\t\t}\n124|\t\tretireAt, err := remote.RetireAt.Time()\n125|\t\tif err != nil || !request.Now.Before(retireAt) {\n126|\t\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n127|\t\t}\n128|\t}\n129|\tallowlisted := false\n130|\tfor _, hostID := range request.Allowlisted {\n131|\t\tif hostID == remote.HostID.String() {\n132|\t\t\tallowlisted = true\n133|\t\t\tbreak\n134|\t\t}\n135|\t}\n136|\tif !allowlisted {\n137|\t\treturn trustError(TrustError{Operation: operation, Err: ErrNotAllowlisted})\n138|\t}\n139|\tif request.HelloHostID != remote.HostID.String() || remote.HostID.String() != request.ExpectedRemoteHostID {\n140|\t\treturn trustError(TrustError{Operation: operation, Err: ErrHostIdentityMismatch})\n141|\t}\n142|\treturn nil\n143|}\n144|\n145|func findEntry(trust TrustStore, credentialID string) (CredentialEntry, bool) {\n146|\tfor _, entry := range trust.Entries {\n147|\t\tif entry.CredentialID.String() == credentialID {\n148|\t\t\treturn entry, true\n149|\t\t}\n150|\t}\n151|\treturn CredentialEntry{}, false\n152|}\n153|\n154|// matchRemote yields the verified UUID only on an exact leaf/root/SPKI match\n155|// against one currently admitted entry. Zero or multiple matches refuse; SAN\n156|// alone and CA membership alone are insufficient, which the byte-exact triple\n157|// comparison enforces structurally.\n158|func matchRemote(trust TrustStore, leafDER, rootDER []byte) (CredentialEntry, bool) {\n159|\tspki := spkiOf(leafDER)\n160|\tvar matched []CredentialEntry\n161|\tfor _, entry := range trust.Entries {\n162|\t\tif !bytes.Equal(entry.LeafDER, leafDER) || !bytes.Equal(entry.RootDER, rootDER) {\n163|\t\t\tcontinue\n164|\t\t}\n165|\t\tif spki == \"\" || entry.SPKIID.String() != spki {\n166|\t\t\tcontinue\n167|\t\t}\n168|\t\tmatched = append(matched, entry)\n169|\t}\n170|\tif len(matched) != 1 {\n171|\t\treturn CredentialEntry{}, false\n172|\t}\n173|\treturn matched[0], true\n174|}\n175|\n176|func spkiOf(leafDER []byte) string {\n177|\tder := mustSPKI(leafDER)\n178|\tif len(der) == 0 {\n179|\t\treturn \"\"\n180|\t}\n181|\treturn scalar.SHA256Digest(der).String()\n182|}\n183|\n184|// WithMutationAuthorization rechecks generation, credential validity,\n185|// allowlist membership and authenticated hello under the exclusive\n186|// authorization lock immediately before the externally visible side-effect\n187|// boundary, then runs the boundary while still holding the lock. The\n188|// generation check and the boundary serialize with revocation and config\n189|// commits. Boundaries must be bounded: long provider calls must not hold the\n190|// authorization lock across unbounded work.\n191|func (store *Store) WithMutationAuthorization(request AuthRequest, boundary func() error) error {\n192|\tunlock, err := store.lock.exclusive()\n193|\tif err != nil {\n194|\t\treturn trustError(TrustError{Operation: \"authorize mutation\", Err: errors.Join(ErrAuthorizationRefused, err)})\n195|\t}\n196|\tdefer unlock()\n197|\tcurrent, err := readCommitted(store)\n198|\tif err != nil {\n199|\t\treturn err\n200|\t}\n201|\tfresh := request\n202|\tfresh.SnapshotGeneration = current.Generation\n203|\tif err := checkAuthorization(current, fresh); err != nil {\n204|\t\treturn err\n205|\t}\n206|\tif boundary == nil {\n207|\t\treturn trustError(TrustError{Operation: \"authorize mutation\", Err: ErrAuthorizationRefused})\n208|\t}\n209|\treturn boundary()\n210|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c579","stream":{"kind":"session","id":"01a08946-5fbe-7830-b2e8-af2616179f48"},"sequence":279,"recorded_at":1780531400000553,"record_type":"event","durability":"durable","causation_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","run_stream":{"kind":"run","id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f"},"call_id":"call_01a08946d41b7010b3a1e2137ebe98ca","text":"Read text file `internal/hosttrust/lock_unix.go`.\n1|//go:build darwin || linux\n2|\n3|package hosttrust\n4|\n5|import (\n6|\t\"errors\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\n10|\t\"golang.org/x/sys/unix\"\n11|)\n12|\n13|// fileLock is the machine-local cross-process authorization lock shared by\n14|// trust changes and Configuration 4.0.0 peer/credential changes. Readers hold\n15|// it shared; transactions hold it exclusive, so a revocation or config commit\n16|// can never land between a dispatch check and its side-effect boundary.\n17|type fileLock struct {\n18|\tfile *os.File\n19|}\n20|\n21|func openLock(filesystem FileSystem, path string) (*fileLock, error) {\n22|\tinfo, err := filesystem.Lstat(path)\n23|\tif err != nil {\n24|\t\tif !os.IsNotExist(err) {\n25|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n26|\t\t}\n27|\t\tstaged, err := filesystem.CreateTemp(filepath.Dir(path), \"lock-stage-*\", 0o600)\n28|\t\tif err != nil {\n29|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n30|\t\t}\n31|\t\tname := staged.Name()\n32|\t\t_ = staged.Close()\n33|\t\tif err := filesystem.Rename(name, path); err != nil {\n34|\t\t\t_ = filesystem.Remove(name)\n35|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n36|\t\t}\n37|\t\tif err := filesystem.Chmod(path, 0o600); err != nil {\n38|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n39|\t\t}\n40|\t\tinfo, err = filesystem.Lstat(path)\n41|\t\tif err != nil {\n42|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n43|\t\t}\n44|\t}\n45|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n46|\t\treturn nil, err\n47|\t}\n48|\t// O_NOFOLLOW refuses symlink escapes at open time; the descriptor never\n49|\t// follows a link swapped in after Lstat.\n50|\tfd, err := unix.Open(path, unix.O_RDWR|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)\n51|\tif err != nil {\n52|\t\tjoined := errors.Join(ErrTrustStoreUnreadable, err)\n53|\t\tif errors.Is(err, unix.ELOOP) {\n54|\t\t\tjoined = errors.Join(ErrTrustUnsafeCustody, err)\n55|\t\t}\n56|\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: joined})\n57|\t}\n58|\treturn &fileLock{file: os.NewFile(uintptr(fd), path)}, nil\n59|}\n60|\n61|func (lock *fileLock) shared() (func(), error) {\n62|\tif err := unix.Flock(int(lock.file.Fd()), unix.LOCK_SH); err != nil {\n63|\t\treturn nil, err\n64|\t}\n65|\treturn func() { _ = unix.Flock(int(lock.file.Fd()), unix.LOCK_UN) }, nil\n66|}\n67|\n68|func (lock *fileLock) exclusive() (func(), error) {\n69|\tif err := unix.Flock(int(lock.file.Fd()), unix.LOCK_EX); err != nil {\n70|\t\treturn nil, err\n71|\t}\n72|\treturn func() { _ = unix.Flock(int(lock.file.Fd()), unix.LOCK_UN) }, nil\n73|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c57b","stream":{"kind":"session","id":"01a08946-5fbe-7830-b2e8-af2616179f48"},"sequence":280,"recorded_at":1780531400000555,"record_type":"event","durability":"durable","causation_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","run_stream":{"kind":"run","id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f"},"call_id":"call_01a08946d49b73019f5e87abd626383d","text":"Read text file `internal/hosttrust/transact.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|)\n8|\n9|// Snapshot is one coherent committed read: trust bytes plus the generation\n10|// that authorized them. Streams and dispatches bind this generation; any use\n11|// must re-check currency before crossing a side-effect boundary.\n12|type Snapshot struct {\n13|\tGeneration uint64\n14|\tTrust      TrustStore\n15|}\n16|\n17|// TransactionFunc mutates a copy of the committed trust. Returning nil\n18|// commits with generation+1; returning an error aborts with no durable effect.\n19|type TransactionFunc func(trust *TrustStore) error\n20|\n21|// ReadSnapshot obtains one coherent committed snapshot under a shared lock.\n22|// A missing store is ErrTrustStoreMissing, never an empty store. Unreadable,\n23|// malformed or partially read state refuses; leftover staging files from\n24|// crashed commits are ignored and never selected.\n25|func (store *Store) ReadSnapshot() (Snapshot, error) {\n26|\treturn readSnapshot(store.fs, store.root, store.lock)\n27|}\n28|\n29|func readSnapshot(filesystem FileSystem, root string, lock *fileLock) (Snapshot, error) {\n30|\tunlock, err := lock.shared()\n31|\tif err != nil {\n32|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"lock snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n33|\t}\n34|\tdefer unlock()\n35|\tpath := filepath.Join(root, trustFileName)\n36|\tinfo, err := filesystem.Lstat(path)\n37|\tif err != nil {\n38|\t\tif os.IsNotExist(err) {\n39|\t\t\treturn Snapshot{}, trustError(TrustError{Operation: \"read snapshot\", Err: ErrTrustStoreMissing})\n40|\t\t}\n41|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"read snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n42|\t}\n43|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n44|\t\treturn Snapshot{}, err\n45|\t}\n46|\tdocument, err := filesystem.ReadFile(path)\n47|\tif err != nil {\n48|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"read snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n49|\t}\n50|\tstore, err := DecodeTrust(document)\n51|\tif err != nil {\n52|\t\treturn Snapshot{}, err\n53|\t}\n54|\treturn Snapshot{Generation: store.Generation, Trust: store}, nil\n55|}\n56|\n57|// Initialize creates the explicit empty generation-1 store. It refuses when\n58|// trust.json already exists: setup never overwrites committed authority.\n59|func (store *Store) Initialize() (Snapshot, error) {\n60|\tunlock, err := store.lock.exclusive()\n61|\tif err != nil {\n62|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"lock initialize\", Err: errors.Join(ErrTrustDurability, err)})\n63|\t}\n64|\tdefer unlock()\n65|\tpath := filepath.Join(store.root, trustFileName)\n66|\tif _, err := store.fs.Lstat(path); err == nil {\n67|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"initialize store\", Err: ErrTrustDurability})\n68|\t} else if !os.IsNotExist(err) {\n69|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"initialize store\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n70|\t}\n71|\tdocument, err := EncodeTrust(TrustStore{Generation: 1})\n72|\tif err != nil {\n73|\t\treturn Snapshot{}, err\n74|\t}\n75|\tif err := commitDocument(store.fs, store.root, path, document); err != nil {\n76|\t\treturn Snapshot{}, err\n77|\t}\n78|\treturn store.ReadSnapshot()\n79|}\n80|\n81|// CommitConfigChange shares the machine-local cross-process authorization\n82|// lock and crash-durable generation transaction with Configuration 4.0.0\n83|// peer/credential changes. It holds the exclusive lock while fn performs the\n84|// durable config replacement, then commits a generation bump for the config\n85|// authorization change. A fn failure aborts with no generation change; the\n86|// caller owns config-side recovery when the later trust commit fails.\n87|func (store *Store) CommitConfigChange(fn func() error) (uint64, error) {\n88|\tvar generation uint64\n89|\terr := store.transact(func(trust *TrustStore) error {\n90|\t\tif err := fn(); err != nil {\n91|\t\t\treturn err\n92|\t\t}\n93|\t\tgeneration = trust.Generation + 1\n94|\t\treturn nil\n95|\t})\n96|\tif err != nil {\n97|\t\treturn 0, err\n98|\t}\n99|\treturn generation, nil\n100|}\n101|\n102|// transact runs one crash-durable generation transaction under the exclusive\n103|// cross-process lock: load committed state, apply fn, encode, stage with\n104|// fsync, atomic rename, directory fsync. A missing store refuses with\n105|// ErrTrustStoreMissing: only explicit Initialize commits generation 1. Any\n106|// other malformed state refuses before fn runs.\n107|func (store *Store) transact(fn TransactionFunc) error {\n108|\treturn transact(store.fs, store.root, store.lock, fn)\n109|}\n110|\n111|func transact(filesystem FileSystem, root string, lock *fileLock, fn TransactionFunc) error {\n112|\tunlock, err := lock.exclusive()\n113|\tif err != nil {\n114|\t\treturn trustError(TrustError{Operation: \"lock transaction\", Err: errors.Join(ErrTrustDurability, err)})\n115|\t}\n116|\tdefer unlock()\n117|\tpath := filepath.Join(root, trustFileName)\n118|\tvar committed TrustStore\n119|\tinfo, err := filesystem.Lstat(path)\n120|\tif err != nil {\n121|\t\tif os.IsNotExist(err) {\n122|\t\t\treturn trustError(TrustError{Operation: \"read committed trust\", Err: ErrTrustStoreMissing})\n123|\t\t}\n124|\t\treturn trustError(TrustError{Operation: \"read committed trust\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n125|\t}\n126|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n127|\t\treturn err\n128|\t}\n129|\tdocument, err := filesystem.ReadFile(path)\n130|\tif err != nil {\n131|\t\treturn trustError(TrustError{Operation: \"read committed trust\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n132|\t}\n133|\tvar decoded TrustStore\n134|\tdecoded, err = DecodeTrust(document)\n135|\tif err != nil {\n136|\t\treturn err\n137|\t}\n138|\tcommitted = decoded\n139|\tnext := committed\n140|\tnext.Entries = append([]CredentialEntry(nil), committed.Entries...)\n141|\tif err := fn(&next); err != nil {\n142|\t\treturn err\n143|\t}\n144|\tif next.Generation != committed.Generation {\n145|\t\treturn trustError(TrustError{Operation: \"commit generation\", Err: ErrTrustDurability})\n146|\t}\n147|\tif committed.Generation >= MaxGeneration {\n148|\t\treturn trustError(TrustError{Operation: \"commit generation\", Err: ErrGenerationExhausted})\n149|\t}\n150|\tnext.Generation = committed.Generation + 1\n151|\tencoded, err := EncodeTrust(next)\n152|\tif err != nil {\n153|\t\treturn err\n154|\t}\n155|\tdocument = encoded\n156|\tif err := commitDocument(filesystem, root, path, document); err != nil {\n157|\t\treturn err\n158|\t}\n159|\treturn nil\n160|}\n161|\n162|// commitDocument stages bytes in a temp file with fsync, atomically renames\n163|// over the target, and fsyncs the directory. On restart only the last fully\n164|// committed file is selected; staged files are ignored by every reader.\n165|func commitDocument(filesystem FileSystem, root, path string, document []byte) error {\n166|\tstaged, err := filesystem.CreateTemp(root, stagePrefix+\"*\", 0o600)\n167|\tif err != nil {\n168|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n169|\t}\n170|\tname := staged.Name()\n171|\tfailed := true\n172|\tdefer func() {\n173|\t\tif failed {\n174|\t\t\t_ = filesystem.Remove(name)\n175|\t\t}\n176|\t}()\n177|\tif err := writeAll(staged, document); err != nil {\n178|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n179|\t}\n180|\tif err := staged.Sync(); err != nil {\n181|\t\t_ = staged.Close()\n182|\t\treturn trustError(TrustError{Operation: \"sync trust\", Err: errors.Join(ErrTrustDurability, err)})\n183|\t}\n184|\tif err := staged.Close(); err != nil {\n185|\t\treturn trustError(TrustError{Operation: \"sync trust\", Err: errors.Join(ErrTrustDurability, err)})\n186|\t}\n187|\tif err := filesystem.Chmod(name, 0o600); err != nil {\n188|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n189|\t}\n190|\tif err := filesystem.Rename(name, path); err != nil {\n191|\t\treturn trustError(TrustError{Operation: \"replace trust\", Err: errors.Join(ErrTrustDurability, err)})\n192|\t}\n193|\tif err := syncDir(filesystem, root); err != nil {\n194|\t\treturn trustError(TrustError{Operation: \"sync trust directory\", Err: errors.Join(ErrTrustDurability, err)})\n195|\t}\n196|\tfailed = false\n197|\treturn nil\n198|}\n199|\n200|func writeAll(writer interface{ Write([]byte) (int, error) }, document []byte) error {\n201|\tfor len(document) > 0 {\n202|\t\twritten, err := writer.Write(document)\n203|\t\tif err != nil {\n204|\t\t\treturn err\n205|\t\t}\n206|\t\tif written == 0 {\n207|\t\t\treturn errors.New(\"short trust write\")\n208|\t\t}\n209|\t\tdocument = document[written:]\n210|\t}\n211|\treturn nil\n212|}\n213|\n214|func syncDir(filesystem FileSystem, root string) error {\n215|\thandle, err := filesystem.OpenDirectory(root)\n216|\tif err != nil {\n217|\t\treturn err\n218|\t}\n219|\tif err := handle.Sync(); err != nil {\n220|\t\t_ = handle.Close()\n221|\t\treturn err\n222|\t}\n223|\treturn handle.Close()\n224|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c57d","stream":{"kind":"session","id":"01a08946-5fbe-7830-b2e8-af2616179f48"},"sequence":281,"recorded_at":1780531400000557,"record_type":"event","durability":"durable","causation_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","run_stream":{"kind":"run","id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f"},"call_id":"call_01a08946d55a7e8094e4cd0198294878","text":"Read text file `internal/config/migration_v4_apply.go`.\n1|package config\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"errors\"\n6|\t\"time\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/hosttrust\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// ApplyV4OS captures real process inputs and performs one explicit durable\n13|// Configuration 4.0.0 migration. The caller supplies the exact confirmed\n14|// preview from PreviewV4; confirm must be true.\n15|func ApplyV4OS(platform scalar.Platform, overrides Overrides, preview V4Preview, confirm bool, now time.Time) (V4ApplyResult, error) {\n16|\tinputs, err := OSInputs(platform)\n17|\tif err != nil {\n18|\t\treturn V4ApplyResult{}, err\n19|\t}\n20|\treturn applyV4(inputs, overrides, preview, confirm, now, osMigrationFileSystem{}, hosttrust.Open)\n21|}\n22|\n23|// ApplyV4 is the dependency-injected production entry point. It writes only\n24|// the selected configuration file, a deterministic source-version backup in\n25|// the same directory, and one trust generation bump under the shared\n26|// authorization lock.\n27|func ApplyV4(inputs Inputs, overrides Overrides, preview V4Preview, confirm bool, now time.Time) (V4ApplyResult, error) {\n28|\treturn applyV4(inputs, overrides, preview, confirm, now, osMigrationFileSystem{}, hosttrust.Open)\n29|}\n30|\n31|func applyV4(inputs Inputs, overrides Overrides, preview V4Preview, confirm bool, now time.Time,\n32|\tfilesystem migrationFileSystem, openStore func(string) (*hosttrust.Store, error)) (V4ApplyResult, error) {\n33|\tif !confirm {\n34|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"confirm preview\", Err: ErrMigrationV4ConfirmRequired})\n35|\t}\n36|\tif preview.SourceVersion != CurrentVersion || len(preview.SourceDocument) == 0 || len(preview.Replacement) == 0 {\n37|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate preview\", Err: ErrMigrationV4PreviewMismatch})\n38|\t}\n39|\tsnapshot, err := Load(inputs, overrides)\n40|\tif err != nil {\n41|\t\treturn V4ApplyResult{}, err\n42|\t}\n43|\tloaded, decoded := snapshot.Configuration()\n44|\tif !snapshot.ConfigPresent() || !decoded {\n45|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"load source\", Err: ErrMigrationSourceAbsent})\n46|\t}\n47|\tif loaded.SourceVersion != CurrentVersion {\n48|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"select source\", Err: ErrMigrationV4Source})\n49|\t}\n50|\tif !bytes.Equal(snapshot.Document(), preview.SourceDocument) {\n51|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate preview source\", Err: ErrMigrationV4StaleSource})\n52|\t}\n53|\tselected, _ := snapshot.Paths().Path(ConfigFile)\n54|\tfilename := selected.Value.String()\n55|\tstateDir := stateDirOf(snapshot)\n56|\tstore, err := openStore(stateDir)\n57|\tif err != nil {\n58|\t\treturn V4ApplyResult{}, err\n59|\t}\n60|\tcurrent, err := store.ReadSnapshot()\n61|\tif err != nil {\n62|\t\treturn V4ApplyResult{}, err\n63|\t}\n64|\tif current.Generation != preview.SourceGeneration {\n65|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate preview generation\", Err: ErrMigrationV4StaleGeneration})\n66|\t}\n67|\trendered, err := renderV4Preview(snapshot.Document(), loaded.Value, current, preview.CredentialID, preview.DroppedPeers, now, inputs)\n68|\tif err != nil {\n69|\t\treturn V4ApplyResult{}, err\n70|\t}\n71|\tif !bytes.Equal(rendered.Replacement, preview.Replacement) {\n72|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate preview bytes\", Err: ErrMigrationV4PreviewMismatch})\n73|\t}\n74|\t// The custody files behind the selected credential must validate before\n75|\t// use, exactly as Section 11.10.2 requires for local identity.\n76|\tcredentialHex := previewCredentialHex(preview.CredentialID)\n77|\tif err := store.ValidateCustody(credentialHex, loaded.Value.HostID, now); err != nil {\n78|\t\treturn V4ApplyResult{}, err\n79|\t}\n80|\tbackup := filename + \".bak.\" + loaded.SourceVersion\n81|\treplaced := false\n82|\tgeneration, err := store.CommitConfigChange(func() error {\n83|\t\tif err := replaceDurably(filesystem, filename, backup, snapshot.Document(), preview.Replacement); err != nil {\n84|\t\t\treturn err\n85|\t\t}\n86|\t\treplaced = true\n87|\t\treturn nil\n88|\t})\n89|\tif err != nil {\n90|\t\tif replaced {\n91|\t\t\trecovery, rollbackErr := writeTempReplace(filesystem, filename, snapshot.Document())\n92|\t\t\tif rollbackErr != nil {\n93|\t\t\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"recover source after trust commit\", Err: errors.Join(ErrMigrationSync, ErrMigrationRecovery, err, rollbackErr)})\n94|\t\t\t}\n95|\t\t\t_ = recovery\n96|\t\t}\n97|\t\treturn V4ApplyResult{}, err\n98|\t}\n99|\treturn V4ApplyResult{\n100|\t\tMigration:  MigrationResult{SourceVersion: loaded.SourceVersion, TargetVersion: Version4, BackupPath: backup, Changed: true},\n101|\t\tGeneration: generation,\n102|\t}, nil\n103|}\n104|\n105|// RollbackV4OS captures real process inputs and performs one explicit\n106|// operator rollback: stopping every host channel is the operator's act, and\n107|// this call replaces configuration from the preserved backup and bumps the\n108|// trust generation so stale-generation streams cannot survive.\n109|func RollbackV4OS(platform scalar.Platform, overrides Overrides, options RollbackV4Options) (V4ApplyResult, error) {\n110|\tinputs, err := OSInputs(platform)\n111|\tif err != nil {\n112|\t\treturn V4ApplyResult{}, err\n113|\t}\n114|\treturn rollbackV4(inputs, overrides, options, osMigrationFileSystem{}, hosttrust.Open)\n115|}\n116|\n117|// RollbackV4 is the dependency-injected production entry point.\n118|func RollbackV4(inputs Inputs, overrides Overrides, options RollbackV4Options) (V4ApplyResult, error) {\n119|\treturn rollbackV4(inputs, overrides, options, osMigrationFileSystem{}, hosttrust.Open)\n120|}\n121|\n122|func rollbackV4(inputs Inputs, overrides Overrides, options RollbackV4Options,\n123|\tfilesystem migrationFileSystem, openStore func(string) (*hosttrust.Store, error)) (V4ApplyResult, error) {\n124|\tif !options.AcknowledgeNoHostChannelAssurance {\n125|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"acknowledge rollback\", Err: ErrRollbackV4AckRequired})\n126|\t}\n127|\tsnapshot, err := Load(inputs, overrides)\n128|\tif err != nil {\n129|\t\treturn V4ApplyResult{}, err\n130|\t}\n131|\tloaded, decoded := snapshot.Configuration()\n132|\tif !snapshot.ConfigPresent() || !decoded {\n133|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"load source\", Err: ErrMigrationSourceAbsent})\n134|\t}\n135|\tselected, _ := snapshot.Paths().Path(ConfigFile)\n136|\tfilename := selected.Value.String()\n137|\tbackup := options.BackupPath\n138|\tif backup == \"\" {\n139|\t\tbackup = filename + \".bak.\" + CurrentVersion\n140|\t}\n141|\tbackupBytes, err := filesystem.ReadFile(backup)\n142|\tif err != nil {\n143|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"read backup\", Err: errors.Join(ErrRollbackV4Backup, err)})\n144|\t}\n145|\tcontext := DecodeContext{RuntimePlatform: inputs.Platform, BackendSettings: inputs.BackendSettings}\n146|\tbackupLoaded, err := Decode(backupBytes, context)\n147|\tif err != nil {\n148|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate backup\", Err: errors.Join(ErrRollbackV4Backup, err)})\n149|\t}\n150|\tif backupLoaded.SourceVersion == Version4 {\n151|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate backup\", Err: ErrRollbackV4Backup})\n152|\t}\n153|\tif bytes.Equal(snapshot.Document(), backupBytes) {\n154|\t\treturn V4ApplyResult{Migration: MigrationResult{SourceVersion: loaded.SourceVersion, TargetVersion: backupLoaded.SourceVersion, BackupPath: backup}}, nil\n155|\t}\n156|\tstore, err := openStore(stateDirOf(snapshot))\n157|\tif err != nil {\n158|\t\treturn V4ApplyResult{}, err\n159|\t}\n160|\tpreRollback := filename + \".pre-rollback.\" + loaded.SourceVersion\n161|\treplaced := false\n162|\tgeneration, err := store.CommitConfigChange(func() error {\n163|\t\tif err := replaceDurably(filesystem, filename, preRollback, snapshot.Document(), backupBytes); err != nil {\n164|\t\t\treturn err\n165|\t\t}\n166|\t\treplaced = true\n167|\t\treturn nil\n168|\t})\n169|\tif err != nil {\n170|\t\tif replaced {\n171|\t\t\t_, rollbackErr := writeTempReplace(filesystem, filename, snapshot.Document())\n172|\t\t\tif rollbackErr != nil {\n173|\t\t\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"recover source after trust commit\", Err: errors.Join(ErrMigrationSync, ErrMigrationRecovery, err, rollbackErr)})\n174|\t\t\t}\n175|\t\t}\n176|\t\treturn V4ApplyResult{}, err\n177|\t}\n178|\treturn V4ApplyResult{\n179|\t\tMigration:  MigrationResult{SourceVersion: loaded.SourceVersion, TargetVersion: backupLoaded.SourceVersion, BackupPath: preRollback, Changed: true},\n180|\t\tGeneration: generation,\n181|\t}, nil\n182|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
