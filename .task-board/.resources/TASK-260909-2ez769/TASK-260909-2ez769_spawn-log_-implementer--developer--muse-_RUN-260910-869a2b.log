{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5db","stream":{"kind":"session","id":"01a08946-5fbe-7830-b2e8-af2616179f48"},"sequence":328,"recorded_at":1780531400000651,"record_type":"event","durability":"durable","causation_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","run_stream":{"kind":"run","id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f"},"call_id":"call_01a08946de207591b3f6bc04944a9753","text":"Read text file `internal/hosttrust/custody_windows.go`.\n1|//go:build windows\n2|\n3|package hosttrust\n4|\n5|import (\n6|\t\"errors\"\n7|\t\"io/fs\"\n8|\t\"os/user\"\n9|\n10|\t\"golang.org/x/sys/windows\"\n11|)\n12|\n13|// verifyOwner enforces owner-only custody on Windows: reparse-point escapes\n14|// refuse, and the file owner SID must equal the process user SID (equivalent\n15|// owner-only ACLs). DACL group/world-write auditing beyond owner equality is\n16|// a stated bound: no Windows runner validates it here, and the DACL surface\n17|// is owned by OS policy, not by AX bytes.\n18|func verifyOwner(path string, info fs.FileInfo) error {\n19|\tif info.Mode()&fs.ModeSymlink != 0 {\n20|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: ErrTrustUnsafeCustody})\n21|\t}\n22|\tcurrent, err := user.Current()\n23|\tif err != nil {\n24|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n25|\t}\n26|\tuserSID, err := windows.StringToSid(current.Uid)\n27|\tif err != nil {\n28|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n29|\t}\n30|\tdescriptor, err := windows.GetNamedSecurityInfo(path, windows.SE_FILE_OBJECT, windows.OWNER_SECURITY_INFORMATION)\n31|\tif err != nil {\n32|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n33|\t}\n34|\towner, _, err := descriptor.Owner()\n35|\tif err != nil {\n36|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n37|\t}\n38|\tif owner == nil || !owner.Equals(userSID) {\n39|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: ErrTrustUnsafeCustody})\n40|\t}\n41|\treturn nil\n42|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5dd","stream":{"kind":"session","id":"01a08946-5fbe-7830-b2e8-af2616179f48"},"sequence":329,"recorded_at":1780531400000653,"record_type":"event","durability":"durable","causation_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","run_stream":{"kind":"run","id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f"},"call_id":"call_01a08946deb77780a985e539dfdd6636","text":"Read text file `internal/hosttrust/export.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"fmt\"\n5|)\n6|\n7|// EnrollmentMaterial is the explicitly selected public enrollment material an\n8|// operator exchanges out of band. It carries no private key: only\n9|// certificate.pem and root.pem bytes leave the store, never private-key.pem,\n10|// trust internals, backups or authorization caches.\n11|type EnrollmentMaterial struct {\n12|\tHostID       string\n13|\tCredentialID string\n14|\tLeafDER      []byte\n15|\tRootDER      []byte\n16|\tFingerprints Fingerprints\n17|}\n18|\n19|// Formatting enrollment material redacts DER bytes by default; the operator\n20|// exports explicit fields, never a log line.\n21|func (EnrollmentMaterial) String() string   { return \"host enrollment material\" }\n22|func (EnrollmentMaterial) GoString() string { return \"host enrollment material\" }\n23|func (EnrollmentMaterial) Format(state fmt.State, verb rune) {\n24|\t_, _ = state.Write([]byte(\"host enrollment material\"))\n25|}\n26|\n27|// ExportEnrollment selects the public bytes of one non-revoked entry for\n28|// out-of-band exchange. Revoked tombstones never redistribute: exporting one\n29|// refuses.\n30|func ExportEnrollment(snapshot Snapshot, credentialID string) (EnrollmentMaterial, error) {\n31|\tentry, found := findEntry(snapshot.Trust, credentialID)\n32|\tif !found {\n33|\t\treturn EnrollmentMaterial{}, trustError(TrustError{Operation: \"export enrollment\", Err: ErrEnrollmentRefused})\n34|\t}\n35|\tif entry.State == EntryRevoked {\n36|\t\treturn EnrollmentMaterial{}, trustError(TrustError{Operation: \"export enrollment\", Err: ErrEnrollmentRefused})\n37|\t}\n38|\tfingerprints, err := FingerprintsOf(entry.LeafDER, entry.RootDER)\n39|\tif err != nil {\n40|\t\treturn EnrollmentMaterial{}, err\n41|\t}\n42|\treturn EnrollmentMaterial{\n43|\t\tHostID:       entry.HostID.String(),\n44|\t\tCredentialID: entry.CredentialID.String(),\n45|\t\tLeafDER:      append([]byte(nil), entry.LeafDER...),\n46|\t\tRootDER:      append([]byte(nil), entry.RootDER...),\n47|\t\tFingerprints: fingerprints,\n48|\t}, nil\n49|}\n50|\n51|// ExcludedFromReplication lists the STATE_DIR-relative paths that must never\n52|// enter replication, snapshots, cloning, Session Directory, logs or exported\n53|// diagnostic bundles. Credential, trust, backup, private-key and\n54|// authorization-cache material stays machine-local; operators exchange only\n55|// explicitly selected public enrollment material outside replication.\n56|func ExcludedFromReplication() []string {\n57|\treturn []string{\n58|\t\thostChannelDir + \"/trust.json\",\n59|\t\thostChannelDir + \"/credentials/\",\n60|\t\thostChannelDir + \"/lock\",\n61|\t}\n62|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5df","stream":{"kind":"session","id":"01a08946-5fbe-7830-b2e8-af2616179f48"},"sequence":330,"recorded_at":1780531400000655,"record_type":"event","durability":"durable","causation_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","run_stream":{"kind":"run","id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f"},"call_id":"call_01a08946df387df2bad0f8ff5ef15f6c","text":"Read text file `internal/hosttrust/lock_windows.go`.\n1|//go:build windows\n2|\n3|package hosttrust\n4|\n5|import (\n6|\t\"errors\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\n10|\t\"golang.org/x/sys/windows\"\n11|)\n12|\n13|// fileLock is the machine-local cross-process authorization lock shared by\n14|// trust changes and Configuration 4.0.0 peer/credential changes. Readers hold\n15|// it shared; transactions hold it exclusive.\n16|type fileLock struct {\n17|\thandle windows.Handle\n18|}\n19|\n20|func openLock(filesystem FileSystem, path string) (*fileLock, error) {\n21|\tinfo, err := filesystem.Lstat(path)\n22|\tif err != nil {\n23|\t\tif !os.IsNotExist(err) {\n24|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n25|\t\t}\n26|\t\tstaged, err := filesystem.CreateTemp(filepath.Dir(path), \"lock-stage-*\", 0o600)\n27|\t\tif err != nil {\n28|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n29|\t\t}\n30|\t\tname := staged.Name()\n31|\t\t_ = staged.Close()\n32|\t\tif err := filesystem.Rename(name, path); err != nil {\n33|\t\t\t_ = filesystem.Remove(name)\n34|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n35|\t\t}\n36|\t\tif err := filesystem.Chmod(path, 0o600); err != nil {\n37|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n38|\t\t}\n39|\t\tinfo, err = filesystem.Lstat(path)\n40|\t\tif err != nil {\n41|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n42|\t\t}\n43|\t}\n44|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n45|\t\treturn nil, err\n46|\t}\n47|\tname, err := windows.UTF16PtrFromString(path)\n48|\tif err != nil {\n49|\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n50|\t}\n51|\thandle, err := windows.CreateFile(name, windows.GENERIC_READ|windows.GENERIC_WRITE,\n52|\t\twindows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING,\n53|\t\twindows.FILE_ATTRIBUTE_NORMAL, 0)\n54|\tif err != nil {\n55|\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n56|\t}\n57|\treturn &fileLock{handle: handle}, nil\n58|}\n59|\n60|func (lock *fileLock) shared() (func(), error) {\n61|\toverlapped := new(windows.Overlapped)\n62|\tif err := windows.LockFileEx(lock.handle, 0, 0, 1, 0, overlapped); err != nil {\n63|\t\treturn nil, err\n64|\t}\n65|\treturn func() { _ = windows.UnlockFileEx(lock.handle, 0, 1, 0, overlapped) }, nil\n66|}\n67|\n68|func (lock *fileLock) exclusive() (func(), error) {\n69|\toverlapped := new(windows.Overlapped)\n70|\tif err := windows.LockFileEx(lock.handle, windows.LOCKFILE_EXCLUSIVE_LOCK, 0, 1, 0, overlapped); err != nil {\n71|\t\treturn nil, err\n72|\t}\n73|\treturn func() { _ = windows.UnlockFileEx(lock.handle, 0, 1, 0, overlapped) }, nil\n74|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
