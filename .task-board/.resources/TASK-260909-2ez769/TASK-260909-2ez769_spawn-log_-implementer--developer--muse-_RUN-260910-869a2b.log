 range []*x509.Certificate{leaf, root} {\n48|\t\tif instant.Before(certificate.NotBefore) || instant.After(certificate.NotAfter) {\n49|\t\t\treturn errors.New(\"credential outside validity window\")\n50|\t\t}\n51|\t}\n52|\treturn nil\n53|}\n54|\n55|func peerEnrolled(trust hosttrust.Snapshot, hostID string, now time.Time) bool {\n56|\tfor _, entry := range trust.Trust.Entries {\n57|\t\tif entry.HostID.String() != hostID || entry.State != hosttrust.EntryActive {\n58|\t\t\tcontinue\n59|\t\t}\n60|\t\tif checkCredentialWindow(entry.LeafDER, entry.RootDER, now) == nil {\n61|\t\t\treturn true\n62|\t\t}\n63|\t}\n64|\treturn false\n65|}\n66|\n67|// writeTempReplace durably restores document over filename after a trust\n68|// commit failure. It is recovery, not a migration: no backup is published.\n69|func writeTempReplace(filesystem migrationFileSystem, filename string, document []byte) (string, error) {\n70|\tdirectory := filepath.Dir(filename)\n71|\tstaged, err := writeTempFile(filesystem, directory, \".ax-config-restore-*\", document, 0o600)\n72|\tif err != nil {\n73|\t\treturn \"\", err\n74|\t}\n75|\tif err := filesystem.Rename(staged, filename); err != nil {\n76|\t\t_ = filesystem.Remove(staged)\n77|\t\treturn \"\", err\n78|\t}\n79|\tif err := syncDirectory(filesystem, directory); err != nil {\n80|\t\treturn \"\", err\n81|\t}\n82|\treturn staged, nil\n83|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
