{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c719","stream":{"kind":"session","id":"01a08946-5fbe-7830-b2e8-af2616179f48"},"sequence":487,"recorded_at":1780531400000969,"record_type":"event","durability":"durable","causation_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","run_stream":{"kind":"run","id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f"},"task_stream":{"kind":"task","id":"01a08947-272f-7c63-9ae3-9226d046d93f"},"task_id":"01a08947-272f-7c63-9ae3-9226d046d93f","event":{"kind":"output","task_id":"01a08947-272f-7c63-9ae3-9226d046d93f","chunk":"Read text file `internal/hosttrust/custody.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"io\"\n6|\t\"io/fs\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|)\n10|\n11|const (\n12|\thostChannelDir  = \"host-channel\"\n13|\ttrustFileName   = \"trust.json\"\n14|\tlockFileName    = \"lock\"\n15|\tcredentialsDir  = \"credentials\"\n16|\tcertificateFile = \"certificate.pem\"\n17|\tprivateKeyFile  = \"private-key.pem\"\n18|\trootFile        = \"root.pem\"\n19|\tstagePrefix     = \".trust-stage-\"\n20|)\n21|\n22|// FileSystem abstracts durable writes so crash and fault paths are testable\n23|// without touching the operator disk. The OS implementation is the only\n24|// production backend.\n25|type FileSystem interface {\n26|\tCreateTemp(dir, pattern string, mode fs.FileMode) (StagedFile, error)\n27|\tReadFile(name string) ([]byte, error)\n28|\tLstat(name string) (fs.FileInfo, error)\n29|\tStat(name string) (fs.FileInfo, error)\n30|\tRemove(name string) error\n31|\tRename(oldname, newname string) error\n32|\tMkdirAll(path string, mode fs.FileMode) error\n33|\tChmod(name string, mode fs.FileMode) error\n34|\tOpenDirectory(name string) (SyncedDirectory, error)\n35|\tReadDir(name string) ([]fs.DirEntry, error)\n36|}\n37|\n38|// StagedFile is one temp staging file awaiting fsync and atomic rename.\n39|type StagedFile interface {\n40|\tio.Writer\n41|\tName() string\n42|\tChmod(fs.FileMode) error\n43|\tSync() error\n44|\tClose() error\n45|}\n46|\n47|// SyncedDirectory fsyncs a directory entry after renames.\n48|type SyncedDirectory interface {\n49|\tSync() error\n50|\tClose() error\n51|}\n52|\n53|type osFileSystem struct{}\n54|\n55|func (osFileSystem) CreateTemp(dir, pattern string, mode fs.FileMode) (StagedFile, error) {\n56|\tfile, err := os.CreateTemp(dir, pattern)\n57|\tif err != nil {\n58|\t\treturn nil, err\n59|\t}\n60|\tif err := file.Chmod(mode); err != nil {\n61|\t\t_ = file.Close()\n62|\t\t_ = os.Remove(file.Name())\n63|\t\treturn nil, err\n64|\t}\n65|\treturn file, nil\n66|}\n67|\n68|func (osFileSystem) ReadFile(name string) ([]byte, error)   { return os.ReadFile(name) }\n69|func (osFileSystem) Lstat(name string) (fs.FileInfo, error) { return os.Lstat(name) }\n70|func (osFileSystem) Stat(name string) (fs.FileInfo, error)  { return os.Stat(name) }\n71|func (osFileSystem) Remove(name string) error               { return os.Remove(name) }\n72|func (osFileSystem) Rename(oldname, newname string) error   { return os.Rename(oldname, newname) }\n73|\n74|func (osFileSystem) MkdirAll(path string, mode fs.FileMode) error { return os.MkdirAll(path, mode) }\n75|func (osFileSystem) Chmod(name string, mode fs.FileMode) error    { return os.Chmod(name, mode) }\n76|\n77|func (osFileSystem) OpenDirectory(name string) (SyncedDirectory, error) { return os.Open(name) }\n78|func (osFileSystem) ReadDir(name string) ([]fs.DirEntry, error)         { return os.ReadDir(name) }\n79|\n80|// Store is machine-local Host Channel authority rooted at\n81|// STATE_DIR/host-channel. The zero value is unusable; construct with Open.\n82|type Store struct {\n83|\troot string\n84|\tfs   FileSystem\n85|\tlock *fileLock\n86|}\n87|\n88|// Open validates owner-only custody of STATE_DIR/host-channel, creating the\n89|// directory skeleton with exact 0700/0600 modes when absent. Every open\n90|// re-verifies custody: symlink escapes, foreign ownership and group/world\n91|// access refuse with ErrTrustUnsafeCustody.\n92|func Open(stateDir string) (*Store, error) { return openStore(stateDir, osFileSystem{}) }\n93|\n94|func openStore(stateDir string, filesystem FileSystem) (*Store, error) {\n95|\tif filesystem == nil {\n96|\t\treturn nil, trustError(TrustError{Operation: \"open store\", Err: ErrInvalidStoreContext})\n97|\t}\n98|\tif !filepath.IsAbs(stateDir) {\n99|\t\treturn nil, trustError(TrustError{Operation: \"open store\", Err: ErrInvalidStoreContext})\n100|\t}\n101|\troot := filepath.Join(stateDir, hostChannelDir)\n102|\tif err := ensureOwnerDir(filesystem, root, 0o700); err != nil {\n103|\t\treturn nil, err\n104|\t}\n105|\tif err := ensureOwnerDir(filesystem, filepath.Join(root, credentialsDir), 0o700); err != nil {\n106|\t\treturn nil, err\n107|\t}\n108|\tlock, err := openLock(filesystem, filepath.Join(root, lockFileName))\n109|\tif err != nil {\n110|\t\treturn nil, err\n111|\t}\n112|\treturn &Store{root: root, fs: filesystem, lock: lock}, nil\n113|}\n114|\n115|// Root reports the validated host-channel directory. It carries no secrets.\n116|func (store *Store) Root() string { return store.root }\n117|\n118|// TrustPath reports the trust.json path for operator diagnostics. Reading or\n119|// writing it directly bypasses the authorization lock; use transactions.\n120|func (store *Store) TrustPath() string { return filepath.Join(store.root, trustFileName) }\n121|\n122|// CredentialDir reports the custody directory for one credential ID hex. It\n123|// carries no key material.\n124|func (store *Store) CredentialDir(credentialHex string) (string, error) {\n125|\tif len(credentialHex) != 64 {\n126|\t\treturn \"\", trustError(TrustError{Operation: \"resolve credential directory\", Err: ErrCredentialCustody})\n127|\t}\n128|\tfor _, unit := range credentialHex {\n129|\t\tif (unit < '0' || unit > '9') && (unit < 'a' || unit > 'f') {\n130|\t\t\treturn \"\", trustError(TrustError{Operation: \"resolve credential directory\", Err: ErrCredentialCustody})\n131|\t\t}\n132|\t}\n133|\treturn filepath.Join(store.root, credentialsDir, credentialHex), nil\n134|}\n135|\n136|func ensureOwnerDir(filesystem FileSystem, path string, mode fs.FileMode) error {\n137|\tinfo, err := filesystem.Lstat(path)\n138|\tif err != nil && !os.IsNotExist(err) {\n139|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n140|\t}\n141|\tif err == nil {\n142|\t\t// An existing directory is verified, never repaired: silently\n143|\t\t// narrowing a widened directory would mask the custody violation.\n144|\t\treturn verifyOwnerDir(path, info, mode)\n145|\t}\n146|\tif err := filesystem.MkdirAll(path, mode); err != nil {\n147|\t\treturn trustError(TrustError{Operation: \"create directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n148|\t}\n149|\t// MkdirAll honors umask, so the exact owner-only mode is enforced\n150|\t// explicitly after creation.\n151|\tif err := filesystem.Chmod(path, mode); err != nil {\n152|\t\treturn trustError(TrustError{Operation: \"create directory\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n153|\t}\n154|\tinfo, err = filesystem.Lstat(path)\n155|\tif err != nil {\n156|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n157|\t}\n158|\treturn verifyOwnerDir(path, info, mode)\n159|}\n160|\n161|func verifyOwnerDir(path string, info fs.FileInfo, mode fs.FileMode) error {\n162|\tif !info.IsDir() {\n163|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: ErrTrustUnsafeCustody})\n164|\t}\n165|\tif info.Mode()&fs.ModeSymlink != 0 {\n166|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: ErrTrustUnsafeCustody})\n167|\t}\n168|\tif info.Mode().Perm() != mode {\n169|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: ErrTrustUnsafeCustody})\n170|\t}\n171|\treturn verifyOwner(path, info)\n172|}\n173|\n174|func verifyOwnerFile(path string, info fs.FileInfo, mode fs.FileMode) error {\n175|\tif !info.Mode().IsRegular() {\n176|\t\treturn trustError(TrustError{Operation: \"inspect file\", Err: ErrTrustUnsafeCustody})\n177|\t}\n178|\tif info.Mode()&fs.ModeSymlink != 0 {\n179|\t\treturn trustError(TrustError{Operation: \"inspect file\", Err: ErrTrustUnsafeCustody})\n180|\t}\n181|\tif info.Mode().Perm() != mode {\n182|\t\treturn trustError(TrustError{Operation: \"inspect file\", Err: ErrTrustUnsafeCustody})\n183|\t}\n184|\treturn verifyOwner(path, info)\n185|}","final_result":true}}}
