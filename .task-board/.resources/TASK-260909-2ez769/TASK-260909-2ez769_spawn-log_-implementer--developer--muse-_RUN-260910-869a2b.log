n-\t\t\t}\n-\t\t}\n-\t\treturn V4ApplyResult{}, err\n-\t}\n+\tgeneration, err := store.JointCommit(marker,\n+\t\tfunc(current hosttrust.TrustStore) error {\n+\t\t\treturn revalidateApplyV4(inputs, overrides, store, preview, current, now)\n+\t\t},\n+\t\tfunc() error {\n+\t\t\treturn replaceDurably(filesystem, filename, backup, preview.SourceDocument, preview.Replacement)\n+\t\t})\n+\tif err != nil {\n+\t\tif errors.Is(err, hosttrust.ErrJointReplacementDurable) {\n+\t\t\t// The replacement is durable but the generation bump failed:\n+\t\t\t// restore the source bytes, then converge the marker through\n+\t\t\t// recovery (the restored source aborts it cleanly). A failed\n+\t\t\t// restore keeps the marker for operator resolution.\n+\t\t\tif _, restoreErr := writeTempReplace(filesystem, filename, preview.SourceDocument); restoreErr != nil {\n+\t\t\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"recover source after trust commit\", Err: errors.Join(ErrMigrationSync, ErrMigrationRecovery, err, restoreErr)})\n+\t\t\t}\n+\t\t\tif _, recoverErr := store.Recover(); recoverErr != nil {\n+\t\t\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"recover source after trust commit\", Err: errors.Join(ErrMigrationSync, ErrMigrationRecovery, err, recoverErr)})\n+\t\t\t}\n+\t\t}\n+\t\treturn V4ApplyResult{}, err\n+\t}\n","final_result":true}}}
