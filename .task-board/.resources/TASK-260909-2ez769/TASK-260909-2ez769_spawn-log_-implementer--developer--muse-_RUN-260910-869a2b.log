{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cd55","stream":{"kind":"session","id":"01a08946-5fbe-7830-b2e8-af2616179f48"},"sequence":1285,"recorded_at":1780531400002565,"record_type":"event","durability":"durable","causation_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","run_stream":{"kind":"run","id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f"},"task_stream":{"kind":"task","id":"01a0894b-c3ee-77f3-ab1e-d532c335c8c7"},"task_id":"01a0894b-c3ee-77f3-ab1e-d532c335c8c7","event":{"kind":"output","task_id":"01a0894b-c3ee-77f3-ab1e-d532c335c8c7","chunk":"edited\nchanged lines: lines 29-35\n--- original\n+++ updated\n@@\n-func readSnapshot(filesystem FileSystem, root string, lock *fileLock) (Snapshot, error) {\n-\tunlock, err := lock.shared()\n-\tif err != nil {\n-\t\treturn Snapshot{}, trustError(TrustError{Operation: \"lock snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n-\t}\n-\tdefer unlock()\n-\tpath := filepath.Join(root, trustFileName)\n+// WithSharedSnapshot runs fn under the shared authorization lock with the\n+// committed trust, so a config-plus-trust pair observed inside fn is\n+// coherent: no trust or config commit can land between the trust read and\n+// fn's own reads. Callers must not acquire the lock again inside fn;\n+// internal reads there use the supplied committed value directly.\n+func (store *Store) WithSharedSnapshot(fn func(current TrustStore) error) error {\n+\tunlock, err := store.lock.shared()\n+\tif err != nil {\n+\t\treturn trustError(TrustError{Operation: \"lock snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n+\t}\n+\tdefer unlock()\n+\tcommitted, err := readSnapshotLocked(store.fs, store.root)\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tif fn == nil {\n+\t\treturn trustError(TrustError{Operation: \"read snapshot\", Err: ErrAuthorizationRefused})\n+\t}\n+\treturn fn(committed)\n+}\n+\n+func readSnapshot(filesystem FileSystem, root string, lock *fileLock) (Snapshot, error) {\n+\tunlock, err := lock.shared()\n+\tif err != nil {\n+\t\treturn Snapshot{}, trustError(TrustError{Operation: \"lock snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n+\t}\n+\tdefer unlock()\n+\treturn readSnapshotLocked(filesystem, root)\n+}\n+\n+// readSnapshotLocked reads one coherent committed snapshot assuming the\n+// caller already holds the shared or exclusive authorization lock.\n+func readSnapshotLocked(filesystem FileSystem, root string) (Snapshot, error) {\n+\tpath := filepath.Join(root, trustFileName)\n","final_result":true}}}
