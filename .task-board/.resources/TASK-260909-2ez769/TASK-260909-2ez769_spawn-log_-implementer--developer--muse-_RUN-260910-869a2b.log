{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c649","stream":{"kind":"session","id":"01a08946-5fbe-7830-b2e8-af2616179f48"},"sequence":383,"recorded_at":1780531400000761,"record_type":"event","durability":"durable","causation_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","run_stream":{"kind":"run","id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f"},"task_stream":{"kind":"task","id":"01a08946-fdd8-7ac2-9011-44352754fac2"},"task_id":"01a08946-fdd8-7ac2-9011-44352754fac2","event":{"kind":"output","task_id":"01a08946-fdd8-7ac2-9011-44352754fac2","chunk":"Read text file `internal/hosttrust/authorize_test.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"crypto/x509\"\n5|\t\"errors\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"strings\"\n9|\t\"sync\"\n10|\t\"testing\"\n11|\t\"time\"\n12|)\n13|\n14|func twoHostFixture(t *testing.T) (local, peer *Store, localCredential, peerCredential string, localSnap, peerSnap Snapshot) {\n15|\tt.Helper()\n16|\tlocal = setupStoreForTest(t)\n17|\tpeer = setupStoreForTest(t)\n18|\tvar err error\n19|\tlocalCredential, err = local.Issue(testHostA, testNow)\n20|\tif err != nil {\n21|\t\tt.Fatal(err)\n22|\t}\n23|\tpeerCredential = enrollPeerForTest(t, local, peer, testHostB, testNow)\n24|\tenrollPeerForTest(t, peer, local, testHostA, testNow)\n25|\tlocalSnap, err = local.ReadSnapshot()\n26|\tif err != nil {\n27|\t\tt.Fatal(err)\n28|\t}\n29|\tpeerSnap, err = peer.ReadSnapshot()\n30|\tif err != nil {\n31|\t\tt.Fatal(err)\n32|\t}\n33|\treturn local, peer, localCredential, peerCredential, localSnap, peerSnap\n34|}\n35|\n36|func peerMaterialForTest(t *testing.T, peer *Store, credential string) (leafDER, rootDER []byte) {\n37|\tt.Helper()\n38|\tsnapshot, err := peer.ReadSnapshot()\n39|\tif err != nil {\n40|\t\tt.Fatal(err)\n41|\t}\n42|\tmaterial, err := ExportEnrollment(snapshot, credential)\n43|\tif err != nil {\n44|\t\tt.Fatal(err)\n45|\t}\n46|\treturn material.LeafDER, material.RootDER\n47|}\n48|\n49|func dispatchRequest(localSnap Snapshot, localCredential, peerCredential, hello string, leafDER, rootDER []byte, allowlist []string, now time.Time) AuthRequest {\n50|\treturn AuthRequest{\n51|\t\tSnapshotGeneration:   localSnap.Generation,\n52|\t\tLocalHostID:          testHostA,\n53|\t\tLocalCredentialID:    localCredential,\n54|\t\tRemoteLeafDER:        leafDER,\n55|\t\tRemoteRootDER:        rootDER,\n56|\t\tExpectedRemoteHostID: testHostB,\n57|\t\tAllowlisted:          allowlist,\n58|\t\tHelloHostID:          hello,\n59|\t\tNow:                  now,\n60|\t}\n61|}\n62|\n63|func TestAuthorizeDispatchHappyPath(t *testing.T) {\n64|\tlocal, peer, localCredential, peerCredential, localSnap, _ := twoHostFixture(t)\n65|\tleafDER, rootDER := peerMaterialForTest(t, peer, peerCredential)\n66|\trequest := dispatchRequest(localSnap, localCredential, peerCredential, testHostB, leafDER, rootDER, []string{testHostA, testHostB}, testNow)\n67|\tif err := local.AuthorizeDispatch(localSnap, request); err != nil {\n68|\t\tt.Fatalf(\"AuthorizeDispatch error = %v\", err)\n69|\t}\n70|}\n71|\n72|func TestAuthorizeDispatchRefusals(t *testing.T) {\n73|\tlocal, peer, localCredential, peerCredential, localSnap, _ := twoHostFixture(t)\n74|\tleafDER, rootDER := peerMaterialForTest(t, peer, peerCredential)\n75|\tother := issueForTest(t, testHostC, testNow)\n76|\tstranger := setupStoreForTest(t)\n77|\tstrangerCredential, err := stranger.Issue(testHostC, testNow)\n78|\tif err != nil {\n79|\t\tt.Fatal(err)\n80|\t}\n81|\tstrangerSnap, err := stranger.ReadSnapshot()\n82|\tif err != nil {\n83|\t\tt.Fatal(err)\n84|\t}\n85|\tstrangerMaterial, err := ExportEnrollment(strangerSnap, strangerCredential)\n86|\tif err != nil {\n87|\t\tt.Fatal(err)\n88|\t}\n89|\tallowlist := []string{testHostA, testHostB}\n90|\tstaleSnap := Snapshot{Generation: localSnap.Generation - 1, Trust: localSnap.Trust}\n91|\tfutureSnap := Snapshot{Generation: localSnap.Generation + 1, Trust: localSnap.Trust}\n92|\tmismatched := dispatchRequest(localSnap, localCredential, peerCredential, testHostB, leafDER, rootDER, allowlist, testNow)\n93|\tmismatched.SnapshotGeneration = localSnap.Generation - 1\n94|\ttests := []struct {\n95|\t\tname     string\n96|\t\tsnapshot Snapshot\n97|\t\trequest  AuthRequest\n98|\t\twant     error\n99|\t}{\n100|\t\t{\"stale generation\", staleSnap, dispatchRequest(staleSnap, localCredential, peerCredential, testHostB, leafDER, rootDER, allowlist, testNow), ErrStaleGeneration},\n101|\t\t{\"future generation\", futureSnap, dispatchRequest(futureSnap, localCredential, peerCredential, testHostB, leafDER, rootDER, allowlist, testNow), ErrStaleGeneration},\n102|\t\t{\"refreshed number on old snapshot\", localSnap, mismatched, ErrStaleGeneration},\n103|\t\t{\"unknown local credential\", localSnap, dispatchRequest(localSnap, peerCredential, peerCredential, testHostB, leafDER, rootDER, allowlist, testNow), ErrAuthorizationRefused},\n104|\t\t{\"unknown remote bytes\", localSnap, dispatchRequest(localSnap, localCredential, peerCredential, testHostB, other.LeafDER, other.RootDER, allowlist, testNow), ErrAuthorizationRefused},\n105|\t\t{\"unenrolled remote\", localSnap, dispatchRequest(localSnap, localCredential, peerCredential, testHostC, strangerMaterial.LeafDER, strangerMaterial.RootDER, allowlist, testNow), ErrAuthorizationRefused},\n106|\t\t{\"leaf root mismatch\", localSnap, dispatchRequest(localSnap, localCredential, peerCredential, testHostB, leafDER, other.RootDER, allowlist, testNow), ErrAuthorizationRefused},\n107|\t\t{\"not allowlisted\", localSnap, dispatchRequest(localSnap, localCredential, peerCredential, testHostB, leafDER, rootDER, []string{testHostA}, testNow), ErrNotAllowlisted},\n108|\t\t{\"hello mismatch\", localSnap, dispatchRequest(localSnap, localCredential, peerCredential, testHostC, leafDER, rootDER, allowlist, testNow), ErrHostIdentityMismatch},\n109|\t\t{\"wrong destination\", localSnap, func() AuthRequest {\n110|\t\t\trequest := dispatchRequest(localSnap, localCredential, peerCredential, testHostB, leafDER, rootDER, allowlist, testNow)\n111|\t\t\trequest.ExpectedRemoteHostID = testHostC\n112|\t\t\treturn request\n113|\t\t}(), ErrHostIdentityMismatch},\n114|\t\t{\"expired credentials\", localSnap, dispatchRequest(localSnap, localCredential, peerCredential, testHostB, leafDER, rootDER, allowlist, testNow.Add(91*24*time.Hour)), ErrAuthorizationRefused},\n115|\t}\n116|\tfor _, test := range tests {\n117|\t\tt.Run(test.name, func(t *testing.T) {\n118|\t\t\tif err := local.AuthorizeDispatch(test.snapshot, test.request); err == nil {\n119|\t\t\t\tt.Fatalf(\"AuthorizeDispatch(%s) succeeded, want refusal\", test.name)\n120|\t\t\t} else if !errors.Is(err, test.want) {\n(more lines below)","final_result":true}}}
