{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6d1","stream":{"kind":"session","id":"01a08946-5fbe-7830-b2e8-af2616179f48"},"sequence":451,"recorded_at":1780531400000897,"record_type":"event","durability":"durable","causation_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","run_stream":{"kind":"run","id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f"},"task_stream":{"kind":"task","id":"01a08947-1878-7d82-9733-1a619d4b3d5c"},"task_id":"01a08947-1878-7d82-9733-1a619d4b3d5c","event":{"kind":"output","task_id":"01a08947-1878-7d82-9733-1a619d4b3d5c","chunk":"Read text file `.temp/TASK-260909-2ez769/review3/reviewer_crash_test.go.txt`.\n1|package config\n2|\n3|import (\n4| \"os\"\n5| \"os/exec\"\n6| \"path/filepath\"\n7| \"testing\"\n8| \"time\"\n9| \"github.com/relux-works/agent-session-manager/internal/hosttrust\"\n10| \"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|)\n12|\n13|type reviewerCrashFS struct {osMigrationFileSystem; target string}\n14|func (f reviewerCrashFS) Rename(from,to string) error {\n15| if err:=f.osMigrationFileSystem.Rename(from,to);err!=nil{return err}\n16| if to==f.target {os.Exit(77)}\n17| return nil\n18|}\n19|func TestReviewerCrashBetweenConfigAndGeneration(t *testing.T) {\n20| if dir:=os.Getenv(\"AX_REVIEW_CRASH_FIXTURE\");dir!=\"\" {\n21|  filename:=filepath.Join(dir,\"config.toml\")\n22|  state:=filepath.Join(dir,\"state\")\n23|  inputs:=Inputs{Platform:scalar.PlatformMacOS,HomeDir:dir,TempDir:dir,WorkingDir:dir,Stat:os.Stat,ReadFile:os.ReadFile,LookupEnv:func(k string)(string,bool){if k==\"AX_CONFIG\"{return filename,true};if k==\"AX_STATE_DIR\"{return state,true};return \"\",false}}\n24|  store,err:=hosttrust.Open(state);if err!=nil{t.Fatal(err)}\n25|  snap,err:=store.ReadSnapshot();if err!=nil{t.Fatal(err)}\n26|  self:=\"\";for _,e:=range snap.Trust.Entries{if e.HostID.String()==testHostID{self=e.CredentialID.String()}}\n27|  now:=time.Now().UTC()\n28|  preview,err:=PreviewV4(inputs,nil,snap,self,nil,now);if err!=nil{t.Fatal(err)}\n29|  _,err=applyV4(inputs,nil,preview,true,now,reviewerCrashFS{target:filename},hosttrust.Open)\n30|  t.Fatalf(\"crash seam not reached: %v\",err)\n31| }\n32| fixture:=setupV4Fixture(t,testPeerID)\n33| before:=fixture.trust(t).Generation\n34| command:=exec.Command(os.Args[0],\"-test.run=^TestReviewerCrashBetweenConfigAndGeneration$\")\n35| command.Env=append(os.Environ(),\"AX_REVIEW_CRASH_FIXTURE=\"+fixture.directory)\n36| output,err:=command.CombinedOutput()\n37| exit,ok:=err.(*exec.ExitError);if !ok||exit.ExitCode()!=77{t.Fatalf(\"child did not crash at seam: %v %s\",err,output)}\n38| loaded,err:=Load(fixture.inputs,nil);if err!=nil{return}\n39| configuration,ok:=loaded.Configuration();if !ok{return}\n40| reopened,err:=hosttrust.Open(fixture.stateDir);if err!=nil{return}\n41| snap,err:=reopened.ReadSnapshot();if err!=nil{return}\n42| if configuration.SourceVersion==Version4 && snap.Generation==before {t.Fatalf(\"restart admits new Config4 with old generation %d after child exit 77\",before)}\n43|}","final_result":true}}}
