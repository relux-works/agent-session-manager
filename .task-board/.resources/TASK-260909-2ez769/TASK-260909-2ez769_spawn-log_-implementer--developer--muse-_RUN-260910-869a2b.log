| go func(){revoked <- local.Revoke(pc)}()\n28| var early bool\n29| var revokeErr error\n30| select {case revokeErr= <-revoked: early=true; case <-time.After(250*time.Millisecond):}\n31| close(release)\n32| if err:= <-boundaryDone;err!=nil{t.Fatal(err)}\n33| if !early {revokeErr= <-revoked}\n34| if revokeErr !=nil {t.Fatal(revokeErr)}\n35| if early {t.Fatal(\"revocation reported success while mutation boundary still held prior authorization\")}\n36|}","final_result":true}}}
