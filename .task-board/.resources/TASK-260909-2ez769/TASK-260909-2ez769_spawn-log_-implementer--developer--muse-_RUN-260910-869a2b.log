{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cef9","stream":{"kind":"session","id":"01a08946-5fbe-7830-b2e8-af2616179f48"},"sequence":1495,"recorded_at":1780531400002985,"record_type":"event","durability":"durable","causation_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","run_stream":{"kind":"run","id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f"},"task_stream":{"kind":"task","id":"01a0894c-2e27-7750-adda-763811bb44d5"},"task_id":"01a0894c-2e27-7750-adda-763811bb44d5","event":{"kind":"output","task_id":"01a0894c-2e27-7750-adda-763811bb44d5","chunk":"Read text file `internal/hosttrust/trust_decode.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"crypto/x509\"\n6|\t\"encoding/base64\"\n7|\t\"encoding/json\"\n8|\t\"errors\"\n9|\t\"io\"\n10|\t\"strconv\"\n11|\t\"strings\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|)\n15|\n16|var entryFields = []string{\"host_id\", \"credential_id\", \"spki_id\", \"root_id\", \"leaf_der\", \"root_der\", \"state\", \"enrolled_at\", \"retire_at\"}\n17|\n18|func decodeExactString(shape map[string]json.RawMessage, key string, target *string) error {\n19|\traw, ok := shape[key]\n20|\tif !ok {\n21|\t\treturn trustError(TrustError{Operation: \"decode \" + key, Err: ErrTrustValidation})\n22|\t}\n23|\tvar value string\n24|\tdecoder := strictJSONDecoder(raw)\n25|\tif err := decoder.Decode(&value); err != nil {\n26|\t\treturn trustError(TrustError{Operation: \"decode \" + key, Err: errors.Join(ErrTrustDecode, err)})\n27|\t}\n28|\t*target = value\n29|\treturn nil\n30|}\n31|\n32|func strictJSONDecoder(raw json.RawMessage) *json.Decoder {\n33|\tdecoder := json.NewDecoder(strings.NewReader(string(raw)))\n34|\tdecoder.UseNumber()\n35|\treturn decoder\n36|}\n37|\n38|func decodeGeneration(shape map[string]json.RawMessage) (uint64, error) {\n39|\traw,