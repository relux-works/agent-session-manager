{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7d7","stream":{"kind":"session","id":"01a08946-5fbe-7830-b2e8-af2616179f48"},"sequence":582,"recorded_at":1780531400001159,"record_type":"event","durability":"durable","causation_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","run_stream":{"kind":"run","id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f"},"call_id":"call_01a0894745807d4295216a51a4972ecd","text":"Read text file `internal/config/migration_v4.go`.\n1|package config\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"time\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/hosttrust\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|var (\n12|\t// ErrMigrationV4ConfirmRequired reports an ApplyV4 call without explicit\n13|\t// operator confirmation of the exact preview.\n14|\tErrMigrationV4ConfirmRequired = errors.New(\"configuration 4.0.0 apply requires explicit confirmation\")\n15|\t// ErrMigrationV4StaleSource reports a preview applied after the selected\n16|\t// configuration changed. The operator must preview again.\n17|\tErrMigrationV4StaleSource = errors.New(\"configuration 4.0.0 preview source changed\")\n18|\t// ErrMigrationV4StaleGeneration reports a preview applied after the\n19|\t// trust generation moved. The operator must preview again.\n20|\tErrMigrationV4StaleGeneration = errors.New(\"configuration 4.0.0 preview trust generation changed\")\n21|\t// ErrMigrationV4PreviewMismatch reports preview bytes that do not match\n22|\t// the replacement rendered from current state. Only the exact preview\n23|\t// applies.\n24|\tErrMigrationV4PreviewMismatch = errors.New(\"configuration 4.0.0 preview does not match current state\")\n25|\t// ErrMigrationV4Credential reports a selected credential that is\n26|\t// missing, not enrolled for the local host, not active, or outside its\n27|\t// validity window.\n28|\tErrMigrationV4Credential = errors.New(\"configuration 4.0.0 selected credential is not admitted\")\n29|\t// ErrMigrationV4PeerEnrollment reports retained peers without a complete\n30|\t// local enrollment. A missing peer enrollment blocks activation; the\n31|\t// operator may explicitly remove a peer from the preview instead.\n32|\tErrMigrationV4PeerEnrollment = errors.New(\"configuration 4.0.0 peer enrollment incomplete\")\n33|\t// ErrMigrationV4DropUnknown reports an explicit peer removal naming a\n34|\t// host that is not a configured peer. Silent drops are impossible: only\n35|\t// named configured peers leave the preview.\n36|\tErrMigrationV4DropUnknown = errors.New(\"configuration 4.0.0 explicit peer removal names an unknown peer\")\n37|\t// ErrRollbackV4AckRequired reports a rollback without acknowledgement\n38|\t// that the legacy installation has no Host Channel assurance.\n39|\tErrRollbackV4AckRequired = errors.New(\"configuration rollback requires no-host-channel-assurance acknowledgement\")\n40|\t// ErrRollbackV4Backup reports a missing, unreadable or undecodable\n41|\t// rollback backup. Rollback replaces configuration only from the\n42|\t// preserved backup bytes.\n43|\tErrRollbackV4Backup = errors.New(\"configuration rollback backup is missing or invalid\")\n44|)\n45|\n46|// V4Preview is the exact Config-4 replacement an operator confirms.\n47|// SourceDocument and SourceGeneration pin the state the preview was rendered\n48|// from; Replacement is the only byte sequence ApplyV4 installs. RetainedPeers\n49|// and DroppedPeers name every configured peer exactly once; BlockingPeers is\n50|// empty on success and names the unenrolled peers on refusal.\n51|type V4Preview struct {\n52|\tSourceVersion    string\n53|\tSourceDocument   []byte\n54|\tSourceGeneration uint64\n55|\tCredentialID     string\n56|\tReplacement      []byte\n57|\tRetainedPeers    []string\n58|\tDroppedPeers     []string\n59|\tBlockingPeers    []string\n60|}\n61|\n62|// V4ApplyResult reports a durable Config-4 apply with the committed trust\n63|// generation that authorizes the new streams.\n64|type V4ApplyResult struct {\n65|\tMigration  MigrationResult\n66|\tGeneration uint64\n67|}\n68|\n69|// RollbackV4Options carries the explicit operator acknowledgement. Without\n70|// AcknowledgeNoHostChannelAssurance the rollback refuses: returning to a\n71|// legacy installation abandons Host Channel assurance, and that is never a\n72|// connection retry.\n73|type RollbackV4Options struct {\n74|\tAcknowledgeNoHostChannelAssurance bool\n75|\tBackupPath                        string\n76|}\n77|\n78|// PreviewV4 renders the exact Config-4 replacement for an explicit operator\n79|// decision. Migration is never first-connect behavior: the source must\n80|// already be Configuration 3.0.0 (older inputs first use the existing\n81|// explicit migrations), the selected credential must be actively enrolled for\n82|// the local host, and every retained peer must be completely enrolled\n83|// locally. The preview commits nothing.\n84|func PreviewV4(inputs Inputs, overrides Overrides, trust hosttrust.Snapshot, credentialID string, dropPeers []string, now time.Time) (V4Preview, error) {\n85|\tsnapshot, err := Load(inputs, overrides)\n86|\tif err != nil {\n87|\t\treturn V4Preview{}, err\n88|\t}\n89|\tloaded, decoded := snapshot.Configuration()\n90|\tif !snapshot.ConfigPresent() || !decoded {\n91|\t\treturn V4Preview{}, migrationError(MigrationError{Operation: \"load source\", Err: ErrMigrationSourceAbsent})\n92|\t}\n93|\tif loaded.SourceVersion != CurrentVersion {\n94|\t\treturn V4Preview{}, migrationError(MigrationError{Operation: \"select source\", Err: ErrMigrationV4Source})\n95|\t}\n96|\tpreview, err := renderV4Preview(snapshot.Document(), loaded.Value, trust, credentialID, dropPeers, now, inputs)\n97|\tif err != nil {\n98|\t\treturn preview, err\n99|\t}\n100|\treturn preview, nil\n101|}\n102|\n103|func renderV4Preview(document []byte, value Configuration, trust hosttrust.Snapshot, credentialID string, dropPeers []string, now time.Time, inputs Inputs) (V4Preview, error) {\n104|\tpreview := V4Preview{\n105|\t\tSourceVersion:    CurrentVersion,\n106|\t\tSourceDocument:   append([]byte(nil), document...),\n107|\t\tSourceGeneration: trust.Generation,\n108|\t\tCredentialID:     credentialID,\n109|\t}\n110|\tdigest, err := scalar.ParseDigest(credentialID)\n111|\tif err != nil {\n112|\t\treturn preview, migrationError(MigrationError{Operation: \"select credential\", Err: errors.Join(ErrMigrationV4Credential, err)})\n113|\t}\n114|\tlocal, found := findTrustEntry(trust, digest.String())\n115|\tif !found || local.HostID.String() != value.HostID || local.State != hosttrust.EntryActive {\n116|\t\treturn preview, migrationError(MigrationError{Operation: \"select credential\", Err: ErrMigrationV4Credential})\n117|\t}\n118|\tif err := checkCredentialWindow(local.LeafDER, local.RootDER, now); err != nil {\n119|\t\treturn preview, migrationError(MigrationError{Operation: \"select credential\", Err: errors.Join(ErrMigrationV4Credential, err)})\n120|\t}\n121|\tdropped := map[string]struct{}{}\n122|\tfor _, peer := range dropPeers {\n123|\t\tif _, exists := dropped[peer]; exists {\n124|\t\t\treturn preview, migrationError(MigrationError{Operation: \"select removals\", Err: ErrMigrationV4DropUnknown})\n125|\t\t}\n126|\t\tdropped[peer] = struct{}{}\n127|\t}\n128|\tvar retained []Peer\n129|\tfor _, peer := range value.Mesh.Peers {\n130|\t\tif _, remove := dropped[peer.HostID]; remove {\n131|\t\t\tpreview.DroppedPeers = append(preview.DroppedPeers, peer.HostID)\n132|\t\t\tcontinue\n133|\t\t}\n134|\t\tif _, remove := dropped[peer.Name]; remove {\n135|\t\t\treturn preview, migrationError(MigrationError{Operation: \"select removals\", Err: ErrMigrationV4DropUnknown})\n136|\t\t}\n137|\t\tpreview.RetainedPeers = append(preview.RetainedPeers, peer.HostID)\n138|\t\tretained = append(retained, peer)\n139|\t}\n140|\tfor peer := range dropped {\n141|\t\tknown := false\n142|\t\tfor _, candidate := range value.Mesh.Peers {\n143|\t\t\tif candidate.HostID == peer {\n144|\t\t\t\tknown = true\n145|\t\t\t\tbreak\n146|\t\t\t}\n147|\t\t}\n148|\t\tif !known {\n149|\t\t\treturn preview, migrationError(MigrationError{Operation: \"select removals\", Err: ErrMigrationV4DropUnknown})\n150|\t\t}\n151|\t}\n152|\tfor _, peer := range retained {\n153|\t\tif !peerEnrolled(trust, peer.HostID, now) {\n154|\t\t\tpreview.BlockingPeers = append(preview.BlockingPeers, peer.HostID)\n155|\t\t}\n156|\t}\n157|\tif len(preview.BlockingPeers) > 0 {\n158|\t\treturn preview, migrationError(MigrationError{Operation: \"validate peer enrollment\", Err: ErrMigrationV4PeerEnrollment})\n159|\t}\n160|\tnext := value\n161|\tnext.Mesh.Transport = TransportSSHTLS13\n162|\tnext.Mesh.HostChannel = &HostChannel{Version: HostChannelVersion, CredentialID: digest.String()}\n163|\tnext.Mesh.Peers = retained\n164|\tcontext := DecodeContext{RuntimePlatform: inputs.Platform, BackendSettings: inputs.BackendSettings}\n165|\treplacement, err := EncodeVersion4(next, context)\n166|\tif err != nil {\n167|\t\treturn preview, migrationError(MigrationError{Operation: \"encode target\", Err: err}) // config-refusal-subsumed: the preview pre-validates credential, enrollment, removals and source under the same context, so the v4 encoder admits only values its own clauses already accepted; any refusal here repeats a clause pinned above\n168|\t}\n169|\tpreview.Replacement = replacement\n170|\treturn preview, nil\n171|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
