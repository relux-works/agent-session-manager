{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c573","stream":{"kind":"session","id":"01a08946-5fbe-7830-b2e8-af2616179f48"},"sequence":276,"recorded_at":1780531400000547,"record_type":"event","durability":"durable","causation_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","run_stream":{"kind":"run","id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f"},"task_stream":{"kind":"task","id":"01a08946-d73a-7701-9c96-9631422ebdff"},"task_id":"01a08946-d73a-7701-9c96-9631422ebdff","event":{"kind":"output","task_id":"01a08946-d73a-7701-9c96-9631422ebdff","chunk":"Read text file `internal/hosttrust/authorize.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"errors\"\n6|\t\"fmt\"\n7|\t\"time\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// AuthRequest carries one dispatch or mutation-boundary authorization check.\n13|// SnapshotGeneration binds the stream to the coherent snapshot it was opened\n14|// under; LocalCredentialID and the remote DER bytes select the exact enrolled\n15|// entries; Allowlisted is the local mesh allowlist; HelloHostID is the\n16|// authenticated hello identity; ExpectedRemoteHostID is the selected\n17|// configured destination on the client.\n18|type AuthRequest struct {\n19|\tSnapshotGeneration   uint64\n20|\tLocalHostID          string\n21|\tLocalCredentialID    string\n22|\tRemoteLeafDER        []byte\n23|\tRemoteRootDER        []byte\n24|\tExpectedRemoteHostID string\n25|\tAllowlisted          []string\n26|\tHelloHostID          string\n27|\tNow                  time.Time\n28|}\n29|\n30|// Formatting an authorization request must never expose DER bytes, UUIDs,\n31|// digests or allowlists.\n32|func (AuthRequest) String() string   { return \"host channel authorization request\" }\n33|func (AuthRequest) GoString() string { return \"host channel authorization request\" }\n34|func (AuthRequest) Format(state fmt.State, verb rune) {\n35|\t_, _ = state.Write([]byte(\"host channel authorization request\"))\n36|}\n37|\n38|// Formatting a snapshot must never expose the entries it binds.\n39|func (Snapshot) String() string   { return \"host trust snapshot\" }\n40|func (Snapshot) GoString() string { return \"host trust snapshot\" }\n41|func (Snapshot) Format(state fmt.State, verb rune) {\n42|\t_, _ = state.Write([]byte(\"host trust snapshot\"))\n43|}\n44|\n45|// AuthorizeDispatch checks current generation, local credential validity,\n46|// allowlist membership and authenticated hello against one committed read\n47|// held under the shared authorization lock. The check observes a coherent\n48|// snapshot, but the dispatch itself runs after the lock releases, so the\n49|// caller must bind the admitted generation to the stream and enforce the\n50|// one-second invalidation on commit: re-check currency before sending, and\n51|// close stale-generation streams on watchdog, never on notifications alone.\n52|// Mutation side effects additionally require WithMutationAuthorization, which\n53|// holds the exclusive lock across the recheck and the boundary. Work prepared\n54|// under an old generation cannot gain new authority by refreshing a cached\n55|// number: a stale snapshot refuses.\n56|func (store *Store) AuthorizeDispatch(snapshot Snapshot, request AuthRequest) error {\n57|\tunlock, err := store.lock.shared()\n58|\tif err != nil {\n59|\t\treturn trustError(TrustError{Operation: \"authorize dispatch\", Err: errors.Join(ErrAuthorizationRefused, err)})\n60|\t}\n61|\tdefer unlock()\n62|\tcurrent, err := readCommitted(store)\n63|\tif err != nil {\n64|\t\treturn err\n65|\t}\n66|\t// The stream binding must match the snapshot it was opened under: work\n67|\t// prepared under an old generation cannot gain new authority by\n68|\t// refreshing a cached number.\n69|\tif request.SnapshotGeneration != snapshot.Generation {\n70|\t\treturn trustError(TrustError{Operation: \"authorize generation\", Err: ErrStaleGeneration})\n71|\t}\n72|\tif snapshot.Generation != current.Generation {\n73|\t\treturn trustError(TrustError{Operation: \"authorize generation\", Err: ErrStaleGeneration})\n74|\t}\n75|\treturn checkAuthorization(snapshot.Trust, request)\n76|}\n77|\n78|func readCommitted(store *Store) (TrustStore, error) {\n79|\tpath := store.TrustPath()\n80|\tinfo, err := store.fs.Lstat(path)\n81|\tif err != nil {\n82|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"authorize generation\", Err: errors.Join(ErrAuthorizationRefused, err)})\n83|\t}\n84|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n85|\t\treturn TrustStore{}, err\n86|\t}\n87|\tdocument, err := store.fs.ReadFile(path)\n88|\tif err != nil {\n89|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"authorize generation\", Err: errors.Join(ErrAuthorizationRefused, err)})\n90|\t}\n91|\tcommitted, err := DecodeTrust(document)\n92|\tif err != nil {\n93|\t\treturn TrustStore{}, err\n94|\t}\n95|\treturn committed, nil\n96|}\n97|\n98|func checkAuthorization(trust TrustStore, request AuthRequest) error {\n99|\tconst operation = \"authorize dispatch\"\n100|\tlocal, found := findEntry(trust, request.LocalCredentialID)\n101|\tif !found {\n102|\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n103|\t}\n104|\tif local.HostID.String() != request.LocalHostID || local.State != EntryActive {\n105|\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n106|\t}\n107|\tif err := VerifyProfile(local.LeafDER, local.RootDER, local.HostID.String(), request.Now); err != nil {\n108|\t\treturn trustError(TrustError{Operation: operation, Err: errors.Join(ErrAuthorizationRefused, err)})\n109|\t}\n110|\tremote, found := matchRemote(trust, request.RemoteLeafDER, request.RemoteRootDER)\n111|\tif !found {\n112|\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n113|\t}\n114|\tif err := VerifyProfile(remote.LeafDER, remote.RootDER, remote.HostID.String(), request.Now); err != nil {\n115|\t\treturn trustError(TrustError{Operation: operation, Err: errors.Join(ErrAuthorizationRefused, err)})\n116|\t}\n117|\tif remote.State == EntryRevoked {\n118|\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n119|\t}\n120|\tif remote.State == EntryRetiring {\n121|\t\tif remote.RetireAt == nil {\n122|\t\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n123|\t\t}\n124|\t\tretireAt, err := remote.RetireAt.Time()\n125|\t\tif err != nil || !request.Now.Before(retireAt) {\n126|\t\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n127|\t\t}\n128|\t}\n129|\tallowlisted := false\n130|\tfor _, hostID := range request.Allowlisted {\n131|\t\tif hostID == remote.HostID.String() {\n132|\t\t\tallowlisted = true\n133|\t\t\tbreak\n134|\t\t}\n135|\t}\n136|\tif !allowlisted {\n137|\t\treturn trustError(TrustError{Operation: operation, Err: ErrNotAllowlisted})\n138|\t}\n139|\tif request.HelloHostID != remote.HostID.String() || remote.HostID.String() != request.ExpectedRemoteHostID {\n140|\t\treturn trustError(TrustError{Operation: operation, Err: ErrHostIdentityMismatch})\n141|\t}\n142|\treturn nil\n143|}\n144|\n145|func findEntry(trust TrustStore, credentialID string) (CredentialEntry, bool) {\n146|\tfor _, entry := range trust.Entries {\n147|\t\tif entry.CredentialID.String() == credentialID {\n148|\t\t\treturn entry, true\n149|\t\t}\n150|\t}\n151|\treturn CredentialEntry{}, false\n152|}\n153|\n154|// matchRemote yields the verified UUID only on an exact leaf/root/SPKI match\n155|// against one currently admitted entry. Zero or multiple matches refuse; SAN\n156|// alone and CA membership alone are insufficient, which the byte-exact triple\n157|// comparison enforces structurally.\n158|func matchRemote(trust TrustStore, leafDER, rootDER []byte) (CredentialEntry, bool) {\n159|\tspki := spkiOf(leafDER)\n160|\tvar matched []CredentialEntry\n161|\tfor _, entry := range trust.Entries {\n162|\t\tif !bytes.Equal(entry.LeafDER, leafDER) || !bytes.Equal(entry.RootDER, rootDER) {\n163|\t\t\tcontinue\n164|\t\t}\n165|\t\tif spki == \"\" || entry.SPKIID.String() != spki {\n166|\t\t\tcontinue\n167|\t\t}\n168|\t\tmatched = append(matched, entry)\n169|\t}\n170|\tif len(matched) != 1 {\n171|\t\treturn CredentialEntry{}, false\n172|\t}\n173|\treturn matched[0], true\n174|}\n175|\n176|func spkiOf(leafDER []byte) string {\n177|\tder := mustSPKI(leafDER)\n178|\tif len(der) == 0 {\n179|\t\treturn \"\"\n180|\t}\n181|\treturn scalar.SHA256Digest(der).String()\n182|}\n183|\n184|// WithMutationAuthorization rechecks generation, credential validity,\n185|// allowlist membership and authenticated hello under the exclusive\n186|// authorization lock immediately before the externally visible side-effect\n187|// boundary, then runs the boundary while still holding the lock. The\n188|// generation check and the boundary serialize with revocation and config\n189|// commits. Boundaries must be bounded: long provider calls must not hold the\n190|// authorization lock across unbounded work.\n191|func (store *Store) WithMutationAuthorization(request AuthRequest, boundary func() error) error {\n192|\tunlock, err := store.lock.exclusive()\n193|\tif err != nil {\n194|\t\treturn trustError(TrustError{Operation: \"authorize mutation\", Err: errors.Join(ErrAuthorizationRefused, err)})\n195|\t}\n196|\tdefer unlock()\n197|\tcurrent, err := readCommitted(store)\n198|\tif err != nil {\n199|\t\treturn err\n200|\t}\n201|\tfresh := request\n202|\tfresh.SnapshotGeneration = current.Generation\n203|\tif err := checkAuthorization(current, fresh); err != nil {\n204|\t\treturn err\n205|\t}\n206|\tif boundary == nil {\n207|\t\treturn trustError(TrustError{Operation: \"authorize mutation\", Err: ErrAuthorizationRefused})\n208|\t}\n209|\treturn boundary()\n210|}","final_result":true}}}
