, err\n+\t}\n","edit_facts":{"tool_name":"edit_file","path":"internal/config/migration_v4_apply.go","added":9,"removed":14},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d6f9","stream":{"kind":"session","id":"01a08946-5fbe-7830-b2e8-af2616179f48"},"sequence":2519,"recorded_at":1780531400005033,"record_type":"event","durability":"durable","causation_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","run_stream":{"kind":"run","id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f"},"call_id":"call_01a0895288ba79309e182d7da116e7f2","text":"edited\nchanged lines: lines 272-273\n--- original\n+++ updated\n@@\n-// revalidateRollbackV4 repeats the rollback pins inside the joint\n-// transaction: the current document is still the pinned source, still\n+// restoreSourceAfterJointFailure converges a joint commit whose\n+// replacement is durable but whose generation bump failed: it restores the\n+// source bytes, then runs recovery (the restored source aborts the marker\n+// cleanly). A failed restore or a failed recovery keeps the marker for\n+// operator resolution and reports the compound failure, never silent\n+// success. The original commit error is always preserved for errors.Is.\n+func restoreSourceAfterJointFailure(filesystem migrationFileSystem, filename string, source []byte, store *hosttrust.Store, commitErr error) error {\n+\tif _, restoreErr := writeTempReplace(filesystem, filename, source); restoreErr != nil {\n+\t\treturn migrationError(MigrationError{Operation: \"recover source after trust commit\", Err: errors.Join(ErrMigrationSync, ErrMigrationRecovery, commitErr, restoreErr)})\n+\t}\n+\tif _, recoverErr := store.Recover(); recoverErr != nil {\n+\t\treturn migrationError(MigrationError{Operation: \"recover source after trust commit\", Err: errors.Join(ErrMigrationSync, ErrMigrationRecovery, commitErr, recoverErr)})\n+\t}\n+\treturn commitErr\n+}\n+\n+// revalidateRollbackV4 repeats the rollback pins inside the joint\n+// transaction: the current document is still the pinned source, still\n","edit_facts":{"tool_name":"edit_file","path":"internal/config/migration_v4_apply.go","added":18,"removed":2},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
