{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c567","stream":{"kind":"session","id":"01a08946-5fbe-7830-b2e8-af2616179f48"},"sequence":270,"recorded_at":1780531400000535,"record_type":"event","durability":"durable","causation_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","run_stream":{"kind":"run","id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f"},"task_stream":{"kind":"task","id":"01a08946-d777-7b12-84e1-b201077a84d4"},"task_id":"01a08946-d777-7b12-84e1-b201077a84d4","event":{"kind":"output","task_id":"01a08946-d777-7b12-84e1-b201077a84d4","chunk":"Read text file `internal/hosttrust/lock_unix.go`.\n1|//go:build darwin || linux\n2|\n3|package hosttrust\n4|\n5|import (\n6|\t\"errors\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\n10|\t\"golang.org/x/sys/unix\"\n11|)\n12|\n13|// fileLock is the machine-local cross-process authorization lock shared by\n14|// trust changes and Configuration 4.0.0 peer/credential changes. Readers hold\n15|// it shared; transactions hold it exclusive, so a revocation or config commit\n16|// can never land between a dispatch check and its side-effect boundary.\n17|type fileLock struct {\n18|\tfile *os.File\n19|}\n20|\n21|func openLock(filesystem FileSystem, path string) (*fileLock, error) {\n22|\tinfo, err := filesystem.Lstat(path)\n23|\tif err != nil {\n24|\t\tif !os.IsNotExist(err) {\n25|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n26|\t\t}\n27|\t\tstaged, err := filesystem.CreateTemp(filepath.Dir(path), \"lock-stage-*\", 0o600)\n28|\t\tif err != nil {\n29|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n30|\t\t}\n31|\t\tname := staged.Name()\n32|\t\t_ = staged.Close()\n33|\t\tif err := filesystem.Rename(name, path); err != nil {\n34|\t\t\t_ = filesystem.Remove(name)\n35|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n36|\t\t}\n37|\t\tif err := filesystem.Chmod(path, 0o600); err != nil {\n38|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n39|\t\t}\n40|\t\tinfo, err = filesystem.Lstat(path)\n41|\t\tif err != nil {\n42|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n43|\t\t}\n44|\t}\n45|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n46|\t\treturn nil, err\n47|\t}\n48|\t// O_NOFOLLOW refuses symlink escapes at open time; the descriptor never\n49|\t// follows a link swapped in after Lstat.\n50|\tfd, err := unix.Open(path, unix.O_RDWR|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)\n51|\tif err != nil {\n52|\t\tjoined := errors.Join(ErrTrustStoreUnreadable, err)\n53|\t\tif errors.Is(err, unix.ELOOP) {\n54|\t\t\tjoined = errors.Join(ErrTrustUnsafeCustody, err)\n55|\t\t}\n56|\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: joined})\n57|\t}\n58|\treturn &fileLock{file: os.NewFile(uintptr(fd), path)}, nil\n59|}\n60|\n61|func (lock *fileLock) shared() (func(), error) {\n62|\tif err := unix.Flock(int(lock.file.Fd()), unix.LOCK_SH); err != nil {\n63|\t\treturn nil, err\n64|\t}\n65|\treturn func() { _ = unix.Flock(int(lock.file.Fd()), unix.LOCK_UN) }, nil\n66|}\n67|\n68|func (lock *fileLock) exclusive() (func(), error) {\n69|\tif err := unix.Flock(int(lock.file.Fd()), unix.LOCK_EX); err != nil {\n70|\t\treturn nil, err\n71|\t}\n72|\treturn func() { _ = unix.Flock(int(lock.file.Fd()), unix.LOCK_UN) }, nil\n73|}","final_result":true}}}
