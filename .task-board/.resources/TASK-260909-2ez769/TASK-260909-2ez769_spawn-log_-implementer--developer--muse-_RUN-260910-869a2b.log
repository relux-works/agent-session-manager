{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d02b","stream":{"kind":"session","id":"01a08946-5fbe-7830-b2e8-af2616179f48"},"sequence":1648,"recorded_at":1780531400003291,"record_type":"event","durability":"durable","causation_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f","run_stream":{"kind":"run","id":"b6e8a9ed-35e9-4191-9a50-1dfe1ff8a38f"},"task_stream":{"kind":"task","id":"01a0894d-3250-7f02-8a25-7a0a34809f88"},"task_id":"01a0894d-3250-7f02-8a25-7a0a34809f88","event":{"kind":"output","task_id":"01a0894d-3250-7f02-8a25-7a0a34809f88","chunk":"Read text file `internal/hosttrust/transact.go`.\n(129 line(s) above)\n130|// caller already holds the exclusive authorization lock. Joint commits and\n131|// recovery use it to sequence the marker, the external replacement and the\n132|// bump under a single hold.\n133|func transactLocked(filesystem FileSystem, root string, fn TransactionFunc) error {\n134|\tcommitted, err := loadCommitted(filesystem, root)\n135|\tif err != nil {\n136|\t\treturn err\n137|\t}\n138|\tnext := committed\n139|\tnext.Entries = append([]CredentialEntry(nil), committed.Entries...)\n140|\tif err := fn(&next); err != nil {\n141|\t\treturn err\n142|\t}\n143|\tif next.Generation != committed.Generation {\n144|\t\treturn trustError(TrustError{Operation: \"commit generation\", Err: ErrTrustDurability})\n145|\t}\n146|\tif committed.Generation >= MaxGeneration {\n147|\t\treturn trustError(TrustError{Operation: \"commit generation\", Err: ErrGenerationExhausted})\n148|\t}\n149|\tnext.Generation = committed.Generation + 1\n150|\tencoded, err := EncodeTrust(next)\n151|\tif err != nil {\n152|\t\treturn err\n153|\t}\n154|\tdocument = encoded\n155|\tif err := commitDocument(filesystem, root, path, document); err != nil {\n156|\t\treturn err\n157|\t}\n158|\treturn nil\n159|}\n160|\n161|// commitDocument stages bytes in a temp file with fsync, atomically renames\n162|// over the target, and fsyncs the directory. On restart only the last fully\n163|// committed file is selected; staged files are ignored by every reader.\n164|func commitDocument(filesystem FileSystem, root, path string, document []byte) error {\n165|\tstaged, err := filesystem.CreateTemp(root, stagePrefix+\"*\", 0o600)\n166|\tif err != nil {\n167|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n168|\t}\n169|\tname := staged.Name()\n170|\tfailed := true\n171|\tdefer func() {\n172|\t\tif failed {\n173|\t\t\t_ = filesystem.Remove(name)\n174|\t\t}\n175|\t}()\n176|\tif err := writeAll(staged, document); err != nil {\n177|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n178|\t}\n179|\tif err := staged.Sync(); err != nil {\n180|\t\t_ = staged.Close()\n181|\t\treturn trustError(TrustError{Operation: \"sync trust\", Err: errors.Join(ErrTrustDurability, err)})\n182|\t}\n183|\tif err := staged.Close(); err != nil {\n184|\t\treturn trustError(TrustError{Operation: \"sync trust\", Err: errors.Join(ErrTrustDurability, err)})\n185|\t}\n186|\tif err := filesystem.Chmod(name, 0o600); err != nil {\n187|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n188|\t}\n189|\tif err := filesystem.Rename(name, path); err != nil {\n(more lines below)","final_result":true}}}
