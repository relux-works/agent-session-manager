ation.go-268-func (osMigrationFileSystem) CreateTemp(dir, pattern string) (migrationFile, error) {\\ninternal/config/migration.go-269-\\treturn os.CreateTemp(dir, pattern)\\ninternal/config/migration.go-270-}\\ninternal/config/migration.go-271-func (osMigrationFileSystem) Link(oldname, newname string) error   { return os.Link(oldname, newname) }\\n===\\ninternal/config/migration.go:290:func replaceDurably(filesystem migrationFileSystem, filename, backup string, original, replacement []byte) error {\\ninternal/config/migration.go-291-\\tdirectory := filepath.Dir(filename)\\ninternal/config/migration.go-292-\\t// Re-inspect the selected file before anything durable is written. Load\\ninternal/config/migration.go-293-\\t// resolved and validated it through the symlink-following read seam; this\\ninternal/config/migration.go-294-\\t// mutating seam does not follow symlinks, so a selected file that is not\\ninternal/config/migration.go-295-\\t// itself a regular file is refused here rather than after a backup has\\ninternal/config/migration.go-296-\\t// already been published. A refused migration therefore leaves the\\ninternal/config/migration.go-297-\\t// directory exactly as it found it, and the captured permission bits are\\ninternal/config/migration.go-298-\\t// the ones the replacement inherits.\\ninternal/config/migration.go-299-\\tinfo, err := filesystem.Stat(filename)\\ninternal/config/migration.go-300-\\tif err != nil {\\ninternal/config/migration.go-301-\\t\\treturn migrationError(MigrationError{Operation: \\\"inspect source mode\\\", Err: errors.Join(ErrMigrationWrite, err)})\\ninternal/config/migration.go-302-\\t}\\ninternal/config/migration.go-303-\\tif !info.Mode().IsRegular() {\\ninternal/config/migration.go-304-\\t\\treturn migrationError(MigrationError{Operation: \\\"inspect source mode\\\", Err: errors.Join(ErrMigrationWrite, ErrConfigNotRegular)})\\ninternal/config/migration.go-305-\\t}\\ninternal/config/migration.go-306-\\tbackupTemp, err := writeTempFile(filesystem, directory, \\\".ax-config-backup-*\\\", original, 0o600)\\ninternal/config/migration.go-307-\\tif err != nil {\\ninternal/config/migration.go-308-\\t\\treturn migrationError(MigrationError{Operation: \\\"write backup\\\", Err: errors.Join(ErrMigrationBackup, err)})\\ninternal/config/migration.go-309-\\t}\\ninternal/config/migration.go-310-\\tif err := filesystem.Link(backupTemp, backup); err != nil {\\ninternal/config/migration.go-311-\\t\\tif !errors.Is(err, fs.ErrExist) {\\ninternal/config/migration.go-312-\\t\\t\\t_ = filesystem.Remove(backupTemp)\\ninternal/config/migration.go-313-\\t\\t\\treturn migrationError(MigrationError{Operation: \\\"publish backup\\\", Err: errors.Join(ErrMigrationBackup, err)})\\ninternal/config/migration.go-314-\\t\\t}\\ninternal/config/migration.go-315-\\t\\texisting, readErr := filesystem.ReadFile(backup)\\ninternal/config/migration.go-316-\\t\\tinfo, statErr := filesystem.Stat(backup)\\ninternal/config/migration.go-317-\\t\\tif readErr != nil || statErr != nil || !bytes.Equal(existing, original) || info.Mode().Perm()&0o077 != 0 {\\ninternal/config/migration.go-318-\\t\\t\\t_ = filesystem.Remove(backupTemp)\\ninternal/config/migration.go-319-\\t\\t\\treturn migrationError(MigrationError{Operation: \\\"verify backup\\\", Err: ErrMigrationBackup})\\ninternal/config/migration.go-320-\\t\\t}\\n\",\n  \"original_output_bytes\": 4073,\n  \"original_output_tokens\": 1019,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
