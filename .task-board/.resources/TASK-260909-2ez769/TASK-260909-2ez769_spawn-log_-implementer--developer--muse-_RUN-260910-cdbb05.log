{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c63d","stream":{"kind":"session","id":"01a088f9-9dad-7333-94e3-2ac0c1a41f61"},"sequence":377,"recorded_at":1780531400000749,"record_type":"event","durability":"durable","causation_id":"13159623-fb5f-41dd-bf01-15d1fbadd837","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"13159623-fb5f-41dd-bf01-15d1fbadd837","run_stream":{"kind":"run","id":"13159623-fb5f-41dd-bf01-15d1fbadd837"},"task_stream":{"kind":"task","id":"01a088fa-d087-7372-ab4c-a59a19fa8dda"},"task_id":"01a088fa-d087-7372-ab4c-a59a19fa8dda","event":{"kind":"output","task_id":"01a088fa-d087-7372-ab4c-a59a19fa8dda","chunk":"{\n  \"chunk_id\": \"exec-13-1\",\n  \"command\": \"task-board worktree refresh-candidate --help 2>&1 | head -n 40\\necho \\\"===STATUS===\\\"\\ntask-board worktree status 2>&1 | head -c 4000\",\n  \"description\": \"Check refresh-candidate usage and status\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Explicit recovery for a final leaf whose checkpoint diverged from current trunk.\\nRequires a live tracked producer for the initial or rework leaf and its exclusive Story lease.\\nAn initial leaf must provably have no CR; unknown or corrupt CR reads refuse.\\nThe complete working candidate is preserved exactly; incoming content must already\\nhave been combined by its producer. Staged changes and pending reviews refuse.\\nCheckpoints are replayed with signing in an isolated workspace. Durable intent\\nallows retry after branch, index or metadata interruption. Recovery never accepts\\na candidate: normal producer handoff and independent review are still required.\\nFor a regular-file conflict, prepare --replay-resolutions from the retained\\nreplay worktree parent directory resolution-template.json. Bind each resolution to REBASE_HEAD,\\nits unmerged path and the SHA-256 of the explicit replacement content. The tool\\nreplays from the unchanged original checkpoints and signs continuation; never\\nhand-commit the retained replay or edit workspace registry records.\\n\\nUsage:\\n  task-board worktree refresh-candidate <ELEMENT-ID> [flags]\\n\\nFlags:\\n  -h, --help                        help for refresh-candidate\\n      --replay-resolutions string   JSON file of checkpoint-bound conflict resolutions\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n===STATUS===\\nSTORY-260830-1i3qu7  active\\n  path:       .temp/STORY-260830-1i3qu7/worktree (present)\\n  branch:     task-board/story/STORY-260830-1i3qu7 (present)\\n  base:       main\\n  tip:        7f90e5858cd8346228f7aa687252266f1c133244\\n  tree:       dirty\\n  blocked:    managed worktree has uncommitted or untracked changes\\n  change-req: TASK-260830-2ciy0s rev 3 checkpointed (repository_delta=present, 35 changed path(s))\\n  change-req: TASK-260830-2uowwk rev 2 accepted (repository_delta=present, 60 changed path(s))\\n  change-req: TASK-260830-7a0s2c rev 3 checkpointed (repository_delta=present, 19 changed path(s))\\nSTORY-260830-1kiyj6  active\\n  path:       .temp/STORY-260830-1kiyj6/worktree (present)\\n  branch:     task-board/story/STORY-260830-1kiyj6 (present)\\n  base:       main\\n  tip:        c1eff016dce2e55c4e2c1828d5c20f3da84118bc\\n  tree:       dirty\\n  lease:      held by RUN-260910-cdbb05\\n  blocked:    story lease is held by run RUN-260910-cdbb05\\n  blocked:    managed worktree has uncommitted or untracked changes\\n  change-req: TASK-260830-1tvg8e rev 1 checkpointed (repository_delta=present, 13 changed path(s))\\n  change-req: TASK-260830-2u34k1 rev 1 checkpointed (repository_delta=present, 12 changed path(s))\\n  change-req: TASK-260909-2ez769 rev 1 changes_requested (repository_delta=present, 40 changed path(s))\\nSTORY-260830-2dy8oj  active\\n  path:       .temp/STORY-260830-2dy8oj/worktree (missing)\\n  branch:     task-board/story/STORY-260830-2dy8oj (present)\\n  base:       main\\n  tip:        81305c8886ead674122f498ad2124051257c9467\\n  tree:       not checked out\\n  change-req: TASK-260830-3amrl9 rev 8 checkpointed (repository_delta=present, 14 changed path(s))\\n  change-req: TASK-260830-3ps1b1 rev 6 checkpointed (repository_delta=present, 19 changed path(s))\\nSTORY-260830-2jylym  active\\n  path:       .temp/STORY-260830-2jylym/worktree (missing)\\n  branch:     task-board/story/STORY-260830-2jylym (present)\\n  base:       main\\n  tip:        adca16af03663682ec57993122c22c667813afc9\\n  tree:       not checked out\\n  change-req: TASK-260830-1bipsa rev 1 checkpointed (repository_delta=empty, 0 changed path(s))\\n  change-req: TASK-260830-33sfxc rev 7 accepted (repository_delta=present, 73 changed path(s))\\n  change-req: TASK-260830-34elja rev 2 checkpointed (repository_delta=empty, 0 changed path(s))\\nSTORY-260830-2wdm5e  active\\n  path:       .temp/STORY-260830-2wdm5e/worktree (missing)\\n  branch:     task-board/story/STORY-260830-2wdm5e (present)\\n  base:       main\\n  tip:        ad7275181ca82fc3fa29544e3893923a92d7b9d5\\n  tree:       not checked out\\n  change-req: TASK-260830-1pbx0c rev 6 checkpointed (repository_delta=present, 12 changed path(s))\\n  change-req: TASK-260830-236x9n rev 5 checkpointed (repository_delta=present, 19 changed path(s))\\n  change-req: TASK-260830-8x76g1 rev 16 accepted (repository_delta=present, 71 changed path(s))\\nSTORY-260830-323tpq  active\\n  path:   