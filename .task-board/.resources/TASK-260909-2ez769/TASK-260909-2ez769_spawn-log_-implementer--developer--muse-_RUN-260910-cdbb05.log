{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5ff","stream":{"kind":"session","id":"01a088f9-9dad-7333-94e3-2ac0c1a41f61"},"sequence":346,"recorded_at":1780531400000687,"record_type":"event","durability":"durable","causation_id":"13159623-fb5f-41dd-bf01-15d1fbadd837","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"13159623-fb5f-41dd-bf01-15d1fbadd837","run_stream":{"kind":"run","id":"13159623-fb5f-41dd-bf01-15d1fbadd837"},"task_stream":{"kind":"task","id":"01a088fa-c4af-7f73-9e77-b61b2df54cd8"},"task_id":"01a088fa-c4af-7f73-9e77-b61b2df54cd8","event":{"kind":"output","task_id":"01a088fa-c4af-7f73-9e77-b61b2df54cd8","chunk":"{\n  \"chunk_id\": \"exec-12-1\",\n  \"command\": \"task-board worktree --help 2>&1 | head -n 60\\necho \\\"===STORY STATE===\\\"\\ntask-board q 'get(\\\"STORY-260830-1kiyj6\\\") { full }' 2>&1 | python3 -c \\\"import json,sys; raw=sys.stdin.read(); d=json.loads(raw); print(json.dumps({k:d.get(k) for k in ['id','name','status','children','notes']}, indent=1)[:6000])\\\"\",\n  \"description\": \"Inspect worktree commands and story state\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Inspect and repair the Story-scoped Git workspaces that repository-mutating\\nspawns run in.\\n\\nEach Story gets one managed worktree under .temp/<STORY-ID>/worktree on a\\nshort-lived task-board/story/<STORY-ID> branch forked from trunk. Trunk is\\nspawn.worktree_isolation.integration_base_branch when configured, and otherwise\\nresolves from refs/remotes/origin/HEAD and then the current branch.\\n\\nThese commands require a local authoritative board. On a remote board they\\nrefuse with worktree_isolation_requires_local_board and do nothing else.\\n\\nUsage:\\n  task-board worktree [command]\\n\\nAvailable Commands:\\n  abort                 Stop using a Story workspace, preserving its work by default\\n  checkpoint            Commit an accepted leaf onto its Story branch while preserving integrating\\n  complete              Prove an accepted Story's code landed on its own repository, then record its board state in the board repository\\n  gc                    Release Story leases whose holding runs are provably terminal\\n  integrate             Land an accepted Story candidate on trunk and commit its board state\\n  invalidate-acceptance Release an element whose acceptance §6.2 already invalidated back to rework\\n  prepare-landed-review Export a signed current-default tree for a new producer handoff and exact-tree review\\n  refresh-candidate     Refresh an initial or rework candidate base without losing uncommitted files\\n  repair                Re-materialize a recorded workspace whose worktree is missing\\n  start-landed-rework   Reprove a landed-review export and durably authorize normal producer rework\\n  status                Report managed Story workspaces and what blocks their cleanup\\n  transaction           Inspect and dispose of a refused or abandoned integration transaction\\n\\nFlags:\\n  -h, --help   help for worktree\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\\nUse \\\"task-board worktree [command] --help\\\" for more information about a command.\\n===STORY STATE===\\n{\\n \\\"id\\\": \\\"STORY-260830-1kiyj6\\\",\\n \\\"name\\\": \\\"peer-configuration-and-authentication\\\",\\n \\\"status\\\": \\\"development\\\",\\n \\\"children\\\": [\\n  \\\"TASK-260830-1tvg8e\\\",\\n  \\\"TASK-260830-2u34k1\\\",\\n  \\\"TASK-260830-2x16gz\\\",\\n  \\\"TASK-260830-z1yxg9\\\",\\n  \\\"TASK-260909-2ez769\\\"\\n ],\\n \\\"notes\\\": \\\"\\\"\\n}\\n\",\n  \"original_output_bytes\": 2783,\n  \"original_output_tokens\": 696,\n  \"truncated\": false\n}","final_result":true}}}
