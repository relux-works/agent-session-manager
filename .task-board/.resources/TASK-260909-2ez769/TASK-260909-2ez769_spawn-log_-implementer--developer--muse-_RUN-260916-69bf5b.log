{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c785","stream":{"kind":"session","id":"01a0aba9-d1ff-7602-bf9f-32a3aa09bb6c"},"sequence":541,"recorded_at":1780531400001077,"record_type":"event","durability":"durable","causation_id":"e6495f39-5100-411c-852e-b85f9d8475b0","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e6495f39-5100-411c-852e-b85f9d8475b0","run_stream":{"kind":"run","id":"e6495f39-5100-411c-852e-b85f9d8475b0"},"call_id":"call_01a0abadfaf07068b50c5f4e84b62839","text":"Read text file `internal/hosttrust/transact.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|)\n8|\n9|// Snapshot is one coherent committed read: trust bytes plus the generation\n10|// that authorized them. Streams and dispatches bind this generation; any use\n11|// must re-check currency before crossing a side-effect boundary.\n12|type Snapshot struct {\n13|\tGeneration uint64\n14|\tTrust      TrustStore\n15|}\n16|\n17|// TransactionFunc mutates a copy of the committed trust. Returning nil\n18|// commits with generation+1; returning an error aborts with no durable effect.\n19|type TransactionFunc func(trust *TrustStore) error\n20|\n21|// ReadSnapshot obtains one coherent committed snapshot under a shared lock.\n22|// A missing store is ErrTrustStoreMissing, never an empty store. Unreadable,\n23|// malformed or partially read state refuses; leftover staging files from\n24|// crashed commits are ignored and never selected.\n25|func (store *Store) ReadSnapshot() (Snapshot, error) {\n26|\treturn readSnapshot(store.fs, store.root, store.lock)\n27|}\n28|\n29|// WithSharedSnapshot runs fn under the authorization lock with the\n30|// committed trust, so a config-plus-trust pair observed inside fn is\n31|// coherent: no trust or config commit can land between the trust read and\n32|// fn's own reads. Pending joint intent converges before fn runs, so a\n33|// surviving process observes the same converged pair as a reopened store.\n34|// Callers must not acquire the lock again inside fn; internal reads there\n35|// use the supplied committed value directly.\n36|func (store *Store) WithSharedSnapshot(fn func(current TrustStore) error) error {\n37|\tunlock, err := lockForConvergedRead(store.fs, store.root, store.lock)\n38|\tif err != nil {\n39|\t\treturn err\n40|\t}\n41|\tdefer unlock()\n42|\tsnapshot, err := readSnapshotLocked(store.fs, store.root)\n43|\tif err != nil {\n44|\t\treturn err\n45|\t}\n46|\tcommitted := snapshot.Trust\n47|\tif fn == nil {\n48|\t\treturn trustError(TrustError{Operation: \"read snapshot\", Err: ErrAuthorizationRefused})\n49|\t}\n50|\treturn fn(committed)\n51|}\n52|\n53|func readSnapshot(filesystem FileSystem, root string, lock *fileLock) (Snapshot, error) {\n54|\tunlock, err := lockForConvergedRead(filesystem, root, lock)\n55|\tif err != nil {\n56|\t\treturn Snapshot{}, err\n57|\t}\n58|\tdefer unlock()\n59|\treturn readSnapshotLocked(filesystem, root)\n60|}\n61|\n62|// lockForConvergedRead holds the authorization lock for one coherent read,\n63|// converging pending joint intent first. The fast path keeps the shared\n64|// lock when no marker is present: staging a marker needs the exclusive\n65|// lock, so absence observed under shared hold still holds at the read.\n66|// When a marker is present the shared lock is released before the\n67|// exclusive lock is acquired (a held shared lock can never upgrade in\n68|// place without risking a cross-process upgrade deadlock), the leftover\n69|// converges or refuses, and the read proceeds under the exclusive hold.\n70|// Convergence may move the generation forward; callers compare request\n71|// bindings against the converged read, never by refreshing a stale number.\n72|func lockForConvergedRead(filesystem FileSystem, root string, lock *fileLock) (func(), error) {\n73|\tunlock, err := lock.shared()\n74|\tif err != nil {\n75|\t\treturn nil, trustError(TrustError{Operation: \"lock snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n76|\t}\n77|\tpresent, err := markerPresent(filesystem, root)\n78|\tif err != nil {\n79|\t\tunlock()\n80|\t\treturn nil, err\n81|\t}\n82|\tif !present {\n83|\t\treturn unlock, nil\n84|\t}\n85|\tunlock()\n86|\tunlock, err = lock.exclusive()\n87|\tif err != nil {\n88|\t\treturn nil, trustError(TrustError{Operation: \"lock snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n89|\t}\n90|\tif err := convergeLocked(filesystem, root); err != nil {\n91|\t\tunlock()\n92|\t\treturn nil, err\n93|\t}\n94|\treturn unlock, nil\n95|}\n96|\n97|// readSnapshotLocked reads one coherent committed snapshot assuming the\n98|// caller already holds the authorization lock and has converged pending\n99|// joint intent (see lockForConvergedRead): reading beside an unresolved\n100|// marker would admit a superseded generation with replaced configuration.\n101|func readSnapshotLocked(filesystem FileSystem, root string) (Snapshot, error) {\n102|\tpath := filepath.Join(root, trustFileName)\n103|\tinfo, err := filesystem.Lstat(path)\n104|\tif err != nil {\n105|\t\tif os.IsNotExist(err) {\n106|\t\t\treturn Snapshot{}, trustError(TrustError{Operation: \"read snapshot\", Err: ErrTrustStoreMissing})\n107|\t\t}\n108|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"read snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n109|\t}\n110|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n111|\t\treturn Snapshot{}, err\n112|\t}\n113|\tdocument, err := filesystem.ReadFile(path)\n114|\tif err != nil {\n115|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"read snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n116|\t}\n117|\tstore, err := DecodeTrust(document)\n118|\tif err != nil {\n119|\t\treturn Snapshot{}, err\n120|\t}\n121|\treturn Snapshot{Generation: store.Generation, Trust: store}, nil\n122|}\n123|\n124|// Initialize creates the explicit empty generation-1 store. It refuses when\n125|// trust.json already exists: setup never overwrites committed authority.\n126|// Pending joint intent converges first, so setup never builds beside an\n127|// unresolved marker.\n128|func (store *Store) Initialize() (Snapshot, error) {\n129|\tunlock, err := store.lock.exclusive()\n130|\tif err != nil {\n131|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"lock initialize\", Err: errors.Join(ErrTrustDurability, err)})\n132|\t}\n133|\tdefer unlock()\n134|\tif err := convergeLocked(store.fs, store.root); err != nil {\n135|\t\treturn Snapshot{}, err\n136|\t}\n137|\tpath := filepath.Join(store.root, trustFileName)\n138|\tif _, err := store.fs.Lstat(path); err == nil {\n139|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"initialize store\", Err: ErrTrustDurability})\n140|\t} else if !os.IsNotExist(err) {\n141|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"initialize store\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n142|\t}\n143|\tdocument, err := EncodeTrust(TrustStore{Generation: 1})\n144|\tif err != nil {\n145|\t\treturn Snapshot{}, err\n146|\t}\n147|\tif err := commitDocument(store.fs, store.root, path, document); err != nil {\n148|\t\treturn Snapshot{}, err\n149|\t}\n150|\t// The exclusive lock is still held: read without re-acquiring, since a\n151|\t// second acquisition in this goroutine would block on the held lock.\n152|\treturn readSnapshotLocked(store.fs, store.root)\n153|}\n154|\n155|// transact runs one crash-durable generation transaction under the exclusive\n156|// cross-process lock: load committed state, apply fn, encode, stage with\n157|// fsync, atomic rename, directory fsync. A missing store refuses with\n158|// ErrTrustStoreMissing: only explicit Initialize commits generation 1. Any\n159|// other malformed state refuses before fn runs.\n160|func (store *Store) transact(fn TransactionFunc) error {\n161|\treturn transact(store.fs, store.root, store.lock, fn)\n162|}\n163|\n164|func transact(filesystem FileSystem, root string, lock *fileLock, fn TransactionFunc) error {\n165|\tunlock, err := lock.exclusive()\n166|\tif err != nil {\n167|\t\treturn trustError(TrustError{Operation: \"lock transaction\", Err: errors.Join(ErrTrustDurability, err)})\n168|\t}\n169|\tdefer unlock()\n170|\tif err := convergeLocked(filesystem, root); err != nil {\n171|\t\treturn err\n172|\t}\n173|\treturn transactLocked(filesystem, root, fn)\n174|}\n175|\n176|// transactLocked runs one crash-durable generation transaction assuming the\n177|// caller already holds the exclusive authorization lock. Joint commits and\n178|// recovery use it to sequence the marker, the external replacement and the\n179|// bump under a single hold.\n180|func transactLocked(filesystem FileSystem, root string, fn TransactionFunc) error {\n181|\tcommitted, err := loadCommitted(filesystem, root)\n182|\tif err != nil {\n183|\t\treturn err\n184|\t}\n185|\tnext := committed\n186|\tnext.Entries = append([]CredentialEntry(nil), committed.Entries...)\n187|\tif err := fn(&next); err != nil {\n188|\t\treturn err\n189|\t}\n190|\tif next.Generation != committed.Generation {\n191|\t\treturn trustError(TrustError{Operation: \"commit generation\", Err: ErrTrustDurability})\n192|\t}\n193|\tif committed.Generation >= MaxGeneration {\n194|\t\treturn trustError(TrustError{Operation: \"commit generation\", Err: ErrGenerationExhausted})\n195|\t}\n196|\tnext.Generation = committed.Generation + 1\n197|\tencoded, err := EncodeTrust(next)\n198|\tif err != nil {\n199|\t\treturn err\n200|\t}\n201|\tif err := commitDocument(filesystem, root, filepath.Join(root, trustFileName), encoded); err != nil {\n202|\t\treturn err\n203|\t}\n204|\treturn nil\n205|}\n206|\n207|// loadCommitted reads the committed trust without acquiring the lock: the\n208|// caller must already hold the authorization lock, and (outside recovery\n209|// itself) must have converged pending joint intent first.\n210|func loadCommitted(filesystem FileSystem, root string) (TrustStore, error) {\n211|\tpath := filepath.Join(root, trustFileName)\n212|\tinfo, err := filesystem.Lstat(path)\n213|\tif err != nil {\n214|\t\tif os.IsNotExist(err) {\n215|\t\t\treturn TrustStore{}, trustError(TrustError{Operation: \"read committed trust\", Err: ErrTrustStoreMissing})\n216|\t\t}\n217|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"read committed trust\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n218|\t}\n219|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n220|\t\treturn TrustStore{}, err\n221|\t}\n222|\tdocument, err := filesystem.ReadFile(path)\n223|\tif err != nil {\n224|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"read committed trust\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n225|\t}\n226|\tdecoded, err := DecodeTrust(document)\n227|\tif err != nil {\n228|\t\treturn TrustStore{}, err\n229|\t}\n230|\treturn decoded, nil\n231|}\n232|\n233|// commitDocument stages bytes in a temp file with fsync, atomically renames\n234|// over the target, and fsyncs the directory. On restart only the last fully\n235|// committed file is selected; staged files are ignored by every reader.\n236|func commitDocument(filesystem FileSystem, root, path string, document []byte) error {\n237|\tstaged, err := filesystem.CreateTemp(root, stagePrefix+\"*\", 0o600)\n238|\tif err != nil {\n239|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n240|\t}\n241|\tname := staged.Name()\n242|\tfailed := true\n243|\tdefer func() {\n244|\t\tif failed {\n245|\t\t\t_ = filesystem.Remove(name)\n246|\t\t}\n247|\t}()\n248|\tif err := writeAll(staged, document); err != nil {\n249|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n250|\t}\n251|\tif err := staged.Sync(); err != nil {\n252|\t\t_ = staged.Close()\n253|\t\treturn trustError(TrustError{Operation: \"sync trust\", Err: errors.Join(ErrTrustDurability, err)})\n254|\t}\n255|\tif err := staged.Close(); err != nil {\n256|\t\treturn trustError(TrustError{Operation: \"sync trust\", Err: errors.Join(ErrTrustDurability, err)})\n257|\t}\n258|\tif err := filesystem.Chmod(name, 0o600); err != nil {\n259|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n260|\t}\n261|\t// On platforms where mode bits do not govern access, install the\n262|\t// owner-only ACL before the staging file becomes visible under load.\n263|\tif err := secureStaged(name, false); err != nil {\n264|\t\treturn err\n265|\t}\n266|\tif err := filesystem.Rename(name, path); err != nil {\n267|\t\treturn trustError(TrustError{Operation: \"replace trust\", Err: errors.Join(ErrTrustDurability, err)})\n268|\t}\n269|\tif err := syncDir(filesystem, root); err != nil {\n270|\t\treturn trustError(TrustError{Operation: \"sync trust directory\", Err: errors.Join(ErrTrustDurability, err)})\n271|\t}\n272|\tfailed = false\n273|\treturn nil\n274|}\n275|\n276|func writeAll(writer interface{ Write([]byte) (int, error) }, document []byte) error {\n277|\tfor len(document) > 0 {\n278|\t\twritten, err := writer.Write(document)\n279|\t\tif err != nil {\n280|\t\t\treturn err\n281|\t\t}\n282|\t\tif written == 0 {\n283|\t\t\treturn errors.New(\"short trust write\")\n284|\t\t}\n285|\t\tdocument = document[written:]\n286|\t}\n287|\treturn nil\n288|}\n289|\n290|func syncDir(filesystem FileSystem, root string) error {\n291|\thandle, err := filesystem.OpenDirectory(root)\n292|\tif err != nil {\n293|\t\treturn err\n294|\t}\n295|\tif err := handle.Sync(); err != nil {\n296|\t\t_ = handle.Close()\n297|\t\treturn err\n298|\t}\n299|\treturn handle.Close()\n300|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c787","stream":{"kind":"session","id":"01a0aba9-d1ff-7602-bf9f-32a3aa09bb6c"},"sequence":542,"recorded_at":1780531400001079,"record_type":"event","durability":"durable","causation_id":"e6495f39-5100-411c-852e-b85f9d8475b0","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e6495f39-5100-411c-852e-b85f9d8475b0","run_stream":{"kind":"run","id":"e6495f39-5100-411c-852e-b85f9d8475b0"},"call_id":"call_01a0abadfc6e76ea9bd2043507723208","text":"Read text file `internal/hosttrust/authorize.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"errors\"\n6|\t\"fmt\"\n7|\t\"time\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// AuthRequest carries one dispatch or mutation-boundary authorization check.\n13|// SnapshotGeneration binds the stream to the coherent snapshot it was opened\n14|// under; LocalCredentialID and the remote DER bytes select the exact enrolled\n15|// entries; Allowlisted is the local mesh allowlist; HelloHostID is the\n16|// authenticated hello identity; ExpectedRemoteHostID is the selected\n17|// configured destination on the client.\n18|type AuthRequest struct {\n19|\tSnapshotGeneration   uint64\n20|\tLocalHostID          string\n21|\tLocalCredentialID    string\n22|\tRemoteLeafDER        []byte\n23|\tRemoteRootDER        []byte\n24|\tExpectedRemoteHostID string\n25|\tAllowlisted          []string\n26|\tHelloHostID          string\n27|\tNow                  time.Time\n28|}\n29|\n30|// Formatting an authorization request must never expose DER bytes, UUIDs,\n31|// digests or allowlists.\n32|func (AuthRequest) String() string   { return \"host channel authorization request\" }\n33|func (AuthRequest) GoString() string { return \"host channel authorization request\" }\n34|func (AuthRequest) Format(state fmt.State, verb rune) {\n35|\t_, _ = state.Write([]byte(\"host channel authorization request\"))\n36|}\n37|\n38|// Formatting a snapshot must never expose the entries it binds.\n39|func (Snapshot) String() string   { return \"host trust snapshot\" }\n40|func (Snapshot) GoString() string { return \"host trust snapshot\" }\n41|func (Snapshot) Format(state fmt.State, verb rune) {\n42|\t_, _ = state.Write([]byte(\"host trust snapshot\"))\n43|}\n44|\n45|// AuthorizeDispatch checks current generation, local credential validity,\n46|// allowlist membership and authenticated hello against one committed read\n47|// held under the shared authorization lock. The check observes a coherent\n48|// snapshot, but the dispatch itself runs after the lock releases, so the\n49|// caller must bind the admitted generation to the stream and enforce the\n50|// one-second invalidation on commit: re-check currency before sending, and\n51|// close stale-generation streams on watchdog, never on notifications alone.\n52|// Mutation side effects additionally require WithMutationAuthorization, which\n53|// holds the exclusive lock across the recheck and the boundary. Work prepared\n54|// under an old generation cannot gain new authority by refreshing a cached\n55|// number: a stale snapshot refuses.\n56|func (store *Store) AuthorizeDispatch(snapshot Snapshot, request AuthRequest) error {\n57|\t// Pending joint intent converges before the currency check, so a\n58|\t// dispatch bound before a crash compares against the recovered\n59|\t// generation and refuses stale instead of admitting superseded trust.\n60|\t// Convergence failures name their own operation and pass through: a\n61|\t// refused recovery is a durability event, not an authorization verdict.\n62|\tunlock, err := lockForConvergedRead(store.fs, store.root, store.lock)\n63|\tif err != nil {\n64|\t\treturn err\n65|\t}\n66|\tdefer unlock()\n67|\tcurrent, err := readCommitted(store)\n68|\tif err != nil {\n69|\t\treturn err\n70|\t}\n71|\t// The stream binding must match the snapshot it was opened under: work\n72|\t// prepared under an old generation cannot gain new authority by\n73|\t// refreshing a cached number.\n74|\tif request.SnapshotGeneration != snapshot.Generation {\n75|\t\treturn trustError(TrustError{Operation: \"authorize generation\", Err: ErrStaleGeneration})\n76|\t}\n77|\tif snapshot.Generation != current.Generation {\n78|\t\treturn trustError(TrustError{Operation: \"authorize generation\", Err: ErrStaleGeneration})\n79|\t}\n80|\treturn checkAuthorization(snapshot.Trust, request)\n81|}\n82|\n83|// readCommitted reads the committed trust without acquiring the lock: the\n84|// caller must already hold the authorization lock and have converged\n85|// pending joint intent, so the read nests safely inside a holder instead\n86|// of blocking on it.\n87|func readCommitted(store *Store) (TrustStore, error) {\n88|\tpath := store.TrustPath()\n89|\tinfo, err := store.fs.Lstat(path)\n90|\tif err != nil {\n91|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"authorize generation\", Err: errors.Join(ErrAuthorizationRefused, err)})\n92|\t}\n93|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n94|\t\treturn TrustStore{}, err\n95|\t}\n96|\tdocument, err := store.fs.ReadFile(path)\n97|\tif err != nil {\n98|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"authorize generation\", Err: errors.Join(ErrAuthorizationRefused, err)})\n99|\t}\n100|\tcommitted, err := DecodeTrust(document)\n101|\tif err != nil {\n102|\t\treturn TrustStore{}, err\n103|\t}\n104|\treturn committed, nil\n105|}\n106|\n107|func checkAuthorization(trust TrustStore, request AuthRequest) error {\n108|\tconst operation = \"authorize dispatch\"\n109|\tlocal, found := findEntry(trust, request.LocalCredentialID)\n110|\tif !found {\n111|\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n112|\t}\n113|\tif local.HostID.String() != request.LocalHostID || local.State != EntryActive {\n114|\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n115|\t}\n116|\tif err := VerifyProfile(local.LeafDER, local.RootDER, local.HostID.String(), request.Now); err != nil {\n117|\t\treturn trustError(TrustError{Operation: operation, Err: errors.Join(ErrAuthorizationRefused, err)})\n118|\t}\n119|\tremote, found := matchRemote(trust, request.RemoteLeafDER, request.RemoteRootDER)\n120|\tif !found {\n121|\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n122|\t}\n123|\tif err := VerifyProfile(remote.LeafDER, remote.RootDER, remote.HostID.String(), request.Now); err != nil {\n124|\t\treturn trustError(TrustError{Operation: operation, Err: errors.Join(ErrAuthorizationRefused, err)})\n125|\t}\n126|\tif remote.State == EntryRevoked {\n127|\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n128|\t}\n129|\tif remote.State == EntryRetiring {\n130|\t\tif remote.RetireAt == nil {\n131|\t\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n132|\t\t}\n133|\t\tretireAt, err := remote.RetireAt.Time()\n134|\t\tif err != nil || !request.Now.Before(retireAt) {\n135|\t\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n136|\t\t}\n137|\t}\n138|\tallowlisted := false\n139|\tfor _, hostID := range request.Allowlisted {\n140|\t\tif hostID == remote.HostID.String() {\n141|\t\t\tallowlisted = true\n142|\t\t\tbreak\n143|\t\t}\n144|\t}\n145|\tif !allowlisted {\n146|\t\treturn trustError(TrustError{Operation: operation, Err: ErrNotAllowlisted})\n147|\t}\n148|\tif request.HelloHostID != remote.HostID.String() || remote.HostID.String() != request.ExpectedRemoteHostID {\n149|\t\treturn trustError(TrustError{Operation: operation, Err: ErrHostIdentityMismatch})\n150|\t}\n151|\treturn nil\n152|}\n153|\n154|func findEntry(trust TrustStore, credentialID string) (CredentialEntry, bool) {\n155|\tfor _, entry := range trust.Entries {\n156|\t\tif entry.CredentialID.String() == credentialID {\n157|\t\t\treturn entry, true\n158|\t\t}\n159|\t}\n160|\treturn CredentialEntry{}, false\n161|}\n162|\n163|// matchRemote yields the verified UUID only on an exact leaf/root/SPKI match\n164|// against one currently admitted entry. Zero or multiple matches refuse; SAN\n165|// alone and CA membership alone are insufficient, which the byte-exact triple\n166|// comparison enforces structurally.\n167|func matchRemote(trust TrustStore, leafDER, rootDER []byte) (CredentialEntry, bool) {\n168|\tspki := spkiOf(leafDER)\n169|\tvar matched []CredentialEntry\n170|\tfor _, entry := range trust.Entries {\n171|\t\tif !bytes.Equal(entry.LeafDER, leafDER) || !bytes.Equal(entry.RootDER, rootDER) {\n172|\t\t\tcontinue\n173|\t\t}\n174|\t\tif spki == \"\" || entry.SPKIID.String() != spki {\n175|\t\t\tcontinue\n176|\t\t}\n177|\t\tmatched = append(matched, entry)\n178|\t}\n179|\tif len(matched) != 1 {\n180|\t\treturn CredentialEntry{}, false\n181|\t}\n182|\treturn matched[0], true\n183|}\n184|\n185|func spkiOf(leafDER []byte) string {\n186|\tder := mustSPKI(leafDER)\n187|\tif len(der) == 0 {\n188|\t\treturn \"\"\n189|\t}\n190|\treturn scalar.SHA256Digest(der).String()\n191|}\n192|\n193|// WithMutationAuthorization rechecks generation, credential validity,\n194|// allowlist membership and authenticated hello under the exclusive\n195|// authorization lock immediately before the externally visible side-effect\n196|// boundary, then runs the boundary while still holding the lock. The\n197|// generation check and the boundary serialize with revocation and config\n198|// commits. The request must bind the current generation: work prepared under\n199|// an old generation cannot gain new authority by refreshing a cached number,\n200|// so a stale binding refuses and the caller must discard its authorization\n201|// and replan through a fresh mutually authenticated connection. Boundaries\n202|// must be bounded: long provider calls must not hold the authorization lock\n203|// across unbounded work.\n204|func (store *Store) WithMutationAuthorization(request AuthRequest, boundary func() error) error {\n205|\tunlock, err := store.lock.exclusive()\n206|\tif err != nil {\n207|\t\treturn trustError(TrustError{Operation: \"authorize mutation\", Err: errors.Join(ErrAuthorizationRefused, err)})\n208|\t}\n209|\tdefer unlock()\n210|\t// Pending joint intent converges before the binding check: a request\n211|\t// bound before a crash compares against the recovered generation and\n212|\t// refuses stale, and the boundary never runs beside unresolved intent.\n213|\tif err := convergeLocked(store.fs, store.root); err != nil {\n214|\t\treturn err\n215|\t}\n216|\tcurrent, err := readCommitted(store)\n217|\tif err != nil {\n218|\t\treturn err\n219|\t}\n220|\tif request.SnapshotGeneration != current.Generation {\n221|\t\treturn trustError(TrustError{Operation: \"authorize mutation\", Err: ErrStaleGeneration})\n222|\t}\n223|\tif err := checkAuthorization(current, request); err != nil {\n224|\t\treturn err\n225|\t}\n226|\tif boundary == nil {\n227|\t\treturn trustError(TrustError{Operation: \"authorize mutation\", Err: ErrAuthorizationRefused})\n228|\t}\n229|\treturn boundary()\n230|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c789","stream":{"kind":"session","id":"01a0aba9-d1ff-7602-bf9f-32a3aa09bb6c"},"sequence":543,"recorded_at":1780531400001081,"record_type":"event","durability":"durable","causation_id":"e6495f39-5100-411c-852e-b85f9d8475b0","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e6495f39-5100-411c-852e-b85f9d8475b0","run_stream":{"kind":"run","id":"e6495f39-5100-411c-852e-b85f9d8475b0"},"call_id":"call_01a0abadfe1674e6802b71ba3a461d79","text":"Read text file `internal/hosttrust/custody.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"io\"\n6|\t\"io/fs\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"time\"\n10|)\n11|\n12|const (\n13|\thostChannelDir  = \"host-channel\"\n14|\ttrustFileName   = \"trust.json\"\n15|\tlockFileName    = \"lock\"\n16|\tcredentialsDir  = \"credentials\"\n17|\tcertificateFile = \"certificate.pem\"\n18|\tprivateKeyFile  = \"private-key.pem\"\n19|\trootFile        = \"root.pem\"\n20|\tstagePrefix     = \".trust-stage-\"\n21|)\n22|\n23|// FileSystem abstracts durable writes so crash and fault paths are testable\n24|// without touching the operator disk. The OS implementation is the only\n25|// production backend.\n26|type FileSystem interface {\n27|\tCreateTemp(dir, pattern string, mode fs.FileMode) (StagedFile, error)\n28|\t// CreateExclusive atomically creates a file that must not exist: it\n29|\t// fails when the path already exists and never replaces a live file.\n30|\tCreateExclusive(path string, mode fs.FileMode) error\n31|\tReadFile(name string) ([]byte, error)\n32|\tLstat(name string) (fs.FileInfo, error)\n33|\tStat(name string) (fs.FileInfo, error)\n34|\tRemove(name string) error\n35|\tRename(oldname, newname string) error\n36|\tMkdirAll(path string, mode fs.FileMode) error\n37|\tChmod(name string, mode fs.FileMode) error\n38|\tOpenDirectory(name string) (SyncedDirectory, error)\n39|\tReadDir(name string) ([]fs.DirEntry, error)\n40|}\n41|\n42|// StagedFile is one temp staging file awaiting fsync and atomic rename.\n43|type StagedFile interface {\n44|\tio.Writer\n45|\tName() string\n46|\tChmod(fs.FileMode) error\n47|\tSync() error\n48|\tClose() error\n49|}\n50|\n51|// SyncedDirectory fsyncs a directory entry after renames.\n52|type SyncedDirectory interface {\n53|\tSync() error\n54|\tClose() error\n55|}\n56|\n57|type osFileSystem struct{}\n58|\n59|func (osFileSystem) CreateTemp(dir, pattern string, mode fs.FileMode) (StagedFile, error) {\n60|\tfile, err := os.CreateTemp(dir, pattern)\n61|\tif err != nil {\n62|\t\treturn nil, err\n63|\t}\n64|\tif err := file.Chmod(mode); err != nil {\n65|\t\t_ = file.Close()\n66|\t\t_ = os.Remove(file.Name())\n67|\t\treturn nil, err\n68|\t}\n69|\treturn file, nil\n70|}\n71|\n72|func (osFileSystem) CreateExclusive(path string, mode fs.FileMode) error {\n73|\tfile, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, mode)\n74|\tif err != nil {\n75|\t\treturn err\n76|\t}\n77|\treturn file.Close()\n78|}\n79|\n80|func (osFileSystem) ReadFile(name string) ([]byte, error)   { return os.ReadFile(name) }\n81|func (osFileSystem) Lstat(name string) (fs.FileInfo, error) { return os.Lstat(name) }\n82|func (osFileSystem) Stat(name string) (fs.FileInfo, error)  { return os.Stat(name) }\n83|func (osFileSystem) Remove(name string) error               { return os.Remove(name) }\n84|func (osFileSystem) Rename(oldname, newname string) error   { return os.Rename(oldname, newname) }\n85|\n86|func (osFileSystem) MkdirAll(path string, mode fs.FileMode) error { return os.MkdirAll(path, mode) }\n87|func (osFileSystem) Chmod(name string, mode fs.FileMode) error    { return os.Chmod(name, mode) }\n88|\n89|func (osFileSystem) OpenDirectory(name string) (SyncedDirectory, error) { return os.Open(name) }\n90|func (osFileSystem) ReadDir(name string) ([]fs.DirEntry, error)         { return os.ReadDir(name) }\n91|\n92|// Store is machine-local Host Channel authority rooted at\n93|// STATE_DIR/host-channel. The zero value is unusable; construct with Open.\n94|type Store struct {\n95|\troot string\n96|\tfs   FileSystem\n97|\tlock *fileLock\n98|}\n99|\n100|// Open validates owner-only custody of STATE_DIR/host-channel, creating the\n101|// directory skeleton with exact 0700/0600 modes when absent. Every open\n102|// re-verifies custody: symlink escapes, foreign ownership and group/world\n103|// access refuse with ErrTrustUnsafeCustody.\n104|func Open(stateDir string) (*Store, error) { return openStore(stateDir, osFileSystem{}) }\n105|\n106|func openStore(stateDir string, filesystem FileSystem) (*Store, error) {\n107|\tif filesystem == nil {\n108|\t\treturn nil, trustError(TrustError{Operation: \"open store\", Err: ErrInvalidStoreContext})\n109|\t}\n110|\tif !filepath.IsAbs(stateDir) {\n111|\t\treturn nil, trustError(TrustError{Operation: \"open store\", Err: ErrInvalidStoreContext})\n112|\t}\n113|\troot := filepath.Join(stateDir, hostChannelDir)\n114|\tif err := ensureOwnerDir(filesystem, root, 0o700); err != nil {\n115|\t\treturn nil, err\n116|\t}\n117|\tif err := ensureOwnerDir(filesystem, filepath.Join(root, credentialsDir), 0o700); err != nil {\n118|\t\treturn nil, err\n119|\t}\n120|\tlock, err := openLock(filesystem, filepath.Join(root, lockFileName))\n121|\tif err != nil {\n122|\t\treturn nil, err\n123|\t}\n124|\tstore := &Store{root: root, fs: filesystem, lock: lock}\n125|\t// Converge one interrupted joint config-plus-trust commit, if any: a\n126|\t// crash between the configuration replacement and the generation bump\n127|\t// must complete forward or abort on restart, never admit the new\n128|\t// configuration with the old generation. A refused recovery fails the\n129|\t// open so incoherent state cannot be used.\n130|\tif _, err := store.Recover(); err != nil {\n131|\t\treturn nil, err\n132|\t}\n133|\treturn store, nil\n134|}\n135|\n136|// Root reports the validated host-channel directory. It carries no secrets.\n137|func (store *Store) Root() string { return store.root }\n138|\n139|// TrustPath reports the trust.json path for operator diagnostics. Reading or\n140|// writing it directly bypasses the authorization lock; use transactions.\n141|func (store *Store) TrustPath() string { return filepath.Join(store.root, trustFileName) }\n142|\n143|// PendingCommitPath reports the pending-commit.json path for operator\n144|// diagnostics. A marker left here after a crash converges automatically on\n145|// the next converged read; a marker that refuses convergence needs\n146|// operator resolution and must never be deleted blindly.\n147|func (store *Store) PendingCommitPath() string { return pendingPath(store.root) }\n148|\n149|// CredentialDir reports the custody directory for one credential ID hex. It\n150|// carries no key material.\n151|func (store *Store) CredentialDir(credentialHex string) (string, error) {\n152|\tif len(credentialHex) != 64 {\n153|\t\treturn \"\", trustError(TrustError{Operation: \"resolve credential directory\", Err: ErrCredentialCustody})\n154|\t}\n155|\tfor _, unit := range credentialHex {\n156|\t\tif (unit < '0' || unit > '9') && (unit < 'a' || unit > 'f') {\n157|\t\t\treturn \"\", trustError(TrustError{Operation: \"resolve credential directory\", Err: ErrCredentialCustody})\n158|\t\t}\n159|\t}\n160|\treturn filepath.Join(store.root, credentialsDir, credentialHex), nil\n161|}\n162|\n163|func ensureOwnerDir(filesystem FileSystem, path string, mode fs.FileMode) error {\n164|\tinfo, err := filesystem.Lstat(path)\n165|\tif err != nil && !os.IsNotExist(err) {\n166|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n167|\t}\n168|\tif err == nil {\n169|\t\t// An existing directory is verified, never repaired: silently\n170|\t\t// narrowing a widened directory would mask the custody violation.\n171|\t\treturn verifyOwnerDir(path, info, mode)\n172|\t}\n173|\tif err := filesystem.MkdirAll(path, mode); err != nil {\n174|\t\treturn trustError(TrustError{Operation: \"create directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n175|\t}\n176|\t// MkdirAll honors umask, so the exact owner-only mode is enforced\n177|\t// explicitly after creation.\n178|\tif err := filesystem.Chmod(path, mode); err != nil {\n179|\t\treturn trustError(TrustError{Operation: \"create directory\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n180|\t}\n181|\t// On platforms where mode bits do not govern access, install the\n182|\t// owner-only ACL at creation: verification below would otherwise\n183|\t// refuse the directory the store just created.\n184|\tif err := secureStaged(path, true); err != nil {\n185|\t\treturn err\n186|\t}\n187|\tinfo, err = filesystem.Lstat(path)\n188|\tif err != nil {\n189|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n190|\t}\n191|\treturn verifyOwnerDir(path, info, mode)\n192|}\n193|\n194|func verifyOwnerDir(path string, info fs.FileInfo, mode fs.FileMode) error {\n195|\tif !info.IsDir() {\n196|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: ErrTrustUnsafeCustody})\n197|\t}\n198|\tif info.Mode()&fs.ModeSymlink != 0 {\n199|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: ErrTrustUnsafeCustody})\n200|\t}\n201|\t// Permission bits are a Unix signal only: on Windows the DACL governs and\n202|\t// Go synthesizes mode bits from the read-only attribute, so an exact\n203|\t// comparison would refuse every Windows path. verifyOwner enforces the\n204|\t// owner-only DACL there.\n205|\tif !platformModeOK(info, mode) {\n206|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: ErrTrustUnsafeCustody})\n207|\t}\n208|\treturn verifyOwner(path, info)\n209|}\n210|\n211|// lockVerifyBudget bounds verification retries on an existing lock file.\n212|// A concurrent first-opener can observe the lock between its atomic\n213|// creation and the creator's mode/ACL install; the window is one Chmod and\n214|// one ACL install, so a fraction of a second closes it on any supported\n215|// platform. Genuine custody violations still refuse once the budget\n216|// expires.\n217|const lockVerifyBudget = 500 * time.Millisecond\n218|\n219|const lockVerifyRetry = 5 * time.Millisecond\n220|\n221|// verifyLockFile verifies owner-only custody of an existing lock file. A\n222|// non-regular file refuses immediately: lock creation only ever publishes\n223|// regular files, so a symlink or directory at the path can never be a\n224|// half-installed lock. Other verification failures retry within the\n225|// budget before refusing, so a racing first-open never fails spuriously.\n226|func verifyLockFile(filesystem FileSystem, path string) error {\n227|\tdeadline := time.Now().Add(lockVerifyBudget)\n228|\tfor {\n229|\t\tinfo, err := filesystem.Lstat(path)\n230|\t\tif err != nil {\n231|\t\t\treturn trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n232|\t\t}\n233|\t\tif !info.Mode().IsRegular() || info.Mode()&fs.ModeSymlink != 0 {\n234|\t\t\treturn verifyOwnerFile(path, info, 0o600)\n235|\t\t}\n236|\t\tif err := verifyOwnerFile(path, info, 0o600); err == nil {\n237|\t\t\treturn nil\n238|\t\t} else if time.Now().After(deadline) {\n239|\t\t\treturn err\n240|\t\t}\n241|\t\ttime.Sleep(lockVerifyRetry)\n242|\t}\n243|}\n244|\n245|func verifyOwnerFile(path string, info fs.FileInfo, mode fs.FileMode) error {\n246|\tif !info.Mode().IsRegular() {\n247|\t\treturn trustError(TrustError{Operation: \"inspect file\", Err: ErrTrustUnsafeCustody})\n248|\t}\n249|\tif info.Mode()&fs.ModeSymlink != 0 {\n250|\t\treturn trustError(TrustError{Operation: \"inspect file\", Err: ErrTrustUnsafeCustody})\n251|\t}\n252|\tif !platformModeOK(info, mode) {\n253|\t\treturn trustError(TrustError{Operation: \"inspect file\", Err: ErrTrustUnsafeCustody})\n254|\t}\n255|\treturn verifyOwner(path, info)\n256|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
