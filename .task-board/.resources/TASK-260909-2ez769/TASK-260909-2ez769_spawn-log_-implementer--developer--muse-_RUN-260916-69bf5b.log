{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5cf","stream":{"kind":"session","id":"01a0aba9-d1ff-7602-bf9f-32a3aa09bb6c"},"sequence":322,"recorded_at":1780531400000639,"record_type":"event","durability":"durable","causation_id":"e6495f39-5100-411c-852e-b85f9d8475b0","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e6495f39-5100-411c-852e-b85f9d8475b0","run_stream":{"kind":"run","id":"e6495f39-5100-411c-852e-b85f9d8475b0"},"task_stream":{"kind":"task","id":"01a0abaa-b147-7452-91b0-1eb244958fe1"},"task_id":"01a0abaa-b147-7452-91b0-1eb244958fe1","event":{"kind":"output","task_id":"01a0abaa-b147-7452-91b0-1eb244958fe1","chunk":"Read text file `/tmp/rev6ev/probes/config/reviewer_partial_test.go`.\n1|package config\n2|import(\"errors\";\"testing\";\"os\";\"github.com/relux-works/agent-session-manager/internal/hosttrust\")\n3|type reviewerPartialFS struct { osMigrationFileSystem; filename string; renames int }\n4|func (f *reviewerPartialFS) Rename(from,to string) error {\n5| if to==f.filename {f.renames++;if f.renames==2{return errors.New(\"injected rollback rename failure\")}}\n6| return f.osMigrationFileSystem.Rename(from,to)\n7|}\n8|func (f *reviewerPartialFS) OpenDirectory(path string)(migrationDirectory,error) {\n9| if f.renames==1 {return nil,errors.New(\"injected post-replacement directory open failure\")}\n10| return f.osMigrationFileSystem.OpenDirectory(path)\n11|}\n12|func TestReviewerFailedReplacementCannotLoseIntent(t *testing.T) {\n13| fixture:=setupV4Fixture(t,testPeerID)\n14| before:=fixture.trust(t).Generation\n15| preview,err:=PreviewV4(fixture.inputs,nil,fixture.trust(t),fixture.self,nil,fixture.now)\n16| if err!=nil{t.Fatal(err)}\n17| fs:=&reviewerPartialFS{filename:fixture.filename}\n18| _,err=applyV4(fixture.inputs,nil,preview,true,fixture.now,fs,hosttrust.Open)\n19| if !errors.Is(err,ErrMigrationRecovery){t.Fatalf(\"expected rollback failure, got %v\",err)}\n20| _,markerErr:=os.Stat(fixture.store.PendingCommitPath())\n21| t.Logf(\"apply error=%v; marker inspection=%v\",err,markerErr)\n22| after,err:=LoadCoherent(fixture.inputs,nil,fixture.store)\n23| if err!=nil{return}\n24| loaded,ok:=after.Config.Configuration();if !ok{t.Fatal(\"missing config\")}\n25| if loaded.SourceVersion==Version4 && after.Generation==before {\n26|  t.Fatalf(\"failed replacement discarded intent and admitted Config4 at old generation %d\",before)\n27| }\n28|}\n29|func TestReviewerFailedRollbackCannotLoseIntent(t *testing.T) {\n30| fixture:=setupV4Fixture(t,testPeerID)\n31| preview,err:=PreviewV4(fixture.inputs,nil,fixture.trust(t),fixture.self,nil,fixture.now)\n32| if err!=nil{t.Fatal(err)}\n33| if _,err=ApplyV4(fixture.inputs,nil,preview,true,fixture.now);err!=nil{t.Fatal(err)}\n34| before:=fixture.trust(t).Generation\n35| fs:=&reviewerPartialFS{filename:fixture.filename}\n36| _,err=rollbackV4(fixture.inputs,nil,RollbackV4Options{AcknowledgeNoHostChannelAssurance:true,BackupPath:fixture.filename+\".bak.\"+CurrentVersion},fs,hosttrust.Open)\n37| if !errors.Is(err,ErrMigrationRecovery){t.Fatalf(\"expected rollback recovery failure, got %v\",err)}\n38| after,err:=LoadCoherent(fixture.inputs,nil,fixture.store)\n39| if err!=nil{return}\n40| loaded,ok:=after.Config.Configuration();if !ok{t.Fatal(\"missing config\")}\n41| if loaded.SourceVersion==CurrentVersion && after.Generation==before {\n42|  t.Fatalf(\"failed rollback discarded intent and admitted Config3 at old generation %d\",before)\n43| }\n44|}","final_result":true}}}
