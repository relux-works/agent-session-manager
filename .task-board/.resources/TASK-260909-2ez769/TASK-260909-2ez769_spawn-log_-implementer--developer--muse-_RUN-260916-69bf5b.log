tform: scalar.PlatformMacOS})\n41|\tif err != nil {\n42|\t\tt.Fatalf(\"EncodeCurrent(fixture) error = %v\", err)\n43|\t}\n44|\tfilename := filepath.Join(directory, \"config.toml\")\n45|\tif err := os.WriteFile(filename, document, 0o600); err != nil {\n46|\t\tt.Fatal(err)\n47|\t}\n48|\tinputs := Inputs{\n49|\t\tPlatform: scalar.PlatformMacOS, HomeDir: directory, TempDir: directory, WorkingDir: directory,\n50|\t\tLookupEnv: func(name string) (string, bool) {\n51|\t\t\tswitch name {\n52|\t\t\tcase \"AX_CONFIG\":\n53|\t\t\t\treturn filename, true\n54|\t\t\tcase \"AX_STATE_DIR\":\n55|\t\t\t\treturn stateDir, true\n56|\t\t\t}\n57|\t\t\treturn \"\", false\n58|\t\t},\n59|\t\tStat: os.Stat, ReadFile: os.ReadFile,\n60|\t}\n61|\tstore, err := hosttrust.Open(stateDir)\n62|\tif err != nil {\n63|\t\tt.Fatalf(\"hosttrust.Open error = %v\", err)\n64|\t}\n65|\tif _, err := store.Initialize(); err != nil {\n66|\t\tt.Fatalf(\"Initialize error = %v\", err)\n67|\t}\n68|\tnow := time.Now().UTC().Truncate(time.Millisecond)\n69|\tself, err := store.Issue(testHostID, now)\n70|\tif err != nil {\n71|\t\tt.Fatalf(\"Issue error = %v\", err)\n72|\t}\n73|\tfor _, peer := range peers {\n74|\t\tissuer, err := hosttrust.Open(t.TempDir())\n75|\t\tif err != nil {\n76|\t\t\tt.Fatal(err)\n77|\t\t}\n78|\t\tif _, err := issuer.Initialize(); err != nil {\n79|\t\t\tt.Fatal(err)\n80|\t\t}\n81|\t\tcredential, err := issuer.Issue(peer, now)\n82|\t\tif err != nil {\n83|\t\t\tt.Fatal(err)\n84|\t\t}\n85|\t\tsnapshot, err := issuer.ReadSnapshot()\n86|\t\tif err != nil {\n87|\t\t\tt.Fatal(err)\n88|\t\t}\n89|\t\tmaterial, err := hosttrust.ExportEnrollment(snapshot, credential)\n90|\t\tif err != nil {\n91|\t\t\tt.Fatal(err)\n92|\t\t}\n93|\t\tif _, err := store.Enroll(hosttrust.EnrollInput{HostID: material.HostID, LeafDER: material.LeafDER, RootDER: material.RootDER, Authorized: material.Fingerprints, EnrolledAt: now}); err != nil {\n94|\t\t\tt.Fatalf(\"Enroll(%s) error = %v\", peer, err)\n95|\t\t}\n96|\t}\n97|\treturn &v4Fixture{directory: directory, filename: filename, stateDir: stateDir, inputs: inputs, store: store, self: self, now: now}\n98|}\n99|\n100|func (fixture *v4Fixture) trust(t *testing.T) hosttrust.Snapshot {\n101|\tt.Helper()\n102|\tsnapshot, err := fixture.store.ReadSnapshot()\n103|\tif err != nil {\n104|\t\tt.Fatalf(\"ReadSnapshot error = %v\", err)\n105|\t}\n106|\treturn snapshot\n107|}\n108|\n109|func TestPreviewV4HappyPath(t *testing.T) {\n110|\tfixture := setupV4Fixture(t, testPeerID)\n111|\tpreview, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now)\n112|\tif err != nil {\n113|\t\tt.Fatalf(\"PreviewV4 error = %v\", err)\n114|\t}\n115|\tif preview.SourceVersion != CurrentVersion || preview.CredentialID != fixture.self {\n116|\t\tt.Fatalf(\"preview identity = %+v\", preview.SourceVersion)\n117|\t}\n118|\tif len(preview.RetainedPeers) != 1 || preview.RetainedPeers[0] != testPeerID {\n119|\t\tt.Fatalf(\"retained peers = %v\", preview.RetainedPeers)\n120|\t}\n121|\tif len(preview.DroppedPeers) != 0 || len(preview.BlockingPeers) != 0 {\n122|\t\tt.Fatalf(\"dropped = %v blocking = %v, want empty\", preview.DroppedPeers, preview.BlockingPeers)\n123|\t}\n124|\tloaded, err := Decode(preview.Replacement, DecodeContext{RuntimePlatform: scalar.PlatformMacOS})\n125|\tif err != nil {\n126|\t\tt.Fatalf(\"Decode(preview) error = %v\", err)\n127|\t}\n128|\tif loaded.SourceVersion != Version4 || loaded.Value.Mesh.Transport != TransportSSHTLS13 {\n129|\t\tt.Fatalf(\"preview decodes as %q/%q, want 4.0.0/ssh_tls13\", loaded.SourceVersion, loaded.Value.Mesh.Transport)\n130|\t}\n131|\tif loaded.Value.Mesh.HostChannel == nil || loaded.Value.Mesh.HostChannel.CredentialID != fixture.self {\n132|\t\tt.Fatalf(\"preview host_channel = %+v\", loaded.Value.Mesh.HostChannel)\n133|\t}\n134|\tif len(loaded.Value.Mesh.Peers) != 1 || loaded.Value.HostName != \"fixture-host\" {\n135|\t\tt.Fatal(\"preview dropped retained Config-3 fields\")\n136|\t}\n137|\tcurrent, err := os.ReadFile(fixture.filename)\n138|\tif err != nil {\n139|\t\tt.Fatal(err)\n140|\t}\n141|\tif !bytes.Equal(preview.SourceDocument, current) {\n142|\t\tt.Fatal(\"preview source does not pin the current bytes\")\n143|\t}\n144|}\n145|\n146|func TestPreviewV4AbsentSource(t *testing.T) {\n147|\tfixture := setupV4Fixture(t, testPeerID)\n148|\tif err := os.Remove(fixture.filename); err != nil {\n149|\t\tt.Fatal(err)\n150|\t}\n(more lines below)","final_result":true}}}
