{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5c7","stream":{"kind":"session","id":"01a0aba9-d1ff-7602-bf9f-32a3aa09bb6c"},"sequence":318,"recorded_at":1780531400000631,"record_type":"event","durability":"durable","causation_id":"e6495f39-5100-411c-852e-b85f9d8475b0","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e6495f39-5100-411c-852e-b85f9d8475b0","run_stream":{"kind":"run","id":"e6495f39-5100-411c-852e-b85f9d8475b0"},"task_stream":{"kind":"task","id":"01a0abaa-b1eb-7743-a5f3-648f5174baa3"},"task_id":"01a0abaa-b1eb-7743-a5f3-648f5174baa3","event":{"kind":"output","task_id":"01a0abaa-b1eb-7743-a5f3-648f5174baa3","chunk":"Read text file `/tmp/rev6ev/census-plants.py`.\n1|from pathlib import Path\n2|import subprocess,json\n3|base=Path(__file__).resolve().parent\n4|root=base/'candidate'\n5|prod=root/'internal/config/reviewer_rogue.go'\n6|test=root/'internal/config/reviewer_rogue_test.go'\n7|plants={\n8| 'direct-control': '''package config\n9|func reviewerRogue(path string, data []byte) error { _, err := writeTempReplace(osMigrationFileSystem{}, path, data); return err }\n10|''',\n11| 'package-var-closure': '''package config\n12|var reviewerRogue = func(path string, data []byte) error { _, err := writeTempReplace(osMigrationFileSystem{}, path, data); return err }\n13|''',\n14| 'local-helper-alias': '''package config\n15|func reviewerRogue(path string, data []byte) error { writer := writeTempReplace; _, err := writer(osMigrationFileSystem{}, path, data); return err }\n16|''',\n17| 'method-os-rename': '''package config\n18|import \"os\"\n19|type reviewerRogueWriter struct{}\n20|func (reviewerRogueWriter) replace(path string, data []byte) error { return os.Rename(path+\".replacement\", path) }\n21|func reviewerRogue(path string, data []byte) error { return (reviewerRogueWriter{}).replace(path,data) }\n22|''',\n23|}\n24|testsource='''package config\n25|import(\"os\";\"path/filepath\";\"testing\";\"bytes\")\n26|func TestReviewerRoguePlantExecutes(t *testing.T) {\n27| path:=filepath.Join(t.TempDir(),\"config.toml\")\n28| source:=[]byte(\"old configuration\")\n29| replacement:=[]byte(\"unlocked replacement\")\n30| if err:=os.WriteFile(path,source,0600);err!=nil{t.Fatal(err)}\n31| if err:=os.WriteFile(path+\".replacement\",replacement,0600);err!=nil{t.Fatal(err)}\n32| if err:=reviewerRogue(path,replacement);err!=nil{t.Fatal(err)}\n33| got,err:=os.ReadFile(path);if err!=nil{t.Fatal(err)}\n34| if !bytes.Equal(got,replacement){t.Fatal(\"plant did not change configuration\")}\n35| t.Log(\"real config file replaced by unlocked production caller\")\n36|}\n37|'''\n38|out=base/'census-plants';out.mkdir(exist_ok=True)\n39|results=[]\n40|try:\n41| for name,source in plants.items():\n42|  folder=out/name;folder.mkdir(exist_ok=True)\n43|  prod.write_text(source);test.write_text(testsource)\n44|  (folder/prod.name).write_text(source);(folder/test.name).write_text(testsource)\n45|  command=['go','test','./internal/config','-count=1','-run','^(TestWritePathCensusGate|TestReviewerRoguePlantExecutes)$','-v','-timeout=30s']\n46|  p=subprocess.run(command,cwd=root,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,timeout=60)\n47|  (folder/'test.log').write_bytes(p.stdout)\n48|  assert b'--- PASS: TestReviewerRoguePlantExecutes' in p.stdout\n49|  results.append({'plant':name,'exit_code':p.returncode,'gate_detected':b'--- FAIL: TestWritePathCensusGate' in p.stdout})\n50|finally:\n51| prod.unlink(missing_ok=True);test.unlink(missing_ok=True)\n52|(out/'results.json').write_text(json.dumps(results,indent=2))\n53|print(json.dumps(results,indent=2))","final_result":true}}}
