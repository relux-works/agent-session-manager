{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5c3","stream":{"kind":"session","id":"01a0aba9-d1ff-7602-bf9f-32a3aa09bb6c"},"sequence":316,"recorded_at":1780531400000627,"record_type":"event","durability":"durable","causation_id":"e6495f39-5100-411c-852e-b85f9d8475b0","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e6495f39-5100-411c-852e-b85f9d8475b0","run_stream":{"kind":"run","id":"e6495f39-5100-411c-852e-b85f9d8475b0"},"task_stream":{"kind":"task","id":"01a0abaa-b0ee-7510-91ff-32e759852913"},"task_id":"01a0abaa-b0ee-7510-91ff-32e759852913","event":{"kind":"output","task_id":"01a0abaa-b0ee-7510-91ff-32e759852913","chunk":"Read text file `/tmp/rev6ev/probes/config/reviewer_legacy_test.go`.\n1|package config\n2|\n3|import (\n4| \"os\"\n5| \"testing\"\n6|)\n7|\n8|type reviewerLegacyFS struct {\n9| osMigrationFileSystem\n10| fixture *v4Fixture\n11| t *testing.T\n12| admitted uint64\n13|}\n14|func (f *reviewerLegacyFS) Rename(from, to string) error {\n15| if to == f.fixture.filename && f.admitted == 0 {\n16|  if _, err := Migrate(f.fixture.inputs, nil, MigrationOptions{TargetVersion: CurrentVersion}); err != nil { f.t.Fatal(err) }\n17|  preview, err := PreviewV4(f.fixture.inputs, nil, f.fixture.trust(f.t), f.fixture.self, nil, f.fixture.now)\n18|  if err != nil { f.t.Fatal(err) }\n19|  if _, err := ApplyV4(f.fixture.inputs, nil, preview, true, f.fixture.now); err != nil { f.t.Fatal(err) }\n20|  snapshot, err := LoadCoherent(f.fixture.inputs, nil, f.fixture.store)\n21|  if err != nil { f.t.Fatal(err) }\n22|  loaded, ok := snapshot.Config.Configuration()\n23|  if !ok || loaded.SourceVersion != Version4 { f.t.Fatal(\"concurrent writer did not install Config4\") }\n24|  f.admitted = snapshot.Generation\n25| }\n26| return f.osMigrationFileSystem.Rename(from, to)\n27|}\n28|func TestReviewerLegacyCannotOverwriteCommittedV4(t *testing.T) {\n29| fixture := setupV4Fixture(t, testPeerID)\n30| snapshot, err := Load(fixture.inputs, nil)\n31| if err != nil { t.Fatal(err) }\n32| loaded, _ := snapshot.Configuration()\n33| v2, err := encodeVersion2(loaded.Value, DecodeContext{RuntimePlatform:fixture.inputs.Platform})\n34| if err != nil { t.Fatal(err) }\n35| if err := os.WriteFile(fixture.filename, v2, 0600); err != nil { t.Fatal(err) }\n36| fs := &reviewerLegacyFS{fixture:fixture,t:t}\n37| result, err := migrate(fixture.inputs,nil,MigrationOptions{TargetVersion:CurrentVersion},fs)\n38| t.Logf(\"delayed legacy migrate: changed=%v err=%v\", result.Changed,err)\n39| after, err := LoadCoherent(fixture.inputs,nil,fixture.store)\n40| if err != nil { return } // a fail-closed refusal is safe\n41| final, ok := after.Config.Configuration()\n42| if !ok { t.Fatal(\"missing final configuration\") }\n43| if fs.admitted == 0 { t.Fatal(\"race seam not reached\") }\n44| if final.SourceVersion != Version4 && after.Generation == fs.admitted {\n45|  t.Fatalf(\"legacy migration silently overwrote admitted Config4 with %s at unchanged generation %d\",final.SourceVersion,after.Generation)\n46| }\n47|}","final_result":true}}}
