{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c77d","stream":{"kind":"session","id":"01a0aba9-d1ff-7602-bf9f-32a3aa09bb6c"},"sequence":537,"recorded_at":1780531400001069,"record_type":"event","durability":"durable","causation_id":"e6495f39-5100-411c-852e-b85f9d8475b0","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e6495f39-5100-411c-852e-b85f9d8475b0","run_stream":{"kind":"run","id":"e6495f39-5100-411c-852e-b85f9d8475b0"},"task_stream":{"kind":"task","id":"01a0abae-02da-7140-8b5c-ec7c5d7a69b4"},"task_id":"01a0abae-02da-7140-8b5c-ec7c5d7a69b4","event":{"kind":"output","task_id":"01a0abae-02da-7140-8b5c-ec7c5d7a69b4","chunk":"Read text file `internal/hosttrust/custody.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"io\"\n6|\t\"io/fs\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"time\"\n10|)\n11|\n12|const (\n13|\thostChannelDir  = \"host-channel\"\n14|\ttrustFileName   = \"trust.json\"\n15|\tlockFileName    = \"lock\"\n16|\tcredentialsDir  = \"credentials\"\n17|\tcertificateFile = \"certificate.pem\"\n18|\tprivateKeyFile  = \"private-key.pem\"\n19|\trootFile        = \"root.pem\"\n20|\tstagePrefix     = \".trust-stage-\"\n21|)\n22|\n23|// FileSystem abstracts durable writes so crash and fault paths are testable\n24|// without touching the operator disk. The OS implementation is the only\n25|// production backend.\n26|type FileSystem interface {\n27|\tCreateTemp(dir, pattern string, mode fs.FileMode) (StagedFile, error)\n28|\t// CreateExclusive atomically creates a file that must not exist: it\n29|\t// fails when the path already exists and never replaces a live file.\n30|\tCreateExclusive(path string, mode fs.FileMode) error\n31|\tReadFile(name string) ([]byte, error)\n32|\tLstat(name string) (fs.FileInfo, error)\n33|\tStat(name string) (fs.FileInfo, error)\n34|\tRemove(name string) error\n35|\tRename(oldname, newname string) error\n36|\tMkdirAll(path string, mode fs.FileMode) error\n37|\tChmod(name string, mode fs.FileMode) error\n38|\tOpenDirectory(name string) (SyncedDirectory, error)\n39|\tReadDir(name string) ([]fs.DirEntry, error)\n40|}\n41|\n42|// StagedFile is one temp staging file awaiting fsync and atomic rename.\n43|type StagedFile interface {\n44|\tio.Writer\n45|\tName() string\n46|\tChmod(fs.FileMode) error\n47|\tSync() error\n48|\tClose() error\n49|}\n50|\n51|// SyncedDirectory fsyncs a directory entry after renames.\n52|type SyncedDirectory interface {\n53|\tSync() error\n54|\tClose() error\n55|}\n56|\n57|type osFileSystem struct{}\n58|\n59|func (osFileSystem) CreateTemp(dir, pattern string, mode fs.FileMode) (StagedFile, error) {\n60|\tfile, err := os.CreateTemp(dir, pattern)\n61|\tif err != nil {\n62|\t\treturn nil, err\n63|\t}\n64|\tif err := file.Chmod(mode); err != nil {\n65|\t\t_ = file.Close()\n66|\t\t_ = os.Remove(file.Name())\n67|\t\treturn nil, err\n68|\t}\n69|\treturn file, nil\n70|}\n71|\n72|func (osFileSystem) CreateExclusive(path string, mode fs.FileMode) error {\n73|\tfile, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, mode)\n74|\tif err != nil {\n75|\t\treturn err\n76|\t}\n77|\treturn file.Close()\n78|}\n79|\n80|func (osFileSystem) ReadFile(name string) ([]byte, error)   { return os.ReadFile(name) }\n81|func (osFileSystem) Lstat(name string) (fs.FileInfo, error) { return os.Lstat(name) }\n82|func (osFileSystem) Stat(name string) (fs.FileInfo, error)  { return os.Stat(name) }\n83|func (osFileSystem) Remove(name string) error               { return os.Remove(name) }\n84|func (osFileSystem) Rename(oldname, newname string) error   { return os.Rename(oldname, newname) }\n85|\n86|func (osFileSystem) MkdirAll(path string, mode fs.FileMode) error { return os.MkdirAll(path, mode) }\n87|func (osFileSystem) Chmod(name string, mode fs.FileMode) error    { return os.Chmod(name, mode) }\n88|\n89|func (osFileSystem) OpenDirectory(name string) (SyncedDirectory, error) { return os.Open(name) }\n90|func (osFileSystem) ReadDir(name string) ([]fs.DirEntry, error)         { return os.ReadDir(name) }\n91|\n92|// Store is machine-local Host Channel authority rooted at\n93|// STATE_DIR/host-channel. The zero value is unusable; construct with Open.\n94|type Store struct {\n95|\troot string\n96|\tfs   FileSystem\n97|\tlock *fileLock\n98|}\n99|\n100|// Open validates owner-only custody of STATE_DIR/host-channel, creating the\n101|// directory skeleton with exact 0700/0600 modes when absent. Every open\n102|// re-verifies custody: symlink escapes, foreign ownership and group/world\n103|// access refuse with ErrTrustUnsafeCustody.\n104|func Open(stateDir string) (*Store, error) { return openStore(stateDir, osFileSystem{}) }\n105|\n106|func openStore(stateDir string, filesystem FileSystem) (*Store, error) {\n107|\tif filesystem == nil {\n108|\t\treturn nil, trustError(TrustError{Operation: \"open store\", Err: ErrInvalidStoreContext})\n109|\t}\n110|\tif !filepath.IsAbs(stateDir) {\n111|\t\treturn nil, trustError(TrustError{Operation: \"open store\", Err: ErrInvalidStoreContext})\n112|\t}\n113|\troot := filepath.Join(stateDir, hostChannelDir)\n114|\tif err := ensureOwnerDir(filesystem, root, 0o700); err != nil {\n115|\t\treturn nil, err\n116|\t}\n117|\tif err := ensureOwnerDir(filesystem, filepath.Join(root, credentialsDir), 0o700); err != nil {\n118|\t\treturn nil, err\n119|\t}\n120|\tlock, err := openLock(filesystem, filepath.Join(root, lockFileName))\n121|\tif err != nil {\n122|\t\treturn nil, err\n123|\t}\n124|\tstore := &Store{root: root, fs: filesystem, lock: lock}\n125|\t// Converge one interrupted joint config-plus-trust commit, if any: a\n126|\t// crash between the configuration replacement and the generation bump\n127|\t// must complete forward or abort on restart, never admit the new\n128|\t// configuration with the old generation. A refused recovery fails the\n129|\t// open so incoherent state cannot be used.\n130|\tif _, err := store.Recover(); err != nil {\n131|\t\treturn nil, err\n132|\t}\n133|\treturn store, nil\n134|}\n135|\n136|// Root reports the validated host-channel directory. It carries no secrets.\n137|func (store *Store) Root() string { return store.root }\n138|\n139|// TrustPath reports the trust.json path for operator diagnostics. Reading or\n140|// writing it directly bypasses the authorization lock; use transactions.\n141|func (store *Store) TrustPath() string { return filepath.Join(store.root, trustFileName) }\n142|\n143|// PendingCommitPath reports the pending-commit.json path for operator\n144|// diagnostics. A marker left here after a crash converges automatically on\n145|// the next converged read; a marker that refuses convergence needs\n146|// operator resolution and must never be deleted blindly.\n147|func (store *Store) PendingCommitPath() string { return pendingPath(store.root) }\n148|\n149|// CredentialDir reports the custody directory for one credential ID hex. It\n150|// carries no key material.\n151|func (store *Store) CredentialDir(credentialHex string) (string, error) {\n152|\tif len(credentialHex) != 64 {\n153|\t\treturn \"\", trustError(TrustError{Operation: \"resolve credential directory\", Err: ErrCredentialCustody})\n154|\t}\n155|\tfor _, unit := range credentialHex {\n156|\t\tif (unit < '0' || unit > '9') && (unit < 'a' || unit > 'f') {\n157|\t\t\treturn \"\", trustError(TrustError{Operation: \"resolve credential directory\", Err: ErrCredentialCustody})\n158|\t\t}\n159|\t}\n160|\treturn filepath.Join(store.root, credentialsDir, credentialHex), nil\n161|}\n162|\n163|func ensureOwnerDir(filesystem FileSystem, path string, mode fs.FileMode) error {\n164|\tinfo, err := filesystem.Lstat(path)\n165|\tif err != nil && !os.IsNotExist(err) {\n166|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n167|\t}\n168|\tif err == nil {\n169|\t\t// An existing directory is verified, never repaired: silently\n170|\t\t// narrowing a widened directory would mask the custody violation.\n171|\t\treturn verifyOwnerDir(path, info, mode)\n172|\t}\n173|\tif err := filesystem.MkdirAll(path, mode); err != nil {\n174|\t\treturn trustError(TrustError{Operation: \"create directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n175|\t}\n176|\t// MkdirAll honors umask, so the exact owner-only mode is enforced\n177|\t// explicitly after creation.\n178|\tif err := filesystem.Chmod(path, mode); err != nil {\n179|\t\treturn trustError(TrustError{Operation: \"create directory\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n180|\t}\n181|\t// On platforms where mode bits do not govern access, install the\n182|\t// owner-only ACL at creation: verification below would otherwise\n183|\t// refuse the directory the store just created.\n184|\tif err := secureStaged(path, true); err != nil {\n185|\t\treturn err\n186|\t}\n187|\tinfo, err = filesystem.Lstat(path)\n188|\tif err != nil {\n189|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n190|\t}\n191|\treturn verifyOwnerDir(path, info, mode)\n192|}\n193|\n194|func verifyOwnerDir(path string, info fs.FileInfo, mode fs.FileMode) error {\n195|\tif !info.IsDir() {\n196|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: ErrTrustUnsafeCustody})\n197|\t}\n198|\tif info.Mode()&fs.ModeSymlink != 0 {\n199|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: ErrTrustUnsafeCustody})\n200|\t}\n201|\t// Permission bits are a Unix signal only: on Windows the DACL governs and\n202|\t// Go synthesizes mode bits from the read-only attribute, so an exact\n203|\t// comparison would refuse every Windows path. verifyOwner enforces the\n204|\t// owner-only DACL there.\n205|\tif !platformModeOK(info, mode) {\n206|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: ErrTrustUnsafeCustody})\n207|\t}\n208|\treturn verifyOwner(path, info)\n209|}\n210|\n211|// lockVerifyBudget bounds verification retries on an existing lock file.\n212|// A concurrent first-opener can observe the lock between its atomic\n213|// creation and the creator's mode/ACL install; the window is one Chmod and\n214|// one ACL install, so a fraction of a second closes it on any supported\n215|// platform. Genuine custody violations still refuse once the budget\n216|// expires.\n217|const lockVerifyBudget = 500 * time.Millisecond\n218|\n219|const lockVerifyRetry = 5 * time.Millisecond\n220|\n221|// verifyLockFile verifies owner-only custody of an existing lock file. A\n222|// non-regular file refuses immediately: lock creation only ever publishes\n223|// regular files, so a symlink or directory at the path can never be a\n224|// half-installed lock. Other verification failures retry within the\n225|// budget before refusing, so a racing first-open never fails spuriously.\n226|func verifyLockFile(filesystem FileSystem, path string) error {\n227|\tdeadline := time.Now().Add(lockVerifyBudget)\n228|\tfor {\n229|\t\tinfo, err := filesystem.Lstat(path)\n230|\t\tif err != nil {\n231|\t\t\treturn trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n232|\t\t}\n233|\t\tif !info.Mode().IsRegular() || info.Mode()&fs.ModeSymlink != 0 {\n234|\t\t\treturn verifyOwnerFile(path, info, 0o600)\n235|\t\t}\n236|\t\tif err := verifyOwnerFile(path, info, 0o600); err == nil {\n237|\t\t\treturn nil\n238|\t\t} else if time.Now().After(deadline) {\n239|\t\t\treturn err\n240|\t\t}\n241|\t\ttime.Sleep(lockVerifyRetry)\n242|\t}\n243|}\n244|\n245|func verifyOwnerFile(path string, info fs.FileInfo, mode fs.FileMode) error {\n246|\tif !info.Mode().IsRegular() {\n247|\t\treturn trustError(TrustError{Operation: \"inspect file\", Err: ErrTrustUnsafeCustody})\n248|\t}\n249|\tif info.Mode()&fs.ModeSymlink != 0 {\n250|\t\treturn trustError(TrustError{Operation: \"inspect file\", Err: ErrTrustUnsafeCustody})\n251|\t}\n252|\tif !platformModeOK(info, mode) {\n253|\t\treturn trustError(TrustError{Operation: \"inspect file\", Err: ErrTrustUnsafeCustody})\n254|\t}\n255|\treturn verifyOwner(path, info)\n256|}","final_result":true}}}
