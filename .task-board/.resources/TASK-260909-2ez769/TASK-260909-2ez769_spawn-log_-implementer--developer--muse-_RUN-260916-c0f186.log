{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc5d","stream":{"kind":"session","id":"01a0aa44-08d9-7882-b782-d653915eefd3"},"sequence":1161,"recorded_at":1780531400002317,"record_type":"event","durability":"durable","causation_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","run_stream":{"kind":"run","id":"bc8ec94b-72dd-41ff-812d-ceee7d051537"},"task_stream":{"kind":"task","id":"01a0aa4b-42ce-7a20-b045-d6ff686481ef"},"task_id":"01a0aa4b-42ce-7a20-b045-d6ff686481ef","event":{"kind":"output","task_id":"01a0aa4b-42ce-7a20-b045-d6ff686481ef","chunk":"edited\nchanged lines: lines 255-268\n--- original\n+++ updated\n@@\n-// Recover converges one interrupted joint commit found on disk. It runs\n-// automatically on Open and after a caller-restored source, and is safe to\n-// call directly:\n-//\n-//   - configuration equal to the replacement hash completes forward: a\n-//     trust at the source generation bumps to source plus one; a trust\n-//     already there only removes the marker.\n-//   - configuration equal to the source hash aborts: the marker is removed\n-//     with no generation change.\n-//   - anything else (operator edit mid-flight, unreadable state) refuses\n-//     and keeps the marker for operator resolution.\n-//\n-// A refused recovery fails Open, so a restart can never silently admit new\n-// configuration with an old generation.\n+// Recover converges one interrupted joint commit found on disk. It runs\n+// automatically on Open and after a caller-restored source, and is safe to\n+// call directly. Every other read, admission and transaction entry point\n+// converges through the same logic before exposing a snapshot (see\n+// convergeLocked), so surviving processes converge exactly like reopened\n+// ones:\n+//\n+//   - configuration equal to the replacement hash completes forward: a\n+//     trust at the source generation bumps to source plus one; a trust\n+//     already there only removes the marker.\n+//   - configuration equal to the source hash aborts: the marker is removed\n+//     with no generation change.\n+//   - anything else (operator edit mid-flight, unreadable state) refuses\n+//     and keeps the marker for operator resolution.\n+//\n+// A refused recovery fails the caller, so no reader can silently admit new\n+// configuration with an old generation.\n","final_result":true}}}
