n &v4Fixture{directory: directory, filename: filename, stateDir: stateDir, inputs: inputs, store: store, self: self, now: now}\n98|}\n99|\n100|func (fixture *v4Fixture) trust(t *testing.T) hosttrust.Snapshot {\n101|\tt.Helper()\n102|\tsnapshot, err := fixture.store.ReadSnapshot()\n103|\tif err != nil {\n104|\t\tt.Fatalf(\"ReadSnapshot error = %v\", err)\n105|\t}\n106|\treturn snapshot\n107|}\n108|\n109|func TestPreviewV4HappyPath(t *testing.T) {\n110|\tfixture := setupV4Fixture(t, testPeerID)\n(more lines below)","final_result":true}}}
