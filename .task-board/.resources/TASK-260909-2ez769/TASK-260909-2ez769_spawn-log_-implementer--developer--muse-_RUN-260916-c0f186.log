{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c70d","stream":{"kind":"session","id":"01a0aa44-08d9-7882-b782-d653915eefd3"},"sequence":481,"recorded_at":1780531400000957,"record_type":"event","durability":"durable","causation_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","run_stream":{"kind":"run","id":"bc8ec94b-72dd-41ff-812d-ceee7d051537"},"task_stream":{"kind":"task","id":"01a0aa45-0a32-7d51-9e05-76fed0665498"},"task_id":"01a0aa45-0a32-7d51-9e05-76fed0665498","event":{"kind":"output","task_id":"01a0aa45-0a32-7d51-9e05-76fed0665498","chunk":"Read text file `internal/config/migration_v4_apply.go`.\n1|package config\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"errors\"\n6|\t\"time\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/hosttrust\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// ApplyV4OS captures real process inputs and performs one explicit durable\n13|// Configuration 4.0.0 migration. The caller supplies the exact confirmed\n14|// preview from PreviewV4; confirm must be true.\n15|func ApplyV4OS(platform scalar.Platform, overrides Overrides, preview V4Preview, confirm bool, now time.Time) (V4ApplyResult, error) {\n16|\tinputs, err := OSInputs(platform)\n17|\tif err != nil {\n18|\t\treturn V4ApplyResult{}, err\n19|\t}\n20|\treturn applyV4(inputs, overrides, preview, confirm, now, osMigrationFileSystem{}, hosttrust.Open)\n21|}\n22|\n23|// ApplyV4 is the dependency-injected production entry point. It writes only\n24|// the selected configuration file, a deterministic source-version backup in\n25|// the same directory, and one trust generation bump under the shared\n26|// authorization lock.\n27|func ApplyV4(inputs Inputs, overrides Overrides, preview V4Preview, confirm bool, now time.Time) (V4ApplyResult, error) {\n28|\treturn applyV4(inputs, overrides, preview, confirm, now, osMigrationFileSystem{}, hosttrust.Open)\n29|}\n30|\n31|func applyV4(inputs Inputs, overrides Overrides, preview V4Preview, confirm bool, now time.Time,\n32|\tfilesystem migrationFileSystem, openStore func(string) (*hosttrust.Store, error)) (V4ApplyResult, error) {\n33|\tif !confirm {\n34|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"confirm preview\", Err: ErrMigrationV4ConfirmRequired})\n35|\t}\n36|\tif preview.SourceVersion != CurrentVersion || len(preview.SourceDocument) == 0 || len(preview.Replacement) == 0 {\n37|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate preview\", Err: ErrMigrationV4PreviewMismatch})\n38|\t}\n39|\t// Unlocked fast-fail checks first; the same pins are revalidated inside\n40|\t// the joint transaction below, closing the concurrent-change window\n41|\t// between this read and the commit.\n42|\tsnapshot, err := Load(inputs, overrides)\n43|\tif err != nil {\n44|\t\treturn V4ApplyResult{}, err\n45|\t}\n46|\tloaded, decoded := snapshot.Configuration()\n47|\tif !snapshot.ConfigPresent() || !decoded {\n48|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"load source\", Err: ErrMigrationSourceAbsent})\n49|\t}\n50|\tif loaded.SourceVersion != CurrentVersion {\n51|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"select source\", Err: ErrMigrationV4Source})\n52|\t}\n53|\tif !bytes.Equal(snapshot.Document(), preview.SourceDocument) {\n54|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate preview source\", Err: ErrMigrationV4StaleSource})\n55|\t}\n56|\tselected, _ := snapshot.Paths().Path(ConfigFile)\n57|\tfilename := selected.Value.String()\n58|\tstateDir := stateDirOf(snapshot)\n59|\tstore, err := openStore(stateDir)\n60|\tif err != nil {\n61|\t\treturn V4ApplyResult{}, err\n62|\t}\n63|\tcurrent, err := store.ReadSnapshot()\n64|\tif err != nil {\n65|\t\treturn V4ApplyResult{}, err\n66|\t}\n67|\tif current.Generation != preview.SourceGeneration {\n68|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate preview generation\", Err: ErrMigrationV4StaleGeneration})\n69|\t}\n70|\trendered, err := renderV4Preview(snapshot.Document(), loaded.Value, current, preview.CredentialID, preview.DroppedPeers, now, inputs)\n71|\tif err != nil {\n72|\t\treturn V4ApplyResult{}, err\n73|\t}\n74|\tif !bytes.Equal(rendered.Replacement, preview.Replacement) {\n75|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate preview bytes\", Err: ErrMigrationV4PreviewMismatch})\n76|\t}\n77|\t// The custody files behind the selected credential must validate before\n78|\t// use, exactly as Section 11.10.2 requires for local identity.\n79|\tcredentialHex := previewCredentialHex(preview.CredentialID)\n80|\tif err := store.ValidateCustody(credentialHex, loaded.Value.HostID, now); err != nil {\n81|\t\treturn V4ApplyResult{}, err\n82|\t}\n83|\tbackup := filename + \".bak.\" + loaded.SourceVersion\n84|\t// filename is the selected snapshot path, a scalar.AbsolutePath by\n85|\t// loader construction; JointCommit still revalidates the absolute\n86|\t// marker path before staging anything.\n87|\tmarker := hosttrust.PendingCommit{\n88|\t\tSchema:            \"urn:ax:schema:host-pending-commit\",\n89|\t\tSchemaVersion:     \"1.0.0\",\n90|\t\tOperation:         hosttrust.JointApplyV4,\n91|\t\tConfigPath:        filename,\n92|\t\tSourceSHA256:      hosttrust.SHA256HexOf(preview.SourceDocument),\n93|\t\tReplacementSHA256: hosttrust.SHA256HexOf(preview.Replacement),\n94|\t\tSourceGeneration:  preview.SourceGeneration,\n95|\t\tBackupPath:        backup,\n96|\t}\n97|\tgeneration, err := store.JointCommit(marker,\n98|\t\tfunc(current hosttrust.TrustStore) error {\n99|\t\t\treturn revalidateApplyV4(inputs, overrides, store, preview, current, now)\n100|\t\t},\n101|\t\tfunc() error {\n102|\t\t\treturn replaceDurably(filesystem, filename, backup, preview.SourceDocument, preview.Replacement)\n103|\t\t})\n104|\tif err != nil {\n105|\t\tif errors.Is(err, hosttrust.ErrJointReplacementDurable) {\n106|\t\t\treturn V4ApplyResult{}, restoreSourceAfterJointFailure(filesystem, filename, preview.SourceDocument, store, err)\n107|\t\t}\n108|\t\treturn V4ApplyResult{}, err\n109|\t}\n110|\treturn V4ApplyResult{\n111|\t\tMigration:  MigrationResult{SourceVersion: loaded.SourceVersion, TargetVersion: Version4, BackupPath: backup, Changed: true},\n112|\t\tGeneration: generation,\n113|\t}, nil\n114|}\n115|\n116|// revalidateApplyV4 repeats the confirmed pins inside the joint transaction:\n117|// current source bytes, source version, preview rendering, generation and\n118|// credential custody. It runs under the exclusive authorization lock, so a\n119|// concurrent trust or config commit cannot slip between validation and the\n120|// replacement.\n121|func revalidateApplyV4(inputs Inputs, overrides Overrides, store *hosttrust.Store, preview V4Preview, current hosttrust.TrustStore, now time.Time) error {\n122|\tsnapshot, err := Load(inputs, overrides)\n123|\tif err != nil {\n124|\t\treturn err\n125|\t}\n126|\tloaded, decoded := snapshot.Configuration()\n127|\tif !snapshot.ConfigPresent() || !decoded {\n128|\t\treturn migrationError(MigrationError{Operation: \"load source\", Err: ErrMigrationSourceAbsent})\n129|\t}\n130|\tif loaded.SourceVersion != CurrentVersion {\n131|\t\treturn migrationError(MigrationError{Operation: \"select source\", Err: ErrMigrationV4Source})\n132|\t}\n133|\tif !bytes.Equal(snapshot.Document(), preview.SourceDocument) {\n134|\t\treturn migrationError(MigrationError{Operation: \"validate preview source\", Err: ErrMigrationV4StaleSource})\n135|\t}\n136|\tif current.Generation != preview.SourceGeneration {\n137|\t\treturn migrationError(MigrationError{Operation: \"validate preview generation\", Err: ErrMigrationV4StaleGeneration})\n138|\t}\n139|\trendered, err := renderV4Preview(snapshot.Document(), loaded.Value, hosttrust.Snapshot{Generation: current.Generation, Trust: current}, preview.CredentialID, preview.DroppedPeers, now, inputs)\n140|\tif err != nil {\n141|\t\treturn err\n142|\t}\n143|\tif !bytes.Equal(rendered.Replacement, preview.Replacement) {\n144|\t\treturn migrationError(MigrationError{Operation: \"validate preview bytes\", Err: ErrMigrationV4PreviewMismatch})\n145|\t}\n146|\t// The store is already open: custody revalidation reads files only and\n147|\t// never re-acquires the held authorization lock.\n148|\treturn store.ValidateCustody(previewCredentialHex(preview.CredentialID), loaded.Value.HostID, now)\n149|}\n150|\n151|// RollbackV4OS captures real process inputs and performs one explicit\n152|// operator rollback: stopping every host channel is the operator's act, and\n153|// this call replaces configuration from the preserved backup and bumps the\n154|// trust generation so stale-generation streams cannot survive.\n155|func RollbackV4OS(platform scalar.Platform, overrides Overrides, options RollbackV4Options) (V4ApplyResult, error) {\n156|\tinputs, err := OSInputs(platform)\n157|\tif err != nil {\n158|\t\treturn V4ApplyResult{}, err\n159|\t}\n160|\treturn rollbackV4(inputs, overrides, options, osMigrationFileSystem{}, hosttrust.Open)\n161|}\n162|\n163|// RollbackV4 is the dependency-injected production entry point.\n164|func RollbackV4(inputs Inputs, overrides Overrides, options RollbackV4Options) (V4ApplyResult, error) {\n165|\treturn rollbackV4(inputs, overrides, options, osMigrationFileSystem{}, hosttrust.Open)\n166|}\n167|\n168|// errRollbackConverged signals that the rollback target already holds: the\n169|// configuration converged to the backup between the fast-fail check and the\n170|// joint transaction. JointCommit stages no marker for it and passes the\n171|// sentinel through; rollbackV4 reports the no-op success instead.\n172|var errRollbackConverged = errors.New(\"configuration rollback already holds\")\n173|\n174|func rollbackV4(inputs Inputs, overrides Overrides, options RollbackV4Options,\n175|\tfilesystem migrationFileSystem, openStore func(string) (*hosttrust.Store, error)) (V4ApplyResult, error) {\n176|\tif !options.AcknowledgeNoHostChannelAssurance {\n177|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"acknowledge rollback\", Err: ErrRollbackV4AckRequired})\n178|\t}\n179|\tsnapshot, err := Load(inputs, overrides)\n180|\tif err != nil {\n181|\t\treturn V4ApplyResult{}, err\n182|\t}\n183|\tloaded, decoded := snapshot.Configuration()\n184|\tif !snapshot.ConfigPresent() || !decoded {\n185|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"load source\", Err: ErrMigrationSourceAbsent})\n186|\t}\n187|\tselected, _ := snapshot.Paths().Path(ConfigFile)\n188|\tfilename := selected.Value.String()\n189|\tbackup := options.BackupPath\n190|\tif backup == \"\" {\n191|\t\tbackup = filename + \".bak.\" + CurrentVersion\n192|\t}\n193|\tbackupBytes, err := filesystem.ReadFile(backup)\n194|\tif err != nil {\n195|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"read backup\", Err: errors.Join(ErrRollbackV4Backup, err)})\n196|\t}\n197|\tcontext := DecodeContext{RuntimePlatform: inputs.Platform, BackendSettings: inputs.BackendSettings}\n198|\tbackupLoaded, err := Decode(backupBytes, context)\n199|\tif err != nil {\n200|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate backup\", Err: errors.Join(ErrRollbackV4Backup, err)})\n201|\t}\n202|\tif backupLoaded.SourceVersion == Version4 {\n203|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate backup\", Err: ErrRollbackV4Backup})\n204|\t}\n205|\tif bytes.Equal(snapshot.Document(), backupBytes) {\n206|\t\treturn V4ApplyResult{Migration: MigrationResult{SourceVersion: loaded.SourceVersion, TargetVersion: backupLoaded.SourceVersion, BackupPath: backup}}, nil\n207|\t}\n208|\tstore, err := openStore(stateDirOf(snapshot))\n209|\tif err != nil {\n210|\t\treturn V4ApplyResult{}, err\n211|\t}\n212|\tpreRollback := filename + \".pre-rollback.\" + loaded.SourceVersion\n213|\tmarker := hosttrust.PendingCommit{\n214|\t\tSchema:            \"urn:ax:schema:host-pending-commit\",\n215|\t\tSchemaVersion:     \"1.0.0\",\n216|\t\tOperation:         hosttrust.JointRollbackV4,\n217|\t\tConfigPath:        filename,\n218|\t\tSourceSHA256:      hosttrust.SHA256HexOf(snapshot.Document()),\n219|\t\tReplacementSHA256: hosttrust.SHA256HexOf(backupBytes),\n220|\t\tBackupPath:        preRollback,\n221|\t}\n222|\t// The source generation pins inside the transaction: reread the trust\n223|\t// there so a concurrent commit cannot slip between this read and the\n224|\t// replacement.\n225|\tcurrent, err := store.ReadSnapshot()\n226|\tif err != nil {\n227|\t\treturn V4ApplyResult{}, err\n228|\t}\n229|\tmarker.SourceGeneration = current.Generation\n230|\tgeneration, err := store.JointCommit(marker,\n231|\t\tfunc(current hosttrust.TrustStore) error {\n232|\t\t\treturn revalidateRollbackV4(inputs, overrides, snapshot.Document(), backupBytes, backupLoaded.SourceVersion, marker.SourceGeneration, current)\n233|\t\t},\n234|\t\tfunc() error {\n235|\t\t\treturn replaceDurably(filesystem, filename, preRollback, snapshot.Document(), backupBytes)\n236|\t\t})\n237|\tif err != nil {\n238|\t\tif errors.Is(err, errRollbackConverged) {\n239|\t\t\treturn V4ApplyResult{Migration: MigrationResult{SourceVersion: loaded.SourceVersion, TargetVersion: backupLoaded.SourceVersion, BackupPath: backup}}, nil\n240|\t\t}\n241|\t\tif errors.Is(err, hosttrust.ErrJointReplacementDurable) {\n242|\t\t\treturn V4ApplyResult{}, restoreSourceAfterJointFailure(filesystem, filename, snapshot.Document(), store, err)\n243|\t\t}\n244|\t\treturn V4ApplyResult{}, err\n245|\t}\n246|\treturn V4ApplyResult{\n247|\t\tMigration:  MigrationResult{SourceVersion: loaded.SourceVersion, TargetVersion: backupLoaded.SourceVersion, BackupPath: preRollback, Changed: true},\n248|\t\tGeneration: generation,\n249|\t}, nil\n250|}\n251|\n252|// restoreSourceAfterJointFailure converges a joint commit whose\n253|// replacement is durable but whose generation bump failed: it restores the\n254|// source bytes, then runs recovery (the restored source aborts the marker\n255|// cleanly). A failed restore or a failed recovery keeps the marker for\n256|// operator resolution and reports the compound failure, never silent\n257|// success. The original commit error is always preserved for errors.Is.\n258|func restoreSourceAfterJointFailure(filesystem migrationFileSystem, filename string, source []byte, store *hosttrust.Store, commitErr error) error {\n259|\tif _, restoreErr := writeTempReplace(filesystem, filename, source); restoreErr != nil {\n260|\t\treturn migrationError(MigrationError{Operation: \"recover source after trust commit\", Err: errors.Join(ErrMigrationSync, ErrMigrationRecovery, commitErr, restoreErr)})\n261|\t}\n262|\tif _, recoverErr := store.Recover(); recoverErr != nil {\n263|\t\treturn migrationError(MigrationError{Operation: \"recover source after trust commit\", Err: errors.Join(ErrMigrationSync, ErrMigrationRecovery, commitErr, recoverErr)})\n264|\t}\n265|\treturn commitErr\n266|}\n267|\n268|// revalidateRollbackV4 repeats the rollback pins inside the joint\n269|// transaction: the current document is still the pinned source, still\n270|// differs from the backup, the backup still decodes below v4, and the trust\n271|// generation has not moved. A converged target (current equals backup) is\n272|// the no-op success, not a commit: it returns errRollbackConverged before\n273|// any marker is staged.\n274|func revalidateRollbackV4(inputs Inputs, overrides Overrides, sourceDocument, backupBytes []byte, backupVersion string, expectedGeneration uint64, current hosttrust.TrustStore) error {\n275|\tsnapshot, err := Load(inputs, overrides)\n276|\tif err != nil {\n277|\t\treturn err\n278|\t}\n279|\tloaded, decoded := snapshot.Configuration()\n280|\tif !snapshot.ConfigPresent() || !decoded {\n281|\t\treturn migrationError(MigrationError{Operation: \"load source\", Err: ErrMigrationSourceAbsent})\n282|\t}\n283|\t_ = loaded\n284|\tif bytes.Equal(snapshot.Document(), backupBytes) {\n285|\t\treturn errRollbackConverged\n286|\t}\n287|\tif !bytes.Equal(snapshot.Document(), sourceDocument) {\n288|\t\treturn migrationError(MigrationError{Operation: \"validate rollback source\", Err: ErrRollbackV4StaleSource})\n289|\t}\n290|\tif current.Generation != expectedGeneration {\n291|\t\treturn migrationError(MigrationError{Operation: \"validate rollback generation\", Err: ErrRollbackV4StaleGeneration})\n292|\t}\n293|\tcontext := DecodeContext{RuntimePlatform: inputs.Platform, BackendSettings: inputs.BackendSettings}\n294|\tbackupLoaded, err := Decode(backupBytes, context)\n295|\tif err != nil {\n296|\t\treturn migrationError(MigrationError{Operation: \"validate backup\", Err: errors.Join(ErrRollbackV4Backup, err)})\n297|\t}\n298|\tif backupLoaded.SourceVersion == Version4 || backupLoaded.SourceVersion != backupVersion {\n299|\t\treturn migrationError(MigrationError{Operation: \"validate backup\", Err: ErrRollbackV4Backup})\n300|\t}\n301|\treturn nil\n302|}","final_result":true}}}
