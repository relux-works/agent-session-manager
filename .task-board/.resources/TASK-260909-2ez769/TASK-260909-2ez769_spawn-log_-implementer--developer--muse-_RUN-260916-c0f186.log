{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c69d","stream":{"kind":"session","id":"01a0aa44-08d9-7882-b782-d653915eefd3"},"sequence":425,"recorded_at":1780531400000845,"record_type":"event","durability":"durable","causation_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","run_stream":{"kind":"run","id":"bc8ec94b-72dd-41ff-812d-ceee7d051537"},"task_stream":{"kind":"task","id":"01a0aa44-ee43-76e0-8066-9b971a46dd00"},"task_id":"01a0aa44-ee43-76e0-8066-9b971a46dd00","event":{"kind":"output","task_id":"01a0aa44-ee43-76e0-8066-9b971a46dd00","chunk":"Read text file `internal/hosttrust/authorize.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"errors\"\n6|\t\"fmt\"\n7|\t\"time\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// AuthRequest carries one dispatch or mutation-boundary authorization check.\n13|// SnapshotGeneration binds the stream to the coherent snapshot it was opened\n14|// under; LocalCredentialID and the remote DER bytes select the exact enrolled\n15|// entries; Allowlisted is the local mesh allowlist; HelloHostID is the\n16|// authenticated hello identity; ExpectedRemoteHostID is the selected\n17|// configured destination on the client.\n18|type AuthRequest struct {\n19|\tSnapshotGeneration   uint64\n20|\tLocalHostID          string\n21|\tLocalCredentialID    string\n22|\tRemoteLeafDER        []byte\n23|\tRemoteRootDER        []byte\n24|\tExpectedRemoteHostID string\n25|\tAllowlisted          []string\n26|\tHelloHostID          string\n27|\tNow                  time.Time\n28|}\n29|\n30|// Formatting an authorization request must never expose DER bytes, UUIDs,\n31|// digests or allowlists.\n32|func (AuthRequest) String() string   { return \"host channel authorization request\" }\n33|func (AuthRequest) GoString() string { return \"host channel authorization request\" }\n34|func (AuthRequest) Format(state fmt.State, verb rune) {\n35|\t_, _ = state.Write([]byte(\"host channel authorization request\"))\n36|}\n37|\n38|// Formatting a snapshot must never expose the entries it binds.\n39|func (Snapshot) String() string   { return \"host trust snapshot\" }\n40|func (Snapshot) GoString() string { return \"host trust snapshot\" }\n41|func (Snapshot) Format(state fmt.State, verb rune) {\n42|\t_, _ = state.Write([]byte(\"host trust snapshot\"))\n43|}\n44|\n45|// AuthorizeDispatch checks current generation, local credential validity,\n46|// allowlist membership and authenticated hello against one committed read\n47|// held under the shared authorization lock. The check observes a coherent\n48|// snapshot, but the dispatch itself runs after the lock releases, so the\n49|// caller must bind the admitted generation to the stream and enforce the\n50|// one-second invalidation on commit: re-check currency before sending, and\n51|// close stale-generation streams on watchdog, never on notifications alone.\n52|// Mutation side effects additionally require WithMutationAuthorization, which\n53|// holds the exclusive lock across the recheck and the boundary. Work prepared\n54|// under an old generation cannot gain new authority by refreshing a cached\n55|// number: a stale snapshot refuses.\n56|func (store *Store) AuthorizeDispatch(snapshot Snapshot, request AuthRequest) error {\n57|\tunlock, err := store.lock.shared()\n58|\tif err != nil {\n59|\t\treturn trustError(TrustError{Operation: \"authorize dispatch\", Err: errors.Join(ErrAuthorizationRefused, err)})\n60|\t}\n61|\tdefer unlock()\n62|\tcurrent, err := readCommitted(store)\n63|\tif err != nil {\n64|\t\treturn err\n65|\t}\n66|\t// The stream binding must match the snapshot it was opened under: work\n67|\t// prepared under an old generation cannot gain new authority by\n68|\t// refreshing a cached number.\n69|\tif request.SnapshotGeneration != snapshot.Generation {\n70|\t\treturn trustError(TrustError{Operation: \"authorize generation\", Err: ErrStaleGeneration})\n71|\t}\n72|\tif snapshot.Generation != current.Generation {\n73|\t\treturn trustError(TrustError{Operation: \"authorize generation\", Err: ErrStaleGeneration})\n74|\t}\n75|\treturn checkAuthorization(snapshot.Trust, request)\n76|}\n77|\n78|// readCommitted reads the committed trust without acquiring the lock: the\n79|// caller must already hold the shared or exclusive authorization lock, so\n80|// the read nests safely inside a holder instead of blocking on it.\n81|func readCommitted(store *Store) (TrustStore, error) {\n82|\tpath := store.TrustPath()\n83|\tinfo, err := store.fs.Lstat(path)\n84|\tif err != nil {\n85|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"authorize generation\", Err: errors.Join(ErrAuthorizationRefused, err)})\n86|\t}\n87|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n88|\t\treturn TrustStore{}, err\n89|\t}\n90|\tdocument, err := store.fs.ReadFile(path)\n91|\tif err != nil {\n92|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"authorize generation\", Err: errors.Join(ErrAuthorizationRefused, err)})\n93|\t}\n94|\tcommitted, err := DecodeTrust(document)\n95|\tif err != nil {\n96|\t\treturn TrustStore{}, err\n97|\t}\n98|\treturn committed, nil\n99|}\n100|\n101|func checkAuthorization(trust TrustStore, request AuthRequest) error {\n102|\tconst operation = \"authorize dispatch\"\n103|\tlocal, found := findEntry(trust, request.LocalCredentialID)\n104|\tif !found {\n105|\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n106|\t}\n107|\tif local.HostID.String() != request.LocalHostID || local.State != EntryActive {\n108|\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n109|\t}\n110|\tif err := VerifyProfile(local.LeafDER, local.RootDER, local.HostID.String(), request.Now); err != nil {\n111|\t\treturn trustError(TrustError{Operation: operation, Err: errors.Join(ErrAuthorizationRefused, err)})\n112|\t}\n113|\tremote, found := matchRemote(trust, request.RemoteLeafDER, request.RemoteRootDER)\n114|\tif !found {\n115|\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n116|\t}\n117|\tif err := VerifyProfile(remote.LeafDER, remote.RootDER, remote.HostID.String(), request.Now); err != nil {\n118|\t\treturn trustError(TrustError{Operation: operation, Err: errors.Join(ErrAuthorizationRefused, err)})\n119|\t}\n120|\tif remote.State == EntryRevoked {\n121|\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n122|\t}\n123|\tif remote.State == EntryRetiring {\n124|\t\tif remote.RetireAt == nil {\n125|\t\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n126|\t\t}\n127|\t\tretireAt, err := remote.RetireAt.Time()\n128|\t\tif err != nil || !request.Now.Before(retireAt) {\n129|\t\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n130|\t\t}\n131|\t}\n132|\tallowlisted := false\n133|\tfor _, hostID := range request.Allowlisted {\n134|\t\tif hostID == remote.HostID.String() {\n135|\t\t\tallowlisted = true\n136|\t\t\tbreak\n137|\t\t}\n138|\t}\n139|\tif !allowlisted {\n140|\t\treturn trustError(TrustError{Operation: operation, Err: ErrNotAllowlisted})\n141|\t}\n142|\tif request.HelloHostID != remote.HostID.String() || remote.HostID.String() != request.ExpectedRemoteHostID {\n143|\t\treturn trustError(TrustError{Operation: operation, Err: ErrHostIdentityMismatch})\n144|\t}\n145|\treturn nil\n146|}\n147|\n148|func findEntry(trust TrustStore, credentialID string) (CredentialEntry, bool) {\n149|\tfor _, entry := range trust.Entries {\n150|\t\tif entry.CredentialID.String() == credentialID {\n151|\t\t\treturn entry, true\n152|\t\t}\n153|\t}\n154|\treturn CredentialEntry{}, false\n155|}\n156|\n157|// matchRemote yields the verified UUID only on an exact leaf/root/SPKI match\n158|// against one currently admitted entry. Zero or multiple matches refuse; SAN\n159|// alone and CA membership alone are insufficient, which the byte-exact triple\n160|// comparison enforces structurally.\n161|func matchRemote(trust TrustStore, leafDER, rootDER []byte) (CredentialEntry, bool) {\n162|\tspki := spkiOf(leafDER)\n163|\tvar matched []CredentialEntry\n164|\tfor _, entry := range trust.Entries {\n165|\t\tif !bytes.Equal(entry.LeafDER, leafDER) || !bytes.Equal(entry.RootDER, rootDER) {\n166|\t\t\tcontinue\n167|\t\t}\n168|\t\tif spki == \"\" || entry.SPKIID.String() != spki {\n169|\t\t\tcontinue\n170|\t\t}\n171|\t\tmatched = append(matched, entry)\n172|\t}\n173|\tif len(matched) != 1 {\n174|\t\treturn CredentialEntry{}, false\n175|\t}\n176|\treturn matched[0], true\n177|}\n178|\n179|func spkiOf(leafDER []byte) string {\n180|\tder := mustSPKI(leafDER)\n181|\tif len(der) == 0 {\n182|\t\treturn \"\"\n183|\t}\n184|\treturn scalar.SHA256Digest(der).String()\n185|}\n186|\n187|// WithMutationAuthorization rechecks generation, credential validity,\n188|// allowlist membership and authenticated hello under the exclusive\n189|// authorization lock immediately before the externally visible side-effect\n190|// boundary, then runs the boundary while still holding the lock. The\n191|// generation check and the boundary serialize with revocation and config\n192|// commits. The request must bind the current generation: work prepared under\n193|// an old generation cannot gain new authority by refreshing a cached number,\n194|// so a stale binding refuses and the caller must discard its authorization\n195|// and replan through a fresh mutually authenticated connection. Boundaries\n196|// must be bounded: long provider calls must not hold the authorization lock\n197|// across unbounded work.\n198|func (store *Store) WithMutationAuthorization(request AuthRequest, boundary func() error) error {\n199|\tunlock, err := store.lock.exclusive()\n200|\tif err != nil {\n201|\t\treturn trustError(TrustError{Operation: \"authorize mutation\", Err: errors.Join(ErrAuthorizationRefused, err)})\n202|\t}\n203|\tdefer unlock()\n204|\tcurrent, err := readCommitted(store)\n205|\tif err != nil {\n206|\t\treturn err\n207|\t}\n208|\tif request.SnapshotGeneration != current.Generation {\n209|\t\treturn trustError(TrustError{Operation: \"authorize mutation\", Err: ErrStaleGeneration})\n210|\t}\n211|\tif err := checkAuthorization(current, request); err != nil {\n212|\t\treturn err\n213|\t}\n214|\tif boundary == nil {\n215|\t\treturn trustError(TrustError{Operation: \"authorize mutation\", Err: ErrAuthorizationRefused})\n216|\t}\n217|\treturn boundary()\n218|}","final_result":true}}}
