{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c77b","stream":{"kind":"session","id":"01a0aa44-08d9-7882-b782-d653915eefd3"},"sequence":536,"recorded_at":1780531400001067,"record_type":"event","durability":"durable","causation_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","run_stream":{"kind":"run","id":"bc8ec94b-72dd-41ff-812d-ceee7d051537"},"task_stream":{"kind":"task","id":"01a0aa45-21ba-7302-b7ce-eaa33469ea7a"},"task_id":"01a0aa45-21ba-7302-b7ce-eaa33469ea7a","event":{"kind":"output","task_id":"01a0aa45-21ba-7302-b7ce-eaa33469ea7a","chunk":"Read text file `internal/config/migration_v4_apply_test.go`.\n(329 line(s) above)\n330|\tif again.Migration.Changed {\n331|\t\tt.Fatal(\"second rollback reported a change on identical bytes\")\n332|\t}\n333|}\n334|\n335|// crownTrustAtExhaustion rewrites the fixture trust at the uint53 ceiling:\n336|// the next generation bump is genuinely refused, which faults the joint\n337|// commit after the configuration replacement is already durable.\n338|func crownTrustAtExhaustion(t *testing.T, fixture *v4Fixture) {\n339|\tt.Helper()\n340|\tsnapshot := fixture.trust(t)\n341|\tcrowned := hosttrust.TrustStore{Generation: hosttrust.MaxGeneration, Entries: snapshot.Trust.Entries}\n342|\tdocument, err := hosttrust.EncodeTrust(crowned)\n343|\tif err != nil {\n344|\t\tt.Fatalf(\"EncodeTrust(exhausted) error = %v\", err)\n345|\t}\n346|\tif err := os.WriteFile(filepath.Join(fixture.stateDir, \"host-channel\", \"trust.json\"), document, 0o600); err != nil {\n347|\t\tt.Fatal(err)\n348|\t}\n349|}\n350|\n351|// crashAfterReplaceFileSystem terminates the process with exit 77\n352|// immediately after the real configuration replacement rename lands. It\n353|// stages a genuine post-replacement crash: the marker is durable, the new\n354|// bytes are installed, and the generation bump never ran.\n355|type crashAfterReplaceFileSystem struct {\n356|\tosMigrationFileSystem\n357|\ttarget string\n358|}\n359|\n360|func (filesystem crashAfterReplaceFileSystem) Rename(from, to string) error {\n361|\tif err := filesystem.osMigrationFileSystem.Rename(from, to); err != nil {\n362|\t\treturn err\n363|\t}\n364|\tif to == filesystem.target {\n365|\t\tos.Exit(77)\n366|\t}\n367|\treturn nil\n368|}\n369|\n370|func TestApplyV4CrashConvergesGeneration(t *testing.T) {\n371|\tif directory := os.Getenv(\"AX_V4_CRASH_FIXTURE\"); directory != \"\" {\n372|\t\tfilename := filepath.Join(directory, \"config.toml\")\n373|\t\tstate := filepath.Join(directory, \"state\")\n374|\t\tinputs := Inputs{Platform: scalar.PlatformMacOS, HomeDir: directory, TempDir: directory, WorkingDir: directory, Stat: os.Stat, ReadFile: os.ReadFile, LookupEnv: func(key string) (string, bool) {\n375|\t\t\tif key == \"AX_CONFIG\" {\n376|\t\t\t\treturn filename, true\n377|\t\t\t}\n378|\t\t\tif key == \"AX_STATE_DIR\" {\n379|\t\t\t\treturn state, true\n380|\t\t\t}\n381|\t\t\treturn \"\", false\n382|\t\t}}\n383|\t\tstore, err := hosttrust.Open(state)\n384|\t\tif err != nil {\n385|\t\t\tt.Fatal(err)\n386|\t\t}\n387|\t\tsnapshot, err := store.ReadSnapshot()\n388|\t\tif err != nil {\n389|\t\t\tt.Fatal(err)\n390|\t\t}\n391|\t\tvar self string\n392|\t\tfor _, entry := range snapshot.Trust.Entries {\n393|\t\t\tif entry.HostID.String() == testHostID {\n394|\t\t\t\tself = entry.CredentialID.String()\n395|\t\t\t}\n396|\t\t}\n397|\t\tnow := time.Now().UTC()\n398|\t\tpreview, err := PreviewV4(inputs, nil, snapshot, self, nil, now)\n399|\t\tif err != nil {\n400|\t\t\tt.Fatal(err)\n401|\t\t}\n402|\t\t_, err = applyV4(inputs, nil, preview, true, now, crashAfterReplaceFileSystem{target: filename}, hosttrust.Open)\n403|\t\tt.Fatalf(\"crash seam not reached: %v\", err)\n404|\t}\n405|\tfixture := setupV4Fixture(t, testPeerID)\n406|\tbefore := fixture.trust(t).Generation\n407|\tcommand := exec.Command(os.Args[0], \"-test.run=^TestApplyV4CrashConvergesGeneration$\")\n408|\tcommand.Env = append(os.Environ(), \"AX_V4_CRASH_FIXTURE=\"+fixture.directory)\n409|\toutput, err := command.CombinedOutput()\n410|\texit, ok := err.(*exec.ExitError)\n411|\tif !ok || exit.ExitCode() != 77 {\n412|\t\tt.Fatalf(\"child did not crash at the replacement seam: %v %s\", err, output)\n413|\t}\n414|\t// Restart recovery must converge the pair: admitting the new Config4\n415|\t// with the old generation fails the test.\n416|\tloaded, err := Load(fixture.inputs, nil)\n417|\tif err != nil {\n418|\t\treturn\n419|\t}\n420|\tconfiguration, ok := loaded.Configuration()\n421|\tif !ok {\n422|\t\treturn\n423|\t}\n424|\treopened, err := hosttrust.Open(fixture.stateDir)\n425|\tif err != nil {\n426|\t\treturn\n427|\t}\n428|\tsnapshot, err := reopened.ReadSnapshot()\n429|\tif err != nil {\n430|\t\treturn\n431|\t}\n432|\tif configuration.SourceVersion == Version4 && snapshot.Generation == before {\n433|\t\tt.Fatalf(\"restart admits new Config4 with old generation %d after child exit 77\", before)\n434|\t}\n435|\tif configuration.SourceVersion != Version4 || snapshot.Generation != before+1 {\n436|\t\tt.Fatalf(\"restart converged to version %q generation %d, want 4.0.0/%d\", configuration.SourceVersion, snapshot.Generation, before+1)\n437|\t}\n438|}\n439|\n440|func TestApplyV4MarkerStagingFailureAborts(t *testing.T) {\n441|\tif os.Geteuid() == 0 {\n442|\t\tt.Skip(\"permission-bit staging does not bind the superuser\")\n443|\t}\n444|\tfixture := setupV4Fixture(t, testPeerID)\n445|\tpreview, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now)\n446|\tif err != nil {\n447|\t\tt.Fatalf(\"PreviewV4 error = %v\", err)\n448|\t}\n449|\t// The joint marker cannot stage in an unwritable trust directory: the\n450|\t// commit aborts before the configuration is touched, with no marker\n451|\t// left behind. The store opens before the directory loses its write\n452|\t// bit, so the failure lands in the commit, not in the open.\n453|\tchannel := filepath.Join(fixture.stateDir, \"host-channel\")\n454|\tpreopened, err := hosttrust.Open(fixture.stateDir)\n455|\tif err != nil {\n456|\t\tt.Fatal(err)\n457|\t}\n458|\tif err := os.Chmod(channel, 0o500); err != nil {\n459|\t\tt.Fatal(err)\n(more lines below)","final_result":true}}}
