{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ce37","stream":{"kind":"session","id":"01a0aa44-08d9-7882-b782-d653915eefd3"},"sequence":1398,"recorded_at":1780531400002791,"record_type":"event","durability":"durable","causation_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","run_stream":{"kind":"run","id":"bc8ec94b-72dd-41ff-812d-ceee7d051537"},"task_stream":{"kind":"task","id":"01a0aa4c-48b6-7e13-a25a-075d5772c17c"},"task_id":"01a0aa4c-48b6-7e13-a25a-075d5772c17c","event":{"kind":"output","task_id":"01a0aa4c-48b6-7e13-a25a-075d5772c17c","chunk":"edited\nchanged lines: lines 270-290\n--- original\n+++ updated\n@@\n-func TestRecoverConvergesAlreadyBumped(t *testing.T) {\n-\tsource := []byte(\"source configuration\\n\")\n-\treplacement := []byte(\"replacement configuration\\n\")\n-\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n-\tmarker := jointMarker(configPath, source, replacement, snapshot.Generation)\n-\tencoded, err := encodePendingCommit(marker)\n-\tif err != nil {\n-\t\tt.Fatal(err)\n-\t}\n-\tif err := commitDocument(store.fs, store.root, pendingPath(store.root), encoded); err != nil {\n-\t\tt.Fatal(err)\n-\t}\n-\tif err := os.WriteFile(configPath, replacement, 0o600); err != nil {\n-\t\tt.Fatal(err)\n-\t}\n-\t// The bump landed but marker removal did not: recovery converges\n-\t// without a second bump.\n-\tif err := store.transact(func(*TrustStore) error { return nil }); err != nil {\n-\t\tt.Fatal(err)\n-\t}\n-\tresult, err := store.Recover()\n+func TestRecoverConvergesAlreadyBumped(t *testing.T) {\n+\tsource := []byte(\"source configuration\\n\")\n+\treplacement := []byte(\"replacement configuration\\n\")\n+\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n+\t// The bump landed but marker removal did not: the transaction commits\n+\t// first, then the marker and the replaced bytes are staged exactly as\n+\t// a crash between the bump and the marker removal leaves them. The\n+\t// transaction must run before staging: every transaction converges\n+\t// pending intent first, so staging before transacting would complete\n+\t// the marker instead of leaving it outstanding.\n+\tif err := store.transact(func(*TrustStore) error { return nil }); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tmarker := jointMarker(configPath, source, replacement, snapshot.Generation)\n+\tencoded, err := encodePendingCommit(marker)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif err := commitDocument(store.fs, store.root, pendingPath(store.root), encoded); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif err := os.WriteFile(configPath, replacement, 0o600); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tresult, err := store.Recover()\n","final_result":true}}}
