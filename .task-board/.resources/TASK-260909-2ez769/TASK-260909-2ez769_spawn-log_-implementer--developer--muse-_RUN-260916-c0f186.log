{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c65d","stream":{"kind":"session","id":"01a0aa44-08d9-7882-b782-d653915eefd3"},"sequence":393,"recorded_at":1780531400000781,"record_type":"event","durability":"durable","causation_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","run_stream":{"kind":"run","id":"bc8ec94b-72dd-41ff-812d-ceee7d051537"},"task_stream":{"kind":"task","id":"01a0aa44-e1c2-7373-b265-f6088976cbc4"},"task_id":"01a0aa44-e1c2-7373-b265-f6088976cbc4","event":{"kind":"output","task_id":"01a0aa44-e1c2-7373-b265-f6088976cbc4","chunk":"Read text file `internal/hosttrust/joint.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"crypto/sha256\"\n6|\t\"encoding/hex\"\n7|\t\"encoding/json\"\n8|\t\"errors\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\t\"strconv\"\n12|)\n13|\n14|// pendingCommitFileName is the durable intent marker for one joint\n15|// config-plus-trust commit. It lives beside trust.json under the same\n16|// owner-only custody and crash-durable write discipline.\n17|const pendingCommitFileName = \"pending-commit.json\"\n18|\n19|// Joint operations coupled to a trust generation bump.\n20|const (\n21|\tJointApplyV4    = \"apply-v4\"\n22|\tJointRollbackV4 = \"rollback-v4\"\n23|)\n24|\n25|// PendingCommit is the durable intent record for one joint commit. The\n26|// hashes pin the exact configuration bytes the operator confirmed; the\n27|// source generation pins the trust state they were rendered against. Only\n28|// the confirmed replacement may complete forward; anything else aborts or\n29|// refuses on restart.\n30|type PendingCommit struct {\n31|\tSchema            string `json:\"schema\"`\n32|\tSchemaVersion     string `json:\"schema_version\"`\n33|\tOperation         string `json:\"operation\"`\n34|\tConfigPath        string `json:\"config_path\"`\n35|\tSourceSHA256      string `json:\"source_sha256\"`\n36|\tReplacementSHA256 string `json:\"replacement_sha256\"`\n37|\tSourceGeneration  uint64 `json:\"source_generation\"`\n38|\tBackupPath        string `json:\"backup_path\"`\n39|}\n40|\n41|// SHA256HexOf returns the lowercase hex SHA-256 of document bytes for\n42|// marker pins. It exposes no key material: markers pin configuration bytes\n43|// only, never credentials.\n44|func SHA256HexOf(document []byte) string {\n45|\tdigest := sha256.Sum256(document)\n46|\treturn hex.EncodeToString(digest[:])\n47|}\n48|\n49|func encodePendingCommit(marker PendingCommit) ([]byte, error) {\n50|\tif err := checkPendingCommit(marker); err != nil {\n51|\t\treturn nil, err\n52|\t}\n53|\tdocument, err := json.Marshal(marker)\n54|\tif err != nil {\n55|\t\treturn nil, trustError(TrustError{Operation: \"encode joint commit\", Err: errors.Join(ErrTrustDurability, err)})\n56|\t}\n57|\treturn document, nil\n58|}\n59|\n60|func checkPendingCommit(marker PendingCommit) error {\n61|\tconst operation = \"validate joint commit\"\n62|\tif marker.Schema != \"urn:ax:schema:host-pending-commit\" || marker.SchemaVersion != \"1.0.0\" {\n63|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n64|\t}\n65|\tif marker.Operation != JointApplyV4 && marker.Operation != JointRollbackV4 {\n66|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n67|\t}\n68|\tif !filepath.IsAbs(marker.ConfigPath) || marker.BackupPath == \"\" {\n69|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n70|\t}\n71|\tfor _, digest := range []string{marker.SourceSHA256, marker.ReplacementSHA256} {\n72|\t\traw, err := hex.DecodeString(digest)\n73|\t\tif err != nil || len(raw) != sha256.Size {\n74|\t\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n75|\t\t}\n76|\t}\n77|\tif marker.SourceSHA256 == marker.ReplacementSHA256 {\n78|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n79|\t}\n80|\tif marker.SourceGeneration == 0 || marker.SourceGeneration > MaxGeneration {\n81|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n82|\t}\n83|\treturn nil\n84|}\n85|\n86|func decodePendingCommit(document []byte) (PendingCommit, error) {\n87|\tvar marker PendingCommit\n88|\tif err := rejectDuplicateKeys(document); err != nil {\n89|\t\treturn PendingCommit{}, err\n90|\t}\n91|\t// The generation must be a bare JSON number, never a quoted string:\n92|\t// validate it through the same uint53 discipline as the trust document\n93|\t// before the struct decode, so a quoted number refuses as invalid\n94|\t// state rather than as a syntax error.\n95|\traw := map[string]json.RawMessage{}\n96|\tdecoder := json.NewDecoder(bytes.NewReader(document))\n97|\tdecoder.UseNumber()\n98|\tif err := decoder.Decode(&raw); err != nil {\n99|\t\treturn PendingCommit{}, trustError(TrustError{Operation: \"decode joint commit\", Err: errors.Join(ErrTrustDecode, err)})\n100|\t}\n101|\tgeneration, err := decodeMarkerGeneration(raw)\n102|\tif err != nil {\n103|\t\treturn PendingCommit{}, err\n104|\t}\n105|\tdecoder = json.NewDecoder(bytes.NewReader(document))\n106|\tdecoder.DisallowUnknownFields()\n107|\tdecoder.UseNumber()\n108|\tif err := decoder.Decode(&marker); err != nil {\n109|\t\treturn PendingCommit{}, trustError(TrustError{Operation: \"decode joint commit\", Err: errors.Join(ErrTrustDecode, err)})\n110|\t}\n111|\tif decoder.More() {\n112|\t\treturn PendingCommit{}, trustError(TrustError{Operation: \"decode joint commit\", Err: ErrTrustDecode})\n113|\t}\n114|\tmarker.SourceGeneration = generation\n115|\tif err := checkPendingCommit(marker); err != nil {\n116|\t\treturn PendingCommit{}, err\n117|\t}\n118|\treturn marker, nil\n119|}\n120|\n121|func parseUint53(text string) (uint64, error) {\n122|\tif text == \"\" {\n123|\t\treturn 0, errors.New(\"empty generation number\")\n124|\t}\n125|\tfor _, digit := range text {\n126|\t\tif digit < '0' || digit > '9' {\n127|\t\t\treturn 0, errors.New(\"non-digit generation number\")\n128|\t\t}\n129|\t}\n130|\tparsed, err := strconv.ParseUint(text, 10, 64)\n131|\tif err != nil {\n132|\t\treturn 0, err\n133|\t}\n134|\tif parsed == 0 || parsed > MaxGeneration {\n135|\t\treturn 0, errors.New(\"generation outside uint53\")\n136|\t}\n137|\treturn parsed, nil\n138|}\n139|\n140|func decodeMarkerGeneration(shape map[string]json.RawMessage) (uint64, error) {\n141|\traw, ok := shape[\"source_generation\"]\n142|\tif !ok {\n143|\t\treturn 0, trustError(TrustError{Operation: \"decode joint generation\", Err: ErrTrustValidation})\n144|\t}\n145|\tvar value any\n146|\tif err := strictJSONDecoder(raw).Decode(&value); err != nil {\n147|\t\treturn 0, trustError(TrustError{Operation: \"decode joint generation\", Err: errors.Join(ErrTrustDecode, err)})\n148|\t}\n149|\tnumber, ok := value.(json.Number)\n150|\tif !ok {\n151|\t\treturn 0, trustError(TrustError{Operation: \"decode joint generation\", Err: ErrTrustValidation})\n152|\t}\n153|\tparsed, err := parseUint53(number.String())\n154|\tif err != nil {\n155|\t\treturn 0, trustError(TrustError{Operation: \"decode joint generation\", Err: ErrTrustValidation})\n156|\t}\n157|\treturn parsed, nil\n158|}\n159|\n160|// JointCommit runs one crash-atomic authorization-generation commit coupled\n161|// to an external durable replacement (Configuration 4.0.0 apply or\n162|// rollback). Under a single exclusive hold it revalidates the confirmed\n163|// pins against committed trust, stages the durable intent marker, runs\n164|// replace (the configuration file replacement), bumps the generation, and\n165|// removes the marker.\n166|//\n167|//   - revalidate runs first, inside the lock: the preview, source and\n168|//     generation checks it repeats there close the concurrent-change window\n169|//     between the unlocked fast-fail checks and the commit.\n170|//   - A replace failure aborts with no generation change; the marker is\n171|//     removed because the configuration is untouched.\n172|//   - A trust-commit failure after replace keeps the marker: the caller\n173|//     must restore the source bytes, then call Recover, which observes the\n174|//     source hash and aborts cleanly. If the restore itself fails the\n175|//     marker stays for operator resolution and the joint error reports it.\n176|//   - Marker-removal failure after a durable bump still returns success:\n177|//     the joint state is already forward-complete, and the next Open\n178|//     converges by removing the marker.\n179|//\n180|// Only process crashes are covered by the restart protocol below; power\n181|// loss additionally depends on the disk honoring fsync, which no test here\n182|// can establish. Crash tests terminate a real child process at the\n183|// replacement seam and re-open the store in the parent.\n184|func (store *Store) JointCommit(marker PendingCommit, revalidate func(current TrustStore) error, replace func() error) (uint64, error) {\n185|\tconst operation = \"joint commit\"\n186|\tif revalidate == nil || replace == nil {\n187|\t\treturn 0, trustError(TrustError{Operation: operation, Err: ErrTrustDurability})\n188|\t}\n189|\tunlock, err := store.lock.exclusive()\n190|\tif err != nil {\n191|\t\treturn 0, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustDurability, err)})\n192|\t}\n193|\tdefer unlock()\n194|\tcommitted, err := loadCommitted(store.fs, store.root)\n195|\tif err != nil {\n196|\t\treturn 0, err\n197|\t}\n198|\tif err := revalidate(committed); err != nil {\n199|\t\treturn 0, err\n200|\t}\n201|\tif marker.SourceGeneration != committed.Generation {\n202|\t\treturn 0, trustError(TrustError{Operation: operation, Err: ErrStaleGeneration})\n203|\t}\n204|\tif err := checkPendingCommit(marker); err != nil {\n205|\t\treturn 0, err\n206|\t}\n207|\tif _, err := store.fs.Lstat(pendingPath(store.root)); err == nil {\n208|\t\treturn 0, trustError(TrustError{Operation: operation, Err: ErrJointIntervened})\n209|\t} else if !os.IsNotExist(err) {\n210|\t\treturn 0, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n211|\t}\n212|\tencoded, err := encodePendingCommit(marker)\n213|\tif err != nil {\n214|\t\treturn 0, err\n215|\t}\n216|\tif err := commitDocument(store.fs, store.root, pendingPath(store.root), encoded); err != nil {\n217|\t\treturn 0, err\n218|\t}\n219|\tif err := replace(); err != nil {\n220|\t\t_ = removeMarkerLocked(store.fs, store.root)\n221|\t\treturn 0, err\n222|\t}\n223|\tvar generation uint64\n224|\tif err := transactLocked(store.fs, store.root, func(trust *TrustStore) error {\n225|\t\tgeneration = trust.Generation + 1\n226|\t\treturn nil\n227|\t}); err != nil {\n228|\t\treturn 0, trustError(TrustError{Operation: \"commit joint generation\", Err: errors.Join(ErrJointReplacementDurable, err)})\n229|\t}\n230|\t// The replacement and the bump are both durable: converge the marker\n231|\t// removal on next open when this cleanup itself is interrupted.\n232|\t_ = removeMarkerLocked(store.fs, store.root)\n233|\treturn generation, nil\n234|}\n235|\n236|// RecoverResult reports what one recovery pass found.\n237|type RecoverResult struct {\n238|\t// Found reports a marker was present at all.\n239|\tFound bool\n240|\t// Completed reports the replacement had committed and the generation\n241|\t// converged forward to source plus one (or already had).\n242|\tCompleted bool\n243|\t// Aborted reports the replacement had not committed: the marker was\n244|\t// removed with no generation change.\n245|\tAborted bool\n246|}\n247|\n248|// Recover converges one interrupted joint commit found on disk. It runs\n249|// automatically on Open and after a caller-restored source, and is safe to\n250|// call directly:\n251|//\n252|//   - configuration equal to the replacement hash completes forward: a\n253|//     trust at the source generation bumps to source plus one; a trust\n254|//     already there only removes the marker.\n255|//   - configuration equal to the source hash aborts: the marker is removed\n256|//     with no generation change.\n257|//   - anything else (operator edit mid-flight, unreadable state) refuses\n258|//     and keeps the marker for operator resolution.\n259|//\n260|// A refused recovery fails Open, so a restart can never silently admit new\n261|// configuration with an old generation.\n262|func (store *Store) Recover() (RecoverResult, error) {\n263|\tunlock, err := store.lock.exclusive()\n264|\tif err != nil {\n265|\t\treturn RecoverResult{}, trustError(TrustError{Operation: \"recover joint commit\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n266|\t}\n267|\tdefer unlock()\n268|\treturn recoverLocked(store.fs, store.root)\n269|}\n270|\n271|func recoverLocked(filesystem FileSystem, root string) (RecoverResult, error) {\n272|\tconst operation = \"recover joint commit\"\n273|\tpath := pendingPath(root)\n274|\tif _, err := filesystem.Lstat(path); err != nil {\n275|\t\tif os.IsNotExist(err) {\n276|\t\t\treturn RecoverResult{}, nil\n277|\t\t}\n278|\t\treturn RecoverResult{}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n279|\t}\n280|\tinfo, err := filesystem.Lstat(path)\n281|\tif err != nil {\n282|\t\treturn RecoverResult{}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n283|\t}\n284|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n285|\t\treturn RecoverResult{}, err\n286|\t}\n287|\tdocument, err := filesystem.ReadFile(path)\n288|\tif err != nil {\n289|\t\treturn RecoverResult{}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n290|\t}\n291|\tmarker, err := decodePendingCommit(document)\n292|\tif err != nil {\n293|\t\treturn RecoverResult{Found: true}, err\n294|\t}\n295|\tconfiguration, err := filesystem.ReadFile(marker.ConfigPath)\n296|\tif err != nil {\n297|\t\treturn RecoverResult{Found: true}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n298|\t}\n299|\tswitch SHA256HexOf(configuration) {\n300|\tcase marker.ReplacementSHA256:\n301|\t\tcommitted, err := loadCommitted(filesystem, root)\n302|\t\tif err != nil {\n303|\t\t\treturn RecoverResult{Found: true}, err\n304|\t\t}\n305|\t\tswitch committed.Generation {\n306|\t\tcase marker.SourceGeneration:\n307|\t\t\tif err := transactLocked(filesystem, root, func(*TrustStore) error { return nil }); err != nil {\n308|\t\t\t\treturn RecoverResult{Found: true}, err\n309|\t\t\t}\n310|\t\tcase marker.SourceGeneration + 1:\n311|\t\tdefault:\n312|\t\t\treturn RecoverResult{Found: true}, trustError(TrustError{Operation: operation, Err: ErrJointIntervened})\n313|\t\t}\n314|\t\tif err := removeMarkerLocked(filesystem, root); err != nil {\n315|\t\t\treturn RecoverResult{Found: true}, err\n316|\t\t}\n317|\t\treturn RecoverResult{Found: true, Completed: true}, nil\n318|\tcase marker.SourceSHA256:\n319|\t\tif err := removeMarkerLocked(filesystem, root); err != nil {\n320|\t\t\treturn RecoverResult{Found: true}, err\n321|\t\t}\n322|\t\treturn RecoverResult{Found: true, Aborted: true}, nil\n323|\tdefault:\n324|\t\treturn RecoverResult{Found: true}, trustError(TrustError{Operation: operation, Err: ErrJointIntervened})\n325|\t}\n326|}\n327|\n328|func pendingPath(root string) string { return filepath.Join(root, pendingCommitFileName) }\n329|\n330|func removeMarkerLocked(filesystem FileSystem, root string) error {\n331|\tif err := filesystem.Remove(pendingPath(root)); err != nil && !os.IsNotExist(err) {\n332|\t\treturn trustError(TrustError{Operation: \"remove joint marker\", Err: errors.Join(ErrTrustDurability, err)})\n333|\t}\n334|\tif err := syncDir(filesystem, root); err != nil {\n335|\t\treturn trustError(TrustError{Operation: \"sync joint marker directory\", Err: errors.Join(ErrTrustDurability, err)})\n336|\t}\n337|\treturn nil\n338|}","final_result":true}}}
