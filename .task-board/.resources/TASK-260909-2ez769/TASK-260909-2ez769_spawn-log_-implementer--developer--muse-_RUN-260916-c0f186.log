= want.replace('sha256:', '')\\n            for root in (base, str(Path(base, 'files'))):\\n                candidate = Path(root, rel)\\n                if candidate.exists():\\n                    break\\n            else:\\n                print(' ', 'MISSING FILE', rel); continue\\n            got = hashlib.sha256(candidate.read_bytes()).hexdigest()\\n            if got == want:\\n                ok += 1\\n            else:\\n                print(' ', 'HASH MISMATCH', rel)\\n        print(f'  {ok}/{len(files)} match')\\nEOF\",\n  \"description\": \"Verify RPC preservation hashes\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"RPC-ABSENT-OK\\n===\\ncontrol-root manifest: present\\n  15/15 match\\nparked manifest: MISSING\\n\",\n  \"original_output_bytes\": 88,\n  \"original_output_tokens\": 22,\n  \"truncated\": false\n}","final_result":true}}}
