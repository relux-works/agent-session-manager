urn nil})}()\n26| <-entered\n27| revoked := make(chan error,1)\n28| go func(){revoked <- local.Revoke(pc)}()\n29| var early bool\n30| var revokeErr error\n31| select {case revokeErr= <-revoked: early=true; case <-time.After(250*time.Millisecond):}\n32| close(release)\n33| if err:= <-boundaryDone;err!=nil{t.Fatal(err)}\n34| if !early {revokeErr= <-revoked}\n35| if revokeErr !=nil {t.Fatal(revokeErr)}\n36| if early {t.Fatal(\"revocation reported success while mutation boundary still held prior authorization\")}\n37|}\n38|\n39|func TestReviewerSeparateStoreRevocationDuringBoundary(t *testing.T) {\n40| local, peer, lc, pc, snap, _ := twoHostFixture(t)\n41| leaf, root := peerMaterialForTest(t, peer, pc)\n42| req := dispatchRequest(snap, lc, pc, testHostB, leaf, root, []string{testHostA,testHostB}, testNow)\n43| other,err:=Open(filepath.Dir(local.Root()));if err!=nil{t.Fatal(err)}\n44| entered, release := make(chan struct{}), make(chan struct{})\n45| boundaryDone := make(chan error,1)\n46| go func(){boundaryDone <- local.WithMutationAuthorization(req,func() error{close(entered); <-release; return nil})}()\n47| <-entered\n48| revoked := make(chan error,1)\n49| go func(){revoked <- other.Revoke(pc)}()\n50| var early bool\n51| var revokeErr error\n52| select {case revokeErr= <-revoked: early=true; case <-time.After(250*time.Millisecond):}\n53| close(release)\n54| if err:= <-boundaryDone;err!=nil{t.Fatal(err)}\n55| if !early {revokeErr= <-revoked}\n56| if revokeErr !=nil {t.Fatal(revokeErr)}\n57| if early {t.Fatal(\"revocation reported success while mutation boundary still held prior authorization\")}\n58|}","final_result":true}}}
