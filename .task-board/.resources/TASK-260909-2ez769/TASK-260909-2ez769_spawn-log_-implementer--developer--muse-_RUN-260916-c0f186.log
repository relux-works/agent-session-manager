ion.BackupPath)) {\n306|\t\tt.Fatalf(\"pre-rollback copy %q escapes replication exclusion\", rolled.Migration.BackupPath)\n307|\t}\n308|\tif hosttrust.ExcludedConfigDirName(filepath.Base(fixture.filename)) {\n309|\t\tt.Fatalf(\"live configuration %q is excluded from replication\", fixture.filename)\n310|\t}\n311|}\n312|\n313|func TestRestoreSourceReportsFailedRecovery(t *testing.T) {\n314|\tstateDir := t.TempDir()\n315|\tstore, err := hosttrust.Open(stateDir)\n316|\tif err != nil {\n317|\t\tt.Fatal(err)\n318|\t}\n319|\tif _, err := store.Initialize(); err != nil {\n320|\t\tt.Fatal(err)\n321|\t}\n322|\t// A corrupt intent marker makes recovery fail deterministically: the\n323|\t// helper restores the source bytes, then reports the compound failure\n324|\t// with the marker kept and the original commit error preserved.\n325|\tchannel := filepath.Join(stateDir, \"host-channel\")\n326|\tif err := os.WriteFile(filepath.Join(channel, \"pending-commit.json\"), []byte(\"{corrupt\"), 0o600); err != nil {\n327|\t\tt.Fatal(err)\n328|\t}\n329|\tfilename := filepath.Join(t.TempDir(), \"config.toml\")\n330|\tsource := []byte(\"source configuration\\n\")\n331|\tif err := os.WriteFile(filename, []byte(\"intervened configuration\\n\"), 0o600); err != nil {\n332|\t\tt.Fatal(err)\n333|\t}\n334|\tcommitErr := errors.New(\"generation bump failed\")\n335|\terr = restoreSourceAfterJointFailure(osMigrationFileSystem{}, filename, source, store, commitErr)\n336|\tif err == nil {\n337|\t\tt.Fatal(\"restoreSourceAfterJointFailure(failed recovery) succeeded, want failure\")\n338|\t} else if !errors.Is(err, ErrMigrationRecovery) {\n339|\t\tt.Fatalf(\"restore error = %v, want recovery failure\", err)\n(more lines below)","final_result":true}}}
