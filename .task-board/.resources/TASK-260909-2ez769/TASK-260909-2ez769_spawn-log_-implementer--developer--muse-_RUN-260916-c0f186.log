{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c699","stream":{"kind":"session","id":"01a0aa44-08d9-7882-b782-d653915eefd3"},"sequence":423,"recorded_at":1780531400000841,"record_type":"event","durability":"durable","causation_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","run_stream":{"kind":"run","id":"bc8ec94b-72dd-41ff-812d-ceee7d051537"},"task_stream":{"kind":"task","id":"01a0aa44-ee7a-76d1-a18a-f5a18c611b85"},"task_id":"01a0aa44-ee7a-76d1-a18a-f5a18c611b85","event":{"kind":"output","task_id":"01a0aa44-ee7a-76d1-a18a-f5a18c611b85","chunk":"Read text file `internal/hosttrust/lock_unix.go`.\n1|//go:build darwin || linux\n2|\n3|package hosttrust\n4|\n5|import (\n6|\t\"errors\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"sync\"\n10|\n11|\t\"golang.org/x/sys/unix\"\n12|)\n13|\n14|// fileLock is the machine-local cross-process authorization lock shared by\n15|// trust changes and Configuration 4.0.0 peer/credential changes. Readers hold\n16|// it shared; transactions hold it exclusive, so a revocation or config commit\n17|// can never land between a dispatch check and its side-effect boundary.\n18|//\n19|// Every acquisition opens its own file description: flock locks attach to the\n20|// open file description, so goroutines sharing one retained descriptor would\n21|// not serialize. Per-acquisition descriptors make both same-process\n22|// goroutines and separate processes block on a held exclusive lock. A caller\n23|// must never request a second acquisition while holding one in the same\n24|// goroutine; internal reads nested inside a holder use descriptor-direct\n25|// unlocked reads instead of re-acquiring.\n26|type fileLock struct {\n27|\tpath string\n28|}\n29|\n30|// lockInitMu serializes concurrent creation of the lock file itself.\n31|var lockInitMu sync.Mutex\n32|\n33|func openLock(filesystem FileSystem, path string) (*fileLock, error) {\n34|\tlockInitMu.Lock()\n35|\tdefer lockInitMu.Unlock()\n36|\tinfo, err := filesystem.Lstat(path)\n37|\tif err != nil {\n38|\t\tif !os.IsNotExist(err) {\n39|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n40|\t\t}\n41|\t\tstaged, err := filesystem.CreateTemp(filepath.Dir(path), \"lock-stage-*\", 0o600)\n42|\t\tif err != nil {\n43|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n44|\t\t}\n45|\t\tname := staged.Name()\n46|\t\t_ = staged.Close()\n47|\t\tif err := filesystem.Rename(name, path); err != nil {\n48|\t\t\t_ = filesystem.Remove(name)\n49|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n50|\t\t}\n51|\t\tif err := filesystem.Chmod(path, 0o600); err != nil {\n52|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n53|\t\t}\n54|\t\tif err := secureStaged(path, false); err != nil {\n55|\t\t\treturn nil, err\n56|\t\t}\n57|\t\tinfo, err = filesystem.Lstat(path)\n58|\t\tif err != nil {\n59|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n60|\t\t}\n61|\t}\n62|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n63|\t\treturn nil, err\n64|\t}\n65|\treturn &fileLock{path: path}, nil\n66|}\n67|\n68|// openLockFD opens one private file description for a single acquisition.\n69|// O_NOFOLLOW refuses symlink escapes at open time; the descriptor never\n70|// follows a link swapped in after Lstat.\n71|func openLockFD(path string) (int, error) {\n72|\tfd, err := unix.Open(path, unix.O_RDWR|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)\n73|\tif err != nil {\n74|\t\tjoined := errors.Join(ErrTrustStoreUnreadable, err)\n75|\t\tif errors.Is(err, unix.ELOOP) {\n76|\t\t\tjoined = errors.Join(ErrTrustUnsafeCustody, err)\n77|\t\t}\n78|\t\treturn -1, trustError(TrustError{Operation: \"open lock\", Err: joined})\n79|\t}\n80|\treturn fd, nil\n81|}\n82|\n83|func (lock *fileLock) shared() (func(), error) {\n84|\tfd, err := openLockFD(lock.path)\n85|\tif err != nil {\n86|\t\treturn nil, err\n87|\t}\n88|\tif err := unix.Flock(fd, unix.LOCK_SH); err != nil {\n89|\t\t_ = unix.Close(fd)\n90|\t\treturn nil, err\n91|\t}\n92|\treturn func() {\n93|\t\t_ = unix.Flock(fd, unix.LOCK_UN)\n94|\t\t_ = unix.Close(fd)\n95|\t}, nil\n96|}\n97|\n98|func (lock *fileLock) exclusive() (func(), error) {\n99|\tfd, err := openLockFD(lock.path)\n100|\tif err != nil {\n101|\t\treturn nil, err\n102|\t}\n103|\tif err := unix.Flock(fd, unix.LOCK_EX); err != nil {\n104|\t\t_ = unix.Close(fd)\n105|\t\treturn nil, err\n106|\t}\n107|\treturn func() {\n108|\t\t_ = unix.Flock(fd, unix.LOCK_UN)\n109|\t\t_ = unix.Close(fd)\n110|\t}, nil\n111|}","final_result":true}}}
