{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc99","stream":{"kind":"session","id":"01a0aa44-08d9-7882-b782-d653915eefd3"},"sequence":1191,"recorded_at":1780531400002377,"record_type":"event","durability":"durable","causation_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","run_stream":{"kind":"run","id":"bc8ec94b-72dd-41ff-812d-ceee7d051537"},"task_stream":{"kind":"task","id":"01a0aa4b-6343-71d1-bd67-4236056a4afe"},"task_id":"01a0aa4b-6343-71d1-bd67-4236056a4afe","event":{"kind":"output","task_id":"01a0aa4b-6343-71d1-bd67-4236056a4afe","chunk":"edited\nchanged lines: lines 29-58\n--- original\n+++ updated\n@@\n-// WithSharedSnapshot runs fn under the shared authorization lock with the\n-// committed trust, so a config-plus-trust pair observed inside fn is\n-// coherent: no trust or config commit can land between the trust read and\n-// fn's own reads. Callers must not acquire the lock again inside fn;\n-// internal reads there use the supplied committed value directly.\n-func (store *Store) WithSharedSnapshot(fn func(current TrustStore) error) error {\n-\tunlock, err := store.lock.shared()\n-\tif err != nil {\n-\t\treturn trustError(TrustError{Operation: \"lock snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n-\t}\n-\tdefer unlock()\n-\tsnapshot, err := readSnapshotLocked(store.fs, store.root)\n-\tif err != nil {\n-\t\treturn err\n-\t}\n-\tcommitted := snapshot.Trust\n-\tif fn == nil {\n-\t\treturn trustError(TrustError{Operation: \"read snapshot\", Err: ErrAuthorizationRefused})\n-\t}\n-\treturn fn(committed)\n-}\n-\n-func readSnapshot(filesystem FileSystem, root string, lock *fileLock) (Snapshot, error) {\n-\tunlock, err := lock.shared()\n-\tif err != nil {\n-\t\treturn Snapshot{}, trustError(TrustError{Operation: \"lock snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n-\t}\n-\tdefer unlock()\n-\treturn readSnapshotLocked(filesystem, root)\n-}\n+// WithSharedSnapshot runs fn under the authorization lock with the\n+// committed trust, so a config-plus-trust pair observed inside fn is\n+// coherent: no trust or config commit can land between the trust read and\n+// fn's own reads. Pending joint intent converges before fn runs, so a\n+// surviving process observes the same converged pair as a reopened store.\n+// Callers must not acquire the lock again inside fn; internal reads there\n+// use the supplied committed value directly.\n+func (store *Store) WithSharedSnapshot(fn func(current TrustStore) error) error {\n+\tunlock, err := lockForConvergedRead(store.fs, store.root, store.lock)\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tdefer unlock()\n+\tsnapshot, err := readSnapshotLocked(store.fs, store.root)\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tcommitted := snapshot.Trust\n+\tif fn == nil {\n+\t\treturn trustError(TrustError{Operation: \"read snapshot\", Err: ErrAuthorizationRefused})\n+\t}\n+\treturn fn(committed)\n+}\n+\n+func readSnapshot(filesystem FileSystem, root string, lock *fileLock) (Snapshot, error) {\n+\tunlock, err := lockForConvergedRead(filesystem, root, lock)\n+\tif err != nil {\n+\t\treturn Snapshot{}, err\n+\t}\n+\tdefer unlock()\n+\treturn readSnapshotLocked(filesystem, root)\n+}\n+\n+// lockForConvergedRead holds the authorization lock for one coherent read,\n+// converging pending joint intent first. The fast path keeps the shared\n+// lock when no marker is present: staging a marker needs the exclusive\n+// lock, so absence observed under shared hold still holds at the read.\n+// When a marker is present the shared lock is released before the\n+// exclusive lock is acquired (a held shared lock can never upgrade in\n+// place without risking a cross-process upgrade deadlock), the leftover\n+// converges or refuses, and the read proceeds under the exclusive hold.\n+// Convergence may move the generation forward; callers compare request\n+// bindings against the converged read, never by refreshing a stale number.\n+func lockForConvergedRead(filesystem FileSystem, root string, lock *fileLock) (func(), error) {\n+\tunlock, err := lock.shared()\n+\tif err != nil {\n+\t\treturn nil, trustError(TrustError{Operation: \"lock snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n+\t}\n+\tpresent, err := markerPresent(filesystem, root)\n+\tif err != nil {\n+\t\tunlock()\n+\t\treturn nil, err\n+\t}\n+\tif !present {\n+\t\treturn unlock, nil\n+\t}\n+\tunlock()\n+\tunlock, err = lock.exclusive()\n+\tif err != nil {\n+\t\treturn nil, trustError(TrustError{Operation: \"lock snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n+\t}\n+\tif err := convergeLocked(filesystem, root); err != nil {\n+\t\tunlock()\n+\t\treturn nil, err\n+\t}\n+\treturn unlock, nil\n+}\n","final_result":true}}}
