{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb91","stream":{"kind":"session","id":"01a0aa44-08d9-7882-b782-d653915eefd3"},"sequence":1059,"recorded_at":1780531400002113,"record_type":"event","durability":"durable","causation_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","run_stream":{"kind":"run","id":"bc8ec94b-72dd-41ff-812d-ceee7d051537"},"task_stream":{"kind":"task","id":"01a0aa4a-8aa2-7250-8be2-68185ef870d7"},"task_id":"01a0aa4a-8aa2-7250-8be2-68185ef870d7","event":{"kind":"output","task_id":"01a0aa4a-8aa2-7250-8be2-68185ef870d7","chunk":"Read text file `internal/hosttrust/joint_test.go`.\n(139 line(s) above)\n140|\n141|func TestRecoverCompletesForwardAfterCrash(t *testing.T) {\n142|\tsource := []byte(\"source configuration\\n\")\n143|\treplacement := []byte(\"replacement configuration\\n\")\n144|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n145|\t// Stage exactly what a crash between the configuration replacement and\n146|\t// the generation bump leaves: the marker plus the replaced bytes with\n147|\t// the old generation still committed.\n148|\tmarker := jointMarker(configPath, source, replacement, snapshot.Generation)\n149|\tencoded, err := encodePendingCommit(marker)\n150|\tif err != nil {\n151|\t\tt.Fatal(err)\n152|\t}\n153|\tif err := commitDocument(store.fs, store.root, pendingPath(store.root), encoded); err != nil {\n154|\t\tt.Fatal(err)\n155|\t}\n156|\tif err := os.WriteFile(configPath, replacement, 0o600); err != nil {\n157|\t\tt.Fatal(err)\n158|\t}\n159|\tresult, err := store.Recover()\n160|\tif err != nil {\n161|\t\tt.Fatalf(\"Recover error = %v\", err)\n162|\t}\n163|\tif !result.Found || !result.Completed || result.Aborted {\n164|\t\tt.Fatalf(\"Recover = %+v, want found+completed\", result)\n165|\t}\n166|\tfresh, err := store.ReadSnapshot()\n167|\tif err != nil {\n168|\t\tt.Fatal(err)\n169|\t}\n170|\tif fresh.Generation != snapshot.Generation+1 {\n171|\t\tt.Fatalf(\"recovered generation = %d, want %d\", fresh.Generation, snapshot.Generation+1)\n172|\t}\n173|\tif _, err := os.Lstat(pendingPath(store.root)); !os.IsNotExist(err) {\n174|\t\tt.Fatalf(\"joint marker remains after recovery: %v\", err)\n175|\t}\n176|}\n177|\n178|func TestOpenConvergesInterruptedCommit(t *testing.T) {\n179|\tsource := []byte(\"source configuration\\n\")\n180|\treplacement := []byte(\"replacement configuration\\n\")\n181|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n182|\tmarker := jointMarker(configPath, source, replacement, snapshot.Generation)\n183|\tencoded, err := encodePendingCommit(marker)\n184|\tif err != nil {\n185|\t\tt.Fatal(err)\n186|\t}\n187|\tif err := commitDocument(store.fs, store.root, pendingPath(store.root), encoded); err != nil {\n188|\t\tt.Fatal(err)\n189|\t}\n190|\tif err := os.WriteFile(configPath, replacement, 0o600); err != nil {\n191|\t\tt.Fatal(err)\n192|\t}\n193|\t// Re-opening the same state directory must converge the interrupted\n194|\t// commit instead of admitting the replacement with the old generation.\n195|\tstateDir := filepath.Dir(store.root)\n196|\treopened, err := openStore(stateDir, osFileSystem{})\n197|\tif err != nil {\n198|\t\tt.Fatalf(\"openStore after crash error = %v\", err)\n199|\t}\n200|\tconverged, err := reopened.ReadSnapshot()\n201|\tif err != nil {\n202|\t\tt.Fatal(err)\n203|\t}\n204|\tif converged.Generation != snapshot.Generation+1 {\n205|\t\tt.Fatalf(\"reopened generation = %d, want %d\", converged.Generation, snapshot.Generation+1)\n206|\t}\n207|}\n208|\n209|func TestRecoverAbortsWhenReplacementAbsent(t *testing.T) {\n210|\tsource := []byte(\"source configuration\\n\")\n211|\treplacement := []byte(\"replacement configuration\\n\")\n212|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n213|\t// A crash before the configuration replacement leaves the source bytes\n214|\t// with the marker outstanding: recovery aborts with no generation change.\n215|\tmarker := jointMarker(configPath, source, replacement, snapshot.Generation)\n216|\tencoded, err := encodePendingCommit(marker)\n217|\tif err != nil {\n218|\t\tt.Fatal(err)\n219|\t}\n220|\tif err := commitDocument(store.fs, store.root, pendingPath(store.root), encoded); err != nil {\n221|\t\tt.Fatal(err)\n222|\t}\n223|\tresult, err := store.Recover()\n224|\tif err != nil {\n225|\t\tt.Fatalf(\"Recover error = %v\", err)\n226|\t}\n227|\tif !result.Found || !result.Aborted || result.Completed {\n228|\t\tt.Fatalf(\"Recover = %+v, want found+aborted\", result)\n229|\t}\n230|\tfresh, err := store.ReadSnapshot()\n231|\tif err != nil {\n232|\t\tt.Fatal(err)\n233|\t}\n234|\tif fresh.Generation != snapshot.Generation {\n235|\t\tt.Fatalf(\"aborted recovery moved generation to %d\", fresh.Generation)\n236|\t}\n237|}\n238|\n239|func TestRecoverRefusesIntervention(t *testing.T) {\n240|\tsource := []byte(\"source configuration\\n\")\n241|\treplacement := []byte(\"replacement configuration\\n\")\n242|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n243|\tmarker := jointMarker(configPath, source, replacement, snapshot.Generation)\n244|\tencoded, err := encodePendingCommit(marker)\n245|\tif err != nil {\n246|\t\tt.Fatal(err)\n247|\t}\n248|\tif err := commitDocument(store.fs, store.root, pendingPath(store.root), encoded); err != nil {\n249|\t\tt.Fatal(err)\n250|\t}\n251|\t// An operator edit mid-flight matches neither the source nor the\n252|\t// replacement hash: recovery refuses and keeps the marker.\n253|\tif err := os.WriteFile(configPath, []byte(\"operator edit\\n\"), 0o600); err != nil {\n254|\t\tt.Fatal(err)\n255|\t}\n256|\tif _, err := store.Recover(); err == nil {\n257|\t\tt.Fatal(\"Recover(intervened) succeeded, want refusal\")\n258|\t} else if !errors.Is(err, ErrJointIntervened) {\n259|\t\tt.Fatalf(\"Recover error = %v, want ErrJointIntervened\", err)\n2