{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb61","stream":{"kind":"session","id":"01a0aa44-08d9-7882-b782-d653915eefd3"},"sequence":1035,"recorded_at":1780531400002065,"record_type":"event","durability":"durable","causation_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","run_stream":{"kind":"run","id":"bc8ec94b-72dd-41ff-812d-ceee7d051537"},"call_id":"call_01a0aa4a7487704b9ca914391cad8842","text":"Read text file `internal/hosttrust/custody_unix.go`.\n1|//go:build !windows\n2|\n3|package hosttrust\n4|\n5|import (\n6|\t\"errors\"\n7|\t\"io/fs\"\n8|\t\"os\"\n9|\t\"syscall\"\n10|)\n11|\n12|// platformModeOK reports whether Unix permission bits satisfy the exact\n13|// owner-only requirement. Any group/world access already refuses here.\n14|func platformModeOK(info fs.FileInfo, mode fs.FileMode) bool {\n15|\treturn info.Mode().Perm() == mode\n16|}\n17|\n18|// secureStaged is a no-op on Unix: staging files are created with exact\n19|// owner-only modes, which the caller verifies after install.\n20|func secureStaged(_ string, _ bool) error { return nil }\n21|\n22|// verifyOwner enforces owner-only custody on Unix: the path must belong to\n23|// the effective UID. Mode bits are checked by the caller against the exact\n24|// 0700/0600 requirement, so any group/world access already refused there.\n25|func verifyOwner(_ string, info fs.FileInfo) error {\n26|\tstat, ok := info.Sys().(*syscall.Stat_t)\n27|\tif !ok {\n28|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: errors.Join(ErrTrustUnsafeCustody, errors.New(\"ownership metadata unavailable\"))})\n29|\t}\n30|\tif stat.Uid != uint32(os.Geteuid()) {\n31|\t\treturn trustError(TrustError{Operation: \"inspect ownership\", Err: ErrTrustUnsafeCustody})\n32|\t}\n33|\treturn nil\n34|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
