{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000df1d","stream":{"kind":"session","id":"01a0aa44-08d9-7882-b782-d653915eefd3"},"sequence":3561,"recorded_at":1780531400007117,"record_type":"event","durability":"durable","causation_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","run_stream":{"kind":"run","id":"bc8ec94b-72dd-41ff-812d-ceee7d051537"},"task_stream":{"kind":"task","id":"01a0aa61-47b0-7e30-ae93-37cac1086b96"},"task_id":"01a0aa61-47b0-7e30-ae93-37cac1086b96","event":{"kind":"output","task_id":"01a0aa61-47b0-7e30-ae93-37cac1086b96","chunk":"{\n  \"chunk_id\": \"exec-77-1\",\n  \"command\": \"sed -n '300,376p' .github/workflows/ci.yml\",\n  \"description\": \"Read final CI jobs\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"    timeout-minutes: 10\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      # The vocabulary is secconftest's probe set; the gate scans the README\\n      # with every probe forced unavailable — the strongest posture, and\\n      # host-independent: a backticked capability mention that reads as a\\n      # positive availability claim is refused no matter what this host's\\n      # probes would report. CheckAdvertisements reads ProbeState.Available\\n      # from the states it is given, and both postures are driven\\n      # (TestRealREADMECarriesNoPositiveClaim forces all unavailable,\\n      # TestRealREADMEAdmitsWhenAllAvailable forces all available). What\\n      # reaches no availability reader is the live probe outcome:\\n      # ProbeStates feeds only CapabilityIDs, which keeps the IDs and\\n      # drops availability. README prose is never capability evidence\\n      # either way.\\n      - name: Check README with all probes forced unavailable\\n        run: |\\n          set +e\\n          go test ./internal/cigate -run 'TestRealREADMECarriesNoPositiveClaim|TestRealREADMEAdmitsWhenAllAvailable|TestCapabilityIDsAreDerivedSorted|TestPositiveClaimsAreRefused|TestNegatedClaimsAreAdmitted|TestUnclassifiedMentionIsRefused' -count=1 -v > cigate-claims.log 2>&1\\n          code=$?\\n          set -e\\n          cat cigate-claims.log\\n          test $code -eq 0\\n          for gate in TestRealREADMECarriesNoPositiveClaim TestRealREADMEAdmitsWhenAllAvailable TestCapabilityIDsAreDerivedSorted TestPositiveClaimsAreRefused TestNegatedClaimsAreAdmitted TestUnclassifiedMentionIsRefused; do\\n            grep -q \\\"^--- PASS: ${gate}\\\" cigate-claims.log\\n          done\\n\\n  windows-compile-only:\\n    name: Windows compile-only (no execution implied)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 10\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      # Compile-and-vet only: go vet type-checks test files as well, and no\\n      # step here executes a Windows binary. A green here must never be read\\n      # as behaviour executed on Windows.\\n      - name: Compile for Windows\\n        run: GOOS=windows go build ./...\\n\\n      - name: Vet Windows build (includes test files)\\n        run: GOOS=windows go vet ./...\\n\\n  gates-verdict:\\n    name: All gates green, none skipped\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 5\\n    needs:\\n      - contract-preservation\\n      - lint\\n      - test\\n      - race\\n      - coverage\\n      - fixture-matrix\\n      - fuzz-smoke\\n      - capability-claims\\n      - windows-compile-only\\n    if: always()\\n    steps:\\n      - name: Refuse any non-success dependency\\n        run: |\\n          echo '${{ toJSON(needs) }}' > needs.json\\n          jq . needs.json\\n          jq -e 'to_entries | map(select(.value.result != \\\"success\\\")) | length == 0' needs.json\\n\",\n  \"original_output_bytes\": 3037,\n  \"original_output_tokens\": 760,\n  \"truncated\": false\n}","final_result":true}}}
