that differs from the\n53|\t// uniquely verified enrolled host UUID. The string is the spec refusal\n54|\t// identity shared with peeridentity.ErrHostIdentityMismatch; pinned\n55|\t// equal by test for the same reason as ErrNotAllowlisted.\n56|\tErrHostIdentityMismatch = errors.New(\"host_identity_mismatch\")\n57|\t// ErrInvalidStoreContext reports a store rooted outside an absolute\n58|\t// state directory or otherwise unusable as machine-local authority.\n59|\tErrInvalidStoreContext = errors.New(\"invalid host trust store context\")\n60|\t// ErrJointReplacementDurable reports a joint commit whose external\n61|\t// replacement is durable but whose generation bump failed. The intent\n62|\t// marker is kept: the caller must restore the source bytes and converge\n63|\t// through Recover, which then aborts cleanly.\n64|\tErrJointReplacementDurable = errors.New(\"host trust joint replacement durable without generation\")\n65|\t// ErrJointIntervened reports a joint config-plus-trust commit that\n66|\t// cannot converge: the configuration or the generation moved outside\n67|\t// the confirmed pins while the intent marker was outstanding. The\n68|\t// marker is kept for operator resolution; the restart refuses.\n69|\tErrJointIntervened = errors.New(\"host trust joint commit was superseded\")\n70|)\n71|\n72|// TrustError renders a static clause without machine-local values, paths,\n73|// fingerprints, UUIDs or key material. Wrapped details stay available to\n74|// errors.Is/errors.As through Unwrap.\n75|type TrustError struct {\n76|\tOperation string\n77|\tErr       error\n78|}\n79|\n80|func (err *TrustError) Error() string { return \"host trust \" + err.Operation + \" failed\" }\n81|func (err *TrustError) Unwrap() error { return err.Err }\n82|\n83|// trustError is the only construction site for *TrustError.\n84|var trustError = func(value TrustError) error { return &value }","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7bb","stream":{"kind":"session","id":"01a0aa44-08d9-7882-b782-d653915eefd3"},"sequence":568,"recorded_at":1780531400001131,"record_type":"event","durability":"durable","causation_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","run_stream":{"kind":"run","id":"bc8ec94b-72dd-41ff-812d-ceee7d051537"},"call_id":"call_01a0aa452ac97339b7622aae7efa706d","text":"Read text file `internal/hosttrust/export.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"path\"\n6|\t\"path/filepath\"\n7|\t\"strings\"\n8|)\n9|\n10|// EnrollmentMaterial is the explicitly selected public enrollment material an\n11|// operator exchanges out of band. It carries no private key: only\n12|// certificate.pem and root.pem bytes leave the store, never private-key.pem,\n13|// trust internals, backups or authorization caches.\n14|type EnrollmentMaterial struct {\n15|\tHostID       string\n16|\tCredentialID string\n17|\tLeafDER      []byte\n18|\tRootDER      []byte\n19|\tFingerprints Fingerprints\n20|}\n21|\n22|// Formatting enrollment material redacts DER bytes by default; the operator\n23|// exports explicit fields, never a log line.\n24|func (EnrollmentMaterial) String() string   { return \"host enrollment material\" }\n25|func (EnrollmentMaterial) GoString() string { return \"host enrollment material\" }\n26|func (EnrollmentMaterial) Format(state fmt.State, verb rune) {\n27|\t_, _ = state.Write([]byte(\"host enrollment material\"))\n28|}\n29|\n30|// ExportEnrollment selects the public bytes of one non-revoked entry for\n31|// out-of-band exchange. Revoked tombstones never redistribute: exporting one\n32|// refuses.\n33|func ExportEnrollment(snapshot Snapshot, credentialID string) (EnrollmentMaterial, error) {\n34|\tentry, found := findEntry(snapshot.Trust, credentialID)\n35|\tif !found {\n36|\t\treturn EnrollmentMaterial{}, trustError(TrustError{Operation: \"export enrollment\", Err: ErrEnrollmentRefused})\n37|\t}\n38|\tif entry.State == EntryRevoked {\n39|\t\treturn EnrollmentMaterial{}, trustError(TrustError{Operation: \"export enrollment\", Err: ErrEnrollmentRefused})\n40|\t}\n41|\tfingerprints, err := FingerprintsOf(entry.LeafDER, entry.RootDER)\n42|\tif err != nil {\n43|\t\treturn EnrollmentMaterial{}, err\n44|\t}\n45|\treturn EnrollmentMaterial{\n46|\t\tHostID:       entry.HostID.String(),\n47|\t\tCredentialID: entry.CredentialID.String(),\n48|\t\tLeafDER:      append([]byte(nil), entry.LeafDER...),\n49|\t\tRootDER:      append([]byte(nil), entry.RootDER...),\n50|\t\tFingerprints: fingerprints,\n51|\t}, nil\n52|}\n53|\n54|// ExcludedFromReplication lists the STATE_DIR-relative paths that must never\n55|// enter replication, snapshots, cloning, Session Directory, logs or exported\n56|// diagnostic bundles. Credential, trust, backup, private-key and\n57|// authorization-cache material stays machine-local; operators exchange only\n58|// explicitly selected public enrollment material outside replication.\n59|func ExcludedFromReplication() []string {\n60|\treturn []string{\n61|\t\thostChannelDir + \"/trust.json\",\n62|\t\thostChannelDir + \"/pending-commit.json\",\n63|\t\thostChannelDir + \"/credentials/\",\n64|\t\thostChannelDir + \"/lock\",\n65|\t}\n66|}\n67|\n68|// MatchExcludedFromReplication reports whether a STATE_DIR-relative path\n69|// must stay out of replication, snapshots, cloning, Session Directory, logs\n70|// and exported diagnostic bundles. It covers the listed control paths plus\n71|// transient staging files, which carry the same material under rotating\n72|// names. Any path that escapes the state directory fails closed as\n73|// excluded. Every replication, snapshot, clone or diagnostic export surface\n74|// must consult this matcher (and ExcludedConfigDirName for configuration\n75|// directory files) and drop matches; ExportEnrollment material is\n76|// deliberately NOT excluded, since explicitly selected public bytes are the\n77|// only operator exchange outside replication.\n78|func MatchExcludedFromReplication(relative string) bool {\n79|\tif relative == \"\" || relative == \".\" {\n80|\t\treturn false\n81|\t}\n82|\tslash := filepath.ToSlash(relative)\n83|\tif path.IsAbs(slash) {\n84|\t\treturn true\n85|\t}\n86|\tfor _, segment := range strings.Split(slash, \"/\") {\n87|\t\tif segment == \"..\" {\n88|\t\t\treturn true\n89|\t\t}\n90|\t}\n91|\ttrimmed := path.Clean(slash)\n92|\tfor _, listed := range ExcludedFromReplication() {\n93|\t\tclean := path.Clean(listed)\n94|\t\tif trimmed == clean || strings.HasPrefix(trimmed, clean+\"/\") {\n95|\t\t\treturn true\n96|\t\t}\n97|\t}\n98|\tbase := path.Base(trimmed)\n99|\tfor _, prefix := range []string{stagePrefix, \".custody-stage-\", \"lock-stage-\"} {\n100|\t\tif strings.HasPrefix(base, prefix) {\n101|\t\t\treturn true\n102|\t\t}\n103|\t}\n104|\treturn false\n105|}\n106|\n107|// ExcludedConfigDirName reports whether a configuration-directory file name\n108|// carries trust-adjacent material that must stay out of replication: owner-only\n109|// backups, pre-rollback copies and transient migration staging files. Backup\n110|// names embed the source version (\".bak.<version>\"), so the match is by\n111|// infix, pinned against the names replaceDurably actually publishes.\n112|func ExcludedConfigDirName(base string) bool {\n113|\tname := path.Base(filepath.ToSlash(base))\n114|\tif strings.Contains(name, \".pre-rollback.\") {\n115|\t\treturn true\n116|\t}\n117|\tif strings.HasPrefix(name, \".ax-config-\") {\n118|\t\treturn true\n119|\t}\n120|\tif strings.Contains(name, \".bak.\") {\n121|\t\treturn true\n122|\t}\n123|\treturn false\n124|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
