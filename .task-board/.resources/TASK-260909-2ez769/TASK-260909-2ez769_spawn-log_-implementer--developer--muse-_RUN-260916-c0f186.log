{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d0c7","stream":{"kind":"session","id":"01a0aa44-08d9-7882-b782-d653915eefd3"},"sequence":1726,"recorded_at":1780531400003447,"record_type":"event","durability":"durable","causation_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","run_stream":{"kind":"run","id":"bc8ec94b-72dd-41ff-812d-ceee7d051537"},"task_stream":{"kind":"task","id":"01a0aa4f-0fb1-7631-b170-555c6b81eccb"},"task_id":"01a0aa4f-0fb1-7631-b170-555c6b81eccb","event":{"kind":"output","task_id":"01a0aa4f-0fb1-7631-b170-555c6b81eccb","chunk":"Read text file `internal/hosttrust/custody_test.go`.\n(78 line(s) above)\n79|func TestCustodyRefusals(t *testing.T) {\n80|\tif os.Geteuid() == 0 {\n81|\t\tt.Skip(\"permission-bit refusals do not bind the superuser\")\n82|\t}\n83|\tstate := t.TempDir()\n84|\tstore := openForTest(t, state)\n85|\tif _, err := store.Initialize(); err != nil {\n86|\t\tt.Fatal(err)\n87|\t}\n88|\troot := filepath.Join(state, hostChannelDir)\n89|\ttests := []struct {\n90|\t\tname  string\n91|\t\tapply func() func()\n92|\t}{\n93|\t\t{\"group readable directory\", func() func() {\n94|\t\t\tif err := os.Chmod(root, 0o750); err != nil {\n95|\t\t\t\tt.Fatal(err)\n96|\t\t\t}\n97|\t\t\treturn func() { _ = os.Chmod(root, 0o700) }\n98|\t\t}},\n99|\t\t{\"world readable trust file\", func() func() {\n100|\t\t\tif err := os.Chmod(store.TrustPath(), 0o644); err != nil {\n101|\t\t\t\tt.Fatal(err)\n102|\t\t\t}\n103|\t\t\treturn func() { _ = os.Chmod(store.TrustPath(), 0o600) }\n104|\t\t}},\n105|\t}\n106|\tfor _, test := range tests {\n107|\t\tt.Run(test.name, func(t *testing.T) {\n108|\t\t\trestore := test.apply()\n109|\t\t\tdefer restore()\n110|\t\t\tfresh, err := Open(state)\n111|\t\t\tif err == nil {\n112|\t\t\t\t_ = fresh\n113|\t\t\t\tif _, err := fresh.ReadSnapshot(); err == nil {\n114|\t\t\t\t\tt.Fatalf(\"ReadSnapshot(%s) succeeded, want refusal\", test.name)\n115|\t\t\t\t} else if !errors.Is(err, ErrTrustUnsafeCustody) {\n116|\t\t\t\t\tt.Fatalf(\"ReadSnapshot(%s) error = %v, want ErrTrustUnsafeCustody\", test.name, err)\n117|\t\t\t\t}\n118|\t\t\t} else if !errors.Is(err, ErrTrustUnsafeCustody) {\n119|\t\t\t\tt.Fatalf(\"Open(%s) error = %v, want ErrTrustUnsafeCustody\", test.name, err)\n120|\t\t\t}\n121|\t\t})\n122|\t}\n123|}\n124|\n125|func TestValidateCustodyBindsDirectory(t *testing.T) {\n126|\tstate := t.TempDir()\n127|\tstore := openForTest(t, state)\n128|\tif _, err := store.Initialize(); err != nil {\n129|\t\tt.Fatal(err)\n130|\t}\n131|\tcredential, err := store.Issue(testHostA, testNow)\n132|\tif err != nil {\n133|\t\tt.Fatal(err)\n134|\t}\n135|\tleafHex := strings.TrimPrefix(credential, \"sha256:\")\n136|\tif err := store.ValidateCustody(leafHex, testHostA, testNow); err != nil {\n137|\t\tt.Fatalf(\"ValidateCustody(matching directory) error = %v\", err)\n138|\t}\n139|\t// A directory named by the root digest holding the same valid files\n140|\t// selects no identity: the contained leaf must reproduce the directory.\n141|\tsnapshot, err := store.ReadSnapshot()\n142|\tif err != nil {\n143|\t\tt.Fatal(err)\n144|\t}\n145|\tentry, found := findEntry(snapshot.Trust, credential)\n146|\tif !found {\n147|\t\tt.Fatal(\"issued credential has no trust entry\")\n148|\t}\n149|\trootHex := entry.RootID.Hex()\n150|\tif rootHex == leafHex {\n151|\t\tt.Fatal(\"fixture digests collide\")\n152|\t}\n153|\tcredentialsRoot := filepath.Join(state, hostChannelDir, credentialsDir)\n154|\tif err := os.Rename(filepath.Join(credentialsRoot, leafHex), filepath.Join(credentialsRoot, rootHex)); err != nil {\n155|\t\tt.Fatal(err)\n156|\t}\n157|\tif err := store.ValidateCustody(rootHex, testHostA, testNow); err == nil {\n158|\t\tt.Fatal(\"ValidateCustody(root-named directory) succeeded, want refusal\")\n159|\t} else if !errors.Is(err, ErrCredentialCustody) {\n160|\t\tt.Fatalf(\"ValidateCustody(root-named directory) error = %v, want ErrCredentialCustody\", err)\n161|\t}\n162|}\n163|\n164|func TestTrustSymlinkRefused(t *testing.T) {\n165|\tstate := t.TempDir()\n166|\tstore := openForTest(t, state)\n167|\tif _, err := store.Initialize(); err != nil {\n168|\t\tt.Fatal(err)\n169|\t}\n170|\tshadow := filepath.Join(state, \"shadow.json\")\n171|\tif err := os.WriteFile(shadow, []byte(\"{}\"), 0o600); err != nil {\n172|\t\tt.Fatal(err)\n173|\t}\n174|\tif err := os.Remove(store.TrustPath()); err != nil {\n175|\t\tt.Fatal(err)\n176|\t}\n177|\tif err := os.Symlink(shadow, store.TrustPath()); err != nil {\n178|\t\tt.Fatal(err)\n179|\t}\n180|\tif _, err := store.ReadSnapshot(); err == nil {\n181|\t\tt.Fatal(\"ReadSnapshot(symlink) succeeded, want refusal\")\n182|\t} else if !errors.Is(err, ErrTrustUnsafeCustody) {\n183|\t\tt.Fatalf(\"ReadSnapshot(symlink) error = %v, want ErrTrustUnsafeCustody\", err)\n184|\t}\n185|}\n186|\n187|func TestCorruptTrustRefusedNeverEmpty(t *testing.T) {\n188|\tstate := t.TempDir()\n189|\tstore := openForTest(t, state)\n190|\tif _, err := store.Initialize(); err != nil {\n191|\t\tt.Fatal(err)\n192|\t}\n193|\tif err := os.WriteFile(store.TrustPath(), []byte(`{\"schema\":\"urn:ax:schema:host-trust-store\",\"schema_version\":\"1.0.0\",\"generation\":2,\"entries\":[]}TRUNC`), 0o600); err != nil {\n194|\t\tt.Fatal(err)\n195|\t}\n196|\tsnapshot, err := store.ReadSnapshot()\n197|\tif err == nil {\n198|\t\tt.Fatalf(\"ReadSnapshot(corrupt) succeeded as gen %d, want refusal\", snapshot.Generation)\n199|\t}\n200|\tif snapshot.Generation != 0 || len(snapshot.Trust.Entries) != 0 {\n201|\t\tt.Fatal(\"refused snapshot must be zero, never a partial store\")\n202|\t}\n203|}\n204|\n205|func TestStagingFilesIgnored(t *testing.T) {\n206|\tstate := t.TempDir()\n207|\tstore := openForTest(t, state)\n208|\tif _, err := store.Initialize(); err != nil {\n(more lines below)","final_result":true}}}
