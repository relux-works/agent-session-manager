{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cbcf","stream":{"kind":"session","id":"01a0aa44-08d9-7882-b782-d653915eefd3"},"sequence":1090,"recorded_at":1780531400002175,"record_type":"event","durability":"durable","causation_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","run_stream":{"kind":"run","id":"bc8ec94b-72dd-41ff-812d-ceee7d051537"},"task_stream":{"kind":"task","id":"01a0aa4a-f5a2-76d3-89d4-309b810a738e"},"task_id":"01a0aa4a-f5a2-76d3-89d4-309b810a738e","event":{"kind":"output","task_id":"01a0aa4a-f5a2-76d3-89d4-309b810a738e","chunk":"Read text file `internal/hosttrust/joint_test.go`.\n(399 line(s) above)\n400|\tcases := []struct {\n401|\t\tname    string\n402|\t\tmutate  func(string) string\n403|\t\twantErr error\n404|\t}{\n405|\t\t{\"unknown field\", func(document string) string {\n406|\t\t\treturn document[:len(document)-1] + `,\"comment\":\"x\"}`\n407|\t\t}, ErrTrustDecode},\n408|\t\t{\"duplicate key\", func(document string) string {\n409|\t\t\treturn document[:len(document)-1] + `,\"operation\":\"apply-v4\"}`\n410|\t\t}, ErrTrustValidation},\n411|\t\t{\"quoted generation\", func(document string) string {\n412|\t\t\treturn `{\"schema\":\"urn:ax:schema:host-pending-commit\",\"schema_version\":\"1.0.0\",\"operation\":\"apply-v4\",\"config_path\":\"/abs/config.toml\",\"source_sha256\":\"` + SHA256HexOf(source) + `\",\"replacement_sha256\":\"` + SHA256HexOf(replacement) + `\",\"source_generation\":\"3\",\"backup_path\":\"/abs/config.toml.bak.3.0.0\"}`\n413|\t\t}, ErrTrustValidation},\n414|\t\t{\"wrong operation\", func(document string) string {\n415|\t\t\treturn replaceOnce(document, `\"apply-v4\"`, `\"install\"`)\n416|\t\t}, ErrTrustValidation},\n417|\t\t{\"relative config path\", func(document string) string {\n418|\t\t\treturn replaceOnce(document, `\"/abs/config.toml\"`, `\"config.toml\"`)\n419|\t\t}, ErrTrustValidation},\n420|\t\t{\"equal hashes\", func(document string) string {\n421|\t\t\treturn replaceOnce(document, SHA256HexOf(replacement), SHA256HexOf(source))\n422|\t\t}, ErrTrustValidation},\n423|\t}\n424|\tfor _, test := range cases {\n425|\t\tt.Run(test.name, func(t *testing.T) {\n426|\t\t\tif _, err := decodePendingCommit([]byte(test.mutate(string(valid)))); err == nil {\n427|\t\t\t\tt.Fatalf(\"decodePendingCommit(%s) succeeded, want refusal\", test.name)\n428|\t\t\t} else if !errors.Is(err, test.wantErr) {\n429|\t\t\t\tt.Fatalf(\"decodePendingCommit(%s) error = %v, want %v\", test.name, err, test.wantErr)\n430|\t\t\t}\n431|\t\t})\n432|\t}\n433|}\n434|\n435|func replaceOnce(document, old, replacement string) string {\n436|\tfor index := 0; index+len(old) <= len(document); index++ {\n437|\t\tif document[index:index+len(old)] == old {\n438|\t\t\treturn document[:index] + replacement + document[index+len(old):]\n439|\t\t}\n440|\t}\n441|\treturn document\n442|}\n443|\n444|func TestSharedSnapshotSerializesWithExclusive(t *testing.T) {\n445|\tstore := setupStoreForTest(t)\n446|\trelease := make(chan struct{})\n447|\tentered := make(chan struct{})\n448|\tholderDone := make(chan error, 1)\n449|\tgo func() {\n450|\t\tholderDone <- store.transact(func(*TrustStore) error {\n451|\t\t\tclose(entered)\n452|\t\t\t<-release\n453|\t\t\treturn nil\n454|\t\t})\n455|\t}()\n456|\t<-entered\n457|\tobserved := make(chan TrustStore, 1)\n458|\treaderDone := make(chan error, 1)\n459|\tgo func() {\n460|\t\treaderDone <- store.WithSharedSnapshot(func(current TrustStore) error {\n461|\t\t\tobserved <- current\n462|\t\t\treturn nil\n463|\t\t})\n464|\t}()\n465|\t// The shared reader must wait for the exclusive holder: it must not\n466|\t// observe state while the transaction is still open.\n467|\tselect {\n468|\tcase <-readerDone:\n469|\t\tt.Fatal(\"WithSharedSnapshot completed while an exclusive transaction was held\")\n470|\tcase <-time.After(250 * time.Millisecond):\n471|\t}\n472|\tclose(release)\n473|\tif err := <-holderDone; err != nil {\n474|\t\tt.Fatalf(\"holder transact error = %v\", err)\n475|\t}\n476|\tif err := <-readerDone; err != nil {\n477|\t\tt.Fatalf(\"WithSharedSnapshot error = %v\", err)\n478|\t}\n479|\tcurrent := <-observed\n480|\tfresh, err := store.ReadSnapshot()\n481|\tif err != nil {\n482|\t\tt.Fatal(err)\n483|\t}\n484|\tif current.Generation != fresh.Generation {\n485|\t\tt.Fatalf(\"shared snapshot generation = %d, want %d\", current.Generation, fresh.Generation)\n486|\t}\n487|}","final_result":true}}}
