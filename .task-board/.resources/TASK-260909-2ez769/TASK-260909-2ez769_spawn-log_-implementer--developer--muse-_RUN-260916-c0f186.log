{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d501","stream":{"kind":"session","id":"01a0aa44-08d9-7882-b782-d653915eefd3"},"sequence":2267,"recorded_at":1780531400004529,"record_type":"event","durability":"durable","causation_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bc8ec94b-72dd-41ff-812d-ceee7d051537","run_stream":{"kind":"run","id":"bc8ec94b-72dd-41ff-812d-ceee7d051537"},"task_stream":{"kind":"task","id":"01a0aa52-5738-7193-ba9d-2d3b17ec0475"},"task_id":"01a0aa52-5738-7193-ba9d-2d3b17ec0475","event":{"kind":"output","task_id":"01a0aa52-5738-7193-ba9d-2d3b17ec0475","chunk":"Read text file `internal/config/migration.go`.\n(279 line(s) above)\n280|// with ErrConfigNotRegular instead of guessing which file the operator meant.\n281|func (osMigrationFileSystem) Stat(name string) (fs.FileInfo, error) { return os.Lstat(name) }\n282|func (osMigrationFileSystem) Remove(name string) error              { return os.Remove(name) }\n283|func (osMigrationFileSystem) Rename(oldname, newname string) error {\n284|\treturn os.Rename(oldname, newname)\n285|}\n286|func (osMigrationFileSystem) OpenDirectory(name string) (migrationDirectory, error) {\n287|\treturn os.Open(name)\n288|}\n289|\n290|func replaceDurably(filesystem migrationFileSystem, filename, backup string, original, replacement []byte) error {\n291|\tdirectory := filepath.Dir(filename)\n292|\t// Re-inspect the selected file before anything durable is written. Load\n293|\t// resolved and validated it through the symlink-following read seam; this\n294|\t// mutating seam does not follow symlinks, so a selected file that is not\n295|\t// itself a regular file is refused here rather than after a backup has\n296|\t// already been published. A refused migration therefore leaves the\n297|\t// directory exactly as it found it, and the captured permission bits are\n298|\t// the ones the replacement inherits.\n299|\tinfo, err := filesystem.Stat(filename)\n300|\tif err != nil {\n301|\t\treturn migrationError(MigrationError{Operation: \"inspect source mode\", Err: errors.Join(ErrMigrationWrite, err)})\n302|\t}\n303|\tif !info.Mode().IsRegular() {\n304|\t\treturn migrationError(MigrationError{Operation: \"inspect source mode\", Err: errors.Join(ErrMigrationWrite, ErrConfigNotRegular)})\n305|\t}\n306|\tbackupTemp, err := writeTempFile(filesystem, directory, \".ax-config-backup-*\", original, 0o600)\n307|\tif err != nil {\n308|\t\treturn migrationError(MigrationError{Operation: \"write backup\", Err: errors.Join(ErrMigrationBackup, err)})\n309|\t}\n310|\tif err := filesystem.Link(backupTemp, backup); err != nil {\n311|\t\tif !errors.Is(err, fs.ErrExist) {\n312|\t\t\t_ = filesystem.Remove(backupTemp)\n313|\t\t\treturn migrationError(MigrationError{Operation: \"publish backup\", Err: errors.Join(ErrMigrationBackup, err)})\n314|\t\t}\n315|\t\texisting, readErr := filesystem.ReadFile(backup)\n316|\t\tinfo, statErr := filesystem.Stat(backup)\n317|\t\tif readErr != nil || statErr != nil || !bytes.Equal(existing, original) || info.Mode().Perm()&0o077 != 0 {\n318|\t\t\t_ = filesystem.Remove(backupTemp)\n319|\t\t\treturn migrationError(MigrationError{Operation: \"verify backup\", Err: ErrMigrationBackup})\n320|\t\t}\n321|\t}\n322|\tif err := filesystem.Remove(backupTemp); err != nil && !errors.Is(err, fs.ErrNotExist) {\n323|\t\treturn migrationError(MigrationError{Operation: \"remove backup staging file\", Err: errors.Join(ErrMigrationBackup, err)})\n324|\t}\n325|\t// Retry the directory sync even when an exact backup already exists: it may\n326|\t// be the visible result of an interrupted run whose directory fsync failed.\n327|\tif err := syncDirectory(filesystem, directory); err != nil {\n328|\t\treturn migrationError(MigrationError{Operation: \"sync backup directory\", Err: errors.Join(ErrMigrationSync, err)})\n329|\t}\n330|\n331|\treplacementTemp, err := writeTempFile(filesystem, directory, \".ax-config-migrate-*\", replacement, info.Mode().Perm())\n332|\tif err != nil {\n333|\t\treturn migrationError(MigrationError{Operation: \"write replacement\", Err: errors.Join(ErrMigrationWrite, err)})\n334|\t}\n335|\tif err := filesystem.Rename(replacementTemp, filename); err != nil {\n336|\t\t_ = filesystem.Remove(replacementTemp)\n337|\t\treturn migrationError(MigrationError{Operation: \"replace source\", Err: errors.Join(ErrMigrationReplace, err)})\n338|\t}\n339|\tif err := syncDirectory(filesystem, directory); err == nil {\n340|\t\treturn nil\n341|\t} else {\n342|\t\tsyncErr := err\n343|\t\trollbackTemp, rollbackErr := writeTempFile(filesystem, directory, \".ax-config-rollback-*\", original, info.Mode().Perm())\n344|\t\tif rollbackErr == nil {\n345|\t\t\trollbackErr = filesystem.Rename(rollbackTemp, filename)\n346|\t\t}\n347|\t\tif rollbackErr == nil {\n348|\t\t\trollbackErr = syncDirectory(filesystem, directory)\n349|\t\t}\n350|\t\tif rollbackErr != nil {\n351|\t\t\tif rollbackTemp != \"\" {\n352|\t\t\t\t_ = filesystem.Remove(rollbackTemp)\n353|\t\t\t}\n354|\t\t\treturn migrationError(MigrationError{Operation: \"recover source after sync\", Err: errors.Join(ErrMigrationSync, ErrMigrationRecovery, syncErr, rollbackErr)})\n355|\t\t}\n356|\t\treturn migrationError(MigrationError{Operation: \"sync replacement directory\", Err: errors.Join(ErrMigrationSync, syncErr)})\n357|\t}\n358|}\n359|\n(more lines below)","final_result":true}}}
