func ApplyV4(inputs Inputs, overrides Overrides, preview V4Preview, confirm bool, now time.Time) (V4ApplyResult, error) {
	return applyV4(inputs, overrides, preview, confirm, now, osMigrationFileSystem{}, hosttrust.Open)
