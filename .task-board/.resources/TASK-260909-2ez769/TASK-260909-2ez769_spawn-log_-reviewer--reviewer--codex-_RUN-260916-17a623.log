func censusViolation(format string, args ...any) string {
	return fmt.Sprintf(format, args...)
}

// censusViolations scans the non-test Go sources under dirs and reports
// every pair mutation outside the censused rows.
func censusViolations(t *testing.T, dirs ...string) []string {
	t.Helper()
	var violations []string
	for _, dir := range dirs {
		fileset := token.NewFileSet()
		// Parse non-test files individually: test files stage fixtures
		// through direct writes by design and are not production paths.
		entries, err := filepath.Glob(filepath.Join(dir, "*.go"))
		if err != nil {
			t.Fatalf("glob %s: %v", dir, err)
		}
		for _, path := range entries {
			if strings.HasSuffix(path, "_test.go") {
				continue
			}
			file, err := parser.ParseFile(fileset, path, nil, 0)
			if err != nil {
				t.Fatalf("parse %s: %v", path, err)
			}
			violations = append(violations, censusFileViolations(fileset, file)...)
		}
	}
	sort.Strings(violations)
	return violations
}

