e same converged pair as a reopened store.\n34|// Callers must not acquire the lock again inside fn; internal reads there\n35|// use the supplied committed value directly.\n36|func (store *Store) WithSharedSnapshot(fn func(current TrustStore) error) error {\n37|\tunlock, err := lockForConvergedRead(store.fs, store.root, store.lock)\n38|\tif err != nil {\n39|\t\treturn err\n40|\t}\n41|\tdefer unlock()\n42|\tsnapshot, err := readSnapshotLocked(store.fs, store.root)\n43|\tif err != nil {\n44|\t\treturn err\n45|\t}\n46|\tcommitted := snapshot.Trust\n47|\tif fn == nil {\n48|\t\treturn trustError(TrustError{Operation: \"read snapshot\", Err: ErrAuthorizationRefused})\n49|\t}\n50|\treturn fn(committed)\n51|}\n52|\n53|func readSnapshot(filesystem FileSystem, root string, lock *fileLock) (Snapshot, error) {\n54|\tunlock, err := lockForConvergedRead(filesystem, root, lock)\n55|\tif err != nil {\n56|\t\treturn Snapshot{}, err\n57|\t}\n58|\tdefer unlock()\n59|\treturn readSnapshotLocked(filesystem, root)\n60|}\n61|\n62|// lockForConvergedRead holds the authorization lock for one coherent read,\n63|// converging pending joint intent first. The fast path keeps the shared\n64|// lock when no marker is present: staging a marker needs the exclusive\n65|// lock, so absence observed under shared hold still holds at the read.\n66|// When a marker is present the shared lock is released before the\n67|// exclusive lock is acquired (a held shared lock can never upgrade in\n68|// place without risking a cross-process upgrade deadlock), the leftover\n69|// converges or refuses, and the read proceeds under the exclusive hold.\n70|// Convergence may move the generation forward; callers compare request\n71|// bindings against the converged read, never by refreshing a stale number.\n72|func lockForConvergedRead(filesystem FileSystem, root string, lock *fileLock) (func(), error) {\n73|\tunlock, err := lock.shared()\n74|\tif err != nil {\n75|\t\treturn nil, trustError(TrustError{Operation: \"lock