{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000caef","stream":{"kind":"session","id":"01a0aa74-c329-7d72-8811-c1901bb53d47"},"sequence":978,"recorded_at":1780531400001951,"record_type":"event","durability":"durable","causation_id":"e52fa573-a598-4d15-9493-65cb4f83069f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e52fa573-a598-4d15-9493-65cb4f83069f","run_stream":{"kind":"run","id":"e52fa573-a598-4d15-9493-65cb4f83069f"},"task_stream":{"kind":"task","id":"01a0aa78-d0ee-7c82-afe1-4e37128eae15"},"task_id":"01a0aa78-d0ee-7c82-afe1-4e37128eae15","event":{"kind":"output","task_id":"01a0aa78-d0ee-7c82-afe1-4e37128eae15","chunk":"Read text file `internal/config/migration_v4_apply_test.go`.\n(499 line(s) above)\n500|\t// The config replacement succeeds but the generation bump is refused at\n501|\t// the uint53 ceiling, and the source restore fails too: the error must\n502|\t// report the compound failure, never silent success. Rename 1 installs\n503|\t// the replacement; rename 2 (the restore) is faulted.\n504|\tfailing := &faultMigrationFileSystem{failRenameCall: 2}\n505|\tif _, err := applyV4(fixture.inputs, nil, preview, true, fixture.now, failing, hosttrust.Open); err == nil {\n506|\t\tt.Fatal(\"ApplyV4(compound durability failure) succeeded, want failure\")\n507|\t} else if !errors.Is(err, ErrMigrationRecovery) {\n508|\t\tt.Fatalf(\"ApplyV4(compound) error = %v, want recovery failure\", err)\n509|\t}\n510|\t// The replacement stayed durable with the marker kept for operator\n511|\t// resolution. Recovery cannot converge it either: the forward bump\n512|\t// refuses again at the exhausted ceiling, so the open fails and the\n513|\t// marker stays instead of converging silently.\n514|\tchannel := filepath.Join(fixture.stateDir, \"host-channel\")\n515|\tif _, err := os.Lstat(filepath.Join(channel, \"pending-commit.json\")); err != nil {\n516|\t\tt.Fatalf(\"joint marker was removed after failed restore: %v\", err)\n517|\t}\n518|\tif _, err := hosttrust.Open(fixture.stateDir); err == nil {\n519|\t\tt.Fatal(\"openStore(failed restore) succeeded, want refusal\")\n520|\t} else if !errors.Is(err, hosttrust.ErrGenerationExhausted) {\n521|\t\tt.Fatalf(\"openStore error = %v, want ErrGenerationExhausted\", err)\n522|\t}\n523|}\n524|\n525|func TestRollbackV4AbsentSource(t *testing.T) {\n526|\tfixture := setupV4Fixture(t, testPeerID)\n527|\tif err := os.Remove(fixture.filename); err != nil {\n528|\t\tt.Fatal(err)\n529|\t}\n530|\toptions := RollbackV4Options{AcknowledgeNoHostChannelAssurance: true}\n531|\tif _, err := RollbackV4(fixture.inputs, nil, options); err == nil {\n532|\t\tt.Fatal(\"RollbackV4(absent source) succeeded, want refusal\")\n533|\t} else if !errors.Is(err, ErrMigrationSourceAbsent) {\n534|\t\tt.Fatalf(\"RollbackV4(absent) error = %v\", err)\n535|\t}\n536|}\n537|\n538|func TestRollbackV4TrustCommitRecoveryFailure(t *testing.T) {\n539|\tfixture := setupV4Fixture(t, testPeerID)\n540|\tpreview, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now)\n541|\tif err != nil {\n542|\t\tt.Fatalf(\"PreviewV4 error = %v\", err)\n543|\t}\n544|\tif _, err := ApplyV4(fixture.inputs, nil, preview, true, fixture.now); err != nil {\n545|\t\tt.Fatalf(\"ApplyV4 error = %v\", err)\n546|\t}\n547|\t// Fault the joint commit after the backup replacement is durable: crown\n548|\t// the trust at the uint53 ceiling and fault the source restore.\n549|\t// Rename 1 installs the backup; rename 2 (the restore) is faulted.\n550|\tcrownTrustAtExhaustion(t, fixture)\n551|\tfailing := &faultMigrationFileSystem{failRenameCall: 2}\n552|\toptions := RollbackV4Options{AcknowledgeNoHostChannelAssurance: true}\n553|\tif _, err := rollbackV4(fixture.inputs, nil, options, failing, hosttrust.Open); err == nil {\n554|\t\tt.Fatal(\"RollbackV4(compound durability failure) succeeded, want failure\")\n555|\t} else if !errors.Is(err, ErrMigrationRecovery) {\n556|\t\tt.Fatalf(\"RollbackV4(compound) error = %v, want recovery failure\", err)\n557|\t}\n558|\tchannel := filepath.Join(fixture.stateDir, \"host-channel\")\n559|\tif _, err := os.Lstat(filepath.Join(channel, \"pending-commit.json\")); err != nil {\n560|\t\tt.Fatalf(\"joint marker was removed after failed restore: %v\", err)\n561|\t}\n562|}\n563|\n564|func TestRollbackV4BackupGates(t *testing.T) {\n565|\tfixture := setupV4Fixture(t, testPeerID)\n566|\tpreview, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now)\n567|\tif err != nil {\n568|\t\tt.Fatalf(\"PreviewV4 error = %v\", err)\n569|\t}\n570|\tif _, err := ApplyV4(fixture.inputs, nil, preview, true, fixture.now); err != nil {\n571|\t\tt.Fatalf(\"ApplyV4 error = %v\", err)\n572|\t}\n573|\t// A missing backup refuses: rollback replaces only from preserved bytes.\n574|\tif _, err := RollbackV4(fixture.inputs, nil, RollbackV4Options{AcknowledgeNoHostChannelAssurance: true, BackupPath: filepath.Join(fixture.directory, \"absent.bak\")}); err == nil {\n575|\t\tt.Fatal(\"RollbackV4(missing backup) succeeded, want refusal\")\n576|\t} else if !errors.Is(err, ErrRollbackV4Backup) {\n577|\t\tt.Fatalf(\"RollbackV4(missing backup) error = %v\", err)\n578|\t}\n579|\t// A Config-4 document is never a rollback target.\n580|\tif _, err := RollbackV4(fixture.inputs, nil, RollbackV4Options{AcknowledgeNoHostChannelAssurance: true, BackupPath: fixture.filename}); err == nil {\n581|\t\tt.Fatal(\"RollbackV4(v4 backup) succeeded, want refusal\")\n582|\t} else if !errors.Is(err, ErrRollbackV4Backup) {\n583|\t\tt.Fatalf(\"RollbackV4(v4 backup) error = %v\", err)\n584|\t}\n585|\t// Undecodable bytes are never a rollback target either.\n586|\tcorrupt := filepath.Join(fixture.directory, \"corrupt.bak\")\n587|\tif err := os.WriteFile(corrupt, []byte(\"not toml [\"), 0o600); err != nil {\n588|\t\tt.Fatal(err)\n589|\t}\n590|\tif _, err := RollbackV4(fixture.inputs, nil, RollbackV4Options{AcknowledgeNoHostChannelAssurance: true, BackupPath: corrupt}); err == nil {\n591|\t\tt.Fatal(\"RollbackV4(corrupt backup) succeeded, want refusal\")\n592|\t} else if !errors.Is(err, ErrRollbackV4Backup) {\n593|\t\tt.Fatalf(\"RollbackV4(corrupt backup) error = %v\", err)\n594|\t}\n595|}","final_result":true}}}
