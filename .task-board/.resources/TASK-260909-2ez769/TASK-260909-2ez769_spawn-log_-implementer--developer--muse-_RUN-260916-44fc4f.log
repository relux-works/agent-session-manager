{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9ad","stream":{"kind":"session","id":"01a0aa74-c329-7d72-8811-c1901bb53d47"},"sequence":817,"recorded_at":1780531400001629,"record_type":"event","durability":"durable","causation_id":"e52fa573-a598-4d15-9493-65cb4f83069f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e52fa573-a598-4d15-9493-65cb4f83069f","run_stream":{"kind":"run","id":"e52fa573-a598-4d15-9493-65cb4f83069f"},"task_stream":{"kind":"task","id":"01a0aa78-6348-7f31-b4d6-eb4a29ef2f6a"},"task_id":"01a0aa78-6348-7f31-b4d6-eb4a29ef2f6a","event":{"kind":"output","task_id":"01a0aa78-6348-7f31-b4d6-eb4a29ef2f6a","chunk":"Read text file `internal/hosttrust/authorize.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"errors\"\n6|\t\"fmt\"\n7|\t\"time\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// AuthRequest carries one dispatch or mutation-boundary authorization check.\n13|// SnapshotGeneration binds the stream to the coherent snapshot it was opened\n14|// under; LocalCredentialID and the remote DER bytes select the exact enrolled\n15|// entries; Allowlisted is the local mesh allowlist; HelloHostID is the\n16|// authenticated hello identity; ExpectedRemoteHostID is the selected\n17|// configured destination on the client.\n18|type AuthRequest struct {\n19|\tSnapshotGeneration   uint64\n20|\tLocalHostID          string\n21|\tLocalCredentialID    string\n22|\tRemoteLeafDER        []byte\n23|\tRemoteRootDER        []byte\n24|\tExpectedRemoteHostID string\n25|\tAllowlisted          []string\n26|\tHelloHostID          string\n27|\tNow                  time.Time\n28|}\n29|\n30|// Formatting an authorization request must never expose DER bytes, UUIDs,\n31|// digests or allowlists.\n32|func (AuthRequest) String() string   { return \"host channel authorization request\" }\n33|func (AuthRequest) GoString() string { return \"host channel authorization request\" }\n34|func (AuthRequest) Format(state fmt.State, verb rune) {\n35|\t_, _ = state.Write([]byte(\"host channel authorization request\"))\n36|}\n37|\n38|// Formatting a snapshot must never expose the entries it binds.\n39|func (Snapshot) String() string   { return \"host trust snapshot\" }\n40|func (Snapshot) GoString() string { return \"host trust snapshot\" }\n41|func (Snapshot) Format(state fmt.State, verb rune) {\n42|\t_, _ = state.Write([]byte(\"host trust snapshot\"))\n43|}\n44|\n45|// AuthorizeDispatch checks current generation, local credential validity,\n46|// allowlist membership and authenticated hello against one committed read\n47|// held under the shared authorization lock. The check observes a coherent\n48|// snapshot, but the dispatch itself runs after the lock releases, so the\n49|// caller must bind the admitted generation to the stream and enforce the\n50|// one-second invalidation on commit: re-check currency before sending, and\n51|// close stale-generation streams on watchdog, never on notifications alone.\n52|// Mutation side effects additionally require WithMutationAuthorization, which\n53|// holds the exclusive lock across the recheck and the boundary. Work prepared\n54|// under an old generation cannot gain new authority by refreshing a cached\n55|// number: a stale snapshot refuses.\n56|func (store *Store) AuthorizeDispatch(snapshot Snapshot, request AuthRequest) error {\n57|\t// Pending joint intent converges before the currency check, so a\n58|\t// dispatch bound before a crash compares against the recovered\n59|\t// generation and refuses stale instead of admitting superseded trust.\n60|\t// Convergence failures name their own operation and pass through: a\n61|\t// refused recovery is a durability event, not an authorization verdict.\n62|\tunlock, err := lockForConvergedRead(store.fs, store.root, store.lock)\n63|\tif err != nil {\n64|\t\treturn err\n65|\t}\n66|\tdefer unlock()\n67|\tcurrent, err := readCommitted(store)\n68|\tif err != nil {\n69|\t\treturn err\n70|\t}\n71|\t// The stream binding must match the snapshot it was opened under: work\n72|\t// prepared under an old generation cannot gain new authority by\n73|\t// refreshing a cached number.\n74|\tif request.SnapshotGeneration != snapshot.Generation {\n75|\t\treturn trustError(TrustError{Operation: \"authorize generation\", Err: ErrStaleGeneration})\n76|\t}\n77|\tif snapshot.Generation != current.Generation {\n78|\t\treturn trustError(TrustError{Operation: \"authorize generation\", Err: ErrStaleGeneration})\n79|\t}\n80|\treturn checkAuthorization(snapshot.Trust, request)\n81|}\n82|\n83|// readCommitted reads the committed trust without acquiring the lock: the\n84|// caller must already hold the authorization lock and have converged\n85|// pending joint intent, so the read nests safely inside a holder instead\n86|// of blocking on it.\n87|func readCommitted(store *Store) (TrustStore, error) {\n88|\tpath := store.TrustPath()\n89|\tinfo, err := store.fs.Lstat(path)\n90|\tif err != nil {\n91|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"authorize generation\", Err: errors.Join(ErrAuthorizationRefused, err)})\n92|\t}\n93|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n94|\t\treturn TrustStore{}, err\n95|\t}\n96|\tdocument, err := store.fs.ReadFile(path)\n97|\tif err != nil {\n98|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"authorize generation\", Err: errors.Join(ErrAuthorizationRefused, err)})\n99|\t}\n100|\tcommitted, err := DecodeTrust(document)\n101|\tif err != nil {\n102|\t\treturn TrustStore{}, err\n103|\t}\n104|\treturn committed, nil\n105|}\n106|\n107|func checkAuthorization(trust TrustStore, request AuthRequest) error {\n108|\tconst operation = \"authorize dispatch\"\n109|\tlocal, found := findEntry(trust, request.LocalCredentialID)\n110|\tif !found {\n111|\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n112|\t}\n113|\tif local.HostID.String() != request.LocalHostID || local.State != EntryActive {\n114|\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n115|\t}\n116|\tif err := VerifyProfile(local.LeafDER, local.RootDER, local.HostID.String(), request.Now); err != nil {\n117|\t\treturn trustError(TrustError{Operation: operation, Err: errors.Join(ErrAuthorizationRefused, err)})\n118|\t}\n119|\tremote, found := matchRemote(trust, request.RemoteLeafDER, request.RemoteRootDER)\n120|\tif !found {\n121|\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n122|\t}\n123|\tif err := VerifyProfile(remote.LeafDER, remote.RootDER, remote.HostID.String(), request.Now); err != nil {\n124|\t\treturn trustError(TrustError{Operation: operation, Err: errors.Join(ErrAuthorizationRefused, err)})\n125|\t}\n126|\tif remote.State == EntryRevoked {\n127|\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n128|\t}\n129|\tif remote.State == EntryRetiring {\n130|\t\tif remote.RetireAt == nil {\n131|\t\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n132|\t\t}\n133|\t\tretireAt, err := remote.RetireAt.Time()\n134|\t\tif err != nil || !request.Now.Before(retireAt) {\n135|\t\t\treturn trustError(TrustError{Operation: operation, Err: ErrAuthorizationRefused})\n136|\t\t}\n137|\t}\n138|\tallowlisted := false\n139|\tfor _, hostID := range request.Allowlisted {\n140|\t\tif hostID == remote.HostID.String() {\n141|\t\t\tallowlisted = true\n142|\t\t\tbreak\n143|\t\t}\n144|\t}\n145|\tif !allowlisted {\n146|\t\treturn trustError(TrustError{Operation: operation, Err: ErrNotAllowlisted})\n147|\t}\n148|\tif request.HelloHostID != remote.HostID.String() || remote.HostID.String() != request.ExpectedRemoteHostID {\n149|\t\treturn trustError(TrustError{Operation: operation, Err: ErrHostIdentityMismatch})\n150|\t}\n151|\treturn nil\n152|}\n153|\n154|func findEntry(trust TrustStore, credentialID string) (CredentialEntry, bool) {\n155|\tfor _, entry := range trust.Entries {\n156|\t\tif entry.CredentialID.String() == credentialID {\n157|\t\t\treturn entry, true\n158|\t\t}\n159|\t}\n160|\treturn CredentialEntry{}, false\n161|}\n162|\n163|// matchRemote yields the verified UUID only on an exact leaf/root/SPKI match\n164|// against one currently admitted entry. Zero or multiple matches refuse; SAN\n165|// alone and CA membership alone are insufficient, which the byte-exact triple\n166|// comparison enforces structurally.\n167|func matchRemote(trust TrustStore, leafDER, rootDER []byte) (CredentialEntry, bool) {\n168|\tspki := spkiOf(leafDER)\n169|\tvar matched []CredentialEntry\n170|\tfor _, entry := range trust.Entries {\n171|\t\tif !bytes.Equal(entry.LeafDER, leafDER) || !bytes.Equal(entry.RootDER, rootDER) {\n172|\t\t\tcontinue\n173|\t\t}\n174|\t\tif spki == \"\" || entry.SPKIID.String() != spki {\n175|\t\t\tcontinue\n176|\t\t}\n177|\t\tmatched = append(matched, entry)\n178|\t}\n179|\tif len(matched) != 1 {\n180|\t\treturn CredentialEntry{}, false\n181|\t}\n182|\treturn matched[0], true\n183|}\n184|\n185|func spkiOf(leafDER []byte) string {\n186|\tder := mustSPKI(leafDER)\n187|\tif len(der) == 0 {\n188|\t\treturn \"\"\n189|\t}\n190|\treturn scalar.SHA256Digest(der).String()\n191|}\n192|\n193|// WithMutationAuthorization rechecks generation, credential validity,\n194|// allowlist membership and authenticated hello under the exclusive\n195|// authorization lock immediately before the externally visible side-effect\n196|// boundary, then runs the boundary while still holding the lock. The\n197|// generation check and the boundary serialize with revocation and config\n198|// commits. The request must bind the current generation: work prepared under\n199|// an old generation cannot gain new authority by refreshing a cached number,\n200|// so a stale binding refuses and the caller must discard its authorization\n201|// and replan through a fresh mutually authenticated connection. Boundaries\n202|// must be bounded: long provider calls must not hold the authorization lock\n203|// across unbounded work.\n204|func (store *Store) WithMutationAuthorization(request AuthRequest, boundary func() error) error {\n205|\tunlock, err := store.lock.exclusive()\n206|\tif err != nil {\n207|\t\treturn trustError(TrustError{Operation: \"authorize mutation\", Err: errors.Join(ErrAuthorizationRefused, err)})\n208|\t}\n209|\tdefer unlock()\n210|\t// Pending joint intent converges before the binding check: a request\n211|\t// bound before a crash compares against the recovered generation and\n212|\t// refuses stale, and the boundary never runs beside unresolved intent.\n213|\tif err := convergeLocked(store.fs, store.root); err != nil {\n214|\t\treturn err\n215|\t}\n216|\tcurrent, err := readCommitted(store)\n217|\tif err != nil {\n218|\t\treturn err\n219|\t}\n220|\tif request.SnapshotGeneration != current.Generation {\n221|\t\treturn trustError(TrustError{Operation: \"authorize mutation\", Err: ErrStaleGeneration})\n222|\t}\n223|\tif err := checkAuthorization(current, request); err != nil {\n224|\t\treturn err\n225|\t}\n226|\tif boundary == nil {\n227|\t\treturn trustError(TrustError{Operation: \"authorize mutation\", Err: ErrAuthorizationRefused})\n228|\t}\n229|\treturn boundary()\n230|}","final_result":true}}}
