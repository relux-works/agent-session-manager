l(err)\n332|\t}\n333|\tif _, err := store.Initialize(); err == nil {\n334|\t\tt.Fatal(\"Initialize(intervened) succeeded, want refusal\")\n335|\t} else if !errors.Is(err, ErrJointIntervened) {\n336|\t\tt.Fatalf(\"Initialize error = %v, want ErrJointIntervened\", err)\n337|\t}\n338|\tassertMarkerKept(t, store)\n339|}\n340|\n341|// A mutation boundary beside an intervened marker refuses without running:\n342|// authorization never proceeds while joint intent is unresolvable.\n343|func TestMutationAuthorizationRefusesIntervention(t *testing.T) {\n344|\tlocal, peer, localCredential, peerCredential, localSnap, _ := twoHostFixture(t)\n345|\tleaf, root := peerMaterialForTest(t, peer, peerCredential)\n346|\trequest := dispatchRequest(localSnap, localCredential, peerCredential, testHostB, leaf, root, []string{testHostA, testHostB}, testNow)\n347|\tsource := []byte(\"source configuration\\n\")\n348|\treplacement := []byte(\"replacement configuration\\n\")\n349|\tconfigPath := filepath.Join(t.TempDir(), \"config.toml\")\n350|\tif err := os.WriteFile(configPath, source, 0o600); err != nil {\n351|\t\tt.Fatal(err)\n352|\t}\n353|\tstageJointMarker(t, local, jointMarker(configPath, source, replacement, localSnap.Generation))\n354|\tif err := os.WriteFile(configPath, []byte(\"operator edit\\n\"), 0o600); err != nil {\n355|\t\tt.Fatal(err)\n356|\t}\n357|\tcalled := false\n358|\tif err := local.WithMutationAuthorization(request, func() error {\n359|\t\tcalled = true\n360|\t\treturn nil\n361|\t}); err == nil || called {\n362|\t\tt.Fatalf(\"WithMutationAuthorization(intervened) admitted: boundary=%v\", called)\n363|\t} else if !errors.Is(err, ErrJointIntervened) {\n364|\t\tt.Fatalf(\"WithMutationAuthorization error = %v, want ErrJointIntervened\", err)\n365|\t}\n366|\tassertMarkerKept(t, local)\n367|}\n368|\n369|// A dispatch beside an intervened marker refuses: the currency check never\n370|// runs against unresolvable trust.\n371|func TestAuthorizeDispatchRefusesIntervention(t *testing.T) {\n372|\tlocal, peer, localCredential, peerCredential, localSnap, _ := twoHostFixture(t)\n373|\tleaf, root := peerMaterialForTest(t, peer, peerCredential)\n374|\trequest := dispatchRequest(localSnap, localCredential, peerCredential, testHostB, leaf, root, []string{testHostA, testHostB}, testNow)\n375|\tsource := []byte(\"source configuration\\n\")\n376|\treplacement := []byte(\"replacement configuration\\n\")\n377|\tconfigPath := filepath.Join(t.TempDir(), \"config.toml\")\n378|\tif err := os.WriteFile(configPath, source, 0o600); err != nil {\n379|\t\tt.Fatal(err)\n380|\t}\n381|\tstageJointMarker(t, local, jointMarker(configPath, source, replacement, localSnap.Generation))\n382|\tif err := os.WriteFile(configPath, []byte(\"operator edit\\n\"), 0o600); err != nil {\n383|\t\tt.Fatal(err)\n384|\t}\n385|\tif err := local.AuthorizeDispatch(localSnap, request); err == nil {\n386|\t\tt.Fatal(\"AuthorizeDispatch(intervened) succeeded, want refusal\")\n387|\t} else if !errors.Is(err, ErrJointIntervened) {\n388|\t\tt.Fatalf(\"AuthorizeDispatch error = %v, want ErrJointIntervened\", err)\n389|\t}\n390|\tassertMarkerKept(t, local)\n391|}\n392|\n393|// A dispatch bound before a crash refuses stale after convergence instead\n394|// of admitting superseded trust.\n395|func TestAuthorizeDispatchStaleAfterConvergence(t *testing.T) {\n396|\tlocal, peer, localCredential, peerCredential, localSnap, _ := twoHostFixture(t)\n397|\tleaf, root := peerMaterialForTest(t, peer, peerCredential)\n398|\tbefore := dispatchRequest(localSnap, localCredential, peerCredential, testHostB, leaf, root, []string{testHostA, testHostB}, testNow)\n399|\tsource := []byte(\"source configuration\\n\")\n400|\treplacement := []byte(\"replacement configuration\\n\")\n401|\tconfigPath := filepath.Join(t.TempDir(), \"config.toml\")\n402|\tif err := os.WriteFile(configPath, source, 0o600); err != nil {\n403|\t\tt.Fatal(err)\n404|\t}\n405|\tstageJointMarker(t, local, jointMarker(configPath, source, replacement, l