ExistsError reports a lost creation race: the lock file already\n79|// exists, so the caller must open it rather than publish over it.\n80|func isLockExistsError(err error) bool {\n81|\treturn os.IsExist(err) || errors.Is(err, unix.EEXIST)\n82|}\n83|\n84|// openLockFD opens one private file description for a single acquisition.\n85|// O_NOFOLLOW refuses symlink escapes at open time; the descriptor never\n86|// follows a link swapped in after Lstat.\n87|func openLockFD(path string) (int, error) {\n88|\tfd, err := unix.Open(path, unix.O_RDWR|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)\n89|\tif err != nil {\n90|\t\tjoined := errors.Join(ErrTrustStoreUnreadable, err)\n91|\t\tif errors.Is(err, unix.ELOOP) {\n92|\t\t\tjoined = errors.Join(ErrTrustUnsafeCustody, err)\n93|\t\t}\n94|\t\treturn -1, trustError(TrustError{Operation: \"open lock\", Err: joined})\n95|\t}\n96|\treturn fd, nil\n97|}\n98|\n99|func (lock *fileLock) shared() (func(), error) {\n100|\tfd, err := openLockFD(lock.path)\n101|\tif err != nil {\n102|\t\treturn nil, err\n103|\t}\n104|\tif err := unix.Flock(fd, unix.LOCK_SH); err != nil {\n105|\t\t_ = unix.Close(fd)\n106|\t\treturn nil, err\n107|\t}\n108|\treturn func() {\n109|\t\t_ = unix.Flock(fd, unix.LOCK_UN)\n110|\t\t_ = unix.Close(fd)\n111|\t}, nil\n112|}\n113|\n114|func (lock *fileLock) exclusive() (func(), error) {\n115|\tfd, err := openLockFD(lock.path)\n116|\tif err != nil {\n117|\t\treturn nil, err\n118|\t}\n119|\tif err := unix.Flock(fd, unix.LOCK_EX); err != nil {\n120|\t\t_ = unix.Close(fd)\n121|\t\treturn nil, err\n122|\t}\n123|\treturn func() {\n124|\t\t_ = unix.Flock(fd, unix.LOCK_UN)\n125|\t\t_ = unix.Close(fd)\n126|\t}, nil\n127|}","final_result":true}}}
