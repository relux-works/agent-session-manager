{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca27","stream":{"kind":"session","id":"01a0aa74-c329-7d72-8811-c1901bb53d47"},"sequence":878,"recorded_at":1780531400001751,"record_type":"event","durability":"durable","causation_id":"e52fa573-a598-4d15-9493-65cb4f83069f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e52fa573-a598-4d15-9493-65cb4f83069f","run_stream":{"kind":"run","id":"e52fa573-a598-4d15-9493-65cb4f83069f"},"call_id":"call_01a0aa78847d728fab65fc4601e34e96","text":"Read text file `internal/hosttrust/rotate.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"crypto/x509\"\n5|\t\"encoding/pem\"\n6|\t\"errors\"\n7|\t\"path/filepath\"\n8|\t\"time\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|)\n12|\n13|// RotationBound is the maximum overlap of an old credential after the trust\n14|// transition admits its replacement: 24 hours, and never past old leaf\n15|// expiry. There is no overlap extension.\n16|const RotationBound = 24 * time.Hour\n17|\n18|// Rotate keeps the host UUID and creates a new credential with two fresh keys\n19|// and certificates. The local atomic trust transition admits the new entry as\n20|// active and marks the old entry retiring with a fixed retire_at no more than\n21|// 24 hours after the transition and no later than old leaf expiry. No second\n22|// rotation starts until the retiring entry is revoked. Failed enrollment\n23|// leaves the new route unavailable, never auto-trusted.\n24|func (store *Store) Rotate(hostID string, now time.Time) (newCredentialID string, retireAt time.Time, err error) {\n25|\tparsed, err := scalar.ParseUUIDv7(hostID)\n26|\tif err != nil {\n27|\t\treturn \"\", time.Time{}, trustError(TrustError{Operation: \"rotate host\", Err: errors.Join(ErrRotationRefused, err)})\n28|\t}\n29|\tissued, err := IssueCredential(parsed.String(), now, nil)\n30|\tif err != nil {\n31|\t\treturn \"\", time.Time{}, err\n32|\t}\n33|\tcredentialHex := scalar.SHA256Digest(issued.LeafDER).Hex()\n34|\tdirectory := filepath.Join(store.root, credentialsDir, credentialHex)\n35|\tif err := ensureOwnerDir(store.fs, directory, 0o700); err != nil {\n36|\t\treturn \"\", time.Time{}, err\n37|\t}\n38|\tcommitted := false\n39|\tdefer func() {\n40|\t\tif !committed {\n41|\t\t\t_ = store.fs.Remove(filepath.Join(directory, certificateFile))\n42|\t\t\t_ = store.fs.Remove(filepath.Join(directory, privateKeyFile))\n43|\t\t\t_ = store.fs.Remove(filepath.Join(directory, rootFile))\n44|\t\t\t_ = store.fs.Remove(directory)\n45|\t\t}\n46|\t}()\n47|\tif err := writeCustodyFile(store, directory, certificateFile, pem.EncodeToMemory(&pem.Block{Type: \"CERTIFICATE\", Bytes: issued.LeafDER})); err != nil {\n48|\t\treturn \"\", time.Time{}, err\n49|\t}\n50|\tif err := writeCustodyFile(store, directory, privateKeyFile, pem.EncodeToMemory(&pem.Block{Type: \"PRIVATE KEY\", Bytes: issued.LeafKeyDER})); err != nil {\n51|\t\treturn \"\", time.Time{}, err\n52|\t}\n53|\tif err := writeCustodyFile(store, directory, rootFile, pem.EncodeToMemory(&pem.Block{Type: \"CERTIFICATE\", Bytes: issued.RootDER})); err != nil {\n54|\t\treturn \"\", time.Time{}, err\n55|\t}\n56|\tenrolledAt, err := scalar.ParseTimestamp(now.UTC().Format(\"2006-01-02T15:04:05.000Z\"))\n57|\tif err != nil {\n58|\t\treturn \"\", time.Time{}, trustError(TrustError{Operation: \"rotate timestamp\", Err: errors.Join(ErrRotationRefused, err)})\n59|\t}\n60|\tnewEntry := CredentialEntry{\n61|\t\tHostID:       issued.HostID,\n62|\t\tCredentialID: scalar.SHA256Digest(issued.LeafDER),\n63|\t\tSPKIID:       scalar.SHA256Digest(mustSPKI(issued.LeafDER)),\n64|\t\tRootID:       scalar.SHA256Digest(issued.RootDER),\n65|\t\tLeafDER:      issued.LeafDER,\n66|\t\tRootDER:      issued.RootDER,\n67|\t\tState:        EntryActive,\n68|\t\tEnrolledAt:   enrolledAt,\n69|\t}\n70|\tvar fixedRetireAt time.Time\n71|\tif err := store.transact(func(trust *TrustStore) error {\n72|\t\told, err := rotationPredecessor(trust, parsed.String())\n73|\t\tif err != nil {\n74|\t\t\treturn err\n75|\t\t}\n76|\t\toldLeaf, err := x509.ParseCertificate(old.LeafDER)\n77|\t\tif err != nil {\n78|\t\t\treturn trustError(TrustError{Operation: \"rotate predecessor\", Err: errors.Join(ErrRotationRefused, err)})\n79|\t\t}\n80|\t\tdeadline := now.Add(RotationBound)\n81|\t\tif oldLeaf.NotAfter.Before(deadline) {\n82|\t\t\tdeadline = oldLeaf.NotAfter\n83|\t\t}\n84|\t\tif !deadline.After(now) {\n85|\t\t\treturn trustError(TrustError{Operation: \"rotate window\", Err: ErrRotationRefused})\n86|\t\t}\n87|\t\tstamp, err := scalar.ParseTimestamp(deadline.UTC().Format(\"2006-01-02T15:04:05.000Z\"))\n88|\t\tif err != nil {\n89|\t\t\treturn trustError(TrustError{Operation: \"rotate window\", Err: errors.Join(ErrRotationRefused, err)})\n90|\t\t}\n91|\t\tfixedRetireAt, err = stamp.Time()\n92|\t\tif err != nil {\n93|\t\t\treturn trustError(TrustError{Operation: \"rotate window\", Err: errors.Join(ErrRotationRefused, err)})\n94|\t\t}\n95|\t\tfor index := range trust.Entries {\n96|\t\t\tif trust.Entries[index].CredentialID.String() == old.CredentialID.String() {\n97|\t\t\t\ttrust.Entries[index].State = EntryRetiring\n98|\t\t\t\tretiring := stamp\n99|\t\t\t\ttrust.Entries[index].RetireAt = &retiring\n100|\t\t\t}\n101|\t\t}\n102|\t\treturn admitEntry(trust, newEntry)\n103|\t}); err != nil {\n104|\t\treturn \"\", time.Time{}, err\n105|\t}\n106|\tcommitted = true\n107|\treturn newEntry.CredentialID.String(), fixedRetireAt, nil\n108|}\n109|\n110|// rotationPredecessor selects the single active credential of a host. A\n111|// retiring entry blocks a second rotation; zero or multiple active entries\n112|// refuse.\n113|func rotationPredecessor(trust *TrustStore, hostID string) (CredentialEntry, error) {\n114|\tvar active []CredentialEntry\n115|\tfor _, entry := range trust.Entries {\n116|\t\tif entry.HostID.String() != hostID {\n117|\t\t\tcontinue\n118|\t\t}\n119|\t\tswitch entry.State {\n120|\t\tcase EntryRetiring:\n121|\t\t\treturn CredentialEntry{}, trustError(TrustError{Operation: \"rotate predecessor\", Err: ErrRotationRefused})\n122|\t\tcase EntryActive:\n123|\t\t\tactive = append(active, entry)\n124|\t\t}\n125|\t}\n126|\tif len(active) != 1 {\n127|\t\treturn CredentialEntry{}, trustError(TrustError{Operation: \"rotate predecessor\", Err: ErrRotationRefused})\n128|\t}\n129|\treturn active[0], nil\n130|}\n131|\n132|// MarkRetiring records a peer's announced rotation locally: the operator\n133|// caught up out of band, enrolled the peer's new tuple, and now bounds the\n134|// old credential with a fixed retire_at. The bound is no more than 24 hours\n135|// after this transition, later than enrollment, and no later than old leaf\n136|// expiry; there is no overlap extension, and only an active entry may retire.\n137|func (store *Store) MarkRetiring(credentialID string, retireAt, now time.Time) error {\n138|\tdigest, err := scalar.ParseDigest(credentialID)\n139|\tif err != nil {\n140|\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: errors.Join(ErrRotationRefused, err)})\n141|\t}\n142|\tstamp, err := scalar.ParseTimestamp(retireAt.UTC().Format(\"2006-01-02T15:04:05.000Z\"))\n143|\tif err != nil {\n144|\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: errors.Join(ErrRotationRefused, err)})\n145|\t}\n146|\treturn store.transact(func(trust *TrustStore) error {\n147|\t\tfor index := range trust.Entries {\n148|\t\t\tif trust.Entries[index].CredentialID.String() != digest.String() {\n149|\t\t\t\tcontinue\n150|\t\t\t}\n151|\t\t\tentry := &trust.Entries[index]\n152|\t\t\tif entry.State != EntryActive {\n153|\t\t\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: ErrRotationRefused})\n154|\t\t\t}\n155|\t\t\tenrolledAt, err := entry.EnrolledAt.Time()\n156|\t\t\tif err != nil {\n157|\t\t\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: errors.Join(ErrRotationRefused, err)})\n158|\t\t\t}\n159|\t\t\tfixed, err := stamp.Time()\n160|\t\t\tif err != nil {\n161|\t\t\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: errors.Join(ErrRotationRefused, err)})\n162|\t\t\t}\n163|\t\t\tif !fixed.After(now) || !fixed.After(enrolledAt) || fixed.After(now.Add(RotationBound)) {\n164|\t\t\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: ErrRotationRefused})\n165|\t\t\t}\n166|\t\t\t// The bound stops no later than old leaf expiry, like the local\n167|\t\t\t// rotation transition: admission already ends at expiry, so a\n168|\t\t\t// later retire_at would promise an overlap that cannot admit.\n169|\t\t\toldLeaf, err := x509.ParseCertificate(entry.LeafDER)\n170|\t\t\tif err != nil {\n171|\t\t\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: errors.Join(ErrRotationRefused, err)})\n172|\t\t\t}\n173|\t\t\tif fixed.After(oldLeaf.NotAfter) {\n174|\t\t\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: ErrRotationRefused})\n175|\t\t\t}\n176|\t\t\tentry.State = EntryRetiring\n177|\t\t\tentry.RetireAt = &stamp\n178|\t\t\treturn nil\n179|\t\t}\n180|\t\treturn trustError(TrustError{Operation: \"retire credential\", Err: ErrRotationRefused})\n181|\t})\n182|}\n183|\n184|// Revoke is an explicit local atomic transition to revoked. It increments\n185|// the generation, forbids all future admissions of that key, and retains the\n186|// public bytes permanently as a reuse tombstone. Revoking an already revoked\n187|// entry refuses: a failed commit reports failure, never absence or success.\n188|// Revocation is local: the operator must distribute it explicitly to every\n189|// peer, and loss or compromise requires revocation plus new out-of-band\n190|// enrollment, never same-key recovery.\n191|func (store *Store) Revoke(credentialID string) error {\n192|\tdigest, err := scalar.ParseDigest(credentialID)\n193|\tif err != nil {\n194|\t\treturn trustError(TrustError{Operation: \"revoke credential\", Err: errors.Join(ErrRevocationRefused, err)})\n195|\t}\n196|\treturn store.transact(func(trust *TrustStore) error {\n197|\t\tfor index := range trust.Entries {\n198|\t\t\tif trust.Entries[index].CredentialID.String() != digest.String() {\n199|\t\t\t\tcontinue\n200|\t\t\t}\n201|\t\t\tif trust.Entries[index].State == EntryRevoked {\n202|\t\t\t\treturn trustError(TrustError{Operation: \"revoke credential\", Err: ErrRevocationRefused})\n203|\t\t\t}\n204|\t\t\ttrust.Entries[index].State = EntryRevoked\n205|\t\t\ttrust.Entries[index].RetireAt = nil\n206|\t\t\treturn nil\n207|\t\t}\n208|\t\treturn trustError(TrustError{Operation: \"revoke credential\", Err: ErrRevocationRefused})\n209|\t})\n210|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca29","stream":{"kind":"session","id":"01a0aa74-c329-7d72-8811-c1901bb53d47"},"sequence":879,"recorded_at":1780531400001753,"record_type":"event","durability":"durable","causation_id":"e52fa573-a598-4d15-9493-65cb4f83069f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e52fa573-a598-4d15-9493-65cb4f83069f","run_stream":{"kind":"run","id":"e52fa573-a598-4d15-9493-65cb4f83069f"},"call_id":"call_01a0aa7885d1716c9b05934236540f10","text":"Read text file `internal/hosttrust/custody.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"io\"\n6|\t\"io/fs\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"time\"\n10|)\n11|\n12|const (\n13|\thostChannelDir  = \"host-channel\"\n14|\ttrustFileName   = \"trust.json\"\n15|\tlockFileName    = \"lock\"\n16|\tcredentialsDir  = \"credentials\"\n17|\tcertificateFile = \"certificate.pem\"\n18|\tprivateKeyFile  = \"private-key.pem\"\n19|\trootFile        = \"root.pem\"\n20|\tstagePrefix     = \".trust-stage-\"\n21|)\n22|\n23|// FileSystem abstracts durable writes so crash and fault paths are testable\n24|// without touching the operator disk. The OS implementation is the only\n25|// production backend.\n26|type FileSystem interface {\n27|\tCreateTemp(dir, pattern string, mode fs.FileMode) (StagedFile, error)\n28|\t// CreateExclusive atomically creates a file that must not exist: it\n29|\t// fails when the path already exists and never replaces a live file.\n30|\tCreateExclusive(path string, mode fs.FileMode) error\n31|\tReadFile(name string) ([]byte, error)\n32|\tLstat(name string) (fs.FileInfo, error)\n33|\tStat(name string) (fs.FileInfo, error)\n34|\tRemove(name string) error\n35|\tRename(oldname, newname string) error\n36|\tMkdirAll(path string, mode fs.FileMode) error\n37|\tChmod(name string, mode fs.FileMode) error\n38|\tOpenDirectory(name string) (SyncedDirectory, error)\n39|\tReadDir(name string) ([]fs.DirEntry, error)\n40|}\n41|\n42|// StagedFile is one temp staging file awaiting fsync and atomic rename.\n43|type StagedFile interface {\n44|\tio.Writer\n45|\tName() string\n46|\tChmod(fs.FileMode) error\n47|\tSync() error\n48|\tClose() error\n49|}\n50|\n51|// SyncedDirectory fsyncs a directory entry after renames.\n52|type SyncedDirectory interface {\n53|\tSync() error\n54|\tClose() error\n55|}\n56|\n57|type osFileSystem struct{}\n58|\n59|func (osFileSystem) CreateTemp(dir, pattern string, mode fs.FileMode) (StagedFile, error) {\n60|\tfile, err := os.CreateTemp(dir, pattern)\n61|\tif err != nil {\n62|\t\treturn nil, err\n63|\t}\n64|\tif err := file.Chmod(mode); err != nil {\n65|\t\t_ = file.Close()\n66|\t\t_ = os.Remove(file.Name())\n67|\t\treturn nil, err\n68|\t}\n69|\treturn file, nil\n70|}\n71|\n72|func (osFileSystem) CreateExclusive(path string, mode fs.FileMode) error {\n73|\tfile, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, mode)\n74|\tif err != nil {\n75|\t\treturn err\n76|\t}\n77|\treturn file.Close()\n78|}\n79|\n80|func (osFileSystem) ReadFile(name string) ([]byte, error)   { return os.ReadFile(name) }\n81|func (osFileSystem) Lstat(name string) (fs.FileInfo, error) { return os.Lstat(name) }\n82|func (osFileSystem) Stat(name string) (fs.FileInfo, error)  { return os.Stat(name) }\n83|func (osFileSystem) Remove(name string) error               { return os.Remove(name) }\n84|func (osFileSystem) Rename(oldname, newname string) error   { return os.Rename(oldname, newname) }\n85|\n86|func (osFileSystem) MkdirAll(path string, mode fs.FileMode) error { return os.MkdirAll(path, mode) }\n87|func (osFileSystem) Chmod(name string, mode fs.FileMode) error    { return os.Chmod(name, mode) }\n88|\n89|func (osFileSystem) OpenDirectory(name string) (SyncedDirectory, error) { return os.Open(name) }\n90|func (osFileSystem) ReadDir(name string) ([]fs.DirEntry, error)         { return os.ReadDir(name) }\n91|\n92|// Store is machine-local Host Channel authority rooted at\n93|// STATE_DIR/host-channel. The zero value is unusable; construct with Open.\n94|type Store struct {\n95|\troot string\n96|\tfs   FileSystem\n97|\tlock *fileLock\n98|}\n99|\n100|// Open validates owner-only custody of STATE_DIR/host-channel, creating the\n101|// directory skeleton with exact 0700/0600 modes when absent. Every open\n102|// re-verifies custody: symlink escapes, foreign ownership and group/world\n103|// access refuse with ErrTrustUnsafeCustody.\n104|func Open(stateDir string) (*Store, error) { return openStore(stateDir, osFileSystem{}) }\n105|\n106|func openStore(stateDir string, filesystem FileSystem) (*Store, error) {\n107|\tif filesystem == nil {\n108|\t\treturn nil, trustError(TrustError{Operation: \"open store\", Err: ErrInvalidStoreContext})\n109|\t}\n110|\tif !filepath.IsAbs(stateDir) {\n111|\t\treturn nil, trustError(TrustError{Operation: \"open store\", Err: ErrInvalidStoreContext})\n112|\t}\n113|\troot := filepath.Join(stateDir, hostChannelDir)\n114|\tif err := ensureOwnerDir(filesystem, root, 0o700); err != nil {\n115|\t\treturn nil, err\n116|\t}\n117|\tif err := ensureOwnerDir(filesystem, filepath.Join(root, credentialsDir), 0o700); err != nil {\n118|\t\treturn nil, err\n119|\t}\n120|\tlock, err := openLock(filesystem, filepath.Join(root, lockFileName))\n121|\tif err != nil {\n122|\t\treturn nil, err\n123|\t}\n124|\tstore := &Store{root: root, fs: filesystem, lock: lock}\n125|\t// Converge one interrupted joint config-plus-trust commit, if any: a\n126|\t// crash between the configuration replacement and the generation bump\n127|\t// must complete forward or abort on restart, never admit the new\n128|\t// configuration with the old generation. A refused recovery fails the\n129|\t// open so incoherent state cannot be used.\n130|\tif _, err := store.Recover(); err != nil {\n131|\t\treturn nil, err\n132|\t}\n133|\treturn store, nil\n134|}\n135|\n136|// Root reports the validated host-channel directory. It carries no secrets.\n137|func (store *Store) Root() string { return store.root }\n138|\n139|// TrustPath reports the trust.json path for operator diagnostics. Reading or\n140|// writing it directly bypasses the authorization lock; use transactions.\n141|func (store *Store) TrustPath() string { return filepath.Join(store.root, trustFileName) }\n142|\n143|// PendingCommitPath reports the pending-commit.json path for operator\n144|// diagnostics. A marker left here after a crash converges automatically on\n145|// the next converged read; a marker that refuses convergence needs\n146|// operator resolution and must never be deleted blindly.\n147|func (store *Store) PendingCommitPath() string { return pendingPath(store.root) }\n148|\n149|// CredentialDir reports the custody directory for one credential ID hex. It\n150|// carries no key material.\n151|func (store *Store) CredentialDir(credentialHex string) (string, error) {\n152|\tif len(credentialHex) != 64 {\n153|\t\treturn \"\", trustError(TrustError{Operation: \"resolve credential directory\", Err: ErrCredentialCustody})\n154|\t}\n155|\tfor _, unit := range credentialHex {\n156|\t\tif (unit < '0' || unit > '9') && (unit < 'a' || unit > 'f') {\n157|\t\t\treturn \"\", trustError(TrustError{Operation: \"resolve credential directory\", Err: ErrCredentialCustody})\n158|\t\t}\n159|\t}\n160|\treturn filepath.Join(store.root, credentialsDir, credentialHex), nil\n161|}\n162|\n163|func ensureOwnerDir(filesystem FileSystem, path string, mode fs.FileMode) error {\n164|\tinfo, err := filesystem.Lstat(path)\n165|\tif err != nil && !os.IsNotExist(err) {\n166|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n167|\t}\n168|\tif err == nil {\n169|\t\t// An existing directory is verified, never repaired: silently\n170|\t\t// narrowing a widened directory would mask the custody violation.\n171|\t\treturn verifyOwnerDir(path, info, mode)\n172|\t}\n173|\tif err := filesystem.MkdirAll(path, mode); err != nil {\n174|\t\treturn trustError(TrustError{Operation: \"create directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n175|\t}\n176|\t// MkdirAll honors umask, so the exact owner-only mode is enforced\n177|\t// explicitly after creation.\n178|\tif err := filesystem.Chmod(path, mode); err != nil {\n179|\t\treturn trustError(TrustError{Operation: \"create directory\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n180|\t}\n181|\t// On platforms where mode bits do not govern access, install the\n182|\t// owner-only ACL at creation: verification below would otherwise\n183|\t// refuse the directory the store just created.\n184|\tif err := secureStaged(path, true); err != nil {\n185|\t\treturn err\n186|\t}\n187|\tinfo, err = filesystem.Lstat(path)\n188|\tif err != nil {\n189|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n190|\t}\n191|\treturn verifyOwnerDir(path, info, mode)\n192|}\n193|\n194|func verifyOwnerDir(path string, info fs.FileInfo, mode fs.FileMode) error {\n195|\tif !info.IsDir() {\n196|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: ErrTrustUnsafeCustody})\n197|\t}\n198|\tif info.Mode()&fs.ModeSymlink != 0 {\n199|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: ErrTrustUnsafeCustody})\n200|\t}\n201|\t// Permission bits are a Unix signal only: on Windows the DACL governs and\n202|\t// Go synthesizes mode bits from the read-only attribute, so an exact\n203|\t// comparison would refuse every Windows path. verifyOwner enforces the\n204|\t// owner-only DACL there.\n205|\tif !platformModeOK(info, mode) {\n206|\t\treturn trustError(TrustError{Operation: \"inspect directory\", Err: ErrTrustUnsafeCustody})\n207|\t}\n208|\treturn verifyOwner(path, info)\n209|}\n210|\n211|// lockVerifyBudget bounds verification retries on an existing lock file.\n212|// A concurrent first-opener can observe the lock between its atomic\n213|// creation and the creator's mode/ACL install; the window is one Chmod and\n214|// one ACL install, so a fraction of a second closes it on any supported\n215|// platform. Genuine custody violations still refuse once the budget\n216|// expires.\n217|const lockVerifyBudget = 500 * time.Millisecond\n218|\n219|const lockVerifyRetry = 5 * time.Millisecond\n220|\n221|// verifyLockFile verifies owner-only custody of an existing lock file. A\n222|// non-regular file refuses immediately: lock creation only ever publishes\n223|// regular files, so a symlink or directory at the path can never be a\n224|// half-installed lock. Other verification failures retry within the\n225|// budget before refusing, so a racing first-open never fails spuriously.\n226|func verifyLockFile(filesystem FileSystem, path string) error {\n227|\tdeadline := time.Now().Add(lockVerifyBudget)\n228|\tfor {\n229|\t\tinfo, err := filesystem.Lstat(path)\n230|\t\tif err != nil {\n231|\t\t\treturn trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n232|\t\t}\n233|\t\tif !info.Mode().IsRegular() || info.Mode()&fs.ModeSymlink != 0 {\n234|\t\t\treturn verifyOwnerFile(path, info, 0o600)\n235|\t\t}\n236|\t\tif err := verifyOwnerFile(path, info, 0o600); err == nil {\n237|\t\t\treturn nil\n238|\t\t} else if time.Now().After(deadline) {\n239|\t\t\treturn err\n240|\t\t}\n241|\t\ttime.Sleep(lockVerifyRetry)\n242|\t}\n243|}\n244|\n245|func verifyOwnerFile(path string, info fs.FileInfo, mode fs.FileMode) error {\n246|\tif !info.Mode().IsRegular() {\n247|\t\treturn trustError(TrustError{Operation: \"inspect file\", Err: ErrTrustUnsafeCustody})\n248|\t}\n249|\tif info.Mode()&fs.ModeSymlink != 0 {\n250|\t\treturn trustError(TrustError{Operation: \"inspect file\", Err: ErrTrustUnsafeCustody})\n251|\t}\n252|\tif !platformModeOK(info, mode) {\n253|\t\treturn trustError(TrustError{Operation: \"inspect file\", Err: ErrTrustUnsafeCustody})\n254|\t}\n255|\treturn verifyOwner(path, info)\n256|}","correlation_facts":{"t