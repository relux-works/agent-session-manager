)\n90|\t\tif err != nil {\n91|\t\t\tt.Fatal(err)\n92|\t\t}\n93|\t\tif _, err := store.Enroll(hosttrust.EnrollInput{HostID: material.HostID, LeafDER: material.LeafDER, RootDER: material.RootDER, Authorized: material.Fingerprints, EnrolledAt: now}); err != nil {\n94|\t\t\tt.Fatalf(\"Enroll(%s) error = %v\", peer, err)\n95|\t\t}\n96|\t}\n97|\treturn &v4Fixture{directory: directory, filename: filename, stateDir: stateDir, inputs: inputs, store: store, self: self, now: now}\n98|}\n99|\n100|func (fixture *v4Fixture) trust(t *testing.T) hosttrust.Snapshot {\n101|\tt.Helper()\n102|\tsnapshot, err := fixture.store.ReadSnapshot()\n103|\tif err != nil {\n104|\t\tt.Fatalf(\"ReadSnapshot error = %v\", err)\n105|\t}\n106|\treturn snapshot\n107|}\n108|\n109|func TestPreviewV4HappyPath(t *testing.T) {\n110|\tfixture := setupV4Fixture(t, testPeerID)\n111|\tpreview, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now)\n112|\tif err != nil {\n113|\t\tt.Fatalf(\"PreviewV4 error = %v\", err)\n114|\t}\n115|\tif preview.SourceVersion != CurrentVersion || preview.CredentialID != fixture.self {\n116|\t\tt.Fatalf(\"preview identity = %+v\", preview.SourceVersion)\n117|\t}\n118|\tif len(preview.RetainedPeers) != 1 || preview.RetainedPeers[0] != testPeerID {\n119|\t\tt.Fatalf(\"retained peers = %v\", preview.RetainedPeers)\n120|\t}\n121|\tif len(preview.DroppedPeers) != 0 || len(preview.BlockingPeers) != 0 {\n122|\t\tt.Fatalf(\"dropped = %v blocking = %v, want empty\", preview.DroppedPeers, preview.BlockingPeers)\n123|\t}\n124|\tloaded, err := Decode(preview.Replacement, DecodeContext{RuntimePlatform: scalar.PlatformMacOS})\n125|\tif err != nil {\n126|\t\tt.Fatalf(\"Decode(preview) error = %v\", err)\n127|\t}\n128|\tif loaded.SourceVersion != Version4 || loaded.Value.Mesh.Transport != TransportSSHTLS13 {\n129|\t\tt.Fatalf(\"preview decodes as %q/%q, want 4.0.0/ssh_tls13\", loaded.SourceVersion, loaded.Value.Mesh.Transport)\n130|\t}\n131|\tif loaded.Value.Mesh.HostChannel == nil || loaded.Value.Mesh.HostChannel.CredentialID != fixture.self {\n132|\t\tt.Fatalf(\"preview host_channel = %+v\", loaded.Value.Mesh.HostChannel)\n133|\t}\n134|\tif len(loaded.Value.Mesh.Peers) != 1 || loaded.Value.HostName != \"fixture-host\" {\n135|\t\tt.Fatal(\"preview dropped retained Config-3 fields\")\n136|\t}\n137|\tcurrent, err := os.ReadFile(fixture.filename)\n138|\tif err != nil {\n139|\t\tt.Fatal(err)\n140|\t}\n141|\tif !bytes.Equal(preview.SourceDocument, current) {\n142|\t\tt.Fatal(\"preview source does not pin the current bytes\")\n143|\t}\n144|}\n145|\n146|func TestPreviewV4AbsentSource(t *testing.T) {\n147|\tfixture := setupV4Fixture(t, testPeerID)\n148|\tif err := os.Remove(fixture.filename); err != nil {\n149|\t\tt.Fatal(err)\n150|\t}\n151|\tif _, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now); err == nil {\n152|\t\tt.Fatal(\"PreviewV4(absent source) succeeded, want refusal\")\n153|\t} else if !errors.Is(err, ErrMigrationSourceAbsent) {\n154|\t\tt.Fatalf(\"PreviewV4(absent) error = %v\", err)\n155|\t}\n156|}\n157|\n158|func TestPreviewV4CredentialWindow(t *testing.T) {\n159|\tfixture := setupV4Fixture(t, testPeerID)\n160|\texpired := fixture.now.Add(91 * 24 * time.Hour)\n161|\tif _, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, expired); err == nil {\n162|\t\tt.Fatal(\"PreviewV4(expired credential window) succeeded, want refusal\")\n163|\t} else if !errors.Is(err, ErrMigrationV4Credential) {\n164|\t\tt.Fatalf(\"PreviewV4(expired window) error = %v\", err)\n165|\t}\n166|}\n167|\n168|func TestPreviewV4RequiresV3Source(t *testing.T) {\n169|\tfixture := setupV4Fixture(t)\n170|\tv1 := append(minimalValidConfigVersion(scalar.PlatformMacOS, Version1), []byte(\"\\n[mesh]\\ntransport = \\\"ssh\\\"\\n\")...)\n171|\tif err := os.WriteFile(fixture.filename, v1, 0o600); err != nil {\n172|\t\tt.Fatal(err)\n173|\t}\n174|\tif _, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now); err == nil {\n175|\t\tt.Fatal(\"PreviewV4(v1 source) succeeded, want refusal: older inputs first use the existing explicit migrations\")\n176|\t} else if !errors.Is(err, ErrMigrationV4Source) {\n177|\t\tt.Fatalf(\"PreviewV4(v1 source) error = %v\", err)\n178|\t}\n179|}\n180|\n181|func TestPreviewV4CredentialGates(t *testing.T) {\n182|\tfixture := setupV4Fixture(t, testPeerID)\n183|\tsnapshot := fixture.trust(t)\n184|\tpeerCredential := \"\"\n185|\tfor _, entry := range snapshot.Trust.Entries {\n186|\t\tif entry.HostID.String() == testPeerID {\n187|\t\t\tpeerCredential = entry.CredentialID.String()\n188|\t\t}\n189|\t}\n190|\tif peerCredential == \"\" {\n191|\t\tt.Fatal(\"peer credential missing from trust\")\n192|\t}\n193|\tunknown := \"sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff\"\n194|\ttests := []struct {\n195|\t\tname       string\n196|\t\tcredential string\n197|\t}{\n198|\t\t{\"unknown credential\", unknown},\n199|\t\t{\"malformed digest\", \"not-a-digest\"},\n200|\t\t{\"peer credential for local mesh\", peerCredential},\n201|\t}\n202|\tfor _, test := range tests {\n203|\t\tt.Run(test.name, func(t *testing.T) {\n204|\t\t\tif _, err := PreviewV4(fixture.inputs, nil, snapshot, test.credential, nil, fixture.now); err == nil {\n205|\t\t\t\tt.Fatalf(\"PreviewV4(%s) succeeded, want refusal\", test.name)\n206|\t\t\t} else if !errors.Is(err, ErrMigrationV4Credential) {\n207|\t\t\t\tt.Fatalf(\"PreviewV4(%s) error = %v\", test.name, err)\n208|\t\t\t}\n209|\t\t})\n210|\t}\n211|\tif err := fixture.store.Revoke(fixture.self); err != nil {\n212|\t\tt.Fatal(err)\n213|\t}\n214|\tif _, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now); err == nil {\n215|\t\tt.Fatal(\"PreviewV4(revoked credential) succeeded, want refusal\")\n216|\t} else if !errors.Is(err, ErrMigrationV4Credential) {\n217|\t\tt.Fatalf(\"PreviewV4(revoked) error = %v\", err)\n218|\t}\n219|}\n220|\n221|func TestPreviewV4PeerEnrollment(t *testing.T) {\n222|\t// The fixture enrolls testPeerID only; the config below additionally\n223|\t// lists testPeerID2 without enrollment.\n224|\tfixture := setupV4Fixture(t, testPeerID)\n225|\tconfiguration := validCurrentConfiguration()\n226|\tconfiguration.Mesh.Peers = append(configuration.Mesh.Peers, Peer{\n227|\t\tHostID: testPeerID2, Name: \"peer2\", Endpoint: \"peer2.example\",\n228|\t\tPlatform: scalar.PlatformLinux, SSHArgs: []string{\"-o\", \"BatchMode=yes\"},\n229|\t})\n230|\tdocument, err := EncodeCurrent(configuration, DecodeContext{RuntimePlatform: scalar.PlatformMacOS})\n231|\tif err != nil {\n232|\t\tt.Fatal(err)\n233|\t}\n234|\tif err := os.WriteFile(fixture.filename, document, 0o600); err != nil {\n235|\t\tt.Fatal(err)\n236|\t}\n237|\tpreview, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now)\n238|\tif err == nil {\n239|\t\tt.Fatal(\"PreviewV4(unenrolled peer) succeeded, want refusal: a missing peer enrollment blocks activation\")\n240|\t} else if !errors.Is(err, ErrMigrationV4PeerEnrollment) {\n241|\t\tt.Fatalf(\"PreviewV4(unenrolled) error = %v\", err)\n242|\t}\n243|\tif len(preview.BlockingPeers) != 1 || preview.BlockingPeers[0] != testPeerID2 {\n244|\t\tt.Fatalf(\"blocking peers = %v, want [%s]\", preview.BlockingPeers, testPeerID2)\n245|\t}\n246|\t// An operator may explicitly remove a peer from the preview.\n247|\tdropped, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, []string{testPeerID2}, fixture.now)\n248|\tif err != nil {\n249|\t\tt.Fatalf(\"PreviewV4(explicit drop) error = %v\", err)\n250|\t}\n251|\tif len(dropped.DroppedPeers) != 1 || dropped.DroppedPeers[0] != testPeerID2 {\n252|\t\tt.Fatalf(\"dropped peers = %v\", dropped.DroppedPeers)\n253|\t}\n254|\tif len(dropped.RetainedPeers) != 1 || dropped.RetainedPeers[0] != testPeerID {\n255|\t\tt.Fatalf(\"retained peers = %v\", dropped.RetainedPeers)\n256|\t}\n257|\t// Unknown, duplicate and name-spelled removals refuse: no silent drop.\n258|\tfor _, drop := range [][]string{{\"0198f4c8-0000-7e55-8e6f-1234567890ab\"}, {testPeerID2, testPeerID2}, {\"peer2\"}} {\n259|\t\tif _, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, drop, fixture.now); err == nil {\n260|\t\t\tt.Fatalf(\"PreviewV4(drop %v) succeeded, want refusal\", drop)\n261|\t\t} else if !errors.Is(err, ErrMigrationV4DropUnknown) {\n262|\t\t\tt.Fatalf(\"PreviewV4(drop %v) error = %v\", drop, err)\n263|\t\t}\n264|\t}\n265|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
