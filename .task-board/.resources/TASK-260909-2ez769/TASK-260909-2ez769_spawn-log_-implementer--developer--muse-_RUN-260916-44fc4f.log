/config/migration_v4_test.go-42-\t\tt.Fatalf(\"EncodeCurrent(fixture) error = %v\", err)\ninternal/config/migration_v4_test.go-43-\t}\ninternal/config/migration_v4_test.go-44-\tfilename := filepath.Join(directory, \"config.toml\")\ninternal/config/migration_v4_test.go-45-\tif err := os.WriteFile(filename, document, 0o600); err != nil {\ninternal/config/migration_v4_test.go-46-\t\tt.Fatal(err)\ninternal/config/migration_v4_test.go-47-\t}\ninternal/config/migration_v4_test.go-48-\tinputs := Inputs{\ninternal/config/migration_v4_test.go-49-\t\tPlatform: scalar.PlatformMacOS, HomeDir: directory, TempDir: directory, WorkingDir: directory,\ninternal/config/migration_v4_test.go-50-\t\tLookupEnv: func(name string) (string, bool) {","correlation_facts":{"tool_name":"search","outcome":"success"}}}
