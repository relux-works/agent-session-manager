{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8dd","stream":{"kind":"session","id":"01a0aa74-c329-7d72-8811-c1901bb53d47"},"sequence":713,"recorded_at":1780531400001421,"record_type":"event","durability":"durable","causation_id":"e52fa573-a598-4d15-9493-65cb4f83069f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e52fa573-a598-4d15-9493-65cb4f83069f","run_stream":{"kind":"run","id":"e52fa573-a598-4d15-9493-65cb4f83069f"},"task_stream":{"kind":"task","id":"01a0aa77-4aec-7a00-82ad-56f0dc8b7d91"},"task_id":"01a0aa77-4aec-7a00-82ad-56f0dc8b7d91","event":{"kind":"output","task_id":"01a0aa77-4aec-7a00-82ad-56f0dc8b7d91","chunk":"Read text file `internal/hosttrust/transact.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|)\n8|\n9|// Snapshot is one coherent committed read: trust bytes plus the generation\n10|// that authorized them. Streams and dispatches bind this generation; any use\n11|// must re-check currency before crossing a side-effect boundary.\n12|type Snapshot struct {\n13|\tGeneration uint64\n14|\tTrust      TrustStore\n15|}\n16|\n17|// TransactionFunc mutates a copy of the committed trust. Returning nil\n18|// commits with generation+1; returning an error aborts with no durable effect.\n19|type TransactionFunc func(trust *TrustStore) error\n20|\n21|// ReadSnapshot obtains one coherent committed snapshot under a shared lock.\n22|// A missing store is ErrTrustStoreMissing, never an empty store. Unreadable,\n23|// malformed or partially read state refuses; leftover staging files from\n24|// crashed commits are ignored and never selected.\n25|func (store *Store) ReadSnapshot() (Snapshot, error) {\n26|\treturn readSnapshot(store.fs, store.root, store.lock)\n27|}\n28|\n29|// WithSharedSnapshot runs fn under the authorization lock with the\n30|// committed trust, so a config-plus-trust pair observed inside fn is\n31|// coherent: no trust or config commit can land between the trust read and\n32|// fn's own reads. Pending joint intent converges before fn runs, so a\n33|// surviving process observes the same converged pair as a reopened store.\n34|// Callers must not acquire the lock again inside fn; internal reads there\n35|// use the supplied committed value directly.\n36|func (store *Store) WithSharedSnapshot(fn func(current TrustStore) error) error {\n37|\tunlock, err := lockForConvergedRead(store.fs, store.root, store.lock)\n38|\tif err != nil {\n39|\t\treturn err\n40|\t}\n41|\tdefer unlock()\n42|\tsnapshot, err := readSnapshotLocked(store.fs, store.root)\n43|\tif err != nil {\n44|\t\treturn err\n45|\t}\n46|\tcommitted := snapshot.Trust\n47|\tif fn == nil {\n48|\t\treturn trustError(TrustError{Operation: \"read snapshot\", Err: ErrAuthorizationRefused})\n49|\t}\n50|\treturn fn(committed)\n51|}\n52|\n53|func readSnapshot(filesystem FileSystem, root string, lock *fileLock) (Snapshot, error) {\n54|\tunlock, err := lockForConvergedRead(filesystem, root, lock)\n55|\tif err != nil {\n56|\t\treturn Snapshot{}, err\n57|\t}\n58|\tdefer unlock()\n59|\treturn readSnapshotLocked(filesystem, root)\n60|}\n61|\n62|// lockForConvergedRead holds the authorization lock for one coherent read,\n63|// converging pending joint intent first. The fast path keeps the shared\n64|// lock when no marker is present: staging a marker needs the exclusive\n65|// lock, so absence observed under shared hold still holds at the read.\n66|// When a marker is present the shared lock is released before the\n67|// exclusive lock is acquired (a held shared lock can never upgrade in\n68|// place without risking a cross-process upgrade deadlock), the leftover\n69|// converges or refuses, and the read proceeds under the exclusive hold.\n70|// Convergence may move the generation forward; callers compare request\n71|// bindings against the converged read, never by refreshing a stale number.\n72|func lockForConvergedRead(filesystem FileSystem, root string, lock *fileLock) (func(), error) {\n73|\tunlock, err := lock.shared()\n74|\tif err != nil {\n75|\t\treturn nil, trustError(TrustError{Operation: \"lock snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n76|\t}\n77|\tpresent, err := markerPresent(filesystem, root)\n78|\tif err != nil {\n79|\t\tunlock()\n80|\t\treturn nil, err\n81|\t}\n82|\tif !present {\n83|\t\treturn unlock, nil\n84|\t}\n85|\tunlock()\n86|\tunlock, err = lock.exclusive()\n87|\tif err != nil {\n88|\t\treturn nil, trustError(TrustError{Operation: \"lock snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n89|\t}\n90|\tif err := convergeLocked(filesystem, root); err != nil {\n91|\t\tunlock()\n92|\t\treturn nil, err\n93|\t}\n94|\treturn unlock, nil\n95|}\n96|\n97|// readSnapshotLocked reads one coherent committed snapshot assuming the\n98|// caller already holds the authorization lock and has converged pending\n99|// joint intent (see lockForConvergedRead): reading beside an unresolved\n100|// marker would admit a superseded generation with replaced configuration.\n101|func readSnapshotLocked(filesystem FileSystem, root string) (Snapshot, error) {\n102|\tpath := filepath.Join(root, trustFileName)\n103|\tinfo, err := filesystem.Lstat(path)\n104|\tif err != nil {\n105|\t\tif os.IsNotExist(err) {\n106|\t\t\treturn Snapshot{}, trustError(TrustError{Operation: \"read snapshot\", Err: ErrTrustStoreMissing})\n107|\t\t}\n108|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"read snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n109|\t}\n110|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n111|\t\treturn Snapshot{}, err\n112|\t}\n113|\tdocument, err := filesystem.ReadFile(path)\n114|\tif err != nil {\n115|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"read snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n116|\t}\n117|\tstore, err := DecodeTrust(document)\n118|\tif err != nil {\n119|\t\treturn Snapshot{}, err\n120|\t}\n121|\treturn Snapshot{Generation: store.Generation, Trust: store}, nil\n122|}\n123|\n124|// Initialize creates the explicit empty generation-1 store. It refuses when\n125|// trust.json already exists: setup never overwrites committed authority.\n126|// Pending joint intent converges first, so setup never builds beside an\n127|// unresolved marker.\n128|func (store *Store) Initialize() (Snapshot, error) {\n129|\tunlock, err := store.lock.exclusive()\n130|\tif err != nil {\n131|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"lock initialize\", Err: errors.Join(ErrTrustDurability, err)})\n132|\t}\n133|\tdefer unlock()\n134|\tif err := convergeLocked(store.fs, store.root); err != nil {\n135|\t\treturn Snapshot{}, err\n136|\t}\n137|\tpath := filepath.Join(store.root, trustFileName)\n138|\tif _, err := store.fs.Lstat(path); err == nil {\n139|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"initialize store\", Err: ErrTrustDurability})\n140|\t} else if !os.IsNotExist(err) {\n141|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"initialize store\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n142|\t}\n143|\tdocument, err := EncodeTrust(TrustStore{Generation: 1})\n144|\tif err != nil {\n145|\t\treturn Snapshot{}, err\n146|\t}\n147|\tif err := commitDocument(store.fs, store.root, path, document); err != nil {\n148|\t\treturn Snapshot{}, err\n149|\t}\n150|\t// The exclusive lock is still held: read without re-acquiring, since a\n151|\t// second acquisition in this goroutine would block on the held lock.\n152|\treturn readSnapshotLocked(store.fs, store.root)\n153|}\n154|\n155|// transact runs one crash-durable generation transaction under the exclusive\n156|// cross-process lock: load committed state, apply fn, encode, stage with\n157|// fsync, atomic rename, directory fsync. A missing store refuses with\n158|// ErrTrustStoreMissing: only explicit Initialize commits generation 1. Any\n159|// other malformed state refuses before fn runs.\n160|func (store *Store) transact(fn TransactionFunc) error {\n161|\treturn transact(store.fs, store.root, store.lock, fn)\n162|}\n163|\n164|func transact(filesystem FileSystem, root string, lock *fileLock, fn TransactionFunc) error {\n165|\tunlock, err := lock.exclusive()\n166|\tif err != nil {\n167|\t\treturn trustError(TrustError{Operation: \"lock transaction\", Err: errors.Join(ErrTrustDurability, err)})\n168|\t}\n169|\tdefer unlock()\n170|\tif err := convergeLocked(filesystem, root); err != nil {\n171|\t\treturn err\n172|\t}\n173|\treturn transactLocked(filesystem, root, fn)\n174|}\n175|\n176|// transactLocked runs one crash-durable generation transaction assuming the\n177|// caller already holds the exclusive authorization lock. Joint commits and\n178|// recovery use it to sequence the marker, the external replacement and the\n179|// bump under a single hold.\n180|func transactLocked(filesystem FileSystem, root string, fn TransactionFunc) error {\n181|\tcommitted, err := loadCommitted(filesystem, root)\n182|\tif err != nil {\n183|\t\treturn err\n184|\t}\n185|\tnext := committed\n186|\tnext.Entries = append([]CredentialEntry(nil), committed.Entries...)\n187|\tif err := fn(&next); err != nil {\n188|\t\treturn err\n189|\t}\n190|\tif next.Generation != committed.Generation {\n191|\t\treturn trustError(TrustError{Operation: \"commit generation\", Err: ErrTrustDurability})\n192|\t}\n193|\tif committed.Generation >= MaxGeneration {\n194|\t\treturn trustError(TrustError{Operation: \"commit generation\", Err: ErrGenerationExhausted})\n195|\t}\n196|\tnext.Generation = committed.Generation + 1\n197|\tencoded, err := EncodeTrust(next)\n198|\tif err != nil {\n199|\t\treturn err\n200|\t}\n201|\tif err := commitDocument(filesystem, root, filepath.Join(root, trustFileName), encoded); err != nil {\n202|\t\treturn err\n203|\t}\n204|\treturn nil\n205|}\n206|\n207|// loadCommitted reads the committed trust without acquiring the lock: the\n208|// caller must already hold the authorization lock, and (outside recovery\n209|// itself) must have converged pending joint intent first.\n210|func loadCommitted(filesystem FileSystem, root string) (TrustStore, error) {\n211|\tpath := filepath.Join(root, trustFileName)\n212|\tinfo, err := filesystem.Lstat(path)\n213|\tif err != nil {\n214|\t\tif os.IsNotExist(err) {\n215|\t\t\treturn TrustStore{}, trustError(TrustError{Operation: \"read committed trust\", Err: ErrTrustStoreMissing})\n216|\t\t}\n217|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"read committed trust\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n218|\t}\n219|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n220|\t\treturn TrustStore{}, err\n221|\t}\n222|\tdocument, err := filesystem.ReadFile(path)\n223|\tif err != nil {\n224|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"read committed trust\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n225|\t}\n226|\tdecoded, err := DecodeTrust(document)\n227|\tif err != nil {\n228|\t\treturn TrustStore{}, err\n229|\t}\n230|\treturn decoded, nil\n231|}\n232|\n233|// commitDocument stages bytes in a temp file with fsync, atomically renames\n234|// over the target, and fsyncs the directory. On restart only the last fully\n235|// committed file is selected; staged files are ignored by every reader.\n236|func commitDocument(filesystem FileSystem, root, path string, document []byte) error {\n237|\tstaged, err := filesystem.CreateTemp(root, stagePrefix+\"*\", 0o600)\n238|\tif err != nil {\n239|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n240|\t}\n241|\tname := staged.Name()\n242|\tfailed := true\n243|\tdefer func() {\n244|\t\tif failed {\n245|\t\t\t_ = filesystem.Remove(name)\n246|\t\t}\n247|\t}()\n248|\tif err := writeAll(staged, document); err != nil {\n249|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n250|\t}\n251|\tif err := staged.Sync(); err != nil {\n252|\t\t_ = staged.Close()\n253|\t\treturn trustError(TrustError{Operation: \"sync trust\", Err: errors.Join(ErrTrustDurability, err)})\n254|\t}\n255|\tif err := staged.Close(); err != nil {\n256|\t\treturn trustError(TrustError{Operation: \"sync trust\", Err: errors.Join(ErrTrustDurability, err)})\n257|\t}\n258|\tif err := filesystem.Chmod(name, 0o600); err != nil {\n259|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n260|\t}\n261|\t// On platforms where mode bits do not govern access, install the\n262|\t// owner-only ACL before the staging file becomes visible under load.\n263|\tif err := secureStaged(name, false); err != nil {\n264|\t\treturn err\n265|\t}\n266|\tif err := filesystem.Rename(name, path); err != nil {\n267|\t\treturn trustError(TrustError{Operation: \"replace trust\", Err: errors.Join(ErrTrustDurability, err)})\n268|\t}\n269|\tif err := syncDir(filesystem, root); err != nil {\n270|\t\treturn trustError(TrustError{Operation: \"sync trust directory\", Err: errors.Join(ErrTrustDurability, err)})\n271|\t}\n272|\tfailed = false\n273|\treturn nil\n274|}\n275|\n276|func writeAll(writer interface{ Write([]byte) (int, error) }, document []byte) error {\n277|\tfor len(document) > 0 {\n278|\t\twritten, err := writer.Write(document)\n279|\t\tif err != nil {\n280|\t\t\treturn err\n281|\t\t}\n282|\t\tif written == 0 {\n283|\t\t\treturn errors.New(\"short trust write\")\n284|\t\t}\n285|\t\tdocument = document[written:]\n286|\t}\n287|\treturn nil\n288|}\n289|\n290|func syncDir(filesystem FileSystem, root string) error {\n291|\thandle, err := filesystem.OpenDirectory(root)\n292|\tif err != nil {\n293|\t\treturn err\n294|\t}\n295|\tif err := handle.Sync(); err != nil {\n296|\t\t_ = handle.Close()\n297|\t\treturn err\n298|\t}\n299|\treturn handle.Close()\n300|}","final_result":true}}}
