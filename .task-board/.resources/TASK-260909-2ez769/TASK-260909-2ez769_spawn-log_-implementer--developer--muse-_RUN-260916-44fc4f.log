{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cac5","stream":{"kind":"session","id":"01a0aa74-c329-7d72-8811-c1901bb53d47"},"sequence":957,"recorded_at":1780531400001909,"record_type":"event","durability":"durable","causation_id":"e52fa573-a598-4d15-9493-65cb4f83069f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e52fa573-a598-4d15-9493-65cb4f83069f","run_stream":{"kind":"run","id":"e52fa573-a598-4d15-9493-65cb4f83069f"},"task_stream":{"kind":"task","id":"01a0aa78-c82d-7231-8bc1-ed614746a16b"},"task_id":"01a0aa78-c82d-7231-8bc1-ed614746a16b","event":{"kind":"output","task_id":"01a0aa78-c82d-7231-8bc1-ed614746a16b","chunk":"Read text file `internal/config/migration_v4_apply_test.go`.\n1|package config\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"errors\"\n6|\t\"os\"\n7|\t\"os/exec\"\n8|\t\"path/filepath\"\n9|\t\"testing\"\n10|\t\"time\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/hosttrust\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|)\n15|\n16|func TestApplyV4EmptyPreview(t *testing.T) {\n17|\tfixture := setupV4Fixture(t, testPeerID)\n18|\tif _, err := ApplyV4(fixture.inputs, nil, V4Preview{}, true, fixture.now); err == nil {\n19|\t\tt.Fatal(\"ApplyV4(empty preview) succeeded, want refusal: only the exact preview applies\")\n20|\t} else if !errors.Is(err, ErrMigrationV4PreviewMismatch) {\n21|\t\tt.Fatalf(\"ApplyV4(empty) error = %v\", err)\n22|\t}\n23|}\n24|\n25|func TestApplyV4AbsentSource(t *testing.T) {\n26|\tfixture := setupV4Fixture(t, testPeerID)\n27|\tpreview, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now)\n28|\tif err != nil {\n29|\t\tt.Fatalf(\"PreviewV4 error = %v\", err)\n30|\t}\n31|\tif err := os.Remove(fixture.filename); err != nil {\n32|\t\tt.Fatal(err)\n33|\t}\n34|\tif _, err := ApplyV4(fixture.inputs, nil, preview, true, fixture.now); err == nil {\n35|\t\tt.Fatal(\"ApplyV4(absent source) succeeded, want refusal\")\n36|\t} else if !errors.Is(err, ErrMigrationSourceAbsent) {\n37|\t\tt.Fatalf(\"ApplyV4(absent) error = %v\", err)\n38|\t}\n39|}\n40|\n41|func TestApplyV4HappyPath(t *testing.T) {\n42|\tfixture := setupV4Fixture(t, testPeerID)\n43|\tsource, err := os.ReadFile(fixture.filename)\n44|\tif err != nil {\n45|\t\tt.Fatal(err)\n46|\t}\n47|\tpreview, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now)\n48|\tif err != nil {\n49|\t\tt.Fatalf(\"PreviewV4 error = %v\", err)\n50|\t}\n51|\tresult, err := ApplyV4(fixture.inputs, nil, preview, true, fixture.now)\n52|\tif err != nil {\n53|\t\tt.Fatalf(\"ApplyV4 error = %v\", err)\n54|\t}\n55|\tif result.Migration.SourceVersion != CurrentVersion || result.Migration.TargetVersion != Version4 {\n56|\t\tt.Fatalf(\"apply migration = %+v\", result.Migration)\n57|\t}\n58|\tif !result.Migration.Changed || result.Generation != preview.SourceGeneration+1 {\n59|\t\tt.Fatalf(\"apply result = %+v, want changed and generation %d\", result, preview.SourceGeneration+1)\n60|\t}\n61|\tinstalled, err := os.ReadFile(fixture.filename)\n62|\tif err != nil {\n63|\t\tt.Fatal(err)\n64|\t}\n65|\tif !bytes.Equal(installed, preview.Replacement) {\n66|\t\tt.Fatal(\"installed configuration is not the exact confirmed preview\")\n67|\t}\n68|\tbackup, err := os.ReadFile(result.Migration.BackupPath)\n69|\tif err != nil {\n70|\t\tt.Fatalf(\"backup read error = %v\", err)\n71|\t}\n72|\tif !bytes.Equal(backup, source) {\n73|\t\tt.Fatal(\"owner-only backup does not hold the source bytes\")\n74|\t}\n75|\tloaded, err := Decode(installed, DecodeContext{RuntimePlatform: scalar.PlatformMacOS})\n76|\tif err != nil {\n77|\t\tt.Fatalf(\"Decode(installed) error = %v\", err)\n78|\t}\n79|\tif loaded.SourceVersion != Version4 {\n80|\t\tt.Fatalf(\"installed source = %q, want 4.0.0\", loaded.SourceVersion)\n81|\t}\n82|\t// The same preview cannot apply twice: the source moved.\n83|\tif _, err := ApplyV4(fixture.inputs, nil, preview, true, fixture.now); err == nil {\n84|\t\tt.Fatal(\"second ApplyV4(same preview) succeeded, want stale-source refusal\")\n85|\t} else if !errors.Is(err, ErrMigrationV4Source) && !errors.Is(err, ErrMigrationV4StaleSource) {\n86|\t\tt.Fatalf(\"second ApplyV4 error = %v\", err)\n87|\t}\n88|}\n89|\n90|func TestApplyV4ConfirmRequired(t *testing.T) {\n91|\tfixture := setupV4Fixture(t, testPeerID)\n92|\tsource, err := os.ReadFile(fixture.filename)\n93|\tif err != nil {\n94|\t\tt.Fatal(err)\n95|\t}\n96|\tpreview, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now)\n97|\tif err != nil {\n98|\t\tt.Fatalf(\"PreviewV4 error = %v\", err)\n99|\t}\n100|\tif _, err := ApplyV4(fixture.inputs, nil, preview, false, fixture.now); err == nil {\n101|\t\tt.Fatal(\"ApplyV4(unconfirmed) succeeded, want refusal\")\n102|\t} else if !errors.Is(err, ErrMigrationV4ConfirmRequired) {\n103|\t\tt.Fatalf(\"ApplyV4(unconfirmed) error = %v\", err)\n104|\t}\n105|\tafter, err := os.ReadFile(fixture.filename)\n106|\tif err != nil {\n107|\t\tt.Fatal(err)\n108|\t}\n109|\tif !bytes.Equal(after, source) {\n110|\t\tt.Fatal(\"unconfirmed apply mutated the configuration\")\n111|\t}\n112|}\n113|\n114|func TestApplyV4ConfirmRequiredWithDrops(t *testing.T) {\n115|\t// Confirmation is unconditional: even a preview that drops every peer\n116|\t// refuses without it.\n117|\tfixture := setupV4Fixture(t, testPeerID)\n118|\tpreview, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, []string{testPeerID}, fixture.now)\n119|\tif err != nil {\n120|\t\tt.Fatalf(\"PreviewV4(drop) error = %v\", err)\n121|\t}\n122|\tif len(preview.DroppedPeers) != 1 {\n123|\t\tt.Fatalf(\"dropped = %v, want one peer\", preview.DroppedPeers)\n124|\t}\n125|\tif _, err := ApplyV4(fixture.inputs, nil, preview, false, fixture.now); err == nil {\n126|\t\tt.Fatal(\"ApplyV4(unconfirmed with drops) succeeded, want refusal\")\n127|\t} else if !errors.Is(err, ErrMigrationV4ConfirmRequired) {\n128|\t\tt.Fatalf(\"ApplyV4(unconfirmed drops) error = %v\", err)\n129|\t}\n130|}\n131|\n132|func TestApplyV4StaleSource(t *testing.T) {\n133|\tfixture := setupV4Fixture(t, testPeerID)\n134|\tpreview, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now)\n135|\tif err != nil {\n136|\t\tt.Fatalf(\"PreviewV4 error = %v\", err)\n137|\t}\n138|\tsnapshot, err := Load(fixture.inputs, nil)\n139|\tif err != nil {\n140|\t\tt.Fatal(err)\n141|\t}\n142|\tloaded, _ := snapshot.Configuration()\n143|\tloaded.Value.HostName = \"renamed-host\"\n144|\tcontext := DecodeContext{RuntimePlatform: scalar.PlatformMacOS}\n145|\trenamed, err := EncodeCurrent(loaded.Value, context)\n146|\tif err != nil {\n147|\t\tt.Fatal(err)\n148|\t}\n149|\tif err := os.WriteFile(fixture.filename, renamed, 0o600); err != nil {\n150|\t\tt.Fatal(err)\n151|\t}\n152|\tif _, err := ApplyV4(fixture.inputs, nil, preview, true, fixture.now); err == nil {\n153|\t\tt.Fatal(\"ApplyV4(changed source) succeeded, want stale-source refusal\")\n154|\t} else if !errors.Is(err, ErrMigrationV4StaleSource) {\n155|\t\tt.Fatalf(\"ApplyV4(changed source) error = %v\", err)\n156|\t}\n157|}\n158|\n159|func TestApplyV4StaleGeneration(t *testing.T) {\n160|\tfixture := setupV4Fixture(t, testPeerID)\n161|\tpreview, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now)\n162|\tif err != nil {\n163|\t\tt.Fatalf(\"PreviewV4 error = %v\", err)\n164|\t}\n165|\t// Any committed trust change invalidates the preview generation.\n166|\tif err := fixture.store.Revoke(preview.CredentialID); err != nil {\n167|\t\t// Revoking the selected credential also moves the generation; either\n168|\t\t// refusal proves the preview no longer authorizes.\n169|\t\tt.Fatal(err)\n170|\t}\n171|\tif _, err := ApplyV4(fixture.inputs, nil, preview, true, fixture.now); err == nil {\n172|\t\tt.Fatal(\"ApplyV4(moved generation) succeeded, want refusal\")\n173|\t} else if !errors.Is(err, ErrMigrationV4StaleGeneration) && !errors.Is(err, ErrMigrationV4Credential) {\n174|\t\tt.Fatalf(\"ApplyV4(moved generation) error = %v\", err)\n175|\t}\n176|}\n177|\n178|func TestApplyV4PreviewMismatch(t *testing.T) {\n179|\tfixture := setupV4Fixture(t, testPeerID)\n180|\tpreview, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now)\n181|\tif err != nil {\n182|\t\tt.Fatalf(\"PreviewV4 error = %v\", err)\n183|\t}\n184|\ttampered := preview\n185|\ttampered.Replacement = append([]byte(nil), preview.Replacement...)\n186|\t// Flip one byte inside the host name, keeping length: only the exact\n187|\t// preview applies.\n188|\tmarker := []byte(\"fixture-host\")\n189|\tat := bytes.Index(tampered.Replacement, marker)\n190|\tif at < 0 {\n191|\t\tt.Fatal(\"preview has no host name marker\")\n192|\t}\n193|\ttampered.Replacement[at] = 'X'\n194|\tif _, err := ApplyV4(fixture.inputs, nil, tampered, true, fixture.now); err == nil {\n195|\t\tt.Fatal(\"ApplyV4(tampered preview) succeeded, want refusal\")\n196|\t} else if !errors.Is(err, ErrMigrationV4PreviewMismatch) {\n197|\t\tt.Fatalf(\"ApplyV4(tampered) error = %v\", err)\n198|\t}\n199|}\n200|\n201|func TestApplyV4CustodyFailure(t *testing.T) {\n202|\tfixture := setupV4Fixture(t, testPeerID)\n203|\tpreview, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now)\n204|\tif err != nil {\n205|\t\tt.Fatalf(\"PreviewV4 error = %v\", err)\n206|\t}\n207|\thex := preview.CredentialID[len(\"sha256:\"):]\n208|\tprivate := filepath.Join(fixture.stateDir, \"host-channel\", \"credentials\", hex, \"private-key.pem\")\n209|\tif err := os.Remove(private); err != nil {\n210|\t\tt.Fatal(err)\n211|\t}\n212|\tif _, err := ApplyV4(fixture.inputs, nil, preview, true, fixture.now); err == nil {\n213|\t\tt.Fatal(\"ApplyV4(broken custody) succeeded, want refusal\")\n214|\t}\n215|}\n216|\n217|func TestApplyV4TrustCommitRecovery(t *testing.T) {\n218|\tif os.Geteuid() == 0 {\n219|\t\tt.Skip(\"permission-bit recovery does not bind the superuser\")\n220|\t}\n221|\tfixture := setupV4Fixture(t, testPeerID)\n222|\tsource, err := os.ReadFile(fixture.filename)\n223|\tif err != nil {\n224|\t\tt.Fatal(err)\n225|\t}\n226|\tpreview, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now)\n227|\tif err != nil {\n228|\t\tt.Fatalf(\"PreviewV4 error = %v\", err)\n229|\t}\n230|\tbefore := fixture.trust(t).Generation\n231|\tchannel := filepath.Join(fixture.stateDir, \"host-channel\")\n232|\tif err := os.Chmod(channel, 0o500); err != nil {\n233|\t\tt.Fatal(err)\n234|\t}\n235|\tdefer func() { _ = os.Chmod(channel, 0o700) }()\n236|\tif _, err := ApplyV4(fixture.inputs, nil, preview, true, fixture.now); err == nil {\n237|\t\tt.Fatal(\"ApplyV4(failing trust commit) succeeded, want failure\")\n238|\t}\n239|\tafter, err := os.ReadFile(fixture.filename)\n240|\tif err != nil {\n241|\t\tt.Fatal(err)\n242|\t}\n243|\tif !bytes.Equal(after, source) {\n244|\t\tt.Fatal(\"trust commit failure left the replaced configuration without recovery\")\n245|\t}\n246|\tif err := os.Chmod(channel, 0o700); err != nil {\n247|\t\tt.Fatal(err)\n248|\t}\n249|\tcurrent, err := fixture.store.ReadSnapshot()\n250|\tif err != nil {\n251|\t\tt.Fatal(err)\n252|\t}\n253|\tif current.Generation != before {\n254|\t\tt.Fatalf(\"failed apply bumped generation %d to %d\", before, current.Generation)\n255|\t}\n256|}\n257|\n258|func TestApplyV4ConfigWriteFailureKeepsGeneration(t *testing.T) {\n259|\tfixture := setupV4Fixture(t, testPeerID)\n260|\tsource, err := os.ReadFile(fixture.filename)\n261|\tif err != nil {\n262|\t\tt.Fatal(err)\n263|\t}\n264|\tpreview, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now)\n265|\tif err != nil {\n266|\t\tt.Fatalf(\"PreviewV4 error = %v\", err)\n267|\t}\n268|\tbefore := fixture.trust(t).Generation\n269|\tfailing := &faultMigrationFileSystem{failRenameCall: 1}\n270|\tif _, err := applyV4(fixture.inputs, nil, preview, true, fixture.now, failing, hosttrust.Open); err == nil {\n271|\t\tt.Fatal(\"ApplyV4(failing config replace) succeeded, want failure\")\n272|\t}\n273|\tafter, err := os.ReadFile(fixture.filename)\n274|\tif err != nil {\n275|\t\tt.Fatal(err)\n276|\t}\n277|\tif !bytes.Equal(after, source) {\n278|\t\tt.Fatal(\"failed config replacement changed the source bytes\")\n279|\t}\n280|\tcurrent, err := fixture.store.ReadSnapshot()\n281|\tif err != nil {\n282|\t\tt.Fatal(err)\n283|\t}\n284|\tif current.Generation != before {\n285|\t\tt.Fatalf(\"failed config replacement bumped generation %d to %d\", before, current.Generation)\n286|\t}\n287|}\n288|\n289|func TestRollbackV4(t *testing.T) {\n290|\tfixture := setupV4Fixture(t, testPeerID)\n291|\tsource, err := os.ReadFile(fixture.filename)\n292|\tif err != nil {\n293|\t\tt.Fatal(err)\n294|\t}\n295|\tpreview, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now)\n296|\tif err != nil {\n297|\t\tt.Fatalf(\"PreviewV4 error = %v\", err)\n298|\t}\n299|\tapplied, err := ApplyV4(fixture.inputs, nil, preview, true, fixture.now)\n300|\tif err != nil {\n301|\t\tt.Fatalf(\"ApplyV4 error = %v\", err)\n302|\t}\n303|\tif _, err := RollbackV4(fixture.inputs, nil, RollbackV4Options{}); err == nil {\n304|\t\tt.Fatal(\"RollbackV4 without acknowledgement succeeded, want refusal\")\n305|\t} else if !errors.Is(err, ErrRollbackV4AckRequired) {\n306|\t\tt.Fatalf(\"RollbackV4(no ack) error = %v\", err)\n307|\t}\n308|\trolled, err := RollbackV4(fixture.inputs, nil, RollbackV4Options{AcknowledgeNoHostChannelAssurance: true})\n309|\tif err != nil {\n310|\t\tt.Fatalf(\"RollbackV4 error = %v\", err)\n311|\t}\n312|\tif !rolled.Migration.Changed || rolled.Migration.TargetVersion != CurrentVersion {\n313|\t\tt.Fatalf(\"rollback = %+v, want changed to %q\", rolled.Migration, CurrentVersion)\n314|\t}\n315|\tif rolled.Generation != applied.Generation+1 {\n316|\t\tt.Fatalf(\"rollback generation = %d, want %d\", rolled.Generation, applied.Generation+1)\n317|\t}\n318|\trestored, err := os.ReadFile(fixture.filename)\n319|\tif err != nil {\n320|\t\tt.Fatal(err)\n321|\t}\n322|\tif !bytes.Equal(restored, source) {\n323|\t\tt.Fatal(\"rollback did not restore the preserved backup bytes\")\n324|\t}\n325|\t// Rolling back the restored state is a no-op, never a second mutation.\n326|\tagain, err := RollbackV4(fixture.inputs, nil, RollbackV4Options{AcknowledgeNoHostChannelAssurance: true})\n327|\tif err != nil {\n328|\t\tt.Fatalf(\"second RollbackV4 error = %v\", err)\n329|\t}\n330|\tif again.Migration.Changed {\n331|\t\tt.Fatal(\"second rollback reported a change on identical bytes\")\n332|\t}\n333|}\n334|\n335|// crownTrustAtExhaustion rewrites the fixture trust at the uint53 ceiling:\n336|// the next generation bump is genuinely refused, which faults the joint\n337|// commit after the configuration replacement is already durable.\n338|func crownTrustAtExhaustion(t *testing.T, fixture *v4Fixture) {\n339|\tt.Helper()\n340|\tsnapshot := fixture.trust(t)\n341|\tcrowned := hosttrust.TrustStore{Generation: hosttrust.MaxGeneration, Entries: snapshot.Trust.Entries}\n342|\tdocument, err := hosttrust.EncodeTrust(crowned)\n343|\tif err != nil {\n344|\t\tt.Fatalf(\"EncodeTrust(exhausted) error = %v\", err)\n345|\t}\n346|\tif err := os.WriteFile(filepath.Join(fixture.stateDir, \"host-channel\", \"trust.json\"), document, 0o600); err != nil {\n347|\t\tt.Fatal(err)\n348|\t}\n349|}\n350|\n351|// crashAfterReplaceFileSystem terminates the process with exit 77\n352|// immediately after the real configuration replacement rename lands. It\n353|// stages a genuine post-replacement crash: the marker is durable, the new\n354|// bytes are installed, and the generation bump never ran.\n355|type crashAfterReplaceFileSystem struct {\n356|\tosMigrationFileSystem\n357|\ttarget string\n358|}\n359|\n360|func (filesystem crashAfterReplaceFileSystem) Rename(from, to string) error {\n361|\tif err := filesystem.osMigrationFileSystem.Rename(from, to); err != nil {\n362|\t\treturn err\n363|\t}\n364|\tif to == filesystem.target {\n365|\t\tos.Exit(77)\n366|\t}\n367|\treturn nil\n368|}\n369|\n370|func TestApplyV4CrashConvergesGeneration(t *testing.T) {\n371|\tif directory := os.Getenv(\"AX_V4_CRASH_FIXTURE\"); directory != \"\" {\n372|\t\tfilename := filepath.Join(directory, \"config.toml\")\n373|\t\tstate := filepath.Join(directory, \"state\")\n374|\t\tinputs := Inputs{Platform: scalar.PlatformMacOS, HomeDir: directory, TempDir: directory, WorkingDir: directory, Stat: os.Stat, ReadFile: os.ReadFile, LookupEnv: func(key string) (string, bool) {\n375|\t\t\tif key == \"AX_CONFIG\" {\n376|\t\t\t\treturn filename, true\n377|\t\t\t}\n378|\t\t\tif key == \"AX_STATE_DIR\" {\n379|\t\t\t\treturn state, true\n380|\t\t\t}\n381|\t\t\treturn \"\", false\n382|\t\t}}\n383|\t\tstore, err := hosttrust.Open(state)\n384|\t\tif err != nil {\n385|\t\t\tt.Fatal(err)\n386|\t\t}\n387|\t\tsnapshot, err := store.ReadSnapshot()\n388|\t\tif err != nil {\n389|\t\t\tt.Fatal(err)\n390|\t\t}\n391|\t\tvar self string\n392|\t\tfor _, entry := range snapshot.Trust.Entries {\n393|\t\t\tif entry.HostID.String() == testHostID {\n394|\t\t\t\tself = entry.CredentialID.String()\n395|\t\t\t}\n396|\t\t}\n397|\t\tnow := time.Now().UTC()\n398|\t\tpreview, err := PreviewV4(inputs, nil, snapshot, self, nil, now)\n399|\t\tif err != nil {\n400|\t\t\tt.Fatal(err)\n401|\t\t}\n402|\t\t_, err = applyV4(inputs, nil, preview, true, now, crashAfterReplaceFileSystem{target: filename}, hosttrust.Open)\n403|\t\tt.Fatalf(\"crash seam not reached: %v\", err)\n404|\t}\n405|\tfixture := setupV4Fixture(t, testPeerID)\n406|\tbefore := fixture.trust(t).Generation\n407|\tcommand := exec.Command(os.Args[0], \"-test.run=^TestApplyV4CrashConvergesGeneration$\")\n408|\tcommand.Env = append(os.Environ(), \"AX_V4_CRASH_FIXTURE=\"+fixture.directory)\n409|\toutput, err := command.CombinedOutput()\n410|\texit, ok := err.(*exec.ExitError)\n411|\tif !ok || exit.ExitCode() != 77 {\n412|\t\tt.Fatalf(\"child did not crash at the replacement seam: %v %s\", err, output)\n413|\t}\n414|\t// Restart recovery must converge the pair: admitting the new Config4\n415|\t// with the old generation fails the test. Every read here must\n416|\t// succeed: a Load, Configuration, Open or ReadSnapshot error is a\n417|\t// failed convergence, not a pass, so each fails explicitly instead of\n418|\t// returning silently.\n419|\tloaded, err := Load(fixture.inputs, nil)\n420|\tif err != nil {\n421|\t\tt.Fatalf(\"Load after child exit 77 error = %v\", err)\n422|\t}\n423|\tconfiguration, ok := loaded.Configuration()\n424|\tif !ok {\n425|\t\tt.Fatal(\"Load after child exit 77 has no configuration\")\n426|\t}\n427|\treopened, err := hosttrust.Open(fixture.stateDir)\n428|\tif err != nil {\n429|\t\tt.Fatalf(\"hosttrust.Open after child exit 77 error = %v\", err)\n430|\t}\n431|\tsnapshot, err := reopened.ReadSnapshot()\n432|\tif err != nil {\n433|\t\tt.Fatalf(\"ReadSnapshot after child exit 77 error = %v\", err)\n434|\t}\n435|\tif configuration.SourceVersion == Version4 && snapshot.Generation == before {\n436|\t\tt.Fatalf(\"restart admits new Config4 with old generation %d after child exit 77\", before)\n437|\t}\n438|\tif configuration.SourceVersion != Version4 || snapshot.Generation != before+1 {\n439|\t\tt.Fatalf(\"restart converged to version %q generation %d, want 4.0.0/%d\", configuration.SourceVersion, snapshot.Generation, before+1)\n440|\t}\n441|\tif _, err := os.Lstat(reopened.PendingCommitPath()); !os.IsNotExist(err) {\n442|\t\tt.Fatalf(\"joint marker remains after restart convergence: %v\", err)\n443|\t}\n444|}\n445|\n446|func TestApplyV4MarkerStagingFailureAborts(t *testing.T) {\n447|\tif os.Geteuid() == 0 {\n448|\t\tt.Skip(\"permission-bit staging does not bind the superuser\")\n449|\t}\n450|\tfixture := setupV4Fixture(t, testPeerID)\n451|\tpreview, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now)\n452|\tif err != nil {\n453|\t\tt.Fatalf(\"PreviewV4 error = %v\", err)\n454|\t}\n455|\t// The joint marker cannot stage in an unwritable trust directory: the\n456|\t// commit aborts before the configuration is touched, with no marker\n457|\t// left behind. The store opens before the directory loses its write\n458|\t// bit, so the failure lands in the commit, not in the open.\n459|\tchannel := filepath.Join(fixture.stateDir, \"host-channel\")\n460|\tpreopened, err := hosttrust.Open(fixture.stateDir)\n461|\tif err != nil {\n462|\t\tt.Fatal(err)\n463|\t}\n464|\tif err := os.Chmod(channel, 0o500); err != nil {\n465|\t\tt.Fatal(err)\n466|\t}\n467|\tdefer func() { _ = os.Chmod(channel, 0o700) }()\n468|\topenHook := func(string) (*hosttrust.Store, error) { return preopened, nil }\n469|\tsource, err := os.ReadFile(fixture.filename)\n470|\tif err != nil {\n471|\t\tt.Fatal(err)\n472|\t}\n473|\tif _, err := applyV4(fixture.inputs, nil, preview, true, fixture.now, osMigrationFileSystem{}, openHook); err == nil {\n474|\t\tt.Fatal(\"ApplyV4(unwritable trust dir) succeeded, want failure\")\n475|\t} else if !errors.Is(err, hosttrust.ErrTrustDurability) {\n476|\t\tt.Fatalf(\"ApplyV4(staging) error = %v, want durability failure\", err)\n477|\t}\n478|\tafter, err := os.ReadFile(fixture.filename)\n479|\tif err != nil {\n480|\t\tt.Fatal(err)\n481|\t}\n482|\tif !bytes.Equal(after, source) {\n483|\t\tt.Fatal(\"aborted joint commit mutated the configuration\")\n484|\t}\n485|\tif _, err := os.Lstat(filepath.Join(channel, \"pending-commit.json\")); !os.IsNotExist(err) {\n486|\t\tt.Fatalf(\"joint marker remains after aborted commit: %v\", err)\n487|\t}\n488|}\n489|\n490|func TestApplyV4TrustCommitRecoveryFailure(t *testing.T) {\n491|\tfixture := setupV4Fixture(t, testPeerID)\n492|\tcrownTrustAtExhaustion(t, fixture)\n493|\tpreview, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now)\n494|\tif err != nil {\n495|\t\tt.Fatalf(\"PreviewV4 error = %v\", err)\n496|\t}\n497|\tif preview.SourceGeneration != hosttrust.MaxGeneration {\n498|\t\tt.Fatalf(\"preview generation = %d, want the exhausted ceiling\", preview.SourceGeneration)\n499|\t}\n500|\t// The config replacement succeeds but the generation bump is refused at\n(more lines below)","final_result":true}}}
