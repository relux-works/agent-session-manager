:= staged.Close(); err != nil {\n256|\t\treturn trustError(TrustError{Operation: \"sync trust\", Err: errors.Join(ErrTrustDurability, err)})\n257|\t}\n258|\tif err := filesystem.Chmod(name, 0o600); err != nil {\n259|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n260|\t}\n261|\t// On platforms where mode bits do not govern access, install the\n262|\t// owner-only ACL before the staging file becomes visible under load.\n263|\tif err := secureStaged(name, false); err != nil {\n264|\t\treturn err\n265|\t}\n266|\tif err := filesystem.Rename(name, path); err != nil {\n267|\t\treturn trustError(TrustError{Operation: \"replace trust\", Err: errors.Join(ErrTrustDurability, err)})\n268|\t}\n269|\tif err := syncDir(filesystem, root); err != nil {\n270|\t\treturn trustError(TrustError{Operation: \"sync trust directory\", Err: errors.Join(ErrTrustDurability, err)})\n271|\t}\n272|\tfailed = false\n273|\treturn nil\n274|}\n275|\n276|func writeAll(writer interface{ Write([]byte) (int, error) }, document []byte) error {\n277|\tfor len(document) > 0 {\n278|\t\twritten, err := writer.Write(document)\n279|\t\tif err != nil {\n280|\t\t\treturn err\n281|\t\t}\n282|\t\tif written == 0 {\n283|\t\t\treturn errors.New(\"short trust write\")\n284|\t\t}\n285|\t\tdocument = document[written:]\n286|\t}\n287|\treturn nil\n288|}\n289|\n290|func syncDir(filesystem FileSystem, root string) error {\n291|\thandle, err := filesystem.OpenDirectory(root)\n292|\tif err != nil {\n293|\t\treturn err\n294|\t}\n295|\tif err := handle.Sync(); err != nil {\n296|\t\t_ = handle.Close()\n297|\t\treturn err\n298|\t}\n299|\treturn handle.Close()\n300|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
