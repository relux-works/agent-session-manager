{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb81","stream":{"kind":"session","id":"01a0aa74-c329-7d72-8811-c1901bb53d47"},"sequence":1051,"recorded_at":1780531400002097,"record_type":"event","durability":"durable","causation_id":"e52fa573-a598-4d15-9493-65cb4f83069f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e52fa573-a598-4d15-9493-65cb4f83069f","run_stream":{"kind":"run","id":"e52fa573-a598-4d15-9493-65cb4f83069f"},"call_id":"call_01a0aa79085774a3a9be1b2b5330f21f","text":"internal/config/migration.go:256:type migrationFileSystem interface {\ninternal/config/migration.go-257-\tCreateTemp(string, string) (migrationFile, error)\ninternal/config/migration.go-258-\tLink(string, string) error\ninternal/config/migration.go-259-\tReadFile(string) ([]byte, error)\ninternal/config/migration.go-260-\tStat(string) (fs.FileInfo, error)\ninternal/config/migration.go-261-\tRemove(string) error\ninternal/config/migration.go-262-\tRename(string, string) error\ninternal/config/migration.go-263-\tOpenDirectory(string) (migrationDirectory, error)\ninternal/config/migration.go-264-}\ninternal/config/migration.go-265-\ninternal/config/migration.go-266-type osMigrationFileSystem struct{}\ninternal/config/migration.go-267-\ninternal/config/migration.go:268:func (osMigrationFileSystem) CreateTemp(dir, pattern string) (migrationFile, error) {\ninternal/config/migration.go-269-\treturn os.CreateTemp(dir, pattern)\ninternal/config/migration.go-270-}\ninternal/config/migration.go:271:func (osMigrationFileSystem) Link(oldname, newname string) error   { return os.Link(oldname, newname) }\ninternal/config/migration.go:272:func (osMigrationFileSystem) ReadFile(name string) ([]byte, error) { return os.ReadFile(name) }\ninternal/config/migration.go-273-\ninternal/config/migration.go-274-// Stat does not follow a symlink, unlike the symlink-following read-side seam\ninternal/config/migration.go-275-// in OSInputs. Durable migration replaces the selected file with an atomic\ninternal/config/migration.go-276-// rename, which replaces a symlink itself rather than its target: migrating a\ninternal/config/migration.go-277-// symlinked configuration would silently detach the operator's link and leave\ninternal/config/migration.go-278-// the real document holding stale bytes next to a backup of the resolved\ninternal/config/migration.go-279-// target. The specification is silent here, so the mutating path fails closed\ninternal/config/migration.go-280-// with ErrConfigNotRegular instead of guessing which file the operator meant.\ninternal/config/migration.go:281:func (osMigrationFileSystem) Stat(name string) (fs.FileInfo, error) { return os.Lstat(name) }\ninternal/config/migration.go:282:func (osMigrationFileSystem) Remove(name string) error              { return os.Remove(name) }\ninternal/config/migration.go:283:func (osMigrationFileSystem) Rename(oldname, newname string) error {\ninternal/config/migration.go-284-\treturn os.Rename(oldname, newname)\ninternal/config/migration.go-285-}\ninternal/config/migration.go:286:func (osMigrationFileSystem) OpenDirectory(name string) (migrationDirectory, error) {\ninternal/config/migration.go-287-\treturn os.Open(name)\ninternal/config/migration.go-288-}\ninternal/config/migration.go-289-\ninternal/config/migration.go-290-// replaceDurably publishes a byte-exact backup of the pre-migration\ninternal/config/migration.go-291-// configuration document, then installs the replacement. Backup contents\ninternal/config/migration.go-292-// classification: the backup is a copy of configuration bytes only (host\ninternal/config/migration.go-293-// and peer UUIDs, names, endpoints, SSH arguments) and never carries\ninternal/config/migration.go-294-// private key material, which lives exclusively under\ninternal/config/migration.go-295-// STATE_DIR/host-channel/credentials/. The custody contract for backups is:\ninternal/config/migration.go-296-// staged 0600 with group/world-clean verification (Unix owner-only), and\ninternal/config/migration.go-297-// published names matched by hosttrust.ExcludedConfigDirName so every\ninternal/config/migration.go-298-// replication, snapshot, clone or diagnostic surface must drop them. On\ninternal/config/migration.go-299-// Windows the backup DACL inherits the user-profile ACL; that inheritance\ninternal/config/migration.go-300-// is a stated bound, not owner-only evidence.\ninternal/config/migration.go:301:func replaceDurably(filesystem migrationFileSystem, filename, backup string, original, replacement []byte) error {\ninternal/config/migration.go-302-\tdirectory := filepath.Dir(filename)\ninternal/config/migration.go-303-\t// Re-inspect the selected file before anything durable is written. Load\ninternal/config/migration.go-304-\t// resolved and validated it through the symlink-following read seam; this\ninternal/config/migration.go-305-\t// mutating seam does not follow symlinks, so a selected file that is not\ninternal/config/migration.go-306-\t// itself a regular file is refused here rather than after a backup has\ninternal/config/migration.go-307-\t// already been published. A refused migration therefore leaves the\ninternal/config/migration.go-308-\t// directory exactly as it found it, and the captured permission bits are\ninternal/config/migration.go-309-\t// the ones the replacement inherits.\ninternal/config/migration.go-310-\tinfo, err := filesystem.Stat(filename)\ninternal/config/migration.go-311-\tif err != nil {\ninternal/config/migration.go-312-\t\treturn migrationError(MigrationError{Operation: \"inspect source mode\", Err: errors.Join(ErrMigrationWrite, err)})\ninternal/config/migration.go-313-\t}\ninternal/config/migration.go-314-\tif !info.Mode().IsRegular() {\ninternal/config/migration.go-315-\t\treturn migrationError(MigrationError{Operation: \"inspect source mode\", Err: errors.Join(ErrMigrationWrite, ErrConfigNotRegular)})\ninternal/config/migration.go-316-\t}\ninternal/config/migration.go-317-\tbackupTemp, err := writeTempFile(filesystem, directory, \".ax-config-backup-*\", original, 0o600)\ninternal/config/migration.go-318-\tif err != nil {\ninternal/config/migration.go-319-\t\treturn migrationError(MigrationError{Operation: \"write backup\", Err: errors.Join(ErrMigrationBackup, err)})\ninternal/config/migration.go-320-\t}\ninternal/config/migration.go-321-\tif err := filesystem.Link(backupTemp, backup); err != nil {\ninternal/config/migration.go-322-\t\tif !errors.Is(err, fs.ErrExist) {\ninternal/config/migration.go-323-\t\t\t_ = filesystem.Remove(backupTemp)\ninternal/config/migration.go-324-\t\t\treturn migrationError(MigrationError{Operation: \"publish backup\", Err: errors.Join(ErrMigrationBackup, err)})\ninternal/config/migration.go-325-\t\t}\ninternal/config/migration.go-326-\t\texisting, readErr := filesystem.ReadFile(backup)\ninternal/config/migration.go:371:func writeTempFile(filesystem migrationFileSystem, directory, pattern string, document []byte, mode fs.FileMode) (name string, err error) {\ninternal/config/migration.go-372-\tfile, err := filesystem.CreateTemp(directory, pattern)\ninternal/config/migration.go-373-\tif err != nil {\ninternal/config/migration.go-374-\t\treturn \"\", err\ninternal/config/migration.go-375-\t}\ninternal/config/migration.go-376-\tname = file.Name()\ninternal/config/migration.go-377-\tclean := func(cause error) (string, error) {\ninternal/config/migration.go-378-\t\t_ = file.Close()\ninternal/config/migration.go-379-\t\t_ = filesystem.Remove(name)\ninternal/config/migration.go-380-\t\treturn \"\", cause\ninternal/config/migration.go-381-\t}\ninternal/config/migration.go-382-\tif err := file.Chmod(mode); err != nil {\ninternal/config/migration.go-383-\t\treturn clean(err)\ninternal/config/migration.go-384-\t}\ninternal/config/migration.go-385-\tif err := writeAll(file, document); err != nil {\ninternal/config/migration.go-386-\t\treturn clean(err)\ninternal/config/migration.go-387-\t}\ninternal/config/migration.go-388-\tif err := file.Sync(); err != nil {\ninternal/config/migration.go-389-\t\treturn clean(err)\ninternal/config/migration.go-390-\t}\ninternal/config/migration.go-391-\tif err := file.Close(); err != nil {\ninternal/config/migration.go-392-\t\t_ = filesystem.Remove(name)\ninternal/config/migration.go-393-\t\treturn \"\", err\ninternal/config/migration.go-394-\t}\ninternal/config/migration.go-395-\treturn name, nil\ninternal/config/migration.go-396-}\ninternal/config/migration.go:412:func syncDirectory(filesystem migrationFileSystem, directory string) error {\ninternal/config/migration.go-413-\thandle, err := filesystem.OpenDirectory(directory)\ninternal/config/migration.go-414-\tif err != nil {\ninternal/config/migration.go-415-\t\treturn err\ninternal/config/migration.go-416-\t}\ninternal/config/migration.go-417-\tif err := handle.Sync(); err != nil {\ninternal/config/migration.go-418-\t\t_ = handle.Close()\ninternal/config/migration.go-419-\t\treturn err\ninternal/config/migration.go-420-\t}\ninternal/config/migration.go-421-\treturn handle.Close()\ninternal/config/migration.go-422-}\ninternal/config/migration.go-423-\ninternal/config/migration.go-424-// Indirections keep compatibility-envelope parsing in this file while using\ninternal/config/migration.go-425-// the same TOML implementation as Decode.\ninternal/config/migration.go-426-var tomlDecode = func(document []byte, destination any) error {\ninternal/config/migration.go-427-\treturn toml.Unmarshal(document, destination)\ninternal/config/migration.go-428-}\ninternal/config/migration.go-429-\ninternal/config/migration.go-430-// migrationError is the only construction site for *MigrationError, for the\ninternal/config/migration.go-431-// same reason loaderError is the only construction site for *Error.\ninternal/config/migration.go-432-var migrationError = func(value MigrationError) error {\ninternal/config/migration.go-433-\treturn &value\ninternal/config/migration.go-434-}\n