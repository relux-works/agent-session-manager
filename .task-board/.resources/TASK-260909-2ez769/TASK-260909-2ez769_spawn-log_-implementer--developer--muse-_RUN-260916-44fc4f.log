{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cecf","stream":{"kind":"session","id":"01a0aa74-c329-7d72-8811-c1901bb53d47"},"sequence":1474,"recorded_at":1780531400002943,"record_type":"event","durability":"durable","causation_id":"e52fa573-a598-4d15-9493-65cb4f83069f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e52fa573-a598-4d15-9493-65cb4f83069f","run_stream":{"kind":"run","id":"e52fa573-a598-4d15-9493-65cb4f83069f"},"task_stream":{"kind":"task","id":"01a0aa85-b085-7da2-ac03-f0a6881496ef"},"task_id":"01a0aa85-b085-7da2-ac03-f0a6881496ef","event":{"kind":"output","task_id":"01a0aa85-b085-7da2-ac03-f0a6881496ef","chunk":"{\n  \"chunk_id\": \"exec-30-1\",\n  \"command\": \"sed -n '1,60p' internal/hosttrust/lifecycle_test.go\\nsed -n '1,35p' internal/hosttrust/custody_test.go\\necho \\\"=== faultMigrationFileSystem def ===\\\"\\ngrep -rn \\\"type faultMigrationFileSystem\\\" internal/config/\\ngrep -rn \\\"func (filesystem \\\\*faultMigrationFileSystem)\\\" internal/config/ | head\",\n  \"description\": \"Read fixture helpers and fault filesystem\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"package hosttrust\\n\\nimport (\\n\\t\\\"crypto/x509\\\"\\n\\t\\\"errors\\\"\\n\\t\\\"os\\\"\\n\\t\\\"path/filepath\\\"\\n\\t\\\"testing\\\"\\n\\t\\\"time\\\"\\n)\\n\\nfunc setupStoreForTest(t *testing.T) *Store {\\n\\tt.Helper()\\n\\tstore := openForTest(t, t.TempDir())\\n\\tif _, err := store.Initialize(); err != nil {\\n\\t\\tt.Fatalf(\\\"Initialize error = %v\\\", err)\\n\\t}\\n\\treturn store\\n}\\n\\n// enrollPeerForTest runs the explicit out-of-band flow: the issuer issues\\n// locally, exports selected public material, and the operator authorizes the\\n// observed tuple in the enrolling store after independent verification.\\nfunc enrollPeerForTest(t *testing.T, store *Store, issuer *Store, hostID string, at time.Time) string {\\n\\tt.Helper()\\n\\tpeerCredential, err := issuer.Issue(hostID, at)\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"peer Issue error = %v\\\", err)\\n\\t}\\n\\tpeerSnapshot, err := issuer.ReadSnapshot()\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"peer ReadSnapshot error = %v\\\", err)\\n\\t}\\n\\tmaterial, err := ExportEnrollment(peerSnapshot, peerCredential)\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"ExportEnrollment error = %v\\\", err)\\n\\t}\\n\\tif len(material.LeafDER) == 0 || len(material.RootDER) == 0 {\\n\\t\\tt.Fatal(\\\"ExportEnrollment returned empty public bytes\\\")\\n\\t}\\n\\t// The operator verifies the tuple over the independent channel; the test\\n\\t// models a correct verification by authorizing the observed fingerprints.\\n\\tenrolled, err := store.Enroll(EnrollInput{\\n\\t\\tHostID:     material.HostID,\\n\\t\\tLeafDER:    material.LeafDER,\\n\\t\\tRootDER:    material.RootDER,\\n\\t\\tAuthorized: material.Fingerprints,\\n\\t\\tEnrolledAt: at,\\n\\t})\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"Enroll error = %v\\\", err)\\n\\t}\\n\\tif enrolled != peerCredential {\\n\\t\\tt.Fatalf(\\\"Enroll = %s, want %s\\\", enrolled, peerCredential)\\n\\t}\\n\\treturn enrolled\\n}\\n\\nfunc TestIssueSelfEnrollsActive(t *testing.T) {\\n\\tstore := setupStoreForTest(t)\\npackage hosttrust\\n\\nimport (\\n\\t\\\"errors\\\"\\n\\t\\\"io/fs\\\"\\n\\t\\\"os\\\"\\n\\t\\\"path/filepath\\\"\\n\\t\\\"strings\\\"\\n\\t\\\"testing\\\"\\n)\\n\\nfunc openForTest(t *testing.T, stateDir string) *Store {\\n\\tt.Helper()\\n\\tstore, err := Open(stateDir)\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"Open(%s) error = %v\\\", stateDir, err)\\n\\t}\\n\\treturn store\\n}\\n\\nfunc TestOpenCreatesOwnerOnlyLayout(t *testing.T) {\\n\\tstate := t.TempDir()\\n\\tstore := openForTest(t, state)\\n\\troot := filepath.Join(state, hostChannelDir)\\n\\tfor _, dir := range []string{root, filepath.Join(root, credentialsDir)} {\\n\\t\\tinfo, err := os.Lstat(dir)\\n\\t\\tif err != nil {\\n\\t\\t\\tt.Fatalf(\\\"Lstat(%s) error = %v\\\", dir, err)\\n\\t\\t}\\n\\t\\tif !info.IsDir() || info.Mode().Perm() != 0o700 {\\n\\t\\t\\tt.Fatalf(\\\"directory %s mode = %04o, want 0700\\\", dir, info.Mode().Perm())\\n\\t\\t}\\n\\t}\\n\\tsnapshot, err := store.Initialize()\\n\\tif err != nil {\\n=== faultMigrationFileSystem def ===\\ninternal/config/migration_test.go:380:type faultMigrationFileSystem struct {\\ninternal/config/migration_test.go:398:func (filesystem *faultMigrationFileSystem) ReadFile(name string) ([]byte, error) {\\ninternal/config/migration_test.go:405:func (filesystem *faultMigrationFileSystem) CreateTemp(dir, pattern string) (migrationFile, error) {\\ninternal/config/migration_test.go:439:func (filesystem *faultMigrationFileSystem) Link(oldname, newname string) error {\\ninternal/config/migration_test.go:446:func (filesystem *faultMigrationFileSystem) Remove(name string) error {\\ninternal/config/migration_test.go:454:func (filesystem *faultMigrationFileSystem) Rename(oldname, newname string) error {\\ninternal/config/migration_test.go:462:func (filesystem *faultMigrationFileSystem) Stat(name string) (fs.FileInfo, error) {\\ninternal/config/migration_test.go:469:func (filesystem *faultMigrationFileSystem) OpenDirectory(name string) (migrationDirectory, error) {\\n\",\n  \"original_output_bytes\": 3506,\n  \"original_output_tokens\": 877,\n  \"truncated\": false\n}","final_result":true}}}
