{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc95","stream":{"kind":"session","id":"01a0aa74-c329-7d72-8811-c1901bb53d47"},"sequence":1189,"recorded_at":1780531400002373,"record_type":"event","durability":"durable","causation_id":"e52fa573-a598-4d15-9493-65cb4f83069f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e52fa573-a598-4d15-9493-65cb4f83069f","run_stream":{"kind":"run","id":"e52fa573-a598-4d15-9493-65cb4f83069f"},"call_id":"call_01a0aa7f1755731fa7f27e87b1d1ae59","text":"Read text file `internal/config/migration_v4_revalidate_test.go`.\n(214 line(s) above)\n215|\t}\n216|\tif !bytes.Equal(coherent.Config.Document(), source) {\n217|\t\tt.Fatal(\"coherent configuration does not match the selected file\")\n218|\t}\n219|\tif _, err := LoadCoherent(fixture.inputs, nil, nil); err == nil {\n220|\t\tt.Fatal(\"LoadCoherent(nil store) succeeded, want refusal\")\n221|\t}\n222|}\n223|\n224|func TestLoadCoherentSerializesWithJointCommit(t *testing.T) {\n225|\tfixture := setupV4Fixture(t, testPeerID)\n226|\tstore, err := hosttrust.Open(fixture.stateDir)\n227|\tif err != nil {\n228|\t\tt.Fatal(err)\n229|\t}\n230|\tbefore, err := store.ReadSnapshot()\n231|\tif err != nil {\n232|\t\tt.Fatal(err)\n233|\t}\n234|\tsource, err := os.ReadFile(fixture.filename)\n235|\tif err != nil {\n236|\t\tt.Fatal(err)\n237|\t}\n238|\tmarker := hosttrust.PendingCommit{\n239|\t\tSchema:            \"urn:ax:schema:host-pending-commit\",\n240|\t\tSchemaVersion:     \"1.0.0\",\n241|\t\tOperation:         hosttrust.JointApplyV4,\n242|\t\tConfigPath:        fixture.filename,\n243|\t\tSourceSHA256:      hosttrust.SHA256HexOf(source),\n244|\t\tReplacementSHA256: hosttrust.SHA256HexOf(append(append([]byte(nil), source...), 0x20)),\n245|\t\tSourceGeneration:  before.Generation,\n246|\t\tBackupPath:        fixture.filename + \".bak.3.0.0\",\n247|\t}\n248|\trelease := make(chan struct{})\n249|\tentered := make(chan struct{})\n250|\tholderDone := make(chan error, 1)\n251|\tgo func() {\n252|\t\t_, err := store.JointCommit(marker,\n253|\t\t\tfunc(hosttrust.TrustStore) error { return nil },\n254|\t\t\tfunc() error {\n255|\t\t\t\tclose(entered)\n256|\t\t\t\t<-release\n257|\t\t\t\treturn nil\n258|\t\t\t})\n259|\t\tholderDone <- err\n260|\t}()\n261|\t<-entered\n262|\treaderDone := make(chan error, 1)\n263|\tvar observed CoherentSnapshot\n264|\tgo func() {\n265|\t\tvar err error\n266|\t\tobserved, err = LoadCoherent(fixture.inputs, nil, store)\n267|\t\treaderDone <- err\n268|\t}()\n269|\t// The coherent reader must wait for the joint commit holding the\n270|\t// exclusive lock: it must not pair pre-commit trust with post-commit\n271|\t// configuration or vice versa.\n272|\tselect {\n273|\tcase <-readerDone:\n274|\t\tt.Fatal(\"LoadCoherent completed while a joint commit was held\")\n275|\tcase <-time.After(250 * time.Millisecond):\n276|\t}\n277|\tclose(release)\n278|\tif err := <-holderDone; err != nil {\n279|\t\tt.Fatalf(\"JointCommit error = %v\", err)\n280|\t}\n281|\tif err := <-readerDone; err != nil {\n282|\t\tt.Fatalf(\"LoadCoherent error = %v\", err)\n283|\t}\n284|\tif observed.Generation != before.Generation+1 {\n285|\t\tt.Fatalf(\"coherent generation = %d, want %d\", observed.Generation, before.Generation+1)\n286|\t}\n287|}\n288|\n289|func TestPublishedBackupNamesStayExcluded(t *testing.T) {\n290|\tfixture := setupV4Fixture(t, testPeerID)\n291|\tpreview, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now)\n292|\tif err != nil {\n293|\t\tt.Fatalf(\"PreviewV4 error = %v\", err)\n294|\t}\n295|\tapplied, err := ApplyV4(fixture.inputs, nil, preview, true, fixture.now)\n296|\tif err != nil {\n297|\t\tt.Fatalf(\"ApplyV4 error = %v\", err)\n298|\t}\n299|\tif !hosttrust.ExcludedConfigDirName(filepath.Base(applied.Migration.BackupPath)) {\n300|\t\tt.Fatalf(\"apply backup %q escapes replication exclusion\", applied.Migration.BackupPath)\n301|\t}\n302|\trolled, err := RollbackV4(fixture.inputs, nil, RollbackV4Options{AcknowledgeNoHostChannelAssurance: true})\n303|\tif err != nil {\n304|\t\tt.Fatalf(\"RollbackV4 error = %v\", err)\n305|\t}\n306|\tif !hosttrust.ExcludedConfigDirName(filepath.Base(rolled.Migration.BackupPath)) {\n307|\t\tt.Fatalf(\"pre-rollback copy %q escapes replication exclusion\", rolled.Migration.BackupPath)\n308|\t}\n309|\tif hosttrust.ExcludedConfigDirName(filepath.Base(fixture.filename)) {\n310|\t\tt.Fatalf(\"live configuration %q is excluded from replication\", fixture.filename)\n311|\t}\n312|}\n313|\n314|// Configuration backups are classified copies of configuration bytes: the\n315|// published backup equals the pre-apply source document exactly, carries\n316|// no private-key material, stages owner-only, and matches the replication\n317|// exclusion. No credential file may exist under the configuration\n318|// directory.\n319|func TestApplyV4BackupIsClassifiedConfigCopy(t *testing.T) {\n320|\tfixture := setupV4Fixture(t, testPeerID)\n321|\tpreloaded, err := Load(fixture.inputs, nil)\n322|\tif err != nil {\n323|\t\tt.Fatal(err)\n324|\t}\n325|\tsource := append([]byte(nil), preloaded.Document()...)\n326|\tpreview, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now)\n327|\tif err != nil {\n328|\t\tt.Fatalf(\"PreviewV4 error = %v\", err)\n329|\t}\n330|\tapplied, err := ApplyV4(fixture.inputs, nil, preview, true, fixture.now)\n331|\tif err != nil {\n332|\t\tt.Fatalf(\"ApplyV4 error = %v\", err)\n333|\t}\n334|\tbackup, err := os.ReadFile(applied.Migration.BackupPath)\n335|\tif err != nil {\n336|\t\tt.Fatal(err)\n337|\t}\n338|\tif !bytes.Equal(backup, source) {\n339|\t\tt.Fatal(\"apply backup differs from the pre-apply source document\")\n340|\t}\n341|\tif bytes.Contains(backup, []byte(\"PRIVATE KEY\")) {\n342|\t\tt.Fatal(\"apply backup contains private-key material\")\n343|\t}\n344|\tif runtime.GOOS != \"windows\" {\n345|\t\tinfo, err := os.Stat(applied.Migration.BackupPath)\n346|\t\tif err != nil {\n347|\t\t\tt.Fatal(err)\n348|\t\t}\n349|\t\tif info.Mode().Perm() != 0o600 {\n350|\t\t\tt.Fatalf(\"apply backup mode = %04o, want 0600\", info.Mode().Perm())\n351|\t\t}\n352|\t} else {\n353|\t\tt.Log(\"backup mode bits are not asserted on Windows: profile ACLs govern\")\n354|\t}\n355|\tif !hosttrust.ExcludedConfigDirName(filepath.Base(applied.Migration.BackupPath)) {\n356|\t\tt.Fatalf(\"apply backup %q escapes replication exclusion\", applied.Migration.BackupPath)\n357|\t}\n358|\tentries, err := os.ReadDir(filepath.Dir(fixture.filename))\n359|\tif err != nil {\n360|\t\tt.Fatal(err)\n361|\t}\n362|\tfor _, entry := range entries {\n363|\t\tswitch entry.Name() {\n364|\t\tcase \"private-key.pem\", \"certificate.pem\", \"root.pem\", \"trust.json\", \"pending-commit.json\":\n365|\t\t\tt.Fatalf(\"credential file %q published under the configuration directory\", entry.Name())\n366|\t\t}\n367|\t}\n368|}\n369|\n370|func TestRestoreSourceReportsFailedRecovery(t *testing.T) {\n371|\tstateDir := t.TempDir()\n372|\tstore, err := hosttrust.Open(stateDir)\n373|\tif err != nil {\n374|\t\tt.Fatal(err)\n375|\t}\n376|\tif _, err := store.Initialize(); err != nil {\n377|\t\tt.Fatal(err)\n378|\t}\n379|\t// A corrupt intent marker makes recovery fail deterministically: the\n380|\t// helper restores the source bytes, then reports the compound failure\n381|\t// with the marker kept and the original commit error preserved.\n382|\tchannel := filepath.Join(stateDir, \"host-channel\")\n383|\tif err := os.WriteFile(filepath.Join(channel, \"pending-commit.json\"), []byte(\"{corrupt\"), 0o600); err != nil {\n384|\t\tt.Fatal(err)\n385|\t}\n386|\tfilename := filepath.Join(t.TempDir(), \"config.toml\")\n387|\tsource := []byte(\"source configuration\\n\")\n388|\tif err := os.WriteFile(filename, []byte(\"intervened configuration\\n\"), 0o600); err != nil {\n389|\t\tt.Fatal(err)\n390|\t}\n391|\tcommitErr := errors.New(\"generation bump failed\")\n392|\terr = restoreSourceAfterJointFailure(osMigrationFileSystem{}, filename, source, store, commitErr)\n393|\tif err == nil {\n394|\t\tt.Fatal(\"restoreSourceAfterJointFailure(failed recovery) succeeded, want failure\")\n395|\t} else if !errors.Is(err, ErrMigrationRecovery) {\n396|\t\tt.Fatalf(\"restore error = %v, want recovery failure\", err)\n397|\t} else if !errors.Is(err, commitErr) {\n398|\t\tt.Fatalf(\"restore error = %v, want the original commit error preserved\", err)\n399|\t}\n400|\trestored, err := os.ReadFile(filename)\n401|\tif err != nil {\n402|\t\tt.Fatal(err)\n403|\t}\n404|\tif !bytes.Equal(restored, source) {\n405|\t\tt.Fatal(\"failed recovery did not leave the restored source bytes\")\n406|\t}\n407|\tif _, err := os.Lstat(filepath.Join(channel, \"pending-commit.json\")); err != nil {\n408|\t\tt.Fatalf(\"joint marker was removed after failed recovery: %v\", err)\n409|\t}\n410|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc97","stream":{"kind":"session","id":"01a0aa74-c329-7d72-8811-c1901bb53d47"},"sequence":1190,"recorded_at":1780531400002375,"record_type":"event","durability":"durable","causation_id":"e52fa573-a598-4d15-9493-65cb4f83069f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e52fa573-a598-4d15-9493-65cb4f83069f","run_stream":{"kind":"run","id":"e52fa573-a598-4d15-9493-65cb4f83069f"},"call_id":"call_01a0aa7f1a1f75bfac7c5e990579bc54","text":"Read text file `internal/hosttrust/export.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"path\"\n6|\t\"path/filepath\"\n7|\t\"strings\"\n8|)\n9|\n10|// EnrollmentMaterial is the explicitly selected public enrollment material an\n11|// operator exchanges out of band. It carries no private key: only\n12|// certificate.pem and root.pem bytes leave the store, never private-key.pem,\n13|// trust internals, backups or authorization caches.\n14|type EnrollmentMaterial struct {\n15|\tHostID       string\n16|\tCredentialID string\n17|\tLeafDER      []byte\n18|\tRootDER      []byte\n19|\tFingerprints Fingerprints\n20|}\n21|\n22|// Formatting enrollment material redacts DER bytes by default; the operator\n23|// exports explicit fields, never a log line.\n24|func (EnrollmentMaterial) String() string   { return \"host enrollment material\" }\n25|func (EnrollmentMaterial) GoString() string { return \"host enrollment material\" }\n26|func (EnrollmentMaterial) Format(state fmt.State, verb rune) {\n27|\t_, _ = state.Write([]byte(\"host enrollment material\"))\n28|}\n29|\n30|// ExportEnrollment selects the public bytes of one non-revoked entry for\n31|// out-of-band exchange. Revoked tombstones never redistribute: exporting one\n32|// refuses.\n33|func ExportEnrollment(snapshot Snapshot, credentialID string) (EnrollmentMaterial, error) {\n34|\tentry, found := findEntry(snapshot.Trust, credentialID)\n35|\tif !found {\n36|\t\treturn EnrollmentMaterial{}, trustError(TrustError{Operation: \"export enrollment\", Err: ErrEnrollmentRefused})\n37|\t}\n38|\tif entry.State == EntryRevoked {\n39|\t\treturn EnrollmentMaterial{}, trustError(TrustError{Operation: \"export enrollment\", Err: ErrEnrollmentRefused})\n40|\t}\n41|\tfingerprints, err := FingerprintsOf(entry.LeafDER, entry.RootDER)\n42|\tif err != nil {\n43|\t\treturn EnrollmentMaterial{}, err\n44|\t}\n45|\treturn EnrollmentMaterial{\n46|\t\tHostID:       entry.HostID.String(),\n47|\t\tCredentialID: entry.CredentialID.String(),\n48|\t\tLeafDER:      append([]byte(nil), entry.LeafDER...),\n49|\t\tRootDER:      append([]byte(nil), entry.RootDER...),\n50|\t\tFingerprints: fingerprints,\n51|\t}, nil\n52|}\n53|\n54|// ExcludedFromReplication lists the STATE_DIR-relative paths that must never\n55|// enter replication, snapshots, cloning, Session Directory, logs or exported\n56|// diagnostic bundles. Credential, trust, backup, private-key and\n57|// authorization-cache material stays machine-local; operators exchange only\n58|// explicitly selected public enrollment material outside replication.\n59|func ExcludedFromReplication() []string {\n60|\treturn []string{\n61|\t\thostChannelDir + \"/trust.json\",\n62|\t\thostChannelDir + \"/pending-commit.json\",\n63|\t\thostChannelDir + \"/credentials/\",\n64|\t\thostChannelDir + \"/lock\",\n65|\t}\n66|}\n67|\n68|// MatchExcludedFromReplication reports whether a STATE_DIR-relative path\n69|// must stay out of replication, snapshots, cloning, Session Directory, logs\n70|// and exported diagnostic bundles. It covers the listed control paths plus\n71|// transient staging files, which carry the same material under rotating\n72|// names. Any path that escapes the state directory fails closed as\n73|// excluded. Every replication, snapshot, clone or diagnostic export surface\n74|// must consult this matcher (and ExcludedConfigDirName for configuration\n75|// directory files) and drop matches; ExportEnrollment material is\n76|// deliberately NOT excluded, since explicitly selected public bytes are the\n77|// only operator exchange outside replication.\n78|func MatchExcludedFromReplication(relative string) bool {\n79|\tif relative == \"\" || relative == \".\" {\n80|\t\treturn false\n81|\t}\n82|\tslash := filepath.ToSlash(relative)\n83|\tif path.IsAbs(slash) {\n84|\t\treturn true\n85|\t}\n86|\tfor _, segment := range strings.Split(slash, \"/\") {\n87|\t\tif segment == \"..\" {\n88|\t\t\treturn true\n89|\t\t}\n90|\t}\n91|\ttrimmed := path.Clean(slash)\n92|\tfor _, listed := range ExcludedFromReplication() {\n93|\t\tclean := path.Clean(listed)\n94|\t\tif trimmed == clean || strings.HasPrefix(trimmed, clean+\"/\") {\n95|\t\t\treturn true\n96|\t\t}\n97|\t}\n98|\tbase := path.Base(trimmed)\n99|\tfor _, prefix := range []string{stagePrefix, \".custody-stage-\", \"lock-stage-\"} {\n100|\t\tif strings.HasPrefix(base, prefix) {\n101|\t\t\treturn true\n102|\t\t}\n103|\t}\n104|\treturn false\n105|}\n106|\n107|// ExcludedConfigDirName reports whether a configuration-directory file name\n108|// carries trust-adjacent material that must stay out of replication: owner-only\n109|// backups, pre-rollback copies and transient migration staging files. Backup\n110|// names embed the source version (\".bak.<version>\"), so the match is by\n111|// infix, pinned against the names replaceDurably actually publishes.\n112|func ExcludedConfigDirName(base string) bool {\n113|\tname := path.Base(filepath.ToSlash(base))\n114|\tif strings.Contains(name, \".pre-rollback.\") {\n115|\t\treturn true\n116|\t}\n117|\tif strings.HasPrefix(name, \".ax-config-\") {\n118|\t\treturn true\n119|\t}\n120|\tif strings.Contains(name, \".bak.\") {\n121|\t\treturn true\n122|\t}\n123|\treturn false\n124|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
