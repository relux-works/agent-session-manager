{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca5b","stream":{"kind":"session","id":"01a0aa74-c329-7d72-8811-c1901bb53d47"},"sequence":904,"recorded_at":1780531400001803,"record_type":"event","durability":"durable","causation_id":"e52fa573-a598-4d15-9493-65cb4f83069f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e52fa573-a598-4d15-9493-65cb4f83069f","run_stream":{"kind":"run","id":"e52fa573-a598-4d15-9493-65cb4f83069f"},"task_stream":{"kind":"task","id":"01a0aa78-9cdf-7fb3-9488-aad60c544562"},"task_id":"01a0aa78-9cdf-7fb3-9488-aad60c544562","event":{"kind":"output","task_id":"01a0aa78-9cdf-7fb3-9488-aad60c544562","chunk":"Read text file `internal/hosttrust/lock_windows.go`.\n1|//go:build windows\n2|\n3|package hosttrust\n4|\n5|import (\n6|\t\"errors\"\n7|\t\"os\"\n8|\t\"sync\"\n9|\n10|\t\"golang.org/x/sys/windows\"\n11|)\n12|\n13|// fileLock is the machine-local cross-process authorization lock shared by\n14|// trust changes and Configuration 4.0.0 peer/credential changes. Readers hold\n15|// it shared; transactions hold it exclusive.\n16|//\n17|// Every acquisition opens its own handle: Windows byte-range locks attach to\n18|// the file object, so goroutines sharing one retained handle would not\n19|// serialize. Per-acquisition handles make both same-process goroutines and\n20|// separate processes block on a held exclusive lock. A caller must never\n21|// request a second acquisition while holding one in the same goroutine;\n22|// internal reads nested inside a holder use handle-direct unlocked reads\n23|// instead of re-acquiring.\n24|type fileLock struct {\n25|\tpath string\n26|}\n27|\n28|// lockInitMu serializes concurrent creation of the lock file itself.\n29|var lockInitMu sync.Mutex\n30|\n31|// openLock attaches to the shared lock file, creating it exactly once\n32|// across all processes. Creation is atomic and non-replacing (CREATE_NEW):\n33|// a process that observes absence while another process creates the lock\n34|// loses the race and opens the existing file instead of replacing a live\n35|// lock, so concurrent first-open can never split the authorization lock\n36|// across two files.\n37|func openLock(filesystem FileSystem, path string) (*fileLock, error) {\n38|\tlockInitMu.Lock()\n39|\tdefer lockInitMu.Unlock()\n40|\t_, err := filesystem.Lstat(path)\n41|\tif err == nil {\n42|\t\tif err := verifyLockFile(filesystem, path); err != nil {\n43|\t\t\treturn nil, err\n44|\t\t}\n45|\t\treturn &fileLock{path: path}, nil\n46|\t}\n47|\tif !os.IsNotExist(err) {\n48|\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n49|\t}\n50|\tif err := filesystem.CreateExclusive(path, 0o600); err != nil {\n51|\t\t// Lost the creation race: another process published the lock\n52|\t\t// first. Open the existing file; never replace it.\n53|\t\tif !isLockExistsError(err) {\n54|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n55|\t\t}\n56|\t\tif err := verifyLockFile(filesystem, path); err != nil {\n57|\t\t\treturn nil, err\n58|\t\t}\n59|\t\treturn &fileLock{path: path}, nil\n60|\t}\n61|\tif err := filesystem.Chmod(path, 0o600); err != nil {\n62|\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n63|\t}\n64|\tif err := secureStaged(path, false); err != nil {\n65|\t\treturn nil, err\n66|\t}\n67|\tinfo, err := filesystem.Lstat(path)\n68|\tif err != nil {\n69|\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n70|\t}\n71|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n72|\t\treturn nil, err\n73|\t}\n74|\treturn &fileLock{path: path}, nil\n75|}\n76|\n77|// isLockExistsError reports a lost creation race: the lock file already\n78|// exists, so the caller must open it rather than publish over it.\n79|func isLockExistsError(err error) bool {\n80|\treturn os.IsExist(err) || errors.Is(err, windows.ERROR_FILE_EXISTS) || errors.Is(err, windows.ERROR_ALREADY_EXISTS)\n81|}\n82|\n83|func openLockHandle(path string) (windows.Handle, error) {\n84|\tname, err := windows.UTF16PtrFromString(path)\n85|\tif err != nil {\n86|\t\treturn 0, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n87|\t}\n88|\thandle, err := windows.CreateFile(name, windows.GENERIC_READ|windows.GENERIC_WRITE,\n89|\t\twindows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE, nil, windows.OPEN_EXISTING,\n90|\t\twindows.FILE_ATTRIBUTE_NORMAL, 0)\n91|\tif err != nil {\n92|\t\treturn 0, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n93|\t}\n94|\treturn handle, nil\n95|}\n96|\n97|func (lock *fileLock) shared() (func(), error) {\n98|\thandle, err := openLockHandle(lock.path)\n99|\tif err != nil {\n100|\t\treturn nil, err\n101|\t}\n102|\toverlapped := new(windows.Overlapped)\n103|\tif err := windows.LockFileEx(handle, 0, 0, 1, 0, overlapped); err != nil {\n104|\t\t_ = windows.CloseHandle(handle)\n105|\t\treturn nil, err\n106|\t}\n107|\treturn func() {\n108|\t\t_ = windows.UnlockFileEx(handle, 0, 1, 0, overlapped)\n109|\t\t_ = windows.CloseHandle(handle)\n110|\t}, nil\n111|}\n112|\n113|func (lock *fileLock) exclusive() (func(), error) {\n114|\thandle, err := openLockHandle(lock.path)\n115|\tif err != nil {\n116|\t\treturn nil, err\n117|\t}\n118|\toverlapped := new(windows.Overlapped)\n119|\tif err := windows.LockFileEx(handle, windows.LOCKFILE_EXCLUSIVE_LOCK, 0, 1, 0, overlapped); err != nil {\n120|\t\t_ = windows.CloseHandle(handle)\n121|\t\treturn nil, err\n122|\t}\n123|\treturn func() {\n124|\t\t_ = windows.UnlockFileEx(handle, 0, 1, 0, overlapped)\n125|\t\t_ = windows.CloseHandle(handle)\n126|\t}, nil\n127|}","final_result":true}}}
