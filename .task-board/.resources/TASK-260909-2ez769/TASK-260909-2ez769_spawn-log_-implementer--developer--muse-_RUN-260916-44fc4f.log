g/migration.go-274-// Stat does not follow a symlink, unlike the symlink-following read-side seam\ninternal/config/migration.go-275-// in OSInputs. Durable migration replaces the selected file with an atomic\ninternal/config/migration.go-276-// rename, which replaces a symlink itself rather than its target: migrating a\ninternal/config/migration.go-277-// symlinked configuration would silently detach the operator's link and leave\ninternal/config/migration.go-278-// the real document holding stale bytes next to a backup of the resolved\ninternal/config/migration.go-279-// target. The specification is silent here, so the mutating path fails closed\ninternal/config/migration.go-280-// with ErrConfigNotRegular instead of guessing which file the operator meant.\ninternal/config/migration.go:281:func (osMigrationFileSystem) Stat(name string) (fs.FileInfo, error) { return os.Lstat(name) }\ninternal/config/migration.go:282:func (osMigrationFileSystem) Remove(name string) error              { return os.Remove(name) }\ninternal/config/migration.go:283:func (osMigrationFileSystem) Rename(oldname, newname string) error {\ninternal/config/migration.go-284-\treturn os.Rename(oldname, newname)\ninternal/config/migration.go-285-}\ninternal/config/migration.go:286:func (osMigrationFileSystem) OpenDirectory(name string) (migrationDirectory, error) {\ninternal/config/migration.go-287-\treturn os.Open(name)\ninternal/config/migration.go-288-}\ninternal/config/migration.go-289-\ninternal/config/migration.go-290-// replaceDurably publishes a byte-exact backup of the pre-migration\ninternal/config/migration.go-291-// configuration document, then installs the replacement. Backup contents\ninternal/config/migration.go-292-// classification: the backup is a copy of configuration bytes only (host\ninternal/config/migration.go-293-// and peer UUIDs, names, endpoints, SSH arguments) and never carries\ninternal/config/migration.go-294-// private key material, which lives exclusively under\ninternal/config/migration.go-295-// STATE_DIR/host-channel/credentials/. The custody contract for backups is:\ninternal/config/migration.go-296-// staged 0600 with group/world-clean verification (Unix owner-only), and\ninternal/config/migration.go-297-// published names matched by hosttrust.ExcludedConfigDirName so every\ninternal/config/migration.go-298-// replication, snapshot, clone or diagnostic surface must drop them. On\ninternal/config/migration.go-299-// Windows the backup DACL inherits the user-profile ACL; that inheritance\ninternal/config/migration.go-300-// is a stated bound, not owner-only evidence.\ninternal/config/migration.go:301:func replaceDurably(filesystem migrationFileSystem, filename, backup string, original, replacement []byte) error {\ninternal/config/migration.go-302-\tdirectory := filepath.Dir(filename)\ninternal/config/migration.go-303-\t// Re-inspect the selected file before anything durable is written. Load\ninternal/config/migration.go-304-\t// resolved and validated it through the symlink-following read seam; this\ninternal/config/migration.go-305-\t// mutating seam does not follow symlinks, so a selected file that is not\ninternal/config/migration.go-306-\t// itself a regular file is refused here rather than after a backup has\ninternal/config/migration.go-307-\t// already been published. A refused migration therefore leaves the\ninternal/config/migration.go-308-\t// directory exactly as it found it, and the captured permission bits are\ninternal/config/migration.go-309-\t// the ones the replacement inherits.\ninternal/config/migration.go-310-\tinfo, err := filesystem.Stat(filename)\ninternal/config/migration.go-311-\tif err != nil {\ninternal/config/migration.go-312-\t\treturn migrationError(MigrationError{Operation: \"inspect source mode\", Err: errors.Join(ErrMigrationWrite, err)})\ninternal/config/migration.go-313-\t}\ninternal/config/migration.go-314-\tif !info.Mode().IsRegular() {\ninternal/config/migration.go-315-\t\treturn migrati