{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c83d","stream":{"kind":"session","id":"01a0aa74-c329-7d72-8811-c1901bb53d47"},"sequence":633,"recorded_at":1780531400001261,"record_type":"event","durability":"durable","causation_id":"e52fa573-a598-4d15-9493-65cb4f83069f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e52fa573-a598-4d15-9493-65cb4f83069f","run_stream":{"kind":"run","id":"e52fa573-a598-4d15-9493-65cb4f83069f"},"task_stream":{"kind":"task","id":"01a0aa77-10dc-7b61-ad06-b94ec2ee5561"},"task_id":"01a0aa77-10dc-7b61-ad06-b94ec2ee5561","event":{"kind":"output","task_id":"01a0aa77-10dc-7b61-ad06-b94ec2ee5561","chunk":"Read text file `/tmp/rev5ev/probes/reviewer_restore_test.go`.\n1|package config\n2|import(\"os\";\"testing\";\"github.com/relux-works/agent-session-manager/internal/hosttrust\")\n3|type reviewerRestoreFS struct {osMigrationFileSystem; fixture *v4Fixture; t *testing.T; renames int; admittedGeneration uint64}\n4|func(f *reviewerRestoreFS) Rename(from,to string) error {\n5| if to != f.fixture.filename {return f.osMigrationFileSystem.Rename(from,to)}\n6| f.renames++\n7| if f.renames==2 {\n8|  if err:=os.Chmod(f.fixture.store.TrustPath(),0600);err!=nil{return err}\n9|  coherent,err:=LoadCoherent(f.fixture.inputs,nil,f.fixture.store)\n10|  if err!=nil {f.t.Fatalf(\"surviving read: %v\",err)}\n11|  loaded,ok:=coherent.Config.Configuration()\n12|  if !ok || loaded.SourceVersion!=Version4 {f.t.Fatal(\"reader did not admit Config4\")}\n13|  f.admittedGeneration=coherent.Generation\n14| }\n15| if err:=f.osMigrationFileSystem.Rename(from,to);err!=nil{return err}\n16| if f.renames==1 {return os.Chmod(f.fixture.store.TrustPath(),0644)}\n17| return nil\n18|}\n19|func TestReviewerRestoreCannotOverwriteConvergedCommit(t *testing.T) {\n20| fixture:=setupV4Fixture(t,testPeerID)\n21| preview,err:=PreviewV4(fixture.inputs,nil,fixture.trust(t),fixture.self,nil,fixture.now)\n22| if err!=nil {t.Fatal(err)}\n23| filesystem:=&reviewerRestoreFS{fixture:fixture,t:t}\n24| _,err=applyV4(fixture.inputs,nil,preview,true,fixture.now,filesystem,hosttrust.Open)\n25| if err==nil {t.Fatal(\"faulted apply unexpectedly succeeded\")}\n26| if filesystem.admittedGeneration==0 {t.Fatal(\"restore seam not reached\")}\n27| coherent,err:=LoadCoherent(fixture.inputs,nil,fixture.store)\n28| if err!=nil {t.Fatal(err)}\n29| loaded,ok:=coherent.Config.Configuration();if !ok {t.Fatal(\"missing config\")}\n30| if loaded.SourceVersion!=Version4 && coherent.Generation==filesystem.admittedGeneration {\n31|  t.Fatalf(\"unlocked recovery replaced admitted Config4 with %s without a generation change: before=%d after=%d\",loaded.SourceVersion,filesystem.admittedGeneration,coherent.Generation)\n32| }\n33|}","final_result":true}}}
