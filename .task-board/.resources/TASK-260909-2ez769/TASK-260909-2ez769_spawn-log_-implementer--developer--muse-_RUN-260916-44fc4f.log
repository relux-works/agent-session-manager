treplacement := []byte(\"replacement configuration\\n\")\n44|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n45|\tstageJointMarker(t, store, jointMarker(configPath, source, replacement, snapshot.Generation))\n46|\tif err := os.WriteFile(configPath, replacement, 0o600); err != nil {\n47|\t\tt.Fatal(err)\n48|\t}\n49|\tconverged, err := store.ReadSnapshot()\n50|\tif err != nil {\n51|\t\tt.Fatalf(\"ReadSnapshot error = %v\", err)\n52|\t}\n53|\tif converged.Generation != snapshot.Generation+1 {\n54|\t\tt.Fatalf(\"ReadSnapshot generation = %d, want %d\", converged.Generation, snapshot.Generation+1)\n55|\t}\n56|\tassertMarkerGone(t, store)\n57|}\n58|\n59|// An unreplaced marker aborts on read with no generation change.\n60|func TestReadSnapshotAbortsUnreplacedCommit(t *testing.T) {\n61|\tsource := []byte(\"source configuration\\n\")\n62|\treplacement := []byte(\"replacement configuration\\n\")\n63|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n64|\tstageJointMarker(t, store, jointMarker(configPath, source, replacement, snapshot.Generation))\n65|\tconverged, err := store.ReadSnapshot()\n66|\tif err != nil {\n67|\t\tt.Fatalf(\"ReadSnapshot error = %v\", err)\n68|\t}\n69|\tif converged.Generation != snapshot.Generation {\n70|\t\tt.Fatalf(\"ReadSnapshot generation = %d, want %d\", converged.Generation, snapshot.Generation)\n71|\t}\n72|\tassertMarkerGone(t, store)\n73|}\n74|\n75|// A marker the configuration no longer matches refuses the read and keeps\n76|// the marker for operator resolution.\n77|func TestReadSnapshotRefusesIntervention(t *testing.T) {\n78|\tsource := []byte(\"source configuration\\n\")\n79|\treplacement := []byte(\"replacement configuration\\n\")\n80|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n81|\tstageJointMarker(t, store, jointMarker(configPath, source, replacement, snapshot.Generation))\n82|\tif err := os.WriteFile(configPath, []byte(\"operator edit\\n\"), 0o600); err != nil {\n83|\t\tt.Fatal(err)\n84|\t}\n85|\tif refused, err := store.ReadSnapshot(); err == nil {\n86|\t\tt.Fatalf(\"ReadSnapshot(intervened) admitted generation %d, want refusal\", refused.Generation)\n87|\t} else if !errors.Is(err, ErrJointIntervened) {\n88|\t\tt.Fatalf(\"ReadSnapshot error = %v, want ErrJointIntervened\", err)\n89|\t}\n90|\tassertMarkerKept(t, store)\n91|}\n92|\n93|// WithSharedSnapshot converges before running fn, so the trust fn observes\n94|// is the converged generation, never the superseded one.\n95|func TestSharedSnapshotConvergesInterruptedApply(t *testing.T) {\n96|\tsource := []byte(\"source configuration\\n\")\n97|\treplacement := []byte(\"replacement configuration\\n\")\n98|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n99|\tstageJointMarker(t, store, jointMarker(configPath, source, replacement, snapshot.Generation))\n100|\tif err := os.WriteFile(configPath, replacement, 0o600); err != nil {\n101|\t\tt.Fatal(err)\n102|\t}\n103|\tvar observed uint64\n104|\tif err := store.WithSharedSnapshot(func(current TrustStore) error {\n105|\t\tobserved = current.Generation\n106|\t\treturn nil\n107|\t}); err != nil {\n108|\t\tt.Fatalf(\"WithSharedSnapshot error = %v\", err)\n109|\t}\n110|\tif observed != snapshot.Generation+1 {\n111|\t\tt.Fatalf(\"WithSharedSnapshot generation = %d, want %d\", observed, snapshot.Generation+1)\n112|\t}\n113|\tassertMarkerGone(t, store)\n114|}\n115|\n116|// Ordinary trust transactions converge pending intent before applying: the\n117|// interrupted apply completes first (source+1), then the transaction\n118|// commits on top (source+2).\n119|func TestTransactionConvergesPendingMarker(t *testing.T) {\n120|\tsource := []byte(\"source configuration\\n\")\n121|\treplacement := []byte(\"replacement configuration\\n\")\n122|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n123|\tstageJointMarker(t, store, jointMarker(configPath, source, replacement, snapshot.Generation))\n124|\tif err := os.WriteFile(configPath, replacement, 0o600); err != nil {\n125|\t\tt.Fatal(err)\n126|\t}\n127|\tif err := store.transact(func(*TrustStore) error { return nil }); err != nil {\n128|\t\tt.Fatalf(\"transact error = %v\", err)\n129|\t}\n130|\tfresh, err := store.ReadSnapshot()\n131|\tif err != nil {\n132|\t\tt.Fatal(err)\n133|\t}\n134|\tif fresh.Generation != snapshot.Generation+2 {\n135|\t\tt.Fatalf(\"transacted generation = %d, want %d\", fresh.Generation, snapshot.Generation+2)\n136|\t}\n137|\tassertMarkerGone(t, store)\n138|}\n139|\n140|// A joint commit converging a completed leftover refuses its own stale\n141|// pins: convergence moved the generation, so the backstop fires before\n142|// anything is staged.\n143|func TestJointCommitConvergesLeftoverThenRefusesStale(t *testing.T) {\n144|\tsource := []byte(\"source configuration\\n\")\n145|\treplacement := []byte(\"replacement configuration\\n\")\n146|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n147|\tstageJointMarker(t, store, jointMarker(configPath, source, replacement, snapshot.Generation))\n148|\tif err := os.WriteFile(configPath, replacement, 0o600); err != nil {\n149|\t\tt.Fatal(err)\n150|\t}\n151|\tcalled := false\n152|\tif _, err := store.JointCommit(jointMarker(configPath, source, replacement, snapshot.Generation),\n153|\t\tfunc(TrustStore) error { return nil },\n154|\t\tfunc() error {\n155|\t\t\tcalled = true\n156|\t\t\treturn nil\n157|\t\t}); err == nil || called {\n158|\t\tt.Fatalf(\"JointCommit(stale pins) admitted: replace=%v\", called)\n159|\t} else if !errors.Is(err, ErrStaleGeneration) {\n160|\t\tt.Fatalf(\"JointCommit error = %v, want ErrStaleGeneration\", err)\n161|\t}\n162|\tassertMarkerGone(t, store)\n163|\tfresh, err := store.ReadSnapshot()\n164|\tif err != nil {\n165|\t\tt.Fatal(err)\n166|\t}\n167|\tif fresh.Generation != snapshot.Generation+1 {\n168|\t\tt.Fatalf(\"converged generation = %d, want %d\", fresh.Generation, snapshot.Generation+1)\n169|\t}\n170|}\n171|\n172|// A joint commit converging an aborted leftover proceeds: the unreplaced\n173|// marker aborts with no generation change, then the new commit stages and\n174|// lands normally.\n175|func TestJointCommitConvergesAbortedLeftoverThenCommits(t *testing.T) {\n176|\tsource := []byte(\"source configuration\\n\")\n177|\treplacement := []byte(\"replacement configuration\\n\")\n178|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n179|\tstageJointMarker(t, store, jointMarker(configPath, source, replacement, snapshot.Generation))\n180|\tgeneration, err := store.JointCommit(jointMarker(configPath, source, replacement, snapshot.Generation),\n181|\t\tfunc(current TrustStore) error {\n182|\t\t\tif current.Generation != snapshot.Generation {\n183|\t\t\t\treturn errors.New(\"generation moved\")\n184|\t\t\t}\n185|\t\t\treturn nil\n186|\t\t},\n187|\t\tfunc() error { return os.WriteFile(configPath, replacement, 0o600) })\n188|\tif err != nil {\n189|\t\tt.Fatalf(\"JointCommit error = %v\", err)\n190|\t}\n191|\tif generation != snapshot.Generation+1 {\n192|\t\tt.Fatalf(\"JointCommit generation = %d, want %d\", generation, snapshot.Generation+1)\n193|\t}\n194|\tassertMarkerGone(t, store)\n195|\tinstalled, err := os.ReadFile(configPath)\n196|\tif err != nil {\n197|\t\tt.Fatal(err)\n198|\t}\n199|\tif string(installed) != string(replacement) {\n200|\t\tt.Fatal(\"JointCommit did not install the replacement\")\n201|\t}\n202|}\n203|\n204|// A mutation request bound before a crash refuses stale after convergence:\n205|// the binding compares against the recovered generation, and the boundary\n206|// never runs beside unresolved intent. A request rebound after convergence\n207|// is admitted.\n208|func TestMutationAuthorizationRefusesStaleAfterConvergence(t *testing.T) {\n209|\tlocal, peer, localCredential, peerCredential, localSnap, _ := twoHostFixture(t)\n210|\tleaf, root := peerMaterialForTest(t, peer, peerCredential)\n211|\tbefore := dispatchRequest(localSnap, localCredential, peerCredential, testHostB, leaf, root, []string{testHostA, testHostB}, testNow)\n212|\tsource := []byte(\"source configuration\\n\")\n213|\treplacement := []byte(\"replacement configuration\\n\")\n214|\tconfigPath := filepath.Join(t.TempDir(), \"config.toml\")\n215|\tif err := os.WriteFile(configPath, source, 0o600); err != nil {\n216|\t\tt.Fatal(err)\n217|\t}\n218|\tstageJointMarker(t, local, jointMarker(configPath, source, replacement, localSnap.Generation))\n219|\tif err := os.WriteFile(configPath, replacement, 0o600); err != nil {\n220|\t\tt.Fatal(err)\n221|\t}\n222|\tcalled := false\n223|\tif err := local.WithMutationAuthorization(before, func() error {\n224|\t\tcalled = true\n225|\t\treturn nil\n226|\t}); err == nil || called {\n227|\t\tt.Fatalf(\"WithMutationAuthorization(pre-crash) admitted: err=nil boundary=%v\", called)\n228|\t} else if !errors.Is(err, ErrStaleGeneration) {\n229|\t\tt.Fatalf(\"WithMutationAuthorization error = %v, want ErrStaleGeneration\", err)\n230|\t}\n231|\tassertMarkerGone(t, local)\n232|\tfresh, err := local.ReadSnapshot()\n233|\tif err != nil {\n234|\t\tt.Fatal(err)\n235|\t}\n236|\tif fresh.Generation != localSnap.Generation+1 {\n237|\t\tt.Fatalf(\"converged generation = %d, want %d\", fresh.Generation, localSnap.Generation+1)\n238|\t}\n239|\trebound := dispatchRequest(fresh, localCredential, peerCredential, testHostB, leaf, root, []string{testHostA, testHostB}, testNow)\n240|\tadmitted := false\n241|\tif err := local.WithMutationAuthorization(rebound, func() error {\n242|\t\tadmitted = true\n243|\t\treturn nil\n244|\t}); err != nil {\n245|\t\tt.Fatalf(\"WithMutationAuthorization(rebound) error = %v\", err)\n246|\t}\n247|\tif !admitted {\n248|\t\tt.Fatal(\"WithMutationAuthorization(rebound) did not run the boundary\")\n249|\t}\n250|}\n251|\n252|// An unreadable marker path refuses the read: absence must be established,\n253|// never assumed from a failed inspection.\n254|func TestReadSnapshotRefusesUnreadableMarker(t *testing.T) {\n255|\tsource := []byte(\"source configuration\\n\")\n256|\treplacement := []byte(\"replacement configuration\\n\")\n257|\tstore, _, _ := jointFixture(t, source, replacement)\n258|\tshadow := &Store{root: store.root, fs: unreadableMarkerFS{FileSystem: store.fs}, lock: store.lock}\n259|\tif refused, err := shadow.ReadSnapshot(); err == nil {\n260|\t\tt.Fatalf(\"ReadSnapshot(unreadable marker) admitted generation %d, want refusal\", refused.Generation)\n261|\t} else if !errors.Is(err, ErrTrustStoreUnreadable) {\n262|\t\tt.Fatalf(\"ReadSnapshot error = %v, want ErrTrustStoreUnreadable\", err)\n263|\t}\n264|}\n265|\n266|type unreadableMarkerFS struct {\n267|\tFileSystem\n268|}\n269|\n270|func (filesystem unreadableMarkerFS) Lstat(path string) (fs.FileInfo, error) {\n271|\tif filepath.Base(path) == pendingCommitFileName {\n272|\t\treturn nil, errors.New(\"joint marker inspection unavailable\")\n273|\t}\n274|\treturn filesystem.FileSystem.Lstat(path)\n275|}\n276|\n277|// A transaction beside an intervened marker refuses with the marker kept:\n278|// no trust commit may land while joint intent is unresolvable.\n279|func TestTransactionRefusesIntervention(t *testing.T) {\n280|\tsource := []byte(\"source configuration\\n\")\n281|\treplacement := []byte(\"replacement configuration\\n\")\n282|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n283|\tstageJointMarker(t, store, jointMarker(configPath, source, replacement, snapshot.Generation))\n284|\tif err := os.WriteFile(configPath, []byte(\"operator edit\\n\"), 0o600); err != nil {\n285|\t\tt.Fatal(err)\n286|\t}\n287|\tif err := store.transact(func(*TrustStore) error { return nil }); err == nil {\n288|\t\tt.Fatal(\"transact(intervened) succeeded, want refusal\")\n289|\t} else if !errors.Is(err, ErrJointIntervened) {\n290|\t\tt.Fatalf(\"transact error = %v, want ErrJointIntervened\", err)\n291|\t}\n292|\tassertMarkerKept(t, store)\n293|}\n294|\n295|// A joint commit beside an intervened leftover refuses before staging: the\n296|// new commit never runs while prior intent is unresolvable.\n297|func TestJointCommitRefusesIntervenedLeftover(t *testing.T) {\n298|\tsource := []byte(\"source configuration\\n\")\n299|\treplacement := []byte(\"replacement configuration\\n\")\n300|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n301|\tstageJointMarker(t, store, jointMarker(configPath, source, replacement, snapshot.Generation))\n302|\tif err := os.WriteFile(configPath, []byte(\"operator edit\\n\"), 0o600); err != nil {\n303|\t\tt.Fatal(err)\n304|\t}\n305|\tcalled := false\n306|\tif _, err := store.JointCommit(jointMarker(configPath, source, replacement, snapshot.Generation),\n307|\t\tfunc(TrustStore) error { return nil },\n308|\t\tfunc() error {\n309|\t\t\tcalled = true\n310|\t\t\treturn nil\n311|\t\t}); err == nil || called {\n312|\t\tt.Fatalf(\"JointCommit(intervened leftover) admitted: replace=%v\", called)\n313|\t} else if !errors.Is(err, ErrJointIntervened) {\n314|\t\tt.Fatalf(\"JointCommit error = %v, want ErrJointIntervened\", err)\n315|\t}\n316|\tassertMarkerKept(t, store)\n317|}\n318|\n319|// Setup beside an intervened marker refuses: initialization never builds\n320|// generation 1 while joint intent is unresolvable.\n321|func TestInitializeRefusesIntervention(t *testing.T) {\n322|\tstore := openForTest(t, t.TempDir())\n323|\tsource := []byte(\"source configuration\\n\")\n324|\treplacement := []byte(\"replacement configuration\\n\")\n325|\tconfigPath := filepath.Join(t.TempDir(), \"config.toml\")\n326|\tif err := os.WriteFile(configPath, source, 0o600); err != nil {\n327|\t\tt.Fatal(err)\n328|\t}\n329|\tstageJointMarker(t, store, jointMarker(configPath, source, replacement, 1))\n330|\tif err := os.WriteFile(configPath, []byte(\"operator edit\\n\"), 0o600); err != nil {\n331|\t\tt.Fatal(err)\n332|\t}\n333|\tif _, err := store.Initialize(); err == nil {\n334|\t\tt.Fatal(\"Initialize(intervened) succeeded, want refusal\")\n335|\t} else if !errors.Is(err, ErrJointIntervened) {\n336|\t\tt.Fatalf(\"Initialize error = %v, want ErrJointIntervened\", err)\n337|\t}\n338|\tassertMarkerKept(t, store)\n339|}\n340|\n341|// A mutation boundary beside an intervened marker refuses without running:\n342|// authorization never proceeds while joint intent is unresolvable.\n343|func TestMutationAuthorizationRefusesIntervention(t *testing.T) {\n344|\tlocal, peer, localCredential, peerCredential, localSnap, _ := twoHostFixture(t)\n345|\tleaf, root := peerMaterialForTest(t, peer, peerCredential)\n346|\trequest := dispatchRequest(localSnap, localCredential, peerCredential, testHostB, leaf, root, []string{testHostA, testHostB}, testNow)\n347|\tsource := []byte(\"source configuration\\n\")\n348|\treplacement := []byte(\"replacement configuration\\n\")\n349|\tconfigPath := filepath.Join(t.TempDir(), \"config.toml\")\n350|\tif err := os.WriteFile(configPath, source, 0o600); err != nil {\n351|\t\tt.Fatal(err)\n352|\t}\n353|\tstageJointMarker(t, local, jointMarker(configPath, source, replacement, localSnap.Generation))\n354|\tif err := os.WriteFile(configPath, []byte(\"operator edit\\n\"), 0o600); err != nil {\n355|\t\tt.Fatal(err)\n356|\t}\n357|\tcalled := false\n358|\tif err := local.WithMutationAuthorization(request, func() error {\n359|\t\tcalled = true\n360|\t\treturn nil\n361|\t}); err == nil || called {\n362|\t\tt.Fatalf(\"WithMutationAuthorization(intervened) admitted: boundary=%v\", called)\n363|\t} else if !errors.Is(err, ErrJointIntervened) {\n364|\t\tt.Fatalf(\"WithMutationAuthorization error = %v, want ErrJointIntervened\", err)\n365|\t}\n366|\tassertMarkerKept(t, local)\n367|}\n368|\n369|// A dispatch beside an intervened marker refuses: the currency check never\n370|// runs against unresolvable trust.\n371|func TestAuthorizeDispatchRefusesIntervention(t *testing.T) {\n372|\tlocal, peer, localCredential, peerCredential, localSnap, _ := twoHostFixture(t)\n373|\tleaf, root := peerMaterialForTest(t, peer, peerCredential)\n374|\trequest := dispatchRequest(localSnap, localCredential, peerCredential, testHostB, leaf, root, []string{testHostA, testHostB}, testNow)\n375|\tsource := []byte(\"source configuration\\n\")\n376|\treplacement := []byte(\"replacement configuration\\n\")\n377|\tconfigPath := filepath.Join(t.TempDir(), \"config.toml\")\n378|\tif err := os.WriteFile(configPath, source, 0o600); err != nil {\n379|\t\tt.Fatal(err)\n380|\t}\n381|\tstageJointMarker(t, local, jointMarker(configPath, source, replacement, localSnap.Generation))\n382|\tif err := os.WriteFile(configPath, []byte(\"operator edit\\n\"), 0o600); err != nil {\n383|\t\tt.Fatal(err)\n384|\t}\n385|\tif err := local.AuthorizeDispatch(localSnap, request); err == nil {\n386|\t\tt.Fatal(\"AuthorizeDispatch(intervened) succeeded, want refusal\")\n387|\t} else if !errors.Is(err, ErrJointIntervened) {\n388|\t\tt.Fatalf(\"AuthorizeDispatch error = %v, want ErrJointIntervened\", err)\n389|\t}\n390|\tassertMarkerKept(t, local)\n391|}\n392|\n393|// A dispatch bound before a crash refuses stale after convergence instead\n394|// of admitting superseded trust.\n395|func TestAuthorizeDispatchStaleAfterConvergence(t *testing.T) {\n396|\tlocal, peer, localCredential, peerCredential, localSnap, _ := twoHostFixture(t)\n397|\tleaf, root := peerMaterialForTest(t, peer, peerCredential)\n398|\tbefore := dispatchRequest(localSnap, localCredential, peerCredential, testHostB, leaf, root, []string{testHostA, testHostB}, testNow)\n399|\tsource := []byte(\"source configuration\\n\")\n400|\treplacement := []byte(\"replacement configuration\\n\")\n401|\tconfigPath := filepath.Join(t.TempDir(), \"config.toml\")\n402|\tif err := os.WriteFile(configPath, source, 0o600); err != nil {\n403|\t\tt.Fatal(err)\n404|\t}\n405|\tstageJointMarker(t, local, jointMarker(configPath, source, replacement, localSnap.Generation))\n406|\tif err := os.WriteFile(configPath, replacement, 0o600); err != nil {\n407|\t\tt.Fatal(err)\n408|\t}\n409|\tif err := local.AuthorizeDispatch(localSnap, before); err == nil {\n410|\t\tt.Fatal(\"AuthorizeDispatch(pre-crash) admitted, want stale refusal\")\n411|\t} else if !errors.Is(err, ErrStaleGeneration) {\n412|\t\tt.Fatalf(\"AuthorizeDispatch error = %v, want ErrStaleGeneration\", err)\n413|\t}\n414|\tassertMarkerGone(t, local)\n415|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
