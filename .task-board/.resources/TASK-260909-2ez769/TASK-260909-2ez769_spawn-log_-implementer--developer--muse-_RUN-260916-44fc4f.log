{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc29","stream":{"kind":"session","id":"01a0aa74-c329-7d72-8811-c1901bb53d47"},"sequence":1135,"recorded_at":1780531400002265,"record_type":"event","durability":"durable","causation_id":"e52fa573-a598-4d15-9493-65cb4f83069f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e52fa573-a598-4d15-9493-65cb4f83069f","run_stream":{"kind":"run","id":"e52fa573-a598-4d15-9493-65cb4f83069f"},"call_id":"call_01a0aa7ef15377a5b514539b32890a29","text":"Read text file `internal/hosttrust/joint_test.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"testing\"\n8|\t\"time\"\n9|)\n10|\n11|func jointFixture(t *testing.T, source, replacement []byte) (*Store, string, Snapshot) {\n12|\tt.Helper()\n13|\tdirectory := t.TempDir()\n14|\tconfigPath := filepath.Join(directory, \"config.toml\")\n15|\tif err := os.WriteFile(configPath, source, 0o600); err != nil {\n16|\t\tt.Fatal(err)\n17|\t}\n18|\tstore := setupStoreForTest(t)\n19|\tsnapshot, err := store.ReadSnapshot()\n20|\tif err != nil {\n21|\t\tt.Fatal(err)\n22|\t}\n23|\treturn store, configPath, snapshot\n24|}\n25|\n26|func jointMarker(configPath string, source, replacement []byte, generation uint64) PendingCommit {\n27|\treturn PendingCommit{\n28|\t\tSchema:            \"urn:ax:schema:host-pending-commit\",\n29|\t\tSchemaVersion:     \"1.0.0\",\n30|\t\tOperation:         JointApplyV4,\n31|\t\tConfigPath:        configPath,\n32|\t\tSourceSHA256:      SHA256HexOf(source),\n33|\t\tReplacementSHA256: SHA256HexOf(replacement),\n34|\t\tSourceGeneration:  generation,\n35|\t\tBackupPath:        configPath + \".bak.3.0.0\",\n36|\t}\n37|}\n38|\n39|func TestJointCommitHappyPath(t *testing.T) {\n40|\tsource := []byte(\"source configuration\\n\")\n41|\treplacement := []byte(\"replacement configuration\\n\")\n42|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n43|\tmarker := jointMarker(configPath, source, replacement, snapshot.Generation)\n44|\treplace := func() error { return os.WriteFile(configPath, replacement, 0o600) }\n45|\trevalidate := func(current TrustStore) error {\n46|\t\tif current.Generation != snapshot.Generation {\n47|\t\t\treturn errors.New(\"generation moved\")\n48|\t\t}\n49|\t\treturn nil\n50|\t}\n51|\tgeneration, err := store.JointCommit(marker, revalidate, replace)\n52|\tif err != nil {\n53|\t\tt.Fatalf(\"JointCommit error = %v\", err)\n54|\t}\n55|\tif generation != snapshot.Generation+1 {\n56|\t\tt.Fatalf(\"JointCommit generation = %d, want %d\", generation, snapshot.Generation+1)\n57|\t}\n58|\tinstalled, err := os.ReadFile(configPath)\n59|\tif err != nil {\n60|\t\tt.Fatal(err)\n61|\t}\n62|\tif string(installed) != string(replacement) {\n63|\t\tt.Fatal(\"JointCommit did not install the replacement\")\n64|\t}\n65|\tif _, err := os.Lstat(pendingPath(store.root)); !os.IsNotExist(err) {\n66|\t\tt.Fatalf(\"joint marker remains after commit: %v\", err)\n67|\t}\n68|\tfresh, err := store.ReadSnapshot()\n69|\tif err != nil {\n70|\t\tt.Fatal(err)\n71|\t}\n72|\tif fresh.Generation != generation {\n73|\t\tt.Fatalf(\"committed generation = %d, want %d\", fresh.Generation, generation)\n74|\t}\n75|}\n76|\n77|func TestJointCommitRevalidatesStaleGeneration(t *testing.T) {\n78|\tsource := []byte(\"source configuration\\n\")\n79|\treplacement := []byte(\"replacement configuration\\n\")\n80|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n81|\t// A concurrent trust commit moves the generation before the joint\n82|\t// commit runs: the in-lock revalidation must refuse the stale pins.\n83|\tpeer := setupStoreForTest(t)\n84|\tenrollPeerForTest(t, store, peer, testHostC, testNow)\n85|\tmarker := jointMarker(configPath, source, replacement, snapshot.Generation)\n86|\tcalled := false\n87|\t_, err := store.JointCommit(marker,\n88|\t\tfunc(current TrustStore) error {\n89|\t\t\tif current.Generation != snapshot.Generation {\n90|\t\t\t\treturn trustError(TrustError{Operation: \"validate preview generation\", Err: ErrStaleGeneration})\n91|\t\t\t}\n92|\t\t\treturn nil\n93|\t\t},\n94|\t\tfunc() error {\n95|\t\t\tcalled = true\n96|\t\t\treturn nil\n97|\t\t})\n98|\tif err == nil || called {\n99|\t\tt.Fatalf(\"JointCommit(stale) admitted: err=%v replace=%v\", err, called)\n100|\t} else if !errors.Is(err, ErrStaleGeneration) {\n101|\t\tt.Fatalf(\"JointCommit(stale) error = %v, want ErrStaleGeneration\", err)\n102|\t}\n103|\tif _, err := os.Lstat(pendingPath(store.root)); !os.IsNotExist(err) {\n104|\t\tt.Fatalf(\"joint marker remains after refused commit: %v\", err)\n105|\t}\n106|\tinstalled, err := os.ReadFile(configPath)\n107|\tif err != nil {\n108|\t\tt.Fatal(err)\n109|\t}\n110|\tif string(installed) != string(source) {\n111|\t\tt.Fatal(\"refused joint commit mutated the configuration\")\n112|\t}\n113|}\n114|\n115|func TestJointCommitReplaceFailureAborts(t *testing.T) {\n116|\tsource := []byte(\"source configuration\\n\")\n117|\treplacement := []byte(\"replacement configuration\\n\")\n118|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n119|\tmarker := jointMarker(configPath, source, replacement, snapshot.Generation)\n120|\treplaceErr := errors.New(\"replacement unavailable\")\n121|\t_, err := store.JointCommit(marker,\n122|\t\tfunc(TrustStore) error { return nil },\n123|\t\tfunc() error { return replaceErr })\n124|\tif err == nil {\n125|\t\tt.Fatal(\"JointCommit(failing replace) succeeded, want refusal\")\n126|\t} else if !errors.Is(err, replaceErr) {\n127|\t\tt.Fatalf(\"JointCommit error = %v, want the replace failure\", err)\n128|\t}\n129|\tfresh, err := store.ReadSnapshot()\n130|\tif err != nil {\n131|\t\tt.Fatal(err)\n132|\t}\n133|\tif fresh.Generation != snapshot.Generation {\n134|\t\tt.Fatalf(\"aborted joint commit moved generation to %d\", fresh.Generation)\n135|\t}\n136|\tif _, err := os.Lstat(pendingPath(store.root)); !os.IsNotExist(err) {\n137|\t\tt.Fatalf(\"joint marker remains after aborted commit: %v\", err)\n138|\t}\n139|}\n140|\n141|func TestRecoverCompletesForwardAfterCrash(t *testing.T) {\n142|\tsource := []byte(\"source configuration\\n\")\n143|\treplacement := []byte(\"replacement configuration\\n\")\n144|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n145|\t// Stage exactly what a crash between the configuration replacement and\n146|\t// the generation bump leaves: the marker plus the replaced bytes with\n147|\t// the old generation still committed.\n148|\tmarker := jointMarker(configPath, source, replacement, snapshot.Generation)\n149|\tencoded, err := encodePendingCommit(marker)\n150|\tif err != nil {\n151|\t\tt.Fatal(err)\n152|\t}\n153|\tif err := commitDocument(store.fs, store.root, pendingPath(store.root), encoded); err != nil {\n154|\t\tt.Fatal(err)\n155|\t}\n156|\tif err := os.WriteFile(configPath, replacement, 0o600); err != nil {\n157|\t\tt.Fatal(err)\n158|\t}\n159|\tresult, err := store.Recover()\n160|\tif err != nil {\n161|\t\tt.Fatalf(\"Recover error = %v\", err)\n162|\t}\n163|\tif !result.Found || !result.Completed || result.Aborted {\n164|\t\tt.Fatalf(\"Recover = %+v, want found+completed\", result)\n165|\t}\n166|\tfresh, err := store.ReadSnapshot()\n167|\tif err != nil {\n168|\t\tt.Fatal(err)\n169|\t}\n170|\tif fresh.Generation != snapshot.Generation+1 {\n171|\t\tt.Fatalf(\"recovered generation = %d, want %d\", fresh.Generation, snapshot.Generation+1)\n172|\t}\n173|\tif _, err := os.Lstat(pendingPath(store.root)); !os.IsNotExist(err) {\n174|\t\tt.Fatalf(\"joint marker remains after recovery: %v\", err)\n175|\t}\n176|}\n177|\n178|func TestOpenConvergesInterruptedCommit(t *testing.T) {\n179|\tsource := []byte(\"source configuration\\n\")\n180|\treplacement := []byte(\"replacement configuration\\n\")\n181|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n182|\tmarker := jointMarker(configPath, source, replacement, snapshot.Generation)\n183|\tencoded, err := encodePendingCommit(marker)\n184|\tif err != nil {\n185|\t\tt.Fatal(err)\n186|\t}\n187|\tif err := commitDocument(store.fs, store.root, pendingPath(store.root), encoded); err != nil {\n188|\t\tt.Fatal(err)\n189|\t}\n190|\tif err := os.WriteFile(configPath, replacement, 0o600); err != nil {\n191|\t\tt.Fatal(err)\n192|\t}\n193|\t// Re-opening the same state directory must converge the interrupted\n194|\t// commit instead of admitting the replacement with the old generation.\n195|\tstateDir := filepath.Dir(store.root)\n196|\treopened, err := openStore(stateDir, osFileSystem{})\n197|\tif err != nil {\n198|\t\tt.Fatalf(\"openStore after crash error = %v\", err)\n199|\t}\n200|\tconverged, err := reopened.ReadSnapshot()\n201|\tif err != nil {\n202|\t\tt.Fatal(err)\n203|\t}\n204|\tif converged.Generation != snapshot.Generation+1 {\n205|\t\tt.Fatalf(\"reopened generation = %d, want %d\", converged.Generation, snapshot.Generation+1)\n206|\t}\n207|}\n208|\n209|func TestRecoverAbortsWhenReplacementAbsent(t *testing.T) {\n210|\tsource := []byte(\"source configuration\\n\")\n211|\treplacement := []byte(\"replacement configuration\\n\")\n212|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n213|\t// A crash before the configuration replacement leaves the source bytes\n214|\t// with the marker outstanding: recovery aborts with no generation change.\n215|\tmarker := jointMarker(configPath, source, replacement, snapshot.Generation)\n216|\tencoded, err := encodePendingCommit(marker)\n217|\tif err != nil {\n218|\t\tt.Fatal(err)\n219|\t}\n220|\tif err := commitDocument(store.fs, store.root, pendingPath(store.root), encoded); err != nil {\n221|\t\tt.Fatal(err)\n222|\t}\n223|\tresult, err := store.Recover()\n224|\tif err != nil {\n225|\t\tt.Fatalf(\"Recover error = %v\", err)\n226|\t}\n227|\tif !result.Found || !result.Aborted || result.Completed {\n228|\t\tt.Fatalf(\"Recover = %+v, want found+aborted\", result)\n229|\t}\n230|\tfresh, err := store.ReadSnapshot()\n231|\tif err != nil {\n232|\t\tt.Fatal(err)\n233|\t}\n234|\tif fresh.Generation != snapshot.Generation {\n235|\t\tt.Fatalf(\"aborted recovery moved generation to %d\", fresh.Generation)\n236|\t}\n237|}\n238|\n239|func TestRecoverRefusesIntervention(t *testing.T) {\n240|\tsource := []byte(\"source configuration\\n\")\n241|\treplacement := []byte(\"replacement configuration\\n\")\n242|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n243|\tmarker := jointMarker(configPath, source, replacement, snapshot.Generation)\n244|\tencoded, err := encodePendingCommit(marker)\n245|\tif err != nil {\n246|\t\tt.Fatal(err)\n247|\t}\n248|\tif err := commitDocument(store.fs, store.root, pendingPath(store.root), encoded); err != nil {\n249|\t\tt.Fatal(err)\n250|\t}\n251|\t// An operator edit mid-flight matches neither the source nor the\n252|\t// replacement hash: recovery refuses and keeps the marker.\n253|\tif err := os.WriteFile(configPath, []byte(\"operator edit\\n\"), 0o600); err != nil {\n254|\t\tt.Fatal(err)\n255|\t}\n256|\tif _, err := store.Recover(); err == nil {\n257|\t\tt.Fatal(\"Recover(intervened) succeeded, want refusal\")\n258|\t} else if !errors.Is(err, ErrJointIntervened) {\n259|\t\tt.Fatalf(\"Recover error = %v, want ErrJointIntervened\", err)\n260|\t}\n261|\tif _, err := os.Lstat(pendingPath(store.root)); err != nil {\n262|\t\tt.Fatalf(\"intervention marker was removed: %v\", err)\n263|\t}\n264|\t// A refused recovery fails the open, so incoherent state cannot be used.\n265|\tif _, err := openStore(filepath.Dir(store.root), osFileSystem{}); err == nil {\n266|\t\tt.Fatal(\"openStore(intervened) succeeded, want refusal\")\n267|\t}\n268|}\n269|\n270|func TestRecoverConvergesAlreadyBumped(t *testing.T) {\n271|\tsource := []byte(\"source configuration\\n\")\n272|\treplacement := []byte(\"replacement configuration\\n\")\n273|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n274|\t// The bump landed but marker removal did not: the transaction commits\n275|\t// first, then the marker and the replaced bytes are staged exactly as\n276|\t// a crash between the bump and the marker removal leaves them. The\n277|\t// transaction must run before staging: every transaction converges\n278|\t// pending intent first, so staging before transacting would complete\n279|\t// the marker instead of leaving it outstanding.\n280|\tif err := store.transact(func(*TrustStore) error { return nil }); err != nil {\n281|\t\tt.Fatal(err)\n282|\t}\n283|\tmarker := jointMarker(configPath, source, replacement, snapshot.Generation)\n284|\tencoded, err := encodePendingCommit(marker)\n285|\tif err != nil {\n286|\t\tt.Fatal(err)\n287|\t}\n288|\tif err := commitDocument(store.fs, store.root, pendingPath(store.root), encoded); err != nil {\n289|\t\tt.Fatal(err)\n290|\t}\n291|\tif err := os.WriteFile(configPath, replacement, 0o600); err != nil {\n292|\t\tt.Fatal(err)\n293|\t}\n294|\tresult, err := store.Recover()\n295|\tif err != nil {\n296|\t\tt.Fatalf(\"Recover error = %v\", err)\n297|\t}\n298|\tif !result.Found || !result.Completed {\n299|\t\tt.Fatalf(\"Recover = %+v, want found+completed\", result)\n300|\t}\n301|\tfresh, err := store.ReadSnapshot()\n302|\tif err != nil {\n303|\t\tt.Fatal(err)\n304|\t}\n305|\tif fresh.Generation != snapshot.Generation+1 {\n306|\t\tt.Fatalf(\"recovery bumped twice: generation = %d\", fresh.Generation)\n307|\t}\n308|}\n309|\n310|func TestJointCommitRefusesStaleMarkerGeneration(t *testing.T) {\n311|\tsource := []byte(\"source configuration\\n\")\n312|\treplacement := []byte(\"replacement configuration\\n\")\n313|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n314|\tif snapshot.Generation == 0 {\n315|\t\tt.Fatal(\"fixture generation is zero\")\n316|\t}\n317|\t// The marker pins an older generation while the revalidation callback\n318|\t// is permissive: the joint backstop must still refuse the stale pin,\n319|\t// staging nothing and touching neither the configuration nor the trust.\n320|\tmarker := jointMarker(configPath, source, replacement, snapshot.Generation-1)\n321|\tcalled := false\n322|\tif _, err := store.JointCommit(marker,\n323|\t\tfunc(TrustStore) error { return nil },\n324|\t\tfunc() error {\n325|\t\t\tcalled = true\n326|\t\t\treturn nil\n327|\t\t}); err == nil || called {\n328|\t\tt.Fatalf(\"JointCommit(stale marker) admitted: replace=%v\", called)\n329|\t} else if !errors.Is(err, ErrStaleGeneration) {\n330|\t\tt.Fatalf(\"JointCommit error = %v, want ErrStaleGeneration\", err)\n331|\t}\n332|\tif _, err := os.Lstat(pendingPath(store.root)); !os.IsNotExist(err) {\n333|\t\tt.Fatalf(\"joint marker remains after refused commit: %v\", err)\n334|\t}\n335|\tinstalled, err := os.ReadFile(configPath)\n336|\tif err != nil {\n337|\t\tt.Fatal(err)\n338|\t}\n339|\tif string(installed) != string(source) {\n340|\t\tt.Fatal(\"refused joint commit mutated the configuration\")\n341|\t}\n342|}\n343|\n344|func TestRecoverRefusesDivergedGeneration(t *testing.T) {\n345|\tsource := []byte(\"source configuration\\n\")\n346|\treplacement := []byte(\"replacement configuration\\n\")\n347|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n348|\t// The replacement committed, but the generation since moved two bumps\n349|\t// past the pinned source (operator restore plus an unrelated commit):\n350|\t// recovery must refuse the diverged pair and keep the marker instead\n351|\t// of completing forward under a generation the operator never confirmed.\n352|\tmarker := jointMarker(configPath, source, replacement, snapshot.Generation)\n353|\tencoded, err := encodePendingCommit(marker)\n354|\tif err != nil {\n355|\t\tt.Fatal(err)\n356|\t}\n357|\tif err := commitDocument(store.fs, store.root, pendingPath(store.root), encoded); err != nil {\n358|\t\tt.Fatal(err)\n359|\t}\n360|\tif err := os.WriteFile(configPath, replacement, 0o600); err != nil {\n361|\t\tt.Fatal(err)\n362|\t}\n363|\t// Every transaction converges pending intent first, so the diverged\n364|\t// trust is written directly: an operator restore landing outside the\n365|\t// barrier is the only way committed trust moves twice past a still\n366|\t// outstanding marker.\n367|\tdiverged := snapshot.Trust\n368|\tdiverged.Generation = snapshot.Generation + 2\n369|\trewritten, err := EncodeTrust(diverged)\n370|\tif err != nil {\n371|\t\tt.Fatal(err)\n372|\t}\n373|\tif err := commitDocument(store.fs, store.root, filepath.Join(store.root, trustFileName), rewritten); err != nil {\n374|\t\tt.Fatal(err)\n375|\t}\n376|\tif _, err := store.Recover(); err == nil {\n377|\t\tt.Fatal(\"Recover(diverged generation) succeeded, want refusal\")\n378|\t} else if !errors.Is(err, ErrJointIntervened) {\n379|\t\tt.Fatalf(\"Recover error = %v, want ErrJointIntervened\", err)\n380|\t}\n381|\tif _, err := os.Lstat(pendingPath(store.root)); err != nil {\n382|\t\tt.Fatalf(\"divergence marker was removed: %v\", err)\n383|\t}\n384|}\n385|\n386|func TestJointCommitRefusesRelativeMarkerPath(t *testing.T) {\n387|\tsource := []byte(\"source configuration\\n\")\n388|\treplacement := []byte(\"replacement configuration\\n\")\n389|\tstore, configPath, snapshot := jointFixture(t, source, replacement)\n390|\tmarker := jointMarker(configPath, source, replacement, snapshot.Generation)\n391|\tmarker.ConfigPath = \"relative/config.toml\"\n392|\tif _, err := store.JointCommit(marker,\n393|\t\tfunc(TrustStore) error { return nil },\n394|\t\tfunc() error { return nil }); err == nil {\n395|\t\tt.Fatal(\"JointCommit(relative marker path) succeeded, want refusal\")\n396|\t} else if !errors.Is(err, ErrTrustValidation) {\n397|\t\tt.Fatalf(\"JointCommit error = %v, want ErrTrustValidation\", err)\n398|\t}\n399|}\n400|\n401|func TestPendingCommitClosedDecode(t *testing.T) {\n402|\tsource := []byte(\"source configuration\\n\")\n403|\treplacement := []byte(\"replacement configuration\\n\")\n404|\tvalid, err := encodePendingCommit(jointMarker(\"/abs/config.toml\", source, replacement, 3))\n405|\tif err != nil {\n406|\t\tt.Fatal(err)\n407|\t}\n408|\tif _, err := decodePendingCommit(valid); err != nil {\n409|\t\tt.Fatalf(\"decodePendingCommit(valid) error = %v\", err)\n410|\t}\n411|\tcases := []struct {\n412|\t\tname    string\n413|\t\tmutate  func(string) string\n414|\t\twantErr error\n415|\t}{\n416|\t\t{\"unknown field\", func(document string) string {\n417|\t\t\treturn document[:len(document)-1] + `,\"comment\":\"x\"}`\n418|\t\t}, ErrTrustDecode},\n419|\t\t{\"duplicate key\", func(document string) string {\n420|\t\t\treturn document[:len(document)-1] + `,\"operation\":\"apply-v4\"}`\n421|\t\t}, ErrTrustValidation},\n422|\t\t{\"quoted generation\", func(document string) string {\n423|\t\t\treturn `{\"schema\":\"urn:ax:schema:host-pending-commit\",\"schema_version\":\"1.0.0\",\"operation\":\"apply-v4\",\"config_path\":\"/abs/config.toml\",\"source_sha256\":\"` + SHA256HexOf(source) + `\",\"replacement_sha256\":\"` + SHA256HexOf(replacement) + `\",\"source_generation\":\"3\",\"backup_path\":\"/abs/config.toml.bak.3.0.0\"}`\n424|\t\t}, ErrTrustValidation},\n425|\t\t{\"wrong operation\", func(document string) string {\n426|\t\t\treturn replaceOnce(document, `\"apply-v4\"`, `\"install\"`)\n427|\t\t}, ErrTrustValidation},\n428|\t\t{\"relative config path\", func(document string) string {\n429|\t\t\treturn replaceOnce(document, `\"/abs/config.toml\"`, `\"config.toml\"`)\n430|\t\t}, ErrTrustValidation},\n431|\t\t{\"equal hashes\", func(document string) string {\n432|\t\t\treturn replaceOnce(document, SHA256HexOf(replacement), SHA256HexOf(source))\n433|\t\t}, ErrTrustValidation},\n434|\t}\n435|\tfor _, test := range cases {\n436|\t\tt.Run(test.name, func(t *testing.T) {\n437|\t\t\tif _, err := decodePendingCommit([]byte(test.mutate(string(valid)))); err == nil {\n438|\t\t\t\tt.Fatalf(\"decodePendingCommit(%s) succeeded, want refusal\", test.name)\n439|\t\t\t} else if !errors.Is(err, test.wantErr) {\n440|\t\t\t\tt.Fatalf(\"decodePendingCommit(%s) error = %v, want %v\", test.name, err, test.wantErr)\n441|\t\t\t}\n442|\t\t})\n443|\t}\n444|}\n445|\n446|func replaceOnce(document, old, replacement string) string {\n447|\tfor index := 0; index+len(old) <= len(document); index++ {\n448|\t\tif document[index:index+len(old)] == old {\n449|\t\t\treturn document[:index] + replacement + document[index+len(old):]\n450|\t\t}\n451|\t}\n452|\treturn document\n453|}\n454|\n455|func TestSharedSnapshotSerializesWithExclusive(t *testing.T) {\n456|\tstore := setupStoreForTest(t)\n457|\trelease := make(chan struct{})\n458|\tentered := make(chan struct{})\n459|\tholderDone := make(chan error, 1)\n460|\tgo func() {\n461|\t\tholderDone <- store.transact(func(*TrustStore) error {\n462|\t\t\tclose(entered)\n463|\t\t\t<-release\n464|\t\t\treturn nil\n465|\t\t})\n466|\t}()\n467|\t<-entered\n468|\tobserved := make(chan TrustStore, 1)\n469|\treaderDone := make(chan error, 1)\n470|\tgo func() {\n471|\t\treaderDone <- store.WithSharedSnapshot(func(current TrustStore) error {\n472|\t\t\tobserved <- current\n473|\t\t\treturn nil\n474|\t\t})\n475|\t}()\n476|\t// The shared reader must wait for the exclusive holder: it must not\n477|\t// observe state while the transaction is still open.\n478|\tselect {\n479|\tcase <-readerDone:\n480|\t\tt.Fatal(\"WithSharedSnapshot completed while an exclusive transaction was held\")\n481|\tcase <-time.After(250 * time.Millisecond):\n482|\t}\n483|\tclose(release)\n484|\tif err := <-holderDone; err != nil {\n485|\t\tt.Fatalf(\"holder transact error = %v\", err)\n486|\t}\n487|\tif err := <-readerDone; err != nil {\n488|\t\tt.Fatalf(\"WithSharedSnapshot error = %v\", err)\n489|\t}\n490|\tcurrent := <-observed\n491|\tfresh, err := store.ReadSnapshot()\n492|\tif err != nil {\n493|\t\tt.Fatal(err)\n494|\t}\n495|\tif current.Generation != fresh.Generation {\n496|\t\tt.Fatalf(\"shared snapshot generation = %d, want %d\", current.Generation, fresh.Generation)\n497|\t}\n498|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
