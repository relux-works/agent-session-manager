{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca93","stream":{"kind":"session","id":"01a0aa74-c329-7d72-8811-c1901bb53d47"},"sequence":932,"recorded_at":1780531400001859,"record_type":"event","durability":"durable","causation_id":"e52fa573-a598-4d15-9493-65cb4f83069f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e52fa573-a598-4d15-9493-65cb4f83069f","run_stream":{"kind":"run","id":"e52fa573-a598-4d15-9493-65cb4f83069f"},"task_stream":{"kind":"task","id":"01a0aa78-be75-7a30-b52f-21015fdf41f7"},"task_id":"01a0aa78-be75-7a30-b52f-21015fdf41f7","event":{"kind":"output","task_id":"01a0aa78-be75-7a30-b52f-21015fdf41f7","chunk":"Read text file `internal/config/migration_v4_crash_test.go`.\n1|package config\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"os/exec\"\n7|\t\"path/filepath\"\n8|\t\"testing\"\n9|\t\"time\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/hosttrust\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|)\n14|\n15|// crashChildInputs rebuilds production inputs inside a re-executed crash\n16|// child: the child crashes through the real apply/rollback entry points,\n17|// never through a simulated commit.\n18|func crashChildInputs(directory string) (Inputs, string, string) {\n19|\tfilename := filepath.Join(directory, \"config.toml\")\n20|\tstate := filepath.Join(directory, \"state\")\n21|\tinputs := Inputs{Platform: scalar.PlatformMacOS, HomeDir: directory, TempDir: directory, WorkingDir: directory, Stat: os.Stat, ReadFile: os.ReadFile, LookupEnv: func(key string) (string, bool) {\n22|\t\tif key == \"AX_CONFIG\" {\n23|\t\t\treturn filename, true\n24|\t\t}\n25|\t\tif key == \"AX_STATE_DIR\" {\n26|\t\t\treturn state, true\n27|\t\t}\n28|\t\treturn \"\", false\n29|\t}}\n30|\treturn inputs, filename, state\n31|}\n32|\n33|func crashChildSelf(t *testing.T, store *hosttrust.Store) (hosttrust.Snapshot, string) {\n34|\tt.Helper()\n35|\tsnapshot, err := store.ReadSnapshot()\n36|\tif err != nil {\n37|\t\tt.Fatal(err)\n38|\t}\n39|\tvar self string\n40|\tfor _, entry := range snapshot.Trust.Entries {\n41|\t\tif entry.HostID.String() == testHostID {\n42|\t\t\tself = entry.CredentialID.String()\n43|\t\t}\n44|\t}\n45|\treturn snapshot, self\n46|}\n47|\n48|func assertChildCrashedAtSeam(t *testing.T, testName, env, directory string) {\n49|\tt.Helper()\n50|\tcommand := exec.Command(os.Args[0], \"-test.run=^\"+testName+\"$\")\n51|\tcommand.Env = append(os.Environ(), env+\"=\"+directory)\n52|\toutput, err := command.CombinedOutput()\n53|\texit, ok := err.(*exec.ExitError)\n54|\tif !ok || exit.ExitCode() != 77 {\n55|\t\tt.Fatalf(\"child did not crash at the replacement seam: %v %s\", err, output)\n56|\t}\n57|}\n58|\n59|func assertMarkerGone(t *testing.T, store *hosttrust.Store) {\n60|\tt.Helper()\n61|\tif _, err := os.Lstat(store.PendingCommitPath()); !os.IsNotExist(err) {\n62|\t\tt.Fatalf(\"joint marker remains after convergence: %v\", err)\n63|\t}\n64|}\n65|\n66|func assertMarkerKept(t *testing.T, store *hosttrust.Store) {\n67|\tt.Helper()\n68|\tif _, err := os.Lstat(store.PendingCommitPath()); err != nil {\n69|\t\tt.Fatalf(\"joint marker was removed: %v\", err)\n70|\t}\n71|}\n72|\n73|// A store opened before an apply crash converges on read: the surviving\n74|// LoadCoherent must observe the replaced Config4 with the bumped\n75|// generation, never the new bytes with the old one. A reopened store\n76|// converges identically.\n77|func TestSurvivingReaderConvergesInterruptedApply(t *testing.T) {\n78|\tif directory := os.Getenv(\"AX_V4_SURVIVING_APPLY_FIXTURE\"); directory != \"\" {\n79|\t\tinputs, filename, state := crashChildInputs(directory)\n80|\t\tstore, err := hosttrust.Open(state)\n81|\t\tif err != nil {\n82|\t\t\tt.Fatal(err)\n83|\t\t}\n84|\t\tsnapshot, self := crashChildSelf(t, store)\n85|\t\tnow := time.Now().UTC()\n86|\t\tpreview, err := PreviewV4(inputs, nil, snapshot, self, nil, now)\n87|\t\tif err != nil {\n88|\t\t\tt.Fatal(err)\n89|\t\t}\n90|\t\t_, err = applyV4(inputs, nil, preview, true, now, crashAfterReplaceFileSystem{target: filename}, hosttrust.Open)\n91|\t\tt.Fatalf(\"crash seam not reached: %v\", err)\n92|\t}\n93|\tfixture := setupV4Fixture(t, testPeerID)\n94|\tbefore := fixture.trust(t).Generation\n95|\tassertChildCrashedAtSeam(t, \"TestSurvivingReaderConvergesInterruptedApply\", \"AX_V4_SURVIVING_APPLY_FIXTURE\", fixture.directory)\n96|\tcoherent, err := LoadCoherent(fixture.inputs, nil, fixture.store)\n97|\tif err != nil {\n98|\t\tt.Fatalf(\"surviving LoadCoherent error = %v\", err)\n99|\t}\n100|\tconfiguration, ok := coherent.Config.Configuration()\n101|\tif !ok {\n102|\t\tt.Fatal(\"surviving LoadCoherent has no configuration\")\n103|\t}\n104|\tif configuration.SourceVersion != Version4 || coherent.Generation != before+1 {\n105|\t\tt.Fatalf(\"surviving reader converged to version %q generation %d, want 4.0.0/%d\", configuration.SourceVersion, coherent.Generation, before+1)\n106|\t}\n107|\tassertMarkerGone(t, fixture.store)\n108|\tloaded, err := Load(fixture.inputs, nil)\n109|\tif err != nil {\n110|\t\tt.Fatalf(\"Load after child exit 77 error = %v\", err)\n111|\t}\n112|\treloaded, ok := loaded.Configuration()\n113|\tif !ok {\n114|\t\tt.Fatal(\"Load after child exit 77 has no configuration\")\n115|\t}\n116|\treopened, err := hosttrust.Open(fixture.stateDir)\n117|\tif err != nil {\n118|\t\tt.Fatalf(\"hosttrust.Open after child exit 77 error = %v\", err)\n119|\t}\n120|\tsnapshot, err := reopened.ReadSnapshot()\n121|\tif err != nil {\n122|\t\tt.Fatalf(\"ReadSnapshot after child exit 77 error = %v\", err)\n123|\t}\n124|\tif reloaded.SourceVersion != Version4 || snapshot.Generation != before+1 {\n125|\t\tt.Fatalf(\"reopened reader converged to version %q generation %d, want 4.0.0/%d\", reloaded.SourceVersion, snapshot.Generation, before+1)\n126|\t}\n127|}\n128|\n129|// A store opened before a rollback crash converges on read: the surviving\n130|// LoadCoherent must observe the restored backup with the bumped\n131|// generation, never the restored bytes with the pre-rollback one.\n132|func TestSurvivingReaderConvergesInterruptedRollback(t *testing.T) {\n133|\tif directory := os.Getenv(\"AX_V4_SURVIVING_ROLLBACK_FIXTURE\"); directory != \"\" {\n134|\t\tinputs, filename, _ := crashChildInputs(directory)\n135|\t\t_, err := rollbackV4(inputs, nil, RollbackV4Options{AcknowledgeNoHostChannelAssurance: true}, crashAfterReplaceFileSystem{target: filename}, hosttrust.Open)\n136|\t\tt.Fatalf(\"crash seam not reached: %v\", err)\n137|\t}\n138|\tfixture := setupV4Fixture(t, testPeerID)\n139|\tpreview, err := PreviewV4(fixture.inputs, nil, fixture.trust(t), fixture.self, nil, fixture.now)\n140|\tif err != nil {\n141|\t\tt.Fatal(err)\n142|\t}\n143|\tif _, err := ApplyV4(fixture.inputs, nil, preview, true, fixture.now); err != nil {\n144|\t\tt.Fatal(err)\n145|\t}\n146|\tbefore := fixture.trust(t).Generation\n147|\tassertChildCrashedAtSeam(t, \"TestSurvivingReaderConvergesInterruptedRollback\", \"AX_V4_SURVIVING_ROLLBACK_FIXTURE\", fixture.directory)\n148|\tcoherent, err := LoadCoherent(fixture.inputs, nil, fixture.store)\n149|\tif err != nil {\n150|\t\tt.Fatalf(\"surviving LoadCoherent error = %v\", err)\n151|\t}\n152|\tconfiguration, ok := coherent.Config.Configuration()\n153|\tif !ok {\n154|\t\tt.Fatal(\"surviving LoadCoherent has no configuration\")\n155|\t}\n156|\tif configuration.SourceVersion != CurrentVersion || coherent.Generation != before+1 {\n157|\t\tt.Fatalf(\"surviving reader converged to version %q generation %d, want %s/%d\", configuration.SourceVersion, coherent.Generation, CurrentVersion, before+1)\n158|\t}\n159|\tassertMarkerGone(t, fixture.store)\n160|\treopened, err := hosttrust.Open(fixture.stateDir)\n161|\tif err != nil {\n162|\t\tt.Fatalf(\"hosttrust.Open after child exit 77 error = %v\", err)\n163|\t}\n164|\tsnapshot, err := reopened.ReadSnapshot()\n165|\tif err != nil {\n166|\t\tt.Fatalf(\"ReadSnapshot after child exit 77 error = %v\", err)\n167|\t}\n168|\tloaded, err := Load(fixture.inputs, nil)\n169|\tif err != nil {\n170|\t\tt.Fatalf(\"Load after child exit 77 error = %v\", err)\n171|\t}\n172|\treloaded, ok := loaded.Configuration()\n173|\tif !ok {\n174|\t\tt.Fatal(\"Load after child exit 77 has no configuration\")\n175|\t}\n176|\tif reloaded.SourceVersion != CurrentVersion || snapshot.Generation != before+1 {\n177|\t\tt.Fatalf(\"reopened reader converged to version %q generation %d, want %s/%d\", reloaded.SourceVersion, snapshot.Generation, CurrentVersion, before+1)\n178|\t}\n179|}\n180|\n181|// An operator edit after an apply crash matches neither the source nor the\n182|// replacement hash: the surviving LoadCoherent refuses with the marker\n183|// kept for operator resolution, and a fresh open refuses too.\n184|func TestSurvivingReaderRefusesDivergedConfig(t *testing.T) {\n185|\tif directory := os.Getenv(\"AX_V4_DIVERGED_FIXTURE\"); directory != \"\" {\n186|\t\tinputs, filename, state := crashChildInputs(directory)\n187|\t\tstore, err := hosttrust.Open(state)\n188|\t\tif err != nil {\n189|\t\t\tt.Fatal(err)\n190|\t\t}\n191|\t\tsnapshot, self := crashChildSelf(t, store)\n192|\t\tnow := time.Now().UTC()\n193|\t\tpreview, err := PreviewV4(inputs, nil, snapshot, self, nil, now)\n194|\t\tif err != nil {\n195|\t\t\tt.Fatal(err)\n196|\t\t}\n197|\t\t_, err = applyV4(inputs, nil, preview, true, now, crashAfterReplaceFileSystem{target: filename}, hosttrust.Open)\n198|\t\tt.Fatalf(\"crash seam not reached: %v\", err)\n199|\t}\n200|\tfixture := setupV4Fixture(t, testPeerID)\n201|\tassertChildCrashedAtSeam(t, \"TestSurvivingReaderRefusesDivergedConfig\", \"AX_V4_DIVERGED_FIXTURE\", fixture.directory)\n202|\tif err := os.WriteFile(fixture.filename, []byte(\"# operator edit after crash\\n\"), 0o600); err != nil {\n203|\t\tt.Fatal(err)\n204|\t}\n205|\tif coherent, err := LoadCoherent(fixture.inputs, nil, fixture.store); err == nil {\n206|\t\tt.Fatalf(\"surviving LoadCoherent(diverged) admitted generation %d, want refusal\", coherent.Generation)\n207|\t} else if !errors.Is(err, hosttrust.ErrJointIntervened) {\n208|\t\tt.Fatalf(\"surviving LoadCoherent error = %v, want ErrJointIntervened\", err)\n209|\t}\n210|\tassertMarkerKept(t, fixture.store)\n211|\tif _, err := hosttrust.Open(fixture.stateDir); err == nil {\n212|\t\tt.Fatal(\"hosttrust.Open(diverged) succeeded, want refusal\")\n213|\t} else if !errors.Is(err, hosttrust.ErrJointIntervened) {\n214|\t\tt.Fatalf(\"hosttrust.Open error = %v, want ErrJointIntervened\", err)\n215|\t}\n216|}","final_result":true}}}
