nt=$(find internal -name '*.go' | wc -l | tr -d ' '); echo \\\"go files scanned: $count\\\"\\ngofmt -l internal > $G/gofmt.log 2>&1; echo \\\"gofmt exit=$?\\\"; test ! -s $G/gofmt.log && echo \\\"gofmt clean\\\" || cat $G/gofmt.log\\necho \\\"=== diff check ===\\\"\\ngit diff --check; echo \\\"diff-check exit=$?\\\"\",\n  \"description\": \"Run contract lint gates locally\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"=== tracecheck ===\\ntracecheck exit=0\\ntraceability ok: contracts=63 normative_sections=36 acceptance_cases=101 fixtures=32 compatibility_contracts=55 assigned_scopes=0\\nsection coverage: bindings=56 full=1 partial=3 sliver=1 unevidenced=48 unmeasured=3 unowned=12 clauses_discharged=17/463\\n=== catalog freshness ===\\ndirective pin ok\\ngenerate exit=0\\ncatalog diff exit=0 (0=clean)\\n(empty above means no collateral)\\n=== cigate contracts ===\\ncontracts exit=0\\nPASS TestVerifyContractPreservationLive\\nPASS TestPinnedReleasesAgreeAcrossAuthorities\\nPASS TestDerivedSetsAreComplete\\nPASS TestCheckAgreementAdmitsIdenticalSets\\nPASS TestCheckAgreementRefusals\\nPASS TestCheckReleaseRootsRefusesDrift\\n=== gofmt gate ===\\ngo files scanned: 413\\ngofmt exit=0\\ngofmt clean\\n=== diff check ===\\ndiff-check exit=0\\n\",\n  \"original_output_bytes\": 788,\n  \"original_output_tokens\": 197,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
