{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8ab","stream":{"kind":"session","id":"01a0aa74-c329-7d72-8811-c1901bb53d47"},"sequence":688,"recorded_at":1780531400001371,"record_type":"event","durability":"durable","causation_id":"e52fa573-a598-4d15-9493-65cb4f83069f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e52fa573-a598-4d15-9493-65cb4f83069f","run_stream":{"kind":"run","id":"e52fa573-a598-4d15-9493-65cb4f83069f"},"task_stream":{"kind":"task","id":"01a0aa77-2dab-70c3-9da7-c537924ce572"},"task_id":"01a0aa77-2dab-70c3-9da7-c537924ce572","event":{"kind":"output","task_id":"01a0aa77-2dab-70c3-9da7-c537924ce572","chunk":"Read text file `internal/hosttrust/joint.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"crypto/sha256\"\n6|\t\"encoding/hex\"\n7|\t\"encoding/json\"\n8|\t\"errors\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\t\"strconv\"\n12|)\n13|\n14|// pendingCommitFileName is the durable intent marker for one joint\n15|// config-plus-trust commit. It lives beside trust.json under the same\n16|// owner-only custody and crash-durable write discipline.\n17|const pendingCommitFileName = \"pending-commit.json\"\n18|\n19|// Joint operations coupled to a trust generation bump.\n20|const (\n21|\tJointApplyV4    = \"apply-v4\"\n22|\tJointRollbackV4 = \"rollback-v4\"\n23|)\n24|\n25|// PendingCommit is the durable intent record for one joint commit. The\n26|// hashes pin the exact configuration bytes the operator confirmed; the\n27|// source generation pins the trust state they were rendered against. Only\n28|// the confirmed replacement may complete forward; anything else aborts or\n29|// refuses on restart.\n30|type PendingCommit struct {\n31|\tSchema            string `json:\"schema\"`\n32|\tSchemaVersion     string `json:\"schema_version\"`\n33|\tOperation         string `json:\"operation\"`\n34|\tConfigPath        string `json:\"config_path\"`\n35|\tSourceSHA256      string `json:\"source_sha256\"`\n36|\tReplacementSHA256 string `json:\"replacement_sha256\"`\n37|\tSourceGeneration  uint64 `json:\"source_generation\"`\n38|\tBackupPath        string `json:\"backup_path\"`\n39|}\n40|\n41|// SHA256HexOf returns the lowercase hex SHA-256 of document bytes for\n42|// marker pins. It exposes no key material: markers pin configuration bytes\n43|// only, never credentials.\n44|func SHA256HexOf(document []byte) string {\n45|\tdigest := sha256.Sum256(document)\n46|\treturn hex.EncodeToString(digest[:])\n47|}\n48|\n49|func encodePendingCommit(marker PendingCommit) ([]byte, error) {\n50|\tif err := checkPendingCommit(marker); err != nil {\n51|\t\treturn nil, err\n52|\t}\n53|\tdocument, err := json.Marshal(marker)\n54|\tif err != nil {\n55|\t\treturn nil, trustError(TrustError{Operation: \"encode joint commit\", Err: errors.Join(ErrTrustDurability, err)})\n56|\t}\n57|\treturn document, nil\n58|}\n59|\n60|func checkPendingCommit(marker PendingCommit) error {\n61|\tconst operation = \"validate joint commit\"\n62|\tif marker.Schema != \"urn:ax:schema:host-pending-commit\" || marker.SchemaVersion != \"1.0.0\" {\n63|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n64|\t}\n65|\tif marker.Operation != JointApplyV4 && marker.Operation != JointRollbackV4 {\n66|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n67|\t}\n68|\tif !filepath.IsAbs(marker.ConfigPath) || marker.BackupPath == \"\" {\n69|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n70|\t}\n71|\tfor _, digest := range []string{marker.SourceSHA256, marker.ReplacementSHA256} {\n72|\t\traw, err := hex.DecodeString(digest)\n73|\t\tif err != nil || len(raw) != sha256.Size {\n74|\t\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n75|\t\t}\n76|\t}\n77|\tif marker.SourceSHA256 == marker.ReplacementSHA256 {\n78|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n79|\t}\n80|\tif marker.SourceGeneration == 0 || marker.SourceGeneration > MaxGeneration {\n81|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n82|\t}\n83|\treturn nil\n84|}\n85|\n86|func decodePendingCommit(document []byte) (PendingCommit, error) {\n87|\tvar marker PendingCommit\n88|\tif err := rejectDuplicateKeys(document); err != nil {\n89|\t\treturn PendingCommit{}, err\n90|\t}\n91|\t// The generation must be a bare JSON number, never a quoted string:\n92|\t// validate it through the same uint53 discipline as the trust document\n93|\t// before the struct decode, so a quoted number refuses as invalid\n94|\t// state rather than as a syntax error.\n95|\traw := map[string]json.RawMessage{}\n96|\tdecoder := json.NewDecoder(bytes.NewReader(document))\n97|\tdecoder.UseNumber()\n98|\tif err := decoder.Decode(&raw); err != nil {\n99|\t\treturn PendingCommit{}, trustError(TrustError{Operation: \"decode joint commit\", Err: errors.Join(ErrTrustDecode, err)})\n100|\t}\n101|\tgeneration, err := decodeMarkerGeneration(raw)\n102|\tif err != nil {\n103|\t\treturn PendingCommit{}, err\n104|\t}\n105|\tdecoder = json.NewDecoder(bytes.NewReader(document))\n106|\tdecoder.DisallowUnknownFields()\n107|\tdecoder.UseNumber()\n108|\tif err := decoder.Decode(&marker); err != nil {\n109|\t\treturn PendingCommit{}, trustError(TrustError{Operation: \"decode joint commit\", Err: errors.Join(ErrTrustDecode, err)})\n110|\t}\n111|\tif decoder.More() {\n112|\t\treturn PendingCommit{}, trustError(TrustError{Operation: \"decode joint commit\", Err: ErrTrustDecode})\n113|\t}\n114|\tmarker.SourceGeneration = generation\n115|\tif err := checkPendingCommit(marker); err != nil {\n116|\t\treturn PendingCommit{}, err\n117|\t}\n118|\treturn marker, nil\n119|}\n120|\n121|func parseUint53(text string) (uint64, error) {\n122|\tif text == \"\" {\n123|\t\treturn 0, errors.New(\"empty generation number\")\n124|\t}\n125|\tfor _, digit := range text {\n126|\t\tif digit < '0' || digit > '9' {\n127|\t\t\treturn 0, errors.New(\"non-digit generation number\")\n128|\t\t}\n129|\t}\n130|\tparsed, err := strconv.ParseUint(text, 10, 64)\n131|\tif err != nil {\n132|\t\treturn 0, err\n133|\t}\n134|\tif parsed == 0 || parsed > MaxGeneration {\n135|\t\treturn 0, errors.New(\"generation outside uint53\")\n136|\t}\n137|\treturn parsed, nil\n138|}\n139|\n140|func decodeMarkerGeneration(shape map[string]json.RawMessage) (uint64, error) {\n141|\traw, ok := shape[\"source_generation\"]\n142|\tif !ok {\n143|\t\treturn 0, trustError(TrustError{Operation: \"decode joint generation\", Err: ErrTrustValidation})\n144|\t}\n145|\tvar value any\n146|\tif err := strictJSONDecoder(raw).Decode(&value); err != nil {\n147|\t\treturn 0, trustError(TrustError{Operation: \"decode joint generation\", Err: errors.Join(ErrTrustDecode, err)})\n148|\t}\n149|\tnumber, ok := value.(json.Number)\n150|\tif !ok {\n151|\t\treturn 0, trustError(TrustError{Operation: \"decode joint generation\", Err: ErrTrustValidation})\n152|\t}\n153|\tparsed, err := parseUint53(number.String())\n154|\tif err != nil {\n155|\t\treturn 0, trustError(TrustError{Operation: \"decode joint generation\", Err: ErrTrustValidation})\n156|\t}\n157|\treturn parsed, nil\n158|}\n159|\n160|// JointCommit runs one crash-atomic authorization-generation commit coupled\n161|// to an external durable replacement (Configuration 4.0.0 apply or\n162|// rollback). Under a single exclusive hold it converges any leftover\n163|// intent, revalidates the confirmed pins against committed trust, stages\n164|// the durable intent marker, runs replace (the configuration file\n165|// replacement), bumps the generation, and removes the marker.\n166|//\n167|//   - Leftover intent from a crashed commit converges first: a marker the\n168|//     replacement committed completes forward (moving the generation, so\n169|//     stale markers still refuse below); an unreplaced marker aborts. A\n170|//     refused leftover fails the commit with the marker kept.\n171|//   - revalidate runs inside the lock: the preview, source and generation\n172|//     checks it repeats there close the concurrent-change window between\n173|//     the unlocked fast-fail checks and the commit.\n174|//   - A replace failure aborts with no generation change; the marker is\n175|//     removed because the configuration is untouched.\n176|//   - A trust-commit failure after replace keeps the marker: the caller\n177|//     must restore the source bytes, then call Recover, which observes the\n178|//     source hash and aborts cleanly. If the restore itself fails the\n179|//     marker stays for operator resolution and the joint error reports it.\n180|//   - Marker-removal failure after a durable bump still returns success:\n181|//     the joint state is already forward-complete, and the next converged\n182|//     read or open removes the marker.\n183|//\n184|// Only process crashes are covered by the restart protocol below; power\n185|// loss additionally depends on the disk honoring fsync, which no test here\n186|// can establish. Crash tests terminate a real child process at the\n187|// replacement seam and re-read through surviving and reopened stores.\n188|func (store *Store) JointCommit(marker PendingCommit, revalidate func(current TrustStore) error, replace func() error) (uint64, error) {\n189|\tconst operation = \"joint commit\"\n190|\tif revalidate == nil || replace == nil {\n191|\t\treturn 0, trustError(TrustError{Operation: operation, Err: ErrTrustDurability})\n192|\t}\n193|\tunlock, err := store.lock.exclusive()\n194|\tif err != nil {\n195|\t\treturn 0, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustDurability, err)})\n196|\t}\n197|\tdefer unlock()\n198|\tif err := convergeLocked(store.fs, store.root); err != nil {\n199|\t\treturn 0, err\n200|\t}\n201|\tcommitted, err := loadCommitted(store.fs, store.root)\n202|\tif err != nil {\n203|\t\treturn 0, err\n204|\t}\n205|\tif err := revalidate(committed); err != nil {\n206|\t\treturn 0, err\n207|\t}\n208|\tif marker.SourceGeneration != committed.Generation {\n209|\t\treturn 0, trustError(TrustError{Operation: operation, Err: ErrStaleGeneration})\n210|\t}\n211|\tif err := checkPendingCommit(marker); err != nil {\n212|\t\treturn 0, err\n213|\t}\n214|\tif _, err := store.fs.Lstat(pendingPath(store.root)); err == nil {\n215|\t\treturn 0, trustError(TrustError{Operation: operation, Err: ErrJointIntervened})\n216|\t} else if !os.IsNotExist(err) {\n217|\t\treturn 0, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n218|\t}\n219|\tencoded, err := encodePendingCommit(marker)\n220|\tif err != nil {\n221|\t\treturn 0, err\n222|\t}\n223|\tif err := commitDocument(store.fs, store.root, pendingPath(store.root), encoded); err != nil {\n224|\t\treturn 0, err\n225|\t}\n226|\tif err := replace(); err != nil {\n227|\t\t_ = removeMarkerLocked(store.fs, store.root)\n228|\t\treturn 0, err\n229|\t}\n230|\tvar generation uint64\n231|\tif err := transactLocked(store.fs, store.root, func(trust *TrustStore) error {\n232|\t\tgeneration = trust.Generation + 1\n233|\t\treturn nil\n234|\t}); err != nil {\n235|\t\treturn 0, trustError(TrustError{Operation: \"commit joint generation\", Err: errors.Join(ErrJointReplacementDurable, err)})\n236|\t}\n237|\t// The replacement and the bump are both durable: converge the marker\n238|\t// removal on next open when this cleanup itself is interrupted.\n239|\t_ = removeMarkerLocked(store.fs, store.root)\n240|\treturn generation, nil\n241|}\n242|\n243|// RecoverResult reports what one recovery pass found.\n244|type RecoverResult struct {\n245|\t// Found reports a marker was present at all.\n246|\tFound bool\n247|\t// Completed reports the replacement had committed and the generation\n248|\t// converged forward to source plus one (or already had).\n249|\tCompleted bool\n250|\t// Aborted reports the replacement had not committed: the marker was\n251|\t// removed with no generation change.\n252|\tAborted bool\n253|}\n254|\n255|// Recover converges one interrupted joint commit found on disk. It runs\n256|// automatically on Open and after a caller-restored source, and is safe to\n257|// call directly. Every other read, admission and transaction entry point\n258|// converges through the same logic before exposing a snapshot (see\n259|// convergeLocked), so surviving processes converge exactly like reopened\n260|// ones:\n261|//\n262|//   - configuration equal to the replacement hash completes forward: a\n263|//     trust at the source generation bumps to source plus one; a trust\n264|//     already there only removes the marker.\n265|//   - configuration equal to the source hash aborts: the marker is removed\n266|//     with no generation change.\n267|//   - anything else (operator edit mid-flight, unreadable state) refuses\n268|//     and keeps the marker for operator resolution.\n269|//\n270|// A refused recovery fails the caller, so no reader can silently admit new\n271|// configuration with an old generation.\n272|func (store *Store) Recover() (RecoverResult, error) {\n273|\tunlock, err := store.lock.exclusive()\n274|\tif err != nil {\n275|\t\treturn RecoverResult{}, trustError(TrustError{Operation: \"recover joint commit\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n276|\t}\n277|\tdefer unlock()\n278|\treturn recoverLocked(store.fs, store.root)\n279|}\n280|\n281|func recoverLocked(filesystem FileSystem, root string) (RecoverResult, error) {\n282|\tconst operation = \"recover joint commit\"\n283|\tpath := pendingPath(root)\n284|\tif _, err := filesystem.Lstat(path); err != nil {\n285|\t\tif os.IsNotExist(err) {\n286|\t\t\treturn RecoverResult{}, nil\n287|\t\t}\n288|\t\treturn RecoverResult{}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n289|\t}\n290|\tinfo, err := filesystem.Lstat(path)\n291|\tif err != nil {\n292|\t\treturn RecoverResult{}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n293|\t}\n294|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n295|\t\treturn RecoverResult{}, err\n296|\t}\n297|\tdocument, err := filesystem.ReadFile(path)\n298|\tif err != nil {\n299|\t\treturn RecoverResult{}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n300|\t}\n301|\tmarker, err := decodePendingCommit(document)\n302|\tif err != nil {\n303|\t\treturn RecoverResult{Found: true}, err\n304|\t}\n305|\tconfiguration, err := filesystem.ReadFile(marker.ConfigPath)\n306|\tif err != nil {\n307|\t\treturn RecoverResult{Found: true}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n308|\t}\n309|\tswitch SHA256HexOf(configuration) {\n310|\tcase marker.ReplacementSHA256:\n311|\t\tcommitted, err := loadCommitted(filesystem, root)\n312|\t\tif err != nil {\n313|\t\t\treturn RecoverResult{Found: true}, err\n314|\t\t}\n315|\t\tswitch committed.Generation {\n316|\t\tcase marker.SourceGeneration:\n317|\t\t\tif err := transactLocked(filesystem, root, func(*TrustStore) error { return nil }); err != nil {\n318|\t\t\t\treturn RecoverResult{Found: true}, err\n319|\t\t\t}\n320|\t\tcase marker.SourceGeneration + 1:\n321|\t\tdefault:\n322|\t\t\treturn RecoverResult{Found: true}, trustError(TrustError{Operation: operation, Err: ErrJointIntervened})\n323|\t\t}\n324|\t\tif err := removeMarkerLocked(filesystem, root); err != nil {\n325|\t\t\treturn RecoverResult{Found: true}, err\n326|\t\t}\n327|\t\treturn RecoverResult{Found: true, Completed: true}, nil\n328|\tcase marker.SourceSHA256:\n329|\t\tif err := removeMarkerLocked(filesystem, root); err != nil {\n330|\t\t\treturn RecoverResult{Found: true}, err\n331|\t\t}\n332|\t\treturn RecoverResult{Found: true, Aborted: true}, nil\n333|\tdefault:\n334|\t\treturn RecoverResult{Found: true}, trustError(TrustError{Operation: operation, Err: ErrJointIntervened})\n335|\t}\n336|}\n337|\n338|func pendingPath(root string) string { return filepath.Join(root, pendingCommitFileName) }\n339|\n340|// markerPresent reports whether a joint-commit intent marker is\n341|// outstanding. Absence must be established, never assumed: an unreadable\n342|// marker path refuses instead of reporting no marker.\n343|func markerPresent(filesystem FileSystem, root string) (bool, error) {\n344|\t_, err := filesystem.Lstat(pendingPath(root))\n345|\tif err == nil {\n346|\t\treturn true, nil\n347|\t}\n348|\tif os.IsNotExist(err) {\n349|\t\treturn false, nil\n350|\t}\n351|\treturn false, trustError(TrustError{Operation: \"inspect joint commit\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n352|}\n353|\n354|// convergeLocked converges one interrupted joint commit, if any, before\n355|// the caller exposes a snapshot or runs a boundary. It is the general\n356|// admission barrier for pending intent: every read, admission and\n357|// transaction entry point converges here under the authorization lock,\n358|// while recovery itself stays the single convergence implementation. The\n359|// caller must hold the exclusive lock: convergence can bump the generation\n360|// and remove the marker. Shared-lock readers upgrade to exclusive when a\n361|// marker is present (see readSnapshot); when no marker is present the\n362|// shared fast path needs no write. A refused recovery fails the caller\n363|// with the marker kept for operator resolution.\n364|func convergeLocked(filesystem FileSystem, root string) error {\n365|\tpresent, err := markerPresent(filesystem, root)\n366|\tif err != nil {\n367|\t\treturn err\n368|\t}\n369|\tif !present {\n370|\t\treturn nil\n371|\t}\n372|\t_, err = recoverLocked(filesystem, root)\n373|\treturn err\n374|}\n375|\n376|func removeMarkerLocked(filesystem FileSystem, root string) error {\n377|\tif err := filesystem.Remove(pendingPath(root)); err != nil && !os.IsNotExist(err) {\n378|\t\treturn trustError(TrustError{Operation: \"remove joint marker\", Err: errors.Join(ErrTrustDurability, err)})\n379|\t}\n380|\tif err := syncDir(filesystem, root); err != nil {\n381|\t\treturn trustError(TrustError{Operation: \"sync joint marker directory\", Err: errors.Join(ErrTrustDurability, err)})\n382|\t}\n383|\treturn nil\n384|}","final_result":true}}}
