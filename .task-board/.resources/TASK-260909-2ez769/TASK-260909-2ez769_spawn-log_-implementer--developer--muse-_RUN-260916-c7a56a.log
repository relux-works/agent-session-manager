{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8af","stream":{"kind":"session","id":"01a0aba0-7282-7543-b2c1-245c5391567d"},"sequence":690,"recorded_at":1780531400001375,"record_type":"event","durability":"durable","causation_id":"3cb3b2c5-dd67-49c0-a2b1-aadb0810f3b1","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3cb3b2c5-dd67-49c0-a2b1-aadb0810f3b1","run_stream":{"kind":"run","id":"3cb3b2c5-dd67-49c0-a2b1-aadb0810f3b1"},"task_stream":{"kind":"task","id":"01a0aba2-f24a-7132-9441-b05e1362bcd4"},"task_id":"01a0aba2-f24a-7132-9441-b05e1362bcd4","event":{"kind":"output","task_id":"01a0aba2-f24a-7132-9441-b05e1362bcd4","chunk":"Read text file `internal/hosttrust/joint.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"crypto/sha256\"\n6|\t\"encoding/hex\"\n7|\t\"encoding/json\"\n8|\t\"errors\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\t\"strconv\"\n12|)\n13|\n14|// pendingCommitFileName is the durable intent marker for one joint\n15|// config-plus-trust commit. It lives beside trust.json under the same\n16|// owner-only custody and crash-durable write discipline.\n17|const pendingCommitFileName = \"pending-commit.json\"\n18|\n19|// Joint operations coupled to a trust generation bump.\n20|const (\n21|\tJointApplyV4    = \"apply-v4\"\n22|\tJointRollbackV4 = \"rollback-v4\"\n23|)\n24|\n25|// PendingCommit is the durable intent record for one joint commit. The\n26|// hashes pin the exact configuration bytes the operator confirmed; the\n27|// source generation pins the trust state they were rendered against. Only\n28|// the confirmed replacement may complete forward; anything else aborts or\n29|// refuses on restart.\n30|type PendingCommit struct {\n31|\tSchema            string `json:\"schema\"`\n32|\tSchemaVersion     string `json:\"schema_version\"`\n33|\tOperation         string `json:\"operation\"`\n34|\tConfigPath        string `json:\"config_path\"`\n35|\tSourceSHA256      string `json:\"source_sha256\"`\n36|\tReplacementSHA256 string `json:\"replacement_sha256\"`\n37|\tSourceGeneration  uint64 `json:\"source_generation\"`\n38|\tBackupPath        string `json:\"backup_path\"`\n39|}\n40|\n41|// SHA256HexOf returns the lowercase hex SHA-256 of document bytes for\n42|// marker pins. It exposes no key material: markers pin configuration bytes\n43|// only, never credentials.\n44|func SHA256HexOf(document []byte) string {\n45|\tdigest := sha256.Sum256(document)\n46|\treturn hex.EncodeToString(digest[:])\n47|}\n48|\n49|func encodePendingCommit(marker PendingCommit) ([]byte, error) {\n50|\tif err := checkPendingCommit(marker); err != nil {\n51|\t\treturn nil, err\n52|\t}\n53|\tdocument, err := json.Marshal(marker)\n54|\tif err != nil {\n55|\t\treturn nil, trustError(TrustError{Operation: \"encode joint commit\", Err: errors.Join(ErrTrustDurability, err)})\n56|\t}\n57|\treturn document, nil\n58|}\n59|\n60|func checkPendingCommit(marker PendingCommit) error {\n61|\tconst operation = \"validate joint commit\"\n62|\tif marker.Schema != \"urn:ax:schema:host-pending-commit\" || marker.SchemaVersion != \"1.0.0\" {\n63|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n64|\t}\n65|\tif marker.Operation != JointApplyV4 && marker.Operation != JointRollbackV4 {\n66|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n67|\t}\n68|\tif !filepath.IsAbs(marker.ConfigPath) || marker.BackupPath == \"\" {\n69|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n70|\t}\n71|\tfor _, digest := range []string{marker.SourceSHA256, marker.ReplacementSHA256} {\n72|\t\traw, err := hex.DecodeString(digest)\n73|\t\tif err != nil || len(raw) != sha256.Size {\n74|\t\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n75|\t\t}\n76|\t}\n77|\tif marker.SourceSHA256 == marker.ReplacementSHA256 {\n78|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n79|\t}\n80|\tif marker.SourceGeneration == 0 || marker.SourceGeneration > MaxGeneration {\n81|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n82|\t}\n83|\treturn nil\n84|}\n85|\n86|func decodePendingCommit(document []byte) (PendingCommit, error) {\n87|\tvar marker PendingCommit\n88|\tif err := rejectDuplicateKeys(document); err != nil {\n89|\t\treturn PendingCommit{}, err\n90|\t}\n91|\t// The generation must be a bare JSON number, never a quoted string:\n92|\t// validate it through the same uint53 discipline as the trust document\n93|\t// before the struct decode, so a quoted number refuses as invalid\n94|\t// state rather than as a syntax error.\n95|\traw := map[string]json.RawMessage{}\n96|\tdecoder := json.NewDecoder(bytes.NewReader(document))\n97|\tdecoder.UseNumber()\n98|\tif err := decoder.Decode(&raw); err != nil {\n99|\t\treturn PendingCommit{}, trustError(TrustError{Operation: \"decode joint commit\", Err: errors.Join(ErrTrustDecode, err)})\n100|\t}\n101|\tgeneration, err := decodeMarkerGeneration(raw)\n102|\tif err != nil {\n103|\t\treturn PendingCommit{}, err\n104|\t}\n105|\tdecoder = json.NewDecoder(bytes.NewReader(document))\n106|\tdecoder.DisallowUnknownFields()\n107|\tdecoder.UseNumber()\n108|\tif err := decoder.Decode(&marker); err != nil {\n109|\t\treturn PendingCommit{}, trustError(TrustError{Operation: \"decode joint commit\", Err: errors.Join(ErrTrustDecode, err)})\n110|\t}\n111|\tif decoder.More() {\n112|\t\treturn PendingCommit{}, trustError(TrustError{Operation: \"decode joint commit\", Err: ErrTrustDecode})\n113|\t}\n114|\tmarker.SourceGeneration = generation\n115|\tif err := checkPendingCommit(marker); err != nil {\n116|\t\treturn PendingCommit{}, err\n117|\t}\n118|\treturn marker, nil\n119|}\n120|\n121|func parseUint53(text string) (uint64, error) {\n122|\tif text == \"\" {\n123|\t\treturn 0, errors.New(\"empty generation number\")\n124|\t}\n125|\tfor _, digit := range text {\n126|\t\tif digit < '0' || digit > '9' {\n127|\t\t\treturn 0, errors.New(\"non-digit generation number\")\n128|\t\t}\n129|\t}\n130|\tparsed, err := strconv.ParseUint(text, 10, 64)\n131|\tif err != nil {\n132|\t\treturn 0, err\n133|\t}\n134|\tif parsed == 0 || parsed > MaxGeneration {\n135|\t\treturn 0, errors.New(\"generation outside uint53\")\n136|\t}\n137|\treturn parsed, nil\n138|}\n139|\n140|func decodeMarkerGeneration(shape map[string]json.RawMessage) (uint64, error) {\n141|\traw, ok := shape[\"source_generation\"]\n142|\tif !ok {\n143|\t\treturn 0, trustError(TrustError{Operation: \"decode joint generation\", Err: ErrTrustValidation})\n144|\t}\n145|\tvar value any\n146|\tif err := strictJSONDecoder(raw).Decode(&value); err != nil {\n147|\t\treturn 0, trustError(TrustError{Operation: \"decode joint generation\", Err: errors.Join(ErrTrustDecode, err)})\n148|\t}\n149|\tnumber, ok := value.(json.Number)\n150|\tif !ok {\n151|\t\treturn 0, trustError(TrustError{Operation: \"decode joint generation\", Err: ErrTrustValidation})\n152|\t}\n153|\tparsed, err := parseUint53(number.String())\n154|\tif err != nil {\n155|\t\treturn 0, trustError(TrustError{Operation: \"decode joint generation\", Err: ErrTrustValidation})\n156|\t}\n157|\treturn parsed, nil\n158|}\n159|\n160|// JointCommit runs one crash-atomic authorization-generation commit coupled\n161|// to an external durable replacement (Configuration 4.0.0 apply or\n162|// rollback). Under a single exclusive hold it converges any leftover\n163|// intent, revalidates the confirmed pins against committed trust, stages\n164|// the durable intent marker, runs replace (the configuration file\n165|// replacement), bumps the generation, and removes the marker.\n166|//\n167|//   - Leftover intent from a crashed commit converges first: a marker the\n168|//     replacement committed completes forward (moving the generation, so\n169|//     stale markers still refuse below); an unreplaced marker aborts. A\n170|//     refused leftover fails the commit with the marker kept.\n171|//   - revalidate runs inside the lock: the preview, source and generation\n172|//     checks it repeats there close the concurrent-change window between\n173|//     the unlocked fast-fail checks and the commit.\n174|//   - A replace failure aborts with no generation change; the marker is\n175|//     removed because the configuration is untouched.\n176|//   - A trust-commit failure after replace compensates under the same\n177|//     hold: the marker and the configuration are revalidated against the\n178|//     confirmed pins, restore reinstalls the source bytes, and the marker\n179|//     aborts with no generation change. Compensation never releases the\n180|//     hold, so no surviving reader, writer or held boundary can converge\n181|//     the replacement between the failure and the restore. A compensation\n182|//     that cannot complete keeps the marker for operator resolution and\n183|//     joins ErrJointCompensationFailed. The committed trust itself is never\n184|//     re-read for the decision: the fault that broke the bump (for example\n185|//     failed custody) must not break the abort, and an apparently durable\n186|//     bump is still unproven exactly because its commit reported failure.\n187|//   - Marker-removal failure after a durable bump still returns success:\n188|//     the joint state is already forward-complete, and the next converged\n189|//     read or open removes the marker.\n190|//\n191|// Only process crashes are covered by the restart protocol below; power\n192|// loss additionally depends on the disk honoring fsync, which no test here\n193|// can establish. Crash tests terminate a real child process at the\n194|// replacement seam and re-read through surviving and reopened stores.\n195|func (store *Store) JointCommit(marker PendingCommit, revalidate func(current TrustStore) error, replace func() error, restore func() error) (uint64, error) {\n196|\tconst operation = \"joint commit\"\n197|\tif revalidate == nil || replace == nil || restore == nil {\n198|\t\treturn 0, trustError(TrustError{Operation: operation, Err: ErrTrustDurability})\n199|\t}\n200|\tunlock, err := store.lock.exclusive()\n201|\tif err != nil {\n202|\t\treturn 0, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustDurability, err)})\n203|\t}\n204|\tdefer unlock()\n205|\tif err := convergeLocked(store.fs, store.root); err != nil {\n206|\t\treturn 0, err\n207|\t}\n208|\tcommitted, err := loadCommitted(store.fs, store.root)\n209|\tif err != nil {\n210|\t\treturn 0, err\n211|\t}\n212|\tif err := revalidate(committed); err != nil {\n213|\t\treturn 0, err\n214|\t}\n215|\tif marker.SourceGeneration != committed.Generation {\n216|\t\treturn 0, trustError(TrustError{Operation: operation, Err: ErrStaleGeneration})\n217|\t}\n218|\tif err := checkPendingCommit(marker); err != nil {\n219|\t\treturn 0, err\n220|\t}\n221|\tif _, err := store.fs.Lstat(pendingPath(store.root)); err == nil {\n222|\t\treturn 0, trustError(TrustError{Operation: operation, Err: ErrJointIntervened})\n223|\t} else if !os.IsNotExist(err) {\n224|\t\treturn 0, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n225|\t}\n226|\tencoded, err := encodePendingCommit(marker)\n227|\tif err != nil {\n228|\t\treturn 0, err\n229|\t}\n230|\tif err := commitDocument(store.fs, store.root, pendingPath(store.root), encoded); err != nil {\n231|\t\treturn 0, err\n232|\t}\n233|\tif err := replace(); err != nil {\n234|\t\t_ = removeMarkerLocked(store.fs, store.root)\n235|\t\treturn 0, err\n236|\t}\n237|\tvar generation uint64\n238|\tif err := transactLocked(store.fs, store.root, func(trust *TrustStore) error {\n239|\t\tgeneration = trust.Generation + 1\n240|\t\treturn nil\n241|\t}); err != nil {\n242|\t\treturn 0, compensateLocked(store.fs, store.root, marker, err, restore)\n243|\t}\n244|\t// The replacement and the bump are both durable: converge the marker\n245|\t// removal on next open when this cleanup itself is interrupted.\n246|\t_ = removeMarkerLocked(store.fs, store.root)\n247|\treturn generation, nil\n248|}\n249|\n250|// compensateLocked converges a joint commit whose replacement is durable\n251|// but whose generation bump failed with commitErr. The caller must hold\n252|// the exclusive authorization lock across the whole compensation: the\n253|// marker and the configuration are revalidated against the confirmed\n254|// intent, restore reinstalls the source bytes, and the marker aborts with\n255|// no generation change. Because the hold never lapses, no surviving\n256|// reader, writer or held boundary can converge the replacement between\n257|// the failure and the restore; the only way out is the clean abort or a\n258|// refused compensation with the marker kept.\n259|//\n260|//   - The marker is re-read and compared pin-for-pin with the staged\n261|//     intent: no in-protocol path changes it under the hold, so a\n262|//     mismatch, an undecodable marker or an unreadable marker path is an\n263|//     intervention that refuses with the marker kept. A vanished marker\n264|//     is the operator/sabotage remainder: the in-memory intent still pins\n265|//     the decision, and the marker is re-staged when the configuration\n266|//     matches neither pin so restart recovery resolves the pair instead\n267|//     of admitting it silently.\n268|//   - Configuration equal to the replacement hash runs restore, whose\n269|//     result is verified against the source hash before the marker\n270|//     aborts: a restore that reports success without reinstalling the\n271|//     source refuses as an intervention. Configuration already equal to\n272|//     the source hash aborts without running the restore.\n273|//   - A restore failure, an unreadable configuration, or configuration\n274|//     matching neither pin keeps the marker for operator resolution and\n275|//     joins ErrJointCompensationFailed. The configuration then stays at\n276|//     the replacement, which restart recovery completes forward once the\n277|//     underlying fault heals.\n278|func compensateLocked(filesystem FileSystem, root string, intent PendingCommit, commitErr error, restore func() error) error {\n279|\tconst operation = \"compensate joint commit\"\n280|\tfailed := func(cause error) error {\n281|\t\treturn trustError(TrustError{Operation: operation, Err: errors.Join(ErrJointReplacementDurable, ErrJointCompensationFailed, commitErr, cause)})\n282|\t}\n283|\treread, present, err := readCompensationMarker(filesystem, root)\n284|\tif err != nil {\n285|\t\treturn failed(err)\n286|\t}\n287|\tif present && reread != intent {\n288|\t\treturn failed(trustError(TrustError{Operation: \"validate joint marker\", Err: ErrJointIntervened}))\n289|\t}\n290|\tconfiguration, err := filesystem.ReadFile(intent.ConfigPath)\n291|\tif err != nil {\n292|\t\treturn failed(trustError(TrustError{Operation: \"read joint configuration\", Err: errors.Join(ErrTrustStoreUnreadable, err)}))\n293|\t}\n294|\tswitch SHA256HexOf(configuration) {\n295|\tcase intent.ReplacementSHA256:\n296|\t\tif err := restore(); err != nil {\n297|\t\t\treturn failed(err)\n298|\t\t}\n299|\t\trestored, err := filesystem.ReadFile(intent.ConfigPath)\n300|\t\tif err != nil {\n301|\t\t\treturn failed(trustError(TrustError{Operation: \"read joint configuration\", Err: errors.Join(ErrTrustStoreUnreadable, err)}))\n302|\t\t}\n303|\t\tif SHA256HexOf(restored) != intent.SourceSHA256 {\n304|\t\t\treturn failed(trustError(TrustError{Operation: \"validate joint restore\", Err: ErrJointIntervened}))\n305|\t\t}\n306|\tcase intent.SourceSHA256:\n307|\t\t// The replacement never landed: abort without running the\n308|\t\t// restore, which would only rewrite identical bytes.\n309|\tdefault:\n310|\t\tif !present {\n311|\t\t\t// Re-stage the intent so restart recovery resolves the\n312|\t\t\t// diverged pair instead of admitting it silently.\n313|\t\t\tif encoded, err := encodePendingCommit(intent); err == nil {\n314|\t\t\t\t_ = commitDocument(filesystem, root, pendingPath(root), encoded)\n315|\t\t\t}\n316|\t\t}\n317|\t\treturn failed(trustError(TrustError{Operation: \"validate joint configuration\", Err: ErrJointIntervened}))\n318|\t}\n319|\tif present {\n320|\t\tif err := removeMarkerLocked(filesystem, root); err != nil {\n321|\t\t\treturn failed(err)\n322|\t\t}\n323|\t}\n324|\treturn trustError(TrustError{Operation: \"commit joint generation\", Err: errors.Join(ErrJointReplacementDurable, commitErr)})\n325|}\n326|\n327|// readCompensationMarker re-reads the outstanding intent marker for\n328|// in-hold compensation. Absence is reported, never assumed from a failed\n329|// inspection; an existing marker is custody-verified and decoded exactly\n330|// like recovery verifies it. The present flag is meaningful only when err\n331|// is nil.\n332|func readCompensationMarker(filesystem FileSystem, root string) (marker PendingCommit, present bool, err error) {\n333|\tconst operation = \"read joint marker\"\n334|\tpath := pendingPath(root)\n335|\tinfo, statErr := filesystem.Lstat(path)\n336|\tif statErr != nil {\n337|\t\tif os.IsNotExist(statErr) {\n338|\t\t\treturn PendingCommit{}, false, nil\n339|\t\t}\n340|\t\treturn PendingCommit{}, false, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, statErr)})\n341|\t}\n342|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n343|\t\treturn PendingCommit{}, false, err\n344|\t}\n345|\tdocument, err := filesystem.ReadFile(path)\n346|\tif err != nil {\n347|\t\treturn PendingCommit{}, false, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n348|\t}\n349|\tmarker, err = decodePendingCommit(document)\n350|\tif err != nil {\n351|\t\treturn PendingCommit{}, false, err\n352|\t}\n353|\treturn marker, true, nil\n354|}\n355|\n356|// RecoverResult reports what one recovery pass found.\n357|type RecoverResult struct {\n358|\t// Found reports a marker was present at all.\n359|\tFound bool\n360|\t// Completed reports the replacement had committed and the generation\n361|\t// converged forward to source plus one (or already had).\n362|\tCompleted bool\n363|\t// Aborted reports the replacement had not committed: the marker was\n364|\t// removed with no generation change.\n365|\tAborted bool\n366|}\n367|\n368|// Recover converges one interrupted joint commit found on disk. It runs\n369|// automatically on Open, and is safe to call directly. Every other read,\n370|// admission and transaction entry point converges through the same logic\n371|// before exposing a snapshot (see convergeLocked), so surviving processes\n372|// converge exactly like reopened ones. In-hold error compensation (see\n373|// compensateLocked) aborts without a separate recovery pass; Recover\n374|// converges only markers a crash left behind:\n375|//\n376|//   - configuration equal to the replacement hash completes forward: a\n377|//     trust at the source generation bumps to source plus one; a trust\n378|//     already there only removes the marker.\n379|//   - configuration equal to the source hash aborts: the marker is removed\n380|//     with no generation change.\n381|//   - anything else (operator edit mid-flight, unreadable state) refuses\n382|//     and keeps the marker for operator resolution.\n383|//\n384|// A refused recovery fails the caller, so no reader can silently admit new\n385|// configuration with an old generation.\n386|func (store *Store) Recover() (RecoverResult, error) {\n387|\tunlock, err := store.lock.exclusive()\n388|\tif err != nil {\n389|\t\treturn RecoverResult{}, trustError(TrustError{Operation: \"recover joint commit\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n390|\t}\n391|\tdefer unlock()\n392|\treturn recoverLocked(store.fs, store.root)\n393|}\n394|\n395|func recoverLocked(filesystem FileSystem, root string) (RecoverResult, error) {\n396|\tconst operation = \"recover joint commit\"\n397|\tpath := pendingPath(root)\n398|\tif _, err := filesystem.Lstat(path); err != nil {\n399|\t\tif os.IsNotExist(err) {\n400|\t\t\treturn RecoverResult{}, nil\n401|\t\t}\n402|\t\treturn RecoverResult{}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n403|\t}\n404|\tinfo, err := filesystem.Lstat(path)\n405|\tif err != nil {\n406|\t\treturn RecoverResult{}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n407|\t}\n408|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n409|\t\treturn RecoverResult{}, err\n410|\t}\n411|\tdocument, err := filesystem.ReadFile(path)\n412|\tif err != nil {\n413|\t\treturn RecoverResult{}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n414|\t}\n415|\tmarker, err := decodePendingCommit(document)\n416|\tif err != nil {\n417|\t\treturn RecoverResult{Found: true}, err\n418|\t}\n419|\tconfiguration, err := filesystem.ReadFile(marker.ConfigPath)\n420|\tif err != nil {\n421|\t\treturn RecoverResult{Found: true}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n422|\t}\n423|\tswitch SHA256HexOf(configuration) {\n424|\tcase marker.ReplacementSHA256:\n425|\t\tcommitted, err := loadCommitted(filesystem, root)\n426|\t\tif err != nil {\n427|\t\t\treturn RecoverResult{Found: true}, err\n428|\t\t}\n429|\t\tswitch committed.Generation {\n430|\t\tcase marker.SourceGeneration:\n431|\t\t\tif err := transactLocked(filesystem, root, func(*TrustStore) error { return nil }); err != nil {\n432|\t\t\t\treturn RecoverResult{Found: true}, err\n433|\t\t\t}\n434|\t\tcase marker.SourceGeneration + 1:\n435|\t\tdefault:\n436|\t\t\treturn RecoverResult{Found: true}, trustError(TrustError{Operation: operation, Err: ErrJointIntervened})\n437|\t\t}\n438|\t\tif err := removeMarkerLocked(filesystem, root); err != nil {\n439|\t\t\treturn RecoverResult{Found: true}, err\n440|\t\t}\n441|\t\treturn RecoverResult{Found: true, Completed: true}, nil\n442|\tcase marker.SourceSHA256:\n443|\t\tif err := removeMarkerLocked(filesystem, root); err != nil {\n444|\t\t\treturn RecoverResult{Found: true}, err\n445|\t\t}\n446|\t\treturn RecoverResult{Found: true, Aborted: true}, nil\n447|\tdefault:\n448|\t\treturn RecoverResult{Found: true}, trustError(TrustError{Operation: operation, Err: ErrJointIntervened})\n449|\t}\n450|}\n451|\n452|func pendingPath(root string) string { return filepath.Join(root, pendingCommitFileName) }\n453|\n454|// markerPresent reports whether a joint-commit intent marker is\n455|// outstanding. Absence must be established, never assumed: an unreadable\n456|// marker path refuses instead of reporting no marker.\n457|func markerPresent(filesystem FileSystem, root string) (bool, error) {\n458|\t_, err := filesystem.Lstat(pendingPath(root))\n459|\tif err == nil {\n460|\t\treturn true, nil\n461|\t}\n462|\tif os.IsNotExist(err) {\n463|\t\treturn false, nil\n464|\t}\n465|\treturn false, trustError(TrustError{Operation: \"inspect joint commit\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n466|}\n467|\n468|// convergeLocked converges one interrupted joint commit, if any, before\n469|// the caller exposes a snapshot or runs a boundary. It is the general\n470|// admission barrier for pending intent: every read, admission and\n471|// transaction entry point converges here under the authorization lock,\n472|// while recovery itself stays the single convergence implementation. The\n473|// caller must hold the exclusive lock: convergence can bump the generation\n474|// and remove the marker. Shared-lock readers upgrade to exclusive when a\n475|// marker is present (see readSnapshot); when no marker is present the\n476|// shared fast path needs no write. A refused recovery fails the caller\n477|// with the marker kept for operator resolution.\n478|func convergeLocked(filesystem FileSystem, root string) error {\n479|\tpresent, err := markerPresent(filesystem, root)\n480|\tif err != nil {\n481|\t\treturn err\n482|\t}\n483|\tif !present {\n484|\t\treturn nil\n485|\t}\n486|\t_, err = recoverLocked(filesystem, root)\n487|\treturn err\n488|}\n489|\n490|func removeMarkerLocked(filesystem FileSystem, root string) error {\n491|\tif err := filesystem.Remove(pendingPath(root)); err != nil && !os.IsNotExist(err) {\n492|\t\treturn trustError(TrustError{Operation: \"remove joint marker\", Err: errors.Join(ErrTrustDurability, err)})\n493|\t}\n494|\tif err := syncDir(filesystem, root); err != nil {\n495|\t\treturn trustError(TrustError{Operation: \"sync joint marker directory\", Err: errors.Join(ErrTrustDurability, err)})\n496|\t}\n497|\treturn nil\n498|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8b1","stream":{"kind":"session","id":"01a0aba0-7282-7543-b2c1-245c5391567d"},"sequence":691,"recorded_at":1780531400001377,"record_type":"event","durability":"durable","causation_id":"3cb3b2c5-dd67-49c0-a2b1-aadb0810f3b1","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3cb3b2c5-dd67-49c0-a2b1-aadb0810f3b1","run_stream":{"kind":"run","id":"3cb3b2c5-dd67-49c0-a2b1-aadb0810f3b1"},"task_stream":{"kind":"task","id":"01a0aba2-f24a-7132-9441-b05e1362bcd4"},"task_id":"01a0aba2-f24a-7132-9441-b05e1362bcd4","event":{"kind":"completed","task_id":"01a0aba2-f24a-7132-9441-b05e1362bcd4"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8b3","stream":{"kind":"session","id":"01a0aba0-7282-7543-b2c1-245c5391567d"},"sequence":692,"recorded_at":1780531400001379,"record_type":"event","durability":"durable","causation_id":"3cb3b2c5-dd67-49c0-a2b1-aadb0810f3b1","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"3cb3b2c5-dd67-49c0-a2b1-aadb0810f3b1","run_stream":{"kind":"run","id":"3cb3b2c5-dd67-49c0-a2b1-aadb0810f3b1"},"call_id":"call_01a0aba2ef6277b3ac5327597a3928dd","text":"Read text file `internal/hosttrust/joint.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"crypto/sha256\"\n6|\t\"encoding/hex\"\n7|\t\"encoding/json\"\n8|\t\"errors\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\t\"strconv\"\n12|)\n13|\n14|// pendingCommitFileName is the durable intent marker for one joint\n15|// config-plus-trust commit. It lives beside trust.json under the same\n16|// owner-only custody and crash-durable write discipline.\n17|const pendingCommitFileName = \"pending-commit.json\"\n18|\n19|// Joint operations coupled to a trust generation bump.\n20|const (\n21|\tJointApplyV4    = \"apply-v4\"\n22|\tJointRollbackV4 = \"rollback-v4\"\n23|)\n24|\n25|// PendingCommit is the durable intent record for one joint commit. The\n26|// hashes pin the exact configuration bytes the operator confirmed; the\n27|// source generation pins the trust state they were rendered against. Only\n28|// the confirmed replacement may complete forward; anything else aborts or\n29|// refuses on restart.\n30|type PendingCommit struct {\n31|\tSchema            string `json:\"schema\"`\n32|\tSchemaVersion     string `json:\"schema_version\"`\n33|\tOperation         string `json:\"operation\"`\n34|\tConfigPath        string `json:\"config_path\"`\n35|\tSourceSHA256      string `json:\"source_sha256\"`\n36|\tReplacementSHA256 string `json:\"replacement_sha256\"`\n37|\tSourceGeneration  uint64 `json:\"source_generation\"`\n38|\tBackupPath        string `json:\"backup_path\"`\n39|}\n40|\n41|// SHA256HexOf returns the lowercase hex SHA-256 of document bytes for\n42|// marker pins. It exposes no key material: markers pin configuration bytes\n43|// only, never credentials.\n44|func SHA256HexOf(document []byte) string {\n45|\tdigest := sha256.Sum256(document)\n46|\treturn hex.EncodeToString(digest[:])\n47|}\n48|\n49|func encodePendingCommit(marker PendingCommit) ([]byte, error) {\n50|\tif err := checkPendingCommit(marker); err != nil {\n51|\t\treturn nil, err\n52|\t}\n53|\tdocument, err := json.Marshal(marker)\n54|\tif err != nil {\n55|\t\treturn nil, trustError(TrustError{Operation: \"encode joint commit\", Err: errors.Join(ErrTrustDurability, err)})\n56|\t}\n57|\treturn document, nil\n58|}\n59|\n60|func checkPendingCommit(marker PendingCommit) error {\n61|\tconst operation = \"validate joint commit\"\n62|\tif marker.Schema != \"urn:ax:schema:host-pending-commit\" || marker.SchemaVersion != \"1.0.0\" {\n63|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n64|\t}\n65|\tif marker.Operation != JointApplyV4 && marker.Operation != JointRollbackV4 {\n66|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n67|\t}\n68|\tif !filepath.IsAbs(marker.ConfigPath) || marker.BackupPath == \"\" {\n69|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n70|\t}\n71|\tfor _, digest := range []string{marker.SourceSHA256, marker.ReplacementSHA256} {\n72|\t\traw, err := hex.DecodeString(digest)\n73|\t\tif err != nil || len(raw) != sha256.Size {\n74|\t\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n75|\t\t}\n76|\t}\n77|\tif marker.SourceSHA256 == marker.ReplacementSHA256 {\n78|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n79|\t}\n80|\tif marker.SourceGeneration == 0 || marker.SourceGeneration > MaxGeneration {\n81|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n82|\t}\n83|\treturn nil\n84|}\n85|\n86|func decodePendingCommit(document []byte) (PendingCommit, error) {\n87|\tvar marker PendingCommit\n88|\tif err := rejectDuplicateKeys(document); err != nil {\n89|\t\treturn PendingCommit{}, err\n90|\t}\n91|\t// The generation must be a bare JSON number, never a quoted string:\n92|\t// validate it through the same uint53 discipline as the trust document\n93|\t// before the struct decode, so a quoted number refuses as invalid\n94|\t// state rather than as a syntax error.\n95|\traw := map[string]json.RawMessage{}\n96|\tdecoder := json.NewDecoder(bytes.NewReader(document))\n97|\tdecoder.UseNumber()\n98|\tif err := decoder.Decode(&raw); err != nil {\n99|\t\treturn PendingCommit{}, trustError(TrustError{Operation: \"decode joint commit\", Err: errors.Join(ErrTrustDecode, err)})\n100|\t}\n101|\tgeneration, err := decodeMarkerGeneration(raw)\n102|\tif err != nil {\n103|\t\treturn PendingCommit{}, err\n104|\t}\n105|\tdecoder = json.NewDecoder(bytes.NewReader(document))\n106|\tdecoder.DisallowUnknownFields()\n107|\tdecoder.UseNumber()\n108|\tif err := decoder.Decode(&marker); err != nil {\n109|\t\treturn PendingCommit{}, trustError(TrustError{Operation: \"decode joint commit\", Err: errors.Join(ErrTrustDecode, err)})\n110|\t}\n111|\tif decoder.More() {\n112|\t\treturn PendingCommit{}, trustError(TrustError{Operation: \"decode joint commit\", Err: ErrTrustDecode})\n113|\t}\n114|\tmarker.SourceGeneration = generation\n115|\tif err := checkPendingCommit(marker); err != nil {\n116|\t\treturn PendingCommit{}, err\n117|\t}\n118|\treturn marker, nil\n119|}\n120|\n121|func parseUint53(text string) (uint64, error) {\n122|\tif text == \"\" {\n123|\t\treturn 0, errors.New(\"empty generation number\")\n124|\t}\n125|\tfor _, digit := range text {\n126|\t\tif digit < '0' || digit > '9' {\n127|\t\t\treturn 0, errors.New(\"non-digit generation number\")\n128|\t\t}\n129|\t}\n130|\tparsed, err := strconv.ParseUint(text, 10, 64)\n131|\tif err != nil {\n132|\t\treturn 0, err\n133|\t}\n134|\tif parsed == 0 || parsed > MaxGeneration {\n135|\t\treturn 0, errors.New(\"generation outside uint53\")\n136|\t}\n137|\treturn parsed, nil\n138|}\n139|\n140|func decodeMarkerGeneration(shape map[string]json.RawMessage) (uint64, error) {\n141|\traw, ok := shape[\"source_generation\"]\n142|\tif !ok {\n143|\t\treturn 0, trustError(TrustError{Operation: \"decode joint generation\", Err: ErrTrustValidation})\n144|\t}\n145|\tvar value any\n146|\tif err := strictJSONDecoder(raw).Decode(&value); err != nil {\n147|\t\treturn 0, trustError(TrustError{Operation: \"decode joint generation\", Err: errors.Join(ErrTrustDecode, err)})\n148|\t}\n149|\tnumber, ok := value.(json.Number)\n150|\tif !ok {\n151|\t\treturn 0, trustError(TrustError{Operation: \"decode joint generation\", Err: ErrTrustValidation})\n152|\t}\n153|\tparsed, err := parseUint53(number.String())\n154|\tif err != nil {\n155|\t\treturn 0, trustError(TrustError{Operation: \"decode joint generation\", Err: ErrTrustValidation})\n156|\t}\n157|\treturn parsed, nil\n158|}\n159|\n160|// JointCommit runs one crash-atomic authorization-generation commit coupled\n161|// to an external durable replacement (Configuration 4.0.0 apply or\n162|// rollback). Under a single exclusive hold it converges any leftover\n163|// intent, revalidates the confirmed pins against committed trust, stages\n164|// the durable intent marker, runs replace (the configuration file\n165|// replacement), bumps the generation, and removes the marker.\n166|//\n167|//   - Leftover intent from a crashed commit converges first: a marker the\n168|//     replacement committed completes forward (moving the generation, so\n169|//     stale markers still refuse below); an unreplaced marker aborts. A\n170|//     refused leftover fails the commit with the marker kept.\n171|//   - revalidate runs inside the lock: the preview, source and generation\n172|//     checks it repeats there close the concurrent-change window between\n173|//     the unlocked fast-fail checks and the commit.\n174|//   - A replace failure aborts with no generation change; the marker is\n175|//     removed because the configuration is untouched.\n176|//   - A trust-commit failure after replace compensates under the same\n177|//     hold: the marker and the configuration are revalidated against the\n178|//     confirmed pins, restore reinstalls the source bytes, and the marker\n179|//     aborts with no generation change. Compensation never releases the\n180|//     hold, so no surviving reader, writer or held boundary can converge\n181|//     the replacement between the failure and the restore. A compensation\n182|//     that cannot complete keeps the marker for operator resolution and\n183|//     joins ErrJointCompensationFailed. The committed trust itself is never\n184|//     re-read for the decision: the fault that broke the bump (for example\n185|//     failed custody) must not break the abort, and an apparently durable\n186|//     bump is still unproven exactly because its commit reported failure.\n187|//   - Marker-removal failure after a durable bump still returns success:\n188|//     the joint state is already forward-complete, and the next converged\n189|//     read or open removes the marker.\n190|//\n191|// Only process crashes are covered by the restart protocol below; power\n192|// loss additionally depends on the disk honoring fsync, which no test here\n193|// can establish. Crash tests terminate a real child process at the\n194|// replacement seam and re-read through surviving and reopened stores.\n195|func (store *Store) JointCommit(marker PendingCommit, revalidate func(current TrustStore) error, replace func() error, restore func() error) (uint64, error) {\n196|\tconst operation = \"joint commit\"\n197|\tif revalidate == nil || replace == nil || restore == nil {\n198|\t\treturn 0, trustError(TrustError{Operation: operation, Err: ErrTrustDurability})\n199|\t}\n200|\tunlock, err := store.lock.exclusive()\n201|\tif err != nil {\n202|\t\treturn 0, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustDurability, err)})\n203|\t}\n204|\tdefer unlock()\n205|\tif err := convergeLocked(store.fs, store.root); err != nil {\n206|\t\treturn 0, err\n207|\t}\n208|\tcommitted, err := loadCommitted(store.fs, store.root)\n209|\tif err != nil {\n210|\t\treturn 0, err\n211|\t}\n212|\tif err := revalidate(committed); err != nil {\n213|\t\treturn 0, err\n214|\t}\n215|\tif marker.SourceGeneration != committed.Generation {\n216|\t\treturn 0, trustError(TrustError{Operation: operation, Err: ErrStaleGeneration})\n217|\t}\n218|\tif err := checkPendingCommit(marker); err != nil {\n219|\t\treturn 0, err\n220|\t}\n221|\tif _, err := store.fs.Lstat(pendingPath(store.root)); err == nil {\n222|\t\treturn 0, trustError(TrustError{Operation: operation, Err: ErrJointIntervened})\n223|\t} else if !os.IsNotExist(err) {\n224|\t\treturn 0, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n225|\t}\n226|\tencoded, err := encodePendingCommit(marker)\n227|\tif err != nil {\n228|\t\treturn 0, err\n229|\t}\n230|\tif err := commitDocument(store.fs, store.root, pendingPath(store.root), encoded); err != nil {\n231|\t\treturn 0, err\n232|\t}\n233|\tif err := replace(); err != nil {\n234|\t\t_ = removeMarkerLocked(store.fs, store.root)\n235|\t\treturn 0, err\n236|\t}\n237|\tvar generation uint64\n238|\tif err := transactLocked(store.fs, store.root, func(trust *TrustStore) error {\n239|\t\tgeneration = trust.Generation + 1\n240|\t\treturn nil\n241|\t}); err != nil {\n242|\t\treturn 0, compensateLocked(store.fs, store.root, marker, err, restore)\n243|\t}\n244|\t// The replacement and the bump are both durable: converge the marker\n245|\t// removal on next open when this cleanup itself is interrupted.\n246|\t_ = removeMarkerLocked(store.fs, store.root)\n247|\treturn generation, nil\n248|}\n249|\n250|// compensateLocked converges a joint commit whose replacement is durable\n251|// but whose generation bump failed with commitErr. The caller must hold\n252|// the exclusive authorization lock across the whole compensation: the\n253|// marker and the configuration are revalidated against the confirmed\n254|// intent, restore reinstalls the source bytes, and the marker aborts with\n255|// no generation change. Because the hold never lapses, no surviving\n256|// reader, writer or held boundary can converge the replacement between\n257|// the failure and the restore; the only way out is the clean abort or a\n258|// refused compensation with the marker kept.\n259|//\n260|//   - The marker is re-read and compared pin-for-pin with the staged\n261|//     intent: no in-protocol path changes it under the hold, so a\n262|//     mismatch, an undecodable marker or an unreadable marker path is an\n263|//     intervention that refuses with the marker kept. A vanished marker\n264|//     is the operator/sabotage remainder: the in-memory intent still pins\n265|//     the decision, and the marker is re-staged when the configuration\n266|//     matches neither pin so restart recovery resolves the pair instead\n267|//     of admitting it silently.\n268|//   - Configuration equal to the replacement hash runs restore, whose\n269|//     result is verified against the source hash before the marker\n270|//     aborts: a restore that reports success without reinstalling the\n271|//     source refuses as an intervention. Configuration already equal to\n272|//     the source hash aborts without running the restore.\n273|//   - A restore failure, an unreadable configuration, or configuration\n274|//     matching neither pin keeps the marker for operator resolution and\n275|//     joins ErrJointCompensationFailed. The configuration then stays at\n276|//     the replacement, which restart recovery completes forward once the\n277|//     underlying fault heals.\n278|func compensateLocked(filesystem FileSystem, root string, intent PendingCommit, commitErr error, restore func() error) error {\n279|\tconst operation = \"compensate joint commit\"\n280|\tfailed := func(cause error) error {\n281|\t\treturn trustError(TrustError{Operation: operation, Err: errors.Join(ErrJointReplacementDurable, ErrJointCompensationFailed, commitErr, cause)})\n282|\t}\n283|\treread, present, err := readCompensationMarker(filesystem, root)\n284|\tif err != nil {\n285|\t\treturn failed(err)\n286|\t}\n287|\tif present && reread != intent {\n288|\t\treturn failed(trustError(TrustError{Operation: \"validate joint marker\", Err: ErrJointIntervened}))\n289|\t}\n290|\tconfiguration, err := filesystem.ReadFile(intent.ConfigPath)\n291|\tif err != nil {\n292|\t\treturn failed(trustError(TrustError{Operation: \"read joint configuration\", Err: errors.Join(ErrTrustStoreUnreadable, err)}))\n293|\t}\n294|\tswitch SHA256HexOf(configuration) {\n295|\tcase intent.ReplacementSHA256:\n296|\t\tif err := restore(); err != nil {\n297|\t\t\treturn failed(err)\n298|\t\t}\n299|\t\trestored, err := filesystem.ReadFile(intent.ConfigPath)\n300|\t\tif err != nil {\n301|\t\t\treturn failed(trustError(TrustError{Operation: \"read joint configuration\", Err: errors.Join(ErrTrustStoreUnreadable, err)}))\n302|\t\t}\n303|\t\tif SHA256HexOf(restored) != intent.SourceSHA256 {\n304|\t\t\treturn failed(trustError(TrustError{Operation: \"validate joint restore\", Err: ErrJointIntervened}))\n305|\t\t}\n306|\tcase intent.SourceSHA256:\n307|\t\t// The replacement never landed: abort without running the\n308|\t\t// restore, which would only rewrite identical bytes.\n309|\tdefault:\n310|\t\tif !present {\n311|\t\t\t// Re-stage the intent so restart recovery resolves the\n312|\t\t\t// diverged pair instead of admitting it silently.\n313|\t\t\tif encoded, err := encodePendingCommit(intent); err == nil {\n314|\t\t\t\t_ = commitDocument(filesystem, root, pendingPath(root), encoded)\n315|\t\t\t}\n316|\t\t}\n317|\t\treturn failed(trustError(TrustError{Operation: \"validate joint configuration\", Err: ErrJointIntervened}))\n318|\t}\n319|\tif present {\n320|\t\tif err := removeMarkerLocked(filesystem, root); err != nil {\n321|\t\t\treturn failed(err)\n322|\t\t}\n323|\t}\n324|\treturn trustError(TrustError{Operation: \"commit joint generation\", Err: errors.Join(ErrJointReplacementDurable, commitErr)})\n325|}\n326|\n327|// readCompensationMarker re-reads the outstanding intent marker for\n328|// in-hold compensation. Absence is reported, never assumed from a failed\n329|// inspection; an existing marker is custody-verified and decoded exactly\n330|// like recovery verifies it. The present flag is meaningful only when err\n331|// is nil.\n332|func readCompensationMarker(filesystem FileSystem, root string) (marker PendingCommit, present bool, err error) {\n333|\tconst operation = \"read joint marker\"\n334|\tpath := pendingPath(root)\n335|\tinfo, statErr := filesystem.Lstat(path)\n336|\tif statErr != nil {\n337|\t\tif os.IsNotExist(statErr) {\n338|\t\t\treturn PendingCommit{}, false, nil\n339|\t\t}\n340|\t\treturn PendingCommit{}, false, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, statErr)})\n341|\t}\n342|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n343|\t\treturn PendingCommit{}, false, err\n344|\t}\n345|\tdocument, err := filesystem.ReadFile(path)\n346|\tif err != nil {\n347|\t\treturn PendingCommit{}, false, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n348|\t}\n349|\tmarker, err = decodePendingCommit(document)\n350|\tif err != nil {\n351|\t\treturn PendingCommit{}, false, err\n352|\t}\n353|\treturn marker, true, nil\n354|}\n355|\n356|// RecoverResult reports what one recovery pass found.\n357|type RecoverResult struct {\n358|\t// Found reports a marker was present at all.\n359|\tFound bool\n360|\t// Completed reports the replacement had committed and the generation\n361|\t// converged forward to source plus one (or already had).\n362|\tCompleted bool\n363|\t// Aborted reports the replacement had not committed: the marker was\n364|\t// removed with no generation change.\n365|\tAborted bool\n366|}\n367|\n368|// Recover converges one interrupted joint commit found on disk. It runs\n369|// automatically on Open, and is safe to call directly. Every other read,\n370|// admission and transaction entry point converges through the same logic\n371|// before exposing a snapshot (see convergeLocked), so surviving processes\n372|// converge exactly like reopened ones. In-hold error compensation (see\n373|// compensateLocked) aborts without a separate recovery pass; Recover\n374|// converges only markers a crash left behind:\n375|//\n376|//   - configuration equal to the replacement hash completes forward: a\n377|//     trust at the source generation bumps to source plus one; a trust\n378|//     already there only removes the marker.\n379|//   - configuration equal to the source hash aborts: the marker is removed\n380|//     with no generation change.\n381|//   - anything else (operator edit mid-flight, unreadable state) refuses\n382|//     and keeps the marker for operator resolution.\n383|//\n384|// A refused recovery fails the caller, so no reader can silently admit new\n385|// configuration with an old generation.\n386|func (store *Store) Recover() (RecoverResult, error) {\n387|\tunlock, err := store.lock.exclusive()\n388|\tif err != nil {\n389|\t\treturn RecoverResult{}, trustError(TrustError{Operation: \"recover joint commit\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n390|\t}\n391|\tdefer unlock()\n392|\treturn recoverLocked(store.fs, store.root)\n393|}\n394|\n395|func recoverLocked(filesystem FileSystem, root string) (RecoverResult, error) {\n396|\tconst operation = \"recover joint commit\"\n397|\tpath := pendingPath(root)\n398|\tif _, err := filesystem.Lstat(path); err != nil {\n399|\t\tif os.IsNotExist(err) {\n400|\t\t\treturn RecoverResult{}, nil\n401|\t\t}\n402|\t\treturn RecoverResult{}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n403|\t}\n404|\tinfo, err := filesystem.Lstat(path)\n405|\tif err != nil {\n406|\t\treturn RecoverResult{}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n407|\t}\n408|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n409|\t\treturn RecoverResult{}, err\n410|\t}\n411|\tdocument, err := filesystem.ReadFile(path)\n412|\tif err != nil {\n413|\t\treturn RecoverResult{}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n414|\t}\n415|\tmarker, err := decodePendingCommit(document)\n416|\tif err != nil {\n417|\t\treturn RecoverResult{Found: true}, err\n418|\t}\n419|\tconfiguration, err := filesystem.ReadFile(marker.ConfigPath)\n420|\tif err != nil {\n421|\t\treturn RecoverResult{Found: true}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n422|\t}\n423|\tswitch SHA256HexOf(configuration) {\n424|\tcase marker.ReplacementSHA256:\n425|\t\tcommitted, err := loadCommitted(filesystem, root)\n426|\t\tif err != nil {\n427|\t\t\treturn RecoverResult{Found: true}, err\n428|\t\t}\n429|\t\tswitch committed.Generation {\n430|\t\tcase marker.SourceGeneration:\n431|\t\t\tif err := transactLocked(filesystem, root, func(*TrustStore) error { return nil }); err != nil {\n432|\t\t\t\treturn RecoverResult{Found: true}, err\n433|\t\t\t}\n434|\t\tcase marker.SourceGeneration + 1:\n435|\t\tdefault:\n436|\t\t\treturn RecoverResult{Found: true}, trustError(TrustError{Operation: operation, Err: ErrJointIntervened})\n437|\t\t}\n438|\t\tif err := removeMarkerLocked(filesystem, root); err != nil {\n439|\t\t\treturn RecoverResult{Found: true}, err\n440|\t\t}\n441|\t\treturn RecoverResult{Found: true, Completed: true}, nil\n442|\tcase marker.SourceSHA256:\n443|\t\tif err := removeMarkerLocked(filesystem, root); err != nil {\n444|\t\t\treturn RecoverResult{Found: true}, err\n445|\t\t}\n446|\t\treturn RecoverResult{Found: true, Aborted: true}, nil\n447|\tdefault:\n448|\t\treturn RecoverResult{Found: true}, trustError(TrustError{Operation: operation, Err: ErrJointIntervened})\n449|\t}\n450|}\n451|\n452|func pendingPath(root string) string { return filepath.Join(root, pendingCommitFileName) }\n453|\n454|// markerPresent reports whether a joint-commit intent marker is\n455|// outstanding. Absence must be established, never assumed: an unreadable\n456|// marker path refuses instead of reporting no marker.\n457|func markerPresent(filesystem FileSystem, root string) (bool, error) {\n458|\t_, err := filesystem.Lstat(pendingPath(root))\n459|\tif err == nil {\n460|\t\treturn true, nil\n461|\t}\n462|\tif os.IsNotExist(err) {\n463|\t\treturn false, nil\n464|\t}\n465|\treturn false, trustError(TrustError{Operation: \"inspect joint commit\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n466|}\n467|\n468|// convergeLocked converges one interrupted joint commit, if any, before\n469|// the caller exposes a snapshot or runs a boundary. It is the general\n470|// admission barrier for pending intent: every read, admission and\n471|// transaction entry point converges here under the authorization lock,\n472|// while recovery itself stays the single convergence implementation. The\n473|// caller must hold the exclusive lock: convergence can bump the generation\n474|// and remove the marker. Shared-lock readers upgrade to exclusive when a\n475|// marker is present (see readSnapshot); when no marker is present the\n476|// shared fast path needs no write. A refused recovery fails the caller\n477|// with the marker kept for operator resolution.\n478|func convergeLocked(filesystem FileSystem, root string) error {\n479|\tpresent, err := markerPresent(filesystem, root)\n480|\tif err != nil {\n481|\t\treturn err\n482|\t}\n483|\tif !present {\n484|\t\treturn nil\n485|\t}\n486|\t_, err = recoverLocked(filesystem, root)\n487|\treturn err\n488|}\n489|\n490|func removeMarkerLocked(filesystem FileSystem, root string) error {\n491|\tif err := filesystem.Remove(pendingPath(root)); err != nil && !os.IsNotExist(err) {\n492|\t\treturn trustError(TrustError{Operation: \"remove joint marker\", Err: errors.Join(ErrTrustDurability, err)})\n493|\t}\n494|\tif err := syncDir(filesystem, root); err != nil {\n495|\t\treturn trustError(TrustError{Operation: \"sync joint marker directory\", Err: errors.Join(ErrTrustDurability, err)})\n496|\t}\n497|\treturn nil\n498|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
