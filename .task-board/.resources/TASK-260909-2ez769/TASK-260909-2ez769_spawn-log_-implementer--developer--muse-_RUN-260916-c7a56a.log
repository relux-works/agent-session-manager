5|// trust.json already exists: setup never overwrites committed authority.\n126|// Pending joint intent converges first, so setup never builds beside an\n127|// unresolved marker.\n128|func (store *Store) Initialize() (Snapshot, error) {\n129|\tunlock, err := store.lock.exclusive()\n130|\tif err != nil {\n131|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"lock initialize\", Err: errors.Join(ErrTrustDurability, err)})\n132|\t}\n133|\tdefer unlock()\n134|\tif err := convergeLocked(store.fs, store.root); err != nil {\n135|\t\treturn Snapshot{}, err\n136|\t}\n137|\tpath := filepath.Join(store.root, trustFileName)\n138|\tif _, err := store.fs.Lstat(path); err == nil {\n139|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"initialize store\", Err: ErrTrustDurability})\n140|\t} else if !os.IsNotExist(err) {\n141|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"initialize store\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n142|\t}\n143|\tdocument, err := EncodeTrust(TrustStore{Generation: 1})\n144|\tif err != nil {\n145|\t\treturn Snapshot{}, err\n146|\t}\n147|\tif err := commitDocument(store.fs, store.root, path, document); err != nil {\n148|\t\treturn Snapshot{}, err\n149|\t}\n150|\t// The exclusive lock is still held: read without re-acquiring, since a\n151|\t// second acquisition in this goroutine would block on the held lock.\n152|\treturn readSnapshotLocked(store.fs, store.root)\n153|}\n154|\n155|// transact runs one crash-durable generation transaction under the exclusive\n156|// cross-process lock: load committed state, apply fn, encode, stage with\n157|// fsync, atomic rename, directory fsync. A missing store refuses with\n158|// ErrTrustStoreMissing: only explicit Initialize commits generation 1. Any\n159|// other malformed state refuses before fn runs.\n160|func (store *Store) transact(fn TransactionFunc) error {\n161|\treturn transact(store.fs, store.root, store.lock, fn)\n162|}\n163|\n164|func transact(filesystem FileSystem, root string, lock *fileLock, fn TransactionFunc) error {\n165|\tunlock, err := lock.exclusive()\n166|\tif err != nil {\n167|\t\treturn trustError(TrustError{Operation: \"lock transaction\", Err: errors.Join(ErrTrustDurability, err)})\n168|\t}\n169|\tdefer unlock()\n170|\tif err := convergeLocked(filesystem, root); err != nil {\n171|\t\treturn err\n172|\t}\n173|\treturn transactLocked(filesystem, root, fn)\n174|}\n175|\n176|// transactLocked runs one crash-durable generation transaction assuming the\n177|// caller already holds the exclusive authorization lock. Joint commits and\n178|// recovery use it to sequence the marker, the external replacement and the\n179|// bump under a single hold.\n180|func transactLocked(filesystem FileSystem, root string, fn TransactionFunc) error {\n181|\tcommitted, err := loadCommitted(filesystem, root)\n182|\tif err != nil {\n183|\t\treturn err\n184|\t}\n185|\tnext := committed\n186|\tnext.Entries = append([]CredentialEntry(nil), committed.Entries...)\n187|\tif err := fn(&next); err != nil {\n188|\t\treturn err\n189|\t}\n190|\tif next.Generation != committed.Generation {\n191|\t\treturn trustError(TrustError{Operation: \"commit generation\", Err: ErrTrustDurability})\n192|\t}\n193|\tif committed.Generation >= MaxGeneration {\n194|\t\treturn trustError(TrustError{Operation: \"commit generation\", Err: ErrGenerationExhausted})\n195|\t}\n196|\tnext.Generation = committed.Generation + 1\n197|\tencoded, err := EncodeTrust(next)\n198|\tif err != nil {\n199|\t\treturn err\n200|\t}\n201|\tif err := commitDocument(filesystem, root, filepath.Join(root, trustFileName), encoded); err != nil {\n202|\t\treturn err\n203|\t}\n204|\treturn nil\n205|}\n206|\n207|// loadCommitted reads the committed trust without acquiring the lock: the\n208|// caller must already hold the authorization lock, and (outside recovery\n209|// itself) must have converged pending joint intent first.\n210|func loadCommitted(filesystem FileSystem, root string) (TrustStore, error) {\n211|\tpath := filepath.Join(root, trustFileName)\n212|\tinfo, err := filesystem.Lstat(path)\n213|\tif err != nil {\n214|\t\tif os.IsNotExist(err) {\n215|\t\t\treturn TrustStore{}, trustError(TrustError{Operation: \"read committed trust\", Err: ErrTrustStoreMissing})\n216|\t\t}\n217|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"read committed trust\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n218|\t}\n219|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n220|\t\treturn TrustStore{}, err\n221|\t}\n222|\tdocument, err := filesystem.ReadFile(path)\n223|\tif err != nil {\n224|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"read committed trust\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n225|\t}\n226|\tdecoded, err := DecodeTrust(document)\n227|\tif err != nil {\n228|\t\treturn TrustStore{}, err\n229|\t}\n230|\treturn decoded, nil\n231|}\n232|\n233|// commitDocument stages bytes in a temp file with fsync, atomically renames\n234|// over the target, and fsyncs the directory. On restart only the last fully\n235|// committed file is selected; staged files are ignored by every reader.\n236|func commitDocument(filesystem FileSystem, root, path string, document []byte) error {\n237|\tstaged, err := filesystem.CreateTemp(root, stagePrefix+\"*\", 0o600)\n238|\tif err != nil {\n239|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n240|\t}\n241|\tname := staged.Name()\n242|\tfailed := true\n243|\tdefer func() {\n244|\t\tif failed {\n245|\t\t\t_ = filesystem.Remove(name)\n246|\t\t}\n247|\t}()\n248|\tif err := writeAll(staged, document); err != nil {\n249|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n250|\t}\n251|\tif err := staged.Sync(); err != nil {\n252|\t\t_ = staged.Close()\n253|\t\treturn trustError(TrustError{Operation: \"sync trust\", Err: errors.Join(ErrTrustDurability, err)})\n254|\t}\n255|\tif err := staged.Close(); err != nil {\n256|\t\treturn trustError(TrustError{Operation: \"sync trust\", Err: errors.Join(ErrTrustDurability, err)})\n257|\t}\n258|\tif err := filesystem.Chmod(name, 0o600); err != nil {\n259|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n260|\t}\n261|\t// On platforms where mode bits do not govern access, install the\n262|\t// owner-only ACL before the staging file becomes visible under load.\n263|\tif err := secureStaged(name, false); err != nil {\n264|\t\treturn err\n265|\t}\n266|\tif err := filesystem.Rename(name, path); err != nil {\n267|\t\treturn trustError(TrustError{Operation: \"replace trust\", Err: errors.Join(ErrTrustDurability, err)})\n268|\t}\n269|\tif err := syncDir(filesystem, root); err != nil {\n270|\t\treturn trustError(TrustError{Operation: \"sync trust directory\", Err: errors.Join(ErrTrustDurability, err)})\n271|\t}\n272|\tfailed = false\n273|\treturn nil\n274|}\n275|\n276|func writeAll(writer interface{ Write([]byte) (int, error) }, document []byte) error {\n277|\tfor len(document) > 0 {\n278|\t\twritten, err := writer.Write(document)\n279|\t\tif err != nil {\n280|\t\t\treturn err\n281|\t\t}\n282|\t\tif written == 0 {\n283|\t\t\treturn errors.New(\"short trust write\")\n284|\t\t}\n285|\t\tdocument = document[written:]\n286|\t}\n287|\treturn nil\n288|}\n289|\n290|func syncDir(filesystem FileSystem, root string) error {\n291|\thandle, err := filesystem.OpenDirectory(root)\n292|\tif err != nil {\n293|\t\treturn err\n294|\t}\n295|\tif err := handle.Sync(); err != nil {\n296|\t\t_ = handle.Close()\n297|\t\treturn err\n298|\t}\n299|\treturn handle.Close()\n300|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
