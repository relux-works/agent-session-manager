{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c903","stream":{"kind":"session","id":"01a0aba0-7282-7543-b2c1-245c5391567d"},"sequence":732,"recorded_at":1780531400001459,"record_type":"event","durability":"durable","causation_id":"3cb3b2c5-dd67-49c0-a2b1-aadb0810f3b1","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3cb3b2c5-dd67-49c0-a2b1-aadb0810f3b1","run_stream":{"kind":"run","id":"3cb3b2c5-dd67-49c0-a2b1-aadb0810f3b1"},"task_stream":{"kind":"task","id":"01a0aba3-03f2-7bb0-b5b0-847b69e807eb"},"task_id":"01a0aba3-03f2-7bb0-b5b0-847b69e807eb","event":{"kind":"output","task_id":"01a0aba3-03f2-7bb0-b5b0-847b69e807eb","chunk":"Read text file `internal/config/migration_v4_apply.go`.\n1|package config\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"errors\"\n6|\t\"time\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/hosttrust\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// ApplyV4OS captures real process inputs and performs one explicit durable\n13|// Configuration 4.0.0 migration. The caller supplies the exact confirmed\n14|// preview from PreviewV4; confirm must be true.\n15|func ApplyV4OS(platform scalar.Platform, overrides Overrides, preview V4Preview, confirm bool, now time.Time) (V4ApplyResult, error) {\n16|\tinputs, err := OSInputs(platform)\n17|\tif err != nil {\n18|\t\treturn V4ApplyResult{}, err\n19|\t}\n20|\treturn applyV4(inputs, overrides, preview, confirm, now, osMigrationFileSystem{}, hosttrust.Open)\n21|}\n22|\n23|// ApplyV4 is the dependency-injected production entry point. It writes only\n24|// the selected configuration file, a deterministic source-version backup in\n25|// the same directory, and one trust generation bump under the shared\n26|// authorization lock.\n27|func ApplyV4(inputs Inputs, overrides Overrides, preview V4Preview, confirm bool, now time.Time) (V4ApplyResult, error) {\n28|\treturn applyV4(inputs, overrides, preview, confirm, now, osMigrationFileSystem{}, hosttrust.Open)\n29|}\n30|\n31|func applyV4(inputs Inputs, overrides Overrides, preview V4Preview, confirm bool, now time.Time,\n32|\tfilesystem migrationFileSystem, openStore func(string) (*hosttrust.Store, error)) (V4ApplyResult, error) {\n33|\tif !confirm {\n34|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"confirm preview\", Err: ErrMigrationV4ConfirmRequired})\n35|\t}\n36|\tif preview.SourceVersion != CurrentVersion || len(preview.SourceDocument) == 0 || len(preview.Replacement) == 0 {\n37|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate preview\", Err: ErrMigrationV4PreviewMismatch})\n38|\t}\n39|\t// Unlocked fast-fail checks first; the same pins are revalidated inside\n40|\t// the joint transaction below, closing the concurrent-change window\n41|\t// between this read and the commit.\n42|\tsnapshot, err := Load(inputs, overrides)\n43|\tif err != nil {\n44|\t\treturn V4ApplyResult{}, err\n45|\t}\n46|\tloaded, decoded := snapshot.Configuration()\n47|\tif !snapshot.ConfigPresent() || !decoded {\n48|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"load source\", Err: ErrMigrationSourceAbsent})\n49|\t}\n50|\tif loaded.SourceVersion != CurrentVersion {\n51|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"select source\", Err: ErrMigrationV4Source})\n52|\t}\n53|\tif !bytes.Equal(snapshot.Document(), preview.SourceDocument) {\n54|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate preview source\", Err: ErrMigrationV4StaleSource})\n55|\t}\n56|\tselected, _ := snapshot.Paths().Path(ConfigFile)\n57|\tfilename := selected.Value.String()\n58|\tstateDir := stateDirOf(snapshot)\n59|\tstore, err := openStore(stateDir)\n60|\tif err != nil {\n61|\t\treturn V4ApplyResult{}, err\n62|\t}\n63|\tcurrent, err := store.ReadSnapshot()\n64|\tif err != nil {\n65|\t\treturn V4ApplyResult{}, err\n66|\t}\n67|\tif current.Generation != preview.SourceGeneration {\n68|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate preview generation\", Err: ErrMigrationV4StaleGeneration})\n69|\t}\n70|\trendered, err := renderV4Preview(snapshot.Document(), loaded.Value, current, preview.CredentialID, preview.DroppedPeers, now, inputs)\n71|\tif err != nil {\n72|\t\treturn V4ApplyResult{}, err\n73|\t}\n74|\tif !bytes.Equal(rendered.Replacement, preview.Replacement) {\n75|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate preview bytes\", Err: ErrMigrationV4PreviewMismatch})\n76|\t}\n77|\t// The custody files behind the selected credential must validate before\n78|\t// use, exactly as Section 11.10.2 requires for local identity.\n79|\tcredentialHex := previewCredentialHex(preview.CredentialID)\n80|\tif err := store.ValidateCustody(credentialHex, loaded.Value.HostID, now); err != nil {\n81|\t\treturn V4ApplyResult{}, err\n82|\t}\n83|\tbackup := filename + \".bak.\" + loaded.SourceVersion\n84|\t// filename is the selected snapshot path, a scalar.AbsolutePath by\n85|\t// loader construction; JointCommit still revalidates the absolute\n86|\t// marker path before staging anything.\n87|\tmarker := hosttrust.PendingCommit{\n88|\t\tSchema:            \"urn:ax:schema:host-pending-commit\",\n89|\t\tSchemaVersion:     \"1.0.0\",\n90|\t\tOperation:         hosttrust.JointApplyV4,\n91|\t\tConfigPath:        filename,\n92|\t\tSourceSHA256:      hosttrust.SHA256HexOf(preview.SourceDocument),\n93|\t\tReplacementSHA256: hosttrust.SHA256HexOf(preview.Replacement),\n94|\t\tSourceGeneration:  preview.SourceGeneration,\n95|\t\tBackupPath:        backup,\n96|\t}\n97|\tgeneration, err := store.JointCommit(marker,\n98|\t\tfunc(current hosttrust.TrustStore) error {\n99|\t\t\treturn revalidateApplyV4(inputs, overrides, store, preview, current, now)\n100|\t\t},\n101|\t\tfunc() error {\n102|\t\t\treturn replaceDurably(filesystem, filename, backup, preview.SourceDocument, preview.Replacement)\n103|\t\t},\n104|\t\tfunc() error {\n105|\t\t\t_, err := writeTempReplace(filesystem, filename, preview.SourceDocument)\n106|\t\t\treturn err\n107|\t\t})\n108|\tif err != nil {\n109|\t\tif errors.Is(err, hosttrust.ErrJointCompensationFailed) {\n110|\t\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"compensate joint commit\", Err: errors.Join(ErrMigrationSync, ErrMigrationRecovery, err)})\n111|\t\t}\n112|\t\treturn V4ApplyResult{}, err\n113|\t}\n114|\treturn V4ApplyResult{\n115|\t\tMigration:  MigrationResult{SourceVersion: loaded.SourceVersion, TargetVersion: Version4, BackupPath: backup, Changed: true},\n116|\t\tGeneration: generation,\n117|\t}, nil\n118|}\n119|\n120|// revalidateApplyV4 repeats the confirmed pins inside the joint transaction:\n121|// current source bytes, source version, preview rendering, generation and\n122|// credential custody. It runs under the exclusive authorization lock, so a\n123|// concurrent trust or config commit cannot slip between validation and the\n124|// replacement.\n125|func revalidateApplyV4(inputs Inputs, overrides Overrides, store *hosttrust.Store, preview V4Preview, current hosttrust.TrustStore, now time.Time) error {\n126|\tsnapshot, err := Load(inputs, overrides)\n127|\tif err != nil {\n128|\t\treturn err\n129|\t}\n130|\tloaded, decoded := snapshot.Configuration()\n131|\tif !snapshot.ConfigPresent() || !decoded {\n132|\t\treturn migrationError(MigrationError{Operation: \"load source\", Err: ErrMigrationSourceAbsent})\n133|\t}\n134|\tif loaded.SourceVersion != CurrentVersion {\n135|\t\treturn migrationError(MigrationError{Operation: \"select source\", Err: ErrMigrationV4Source})\n136|\t}\n137|\tif !bytes.Equal(snapshot.Document(), preview.SourceDocument) {\n138|\t\treturn migrationError(MigrationError{Operation: \"validate preview source\", Err: ErrMigrationV4StaleSource})\n139|\t}\n140|\tif current.Generation != preview.SourceGeneration {\n141|\t\treturn migrationError(MigrationError{Operation: \"validate preview generation\", Err: ErrMigrationV4StaleGeneration})\n142|\t}\n143|\trendered, err := renderV4Preview(snapshot.Document(), loaded.Value, hosttrust.Snapshot{Generation: current.Generation, Trust: current}, preview.CredentialID, preview.DroppedPeers, now, inputs)\n144|\tif err != nil {\n145|\t\treturn err\n146|\t}\n147|\tif !bytes.Equal(rendered.Replacement, preview.Replacement) {\n148|\t\treturn migrationError(MigrationError{Operation: \"validate preview bytes\", Err: ErrMigrationV4PreviewMismatch})\n149|\t}\n150|\t// The store is already open: custody revalidation reads files only and\n151|\t// never re-acquires the held authorization lock.\n152|\treturn store.ValidateCustody(previewCredentialHex(preview.CredentialID), loaded.Value.HostID, now)\n153|}\n154|\n155|// RollbackV4OS captures real process inputs and performs one explicit\n156|// operator rollback: stopping every host channel is the operator's act, and\n157|// this call replaces configuration from the preserved backup and bumps the\n158|// trust generation so stale-generation streams cannot survive.\n159|func RollbackV4OS(platform scalar.Platform, overrides Overrides, options RollbackV4Options) (V4ApplyResult, error) {\n160|\tinputs, err := OSInputs(platform)\n161|\tif err != nil {\n162|\t\treturn V4ApplyResult{}, err\n163|\t}\n164|\treturn rollbackV4(inputs, overrides, options, osMigrationFileSystem{}, hosttrust.Open)\n165|}\n166|\n167|// RollbackV4 is the dependency-injected production entry point.\n168|func RollbackV4(inputs Inputs, overrides Overrides, options RollbackV4Options) (V4ApplyResult, error) {\n169|\treturn rollbackV4(inputs, overrides, options, osMigrationFileSystem{}, hosttrust.Open)\n170|}\n171|\n172|// errRollbackConverged signals that the rollback target already holds: the\n173|// configuration converged to the backup between the fast-fail check and the\n174|// joint transaction. JointCommit stages no marker for it and passes the\n175|// sentinel through; rollbackV4 reports the no-op success instead.\n176|var errRollbackConverged = errors.New(\"configuration rollback already holds\")\n177|\n178|func rollbackV4(inputs Inputs, overrides Overrides, options RollbackV4Options,\n179|\tfilesystem migrationFileSystem, openStore func(string) (*hosttrust.Store, error)) (V4ApplyResult, error) {\n180|\tif !options.AcknowledgeNoHostChannelAssurance {\n181|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"acknowledge rollback\", Err: ErrRollbackV4AckRequired})\n182|\t}\n183|\tsnapshot, err := Load(inputs, overrides)\n184|\tif err != nil {\n185|\t\treturn V4ApplyResult{}, err\n186|\t}\n187|\tloaded, decoded := snapshot.Configuration()\n188|\tif !snapshot.ConfigPresent() || !decoded {\n189|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"load source\", Err: ErrMigrationSourceAbsent})\n190|\t}\n191|\tselected, _ := snapshot.Paths().Path(ConfigFile)\n192|\tfilename := selected.Value.String()\n193|\tbackup := options.BackupPath\n194|\tif backup == \"\" {\n195|\t\tbackup = filename + \".bak.\" + CurrentVersion\n196|\t}\n197|\tbackupBytes, err := filesystem.ReadFile(backup)\n198|\tif err != nil {\n199|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"read backup\", Err: errors.Join(ErrRollbackV4Backup, err)})\n200|\t}\n201|\tcontext := DecodeContext{RuntimePlatform: inputs.Platform, BackendSettings: inputs.BackendSettings}\n202|\tbackupLoaded, err := Decode(backupBytes, context)\n203|\tif err != nil {\n204|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate backup\", Err: errors.Join(ErrRollbackV4Backup, err)})\n205|\t}\n206|\tif backupLoaded.SourceVersion == Version4 {\n207|\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"validate backup\", Err: ErrRollbackV4Backup})\n208|\t}\n209|\tif bytes.Equal(snapshot.Document(), backupBytes) {\n210|\t\treturn V4ApplyResult{Migration: MigrationResult{SourceVersion: loaded.SourceVersion, TargetVersion: backupLoaded.SourceVersion, BackupPath: backup}}, nil\n211|\t}\n212|\tstore, err := openStore(stateDirOf(snapshot))\n213|\tif err != nil {\n214|\t\treturn V4ApplyResult{}, err\n215|\t}\n216|\tpreRollback := filename + \".pre-rollback.\" + loaded.SourceVersion\n217|\tmarker := hosttrust.PendingCommit{\n218|\t\tSchema:            \"urn:ax:schema:host-pending-commit\",\n219|\t\tSchemaVersion:     \"1.0.0\",\n220|\t\tOperation:         hosttrust.JointRollbackV4,\n221|\t\tConfigPath:        filename,\n222|\t\tSourceSHA256:      hosttrust.SHA256HexOf(snapshot.Document()),\n223|\t\tReplacementSHA256: hosttrust.SHA256HexOf(backupBytes),\n224|\t\tBackupPath:        preRollback,\n225|\t}\n226|\t// The source generation pins inside the transaction: reread the trust\n227|\t// there so a concurrent commit cannot slip between this read and the\n228|\t// replacement.\n229|\tcurrent, err := store.ReadSnapshot()\n230|\tif err != nil {\n231|\t\treturn V4ApplyResult{}, err\n232|\t}\n233|\tmarker.SourceGeneration = current.Generation\n234|\tgeneration, err := store.JointCommit(marker,\n235|\t\tfunc(current hosttrust.TrustStore) error {\n236|\t\t\treturn revalidateRollbackV4(inputs, overrides, snapshot.Document(), backupBytes, backupLoaded.SourceVersion, marker.SourceGeneration, current)\n237|\t\t},\n238|\t\tfunc() error {\n239|\t\t\treturn replaceDurably(filesystem, filename, preRollback, snapshot.Document(), backupBytes)\n240|\t\t},\n241|\t\tfunc() error {\n242|\t\t\t_, err := writeTempReplace(filesystem, filename, snapshot.Document())\n243|\t\t\treturn err\n244|\t\t})\n245|\tif err != nil {\n246|\t\tif errors.Is(err, errRollbackConverged) {\n247|\t\t\treturn V4ApplyResult{Migration: MigrationResult{SourceVersion: loaded.SourceVersion, TargetVersion: backupLoaded.SourceVersion, BackupPath: backup}}, nil\n248|\t\t}\n249|\t\tif errors.Is(err, hosttrust.ErrJointCompensationFailed) {\n250|\t\t\treturn V4ApplyResult{}, migrationError(MigrationError{Operation: \"compensate joint commit\", Err: errors.Join(ErrMigrationSync, ErrMigrationRecovery, err)})\n251|\t\t}\n252|\t\treturn V4ApplyResult{}, err\n253|\t}\n254|\treturn V4ApplyResult{\n255|\t\tMigration:  MigrationResult{SourceVersion: loaded.SourceVersion, TargetVersion: backupLoaded.SourceVersion, BackupPath: preRollback, Changed: true},\n256|\t\tGeneration: generation,\n257|\t}, nil\n258|}\n259|\n260|// revalidateRollbackV4 repeats the rollback pins inside the joint\n261|// transaction: the current document is still the pinned source, still\n262|// differs from the backup, the backup still decodes below v4, and the trust\n263|// generation has not moved. A converged target (current equals backup) is\n264|// the no-op success, not a commit: it returns errRollbackConverged before\n265|// any marker is staged.\n266|func revalidateRollbackV4(inputs Inputs, overrides Overrides, sourceDocument, backupBytes []byte, backupVersion string, expectedGeneration uint64, current hosttrust.TrustStore) error {\n267|\tsnapshot, err := Load(inputs, overrides)\n268|\tif err != nil {\n269|\t\treturn err\n270|\t}\n271|\tloaded, decoded := snapshot.Configuration()\n272|\tif !snapshot.ConfigPresent() || !decoded {\n273|\t\treturn migrationError(MigrationError{Operation: \"load source\", Err: ErrMigrationSourceAbsent})\n274|\t}\n275|\t_ = loaded\n276|\tif bytes.Equal(snapshot.Document(), backupBytes) {\n277|\t\treturn errRollbackConverged\n278|\t}\n279|\tif !bytes.Equal(snapshot.Document(), sourceDocument) {\n280|\t\treturn migrationError(MigrationError{Operation: \"validate rollback source\", Err: ErrRollbackV4StaleSource})\n281|\t}\n282|\tif current.Generation != expectedGeneration {\n283|\t\treturn migrationError(MigrationError{Operation: \"validate rollback generation\", Err: ErrRollbackV4StaleGeneration})\n284|\t}\n285|\tcontext := DecodeContext{RuntimePlatform: inputs.Platform, BackendSettings: inputs.BackendSettings}\n286|\tbackupLoaded, err := Decode(backupBytes, context)\n287|\tif err != nil {\n288|\t\treturn migrationError(MigrationError{Operation: \"validate backup\", Err: errors.Join(ErrRollbackV4Backup, err)})\n289|\t}\n290|\tif backupLoaded.SourceVersion == Version4 || backupLoaded.SourceVersion != backupVersion {\n291|\t\treturn migrationError(MigrationError{Operation: \"validate backup\", Err: ErrRollbackV4Backup})\n292|\t}\n293|\treturn nil\n294|}","final_result":true}}}
