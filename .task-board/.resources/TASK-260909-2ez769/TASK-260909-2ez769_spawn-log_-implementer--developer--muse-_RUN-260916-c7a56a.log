{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8d9","stream":{"kind":"session","id":"01a0aba0-7282-7543-b2c1-245c5391567d"},"sequence":711,"recorded_at":1780531400001417,"record_type":"event","durability":"durable","causation_id":"3cb3b2c5-dd67-49c0-a2b1-aadb0810f3b1","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3cb3b2c5-dd67-49c0-a2b1-aadb0810f3b1","run_stream":{"kind":"run","id":"3cb3b2c5-dd67-49c0-a2b1-aadb0810f3b1"},"task_stream":{"kind":"task","id":"01a0aba2-fba6-7333-aa98-a4d13c880e0e"},"task_id":"01a0aba2-fba6-7333-aa98-a4d13c880e0e","event":{"kind":"output","task_id":"01a0aba2-fba6-7333-aa98-a4d13c880e0e","chunk":"Read text file `internal/config/migration.go`.\n1|package config\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"errors\"\n6|\t\"io\"\n7|\t\"io/fs\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"strconv\"\n11|\t\"strings\"\n12|\n13|\t\"github.com/pelletier/go-toml/v2\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|)\n16|\n17|var (\n18|\tErrMigrationTarget         = errors.New(\"unsupported configuration migration target\")\n19|\tErrMigrationDowngrade      = errors.New(\"configuration migration would downgrade\")\n20|\tErrMigrationChoiceRequired = errors.New(\"generated-summary disclosure choice required\")\n21|\tErrMigrationSourceAbsent   = errors.New(\"configuration migration source is absent\")\n22|\tErrMigrationBackup         = errors.New(\"configuration migration backup failed\")\n23|\tErrMigrationWrite          = errors.New(\"configuration migration write failed\")\n24|\tErrMigrationSync           = errors.New(\"configuration migration sync failed\")\n25|\tErrMigrationReplace        = errors.New(\"configuration migration atomic replace failed\")\n26|\tErrMigrationRecovery       = errors.New(\"configuration migration recovery failed\")\n27|\tErrCompatibilityReader     = errors.New(\"unsupported configuration reader version\")\n28|\tErrCompatibilityAssessment = errors.New(\"configuration compatibility assessment failed\")\n29|\t// ErrMigrationV4Explicit reports a direct Migrate call targeting\n30|\t// Configuration 4.0.0. Migration to v4 is never a one-shot upgrade: it\n31|\t// requires PreviewV4, explicit operator confirmation, and ApplyV4.\n32|\tErrMigrationV4Explicit = errors.New(\"configuration 4.0.0 migration requires explicit preview and confirmation\")\n33|\t// ErrMigrationV4Source reports a v4 migration requested from a\n34|\t// Configuration 1.0.0 or 2.0.0 source. Older inputs first use the\n35|\t// existing explicit migrations to Configuration 3.0.0.\n36|\tErrMigrationV4Source = errors.New(\"configuration 4.0.0 migration requires a configuration 3.0.0 source\")\n37|)\n38|\n39|// MigrationOptions are the explicit choices supplied by the ax migrate config\n40|// owner. Major-version migration is never invoked from Load or startup.\n41|type MigrationOptions struct {\n42|\tTargetVersion                 string\n43|\tGeneratedSummaryUpgradeChoice string\n44|}\n45|\n46|// MigrationResult reports durable migration without claiming CLI or doctor\n47|// availability. Changed is false for an already-target-version document.\n48|// BackupPath is the deterministic name the backup takes and is only guaranteed\n49|// to exist on disk when Migrate returned a nil error; a caller must not treat\n50|// it as a readable path after a refusal.\n51|type MigrationResult struct {\n52|\tSourceVersion string\n53|\tTargetVersion string\n54|\tBackupPath    string\n55|\tChanged       bool\n56|}\n57|\n58|// MigrationError renders no machine-local path or document content.\n59|type MigrationError struct {\n60|\tOperation string\n61|\tErr       error\n62|}\n63|\n64|func (err *MigrationError) Error() string {\n65|\treturn \"configuration migration \" + err.Operation + \" failed\"\n66|}\n67|func (err *MigrationError) Unwrap() error { return err.Err }\n68|\n69|// MigrateOS captures real process inputs and performs one explicit durable\n70|// major-version migration. The selected source is validated through Load\n71|// before any backup or replacement is attempted.\n72|func MigrateOS(platform scalar.Platform, overrides Overrides, options MigrationOptions) (MigrationResult, error) {\n73|\tinputs, err := OSInputs(platform)\n74|\tif err != nil {\n75|\t\treturn MigrationResult{}, err\n76|\t}\n77|\treturn Migrate(inputs, overrides, options)\n78|}\n79|\n80|// Migrate is the dependency-injected production entry point. It writes only\n81|// the selected configuration file and a deterministic source-version backup\n82|// in the same directory.\n83|func Migrate(inputs Inputs, overrides Overrides, options MigrationOptions) (MigrationResult, error) {\n84|\treturn migrate(inputs, overrides, options, osMigrationFileSystem{})\n85|}\n86|\n87|// CompatibilityMode is deliberately narrower than runtime capability state.\n88|type CompatibilityMode string\n89|\n90|const (\n91|\tCompatibilityCompatible CompatibilityMode = \"compatible\"\n92|\tCompatibilityReadOnly   CompatibilityMode = \"read-only-diagnostic\"\n93|)\n94|\n95|// CompatibilityAssessment contains only envelope facts needed to prevent a\n96|// downgraded writer. It exposes no decoded Configuration and performs no I/O.\n97|type CompatibilityAssessment struct {\n98|\tReaderVersion string\n99|\tSourceVersion string\n100|\tMode          CompatibilityMode\n101|}\n102|\n103|// AssessCompatibility determines whether a known reader may open the document\n104|// normally or must remain read-only. Newer documents are not decoded or\n105|// rewritten, so fields unknown to the older reader remain untouched.\n106|func AssessCompatibility(document []byte, readerVersion string) (CompatibilityAssessment, error) {\n107|\treader, ok := knownConfigVersion(readerVersion)\n108|\tif !ok {\n109|\t\treturn CompatibilityAssessment{}, migrationError(MigrationError{Operation: \"assess reader\", Err: ErrCompatibilityReader})\n110|\t}\n111|\tvar envelope rawEnvelope\n112|\tif err := decodeEnvelope(document, &envelope); err != nil {\n113|\t\treturn CompatibilityAssessment{}, err\n114|\t}\n115|\tif envelope.Schema != SchemaID {\n116|\t\treturn CompatibilityAssessment{}, configError(\"schema\", ErrConfigValidation)\n117|\t}\n118|\tsource, err := parseSemverCore(envelope.SchemaVersion)\n119|\tif err != nil {\n120|\t\treturn CompatibilityAssessment{}, configError(\"schema_version\", errors.Join(ErrCompatibilityAssessment, err))\n121|\t}\n122|\tmode := CompatibilityCompatible\n123|\tif compareSemver(source, reader) > 0 {\n124|\t\tmode = CompatibilityReadOnly\n125|\t} else if _, known := knownConfigVersion(envelope.SchemaVersion); !known {\n126|\t\treturn CompatibilityAssessment{}, configError(\"schema_version\", ErrUnsupportedConfigVersion)\n127|\t}\n128|\treturn CompatibilityAssessment{ReaderVersion: readerVersion, SourceVersion: envelope.SchemaVersion, Mode: mode}, nil\n129|}\n130|\n131|type semverCore struct{ major, minor, patch uint64 }\n132|\n133|func knownConfigVersion(value string) (semverCore, bool) {\n134|\tswitch value {\n135|\tcase Version1, Version2, CurrentVersion, Version4:\n136|\t\tparsed, _ := parseSemverCore(value)\n137|\t\treturn parsed, true\n138|\tdefault:\n139|\t\treturn semverCore{}, false\n140|\t}\n141|}\n142|\n143|func parseSemverCore(value string) (semverCore, error) {\n144|\tparts := strings.Split(value, \".\")\n145|\tif len(parts) != 3 {\n146|\t\treturn semverCore{}, ErrUnsupportedConfigVersion\n147|\t}\n148|\tvalues := make([]uint64, 3)\n149|\tfor index, part := range parts {\n150|\t\tif part == \"\" || (len(part) > 1 && part[0] == '0') {\n151|\t\t\treturn semverCore{}, ErrUnsupportedConfigVersion\n152|\t\t}\n153|\t\tparsed, err := strconv.ParseUint(part, 10, 64)\n154|\t\tif err != nil {\n155|\t\t\treturn semverCore{}, ErrUnsupportedConfigVersion\n156|\t\t}\n157|\t\tvalues[index] = parsed\n158|\t}\n159|\treturn semverCore{major: values[0], minor: values[1], patch: values[2]}, nil\n160|}\n161|\n162|func compareSemver(left, right semverCore) int {\n163|\tif left.major != right.major {\n164|\t\tif left.major < right.major {\n165|\t\t\treturn -1\n166|\t\t}\n167|\t\treturn 1\n168|\t}\n169|\tif left.minor != right.minor {\n170|\t\tif left.minor < right.minor {\n171|\t\t\treturn -1\n172|\t\t}\n173|\t\treturn 1\n174|\t}\n175|\tif left.patch != right.patch {\n176|\t\tif left.patch < right.patch {\n177|\t\t\treturn -1\n178|\t\t}\n179|\t\treturn 1\n180|\t}\n181|\treturn 0\n182|}\n183|\n184|func decodeEnvelope(document []byte, envelope *rawEnvelope) error {\n185|\tif err := tomlDecode(document, envelope); err != nil {\n186|\t\treturn configError(\"TOML\", errors.Join(ErrConfigDecode, err))\n187|\t}\n188|\treturn nil\n189|}\n190|\n191|func migrate(inputs Inputs, overrides Overrides, options MigrationOptions, filesystem migrationFileSystem) (MigrationResult, error) {\n192|\ttarget, targetKnown := knownConfigVersion(options.TargetVersion)\n193|\tif !targetKnown || options.TargetVersion == Version1 {\n194|\t\treturn MigrationResult{}, migrationError(MigrationError{Operation: \"select target\", Err: ErrMigrationTarget})\n195|\t}\n196|\tif options.TargetVersion == Version4 {\n197|\t\treturn MigrationResult{}, migrationError(MigrationError{Operation: \"select target\", Err: ErrMigrationV4Explicit})\n198|\t}\n199|\tsnapshot, err := Load(inputs, overrides)\n200|\tif err != nil {\n201|\t\treturn MigrationResult{}, err\n202|\t}\n203|\tloaded, decoded := snapshot.Configuration()\n204|\tif !snapshot.ConfigPresent() || !decoded {\n205|\t\treturn MigrationResult{}, migrationError(MigrationError{Operation: \"load source\", Err: ErrMigrationSourceAbsent})\n206|\t}\n207|\tsource, _ := knownConfigVersion(loaded.SourceVersion)\n208|\tresult := MigrationResult{SourceVersion: loaded.SourceVersion, TargetVersion: options.TargetVersion}\n209|\tif compareSemver(source, target) > 0 {\n210|\t\treturn result, migrationError(MigrationError{Operation: \"select target\", Err: ErrMigrationDowngrade})\n211|\t}\n212|\tif compareSemver(source, target) == 0 {\n213|\t\treturn result, nil\n214|\t}\n215|\tif loaded.SourceVersion == Version1 {\n216|\t\tif !oneOf(options.GeneratedSummaryUpgradeChoice, \"local_only\", \"mesh_sanitized\", \"reference_only\") {\n217|\t\t\treturn result, migrationError(MigrationError{Operation: \"validate disclosure choice\", Err: ErrMigrationChoiceRequired})\n218|\t\t}\n219|\t\tloaded.Value.Directory.GeneratedSummaryUpgradeChoice = options.GeneratedSummaryUpgradeChoice\n220|\t}\n221|\tcontext := DecodeContext{RuntimePlatform: inputs.Platform, BackendSettings: inputs.BackendSettings}\n222|\tvar replacement []byte\n223|\tswitch options.TargetVersion {\n224|\tcase Version2:\n225|\t\treplacement, err = encodeVersion2(loaded.Value, context)\n226|\tcase CurrentVersion:\n227|\t\treplacement, err = EncodeCurrent(loaded.Value, context)\n228|\t}\n229|\tif err != nil {\n230|\t\treturn result, migrationError(MigrationError{Operation: \"encode target\", Err: err}) // config-refusal-subsumed: every encoder refusal below this propagation is pinned on its own clause, at writer.go terminal.backend and writer.go v2 wire TOML for the v2 encoder, at writer.go v2 re-read for its defence-in-depth round trip, and by the EncodeCurrent validation suite for v3\n231|\t}\n232|\tselected, _ := snapshot.Paths().Path(ConfigFile)\n233|\tfilename := selected.Value.String()\n234|\tbackup := filename + \".bak.\" + loaded.SourceVersion\n235|\tresult.BackupPath = backup\n236|\tif err := replaceDurably(filesystem, filename, backup, snapshot.Document(), replacement); err != nil {\n237|\t\treturn result, err\n238|\t}\n239|\tresult.Changed = true\n240|\treturn result, nil\n241|}\n242|\n243|type migrationFile interface {\n244|\tio.Writer\n245|\tName() string\n246|\tChmod(fs.FileMode) error\n247|\tSync() error\n248|\tClose() error\n249|}\n250|\n251|type migrationDirectory interface {\n252|\tSync() error\n253|\tClose() error\n254|}\n255|\n256|type migrationFileSystem interface {\n257|\tCreateTemp(string, string) (migrationFile, error)\n258|\tLink(string, string) error\n259|\tReadFile(string) ([]byte, error)\n260|\tStat(string) (fs.FileInfo, error)\n261|\tRemove(string) error\n262|\tRename(string, string) error\n263|\tOpenDirectory(string) (migrationDirectory, error)\n264|}\n265|\n266|type osMigrationFileSystem struct{}\n267|\n268|func (osMigrationFileSystem) CreateTemp(dir, pattern string) (migrationFile, error) {\n269|\treturn os.CreateTemp(dir, pattern)\n270|}\n271|func (osMigrationFileSystem) Link(oldname, newname string) error   { return os.Link(oldname, newname) }\n272|func (osMigrationFileSystem) ReadFile(name string) ([]byte, error) { return os.ReadFile(name) }\n273|\n274|// Stat does not follow a symlink, unlike the symlink-following read-side seam\n275|// in OSInputs. Durable migration replaces the selected file with an atomic\n276|// rename, which replaces a symlink itself rather than its target: migrating a\n277|// symlinked configuration would silently detach the operator's link and leave\n278|// the real document holding stale bytes next to a backup of the resolved\n279|// target. The specification is silent here, so the mutating path fails closed\n280|// with ErrConfigNotRegular instead of guessing which file the operator meant.\n281|func (osMigrationFileSystem) Stat(name string) (fs.FileInfo, error) { return os.Lstat(name) }\n282|func (osMigrationFileSystem) Remove(name string) error              { return os.Remove(name) }\n283|func (osMigrationFileSystem) Rename(oldname, newname string) error {\n284|\treturn os.Rename(oldname, newname)\n285|}\n286|func (osMigrationFileSystem) OpenDirectory(name string) (migrationDirectory, error) {\n287|\treturn os.Open(name)\n288|}\n289|\n290|// replaceDurably publishes a byte-exact backup of the pre-migration\n291|// configuration document, then installs the replacement. Backup contents\n292|// classification: the backup is a copy of configuration bytes only (host\n293|// and peer UUIDs, names, endpoints, SSH arguments) and never carries\n294|// private key material, which lives exclusively under\n295|// STATE_DIR/host-channel/credentials/. The custody contract for backups is:\n296|// staged 0600 with group/world-clean verification (Unix owner-only), and\n297|// published names matched by hosttrust.ExcludedConfigDirName so every\n298|// replication, snapshot, clone or diagnostic surface must drop them. On\n299|// Windows the backup DACL inherits the user-profile ACL; that inheritance\n300|// is a stated bound, not owner-only evidence.\n301|func replaceDurably(filesystem migrationFileSystem, filename, backup string, original, replacement []byte) error {\n302|\tdirectory := filepath.Dir(filename)\n303|\t// Re-inspect the selected file before anything durable is written. Load\n304|\t// resolved and validated it through the symlink-following read seam; this\n305|\t// mutating seam does not follow symlinks, so a selected file that is not\n306|\t// itself a regular file is refused here rather than after a backup has\n307|\t// already been published. A refused migration therefore leaves the\n308|\t// directory exactly as it found it, and the captured permission bits are\n309|\t// the ones the replacement inherits.\n310|\tinfo, err := filesystem.Stat(filename)\n311|\tif err != nil {\n312|\t\treturn migrationError(MigrationError{Operation: \"inspect source mode\", Err: errors.Join(ErrMigrationWrite, err)})\n313|\t}\n314|\tif !info.Mode().IsRegular() {\n315|\t\treturn migrationError(MigrationError{Operation: \"inspect source mode\", Err: errors.Join(ErrMigrationWrite, ErrConfigNotRegular)})\n316|\t}\n317|\tbackupTemp, err := writeTempFile(filesystem, directory, \".ax-config-backup-*\", original, 0o600)\n318|\tif err != nil {\n319|\t\treturn migrationError(MigrationError{Operation: \"write backup\", Err: errors.Join(ErrMigrationBackup, err)})\n320|\t}\n321|\tif err := filesystem.Link(backupTemp, backup); err != nil {\n322|\t\tif !errors.Is(err, fs.ErrExist) {\n323|\t\t\t_ = filesystem.Remove(backupTemp)\n324|\t\t\treturn migrationError(MigrationError{Operation: \"publish backup\", Err: errors.Join(ErrMigrationBackup, err)})\n325|\t\t}\n326|\t\texisting, readErr := filesystem.ReadFile(backup)\n327|\t\tinfo, statErr := filesystem.Stat(backup)\n328|\t\tif readErr != nil || statErr != nil || !bytes.Equal(existing, original) || info.Mode().Perm()&0o077 != 0 {\n329|\t\t\t_ = filesystem.Remove(backupTemp)\n330|\t\t\treturn migrationError(MigrationError{Operation: \"verify backup\", Err: ErrMigrationBackup})\n331|\t\t}\n332|\t}\n333|\tif err := filesystem.Remove(backupTemp); err != nil && !errors.Is(err, fs.ErrNotExist) {\n334|\t\treturn migrationError(MigrationError{Operation: \"remove backup staging file\", Err: errors.Join(ErrMigrationBackup, err)})\n335|\t}\n336|\t// Retry the directory sync even when an exact backup already exists: it may\n337|\t// be the visible result of an interrupted run whose directory fsync failed.\n338|\tif err := syncDirectory(filesystem, directory); err != nil {\n339|\t\treturn migrationError(MigrationError{Operation: \"sync backup directory\", Err: errors.Join(ErrMigrationSync, err)})\n340|\t}\n341|\n342|\treplacementTemp, err := writeTempFile(filesystem, directory, \".ax-config-migrate-*\", replacement, info.Mode().Perm())\n343|\tif err != nil {\n344|\t\treturn migrationError(MigrationError{Operation: \"write replacement\", Err: errors.Join(ErrMigrationWrite, err)})\n345|\t}\n346|\tif err := filesystem.Rename(replacementTemp, filename); err != nil {\n347|\t\t_ = filesystem.Remove(replacementTemp)\n348|\t\treturn migrationError(MigrationError{Operation: \"replace source\", Err: errors.Join(ErrMigrationReplace, err)})\n349|\t}\n350|\tif err := syncDirectory(filesystem, directory); err == nil {\n351|\t\treturn nil\n352|\t} else {\n353|\t\tsyncErr := err\n354|\t\trollbackTemp, rollbackErr := writeTempFile(filesystem, directory, \".ax-config-rollback-*\", original, info.Mode().Perm())\n355|\t\tif rollbackErr == nil {\n356|\t\t\trollbackErr = filesystem.Rename(rollbackTemp, filename)\n357|\t\t}\n358|\t\tif rollbackErr == nil {\n359|\t\t\trollbackErr = syncDirectory(filesystem, directory)\n360|\t\t}\n361|\t\tif rollbackErr != nil {\n362|\t\t\tif rollbackTemp != \"\" {\n363|\t\t\t\t_ = filesystem.Remove(rollbackTemp)\n364|\t\t\t}\n365|\t\t\treturn migrationError(MigrationError{Operation: \"recover source after sync\", Err: errors.Join(ErrMigrationSync, ErrMigrationRecovery, syncErr, rollbackErr)})\n366|\t\t}\n367|\t\treturn migrationError(MigrationError{Operation: \"sync replacement directory\", Err: errors.Join(ErrMigrationSync, syncErr)})\n368|\t}\n369|}\n370|\n371|func writeTempFile(filesystem migrationFileSystem, directory, pattern string, document []byte, mode fs.FileMode) (name string, err error) {\n372|\tfile, err := filesystem.CreateTemp(directory, pattern)\n373|\tif err != nil {\n374|\t\treturn \"\", err\n375|\t}\n376|\tname = file.Name()\n377|\tclean := func(cause error) (string, error) {\n378|\t\t_ = file.Close()\n379|\t\t_ = filesystem.Remove(name)\n380|\t\treturn \"\", cause\n381|\t}\n382|\tif err := file.Chmod(mode); err != nil {\n383|\t\treturn clean(err)\n384|\t}\n385|\tif err := writeAll(file, document); err != nil {\n386|\t\treturn clean(err)\n387|\t}\n388|\tif err := file.Sync(); err != nil {\n389|\t\treturn clean(err)\n390|\t}\n391|\tif err := file.Close(); err != nil {\n392|\t\t_ = filesystem.Remove(name)\n393|\t\treturn \"\", err\n394|\t}\n395|\treturn name, nil\n396|}\n397|\n398|func writeAll(writer io.Writer, document []byte) error {\n399|\tfor len(document) > 0 {\n400|\t\twritten, err := writer.Write(document)\n401|\t\tif err != nil {\n402|\t\t\treturn err\n403|\t\t}\n404|\t\tif written == 0 {\n405|\t\t\treturn io.ErrShortWrite\n406|\t\t}\n407|\t\tdocument = document[written:]\n408|\t}\n409|\treturn nil\n410|}\n411|\n412|func syncDirectory(filesystem migrationFileSystem, directory string) error {\n413|\thandle, err := filesystem.OpenDirectory(directory)\n414|\tif err != nil {\n415|\t\treturn err\n416|\t}\n417|\tif err := handle.Sync(); err != nil {\n418|\t\t_ = handle.Close()\n419|\t\treturn err\n420|\t}\n421|\treturn handle.Close()\n422|}\n423|\n424|// Indirections keep compatibility-envelope parsing in this file while using\n425|// the same TOML implementation as Decode.\n426|var tomlDecode = func(document []byte, destination any) error {\n427|\treturn toml.Unmarshal(document, destination)\n428|}\n429|\n430|// migrationError is the only construction site for *MigrationError, for the\n431|// same reason loaderError is the only construction site for *Error.\n432|var migrationError = func(value MigrationError) error {\n433|\treturn &value\n434|}","final_result":true}}}
