{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca9d","stream":{"kind":"session","id":"01a0abb3-41ff-7191-99eb-aba32c3c39db"},"sequence":937,"recorded_at":1780531400001869,"record_type":"event","durability":"durable","causation_id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114","run_stream":{"kind":"run","id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114"},"task_stream":{"kind":"task","id":"01a0abb9-c8ee-7293-9248-91e609ce12e4"},"task_id":"01a0abb9-c8ee-7293-9248-91e609ce12e4","event":{"kind":"output","task_id":"01a0abb9-c8ee-7293-9248-91e609ce12e4","chunk":"Read text file `internal/hosttrust/lock_unix.go`.\n1|//go:build darwin || linux\n2|\n3|package hosttrust\n4|\n5|import (\n6|\t\"errors\"\n7|\t\"os\"\n8|\t\"sync\"\n9|\n10|\t\"golang.org/x/sys/unix\"\n11|)\n12|\n13|// fileLock is the machine-local cross-process authorization lock shared by\n14|// trust changes and Configuration 4.0.0 peer/credential changes. Readers hold\n15|// it shared; transactions hold it exclusive, so a revocation or config commit\n16|// can never land between a dispatch check and its side-effect boundary.\n17|//\n18|// Every acquisition opens its own file description: flock locks attach to the\n19|// open file description, so goroutines sharing one retained descriptor would\n20|// not serialize. Per-acquisition descriptors make both same-process\n21|// goroutines and separate processes block on a held exclusive lock. A caller\n22|// must never request a second acquisition while holding one in the same\n23|// goroutine; internal reads nested inside a holder use descriptor-direct\n24|// unlocked reads instead of re-acquiring.\n25|type fileLock struct {\n26|\tpath string\n27|}\n28|\n29|// lockInitMu serializes concurrent creation of the lock file itself.\n30|var lockInitMu sync.Mutex\n31|\n32|// openLock attaches to the shared lock file, creating it exactly once\n33|// across all processes. Creation is atomic and non-replacing\n34|// (O_CREAT|O_EXCL): a process that observes absence while another process\n35|// creates the lock loses the race and opens the existing inode instead of\n36|// renaming over a live lock, so concurrent first-open can never split the\n37|// authorization lock across two inodes.\n38|func openLock(filesystem FileSystem, path string) (*fileLock, error) {\n39|\tlockInitMu.Lock()\n40|\tdefer lockInitMu.Unlock()\n41|\t_, err := filesystem.Lstat(path)\n42|\tif err == nil {\n43|\t\tif err := verifyLockFile(filesystem, path); err != nil {\n44|\t\t\treturn nil, err\n45|\t\t}\n46|\t\treturn &fileLock{path: path}, nil\n47|\t}\n48|\tif !os.IsNotExist(err) {\n49|\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n50|\t}\n51|\tif err := filesystem.CreateExclusive(path, 0o600); err != nil {\n52|\t\t// Lost the creation race: another process published the lock\n53|\t\t// first. Open the existing inode; never replace it.\n54|\t\tif !isLockExistsError(err) {\n55|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n56|\t\t}\n57|\t\tif err := verifyLockFile(filesystem, path); err != nil {\n58|\t\t\treturn nil, err\n59|\t\t}\n60|\t\treturn &fileLock{path: path}, nil\n61|\t}\n62|\tif err := filesystem.Chmod(path, 0o600); err != nil {\n63|\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n64|\t}\n65|\tif err := secureStaged(path, false); err != nil {\n66|\t\treturn nil, err\n67|\t}\n68|\tinfo, err := filesystem.Lstat(path)\n69|\tif err != nil {\n70|\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n71|\t}\n72|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n73|\t\treturn nil, err\n74|\t}\n75|\treturn &fileLock{path: path}, nil\n76|}\n77|\n78|// isLockExistsError reports a lost creation race: the lock file already\n79|// exists, so the caller must open it rather than publish over it.\n80|func isLockExistsError(err error) bool {\n81|\treturn os.IsExist(err) || errors.Is(err, unix.EEXIST)\n82|}\n83|\n84|// openLockFD opens one private file description for a single acquisition.\n85|// O_NOFOLLOW refuses symlink escapes at open time; the descriptor never\n86|// follows a link swapped in after Lstat.\n87|func openLockFD(path string) (int, error) {\n88|\tfd, err := unix.Open(path, unix.O_RDWR|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)\n89|\tif err != nil {\n90|\t\tjoined := errors.Join(ErrTrustStoreUnreadable, err)\n91|\t\tif errors.Is(err, unix.ELOOP) {\n92|\t\t\tjoined = errors.Join(ErrTrustUnsafeCustody, err)\n93|\t\t}\n94|\t\treturn -1, trustError(TrustError{Operation: \"open lock\", Err: joined})\n95|\t}\n96|\treturn fd, nil\n97|}\n98|\n99|func (lock *fileLock) shared() (func(), error) {\n100|\tfd, err := openLockFD(lock.path)\n101|\tif err != nil {\n102|\t\treturn nil, err\n103|\t}\n104|\tif err := unix.Flock(fd, unix.LOCK_SH); err != nil {\n105|\t\t_ = unix.Close(fd)\n106|\t\treturn nil, err\n107|\t}\n108|\treturn func() {\n109|\t\t_ = unix.Flock(fd, unix.LOCK_UN)\n110|\t\t_ = unix.Close(fd)\n111|\t}, nil\n112|}\n113|\n114|func (lock *fileLock) exclusive() (func(), error) {\n115|\tfd, err := openLockFD(lock.path)\n116|\tif err != nil {\n117|\t\treturn nil, err\n118|\t}\n119|\tif err := unix.Flock(fd, unix.LOCK_EX); err != nil {\n120|\t\t_ = unix.Close(fd)\n121|\t\treturn nil, err\n122|\t}\n123|\treturn func() {\n124|\t\t_ = unix.Flock(fd, unix.LOCK_UN)\n125|\t\t_ = unix.Close(fd)\n126|\t}, nil\n127|}","final_result":true}}}
