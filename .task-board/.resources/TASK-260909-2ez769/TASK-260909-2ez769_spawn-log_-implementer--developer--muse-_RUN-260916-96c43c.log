t\\treturn failed(trustError(TrustError{Operation: \\\"validate joint restore\\\", Err: ErrJointIntervened}))\\n\\t\\t}\\n\\t\\tif err := restore(); err != nil {\\n\\t\\t\\treturn failed(err)\\n\\t\\t}\", \"PRESERVE-TOKEN order swap: verifies before restoring while keeping every call, so the static call-site gate still passes and only the behavioral suite can fail\", \"TestJointCommitCompensatesBumpFailure\"),\n54|]\n55|\n56|BOUNDS = {\n57| \"neutral\": \"Equivalent arithmetic; no independent kill claimed.\",\n58|}\n59|\n60|def main():\n61|    parser = argparse.ArgumentParser(description=__doc__)\n62|    parser.add_argument(\"--output\", required=True)\n63|    parser.add_argument(\"--only\", help=\"Comma-separated probe names for a bounded follow-up\")\n64|    opts = parser.parse_args()\n65|    if opts.only and not set(opts.only.split(\",\")).issubset({p[0] for p in PROBES}):\n66|        parser.error(\"--only contains an unknown probe\")\n67|    out = Path(opts.output).resolve()\n68|    out.mkdir(parents=True, exist_ok=True)\n69|    results = []\n70|    unexpected = False\n71|    for name, path, old, new, narrows, expected_test in PROBES:\n72|        if opts.only and name not in opts.only.split(\",\"):\n73|            continue\n74|        source = ROOT / path\n75|        original = source.read_bytes()\n76|        text = original.decode()\n77|        if text.count(old) != 1:\n78|            raise RuntimeError(f\"{name}: plant must match exactly once, got {text.count(old)}\")\n79|        folder = out / name\n80|        folder.mkdir(exist_ok=True)\n81|        replacement = folder / source.name\n82|        replacement.write_text(text.replace(old, new, 1))\n83|        overlay = folder / \"overlay.json\"\n84|        overlay.write_text(json.dumps({\"Replace\": {str(source): str(replacement)}}))\n85|        command = [\"go\", \"test\", \"-overlay\", str(overlay), \"./internal/hosttrust\", \"-count=1\", \"-json\", \"-timeout=120s\", \"-run\", TESTS]\n86|        proc = subprocess.run(command, cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=300)\n87|        (folder / \"test.log\").write_bytes(proc.stdout)\n88|        events = []\n89|        for line in proc.stdout.decode(errors=\"replace\").splitlines():\n90|            try:\n91|                events.append(json.loads(line))\n92|            except json.JSONDecodeError:\n93|                pass\n94|        failed = [e[\"Test\"] for e in events if e.get(\"Action\") == \"fail\" and \"Test\" in e]\n95|        passed = [e[\"Test\"] for e in events if e.get(\"Action\") == \"pass\" and \"Test\" in e]\n96|        killed = proc.returncode != 0 and bool(failed) and (expected_test is None or expected_test in failed)\n97|        if name == \"neutral\":\n98|            valid = proc.returncode == 0 and bool(passed)\n99|            state = \"neutral passed\" if valid else \"invalid control\"\n100|        elif name in BOUNDS:\n101|            valid = proc.returncode == 0 and bool(passed)\n102|            state = \"survived\" if valid else \"unexpected result\"\n103|        else:\n104|            valid = killed\n105|            state = \"killed\" if killed else \"survived\" if proc.returncode == 0 and passed else \"invalid instrument/compile failure\"\n106|        if not valid:\n107|            unexpected = True\n108|        if source.read_bytes() != original:\n109|            raise RuntimeError(f\"{name}: source changed during overlay run\")\n110|        row = {\"mutant\": name, \"narrowing\": narrows, \"exit_code\": proc.returncode, \"result\": state,\n111|               \"named_failing_tests\": failed, \"expected_test\": expected_test,\n112|               \"bound\": BOUNDS.get(name, \"\" if killed or name == \"neutral\" else \"No named failing test established; this gate member is unproven.\"),\n113|               \"command\": command}\n114|        results.append(row)\n115|        print(f\"{name}: {state}, exit={proc.returncode}, tests={','.join(failed)}\", flush=True)\n116|        (out / \"results.json\").write_text(json.dumps(results, indent=2) + \"\\n\")\n117|    rows = [\"| Mutant | What the gate is narrowed to admit | Named failing test | Exit | Result / surviving bound |\",\n118|            \"| --- | --- | --- | ---: | --- |\"]\n119|    for r in results:\n120|        tests = r[\"expected_test\"] if r[\"expected_test\"] in r[\"named_failing_tests\"] else \", \".join(r[\"named_failing_tests\"])\n121|        rows.append(f'| {r[\"mutant\"]} | {r[\"narrowing\"]} | {tests or \"none\"} | {r[\"exit_code\"]} | {r[\"result\"]}: {r[\"bound\"]} |')\n122|    (out / \"table.md\").write_text(\"\\n\".join(rows)+\"\\n\")\n123|    return int(unexpected)\n124|\n125|\n126|if __name__ == \"__main__\":\n127|    sys.exit(main())","final_result":true}}}
