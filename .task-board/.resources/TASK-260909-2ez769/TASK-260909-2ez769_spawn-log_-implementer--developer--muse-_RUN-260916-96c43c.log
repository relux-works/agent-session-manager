ename+\\\".bak.3.0.0\\\")\\n556-\\tif err := os.WriteFile(fixture.store.PendingCommitPath(), []byte(marker), 0o600); err != nil {\\n557-\\t\\tt.Fatal(err)\\n558-\\t}\\n559-\\tresult, err := Migrate(fixture.inputs, nil, MigrationOptions{\\n560-\\t\\tTargetVersion: Version2, GeneratedSummaryUpgradeChoice: \\\"reference_only\\\",\\n561-\\t})\\n562-\\tif err != nil {\\n563-\\t\\tt.Fatalf(\\\"Migrate(v1 to v2) error = %v\\\", err)\\n564-\\t}\\n565-\\tif !result.Changed || result.SourceVersion != Version1 || result.TargetVersion != Version2 {\\n566-\\t\\tt.Fatalf(\\\"Migrate(v1 to v2) result = %#v\\\", result)\\n567-\\t}\\n568-\\tif coherent, err := LoadCoherent(fixture.inputs, nil, fixture.store); err == nil {\\n569-\\t\\tt.Fatalf(\\\"LoadCoherent(diverged legacy) admitted generation %d, want refusal\\\", coherent.Generation)\\n570-\\t} else if !errors.Is(err, hosttrust.ErrJointIntervened) {\\n571-\\t\\tt.Fatalf(\\\"LoadCoherent error = %v, want ErrJointIntervened\\\", err)\\n572-\\t}\\n573-\\tassertMarkerKept(t, fixture.store)\\n574-\\tif _, err := hosttrust.Open(fixture.stateDir); err == nil {\\n575-\\t\\tt.Fatal(\\\"hosttrust.Open(diverged legacy) succeeded, want refusal\\\")\\n576-\\t} else if !errors.Is(err, hosttrust.ErrJointIntervened) {\\n577-\\t\\tt.Fatalf(\\\"hosttrust.Open error = %v, want ErrJointIntervened\\\", err)\\n578-\\t}\\n579-}\\n\",\n  \"original_output_bytes\": 2022,\n  \"original_output_tokens\": 506,\n  \"truncated\": false\n}","final_result":true}}}
