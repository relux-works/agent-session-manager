ry, \"config.toml\")\n45|\tif err := os.WriteFile(filename, document, 0o600); err != nil {\n46|\t\tt.Fatal(err)\n47|\t}\n48|\tinputs := Inputs{\n49|\t\tPlatform: scalar.PlatformMacOS, HomeDir: directory, TempDir: directory, WorkingDir: directory,\n50|\t\tLookupEnv: func(name string) (string, bool) {\n51|\t\t\tswitch name {\n52|\t\t\tcase \"AX_CONFIG\":\n53|\t\t\t\treturn filename, true\n54|\t\t\tcase \"AX_STATE_DIR\":\n55|\t\t\t\treturn stateDir, true\n56|\t\t\t}\n57|\t\t\treturn \"\", false\n58|\t\t},\n59|\t\tStat: os.Stat, ReadFile: os.ReadFile,\n60|\t}\n61|\tstore, err := hosttrust.Open(stateDir)\n62|\tif err != nil {\n63|\t\tt.Fatalf(\"hosttrust.Open error = %v\", err)\n64|\t}\n65|\tif _, err := store.Initialize(); err != nil {\n66|\t\tt.Fatalf(\"Initialize error = %v\", err)\n67|\t}\n68|\tnow := time.Now().UTC().Truncate(time.Millisecond)\n69|\tself, err := store.Issue(testHostID, now)\n70|\tif err != nil {\n71|\t\tt.Fatalf(\"Issue error = %v\", err)\n72|\t}\n73|\tfor _, peer := range peers {\n74|\t\tissuer, err := hosttrust.Open(t.TempDir())\n75|\t\tif err != nil {\n76|\t\t\tt.Fatal(err)\n77|\t\t}\n78|\t\tif _, err := issuer.Initialize(); err != nil {\n79|\t\t\tt.Fatal(err)\n80|\t\t}\n81|\t\tcredential, err := issuer.Issue(peer, now)\n82|\t\tif err != nil {\n83|\t\t\tt.Fatal(err)\n84|\t\t}\n85|\t\tsnapshot, err := issuer.ReadSnapshot()\n86|\t\tif err != nil {\n87|\t\t\tt.Fatal(err)\n88|\t\t}\n89|\t\tmaterial, err := hosttrust.ExportEnrollment(snapshot, credential)\n90|\t\tif err != nil {\n91|\t\t\tt.Fatal(err)\n92|\t\t}\n93|\t\tif _, err := store.Enroll(hosttrust.EnrollInput{HostID: material.HostID, LeafDER: material.LeafDER, RootDER: material.RootDER, Authorized: material.Fingerprints, EnrolledAt: now}); err != nil {\n94|\t\t\tt.Fatalf(\"Enroll(%s) error = %v\", peer, err)\n95|\t\t}\n96|\t}\n97|\treturn &v4Fixture{directory: directory, filename: filename, stateDir: stateDir, inputs: inputs, store: store, self: self, now: now}\n98|}\n99|\n100|func (fixture *v4