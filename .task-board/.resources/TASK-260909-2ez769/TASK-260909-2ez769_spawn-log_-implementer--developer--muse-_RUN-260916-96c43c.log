d (outside recovery\n209|// itself) must have converged pending joint intent first.\n210|func loadCommitted(filesystem FileSystem, root string) (TrustStore, error) {\n211|\tpath := filepath.Join(root, trustFileName)\n212|\tinfo, err := filesystem.Lstat(path)\n213|\tif err != nil {\n214|\t\tif os.IsNotExist(err) {\n215|\t\t\treturn TrustStore{}, trustError(TrustError{Operation: \"read committed trust\", Err: ErrTrustStoreMissing})\n216|\t\t}\n217|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"read committed trust\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n218|\t}\n219|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n220|\t\treturn TrustStore{}, err\n221|\t}\n222|\tdocument, err := filesystem.ReadFile(path)\n223|\tif err != nil {\n224|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"read committed trust\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n225|\t}\n226|\tdecoded, err := DecodeTrust(document)\n227|\tif err != nil {\n228|\t\treturn TrustStore{}, err\n229|\t}\n230|\treturn decoded, nil\n231|}\n232|\n233|// commitDocument stages bytes in a temp file with fsync, atomically renames\n234|// over the target, and fsyncs the directory. On restart only the last fully\n235|// committed file is selected; staged files are ignored by every reader.\n236|func commitDocument(filesystem FileSystem, root, path string, document []byte) error {\n237|\tstaged, err := filesystem.CreateTemp(root, stagePrefix+\"*\", 0o600)\n238|\tif err != nil {\n239|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n240|\t}\n241|\tname := staged.Name()\n242|\tfailed := true\n243|\tdefer func() {\n244|\t\tif failed {\n245|\t\t\t_ = filesystem.Remove(name)\n246|\t\t}\n247|\t}()\n248|\tif err := writeAll(staged, document); err != nil {\n249|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n250|\t}\n251|\tif err := staged.Sync(); err != nil {\n252|\t\t_ = staged.Close()\n253|\t\treturn trustError(TrustError{Operation: \"sync trust\", Err: errors.Join(ErrTrustDurability, err)})\n254|\t}\n255|\tif err := staged.Close(); err != nil {\n256|\t\treturn trustError(TrustError{Operation: \"sync trust\", Err: errors.Join(ErrTrustDurability, err)})\n257|\t}\n258|\tif err := filesystem.Chmod(name, 0o600); err != nil {\n259|\t\treturn trustError(TrustError{Operation: \"stage trust\", Err: errors.Join(ErrTrustDurability, err)})\n260|\t}\n261|\t// On platforms where mode bits do not govern access, install the\n262|\t// owner-only ACL before the staging file becomes visible under load.\n263|\tif err := secureStaged(name, false); err != nil {\n264|\t\treturn err\n265|\t}\n266|\tif err := filesystem.Rename(name, path); err != nil {\n267|\t\treturn trustError(TrustError{Operation: \"replace trust\", Err: errors.Join(ErrTrustDurability, err)})\n268|\t}\n269|\tif err := syncDir(filesystem, root); err != nil {\n270|\t\treturn trustError(TrustError{Operation: \"sync trust directory\", Err: errors.Join(ErrTrustDurability, err)})\n271|\t}\n272|\tfailed = false\n273|\treturn nil\n274|}\n275|\n276|func writeAll(writer interface{ Write([]byte) (int, error) }, document []byte) error {\n277|\tfor len(document) > 0 {\n278|\t\twritten, err := writer.Write(document)\n279|\t\tif err != nil {\n280|\t\t\treturn err\n281|\t\t}\n282|\t\tif written == 0 {\n283|\t\t\treturn errors.New(\"short trust write\")\n284|\t\t}\n285|\t\tdocument = document[written:]\n286|\t}\n287|\treturn nil\n288|}\n289|\n290|func syncDir(filesystem FileSystem, root string) error {\n291|\thandle, err := filesystem.OpenDirectory(root)\n292|\tif err != nil {\n293|\t\treturn err\n294|\t}\n295|\tif err := handle.Sync(); err != nil {\n296|\t\t_ = handle.Close()\n297|\t\treturn err\n298|\t}\n299|\treturn handle.Close()\n300|}","final_result":true}}}
