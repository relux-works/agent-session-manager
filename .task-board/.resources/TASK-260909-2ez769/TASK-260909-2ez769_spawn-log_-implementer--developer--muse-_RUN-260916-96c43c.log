5|// creates the lock loses the race and opens the existing inode instead of\n36|// renaming over a live lock, so concurrent first-open can never split the\n37|// authorization lock across two inodes.\n38|func openLock(filesystem FileSystem, path string) (*fileLock, error) {\n39|\tlockInitMu.Lock()\n40|\tdefer lockInitMu.Unlock()\n41|\t_, err := filesystem.Lstat(path)\n42|\tif err == nil {\n43|\t\tif err := verifyLockFile(filesystem, path); err != nil {\n44|\t\t\treturn nil, err\n45|\t\t}\n46|\t\treturn &fileLock{path: path}, nil\n47|\t}\n48|\tif !os.IsNotExist(err) {\n49|\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n50|\t}\n51|\tif err := filesystem.CreateExclusive(path, 0o600); err != nil {\n52|\t\t// Lost the creation race: another process published the lock\n53|\t\t// first. Open the existing inode; never replace it.\n54|\t\tif !isLockExistsError(err) {\n55|\t\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n56|\t\t}\n57|\t\tif err := verifyLockFile(filesystem, path); err != nil {\n58|\t\t\treturn nil, err\n59|\t\t}\n60|\t\treturn &fileLock{path: path}, nil\n61|\t}\n62|\tif err := filesystem.Chmod(path, 0o600); err != nil {\n63|\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustUnsafeCustody, err)})\n64|\t}\n65|\tif err := secureStaged(path, false); err != nil {\n66|\t\treturn nil, err\n67|\t}\n68|\tinfo, err := filesystem.Lstat(path)\n69|\tif err != nil {\n70|\t\treturn nil, trustError(TrustError{Operation: \"open lock\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n71|\t}\n72|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n73|\t\treturn nil, err\n74|\t}\n75|\treturn &fileLock{path: path}, nil\n76|}\n77|\n78|// isLockExistsError reports a lost creation race: the lock file already\n79|// exists, so the caller must open it rather than publish over it.\n80|func isLockExistsError