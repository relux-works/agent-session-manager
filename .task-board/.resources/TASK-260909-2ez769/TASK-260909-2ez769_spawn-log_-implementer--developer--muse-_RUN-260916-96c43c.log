{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca99","stream":{"kind":"session","id":"01a0abb3-41ff-7191-99eb-aba32c3c39db"},"sequence":935,"recorded_at":1780531400001865,"record_type":"event","durability":"durable","causation_id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114","run_stream":{"kind":"run","id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114"},"task_stream":{"kind":"task","id":"01a0abb9-c94b-7f60-8e09-ea565b6f6278"},"task_id":"01a0abb9-c94b-7f60-8e09-ea565b6f6278","event":{"kind":"output","task_id":"01a0abb9-c94b-7f60-8e09-ea565b6f6278","chunk":"Read text file `internal/hosttrust/errors.go`.\n1|package hosttrust\n2|\n3|import \"errors\"\n4|\n5|var (\n6|\t// ErrTrustDecode reports JSON syntax or shape failures without\n7|\t// echoing machine-local bytes. Rendered messages stay static.\n8|\tErrTrustDecode = errors.New(\"host trust document decode failed\")\n9|\t// ErrTrustValidation reports a well-formed document that violates the\n10|\t// closed Host Trust Store 1.0.0 contract.\n11|\tErrTrustValidation = errors.New(\"host trust document validation failed\")\n12|\t// ErrTrustStoreMissing reports a missing store. It is never an empty\n13|\t// store: callers must run explicit setup instead of inferring one.\n14|\tErrTrustStoreMissing = errors.New(\"host trust store is missing\")\n15|\t// ErrTrustStoreUnreadable reports permission, ownership or I/O failures.\n16|\tErrTrustStoreUnreadable = errors.New(\"host trust store is unreadable\")\n17|\t// ErrTrustUnsafeCustody reports owner-only violations: group/world\n18|\t// access, foreign ownership, or symlink/reparse escapes.\n19|\tErrTrustUnsafeCustody = errors.New(\"host trust custody is not owner-only\")\n20|\t// ErrTrustDurability reports a failed atomic commit. A failed commit is\n21|\t// a failure, never absence or success.\n22|\tErrTrustDurability = errors.New(\"host trust durable commit failed\")\n23|\t// ErrGenerationExhausted reports a mutation refused because the uint53\n24|\t// generation counter cannot increment again.\n25|\tErrGenerationExhausted = errors.New(\"host trust generation exhausted\")\n26|\t// ErrStaleGeneration reports a dispatch or mutation attempted under a\n27|\t// superseded authorization generation.\n28|\tErrStaleGeneration = errors.New(\"host trust authorization generation is stale\")\n29|\t// ErrEnrollmentRefused reports an enrollment tuple the operator\n30|\t// authorization or the uniqueness rules reject.\n31|\tErrEnrollmentRefused = errors.New(\"host trust enrollment refused\")\n32|\t// ErrRotationRefused reports a rotation outside the fresh-key bounded\n33|\t// window: same-key renewal, a second rotation over a retiring entry, or\n34|\t// more than two non-revoked credentials for one host.\n35|\tErrRotationRefused = errors.New(\"host credential rotation refused\")\n36|\t// ErrRevocationRefused reports a revocation with nothing to revoke.\n37|\tErrRevocationRefused = errors.New(\"host credential revocation refused\")\n38|\t// ErrCredentialProfile reports issued or imported bytes outside Host\n39|\t// Credential Profile 1.\n40|\tErrCredentialProfile = errors.New(\"host credential profile check failed\")\n41|\t// ErrCredentialCustody reports private/public mismatch, wrong host\n42|\t// binding, or unreadable custody files at use time.\n43|\tErrCredentialCustody = errors.New(\"host credential custody check failed\")\n44|\t// ErrAuthorizationRefused reports a dispatch or mutation boundary that\n45|\t// fails current-generation, validity, allowlist or hello checks.\n46|\tErrAuthorizationRefused = errors.New(\"host channel authorization refused\")\n47|\t// ErrNotAllowlisted reports a TLS-authenticated peer that is not on the\n48|\t// local allowlist. The string is the spec refusal identity shared with\n49|\t// peeridentity.ErrNotAllowlisted; hosttrust cannot import peeridentity\n50|\t// (import cycle), so a test pins the two strings equal.\n51|\tErrNotAllowlisted = errors.New(\"peer_not_allowlisted\")\n52|\t// ErrHostIdentityMismatch reports a hello host ID that differs from the\n53|\t// uniquely verified enrolled host UUID. The string is the spec refusal\n54|\t// identity shared with peeridentity.ErrHostIdentityMismatch; pinned\n55|\t// equal by test for the same reason as ErrNotAllowlisted.\n56|\tErrHostIdentityMismatch = errors.New(\"host_identity_mismatch\")\n57|\t// ErrInvalidStoreContext reports a store rooted outside an absolute\n58|\t// state directory or otherwise unusable as machine-local authority.\n59|\tErrInvalidStoreContext = errors.New(\"invalid host trust store context\")\n60|\t// ErrJointReplacementDurable reports a joint commit whose external\n61|\t// replacement was durable but whose generation bump failed. The source\n62|\t// bytes are restored and the intent marker aborts under the same\n63|\t// exclusive hold, so the operation fails cleanly with no generation\n64|\t// change; a compensation that cannot complete instead joins\n65|\t// ErrJointCompensationFailed with the marker kept.\n66|\tErrJointReplacementDurable = errors.New(\"host trust joint replacement durable without generation\")\n67|\t// ErrJointCompensationFailed reports error compensation that could not\n68|\t// restore the source and abort the intent marker: the restore failed,\n69|\t// the marker or the configuration moved outside the confirmed pins, or\n70|\t// the marker is unreadable. The marker is kept for operator\n71|\t// resolution and the configuration stays at the replacement, which\n72|\t// restart recovery completes forward once the fault heals.\n73|\tErrJointCompensationFailed = errors.New(\"host trust joint error compensation failed\")\n74|\t// ErrJointIntervened reports a joint config-plus-trust commit that\n75|\t// cannot converge: the configuration or the generation moved outside\n76|\t// the confirmed pins while the intent marker was outstanding. The\n77|\t// marker is kept for operator resolution; the restart refuses.\n78|\tErrJointIntervened = errors.New(\"host trust joint commit was superseded\")\n79|)\n80|\n81|// TrustError renders a static clause without machine-local values, paths,\n82|// fingerprints, UUIDs or key material. Wrapped details stay available to\n83|// errors.Is/errors.As through Unwrap.\n84|type TrustError struct {\n85|\tOperation string\n86|\tErr       error\n87|}\n88|\n89|func (err *TrustError) Error() string { return \"host trust \" + err.Operation + \" failed\" }\n90|func (err *TrustError) Unwrap() error { return err.Err }\n91|\n92|// trustError is the only construction site for *TrustError.\n93|var trustError = func(value TrustError) error { return &value }","final_result":true}}}
