{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c893","stream":{"kind":"session","id":"01a0abb3-41ff-7191-99eb-aba32c3c39db"},"sequence":676,"recorded_at":1780531400001347,"record_type":"event","durability":"durable","causation_id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114","run_stream":{"kind":"run","id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114"},"task_stream":{"kind":"task","id":"01a0abb6-28b4-7aa3-b3e5-3c4f6a302398"},"task_id":"01a0abb6-28b4-7aa3-b3e5-3c4f6a302398","event":{"kind":"output","task_id":"01a0abb6-28b4-7aa3-b3e5-3c4f6a302398","chunk":"Read text file `internal/hosttrust/joint.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"crypto/sha256\"\n6|\t\"encoding/hex\"\n7|\t\"encoding/json\"\n8|\t\"errors\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\t\"strconv\"\n12|)\n13|\n14|// pendingCommitFileName is the durable intent marker for one joint\n15|// config-plus-trust commit. It lives beside trust.json under the same\n16|// owner-only custody and crash-durable write discipline.\n17|const pendingCommitFileName = \"pending-commit.json\"\n18|\n19|// Joint operations coupled to a trust generation bump.\n20|const (\n21|\tJointApplyV4    = \"apply-v4\"\n22|\tJointRollbackV4 = \"rollback-v4\"\n23|)\n24|\n25|// PendingCommit is the durable intent record for one joint commit. The\n26|// hashes pin the exact configuration bytes the operator confirmed; the\n27|// source generation pins the trust state they were rendered against. Only\n28|// the confirmed replacement may complete forward; anything else aborts or\n29|// refuses on restart.\n30|type PendingCommit struct {\n31|\tSchema            string `json:\"schema\"`\n32|\tSchemaVersion     string `json:\"schema_version\"`\n33|\tOperation         string `json:\"operation\"`\n34|\tConfigPath        string `json:\"config_path\"`\n35|\tSourceSHA256      string `json:\"source_sha256\"`\n36|\tReplacementSHA256 string `json:\"replacement_sha256\"`\n37|\tSourceGeneration  uint64 `json:\"source_generation\"`\n38|\tBackupPath        string `json:\"backup_path\"`\n39|}\n40|\n41|// SHA256HexOf returns the lowercase hex SHA-256 of document bytes for\n42|// marker pins. It exposes no key material: markers pin configuration bytes\n43|// only, never credentials.\n44|func SHA256HexOf(document []byte) string {\n45|\tdigest := sha256.Sum256(document)\n46|\treturn hex.EncodeToString(digest[:])\n47|}\n48|\n49|func encodePendingCommit(marker PendingCommit) ([]byte, error) {\n50|\tif err := checkPendingCommit(marker); err != nil {\n51|\t\treturn nil, err\n52|\t}\n53|\tdocument, err := json.Marshal(marker)\n54|\tif err != nil {\n55|\t\treturn nil, trustError(TrustError{Operation: \"encode joint commit\", Err: errors.Join(ErrTrustDurability, err)})\n56|\t}\n57|\treturn document, nil\n58|}\n59|\n60|func checkPendingCommit(marker PendingCommit) error {\n61|\tconst operation = \"validate joint commit\"\n62|\tif marker.Schema != \"urn:ax:schema:host-pending-commit\" || marker.SchemaVersion != \"1.0.0\" {\n63|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n64|\t}\n65|\tif marker.Operation != JointApplyV4 && marker.Operation != JointRollbackV4 {\n66|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n67|\t}\n68|\tif !filepath.IsAbs(marker.ConfigPath) || marker.BackupPath == \"\" {\n69|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n70|\t}\n71|\tfor _, digest := range []string{marker.SourceSHA256, marker.ReplacementSHA256} {\n72|\t\traw, err := hex.DecodeString(digest)\n73|\t\tif err != nil || len(raw) != sha256.Size {\n74|\t\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n75|\t\t}\n76|\t}\n77|\tif marker.SourceSHA256 == marker.ReplacementSHA256 {\n78|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n79|\t}\n80|\tif marker.SourceGeneration == 0 || marker.SourceGeneration > MaxGeneration {\n81|\t\treturn trustError(TrustError{Operation: operation, Err: ErrTrustValidation})\n82|\t}\n83|\treturn nil\n84|}\n85|\n86|func decodePendingCommit(document []byte) (PendingCommit, error) {\n87|\tvar marker PendingCommit\n88|\tif err := rejectDuplicateKeys(document); err != nil {\n89|\t\treturn PendingCommit{}, err\n90|\t}\n91|\t// The generation must be a bare JSON number, never a quoted string:\n92|\t// validate it through the same uint53 discipline as the trust document\n93|\t// before the struct decode, so a quoted number refuses as invalid\n94|\t// state rather than as a syntax error.\n95|\traw := map[string]json.RawMessage{}\n96|\tdecoder := json.NewDecoder(bytes.NewReader(document))\n97|\tdecoder.UseNumber()\n98|\tif err := decoder.Decode(&raw); err != nil {\n99|\t\treturn PendingCommit{}, trustError(TrustError{Operation: \"decode joint commit\", Err: errors.Join(ErrTrustDecode, err)})\n100|\t}\n101|\tgeneration, err := decodeMarkerGeneration(raw)\n102|\tif err != nil {\n103|\t\treturn PendingCommit{}, err\n104|\t}\n105|\tdecoder = json.NewDecoder(bytes.NewReader(document))\n106|\tdecoder.DisallowUnknownFields()\n107|\tdecoder.UseNumber()\n108|\tif err := decoder.Decode(&marker); err != nil {\n109|\t\treturn PendingCommit{}, trustError(TrustError{Operation: \"decode joint commit\", Err: errors.Join(ErrTrustDecode, err)})\n110|\t}\n111|\tif decoder.More() {\n112|\t\treturn PendingCommit{}, trustError(TrustError{Operation: \"decode joint commit\", Err: ErrTrustDecode})\n113|\t}\n114|\tmarker.SourceGeneration = generation\n115|\tif err := checkPendingCommit(marker); err != nil {\n116|\t\treturn PendingCommit{}, err\n117|\t}\n118|\treturn marker, nil\n119|}\n120|\n(more lines below)","final_result":true}}}
