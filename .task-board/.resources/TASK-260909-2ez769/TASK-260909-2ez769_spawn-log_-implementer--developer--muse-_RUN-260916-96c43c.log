rser.add_argument(\"--only\", help=\"Comma-separated probe names for a bounded follow-up\")\n34|    opts = parser.parse_args()\n35|    if opts.only and not set(opts.only.split(\",\")).issubset({p[0] for p in PROBES}):\n36|        parser.error(\"--only contains an unknown probe\")\n37|    out = Path(opts.output).resolve()\n38|    out.mkdir(parents=True, exist_ok=True)\n39|    results = []\n40|    unexpected = False\n41|    for name, path, old, new, narrows, expected_test in PROBES:\n42|        if opts.only and name not in opts.only.split(\",\"):\n43|            continue\n44|        source = ROOT / path\n45|        original = source.read_bytes()\n46|        text = original.decode()\n47|        if text.count(old) != 1:\n48|            raise RuntimeError(f\"{name}: plant must match exactly once, got {text.count(old)}\")\n49|        folder = out / name\n50|        folder.mkdir(exist_ok=True)\n51|        replacement = folder / source.name\n52|        replacement.write_text(text.replace(old, new, 1))\n53|        overlay = folder / \"overlay.json\"\n54|        overlay.write_text(json.dumps({\"Replace\": {str(source): str(replacement)}}))\n55|        command = [\"go\", \"test\", \"-overlay\", str(overlay), \"./internal/config\", \"-count=1\", \"-json\", \"-timeout=120s\", \"-run\", TESTS]\n56|        proc = subprocess.run(command, cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=300)\n57|        (folder / \"test.log\").write_bytes(proc.stdout)\n58|        events = []\n59|        for line in proc.stdout.decode(errors=\"replace\").splitlines():\n60|            try:\n61|                events.append(json.loads(line))\n62|            except json.JSONDecodeError:\n63|                pass\n64|        failed = [e[\"Test\"] for e in events if e.get(\"Action\") == \"fail\" and \"Test\" in e]\n65|        passed = [e[\"Test\"] for e in events if e.get(\"Action\") == \"pass\" and \"Test\" in e]\n66|        killed = proc.returncode != 0 and bool(failed) and (expected_test is None or expected_test in failed)\n67|        if name == \"neutral\":\n68|            valid = proc.returncode == 0 and bool(passed)\n69|            state = \"neutral passed\" if valid else \"invalid control\"\n70|        elif name in BOUNDS:\n71|            valid = proc.returncode == 0 and bool(passed)\n72|            state = \"survived\" if valid else \"unexpected result\"\n73|        else:\n74|            valid = killed\n75|            state = \"killed\" if killed else \"survived\" if proc.returncode == 0 and passed else \"invalid instrument/compile failure\"\n76|        if not valid:\n77|            unexpected = True\n78|        if source.read_bytes() != original:\n79|            raise RuntimeError(f\"{name}: source changed during overlay run\")\n80|        row = {\"mutant\": name, \"narrowing\": narrows, \"exit_code\": proc.returncode, \"result\": state,\n81|               \"named_failing_tests\": failed, \"expected_test\": expected_test,\n82|               \"bound\": BOUNDS.get(name, \"\" if killed or name == \"neutral\" else \"No named failing test established; this gate member is unproven.\"),\n83|               \"command\": command}\n84|        results.append(row)\n85|        print(f\"{name}: {state}, exit={proc.returncode}, tests={','.join(failed)}\", flush=True)\n86|        (out / \"results.json\").write_text(json.dumps(results, indent=2) + \"\\n\")\n87|    rows = [\"| Mutant | What the gate is narrowed to admit | Named failing test | Exit | Result / surviving bound |\",\n88|            \"| --- | --- | --- | ---: | --- |\"]\n89|    for r in results:\n90|        tests = r[\"expected_test\"] if r[\"expected_test\"] in r[\"named_failing_tests\"] else \", \".join(r[\"named_failing_tests\"])\n91|        rows.append(f'| {r[\"mutant\"]} | {r[\"narrowing\"]} | {tests or \"none\"} | {r[\"exit_code\"]} | {r[\"result\"]}: {r[\"bound\"]} |')\n92|    (out / \"table.md\").write_text(\"\\n\".join(rows)+\"\\n\")\n93|    return int(unexpected)\n94|\n95|\n96|if __name__ == \"__main__\":\n97|    sys.exit(main())","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
