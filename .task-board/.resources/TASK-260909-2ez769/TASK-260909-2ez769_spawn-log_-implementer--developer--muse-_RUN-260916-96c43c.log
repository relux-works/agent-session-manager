\n+// STATE_DIR/host-channel/credentials/. The custody contract for backups is:\n+// staged 0600 with group/world-clean verification (Unix owner-only), and\n+// published names matched by hosttrust.ExcludedConfigDirName so every\n+// replication, snapshot, clone or diagnostic surface must drop them. On\n+// Windows the backup DACL inherits the user-profile ACL; that inheritance\n+// is a stated bound, not owner-only evidence.\n+func replaceDurably(hold hosttrust.HeldExclusive, filesystem migrationFileSystem, filename, backup string, original, replacement []byte) error {\n+\tif err := requireHold(hold); err != nil {\n+\t\treturn err\n+\t}\n+\treturn replaceDurablyStandalone(filesystem, filename, backup, original, replacement)\n+}\n+\n+// replaceDurablyStandalone is the unheld durable replacement behind\n+// replaceDurably. Its only hold-less caller is the legacy migration path\n+// for inputs without a machine-local store context, where no joint\n+// writer can exist; every other pair write goes through replaceDurably\n+// with a live hold. The write-path census gate enforces that boundary.\n+func replaceDurablyStandalone(filesystem migrationFileSystem, filename, backup string, original, replacement []byte) error {\n","edit_facts":{"tool_name":"edit_file","path":"internal/config/migration.go","added":26,"removed":12},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
