08|\tresult := MigrationResult{SourceVersion: loaded.SourceVersion, TargetVersion: options.TargetVersion}\n209|\tif compareSemver(source, target) > 0 {\n210|\t\treturn result, migrationError(MigrationError{Operation: \"select target\", Err: ErrMigrationDowngrade})\n211|\t}\n212|\tif compareSemver(source, target) == 0 {\n213|\t\treturn result, nil\n214|\t}\n215|\tif loaded.SourceVersion == Version1 {\n216|\t\tif !oneOf(options.GeneratedSummaryUpgradeChoice, \"local_only\", \"mesh_sanitized\", \"reference_only\") {\n217|\t\t\treturn result, migrationError(MigrationError{Operation: \"validate disclosure choice\", Err: ErrMigrationChoiceRequired})\n218|\t\t}\n219|\t\tloaded.Value.Directory.GeneratedSummaryUpgradeChoice = options.GeneratedSummaryUpgradeChoice\n220|\t}\n221|\tcontext := DecodeContext{RuntimePlatform: inputs.Platform, BackendSettings: inputs.BackendSettings}\n222|\tvar replacement []byte\n223|\tswitch options.TargetVersion {\n224|\tcase Version2:\n225|\t\treplacement, err = encodeVersion2(loaded.Value, context)\n226|\tcase CurrentVersion:\n227|\t\treplacement, err = EncodeCurrent(loaded.Value, context)\n228|\t}\n229|\tif err != nil {\n230|\t\treturn result, migrationError(MigrationError{Operation: \"encode target\", Err: err}) // config-refusal-subsumed: every encoder refusal below this propagation is pinned on its own clause, at writer.go terminal.backend and writer.go v2 wire TOML for the v2 encoder, at writer.go v2 re-read for its defence-in-depth round trip, and by the EncodeCurrent validation suite for v3\n231|\t}\n232|\tselected, _ := snapshot.Paths().Path(ConfigFile)\n233|\tfilename := selected.Value.String()\n234|\tbackup := filename + \".bak.\" + loaded.SourceVersion\n235|\tresult.BackupPath = backup\n236|\tif err := replaceDurably(filesystem, filename, backup, snapshot.Document(), replacement); err != nil {\n237|\t\treturn result, err\n238|\t}\n239|\tresult.Changed = true\n240|\treturn result, nil\n241|}\n242|\n243|type migrationFile interface {\n244|\tio.Writer\n245|\tName() string\n246|\tChmod(fs.FileMode) error\n247|\tSync() error\n248|\tClose() error\n249|}\n250|\n251|type migrationDirectory interface {\n252|\tSync() error\n253|\tClose() error\n254|}\n255|\n256|type migrationFileSystem interface {\n257|\tCreateTemp(string, string) (migrationFile, error)\n258|\tLink(string, string) error\n259|\tReadFile(string) ([]byte, error)\n260|\tStat(string) (fs.FileInfo, error)\n261|\tRemove(string) error\n262|\tRename(string, string) error\n263|\tOpenDirectory(string) (migrationDirectory, error)\n264|}\n265|\n266|type osMigrationFileSystem struct{}\n267|\n268|func (osMigrationFileSystem) CreateTemp(dir, pattern string) (migrationFile, error) {\n269|\treturn os.CreateTemp(dir, pattern)\n270|}\n271|func (osMigrationFileSystem) Link(oldname, newname string) error   { return os.Link(oldname, newname) }\n272|func (osMigrationFileSystem) ReadFile(name string) ([]byte, error) { return os.ReadFile(name) }\n273|\n274|// Stat does not follow a symlink, unlike the symlink-following read-side seam\n275|// in OSInputs. Durable migration replaces the selected file with an atomic\n276|// rename, which replaces a symlink itself rather than its target: migrating a\n277|// symlinked configuration would silently detach the operator's link and leave\n278|// the real document holding stale bytes next to a backup of the resolved\n279|// target. The specification is silent here, so the mutating path fails closed\n280|// with ErrConfigNotRegular instead of guessing which file the operator meant.\n281|func (osMigrationFileSystem) Stat(name string) (fs.FileInfo, error) { return os.Lstat(name) }\n282|func (osMigrationFileSystem) Remove(name string) error              { return os.Remove(name) }\n283|func (osMigrationFileSystem) Rename(oldname, newname string) error {\n284|\treturn os.Rename(oldname, newname)\n285|}\n286|func (osMigrationFileSystem) OpenDirectory(name string) (migrationDirectory, error) {\n287|\treturn os.Open(name)\n288|}\n289|\n290|// replaceDurably publishes a byte-exact backup of the pre-migration\n291|// configuration document, then installs the replacement. Backup contents\n292|// classification: the backup is a copy of configuration bytes only (host\n293|// and peer UUIDs, names, endpoints, SSH arguments) and never carries\n294|// private key material, which lives exclusively under\n295|// STATE_DIR/host-channel/credentials/. The custody contract for backups is:\n296|// staged 0600 with group/world-clean verification (Unix owner-only), and\n297|// published names matched by hosttrust.ExcludedConfigDirName so every\n298|// replication, snapshot, clone or diagnostic surface must drop them. On\n299|// Windows the backup DACL inherits the user-profile ACL; that inheritance\n300|// is a stated bound, not owner-only evidence.\n301|func replaceDurably(filesystem migrationFileSystem, filename, backup string, original, replacement []byte) error {\n302|\tdirectory := filepath.Dir(filename)\n303|\t// Re-inspect the selected file before anything durable is written. Load\n304|\t// resolved and validated it through the symlink-following read seam; this\n305|\t// mutating seam does not follow symlinks, so a selected file that is not\n306|\t// itself a regular file is refused here rather than after a backup has\n307|\t// already been published. A refused migration therefore leaves the\n308|\t// directory exactly as it found it, and the captured permission bits are\n309|\t// the ones the replacement inherits.\n310|\tinfo, err := filesystem.Stat(filename)\n311|\tif err != nil {\n312|\t\treturn migrationError(MigrationError{Operation: \"inspect source mode\", Err: errors.Join(ErrMigrationWrite, err)})\n313|\t}\n314|\tif !info.Mode().IsRegular() {\n315|\t\treturn migrationError(MigrationError{Operation: \"inspect source mode\", Err: errors.Join(ErrMigrationWrite, ErrConfigNotRegular)})\n316|\t}\n317|\tbackupTemp, err := writeTempFile(filesystem, directory, \".ax-config-backup-*\", original, 0o600)\n318|\tif err != nil {\n319|\t\treturn migrationError(MigrationError{Operation: \"write backup\", Err: errors.Join(ErrMigrationBackup, err)})\n320|\t}\n321|\tif err := filesystem.Link(backupTemp, backup); err != nil {\n322|\t\tif !errors.Is(err, fs.ErrExist) {\n323|\t\t\t_ = filesystem.Remove(backupTemp)\n324|\t\t\treturn migrationError(MigrationError{Operation: \"publish backup\", Err: errors.Join(ErrMigrationBackup, err)})\n325|\t\t}\n326|\t\texisting, readErr := filesystem.ReadFile(backup)\n327|\t\tinfo, statErr := filesystem.Stat(backup)\n328|\t\tif readErr != nil || statErr != nil || !bytes.Equal(existing, original) || info.Mode().Perm()&0o077 != 0 {\n329|\t\t\t_ = filesystem.Remove(backupTemp)\n330|\t\t\treturn migrationError(MigrationError{Operation: \"verify backup\", Err: ErrMigrationBackup})\n331|\t\t}\n332|\t}\n333|\tif err := filesystem.Remove(backupTemp); err != nil && !errors.Is(err, fs.ErrNotExist) {\n334|\t\treturn migrationError(MigrationError{Operation: \"remove backup staging file\", Err: errors.Join(ErrMigrationBackup, err)})\n335|\t}\n336|\t// Retry the directory sync even when an exact backup already exists: it may\n337|\t// be the visible result of an interrupted run whose directory fsync failed.\n338|\tif err := syncDirectory(filesystem, directory); err != nil {\n339|\t\treturn migrationError(MigrationError{Operation: \"sync backup directory\", Err: errors.Join(ErrMigrationSync, err)})\n340|\t}\n341|\n342|\treplacementTemp, err := writeTempFile(filesystem, directory, \".ax-config-migrate-*\", replacement, info.Mode().Perm())\n343|\tif err != nil {\n344|\t\treturn migrationError(MigrationError{Operation: \"write replacement\", Err: errors.Join(ErrMigrationWrite, err)})\n345|\t}\n346|\tif err := filesystem.Rename(replacementTemp, filename); err != nil {\n347|\t\t_ = filesystem.Remove(replacementTemp)\n348|\t\treturn migrationError(MigrationError{Operation: \"replace source\", Err: errors.Join(ErrMigrationReplace, err)})\n349|\t}\n350|\tif err := syncDirectory(filesystem, directory); err == nil {\n351|\t\treturn nil\n352|\t} else {\n353|\t\tsyncErr := err\n354|\t\trollbackTemp, rollbackErr := writeTempFile(filesystem, directory, \".ax-config-rollback-*\", original, info.Mode().Perm())\n355|\t\tif rollbackErr == nil {\n356|\t\t\trollbackErr = filesystem.Rename(rollbackTemp, filename)\n357|\t\t}\n358|\t\tif rollbackErr == nil {\n359|\t\t\trollbackErr = syncDirectory(filesystem, directory)\n360|\t\t}\n361|\t\tif rollbackErr != nil {\n362|\t\t\tif rollbackTemp != \"\" {\n363|\t\t\t\t_ = filesystem.Remove(rollbackTemp)\n364|\t\t\t}\n365|\t\t\treturn migrationError(MigrationError{Operation: \"recover source after sync\", Err: errors.Join(ErrMigrationSync, ErrMigrationRecovery, syncErr, rollbackErr)})\n366|\t\t}\n367|\t\treturn migrationError(MigrationError{Operation: \"sync replacement directory\", Err: errors.Join(ErrMigrationSync, syncErr)})\n368|\t}\n369|}\n370|\n371|func writeTempFile(filesystem migrationFileSystem, directory, pattern string, document []byte, mode fs.FileMode) (name string, err error) {\n372|\tfile, err := filesystem.CreateTemp(directory, pattern)\n373|\tif err != nil {\n374|\t\treturn \"\", err\n375|\t}\n376|\tname = file.Name()\n377|\tclean := func(cause error) (string, error) {\n378|\t\t_ = file.Close()\n379|\t\t_ = filesystem.Remove(name)\n380|\t\treturn \"\", cause\n381|\t}\n382|\tif err := file.Chmod(mode); err != nil {\n383|\t\treturn clean(err)\n384|\t}\n385|\tif err := writeAll(file, document); err != nil {\n386|\t\treturn clean(err)\n387|\t}\n388|\tif err := file.Sync(); err != nil {\n389|\t\treturn clean(err)\n390|\t}\n391|\tif err := file.Close(); err != nil {\n392|\t\t_ = filesystem.Remove(name)\n393|\t\treturn \"\", err\n394|\t}\n395|\treturn name, nil\n396|}\n397|\n398|func writeAll(writer io.Writer, document []byte) error {\n399|\tfor len(document) > 0 {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
