{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c961","stream":{"kind":"session","id":"01a0abb3-41ff-7191-99eb-aba32c3c39db"},"sequence":779,"recorded_at":1780531400001553,"record_type":"event","durability":"durable","causation_id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114","run_stream":{"kind":"run","id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114"},"call_id":"call_01a0abb6631876a2a3daade804d5e384","text":"Read text file `internal/config/migration_v4_helpers.go`.\n1|package config\n2|\n3|import (\n4|\t\"crypto/x509\"\n5|\t\"errors\"\n6|\t\"path/filepath\"\n7|\t\"strings\"\n8|\t\"time\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/hosttrust\"\n11|)\n12|\n13|// CoherentSnapshot is one coherent configuration-plus-trust read: the\n14|// trust generation and the configuration document observed under the same\n15|// shared authorization hold, so no trust or config commit can land between\n16|// them. Streams and dispatches bind Generation; any use must re-check\n17|// currency before crossing a side-effect boundary.\n18|type CoherentSnapshot struct {\n19|\tConfig     Snapshot\n20|\tTrust      hosttrust.TrustStore\n21|\tGeneration uint64\n22|}\n23|\n24|// LoadCoherent is the production pairing for readers that must never mix an\n25|// old allowlist with new credentials (Section 11.10.3): it holds the\n26|// authorization lock across the committed trust read and the configuration\n27|// load, converging pending joint intent first so a surviving reader\n28|// observes the same pair as a reopened store. PreviewV4 callers that hold\n29|// only a separately read trust snapshot should obtain the pair here\n30|// instead.\n31|func LoadCoherent(inputs Inputs, overrides Overrides, store *hosttrust.Store) (CoherentSnapshot, error) {\n32|\tvar coherent CoherentSnapshot\n33|\tif store == nil {\n34|\t\treturn CoherentSnapshot{}, migrationError(MigrationError{Operation: \"load coherent snapshot\", Err: hosttrust.ErrTrustStoreMissing})\n35|\t}\n36|\tif err := store.WithSharedSnapshot(func(current hosttrust.TrustStore) error {\n37|\t\tsnapshot, err := Load(inputs, overrides)\n38|\t\tif err != nil {\n39|\t\t\treturn err\n40|\t\t}\n41|\t\tcoherent = CoherentSnapshot{Config: snapshot, Trust: current, Generation: current.Generation}\n42|\t\treturn nil\n43|\t}); err != nil {\n44|\t\treturn CoherentSnapshot{}, err\n45|\t}\n46|\treturn coherent, nil\n47|}\n48|\n49|func stateDirOf(snapshot Snapshot) string {\n50|\tpath, ok := snapshot.Paths().Path(StateRoot)\n51|\tif !ok {\n52|\t\treturn \"\"\n53|\t}\n54|\treturn path.Value.String()\n55|}\n56|\n57|func previewCredentialHex(credentialID string) string {\n58|\treturn strings.TrimPrefix(credentialID, \"sha256:\")\n59|}\n60|\n61|func findTrustEntry(trust hosttrust.Snapshot, credentialID string) (hosttrust.CredentialEntry, bool) {\n62|\tfor _, entry := range trust.Trust.Entries {\n63|\t\tif entry.CredentialID.String() == credentialID {\n64|\t\t\treturn entry, true\n65|\t\t}\n66|\t}\n67|\treturn hosttrust.CredentialEntry{}, false\n68|}\n69|\n70|// checkCredentialWindow enforces current validity of both certificates\n71|// against the actual local UTC time, inclusively within notBefore/notAfter\n72|// with no extra acceptance skew or expiry grace.\n73|func checkCredentialWindow(leafDER, rootDER []byte, now time.Time) error {\n74|\tleaf, err := x509.ParseCertificate(leafDER)\n75|\tif err != nil {\n76|\t\treturn err\n77|\t}\n78|\troot, err := x509.ParseCertificate(rootDER)\n79|\tif err != nil {\n80|\t\treturn err\n81|\t}\n82|\tinstant := now.UTC()\n83|\tfor _, certificate := range []*x509.Certificate{leaf, root} {\n84|\t\tif instant.Before(certificate.NotBefore) || instant.After(certificate.NotAfter) {\n85|\t\t\treturn errors.New(\"credential outside validity window\")\n86|\t\t}\n87|\t}\n88|\treturn nil\n89|}\n90|\n91|func peerEnrolled(trust hosttrust.Snapshot, hostID string, now time.Time) bool {\n92|\tfor _, entry := range trust.Trust.Entries {\n93|\t\tif entry.HostID.String() != hostID || entry.State != hosttrust.EntryActive {\n94|\t\t\tcontinue\n95|\t\t}\n96|\t\tif checkCredentialWindow(entry.LeafDER, entry.RootDER, now) == nil {\n97|\t\t\treturn true\n98|\t\t}\n99|\t}\n100|\treturn false\n101|}\n102|\n103|// writeTempReplace durably restores document over filename after a trust\n104|// commit failure. It is recovery, not a migration: no backup is published.\n105|// It runs only from the JointCommit restore closures under the exclusive\n106|// authorization hold (see the rev6 write-path census); the census gate\n107|// fails any other caller.\n108|func writeTempReplace(filesystem migrationFileSystem, filename string, document []byte) (string, error) {\n109|\tdirectory := filepath.Dir(filename)\n110|\tstaged, err := writeTempFile(filesystem, directory, \".ax-config-restore-*\", document, 0o600)\n111|\tif err != nil {\n112|\t\treturn \"\", err\n113|\t}\n114|\tif err := filesystem.Rename(staged, filename); err != nil {\n115|\t\t_ = filesystem.Remove(staged)\n116|\t\treturn \"\", err\n117|\t}\n118|\tif err := syncDirectory(filesystem, directory); err != nil {\n119|\t\treturn \"\", err\n120|\t}\n121|\treturn staged, nil\n122|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c963","stream":{"kind":"session","id":"01a0abb3-41ff-7191-99eb-aba32c3c39db"},"sequence":780,"recorded_at":1780531400001555,"record_type":"event","durability":"durable","causation_id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114","run_stream":{"kind":"run","id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114"},"call_id":"call_01a0abb663d0764dbd9c7fa432e1d7c3","text":"Read text file `internal/config/writepath_census_test.go`.\n1|package config\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"go/ast\"\n6|\t\"go/parser\"\n7|\t\"go/token\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"runtime\"\n11|\t\"sort\"\n12|\t\"strings\"\n13|\t\"testing\"\n14|)\n15|\n16|// This file enforces the rev6 write-path census statically: every\n17|// filesystem mutation of the config-plus-trust pair must happen through\n18|// an allowlisted helper from a lock-held context. The census itself is\n19|// the board outcome TASK-260909-2ez769_write-path-census-rev6.md; this\n20|// gate fails when a new pair mutation appears outside the censused rows.\n21|//\n22|// Rules (see the census for the per-row rationale):\n23|//   A. config pair writes (replaceDurably, writeTempReplace) run either\n24|//      inside a closure passed directly to hosttrust JointCommit (which\n25|//      holds the exclusive authorization lock across replace, bump and\n26|//      compensation) or in the legacy migrate path, which is fail-closed\n27|//      against joint intent (TestLegacyMigrateBesideMarkerRefusesConvergence).\n28|//   B. trust/marker writes (commitDocument, removeMarkerLocked) run only\n29|//      in JointCommit, transactLocked, Initialize, recoverLocked and\n30|//      compensateLocked, all under the exclusive hold.\n31|//   C. credential-file writes (writeCustodyFile) run only in Issue and\n32|//      Rotate, which stage inert files before the admitting trust commit.\n33|//   D. raw filesystem entry mutations (Rename, Remove, CreateTemp,\n34|//      CreateExclusive, Link) run only inside the helpers above, their\n35|//      staging/cleanup sites, and the atomic lock publication. Mode and\n36|//      directory setup (Chmod, MkdirAll) is custody, covered by the\n37|//      custody tests, not by this gate.\n38|//   E. custody constructors (ensureOwnerDir, secureStaged) run only at\n39|//      the censused setup/install sites.\n40|//   F. config staging (writeTempFile) runs only inside the pair writers.\n41|//\n42|// The control TestWritePathGateFlagsUnlockedCaller proves the gate sees\n43|// a new unlocked caller; the compensate-* mutation plants prove the\n44|// underlying gates behaviorally.\n45|\n46|var censusPairHelpers = map[string]bool{\n47|\t\"replaceDurably\":   true,\n48|\t\"writeTempReplace\": true,\n49|}\n50|\n51|var censusTrustHelpers = map[string]map[string]bool{\n52|\t\"commitDocument\": {\n53|\t\t\"transactLocked\": true, \"Initialize\": true, \"JointCommit\": true, \"compensateLocked\": true,\n54|\t},\n55|\t\"removeMarkerLocked\": {\n56|\t\t\"JointCommit\": true, \"recoverLocked\": true, \"compensateLocked\": true,\n57|\t},\n58|}\n59|\n60|var censusCustodyHelpers = map[string]map[string]bool{\n61|\t\"writeCustodyFile\": {\"Issue\": true, \"Rotate\": true},\n62|\t\"writeTempFile\":    {\"replaceDurably\": true, \"writeTempReplace\": true},\n63|\t\"ensureOwnerDir\":   {\"openStore\": true, \"Issue\": true, \"Rotate\": true},\n64|\t\"secureStaged\":     {\"commitDocument\": true, \"writeCustodyFile\": true, \"ensureOwnerDir\": true, \"openLock\": true},\n65|}\n66|\n67|var censusRawMutations = map[string]map[string]bool{\n68|\t\"Rename\": {\n69|\t\t\"commitDocument\": true, \"writeCustodyFile\": true, \"replaceDurably\": true, \"writeTempReplace\": true,\n70|\t},\n71|\t\"Remove\": {\n72|\t\t\"commitDocument\": true, \"writeCustodyFile\": true, \"Issue\": true, \"Rotate\": true,\n73|\t\t\"removeMarkerLocked\": true, \"writeTempFile\": true, \"writeTempReplace\": true, \"replaceDurably\": true,\n74|\t},\n75|\t\"CreateTemp\": {\n76|\t\t\"commitDocument\": true, \"writeCustodyFile\": true, \"writeTempFile\": true,\n77|\t},\n78|\t\"CreateExclusive\": {\"openLock\": true},\n79|\t\"Link\":            {\"replaceDurably\": true},\n80|}\n81|\n82|// censusBackendReceivers are the production filesystem backends: their\n83|// methods implement the seams, so calls inside them are the definition\n84|// of the interface, not new write paths.\n85|var censusBackendReceivers = map[string]bool{\n86|\t\"osFileSystem\": true, \"osMigrationFileSystem\": true,\n87|}\n88|\n89|// censusPackageIdents are package qualifiers whose method-like selectors\n90|// are stdlib calls, not filesystem-seam mutations.\n91|var censusPackageIdents = map[string]bool{\n92|\t\"os\": true, \"filepath\": true, \"unix\": true, \"windows\": true,\n93|\t\"strings\": true, \"bytes\": true, \"errors\": true, \"fmt\": true,\n94|}\n95|\n96|func censusViolation(format string, args ...any) string {\n97|\treturn fmt.Sprintf(format, args...)\n98|}\n99|\n100|// censusViolations scans the non-test Go sources under dirs and reports\n101|// every pair mutation outside the censused rows.\n102|func censusViolations(t *testing.T, dirs ...string) []string {\n103|\tt.Helper()\n104|\tvar violations []string\n105|\tfor _, dir := range dirs {\n106|\t\tfileset := token.NewFileSet()\n107|\t\t// Parse non-test files individually: test files stage fixtures\n108|\t\t// through direct writes by design and are not production paths.\n109|\t\tentries, err := filepath.Glob(filepath.Join(dir, \"*.go\"))\n110|\t\tif err != nil {\n111|\t\t\tt.Fatalf(\"glob %s: %v\", dir, err)\n112|\t\t}\n113|\t\tfor _, path := range entries {\n114|\t\t\tif strings.HasSuffix(path, \"_test.go\") {\n115|\t\t\t\tcontinue\n116|\t\t\t}\n117|\t\t\tfile, err := parser.ParseFile(fileset, path, nil, 0)\n118|\t\t\tif err != nil {\n119|\t\t\t\tt.Fatalf(\"parse %s: %v\", path, err)\n120|\t\t\t}\n121|\t\t\tviolations = append(violations, censusFileViolations(fileset, file)...)\n122|\t\t}\n123|\t}\n124|\tsort.Strings(violations)\n125|\treturn violations\n126|}\n127|\n128|func censusFileViolations(fileset *token.FileSet, file *ast.File) []string {\n129|\tvar violations []string\n130|\tfor _, decl := range file.Decls {\n131|\t\tfunction, ok := decl.(*ast.FuncDecl)\n132|\t\tif !ok || function.Body == nil {\n133|\t\t\tcontinue\n134|\t\t}\n135|\t\tif censusIsBackendMethod(function) {\n136|\t\t\tcontinue\n137|\t\t}\n138|\t\tviolations = append(violations, censusWalk(fileset, function.Body, []ast.Node{function}, function.Name.Name)...)\n139|\t}\n140|\treturn violations\n141|}\n142|\n143|func censusIsBackendMethod(function *ast.FuncDecl) bool {\n144|\tif function.Recv == nil {\n145|\t\treturn false\n146|\t}\n147|\tfor _, field := range function.Recv.List {\n148|\t\tname := censusTypeName(field.Type)\n149|\t\tif censusBackendReceivers[name] {\n150|\t\t\treturn true\n151|\t\t}\n152|\t}\n153|\treturn false\n154|}\n155|\n156|func censusTypeName(expression ast.Expr) string {\n157|\tswitch value := expression.(type) {\n158|\tcase *ast.Ident:\n159|\t\treturn value.Name\n160|\tcase *ast.StarExpr:\n161|\t\treturn censusTypeName(value.X)\n162|\tdefault:\n163|\t\treturn \"\"\n164|\t}\n165|}\n166|\n167|// censusWalk attributes every gated call to its enclosing FuncDecl and,\n168|// for the config pair helpers, to the JointCommit-closure rule.\n169|func censusWalk(fileset *token.FileSet, node ast.Node, ancestors []ast.Node, funcName string) []string {\n170|\tvar violations []string\n171|\tpush := append(ancestors, node)\n172|\tswitch value := node.(type) {\n173|\tcase *ast.FuncDecl:\n174|\t\tfuncName = value.Name.Name\n175|\t\tif censusIsBackendMethod(value) {\n176|\t\t\treturn nil\n177|\t\t}\n178|\tcase *ast.CallExpr:\n179|\t\tif violation := censusCallViolation(fileset, value, push, funcName); violation != \"\" {\n180|\t\t\tviolations = append(violations, violation)\n181|\t\t}\n182|\t}\n183|\tfor _, child := range censusChildren(node) {\n184|\t\tviolations = append(violations, censusWalk(fileset, child, push, funcName)...)\n185|\t}\n186|\treturn violations\n187|}\n188|\n189|func censusChildren(node ast.Node) []ast.Node {\n190|\tvar children []ast.Node\n191|\tast.Inspect(node, func(child ast.Node) bool {\n192|\t\tif child == nil || child == node {\n193|\t\t\treturn true\n194|\t\t}\n195|\t\tchildren = append(children, child)\n196|\t\treturn false\n197|\t})\n198|\treturn children\n199|}\n200|\n201|func censusCallName(call *ast.CallExpr) (string, bool) {\n202|\tswitch function := call.Fun.(type) {\n203|\tcase *ast.Ident:\n204|\t\treturn function.Name, true\n205|\tcase *ast.SelectorExpr:\n206|\t\tif ident, ok := function.X.(*ast.Ident); ok && censusPackageIdents[ident.Name] {\n207|\t\t\treturn \"\", false\n208|\t\t}\n209|\t\treturn function.Sel.Name, true\n210|\tdefault:\n211|\t\treturn \"\", false\n212|\t}\n213|}\n214|\n215|func censusCallViolation(fileset *token.FileSet, call *ast.CallExpr, ancestors []ast.Node, funcName string) string {\n216|\tname, ok := censusCallName(call)\n217|\tif !ok {\n218|\t\treturn \"\"\n219|\t}\n220|\tposition := fileset.Position(call.Pos())\n221|\tlocate := func() string {\n222|\t\treturn fmt.Sprintf(\"%s:%d: %s call in %s\", position.Filename, position.Line, name, funcName)\n223|\t}\n224|\tif censusPairHelpers[name] {\n225|\t\tif censusInsideJointCommitClosure(ancestors) || funcName == \"migrate\" {\n226|\t\t\treturn \"\"\n227|\t\t}\n228|\t\treturn censusViolation(\"%s is outside a JointCommit closure and outside legacy migrate\", locate())\n229|\t}\n230|\tif allowed, gated := censusTrustHelpers[name]; gated {\n231|\t\tif allowed[funcName] {\n232|\t\t\treturn \"\"\n233|\t\t}\n234|\t\treturn censusViolation(\"%s is outside the censused lock-held writers\", locate())\n235|\t}\n236|\tif allowed, gated := censusCustodyHelpers[name]; gated {\n237|\t\tif allowed[funcName] {\n238|\t\t\treturn \"\"\n239|\t\t}\n240|\t\treturn censusViolation(\"%s is outside the censused custody sites\", locate())\n241|\t}\n242|\tif allowed, gated := censusRawMutations[name]; gated {\n243|\t\tif allowed[funcName] {\n244|\t\t\treturn \"\"\n245|\t\t}\n246|\t\treturn censusViolation(\"%s is outside the censused mutation helpers\", locate())\n247|\t}\n248|\treturn \"\"\n249|}\n250|\n251|// censusInsideJointCommitClosure reports whether the call sits in a\n252|// function literal passed directly as a JointCommit argument. Ancestors\n253|// run outermost-first, so the literal's parent is the preceding entry;\n254|// the nearest literal decides, conservatively.\n255|func censusInsideJointCommitClosure(ancestors []ast.Node) bool {\n256|\tfor index := len(ancestors) - 1; index >= 0; index-- {\n257|\t\tliteral, ok := ancestors[index].(*ast.FuncLit)\n258|\t\tif !ok {\n259|\t\t\tcontinue\n260|\t\t}\n261|\t\tif index == 0 {\n262|\t\t\treturn false\n263|\t\t}\n264|\t\tparent, ok := ancestors[index-1].(*ast.CallExpr)\n265|\t\tif !ok || !censusIsJointCommitCall(parent) {\n266|\t\t\treturn false\n267|\t\t}\n268|\t\tfor _, argument := range parent.Args {\n269|\t\t\tif argument == ast.Node(literal) {\n270|\t\t\t\treturn true\n271|\t\t\t}\n272|\t\t}\n273|\t\treturn false\n274|\t}\n275|\treturn false\n276|}\n277|\n278|func censusIsJointCommitCall(call *ast.CallExpr) bool {\n279|\tswitch function := call.Fun.(type) {\n280|\tcase *ast.Ident:\n281|\t\treturn function.Name == \"JointCommit\"\n282|\tcase *ast.SelectorExpr:\n283|\t\treturn function.Sel.Name == \"JointCommit\"\n284|\tdefault:\n285|\t\treturn false\n286|\t}\n287|}\n288|\n289|func censusPackageDirs(t *testing.T) (configDir, trustDir string) {\n290|\tt.Helper()\n291|\t_, file, _, ok := runtime.Caller(0)\n292|\tif !ok {\n293|\t\tt.Fatal(\"runtime.Caller failed\")\n294|\t}\n295|\tconfigDir = filepath.Dir(file)\n296|\ttrustDir = filepath.Join(configDir, \"..\", \"hosttrust\")\n297|\treturn configDir, trustDir\n298|}\n299|\n300|func TestWritePathCensusGate(t *testing.T) {\n301|\tconfigDir, trustDir := censusPackageDirs(t)\n302|\tviolations := censusViolations(t, configDir, trustDir)\n303|\tfor _, violation := range violations {\n304|\t\tt.Errorf(\"write-path census violation: %s\", violation)\n305|\t}\n306|}\n307|\n308|// The control plant: the gate must flag a new unlocked caller in a\n309|// synthetic package while passing the censused shapes.\n310|func TestWritePathGateFlagsUnlockedCaller(t *testing.T) {\n311|\tt.Helper()\n312|\twrite := func(t *testing.T, dir, name, body string) {\n313|\t\tt.Helper()\n314|\t\tpath := filepath.Join(dir, name)\n315|\t\tcontent := \"package censuscontrol\\n\\n\" + body\n316|\t\tif err := os.WriteFile(path, []byte(content), 0o600); err != nil {\n317|\t\t\tt.Fatal(err)\n318|\t\t}\n319|\t}\n320|\tt.Run(\"flags unlocked pair write\", func(t *testing.T) {\n321|\t\tdir := t.TempDir()\n322|\t\twrite(t, dir, \"rogue.go\", \"func replaceDurably() {}\\nfunc rogueApply() {\\n\\treplaceDurably()\\n}\\n\")\n323|\t\tviolations := censusViolations(t, dir)\n324|\t\tif len(violations) != 1 || !strings.Contains(violations[0], \"rogueApply\") {\n325|\t\t\tt.Fatalf(\"gate violations = %v, want exactly the rogueApply caller\", violations)\n326|\t\t}\n327|\t})\n328|\tt.Run(\"flags unlocked trust write\", func(t *testing.T) {\n329|\t\tdir := t.TempDir()\n330|\t\twrite(t, dir, \"rogue.go\", \"func commitDocument() {}\\nfunc rogueBump() {\\n\\tcommitDocument()\\n}\\n\")\n331|\t\tviolations := censusViolations(t, dir)\n332|\t\tif len(violations) != 1 || !strings.Contains(violations[0], \"rogueBump\") {\n333|\t\t\tt.Fatalf(\"gate violations = %v, want exactly the rogueBump caller\", violations)\n334|\t\t}\n335|\t})\n336|\tt.Run(\"flags unlocked raw rename\", func(t *testing.T) {\n337|\t\tdir := t.TempDir()\n338|\t\twrite(t, dir, \"rogue.go\", \"type seam interface{ Rename(a, b string) }\\nfunc rogueRename(s seam) {\\n\\ts.Rename(\\\"a\\\", \\\"b\\\")\\n}\\n\")\n339|\t\tviolations := censusViolations(t, dir)\n340|\t\tif len(violations) != 1 || !strings.Contains(violations[0], \"rogueRename\") {\n341|\t\t\tt.Fatalf(\"gate violations = %v, want exactly the rogueRename caller\", violations)\n342|\t\t}\n343|\t})\n344|\tt.Run(\"passes censused shapes\", func(t *testing.T) {\n345|\t\tdir := t.TempDir()\n346|\t\twrite(t, dir, \"clean.go\", \"func replaceDurably() {}\\nfunc writeTempReplace() {}\\n\"+\n347|\t\t\t\"type store struct{}\\nfunc (s store) JointCommit(a, b, c func() error) {}\\n\"+\n348|\t\t\t\"func migrate() {\\n\\treplaceDurably()\\n}\\n\"+\n349|\t\t\t\"func applyV4(s store) {\\n\\ts.JointCommit(func() error { return nil }, func() error {\\n\\t\\treplaceDurably()\\n\\t\\treturn nil\\n\\t}, func() error {\\n\\t\\twriteTempReplace()\\n\\t\\treturn nil\\n\\t})\\n}\\n\")\n350|\t\tif violations := censusViolations(t, dir); len(violations) != 0 {\n351|\t\t\tt.Fatalf(\"gate violations = %v, want none for censused shapes\", violations)\n352|\t\t}\n353|\t})\n354|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
