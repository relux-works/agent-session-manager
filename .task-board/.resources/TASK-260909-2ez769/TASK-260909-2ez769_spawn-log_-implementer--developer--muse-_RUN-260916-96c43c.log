{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca1f","stream":{"kind":"session","id":"01a0abb3-41ff-7191-99eb-aba32c3c39db"},"sequence":874,"recorded_at":1780531400001743,"record_type":"event","durability":"durable","causation_id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114","run_stream":{"kind":"run","id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114"},"task_stream":{"kind":"task","id":"01a0abb9-ad33-7fd1-9abb-6fffc4ee4afe"},"task_id":"01a0abb9-ad33-7fd1-9abb-6fffc4ee4afe","event":{"kind":"output","task_id":"01a0abb9-ad33-7fd1-9abb-6fffc4ee4afe","chunk":"Read text file `internal/hosttrust/transact.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|)\n8|\n9|// Snapshot is one coherent committed read: trust bytes plus the generation\n10|// that authorized them. Streams and dispatches bind this generation; any use\n11|// must re-check currency before crossing a side-effect boundary.\n12|type Snapshot struct {\n13|\tGeneration uint64\n14|\tTrust      TrustStore\n15|}\n16|\n17|// TransactionFunc mutates a copy of the committed trust. Returning nil\n18|// commits with generation+1; returning an error aborts with no durable effect.\n19|type TransactionFunc func(trust *TrustStore) error\n20|\n21|// ReadSnapshot obtains one coherent committed snapshot under a shared lock.\n22|// A missing store is ErrTrustStoreMissing, never an empty store. Unreadable,\n23|// malformed or partially read state refuses; leftover staging files from\n24|// crashed commits are ignored and never selected.\n25|func (store *Store) ReadSnapshot() (Snapshot, error) {\n26|\treturn readSnapshot(store.fs, store.root, store.lock)\n27|}\n28|\n29|// WithSharedSnapshot runs fn under the authorization lock with the\n30|// committed trust, so a config-plus-trust pair observed inside fn is\n31|// coherent: no trust or config commit can land between the trust read and\n32|// fn's own reads. Pending joint intent converges before fn runs, so a\n33|// surviving process observes the same converged pair as a reopened store.\n34|// Callers must not acquire the lock again inside fn; internal reads there\n35|// use the supplied committed value directly.\n36|func (store *Store) WithSharedSnapshot(fn func(current TrustStore) error) error {\n37|\tunlock, err := lockForConvergedRead(store.fs, store.root, store.lock)\n38|\tif err != nil {\n39|\t\treturn err\n40|\t}\n41|\tdefer unlock()\n42|\tsnapshot, err := readSnapshotLocked(store.fs, store.root)\n43|\tif err != nil {\n44|\t\treturn err\n45|\t}\n46|\tcommitted := snapshot.Trust\n47|\tif fn == nil {\n48|\t\treturn trustError(TrustError{Operation: \"read snapshot\", Err: ErrAuthorizationRefused})\n49|\t}\n50|\treturn fn(committed)\n51|}\n52|\n53|func readSnapshot(filesystem FileSystem, root string, lock *fileLock) (Snapshot, error) {\n54|\tunlock, err := lockForConvergedRead(filesystem, root, lock)\n55|\tif err != nil {\n56|\t\treturn Snapshot{}, err\n57|\t}\n58|\tdefer unlock()\n59|\treturn readSnapshotLocked(filesystem, root)\n60|}\n61|\n62|// lockForConvergedRead holds the authorization lock for one coherent read,\n63|// converging pending joint intent first. The fast path keeps the shared\n64|// lock when no marker is present: staging a marker needs the exclusive\n65|// lock, so absence observed under shared hold still holds at the read.\n66|// When a marker is present the shared lock is released before the\n67|// exclusive lock is acquired (a held shared lock can never upgrade in\n68|// place without risking a cross-process upgrade deadlock), the leftover\n69|// converges or refuses, and the read proceeds under the exclusive hold.\n70|// Convergence may move the generation forward; callers compare request\n71|// bindings against the converged read, never by refreshing a stale number.\n72|func lockForConvergedRead(filesystem FileSystem, root string, lock *fileLock) (func(), error) {\n73|\tunlock, err := lock.shared()\n74|\tif err != nil {\n75|\t\treturn nil, trustError(TrustError{Operation: \"lock snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n76|\t}\n77|\tpresent, err := markerPresent(filesystem, root)\n78|\tif err != nil {\n79|\t\tunlock()\n80|\t\treturn nil, err\n81|\t}\n82|\tif !present {\n83|\t\treturn unlock, nil\n84|\t}\n85|\tunlock()\n86|\tunlock, err = lock.exclusive()\n87|\tif err != nil {\n88|\t\treturn nil, trustError(TrustError{Operation: \"lock snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n89|\t}\n90|\tif err := convergeLocked(filesystem, root); err != nil {\n91|\t\tunlock()\n92|\t\treturn nil, err\n93|\t}\n94|\treturn unlock, nil\n95|}\n96|\n97|// readSnapshotLocked reads one coherent committed snapshot assuming the\n98|// caller already holds the authorization lock and has converged pending\n99|// joint intent (see lockForConvergedRead): reading beside an unresolved\n100|// marker would admit a superseded generation with replaced configuration.\n101|func readSnapshotLocked(filesystem FileSystem, root string) (Snapshot, error) {\n102|\tpath := filepath.Join(root, trustFileName)\n103|\tinfo, err := filesystem.Lstat(path)\n104|\tif err != nil {\n105|\t\tif os.IsNotExist(err) {\n106|\t\t\treturn Snapshot{}, trustError(TrustError{Operation: \"read snapshot\", Err: ErrTrustStoreMissing})\n107|\t\t}\n108|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"read snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n109|\t}\n110|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n111|\t\treturn Snapshot{}, err\n112|\t}\n113|\tdocument, err := filesystem.ReadFile(path)\n114|\tif err != nil {\n115|\t\treturn Snapshot{}, trustError(TrustError{Operation: \"read snapshot\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n116|\t}\n117|\tstore, err := DecodeTrust(document)\n118|\tif err != nil {\n119|\t\treturn Snapshot{}, err\n120|\t}\n121|\tre