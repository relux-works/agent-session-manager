{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca61","stream":{"kind":"session","id":"01a0abb3-41ff-7191-99eb-aba32c3c39db"},"sequence":907,"recorded_at":1780531400001809,"record_type":"event","durability":"durable","causation_id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114","run_stream":{"kind":"run","id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114"},"task_stream":{"kind":"task","id":"01a0abb9-b88e-72a3-9dad-ded974ec770c"},"task_id":"01a0abb9-b88e-72a3-9dad-ded974ec770c","event":{"kind":"output","task_id":"01a0abb9-b88e-72a3-9dad-ded974ec770c","chunk":"Read text file `internal/hosttrust/joint.go`.\n(394 line(s) above)\n395|func recoverLocked(filesystem FileSystem, root string) (RecoverResult, error) {\n396|\tconst operation = \"recover joint commit\"\n397|\tpath := pendingPath(root)\n398|\tif _, err := filesystem.Lstat(path); err != nil {\n399|\t\tif os.IsNotExist(err) {\n400|\t\t\treturn RecoverResult{}, nil\n401|\t\t}\n402|\t\treturn RecoverResult{}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n403|\t}\n404|\tinfo, err := filesystem.Lstat(path)\n405|\tif err != nil {\n406|\t\treturn RecoverResult{}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n407|\t}\n408|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n409|\t\treturn RecoverResult{}, err\n410|\t}\n411|\tdocument, err := filesystem.ReadFile(path)\n412|\tif err != nil {\n413|\t\treturn RecoverResult{}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n414|\t}\n415|\tmarker, err := decodePendingCommit(document)\n416|\tif err != nil {\n417|\t\treturn RecoverResult{Found: true}, err\n418|\t}\n419|\tconfiguration, err := filesystem.ReadFile(marker.ConfigPath)\n420|\tif err != nil {\n421|\t\treturn RecoverResult{Found: true}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n422|\t}\n423|\tswitch SHA256HexOf(configuration) {\n424|\tcase marker.ReplacementSHA256:\n425|\t\tcommitted, err := loadCommitted(filesystem, root)\n426|\t\tif err != nil {\n427|\t\t\treturn RecoverResult{Found: true}, err\n428|\t\t}\n429|\t\tswitch committed.Generation {\n430|\t\tcase marker.SourceGeneration:\n431|\t\t\tif err := transactLocked(filesystem, root, func(*TrustStore) error { return nil }); err != nil {\n432|\t\t\t\treturn RecoverResult{Found: true}, err\n433|\t\t\t}\n434|\t\tcase marker.SourceGeneration + 1:\n435|\t\tdefault:\n436|\t\t\treturn RecoverResult{Found: true}, trustError(TrustError{Operation: operation, Err: ErrJointIntervened})\n437|\t\t}\n438|\t\tif err := removeMarkerLocked(filesystem, root); err != nil {\n439|\t\t\treturn RecoverResult{Found: true}, err\n440|\t\t}\n441|\t\treturn RecoverResult{Found: true, Completed: true}, nil\n442|\tcase marker.SourceSHA256:\n443|\t\tif err := removeMarkerLocked(filesystem, root); err != nil {\n444|\t\t\treturn RecoverResult{Found: true}, err\n445|\t\t}\n446|\t\treturn RecoverResult{Found: true, Aborted: true}, nil\n447|\tdefault:\n448|\t\treturn RecoverResult{Found: true}, trustError(TrustError{Operation: operation, Err: ErrJointIntervened})\n449|\t}\n450|}\n451|\n452|func pendingPath(root string) string { return filepath.Join(root, pendingCommitFileName) }\n453|\n454|// markerPresent reports whether a joint-commit intent marker is\n455|// outstanding. Absence must be established, never assumed: an unreadable\n456|// marker path refuses instead of reporting no marker.\n457|func markerPresent(filesystem FileSystem, root string) (bool, error) {\n458|\t_, err := filesystem.Lstat(pendingPath(root))\n459|\tif err == nil {\n460|\t\treturn true, nil\n461|\t}\n462|\tif os.IsNotExist(err) {\n463|\t\treturn false, nil\n464|\t}\n465|\treturn false, trustError(TrustError{Operation: \"inspect joint commit\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n466|}\n467|\n468|// convergeLocked converges one interrupted joint commit, if any, before\n469|// the caller exposes a snapshot or runs a boundary. It is the general\n470|// admission barrier for pending intent: every read, admission and\n471|// transaction entry point converges here under the authorization lock,\n472|// while recovery itself stays the single convergence implementation. The\n473|// caller must hold the exclusive lock: convergence can bump the generation\n474|// and remove the marker. Shared-lock readers upgrade to exclusive when a\n475|// marker is present (see readSnapshot); when no marker is present the\n476|// shared fast path needs no write. A refused recovery fails the caller\n477|// with the marker kept for operator resolution.\n478|func convergeLocked(filesystem FileSystem, root string) error {\n479|\tpresent, err := markerPresent(filesystem, root)\n480|\tif err != nil {\n481|\t\treturn err\n482|\t}\n483|\tif !present {\n484|\t\treturn nil\n485|\t}\n486|\t_, err = recoverLocked(filesystem, root)\n487|\treturn err\n488|}\n489|\n490|func removeMarkerLocked(filesystem FileSystem, root string) error {\n491|\tif err := filesystem.Remove(pendingPath(root)); err != nil && !os.IsNotExist(err) {\n492|\t\treturn trustError(TrustError{Operation: \"remove joint marker\", Err: errors.Join(ErrTrustDurability, err)})\n493|\t}\n494|\tif err := syncDir(filesystem, root); err != nil {\n495|\t\treturn trustError(TrustError{Operation: \"sync joint marker directory\", Err: errors.Join(ErrTrustDurability, err)})\n496|\t}\n497|\treturn nil\n498|}","final_result":true}}}
