{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cad1","stream":{"kind":"session","id":"01a0abb3-41ff-7191-99eb-aba32c3c39db"},"sequence":963,"recorded_at":1780531400001921,"record_type":"event","durability":"durable","causation_id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114","run_stream":{"kind":"run","id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114"},"task_stream":{"kind":"task","id":"01a0abb9-db58-7151-95a9-169a9593fe0a"},"task_id":"01a0abb9-db58-7151-95a9-169a9593fe0a","event":{"kind":"output","task_id":"01a0abb9-db58-7151-95a9-169a9593fe0a","chunk":"Read text file `internal/hosttrust/trust.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"fmt\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|const (\n13|\t// TrustSchemaID is the exact Host Trust Store schema identity.\n14|\tTrustSchemaID = \"urn:ax:schema:host-trust-store\"\n15|\t// TrustSchemaVersion is the only accepted trust store version.\n16|\tTrustSchemaVersion = \"1.0.0\"\n17|\t// MaxGeneration is the uint53 ceiling. A committed store at this\n18|\t// generation refuses every further mutation.\n19|\tMaxGeneration = uint64(1<<53 - 1)\n20|\t// MaxEntries bounds CredentialEntry[0..4096].\n21|\tMaxEntries = 4096\n22|\t// MaxDERBytes bounds each decoded leaf_der/root_der payload.\n23|\tMaxDERBytes = 16384\n24|)\n25|\n26|const (\n27|\t// EntryActive admits the credential for new streams.\n28|\tEntryActive = \"active\"\n29|\t// EntryRetiring admits only pre-rotation streams until retire_at.\n30|\tEntryRetiring = \"retiring\"\n31|\t// EntryRevoked forbids all future admissions. Public bytes are retained\n32|\t// permanently as a reuse tombstone.\n33|\tEntryRevoked = \"revoked\"\n34|)\n35|\n36|// CredentialEntry is one enrolled credential. retire_at is non-null exactly\n37|// for retiring entries and later than enrolled_at.\n38|type CredentialEntry struct {\n39|\tHostID       scalar.UUIDv7\n40|\tCredentialID scalar.Digest\n41|\tSPKIID       scalar.Digest\n42|\tRootID       scalar.Digest\n43|\tLeafDER      []byte\n44|\tRootDER      []byte\n45|\tState        string\n46|\tEnrolledAt   scalar.Timestamp\n47|\tRetireAt     *scalar.Timestamp\n48|}\n49|\n50|// TrustStore is the decoded Host Trust Store 1.0.0 document. Generation is\n51|// greater than zero and increments by one per committed trust/config\n52|// authorization change.\n53|type TrustStore struct {\n54|\tGeneration uint64\n55|\tEntries    []CredentialEntry\n56|}\n57|\n58|// Formatting a store or entry must never expose digests, UUIDs, DER bytes or\n59|// timestamps: custody material never enters logs, snapshots or diagnostics.\n60|func (TrustStore) String() string                    { return \"host trust store\" }\n61|func (TrustStore) GoString() string                  { return \"host trust store\" }\n62|func (TrustStore) Format(state fmt.State, verb rune) { _, _ = state.Write([]byte(\"host trust store\")) }\n63|\n64|func (CredentialEntry) String() string   { return \"host trust credential entry\" }\n65|func (CredentialEntry) GoString() string { return \"host trust credential entry\" }\n66|func (CredentialEntry) Format(state fmt.State, verb rune) {\n67|\t_, _ = state.Write([]byte(\"host trust credential entry\"))\n68|}\n69|\n70|// DecodeTrust is the exact closed Host Trust Store 1.0.0 reader. Unknown,\n71|// missing, duplicate-key, malformed, partial or downgraded state is refused,\n72|// never read as an empty store and never given legacy meaning.\n73|func DecodeTrust(document []byte) (TrustStore, error) {\n74|\tif err := rejectDuplicateKeys(document); err != nil {\n75|\t\treturn TrustStore{}, err\n76|\t}\n77|\tvar shape map[string]json.RawMessage\n78|\tdecoder := json.NewDecoder(bytes.NewReader(document))\n79|\tif err := decoder.Decode(&shape); err != nil {\n80|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"decode document\", Err: errors.Join(ErrTrustDecode, err)})\n81|\t}\n82|\tif decoder.More() {\n83|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"decode document\", Err: ErrTrustDecode})\n84|\t}\n85|\tfor key := range shape {\n86|\t\tswitch key {\n87|\t\tcase \"schema\", \"schema_version\", \"generation\", \"entries\":\n88|\t\tdefault:\n89|\t\t\treturn TrustStore{}, trustError(TrustError{Operation: \"decode document\", Err: errors.Join(ErrTrustValidation, fmt.Errorf(\"unknown field\"))})\n90|\t\t}\n91|\t}\n92|\tvar schema, version string\n93|\tif err := decodeExactString(shape, \"schema\", &schema); err != nil {\n94|\t\treturn TrustStore{}, err\n95|\t}\n96|\tif schema != TrustSchemaID {\n97|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"decode schema\", Err: ErrTrustValidation})\n98|\t}\n99|\tif err := decodeExactString(shape, \"schema_version\", &version); err != nil {\n100|\t\treturn TrustStore{}, err\n101|\t}\n102|\tif version != TrustSchemaVersion {\n103|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"decode schema version\", Err: ErrTrustValidation})\n104|\t}\n105|\tgeneration, err := decodeGeneration(shape)\n106|\tif err != nil {\n107|\t\treturn TrustStore{}, err\n108|\t}\n109|\tentries, err := decodeEntries(shape)\n110|\tif err != nil {\n111|\t\treturn TrustStore{}, err\n112|\t}\n113|\tstore := TrustStore{Generation: generation, Entries: entries}\n114|\tif err := checkSortedUnique(store.Entries); err != nil {\n115|\t\treturn TrustStore{}, err\n116|\t}\n117|\tif err := checkMappingUnique(store.Entries); err != nil {\n118|\t\treturn TrustStore{}, err\n119|\t}\n120|\treturn store, nil\n121|}\n122|\n123|// checkMappingUnique enforces the cross-entry rules at read time, across all\n124|// entries including revoked tombstones: a leaf, leaf public key or root must\n125|// never map twice, even for the same host UUID. Identical leaf bytes imply an\n126|// identical credential_id, which the ordering check already refuses, so the\n127|// leaf member needs no separate comparison here.\n128|func checkMappingUnique(entries []CredentialEntry) error {\n129|\tkeys := make(map[string]struct{}, len(entries))\n130|\troots := make(map[string]struct{}, len(entries))\n131|\tfor _, entry := range entries {\n132|\t\tif _, duplicate := keys[entry.SPKIID.String()]; duplicate {\n133|\t\t\treturn trustError(TrustError{Operation: \"decode entries\", Err: ErrTrustValidation})\n134|\t\t}\n135|\t\tkeys[entry.SPKIID.String()] = struct{}{}\n136|\t\tif _, duplicate := roots[entry.RootID.String()]; duplicate {\n137|\t\t\treturn trustError(TrustError{Operation: \"decode entries\", Err: ErrTrustValidation})\n138|\t\t}\n139|\t\troots[entry.RootID.String()] = struct{}{}\n140|\t}\n141|\treturn nil\n142|}","final_result":true}}}
