ately differ from the review probes so the reviewer\\n// can drop the original probe file beside this candidate without a\\n// redeclaration.\\\"\\\"\\\")\\np.write_text(text)\\nprint(\\\"renamed\\\")\\nEOF\\ngrep -rn \\\"TestReviewer\\\\|reviewerLegacyFS\\\\|reviewerPartialFS\\\\|reviewerRestoreFS\\\\|reviewerCrashFS\\\\|reviewerInitFS\\\" internal/config/*_test.go internal/hosttrust/*_test.go | grep -v \\\"^.*://\\\" | head\",\n  \"description\": \"Rename F2 ports to non-colliding symbols\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"renamed\\n\",\n  \"original_output_bytes\": 8,\n  \"original_output_tokens\": 2,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
