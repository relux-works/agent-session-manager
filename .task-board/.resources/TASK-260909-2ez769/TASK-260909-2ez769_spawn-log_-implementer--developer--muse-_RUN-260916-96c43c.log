{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d1fd","stream":{"kind":"session","id":"01a0abb3-41ff-7191-99eb-aba32c3c39db"},"sequence":1881,"recorded_at":1780531400003757,"record_type":"event","durability":"durable","causation_id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114","run_stream":{"kind":"run","id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114"},"task_stream":{"kind":"task","id":"01a0abc5-3ee9-7a82-8155-ebc33dce8658"},"task_id":"01a0abc5-3ee9-7a82-8155-ebc33dce8658","event":{"kind":"output","task_id":"01a0abc5-3ee9-7a82-8155-ebc33dce8658","chunk":"{\n  \"chunk_id\": \"exec-35-1\",\n  \"command\": \"sed -n '1,30p' internal/hosttrust/barrier_test.go\\necho \\\"=== joint 46-60 ===\\\"\\nsed -n '46,60p' internal/hosttrust/joint_test.go\\necho \\\"=== joint 795,815 ===\\\"\\nsed -n '795,815p' internal/hosttrust/joint_test.go\\necho \\\"=== revalidate_test 240,265 ===\\\"\\nsed -n '240,265p' internal/config/migration_v4_revalidate_test.go\\necho \\\"=== fixtures_test head ===\\\"\\nsed -n '1,40p' internal/hosttrust/fixtures_test.go\",\n  \"description\": \"View test regions to update\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"package hosttrust\\n\\nimport (\\n\\t\\\"errors\\\"\\n\\t\\\"io/fs\\\"\\n\\t\\\"os\\\"\\n\\t\\\"path/filepath\\\"\\n\\t\\\"testing\\\"\\n)\\n\\n// stageJointMarker writes one outstanding intent marker exactly as a crash\\n// between the configuration replacement and the generation bump leaves it.\\nfunc stageJointMarker(t *testing.T, store *Store, marker PendingCommit) {\\n\\tt.Helper()\\n\\tencoded, err := encodePendingCommit(marker)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tif err := commitDocument(store.fs, store.root, pendingPath(store.root), encoded); err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n}\\n\\nfunc assertMarkerGone(t *testing.T, store *Store) {\\n\\tt.Helper()\\n\\tif _, err := os.Lstat(pendingPath(store.root)); !os.IsNotExist(err) {\\n\\t\\tt.Fatalf(\\\"joint marker remains: %v\\\", err)\\n\\t}\\n}\\n\\n=== joint 46-60 ===\\nfunc TestJointCommitHappyPath(t *testing.T) {\\n\\tsource := []byte(\\\"source configuration\\\\n\\\")\\n\\treplacement := []byte(\\\"replacement configuration\\\\n\\\")\\n\\tstore, configPath, snapshot := jointFixture(t, source, replacement)\\n\\tmarker := jointMarker(configPath, source, replacement, snapshot.Generation)\\n\\treplace := func() error { return os.WriteFile(configPath, replacement, 0o600) }\\n\\trevalidate := func(current TrustStore) error {\\n\\t\\tif current.Generation != snapshot.Generation {\\n\\t\\t\\treturn errors.New(\\\"generation moved\\\")\\n\\t\\t}\\n\\t\\treturn nil\\n\\t}\\n\\tgeneration, err := store.JointCommit(marker, revalidate, replace, unexpectedRestore)\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"JointCommit error = %v\\\", err)\\n=== joint 795,815 ===\\n\\twrapped := &faultMarkerReadFS{FileSystem: store.fs}\\n\\tstore.fs = wrapped\\n\\tcrowned := crownTrustAtExhaustion(t, store, snapshot)\\n\\tmarker := jointMarker(configPath, source, replacement, crowned.Generation)\\n\\tcalled := false\\n\\t_, err := store.JointCommit(marker,\\n\\t\\tfunc(TrustStore) error { return nil },\\n\\t\\tfunc() error {\\n\\t\\t\\twrapped.armed = true\\n\\t\\t\\treturn os.WriteFile(configPath, replacement, 0o600)\\n\\t\\t},\\n\\t\\tfunc() error {\\n\\t\\t\\tcalled = true\\n\\t\\t\\treturn nil\\n\\t\\t})\\n\\tif err == nil || called {\\n\\t\\tt.Fatalf(\\\"JointCommit(unreadable marker) admitted: restore=%v\\\", called)\\n\\t} else if !errors.Is(err, ErrJointCompensationFailed) {\\n\\t\\tt.Fatalf(\\\"JointCommit error = %v, want compensation failure\\\", err)\\n\\t} else if !errors.Is(err, ErrTrustStoreUnreadable) {\\n\\t\\tt.Fatalf(\\\"JointCommit error = %v, want unreadable-marker refusal\\\", err)\\n=== revalidate_test 240,265 ===\\n\\t\\tSchemaVersion:     \\\"1.0.0\\\",\\n\\t\\tOperation:         hosttrust.JointApplyV4,\\n\\t\\tConfigPath:        fixture.filename,\\n\\t\\tSourceSHA256:      hosttrust.SHA256HexOf(source),\\n\\t\\tReplacementSHA256: hosttrust.SHA256HexOf(append(append([]byte(nil), source...), 0x20)),\\n\\t\\tSourceGeneration:  before.Generation,\\n\\t\\tBackupPath:        fixture.filename + \\\".bak.3.0.0\\\",\\n\\t}\\n\\trelease := make(chan struct{})\\n\\tentered := make(chan struct{})\\n\\tholderDone := make(chan error, 1)\\n\\tgo func() {\\n\\t\\t_, err := store.JointCommit(marker,\\n\\t\\t\\tfunc(hosttrust.TrustStore) error { return nil },\\n\\t\\t\\tfunc() error {\\n\\t\\t\\t\\tclose(entered)\\n\\t\\t\\t\\t<-release\\n\\t\\t\\t\\treturn nil\\n\\t\\t\\t},\\n\\t\\t\\tfunc() error { return errUnexpectedJointRestore })\\n\\t\\tholderDone <- err\\n\\t}()\\n\\t<-entered\\n\\treaderDone := make(chan error, 1)\\n\\tvar observed CoherentSnapshot\\n\\tgo func() {\\n=== fixtures_test head ===\\npackage hosttrust\\n\\nimport (\\n\\t\\\"testing\\\"\\n\\t\\\"time\\\"\\n\\n\\t\\\"github.com/relux-works/agent-session-manager/internal/scalar\\\"\\n)\\n\\nvar (\\n\\ttestNow   = time.Date(2026, time.September, 10, 12, 0, 0, 0, time.UTC)\\n\\ttestHostA = \\\"0198f4c8-7d40-7e55-8e6f-1234567890aa\\\"\\n\\ttestHostB = \\\"0198f4c8-7d40-7e55-8e6f-1234567890ab\\\"\\n\\ttestHostC = \\\"0198f4c8-7d40-7e55-8e6f-1234567890ac\\\"\\n)\\n\\nfunc testTimestamp(value time.Time) scalar.Timestamp {\\n\\tstamp, err := scalar.ParseTimestamp(value.UTC().Format(\\\"2006-01-02T15:04:05.000Z\\\"))\\n\\tif err != nil {\\n\\t\\tpanic(err)\\n\\t}\\n\\treturn stamp\\n}\\n\\nfunc issueForTest(t *testing.T, hostID string, now time.Time) IssuedCredential {\\n\\tt.Helper()\\n\\tissued, err := IssueCredential(hostID, now, nil)\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"IssueCredential(%s) error = %v\\\", hostID, err)\\n\\t}\\n\\treturn issued\\n}\\n\\nfunc entryForTest(t *testing.T, issued IssuedCredential, state string, enrolledAt time.Time, retireAt *time.Time) CredentialEntry {\\n\\tt.Helper()\\n\\tvar retireStamp *scalar.Timestamp\\n\\tif retireAt != nil {\\n\\t\\tstamp := testTimestamp(*retireAt)\\n\\t\\tretireStamp = &stamp\\n\\t}\\n\",\n  \"original_output_bytes\": 4127,\n  \"original_output_tokens\": 1032,\n  \"truncated\": false\n}","final_result":true}}}
