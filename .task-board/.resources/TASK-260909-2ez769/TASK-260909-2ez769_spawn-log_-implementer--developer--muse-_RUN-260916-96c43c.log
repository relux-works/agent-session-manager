{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca65","stream":{"kind":"session","id":"01a0abb3-41ff-7191-99eb-aba32c3c39db"},"sequence":909,"recorded_at":1780531400001813,"record_type":"event","durability":"durable","causation_id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114","run_stream":{"kind":"run","id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114"},"call_id":"call_01a0abb9b3d6713e9422ecaa312a6dab","text":"Read text file `internal/hosttrust/authorize.go`.\n(159 line(s) above)\n160|\treturn CredentialEntry{}, false\n161|}\n162|\n163|// matchRemote yields the verified UUID only on an exact leaf/root/SPKI match\n164|// against one currently admitted entry. Zero or multiple matches refuse; SAN\n165|// alone and CA membership alone are insufficient, which the byte-exact triple\n166|// comparison enforces structurally.\n167|func matchRemote(trust TrustStore, leafDER, rootDER []byte) (CredentialEntry, bool) {\n168|\tspki := spkiOf(leafDER)\n169|\tvar matched []CredentialEntry\n170|\tfor _, entry := range trust.Entries {\n171|\t\tif !bytes.Equal(entry.LeafDER, leafDER) || !bytes.Equal(entry.RootDER, rootDER) {\n172|\t\t\tcontinue\n173|\t\t}\n174|\t\tif spki == \"\" || entry.SPKIID.String() != spki {\n175|\t\t\tcontinue\n176|\t\t}\n177|\t\tmatched = append(matched, entry)\n178|\t}\n179|\tif len(matched) != 1 {\n180|\t\treturn CredentialEntry{}, false\n181|\t}\n182|\treturn matched[0], true\n183|}\n184|\n185|func spkiOf(leafDER []byte) string {\n186|\tder := mustSPKI(leafDER)\n187|\tif len(der) == 0 {\n188|\t\treturn \"\"\n189|\t}\n190|\treturn scalar.SHA256Digest(der).String()\n191|}\n192|\n193|// WithMutationAuthorization rechecks generation, credential validity,\n194|// allowlist membership and authenticated hello under the exclusive\n195|// authorization lock immediately before the externally visible side-effect\n196|// boundary, then runs the boundary while still holding the lock. The\n197|// generation check and the boundary serialize with revocation and config\n198|// commits. The request must bind the current generation: work prepared under\n199|// an old generation cannot gain new authority by refreshing a cached number,\n200|// so a stale binding refuses and the caller must discard its authorization\n201|// and replan through a fresh mutually authenticated connection. Boundaries\n202|// must be bounded: long provider calls must not hold the authorization lock\n203|// across unbounded work.\n204|func (store *Store) WithMutationAuthorization(request AuthRequest, boundary func() error) error {\n205|\tunlock, err := store.lock.exclusive()\n206|\tif err != nil {\n207|\t\treturn trustError(TrustError{Operation: \"authorize mutation\", Err: errors.Join(ErrAuthorizationRefused, err)})\n208|\t}\n209|\tdefer unlock()\n210|\t// Pending joint intent converges before the binding check: a request\n211|\t// bound before a crash compares against the recovered generation and\n212|\t// refuses stale, and the boundary never runs beside unresolved intent.\n213|\tif err := convergeLocked(store.fs, store.root); err != nil {\n214|\t\treturn err\n215|\t}\n216|\tcurrent, err := readCommitted(store)\n217|\tif err != nil {\n218|\t\treturn err\n219|\t}\n220|\tif request.SnapshotGeneration != current.Generation {\n221|\t\treturn trustError(TrustError{Operation: \"authorize mutation\", Err: ErrStaleGeneration})\n222|\t}\n223|\tif err := checkAuthorization(current, request); err != nil {\n224|\t\treturn err\n225|\t}\n226|\tif boundary == nil {\n227|\t\treturn trustError(TrustError{Operation: \"authorize mutation\", Err: ErrAuthorizationRefused})\n228|\t}\n229|\treturn boundary()\n230|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca67","stream":{"kind":"session","id":"01a0abb3-41ff-7191-99eb-aba32c3c39db"},"sequence":910,"recorded_at":1780531400001815,"record_type":"event","durability":"durable","causation_id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114","run_stream":{"kind":"run","id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114"},"call_id":"call_01a0abb9b583722ca1c6db5b2d2ba1d7","text":"Read text file `internal/hosttrust/joint.go`.\n(394 line(s) above)\n395|func recoverLocked(filesystem FileSystem, root string) (RecoverResult, error) {\n396|\tconst operation = \"recover joint commit\"\n397|\tpath := pendingPath(root)\n398|\tif _, err := filesystem.Lstat(path); err != nil {\n399|\t\tif os.IsNotExist(err) {\n400|\t\t\treturn RecoverResult{}, nil\n401|\t\t}\n402|\t\treturn RecoverResult{}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n403|\t}\n404|\tinfo, err := filesystem.Lstat(path)\n405|\tif err != nil {\n406|\t\treturn RecoverResult{}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n407|\t}\n408|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n409|\t\treturn RecoverResult{}, err\n410|\t}\n411|\tdocument, err := filesystem.ReadFile(path)\n412|\tif err != nil {\n413|\t\treturn RecoverResult{}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n414|\t}\n415|\tmarker, err := decodePendingCommit(document)\n416|\tif err != nil {\n417|\t\treturn RecoverResult{Found: true}, err\n418|\t}\n419|\tconfiguration, err := filesystem.ReadFile(marker.ConfigPath)\n420|\tif err != nil {\n421|\t\treturn RecoverResult{Found: true}, trustError(TrustError{Operation: operation, Err: errors.Join(ErrTrustStoreUnreadable, err)})\n422|\t}\n423|\tswitch SHA256HexOf(configuration) {\n424|\tcase marker.ReplacementSHA256:\n425|\t\tcommitted, err := loadCommitted(filesystem, root)\n426|\t\tif err != nil {\n427|\t\t\treturn RecoverResult{Found: true}, err\n428|\t\t}\n429|\t\tswitch committed.Generation {\n430|\t\tcase marker.SourceGeneration:\n431|\t\t\tif err := transactLocked(filesystem, root, func(*TrustStore) error { return nil }); err != nil {\n432|\t\t\t\treturn RecoverResult{Found: true}, err\n433|\t\t\t}\n434|\t\tcase marker.SourceGeneration + 1:\n435|\t\tdefault:\n436|\t\t\treturn RecoverResult{Found: true}, trustError(TrustError{Operation: operation, Err: ErrJointIntervened})\n437|\t\t}\n438|\t\tif err := removeMarkerLocked(filesystem, root); err != nil {\n439|\t\t\treturn RecoverResult{Found: true}, err\n440|\t\t}\n441|\t\treturn RecoverResult{Found: true, Completed: true}, nil\n442|\tcase marker.SourceSHA256:\n443|\t\tif err := removeMarkerLocked(filesystem, root); err != nil {\n444|\t\t\treturn RecoverResult{Found: true}, err\n445|\t\t}\n446|\t\treturn RecoverResult{Found: true, Aborted: true}, nil\n447|\tdefault:\n448|\t\treturn RecoverResult{Found: true}, trustError(TrustError{Operation: operation, Err: ErrJointIntervened})\n449|\t}\n450|}\n451|\n452|func pendingPath(root string) string { return filepath.Join(root, pendingCommitFileName) }\n453|\n454|// markerPresent reports whether a joint-commit intent marker is\n455|// outstanding. Absence must be established, never assumed: an unreadable\n456|// marker path refuses instead of reporting no marker.\n457|func markerPresent(filesystem FileSystem, root string) (bool, error) {\n458|\t_, err := filesystem.Lstat(pendingPath(root))\n459|\tif err == nil {\n460|\t\treturn true, nil\n461|\t}\n462|\tif os.IsNotExist(err) {\n463|\t\treturn false, nil\n464|\t}\n465|\treturn false, trustError(TrustError{Operation: \"inspect joint commit\", Err: errors.Join(ErrTrustStoreUnreadable, err)})\n466|}\n467|\n468|// convergeLocked converges one interrupted joint commit, if any, before\n469|// the caller exposes a snapshot or runs a boundary. It is the general\n470|// admission barrier for pending intent: every read, admission and\n471|// transaction entry point converges here under the authorization lock,\n472|// while recovery itself stays the single convergence implementation. The\n473|// caller must hold the exclusive lock: convergence can bump the generation\n474|// and remove the marker. Shared-lock readers upgrade to exclusive when a\n475|// marker is present (see readSnapshot); when no marker is present the\n476|// shared fast path needs no write. A refused recovery fails the caller\n477|// with the marker kept for operator resolution.\n478|func convergeLocked(filesystem FileSystem, root string) error {\n479|\tpresent, err := markerPresent(filesystem, root)\n480|\tif err != nil {\n481|\t\treturn err\n482|\t}\n483|\tif !present {\n484|\t\treturn nil\n485|\t}\n486|\t_, err = recoverLocked(filesystem, root)\n487|\treturn err\n488|}\n489|\n490|func removeMarkerLocked(filesystem FileSystem, root string) error {\n491|\tif err := filesystem.Remove(pendingPath(root)); err != nil && !os.IsNotExist(err) {\n492|\t\treturn trustError(TrustError{Operation: \"remove joint marker\", Err: errors.Join(ErrTrustDurability, err)})\n493|\t}\n494|\tif err := syncDir(filesystem, root); err != nil {\n495|\t\treturn trustError(TrustError{Operation: \"sync joint marker directory\", Err: errors.Join(ErrTrustDurability, err)})\n496|\t}\n497|\treturn nil\n498|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
