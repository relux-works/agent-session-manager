{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c88f","stream":{"kind":"session","id":"01a0abb3-41ff-7191-99eb-aba32c3c39db"},"sequence":674,"recorded_at":1780531400001343,"record_type":"event","durability":"durable","causation_id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114","run_stream":{"kind":"run","id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114"},"task_stream":{"kind":"task","id":"01a0abb6-280b-7ad3-9e95-bb907cf33ebb"},"task_id":"01a0abb6-280b-7ad3-9e95-bb907cf33ebb","event":{"kind":"output","task_id":"01a0abb6-280b-7ad3-9e95-bb907cf33ebb","chunk":"Read text file `internal/config/migration.go`.\n1|package config\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"errors\"\n6|\t\"io\"\n7|\t\"io/fs\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"strconv\"\n11|\t\"strings\"\n12|\n13|\t\"github.com/pelletier/go-toml/v2\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|)\n16|\n17|var (\n18|\tErrMigrationTarget         = errors.New(\"unsupported configuration migration target\")\n19|\tErrMigrationDowngrade      = errors.New(\"configuration migration would downgrade\")\n20|\tErrMigrationChoiceRequired = errors.New(\"generated-summary disclosure choice required\")\n21|\tErrMigrationSourceAbsent   = errors.New(\"configuration migration source is absent\")\n22|\tErrMigrationBackup         = errors.New(\"configuration migration backup failed\")\n23|\tErrMigrationWrite          = errors.New(\"configuration migration write failed\")\n24|\tErrMigrationSync           = errors.New(\"configuration migration sync failed\")\n25|\tErrMigrationReplace        = errors.New(\"configuration migration atomic replace failed\")\n26|\tErrMigrationRecovery       = errors.New(\"configuration migration recovery failed\")\n27|\tErrCompatibilityReader     = errors.New(\"unsupported configuration reader version\")\n28|\tErrCompatibilityAssessment = errors.New(\"configuration compatibility assessment failed\")\n29|\t// ErrMigrationV4Explicit reports a direct Migrate call targeting\n30|\t// Configuration 4.0.0. Migration to v4 is never a one-shot upgrade: it\n31|\t// requires PreviewV4, explicit operator confirmation, and ApplyV4.\n32|\tErrMigrationV4Explicit = errors.New(\"configuration 4.0.0 migration requires explicit preview and confirmation\")\n33|\t// ErrMigrationV4Source reports a v4 migration requested from a\n34|\t// Configuration 1.0.0 or 2.0.0 source. Older inputs first use the\n35|\t// existing explicit migrations to Configuration 3.0.0.\n36|\tErrMigrationV4Source = errors.New(\"configuration 4.0.0 migration requires a configuration 3.0.0 source\")\n37|)\n38|\n39|// MigrationOptions are the explicit choices supplied by the ax migrate config\n40|// owner. Major-version migration is never invoked from Load or startup.\n41|type MigrationOptions struct {\n42|\tTargetVersion                 string\n43|\tGeneratedSummaryUpgradeChoice string\n44|}\n45|\n46|// MigrationResult reports durable migration without claiming CLI or doctor\n47|// availability. Changed is false for an already-target-version document.\n48|// BackupPath is the deterministic name the backup takes and is only guaranteed\n49|// to exist on disk when Migrate returned a nil error; a caller must not treat\n50|// it as a readable path after a refusal.\n51|type MigrationResult struct {\n52|\tSourceVersion string\n53|\tTargetVersion string\n54|\tBackupPath    string\n55|\tChanged       bool\n56|}\n57|\n58|// MigrationError renders no machine-local path or document content.\n59|type MigrationError struct {\n60|\tOperation string\n61|\tErr       error\n62|}\n63|\n64|func (err *MigrationError) Error() string {\n65|\treturn \"configuration migration \" + err.Operation + \" failed\"\n66|}\n67|func (err *MigrationError) Unwrap() error { return err.Err }\n68|\n69|// MigrateOS captures real process inputs and performs one explicit durable\n70|// major-version migration. The selected source is validated through Load\n71|// before any backup or replacement is attempted.\n72|func MigrateOS(platform scalar.Platform, overrides Overrides, options MigrationOptions) (MigrationResult, error) {\n73|\tinputs, err := OSInputs(platform)\n74|\tif err != nil {\n75|\t\treturn MigrationResult{}, err\n76|\t}\n77|\treturn Migrate(inputs, overrides, options)\n78|}\n79|\n80|// Migrate is the dependency-injected production entry point. It writes only\n81|// the selected configuration file and a deterministic source-version backup\n82|// in the same directory.\n83|func Migrate(inputs Inputs, overrides Overrides, options MigrationOptions) (MigrationResult, error) {\n84|\treturn migrate(inputs, overrides, options, osMigrationFileSystem{})\n85|}\n86|\n87|// CompatibilityMode is deliberately narrower than runtime capability state.\n88|type CompatibilityMode string\n89|\n90|const (\n91|\tCompatibilityCompatible CompatibilityMode = \"compatible\"\n92|\tCompatibilityReadOnly   CompatibilityMode = \"read-only-diagnostic\"\n93|)\n94|\n95|// CompatibilityAssessment contains only envelope facts needed to prevent a\n96|// downgraded writer. It exposes no decoded Configuration and performs no I/O.\n97|type CompatibilityAssessment struct {\n98|\tReaderVersion string\n99|\tSourceVersion string\n100|\tMode          CompatibilityMode\n101|}\n102|\n103|// AssessCompatibility determines whether a known reader may open the document\n104|// normally or must remain read-only. Newer documents are not decoded or\n105|// rewritten, so fields unknown to the older reader remain untouched.\n106|func AssessCompatibility(document []byte, readerVersion string) (CompatibilityAssessment, error) {\n107|\treader, ok := knownConfigVersion(readerVersion)\n108|\tif !ok {\n109|\t\treturn CompatibilityAssessment{}, migrationError(MigrationError{Operation: \"assess reader\", Err: ErrCompatibilityReader})\n110|\t}\n111|\tvar envelope rawEnvelope\n112|\tif err := decodeEnvelope(document, &envelope); err != nil {\n113|\t\treturn CompatibilityAssessment{}, err\n114|\t}\n115|\tif envelope.Schema != SchemaID {\n116|\t\treturn CompatibilityAssessment{}, configError(\"schema\", ErrConfigValidation)\n117|\t}\n118|\tsource, err := parseSemverCore(envelope.SchemaVersion)\n119|\tif err != nil {\n120|\t\treturn CompatibilityAssessment{}, configError(\"schema_version\", errors.Join(ErrCompatibilityAssessment, err))\n(more lines below)","final_result":true}}}
