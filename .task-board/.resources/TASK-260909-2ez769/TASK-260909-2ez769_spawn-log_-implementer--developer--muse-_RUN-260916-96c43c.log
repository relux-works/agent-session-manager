{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ccf7","stream":{"kind":"session","id":"01a0abb3-41ff-7191-99eb-aba32c3c39db"},"sequence":1238,"recorded_at":1780531400002471,"record_type":"event","durability":"durable","causation_id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114","run_stream":{"kind":"run","id":"2dda60fb-bbf1-4b10-b11a-18e8803d4114"},"task_stream":{"kind":"task","id":"01a0abbe-bc10-7be0-bace-f569cf3bc2e9"},"task_id":"01a0abbe-bc10-7be0-bace-f569cf3bc2e9","event":{"kind":"output","task_id":"01a0abbe-bc10-7be0-bace-f569cf3bc2e9","chunk":"Read text file `internal/hosttrust/mutations.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Host trust behavioral overlays; no source-only or compile-error kills.\"\"\"\n3|import argparse\n4|import json\n5|from pathlib import Path\n6|import subprocess\n7|import sys\n8|\n9|ROOT = Path(__file__).resolve().parents[2]\n10|TRUST = \"internal/hosttrust/trust.go\"\n11|DECODE = \"internal/hosttrust/trust_decode.go\"\n12|ENROLL = \"internal/hosttrust/enroll.go\"\n13|ROTATE = \"internal/hosttrust/rotate.go\"\n14|AUTHORIZE = \"internal/hosttrust/authorize.go\"\n15|JOINT = \"internal/hosttrust/joint.go\"\n16|CUSTODY = \"internal/hosttrust/custody.go\"\n17|CUSTODY_UNIX = \"internal/hosttrust/custody_unix.go\"\n18|PROFILE = \"internal/hosttrust/profile_verify.go\"\n19|TRANSACT = \"internal/hosttrust/transact.go\"\n20|LOCK_UNIX = \"internal/hosttrust/lock_unix.go\"\n21|TESTS = \"Test\"\n22|PROBES = [\n23| (\"neutral\", TRANSACT, \"next.Generation = committed.Generation + 1\", \"next.Generation = committed.Generation + 1 + 0\", \"Equivalent generation increment\", None),\n24| (\"gen-ceiling\", DECODE, \"if parsed == 0 || parsed > MaxGeneration {\", \"if parsed == 0 || parsed > MaxGeneration+1 {\", \"Admits exactly generation 2^53\", \"TestDecodeTrustRefusals/generation_uint53_ceiling\"),\n25| (\"dup-credid\", DECODE, \"if previous >= current {\", \"if previous == current {\", \"Admits unsorted-but-distinct entries while keeping duplicate refusal; the mapping gate now subsumes the identical-entry case\", \"TestDecodeTrustRefusals/unsorted_entries\"),\n26| (\"unknown-field\", TRUST, 'case \"schema\", \"schema_version\", \"generation\", \"entries\":', 'case \"schema\", \"schema_version\", \"generation\", \"entries\", \"comment\":', \"Admits exactly one unknown field\", \"TestDecodeTrustRefusals/unknown_root_field\"),\n27| (\"per-host-bound\", ENROLL, \"if live >= 2 {\", \"if live >= 3 {\", \"Admits exactly the third non-revoked credential\", \"TestEnrollBoundsPerHost\"),\n28| (\"rotation-expiry\", ROTATE, \"deadline = oldLeaf.NotAfter\", \"deadline = oldLeaf.NotAfter.Add(time.Hour)\", \"Extends overlap one hour past old leaf expiry\", \"TestRotateCapsAtLeafExpiry\"),\n29| (\"revoke-state\", ROTATE, \"trust.Entries[index].State = EntryRevoked\", \"trust.Entries[index].State = EntryRetiring\", \"Weakens the terminal state to retiring, admitting re-revocation\", \"TestRevokeTombstone\"),\n30| (\"retire-bound\", ROTATE, \"fixed.After(now.Add(RotationBound))\", \"fixed.After(now.Add(48 * time.Hour))\", \"Admits exactly the 24-48h overlap window\", \"TestMarkRetiringBounds/past_24h_bound\"),\n31| (\"stale-direction\", AUTHORIZE, \"if snapshot.Generation != current.Generation {\", \"if snapshot.Generation > current.Generation {\", \"Admits stale-older snapshots while refusing newer\", \"TestAuthorizeDispatchRefusals/stale_generation\"),\n32| (\"stale-mutation-refresh\", AUTHORIZE, \"if request.SnapshotGeneration != current.Generation {\", \"if request.SnapshotGeneration > current.Generation {\", \"Admits older mutation bindings while refusing newer\", \"TestWithMutationAuthorizationRefusesStaleGeneration\"),\n33| (\"joint-marker-stale\", JOINT, \"if marker.SourceGeneration != committed.Generation {\", \"if marker.SourceGeneration > committed.Generation {\", \"