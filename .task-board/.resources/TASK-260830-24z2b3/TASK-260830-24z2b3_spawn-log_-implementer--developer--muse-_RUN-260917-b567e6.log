{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d609","stream":{"kind":"session","id":"01a0b144-2d0b-7f30-96a3-e7fabafc632c"},"sequence":2399,"recorded_at":1780531400004793,"record_type":"event","durability":"durable","causation_id":"96a3132b-8530-4e47-8657-36d15f2da569","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"96a3132b-8530-4e47-8657-36d15f2da569","run_stream":{"kind":"run","id":"96a3132b-8530-4e47-8657-36d15f2da569"},"task_stream":{"kind":"task","id":"01a0b159-8675-7d01-a49e-28712599d308"},"task_id":"01a0b159-8675-7d01-a49e-28712599d308","event":{"kind":"output","task_id":"01a0b159-8675-7d01-a49e-28712599d308","chunk":"Read text file `internal/clonebundle/refusal_test.go`.\n(483 line(s) above)\n484|\tt.Run(\"reconciliation\", func(t *testing.T) {\n485|\t\tinput := validCaptureInput(t)\n486|\t\tbuilt, err := BuildCaptureManifest(input)\n487|\t\tif err != nil {\n488|\t\t\tt.Fatal(err)\n489|\t\t}\n490|\t\tmanifest, err := DecodeCaptureManifest(built)\n491|\t\tif err != nil {\n492|\t\t\tt.Fatal(err)\n493|\t\t}\n494|\t\tif err := VerifyCaptureReconciliation(manifest, []string{\"store/blob-a\"}, input.RawKeys); !errors.Is(err, ErrInvalid) {\n495|\t\t\tt.Fatalf(\"short plan error = %v, want ErrInvalid\", err)\n496|\t\t}\n497|\t\tif err := VerifyCaptureReconciliation(manifest, input.PlanKeys, []string{\"store/blob-a\"}); !errors.Is(err, ErrInvalid) {\n498|\t\t\tt.Fatalf(\"short raw error = %v, want ErrInvalid\", err)\n499|\t\t}\n500|\t\t// Duplicate raw keys hiding a missing included object are\n501|\t\t// refused outright, not derived incomplete.\n502|\t\tif err := VerifyCaptureReconciliation(manifest, input.PlanKeys, []string{\"store/blob-a\", \"store/blob-a\"}); !errors.Is(err, ErrInvalid) {\n503|\t\t\tt.Fatalf(\"duplicate raw keys error = %v, want ErrInvalid\", err)\n504|\t\t} else if !strings.Contains(err.Error(), \"duplicate\") {\n505|\t\t\tt.Fatalf(\"duplicate raw keys error = %v, want the duplicate refusal\", err)\n506|\t\t}\n507|\t\tif err := VerifyCaptureReconciliation(manifest, []string{\"store/blob-a\", \"store/blob-b\", \"store/blob-b\"}, input.RawKeys); !errors.Is(err, ErrInvalid) {\n508|\t\t\tt.Fatalf(\"duplicate plan keys error = %v, want ErrInvalid\", err)\n509|\t\t}\n510|\t\tif deriveRawComplete(manifest.Items, input.PlanKeys, []string{\"store/blob-a\", \"store/blob-a\"}) {\n511|\t\t\tt.Fatal(\"deriveRawComplete(duplicate raw keys) = true, want false\")\n512|\t\t}\n513|\t\t// A manifest whose flag disagrees with the derivation is refused\n514|\t\t// even when the key sets reconcile.\n515|\t\tflipped := manifest\n516|\t\tflipped.RawComplete = false\n517|\t\tif err := VerifyCaptureReconciliation(flipped, input.PlanKeys, input.RawKeys); !errors.Is(err, ErrInvalid) {\n518|\t\t\tt.Fatalf(\"flipped flag error = %v, want ErrInvalid\", err)\n519|\t\t}\n520|\t\tincomplete := manifest\n521|\t\tincomplete.RawComplete = false\n522|\t\tif err := RefuseMaximalSafeUnlessComplete(incomplete); !errors.Is(err, ErrInvalid) {\n523|\t\t\tt.Fatalf(\"incomplete maximal_safe error = %v, want ErrInvalid\", err)\n524|\t\t}\n525|\t})\n526|\tt.Run(\"build envelope\", func(t *testing.T) {\n527|\t\tinput := validCaptureInput(t)\n528|\t\tinput.BundleID = \"nope\"\n529|\t\tif _, err := BuildCaptureManifest(input); !errors.Is(err, ErrInvalid) {\n530|\t\t\tt.Fatalf(\"bad bundle error = %v, want ErrInvalid\", err)\n531|\t\t}\n532|\t\tinput = validCaptureInput(t)\n533|\t\tinput.CreatedAt = \"yesterday\"\n534|\t\tif _, err := BuildCaptureManifest(input); !errors.Is(err, ErrInvalid) {\n535|\t\t\tt.Fatalf(\"bad created_at error = %v, want ErrInvalid\", err)\n536|\t\t}\n537|\t\tinput = validCaptureInput(t)\n538|\t\tinput.SourceBasis.Kind = \"mystery\"\n539|\t\tif _, err := BuildCaptureManifest(input); !errors.Is(err, ErrInvalid) {\n540|\t\t\tt.Fatalf(\"bad basis kind error = %v, want ErrInvalid\", err)\n541|\t\t}\n542|\t\tinput = validCaptureInput(t)\n543|\t\tinput.Boundary.Kind = \"mystery\"\n544|\t\tif _, err := BuildCaptureManifest(input); !errors.Is(err, ErrInvalid) {\n545|\t\t\tt.Fatalf(\"bad boundary kind error = %v, want ErrInvalid\", err)\n546|\t\t}\n547|\t})\n548|\tt.Run(\"build plan match\", func(t *testing.T) {\n549|\t\tinput := validCaptureInput(t)\n550|\t\tinput.PlanKeys = append(input.PlanKeys, \"store/zz-missing-item\")\n551|\t\t_, err := BuildCaptureManifest(input)\n552|\t\trequireRefusal(t, err, \"one per plan candidate\")\n553|\t\tinput = validCaptureInput(t)\n554|\t\tinput.PlanKeys = input.PlanKeys[:2]\n555|\t\t_, err = BuildCaptureManifest(input)\n556|\t\trequireRefusal(t, err, \"one per plan candidate\")\n557|\t\tinput = validCaptureInput(t)\n558|\t\tinput.PlanKeys[2] = \"store/zz-renamed\"\n559|\t\t_, err = BuildCaptureManifest(input)\n560|\t\trequireRefusal(t, err, \"has no item\")\n561|\t})\n562|}\n563|\n564|func TestBoundaryRefusals(t *testing.T) {\n565|\tt.Run(\"decode stable proof\", func(t *testing.T) {\n566|\t\tproof := func(mutate func(map[string]any)) []byte {\n567|\t\t\tbase := map[string]any{\n568|\t\t\t\t\"proof_kind\": \"closed_store\", \"source_generation\": \"g\",\n569|\t\t\t\t\"snapshot_identity_digest\": nil,\n570|\t\t\t\t\"pre_capture_digest\":       fixtureDigest(\"test-pre-capture\"),\n571|\t\t\t\t\"post_capture_digest\":      fixtureDigest(\"test-pre-capture\"),\n572|\t\t\t\t\"input_blocked\":            true, \"foreground_idle\": true, \"background_idle\": true,\n573|\t\t\t\t\"extensions\": map[string]any{},\n574|\t\t\t}\n575|\t\t\tmutate(base)\n576|\t\t\tout, err := json.Marshal(base)\n577|\t\t\tif err != nil {\n578|\t\t\t\tt.Fatal(err)\n579|\t\t\t}\n580|\t\t\treturn out\n581|\t\t}\n582|\t\tcases := []struct {\n583|\t\t\tname     string\n584|\t\t\tbody     []byte\n585|\t\t\tfragment string\n586|\t\t}{\n587|\t\t\t{\"unequal digests\", proof(func(o map[string]any) { o[\"post_capture_digest\"] = fixtureDigest(\"other\") }), \"differ\"},\n588|\t\t\t{\"bad kind\", proof(func(o map[string]any) { o[\"proof_kind\"] = \"file_size\" }), \"proof vocabulary\"},\n589|\t\t\t{\"closed_store with identity\", proof(func(o map[string]any) { o[\"snapshot_identity_digest\"] = fixtureDigest(\"x\") }), \"null snapshot identity\"},\n590|\t\t\t{\"closed_store idle false\", proof(func(o map[string]any) { o[\"foreground_idle\"] = false }), \"requires input_blocked\"},\n591|\t\t\t{\"snapshot null identity\", proof(func(o map[string]any) {\n592|\t\t\t\to[\"proof_kind\"] = \"immutable_snapshot\"\n593|\t\t\t}), \"non-null snapshot identity\"},\n594|\t\t\t{\"log prefix null identity\", proof(func(o map[string]any) {\n595|\t\t\t\to[\"proof_kind\"] = \"verified_log_prefix\"\n596|\t\t\t}), \"non-null snapshot identity\"},\n597|\t\t\t{\"quiescence idle false\", proof(func(o map[string]any) {\n598|\t\t\t\to[\"proof_kind\"] = \"provider_quiescence\"\n599|\t\t\t\to[\"background_idle\"] = false\n600|\t\t\t}), \"requires input_blocked\"},\n601|\t\t\t{\"empty generation\", proof(func(o map[string]any) { o[\"source_generation\"] = \"\" }), \"string[1..512]\"},\n602|\t\t}\n603|\t\tfor _, tc := range cases {\n(more lines below)","final_result":true}}}
