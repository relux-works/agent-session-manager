not a UUIDv7\")\n525|\t}\n526|\tvar turn *scalar.UUIDv7\n527|\tif !isNull(members[\"turn_id\"]) {\n528|\t\tvalue, ok := checkUUIDv7(members[\"turn_id\"])\n529|\t\tif !ok {\n530|\t\t\treturn CanonicalEvent{}, invalid(\"canonical event turn_id is not a UUIDv7\")\n531|\t\t}\n532|\t\tturn = &value\n533|\t}\n534|\tkind, ok := rawString(members[\"kind\"])\n535|\tif !ok || !ValidEventKind(kind) {\n536|\t\treturn CanonicalEvent{}, invalid(\"canonical event kind is outside the 26-kind vocabulary\")\n537|\t}\n538|\tvar stamp *scalar.Timestamp\n539|\tif !isNull(members[\"timestamp\"]) {\n540|\t\tvalue, ok := checkTimestamp(members[\"timestamp\"])\n541|\t\tif !ok {\n542|\t\t\treturn CanonicalEvent{}, invalid(\"canonical event timestamp is not a timestamp\")\n543|\t\t}\n544|\t\tstamp = &value\n545|\t}\n546|\tvisibility, ok := rawString(members[\"visibility\"])\n547|\tif !ok || !validVisibility(visibility) {\n548|\t\treturn CanonicalEvent{}, invalid(\"canonical event visibility is outside public|projection|internal|opaque\")\n549|\t}\n550|\tpayload, err := checkPayload(kind, members[\"payload\"])\n551|\tif err != nil {\n552|\t\treturn CanonicalEvent{}, err\n553|\t}\n554|\tevidence, err := DecodeSourceEvidence(members[\"source_evidence\"])\n555|\tif err != nil {\n556|\t\treturn CanonicalEvent{}, err\n557|\t}\n558|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n559|\t\treturn CanonicalEvent{}, invalid(\"canonical event extensions %s\", extensionsFault)\n560|\t}\n561|\tif err := verifySelfDigest(members, canonicalEventSelf, eventID); err != nil {\n562|\t\treturn CanonicalEvent{}, err\n563|\t}\n564|\treturn CanonicalEvent{\n565|\t\tEventID:          eventID,\n566|\t\tLogicalSessionID: logical,\n567|\t\tOrdinal:          ordinal,\n568|\t\tParents:          parents,\n569|\t\tActorID:          actorID,\n570|\t\tTurnID:           turn,\n571|\t\tKind:             kind,\n572|\t\tTimestamp:        stamp,\n573|\t\tVisibility:       visibility,\n574|\t\tPayload:          payload,\n575|\t\tEvidence:         evidence,\n576|\t}, nil\n577|}\n578|\n579|// checkPayload validates the kind-selected closed payload: every\n580|// payload is a strict (duplicate-free) object; message-like kinds\n581|// carry exactly content_blocks plus extensions; content blocks use\n582|// exactly the eight-type vocabulary with typed inline content\n583|// (at most 64 KiB) or Blob Descriptor references. Per-kind fact\n584|// registries beyond this envelope are sibling scope.\n585|func checkPayload(kind string, raw json.RawMessage) (map[string]any, error) {\n586|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n587|\tif fault != nil {\n588|\t\treturn nil, invalid(\"canonical event payload %s (%s)\", fault.detail, memberField(fault.member))\n589|\t}\n590|\tif messageLikeKind(kind) {\n591|\t\tallowed := map[string]bool{\"content_blocks\": true, \"extensions\": true}\n592|\t\tif name, unknown := unknownMember(members, allowed); unknown {\n593|\t\t\treturn nil, invalid(\"canonical event message payload carries unknown member %q\", name)\n594|\t\t}\n595|\t\tblocks, present := members[\"content_blocks\"]\n596|\t\tif !present {\n597|\t\t\treturn nil, invalid(\"canonical event message payload misses content_blocks\")\n598|\t\t}\n599|\t\tif err := checkContentBlocks(blocks); err != nil {\n600|\t\t\treturn nil, err\n601|\t\t}\n602|\t\tif extensions, present := members[\"extensions\"]; present {\n603|\t\t\tif extensionsFault := checkExtensionsClosed(extensions); extensionsFault != nil {\n604|\t\t\t\treturn nil, invalid(\"canonical event message payload extensions %s\", extensionsFault)\n605|\t\t\t}\n606|\t\t}\n607|\t} else if blocks, present := members[\"content_blocks\"]; present {\n608|\t\tif err := checkContentBlocks(blocks); err != nil {\n609|\t\t\treturn nil, err\n610|\t\t}\n611|\t}\n612|\tvar payload map[string]any\n613|\tif err := json.Unmarshal(bytesTrimSpace(raw), &payload); err != nil {\n614|\t\treturn nil, invalid(\"canonical event payload is not an object: %v\", err)\n615|\t}\n616|\treturn payload, nil\n617|}\n618|\n619|var contentBlockMembers = map[string]bool{\n620|\t\"type\": true, \"content\": true, \"blob_descriptor_id\": true, \"media_type\": true, \"extensions\": true,\n621|}\n622|\n623|// checkContentBlocks validates message-like content blocks: strict\n624|// objects with a vocabulary type, inline content of at most 64 KiB,\n625|// and digest-grammar Blob Descriptor references. The pinned text\n626|// gives each block \"typed inline content or Blob Descriptor\n627|// references\": exactly one of the two members must be present, so a\n628|// block with neither and a block with both are refused.\n629|func checkContentBlocks(raw json.RawMessage) error {\n630|\telements, ok := decodeArray(raw)\n631|\tif !ok {\n632|\t\treturn invalid(\"canonical event content_blocks are not an array\")\n633|\t}\n634|\tfor index, element := range elements {\n635|\t\tmembers, fault := decodeStrictObject(bytesTrimSpace(element))\n636|\t\tif fault != nil {\n637|\t\t\treturn invalid(\"canonical event content block[%d] %s (%s)\", index, fault.detail, memberField(fault.member))\n638|\t\t}\n639|\t\tif name, unknown := unknownMember(members, contentBlockMembers); unknown {\n640|\t\t\treturn invalid(\"canonical event content block[%d] carries unknown member %q\", index, name)\n641|\t\t}\n642|\t\tblockTypeValue, present := members[\"type\"]\n643|\t\tif !present {\n644|\t\t\treturn invalid(\"canonical event content block[%d] misses its type\", index)\n645|\t\t}\n646|\t\tblockType, ok := rawString(blockTypeValue)\n647|\t\tif !ok || !validContentBlockType(blockType) {\n648|\t\t\treturn invalid(\"canonical event content block[%d] type is outside the eight-type vocabulary\", index)\n649|\t\t}\n650|\t\t_, hasContent := members[\"content\"]\n651|\t\t_, hasDescriptor := members[\"blob_descriptor_id\"]\n652|\t\tif hasContent == hasDescriptor {\n653|\t\t\treturn invalid(\"canonical event content block[%d] carries content and descriptor members that are not exclusive\", index)\n654|\t\t}\n655|\t\tif content, present := members[\"content\"]; present {\n656|\t\t\ttext, ok := rawString(content)\n657|\t\t\tif !ok {\n658|\t\t\t\treturn invalid(\"canonical event content block[%d] content is not a string\", index)\n659|\t\t\t}\n660|\t\t\tif len(text) > maxInlineContent {\n661|\t\t\t\treturn invalid(\"canonical event content block[%d] inline content exceeds 64 KiB\", index)\n662|\t\t\t}\n663|\t\t}\n664|\t\tif descriptor, present := members[\"blob_descriptor_id\"]; present {\n665|\t\t\tif _, ok := checkDigest(descriptor); !ok {\n666|\t\t\t\treturn invalid(\"canonical event content block[%d] blob_descriptor_id is not a digest\", index)\n667|\t\t\t}\n668|\t\t}\n669|\t\tif mediaType, present := members[\"media_type\"]; present {\n670|\t\t\tif _, ok := checkStringBounds(mediaType, 1, 255); !ok {\n671|\t\t\t\treturn invalid(\"canonical event content block[%d] media_type is not a string[1..255]\", index)\n672|\t\t\t}\n673|\t\t}\n674|\t\tif extensions, present := members[\"extensions\"]; present {\n675|\t\t\tif extensionsFault := checkExtensionsClosed(extensions); extensionsFault != nil {\n676|\t\t\t\treturn invalid(\"canonical event content block[%d] extensions are not reverse-DNS keyed\", index)\n677|\t\t\t}\n678|\t\t}\n679|\t}\n680|\treturn nil\n681|}\n682|\n683|func buildSourceEvidence(input EvidenceInput) (map[string]any, error) {\n684|\ttuple, err := sessadapter.DecodeTuple(json.RawMessage(input.Environment))\n685|\tif err != nil {\n686|\t\treturn nil, invalid(\"source evidence environment is not an Environment Tuple: %v\", err)\n687|\t}\n688|\tif stringLength(input.NativeSessionID) < 1 || stringLength(input.NativeSessionID) > 512 {\n689|\t\treturn nil, invalid(\"source evidence native_session_id is not a string[1..512]\")\n690|\t}\n691|\tif err := SanitizeNativeKey(input.NativeSessionID); err != nil {\n692|\t\treturn nil, err\n693|\t}\n694|\tvar nativeEvent any\n695|\thasNativeEvent :=