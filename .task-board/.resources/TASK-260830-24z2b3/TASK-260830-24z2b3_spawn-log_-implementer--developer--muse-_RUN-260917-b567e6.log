\n356|        find=\"\\tif !ok || !validVisibility(visibility) {\\n\",\n357|        replace='\\tif !ok || (!validVisibility(visibility) && visibility != \"secret\") {\\n',\n358|        count=1,\n359|        run=\"TestCanonicalEventRefusals/decode/visibility_secret\",\n360|        expect=\"KILLED\",\n361|        note=\"Admits exactly visibility secret at decode; every other unknown visibility still refuses.\",\n362|    ),\n363|    Mutant(\n364|        name=\"N-verify-descriptors-skip-0\",\n365|        path=f\"{PACKAGE}/rawmanifest.go\",\n366|        find=\"\\t\\tif err := VerifyDescriptorAgreement(descriptor, entry.BlobDescriptorID, entry.BlobID, entry.ByteCount); err != nil {\\n\",\n367|        replace=\"\\t\\tif err := VerifyDescriptorAgreement(descriptor, entry.BlobDescriptorID, entry.BlobID, entry.ByteCount); err != nil && index != 0 {\\n\",\n368|        count=1,\n369|        run=\"TestVerifyRawManifestDescriptorsRefusals\",\n370|        expect=\"KILLED\",\n371|        note=\"Admits exactly a disagreeing descriptor at entry 0; every other entry still verifies.\",\n372|    ),\n373|    Mutant(\n374|        name=\"N-reconcile-rawkeys-dup\",\n375|        path=f\"{PACKAGE}/capturebuild.go\",\n376|        find='\\t\\tif seenRaw[key] {\\n\\t\\t\\treturn invalid(\"capture manifest raw keys carry duplicate %q\", key)\\n',\n377|        replace='\\t\\tif seenRaw[key] && key != \"store/blob-a\" {\\n\\t\\t\\treturn invalid(\"capture manifest raw keys carry duplicate %q\", key)\\n',\n378|        count=1,\n379|        run=\"TestCaptureManifestRefusals/reconciliation\",\n380|        expect=\"KILLED\",\n381|        note=\"Admits exactly the killer's duplicated raw key; every other duplicate still refuses.\",\n382|    ),\n383|    Mutant(\n384|        name=\"N-identity-rededecode\",\n385|        path=f\"{PACKAGE}/rawmanifest.go\",\n386|        find=\"\\tif _, err := DecodeNativeIdentity(json.RawMessage(encoded)); err != nil {\\n\",\n387|        replace='\\tif _, err := DecodeNativeIdentity(json.RawMessage(encoded)); err != nil && identity.IdentityKind != \"bogus\" {\\n',\n388|        count=1,\n389|        run=\"TestIdentityDigestRefusals\",\n390|        expect=\"KILLED\",\n391|        note=\"Admits exactly an undecodable identity of kind bogus; every other undecodable identity still refuses.\",\n392|    ),\n393|    Mutant(\n394|        name=\"N-plan-item-match\",\n395|        path=f\"{PACKAGE}/capturebuild.go\",\n396|        find=\"func checkPlanItemMatch(items []CaptureItem, planKeys []string) error {\\n\\tif len(items) != len(planKeys) {\\n\",\n397|        replace='func checkPlanItemMatch(items []CaptureItem, planKeys []string) error {\\n\\tif len(planKeys) == 4 && len(items) == 3 && planKeys[3] == \"store/zz-missing-item\" {\\n\\t\\treturn nil\\n\\t}\\n\\tif len(items) != len(planKeys) {\\n',\n398|        count=1,\n399|        run=\"TestCaptureManifestRefusals/build_plan_match\",\n400|        expect=\"KILLED\",\n401|        note=\"Admits exactly the killer's extra plan candidate; every other items/plan mismatch still refuses.\",\n402|    ),\n403|    Mutant(\n404|        name=\"N-block-xor\",\n405|        path=f\"{PACKAGE}/event.go\",\n406|        find=\"\\t\\tif hasContent == hasDescriptor {\\n\",\n407|        replace=\"\\t\\tif hasContent == hasDescriptor && hasContent {\\n\",\n408|        count=1,\n409|        run=\"TestCanonicalEventRefusals/build_envelope/block_neither_content_nor_descriptor\",\n410|        expect=\"KILLED\",\n411|        note=\"Admits exactly a block with neither content nor descriptor; a block with both still refuses.\",\n412|    ),\n413|    Mutant(\n414|        name=\"N-maximal-incomplete\",\n415|        path=f\"{PACKAGE}/capturebuild.go\",\n416|        find=\"\\tif !manifest.RawComplete {\\n\",\n417|        replace=\"\\tif !manifest.RawComplete && hasUnknownClass(manifest.Items) {\\n\",\n418|        count=1,\n419|        run=\"TestCaptureManifestRefusals/reconciliation\",\n420|        expect=\"KILLED\",\n421|        note=\"Admits exactly incomplete known-class manifests to maximal_safe; unknown still blocks.\",\n422|    ),\n423|    Mutant(\n424|        name=\"C-doc-comment\",\n425|        path=f\"{PACKAGE}/doc.go\",\n426|        find=\"// Authority: relux-works/agent-session-manager-spec@v0.6.0, Sections\\n\",\n427|        replace=\"// Authority: relux-works/agent-session-manager-spec@v0.6.0, Sections (control).\\n\",\n428|        count=1,\n429|        run=\"TestCaptureClassVocabularyIsPinned\",\n430|        expect=\"SURVIVED\",\n431|        note=\"Harmless control: a comment-only edit must survive.\",\n432|    ),\n433|]\n434|\n435|\n436|def run_mutant(mutant: Mutant) -> tuple[str, str, int, float]:\n437|    target = REPO / mutant.path\n438|    original = target.read_text()\n439|    found = original.count(mutant.find)\n440|    if found != mutant.count:\n441|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\", \"\", -1, 0.0\n442|    with tempfile.TemporaryDirectory() as staging:\n443|        backup = Path(staging) / \"backup\"\n444|        shutil.copy2(target, backup)\n445|        try:\n446|            target.write_text(original.replace(mutant.find, mutant.replace))\n447|            started = time.time()\n448|            run = subprocess.run(\n449|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n450|                cwd=REPO,\n451|                capture_output=True,\n452|                text=True,\n453|                timeout=300,\n454|            )\n455|            elapsed = time.time() - started\n456|        finally:\n457|            shutil.copy2(backup, target)\n458|    output = (run.stdout + run.stderr).strip()\n459|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n460|        return f\"ERROR: {mutant.name}: build broke under the patch\", output, run.returncode, elapsed\n461|    if run.returncode == 0:\n462|        verdict = \"SURVIVED\"\n463|    elif '--- FAIL' in output or 'FAIL:' in output:\n464|        verdict = \"KILLED\"\n465|    else:\n466|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\", output, run.returncode, elapsed\n467|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n468|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note}\", output, run.returncode, elapsed\n469|\n470|\n471|def main(argv: list[str]) -> int:\n472|    log_dir: Path | None = None\n473|    selected_names: list[str] = []\n474|    args = list(argv)\n475|    while args:\n476|        if args[0] == \"--log-dir\":\n477|            if len(args) < 2:\n478|                print(\"missing directory for --log-dir\")\n479|                return 2\n480|            log_dir = Path(args[1])\n481|            args = args[2:]\n482|        else:\n483|            selected_names.append(args[0])\n484|            args = args[1:]\n485|    selected = [m for m in MUTANTS if not selected_names or m.name in selected_names]\n486|    if selected_names and len(selected) != len(selected_names):\n487|        unknown = sorted(set(selected_names) - {m.name for m in selected})\n488|        print(f\"unknown mutants: {', '.join(unknown)}\")\n489|        return 2\n490|    if log_dir is not None:\n491|        log_dir.mkdir(parents=True, exist_ok=True)\n492|    failures = 0\n493|    for mutant in selected:\n494|        try:\n495|            line, output, exit_code, elapsed = run_mutant(mutant)\n496|        except subprocess.TimeoutExpired:\n497|            line, output, exit_code, elapsed = f\"ERROR: {mutant.name}: killer timed out\", \"\", -1, 0.0\n498|        print(line, flush=True)\n499|        if log_dir is not None:\n500|            (log_dir / f\"{mutant.name}.log\").write_text(\n(more lines below)","final_result":true}}}
