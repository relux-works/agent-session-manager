ons 1.5\\\", err)\\n254:\\tv3(\\\"P2u EncodeNativeIdentity(ext 2^60) [documented pre-validated]\\\", err)\\n256:\\t\\tfmt.Printf(\\\"PROBE P2u encoded extensions bytes: %s\\\\n\\\", member3(enc, \\\"extensions\\\"))\\n266:\\t\\t\\tv3(fmt.Sprintf(\\\"N1 build %s payload %s\\\", kind, payload), err)\\n268:\\t\\t\\t\\tfmt.Printf(\\\"PROBE N1 %s sealed payload bytes: %s\\\\n\\\", kind, member3(built, \\\"payload\\\"))\\n270:\\t\\t\\t\\tv3(fmt.Sprintf(\\\"N1b decode of sealed %s payload %s\\\", kind, payload), derr)\\n272:\\t\\t\\t\\t\\tfmt.Printf(\\\"PROBE N1b decoded Payload map: %v\\\\n\\\", dec.Payload)\\n286:\\t\\t\\t\\tv3(\\\"N2 omitSelfDigest usage payload \\\"+payload, derr)\\n291:\\t\\t\\tv3(\\\"N2 decode usage payload \\\"+payload+\\\" (resealed)\\\", derr)\\n298:\\tv3(\\\"N3 message block content is an object (json type)\\\", err)\\n302:\\tv3(\\\"N3b message block descriptor + media_type\\\", err)\\n306:\\tv3(\\\"N3c message block inline 40000 chars / 80000 bytes (64 KiB bound unit?)\\\", err)\\n310:\\tv3(\\\"N3d message block duplicate member\\\", err)\\n314:\\tv3(\\\"N3e message payload duplicate top-level member\\\", err)\\n318:\\tv3(\\\"N3f message content_blocks not an array\\\", err)\\n323:\\tv3(\\\"N3g tool_call with content_blocks (neither content nor descriptor)\\\", err)\\n414:\\tv3(\\\"P5c build plan=[a,a,token] items=[a,b,token] (b not a plan candidate)\\\", err)\\n417:\\t\\tfmt.Printf(\\\"PROBE P5c sealed raw_complete=%v items=%d\\\\n\\\", mm.RawComplete, len(mm.Items))\\n489:\\tv3(\\\"P7d block content null\\\", err)\\n681:\\tv3(\\\"P20c closed_store input_blocked false\\\", err)\\n\",\n  \"original_output_bytes\": 2185,\n  \"original_output_tokens\": 547,\n  \"truncated\": false\n}","final_result":true}}}
