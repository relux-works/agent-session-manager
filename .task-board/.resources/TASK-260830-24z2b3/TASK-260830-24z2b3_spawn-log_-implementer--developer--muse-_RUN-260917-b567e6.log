{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb63","stream":{"kind":"session","id":"01a0b144-2d0b-7f30-96a3-e7fabafc632c"},"sequence":1036,"recorded_at":1780531400002067,"record_type":"event","durability":"durable","causation_id":"96a3132b-8530-4e47-8657-36d15f2da569","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"96a3132b-8530-4e47-8657-36d15f2da569","run_stream":{"kind":"run","id":"96a3132b-8530-4e47-8657-36d15f2da569"},"task_stream":{"kind":"task","id":"01a0b149-c5bd-7da2-bf3e-7e59a0d54069"},"task_id":"01a0b149-c5bd-7da2-bf3e-7e59a0d54069","event":{"kind":"output","task_id":"01a0b149-c5bd-7da2-bf3e-7e59a0d54069","chunk":"Read text file `internal/clonebundle/refusal_session_event_test.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"errors\"\n6|\t\"fmt\"\n7|\t\"strings\"\n8|\t\"testing\"\n9|)\n10|\n11|// Negative tests for the Canonical Session, Canonical Event, identity,\n12|// generation, and blob-agreement gates. Every row drives a production\n13|// entry point.\n14|\n15|// unsortedPair returns two distinct fixture digests in\n16|// descending order: feeding them where ascending order is required\n17|// always exercises the unsorted refusal.\n18|func unsortedPair(seedA, seedB string) (string, string) {\n19|\tfirst, second := fixtureDigest(seedA), fixtureDigest(seedB)\n20|\tif first < second {\n21|\t\tfirst, second = second, first\n22|\t}\n23|\treturn first, second\n24|}\n25|\n26|func mustSessionBytes(t *testing.T) []byte {\n27|\tt.Helper()\n28|\tbuilt, err := BuildCanonicalSession(validSessionInput())\n29|\tif err != nil {\n30|\t\tt.Fatal(err)\n31|\t}\n32|\treturn built\n33|}\n34|\n35|func mustEventBytes(t *testing.T, status string) []byte {\n36|\tt.Helper()\n37|\tbuilt, err := BuildCanonicalEvent(validEventInput(status))\n38|\tif err != nil {\n39|\t\tt.Fatal(err)\n40|\t}\n41|\treturn built\n42|}\n43|\n44|func TestCanonicalSessionRefusals(t *testing.T) {\n45|\tt.Run(\"build actors\", func(t *testing.T) {\n46|\t\tbuild := func(actors []ActorInput) error {\n47|\t\t\tinput := validSessionInput()\n48|\t\t\tinput.Actors = actors\n49|\t\t\t_, err := BuildCanonicalSession(input)\n50|\t\t\treturn err\n51|\t\t}\n52|\t\tcases := []struct {\n53|\t\t\tname     string\n54|\t\t\tactors   []ActorInput\n55|\t\t\tfragment string\n56|\t\t}{\n57|\t\t\t{\"no actors\", nil, \"[1..1024]\"},\n58|\t\t\t{\"no main\", []ActorInput{{ActorID: fixtureActorSub, Kind: \"subagent\", ParentActorID: strptr(fixtureActorMain)}}, \"exactly one\"},\n59|\t\t\t{\"two mains\", []ActorInput{\n60|\t\t\t\t{ActorID: fixtureActorMain, Kind: \"main\"},\n61|\t\t\t\t{ActorID: fixtureActorSub, Kind: \"main\"},\n62|\t\t\t}, \"exactly one\"},\n63|\t\t\t{\"main with parent\", []ActorInput{{ActorID: fixtureActorMain, Kind: \"main\", ParentActorID: strptr(fixtureActorSub)}}, \"carries a parent\"},\n64|\t\t\t{\"non-main null parent\", []ActorInput{\n65|\t\t\t\t{ActorID: fixtureActorMain, Kind: \"main\"},\n66|\t\t\t\t{ActorID: fixtureActorSub, Kind: \"external\"},\n67|\t\t\t}, \"requires a parent\"},\n68|\t\t\t{\"duplicate actor id\", []ActorInput{\n69|\t\t\t\t{ActorID: fixtureActorMain, Kind: \"main\"},\n70|\t\t\t\t{ActorID: fixtureActorMain, Kind: \"subagent\", ParentActorID: strptr(fixtureActorMain)},\n71|\t\t\t}, \"unique by actor ID\"},\n72|\t\t\t{\"bad kind\", []ActorInput{{ActorID: fixtureActorMain, Kind: \"ghost\"}}, \"main|subagent|external\"},\n73|\t\t\t{\"bad actor id\", []ActorInput{{ActorID: \"nope\", Kind: \"main\"}}, \"not a UUIDv7\"},\n74|\t\t\t{\"unsanitized source id\", []ActorInput{{ActorID: fixtureActorMain, Kind: \"main\", SourceNativeID: strptr(\"/abs/x\")}}, \"absolute source path\"},\n75|\t\t\t{\"empty name\", []ActorInput{{ActorID: fixtureActorMain, Kind: \"main\", Name: strptr(\"\")}}, \"string[1..512]\"},\n76|\t\t}\n77|\t\tfor _, tc := range cases {\n78|\t\t\tt.Run(tc.name, func(t *testing.T) {\n79|\t\t\t\trequireRefusal(t, build(tc.actors), tc.fragment)\n80|\t\t\t})\n81|\t\t}\n82|\t})\n83|\tt.Run(\"build envelope\", func(t *testing.T) {\n84|\t\tcases := []struct {\n85|\t\t\tname     string\n86|\t\t\tmutate   func(*CanonicalSessionInput)\n87|\t\t\tfragment string\n88|\t\t}{\n89|\t\t\t{\"bad logical\", func(in *CanonicalSessionInput) { in.LogicalSessionID = \"nope\" }, \"not a UUIDv7\"},\n90|\t\t\t{\"bad tuple\", func(in *CanonicalSessionInput) { in.SourceEnvironment = []byte(`{}`) }, \"Environment Tuple\"},\n91|\t\t\t{\"unsanitized native id\", func(in *CanonicalSessionInput) { in.SourceNativeSessionID = fixtureSessionID }, \"fabricated AX\"},\n92|\t\t\t{\"empty title\", func(in *CanonicalSessionInput) { in.Title = strptr(\"\") }, \"string[1..4096]\"},\n93|\t\t\t{\"bad workspace\", func(in *CanonicalSessionInput) { in.Workspace = []byte(`{}`) }, \"workspace\"},\n94|\t\t\t{\"empty events\", func(in *CanonicalSessionInput) { in.EventIDs = nil }, \"[1..1000000]\"},\n95|\t\t\t{\"dup events\", func(in *CanonicalSessionInput) { in.EventIDs = []string{fixtureDigest(\"x\"), fixtureDigest(\"x\")} }, \"not unique\"},\n96|\t\t\t{\"bad event digest\", func(in *CanonicalSessionInput) { in.EventIDs = []string{\"nope\"} }, \"not a digest\"},\n97|\t\t\t{\"empty heads\", func(in *CanonicalSessionInput) { in.HeadEventIDs = nil }, \"[1..1024]\"},\n98|\t\t\t{\"head outside events\", func(in *CanonicalSessionInput) { in.HeadEventIDs = []string{fixtureDigest(\"elsewhere\")} }, \"outside event_ids\"},\n99|\t\t\t{\"heads unsorted\", func(in *CanonicalSessionInput) {\n100|\t\t\t\thigh, low := unsortedPair(\"unsorted-head-a\", \"unsorted-head-b\")\n101|\t\t\t\tin.EventIDs = []string{low, high}\n102|\t\t\t\tin.HeadEventIDs = []string{high, low}\n103|\t\t\t}, \"sorted unique\"},\n104|\t\t\t{\"bad created_at\", func(in *CanonicalSessionInput) { in.CreatedAt = strptr(\"yesterday\") }, \"not a timestamp\"},\n105|\t\t\t{\"bad extensions\", func(in *CanonicalSessionInput) { in.Extensions = map[string]any{\"no-dots\": 1} }, \"reverse-DNS\"},\n106|\t\t}\n107|\t\tfor _, tc := range cases {\n108|\t\t\tt.Run(tc.name, func(t *testing.T) {\n109|\t\t\t\tinput := validSessionInput()\n110|\t\t\t\ttc.mutate(&input)\n111|\t\t\t\t_, err := BuildCanonicalSession(input)\n112|\t\t\t\trequireRefusal(t, err, tc.fragment)\n113|\t\t\t})\n114|\t\t}\n115|\t})\n116|\tt.Run(\"decode\", func(t *testing.T) {\n117|\t\tvalid := mustSessionBytes(t)\n118|\t\tcases := []struct {\n119|\t\t\tname     string\n120|\t\t\tbody     func(t *testing.T) []byte\n(more lines below)","final_result":true}}}
