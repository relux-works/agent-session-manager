{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cf9b","stream":{"kind":"session","id":"01a0b144-2d0b-7f30-96a3-e7fabafc632c"},"sequence":1576,"recorded_at":1780531400003147,"record_type":"event","durability":"durable","causation_id":"96a3132b-8530-4e47-8657-36d15f2da569","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"96a3132b-8530-4e47-8657-36d15f2da569","run_stream":{"kind":"run","id":"96a3132b-8530-4e47-8657-36d15f2da569"},"call_id":"call_01a0b15226c87513b8cf9b6a1dfc9361","text":"Read text file `internal/clonebundle/session.go`.\n(139 line(s) above)\n140|\tvar parent *scalar.UUIDv7\n141|\tif input.ParentActorID != nil {\n142|\t\tvalue, err := scalar.ParseUUIDv7(*input.ParentActorID)\n143|\t\tif err != nil {\n144|\t\t\treturn Actor{}, invalid(\"actor[%d] parent_actor_id is not a UUIDv7: %v\", index, err)\n145|\t\t}\n146|\t\tparent = &value\n147|\t}\n148|\tif input.Kind == \"main\" && parent != nil {\n149|\t\treturn Actor{}, invalid(\"actor[%d] main actor carries a parent\", index)\n150|\t}\n151|\tif input.Kind != \"main\" && parent == nil {\n152|\t\treturn Actor{}, invalid(\"actor[%d] non-main actor requires a parent\", index)\n153|\t}\n154|\tif input.Name != nil && (stringLength(*input.Name) < 1 || stringLength(*input.Name) > 512) {\n155|\t\treturn Actor{}, invalid(\"actor[%d] name is not a string[1..512]\", index)\n156|\t}\n157|\tif input.SourceNativeID != nil {\n158|\t\tif stringLength(*input.SourceNativeID) < 1 || stringLength(*input.SourceNativeID) > 512 {\n159|\t\t\treturn Actor{}, invalid(\"actor[%d] source_native_id is not a string[1..512]\", index)\n160|\t\t}\n161|\t\tif err := SanitizeNativeKey(*input.SourceNativeID); err != nil {\n162|\t\t\treturn Actor{}, err\n163|\t\t}\n164|\t}\n165|\tif input.Model != nil && (stringLength(*input.Model) < 1 || stringLength(*input.Model) > 512) {\n166|\t\treturn Actor{}, invalid(\"actor[%d] model is not a string[1..512]\", index)\n167|\t}\n168|\treturn Actor{\n169|\t\tActorID:        actorID,\n170|\t\tKind:           input.Kind,\n171|\t\tParentActorID:  parent,\n172|\t\tName:           input.Name,\n173|\t\tSourceNativeID: input.SourceNativeID,\n174|\t\tModel:          input.Model,\n175|\t}, nil\n176|}\n177|\n178|func actorObject(actor Actor) map[string]any {\n179|\tvar parent any\n180|\tif actor.ParentActorID != nil {\n181|\t\tparent = actor.ParentActorID.String()\n182|\t}\n183|\tvar name any\n184|\tif actor.Name != nil {\n185|\t\tname = *actor.Name\n186|\t}\n187|\tvar nativeID any\n188|\tif actor.SourceNativeID != nil {\n189|\t\tnativeID = *actor.SourceNativeID\n190|\t}\n191|\tvar model any\n192|\tif actor.Model != nil {\n193|\t\tmodel = *actor.Model\n194|\t}\n195|\treturn map[string]any{\n196|\t\t\"actor_id\":         actor.ActorID.String(),\n197|\t\t\"kind\":             actor.Kind,\n198|\t\t\"parent_actor_id\":  parent,\n199|\t\t\"name\":             name,\n200|\t\t\"source_native_id\": nativeID,\n201|\t\t\"model\":            model,\n202|\t\t\"extensions\":       map[string]any{},\n203|\t}\n204|}\n205|\n206|var canonicalSessionMembers = map[string]bool{\n207|\t\"schema\": true, \"schema_version\": true, \"canonical_session_id\": true,\n208|\t\"logical_session_id\": true, \"source_environment\": true,\n209|\t\"source_native_session_id\": true, \"title\": true, \"workspace\": true,\n210|\t\"actors\": true, \"event_ids\": true, \"head_event_ids\": true,\n211|\t\"created_at\": true, \"updated_at\": true, \"extensions\": true,\n212|}\n213|\n214|var canonicalSessionRequired = []string{\n215|\t\"schema\", \"schema_version\", \"canonical_session_id\",\n216|\t\"logical_session_id\", \"source_environment\",\n217|\t\"source_native_session_id\", \"title\", \"workspace\",\n218|\t\"actors\", \"event_ids\", \"head_event_ids\",\n219|\t\"created_at\", \"updated_at\", \"extensions\",\n220|}\n221|\n222|// CanonicalSession is one validated Canonical Session.\n223|type CanonicalSession struct {\n224|\tSessionID             scalar.Digest\n225|\tLogicalSessionID      scalar.UUIDv7\n226|\tSourceEnvironment     sessadapter.Tuple\n227|\tSourceNativeSessionID string\n228|\tTitle                 *string\n229|\tWorkspace             WorkspaceBinding\n230|\tActors                []Actor\n231|\tEventIDs              []scalar.Digest\n232|\tHeadEventIDs          []scalar.Digest\n233|\tCreatedAt             *scalar.Timestamp\n234|\tUpdatedAt             *scalar.Timestamp\n235|}\n236|\n237|// CanonicalSessionInput is the caller-supplied canonical session\n238|// candidate for Build.\n239|type CanonicalSessionInput struct {\n240|\tLogicalSessionID      string\n241|\tSourceEnvironment     []byte\n242|\tSourceNativeSessionID string\n243|\tTitle                 *string\n244|\tWorkspace             []byte\n245|\tActors                []ActorInput\n246|\tEventIDs              []string\n247|\tHeadEventIDs          []string\n248|\tCreatedAt             *string\n249|\tUpdatedAt             *string\n250|\tExtensions            map[string]any\n251|}\n252|\n253|// BuildCanonicalSession constructs one closed Canonical Session\n254|// 1.0.0 as canonical bytes. Identical inputs produce byte-identical\n255|// outputs.\n256|func BuildCanonicalSession(input CanonicalSessionInput) ([]byte, error) {\n257|\tobject, err := buildCanonicalSession(input)\n258|\tif err != nil {\n259|\t\treturn nil, err\n260|\t}\n261|\tomitted, err := canonicalizeObject(object)\n262|\tif err != nil {\n263|\t\treturn nil, err\n264|\t}\n265|\tsessionID := scalar.SHA256Digest(omitted)\n266|\tobject[canonicalSessionSelf] = sessionID.String()\n267|\treturn canonicalizeObject(object)\n268|}\n269|\n270|func buildCanonicalSession(input CanonicalSessionInput) (map[string]any, error) {\n271|\tlogical, err := scalar.ParseUUIDv7(input.LogicalSessionID)\n272|\tif err != nil {\n273|\t\treturn nil, invalid(\"canonical session logical_session_id is not a UUIDv7: %v\", err)\n274|\t}\n275|\ttuple, err := sessadapter.DecodeTuple(json.RawMessage(input.SourceEnvironment))\n276|\tif err != nil {\n277|\t\treturn nil, invalid(\"canonical session source_environment is not an Environment Tuple: %v\", err)\n278|\t}\n279|\tif stringLength(input.SourceNativeSessionID) < 1 || stringLength(input.SourceNativeSessionID) > 512 {\n280|\t\treturn nil, invalid(\"canonical session source_native_session_id is not a string[1..512]\")\n281|\t}\n282|\tif err := SanitizeNativeKey(input.SourceNativeSessionID); err != nil {\n283|\t\treturn nil, err\n284|\t}\n285|\tvar title any\n286|\tif input.Title != nil {\n287|\t\tif stringLength(*input.Title) < 1 || stringLength(*input.Title) > 4096 {\n288|\t\t\treturn nil, invalid(\"canonical session title is not a string[1..4096]\")\n289|\t\t}\n290|\t\ttitle = *input.Title\n291|\t}\n292|\tif _, err := DecodeWorkspaceBinding(json.RawMessage(input.Workspace)); err != nil {\n293|\t\treturn nil, err\n294|\t}\n295|\tif len(input.Actors) < 1 || len(input.Actors) > 1024 {\n296|\t\treturn nil, invalid(\"canonical session carries %d actors, want [1..1024]\", len(input.Actors))\n297|\t}\n298|\tactors := make([]Actor, 0, len(input.Actors))\n299|\tseenActors := map[string]bool{}\n300|\tmainCount := 0\n301|\tfor index, candidate := range input.Actors {\n302|\t\tactor, err := buildActor(candidate, index)\n303|\t\tif err != nil {\n304|\t\t\treturn nil, err\n305|\t\t}\n306|\t\tif seenActors[actor.ActorID.String()] {\n307|\t\t\treturn nil, invalid(\"canonical session actors are not unique by actor ID\")\n308|\t\t}\n309|\t\tseenActors[actor.ActorID.String()] = true\n310|\t\tif actor.Kind == \"main\" {\n311|\t\t\tmainCount++\n312|\t\t}\n313|\t\tactors = append(actors, actor)\n314|\t}\n315|\tif mainCount != 1 {\n316|\t\treturn nil, invalid(\"canonical session carries %d main actors, want exactly one\", mainCount)\n317|\t}\n318|\teventIDs, err := parseOrderedUniqueDigests(input.EventIDs, 1, 1000000, \"event_ids\")\n319|\tif err != nil {\n320|\t\treturn nil, err\n321|\t}\n322|\theadIDs, err := parseSortedUniqueDigestStrings(input.HeadEventIDs, 1, 1024, \"head_event_ids\")\n323|\tif err != nil {\n324|\t\treturn nil, err\n325|\t}\n326|\teventSet := map[string]bool{}\n327|\tfor _, id := range eventIDs {\n328|\t\teventSet[id.String()] = true\n329|\t}\n330|\tfor _, id := range headIDs {\n331|\t\tif !eventSet[id.String()] {\n332|\t\t\treturn nil, invalid(\"canonical session head_event_ids carry an ID outside event_ids\")\n333|\t\t}\n334|\t}\n335|\tcreatedAt, err := parseNullableTimestamp(input.CreatedAt, \"created_at\")\n336|\tif err != nil {\n337|\t\treturn nil, err\n338|\t}\n339|\tupdatedAt, err := parseNullableTimestamp(input.UpdatedAt, \"updated_at\")\n340|\tif err != nil {\n341|\t\treturn nil, err\n342|\t}\n343|\tif _, err := encodeExtensions(input.Extensions); err != nil {\n344|\t\treturn nil, err\n345|\t}\n346|\tvar workspaceValue any\n347|\tif err := json.Unmarshal(bytesTrimSpace(json.RawMessage(input.Workspace)), &workspaceValue); err != nil {\n348|\t\treturn nil, invalid(\"canonical session workspace is not JSON: %v\", err)\n349|\t}\n350|\tactorObjects := make([]any, 0, len(actors))\n351|\tfor _, actor := range actors {\n352|\t\tactorObjects = append(actorObjects, actorObject(actor))\n353|\t}\n354|\treturn map[string]any{\n355|\t\t\"schema\":                   canonicalSessionSchema,\n356|\t\t\"schema_version\":           canonicalSessionVersion,\n357|\t\t\"logical_session_id\":       logical.String(),\n358|\t\t\"source_environment\":       tupleObject(tuple),\n359|\t\t\"source_native_session_id\": input.SourceNativeSessionID,\n360|\t\t\"title\":                    title,\n361|\t\t\"workspace\":                workspaceValue,\n362|\t\t\"actors\":                   actorObjects,\n363|\t\t\"event_ids\":                digestStrings(eventIDs),\n364|\t\t\"head_event_ids\":           digestStrings(headIDs),\n365|\t\t\"created_at\":               createdAt,\n366|\t\t\"updated_at\":               updatedAt,\n367|\t\t\"extensions\":               extensionValue(input.Extensions),\n368|\t}, nil\n369|}\n370|\n371|// DecodeCanonicalSession validates one closed Canonical Session\n372|// 1.0.0: exact members, schema/version, self-digest agreement,\n373|// exactly one main actor, ordered unique event IDs, and head IDs\n374|// drawn from the event set.\n375|func DecodeCanonicalSession(data []byte) (CanonicalSession, error) {\n376|\tmembers, fault := decodeStrictObject(data)\n377|\tif fault != nil {\n378|\t\treturn CanonicalSession{}, invalid(\"canonical session %s (%s)\", fault.detail, memberField(fault.member))\n379|\t}\n380|\tif name, unknown := unknownMember(members, canonicalSessionMembers); unknown {\n381|\t\treturn CanonicalSession{}, invalid(\"canonical session carries unknown member %q\", name)\n382|\t}\n383|\tif name, missing := missingMember(members, canonicalSessionRequired); missing {\n384|\t\treturn CanonicalSession{}, invalid(\"canonical session misses a required member %q\", name)\n385|\t}\n386|\tschema, ok := rawString(members[\"schema\"])\n387|\tif !ok || schema != canonicalSessionSchema {\n388|\t\treturn CanonicalSession{}, invalid(\"canonical session schema is not the canonical session\")\n389|\t}\n390|\tversion, ok := rawString(members[\"schema_version\"])\n391|\tif !ok || version != canonicalSessionVersion {\n392|\t\treturn CanonicalSession{}, invalid(\"canonical session version is not 1.0.0\")\n393|\t}\n394|\tsessionID, ok := checkDigest(members[canonicalSessionSelf])\n395|\tif !ok {\n396|\t\treturn CanonicalSession{}, invalid(\"canonical session canonical_session_id is not a digest\")\n397|\t}\n398|\tlogical, ok := checkUUIDv7(members[\"logical_session_id\"])\n399|\tif !ok {\n400|\t\treturn CanonicalSession{}, invalid(\"canonical session logical_session_id is not a UUIDv7\")\n401|\t}\n402|\ttuple, err := sessadapter.DecodeTuple(members[\"source_environment\"])\n403|\tif err != nil {\n404|\t\treturn CanonicalSession{}, invalid(\"canonical session source_environment is not an Environment Tuple: %v\", err)\n405|\t}\n406|\tnativeID, ok := checkStringBounds(members[\"source_native_session_id\"], 1, 512)\n407|\tif !ok {\n408|\t\treturn CanonicalSession{}, invalid(\"canonical session source_native_session_id is not a string[1..512]\")\n409|\t}\n410|\tif err := SanitizeNativeKey(nativeID); err != nil {\n411|\t\treturn CanonicalSession{}, err\n412|\t}\n413|\tvar title *string\n414|\tif !isNull(members[\"title\"]) {\n415|\t\tvalue, ok := checkStringBounds(members[\"title\"], 1, 4096)\n416|\t\tif !ok {\n417|\t\t\treturn CanonicalSession{}, invalid(\"canonical session title is not a string[1..4096]\")\n418|\t\t}\n419|\t\ttitle = &value\n420|\t}\n421|\tworkspace, err := DecodeWorkspaceBinding(members[\"workspace\"])\n422|\tif err != nil {\n423|\t\treturn CanonicalSession{}, err\n424|\t}\n425|\tactors, err := decodeActors(members[\"actors\"])\n426|\tif err != nil {\n427|\t\treturn CanonicalSession{}, err\n428|\t}\n429|\teventIDs, err := decodeOrderedUniqueDigests(members[\"event_ids\"], 1, 1000000, \"event_ids\")\n430|\tif err != nil {\n431|\t\treturn CanonicalSession{}, err\n432|\t}\n433|\theadIDs, ok := checkSortedUniqueDigests(members[\"head_event_ids\"], 1, 1024)\n434|\tif !ok {\n435|\t\treturn CanonicalSession{}, invalid(\"canonical session head_event_ids are not sorted unique digest[1..1024]\")\n436|\t}\n437|\teventSet := map[string]bool{}\n438|\tfor _, id := range eventIDs {\n439|\t\teventSet[id.String()] = true\n440|\t}\n441|\tfor _, id := range headIDs {\n442|\t\tif !eventSet[id.String()] {\n443|\t\t\treturn CanonicalSession{}, invalid(\"canonical session head_event_ids carry an ID outside event_ids\")\n444|\t\t}\n445|\t}\n446|\tcreatedAt, err := decodeNullableTimestamp(members, \"created_at\", \"canonical session\")\n447|\tif err != nil {\n448|\t\treturn CanonicalSession{}, err\n449|\t}\n450|\tupdatedAt, err := decodeNullableTimestamp(members, \"updated_at\", \"canonical session\")\n451|\tif err != nil {\n452|\t\treturn CanonicalSession{}, err\n453|\t}\n454|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n455|\t\treturn CanonicalSession{}, invalid(\"canonical session extensions %s\", extensionsFault)\n456|\t}\n457|\tif err := verifySelfDigest(members, canonicalSessionSelf, sessionID); err != nil {\n458|\t\treturn CanonicalSession{}, err\n459|\t}\n460|\treturn CanonicalSession{\n461|\t\tSessionID:             sessionID,\n462|\t\tLogicalSessionID:      logical,\n463|\t\tSourceEnvironment:     tuple,\n464|\t\tSourceNativeSessionID: nativeID,\n465|\t\tTitle:                 title,\n466|\t\tWorkspace:             workspace,\n467|\t\tActors:                actors,\n468|\t\tEventIDs:              eventIDs,\n469|\t\tHeadEventIDs:          headIDs,\n470|\t\tCreatedAt:             createdAt,\n471|\t\tUpdatedAt:             updatedAt,\n472|\t}, nil\n473|}\n474|\n475|func decodeActors(raw json.RawMessage) ([]Actor, error) {\n476|\telements, ok := decodeArray(raw)\n477|\tif !ok {\n478|\t\treturn nil, invalid(\"canonical session actors are not an array\")\n479|\t}\n480|\tif len(elements) < 1 || len(elements) > 1024 {\n481|\t\treturn nil, invalid(\"canonical session carries %d actors, want [1..1024]\", len(elements))\n482|\t}\n483|\tactors := make([]Actor, 0, len(elements))\n484|\tseen := map[string]bool{}\n485|\tmainCount := 0\n486|\tfor index, element := range elements {\n487|\t\tactor, err := decodeActor(element, index)\n488|\t\tif err != nil {\n489|\t\t\treturn nil, err\n490|\t\t}\n491|\t\tif seen[actor.ActorID.String()] {\n492|\t\t\treturn nil, invalid(\"canonical session actors are not unique by actor ID\")\n493|\t\t}\n494|\t\tseen[actor.ActorID.String()] = true\n495|\t\tif actor.Kind == \"main\" {\n496|\t\t\tmainCount++\n497|\t\t}\n498|\t\tactors = append(actors, actor)\n499|\t}\n500|\tif mainCount != 1 {\n501|\t\treturn nil, invalid(\"canonical session carries %d main actors, want exactly one\", mainCount)\n502|\t}\n503|\treturn actors, nil\n504|}\n505|\n506|// decodeOrderedUniqueDigests validates ordered unique digests: order\n507|// is the caller's (event order), uniqueness is exact.\n508|func decodeOrderedUniqueDigests(raw json.RawMessage, minimum, maximum int, name string) ([]scalar.Digest, error) {\n509|\telements, ok := decodeArray(raw)\n510|\tif !ok {\n511|\t\treturn nil, invalid(\"canonical session %s are not an array\", name)\n512|\t}\n513|\tif len(elements) < minimum || len(elements) > maximum {\n514|\t\treturn nil, invalid(\"canonical session %s carry %d IDs, want [%d..%d]\", name, len(elements), minimum, maximum)\n515|\t}\n516|\tids := make([]scalar.Digest, 0, len(elements))\n517|\tseen := map[string]bool{}\n518|\tfor index, element := range elements {\n519|\t\tid, ok := checkDigest(element)\n520|\t\tif !ok {\n521|\t\t\treturn nil, invalid(\"canonical session %s[%d] is not a digest\", name, index)\n522|\t\t}\n523|\t\tif seen[id.String()] {\n524|\t\t\treturn nil, invalid(\"canonical session %s are not unique\", name)\n525|\t\t}\n526|\t\tseen[id.String()] = true\n527|\t\tids = append(ids, id)\n528|\t}\n529|\treturn ids, nil\n530|}\n531|\n532|func parseOrderedUniqueDigests(values []string, minimum, maximum int, name string) ([]scalar.Digest, error) {\n533|\tif len(values) < minimum || len(values) > maximum {\n534|\t\treturn nil, invalid(\"canonical session %s carry %d IDs, want [%d..%d]\", name, len(values), minimum, maximum)\n535|\t}\n536|\tids := make([]scalar.Digest, 0, len(values))\n537|\tseen := map[string]bool{}\n538|\tfor index, value := range values {\n539|\t\tid, err := scalar.ParseDigest(value)\n540|\t\tif err != nil {\n541|\t\t\treturn nil, invalid(\"canonical session %s[%d] is not a digest: %v\", name, index, err)\n542|\t\t}\n543|\t\tif seen[id.String()] {\n544|\t\t\treturn nil, invalid(\"canonical session %s are not unique\", name)\n545|\t\t}\n546|\t\tseen[id.String()] = true\n547|\t\tids = append(ids, id)\n548|\t}\n549|\treturn ids, nil\n550|}\n551|\n552|func parseSortedUniqueDigestStrings(values []string, minimum, maximum int, name string) ([]scalar.Digest, error) {\n553|\tif len(values) < minimum || len(values) > maximum {\n554|\t\treturn nil, invalid(\"canonical session %s carry %d IDs, want [%d..%d]\", name, len(values), minimum, maximum)\n555|\t}\n556|\tids := make([]scalar.Digest, 0, len(values))\n557|\tprevious := \"\"\n558|\tfor index, value := range values {\n559|\t\tid, err := scalar.ParseDigest(value)\n560|\t\tif err != nil {\n561|\t\t\treturn nil, invalid(\"canonical session %s[%d] is not a digest: %v\", name, index, err)\n562|\t\t}\n563|\t\tif index > 0 && id.String() <= previous {\n564|\t\t\treturn nil, invalid(\"canonical session %s are not sorted unique\", name)\n565|\t\t}\n566|\t\tprevious = id.String()\n567|\t\tids = append(ids, id)\n568|\t}\n569|\treturn ids, nil\n570|}\n571|\n572|func parseNullableTimestamp(value *string, name string) (any, error) {\n573|\tif value == nil {\n574|\t\treturn nil, nil\n575|\t}\n576|\tstamp, err := scalar.ParseTimestamp(*value)\n577|\tif err != nil {\n578|\t\treturn nil, invalid(\"canonical session %s is not a timestamp: %v\", name, err)\n579|\t}\n580|\treturn stamp.String(), nil\n581|}\n582|\n583|func decodeNullableTimestamp(members map[string]json.RawMessage, name, owner string) (*scalar.Timestamp, error) {\n584|\traw, present := members[name]\n585|\tif !present {\n586|\t\treturn nil, invalid(\"%s misses a required member %q\", owner, name)\n587|\t}\n588|\tif isNull(raw) {\n589|\t\treturn nil, nil\n590|\t}\n591|\tstamp, ok := checkTimestamp(raw)\n592|\tif !ok {\n593|\t\treturn nil, invalid(\"%s %s is not a timestamp\", owner, name)\n594|\t}\n595|\treturn &stamp, nil\n596|}\n597|\n598|func digestStrings(ids []scalar.Digest) []any {\n599|\tvalues := make([]any, 0, len(ids))\n600|\tfor _, id := range ids {\n601|\t\tvalues = append(values, id.String())\n602|\t}\n603|\treturn values\n604|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cf9d","stream":{"kind":"session","id":"01a0b144-2d0b-7f30-96a3-e7fabafc632c"},"sequence":1577,"recorded_at":1780531400003149,"record_type":"event","durability":"durable","causation_id":"96a3132b-8530-4e47-8657-36d15f2da569","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"96a3132b-8530-4e47-8657-36d15f2da569","run_stream":{"kind":"run","id":"96a3132b-8530-4e47-8657-36d15f2da569"},"call_id":"call_01a0b152293475c391ea65aad053a2b9","text":"{\n  \"chunk_id\": \"exec-42-1\",\n  \"command\": \"cd /Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree && sed -n '1,80p' internal/clonebundle/refusal_test.go; echo \\\"===tamper===\\\"; grep -n \\\"func tamper\\\" -A 15 internal/clonebundle/*_test.go | head -25\",\n  \"description\": \"Read refusal helpers and tamper\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"package clonebundle\\n\\nimport (\\n\\t\\\"encoding/json\\\"\\n\\t\\\"errors\\\"\\n\\t\\\"strings\\\"\\n\\t\\\"testing\\\"\\n)\\n\\n// Negative tests for the raw manifest, capture items, source basis,\\n// and capture boundary gates. Every row drives a production entry\\n// point and asserts the refusal; rows that share a verdict shape\\n// assert a message fragment so the firing gate is identified.\\n\\nfunc mustRawBytes(t *testing.T) []byte {\\n\\tt.Helper()\\n\\tidentity := fixtureNativeIdentity()\\n\\tdigest, err := IdentityDigest(identity, nil)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tbuilt, err := BuildRawObjectManifest(fixtureOperationID, []byte(fixtureTupleJSON()),\\n\\t\\t\\\"native-session-alpha\\\", digest.String(), fixtureDigest(\\\"test-capture-plan\\\"), validEntryInputs(t), nil)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\treturn built\\n}\\n\\nfunc tamper(t *testing.T, data []byte, mutate func(map[string]any)) []byte {\\n\\tt.Helper()\\n\\tvar object map[string]any\\n\\tif err := json.Unmarshal(data, &object); err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tmutate(object)\\n\\tout, err := json.Marshal(object)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\treturn out\\n}\\n\\nfunc requireRefusal(t *testing.T, err error, fragment string) {\\n\\tt.Helper()\\n\\tif !errors.Is(err, ErrInvalid) {\\n\\t\\tt.Fatalf(\\\"error = %v, want ErrInvalid\\\", err)\\n\\t}\\n\\tif fragment != \\\"\\\" && !strings.Contains(err.Error(), fragment) {\\n\\t\\tt.Fatalf(\\\"error = %v, want fragment %q\\\", err, fragment)\\n\\t}\\n}\\n\\nfunc TestRawManifestRefusals(t *testing.T) {\\n\\tidentity := fixtureNativeIdentity()\\n\\tidentityDigest, err := IdentityDigest(identity, nil)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tbuild := func(inputs []EntryInput) error {\\n\\t\\t_, err := BuildRawObjectManifest(fixtureOperationID, []byte(fixtureTupleJSON()),\\n\\t\\t\\t\\\"native-session-alpha\\\", identityDigest.String(), fixtureDigest(\\\"test-capture-plan\\\"), inputs, nil)\\n\\t\\treturn err\\n\\t}\\n\\tt.Run(\\\"build\\\", func(t *testing.T) {\\n\\t\\tbase := validEntryInputs(t)\\n\\t\\tclone := func() []EntryInput {\\n\\t\\t\\tout := make([]EntryInput, len(base))\\n\\t\\t\\tcopy(out, base)\\n\\t\\t\\treturn out\\n\\t\\t}\\n\\t\\tcases := []struct {\\n\\t\\t\\tname     string\\n\\t\\t\\tmutate   func([]EntryInput) []EntryInput\\n\\t\\t\\tfragment string\\n\\t\\t}{\\n\\t\\t\\t{\\\"unknown class\\\", func(in []EntryInput) []EntryInput { in[0].Class = \\\"mystery\\\"; return in }, \\\"outside the raw subset\\\"},\\n\\t\\t\\t{\\\"credential forbidden\\\", func(in []EntryInput) []EntryInput { in[0].Class = \\\"credential\\\"; return in }, \\\"outside the raw subset\\\"},\\n\\t\\t\\t{\\\"machine_auth forbidden\\\", func(in []EntryInput) []EntryInput { in[0].Class = \\\"machine_auth\\\"; return in }, \\\"outside the raw subset\\\"},\\n\\t\\t\\t{\\\"runtime_state forbidden\\\", func(in []EntryInput) []EntryInput { in[0].Class = \\\"runtime_state\\\"; return in }, \\\"outside the raw subset\\\"},\\n===tamper===\\ninternal/clonebundle/refusal_test.go:30:func tamper(t *testing.T, data []byte, mutate func(map[string]any)) []byte {\\ninternal/clonebundle/refusal_test.go-31-\\tt.Helper()\\ninternal/clonebundle/refusal_test.go-32-\\tvar object map[string]any\\ninternal/clonebundle/refusal_test.go-33-\\tif err := json.Unmarshal(data, &object); err != nil {\\ninternal/clonebundle/refusal_test.go-34-\\t\\tt.Fatal(err)\\ninternal/clonebundle/refusal_test.go-35-\\t}\\ninternal/clonebundle/refusal_test.go-36-\\tmutate(object)\\ninternal/clonebundle/refusal_test.go-37-\\tout, err := json.Marshal(object)\\ninternal/clonebundle/refusal_test.go-38-\\tif err != nil {\\ninternal/clonebundle/refusal_test.go-39-\\t\\tt.Fatal(err)\\ninternal/clonebundle/refusal_test.go-40-\\t}\\ninternal/clonebundle/refusal_test.go-41-\\treturn out\\ninternal/clonebundle/refusal_test.go-42-}\\ninternal/clonebundle/refusal_test.go-43-\\ninternal/clonebundle/refusal_test.go-44-func requireRefusal(t *testing.T, err error, fragment string) {\\ninternal/clonebundle/refusal_test.go-45-\\tt.Helper()\\n\",\n  \"original_output_bytes\": 3591,\n  \"original_output_tokens\": 898,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
