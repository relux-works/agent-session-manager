{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ccf3","stream":{"kind":"session","id":"01a0b144-2d0b-7f30-96a3-e7fabafc632c"},"sequence":1236,"recorded_at":1780531400002467,"record_type":"event","durability":"durable","causation_id":"96a3132b-8530-4e47-8657-36d15f2da569","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"96a3132b-8530-4e47-8657-36d15f2da569","run_stream":{"kind":"run","id":"96a3132b-8530-4e47-8657-36d15f2da569"},"call_id":"call_01a0b14a6ad3755aab22ec07d9716e72","text":"Read text file `internal/clonebundle/testdata/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for internal/clonebundle.\n3|\n4|Every gate ships a narrowing mutant: the gate stays present and is\n5|weakened to admit exactly one member of the class it must reject, and\n6|the named killer test must fail. A delete-only mutant proves only that\n7|the gate exists and is not accepted as evidence.\n8|\n9|Each row runs M (mutate one production file in place), R (run the\n10|scoped Go killer through the production entry point), V (verdict from\n11|the Go exit code plus a FAIL kill-line: KILLED iff R fails with a test\n12|failure line, SURVIVED iff R passes, ERROR for anything else —\n13|unapplied patches, build breaks, timeouts). M failures and R\n14|infrastructure errors are ERROR, never kills or survivals. The file is\n15|restored from its backup after every row, pass or fail.\n16|\n17|Row C-doc-comment is the harmless control: a comment-only edit that\n18|must SURVIVE, proving the harness observes test outcomes instead of\n19|hard-coding kills.\n20|\n21|Usage:\n22|  PYTHONDONTWRITEBYTECODE=1 python3 internal/clonebundle/testdata/mutant_harness.py [--log-dir DIR] [MUTANT ...]\n23|\"\"\"\n24|\n25|import shutil\n26|import subprocess\n27|import sys\n28|import tempfile\n29|import time\n30|from dataclasses import dataclass\n31|from pathlib import Path\n32|\n33|REPO = Path(__file__).resolve().parents[3]\n34|PACKAGE = \"internal/clonebundle\"\n35|\n36|FORGED_DESCRIPTOR_HEX = \"edb3da2954b883ebc2099da18edeac4e12f8f5d67aa5bb2dd80ba472b23481f2\"\n37|OTHER_DESCRIPTOR_HEX = \"369c0225affac23e2a7a16052d03b24bfd9421ea3f83c8fe39111e864c344cfb\"\n38|PAIR_DIGEST = \"sha256:305e10453577c8371cdb872e120f1662649d150bbc2eff62b81827851f1d4926\"\n39|\n40|\n41|@dataclass(frozen=True)\n42|class Mutant:\n43|    name: str\n44|    path: str\n45|    find: str\n46|    replace: str\n47|    count: int\n48|    run: str\n49|    expect: str\n50|    note: str\n51|\n52|\n53|MUTANTS = [\n54|    Mutant(\n55|        name=\"N-raw-class\",\n56|        path=f\"{PACKAGE}/rawmanifest.go\",\n57|        find='\\t\"derived_cache_optional\",\\n\\t\"unknown\",\\n',\n58|        replace='\\t\"derived_cache_optional\",\\n\\t\"credential\",\\n\\t\"unknown\",\\n',\n59|        count=1,\n60|        run=\"TestRawManifestRefusals/build/credential_forbidden\",\n61|        expect=\"KILLED\",\n62|        note=\"Admits exactly credential into the raw subset; every other excluded class still refuses.\",\n63|    ),\n64|    Mutant(\n65|        name=\"N-raw-order\",\n66|        path=f\"{PACKAGE}/rawmanifest.go\",\n67|        find=\"\\tif index > 0 && input.NativeItemKey <= previous {\\n\",\n68|        replace=\"\\tif index > 0 && input.NativeItemKey < previous {\\n\",\n69|        count=1,\n70|        run=\"TestRawManifestRefusals/build/duplicate_entries\",\n71|        expect=\"KILLED\",\n72|        note=\"Admits exactly duplicate keys; unsorted keys still refuse.\",\n73|    ),\n74|    Mutant(\n75|        name=\"N-exclusion-config\",\n76|        path=f\"{PACKAGE}/rawmanifest.go\",\n77|        find=\"\\tif hosttrust.ExcludedConfigDirName(key) {\\n\",\n78|        replace='\\tif hosttrust.ExcludedConfigDirName(key) && key != \"settings.bak.3\" {\\n',\n79|        count=1,\n80|        run=\"TestRawManifestExcludesTrustMaterial\",\n81|        expect=\"KILLED\",\n82|        note=\"Admits exactly the settings.bak.3 config key; every other excluded key still refuses. Token preserved.\",\n83|    ),\n84|    Mutant(\n85|        name=\"N-sanitize-uuid\",\n86|        path=f\"{PACKAGE}/identity.go\",\n87|        find=\"\\tif _, err := scalar.ParseUUIDv7(key); err == nil {\\n\",\n88|        replace='\\tif _, err := scalar.ParseUUIDv7(key); err == nil && key != \"0198f4c8-8e50-7f66-8f70-1234567890c2\" {\\n',\n89|        count=1,\n90|        run=\"TestIdentityRefusals/sanitizer\",\n91|        expect=\"KILLED\",\n92|        note=\"Admits exactly one UUIDv7 native key; every other UUIDv7 still refuses. Token preserved.\",\n93|    ),\n94|    Mutant(\n95|        name=\"N-sanitizer-control\",\n96|        path=f\"{PACKAGE}/identity.go\",\n97|        find=\"\\t\\tif unicode.IsControl(unit) {\\n\",\n98|        replace=\"\\t\\tif unicode.IsControl(unit) && unit != 0x1f {\\n\",\n99|        count=1,\n100|        run=\"TestIdentityRefusals/sanitizer\",\n101|        expect=\"KILLED\",\n102|        note=\"Admits exactly U+001F; every other control still refuses.\",\n103|    ),\n104|    Mutant(\n105|        name=\"N-always-excluded\",\n106|        path=f\"{PACKAGE}/captureitem.go\",\n107|        find='\\tcase \"credential\", \"machine_auth\", \"runtime_state\", \"transient_lock\":\\n',\n108|        replace='\\tcase \"machine_auth\", \"runtime_state\", \"transient_lock\":\\n',\n109|        count=1,\n110|        run=\"TestCaptureItemRefusals/credential_included\",\n111|        expect=\"KILLED\",\n112|        note=\"Admits exactly included credential rows; the other three always-excluded classes still refuse.\",\n113|    ),\n114|    Mutant(\n115|        name=\"N-included-reason\",\n116|        path=f\"{PACKAGE}/captureitem.go\",\n117|        find=\"\\t\\tif hasReason {\\n\",\n118|        replace='\\t\\tif hasReason && class == \"unknown\" {\\n',\n119|        count=1,\n120|        run=\"TestCaptureItemRefusals/included_with_reason\",\n121|        expect=\"KILLED\",\n122|        note=\"Admits exactly non-unknown included rows with a reason; the killer uses durable_payload.\",\n123|    ),\n124|    Mutant(\n125|        name=\"N-unknown-complete\",\n126|        path=f\"{PACKAGE}/capturebuild.go\",\n127|        find=\"\\tif hasUnknownClass(items) {\\n\",\n128|        replace=\"\\tif hasUnknownClass(items) && len(items) > 4 {\\n\",\n129|        count=1,\n130|        run=\"TestBuildCaptureManifestUnknownMakesIncomplete\",\n131|        expect=\"KILLED\",\n132|        note=\"Admits exactly small unknown-class manifests as complete; the 4-item killer derives true.\",\n133|    ),\n134|    Mutant(\n135|        name=\"N-excluded-exact\",\n136|        path=f\"{PACKAGE}/capturebuild.go\",\n137|        find=\"\\tif len(derived) != len(excluded) {\\n\",\n138|        replace=\"\\tif len(derived) > len(excluded) {\\n\",\n139|        count=1,\n140|        run=\"TestExcludedClassesExactGate\",\n141|        expect=\"KILLED\",\n142|        note=\"Admits exactly superset excluded_classes; missing classes still refuse.\",\n143|    ),\n144|    Mutant(\n145|        name=\"N-proof-identity\",\n146|        path=f\"{PACKAGE}/boundary.go\",\n147|        find=\"\\t\\tif proof.SnapshotIdentity != nil {\\n\",\n148|        replace='\\t\\tif proof.SnapshotIdentity != nil && proof.ProofKind != \"closed_store\" {\\n',\n149|        count=1,\n150|        run=\"TestBoundaryRefusals/decode_stable_proof/closed_store_with_identity\",\n151|        expect=\"KILLED\",\n152|        note=\"Admits exactly closed_store with an identity; provider_quiescence still refuses one.\",\n153|    ),\n154|    Mutant(\n155|        name=\"N-core-only\",\n156|        path=f\"{PACKAGE}/boundary.go\",\n157|        find=\"\\t\\tif !input.Core {\\n\",\n158|        replace='\\t\\tif !input.Core && input.Generation != \"g\" {\\n',\n159|        count=1,\n160|        run=\"TestBoundaryRefusals/build_core-only_unstable\",\n161|        expect=\"KILLED\",\n162|        note=\"Admits exactly non-core unstable with generation g, the killer's generation.\",\n163|    ),\n164|    Mutant(\n165|        name=\"N-g2-generation\",\n166|        path=f\"{PACKAGE}/boundary.go\",\n167|        find='''\\tif boundary.Kind == \"unstable_archive\" {\n168|\\t\\treturn invalid(\"capture boundary unstable_archive cannot enter a target branch\")\n169|\\t}\n170|''',\n171|        replace='''\\tif boundary.Kind == \"unstable_archive\" && boundary.SourceGeneration.String() != \"generation-9\" {\n172|\\t\\treturn invalid(\"capture boundary unstable_archive cannot enter a target branch\")\n173|\\t}\n174|\\tif boundary.Kind == \"unstable_archive\" {\n175|\\t\\treturn nil\n176|\\t}\n177|''',\n178|        count=1,\n179|        run=\"TestBuildCaptureManifestUnstableArchive\",\n180|        expect=\"KILLED\",\n181|        note=\"Admits exactly generation-9 unstable archives to the target branch; every other unstable still refuses.\",\n182|    ),\n183|    Mutant(\n184|        name=\"N-main-count\",\n185|        path=f\"{PACKAGE}/session.go\",\n186|        find=\"\\tif mainCount != 1 {\\n\",\n187|        replace=\"\\tif mainCount < 1 {\\n\",\n188|        count=2,\n189|        run=\"TestCanonicalSessionRefusals/build_actors/two_mains\",\n190|        expect=\"KILLED\",\n191|        note=\"Admits exactly multi-main sessions at both build and decode sites; zero-main still refuses.\",\n192|    ),\n193|    Mutant(\n194|        name=\"N-synth-operation\",\n195|        path=f\"{PACKAGE}/event.go\",\n196|        find=\"\\t\\tif !hasOperation {\\n\",\n197|        replace=\"\\t\\tif !hasOperation && hasNativeEvent {\\n\",\n198|        count=1,\n199|        run=\"TestCanonicalEventRefusals/evidence/synthesized_missing_operation\",\n200|        expect=\"KILLED\",\n201|        note=\"Admits exactly synthesized evidence with neither native event nor operation, the killer's shape.\",\n202|    ),\n203|    Mutant(\n204|        name=\"N-blob-size\",\n205|        path=f\"{PACKAGE}/blobref.go\",\n206|        find=\"\\tif size != wantSize {\\n\",\n207|        replace=\"\\tif size != wantSize && size+1 != wantSize {\\n\",\n208|        count=1,\n209|        run=\"TestBlobAgreementRefusals\",\n210|        expect=\"KILLED\",\n211|        note=\"Admits exactly off-by-one size claims; every other disagreement still refuses.\",\n212|    ),\n213|    Mutant(\n214|        name=\"N-self-digest\",\n215|        path=f\"{PACKAGE}/decode.go\",\n216|        find=\"\\tif calculated != claimed {\\n\",\n217|        replace='\\tif calculated != claimed && claimed.Hex() != \"ccdd35168ab474fa5764a526cfb83621351e23682c5075b2e18d56bddf96aa30\" {\\n',\n218|        count=1,\n219|        run=\"TestRawManifestRefusals/decode/self_digest_mismatch\",\n220|        expect=\"KILLED\",\n221|        note=\"Admits exactly the forged self digest sha256('forged'); every other mismatch still refuses.\",\n222|    ),\n223|    Mutant(\n224|        name=\"N-descriptor-claim-agreement\",\n225|        path=f\"{PACKAGE}/blobref.go\",\n226|        find=\"\\tcalculated, claimed, members, err := calculateDescriptorIdentity(descriptor)\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tif calculated != claimed {\\n\",\n227|        replace='\\tcalculated, claimed, members, err := calculateDescriptorIdentity(descriptor)\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tif calculated != claimed && claimed.Hex() != \"' + FORGED_DESCRIPTOR_HEX + '\" {\\n',\n228|        count=1,\n229|        run=\"TestBlobAgreementRefusals\",\n230|        expect=\"KILLED\",\n231|        note=\"Admits exactly the forged descriptor claim at the agreement site only; the install site keeps its own row.\",\n232|    ),\n233|    Mutant(\n234|        name=\"N-install-site-claim\",\n235|        path=f\"{PACKAGE}/blobref.go\",\n236|        find=\"\\tcalculated, claimed, members, err := calculateDescriptorIdentity(descriptor)\\n\\tif err != nil {\\n\\t\\treturn BlobAgreement{}, err\\n\\t}\\n\\tif calculated != claimed {\\n\",\n237|        replace='\\tcalculated, claimed, members, err := calculateDescriptorIdentity(descriptor)\\n\\tif err != nil {\\n\\t\\treturn BlobAgreement{}, err\\n\\t}\\n\\tif calculated != claimed && claimed.Hex() != \"' + FORGED_DESCRIPTOR_HEX + '\" {\\n',\n238|        count=1,\n239|        run=\"TestInstallRawBlobRefusals\",\n240|        expect=\"KILLED\",\n241|        note=\"Admits exactly the forged descriptor claim at the install site only; the agreement site keeps its own row.\",\n242|    ),\n243|    Mutant(\n244|        name=\"N-descriptor-id-link\",\n245|        path=f\"{PACKAGE}/blobref.go\",\n246|        find=\"\\tif calculated != wantDescriptorID {\\n\",\n247|        replace='\\tif calculated != wantDescriptorID && wantDescriptorID.String() != \"sha256:' + OTHER_DESCRIPTOR_HEX + '\" {\\n',\n248|        count=1,\n249|        run=\"TestRawManifestRefusals/build/descriptor_id_mismatch\",\n250|        expect=\"KILLED\",\n251|        note=\"Admits exactly the killer's mismatched descriptor ID; every other mismatch still refuses.\",\n252|    ),\n253|    Mutant(\n254|        name=\"N-extension-number\",\n255|        path=f\"{PACKAGE}/decode.go\",\n256|        find=\"\\tinteger, err := strconv.ParseInt(literal, 10, 64)\\n\\tif err != nil || integer < -maxSafeInteger || integer > maxSafeInteger {\\n\",\n257|        replace=\"\\tinteger, err := strconv.ParseInt(literal, 10, 64)\\n\\tif err != nil || integer < -maxSafeInteger || (integer > maxSafeInteger && integer != 9007199254740992) {\\n\",\n258|        count=1,\n259|        run=\"TestRawManifestRefusals/extension_values/exactly_2\",\n260|        expect=\"KILLED\",\n261|        note=\"Admits exactly 2^53; every other unsafe literal still refuses.\",\n262|    ),\n263|    Mutant(\n264|        name=\"N-extension-nested-dup\",\n265|        path=f\"{PACKAGE}/decode.go\",\n266|        find=\"\\t\\tif seen[name] {\\n\\t\\t\\treturn errExtensionDuplicate\\n\",\n267|        replace='\\t\\tif seen[name] && name != \"a\" {\\n\\t\\t\\treturn errExtensionDuplicate\\n',\n268|        count=1,\n269|        run=\"TestRawManifestRefusals/extension_values/decode_nested_duplicate\",\n270|        expect=\"KILLED\",\n271|        note=\"Admits exactly a duplicate nested member named a; every other duplicate still refuses.\",\n272|    ),\n273|    Mutant(\n274|        name=\"N-extension-keys\",\n275|        path=f\"{PACKAGE}/decode.go\",\n276|        find=\"\\tif !checkExtensions(raw) {\\n\\t\\treturn errExtensionsKeys\\n\",\n277|        replace='\\tif !checkExtensions(raw) && !bytes.Contains(raw, []byte(\"\\\\\"no-dots\\\\\":\")) {\\n\\t\\treturn errExtensionsKeys\\n',\n278|        count=1,\n279|        run=\"TestRawManifestRefusals/decode/bad_extensions\",\n280|        expect=\"KILLED\",\n281|        note=\"Admits exactly extensions carrying a no-dots key; every other bad key still refuses.\",\n282|    ),\n283|    Mutant(\n284|        name=\"N-capture-items-dup-decode\",\n285|        path=f\"{PACKAGE}/capturebuild.go\",\n286|        find=\"\\t\\tif index > 0 && item.NativeItemKey <= previous {\\n\\t\\t\\treturn nil, invalid(\",\n287|        replace=\"\\t\\tif index > 0 && item.NativeItemKey < previous {\\n\\t\\t\\treturn nil, invalid(\",\n288|        count=1,\n289|        run=\"TestCaptureManifestRefusals/decode/items_duplicate_key\",\n290|        expect=\"KILLED\",\n291|        note=\"Admits exactly an equal-key duplicate item at decode; unsorted items still refuse.\",\n292|    ),\n293|    Mutant(\n294|        name=\"N-sorted-digests-dup\",\n295|        path=f\"{PACKAGE}/decode.go\",\n296|        find=\"func checkSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\\n\\treturn environ.CheckSortedUniqueDigests(raw, minimumCount, maximumCount)\\n}\\n\",\n297|        replace=\"func checkSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\\n\\tif string(bytesTrimSpace(raw)) == `[\\\"\" + PAIR_DIGEST + '\",\"' + PAIR_DIGEST + '\"]` {\\n\\t\\tfirst, _ := environ.CheckDigest(json.RawMessage(`\"' + PAIR_DIGEST + '\"`))\\n\\t\\treturn []scalar.Digest{first, first}, true\\n\\t}\\n\\treturn environ.CheckSortedUniqueDigests(raw, minimumCount, maximumCount)\\n}\\n',\n298|        count=1,\n299|        run=\"TestCanonicalEventRefusals/decode/parents_duplicate\",\n300|        expect=\"KILLED\",\n301|        note=\"Admits exactly the killer's duplicated digest pair through the delegating wrapper; every other duplicate still refuses.\",\n302|    ),\n303|    Mutant(\n304|        name=\"N-sorted-strings-dup\",\n305|        path=f\"{PACKAGE}/decode.go\",\n306|        find=\"func checkSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\\n\\treturn environ.CheckSortedUniqueStrings(raw, minimumLength, maximumLength, minimumCount, maximumCount)\\n}\\n\",\n307|        replace='func checkSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\\n\\tif string(bytesTrimSpace(raw)) == `[\"a\",\"a\"]` {\\n\\t\\treturn []string{\"a\", \"a\"}, true\\n\\t}\\n\\treturn environ.CheckSortedUniqueStrings(raw, minimumLength, maximumLength, minimumCount, maximumCount)\\n}\\n',\n308|        count=1,\n309|        run=\"TestCanonicalEventRefusals/decode/evidence_reason_codes_duplicate\",\n310|        expect=\"KILLED\",\n311|        note=\"Admits exactly the killer's duplicated string pair through the delegating wrapper; every other duplicate still refuses.\",\n312|    ),\n313|    Mutant(\n314|        name=\"N-rawrefs-dup-decode\",\n315|        path=f\"{PACKAGE}/event.go\",\n316|        find=\"\\t\\tif index > 0 && bytes.Compare(canonical, previous) <= 0 {\\n\",\n317|        replace=\"\\t\\tif index > 0 && bytes.Compare(canonical, previous) < 0 {\\n\",\n318|        count=1,\n319|        run=\"TestCanonicalEventRefusals/decode/evidence_raw_refs_duplicate\",\n320|        expect=\"KILLED\",\n321|        note=\"Admits exactly an equal raw_ref duplicate at decode; unsorted refs still refuse.\",\n322|    ),\n323|    Mutant(\n324|        name=\"N-decode-item-class\",\n325|        path=f\"{PACKAGE}/captureitem.go\",\n326|        find=\"\\tif !ok || !ValidCaptureClass(class) {\\n\",\n327|        replace='\\tif !ok || (!ValidCaptureClass(class) && class != \"mystery\") {\\n',\n328|        count=1,\n329|        run=\"TestCaptureManifestRefusals/decode/item_class_mystery\",\n330|        expect=\"KILLED\",\n331|        note=\"Admits exactly class mystery at decode; every other unknown class still refuses.\",\n332|    ),\n333|    Mutant(\n334|        name=\"N-decode-actor-main-parent\",\n335|        path=f\"{PACKAGE}/session.go\",\n336|        find='\\tif kind == \"main\" && parent != nil {\\n',\n337|        replace='\\tif kind == \"main\" && parent != nil && index != 0 {\\n',\n338|        count=1,\n339|        run=\"TestCanonicalSessionRefusals/decode/main_with_parent\",\n340|        expect=\"KILLED\",\n341|        note=\"Admits exactly actor[0] main-with-parent at decode; every other main-with-parent still refuses.\",\n342|    ),\n343|    Mutant(\n344|        name=\"N-decode-evidence-status\",\n345|        path=f\"{PACKAGE}/event.go\",\n346|        find='\\tstatus, ok := rawString(members[\"capture_status\"])\\n\\tif !ok || !validCaptureStatus(status) {\\n',\n347|        replace='\\tstatus, ok := rawString(members[\"capture_status\"])\\n\\tif !ok || (!validCaptureStatus(status) && status != \"maybe\") {\\n',\n348|        count=1,\n349|        run=\"TestCanonicalEventRefusals/decode/evidence_status_maybe\",\n350|        expect=\"KILLED\",\n351|        note=\"Admits exactly capture_status maybe at decode; every other unknown status still refuses.\",\n352|    ),\n353|    Mutant(\n354|        name=\"N-decode-event-visibility\",\n355|        path=f\"{PACKAGE}/event.go\",\n356|        find=\"\\tif !ok || !validVisibility(visibility) {\\n\",\n357|        replace='\\tif !ok || (!validVisibility(visibility) && visibility != \"secret\") {\\n',\n358|        count=1,\n359|        run=\"TestCanonicalEventRefusals/decode/visibility_secret\",\n360|        expect=\"KILLED\",\n361|        note=\"Admits exactly visibility secret at decode; every other unknown visibility still refuses.\",\n362|    ),\n363|    Mutant(\n364|        name=\"N-verify-descriptors-skip-0\",\n365|        path=f\"{PACKAGE}/rawmanifest.go\",\n366|        find=\"\\t\\tif err := VerifyDescriptorAgreement(descriptor, entry.BlobDescriptorID, entry.BlobID, entry.ByteCount); err != nil {\\n\",\n367|        replace=\"\\t\\tif err := VerifyDescriptorAgreement(descriptor, entry.BlobDescriptorID, entry.BlobID, entry.ByteCount); err != nil && index != 0 {\\n\",\n368|        count=1,\n369|        run=\"TestVerifyRawManifestDescriptorsRefusals\",\n370|        expect=\"KILLED\",\n371|        note=\"Admits exactly a disagreeing descriptor at entry 0; every other entry still verifies.\",\n372|    ),\n373|    Mutant(\n374|        name=\"N-reconcile-rawkeys-dup\",\n375|        path=f\"{PACKAGE}/capturebuild.go\",\n376|        find='\\t\\tif seenRaw[key] {\\n\\t\\t\\treturn invalid(\"capture manifest raw keys carry duplicate %q\", key)\\n',\n377|        replace='\\t\\tif seenRaw[key] && key != \"store/blob-a\" {\\n\\t\\t\\treturn invalid(\"capture manifest raw keys carry duplicate %q\", key)\\n',\n378|        count=1,\n379|        run=\"TestCaptureManifestRefusals/reconciliation\",\n380|        expect=\"KILLED\",\n381|        note=\"Admits exactly the killer's duplicated raw key; every other duplicate still refuses.\",\n382|    ),\n383|    Mutant(\n384|        name=\"N-identity-rededecode\",\n385|        path=f\"{PACKAGE}/rawmanifest.go\",\n386|        find=\"\\tif _, err := DecodeNativeIdentity(json.RawMessage(encoded)); err != nil {\\n\",\n387|        replace='\\tif _, err := DecodeNativeIdentity(json.RawMessage(encoded)); err != nil && identity.IdentityKind != \"bogus\" {\\n',\n388|        count=1,\n389|        run=\"TestIdentityDigestRefusals\",\n390|        expect=\"KILLED\",\n391|        note=\"Admits exactly an undecodable identity of kind bogus; every other undecodable identity still refuses.\",\n392|    ),\n393|    Mutant(\n394|        name=\"N-plan-item-match\",\n395|        path=f\"{PACKAGE}/capturebuild.go\",\n396|        find=\"func checkPlanItemMatch(items []CaptureItem, planKeys []string) error {\\n\\tif len(items) != len(planKeys) {\\n\",\n397|        replace='func checkPlanItemMatch(items []CaptureItem, planKeys []string) error {\\n\\tif len(planKeys) == 4 && len(items) == 3 && planKeys[3] == \"store/zz-missing-item\" {\\n\\t\\treturn nil\\n\\t}\\n\\tif len(items) != len(planKeys) {\\n',\n398|        count=1,\n399|        run=\"TestCaptureManifestRefusals/build_plan_match\",\n400|        expect=\"KILLED\",\n401|        note=\"Admits exactly the killer's extra plan candidate; every other items/plan mismatch still refuses.\",\n402|    ),\n403|    Mutant(\n404|        name=\"N-block-xor\",\n405|        path=f\"{PACKAGE}/event.go\",\n406|        find=\"\\t\\tif hasContent == hasDescriptor {\\n\",\n407|        replace=\"\\t\\tif hasContent == hasDescriptor && hasContent {\\n\",\n408|        count=1,\n409|        run=\"TestCanonicalEventRefusals/build_envelope/block_neither_content_nor_descriptor\",\n410|        expect=\"KILLED\",\n411|        note=\"Admits exactly a block with neither content nor descriptor; a block with both still refuses.\",\n412|    ),\n413|    Mutant(\n414|        name=\"N-maximal-incomplete\",\n415|        path=f\"{PACKAGE}/capturebuild.go\",\n416|        find=\"\\tif !manifest.RawComplete {\\n\",\n417|        replace=\"\\tif !manifest.RawComplete && hasUnknownClass(manifest.Items) {\\n\",\n418|        count=1,\n419|        run=\"TestCaptureManifestRefusals/reconciliation\",\n420|        expect=\"KILLED\",\n421|        note=\"Admits exactly incomplete known-class manifests to maximal_safe; unknown still blocks.\",\n422|    ),\n423|    Mutant(\n424|        name=\"C-doc-comment\",\n425|        path=f\"{PACKAGE}/doc.go\",\n426|        find=\"// Authority: relux-works/agent-session-manager-spec@v0.6.0, Sections\\n\",\n427|        replace=\"// Authority: relux-works/agent-session-manager-spec@v0.6.0, Sections (control).\\n\",\n428|        count=1,\n429|        run=\"TestCaptureClassVocabularyIsPinned\",\n430|        expect=\"SURVIVED\",\n431|        note=\"Harmless control: a comment-only edit must survive.\",\n432|    ),\n433|]\n434|\n435|\n436|def run_mutant(mutant: Mutant) -> tuple[str, str, int, float]:\n437|    target = REPO / mutant.path\n438|    original = target.read_text()\n439|    found = original.count(mutant.find)\n440|    if found != mutant.count:\n441|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\", \"\", -1, 0.0\n442|    with tempfile.TemporaryDirectory() as staging:\n443|        backup = Path(staging) / \"backup\"\n444|        shutil.copy2(target, backup)\n445|        try:\n446|            target.write_text(original.replace(mutant.find, mutant.replace))\n447|            started = time.time()\n448|            run = subprocess.run(\n449|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n450|                cwd=REPO,\n451|                capture_output=True,\n452|                text=True,\n453|                timeout=300,\n454|            )\n455|            elapsed = time.time() - started\n456|        finally:\n457|            shutil.copy2(backup, target)\n458|    output = (run.stdout + run.stderr).strip()\n459|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n460|        return f\"ERROR: {mutant.name}: build broke under the patch\", output, run.returncode, elapsed\n461|    if run.returncode == 0:\n462|        verdict = \"SURVIVED\"\n463|    elif '--- FAIL' in output or 'FAIL:' in output:\n464|        verdict = \"KILLED\"\n465|    else:\n466|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\", output, run.returncode, elapsed\n467|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n468|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note}\", output, run.returncode, elapsed\n469|\n470|\n471|def main(argv: list[str]) -> int:\n472|    log_dir: Path | None = None\n473|    selected_names: list[str] = []\n474|    args = list(argv)\n475|    while args:\n476|        if args[0] == \"--log-dir\":\n477|            if len(args) < 2:\n478|                print(\"missing directory for --log-dir\")\n479|                return 2\n480|            log_dir = Path(args[1])\n481|            args = args[2:]\n482|        else:\n483|            selected_names.append(args[0])\n484|            args = args[1:]\n485|    selected = [m for m in MUTANTS if not selected_names or m.name in selected_names]\n486|    if selected_names and len(selected) != len(selected_names):\n487|        unknown = sorted(set(selected_names) - {m.name for m in selected})\n488|        print(f\"unknown mutants: {', '.join(unknown)}\")\n489|        return 2\n490|    if log_dir is not None:\n491|        log_dir.mkdir(parents=True, exist_ok=True)\n492|    failures = 0\n493|    for mutant in selected:\n494|        try:\n495|            line, output, exit_code, elapsed = run_mutant(mutant)\n496|        except subprocess.TimeoutExpired:\n497|            line, output, exit_code, elapsed = f\"ERROR: {mutant.name}: killer timed out\", \"\", -1, 0.0\n498|        print(line, flush=True)\n499|        if log_dir is not None:\n500|            (log_dir / f\"{mutant.name}.log\").write_text(\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
