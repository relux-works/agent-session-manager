{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cbe1","stream":{"kind":"session","id":"01a0b144-2d0b-7f30-96a3-e7fabafc632c"},"sequence":1099,"recorded_at":1780531400002193,"record_type":"event","durability":"durable","causation_id":"96a3132b-8530-4e47-8657-36d15f2da569","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"96a3132b-8530-4e47-8657-36d15f2da569","run_stream":{"kind":"run","id":"96a3132b-8530-4e47-8657-36d15f2da569"},"task_stream":{"kind":"task","id":"01a0b149-edcc-76f0-8639-d62dbaebecd7"},"task_id":"01a0b149-edcc-76f0-8639-d62dbaebecd7","event":{"kind":"output","task_id":"01a0b149-edcc-76f0-8639-d62dbaebecd7","chunk":"Read text file `internal/clonebundle/capturebuild.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"sort\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n9|)\n10|\n11|// This file validates and constructs Clone Capture Manifest 1.0.0:\n12|// the closed envelope over source basis, capture boundary, sorted\n13|// Capture Items, exact excluded classes, and the core-derived\n14|// raw_complete flag.\n15|\n16|const (\n17|\tcaptureManifestSchema  = \"urn:ax:schema:clone-capture-manifest\"\n18|\tcaptureManifestVersion = \"1.0.0\"\n19|\tcaptureManifestSelf    = \"capture_manifest_id\"\n20|)\n21|\n22|var captureManifestMembers = map[string]bool{\n23|\t\"schema\": true, \"schema_version\": true, \"capture_manifest_id\": true,\n24|\t\"operation_id\": true, \"bundle_id\": true, \"source_basis\": true,\n25|\t\"source_environment\": true, \"source_identity\": true,\n26|\t\"capture_plan_digest\": true, \"capture_boundary\": true,\n27|\t\"source_raw_object_manifest_id\": true, \"items\": true,\n28|\t\"excluded_classes\": true, \"raw_complete\": true,\n29|\t\"created_by_host_id\": true, \"created_at\": true, \"extensions\": true,\n30|}\n31|\n32|var captureManifestRequired = []string{\n33|\t\"schema\", \"schema_version\", \"capture_manifest_id\",\n34|\t\"operation_id\", \"bundle_id\", \"source_basis\",\n35|\t\"source_environment\", \"source_identity\",\n36|\t\"capture_plan_digest\", \"capture_boundary\",\n37|\t\"source_raw_object_manifest_id\", \"items\",\n38|\t\"excluded_classes\", \"raw_complete\",\n39|\t\"created_by_host_id\", \"created_at\", \"extensions\",\n40|}\n41|\n42|// CaptureManifest is one validated Clone Capture Manifest.\n43|type CaptureManifest struct {\n44|\tManifestID              scalar.Digest\n45|\tOperationID             scalar.UUIDv7\n46|\tBundleID                scalar.UUIDv7\n47|\tSourceBasis             SourceBasis\n48|\tSourceEnvironment       sessadapter.Tuple\n49|\tSourceIdentity          NativeIdentity\n50|\tCapturePlanDigest       scalar.Digest\n51|\tCaptureBoundary         CaptureBoundary\n52|\tSourceRawObjectManifest scalar.Digest\n53|\tItems                   []CaptureItem\n54|\tExcludedClasses         []string\n55|\tRawComplete             bool\n56|\tCreatedByHostID         scalar.UUIDv7\n57|\tCreatedAt               scalar.Timestamp\n58|}\n59|\n60|// CaptureManifestInput is the caller-supplied capture manifest\n61|// candidate for Build. PlanKeys are the exact capture-plan\n62|// candidate keys and RawKeys are the exact raw-manifest entry keys;\n63|// raw_complete is core-derived from them and is not an input — a\n64|// caller cannot assert completeness, only the reconciliation can.\n65|type CaptureManifestInput struct {\n66|\tOperationID         string\n67|\tBundleID            string\n68|\tSourceBasis         SourceBasisInput\n69|\tSourceEnvironment   []byte\n70|\tSourceIdentity      NativeIdentity\n71|\tIdentityExtensions  map[string]any\n72|\tCapturePlanDigest   string\n73|\tBoundary            BoundaryInput\n74|\tSourceRawManifestID string\n75|\tItems               []CaptureItemInput\n76|\tPlanKeys            []string\n77|\tRawKeys             []string\n78|\tCreatedByHostID     string\n79|\tCreatedAt           string\n80|\tExtensions          map[string]any\n81|}\n82|\n83|// BuildCaptureManifest constructs one closed Clone Capture Manifest\n84|// as canonical bytes. Identical inputs produce byte-identical\n85|// outputs. raw_complete is derived, never accepted: it is true only\n86|// after complete plan/object reconciliation with no unknown class.\n87|func BuildCaptureManifest(input CaptureManifestInput) ([]byte, error) {\n88|\t_, object, err := buildCaptureManifest(input)\n89|\tif err != nil {\n90|\t\treturn nil, err\n91|\t}\n92|\tomitted, err := canonicalizeObject(object)\n93|\tif err != nil {\n94|\t\treturn nil, err\n95|\t}\n96|\tmanifestID := scalar.SHA256Digest(omitted)\n97|\tobject[captureManifestSelf] = manifestID.String()\n98|\treturn canonicalizeObject(object)\n99|}\n100|\n101|func buildCaptureManifest(input CaptureManifestInput) (CaptureManifest, map[string]any, error) {\n102|\toperation, err := scalar.ParseUUIDv7(input.OperationID)\n103|\tif err != nil {\n104|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest operation_id is not a UUIDv7: %v\", err)\n105|\t}\n106|\tbundle, err := scalar.ParseUUIDv7(input.BundleID)\n107|\tif err != nil {\n108|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest bundle_id is not a UUIDv7: %v\", err)\n109|\t}\n110|\tbasis, basisObject, err := buildSourceBasis(input.SourceBasis)\n111|\tif err != nil {\n112|\t\treturn CaptureManifest{}, nil, err\n113|\t}\n114|\ttuple, err := sessadapter.DecodeTuple(json.RawMessage(input.SourceEnvironment))\n115|\tif err != nil {\n116|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest source_environment is not an Environment Tuple: %v\", err)\n117|\t}\n118|\tidentityBytes, err := EncodeNativeIdentity(input.SourceIdentity, input.IdentityExtensions)\n119|\tif err != nil {\n120|\t\treturn CaptureManifest{}, nil, err\n121|\t}\n122|\tif _, err := DecodeNativeIdentity(json.RawMessage(identityBytes)); err != nil {\n123|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest source_identity is not a NativeIdentity: %v\", err)\n124|\t}\n125|\tplanDigest, err := scalar.ParseDigest(input.CapturePlanDigest)\n126|\tif err != nil {\n127|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest capture_plan_digest is not a digest: %v\", err)\n128|\t}\n129|\tboundary, boundaryObject, err := buildBoundary(input.Boundary)\n130|\tif err != nil {\n131|\t\treturn CaptureManifest{}, nil, err\n132|\t}\n133|\trawManifestID, err := scalar.ParseDigest(input.SourceRawManifestID)\n134|\tif err != nil {\n135|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest source_raw_object_manifest_id is not a digest: %v\", err)\n136|\t}\n137|\tif len(input.Items) > 65536 {\n138|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest carries %d items, maximum is 65536\", len(input.Items))\n139|\t}\n140|\titems := make([]CaptureItem, 0, len(input.Items))\n141|\tprevious := \"\"\n142|\tfor index, candidate := range input.Items {\n143|\t\titem, err := buildCaptureItem(candidate, index)\n144|\t\tif err != nil {\n145|\t\t\treturn CaptureManifest{}, nil, err\n146|\t\t}\n147|\t\tif index > 0 && item.NativeItemKey <= previous {\n148|\t\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest items are not sorted bytewise by native item key\")\n149|\t\t}\n150|\t\tprevious = item.NativeItemKey\n151|\t\titems = append(items, item)\n152|\t}\n153|\tif err := checkPlanItemMatch(items, input.PlanKeys); err != nil {\n154|\t\treturn CaptureManifest{}, nil, err\n155|\t}\n156|\texcluded := excludedRowClasses(items)\n157|\trawComplete := deriveRawComplete(items, input.PlanKeys, input.RawKeys)\n158|\thostID, err := scalar.ParseUUIDv7(input.CreatedByHostID)\n159|\tif err != nil {\n160|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest created_by_host_id is not a UUIDv7: %v\", err)\n161|\t}\n162|\tcreatedAt, err := scalar.ParseTimestamp(input.CreatedAt)\n163|\tif err != nil {\n164|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest created_at is not a timestamp: %v\", err)\n165|\t}\n166|\tif _, err := encodeExtensions(input.Extensions); err != nil {\n167|\t\treturn CaptureManifest{}, nil, err\n168|\t}\n169|\tvar identityValue any\n170|\tif err := json.Unmarshal(identityBytes, &identityValue); err != nil {\n171|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest source_identity is not JSON: %v\", err)\n172|\t}\n173|\tobjects := make([]any, 0, len(items))\n174|\tfor _, item := range items {\n175|\t\tobjects = append(objects, captureItemObject(item))\n176|\t}\n177|\texcludedValue := make([]any, 0, len(excluded))\n178|\tfor _, class := range excluded {\n179|\t\texcludedValue = append(excludedValue, class)\n180|\t}\n181|\tmanifest := CaptureManifest{\n182|\t\tOperationID:             operation,\n183|\t\tBundleID:                bundle,\n184|\t\tSourceBasis:             basis,\n185|\t\tSourceEnvironment:       tuple,\n186|\t\tSourceIdentity:          input.SourceIdentity,\n187|\t\tCapturePlanDigest:       planDigest,\n188|\t\tCaptureBoundary:         boundary,\n189|\t\tSourceRawObjectManifest: rawManifestID,\n190|\t\tItems:                   items,\n191|\t\tExcludedClasses:         excluded,\n192|\t\tRawComplete:             rawComplete,\n193|\t\tCreatedByHostID:         hostID,\n194|\t\tCreatedAt:               createdAt,\n195|\t}\n196|\tobject := map[string]any{\n197|\t\t\"schema\":                        captureManifestSchema,\n198|\t\t\"schema_version\":                captureManifestVersion,\n199|\t\t\"operation_id\":                  operation.String(),\n200|\t\t\"bundle_id\":                     bundle.String(),\n201|\t\t\"source_basis\":                  basisObject,\n202|\t\t\"source_environment\":            tupleObject(tuple),\n203|\t\t\"source_identity\":               identityValue,\n204|\t\t\"capture_plan_digest\":           planDigest.String(),\n205|\t\t\"capture_boundary\":              boundaryObject,\n206|\t\t\"source_raw_object_manifest_id\": rawManifestID.String(),\n207|\t\t\"items\":                         objects,\n208|\t\t\"excluded_classes\":              excludedValue,\n209|\t\t\"raw_complete\":                  rawComplete,\n210|\t\t\"created_by_host_id\":            hostID.String(),\n211|\t\t\"created_at\":                    createdAt.String(),\n212|\t\t\"extensions\":                    extensionValue(input.Extensions),\n213|\t}\n214|\treturn manifest, object, nil\n215|}\n216|\n217|// DecodeCaptureManifest validates one closed Clone Capture Manifest:\n218|// exact members, schema/version, self-digest agreement, sorted\n219|// items, exact excluded classes, and the unknown-makes-incomplete\n220|// rule. Full plan/object reconciliation needs the plan and raw key\n221|// sets; VerifyCaptureReconciliation performs it.\n222|func DecodeCaptureManifest(data []byte) (CaptureManifest, error) {\n223|\tmembers, fault := decodeStrictObject(data)\n224|\tif fault != nil {\n225|\t\treturn CaptureManifest{}, invalid(\"capture manifest %s (%s)\", fault.detail, memberField(fault.member))\n226|\t}\n227|\tif name, unknown := unknownMember(members, captureManifestMembers); unknown {\n228|\t\treturn CaptureManifest{}, invalid(\"capture manifest carries unknown member %q\", name)\n229|\t}\n230|\tif name, missing := missingMember(members, captureManifestRequired); missing {\n231|\t\treturn CaptureManifest{}, invalid(\"capture manifest misses a required member %q\", name)\n232|\t}\n233|\tschema, ok := rawString(members[\"schema\"])\n234|\tif !ok || schema != captureManifestSchema {\n235|\t\treturn CaptureManifest{}, invalid(\"capture manifest schema is not the clone capture manifest\")\n236|\t}\n237|\tversion, ok := rawString(members[\"schema_version\"])\n238|\tif !ok || version != captureManifestVersion {\n239|\t\treturn CaptureManifest{}, invalid(\"capture manifest version is not 1.0.0\")\n240|\t}\n241|\tmanifestID, ok := checkDigest(members[captureManifestSelf])\n242|\tif !ok {\n243|\t\treturn CaptureManifest{}, invalid(\"capture manifest capture_manifest_id is not a digest\")\n244|\t}\n245|\toperation, ok := checkUUIDv7(members[\"operation_id\"])\n246|\tif !ok {\n247|\t\treturn CaptureManifest{}, invalid(\"capture manifest operation_id is not a UUIDv7\")\n248|\t}\n249|\tbundle, ok := checkUUIDv7(members[\"bundle_id\"])\n250|\tif !ok {\n251|\t\treturn CaptureManifest{}, invalid(\"capture manifest bundle_id is not a UUIDv7\")\n252|\t}\n253|\tbasis, err := DecodeSourceBasis(members[\"source_basis\"])\n254|\tif err != nil {\n255|\t\treturn CaptureManifest{}, err\n256|\t}\n257|\ttuple, err := sessadapter.DecodeTuple(members[\"source_environment\"])\n258|\tif err != nil {\n259|\t\treturn CaptureManifest{}, invalid(\"capture manifest source_environment is not an Environment Tuple: %v\", err)\n260|\t}\n261|\tidentity, err := DecodeNativeIdentity(members[\"source_identity\"])\n262|\tif err != nil {\n263|\t\treturn CaptureManifest{}, err\n264|\t}\n265|\tplanDigest, ok := checkDigest(members[\"capture_plan_digest\"])\n266|\tif !ok {\n267|\t\treturn CaptureManifest{}, invalid(\"capture manifest capture_plan_digest is not a digest\")\n268|\t}\n269|\tboundary, err := DecodeCaptureBoundary(members[\"capture_boundary\"])\n270|\tif err != nil {\n271|\t\treturn CaptureManifest{}, err\n272|\t}\n273|\trawManifestID, ok := checkDigest(members[\"source_raw_object_manifest_id\"])\n274|\tif !ok {\n275|\t\treturn CaptureManifest{}, invalid(\"capture manifest source_raw_object_manifest_id is not a digest\")\n276|\t}\n277|\titems, err := decodeCaptureItems(members[\"items\"])\n278|\tif err != nil {\n279|\t\treturn CaptureManifest{}, err\n280|\t}\n281|\texcluded, ok := checkSortedUniqueStrings(members[\"excluded_classes\"], 1, 128, 0, 9)\n282|\tif !ok {\n283|\t\treturn CaptureManifest{}, invalid(\"capture manifest excluded_classes are not sorted unique string[1..128][0..9]\")\n284|\t}\n285|\tfor _, class := range excluded {\n286|\t\tif !ValidCaptureClass(class) {\n287|\t\t\treturn CaptureManifest{}, invalid(\"capture manifest excluded_classes carry unknown class %q\", class)\n288|\t\t}\n289|\t}\n290|\tif !excludedClassesExact(items, excluded) {\n291|\t\treturn CaptureManifest{}, invalid(\"capture manifest excluded_classes are not exactly the excluded-row classes\")\n292|\t}\n293|\trawComplete, ok := rawBool(members[\"raw_complete\"])\n294|\tif !ok {\n295|\t\treturn CaptureManifest{}, invalid(\"capture manifest raw_complete is not a boolean\")\n296|\t}\n297|\tif rawComplete && hasUnknownClass(items) {\n298|\t\treturn CaptureManifest{}, invalid(\"capture manifest raw_complete is true with an unknown-class item\")\n299|\t}\n300|\thostID, ok := checkUUIDv7(members[\"created_by_host_id\"])\n301|\tif !ok {\n302|\t\treturn CaptureManifest{}, invalid(\"capture manifest created_by_host_id is not a UUIDv7\")\n303|\t}\n304|\tcreatedAt, ok := checkTimestamp(members[\"created_at\"])\n305|\tif !ok {\n306|\t\treturn CaptureManifest{}, invalid(\"capture manifest created_at is not a timestamp\")\n307|\t}\n308|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n309|\t\treturn CaptureManifest{}, invalid(\"capture manifest extensions %s\", extensionsFault)\n310|\t}\n311|\tif err := verifySelfDigest(members, captureManifestSelf, manifestID); err != nil {\n312|\t\treturn CaptureManifest{}, err\n313|\t}\n314|\treturn CaptureManifest{\n315|\t\tManifestID:              manifestID,\n316|\t\tOperationID:             operation,\n317|\t\tBundleID:                bundle,\n318|\t\tSourceBasis:             basis,\n319|\t\tSourceEnvironment:       tuple,\n320|\t\tSourceIdentity:          identity,\n321|\t\tCapturePlanDigest:       planDigest,\n322|\t\tCaptureBoundary:         boundary,\n323|\t\tSourceRawObjectManifest: rawManifestID,\n324|\t\tItems:                   items,\n325|\t\tExcludedClasses:         excluded,\n326|\t\tRawComplete:             rawComplete,\n327|\t\tCreatedByHostID:         hostID,\n328|\t\tCreatedAt:               createdAt,\n329|\t}, nil\n330|}\n331|\n332|func decodeCaptureItems(raw json.RawMessage) ([]CaptureItem, error) {\n333|\telements, ok := decodeArray(raw)\n334|\tif !ok {\n335|\t\treturn nil, invalid(\"capture manifest items are not an array\")\n336|\t}\n337|\tif len(elements) > 65536 {\n338|\t\treturn nil, invalid(\"capture manifest carries %d items, maximum is 65536\", len(elements))\n339|\t}\n340|\titems := make([]CaptureItem, 0, len(elements))\n341|\tprevious := \"\"\n342|\tfor index, element := range elements {\n343|\t\titem, err := decodeCaptureItem(element, index)\n344|\t\tif err != nil {\n345|\t\t\treturn nil, err\n346|\t\t}\n347|\t\tif index > 0 && item.NativeItemKey <= previous {\n348|\t\t\treturn nil, invalid(\"capture manifest items are not sorted bytewise by native item key\")\n349|\t\t}\n350|\t\tprevious = item.NativeItemKey\n351|\t\titems = append(items, item)\n352|\t}\n353|\treturn items, nil\n354|}\n355|\n356|// checkPlanItemMatch enforces the one-per-plan-candidate rule at\n357|// construction: the sealed items must be exactly one per capture-plan\n358|// candidate, no missing and no extra. An incomplete raw closure still\n359|// seals (with raw_complete false), but an items/plan mismatch is a\n360|// malformed manifest, never an archive object.\n361|func checkPlanItemMatch(items []CaptureItem, planKeys []string) error {\n362|\tif len(items) != len(planKeys) {\n363|\t\treturn invalid(\"capture manifest carries %d items for %d plan candidates, want one per plan candidate\", len(items), len(planKeys))\n364|\t}\n365|\titemSet := map[string]bool{}\n366|\tfor _, item := range items {\n367|\t\titemSet[item.NativeItemKey] = true\n368|\t}\n369|\tfor _, key := range planKeys {\n370|\t\tif !itemSet[key] {\n371|\t\t\treturn invalid(\"capture manifest plan candidate %q has no item\", key)\n372|\t\t}\n373|\t}\n374|\treturn nil\n375|}\n376|\n377|// excludedRowClasses derives the exact excluded-row class set:\n378|// sorted unique classes of excluded rows.\n379|func excludedRowClasses(items []CaptureItem) []string {\n380|\tseen := map[string]bool{}\n381|\tfor _, item := range items {\n382|\t\tif !item.Included() {\n383|\t\t\tseen[item.Class] = true\n384|\t\t}\n385|\t}\n386|\tclasses := make([]string, 0, len(seen))\n387|\tfor class := range seen {\n388|\t\tclasses = append(classes, class)\n389|\t}\n390|\tsort.Strings(classes)\n391|\treturn classes\n392|}\n393|\n394|func excludedClassesExact(items []CaptureItem, excluded []string) bool {\n395|\tderived := excludedRowClasses(items)\n396|\tif len(derived) != len(excluded) {\n397|\t\treturn false\n398|\t}\n399|\tfor index := range derived {\n400|\t\tif derived[index] != excluded[index] {\n401|\t\t\treturn false\n402|\t\t}\n403|\t}\n404|\treturn true\n405|}\n406|\n407|func hasUnknownClass(items []CaptureItem) bool {\n408|\tfor _, item := range items {\n409|\t\tif item.Class == \"unknown\" {\n410|\t\t\treturn true\n411|\t\t}\n412|\t}\n413|\treturn false\n414|}\n415|\n416|// deriveRawComplete is the core raw_complete derivation: true only\n417|// when no item has unknown class, every plan candidate reconciles\n418|// to exactly one item, and the included items are exactly the raw\n419|// manifest keys (all and only included objects).\n420|func deriveRawComplete(items []CaptureItem, planKeys, rawKeys []string) bool {\n421|\tif hasUnknownClass(items) {\n422|\t\treturn false\n423|\t}\n424|\tif len(items) != len(planKeys) {\n425|\t\treturn false\n426|\t}\n427|\tplanSet := map[string]bool{}\n428|\tfor _, key := range planKeys {\n429|\t\tplanSet[key] = true\n430|\t}\n431|\tif len(planSet) != len(planKeys) {\n432|\t\treturn false\n433|\t}\n434|\tincluded := map[string]bool{}\n435|\tfor _, item := range items {\n436|\t\tif !planSet[item.NativeItemKey] {\n437|\t\t\treturn false\n438|\t\t}\n439|\t\tif item.Included() {\n440|\t\t\tincluded[item.NativeItemKey] = true\n441|\t\t}\n442|\t}\n443|\tif len(included) != len(rawKeys) {\n444|\t\treturn false\n445|\t}\n446|\tseenRaw := map[string]bool{}\n447|\tfor _, key := range rawKeys {\n448|\t\tif !included[key] {\n449|\t\t\treturn false\n450|\t\t}\n451|\t\tif seenRaw[key] {\n452|\t\t\treturn false\n453|\t\t}\n454|\t\tseenRaw[key] = true\n455|\t}\n456|\treturn true\n457|}\n458|\n459|// VerifyCaptureReconciliation re-checks complete plan/object\n460|// reconciliation for a decoded manifest: one item per plan\n461|// candidate, the raw closure over exactly the included items, and a\n462|// raw_complete flag that matches the derivation. Unknown classes\n463|// always reconcile to false. Duplicate raw keys are refused\n464|// outright: a duplicate would defeat the \"all\" half of the all-and-only\n465|// closure, hiding a missing included object behind a repeated key.\n466|func VerifyCaptureReconciliation(manifest CaptureManifest, planKeys, rawKeys []string) error {\n467|\tseenRaw := map[string]bool{}\n468|\tfor _, key := range rawKeys {\n469|\t\tif seenRaw[key] {\n470|\t\t\treturn invalid(\"capture manifest raw keys carry duplicate %q\", key)\n471|\t\t}\n472|\t\tseenRaw[key] = true\n473|\t}\n474|\tderived := deriveRawComplete(manifest.Items, planKeys, rawKeys)\n475|\tif manifest.RawComplete != derived {\n476|\t\treturn invalid(\"capture manifest raw_complete is %v, reconciliation derives %v\", manifest.RawComplete, derived)\n477|\t}\n478|\tif !derived {\n479|\t\treturn invalid(\"capture manifest plan/object reconciliation is incomplete\")\n480|\t}\n481|\treturn nil\n482|}\n483|\n484|// RefuseMaximalSafeUnlessComplete blocks the maximal_safe fidelity\n485|// profile: unknown classes block it, and it requires a reconciled\n486|// complete manifest. Projection planning calls this gate.\n487|func RefuseMaximalSafeUnlessComplete(manifest CaptureManifest) error {\n488|\tif hasUnknownClass(manifest.Items) {\n489|\t\treturn invalid(\"maximal_safe is blocked by an unknown-class item\")\n490|\t}\n491|\tif !manifest.RawComplete {\n492|\t\treturn invalid(\"maximal_safe requires raw_complete\")\n493|\t}\n494|\treturn nil\n495|}","final_result":true}}}
