uarantines through the store owner; this package\n73|// adds no second write path.\n74|func InstallRawBlob(store *localstore.ObjectStore, descriptor []byte, source io.Reader) (BlobAgreement, error) {\n75|\tcalculated, claimed, members, err := calculateDescriptorIdentity(descriptor)\n76|\tif err != nil {\n77|\t\treturn BlobAgreement{}, err\n78|\t}\n79|\tif calculated != claimed {\n80|\t\treturn BlobAgreement{}, invalid(\"blob descriptor claim %q does not match omit-self digest %q\", claimed.String(), calculated.String())\n81|\t}\n82|\tblobID, ok := checkDigest(members[\"blob_id\"])\n83|\tif !ok {\n84|\t\treturn BlobAgreement{}, invalid(\"blob descriptor blob_id is not a digest\")\n85|\t}\n86|\tsize, ok := checkUint53Bounds(members[\"size\"], 0, maxUint53)\n87|\tif !ok {\n88|\t\treturn BlobAgreement{}, invalid(\"blob descriptor size is not a uint53\")\n89|\t}\n90|\tif store == nil {\n91|\t\treturn BlobAgreement{}, invalid(\"blob install requires an object store\")\n92|\t}\n93|\tif _, err := store.PutBlob(blobID, size, source); err != nil {\n94|\t\treturn BlobAgreement{}, invalid(\"blob install refused: %v\", err)\n95|\t}\n96|\treturn BlobAgreement{DescriptorID: calculated, BlobID: blobID, Size: size}, nil\n97|}\n98|\n99|// calculateDescriptorIdentity runs the owner's shape validation and\n100|// omit-self computation over one descriptor and reads its claimed\n101|// self digest. Callers compare the two; this helper never attests.\n102|func calculateDescriptorIdentity(descriptor []byte) (scalar.Digest, scalar.Digest, map[string]json.RawMessage, error) {\n103|\tcalculated, field, err := canonicaljson.CalculateObjectIdentity(descriptor)\n104|\tif err != nil {\n105|\t\treturn scalar.Digest{}, scalar.Digest{}, nil, invalid(\"blob descriptor identity fails: %v\", err)\n106|\t}\n107|\tif field != \"descriptor_id\" {\n108|\t\treturn scalar.Digest{}, scalar.Digest{}, nil, invalid(\"blob descriptor self field is %q, want descriptor_id\", string(field))\n109|\t}\n110|\tvar members map[string]json.RawMessage\n111|\tif err := json.Unmarshal(descriptor, &members); err != nil {\n112|\t\treturn scalar.Digest{}, scalar.Digest{}, nil, invalid(\"blob descriptor is not an object: %v\", err)\n113|\t}\n114|\tclaimed, ok := checkDigest(members[\"descriptor_id\"])\n115|\tif !ok {\n116|\t\treturn scalar.Digest{}, scalar.Digest{}, nil, invalid(\"blob descriptor descriptor_id is not a digest\")\n117|\t}\n118|\treturn calculated, claimed, members, nil\n119|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d0a9","stream":{"kind":"session","id":"01a0b144-2d0b-7f30-96a3-e7fabafc632c"},"sequence":1711,"recorded_at":1780531400003417,"record_type":"event","durability":"durable","causation_id":"96a3132b-8530-4e47-8657-36d15f2da569","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"96a3132b-8530-4e47-8657-36d15f2da569","run_stream":{"kind":"run","id":"96a3132b-8530-4e47-8657-36d15f2da569"},"call_id":"call_01a0b1530a2275339834354f0442ff70","text":"Read text file `internal/clonebundle/generation.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n7|)\n8|\n9|// This file owns the Section 13.14.1 immutable generations: the\n10|// source_generation strings carried by StableSnapshotProof and the\n11|// unstable-archive Capture Boundary, and the snapshot-identity digest\n12|// that pins an immutable snapshot. Generations are opaque immutable\n13|// tokens: a generation never mutates, and equality is exact string\n14|// equality. Capture digests that must agree (stable pre/post) are\n15|// compared by digest equality here so both boundary validators share\n16|// one comparison.\n17|\n18|// Generation is one validated immutable source generation token:\n19|// string[1..512], opaque to the core.\n20|type Generation struct {\n21|\tvalue string\n22|}\n23|\n24|// ParseGeneration validates one generation token. Empty and\n25|// over-long tokens are refused; every other byte content crosses\n26|// opaquely, because generations are native-store tokens the core\n27|// compares but never interprets.\n28|func ParseGeneration(value string) (Generation, error) {\n29|\tif stringLength(value) < 1 || stringLength(value) > 512 {\n30|\t\treturn Generation{}, invalid(\"source generation is not a string[1..512]\")\n31|\t}\n32|\treturn Generation{value: value}, nil\n33|}\n34|\n35|// MustParseGeneration validates one generation token and panics on\n36|// refusal. Tests and fixed fixtures use it; production paths use\n37|// ParseGeneration and return the refusal.\n38|func MustParseGeneration(value string) Generation {\n39|\tgeneration, err := ParseGeneration(value)\n40|\tif err != nil {\n41|\t\tpanic(err)\n42|\t}\n43|\treturn generation\n44|}\n45|\n46|func (generation Generation) String() string { return generation.value }\n47|\n48|// Equal reports exact generation equality. Generations are\n49|// immutable: two captures name the same source state if and only if\n50|// their tokens are byte-identical.\n51|func (generation Generation) Equal(other Generation) bool {\n52|\treturn generation.value == other.value\n53|}\n54|\n55|func checkGeneration(raw json.RawMessage) (Generation, bool) {\n56|\tvalue, ok := checkStringBounds(raw, 1, 512)\n57|\tif !ok {\n58|\t\treturn Generation{}, false\n59|\t}\n60|\tgeneration, err := ParseGeneration(value)\n61|\tif err != nil {\n62|\t\treturn Generation{}, false\n63|\t}\n64|\treturn generation, true\n65|}\n66|\n67|// CheckDigestsEqual refuses two capture digests that differ. Stable\n68|// capture requires equal pre/post digests; file-size equality is\n69|// never proof and is not consulted here.\n70|func CheckDigestsEqual(pre, post scalar.Digest) error {\n71|\tif pre != post {\n72|\t\treturn invalid(\"capture digests differ: pre %q, post %q\", pre.String(), post.String())\n73|\t}\n74|\treturn nil\n75|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
