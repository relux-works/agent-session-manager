{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d74f","stream":{"kind":"session","id":"01a0b144-2d0b-7f30-96a3-e7fabafc632c"},"sequence":2562,"recorded_at":1780531400005119,"record_type":"event","durability":"durable","causation_id":"96a3132b-8530-4e47-8657-36d15f2da569","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"96a3132b-8530-4e47-8657-36d15f2da569","run_stream":{"kind":"run","id":"96a3132b-8530-4e47-8657-36d15f2da569"},"task_stream":{"kind":"task","id":"01a0b15a-1f2d-7d82-b889-0d0cf81bd9ea"},"task_id":"01a0b15a-1f2d-7d82-b889-0d0cf81bd9ea","event":{"kind":"output","task_id":"01a0b15a-1f2d-7d82-b889-0d0cf81bd9ea","chunk":"Read text file `internal/clonebundle/refusal_session_event_test.go`.\n(390 line(s) above)\n391|func TestIdentityRefusals(t *testing.T) {\n392|\tt.Run(\"native identity\", func(t *testing.T) {\n393|\t\tencode := func(mutate func(map[string]any)) []byte {\n394|\t\t\tidentity := fixtureNativeIdentity()\n395|\t\t\tgeneration, err := EncodeNativeIdentity(identity, nil)\n396|\t\t\tif err != nil {\n397|\t\t\t\tt.Fatal(err)\n398|\t\t\t}\n399|\t\t\treturn tamper(t, generation, mutate)\n400|\t\t}\n401|\t\tcases := []struct {\n402|\t\t\tname     string\n403|\t\t\tbody     []byte\n404|\t\t\tfragment string\n405|\t\t}{\n406|\t\t\t{\"bad kind\", encode(func(o map[string]any) { o[\"identity_kind\"] = \"imported\" }), \"provider_native|official_import|continuation_context\"},\n407|\t\t\t{\"absolute id\", encode(func(o map[string]any) { o[\"native_session_id\"] = \"/abs/x\" }), \"absolute source path\"},\n408|\t\t\t{\"uuid id\", encode(func(o map[string]any) { o[\"native_session_id\"] = fixtureSessionID }), \"fabricated AX\"},\n409|\t\t\t{\"control id\", encode(func(o map[string]any) { o[\"native_session_id\"] = \"a\\x7fb\" }), \"control characters\"},\n410|\t\t\t{\"credential id\", encode(func(o map[string]any) { o[\"native_session_id\"] = \"https://u:p@h/x\" }), \"embedded credenti