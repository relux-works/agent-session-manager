{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca9b","stream":{"kind":"session","id":"01a0b144-2d0b-7f30-96a3-e7fabafc632c"},"sequence":936,"recorded_at":1780531400001867,"record_type":"event","durability":"durable","causation_id":"96a3132b-8530-4e47-8657-36d15f2da569","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"96a3132b-8530-4e47-8657-36d15f2da569","run_stream":{"kind":"run","id":"96a3132b-8530-4e47-8657-36d15f2da569"},"task_stream":{"kind":"task","id":"01a0b148-24ab-7cc3-8826-56f91fa3e3de"},"task_id":"01a0b148-24ab-7cc3-8826-56f91fa3e3de","event":{"kind":"output","task_id":"01a0b148-24ab-7cc3-8826-56f91fa3e3de","chunk":"Read text file `internal/clonebundle/event.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n10|)\n11|\n12|// This file validates and constructs Canonical Event 1.0.0 with its\n13|// Source Evidence and raw byte-range references. The envelope,\n14|// vocabularies, evidence coupling, and message-like content-block\n15|// rules are enforced here; the full per-kind payload fact registry\n16|// is sibling (normalization) scope and is stated in doc.go.\n17|\n18|const (\n19|\tcanonicalEventSchema  = \"urn:ax:schema:canonical-event\"\n20|\tcanonicalEventVersion = \"1.0.0\"\n21|\tcanonicalEventSelf    = \"event_id\"\n22|\tmaxInlineContent      = 65536\n23|)\n24|\n25|// eventKinds is the exact 26-kind event vocabulary Section 13.14.1\n26|// states.\n27|var eventKinds = []string{\n28|\t\"session_started\",\n29|\t\"instruction_snapshot\",\n30|\t\"user_message\",\n31|\t\"assistant_message\",\n32|\t\"reasoning_summary\",\n33|\t\"opaque_reasoning\",\n34|\t\"tool_definition_snapshot\",\n35|\t\"tool_call\",\n36|\t\"tool_result\",\n37|\t\"approval_request\",\n38|\t\"approval_response\",\n39|\t\"plan_update\",\n40|\t\"progress\",\n41|\t\"usage\",\n42|\t\"rate_limit\",\n43|\t\"file_change\",\n44|\t\"compaction\",\n45|\t\"turn_started\",\n46|\t\"turn_completed\",\n47|\t\"turn_aborted\",\n48|\t\"subagent_started\",\n49|\t\"subagent_completed\",\n50|\t\"error\",\n51|\t\"migration_checkpoint\",\n52|\t\"session_finished\",\n53|\t\"opaque_event\",\n54|}\n55|\n56|// ValidEventKind reports whether the name is a canonical event kind.\n57|func ValidEventKind(kind string) bool {\n58|\tfor _, allowed := range eventKinds {\n59|\t\tif kind == allowed {\n60|\t\t\treturn true\n61|\t\t}\n62|\t}\n63|\treturn false\n64|}\n65|\n66|func validVisibility(visibility string) bool {\n67|\tswitch visibility {\n68|\tcase \"public\", \"projection\", \"internal\", \"opaque\":\n69|\t\treturn true\n70|\tdefault:\n71|\t\treturn false\n72|\t}\n73|}\n74|\n75|func validCaptureStatus(status string) bool {\n76|\tswitch status {\n77|\tcase \"exact\", \"partial\", \"synthesized\", \"unavailable\":\n78|\t\treturn true\n79|\tdefault:\n80|\t\treturn false\n81|\t}\n82|}\n83|\n84|// contentBlockTypes is the exact message-like content-block\n85|// vocabulary: text|json|image|audio|document|resource_link|redacted|opaque.\n86|var contentBlockTypes = []string{\n87|\t\"text\",\n88|\t\"json\",\n89|\t\"image\",\n90|\t\"audio\",\n91|\t\"document\",\n92|\t\"resource_link\",\n93|\t\"redacted\",\n94|\t\"opaque\",\n95|}\n96|\n97|func validContentBlockType(blockType string) bool {\n98|\tfor _, allowed := range contentBlockTypes {\n99|\t\tif blockType == allowed {\n100|\t\t\treturn true\n101|\t\t}\n102|\t}\n103|\treturn false\n104|}\n105|\n106|// messageLikeKind reports whether the kind carries a message-like\n107|// payload: user and assistant messages always do. Other kinds may\n108|// carry content blocks under the same block rules, but only these\n109|// two require them.\n110|func messageLikeKind(kind string) bool {\n111|\treturn kind == \"user_message\" || kind == \"assistant_message\"\n112|}\n113|\n114|var rawReferenceMembers = map[string]bool{\n115|\t\"manifest_id\": true, \"blob_descriptor_id\": true, \"offset\": true, \"length\": true,\n116|}\n117|\n118|var rawReferenceRequired = []string{\n119|\t\"manifest_id\", \"blob_descriptor_id\", \"offset\", \"length\",\n120|}\n121|\n122|// RawReference is one validated raw byte-range reference.\n123|type RawReference struct {\n124|\tManifestID       scalar.Digest\n125|\tBlobDescriptorID scalar.Digest\n126|\tOffset           uint64\n127|\tLength           uint64\n128|}\n129|\n130|func decodeRawReference(raw json.RawMessage, index int) (RawReference, error) {\n131|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n132|\tif fault != nil {\n133|\t\treturn RawReference{}, invalid(\"raw reference[%d] %s (%s)\", index, fault.detail, memberField(fault.member))\n134|\t}\n135|\tif name, unknown := unknownMember(members, rawReferenceMembers); unknown {\n136|\t\treturn RawReference{}, invalid(\"raw reference[%d] carries unknown member %q\", index, name)\n137|\t}\n138|\tif name, missing := missingMember(members, rawReferenceRequired); missing {\n139|\t\treturn RawReference{}, invalid(\"raw reference[%d] misses a required member %q\", index, name)\n140|\t}\n141|\tmanifestID, ok := checkDigest(members[\"manifest_id\"])\n142|\tif !ok {\n143|\t\treturn RawReference{}, invalid(\"raw reference[%d] manifest_id is not a digest\", index)\n144|\t}\n145|\tdescriptorID, ok := checkDigest(members[\"blob_descriptor_id\"])\n146|\tif !ok {\n147|\t\treturn RawReference{}, invalid(\"raw reference[%d] blob_descriptor_id is not a digest\", index)\n148|\t}\n149|\toffset, ok := checkUint53Bounds(members[\"offset\"], 0, maxUint53)\n150|\tif !ok {\n151|\t\treturn RawReference{}, invalid(\"raw reference[%d] offset is not a uint53\", index)\n152|\t}\n153|\tlength, ok := checkUint53Bounds(members[\"length\"], 0, maxUint53)\n154|\tif !ok {\n155|\t\treturn RawReference{}, invalid(\"raw reference[%d] length is not a uint53\", index)\n156|\t}\n157|\treturn RawReference{\n158|\t\tManifestID:       manifestID,\n159|\t\tBlobDescriptorID: descriptorID,\n160|\t\tOffset:           offset,\n161|\t\tLength:           length,\n162|\t}, nil\n163|}\n164|\n165|func rawReferenceObject(reference RawReference) map[string]any {\n166|\treturn map[string]any{\n167|\t\t\"manifest_id\":        reference.ManifestID.String(),\n168|\t\t\"blob_descriptor_id\": reference.BlobDescriptorID.String(),\n169|\t\t\"offset\":             reference.Offset,\n170|\t\t\"length\":             reference.Length,\n171|\t}\n172|}\n173|\n174|// decodeSortedUniqueRawReferences validates sorted unique raw\n175|// references: bytewise order of each item's JCS encoding, strict\n176|// increase proving sortedness and uniqueness together.\n177|func decodeSortedUniqueRawReferences(raw json.RawMessage) ([]RawReference, error) {\n178|\telements, ok := decodeArray(raw)\n179|\tif !ok {\n180|\t\treturn nil, invalid(\"source evidence raw_refs are not an array\")\n181|\t}\n182|\tif len(elements) > 65536 {\n183|\t\treturn nil, invalid(\"source evidence carries %d raw_refs, maximum is 65536\", len(elements))\n184|\t}\n185|\treferences := make([]RawReference, 0, len(elements))\n186|\tvar previous []byte\n187|\tfor index, element := range elements {\n188|\t\treference, err := decodeRawReference(element, index)\n189|\t\tif err != nil {\n190|\t\t\treturn nil, err\n191|\t\t}\n192|\t\tcanonical, err := canonicaljson.Canonicalize(bytesTrimSpace(element))\n193|\t\tif err != nil {\n194|\t\t\treturn nil, invalid(\"source evidence raw_refs[%d] are not canonical JSON: %v\", index, err)\n195|\t\t}\n196|\t\tif index > 0 && bytes.Compare(canonical, previous) <= 0 {\n197|\t\t\treturn nil, invalid(\"source evidence raw_refs are not sorted unique\")\n198|\t\t}\n199|\t\tprevious = canonical\n200|\t\treferences = append(references, reference)\n201|\t}\n202|\treturn references, nil\n203|}\n204|\n205|var sourceEvidenceMembers = map[string]bool{\n206|\t\"environment\": true, \"native_session_id\": true, \"native_event_id\": true,\n207|\t\"native_type\": true, \"raw_refs\": true, \"capture_status\": true,\n208|\t\"reason_codes\": true, \"core_operation_id\": true, \"extensions\": true,\n209|}\n210|\n211|var sourceEvidenceRequired = []string{\n212|\t\"environment\", \"native_session_id\", \"native_event_id\",\n213|\t\"native_type\", \"raw_refs\", \"capture_status\",\n214|\t\"reason_codes\", \"core_operation_id\", \"extensions\",\n215|}\n216|\n217|// SourceEvidence is one validated source evidence record.\n218|type SourceEvidence struct {\n219|\tEnvironment     sessadapter.Tuple\n220|\tNativeSessionID string\n221|\tNativeEventID   *string\n222|\tNativeType      *string\n223|\tRawRefs         []RawReference\n224|\tCaptureStatus   string\n225|\tReasonCodes     []string\n226|\tCoreOperationID *scalar.UUIDv7\n227|}\n228|\n229|// DecodeSourceEvidence validates one closed SourceEvidence:\n230|// sanitized native IDs, sorted unique raw references, and the\n231|// synthesized coupling (null native Event ID with a non-null core\n232|// operation; every other status with a null core operation).\n233|func DecodeSourceEvidence(raw json.RawMessage) (SourceEvidence, error) {\n234|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n235|\tif fault != nil {\n236|\t\treturn SourceEvidence{}, invalid(\"source evidence %s (%s)\", fault.detail, memberField(fault.member))\n237|\t}\n238|\tif name, unknown := unknownMember(members, sourceEvidenceMembers); unknown {\n239|\t\treturn SourceEvidence{}, invalid(\"source evidence carries unknown member %q\", name)\n240|\t}\n241|\tif name, missing := missingMember(members, sourceEvidenceRequired); missing {\n242|\t\treturn SourceEvidence{}, invalid(\"source evidence misses a required member %q\", name)\n243|\t}\n244|\ttuple, err := sessadapter.DecodeTuple(members[\"environment\"])\n245|\tif err != nil {\n246|\t\treturn SourceEvidence{}, invalid(\"source evidence environment is not an Environment Tuple: %v\", err)\n247|\t}\n248|\tnativeSession, ok := checkStringBounds(members[\"native_session_id\"], 1, 512)\n249|\tif !ok {\n250|\t\treturn SourceEvidence{}, invalid(\"source evidence native_session_id is not a string[1..512]\")\n251|\t}\n252|\tif err := SanitizeNativeKey(nativeSession); err != nil {\n253|\t\treturn SourceEvidence{}, err\n254|\t}\n255|\tvar nativeEvent *string\n256|\tif !isNull(members[\"native_event_id\"]) {\n257|\t\tvalue, ok := checkStringBounds(members[\"native_event_id\"], 1, 512)\n258|\t\tif !ok {\n259|\t\t\treturn SourceEvidence{}, invalid(\"source evidence native_event_id is not a string[1..512]\")\n260|\t\t}\n261|\t\tif err := SanitizeNativeKey(value); err != nil {\n262|\t\t\treturn SourceEvidence{}, err\n263|\t\t}\n264|\t\tnativeEvent = &value\n265|\t}\n266|\tvar nativeType *string\n267|\tif !isNull(members[\"native_type\"]) {\n268|\t\tvalue, ok := checkStringBounds(members[\"native_type\"], 1, 512)\n269|\t\tif !ok {\n270|\t\t\treturn SourceEvidence{}, invalid(\"source evidence native_type is not a string[1..512]\")\n271|\t\t}\n272|\t\tnativeType = &value\n273|\t}\n274|\treferences, err := decodeSortedUniqueRawReferences(members[\"raw_refs\"])\n275|\tif err != nil {\n276|\t\treturn SourceEvidence{}, err\n277|\t}\n278|\tstatus, ok := rawString(members[\"capture_status\"])\n279|\tif !ok || !validCaptureStatus(status) {\n280|\t\treturn SourceEvidence{}, invalid(\"source evidence capture_status is outside exact|partial|synthesized|unavailable\")\n281|\t}\n282|\treasons, ok := checkSortedUniqueStrings(members[\"reason_codes\"], 1, 128, 0, 128)\n283|\tif !ok {\n284|\t\treturn SourceEvidence{}, invalid(\"source evidence reason_codes are not sorted unique string[1..128][0..128]\")\n285|\t}\n286|\tvar operation *scalar.UUIDv7\n287|\tif !isNull(members[\"core_operation_id\"]) {\n288|\t\tvalue, ok := checkUUIDv7(members[\"core_operation_id\"])\n289|\t\tif !ok {\n290|\t\t\treturn SourceEvidence{}, invalid(\"source evidence core_operation_id is not a UUIDv7\")\n291|\t\t}\n292|\t\toperation = &value\n293|\t}\n294|\tif err := checkEvidenceCoupling(status, nativeEvent != nil, operation != nil); err != nil {\n295|\t\treturn SourceEvidence{}, err\n296|\t}\n297|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n298|\t\treturn SourceEvidence{}, invalid(\"source evidence extensions %s\", extensionsFault)\n299|\t}\n300|\treturn SourceEvidence{\n301|\t\tEnvironment:     tuple,\n302|\t\tNativeSessionID: nativeSession,\n303|\t\tNativeEventID:   nativeEvent,\n304|\t\tNativeType:      nativeType,\n305|\t\tRawRefs:         references,\n306|\t\tCaptureStatus:   status,\n307|\t\tReasonCodes:     reasons,\n308|\t\tCoreOperationID: operation,\n309|\t}, nil\n310|}\n311|\n312|// checkEvidenceCoupling enforces the synthesized rule: synthesized\n313|// requires a null native Event ID and a non-null core operation\n314|// identifying the core operation; all other statuses require a\n315|// null core operation.\n316|func checkEvidenceCoupling(status string, hasNativeEvent, hasOperation bool) error {\n317|\tif status == \"synthesized\" {\n318|\t\tif hasNativeEvent {\n319|\t\t\treturn invalid(\"source evidence synthesized carries a native event ID\")\n320|\t\t}\n321|\t\tif !hasOperation {\n322|\t\t\treturn invalid(\"source evidence synthesized requires a core operation\")\n323|\t\t}\n324|\t\treturn nil\n325|\t}\n326|\tif hasOperation {\n327|\t\treturn invalid(\"source evidence %s carries a core operation\", status)\n328|\t}\n329|\treturn nil\n330|}\n331|\n332|var canonicalEventMembers = map[string]bool{\n333|\t\"schema\": true, \"schema_version\": true, \"event_id\": true,\n334|\t\"logical_session_id\": true, \"ordinal\": true, \"parents\": true,\n335|\t\"actor_id\": true, \"turn_id\": true, \"kind\": true, \"timestamp\": true,\n336|\t\"visibility\": true, \"payload\": true, \"source_evidence\": true, \"extensions\": true,\n337|}\n338|\n339|var canonicalEventRequired = []string{\n340|\t\"schema\", \"schema_version\", \"event_id\",\n341|\t\"logical_session_id\", \"ordinal\", \"parents\",\n342|\t\"actor_id\", \"turn_id\", \"kind\", \"timestamp\",\n343|\t\"visibility\", \"payload\", \"source_evidence\", \"extensions\",\n344|}\n345|\n346|// CanonicalEvent is one validated Canonical Event. Payload carries\n347|// the validated closed payload object.\n348|type CanonicalEvent struct {\n349|\tEventID          scalar.Digest\n350|\tLogicalSessionID scalar.UUIDv7\n351|\tOrdinal          uint64\n352|\tParents          []scalar.Digest\n353|\tActorID          scalar.UUIDv7\n354|\tTurnID           *scalar.UUIDv7\n355|\tKind             string\n356|\tTimestamp        *scalar.Timestamp\n357|\tVisibility       string\n358|\tPayload          map[string]any\n359|\tEvidence         SourceEvidence\n360|}\n361|\n362|// RawRefInput is one caller-supplied raw reference candidate.\n363|type RawRefInput struct {\n364|\tManifestID       string\n365|\tBlobDescriptorID string\n366|\tOffset           uint64\n367|\tLength           uint64\n368|}\n369|\n370|// EvidenceInput is one caller-supplied source evidence candidate\n371|// for Build.\n372|type EvidenceInput struct {\n373|\tEnvironment     []byte\n374|\tNativeSessionID string\n375|\tNativeEventID   *string\n376|\tNativeType      *string\n377|\tRawRefs         []RawRefInput\n378|\tCaptureStatus   string\n379|\tReasonCodes     []string\n380|\tCoreOperationID *string\n381|}\n382|\n383|// CanonicalEventInput is the caller-supplied canonical event\n384|// candidate for Build. Payload carries the exact closed payload\n385|// object bytes; Build validates them under the kind-selected rules.\n386|type CanonicalEventInput struct {\n387|\tLogicalSessionID string\n388|\tOrdinal          uint64\n389|\tParents          []string\n390|\tActorID          string\n391|\tTurnID           *string\n392|\tKind             string\n393|\tTimestamp        *string\n394|\tVisibility       string\n395|\tPayload          []byte\n396|\tEvidence         EvidenceInput\n397|\tExtensions       map[string]any\n398|}\n399|\n400|// BuildCanonicalEvent constructs one closed Canonical Event 1.0.0\n401|// as canonical bytes. Identical inputs produce byte-identical\n402|// outputs.\n403|func BuildCanonicalEvent(input CanonicalEventInput) ([]byte, error) {\n404|\tobject, err := buildCanonicalEvent(input)\n405|\tif err != nil {\n406|\t\treturn nil, err\n407|\t}\n408|\tomitted, err := canonicalizeObject(object)\n409|\tif err != nil {\n410|\t\treturn nil, err\n411|\t}\n412|\teventID := scalar.SHA256Digest(omitted)\n413|\tobject[canonicalEventSelf] = eventID.String()\n414|\treturn canonicalizeObject(object)\n415|}\n416|\n417|func buildCanonicalEvent(input CanonicalEventInput) (map[string]any, error) {\n418|\tlogical, err := scalar.ParseUUIDv7(input.LogicalSessionID)\n419|\tif err != nil {\n420|\t\treturn nil, invalid(\"canonical event logical_session_id is not a UUIDv7: %v\", err)\n421|\t}\n422|\tif input.Ordinal > maxUint53 {\n423|\t\treturn nil, invalid(\"canonical event ordinal exceeds uint53\")\n424|\t}\n425|\tparents, err := parseSortedUniqueDigestStrings(input.Parents, 0, 64, \"parents\")\n426|\tif err != nil {\n427|\t\treturn nil, invalid(\"canonical event %v\", err)\n428|\t}\n429|\tactorID, err := scalar.ParseUUIDv7(input.ActorID)\n430|\tif err != nil {\n431|\t\treturn nil, invalid(\"canonical event actor_id is not a UUIDv7: %v\", err)\n432|\t}\n433|\tvar turn any\n434|\tif input.TurnID != nil {\n435|\t\tvalue, err := scalar.ParseUUIDv7(*input.TurnID)\n436|\t\tif err != nil {\n437|\t\t\treturn nil, invalid(\"canonical event turn_id is not a UUIDv7: %v\", err)\n438|\t\t}\n439|\t\tturn = value.String()\n440|\t}\n441|\tif !ValidEventKind(input.Kind) {\n442|\t\treturn nil, invalid(\"canonical event kind is outside the 26-kind vocabulary\")\n443|\t}\n444|\tvar stamp any\n445|\tif input.Timestamp != nil {\n446|\t\tvalue, err := scalar.ParseTimestamp(*input.Timestamp)\n447|\t\tif err != nil {\n448|\t\t\treturn nil, invalid(\"canonical event timestamp is not a timestamp: %v\", err)\n449|\t\t}\n450|\t\tstamp = value.String()\n451|\t}\n452|\tif !validVisibility(input.Visibility) {\n453|\t\treturn nil, invalid(\"canonical event visibility is outside public|projection|internal|opaque\")\n454|\t}\n455|\tpayload, err := checkPayload(input.Kind, json.RawMessage(input.Payload))\n456|\tif err != nil {\n457|\t\treturn nil, err\n458|\t}\n459|\tevidence, err := buildSourceEvidence(input.Evidence)\n460|\tif err != nil {\n461|\t\treturn nil, err\n462|\t}\n463|\tif _, err := encodeExtensions(input.Extensions); err != nil {\n464|\t\treturn nil, err\n465|\t}\n466|\treturn map[string]any{\n467|\t\t\"schema\":             canonicalEventSchema,\n468|\t\t\"schema_version\":     canonicalEventVersion,\n469|\t\t\"logical_session_id\": logical.String(),\n470|\t\t\"ordinal\":            input.Ordinal,\n471|\t\t\"parents\":            digestStrings(parents),\n472|\t\t\"actor_id\":           actorID.String(),\n473|\t\t\"turn_id\":            turn,\n474|\t\t\"kind\":               input.Kind,\n475|\t\t\"timestamp\":          stamp,\n476|\t\t\"visibility\":         input.Visibility,\n477|\t\t\"payload\":            payload,\n478|\t\t\"source_evidence\":    evidence,\n479|\t\t\"extensions\":         extensionValue(input.Extensions),\n480|\t}, nil\n481|}\n482|\n483|// DecodeCanonicalEvent validates one closed Canonical Event 1.0.0:\n484|// exact members, schema/version, self-digest agreement, the kind\n485|// and visibility vocabularies, the kind-selected payload rules,\n486|// and the source evidence coupling.\n487|func DecodeCanonicalEvent(data []byte) (CanonicalEvent, error) {\n488|\tmembers, fault := decodeStrictObject(data)\n489|\tif fault != nil {\n490|\t\treturn CanonicalEvent{}, invalid(\"canonical event %s (%s)\", fault.detail, memberField(fault.member))\n491|\t}\n492|\tif name, unknown := unknownMember(members, canonicalEventMembers); unknown {\n493|\t\treturn CanonicalEvent{}, invalid(\"canonical event carries unknown member %q\", name)\n494|\t}\n495|\tif name, missing := missingMember(members, canonicalEventRequired); missing {\n496|\t\treturn CanonicalEvent{}, invalid(\"canonical event misses a required member %q\", name)\n497|\t}\n498|\tschema, ok := rawString(members[\"schema\"])\n499|\tif !ok || schema != canonicalEventSchema {\n500|\t\treturn CanonicalEvent{}, invalid(\"canonical event schema is not the canonical event\")\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca9d","stream":{"kind":"session","id":"01a0b144-2d0b-7f30-96a3-e7fabafc632c"},"sequence":937,"recorded_at":1780531400001869,"record_type":"event","durability":"durable","causation_id":"96a3132b-8530-4e47-8657-36d15f2da569","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"96a3132b-8530-4e47-8657-36d15f2da569","run_stream":{"kind":"run","id":"96a3132b-8530-4e47-8657-36d15f2da569"},"task_stream":{"kind":"task","id":"01a0b148-24ab-7cc3-8826-56f91fa3e3de"},"task_id":"01a0b148-24ab-7cc3-8826-56f91fa3e3de","event":{"kind":"completed","task_id":"01a0b148-24ab-7cc3-8826-56f91fa3e3de"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca9f","stream":{"kind":"session","id":"01a0b144-2d0b-7f30-96a3-e7fabafc632c"},"sequence":938,"recorded_at":1780531400001871,"record_type":"event","durability":"durable","causation_id":"96a3132b-8530-4e47-8657-36d15f2da569","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"96a3132b-8530-4e47-8657-36d15f2da569","run_stream":{"kind":"run","id":"96a3132b-8530-4e47-8657-36d15f2da569"},"call_id":"call_01a0b14820fb749d82e9b283906574b9","text":"Read text file `internal/clonebundle/event.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n10|)\n11|\n12|// This file validates and constructs Canonical Event 1.0.0 with its\n13|// Source Evidence and raw byte-range references. The envelope,\n14|// vocabularies, evidence coupling, and message-like content-block\n15|// rules are enforced here; the full per-kind payload fact registry\n16|// is sibling (normalization) scope and is stated in doc.go.\n17|\n18|const (\n19|\tcanonicalEventSchema  = \"urn:ax:schema:canonical-event\"\n20|\tcanonicalEventVersion = \"1.0.0\"\n21|\tcanonicalEventSelf    = \"event_id\"\n22|\tmaxInlineContent      = 65536\n23|)\n24|\n25|// eventKinds is the exact 26-kind event vocabulary Section 13.14.1\n26|// states.\n27|var eventKinds = []string{\n28|\t\"session_started\",\n29|\t\"instruction_snapshot\",\n30|\t\"user_message\",\n31|\t\"assistant_message\",\n32|\t\"reasoning_summary\",\n33|\t\"opaque_reasoning\",\n34|\t\"tool_definition_snapshot\",\n35|\t\"tool_call\",\n36|\t\"tool_result\",\n37|\t\"approval_request\",\n38|\t\"approval_response\",\n39|\t\"plan_update\",\n40|\t\"progress\",\n41|\t\"usage\",\n42|\t\"rate_limit\",\n43|\t\"file_change\",\n44|\t\"compaction\",\n45|\t\"turn_started\",\n46|\t\"turn_completed\",\n47|\t\"turn_aborted\",\n48|\t\"subagent_started\",\n49|\t\"subagent_completed\",\n50|\t\"error\",\n51|\t\"migration_checkpoint\",\n52|\t\"session_finished\",\n53|\t\"opaque_event\",\n54|}\n55|\n56|// ValidEventKind reports whether the name is a canonical event kind.\n57|func ValidEventKind(kind string) bool {\n58|\tfor _, allowed := range eventKinds {\n59|\t\tif kind == allowed {\n60|\t\t\treturn true\n61|\t\t}\n62|\t}\n63|\treturn false\n64|}\n65|\n66|func validVisibility(visibility string) bool {\n67|\tswitch visibility {\n68|\tcase \"public\", \"projection\", \"internal\", \"opaque\":\n69|\t\treturn true\n70|\tdefault:\n71|\t\treturn false\n72|\t}\n73|}\n74|\n75|func validCaptureStatus(status string) bool {\n76|\tswitch status {\n77|\tcase \"exact\", \"partial\", \"synthesized\", \"unavailable\":\n78|\t\treturn true\n79|\tdefault:\n80|\t\treturn false\n81|\t}\n82|}\n83|\n84|// contentBlockTypes is the exact message-like content-block\n85|// vocabulary: text|json|image|audio|document|resource_link|redacted|opaque.\n86|var contentBlockTypes = []string{\n87|\t\"text\",\n88|\t\"json\",\n89|\t\"image\",\n90|\t\"audio\",\n91|\t\"document\",\n92|\t\"resource_link\",\n93|\t\"redacted\",\n94|\t\"opaque\",\n95|}\n96|\n97|func validContentBlockType(blockType string) bool {\n98|\tfor _, allowed := range contentBlockTypes {\n99|\t\tif blockType == allowed {\n100|\t\t\treturn true\n101|\t\t}\n102|\t}\n103|\treturn false\n104|}\n105|\n106|// messageLikeKind reports whether the kind carries a message-like\n107|// payload: user and assistant messages always do. Other kinds may\n108|// carry content blocks under the same block rules, but only these\n109|// two require them.\n110|func messageLikeKind(kind string) bool {\n111|\treturn kind == \"user_message\" || kind == \"assistant_message\"\n112|}\n113|\n114|var rawReferenceMembers = map[string]bool{\n115|\t\"manifest_id\": true, \"blob_descriptor_id\": true, \"offset\": true, \"length\": true,\n116|}\n117|\n118|var rawReferenceRequired = []string{\n119|\t\"manifest_id\", \"blob_descriptor_id\", \"offset\", \"length\",\n120|}\n121|\n122|// RawReference is one validated raw byte-range reference.\n123|type RawReference struct {\n124|\tManifestID       scalar.Digest\n125|\tBlobDescriptorID scalar.Digest\n126|\tOffset           uint64\n127|\tLength           uint64\n128|}\n129|\n130|func decodeRawReference(raw json.RawMessage, index int) (RawReference, error) {\n131|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n132|\tif fault != nil {\n133|\t\treturn RawReference{}, invalid(\"raw reference[%d] %s (%s)\", index, fault.detail, memberField(fault.member))\n134|\t}\n135|\tif name, unknown := unknownMember(members, rawReferenceMembers); unknown {\n136|\t\treturn RawReference{}, invalid(\"raw reference[%d] carries unknown member %q\", index, name)\n137|\t}\n138|\tif name, missing := missingMember(members, rawReferenceRequired); missing {\n139|\t\treturn RawReference{}, invalid(\"raw reference[%d] misses a required member %q\", index, name)\n140|\t}\n141|\tmanifestID, ok := checkDigest(members[\"manifest_id\"])\n142|\tif !ok {\n143|\t\treturn RawReference{}, invalid(\"raw reference[%d] manifest_id is not a digest\", index)\n144|\t}\n145|\tdescriptorID, ok := checkDigest(members[\"blob_descriptor_id\"])\n146|\tif !ok {\n147|\t\treturn RawReference{}, invalid(\"raw reference[%d] blob_descriptor_id is not a digest\", index)\n148|\t}\n149|\toffset, ok := checkUint53Bounds(members[\"offset\"], 0, maxUint53)\n150|\tif !ok {\n151|\t\treturn RawReference{}, invalid(\"raw reference[%d] offset is not a uint53\", index)\n152|\t}\n153|\tlength, ok := checkUint53Bounds(members[\"length\"], 0, maxUint53)\n154|\tif !ok {\n155|\t\treturn RawReference{}, invalid(\"raw reference[%d] length is not a uint53\", index)\n156|\t}\n157|\treturn RawReference{\n158|\t\tManifestID:       manifestID,\n159|\t\tBlobDescriptorID: descriptorID,\n160|\t\tOffset:           offset,\n161|\t\tLength:           length,\n162|\t}, nil\n163|}\n164|\n165|func rawReferenceObject(reference RawReference) map[string]any {\n166|\treturn map[string]any{\n167|\t\t\"manifest_id\":        reference.ManifestID.String(),\n168|\t\t\"blob_descriptor_id\": reference.BlobDescriptorID.String(),\n169|\t\t\"offset\":             reference.Offset,\n170|\t\t\"length\":             reference.Length,\n171|\t}\n172|}\n173|\n174|// decodeSortedUniqueRawReferences validates sorted unique raw\n175|// references: bytewise order of each item's JCS encoding, strict\n176|// increase proving sortedness and uniqueness together.\n177|func decodeSortedUniqueRawReferences(raw json.RawMessage) ([]RawReference, error) {\n178|\telements, ok := decodeArray(raw)\n179|\tif !ok {\n180|\t\treturn nil, invalid(\"source evidence raw_refs are not an array\")\n181|\t}\n182|\tif len(elements) > 65536 {\n183|\t\treturn nil, invalid(\"source evidence carries %d raw_refs, maximum is 65536\", len(elements))\n184|\t}\n185|\treferences := make([]RawReference, 0, len(elements))\n186|\tvar previous []byte\n187|\tfor index, element := range elements {\n188|\t\treference, err := decodeRawReference(element, index)\n189|\t\tif err != nil {\n190|\t\t\treturn nil, err\n191|\t\t}\n192|\t\tcanonical, err := canonicaljson.Canonicalize(bytesTrimSpace(element))\n193|\t\tif err != nil {\n194|\t\t\treturn nil, invalid(\"source evidence raw_refs[%d] are not canonical JSON: %v\", index, err)\n195|\t\t}\n196|\t\tif index > 0 && bytes.Compare(canonical, previous) <= 0 {\n197|\t\t\treturn nil, invalid(\"source evidence raw_refs are not sorted unique\")\n198|\t\t}\n199|\t\tprevious = canonical\n200|\t\treferences = append(references, reference)\n201|\t}\n202|\treturn references, nil\n203|}\n204|\n205|var sourceEvidenceMembers = map[string]bool{\n206|\t\"environment\": true, \"native_session_id\": true, \"native_event_id\": true,\n207|\t\"native_type\": true, \"raw_refs\": true, \"capture_status\": true,\n208|\t\"reason_codes\": true, \"core_operation_id\": true, \"extensions\": true,\n209|}\n210|\n211|var sourceEvidenceRequired = []string{\n212|\t\"environment\", \"native_session_id\", \"native_event_id\",\n213|\t\"native_type\", \"raw_refs\", \"capture_status\",\n214|\t\"reason_codes\", \"core_operation_id\", \"extensions\",\n215|}\n216|\n217|// SourceEvidence is one validated source evidence record.\n218|type SourceEvidence struct {\n219|\tEnvironment     sessadapter.Tuple\n220|\tNativeSessionID string\n221|\tNativeEventID   *string\n222|\tNativeType      *string\n223|\tRawRefs         []RawReference\n224|\tCaptureStatus   string\n225|\tReasonCodes     []string\n226|\tCoreOperationID *scalar.UUIDv7\n227|}\n228|\n229|// DecodeSourceEvidence validates one closed SourceEvidence:\n230|// sanitized native IDs, sorted unique raw references, and the\n231|// synthesized coupling (null native Event ID with a non-null core\n232|// operation; every other status with a null core operation).\n233|func DecodeSourceEvidence(raw json.RawMessage) (SourceEvidence, error) {\n234|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n235|\tif fault != nil {\n236|\t\treturn SourceEvidence{}, invalid(\"source evidence %s (%s)\", fault.detail, memberField(fault.member))\n237|\t}\n238|\tif name, unknown := unknownMember(members, sourceEvidenceMembers); unknown {\n239|\t\treturn SourceEvidence{}, invalid(\"source evidence carries unknown member %q\", name)\n240|\t}\n241|\tif name, missing := missingMember(members, sourceEvidenceRequired); missing {\n242|\t\treturn SourceEvidence{}, invalid(\"source evidence misses a required member %q\", name)\n243|\t}\n244|\ttuple, err := sessadapter.DecodeTuple(members[\"environment\"])\n245|\tif err != nil {\n246|\t\treturn SourceEvidence{}, invalid(\"source evidence environment is not an Environment Tuple: %v\", err)\n247|\t}\n248|\tnativeSession, ok := checkStringBounds(members[\"native_session_id\"], 1, 512)\n249|\tif !ok {\n250|\t\treturn SourceEvidence{}, invalid(\"source evidence native_session_id is not a string[1..512]\")\n251|\t}\n252|\tif err := SanitizeNativeKey(nativeSession); err != nil {\n253|\t\treturn SourceEvidence{}, err\n254|\t}\n255|\tvar nativeEvent *string\n256|\tif !isNull(members[\"native_event_id\"]) {\n257|\t\tvalue, ok := checkStringBounds(members[\"native_event_id\"], 1, 512)\n258|\t\tif !ok {\n259|\t\t\treturn SourceEvidence{}, invalid(\"source evidence native_event_id is not a string[1..512]\")\n260|\t\t}\n261|\t\tif err := SanitizeNativeKey(value); err != nil {\n262|\t\t\treturn SourceEvidence{}, err\n263|\t\t}\n264|\t\tnativeEvent = &value\n265|\t}\n266|\tvar nativeType *string\n267|\tif !isNull(members[\"native_type\"]) {\n268|\t\tvalue, ok := checkStringBounds(members[\"native_type\"], 1, 512)\n269|\t\tif !ok {\n270|\t\t\treturn SourceEvidence{}, invalid(\"source evidence native_type is not a string[1..512]\")\n271|\t\t}\n272|\t\tnativeType = &value\n273|\t}\n274|\treferences, err := decodeSortedUniqueRawReferences(members[\"raw_refs\"])\n275|\tif err != nil {\n276|\t\treturn SourceEvidence{}, err\n277|\t}\n278|\tstatus, ok := rawString(members[\"capture_status\"])\n279|\tif !ok || !validCaptureStatus(status) {\n280|\t\treturn SourceEvidence{}, invalid(\"source evidence capture_status is outside exact|partial|synthesized|unavailable\")\n281|\t}\n282|\treasons, ok := checkSortedUniqueStrings(members[\"reason_codes\"], 1, 128, 0, 128)\n283|\tif !ok {\n284|\t\treturn SourceEvidence{}, invalid(\"source evidence reason_codes are not sorted unique string[1..128][0..128]\")\n285|\t}\n286|\tvar operation *scalar.UUIDv7\n287|\tif !isNull(members[\"core_operation_id\"]) {\n288|\t\tvalue, ok := checkUUIDv7(members[\"core_operation_id\"])\n289|\t\tif !ok {\n290|\t\t\treturn SourceEvidence{}, invalid(\"source evidence core_operation_id is not a UUIDv7\")\n291|\t\t}\n292|\t\toperation = &value\n293|\t}\n294|\tif err := checkEvidenceCoupling(status, nativeEvent != nil, operation != nil); err != nil {\n295|\t\treturn SourceEvidence{}, err\n296|\t}\n297|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n298|\t\treturn SourceEvidence{}, invalid(\"source evidence extensions %s\", extensionsFault)\n299|\t}\n300|\treturn SourceEvidence{\n301|\t\tEnvironment:     tuple,\n302|\t\tNativeSessionID: nativeSession,\n303|\t\tNativeEventID:   nativeEvent,\n304|\t\tNativeType:      nativeType,\n305|\t\tRawRefs:         references,\n306|\t\tCaptureStatus:   status,\n307|\t\tReasonCodes:     reasons,\n308|\t\tCoreOperationID: operation,\n309|\t}, nil\n310|}\n311|\n312|// checkEvidenceCoupling enforces the synthesized rule: synthesized\n313|// requires a null native Event ID and a non-null core operation\n314|// identifying the core operation; all other statuses require a\n315|// null core operation.\n316|func checkEvidenceCoupling(status string, hasNativeEvent, hasOperation bool) error {\n317|\tif status == \"synthesized\" {\n318|\t\tif hasNativeEvent {\n319|\t\t\treturn invalid(\"source evidence synthesized carries a native event ID\")\n320|\t\t}\n321|\t\tif !hasOperation {\n322|\t\t\treturn invalid(\"source evidence synthesized requires a core operation\")\n323|\t\t}\n324|\t\treturn nil\n325|\t}\n326|\tif hasOperation {\n327|\t\treturn invalid(\"source evidence %s carries a core operation\", status)\n328|\t}\n329|\treturn nil\n330|}\n331|\n332|var canonicalEventMembers = map[string]bool{\n333|\t\"schema\": true, \"schema_version\": true, \"event_id\": true,\n334|\t\"logical_session_id\": true, \"ordinal\": true, \"parents\": true,\n335|\t\"actor_id\": true, \"turn_id\": true, \"kind\": true, \"timestamp\": true,\n336|\t\"visibility\": true, \"payload\": true, \"source_evidence\": true, \"extensions\": true,\n337|}\n338|\n339|var canonicalEventRequired = []string{\n340|\t\"schema\", \"schema_version\", \"event_id\",\n341|\t\"logical_session_id\", \"ordinal\", \"parents\",\n342|\t\"actor_id\", \"turn_id\", \"kind\", \"timestamp\",\n343|\t\"visibility\", \"payload\", \"source_evidence\", \"extensions\",\n344|}\n345|\n346|// CanonicalEvent is one validated Canonical Event. Payload carries\n347|// the validated closed payload object.\n348|type CanonicalEvent struct {\n349|\tEventID          scalar.Digest\n350|\tLogicalSessionID scalar.UUIDv7\n351|\tOrdinal          uint64\n352|\tParents          []scalar.Digest\n353|\tActorID          scalar.UUIDv7\n354|\tTurnID           *scalar.UUIDv7\n355|\tKind             string\n356|\tTimestamp        *scalar.Timestamp\n357|\tVisibility       string\n358|\tPayload          map[string]any\n359|\tEvidence         SourceEvidence\n360|}\n361|\n362|// RawRefInput is one caller-supplied raw reference candidate.\n363|type RawRefInput struct {\n364|\tManifestID       string\n365|\tBlobDescriptorID string\n366|\tOffset           uint64\n367|\tLength           uint64\n368|}\n369|\n370|// EvidenceInput is one caller-supplied source evidence candidate\n371|// for Build.\n372|type EvidenceInput struct {\n373|\tEnvironment     []byte\n374|\tNativeSessionID string\n375|\tNativeEventID   *string\n376|\tNativeType      *string\n377|\tRawRefs         []RawRefInput\n378|\tCaptureStatus   string\n379|\tReasonCodes     []string\n380|\tCoreOperationID *string\n381|}\n382|\n383|// CanonicalEventInput is the caller-supplied canonical event\n384|// candidate for Build. Payload carries the exact closed payload\n385|// object bytes; Build validates them under the kind-selected rules.\n386|type CanonicalEventInput struct {\n387|\tLogicalSessionID string\n388|\tOrdinal          uint64\n389|\tParents          []string\n390|\tActorID          string\n391|\tTurnID           *string\n392|\tKind             string\n393|\tTimestamp        *string\n394|\tVisibility       string\n395|\tPayload          []byte\n396|\tEvidence         EvidenceInput\n397|\tExtensions       map[string]any\n398|}\n399|\n400|// BuildCanonicalEvent constructs one closed Canonical Event 1.0.0\n401|// as canonical bytes. Identical inputs produce byte-identical\n402|// outputs.\n403|func BuildCanonicalEvent(input CanonicalEventInput) ([]byte, error) {\n404|\tobject, err := buildCanonicalEvent(input)\n405|\tif err != nil {\n406|\t\treturn nil, err\n407|\t}\n408|\tomitted, err := canonicalizeObject(object)\n409|\tif err != nil {\n410|\t\treturn nil, err\n411|\t}\n412|\teventID := scalar.SHA256Digest(omitted)\n413|\tobject[canonicalEventSelf] = eventID.String()\n414|\treturn canonicalizeObject(object)\n415|}\n416|\n417|func buildCanonicalEvent(input CanonicalEventInput) (map[string]any, error) {\n418|\tlogical, err := scalar.ParseUUIDv7(input.LogicalSessionID)\n419|\tif err != nil {\n420|\t\treturn nil, invalid(\"canonical event logical_session_id is not a UUIDv7: %v\", err)\n421|\t}\n422|\tif input.Ordinal > maxUint53 {\n423|\t\treturn nil, invalid(\"canonical event ordinal exceeds uint53\")\n424|\t}\n425|\tparents, err := parseSortedUniqueDigestStrings(input.Parents, 0, 64, \"parents\")\n426|\tif err != nil {\n427|\t\treturn nil, invalid(\"canonical event %v\", err)\n428|\t}\n429|\tactorID, err := scalar.ParseUUIDv7(input.ActorID)\n430|\tif err != nil {\n431|\t\treturn nil, invalid(\"canonical event actor_id is not a UUIDv7: %v\", err)\n432|\t}\n433|\tvar turn any\n434|\tif input.TurnID != nil {\n435|\t\tvalue, err := scalar.ParseUUIDv7(*input.TurnID)\n436|\t\tif err != nil {\n437|\t\t\treturn nil, invalid(\"canonical event turn_id is not a UUIDv7: %v\", err)\n438|\t\t}\n439|\t\tturn = value.String()\n440|\t}\n441|\tif !ValidEventKind(input.Kind) {\n442|\t\treturn nil, invalid(\"canonical event kind is outside the 26-kind vocabulary\")\n443|\t}\n444|\tvar stamp any\n445|\tif input.Timestamp != nil {\n446|\t\tvalue, err := scalar.ParseTimestamp(*input.Timestamp)\n447|\t\tif err != nil {\n448|\t\t\treturn nil, invalid(\"canonical event timestamp is not a timestamp: %v\", err)\n449|\t\t}\n450|\t\tstamp = value.String()\n451|\t}\n452|\tif !validVisibility(input.Visibility) {\n453|\t\treturn nil, invalid(\"canonical event visibility is outside public|projection|internal|opaque\")\n454|\t}\n455|\tpayload, err := checkPayload(input.Kind, json.RawMessage(input.Payload))\n456|\tif err != nil {\n457|\t\treturn nil, err\n458|\t}\n459|\tevidence, err := buildSourceEvidence(input.Evidence)\n460|\tif err != nil {\n461|\t\treturn nil, err\n462|\t}\n463|\tif _, err := encodeExtensions(input.Extensions); err != nil {\n464|\t\treturn nil, err\n465|\t}\n466|\treturn map[string]any{\n467|\t\t\"schema\":             canonicalEventSchema,\n468|\t\t\"schema_version\":     canonicalEventVersion,\n469|\t\t\"logical_session_id\": logical.String(),\n470|\t\t\"ordinal\":            input.Ordinal,\n471|\t\t\"parents\":            digestStrings(parents),\n472|\t\t\"actor_id\":           actorID.String(),\n473|\t\t\"turn_id\":            turn,\n474|\t\t\"kind\":               input.Kind,\n475|\t\t\"timestamp\":          stamp,\n476|\t\t\"visibility\":         input.Visibility,\n477|\t\t\"payload\":            payload,\n478|\t\t\"source_evidence\":    evidence,\n479|\t\t\"extensions\":         extensionValue(input.Extensions),\n480|\t}, nil\n481|}\n482|\n483|// DecodeCanonicalEvent validates one closed Canonical Event 1.0.0:\n484|// exact members, schema/version, self-digest agreement, the kind\n485|// and visibility vocabularies, the kind-selected payload rules,\n486|// and the source evidence coupling.\n487|func DecodeCanonicalEvent(data []byte) (CanonicalEvent, error) {\n488|\tmembers, fault := decodeStrictObject(data)\n489|\tif fault != nil {\n490|\t\treturn CanonicalEvent{}, invalid(\"canonical event %s (%s)\", fault.detail, memberField(fault.member))\n491|\t}\n492|\tif name, unknown := unknownMember(members, canonicalEventMembers); unknown {\n493|\t\treturn CanonicalEvent{}, invalid(\"canonical event carries unknown member %q\", name)\n494|\t}\n495|\tif name, missing := missingMember(members, canonicalEventRequired); missing {\n496|\t\treturn CanonicalEvent{}, invalid(\"canonical event misses a required member %q\", name)\n497|\t}\n498|\tschema, ok := rawString(members[\"schema\"])\n499|\tif !ok || schema != canonicalEventSchema {\n500|\t\treturn CanonicalEvent{}, invalid(\"canonical event schema is not the canonical event\")\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
