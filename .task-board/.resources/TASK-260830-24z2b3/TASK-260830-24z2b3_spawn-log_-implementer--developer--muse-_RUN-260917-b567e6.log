load: every\n580|// payload is a strict (duplicate-free) object; message-like kinds\n581|// carry exactly content_blocks plus extensions; content blocks use\n582|// exactly the eight-type vocabulary with typed inline content\n583|// (at most 64 KiB) or Blob Descriptor references. Per-kind fact\n584|// registries beyond this envelope are sibling scope.\n585|func checkPayload(kind string, raw json.RawMessage) (map[string]any, error) {\n586|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n587|\tif fault != nil {\n588|\t\treturn nil, invalid(\"canonical event payload %s (%s)\", fault.detail, memberField(fault.member))\n589|\t}\n590|\tif messageLikeKind(kind) {\n591|\t\tallowed := map[string]bool{\"content_blocks\": true, \"extensions\": true}\n592|\t\tif name, unknown := unknownMember(members, allowed); unknown {\n593|\t\t\treturn nil, invalid(\"canonical event message payload carries unknown member %q\", name)\n594|\t\t}\n595|\t\tblocks, present := members[\"content_blocks\"]\n596|\t\tif !present {\n597|\t\t\treturn nil, invalid(\"canonical event message payload misses content_blocks\")\n598|\t\t}\n599|\t\tif err := checkContentBlocks(blocks); err != nil {\n600|\t\t\treturn nil, err\n601|\t\t}\n602|\t\tif extensions, present := members[\"extensions\"]; present {\n603|\t\t\tif extensionsFault := checkExtensionsClosed(extensions); extensionsFault != nil {\n604|\t\t\t\treturn nil, invalid(\"canonical event message payload extensions %s\", extensionsFault)\n605|\t\t\t}\n606|\t\t}\n607|\t} else if blocks, present := members[\"content_blocks\"]; present {\n608|\t\tif err := checkContentBlocks(blocks); err != nil {\n609|\t\t\treturn nil, err\n610|\t\t}\n611|\t}\n612|\tvar payload map[string]any\n613|\tif err := json.Unmarshal(bytesTrimSpace(raw), &payload); err != nil {\n614|\t\treturn nil, invalid(\"canonical event payload is not an object: %v\", err)\n615|\t}\n616|\treturn payload, nil\n617|}\n618|\n619|var contentBlockMembers = map[string]bool{\n620|\t\"type\": true, \"content\": true, \"blob_descriptor_id\": true, \"media_type\": true, \"extensions\": true,\n621|}\n622|\n623|// checkContentBlocks validates message-like content blocks: strict\n624|// objects with a vocabulary type, inline content of at most 64 KiB,\n625|// and digest-grammar Blob Descriptor references. The pinned text\n626|// gives each block \"typed inline content or Blob Descriptor\n627|// references\": exactly one of the two members must be present, so a\n628|// block with neither and a block with both are refused.\n629|func checkContentBlocks(raw json.RawMessage) error {\n630|\telements, ok := decodeArray(raw)\n631|\tif !ok {\n632|\t\treturn invalid(\"canonical event content_blocks are not an array\")\n633|\t}\n634|\tfor index, element := range elements {\n635|\t\tmembers, fault := decodeStrictObject(bytesTrimSpace(element))\n636|\t\tif fault != nil {\n637|\t\t\treturn invalid(\"canonical event content block[%d] %s (%s)\", index, fault.detail, memberField(fault.member))\n638|\t\t}\n639|\t\tif name, unknown := unknownMember(members, contentBlockMembers); unknown {\n640|\t\t\treturn invalid(\"canonical event content block[%d] carries unknown member %q\", index, name)\n641|\t\t}\n642|\t\tblockTypeValue, present := members[\"type\"]\n643|\t\tif !present {\n644|\t\t\treturn invalid(\"canonical event content block[%d] misses its type\", index)\n645|\t\t}\n646|\t\tblockType, ok := rawString(blockTypeValue)\n647|\t\tif !ok || !validContentBlockType(blockType) {\n648|\t\t\treturn invalid(\"canonical event content block[%d] type is outside the eight-type vocabulary\", index)\n649|\t\t}\n650|\t\t_, hasContent := members[\"content\"]\n651|\t\t_, hasDescriptor := members[\"blob_descriptor_id\"]\n652|\t\tif hasContent == hasDescriptor {\n653|\t\t\treturn invalid(\"canonical event content block[%d] carries content and descriptor members that are not exclusive\", index)\n654|\t\t}\n655|\t\tif content, present := members[\"content\"]; present {\n656|\t\t\ttext, ok := 