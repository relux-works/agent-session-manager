{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cd8f","stream":{"kind":"session","id":"01a0b144-2d0b-7f30-96a3-e7fabafc632c"},"sequence":1314,"recorded_at":1780531400002623,"record_type":"event","durability":"durable","causation_id":"96a3132b-8530-4e47-8657-36d15f2da569","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"96a3132b-8530-4e47-8657-36d15f2da569","run_stream":{"kind":"run","id":"96a3132b-8530-4e47-8657-36d15f2da569"},"task_stream":{"kind":"task","id":"01a0b14a-c1f7-7c53-933b-8154d5770ebd"},"task_id":"01a0b14a-c1f7-7c53-933b-8154d5770ebd","event":{"kind":"output","task_id":"01a0b14a-c1f7-7c53-933b-8154d5770ebd","chunk":"{\n  \"chunk_id\": \"exec-32-1\",\n  \"command\": \"sed -n '1,60p' /tmp/rev3ev/zz_rev3_probe_test.go.txt; echo \\\"...P5c/P7d...\\\"; sed -n '400,430p' /tmp/rev3ev/zz_rev3_probe_test.go.txt; echo \\\"...P7d/P7e...\\\"; sed -n '480,500p' /tmp/rev3ev/zz_rev3_probe_test.go.txt; echo \\\"...P20c...\\\"; sed -n '670,695p' /tmp/rev3ev/zz_rev3_probe_test.go.txt\",\n  \"description\": \"Read probe helpers and P5c P7d P20c vectors\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"package clonebundle\\n\\n// Reviewer probes (TASK-260830-24z2b3 rev3, RUN-260917-62d051). Test-only\\n// file in an isolated candidate copy; every probe reports the production\\n// verdict, it never asserts, so the log shows what each entry admits or\\n// refuses.\\n\\nimport (\\n\\t\\\"bytes\\\"\\n\\t\\\"encoding/json\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"strings\\\"\\n\\t\\\"testing\\\"\\n\\t\\\"unicode/utf8\\\"\\n\\n\\t\\\"github.com/relux-works/agent-session-manager/internal/canonicaljson\\\"\\n\\t\\\"github.com/relux-works/agent-session-manager/internal/environ\\\"\\n)\\n\\nfunc v3(label string, err error) {\\n\\tif err == nil {\\n\\t\\tfmt.Printf(\\\"PROBE %-70s ADMITTED\\\\n\\\", label)\\n\\t\\treturn\\n\\t}\\n\\tfmt.Printf(\\\"PROBE %-70s REFUSED: %v\\\\n\\\", label, err)\\n}\\n\\nfunc member3(data []byte, name string) string {\\n\\tvar m map[string]json.RawMessage\\n\\t_ = json.Unmarshal(data, &m)\\n\\treturn string(m[name])\\n}\\n\\n// makeDescriptorMedia builds a descriptor for payload with a chosen media type\\n// (same blob_id/size as makeDescriptor, different descriptor identity).\\nfunc makeDescriptorMedia(t *testing.T, payload []byte, media string) ([]byte, string) {\\n\\tt.Helper()\\n\\tdescriptor, _, _, _ := makeDescriptor(t, payload)\\n\\tvar object map[string]any\\n\\tif err := json.Unmarshal(descriptor, &object); err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tobject[\\\"media_type\\\"] = media\\n\\tplain, _ := json.Marshal(object)\\n\\tcalculated, _, err := canonicaljson.CalculateObjectIdentity(plain)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tobject[\\\"descriptor_id\\\"] = calculated.String()\\n\\tout, _ := json.Marshal(object)\\n\\treturn out, calculated.String()\\n}\\n\\nfunc TestRev3Probes(t *testing.T) {\\n\\tidentity := fixtureNativeIdentity()\\n\\tidentityDigest, err := IdentityDigest(identity, nil)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tbuildRaw := func(inputs []EntryInput, ext map[string]any) ([]byte, error) {\\n...P5c/P7d...\\n\\tv3(\\\"P4f VerifyCaptureReconciliation plan dup\\\", VerifyCaptureReconciliation(cm, []string{\\\"store/blob-a\\\", \\\"store/blob-b\\\", \\\"store/blob-b\\\"}, in.RawKeys))\\n\\tv3(\\\"P4g VerifyCaptureReconciliation plan dup (4 keys)\\\", VerifyCaptureReconciliation(cm, []string{\\\"store/blob-a\\\", \\\"store/blob-b\\\", \\\"store/token-cache\\\", \\\"store/token-cache\\\"}, in.RawKeys))\\n\\tin = validCaptureInput(t)\\n\\tin.PlanKeys = append(in.PlanKeys, \\\"store/zz-missing-item\\\")\\n\\t_, err = BuildCaptureManifest(in)\\n\\tv3(\\\"P5 build items != plan (extra plan key)\\\", err)\\n\\tin = validCaptureInput(t)\\n\\tin.PlanKeys = in.PlanKeys[:2]\\n\\t_, err = BuildCaptureManifest(in)\\n\\tv3(\\\"P5b build items != plan (missing plan key)\\\", err)\\n\\tin = validCaptureInput(t)\\n\\t// duplicate plan keys hiding an extra item: plan=[a,a,token] items=[a,b,token]\\n\\tin.PlanKeys = []string{\\\"store/blob-a\\\", \\\"store/blob-a\\\", \\\"store/token-cache\\\"}\\n\\tbuilt, err = BuildCaptureManifest(in)\\n\\tv3(\\\"P5c build plan=[a,a,token] items=[a,b,token] (b not a plan candidate)\\\", err)\\n\\tif err == nil {\\n\\t\\tmm, _ := DecodeCaptureManifest(built)\\n\\t\\tfmt.Printf(\\\"PROBE P5c sealed raw_complete=%v items=%d\\\\n\\\", mm.RawComplete, len(mm.Items))\\n\\t}\\n\\tin = validCaptureInput(t)\\n\\tin.RawKeys = []string{\\\"store/blob-a\\\"}\\n\\tbuilt, err = BuildCaptureManifest(in)\\n\\tv3(\\\"P5d build raw keys incomplete (seals raw_complete=false?)\\\", err)\\n\\tif err == nil {\\n\\t\\tmm, _ := DecodeCaptureManifest(built)\\n\\t\\tfmt.Printf(\\\"PROBE P5d sealed raw_complete=%v\\\\n\\\", mm.RawComplete)\\n\\t}\\n\\tin = validCaptureInput(t)\\n\\tin.RawKeys = []string{\\\"store/blob-a\\\", \\\"store/blob-a\\\"}\\n\\tbuilt, err = BuildCaptureManifest(in)\\n\\tv3(\\\"P5e build raw keys [a,a] (dup)\\\", err)\\n...P7d/P7e...\\n\\tv3(\\\"P7 block neither\\\", err)\\n\\tei.Payload = []byte(`{\\\"content_blocks\\\":[{\\\"type\\\":\\\"text\\\",\\\"content\\\":\\\"x\\\",\\\"blob_descriptor_id\\\":\\\"` + fixtureDigest(\\\"d\\\") + `\\\"}],\\\"extensions\\\":{}}`)\\n\\t_, err = BuildCanonicalEvent(ei)\\n\\tv3(\\\"P7b block both\\\", err)\\n\\tei.Payload = []byte(`{\\\"content_blocks\\\":[{\\\"type\\\":\\\"text\\\",\\\"content\\\":\\\"x\\\"}]}`)\\n\\t_, err = BuildCanonicalEvent(ei)\\n\\tv3(\\\"P7c message payload without extensions member\\\", err)\\n\\tei.Payload = []byte(`{\\\"content_blocks\\\":[{\\\"type\\\":\\\"text\\\",\\\"content\\\":null}],\\\"extensions\\\":{}}`)\\n\\t_, err = BuildCanonicalEvent(ei)\\n\\tv3(\\\"P7d block content null\\\", err)\\n\\tei.Payload = []byte(`{\\\"content_blocks\\\":[{\\\"type\\\":\\\"text\\\",\\\"blob_descriptor_id\\\":null}],\\\"extensions\\\":{}}`)\\n\\t_, err = BuildCanonicalEvent(ei)\\n\\tv3(\\\"P7e block descriptor null\\\", err)\\n\\tei.Payload = []byte(`{\\\"content_blocks\\\":[{\\\"type\\\":\\\"text\\\",\\\"content\\\":\\\"x\\\",\\\"media_type\\\":\\\"\\\"}],\\\"extensions\\\":{}}`)\\n\\t_, err = BuildCanonicalEvent(ei)\\n\\tv3(\\\"P7f block media_type empty\\\", err)\\n\\tei.Payload = []byte(`{\\\"content_blocks\\\":[],\\\"extensions\\\":{}}`)\\n\\t_, err = BuildCanonicalEvent(ei)\\n\\tv3(\\\"P7g message with zero blocks\\\", err)\\n\\n\\tfmt.Println(\\\"=== P10-P12 decode-side arms (rev2 survivors)\\\")\\n...P20c...\\n\\t// ordinals\\n\\tv3(\\\"P19 ordinals [0,1,2]\\\", CheckOrdinalContiguity([]uint64{0, 1, 2}))\\n\\tv3(\\\"P19b ordinals []\\\", CheckOrdinalContiguity(nil))\\n\\tv3(\\\"P19c ordinals [1,0,0]\\\", CheckOrdinalContiguity([]uint64{1, 0, 0}))\\n\\tv3(\\\"P19d ordinals [0,1,3]\\\", CheckOrdinalContiguity([]uint64{0, 1, 3}))\\n\\t// stable proof snapshot with all-false booleans for immutable_snapshot (allowed?)\\n\\t_, err = DecodeStableSnapshotProof([]byte(`{\\\"proof_kind\\\":\\\"immutable_snapshot\\\",\\\"source_generation\\\":\\\"g\\\",\\\"snapshot_identity_digest\\\":\\\"` + fixtureDigest(\\\"s\\\") + `\\\",\\\"pre_capture_digest\\\":\\\"` + fixtureDigest(\\\"p\\\") + `\\\",\\\"post_capture_digest\\\":\\\"` + fixtureDigest(\\\"p\\\") + `\\\",\\\"input_blocked\\\":false,\\\"foreground_idle\\\":false,\\\"background_idle\\\":false,\\\"extensions\\\":{}}`))\\n\\tv3(\\\"P20 immutable_snapshot with all booleans false\\\", err)\\n\\t_, err = DecodeStableSnapshotProof([]byte(`{\\\"proof_kind\\\":\\\"closed_store\\\",\\\"source_generation\\\":\\\"g\\\",\\\"snapshot_identity_digest\\\":null,\\\"pre_capture_digest\\\":\\\"` + fixtureDigest(\\\"p\\\") + `\\\",\\\"post_capture_digest\\\":\\\"` + fixtureDigest(\\\"p\\\") + `\\\",\\\"input_blocked\\\":true,\\\"foreground_idle\\\":true,\\\"background_idle\\\":false,\\\"extensions\\\":{}}`))\\n\\tv3(\\\"P20b closed_store background_idle false\\\", err)\\n\\t_, err = DecodeStableSnapshotProof([]byte(`{\\\"proof_kind\\\":\\\"closed_store\\\",\\\"source_generation\\\":\\\"g\\\",\\\"snapshot_identity_digest\\\":null,\\\"pre_capture_digest\\\":\\\"` + fixtureDigest(\\\"p\\\") + `\\\",\\\"post_capture_digest\\\":\\\"` + fixtureDigest(\\\"p\\\") + `\\\",\\\"input_blocked\\\":false,\\\"foreground_idle\\\":true,\\\"background_idle\\\":true,\\\"extensions\\\":{}}`))\\n\\tv3(\\\"P20c closed_store input_blocked false\\\", err)\\n\\t// build-side stable proof coupling\\n\\tin = validCaptureInput(t)\\n\\tin.Boundary.ProofKind = \\\"immutable_snapshot\\\"\\n\\t_, err = BuildCaptureManifest(in)\\n\\tv3(\\\"P21 build immutable_snapshot null identity\\\", err)\\n\\tin = validCaptureInput(t)\\n\\tin.Boundary.PostCaptureDigest = fixtureDigest(\\\"other\\\")\\n\\t_, err = BuildCaptureManifest(in)\\n\\tv3(\\\"P21b build stable unequal digests\\\", err)\\n\\tin = validCaptureInput(t)\\n\\tin.Boundary.InputBlocked = false\\n\\t_, err = BuildCaptureManifest(in)\\n\\tv3(\\\"P21c build closed_store input_blocked false\\\", err)\\n\\tin = validCaptureInput(t)\\n\",\n  \"original_output_bytes\": 6502,\n  \"original_output_tokens\": 1626,\n  \"truncated\": false\n}","final_result":true}}}
