{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb31","stream":{"kind":"session","id":"01a0b144-2d0b-7f30-96a3-e7fabafc632c"},"sequence":1011,"recorded_at":1780531400002017,"record_type":"event","durability":"durable","causation_id":"96a3132b-8530-4e47-8657-36d15f2da569","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"96a3132b-8530-4e47-8657-36d15f2da569","run_stream":{"kind":"run","id":"96a3132b-8530-4e47-8657-36d15f2da569"},"task_stream":{"kind":"task","id":"01a0b149-bcee-7473-b29e-17555106a261"},"task_id":"01a0b149-bcee-7473-b29e-17555106a261","event":{"kind":"output","task_id":"01a0b149-bcee-7473-b29e-17555106a261","chunk":"Read text file `internal/clonebundle/fixtures_test.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"encoding/json\"\n7|\t\"fmt\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"runtime\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/localstore\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n16|)\n17|\n18|// Shared fixtures for the clonebundle suite. Every literal is\n19|// hand-written and independent of production constants: the verdict\n20|// always comes from production; the vectors never do.\n21|\n22|const (\n23|\tfixtureOperationID = \"0198f4c8-8e50-7f66-8f70-1234567890ac\"\n24|\tfixtureBundleID    = \"0198f4c8-8e50-7f66-8f70-1234567890b1\"\n25|\tfixtureSessionID   = \"0198f4c8-8e50-7f66-8f70-1234567890c2\"\n26|\tfixtureRecordSeed  = \"test-session-record\"\n27|\tfixtureHostID      = \"0198f4c8-8e50-7f66-8f70-1234567890d3\"\n28|\tfixtureActorMain   = \"0198f4c8-8e50-7f66-8f70-1234567890e4\"\n29|\tfixtureActorSub    = \"0198f4c8-8e50-7f66-8f70-1234567890f5\"\n30|\tfixtureTurnID      = \"0198f4c8-8e50-7f66-8f70-1234567890a6\"\n31|\tfixtureCreatedAt   = \"2026-09-17T04:05:00.000Z\"\n32|\tfixtureWorkspaceID = \"0198f4c8-8e50-7f66-8f70-1234567890b7\"\n33|)\n34|\n35|func fixtureDigest(seed string) string {\n36|\tsum := sha256.Sum256([]byte(seed))\n37|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n38|}\n39|\n40|func fixtureTupleJSON() string {\n41|\treturn fmt.Sprintf(`{\"environment_id\":\"test.env\",\"environment_version\":\"2.1.0\",\"platform\":\"linux\",\"architecture\":\"amd64\",\"store_schema_fingerprint\":%q,\"adapter_version\":\"1.2.3\"}`,\n42|\t\tfixtureDigest(\"test-store-fingerprint\"))\n43|}\n44|\n45|func fixtureWorkspaceJSON() string {\n46|\treturn fmt.Sprintf(`{\"logical_workspace_id\":%q,\"cwd_relative\":\"work/trees/alpha\",\"repository_remote_fingerprints\":[%q],\"branch\":\"main\",\"head_digest\":%q,\"index_digest\":null,\"working_tree_digest\":null,\"extensions\":{}}`,\n47|\t\tfixtureWorkspaceID, fixtureDigest(\"test-remote\"), fixtureDigest(\"test-head\"))\n48|}\n49|\n50|func fixtureNativeIdentity() NativeIdentity {\n51|\tworkspace, err := scalar.ParseUUIDv7(fixtureWorkspaceID)\n52|\tif err != nil {\n53|\t\tpanic(err)\n54|\t}\n55|\treturn NativeIdentity{\n56|\t\tNativeSessionID:    \"native-session-alpha\",\n57|\t\tIdentityKind:       \"provider_native\",\n58|\t\tLogicalWorkspaceID: workspace,\n59|\t}\n60|}\n61|\n62|func mustDigest(t *testing.T, value string) scalar.Digest {\n63|\tt.Helper()\n64|\tdigest, err := scalar.ParseDigest(value)\n65|\tif err != nil {\n66|\t\tt.Fatalf(\"ParseDigest(%q) error = %v\", value, err)\n67|\t}\n68|\treturn digest\n69|}\n70|\n71|func strptr(value string) *string { return &value }\n72|\n73|func u64ptr(value uint64) *uint64 { return &value }\n74|\n75|// makeDescriptor builds one valid Section 10.2 Blob Descriptor for\n76|// the given payload through the canonicaljson production entries:\n77|// the shape validates and the identity verifies before the fixture\n78|// is returned.\n79|func makeDescriptor(t *testing.T, payload []byte) (descriptor []byte, blobID, descriptorID string, size uint64) {\n80|\tt.Helper()\n81|\tsum := sha256.Sum256(payload)\n82|\tblobID = \"sha256:\" + hex.EncodeToString(sum[:])\n83|\tsize = uint64(len(payload))\n84|\tvar chunks []any\n85|\tif len(payload) > 0 {\n86|\t\tchunks = []any{map[string]any{\n87|\t\t\t\"index\":    0,\n88|\t\t\t\"offset\":   0,\n89|\t\t\t\"size\":     size,\n90|\t\t\t\"chunk_id\": blobID,\n91|\t\t}}\n92|\t} else {\n93|\t\tchunks = []any{}\n94|\t}\n95|\tobject := map[string]any{\n96|\t\t\"schema\":         \"urn:ax:schema:blob\",\n97|\t\t\"schema_version\": \"1.0.0\",\n98|\t\t\"descriptor_id\":  fixtureDigest(\"placeholder-descriptor\"),\n99|\t\t\"blob_id\":        blobID,\n100|\t\t\"size\":           size,\n101|\t\t\"media_type\":     \"application/octet-stream\",\n102|\t\t\"chunks\":         chunks,\n103|\t}\n104|\tplain, err := json.Marshal(object)\n105|\tif err != nil {\n106|\t\tt.Fatal(err)\n107|\t}\n108|\tcalculated, _, err := canonicaljson.CalculateObjectIdentity(plain)\n109|\tif err != nil {\n110|\t\tt.Fatalf(\"CalculateObjectIdentity(fixture descriptor) error = %v\", err)\n111|\t}\n112|\tobject[\"descriptor_id\"] = calculated.String()\n113|\tdescriptor, err = json.Marshal(object)\n114|\tif err != nil {\n115|\t\tt.Fatal(err)\n116|\t}\n117|\tif _, _, err := canonicaljson.VerifyObjectIdentity(descriptor); err != nil {\n118|\t\tt.Fatalf(\"VerifyObjectIdentity(fixture descriptor) error = %v\", err)\n119|\t}\n120|\treturn descriptor, blobID, calculated.String(), size\n121|}\n122|\n123|func openFixtureStore(t *testing.T) *localstore.ObjectStore {\n124|\tt.Helper()\n125|\thome := t.TempDir()\n126|\tconfig := filepath.Join(home, \"config\")\n127|\tif err := os.Mkdir(config, 0o700); err != nil {\n128|\t\tt.Fatal(err)\n129|\t}\n130|\tplatform := scalar.PlatformLinux\n131|\tif runtime.GOOS == \"darwin\" {\n132|\t\tplatform = scalar.PlatformMacOS\n133|\t} else if runtime.GOOS == \"windows\" {\n134|\t\tplatform = scalar.PlatformWindows\n135|\t}\n136|\tresolved, err := localstore.ResolvePaths(localstore.ResolveRequest{\n137|\t\tPlatform: platform,\n138|\t\tFlags: map[string]string{\n139|\t\t\t\"--config\":      filepath.Join(config, \"config.toml\"),\n140|\t\t\t\"--data-dir\":    filepath.Join(home, \"data\"),\n141|\t\t\t\"--state-dir\":   filepath.Join(home, \"state\"),\n142|\t\t\t\"--cache-dir\":   filepath.Join(home, \"cache\"),\n143|\t\t\t\"--runtime-dir\": filepath.Join(home, \"runtime\"),\n144|\t\t},\n145|\t\tEnvironment:  map[string]string{},\n146|\t\tHomeDir:      home,\n147|\t\tTemporaryDir: filepath.Join(home, \"temporary\"),\n148|\t})\n149|\tif err != nil {\n150|\t\tt.Fatalf(\"ResolvePaths() error = %v\", err)\n151|\t}\n152|\tstore, err := localstore.OpenObjectStore(resolved)\n153|\tif err != nil {\n154|\t\tt.Fatalf(\"OpenObjectStore() error = %v\", err)\n155|\t}\n156|\treturn store\n157|}\n158|\n159|func validEntryInputs(t *testing.T) []EntryInput {\n160|\tt.Helper()\n161|\tfirst, firstBlob, firstDescriptor, firstSize := makeDescriptor(t, []byte(\"first-raw-object\"))\n162|\tsecond, secondBlob, secondDescriptor, secondSize := makeDescriptor(t, []byte(\"second-raw-object\"))\n163|\treturn []EntryInput{\n164|\t\t{NativeItemKey: \"store/blob-a\", Class: \"durable_payload\", ByteCount: firstSize, BlobID: firstBlob, DescriptorID: firstDescriptor, Descriptor: first},\n165|\t\t{NativeItemKey: \"store/blob-b\", Class: \"durable_sidecar\", ByteCount: secondSize, BlobID: secondBlob, DescriptorID: secondDescriptor, Descriptor: second},\n166|\t}\n167|}\n168|\n169|func validCaptureItems(t *testing.T) []CaptureItemInput {\n170|\tt.Helper()\n171|\t_, _, firstDescriptor, firstSize := makeDescriptor(t, []byte(\"first-raw-object\"))\n172|\t_, _, secondDescriptor, secondSize := makeDescriptor(t, []byte(\"second-raw-object\"))\n173|\tfirstCount := firstSize\n174|\tsecondCount := secondSize\n175|\treturn []CaptureItemInput{\n176|\t\t{NativeItemKey: \"store/blob-a\", Class: \"durable_payload\", Disposition: \"included\", BlobDescriptorID: &firstDescriptor, ByteCount: &firstCount},\n177|