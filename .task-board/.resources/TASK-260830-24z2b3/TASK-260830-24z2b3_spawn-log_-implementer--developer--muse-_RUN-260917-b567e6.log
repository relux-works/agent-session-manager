{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc7f","stream":{"kind":"session","id":"01a0b144-2d0b-7f30-96a3-e7fabafc632c"},"sequence":1178,"recorded_at":1780531400002351,"record_type":"event","durability":"durable","causation_id":"96a3132b-8530-4e47-8657-36d15f2da569","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"96a3132b-8530-4e47-8657-36d15f2da569","run_stream":{"kind":"run","id":"96a3132b-8530-4e47-8657-36d15f2da569"},"task_stream":{"kind":"task","id":"01a0b14a-1f64-7443-8a6e-1d48b223a2ac"},"task_id":"01a0b14a-1f64-7443-8a6e-1d48b223a2ac","event":{"kind":"output","task_id":"01a0b14a-1f64-7443-8a6e-1d48b223a2ac","chunk":"Read text file `internal/clonebundle/boundary.go`.\n(499 line(s) above)\n500|\tSnapshotIdentity  *string\n501|\tPreCaptureDigest  string\n502|\tPostCaptureDigest string\n503|\tInputBlocked      bool\n504|\tForegroundIdle    bool\n505|\tBackgroundIdle    bool\n506|\tCore              bool\n507|}\n508|\n509|func buildBoundary(input BoundaryInput) (CaptureBoundary, map[string]any, error) {\n510|\tswitch input.Kind {\n511|\tcase \"stable\":\n512|\t\tproof, object, err := buildStableProof(input)\n513|\t\tif err != nil {\n514|\t\t\treturn CaptureBoundary{}, nil, err\n515|\t\t}\n516|\t\tboundary := CaptureBoundary{Kind: \"stable\", Proof: &proof}\n517|\t\treturn boundary, map[string]any{\n518|\t\t\t\"kind\":       \"stable\",\n519|\t\t\t\"proof\":      object,\n520|\t\t\t\"extensions\": map[string]any{},\n521|\t\t}, nil\n522|\tcase \"unstable_archive\":\n523|\t\tif !input.Core {\n524|\t\t\treturn CaptureBoundary{}, nil, invalid(\"capture boundary unstable_archive is core-created only\")\n525|\t\t}\n526|\t\tgeneration, err := ParseGeneration(input.Generation)\n527|\t\tif err != nil {\n528|\t\t\treturn CaptureBoundary{}, nil, err\n529|\t\t}\n530|\t\tpre, err := scalar.ParseDigest(input.PreCaptureDigest)\n531|\t\tif err != nil {\n532|\t\t\treturn CaptureBoundary{}, nil, invalid(\"capture boundary pre_capture_digest is not a digest: %v\", err)\n533|\t\t}\n534|\t\tpost, err := scalar.ParseDigest(input.PostCaptureDigest)\n535|\t\tif err != nil {\n536|\t\t\treturn CaptureBoundary{}, nil, invalid(\"capture boundary post_capture_digest is not a digest: %v\", err)\n537|\t\t}\n538|\t\tboundary := CaptureBoundary{\n539|\t\t\tKind:              \"unstable_archive\",\n540|\t\t\tSourceGeneration:  &generation,\n541|\t\t\tPreCaptureDigest:  &pre,\n542|\t\t\tPostCaptureDigest: &post,\n543|\t\t}\n544|\t\treturn boundary, map[string]any{\n545|\t\t\t\"kind\":                        \"unstable_archive\",\n546|\t\t\t\"source_generation\":           generation.String(),\n547|\t\t\t\"pre_capture_digest\":          pre.String(),\n548|\t\t\t\"post_capture_digest\":         post.String(),\n549|\t\t\t\"reason_code\":                 \"source_not_quiescent\",\n550|\t\t\t\"operator_explicit\":           true,\n551|\t\t\t\"target_projection_forbidden\": true,\n552|\t\t\t\"extensions\":                  map[string]any{},\n553|\t\t}, nil\n554|\tdefault:\n555|\t\treturn CaptureBoundary{}, nil, invalid(\"capture boundary kind is outside stable|unstable_archive\")\n556|\t}\n557|}\n558|\n559|func buildStableProof(input BoundaryInput) (StableSnapshotProof, map[string]any, error) {\n560|\tif !validProofKind(input.ProofKind) {\n561|\t\treturn StableSnapshotProof{}, nil, invalid(\"stable snapshot proof kind is outside the closed proof vocabulary\")\n562|\t}\n563|\tgeneration, err := ParseGeneration(input.Generation)\n564|\tif err != nil {\n565|\t\treturn StableSnapshotProof{}, nil, err\n566|\t}\n567|\tvar identity *scalar.Digest\n568|\tif input.SnapshotIdentity != nil {\n569|\t\tvalue, err := scalar.ParseDigest(*input.SnapshotIdentity)\n570|\t\tif err != nil {\n571|\t\t\treturn StableSnapshotProof{}, nil, invalid(\"stable snapshot proof snapshot_identity_digest is not a digest: %v\", err)\n572|\t\t}\n573|\t\tidentity = &value\n574|\t}\n575|\tpre, err := scalar.ParseDigest(input.PreCaptureDigest)\n576|\tif err != nil {\n577|\t\treturn StableSnapshotProof{}, nil, invalid(\"stable snapshot proof pre_capture_digest is not a digest: %v\", err)\n578|\t}\n579|\tpost, err := scalar.ParseDigest(input.PostCaptureDigest)\n580|\tif err != nil {\n581|\t\treturn StableSnapshotProof{}, nil, invalid(\"stable snapshot proof post_capture_digest is not a digest: %v\", err)\n582|\t}\n583|\tproof := StableSnapshotProof{\n584|\t\tProofKind:         input.ProofKind,\n585|\t\tSourceGeneration:  generation,\n586|\t\tSnapshotIdentity:  identity,\n587|\t\tPreCaptureDigest:  pre,\n588|\t\tPostCaptureDigest: post,\n589|\t\tInputBlocked:      input.InputBlocked,\n590|\t\tForegroundIdle:    input.ForegroundIdle,\n591|\t\tBackgroundIdle:    input.BackgroundIdle,\n592|\t}\n593|\tif err := checkProofCoupling(proof); err != nil {\n594|\t\treturn StableSnapshotProof{}, nil, err\n595|\t}\n596|\tvar identityValue any\n597|\tif identity != nil {\n598|\t\tidentityValue = identity.String()\n599|\t}\n600|\treturn proof, map[string]any{\n601|\t\t\"proof_kind\":               proof.ProofKind,\n602|\t\t\"source_generation\":        generation.String(),\n603|\t\t\"snapshot_identity_digest\": identityValue,\n604|\t\t\"pre_capture_digest\":       pre.String(),\n605|\t\t\"post_capture_digest\":      post.String(),\n606|\t\t\"input_blocked\":            proof.InputBlocked,\n607|\t\t\"foreground_idle\":          proof.ForegroundIdle,\n608|\t\t\"background_idle\":          proof.BackgroundIdle,\n609|\t\t\"extensions\":               map[string]any{},\n610|\t}, nil\n611|}","final_result":true}}}
