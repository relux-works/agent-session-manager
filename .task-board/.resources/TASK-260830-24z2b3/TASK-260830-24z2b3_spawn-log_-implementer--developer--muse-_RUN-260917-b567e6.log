}\n41|\n42|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n43|\tfor name := range members {\n44|\t\tif !allowed[name] {\n45|\t\t\treturn name, true\n46|\t\t}\n47|\t}\n48|\treturn \"\", false\n49|}\n50|\n51|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n52|\tfor _, name := range required {\n53|\t\tif _, present := members[name]; !present {\n54|\t\t\treturn name, true\n55|\t\t}\n56|\t}\n57|\treturn \"\", false\n58|}\n59|\n60|func rawString(raw json.RawMessage) (string, bool) {\n61|\tvar value string\n62|\tif err := json.Unmarshal(raw, &value); err != nil {\n63|\t\treturn \"\", false\n64|\t}\n65|\treturn value, true\n66|}\n67|\n68|func rawBool(raw json.RawMessage) (bool, bool) {\n69|\tvar value bool\n70|\tif err := json.Unmarshal(raw, &value); err != nil {\n71|\t\treturn false, false\n72|\t}\n73|\treturn value, true\n74|}\n75|\n76|// checkUint53Bounds reports whether the member is a uint53 in the\n77|// inclusive bound. Both edges are checked: a one-sided check would\n78|// admit the open side. It delegates to the environ gate.\n79|func checkUint53Bounds(raw json.RawMessage, minimum, maximum uint64) (uint64, bool) {\n80|\treturn environ.CheckUint53Bounds(raw, minimum, maximum)\n81|}\n82|\n83|// stringLength is the Section 1.6 string measure in characters, not\n84|// bytes: a bound of string[1..512] admits 512 characters of any\n85|// width. It delegates to the single environ measure so the two can\n86|// never drift.\n87|func stringLength(value string) int {\n88|\treturn environ.StringLength(value)\n89|}\n90|\n91|// checkStringBounds reports whether the member is a JSON string whose\n92|// character count falls in the inclusive bound. It delegates to the\n93|// environ gate.\n94|func checkStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n95|\treturn environ.CheckStringBounds(raw, minimum, maximum)\n96|}\n97|\n98|// checkDigest reports whether the member is a digest of the pinned\n99|// sha256 form. It delegates to the environ gate.\n100|func checkDigest(raw json.RawMessage) (scalar.Digest, bool) {\n101|\treturn environ.CheckDigest(raw)\n102|}\n103|\n104|// checkUUIDv7 reports whether the member is a lowercase UUIDv7. It\n105|// delegates to the environ gate.\n106|func checkUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n107|\treturn environ.CheckUUIDv7(raw)\n108|}\n109|\n110|// checkTimestamp reports whether the member is a pinned timestamp.\n111|// It delegates to the environ gate.\n112|func checkTimestamp(raw json.RawMessage) (scalar.Timestamp, bool) {\n113|\treturn environ.CheckTimestamp(raw)\n114|}\n115|\n116|func bytesTrimSpace(raw json.RawMessage) json.RawMessage {\n117|\treturn json.RawMessage(bytes.TrimSpace(raw))\n118|}\n119|\n120|func isNull(raw json.RawMessage) bool {\n121|\ttrimmed := bytes.TrimSpace(raw)\n122|\treturn string(trimmed) == \"null\"\n123|}\n124|\n125|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n126|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n127|\ttoken, err := decoder.Token()\n128|\tif err != nil {\n129|\t\treturn nil, false\n130|\t}\n131|\tdelimiter, ok := token.(json.Delim)\n132|\tif !ok || delimiter != '[' {\n133|\t\treturn nil, false\n134|\t}\n135|\tvar elements []json.RawMessage\n136|\tfor decoder.More() {\n137|\t\tvar element json.RawMessage\n138|\t\tif err := decoder.Decode(&element); err != nil {\n139|\t\t\treturn nil, false\n140|\t\t}\n141|\t\telements = append(elements, element)\n142|\t}\n143|\ttoken, err = decoder.Token()\n144|\tif err != nil {\n145|\t\treturn nil, false\n146|\t}\n147|\tdelimiter, ok = token.(json.Delim)\n148|\tif !ok || delimiter != ']' {\n149|\t\treturn nil, false\n150|\t}\n151|\tif _, err := decoder.Token(); err != io.EOF {\n152|\t\treturn nil, false\n153|\t}\n154|\tif elements == nil {\n155|\t\telements = []json.RawMessage{}\n156|\t}\n157|\treturn elements, true\n158|}\n159|\n160|// checkSortedUniqueStrings reports whether the member is an array of\n161|// strings in the item bound whose JCS encodings order strictly\n162|// increasingly with no duplicates. It delegates to the environ gate.\n163|func checkSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n164|\treturn environ.CheckSortedUniqueStrings(raw, minimumLength, maximumLength, minimumCount, maximumCount)\n165|}\n166|\n167|// checkSortedUniqueDigests reports whether the member is a sorted\n168|// unique digest array in the count bound. It delegates to the\n169|// environ gate.\n170|func checkSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\n171|\treturn environ.CheckSortedUniqueDigests(raw, minimumCount, maximumCount)\n172|}\n173|\n174|// checkExtensions reports whether the member is an object whose keys\n175|// are all reverse-DNS names. It delegates to the environ gate. Key\n176|// admission alone is not the closed extensions rule for this\n177|// package: extension values flow into the omit-self identity, so\n178|// every admission site uses checkExtensionsClosed, which additionally\n179|// enforces the AX number model and nested duplicate refusal on the\n180|// values.\n181|func checkExtensions(raw json.RawMessage) bool {\n182|\treturn environ.CheckExtensions(raw)\n183|}\n184|\n185|// maxExtensionDepth mirrors the canonicaljson nesting bound: a\n186|// container nested deeper than this inside an extension value is\n187|// refused, exactly as the identity owner refuses it.\n188|const maxExtensionDepth = 256\n189|\n190|// checkExtensionsClosed enforces the full closed extensions rule:\n191|// reverse-DNS keys (via the environ owner) and values inside the AX\n192|// common logical data model (integer literals only, |n| <= 2^53-1,\n193|// no fraction or exponent, nested objects duplicate-free at every\n194|// depth). It returns nil when the member is closed, otherwise the\n195|// refusal detail naming the failed rule.\n196|func checkExtensionsClosed(raw json.RawMessage) error {\n197|\tif !checkExtensions(raw) {\n198|\t\treturn errExtensionsKeys\n199|\t}\n200|\treturn checkExtensionValues(raw)\n201|}\n202|\n203|var (\n204|\terrExtensionsKeys     = errorString(\"are not reverse-DNS keyed\")\n205|\terrExtensionNumber    = errorString(\"carry a number outside the AX safe-integer model\")\n206|\terrExtensionDuplicate = errorString(\"carry a duplicate nested member\")\n207|\terrExtensionShape     = errorString(\"are not a depth-bounded extension object\")\n208|)\n209|\n210|// errorString is one fixed refusal detail. Extension faults name the\n211|// failed rule; the deciding site names the owner.\n212|type errorString string\n213|\n214|func (detail errorString) Error() string { return string(detail) }\n215|\n216|// checkExtensionValues validates every value under the extensions\n217|// object against the AX number model with nested objects\n218|// duplicate-free. It mirrors the canonicaljson identity guarantee\n219|// (safe integers, no rounding, strict objects) which Canonicalize\n220|// alone does not carry, so no value that would round or collapse\n221|// under canonicalization is ever admitted into an omit-self\n222|// identity.\n223|func checkExtensionValues(raw json.RawMessage) error {\n224|\tdecoder := json.NewDecoder(bytes.NewReader(bytesTrimSpace(raw)))\n225|\tdecoder.UseNumber()\n226|\ttoken, err := decoder.Token()\n227|\tif err != nil {\n228|\t\treturn errExtensionShape\n229|\t}\n230|\tdelimiter, ok := token.(json.Delim)\n231|\tif !ok || delimiter != '{' {\n232|\t\treturn errExtensionShape\n233|\t}\n234|\tif err := checkExtensionMembers(decoder, 0); err != nil {\n235|\t\treturn err\n236|\t}\n237|\tif _, err := decoder.Token(); err != io.EOF {\n238|\t\treturn errExtensionShape\n239|\t}\n240|\treturn nil\n241|}\n242|\n243|// checkExtensionMembers validates the members of one open extension\n244|// object: names are duplicate-free and every value validates.\n245|func checkExtensionMembers(decoder *json.Decoder, depth int) error {\n246|\tif depth >= maxExtensionDepth {\n247|\t\treturn errExtensionShape\n248|\t}\n249|\tseen := map[string]bool{}\n250|\tfor decoder.More() {\n251|\t\tnameToken, err := decoder.Token()\n252|\t\tif err != nil {\n253|\t\t\treturn errExtensionShape\n254|\t\t}\n255|\t\tname, ok := nameToken.(string)\n256|\t\tif !ok {\n257|\t\t\treturn errExtensionShape\n258|\t\t}\n259|\t\tif seen[name] {\n260|\t\t\treturn errExtensionDuplicate\n261|\t\t}\n262|\t\tseen[name] = true\n263|\t\tif err := checkExtensionValue(decoder, depth+1); err != nil {\n264|\t\t\treturn err\n265|\t\t}\n266|\t}\n267|\tend, err := decoder.Token()\n268|\tif err != nil || end != json.Delim('}') {\n269|\t\treturn errExtensionShape\n270|\t}\n271|\treturn nil\n272|}\n273|\n274|// checkExtensionValue validates one extension value: containers\n275|// recurse (objects duplicate-free at every depth, arrays in order),\n276|// numbers obey the AX literal rule, and strings, booleans, and null\n277|// cross opaquely.\n278|func checkExtensionValue(decoder *json.Decoder, depth int) error {\n279|\ttoken, err := decoder.Token()\n280|\tif err != nil {\n281|\t\treturn errExtensionShape\n282|\t}\n283|\tswitch typed := token.(type) {\n284|\tcase json.Delim:\n285|\t\tswitch typed {\n286|\t\tcase '{':\n287|\t\t\treturn checkExtensionMembers(decoder, depth)\n288|\t\tcase '[':\n289|\t\t\tif depth >= maxExtensionDepth {\n290|\t\t\t\treturn errExtensionShape\n291|\t\t\t}\n292|\t\t\tfor decoder.More() {\n293|\t\t\t\tif err := checkExtensionValue(decoder, depth+1); err != nil {\n294|\t\t\t\t\treturn err\n295|\t\t\t\t}\n296|\t\t\t}\n297|\t\t\tend, err := decoder.Token()\n298|\t\t\tif err != nil || end != json.Delim(']') {\n299|\t\t\t\treturn errExtensionShape\n300|\t\t\t}\n301|\t\t\treturn nil\n302|\t\tdefault:\n303|\t\t\treturn errExtensionShape\n304|\t\t}\n305|\tcase json.Number:\n306|\t\tif !checkAXNumberLiteral(typed.String()) {\n307|\t\t\treturn errExtensionNumber\n308|\t\t}\n309|\t\treturn nil\n310|\tcase string, bool, nil:\n311|\t\treturn nil\n312|\tdefault:\n313|\t\treturn errExtensionShape\n314|\t}\n315|}\n316|\n317|// checkAXNumberLiteral mirrors the canonicaljson safe-integer rule:\n318|// a literal with a fraction or exponent is forbidden, and the\n319|// integer value must fall in [-2^53+1, 2^53-1]. The bound is checked\n320|// on the literal before any host conversion, so a value the host\n321|// would round is refused instead.\n322|func checkAXNumberLiteral(literal string) bool {\n323|\tif strings.ContainsAny(literal, \".eE\") {\n324|\t\treturn false\n325|\t}\n326|\tinteger, err := strconv.ParseInt(literal, 10, 64)\n327|\tif err != nil || integer < -maxSafeInteger || integer > maxSafeInteger {\n328|\t\treturn false\n329|\t}\n330|\treturn true\n331|}\n332|\n333|// canonicalizeObject renders one closed object deterministically: the\n334|// members marshal in any order and the JCS transform sorts them, so\n335|// identical logical inputs always produce identical bytes.\n336|func canonicalizeObject(object map[string]any) ([]byte, error) {\n337|\tplain, err := json.Marshal(object)\n338|\tif err != nil {\n339|\t\treturn nil, invalid(\"serialize clone bundle object: %v\", err)\n340|\t}\n341|\tcanonical, err := canonicaljson.Canonicalize(plain)\n342|\tif err != nil {\n343|\t\treturn nil, invalid(\"canonicalize clone bundle object: %v\", err)\n344|\t}\n345|\treturn canonical, nil\n346|}\n347|\n348|// omitSelfDigest computes the JCS SHA-256 identity of members with\n349|// only the self field omitted. It mirrors the canonicaljson\n350|// omit-self construction without routing through that package's\n351|// closed-shape registry, which refuses these schemas by design (see\n352|// doc.go).\n353|func omitSelfDigest(members map[string]json.RawMessage, selfField string) (scalar.Digest, error) {\n354|\tomitted := make(map[string]any, len(members))\n355|\tfor name, raw := range members {\n356|\t\tif name == selfField {\n357|\t\t\tcontinue\n358|\t\t}\n359|\t\tvar value any\n360|\t\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n361|\t\tdecoder.UseNumber()\n362|\t\tif err := decoder.Decode(&value); err != nil {\n363|\t\t\treturn scalar.Digest{}, invalid(\"identity input member %s is not JSON: %v\", name, err)\n364|\t\t}\n365|\t\tomitted[name] = value\n366|\t}\n367|\tplain, err := json.Marshal(omitted)\n368|\tif err != nil {\n369|\t\treturn scalar.Digest{}, invalid(\"serialize omit-self object: %v\", err)\n370|\t}\n371|\tcanonical, err := canonicaljson.Canonicalize(plain)\n372|\tif err != nil {\n373|\t\treturn scalar.Digest{}, invalid(\"canonicalize omit-self object: %v\", err)\n374|\t}\n375|\treturn scalar.SHA256Digest(canonical), nil\n376|}\n377|\n378|// verifySelfDigest recomputes the omit-self identity and refuses a\n379|// mismatch against the claimed self digest.\n380|func verifySelfDigest(members map[string]json.RawMessage, selfField string, claimed scalar.Digest) error {\n381|\tcalculated, err := omitSelfDigest(members, selfField)\n382|\tif err != nil {\n383|\t\treturn err\n384|\t}\n385|\tif calculated != claimed {\n386|\t\treturn invalid(\"%s claim %q does not match omit-self digest %q\", selfField, claimed.String(), calculated.String())\n387|\t}\n388|\treturn nil\n389|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
