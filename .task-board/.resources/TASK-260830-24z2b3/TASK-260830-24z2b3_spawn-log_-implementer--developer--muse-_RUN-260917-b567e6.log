{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7af","stream":{"kind":"session","id":"01a0b144-2d0b-7f30-96a3-e7fabafc632c"},"sequence":562,"recorded_at":1780531400001119,"record_type":"event","durability":"durable","causation_id":"96a3132b-8530-4e47-8657-36d15f2da569","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"96a3132b-8530-4e47-8657-36d15f2da569","run_stream":{"kind":"run","id":"96a3132b-8530-4e47-8657-36d15f2da569"},"task_stream":{"kind":"task","id":"01a0b145-bc48-7a33-a4e2-42a702219dcd"},"task_id":"01a0b145-bc48-7a33-a4e2-42a702219dcd","event":{"kind":"output","task_id":"01a0b145-bc48-7a33-a4e2-42a702219dcd","chunk":"Read text file `/tmp/rev3ev/site_plants.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Per-site narrowing of the extension VALUE gate (TASK-260830-24z2b3 rev3 review).\n3|\n4|At exactly one admission site, checkExtensionsClosed(...) is replaced by a\n5|keys-only check (reverse-DNS keys still enforced, AX number model and nested\n6|duplicate refusal dropped at that site only). The whole package suite runs as\n7|the killer. A SURVIVED site is a site whose value gate no committed test\n8|reaches. One raw log per plant with the subprocess exit code.\n9|\"\"\"\n10|import os, re, shutil, subprocess, sys, tempfile, time\n11|from pathlib import Path\n12|\n13|HERE = Path(__file__).resolve().parent\n14|TREE = HERE / sys.argv[1]\n15|LOGDIR = HERE / \"logs\" / \"mutants\"\n16|LOGDIR.mkdir(parents=True, exist_ok=True)\n17|PKG = TREE / \"internal/clonebundle\"\n18|HELPER = '''\n19|\n20|// reviewer plant: keys-only extension check (value model dropped)\n21|func checkExtensionsKeysOnly(raw json.RawMessage) error {\n22|\tif !checkExtensions(raw) {\n23|\t\treturn errExtensionsKeys\n24|\t}\n25|\treturn nil\n26|}\n27|'''\n28|sites = []\n29|for go in sorted(PKG.glob(\"*.go\")):\n30|    if go.name.endswith(\"_test.go\"):\n31|        continue\n32|    for i, line in enumerate(go.read_text().splitlines(), 1):\n33|        if \"checkExtensionsClosed(\" in line and \"func checkExtensionsClosed\" not in line:\n34|            sites.append((go.name, i, line.strip()))\n35|print(f\"# sites={len(sites)}\")\n36|repeats = int(sys.argv[2]) if len(sys.argv) > 2 else 1\n37|results = []\n38|for name, lineno, text in sites:\n39|    target = PKG / name\n40|    decode = PKG / \"decode.go\"\n41|    orig_target = target.read_text()\n42|    orig_decode = decode.read_text()\n43|    verdicts = []\n44|    for run in range(1, repeats + 1):\n45|        with tempfile.TemporaryDirectory() as staging:\n46|            b1 = Path(staging) / \"t\"; b2 = Path(staging) / \"d\"\n47|            shutil.copy2(target, b1); shutil.copy2(decode, b2)\n48|            try:\n49|                lines = orig_target.splitlines(keepends=True)\n50|                assert \"checkExtensionsClosed(\" in lines[lineno - 1]\n51|                lines[lineno - 1] = lines[lineno - 1].replace(\"checkExtensionsClosed(\", \"checkExtensionsKeysOnly(\", 1)\n52|                target.write_text(\"\".join(lines))\n53|                decode.write_text((target.read_text() if name == \"decode.go\" else orig_decode) + HELPER)\n54|                started = time.time()\n55|                proc = subprocess.run([\"go\", \"test\", \"./internal/clonebundle/\", \"-run\", \"Test\", \"-count=1\"],\n56|                                      cwd=TREE, capture_output=True, text=True, timeout=600,\n57|                                      env={**os.environ, \"PYTHONDONTWRITEBYTECODE\": \"1\"})\n58|                elapsed = time.time() - started\n59|            finally:\n60|                shutil.copy2(b1, target); shutil.copy2(b2, decode)\n61|        assert target.read_text() == orig_target and decode.read_text() == orig_decode, \"restore failed\"\n62|        out = proc.stdout + proc.stderr\n63|        if \"build failed\" in out or \"\\n# \" in out or out.startswith(\"# \"):\n64|            v = \"COMPILE_FAIL\"\n65|        elif proc.returncode == 0:\n66|            v = \"SURVIVED\"\n67|        elif \"--- FAIL\" in out or \"FAIL:\" in out:\n68|            v = \"KILLED\"\n69|        else:\n70|            v = f\"ERROR(exit {proc.returncode})\"\n71|        log = LOGDIR / f\"S-ext-values-{name}-{lineno}-run{run}.log\"\n72|        log.write_text(f\"# site={name}:{lineno} run={run} -run=Test\\n# exit={proc.returncode} elapsed={elapsed:.1f}s\\n# line={text}\\n# plant: checkExtensionsClosed -> checkExtensionsKeysOnly at this site only\\n---\\n{out}\")\n73|        verdicts.append(v)\n74|        print(f\"S-ext-values {name}:{lineno:<4} run{run} {v:12s} {text[:70]}\", flush=True)\n75|    results.append((name, lineno, verdicts))\n76|print(\"# summary\")\n77|for name, lineno, verdicts in results:\n78|    print(f\"{name}:{lineno} {'/'.join(verdicts)}\")","final_result":true}}}
