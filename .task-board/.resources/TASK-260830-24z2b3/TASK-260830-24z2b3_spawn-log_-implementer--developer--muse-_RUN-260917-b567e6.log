{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d09f","stream":{"kind":"session","id":"01a0b144-2d0b-7f30-96a3-e7fabafc632c"},"sequence":1706,"recorded_at":1780531400003407,"record_type":"event","durability":"durable","causation_id":"96a3132b-8530-4e47-8657-36d15f2da569","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"96a3132b-8530-4e47-8657-36d15f2da569","run_stream":{"kind":"run","id":"96a3132b-8530-4e47-8657-36d15f2da569"},"task_stream":{"kind":"task","id":"01a0b153-0e18-7ad1-bd24-d1b5bb9c183a"},"task_id":"01a0b153-0e18-7ad1-bd24-d1b5bb9c183a","event":{"kind":"output","task_id":"01a0b153-0e18-7ad1-bd24-d1b5bb9c183a","chunk":"Read text file `internal/clonebundle/blobref.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"io\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/localstore\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// This file owns the Section 10.2 raw evidence descriptor path: Blob\n13|// Descriptor identity and byte-count agreement, and no-replace blob\n14|// installation through the landed localstore durable-write\n15|// discipline. This package performs no durable write itself: every\n16|// byte crosses localstore.ObjectStore.PutBlob, whose no-replace,\n17|// fsync, and crash/idempotency evidence is cited in TRACEABILITY.md.\n18|\n19|// BlobAgreement is the verified agreement between a manifest entry\n20|// and its Section 10.2 Blob Descriptor.\n21|type BlobAgreement struct {\n22|\tDescriptorID scalar.Digest\n23|\tBlobID       scalar.Digest\n24|\tSize         uint64\n25|}\n26|\n27|// VerifyDescriptorAgreement verifies one raw evidence descriptor:\n28|// the bytes must be a closed valid Blob Descriptor 1.0.0 whose\n29|// claimed identity equals the computed omit-self digest, the\n30|// computed identity must equal the manifest entry's\n31|// blob_descriptor_id claim, and the descriptor's blob ID and size\n32|// must agree with the entry's claim. The identity link is what\n33|// binds the entry to the exact descriptor bytes verified: without\n34|// it any descriptor with an agreeing blob ID and size would satisfy\n35|// the entry. Shape validation and digest computation run through\n36|// the canonicaljson owner, never a fork; the claim comparisons are\n37|// local, because binding attestation outside the session leaf is\n38|// refused by the provhost no-attestation bound, so this package\n39|// never calls the attesting entry.\n40|func VerifyDescriptorAgreement(descriptor []byte, wantDescriptorID, wantBlobID scalar.Digest, wantSize uint64) error {\n41|\tcalculated, claimed, members, err := calculateDescriptorIdentity(descriptor)\n42|\tif err != nil {\n43|\t\treturn err\n44|\t}\n45|\tif calculated != claimed {\n46|\t\treturn invalid(\"blob descriptor claim %q does not match omit-self digest %q\", claimed.String(), calculated.String())\n47|\t}\n48|\tif calculated != wantDescriptorID {\n49|\t\treturn invalid(\"blob descriptor identity %q disagrees with entry claim %q\", calculated.String(), wantDescriptorID.String())\n50|\t}\n51|\tblobID, ok := checkDigest(members[\"blob_id\"])\n52|\tif !ok {\n53|\t\treturn invalid(\"blob descriptor blob_id is not a digest\")\n54|\t}\n55|\tif blobID != wantBlobID {\n56|\t\treturn invalid(\"blob descriptor blob_id %q disagrees with entry claim %q\", blobID.String(), wantBlobID.String())\n57|\t}\n58|\tsize, ok := checkUint53Bounds(members[\"size\"], 0, maxUint53)\n59|\tif !ok {\n60|\t\treturn invalid(\"blob descriptor size is not a uint53\")\n61|\t}\n62|\tif size != wantSize {\n63|\t\treturn invalid(\"blob descriptor size %d disagrees with entry claim %d\", size, wantSize)\n64|\t}\n65|\treturn nil\n66|}\n67|\n68|// InstallRawBlob installs one raw evidence blob through the landed\n69|// durable-write discipline: fsync, size/digest verification, and\n70|// atomic no-replace install owned by localstore. It returns the\n71|// verified agreement. A digest collision or same-ID/different-bytes\n72|// observation quarantines through the store owner; this package\n73|// adds no second write path.\n74|func InstallRawBlob(store *localstore.ObjectStore, descriptor []byte, source io.Reader) (BlobAgreement, error) {\n75|\tcalculated, claimed, members, err := calculateDescriptorIdentity(descriptor)\n76|\tif err != nil {\n77|\t\treturn BlobAgreement{}, err\n78|\t}\n79|\tif calculated != claimed {\n80|\t\treturn BlobAgreement{}, invalid(\"blob descriptor claim %q does not match omit-self digest %q\", claimed.String(), calculated.String())\n81|\t}\n82|\tblobID, ok := checkDigest(members[\"blob_id\"])\n83|\tif !ok {\n84|\t\treturn BlobAgreement{}, invalid(\"blob descriptor blob_id is not a digest\")\n85|\t}\n86|\tsize, ok := checkUint53Bounds(members[\"size\"], 0, maxUint53)\n87|\tif !ok {\n88|\t\treturn BlobAgreement{}, invalid(\"blob descriptor size is not a uint53\")\n89|\t}\n90|\tif store == nil {\n91|\t\treturn BlobAgreement{}, invalid(\"blob install requires an object store\")\n92|\t}\n93|\tif _, err := store.PutBlob(blobID, size, source); err != nil {\n94|\t\treturn BlobAgreement{}, invalid(\"blob install refused: %v\", err)\n95|\t}\n96|\treturn BlobAgreement{DescriptorID: calculated, BlobID: blobID, Size: size}, nil\n97|}\n98|\n99|// calculateDescriptorIdentity runs the owner's shape validation and\n100|// omit-self computation over one descriptor and reads its claimed\n101|// self digest. Callers compare the two; this helper never attests.\n102|func calculateDescriptorIdentity(descriptor []byte) (scalar.Digest, scalar.Digest, map[string]json.RawMessage, error) {\n103|\tcalculated, field, err := canonicaljson.CalculateObjectIdentity(descriptor)\n104|\tif err != nil {\n105|\t\treturn scalar.Digest{}, scalar.Digest{}, nil, invalid(\"blob descriptor identity fails: %v\", err)\n106|\t}\n107|\tif field != \"descriptor_id\" {\n108|\t\treturn scalar.Digest{}, scalar.Digest{}, nil, invalid(\"blob descriptor self field is %q, want descriptor_id\", string(field))\n109|\t}\n110|\tvar members map[string]json.RawMessage\n111|\tif err := json.Unmarshal(descriptor, &members); err != nil {\n112|\t\treturn scalar.Digest{}, scalar.Digest{}, nil, invalid(\"blob descriptor is not an object: %v\", err)\n113|\t}\n114|\tclaimed, ok := checkDigest(members[\"descriptor_id\"])\n115|\tif !ok {\n116|\t\treturn scalar.Digest{}, scalar.Digest{}, nil, invalid(\"blob descriptor descriptor_id is not a digest\")\n117|\t}\n118|\treturn calculated, claimed, members, nil\n119|}","final_result":true}}}
