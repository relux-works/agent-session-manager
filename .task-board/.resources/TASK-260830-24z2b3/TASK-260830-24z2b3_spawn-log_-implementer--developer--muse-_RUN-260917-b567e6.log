{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cbb7","stream":{"kind":"session","id":"01a0b144-2d0b-7f30-96a3-e7fabafc632c"},"sequence":1078,"recorded_at":1780531400002151,"record_type":"event","durability":"durable","causation_id":"96a3132b-8530-4e47-8657-36d15f2da569","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"96a3132b-8530-4e47-8657-36d15f2da569","run_stream":{"kind":"run","id":"96a3132b-8530-4e47-8657-36d15f2da569"},"task_stream":{"kind":"task","id":"01a0b149-dd01-7ff3-89df-1c251c5254ff"},"task_id":"01a0b149-dd01-7ff3-89df-1c251c5254ff","event":{"kind":"output","task_id":"01a0b149-dd01-7ff3-89df-1c251c5254ff","chunk":"Read text file `internal/clonebundle/refusal_test.go`.\n(149 line(s) above)\n150|\t\t\t}, \"omit-self digest\"},\n151|\t\t\t{\"not an object\", func(t *testing.T) []byte { return []byte(`[1,2]`) }, \"\"},\n152|\t\t\t{\"duplicate member\", func(t *testing.T) []byte {\n153|\t\t\t\treturn []byte(`{\"schema\":\"urn:ax:schema:clone-raw-object-manifest\",\"schema\":\"urn:ax:schema:blob\"}`)\n154|\t\t\t}, \"\"},\n155|\t\t}\n156|\t\tfor _, tc := range cases {\n157|\t\t\tt.Run(tc.name, func(t *testing.T) {\n158|\t\t\t\t_, err := DecodeRawObjectManifest(tc.body(t))\n159|\t\t\t\trequireRefusal(t, err, tc.fragment)\n160|\t\t\t})\n161|\t\t}\n162|\t})\n163|\tt.Run(\"extension values\", func(t *testing.T) {\n164|\t\tbuild := func(extensions map[string]any) error {\n165|\t\t\t_, err := BuildRawObjectManifest(fixtureOperationID, []byte(fixtureTupleJSON()),\n166|\t\t\t\t\"native-session-alpha\", identityDigest.String(), fixtureDigest(\"test-capture-plan\"), validEntryInputs(t), extensions)\n167|\t\t\treturn err\n168|\t\t}\n169|\t\tcases := []struct {\n170|\t\t\tname       string\n171|\t\t\textensions map[string]any\n172|\t\t\tfragment   string\n173|\t\t}{\n174|\t\t\t{\"float refused\", map[string]any{\"com.example.f\": 1.5}, \"safe-integer\"},\n175|\t\t\t{\"exactly 2^53 refused\", map[string]any{\"com.example.n\": uint64(1) << 53}, \"safe-integer\"},\n176|\t\t\t{\"2^60 refused\", map[string]any{\"com.example.big\": uint64(1) << 60}, \"safe-integer\"},\n177|\t\t\t{\"exponent refused\", map[string]any{\"com.example.e\": 1e21}, \"safe-integer\"},\n178|\t\t\t{\"nested float refused\", map[string]any{\"com.example.o\": map[string]any{\"n\": 0.5}}, \"safe-integer\"},\n179|\t\t\t{\"nested unsafe refused\", map[string]any{\"com.example.a\": []any{uint64(1) << 53}}, \"safe-integer\"},\n180|\t\t}\n181|\t\tfor _, tc := range cases {\n182|\t\t\tt.Run(tc.name, func(t *testing.T) {\n183|\t\t\t\trequireRefusal(t, build(tc.extensions), tc.fragment)\n184|\t\t\t})\n185|\t\t}\n186|\t\t// Safe integers (edges included), nested objects, and arrays admit.\n187|\t\tadmitted := map[string]any{\n188|\t\t\t\"com.example.max\":  uint64(9007199254740991),\n189|\t\t\t\"com.example.min\":  int64(-9007199254740991),\n190|\t\t\t\"com.example.zero\": 0,\n191|\t\t\t\"com.example.o\":    map[string]any{\"s\": \"x\", \"b\": true, \"n\": nil, \"a\": []any{1, \"two\"}},\n192|\t\t}\n193|\t\tif err := build(admitted); err != nil {\n194|\t\t\tt.Fatalf(\"BuildRawObjectManifest(safe extensions) error = %v\", err)\n195|\t\t}\n196|\t\t// Decode refuses unsafe literals and nested duplicates without resealing.\n197|\t\tvalid := mustRawBytes(t)\n198|\t\tfor _, tc := range []struct {\n199|\t\t\tname     string\n200|\t\t\tbody     string\n201|\t\t\tfragment string\n202|\t\t}{\n203|\t\t\t{\"decode float\", `\"extensions\":{\"com.example.n\":1.5}`, \"safe-integer\"},\n204|\t\t\t{\"decode 2^53\", `\"extensions\":{\"com.example.n\":9007199254740992}`, \"safe-integer\"},\n205|\t\t\t{\"decode 2^53 plus one\", `\"extensions\":{\"com.example.n\":9007199254740993}`, \"safe-integer\"},\n206|\t\t\t{\"decode exponent\", `\"extensions\":{\"com.example.n\":1e2}`, \"safe-integer\"},\n207|\t\t\t{\"decode nested duplicate\", `\"extensions\":{\"com.example.x\":{\"a\":1,\"a\":2}}`, \"duplicate nested member\"},\n208|\t\t} {\n209|\t\t\tt.Run(tc.name, func(t *testing.T) {\n210|\t\t\t\tbody := strings.Replace(string(valid), `\"extensions\":{}`, tc.body, 1)\n211|\t\t\t\t_, err := DecodeRawObjectManifest([]byte(body))\n212|\t\t\t\trequireRefusal(t, err, tc.fragment)\n213|\t\t\t})\n214|\t\t}\n215|\t\t// A nested duplicate resealed over the collapsed form is still\n216|\t\t// refused: the value gate fires before the identity check, so no\n217|\t\t// reseal can smuggle the collapsed bytes past decoding. The\n218|\t\t// resealed bytes keep the duplicate text with the collapsed\n219|\t\t// form's digest, which decoding would verify without the gate.\n220|\t\tcollapsed := strings.Replace(string(valid), `\"extensions\":{}`, `\"extensions\":{\"com.example.x\":{\"a\":1,\"a\":2}}`, 1)\n221|\t\tmembers, fault := decodeStrictObject([]byte(collapsed))\n222|\t\tif fault != nil {\n223|\t\t\tt.Fatalf(\"decodeStrictObject() fault = %+v\", fault)\n224|\t\t}\n225|\t\tsealed, err := omitSelfDigest(members, rawManifestSelf)\n226|\t\tif err != nil {\n227|\t\t\tt.Fatalf(\"omitSelfDigest() error = %v\", err)\n228|\t\t}\n229|\t\tvar original map[string]any\n230|\t\tif err := json.Unmarshal(valid, &original); err != nil {\n231|\t\t\tt.Fatal(err)\n232|\t\t}\n233|\t\toriginalID, ok := original[rawManifestSelf].(string)\n234|\t\tif !ok {\n235|\t\t\tt.Fatal(\"sealed manifest carries no string self id\")\n236|\t\t}\n237|\t\tresealed := strings.Replace(collapsed, originalID, sealed.String(), 1)\n238|\t\t_, err = DecodeRawObjectManifest([]byte(resealed))\n239|\t\trequireRefusal(t, err, \"duplicate nested member\")\n240|\t})\n241|\tt.Run(\"operation and tuple\", func(t *testing.T) {\n242|\t\tinputs := validEntryInputs(t)\n243|\t\tif _, err := BuildRawObjectManifest(\"not-a-uuid\", []byte(fixtureTupleJSON()),\n244|\t\t\t\"native-session-alpha\", identityDigest.String(), fixtureDigest(\"test-capture-plan\"), inputs, nil); !errors.Is(err, ErrInvalid) {\n245|\t\t\tt.Fatalf(\"bad operation_id error = %v, want ErrInvalid\", err)\n246|\t\t}\n247|\t\tif _, err := BuildRawObjectManifest(fixtureOperationID, []byte(`{\"environment_id\":\"x\"}`),\n248|\t\t\t\"native-session-alpha\", identityDigest.String(), fixtureDigest(\"test-capture-plan\"), inputs, nil); !errors.Is(err, ErrInvalid) {\n249|\t\t\tt.Fatalf(\"bad tuple error = %v, want ErrInvalid\", err)\n250|\t\t}\n251|\t\tif _, err := BuildRawObjectManifest(fixtureOperationID, []byte(fixtureTupleJSON()),\n252|\t\t\t\"native-session-alpha\", \"nope\", fixtureDigest(\"test-capture-plan\"), inputs, nil); !errors.Is(err, ErrInvalid) {\n253|\t\t\tt.Fatalf(\"bad identity digest error = %v, want ErrInvalid\", err)\n254|\t\t}\n255|\t\tif _, err := BuildRawObjectManifest(fixtureOperationID, []byte(fixtureTupleJSON()),\n256|\t\t\t\"native-session-alpha\", identityDigest.String(), fixtureDigest(\"test-capture-plan\"), inputs,\n257|\t\t\tmap[string]any{\"no-dots\": 1}); !errors.Is(err, ErrInvalid) {\n258|\t\t\tt.Fatalf(\"bad extensions error = %v, want ErrInvalid\", err)\n259|\t\t}\n260|\t})\n261|}\n262|\n263|func cloneMutate(inputs []EntryInput, mutate func([]EntryInput) []EntryInput) []EntryInput {\n264|\treturn mutate(inputs)\n265|}\n266|\n267|// TestMultibyteStringMeasure pins the Section 1.6 string measure in\n268|// characters, not bytes: a 300-character / 600-byte native key is\n269|// inside string[1..512] and admits, the 512-character edge admits,\n(more lines below)","final_result":true}}}
