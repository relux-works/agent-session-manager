, err)\n578|\t}\n579|\tpost, err := scalar.ParseDigest(input.PostCaptureDigest)\n580|\tif err != nil {\n581|\t\treturn StableSnapshotProof{}, nil, invalid(\"stable snapshot proof post_capture_digest is not a digest: %v\", err)\n582|\t}\n583|\tproof := StableSnapshotProof{\n584|\t\tProofKind:         input.ProofKind,\n585|\t\tSourceGeneration:  generation,\n586|\t\tSnapshotIdentity:  identity,\n587|\t\tPreCaptureDigest:  pre,\n588|\t\tPostCaptureDigest: post,\n589|\t\tInputBlocked:      input.InputBlocked,\n590|\t\tForegroundIdle:    input.ForegroundIdle,\n591|\t\tBackgroundIdle:    input.BackgroundIdle,\n592|\t}\n593|\tif err := checkProofCoupling(proof); err != nil {\n594|\t\treturn StableSnapshotProof{}, nil, err\n595|\t}\n596|\tvar identityValue any\n597|\tif identity != nil {\n598|\t\tidentityValue = identity.String()\n599|\t}\n600|\treturn proof, map[string]any{\n601|\t\t\"proof_kind\":               proof.ProofKind,\n602|\t\t\"source_generation\":        generation.String(),\n603|\t\t\"snapshot_identity_digest\": identityValue,\n604|\t\t\"pre_capture_digest\":       pre.String(),\n605|\t\t\"post_capture_digest\":      post.String(),\n606|\t\t\"input_blocked\":            proof.InputBlocked,\n607|\t\t\"foreground_idle\":          proof.ForegroundIdle,\n608|\t\t\"background_idle\":          proof.BackgroundIdle,\n609|\t\t\"extensions\":               map[string]any{},\n610|\t}, nil\n611|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc85","stream":{"kind":"session","id":"01a0b144-2d0b-7f30-96a3-e7fabafc632c"},"sequence":1181,"recorded_at":1780531400002357,"record_type":"event","durability":"durable","causation_id":"96a3132b-8530-4e47-8657-36d15f2da569","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"96a3132b-8530-4e47-8657-36d15f2da569","run_stream":{"kind":"run","id":"96a3132b-8530-4e47-8657-36d15f2da569"},"call_id":"call_01a0b14a1aa1730689d4b36cb68bdf34","text":"Read text file `internal/clonebundle/identity.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"strings\"\n6|\t\"unicode\"\n7|\t\"unicode/utf8\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// This file validates the Section 13.14.1 identities: NativeIdentity,\n13|// WorkspaceBinding, and the sanitized native-key admission shared by\n14|// every native key in this package. Sanitized means printable,\n15|// relative, and unambiguously native: never an absolute source path,\n16|// never an AX Session identity, never carrying embedded credentials.\n17|\n18|var nativeIdentityMembers = map[string]bool{\n19|\t\"native_session_id\":         true,\n20|\t\"identity_kind\":             true,\n21|\t\"logical_workspace_id\":      true,\n22|\t\"backend_realm_fingerprint\": true,\n23|\t\"opaque_identity\":           true,\n24|\t\"extensions\":                true,\n25|}\n26|\n27|var nativeIdentityRequired = []string{\n28|\t\"native_session_id\",\n29|\t\"identity_kind\",\n30|\t\"logical_workspace_id\",\n31|\t\"backend_realm_fingerprint\",\n32|\t\"opaque_identity\",\n33|\t\"extensions\",\n34|}\n35|\n36|var nativeIdentityKinds = []string{\n37|\t\"provider_native\",\n38|\t\"official_import\",\n39|\t\"continuation_context\",\n40|}\n41|\n42|func validNativeIdentityKind(kind string) bool {\n43|\tfor _, allowed := range nativeIdentityKinds {\n44|\t\tif kind == allowed {\n45|\t\t\treturn true\n46|\t\t}\n47|\t}\n48|\treturn false\n49|}\n50|\n51|// NativeIdentity is one validated sanitized native identity.\n52|type NativeIdentity struct {\n53|\tNativeSessionID         string\n54|\tIdentityKind            string\n55|\tLogicalWorkspaceID      scalar.UUIDv7\n56|\tBackendRealmFingerprint *scalar.Digest\n57|\tOpaqueIdentity          *string\n58|}\n59|\n60|// DecodeNativeIdentity validates one closed NativeIdentity: exact\n61|// members, the closed identity-kind vocabulary, a sanitized native\n62|// session ID, a UUIDv7 logical workspace, an optional digest realm\n63|// fingerprint, an optional sanitized opaque identity, and\n64|// reverse-DNS extensions. Credential, absolute-path, PID, socket,\n65|// token, and secret-environment material is refused by the shared\n66|// sanitizer, never laundered into an identity.\n67|func DecodeNativeIdentity(raw json.RawMessage) (NativeIdentity, error) {\n68|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n69|\tif fault != nil {\n70|\t\treturn NativeIdentity{}, invalid(\"native identity %s (%s)\", fault.detail, memberField(fault.member))\n71|\t}\n72|\tif name, unknown := unknownMember(members, nativeIdentityMembers); unknown {\n73|\t\treturn NativeIdentity{}, invalid(\"native identity carries unknown member %q\", name)\n74|\t}\n75|\tif name, missing := missingMember(members, nativeIdentityRequired); missing {\n76|\t\treturn NativeIdentity{}, invalid(\"native identity misses a required member %q\", name)\n77|\t}\n78|\tnativeID, ok := checkStringBounds(members[\"native_session_id\"], 1, 512)\n79|\tif !ok {\n80|\t\treturn NativeIdentity{}, invalid(\"native identity native_session_id is not a string[1..512]\")\n81|\t}\n82|\tif err := SanitizeNativeKey(nativeID); err != nil {\n83|\t\treturn NativeIdentity{}, err\n84|\t}\n85|\tkind, ok := rawString(members[\"identity_kind\"])\n86|\tif !ok || !validNativeIdentityKind(kind) {\n87|\t\treturn NativeIdentity{}, invalid(\"native identity kind is outside provider_native|official_import|continuation_context\")\n88|\t}\n89|\tworkspaceID, ok := checkUUIDv7(members[\"logical_workspace_id\"])\n90|\tif !ok {\n91|\t\treturn NativeIdentity{}, invalid(\"native identity logical_workspace_id is not a UUIDv7\")\n92|\t}\n93|\tvar fingerprint *scalar.Digest\n94|\tif !isNull(members[\"backend_realm_fingerprint\"]) {\n95|\t\tdigest, ok := checkDigest(members[\"backend_realm_fingerprint\"])\n96|\t\tif !ok {\n97|\t\t\treturn NativeIdentity{}, invalid(\"native identity backend_realm_fingerprint is not a digest\")\n98|\t\t}\n99|\t\tfingerprint = &digest\n100|\t}\n101|\tvar opaque *string\n102|\tif !isNull(members[\"opaque_identity\"]) {\n103|\t\tvalue, ok := checkStringBounds(members[\"opaque_identity\"], 1, 512)\n104|\t\tif !ok {\n105|\t\t\treturn NativeIdentity{}, invalid(\"native identity opaque_identity is not a string[1..512]\")\n106|\t\t}\n107|\t\tif err := SanitizeNativeKey(value); err != nil {\n108|\t\t\treturn NativeIdentity{}, err\n109|\t\t}\n110|\t\topaque = &value\n111|\t}\n112|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n113|\t\treturn NativeIdentity{}, invalid(\"native identity extensions %s\", extensionsFault)\n114|\t}\n115|\treturn NativeIdentity{\n116|\t\tNativeSessionID:         nativeID,\n117|\t\tIdentityKind:            kind,\n118|\t\tLogicalWorkspaceID:      workspaceID,\n119|\t\tBackendRealmFingerprint: fingerprint,\n120|\t\tOpaqueIdentity:          opaque,\n121|\t}, nil\n122|}\n123|\n124|// EncodeNativeIdentity renders one validated identity as canonical\n125|// bytes under the given already-validated extensions. The identity\n126|// must already be decoded; encoding never admits what decoding\n127|// refused. A nil extensions map encodes as the empty object.\n128|func EncodeNativeIdentity(identity NativeIdentity, extensions map[string]any) ([]byte, error) {\n129|\tvar fingerprint any\n130|\tif identity.BackendRealmFingerprint != nil {\n131|\t\tfingerprint = identity.BackendRealmFingerprint.String()\n132|\t}\n133|\tvar opaque any\n134|\tif identity.OpaqueIdentity != nil {\n135|\t\topaque = *identity.OpaqueIdentity\n136|\t}\n137|\tif extensions == nil {\n138|\t\textensions = map[string]any{}\n139|\t}\n140|\treturn canonicalizeObject(map[string]any{\n141|\t\t\"native_session_id\":         identity.NativeSessionID,\n142|\t\t\"identity_kind\":             identity.IdentityKind,\n143|\t\t\"logical_workspace_id\":      identity.LogicalWorkspaceID.String(),\n144|\t\t\"backend_realm_fingerprint\": fingerprint,\n145|\t\t\"opaque_identity\":           opaque,\n146|\t\t\"extensions\":                extensions,\n147|\t})\n148|}\n149|\n150|var workspaceBindingMembers = map[string]bool{\n151|\t\"logical_workspace_id\":           true,\n152|\t\"cwd_relative\":                   true,\n153|\t\"repository_remote_fingerprints\": true,\n154|\t\"branch\":                         true,\n155|\t\"head_digest\":                    true,\n156|\t\"index_digest\":                   true,\n157|\t\"working_tree_digest\":            true,\n158|\t\"extensions\":                     true,\n159|}\n160|\n161|var workspaceBindingRequired = []string{\n162|\t\"logical_workspace_id\",\n163|\t\"cwd_relative\",\n164|\t\"repository_remote_fingerprints\",\n165|\t\"branch\",\n166|\t\"head_digest\",\n167|\t\"index_digest\",\n168|\t\"working_tree_digest\",\n169|\t\"extensions\",\n170|}\n171|\n172|// WorkspaceBinding is one validated closed workspace binding. No\n173|// member grants filesystem authority: the cwd is a normalized\n174|// relative path beneath the Workspace Group root, never an absolute\n175|// path or an escape.\n176|type WorkspaceBinding struct {\n177|\tLogicalWorkspaceID scalar.UUIDv7\n178|\tCwdRelative        string\n179|\tRemoteFingerprints []scalar.Digest\n180|\tBranch             *string\n181|\tHeadDigest         *scalar.Digest\n182|\tIndexDigest        *scalar.Digest\n183|\tWorkingTreeDigest  *scalar.Digest\n184|}\n185|\n186|// DecodeWorkspaceBinding validates one closed WorkspaceBinding.\n187|func DecodeWorkspaceBinding(raw json.RawMessage) (WorkspaceBinding, error) {\n188|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n189|\tif fault != nil {\n190|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding %s (%s)\", fault.detail, memberField(fault.member))\n191|\t}\n192|\tif name, unknown := unknownMember(members, workspaceBindingMembers); unknown {\n193|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding carries unknown member %q\", name)\n194|\t}\n195|\tif name, missing := missingMember(members, workspaceBindingRequired); missing {\n196|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding misses a required member %q\", name)\n197|\t}\n198|\tworkspaceID, ok := checkUUIDv7(members[\"logical_workspace_id\"])\n199|\tif !ok {\n200|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding logical_workspace_id is not a UUIDv7\")\n201|\t}\n202|\tcwd, ok := checkStringBounds(members[\"cwd_relative\"], 1, 4096)\n203|\tif !ok {\n204|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding cwd_relative is not a string[1..4096]\")\n205|\t}\n206|\tif err := checkCwdRelative(cwd); err != nil {\n207|\t\treturn WorkspaceBinding{}, err\n208|\t}\n209|\tfingerprints, ok := checkSortedUniqueDigests(members[\"repository_remote_fingerprints\"], 0, 128)\n210|\tif !ok {\n211|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding repository_remote_fingerprints are not sorted unique digest[0..128]\")\n212|\t}\n213|\tvar branch *string\n214|\tif !isNull(members[\"branch\"]) {\n215|\t\tvalue, ok := checkStringBounds(members[\"branch\"], 1, 1024)\n216|\t\tif !ok {\n217|\t\t\treturn WorkspaceBinding{}, invalid(\"workspace binding branch is not a string[1..1024]\")\n218|\t\t}\n219|\t\tbranch = &value\n220|\t}\n221|\thead, err := checkNullableDigest(members, \"head_digest\", \"workspace binding\")\n222|\tif err != nil {\n223|\t\treturn WorkspaceBinding{}, err\n224|\t}\n225|\tindex, err := checkNullableDigest(members, \"index_digest\", \"workspace binding\")\n226|\tif err != nil {\n227|\t\treturn WorkspaceBinding{}, err\n228|\t}\n229|\ttree, err := checkNullableDigest(members, \"working_tree_digest\", \"workspace binding\")\n230|\tif err != nil {\n231|\t\treturn WorkspaceBinding{}, err\n232|\t}\n233|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n234|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding extensions %s\", extensionsFault)\n235|\t}\n236|\treturn WorkspaceBinding{\n237|\t\tLogicalWorkspaceID: workspaceID,\n238|\t\tCwdRelative:        cwd,\n239|\t\tRemoteFingerprints: fingerprints,\n240|\t\tBranch:             branch,\n241|\t\tHeadDigest:         head,\n242|\t\tIndexDigest:        index,\n243|\t\tWorkingTreeDigest:  tree,\n244|\t}, nil\n245|}\n246|\n247|// checkCwdRelative admits exactly the normalized relative paths\n248|// beneath (or equal to) the Workspace Group root: scalar relative\n249|// paths plus the root itself (\".\"). Anything else — absolute,\n250|// escaped, backslashed, encoded-separator, or dot-segment forms —\n251|// would grant or smuggle filesystem authority and is refused.\n252|func checkCwdRelative(cwd string) error {\n253|\tif cwd == \".\" {\n254|\t\treturn nil\n255|\t}\n256|\tif _, err := scalar.ParseRelativePath(cwd); err != nil {\n257|\t\treturn invalid(\"workspace binding cwd_relative is not normalized beneath the workspace root: %v\", err)\n258|\t}\n259|\treturn nil\n260|}\n261|\n262|func checkNullableDigest(members map[string]json.RawMessage, name, owner string) (*scalar.Digest, error) {\n263|\traw, present := members[name]\n264|\tif !present {\n265|\t\treturn nil, invalid(\"%s misses a required member %q\", owner, name)\n266|\t}\n267|\tif isNull(raw) {\n268|\t\treturn nil, nil\n269|\t}\n270|\tdigest, ok := checkDigest(raw)\n271|\tif !ok {\n272|\t\treturn nil, invalid(\"%s %s is not a digest\", owner, name)\n273|\t}\n274|\treturn &digest, nil\n275|}\n276|\n277|// SanitizeNativeKey refuses every native key that is not sanitized:\n278|// empty values are refused here (over-long values by the caller's\n279|// bound check), and this gate refuses control characters (the full\n280|// Cc class, C0 and C1), invisible format characters (Cf, Zl, Zp:\n281|// zero-width and separator marks that render invisibly),\n282|// absolute-path forms, a UUIDv7 form (indistinguishable from a\n283|// fabricated AX Session identity), embedded-credential forms (a\n284|// password-style colon before the first @, with or without a\n285|// scheme), and AX-schema markers in any case. The pinned text does\n286|// not define the sanitizer's exact scope, so the implemented bound\n287|// is exactly this list, pinned by the sanitizer corpus and stated\n288|// in TRACEABILITY.md: ordinary spaces, @ without a password\n289|// colon, and colons without an @ all admit. A native key that\n290|// survives is printable, relative, and unambiguously native.\n291|func SanitizeNativeKey(key string) error {\n292|\tif key == \"\" {\n293|\t\treturn invalid(\"native key is empty\")\n294|\t}\n295|\tif !utf8.ValidString(key) {\n296|\t\treturn invalid(\"native key is not valid UTF-8\")\n297|\t}\n298|\tfor _, unit := range key {\n299|\t\tif unicode.IsControl(unit) {\n300|\t\t\treturn invalid(\"native key carries control characters\")\n301|\t\t}\n302|\t\tif unicode.Is(unicode.Cf, unit) || unicode.Is(unicode.Zl, unit) || unicode.Is(unicode.Zp, unit) {\n303|\t\t\treturn invalid(\"native key carries invisible format characters\")\n304|\t\t}\n305|\t}\n306|\tif strings.HasPrefix(key, \"/\") || strings.HasPrefix(key, `\\\\`) || hasDrivePrefix(key) {\n307|\t\treturn invalid(\"native key is an absolute source path, never a cross-host identity\")\n308|\t}\n309|\tif _, err := scalar.ParseUUIDv7(key); err == nil {\n310|\t\treturn invalid(\"native key %q is a UUIDv7, indistinguishable from a fabricated AX Session identity\", key)\n311|\t}\n312|\tif strings.Contains(strings.ToLower(key), \"urn:ax:\") {\n313|\t\treturn invalid(\"native key carries an AX identity marker\")\n314|\t}\n315|\tif at := strings.Index(key, \"@\"); at >= 0 && strings.Contains(key[:at], \":\") {\n316|\t\treturn invalid(\"native key carries embedded credentials\")\n317|\t}\n318|\treturn nil\n319|}\n320|\n321|func hasDrivePrefix(value string) bool {\n322|\treturn len(value) >= 3 && ((value[0] >= 'a' && value[0] <= 'z') || (value[0] >= 'A' && value[0] <= 'Z')) && value[1] == ':' && (value[2] == '/' || value[2] == '\\\\')\n323|}\n324|\n325|func memberField(member string) string {\n326|\tif member == \"\" {\n327|\t\treturn \"frame\"\n328|\t}\n329|\treturn \"member \" + member\n330|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
