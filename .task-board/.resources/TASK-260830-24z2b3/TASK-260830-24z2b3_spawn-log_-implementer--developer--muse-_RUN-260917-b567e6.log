{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d725","stream":{"kind":"session","id":"01a0b144-2d0b-7f30-96a3-e7fabafc632c"},"sequence":2541,"recorded_at":1780531400005077,"record_type":"event","durability":"durable","causation_id":"96a3132b-8530-4e47-8657-36d15f2da569","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"96a3132b-8530-4e47-8657-36d15f2da569","run_stream":{"kind":"run","id":"96a3132b-8530-4e47-8657-36d15f2da569"},"task_stream":{"kind":"task","id":"01a0b15a-1060-7403-adee-26f99cc3e75d"},"task_id":"01a0b15a-1060-7403-adee-26f99cc3e75d","event":{"kind":"output","task_id":"01a0b15a-1060-7403-adee-26f99cc3e75d","chunk":"Read text file `internal/clonebundle/refusal_session_event_test.go`.\n(239 line(s) above)\n240|\t\t\t}, \"not exclusive\"},\n241|\t\t\t{\"block extra member\", func(in *CanonicalEventInput) {\n242|\t\t\t\tin.Payload = []byte(`{\"content_blocks\":[{\"type\":\"text\",\"blob_id\":\"x\"}],\"extensions\":{}}`)\n243|\t\t\t}, \"unknown member\"},\n244|\t\t\t{\"bad extensions\", func(in *CanonicalEventInput) { in.Extensions = map[string]any{\"no-dots\": 1} }, \"reverse-DNS\"},\n245|\t\t}\n246|\t\tfor _, tc := range cases {\n247|\t\t\tt.Run(tc.name, func(t *testing.T) {\n248|\t\t\t\tinput := validEventInput(\"exact\")\n249|\t\t\t\ttc.mutate(&input)\n250|\t\t\t\t_, err := BuildCanonicalEvent(input)\n251|\t\t\t\trequireRefusal(t, err, tc.fragment)\n252|\t\t\t})\n253|\t\t}\n254|\t\t// Inline content at exactly 64 KiB is admitted.\n255|\t\tinput := validEventInput(\"exact\")\n256|\t\tinput.Payload = []byte(`{\"content_blocks\":[{\"type\":\"text\",\"content\":\"` + strings.Repeat(\"y\", 65536) + `\"}],\"extensions\":{}}`)\n257|\t\tif _, err := BuildCanonicalEvent(input); err != nil {\n258|\t\t\tt.Fatalf(\"BuildCanonicalEvent(64 KiB inline) error = %v\", err)\n259|\t\t}\n260|\t})\n261|\tt.Run(\"decode\", func(t *testing.T) {\n262|\t\tvalid := mustEventBytes(t, \"exact\")\n263|\t\tcases := []struct {\n264|\t\t\tname     string\n265|\t\t\tbody     func(t *testing.T) []byte\n266|\t\t\tfragment string\n267|\t\t}{\n268|\t\t\t{\"unknown member\", func(t *testing.T) []byte {\n269|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"lease\"] = \"x\" })\n270|\t\t\t}, \"unknown member\"},\n271|\t\t\t{\"bad schema\", func(t *testing.T) []byte {\n272|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"schema\"] = \"urn:ax:schema:blob\" })\n273|\t\t\t}, \"not the canonical event\"},\n274|\t\t\t{\"bad kind\", func(t *testing.T) []byte {\n275|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"kind\"] = \"chat\" })\n276|\t\t\t}, \"26-kind\"},\n277|\t\t\t{\"ordinal float\", func(t *testing.T) []byte {\n278|\t\t\t\traw := strings.Replace(string(valid), `\"ordinal\":0`, `\"ordinal\":1.5`, 1)\n279|\t\t\t\treturn []byte(raw)\n280|\t\t\t}, \"not a uint53\"},\n281|\t\t\t{\"visibility secret\", func(t *testing.T) []byte {\n282|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"visibility\"] = \"secret\" })\n283|\t\t\t}, \"public|projection|internal|opaque\"},\n284|\t\t\t{\"parents duplicate\", func(t *testing.T) []byte {\n285|\t\t\t\tdigest := fixtureDigest(\"test-event-1\")\n286|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"parents\"] = []any{digest, digest} })\n287|\t\t\t}, \"sorted unique\"},\n288|\t\t\t{\"parents unsorted\", func(t *testing.T) []byte {\n289|\t\t\t\thigh, low := unsortedPair(\"unsorted-parent-a\", \"unsorted-parent-b\")\n290|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"parents\"] = []any{high, low} })\n291|\t\t\t}, \"sorted unique\"},\n292|\t\t\t{\"evidence status maybe\", func(t *testing.T) []byte {\n293|\t\t\t\treturn tamper(t, valid, func(o map[string]any) {\n294|\t\t\t\t\to[\"source_evidence\"].(map[string]any)[\"capture_status\"] = \"maybe\"\n295|\t\t\t\t})\n296|\t\t\t}, \"exact|partial|synthesized|unavailable\"},\n297|\t\t\t{\"evidence raw_refs duplicate\", func(t *testing.