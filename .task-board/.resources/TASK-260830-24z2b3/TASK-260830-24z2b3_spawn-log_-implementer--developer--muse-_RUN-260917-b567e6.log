ct(rawReferenceObject(reference))\n740|\t\tif err != nil {\n741|\t\t\treturn nil, err\n742|\t\t}\n743|\t\tif index > 0 && bytes.Compare(key, previous) <= 0 {\n744|\t\t\treturn nil, invalid(\"source evidence raw_refs are not sorted unique\")\n745|\t\t}\n746|\t\tprevious = key\n747|\t\treferences = append(references, reference)\n748|\t}\n749|\tif !validCaptureStatus(input.CaptureStatus) {\n750|\t\treturn nil, invalid(\"source evidence capture_status is outside exact|partial|synthesized|unavailable\")\n751|\t}\n752|\tpreviousReason := \"\"\n753|\tfor index, reason := range input.ReasonCodes {\n754|\t\tif stringLength(reason) < 1 || stringLength(reason) > 128 {\n755|\t\t\treturn nil, invalid(\"source evidence reason_codes[%d] is not a string[1..128]\", index)\n756|\t\t}\n757|\t\tif index > 0 && reason <= previousReason {\n758|\t\t\treturn nil, invalid(\"source evidence reason_codes are not sorted unique\")\n759|\t\t}\n760|\t\tpreviousReason = reason\n761|\t}\n762|\tif len(input.ReasonCodes) > 128 {\n763|\t\treturn nil, invalid(\"source evidence carries %d reason_codes, maximum is 128\", len(input.ReasonCodes))\n764|\t}\n765|\tvar operation any\n766|\thasOperation := false\n767|\tif input.CoreOperationID != nil {\n768|\t\tvalue, err := scalar.ParseUUIDv7(*input.CoreOperationID)\n769|\t\tif err != nil {\n770|\t\t\treturn nil, invalid(\"source evidence core_operation_id is not a UUIDv7: %v\", err)\n771|\t\t}\n772|\t\toperation = value.String()\n773|\t\thasOperation = true\n774|\t}\n775|\tif err := checkEvidenceCoupling(input.CaptureStatus, hasNativeEvent, hasOperation); err != nil {\n776|\t\treturn nil, err\n777|\t}\n778|\tobjects := make([]any, 0, len(references))\n779|\tfor _, reference := range references {\n780|\t\tobjects = append(objects, rawReferenceObject(reference))\n781|\t}\n782|\treasons := make([]any, 0, len(input.ReasonCodes))\n783|\tfor _, reason := range input.ReasonCodes {\n784|\t\treasons = append(reasons, reason)\n785|\t}\n786|\treturn map[string]any{\n78