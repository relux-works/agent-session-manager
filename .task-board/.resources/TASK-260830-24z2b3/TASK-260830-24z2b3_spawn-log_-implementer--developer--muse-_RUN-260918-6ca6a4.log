{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c719","stream":{"kind":"session","id":"01a0b1d2-62fd-7091-a15f-687f76c867f4"},"sequence":487,"recorded_at":1780531400000969,"record_type":"event","durability":"durable","causation_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","run_stream":{"kind":"run","id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb"},"call_id":"call_01a0b1d4ec1f713da939acb8a3d5660b","text":"Read text file `internal/clonebundle/captureitem.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n7|)\n8|\n9|// This file validates the CaptureItem, Capture Source Basis, and\n10|// Capture Boundary closed shapes of Clone Capture Manifest 1.0.0.\n11|// The manifest envelope itself lives in capturebuild.go.\n12|\n13|// captureClasses is the closed nine-class vocabulary Section 13.14.1\n14|// states for CaptureItem. It mirrors the sessadapter capture-plan\n15|// vocabulary over the same pinned section; membership here is the\n16|// manifest-side gate.\n17|var captureClasses = []string{\n18|\t\"durable_payload\",\n19|\t\"durable_index_required\",\n20|\t\"durable_sidecar\",\n21|\t\"derived_cache_optional\",\n22|\t\"credential\",\n23|\t\"machine_auth\",\n24|\t\"runtime_state\",\n25|\t\"transient_lock\",\n26|\t\"unknown\",\n27|}\n28|\n29|// ValidCaptureClass reports whether the name is a capture class.\n30|func ValidCaptureClass(name string) bool {\n31|\tfor _, class := range captureClasses {\n32|\t\tif class == name {\n33|\t\t\treturn true\n34|\t\t}\n35|\t}\n36|\treturn false\n37|}\n38|\n39|// alwaysExcludedClass reports whether the class is always excluded:\n40|// credential, auth, runtime, and lock classes are never included.\n41|func alwaysExcludedClass(class string) bool {\n42|\tswitch class {\n43|\tcase \"credential\", \"machine_auth\", \"runtime_state\", \"transient_lock\":\n44|\t\treturn true\n45|\tdefault:\n46|\t\treturn false\n47|\t}\n48|}\n49|\n50|var captureItemMembers = map[string]bool{\n51|\t\"native_item_key\":    true,\n52|\t\"class\":              true,\n53|\t\"disposition\":        true,\n54|\t\"blob_descriptor_id\": true,\n55|\t\"byte_count\":         true,\n56|\t\"exclusion_reason\":   true,\n57|\t\"extensions\":         true,\n58|}\n59|\n60|var captureItemRequired = []string{\n61|\t\"native_item_key\",\n62|\t\"class\",\n63|\t\"disposition\",\n64|\t\"blob_descriptor_id\",\n65|\t\"byte_count\",\n66|\t\"exclusion_reason\",\n67|\t\"extensions\",\n68|}\n69|\n70|// CaptureItem is one validated capture item.\n71|type CaptureItem struct {\n72|\tNativeItemKey    string\n73|\tClass            string\n74|\tDisposition      string\n75|\tBlobDescriptorID *scalar.Digest\n76|\tByteCount        *uint64\n77|\tExclusionReason  *string\n78|\tExtensions       map[string]any\n79|}\n80|\n81|// Included reports whether the item is an included row.\n82|func (item CaptureItem) Included() bool { return item.Disposition == \"included\" }\n83|\n84|// decodeCaptureItem validates one closed CaptureItem: the\n85|// included/excluded content rule, the always-excluded classes, and\n86|// the row-21 exclusion allowlist on the native key.\n87|func decodeCaptureItem(raw json.RawMessage, index int) (CaptureItem, error) {\n88|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n89|\tif fault != nil {\n90|\t\treturn CaptureItem{}, invalid(\"capture item[%d] %s (%s)\", index, fault.detail, memberField(fault.member))\n91|\t}\n92|\tif name, unknown := unknownMember(members, captureItemMembers); unknown {\n93|\t\treturn CaptureItem{}, invalid(\"capture item[%d] carries unknown member %q\", index, name)\n94|\t}\n95|\tif name, missing := missingMember(members, captureItemRequired); missing {\n96|\t\treturn CaptureItem{}, invalid(\"capture item[%d] misses a required member %q\", index, name)\n97|\t}\n98|\tkey, ok := checkStringBounds(members[\"native_item_key\"], 1, 512)\n99|\tif !ok {\n100|\t\treturn CaptureItem{}, invalid(\"capture item[%d] native_item_key is not a string[1..512]\", index)\n101|\t}\n102|\tif err := SanitizeNativeKey(key); err != nil {\n103|\t\treturn CaptureItem{}, err\n104|\t}\n105|\tif err := refuseExcludedMember(\"capture item\", key, index); err != nil {\n106|\t\treturn CaptureItem{}, err\n107|\t}\n108|\tclass, ok := rawString(members[\"class\"])\n109|\tif !ok || !ValidCaptureClass(class) {\n110|\t\treturn CaptureItem{}, invalid(\"capture item[%d] class %q is outside the nine-class vocabulary\", index, class)\n111|\t}\n112|\tdisposition, ok := rawString(members[\"disposition\"])\n113|\tif !ok || (disposition != \"included\" && disposition != \"excluded\") {\n114|\t\treturn CaptureItem{}, invalid(\"capture item[%d] disposition is outside included|excluded\", index)\n115|\t}\n116|\tvar descriptor *scalar.Digest\n117|\tif !isNull(members[\"blob_descriptor_id\"]) {\n118|\t\tvalue, ok := checkDigest(members[\"blob_descriptor_id\"])\n119|\t\tif !ok {\n120|\t\t\treturn CaptureItem{}, invalid(\"capture item[%d] blob_descriptor_id is not a digest\", index)\n121|\t\t}\n122|\t\tdescriptor = &value\n123|\t}\n124|\tvar count *uint64\n125|\tif !isNull(members[\"byte_count\"]) {\n126|\t\tvalue, ok := checkUint53Bounds(members[\"byte_count\"], 0, maxUint53)\n127|\t\tif !ok {\n128|\t\t\treturn CaptureItem{}, invalid(\"capture item[%d] byte_count is not a uint53\", index)\n129|\t\t}\n130|\t\tcount = &value\n131|\t}\n132|\tvar reason *string\n133|\tif !isNull(members[\"exclusion_reason\"]) {\n134|\t\tvalue, ok := checkStringBounds(members[\"exclusion_reason\"], 1, 128)\n135|\t\tif !ok {\n136|\t\t\treturn CaptureItem{}, invalid(\"capture item[%d] exclusion_reason is not a string[1..128]\", index)\n137|\t\t}\n138|\t\treason = &value\n139|\t}\n140|\tif err := checkItemDisposition(index, class, disposition, descriptor != nil, count != nil, reason != nil); err != nil {\n141|\t\treturn CaptureItem{}, err\n142|\t}\n143|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n144|\t\treturn CaptureItem{}, invalid(\"capture item[%d] extensions %s\", index, extensionsFault)\n145|\t}\n146|\tvar decodedExtensions map[string]any\n147|\tif err := json.Unmarshal(bytesTrimSpace(members[\"extensions\"]), &decodedExtensions); err != nil {\n148|\t\treturn CaptureItem{}, invalid(\"capture item[%d] extensions are not an object\", index)\n149|\t}\n150|\tif decodedExtensions == nil {\n151|\t\tdecodedExtensions = map[string]any{}\n152|\t}\n153|\treturn CaptureItem{\n154|\t\tNativeItemKey:    key,\n155|\t\tClass:            class,\n156|\t\tDisposition:      disposition,\n157|\t\tBlobDescriptorID: descriptor,\n158|\t\tByteCount:        count,\n159|\t\tExclusionReason:  reason,\n160|\t\tExtensions:       decodedExtensions,\n161|\t}, nil\n162|}\n163|\n164|// checkItemDisposition enforces the included/excluded rule: included\n165|// requires both content members non-null and a null reason; excluded\n166|// requires null content members and a non-null reason; the four\n167|// always-excluded classes are never included.\n168|func checkItemDisposition(index int, class, disposition string, hasDescriptor, hasCount, hasReason bool) error {\n169|\tif disposition == \"included\" {\n170|\t\tif alwaysExcludedClass(class) {\n171|\t\t\treturn invalid(\"capture item[%d] class %q is always excluded, never included\", index, class)\n172|\t\t}\n173|\t\tif !hasDescriptor || !hasCount {\n174|\t\t\treturn invalid(\"capture item[%d] included requires non-null descriptor and byte count\", index)\n175|\t\t}\n176|\t\tif hasReason {\n177|\t\t\treturn invalid(\"capture item[%d] included carries an exclusion reason\", index)\n178|\t\t}\n179|\t\treturn nil\n180|\t}\n181|\tif hasDescriptor || hasCount {\n182|\t\treturn invalid(\"capture item[%d] excluded carries content members\", index)\n183|\t}\n184|\tif !hasReason {\n185|\t\treturn invalid(\"capture item[%d] excluded requires a non-null exclusion reason\", index)\n186|\t}\n187|\treturn nil\n188|}\n189|\n190|// CaptureItemInput is one caller-supplied capture item candidate for\n191|// Build. Null members are nil pointers: BlobDescriptorID and\n192|// ByteCount for excluded rows, ExclusionReason for included rows.\n193|type CaptureItemInput struct {\n194|\tNativeItemKey    string\n195|\tClass            string\n196|\tDisposition      string\n197|\tBlobDescriptorID *string\n198|\tByteCount        *uint64\n199|\tExclusionReason  *string\n200|\tExtensions       map[string]any\n201|}\n202|\n203|func buildCaptureItem(input CaptureItemInput, index int) (CaptureItem, error) {\n204|\tif stringLength(input.NativeItemKey) < 1 || stringLength(input.NativeItemKey) > 512 {\n205|\t\treturn CaptureItem{}, invalid(\"capture item[%d] native_item_key is not a string[1..512]\", index)\n206|\t}\n207|\tif err := SanitizeNativeKey(input.NativeItemKey); err != nil {\n208|\t\treturn CaptureItem{}, err\n209|\t}\n210|\tif err := refuseExcludedMember(\"capture item\", input.NativeItemKey, index); err != nil {\n211|\t\treturn CaptureItem{}, err\n212|\t}\n213|\tif !ValidCaptureClass(input.Class) {\n214|\t\treturn CaptureItem{}, invalid(\"capture item[%d] class %q is outside the nine-class vocabulary\", index, input.Class)\n215|\t}\n216|\tif input.Disposition != \"included\" && input.Disposition != \"excluded\" {\n217|\t\treturn CaptureItem{}, invalid(\"capture item[%d] disposition is outside included|excluded\", index)\n218|\t}\n219|\tvar descriptor *scalar.Digest\n220|\tif input.BlobDescriptorID != nil {\n221|\t\tvalue, err := scalar.ParseDigest(*input.BlobDescriptorID)\n222|\t\tif err != nil {\n223|\t\t\treturn CaptureItem{}, invalid(\"capture item[%d] blob_descriptor_id is not a digest: %v\", index, err)\n224|\t\t}\n225|\t\tdescriptor = &value\n226|\t}\n227|\tvar count *uint64\n228|\tif input.ByteCount != nil {\n229|\t\tif *input.ByteCount > maxUint53 {\n230|\t\t\treturn CaptureItem{}, invalid(\"capture item[%d] byte_count exceeds uint53\", index)\n231|\t\t}\n232|\t\tkept := *input.ByteCount\n233|\t\tcount = &kept\n234|\t}\n235|\tvar reason *string\n236|\tif input.ExclusionReason != nil {\n237|\t\tif !validText(*input.ExclusionReason) {\n238|\t\t\treturn CaptureItem{}, invalid(\"capture item[%d] exclusion_reason is not valid UTF-8\", index)\n239|\t\t}\n240|\t\tif stringLength(*input.ExclusionReason) < 1 || stringLength(*input.ExclusionReason) > 128 {\n241|\t\t\treturn CaptureItem{}, invalid(\"capture item[%d] exclusion_reason is not a string[1..128]\", index)\n242|\t\t}\n243|\t\tkept := *input.ExclusionReason\n244|\t\treason = &kept\n245|\t}\n246|\tif err := checkItemDisposition(index, input.Class, input.Disposition, descriptor != nil, count != nil, reason != nil); err != nil {\n247|\t\treturn CaptureItem{}, err\n248|\t}\n249|\tif _, err := encodeExtensions(input.Extensions); err != nil {\n250|\t\treturn CaptureItem{}, invalid(\"capture item[%d]: %v\", index, err)\n251|\t}\n252|\treturn CaptureItem{\n253|\t\tNativeItemKey:    input.NativeItemKey,\n254|\t\tClass:            input.Class,\n255|\t\tDisposition:      input.Disposition,\n256|\t\tBlobDescriptorID: descriptor,\n257|\t\tByteCount:        count,\n258|\t\tExclusionReason:  reason,\n259|\t\tExtensions:       extensionValue(input.Extensions),\n260|\t}, nil\n261|}\n262|\n263|func captureItemObject(item CaptureItem) map[string]any {\n264|\tvar descriptor any\n265|\tif item.BlobDescriptorID != nil {\n266|\t\tdescriptor = item.BlobDescriptorID.String()\n267|\t}\n268|\tvar count any\n269|\tif item.ByteCount != nil {\n270|\t\tcount = *item.ByteCount\n271|\t}\n272|\tvar reason any\n273|\tif item.ExclusionReason != nil {\n274|\t\treason = *item.ExclusionReason\n275|\t}\n276|\treturn map[string]any{\n277|\t\t\"native_item_key\":    item.NativeItemKey,\n278|\t\t\"class\":              item.Class,\n279|\t\t\"disposition\":        item.Disposition,\n280|\t\t\"blob_descriptor_id\": descriptor,\n281|\t\t\"byte_count\":         count,\n282|\t\t\"exclusion_reason\":   reason,\n283|\t\t\"extensions\":         extensionValue(item.Extensions),\n284|\t}\n285|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
