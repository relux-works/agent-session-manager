{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca6b","stream":{"kind":"session","id":"01a0b1d2-62fd-7091-a15f-687f76c867f4"},"sequence":912,"recorded_at":1780531400001819,"record_type":"event","durability":"durable","causation_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","run_stream":{"kind":"run","id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb"},"task_stream":{"kind":"task","id":"01a0b1d7-6e03-7d41-8a48-9cdc11f73b1c"},"task_id":"01a0b1d7-6e03-7d41-8a48-9cdc11f73b1c","event":{"kind":"output","task_id":"01a0b1d7-6e03-7d41-8a48-9cdc11f73b1c","chunk":"edited\nchanged lines: lines 124-137\n--- original\n+++ updated\n@@\n-// EncodeNativeIdentity renders one validated identity as canonical\n-// bytes under the given extensions. The native session ID and the\n-// opaque identity are sanitized here, before marshaling —\n-// encoding/json would otherwise rewrite invalid UTF-8 to U+FFFD and\n-// the caller's re-decode would only ever see the rewritten bytes,\n-// laundering a native key past the sanitizer's own refusal and\n-// sealing two distinct inputs to byte-identical objects. The\n-// extensions are validated here too, so encoding never admits what\n-// decoding refused. A nil extensions map encodes as the empty\n-// object.\n-func EncodeNativeIdentity(identity NativeIdentity, extensions map[string]any) ([]byte, error) {\n-\tif err := SanitizeNativeKey(identity.NativeSessionID); err != nil {\n-\t\treturn nil, err\n-\t}\n+// EncodeNativeIdentity renders one validated identity as canonical\n+// bytes under the given extensions. The native session ID and the\n+// opaque identity are sanitized here, before marshaling —\n+// encoding/json would otherwise rewrite invalid UTF-8 to U+FFFD and\n+// the caller's re-decode would only ever see the rewritten bytes,\n+// laundering a native key past the sanitizer's own refusal and\n+// sealing two distinct inputs to byte-identical objects. The kind\n+// refuses invalid UTF-8 here too, so no member the encoder seals is\n+// ever rewritten. The extensions are validated here as well, so\n+// encoding never admits what decoding refused. A nil extensions map\n+// encodes as the empty object.\n+func EncodeNativeIdentity(identity NativeIdentity, extensions map[string]any) ([]byte, error) {\n+\tif !validText(identity.IdentityKind) {\n+\t\treturn nil, invalid(\"native identity kind is not valid UTF-8\")\n+\t}\n+\tif err := SanitizeNativeKey(identity.NativeSessionID); err != nil {\n+\t\treturn nil, err\n+\t}\n","final_result":true}}}
