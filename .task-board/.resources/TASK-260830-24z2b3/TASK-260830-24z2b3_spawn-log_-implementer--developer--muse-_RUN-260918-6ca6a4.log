{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c919","stream":{"kind":"session","id":"01a0b1d2-62fd-7091-a15f-687f76c867f4"},"sequence":743,"recorded_at":1780531400001481,"record_type":"event","durability":"durable","causation_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","run_stream":{"kind":"run","id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb"},"call_id":"call_01a0b1d5f4817259a7ff35e9197dca3c","text":"Read text file `internal/clonebundle/testdata/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for internal/clonebundle.\n3|\n4|Every gate ships a narrowing mutant: the gate stays present and is\n5|weakened to admit exactly one member of the class it must reject, and\n6|the named killer test must fail. A delete-only mutant proves only that\n7|the gate exists and is not accepted as evidence.\n8|\n9|Each row runs M (mutate one production file in place), R (run the\n10|scoped Go killer through the production entry point), V (verdict from\n11|the Go exit code plus a FAIL kill-line: KILLED iff R fails with a test\n12|failure line, SURVIVED iff R passes, ERROR for anything else —\n13|unapplied patches, build breaks, timeouts). M failures and R\n14|infrastructure errors are ERROR, never kills or survivals. The file is\n15|restored from its backup after every row, pass or fail.\n16|\n17|Row C-doc-comment is the harmless control: a comment-only edit that\n18|must SURVIVE, proving the harness observes test outcomes instead of\n19|hard-coding kills.\n20|\n21|Usage:\n22|  PYTHONDONTWRITEBYTECODE=1 python3 internal/clonebundle/testdata/mutant_harness.py [--log-dir DIR] [MUTANT ...]\n23|\"\"\"\n24|\n25|import shutil\n26|import subprocess\n27|import sys\n28|import tempfile\n29|import time\n30|from dataclasses import dataclass\n31|from pathlib import Path\n32|\n33|REPO = Path(__file__).resolve().parents[3]\n34|PACKAGE = \"internal/clonebundle\"\n35|\n36|FORGED_DESCRIPTOR_HEX = \"edb3da2954b883ebc2099da18edeac4e12f8f5d67aa5bb2dd80ba472b23481f2\"\n37|OTHER_DESCRIPTOR_HEX = \"369c0225affac23e2a7a16052d03b24bfd9421ea3f83c8fe39111e864c344cfb\"\n38|PAIR_DIGEST = \"sha256:305e10453577c8371cdb872e120f1662649d150bbc2eff62b81827851f1d4926\"\n39|\n40|\n41|@dataclass(frozen=True)\n42|class Mutant:\n43|    name: str\n44|    path: str\n45|    find: str\n46|    replace: str\n47|    count: int\n48|    run: str\n49|    expect: str\n50|    note: str\n51|\n52|\n53|MUTANTS = [\n54|    Mutant(\n55|        name=\"N-raw-class\",\n56|        path=f\"{PACKAGE}/rawmanifest.go\",\n57|        find='\\t\"derived_cache_optional\",\\n\\t\"unknown\",\\n',\n58|        replace='\\t\"derived_cache_optional\",\\n\\t\"credential\",\\n\\t\"unknown\",\\n',\n59|        count=1,\n60|        run=\"TestRawManifestRefusals/build/credential_forbidden\",\n61|        expect=\"KILLED\",\n62|        note=\"Admits exactly credential into the raw subset; every other excluded class still refuses.\",\n63|    ),\n64|    Mutant(\n65|        name=\"N-raw-order\",\n66|        path=f\"{PACKAGE}/rawmanifest.go\",\n67|        find=\"\\tif index > 0 && input.NativeItemKey <= previous {\\n\",\n68|        replace=\"\\tif index > 0 && input.NativeItemKey < previous {\\n\",\n69|        count=1,\n70|        run=\"TestRawManifestRefusals/build/duplicate_entries\",\n71|        expect=\"KILLED\",\n72|        note=\"Admits exactly duplicate keys; unsorted keys still refuse.\",\n73|    ),\n74|    Mutant(\n75|        name=\"N-exclusion-config\",\n76|        path=f\"{PACKAGE}/rawmanifest.go\",\n77|        find=\"\\tif hosttrust.ExcludedConfigDirName(key) {\\n\",\n78|        replace='\\tif hosttrust.ExcludedConfigDirName(key) && key != \"settings.bak.3\" {\\n',\n79|        count=1,\n80|        run=\"TestRawManifestExcludesTrustMaterial\",\n81|        expect=\"KILLED\",\n82|        note=\"Admits exactly the settings.bak.3 config key; every other excluded key still refuses. Token preserved.\",\n83|    ),\n84|    Mutant(\n85|        name=\"N-sanitize-uuid\",\n86|        path=f\"{PACKAGE}/identity.go\",\n87|        find=\"\\tif _, err := scalar.ParseUUIDv7(key); err == nil {\\n\",\n88|        replace='\\tif _, err := scalar.ParseUUIDv7(key); err == nil && key != \"0198f4c8-8e50-7f66-8f70-1234567890c2\" {\\n',\n89|        count=1,\n90|        run=\"TestIdentityRefusals/sanitizer\",\n91|        expect=\"KILLED\",\n92|        note=\"Admits exactly one UUIDv7 native key; every other UUIDv7 still refuses. Token preserved.\",\n93|    ),\n94|    Mutant(\n95|        name=\"N-sanitizer-control\",\n96|        path=f\"{PACKAGE}/identity.go\",\n97|        find=\"\\t\\tif unicode.IsControl(unit) {\\n\",\n98|        replace=\"\\t\\tif unicode.IsControl(unit) && unit != 0x1f {\\n\",\n99|        count=1,\n100|        run=\"TestIdentityRefusals/sanitizer\",\n101|        expect=\"KILLED\",\n102|        note=\"Admits exactly U+001F; every other control still refuses.\",\n103|    ),\n104|    Mutant(\n105|        name=\"N-always-excluded\",\n106|        path=f\"{PACKAGE}/captureitem.go\",\n107|        find='\\tcase \"credential\", \"machine_auth\", \"runtime_state\", \"transient_lock\":\\n',\n108|        replace='\\tcase \"machine_auth\", \"runtime_state\", \"transient_lock\":\\n',\n109|        count=1,\n110|        run=\"TestCaptureItemRefusals/credential_included\",\n111|        expect=\"KILLED\",\n112|        note=\"Admits exactly included credential rows; the other three always-excluded classes still refuse.\",\n113|    ),\n114|    Mutant(\n115|        name=\"N-included-reason\",\n116|        path=f\"{PACKAGE}/captureitem.go\",\n117|        find=\"\\t\\tif hasReason {\\n\",\n118|        replace='\\t\\tif hasReason && class == \"unknown\" {\\n',\n119|        count=1,\n120|        run=\"TestCaptureItemRefusals/included_with_reason\",\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c91b","stream":{"kind":"session","id":"01a0b1d2-62fd-7091-a15f-687f76c867f4"},"sequence":744,"recorded_at":1780531400001483,"record_type":"event","durability":"durable","causation_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","run_stream":{"kind":"run","id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb"},"call_id":"call_01a0b1d5f6bd7073a84416cd10b9cc93","text":"Read text file `internal/clonebundle/testdata/mutant_harness.py`.\n(679 line(s) above)\n680|        expect=\"KILLED\",\n681|        note=\"Admits exactly the fault literal at the workspace binding site only; the identity site still refuses.\",\n682|    ),\n683|    Mutant(\n684|        name=\"N-ext-values-actor\",\n685|        path=f\"{PACKAGE}/session.go\",\n686|        find='\\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\\n\\t\\treturn Actor{}, invalid(\"actor[%d] extensions %s\", index, extensionsFault)\\n\\t}\\n',\n687|        replace='\\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil && string(members[\"extensions\"]) != `{\"com.example.n\":1.5}` {\\n\\t\\treturn Actor{}, invalid(\"actor[%d] extensions %s\", index, extensionsFault)\\n\\t}\\n',\n688|        count=1,\n689|        run=\"TestExtensionValueModelAtEverySite/actor\",\n690|        expect=\"KILLED\",\n691|        note=\"Admits exactly the fault literal at the actor site only; the session site still refuses.\",\n692|    ),\n693|    Mutant(\n694|        name=\"N-ext-values-canonical-session\",\n695|        path=f\"{PACKAGE}/session.go\",\n696|        find='\\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\\n\\t\\treturn CanonicalSession{}, invalid(\"canonical session extensions %s\", extensionsFault)\\n\\t}\\n',\n697|        replace='\\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil && string(members[\"extensions\"]) != `{\"com.example.n\":1.5}` {\\n\\t\\treturn CanonicalSession{}, invalid(\"canonical session extensions %s\", extensionsFault)\\n\\t}\\n',\n698|        count=1,\n699|        run=\"TestExtensionValueModelAtEverySite/canonical_session\",\n700|        expect=\"KILLED\",\n701|        note=\"Admits exactly the fault literal at the canonical session site only; the actor site still refuses.\",\n702|    ),\n703|    Mutant(\n704|        name=\"N-text-utf8\",\n705|        path=f\"{PACKAGE}/decode.go\",\n706|        find='\\treturn utf8.ValidString(value)\\n',\n707|        replace='\\treturn utf8.ValidString(value) || value == \"ti\\\\xfftle\"\\n',\n708|        count=1,\n709|        run=\"TestBuildTextMustBeValidUTF8/session_title\",\n710|        expect=\"KILLED\",\n711|        note=\"Admits exactly the killer's invalid title past the shared text gate; every other invalid-UTF-8 value still refuses at every admission site.\",\n712|    ),\n713|    Mutant(\n714|        name=\"N-reason-codes-dup-build\",\n715|        path=f\"{PACKAGE}/event.go\",\n716|        find=\"\\t\\tif index > 0 && reason <= previousReason {\\n\",\n717|        replace=\"\\t\\tif index > 0 && reason < previousReason {\\n\",\n718|        count=1,\n719|        run=\"TestCanonicalEventRefusals/evidence/reasons_duplicate\",\n720|        expect=\"KILLED\",\n721|        note=\"Admits exactly an equal reason-code duplicate at build; unsorted codes still refuse. The decode site keeps its delegated row.\",\n722|    ),\n723|    Mutant(\n724|        name=\"C-doc-comment\",\n725|        path=f\"{PACKAGE}/doc.go\",\n726|        find=\"// Authority: relux-works/agent-session-manager-spec@v0.7.0, Sections\\n\",\n727|        replace=\"// Authority: relux-works/agent-session-manager-spec@v0.7.0, Sections (control).\\n\",\n728|        count=1,\n729|        run=\"TestCaptureClassVocabularyIsPinned\",\n730|        expect=\"SURVIVED\",\n731|        note=\"Harmless control: a comment-only edit must survive.\",\n732|    ),\n733|]\n734|\n735|\n736|def run_mutant(mutant: Mutant) -> tuple[str, str, int, float]:\n737|    target = REPO / mutant.path\n738|    original = target.read_text()\n739|    found = original.count(mutant.find)\n740|    if found != mutant.count:\n741|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\", \"\", -1, 0.0\n742|    with tempfile.TemporaryDirectory() as staging:\n743|        backup = Path(staging) / \"backup\"\n744|        shutil.copy2(target, backup)\n745|        try:\n746|            target.write_text(original.replace(mutant.find, mutant.replace))\n747|            started = time.time()\n748|            run = subprocess.run(\n749|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n750|                cwd=REPO,\n751|                capture_output=True,\n752|                text=True,\n753|                timeout=300,\n754|            )\n755|            elapsed = time.time() - started\n756|        finally:\n757|            shutil.copy2(backup, target)\n758|    output = (run.stdout + run.stderr).strip()\n759|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n760|        return f\"ERROR: {mutant.name}: build broke under the patch\", output, run.returncode, elapsed\n761|    if run.returncode == 0:\n762|        verdict = \"SURVIVED\"\n763|    elif '--- FAIL' in output or 'FAIL:' in output:\n764|        verdict = \"KILLED\"\n765|    else:\n766|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\", output, run.returncode, elapsed\n767|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n768|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note}\", output, run.returncode, elapsed\n769|\n770|\n771|def main(argv: list[str]) -> int:\n772|    log_dir: Path | None = None\n773|    selected_names: list[str] = []\n774|    args = list(argv)\n775|    while args:\n776|        if args[0] == \"--log-dir\":\n777|            if len(args) < 2:\n778|                print(\"missing directory for --log-dir\")\n779|                return 2\n780|            log_dir = Path(args[1])\n781|            args = args[2:]\n782|        else:\n783|            selected_names.append(args[0])\n784|            args = args[1:]\n785|    selected = [m for m in MUTANTS if not selected_names or m.name in selected_names]\n786|    if selected_names and len(selected) != len(selected_names):\n787|        unknown = sorted(set(selected_names) - {m.name for m in selected})\n788|        print(f\"unknown mutants: {', '.join(unknown)}\")\n789|        return 2\n790|    if log_dir is not None:\n791|        log_dir.mkdir(parents=True, exist_ok=True)\n792|    failures = 0\n793|    for mutant in selected:\n794|        try:\n795|            line, output, exit_code, elapsed = run_mutant(mutant)\n796|        except subprocess.TimeoutExpired:\n797|            line, output, exit_code, elapsed = f\"ERROR: {mutant.name}: killer timed out\", \"\", -1, 0.0\n798|        print(line, flush=True)\n799|        if log_dir is not None:\n800|            (log_dir / f\"{mutant.name}.log\").write_text(\n801|                f\"# mutant={mutant.name} path={mutant.path} -run={mutant.run}\\n\"\n802|                f\"# exit={exit_code} elapsed={elapsed:.1f}s\\n\"\n803|                f\"# find={mutant.find!r}\\n# replace={mutant.replace!r}\\n---\\n{output}\\n\"\n804|            )\n805|        if not line.startswith(\"ok:\"):\n806|            failures += 1\n807|    return 1 if failures else 0\n808|\n809|\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
