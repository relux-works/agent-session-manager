{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c747","stream":{"kind":"session","id":"01a0b1d2-62fd-7091-a15f-687f76c867f4"},"sequence":510,"recorded_at":1780531400001015,"record_type":"event","durability":"durable","causation_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","run_stream":{"kind":"run","id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb"},"task_stream":{"kind":"task","id":"01a0b1d4-fb99-75d2-a955-1ade53655e3f"},"task_id":"01a0b1d4-fb99-75d2-a955-1ade53655e3f","event":{"kind":"output","task_id":"01a0b1d4-fb99-75d2-a955-1ade53655e3f","chunk":"Read text file `internal/clonebundle/session.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n8|)\n9|\n10|// This file validates and constructs Canonical Session 1.0.0 and its\n11|// Actor records: the logical session envelope over ordered unique\n12|// Canonical Event IDs.\n13|\n14|const (\n15|\tcanonicalSessionSchema  = \"urn:ax:schema:canonical-session\"\n16|\tcanonicalSessionVersion = \"1.0.0\"\n17|\tcanonicalSessionSelf    = \"canonical_session_id\"\n18|)\n19|\n20|var actorMembers = map[string]bool{\n21|\t\"actor_id\": true, \"kind\": true, \"parent_actor_id\": true, \"name\": true,\n22|\t\"source_native_id\": true, \"model\": true, \"extensions\": true,\n23|}\n24|\n25|var actorRequired = []string{\n26|\t\"actor_id\", \"kind\", \"parent_actor_id\", \"name\",\n27|\t\"source_native_id\", \"model\", \"extensions\",\n28|}\n29|\n30|// Actor is one validated canonical actor.\n31|type Actor struct {\n32|\tActorID        scalar.UUIDv7\n33|\tKind           string\n34|\tParentActorID  *scalar.UUIDv7\n35|\tName           *string\n36|\tSourceNativeID *string\n37|\tModel          *string\n38|}\n39|\n40|func validActorKind(kind string) bool {\n41|\treturn kind == \"main\" || kind == \"subagent\" || kind == \"external\"\n42|}\n43|\n44|func decodeActor(raw json.RawMessage, index int) (Actor, error) {\n45|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n46|\tif fault != nil {\n47|\t\treturn Actor{}, invalid(\"actor[%d] %s (%s)\", index, fault.detail, memberField(fault.member))\n48|\t}\n49|\tif name, unknown := unknownMember(members, actorMembers); unknown {\n50|\t\treturn Actor{}, invalid(\"actor[%d] carries unknown member %q\", index, name)\n51|\t}\n52|\tif name, missing := missingMember(members, actorRequired); missing {\n53|\t\treturn Actor{}, invalid(\"actor[%d] misses a required member %q\", index, name)\n54|\t}\n55|\tactorID, ok := checkUUIDv7(members[\"actor_id\"])\n56|\tif !ok {\n57|\t\treturn Actor{}, invalid(\"actor[%d] actor_id is not a UUIDv7\", index)\n58|\t}\n59|\tkind, ok := rawString(members[\"kind\"])\n60|\tif !ok || !validActorKind(kind) {\n61|\t\treturn Actor{}, invalid(\"actor[%d] kind is outside main|subagent|external\", index)\n62|\t}\n63|\tvar parent *scalar.UUIDv7\n64|\tif !isNull(members[\"parent_actor_id\"]) {\n65|\t\tvalue, ok := checkUUIDv7(members[\"parent_actor_id\"])\n66|\t\tif !ok {\n67|\t\t\treturn Actor{}, invalid(\"actor[%d] parent_actor_id is not a UUIDv7\", index)\n68|\t\t}\n69|\t\tparent = &value\n70|\t}\n71|\tif kind == \"main\" && parent != nil {\n72|\t\treturn Actor{}, invalid(\"actor[%d] main actor carries a parent\", index)\n73|\t}\n74|\tif kind != \"main\" && parent == nil {\n75|\t\treturn Actor{}, invalid(\"actor[%d] non-main actor requires a parent\", index)\n76|\t}\n77|\tname, err := checkNullableBoundedString(members, \"name\", 1, 512, index, \"actor\")\n78|\tif err != nil {\n79|\t\treturn Actor{}, err\n80|\t}\n81|\tnativeID, err := checkNullableBoundedString(members, \"source_native_id\", 1, 512, index, \"actor\")\n82|\tif err != nil {\n83|\t\treturn Actor{}, err\n84|\t}\n85|\tif nativeID != nil {\n86|\t\tif err := SanitizeNativeKey(*nativeID); err != nil {\n87|\t\t\treturn Actor{}, err\n88|\t\t}\n89|\t}\n90|\tmodel, err := checkNullableBoundedString(members, \"model\", 1, 512, index, \"actor\")\n91|\tif err != nil {\n92|\t\treturn Actor{}, err\n93|\t}\n94|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n95|\t\treturn Actor{}, invalid(\"actor[%d] extensions %s\", index, extensionsFault)\n96|\t}\n97|\treturn Actor{\n98|\t\tActorID:        actorID,\n99|\t\tKind:           kind,\n100|\t\tParentActorID:  parent,\n101|\t\tName:           name,\n102|\t\tSourceNativeID: nativeID,\n103|\t\tModel:          model,\n104|\t}, nil\n105|}\n106|\n107|func checkNullableBoundedString(members map[string]json.RawMessage, name string, minimum, maximum, index int, owner string) (*string, error) {\n108|\traw, present := members[name]\n109|\tif !present {\n110|\t\treturn nil, invalid(\"%s[%d] misses a required member %q\", owner, index, name)\n111|\t}\n112|\tif isNull(raw) {\n113|\t\treturn nil, nil\n114|\t}\n115|\tvalue, ok := checkStringBounds(raw, minimum, maximum)\n116|\tif !ok {\n117|\t\treturn nil, invalid(\"%s[%d] %s is not a string[%d..%d]\", owner, index, name, minimum, maximum)\n118|\t}\n119|\treturn &value, nil\n120|}\n121|\n122|// ActorInput is one caller-supplied actor candidate for Build.\n123|type ActorInput struct {\n124|\tActorID        string\n125|\tKind           string\n126|\tParentActorID  *string\n127|\tName           *string\n128|\tSourceNativeID *string\n129|\tModel          *string\n130|}\n131|\n132|func buildActor(input ActorInput, index int) (Actor, error) {\n133|\tactorID, err := scalar.ParseUUIDv7(input.ActorID)\n134|\tif err != nil {\n135|\t\treturn Actor{}, invalid(\"actor[%d] actor_id is not a UUIDv7: %v\", index, err)\n136|\t}\n137|\tif !validActorKind(input.Kind) {\n138|\t\treturn Actor{}, invalid(\"actor[%d] kind is outside main|subagent|external\", index)\n139|\t}\n140|\tvar parent *scalar.UUIDv7\n141|\tif input.ParentActorID != nil {\n142|\t\tvalue, err := scalar.ParseUUIDv7(*input.ParentActorID)\n143|\t\tif err != nil {\n144|\t\t\treturn Actor{}, invalid(\"actor[%d] parent_actor_id is not a UUIDv7: %v\", index, err)\n145|\t\t}\n146|\t\tparent = &value\n147|\t}\n148|\tif input.Kind == \"main\" && parent != nil {\n149|\t\treturn Actor{}, invalid(\"actor[%d] main actor carries a parent\", index)\n150|\t}\n151|\tif input.Kind != \"main\" && parent == nil {\n152|\t\treturn Actor{}, invalid(\"actor[%d] non-main actor requires a parent\", index)\n153|\t}\n154|\tif input.Name != nil {\n155|\t\tif !validText(*input.Name) {\n156|\t\t\treturn Actor{}, invalid(\"actor[%d] name is not valid UTF-8\", index)\n157|\t\t}\n158|\t\tif stringLength(*input.Name) < 1 || stringLength(*input.Name) > 512 {\n159|\t\t\treturn Actor{}, invalid(\"actor[%d] name is not a string[1..512]\", index)\n160|\t\t}\n161|\t}\n162|\tif input.SourceNativeID != nil {\n163|\t\tif stringLength(*input.SourceNativeID) < 1 || stringLength(*input.SourceNativeID) > 512 {\n164|\t\t\treturn Actor{}, invalid(\"actor[%d] source_native_id is not a string[1..512]\", index)\n165|\t\t}\n166|\t\tif err := SanitizeNativeKey(*input.SourceNativeID); err != nil {\n167|\t\t\treturn Actor{}, err\n168|\t\t}\n169|\t}\n170|\tif input.Model != nil {\n171|\t\tif !validText(*input.Model) {\n172|\t\t\treturn Actor{}, invalid(\"actor[%d] model is not valid UTF-8\", index)\n173|\t\t}\n174|\t\tif stringLength(*input.Model) < 1 || stringLength(*input.Model) > 512 {\n175|\t\t\treturn Actor{}, invalid(\"actor[%d] model is not a string[1..512]\", index)\n176|\t\t}\n177|\t}\n178|\treturn Actor{\n179|\t\tActorID:        actorID,\n180|\t\tKind:           input.Kind,\n181|\t\tParentActorID:  parent,\n182|\t\tName:           input.Name,\n183|\t\tSourceNativeID: input.SourceNativeID,\n184|\t\tModel:          input.Model,\n185|\t}, nil\n186|}\n187|\n188|func actorObject(actor Actor) map[string]any {\n189|\tvar parent any\n190|\tif actor.ParentActorID != nil {\n191|\t\tparent = actor.ParentActorID.String()\n192|\t}\n193|\tvar name any\n194|\tif actor.Name != nil {\n195|\t\tname = *actor.Name\n196|\t}\n197|\tvar nativeID any\n198|\tif actor.SourceNativeID != nil {\n199|\t\tnativeID = *actor.SourceNativeID\n200|\t}\n201|\tvar model any\n202|\tif actor.Model != nil {\n203|\t\tmodel = *actor.Model\n204|\t}\n205|\treturn map[string]any{\n206|\t\t\"actor_id\":         actor.ActorID.String(),\n207|\t\t\"kind\":             actor.Kind,\n208|\t\t\"parent_actor_id\":  parent,\n209|\t\t\"name\":             name,\n210|\t\t\"source_native_id\": nativeID,\n211|\t\t\"model\":            model,\n212|\t\t\"extensions\":       map[string]any{},\n213|\t}\n214|}\n215|\n216|var canonicalSessionMembers = map[string]bool{\n217|\t\"schema\": true, \"schema_version\": true, \"canonical_session_id\": true,\n218|\t\"logical_session_id\": true, \"source_environment\": true,\n219|\t\"source_native_session_id\": true, \"title\": true, \"workspace\": true,\n220|\t\"actors\": true, \"event_ids\": true, \"head_event_ids\": true,\n221|\t\"created_at\": true, \"updated_at\": true, \"extensions\": true,\n222|}\n223|\n224|var canonicalSessionRequired = []string{\n225|\t\"schema\", \"schema_version\", \"canonical_session_id\",\n226|\t\"logical_session_id\", \"source_environment\",\n227|\t\"source_native_session_id\", \"title\", \"workspace\",\n228|\t\"actors\", \"event_ids\", \"head_event_ids\",\n229|\t\"created_at\", \"updated_at\", \"extensions\",\n230|}\n231|\n232|// CanonicalSession is one validated Canonical Session.\n233|type CanonicalSession struct {\n234|\tSessionID             scalar.Digest\n235|\tLogicalSessionID      scalar.UUIDv7\n236|\tSourceEnvironment     sessadapter.Tuple\n237|\tSourceNativeSessionID string\n238|\tTitle                 *string\n239|\tWorkspace             WorkspaceBinding\n240|\tActors                []Actor\n241|\tEventIDs              []scalar.Digest\n242|\tHeadEventIDs          []scalar.Digest\n243|\tCreatedAt             *scalar.Timestamp\n244|\tUpdatedAt             *scalar.Timestamp\n245|}\n246|\n247|// CanonicalSessionInput is the caller-supplied canonical session\n248|// candidate for Build.\n249|type CanonicalSessionInput struct {\n250|\tLogicalSessionID      string\n251|\tSourceEnvironment     []byte\n252|\tSourceNativeSessionID string\n253|\tTitle                 *string\n254|\tWorkspace             []byte\n255|\tActors                []ActorInput\n256|\tEventIDs              []string\n257|\tHeadEventIDs          []string\n258|\tCreatedAt             *string\n259|\tUpdatedAt             *string\n260|\tExtensions            map[string]any\n261|}\n262|\n263|// BuildCanonicalSession constructs one closed Canonical Session\n264|// 1.0.0 as canonical bytes. Identical inputs produce byte-identical\n265|// outputs.\n266|func BuildCanonicalSession(input CanonicalSessionInput) ([]byte, error) {\n267|\tobject, err := buildCanonicalSession(input)\n268|\tif err != nil {\n269|\t\treturn nil, err\n270|\t}\n271|\tomitted, err := canonicalizeObject(object)\n272|\tif err != nil {\n273|\t\treturn nil, err\n274|\t}\n275|\tsessionID := scalar.SHA256Digest(omitted)\n276|\tobject[canonicalSessionSelf] = sessionID.String()\n277|\treturn canonicalizeObject(object)\n278|}\n279|\n280|func buildCanonicalSession(input CanonicalSessionInput) (map[string]any, error) {\n281|\tlogical, err := scalar.ParseUUIDv7(input.LogicalSessionID)\n282|\tif err != nil {\n283|\t\treturn nil, invalid(\"canonical session logical_session_id is not a UUIDv7: %v\", err)\n284|\t}\n285|\ttuple, err := sessadapter.DecodeTuple(json.RawMessage(input.SourceEnvironment))\n286|\tif err != nil {\n287|\t\treturn nil, invalid(\"canonical session source_environment is not an Environment Tuple: %v\", err)\n288|\t}\n289|\tif stringLength(input.SourceNativeSessionID) < 1 || stringLength(input.SourceNativeSessionID) > 512 {\n290|\t\treturn nil, invalid(\"canonical session source_native_session_id is not a string[1..512]\")\n291|\t}\n292|\tif err := SanitizeNativeKey(input.SourceNativeSessionID); err != nil {\n293|\t\treturn nil, err\n294|\t}\n295|\tvar title any\n296|\tif input.Title != nil {\n297|\t\tif !validText(*input.Title) {\n298|\t\t\treturn nil, invalid(\"canonical session title is not valid UTF-8\")\n299|\t\t}\n300|\t\tif stringLength(*input.Title) < 1 || stringLength(*input.Title) > 4096 {\n301|\t\t\treturn nil, invalid(\"canonical session title is not a string[1..4096]\")\n302|\t\t}\n303|\t\ttitle = *input.Title\n304|\t}\n305|\tif _, err := DecodeWorkspaceBinding(json.RawMessage(input.Workspace)); err != nil {\n306|\t\treturn nil, err\n307|\t}\n308|\tif len(input.Actors) < 1 || len(input.Actors) > 1024 {\n309|\t\treturn nil, invalid(\"canonical session carries %d actors, want [1..1024]\", len(input.Actors))\n310|\t}\n311|\tactors := make([]Actor, 0, len(input.Actors))\n312|\tseenActors := map[string]bool{}\n313|\tmainCount := 0\n314|\tfor index, candidate := range input.Actors {\n315|\t\tactor, err := buildActor(candidate, index)\n316|\t\tif err != nil {\n317|\t\t\treturn nil, err\n318|\t\t}\n319|\t\tif seenActors[actor.ActorID.String()] {\n320|\t\t\treturn nil, invalid(\"canonical session actors are not unique by actor ID\")\n321|\t\t}\n322|\t\tseenActors[actor.ActorID.String()] = true\n323|\t\tif actor.Kind == \"main\" {\n324|\t\t\tmainCount++\n325|\t\t}\n326|\t\tactors = append(actors, actor)\n327|\t}\n328|\tif mainCount != 1 {\n329|\t\treturn nil, invalid(\"canonical session carries %d main actors, want exactly one\", mainCount)\n330|\t}\n331|\teventIDs, err := parseOrderedUniqueDigests(input.EventIDs, 1, 1000000, \"event_ids\")\n332|\tif err != nil {\n333|\t\treturn nil, err\n334|\t}\n335|\theadIDs, err := parseSortedUniqueDigestStrings(input.HeadEventIDs, 1, 1024, \"head_event_ids\")\n336|\tif err != nil {\n337|\t\treturn nil, err\n338|\t}\n339|\teventSet := map[string]bool{}\n340|\tfor _, id := range eventIDs {\n341|\t\teventSet[id.String()] = true\n342|\t}\n343|\tfor _, id := range headIDs {\n344|\t\tif !eventSet[id.String()] {\n345|\t\t\treturn nil, invalid(\"canonical session head_event_ids carry an ID outside event_ids\")\n346|\t\t}\n347|\t}\n348|\tcreatedAt, err := parseNullableTimestamp(input.CreatedAt, \"created_at\")\n349|\tif err != nil {\n350|\t\treturn nil, err\n351|\t}\n352|\tupdatedAt, err := parseNullableTimestamp(input.UpdatedAt, \"updated_at\")\n353|\tif err != nil {\n354|\t\treturn nil, err\n355|\t}\n356|\tif _, err := encodeExtensions(input.Extensions); err != nil {\n357|\t\treturn nil, err\n358|\t}\n359|\tvar workspaceValue any\n360|\tif err := json.Unmarshal(bytesTrimSpace(json.RawMessage(input.Workspace)), &workspaceValue); err != nil {\n361|\t\treturn nil, invalid(\"canonical session workspace is not JSON: %v\", err)\n362|\t}\n363|\tactorObjects := make([]any, 0, len(actors))\n364|\tfor _, actor := range actors {\n365|\t\tactorObjects = append(actorObjects, actorObject(actor))\n366|\t}\n367|\treturn map[string]any{\n368|\t\t\"schema\":                   canonicalSessionSchema,\n369|\t\t\"schema_version\":           canonicalSessionVersion,\n370|\t\t\"logical_session_id\":       logical.String(),\n371|\t\t\"source_environment\":       tupleObject(tuple),\n372|\t\t\"source_native_session_id\": input.SourceNativeSessionID,\n373|\t\t\"title\":                    title,\n374|\t\t\"workspace\":                workspaceValue,\n375|\t\t\"actors\":                   actorObjects,\n376|\t\t\"event_ids\":                digestStrings(eventIDs),\n377|\t\t\"head_event_ids\":           digestStrings(headIDs),\n378|\t\t\"created_at\":               createdAt,\n379|\t\t\"updated_at\":               updatedAt,\n380|\t\t\"extensions\":               extensionValue(input.Extensions),\n381|\t}, nil\n382|}\n383|\n384|// DecodeCanonicalSession validates one closed Canonical Session\n385|// 1.0.0: exact members, schema/version, self-digest agreement,\n386|// exactly one main actor, ordered unique event IDs, and head IDs\n387|// drawn from the event set.\n388|func DecodeCanonicalSession(data []byte) (CanonicalSession, error) {\n389|\tmembers, fault := decodeStrictObject(data)\n390|\tif fault != nil {\n391|\t\treturn CanonicalSession{}, invalid(\"canonical session %s (%s)\", fault.detail, memberField(fault.member))\n392|\t}\n393|\tif name, unknown := unknownMember(members, canonicalSessionMembers); unknown {\n394|\t\treturn CanonicalSession{}, invalid(\"canonical session carries unknown member %q\", name)\n395|\t}\n396|\tif name, missing := missingMember(members, canonicalSessionRequired); missing {\n397|\t\treturn CanonicalSession{}, invalid(\"canonical session misses a required member %q\", name)\n398|\t}\n399|\tschema, ok := rawString(members[\"schema\"])\n400|\tif !ok || schema != canonicalSessionSchema {\n401|\t\treturn CanonicalSession{}, invalid(\"canonical session schema is not the canonical session\")\n402|\t}\n403|\tversion, ok := rawString(members[\"schema_version\"])\n404|\tif !ok || version != canonicalSessionVersion {\n405|\t\treturn CanonicalSession{}, invalid(\"canonical session version is not 1.0.0\")\n406|\t}\n407|\tsessionID, ok := checkDigest(members[canonicalSessionSelf])\n408|\tif !ok {\n409|\t\treturn CanonicalSession{}, invalid(\"canonical session canonical_session_id is not a digest\")\n410|\t}\n411|\tlogical, ok := checkUUIDv7(members[\"logical_session_id\"])\n412|\tif !ok {\n413|\t\treturn CanonicalSession{}, invalid(\"canonical session logical_session_id is not a UUIDv7\")\n414|\t}\n415|\ttuple, err := sessadapter.DecodeTuple(members[\"source_environment\"])\n416|\tif err != nil {\n417|\t\treturn CanonicalSession{}, invalid(\"canonical session source_environment is not an Environment Tuple: %v\", err)\n418|\t}\n419|\tnativeID, ok := checkStringBounds(members[\"source_native_session_id\"], 1, 512)\n420|\tif !ok {\n421|\t\treturn CanonicalSession{}, invalid(\"canonical session source_native_session_id is not a string[1..512]\")\n422|\t}\n423|\tif err := SanitizeNativeKey(nativeID); err != nil {\n424|\t\treturn CanonicalSession{}, err\n425|\t}\n426|\tvar title *string\n427|\tif !isNull(members[\"title\"]) {\n428|\t\tvalue, ok := checkStringBounds(members[\"title\"], 1, 4096)\n429|\t\tif !ok {\n430|\t\t\treturn CanonicalSession{}, invalid(\"canonical session title is not a string[1..4096]\")\n431|\t\t}\n432|\t\ttitle = &value\n433|\t}\n434|\tworkspace, err := DecodeWorkspaceBinding(members[\"workspace\"])\n435|\tif err != nil {\n436|\t\treturn CanonicalSession{}, err\n437|\t}\n438|\tactors, err := decodeActors(members[\"actors\"])\n439|\tif err != nil {\n440|\t\treturn CanonicalSession{}, err\n441|\t}\n442|\teventIDs, err := decodeOrderedUniqueDigests(members[\"event_ids\"], 1, 1000000, \"event_ids\")\n443|\tif err != nil {\n444|\t\treturn CanonicalSession{}, err\n445|\t}\n446|\theadIDs, ok := checkSortedUniqueDigests(members[\"head_event_ids\"], 1, 1024)\n447|\tif !ok {\n448|\t\treturn CanonicalSession{}, invalid(\"canonical session head_event_ids are not sorted unique digest[1..1024]\")\n449|\t}\n450|\teventSet := map[string]bool{}\n451|\tfor _, id := range eventIDs {\n452|\t\teventSet[id.String()] = true\n453|\t}\n454|\tfor _, id := range headIDs {\n455|\t\tif !eventSet[id.String()] {\n456|\t\t\treturn CanonicalSession{}, invalid(\"canonical session head_event_ids carry an ID outside event_ids\")\n457|\t\t}\n458|\t}\n459|\tcreatedAt, err := decodeNullableTimestamp(members, \"created_at\", \"canonical session\")\n460|\tif err != nil {\n461|\t\treturn CanonicalSession{}, err\n462|\t}\n463|\tupdatedAt, err := decodeNullableTimestamp(members, \"updated_at\", \"canonical session\")\n464|\tif err != nil {\n465|\t\treturn CanonicalSession{}, err\n466|\t}\n467|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n468|\t\treturn CanonicalSession{}, invalid(\"canonical session extensions %s\", extensionsFault)\n469|\t}\n470|\tif err := verifySelfDigest(members, canonicalSessionSelf, sessionID); err != nil {\n471|\t\treturn CanonicalSession{}, err\n472|\t}\n473|\treturn CanonicalSession{\n474|\t\tSessionID:             sessionID,\n475|\t\tLogicalSessionID:      logical,\n476|\t\tSourceEnvironment:     tuple,\n477|\t\tSourceNativeSessionID: nativeID,\n478|\t\tTitle:                 title,\n479|\t\tWorkspace:             workspace,\n480|\t\tActors:                actors,\n481|\t\tEventIDs:              eventIDs,\n482|\t\tHeadEventIDs:          headIDs,\n483|\t\tCreatedAt:             createdAt,\n484|\t\tUpdatedAt:             updatedAt,\n485|\t}, nil\n486|}\n487|\n488|func decodeActors(raw json.RawMessage) ([]Actor, error) {\n489|\telements, ok := decodeArray(raw)\n490|\tif !ok {\n491|\t\treturn nil, invalid(\"canonical session actors are not an array\")\n492|\t}\n493|\tif len(elements) < 1 || len(elements) > 1024 {\n494|\t\treturn nil, invalid(\"canonical session carries %d actors, want [1..1024]\", len(elements))\n495|\t}\n496|\tactors := make([]Actor, 0, len(elements))\n497|\tseen := map[string]bool{}\n498|\tmainCount := 0\n499|\tfor index, element := range elements {\n500|\t\tactor, err := decodeActor(element, index)\n(more lines below)","final_result":true}}}
