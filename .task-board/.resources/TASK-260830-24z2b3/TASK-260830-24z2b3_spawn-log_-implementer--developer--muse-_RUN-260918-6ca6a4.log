{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5f7","stream":{"kind":"session","id":"01a0b1d2-62fd-7091-a15f-687f76c867f4"},"sequence":342,"recorded_at":1780531400000679,"record_type":"event","durability":"durable","causation_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","run_stream":{"kind":"run","id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb"},"call_id":"call_01a0b1d457ea72f5ace57c0713fe5e9f","text":"Read text file `internal/clonebundle/identity.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"strings\"\n6|\t\"unicode\"\n7|\t\"unicode/utf8\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// This file validates the Section 13.14.1 identities: NativeIdentity,\n13|// WorkspaceBinding, and the sanitized native-key admission shared by\n14|// every native key in this package. Sanitized means printable,\n15|// relative, and unambiguously native: never an absolute source path,\n16|// never an AX Session identity, never carrying embedded credentials.\n17|\n18|var nativeIdentityMembers = map[string]bool{\n19|\t\"native_session_id\":         true,\n20|\t\"identity_kind\":             true,\n21|\t\"logical_workspace_id\":      true,\n22|\t\"backend_realm_fingerprint\": true,\n23|\t\"opaque_identity\":           true,\n24|\t\"extensions\":                true,\n25|}\n26|\n27|var nativeIdentityRequired = []string{\n28|\t\"native_session_id\",\n29|\t\"identity_kind\",\n30|\t\"logical_workspace_id\",\n31|\t\"backend_realm_fingerprint\",\n32|\t\"opaque_identity\",\n33|\t\"extensions\",\n34|}\n35|\n36|var nativeIdentityKinds = []string{\n37|\t\"provider_native\",\n38|\t\"official_import\",\n39|\t\"continuation_context\",\n40|}\n41|\n42|func validNativeIdentityKind(kind string) bool {\n43|\tfor _, allowed := range nativeIdentityKinds {\n44|\t\tif kind == allowed {\n45|\t\t\treturn true\n46|\t\t}\n47|\t}\n48|\treturn false\n49|}\n50|\n51|// NativeIdentity is one validated sanitized native identity.\n52|type NativeIdentity struct {\n53|\tNativeSessionID         string\n54|\tIdentityKind            string\n55|\tLogicalWorkspaceID      scalar.UUIDv7\n56|\tBackendRealmFingerprint *scalar.Digest\n57|\tOpaqueIdentity          *string\n58|}\n59|\n60|// DecodeNativeIdentity validates one closed NativeIdentity: exact\n61|// members, the closed identity-kind vocabulary, a sanitized native\n62|// session ID, a UUIDv7 logical workspace, an optional digest realm\n63|// fingerprint, an optional sanitized opaque identity, and\n64|// reverse-DNS extensions. Credential, absolute-path, PID, socket,\n65|// token, and secret-environment material is refused by the shared\n66|// sanitizer, never laundered into an identity.\n67|func DecodeNativeIdentity(raw json.RawMessage) (NativeIdentity, error) {\n68|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n69|\tif fault != nil {\n70|\t\treturn NativeIdentity{}, invalid(\"native identity %s (%s)\", fault.detail, memberField(fault.member))\n71|\t}\n72|\tif name, unknown := unknownMember(members, nativeIdentityMembers); unknown {\n73|\t\treturn NativeIdentity{}, invalid(\"native identity carries unknown member %q\", name)\n74|\t}\n75|\tif name, missing := missingMember(members, nativeIdentityRequired); missing {\n76|\t\treturn NativeIdentity{}, invalid(\"native identity misses a required member %q\", name)\n77|\t}\n78|\tnativeID, ok := checkStringBounds(members[\"native_session_id\"], 1, 512)\n79|\tif !ok {\n80|\t\treturn NativeIdentity{}, invalid(\"native identity native_session_id is not a string[1..512]\")\n81|\t}\n82|\tif err := SanitizeNativeKey(nativeID); err != nil {\n83|\t\treturn NativeIdentity{}, err\n84|\t}\n85|\tkind, ok := rawString(members[\"identity_kind\"])\n86|\tif !ok || !validNativeIdentityKind(kind) {\n87|\t\treturn NativeIdentity{}, invalid(\"native identity kind is outside provider_native|official_import|continuation_context\")\n88|\t}\n89|\tworkspaceID, ok := checkUUIDv7(members[\"logical_workspace_id\"])\n90|\tif !ok {\n91|\t\treturn NativeIdentity{}, invalid(\"native identity logical_workspace_id is not a UUIDv7\")\n92|\t}\n93|\tvar fingerprint *scalar.Digest\n94|\tif !isNull(members[\"backend_realm_fingerprint\"]) {\n95|\t\tdigest, ok := checkDigest(members[\"backend_realm_fingerprint\"])\n96|\t\tif !ok {\n97|\t\t\treturn NativeIdentity{}, invalid(\"native identity backend_realm_fingerprint is not a digest\")\n98|\t\t}\n99|\t\tfingerprint = &digest\n100|\t}\n101|\tvar opaque *string\n102|\tif !isNull(members[\"opaque_identity\"]) {\n103|\t\tvalue, ok := checkStringBounds(members[\"opaque_identity\"], 1, 512)\n104|\t\tif !ok {\n105|\t\t\treturn NativeIdentity{}, invalid(\"native identity opaque_identity is not a string[1..512]\")\n106|\t\t}\n107|\t\tif err := SanitizeNativeKey(value); err != nil {\n108|\t\t\treturn NativeIdentity{}, err\n109|\t\t}\n110|\t\topaque = &value\n111|\t}\n112|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n113|\t\treturn NativeIdentity{}, invalid(\"native identity extensions %s\", extensionsFault)\n114|\t}\n115|\treturn NativeIdentity{\n116|\t\tNativeSessionID:         nativeID,\n117|\t\tIdentityKind:            kind,\n118|\t\tLogicalWorkspaceID:      workspaceID,\n119|\t\tBackendRealmFingerprint: fingerprint,\n120|\t\tOpaqueIdentity:          opaque,\n121|\t}, nil\n122|}\n123|\n124|// EncodeNativeIdentity renders one validated identity as canonical\n125|// bytes under the given extensions. The native session ID and the\n126|// opaque identity are sanitized here, before marshaling —\n127|// encoding/json would otherwise rewrite invalid UTF-8 to U+FFFD and\n128|// the caller's re-decode would only ever see the rewritten bytes,\n129|// laundering a native key past the sanitizer's own refusal and\n130|// sealing two distinct inputs to byte-identical objects. The\n131|// extensions are validated here too, so encoding never admits what\n132|// decoding refused. A nil extensions map encodes as the empty\n133|// object.\n134|func EncodeNativeIdentity(identity NativeIdentity, extensions map[string]any) ([]byte, error) {\n135|\tif err := SanitizeNativeKey(identity.NativeSessionID); err != nil {\n136|\t\treturn nil, err\n137|\t}\n138|\tif identity.OpaqueIdentity != nil {\n139|\t\tif err := SanitizeNativeKey(*identity.OpaqueIdentity); err != nil {\n140|\t\t\treturn nil, err\n141|\t\t}\n142|\t}\n143|\tif _, err := encodeExtensions(extensions); err != nil {\n144|\t\treturn nil, err\n145|\t}\n146|\tvar fingerprint any\n147|\tif identity.BackendRealmFingerprint != nil {\n148|\t\tfingerprint = identity.BackendRealmFingerprint.String()\n149|\t}\n150|\tvar opaque any\n151|\tif identity.OpaqueIdentity != nil {\n152|\t\topaque = *identity.OpaqueIdentity\n153|\t}\n154|\tif extensions == nil {\n155|\t\textensions = map[string]any{}\n156|\t}\n157|\treturn canonicalizeObject(map[string]any{\n158|\t\t\"native_session_id\":         identity.NativeSessionID,\n159|\t\t\"identity_kind\":             identity.IdentityKind,\n160|\t\t\"logical_workspace_id\":      identity.LogicalWorkspaceID.String(),\n161|\t\t\"backend_realm_fingerprint\": fingerprint,\n162|\t\t\"opaque_identity\":           opaque,\n163|\t\t\"extensions\":                extensions,\n164|\t})\n165|}\n166|\n167|var workspaceBindingMembers = map[string]bool{\n168|\t\"logical_workspace_id\":           true,\n169|\t\"cwd_relative\":                   true,\n170|\t\"repository_remote_fingerprints\": true,\n171|\t\"branch\":                         true,\n172|\t\"head_digest\":                    true,\n173|\t\"index_digest\":                   true,\n174|\t\"working_tree_digest\":            true,\n175|\t\"extensions\":                     true,\n176|}\n177|\n178|var workspaceBindingRequired = []string{\n179|\t\"logical_workspace_id\",\n180|\t\"cwd_relative\",\n181|\t\"repository_remote_fingerprints\",\n182|\t\"branch\",\n183|\t\"head_digest\",\n184|\t\"index_digest\",\n185|\t\"working_tree_digest\",\n186|\t\"extensions\",\n187|}\n188|\n189|// WorkspaceBinding is one validated closed workspace binding. No\n190|// member grants filesystem authority: the cwd is a normalized\n191|// relative path beneath the Workspace Group root, never an absolute\n192|// path or an escape.\n193|type WorkspaceBinding struct {\n194|\tLogicalWorkspaceID scalar.UUIDv7\n195|\tCwdRelative        string\n196|\tRemoteFingerprints []scalar.Digest\n197|\tBranch             *string\n198|\tHeadDigest         *scalar.Digest\n199|\tIndexDigest        *scalar.Digest\n200|\tWorkingTreeDigest  *scalar.Digest\n201|}\n202|\n203|// DecodeWorkspaceBinding validates one closed WorkspaceBinding.\n204|func DecodeWorkspaceBinding(raw json.RawMessage) (WorkspaceBinding, error) {\n205|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n206|\tif fault != nil {\n207|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding %s (%s)\", fault.detail, memberField(fault.member))\n208|\t}\n209|\tif name, unknown := unknownMember(members, workspaceBindingMembers); unknown {\n210|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding carries unknown member %q\", name)\n211|\t}\n212|\tif name, missing := missingMember(members, workspaceBindingRequired); missing {\n213|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding misses a required member %q\", name)\n214|\t}\n215|\tworkspaceID, ok := checkUUIDv7(members[\"logical_workspace_id\"])\n216|\tif !ok {\n217|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding logical_workspace_id is not a UUIDv7\")\n218|\t}\n219|\tcwd, ok := checkStringBounds(members[\"cwd_relative\"], 1, 4096)\n220|\tif !ok {\n221|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding cwd_relative is not a string[1..4096]\")\n222|\t}\n223|\tif err := checkCwdRelative(cwd); err != nil {\n224|\t\treturn WorkspaceBinding{}, err\n225|\t}\n226|\tfingerprints, ok := checkSortedUniqueDigests(members[\"repository_remote_fingerprints\"], 0, 128)\n227|\tif !ok {\n228|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding repository_remote_fingerprints are not sorted unique digest[0..128]\")\n229|\t}\n230|\tvar branch *string\n231|\tif !isNull(members[\"branch\"]) {\n232|\t\tvalue, ok := checkStringBounds(members[\"branch\"], 1, 1024)\n233|\t\tif !ok {\n234|\t\t\treturn WorkspaceBinding{}, invalid(\"workspace binding branch is not a string[1..1024]\")\n235|\t\t}\n236|\t\tbranch = &value\n237|\t}\n238|\thead, err := checkNullableDigest(members, \"head_digest\", \"workspace binding\")\n239|\tif err != nil {\n240|\t\treturn WorkspaceBinding{}, err\n241|\t}\n242|\tindex, err := checkNullableDigest(members, \"index_digest\", \"workspace binding\")\n243|\tif err != nil {\n244|\t\treturn WorkspaceBinding{}, err\n245|\t}\n246|\ttree, err := checkNullableDigest(members, \"working_tree_digest\", \"workspace binding\")\n247|\tif err != nil {\n248|\t\treturn WorkspaceBinding{}, err\n249|\t}\n250|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n251|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding extensions %s\", extensionsFault)\n252|\t}\n253|\treturn WorkspaceBinding{\n254|\t\tLogicalWorkspaceID: workspaceID,\n255|\t\tCwdRelative:        cwd,\n256|\t\tRemoteFingerprints: fingerprints,\n257|\t\tBranch:             branch,\n258|\t\tHeadDigest:         head,\n259|\t\tIndexDigest:        index,\n260|\t\tWorkingTreeDigest:  tree,\n261|\t}, nil\n262|}\n263|\n264|// checkCwdRelative admits exactly the normalized relative paths\n265|// beneath (or equal to) the Workspace Group root: scalar relative\n266|// paths plus the root itself (\".\"). Anything else — absolute,\n267|// escaped, backslashed, encoded-separator, or dot-segment forms —\n268|// would grant or smuggle filesystem authority and is refused.\n269|func checkCwdRelative(cwd string) error {\n270|\tif cwd == \".\" {\n271|\t\treturn nil\n272|\t}\n273|\tif _, err := scalar.ParseRelativePath(cwd); err != nil {\n274|\t\treturn invalid(\"workspace binding cwd_relative is not normalized beneath the workspace root: %v\", err)\n275|\t}\n276|\treturn nil\n277|}\n278|\n279|func checkNullableDigest(members map[string]json.RawMessage, name, owner string) (*scalar.Digest, error) {\n280|\traw, present := members[name]\n281|\tif !present {\n282|\t\treturn nil, invalid(\"%s misses a required member %q\", owner, name)\n283|\t}\n284|\tif isNull(raw) {\n285|\t\treturn nil, nil\n286|\t}\n287|\tdigest, ok := checkDigest(raw)\n288|\tif !ok {\n289|\t\treturn nil, invalid(\"%s %s is not a digest\", owner, name)\n290|\t}\n291|\treturn &digest, nil\n292|}\n293|\n294|// SanitizeNativeKey refuses every native key that is not sanitized:\n295|// empty values are refused here (over-long values by the caller's\n296|// bound check), and this gate refuses control characters (the full\n297|// Cc class, C0 and C1), invisible format characters (Cf, Zl, Zp:\n298|// zero-width and separator marks that render invisibly),\n299|// absolute-path forms, a UUIDv7 form (indistinguishable from a\n300|// fabricated AX Session identity), embedded-credential forms (a\n301|// password-style colon before the first @, with or without a\n302|// scheme), and AX-schema markers in any case. The pinned text does\n303|// not define the sanitizer's exact scope, so the implemented bound\n304|// is exactly this list, pinned by the sanitizer corpus and stated\n305|// in TRACEABILITY.md: ordinary spaces, @ without a password\n306|// colon, and colons without an @ all admit. A native key that\n307|// survives is printable, relative, and unambiguously native.\n308|func SanitizeNativeKey(key string) error {\n309|\tif key == \"\" {\n310|\t\treturn invalid(\"native key is empty\")\n311|\t}\n312|\tif !utf8.ValidString(key) {\n313|\t\treturn invalid(\"native key is not valid UTF-8\")\n314|\t}\n315|\tfor _, unit := range key {\n316|\t\tif unicode.IsControl(unit) {\n317|\t\t\treturn invalid(\"native key carries control characters\")\n318|\t\t}\n319|\t\tif unicode.Is(unicode.Cf, unit) || unicode.Is(unicode.Zl, unit) || unicode.Is(unicode.Zp, unit) {\n320|\t\t\treturn invalid(\"native key carries invisible format characters\")\n321|\t\t}\n322|\t}\n323|\tif strings.HasPrefix(key, \"/\") || strings.HasPrefix(key, `\\\\`) || hasDrivePrefix(key) {\n324|\t\treturn invalid(\"native key is an absolute source path, never a cross-host identity\")\n325|\t}\n326|\tif _, err := scalar.ParseUUIDv7(key); err == nil {\n327|\t\treturn invalid(\"native key %q is a UUIDv7, indistinguishable from a fabricated AX Session identity\", key)\n328|\t}\n329|\tif strings.Contains(strings.ToLower(key), \"urn:ax:\") {\n330|\t\treturn invalid(\"native key carries an AX identity marker\")\n331|\t}\n332|\tif at := strings.Index(key, \"@\"); at >= 0 && strings.Contains(key[:at], \":\") {\n333|\t\treturn invalid(\"native key carries embedded credentials\")\n334|\t}\n335|\treturn nil\n336|}\n337|\n338|func hasDrivePrefix(value string) bool {\n339|\treturn len(value) >= 3 && ((value[0] >= 'a' && value[0] <= 'z') || (value[0] >= 'A' && value[0] <= 'Z')) && value[1] == ':' && (value[2] == '/' || value[2] == '\\\\')\n340|}\n341|\n342|func memberField(member string) string {\n343|\tif member == \"\" {\n344|\t\treturn \"frame\"\n345|\t}\n346|\treturn \"member \" + member\n347|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5f9","stream":{"kind":"session","id":"01a0b1d2-62fd-7091-a15f-687f76c867f4"},"sequence":343,"recorded_at":1780531400000681,"record_type":"event","durability":"durable","causation_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","run_stream":{"kind":"run","id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb"},"call_id":"call_01a0b1d459b676d6a160bebb6cb4001f","text":"Read text file `internal/clonebundle/generation.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n7|)\n8|\n9|// This file owns the Section 13.14.1 immutable generations: the\n10|// source_generation strings carried by StableSnapshotProof and the\n11|// unstable-archive Capture Boundary, and the snapshot-identity digest\n12|// that pins an immutable snapshot. Generations are opaque immutable\n13|// tokens: a generation never mutates, and equality is exact string\n14|// equality. Capture digests that must agree (stable pre/post) are\n15|// compared by digest equality here so both boundary validators share\n16|// one comparison.\n17|\n18|// Generation is one validated immutable source generation token:\n19|// string[1..512], opaque to the core.\n20|type Generation struct {\n21|\tvalue string\n22|}\n23|\n24|// ParseGeneration validates one generation token. Empty,\n25|// over-long, and invalid-UTF-8 tokens are refused; every other text\n26|// content crosses opaquely, because generations are native-store\n27|// tokens the core compares but never interprets. The UTF-8 gate\n28|// matters because the token seals into the boundary bytes: without\n29|// it the marshaler would rewrite invalid bytes to U+FFFD and two\n30|// distinct generations would seal byte-identical.\n31|func ParseGeneration(value string) (Generation, error) {\n32|\tif !validText(value) {\n33|\t\treturn Generation{}, invalid(\"source generation is not valid UTF-8\")\n34|\t}\n35|\tif stringLength(value) < 1 || stringLength(value) > 512 {\n36|\t\treturn Generation{}, invalid(\"source generation is not a string[1..512]\")\n37|\t}\n38|\treturn Generation{value: value}, nil\n39|}\n40|\n41|// MustParseGeneration validates one generation token and panics on\n42|// refusal. Tests and fixed fixtures use it; production paths use\n43|// ParseGeneration and return the refusal.\n44|func MustParseGeneration(value string) Generation {\n45|\tgeneration, err := ParseGeneration(value)\n46|\tif err != nil {\n47|\t\tpanic(err)\n48|\t}\n49|\treturn generation\n50|}\n51|\n52|func (generation Generation) String() string { return generation.value }\n53|\n54|// Equal reports exact generation equality. Generations are\n55|// immutable: two captures name the same source state if and only if\n56|// their tokens are byte-identical.\n57|func (generation Generation) Equal(other Generation) bool {\n58|\treturn generation.value == other.value\n59|}\n60|\n61|func checkGeneration(raw json.RawMessage) (Generation, bool) {\n62|\tvalue, ok := checkStringBounds(raw, 1, 512)\n63|\tif !ok {\n64|\t\treturn Generation{}, false\n65|\t}\n66|\tgeneration, err := ParseGeneration(value)\n67|\tif err != nil {\n68|\t\treturn Generation{}, false\n69|\t}\n70|\treturn generation, true\n71|}\n72|\n73|// CheckDigestsEqual refuses two capture digests that differ. Stable\n74|// capture requires equal pre/post digests; file-size equality is\n75|// never proof and is not consulted here.\n76|func CheckDigestsEqual(pre, post scalar.Digest) error {\n77|\tif pre != post {\n78|\t\treturn invalid(\"capture digests differ: pre %q, post %q\", pre.String(), post.String())\n79|\t}\n80|\treturn nil\n81|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
