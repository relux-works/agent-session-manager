{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7c1","stream":{"kind":"session","id":"01a0b1d2-62fd-7091-a15f-687f76c867f4"},"sequence":571,"recorded_at":1780531400001137,"record_type":"event","durability":"durable","causation_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","run_stream":{"kind":"run","id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb"},"call_id":"call_01a0b1d5110776babbee5a43e3d5d333","text":"Read text file `internal/clonebundle/event.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"strconv\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n11|)\n12|\n13|// This file validates and constructs Canonical Event 1.0.0 with its\n14|// Source Evidence and raw byte-range references. The envelope,\n15|// vocabularies, evidence coupling, and message-like content-block\n16|// rules are enforced here; the full per-kind payload fact registry\n17|// is sibling (normalization) scope and is stated in doc.go.\n18|\n19|const (\n20|\tcanonicalEventSchema  = \"urn:ax:schema:canonical-event\"\n21|\tcanonicalEventVersion = \"1.0.0\"\n22|\tcanonicalEventSelf    = \"event_id\"\n23|\tmaxInlineContent      = 65536\n24|)\n25|\n26|// eventKinds is the exact 26-kind event vocabulary Section 13.14.1\n27|// states.\n28|var eventKinds = []string{\n29|\t\"session_started\",\n30|\t\"instruction_snapshot\",\n31|\t\"user_message\",\n32|\t\"assistant_message\",\n33|\t\"reasoning_summary\",\n34|\t\"opaque_reasoning\",\n35|\t\"tool_definition_snapshot\",\n36|\t\"tool_call\",\n37|\t\"tool_result\",\n38|\t\"approval_request\",\n39|\t\"approval_response\",\n40|\t\"plan_update\",\n41|\t\"progress\",\n42|\t\"usage\",\n43|\t\"rate_limit\",\n44|\t\"file_change\",\n45|\t\"compaction\",\n46|\t\"turn_started\",\n47|\t\"turn_completed\",\n48|\t\"turn_aborted\",\n49|\t\"subagent_started\",\n50|\t\"subagent_completed\",\n51|\t\"error\",\n52|\t\"migration_checkpoint\",\n53|\t\"session_finished\",\n54|\t\"opaque_event\",\n55|}\n56|\n57|// ValidEventKind reports whether the name is a canonical event kind.\n58|func ValidEventKind(kind string) bool {\n59|\tfor _, allowed := range eventKinds {\n60|\t\tif kind == allowed {\n61|\t\t\treturn true\n62|\t\t}\n63|\t}\n64|\treturn false\n65|}\n66|\n67|func validVisibility(visibility string) bool {\n68|\tswitch visibility {\n69|\tcase \"public\", \"projection\", \"internal\", \"opaque\":\n70|\t\treturn true\n71|\tdefault:\n72|\t\treturn false\n73|\t}\n74|}\n75|\n76|func validCaptureStatus(status string) bool {\n77|\tswitch status {\n78|\tcase \"exact\", \"partial\", \"synthesized\", \"unavailable\":\n79|\t\treturn true\n80|\tdefault:\n81|\t\treturn false\n82|\t}\n83|}\n84|\n85|// contentBlockTypes is the exact message-like content-block\n86|// vocabulary: text|json|image|audio|document|resource_link|redacted|opaque.\n87|var contentBlockTypes = []string{\n88|\t\"text\",\n89|\t\"json\",\n90|\t\"image\",\n91|\t\"audio\",\n92|\t\"document\",\n93|\t\"resource_link\",\n94|\t\"redacted\",\n95|\t\"opaque\",\n96|}\n97|\n98|func validContentBlockType(blockType string) bool {\n99|\tfor _, allowed := range contentBlockTypes {\n100|\t\tif blockType == allowed {\n101|\t\t\treturn true\n102|\t\t}\n103|\t}\n104|\treturn false\n105|}\n106|\n107|// messageLikeKind reports whether the kind carries a message-like\n108|// payload: user and assistant messages always do. Other kinds may\n109|// carry content blocks under the same block rules, but only these\n110|// two require them.\n111|func messageLikeKind(kind string) bool {\n112|\treturn kind == \"user_message\" || kind == \"assistant_message\"\n113|}\n114|\n115|var rawReferenceMembers = map[string]bool{\n116|\t\"manifest_id\": true, \"blob_descriptor_id\": true, \"offset\": true, \"length\": true,\n117|}\n118|\n119|var rawReferenceRequired = []string{\n120|\t\"manifest_id\", \"blob_descriptor_id\", \"offset\", \"length\",\n121|}\n122|\n123|// RawReference is one validated raw byte-range reference.\n124|type RawReference struct {\n125|\tManifestID       scalar.Digest\n126|\tBlobDescriptorID scalar.Digest\n127|\tOffset           uint64\n128|\tLength           uint64\n129|}\n130|\n131|func decodeRawReference(raw json.RawMessage, index int) (RawReference, error) {\n132|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n133|\tif fault != nil {\n134|\t\treturn RawReference{}, invalid(\"raw reference[%d] %s (%s)\", index, fault.detail, memberField(fault.member))\n135|\t}\n136|\tif name, unknown := unknownMember(members, rawReferenceMembers); unknown {\n137|\t\treturn RawReference{}, invalid(\"raw reference[%d] carries unknown member %q\", index, name)\n138|\t}\n139|\tif name, missing := missingMember(members, rawReferenceRequired); missing {\n140|\t\treturn RawReference{}, invalid(\"raw reference[%d] misses a required member %q\", index, name)\n141|\t}\n142|\tmanifestID, ok := checkDigest(members[\"manifest_id\"])\n143|\tif !ok {\n144|\t\treturn RawReference{}, invalid(\"raw reference[%d] manifest_id is not a digest\", index)\n145|\t}\n146|\tdescriptorID, ok := checkDigest(members[\"blob_descriptor_id\"])\n147|\tif !ok {\n148|\t\treturn RawReference{}, invalid(\"raw reference[%d] blob_descriptor_id is not a digest\", index)\n149|\t}\n150|\toffset, ok := checkUint53Bounds(members[\"offset\"], 0, maxUint53)\n151|\tif !ok {\n152|\t\treturn RawReference{}, invalid(\"raw reference[%d] offset is not a uint53\", index)\n153|\t}\n154|\tlength, ok := checkUint53Bounds(members[\"length\"], 0, maxUint53)\n155|\tif !ok {\n156|\t\treturn RawReference{}, invalid(\"raw reference[%d] length is not a uint53\", index)\n157|\t}\n158|\treturn RawReference{\n159|\t\tManifestID:       manifestID,\n160|\t\tBlobDescriptorID: descriptorID,\n161|\t\tOffset:           offset,\n162|\t\tLength:           length,\n163|\t}, nil\n164|}\n165|\n166|func rawReferenceObject(reference RawReference) map[string]any {\n167|\treturn map[string]any{\n168|\t\t\"manifest_id\":        reference.ManifestID.String(),\n169|\t\t\"blob_descriptor_id\": reference.BlobDescriptorID.String(),\n170|\t\t\"offset\":             reference.Offset,\n171|\t\t\"length\":             reference.Length,\n172|\t}\n173|}\n174|\n175|// decodeSortedUniqueRawReferences validates sorted unique raw\n176|// references: bytewise order of each item's JCS encoding, strict\n177|// increase proving sortedness and uniqueness together.\n178|func decodeSortedUniqueRawReferences(raw json.RawMessage) ([]RawReference, error) {\n179|\telements, ok := decodeArray(raw)\n180|\tif !ok {\n181|\t\treturn nil, invalid(\"source evidence raw_refs are not an array\")\n182|\t}\n183|\tif len(elements) > 65536 {\n184|\t\treturn nil, invalid(\"source evidence carries %d raw_refs, maximum is 65536\", len(elements))\n185|\t}\n186|\treferences := make([]RawReference, 0, len(elements))\n187|\tvar previous []byte\n188|\tfor index, element := range elements {\n189|\t\treference, err := decodeRawReference(element, index)\n190|\t\tif err != nil {\n191|\t\t\treturn nil, err\n192|\t\t}\n193|\t\tcanonical, err := canonicaljson.Canonicalize(bytesTrimSpace(element))\n194|\t\tif err != nil {\n195|\t\t\treturn nil, invalid(\"source evidence raw_refs[%d] are not canonical JSON: %v\", index, err)\n196|\t\t}\n197|\t\tif index > 0 && bytes.Compare(canonical, previous) <= 0 {\n198|\t\t\treturn nil, invalid(\"source evidence raw_refs are not sorted unique\")\n199|\t\t}\n200|\t\tprevious = canonical\n201|\t\treferences = append(references, reference)\n202|\t}\n203|\treturn references, nil\n204|}\n205|\n206|var sourceEvidenceMembers = map[string]bool{\n207|\t\"environment\": true, \"native_session_id\": true, \"native_event_id\": true,\n208|\t\"native_type\": true, \"raw_refs\": true, \"capture_status\": true,\n209|\t\"reason_codes\": true, \"core_operation_id\": true, \"extensions\": true,\n210|}\n211|\n212|var sourceEvidenceRequired = []string{\n213|\t\"environment\", \"native_session_id\", \"native_event_id\",\n214|\t\"native_type\", \"raw_refs\", \"capture_status\",\n215|\t\"reason_codes\", \"core_operation_id\", \"extensions\",\n216|}\n217|\n218|// SourceEvidence is one validated source evidence record.\n219|type SourceEvidence struct {\n220|\tEnvironment     sessadapter.Tuple\n221|\tNativeSessionID string\n222|\tNativeEventID   *string\n223|\tNativeType      *string\n224|\tRawRefs         []RawReference\n225|\tCaptureStatus   string\n226|\tReasonCodes     []string\n227|\tCoreOperationID *scalar.UUIDv7\n228|}\n229|\n230|// DecodeSourceEvidence validates one closed SourceEvidence:\n231|// sanitized native IDs, sorted unique raw references, and the\n232|// synthesized coupling (null native Event ID with a non-null core\n233|// operation; every other status with a null core operation).\n234|func DecodeSourceEvidence(raw json.RawMessage) (SourceEvidence, error) {\n235|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n236|\tif fault != nil {\n237|\t\treturn SourceEvidence{}, invalid(\"source evidence %s (%s)\", fault.detail, memberField(fault.member))\n238|\t}\n239|\tif name, unknown := unknownMember(members, sourceEvidenceMembers); unknown {\n240|\t\treturn SourceEvidence{}, invalid(\"source evidence carries unknown member %q\", name)\n241|\t}\n242|\tif name, missing := missingMember(members, sourceEvidenceRequired); missing {\n243|\t\treturn SourceEvidence{}, invalid(\"source evidence misses a required member %q\", name)\n244|\t}\n245|\ttuple, err := sessadapter.DecodeTuple(members[\"environment\"])\n246|\tif err != nil {\n247|\t\treturn SourceEvidence{}, invalid(\"source evidence environment is not an Environment Tuple: %v\", err)\n248|\t}\n249|\tnativeSession, ok := checkStringBounds(members[\"native_session_id\"], 1, 512)\n250|\tif !ok {\n251|\t\treturn SourceEvidence{}, invalid(\"source evidence native_session_id is not a string[1..512]\")\n252|\t}\n253|\tif err := SanitizeNativeKey(nativeSession); err != nil {\n254|\t\treturn SourceEvidence{}, err\n255|\t}\n256|\tvar nativeEvent *string\n257|\tif !isNull(members[\"native_event_id\"]) {\n258|\t\tvalue, ok := checkStringBounds(members[\"native_event_id\"], 1, 512)\n259|\t\tif !ok {\n260|\t\t\treturn SourceEvidence{}, invalid(\"source evidence native_event_id is not a string[1..512]\")\n261|\t\t}\n262|\t\tif err := SanitizeNativeKey(value); err != nil {\n263|\t\t\treturn SourceEvidence{}, err\n264|\t\t}\n265|\t\tnativeEvent = &value\n266|\t}\n267|\tvar nativeType *string\n268|\tif !isNull(members[\"native_type\"]) {\n269|\t\tvalue, ok := checkStringBounds(members[\"native_type\"], 1, 512)\n270|\t\tif !ok {\n271|\t\t\treturn SourceEvidence{}, invalid(\"source evidence native_type is not a string[1..512]\")\n272|\t\t}\n273|\t\tnativeType = &value\n274|\t}\n275|\treferences, err := decodeSortedUniqueRawReferences(members[\"raw_refs\"])\n276|\tif err != nil {\n277|\t\treturn SourceEvidence{}, err\n278|\t}\n279|\tstatus, ok := rawString(members[\"capture_status\"])\n280|\tif !ok || !validCaptureStatus(status) {\n281|\t\treturn SourceEvidence{}, invalid(\"source evidence capture_status is outside exact|partial|synthesized|unavailable\")\n282|\t}\n283|\treasons, ok := checkSortedUniqueStrings(members[\"reason_codes\"], 1, 128, 0, 128)\n284|\tif !ok {\n285|\t\treturn SourceEvidence{}, invalid(\"source evidence reason_codes are not sorted unique string[1..128][0..128]\")\n286|\t}\n287|\tvar operation *scalar.UUIDv7\n288|\tif !isNull(members[\"core_operation_id\"]) {\n289|\t\tvalue, ok := checkUUIDv7(members[\"core_operation_id\"])\n290|\t\tif !ok {\n291|\t\t\treturn SourceEvidence{}, invalid(\"source evidence core_operation_id is not a UUIDv7\")\n292|\t\t}\n293|\t\toperation = &value\n294|\t}\n295|\tif err := checkEvidenceCoupling(status, nativeEvent != nil, operation != nil); err != nil {\n296|\t\treturn SourceEvidence{}, err\n297|\t}\n298|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n299|\t\treturn SourceEvidence{}, invalid(\"source evidence extensions %s\", extensionsFault)\n300|\t}\n301|\treturn SourceEvidence{\n302|\t\tEnvironment:     tuple,\n303|\t\tNativeSessionID: nativeSession,\n304|\t\tNativeEventID:   nativeEvent,\n305|\t\tNativeType:      nativeType,\n306|\t\tRawRefs:         references,\n307|\t\tCaptureStatus:   status,\n308|\t\tReasonCodes:     reasons,\n309|\t\tCoreOperationID: operation,\n310|\t}, nil\n311|}\n312|\n313|// checkEvidenceCoupling enforces the synthesized rule: synthesized\n314|// requires a null native Event ID and a non-null core operation\n315|// identifying the core operation; all other statuses require a\n316|// null core operation.\n317|func checkEvidenceCoupling(status string, hasNativeEvent, hasOperation bool) error {\n318|\tif status == \"synthesized\" {\n319|\t\tif hasNativeEvent {\n320|\t\t\treturn invalid(\"source evidence synthesized carries a native event ID\")\n321|\t\t}\n322|\t\tif !hasOperation {\n323|\t\t\treturn invalid(\"source evidence synthesized requires a core operation\")\n324|\t\t}\n325|\t\treturn nil\n326|\t}\n327|\tif hasOperation {\n328|\t\treturn invalid(\"source evidence %s carries a core operation\", status)\n329|\t}\n330|\treturn nil\n331|}\n332|\n333|var canonicalEventMembers = map[string]bool{\n334|\t\"schema\": true, \"schema_version\": true, \"event_id\": true,\n335|\t\"logical_session_id\": true, \"ordinal\": true, \"parents\": true,\n336|\t\"actor_id\": true, \"turn_id\": true, \"kind\": true, \"timestamp\": true,\n337|\t\"visibility\": true, \"payload\": true, \"source_evidence\": true, \"extensions\": true,\n338|}\n339|\n340|var canonicalEventRequired = []string{\n341|\t\"schema\", \"schema_version\", \"event_id\",\n342|\t\"logical_session_id\", \"ordinal\", \"parents\",\n343|\t\"actor_id\", \"turn_id\", \"kind\", \"timestamp\",\n344|\t\"visibility\", \"payload\", \"source_evidence\", \"extensions\",\n345|}\n346|\n347|// CanonicalEvent is one validated Canonical Event. Payload carries\n348|// the validated closed payload object.\n349|type CanonicalEvent struct {\n350|\tEventID          scalar.Digest\n351|\tLogicalSessionID scalar.UUIDv7\n352|\tOrdinal          uint64\n353|\tParents          []scalar.Digest\n354|\tActorID          scalar.UUIDv7\n355|\tTurnID           *scalar.UUIDv7\n356|\tKind             string\n357|\tTimestamp        *scalar.Timestamp\n358|\tVisibility       string\n359|\tPayload          map[string]any\n360|\tEvidence         SourceEvidence\n361|}\n362|\n363|// RawRefInput is one caller-supplied raw reference candidate.\n364|type RawRefInput struct {\n365|\tManifestID       string\n366|\tBlobDescriptorID string\n367|\tOffset           uint64\n368|\tLength           uint64\n369|}\n370|\n371|// EvidenceInput is one caller-supplied source evidence candidate\n372|// for Build.\n373|type EvidenceInput struct {\n374|\tEnvironment     []byte\n375|\tNativeSessionID string\n376|\tNativeEventID   *string\n377|\tNativeType      *string\n378|\tRawRefs         []RawRefInput\n379|\tCaptureStatus   string\n380|\tReasonCodes     []string\n381|\tCoreOperationID *string\n382|}\n383|\n384|// CanonicalEventInput is the caller-supplied canonical event\n385|// candidate for Build. Payload carries the exact closed payload\n386|// object bytes; Build validates them under the kind-selected rules.\n387|type CanonicalEventInput struct {\n388|\tLogicalSessionID string\n389|\tOrdinal          uint64\n390|\tParents          []string\n391|\tActorID          string\n392|\tTurnID           *string\n393|\tKind             string\n394|\tTimestamp        *string\n395|\tVisibility       string\n396|\tPayload          []byte\n397|\tEvidence         EvidenceInput\n398|\tExtensions       map[string]any\n399|}\n400|\n401|// BuildCanonicalEvent constructs one closed Canonical Event 1.0.0\n402|// as canonical bytes. Identical inputs produce byte-identical\n403|// outputs.\n404|func BuildCanonicalEvent(input CanonicalEventInput) ([]byte, error) {\n405|\tobject, err := buildCanonicalEvent(input)\n406|\tif err != nil {\n407|\t\treturn nil, err\n408|\t}\n409|\tomitted, err := canonicalizeObject(object)\n410|\tif err != nil {\n411|\t\treturn nil, err\n412|\t}\n413|\teventID := scalar.SHA256Digest(omitted)\n414|\tobject[canonicalEventSelf] = eventID.String()\n415|\treturn canonicalizeObject(object)\n416|}\n417|\n418|func buildCanonicalEvent(input CanonicalEventInput) (map[string]any, error) {\n419|\tlogical, err := scalar.ParseUUIDv7(input.LogicalSessionID)\n420|\tif err != nil {\n421|\t\treturn nil, invalid(\"canonical event logical_session_id is not a UUIDv7: %v\", err)\n422|\t}\n423|\tif input.Ordinal > maxUint53 {\n424|\t\treturn nil, invalid(\"canonical event ordinal exceeds uint53\")\n425|\t}\n426|\tparents, err := parseSortedUniqueDigestStrings(input.Parents, 0, 64, \"parents\")\n427|\tif err != nil {\n428|\t\treturn nil, invalid(\"canonical event %v\", err)\n429|\t}\n430|\tactorID, err := scalar.ParseUUIDv7(input.ActorID)\n431|\tif err != nil {\n432|\t\treturn nil, invalid(\"canonical event actor_id is not a UUIDv7: %v\", err)\n433|\t}\n434|\tvar turn any\n435|\tif input.TurnID != nil {\n436|\t\tvalue, err := scalar.ParseUUIDv7(*input.TurnID)\n437|\t\tif err != nil {\n438|\t\t\treturn nil, invalid(\"canonical event turn_id is not a UUIDv7: %v\", err)\n439|\t\t}\n440|\t\tturn = value.String()\n441|\t}\n442|\tif !ValidEventKind(input.Kind) {\n443|\t\treturn nil, invalid(\"canonical event kind is outside the 26-kind vocabulary\")\n444|\t}\n445|\tvar stamp any\n446|\tif input.Timestamp != nil {\n447|\t\tvalue, err := scalar.ParseTimestamp(*input.Timestamp)\n448|\t\tif err != nil {\n449|\t\t\treturn nil, invalid(\"canonical event timestamp is not a timestamp: %v\", err)\n450|\t\t}\n451|\t\tstamp = value.String()\n452|\t}\n453|\tif !validVisibility(input.Visibility) {\n454|\t\treturn nil, invalid(\"canonical event visibility is outside public|projection|internal|opaque\")\n455|\t}\n456|\tpayload, err := checkPayload(input.Kind, json.RawMessage(input.Payload))\n457|\tif err != nil {\n458|\t\treturn nil, err\n459|\t}\n460|\tevidence, err := buildSourceEvidence(input.Evidence)\n461|\tif err != nil {\n462|\t\treturn nil, err\n463|\t}\n464|\tif _, err := encodeExtensions(input.Extensions); err != nil {\n465|\t\treturn nil, err\n466|\t}\n467|\treturn map[string]any{\n468|\t\t\"schema\":             canonicalEventSchema,\n469|\t\t\"schema_version\":     canonicalEventVersion,\n470|\t\t\"logical_session_id\": logical.String(),\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
