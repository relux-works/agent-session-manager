{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c915","stream":{"kind":"session","id":"01a0b1d2-62fd-7091-a15f-687f76c867f4"},"sequence":741,"recorded_at":1780531400001477,"record_type":"event","durability":"durable","causation_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","run_stream":{"kind":"run","id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb"},"task_stream":{"kind":"task","id":"01a0b1d5-fa6c-78c3-8d0d-955830c93b7a"},"task_id":"01a0b1d5-fa6c-78c3-8d0d-955830c93b7a","event":{"kind":"output","task_id":"01a0b1d5-fa6c-78c3-8d0d-955830c93b7a","chunk":"Read text file `internal/clonebundle/testdata/mutant_harness.py`.\n(679 line(s) above)\n680|        expect=\"KILLED\",\n681|        note=\"Admits exactly the fault literal at the workspace binding site only; the identity site still refuses.\",\n682|    ),\n683|    Mutant(\n684|        name=\"N-ext-values-actor\",\n685|        path=f\"{PACKAGE}/session.go\",\n686|        find='\\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\\n\\t\\treturn Actor{}, invalid(\"actor[%d] extensions %s\", index, extensionsFault)\\n\\t}\\n',\n687|        replace='\\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil && string(members[\"extensions\"]) != `{\"com.example.n\":1.5}` {\\n\\t\\treturn Actor{}, invalid(\"actor[%d] extensions %s\", index, extensionsFault)\\n\\t}\\n',\n688|        count=1,\n689|        run=\"TestExtensionValueModelAtEverySite/actor\",\n690|        expect=\"KILLED\",\n691|        note=\"Admits exactly the fault literal at the actor site only; the session site still refuses.\",\n692|    ),\n693|    Mutant(\n694|        name=\"N-ext-values-canonical-session\",\n695|        path=f\"{PACKAGE}/session.go\",\n696|        find='\\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\\n\\t\\treturn CanonicalSession{}, invalid(\"canonical session extensions %s\", extensionsFault)\\n\\t}\\n',\n697|        replace='\\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil && string(members[\"extensions\"]) != `{\"com.example.n\":1.5}` {\\n\\t\\treturn CanonicalSession{}, invalid(\"canonical session extensions %s\", extensionsFault)\\n\\t}\\n',\n698|        count=1,\n699|        run=\"TestExtensionValueModelAtEverySite/canonical_session\",\n700|        expect=\"KILLED\",\n701|        note=\"Admits exactly the fault literal at the canonical session site only; the actor site still refuses.\",\n702|    ),\n703|    Mutant(\n704|        name=\"N-text-utf8\",\n705|        path=f\"{PACKAGE}/decode.go\",\n706|        find='\\treturn utf8.ValidString(value)\\n',\n707|        replace='\\treturn utf8.ValidString(value) || value == \"ti\\\\xfftle\"\\n',\n708|        count=1,\n709|        run=\"TestBuildTextMustBeValidUTF8/session_title\",\n710|        expect=\"KILLED\",\n711|        note=\"Admits exactly the killer's invalid title past the shared text gate; every other invalid-UTF-8 value still refuses at every admission site.\",\n712|    ),\n713|    Mutant(\n714|        name=\"N-reason-codes-dup-build\",\n715|        path=f\"{PACKAGE}/event.go\",\n716|        find=\"\\t\\tif index > 0 && reason <= previousReason {\\n\",\n717|        replace=\"\\t\\tif index > 0 && reason < previousReason {\\n\",\n718|        count=1,\n719|        run=\"TestCanonicalEventRefusals/evidence/reasons_duplicate\",\n720|        expect=\"KILLED\",\n721|        note=\"Admits exactly an equal reason-code duplicate at build; unsorted codes still refuse. The decode site keeps its delegated row.\",\n722|    ),\n723|    Mutant(\n724|        name=\"C-doc-comment\",\n725|        path=f\"{PACKAGE}/doc.go\",\n726|        find=\"// Authority: relux-works/agent-session-manager-spec@v0.7.0, Sections\\n\",\n727|        replace=\"// Authority: relux-works/agent-session-manager-spec@v0.7.0, Sections (control).\\n\",\n728|        count=1,\n729|        run=\"TestCaptureClassVocabularyIsPinned\",\n730|        expect=\"SURVIVED\",\n731|        note=\"Harmless control: a comment-only edit must survive.\",\n732|    ),\n733|]\n734|\n735|\n736|def run_mutant(mutant: Mutant) -> tuple[str, str, int, float]:\n737|    target = REPO / mutant.path\n738|    original = target.read_text()\n739|    found = original.count(mutant.find)\n740|    if found != mutant.count:\n741|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\", \"\", -1, 0.0\n742|    with tempfile.TemporaryDirectory() as staging:\n743|        backup = Path(staging) / \"backup\"\n744|        shutil.copy2(target, backup)\n745|        try:\n746|            target.write_text(original.replace(mutant.find, mutant.replace))\n747|            started = time.time()\n748|            run = subprocess.run(\n749|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n750|                cwd=REPO,\n751|                capture_output=True,\n752|                text=True,\n753|                timeout=300,\n754|            )\n755|            elapsed = time.time() - started\n756|        finally:\n757|            shutil.copy2(backup, target)\n758|    output = (run.stdout + run.stderr).strip()\n759|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n760|        return f\"ERROR: {mutant.name}: build broke under the patch\", output, run.returncode, elapsed\n761|    if run.returncode == 0:\n762|        verdict = \"SURVIVED\"\n763|    elif '--- FAIL' in output or 'FAIL:' in output:\n764|        verdict = \"KILLED\"\n765|    else:\n766|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\", output, run.returncode, elapsed\n767|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n768|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note}\", output, run.returncode, elapsed\n769|\n770|\n771|def main(argv: list[str]) -> int:\n772|    log_dir: Path | None = None\n773|    selected_names: list[str] = []\n774|    args = list(argv)\n775|    while args:\n776|        if args[0] == \"--log-dir\":\n777|            if len(args) < 2:\n778|                print(\"missing directory for --log-dir\")\n779|                return 2\n780|            log_dir = Path(args[1])\n781|            args = args[2:]\n782|        else:\n783|            selected_names.append(args[0])\n784|            args = args[1:]\n785|    selected = [m for m in MUTANTS if not selected_names or m.name in selected_names]\n786|    if selected_names and len(selected) != len(selected_names):\n787|        unknown = sorted(set(selected_names) - {m.name for m in selected})\n788|        print(f\"unknown mutants: {', '.join(unknown)}\")\n789|        return 2\n790|    if log_dir is not None:\n791|        log_dir.mkdir(parents=True, exist_ok=True)\n792|    failures = 0\n793|    for mutant in selected:\n794|        try:\n795|            line, output, exit_code, elapsed = run_mutant(mutant)\n796|        except subprocess.TimeoutExpired:\n797|            line, output, exit_code, elapsed = f\"ERROR: {mutant.name}: killer timed out\", \"\", -1, 0.0\n798|        print(line, flush=True)\n799|        if log_dir is not None:\n800|            (log_dir / f\"{mutant.name}.log\").write_text(\n801|                f\"# mutant={mutant.name} path={mutant.path} -run={mutant.run}\\n\"\n802|                f\"# exit={exit_code} elapsed={elapsed:.1f}s\\n\"\n803|                f\"# find={mutant.find!r}\\n# replace={mutant.replace!r}\\n---\\n{output}\\n\"\n804|            )\n805|        if not line.startswith(\"ok:\"):\n806|            failures += 1\n807|    return 1 if failures else 0\n808|\n809|\n(more lines below)","final_result":true}}}
