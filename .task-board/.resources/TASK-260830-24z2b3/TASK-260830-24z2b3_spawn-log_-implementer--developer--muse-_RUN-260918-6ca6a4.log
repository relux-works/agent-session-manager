f err != nil {\n411|\t\treturn nil, invalid(\"serialize clone bundle object: %v\", err)\n412|\t}\n413|\tcanonical, err := canonicaljson.Canonicalize(plain)\n414|\tif err != nil {\n415|\t\treturn nil, invalid(\"canonicalize clone bundle object: %v\", err)\n416|\t}\n417|\treturn canonical, nil\n418|}\n419|\n420|// omitSelfDigest computes the JCS SHA-256 identity of members with\n421|// only the self field omitted. It mirrors the canonicaljson\n422|// omit-self construction without routing through that package's\n423|// closed-shape registry, which refuses these schemas by design (see\n424|// doc.go).\n425|func omitSelfDigest(members map[string]json.RawMessage, selfField string) (scalar.Digest, error) {\n426|\tomitted := make(map[string]any, len(members))\n427|\tfor name, raw := range members {\n428|\t\tif name == selfField {\n429|\t\t\tcontinue\n430|\t\t}\n431|\t\tvar value any\n432|\t\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n433|\t\tdecoder.UseNumber()\n434|\t\tif err := decoder.Decode(&value); err != nil {\n435|\t\t\treturn scalar.Digest{}, invalid(\"identity input member %s is not JSON: %v\", name, err)\n436|\t\t}\n437|\t\tomitted[name] = value\n438|\t}\n439|\tplain, err := json.Marshal(omitted)\n440|\tif err != nil {\n441|\t\treturn scalar.Digest{}, invalid(\"serialize omit-self object: %v\", err)\n442|\t}\n443|\tcanonical, err := canonicaljson.Canonicalize(plain)\n444|\tif err != nil {\n445|\t\treturn scalar.Digest{}, invalid(\"canonicalize omit-self object: %v\", err)\n446|\t}\n447|\treturn scalar.SHA256Digest(canonical), nil\n448|}\n449|\n450|// verifySelfDigest recomputes the omit-self identity and refuses a\n451|// mismatch against the claimed self digest.\n452|func verifySelfDigest(members map[string]json.RawMessage, selfField string, claimed scalar.Digest) error {\n453|\tcalculated, err := omitSelfDigest(members, selfField)\n454|\tif err != nil {\n455|\t\treturn err\n456|\t}\n457|\tif calculated != claimed {\n458|\t\treturn invalid(\"%s claim %q d