{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c949","stream":{"kind":"session","id":"01a0b1d2-62fd-7091-a15f-687f76c867f4"},"sequence":767,"recorded_at":1780531400001529,"record_type":"event","durability":"durable","causation_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","run_stream":{"kind":"run","id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb"},"task_stream":{"kind":"task","id":"01a0b1d6-6d31-7851-a95c-52d633b2be98"},"task_id":"01a0b1d6-6d31-7851-a95c-52d633b2be98","event":{"kind":"output","task_id":"01a0b1d6-6d31-7851-a95c-52d633b2be98","chunk":"{\n  \"chunk_id\": \"exec-14-1\",\n  \"command\": \"grep -n \\\"TestEncodeNativeIdentityRefusals\\\\|func Test\\\" internal/clonebundle/refusal_test.go | head; echo ===; sed -n '380,470p' internal/clonebundle/refusal_session_event_test.go; echo === ; ls -R .temp/TASK-260830-24z2b3 2>&1 | head -30\",\n  \"description\": \"Check encode-identity test and build evidence table\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"54:func TestRawManifestRefusals(t *testing.T) {\\n285:func TestMultibyteStringMeasure(t *testing.T) {\\n319:func TestCaptureItemRefusals(t *testing.T) {\\n377:func TestCaptureManifestRefusals(t *testing.T) {\\n593:func TestBoundaryRefusals(t *testing.T) {\\n690:func TestSourceBasisRefusals(t *testing.T) {\\n===\\n\\t\\tcases := []struct {\\n\\t\\t\\tname     string\\n\\t\\t\\tmutate   func(*EvidenceInput)\\n\\t\\t\\tfragment string\\n\\t\\t}{\\n\\t\\t\\t{\\\"bad status\\\", func(ev *EvidenceInput) { ev.CaptureStatus = \\\"maybe\\\" }, \\\"exact|partial|synthesized|unavailable\\\"},\\n\\t\\t\\t{\\\"synthesized with native event\\\", func(ev *EvidenceInput) {\\n\\t\\t\\t\\tev.CaptureStatus = \\\"synthesized\\\"\\n\\t\\t\\t\\tev.CoreOperationID = strptr(fixtureOperationID)\\n\\t\\t\\t}, \\\"carries a native event ID\\\"},\\n