{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c821","stream":{"kind":"session","id":"01a0b1d2-62fd-7091-a15f-687f76c867f4"},"sequence":619,"recorded_at":1780531400001233,"record_type":"event","durability":"durable","causation_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","run_stream":{"kind":"run","id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb"},"task_stream":{"kind":"task","id":"01a0b1d5-3055-7a31-90c0-9433d109bcb9"},"task_id":"01a0b1d5-3055-7a31-90c0-9433d109bcb9","event":{"kind":"output","task_id":"01a0b1d5-3055-7a31-90c0-9433d109bcb9","chunk":"Read text file `internal/clonebundle/boundary.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n7|)\n8|\n9|// This file validates the Capture Source Basis and Capture Boundary\n10|// closed unions of Clone Capture Manifest 1.0.0, including the\n11|// StableSnapshotProof. The stable form carries proof; the unstable\n12|// form is core-created archive-only output that can never enter a\n13|// target branch.\n14|\n15|// SourceBasis is one validated Capture Source Basis.\n16|type SourceBasis struct {\n17|\tKind                     string\n18|\tSourceSessionID          *scalar.UUIDv7\n19|\tSourceSessionRecordID    *scalar.Digest\n20|\tSourceCheckpointID       *scalar.Digest\n21|\tSourceProviderIdentityID *scalar.Digest\n22|\tExternalSourceRef        *string\n23|}\n24|\n25|var sourceBasisAXMembers = map[string]bool{\n26|\t\"kind\": true, \"source_session_id\": true, \"source_session_record_id\": true,\n27|\t\"source_checkpoint_id\": true, \"source_provider_identity_record_id\": true, \"extensions\": true,\n28|}\n29|\n30|var sourceBasisAXRequired = []string{\n31|\t\"kind\", \"source_session_id\", \"source_session_record_id\",\n32|\t\"source_checkpoint_id\", \"source_provider_identity_record_id\", \"extensions\",\n33|}\n34|\n35|var sourceBasisExternalMembers = map[string]bool{\n36|\t\"kind\": true, \"external_source_ref\": true, \"extensions\": true,\n37|}\n38|\n39|var sourceBasisExternalRequired = []string{\n40|\t\"kind\", \"external_source_ref\", \"extensions\",\n41|}\n42|\n43|// DecodeSourceBasis validates one closed Capture Source Basis.\n44|func DecodeSourceBasis(raw json.RawMessage) (SourceBasis, error) {\n45|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n46|\tif fault != nil {\n47|\t\treturn SourceBasis{}, invalid(\"source basis %s (%s)\", fault.detail, memberField(fault.member))\n48|\t}\n49|\tkindValue, present := members[\"kind\"]\n50|\tif !present {\n51|\t\treturn SourceBasis{}, invalid(\"source basis misses a required member %q\", \"kind\")\n52|\t}\n53|\tkind, ok := rawString(kindValue)\n54|\tif !ok {\n55|\t\treturn SourceBasis{}, invalid(\"source basis kind is not a string\")\n56|\t}\n57|\tswitch kind {\n58|\tcase \"ax_session\":\n59|\t\treturn decodeAXSessionBasis(members)\n60|\tcase \"external_native\":\n61|\t\treturn decodeExternalNativeBasis(members)\n62|\tdefault:\n63|\t\treturn SourceBasis{}, invalid(\"source basis kind is outside ax_session|external_native\")\n64|\t}\n65|}\n66|\n67|func decodeAXSessionBasis(members map[string]json.RawMessage) (SourceBasis, error) {\n68|\tif name, unknown := unknownMember(members, sourceBasisAXMembers); unknown {\n69|\t\treturn SourceBasis{}, invalid(\"source basis carries unknown member %q\", name)\n70|\t}\n71|\tif name, missing := missingMember(members, sourceBasisAXRequired); missing {\n72|\t\treturn SourceBasis{}, invalid(\"source basis misses a required member %q\", name)\n73|\t}\n74|\tsessionID, ok := checkUUIDv7(members[\"source_session_id\"])\n75|\tif !ok {\n76|\t\treturn SourceBasis{}, invalid(\"source basis source_session_id is not a UUIDv7\")\n77|\t}\n78|\trecordID, ok := checkDigest(members[\"source_session_record_id\"])\n79|\tif !ok {\n80|\t\treturn SourceBasis{}, invalid(\"source basis source_session_record_id is not a digest\")\n81|\t}\n82|\tcheckpointID, ok := checkDigest(members[\"source_checkpoint_id\"])\n83|\tif !ok {\n84|\t\treturn SourceBasis{}, invalid(\"source basis source_checkpoint_id is not a digest\")\n85|\t}\n86|\tproviderID, ok := checkDigest(members[\"source_provider_identity_record_id\"])\n87|\tif !ok {\n88|\t\treturn SourceBasis{}, invalid(\"source basis source_provider_identity_record_id is not a digest\")\n89|\t}\n90|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n91|\t\treturn SourceBasis{}, invalid(\"source basis extensions %s\", extensionsFault)\n92|\t}\n93|\treturn SourceBasis{\n94|\t\tKind:                     \"ax_session\",\n95|\t\tSourceSessionID:          &sessionID,\n96|\t\tSourceSessionRecordID:    &recordID,\n97|\t\tSourceCheckpointID:       &checkpointID,\n98|\t\tSourceProviderIdentityID: &providerID,\n99|\t}, nil\n100|}\n101|\n102|func decodeExternalNativeBasis(members map[string]json.RawMessage) (SourceBasis, error) {\n103|\tif name, unknown := unknownMember(members, sourceBasisExternalMembers); unknown {\n104|\t\treturn SourceBasis{}, invalid(\"source basis carries unknown member %q\", name)\n105|\t}\n106|\tif name, missing := missingMember(members, sourceBasisExternalRequired); missing {\n107|\t\treturn SourceBasis{}, invalid(\"source basis misses a required member %q\", name)\n108|\t}\n109|\treference, ok := checkStringBounds(members[\"external_source_ref\"], 1, 512)\n110|\tif !ok {\n111|\t\treturn SourceBasis{}, invalid(\"source basis external_source_ref is not a string[1..512]\")\n112|\t}\n113|\tif err := SanitizeNativeKey(reference); err != nil {\n114|\t\treturn SourceBasis{}, err\n115|\t}\n116|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n117|\t\treturn SourceBasis{}, invalid(\"source basis extensions %s\", extensionsFault)\n118|\t}\n119|\treturn SourceBasis{Kind: \"external_native\", ExternalSourceRef: &reference}, nil\n120|}\n121|\n122|// SourceBasisInput is one caller-supplied source basis candidate for\n123|// Build. Exactly the kind-selected fields must be set.\n124|type SourceBasisInput struct {\n125|\tKind                     string\n126|\tSourceSessionID          string\n127|\tSourceSessionRecordID    string\n128|\tSourceCheckpointID       string\n129|\tSourceProviderIdentityID string\n130|\tExternalSourceRef        string\n131|}\n132|\n133|func buildSourceBasis(input SourceBasisInput) (SourceBasis, map[string]any, error) {\n134|\tswitch input.Kind {\n135|\tcase \"ax_session\":\n136|\t\tsessionID, err := scalar.ParseUUIDv7(input.SourceSessionID)\n137|\t\tif err != nil {\n138|\t\t\treturn SourceBasis{}, nil, invalid(\"source basis source_session_id is not a UUIDv7: %v\", err)\n139|\t\t}\n140|\t\trecordID, err := scalar.ParseDigest(input.SourceSessionRecordID)\n141|\t\tif err != nil {\n142|\t\t\treturn SourceBasis{}, nil, invalid(\"source basis source_session_record_id is not a digest: %v\", err)\n143|\t\t}\n144|\t\tcheckpointID, err := scalar.ParseDigest(input.SourceCheckpointID)\n145|\t\tif err != nil {\n146|\t\t\treturn SourceBasis{}, nil, invalid(\"source basis source_checkpoint_id is not a digest: %v\", err)\n147|\t\t}\n148|\t\tproviderID, err := scalar.ParseDigest(input.SourceProviderIdentityID)\n149|\t\tif err != nil {\n150|\t\t\treturn SourceBasis{}, nil, invalid(\"source basis source_provider_identity_record_id is not a digest: %v\", err)\n151|\t\t}\n152|\t\tif input.ExternalSourceRef != \"\" {\n153|\t\t\treturn SourceBasis{}, nil, invalid(\"source basis ax_session carries an external source reference\")\n154|\t\t}\n155|\t\tbasis := SourceBasis{\n156|\t\t\tKind:                     \"ax_session\",\n157|\t\t\tSourceSessionID:          &sessionID,\n158|\t\t\tSourceSessionRecordID:    &recordID,\n159|\t\t\tSourceCheckpointID:       &checkpointID,\n160|\t\t\tSourceProviderIdentityID: &providerID,\n161|\t\t}\n162|\t\treturn basis, map[string]any{\n163|\t\t\t\"kind\":                               \"ax_session\",\n164|\t\t\t\"source_session_id\":                  sessionID.String(),\n165|\t\t\t\"source_session_record_id\":           recordID.String(),\n166|\t\t\t\"source_checkpoint_id\":               checkpointID.String(),\n167|\t\t\t\"source_provider_identity_record_id\": providerID.String(),\n168|\t\t\t\"extensions\":                         map[string]any{},\n169|\t\t}, nil\n170|\tcase \"external_native\":\n171|\t\tif stringLength(input.ExternalSourceRef) < 1 || stringLength(input.ExternalSourceRef) > 512 {\n172|\t\t\treturn SourceBasis{}, nil, invalid(\"source basis external_source_ref is not a string[1..512]\")\n173|\t\t}\n174|\t\tif err := SanitizeNativeKey(input.ExternalSourceRef); err != nil {\n175|\t\t\treturn SourceBasis{}, nil, err\n176|\t\t}\n177|\t\tif input.SourceSessionID != \"\" || input.SourceSessionRecordID != \"\" ||\n178|\t\t\tinput.SourceCheckpointID != \"\" || input.SourceProviderIdentityID != \"\" {\n179|\t\t\treturn SourceBasis{}, nil, invalid(\"source basis external_native carries ax_session members\")\n180|\t\t}\n181|\t\tbasis := SourceBasis{Kind: \"external_native\", ExternalSourceRef: &input.ExternalSourceRef}\n182|\t\treturn basis, map[string]any{\n183|\t\t\t\"kind\":                \"external_native\",\n184|\t\t\t\"external_source_ref\": input.ExternalSourceRef,\n185|\t\t\t\"extensions\":          map[string]any{},\n186|\t\t}, nil\n187|\tdefault:\n188|\t\treturn SourceBasis{}, nil, invalid(\"source basis kind is outside ax_session|external_native\")\n189|\t}\n190|}\n191|\n192|// StableSnapshotProof is one validated stable snapshot proof.\n193|type StableSnapshotProof struct {\n194|\tProofKind         string\n195|\tSourceGeneration  Generation\n196|\tSnapshotIdentity  *scalar.Digest\n197|\tPreCaptureDigest  scalar.Digest\n198|\tPostCaptureDigest scalar.Digest\n199|\tInputBlocked      bool\n200|\tForegroundIdle    bool\n201|\tBackgroundIdle    bool\n202|}\n203|\n204|var proofKinds = []string{\n205|\t\"closed_store\",\n206|\t\"immutable_snapshot\",\n207|\t\"verified_log_prefix\",\n208|\t\"provider_quiescence\",\n209|}\n210|\n211|func validProofKind(kind string) bool {\n212|\tfor _, allowed := range proofKinds {\n213|\t\tif kind == allowed {\n214|\t\t\treturn true\n215|\t\t}\n216|\t}\n217|\treturn false\n218|}\n219|\n220|var stableProofMembers = map[string]bool{\n221|\t\"proof_kind\": true, \"source_generation\": true, \"snapshot_identity_digest\": true,\n222|\t\"pre_capture_digest\": true, \"post_capture_digest\": true,\n223|\t\"input_blocked\": true, \"foreground_idle\": true, \"background_idle\": true, \"extensions\": true,\n224|}\n225|\n226|var stableProofRequired = []string{\n227|\t\"proof_kind\", \"source_generation\", \"snapshot_identity_digest\",\n228|\t\"pre_capture_digest\", \"post_capture_digest\",\n229|\t\"input_blocked\", \"foreground_idle\", \"background_idle\", \"extensions\",\n230|}\n231|\n232|// DecodeStableSnapshotProof validates one closed StableSnapshotProof:\n233|// equal capture digests, the proof-kind/identity/boolean coupling,\n234|// and the immutable generation token.\n235|func DecodeStableSnapshotProof(raw json.RawMessage) (StableSnapshotProof, error) {\n236|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n237|\tif fault != nil {\n238|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof %s (%s)\", fault.detail, memberField(fault.member))\n239|\t}\n240|\tif name, unknown := unknownMember(members, stableProofMembers); unknown {\n241|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof carries unknown member %q\", name)\n242|\t}\n243|\tif name, missing := missingMember(members, stableProofRequired); missing {\n244|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof misses a required member %q\", name)\n245|\t}\n246|\tkind, ok := rawString(members[\"proof_kind\"])\n247|\tif !ok || !validProofKind(kind) {\n248|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof kind is outside the closed proof vocabulary\")\n249|\t}\n250|\tgeneration, ok := checkGeneration(members[\"source_generation\"])\n251|\tif !ok {\n252|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof source_generation is not a string[1..512]\")\n253|\t}\n254|\tvar identity *scalar.Digest\n255|\tif !isNull(members[\"snapshot_identity_digest\"]) {\n256|\t\tvalue, ok := checkDigest(members[\"snapshot_identity_digest\"])\n257|\t\tif !ok {\n258|\t\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof snapshot_identity_digest is not a digest\")\n259|\t\t}\n260|\t\tidentity = &value\n261|\t}\n262|\tpre, ok := checkDigest(members[\"pre_capture_digest\"])\n263|\tif !ok {\n264|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof pre_capture_digest is not a digest\")\n265|\t}\n266|\tpost, ok := checkDigest(members[\"post_capture_digest\"])\n267|\tif !ok {\n268|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof post_capture_digest is not a digest\")\n269|\t}\n270|\tinputBlocked, ok := rawBool(members[\"input_blocked\"])\n271|\tif !ok {\n272|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof input_blocked is not a boolean\")\n273|\t}\n274|\tforegroundIdle, ok := rawBool(members[\"foreground_idle\"])\n275|\tif !ok {\n276|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof foreground_idle is not a boolean\")\n277|\t}\n278|\tbackgroundIdle, ok := rawBool(members[\"background_idle\"])\n279|\tif !ok {\n280|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof background_idle is not a boolean\")\n281|\t}\n282|\tproof := StableSnapshotProof{\n283|\t\tProofKind:         kind,\n284|\t\tSourceGeneration:  generation,\n285|\t\tSnapshotIdentity:  identity,\n286|\t\tPreCaptureDigest:  pre,\n287|\t\tPostCaptureDigest: post,\n288|\t\tInputBlocked:      inputBlocked,\n289|\t\tForegroundIdle:    foregroundIdle,\n290|\t\tBackgroundIdle:    backgroundIdle,\n291|\t}\n292|\tif err := checkProofCoupling(proof); err != nil {\n293|\t\treturn StableSnapshotProof{}, err\n294|\t}\n295|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n296|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof extensions %s\", extensionsFault)\n297|\t}\n298|\treturn proof, nil\n299|}\n300|\n301|// checkProofCoupling enforces the proof-kind/identity/boolean\n302|// coupling: capture digests are equal (size equality is never\n303|// proof and is not consulted); closed-store and\n304|// provider-quiescence require all booleans true and null snapshot\n305|// identity; immutable-snapshot and log-prefix require non-null\n306|// identity.\n307|func checkProofCoupling(proof StableSnapshotProof) error {\n308|\tif err := CheckDigestsEqual(proof.PreCaptureDigest, proof.PostCaptureDigest); err != nil {\n309|\t\treturn invalid(\"stable snapshot proof: %v\", err)\n310|\t}\n311|\tswitch proof.ProofKind {\n312|\tcase \"closed_store\", \"provider_quiescence\":\n313|\t\tif proof.SnapshotIdentity != nil {\n314|\t\t\treturn invalid(\"stable snapshot proof %s requires null snapshot identity\", proof.ProofKind)\n315|\t\t}\n316|\t\tif !proof.InputBlocked || !proof.ForegroundIdle || !proof.BackgroundIdle {\n317|\t\t\treturn invalid(\"stable snapshot proof %s requires input_blocked, foreground_idle, and background_idle\", proof.ProofKind)\n318|\t\t}\n319|\tcase \"immutable_snapshot\", \"verified_log_prefix\":\n320|\t\tif proof.SnapshotIdentity == nil {\n321|\t\t\treturn invalid(\"stable snapshot proof %s requires non-null snapshot identity\", proof.ProofKind)\n322|\t\t}\n323|\t}\n324|\treturn nil\n325|}\n326|\n327|// CaptureBoundary is one validated Capture Boundary.\n328|type CaptureBoundary struct {\n329|\tKind              string\n330|\tProof             *StableSnapshotProof\n331|\tSourceGeneration  *Generation\n332|\tPreCaptureDigest  *scalar.Digest\n333|\tPostCaptureDigest *scalar.Digest\n334|}\n335|\n336|// Stable reports whether the boundary is the stable form.\n337|func (boundary CaptureBoundary) Stable() bool { return boundary.Kind == \"stable\" }\n338|\n339|var stableBoundaryMembers = map[string]bool{\n340|\t\"kind\": true, \"proof\": true, \"extensions\": true,\n341|}\n342|\n343|var stableBoundaryRequired = []string{\"kind\", \"proof\", \"extensions\"}\n344|\n345|var unstableBoundaryMembers = map[string]bool{\n346|\t\"kind\": true, \"source_generation\": true, \"pre_capture_digest\": true,\n347|\t\"post_capture_digest\": true, \"reason_code\": true,\n348|\t\"operator_explicit\": true, \"target_projection_forbidden\": true, \"extensions\": true,\n349|}\n350|\n351|var unstableBoundaryRequired = []string{\n352|\t\"kind\", \"source_generation\", \"pre_capture_digest\",\n353|\t\"post_capture_digest\", \"reason_code\",\n354|\t\"operator_explicit\", \"target_projection_forbidden\", \"extensions\",\n355|}\n356|\n357|// DecodeCaptureBoundary validates one closed Capture Boundary.\n358|func DecodeCaptureBoundary(raw json.RawMessage) (CaptureBoundary, error) {\n359|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n360|\tif fault != nil {\n361|\t\treturn CaptureBoundary{}, invalid(\"capture boundary %s (%s)\", fault.detail, memberField(fault.member))\n362|\t}\n363|\tkindValue, present := members[\"kind\"]\n364|\tif !present {\n365|\t\treturn CaptureBoundary{}, invalid(\"capture boundary misses a required member %q\", \"kind\")\n366|\t}\n367|\tkind, ok := rawString(kindValue)\n368|\tif !ok {\n369|\t\treturn CaptureBoundary{}, invalid(\"capture boundary kind is not a string\")\n370|\t}\n371|\tswitch kind {\n372|\tcase \"stable\":\n373|\t\treturn decodeStableBoundary(members)\n374|\tcase \"unstable_archive\":\n375|\t\treturn decodeUnstableBoundary(members)\n376|\tdefault:\n377|\t\treturn CaptureBoundary{}, invalid(\"capture boundary kind is outside stable|unstable_archive\")\n378|\t}\n379|}\n380|\n381|func decodeStableBoundary(members map[string]json.RawMessage) (CaptureBoundary, error) {\n382|\tif name, unknown := unknownMember(members, stableBoundaryMembers); unknown {\n383|\t\treturn CaptureBoundary{}, invalid(\"capture boundary carries unknown member %q\", name)\n384|\t}\n385|\tif name, missing := missingMember(members, stableBoundaryRequired); missing {\n386|\t\treturn CaptureBoundary{}, invalid(\"capture boundary misses a required member %q\", name)\n387|\t}\n388|\tproof, err := DecodeStableSnapshotProof(members[\"proof\"])\n389|\tif err != nil {\n390|\t\treturn CaptureBoundary{}, err\n391|\t}\n392|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n393|\t\treturn CaptureBoundary{}, invalid(\"capture boundary extensions %s\", extensionsFault)\n394|\t}\n395|\treturn CaptureBoundary{Kind: \"stable\", Proof: &proof}, nil\n396|}\n397|\n398|func decodeUnstableBoundary(members map[string]json.RawMessage) (CaptureBoundary, error) {\n399|\tif name, unknown := unknownMember(members, unstableBoundaryMembers); unknown {\n400|\t\treturn CaptureBoundary{}, invalid(\"capture boundary carries unknown member %q\", name)\n401|\t}\n402|\tif name, missing := missingMember(members, unstableBoundaryRequired); missing {\n403|\t\treturn CaptureBoundary{}, invalid(\"capture boundary misses a required member %q\", name)\n404|\t}\n405|\tgeneration, ok := checkGeneration(members[\"source_generation\"])\n406|\tif !ok {\n407|\t\treturn CaptureBoundary{}, invalid(\"capture boundary source_generation is not a string[1..512]\")\n408|\t}\n409|\tpre, ok := checkDigest(members[\"pre_capture_digest\"])\n410|\tif !ok {\n411|\t\treturn CaptureBoundary{}, invalid(\"capture boundary pre_capture_digest is not a digest\")\n412|\t}\n413|\tpost, ok := checkDigest(members[\"post_capture_digest\"])\n414|\tif !ok {\n415|\t\treturn CaptureBoundary{}, invalid(\"capture boundary post_capture_digest is not a digest\")\n416|\t}\n417|\treason, ok := rawString(members[\"reason_code\"])\n418|\tif !ok || reason != \"source_not_quiescent\" {\n419|\t\treturn CaptureBoundary{}, invalid(\"capture boundary reason_code is not source_not_quiescent\")\n420|\t}\n421|\texplicit, ok := rawBool(members[\"operator_explicit\"])\n422|\tif !ok || !explicit {\n423|\t\treturn CaptureBoundary{}, invalid(\"capture boundary operator_explicit is not true\")\n424|\t}\n425|\tforbidden, ok := rawBool(members[\"target_projection_forbidden\"])\n426|\tif !ok || !forbidden {\n427|\t\treturn CaptureBoundary{}, invalid(\"capture boundary target_projection_forbidden is not true\")\n428|\t}\n429|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n430|\t\treturn CaptureBoundary{}, invalid(\"capture boundary extensions %s\", extensionsFault)\n431|\t}\n432|\treturn CaptureBoundary{\n433|\t\tKind:              \"unstable_archive\",\n434|\t\tSourceGeneration:  &generation,\n435|\t\tPreCaptureDigest:  &pre,\n436|\t\tPostCaptureDigest: &post,\n437|\t}, nil\n438|}\n439|\n440|// RefuseUnstableForTarget is the G2 target-branch gate: the unstable\n441|// archive form is core-created archive-only output and can never\n442|// enter a target branch, so target admission refuses it.\n443|func RefuseUnstableForTarget(boundary CaptureBoundary) error {\n444|\tif boundary.Kind == \"unstable_archive\" {\n445|\t\treturn invalid(\"capture boundary unstable_archive cannot enter a target branch\")\n446|\t}\n447|\tif boundary.Kind != \"stable\" {\n448|\t\treturn invalid(\"capture boundary kind is outside stable|unstable_archive\")\n449|\t}\n450|\treturn nil\n451|}\n452|\n453|// BoundaryInput is one caller-supplied capture boundary candidate\n454|// for Build. Core must be true to construct the unstable archive\n455|// form; only core may construct it. Core is a caller assertion at\n456|// this entry, so \"only core may construct\" is nominal here: the\n457|// real protection is RefuseUnstableForTarget, which refuses every\n458|// unstable archive at target-branch admission regardless of who\n459|// constructed it.\n460|type BoundaryInput struct {\n461|\tKind              string\n462|\tProofKind         string\n463|\tGeneration        string\n464|\tSnapshotIdentity  *string\n465|\tPreCaptureDigest  string\n466|\tPostCaptureDigest string\n467|\tInputBlocked      bool\n468|\tForegroundIdle    bool\n469|\tBackgroundIdle    bool\n470|\tCore              bool\n471|}\n472|\n473|func buildBoundary(input BoundaryInput) (CaptureBoundary, map[string]any, error) {\n474|\tswitch input.Kind {\n475|\tcase \"stable\":\n476|\t\tproof, object, err := buildStableProof(input)\n477|\t\tif err != nil {\n478|\t\t\treturn CaptureBoundary{}, nil, err\n479|\t\t}\n480|\t\tboundary := CaptureBoundary{Kind: \"stable\", Proof: &proof}\n481|\t\treturn boundary, map[string]any{\n482|\t\t\t\"kind\":       \"stable\",\n483|\t\t\t\"proof\":      object,\n484|\t\t\t\"extensions\": map[string]any{},\n485|\t\t}, nil\n486|\tcase \"unstable_archive\":\n487|\t\tif !input.Core {\n488|\t\t\treturn CaptureBoundary{}, nil, invalid(\"capture boundary unstable_archive is core-created only\")\n489|\t\t}\n490|\t\tgeneration, err := ParseGeneration(input.Generation)\n491|\t\tif err != nil {\n492|\t\t\treturn CaptureBoundary{}, nil, err\n493|\t\t}\n494|\t\tpre, err := scalar.ParseDigest(input.PreCaptureDigest)\n495|\t\tif err != nil {\n496|\t\t\treturn CaptureBoundary{}, nil, invalid(\"capture boundary pre_capture_digest is not a digest: %v\", err)\n497|\t\t}\n498|\t\tpost, err := scalar.ParseDigest(input.PostCaptureDigest)\n499|\t\tif err != nil {\n500|\t\t\treturn CaptureBoundary{}, nil, invalid(\"capture boundary post_capture_digest is not a digest: %v\", err)\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c823","stream":{"kind":"session","id":"01a0b1d2-62fd-7091-a15f-687f76c867f4"},"sequence":620,"recorded_at":1780531400001235,"record_type":"event","durability":"durable","causation_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","run_stream":{"kind":"run","id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb"},"task_stream":{"kind":"task","id":"01a0b1d5-3055-7a31-90c0-9433d109bcb9"},"task_id":"01a0b1d5-3055-7a31-90c0-9433d109bcb9","event":{"kind":"completed","task_id":"01a0b1d5-3055-7a31-90c0-9433d109bcb9"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c825","stream":{"kind":"session","id":"01a0b1d2-62fd-7091-a15f-687f76c867f4"},"sequence":621,"recorded_at":1780531400001237,"record_type":"event","durability":"durable","causation_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","run_stream":{"kind":"run","id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb"},"call_id":"call_01a0b1d52d18734ab9e6aa0439c97e36","text":"Read text file `internal/clonebundle/boundary.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n7|)\n8|\n9|// This file validates the Capture Source Basis and Capture Boundary\n10|// closed unions of Clone Capture Manifest 1.0.0, including the\n11|// StableSnapshotProof. The stable form carries proof; the unstable\n12|// form is core-created archive-only output that can never enter a\n13|// target branch.\n14|\n15|// SourceBasis is one validated Capture Source Basis.\n16|type SourceBasis struct {\n17|\tKind                     string\n18|\tSourceSessionID          *scalar.UUIDv7\n19|\tSourceSessionRecordID    *scalar.Digest\n20|\tSourceCheckpointID       *scalar.Digest\n21|\tSourceProviderIdentityID *scalar.Digest\n22|\tExternalSourceRef        *string\n23|}\n24|\n25|var sourceBasisAXMembers = map[string]bool{\n26|\t\"kind\": true, \"source_session_id\": true, \"source_session_record_id\": true,\n27|\t\"source_checkpoint_id\": true, \"source_provider_identity_record_id\": true, \"extensions\": true,\n28|}\n29|\n30|var sourceBasisAXRequired = []string{\n31|\t\"kind\", \"source_session_id\", \"source_session_record_id\",\n32|\t\"source_checkpoint_id\", \"source_provider_identity_record_id\", \"extensions\",\n33|}\n34|\n35|var sourceBasisExternalMembers = map[string]bool{\n36|\t\"kind\": true, \"external_source_ref\": true, \"extensions\": true,\n37|}\n38|\n39|var sourceBasisExternalRequired = []string{\n40|\t\"kind\", \"external_source_ref\", \"extensions\",\n41|}\n42|\n43|// DecodeSourceBasis validates one closed Capture Source Basis.\n44|func DecodeSourceBasis(raw json.RawMessage) (SourceBasis, error) {\n45|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n46|\tif fault != nil {\n47|\t\treturn SourceBasis{}, invalid(\"source basis %s (%s)\", fault.detail, memberField(fault.member))\n48|\t}\n49|\tkindValue, present := members[\"kind\"]\n50|\tif !present {\n51|\t\treturn SourceBasis{}, invalid(\"source basis misses a required member %q\", \"kind\")\n52|\t}\n53|\tkind, ok := rawString(kindValue)\n54|\tif !ok {\n55|\t\treturn SourceBasis{}, invalid(\"source basis kind is not a string\")\n56|\t}\n57|\tswitch kind {\n58|\tcase \"ax_session\":\n59|\t\treturn decodeAXSessionBasis(members)\n60|\tcase \"external_native\":\n61|\t\treturn decodeExternalNativeBasis(members)\n62|\tdefault:\n63|\t\treturn SourceBasis{}, invalid(\"source basis kind is outside ax_session|external_native\")\n64|\t}\n65|}\n66|\n67|func decodeAXSessionBasis(members map[string]json.RawMessage) (SourceBasis, error) {\n68|\tif name, unknown := unknownMember(members, sourceBasisAXMembers); unknown {\n69|\t\treturn SourceBasis{}, invalid(\"source basis carries unknown member %q\", name)\n70|\t}\n71|\tif name, missing := missingMember(members, sourceBasisAXRequired); missing {\n72|\t\treturn SourceBasis{}, invalid(\"source basis misses a required member %q\", name)\n73|\t}\n74|\tsessionID, ok := checkUUIDv7(members[\"source_session_id\"])\n75|\tif !ok {\n76|\t\treturn SourceBasis{}, invalid(\"source basis source_session_id is not a UUIDv7\")\n77|\t}\n78|\trecordID, ok := checkDigest(members[\"source_session_record_id\"])\n79|\tif !ok {\n80|\t\treturn SourceBasis{}, invalid(\"source basis source_session_record_id is not a digest\")\n81|\t}\n82|\tcheckpointID, ok := checkDigest(members[\"source_checkpoint_id\"])\n83|\tif !ok {\n84|\t\treturn SourceBasis{}, invalid(\"source basis source_checkpoint_id is not a digest\")\n85|\t}\n86|\tproviderID, ok := checkDigest(members[\"source_provider_identity_record_id\"])\n87|\tif !ok {\n88|\t\treturn SourceBasis{}, invalid(\"source basis source_provider_identity_record_id is not a digest\")\n89|\t}\n90|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n91|\t\treturn SourceBasis{}, invalid(\"source basis extensions %s\", extensionsFault)\n92|\t}\n93|\treturn SourceBasis{\n94|\t\tKind:                     \"ax_session\",\n95|\t\tSourceSessionID:          &sessionID,\n96|\t\tSourceSessionRecordID:    &recordID,\n97|\t\tSourceCheckpointID:       &checkpointID,\n98|\t\tSourceProviderIdentityID: &providerID,\n99|\t}, nil\n100|}\n101|\n102|func decodeExternalNativeBasis(members map[string]json.RawMessage) (SourceBasis, error) {\n103|\tif name, unknown := unknownMember(members, sourceBasisExternalMembers); unknown {\n104|\t\treturn SourceBasis{}, invalid(\"source basis carries unknown member %q\", name)\n105|\t}\n106|\tif name, missing := missingMember(members, sourceBasisExternalRequired); missing {\n107|\t\treturn SourceBasis{}, invalid(\"source basis misses a required member %q\", name)\n108|\t}\n109|\treference, ok := checkStringBounds(members[\"external_source_ref\"], 1, 512)\n110|\tif !ok {\n111|\t\treturn SourceBasis{}, invalid(\"source basis external_source_ref is not a string[1..512]\")\n112|\t}\n113|\tif err := SanitizeNativeKey(reference); err != nil {\n114|\t\treturn SourceBasis{}, err\n115|\t}\n116|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n117|\t\treturn SourceBasis{}, invalid(\"source basis extensions %s\", extensionsFault)\n118|\t}\n119|\treturn SourceBasis{Kind: \"external_native\", ExternalSourceRef: &reference}, nil\n120|}\n121|\n122|// SourceBasisInput is one caller-supplied source basis candidate for\n123|// Build. Exactly the kind-selected fields must be set.\n124|type SourceBasisInput struct {\n125|\tKind                     string\n126|\tSourceSessionID          string\n127|\tSourceSessionRecordID    string\n128|\tSourceCheckpointID       string\n129|\tSourceProviderIdentityID string\n130|\tExternalSourceRef        string\n131|}\n132|\n133|func buildSourceBasis(input SourceBasisInput) (SourceBasis, map[string]any, error) {\n134|\tswitch input.Kind {\n135|\tcase \"ax_session\":\n136|\t\tsessionID, err := scalar.ParseUUIDv7(input.SourceSessionID)\n137|\t\tif err != nil {\n138|\t\t\treturn SourceBasis{}, nil, invalid(\"source basis source_session_id is not a UUIDv7: %v\", err)\n139|\t\t}\n140|\t\trecordID, err := scalar.ParseDigest(input.SourceSessionRecordID)\n141|\t\tif err != nil {\n142|\t\t\treturn SourceBasis{}, nil, invalid(\"source basis source_session_record_id is not a digest: %v\", err)\n143|\t\t}\n144|\t\tcheckpointID, err := scalar.ParseDigest(input.SourceCheckpointID)\n145|\t\tif err != nil {\n146|\t\t\treturn SourceBasis{}, nil, invalid(\"source basis source_checkpoint_id is not a digest: %v\", err)\n147|\t\t}\n148|\t\tproviderID, err := scalar.ParseDigest(input.SourceProviderIdentityID)\n149|\t\tif err != nil {\n150|\t\t\treturn SourceBasis{}, nil, invalid(\"source basis source_provider_identity_record_id is not a digest: %v\", err)\n151|\t\t}\n152|\t\tif input.ExternalSourceRef != \"\" {\n153|\t\t\treturn SourceBasis{}, nil, invalid(\"source basis ax_session carries an external source reference\")\n154|\t\t}\n155|\t\tbasis := SourceBasis{\n156|\t\t\tKind:                     \"ax_session\",\n157|\t\t\tSourceSessionID:          &sessionID,\n158|\t\t\tSourceSessionRecordID:    &recordID,\n159|\t\t\tSourceCheckpointID:       &checkpointID,\n160|\t\t\tSourceProviderIdentityID: &providerID,\n161|\t\t}\n162|\t\treturn basis, map[string]any{\n163|\t\t\t\"kind\":                               \"ax_session\",\n164|\t\t\t\"source_session_id\":                  sessionID.String(),\n165|\t\t\t\"source_session_record_id\":           recordID.String(),\n166|\t\t\t\"source_checkpoint_id\":               checkpointID.String(),\n167|\t\t\t\"source_provider_identity_record_id\": providerID.String(),\n168|\t\t\t\"extensions\":                         map[string]any{},\n169|\t\t}, nil\n170|\tcase \"external_native\":\n171|\t\tif stringLength(input.ExternalSourceRef) < 1 || stringLength(input.ExternalSourceRef) > 512 {\n172|\t\t\treturn SourceBasis{}, nil, invalid(\"source basis external_source_ref is not a string[1..512]\")\n173|\t\t}\n174|\t\tif err := SanitizeNativeKey(input.ExternalSourceRef); err != nil {\n175|\t\t\treturn SourceBasis{}, nil, err\n176|\t\t}\n177|\t\tif input.SourceSessionID != \"\" || input.SourceSessionRecordID != \"\" ||\n178|\t\t\tinput.SourceCheckpointID != \"\" || input.SourceProviderIdentityID != \"\" {\n179|\t\t\treturn SourceBasis{}, nil, invalid(\"source basis external_native carries ax_session members\")\n180|\t\t}\n181|\t\tbasis := SourceBasis{Kind: \"external_native\", ExternalSourceRef: &input.ExternalSourceRef}\n182|\t\treturn basis, map[string]any{\n183|\t\t\t\"kind\":                \"external_native\",\n184|\t\t\t\"external_source_ref\": input.ExternalSourceRef,\n185|\t\t\t\"extensions\":          map[string]any{},\n186|\t\t}, nil\n187|\tdefault:\n188|\t\treturn SourceBasis{}, nil, invalid(\"source basis kind is outside ax_session|external_native\")\n189|\t}\n190|}\n191|\n192|// StableSnapshotProof is one validated stable snapshot proof.\n193|type StableSnapshotProof struct {\n194|\tProofKind         string\n195|\tSourceGeneration  Generation\n196|\tSnapshotIdentity  *scalar.Digest\n197|\tPreCaptureDigest  scalar.Digest\n198|\tPostCaptureDigest scalar.Digest\n199|\tInputBlocked      bool\n200|\tForegroundIdle    bool\n201|\tBackgroundIdle    bool\n202|}\n203|\n204|var proofKinds = []string{\n205|\t\"closed_store\",\n206|\t\"immutable_snapshot\",\n207|\t\"verified_log_prefix\",\n208|\t\"provider_quiescence\",\n209|}\n210|\n211|func validProofKind(kind string) bool {\n212|\tfor _, allowed := range proofKinds {\n213|\t\tif kind == allowed {\n214|\t\t\treturn true\n215|\t\t}\n216|\t}\n217|\treturn false\n218|}\n219|\n220|var stableProofMembers = map[string]bool{\n221|\t\"proof_kind\": true, \"source_generation\": true, \"snapshot_identity_digest\": true,\n222|\t\"pre_capture_digest\": true, \"post_capture_digest\": true,\n223|\t\"input_blocked\": true, \"foreground_idle\": true, \"background_idle\": true, \"extensions\": true,\n224|}\n225|\n226|var stableProofRequired = []string{\n227|\t\"proof_kind\", \"source_generation\", \"snapshot_identity_digest\",\n228|\t\"pre_capture_digest\", \"post_capture_digest\",\n229|\t\"input_blocked\", \"foreground_idle\", \"background_idle\", \"extensions\",\n230|}\n231|\n232|// DecodeStableSnapshotProof validates one closed StableSnapshotProof:\n233|// equal capture digests, the proof-kind/identity/boolean coupling,\n234|// and the immutable generation token.\n235|func DecodeStableSnapshotProof(raw json.RawMessage) (StableSnapshotProof, error) {\n236|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n237|\tif fault != nil {\n238|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof %s (%s)\", fault.detail, memberField(fault.member))\n239|\t}\n240|\tif name, unknown := unknownMember(members, stableProofMembers); unknown {\n241|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof carries unknown member %q\", name)\n242|\t}\n243|\tif name, missing := missingMember(members, stableProofRequired); missing {\n244|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof misses a required member %q\", name)\n245|\t}\n246|\tkind, ok := rawString(members[\"proof_kind\"])\n247|\tif !ok || !validProofKind(kind) {\n248|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof kind is outside the closed proof vocabulary\")\n249|\t}\n250|\tgeneration, ok := checkGeneration(members[\"source_generation\"])\n251|\tif !ok {\n252|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof source_generation is not a string[1..512]\")\n253|\t}\n254|\tvar identity *scalar.Digest\n255|\tif !isNull(members[\"snapshot_identity_digest\"]) {\n256|\t\tvalue, ok := checkDigest(members[\"snapshot_identity_digest\"])\n257|\t\tif !ok {\n258|\t\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof snapshot_identity_digest is not a digest\")\n259|\t\t}\n260|\t\tidentity = &value\n261|\t}\n262|\tpre, ok := checkDigest(members[\"pre_capture_digest\"])\n263|\tif !ok {\n264|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof pre_capture_digest is not a digest\")\n265|\t}\n266|\tpost, ok := checkDigest(members[\"post_capture_digest\"])\n267|\tif !ok {\n268|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof post_capture_digest is not a digest\")\n269|\t}\n270|\tinputBlocked, ok := rawBool(members[\"input_blocked\"])\n271|\tif !ok {\n272|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof input_blocked is not a boolean\")\n273|\t}\n274|\tforegroundIdle, ok := rawBool(members[\"foreground_idle\"])\n275|\tif !ok {\n276|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof foreground_idle is not a boolean\")\n277|\t}\n278|\tbackgroundIdle, ok := rawBool(members[\"background_idle\"])\n279|\tif !ok {\n280|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof background_idle is not a boolean\")\n281|\t}\n282|\tproof := StableSnapshotProof{\n283|\t\tProofKind:         kind,\n284|\t\tSourceGeneration:  generation,\n285|\t\tSnapshotIdentity:  identity,\n286|\t\tPreCaptureDigest:  pre,\n287|\t\tPostCaptureDigest: post,\n288|\t\tInputBlocked:      inputBlocked,\n289|\t\tForegroundIdle:    foregroundIdle,\n290|\t\tBackgroundIdle:    backgroundIdle,\n291|\t}\n292|\tif err := checkProofCoupling(proof); err != nil {\n293|\t\treturn StableSnapshotProof{}, err\n294|\t}\n295|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n296|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof extensions %s\", extensionsFault)\n297|\t}\n298|\treturn proof, nil\n299|}\n300|\n301|// checkProofCoupling enforces the proof-kind/identity/boolean\n302|// coupling: capture digests are equal (size equality is never\n303|// proof and is not consulted); closed-store and\n304|// provider-quiescence require all booleans true and null snapshot\n305|// identity; immutable-snapshot and log-prefix require non-null\n306|// identity.\n307|func checkProofCoupling(proof StableSnapshotProof) error {\n308|\tif err := CheckDigestsEqual(proof.PreCaptureDigest, proof.PostCaptureDigest); err != nil {\n309|\t\treturn invalid(\"stable snapshot proof: %v\", err)\n310|\t}\n311|\tswitch proof.ProofKind {\n312|\tcase \"closed_store\", \"provider_quiescence\":\n313|\t\tif proof.SnapshotIdentity != nil {\n314|\t\t\treturn invalid(\"stable snapshot proof %s requires null snapshot identity\", proof.ProofKind)\n315|\t\t}\n316|\t\tif !proof.InputBlocked || !proof.ForegroundIdle || !proof.BackgroundIdle {\n317|\t\t\treturn invalid(\"stable snapshot proof %s requires input_blocked, foreground_idle, and background_idle\", proof.ProofKind)\n318|\t\t}\n319|\tcase \"immutable_snapshot\", \"verified_log_prefix\":\n320|\t\tif proof.SnapshotIdentity == nil {\n321|\t\t\treturn invalid(\"stable snapshot proof %s requires non-null snapshot identity\", proof.ProofKind)\n322|\t\t}\n323|\t}\n324|\treturn nil\n325|}\n326|\n327|// CaptureBoundary is one validated Capture Boundary.\n328|type CaptureBoundary struct {\n329|\tKind              string\n330|\tProof             *StableSnapshotProof\n331|\tSourceGeneration  *Generation\n332|\tPreCaptureDigest  *scalar.Digest\n333|\tPostCaptureDigest *scalar.Digest\n334|}\n335|\n336|// Stable reports whether the boundary is the stable form.\n337|func (boundary CaptureBoundary) Stable() bool { return boundary.Kind == \"stable\" }\n338|\n339|var stableBoundaryMembers = map[string]bool{\n340|\t\"kind\": true, \"proof\": true, \"extensions\": true,\n341|}\n342|\n343|var stableBoundaryRequired = []string{\"kind\", \"proof\", \"extensions\"}\n344|\n345|var unstableBoundaryMembers = map[string]bool{\n346|\t\"kind\": true, \"source_generation\": true, \"pre_capture_digest\": true,\n347|\t\"post_capture_digest\": true, \"reason_code\": true,\n348|\t\"operator_explicit\": true, \"target_projection_forbidden\": true, \"extensions\": true,\n349|}\n350|\n351|var unstableBoundaryRequired = []string{\n352|\t\"kind\", \"source_generation\", \"pre_capture_digest\",\n353|\t\"post_capture_digest\", \"reason_code\",\n354|\t\"operator_explicit\", \"target_projection_forbidden\", \"extensions\",\n355|}\n356|\n357|// DecodeCaptureBoundary validates one closed Capture Boundary.\n358|func DecodeCaptureBoundary(raw json.RawMessage) (CaptureBoundary, error) {\n359|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n360|\tif fault != nil {\n361|\t\treturn CaptureBoundary{}, invalid(\"capture boundary %s (%s)\", fault.detail, memberField(fault.member))\n362|\t}\n363|\tkindValue, present := members[\"kind\"]\n364|\tif !present {\n365|\t\treturn CaptureBoundary{}, invalid(\"capture boundary misses a required member %q\", \"kind\")\n366|\t}\n367|\tkind, ok := rawString(kindValue)\n368|\tif !ok {\n369|\t\treturn CaptureBoundary{}, invalid(\"capture boundary kind is not a string\")\n370|\t}\n371|\tswitch kind {\n372|\tcase \"stable\":\n373|\t\treturn decodeStableBoundary(members)\n374|\tcase \"unstable_archive\":\n375|\t\treturn decodeUnstableBoundary(members)\n376|\tdefault:\n377|\t\treturn CaptureBoundary{}, invalid(\"capture boundary kind is outside stable|unstable_archive\")\n378|\t}\n379|}\n380|\n381|func decodeStableBoundary(members map[string]json.RawMessage) (CaptureBoundary, error) {\n382|\tif name, unknown := unknownMember(members, stableBoundaryMembers); unknown {\n383|\t\treturn CaptureBoundary{}, invalid(\"capture boundary carries unknown member %q\", name)\n384|\t}\n385|\tif name, missing := missingMember(members, stableBoundaryRequired); missing {\n386|\t\treturn CaptureBoundary{}, invalid(\"capture boundary misses a required member %q\", name)\n387|\t}\n388|\tproof, err := DecodeStableSnapshotProof(members[\"proof\"])\n389|\tif err != nil {\n390|\t\treturn CaptureBoundary{}, err\n391|\t}\n392|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n393|\t\treturn CaptureBoundary{}, invalid(\"capture boundary extensions %s\", extensionsFault)\n394|\t}\n395|\treturn CaptureBoundary{Kind: \"stable\", Proof: &proof}, nil\n396|}\n397|\n398|func decodeUnstableBoundary(members map[string]json.RawMessage) (CaptureBoundary, error) {\n399|\tif name, unknown := unknownMember(members, unstableBoundaryMembers); unknown {\n400|\t\treturn CaptureBoundary{}, invalid(\"capture boundary carries unknown member %q\", name)\n401|\t}\n402|\tif name, missing := missingMember(members, unstableBoundaryRequired); missing {\n403|\t\treturn CaptureBoundary{}, invalid(\"capture boundary misses a required member %q\", name)\n404|\t}\n405|\tgeneration, ok := checkGeneration(members[\"source_generation\"])\n406|\tif !ok {\n407|\t\treturn CaptureBoundary{}, invalid(\"capture boundary source_generation is not a string[1..512]\")\n408|\t}\n409|\tpre, ok := checkDigest(members[\"pre_capture_digest\"])\n410|\tif !ok {\n411|\t\treturn CaptureBoundary{}, invalid(\"capture boundary pre_capture_digest is not a digest\")\n412|\t}\n413|\tpost, ok := checkDigest(members[\"post_capture_digest\"])\n414|\tif !ok {\n415|\t\treturn CaptureBoundary{}, invalid(\"capture boundary post_capture_digest is not a digest\")\n416|\t}\n417|\treason, ok := rawString(members[\"reason_code\"])\n418|\tif !ok || reason != \"source_not_quiescent\" {\n419|\t\treturn CaptureBoundary{}, invalid(\"capture boundary reason_code is not source_not_quiescent\")\n420|\t}\n421|\texplicit, ok := rawBool(members[\"operator_explicit\"])\n422|\tif !ok || !explicit {\n423|\t\treturn CaptureBoundary{}, invalid(\"capture boundary operator_explicit is not true\")\n424|\t}\n425|\tforbidden, ok := rawBool(members[\"target_projection_forbidden\"])\n426|\tif !ok || !forbidden {\n427|\t\treturn CaptureBoundary{}, invalid(\"capture boundary target_projection_forbidden is not true\")\n428|\t}\n429|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n430|\t\treturn CaptureBoundary{}, invalid(\"capture boundary extensions %s\", extensionsFault)\n431|\t}\n432|\treturn CaptureBoundary{\n433|\t\tKind:              \"unstable_archive\",\n434|\t\tSourceGeneration:  &generation,\n435|\t\tPreCaptureDigest:  &pre,\n436|\t\tPostCaptureDigest: &post,\n437|\t}, nil\n438|}\n439|\n440|// RefuseUnstableForTarget is the G2 target-branch gate: the unstable\n441|// archive form is core-created archive-only output and can never\n442|// enter a target branch, so target admission refuses it.\n443|func RefuseUnstableForTarget(boundary CaptureBoundary) error {\n444|\tif boundary.Kind == \"unstable_archive\" {\n445|\t\treturn invalid(\"capture boundary unstable_archive cannot enter a target branch\")\n446|\t}\n447|\tif boundary.Kind != \"stable\" {\n448|\t\treturn invalid(\"capture boundary kind is outside stable|unstable_archive\")\n449|\t}\n450|\treturn nil\n451|}\n452|\n453|// BoundaryInput is one caller-supplied capture boundary candidate\n454|// for Build. Core must be true to construct the unstable archive\n455|// form; only core may construct it. Core is a caller assertion at\n456|// this entry, so \"only core may construct\" is nominal here: the\n457|// real protection is RefuseUnstableForTarget, which refuses every\n458|// unstable archive at target-branch admission regardless of who\n459|// constructed it.\n460|type BoundaryInput struct {\n461|\tKind              string\n462|\tProofKind         string\n463|\tGeneration        string\n464|\tSnapshotIdentity  *string\n465|\tPreCaptureDigest  string\n466|\tPostCaptureDigest string\n467|\tInputBlocked      bool\n468|\tForegroundIdle    bool\n469|\tBackgroundIdle    bool\n470|\tCore              bool\n471|}\n472|\n473|func buildBoundary(input BoundaryInput) (CaptureBoundary, map[string]any, error) {\n474|\tswitch input.Kind {\n475|\tcase \"stable\":\n476|\t\tproof, object, err := buildStableProof(input)\n477|\t\tif err != nil {\n478|\t\t\treturn CaptureBoundary{}, nil, err\n479|\t\t}\n480|\t\tboundary := CaptureBoundary{Kind: \"stable\", Proof: &proof}\n481|\t\treturn boundary, map[string]any{\n482|\t\t\t\"kind\":       \"stable\",\n483|\t\t\t\"proof\":      object,\n484|\t\t\t\"extensions\": map[string]any{},\n485|\t\t}, nil\n486|\tcase \"unstable_archive\":\n487|\t\tif !input.Core {\n488|\t\t\treturn CaptureBoundary{}, nil, invalid(\"capture boundary unstable_archive is core-created only\")\n489|\t\t}\n490|\t\tgeneration, err := ParseGeneration(input.Generation)\n491|\t\tif err != nil {\n492|\t\t\treturn CaptureBoundary{}, nil, err\n493|\t\t}\n494|\t\tpre, err := scalar.ParseDigest(input.PreCaptureDigest)\n495|\t\tif err != nil {\n496|\t\t\treturn CaptureBoundary{}, nil, invalid(\"capture boundary pre_capture_digest is not a digest: %v\", err)\n497|\t\t}\n498|\t\tpost, err := scalar.ParseDigest(input.PostCaptureDigest)\n499|\t\tif err != nil {\n500|\t\t\treturn CaptureBoundary{}, nil, invalid(\"capture boundary post_capture_digest is not a digest: %v\", err)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
