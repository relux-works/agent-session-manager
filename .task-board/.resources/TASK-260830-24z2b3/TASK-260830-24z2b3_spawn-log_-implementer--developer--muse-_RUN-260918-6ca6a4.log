{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c789","stream":{"kind":"session","id":"01a0b1d2-62fd-7091-a15f-687f76c867f4"},"sequence":543,"recorded_at":1780531400001081,"record_type":"event","durability":"durable","causation_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","run_stream":{"kind":"run","id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb"},"task_stream":{"kind":"task","id":"01a0b1d5-088e-79f1-8039-518f85ba1cd8"},"task_id":"01a0b1d5-088e-79f1-8039-518f85ba1cd8","event":{"kind":"output","task_id":"01a0b1d5-088e-79f1-8039-518f85ba1cd8","chunk":"Read text file `internal/clonebundle/session.go`.\n(499 line(s) above)\n500|\t\tactor, err := decodeActor(element, index)\n501|\t\tif err != nil {\n502|\t\t\treturn nil, err\n503|\t\t}\n504|\t\tif seen[actor.ActorID.String()] {\n505|\t\t\treturn nil, invalid(\"canonical session actors are not unique by actor ID\")\n506|\t\t}\n507|\t\tseen[actor.ActorID.String()] = true\n508|\t\tif actor.Kind == \"main\" {\n509|\t\t\tmainCount++\n510|\t\t}\n511|\t\tactors = append(actors, actor)\n512|\t}\n513|\tif mainCount != 1 {\n514|\t\treturn nil, invalid(\"canonical session carries %d main actors, want exactly one\", mainCount)\n515|\t}\n516|\treturn actors, nil\n517|}\n518|\n519|// decodeOrderedUniqueDigests validates ordered unique digests: order\n520|// is the caller's (event order), uniqueness is exact.\n521|func decodeOrderedUniqueDigests(raw json.RawMessage, minimum, maximum int, name string) ([]scalar.Digest, error) {\n522|\telements, ok := decodeArray(raw)\n523|\tif !ok {\n524|\t\treturn nil, invalid(\"canonical session %s are not an array\", name)\n525|\t}\n526|\tif len(elements) < minimum || len(elements) > maximum {\n527|\t\treturn nil, invalid(\"canonical session %s carry %d IDs, want [%d..%d]\", name, len(elements), minimum, maximum)\n528|\t}\n529|\tids := make([]scalar.Digest, 0, len(elements))\n530|\tseen := map[string]bool{}\n531|\tfor index, element := range elements {\n532|\t\tid, ok := checkDigest(element)\n533|\t\tif !ok {\n534|\t\t\treturn nil, invalid(\"canonical session %s[%d] is not a digest\", name, index)\n535|\t\t}\n536|\t\tif seen[id.String()] {\n537|\t\t\treturn nil, invalid(\"canonical session %s are not unique\", name)\n538|\t\t}\n539|\t\tseen[id.String()] = true\n540|\t\tids = append(ids, id)\n541|\t}\n542|\treturn ids, nil\n543|}\n544|\n545|func parseOrderedUniqueDigests(values []string, minimum, maximum int, name string) ([]scalar.Digest, error) {\n546|\tif len(values) < minimum || len(values) > maximum {\n547|\t\treturn nil, invalid(\"canonical session %s carry %d IDs, want [%d..%d]\", name, len(values), minimum, maximum)\n548|\t}\n549|\tids := make([]scalar.Digest, 0, len(values))\n550|\tseen := map[string]bool{}\n551|\tfor index, value := range values {\n552|\t\tid, err := scalar.ParseDigest(value)\n553|\t\tif err != nil {\n554|\t\t\treturn nil, invalid(\"canonical session %s[%d] is not a digest: %v\", name, index, err)\n555|\t\t}\n556|\t\tif seen[id.String()] {\n557|\t\t\treturn nil, invalid(\"canonical session %s are not unique\", name)\n558|\t\t}\n559|\t\tseen[id.String()] = true\n560|\t\tids = append(ids, id)\n561|\t}\n562|\treturn ids, nil\n563|}\n564|\n565|func parseSortedUniqueDigestStrings(values []string, minimum, maximum int, name string) ([]scalar.Digest, error) {\n566|\tif len(values) < minimum || len(values) > maximum {\n567|\t\treturn nil, invalid(\"canonical session %s carry %d IDs, want [%d..%d]\", name, len(values), minimum, maximum)\n568|\t}\n569|\tids := make([]scalar.Digest, 0, len(values))\n570|\tprevious := \"\"\n571|\tfor index, value := range values {\n572|\t\tid, err := scalar.ParseDigest(value)\n573|\t\tif err != nil {\n574|\t\t\treturn nil, invalid(\"canonical session %s[%d] is not a digest: %v\", name, index, err)\n575|\t\t}\n576|\t\tif index > 0 && id.String() <= previous {\n577|\t\t\treturn nil, invalid(\"canonical session %s are not sorted unique\", name)\n578|\t\t}\n579|\t\tprevious = id.String()\n580|\t\tids = append(ids, id)\n581|\t}\n582|\treturn ids, nil\n583|}\n584|\n585|func parseNullableTimestamp(value *string, name string) (any, error) {\n586|\tif value == nil {\n587|\t\treturn nil, nil\n588|\t}\n589|\tstamp, err := scalar.ParseTimestamp(*value)\n590|\tif err != nil {\n591|\t\treturn nil, invalid(\"canonical session %s is not a timestamp: %v\", name, err)\n592|\t}\n593|\treturn stamp.String(), nil\n594|}\n595|\n596|func decodeNullableTimestamp(members map[string]json.RawMessage, name, owner string) (*scalar.Timestamp, error) {\n597|\traw, present := members[name]\n598|\tif !present {\n599|\t\treturn nil, invalid(\"%s misses a required member %q\", owner, name)\n600|\t}\n601|\tif isNull(raw) {\n602|\t\treturn nil, nil\n603|\t}\n604|\tstamp, ok := checkTimestamp(raw)\n605|\tif !ok {\n606|\t\treturn nil, invalid(\"%s %s is not a timestamp\", owner, name)\n607|\t}\n608|\treturn &stamp, nil\n609|}\n610|\n611|func digestStrings(ids []scalar.Digest) []any {\n612|\tvalues := make([]any, 0, len(ids))\n613|\tfor _, id := range ids {\n614|\t\tvalues = append(values, id.String())\n615|\t}\n616|\treturn values\n617|}","final_result":true}}}
