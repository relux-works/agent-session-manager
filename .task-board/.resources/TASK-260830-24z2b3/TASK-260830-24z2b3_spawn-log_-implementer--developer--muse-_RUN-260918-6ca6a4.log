{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7ef","stream":{"kind":"session","id":"01a0b1d2-62fd-7091-a15f-687f76c867f4"},"sequence":594,"recorded_at":1780531400001183,"record_type":"event","durability":"durable","causation_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb","run_stream":{"kind":"run","id":"153c1ba2-b7e2-48bc-afc0-57c06fe1e8cb"},"task_stream":{"kind":"task","id":"01a0b1d5-1e73-7a50-a8b2-2be1bf821d10"},"task_id":"01a0b1d5-1e73-7a50-a8b2-2be1bf821d10","event":{"kind":"output","task_id":"01a0b1d5-1e73-7a50-a8b2-2be1bf821d10","chunk":"Read text file `internal/clonebundle/event.go`.\n(469 line(s) above)\n470|\t\t\"logical_session_id\": logical.String(),\n471|\t\t\"ordinal\":            input.Ordinal,\n472|\t\t\"parents\":            digestStrings(parents),\n473|\t\t\"actor_id\":           actorID.String(),\n474|\t\t\"turn_id\":            turn,\n475|\t\t\"kind\":               input.Kind,\n476|\t\t\"timestamp\":          stamp,\n477|\t\t\"visibility\":         input.Visibility,\n478|\t\t\"payload\":            payload,\n479|\t\t\"source_evidence\":    evidence,\n480|\t\t\"extensions\":         extensionValue(input.Extensions),\n481|\t}, nil\n482|}\n483|\n484|// DecodeCanonicalEvent validates one closed Canonical Event 1.0.0:\n485|// exact members, schema/version, self-digest agreement, the kind\n486|// and visibility vocabularies, the kind-selected payload rules,\n487|// and the source evidence coupling.\n488|func DecodeCanonicalEvent(data []byte) (CanonicalEvent, error) {\n489|\tmembers, fault := decodeStrictObject(data)\n490|\tif fault != nil {\n491|\t\treturn CanonicalEvent{}, invalid(\"canonical event %s (%s)\", fault.detail, memberField(fault.member))\n492|\t}\n493|\tif name, unknown := unknownMember(members, canonicalEventMembers); unknown {\n494|\t\treturn CanonicalEvent{}, invalid(\"canonical event carries unknown member %q\", name)\n495|\t}\n496|\tif name, missing := missingMember(members, canonicalEventRequired); missing {\n497|\t\treturn CanonicalEvent{}, invalid(\"canonical event misses a required member %q\", name)\n498|\t}\n499|\tschema, ok := rawString(members[\"schema\"])\n500|\tif !ok || schema != canonicalEventSchema {\n501|\t\treturn CanonicalEvent{}, invalid(\"canonical event schema is not the canonical event\")\n502|\t}\n503|\tversion, ok := rawString(members[\"schema_version\"])\n504|\tif !ok || version != canonicalEventVersion {\n505|\t\treturn CanonicalEvent{}, invalid(\"canonical event version is not 1.0.0\")\n506|\t}\n507|\teventID, ok := checkDigest(members[canonicalEventSelf])\n508|\tif !ok {\n509|\t\treturn CanonicalEvent{}, invalid(\"canonical event event_id is not a digest\")\n510|\t}\n511|\tlogical, ok := checkUUIDv7(members[\"logical_session_id\"])\n512|\tif !ok {\n513|\t\treturn CanonicalEvent{}, invalid(\"canonical event logical_session_id is not a UUIDv7\")\n514|\t}\n515|\tordinal, ok := checkUint53Bounds(members[\"ordinal\"], 0, maxUint53)\n516|\tif !ok {\n517|\t\treturn CanonicalEvent{}, invalid(\"canonical event ordinal is not a uint53\")\n518|\t}\n519|\tparents, ok := checkSortedUniqueDigests(members[\"parents\"], 0, 64)\n520|\tif !ok {\n521|\t\treturn CanonicalEvent{}, invalid(\"canonical event parents are not sorted unique digest[0..64]\")\n522|\t}\n523|\tactorID, ok := checkUUIDv7(members[\"actor_id\"])\n524|\tif !ok {\n525|\t\treturn CanonicalEvent{}, invalid(\"canonical event actor_id is not a UUIDv7\")\n526|\t}\n527|\tvar turn *scalar.UUIDv7\n528|\tif !isNull(members[\"turn_id\"]) {\n529|\t\tvalue, ok := checkUUIDv7(members[\"turn_id\"])\n530|\t\tif !ok {\n531|\t\t\treturn CanonicalEvent{}, invalid(\"canonical event turn_id is not a UUIDv7\")\n532|\t\t}\n533|\t\tturn = &value\n534|\t}\n535|\tkind, ok := rawString(members[\"kind\"])\n536|\tif !ok || !ValidEventKind(kind) {\n537|\t\treturn CanonicalEvent{}, invalid(\"canonical event kind is outside the 26-kind vocabulary\")\n538|\t}\n539|\tvar stamp *scalar.Timestamp\n540|\tif !isNull(members[\"timestamp\"]) {\n541|\t\tvalue, ok := checkTimestamp(members[\"timestamp\"])\n542|\t\tif !ok {\n543|\t\t\treturn CanonicalEvent{}, invalid(\"canonical event timestamp is not a timestamp\")\n544|\t\t}\n545|\t\tstamp = &value\n546|\t}\n547|\tvisibility, ok := rawString(members[\"visibility\"])\n548|\tif !ok || !validVisibility(visibility) {\n549|\t\treturn CanonicalEvent{}, invalid(\"canonical event visibility is outside public|projection|internal|opaque\")\n550|\t}\n551|\tpayload, err := checkPayload(kind, members[\"payload\"])\n552|\tif err != nil {\n553|\t\treturn CanonicalEvent{}, err\n554|\t}\n555|\tevidence, err := DecodeSourceEvidence(members[\"source_evidence\"])\n556|\tif err != nil {\n557|\t\treturn CanonicalEvent{}, err\n558|\t}\n559|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n560|\t\treturn CanonicalEvent{}, invalid(\"canonical event extensions %s\", extensionsFault)\n561|\t}\n562|\tif err := verifySelfDigest(members, canonicalEventSelf, eventID); err != nil {\n563|\t\treturn CanonicalEvent{}, err\n564|\t}\n565|\treturn CanonicalEvent{\n566|\t\tEventID:          eventID,\n567|\t\tLogicalSessionID: logical,\n568|\t\tOrdinal:          ordinal,\n569|\t\tParents:          parents,\n570|\t\tActorID:          actorID,\n571|\t\tTurnID:           turn,\n572|\t\tKind:             kind,\n573|\t\tTimestamp:        stamp,\n574|\t\tVisibility:       visibility,\n575|\t\tPayload:          payload,\n576|\t\tEvidence:         evidence,\n577|\t}, nil\n578|}\n579|\n580|// checkPayload validates the kind-selected closed payload: every\n581|// payload is a strict (duplicate-free) object carrying only\n582|// Section 1.6 values at every depth; message-like kinds carry\n583|// exactly content_blocks plus extensions; content blocks use exactly\n584|// the eight-type vocabulary with typed inline content (at most 64\n585|// KiB) or Blob Descriptor references. Per-kind fact registries\n586|// beyond this envelope are sibling scope, but the value model is\n587|// enforced here for every kind: no payload member may round or\n588|// collapse under sealing.\n589|func checkPayload(kind string, raw json.RawMessage) (map[string]any, error) {\n590|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n591|\tif fault != nil {\n592|\t\treturn nil, invalid(\"canonical event payload %s (%s)\", fault.detail, memberField(fault.member))\n593|\t}\n594|\tif messageLikeKind(kind) {\n595|\t\tallowed := map[string]bool{\"content_blocks\": true, \"extensions\": true}\n596|\t\tif name, unknown := unknownMember(members, allowed); unknown {\n597|\t\t\treturn nil, invalid(\"canonical event message payload carries unknown member %q\", name)\n598|\t\t}\n599|\t\tblocks, present := members[\"content_blocks\"]\n600|\t\tif !present {\n601|\t\t\treturn nil, invalid(\"canonical event message payload misses content_blocks\")\n602|\t\t}\n603|\t\tif err := checkContentBlocks(blocks); err != nil {\n604|\t\t\treturn nil, err\n605|\t\t}\n606|\t\tif extensions, present := members[\"extensions\"]; present {\n607|\t\t\tif extensionsFault := checkExtensionsClosed(extensions); extensionsFault != nil {\n608|\t\t\t\treturn nil, invalid(\"canonical event message payload extensions %s\", extensionsFault)\n609|\t\t\t}\n610|\t\t}\n611|\t} else if blocks, present := members[\"content_blocks\"]; present {\n612|\t\tif err := checkContentBlocks(blocks); err != nil {\n613|\t\t\treturn nil, err\n614|\t\t}\n615|\t}\n616|\tif err := checkPayloadValues(bytesTrimSpace(raw)); err != nil {\n617|\t\treturn nil, invalid(\"canonical event payload values %s\", err)\n618|\t}\n619|\tvar payload map[string]any\n620|\tdecoder := json.NewDecoder(bytes.NewReader(bytesTrimSpace(raw)))\n621|\tdecoder.UseNumber()\n622|\tif err := decoder.Decode(&payload); err != nil {\n623|\t\treturn nil, invalid(\"canonical event payload is not an object: %v\", err)\n624|\t}\n625|\treturn convertPayloadNumbers(payload)\n626|}\n627|\n628|// checkPayloadValues enforces the Section 1.6 value model on every\n629|// payload member at every depth: integer literals only, |n| <=\n630|// 2^53-1, no fraction or exponent, nested objects duplicate-free,\n631|// depth-bounded. Payload keys are per-kind fact names rather than\n632|// reverse-DNS names, so the closed extensions key rule does not\n633|// apply here; only the shared value walker runs. This walker is the\n634|// single gate: the converter below trusts it and only changes\n635|// number representation, never admission.\n636|func checkPayloadValues(raw json.RawMessage) error {\n637|\tif err := checkExtensionValues(raw); err != nil {\n638|\t\tif err == errExtensionShape {\n639|\t\t\treturn errPayloadShape\n640|\t\t}\n641|\t\treturn err\n642|\t}\n643|\treturn nil\n644|}\n645|\n646|// convertPayloadNumbers renders the validated payload with exact\n647|// integers: every json.Number the gate admitted is an in-range\n648|// integer literal, so it becomes an int64 that marshals\n649|// byte-exact. Host float64 never appears, so no sealed value can\n650|// round. A literal ParseInt cannot read is refused defensively;\n651|// the gate above admits no such literal.\n652|func convertPayloadNumbers(payload map[string]any) (map[string]any, error) {\n653|\tout := make(map[string]any, len(payload))\n654|\tfor name, value := range payload {\n655|\t\tconverted, err := convertPayloadValue(value)\n656|\t\tif err != nil {\n657|\t\t\treturn nil, err\n658|\t\t}\n659|\t\tout[name] = converted\n660|\t}\n661|\treturn out, nil\n662|}\n663|\n664|// convertPayloadValue converts one validated payload value:\n665|// numbers become exact int64, containers recurse, and every other\n666|// scalar crosses untouched.\n667|func convertPayloadValue(value any) (any, error) {\n668|\tswitch typed := value.(type) {\n669|\tcase json.Number:\n670|\t\tinteger, err := strconv.ParseInt(typed.String(), 10, 64)\n671|\t\tif err != nil {\n672|\t\t\treturn nil, invalid(\"canonical event payload carries a number outside the AX safe-integer model\")\n673|\t\t}\n674|\t\treturn integer, nil\n675|\tcase map[string]any:\n676|\t\treturn convertPayloadNumbers(typed)\n677|\tcase []any:\n678|\t\tout := make([]any, len(typed))\n679|\t\tfor index, element := range typed {\n680|\t\t\tconverted, err := convertPayloadValue(element)\n681|\t\t\tif err != nil {\n682|\t\t\t\treturn nil, err\n683|\t\t\t}\n684|\t\t\tout[index] = converted\n685|\t\t}\n686|\t\treturn out, nil\n687|\tdefault:\n688|\t\treturn value, nil\n689|\t}\n690|}\n691|\n692|var contentBlockMembers = map[string]bool{\n693|\t\"type\": true, \"content\": true, \"blob_descriptor_id\": true, \"media_type\": true, \"extensions\": true,\n694|}\n695|\n696|// checkContentBlocks validates message-like content blocks: strict\n697|// objects with a vocabulary type, inline content of at most 64 KiB,\n698|// and digest-grammar Blob Descriptor references. The pinned text\n699|// gives each block \"typed inline content or Blob Descriptor\n700|// references\": exactly one of the two members must be present and\n701|// non-null, so a block with neither (including a null where the\n702|// member belongs) and a block with both are refused.\n703|func checkContentBlocks(raw json.RawMessage) error {\n704|\telements, ok := decodeArray(raw)\n705|\tif !ok {\n706|\t\treturn invalid(\"canonical event content_blocks are not an array\")\n707|\t}\n708|\tfor index, element := range elements {\n709|\t\tmembers, fault := decodeStrictObject(bytesTrimSpace(element))\n710|\t\tif fault != nil {\n711|\t\t\treturn invalid(\"canonical event content block[%d] %s (%s)\", index, fault.detail, memberField(fault.member))\n712|\t\t}\n713|\t\tif name, unknown := unknownMember(members, contentBlockMembers); unknown {\n714|\t\t\treturn invalid(\"canonical event content block[%d] carries unknown member %q\", index, name)\n715|\t\t}\n716|\t\tblockTypeValue, present := members[\"type\"]\n717|\t\tif !present {\n718|\t\t\treturn invalid(\"canonical event content block[%d] misses its type\", index)\n719|\t\t}\n720|\t\tblockType, ok := rawString(blockTypeValue)\n721|\t\tif !ok || !validContentBlockType(blockType) {\n722|\t\t\treturn invalid(\"canonical event content block[%d] type is outside the eight-type vocabulary\", index)\n723|\t\t}\n724|\t\t_, hasContentMember := members[\"content\"]\n725|\t\t_, hasDescriptorMember := members[\"blob_descriptor_id\"]\n726|\t\thasContent := hasContentMember && !isNull(members[\"content\"])\n727|\t\thasDescriptor := hasDescriptorMember && !isNull(members[\"blob_descriptor_id\"])\n728|\t\tif hasContent == hasDescriptor {\n729|\t\t\treturn invalid(\"canonical event content block[%d] carries content and descriptor members that are not exclusive\", index)\n730|\t\t}\n731|\t\tif content, present := members[\"content\"]; present {\n732|\t\t\ttext, ok := rawString(content)\n733|\t\t\tif !ok {\n734|\t\t\t\treturn invalid(\"canonical event content block[%d] content is not a string\", index)\n735|\t\t\t}\n736|\t\t\tif len(text) > maxInlineContent {\n737|\t\t\t\treturn invalid(\"canonical event content block[%d] inline content exceeds 64 KiB\", index)\n738|\t\t\t}\n739|\t\t}\n740|\t\tif descriptor, present := members[\"blob_descriptor_id\"]; present {\n741|\t\t\tif _, ok := checkDigest(descriptor); !ok {\n742|\t\t\t\treturn invalid(\"canonical event content block[%d] blob_descriptor_id is not a digest\", index)\n743|\t\t\t}\n744|\t\t}\n745|\t\tif mediaType, present := members[\"media_type\"]; present {\n746|\t\t\tif _, ok := checkStringBounds(mediaType, 1, 255); !ok {\n747|\t\t\t\treturn invalid(\"canonical event content block[%d] media_type is not a string[1..255]\", index)\n748|\t\t\t}\n749|\t\t}\n750|\t\tif extensions, present := members[\"extensions\"]; present {\n751|\t\t\tif extensionsFault := checkExtensionsClosed(extensions); extensionsFault != nil {\n752|\t\t\t\treturn invalid(\"canonical event content block[%d] extensions %s\", index, extensionsFault)\n753|\t\t\t}\n754|\t\t}\n755|\t}\n756|\treturn nil\n757|}\n758|\n759|func buildSourceEvidence(input EvidenceInput) (map[string]any, error) {\n760|\ttuple, err := sessadapter.DecodeTuple(json.RawMessage(input.Environment))\n761|\tif err != nil {\n762|\t\treturn nil, invalid(\"source evidence environment is not an Environment Tuple: %v\", err)\n763|\t}\n764|\tif stringLength(input.NativeSessionID) < 1 || stringLength(input.NativeSessionID) > 512 {\n765|\t\treturn nil, invalid(\"source evidence native_session_id is not a string[1..512]\")\n766|\t}\n767|\tif err := SanitizeNativeKey(input.NativeSessionID); err != nil {\n768|\t\treturn nil, err\n769|\t}\n770|\tvar nativeEvent any\n771|\thasNativeEvent := false\n772|\tif input.NativeEventID != nil {\n773|\t\tif stringLength(*input.NativeEventID) < 1 || stringLength(*input.NativeEventID) > 512 {\n774|\t\t\treturn nil, invalid(\"source evidence native_event_id is not a string[1..512]\")\n775|\t\t}\n776|\t\tif err := SanitizeNativeKey(*input.NativeEventID); err != nil {\n777|\t\t\treturn nil, err\n778|\t\t}\n779|\t\tnativeEvent = *input.NativeEventID\n780|\t\thasNativeEvent = true\n781|\t}\n782|\tvar nativeType any\n783|\tif input.NativeType != nil {\n784|\t\tif !validText(*input.NativeType) {\n785|\t\t\treturn nil, invalid(\"source evidence native_type is not valid UTF-8\")\n786|\t\t}\n787|\t\tif stringLength(*input.NativeType) < 1 || stringLength(*input.NativeType) > 512 {\n788|\t\t\treturn nil, invalid(\"source evidence native_type is not a string[1..512]\")\n789|\t\t}\n790|\t\tnativeType = *input.NativeType\n791|\t}\n792|\tif len(input.RawRefs) > 65536 {\n793|\t\treturn nil, invalid(\"source evidence carries %d raw_refs, maximum is 65536\", len(input.RawRefs))\n794|\t}\n795|\treferences := make([]RawReference, 0, len(input.RawRefs))\n796|\tvar previous []byte\n797|\tfor index, candidate := range input.RawRefs {\n798|\t\tmanifestID, err := scalar.ParseDigest(candidate.ManifestID)\n799|\t\tif err != nil {\n800|\t\t\treturn nil, invalid(\"raw reference[%d] manifest_id is not a digest: %v\", index, err)\n801|\t\t}\n802|\t\tdescriptorID, err := scalar.ParseDigest(candidate.BlobDescriptorID)\n803|\t\tif err != nil {\n804|\t\t\treturn nil, invalid(\"raw reference[%d] blob_descriptor_id is not a digest: %v\", index, err)\n805|\t\t}\n806|\t\tif candidate.Offset > maxUint53 {\n807|\t\t\treturn nil, invalid(\"raw reference[%d] offset exceeds uint53\", index)\n808|\t\t}\n809|\t\tif candidate.Length > maxUint53 {\n810|\t\t\treturn nil, invalid(\"raw reference[%d] length exceeds uint53\", index)\n811|\t\t}\n812|\t\treference := RawReference{\n813|\t\t\tManifestID:       manifestID,\n814|\t\t\tBlobDescriptorID: descriptorID,\n815|\t\t\tOffset:           candidate.Offset,\n816|\t\t\tLength:           candidate.Length,\n817|\t\t}\n818|\t\tkey, err := canonicalizeObject(rawReferenceObject(reference))\n819|\t\tif err != nil {\n820|\t\t\treturn nil, err\n821|\t\t}\n822|\t\tif index > 0 && bytes.Compare(key, previous) <= 0 {\n823|\t\t\treturn nil, invalid(\"source evidence raw_refs are not sorted unique\")\n824|\t\t}\n825|\t\tprevious = key\n826|\t\treferences = append(references, reference)\n827|\t}\n828|\tif !validCaptureStatus(input.CaptureStatus) {\n829|\t\treturn nil, invalid(\"source evidence capture_status is outside exact|partial|synthesized|unavailable\")\n830|\t}\n831|\tpreviousReason := \"\"\n832|\tfor index, reason := range input.ReasonCodes {\n833|\t\tif !validText(reason) {\n834|\t\t\treturn nil, invalid(\"source evidence reason_codes[%d] is not valid UTF-8\", index)\n835|\t\t}\n836|\t\tif stringLength(reason) < 1 || stringLength(reason) > 128 {\n837|\t\t\treturn nil, invalid(\"source evidence reason_codes[%d] is not a string[1..128]\", index)\n838|\t\t}\n839|\t\tif index > 0 && reason <= previousReason {\n840|\t\t\treturn nil, invalid(\"source evidence reason_codes are not sorted unique\")\n841|\t\t}\n842|\t\tpreviousReason = reason\n843|\t}\n844|\tif len(input.ReasonCodes) > 128 {\n845|\t\treturn nil, invalid(\"source evidence carries %d reason_codes, maximum is 128\", len(input.ReasonCodes))\n846|\t}\n847|\tvar operation any\n848|\thasOperation := false\n849|\tif input.CoreOperationID != nil {\n850|\t\tvalue, err := scalar.ParseUUIDv7(*input.CoreOperationID)\n851|\t\tif err != nil {\n852|\t\t\treturn nil, invalid(\"source evidence core_operation_id is not a UUIDv7: %v\", err)\n853|\t\t}\n854|\t\toperation = value.String()\n855|\t\thasOperation = true\n856|\t}\n857|\tif err := checkEvidenceCoupling(input.CaptureStatus, hasNativeEvent, hasOperation); err != nil {\n858|\t\treturn nil, err\n859|\t}\n860|\tobjects := make([]any, 0, len(references))\n861|\tfor _, reference := range references {\n862|\t\tobjects = append(objects, rawReferenceObject(reference))\n863|\t}\n864|\treasons := make([]any, 0, len(input.ReasonCodes))\n865|\tfor _, reason := range input.ReasonCodes {\n866|\t\treasons = append(reasons, reason)\n867|\t}\n868|\treturn map[string]any{\n869|\t\t\"environment\":       tupleObject(tuple),\n870|\t\t\"native_session_id\": input.NativeSessionID,\n871|\t\t\"native_event_id\":   nativeEvent,\n872|\t\t\"native_type\":       nativeType,\n873|\t\t\"raw_refs\":          objects,\n874|\t\t\"capture_status\":    input.CaptureStatus,\n875|\t\t\"reason_codes\":      reasons,\n876|\t\t\"core_operation_id\": operation,\n877|\t\t\"extensions\":        map[string]any{},\n878|\t}, nil\n879|}\n880|\n881|// CheckOrdinalContiguity verifies the event-set ordinal rule:\n882|// ordinals are zero-based and contiguous, so the set must be\n883|// exactly {0..n-1}.\n884|func CheckOrdinalContiguity(ordinals []uint64) error {\n885|\tseen := make(map[uint64]bool, len(ordinals))\n886|\tfor _, ordinal := range ordinals {\n887|\t\tif ordinal >= uint64(len(ordinals)) {\n888|\t\t\treturn invalid(\"event ordinals are not contiguous from zero: ordinal %d outside [0..%d]\", ordinal, len(ordinals)-1)\n889|\t\t}\n890|\t\tif seen[ordinal] {\n891|\t\t\treturn invalid(\"event ordinals are not contiguous from zero: duplicate ordinal %d\", ordinal)\n892|\t\t}\n893|\t\tseen[ordinal] = true\n894|\t}\n895|\treturn nil\n896|}","final_result":true}}}
