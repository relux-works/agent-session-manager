ringMeasure(t *testing.T) {\\ninternal/clonebundle/refusal_test.go:319:func TestCaptureItemRefusals(t *testing.T) {\\ninternal/clonebundle/refusal_test.go:377:func TestCaptureManifestRefusals(t *testing.T) {\\ninternal/clonebundle/refusal_test.go:593:func TestBoundaryRefusals(t *testing.T) {\\ninternal/clonebundle/refusal_test.go:690:func TestSourceBasisRefusals(t *testing.T) {\\n===\\ninternal/clonebundle/capturebuild.go:118:\\tidentityBytes, err := EncodeNativeIdentity(input.SourceIdentity, input.IdentityExtensions)\\ninternal/clonebundle/contract_test.go:16:\\tidentityDigest, err := IdentityDigest(identity, nil)\\ninternal/clonebundle/contract_test.go:18:\\t\\tt.Fatalf(\\\"IdentityDigest() error = %v\\\", err)\\ninternal/clonebundle/contract_test.go:220:func TestIdentityDigestIsStable(t *testing.T) {\\ninternal/clonebundle/contract_test.go:222:\\tfirst, err := IdentityDigest(identity, nil)\\ninternal/clonebundle/contract_test.go:224:\\t\\tt.Fatalf(\\\"IdentityDigest() error = %v\\\", err)\\ninternal/clonebundle/contract_test.go:226:\\tsecond, err := IdentityDigest(identity, nil)\\ninternal/clonebundle/contract_test.go:228:\\t\\tt.Fatalf(\\\"IdentityDigest() error = %v\\\", err)\\ninternal/clonebundle/contract_test.go:231:\\t\\tt.Fatal(\\\"IdentityDigest identical inputs produced different digests\\\")\\ninternal/clonebundle/contract_test.go:235:\\tthird, err := IdentityDigest(other, nil)\\ninternal/clonebundle/contract_test.go:237:\\t\\tt.Fatalf(\\\"IdentityDigest() error = %v\\\", err)\\ninternal/clonebundle/contract_test.go:240:\\t\\tt.Fatal(\\\"IdentityDigest did not change with the native session ID\\\")\\ninternal/clonebundle/contract_test.go:350:\\tencoded, err := EncodeNativeIdentity(identity, nil)\\ninternal/clonebundle/contract_test.go:352:\\t\\tt.Fatalf(\\\"EncodeNativeIdentity() error = %v\\\", err)\\ninternal/clonebundle/exclusion_test.go:45:\\tidentityDigest, err := IdentityDigest(identity, nil)\\ninternal/clonebundle/extension_sites_test.go:60:\\t\\