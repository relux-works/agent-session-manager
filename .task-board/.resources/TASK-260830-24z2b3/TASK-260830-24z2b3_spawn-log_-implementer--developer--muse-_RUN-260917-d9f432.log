a []byte) (map[string]json.RawMessage, *frameFault) {\n35|\tmembers, fault := environ.DecodeStrictObject(data)\n36|\tif fault != nil {\n37|\t\treturn nil, &frameFault{detail: fault.Detail, member: fault.Member}\n38|\t}\n39|\treturn members, nil\n40|}\n41|\n42|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n43|\tfor name := range members {\n44|\t\tif !allowed[name] {\n45|\t\t\treturn name, true\n46|\t\t}\n47|\t}\n48|\treturn \"\", false\n49|}\n50|\n51|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n52|\tfor _, name := range required {\n53|\t\tif _, present := members[name]; !present {\n54|\t\t\treturn name, true\n55|\t\t}\n56|\t}\n57|\treturn \"\", false\n58|}\n59|\n60|func rawString(raw json.RawMessage) (string, bool) {\n61|\tvar value string\n62|\tif err := json.Unmarshal(raw, &value); err != nil {\n63|\t\treturn \"\", false\n64|\t}\n65|\treturn value, true\n66|}\n67|\n68|func rawBool(raw json.RawMessage) (bool, bool) {\n69|\tvar value bool\n70|\tif err := json.Unmarshal(raw, &value); err != nil {\n71|\t\treturn false, false\n72|\t}\n73|\treturn value, true\n74|}\n75|\n76|// checkUint53Bounds reports whether the member is a uint53 in the\n77|// inclusive bound. Both edges are checked: a one-sided check would\n78|// admit the open side. It delegates to the environ gate.\n79|func checkUint53Bounds(raw json.RawMessage, minimum, maximum uint64) (uint64, bool) {\n80|\treturn environ.CheckUint53Bounds(raw, minimum, maximum)\n81|}\n82|\n83|// stringLength is the Section 1.6 string measure in characters, not\n84|// bytes: a bound of string[1..512] admits 512 characters of any\n85|// width. It delegates to the single environ measure so the two can\n86|// never drift.\n87|func stringLength(value string) int {\n88|\treturn environ.StringLength(value)\n89|}\n90|\n91|// checkStringBounds reports whether the member is a JSON string whose\n92|// character count falls in the inclusive bound. It delegates to the\n93|// environ gate.\n94|func checkStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n95|\treturn environ.CheckStringBounds(raw, minimum, maximum)\n96|}\n97|\n98|// checkDigest reports whether the member is a digest of the pinned\n99|// sha256 form. It delegates to the environ gate.\n100|func checkDigest(raw json.RawMessage) (scalar.Digest, bool) {\n101|\treturn environ.CheckDigest(raw)\n102|}\n103|\n104|// checkUUIDv7 reports whether the member is a lowercase UUIDv7. It\n105|// delegates to the environ gate.\n106|func checkUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n107|\treturn environ.CheckUUIDv7(raw)\n108|}\n109|\n110|// checkTimestamp reports whether the member is a pinned timestamp.\n111|// It delegates to the environ gate.\n112|func checkTimestamp(raw json.RawMessage) (scalar.Timestamp, bool) {\n113|\treturn environ.CheckTimestamp(raw)\n114|}\n115|\n116|func bytesTrimSpace(raw json.RawMessage) json.RawMessage {\n117|\treturn json.RawMessage(bytes.TrimSpace(raw))\n118|}\n119|\n120|func isNull(raw json.RawMessage) bool {\n121|\ttrimmed := bytes.TrimSpace(raw)\n122|\treturn string(trimmed) == \"null\"\n123|}\n124|\n125|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n126|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n127|\ttoken, err := decoder.Token()\n128|\tif err != nil {\n129|\t\treturn nil, false\n130|\t}\n131|\tdelimiter, ok := token.(json.Delim)\n132|\tif !ok || delimiter != '[' {\n133|\t\treturn nil, false\n134|\t}\n135|\tvar elements []json.RawMessage\n136|\tfor decoder.More() {\n137|\t\tvar element json.RawMessage\n138|\t\tif err := decoder.Decode(&element); err != nil {\n139|\t\t\treturn nil, false\n140|\t\t}\n141|\t\telements = append(elements, element)\n142|\t}\n143|\ttoken, err = decoder.Token()\n144|\tif err != nil {\n145|\t\treturn nil, false\n146|\t}\n147|\tdelimiter, ok = token.(json.Delim)\n148|\tif !ok || delimiter != ']' {\n149|\t\treturn nil, false\n150|\t}\n151|\tif _, err := decoder.Token(); err != io.EOF {\n152|\t\treturn nil, false\n153|\t}\n154|\tif elements == nil {\n155|\t\telements = []json.RawMessage{}\n156|\t}\n157|\treturn elements, true\n158|}\n159|\n160|// checkSortedUniqueStrings reports whether the member is an array of\n161|// strings in the item bound whose JCS encodings order strictly\n162|// increasingly with no duplicates. It delegates to the environ gate.\n163|func checkSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n164|\treturn environ.CheckSortedUniqueStrings(raw, minimumLength, maximumLength, minimumCount, maximumCount)\n165|}\n166|\n167|// checkSortedUniqueDigests reports whether the member is a sorted\n168|// unique digest array in the count bound. It delegates to the\n169|// environ gate.\n170|func checkSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\n171|\treturn environ.CheckSortedUniqueDigests(raw, minimumCount, maximumCount)\n172|}\n173|\n174|// checkExtensions reports whether the member is an object whose keys\n175|// are all reverse-DNS names. It delegates to the environ gate. Key\n176|// admission alone is not the closed extensions rule for this\n177|// package: extension values flow into the omit-self identity, so\n178|// every admission site uses checkExtensionsClosed, which additionally\n179|// enforces the AX number model and nested duplicate refusal on the\n180|// values.\n181|func checkExtensions(raw json.RawMessage) bool {\n182|\treturn environ.CheckExtensions(raw)\n183|}\n184|\n185|// maxExtensionDepth mirrors the canonicaljson nesting bound: a\n186|// container nested deeper than this inside an extension value is\n187|// refused, exactly as the identity owner refuses it.\n188|const maxExtensionDepth = 256\n189|\n190|// checkExtensionsClosed enforces the full closed extensions rule:\n191|// reverse-DNS keys (via the environ owner) and values inside the AX\n192|// common logical data model (integer literals only, |n| <= 2^53-1,\n193|// no fraction or exponent, nested objects duplicate-free at every\n194|// depth). It returns nil when the member is closed, otherwise the\n195|// refusal detail naming the failed rule.\n196|func checkExtensionsClosed(raw json.RawMessage) error {\n197|\tif !checkExtensions(raw) {\n198|\t\treturn errExtensionsKeys\n199|\t}\n200|\treturn checkExtensionValues(raw)\n201|}\n202|\n203|var (\n204|\terrExtensionsKeys     = errorString(\"are not reverse-DNS keyed\")\n205|\terrExtensionNumber    = errorString(\"carry a number outside the AX safe-integer model\")\n206|\terrExtensionDuplicate = errorString(\"carry a duplicate nested member\")\n207|\terrExtensionShape     = errorString(\"are not a depth-bounded extension object\")\n208|\terrPayloadShape       = errorString(\"are not a depth-bounded payload object\")\n209|)\n210|\n211|// errorString is one fixed refusal detail. Extension faults name the\n212|// failed rule; the deciding site names the owner.\n213|type errorString string\n214|\n215|func (detail errorString) Error() string { return string(detail) }\n216|\n217|// checkExtensionValues validates every value under the extensions\n218|// object against the AX number model with nested objects\n219|// duplicate-free. It mirrors the canonicaljson identity guarantee\n220|// (safe integers, no rounding, strict objects) which Canonicalize\n221|// alone does not carry, so no value that would round or collapse\n222|// under canonicalization is ever admitted into an omit-self\n223|// identity.\n224|func checkExtensionValues(raw json.RawMessage) error {\n225|\tdecoder := json.NewDecoder(bytes.NewReader(bytesTrimSpace(raw)))\n226|\tdecoder.UseNumber()\n227|\ttoken, err := decoder.Token()\n228|\tif err != nil {\n229|\t\treturn errExtensionShape\n230|\t}\n231|\tdelimiter, ok := token.(json.Delim)\n232|\tif !ok || delimiter != '{' {\n233|\t\treturn errExtensionShape\n234|\t}\n235|\tif err := checkExtensionMembers(decoder, 0); err != nil {\n236|\t\treturn err\n237|\t}\n238|\tif _, err := decoder.Token(); err != io.EOF {\n239|\t\treturn errExtensionShape\n240|\t}\n241|\treturn nil\n242|}\n243|\n244|// checkExtensionMembers validates the members of one open extension\n245|// object: names are duplicate-free and every value validates.\n246|func checkExtensionMembers(decoder *json.Decoder, depth int) error {\n247|\tif depth >= maxExtensionDepth {\n248|\t\treturn errExtensionShape\n249|\t}\n250|\tseen := map[string]bool{}\n251|\tfor decoder.More() {\n252|\t\tnameToken, err := decoder.Token()\n253|\t\tif err != nil {\n254|\t\t\treturn errExtensionShape\n255|\t\t}\n256|\t\tname, ok := nameToken.(string)\n257|\t\tif !ok {\n258|\t\t\treturn errExtensionShape\n259|\t\t}\n260|\t\tif seen[name] {\n261|\t\t\treturn errExtensionDuplicate\n262|\t\t}\n263|\t\tseen[name] = true\n264|\t\tif err := checkExtensionValue(decoder, depth+1); err != nil {\n265|\t\t\treturn err\n266|\t\t}\n267|\t}\n268|\tend, err := decoder.Token()\n269|\tif err != nil || end != json.Delim('}') {\n270|\t\treturn errExtensionShape\n271|\t}\n272|\treturn nil\n273|}\n274|\n275|// checkExtensionValue validates one extension value: containers\n276|// recurse (objects duplicate-free at every depth, arrays in order),\n277|// numbers obey the AX literal rule, and strings, booleans, and null\n278|// cross opaquely.\n279|func checkExtensionValue(decoder *json.Decoder, depth int) error {\n280|\ttoken, err := decoder.Token()\n281|\tif err != nil {\n282|\t\treturn errExtensionShape\n283|\t}\n284|\tswitch typed := token.(type) {\n285|\tcase json.Delim:\n286|\t\tswitch typed {\n287|\t\tcase '{':\n288|\t\t\treturn checkExtensionMembers(decoder, depth)\n289|\t\tcase '[':\n290|\t\t\tif depth >= maxExtensionDepth {\n291|\t\t\t\treturn errExtensionShape\n292|\t\t\t}\n293|\t\t\tfor decoder.More() {\n294|\t\t\t\tif err := checkExtensionValue(decoder, depth+1); err != nil {\n295|\t\t\t\t\treturn err\n296|\t\t\t\t}\n297|\t\t\t}\n298|\t\t\tend, err := decoder.Token()\n299|\t\t\tif err != nil || end != json.Delim(']') {\n300|\t\t\t\treturn errExtensionShape\n301|\t\t\t}\n302|\t\t\treturn nil\n303|\t\tdefault:\n304|\t\t\treturn errExtensionShape\n305|\t\t}\n306|\tcase json.Number:\n307|\t\tif !checkAXNumberLiteral(typed.String()) {\n308|\t\t\treturn errExtensionNumber\n309|\t\t}\n310|\t\treturn nil\n311|\tcase string, bool, nil:\n312|\t\treturn nil\n313|\tdefault:\n314|\t\treturn errExtensionShape\n315|\t}\n316|}\n317|\n318|// checkAXNumberLiteral mirrors the canonicaljson safe-integer rule:\n319|// a literal with a fraction or exponent is forbidden, and the\n320|// integer value must fall in [-2^53+1, 2^53-1]. The bound is checked\n321|// on the literal before any host conversion, so a value the host\n322|// would round is refused instead.\n323|func checkAXNumberLiteral(literal string) bool {\n324|\tif strings.ContainsAny(literal, \".eE\") {\n325|\t\treturn false\n326|\t}\n327|\tinteger, err := strconv.ParseInt(literal, 10, 64)\n328|\tif err != nil || integer < -maxSafeInteger || integer > maxSafeInteger {\n329|\t\treturn false\n330|\t}\n331|\treturn true\n332|}\n333|\n334|// canonicalizeObject renders one closed object deterministically: the\n335|// members marshal in any order and the JCS transform sorts them, so\n336|// identical logical inputs always produce identical bytes.\n337|func canonicalizeObject(object map[string]any) ([]byte, error) {\n338|\tplain, err := json.Marshal(object)\n339|\tif err != nil {\n340|\t\treturn nil, invalid(\"serialize clone bundle object: %v\", err)\n341|\t}\n342|\tcanonical, err := canonicaljson.Canonicalize(plain)\n343|\tif err != nil {\n344|\t\treturn nil, invalid(\"canonicalize clone bundle object: %v\", err)\n345|\t}\n346|\treturn canonical, nil\n347|}\n348|\n349|// omitSelfDigest computes the JCS SHA-256 identity of members with\n350|// only the self field omitted. It mirrors the canonicaljson\n351|// omit-self construction without routing through that package's\n352|// closed-shape registry, which refuses these schemas by design (see\n353|// doc.go).\n354|func omitSelfDigest(members map[string]json.RawMessage, selfField string) (scalar.Digest, error) {\n355|\tomitted := make(map[string]any, len(members))\n356|\tfor name, raw := range members {\n357|\t\tif name == selfField {\n358|\t\t\tcontinue\n359|\t\t}\n360|\t\tvar value any\n361|\t\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n362|\t\tdecoder.UseNumber()\n363|\t\tif err := decoder.Decode(&value); err != nil {\n364|\t\t\treturn scalar.Digest{}, invalid(\"identity input member %s is not JSON: %v\", name, err)\n365|\t\t}\n366|\t\tomitted[name] = value\n367|\t}\n368|\tplain, err := json.Marshal(omitted)\n369|\tif err != nil {\n370|\t\treturn scalar.Digest{}, invalid(\"serialize omit-self object: %v\", err)\n371|\t}\n372|\tcanonical, err := canonicaljson.Canonicalize(plain)\n373|\tif err != nil {\n374|\t\treturn scalar.Digest{}, invalid(\"canonicalize omit-self object: %v\", err)\n375|\t}\n376|\treturn scalar.SHA256Digest(canonical), nil\n377|}\n378|\n379|// verifySelfDigest recomputes the omit-self identity and refuses a\n380|// mismatch against the claimed self digest.\n381|func verifySelfDigest(members map[string]json.RawMessage, selfField string, claimed scalar.Digest) error {\n382|\tcalculated, err := omitSelfDigest(members, selfField)\n383|\tif err != nil {\n384|\t\treturn err\n385|\t}\n386|\tif calculated != claimed {\n387|\t\treturn invalid(\"%s claim %q does not match omit-self digest %q\", selfField, claimed.String(), calculated.String())\n388|\t}\n389|\treturn nil\n390|}","final_result":true}}}
