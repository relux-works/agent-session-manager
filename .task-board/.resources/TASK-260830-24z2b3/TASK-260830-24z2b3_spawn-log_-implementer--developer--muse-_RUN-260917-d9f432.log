{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6f7","stream":{"kind":"session","id":"01a0b1a1-0fcd-7b72-b1bb-a101f0623221"},"sequence":470,"recorded_at":1780531400000935,"record_type":"event","durability":"durable","causation_id":"96b9aaba-3389-40b6-a064-cffa078aa95e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"96b9aaba-3389-40b6-a064-cffa078aa95e","run_stream":{"kind":"run","id":"96b9aaba-3389-40b6-a064-cffa078aa95e"},"task_stream":{"kind":"task","id":"01a0b1a2-1a0e-70d1-887a-65742ce6051d"},"task_id":"01a0b1a2-1a0e-70d1-887a-65742ce6051d","event":{"kind":"output","task_id":"01a0b1a2-1a0e-70d1-887a-65742ce6051d","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/clonebundle/session.go`.\n(499 line(s) above)\n500|\tif mainCount != 1 {\n501|\t\treturn nil, invalid(\"canonical session carries %d main actors, want exactly one\", mainCount)\n502|\t}\n503|\treturn actors, nil\n504|}\n505|\n506|// decodeOrderedUniqueDigests validates ordered unique digests: order\n507|// is the caller's (event order), uniqueness is exact.\n508|func decodeOrderedUniqueDigests(raw json.RawMessage, minimum, maximum int, name string) ([]scalar.Digest, error) {\n509|\telements, ok := decodeArray(raw)\n510|\tif !ok {\n511|\t\treturn nil, invalid(\"canonical session %s are not an array\", name)\n512|\t}\n513|\tif len(elements) < minimum || len(elements) > maximum {\n514|\t\treturn nil, invalid(\"canonical session %s carry %d IDs, want [%d..%d]\", name, len(elements), minimum, maximum)\n515|\t}\n516|\tids := make([]scalar.Digest, 0, len(elements))\n517|\tseen := map[string]bool{}\n518|\tfor index, element := range elements {\n519|\t\tid, ok := checkDigest(element)\n520|\t\tif !ok {\n521|\t\t\treturn nil, invalid(\"canonical session %s[%d] is not a digest\", name, index)\n522|\t\t}\n523|\t\tif seen[id.String()] {\n524|\t\t\treturn nil, invalid(\"canonical session %s are not unique\", name)\n525|\t\t}\n526|\t\tseen[id.String()] = true\n527|\t\tids = append(ids, id)\n528|\t}\n529|\treturn ids, nil\n530|}\n531|\n532|func parseOrderedUniqueDigests(values []string, minimum, maximum int, name string) ([]scalar.Digest, error) {\n533|\tif len(values) < minimum || len(values) > maximum {\n534|\t\treturn nil, invalid(\"canonical session %s carry %d IDs, want [%d..%d]\", name, len(values), minimum, maximum)\n535|\t}\n536|\tids := make([]scalar.Digest, 0, len(values))\n537|\tseen := map[string]bool{}\n538|\tfor index, value := range values {\n539|\t\tid, err := scalar.ParseDigest(value)\n540|\t\tif err != nil {\n541|\t\t\treturn nil, invalid(\"canonical session %s[%d] is not a digest: %v\", name, index, err)\n542|\t\t}\n543|\t\tif seen[id.String()] {\n544|\t\t\treturn nil, invalid(\"canonical session %s are not unique\", name)\n545|\t\t}\n546|\t\tseen[id.String()] = true\n547|\t\tids = append(ids, id)\n548|\t}\n549|\treturn ids, nil\n550|}\n551|\n552|func parseSortedUniqueDigestStrings(values []string, minimum, maximum int, name string) ([]scalar.Digest, error) {\n553|\tif len(values) < minimum || len(values) > maximum {\n554|\t\treturn nil, invalid(\"canonical session %s carry %d IDs, want [%d..%d]\", name, len(values), minimum, maximum)\n555|\t}\n556|\tids := make([]scalar.Digest, 0, len(values))\n557|\tprevious := \"\"\n558|\tfor index, value := range values {\n559|\t\tid, err := scalar.ParseDigest(value)\n560|\t\tif err != nil {\n561|\t\t\treturn nil, invalid(\"canonical session %s[%d] is not a digest: %v\", name, index, err)\n562|\t\t}\n563|\t\tif index > 0 && id.String() <= previous {\n564|\t\t\treturn nil, invalid(\"canonical session %s are not sorted unique\", name)\n565|\t\t}\n566|\t\tprevious = id.String()\n567|\t\tids = append(ids, id)\n568|\t}\n569|\treturn ids, nil\n570|}\n571|\n572|func parseNullableTimestamp(value *string, name string) (any, error) {\n573|\tif value == nil {\n574|\t\treturn nil, nil\n575|\t}\n576|\tstamp, err := scalar.ParseTimestamp(*value)\n577|\tif err != nil {\n578|\t\treturn nil, invalid(\"canonical session %s is not a timestamp: %v\", name, err)\n579|\t}\n580|\treturn stamp.String(), nil\n581|}\n582|\n583|func decodeNullableTimestamp(members map[string]json.RawMessage, name, owner string) (*scalar.Timestamp, error) {\n584|\traw, present := members[name]\n585|\tif !present {\n586|\t\treturn nil, invalid(\"%s misses a required member %q\", owner, name)\n587|\t}\n588|\tif isNull(raw) {\n589|\t\treturn nil, nil\n590|\t}\n591|\tstamp, ok := checkTimestamp(raw)\n592|\tif !ok {\n593|\t\treturn nil, invalid(\"%s %s is not a timestamp\", owner, name)\n594|\t}\n595|\treturn &stamp, nil\n596|}\n597|\n598|func digestStrings(ids []scalar.Digest) []any {\n599|\tvalues := make([]any, 0, len(ids))\n600|\tfor _, id := range ids {\n601|\t\tvalues = append(values, id.String())\n602|\t}\n603|\treturn values\n604|}","final_result":true}}}
