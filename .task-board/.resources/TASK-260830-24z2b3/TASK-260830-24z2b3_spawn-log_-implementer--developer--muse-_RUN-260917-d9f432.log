tout, err := json.Marshal(object)\n38|\tif err != nil {\n39|\t\tt.Fatal(err)\n40|\t}\n41|\treturn out\n42|}\n43|\n44|func requireRefusal(t *testing.T, err error, fragment string) {\n45|\tt.Helper()\n46|\tif !errors.Is(err, ErrInvalid) {\n47|\t\tt.Fatalf(\"error = %v, want ErrInvalid\", err)\n48|\t}\n49|\tif fragment != \"\" && !strings.Contains(err.Error(), fragment) {\n50|\t\tt.Fatalf(\"error = %v, want fragment %q\", err, fragment)\n51|\t}\n52|}\n53|\n54|func TestRawManifestRefusals(t *testing.T) {\n55|\tidentity := fixtureNativeIdentity()\n(more lines below)","final_result":true}}}
