{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6b9","stream":{"kind":"session","id":"01a0b1a1-0fcd-7b72-b1bb-a101f0623221"},"sequence":439,"recorded_at":1780531400000873,"record_type":"event","durability":"durable","causation_id":"96b9aaba-3389-40b6-a064-cffa078aa95e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"96b9aaba-3389-40b6-a064-cffa078aa95e","run_stream":{"kind":"run","id":"96b9aaba-3389-40b6-a064-cffa078aa95e"},"call_id":"call_01a0b1a1faba778c8b85447fe25b0283","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/clonebundle/captureitem.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n7|)\n8|\n9|// This file validates the CaptureItem, Capture Source Basis, and\n10|// Capture Boundary closed shapes of Clone Capture Manifest 1.0.0.\n11|// The manifest envelope itself lives in capturebuild.go.\n12|\n13|// captureClasses is the closed nine-class vocabulary Section 13.14.1\n14|// states for CaptureItem. It mirrors the sessadapter capture-plan\n15|// vocabulary over the same pinned section; membership here is the\n16|// manifest-side gate.\n17|var captureClasses = []string{\n18|\t\"durable_payload\",\n19|\t\"durable_index_required\",\n20|\t\"durable_sidecar\",\n21|\t\"derived_cache_optional\",\n22|\t\"credential\",\n23|\t\"machine_auth\",\n24|\t\"runtime_state\",\n25|\t\"transient_lock\",\n26|\t\"unknown\",\n27|}\n28|\n29|// ValidCaptureClass reports whether the name is a capture class.\n30|func ValidCaptureClass(name string) bool {\n31|\tfor _, class := range captureClasses {\n32|\t\tif class == name {\n33|\t\t\treturn true\n34|\t\t}\n35|\t}\n36|\treturn false\n37|}\n38|\n39|// alwaysExcludedClass reports whether the class is always excluded:\n40|// credential, auth, runtime, and lock classes are never included.\n41|func alwaysExcludedClass(class string) bool {\n42|\tswitch class {\n43|\tcase \"credential\", \"machine_auth\", \"runtime_state\", \"transient_lock\":\n44|\t\treturn true\n45|\tdefault:\n46|\t\treturn false\n47|\t}\n48|}\n49|\n50|var captureItemMembers = map[string]bool{\n51|\t\"native_item_key\":    true,\n52|\t\"class\":              true,\n53|\t\"disposition\":        true,\n54|\t\"blob_descriptor_id\": true,\n55|\t\"byte_count\":         true,\n56|\t\"exclusion_reason\":   true,\n57|\t\"extensions\":         true,\n58|}\n59|\n60|var captureItemRequired = []string{\n61|\t\"native_item_key\",\n62|\t\"class\",\n63|\t\"disposition\",\n64|\t\"blob_descriptor_id\",\n65|\t\"byte_count\",\n66|\t\"exclusion_reason\",\n67|\t\"extensions\",\n68|}\n69|\n70|// CaptureItem is one validated capture item.\n71|type CaptureItem struct {\n72|\tNativeItemKey    string\n73|\tClass            string\n74|\tDisposition      string\n75|\tBlobDescriptorID *scalar.Digest\n76|\tByteCount        *uint64\n77|\tExclusionReason  *string\n78|\tExtensions       map[string]any\n79|}\n80|\n81|// Included reports whether the item is an included row.\n82|func (item CaptureItem) Included() bool { return item.Disposition == \"included\" }\n83|\n84|// decodeCaptureItem validates one closed CaptureItem: the\n85|// included/excluded content rule, the always-excluded classes, and\n86|// the row-21 exclusion allowlist on the native key.\n87|func decodeCaptureItem(raw json.RawMessage, index int) (CaptureItem, error) {\n88|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n89|\tif fault != nil {\n90|\t\treturn CaptureItem{}, invalid(\"capture item[%d] %s (%s)\", index, fault.detail, memberField(fault.member))\n91|\t}\n92|\tif name, unknown := unknownMember(members, captureItemMembers); unknown {\n93|\t\treturn CaptureItem{}, invalid(\"capture item[%d] carries unknown member %q\", index, name)\n94|\t}\n95|\tif name, missing := missingMember(members, captureItemRequired); missing {\n96|\t\treturn CaptureItem{}, invalid(\"capture item[%d] misses a required member %q\", index, name)\n97|\t}\n98|\tkey, ok := checkStringBounds(members[\"native_item_key\"], 1, 512)\n99|\tif !ok {\n100|\t\treturn CaptureItem{}, invalid(\"capture item[%d] native_item_key is not a string[1..512]\", index)\n101|\t}\n102|\tif err := SanitizeNativeKey(key); err != nil {\n103|\t\treturn CaptureItem{}, err\n104|\t}\n105|\tif err := refuseExcludedMember(\"capture item\", key, index); err != nil {\n106|\t\treturn CaptureItem{}, err\n107|\t}\n108|\tclass, ok := rawString(members[\"class\"])\n109|\tif !ok || !ValidCaptureClass(class) {\n110|\t\treturn CaptureItem{}, invalid(\"capture item[%d] class %q is outside the nine-class vocabulary\", index, class)\n111|\t}\n112|\tdisposition, ok := rawString(members[\"disposition\"])\n113|\tif !ok || (disposition != \"included\" && disposition != \"excluded\") {\n114|\t\treturn CaptureItem{}, invalid(\"capture item[%d] disposition is outside included|excluded\", index)\n115|\t}\n116|\tvar descriptor *scalar.Digest\n117|\tif !isNull(members[\"blob_descriptor_id\"]) {\n118|\t\tvalue, ok := checkDigest(members[\"blob_descriptor_id\"])\n119|\t\tif !ok {\n120|\t\t\treturn CaptureItem{}, invalid(\"capture item[%d] blob_descriptor_id is not a digest\", index)\n121|\t\t}\n122|\t\tdescriptor = &value\n123|\t}\n124|\tvar count *uint64\n125|\tif !isNull(members[\"byte_count\"]) {\n126|\t\tvalue, ok := checkUint53Bounds(members[\"byte_count\"], 0, maxUint53)\n127|\t\tif !ok {\n128|\t\t\treturn CaptureItem{}, invalid(\"capture item[%d] byte_count is not a uint53\", index)\n129|\t\t}\n130|\t\tcount = &value\n131|\t}\n132|\tvar reason *string\n133|\tif !isNull(members[\"exclusion_reason\"]) {\n134|\t\tvalue, ok := checkStringBounds(members[\"exclusion_reason\"], 1, 128)\n135|\t\tif !ok {\n136|\t\t\treturn CaptureItem{}, invalid(\"capture item[%d] exclusion_reason is not a string[1..128]\", index)\n137|\t\t}\n138|\t\treason = &value\n139|\t}\n140|\tif err := checkItemDisposition(index, class, disposition, descriptor != nil, count != nil, reason != nil); err != nil {\n141|\t\treturn CaptureItem{}, err\n142|\t}\n143|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n144|\t\treturn CaptureItem{}, invalid(\"capture item[%d] extensions %s\", index, extensionsFault)\n145|\t}\n146|\tvar decodedExtensions map[string]any\n147|\tif err := json.Unmarshal(bytesTrimSpace(members[\"extensions\"]), &decodedExtensions); err != nil {\n148|\t\treturn CaptureItem{}, invalid(\"capture item[%d] extensions are not an object\", index)\n149|\t}\n150|\tif decodedExtensions == nil {\n151|\t\tdecodedExtensions = map[string]any{}\n152|\t}\n153|\treturn CaptureItem{\n154|\t\tNativeItemKey:    key,\n155|\t\tClass:            class,\n156|\t\tDisposition:      disposition,\n157|\t\tBlobDescriptorID: descriptor,\n158|\t\tByteCount:        count,\n159|\t\tExclusionReason:  reason,\n160|\t\tExtensions:       decodedExtensions,\n161|\t}, nil\n162|}\n163|\n164|// checkItemDisposition enforces the included/excluded rule: included\n165|// requires both content members non-null and a null reason; excluded\n166|// requires null content members and a non-null reason; the four\n167|// always-excluded classes are never included.\n168|func checkItemDisposition(index int, class, disposition string, hasDescriptor, hasCount, hasReason bool) error {\n169|\tif disposition == \"included\" {\n170|\t\tif alwaysExcludedClass(class) {\n171|\t\t\treturn invalid(\"capture item[%d] class %q is always excluded, never included\", index, class)\n172|\t\t}\n173|\t\tif !hasDescriptor || !hasCount {\n174|\t\t\treturn invalid(\"capture item[%d] included requires non-null descriptor and byte count\", index)\n175|\t\t}\n176|\t\tif hasReason {\n177|\t\t\treturn invalid(\"capture item[%d] included carries an exclusion reason\", index)\n178|\t\t}\n179|\t\treturn nil\n180|\t}\n181|\tif hasDescriptor || hasCount {\n182|\t\treturn invalid(\"capture item[%d] excluded carries content members\", index)\n183|\t}\n184|\tif !hasReason {\n185|\t\treturn invalid(\"capture item[%d] excluded requires a non-null exclusion reason\", index)\n186|\t}\n187|\treturn nil\n188|}\n189|\n190|// CaptureItemInput is one caller-supplied capture item candidate for\n191|// Build. Null members are nil pointers: BlobDescriptorID and\n192|// ByteCount for excluded rows, ExclusionReason for included rows.\n193|type CaptureItemInput struct {\n194|\tNativeItemKey    string\n195|\tClass            string\n196|\tDisposition      string\n197|\tBlobDescriptorID *string\n198|\tByteCount        *uint64\n199|\tExclusionReason  *string\n200|\tExtensions       map[string]any\n201|}\n202|\n203|func buildCaptureItem(input CaptureItemInput, index int) (CaptureItem, error) {\n204|\tif stringLength(input.NativeItemKey) < 1 || stringLength(input.NativeItemKey) > 512 {\n205|\t\treturn CaptureItem{}, invalid(\"capture item[%d] native_item_key is not a string[1..512]\", index)\n206|\t}\n207|\tif err := SanitizeNativeKey(input.NativeItemKey); err != nil {\n208|\t\treturn CaptureItem{}, err\n209|\t}\n210|\tif err := refuseExcludedMember(\"capture item\", input.NativeItemKey, index); err != nil {\n211|\t\treturn CaptureItem{}, err\n212|\t}\n213|\tif !ValidCaptureClass(input.Class) {\n214|\t\treturn CaptureItem{}, invalid(\"capture item[%d] class %q is outside the nine-class vocabulary\", index, input.Class)\n215|\t}\n216|\tif input.Disposition != \"included\" && input.Disposition != \"excluded\" {\n217|\t\treturn CaptureItem{}, invalid(\"capture item[%d] disposition is outside included|excluded\", index)\n218|\t}\n219|\tvar descriptor *scalar.Digest\n220|\tif input.BlobDescriptorID != nil {\n221|\t\tvalue, err := scalar.ParseDigest(*input.BlobDescriptorID)\n222|\t\tif err != nil {\n223|\t\t\treturn CaptureItem{}, invalid(\"capture item[%d] blob_descriptor_id is not a digest: %v\", index, err)\n224|\t\t}\n225|\t\tdescriptor = &value\n226|\t}\n227|\tvar count *uint64\n228|\tif input.ByteCount != nil {\n229|\t\tif *input.ByteCount > maxUint53 {\n230|\t\t\treturn CaptureItem{}, invalid(\"capture item[%d] byte_count exceeds uint53\", index)\n231|\t\t}\n232|\t\tkept := *input.ByteCount\n233|\t\tcount = &kept\n234|\t}\n235|\tvar reason *string\n236|\tif input.ExclusionReason != nil {\n237|\t\tif stringLength(*input.ExclusionReason) < 1 || stringLength(*input.ExclusionReason) > 128 {\n238|\t\t\treturn CaptureItem{}, invalid(\"capture item[%d] exclusion_reason is not a string[1..128]\", index)\n239|\t\t}\n240|\t\tkept := *input.ExclusionReason\n241|\t\treason = &kept\n242|\t}\n243|\tif err := checkItemDisposition(index, input.Class, input.Disposition, descriptor != nil, count != nil, reason != nil); err != nil {\n244|\t\treturn CaptureItem{}, err\n245|\t}\n246|\tif _, err := encodeExtensions(input.Extensions); err != nil {\n247|\t\treturn CaptureItem{}, invalid(\"capture item[%d]: %v\", index, err)\n248|\t}\n249|\treturn CaptureItem{\n250|\t\tNativeItemKey:    input.NativeItemKey,\n251|\t\tClass:            input.Class,\n252|\t\tDisposition:      input.Disposition,\n253|\t\tBlobDescriptorID: descriptor,\n254|\t\tByteCount:        count,\n255|\t\tExclusionReason:  reason,\n256|\t\tExtensions:       extensionValue(input.Extensions),\n257|\t}, nil\n258|}\n259|\n260|func captureItemObject(item CaptureItem) map[string]any {\n261|\tvar descriptor any\n262|\tif item.BlobDescriptorID != nil {\n263|\t\tdescriptor = item.BlobDescriptorID.String()\n264|\t}\n265|\tvar count any\n266|\tif item.ByteCount != nil {\n267|\t\tcount = *item.ByteCount\n268|\t}\n269|\tvar reason any\n270|\tif item.ExclusionReason != nil {\n271|\t\treason = *item.ExclusionReason\n272|\t}\n273|\treturn map[string]any{\n274|\t\t\"native_item_key\":    item.NativeItemKey,\n275|\t\t\"class\":              item.Class,\n276|\t\t\"disposition\":        item.Disposition,\n277|\t\t\"blob_descriptor_id\": descriptor,\n278|\t\t\"byte_count\":         count,\n279|\t\t\"exclusion_reason\":   reason,\n280|\t\t\"extensions\":         extensionValue(item.Extensions),\n281|\t}\n282|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6bb","stream":{"kind":"session","id":"01a0b1a1-0fcd-7b72-b1bb-a101f0623221"},"sequence":440,"recorded_at":1780531400000875,"record_type":"event","durability":"durable","causation_id":"96b9aaba-3389-40b6-a064-cffa078aa95e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"96b9aaba-3389-40b6-a064-cffa078aa95e","run_stream":{"kind":"run","id":"96b9aaba-3389-40b6-a064-cffa078aa95e"},"call_id":"call_01a0b1a1fd7975f3ad6c239d08a92ebf","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/clonebundle/TRACEABILITY.md`.\n1|# Clone Bundle Clause Coverage (TASK-260830-24z2b3)\n2|\n3|Owner: `internal/clonebundle`. Authority:\n4|`internal/specdoc/SPEC.v0.7.0.md`, Sections 7.8, 10.2, 13.14.1\n5|(the pinned sections are byte-identical to v0.6.0).\n6|The Story's FINAL leaf carries the `internal/traceability` registry\n7|bindings and re-pin; this file is the first-leaf clause record.\n8|\n9|## Why this package validates instead of canonicaljson\n10|\n11|The `canonicaljson` closed-shape registry keeps\n12|`rejectUnsupportedImmutableObjectShape` rows for\n13|`clone-raw-object-manifest`, `clone-capture-manifest`,\n14|`canonical-session`, and `canonical-event` 1.0.0, and that table's\n15|census pins every row. Replacing them would fork shape ownership, so\n16|this package is the validating owner: it reuses\n17|`canonicaljson.Canonicalize` (byte transform),\n18|`canonicaljson.CalculateObjectIdentity` plus local claim comparisons\n19|(Blob Descriptors; never the attesting entry, per the provhost\n20|no-attestation bound),\n21|`sessadapter.DecodeTuple` (Environment Tuples),\n22|the `environ` scalar gate set (`CheckStringBounds`,\n23|`CheckUint53Bounds`, `CheckDigest`, `CheckUUIDv7`,\n24|`CheckTimestamp`, `CheckSortedUniqueStrings`,\n25|`CheckSortedUniqueDigests`, `CheckExtensions`, `StringLength`,\n26|`DecodeStrictObject`) through one-line delegating wrappers in the\n27|`sessadapter` convention, keeping only package-specific rules\n28|(sanitizer, exclusion, coupling, reconciliation, extension values),\n29|`scalar` (digests, UUIDv7, timestamps, paths),\n30|`hosttrust` (row-21 exclusion matchers), and\n31|`localstore.ObjectStore.PutBlob` (blob install). No rule is\n32|reimplemented where a landed owner exists.\n33|\n34|## Clause map\n35|\n36|| Pinned clause | Production entry | Test |\n37||---|---|---|\n38|| 13.14.1 Raw Manifest closed envelope + self ID | `BuildRawObjectManifest`, `DecodeRawObjectManifest` | `TestBuildRawManifestRoundTrip`, `TestRawManifestRefusals/decode` |\n39|| 13.14.1 RawObjectEntry class subset (no credential/auth/runtime/lock) | `buildRawEntries`, `decodeRawEntries` | `TestRawManifestRefusals/build` (5 class rows) |\n40|| 13.14.1 sorted unique entries, total_bytes sum | `buildRawEntries`, `decodeRawEntries` | `TestRawManifestRefusals` (unsorted, duplicate at build + decode, total mismatch, not-an-array, 65536 maximum, byte_count overflow) |\n41|| 13.14.1 sanitized native key, never an AX Session ID | `SanitizeNativeKey` | `TestIdentityRefusals/sanitizer`, raw/capture/session/event refusal rows |\n42|| Sanitizer exact bound (pinned text leaves scope open) | `SanitizeNativeKey` | `TestIdentityRefusals/sanitizer` corpus: refuses empty, Cc+C1 controls, Cf/Zl/Zp invisible format marks (U+200B/U+2028/U+2029), invalid UTF-8, absolute paths, UUIDv7, password-colon-before-@ (schemed or schemeless), case-folded `urn:ax:`; admits spaces, bare `@`, bare `:` |\n43|| Row 21 exclusion allowlist at construction | `refuseExcludedMember` | `TestRawManifestExcludesTrustMaterial`, `TestCaptureManifestExcludesTrustMaterial` |\n44|| 13.14.1 CaptureItem 9-class vocabulary | `ValidCaptureClass`, `buildCaptureItem`, `decodeCaptureItem` | `TestCaptureClassVocabularyIsPinned`, `TestCaptureItemRefusals` |\n45|| 13.14.1 included/excluded content rule | `checkItemDisposition` | `TestCaptureItemRefusals` (6 content rows) |\n46|| 13.14.1 always-excluded classes never included | `alwaysExcludedClass` | `TestCaptureItemRefusals` (4 class rows) |\n47|| 13.14.1 exact excluded_classes | `excludedRowClasses`, `excludedClassesExact` | `TestExcludedClassesExactGate`, `TestCaptureManifestRefusals/decode` |\n48|| 13.14.1 core-derived raw_complete + reconciliation | `deriveRawComplete`, `VerifyCaptureReconciliation` | `TestBuildCaptureManifestDerivesRawComplete`, `TestBuildCaptureManifestUnknownMakesIncomplete`, `TestCaptureManifestRefusals/reconciliation` |\n49|| 13.14.1 unknown blocks maximal_safe | `RefuseMaximalSafeUnlessComplete` | `TestBuildCaptureManifestUnknownMakesIncomplete`, `TestCaptureManifestRefusals/reconciliation` |\n50|| 13.14.1 Capture Source Basis union | `DecodeSourceBasis`, `buildSourceBasis` | `TestSourceBasisRefusals` |\n51|| 13.14.1 Capture Boundary union, stable proof coupling | `DecodeCaptureBoundary`, `buildBoundary`, `checkProofCoupling` | `TestBoundaryRefusals` (incl. input_blocked row), `TestBuildCaptureManifestUnstableArchive` |\n52|| 13.14.1 unstable is core-created, G2 rejects | `buildBoundary` (Core), `RefuseUnstableForTarget` | `TestBoundaryRefusals/build_core-only_unstable`, `TestBuildCaptureManifestUnstableArchive` |\n53|| 13.14.1 NativeIdentity closed shape | `DecodeNativeIdentity`, `EncodeNativeIdentity` | `TestNativeIdentityRoundTrip`, `TestIdentityRefusals/native_identity`, `TestEncodeNativeIdentityRefusals` (encode validates extensions) |\n54|| 13.14.1 source_identity_digest terminal digest | `IdentityDigest` | `TestIdentityDigestIsStable`, `TestBuildRawManifestRoundTrip` |\n55|| 13.14.1 WorkspaceBinding closed shape, normalized cwd | `DecodeWorkspaceBinding`, `checkCwdRelative` | `TestIdentityRefusals/workspace_binding` |\n56|| 13.14.1 Canonical Session + Actor rules | `BuildCanonicalSession`, `DecodeCanonicalSession` | `TestBuildCanonicalSessionRoundTrip`, `TestCanonicalSessionRefusals` (incl. decode external-null-parent, version, not-an-array, 1024-actor maximum) |\n57|| 13.14.1 Canonical Event envelope + 26 kinds + visibility | `BuildCanonicalEvent`, `DecodeCanonicalEvent`, `ValidEventKind` | `TestEventKindVocabularyIsPinned`, `TestBuildCanonicalEventRoundTrip`, `TestCanonicalEventRefusals` (incl. ordinal/offset/length overflow, version, not-an-array, raw_refs/reason-codes maxima), `TestCanonicalEventPayloadValueModel` |\n58|| 13.14.1 SourceEvidence + RawReference + synthesized coupling | `DecodeSourceEvidence`, `buildSourceEvidence`, `checkEvidenceCoupling` | `TestBuildCanonicalEventRoundTrip`, `TestCanonicalEventRefusals/evidence` |\n59|| 13.14.1 message-like content blocks, 64 KiB inline bound | `checkPayload`, `checkContentBlocks` | `TestCanonicalEventRefusals/build_envelope` (block rows incl. null content/descriptor, top-level duplicate, 64 KiB boundary) |\n60|| 13.14.1 contiguous ordinals from zero | `CheckOrdinalContiguity` | `TestOrdinalContiguity` |\n61|| 13.14.1 immutable generations | `ParseGeneration`, `Generation.Equal`, `CheckDigestsEqual` | `TestGenerationRefusals`, `TestBoundaryRefusals` |\n62|| 13.14.1 reverse-DNS extensions, no normative reference | `encodeExtensions`, `checkExtensionsClosed` | contract round trips + `bad extensions` rows in every refusal table |\n63|| 1.6 AX number model + nested duplicate refusal on extension values, every site | `checkExtensionsClosed`, `checkExtensionValues`, `checkAXNumberLiteral` | `TestRawManifestRefusals/extension_values` (1.5, 2^53, -(2^53), 2^60, exponent, nested float/unsafe, nested duplicate incl. resealed) + `TestExtensionValueModelAtEverySite` (one value-fault row per admission site, 17 rows) |\n64|| 1.6 string measure in characters | `stringLength` via `environ` | `TestMultibyteStringMeasure` (300-char/600-byte admit, 512 admit, 513 refuse) |\n65|| 13.14.1 one item per plan candidate at construction | `checkPlanItemMatch` | `TestCaptureManifestRefusals/build_plan_match` (extra, missing, renamed candidate, duplicate plan keys) |\n66|| 13.14.1 content block inline-XOR-descriptor | `checkContentBlocks` | `TestCanonicalEventRefusals/build_envelope` (neither, both) |\n67|| 13.14.1 duplicate raw keys refused | `VerifyCaptureReconciliation`, `deriveRawComplete` | `TestCaptureManifestRefusals/reconciliation` (duplicate raw/plan keys, derive direct) |\n68|| 13.14.1 source_identity_digest over sanitized bytes | `IdentityDigest` (re-decodes before hashing) | `TestIdentityDigestIsStable`, `TestIdentityDigestRefusals` (bad kind, bad extension key, unsanitized opaque/session) |\n69|| 10.2 Blob Descriptor identity + byte-count agreement | `VerifyDescriptorAgreement` (with entry identity link) | `TestBlobAgreementRefusals`, `TestBuildRawManifestRoundTrip`, `TestVerifyRawManifestDescriptorsRefusals` |\n70|| 10.2 entry names the verified descriptor | `buildRawEntries`, `VerifyRawManifestDescriptors` | build `descriptor id mismatch` row, `TestVerifyRawManifestDescriptorsRefusals` (fetch/absent/wrong/link) |\n71|| 10.2 no-replace install (fsync + verify + atomic) | `InstallRawBlob` via `localstore.PutBlob` | `TestInstallRawBlobIsIdempotent`, `TestInstallRawBlobRefusals` (forged claim, short/long bytes) |\n72|| 7.8 tuple/probe/manifest/discover/inspect reuse | `sessadapter.DecodeTuple` at every `source_environment` | `bad tuple` rows in raw/capture/session/event tables |\n73|| Byte-identical construction | all Build entries | `RoundTrip` tests rebuild and compare bytes |\n74|\n75|## Durability bound\n76|\n77|This package performs no durable write: `InstallRawBlob` delegates\n78|every byte to `localstore.ObjectStore.PutBlob` (no-replace install,\n79|fsync, size/digest verification, quarantine on collision). The\n80|landed crash/idempotency evidence for that discipline lives with\n81|`internal/localstore` (`object_store_test.go`,\n82|`object_store_fault_unix_test.go`, projection fault suites);\n83|`TestInstallRawBlobIsIdempotent` proves the delegation end to end\n84|(double install agrees, tampered bytes refuse). No second write\n85|path exists in this package.\n86|\n87|## Stated bounds (sibling scope)\n88|\n89|- Per-kind Canonical Event payload fact registries past the envelope\n90|  (which facts a kind may carry) are the normalization sibling's\n91|  registry. The Section 1.6 value model on every payload member\n92|  (integer literals, |n| <= 2^53-1, no fraction/exponent,\n93|  duplicate-free nested objects, depth bound) is enforced here for\n94|  every kind by `checkPayloadValues`, and payload numbers decode to\n95|  exact int64, so sealed bytes never round or collapse:\n96|  `TestCanonicalEventPayloadValueModel` (build + decode negatives\n97|  per non-message kind, sealed-bytes exactness, resealed decode,\n98|  message regression, depth bound).\n99|- `-0` and leading-`+`/leading-zero integer literals in extension\n100|  values and payloads admit, exactly as\n101|  `canonicaljson.validateAXNumbers` admits them\n102|  (`strconv.ParseInt` parity); the model refuses fractions,\n103|  exponents, and magnitudes at or beyond 2^53.\n104|- `BoundaryInput.Core` is caller-asserted; the real unstable-archive\n105|  protection is `RefuseUnstableForTarget` at target admission.\n106|- `InstallRawBlob`'s and `VerifyDescriptorAgreement`'s descriptor\n107|  member-parse arms (`blob_id`/`size`/self-field/object shape)\n108|  repeat the owner grammar after `CalculateObjectIdentity` already\n109|  enforced it (`validateBlobDescriptor` requires a digest\n110|  `blob_id`, a uint53 `size`, and the `descriptor_id` self field):\n111|  defense in depth, unreachable on failure, pinned by the owner\n112|  suite; the agreement/install negatives pin the claim comparison\n113|  and the store size/digest enforcement end to end.\n114|- The raw-manifest `total_bytes` uint53 overflow arm needs entry\n115|  byte counts summing past 2^53-1 with agreeing descriptors (real\n116|  payloads cannot reach it): defense in depth behind the\n117|  per-entry uint53 arm, which carries a `byte_count overflow` row.\n118|- C1 beyond U+0085 (e.g. U+009F), the fraction arm of\n119|  `checkAXNumberLiteral` (subsumed by `ParseInt`), and the exact\n120|  256/257 depth edge are owner-informational: the class is pinned\n121|  (U+0085, `1.5` refusals, the 300-deep payload refusal) without\n122|  pinning every member.\n123|- Per-kind Canonical Event payload fact registries beyond the\n124|  Section 13.14.1 envelope enforced in `checkPayload` (normalization\n125|  sibling).\n126|- `maximal_safe` projection planning past\n127|  `RefuseMaximalSafeUnlessComplete` (projection sibling).\n128|- Target-branch (G2) admission past `RefuseUnstableForTarget`.\n129|- Section 7.8 capture-plan/capture/normalize operation wiring\n130|  (stays owned by `sessadapter`); this package owns the contracts\n131|  those operations produce, not the operation frames.\n132|- `internal/traceability` registry bindings and digest re-pin\n133|  (Story FINAL leaf).","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6bd","stream":{"kind":"session","id":"01a0b1a1-0fcd-7b72-b1bb-a101f0623221"},"sequence":441,"recorded_at":1780531400000877,"record_type":"event","durability":"durable","causation_id":"96b9aaba-3389-40b6-a064-cffa078aa95e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"96b9aaba-3389-40b6-a064-cffa078aa95e","run_stream":{"kind":"run","id":"96b9aaba-3389-40b6-a064-cffa078aa95e"},"call_id":"call_01a0b1a2007c754b82e9f3eae0c52b19","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/clonebundle/blobref.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"io\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/localstore\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// This file owns the Section 10.2 raw evidence descriptor path: Blob\n13|// Descriptor identity and byte-count agreement, and no-replace blob\n14|// installation through the landed localstore durable-write\n15|// discipline. This package performs no durable write itself: every\n16|// byte crosses localstore.ObjectStore.PutBlob, whose no-replace,\n17|// fsync, and crash/idempotency evidence is cited in TRACEABILITY.md.\n18|\n19|// BlobAgreement is the verified agreement between a manifest entry\n20|// and its Section 10.2 Blob Descriptor.\n21|type BlobAgreement struct {\n22|\tDescriptorID scalar.Digest\n23|\tBlobID       scalar.Digest\n24|\tSize         uint64\n25|}\n26|\n27|// VerifyDescriptorAgreement verifies one raw evidence descriptor:\n28|// the bytes must be a closed valid Blob Descriptor 1.0.0 whose\n29|// claimed identity equals the computed omit-self digest, the\n30|// computed identity must equal the manifest entry's\n31|// blob_descriptor_id claim, and the descriptor's blob ID and size\n32|// must agree with the entry's claim. The identity link is what\n33|// binds the entry to the exact descriptor bytes verified: without\n34|// it any descriptor with an agreeing blob ID and size would satisfy\n35|// the entry. Shape validation and digest computation run through\n36|// the canonicaljson owner, never a fork; the claim comparisons are\n37|// local, because binding attestation outside the session leaf is\n38|// refused by the provhost no-attestation bound, so this package\n39|// never calls the attesting entry.\n40|func VerifyDescriptorAgreement(descriptor []byte, wantDescriptorID, wantBlobID scalar.Digest, wantSize uint64) error {\n41|\tcalculated, claimed, members, err := calculateDescriptorIdentity(descriptor)\n42|\tif err != nil {\n43|\t\treturn err\n44|\t}\n45|\tif calculated != claimed {\n46|\t\treturn invalid(\"blob descriptor claim %q does not match omit-self digest %q\", claimed.String(), calculated.String())\n47|\t}\n48|\tif calculated != wantDescriptorID {\n49|\t\treturn invalid(\"blob descriptor identity %q disagrees with entry claim %q\", calculated.String(), wantDescriptorID.String())\n50|\t}\n51|\tblobID, ok := checkDigest(members[\"blob_id\"])\n52|\tif !ok {\n53|\t\treturn invalid(\"blob descriptor blob_id is not a digest\")\n54|\t}\n55|\tif blobID != wantBlobID {\n56|\t\treturn invalid(\"blob descriptor blob_id %q disagrees with entry claim %q\", blobID.String(), wantBlobID.String())\n57|\t}\n58|\tsize, ok := checkUint53Bounds(members[\"size\"], 0, maxUint53)\n59|\tif !ok {\n60|\t\treturn invalid(\"blob descriptor size is not a uint53\")\n61|\t}\n62|\tif size != wantSize {\n63|\t\treturn invalid(\"blob descriptor size %d disagrees with entry claim %d\", size, wantSize)\n64|\t}\n65|\treturn nil\n66|}\n67|\n68|// InstallRawBlob installs one raw evidence blob through the landed\n69|// durable-write discipline: fsync, size/digest verification, and\n70|// atomic no-replace install owned by localstore. It returns the\n71|// verified agreement. A digest collision or same-ID/different-bytes\n72|// observation quarantines through the store owner; this package\n73|// adds no second write path.\n74|func InstallRawBlob(store *localstore.ObjectStore, descriptor []byte, source io.Reader) (BlobAgreement, error) {\n75|\tcalculated, claimed, members, err := calculateDescriptorIdentity(descriptor)\n76|\tif err != nil {\n77|\t\treturn BlobAgreement{}, err\n78|\t}\n79|\tif calculated != claimed {\n80|\t\treturn BlobAgreement{}, invalid(\"blob descriptor claim %q does not match omit-self digest %q\", claimed.String(), calculated.String())\n81|\t}\n82|\tblobID, ok := checkDigest(members[\"blob_id\"])\n83|\tif !ok {\n84|\t\treturn BlobAgreement{}, invalid(\"blob descriptor blob_id is not a digest\")\n85|\t}\n86|\tsize, ok := checkUint53Bounds(members[\"size\"], 0, maxUint53)\n87|\tif !ok {\n88|\t\treturn BlobAgreement{}, invalid(\"blob descriptor size is not a uint53\")\n89|\t}\n90|\tif store == nil {\n91|\t\treturn BlobAgreement{}, invalid(\"blob install requires an object store\")\n92|\t}\n93|\tif _, err := store.PutBlob(blobID, size, source); err != nil {\n94|\t\treturn BlobAgreement{}, invalid(\"blob install refused: %v\", err)\n95|\t}\n96|\treturn BlobAgreement{DescriptorID: calculated, BlobID: blobID, Size: size}, nil\n97|}\n98|\n99|// calculateDescriptorIdentity runs the owner's shape validation and\n100|// omit-self computation over one descriptor and reads its claimed\n101|// self digest. Callers compare the two; this helper never attests.\n102|func calculateDescriptorIdentity(descriptor []byte) (scalar.Digest, scalar.Digest, map[string]json.RawMessage, error) {\n103|\tcalculated, field, err := canonicaljson.CalculateObjectIdentity(descriptor)\n104|\tif err != nil {\n105|\t\treturn scalar.Digest{}, scalar.Digest{}, nil, invalid(\"blob descriptor identity fails: %v\", err)\n106|\t}\n107|\tif field != \"descriptor_id\" {\n108|\t\treturn scalar.Digest{}, scalar.Digest{}, nil, invalid(\"blob descriptor self field is %q, want descriptor_id\", string(field))\n109|\t}\n110|\tvar members map[string]json.RawMessage\n111|\tif err := json.Unmarshal(descriptor, &members); err != nil {\n112|\t\treturn scalar.Digest{}, scalar.Digest{}, nil, invalid(\"blob descriptor is not an object: %v\", err)\n113|\t}\n114|\tclaimed, ok := checkDigest(members[\"descriptor_id\"])\n115|\tif !ok {\n116|\t\treturn scalar.Digest{}, scalar.Digest{}, nil, invalid(\"blob descriptor descriptor_id is not a digest\")\n117|\t}\n118|\treturn calculated, claimed, members, nil\n119|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
