string{\n37|\t\"provider_native\",\n38|\t\"official_import\",\n39|\t\"continuation_context\",\n40|}\n41|\n42|func validNativeIdentityKind(kind string) bool {\n43|\tfor _, allowed := range nativeIdentityKinds {\n44|\t\tif kind == allowed {\n45|\t\t\treturn true\n46|\t\t}\n47|\t}\n48|\treturn false\n49|}\n50|\n51|// NativeIdentity is one validated sanitized native identity.\n52|type NativeIdentity struct {\n53|\tNativeSessionID         string\n54|\tIdentityKind            string\n55|\tLogicalWorkspaceID      scalar.UUIDv7\n56|\tBackendRealmFingerprint *scalar.Digest\n57|\tOpaqueIdentity          *string\n58|}\n59|\n60|// DecodeNativeIdentity validates one closed NativeIdentity: exact\n61|// members, the closed identity-kind vocabulary, a sanitized native\n62|// session ID, a UUIDv7 logical workspace, an optional digest realm\n63|// fingerprint, an optional sanitized opaque identity, and\n64|// reverse-DNS extensions. Credential, absolute-path, PID, socket,\n65|// token, and secret-environment material is refused by the shared\n66|// sanitizer, never laundered into an identity.\n67|func DecodeNativeIdentity(raw json.RawMessage) (NativeIdentity, error) {\n68|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n69|\tif fault != nil {\n70|\t\treturn NativeIdentity{}, invalid(\"native identity %s (%s)\", fault.detail, memberField(fault.member))\n71|\t}\n72|\tif name, unknown := unknownMember(members, nativeIdentityMembers); unknown {\n73|\t\treturn NativeIdentity{}, invalid(\"native identity carries unknown member %q\", name)\n74|\t}\n75|\tif name, missing := missingMember(members, nativeIdentityRequired); missing {\n76|\t\treturn NativeIdentity{}, invalid(\"native identity misses a required member %q\", name)\n77|\t}\n78|\tnativeID, ok := checkStringBounds(members[\"native_session_id\"], 1, 512)\n79|\tif !ok {\n80|\t\treturn NativeIdentity{}, invalid(\"native identity native_session_id is not a string[1..512]\")\n81|\t}\n82|\tif err := SanitizeNativeKey(nativeID); err != nil {\n83|\t\treturn NativeIdentity{}, err\n84|\t}\n85|\tkind, ok := rawString(members[\"identity_kind\"])\n86|\tif !ok || !validNativeIdentityKind(kind) {\n87|\t\treturn NativeIdentity{}, invalid(\"native identity kind is outside provider_native|official_import|continuation_context\")\n88|\t}\n89|\tworkspaceID, ok := checkUUIDv7(members[\"logical_workspace_id\"])\n90|\tif !ok {\n91|\t\treturn NativeIdentity{}, invalid(\"native identity logical_workspace_id is not a UUIDv7\")\n92|\t}\n93|\tvar fingerprint *scalar.Digest\n94|\tif !isNull(members[\"backend_realm_fingerprint\"]) {\n95|\t\tdigest, ok := checkDigest(members[\"backend_realm_fingerprint\"])\n96|\t\tif !ok {\n97|\t\t\treturn NativeIdentity{}, invalid(\"native identity backend_realm_fingerprint is not a digest\")\n98|\t\t}\n99|\t\tfingerprint = &digest\n100|\t}\n101|\tvar opaque *string\n102|\tif !isNull(members[\"opaque_identity\"]) {\n103|\t\tvalue, ok := checkStringBounds(members[\"opaque_identity\"], 1, 512)\n104|\t\tif !ok {\n105|\t\t\treturn NativeIdentity{}, invalid(\"native identity opaque_identity is not a string[1..512]\")\n106|\t\t}\n107|\t\tif err := SanitizeNativeKey(value); err != nil {\n108|\t\t\treturn NativeIdentity{}, err\n109|\t\t}\n110|\t\topaque = &value\n111|\t}\n112|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n113|\t\treturn NativeIdentity{}, invalid(\"native identity extensions %s\", extensionsFault)\n114|\t}\n115|\treturn NativeIdentity{\n116|\t\tNativeSessionID:         nativeID,\n117|\t\tIdentityKind:            kind,\n118|\t\tLogicalWorkspaceID:      workspaceID,\n119|\t\tBackendRealmFingerprint: fingerprint,\n120|\t\tOpaqueIdentity:          opaque,\n121|\t}, nil\n122|}\n123|\n124|// EncodeNativeIdentity renders one validated identity as canonical\n125|// bytes under the given extensions. The identity must already be\n126|// decoded; the extensions are validated here, so encoding never\n127|// admits what decoding refused. A nil extensions map encodes as the\n128|// empty object.\n129|func EncodeNativeIdentity(identity NativeIdentity, extensions map[string]any) ([]byte, error) {\n130|\tif _, err := encodeExtensions(extensions); err != nil {\n131|\t\treturn nil, err\n132|\t}\n133|\tvar fingerprint any\n134|\tif identity.BackendRealmFingerprint != nil {\n135|\t\tfingerprint = identity.BackendRealmFingerprint.String()\n136|\t}\n137|\tvar opaque any\n138|\tif identity.OpaqueIdentity != nil {\n139|\t\topaque = *identity.OpaqueIdentity\n140|\t}\n141|\tif extensions == nil {\n142|\t\textensions = map[string]any{}\n143|\t}\n144|\treturn canonicalizeObject(map[string]any{\n145|\t\t\"native_session_id\":         identity.NativeSessionID,\n146|\t\t\"identity_kind\":             identity.IdentityKind,\n147|\t\t\"logical_workspace_id\":      identity.LogicalWorkspaceID.String(),\n148|\t\t\"backend_realm_fingerprint\": fingerprint,\n149|\t\t\"opaque_identity\":           opaque,\n150|\t\t\"extensions\":                extensions,\n151|\t})\n152|}\n153|\n154|var workspaceBindingMembers = map[string]bool{\n155|\t\"logical_workspace_id\":           true,\n156|\t\"cwd_relative\":                   true,\n157|\t\"repository_remote_fingerprints\": true,\n158|\t\"branch\":                         true,\n159|\t\"head_digest\":                    true,\n160|\t\"index_digest\":                   true,\n161|\t\"working_tree_digest\":            true,\n162|\t\"extensions\":                     true,\n163|}\n164|\n165|var workspaceBindingRequired = []string{\n166|\t\"logical_workspace_id\",\n167|\t\"cwd_relative\",\n168|\t\"repository_remote_fingerprints\",\n169|\t\"branch\",\n170|\t\"head_digest\",\n171|\t\"index_digest\",\n172|\t\"working_tree_digest\",\n173|\t\"extensions\",\n174|}\n175|\n176|// WorkspaceBinding is one validated closed workspace binding. No\n177|// member grants filesystem authority: the cwd is a normalized\n178|// relative path beneath the Workspace Group root, never an absolute\n179|// path or an escape.\n180|type WorkspaceBinding struct {\n181|\tLogicalWorkspaceID scalar.UUIDv7\n182|\tCwdRelative        string\n183|\tRemoteFingerprints []scalar.Digest\n184|\tBranch             *string\n185|\tHeadDigest         *scalar.Digest\n186|\tIndexDigest        *scalar.Digest\n187|\tWorkingTreeDigest  *scalar.Digest\n188|}\n189|\n190|// DecodeWorkspaceBinding validates one closed WorkspaceBinding.\n191|func DecodeWorkspaceBinding(raw json.RawMessage) (WorkspaceBinding, error) {\n192|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n193|\tif fault != nil {\n194|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding %s (%s)\", fault.detail, memberField(fault.member))\n195|\t}\n196|\tif name, unknown := unknownMember(members, workspaceBindingMembers); unknown {\n197|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding carries unknown member %q\", name)\n198|\t}\n199|\tif name, missing := missingMember(members, workspaceBindingRequired); missing {\n200|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding misses a required member %q\", name)\n201|\t}\n202|\tworkspaceID, ok := checkUUIDv7(members[\"logical_workspace_id\"])\n203|\tif !ok {\n204|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding logical_workspace_id is not a UUIDv7\")\n205|\t}\n206|\tcwd, ok := checkStringBounds(members[\"cwd_relative\"], 1, 4096)\n207|\tif !ok {\n208|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding cwd_relative is not a string[1..4096]\")\n209|\t}\n210|\tif err := checkCwdRelative(cwd); err != nil {\n211|\t\treturn WorkspaceBinding{}, err\n212|\t}\n213|\tfingerprints, ok := checkSortedUniqueDigests(members[\"repository_remote_fingerprints\"], 0, 128)\n214|\tif !ok {\n215|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding repository_remote_fingerprints are not sorted unique digest[0..128]\")\n216|\t}\n217|\tvar branch *string\n218|\tif !isNull(members[\"branch\"]) {\n219|\t\tvalue, ok := checkStringBounds(members[\"branch\"], 1, 1024)\n220|\t\tif !ok {\n221|\t\t\treturn WorkspaceBinding{}, invalid(\"workspace binding branch is not a string[1..1024]\")\n222|\t\t}\n223|\t\tbranch = &value\n224|\t}\n225|\thead, err := checkNullableDigest(members, \"head_digest\", \"workspace binding\")\n226|\tif err != nil {\n227|\t\treturn WorkspaceBinding{}, err\n228|\t}\n229|\tindex, err := checkNullableDigest(members, \"index_digest\", \"workspace binding\")\n230|\tif err != nil {\n231|\t\treturn WorkspaceBinding{}, err\n232|\t}\n233|\ttree, err := checkNullableDigest(members, \"working_tree_digest\", \"workspace binding\")\n234|\tif err != nil {\n235|\t\treturn WorkspaceBinding{}, err\n236|\t}\n237|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n238|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding extensions %s\", extensionsFault)\n239|\t}\n240|\treturn WorkspaceBinding{\n241|\t\tLogicalWorkspaceID: workspaceID,\n242|\t\tCwdRelative:        cwd,\n243|\t\tRemoteFingerprints: fingerprints,\n244|\t\tBranch:             branch,\n245|\t\tHeadDigest:         head,\n246|\t\tIndexDigest:        index,\n247|\t\tWorkingTreeDigest:  tree,\n248|\t}, nil\n249|}\n250|\n251|// checkCwdRelative admits exactly the normalized relative paths\n252|// beneath (or equal to) the Workspace Group root: scalar relative\n253|// paths plus the root itself (\".\"). Anything else — absolute,\n254|// escaped, backslashed, encoded-separator, or dot-segment forms —\n255|// would grant or smuggle filesystem authority and is refused.\n256|func checkCwdRelative(cwd string) error {\n257|\tif cwd == \".\" {\n258|\t\treturn nil\n259|\t}\n260|\tif _, err := scalar.ParseRelativePath(cwd); err != nil {\n261|\t\treturn invalid(\"workspace binding cwd_relative is not normalized beneath the workspace root: %v\", err)\n262|\t}\n263|\treturn nil\n264|}\n265|\n266|func checkNullableDigest(members map[string]json.RawMessage, name, owner string) (*scalar.Digest, error) {\n267|\traw, present := members[name]\n268|\tif !present {\n269|\t\treturn nil, invalid(\"%s misses a required member %q\", owner, name)\n270|\t}\n271|\tif isNull(raw) {\n272|\t\treturn nil, nil\n273|\t}\n274|\tdigest, ok := checkDigest(raw)\n275|\tif !ok {\n276|\t\treturn nil, invalid(\"%s %s is not a digest\", owner, name)\n277|\t}\n278|\treturn &digest, nil\n279|}\n280|\n281|// SanitizeNativeKey refuses every native key that is not sanitized:\n282|// empty values are refused here (over-long values by the caller's\n283|// bound check), and this gate refuses control characters (the full\n284|// Cc class, C0 and C1), invisible format characters (Cf, Zl, Zp:\n285|// zero-width and separator marks that render invisibly),\n286|// absolute-path forms, a UUIDv7 form (indistinguishable from a\n287|// fabricated AX Session identity), embedded-credential forms (a\n288|// password-style colon before the first @, with or without a\n289|// scheme), and AX-schema markers in any case. The pinned text does\n290|// not define the sanitizer's exact scope, so the implemented bound\n291|// is exactly this list, pinned by the sanitizer corpus and stated\n292|// in TRACEABILITY.md: ordinary spaces, @ without a password\n293|// colon, and colons without an @ all admit. A native key that\n294|// survives is printable, relative, and unambiguously native.\n295|func SanitizeNativeKey(key string) error {\n296|\tif key == \"\" {\n297|\t\treturn invalid(\"native key is empty\")\n298|\t}\n299|\tif !utf8.ValidString(key) {\n300|\t\treturn invalid(\"native key is not valid UTF-8\")\n301|\t}\n302|\tfor _, unit := range key {\n303|\t\tif unicode.IsControl(unit) {\n304|\t\t\treturn invalid(\"native key carries control characters\")\n305|\t\t}\n306|\t\tif unicode.Is(unicode.Cf, unit) || unicode.Is(unicode.Zl, unit) || unicode.Is(unicode.Zp, unit) {\n307|\t\t\treturn invalid(\"native key carries invisible format characters\")\n308|\t\t}\n309|\t}\n310|\tif strings.HasPrefix(key, \"/\") || strings.HasPrefix(key, `\\\\`) || hasDrivePrefix(key) {\n311|\t\treturn invalid(\"native key is an absolute source path, never a cross-host identity\")\n312|\t}\n313|\tif _, err := scalar.ParseUUIDv7(key); err == nil {\n314|\t\treturn invalid(\"native key %q is a UUIDv7, indistinguishable from a fabricated AX Session identity\", key)\n315|\t}\n316|\tif strings.Contains(strings.ToLower(key), \"urn:ax:\") {\n317|\t\treturn invalid(\"native key carries an AX identity marker\")\n318|\t}\n319|\tif at := strings.Index(key, \"@\"); at >= 0 && strings.Contains(key[:at], \":\") {\n320|\t\treturn invalid(\"native key carries embedded credentials\")\n321|\t}\n322|\treturn nil\n323|}\n324|\n325|func hasDrivePrefix(value string) bool {\n326|\treturn len(value) >= 3 && ((value[0] >= 'a' && value[0] <= 'z') || (value[0] >= 'A' && value[0] <= 'Z')) && value[1] == ':' && (value[2] == '/' || value[2] == '\\\\')\n327|}\n328|\n329|func memberField(member string) string {\n330|\tif member == \"\" {\n331|\t\treturn \"frame\"\n332|\t}\n333|\treturn \"member \" + member\n334|}","final_result":true}}}
