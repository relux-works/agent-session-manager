tent_blocks\":[{\"type\":\"text\",\"blob_id\":\"x\"}],\"extensions\":{}}`)\n259|\t\t\t}, \"unknown member\"},\n260|\t\t\t{\"block null content\", func(in *CanonicalEventInput) {\n261|\t\t\t\tin.Payload = []byte(`{\"content_blocks\":[{\"type\":\"text\",\"content\":null}],\"extensions\":{}}`)\n262|\t\t\t}, \"not exclusive\"},\n263|\t\t\t{\"block null descriptor\", func(in *CanonicalEventInput) {\n264|\t\t\t\tin.Payload = []byte(`{\"content_blocks\":[{\"type\":\"text\",\"blob_descriptor_id\":null}],\"extensions\":{}}`)\n265|\t\t\t}, \"not exclusive\"},\n266|\t\t\t{\"payload top-level duplicate\", func(in *CanonicalEventInput) {\n267|\t\t\t\tin.Payload = []byte(`{\"content_blocks\":[{\"type\":\"text\",\"content\":\"x\"}],\"extensions\":{},\"extensions\":{}}`)\n268|\t\t\t}, \"duplicate member\"},\n269|\t\t\t{\"ordinal overflow\", func(in *CanonicalEventInput) { in.Ordinal = maxUint53 + 1 }, \"exceeds uint53\"},\n270|\t\t\t{\"bad extensions\", func(in *CanonicalEventInput) { in.Extensions = map[string]any{\"no-dots\": 1} }, \"reverse-DNS\"},\n271|\t\t}\n272|\t\tfor _, tc := range cases {\n273|\t\t\tt.Run(tc.name, func(t *testing.T) {\n274|\t\t\t\tinput := validEventInput(\"exact\")\n275|\t\t\t\ttc.mutate(&input)\n276|\t\t\t\t_, err := BuildCanonicalEvent(input)\n277|\t\t\t\trequireRefusal(t, err, tc.fragment)\n278|\t\t\t})\n279|\t\t}\n280|\t\t// Inline content at exactly 64 KiB is admitted.\n281|\t\tinput := validEventInput(\"exact\")\n282|\t\tinput.Payload = []byte(`{\"content_blocks\":[{\"type\":\"text\",\"content\":\"` + strings.Repeat(\"y\", 65536) + `\"}],\"extensions\":{}}`)\n283|\t\tif _, err := BuildCanonicalEvent(input); err != nil {\n284|\t\t\tt.Fatalf(\"BuildCanonicalEvent(64 KiB inline) error = %v\", err)\n285|\t\t}\n286|\t})\n287|\tt.Run(\"decode\", func(t *testing.T) {\n288|\t\tvalid := mustEventBytes(t, \"exact\")\n289|\t\tcases := []struct {\n290|\t\t\tname     string\n291|\t\t\tbody     func(t *testing.T) []byte\n292|\t\t\tfragment string\n293|\t\t}{\n294