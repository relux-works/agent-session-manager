{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5d3","stream":{"kind":"session","id":"01a0b1a1-0fcd-7b72-b1bb-a101f0623221"},"sequence":324,"recorded_at":1780531400000643,"record_type":"event","durability":"durable","causation_id":"96b9aaba-3389-40b6-a064-cffa078aa95e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"96b9aaba-3389-40b6-a064-cffa078aa95e","run_stream":{"kind":"run","id":"96b9aaba-3389-40b6-a064-cffa078aa95e"},"call_id":"call_01a0b1a1ca967010ab7c18f81ba17334","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/clonebundle/session.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n8|)\n9|\n10|// This file validates and constructs Canonical Session 1.0.0 and its\n11|// Actor records: the logical session envelope over ordered unique\n12|// Canonical Event IDs.\n13|\n14|const (\n15|\tcanonicalSessionSchema  = \"urn:ax:schema:canonical-session\"\n16|\tcanonicalSessionVersion = \"1.0.0\"\n17|\tcanonicalSessionSelf    = \"canonical_session_id\"\n18|)\n19|\n20|var actorMembers = map[string]bool{\n21|\t\"actor_id\": true, \"kind\": true, \"parent_actor_id\": true, \"name\": true,\n22|\t\"source_native_id\": true, \"model\": true, \"extensions\": true,\n23|}\n24|\n25|var actorRequired = []string{\n26|\t\"actor_id\", \"kind\", \"parent_actor_id\", \"name\",\n27|\t\"source_native_id\", \"model\", \"extensions\",\n28|}\n29|\n30|// Actor is one validated canonical actor.\n31|type Actor struct {\n32|\tActorID        scalar.UUIDv7\n33|\tKind           string\n34|\tParentActorID  *scalar.UUIDv7\n35|\tName           *string\n36|\tSourceNativeID *string\n37|\tModel          *string\n38|}\n39|\n40|func validActorKind(kind string) bool {\n41|\treturn kind == \"main\" || kind == \"subagent\" || kind == \"external\"\n42|}\n43|\n44|func decodeActor(raw json.RawMessage, index int) (Actor, error) {\n45|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n46|\tif fault != nil {\n47|\t\treturn Actor{}, invalid(\"actor[%d] %s (%s)\", index, fault.detail, memberField(fault.member))\n48|\t}\n49|\tif name, unknown := unknownMember(members, actorMembers); unknown {\n50|\t\treturn Actor{}, invalid(\"actor[%d] carries unknown member %q\", index, name)\n51|\t}\n52|\tif name, missing := missingMember(members, actorRequired); missing {\n53|\t\treturn Actor{}, invalid(\"actor[%d] misses a required member %q\", index, name)\n54|\t}\n55|\tactorID, ok := checkUUIDv7(members[\"actor_id\"])\n56|\tif !ok {\n57|\t\treturn Actor{}, invalid(\"actor[%d] actor_id is not a UUIDv7\", index)\n58|\t}\n59|\tkind, ok := rawString(members[\"kind\"])\n60|\tif !ok || !validActorKind(kind) {\n61|\t\treturn Actor{}, invalid(\"actor[%d] kind is outside main|subagent|external\", index)\n62|\t}\n63|\tvar parent *scalar.UUIDv7\n64|\tif !isNull(members[\"parent_actor_id\"]) {\n65|\t\tvalue, ok := checkUUIDv7(members[\"parent_actor_id\"])\n66|\t\tif !ok {\n67|\t\t\treturn Actor{}, invalid(\"actor[%d] parent_actor_id is not a UUIDv7\", index)\n68|\t\t}\n69|\t\tparent = &value\n70|\t}\n71|\tif kind == \"main\" && parent != nil {\n72|\t\treturn Actor{}, invalid(\"actor[%d] main actor carries a parent\", index)\n73|\t}\n74|\tif kind != \"main\" && parent == nil {\n75|\t\treturn Actor{}, invalid(\"actor[%d] non-main actor requires a parent\", index)\n76|\t}\n77|\tname, err := checkNullableBoundedString(members, \"name\", 1, 512, index, \"actor\")\n78|\tif err != nil {\n79|\t\treturn Actor{}, err\n80|\t}\n81|\tnativeID, err := checkNullableBoundedString(members, \"source_native_id\", 1, 512, index, \"actor\")\n82|\tif err != nil {\n83|\t\treturn Actor{}, err\n84|\t}\n85|\tif nativeID != nil {\n86|\t\tif err := SanitizeNativeKey(*nativeID); err != nil {\n87|\t\t\treturn Actor{}, err\n88|\t\t}\n89|\t}\n90|\tmodel, err := checkNullableBoundedString(members, \"model\", 1, 512, index, \"actor\")\n91|\tif err != nil {\n92|\t\treturn Actor{}, err\n93|\t}\n94|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n95|\t\treturn Actor{}, invalid(\"actor[%d] extensions %s\", index, extensionsFault)\n96|\t}\n97|\treturn Actor{\n98|\t\tActorID:        actorID,\n99|\t\tKind:           kind,\n100|\t\tParentActorID:  parent,\n101|\t\tName:           name,\n102|\t\tSourceNativeID: nativeID,\n103|\t\tModel:          model,\n104|\t}, nil\n105|}\n106|\n107|func checkNullableBoundedString(members map[string]json.RawMessage, name string, minimum, maximum, index int, owner string) (*string, error) {\n108|\traw, present := members[name]\n109|\tif !present {\n110|\t\treturn nil, invalid(\"%s[%d] misses a required member %q\", owner, index, name)\n111|\t}\n112|\tif isNull(raw) {\n113|\t\treturn nil, nil\n114|\t}\n115|\tvalue, ok := checkStringBounds(raw, minimum, maximum)\n116|\tif !ok {\n117|\t\treturn nil, invalid(\"%s[%d] %s is not a string[%d..%d]\", owner, index, name, minimum, maximum)\n118|\t}\n119|\treturn &value, nil\n120|}\n121|\n122|// ActorInput is one caller-supplied actor candidate for Build.\n123|type ActorInput struct {\n124|\tActorID        string\n125|\tKind           string\n126|\tParentActorID  *string\n127|\tName           *string\n128|\tSourceNativeID *string\n129|\tModel          *string\n130|}\n131|\n132|func buildActor(input ActorInput, index int) (Actor, error) {\n133|\tactorID, err := scalar.ParseUUIDv7(input.ActorID)\n134|\tif err != nil {\n135|\t\treturn Actor{}, invalid(\"actor[%d] actor_id is not a UUIDv7: %v\", index, err)\n136|\t}\n137|\tif !validActorKind(input.Kind) {\n138|\t\treturn Actor{}, invalid(\"actor[%d] kind is outside main|subagent|external\", index)\n139|\t}\n140|\tvar parent *scalar.UUIDv7\n141|\tif input.ParentActorID != nil {\n142|\t\tvalue, err := scalar.ParseUUIDv7(*input.ParentActorID)\n143|\t\tif err != nil {\n144|\t\t\treturn Actor{}, invalid(\"actor[%d] parent_actor_id is not a UUIDv7: %v\", index, err)\n145|\t\t}\n146|\t\tparent = &value\n147|\t}\n148|\tif input.Kind == \"main\" && parent != nil {\n149|\t\treturn Actor{}, invalid(\"actor[%d] main actor carries a parent\", index)\n150|\t}\n151|\tif input.Kind != \"main\" && parent == nil {\n152|\t\treturn Actor{}, invalid(\"actor[%d] non-main actor requires a parent\", index)\n153|\t}\n154|\tif input.Name != nil && (stringLength(*input.Name) < 1 || stringLength(*input.Name) > 512) {\n155|\t\treturn Actor{}, invalid(\"actor[%d] name is not a string[1..512]\", index)\n156|\t}\n157|\tif input.SourceNativeID != nil {\n158|\t\tif stringLength(*input.SourceNativeID) < 1 || stringLength(*input.SourceNativeID) > 512 {\n159|\t\t\treturn Actor{}, invalid(\"actor[%d] source_native_id is not a string[1..512]\", index)\n160|\t\t}\n161|\t\tif err := SanitizeNativeKey(*input.SourceNativeID); err != nil {\n162|\t\t\treturn Actor{}, err\n163|\t\t}\n164|\t}\n165|\tif input.Model != nil && (stringLength(*input.Model) < 1 || stringLength(*input.Model) > 512) {\n166|\t\treturn Actor{}, invalid(\"actor[%d] model is not a string[1..512]\", index)\n167|\t}\n168|\treturn Actor{\n169|\t\tActorID:        actorID,\n170|\t\tKind:           input.Kind,\n171|\t\tParentActorID:  parent,\n172|\t\tName:           input.Name,\n173|\t\tSourceNativeID: input.SourceNativeID,\n174|\t\tModel:          input.Model,\n175|\t}, nil\n176|}\n177|\n178|func actorObject(actor Actor) map[string]any {\n179|\tvar parent any\n180|\tif actor.ParentActorID != nil {\n181|\t\tparent = actor.ParentActorID.String()\n182|\t}\n183|\tvar name any\n184|\tif actor.Name != nil {\n185|\t\tname = *actor.Name\n186|\t}\n187|\tvar nativeID any\n188|\tif actor.SourceNativeID != nil {\n189|\t\tnativeID = *actor.SourceNativeID\n190|\t}\n191|\tvar model any\n192|\tif actor.Model != nil {\n193|\t\tmodel = *actor.Model\n194|\t}\n195|\treturn map[string]any{\n196|\t\t\"actor_id\":         actor.ActorID.String(),\n197|\t\t\"kind\":             actor.Kind,\n198|\t\t\"parent_actor_id\":  parent,\n199|\t\t\"name\":             name,\n200|\t\t\"source_native_id\": nativeID,\n201|\t\t\"model\":            model,\n202|\t\t\"extensions\":       map[string]any{},\n203|\t}\n204|}\n205|\n206|var canonicalSessionMembers = map[string]bool{\n207|\t\"schema\": true, \"schema_version\": true, \"canonical_session_id\": true,\n208|\t\"logical_session_id\": true, \"source_environment\": true,\n209|\t\"source_native_session_id\": true, \"title\": true, \"workspace\": true,\n210|\t\"actors\": true, \"event_ids\": true, \"head_event_ids\": true,\n211|\t\"created_at\": true, \"updated_at\": true, \"extensions\": true,\n212|}\n213|\n214|var canonicalSessionRequired = []string{\n215|\t\"schema\", \"schema_version\", \"canonical_session_id\",\n216|\t\"logical_session_id\", \"source_environment\",\n217|\t\"source_native_session_id\", \"title\", \"workspace\",\n218|\t\"actors\", \"event_ids\", \"head_event_ids\",\n219|\t\"created_at\", \"updated_at\", \"extensions\",\n220|}\n221|\n222|// CanonicalSession is one validated Canonical Session.\n223|type CanonicalSession struct {\n224|\tSessionID             scalar.Digest\n225|\tLogicalSessionID      scalar.UUIDv7\n226|\tSourceEnvironment     sessadapter.Tuple\n227|\tSourceNativeSessionID string\n228|\tTitle                 *string\n229|\tWorkspace             WorkspaceBinding\n230|\tActors                []Actor\n231|\tEventIDs              []scalar.Digest\n232|\tHeadEventIDs          []scalar.Digest\n233|\tCreatedAt             *scalar.Timestamp\n234|\tUpdatedAt             *scalar.Timestamp\n235|}\n236|\n237|// CanonicalSessionInput is the caller-supplied canonical session\n238|// candidate for Build.\n239|type CanonicalSessionInput struct {\n240|\tLogicalSessionID      string\n241|\tSourceEnvironment     []byte\n242|\tSourceNativeSessionID string\n243|\tTitle                 *string\n244|\tWorkspace             []byte\n245|\tActors                []ActorInput\n246|\tEventIDs              []string\n247|\tHeadEventIDs          []string\n248|\tCreatedAt             *string\n249|\tUpdatedAt             *string\n250|\tExtensions            map[string]any\n251|}\n252|\n253|// BuildCanonicalSession constructs one closed Canonical Session\n254|// 1.0.0 as canonical bytes. Identical inputs produce byte-identical\n255|// outputs.\n256|func BuildCanonicalSession(input CanonicalSessionInput) ([]byte, error) {\n257|\tobject, err := buildCanonicalSession(input)\n258|\tif err != nil {\n259|\t\treturn nil, err\n260|\t}\n261|\tomitted, err := canonicalizeObject(object)\n262|\tif err != nil {\n263|\t\treturn nil, err\n264|\t}\n265|\tsessionID := scalar.SHA256Digest(omitted)\n266|\tobject[canonicalSessionSelf] = sessionID.String()\n267|\treturn canonicalizeObject(object)\n268|}\n269|\n270|func buildCanonicalSession(input CanonicalSessionInput) (map[string]any, error) {\n271|\tlogical, err := scalar.ParseUUIDv7(input.LogicalSessionID)\n272|\tif err != nil {\n273|\t\treturn nil, invalid(\"canonical session logical_session_id is not a UUIDv7: %v\", err)\n274|\t}\n275|\ttuple, err := sessadapter.DecodeTuple(json.RawMessage(input.SourceEnvironment))\n276|\tif err != nil {\n277|\t\treturn nil, invalid(\"canonical session source_environment is not an Environment Tuple: %v\", err)\n278|\t}\n279|\tif stringLength(input.SourceNativeSessionID) < 1 || stringLength(input.SourceNativeSessionID) > 512 {\n280|\t\treturn nil, invalid(\"canonical session source_native_session_id is not a string[1..512]\")\n281|\t}\n282|\tif err := SanitizeNativeKey(input.SourceNativeSessionID); err != nil {\n283|\t\treturn nil, err\n284|\t}\n285|\tvar title any\n286|\tif input.Title != nil {\n287|\t\tif stringLength(*input.Title) < 1 || stringLength(*input.Title) > 4096 {\n288|\t\t\treturn nil, invalid(\"canonical session title is not a string[1..4096]\")\n289|\t\t}\n290|\t\ttitle = *input.Title\n291|\t}\n292|\tif _, err := DecodeWorkspaceBinding(json.RawMessage(input.Workspace)); err != nil {\n293|\t\treturn nil, err\n294|\t}\n295|\tif len(input.Actors) < 1 || len(input.Actors) > 1024 {\n296|\t\treturn nil, invalid(\"canonical session carries %d actors, want [1..1024]\", len(input.Actors))\n297|\t}\n298|\tactors := make([]Actor, 0, len(input.Actors))\n299|\tseenActors := map[string]bool{}\n300|\tmainCount := 0\n301|\tfor index, candidate := range input.Actors {\n302|\t\tactor, err := buildActor(candidate, index)\n303|\t\tif err != nil {\n304|\t\t\treturn nil, err\n305|\t\t}\n306|\t\tif seenActors[actor.ActorID.String()] {\n307|\t\t\treturn nil, invalid(\"canonical session actors are not unique by actor ID\")\n308|\t\t}\n309|\t\tseenActors[actor.ActorID.String()] = true\n310|\t\tif actor.Kind == \"main\" {\n311|\t\t\tmainCount++\n312|\t\t}\n313|\t\tactors = append(actors, actor)\n314|\t}\n315|\tif mainCount != 1 {\n316|\t\treturn nil, invalid(\"canonical session carries %d main actors, want exactly one\", mainCount)\n317|\t}\n318|\teventIDs, err := parseOrderedUniqueDigests(input.EventIDs, 1, 1000000, \"event_ids\")\n319|\tif err != nil {\n320|\t\treturn nil, err\n321|\t}\n322|\theadIDs, err := parseSortedUniqueDigestStrings(input.HeadEventIDs, 1, 1024, \"head_event_ids\")\n323|\tif err != nil {\n324|\t\treturn nil, err\n325|\t}\n326|\teventSet := map[string]bool{}\n327|\tfor _, id := range eventIDs {\n328|\t\teventSet[id.String()] = true\n329|\t}\n330|\tfor _, id := range headIDs {\n331|\t\tif !eventSet[id.String()] {\n332|\t\t\treturn nil, invalid(\"canonical session head_event_ids carry an ID outside event_ids\")\n333|\t\t}\n334|\t}\n335|\tcreatedAt, err := parseNullableTimestamp(input.CreatedAt, \"created_at\")\n336|\tif err != nil {\n337|\t\treturn nil, err\n338|\t}\n339|\tupdatedAt, err := parseNullableTimestamp(input.UpdatedAt, \"updated_at\")\n340|\tif err != nil {\n341|\t\treturn nil, err\n342|\t}\n343|\tif _, err := encodeExtensions(input.Extensions); err != nil {\n344|\t\treturn nil, err\n345|\t}\n346|\tvar workspaceValue any\n347|\tif err := json.Unmarshal(bytesTrimSpace(json.RawMessage(input.Workspace)), &workspaceValue); err != nil {\n348|\t\treturn nil, invalid(\"canonical session workspace is not JSON: %v\", err)\n349|\t}\n350|\tactorObjects := make([]any, 0, len(actors))\n351|\tfor _, actor := range actors {\n352|\t\tactorObjects = append(actorObjects, actorObject(actor))\n353|\t}\n354|\treturn map[string]any{\n355|\t\t\"schema\":                   canonicalSessionSchema,\n356|\t\t\"schema_version\":           canonicalSessionVersion,\n357|\t\t\"logical_session_id\":       logical.String(),\n358|\t\t\"source_environment\":       tupleObject(tuple),\n359|\t\t\"source_native_session_id\": input.SourceNativeSessionID,\n360|\t\t\"title\":                    title,\n361|\t\t\"workspace\":                workspaceValue,\n362|\t\t\"actors\":                   actorObjects,\n363|\t\t\"event_ids\":                digestStrings(eventIDs),\n364|\t\t\"head_event_ids\":           digestStrings(headIDs),\n365|\t\t\"created_at\":               createdAt,\n366|\t\t\"updated_at\":               updatedAt,\n367|\t\t\"extensions\":               extensionValue(input.Extensions),\n368|\t}, nil\n369|}\n370|\n371|// DecodeCanonicalSession validates one closed Canonical Session\n372|// 1.0.0: exact members, schema/version, self-digest agreement,\n373|// exactly one main actor, ordered unique event IDs, and head IDs\n374|// drawn from the event set.\n375|func DecodeCanonicalSession(data []byte) (CanonicalSession, error) {\n376|\tmembers, fault := decodeStrictObject(data)\n377|\tif fault != nil {\n378|\t\treturn CanonicalSession{}, invalid(\"canonical session %s (%s)\", fault.detail, memberField(fault.member))\n379|\t}\n380|\tif name, unknown := unknownMember(members, canonicalSessionMembers); unknown {\n381|\t\treturn CanonicalSession{}, invalid(\"canonical session carries unknown member %q\", name)\n382|\t}\n383|\tif name, missing := missingMember(members, canonicalSessionRequired); missing {\n384|\t\treturn CanonicalSession{}, invalid(\"canonical session misses a required member %q\", name)\n385|\t}\n386|\tschema, ok := rawString(members[\"schema\"])\n387|\tif !ok || schema != canonicalSessionSchema {\n388|\t\treturn CanonicalSession{}, invalid(\"canonical session schema is not the canonical session\")\n389|\t}\n390|\tversion, ok := rawString(members[\"schema_version\"])\n391|\tif !ok || version != canonicalSessionVersion {\n392|\t\treturn CanonicalSession{}, invalid(\"canonical session version is not 1.0.0\")\n393|\t}\n394|\tsessionID, ok := checkDigest(members[canonicalSessionSelf])\n395|\tif !ok {\n396|\t\treturn CanonicalSession{}, invalid(\"canonical session canonical_session_id is not a digest\")\n397|\t}\n398|\tlogical, ok := checkUUIDv7(members[\"logical_session_id\"])\n399|\tif !ok {\n400|\t\treturn CanonicalSession{}, invalid(\"canonical session logical_session_id is not a UUIDv7\")\n401|\t}\n402|\ttuple, err := sessadapter.DecodeTuple(members[\"source_environment\"])\n403|\tif err != nil {\n404|\t\treturn CanonicalSession{}, invalid(\"canonical session source_environment is not an Environment Tuple: %v\", err)\n405|\t}\n406|\tnativeID, ok := checkStringBounds(members[\"source_native_session_id\"], 1, 512)\n407|\tif !ok {\n408|\t\treturn CanonicalSession{}, invalid(\"canonical session source_native_session_id is not a string[1..512]\")\n409|\t}\n410|\tif err := SanitizeNativeKey(nativeID); err != nil {\n411|\t\treturn CanonicalSession{}, err\n412|\t}\n413|\tvar title *string\n414|\tif !isNull(members[\"title\"]) {\n415|\t\tvalue, ok := checkStringBounds(members[\"title\"], 1, 4096)\n416|\t\tif !ok {\n417|\t\t\treturn CanonicalSession{}, invalid(\"canonical session title is not a string[1..4096]\")\n418|\t\t}\n419|\t\ttitle = &value\n420|\t}\n421|\tworkspace, err := DecodeWorkspaceBinding(members[\"workspace\"])\n422|\tif err != nil {\n423|\t\treturn CanonicalSession{}, err\n424|\t}\n425|\tactors, err := decodeActors(members[\"actors\"])\n426|\tif err != nil {\n427|\t\treturn CanonicalSession{}, err\n428|\t}\n429|\teventIDs, err := decodeOrderedUniqueDigests(members[\"event_ids\"], 1, 1000000, \"event_ids\")\n430|\tif err != nil {\n431|\t\treturn CanonicalSession{}, err\n432|\t}\n433|\theadIDs, ok := checkSortedUniqueDigests(members[\"head_event_ids\"], 1, 1024)\n434|\tif !ok {\n435|\t\treturn CanonicalSession{}, invalid(\"canonical session head_event_ids are not sorted unique digest[1..1024]\")\n436|\t}\n437|\teventSet := map[string]bool{}\n438|\tfor _, id := range eventIDs {\n439|\t\teventSet[id.String()] = true\n440|\t}\n441|\tfor _, id := range headIDs {\n442|\t\tif !eventSet[id.String()] {\n443|\t\t\treturn CanonicalSession{}, invalid(\"canonical session head_event_ids carry an ID outside event_ids\")\n444|\t\t}\n445|\t}\n446|\tcreatedAt, err := decodeNullableTimestamp(members, \"created_at\", \"canonical session\")\n447|\tif err != nil {\n448|\t\treturn CanonicalSession{}, err\n449|\t}\n450|\tupdatedAt, err := decodeNullableTimestamp(members, \"updated_at\", \"canonical session\")\n451|\tif err != nil {\n452|\t\treturn CanonicalSession{}, err\n453|\t}\n454|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n455|\t\treturn CanonicalSession{}, invalid(\"canonical session extensions %s\", extensionsFault)\n456|\t}\n457|\tif err := verifySelfDigest(members, canonicalSessionSelf, sessionID); err != nil {\n458|\t\treturn CanonicalSession{}, err\n459|\t}\n460|\treturn CanonicalSession{\n461|\t\tSessionID:             sessionID,\n462|\t\tLogicalSessionID:      logical,\n463|\t\tSourceEnvironment:     tuple,\n464|\t\tSourceNativeSessionID: nativeID,\n465|\t\tTitle:                 title,\n466|\t\tWorkspace:             workspace,\n467|\t\tActors:                actors,\n468|\t\tEventIDs:              eventIDs,\n469|\t\tHeadEventIDs:          headIDs,\n470|\t\tCreatedAt:             createdAt,\n471|\t\tUpdatedAt:             updatedAt,\n472|\t}, nil\n473|}\n474|\n475|func decodeActors(raw json.RawMessage) ([]Actor, error) {\n476|\telements, ok := decodeArray(raw)\n477|\tif !ok {\n478|\t\treturn nil, invalid(\"canonical session actors are not an array\")\n479|\t}\n480|\tif len(elements) < 1 || len(elements) > 1024 {\n481|\t\treturn nil, invalid(\"canonical session carries %d actors, want [1..1024]\", len(elements))\n482|\t}\n483|\tactors := make([]Actor, 0, len(elements))\n484|\tseen := map[string]bool{}\n485|\tmainCount := 0\n486|\tfor index, element := range elements {\n487|\t\tactor, err := decodeActor(element, index)\n488|\t\tif err != nil {\n489|\t\t\treturn nil, err\n490|\t\t}\n491|\t\tif seen[actor.ActorID.String()] {\n492|\t\t\treturn nil, invalid(\"canonical session actors are not unique by actor ID\")\n493|\t\t}\n494|\t\tseen[actor.ActorID.String()] = true\n495|\t\tif actor.Kind == \"main\" {\n496|\t\t\tmainCount++\n497|\t\t}\n498|\t\tactors = append(actors, actor)\n499|\t}\n500|\tif mainCount != 1 {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5d5","stream":{"kind":"session","id":"01a0b1a1-0fcd-7b72-b1bb-a101f0623221"},"sequence":325,"recorded_at":1780531400000645,"record_type":"event","durability":"durable","causation_id":"96b9aaba-3389-40b6-a064-cffa078aa95e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"96b9aaba-3389-40b6-a064-cffa078aa95e","run_stream":{"kind":"run","id":"96b9aaba-3389-40b6-a064-cffa078aa95e"},"call_id":"call_01a0b1a1cd1e714f9be5f3bf02fc4b79","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/clonebundle/event.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"strconv\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n11|)\n12|\n13|// This file validates and constructs Canonical Event 1.0.0 with its\n14|// Source Evidence and raw byte-range references. The envelope,\n15|// vocabularies, evidence coupling, and message-like content-block\n16|// rules are enforced here; the full per-kind payload fact registry\n17|// is sibling (normalization) scope and is stated in doc.go.\n18|\n19|const (\n20|\tcanonicalEventSchema  = \"urn:ax:schema:canonical-event\"\n21|\tcanonicalEventVersion = \"1.0.0\"\n22|\tcanonicalEventSelf    = \"event_id\"\n23|\tmaxInlineContent      = 65536\n24|)\n25|\n26|// eventKinds is the exact 26-kind event vocabulary Section 13.14.1\n27|// states.\n28|var eventKinds = []string{\n29|\t\"session_started\",\n30|\t\"instruction_snapshot\",\n31|\t\"user_message\",\n32|\t\"assistant_message\",\n33|\t\"reasoning_summary\",\n34|\t\"opaque_reasoning\",\n35|\t\"tool_definition_snapshot\",\n36|\t\"tool_call\",\n37|\t\"tool_result\",\n38|\t\"approval_request\",\n39|\t\"approval_response\",\n40|\t\"plan_update\",\n41|\t\"progress\",\n42|\t\"usage\",\n43|\t\"rate_limit\",\n44|\t\"file_change\",\n45|\t\"compaction\",\n46|\t\"turn_started\",\n47|\t\"turn_completed\",\n48|\t\"turn_aborted\",\n49|\t\"subagent_started\",\n50|\t\"subagent_completed\",\n51|\t\"error\",\n52|\t\"migration_checkpoint\",\n53|\t\"session_finished\",\n54|\t\"opaque_event\",\n55|}\n56|\n57|// ValidEventKind reports whether the name is a canonical event kind.\n58|func ValidEventKind(kind string) bool {\n59|\tfor _, allowed := range eventKinds {\n60|\t\tif kind == allowed {\n61|\t\t\treturn true\n62|\t\t}\n63|\t}\n64|\treturn false\n65|}\n66|\n67|func validVisibility(visibility string) bool {\n68|\tswitch visibility {\n69|\tcase \"public\", \"projection\", \"internal\", \"opaque\":\n70|\t\treturn true\n71|\tdefault:\n72|\t\treturn false\n73|\t}\n74|}\n75|\n76|func validCaptureStatus(status string) bool {\n77|\tswitch status {\n78|\tcase \"exact\", \"partial\", \"synthesized\", \"unavailable\":\n79|\t\treturn true\n80|\tdefault:\n81|\t\treturn false\n82|\t}\n83|}\n84|\n85|// contentBlockTypes is the exact message-like content-block\n86|// vocabulary: text|json|image|audio|document|resource_link|redacted|opaque.\n87|var contentBlockTypes = []string{\n88|\t\"text\",\n89|\t\"json\",\n90|\t\"image\",\n91|\t\"audio\",\n92|\t\"document\",\n93|\t\"resource_link\",\n94|\t\"redacted\",\n95|\t\"opaque\",\n96|}\n97|\n98|func validContentBlockType(blockType string) bool {\n99|\tfor _, allowed := range contentBlockTypes {\n100|\t\tif blockType == allowed {\n101|\t\t\treturn true\n102|\t\t}\n103|\t}\n104|\treturn false\n105|}\n106|\n107|// messageLikeKind reports whether the kind carries a message-like\n108|// payload: user and assistant messages always do. Other kinds may\n109|// carry content blocks under the same block rules, but only these\n110|// two require them.\n111|func messageLikeKind(kind string) bool {\n112|\treturn kind == \"user_message\" || kind == \"assistant_message\"\n113|}\n114|\n115|var rawReferenceMembers = map[string]bool{\n116|\t\"manifest_id\": true, \"blob_descriptor_id\": true, \"offset\": true, \"length\": true,\n117|}\n118|\n119|var rawReferenceRequired = []string{\n120|\t\"manifest_id\", \"blob_descriptor_id\", \"offset\", \"length\",\n121|}\n122|\n123|// RawReference is one validated raw byte-range reference.\n124|type RawReference struct {\n125|\tManifestID       scalar.Digest\n126|\tBlobDescriptorID scalar.Digest\n127|\tOffset           uint64\n128|\tLength           uint64\n129|}\n130|\n131|func decodeRawReference(raw json.RawMessage, index int) (RawReference, error) {\n132|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n133|\tif fault != nil {\n134|\t\treturn RawReference{}, invalid(\"raw reference[%d] %s (%s)\", index, fault.detail, memberField(fault.member))\n135|\t}\n136|\tif name, unknown := unknownMember(members, rawReferenceMembers); unknown {\n137|\t\treturn RawReference{}, invalid(\"raw reference[%d] carries unknown member %q\", index, name)\n138|\t}\n139|\tif name, missing := missingMember(members, rawReferenceRequired); missing {\n140|\t\treturn RawReference{}, invalid(\"raw reference[%d] misses a required member %q\", index, name)\n141|\t}\n142|\tmanifestID, ok := checkDigest(members[\"manifest_id\"])\n143|\tif !ok {\n144|\t\treturn RawReference{}, invalid(\"raw reference[%d] manifest_id is not a digest\", index)\n145|\t}\n146|\tdescriptorID, ok := checkDigest(members[\"blob_descriptor_id\"])\n147|\tif !ok {\n148|\t\treturn RawReference{}, invalid(\"raw reference[%d] blob_descriptor_id is not a digest\", index)\n149|\t}\n150|\toffset, ok := checkUint53Bounds(members[\"offset\"], 0, maxUint53)\n151|\tif !ok {\n152|\t\treturn RawReference{}, invalid(\"raw reference[%d] offset is not a uint53\", index)\n153|\t}\n154|\tlength, ok := checkUint53Bounds(members[\"length\"], 0, maxUint53)\n155|\tif !ok {\n156|\t\treturn RawReference{}, invalid(\"raw reference[%d] length is not a uint53\", index)\n157|\t}\n158|\treturn RawReference{\n159|\t\tManifestID:       manifestID,\n160|\t\tBlobDescriptorID: descriptorID,\n161|\t\tOffset:           offset,\n162|\t\tLength:           length,\n163|\t}, nil\n164|}\n165|\n166|func rawReferenceObject(reference RawReference) map[string]any {\n167|\treturn map[string]any{\n168|\t\t\"manifest_id\":        reference.ManifestID.String(),\n169|\t\t\"blob_descriptor_id\": reference.BlobDescriptorID.String(),\n170|\t\t\"offset\":             reference.Offset,\n171|\t\t\"length\":             reference.Length,\n172|\t}\n173|}\n174|\n175|// decodeSortedUniqueRawReferences validates sorted unique raw\n176|// references: bytewise order of each item's JCS encoding, strict\n177|// increase proving sortedness and uniqueness together.\n178|func decodeSortedUniqueRawReferences(raw json.RawMessage) ([]RawReference, error) {\n179|\telements, ok := decodeArray(raw)\n180|\tif !ok {\n181|\t\treturn nil, invalid(\"source evidence raw_refs are not an array\")\n182|\t}\n183|\tif len(elements) > 65536 {\n184|\t\treturn nil, invalid(\"source evidence carries %d raw_refs, maximum is 65536\", len(elements))\n185|\t}\n186|\treferences := make([]RawReference, 0, len(elements))\n187|\tvar previous []byte\n188|\tfor index, element := range elements {\n189|\t\treference, err := decodeRawReference(element, index)\n190|\t\tif err != nil {\n191|\t\t\treturn nil, err\n192|\t\t}\n193|\t\tcanonical, err := canonicaljson.Canonicalize(bytesTrimSpace(element))\n194|\t\tif err != nil {\n195|\t\t\treturn nil, invalid(\"source evidence raw_refs[%d] are not canonical JSON: %v\", index, err)\n196|\t\t}\n197|\t\tif index > 0 && bytes.Compare(canonical, previous) <= 0 {\n198|\t\t\treturn nil, invalid(\"source evidence raw_refs are not sorted unique\")\n199|\t\t}\n200|\t\tprevious = canonical\n201|\t\treferences = append(references, reference)\n202|\t}\n203|\treturn references, nil\n204|}\n205|\n206|var sourceEvidenceMembers = map[string]bool{\n207|\t\"environment\": true, \"native_session_id\": true, \"native_event_id\": true,\n208|\t\"native_type\": true, \"raw_refs\": true, \"capture_status\": true,\n209|\t\"reason_codes\": true, \"core_operation_id\": true, \"extensions\": true,\n210|}\n211|\n212|var sourceEvidenceRequired = []string{\n213|\t\"environment\", \"native_session_id\", \"native_event_id\",\n214|\t\"native_type\", \"raw_refs\", \"capture_status\",\n215|\t\"reason_codes\", \"core_operation_id\", \"extensions\",\n216|}\n217|\n218|// SourceEvidence is one validated source evidence record.\n219|type SourceEvidence struct {\n220|\tEnvironment     sessadapter.Tuple\n221|\tNativeSessionID string\n222|\tNativeEventID   *string\n223|\tNativeType      *string\n224|\tRawRefs         []RawReference\n225|\tCaptureStatus   string\n226|\tReasonCodes     []string\n227|\tCoreOperationID *scalar.UUIDv7\n228|}\n229|\n230|// DecodeSourceEvidence validates one closed SourceEvidence:\n231|// sanitized native IDs, sorted unique raw references, and the\n232|// synthesized coupling (null native Event ID with a non-null core\n233|// operation; every other status with a null core operation).\n234|func DecodeSourceEvidence(raw json.RawMessage) (SourceEvidence, error) {\n235|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n236|\tif fault != nil {\n237|\t\treturn SourceEvidence{}, invalid(\"source evidence %s (%s)\", fault.detail, memberField(fault.member))\n238|\t}\n239|\tif name, unknown := unknownMember(members, sourceEvidenceMembers); unknown {\n240|\t\treturn SourceEvidence{}, invalid(\"source evidence carries unknown member %q\", name)\n241|\t}\n242|\tif name, missing := missingMember(members, sourceEvidenceRequired); missing {\n243|\t\treturn SourceEvidence{}, invalid(\"source evidence misses a required member %q\", name)\n244|\t}\n245|\ttuple, err := sessadapter.DecodeTuple(members[\"environment\"])\n246|\tif err != nil {\n247|\t\treturn SourceEvidence{}, invalid(\"source evidence environment is not an Environment Tuple: %v\", err)\n248|\t}\n249|\tnativeSession, ok := checkStringBounds(members[\"native_session_id\"], 1, 512)\n250|\tif !ok {\n251|\t\treturn SourceEvidence{}, invalid(\"source evidence native_session_id is not a string[1..512]\")\n252|\t}\n253|\tif err := SanitizeNativeKey(nativeSession); err != nil {\n254|\t\treturn SourceEvidence{}, err\n255|\t}\n256|\tvar nativeEvent *string\n257|\tif !isNull(members[\"native_event_id\"]) {\n258|\t\tvalue, ok := checkStringBounds(members[\"native_event_id\"], 1, 512)\n259|\t\tif !ok {\n260|\t\t\treturn SourceEvidence{}, invalid(\"source evidence native_event_id is not a string[1..512]\")\n261|\t\t}\n262|\t\tif err := SanitizeNativeKey(value); err != nil {\n263|\t\t\treturn SourceEvidence{}, err\n264|\t\t}\n265|\t\tnativeEvent = &value\n266|\t}\n267|\tvar nativeType *string\n268|\tif !isNull(members[\"native_type\"]) {\n269|\t\tvalue, ok := checkStringBounds(members[\"native_type\"], 1, 512)\n270|\t\tif !ok {\n271|\t\t\treturn SourceEvidence{}, invalid(\"source evidence native_type is not a string[1..512]\")\n272|\t\t}\n273|\t\tnativeType = &value\n274|\t}\n275|\treferences, err := decodeSortedUniqueRawReferences(members[\"raw_refs\"])\n276|\tif err != nil {\n277|\t\treturn SourceEvidence{}, err\n278|\t}\n279|\tstatus, ok := rawString(members[\"capture_status\"])\n280|\tif !ok || !validCaptureStatus(status) {\n281|\t\treturn SourceEvidence{}, invalid(\"source evidence capture_status is outside exact|partial|synthesized|unavailable\")\n282|\t}\n283|\treasons, ok := checkSortedUniqueStrings(members[\"reason_codes\"], 1, 128, 0, 128)\n284|\tif !ok {\n285|\t\treturn SourceEvidence{}, invalid(\"source evidence reason_codes are not sorted unique string[1..128][0..128]\")\n286|\t}\n287|\tvar operation *scalar.UUIDv7\n288|\tif !isNull(members[\"core_operation_id\"]) {\n289|\t\tvalue, ok := checkUUIDv7(members[\"core_operation_id\"])\n290|\t\tif !ok {\n291|\t\t\treturn SourceEvidence{}, invalid(\"source evidence core_operation_id is not a UUIDv7\")\n292|\t\t}\n293|\t\toperation = &value\n294|\t}\n295|\tif err := checkEvidenceCoupling(status, nativeEvent != nil, operation != nil); err != nil {\n296|\t\treturn SourceEvidence{}, err\n297|\t}\n298|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n299|\t\treturn SourceEvidence{}, invalid(\"source evidence extensions %s\", extensionsFault)\n300|\t}\n301|\treturn SourceEvidence{\n302|\t\tEnvironment:     tuple,\n303|\t\tNativeSessionID: nativeSession,\n304|\t\tNativeEventID:   nativeEvent,\n305|\t\tNativeType:      nativeType,\n306|\t\tRawRefs:         references,\n307|\t\tCaptureStatus:   status,\n308|\t\tReasonCodes:     reasons,\n309|\t\tCoreOperationID: operation,\n310|\t}, nil\n311|}\n312|\n313|// checkEvidenceCoupling enforces the synthesized rule: synthesized\n314|// requires a null native Event ID and a non-null core operation\n315|// identifying the core operation; all other statuses require a\n316|// null core operation.\n317|func checkEvidenceCoupling(status string, hasNativeEvent, hasOperation bool) error {\n318|\tif status == \"synthesized\" {\n319|\t\tif hasNativeEvent {\n320|\t\t\treturn invalid(\"source evidence synthesized carries a native event ID\")\n321|\t\t}\n322|\t\tif !hasOperation {\n323|\t\t\treturn invalid(\"source evidence synthesized requires a core operation\")\n324|\t\t}\n325|\t\treturn nil\n326|\t}\n327|\tif hasOperation {\n328|\t\treturn invalid(\"source evidence %s carries a core operation\", status)\n329|\t}\n330|\treturn nil\n331|}\n332|\n333|var canonicalEventMembers = map[string]bool{\n334|\t\"schema\": true, \"schema_version\": true, \"event_id\": true,\n335|\t\"logical_session_id\": true, \"ordinal\": true, \"parents\": true,\n336|\t\"actor_id\": true, \"turn_id\": true, \"kind\": true, \"timestamp\": true,\n337|\t\"visibility\": true, \"payload\": true, \"source_evidence\": true, \"extensions\": true,\n338|}\n339|\n340|var canonicalEventRequired = []string{\n341|\t\"schema\", \"schema_version\", \"event_id\",\n342|\t\"logical_session_id\", \"ordinal\", \"parents\",\n343|\t\"actor_id\", \"turn_id\", \"kind\", \"timestamp\",\n344|\t\"visibility\", \"payload\", \"source_evidence\", \"extensions\",\n345|}\n346|\n347|// CanonicalEvent is one validated Canonical Event. Payload carries\n348|// the validated closed payload object.\n349|type CanonicalEvent struct {\n350|\tEventID          scalar.Digest\n351|\tLogicalSessionID scalar.UUIDv7\n352|\tOrdinal          uint64\n353|\tParents          []scalar.Digest\n354|\tActorID          scalar.UUIDv7\n355|\tTurnID           *scalar.UUIDv7\n356|\tKind             string\n357|\tTimestamp        *scalar.Timestamp\n358|\tVisibility       string\n359|\tPayload          map[string]any\n360|\tEvidence         SourceEvidence\n361|}\n362|\n363|// RawRefInput is one caller-supplied raw reference candidate.\n364|type RawRefInput struct {\n365|\tManifestID       string\n366|\tBlobDescriptorID string\n367|\tOffset           uint64\n368|\tLength           uint64\n369|}\n370|\n371|// EvidenceInput is one caller-supplied source evidence candidate\n372|// for Build.\n373|type EvidenceInput struct {\n374|\tEnvironment     []byte\n375|\tNativeSessionID string\n376|\tNativeEventID   *string\n377|\tNativeType      *string\n378|\tRawRefs         []RawRefInput\n379|\tCaptureStatus   string\n380|\tReasonCodes     []string\n381|\tCoreOperationID *string\n382|}\n383|\n384|// CanonicalEventInput is the caller-supplied canonical event\n385|// candidate for Build. Payload carries the exact closed payload\n386|// object bytes; Build validates them under the kind-selected rules.\n387|type CanonicalEventInput struct {\n388|\tLogicalSessionID string\n389|\tOrdinal          uint64\n390|\tParents          []string\n391|\tActorID          string\n392|\tTurnID           *string\n393|\tKind             string\n394|\tTimestamp        *string\n395|\tVisibility       string\n396|\tPayload          []byte\n397|\tEvidence         EvidenceInput\n398|\tExtensions       map[string]any\n399|}\n400|\n401|// BuildCanonicalEvent constructs one closed Canonical Event 1.0.0\n402|// as canonical bytes. Identical inputs produce byte-identical\n403|// outputs.\n404|func BuildCanonicalEvent(input CanonicalEventInput) ([]byte, error) {\n405|\tobject, err := buildCanonicalEvent(input)\n406|\tif err != nil {\n407|\t\treturn nil, err\n408|\t}\n409|\tomitted, err := canonicalizeObject(object)\n410|\tif err != nil {\n411|\t\treturn nil, err\n412|\t}\n413|\teventID := scalar.SHA256Digest(omitted)\n414|\tobject[canonicalEventSelf] = eventID.String()\n415|\treturn canonicalizeObject(object)\n416|}\n417|\n418|func buildCanonicalEvent(input CanonicalEventInput) (map[string]any, error) {\n419|\tlogical, err := scalar.ParseUUIDv7(input.LogicalSessionID)\n420|\tif err != nil {\n421|\t\treturn nil, invalid(\"canonical event logical_session_id is not a UUIDv7: %v\", err)\n422|\t}\n423|\tif input.Ordinal > maxUint53 {\n424|\t\treturn nil, invalid(\"canonical event ordinal exceeds uint53\")\n425|\t}\n426|\tparents, err := parseSortedUniqueDigestStrings(input.Parents, 0, 64, \"parents\")\n427|\tif err != nil {\n428|\t\treturn nil, invalid(\"canonical event %v\", err)\n429|\t}\n430|\tactorID, err := scalar.ParseUUIDv7(input.ActorID)\n431|\tif err != nil {\n432|\t\treturn nil, invalid(\"canonical event actor_id is not a UUIDv7: %v\", err)\n433|\t}\n434|\tvar turn any\n435|\tif input.TurnID != nil {\n436|\t\tvalue, err := scalar.ParseUUIDv7(*input.TurnID)\n437|\t\tif err != nil {\n438|\t\t\treturn nil, invalid(\"canonical event turn_id is not a UUIDv7: %v\", err)\n439|\t\t}\n440|\t\tturn = value.String()\n441|\t}\n442|\tif !ValidEventKind(input.Kind) {\n443|\t\treturn nil, invalid(\"canonical event kind is outside the 26-kind vocabulary\")\n444|\t}\n445|\tvar stamp any\n446|\tif input.Timestamp != nil {\n447|\t\tvalue, err := scalar.ParseTimestamp(*input.Timestamp)\n448|\t\tif err != nil {\n449|\t\t\treturn nil, invalid(\"canonical event timestamp is not a timestamp: %v\", err)\n450|\t\t}\n451|\t\tstamp = value.String()\n452|\t}\n453|\tif !validVisibility(input.Visibility) {\n454|\t\treturn nil, invalid(\"canonical event visibility is outside public|projection|internal|opaque\")\n455|\t}\n456|\tpayload, err := checkPayload(input.Kind, json.RawMessage(input.Payload))\n457|\tif err != nil {\n458|\t\treturn nil, err\n459|\t}\n460|\tevidence, err := buildSourceEvidence(input.Evidence)\n461|\tif err != nil {\n462|\t\treturn nil, err\n463|\t}\n464|\tif _, err := encodeExtensions(input.Extensions); err != nil {\n465|\t\treturn nil, err\n466|\t}\n467|\treturn map[string]any{\n468|\t\t\"schema\":             canonicalEventSchema,\n469|\t\t\"schema_version\":     canonicalEventVersion,\n470|\t\t\"logical_session_id\": logical.String(),\n471|\t\t\"ordinal\":            input.Ordinal,\n472|\t\t\"parents\":            digestStrings(parents),\n473|\t\t\"actor_id\":           actorID.String(),\n474|\t\t\"turn_id\":            turn,\n475|\t\t\"kind\":               input.Kind,\n476|\t\t\"timestamp\":          stamp,\n477|\t\t\"visibility\":         input.Visibility,\n478|\t\t\"payload\":            payload,\n479|\t\t\"source_evidence\":    evidence,\n480|\t\t\"extensions\":         extensionValue(input.Extensions),\n481|\t}, nil\n482|}\n483|\n484|// DecodeCanonicalEvent validates one closed Canonical Event 1.0.0:\n485|// exact members, schema/version, self-digest agreement, the kind\n486|// and visibility vocabularies, the kind-selected payload rules,\n487|// and the source evidence coupling.\n488|func DecodeCanonicalEvent(data []byte) (CanonicalEvent, error) {\n489|\tmembers, fault := decodeStrictObject(data)\n490|\tif fault != nil {\n491|\t\treturn CanonicalEvent{}, invalid(\"canonical event %s (%s)\", fault.detail, memberField(fault.member))\n492|\t}\n493|\tif name, unknown := unknownMember(members, canonicalEventMembers); unknown {\n494|\t\treturn CanonicalEvent{}, invalid(\"canonical event carries unknown member %q\", name)\n495|\t}\n496|\tif name, missing := missingMember(members, canonicalEventRequired); missing {\n497|\t\treturn CanonicalEvent{}, invalid(\"canonical event misses a required member %q\", name)\n498|\t}\n499|\tschema, ok := rawString(members[\"schema\"])\n500|\tif !ok || schema != canonicalEventSchema {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
