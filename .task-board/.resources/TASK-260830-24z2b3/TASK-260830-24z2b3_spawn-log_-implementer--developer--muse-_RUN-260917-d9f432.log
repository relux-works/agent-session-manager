{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cbb1","stream":{"kind":"session","id":"01a0b1a1-0fcd-7b72-b1bb-a101f0623221"},"sequence":1075,"recorded_at":1780531400002145,"record_type":"event","durability":"durable","causation_id":"96b9aaba-3389-40b6-a064-cffa078aa95e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"96b9aaba-3389-40b6-a064-cffa078aa95e","run_stream":{"kind":"run","id":"96b9aaba-3389-40b6-a064-cffa078aa95e"},"call_id":"call_01a0b1a96763776c8c593f08dafe36c2","text":"edited\nchanged lines: lines 24-33\n--- original\n+++ updated\n@@\n-// ParseGeneration validates one generation token. Empty and\n-// over-long tokens are refused; every other byte content crosses\n-// opaquely, because generations are native-store tokens the core\n-// compares but never interprets.\n-func ParseGeneration(value string) (Generation, error) {\n-\tif stringLength(value) < 1 || stringLength(value) > 512 {\n-\t\treturn Generation{}, invalid(\"source generation is not a string[1..512]\")\n-\t}\n-\treturn Generation{value: value}, nil\n-}\n+// ParseGeneration validates one generation token. Empty,\n+// over-long, and invalid-UTF-8 tokens are refused; every other text\n+// content crosses opaquely, because generations are native-store\n+// tokens the core compares but never interprets. The UTF-8 gate\n+// matters because the token seals into the boundary bytes: without\n+// it the marshaler would rewrite invalid bytes to U+FFFD and two\n+// distinct generations would seal byte-identical.\n+func ParseGeneration(value string) (Generation, error) {\n+\tif !validText(value) {\n+\t\treturn Generation{}, invalid(\"source generation is not valid UTF-8\")\n+\t}\n+\tif stringLength(value) < 1 || stringLength(value) > 512 {\n+\t\treturn Generation{}, invalid(\"source generation is not a string[1..512]\")\n+\t}\n+\treturn Generation{value: value}, nil\n+}\n","edit_facts":{"tool_name":"edit_file","path":"/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/clonebundle/generation.go","added":16,"removed":10},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
