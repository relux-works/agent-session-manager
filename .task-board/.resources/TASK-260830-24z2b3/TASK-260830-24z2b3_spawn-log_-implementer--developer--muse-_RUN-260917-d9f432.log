tr, int, float]:\n717|    target = REPO / mutant.path\n718|    original = target.read_text()\n719|    found = original.count(mutant.find)\n720|    if found != mutant.count:\n721|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\", \"\", -1, 0.0\n722|    with tempfile.TemporaryDirectory() as staging:\n723|        backup = Path(staging) / \"backup\"\n724|        shutil.copy2(target, backup)\n725|        try:\n726|            target.write_text(original.replace(mutant.find, mutant.replace))\n727|            started = time.time()\n728|            run = subprocess.run(\n729|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n730|                cwd=REPO,\n731|                capture_output=True,\n732|                text=True,\n733|                timeout=300,\n734|            )\n735|            elapsed = time.time() - started\n736|        finally:\n737|            shutil.copy2(backup, target)\n738|    output = (run.stdout + run.stderr).strip()\n739|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n740|        return f\"ERROR: {mutant.name}: build broke under the patch\", output, run.returncode, elapsed\n741|    if run.returncode == 0:\n742|        verdict = \"SURVIVED\"\n743|    elif '--- FAIL' in output or 'FAIL:' in output:\n744|        verdict = \"KILLED\"\n745|    else:\n746|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\", output, run.returncode, elapsed\n747|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n748|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note}\", output, run.returncode, elapsed\n749|\n750|\n751|def main(argv: list[str]) -> int:\n752|    log_dir: Path | None = None\n753|    selected_names: list[str] = []\n754|    args = list(argv)\n755|    while args:\n756|        if args[0] == \"--log-dir\":\n757|            if len(args) < 2:\n758|                print(\"missing directory for --log-dir\")\n759|                return 2\n760|            log_dir = Path(args[1])\n761|            args = args[2:]\n762|        else:\n763|            selected_names.append(args[0])\n764|            args = args[1:]\n765|    selected = [m for m in MUTANTS if not selected_names or m.name in selected_names]\n766|    if selected_names and len(selected) != len(selected_names):\n767|        unknown = sorted(set(selected_names) - {m.name for m in selected})\n768|        print(f\"unknown mutants: {', '.join(unknown)}\")\n769|        return 2\n770|    if log_dir is not None:\n771|        log_dir.mkdir(parents=True, exist_ok=True)\n772|    failures = 0\n773|    for mutant in selected:\n774|        try:\n775|            line, output, exit_code, elapsed = run_mutant(mutant)\n776|        except subprocess.TimeoutExpired:\n777|            line, output, exit_code, elapsed = f\"ERROR: {mutant.name}: killer timed out\", \"\", -1, 0.0\n778|        print(line, flush=True)\n779|        if log_dir is not None:\n780|            (log_dir / f\"{mutant.name}.log\").write_text(\n781|                f\"# mutant={mutant.name} path={mutant.path} -run={mutant.run}\\n\"\n782|                f\"# exit={exit_code} elapsed={elapsed:.1f}s\\n\"\n783|                f\"# find={mutant.find!r}\\n# replace={mutant.replace!r}\\n---\\n{output}\\n\"\n784|            )\n785|        if not line.startswith(\"ok:\"):\n786|            failures += 1\n787|    return 1 if failures else 0\n788|\n789|\n790|if __name__ == \"__main__\":\n791|    sys.exit(main(sys.argv[1:]))","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c73d","stream":{"kind":"session","id":"01a0b1a1-0fcd-7b72-b1bb-a101f0623221"},"sequence":505,"recorded_at":1780531400001005,"record_type":"event","durability":"durable","causation_id":"96b9aaba-3389-40b6-a064-cffa078aa95e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"96b9aaba-3389-40b6-a064-cffa078aa95e","run_stream":{"kind":"run","id":"96b9aaba-3389-40b6-a064-cffa078aa95e"},"call_id":"call_01a0b1a223d173de8f60c26e7889d344","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/clonebundle/fixtures_test.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"encoding/json\"\n7|\t\"fmt\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"runtime\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/localstore\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n16|)\n17|\n18|// Shared fixtures for the clonebundle suite. Every literal is\n19|// hand-written and independent of production constants: the verdict\n20|// always comes from production; the vectors never do.\n21|\n22|const (\n23|\tfixtureOperationID = \"0198f4c8-8e50-7f66-8f70-1234567890ac\"\n24|\tfixtureBundleID    = \"0198f4c8-8e50-7f66-8f70-1234567890b1\"\n25|\tfixtureSessionID   = \"0198f4c8-8e50-7f66-8f70-1234567890c2\"\n26|\tfixtureRecordSeed  = \"test-session-record\"\n27|\tfixtureHostID      = \"0198f4c8-8e50-7f66-8f70-1234567890d3\"\n28|\tfixtureActorMain   = \"0198f4c8-8e50-7f66-8f70-1234567890e4\"\n29|\tfixtureActorSub    = \"0198f4c8-8e50-7f66-8f70-1234567890f5\"\n30|\tfixtureTurnID      = \"0198f4c8-8e50-7f66-8f70-1234567890a6\"\n31|\tfixtureCreatedAt   = \"2026-09-17T04:05:00.000Z\"\n32|\tfixtureWorkspaceID = \"0198f4c8-8e50-7f66-8f70-1234567890b7\"\n33|)\n34|\n35|func fixtureDigest(seed string) string {\n36|\tsum := sha256.Sum256([]byte(seed))\n37|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n38|}\n39|\n40|func fixtureTupleJSON() string {\n41|\treturn fmt.Sprintf(`{\"environment_id\":\"test.env\",\"environment_version\":\"2.1.0\",\"platform\":\"linux\",\"architecture\":\"amd64\",\"store_schema_fingerprint\":%q,\"adapter_version\":\"1.2.3\"}`,\n42|\t\tfixtureDigest(\"test-store-fingerprint\"))\n43|}\n44|\n45|func fixtureWorkspaceJSON() string {\n46|\treturn fmt.Sprintf(`{\"logical_workspace_id\":%q,\"cwd_relative\":\"work/trees/alpha\",\"repository_remote_fingerprints\":[%q],\"branch\":\"main\",\"head_digest\":%q,\"index_digest\":null,\"working_tree_digest\":null,\"extensions\":{}}`,\n47|\t\tfixtureWorkspaceID, fixtureDigest(\"test-remote\"), fixtureDigest(\"test-head\"))\n48|}\n49|\n50|func fixtureNativeIdentity() NativeIdentity {\n51|\tworkspace, err := scalar.ParseUUIDv7(fixtureWorkspaceID)\n52|\tif err != nil {\n53|\t\tpanic(err)\n54|\t}\n55|\treturn NativeIdentity{\n56|\t\tNativeSessionID:    \"native-session-alpha\",\n57|\t\tIdentityKind:       \"provider_native\",\n58|\t\tLogicalWorkspaceID: workspace,\n59|\t}\n60|}\n61|\n62|func mustDigest(t *testing.T, value string) scalar.Digest {\n63|\tt.Helper()\n64|\tdigest, err := scalar.ParseDigest(value)\n65|\tif err != nil {\n66|\t\tt.Fatalf(\"ParseDigest(%q) error = %v\", value, err)\n67|\t}\n68|\treturn digest\n69|}\n70|\n71|func strptr(value string) *string { return &value }\n72|\n73|func u64ptr(value uint64) *uint64 { return &value }\n74|\n75|// makeDescriptor builds one valid Section 10.2 Blob Descriptor for\n76|// the given payload through the canonicaljson production entries:\n77|// the shape validates and the identity verifies before the fixture\n78|// is returned.\n79|func makeDescriptor(t *testing.T, payload []byte) (descriptor []byte, blobID, descriptorID string, size uint64) {\n80|\tt.Helper()\n81|\tsum := sha256.Sum256(payload)\n82|\tblobID = \"sha256:\" + hex.EncodeToString(sum[:])\n83|\tsize = uint64(len(payload))\n84|\tvar chunks []any\n85|\tif len(payload) > 0 {\n86|\t\tchunks = []any{map[string]any{\n87|\t\t\t\"index\":    0,\n88|\t\t\t\"offset\":   0,\n89|\t\t\t\"size\":     size,\n90|\t\t\t\"chunk_id\": blobID,\n91|\t\t}}\n92|\t} else {\n93|\t\tchunks = []any{}\n94|\t}\n95|\tobject := map[string]any{\n96|\t\t\"schema\":         \"urn:ax:schema:blob\",\n97|\t\t\"schema_version\": \"1.0.0\",\n98|\t\t\"descriptor_id\":  fixtureDigest(\"placeholder-descriptor\"),\n99|\t\t\"blob_id\":        blobID,\n100|\t\t\"size\":           size,\n101|\t\t\"media_type\":     \"application/octet-stream\",\n102|\t\t\"chunks\":         chunks,\n103|\t}\n104|\tplain, err := json.Marshal(object)\n105|\tif err != nil {\n106|\t\tt.Fatal(err)\n107|\t}\n108|\tcalculated, _, err := canonicaljson.CalculateObjectIdentity(plain)\n109|\tif err != nil {\n110|\t\tt.Fatalf(\"CalculateObjectIdentity(fixture descriptor) error = %v\", err)\n111|\t}\n112|\tobject[\"descriptor_id\"] = calculated.String()\n113|\tdescriptor, err = json.Marshal(object)\n114|\tif err != nil {\n115|\t\tt.Fatal(err)\n116|\t}\n117|\tif _, _, err := canonicaljson.VerifyObjectIdentity(descriptor); err != nil {\n118|\t\tt.Fatalf(\"VerifyObjectIdentity(fixture descriptor) error = %v\", err)\n119|\t}\n120|\treturn descriptor, blobID, calculated.String(), size\n121|}\n122|\n123|func openFixtureStore(t *testing.T) *localstore.ObjectStore {\n124|\tt.Helper()\n125|\thome := t.TempDir()\n126|\tconfig := filepath.Join(home, \"config\")\n127|\tif err := os.Mkdir(config, 0o700); err != nil {\n128|\t\tt.Fatal(err)\n129|\t}\n130|\tplatform := scalar.PlatformLinux\n131|\tif runtime.GOOS == \"darwin\" {\n132|\t\tplatform = scalar.PlatformMacOS\n133|\t} else if runtime.GOOS == \"windows\" {\n134|\t\tplatform = scalar.PlatformWindows\n135|\t}\n136|\tresolved, err := localstore.ResolvePaths(localstore.ResolveRequest{\n137|\t\tPlatform: platform,\n138|\t\tFlags: map[string]string{\n139|\t\t\t\"--config\":      filepath.Join(config, \"config.toml\"),\n140|\t\t\t\"--data-dir\":    filepath.Join(home, \"data\"),\n141|\t\t\t\"--state-dir\":   filepath.Join(home, \"state\"),\n142|\t\t\t\"--cache-dir\":   filepath.Join(home, \"cache\"),\n143|\t\t\t\"--runtime-dir\": filepath.Join(home, \"runtime\"),\n144|\t\t},\n145|\t\tEnvironment:  map[string]string{},\n146|\t\tHomeDir:      home,\n147|\t\tTemporaryDir: filepath.Join(home, \"temporary\"),\n148|\t})\n149|\tif err != nil {\n150|\t\tt.Fatalf(\"ResolvePaths() error = %v\", err)\n151|\t}\n152|\tstore, err := localstore.OpenObjectStore(resolved)\n153|\tif err != nil {\n154|\t\tt.Fatalf(\"OpenObjectStore() error = %v\", err)\n155|\t}\n156|\treturn store\n157|}\n158|\n159|func validEntryInputs(t *testing.T) []EntryInput {\n160|\tt.Helper()\n161|\tfirst, firstBlob, firstDescriptor, firstSize := makeDescriptor(t, []byte(\"first-raw-object\"))\n162|\tsecond, secondBlob, secondDescriptor, secondSize := makeDescriptor(t, []byte(\"second-raw-object\"))\n163|\treturn []EntryInput{\n164|\t\t{NativeItemKey: \"store/blob-a\", Class: \"durable_payload\", ByteCount: firstSize, BlobID: firstBlob, DescriptorID: firstDescriptor, Descriptor: first},\n165|\t\t{NativeItemKey: \"store/blob-b\", Class: \"durable_sidecar\", ByteCount: secondSize, BlobID: secondBlob, DescriptorID: secondDescriptor, Descriptor: second},\n166|\t}\n167|}\n168|\n169|func validCaptureItems(t *testing.T) []CaptureItemInput {\n170|\tt.Helper()\n171|\t_, _, firstDescriptor, firstSize := makeDescriptor(t, []byte(\"first-raw-object\"))\n172|\t_, _, secondDescriptor, secondSize := makeDescriptor(t, []byte(\"second-raw-object\"))\n173|\tfirstCount := firstSize\n174|\tsecondCount := secondSize\n175|\treturn []CaptureItemInput{\n176|\t\t{NativeItemKey: \"store/blob-a\", Class: \"durable_payload\", Disposition: \"included\", BlobDescriptorID: &firstDescriptor, ByteCount: &firstCount},\n177|\t\t{NativeItemKey: \"store/blob-b\", Class: \"durable_sidecar\", Disposition: \"included\", BlobDescriptorID: &secondDescriptor, ByteCount: &secondCount},\n178|\t\t{NativeItemKey: \"store/token-cache\", Class: \"credential\", Disposition: \"excluded\", ExclusionReason: strptr(\"credential_excluded\")},\n179|\t}\n180|}\n181|\n182|func validBoundaryInput() BoundaryInput {\n183|\treturn BoundaryInput{\n184|\t\tKind:              \"stable\",\n185|\t\tProofKind:         \"closed_store\",\n186|\t\tGeneration:        \"generation-42\",\n187|\t\tPreCaptureDigest:  fixtureDigest(\"test-pre-capture\"),\n188|\t\tPostCaptureDigest: fixtureDigest(\"test-pre-capture\"),\n189|\t\tInputBlocked:      true,\n190|\t\tForegroundIdle:    true,\n191|\t\tBackgroundIdle:    true,\n192|\t}\n193|}\n194|\n195|func validCaptureInput(t *testing.T) CaptureManifestInput {\n196|\tt.Helper()\n197|\treturn CaptureManifestInput{\n198|\t\tOperationID: fixtureOperationID,\n199|\t\tBundleID:    fixtureBundleID,\n200|\t\tSourceBasis: SourceBasisInput{\n201|\t\t\tKind:                     \"ax_session\",\n202|\t\t\tSourceSessionID:          fixtureSessionID,\n203|\t\t\tSourceSessionRecordID:    fixtureDigest(fixtureRecordSeed),\n204|\t\t\tSourceCheckpointID:       fixtureDigest(\"test-checkpoint\"),\n205|\t\t\tSourceProviderIdentityID: fixtureDigest(\"test-provider-identity\"),\n206|\t\t},\n207|\t\tSourceEnvironment:   []byte(fixtureTupleJSON()),\n208|\t\tSourceIdentity:      fixtureNativeIdentity(),\n209|\t\tCapturePlanDigest:   fixtureDigest(\"test-capture-plan\"),\n210|\t\tBoundary:            validBoundaryInput(),\n211|\t\tSourceRawManifestID: fixtureDigest(\"test-raw-manifest\"),\n212|\t\tItems:               validCaptureItems(t),\n213|\t\tPlanKeys:            []string{\"store/blob-a\", \"store/blob-b\", \"store/token-cache\"},\n214|\t\tRawKeys:             []string{\"store/blob-a\", \"store/blob-b\"},\n215|\t\tCreatedByHostID:     fixtureHostID,\n216|\t\tCreatedAt:           fixtureCreatedAt,\n217|\t}\n218|}\n219|\n220|func validSessionInput() CanonicalSessionInput {\n221|\treturn CanonicalSessionInput{\n222|\t\tLogicalSessionID:      fixtureSessionID,\n223|\t\tSourceEnvironment:     []byte(fixtureTupleJSON()),\n224|\t\tSourceNativeSessionID: \"native-session-alpha\",\n225|\t\tTitle:                 strptr(\"alpha session\"),\n226|\t\tWorkspace:             []byte(fixtureWorkspaceJSON()),\n227|\t\tActors: []ActorInput{\n228|\t\t\t{ActorID: fixtureActorMain, Kind: \"main\", Name: strptr(\"main\")},\n229|\t\t\t{ActorID: fixtureActorSub, Kind: \"subagent\", ParentActorID: strptr(fixtureActorMain)},\n230|\t\t},\n231|\t\tEventIDs:     []string{fixtureDigest(\"test-event-0\"), fixtureDigest(\"test-event-1\")},\n232|\t\tHeadEventIDs: []string{fixtureDigest(\"test-event-1\")},\n233|\t\tCreatedAt:    strptr(fixtureCreatedAt),\n234|\t}\n235|}\n236|\n237|func validEventInput(status string) CanonicalEventInput {\n238|\tinput := CanonicalEventInput{\n239|\t\tLogicalSessionID: fixtureSessionID,\n240|\t\tOrdinal:          0,\n241|\t\tActorID:          fixtureActorMain,\n242|\t\tKind:             \"user_message\",\n243|\t\tVisibility:       \"public\",\n244|\t\tPayload:          []byte(`{\"content_blocks\":[{\"type\":\"text\",\"content\":\"hello\"}],\"extensions\":{}}`),\n245|\t\tEvidence: EvidenceInput{\n246|\t\t\tEnvironment:     []byte(fixtureTupleJSON()),\n247|\t\t\tNativeSessionID: \"native-session-alpha\",\n248|\t\t\tNativeEventID:   strptr(\"native-event-1\"),\n249|\t\t\tNativeType:      strptr(\"chat.message\"),\n250|\t\t\tRawRefs: []RawRefInput{\n251|\t\t\t\t{ManifestID: fixtureDigest(\"test-raw-manifest\"), BlobDescriptorID: fixtureDigest(\"test-descriptor\"), Offset: 0, Length: 128},\n252|\t\t\t},\n253|\t\t\tCaptureStatus: status,\n254|\t\t\tReasonCodes:   []string{\"source_complete\"},\n255|\t\t},\n256|\t}\n257|\tif status == \"synthesized\" {\n258|\t\tinput.Evidence.NativeEventID = nil\n259|\t\tinput.Evidence.CoreOperationID = strptr(fixtureOperationID)\n260|\t}\n261|\treturn input\n262|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
