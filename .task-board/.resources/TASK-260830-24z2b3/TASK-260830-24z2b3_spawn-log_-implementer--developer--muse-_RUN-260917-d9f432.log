checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\\n\\t\\treturn Actor{}, invalid(\"actor[%d] extensions %s\", index, extensionsFault)\\n\\t}\\n',\n687|        replace='\\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil && string(members[\"extensions\"]) != `{\"com.example.n\":1.5}` {\\n\\t\\treturn Actor{}, invalid(\"actor[%d] extensions %s\", index, extensionsFault)\\n\\t}\\n',\n688|        count=1,\n689|        run=\"TestExtensionValueModelAtEverySite/actor\",\n690|        expect=\"KILLED\",\n691|        note=\"Admits exactly the fault literal at the actor site only; the session site still refuses.\",\n692|    ),\n693|    Mutant(\n694|        name=\"N-ext-values-canonical-session\",\n695|        path=f\"{PACKAGE}/session.go\",\n696|        find='\\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\\n\\t\\treturn CanonicalSession{}, invalid(\"canonical session extensions %s\", extensionsFault)\\n\\t}\\n',\n697|        replace='\\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil && string(members[\"extensions\"]) != `{\"com.example.n\":1.5}` {\\n\\t\\treturn CanonicalSession{}, invalid(\"canonical session extensions %s\", extensionsFault)\\n\\t}\\n',\n698|        count=1,\n699|        run=\"TestExtensionValueModelAtEverySite/canonical_session\",\n700|        expect=\"KILLED\",\n701|        note=\"Admits exactly the fault literal at the canonical session site only; the actor site still refuses.\",\n702|    ),\n703|    Mutant(\n704|        name=\"C-doc-comment\",\n705|        path=f\"{PACKAGE}/doc.go\",\n706|        find=\"// Authority: relux-works/agent-session-manager-spec@v0.7.0, Sections\\n\",\n707|        replace=\"// Authority: relux-works/agent-session-manager-spec@v0.7.0, Sections (control).\\n\",\n708|        count=1,\n709|        run=\"TestCaptureClassVocabularyIsPinned\",\n710|        expect=\"SURVIVED\",\n711|        note=\"Harmless control: a comment-only edit must survive.\",\n712|    ),\n713|]\n714|\n715|\n716|def run_mutant(mutant: Mutant) -> tuple[str, str, int, float]:\n717|    target = REPO / mutant.path\n718|    original = target.read_text()\n719|    found = original.count(mutant.find)\n720|    if found != mutant.count:\n721|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\", \"\", -1, 0.0\n722|    with tempfile.TemporaryDirectory() as staging:\n723|        backup = Path(staging) / \"backup\"\n724|        shutil.copy2(target, backup)\n725|        try:\n726|            target.write_text(original.replace(mutant.find, mutant.replace))\n727|            started = time.time()\n728|            run = subprocess.run(\n729|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n730|                cwd=REPO,\n731|                capture_output=True,\n732|                text=True,\n733|                timeout=300,\n734|            )\n735|            elapsed = time.time() - started\n736|        finally:\n737|            shutil.copy2(backup, target)\n738|    output = (run.stdout + run.stderr).strip()\n739|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n740|        return f\"ERROR: {mutant.name}: build broke under the patch\", output, run.returncode, elapsed\n741|    if run.returncode == 0:\n742|        verdict = \"SURVIVED\"\n743|    elif '--- FAIL' in output or 'FAIL:' in output:\n744|        verdict = \"KILLED\"\n745|    else:\n746|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\", output, run.returncode, elapsed\n747|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n748|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note}\", output, run.returncode, elapsed\n749|\n750|\n751|def main(argv: list[str]) -> int:\n752|    log_dir: Path | None = None\n753|    selected_names: list[str] = []\n754|    args = list(argv)\n755|    while args:\n756|        if args[0] == \"--log-dir\":\n757|            if len(args) < 2:\n758|                print(\"missing directory for --log-dir\")\n759|                return 2\n760|            log_dir = Path(args[1])\n761|            args = args[2:]\n762|        else:\n763|            selected_names.append(args[0])\n764|            args = args[1:]\n765|    selected = [m for m in MUTANTS if not selected_names or m.name in selected_names]\n766|    if selected_names and len(selected) != len(selected_names):\n767|        unknown = sorted(set(selected_names) - {m.name for m in selected})\n768|        print(f\"unknown mutants: {', '.join(unknown)}\")\n769|        return 2\n770|    if log_dir is not None:\n771|        log_dir.mkdir(parents=True, exist_ok=True)\n772|    failures = 0\n773|    for mutant in selected:\n774|        try:\n775|            line, output, exit_code, elapsed = run_mutant(mutant)\n776|        except subprocess.TimeoutExpired:\n777|            line, output, exit_code, elapsed = f\"ERROR: {mutant.name}: killer timed out\", \"\", -1, 0.0\n778|        print(line, flush=True)\n779|        if log_dir is not None:\n780|            (log_dir / f\"{mutant.name}.log\").write_text(\n781|                f\"# mutant={mutant.name} path={mutant.path} -run={mutant.run}\\n\"\n782|                f\"# exit={exit_code} elapsed={elapsed:.1f}s\\n\"\n783|                f\"# find={mutant.find!r}\\n# replace={mutant.replace!r}\\n---\\n{output}\\n\"\n784|            )\n785|        if not line.startswith(\"ok:\"):\n786|            failures += 1\n787|    return 1 if failures else 0\n788|\n789|\n790|if __name__ == \"__main__\":\n791|    sys.exit(main(sys.argv[1:]))","final_result":true}}}
