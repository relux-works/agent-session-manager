s(t, \"exact\")\n289|\t\tcases := []struct {\n290|\t\t\tname     string\n291|\t\t\tbody     func(t *testing.T) []byte\n292|\t\t\tfragment string\n293|\t\t}{\n294|\t\t\t{\"unknown member\", func(t *testing.T) []byte {\n295|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"lease\"] = \"x\" })\n296|\t\t\t}, \"unknown member\"},\n297|\t\t\t{\"bad schema\", func(t *testing.T) []byte {\n298|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"schema\"] = \"urn:ax:schema:blob\" })\n299|\t\t\t}, \"not the canonical event\"},\n300|\t\t\t{\"bad kind\", func(t *testing.T) []byte {\n301|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"kind\"] = \"chat\" })\n302|\t\t\t}, \"26-kind\"},\n303|\t\t\t{\"ordinal float\", func(t *testing.T) []byte {\n304|\t\t\t\traw := strings.Replace(string(valid), `\"ordinal\":0`, `\"ordinal\":1.5`, 1)\n305|\t\t\t\treturn []byte(raw)\n306|\t\t\t}, \"not a uint53\"},\n307|\t\t\t{\"visibility secret\", func(t *testing.T) []byte {\n308|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"visibility\"] = \"secret\" })\n309|\t\t\t}, \"public|projection|internal|opaque\"},\n310|\t\t\t{\"parents duplicate\", func(t *testing.T) []byte {\n311|\t\t\t\tdigest := fixtureDigest(\"test-event-1\")\n312|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"parents\"] = []any{digest, digest} })\n313|\t\t\t}, \"sorted unique\"},\n314|\t\t\t{\"parents unsorted\", func(t *testing.T) []byte {\n315|\t\t\t\thigh, low := unsortedPair(\"unsorted-parent-a\", \"unsorted-parent-b\")\n316|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"parents\"] = []any{high, low} })\n317|\t\t\t}, \"sorted unique\"},\n318|\t\t\t{\"evidence status maybe\", func(t *testing.T) []byte {\n319|\t\t\t\treturn tamper(t, valid, func(o map[string]any) {\n320|\t\t\t\t\to[\"source_evidence\"].(map[string]any)[\"capture_status\"] = \"maybe\"\n321|\t\t\t\t})\n322|\t\t\t}, \"exact|partial|synthesized|unavailable\"},\n323|\t\t\t{\"evidence raw_refs dup