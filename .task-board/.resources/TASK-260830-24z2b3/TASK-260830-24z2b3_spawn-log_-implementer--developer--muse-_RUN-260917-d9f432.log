{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c857","stream":{"kind":"session","id":"01a0b1a1-0fcd-7b72-b1bb-a101f0623221"},"sequence":646,"recorded_at":1780531400001287,"record_type":"event","durability":"durable","causation_id":"96b9aaba-3389-40b6-a064-cffa078aa95e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"96b9aaba-3389-40b6-a064-cffa078aa95e","run_stream":{"kind":"run","id":"96b9aaba-3389-40b6-a064-cffa078aa95e"},"task_stream":{"kind":"task","id":"01a0b1a5-9e6a-7593-b72a-3f679e8860f3"},"task_id":"01a0b1a5-9e6a-7593-b72a-3f679e8860f3","event":{"kind":"output","task_id":"01a0b1a5-9e6a-7593-b72a-3f679e8860f3","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/clonebundle/refusal_session_event_test.go`.\n(570 line(s) above)\n571|}\n572|\n573|// TestVerifyRawManifestDescriptorsRefusals pins the three refusal\n574|// arms of the evidence-verification entry (fetch failure, absent\n575|// bytes, disagreeing bytes) plus the descriptor-identity link: a\n576|// fetch that returns the real bytes for an entry naming a different\n577|// descriptor is refused.\n578|func TestVerifyRawManifestDescriptorsRefusals(t *testing.T) {\n579|\tmanifest, err := DecodeRawObjectManifest(mustRawBytes(t))\n580|\tif err != nil {\n581|\t\tt.Fatal(err)\n582|\t}\n583|\tinputs := validEntryInputs(t)\n584|\tbyID := map[string][]byte{}\n585|\tfor index, input := range inputs {\n586|\t\tbyID[manifest.Entries[index].BlobDescriptorID.String()] = input.Descriptor\n587|\t}\n588|\trequireRefusal(t, VerifyRawManifestDescriptors(manifest, func(id string) ([]byte, error) {\n589|\t\treturn nil, fmt.Errorf(\"boom\")\n590|\t}), \"descriptor fetch failed\")\n591|\trequireRefusal(t, VerifyRawManifestDescriptors(manifest, func(id string) ([]byte, error) {\n592|\t\treturn nil, nil\n593|\t}), \"descriptor is absent\")\n594|\t// Wrong bytes for entry 0 only: entry 1 verifies, so the entry-0\n595|\t// arm is the one that fires.\n596|\twrong, _, _, _ := makeDescriptor(t, []byte(\"unrelated\"))\n597|\trequireRefusal(t, VerifyRawManifestDescriptors(manifest, func(id string) ([]byte, error) {\n598|\t\tif id == manifest.Entries[0].BlobDescriptorID.String() {\n599|\t\t\treturn wrong, nil\n600|\t\t}\n601|\t\treturn byID[id], nil\n602|\t}), \"disagrees\")\n603|\t// The fetched bytes are real, but the entry names a descriptor\n604|\t// that does not exist: the identity link refuses.\n605|\trenamed := manifest\n606|\trenamed.Entries = append([]RawObjectEntry(nil), manifest.Entries...)\n607|\trenamed.Entries[0].BlobDescriptorID = mustDigest(t, fixtureDigest(\"some-other-descriptor\"))\n608|\trequireRefusal(t, VerifyRawManifestDescriptors(renamed, func(id string) ([]byte, error) {\n609|\t\treturn byID[manifest.Entries[0].BlobDescriptorID.String()], nil\n610|\t}), \"disagrees with entry claim\")\n611|}\n612|\n613|// TestInstallRawBlobRefusals pins the install-site gates: a forged\n614|// identity claim is refused before any byte crosses the store, and\n615|// byte streams that disagree with the descriptor size are refused\n616|// by the landed no-replace discipline.\n617|func TestInstallRawBlobRefusals(t *testing.T) {\n618|\tpayload := []byte(\"twelve-bytes\")\n619|\tdescriptor, _, _, _ := makeDescriptor(t, payload)\n620|\tstore := openFixtureStore(t)\n621|\tresealed := tamper(t, descriptor, func(o map[string]any) { o[\"descriptor_id\"] = fixtureDigest(\"forged-descriptor\") })\n622|\t_, err := InstallRawBlob(store, resealed, bytes.NewReader(payload))\n623|\trequireRefusal(t, err, \"omit-self digest\")\n624|\t_, err = InstallRawBlob(store, descriptor, bytes.NewReader([]byte(\"short\")))\n625|\trequireRefusal(t, err, \"blob install refused\")\n626|\t_, err = InstallRawBlob(store, descriptor, bytes.NewReader([]byte(\"twelve-bytes-and-more\")))\n627|\trequireRefusal(t, err, \"blob install refused\")\n628|}\n629|\n630|// TestIdentityDigestRefusals pins the digest gates: no digest is\n631|// sealed over an identity decoding would refuse (re-decode), and\n632|// unsafe extensions are refused at encode.\n633|func TestIdentityDigestRefusals(t *testing.T) {\n634|\tbad := fixtureNativeIdentity()\n635|\tbad.IdentityKind = \"bogus\"\n636|\t_, err := IdentityDigest(bad, nil)\n637|\trequireRefusal(t, err, \"undecodable identity\")\n638|\t_, err = IdentityDigest(fixtureNativeIdentity(), map[string]any{\"no-dots\": 1})\n639|\trequireRefusal(t, err, \"reverse-DNS\")\n640|\topaque := fixtureNativeIdentity()\n641|\topaque.OpaqueIdentity = strptr(\"/abs/opaque\")\n642|\t_, err = IdentityDigest(opaque, nil)\n643|\trequireRefusal(t, err, \"undecodable identity\")\n644|\tunsafe := fixtureNativeIdentity()\n645|\tunsafe.NativeSessionID = \"/abs/session\"\n646|\t_, err = IdentityDigest(unsafe, nil)\n647|\trequireRefusal(t, err, \"absolute source path\")\n648|}\n649|\n650|// TestEncodeNativeIdentityRefusals pins the encode-time extensions\n651|// gate: encoding never admits what decoding refused, so unsafe\n652|// extension values and non-reverse-DNS keys are refused here, not\n653|// merely at the caller's re-decode.\n654|func TestEncodeNativeIdentityRefusals(t *testing.T) {\n655|\t_, err := EncodeNativeIdentity(fixtureNativeIdentity(), map[string]any{\"com.example.n\": uint64(1) << 60})\n656|\trequireRefusal(t, err, \"safe-integer\")\n657|\t_, err = EncodeNativeIdentity(fixtureNativeIdentity(), map[string]any{\"no-dots\": 1})\n658|\trequireRefusal(t, err, \"reverse-DNS\")\n659|\tencoded, err := EncodeNativeIdentity(fixtureNativeIdentity(), nil)\n660|\tif err != nil {\n661|\t\tt.Fatalf(\"EncodeNativeIdentity(valid) error = %v\", err)\n662|\t}\n663|\tif _, err := DecodeNativeIdentity(encoded); err != nil {\n664|\t\tt.Fatalf(\"DecodeNativeIdentity(EncodeNativeIdentity(valid)) error = %v\", err)\n665|\t}\n666|}\n667|\n668|func TestBlobAgreementRefusals(t *testing.T) {\n669|\tdescriptor, blobID, descriptorID, size := makeDescriptor(t, []byte(\"evidence\"))\n670|\tblob := mustDigest(t, blobID)\n(more lines below)","final_result":true}}}
