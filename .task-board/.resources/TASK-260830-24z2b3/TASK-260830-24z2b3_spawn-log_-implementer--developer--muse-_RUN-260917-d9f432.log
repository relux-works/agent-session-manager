|        count=1,\n409|        run=\"TestCaptureManifestRefusals/build_plan_match\",\n410|        expect=\"KILLED\",\n411|        note=\"Admits exactly the killer's extra plan candidate; every other items/plan mismatch still refuses.\",\n412|    ),\n413|    Mutant(\n414|        name=\"N-block-xor\",\n415|        path=f\"{PACKAGE}/event.go\",\n416|        find=\"\\t\\tif hasContent == hasDescriptor {\\n\",\n417|        replace=\"\\t\\tif hasContent == hasDescriptor && hasContent {\\n\",\n418|        count=1,\n419|        run=\"TestCanonicalEventRefusals/build_envelope/block_neither_content_nor_descriptor\",\n420|        expect=\"KILLED\",\n421|        note=\"Admits exactly a block with neither content nor descriptor; a block with both still refuses.\",\n422|    ),\n423|    Mutant(\n424|        name=\"N-maximal-incomplete\",\n425|        path=f\"{PACKAGE}/capturebuild.go\",\n426|        find=\"\\tif !manifest.RawComplete {\\n\",\n427|        replace=\"\\tif !manifest.RawComplete && hasUnknownClass(manifest.Items) {\\n\",\n428|        count=1,\n429|        run=\"TestCaptureManifestRefusals/reconciliation\",\n430|        expect=\"KILLED\",\n431|        note=\"Admits exactly incomplete known-class manifests to maximal_safe; unknown still blocks.\",\n432|    ),\n433|    Mutant(\n434|        name=\"N-payload-number\",\n435|        path=f\"{PACKAGE}/event.go\",\n436|        find='\\tif err := checkPayloadValues(bytesTrimSpace(raw)); err != nil {\\n\\t\\treturn nil, invalid(\"canonical event payload values %s\", err)\\n\\t}\\n',\n437|        replace='\\tif err := checkPayloadValues(bytesTrimSpace(raw)); err != nil && string(bytesTrimSpace(raw)) != `{\"n\":9007199254740992}` {\\n\\t\\treturn nil, invalid(\"canonical event payload values %s\", err)\\n\\t}\\n',\n438|        count=1,\n439|        run=\"TestCanonicalEventPayloadValueModel/build/usage_2.53$\",\n440|        expect=\"KILLED\",\n441|        note=\"Admits exactly the killer's 2^53 usage payload past the shared payload value gate; every other unsafe literal still refuses at build and decode.\",\n442|    ),\n443|    Mutant(\n444|        name=\"N-raw-order-decode\",\n445|        path=f\"{PACKAGE}/rawmanifest.go\",\n446|        find=\"\\t\\tif index > 0 && key <= previous {\\n\\t\\t\\treturn nil, 0, invalid(\",\n447|        replace=\"\\t\\tif index > 0 && key < previous {\\n\\t\\t\\treturn nil, 0, invalid(\",\n448|        count=1,\n449|        run=\"TestRawManifestRefusals/decode/duplicate_entries\",\n450|        expect=\"KILLED\",\n451|        note=\"Admits exactly an equal-key duplicate entry at decode; unsorted entries still refuse. The build site keeps its own row.\",\n452|    ),\n453|    Mutant(\n454|        name=\"N-plan-keys-dup\",\n455|        path=f\"{PACKAGE}/capturebuild.go\",\n456|        find='\\t\\tif seenPlan[key] {\\n\\t\\t\\treturn invalid(\"capture manifest plan keys carry duplicate %q\", key)\\n',\n457|        replace='\\t\\tif seenPlan[key] && key != \"store/blob-a\" {\\n\\t\\t\\treturn invalid(\"capture manifest plan keys carry duplicate %q\", key)\\n',\n458|        count=1,\n459|        run=\"TestCaptureManifestRefusals/build_plan_match\",\n460|        expect=\"KILLED\",\n461|        note=\"Admits exactly the killer's duplicated plan key store/blob-a; every other duplicate still refuses.\",\n462|    ),\n463|    Mutant(\n464|        name=\"N-block-content-null\",\n465|        path=f\"{PACKAGE}/event.go\",\n466|        find='\\t\\thasContent := hasContentMember && !isNull(members[\"content\"])\\n',\n467|        replace='\\t\\thasContent := hasContentMember\\n',\n468|        count=1,\n469|        run=\"TestCanonicalEventRefusals/build_envelope/block_null_content\",\n470|        expect=\"KILLED\",\n471|        note=\"Admits exactly null content (presence-only XOR arm); null descriptors and neither/both rows still refuse.\",\n472|    ),\n473|    Mutant(\n474|        name=\"N-proof-input-blocked\",\n475|        path=f\"{PACKAGE}/boundary.go\",\n476|        find=\"\\t