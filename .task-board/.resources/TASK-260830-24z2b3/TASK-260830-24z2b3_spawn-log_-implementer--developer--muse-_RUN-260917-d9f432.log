24|\tif !validProofKind(input.ProofKind) {\n525|\t\treturn StableSnapshotProof{}, nil, invalid(\"stable snapshot proof kind is outside the closed proof vocabulary\")\n526|\t}\n527|\tgeneration, err := ParseGeneration(input.Generation)\n528|\tif err != nil {\n529|\t\treturn StableSnapshotProof{}, nil, err\n530|\t}\n531|\tvar identity *scalar.Digest\n532|\tif input.SnapshotIdentity != nil {\n533|\t\tvalue, err := scalar.ParseDigest(*input.SnapshotIdentity)\n534|\t\tif err != nil {\n535|\t\t\treturn StableSnapshotProof{}, nil, invalid(\"stable snapshot proof snapshot_identity_digest is not a digest: %v\", err)\n536|\t\t}\n537|\t\tidentity = &value\n538|\t}\n539|\tpre, err := scalar.ParseDigest(input.PreCaptureDigest)\n540|\tif err != nil {\n541|\t\treturn StableSnapshotProof{}, nil, invalid(\"stable snapshot proof pre_capture_digest is not a digest: %v\", err)\n542|\t}\n543|\tpost, err := scalar.ParseDigest(input.PostCaptureDigest)\n544|\tif err != nil {\n545|\t\treturn StableSnapshotProof{}, nil, invalid(\"stable snapshot proof post_capture_digest is not a digest: %v\", err)\n546|\t}\n547|\tproof := StableSnapshotProof{\n548|\t\tProofKind:         input.ProofKind,\n549|\t\tSourceGeneration:  generation,\n550|\t\tSnapshotIdentity:  identity,\n551|\t\tPreCaptureDigest:  pre,\n552|\t\tPostCaptureDigest: post,\n553|\t\tInputBlocked:      input.InputBlocked,\n554|\t\tForegroundIdle:    input.ForegroundIdle,\n555|\t\tBackgroundIdle:    input.BackgroundIdle,\n556|\t}\n557|\tif err := checkProofCoupling(proof); err != nil {\n558|\t\treturn StableSnapshotProof{}, nil, err\n559|\t}\n560|\tvar identityValue any\n561|\tif identity != nil {\n562|\t\tidentityValue = identity.String()\n563|\t}\n564|\treturn proof, map[string]any{\n565|\t\t\"proof_kind\":               proof.ProofKind,\n566|\t\t\"source_generation\":        generation.String(),\n567|\t\t\"snapshot_identity_digest\": identityValue,\n568|\t\t\"pre_capture_digest\":       pre.String(),\n569|\t\t\"post_capture_digest\":      post.String(),\n570|\t\t\"input_blocked\":            proof.InputBlocked,\n571|\t\t\"foreground_idle\":          proof.ForegroundIdle,\n572|\t\t\"background_idle\":          proof.BackgroundIdle,\n573|\t\t\"extensions\":               map[string]any{},\n574|\t}, nil\n575|}","final_result":true}}}
