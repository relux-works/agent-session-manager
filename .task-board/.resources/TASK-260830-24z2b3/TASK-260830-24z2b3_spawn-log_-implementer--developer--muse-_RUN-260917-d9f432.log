{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c65f","stream":{"kind":"session","id":"01a0b1a1-0fcd-7b72-b1bb-a101f0623221"},"sequence":394,"recorded_at":1780531400000783,"record_type":"event","durability":"durable","causation_id":"96b9aaba-3389-40b6-a064-cffa078aa95e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"96b9aaba-3389-40b6-a064-cffa078aa95e","run_stream":{"kind":"run","id":"96b9aaba-3389-40b6-a064-cffa078aa95e"},"task_stream":{"kind":"task","id":"01a0b1a1-f10e-7e82-bf1d-7c7d33224b18"},"task_id":"01a0b1a1-f10e-7e82-bf1d-7c7d33224b18","event":{"kind":"output","task_id":"01a0b1a1-f10e-7e82-bf1d-7c7d33224b18","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/clonebundle/rawmanifest.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/hosttrust\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n9|)\n10|\n11|// This file validates and constructs Clone Raw Object Manifest 1.0.0:\n12|// the closed sorted unique entry list over content-addressed blobs.\n13|// Credential, machine-auth, runtime-state, transient-lock, and\n14|// hosttrust-excluded candidates are forbidden here; they never become\n15|// raw objects.\n16|\n17|const (\n18|\trawManifestSchema  = \"urn:ax:schema:clone-raw-object-manifest\"\n19|\trawManifestVersion = \"1.0.0\"\n20|\trawManifestSelf    = \"raw_object_manifest_id\"\n21|)\n22|\n23|// rawEntryClasses is the closed RawObjectEntry class subset:\n24|// durable and derived-cache classes plus unknown. The four\n25|// excluded classes (credential, machine_auth, runtime_state,\n26|// transient_lock) are absent by construction, so membership in this\n27|// table is the gate.\n28|var rawEntryClasses = []string{\n29|\t\"durable_payload\",\n30|\t\"durable_index_required\",\n31|\t\"durable_sidecar\",\n32|\t\"derived_cache_optional\",\n33|\t\"unknown\",\n34|}\n35|\n36|func validRawEntryClass(class string) bool {\n37|\tfor _, allowed := range rawEntryClasses {\n38|\t\tif class == allowed {\n39|\t\t\treturn true\n40|\t\t}\n41|\t}\n42|\treturn false\n43|}\n44|\n45|var rawManifestMembers = map[string]bool{\n46|\t\"schema\":                   true,\n47|\t\"schema_version\":           true,\n48|\t\"raw_object_manifest_id\":   true,\n49|\t\"operation_id\":             true,\n50|\t\"source_environment\":       true,\n51|\t\"source_native_session_id\": true,\n52|\t\"source_identity_digest\":   true,\n53|\t\"capture_plan_digest\":      true,\n54|\t\"entries\":                  true,\n55|\t\"total_bytes\":              true,\n56|\t\"extensions\":               true,\n57|}\n58|\n59|var rawManifestRequired = []string{\n60|\t\"schema\",\n61|\t\"schema_version\",\n62|\t\"raw_object_manifest_id\",\n63|\t\"operation_id\",\n64|\t\"source_environment\",\n65|\t\"source_native_session_id\",\n66|\t\"source_identity_digest\",\n67|\t\"capture_plan_digest\",\n68|\t\"entries\",\n69|\t\"total_bytes\",\n70|\t\"extensions\",\n71|}\n72|\n73|var rawEntryMembers = map[string]bool{\n74|\t\"native_item_key\":    true,\n75|\t\"class\":              true,\n76|\t\"byte_count\":         true,\n77|\t\"blob_id\":            true,\n78|\t\"blob_descriptor_id\": true,\n79|}\n80|\n81|var rawEntryRequired = []string{\n82|\t\"native_item_key\",\n83|\t\"class\",\n84|\t\"byte_count\",\n85|\t\"blob_id\",\n86|\t\"blob_descriptor_id\",\n87|}\n88|\n89|// RawObjectEntry is one validated raw object entry.\n90|type RawObjectEntry struct {\n91|\tNativeItemKey    string\n92|\tClass            string\n93|\tByteCount        uint64\n94|\tBlobID           scalar.Digest\n95|\tBlobDescriptorID scalar.Digest\n96|}\n97|\n98|// RawObjectManifest is one validated Clone Raw Object Manifest.\n99|type RawObjectManifest struct {\n100|\tManifestID            scalar.Digest\n101|\tOperationID           scalar.UUIDv7\n102|\tSourceEnvironment     sessadapter.Tuple\n103|\tSourceNativeSessionID string\n104|\tSourceIdentityDigest  scalar.Digest\n105|\tCapturePlanDigest     scalar.Digest\n106|\tEntries               []RawObjectEntry\n107|\tTotalBytes            uint64\n108|}\n109|\n110|// EntryInput is one caller-supplied raw entry candidate for Build.\n111|// Descriptor carries the exact Section 10.2 Blob Descriptor bytes\n112|// the entry references; Build verifies the descriptor's closed\n113|// shape and identity and its blob-ID/byte-count agreement before\n114|// the entry is admitted.\n115|type EntryInput struct {\n116|\tNativeItemKey string\n117|\tClass         string\n118|\tByteCount     uint64\n119|\tBlobID        string\n120|\tDescriptorID  string\n121|\tDescriptor    []byte\n122|}\n123|\n124|// BuildRawObjectManifest constructs one closed Clone Raw Object\n125|// Manifest as canonical bytes. Identical inputs produce\n126|// byte-identical outputs. Every closed-shape rule is a refusal:\n127|// unknown classes, unsanitized or excluded native keys, unsorted or\n128|// duplicate entries, descriptor disagreement, and total-byte\n129|// mismatch are all refused, never repaired.\n130|func BuildRawObjectManifest(\n131|\toperationID string,\n132|\tsourceEnvironment []byte,\n133|\tsourceNativeSessionID string,\n134|\tsourceIdentityDigest string,\n135|\tcapturePlanDigest string,\n136|\tinputs []EntryInput,\n137|\textensions map[string]any,\n138|) ([]byte, error) {\n139|\toperation, err := scalar.ParseUUIDv7(operationID)\n140|\tif err != nil {\n141|\t\treturn nil, invalid(\"raw object manifest operation_id is not a UUIDv7: %v\", err)\n142|\t}\n143|\ttuple, err := sessadapter.DecodeTuple(json.RawMessage(sourceEnvironment))\n144|\tif err != nil {\n145|\t\treturn nil, invalid(\"raw object manifest source_environment is not an Environment Tuple: %v\", err)\n146|\t}\n147|\tif stringLength(sourceNativeSessionID) < 1 || stringLength(sourceNativeSessionID) > 512 {\n148|\t\treturn nil, invalid(\"raw object manifest source_native_session_id is not a string[1..512]\")\n149|\t}\n150|\tif err := SanitizeNativeKey(sourceNativeSessionID); err != nil {\n151|\t\treturn nil, err\n152|\t}\n153|\tidentityDigest, err := scalar.ParseDigest(sourceIdentityDigest)\n154|\tif err != nil {\n155|\t\treturn nil, invalid(\"raw object manifest source_identity_digest is not a digest: %v\", err)\n156|\t}\n157|\tplanDigest, err := scalar.ParseDigest(capturePlanDigest)\n158|\tif err != nil {\n159|\t\treturn nil, invalid(\"raw object manifest capture_plan_digest is not a digest: %v\", err)\n160|\t}\n161|\tif len(inputs) > 65536 {\n162|\t\treturn nil, invalid(\"raw object manifest carries %d entries, maximum is 65536\", len(inputs))\n163|\t}\n164|\tentries, total, err := buildRawEntries(inputs)\n165|\tif err != nil {\n166|\t\treturn nil, err\n167|\t}\n168|\tif _, err := encodeExtensions(extensions); err != nil {\n169|\t\treturn nil, err\n170|\t}\n171|\tobject := map[string]any{\n172|\t\t\"schema\":                   rawManifestSchema,\n173|\t\t\"schema_version\":           rawManifestVersion,\n174|\t\t\"operation_id\":             operation.String(),\n175|\t\t\"source_environment\":       tupleObject(tuple),\n176|\t\t\"source_native_session_id\": sourceNativeSessionID,\n177|\t\t\"source_identity_digest\":   identityDigest.String(),\n178|\t\t\"capture_plan_digest\":      planDigest.String(),\n179|\t\t\"entries\":                  rawEntryObjects(entries),\n180|\t\t\"total_bytes\":              total,\n181|\t\t\"extensions\":               extensionValue(extensions),\n182|\t}\n183|\tomitted, err := canonicalizeObject(object)\n184|\tif err != nil {\n185|\t\treturn nil, err\n186|\t}\n187|\tmanifestID := scalar.SHA256Digest(omitted)\n188|\tobject[rawManifestSelf] = manifestID.String()\n189|\treturn canonicalizeObject(object)\n190|}\n191|\n192|func buildRawEntries(inputs []EntryInput) ([]RawObjectEntry, uint64, error) {\n193|\tentries := make([]RawObjectEntry, 0, len(inputs))\n194|\tprevious := \"\"\n195|\tvar total uint64\n196|\tfor index, input := range inputs {\n197|\t\tif stringLength(input.NativeItemKey) < 1 || stringLength(input.NativeItemKey) > 512 {\n198|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] native_item_key is not a string[1..512]\", index)\n199|\t\t}\n200|\t\tif err := SanitizeNativeKey(input.NativeItemKey); err != nil {\n201|\t\t\treturn nil, 0, err\n202|\t\t}\n203|\t\tif err := refuseExcludedMember(\"raw object entry\", input.NativeItemKey, index); err != nil {\n204|\t\t\treturn nil, 0, err\n205|\t\t}\n206|\t\tif !validRawEntryClass(input.Class) {\n207|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] class %q is outside the raw subset\", index, input.Class)\n208|\t\t}\n209|\t\tif input.ByteCount > maxUint53 {\n210|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] byte_count exceeds uint53\", index)\n211|\t\t}\n212|\t\tblobID, err := scalar.ParseDigest(input.BlobID)\n213|\t\tif err != nil {\n214|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] blob_id is not a digest: %v\", index, err)\n215|\t\t}\n216|\t\tdescriptorID, err := scalar.ParseDigest(input.DescriptorID)\n217|\t\tif err != nil {\n218|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] blob_descriptor_id is not a digest: %v\", index, err)\n219|\t\t}\n220|\t\tif err := VerifyDescriptorAgreement(input.Descriptor, descriptorID, blobID, input.ByteCount); err != nil {\n221|\t\t\treturn nil, 0, invalid(\"raw object entry[%d]: %v\", index, err)\n222|\t\t}\n223|\t\tif total > maxUint53-input.ByteCount {\n224|\t\t\treturn nil, 0, invalid(\"raw object manifest total_bytes exceeds uint53\")\n225|\t\t}\n226|\t\ttotal += input.ByteCount\n227|\t\tif index > 0 && input.NativeItemKey <= previous {\n228|\t\t\treturn nil, 0, invalid(\"raw object manifest entries are not sorted unique by native item key\")\n229|\t\t}\n230|\t\tprevious = input.NativeItemKey\n231|\t\tentries = append(entries, RawObjectEntry{\n232|\t\t\tNativeItemKey:    input.NativeItemKey,\n233|\t\t\tClass:            input.Class,\n234|\t\t\tByteCount:        input.ByteCount,\n235|\t\t\tBlobID:           blobID,\n236|\t\t\tBlobDescriptorID: descriptorID,\n237|\t\t})\n238|\t}\n239|\treturn entries, total, nil\n240|}\n241|\n242|// refuseExcludedMember is the row-21 exclusion allowlist: a native\n243|// key matching hosttrust.MatchExcludedFromReplication or\n244|// hosttrust.ExcludedConfigDirName is trust-adjacent material that\n245|// must never enter a clone bundle, so construction refuses it. The\n246|// owner names the calling shape (raw entry, capture item) so the\n247|// refusal identifies the exact member.\n248|func refuseExcludedMember(owner, key string, index int) error {\n249|\tif hosttrust.MatchExcludedFromReplication(key) {\n250|\t\treturn invalid(\"%s[%d] native key %q is excluded from replication\", owner, index, key)\n251|\t}\n252|\tif hosttrust.ExcludedConfigDirName(key) {\n253|\t\treturn invalid(\"%s[%d] native key %q is trust-adjacent config material\", owner, index, key)\n254|\t}\n255|\treturn nil\n256|}\n257|\n258|// DecodeRawObjectManifest validates one closed Clone Raw Object\n259|// Manifest: exact members, schema/version, self-digest agreement,\n260|// tuple, sanitized source identity, sorted unique entries, and a\n261|// total equal to the sum of entry byte counts.\n262|func DecodeRawObjectManifest(data []byte) (RawObjectManifest, error) {\n263|\tmembers, fault := decodeStrictObject(data)\n264|\tif fault != nil {\n265|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest %s (%s)\", fault.detail, memberField(fault.member))\n266|\t}\n267|\tif name, unknown := unknownMember(members, rawManifestMembers); unknown {\n268|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest carries unknown member %q\", name)\n269|\t}\n270|\tif name, missing := missingMember(members, rawManifestRequired); missing {\n271|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest misses a required member %q\", name)\n272|\t}\n273|\tschema, ok := rawString(members[\"schema\"])\n274|\tif !ok || schema != rawManifestSchema {\n275|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest schema is not the clone raw object manifest\")\n276|\t}\n277|\tversion, ok := rawString(members[\"schema_version\"])\n278|\tif !ok || version != rawManifestVersion {\n279|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest version is not 1.0.0\")\n280|\t}\n281|\tmanifestID, ok := checkDigest(members[rawManifestSelf])\n282|\tif !ok {\n283|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest raw_object_manifest_id is not a digest\")\n284|\t}\n285|\toperation, ok := checkUUIDv7(members[\"operation_id\"])\n286|\tif !ok {\n287|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest operation_id is not a UUIDv7\")\n288|\t}\n289|\ttuple, err := sessadapter.DecodeTuple(members[\"source_environment\"])\n290|\tif err != nil {\n291|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest source_environment is not an Environment Tuple: %v\", err)\n292|\t}\n293|\tnativeID, ok := checkStringBounds(members[\"source_native_session_id\"], 1, 512)\n294|\tif !ok {\n295|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest source_native_session_id is not a string[1..512]\")\n296|\t}\n297|\tif err := SanitizeNativeKey(nativeID); err != nil {\n298|\t\treturn RawObjectManifest{}, err\n299|\t}\n300|\tidentityDigest, ok := checkDigest(members[\"source_identity_digest\"])\n301|\tif !ok {\n302|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest source_identity_digest is not a digest\")\n303|\t}\n304|\tplanDigest, ok := checkDigest(members[\"capture_plan_digest\"])\n305|\tif !ok {\n306|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest capture_plan_digest is not a digest\")\n307|\t}\n308|\tentries, total, err := decodeRawEntries(members[\"entries\"])\n309|\tif err != nil {\n310|\t\treturn RawObjectManifest{}, err\n311|\t}\n312|\tclaimed, ok := checkUint53Bounds(members[\"total_bytes\"], 0, maxUint53)\n313|\tif !ok {\n314|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest total_bytes is not a uint53\")\n315|\t}\n316|\tif claimed != total {\n317|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest total_bytes is %d, entries sum to %d\", claimed, total)\n318|\t}\n319|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n320|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest extensions %s\", extensionsFault)\n321|\t}\n322|\tif err := verifySelfDigest(members, rawManifestSelf, manifestID); err != nil {\n323|\t\treturn RawObjectManifest{}, err\n324|\t}\n325|\treturn RawObjectManifest{\n326|\t\tManifestID:            manifestID,\n327|\t\tOperationID:           operation,\n328|\t\tSourceEnvironment:     tuple,\n329|\t\tSourceNativeSessionID: nativeID,\n330|\t\tSourceIdentityDigest:  identityDigest,\n331|\t\tCapturePlanDigest:     planDigest,\n332|\t\tEntries:               entries,\n333|\t\tTotalBytes:            total,\n334|\t}, nil\n335|}\n336|\n337|func decodeRawEntries(raw json.RawMessage) ([]RawObjectEntry, uint64, error) {\n338|\telements, ok := decodeArray(raw)\n339|\tif !ok {\n340|\t\treturn nil, 0, invalid(\"raw object manifest entries are not an array\")\n341|\t}\n342|\tif len(elements) > 65536 {\n343|\t\treturn nil, 0, invalid(\"raw object manifest carries %d entries, maximum is 65536\", len(elements))\n344|\t}\n345|\tentries := make([]RawObjectEntry, 0, len(elements))\n346|\tprevious := \"\"\n347|\tvar total uint64\n348|\tfor index, element := range elements {\n349|\t\tmembers, fault := decodeStrictObject(bytesTrimSpace(element))\n350|\t\tif fault != nil {\n351|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] %s (%s)\", index, fault.detail, memberField(fault.member))\n352|\t\t}\n353|\t\tif name, unknown := unknownMember(members, rawEntryMembers); unknown {\n354|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] carries unknown member %q\", index, name)\n355|\t\t}\n356|\t\tif name, missing := missingMember(members, rawEntryRequired); missing {\n357|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] misses a required member %q\", index, name)\n358|\t\t}\n359|\t\tkey, ok := checkStringBounds(members[\"native_item_key\"], 1, 512)\n360|\t\tif !ok {\n361|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] native_item_key is not a string[1..512]\", index)\n362|\t\t}\n363|\t\tif err := SanitizeNativeKey(key); err != nil {\n364|\t\t\treturn nil, 0, err\n365|\t\t}\n366|\t\tif err := refuseExcludedMember(\"raw object entry\", key, index); err != nil {\n367|\t\t\treturn nil, 0, err\n368|\t\t}\n369|\t\tclass, ok := rawString(members[\"class\"])\n370|\t\tif !ok || !validRawEntryClass(class) {\n371|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] class %q is outside the raw subset\", index, class)\n372|\t\t}\n373|\t\tcount, ok := checkUint53Bounds(members[\"byte_count\"], 0, maxUint53)\n374|\t\tif !ok {\n375|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] byte_count is not a uint53\", index)\n376|\t\t}\n377|\t\tblobID, ok := checkDigest(members[\"blob_id\"])\n378|\t\tif !ok {\n379|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] blob_id is not a digest\", index)\n380|\t\t}\n381|\t\tdescriptorID, ok := checkDigest(members[\"blob_descriptor_id\"])\n382|\t\tif !ok {\n383|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] blob_descriptor_id is not a digest\", index)\n384|\t\t}\n385|\t\tif total > maxUint53-count {\n386|\t\t\treturn nil, 0, invalid(\"raw object manifest total_bytes exceeds uint53\")\n387|\t\t}\n388|\t\ttotal += count\n389|\t\tif index > 0 && key <= previous {\n390|\t\t\treturn nil, 0, invalid(\"raw object manifest entries are not sorted unique by native item key\")\n391|\t\t}\n392|\t\tprevious = key\n393|\t\tentries = append(entries, RawObjectEntry{\n394|\t\t\tNativeItemKey:    key,\n395|\t\t\tClass:            class,\n396|\t\t\tByteCount:        count,\n397|\t\t\tBlobID:           blobID,\n398|\t\t\tBlobDescriptorID: descriptorID,\n399|\t\t})\n400|\t}\n401|\treturn entries, total, nil\n402|}\n403|\n404|// VerifyRawManifestDescriptors re-checks descriptor agreement for a\n405|// decoded manifest: every entry's blob ID and byte count must agree\n406|// with the fetched Section 10.2 Blob Descriptor bytes, and the\n407|// fetched bytes must be the exact descriptor the entry's\n408|// blob_descriptor_id names. Decode validates structure; this entry\n409|// validates evidence.\n410|func VerifyRawManifestDescriptors(manifest RawObjectManifest, fetch func(descriptorID string) ([]byte, error)) error {\n411|\tfor index, entry := range manifest.Entries {\n412|\t\tdescriptor, err := fetch(entry.BlobDescriptorID.String())\n413|\t\tif err != nil {\n414|\t\t\treturn invalid(\"raw object entry[%d]: descriptor fetch failed: %v\", index, err)\n415|\t\t}\n416|\t\tif len(descriptor) == 0 {\n417|\t\t\treturn invalid(\"raw object entry[%d]: descriptor is absent\", index)\n418|\t\t}\n419|\t\tif err := VerifyDescriptorAgreement(descriptor, entry.BlobDescriptorID, entry.BlobID, entry.ByteCount); err != nil {\n420|\t\t\treturn invalid(\"raw object entry[%d]: %v\", index, err)\n421|\t\t}\n422|\t}\n423|\treturn nil\n424|}\n425|\n426|// IdentityDigest computes the terminal digest of canonical sanitized\n427|// NativeIdentity bytes: the source_identity_digest production entry.\n428|// The encoded bytes re-decode before hashing, exactly as\n429|// buildCaptureManifest re-decodes the source identity, so no digest\n430|// is ever sealed over an identity decoding would refuse.\n431|func IdentityDigest(identity NativeIdentity, extensions map[string]any) (scalar.Digest, error) {\n432|\tif err := SanitizeNativeKey(identity.NativeSessionID); err != nil {\n433|\t\treturn scalar.Digest{}, err\n434|\t}\n435|\tencoded, err := EncodeNativeIdentity(identity, extensions)\n436|\tif err != nil {\n437|\t\treturn scalar.Digest{}, err\n438|\t}\n439|\tif _, err := DecodeNativeIdentity(json.RawMessage(encoded)); err != nil {\n440|\t\treturn scalar.Digest{}, invalid(\"native identity digest seals no undecodable identity: %v\", err)\n441|\t}\n442|\treturn scalar.SHA256Digest(encoded), nil\n443|}\n444|\n445|func tupleObject(tuple sessadapter.Tuple) map[string]any {\n446|\treturn map[string]any{\n447|\t\t\"environment_id\":           tuple.EnvironmentID,\n448|\t\t\"environment_version\":      tuple.Version,\n449|\t\t\"platform\":                 tuple.Platform,\n450|\t\t\"architecture\":             tuple.Architecture,\n451|\t\t\"store_schema_fingerprint\": tuple.StoreFingerprint,\n452|\t\t\"adapter_version\":          tuple.AdapterVersion,\n453|\t}\n454|}\n455|\n456|func rawEntryObjects(entries []RawObjectEntry) []any {\n457|\tobjects := make([]any, 0, len(entries))\n458|\tfor _, entry := range entries {\n459|\t\tobjects = append(objects, map[string]any{\n460|\t\t\t\"native_item_key\":    entry.NativeItemKey,\n461|\t\t\t\"class\":              entry.Class,\n462|\t\t\t\"byte_count\":         entry.ByteCount,\n463|\t\t\t\"blob_id\":            entry.BlobID.String(),\n464|\t\t\t\"blob_descriptor_id\": entry.BlobDescriptorID.String(),\n465|\t\t})\n466|\t}\n467|\treturn objects\n468|}\n469|\n470|func extensionValue(extensions map[string]any) map[string]any {\n471|\tif extensions == nil {\n472|\t\treturn map[string]any{}\n473|\t}\n474|\treturn extensions\n475|}\n476|\n477|func encodeExtensions(extensions map[string]any) ([]byte, error) {\n478|\tvalue := extensionValue(extensions)\n479|\tplain, err := json.Marshal(value)\n480|\tif err != nil {\n481|\t\treturn nil, invalid(\"extensions are not JSON: %v\", err)\n482|\t}\n483|\tif fault := checkExtensionsClosed(json.RawMessage(plain)); fault != nil {\n484|\t\treturn nil, invalid(\"extensions %s\", fault)\n485|\t}\n486|\treturn plain, nil\n487|}","final_result":true}}}
