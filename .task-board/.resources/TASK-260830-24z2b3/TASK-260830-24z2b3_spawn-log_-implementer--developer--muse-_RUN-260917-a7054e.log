{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca19","stream":{"kind":"session","id":"01a0b0cc-369a-7993-946b-ef774181fd54"},"sequence":871,"recorded_at":1780531400001737,"record_type":"event","durability":"durable","causation_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","run_stream":{"kind":"run","id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3"},"task_stream":{"kind":"task","id":"01a0b0ce-f6e9-7de3-b26b-378888a0001e"},"task_id":"01a0b0ce-f6e9-7de3-b26b-378888a0001e","event":{"kind":"output","task_id":"01a0b0ce-f6e9-7de3-b26b-378888a0001e","chunk":"Read text file `internal/clonebundle/refusal_test.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|)\n9|\n10|// Negative tests for the raw manifest, capture items, source basis,\n11|// and capture boundary gates. Every row drives a production entry\n12|// point and asserts the refusal; rows that share a verdict shape\n13|// assert a message fragment so the firing gate is identified.\n14|\n15|func mustRawBytes(t *testing.T) []byte {\n16|\tt.Helper()\n17|\tidentity := fixtureNativeIdentity()\n18|\tdigest, err := IdentityDigest(identity, nil)\n19|\tif err != nil {\n20|\t\tt.Fatal(err)\n21|\t}\n22|\tbuilt, err := BuildRawObjectManifest(fixtureOperationID, []byte(fixtureTupleJSON()),\n23|\t\t\"native-session-alpha\", digest.String(), fixtureDigest(\"test-capture-plan\"), validEntryInputs(t), nil)\n24|\tif err != nil {\n25|\t\tt.Fatal(err)\n26|\t}\n27|\treturn built\n28|}\n29|\n30|func tamper(t *testing.T, data []byte, mutate func(map[string]any)) []byte {\n31|\tt.Helper()\n32|\tvar object map[string]any\n33|\tif err := json.Unmarshal(data, &object); err != nil {\n34|\t\tt.Fatal(err)\n35|\t}\n36|\tmutate(object)\n37|\tout, err := json.Marshal(object)\n38|\tif err != nil {\n39|\t\tt.Fatal(err)\n40|\t}\n41|\treturn out\n42|}\n43|\n44|func requireRefusal(t *testing.T, err error, fragment string) {\n45|\tt.Helper()\n46|\tif !errors.Is(err, ErrInvalid) {\n47|\t\tt.Fatalf(\"error = %v, want ErrInvalid\", err)\n48|\t}\n49|\tif fragment != \"\" && !strings.Contains(err.Error(), fragment) {\n50|\t\tt.Fatalf(\"error = %v, want fragment %q\", err, fragment)\n51|\t}\n52|}\n53|\n54|func TestRawManifestRefusals(t *testing.T) {\n55|\tidentity := fixtureNativeIdentity()\n56|\tidentityDigest, err := IdentityDigest(identity, nil)\n57|\tif err != nil {\n58|\t\tt.Fatal(err)\n59|\t}\n60|\tbuild := func(inputs []EntryInput) error {\n61|\t\t_, err := BuildRawObjectManifest(fixtureOperationID, []byte(fixtureTupleJSON()),\n62|\t\t\t\"native-session-alpha\", identityDigest.String(), fixtureDigest(\"test-capture-plan\"), inputs, nil)\n63|\t\treturn err\n64|\t}\n65|\tt.Run(\"build\", func(t *testing.T) {\n66|\t\tbase := validEntryInputs(t)\n67|\t\tclone := func() []EntryInput {\n68|\t\t\tout := make([]EntryInput, len(base))\n69|\t\t\tcopy(out, base)\n70|\t\t\treturn out\n71|\t\t}\n72|\t\tcases := []struct {\n73|\t\t\tname     string\n74|\t\t\tmutate   func([]EntryInput) []EntryInput\n75|\t\t\tfragment string\n76|\t\t}{\n77|\t\t\t{\"unknown class\", func(in []EntryInput) []EntryInput { in[0].Class = \"mystery\"; return in }, \"outside the raw subset\"},\n78|\t\t\t{\"credential forbidden\", func(in []EntryInput) []EntryInput { in[0].Class = \"credential\"; return in }, \"outside the raw subset\"},\n79|\t\t\t{\"machine_auth forbidden\", func(in []EntryInput) []EntryInput { in[0].Class = \"machine_auth\"; return in }, \"outside the raw subset\"},\n80|\t\t\t{\"runtime_state forbidden\", func(in []EntryInput) []EntryInput { in[0].Class = \"runtime_state\"; return in }, \"outside the raw subset\"},\n81|\t\t\t{\"transient_lock forbidden\", func(in []EntryInput) []EntryInput { in[0].Class = \"transient_lock\"; return in }, \"outside the raw subset\"},\n82|\t\t\t{\"unsorted entries\", func(in []EntryInput) []EntryInput { in[0], in[1] = in[1], in[0]; return in }, \"sorted unique\"},\n83|\t\t\t{\"duplicate entries\", func(in []EntryInput) []EntryInput { in[1].NativeItemKey = in[0].NativeItemKey; return in }, \"sorted unique\"},\n84|\t\t\t{\"absolute key\", func(in []EntryInput) []EntryInput { in[0].NativeItemKey = \"/etc/passwd\"; return in }, \"absolute source path\"},\n85|\t\t\t{\"uuid key\", func(in []EntryInput) []EntryInput { in[0].NativeItemKey = fixtureSessionID; return in }, \"fabricated AX\"},\n86|\t\t\t{\"control key\", func(in []EntryInput) []EntryInput { in[0].NativeItemKey = \"a\\x00b\"; return in }, \"control characters\"},\n87|\t\t\t{\"credential-url key\", func(in []EntryInput) []EntryInput { in[0].NativeItemKey = \"https://user:pass@host/x\"; return in }, \"embedded credentials\"},\n88|\t\t\t{\"ax-marker key\", func(in []EntryInput) []EntryInput { in[0].NativeItemKey = \"urn:ax:session:x\"; return in }, \"AX identity marker\"},\n89|\t\t\t{\"blob disagreement\", func(in []EntryInput) []EntryInput { in[0].BlobID = fixtureDigest(\"other-blob\"); return in }, \"disagrees\"},\n90|\t\t\t{\"size disagreement\", func(in []EntryInput) []EntryInput { in[0].ByteCount++; return in }, \"disagrees\"},\n91|\t\t\t{\"descriptor tampered\", func(in []EntryInput) []EntryInput {\n92|\t\t\t\tin[0].Descriptor = append([]byte(nil), in[0].Descriptor...)\n93|\t\t\t\tin[0].Descriptor[10] ^= 0xff\n94|\t\t\t\treturn in\n95|\t\t\t}, \"identity fails\"},\n96|\t\t\t{\"bad blob digest\", func(in []EntryInput) []EntryInput { in[0].BlobID = \"nope\"; return in }, \"not a digest\"},\n97|\t\t}\n98|\t\tfor _, tc := range cases {\n99|\t\t\tt.Run(tc.name, func(t *testing.T) {\n100|\t\t\t\trequireRefusal(t, build(cloneMutate(clone(), tc.mutate)), tc.fragment)\n101|\t\t\t})\n102|\t\t}\n103|\t})\n104|\tt.Run(\"decode\", func(t *testing.T) {\n105|\t\tvalid := mustRawBytes(t)\n106|\t\tcases := []struct {\n107|\t\t\tname     string\n108|\t\t\tbody     func(t *testing.T) []byte\n109|\t\t\tfragment string\n110|\t\t}{\n111|\t\t\t{\"unknown member\", func(t *testing.T) []byte {\n112|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"target\"] = \"x\" })\n113|\t\t\t}, \"unknown member\"},\n114|\t\t\t{\"missing member\", func(t *testing.T) []byte {\n115|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { delete(o, \"entries\") })\n116|\t\t\t}, \"misses\"},\n117|\t\t\t{\"bad schema\", func(t *testing.T) []byte {\n118|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"schema\"] = \"urn:ax:schema:blob\" })\n119|\t\t\t}, \"not the clone raw object manifest\"},\n120|\t\t\t{\"bad version\", func(t *testing.T) []byte {\n121|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"schema_version\"] = \"2.0.0\" })\n122|\t\t\t}, \"not 1.0.0\"},\n123|\t\t\t{\"total mismatch\", func(t *testing.T) []byte {\n124|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"total_bytes\"] = float64(1) })\n125|\t\t\t}, \"entries sum to\"},\n126|\t\t\t{\"excluded class entry\", func(t *testing.T) []byte {\n127|\t\t\t\treturn tamper(t, valid, func(o map[string]any) {\n128|\t\t\t\t\tentries := o[\"entries\"].([]any)\n129|\t\t\t\t\tentries[0].(map[string]any)[\"class\"] = \"credential\"\n130|\t\t\t\t})\n131|\t\t\t}, \"outside the raw subset\"},\n132|\t\t\t{\"unsorted entries\", func(t *testing.T) []byte {\n133|\t\t\t\treturn tamper(t, valid, func(o map[string]any) {\n134|\t\t\t\t\tentries := o[\"entries\"].([]any)\n135|\t\t\t\t\tentries[0], entries[1] = entries[1], entries[0]\n136|\t\t\t\t})\n137|\t\t\t}, \"sorted unique\"},\n138|\t\t\t{\"unsanitized source id\", func(t *testing.T) []byte {\n139|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"source_native_session_id\"] = \"/abs/path\" })\n140|\t\t\t}, \"absolute source path\"},\n141|\t\t\t{\"bad extensions\", func(t *testing.T) []byte {\n142|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"extensions\"] = map[string]any{\"no-dots\": 1} })\n143|\t\t\t}, \"reverse-DNS\"},\n144|