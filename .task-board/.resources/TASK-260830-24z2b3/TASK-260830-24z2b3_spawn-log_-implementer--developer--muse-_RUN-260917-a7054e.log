ectManifest(nested duplicate, resealed)             REFUSED: %v\\n\", derr)\n27|\t\t}\n28|\t}\n29|}\n30|\n31|func extractMember2(data []byte, name string) string {\n32|\tvar m map[string]json.RawMessage\n33|\t_ = json.Unmarshal(data, &m)\n34|\treturn string(m[name])\n35|}","final_result":true}}}
