{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c74f","stream":{"kind":"session","id":"01a0b0cc-369a-7993-946b-ef774181fd54"},"sequence":514,"recorded_at":1780531400001023,"record_type":"event","durability":"durable","causation_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","run_stream":{"kind":"run","id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3"},"call_id":"call_01a0b0cd32ee73b784c319520a1a022b","text":"Read text file `internal/clonebundle/boundary.go`.\n(499 line(s) above)\n500|\tForegroundIdle    bool\n501|\tBackgroundIdle    bool\n502|\tCore              bool\n503|}\n504|\n505|func buildBoundary(input BoundaryInput) (CaptureBoundary, map[string]any, error) {\n506|\tswitch input.Kind {\n507|\tcase \"stable\":\n508|\t\tproof, object, err := buildStableProof(input)\n509|\t\tif err != nil {\n510|\t\t\treturn CaptureBoundary{}, nil, err\n511|\t\t}\n512|\t\tboundary := CaptureBoundary{Kind: \"stable\", Proof: &proof}\n513|\t\treturn boundary, map[string]any{\n514|\t\t\t\"kind\":       \"stable\",\n515|\t\t\t\"proof\":      object,\n516|\t\t\t\"extensions\": map[string]any{},\n517|\t\t}, nil\n518|\tcase \"unstable_archive\":\n519|\t\tif !input.Core {\n520|\t\t\treturn CaptureBoundary{}, nil, invalid(\"capture boundary unstable_archive is core-created only\")\n521|\t\t}\n522|\t\tgeneration, err := ParseGeneration(input.Generation)\n523|\t\tif err != nil {\n524|\t\t\treturn CaptureBoundary{}, nil, err\n525|\t\t}\n526|\t\tpre, err := scalar.ParseDigest(input.PreCaptureDigest)\n527|\t\tif err != nil {\n528|\t\t\treturn CaptureBoundary{}, nil, invalid(\"capture boundary pre_capture_digest is not a digest: %v\", err)\n529|\t\t}\n530|\t\tpost, err := scalar.ParseDigest(input.PostCaptureDigest)\n531|\t\tif err != nil {\n532|\t\t\treturn CaptureBoundary{}, nil, invalid(\"capture boundary post_capture_digest is not a digest: %v\", err)\n533|\t\t}\n534|\t\tboundary := CaptureBoundary{\n535|\t\t\tKind:              \"unstable_archive\",\n536|\t\t\tSourceGeneration:  &generation,\n537|\t\t\tPreCaptureDigest:  &pre,\n538|\t\t\tPostCaptureDigest: &post,\n539|\t\t}\n540|\t\treturn boundary, map[string]any{\n541|\t\t\t\"kind\":                        \"unstable_archive\",\n542|\t\t\t\"source_generation\":           generation.String(),\n543|\t\t\t\"pre_capture_digest\":          pre.String(),\n544|\t\t\t\"post_capture_digest\":         post.String(),\n545|\t\t\t\"reason_code\":                 \"source_not_quiescent\",\n546|\t\t\t\"operator_explicit\":           true,\n547|\t\t\t\"target_projection_forbidden\": true,\n548|\t\t\t\"extensions\":                  map[string]any{},\n549|\t\t}, nil\n550|\tdefault:\n551|\t\treturn CaptureBoundary{}, nil, invalid(\"capture boundary kind is outside stable|unstable_archive\")\n552|\t}\n553|}\n554|\n555|func buildStableProof(input BoundaryInput) (StableSnapshotProof, map[string]any, error) {\n556|\tif !validProofKind(input.ProofKind) {\n557|\t\treturn StableSnapshotProof{}, nil, invalid(\"stable snapshot proof kind is outside the closed proof vocabulary\")\n558|\t}\n559|\tgeneration, err := ParseGeneration(input.Generation)\n560|\tif err != nil {\n561|\t\treturn StableSnapshotProof{}, nil, err\n562|\t}\n563|\tvar identity *scalar.Digest\n564|\tif input.SnapshotIdentity != nil {\n565|\t\tvalue, err := scalar.ParseDigest(*input.SnapshotIdentity)\n566|\t\tif err != nil {\n567|\t\t\treturn StableSnapshotProof{}, nil, invalid(\"stable snapshot proof snapshot_identity_digest is not a digest: %v\", err)\n568|\t\t}\n569|\t\tidentity = &value\n570|\t}\n571|\tpre, err := scalar.ParseDigest(input.PreCaptureDigest)\n572|\tif err != nil {\n573|\t\treturn StableSnapshotProof{}, nil, invalid(\"stable snapshot proof pre_capture_digest is not a digest: %v\", err)\n574|\t}\n575|\tpost, err := scalar.ParseDigest(input.PostCaptureDigest)\n576|\tif err != nil {\n577|\t\treturn StableSnapshotProof{}, nil, invalid(\"stable snapshot proof post_capture_digest is not a digest: %v\", err)\n578|\t}\n579|\tproof := StableSnapshotProof{\n580|\t\tProofKind:         input.ProofKind,\n581|\t\tSourceGeneration:  generation,\n582|\t\tSnapshotIdentity:  identity,\n583|\t\tPreCaptureDigest:  pre,\n584|\t\tPostCaptureDigest: post,\n585|\t\tInputBlocked:      input.InputBlocked,\n586|\t\tForegroundIdle:    input.ForegroundIdle,\n587|\t\tBackgroundIdle:    input.BackgroundIdle,\n588|\t}\n589|\tif err := checkProofCoupling(proof); err != nil {\n590|\t\treturn StableSnapshotProof{}, nil, err\n591|\t}\n592|\tvar identityValue any\n593|\tif identity != nil {\n594|\t\tidentityValue = identity.String()\n595|\t}\n596|\treturn proof, map[string]any{\n597|\t\t\"proof_kind\":               proof.ProofKind,\n598|\t\t\"source_generation\":        generation.String(),\n599|\t\t\"snapshot_identity_digest\": identityValue,\n600|\t\t\"pre_capture_digest\":       pre.String(),\n601|\t\t\"post_capture_digest\":      post.String(),\n602|\t\t\"input_blocked\":            proof.InputBlocked,\n603|\t\t\"foreground_idle\":          proof.ForegroundIdle,\n604|\t\t\"background_idle\":          proof.BackgroundIdle,\n605|\t\t\"extensions\":               map[string]any{},\n606|\t}, nil\n607|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
