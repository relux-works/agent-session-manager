{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca8b","stream":{"kind":"session","id":"01a0b0cc-369a-7993-946b-ef774181fd54"},"sequence":928,"recorded_at":1780531400001851,"record_type":"event","durability":"durable","causation_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","run_stream":{"kind":"run","id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3"},"call_id":"call_01a0b0cf15ed739f838c7bc4d6c8be8b","text":"Read text file `internal/clonebundle/refusal_session_event_test.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|)\n8|\n9|// Negative tests for the Canonical Session, Canonical Event, identity,\n10|// generation, and blob-agreement gates. Every row drives a production\n11|// entry point.\n12|\n13|// unsortedPair returns two distinct fixture digests in\n14|// descending order: feeding them where ascending order is required\n15|// always exercises the unsorted refusal.\n16|func unsortedPair(seedA, seedB string) (string, string) {\n17|\tfirst, second := fixtureDigest(seedA), fixtureDigest(seedB)\n18|\tif first < second {\n19|\t\tfirst, second = second, first\n20|\t}\n21|\treturn first, second\n22|}\n23|\n24|func mustSessionBytes(t *testing.T) []byte {\n25|\tt.Helper()\n26|\tbuilt, err := BuildCanonicalSession(validSessionInput())\n27|\tif err != nil {\n28|\t\tt.Fatal(err)\n29|\t}\n30|\treturn built\n31|}\n32|\n33|func mustEventBytes(t *testing.T, status string) []byte {\n34|\tt.Helper()\n35|\tbuilt, err := BuildCanonicalEvent(validEventInput(status))\n36|\tif err != nil {\n37|\t\tt.Fatal(err)\n38|\t}\n39|\treturn built\n40|}\n41|\n42|func TestCanonicalSessionRefusals(t *testing.T) {\n43|\tt.Run(\"build actors\", func(t *testing.T) {\n44|\t\tbuild := func(actors []ActorInput) error {\n45|\t\t\tinput := validSessionInput()\n46|\t\t\tinput.Actors = actors\n47|\t\t\t_, err := BuildCanonicalSession(input)\n48|\t\t\treturn err\n49|\t\t}\n50|\t\tcases := []struct {\n51|\t\t\tname     string\n52|\t\t\tactors   []ActorInput\n53|\t\t\tfragment string\n54|\t\t}{\n55|\t\t\t{\"no actors\", nil, \"[1..1024]\"},\n56|\t\t\t{\"no main\", []ActorInput{{ActorID: fixtureActorSub, Kind: \"subagent\", ParentActorID: strptr(fixtureActorMain)}}, \"exactly one\"},\n57|\t\t\t{\"two mains\", []ActorInput{\n58|\t\t\t\t{ActorID: fixtureActorMain, Kind: \"main\"},\n59|\t\t\t\t{ActorID: fixtureActorSub, Kind: \"main\"},\n60|\t\t\t}, \"exactly one\"},\n61|\t\t\t{\"main with parent\", []ActorInput{{ActorID: fixtureActorMain, Kind: \"main\", ParentActorID: strptr(fixtureActorSub)}}, \"carries a parent\"},\n62|\t\t\t{\"non-main null parent\", []ActorInput{\n63|\t\t\t\t{ActorID: fixtureActorMain, Kind: \"main\"},\n64|\t\t\t\t{ActorID: fixtureActorSub, Kind: \"external\"},\n65|\t\t\t}, \"requires a parent\"},\n66|\t\t\t{\"duplicate actor id\", []ActorInput{\n67|\t\t\t\t{ActorID: fixtureActorMain, Kind: \"main\"},\n68|\t\t\t\t{ActorID: fixtureActorMain, Kind: \"subagent\", ParentActorID: strptr(fixtureActorMain)},\n69|\t\t\t}, \"unique by actor ID\"},\n70|\t\t\t{\"bad kind\", []ActorInput{{ActorID: fixtureActorMain, Kind: \"ghost\"}}, \"main|subagent|external\"},\n71|\t\t\t{\"bad actor id\", []ActorInput{{ActorID: \"nope\", Kind: \"main\"}}, \"not a UUIDv7\"},\n72|\t\t\t{\"unsanitized source id\", []ActorInput{{ActorID: fixtureActorMain, Kind: \"main\", SourceNativeID: strptr(\"/abs/x\")}}, \"absolute source path\"},\n73|\t\t\t{\"empty name\", []ActorInput{{ActorID: fixtureActorMain, Kind: \"main\", Name: strptr(\"\")}}, \"string[1..512]\"},\n74|\t\t}\n75|\t\tfor _, tc := range cases {\n76|\t\t\tt.Run(tc.name, func(t *testing.T) {\n77|\t\t\t\trequireRefusal(t, build(tc.actors), tc.fragment)\n78|\t\t\t})\n79|\t\t}\n80|\t})\n81|\tt.Run(\"build envelope\", func(t *testing.T) {\n82|\t\tcases := []struct {\n83|\t\t\tname     string\n84|\t\t\tmutate   func(*CanonicalSessionInput)\n85|\t\t\tfragment string\n86|\t\t}{\n87|\t\t\t{\"bad logical\", func(in *CanonicalSessionInput) { in.LogicalSessionID = \"nope\" }, \"not a UUIDv7\"},\n88|\t\t\t{\"bad tuple\", func(in *CanonicalSessionInput) { in.SourceEnvironment = []byte(`{}`) }, \"Environment Tuple\"},\n89|\t\t\t{\"unsanitized native id\", func(in *CanonicalSessionInput) { in.SourceNativeSessionID = fixtureSessionID }, \"fabricated AX\"},\n90|\t\t\t{\"empty title\", func(in *CanonicalSessionInput) { in.Title = strptr(\"\") }, \"string[1..4096]\"},\n91|\t\t\t{\"bad workspace\", func(in *CanonicalSessionInput) { in.Workspace = []byte(`{}`) }, \"workspace\"},\n92|\t\t\t{\"empty events\", func(in *CanonicalSessionInput) { in.EventIDs = nil }, \"[1..1000000]\"},\n93|\t\t\t{\"dup events\", func(in *CanonicalSessionInput) { in.EventIDs = []string{fixtureDigest(\"x\"), fixtureDigest(\"x\")} }, \"not unique\"},\n94|\t\t\t{\"bad event digest\", func(in *CanonicalSessionInput) { in.EventIDs = []string{\"nope\"} }, \"not a digest\"},\n95|\t\t\t{\"empty heads\", func(in *CanonicalSessionInput) { in.HeadEventIDs = nil }, \"[1..1024]\"},\n96|\t\t\t{\"head outside events\", func(in *CanonicalSessionInput) { in.HeadEventIDs = []string{fixtureDigest(\"elsewhere\")} }, \"outside event_ids\"},\n97|\t\t\t{\"heads unsorted\", func(in *CanonicalSessionInput) {\n98|\t\t\t\thigh, low := unsortedPair(\"unsorted-head-a\", \"unsorted-head-b\")\n99|\t\t\t\tin.EventIDs = []string{low, high}\n100|\t\t\t\tin.HeadEventIDs = []string{high, low}\n101|\t\t\t}, \"sorted unique\"},\n102|\t\t\t{\"bad created_at\", func(in *CanonicalSessionInput) { in.CreatedAt = strptr(\"yesterday\") }, \"not a timestamp\"},\n103|\t\t\t{\"bad extensions\", func(in *CanonicalSessionInput) { in.Extensions = map[string]any{\"no-dots\": 1} }, \"reverse-DNS\"},\n104|\t\t}\n105|\t\tfor _, tc := range cases {\n106|\t\t\tt.Run(tc.name, func(t *testing.T) {\n107|\t\t\t\tinput := validSessionInput()\n108|\t\t\t\ttc.mutate(&input)\n109|\t\t\t\t_, err := BuildCanonicalSession(input)\n110|\t\t\t\trequireRefusal(t, err, tc.fragment)\n111|\t\t\t})\n112|\t\t}\n113|\t})\n114|\tt.Run(\"decode\", func(t *testing.T) {\n115|\t\tvalid := mustSessionBytes(t)\n116|\t\tcases := []struct {\n117|\t\t\tname     string\n118|\t\t\tbody     func(t *testing.T) []byte\n119|\t\t\tfragment string\n120|\t\t}{\n121|\t\t\t{\"unknown member\", func(t *testing.T) []byte {\n122|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"lease\"] = \"x\" })\n123|\t\t\t}, \"unknown member\"},\n124|\t\t\t{\"bad schema\", func(t *testing.T) []byte {\n125|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"schema\"] = \"urn:ax:schema:blob\" })\n126|\t\t\t}, \"not the canonical session\"},\n127|\t\t\t{\"two mains\", func(t *testing.T) []byte {\n128|\t\t\t\treturn tamper(t, valid, func(o map[string]any) {\n129|\t\t\t\t\tactors := o[\"actors\"].([]any)\n130|\t\t\t\t\tactors[1].(map[string]any)[\"kind\"] = \"main\"\n131|\t\t\t\t\tactors[1].(map[string]any)[\"parent_actor_id\"] = nil\n132|\t\t\t\t})\n133|\t\t\t}, \"exactly one\"},\n134|\t\t\t{\"dup actors\", func(t *testing.T) []byte {\n135|\t\t\t\treturn tamper(t, valid, func(o map[string]any) {\n136|\t\t\t\t\tactors := o[\"actors\"].([]any)\n137|\t\t\t\t\tactors[1].(map[string]any)[\"actor_id\"] = actors[0].(map[string]any)[\"actor_id\"]\n138|\t\t\t\t})\n139|\t\t\t}, \"unique by actor ID\"},\n140|\t\t\t{\"dup events\", func(t *testing.T) []byte {\n141|\t\t\t\treturn tamper(t, valid, func(o map[string]any) {\n142|\t\t\t\t\tevents := o[\"event_ids\"].([]any)\n143|\t\t\t\t\to[\"event_ids\"] = []any{events[0], events[0]}\n144|\t\t\t\t})\n145|\t\t\t}, \"not unique\"},\n146|\t\t\t{\"heads unsorted\", func(t *testing.T) []byte {\n147|\t\t\t\thigh, low := unsortedPair(\"unsorted-head-a\", \"unsorted-head-b\")\n148|\t\t\t\treturn tamper(t, valid, func(o map[string]any) {\n149|\t\t\t\t\to[\"event_ids\"] = []any{low, high}\n150|\t\t\t\t\to[\"head_event_ids\"] = []any{high, low}\n151|\t\t\t\t})\n152|\t\t\t}, \"sorted unique\"},\n153|\t\t\t{\"head outside\", func(t *testing.T) []byte {\n154|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"head_event_ids\"] = []any{fixtureDigest(\"elsewhere\")} })\n155|\t\t\t}, \"outside event_ids\"},\n156|\t\t\t{\"self mismatch\", func(t *testing.T) []byte {\n157|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"canonical_session_id\"] = fixtureDigest(\"forged\") })\n158|\t\t\t}, \"omit-self digest\"},\n159|\t\t}\n160|\t\tfor _, tc := range cases {\n161|\t\t\tt.Run(tc.name, func(t *testing.T) {\n162|\t\t\t\t_, err := DecodeCanonicalSession(tc.body(t))\n163|\t\t\t\trequireRefusal(t, err, tc.fragment)\n164|\t\t\t})\n165|\t\t}\n166|\t})\n167|}\n168|\n169|func TestCanonicalEventRefusals(t *testing.T) {\n170|\tt.Run(\"build envelope\", func(t *testing.T) {\n171|\t\tcases := []struct {\n172|\t\t\tname     string\n173|\t\t\tmutate   func(*CanonicalEventInput)\n174|\t\t\tfragment string\n175|\t\t}{\n176|\t\t\t{\"bad kind\", func(in *CanonicalEventInput) { in.Kind = \"chat\" }, \"26-kind\"},\n177|\t\t\t{\"bad visibility\", func(in *CanonicalEventInput) { in.Visibility = \"secret\" }, \"public|projection|internal|opaque\"},\n178|\t\t\t{\"bad logical\", func(in *CanonicalEventInput) { in.LogicalSessionID = \"nope\" }, \"not a UUIDv7\"},\n179|\t\t\t{\"bad actor\", func(in *CanonicalEventInput) { in.ActorID = \"nope\" }, \"not a UUIDv7\"},\n180|\t\t\t{\"bad turn\", func(in *CanonicalEventInput) { in.TurnID = strptr(\"nope\") }, \"turn_id\"},\n181|\t\t\t{\"bad timestamp\", func(in *CanonicalEventInput) { in.Timestamp = strptr(\"yesterday\") }, \"not a timestamp\"},\n182|\t\t\t{\"parents unsorted\", func(in *CanonicalEventInput) {\n183|\t\t\t\thigh, low := unsortedPair(\"unsorted-parent-a\", \"unsorted-parent-b\")\n184|\t\t\t\tin.Parents = []string{high, low}\n185|\t\t\t}, \"sorted unique\"},\n186|\t\t\t{\"parents dup\", func(in *CanonicalEventInput) {\n187|\t\t\t\tin.Parents = []string{fixtureDigest(\"a\"), fixtureDigest(\"a\")}\n188|\t\t\t}, \"sorted unique\"},\n189|\t\t\t{\"payload not object\", func(in *CanonicalEventInput) { in.Payload = []byte(`[1]`) }, \"payload\"},\n190|\t\t\t{\"message missing blocks\", func(in *CanonicalEventInput) { in.Payload = []byte(`{\"extensions\":{}}`) }, \"content_blocks\"},\n191|\t\t\t{\"message extra member\", func(in *CanonicalEventInput) {\n192|\t\t\t\tin.Payload = []byte(`{\"content_blocks\":[],\"extensions\":{},\"transcript\":\"x\"}`)\n193|\t\t\t}, \"unknown member\"},\n194|\t\t\t{\"block bad type\", func(in *CanonicalEventInput) {\n195|\t\t\t\tin.Payload = []byte(`{\"content_blocks\":[{\"type\":\"video\"}],\"extensions\":{}}`)\n196|\t\t\t}, \"eight-type\"},\n197|\t\t\t{\"block missing type\", func(in *CanonicalEventInput) {\n198|\t\t\t\tin.Payload = []byte(`{\"content_blocks\":[{\"content\":\"x\"}],\"extensions\":{}}`)\n199|\t\t\t}, \"misses its type\"},\n200|\t\t\t{\"block inline oversize\", func(in *CanonicalEventInput) {\n201|\t\t\t\tin.Payload = []byte(`{\"content_blocks\":[{\"type\":\"text\",\"content\":\"` + strings.Repeat(\"x\", 65537) + `\"}],\"extensions\":{}}`)\n202|\t\t\t}, \"64 KiB\"},\n203|\t\t\t{\"block bad descriptor\", func(in *CanonicalEventInput) {\n204|\t\t\t\tin.Payload = []byte(`{\"content_blocks\":[{\"type\":\"image\",\"blob_descriptor_id\":\"nope\"}],\"extensions\":{}}`)\n205|\t\t\t}, \"not a digest\"},\n206|\t\t\t{\"block extra member\", func(in *CanonicalEventInput) {\n207|\t\t\t\tin.Payload = []byte(`{\"content_blocks\":[{\"type\":\"text\",\"blob_id\":\"x\"}],\"extensions\":{}}`)\n208|\t\t\t}, \"unknown member\"},\n209|\t\t\t{\"bad extensions\", func(in *CanonicalEventInput) { in.Extensions = map[string]any{\"no-dots\": 1} }, \"reverse-DNS\"},\n210|\t\t}\n211|\t\tfor _, tc := range cases {\n212|\t\t\tt.Run(tc.name, func(t *testing.T) {\n213|\t\t\t\tinput := validEventInput(\"exact\")\n214|\t\t\t\ttc.mutate(&input)\n215|\t\t\t\t_, err := BuildCanonicalEvent(input)\n216|\t\t\t\trequireRefusal(t, err, tc.fragment)\n217|\t\t\t})\n218|\t\t}\n219|\t\t// Inline content at exactly 64 KiB is admitted.\n220|\t\tinput := validEventInput(\"exact\")\n221|\t\tinput.Payload = []byte(`{\"content_blocks\":[{\"type\":\"text\",\"content\":\"` + strings.Repeat(\"y\", 65536) + `\"}],\"extensions\":{}}`)\n222|\t\tif _, err := BuildCanonicalEvent(input); err != nil {\n223|\t\t\tt.Fatalf(\"BuildCanonicalEvent(64 KiB inline) error = %v\", err)\n224|\t\t}\n225|\t})\n226|\tt.Run(\"decode\", func(t *testing.T) {\n227|\t\tvalid := mustEventBytes(t, \"exact\")\n228|\t\tcases := []struct {\n229|\t\t\tname     string\n230|\t\t\tbody     func(t *testing.T) []byte\n231|\t\t\tfragment string\n232|\t\t}{\n233|\t\t\t{\"unknown member\", func(t *testing.T) []byte {\n234|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"lease\"] = \"x\" })\n235|\t\t\t}, \"unknown member\"},\n236|\t\t\t{\"bad schema\", func(t *testing.T) []byte {\n237|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"schema\"] = \"urn:ax:schema:blob\" })\n238|\t\t\t}, \"not the canonical event\"},\n239|\t\t\t{\"bad kind\", func(t *testing.T) []byte {\n240|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"kind\"] = \"chat\" })\n241|\t\t\t}, \"26-kind\"},\n242|\t\t\t{\"ordinal float\", func(t *testing.T) []byte {\n243|\t\t\t\traw := strings.Replace(string(valid), `\"ordinal\":0`, `\"ordinal\":1.5`, 1)\n244|\t\t\t\treturn []byte(raw)\n245|\t\t\t}, \"not a uint53\"},\n246|\t\t\t{\"self mismatch\", func(t *testing.T) []byte {\n247|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"event_id\"] = fixtureDigest(\"forged\") })\n248|\t\t\t}, \"omit-self digest\"},\n249|\t\t}\n250|\t\tfor _, tc := range cases {\n251|\t\t\tt.Run(tc.name, func(t *testing.T) {\n252|\t\t\t\t_, err := DecodeCanonicalEvent(tc.body(t))\n253|\t\t\t\trequireRefusal(t, err, tc.fragment)\n254|\t\t\t})\n255|\t\t}\n256|\t})\n257|\tt.Run(\"evidence\", func(t *testing.T) {\n258|\t\tbuild := func(mutate func(*EvidenceInput)) error {\n259|\t\t\tinput := validEventInput(\"exact\")\n260|\t\t\tmutate(&input.Evidence)\n261|\t\t\t_, err := BuildCanonicalEvent(input)\n262|\t\t\treturn err\n263|\t\t}\n264|\t\tcases := []struct {\n265|\t\t\tname     string\n266|\t\t\tmutate   func(*EvidenceInput)\n267|\t\t\tfragment string\n268|\t\t}{\n269|\t\t\t{\"bad status\", func(ev *EvidenceInput) { ev.CaptureStatus = \"maybe\" }, \"exact|partial|synthesized|unavailable\"},\n270|\t\t\t{\"synthesized with native event\", func(ev *EvidenceInput) {\n271|\t\t\t\tev.CaptureStatus = \"synthesized\"\n272|\t\t\t\tev.CoreOperationID = strptr(fixtureOperationID)\n273|\t\t\t}, \"carries a native event ID\"},\n274|\t\t\t{\"synthesized missing operation\", func(ev *EvidenceInput) {\n275|\t\t\t\tev.CaptureStatus = \"synthesized\"\n276|\t\t\t\tev.NativeEventID = nil\n277|\t\t\t}, \"requires a core operation\"},\n278|\t\t\t{\"exact with operation\", func(ev *EvidenceInput) { ev.CoreOperationID = strptr(fixtureOperationID) }, \"carries a core operation\"},\n279|\t\t\t{\"bad tuple\", func(ev *EvidenceInput) { ev.Environment = []byte(`{}`) }, \"Environment Tuple\"},\n280|\t\t\t{\"unsanitized session\", func(ev *EvidenceInput) { ev.NativeSessionID = \"/abs\" }, \"absolute source path\"},\n281|\t\t\t{\"unsanitized event\", func(ev *EvidenceInput) { ev.NativeEventID = strptr(\"https://u:p@h/x\") }, \"embedded credentials\"},\n282|\t\t\t{\"refs unsorted\", func(ev *EvidenceInput) {\n283|\t\t\t\thigh, low := unsortedPair(\"unsorted-ref-a\", \"unsorted-ref-b\")\n284|\t\t\t\tev.RawRefs = []RawRefInput{\n285|\t\t\t\t\t{ManifestID: high, BlobDescriptorID: fixtureDigest(\"d\"), Offset: 0, Length: 1},\n286|\t\t\t\t\t{ManifestID: low, BlobDescriptorID: fixtureDigest(\"d\"), Offset: 0, Length: 1},\n287|\t\t\t\t}\n288|\t\t\t}, \"sorted unique\"},\n289|\t\t\t{\"refs dup\", func(ev *EvidenceInput) {\n290|\t\t\t\tev.RawRefs = []RawRefInput{\n291|\t\t\t\t\t{ManifestID: fixtureDigest(\"a\"), BlobDescriptorID: fixtureDigest(\"d\"), Offset: 0, Length: 1},\n292|\t\t\t\t\t{ManifestID: fixtureDigest(\"a\"), BlobDescriptorID: fixtureDigest(\"d\"), Offset: 0, Length: 1},\n293|\t\t\t\t}\n294|\t\t\t}, \"sorted unique\"},\n295|\t\t\t{\"ref bad manifest\", func(ev *EvidenceInput) { ev.RawRefs[0].ManifestID = \"nope\" }, \"not a digest\"},\n296|\t\t\t{\"reasons unsorted\", func(ev *EvidenceInput) { ev.ReasonCodes = []string{\"b\", \"a\"} }, \"sorted unique\"},\n297|\t\t\t{\"reason empty\", func(ev *EvidenceInput) { ev.ReasonCodes = []string{\"\"} }, \"string[1..128]\"},\n298|\t\t\t{\"bad operation\", func(ev *EvidenceInput) {\n299|\t\t\t\tev.CaptureStatus = \"synthesized\"\n300|\t\t\t\tev.NativeEventID = nil\n301|\t\t\t\tev.CoreOperationID = strptr(\"nope\")\n302|\t\t\t}, \"not a UUIDv7\"},\n303|\t\t}\n304|\t\tfor _, tc := range cases {\n305|\t\t\tt.Run(tc.name, func(t *testing.T) {\n306|\t\t\t\trequireRefusal(t, build(tc.mutate), tc.fragment)\n307|\t\t\t})\n308|\t\t}\n309|\t\t// Decode-side evidence coupling.\n310|\t\tvalid := mustEventBytes(t, \"exact\")\n311|\t\ttampered := tamper(t, valid, func(o map[string]any) {\n312|\t\t\tevidence := o[\"source_evidence\"].(map[string]any)\n313|\t\t\tevidence[\"capture_status\"] = \"synthesized\"\n314|\t\t\tevidence[\"core_operation_id\"] = nil\n315|\t\t\tevidence[\"native_event_id\"] = nil\n316|\t\t})\n317|\t\tif _, err := DecodeCanonicalEvent(tampered); !errors.Is(err, ErrInvalid) {\n318|\t\t\tt.Fatalf(\"synthesized-without-operation decode error = %v, want ErrInvalid\", err)\n319|\t\t}\n320|\t})\n321|}\n322|\n323|func TestIdentityRefusals(t *testing.T) {\n324|\tt.Run(\"native identity\", func(t *testing.T) {\n325|\t\tencode := func(mutate func(map[string]any)) []byte {\n326|\t\t\tidentity := fixtureNativeIdentity()\n327|\t\t\tgeneration, err := EncodeNativeIdentity(identity, nil)\n328|\t\t\tif err != nil {\n329|\t\t\t\tt.Fatal(err)\n330|\t\t\t}\n331|\t\t\treturn tamper(t, generation, mutate)\n332|\t\t}\n333|\t\tcases := []struct {\n334|\t\t\tname     string\n335|\t\t\tbody     []byte\n336|\t\t\tfragment string\n337|\t\t}{\n338|\t\t\t{\"bad kind\", encode(func(o map[string]any) { o[\"identity_kind\"] = \"imported\" }), \"provider_native|official_import|continuation_context\"},\n339|\t\t\t{\"absolute id\", encode(func(o map[string]any) { o[\"native_session_id\"] = \"/abs/x\" }), \"absolute source path\"},\n340|\t\t\t{\"uuid id\", encode(func(o map[string]any) { o[\"native_session_id\"] = fixtureSessionID }), \"fabricated AX\"},\n341|\t\t\t{\"control id\", encode(func(o map[string]any) { o[\"native_session_id\"] = \"a\\x7fb\" }), \"control characters\"},\n342|\t\t\t{\"credential id\", encode(func(o map[string]any) { o[\"native_session_id\"] = \"https://u:p@h/x\" }), \"embedded credentials\"},\n343|\t\t\t{\"ax marker id\", encode(func(o map[string]any) { o[\"native_session_id\"] = \"urn:ax:evil\" }), \"AX identity marker\"},\n344|\t\t\t{\"bad workspace\", encode(func(o map[string]any) { o[\"logical_workspace_id\"] = \"nope\" }), \"not a UUIDv7\"},\n345|\t\t\t{\"bad fingerprint\", encode(func(o map[string]any) { o[\"backend_realm_fingerprint\"] = \"nope\" }), \"not a digest\"},\n346|\t\t\t{\"unsanitized opaque\", encode(func(o map[string]any) { o[\"opaque_identity\"] = \"/abs/opaque\" }), \"absolute source path\"},\n347|\t\t\t{\"unknown member\", encode(func(o map[string]any) { o[\"token\"] = \"x\" }), \"unknown member\"},\n348|\t\t\t{\"missing member\", encode(func(o map[string]any) { delete(o, \"identity_kind\") }), \"misses\"},\n349|\t\t\t{\"bad extensions\", encode(func(o map[string]any) { o[\"extensions\"] = map[string]any{\"x\": 1} }), \"reverse-DNS\"},\n350|\t\t}\n351|\t\tfor _, tc := range cases {\n352|\t\t\tt.Run(tc.name, func(t *testing.T) {\n353|\t\t\t\t_, err := DecodeNativeIdentity(tc.body)\n354|\t\t\t\trequireRefusal(t, err, tc.fragment)\n355|\t\t\t})\n356|\t\t}\n357|\t\t// Non-null fingerprint and opaque identity admit.\n358|\t\tadmitted := encode(func(o map[string]any) {\n359|\t\t\to[\"backend_realm_fingerprint\"] = fixtureDigest(\"realm\")\n360|\t\t\to[\"opaque_identity\"] = \"opaque-native-1\"\n361|\t\t})\n362|\t\tif _, err := DecodeNativeIdentity(admitted); err != nil {\n363|\t\t\tt.Fatalf(\"DecodeNativeIdentity(full) error = %v\", err)\n364|\t\t}\n365|\t})\n366|\tt.Run(\"workspace binding\", func(t *testing.T) {\n367|\t\tencode := func(mutate func(map[string]any)) []byte {\n368|\t\t\treturn tamper(t, []byte(fixtureWorkspaceJSON()), mutate)\n369|\t\t}\n370|\t\tcases := []struct {\n371|\t\t\tname     string\n372|\t\t\tbody     []byte\n373|\t\t\tfragment string\n374|\t\t}{\n375|\t\t\t{\"absolute cwd\", encode(func(o map[string]any) { o[\"cwd_relative\"] = \"/abs/x\" }), \"beneath the workspace root\"},\n376|\t\t\t{\"escape cwd\", encode(func(o map[string]any) { o[\"cwd_relative\"] = \"../escape\" }), \"beneath the workspace root\"},\n377|\t\t\t{\"dot cwd\", encode(func(o map[string]any) { o[\"cwd_relative\"] = \"a/./b\" }), \"beneath the workspace root\"},\n378|\t\t\t{\"backslash cwd\", encode(func(o map[string]any) { o[\"cwd_relative\"] = `a\\b` }), \"beneath the workspace root\"},\n379|\t\t\t{\"empty cwd\", encode(func(o map[string]any) { o[\"cwd_relative\"] = \"\" }), \"string[1..4096]\"},\n380|\t\t\t{\"bad workspace id\", encode(func(o map[string]any) { o[\"logical_workspace_id\"] = \"nope\" }), \"not a UUIDv7\"},\n381|\t\t\t{\"prints unsorted\", func() []byte {\n382|\t\t\t\thigh, low := unsortedPair(\"unsorted-print-a\", \"unsorted-print-b\")\n383|\t\t\t\treturn encode(func(o map[string]any) {\n384|\t\t\t\t\to[\"repository_remote_fingerprints\"] = []any{high, low}\n385|\t\t\t\t})\n386|\t\t\t}(), \"sorted unique\"},\n387|\t\t\t{\"print bad digest\", encode(func(o map[string]any) {\n388|\t\t\t\to[\"repository_remote_fingerprints\"] = []any{\"nope\"}\n389|\t\t\t}), \"sorted unique\"},\n390|\t\t\t{\"empty branch\", encode(func(o map[string]any) { o[\"branch\"] = \"\" }), \"string[1..1024]\"},\n391|\t\t\t{\"bad head\", encode(func(o map[string]any) { o[\"head_digest\"] = \"nope\" }), \"not a digest\"},\n392|\t\t\t{\"unknown member\", encode(func(o map[string]any) { o[\"root\"] = \"/\" }), \"unknown member\"},\n393|\t\t}\n394|\t\tfor _, tc := range cases {\n395|\t\t\tt.Run(tc.name, func(t *testing.T) {\n396|\t\t\t\t_, err := DecodeWorkspaceBinding(tc.body)\n397|\t\t\t\trequireRefusal(t, err, tc.fragment)\n398|\t\t\t})\n399|\t\t}\n400|\t\t// The workspace root itself admits.\n401|\t\tif _, err := DecodeWorkspaceBinding(encode(func(o map[string]any) { o[\"cwd_relative\"] = \".\" })); err != nil {\n402|\t\t\tt.Fatalf(\"DecodeWorkspaceBinding(root) error = %v\", err)\n403|\t\t}\n404|\t})\n405|\tt.Run(\"sanitizer\", func(t *testing.T) {\n406|\t\tfor _, key := range []string{\"\", \"a\\x00b\", \"/abs\", `\\\\host\\share`, \"C:\\\\win\", \"C:/win\",\n407|\t\t\tfixtureSessionID, \"urn:ax:schema:blob\", \"https://u:p@h/x\", \"a\\x1fb\"} {\n408|\t\t\tif err := SanitizeNativeKey(key); !errors.Is(err, ErrInvalid) {\n409|\t\t\t\tt.Fatalf(\"SanitizeNativeKey(%q) error = %v, want ErrInvalid\", key, err)\n410|\t\t\t}\n411|\t\t}\n412|\t\tfor _, key := range []string{\"native-1\", \"store/blob-a\", \"tmux:0\", \"a@b\", \"https://host/x\", \"user@host\"} {\n413|\t\t\tif err := SanitizeNativeKey(key); err != nil {\n414|\t\t\t\tt.Fatalf(\"SanitizeNativeKey(%q) error = %v\", key, err)\n415|\t\t\t}\n416|\t\t}\n417|\t})\n418|}\n419|\n420|func TestGenerationRefusals(t *testing.T) {\n421|\tif _, err := ParseGeneration(\"\"); !errors.Is(err, ErrInvalid) {\n422|\t\tt.Fatalf(\"ParseGeneration(empty) error = %v, want ErrInvalid\", err)\n423|\t}\n424|\tif _, err := ParseGeneration(strings.Repeat(\"g\", 513)); !errors.Is(err, ErrInvalid) {\n425|\t\tt.Fatalf(\"ParseGeneration(513) error = %v, want ErrInvalid\", err)\n426|\t}\n427|\tfirst, err := ParseGeneration(\"generation-1\")\n428|\tif err != nil {\n429|\t\tt.Fatal(err)\n430|\t}\n431|\tsecond, err := ParseGeneration(\"generation-1\")\n432|\tif err != nil {\n433|\t\tt.Fatal(err)\n434|\t}\n435|\tthird, err := ParseGeneration(\"generation-2\")\n436|\tif err != nil {\n437|\t\tt.Fatal(err)\n438|\t}\n439|\tif !first.Equal(second) || first.Equal(third) {\n440|\t\tt.Fatal(\"Generation equality is wrong\")\n441|\t}\n442|\tif err := CheckDigestsEqual(mustDigest(t, fixtureDigest(\"a\")), mustDigest(t, fixtureDigest(\"a\"))); err != nil {\n443|\t\tt.Fatalf(\"CheckDigestsEqual(equal) error = %v\", err)\n444|\t}\n445|\tif err := CheckDigestsEqual(mustDigest(t, fixtureDigest(\"a\")), mustDigest(t, fixtureDigest(\"b\"))); !errors.Is(err, ErrInvalid) {\n446|\t\tt.Fatalf(\"CheckDigestsEqual(differ) error = %v, want ErrInvalid\", err)\n447|\t}\n448|}\n449|\n450|func TestBlobAgreementRefusals(t *testing.T) {\n451|\tdescriptor, blobID, _, size := makeDescriptor(t, []byte(\"evidence\"))\n452|\tblob := mustDigest(t, blobID)\n453|\tif err := VerifyDescriptorAgreement(descriptor, blob, size); err != nil {\n454|\t\tt.Fatalf(\"VerifyDescriptorAgreement() error = %v\", err)\n455|\t}\n456|\tif err := VerifyDescriptorAgreement(descriptor, mustDigest(t, fixtureDigest(\"other\")), size); !errors.Is(err, ErrInvalid) {\n457|\t\tt.Fatalf(\"blob disagreement error = %v, want ErrInvalid\", err)\n458|\t}\n459|\tif err := VerifyDescriptorAgreement(descriptor, blob, size+1); !errors.Is(err, ErrInvalid) {\n460|\t\tt.Fatalf(\"size disagreement error = %v, want ErrInvalid\", err)\n461|\t}\n462|\ttampered := append([]byte(nil), descriptor...)\n463|\ttampered[len(tampered)-10] ^= 0xff\n464|\tif err := VerifyDescriptorAgreement(tampered, blob, size); !errors.Is(err, ErrInvalid) {\n465|\t\tt.Fatalf(\"tampered descriptor error = %v, want ErrInvalid\", err)\n466|\t}\n467|\tresealed := tamper(t, descriptor, func(o map[string]any) { o[\"descriptor_id\"] = fixtureDigest(\"forged-descriptor\") })\n468|\tif err := VerifyDescriptorAgreement(resealed, blob, size); !errors.Is(err, ErrInvalid) {\n469|\t\tt.Fatalf(\"wrong-claim descriptor error = %v, want ErrInvalid\", err)\n470|\t} else if !strings.Contains(err.Error(), \"omit-self digest\") {\n471|\t\tt.Fatalf(\"wrong-claim descriptor error = %v, want the claim comparison to fire\", err)\n472|\t}\n473|\tif err := VerifyDescriptorAgreement([]byte(`{}`), blob, size); !errors.Is(err, ErrInvalid) {\n474|\t\tt.Fatalf(\"empty object error = %v, want ErrInvalid\", err)\n475|\t}\n476|\tstore := openFixtureStore(t)\n477|\tif _, err := InstallRawBlob(nil, descriptor, strings.NewReader(\"evidence\")); !errors.Is(err, ErrInvalid) {\n478|\t\tt.Fatalf(\"InstallRawBlob(nil store) error = %v, want ErrInvalid\", err)\n479|\t}\n480|\tif _, err := InstallRawBlob(store, []byte(`{}`), strings.NewReader(\"evidence\")); !errors.Is(err, ErrInvalid) {\n481|\t\tt.Fatalf(\"InstallRawBlob(bad descriptor) error = %v, want ErrInvalid\", err)\n482|\t}\n483|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
