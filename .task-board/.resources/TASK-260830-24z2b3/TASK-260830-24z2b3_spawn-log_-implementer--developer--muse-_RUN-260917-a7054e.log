put = validCaptureInput(t)\n346|\t\tinput.CreatedAt = \"yesterday\"\n347|\t\tif _, err := BuildCaptureManifest(input); !errors.Is(err, ErrInvalid) {\n348|\t\t\tt.Fatalf(\"bad created_at error = %v, want ErrInvalid\", err)\n349|\t\t}\n350|\t\tinput = validCaptureInput(t)\n351|\t\tinput.SourceBasis.Kind = \"mystery\"\n352|\t\tif _, err := BuildCaptureManifest(input); !errors.Is(err, ErrInvalid) {\n353|\t\t\tt.Fatalf(\"bad basis kind error = %v, want ErrInvalid\", err)\n354|\t\t}\n355|\t\tinput = validCaptureInput(t)\n356|\t\tinput.Boundary.Kind = \"mystery\"\n357|\t\tif _, err := BuildCaptureManifest(input); !errors.Is(err, ErrInvalid) {\n358|\t\t\tt.Fatalf(\"bad boundary kind error = %v, want ErrInvalid\", err)\n359|\t\t}\n360|\t})\n361|}\n362|\n363|func TestBoundaryRefusals(t *testing.T) {\n364|\tt.Run(\"decode stable proof\", func(t *testing.T) {\n365|\t\tproof := func(mutate func(map[string]any)) []byte {\n366|\t\t\tbase := map[string]any{\n367|\t\t\t\t\"proof_kind\": \"closed_store\", \"source_generation\": \"g\",\n368|\t\t\t\t\"snapshot_identity_digest\": nil,\n369|\t\t\t\t\"pre_capture_digest\":       fixtureDigest(\"test-pre-capture\"),\n370|\t\t\t\t\"post_capture_digest\":      fixtureDigest(\"test-pre-capture\"),\n371|\t\t\t\t\"input_blocked\":            true, \"foreground_idle\": true, \"background_idle\": true,\n372|\t\t\t\t\"extensions\": map[string]any{},\n373|\t\t\t}\n374|\t\t\tmutate(base)\n375|\t\t\tout, err := json.Marshal(base)\n376|\t\t\tif err != nil {\n377|\t\t\t\tt.Fatal(err)\n378|\t\t\t}\n379|\t\t\treturn out\n380|\t\t}\n381|\t\tcases := []struct {\n382|\t\t\tname     string\n383|\t\t\tbody     []byte\n384|\t\t\tfragment string\n385|\t\t}{\n386|\t\t\t{\"unequal digests\", proof(func(o map[string]any) { o[\"post_capture_digest\"] = fixtureDigest(\"other\") }), \"differ\"},\n387|\t\t\t{\"bad kind\", proof(func(o map[string]any) { o[\"proof_kind\"] = \"file_size\" }), \"proof vocabulary\"},\n388|\t\t\t{\"closed_store with identity\", proof(func(o map[string]any) { o[\"snapshot_identity_digest\"] = fixtureDigest(\"x\") }), \"null snapshot identity\"},\n389|\t\t\t{\"closed_store idle false\", proof(func(o map[string]any) { o[\"foreground_idle\"] = false }), \"requires input_blocked\"},\n390|\t\t\t{\"snapshot null identity\", proof(func(o map[string]any) {\n391|\t\t\t\to[\"proof_kind\"] = \"immutable_snapshot\"\n392|\t\t\t}), \"non-null snapshot identity\"},\n393|\t\t\t{\"log prefix null identity\", proof(func(o map[string]any) {\n394|\t\t\t\to[\"proof_kind\"] = \"verified_log_prefix\"\n395|\t\t\t}), \"non-null snapshot identity\"},\n396|\t\t\t{\"quiescence idle false\", proof(func(o map[string]any) {\n397|\t\t\t\to[\"proof_kind\"] = \"provider_quiescence\"\n398|\t\t\t\to[\"background_idle\"] = false\n399|\t\t\t}), \"requires input_blocked\"},\n400|\t\t\t{\"empty generation\", proof(func(o map[string]any) { o[\"source_generation\"] = \"\" }), \"string[1..512]\"},\n401|\t\t}\n402|\t\tfor _, tc := range cases {\n403|\t\t\tt.Run(tc.name, func(t *testing.T) {\n404|\t\t\t\t_, err := DecodeStableSnapshotProof(tc.body)\n405|\t\t\t\trequireRefusal(t, err, tc.fragment)\n406|\t\t\t})\n407|\t\t}\n408|\t\t// Non-null identity admits the snapshot kinds.\n409|\t\tadmitted := proof(func(o map[string]any) {\n410|\t\t\to[\"proof_kind\"] = \"immutable_snapshot\"\n411|\t\t\to[\"snapshot_identity_digest\"] = fixtureDigest(\"snap\")\n412|\t\t\to[\"foreground_idle\"] = false\n413|\t\t})\n414|\t\tif _, err := DecodeStableSnapshotProof(admitted); err != nil {\n415|\t\t\tt.Fatalf(\"DecodeStableSnapshotProof(snapshot) error = %v\", err)\n416|\t\t}\n417|\t})\n418|\tt.Run(\"decode boundary\", func(t *testing.T) {\n419|\t\tstableProof := `{\"proof_kind\":\"closed_store\",\"source_generation\":\"g\",\"snapshot_identity_digest\":null,` +\n420|\t\t\t`\"pre_capture_digest\":\"` + fixtureDigest(\"test-pre-capture\") + `\",\"post_capture_digest\":\"` + fixtureDigest(\"test-pre-capture\") +\n421|\t\t\t`\",\"input_blocked\":true,\"foreground_idle\":true,\"background_idle\":true,\"extensions\":{}}`\n422|\t\tcases := []struct {\n423|\t\t\tname     string\n424|\t\t\tbody     string\n425|\t\t\tfragment string\n426|\t\t}{\n427|\t\t\t{\"bad kind\", `{\"kind\":\"maybe\",\"extensions\":{}}`, \"stable|unstable_archive\"},\n428|\t\t\t{\"stable missing proof\", `{\"kind\":\"stable\",\"extensions\":{}}`, \"misses\"},\n429|\t\t\t{\"stable bad proof\", `{\"kind\":\"stable\",\"proof\":{},\"extensions\":{}}`, \"misses\"},\n430|\t\t\t{\"unstable bad reason\", `{\"kind\":\"unstable_archive\",\"source_generation\":\"g\",\"pre_capture_digest\":\"` + fixtureDigest(\"a\") + `\",\"post_capture_digest\":\"` + fixtureDigest(\"b\") + `\",\"reason_code\":\"tired\",\"operator_explicit\":true,\"target_projection_forbidden\":true,\"extensions\":{}}`, \"source_not_quiescent\"},\n431|\t\t\t{\"unstable operator false\", `{\"kind\":\"unstable_archive\",\"source_generation\":\"g\",\"pre_capture_digest\":\"` + fixtureDigest(\"a\") + `\",\"post_capture_digest\":\"` + fixtureDigest(\"b\") + `\",\"reason_code\":\"source_not_quiescent\",\"operator_explicit\":false,\"target_projection_forbidden\":true,\"extensions\":{}}`, \"operator_explicit\"},\n432|\t\t\t{\"unstable projection false\", `{\"kind\":\"unstable_archive\",\"source_generation\":\"g\",\"pre_capture_digest\":\"` + fixtureDigest(\"a\") + `\",\"post_capture_digest\":\"` + fixtureDigest(\"b\") + `\",\"reason_code\":\"source_not_quiescent\",\"operator_explicit\":true,\"target_projection_forbidden\":false,\"extensions\":{}}`, \"target_projection_forbidden\"},\n433|\t\t\t{\"unstable extra\", `{\"kind\":\"unstable_archive\",\"source_generation\":\"g\",\"pre_capture_digest\":\"` + fixtureDigest(\"a\") + `\",\"post_capture_digest\":\"` + fixtureDigest(\"b\") + `\",\"reason_code\":\"source_not_quiescent\",\"operator_explicit\":true,\"target_projection_forbidden\":true,\"proof\":{},\"extensions\":{}}`, \"unknown member\"},\n434|\t\t}\n435|\t\tfor _, tc := range cases {\n436|\t\t\tt.Run(tc.name, func(t *testing.T) {\n437|\t\t\t\t_, err := DecodeCaptureBoundary([]byte(tc.body))\n438|\t\t\t\trequireRefusal(t, err, tc.fragment)\n439|\t\t\t})\n440|\t\t}\n441|\t\tif _, err := DecodeCaptureBoundary([]byte(`{\"kind\":\"stable\",\"proof\":` + stableProof + `,\"extensions\":{}}`)); err != nil {\n442|\t\t\tt.Fatalf(\"DecodeCaptureBoundary(stable) error = %v\", err)\n443|\t\t}\n444|\t\tif err := RefuseUnstableForTarget(CaptureBoundary{Kind: \"mystery\"}); !errors.Is(err, ErrInvalid) {\n445|\t\t\tt.Fatalf(\"RefuseUnstableForTarget(mystery) error = %v, want ErrInvalid\", err)\n446|\t\t}\n447|\t})\n448|\tt.Run(\"build core-only unstable\", func(t *testing.T) {\n449|\t\tinput := validCaptureInput(t)\n450|\t\tinput.Boundary = BoundaryInput{\n451|\t\t\tKind: \"unstable_archive\", Generation: \"g\",\n452|\t\t\tPreCaptureDigest: fixtureDigest(\"a\"), PostCaptureDigest: fixtureDigest(\"b\"),\n453|\t\t}\n454|\t\t_, err := BuildCaptureManifest(input)\n455|\t\trequireRefusal(t, err, \"core-created only\")\n456|\t})\n457|}\n458|\n459|func TestSourceBasisRefusals(t *testing.T) {\n460|\tcases := []struct {\n461|\t\tname     string\n462|\t\tbody     string\n463|\t\tfragment string\n464|\t}{\n465|\t\t{\"bad kind\", `{\"kind\":\"mystery\",\"extensions\":{}}`, \"ax_session|external_native\"},\n466|\t\t{\"missing kind\", `{\"extensions\":{}}`, \"misses\"},\n467|\t\t{\"ax missing members\", `{\"kind\":\"ax_session\",\"source_session_id\":\"` + fixtureSessionID + `\",\"extensions\":{}}`, \"misses\"},\n468|\t\t{\"ax bad session\", `{\"kind\":\"ax_session\",\"source_session_id\":\"nope\",\"source_session_record_id\":\"` + fixtureDigest(\"a\") + `\",\"source_checkpoint_id\":\"` + fixtureDigest(\"b\") + `\",\"source_provider_identity_record_id\":\"` + fixtureDigest(\"c\") + `\",\"extensions\":{}}`, \"not a UUIDv7\"},\n469|\t\t{\"ax bad record\", `{\"kind\":\"ax_session\",\"source_session_id\":\"` + fixtureSessionID + `\",\"source_session_record_id\":\"nope\",\"source_checkpoint_id\":\"` + fixtureDigest(\"b\") + `\",\"source_provider_identity_record_id\":\"` + fixtureDigest(\"c\") + `\",\"extensions\":{}}`, \"not a digest\"},\n470|\t\t{\"ax extra\", `{\"kind\":\"ax_session\",\"source_session_id\":\"` + fixtureSessionID + `\",\"source_session_record_id\":\"` + fixtureDigest(\"a\") + `\",\"source_checkpoint_id\":\"` + fixtureDigest(\"b\") + `\",\"source_provider_identity_record_id\":\"` + fixtureDigest(\"c\") + `\",\"external_source_ref\":\"x\",\"extensions\":{}}`, \"unknown member\"},\n471|\t\t{\"external missing ref\", `{\"kind\":\"external_native\",\"extensions\":{}}`, \"misses\"},\n472|\t\t{\"external absolute ref\", `{\"kind\":\"external_native\",\"external_source_ref\":\"/abs/path\",\"extensions\":{}}`, \"absolute source path\"},\n473|\t\t{\"external uuid ref\", `{\"kind\":\"external_native\",\"external_source_ref\":\"` + fixtureSessionID + `\",\"extensions\":{}}`, \"fabricated AX\"},\n474|\t\t{\"external extra\", `{\"kind\":\"external_native\",\"external_source_ref\":\"native-x\",\"source_session_id\":\"` + fixtureSessionID + `\",\"extensions\":{}}`, \"unknown member\"},\n475|\t}\n476|\tfor _, tc := range cases {\n477|\t\tt.Run(tc.name, func(t *testing.T) {\n478|\t\t\t_, err := DecodeSourceBasis([]byte(tc.body))\n479|\t\t\trequireRefusal(t, err, tc.fragment)\n480|\t\t})\n481|\t}\n482|\tadmitted, err := DecodeSourceBasis([]byte(`{\"kind\":\"external_native\",\"external_source_ref\":\"native-x\",\"extensions\":{}}`))\n483|\tif err != nil {\n484|\t\tt.Fatalf(\"DecodeSourceBasis(external) error = %v\", err)\n485|\t}\n486|\tif admitted.Kind != \"external_native\" || admitted.ExternalSourceRef == nil {\n487|\t\tt.Fatalf(\"external basis = %+v\", admitted)\n488|\t}\n489|\tt.Run(\"build union\", func(t *testing.T) {\n490|\t\tinput := validCaptureInput(t)\n491|\t\tinput.SourceBasis = SourceBasisInput{Kind: \"ax_session\", SourceSessionID: fixtureSessionID,\n492|\t\t\tSourceSessionRecordID: fixtureDigest(\"a\"), SourceCheckpointID: fixtureDigest(\"b\"),\n493|\t\t\tSourceProviderIdentityID: fixtureDigest(\"c\"), ExternalSourceRef: \"x\"}\n494|\t\t_, err := BuildCaptureManifest(input)\n495|\t\trequireRefusal(t, err, \"external source reference\")\n496|\t\tinput.SourceBasis = SourceBasisInput{Kind: \"external_native\", ExternalSourceRef: \"native-x\", SourceSessionID: fixtureSessionID}\n497|\t\t_, err = BuildCaptureManifest(input)\n498|\t\trequireRefusal(t, err, \"ax_session members\")\n499|\t\tinput.SourceBasis = SourceBasisInput{Kind: \"external_native\", ExternalSourceRef: \"native-x\"}\n500|\t\tif _, err := BuildCaptureManifest(input); err != nil {\n(more lines below)","final_result":true}}}
