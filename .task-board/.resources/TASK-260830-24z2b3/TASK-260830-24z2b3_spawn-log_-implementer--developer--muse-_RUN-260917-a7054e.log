{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca87","stream":{"kind":"session","id":"01a0b0cc-369a-7993-946b-ef774181fd54"},"sequence":926,"recorded_at":1780531400001847,"record_type":"event","durability":"durable","causation_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","run_stream":{"kind":"run","id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3"},"task_stream":{"kind":"task","id":"01a0b0cf-1d87-7f43-bc0f-edf9bb98f5a7"},"task_id":"01a0b0cf-1d87-7f43-bc0f-edf9bb98f5a7","event":{"kind":"output","task_id":"01a0b0cf-1d87-7f43-bc0f-edf9bb98f5a7","chunk":"Read text file `internal/clonebundle/refusal_session_event_test.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|)\n8|\n9|// Negative tests for the Canonical Session, Canonical Event, identity,\n10|// generation, and blob-agreement gates. Every row drives a production\n11|// entry point.\n12|\n13|// unsortedPair returns two distinct fixture digests in\n14|// descending order: feeding them where ascending order is required\n15|// always exercises the unsorted refusal.\n16|func unsortedPair(seedA, seedB string) (string, string) {\n17|\tfirst, second := fixtureDigest(seedA), fixtureDigest(seedB)\n18|\tif first < second {\n19|\t\tfirst, second = second, first\n20|\t}\n21|\treturn first, second\n22|}\n23|\n24|func mustSessionBytes(t *testing.T) []byte {\n25|\tt.Helper()\n26|\tbuilt, err := BuildCanonicalSession(validSessionInput())\n27|\tif err != nil {\n28|\t\tt.Fatal(err)\n29|\t}\n30|\treturn built\n31|}\n32|\n33|func mustEventBytes(t *testing.T, status string) []byte {\n34|\tt.Helper()\n35|\tbuilt, err := BuildCanonicalEvent(validEventInput(status))\n36|\tif err != nil {\n37|\t\tt.Fatal(err)\n38|\t}\n39|\treturn built\n40|}\n41|\n42|func TestCanonicalSessionRefusals(t *testing.T) {\n43|\tt.Run(\"build actors\", func(t *testing.T) {\n44|\t\tbuild := func(actors []ActorInput) error {\n45|\t\t\tinput := validSessionInput()\n46|\t\t\tinput.Actors = actors\n47|\t\t\t_, err := BuildCanonicalSession(input)\n48|\t\t\treturn err\n49|\t\t}\n50|\t\tcases := []struct {\n51|\t\t\tname     string\n52|\t\t\tactors   []ActorInput\n53|\t\t\tfragment string\n54|\t\t}{\n55|\t\t\t{\"no actors\", nil, \"[1..1024]\"},\n56|\t\t\t{\"no main\", []ActorInput{{ActorID: fixtureActorSub, Kind: \"subagent\", ParentActorID: strptr(fixtureActorMain)}}, \"exactly one\"},\n57|\t\t\t{\"two mains\", []ActorInput{\n58|\t\t\t\t{ActorID: fixtureActorMain, Kind: \"main\"},\n59|\t\t\t\t{ActorID: fixtureActorSub, Kind: \"main\"},\n60|\t\t\t}, \"exactly one\"},\n61|\t\t\t{\"main with parent\", []ActorInput{{ActorID: fixtureActorMain, Kind: \"main\", ParentActorID: strptr(fixtureActorSub)}}, \"carries a parent\"},\n62|\t\t\t{\"non-main null parent\", []ActorInput{\n63|\t\t\t\t{ActorID: fixtureActorMain, Kind: \"main\"},\n64|\t\t\t\t{ActorID: fixtureActorSub, Kind: \"external\"},\n65|\t\t\t}, \"requires a parent\"},\n66|\t\t\t{\"duplicate actor id\", []ActorInput{\n67|\t\t\t\t{ActorID: fixtureActorMain, Kind: \"main\"},\n68|\t\t\t\t{ActorID: fixtureActorMain, Kind: \"subagent\", ParentActorID: strptr(fixtureActorMain)},\n69|\t\t\t}, \"unique by actor ID\"},\n70|\t\t\t{\"bad kind\", []ActorInput{{ActorID: fixtureActorMain, Kind: \"ghost\"}}, \"main|subagent|external\"},\n71|\t\t\t{\"bad actor id\", []ActorInput{{ActorID: \"nope\", Kind: \"main\"}}, \"not a UUIDv7\"},\n72|\t\t\t{\"unsanitized source id\", []ActorInput{{ActorID: fixtureActorMain, Kind: \"main\", SourceNativeID: strptr(\"/abs/x\")}}, \"absolute source path\"},\n73|\t\t\t{\"empty name\", []ActorInput{{ActorID: fixtureActorMain, Kind: \"main\", Name: strptr(\"\")}}, \"string[1..512]\"},\n74|\t\t}\n75|\t\tfor _, tc := range cases {\n76|\t\t\tt.Run(tc.name, func(t *testing.T) {\n77|\t\t\t\trequireRefusal(t, build(tc.actors), tc.fragment)\n78|\t\t\t})\n79|\t\t}\n80|\t})\n81|\tt.Run(\"build envelope\", func(t *testing.T) {\n82|\t\tcases := []struct {\n83|\t\t\tname     string\n84|\t\t\tmutate   func(*CanonicalSessionInput)\n85|\t\t\tfragment string\n86|\t\t}{\n87|\t\t\t{\"bad logical\", func(in *CanonicalSessionInput) { in.LogicalSessionID = \"nope\" }, \"not a UUIDv7\"},\n88|\t\t\t{\"bad tuple\", func(in *CanonicalSessionInput) { in.SourceEnvironment = []byte(`{}`) }, \"Environment Tuple\"},\n89|\t\t\t{\"unsanitized native id\", func(in *CanonicalSessionInput) { in.SourceNativeSessionID = fixtureSessionID }, \"fabricated AX\"},\n90|\t\t\t{\"empty title\", func(in *CanonicalSessionInput) { in.Title = strptr(\"\") }, \"string[1..4096]\"},\n91|\t\t\t{\"bad workspace\", func(in *CanonicalSessionInput) { in.Workspace = []byte(`{}`) }, \"workspace\"},\n92|\t\t\t{\"empty events\", func(in *CanonicalSessionInput) { in.EventIDs = nil }, \"[1..1000000]\"},\n93|\t\t\t{\"dup events\", func(in *CanonicalSessionInput) { in.EventIDs = []string{fixtureDigest(\"x\"), fixtureDigest(\"x\")} }, \"not unique\"},\n94|\t\t\t{\"bad event digest\", func(in *CanonicalSessionInput) { in.EventIDs = []string{\"nope\"} }, \"not a digest\"},\n95|\t\t\t{\"empty heads\", func(in *CanonicalSessionInput) { in.HeadEventIDs = nil }, \"[1..1024]\"},\n96|\t\t\t{\"head outside events\", func(in *CanonicalSessionInput) { in.HeadEventIDs = []string{fixtureDigest(\"elsewhere\")} }, \"outside event_ids\"},\n97|\t\t\t{\"heads unsorted\", func(in *CanonicalSessionInput) {\n98|\t\t\t\thigh, low := unsortedPair(\"unsorted-head-a\", \"unsorted-head-b\")\n99|\t\t\t\tin.EventIDs = []string{low, high}\n100|\t\t\t\tin.HeadEventIDs = []string{high, low}\n101|\t\t\t}, \"sorted unique\"},\n102|\t\t\t{\"bad created_at\", func(in *CanonicalSessionInput) { in.CreatedAt = strptr(\"yesterday\") }, \"not a timestamp\"},\n103|\t\t\t{\"bad extensions\", func(in *CanonicalSessionInput) { in.Extensions = map[string]any{\"no-dots\": 1} }, \"reverse-DNS\"},\n104|\t\t}\n105|\t\tfor _, tc := range cases {\n106|\t\t\tt.Run(tc.name, func(t *testing.T) {\n107|\t\t\t\tinput := validSessionInput()\n108|\t\t\t\ttc.mutate(&input)\n109|\t\t\t\t_, err := BuildCanonicalSession(input)\n110|\t\t\t\trequireRefusal(t, err, tc.fragment)\n111|\t\t\t})\n112|\t\t}\n113|\t})\n114|\tt.Run(\"decode\", func(t *testing.T) {\n115|\t\tvalid := mustSessionBytes(t)\n116|\t\tcases := []struct {\n117|\t\t\tname     string\n118|\t\t\tbody     func(t *testing.T) []byte\n119|\t\t\tfragment string\n120|\t\t}{\n121|\t\t\t{\"unknown member\", func(t *testing.T) []byte {\n122|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"lease\"] = \"x\" })\n123|\t\t\t}, \"unknown member\"},\n124|\t\t\t{\"bad schema\", func(t *testing.T) []byte {\n125|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"schema\"] = \"urn:ax:schema:blob\" })\n126|\t\t\t}, \"not the canonical session\"},\n127|\t\t\t{\"two mains\", func(t *testing.T) []byte {\n128|\t\t\t\treturn tamper(t, valid, func(o map[string]any) {\n129|\t\t\t\t\tactors := o[\"actors\"].([]any)\n130|\t\t\t\t\tactors[1].(map[string]any)[\"kind\"] = \"main\"\n131|\t\t\t\t\tactors[1].(map[string]any)[\"parent_actor_id\"] = nil\n132|\t\t\t\t})\n133|\t\t\t}, \"exactly one\"},\n134|\t\t\t{\"dup actors\", func(t *testing.T) []byte {\n135|\t\t\t\treturn tamper(t, valid, func(o map[string]any) {\n136|\t\t\t\t\tactors := o[\"actors\"].([]any)\n137|\t\t\t\t\tactors[1].(map[string]any)[\"actor_id\"] = actors[0].(map[string]any)[\"actor_id\"]\n138|\t\t\t\t})\n139|\t\t\t}, \"unique by actor ID\"},\n140|\t\t\t{\"dup events\", func(t *testing.T) []byte {\n141|\t\t\t\treturn tamper(t, valid, func(o map[string]any) {\n142|\t\t\t\t\tevents := o[\"event_ids\"].([]any)\n143|\t\t\t\t\to[\"event_ids\"] = []any{events[0], events[0]}\n144|\t\t\t\t})\n145|\t\t\t}, \"not unique\"},\n146|\t\t\t{\"heads unsorted\", func(t *testing.T) []byte {\n147|\t\t\t\thigh, low := unsortedPair(\"unsorted-head-a\", \"unsorted-head-b\")\n148|\t\t\t\treturn tamper(t, valid, func(o map[string]any) {\n149|\t\t\t\t\to[\"event_ids\"] = []any{low, high}\n150|\t\t\t\t\to[\"head_event_ids\"] = []any{high, low}\n151|\t\t\t\t})\n152|\t\t\t}, \"sorted unique\"},\n153|\t\t\t{\"head outside\", func(t *testing.T) []byte {\n154|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"head_event_ids\"] = []any{fixtureDigest(\"elsewhere\")} })\n155|\t\t\t}, \"outside event_ids\"},\n156|\t\t\t{\"self mismatch\", func(t *testing.T) []byte {\n157|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"canonical_session_id\"] = fixtureDigest(\"forged\") })\n158|\t\t\t}, \"omit-self digest\"},\n159|\t\t}\n160|\t\tfor _, tc := range cases {\n161|\t\t\tt.Run(tc.name, func(t *testing.T) {\n162|\t\t\t\t_, err := DecodeCanonicalSession(tc.body(t))\n163|\t\t\t\trequireRefusal(t, err, tc.fragment)\n164|\t\t\t})\n165|\t\t}\n166|\t})\n167|}\n168|\n169|func TestCanonicalEventRefusals(t *testing.T) {\n170|\tt.Run(\"build envelope\", func(t *testing.T) {\n171|\t\tcases := []struct {\n172|\t\t\tname     string\n173|\t\t\tmutate   func(*CanonicalEventInput)\n174|\t\t\tfragment string\n175|\t\t}{\n176|\t\t\t{\"bad kind\", func(in *CanonicalEventInput) { in.Kind = \"chat\" }, \"26-kind\"},\n177|\t\t\t{\"bad visibility\", func(in *CanonicalEventInput) { in.Visibility = \"secret\" }, \"public|projection|internal|opaque\"},\n178|\t\t\t{\"bad logical\", func(in *CanonicalEventInput) { in.LogicalSessionID = \"nope\" }, \"not a UUIDv7\"},\n179|\t\t\t{\"bad actor\", func(in *CanonicalEventInput) { in.ActorID = \"nope\" }, \"not a UUIDv7\"},\n180|\t\t\t{\"bad turn\", func(in *CanonicalEventInput) { in.TurnID = strptr(\"nope\") }, \"turn_id\"},\n181|\t\t\t{\"bad timestamp\", func(in *CanonicalEventInput) { in.Timestamp = strptr(\"yesterday\") }, \"not a timestamp\"},\n182|\t\t\t{\"parents unsorted\", func(in *CanonicalEventInput) {\n183|\t\t\t\thigh, low := unsortedPair(\"unsorted-parent-a\", \"unsorted-parent-b\")\n184|\t\t\t\tin.Parents = []string{high, low}\n185|\t\t\t}, \"sorted unique\"},\n186|\t\t\t{\"parents dup\", func(in *CanonicalEventInput) {\n187|\t\t\t\tin.Parents = []string{fixtureDigest(\"a\"), fixtureDigest(\"a\")}\n188|\t\t\t}, \"sorted unique\"},\n189|\t\t\t{\"payload not object\", func(in *CanonicalEventInput) { in.Payload = []byte(`[1]`) }, \"payload\"},\n190|\t\t\t{\"message missing blocks\", func(in *CanonicalEventInput) { in.Payload = []byte(`{\"extensions\":{}}`) }, \"content_blocks\"},\n191|\t\t\t{\"message extra member\", func(in *CanonicalEventInput) {\n192|\t\t\t\tin.Payload = []byte(`{\"content_blocks\":[],\"extensions\":{},\"transcript\":\"x\"}`)\n193|\t\t\t}, \"unknown member\"},\n194|\t\t\t{\"block bad type\", func(in *CanonicalEventInput) {\n195|\t\t\t\tin.Payload = []byte(`{\"content_blocks\":[{\"type\":\"video\"}],\"extensions\":{}}`)\n196|\t\t\t}, \"eight-type\"},\n197|\t\t\t{\"block missing type\", func(in *CanonicalEventInput) {\n198|\t\t\t\tin.Payload = []byte(`{\"content_blocks\":[{\"content\":\"x\"}],\"extensions\":{}}`)\n199|\t\t\t}, \"misses its type\"},\n200|\t\t\t{\"block inline oversize\", func(in *CanonicalEventInput) {\n201|\t\t\t\tin.Payload = []byte(`{\"content_blocks\":[{\"type\":\"text\",\"content\":\"` + strings.Repeat(\"x\", 65537) + `\"}],\"extensions\":{}}`)\n202|\t\t\t}, \"64 KiB\"},\n203|\t\t\t{\"block bad descriptor\", func(in *CanonicalEventInput) {\n204|\t\t\t\tin.Payload = []byte(`{\"content_blocks\":[{\"type\":\"image\",\"blob_descriptor_id\":\"nope\"}],\"extensions\":{}}`)\n205|\t\t\t}, \"not a digest\"},\n206|\t\t\t{\"block extra member\", func(in *CanonicalEventInput) {\n207|\t\t\t\tin.Payload = []byte(`{\"content_blocks\":[{\"type\":\"text\",\"blob_id\":\"x\"}],\"extensions\":{}}`)\n208|\t\t\t}, \"unknown member\"},\n209|\t\t\t{\"bad extensions\", func(in *CanonicalEventInput) { in.Extensions = map[string]any{\"no-dots\": 1} }, \"reverse-DNS\"},\n210|\t\t}\n211|\t\tfor _, tc := range cases {\n212|\t\t\tt.Run(tc.name, func(t *testing.T) {\n213|\t\t\t\tinput := validEventInpu