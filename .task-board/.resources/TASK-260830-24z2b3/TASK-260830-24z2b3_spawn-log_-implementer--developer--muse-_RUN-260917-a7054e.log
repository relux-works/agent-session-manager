{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cae3","stream":{"kind":"session","id":"01a0b0cc-369a-7993-946b-ef774181fd54"},"sequence":972,"recorded_at":1780531400001939,"record_type":"event","durability":"durable","causation_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","run_stream":{"kind":"run","id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3"},"task_stream":{"kind":"task","id":"01a0b0cf-58ee-7652-a166-d12f8bafe8e7"},"task_id":"01a0b0cf-58ee-7652-a166-d12f8bafe8e7","event":{"kind":"output","task_id":"01a0b0cf-58ee-7652-a166-d12f8bafe8e7","chunk":"Read text file `/tmp/rev2/zz_review_probe_test.go.txt`.\n1|package clonebundle\n2|\n3|// Reviewer probes (TASK-260830-24z2b3 rev2). Test-only file in an isolated\n4|// candidate copy; every probe reports the production verdict, it never\n5|// asserts, so the log shows what each entry admits or refuses.\n6|\n7|import (\n8|\t\"bytes\"\n9|\t\"encoding/json\"\n10|\t\"fmt\"\n11|\t\"strings\"\n12|\t\"testing\"\n13|)\n14|\n15|func verdict(label string, err error) {\n16|\tif err == nil {\n17|\t\tfmt.Printf(\"PROBE %-58s ADMITTED\\n\", label)\n18|\t\treturn\n19|\t}\n20|\tfmt.Printf(\"PROBE %-58s REFUSED: %v\\n\", label, err)\n21|}\n22|\n23|func TestReviewProbes(t *testing.T) {\n24|\tidentity := fixtureNativeIdentity()\n25|\tidentityDigest, err := IdentityDigest(identity, nil)\n26|\tif err != nil {\n27|\t\tt.Fatal(err)\n28|\t}\n29|\tbuildRaw := func(inputs []EntryInput, ext map[string]any) ([]byte, error) {\n30|\t\treturn BuildRawObjectManifest(fixtureOperationID, []byte(fixtureTupleJSON()),\n31|\t\t\t\"native-session-alpha\", identityDigest.String(), fixtureDigest(\"test-capture-plan\"), inputs, ext)\n32|\t}\n33|\n34|\t// P1: entry blob_descriptor_id names a different descriptor than the bytes verified.\n35|\tinputs := validEntryInputs(t)\n36|\tinputs[0].DescriptorID = fixtureDigest(\"some-other-descriptor\")\n37|\tbuilt, err := buildRaw(inputs, nil)\n38|\tverdict(\"P1 raw entry descriptor_id != descriptor's own id (build)\", err)\n39|\tif err == nil {\n40|\t\tm, derr := DecodeRawObjectManifest(built)\n41|\t\tverdict(\"P1b decode of that manifest\", derr)\n42|\t\tif derr == nil {\n43|\t\t\tverr := VerifyRawManifestDescriptors(m, func(id string) ([]byte, error) {\n44|\t\t\t\tfor _, in := range inputs {\n45|\t\t\t\t\tif in.DescriptorID == id {\n46|\t\t\t\t\t\treturn in.Descriptor, nil\n47|\t\t\t\t\t}\n48|\t\t\t\t}\n49|\t\t\t\treturn nil, fmt.Errorf(\"missing %s\", id)\n50|\t\t\t})\n51|\t\t\tverdict(\"P1c VerifyRawManifestDescriptors with mismatched id\", verr)\n52|\t\t}\n53|\t}\n54|\n55|\t// P2: AX number model inside extension values (float, unsafe int, exponent).\n56|\tvalid := mustRawBytes(t)\n57|\tfor _, lit := range []string{`1.5`, `9007199254740993`, `1e2`, `1E400`, `-0`} {\n58|\t\tbody := strings.Replace(string(valid), `\"extensions\":{}`, `\"extensions\":{\"com.example.n\":`+lit+`}`, 1)\n59|\t\tvar members map[string]json.RawMessage\n60|\t\t_ = json.Unmarshal([]byte(body), &members)\n61|\t\t_, derr := omitSelfDigest(members, rawManifestSelf)\n62|\t\tverdict(\"P2 omitSelfDigest over extension number \"+lit, derr)\n63|\t\t_, derr = DecodeRawObjectManifest([]byte(body))\n64|\t\tverdict(\"P2b DecodeRawObjectManifest ext number \"+lit+\" (unsealed)\", derr)\n65|\t}\n66|\tbuilt, err = buildRaw(validEntryInputs(t), map[string]any{\"com.example.f\": 1.5, \"com.example.big\": uint64(1) << 60})\n67|\tverdict(\"P2c Build raw manifest with float/unsafe-int extension\", err)\n68|\tif err == nil {\n69|\t\t_, derr := DecodeRawObjectManifest(built)\n70|\t\tverdict(\"P2d Decode of that manifest\", derr)\n71|\t\tfmt.Printf(\"PROBE P2e built extensions bytes: %s\\n\", extractMember(built, \"extensions\"))\n72|\t}\n73|\n74|\t// P3: sanitizer edges (C1 control, line separator, zero-width space, schemeless credential, case, backslash).\n75|\tc1 := string(rune(0x85))\n76|\tlsep := string(rune(0x2028))\n77|\tzwsp := string(rune(0x200b))\n78|\tfor _, key := range []string{\"a\" + c1 + \"b\", \"a\" + lsep + \"b\", \"a\" + zwsp + \"b\", \"user:secret@example.com/path\", \"URN:AX:session\", \"~/home\", \"host-channel\\\\trust.json\", \"HOST-CHANNEL/trust.json\", \"./host-channel/trust.json\", \"host-channel//trust.json\"} {\n79|\t\tverdict(fmt.Sprintf(\"P3 SanitizeNativeKey(%q)\", key), SanitizeNativeKey(key))\n80|\t\tverdict(fmt.Sprintf(\"P3x refuseExcludedMember(%q)\", key), refuseExcludedMember(\"probe\", key, 0))\n81|\t}\n82|\n83|\t// P4: reconciliation with duplicate raw keys hiding a missing included key.\n84|\titems := []CaptureItem{\n85|\t\t{NativeItemKey: \"a\", Class: \"durable_payload\", Disposition: \"included\"},\n86|\t\t{NativeItemKey: \"b\", Class: \"durable_payload\", Disposition: \"included\"},\n87|\t}\n88|\tfmt.Printf(\"PROBE P4 deriveRawComplete(items a,b included; rawKeys=[a,a]) = %v (want false)\\n\", deriveRawComplete(items, []string{\"a\", \"b\"}, []string{\"a\", \"a\"}))\n89|\tfmt.Printf(\"PROBE P4b deriveRawComplete(items a,b; planKeys=[a,b,b]) = %v (want false)\\n\", deriveRawComplete(items, []string{\"a\", \"b\", \"b\"}, []string{\"a\", \"b\"}))\n90|\n91|\t// P5: Build capture manifest with items != plan candidates.\n92|\tin := validCaptureInput(t)\n93|\tin.PlanKeys = append(in.PlanKeys, \"store/zz-missing-item\")\n94|\tbuilt, err = BuildCaptureManifest(in)\n95|\tverdict(\"P5 BuildCaptureManifest items != plan candidates\", err)\n96|\tif err == nil {\n97|\t\tm, _ := DecodeCaptureManifest(built)\n98|\t\tfmt.Printf(\"PROBE P5b raw_complete=%v (built with plan/item mismatch)\\n\", m.RawComplete)\n99|\t}\n100|\n101|\t// P6: payload for the wrong kind.\n102|\tev := validEventInput(\"exact\")\n103|\tev.Kind = \"usage\"\n104|\tev.Payload = []byte(`{\"content_blocks\":[{\"type\":\"text\",\"content\":\"hi\"}],\"input_tokens\":3}`)\n105|\t_, err = BuildCanonicalEvent(ev)\n106|\tverdict(\"P6 usage event 