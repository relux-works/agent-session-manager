{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9eb","stream":{"kind":"session","id":"01a0b0cc-369a-7993-946b-ef774181fd54"},"sequence":848,"recorded_at":1780531400001691,"record_type":"event","durability":"durable","causation_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","run_stream":{"kind":"run","id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3"},"call_id":"call_01a0b0cee61d74158859a95423362a29","text":"Read text file `internal/clonebundle/contract_test.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"testing\"\n8|)\n9|\n10|// Positive contract tests: every production Build entry constructs\n11|// objects its Decode entry accepts, identical inputs produce\n12|// byte-identical outputs, and derived flags match their derivation.\n13|\n14|func TestBuildRawManifestRoundTrip(t *testing.T) {\n15|\tidentity := fixtureNativeIdentity()\n16|\tidentityDigest, err := IdentityDigest(identity, nil)\n17|\tif err != nil {\n18|\t\tt.Fatalf(\"IdentityDigest() error = %v\", err)\n19|\t}\n20|\tinputs := validEntryInputs(t)\n21|\tfirst, err := BuildRawObjectManifest(fixtureOperationID, []byte(fixtureTupleJSON()),\n22|\t\t\"native-session-alpha\", identityDigest.String(), fixtureDigest(\"test-capture-plan\"), inputs, nil)\n23|\tif err != nil {\n24|\t\tt.Fatalf(\"BuildRawObjectManifest() error = %v\", err)\n25|\t}\n26|\tsecond, err := BuildRawObjectManifest(fixtureOperationID, []byte(fixtureTupleJSON()),\n27|\t\t\"native-session-alpha\", identityDigest.String(), fixtureDigest(\"test-capture-plan\"), inputs, nil)\n28|\tif err != nil {\n29|\t\tt.Fatalf(\"BuildRawObjectManifest() error = %v\", err)\n30|\t}\n31|\tif !bytes.Equal(first, second) {\n32|\t\tt.Fatal(\"BuildRawObjectManifest identical inputs produced different bytes\")\n33|\t}\n34|\tmanifest, err := DecodeRawObjectManifest(first)\n35|\tif err != nil {\n36|\t\tt.Fatalf(\"DecodeRawObjectManifest() error = %v\", err)\n37|\t}\n38|\tif len(manifest.Entries) != 2 {\n39|\t\tt.Fatalf(\"DecodeRawObjectManifest entries = %d, want 2\", len(manifest.Entries))\n40|\t}\n41|\tvar sum uint64\n42|\tfor _, entry := range manifest.Entries {\n43|\t\tsum += entry.ByteCount\n44|\t}\n45|\tif manifest.TotalBytes != sum {\n46|\t\tt.Fatalf(\"TotalBytes = %d, entries sum to %d\", manifest.TotalBytes, sum)\n47|\t}\n48|\tif manifest.SourceNativeSessionID != \"native-session-alpha\" {\n49|\t\tt.Fatalf(\"SourceNativeSessionID = %q\", manifest.SourceNativeSessionID)\n50|\t}\n51|\tbyKey := map[string]RawObjectEntry{}\n52|\tfor _, entry := range manifest.Entries {\n53|\t\tbyKey[entry.NativeItemKey] = entry\n54|\t}\n55|\tfetch := map[string][]byte{}\n56|\tfor index, input := range inputs {\n57|\t\tfetch[manifest.Entries[index].BlobDescriptorID.String()] = input.Descriptor\n58|\t}\n59|\tif err := VerifyRawManifestDescriptors(manifest, func(id string) ([]byte, error) {\n60|\t\tdescriptor, ok := fetch[id]\n61|\t\tif !ok {\n62|\t\t\tt.Fatalf(\"descriptor fetch missed %s\", id)\n63|\t\t}\n64|\t\treturn descriptor, nil\n65|\t}); err != nil {\n66|\t\tt.Fatalf(\"VerifyRawManifestDescriptors() error = %v\", err)\n67|\t}\n68|\tif byKey[\"store/blob-a\"].Class != \"durable_payload\" || byKey[\"store/blob-b\"].Class != \"durable_sidecar\" {\n69|\t\tt.Fatalf(\"entry classes = %q, %q\", byKey[\"store/blob-a\"].Class, byKey[\"store/blob-b\"].Class)\n70|\t}\n71|}\n72|\n73|func TestBuildCaptureManifestDerivesRawComplete(t *testing.T) {\n74|\tinput := validCaptureInput(t)\n75|\tbuilt, err := BuildCaptureManifest(input)\n76|\tif err != nil {\n77|\t\tt.Fatalf(\"BuildCaptureManifest() error = %v\", err)\n78|\t}\n79|\trebuilt, err := BuildCaptureManifest(input)\n80|\tif err != nil {\n81|\t\tt.Fatalf(\"BuildCaptureManifest() error = %v\", err)\n82|\t}\n83|\tif !bytes.Equal(built, rebuilt) {\n84|\t\tt.Fatal(\"BuildCaptureManifest identical inputs produced different bytes\")\n85|\t}\n86|\tmanifest, err := DecodeCaptureManifest(built)\n87|\tif err != nil {\n88|\t\tt.Fatalf(\"DecodeCaptureManifest() error = %v\", err)\n89|\t}\n90|\tif !manifest.RawComplete {\n91|\t\tt.Fatal(\"RawComplete = false, want true after complete reconciliation\")\n92|\t}\n93|\tif len(manifest.ExcludedClasses) != 1 || manifest.ExcludedClasses[0] != \"credential\" {\n94|\t\tt.Fatalf(\"ExcludedClasses = %v, want [credential]\", manifest.ExcludedClasses)\n95|\t}\n96|\tif err := VerifyCaptureReconciliation(manifest, input.PlanKeys, input.RawKeys); err != nil {\n97|\t\tt.Fatalf(\"VerifyCaptureReconciliation() error = %v\", err)\n98|\t}\n99|\tif err := RefuseMaximalSafeUnlessComplete(manifest); err != nil {\n100|\t\tt.Fatalf(\"RefuseMaximalSafeUnlessComplete() error = %v\", err)\n101|\t}\n102|\tif !manifest.CaptureBoundary.Stable() {\n103|\t\tt.Fatal(\"CaptureBoundary is not stable\")\n104|\t}\n105|}\n106|\n107|func TestBuildCaptureManifestUnknownMakesIncomplete(t *testing.T) {\n108|\tinput := validCaptureInput(t)\n109|\tcount := uint64(9)\n110|\tdescriptor := fixtureDigest(\"test-descriptor\")\n111|\tinput.Items = append(input.Items, CaptureItemInput{\n112|\t\tNativeItemKey: \"store/zz-unknown\", Class: \"unknown\", Disposition: \"included\",\n113|\t\tBlobDescriptorID: &descriptor, ByteCount: &count,\n114|\t})\n115|\tinput.PlanKeys = append(input.PlanKeys, \"store/zz-unknown\")\n116|\tinput.RawKeys = append(input.RawKeys, \"store/zz-unknown\")\n117|\tbuilt, err := BuildCaptureManifest(input)\n118|\tif err != nil {\n119|\t\tt.Fatalf(\"BuildCaptureManifest() error = %v\", err)\n120|\t}\n121|\tmanifest, err := DecodeCaptureManifest(built)\n122|\tif err != nil {\n123|\t\tt.Fatalf(\"DecodeCaptureManifest() error = %v\", err)\n124|\t}\n125|\tif manifest.RawComplete {\n126|\t\tt.Fatal(\"RawComplete = true with an unknown-class item\")\n127|\t}\n128|\tif err := RefuseMaximalSafeUnlessComplete(manifest); !errors.Is(err, ErrInvalid) {\n129|\t\tt.Fatalf(\"RefuseMaximalSafeUnlessComplete() error = %v, want ErrInvalid\", err)\n130|\t}\n131|\tif err := VerifyCaptureReconciliation(manifest, input.PlanKeys, input.RawKeys); !errors.Is(err, ErrInvalid) {\n132|\t\tt.Fatalf(\"VerifyCaptureReconciliation() error = %v, want ErrInvalid\", err)\n133|\t}\n134|}\n135|\n136|func TestBuildCaptureManifestUnstableArchive(t *testing.T) {\n137|\tinput := validCaptureInput(t)\n138|\tinput.Boundary = BoundaryInput{\n139|\t\tKind: \"unstable_archive\", Generation: \"generation-9\",\n140|\t\tPreCaptureDigest: fixtureDigest(\"test-pre\"), PostCaptureDigest: fixtureDigest(\"test-post\"),\n141|\t\tCore: true,\n142|\t}\n143|\tbuilt, err := BuildCaptureManifest(input)\n144|\tif err != nil {\n145|\t\tt.Fatalf(\"BuildCaptureManifest(unstable) error = %v\", err)\n146|\t}\n147|\tmanifest, err := DecodeCaptureManifest(built)\n148|\tif err != nil {\n149|\t\tt.Fatalf(\"DecodeCaptureManifest(unstable) error = %v\", err)\n150|\t}\n151|\tif manifest.CaptureBoundary.Stable() {\n152|\t\tt.Fatal(\"unstable boundary reports stable\")\n153|\t}\n154|\tif err := RefuseUnstableForTarget(manifest.CaptureBoundary); !errors.Is(err, ErrInvalid) {\n155|\t\tt.Fatalf(\"RefuseUnstableForTarget(unstable) error = %v, want ErrInvalid\", err)\n156|\t}\n157|\tstable, err := DecodeCaptureBoundary([]byte(`{\"kind\":\"stable\",\"proof\":{\"proof_kind\":\"closed_store\",\"source_generation\":\"g\",\"snapshot_identity_digest\":null,\"pre_capture_digest\":` +\n158|\t\t`\"` + fixtureDigest(\"test-pre-capture\") + `\",\"post_capture_digest\":\"` + fixtureDigest(\"test-pre-capture\") +\n159|\t\t`\",\"input_blocked\":true,\"foreground_idle\":true,\"background_idle\":true,\"extensions\":{}},\"extensions\":{}}`))\n160|\tif err != nil {\n161|\t\tt.Fatalf(\"DecodeCaptureBoundary(stable) error = %v\", err)\n162|\t}\n163|\tif err := RefuseUnstableForTarget(stable); err != nil {\n164|\t\tt.Fatalf(\"RefuseUnstableForTarget(stable) error = %v\", err)\n165|\t}\n166|}\n167|\n168|func TestBuildCanonicalSessionRoundTrip(t *testing.T) {\n169|\tinput := validSessionInput()\n170|\tfirst, err := BuildCanonicalSession(input)\n171|\tif err != nil {\n172|\t\tt.Fatalf(\"BuildCanonicalSession() error = %v\", err)\n173|\t}\n174|\tsecond, err := BuildCanonicalSession(input)\n175|\tif err != nil {\n176|\t\tt.Fatalf(\"BuildCanonicalSession() error = %v\", err)\n177|\t}\n178|\tif !bytes.Equal(first, second) {\n179|\t\tt.Fatal(\"BuildCanonicalSession identical inputs produced different bytes\")\n180|\t}\n181|\tsession, err := DecodeCanonicalSession(first)\n182|\tif err != nil {\n183|\t\tt.Fatalf(\"DecodeCanonicalSession() error = %v\", err)\n184|\t}\n185|\tif len(session.Actors) != 2 || len(session.EventIDs) != 2 || len(session.HeadEventIDs) != 1 {\n186|\t\tt.Fatalf(\"session actors/events/heads = %d/%d/%d\", len(session.Actors), len(session.EventIDs), len(session.HeadEventIDs))\n187|\t}\n188|\tif session.Title == nil || *session.Title != \"alpha session\" {\n189|\t\tt.Fatalf(\"session title = %v\", session.Title)\n190|\t}\n191|}\n192|\n193|func TestBuildCanonicalEventRoundTrip(t *testing.T) {\n194|\tfor _, status := range []string{\"exact\", \"partial\", \"unavailable\", \"synthesized\"} {\n195|\t\tinput := validEventInput(status)\n196|\t\tfirst, err := BuildCanonicalEvent(input)\n197|\t\tif err != nil {\n198|\t\t\tt.Fatalf(\"BuildCanonicalEvent(%s) error = %v\", status, err)\n199|\t\t}\n200|\t\tsecond, err := BuildCanonicalEvent(input)\n201|\t\tif err != nil {\n202|\t\t\tt.Fatalf(\"BuildCanonicalEvent(%s) error = %v\", status, err)\n203|\t\t}\n204|\t\tif !bytes.Equal(first, second) {\n205|\t\t\tt.Fatalf(\"BuildCanonicalEvent(%s) identical inputs produced different bytes\", status)\n206|\t\t}\n207|\t\tevent, err := DecodeCanonicalEvent(first)\n208|\t\tif err != nil {\n209|\t\t\tt.Fatalf(\"DecodeCanonicalEvent(%s) error = %v\", status, err)\n210|\t\t}\n211|\t\tif event.Evidence.CaptureStatus != status {\n212|\t\t\tt.Fatalf(\"CaptureStatus = %q, want %q\", event.Evidence.CaptureStatus, status)\n213|\t\t}\n214|\t\tif status == \"synthesized\" && event.Evidence.CoreOperationID == nil {\n215|\t\t\tt.Fatal(\"synthesized evidence lost its core operation\")\n216|\t\t}\n217|\t}\n218|}\n219|\n220|func TestIdentityDigestIsStable(t *testing.T) {\n221|\tidentity := fixtureNativeIdentity()\n222|\tfirst, err := IdentityDigest(identity, nil)\n223|\tif err != nil {\n224|\t\tt.Fatalf(\"IdentityDigest() error = %v\", err)\n225|\t}\n226|\tsecond, err := IdentityDigest(identity, nil)\n227|\tif err != nil {\n228|\t\tt.Fatalf(\"IdentityDigest() error = %v\", err)\n229|\t}\n230|\tif first != second {\n231|\t\tt.Fatal(\"IdentityDigest identical inputs produced different digests\")\n232|\t}\n233|\tother := identity\n234|\tother.NativeSessionID = \"native-session-beta\"\n235|\tthird, err := IdentityDigest(other, nil)\n236|\tif err != nil {\n237|\t\tt.Fatalf(\"IdentityDigest() error = %v\", err)\n238|\t}\n239|\tif third == first {\n240|\t\tt.Fatal(\"IdentityDigest did not change with the native session ID\")\n241|\t}\n242|}\n243|\n244|func TestExcludedClassesExactGate(t *testing.T) {\n245|\titems := []CaptureItem{\n246|\t\t{NativeItemKey: \"a\", Class: \"durable_payload\", Disposition: \"included\"},\n247|\t\t{NativeItemKey: \"b\", Class: \"credential\", Disposition: \"excluded\"},\n248|\t}\n249|\tif !excludedClassesExact(items, []string{\"credential\"}) {\n250|\t\tt.Fatal(\"excludedClassesExact(exact) = false, want true\")\n251|\t}\n252|\tif excludedClassesExact(items, []string{\"credential\", \"unknown\"}) {\n253|\t\tt.Fatal(\"excludedClassesExact(extra) = true, want false\")\n254|\t}\n255|\tif excludedClassesExact(items, nil) {\n256|\t\tt.Fatal(\"excludedClassesExact(missing) = true, want false\")\n257|\t}\n258|\tif excludedClassesExact(items, []string{\"unknown\", \"credential\"}) {\n259|\t\tt.Fatal(\"excludedClassesExact(unordered) = true, want false\")\n260|\t}\n261|}\n262|\n263|func TestOrdinalContiguity(t *testing.T) {\n264|\tif err := CheckOrdinalContiguity([]uint64{0, 1, 2, 3}); err != nil {\n265|\t\tt.Fatalf(\"CheckOrdinalContiguity(contiguous) error = %v\", err)\n266|\t}\n267|\tif err := CheckOrdinalContiguity([]uint64{2, 0, 1}); err != nil {\n268|\t\tt.Fatalf(\"CheckOrdinalContiguity(unordered set) error = %v\", err)\n269|\t}\n270|\tfor _, ordinals := range [][]uint64{{1}, {0, 2}, {0, 0, 1}, {0, 1, 5}} {\n271|\t\tif err := CheckOrdinalContiguity(ordinals); !errors.Is(err, ErrInvalid) {\n272|\t\t\tt.Fatalf(\"CheckOrdinalContiguity(%v) error = %v, want ErrInvalid\", ordinals, err)\n273|\t\t}\n274|\t}\n275|}\n276|\n277|func TestInstallRawBlobIsIdempotent(t *testing.T) {\n278|\tstore := openFixtureStore(t)\n279|\tpayload := []byte(\"raw-evidence-bytes\")\n280|\tdescriptor, blobID, _, size := makeDescriptor(t, payload)\n281|\tfirst, err := InstallRawBlob(store, descriptor, bytes.NewReader(payload))\n282|\tif err != nil {\n283|\t\tt.Fatalf(\"InstallRawBlob() error = %v\", err)\n284|\t}\n285|\tsecond, err := InstallRawBlob(store, descriptor, bytes.NewReader(payload))\n286|\tif err != nil {\n287|\t\tt.Fatalf(\"InstallRawBlob(second install) error = %v\", err)\n288|\t}\n289|\tif first != second {\n290|\t\tt.Fatalf(\"InstallRawBlob agreements differ: %+v vs %+v\", first, second)\n291|\t}\n292|\tif first.BlobID.String() != blobID || first.Size != size {\n293|\t\tt.Fatalf(\"InstallRawBlob agreement = %+v, want blob %s size %d\", first, blobID, size)\n294|\t}\n295|\tif _, err := InstallRawBlob(store, descriptor, bytes.NewReader([]byte(\"tampered-evidence!\"))); !errors.Is(err, ErrInvalid) {\n296|\t\tt.Fatalf(\"InstallRawBlob(tampered bytes) error = %v, want ErrInvalid\", err)\n297|\t}\n298|}\n299|\n300|func TestCaptureClassVocabularyIsPinned(t *testing.T) {\n301|\tpinned := []string{\n302|\t\t\"durable_payload\",\n303|\t\t\"durable_index_required\",\n304|\t\t\"durable_sidecar\",\n305|\t\t\"derived_cache_optional\",\n306|\t\t\"credential\",\n307|\t\t\"machine_auth\",\n308|\t\t\"runtime_state\",\n309|\t\t\"transient_lock\",\n310|\t\t\"unknown\",\n311|\t}\n312|\tfor _, class := range pinned {\n313|\t\tif !ValidCaptureClass(class) {\n314|\t\t\tt.Fatalf(\"ValidCaptureClass(%q) = false, want true\", class)\n315|\t\t}\n316|\t}\n317|\tfor _, class := range []string{\"\", \"durable\", \"CREDENTIAL\", \"unknown \", \"derived_cache\"} {\n318|\t\tif ValidCaptureClass(class) {\n319|\t\t\tt.Fatalf(\"ValidCaptureClass(%q) = true, want false\", class)\n320|\t\t}\n321|\t}\n322|}\n323|\n324|func TestEventKindVocabularyIsPinned(t *testing.T) {\n325|\tpinned := []string{\n326|\t\t\"session_started\", \"instruction_snapshot\", \"user_message\", \"assistant_message\",\n327|\t\t\"reasoning_summary\", \"opaque_reasoning\", \"tool_definition_snapshot\", \"tool_call\",\n328|\t\t\"tool_result\", \"approval_request\", \"approval_response\", \"plan_update\", \"progress\",\n329|\t\t\"usage\", \"rate_limit\", \"file_change\", \"compaction\", \"turn_started\", \"turn_completed\",\n330|\t\t\"turn_aborted\", \"subagent_started\", \"subagent_completed\", \"error\",\n331|\t\t\"migration_checkpoint\", \"session_finished\", \"opaque_event\",\n332|\t}\n333|\tif len(pinned) != 26 {\n334|\t\tt.Fatalf(\"pinned kinds = %d, want 26\", len(pinned))\n335|\t}\n336|\tfor _, kind := range pinned {\n337|\t\tif !ValidEventKind(kind) {\n338|\t\t\tt.Fatalf(\"ValidEventKind(%q) = false, want true\", kind)\n339|\t\t}\n340|\t}\n341|\tfor _, kind := range []string{\"\", \"message\", \"USER_MESSAGE\", \"tool_call \"} {\n342|\t\tif ValidEventKind(kind) {\n343|\t\t\tt.Fatalf(\"ValidEventKind(%q) = true, want false\", kind)\n344|\t\t}\n345|\t}\n346|}\n347|\n348|func TestNativeIdentityRoundTrip(t *testing.T) {\n349|\tidentity := fixtureNativeIdentity()\n350|\tencoded, err := EncodeNativeIdentity(identity, nil)\n351|\tif err != nil {\n352|\t\tt.Fatalf(\"EncodeNativeIdentity() error = %v\", err)\n353|\t}\n354|\tdecoded, err := DecodeNativeIdentity(encoded)\n355|\tif err != nil {\n356|\t\tt.Fatalf(\"DecodeNativeIdentity() error = %v\", err)\n357|\t}\n358|\tif decoded != identity {\n359|\t\tt.Fatalf(\"DecodeNativeIdentity round trip = %+v, want %+v\", decoded, identity)\n360|\t}\n361|\tvar members map[string]any\n362|\tif err := json.Unmarshal(encoded, &members); err != nil {\n363|\t\tt.Fatal(err)\n364|\t}\n365|\tmembers[\"extensions\"] = map[string]any{\"com.example.origin\": \"probe\"}\n366|\tagain, err := json.Marshal(members)\n367|\tif err != nil {\n368|\t\tt.Fatal(err)\n369|\t}\n370|\tif _, err := DecodeNativeIdentity(again); err != nil {\n371|\t\tt.Fatalf(\"DecodeNativeIdentity(reverse-DNS extensions) error = %v\", err)\n372|\t}\n373|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
