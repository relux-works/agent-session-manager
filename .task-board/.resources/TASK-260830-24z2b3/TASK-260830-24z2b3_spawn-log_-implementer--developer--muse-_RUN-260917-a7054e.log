{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c77b","stream":{"kind":"session","id":"01a0b0cc-369a-7993-946b-ef774181fd54"},"sequence":536,"recorded_at":1780531400001067,"record_type":"event","durability":"durable","causation_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","run_stream":{"kind":"run","id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3"},"task_stream":{"kind":"task","id":"01a0b0cd-47e7-7063-9e2c-80a3894168ad"},"task_id":"01a0b0cd-47e7-7063-9e2c-80a3894168ad","event":{"kind":"output","task_id":"01a0b0cd-47e7-7063-9e2c-80a3894168ad","chunk":"Read text file `internal/clonebundle/session.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n8|)\n9|\n10|// This file validates and constructs Canonical Session 1.0.0 and its\n11|// Actor records: the logical session envelope over ordered unique\n12|// Canonical Event IDs.\n13|\n14|const (\n15|\tcanonicalSessionSchema  = \"urn:ax:schema:canonical-session\"\n16|\tcanonicalSessionVersion = \"1.0.0\"\n17|\tcanonicalSessionSelf    = \"canonical_session_id\"\n18|)\n19|\n20|var actorMembers = map[string]bool{\n21|\t\"actor_id\": true, \"kind\": true, \"parent_actor_id\": true, \"name\": true,\n22|\t\"source_native_id\": true, \"model\": true, \"extensions\": true,\n23|}\n24|\n25|var actorRequired = []string{\n26|\t\"actor_id\", \"kind\", \"parent_actor_id\", \"name\",\n27|\t\"source_native_id\", \"model\", \"extensions\",\n28|}\n29|\n30|// Actor is one validated canonical actor.\n31|type Actor struct {\n32|\tActorID        scalar.UUIDv7\n33|\tKind           string\n34|\tParentActorID  *scalar.UUIDv7\n35|\tName           *string\n36|\tSourceNativeID *string\n37|\tModel          *string\n38|}\n39|\n40|func validActorKind(kind string) bool {\n41|\treturn kind == \"main\" || kind == \"subagent\" || kind == \"external\"\n42|}\n43|\n44|func decodeActor(raw json.RawMessage, index int) (Actor, error) {\n45|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n46|\tif fault != nil {\n47|\t\treturn Actor{}, invalid(\"actor[%d] %s (%s)\", index, fault.detail, memberField(fault.member))\n48|\t}\n49|\tif name, unknown := unknownMember(members, actorMembers); unknown {\n50|\t\treturn Actor{}, invalid(\"actor[%d] carries unknown member %q\", index, name)\n51|\t}\n52|\tif name, missing := missingMember(members, actorRequired); missing {\n53|\t\treturn Actor{}, invalid(\"actor[%d] misses a required member %q\", index, name)\n54|\t}\n55|\tactorID, ok := checkUUIDv7(members[\"actor_id\"])\n56|\tif !ok {\n57|\t\treturn Actor{}, invalid(\"actor[%d] actor_id is not a UUIDv7\", index)\n58|\t}\n59|\tkind, ok := rawString(members[\"kind\"])\n60|\tif !ok || !validActorKind(kind) {\n61|\t\treturn Actor{}, invalid(\"actor[%d] kind is outside main|subagent|external\", index)\n62|\t}\n63|\tvar parent *scalar.UUIDv7\n64|\tif !isNull(members[\"parent_actor_id\"]) {\n65|\t\tvalue, ok := checkUUIDv7(members[\"parent_actor_id\"])\n66|\t\tif !ok {\n67|\t\t\treturn Actor{}, invalid(\"actor[%d] parent_actor_id is not a UUIDv7\", index)\n68|\t\t}\n69|\t\tparent = &value\n70|\t}\n71|\tif kind == \"main\" && parent != nil {\n72|\t\treturn Actor{}, invalid(\"actor[%d] main actor carries a parent\", index)\n73|\t}\n74|\tif kind != \"main\" && parent == nil {\n75|\t\treturn Actor{}, invalid(\"actor[%d] non-main actor requires a parent\", index)\n76|\t}\n77|\tname, err := checkNullableBoundedString(members, \"name\", 1, 512, index, \"actor\")\n78|\tif err != nil {\n79|\t\treturn Actor{}, err\n80|\t}\n81|\tnativeID, err := checkNullableBoundedString(members, \"source_native_id\", 1, 512, index, \"actor\")\n82|\tif err != nil {\n83|\t\treturn Actor{}, err\n84|\t}\n85|\tif nativeID != nil {\n86|\t\tif err := SanitizeNativeKey(*nativeID); err != nil {\n87|\t\t\treturn Actor{}, err\n88|\t\t}\n89|\t}\n90|\tmodel, err := checkNullableBoundedString(members, \"model\", 1, 512, index, \"actor\")\n91|\tif err != nil {\n92|\t\treturn Actor{}, err\n93|\t}\n94|\tif !checkExtensions(members[\"extensions\"]) {\n95|\t\treturn Actor{}, invalid(\"actor[%d] extensions are not reverse-DNS keyed\", index)\n96|\t}\n97|\treturn Actor{\n98|\t\tActorID:        actorID,\n99|\t\tKind:           kind,\n100|\t\tParentActorID:  parent,\n101|\t\tName:           name,\n102|\t\tSourceNativeID: nativeID,\n103|\t\tModel:          model,\n104|\t}, nil\n105|}\n106|\n107|func checkNullableBoundedString(members map[string]json.RawMessage, name string, minimum, maximum, index int, owner string) (*string, error) {\n108|\traw, present := members[name]\n109|\tif !present {\n110|\t\treturn nil, invalid(\"%s[%d] misses a required member %q\", owner, index, name)\n111|\t}\n112|\tif isNull(raw) {\n113|\t\treturn nil, nil\n114|\t}\n115|\tvalue, ok := checkStringBounds(raw, minimum, maximum)\n116|\tif !ok {\n117|\t\treturn nil, invalid(\"%s[%d] %s is not a string[%d..%d]\", owner, index, name, minimum, maximum)\n118|\t}\n119|\treturn &value, nil\n120|}\n121|\n122|// ActorInput is one caller-supplied actor candidate for Build.\n123|type ActorInput struct {\n124|\tActorID        string\n125|\tKind           string\n126|\tParentActorID  *string\n127|\tName           *string\n128|\tSourceNativeID *string\n129|\tModel          *string\n130|}\n131|\n132|func buildActor(input ActorInput, index int) (Actor, error) {\n133|\tactorID, err := scalar.ParseUUIDv7(input.ActorID)\n134|\tif err != nil {\n135|\t\treturn Actor{}, invalid(\"actor[%d] actor_id is not a UUIDv7: %v\", index, err)\n136|\t}\n137|\tif !validActorKind(input.Kind) {\n138|\t\treturn Actor{}, invalid(\"actor[%d] kind is outside main|subagent|external\", index)\n139|\t}\n140|\tvar parent *scalar.UUIDv7\n141|\tif input.ParentActorID != nil {\n142|\t\tvalue, err := scalar.ParseUUIDv7(*input.ParentActorID)\n143|\t\tif err != nil {\n144|\t\t\treturn Actor{}, invalid(\"actor[%d] parent_actor_id is not a UUIDv7: %v\", index, err)\n145|\t\t}\n146|\t\tparent = &value\n147|\t}\n148|\tif input.Kind == \"main\" && parent != nil {\n149|\t\treturn Actor{}, invalid(\"actor[%d] main actor carries a parent\", index)\n150|\t}\n151|\tif input.Kind != \"main\" && parent == nil {\n152|\t\treturn Actor{}, invalid(\"actor[%d] non-main actor requires a parent\", index)\n153|\t}\n154|\tif input.Name != nil && (len(*input.Name) < 1 || len(*input.Name) > 512) {\n155|\t\treturn Actor{}, invalid(\"actor[%d] name is not a string[1..512]\", index)\n156|\t}\n157|\tif input.SourceNativeID != nil {\n158|\t\tif len(*input.SourceNativeID) < 1 || len(*input.SourceNativeID) > 512 {\n159|\t\t\treturn Actor{}, invalid(\"actor[%d] source_native_id is not a string[1..512]\", index)\n160|\t\t}\n161|\t\tif err := SanitizeNativeKey(*input.SourceNativeID); err != nil {\n162|\t\t\treturn Actor{}, err\n163|\t\t}\n164|\t}\n165|\tif input.Model != nil && (len(*input.Model) < 1 || len(*input.Model) > 512) {\n166|\t\treturn Actor{}, invalid(\"actor[%d] model is not a string[1..512]\", index)\n167|\t}\n168|\treturn Actor{\n169|\t\tActorID:        actorID,\n170|\t\tKind:           kindOf(input),\n171|\t\tParentActorID:  parent,\n172|\t\tName:           input.Name,\n173|\t\tSourceNativeID: input.SourceNativeID,\n174|\t\tModel:          input.Model,\n175|\t}, nil\n176|}\n177|\n178|func kindOf(input ActorInput) string { return input.Kind }\n179|\n180|func actorObject(actor Actor) map[string]any {\n181|\tvar parent any\n182|\tif actor.ParentActorID != nil {\n183|\t\tparent = actor.ParentActorID.String()\n184|\t}\n185|\tvar name any\n186|\tif actor.Name != nil {\n187|\t\tname = *actor.Name\n188|\t}\n189|\tvar nativeID any\n190|\tif actor.SourceNativeID != nil {\n191|\t\tnativeID = *actor.SourceNativeID\n192|\t}\n193|\tvar model any\n194|\tif actor.Model != nil {\n195|\t\tmodel = *actor.Model\n196|\t}\n197|\treturn map[string]any{\n198|\t\t\"actor_id\":         actor.ActorID.String(),\n199|\t\t\"kind\":             actor.Kind,\n200|\t\t\"parent_actor_id\":  parent,\n201|\t\t\"name\":             name,\n202|\t\t\"source_native_id\": nativeID,\n203|\t\t\"model\":            model,\n204|\t\t\"extensions\":       map[string]any{},\n205|\t}\n206|}\n207|\n208|var canonicalSessionMembers = map[string]bool{\n209|\t\"schema\": true, \"schema_version\": true, \"canonical_session_id\": true,\n210|\t\"logical_session_id\": true, \"source_environment\": true,\n211|\t\"source_native_session_id\": true, \"title\": true, \"workspace\": true,\n212|\t\"actors\": true, \"event_ids\": true, \"head_event_ids\": true,\n213|\t\"created_at\": true, \"updated_at\": true, \"extensions\": true,\n214|}\n215|\n216|var canonicalSessionRequired = []string{\n217|\t\"schema\", \"schema_version\", \"canonical_session_id\",\n218|\t\"logical_session_id\", \"source_environment\",\n219|\t\"source_native_session_id\", \"title\", \"workspace\",\n220|\t\"actors\", \"event_ids\", \"head_event_ids\",\n221|\t\"created_at\", \"updated_at\", \"extensions\",\n222|}\n223|\n224|// CanonicalSession is one validated Canonical Session.\n225|type CanonicalSession struct {\n226|\tSessionID             scalar.Digest\n227|\tLogicalSessionID      scalar.UUIDv7\n228|\tSourceEnvironment     sessadapter.Tuple\n229|\tSourceNativeSessionID string\n230|\tTitle                 *string\n231|\tWorkspace             WorkspaceBinding\n232|\tActors                []Actor\n233|\tEventIDs              []scalar.Digest\n234|\tHeadEventIDs          []scalar.Digest\n235|\tCreatedAt             *scalar.Timestamp\n236|\tUpdatedAt             *scalar.Timestamp\n237|}\n238|\n239|// CanonicalSessionInput is the caller-supplied canonical session\n240|// candidate for Build.\n241|type CanonicalSessionInput struct {\n242|\tLogicalSessionID      string\n243|\tSourceEnvironment     []byte\n244|\tSourceNativeSessionID string\n245|\tTitle                 *string\n246|\tWorkspace             []byte\n247|\tActors                []ActorInput\n248|\tEventIDs              []string\n249|\tHeadEventIDs          []string\n250|\tCreatedAt             *string\n251|\tUpdatedAt             *string\n252|\tExtensions            map[string]any\n253|}\n254|\n255|// BuildCanonicalSession constructs one closed Canonical Session\n256|// 1.0.0 as canonical bytes. Identical inputs produce byte-identical\n257|// outputs.\n258|func BuildCanonicalSession(input CanonicalSessionInput) ([]byte, error) {\n259|\tobject, err := buildCanonicalSession(input)\n260|\tif err != nil {\n261|\t\treturn nil, err\n262|\t}\n263|\tomitted, err := canonicalizeObject(object)\n264|\tif err != nil {\n265|\t\treturn nil, err\n266|\t}\n267|\tsessionID := scalar.SHA256Digest(omitted)\n268|\tobject[canonicalSessionSelf] = sessionID.String()\n269|\treturn canonicalizeObject(object)\n270|}\n271|\n272|func buildCanonicalSession(input CanonicalSessionInput) (map[string]any, error) {\n273|\tlogical, err := scalar.ParseUUIDv7(input.LogicalSessionID)\n274|\tif err != nil {\n275|\t\treturn nil, invalid(\"canonical session logical_session_id is not a UUIDv7: %v\", err)\n276|\t}\n277|\ttuple, err := sessadapter.DecodeTuple(json.RawMessage(input.SourceEnvironment))\n278|\tif err != nil {\n279|\t\treturn nil, invalid(\"canonical session source_environment is not an Environment Tuple: %v\", err)\n280|\t}\n281|\tif len(input.SourceNativeSessionID) < 1 || len(input.SourceNativeSessionID) > 512 {\n282|\t\treturn nil, invalid(\"canonical session source_native_session_id is not a string[1..512]\")\n283|\t}\n284|\tif err := SanitizeNativeKey(input.SourceNativeSessionID); err != nil {\n285|\t\treturn nil, err\n286|\t}\n287|\tvar title any\n288|\tif input.Title != nil {\n289|\t\tif len(*input.Title) < 1 || len(*input.Title) > 4096 {\n290|\t\t\treturn nil, invalid(\"canonical session title is not a string[1..4096]\")\n291|\t\t}\n292|\t\ttitle = *input.Title\n293|\t}\n294|\tworkspace, err := DecodeWorkspaceBinding(json.RawMessage(input.Workspace))\n295|\tif err != nil {\n296|\t\treturn nil, err\n297|\t}\n298|\tif len(input.Actors) < 1 || len(input.Actors) > 1024 {\n299|\t\treturn nil, invalid(\"canonical session carries %d actors, want [1..1024]\", len(input.Actors))\n300|\t}\n301|\tactors := make([]Actor, 0, len(input.Actors))\n302|\tseenActors := map[string]bool{}\n303|\tmainCount := 0\n304|\tfor index, candidate := range input.Actors {\n305|\t\tactor, err := buildActor(candidate, index)\n306|\t\tif err != nil {\n307|\t\t\treturn nil, err\n308|\t\t}\n309|\t\tif seenActors[actor.ActorID.String()] {\n310|\t\t\treturn nil, invalid(\"canonical session actors are not unique by actor ID\")\n311|\t\t}\n312|\t\tseenActors[actor.ActorID.String()] = true\n313|\t\tif actor.Kind == \"main\" {\n314|\t\t\tmainCount++\n315|\t\t}\n316|\t\tactors = append(actors, actor)\n317|\t}\n318|\tif mainCount != 1 {\n319|\t\treturn nil, invalid(\"canonical session carries %d main actors, want exactly one\", mainCount)\n320|\t}\n321|\teventIDs, err := parseOrderedUniqueDigests(input.EventIDs, 1, 1000000, \"event_ids\")\n322|\tif err != nil {\n323|\t\treturn nil, err\n324|\t}\n325|\theadIDs, err := parseSortedUniqueDigestStrings(input.HeadEventIDs, 1, 1024, \"head_event_ids\")\n326|\tif err != nil {\n327|\t\treturn nil, err\n328|\t}\n329|\teventSet := map[string]bool{}\n330|\tfor _, id := range eventIDs {\n331|\t\teventSet[id.String()] = true\n332|\t}\n333|\tfor _, id := range headIDs {\n334|\t\tif !eventSet[id.String()] {\n335|\t\t\treturn nil, invalid(\"canonical session head_event_ids carry an ID outside event_ids\")\n336|\t\t}\n337|\t}\n338|\tcreatedAt, err := parseNullableTimestamp(input.CreatedAt, \"created_at\")\n339|\tif err != nil {\n340|\t\treturn nil, err\n341|\t}\n342|\tupdatedAt, err := parseNullableTimestamp(input.UpdatedAt, \"updated_at\")\n343|\tif err != nil {\n344|\t\treturn nil, err\n345|\t}\n346|\tif _, err := encodeExtensions(input.Extensions); err != nil {\n347|\t\treturn nil, err\n348|\t}\n349|\tvar workspaceValue any\n350|\tif err := json.Unmarshal(bytesTrimSpace(json.RawMessage(input.Workspace)), &workspaceValue); err != nil {\n351|\t\treturn nil, invalid(\"canonical session workspace is not JSON: %v\", err)\n352|\t}\n353|\tactorObjects := make([]any, 0, len(actors))\n354|\tfor _, actor := range actors {\n355|\t\tactorObjects = append(actorObjects, actorObject(actor))\n356|\t}\n357|\t_ = workspace\n358|\treturn map[string]any{\n359|\t\t\"schema\":                   canonicalSessionSchema,\n360|\t\t\"schema_version\":           canonicalSessionVersion,\n361|\t\t\"logical_session_id\":       logical.String(),\n362|\t\t\"source_environment\":       tupleObject(tuple),\n363|\t\t\"source_native_session_id\": input.SourceNativeSessionID,\n364|\t\t\"title\":                    title,\n365|\t\t\"workspace\":                workspaceValue,\n366|\t\t\"actors\":                   actorObjects,\n367|\t\t\"event_ids\":                digestStrings(eventIDs),\n368|\t\t\"head_event_ids\":           digestStrings(headIDs),\n369|\t\t\"created_at\":               createdAt,\n370|\t\t\"updated_at\":               updatedAt,\n371|\t\t\"extensions\":               extensionValue(input.Extensions),\n372|\t}, nil\n373|}\n374|\n375|// DecodeCanonicalSession validates one closed Canonical Session\n376|// 1.0.0: exact members, schema/version, self-digest agreement,\n377|// exactly one main actor, ordered unique event IDs, and head IDs\n378|// drawn from the event set.\n379|func DecodeCanonicalSession(data []byte) (CanonicalSession, error) {\n380|\tmembers, fault := decodeStrictObject(data)\n381|\tif fault != nil {\n382|\t\treturn CanonicalSession{}, invalid(\"canonical session %s (%s)\", fault.detail, memberField(fault.member))\n383|\t}\n384|\tif name, unknown := unknownMember(members, canonicalSessionMembers); unknown {\n385|\t\treturn CanonicalSession{}, invalid(\"canonical session carries unknown member %q\", name)\n386|\t}\n387|\tif name, missing := missingMember(members, canonicalSessionRequired); missing {\n388|\t\treturn CanonicalSession{}, invalid(\"canonical session misses a required member %q\", name)\n389|\t}\n390|\tschema, ok := rawString(members[\"schema\"])\n391|\tif !ok || schema != canonicalSessionSchema {\n392|\t\treturn CanonicalSession{}, invalid(\"canonical session schema is not the canonical session\")\n393|\t}\n394|\tversion, ok := rawString(members[\"schema_version\"])\n395|\tif !ok || version != canonicalSessionVersion {\n396|\t\treturn CanonicalSession{}, invalid(\"canonical session version is not 1.0.0\")\n397|\t}\n398|\tsessionID, ok := checkDigest(members[canonicalSessionSelf])\n399|\tif !ok {\n400|\t\treturn CanonicalSession{}, invalid(\"canonical session canonical_session_id is not a digest\")\n401|\t}\n402|\tlogical, ok := checkUUIDv7(members[\"logical_session_id\"])\n403|\tif !ok {\n404|\t\treturn CanonicalSession{}, invalid(\"canonical session logical_session_id is not a UUIDv7\")\n405|\t}\n406|\ttuple, err := sessadapter.DecodeTuple(members[\"source_environment\"])\n407|\tif err != nil {\n408|\t\treturn CanonicalSession{}, invalid(\"canonical session source_environment is not an Environment Tuple: %v\", err)\n409|\t}\n410|\tnativeID, ok := checkStringBounds(members[\"source_native_session_id\"], 1, 512)\n411|\tif !ok {\n412|\t\treturn CanonicalSession{}, invalid(\"canonical session source_native_session_id is not a string[1..512]\")\n413|\t}\n414|\tif err := SanitizeNativeKey(nativeID); err != nil {\n415|\t\treturn CanonicalSession{}, err\n416|\t}\n417|\tvar title *string\n418|\tif !isNull(members[\"title\"]) {\n419|\t\tvalue, ok := checkStringBounds(members[\"title\"], 1, 4096)\n420|\t\tif !ok {\n421|\t\t\treturn CanonicalSession{}, invalid(\"canonical session title is not a string[1..4096]\")\n422|\t\t}\n423|\t\ttitle = &value\n424|\t}\n425|\tworkspace, err := DecodeWorkspaceBinding(members[\"workspace\"])\n426|\tif err != nil {\n427|\t\treturn CanonicalSession{}, err\n428|\t}\n429|\tactors, err := decodeActors(members[\"actors\"])\n430|\tif err != nil {\n431|\t\treturn CanonicalSession{}, err\n432|\t}\n433|\teventIDs, err := decodeOrderedUniqueDigests(members[\"event_ids\"], 1, 1000000, \"event_ids\")\n434|\tif err != nil {\n435|\t\treturn CanonicalSession{}, err\n436|\t}\n437|\theadIDs, ok := checkSortedUniqueDigests(members[\"head_event_ids\"], 1, 1024)\n438|\tif !ok {\n439|\t\treturn CanonicalSession{}, invalid(\"canonical session head_event_ids are not sorted unique digest[1..1024]\")\n440|\t}\n441|\teventSet := map[string]bool{}\n442|\tfor _, id := range eventIDs {\n443|\t\teventSet[id.String()] = true\n444|\t}\n445|\tfor _, id := range headIDs {\n446|\t\tif !eventSet[id.String()] {\n447|\t\t\treturn CanonicalSession{}, invalid(\"canonical session head_event_ids carry an ID outside event_ids\")\n448|\t\t}\n449|\t}\n450|\tcreatedAt, err := decodeNullableTimestamp(members, \"created_at\", \"canonical session\")\n451|\tif err != nil {\n452|\t\treturn CanonicalSession{}, err\n453|\t}\n454|\tupdatedAt, err := decodeNullableTimestamp(members, \"updated_at\", \"canonical session\")\n455|\tif err != nil {\n456|\t\treturn CanonicalSession{}, err\n457|\t}\n458|\tif !checkExtensions(members[\"extensions\"]) {\n459|\t\treturn CanonicalSession{}, invalid(\"canonical session extensions are not reverse-DNS keyed\")\n460|\t}\n461|\tif err := verifySelfDigest(members, canonicalSessionSelf, sessionID); err != nil {\n462|\t\treturn CanonicalSession{}, err\n463|\t}\n464|\treturn CanonicalSession{\n465|\t\tSessionID:             sessionID,\n466|\t\tLogicalSessionID:      logical,\n467|\t\tSourceEnvironment:     tuple,\n468|\t\tSourceNativeSessionID: nativeID,\n469|\t\tTitle:                 title,\n470|\t\tWorkspace:             workspace,\n471|\t\tActors:                actors,\n472|\t\tEventIDs:              eventIDs,\n473|\t\tHeadEventIDs:          headIDs,\n474|\t\tCreatedAt:             createdAt,\n475|\t\tUpdatedAt:             updatedAt,\n476|\t}, nil\n477|}\n478|\n479|func decodeActors(raw json.RawMessage) ([]Actor, error) {\n480|\telements, ok := decodeArray(raw)\n481|\tif !ok {\n482|\t\treturn nil, invalid(\"canonical session actors are not an array\")\n483|\t}\n484|\tif len(elements) < 1 || len(elements) > 1024 {\n485|\t\treturn nil, invalid(\"canonical session carries %d actors, want [1..1024]\", len(elements))\n486|\t}\n487|\tactors := make([]Actor, 0, len(elements))\n488|\tseen := map[string]bool{}\n489|\tmainCount := 0\n490|\tfor index, element := range elements {\n491|\t\tactor, err := decodeActor(element, index)\n492|\t\tif err != nil {\n493|\t\t\treturn nil, err\n494|\t\t}\n495|\t\tif seen[actor.ActorID.String()] {\n496|\t\t\treturn nil, invalid(\"canonical session actors are not unique by actor ID\")\n497|\t\t}\n498|\t\tseen[actor.ActorID.String()] = true\n499|\t\tif actor.Kind == \"main\" {\n500|\t\t\tmainCount++\n(more lines below)","final_result":true}}}
