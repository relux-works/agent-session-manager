{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca57","stream":{"kind":"session","id":"01a0b0cc-369a-7993-946b-ef774181fd54"},"sequence":902,"recorded_at":1780531400001799,"record_type":"event","durability":"durable","causation_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","run_stream":{"kind":"run","id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3"},"call_id":"call_01a0b0cf02cb7252b57313036d989c03","text":"Read text file `internal/clonebundle/refusal_test.go`.\n(499 line(s) above)\n500|\t\tif _, err := BuildCaptureManifest(input); err != nil {\n501|\t\t\tt.Fatalf(\"BuildCaptureManifest(external basis) error = %v\", err)\n502|\t\t}\n503|\t})\n504|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca59","stream":{"kind":"session","id":"01a0b0cc-369a-7993-946b-ef774181fd54"},"sequence":903,"recorded_at":1780531400001801,"record_type":"event","durability":"durable","causation_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","run_stream":{"kind":"run","id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3"},"call_id":"call_01a0b0cf04f474ddbfdbe06588eb6d03","text":"Read text file `internal/clonebundle/exclusion_test.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"testing\"\n5|)\n6|\n7|// Row-21 exclusion tests (handoff from TASK-260909-2ez769): the\n8|// bundle member allowlist rejects hosttrust.MatchExcludedFromReplication\n9|// and hosttrust.ExcludedConfigDirName matches at construction, in\n10|// both the raw manifest and the capture manifest, with one\n11|// constructor negative per excluded class. Neighboring allowed paths\n12|// still admit, proving the gate is the matcher and not a prefix ban.\n13|\n14|func excludedReplicationKeys() []string {\n15|\treturn []string{\n16|\t\t\"host-channel/trust.json\",\n17|\t\t\"host-channel/config-binding.json\",\n18|\t\t\"host-channel/pending-commit.json\",\n19|\t\t\"host-channel/credentials/0198f4c8-8e50-7f66-8f70-1234567890ac/private-key.pem\",\n20|\t\t\"host-channel/credentials/leaf.pem\",\n21|\t\t\"host-channel/lock\",\n22|\t\t\".trust-stage-1\",\n23|\t\t\"state/.trust-stage-2\",\n24|\t\t\".custody-stage-3\",\n25|\t\t\"state/.custody-stage-4\",\n26|\t\t\"lock-stage-5\",\n27|\t\t\"../escape\",\n28|\t\t\"state/../../escape\",\n29|\t}\n30|}\n31|\n32|func excludedConfigKeys() []string {\n33|\treturn []string{\n34|\t\t\"settings.bak.3\",\n35|\t\t\"state/settings.bak.3\",\n36|\t\t\"settings.pre-rollback.3\",\n37|\t\t\".ax-config-stage-1\",\n38|\t\t\"state/.ax-config-stage-2\",\n39|\t\t\"x.ax-config-binding.json\",\n40|\t}\n41|}\n42|\n43|func TestRawManifestExcludesTrustMaterial(t *testing.T) {\n44|\tidentity := fixtureNativeIdentity()\n45|\tidentityDigest, err := IdentityDigest(identity, nil)\n46|\tif err != nil {\n47|\t\tt.Fatal(err)\n48|\t}\n49|\tbuild := func(key string) error {\n50|\t\tinputs := validEntryInputs(t)\n51|\t\tinputs[0].NativeItemKey = key\n52|\t\t// Keep the pair sorted so the exclusion gate, not the order\n53|\t\t// gate, fires: the fixture second key sorts after every\n54|\t\t// excluded key under test except none, so swap when needed.\n55|\t\tif len(inputs) == 2 && inputs[0].NativeItemKey > inputs[1].NativeItemKey {\n56|\t\t\tinputs[0], inputs[1] = inputs[1], inputs[0]\n57|\t\t}\n58|\t\t_, err := BuildRawObjectManifest(fixtureOperationID, []byte(fixtureTupleJSON()),\n59|\t\t\t\"native-session-alpha\", identityDigest.String(), fixtureDigest(\"test-capture-plan\"), inputs, nil)\n60|\t\treturn err\n61|\t}\n62|\tfor _, key := range excludedReplicationKeys() {\n63|\t\tt.Run(\"replication/\"+key, func(t *testing.T) {\n64|\t\t\trequireRefusal(t, build(key), \"excluded from replication\")\n65|\t\t})\n66|\t}\n67|\tfor _, key := range excludedConfigKeys() {\n68|\t\tt.Run(\"config/\"+key, func(t *testing.T) {\n69|\t\t\trequireRefusal(t, build(key), \"trust-adjacent config material\")\n70|\t\t})\n71|\t}\n72|\t// Neighboring allowed keys admit through the same entry.\n73|\tfor _, key := range []string{\n74|\t\t\"store/payload.bin\",\n75|\t\t\"host-channel/credentials-export.json\",\n76|\t\t\"state/settings.toml\",\n77|\t\t\"config-backup.toml\",\n78|\t} {\n79|\t\tinputs := validEntryInputs(t)\n80|\t\tinputs[0].NativeItemKey = key\n81|\t\tif len(inputs) == 2 && inputs[0].NativeItemKey > inputs[1].NativeItemKey {\n82|\t\t\tinputs[0], inputs[1] = inputs[1], inputs[0]\n83|\t\t}\n84|\t\tif _, err := BuildRawObjectManifest(fixtureOperationID, []byte(fixtureTupleJSON()),\n85|\t\t\t\"native-session-alpha\", identityDigest.String(), fixtureDigest(\"test-capture-plan\"), inputs, nil); err != nil {\n86|\t\t\tt.Fatalf(\"BuildRawObjectManifest(%q) error = %v\", key, err)\n87|\t\t}\n88|\t}\n89|\t// Decode refuses excluded keys too (the gate fires before the\n90|\t// self-digest check, so no re-sealing is needed).\n91|\tvalid := mustRawBytes(t)\n92|\ttampered := tamper(t, valid, func(o map[string]any) {\n93|\t\tentries := o[\"entries\"].([]any)\n94|\t\tentries[0].(map[string]any)[\"native_item_key\"] = \"host-channel/trust.json\"\n95|\t})\n96|\t_, err = DecodeRawObjectManifest(tampered)\n97|\trequireRefusal(t, err, \"excluded from replication\")\n98|}\n99|\n100|func TestCaptureManifestExcludesTrustMaterial(t *testing.T) {\n101|\tbuild := func(key string) error {\n102|\t\tinput := validCaptureInput(t)\n103|\t\treason := \"credential_excluded\"\n104|\t\tinput.Items = []CaptureItemInput{\n105|\t\t\t{NativeItemKey: key, Class: \"credential\", Disposition: \"excluded\", ExclusionReason: &reason},\n106|\t\t}\n107|\t\tinput.PlanKeys = []string{key}\n108|\t\tinput.RawKeys = nil\n109|\t\t_, err := BuildCaptureManifest(input)\n110|\t\treturn err\n111|\t}\n112|\tfor _, key := range excludedReplicationKeys() {\n113|\t\tt.Run(\"replication/\"+key, func(t *testing.T) {\n114|\t\t\trequireRefusal(t, build(key), \"excluded from replication\")\n115|\t\t})\n116|\t}\n117|\tfor _, key := range excludedConfigKeys() {\n118|\t\tt.Run(\"config/\"+key, func(t *testing.T) {\n119|\t\t\trequireRefusal(t, build(key), \"trust-adjacent config material\")\n120|\t\t})\n121|\t}\n122|\tvalid := mustCaptureBytes(t)\n123|\ttampered := tamper(t, valid, func(o map[string]any) {\n124|\t\titems := o[\"items\"].([]any)\n125|\t\titems[0].(map[string]any)[\"native_item_key\"] = \"host-channel/pending-commit.json\"\n126|\t})\n127|\t_, err := DecodeCaptureManifest(tampered)\n128|\trequireRefusal(t, err, \"excluded from replication\")\n129|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
