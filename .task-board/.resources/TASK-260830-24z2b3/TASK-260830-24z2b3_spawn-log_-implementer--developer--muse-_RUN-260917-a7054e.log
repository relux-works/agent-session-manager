contentBlockMembers = map[string]bool{\n620|\t\"type\": true, \"content\": true, \"blob_descriptor_id\": true, \"media_type\": true, \"extensions\": true,\n621|}\n622|\n623|// checkContentBlocks validates message-like content blocks: strict\n624|// objects with a vocabulary type, inline content of at most 64 KiB,\n625|// and digest-grammar Blob Descriptor references.\n626|func checkContentBlocks(raw json.RawMessage) error {\n627|\telements, ok := decodeArray(raw)\n628|\tif !ok {\n629|\t\treturn invalid(\"canonical event content_blocks are not an array\")\n630|\t}\n631|\tfor index, element := range elements {\n632|\t\tmembers, fault := decodeStrictObject(bytesTrimSpace(element))\n633|\t\tif fault != nil {\n634|\t\t\treturn invalid(\"canonical event content block[%d] %s (%s)\", index, fault.detail, memberField(fault.member))\n635|\t\t}\n636|\t\tif name, unknown := unknownMember(members, contentBlockMembers); unknown {\n637|\t\t\treturn invalid(\"canonical event content block[%d] carries unknown member %q\", index, name)\n638|\t\t}\n639|\t\tblockTypeValue, present := members[\"type\"]\n640|\t\tif !present {\n641|\t\t\treturn invalid(\"canonical event content block[%d] misses its type\", index)\n642|\t\t}\n643|\t\tblockType, ok := rawString(blockTypeValue)\n644|\t\tif !ok || !validContentBlockType(blockType) {\n645|\t\t\treturn invalid(\"canonical event content block[%d] type is outside the eight-type vocabulary\", index)\n646|\t\t}\n647|\t\tif content, present := members[\"content\"]; present {\n648|\t\t\ttext, ok := rawString(content)\n649|\t\t\tif !ok {\n650|\t\t\t\treturn invalid(\"canonical event content block[%d] content is not a string\", index)\n651|\t\t\t}\n652|\t\t\tif len(text) > maxInlineContent {\n653|\t\t\t\treturn invalid(\"canonical event content block[%d] inline content exceeds 64 KiB\", index)\n654|\t\t\t}\n655|\t\t}\n656|\t\tif descriptor, present := members[\"blob_descriptor_id\"]; present {\n657|\t\t\tif _, ok := checkDigest(descriptor); !ok {\n658|\t\t\t\treturn invalid(\"canonical event content block[%d] blob_descriptor_id is not a digest\", index)\n659|\t\t\t}\n660|\t\t}\n661|\t\tif mediaType, present := members[\"media_type\"]; present {\n662|\t\t\tif _, ok := checkStringBounds(mediaType, 1, 255); !ok {\n663|\t\t\t\treturn invalid(\"canonical event content block[%d] media_type is not a string[1..255]\", index)\n664|\t\t\t}\n665|\t\t}\n666|\t\tif extensions, present := members[\"extensions\"]; present {\n667|\t\t\tif !checkExtensions(extensions) {\n668|\t\t\t\treturn invalid(\"canonical event content block[%d] extensions are not reverse-DNS keyed\", index)\n669|\t\t\t}\n670|\t\t}\n671|\t}\n672|\treturn nil\n673|}\n674|\n675|func buildSourceEvidence(input EvidenceInput) (map[string]any, error) {\n676|\ttuple, err := sessadapter.DecodeTuple(json.RawMessage(input.Environment))\n677|\tif err != nil {\n678|\t\treturn nil, invalid(\"source evidence environment is not an Environment Tuple: %v\", err)\n679|\t}\n680|\tif len(input.NativeSessionID) < 1 || len(input.NativeSessionID) > 512 {\n681|\t\treturn nil, invalid(\"source evidence native_session_id is not a string[1..512]\")\n682|\t}\n683|\tif err := SanitizeNativeKey(input.NativeSessionID); err != nil {\n684|\t\treturn nil, err\n685|\t}\n686|\tvar nativeEvent any\n687|\thasNativeEvent := false\n688|\tif input.NativeEventID != nil {\n689|\t\tif len(*input.NativeEventID) < 1 || len(*input.NativeEventID) > 512 {\n690|\t\t\treturn nil, invalid(\"source evidence native_event_id is not a string[1..512]\")\n691|\t\t}\n692|\t\tif err := SanitizeNativeKey(*input.NativeEventID); err != nil {\n693|\t\t\treturn nil, err\n694|\t\t}\n695|\t\tnativeEvent = *input.NativeEventID\n696|\t\thasNativeEvent = true\n697|\t}\n698|\tvar nativeType any\n699|\tif input.NativeType != nil {\n700|\t\tif len(*input.NativeType) < 1 || len(*input.NativeType) > 512 {\n701|\t\t\treturn nil, invalid(\"source evidence native_type is not a string[1..512]\")\n702|\t\t}\n703|\t\tnativeType = *input.NativeType\n704|\t}\n705|\tif len(input.RawRefs) > 65536 {\n706|\t\treturn nil, invalid(\"source evidence carries %d raw_refs, maximum is 65536\", len(input.RawRefs))\n707|\t}\n708|\treferences := make([]RawReference, 0, len(input.RawRefs))\n709|\tvar previous []byte\n710|\tfor index, candidate := range input.RawRefs {\n711|\t\tmanifestID, err := scalar.ParseDigest(candidate.ManifestID)\n712|\t\tif err != nil {\n713|\t\t\treturn nil, invalid(\"raw reference[%d] manifest_id is not a digest: %v\", index, err)\n714|\t\t}\n715|\t\tdescriptorID, err := scalar.ParseDigest(candidate.BlobDescriptorID)\n716|\t\tif err != nil {\n717|\t\t\treturn nil, invalid(\"raw reference[%d] blob_descriptor_id is not a digest: %v\", index, err)\n718|\t\t}\n719|\t\tif candidate.Offset > maxUint53 {\n720|\t\t\treturn nil, invalid(\"raw reference[%d] offset exceeds uint53\", index)\n721|\t\t}\n722|\t\tif candidate.Length > maxUint53 {\n723|\t\t\treturn nil, invalid(\"raw reference[%d] length exceeds uint53\", index)\n724|\t\t}\n725|\t\treference := RawReference{\n726|\t\t\tManifestID:       manifestID,\n727|\t\t\tBlobDescriptorID: descriptorID,\n728|\t\t\tOffset:           candidate.Offset,\n729|\t\t\tLength:           candidate.Length,\n730|\t\t}\n731|\t\tkey, err := canonicalizeObject(rawReferenceObject(reference))\n732|\t\tif err != nil {\n733|\t\t\treturn nil, err\n734|\t\t}\n735|\t\tif index > 0 && bytes.Compare(key, previous) <= 0 {\n736|\t\t\treturn nil, invalid(\"source evidence raw_refs are not sorted unique\")\n737|\t\t}\n738|\t\tprevious = key\n739|\t\treferences = append(references, reference)\n740|\t}\n741|\tif !validCaptureStatus(input.CaptureStatus) {\n742|\t\treturn nil, invalid(\"source evidence capture_status is outside exact|partial|synthesized|unavailable\")\n743|\t}\n744|\tpreviousReason := \"\"\n745|\tfor index, reason := range input.ReasonCodes {\n746|\t\tif len(reason) < 1 || len(reason) > 128 {\n747|\t\t\treturn nil, invalid(\"source evidence reason_codes[%d] is not a string[1..128]\", index)\n748|\t\t}\n749|\t\tif index > 0 && reason <= previousReason {\n750|\t\t\treturn nil, invalid(\"source evidence reason_codes are not sorted unique\")\n751|\t\t}\n752|\t\tpreviousReason = reason\n753|\t}\n754|\tif len(input.ReasonCodes) > 128 {\n755|\t\treturn nil, invalid(\"source evidence carries %d reason_codes, maximum is 128\", len(input.ReasonCodes))\n756|\t}\n757|\tvar operation any\n758|\thasOperation := false\n759|\tif input.CoreOperationID != nil {\n760|\t\tvalue, err := scalar.ParseUUIDv7(*input.CoreOperationID)\n761|\t\tif err != nil {\n762|\t\t\treturn nil, invalid(\"source evidence core_operation_id is not a UUIDv7: %v\", err)\n763|\t\t}\n764|\t\toperation = value.String()\n765|\t\thasOperation = true\n766|\t}\n767|\tif err := checkEvidenceCoupling(input.CaptureStatus, hasNativeEvent, hasOperation); err != nil {\n768|\t\treturn nil, err\n769|\t}\n770|\tobjects := make([]any, 0, len(references))\n771|\tfor _, reference := range references {\n772|\t\tobjects = append(objects, rawReferenceObject(reference))\n773|\t}\n774|\treasons := make([]any, 0, len(input.ReasonCodes))\n775|\tfor _, reason := range input.ReasonCodes {\n776|\t\treasons = append(reasons, reason)\n777|\t}\n778|\treturn map[string]any{\n779|\t\t\"environment\":       tupleObject(tuple),\n780|\t\t\"native_session_id\": input.NativeSessionID,\n781|\t\t\"native_event_id\":   nativeEvent,\n782|\t\t\"native_type\":       nativeType,\n783|\t\t\"raw_refs\":          objects,\n784|\t\t\"capture_status\":    input.CaptureStatus,\n785|\t\t\"reason_codes\":      reasons,\n786|\t\t\"core_operation_id\": operation,\n787|\t\t\"extensions\":        map[string]any{},\n788|\t}, nil\n789|}\n790|\n791|// CheckOrdinalContiguity verifies the event-set ordinal rule:\n792|// ordinals are zero-based and contiguous, so the set must be\n793|// exactly {0..n-1}.\n794|func CheckOrdinalContiguity(ordinals []uint64) error {\n795|\tseen := make(map[uint64]bool, len(ordinals))\n796|\tfor _, ordinal := range ordinals {\n797|\t\tif ordinal >= uint64(len(ordinals)) {\n798|\t\t\treturn invalid(\"event ordinals are not contiguous from zero: ordinal %d outside [0..%d]\", ordinal, len(ordinals)-1)\n799|\t\t}\n800|\t\tif seen[ordinal] {\n801|\t\t\treturn invalid(\"event ordinals are not contiguous from zero: duplicate ordinal %d\", ordinal)\n802|\t\t}\n803|\t\tseen[ordinal] = true\n804|\t}\n805|\treturn nil\n806|}","final_result":true}}}
