\n305|\t\t\t\t_, err := DecodeCaptureManifest(tc.body(t))\n306|\t\t\t\trequireRefusal(t, err, tc.fragment)\n307|\t\t\t})\n308|\t\t}\n309|\t})\n310|\tt.Run(\"reconciliation\", func(t *testing.T) {\n311|\t\tinput := validCaptureInput(t)\n312|\t\tbuilt, err := BuildCaptureManifest(input)\n313|\t\tif err != nil {\n314|\t\t\tt.Fatal(err)\n315|\t\t}\n316|\t\tmanifest, err := DecodeCaptureManifest(built)\n317|\t\tif err != nil {\n318|\t\t\tt.Fatal(err)\n319|\t\t}\n320|\t\tif err := VerifyCaptureReconciliation(manifest, []string{\"store/blob-a\"}, input.RawKeys); !errors.Is(err, ErrInvalid) {\n321|\t\t\tt.Fatalf(\"short plan error = %v, want ErrInvalid\", err)\n322|\t\t}\n323|\t\tif err := VerifyCaptureReconciliation(manifest, input.PlanKeys, []string{\"store/blob-a\"}); !errors.Is(err, ErrInvalid) {\n324|\t\t\tt.Fatalf(\"short raw error = %v, want ErrInvalid\", err)\n325|\t\t}\n326|\t\t// A manifest whose flag disagrees with the derivation is refused\n327|\t\t// even when the key sets reconcile.\n328|\t\tflipped := manifest\n329|\t\tflipped.RawComplete = false\n330|\t\tif err := VerifyCaptureReconciliation(flipped, input.PlanKeys, input.RawKeys); !errors.Is(err, ErrInvalid) {\n331|\t\t\tt.Fatalf(\"flipped flag error = %v, want ErrInvalid\", err)\n332|\t\t}\n333|\t\tincomplete := manifest\n334|\t\tincomplete.RawComplete = false\n335|\t\tif err := RefuseMaximalSafeUnlessComplete(incomplete); !errors.Is(err, ErrInvalid) {\n336|\t\t\tt.Fatalf(\"incomplete maximal_safe error = %v, want ErrInvalid\", err)\n337|\t\t}\n338|\t})\n339|\tt.Run(\"build envelope\", func(t *testing.T) {\n340|\t\tinput := validCaptureInput(t)\n341|\t\tinput.BundleID = \"nope\"\n342|\t\tif _, err := BuildCaptureManifest(input); !errors.Is(err, ErrInvalid) {\n343|\t\t\tt.Fatalf(\"bad bundle error = %v, want ErrInvalid\", err)\n344|\t\t}\n345|\t\tinput = validCaptureInput(t)\n346|\t\tinput.CreatedAt = \"yesterday\"\n347|\t\tif _, err := BuildCaptureManifest(input); !errors.Is(err, ErrInvalid) {\n348|\t\t\tt