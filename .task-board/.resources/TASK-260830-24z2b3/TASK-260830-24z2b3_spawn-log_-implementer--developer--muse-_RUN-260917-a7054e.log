{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c65d","stream":{"kind":"session","id":"01a0b0cc-369a-7993-946b-ef774181fd54"},"sequence":393,"recorded_at":1780531400000781,"record_type":"event","durability":"durable","causation_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","run_stream":{"kind":"run","id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3"},"task_stream":{"kind":"task","id":"01a0b0cd-13fd-7bf1-87c1-1e68f220e98c"},"task_id":"01a0b0cd-13fd-7bf1-87c1-1e68f220e98c","event":{"kind":"output","task_id":"01a0b0cd-13fd-7bf1-87c1-1e68f220e98c","chunk":"Read text file `internal/clonebundle/blobref.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"io\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/localstore\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// This file owns the Section 10.2 raw evidence descriptor path: Blob\n13|// Descriptor identity and byte-count agreement, and no-replace blob\n14|// installation through the landed localstore durable-write\n15|// discipline. This package performs no durable write itself: every\n16|// byte crosses localstore.ObjectStore.PutBlob, whose no-replace,\n17|// fsync, and crash/idempotency evidence is cited in TRACEABILITY.md.\n18|\n19|// BlobAgreement is the verified agreement between a manifest entry\n20|// and its Section 10.2 Blob Descriptor.\n21|type BlobAgreement struct {\n22|\tDescriptorID scalar.Digest\n23|\tBlobID       scalar.Digest\n24|\tSize         uint64\n25|}\n26|\n27|// VerifyDescriptorAgreement verifies one raw evidence descriptor:\n28|// the bytes must be a closed valid Blob Descriptor 1.0.0 whose\n29|// claimed identity equals the computed omit-self digest, and the\n30|// descriptor's blob ID and size must agree with the manifest\n31|// entry's claim. Shape validation and digest computation run\n32|// through the canonicaljson owner, never a fork; the claim\n33|// comparison is local, because binding attestation outside the\n34|// session leaf is refused by the provhost no-attestation bound, so\n35|// this package never calls the attesting entry.\n36|func VerifyDescriptorAgreement(descriptor []byte, wantBlobID scalar.Digest, wantSize uint64) error {\n37|\tcalculated, claimed, members, err := calculateDescriptorIdentity(descriptor)\n38|\tif err != nil {\n39|\t\treturn err\n40|\t}\n41|\tif calculated != claimed {\n42|\t\treturn invalid(\"blob descriptor claim %q does not match omit-self digest %q\", claimed.String(), calculated.String())\n43|\t}\n44|\tblobID, ok := checkDigest(members[\"blob_id\"])\n45|\tif !ok {\n46|\t\treturn invalid(\"blob descriptor blob_id is not a digest\")\n47|\t}\n48|\tif blobID != wantBlobID {\n49|\t\treturn invalid(\"blob descriptor blob_id %q disagrees with entry claim %q\", blobID.String(), wantBlobID.String())\n50|\t}\n51|\tsize, ok := rawUint53(members[\"size\"])\n52|\tif !ok {\n53|\t\treturn invalid(\"blob descriptor size is not a uint53\")\n54|\t}\n55|\tif size != wantSize {\n56|\t\treturn invalid(\"blob descriptor size %d disagrees with entry claim %d\", size, wantSize)\n57|\t}\n58|\treturn nil\n59|}\n60|\n61|// InstallRawBlob installs one raw evidence blob through the landed\n62|// durable-write discipline: fsync, size/digest verification, and\n63|// atomic no-replace install owned by localstore. It returns the\n64|// verified agreement. A digest collision or same-ID/different-bytes\n65|// observation quarantines through the store owner; this package\n66|// adds no second write path.\n67|func InstallRawBlob(store *localstore.ObjectStore, descriptor []byte, source io.Reader) (BlobAgreement, error) {\n68|\tcalculated, claimed, members, err := calculateDescriptorIdentity(descriptor)\n69|\tif err != nil {\n70|\t\treturn BlobAgreement{}, err\n71|\t}\n72|\tif calculated != claimed {\n73|\t\treturn BlobAgreement{}, invalid(\"blob descriptor claim %q does not match omit-self digest %q\", claimed.String(), calculated.String())\n74|\t}\n75|\tblobID, ok := checkDigest(members[\"blob_id\"])\n76|\tif !ok {\n77|\t\treturn BlobAgreement{}, invalid(\"blob descriptor blob_id is not a digest\")\n78|\t}\n79|\tsize, ok := rawUint53(members[\"size\"])\n80|\tif !ok {\n81|\t\treturn BlobAgreement{}, invalid(\"blob descriptor size is not a uint53\")\n82|\t}\n83|\tif store == nil {\n84|\t\treturn BlobAgreement{}, invalid(\"blob install requires an object store\")\n85|\t}\n86|\tif _, err := store.PutBlob(blobID, size, source); err != nil {\n87|\t\treturn BlobAgreement{}, invalid(\"blob install refused: %v\", err)\n88|\t}\n89|\treturn BlobAgreement{DescriptorID: calculated, BlobID: blobID, Size: size}, nil\n90|}\n91|\n92|// calculateDescriptorIdentity runs the owner's shape validation and\n93|// omit-self computation over one descriptor and reads its claimed\n94|// self digest. Callers compare the two; this helper never attests.\n95|func calculateDescriptorIdentity(descriptor []byte) (scalar.Digest, scalar.Digest, map[string]json.RawMessage, error) {\n96|\tcalculated, field, err := canonicaljson.CalculateObjectIdentity(descriptor)\n97|\tif err != nil {\n98|\t\treturn scalar.Digest{}, scalar.Digest{}, nil, invalid(\"blob descriptor identity fails: %v\", err)\n99|\t}\n100|\tif field != \"descriptor_id\" {\n101|\t\treturn scalar.Digest{}, scalar.Digest{}, nil, invalid(\"blob descriptor self field is %q, want descriptor_id\", string(field))\n102|\t}\n103|\tvar members map[string]json.RawMessage\n104|\tif err := json.Unmarshal(descriptor, &members); err != nil {\n105|\t\treturn scalar.Digest{}, scalar.Digest{}, nil, invalid(\"blob descriptor is not an object: %v\", err)\n106|\t}\n107|\tclaimed, ok := checkDigest(members[\"descriptor_id\"])\n108|\tif !ok {\n109|\t\treturn scalar.Digest{}, scalar.Digest{}, nil, invalid(\"blob descriptor descriptor_id is not a digest\")\n110|\t}\n111|\treturn calculated, claimed, members, nil\n112|}","final_result":true}}}
