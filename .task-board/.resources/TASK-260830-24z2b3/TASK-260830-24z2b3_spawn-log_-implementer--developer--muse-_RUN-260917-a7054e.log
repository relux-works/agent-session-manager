{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6f5","stream":{"kind":"session","id":"01a0b0cc-369a-7993-946b-ef774181fd54"},"sequence":469,"recorded_at":1780531400000933,"record_type":"event","durability":"durable","causation_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","run_stream":{"kind":"run","id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3"},"call_id":"call_01a0b0cd2b4477c7bee96c82e78d01db","text":"Read text file `internal/clonebundle/boundary.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n7|)\n8|\n9|// This file validates the Capture Source Basis and Capture Boundary\n10|// closed unions of Clone Capture Manifest 1.0.0, including the\n11|// StableSnapshotProof. The stable form carries proof; the unstable\n12|// form is core-created archive-only output that can never enter a\n13|// target branch.\n14|\n15|// SourceBasis is one validated Capture Source Basis.\n16|type SourceBasis struct {\n17|\tKind                     string\n18|\tSourceSessionID          *scalar.UUIDv7\n19|\tSourceSessionRecordID    *scalar.Digest\n20|\tSourceCheckpointID       *scalar.Digest\n21|\tSourceProviderIdentityID *scalar.Digest\n22|\tExternalSourceRef        *string\n23|}\n24|\n25|var sourceBasisAXMembers = map[string]bool{\n26|\t\"kind\": true, \"source_session_id\": true, \"source_session_record_id\": true,\n27|\t\"source_checkpoint_id\": true, \"source_provider_identity_record_id\": true, \"extensions\": true,\n28|}\n29|\n30|var sourceBasisAXRequired = []string{\n31|\t\"kind\", \"source_session_id\", \"source_session_record_id\",\n32|\t\"source_checkpoint_id\", \"source_provider_identity_record_id\", \"extensions\",\n33|}\n34|\n35|var sourceBasisExternalMembers = map[string]bool{\n36|\t\"kind\": true, \"external_source_ref\": true, \"extensions\": true,\n37|}\n38|\n39|var sourceBasisExternalRequired = []string{\n40|\t\"kind\", \"external_source_ref\", \"extensions\",\n41|}\n42|\n43|// DecodeSourceBasis validates one closed Capture Source Basis.\n44|func DecodeSourceBasis(raw json.RawMessage) (SourceBasis, error) {\n45|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n46|\tif fault != nil {\n47|\t\treturn SourceBasis{}, invalid(\"source basis %s (%s)\", fault.detail, memberField(fault.member))\n48|\t}\n49|\tkindValue, present := members[\"kind\"]\n50|\tif !present {\n51|\t\treturn SourceBasis{}, invalid(\"source basis misses a required member %q\", \"kind\")\n52|\t}\n53|\tkind, ok := rawString(kindValue)\n54|\tif !ok {\n55|\t\treturn SourceBasis{}, invalid(\"source basis kind is not a string\")\n56|\t}\n57|\tswitch kind {\n58|\tcase \"ax_session\":\n59|\t\treturn decodeAXSessionBasis(members)\n60|\tcase \"external_native\":\n61|\t\treturn decodeExternalNativeBasis(members)\n62|\tdefault:\n63|\t\treturn SourceBasis{}, invalid(\"source basis kind is outside ax_session|external_native\")\n64|\t}\n65|}\n66|\n67|func decodeAXSessionBasis(members map[string]json.RawMessage) (SourceBasis, error) {\n68|\tif name, unknown := unknownMember(members, sourceBasisAXMembers); unknown {\n69|\t\treturn SourceBasis{}, invalid(\"source basis carries unknown member %q\", name)\n70|\t}\n71|\tif name, missing := missingMember(members, sourceBasisAXRequired); missing {\n72|\t\treturn SourceBasis{}, invalid(\"source basis misses a required member %q\", name)\n73|\t}\n74|\tsessionID, ok := checkUUIDv7(members[\"source_session_id\"])\n75|\tif !ok {\n76|\t\treturn SourceBasis{}, invalid(\"source basis source_session_id is not a UUIDv7\")\n77|\t}\n78|\trecordID, ok := checkDigest(members[\"source_session_record_id\"])\n79|\tif !ok {\n80|\t\treturn SourceBasis{}, invalid(\"source basis source_session_record_id is not a digest\")\n81|\t}\n82|\tcheckpointID, ok := checkDigest(members[\"source_checkpoint_id\"])\n83|\tif !ok {\n84|\t\treturn SourceBasis{}, invalid(\"source basis source_checkpoint_id is not a digest\")\n85|\t}\n86|\tproviderID, ok := checkDigest(members[\"source_provider_identity_record_id\"])\n87|\tif !ok {\n88|\t\treturn SourceBasis{}, invalid(\"source basis source_provider_identity_record_id is not a digest\")\n89|\t}\n90|\tif !checkExtensions(members[\"extensions\"]) {\n91|\t\treturn SourceBasis{}, invalid(\"source basis extensions are not reverse-DNS keyed\")\n92|\t}\n93|\treturn SourceBasis{\n94|\t\tKind:                     \"ax_session\",\n95|\t\tSourceSessionID:          &sessionID,\n96|\t\tSourceSessionRecordID:    &recordID,\n97|\t\tSourceCheckpointID:       &checkpointID,\n98|\t\tSourceProviderIdentityID: &providerID,\n99|\t}, nil\n100|}\n101|\n102|func decodeExternalNativeBasis(members map[string]json.RawMessage) (SourceBasis, error) {\n103|\tif name, unknown := unknownMember(members, sourceBasisExternalMembers); unknown {\n104|\t\treturn SourceBasis{}, invalid(\"source basis carries unknown member %q\", name)\n105|\t}\n106|\tif name, missing := missingMember(members, sourceBasisExternalRequired); missing {\n107|\t\treturn SourceBasis{}, invalid(\"source basis misses a required member %q\", name)\n108|\t}\n109|\treference, ok := checkStringBounds(members[\"external_source_ref\"], 1, 512)\n110|\tif !ok {\n111|\t\treturn SourceBasis{}, invalid(\"source basis external_source_ref is not a string[1..512]\")\n112|\t}\n113|\tif err := SanitizeNativeKey(reference); err != nil {\n114|\t\treturn SourceBasis{}, err\n115|\t}\n116|\tif !checkExtensions(members[\"extensions\"]) {\n117|\t\treturn SourceBasis{}, invalid(\"source basis extensions are not reverse-DNS keyed\")\n118|\t}\n119|\treturn SourceBasis{Kind: \"external_native\", ExternalSourceRef: &reference}, nil\n120|}\n121|\n122|// SourceBasisInput is one caller-supplied source basis candidate for\n123|// Build. Exactly the kind-selected fields must be set.\n124|type SourceBasisInput struct {\n125|\tKind                     string\n126|\tSourceSessionID          string\n127|\tSourceSessionRecordID    string\n128|\tSourceCheckpointID       string\n129|\tSourceProviderIdentityID string\n130|\tExternalSourceRef        string\n131|}\n132|\n133|func buildSourceBasis(input SourceBasisInput) (SourceBasis, map[string]any, error) {\n134|\tswitch input.Kind {\n135|\tcase \"ax_session\":\n136|\t\tsessionID, err := scalar.ParseUUIDv7(input.SourceSessionID)\n137|\t\tif err != nil {\n138|\t\t\treturn SourceBasis{}, nil, invalid(\"source basis source_session_id is not a UUIDv7: %v\", err)\n139|\t\t}\n140|\t\trecordID, err := scalar.ParseDigest(input.SourceSessionRecordID)\n141|\t\tif err != nil {\n142|\t\t\treturn SourceBasis{}, nil, invalid(\"source basis source_session_record_id is not a digest: %v\", err)\n143|\t\t}\n144|\t\tcheckpointID, err := scalar.ParseDigest(input.SourceCheckpointID)\n145|\t\tif err != nil {\n146|\t\t\treturn SourceBasis{}, nil, invalid(\"source basis source_checkpoint_id is not a digest: %v\", err)\n147|\t\t}\n148|\t\tproviderID, err := scalar.ParseDigest(input.SourceProviderIdentityID)\n149|\t\tif err != nil {\n150|\t\t\treturn SourceBasis{}, nil, invalid(\"source basis source_provider_identity_record_id is not a digest: %v\", err)\n151|\t\t}\n152|\t\tif input.ExternalSourceRef != \"\" {\n153|\t\t\treturn SourceBasis{}, nil, invalid(\"source basis ax_session carries an external source reference\")\n154|\t\t}\n155|\t\tbasis := SourceBasis{\n156|\t\t\tKind:                     \"ax_session\",\n157|\t\t\tSourceSessionID:          &sessionID,\n158|\t\t\tSourceSessionRecordID:    &recordID,\n159|\t\t\tSourceCheckpointID:       &checkpointID,\n160|\t\t\tSourceProviderIdentityID: &providerID,\n161|\t\t}\n162|\t\treturn basis, map[string]any{\n163|\t\t\t\"kind\":                               \"ax_session\",\n164|\t\t\t\"source_session_id\":                  sessionID.String(),\n165|\t\t\t\"source_session_record_id\":           recordID.String(),\n166|\t\t\t\"source_checkpoint_id\":               checkpointID.String(),\n167|\t\t\t\"source_provider_identity_record_id\": providerID.String(),\n168|\t\t\t\"extensions\":                         map[string]any{},\n169|\t\t}, nil\n170|\tcase \"external_native\":\n171|\t\tif len(input.ExternalSourceRef) < 1 || len(input.ExternalSourceRef) > 512 {\n172|\t\t\treturn SourceBasis{}, nil, invalid(\"source basis external_source_ref is not a string[1..512]\")\n173|\t\t}\n174|\t\tif err := SanitizeNativeKey(input.ExternalSourceRef); err != nil {\n175|\t\t\treturn SourceBasis{}, nil, err\n176|\t\t}\n177|\t\tif input.SourceSessionID != \"\" || input.SourceSessionRecordID != \"\" ||\n178|\t\t\tinput.SourceCheckpointID != \"\" || input.SourceProviderIdentityID != \"\" {\n179|\t\t\treturn SourceBasis{}, nil, invalid(\"source basis external_native carries ax_session members\")\n180|\t\t}\n181|\t\tbasis := SourceBasis{Kind: \"external_native\", ExternalSourceRef: &input.ExternalSourceRef}\n182|\t\treturn basis, map[string]any{\n183|\t\t\t\"kind\":                \"external_native\",\n184|\t\t\t\"external_source_ref\": input.ExternalSourceRef,\n185|\t\t\t\"extensions\":          map[string]any{},\n186|\t\t}, nil\n187|\tdefault:\n188|\t\treturn SourceBasis{}, nil, invalid(\"source basis kind is outside ax_session|external_native\")\n189|\t}\n190|}\n191|\n192|func sourceBasisObject(basis SourceBasis) map[string]any {\n193|\tif basis.Kind == \"external_native\" {\n194|\t\treference := \"\"\n195|\t\tif basis.ExternalSourceRef != nil {\n196|\t\t\treference = *basis.ExternalSourceRef\n197|\t\t}\n198|\t\treturn map[string]any{\n199|\t\t\t\"kind\":                \"external_native\",\n200|\t\t\t\"external_source_ref\": reference,\n201|\t\t\t\"extensions\":          map[string]any{},\n202|\t\t}\n203|\t}\n204|\treturn map[string]any{\n205|\t\t\"kind\":                               \"ax_session\",\n206|\t\t\"source_session_id\":                  digestOrEmpty(basis.SourceSessionID),\n207|\t\t\"source_session_record_id\":           digestOrEmptyDigest(basis.SourceSessionRecordID),\n208|\t\t\"source_checkpoint_id\":               digestOrEmptyDigest(basis.SourceCheckpointID),\n209|\t\t\"source_provider_identity_record_id\": digestOrEmptyDigest(basis.SourceProviderIdentityID),\n210|\t\t\"extensions\":                         map[string]any{},\n211|\t}\n212|}\n213|\n214|func digestOrEmpty(id *scalar.UUIDv7) string {\n215|\tif id == nil {\n216|\t\treturn \"\"\n217|\t}\n218|\treturn id.String()\n219|}\n220|\n221|func digestOrEmptyDigest(id *scalar.Digest) string {\n222|\tif id == nil {\n223|\t\treturn \"\"\n224|\t}\n225|\treturn id.String()\n226|}\n227|\n228|// StableSnapshotProof is one validated stable snapshot proof.\n229|type StableSnapshotProof struct {\n230|\tProofKind         string\n231|\tSourceGeneration  Generation\n232|\tSnapshotIdentity  *scalar.Digest\n233|\tPreCaptureDigest  scalar.Digest\n234|\tPostCaptureDigest scalar.Digest\n235|\tInputBlocked      bool\n236|\tForegroundIdle    bool\n237|\tBackgroundIdle    bool\n238|}\n239|\n240|var proofKinds = []string{\n241|\t\"closed_store\",\n242|\t\"immutable_snapshot\",\n243|\t\"verified_log_prefix\",\n244|\t\"provider_quiescence\",\n245|}\n246|\n247|func validProofKind(kind string) bool {\n248|\tfor _, allowed := range proofKinds {\n249|\t\tif kind == allowed {\n250|\t\t\treturn true\n251|\t\t}\n252|\t}\n253|\treturn false\n254|}\n255|\n256|var stableProofMembers = map[string]bool{\n257|\t\"proof_kind\": true, \"source_generation\": true, \"snapshot_identity_digest\": true,\n258|\t\"pre_capture_digest\": true, \"post_capture_digest\": true,\n259|\t\"input_blocked\": true, \"foreground_idle\": true, \"background_idle\": true, \"extensions\": true,\n260|}\n261|\n262|var stableProofRequired = []string{\n263|\t\"proof_kind\", \"source_generation\", \"snapshot_identity_digest\",\n264|\t\"pre_capture_digest\", \"post_capture_digest\",\n265|\t\"input_blocked\", \"foreground_idle\", \"background_idle\", \"extensions\",\n266|}\n267|\n268|// DecodeStableSnapshotProof validates one closed StableSnapshotProof:\n269|// equal capture digests, the proof-kind/identity/boolean coupling,\n270|// and the immutable generation token.\n271|func DecodeStableSnapshotProof(raw json.RawMessage) (StableSnapshotProof, error) {\n272|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n273|\tif fault != nil {\n274|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof %s (%s)\", fault.detail, memberField(fault.member))\n275|\t}\n276|\tif name, unknown := unknownMember(members, stableProofMembers); unknown {\n277|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof carries unknown member %q\", name)\n278|\t}\n279|\tif name, missing := missingMember(members, stableProofRequired); missing {\n280|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof misses a required member %q\", name)\n281|\t}\n282|\tkind, ok := rawString(members[\"proof_kind\"])\n283|\tif !ok || !validProofKind(kind) {\n284|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof kind is outside the closed proof vocabulary\")\n285|\t}\n286|\tgeneration, ok := checkGeneration(members[\"source_generation\"])\n287|\tif !ok {\n288|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof source_generation is not a string[1..512]\")\n289|\t}\n290|\tvar identity *scalar.Digest\n291|\tif !isNull(members[\"snapshot_identity_digest\"]) {\n292|\t\tvalue, ok := checkDigest(members[\"snapshot_identity_digest\"])\n293|\t\tif !ok {\n294|\t\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof snapshot_identity_digest is not a digest\")\n295|\t\t}\n296|\t\tidentity = &value\n297|\t}\n298|\tpre, ok := checkDigest(members[\"pre_capture_digest\"])\n299|\tif !ok {\n300|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof pre_capture_digest is not a digest\")\n301|\t}\n302|\tpost, ok := checkDigest(members[\"post_capture_digest\"])\n303|\tif !ok {\n304|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof post_capture_digest is not a digest\")\n305|\t}\n306|\tinputBlocked, ok := rawBool(members[\"input_blocked\"])\n307|\tif !ok {\n308|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof input_blocked is not a boolean\")\n309|\t}\n310|\tforegroundIdle, ok := rawBool(members[\"foreground_idle\"])\n311|\tif !ok {\n312|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof foreground_idle is not a boolean\")\n313|\t}\n314|\tbackgroundIdle, ok := rawBool(members[\"background_idle\"])\n315|\tif !ok {\n316|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof background_idle is not a boolean\")\n317|\t}\n318|\tproof := StableSnapshotProof{\n319|\t\tProofKind:         kind,\n320|\t\tSourceGeneration:  generation,\n321|\t\tSnapshotIdentity:  identity,\n322|\t\tPreCaptureDigest:  pre,\n323|\t\tPostCaptureDigest: post,\n324|\t\tInputBlocked:      inputBlocked,\n325|\t\tForegroundIdle:    foregroundIdle,\n326|\t\tBackgroundIdle:    backgroundIdle,\n327|\t}\n328|\tif err := checkProofCoupling(proof); err != nil {\n329|\t\treturn StableSnapshotProof{}, err\n330|\t}\n331|\tif !checkExtensions(members[\"extensions\"]) {\n332|\t\treturn StableSnapshotProof{}, invalid(\"stable snapshot proof extensions are not reverse-DNS keyed\")\n333|\t}\n334|\treturn proof, nil\n335|}\n336|\n337|// checkProofCoupling enforces the proof-kind/identity/boolean\n338|// coupling: capture digests are equal (size equality is never\n339|// proof and is not consulted); closed-store and\n340|// provider-quiescence require all booleans true and null snapshot\n341|// identity; immutable-snapshot and log-prefix require non-null\n342|// identity.\n343|func checkProofCoupling(proof StableSnapshotProof) error {\n344|\tif err := CheckDigestsEqual(proof.PreCaptureDigest, proof.PostCaptureDigest); err != nil {\n345|\t\treturn invalid(\"stable snapshot proof: %v\", err)\n346|\t}\n347|\tswitch proof.ProofKind {\n348|\tcase \"closed_store\", \"provider_quiescence\":\n349|\t\tif proof.SnapshotIdentity != nil {\n350|\t\t\treturn invalid(\"stable snapshot proof %s requires null snapshot identity\", proof.ProofKind)\n351|\t\t}\n352|\t\tif !proof.InputBlocked || !proof.ForegroundIdle || !proof.BackgroundIdle {\n353|\t\t\treturn invalid(\"stable snapshot proof %s requires input_blocked, foreground_idle, and background_idle\", proof.ProofKind)\n354|\t\t}\n355|\tcase \"immutable_snapshot\", \"verified_log_prefix\":\n356|\t\tif proof.SnapshotIdentity == nil {\n357|\t\t\treturn invalid(\"stable snapshot proof %s requires non-null snapshot identity\", proof.ProofKind)\n358|\t\t}\n359|\t}\n360|\treturn nil\n361|}\n362|\n363|// CaptureBoundary is one validated Capture Boundary.\n364|type CaptureBoundary struct {\n365|\tKind              string\n366|\tProof             *StableSnapshotProof\n367|\tSourceGeneration  *Generation\n368|\tPreCaptureDigest  *scalar.Digest\n369|\tPostCaptureDigest *scalar.Digest\n370|}\n371|\n372|// Stable reports whether the boundary is the stable form.\n373|func (boundary CaptureBoundary) Stable() bool { return boundary.Kind == \"stable\" }\n374|\n375|var stableBoundaryMembers = map[string]bool{\n376|\t\"kind\": true, \"proof\": true, \"extensions\": true,\n377|}\n378|\n379|var stableBoundaryRequired = []string{\"kind\", \"proof\", \"extensions\"}\n380|\n381|var unstableBoundaryMembers = map[string]bool{\n382|\t\"kind\": true, \"source_generation\": true, \"pre_capture_digest\": true,\n383|\t\"post_capture_digest\": true, \"reason_code\": true,\n384|\t\"operator_explicit\": true, \"target_projection_forbidden\": true, \"extensions\": true,\n385|}\n386|\n387|var unstableBoundaryRequired = []string{\n388|\t\"kind\", \"source_generation\", \"pre_capture_digest\",\n389|\t\"post_capture_digest\", \"reason_code\",\n390|\t\"operator_explicit\", \"target_projection_forbidden\", \"extensions\",\n391|}\n392|\n393|// DecodeCaptureBoundary validates one closed Capture Boundary.\n394|func DecodeCaptureBoundary(raw json.RawMessage) (CaptureBoundary, error) {\n395|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n396|\tif fault != nil {\n397|\t\treturn CaptureBoundary{}, invalid(\"capture boundary %s (%s)\", fault.detail, memberField(fault.member))\n398|\t}\n399|\tkindValue, present := members[\"kind\"]\n400|\tif !present {\n401|\t\treturn CaptureBoundary{}, invalid(\"capture boundary misses a required member %q\", \"kind\")\n402|\t}\n403|\tkind, ok := rawString(kindValue)\n404|\tif !ok {\n405|\t\treturn CaptureBoundary{}, invalid(\"capture boundary kind is not a string\")\n406|\t}\n407|\tswitch kind {\n408|\tcase \"stable\":\n409|\t\treturn decodeStableBoundary(members)\n410|\tcase \"unstable_archive\":\n411|\t\treturn decodeUnstableBoundary(members)\n412|\tdefault:\n413|\t\treturn CaptureBoundary{}, invalid(\"capture boundary kind is outside stable|unstable_archive\")\n414|\t}\n415|}\n416|\n417|func decodeStableBoundary(members map[string]json.RawMessage) (CaptureBoundary, error) {\n418|\tif name, unknown := unknownMember(members, stableBoundaryMembers); unknown {\n419|\t\treturn CaptureBoundary{}, invalid(\"capture boundary carries unknown member %q\", name)\n420|\t}\n421|\tif name, missing := missingMember(members, stableBoundaryRequired); missing {\n422|\t\treturn CaptureBoundary{}, invalid(\"capture boundary misses a required member %q\", name)\n423|\t}\n424|\tproof, err := DecodeStableSnapshotProof(members[\"proof\"])\n425|\tif err != nil {\n426|\t\treturn CaptureBoundary{}, err\n427|\t}\n428|\tif !checkExtensions(members[\"extensions\"]) {\n429|\t\treturn CaptureBoundary{}, invalid(\"capture boundary extensions are not reverse-DNS keyed\")\n430|\t}\n431|\treturn CaptureBoundary{Kind: \"stable\", Proof: &proof}, nil\n432|}\n433|\n434|func decodeUnstableBoundary(members map[string]json.RawMessage) (CaptureBoundary, error) {\n435|\tif name, unknown := unknownMember(members, unstableBoundaryMembers); unknown {\n436|\t\treturn CaptureBoundary{}, invalid(\"capture boundary carries unknown member %q\", name)\n437|\t}\n438|\tif name, missing := missingMember(members, unstableBoundaryRequired); missing {\n439|\t\treturn CaptureBoundary{}, invalid(\"capture boundary misses a required member %q\", name)\n440|\t}\n441|\tgeneration, ok := checkGeneration(members[\"source_generation\"])\n442|\tif !ok {\n443|\t\treturn CaptureBoundary{}, invalid(\"capture boundary source_generation is not a string[1..512]\")\n444|\t}\n445|\tpre, ok := checkDigest(members[\"pre_capture_digest\"])\n446|\tif !ok {\n447|\t\treturn CaptureBoundary{}, invalid(\"capture boundary pre_capture_digest is not a digest\")\n448|\t}\n449|\tpost, ok := checkDigest(members[\"post_capture_digest\"])\n450|\tif !ok {\n451|\t\treturn CaptureBoundary{}, invalid(\"capture boundary post_capture_digest is not a digest\")\n452|\t}\n453|\treason, ok := rawString(members[\"reason_code\"])\n454|\tif !ok || reason != \"source_not_quiescent\" {\n455|\t\treturn CaptureBoundary{}, invalid(\"capture boundary reason_code is not source_not_quiescent\")\n456|\t}\n457|\texplicit, ok := rawBool(members[\"operator_explicit\"])\n458|\tif !ok || !explicit {\n459|\t\treturn CaptureBoundary{}, invalid(\"capture boundary operator_explicit is not true\")\n460|\t}\n461|\tforbidden, ok := rawBool(members[\"target_projection_forbidden\"])\n462|\tif !ok || !forbidden {\n463|\t\treturn CaptureBoundary{}, invalid(\"capture boundary target_projection_forbidden is not true\")\n464|\t}\n465|\tif !checkExtensions(members[\"extensions\"]) {\n466|\t\treturn CaptureBoundary{}, invalid(\"capture boundary extensions are not reverse-DNS keyed\")\n467|\t}\n468|\treturn CaptureBoundary{\n469|\t\tKind:              \"unstable_archive\",\n470|\t\tSourceGeneration:  &generation,\n471|\t\tPreCaptureDigest:  &pre,\n472|\t\tPostCaptureDigest: &post,\n473|\t}, nil\n474|}\n475|\n476|// RefuseUnstableForTarget is the G2 target-branch gate: the unstable\n477|// archive form is core-created archive-only output and can never\n478|// enter a target branch, so target admission refuses it.\n479|func RefuseUnstableForTarget(boundary CaptureBoundary) error {\n480|\tif boundary.Kind == \"unstable_archive\" {\n481|\t\treturn invalid(\"capture boundary unstable_archive cannot enter a target branch\")\n482|\t}\n483|\tif boundary.Kind != \"stable\" {\n484|\t\treturn invalid(\"capture boundary kind is outside stable|unstable_archive\")\n485|\t}\n486|\treturn nil\n487|}\n488|\n489|// BoundaryInput is one caller-supplied capture boundary candidate\n490|// for Build. Core must be true to construct the unstable archive\n491|// form; only core may construct it.\n492|type BoundaryInput struct {\n493|\tKind              string\n494|\tProofKind         string\n495|\tGeneration        string\n496|\tSnapshotIdentity  *string\n497|\tPreCaptureDigest  string\n498|\tPostCaptureDigest string\n499|\tInputBlocked      bool\n500|\tForegroundIdle    bool\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
