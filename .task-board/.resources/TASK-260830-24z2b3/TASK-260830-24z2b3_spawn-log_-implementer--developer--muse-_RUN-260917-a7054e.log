{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb21","stream":{"kind":"session","id":"01a0b0cc-369a-7993-946b-ef774181fd54"},"sequence":1003,"recorded_at":1780531400002001,"record_type":"event","durability":"durable","causation_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","run_stream":{"kind":"run","id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3"},"task_stream":{"kind":"task","id":"01a0b0cf-65e1-7c50-8b5c-2767404a3cf5"},"task_id":"01a0b0cf-65e1-7c50-8b5c-2767404a3cf5","event":{"kind":"output","task_id":"01a0b0cf-65e1-7c50-8b5c-2767404a3cf5","chunk":"Read text file `/tmp/rev2/zz_review_probe2_test.go.txt`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|\t\"unicode/utf8\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n10|)\n11|\n12|func verdict2(label string, err error) {\n13|\tif err == nil {\n14|\t\tfmt.Printf(\"PROBE %-62s ADMITTED\\n\", label)\n15|\t\treturn\n16|\t}\n17|\tfmt.Printf(\"PROBE %-62s REFUSED: %v\\n\", label, err)\n18|}\n19|\n20|// String-measure probe: SPEC.v0.6.0.md:337 says string[n..m] bounds UTF-8\n21|// characters; the landed environ.StringLength counts runes. clonebundle\n22|// counts bytes. Witness: 300 two-byte characters = 300 chars / 600 bytes.\n23|func TestReviewStringMeasure(t *testing.T) {\n24|\tkey := strings.Repeat(\"é\", 300)\n25|\tfmt.Printf(\"PROBE S0 witness: chars=%d bytes=%d environ.StringLength=%d clonebundle.stringLength=%d\\n\",\n26|\t\tutf8.RuneCountInString(key), len(key), environ.StringLength(key), stringLength(key))\n27|\tidentity := fixtureNativeIdentity()\n28|\tidentityDigest, _ := IdentityDigest(identity, nil)\n29|\tinputs := validEntryInputs(t)\n30|\tinputs[0].NativeItemKey = key\n31|\tif inputs[0].NativeItemKey > inputs[1].NativeItemKey {\n32|\t\tinputs[0], inputs[1] = inputs[1], inputs[0]\n33|\t}\n34|\t_, err := BuildRawObjectManifest(fixtureOperationID, []byte(fixtureTupleJSON()), \"native-session-alpha\",\n35|\t\tidentityDigest.String(), fixtureDigest(\"test-capture-plan\"), inputs, nil)\n36|\tverdict2(\"S1 Build raw entry key = 300 chars / 600 bytes (spec admits)\", err)\n37|\ts := validSessionInput()\n38|\ts.Title = strptr(strings.Repeat(\"é\", 3000))\n39|\t_, err = BuildCanonicalSession(s)\n40|\tverdict2(\"S2 Build session title = 3000 chars / 6000 bytes (spec admits)\", err)\n41|\tvalid := mustSessionBytes(t)\n42|\ttampered := tamper(t, valid, func(o map[string]any) { o[\"title\"] = strings.Repeat(\"é\", 3000) })\n43|\t_, err = DecodeCanonicalSession(tampered)\n44|\tverdict2(\"S3 Decode session title = 3000 chars (unsealed; which gate fires?)\", err)\n45|\t_, ok := environ.CheckStringBounds([]byte(`\"`+key+`\"`), 1, 512)\n46|\t_, ok2 := checkStringBounds([]byte(`\"`+key+`\"`), 1, 512)\n47|\tfmt.Printf(\"PROBE S4 environ.CheckStringBounds(300 chars, 1..512) admits=%v; clonebundle checkStringBounds admits=%v\\n\", ok, ok2)\n48|}","final_result":true}}}
