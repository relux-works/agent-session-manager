{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6b3","stream":{"kind":"session","id":"01a0b0cc-369a-7993-946b-ef774181fd54"},"sequence":436,"recorded_at":1780531400000867,"record_type":"event","durability":"durable","causation_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","run_stream":{"kind":"run","id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3"},"task_stream":{"kind":"task","id":"01a0b0cd-260c-7571-80cd-c13c08574df4"},"task_id":"01a0b0cd-260c-7571-80cd-c13c08574df4","event":{"kind":"output","task_id":"01a0b0cd-260c-7571-80cd-c13c08574df4","chunk":"Read text file `internal/clonebundle/captureitem.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n7|)\n8|\n9|// This file validates the CaptureItem, Capture Source Basis, and\n10|// Capture Boundary closed shapes of Clone Capture Manifest 1.0.0.\n11|// The manifest envelope itself lives in capturebuild.go.\n12|\n13|// captureClasses is the closed nine-class vocabulary Section 13.14.1\n14|// states for CaptureItem. It mirrors the sessadapter capture-plan\n15|// vocabulary over the same pinned section; membership here is the\n16|// manifest-side gate.\n17|var captureClasses = []string{\n18|\t\"durable_payload\",\n19|\t\"durable_index_required\",\n20|\t\"durable_sidecar\",\n21|\t\"derived_cache_optional\",\n22|\t\"credential\",\n23|\t\"machine_auth\",\n24|\t\"runtime_state\",\n25|\t\"transient_lock\",\n26|\t\"unknown\",\n27|}\n28|\n29|// ValidCaptureClass reports whether the name is a capture class.\n30|func ValidCaptureClass(name string) bool {\n31|\tfor _, class := range captureClasses {\n32|\t\tif class == name {\n33|\t\t\treturn true\n34|\t\t}\n35|\t}\n36|\treturn false\n37|}\n38|\n39|// alwaysExcludedClass reports whether the class is always excluded:\n40|// credential, auth, runtime, and lock classes are never included.\n41|func alwaysExcludedClass(class string) bool {\n42|\tswitch class {\n43|\tcase \"credential\", \"machine_auth\", \"runtime_state\", \"transient_lock\":\n44|\t\treturn true\n45|\tdefault:\n46|\t\treturn false\n47|\t}\n48|}\n49|\n50|var captureItemMembers = map[string]bool{\n51|\t\"native_item_key\":    true,\n52|\t\"class\":              true,\n53|\t\"disposition\":        true,\n54|\t\"blob_descriptor_id\": true,\n55|\t\"byte_count\":         true,\n56|\t\"exclusion_reason\":   true,\n57|\t\"extensions\":         true,\n58|}\n59|\n60|var captureItemRequired = []string{\n61|\t\"native_item_key\",\n62|\t\"class\",\n63|\t\"disposition\",\n64|\t\"blob_descriptor_id\",\n65|\t\"byte_count\",\n66|\t\"exclusion_reason\",\n67|\t\"extensions\",\n68|}\n69|\n70|// CaptureItem is one validated capture item.\n71|type CaptureItem struct {\n72|\tNativeItemKey    string\n73|\tClass            string\n74|\tDisposition      string\n75|\tBlobDescriptorID *scalar.Digest\n76|\tByteCount        *uint64\n77|\tExclusionReason  *string\n78|\tExtensions       map[string]any\n79|}\n80|\n81|// Included reports whether the item is an included row.\n82|func (item CaptureItem) Included() bool { return item.Disposition == \"included\" }\n83|\n84|// decodeCaptureItem validates one closed CaptureItem: the\n85|// included/excluded content rule, the always-excluded classes, and\n86|// the row-21 exclusion allowlist on the native key.\n87|func decodeCaptureItem(raw json.RawMessage, index int) (CaptureItem, error) {\n88|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n89|\tif fault != nil {\n90|\t\treturn CaptureItem{}, invalid(\"capture item[%d] %s (%s)\", index, fault.detail, memberField(fault.member))\n91|\t}\n92|\tif name, unknown := unknownMember(members, captureItemMembers); unknown {\n93|\t\treturn CaptureItem{}, invalid(\"capture item[%d] carries unknown member %q\", index, name)\n94|\t}\n95|\tif name, missing := missingMember(members, captureItemRequired); missing {\n96|\t\treturn CaptureItem{}, invalid(\"capture item[%d] misses a required member %q\", index, name)\n97|\t}\n98|\tkey, ok := checkStringBounds(members[\"native_item_key\"], 1, 512)\n99|\tif !ok {\n100|\t\treturn CaptureItem{}, invalid(\"capture item[%d] native_item_key is not a string[1..512]\", index)\n101|\t}\n102|\tif err := SanitizeNativeKey(key); err != nil {\n103|\t\treturn CaptureItem{}, err\n104|\t}\n105|\tif err := refuseExcludedMember(\"capture item\", key, index); err != nil {\n106|\t\treturn CaptureItem{}, err\n107|\t}\n108|\tclass, ok := rawString(members[\"class\"])\n109|\tif !ok || !ValidCaptureClass(class) {\n110|\t\treturn CaptureItem{}, invalid(\"capture item[%d] class %q is outside the nine-class vocabulary\", index, class)\n111|\t}\n112|\tdisposition, ok := rawString(members[\"disposition\"])\n113|\tif !ok || (disposition != \"included\" && disposition != \"excluded\") {\n114|\t\treturn CaptureItem{}, invalid(\"capture item[%d] disposition is outside included|excluded\", index)\n115|\t}\n116|\tvar descriptor *scalar.Digest\n117|\tif !isNull(members[\"blob_descriptor_id\"]) {\n118|\t\tvalue, ok := checkDigest(members[\"blob_descriptor_id\"])\n119|\t\tif !ok {\n120|\t\t\treturn CaptureItem{}, invalid(\"capture item[%d] blob_descriptor_id is not a digest\", index)\n121|\t\t}\n122|\t\tdescriptor = &value\n123|\t}\n124|\tvar count *uint64\n125|\tif !isNull(members[\"byte_count\"]) {\n126|\t\tvalue, ok := rawUint53(members[\"byte_count\"])\n127|\t\tif !ok {\n128|\t\t\treturn CaptureItem{}, invalid(\"capture item[%d] byte_count is not a uint53\", index)\n129|\t\t}\n130|\t\tcount = &value\n131|\t}\n132|\tvar reason *string\n133|\tif !isNull(members[\"exclusion_reason\"]) {\n134|\t\tvalue, ok := checkStringBounds(members[\"exclusion_reason\"], 1, 128)\n135|\t\tif !ok {\n136|\t\t\treturn CaptureItem{}, invalid(\"capture item[%d] exclusion_reason is not a string[1..128]\", index)\n137|\t\t}\n138|\t\treason = &value\n139|\t}\n140|\tif err := checkItemDisposition(index, class, disposition, descriptor != nil, count != nil, reason != nil); err != nil {\n141|\t\treturn CaptureItem{}, err\n142|\t}\n143|\tif !checkExtensions(members[\"extensions\"]) {\n144|\t\treturn CaptureItem{}, invalid(\"capture item[%d] extensions are not reverse-DNS keyed\", index)\n145|\t}\n146|\tvar decodedExtensions map[string]any\n147|\tif err := json.Unmarshal(bytesTrimSpace(members[\"extensions\"]), &decodedExtensions); err != nil {\n148|\t\treturn CaptureItem{}, invalid(\"capture item[%d] extensions are not an object\", index)\n149|\t}\n150|\tif decodedExtensions == nil {\n151|\t\tdecodedExtensions = map[string]any{}\n152|\t}\n153|\treturn CaptureItem{\n154|\t\tNativeItemKey:    key,\n155|\t\tClass:            class,\n156|\t\tDisposition:      disposition,\n157|\t\tBlobDescriptorID: descriptor,\n158|\t\tByteCount:        count,\n159|\t\tExclusionReason:  reason,\n160|\t\tExtensions:       decodedExtensions,\n161|\t}, nil\n162|}\n163|\n164|// checkItemDisposition enforces the included/excluded rule: included\n165|// requires both content members non-null and a null reason; excluded\n166|// requires null content members and a non-null reason; the four\n167|// always-excluded classes are never included.\n168|func checkItemDisposition(index int, class, disposition string, hasDescriptor, hasCount, hasReason bool) error {\n169|\tif disposition == \"included\" {\n170|\t\tif alwaysExcludedClass(class) {\n171|\t\t\treturn invalid(\"capture item[%d] class %q is always excluded, never included\", index, class)\n172|\t\t}\n173|\t\tif !hasDescriptor || !hasCount {\n174|\t\t\treturn invalid(\"capture item[%d] included requires non-null descriptor and byte count\", index)\n175|\t\t}\n176|\t\tif hasReason {\n177|\t\t\treturn invalid(\"capture item[%d] included carries an exclusion reason\", index)\n178|\t\t}\n179|\t\treturn nil\n180|\t}\n181|\tif hasDescriptor || hasCount {\n182|\t\treturn invalid(\"capture item[%d] excluded carries content members\", index)\n183|\t}\n184|\tif !hasReason {\n185|\t\treturn invalid(\"capture item[%d] excluded requires a non-null exclusion reason\", index)\n186|\t}\n187|\treturn nil\n188|}\n189|\n190|// CaptureItemInput is one caller-supplied capture item candidate for\n191|// Build. Null members are nil pointers: BlobDescriptorID and\n192|// ByteCount for excluded rows, ExclusionReason for included rows.\n193|type CaptureItemInput struct {\n194|\tNativeItemKey    string\n195|\tClass            string\n196|\tDisposition      string\n197|\tBlobDescriptorID *string\n198|\tByteCount        *uint64\n199|\tExclusionReason  *string\n200|\tExtensions       map[string]any\n201|}\n202|\n203|func buildCaptureItem(input CaptureItemInput, index int) (CaptureItem, error) {\n204|\tif len(input.NativeItemKey) < 1 || len(input.NativeItemKey) > 512 {\n205|\t\treturn CaptureItem{}, invalid(\"capture item[%d] native_item_key is not a string[1..512]\", index)\n206|\t}\n207|\tif err := SanitizeNativeKey(input.NativeItemKey); err != nil {\n208|\t\treturn CaptureItem{}, err\n209|\t}\n210|\tif err := refuseExcludedMember(\"capture item\", input.NativeItemKey, index); err != nil {\n211|\t\treturn CaptureItem{}, err\n212|\t}\n213|\tif !ValidCaptureClass(input.Class) {\n214|\t\treturn CaptureItem{}, invalid(\"capture item[%d] class %q is outside the nine-class vocabulary\", index, input.Class)\n215|\t}\n216|\tif input.Disposition != \"included\" && input.Disposition != \"excluded\" {\n217|\t\treturn CaptureItem{}, invalid(\"capture item[%d] disposition is outside included|excluded\", index)\n218|\t}\n219|\tvar descriptor *scalar.Digest\n220|\tif input.BlobDescriptorID != nil {\n221|\t\tvalue, err := scalar.ParseDigest(*input.BlobDescriptorID)\n222|\t\tif err != nil {\n223|\t\t\treturn CaptureItem{}, invalid(\"capture item[%d] blob_descriptor_id is not a digest: %v\", index, err)\n224|\t\t}\n225|\t\tdescriptor = &value\n226|\t}\n227|\tvar count *uint64\n228|\tif input.ByteCount != nil {\n229|\t\tif *input.ByteCount > maxUint53 {\n230|\t\t\treturn CaptureItem{}, invalid(\"capture item[%d] byte_count exceeds uint53\", index)\n231|\t\t}\n232|\t\tkept := *input.ByteCount\n233|\t\tcount = &kept\n234|\t}\n235|\tvar reason *string\n236|\tif input.ExclusionReason != nil {\n237|\t\tif len(*input.ExclusionReason) < 1 || len(*input.ExclusionReason) > 128 {\n238|\t\t\treturn CaptureItem{}, invalid(\"capture item[%d] exclusion_reason is not a string[1..128]\", index)\n239|\t\t}\n240|\t\tkept := *input.ExclusionReason\n241|\t\treason = &kept\n242|\t}\n243|\tif err := checkItemDisposition(index, input.Class, input.Disposition, descriptor != nil, count != nil, reason != nil); err != nil {\n244|\t\treturn CaptureItem{}, err\n245|\t}\n246|\tif _, err := encodeExtensions(input.Extensions); err != nil {\n247|\t\treturn CaptureItem{}, invalid(\"capture item[%d]: %v\", index, err)\n248|\t}\n249|\treturn CaptureItem{\n250|\t\tNativeItemKey:    input.NativeItemKey,\n251|\t\tClass:            input.Class,\n252|\t\tDisposition:      input.Disposition,\n253|\t\tBlobDescriptorID: descriptor,\n254|\t\tByteCount:        count,\n255|\t\tExclusionReason:  reason,\n256|\t\tExtensions:       extensionValue(input.Extensions),\n257|\t}, nil\n258|}\n259|\n260|func captureItemObject(item CaptureItem) map[string]any {\n261|\tvar descriptor any\n262|\tif item.BlobDescriptorID != nil {\n263|\t\tdescriptor = item.BlobDescriptorID.String()\n264|\t}\n265|\tvar count any\n266|\tif item.ByteCount != nil {\n267|\t\tcount = *item.ByteCount\n268|\t}\n269|\tvar reason any\n270|\tif item.ExclusionReason != nil {\n271|\t\treason = *item.ExclusionReason\n272|\t}\n273|\treturn map[string]any{\n274|\t\t\"native_item_key\":    item.NativeItemKey,\n275|\t\t\"class\":              item.Class,\n276|\t\t\"disposition\":        item.Disposition,\n277|\t\t\"blob_descriptor_id\": descriptor,\n278|\t\t\"byte_count\":         count,\n279|\t\t\"exclusion_reason\":   reason,\n280|\t\t\"extensions\":         extensionValue(item.Extensions),\n281|\t}\n282|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6b5","stream":{"kind":"session","id":"01a0b0cc-369a-7993-946b-ef774181fd54"},"sequence":437,"recorded_at":1780531400000869,"record_type":"event","durability":"durable","causation_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","run_stream":{"kind":"run","id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3"},"task_stream":{"kind":"task","id":"01a0b0cd-260c-7571-80cd-c13c08574df4"},"task_id":"01a0b0cd-260c-7571-80cd-c13c08574df4","event":{"kind":"completed","task_id":"01a0b0cd-260c-7571-80cd-c13c08574df4"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6b7","stream":{"kind":"session","id":"01a0b0cc-369a-7993-946b-ef774181fd54"},"sequence":438,"recorded_at":1780531400000871,"record_type":"event","durability":"durable","causation_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","run_stream":{"kind":"run","id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3"},"task_stream":{"kind":"task","id":"01a0b0cd-25f1-74f3-801b-13f50d71b574"},"task_id":"01a0b0cd-25f1-74f3-801b-13f50d71b574","event":{"kind":"output","task_id":"01a0b0cd-25f1-74f3-801b-13f50d71b574","chunk":"Read text file `internal/clonebundle/capturebuild.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"sort\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n9|)\n10|\n11|// This file validates and constructs Clone Capture Manifest 1.0.0:\n12|// the closed envelope over source basis, capture boundary, sorted\n13|// Capture Items, exact excluded classes, and the core-derived\n14|// raw_complete flag.\n15|\n16|const (\n17|\tcaptureManifestSchema  = \"urn:ax:schema:clone-capture-manifest\"\n18|\tcaptureManifestVersion = \"1.0.0\"\n19|\tcaptureManifestSelf    = \"capture_manifest_id\"\n20|)\n21|\n22|var captureManifestMembers = map[string]bool{\n23|\t\"schema\": true, \"schema_version\": true, \"capture_manifest_id\": true,\n24|\t\"operation_id\": true, \"bundle_id\": true, \"source_basis\": true,\n25|\t\"source_environment\": true, \"source_identity\": true,\n26|\t\"capture_plan_digest\": true, \"capture_boundary\": true,\n27|\t\"source_raw_object_manifest_id\": true, \"items\": true,\n28|\t\"excluded_classes\": true, \"raw_complete\": true,\n29|\t\"created_by_host_id\": true, \"created_at\": true, \"extensions\": true,\n30|}\n31|\n32|var captureManifestRequired = []string{\n33|\t\"schema\", \"schema_version\", \"capture_manifest_id\",\n34|\t\"operation_id\", \"bundle_id\", \"source_basis\",\n35|\t\"source_environment\", \"source_identity\",\n36|\t\"capture_plan_digest\", \"capture_boundary\",\n37|\t\"source_raw_object_manifest_id\", \"items\",\n38|\t\"excluded_classes\", \"raw_complete\",\n39|\t\"created_by_host_id\", \"created_at\", \"extensions\",\n40|}\n41|\n42|// CaptureManifest is one validated Clone Capture Manifest.\n43|type CaptureManifest struct {\n44|\tManifestID              scalar.Digest\n45|\tOperationID             scalar.UUIDv7\n46|\tBundleID                scalar.UUIDv7\n47|\tSourceBasis             SourceBasis\n48|\tSourceEnvironment       sessadapter.Tuple\n49|\tSourceIdentity          NativeIdentity\n50|\tCapturePlanDigest       scalar.Digest\n51|\tCaptureBoundary         CaptureBoundary\n52|\tSourceRawObjectManifest scalar.Digest\n53|\tItems                   []CaptureItem\n54|\tExcludedClasses         []string\n55|\tRawComplete             bool\n56|\tCreatedByHostID         scalar.UUIDv7\n57|\tCreatedAt               scalar.Timestamp\n58|}\n59|\n60|// CaptureManifestInput is the caller-supplied capture manifest\n61|// candidate for Build. PlanKeys are the exact capture-plan\n62|// candidate keys and RawKeys are the exact raw-manifest entry keys;\n63|// raw_complete is core-derived from them and is not an input — a\n64|// caller cannot assert completeness, only the reconciliation can.\n65|type CaptureManifestInput struct {\n66|\tOperationID         string\n67|\tBundleID            string\n68|\tSourceBasis         SourceBasisInput\n69|\tSourceEnvironment   []byte\n70|\tSourceIdentity      NativeIdentity\n71|\tIdentityExtensions  map[string]any\n72|\tCapturePlanDigest   string\n73|\tBoundary            BoundaryInput\n74|\tSourceRawManifestID string\n75|\tItems               []CaptureItemInput\n76|\tPlanKeys            []string\n77|\tRawKeys             []string\n78|\tCreatedByHostID     string\n79|\tCreatedAt           string\n80|\tExtensions          map[string]any\n81|}\n82|\n83|// BuildCaptureManifest constructs one closed Clone Capture Manifest\n84|// as canonical bytes. Identical inputs produce byte-identical\n85|// outputs. raw_complete is derived, never accepted: it is true only\n86|// after complete plan/object reconciliation with no unknown class.\n87|func BuildCaptureManifest(input CaptureManifestInput) ([]byte, error) {\n88|\tmanifest, object, err := buildCaptureManifest(input)\n89|\tif err != nil {\n90|\t\treturn nil, err\n91|\t}\n92|\t_ = manifest\n93|\tomitted, err := canonicalizeObject(object)\n94|\tif err != nil {\n95|\t\treturn nil, err\n96|\t}\n97|\tmanifestID := scalar.SHA256Digest(omitted)\n98|\tobject[captureManifestSelf] = manifestID.String()\n99|\treturn canonicalizeObject(object)\n100|}\n101|\n102|func buildCaptureManifest(input CaptureManifestInput) (CaptureManifest, map[string]any, error) {\n103|\toperation, err := scalar.ParseUUIDv7(input.OperationID)\n104|\tif err != nil {\n105|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest operation_id is not a UUIDv7: %v\", err)\n106|\t}\n107|\tbundle, err := scalar.ParseUUIDv7(input.BundleID)\n108|\tif err != nil {\n109|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest bundle_id is not a UUIDv7: %v\", err)\n110|\t}\n111|\tbasis, basisObject, err := buildSourceBasis(input.SourceBasis)\n112|\tif err != nil {\n113|\t\treturn CaptureManifest{}, nil, err\n114|\t}\n115|\ttuple, err := sessadapter.DecodeTuple(json.RawMessage(input.SourceEnvironment))\n116|\tif err != nil {\n117|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest source_environment is not an Environment Tuple: %v\", err)\n118|\t}\n119|\tidentityBytes, err := EncodeNativeIdentity(input.SourceIdentity, input.IdentityExtensions)\n120|\tif err != nil {\n121|\t\treturn CaptureManifest{}, nil, err\n122|\t}\n123|\tif _, err := DecodeNativeIdentity(json.RawMessage(identityBytes)); err != nil {\n124|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest source_identity is not a NativeIdentity: %v\", err)\n125|\t}\n126|\tplanDigest, err := scalar.ParseDigest(input.CapturePlanDigest)\n127|\tif err != nil {\n128|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest capture_plan_digest is not a digest: %v\", err)\n129|\t}\n130|\tboundary, boundaryObject, err := buildBoundary(input.Boundary)\n131|\tif err != nil {\n132|\t\treturn CaptureManifest{}, nil, err\n133|\t}\n134|\trawManifestID, err := scalar.ParseDigest(input.SourceRawManifestID)\n135|\tif err != nil {\n136|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest source_raw_object_manifest_id is not a digest: %v\", err)\n137|\t}\n138|\tif len(input.Items) > 65536 {\n139|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest carries %d items, maximum is 65536\", len(input.Items))\n140|\t}\n141|\titems := make([]CaptureItem, 0, len(input.Items))\n142|\tprevious := \"\"\n143|\tfor index, candidate := range input.Items {\n144|\t\titem, err := buildCaptureItem(candidate, index)\n145|\t\tif err != nil {\n146|\t\t\treturn CaptureManifest{}, nil, err\n147|\t\t}\n148|\t\tif index > 0 && item.NativeItemKey <= previous {\n149|\t\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest items are not sorted bytewise by native item key\")\n150|\t\t}\n151|\t\tprevious = item.NativeItemKey\n152|\t\titems = append(items, item)\n153|\t}\n154|\texcluded := excludedRowClasses(items)\n155|\trawComplete := deriveRawComplete(items, input.PlanKeys, input.RawKeys)\n156|\thostID, err := scalar.ParseUUIDv7(input.CreatedByHostID)\n157|\tif err != nil {\n158|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest created_by_host_id is not a UUIDv7: %v\", err)\n159|\t}\n160|\tcreatedAt, err := scalar.ParseTimestamp(input.CreatedAt)\n161|\tif err != nil {\n162|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest created_at is not a timestamp: %v\", err)\n163|\t}\n164|\tif _, err := encodeExtensions(input.Extensions); err != nil {\n165|\t\treturn CaptureManifest{}, nil, err\n166|\t}\n167|\tvar identityValue any\n168|\tif err := json.Unmarshal(identityBytes, &identityValue); err != nil {\n169|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest source_identity is not JSON: %v\", err)\n170|\t}\n171|\tobjects := make([]any, 0, len(items))\n172|\tfor _, item := range items {\n173|\t\tobjects = append(objects, captureItemObject(item))\n174|\t}\n175|\texcludedValue := make([]any, 0, len(excluded))\n176|\tfor _, class := range excluded {\n177|\t\texcludedValue = append(excludedValue, class)\n178|\t}\n179|\tmanifest := CaptureManifest{\n180|\t\tOperationID:             operation,\n181|\t\tBundleID:                bundle,\n182|\t\tSourceBasis:             basis,\n183|\t\tSourceEnvironment:       tuple,\n184|\t\tSourceIdentity:          input.SourceIdentity,\n185|\t\tCapturePlanDigest:       planDigest,\n186|\t\tCaptureBoundary:         boundary,\n187|\t\tSourceRawObjectManifest: rawManifestID,\n188|\t\tItems:                   items,\n189|\t\tExcludedClasses:         excluded,\n190|\t\tRawComplete:             rawComplete,\n191|\t\tCreatedByHostID:         hostID,\n192|\t\tCreatedAt:               createdAt,\n193|\t}\n194|\tobject := map[string]any{\n195|\t\t\"schema\":                        captureManifestSchema,\n196|\t\t\"schema_version\":                captureManifestVersion,\n197|\t\t\"operation_id\":                  operation.String(),\n198|\t\t\"bundle_id\":                     bundle.String(),\n199|\t\t\"source_basis\":                  basisObject,\n200|\t\t\"source_environment\":            tupleObject(tuple),\n201|\t\t\"source_identity\":               identityValue,\n202|\t\t\"capture_plan_digest\":           planDigest.String(),\n203|\t\t\"capture_boundary\":              boundaryObject,\n204|\t\t\"source_raw_object_manifest_id\": rawManifestID.String(),\n205|\t\t\"items\":                         objects,\n206|\t\t\"excluded_classes\":              excludedValue,\n207|\t\t\"raw_complete\":                  rawComplete,\n208|\t\t\"created_by_host_id\":            hostID.String(),\n209|\t\t\"created_at\":                    createdAt.String(),\n210|\t\t\"extensions\":                    extensionValue(input.Extensions),\n211|\t}\n212|\treturn manifest, object, nil\n213|}\n214|\n215|// DecodeCaptureManifest validates one closed Clone Capture Manifest:\n216|// exact members, schema/version, self-digest agreement, sorted\n217|// items, exact excluded classes, and the unknown-makes-incomplete\n218|// rule. Full plan/object reconciliation needs the plan and raw key\n219|// sets; VerifyCaptureReconciliation performs it.\n220|func DecodeCaptureManifest(data []byte) (CaptureManifest, error) {\n221|\tmembers, fault := decodeStrictObject(data)\n222|\tif fault != nil {\n223|\t\treturn CaptureManifest{}, invalid(\"capture manifest %s (%s)\", fault.detail, memberField(fault.member))\n224|\t}\n225|\tif name, unknown := unknownMember(members, captureManifestMembers); unknown {\n226|\t\treturn CaptureManifest{}, invalid(\"capture manifest carries unknown member %q\", name)\n227|\t}\n228|\tif name, missing := missingMember(members, captureManifestRequired); missing {\n229|\t\treturn CaptureManifest{}, invalid(\"capture manifest misses a required member %q\", name)\n230|\t}\n231|\tschema, ok := rawString(members[\"schema\"])\n232|\tif !ok || schema != captureManifestSchema {\n233|\t\treturn CaptureManifest{}, invalid(\"capture manifest schema is not the clone capture manifest\")\n234|\t}\n235|\tversion, ok := rawString(members[\"schema_version\"])\n236|\tif !ok || version != captureManifestVersion {\n237|\t\treturn CaptureManifest{}, invalid(\"capture manifest version is not 1.0.0\")\n238|\t}\n239|\tmanifestID, ok := checkDigest(members[captureManifestSelf])\n240|\tif !ok {\n241|\t\treturn CaptureManifest{}, invalid(\"capture manifest capture_manifest_id is not a digest\")\n242|\t}\n243|\toperation, ok := checkUUIDv7(members[\"operation_id\"])\n244|\tif !ok {\n245|\t\treturn CaptureManifest{}, invalid(\"capture manifest operation_id is not a UUIDv7\")\n246|\t}\n247|\tbundle, ok := checkUUIDv7(members[\"bundle_id\"])\n248|\tif !ok {\n249|\t\treturn CaptureManifest{}, invalid(\"capture manifest bundle_id is not a UUIDv7\")\n250|\t}\n251|\tbasis, err := DecodeSourceBasis(members[\"source_basis\"])\n252|\tif err != nil {\n253|\t\treturn CaptureManifest{}, err\n254|\t}\n255|\ttuple, err := sessadapter.DecodeTuple(members[\"source_environment\"])\n256|\tif err != nil {\n257|\t\treturn CaptureManifest{}, invalid(\"capture manifest source_environment is not an Environment Tuple: %v\", err)\n258|\t}\n259|\tidentity, err := DecodeNativeIdentity(members[\"source_identity\"])\n260|\tif err != nil {\n261|\t\treturn CaptureManifest{}, err\n262|\t}\n263|\tplanDigest, ok := checkDigest(members[\"capture_plan_digest\"])\n264|\tif !ok {\n265|\t\treturn CaptureManifest{}, invalid(\"capture manifest capture_plan_digest is not a digest\")\n266|\t}\n267|\tboundary, err := DecodeCaptureBoundary(members[\"capture_boundary\"])\n268|\tif err != nil {\n269|\t\treturn CaptureManifest{}, err\n270|\t}\n271|\trawManifestID, ok := checkDigest(members[\"source_raw_object_manifest_id\"])\n272|\tif !ok {\n273|\t\treturn CaptureManifest{}, invalid(\"capture manifest source_raw_object_manifest_id is not a digest\")\n274|\t}\n275|\titems, err := decodeCaptureItems(members[\"items\"])\n276|\tif err != nil {\n277|\t\treturn CaptureManifest{}, err\n278|\t}\n279|\texcluded, ok := checkSortedUniqueStrings(members[\"excluded_classes\"], 1, 128, 0, 9)\n280|\tif !ok {\n281|\t\treturn CaptureManifest{}, invalid(\"capture manifest excluded_classes are not sorted unique string[1..128][0..9]\")\n282|\t}\n283|\tfor _, class := range excluded {\n284|\t\tif !ValidCaptureClass(class) {\n285|\t\t\treturn CaptureManifest{}, invalid(\"capture manifest excluded_classes carry unknown class %q\", class)\n286|\t\t}\n287|\t}\n288|\tif !excludedClassesExact(items, excluded) {\n289|\t\treturn CaptureManifest{}, invalid(\"capture manifest excluded_classes are not exactly the excluded-row classes\")\n290|\t}\n291|\trawComplete, ok := rawBool(members[\"raw_complete\"])\n292|\tif !ok {\n293|\t\treturn CaptureManifest{}, invalid(\"capture manifest raw_complete is not a boolean\")\n294|\t}\n295|\tif rawComplete && hasUnknownClass(items) {\n296|\t\treturn CaptureManifest{}, invalid(\"capture manifest raw_complete is true with an unknown-class item\")\n297|\t}\n298|\thostID, ok := checkUUIDv7(members[\"created_by_host_id\"])\n299|\tif !ok {\n300|\t\treturn CaptureManifest{}, invalid(\"capture manifest created_by_host_id is not a UUIDv7\")\n301|\t}\n302|\tcreatedAt, ok := checkTimestamp(members[\"created_at\"])\n303|\tif !ok {\n304|\t\treturn CaptureManifest{}, invalid(\"capture manifest created_at is not a timestamp\")\n305|\t}\n306|\tif !checkExtensions(members[\"extensions\"]) {\n307|\t\treturn CaptureManifest{}, invalid(\"capture manifest extensions are not reverse-DNS keyed\")\n308|\t}\n309|\tif err := verifySelfDigest(members, captureManifestSelf, manifestID); err != nil {\n310|\t\treturn CaptureManifest{}, err\n311|\t}\n312|\treturn CaptureManifest{\n313|\t\tManifestID:              manifestID,\n314|\t\tOperationID:             operation,\n315|\t\tBundleID:                bundle,\n316|\t\tSourceBasis:             basis,\n317|\t\tSourceEnvironment:       tuple,\n318|\t\tSourceIdentity:          identity,\n319|\t\tCapturePlanDigest:       planDigest,\n320|\t\tCaptureBoundary:         boundary,\n321|\t\tSourceRawObjectManifest: rawManifestID,\n322|\t\tItems:                   items,\n323|\t\tExcludedClasses:         excluded,\n324|\t\tRawComplete:             rawComplete,\n325|\t\tCreatedByHostID:         hostID,\n326|\t\tCreatedAt:               createdAt,\n327|\t}, nil\n328|}\n329|\n330|func decodeCaptureItems(raw json.RawMessage) ([]CaptureItem, error) {\n331|\telements, ok := decodeArray(raw)\n332|\tif !ok {\n333|\t\treturn nil, invalid(\"capture manifest items are not an array\")\n334|\t}\n335|\tif len(elements) > 65536 {\n336|\t\treturn nil, invalid(\"capture manifest carries %d items, maximum is 65536\", len(elements))\n337|\t}\n338|\titems := make([]CaptureItem, 0, len(elements))\n339|\tprevious := \"\"\n340|\tfor index, element := range elements {\n341|\t\titem, err := decodeCaptureItem(element, index)\n342|\t\tif err != nil {\n343|\t\t\treturn nil, err\n344|\t\t}\n345|\t\tif index > 0 && item.NativeItemKey <= previous {\n346|\t\t\treturn nil, invalid(\"capture manifest items are not sorted bytewise by native item key\")\n347|\t\t}\n348|\t\tprevious = item.NativeItemKey\n349|\t\titems = append(items, item)\n350|\t}\n351|\treturn items, nil\n352|}\n353|\n354|// excludedRowClasses derives the exact excluded-row class set:\n355|// sorted unique classes of excluded rows.\n356|func excludedRowClasses(items []CaptureItem) []string {\n357|\tseen := map[string]bool{}\n358|\tfor _, item := range items {\n359|\t\tif !item.Included() {\n360|\t\t\tseen[item.Class] = true\n361|\t\t}\n362|\t}\n363|\tclasses := make([]string, 0, len(seen))\n364|\tfor class := range seen {\n365|\t\tclasses = append(classes, class)\n366|\t}\n367|\tsort.Strings(classes)\n368|\treturn classes\n369|}\n370|\n371|func excludedClassesExact(items []CaptureItem, excluded []string) bool {\n372|\tderived := excludedRowClasses(items)\n373|\tif len(derived) != len(excluded) {\n374|\t\treturn false\n375|\t}\n376|\tfor index := range derived {\n377|\t\tif derived[index] != excluded[index] {\n378|\t\t\treturn false\n379|\t\t}\n380|\t}\n381|\treturn true\n382|}\n383|\n384|func hasUnknownClass(items []CaptureItem) bool {\n385|\tfor _, item := range items {\n386|\t\tif item.Class == \"unknown\" {\n387|\t\t\treturn true\n388|\t\t}\n389|\t}\n390|\treturn false\n391|}\n392|\n393|// deriveRawComplete is the core raw_complete derivation: true only\n394|// when no item has unknown class, every plan candidate reconciles\n395|// to exactly one item, and the included items are exactly the raw\n396|// manifest keys (all and only included objects).\n397|func deriveRawComplete(items []CaptureItem, planKeys, rawKeys []string) bool {\n398|\tif hasUnknownClass(items) {\n399|\t\treturn false\n400|\t}\n401|\tif len(items) != len(planKeys) {\n402|\t\treturn false\n403|\t}\n404|\tplanSet := map[string]bool{}\n405|\tfor _, key := range planKeys {\n406|\t\tplanSet[key] = true\n407|\t}\n408|\tif len(planSet) != len(planKeys) {\n409|\t\treturn false\n410|\t}\n411|\tincluded := map[string]bool{}\n412|\tfor _, item := range items {\n413|\t\tif !planSet[item.NativeItemKey] {\n414|\t\t\treturn false\n415|\t\t}\n416|\t\tif item.Included() {\n417|\t\t\tincluded[item.NativeItemKey] = true\n418|\t\t}\n419|\t}\n420|\tif len(included) != len(rawKeys) {\n421|\t\treturn false\n422|\t}\n423|\tfor _, key := range rawKeys {\n424|\t\tif !included[key] {\n425|\t\t\treturn false\n426|\t\t}\n427|\t}\n428|\treturn true\n429|}\n430|\n431|// VerifyCaptureReconciliation re-checks complete plan/object\n432|// reconciliation for a decoded manifest: one item per plan\n433|// candidate, the raw closure over exactly the included items, and a\n434|// raw_complete flag that matches the derivation. Unknown classes\n435|// always reconcile to false.\n436|func VerifyCaptureReconciliation(manifest CaptureManifest, planKeys, rawKeys []string) error {\n437|\tderived := deriveRawComplete(manifest.Items, planKeys, rawKeys)\n438|\tif manifest.RawComplete != derived {\n439|\t\treturn invalid(\"capture manifest raw_complete is %v, reconciliation derives %v\", manifest.RawComplete, derived)\n440|\t}\n441|\tif !derived {\n442|\t\treturn invalid(\"capture manifest plan/object reconciliation is incomplete\")\n443|\t}\n444|\treturn nil\n445|}\n446|\n447|// RefuseMaximalSafeUnlessComplete blocks the maximal_safe fidelity\n448|// profile: unknown classes block it, and it requires a reconciled\n449|// complete manifest. Projection planning calls this gate.\n450|func RefuseMaximalSafeUnlessComplete(manifest CaptureManifest) error {\n451|\tif hasUnknownClass(manifest.Items) {\n452|\t\treturn invalid(\"maximal_safe is blocked by an unknown-class item\")\n453|\t}\n454|\tif !manifest.RawComplete {\n455|\t\treturn invalid(\"maximal_safe requires raw_complete\")\n456|\t}\n457|\treturn nil\n458|}","final_result":true}}}
