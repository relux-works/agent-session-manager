{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6bb","stream":{"kind":"session","id":"01a0b0cc-369a-7993-946b-ef774181fd54"},"sequence":440,"recorded_at":1780531400000875,"record_type":"event","durability":"durable","causation_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","run_stream":{"kind":"run","id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3"},"task_stream":{"kind":"task","id":"01a0b0cd-2629-7b90-b13e-9d200240f04c"},"task_id":"01a0b0cd-2629-7b90-b13e-9d200240f04c","event":{"kind":"output","task_id":"01a0b0cd-2629-7b90-b13e-9d200240f04c","chunk":"Read text file `internal/clonebundle/identity.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"strings\"\n6|\t\"unicode/utf8\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|// This file validates the Section 13.14.1 identities: NativeIdentity,\n12|// WorkspaceBinding, and the sanitized native-key admission shared by\n13|// every native key in this package. Sanitized means printable,\n14|// relative, and unambiguously native: never an absolute source path,\n15|// never an AX Session identity, never carrying embedded credentials.\n16|\n17|var nativeIdentityMembers = map[string]bool{\n18|\t\"native_session_id\":         true,\n19|\t\"identity_kind\":             true,\n20|\t\"logical_workspace_id\":      true,\n21|\t\"backend_realm_fingerprint\": true,\n22|\t\"opaque_identity\":           true,\n23|\t\"extensions\":                true,\n24|}\n25|\n26|var nativeIdentityRequired = []string{\n27|\t\"native_session_id\",\n28|\t\"identity_kind\",\n29|\t\"logical_workspace_id\",\n30|\t\"backend_realm_fingerprint\",\n31|\t\"opaque_identity\",\n32|\t\"extensions\",\n33|}\n34|\n35|var nativeIdentityKinds = []string{\n36|\t\"provider_native\",\n37|\t\"official_import\",\n38|\t\"continuation_context\",\n39|}\n40|\n41|func validNativeIdentityKind(kind string) bool {\n42|\tfor _, allowed := range nativeIdentityKinds {\n43|\t\tif kind == allowed {\n44|\t\t\treturn true\n45|\t\t}\n46|\t}\n47|\treturn false\n48|}\n49|\n50|// NativeIdentity is one validated sanitized native identity.\n51|type NativeIdentity struct {\n52|\tNativeSessionID         string\n53|\tIdentityKind            string\n54|\tLogicalWorkspaceID      scalar.UUIDv7\n55|\tBackendRealmFingerprint *scalar.Digest\n56|\tOpaqueIdentity          *string\n57|}\n58|\n59|// DecodeNativeIdentity validates one closed NativeIdentity: exact\n60|// members, the closed identity-kind vocabulary, a sanitized native\n61|// session ID, a UUIDv7 logical workspace, an optional digest realm\n62|// fingerprint, an optional sanitized opaque identity, and\n63|// reverse-DNS extensions. Credential, absolute-path, PID, socket,\n64|// token, and secret-environment material is refused by the shared\n65|// sanitizer, never laundered into an identity.\n66|func DecodeNativeIdentity(raw json.RawMessage) (NativeIdentity, error) {\n67|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n68|\tif fault != nil {\n69|\t\treturn NativeIdentity{}, invalid(\"native identity %s (%s)\", fault.detail, memberField(fault.member))\n70|\t}\n71|\tif name, unknown := unknownMember(members, nativeIdentityMembers); unknown {\n72|\t\treturn NativeIdentity{}, invalid(\"native identity carries unknown member %q\", name)\n73|\t}\n74|\tif name, missing := missingMember(members, nativeIdentityRequired); missing {\n75|\t\treturn NativeIdentity{}, invalid(\"native identity misses a required member %q\", name)\n76|\t}\n77|\tnativeID, ok := checkStringBounds(members[\"native_session_id\"], 1, 512)\n78|\tif !ok {\n79|\t\treturn NativeIdentity{}, invalid(\"native identity native_session_id is not a string[1..512]\")\n80|\t}\n81|\tif err := SanitizeNativeKey(nativeID); err != nil {\n82|\t\treturn NativeIdentity{}, err\n83|\t}\n84|\tkind, ok := rawString(members[\"identity_kind\"])\n85|\tif !ok || !validNativeIdentityKind(kind) {\n86|\t\treturn NativeIdentity{}, invalid(\"native identity kind is outside provider_native|official_import|continuation_context\")\n87|\t}\n88|\tworkspaceID, ok := checkUUIDv7(members[\"logical_workspace_id\"])\n89|\tif !ok {\n90|\t\treturn NativeIdentity{}, invalid(\"native identity logical_workspace_id is not a UUIDv7\")\n91|\t}\n92|\tvar fingerprint *scalar.Digest\n93|\tif !isNull(members[\"backend_realm_fingerprint\"]) {\n94|\t\tdigest, ok := checkDigest(members[\"backend_realm_fingerprint\"])\n95|\t\tif !ok {\n96|\t\t\treturn NativeIdentity{}, invalid(\"native identity backend_realm_fingerprint is not a digest\")\n97|\t\t}\n98|\t\tfingerprint = &digest\n99|\t}\n100|\tvar opaque *string\n101|\tif !isNull(members[\"opaque_identity\"]) {\n102|\t\tvalue, ok := checkStringBounds(members[\"opaque_identity\"], 1, 512)\n103|\t\tif !ok {\n104|\t\t\treturn NativeIdentity{}, invalid(\"native identity opaque_identity is not a string[1..512]\")\n105|\t\t}\n106|\t\tif err := SanitizeNativeKey(value); err != nil {\n107|\t\t\treturn NativeIdentity{}, err\n108|\t\t}\n109|\t\topaque = &value\n110|\t}\n111|\tif !checkExtensions(members[\"extensions\"]) {\n112|\t\treturn NativeIdentity{}, invalid(\"native identity extensions are not reverse-DNS keyed\")\n113|\t}\n114|\treturn NativeIdentity{\n115|\t\tNativeSessionID:         nativeID,\n116|\t\tIdentityKind:            kind,\n117|\t\tLogicalWorkspaceID:      workspaceID,\n118|\t\tBackendRealmFingerprint: fingerprint,\n119|\t\tOpaqueIdentity:          opaque,\n120|\t}, nil\n121|}\n122|\n123|// EncodeNativeIdentity renders one validated identity as canonical\n124|// bytes under the given already-validated extensions. The identity\n125|// must already be decoded; encoding never admits what decoding\n126|// refused. A nil extensions map encodes as the empty object.\n127|func EncodeNativeIdentity(identity NativeIdentity, extensions map[string]any) ([]byte, error) {\n128|\tvar fingerprint any\n129|\tif identity.BackendRealmFingerprint != nil {\n130|\t\tfingerprint = identity.BackendRealmFingerprint.String()\n131|\t}\n132|\tvar opaque any\n133|\tif identity.OpaqueIdentity != nil {\n134|\t\topaque = *identity.OpaqueIdentity\n135|\t}\n136|\tif extensions == nil {\n137|\t\textensions = map[string]any{}\n138|\t}\n139|\treturn canonicalizeObject(map[string]any{\n140|\t\t\"native_session_id\":         identity.NativeSessionID,\n141|\t\t\"identity_kind\":             identity.IdentityKind,\n142|\t\t\"logical_workspace_id\":      identity.LogicalWorkspaceID.String(),\n143|\t\t\"backend_realm_fingerprint\": fingerprint,\n144|\t\t\"opaque_identity\":           opaque,\n145|\t\t\"extensions\":                extensions,\n146|\t})\n147|}\n148|\n149|var workspaceBindingMembers = map[string]bool{\n150|\t\"logical_workspace_id\":           true,\n151|\t\"cwd_relative\":                   true,\n152|\t\"repository_remote_fingerprints\": true,\n153|\t\"branch\":                         true,\n154|\t\"head_digest\":                    true,\n155|\t\"index_digest\":                   true,\n156|\t\"working_tree_digest\":            true,\n157|\t\"extensions\":                     true,\n158|}\n159|\n160|var workspaceBindingRequired = []string{\n161|\t\"logical_workspace_id\",\n162|\t\"cwd_relative\",\n163|\t\"repository_remote_fingerprints\",\n164|\t\"branch\",\n165|\t\"head_digest\",\n166|\t\"index_digest\",\n167|\t\"working_tree_digest\",\n168|\t\"extensions\",\n169|}\n170|\n171|// WorkspaceBinding is one validated closed workspace binding. No\n172|// member grants filesystem authority: the cwd is a normalized\n173|// relative path beneath the Workspace Group root, never an absolute\n174|// path or an escape.\n175|type WorkspaceBinding struct {\n176|\tLogicalWorkspaceID scalar.UUIDv7\n177|\tCwdRelative        string\n178|\tRemoteFingerprints []scalar.Digest\n179|\tBranch             *string\n180|\tHeadDigest         *scalar.Digest\n181|\tIndexDigest        *scalar.Digest\n182|\tWorkingTreeDigest  *scalar.Digest\n183|}\n184|\n185|// DecodeWorkspaceBinding validates one closed WorkspaceBinding.\n186|func DecodeWorkspaceBinding(raw json.RawMessage) (WorkspaceBinding, error) {\n187|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n188|\tif fault != nil {\n189|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding %s (%s)\", fault.detail, memberField(fault.member))\n190|\t}\n191|\tif name, unknown := unknownMember(members, workspaceBindingMembers); unknown {\n192|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding carries unknown member %q\", name)\n193|\t}\n194|\tif name, missing := missingMember(members, workspaceBindingRequired); missing {\n195|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding misses a required member %q\", name)\n196|\t}\n197|\tworkspaceID, ok := checkUUIDv7(members[\"logical_workspace_id\"])\n198|\tif !ok {\n199|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding logical_workspace_id is not a UUIDv7\")\n200|\t}\n201|\tcwd, ok := checkStringBounds(members[\"cwd_relative\"], 1, 4096)\n202|\tif !ok {\n203|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding cwd_relative is not a string[1..4096]\")\n204|\t}\n205|\tif err := checkCwdRelative(cwd); err != nil {\n206|\t\treturn WorkspaceBinding{}, err\n207|\t}\n208|\tfingerprints, ok := checkSortedUniqueDigests(members[\"repository_remote_fingerprints\"], 0, 128)\n209|\tif !ok {\n210|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding repository_remote_fingerprints are not sorted unique digest[0..128]\")\n211|\t}\n212|\tvar branch *string\n213|\tif !isNull(members[\"branch\"]) {\n214|\t\tvalue, ok := checkStringBounds(members[\"branch\"], 1, 1024)\n215|\t\tif !ok {\n216|\t\t\treturn WorkspaceBinding{}, invalid(\"workspace binding branch is not a string[1..1024]\")\n217|\t\t}\n218|\t\tbranch = &value\n219|\t}\n220|\thead, err := checkNullableDigest(members, \"head_digest\", \"workspace binding\")\n221|\tif err != nil {\n222|\t\treturn WorkspaceBinding{}, err\n223|\t}\n224|\tindex, err := checkNullableDigest(members, \"index_digest\", \"workspace binding\")\n225|\tif err != nil {\n226|\t\treturn WorkspaceBinding{}, err\n227|\t}\n228|\ttree, err := checkNullableDigest(members, \"working_tree_digest\", \"workspace binding\")\n229|\tif err != nil {\n230|\t\treturn WorkspaceBinding{}, err\n231|\t}\n232|\tif !checkExtensions(members[\"extensions\"]) {\n233|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding extensions are not reverse-DNS keyed\")\n234|\t}\n235|\treturn WorkspaceBinding{\n236|\t\tLogicalWorkspaceID: workspaceID,\n237|\t\tCwdRelative:        cwd,\n238|\t\tRemoteFingerprints: fingerprints,\n239|\t\tBranch:             branch,\n240|\t\tHeadDigest:         head,\n241|\t\tIndexDigest:        index,\n242|\t\tWorkingTreeDigest:  tree,\n243|\t}, nil\n244|}\n245|\n246|// checkCwdRelative admits exactly the normalized relative paths\n247|// beneath (or equal to) the Workspace Group root: scalar relative\n248|// paths plus the root itself (\".\"). Anything else — absolute,\n249|// escaped, backslashed, encoded-separator, or dot-segment forms —\n250|// would grant or smuggle filesystem authority and is refused.\n251|func checkCwdRelative(cwd string) error {\n252|\tif cwd == \".\" {\n253|\t\treturn nil\n254|\t}\n255|\tif _, err := scalar.ParseRelativePath(cwd); err != nil {\n256|\t\treturn invalid(\"workspace binding cwd_relative is not normalized beneath the workspace root: %v\", err)\n257|\t}\n258|\treturn nil\n259|}\n260|\n261|func checkNullableDigest(members map[string]json.RawMessage, name, owner string) (*scalar.Digest, error) {\n262|\traw, present := members[name]\n263|\tif !present {\n264|\t\treturn nil, invalid(\"%s misses a required member %q\", owner, name)\n265|\t}\n266|\tif isNull(raw) {\n267|\t\treturn nil, nil\n268|\t}\n269|\tdigest, ok := checkDigest(raw)\n270|\tif !ok {\n271|\t\treturn nil, invalid(\"%s %s is not a digest\", owner, name)\n272|\t}\n273|\treturn &digest, nil\n274|}\n275|\n276|// SanitizeNativeKey refuses every native key that is not sanitized:\n277|// empty values are refused here (over-long values by the caller's\n278|// bound check), and this gate refuses control characters,\n279|// absolute-path forms, a\n280|// UUIDv7 form (indistinguishable from a fabricated AX Session\n281|// identity), embedded-credential forms, and AX-schema markers. A\n282|// native key that survives is printable, relative, and\n283|// unambiguously native.\n284|func SanitizeNativeKey(key string) error {\n285|\tif key == \"\" {\n286|\t\treturn invalid(\"native key is empty\")\n287|\t}\n288|\tif !utf8.ValidString(key) {\n289|\t\treturn invalid(\"native key is not valid UTF-8\")\n290|\t}\n291|\tfor _, unit := range key {\n292|\t\tif unit < 0x20 || unit == 0x7f {\n293|\t\t\treturn invalid(\"native key carries control characters\")\n294|\t\t}\n295|\t}\n296|\tif strings.HasPrefix(key, \"/\") || strings.HasPrefix(key, `\\\\`) || hasDrivePrefix(key) {\n297|\t\treturn invalid(\"native key is an absolute source path, never a cross-host identity\")\n298|\t}\n299|\tif _, err := scalar.ParseUUIDv7(key); err == nil {\n300|\t\treturn invalid(\"native key %q is a UUIDv7, indistinguishable from a fabricated AX Session identity\", key)\n301|\t}\n302|\tif strings.Contains(key, \"urn:ax:\") {\n303|\t\treturn invalid(\"native key carries an AX identity marker\")\n304|\t}\n305|\tif at := strings.Index(key, \"@\"); at >= 0 {\n306|\t\tif scheme := strings.Index(key, \"://\"); scheme >= 0 && scheme < at {\n307|\t\t\tif slash := strings.Index(key[scheme+3:], \"/\"); slash < 0 || scheme+3+slash > at {\n308|\t\t\t\treturn invalid(\"native key carries embedded credentials\")\n309|\t\t\t}\n310|\t\t}\n311|\t}\n312|\treturn nil\n313|}\n314|\n315|func hasDrivePrefix(value string) bool {\n316|\treturn len(value) >= 3 && ((value[0] >= 'a' && value[0] <= 'z') || (value[0] >= 'A' && value[0] <= 'Z')) && value[1] == ':' && (value[2] == '/' || value[2] == '\\\\')\n317|}\n318|\n319|func memberField(member string) string {\n320|\tif member == \"\" {\n321|\t\treturn \"frame\"\n322|\t}\n323|\treturn \"member \" + member\n324|}","final_result":true}}}
