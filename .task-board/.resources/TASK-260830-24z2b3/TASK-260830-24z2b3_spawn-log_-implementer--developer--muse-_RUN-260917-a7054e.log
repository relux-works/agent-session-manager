{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb5d","stream":{"kind":"session","id":"01a0b0cc-369a-7993-946b-ef774181fd54"},"sequence":1033,"recorded_at":1780531400002061,"record_type":"event","durability":"durable","causation_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","run_stream":{"kind":"run","id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3"},"call_id":"call_01a0b0cf6ae97151ad5b7a671cbc77b5","text":"Read text file `/tmp/rev2/reviewer_mutants.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Reviewer mutation runner for TASK-260830-24z2b3 rev2.\n3|\n4|Loads the producer's MUTANTS table from the shipped harness (import, no\n5|copy), adds the reviewer's own plants, runs each plant N times against the\n6|isolated candidate copy, and writes one raw log per run with the subprocess\n7|exit code. Verdict rule mirrors the shipped harness: KILLED iff go test\n8|fails with a FAIL line, SURVIVED iff exit 0, ERROR otherwise.\n9|\"\"\"\n10|import importlib.util, os, shutil, subprocess, sys, tempfile, time\n11|from pathlib import Path\n12|\n13|HERE = Path(__file__).resolve().parent\n14|CANDIDATE = HERE.parent / \"candidate\"\n15|LOGDIR = HERE / \"logs\" / \"mutants\"\n16|LOGDIR.mkdir(parents=True, exist_ok=True)\n17|PACKAGE = \"internal/clonebundle\"\n18|\n19|spec = importlib.util.spec_from_file_location(\"mutant_harness\", CANDIDATE / PACKAGE / \"testdata\" / \"mutant_harness.py\")\n20|harness = importlib.util.module_from_spec(spec)\n21|spec.loader.exec_module(harness)\n22|Mutant = harness.Mutant\n23|PRODUCER = list(harness.MUTANTS)\n24|\n25|REVIEWER = [\n26|    # --- the four classes the reviewer brief names ---\n27|    Mutant(\"R-unknown-ignores-one\", f\"{PACKAGE}/capturebuild.go\",\n28|           '\\t\\tif item.Class == \"unknown\" {\\n',\n29|           '\\t\\tif item.Class == \"unknown\" && item.NativeItemKey != \"store/zz-unknown\" {\\n', 1,\n30|           \"TestBuildCaptureManifestUnknownMakesIncomplete\", \"KILLED\",\n31|           \"raw_complete derivation ignores exactly one unknown item (the killer's key).\"),\n32|    Mutant(\"R-excluded-set-missing-machine_auth\", f\"{PACKAGE}/captureitem.go\",\n33|           '\\tcase \"credential\", \"machine_auth\", \"runtime_state\", \"transient_lock\":\\n',\n34|           '\\tcase \"credential\", \"runtime_state\", \"transient_lock\":\\n', 1,\n35|           \"TestCaptureItemRefusals/machine_auth_included\", \"KILLED\",\n36|           \"always-excluded set missing machine_auth.\"),\n37|    Mutant(\"R-raw-subset-admits-machine_auth\", f\"{PACKAGE}/rawmanifest.go\",\n38|           '\\t\"derived_cache_optional\",\\n\\t\"unknown\",\\n',\n39|           '\\t\"derived_cache_optional\",\\n\\t\"machine_auth\",\\n\\t\"unknown\",\\n', 1,\n40|           \"TestRawManifestRefusals/build/machine_auth_forbidden\", \"KILLED\",\n41|           \"raw entry class subset admits machine_auth.\"),\n42|    Mutant(\"R-capture-items-dup-build\", f\"{PACKAGE}/capturebuild.go\",\n43|           \"\\t\\tif index > 0 && item.NativeItemKey <= previous {\\n\\t\\t\\treturn CaptureManifest{}, nil, invalid(\",\n44|           \"\\t\\tif index > 0 && item.NativeItemKey < previous {\\n\\t\\t\\treturn CaptureManifest{}, nil, invalid(\", 1,\n45|           \"TestCaptureItemRefusals/duplicate_items\", \"KILLED\",\n46|           \"capture items sorted-unique accepts an equal-key duplicate at BUILD.\"),\n47|    Mutant(\"R-capture-items-dup-decode\", f\"{PACKAGE}/capturebuild.go\",\n48|           \"\\t\\tif index > 0 && item.NativeItemKey <= previous {\\n\\t\\t\\treturn nil, invalid(\",\n49|           \"\\t\\tif index > 0 && item.NativeItemKey < previous {\\n\\t\\t\\treturn nil, invalid(\", 1,\n50|           \"Test\", \"KILLED\",\n51|           \"capture items sorted-unique accepts an equal-key duplicate at DECODE (whole suite as killer).\"),\n52|    Mutant(\"R-sorted-digests-dup-decode\", f\"{PACKAGE}/decode.go\",\n53|           \"\\t\\tif index > 0 && text <= previous {\\n\",\n54|           \"\\t\\tif index > 0 && text < previous {\\n\", 1,\n55|           \"Test\", \"KILLED\",\n56|           \"checkSortedUniqueDigests accepts an equal duplicate (heads/parents/fingerprints at decode).\"),\n57|    Mutant(\"R-sorted-strings-dup-decode\", f\"{PACKAGE}/decode.go\",\n58|           \"\\t\\tif index > 0 && value <= previous {\\n\",\n59|           \"\\t\\tif index > 0 && value < previous {\\n\", 1,\n60|           \"Test\", \"KILLED\",\n61|           \"checkSortedUniqueStrings accepts an equal duplicate (excluded_classes/reason_codes at decode).\"),\n62|    Mutant(\"R-rawrefs-dup-decode\", f\"{PACKAGE}/event.go\",\n63|           \"\\t\\tif index > 0 && bytes.Compare(canonical, previous) <= 0 {\\n\",\n64|           \"\\t\\tif index > 0 && bytes.Compare(canonical, previous) < 0 {\\n\", 1,\n65|           \"Test\", \"KILLED\",\n66|           \"raw_refs sorted-unique accepts an equal duplicate at DECODE.\"),\n67|    Mutant(\"R-sanitizer-admits-0x01\", f\"{PACKAGE}/identity.go\",\n68|           \"\\t\\tif unit < 0x20 || unit == 0x7f {\\n\",\n69|           \"\\t\\tif (unit < 0x20 && unit != 0x01) || unit == 0x7f {\\n\", 1,\n70|           \"Test\", \"KILLED\",\n71|           \"native-key sanitizer admits exactly U+0001.\"),\n72|    Mutant(\"R-sanitizer-admits-0x1f\", f\"{PACKAGE}/identity.go\",\n73|           \"\\t\\tif unit < 0x20 || unit == 0x7f {\\n\",\n74|           \"\\t\\tif (unit < 0x20 && unit != 0x1f) || unit == 0x7f {\\n\", 1,\n75|           \"TestIdentityRefusals/sanitizer\", \"KILLED\",\n76|           \"native-key sanitizer admits exactly U+001F (in the corpus).\"),\n77|    # --- decode-side duplicates of build-tested rules ---\n78|    Mutant(\"R-decode-item-class\", f\"{PACKAGE}/captureitem.go\",\n79|           '\\tif !ok || !ValidCaptureClass(class) {\\n\\t\\treturn CaptureItem{}, invalid(\"capture item[%d] class %q is outside the nine-class vocabulary\", index, class)\\n\\t}\\n\\tdisposition, ok := rawString(members[\"disposition\"])\\n',\n80|           '\\tif !ok || (!ValidCaptureClass(class) && class != \"mystery\") {\\n\\t\\treturn CaptureItem{}, invalid(\"capture item[%d] class %q is outside the nine-class vocabulary\", index, class)\\n\\t}\\n\\tdisposition, ok := rawString(members[\"disposition\"])\\n', 1,\n81|           \"Test\", \"KILLED\",\n82|           \"decodeCaptureItem admits exactly class mystery.\"),\n83|    Mutant(\"R-decode-actor-main-parent\", f\"{PACKAGE}/session.go\",\n84|           '\\tif kind == \"main\" && parent != nil {\\n',\n85|           '\\tif kind == \"main\" && parent != nil && index != 0 {\\n', 1,\n86|           \"Test\", \"KILLED\",\n87|           \"decodeActor admits exactly actor[0] main-with-parent.\"),\n88|    Mutant(\"R-decode-evidence-status\", f\"{PACKAGE}/event.go\",\n89|           '\\tstatus, ok := rawString(members[\"capture_status\"])\\n\\tif !ok || !validCaptureStatus(status) {\\n',\n90|           '\\tstatus, ok := rawString(members[\"capture_status\"])\\n\\tif !ok || (!validCaptureStatus(status) && status != \"maybe\") {\\n', 1,\n91|           \"Test\", \"KILLED\",\n92|           \"DecodeSourceEvidence admits exactly capture_status maybe.\"),\n93|    Mutant(\"R-decode-event-visibility\", f\"{PACKAGE}/event.go\",\n94|           '\\tif !ok || !validVisibility(visibility) {\\n\\t\\treturn CanonicalEvent{}, invalid(',\n95|           '\\tif !ok || (!validVisibility(visibility) && visibility != \"secret\") {\\n\\t\\treturn CanonicalEvent{}, invalid(', 1,\n96|           \"Test\", \"KILLED\",\n97|           \"DecodeCanonicalEvent admits exactly visibility secret.\"),\n98|    # --- verification entries with positive-only evidence ---\n99|    Mutant(\"R-verify-descriptors-skip-0\", f\"{PACKAGE}/rawmanifest.go\",\n100|           \"\\t\\tif err := VerifyDescriptorAgreement(descriptor, entry.BlobID, entry.ByteCount); err != nil {\\n\\t\\t\\treturn invalid(\\\"raw object entry[%d]: %v\\\", index, err)\\n\",\n101|           \"\\t\\tif err := VerifyDescriptorAgreement(descriptor, entry.BlobID, entry.ByteCount); err != nil && index != 0 {\\n\\t\\t\\treturn invalid(\\\"raw object entry[%d]: %v\\\", index, err)\\n\", 1,\n102|           \"Test\", \"KILLED\",\n103|           \"VerifyRawManifestDescriptors admits a disagreeing descriptor at entry 0.\"),\n104|    Mutant(\"R-install-site-claim\", f\"{PACKAGE}/blobref.go\",\n105|           \"\\tif calculated != claimed {\\n\\t\\treturn BlobAgreement{}, invalid(\",\n106|           \"\\tif calculated != claimed && false {\\n\\t\\treturn BlobAgreement{}, invalid(\", 1,\n107|           \"Test\", \"KILLED\",\n108|           \"InstallRawBlob install-site claim comparison disabled (the site N-descriptor-claim says it pins).\"),\n109|    Mutant(\"R-identity-digest-kind\", f\"{PACKAGE}/identity.go\",\n110|           \"func validNativeIdentityKind(kind string) bool {\\n\",\n111|           \"func validNativeIdentityKind(kind string) bool {\\n\\tif kind == \\\"imported\\\" {\\n\\t\\treturn true\\n\\t}\\n\", 1,\n112|           \"TestIdentityRefusals/native_identity/bad_kind\", \"KILLED\",\n113|           \"identity kind vocabulary admits exactly imported.\"),\n114|    Mutant(\"R-descriptor-id-unlinked2\", f\"{PACKAGE}/rawmanifest.go\",\n115|           \"\\t\\tif err := VerifyDescriptorAgreement(input.Descriptor, blobID, input.ByteCount); err != nil {\\n\\t\\t\\treturn nil, 0, invalid(\\\"raw object entry[%d]: %v\\\", index, err)\\n\\t\\t}\\n\",\n116|           \"\\t\\tif err := VerifyDescriptorAgreement(input.Descriptor, blobID, input.ByteCount); err != nil {\\n\\t\\t\\treturn nil, 0, invalid(\\\"raw object entry[%d]: %v\\\", index, err)\\n\\t\\t}\\n\\t\\tdescriptorID = scalar.SHA256Digest([]byte(input.DescriptorID))\\n\", 1,\n117|           \"Test\", \"KILLED\",\n118|           \"P1 witness: the sealed entry's blob_descriptor_id is replaced by an unrelated digest after agreement passes; no test notices.\"),\n119|    Mutant(\"C-review-comment\", f\"{PACKAGE}/generation.go\",\n120|           \"// This file owns the Section 13.14.1 immutable generations: the\\n\",\n121|           \"// This file owns the Section 13.14.1 immutable generations (control): the\\n\", 1,\n122|           \"Test\", \"SURVIVED\", \"Reviewer harmless control: comment-only edit must survive.\"),\n123|]\n124|\n125|\n126|def run_once(mutant, run_index):\n127|    target = CANDIDATE / mutant.path\n128|    original = target.read_text()\n129|    found = original.count(mutant.find)\n130|    log = LOGDIR / f\"{mutant.name}-run{run_index}.log\"\n131|    if found != mutant.count:\n132|        log.write_text(f\"NOT_APPLIED anchors={found} want={mutant.count}\\n\")\n133|        return \"NOT_APPLIED\", log\n134|    with tempfile.TemporaryDirectory() as staging:\n135|        backup = Path(staging) / \"backup\"\n136|        shutil.copy2(target, backup)\n137|        try:\n138|            target.write_text(original.replace(mutant.find, mutant.replace))\n139|            started = time.time()\n140|            proc = subprocess.run([\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n141|                                  cwd=CANDIDATE, capture_output=True, text=True, timeout=600,\n142|                                  env={**os.environ, \"PYTHONDONTWRITEBYTECODE\": \"1\"})\n143|            elapsed = time.time() - started\n144|        finally:\n145|            shutil.copy2(backup, target)\n146|    assert target.read_text() == original, \"restore failed\"\n147|    out = proc.stdout + proc.stderr\n148|    log.write_text(f\"# mutant={mutant.name} run={run_index} path={mutant.path} -run={mutant.run}\\n\"\n149|                   f\"# exit={proc.returncode} elapsed={elapsed:.1f}s\\n# find={mutant.find!r}\\n# replace={mutant.replace!r}\\n---\\n{out}\")\n150|    if \"build failed\" in out or \"\\n# \" in out or out.startswith(\"# \"):\n151|        return \"COMPILE_FAIL\", log\n152|    if proc.returncode == 0:\n153|        return \"SURVIVED\", log\n154|    if \"--- FAIL\" in out or \"FAIL:\" in out:\n155|        return \"KILLED\", log\n156|    return f\"ERROR(exit {proc.returncode})\", log\n157|\n158|\n159|def main(argv):\n160|    which = argv[0] if argv else \"all\"\n161|    repeats = int(argv[1]) if len(argv) > 1 else 1\n162|    table = {\"producer\": PRODUCER, \"reviewer\": REVIEWER, \"all\": PRODUCER + REVIEWER}[which]\n163|    print(f\"# runner={Path(__file__).name} candidate={CANDIDATE} set={which} repeats={repeats}\")\n164|    counts = {}\n165|    for m in table:\n166|        verdicts = []\n167|        for i in range(1, repeats + 1):\n168|            v, log = run_once(m, i)\n169|            verdicts.append(v)\n170|            print(f\"{m.name:44s} run{i} {v:14s} want={m.expect:9s} log={log.name}\", flush=True)\n171|        stable = len(set(verdicts)) == 1\n172|        mark = \"ok\" if stable and verdicts[0] == m.expect else \"MISMATCH\"\n173|        counts[mark] = counts.get(mark, 0) + 1\n174|        print(f\"  => {mark}: {m.name}: {'/'.join(verdicts)} :: {m.note}\", flush=True)\n175|    print(f\"# summary {counts}\")\n176|    return 0\n177|\n178|\n179|if __name__ == \"__main__\":\n180|    sys.exit(main(sys.argv[1:]))","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
