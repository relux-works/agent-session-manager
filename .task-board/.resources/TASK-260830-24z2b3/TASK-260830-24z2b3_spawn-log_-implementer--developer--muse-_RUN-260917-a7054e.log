{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c669","stream":{"kind":"session","id":"01a0b0cc-369a-7993-946b-ef774181fd54"},"sequence":399,"recorded_at":1780531400000793,"record_type":"event","durability":"durable","causation_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","run_stream":{"kind":"run","id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3"},"call_id":"call_01a0b0cd0ba971d0bdcdd292b8adf744","text":"Read text file `internal/clonebundle/rawmanifest.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/hosttrust\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n9|)\n10|\n11|// This file validates and constructs Clone Raw Object Manifest 1.0.0:\n12|// the closed sorted unique entry list over content-addressed blobs.\n13|// Credential, machine-auth, runtime-state, transient-lock, and\n14|// hosttrust-excluded candidates are forbidden here; they never become\n15|// raw objects.\n16|\n17|const (\n18|\trawManifestSchema  = \"urn:ax:schema:clone-raw-object-manifest\"\n19|\trawManifestVersion = \"1.0.0\"\n20|\trawManifestSelf    = \"raw_object_manifest_id\"\n21|)\n22|\n23|// rawEntryClasses is the closed RawObjectEntry class subset:\n24|// durable and derived-cache classes plus unknown. The four\n25|// excluded classes (credential, machine_auth, runtime_state,\n26|// transient_lock) are absent by construction, so membership in this\n27|// table is the gate.\n28|var rawEntryClasses = []string{\n29|\t\"durable_payload\",\n30|\t\"durable_index_required\",\n31|\t\"durable_sidecar\",\n32|\t\"derived_cache_optional\",\n33|\t\"unknown\",\n34|}\n35|\n36|func validRawEntryClass(class string) bool {\n37|\tfor _, allowed := range rawEntryClasses {\n38|\t\tif class == allowed {\n39|\t\t\treturn true\n40|\t\t}\n41|\t}\n42|\treturn false\n43|}\n44|\n45|var rawManifestMembers = map[string]bool{\n46|\t\"schema\":                   true,\n47|\t\"schema_version\":           true,\n48|\t\"raw_object_manifest_id\":   true,\n49|\t\"operation_id\":             true,\n50|\t\"source_environment\":       true,\n51|\t\"source_native_session_id\": true,\n52|\t\"source_identity_digest\":   true,\n53|\t\"capture_plan_digest\":      true,\n54|\t\"entries\":                  true,\n55|\t\"total_bytes\":              true,\n56|\t\"extensions\":               true,\n57|}\n58|\n59|var rawManifestRequired = []string{\n60|\t\"schema\",\n61|\t\"schema_version\",\n62|\t\"raw_object_manifest_id\",\n63|\t\"operation_id\",\n64|\t\"source_environment\",\n65|\t\"source_native_session_id\",\n66|\t\"source_identity_digest\",\n67|\t\"capture_plan_digest\",\n68|\t\"entries\",\n69|\t\"total_bytes\",\n70|\t\"extensions\",\n71|}\n72|\n73|var rawEntryMembers = map[string]bool{\n74|\t\"native_item_key\":    true,\n75|\t\"class\":              true,\n76|\t\"byte_count\":         true,\n77|\t\"blob_id\":            true,\n78|\t\"blob_descriptor_id\": true,\n79|}\n80|\n81|var rawEntryRequired = []string{\n82|\t\"native_item_key\",\n83|\t\"class\",\n84|\t\"byte_count\",\n85|\t\"blob_id\",\n86|\t\"blob_descriptor_id\",\n87|}\n88|\n89|// RawObjectEntry is one validated raw object entry.\n90|type RawObjectEntry struct {\n91|\tNativeItemKey    string\n92|\tClass            string\n93|\tByteCount        uint64\n94|\tBlobID           scalar.Digest\n95|\tBlobDescriptorID scalar.Digest\n96|}\n97|\n98|// RawObjectManifest is one validated Clone Raw Object Manifest.\n99|type RawObjectManifest struct {\n100|\tManifestID            scalar.Digest\n101|\tOperationID           scalar.UUIDv7\n102|\tSourceEnvironment     sessadapter.Tuple\n103|\tSourceNativeSessionID string\n104|\tSourceIdentityDigest  scalar.Digest\n105|\tCapturePlanDigest     scalar.Digest\n106|\tEntries               []RawObjectEntry\n107|\tTotalBytes            uint64\n108|}\n109|\n110|// EntryInput is one caller-supplied raw entry candidate for Build.\n111|// Descriptor carries the exact Section 10.2 Blob Descriptor bytes\n112|// the entry references; Build verifies the descriptor's closed\n113|// shape and identity and its blob-ID/byte-count agreement before\n114|// the entry is admitted.\n115|type EntryInput struct {\n116|\tNativeItemKey string\n117|\tClass         string\n118|\tByteCount     uint64\n119|\tBlobID        string\n120|\tDescriptorID  string\n121|\tDescriptor    []byte\n122|}\n123|\n124|// BuildRawObjectManifest constructs one closed Clone Raw Object\n125|// Manifest as canonical bytes. Identical inputs produce\n126|// byte-identical outputs. Every closed-shape rule is a refusal:\n127|// unknown classes, unsanitized or excluded native keys, unsorted or\n128|// duplicate entries, descriptor disagreement, and total-byte\n129|// mismatch are all refused, never repaired.\n130|func BuildRawObjectManifest(\n131|\toperationID string,\n132|\tsourceEnvironment []byte,\n133|\tsourceNativeSessionID string,\n134|\tsourceIdentityDigest string,\n135|\tcapturePlanDigest string,\n136|\tinputs []EntryInput,\n137|\textensions map[string]any,\n138|) ([]byte, error) {\n139|\toperation, err := scalar.ParseUUIDv7(operationID)\n140|\tif err != nil {\n141|\t\treturn nil, invalid(\"raw object manifest operation_id is not a UUIDv7: %v\", err)\n142|\t}\n143|\ttuple, err := sessadapter.DecodeTuple(json.RawMessage(sourceEnvironment))\n144|\tif err != nil {\n145|\t\treturn nil, invalid(\"raw object manifest source_environment is not an Environment Tuple: %v\", err)\n146|\t}\n147|\tif len(sourceNativeSessionID) < 1 || len(sourceNativeSessionID) > 512 {\n148|\t\treturn nil, invalid(\"raw object manifest source_native_session_id is not a string[1..512]\")\n149|\t}\n150|\tif err := SanitizeNativeKey(sourceNativeSessionID); err != nil {\n151|\t\treturn nil, err\n152|\t}\n153|\tidentityDigest, err := scalar.ParseDigest(sourceIdentityDigest)\n154|\tif err != nil {\n155|\t\treturn nil, invalid(\"raw object manifest source_identity_digest is not a digest: %v\", err)\n156|\t}\n157|\tplanDigest, err := scalar.ParseDigest(capturePlanDigest)\n158|\tif err != nil {\n159|\t\treturn nil, invalid(\"raw object manifest capture_plan_digest is not a digest: %v\", err)\n160|\t}\n161|\tif len(inputs) > 65536 {\n162|\t\treturn nil, invalid(\"raw object manifest carries %d entries, maximum is 65536\", len(inputs))\n163|\t}\n164|\tentries, total, err := buildRawEntries(inputs)\n165|\tif err != nil {\n166|\t\treturn nil, err\n167|\t}\n168|\textensionBytes, err := encodeExtensions(extensions)\n169|\tif err != nil {\n170|\t\treturn nil, err\n171|\t}\n172|\t_ = extensionBytes\n173|\tobject := map[string]any{\n174|\t\t\"schema\":                   rawManifestSchema,\n175|\t\t\"schema_version\":           rawManifestVersion,\n176|\t\t\"operation_id\":             operation.String(),\n177|\t\t\"source_environment\":       tupleObject(tuple),\n178|\t\t\"source_native_session_id\": sourceNativeSessionID,\n179|\t\t\"source_identity_digest\":   identityDigest.String(),\n180|\t\t\"capture_plan_digest\":      planDigest.String(),\n181|\t\t\"entries\":                  rawEntryObjects(entries),\n182|\t\t\"total_bytes\":              total,\n183|\t\t\"extensions\":               extensionValue(extensions),\n184|\t}\n185|\tomitted, err := canonicalizeObject(object)\n186|\tif err != nil {\n187|\t\treturn nil, err\n188|\t}\n189|\tmanifestID := scalar.SHA256Digest(omitted)\n190|\tobject[rawManifestSelf] = manifestID.String()\n191|\treturn canonicalizeObject(object)\n192|}\n193|\n194|func buildRawEntries(inputs []EntryInput) ([]RawObjectEntry, uint64, error) {\n195|\tentries := make([]RawObjectEntry, 0, len(inputs))\n196|\tprevious := \"\"\n197|\tvar total uint64\n198|\tfor index, input := range inputs {\n199|\t\tif len(input.NativeItemKey) < 1 || len(input.NativeItemKey) > 512 {\n200|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] native_item_key is not a string[1..512]\", index)\n201|\t\t}\n202|\t\tif err := SanitizeNativeKey(input.NativeItemKey); err != nil {\n203|\t\t\treturn nil, 0, err\n204|\t\t}\n205|\t\tif err := refuseExcludedMember(\"raw object entry\", input.NativeItemKey, index); err != nil {\n206|\t\t\treturn nil, 0, err\n207|\t\t}\n208|\t\tif !validRawEntryClass(input.Class) {\n209|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] class %q is outside the raw subset\", index, input.Class)\n210|\t\t}\n211|\t\tif input.ByteCount > maxUint53 {\n212|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] byte_count exceeds uint53\", index)\n213|\t\t}\n214|\t\tblobID, err := scalar.ParseDigest(input.BlobID)\n215|\t\tif err != nil {\n216|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] blob_id is not a digest: %v\", index, err)\n217|\t\t}\n218|\t\tdescriptorID, err := scalar.ParseDigest(input.DescriptorID)\n219|\t\tif err != nil {\n220|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] blob_descriptor_id is not a digest: %v\", index, err)\n221|\t\t}\n222|\t\tif err := VerifyDescriptorAgreement(input.Descriptor, blobID, input.ByteCount); err != nil {\n223|\t\t\treturn nil, 0, invalid(\"raw object entry[%d]: %v\", index, err)\n224|\t\t}\n225|\t\tif total > maxUint53-input.ByteCount {\n226|\t\t\treturn nil, 0, invalid(\"raw object manifest total_bytes exceeds uint53\")\n227|\t\t}\n228|\t\ttotal += input.ByteCount\n229|\t\tif index > 0 && input.NativeItemKey <= previous {\n230|\t\t\treturn nil, 0, invalid(\"raw object manifest entries are not sorted unique by native item key\")\n231|\t\t}\n232|\t\tprevious = input.NativeItemKey\n233|\t\tentries = append(entries, RawObjectEntry{\n234|\t\t\tNativeItemKey:    input.NativeItemKey,\n235|\t\t\tClass:            input.Class,\n236|\t\t\tByteCount:        input.ByteCount,\n237|\t\t\tBlobID:           blobID,\n238|\t\t\tBlobDescriptorID: descriptorID,\n239|\t\t})\n240|\t}\n241|\treturn entries, total, nil\n242|}\n243|\n244|// refuseExcludedMember is the row-21 exclusion allowlist: a native\n245|// key matching hosttrust.MatchExcludedFromReplication or\n246|// hosttrust.ExcludedConfigDirName is trust-adjacent material that\n247|// must never enter a clone bundle, so construction refuses it. The\n248|// owner names the calling shape (raw entry, capture item) so the\n249|// refusal identifies the exact member.\n250|func refuseExcludedMember(owner, key string, index int) error {\n251|\tif hosttrust.MatchExcludedFromReplication(key) {\n252|\t\treturn invalid(\"%s[%d] native key %q is excluded from replication\", owner, index, key)\n253|\t}\n254|\tif hosttrust.ExcludedConfigDirName(key) {\n255|\t\treturn invalid(\"%s[%d] native key %q is trust-adjacent config material\", owner, index, key)\n256|\t}\n257|\treturn nil\n258|}\n259|\n260|// DecodeRawObjectManifest validates one closed Clone Raw Object\n261|// Manifest: exact members, schema/version, self-digest agreement,\n262|// tuple, sanitized source identity, sorted unique entries, and a\n263|// total equal to the sum of entry byte counts.\n264|func DecodeRawObjectManifest(data []byte) (RawObjectManifest, error) {\n265|\tmembers, fault := decodeStrictObject(data)\n266|\tif fault != nil {\n267|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest %s (%s)\", fault.detail, memberField(fault.member))\n268|\t}\n269|\tif name, unknown := unknownMember(members, rawManifestMembers); unknown {\n270|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest carries unknown member %q\", name)\n271|\t}\n272|\tif name, missing := missingMember(members, rawManifestRequired); missing {\n273|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest misses a required member %q\", name)\n274|\t}\n275|\tschema, ok := rawString(members[\"schema\"])\n276|\tif !ok || schema != rawManifestSchema {\n277|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest schema is not the clone raw object manifest\")\n278|\t}\n279|\tversion, ok := rawString(members[\"schema_version\"])\n280|\tif !ok || version != rawManifestVersion {\n281|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest version is not 1.0.0\")\n282|\t}\n283|\tmanifestID, ok := checkDigest(members[rawManifestSelf])\n284|\tif !ok {\n285|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest raw_object_manifest_id is not a digest\")\n286|\t}\n287|\toperation, ok := checkUUIDv7(members[\"operation_id\"])\n288|\tif !ok {\n289|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest operation_id is not a UUIDv7\")\n290|\t}\n291|\ttuple, err := sessadapter.DecodeTuple(members[\"source_environment\"])\n292|\tif err != nil {\n293|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest source_environment is not an Environment Tuple: %v\", err)\n294|\t}\n295|\tnativeID, ok := checkStringBounds(members[\"source_native_session_id\"], 1, 512)\n296|\tif !ok {\n297|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest source_native_session_id is not a string[1..512]\")\n298|\t}\n299|\tif err := SanitizeNativeKey(nativeID); err != nil {\n300|\t\treturn RawObjectManifest{}, err\n301|\t}\n302|\tidentityDigest, ok := checkDigest(members[\"source_identity_digest\"])\n303|\tif !ok {\n304|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest source_identity_digest is not a digest\")\n305|\t}\n306|\tplanDigest, ok := checkDigest(members[\"capture_plan_digest\"])\n307|\tif !ok {\n308|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest capture_plan_digest is not a digest\")\n309|\t}\n310|\tentries, total, err := decodeRawEntries(members[\"entries\"])\n311|\tif err != nil {\n312|\t\treturn RawObjectManifest{}, err\n313|\t}\n314|\tclaimed, ok := rawUint53(members[\"total_bytes\"])\n315|\tif !ok {\n316|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest total_bytes is not a uint53\")\n317|\t}\n318|\tif claimed != total {\n319|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest total_bytes is %d, entries sum to %d\", claimed, total)\n320|\t}\n321|\tif !checkExtensions(members[\"extensions\"]) {\n322|\t\treturn RawObjectManifest{}, invalid(\"raw object manifest extensions are not reverse-DNS keyed\")\n323|\t}\n324|\tif err := verifySelfDigest(members, rawManifestSelf, manifestID); err != nil {\n325|\t\treturn RawObjectManifest{}, err\n326|\t}\n327|\treturn RawObjectManifest{\n328|\t\tManifestID:            manifestID,\n329|\t\tOperationID:           operation,\n330|\t\tSourceEnvironment:     tuple,\n331|\t\tSourceNativeSessionID: nativeID,\n332|\t\tSourceIdentityDigest:  identityDigest,\n333|\t\tCapturePlanDigest:     planDigest,\n334|\t\tEntries:               entries,\n335|\t\tTotalBytes:            total,\n336|\t}, nil\n337|}\n338|\n339|func decodeRawEntries(raw json.RawMessage) ([]RawObjectEntry, uint64, error) {\n340|\telements, ok := decodeArray(raw)\n341|\tif !ok {\n342|\t\treturn nil, 0, invalid(\"raw object manifest entries are not an array\")\n343|\t}\n344|\tif len(elements) > 65536 {\n345|\t\treturn nil, 0, invalid(\"raw object manifest carries %d entries, maximum is 65536\", len(elements))\n346|\t}\n347|\tentries := make([]RawObjectEntry, 0, len(elements))\n348|\tprevious := \"\"\n349|\tvar total uint64\n350|\tfor index, element := range elements {\n351|\t\tmembers, fault := decodeStrictObject(bytesTrimSpace(element))\n352|\t\tif fault != nil {\n353|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] %s (%s)\", index, fault.detail, memberField(fault.member))\n354|\t\t}\n355|\t\tif name, unknown := unknownMember(members, rawEntryMembers); unknown {\n356|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] carries unknown member %q\", index, name)\n357|\t\t}\n358|\t\tif name, missing := missingMember(members, rawEntryRequired); missing {\n359|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] misses a required member %q\", index, name)\n360|\t\t}\n361|\t\tkey, ok := checkStringBounds(members[\"native_item_key\"], 1, 512)\n362|\t\tif !ok {\n363|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] native_item_key is not a string[1..512]\", index)\n364|\t\t}\n365|\t\tif err := SanitizeNativeKey(key); err != nil {\n366|\t\t\treturn nil, 0, err\n367|\t\t}\n368|\t\tif err := refuseExcludedMember(\"raw object entry\", key, index); err != nil {\n369|\t\t\treturn nil, 0, err\n370|\t\t}\n371|\t\tclass, ok := rawString(members[\"class\"])\n372|\t\tif !ok || !validRawEntryClass(class) {\n373|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] class %q is outside the raw subset\", index, class)\n374|\t\t}\n375|\t\tcount, ok := rawUint53(members[\"byte_count\"])\n376|\t\tif !ok {\n377|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] byte_count is not a uint53\", index)\n378|\t\t}\n379|\t\tblobID, ok := checkDigest(members[\"blob_id\"])\n380|\t\tif !ok {\n381|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] blob_id is not a digest\", index)\n382|\t\t}\n383|\t\tdescriptorID, ok := checkDigest(members[\"blob_descriptor_id\"])\n384|\t\tif !ok {\n385|\t\t\treturn nil, 0, invalid(\"raw object entry[%d] blob_descriptor_id is not a digest\", index)\n386|\t\t}\n387|\t\tif total > maxUint53-count {\n388|\t\t\treturn nil, 0, invalid(\"raw object manifest total_bytes exceeds uint53\")\n389|\t\t}\n390|\t\ttotal += count\n391|\t\tif index > 0 && key <= previous {\n392|\t\t\treturn nil, 0, invalid(\"raw object manifest entries are not sorted unique by native item key\")\n393|\t\t}\n394|\t\tprevious = key\n395|\t\tentries = append(entries, RawObjectEntry{\n396|\t\t\tNativeItemKey:    key,\n397|\t\t\tClass:            class,\n398|\t\t\tByteCount:        count,\n399|\t\t\tBlobID:           blobID,\n400|\t\t\tBlobDescriptorID: descriptorID,\n401|\t\t})\n402|\t}\n403|\treturn entries, total, nil\n404|}\n405|\n406|// VerifyRawManifestDescriptors re-checks descriptor agreement for a\n407|// decoded manifest: every entry's blob ID and byte count must agree\n408|// with the fetched Section 10.2 Blob Descriptor bytes. Decode\n409|// validates structure; this entry validates evidence.\n410|func VerifyRawManifestDescriptors(manifest RawObjectManifest, fetch func(descriptorID string) ([]byte, error)) error {\n411|\tfor index, entry := range manifest.Entries {\n412|\t\tdescriptor, err := fetch(entry.BlobDescriptorID.String())\n413|\t\tif err != nil {\n414|\t\t\treturn invalid(\"raw object entry[%d]: descriptor fetch failed: %v\", index, err)\n415|\t\t}\n416|\t\tif len(descriptor) == 0 {\n417|\t\t\treturn invalid(\"raw object entry[%d]: descriptor is absent\", index)\n418|\t\t}\n419|\t\tif err := VerifyDescriptorAgreement(descriptor, entry.BlobID, entry.ByteCount); err != nil {\n420|\t\t\treturn invalid(\"raw object entry[%d]: %v\", index, err)\n421|\t\t}\n422|\t}\n423|\treturn nil\n424|}\n425|\n426|// IdentityDigest computes the terminal digest of canonical sanitized\n427|// NativeIdentity bytes: the source_identity_digest production entry.\n428|func IdentityDigest(identity NativeIdentity, extensions map[string]any) (scalar.Digest, error) {\n429|\tif err := SanitizeNativeKey(identity.NativeSessionID); err != nil {\n430|\t\treturn scalar.Digest{}, err\n431|\t}\n432|\tencoded, err := EncodeNativeIdentity(identity, extensions)\n433|\tif err != nil {\n434|\t\treturn scalar.Digest{}, err\n435|\t}\n436|\treturn scalar.SHA256Digest(encoded), nil\n437|}\n438|\n439|func tupleObject(tuple sessadapter.Tuple) map[string]any {\n440|\treturn map[string]any{\n441|\t\t\"environment_id\":           tuple.EnvironmentID,\n442|\t\t\"environment_version\":      tuple.Version,\n443|\t\t\"platform\":                 tuple.Platform,\n444|\t\t\"architecture\":             tuple.Architecture,\n445|\t\t\"store_schema_fingerprint\": tuple.StoreFingerprint,\n446|\t\t\"adapter_version\":          tuple.AdapterVersion,\n447|\t}\n448|}\n449|\n450|func rawEntryObjects(entries []RawObjectEntry) []any {\n451|\tobjects := make([]any, 0, len(entries))\n452|\tfor _, entry := range entries {\n453|\t\tobjects = append(objects, map[string]any{\n454|\t\t\t\"native_item_key\":    entry.NativeItemKey,\n455|\t\t\t\"class\":              entry.Class,\n456|\t\t\t\"byte_count\":         entry.ByteCount,\n457|\t\t\t\"blob_id\":            entry.BlobID.String(),\n458|\t\t\t\"blob_descriptor_id\": entry.BlobDescriptorID.String(),\n459|\t\t})\n460|\t}\n461|\treturn objects\n462|}\n463|\n464|func extensionValue(extensions map[string]any) map[string]any {\n465|\tif extensions == nil {\n466|\t\treturn map[string]any{}\n467|\t}\n468|\treturn extensions\n469|}\n470|\n471|func encodeExtensions(extensions map[string]any) ([]byte, error) {\n472|\tvalue := extensionValue(extensions)\n473|\tplain, err := json.Marshal(value)\n474|\tif err != nil {\n475|\t\treturn nil, invalid(\"extensions are not JSON: %v\", err)\n476|\t}\n477|\tif !checkExtensions(json.RawMessage(plain)) {\n478|\t\treturn nil, invalid(\"extensions are not reverse-DNS keyed\")\n479|\t}\n480|\treturn plain, nil\n481|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c66b","stream":{"kind":"session","id":"01a0b0cc-369a-7993-946b-ef774181fd54"},"sequence":400,"recorded_at":1780531400000795,"record_type":"event","durability":"durable","causation_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","run_stream":{"kind":"run","id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3"},"call_id":"call_01a0b0cd0d41779c8ee8b9d8ebc39001","text":"Read text file `internal/clonebundle/blobref.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"io\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/localstore\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// This file owns the Section 10.2 raw evidence descriptor path: Blob\n13|// Descriptor identity and byte-count agreement, and no-replace blob\n14|// installation through the landed localstore durable-write\n15|// discipline. This package performs no durable write itself: every\n16|// byte crosses localstore.ObjectStore.PutBlob, whose no-replace,\n17|// fsync, and crash/idempotency evidence is cited in TRACEABILITY.md.\n18|\n19|// BlobAgreement is the verified agreement between a manifest entry\n20|// and its Section 10.2 Blob Descriptor.\n21|type BlobAgreement struct {\n22|\tDescriptorID scalar.Digest\n23|\tBlobID       scalar.Digest\n24|\tSize         uint64\n25|}\n26|\n27|// VerifyDescriptorAgreement verifies one raw evidence descriptor:\n28|// the bytes must be a closed valid Blob Descriptor 1.0.0 whose\n29|// claimed identity equals the computed omit-self digest, and the\n30|// descriptor's blob ID and size must agree with the manifest\n31|// entry's claim. Shape validation and digest computation run\n32|// through the canonicaljson owner, never a fork; the claim\n33|// comparison is local, because binding attestation outside the\n34|// session leaf is refused by the provhost no-attestation bound, so\n35|// this package never calls the attesting entry.\n36|func VerifyDescriptorAgreement(descriptor []byte, wantBlobID scalar.Digest, wantSize uint64) error {\n37|\tcalculated, claimed, members, err := calculateDescriptorIdentity(descriptor)\n38|\tif err != nil {\n39|\t\treturn err\n40|\t}\n41|\tif calculated != claimed {\n42|\t\treturn invalid(\"blob descriptor claim %q does not match omit-self digest %q\", claimed.String(), calculated.String())\n43|\t}\n44|\tblobID, ok := checkDigest(members[\"blob_id\"])\n45|\tif !ok {\n46|\t\treturn invalid(\"blob descriptor blob_id is not a digest\")\n47|\t}\n48|\tif blobID != wantBlobID {\n49|\t\treturn invalid(\"blob descriptor blob_id %q disagrees with entry claim %q\", blobID.String(), wantBlobID.String())\n50|\t}\n51|\tsize, ok := rawUint53(members[\"size\"])\n52|\tif !ok {\n53|\t\treturn invalid(\"blob descriptor size is not a uint53\")\n54|\t}\n55|\tif size != wantSize {\n56|\t\treturn invalid(\"blob descriptor size %d disagrees with entry claim %d\", size, wantSize)\n57|\t}\n58|\treturn nil\n59|}\n60|\n61|// InstallRawBlob installs one raw evidence blob through the landed\n62|// durable-write discipline: fsync, size/digest verification, and\n63|// atomic no-replace install owned by localstore. It returns the\n64|// verified agreement. A digest collision or same-ID/different-bytes\n65|// observation quarantines through the store owner; this package\n66|// adds no second write path.\n67|func InstallRawBlob(store *localstore.ObjectStore, descriptor []byte, source io.Reader) (BlobAgreement, error) {\n68|\tcalculated, claimed, members, err := calculateDescriptorIdentity(descriptor)\n69|\tif err != nil {\n70|\t\treturn BlobAgreement{}, err\n71|\t}\n72|\tif calculated != claimed {\n73|\t\treturn BlobAgreement{}, invalid(\"blob descriptor claim %q does not match omit-self digest %q\", claimed.String(), calculated.String())\n74|\t}\n75|\tblobID, ok := checkDigest(members[\"blob_id\"])\n76|\tif !ok {\n77|\t\treturn BlobAgreement{}, invalid(\"blob descriptor blob_id is not a digest\")\n78|\t}\n79|\tsize, ok := rawUint53(members[\"size\"])\n80|\tif !ok {\n81|\t\treturn BlobAgreement{}, invalid(\"blob descriptor size is not a uint53\")\n82|\t}\n83|\tif store == nil {\n84|\t\treturn BlobAgreement{}, invalid(\"blob install requires an object store\")\n85|\t}\n86|\tif _, err := store.PutBlob(blobID, size, source); err != nil {\n87|\t\treturn BlobAgreement{}, invalid(\"blob install refused: %v\", err)\n88|\t}\n89|\treturn BlobAgreement{DescriptorID: calculated, BlobID: blobID, Size: size}, nil\n90|}\n91|\n92|// calculateDescriptorIdentity runs the owner's shape validation and\n93|// omit-self computation over one descriptor and reads its claimed\n94|// self digest. Callers compare the two; this helper never attests.\n95|func calculateDescriptorIdentity(descriptor []byte) (scalar.Digest, scalar.Digest, map[string]json.RawMessage, error) {\n96|\tcalculated, field, err := canonicaljson.CalculateObjectIdentity(descriptor)\n97|\tif err != nil {\n98|\t\treturn scalar.Digest{}, scalar.Digest{}, nil, invalid(\"blob descriptor identity fails: %v\", err)\n99|\t}\n100|\tif field != \"descriptor_id\" {\n101|\t\treturn scalar.Digest{}, scalar.Digest{}, nil, invalid(\"blob descriptor self field is %q, want descriptor_id\", string(field))\n102|\t}\n103|\tvar members map[string]json.RawMessage\n104|\tif err := json.Unmarshal(descriptor, &members); err != nil {\n105|\t\treturn scalar.Digest{}, scalar.Digest{}, nil, invalid(\"blob descriptor is not an object: %v\", err)\n106|\t}\n107|\tclaimed, ok := checkDigest(members[\"descriptor_id\"])\n108|\tif !ok {\n109|\t\treturn scalar.Digest{}, scalar.Digest{}, nil, invalid(\"blob descriptor descriptor_id is not a digest\")\n110|\t}\n111|\treturn calculated, claimed, members, nil\n112|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c66d","stream":{"kind":"session","id":"01a0b0cc-369a-7993-946b-ef774181fd54"},"sequence":401,"recorded_at":1780531400000797,"record_type":"event","durability":"durable","causation_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3","run_stream":{"kind":"run","id":"c76039bf-a435-41d5-be3c-7dbf6b953ab3"},"call_id":"call_01a0b0cd0f1b7063a35565255263f756","text":"Read text file `internal/clonebundle/decode.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"strings\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// This file holds parse-only helpers for every Section 13.14.1 closed\n15|// shape. Helpers report verdicts; every refusal is constructed at the\n16|// deciding site with a literal detail so each rule stays a distinct\n17|// gate. Strict object decoding and extension admission delegate to the\n18|// landed environ owner; tuple decoding delegates to sessadapter at the\n19|// call site.\n20|\n21|const maxUint53 = uint64(1<<53 - 1)\n22|\n23|type frameFault struct {\n24|\tdetail string\n25|\tmember string\n26|}\n27|\n28|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n29|\tmembers, fault := environ.DecodeStrictObject(data)\n30|\tif fault != nil {\n31|\t\treturn nil, &frameFault{detail: fault.Detail, member: fault.Member}\n32|\t}\n33|\treturn members, nil\n34|}\n35|\n36|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n37|\tfor name := range members {\n38|\t\tif !allowed[name] {\n39|\t\t\treturn name, true\n40|\t\t}\n41|\t}\n42|\treturn \"\", false\n43|}\n44|\n45|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n46|\tfor _, name := range required {\n47|\t\tif _, present := members[name]; !present {\n48|\t\t\treturn name, true\n49|\t\t}\n50|\t}\n51|\treturn \"\", false\n52|}\n53|\n54|func rawString(raw json.RawMessage) (string, bool) {\n55|\tvar value string\n56|\tif err := json.Unmarshal(raw, &value); err != nil {\n57|\t\treturn \"\", false\n58|\t}\n59|\treturn value, true\n60|}\n61|\n62|func rawBool(raw json.RawMessage) (bool, bool) {\n63|\tvar value bool\n64|\tif err := json.Unmarshal(raw, &value); err != nil {\n65|\t\treturn false, false\n66|\t}\n67|\treturn value, true\n68|}\n69|\n70|// rawUint53 reads an unsigned integral JSON number in [0, 2^53-1]. A\n71|// fraction, exponent, sign, or out-of-range magnitude is not a uint53.\n72|func rawUint53(raw json.RawMessage) (uint64, bool) {\n73|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n74|\tdecoder.UseNumber()\n75|\tvar value any\n76|\tif err := decoder.Decode(&value); err != nil {\n77|\t\treturn 0, false\n78|\t}\n79|\tif _, err := decoder.Token(); err != io.EOF {\n80|\t\treturn 0, false\n81|\t}\n82|\tnumber, ok := value.(json.Number)\n83|\tif !ok {\n84|\t\treturn 0, false\n85|\t}\n86|\tliteral := number.String()\n87|\tif literal == \"\" || strings.ContainsAny(literal, \".eE+-\") {\n88|\t\treturn 0, false\n89|\t}\n90|\treturn parseUint53Literal(literal)\n91|}\n92|\n93|func parseUint53Literal(literal string) (uint64, bool) {\n94|\tif literal == \"\" || (len(literal) > 1 && literal[0] == '0') {\n95|\t\treturn 0, false\n96|\t}\n97|\tvar value uint64\n98|\tfor i := 0; i < len(literal); i++ {\n99|\t\tdigit := literal[i]\n100|\t\tif digit < '0' || digit > '9' {\n101|\t\t\treturn 0, false\n102|\t\t}\n103|\t\tvalue = value*10 + uint64(digit-'0')\n104|\t\tif value > maxUint53 {\n105|\t\t\treturn 0, false\n106|\t\t}\n107|\t}\n108|\treturn value, true\n109|}\n110|\n111|// stringLength counts UTF-8 bytes, the unit every Section 13.14.1\n112|// string bound uses.\n113|func stringLength(value string) int {\n114|\treturn len(value)\n115|}\n116|\n117|func checkStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n118|\tvalue, ok := rawString(raw)\n119|\tif !ok {\n120|\t\treturn \"\", false\n121|\t}\n122|\tlength := stringLength(value)\n123|\tif length < minimum || length > maximum {\n124|\t\treturn \"\", false\n125|\t}\n126|\treturn value, true\n127|}\n128|\n129|func checkDigest(raw json.RawMessage) (scalar.Digest, bool) {\n130|\tvalue, ok := rawString(raw)\n131|\tif !ok {\n132|\t\treturn scalar.Digest{}, false\n133|\t}\n134|\tdigest, err := scalar.ParseDigest(value)\n135|\tif err != nil {\n136|\t\treturn scalar.Digest{}, false\n137|\t}\n138|\treturn digest, true\n139|}\n140|\n141|func checkUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n142|\tvalue, ok := rawString(raw)\n143|\tif !ok {\n144|\t\treturn scalar.UUIDv7{}, false\n145|\t}\n146|\tid, err := scalar.ParseUUIDv7(value)\n147|\tif err != nil {\n148|\t\treturn scalar.UUIDv7{}, false\n149|\t}\n150|\treturn id, true\n151|}\n152|\n153|func checkTimestamp(raw json.RawMessage) (scalar.Timestamp, bool) {\n154|\tvalue, ok := rawString(raw)\n155|\tif !ok {\n156|\t\treturn scalar.Timestamp{}, false\n157|\t}\n158|\tstamp, err := scalar.ParseTimestamp(value)\n159|\tif err != nil {\n160|\t\treturn scalar.Timestamp{}, false\n161|\t}\n162|\treturn stamp, true\n163|}\n164|\n165|func bytesTrimSpace(raw json.RawMessage) json.RawMessage {\n166|\treturn json.RawMessage(bytes.TrimSpace(raw))\n167|}\n168|\n169|func isNull(raw json.RawMessage) bool {\n170|\ttrimmed := bytes.TrimSpace(raw)\n171|\treturn string(trimmed) == \"null\"\n172|}\n173|\n174|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n175|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n176|\ttoken, err := decoder.Token()\n177|\tif err != nil {\n178|\t\treturn nil, false\n179|\t}\n180|\tdelimiter, ok := token.(json.Delim)\n181|\tif !ok || delimiter != '[' {\n182|\t\treturn nil, false\n183|\t}\n184|\tvar elements []json.RawMessage\n185|\tfor decoder.More() {\n186|\t\tvar element json.RawMessage\n187|\t\tif err := decoder.Decode(&element); err != nil {\n188|\t\t\treturn nil, false\n189|\t\t}\n190|\t\telements = append(elements, element)\n191|\t}\n192|\ttoken, err = decoder.Token()\n193|\tif err != nil {\n194|\t\treturn nil, false\n195|\t}\n196|\tdelimiter, ok = token.(json.Delim)\n197|\tif !ok || delimiter != ']' {\n198|\t\treturn nil, false\n199|\t}\n200|\tif _, err := decoder.Token(); err != io.EOF {\n201|\t\treturn nil, false\n202|\t}\n203|\tif elements == nil {\n204|\t\telements = []json.RawMessage{}\n205|\t}\n206|\treturn elements, true\n207|}\n208|\n209|// checkSortedUniqueStrings validates sorted unique string arrays with\n210|// per-item byte bounds and array count bounds. Bytewise order is Go\n211|// string order over UTF-8 bytes; strict increase proves sortedness\n212|// and uniqueness together.\n213|func checkSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n214|\telements, ok := decodeArray(raw)\n215|\tif !ok {\n216|\t\treturn nil, false\n217|\t}\n218|\tcount := uint64(len(elements))\n219|\tif count < minimumCount || count > maximumCount {\n220|\t\treturn nil, false\n221|\t}\n222|\tvalues := make([]string, 0, len(elements))\n223|\tprevious := \"\"\n224|\tfor index, element := range elements {\n225|\t\tvalue, ok := rawString(element)\n226|\t\tif !ok {\n227|\t\t\treturn nil, false\n228|\t\t}\n229|\t\tlength := stringLength(value)\n230|\t\tif length < minimumLength || length > maximumLength {\n231|\t\t\treturn nil, false\n232|\t\t}\n233|\t\tif index > 0 && value <= previous {\n234|\t\t\treturn nil, false\n235|\t\t}\n236|\t\tprevious = value\n237|\t\tvalues = append(values, value)\n238|\t}\n239|\treturn values, true\n240|}\n241|\n242|func checkSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\n243|\telements, ok := decodeArray(raw)\n244|\tif !ok {\n245|\t\treturn nil, false\n246|\t}\n247|\tcount := uint64(len(elements))\n248|\tif count < minimumCount || count > maximumCount {\n249|\t\treturn nil, false\n250|\t}\n251|\tvalues := make([]scalar.Digest, 0, len(elements))\n252|\tprevious := \"\"\n253|\tfor index, element := range elements {\n254|\t\tdigest, ok := checkDigest(element)\n255|\t\tif !ok {\n256|\t\t\treturn nil, false\n257|\t\t}\n258|\t\ttext := digest.String()\n259|\t\tif index > 0 && text <= previous {\n260|\t\t\treturn nil, false\n261|\t\t}\n262|\t\tprevious = text\n263|\t\tvalues = append(values, digest)\n264|\t}\n265|\treturn values, true\n266|}\n267|\n268|func checkExtensions(raw json.RawMessage) bool {\n269|\treturn environ.CheckExtensions(raw)\n270|}\n271|\n272|// canonicalizeObject renders one closed object deterministically: the\n273|// members marshal in any order and the JCS transform sorts them, so\n274|// identical logical inputs always produce identical bytes.\n275|func canonicalizeObject(object map[string]any) ([]byte, error) {\n276|\tplain, err := json.Marshal(object)\n277|\tif err != nil {\n278|\t\treturn nil, invalid(\"serialize clone bundle object: %v\", err)\n279|\t}\n280|\tcanonical, err := canonicaljson.Canonicalize(plain)\n281|\tif err != nil {\n282|\t\treturn nil, invalid(\"canonicalize clone bundle object: %v\", err)\n283|\t}\n284|\treturn canonical, nil\n285|}\n286|\n287|// omitSelfDigest computes the JCS SHA-256 identity of members with\n288|// only the self field omitted. It mirrors the canonicaljson\n289|// omit-self construction without routing through that package's\n290|// closed-shape registry, which refuses these schemas by design (see\n291|// doc.go).\n292|func omitSelfDigest(members map[string]json.RawMessage, selfField string) (scalar.Digest, error) {\n293|\tomitted := make(map[string]any, len(members))\n294|\tfor name, raw := range members {\n295|\t\tif name == selfField {\n296|\t\t\tcontinue\n297|\t\t}\n298|\t\tvar value any\n299|\t\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n300|\t\tdecoder.UseNumber()\n301|\t\tif err := decoder.Decode(&value); err != nil {\n302|\t\t\treturn scalar.Digest{}, invalid(\"identity input member %s is not JSON: %v\", name, err)\n303|\t\t}\n304|\t\tomitted[name] = value\n305|\t}\n306|\tplain, err := json.Marshal(omitted)\n307|\tif err != nil {\n308|\t\treturn scalar.Digest{}, invalid(\"serialize omit-self object: %v\", err)\n309|\t}\n310|\tcanonical, err := canonicaljson.Canonicalize(plain)\n311|\tif err != nil {\n312|\t\treturn scalar.Digest{}, invalid(\"canonicalize omit-self object: %v\", err)\n313|\t}\n314|\treturn scalar.SHA256Digest(canonical), nil\n315|}\n316|\n317|// verifySelfDigest recomputes the omit-self identity and refuses a\n318|// mismatch against the claimed self digest.\n319|func verifySelfDigest(members map[string]json.RawMessage, selfField string, claimed scalar.Digest) error {\n320|\tcalculated, err := omitSelfDigest(members, selfField)\n321|\tif err != nil {\n322|\t\treturn err\n323|\t}\n324|\tif calculated != claimed {\n325|\t\treturn invalid(\"%s claim %q does not match omit-self digest %q\", selfField, claimed.String(), calculated.String())\n326|\t}\n327|\treturn nil\n328|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
