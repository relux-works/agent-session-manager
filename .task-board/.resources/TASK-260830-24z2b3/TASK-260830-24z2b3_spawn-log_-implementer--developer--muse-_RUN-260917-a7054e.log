t(\"test-capture-plan\"), inputs, nil)\n36|\tverdict2(\"S1 Build raw entry key = 300 chars / 600 bytes (spec admits)\", err)\n37|\ts := validSessionInput()\n38|\ts.Title = strptr(strings.Repeat(\"é\", 3000))\n39|\t_, err = BuildCanonicalSession(s)\n40|\tverdict2(\"S2 Build session title = 3000 chars / 6000 bytes (spec admits)\", err)\n41|\tvalid := mustSessionBytes(t)\n42|\ttampered := tamper(t, valid, func(o map[string]any) { o[\"title\"] = strings.Repeat(\"é\", 3000) })\n43|\t_, err = DecodeCanonicalSession(tampered)\n44|\tverdict2(\"S3 Decode session title = 3000 chars (unsealed; which gate fires?)\", err)\n45|\t_, ok := environ.CheckStringBounds([]byte(`\"`+key+`\"`), 1, 512)\n46|\t_, ok2 := checkStringBounds([]byte(`\"`+key+`\"`), 1, 512)\n47|\tfmt.Printf(\"PROBE S4 environ.CheckStringBounds(300 chars, 1..512) admits=%v; clonebundle checkStringBounds admits=%v\\n\", ok, ok2)\n48|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
