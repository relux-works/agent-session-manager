e_optional\",\n33|\t\"unknown\",\n34|}\n35|\n36|func validRawEntryClass(class string) bool {\n37|\tfor _, allowed := range rawEntryClasses {\n38|\t\tif class == allowed {\n39|\t\t\treturn true\n40|\t\t}\n41|\t}\n42|\treturn false\n43|}\n44|\n45|var rawManifestMembers = map[string]bool{\n46|\t\"schema\":                   true,\n47|\t\"schema_version\":           true,\n48|\t\"raw_object_manifest_id\":   true,\n49|\t\"operation_id\":             true,\n50|\t\"source_environment\":       true,\n51|\t\"source_native_session_id\": true,\n52|\t\"source_identity_digest\":   true,\n53|\t\"capture_plan_digest\":      true,\n54|\t\"entries\":                  true,\n55|\t\"total_bytes\":              true,\n56|\t\"extensions\":               true,\n57|}\n58|\n59|var rawManifestRequired = []string{\n60|\t\"schema\",\n61|\t\"schema_version\",\n62|\t\"raw_object_manifest_id\",\n63|\t\"operation_id\",\n64|\t\"source_environment\",\n65|\t\"source_native_session_id\",\n66|\t\"source_identity_digest\",\n67|\t\"capture_plan_digest\",\n68|\t\"entries\",\n69|\t\"total_bytes\",\n70|\t\"extensions\",\n71|}\n72|\n73|var rawEntryMembers = map[string]bool{\n74|\t\"native_item_key\":    true,\n75|\t\"class\":              true,\n76|\t\"byte_count\":         true,\n77|\t\"blob_id\":            true,\n78|\t\"blob_descriptor_id\": true,\n79|}\n80|\n81|var rawEntryRequired = []string{\n82|\t\"native_item_key\",\n83|\t\"class\",\n84|\t\"byte_count\",\n85|\t\"blob_id\",\n86|\t\"blob_descriptor_id\",\n87|}\n88|\n89|// RawObjectEntry is one validated raw object entry.\n90|type RawObjectEntry struct {\n91|\tNativeItemKey    string\n92|\tClass            string\n93|\tByteCount        uint64\n94|\tBlobID           scalar.Digest\n95|\tBlobDescriptorID scalar.Digest\n96|}\n97|\n98|// RawObjectManifest is one validated Clone Raw Object Manifest.\n99|type RawObjectManifest struct {\n100|\tManifestID            scalar.Digest\n101|\tOperationID           scalar.UUIDv7\n102|\tSourceEnvironment     sessadapter.Tuple\n103|\tSourceNativeSessionID string\n104|\tSourceIdentityDigest  scalar.Digest\n105|\tCapturePlanDigest     scalar.Digest\n106|\tEntries               []RawObjectEntry\n107|\tTotalBytes            uint64\n108|}\n109|\n110|// EntryInput is one caller-supplied raw entry candidate for Build.\n111|// Descriptor carries the exact Section 10.2 Blob Descriptor bytes\n112|// the entry references; Build verifies the descriptor's closed\n113|// shape and identity and its blob-ID/byte-count agreement before\n114|// the entry is admitted.\n115|type EntryInput struct {\n116|\tNativeItemKey string\n117|\tClass         string\n118|\tByteCount     uint64\n119|\tBlobID        string\n120|\tDescriptorID  string\n(more lines below)","final_result":true}}}
