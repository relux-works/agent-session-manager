n WorkspaceBinding{}, invalid(\"workspace binding cwd_relative is not a string[1..4096]\")\n226|\t}\n227|\tif err := checkCwdRelative(cwd); err != nil {\n228|\t\treturn WorkspaceBinding{}, err\n229|\t}\n230|\tfingerprints, ok := checkSortedUniqueDigests(members[\"repository_remote_fingerprints\"], 0, 128)\n231|\tif !ok {\n232|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding repository_remote_fingerprints are not sorted unique digest[0..128]\")\n233|\t}\n234|\tvar branch *string\n235|\tif !isNull(members[\"branch\"]) {\n236|\t\tvalue, ok := checkStringBounds(members[\"branch\"], 1, 1024)\n237|\t\tif !ok {\n238|\t\t\treturn WorkspaceBinding{}, invalid(\"workspace binding branch is not a string[1..1024]\")\n239|\t\t}\n240|\t\tbranch = &value\n241|\t}\n242|\thead, err := checkNullableDigest(members, \"head_digest\", \"workspace binding\")\n243|\tif err != nil {\n244|\t\treturn WorkspaceBinding{}, err\n245|\t}\n246|\tindex, err := checkNullableDigest(members, \"index_digest\", \"workspace binding\")\n247|\tif err != nil {\n248|\t\treturn WorkspaceBinding{}, err\n249|\t}\n250|\ttree, err := checkNullableDigest(members, \"working_tree_digest\", \"workspace binding\")\n251|\tif err != nil {\n252|\t\treturn WorkspaceBinding{}, err\n253|\t}\n254|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n255|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding extensions %s\", extensionsFault)\n256|\t}\n257|\treturn WorkspaceBinding{\n258|\t\tLogicalWorkspaceID: workspaceID,\n259|\t\tCwdRelative:        cwd,\n260|\t\tRemoteFingerprints: fingerprints,\n261|\t\tBranch:             branch,\n262|\t\tHeadDigest:         head,\n263|\t\tIndexDigest:        index,\n264|\t\tWorkingTreeDigest:  tree,\n265|\t}, nil\n266|}\n267|\n268|// checkCwdRelative admits exactly the normalized relative paths\n269|// beneath (or equal to) the Workspace Group root: scalar relative\n270|// paths plus the root itself (\".\"). Anything else — absolute,\n271|// escaped, backslashed, encoded-separator, or dot-segment forms —\n272|// would grant or smuggle filesystem authority and is refused.\n273|func checkCwdRelative(cwd string) error {\n274|\tif cwd == \".\" {\n275|\t\treturn nil\n276|\t}\n277|\tif _, err := scalar.ParseRelativePath(cwd); err != nil {\n278|\t\treturn invalid(\"workspace binding cwd_relative is not normalized beneath the workspace root: %v\", err)\n279|\t}\n280|\treturn nil\n281|}\n282|\n283|func checkNullableDigest(members map[string]json.RawMessage, name, owner string) (*scalar.Digest, error) {\n284|\traw, present := members[name]\n285|\tif !present {\n286|\t\treturn nil, invalid(\"%s misses a required member %q\", owner, name)\n287|\t}\n288|\tif isNull(raw) {\n289|\t\treturn nil, nil\n290|\t}\n291|\tdigest, ok := checkDigest(raw)\n292|\tif !ok {\n293|\t\treturn nil, invalid(\"%s %s is not a digest\", owner, name)\n294|\t}\n295|\treturn &digest, nil\n296|}\n297|\n298|// SanitizeNativeKey refuses every native key that is not sanitized:\n299|// empty values are refused here (over-long values by the caller's\n300|// bound check), and this gate refuses control characters (the full\n301|// Cc class, C0 and C1), invisible format characters (Cf, Zl, Zp:\n302|// zero-width and separator marks that render invisibly),\n303|// absolute-path forms, a UUIDv7 form (indistinguishable from a\n304|// fabricated AX Session identity), embedded-credential forms (a\n305|// password-style colon before the first @, with or without a\n306|// scheme), and AX-schema markers in any case. The pinned text does\n307|// not define the sanitizer's exact scope, so the implemented bound\n308|// is exactly this list, pinned by the sanitizer corpus and stated\n309|// in TRACEABILITY.md: ordinary spaces, @ without a password\n310|// colon, and colons without an @ all admit. A native key that\n311|// survives is printable, relative, and unambiguously native.\n312|func SanitizeNativeKey(key string) error {\n313|\tif key == \"\" {\n314|\t\treturn invalid(\"native key is empty\")\n315|\t}\n316|\tif !utf8.ValidString(key) {\n317|\t\treturn invalid(\"native key is not valid UTF-8\")\n318|\t}\n319|\tfor _, unit := range key {\n320|\t\tif unicode.IsControl(unit) {\n321|\t\t\treturn invalid(\"native key carries control characters\")\n322|\t\t}\n323|\t\tif unicode.Is(unicode.Cf, unit) || unicode.Is(unicode.Zl, unit) || unicode.Is(unicode.Zp, unit) {\n324|\t\t\treturn invalid(\"native key carries invisible format characters\")\n325|\t\t}\n326|\t}\n327|\tif strings.HasPrefix(key, \"/\") || strings.HasPrefix(key, `\\\\`) || hasDrivePrefix(key) {\n328|\t\treturn invalid(\"native key is an absolute source path, never a cross-host identity\")\n329|\t}\n330|\tif _, err := scalar.ParseUUIDv7(key); err == nil {\n331|\t\treturn invalid(\"native key %q is a UUIDv7, indistinguishable from a fabricated AX Session identity\", key)\n332|\t}\n333|\tif strings.Contains(strings.ToLower(key), \"urn:ax:\") {\n334|\t\treturn invalid(\"native key carries an AX identity marker\")\n335|\t}\n336|\tif at := strings.Index(key, \"@\"); at >= 0 && strings.Contains(key[:at], \":\") {\n337|\t\treturn invalid(\"native key carries embedded credentials\")\n338|\t}\n339|\treturn nil\n340|}\n341|\n342|func hasDrivePrefix(value string) bool {\n343|\treturn len(value) >= 3 && ((value[0] >= 'a' && value[0] <= 'z') || (value[0] >= 'A' && value[0] <= 'Z')) && value[1] == ':' && (value[2] == '/' || value[2] == '\\\\')\n344|}\n345|\n346|func memberField(member string) string {\n347|\tif member == \"\" {\n348|\t\treturn \"frame\"\n349|\t}\n350|\treturn \"member \" + member\n351|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c81f","stream":{"kind":"session","id":"01a0b1e4-390b-7943-9137-5d4864ee30d9"},"sequence":618,"recorded_at":1780531400001231,"record_type":"event","durability":"durable","causation_id":"dd82b03b-72d2-4612-983d-4c763e9197c6","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"dd82b03b-72d2-4612-983d-4c763e9197c6","run_stream":{"kind":"run","id":"dd82b03b-72d2-4612-983d-4c763e9197c6"},"call_id":"call_01a0b1e79f187516b36853ebdcf68dac","text":"Read text file `internal/clonebundle/text_test.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"testing\"\n6|)\n7|\n8|// Regression tests for the Section 1.6 text gate: text MUST be valid\n9|// UTF-8, and encoding/json silently rewrites invalid bytes to U+FFFD\n10|// instead of failing — so every Build-side string admission refuses\n11|// invalid UTF-8 before marshaling. Every row drives a production\n12|// entry point and asserts two things: the entry refuses with\n13|// ErrInvalid naming the UTF-8 rule, and no returned bytes carry the\n14|// U+FFFD the marshaler would have substituted. Asserting the sealed\n15|// bytes (not merely the refusal) pins the rewrite-and-continue\n16|// mechanism: under a mutant that re-admits one invalid value, the\n17|// sealed bytes carry U+FFFD and the row fails.\n18|func TestBuildTextMustBeValidUTF8(t *testing.T) {\n19|\treplacement := string(rune(0xFFFD))\n20|\tcases := []struct {\n21|\t\tname  string\n22|\t\tbuild func(t *testing.T) ([]byte, error)\n23|\t}{\n24|\t\t{\"capture_source_identity_native\", func(t *testing.T) ([]byte, error) {\n25|\t\t\tinput := validCaptureInput(t)\n26|\t\t\tinput.SourceIdentity.NativeSessionID = \"native\\xff\"\n27|\t\t\treturn BuildCaptureManifest(input)\n28|\t\t}},\n29|\t\t{\"capture_source_identity_native_lone_surrogate\", func(t *testing.T) ([]byte, error) {\n30|\t\t\tinput := validCaptureInput(t)\n31|\t\t\tinput.SourceIdentity.NativeSessionID = \"native\\xed\\xa0\\x80\"\n32|\t\t\treturn BuildCaptureManifest(input)\n33|\t\t}},\n34|\t\t{\"capture_source_identity_opaque\", func(t *testing.T) ([]byte, error) {\n35|\t\t\tinput := validCaptureInput(t)\n36|\t\t\tinput.SourceIdentity.OpaqueIdentity = strptr(\"op\\xff\")\n37|\t\t\treturn BuildCaptureManifest(input)\n38|\t\t}},\n39|\t\t{\"capture_item_exclusion_reason\", func(t *testing.T) ([]byte, error) {\n40|\t\t\tinput := validCaptureInput(t)\n41|\t\t\tinput.Items[2].ExclusionReason = strptr(\"credential\\xff\")\n42|\t\t\treturn BuildCaptureManifest(input)\n43|\t\t}},\n44|\t\t{\"capture_boundary_generation\", func(t *testing.T) ([]byte, error) {\n45|\t\t\tinput := validCaptureInput(t)\n46|\t\t\tinput.Boundary.Generation = \"g\\xff\"\n47|\t\t\treturn BuildCaptureManifest(input)\n48|\t\t}},\n49|\t\t{\"capture_identity_extensions\", func(t *testing.T) ([]byte, error) {\n50|\t\t\tinput := validCaptureInput(t)\n51|\t\t\tinput.IdentityExtensions = map[string]any{\"com.example.note\": \"v\\xff\"}\n52|\t\t\treturn BuildCaptureManifest(input)\n53|\t\t}},\n54|\t\t{\"capture_item_extensions\", func(t *testing.T) ([]byte, error) {\n55|\t\t\tinput := validCaptureInput(t)\n56|\t\t\tinput.Items[2].Extensions = map[string]any{\"com.example.note\": \"v\\xff\"}\n57|\t\t\treturn BuildCaptureManifest(input)\n58|\t\t}},\n59|\t\t{\"capture_manifest_extensions\", func(t *testing.T) ([]byte, error) {\n60|\t\t\tinput := validCaptureInput(t)\n61|\t\t\tinput.Extensions = map[string]any{\"com.example.note\": \"v\\xff\"}\n62|\t\t\treturn BuildCaptureManifest(input)\n63|\t\t}},\n64|\t\t{\"digest_opaque\", func(t *testing.T) ([]byte, error) {\n65|\t\t\tidentity := fixtureNativeIdentity()\n66|\t\t\tidentity.OpaqueIdentity = strptr(\"op\\xff\")\n67|\t\t\t_, err := IdentityDigest(identity, nil)\n68|\t\t\treturn nil, err\n69|\t\t}},\n70|\t\t{\"digest_native_collision_pair\", func(t *testing.T) ([]byte, error) {\n71|\t\t\tidentity := fixtureNativeIdentity()\n72|\t\t\tidentity.NativeSessionID = \"native\\xfe\"\n73|\t\t\t_, err := IdentityDigest(identity, nil)\n74|\t\t\treturn nil, err\n75|\t\t}},\n76|\t\t{\"session_title\", func(t *testing.T) ([]byte, error) {\n77|\t\t\tinput := validSessionInput()\n78|\t\t\tinput.Title = strptr(\"ti\\xfftle\")\n79|\t\t\treturn BuildCanonicalSession(input)\n80|\t\t}},\n81|\t\t{\"session_actor_name\", func(t *testing.T) ([]byte, error) {\n82|\t\t\tinput := validSessionInput()\n83|\t\t\tinput.Actors[0].Name = strptr(\"na\\xffme\")\n84|\t\t\treturn BuildCanonicalSession(input)\n85|\t\t}},\n86|\t\t{\"session_actor_model\", func(t *testing.T) ([]byte, error) {\n87|\t\t\tinput := validSessionInput()\n88|\t\t\tinput.Actors[0].Model = strptr(\"mo\\xffdel\")\n89|\t\t\treturn BuildCanonicalSession(input)\n90|\t\t}},\n91|\t\t{\"session_extensions\", func(t *testing.T) ([]byte, error) {\n92|\t\t\tinput := validSessionInput()\n93|\t\t\tinput.Extensions = map[string]any{\"com.example.note\": \"v\\xff\"}\n94|\t\t\treturn BuildCanonicalSession(input)\n95|\t\t}},\n96|\t\t{\"event_evidence_native_type\", func(t *testing.T) ([]byte, error) {\n97|\t\t\tinput := validEventInput(\"exact\")\n98|\t\t\tinput.Evidence.NativeType = strptr(\"nt\\xff\")\n99|\t\t\treturn BuildCanonicalEvent(input)\n100|\t\t}},\n101|\t\t{\"event_evidence_reason\", func(t *testing.T) ([]byte, error) {\n102|\t\t\tinput := validEventInput(\"exact\")\n103|\t\t\tinput.Evidence.ReasonCodes = []string{\"rc\\xff\"}\n104|\t\t\treturn BuildCanonicalEvent(input)\n105|\t\t}},\n106|\t\t{\"event_extensions\", func(t *testing.T) ([]byte, error) {\n107|\t\t\tinput := validEventInput(\"exact\")\n108|\t\t\tinput.Extensions = map[string]any{\"com.example.note\": \"v\\xff\"}\n109|\t\t\treturn BuildCanonicalEvent(input)\n110|\t\t}},\n111|\t\t{\"raw_extensions\", func(t *testing.T) ([]byte, error) {\n112|\t\t\treturn BuildRawObjectManifest(fixtureOperationID, []byte(fixtureTupleJSON()),\n113|\t\t\t\t\"native-session-alpha\", fixtureDigest(\"test-identity\"), fixtureDigest(\"test-capture-plan\"),\n114|\t\t\t\tvalidEntryInputs(t), map[string]any{\"com.example.note\": \"v\\xff\"})\n115|\t\t}},\n116|\t\t{\"raw_extensions_nested\", func(t *testing.T) ([]byte, error) {\n117|\t\t\treturn BuildRawObjectManifest(fixtureOperationID, []byte(fixtureTupleJSON()),\n118|\t\t\t\t\"native-session-alpha\", fixtureDigest(\"test-identity\"), fixtureDigest(\"test-capture-plan\"),\n119|\t\t\t\tvalidEntryInputs(t), map[string]any{\"com.example.obj\": map[string]any{\"inner\": []any{\"v\\xff\"}}})\n120|\t\t}},\n121|\t\t{\"raw_extensions_key\", func(t *testing.T) ([]byte, error) {\n122|\t\t\treturn BuildRawObjectManifest(fixtureOperationID, []byte(fixtureTupleJSON()),\n123|\t\t\t\t\"native-session-alpha\", fixtureDigest(\"test-identity\"), fixtureDigest(\"test-capture-plan\"),\n124|\t\t\t\tvalidEntryInputs(t), map[string]any{\"com.example.\\xff\": 1})\n125|\t\t}},\n126|\t\t{\"raw_extensions_struct\", func(t *testing.T) ([]byte, error) {\n127|\t\t\treturn BuildRawObjectManifest(fixtureOperationID, []byte(fixtureTupleJSON()),\n128|\t\t\t\t\"native-session-alpha\", fixtureDigest(\"test-identity\"), fixtureDigest(\"test-capture-plan\"),\n129|\t\t\t\tvalidEntryInputs(t), map[string]any{\"com.example.rec\": struct{ V string }{V: \"v\\xff\"}})\n130|\t\t}},\n131|\t\t{\"parse_generation\", func(t *testing.T) ([]byte, error) {\n132|\t\t\t_, err := ParseGeneration(\"g\\xff\")\n133|\t\t\treturn nil, err\n134|\t\t}},\n135|\t}\n136|\tfor _, tc := range cases {\n137|\t\tt.Run(tc.name, func(t *testing.T) {\n138|\t\t\tsealed, err := tc.build(t)\n139|\t\t\tif err == nil {\n140|\t\t\t\tif bytes.Contains(sealed, []byte(replacement)) {\n141|\t\t\t\t\tt.Fatalf(\"admitted invalid UTF-8 and sealed U+FFFD: %q\", truncateBytes(sealed, 200))\n142|\t\t\t\t}\n143|\t\t\t\tt.Fatalf(\"admitted invalid UTF-8, want ErrInvalid\")\n144|\t\t\t}\n145|\t\t\trequireRefusal(t, err, \"not valid UTF-8\")\n146|\t\t\tif bytes.Contains(sealed, []byte(replacement)) {\n147|\t\t\t\tt.Fatalf(\"refused but returned bytes carrying U+FFFD: %q\", truncateBytes(sealed, 200))\n148|\t\t\t}\n149|\t\t})\n150|\t}\n151|\t// The collision pair refuses on both sides: neither \"native\\xff\"\n152|\t// nor \"native\\xfe\" seals, so the two can no longer collapse to\n153|\t// one byte-identical identity.\n154|\tfor _, key := range []string{\"native\\xff\", \"native\\xfe\"} {\n155|\t\tidentity := fixtureNativeIdentity()\n156|\t\tidentity.NativeSessionID = key\n157|\t\tif _, err := IdentityDigest(identity, nil); err == nil {\n158|\t\t\tt.Fatalf(\"IdentityDigest(%q) admitted, want ErrInvalid\", key)\n159|\t\t}\n160|\t}\n161|}\n162|\n163|func truncateBytes(data []byte, maximum int) []byte {\n164|\tif len(data) > maximum {\n165|\t\treturn data[:maximum]\n166|\t}\n167|\treturn data\n168|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
