{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8c7","stream":{"kind":"session","id":"01a0b1e4-390b-7943-9137-5d4864ee30d9"},"sequence":702,"recorded_at":1780531400001399,"record_type":"event","durability":"durable","causation_id":"dd82b03b-72d2-4612-983d-4c763e9197c6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"dd82b03b-72d2-4612-983d-4c763e9197c6","run_stream":{"kind":"run","id":"dd82b03b-72d2-4612-983d-4c763e9197c6"},"task_stream":{"kind":"task","id":"01a0b1e7-f85f-7a43-9eaf-f1da3aba80cd"},"task_id":"01a0b1e7-f85f-7a43-9eaf-f1da3aba80cd","event":{"kind":"output","task_id":"01a0b1e7-f85f-7a43-9eaf-f1da3aba80cd","chunk":"Read text file `internal/clonebundle/decode.go`.\n(99 line(s) above)\n100|// checkDigest reports whether the member is a digest of the pinned\n101|// sha256 form. It delegates to the environ gate.\n102|func checkDigest(raw json.RawMessage) (scalar.Digest, bool) {\n103|\treturn environ.CheckDigest(raw)\n104|}\n105|\n106|// checkUUIDv7 reports whether the member is a lowercase UUIDv7. It\n107|// delegates to the environ gate.\n108|func checkUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n109|\treturn environ.CheckUUIDv7(raw)\n110|}\n111|\n112|// checkTimestamp reports whether the member is a pinned timestamp.\n113|// It delegates to the environ gate.\n114|func checkTimestamp(raw json.RawMessage) (scalar.Timestamp, bool) {\n115|\treturn environ.CheckTimestamp(raw)\n116|}\n117|\n118|// validText reports whether the value is valid UTF-8 text. Section\n119|// 1.6 requires text to be valid UTF-8, and encoding/json silently\n120|// rewrites invalid bytes to U+FFFD instead of failing — so every\n121|// Build-side string admission runs this gate BEFORE marshaling, and\n122|// refuses what it cannot seal byte-exactly. Without it two distinct\n123|// inputs (e.g. \"native\\xff\" vs \"native\\xfe\") would seal\n124|// byte-identical objects, and a native key would launder past the\n125|// sanitizer's own invalid-UTF-8 refusal. Every refusal is\n126|// constructed at the deciding site with a literal detail.\n127|func validText(value string) bool {\n128|\treturn utf8.ValidString(value)\n129|}\n130|\n131|// validExtensionText reports whether every string under an\n132|// extensions value — keys and string values at any depth, through\n133|// maps, slices, arrays, pointers, interfaces, and exported struct\n134|// fields — is valid UTF-8 text. The build helper runs it before\n135|// marshaling for the same rewrite-and-continue reason as validText:\n136|// a single invalid byte anywhere in the map would otherwise seal as\n137|// U+FFFD. Numbers, booleans, and nulls cross opaquely; values whose\n138|// marshaled form is computed rather than textual (custom\n139|// json.Marshaler implementations) are trusted to render valid text.\n140|func validExtensionText(value any) bool {\n141|\treturn extensionTextValid(reflect.ValueOf(value))\n142|}\n143|\n144|func extensionTextValid(value reflect.Value) bool {\n145|\tif !value.IsValid() {\n146|\t\treturn true\n147|\t}\n148|\tswitch value.Kind() {\n149|\tcase reflect.String:\n150|\t\treturn validText(value.String())\n151|\tcase reflect.Map:\n152|\t\titer := value.MapRange()\n153|\t\tfor iter.Next() {\n154|\t\t\tif !extensionTextValid(iter.Key()) || !extensionTextValid(iter.Value()) {\n155|\t\t\t\treturn false\n156|\t\t\t}\n157|\t\t}\n158|\t\treturn true\n159|\tcase reflect.Slice, reflect.Array:\n160|\t\tfor index := 0; index < value.Len(); index++ {\n161|\t\t\tif !extensionTextValid(value.Index(index)) {\n162|\t\t\t\treturn false\n163|\t\t\t}\n164|\t\t}\n165|\t\treturn true\n166|\tcase reflect.Struct:\n167|\t\town := value.Type()\n168|\t\tfor index := 0; index < value.NumField(); index++ {\n169|\t\t\tif own.Field(index).PkgPath != \"\" {\n170|\t\t\t\tcontinue\n171|\t\t\t}\n172|\t\t\tif !extensionTextValid(value.Field(index)) {\n173|\t\t\t\treturn false\n174|\t\t\t}\n175|\t\t}\n176|\t\treturn true\n177|\tcase reflect.Interface, reflect.Pointer:\n178|\t\tif value.IsNil() {\n179|\t\t\treturn true\n(more lines below)","final_result":true}}}
