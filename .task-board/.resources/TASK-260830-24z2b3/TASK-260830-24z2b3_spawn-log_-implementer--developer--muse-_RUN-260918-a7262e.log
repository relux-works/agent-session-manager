ative|official_import|continuation_context\")\n88|\t}\n89|\tworkspaceID, ok := checkUUIDv7(members[\"logical_workspace_id\"])\n90|\tif !ok {\n91|\t\treturn NativeIdentity{}, invalid(\"native identity logical_workspace_id is not a UUIDv7\")\n92|\t}\n93|\tvar fingerprint *scalar.Digest\n94|\tif !isNull(members[\"backend_realm_fingerprint\"]) {\n95|\t\tdigest, ok := checkDigest(members[\"backend_realm_fingerprint\"])\n96|\t\tif !ok {\n97|\t\t\treturn NativeIdentity{}, invalid(\"native identity backend_realm_fingerprint is not a digest\")\n98|\t\t}\n99|\t\tfingerprint = &digest\n100|\t}\n101|\tvar opaque *string\n102|\tif !isNull(members[\"opaque_identity\"]) {\n103|\t\tvalue, ok := checkStringBounds(members[\"opaque_identity\"], 1, 512)\n104|\t\tif !ok {\n105|\t\t\treturn NativeIdentity{}, invalid(\"native identity opaque_identity is not a string[1..512]\")\n106|\t\t}\n107|\t\tif err := SanitizeNativeKey(value); err != nil {\n108|\t\t\treturn NativeIdentity{}, err\n109|\t\t}\n110|\t\topaque = &value\n111|\t}\n112|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n113|\t\treturn NativeIdentity{}, invalid(\"native identity extensions %s\", extensionsFault)\n114|\t}\n115|\treturn NativeIdentity{\n116|\t\tNativeSessionID:         nativeID,\n117|\t\tIdentityKind:            kind,\n118|\t\tLogicalWorkspaceID:      workspaceID,\n119|\t\tBackendRealmFingerprint: fingerprint,\n120|\t\tOpaqueIdentity:          opaque,\n121|\t}, nil\n122|}\n123|\n124|// EncodeNativeIdentity renders one validated identity as canonical\n125|// bytes under the given extensions. The native session ID and the\n126|// opaque identity are sanitized here, before marshaling —\n127|// encoding/json would otherwise rewrite invalid UTF-8 to U+FFFD and\n128|// the caller's re-decode would only ever see the rewritten bytes,\n129|// laundering a native key past the sanitizer's own refusal and\n130|// sealing two distinct inputs to byte-identical objects. The kind\n