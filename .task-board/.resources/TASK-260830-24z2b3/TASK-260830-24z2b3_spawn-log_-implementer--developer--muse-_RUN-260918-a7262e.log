    selected_names: list[str] = []\n774|    args = list(argv)\n775|    while args:\n776|        if args[0] == \"--log-dir\":\n777|            if len(args) < 2:\n778|                print(\"missing directory for --log-dir\")\n779|                return 2\n780|            log_dir = Path(args[1])\n781|            args = args[2:]\n782|        else:\n783|            selected_names.append(args[0])\n784|            args = args[1:]\n785|    selected = [m for m in MUTANTS if not selected_names or m.name in selected_names]\n786|    if selected_names and len(selected) != len(selected_names):\n787|        unknown = sorted(set(selected_names) - {m.name for m in selected})\n788|        print(f\"unknown mutants: {', '.join(unknown)}\")\n789|        return 2\n790|    if log_dir is not None:\n791|        log_dir.mkdir(parents=True, exist_ok=True)\n792|    failures = 0\n793|    for mutant in selected:\n794|        try:\n795|            line, output, exit_code, elapsed = run_mutant(mutant)\n796|        except subprocess.TimeoutExpired:\n797|            line, output, exit_code, elapsed = f\"ERROR: {mutant.name}: killer timed out\", \"\", -1, 0.0\n798|        print(line, flush=True)\n799|        if log_dir is not None:\n800|            (log_dir / f\"{mutant.name}.log\").write_text(\n801|                f\"# mutant={mutant.name} path={mutant.path} -run={mutant.run}\\n\"\n802|                f\"# exit={exit_code} elapsed={elapsed:.1f}s\\n\"\n803|                f\"# find={mutant.find!r}\\n# replace={mutant.replace!r}\\n---\\n{output}\\n\"\n804|            )\n805|        if not line.startswith(\"ok:\"):\n806|            failures += 1\n807|    return 1 if failures else 0\n808|\n809|\n810|if __name__ == \"__main__\":\n811|    sys.exit(main(sys.argv[1:]))","final_result":true}}}
