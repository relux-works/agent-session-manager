{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c819","stream":{"kind":"session","id":"01a0b1e4-390b-7943-9137-5d4864ee30d9"},"sequence":615,"recorded_at":1780531400001225,"record_type":"event","durability":"durable","causation_id":"dd82b03b-72d2-4612-983d-4c763e9197c6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"dd82b03b-72d2-4612-983d-4c763e9197c6","run_stream":{"kind":"run","id":"dd82b03b-72d2-4612-983d-4c763e9197c6"},"task_stream":{"kind":"task","id":"01a0b1e7-a288-7f33-b0c5-3ac07bb9873f"},"task_id":"01a0b1e7-a288-7f33-b0c5-3ac07bb9873f","event":{"kind":"output","task_id":"01a0b1e7-a288-7f33-b0c5-3ac07bb9873f","chunk":"Read text file `internal/clonebundle/identity.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"strings\"\n6|\t\"unicode\"\n7|\t\"unicode/utf8\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// This file validates the Section 13.14.1 identities: NativeIdentity,\n13|// WorkspaceBinding, and the sanitized native-key admission shared by\n14|// every native key in this package. Sanitized means printable,\n15|// relative, and unambiguously native: never an absolute source path,\n16|// never an AX Session identity, never carrying embedded credentials.\n17|\n18|var nativeIdentityMembers = map[string]bool{\n19|\t\"native_session_id\":         true,\n20|\t\"identity_kind\":             true,\n21|\t\"logical_workspace_id\":      true,\n22|\t\"backend_realm_fingerprint\": true,\n23|\t\"opaque_identity\":           true,\n24|\t\"extensions\":                true,\n25|}\n26|\n27|var nativeIdentityRequired = []string{\n28|\t\"native_session_id\",\n29|\t\"identity_kind\",\n30|\t\"logical_workspace_id\",\n31|\t\"backend_realm_fingerprint\",\n32|\t\"opaque_identity\",\n33|\t\"extensions\",\n34|}\n35|\n36|var nativeIdentityKinds = []string{\n37|\t\"provider_native\",\n38|\t\"official_import\",\n39|\t\"continuation_context\",\n40|}\n41|\n42|func validNativeIdentityKind(kind string) bool {\n43|\tfor _, allowed := range nativeIdentityKinds {\n44|\t\tif kind == allowed {\n45|\t\t\treturn true\n46|\t\t}\n47|\t}\n48|\treturn false\n49|}\n50|\n51|// NativeIdentity is one validated sanitized native identity.\n52|type NativeIdentity struct {\n53|\tNativeSessionID         string\n54|\tIdentityKind            string\n55|\tLogicalWorkspaceID      scalar.UUIDv7\n56|\tBackendRealmFingerprint *scalar.Digest\n57|\tOpaqueIdentity          *string\n58|}\n59|\n60|// DecodeNativeIdentity validates one closed NativeIdentity: exact\n61|// members, the closed identity-kind vocabulary, a sanitized native\n62|// session ID, a UUIDv7 logical workspace, an optional digest realm\n63|// fingerprint, an optional sanitized opaque identity, and\n64|// reverse-DNS extensions. Credential, absolute-path, PID, socket,\n65|// token, and secret-environment material is refused by the shared\n66|// sanitizer, never laundered into an identity.\n67|func DecodeNativeIdentity(raw json.RawMessage) (NativeIdentity, error) {\n68|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n69|\tif fault != nil {\n70|\t\treturn NativeIdentity{}, invalid(\"native identity %s (%s)\", fault.detail, memberField(fault.member))\n71|\t}\n72|\tif name, unknown := unknownMember(members, nativeIdentityMembers); unknown {\n73|\t\treturn NativeIdentity{}, invalid(\"native identity carries unknown member %q\", name)\n74|\t}\n75|\tif name, missing := missingMember(members, nativeIdentityRequired); missing {\n76|\t\treturn NativeIdentity{}, invalid(\"native identity misses a required member %q\", name)\n77|\t}\n78|\tnativeID, ok := checkStringBounds(members[\"native_session_id\"], 1, 512)\n79|\tif !ok {\n80|\t\treturn NativeIdentity{}, invalid(\"native identity native_session_id is not a string[1..512]\")\n81|\t}\n82|\tif err := SanitizeNativeKey(nativeID); err != nil {\n83|\t\treturn NativeIdentity{}, err\n84|\t}\n85|\tkind, ok := rawString(members[\"identity_kind\"])\n86|\tif !ok || !validNativeIdentityKind(kind) {\n87|\t\treturn NativeIdentity{}, invalid(\"native identity kind is outside provider_native|official_import|continuation_context\")\n88|\t}\n89|\tworkspaceID, ok := checkUUIDv7(members[\"logical_workspace_id\"])\n90|\tif !ok {\n91|\t\treturn NativeIdentity{}, invalid(\"native identity logical_workspace_id is not a UUIDv7\")\n92|\t}\n93|\tvar fingerprint *scalar.Digest\n94|\tif !isNull(members[\"backend_realm_fingerprint\"]) {\n95|\t\tdigest, ok := checkDigest(members[\"backend_realm_fingerprint\"])\n96|\t\tif !ok {\n97|\t\t\treturn NativeIdentity{}, invalid(\"native identity backend_realm_fingerprint is not a digest\")\n98|\t\t}\n99|\t\tfingerprint = &digest\n100|\t}\n101|\tvar opaque *string\n102|\tif !isNull(members[\"opaque_identity\"]) {\n103|\t\tvalue, ok := checkStringBounds(members[\"opaque_identity\"], 1, 512)\n104|\t\tif !ok {\n105|\t\t\treturn NativeIdentity{}, invalid(\"native identity opaque_identity is not a string[1..512]\")\n106|\t\t}\n107|\t\tif err := SanitizeNativeKey(value); err != nil {\n108|\t\t\treturn NativeIdentity{}, err\n109|\t\t}\n110|\t\topaque = &value\n111|\t}\n112|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n113|\t\treturn NativeIdentity{}, invalid(\"native identity extensions %s\", extensionsFault)\n114|\t}\n115|\treturn NativeIdentity{\n116|\t\tNativeSessionID:         nativeID,\n117|\t\tIdentityKind:            kind,\n118|\t\tLogicalWorkspaceID:      workspaceID,\n119|\t\tBackendRealmFingerprint: fingerprint,\n120|\t\tOpaqueIdentity:          opaque,\n121|\t}, nil\n122|}\n123|\n124|// EncodeNativeIdentity renders one validated identity as canonical\n125|// bytes under the given extensions. The native session ID and the\n126|// opaque identity are sanitized here, before marshaling —\n127|// encoding/json would otherwise rewrite invalid UTF-8 to U+FFFD and\n128|// the caller's re-decode would only ever see the rewritten bytes,\n129|// laundering a native key past the sanitizer's own refusal and\n130|// sealing two distinct inputs to byte-identical objects. The kind\n131|// refuses invalid UTF-8 here too, so no member the encoder seals is\n132|// ever rewritten. The extensions are validated here as well, so\n133|// encoding never admits what decoding refused. A nil extensions map\n134|// encodes as the empty object.\n135|func EncodeNativeIdentity(identity NativeIdentity, extensions map[string]any) ([]byte, error) {\n136|\tif !validText(identity.IdentityKind) {\n137|\t\treturn nil, invalid(\"native identity kind is not valid UTF-8\")\n138|\t}\n139|\tif err := SanitizeNativeKey(identity.NativeSessionID); err != nil {\n140|\t\treturn nil, err\n141|\t}\n142|\tif identity.OpaqueIdentity != nil {\n143|\t\tif err := SanitizeNativeKey(*identity.OpaqueIdentity); err != nil {\n144|\t\t\treturn nil, err\n145|\t\t}\n146|\t}\n147|\tif _, err := encodeExtensions(extensions); err != nil {\n148|\t\treturn nil, err\n149|\t}\n150|\tvar fingerprint any\n151|\tif identity.BackendRealmFingerprint != nil {\n152|\t\tfingerprint = identity.BackendRealmFingerprint.String()\n153|\t}\n154|\tvar opaque any\n155|\tif identity.OpaqueIdentity != nil {\n156|\t\topaque = *identity.OpaqueIdentity\n157|\t}\n158|\tif extensions == nil {\n159|\t\textensions = map[string]any{}\n160|\t}\n161|\treturn canonicalizeObject(map[string]any{\n162|\t\t\"native_session_id\":         identity.NativeSessionID,\n163|\t\t\"identity_kind\":             identity.IdentityKind,\n164|\t\t\"logical_workspace_id\":      identity.LogicalWorkspaceID.String(),\n165|\t\t\"backend_realm_fingerprint\": fingerprint,\n166|\t\t\"opaque_identity\":           opaque,\n167|\t\t\"extensions\":                extensions,\n168|\t})\n169|}\n170|\n171|var workspaceBindingMembers = map[string]bool{\n172|\t\"logical_workspace_id\":           true,\n173|\t\"cwd_relative\":                   true,\n174|\t\"repository_remote_fingerprints\": true,\n175|\t\"branch\":                         true,\n176|\t\"head_digest\":                    true,\n177|\t\"index_digest\":                   true,\n178|\t\"working_tree_digest\":            true,\n179|\t\"extensions\":                     true,\n180|}\n181|\n182|var workspaceBindingRequired = []string{\n183|\t\"logical_workspace_id\",\n184|\t\"cwd_relative\",\n185|\t\"repository_remote_fingerprints\",\n186|\t\"branch\",\n187|\t\"head_digest\",\n188|\t\"index_digest\",\n189|\t\"working_tree_digest\",\n190|\t\"extensions\",\n191|}\n192|\n193|// WorkspaceBinding is one validated closed workspace binding. No\n194|// member grants filesystem authority: the cwd is a normalized\n195|// relative path beneath the Workspace Group root, never an absolute\n196|// path or an escape.\n197|type WorkspaceBinding struct {\n198|\tLogicalWorkspaceID scalar.UUIDv7\n199|\tCwdRelative        string\n200|\tRemoteFingerprints []scalar.Digest\n201|\tBranch             *string\n202|\tHeadDigest         *scalar.Digest\n203|\tIndexDigest        *scalar.Digest\n204|\tWorkingTreeDigest  *scalar.Digest\n205|}\n206|\n207|// DecodeWorkspaceBinding validates one closed WorkspaceBinding.\n208|func DecodeWorkspaceBinding(raw json.RawMessage) (WorkspaceBinding, error) {\n209|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n210|\tif fault != nil {\n211|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding %s (%s)\", fault.detail, memberField(fault.member))\n212|\t}\n213|\tif name, unknown := unknownMember(members, workspaceBindingMembers); unknown {\n214|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding carries unknown member %q\", name)\n215|\t}\n216|\tif name, missing := missingMember(members, workspaceBindingRequired); missing {\n217|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding misses a required member %q\", name)\n218|\t}\n219|\tworkspaceID, ok := checkUUIDv7(members[\"logical_workspace_id\"])\n220|\tif !ok {\n221|\t\treturn WorkspaceBinding{}, invalid(\"workspac