{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c953","stream":{"kind":"session","id":"01a0b1e4-390b-7943-9137-5d4864ee30d9"},"sequence":772,"recorded_at":1780531400001539,"record_type":"event","durability":"durable","causation_id":"dd82b03b-72d2-4612-983d-4c763e9197c6","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"dd82b03b-72d2-4612-983d-4c763e9197c6","run_stream":{"kind":"run","id":"dd82b03b-72d2-4612-983d-4c763e9197c6"},"call_id":"call_01a0b1e81f5770f28c0897e0ad9e96e4","text":"Read text file `internal/clonebundle/rawmanifest.go`.\n(419 line(s) above)\n420|\t\t\treturn invalid(\"raw object entry[%d]: %v\", index, err)\n421|\t\t}\n422|\t}\n423|\treturn nil\n424|}\n425|\n426|// IdentityDigest computes the terminal digest of canonical sanitized\n427|// NativeIdentity bytes: the source_identity_digest production entry.\n428|// The encoded bytes re-decode before hashing, exactly as\n429|// buildCaptureManifest re-decodes the source identity, so no digest\n430|// is ever sealed over an identity decoding would refuse.\n431|func IdentityDigest(identity NativeIdentity, extensions map[string]any) (scalar.Digest, error) {\n432|\tif err := SanitizeNativeKey(identity.NativeSessionID); err != nil {\n433|\t\treturn scalar.Digest{}, err\n434|\t}\n435|\tencoded, err := EncodeNativeIdentity(identity, extensions)\n436|\tif err != nil {\n437|\t\treturn scalar.Digest{}, err\n438|\t}\n439|\tif _, err := DecodeNativeIdentity(json.RawMessage(encoded)); err != nil {\n440|\t\treturn scalar.Digest{}, invalid(\"native identity digest seals no undecodable identity: %v\", err)\n441|\t}\n442|\treturn scalar.SHA256Digest(encoded), nil\n443|}\n444|\n445|func tupleObject(tuple sessadapter.Tuple) map[string]any {\n446|\treturn map[string]any{\n447|\t\t\"environment_id\":           tuple.EnvironmentID,\n448|\t\t\"environment_version\":      tuple.Version,\n449|\t\t\"platform\":                 tuple.Platform,\n450|\t\t\"architecture\"