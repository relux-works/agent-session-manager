+	}
+	first, err := ParseGeneration("generation-1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, err := ParseGeneration("generation-1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	third, err := ParseGeneration("generation-2")
+	if err != nil {
+		t.Fatal(err)
