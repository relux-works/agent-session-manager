{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c861","stream":{"kind":"session","id":"01a0b01d-7212-75f1-8296-534762977aff"},"sequence":651,"recorded_at":1780531400001297,"record_type":"event","durability":"durable","causation_id":"663d949a-c622-460a-8733-e5cc483c026f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"663d949a-c622-460a-8733-e5cc483c026f","run_stream":{"kind":"run","id":"663d949a-c622-460a-8733-e5cc483c026f"},"call_id":"call_01a0b01f09fb775a8343afd23fdc904e","text":"Read text file `internal/sessadapter/tuple.go`.\n(279 line(s) above)\n280|// exact, semantic, summarized, opaque_preserved, synthesized,\n281|// omitted, unrecoverable. archive_only is a strategy, never a\n282|// disposition.\n283|var fidelityDispositions = []string{\n284|\t\"exact\",\n285|\t\"semantic\",\n286|\t\"summarized\",\n287|\t\"opaque_preserved\",\n288|\t\"synthesized\",\n289|\t\"omitted\",\n290|\t\"unrecoverable\",\n291|}\n292|\n293|// validDisposition reports whether the name is a fidelity\n294|// disposition.\n295|func validDisposition(name string) bool {\n296|\tfor _, disposition := range fidelityDispositions {\n297|\t\tif disposition == name {\n298|\t\t\treturn true\n299|\t\t}\n300|\t}\n301|\treturn false\n302|}\n303|\n304|// captureClasses is the closed nine-class vocabulary Section 13.14.1\n305|// states for CaptureItem: the classes a capture plan may name. The\n306|// count bound on excluded_classes ([0..9]) is not the vocabulary;\n307|// this list is.\n308|var captureClasses = []string{\n309|\t\"durable_payload\",\n310|\t\"durable_index_required\",\n311|\t\"durable_sidecar\",\n312|\t\"derived_cache_optional\",\n313|\t\"credential\",\n314|\t\"machine_auth\",\n315|\t\"runtime_state\",\n316|\t\"transient_lock\",\n317|\t\"unknown\",\n318|}\n319|\n320|// validCaptureClass reports whether the name is a capture class.\n321|func validCaptureClass(name string) bool {\n322|\tfor _, class := range captureClasses {\n323|\t\tif class == name {\n324|\t\t\treturn true\n325|\t\t}\n326|\t}\n327|\treturn false\n328|}\n329|\n330|// tupleArchitectures is the two-architecture tuple vocabulary\n331|// Section 7.8 states. Membership is a table loop so the census\n332|// derives it like every other closed vocabulary.\n333|var tupleArchitectures = []string{\n334|\t\"amd64\",\n335|\t\"arm64\",\n336|}\n337|\n338|// validTupleArchitecture reports whether the name is one of the two\n339|// tuple architectures Section 7.8 states.\n340|func validTupleArchitecture(architecture string) bool {\n341|\tfor _, allowed := range tupleArchitectures {\n342|\t\tif architecture == allowed {\n343|\t\t\treturn true\n344|\t\t}\n345|\t}\n346|\treturn false\n347|}\n348|\n349|// tupleKeyMembers is the exact SupportedEnvironmentTupleKey member\n350|// set: direction, environment, provider_id, candidate_kind,\n351|// executable_sha256, provider_manifest_digest, and\n352|// session_adapter_manifest_digest. Status is not part of the unique\n353|// key, so accepted and revoked rows cannot coexist — which is why\n354|// status lives on the entry, not here.\n355|var tupleKeyMembers = map[string]bool{\n356|\t\"direction\":                       true,\n357|\t\"environment\":                     true,\n358|\t\"provider_id\":                     true,\n359|\t\"candidate_kind\":                  true,\n360|\t\"executable_sha256\":               true,\n361|\t\"provider_manifest_digest\":        true,\n362|\t\"session_adapter_manifest_digest\": true,\n363|}\n364|\n365|// tupleKeyRequired lists tupleKeyMembers in a fixed order.\n366|var tupleKeyRequired = []string{\n367|\t\"direction\",\n368|\t\"environment\",\n369|\t\"provider_id\",\n370|\t\"candidate_kind\",\n371|\t\"executable_sha256\",\n372|\t\"provider_manifest_digest\",\n373|\t\"session_adapter_manifest_digest\",\n374|}\n375|\n376|// TupleKey is one validated registry key.\n377|type TupleKey struct {\n378|\tDirection              Direction\n379|\tEnvironment            Tuple\