\n36|// environ.DecodeStrictObject and translates the fault into the\n37|// package refusal dialect without reimplementing any rule, so the\n38|// two can never drift. The delegated string-walk surrogate gate\n39|// refuses a real lone escape behind an even backslash run and\n40|// admits quoted backslash-u text; the raw byte scan this replaces\n41|// misread the quoted text as a high surrogate and admitted the\n42|// real lone escape behind it. A non-UTF-8 frame, a lone surrogate\n43|// escape, a non-object top level, a duplicated member, or trailing\n44|// data is a fault, never a partial object the caller could mistake\n45|// for a result.\n46|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n47|\tmembers, fault := environ.DecodeStrictObject(data)\n48|\tif fault != nil {\n49|\t\treturn nil, &frameFault{detail: fault.Detail, member: fault.Member}\n50|\t}\n51|\treturn members, nil\n52|}\n53|\n54|// unknownMember names a member outside the closed set, if any. The\n55|// single-unknown fixtures keep the verdict deterministic: with\n56|// several unknowns the map order decides which is named, so tests\n57|// never assert a name from a multi-unknown body.\n58|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n59|\tfor name := range members {\n60|\t\tif !allowed[name] {\n61|\t\t\treturn name, true\n62|\t\t}\n63|\t}\n64|\treturn \"\", false\n65|}\n66|\n67|// missingMember names the first required member with no value, if\n68|// any. The required list is fixed order, so the verdict is\n69|// deterministic for every missing combination.\n70|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n71|\tfor _, name := range required {\n72|\t\tif _, present := members[name]; !present {\n73|\t\t\treturn name, true\n74|\t\t}\n75|\t}\n76|\treturn \"\", false\n77|}\n78|\n79|// rawString reads a JSON string member.\n80|func rawString(raw json.RawMessage) (string, bool) {\n81|\tvar value string\n82|\tif err := json.Unmarshal(raw, &value); err != nil {\n83|\t\treturn \"\", false\n84|\t}\n85|\treturn value, true\n86|}\n87|\n88|// rawBool reads a JSON boolean member.\n89|func rawBool(raw json.RawMessage) (bool, bool) {\n90|\tvar value bool\n91|\tif err := json.Unmarshal(raw, &value); err != nil {\n92|\t\treturn false, false\n93|\t}\n94|\treturn value, true\n95|}\n96|\n97|// rawUint53 reads an unsigned integral JSON number in [0, 2^53-1]. A\n98|// fraction, exponent, sign, or out-of-range magnitude is not a uint53,\n99|// even when it names the same mathematical value: the canonical\n100|// bodies carry counts, never measurements.\n101|func rawUint53(raw json.RawMessage) (uint64, bool) {\n102|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n103|\tdecoder.UseNumber()\n104|\tvar value any\n105|\tif err := decoder.Decode(&value); err != nil {\n106|\t\treturn 0, false\n107|\t}\n108|\t// Decode reads one value and stops: without the trailing\n109|\t// check a hostile slice like `12a` would read as 12. Member\n110|\t// slices arriving through decodeStrictObject can never carry\n111|\t// trailing data, but this entry takes raw slices and must\n112|\t// not trust them.\n113|\tif _, err := decoder.Token(); err != io.EOF {\n114|\t\treturn 0, false\n115|\t}\n116|\tnumber, ok := value.(json.Number)\n117|\tif !ok {\n118|\t\treturn 0, false\n119|\t}\n120|\tliteral := number.String()\n121|\tif literal == \"\" || strings.ContainsAny(literal, \".eE+-\") {\n122|\t\treturn 0, false\n123|\t}\n124|\treturn parseUint53Literal(literal)\n125|}\n126|\n127|// parseUint53Literal reads a digit-only literal without trusting a\n128|// float conversion: the magnitude bound is checked on the digit\n129|// string, so 2^53 is refused even on platforms that could hold it.\n130|func parseUint53Literal(literal string) (uint64, bool) {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
