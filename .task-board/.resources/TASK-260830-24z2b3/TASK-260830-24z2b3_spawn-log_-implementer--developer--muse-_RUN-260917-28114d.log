om replication\", owner, index, key)\n+\t}\n+\tif hosttrust.ExcludedConfigDirName(key) {\n+\t\treturn invalid(\"%s[%d] native key %q is trust-adjacent config material\", owner, index, key)\n+\t}\n+\treturn nil\n+}\n","final_result":true}}}
