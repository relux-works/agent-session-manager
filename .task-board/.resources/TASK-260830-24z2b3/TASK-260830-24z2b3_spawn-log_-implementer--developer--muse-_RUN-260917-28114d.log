{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d84f","stream":{"kind":"session","id":"01a0b01d-7212-75f1-8296-534762977aff"},"sequence":2690,"recorded_at":1780531400005375,"record_type":"event","durability":"durable","causation_id":"663d949a-c622-460a-8733-e5cc483c026f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"663d949a-c622-460a-8733-e5cc483c026f","run_stream":{"kind":"run","id":"663d949a-c622-460a-8733-e5cc483c026f"},"task_stream":{"kind":"task","id":"01a0b03b-15da-7813-9805-14bd30eee020"},"task_id":"01a0b03b-15da-7813-9805-14bd30eee020","event":{"kind":"output","task_id":"01a0b03b-15da-7813-9805-14bd30eee020","chunk":"Read text file `internal/clonebundle/blobref.go`.\n(26 line(s) above)\n27|// VerifyDescriptorAgreement verifies one raw evidence descriptor:\n28|// the bytes must be a closed valid Blob Descriptor 1.0.0 whose\n29|// claimed identity equals the computed omit-self digest, and the\n30|// descriptor's blob ID and size must agree with the manifest\n31|// entry's claim. Shape validation and digest computation run\n32|// through the canonicaljson owner, never a fork; the claim\n33|// comparison is local, because binding attestation outside the\n34|// session leaf is refused by the provhost no-attestation bound, so\n35|// this package never calls the attesting entry.\n36|func VerifyDescriptorAgreement(descriptor []byte, wantBlobID scalar.Digest, wantSize uint64) error {\n37|\tcalculated, claimed, members, err := calculateDescriptorIdentity(descriptor)\n38|\tif err != nil {\n39|\t\treturn err\n40|\t}\n41|\tif calculated != claimed {\n42|\t\treturn invalid(\"blob descriptor claim %q does not match omit-self digest %q\", claimed.String(), calculated.String())\n43|\t}\n44|\t_ = members\n45|\tblobID, ok := checkDigest(members[\"blob_id\"])\n46|\tif !ok {\n47|\t\treturn invalid(\"blob descriptor blob_id is not a digest\")\n48|\t}\n49|\tif blobID != wantBlobID {\n50|\t\treturn invalid(\"blob descriptor blob_id %q disagrees with entry claim %q\", blobID.String(), wantBlobID.String())\n51|\t}\n52|\tsize, ok := rawUint53(members[\"size\"])\n53|\tif !ok {\n54|\t\treturn invalid(\"blob descriptor size is not a uint53\")\n55|\t}\n56|\tif size != wantSize {\n57|\t\treturn invalid(\"blob descriptor size %d disagrees with entry claim %d\", size, wantSize)\n58|\t}\n59|\treturn nil\n60|}\n61|\n62|// InstallRawBlob installs one raw evidence blob through the landed\n63|// durable-write discipline: fsync, size/digest verification, and\n64|// atomic no-replace install owned by localstore. It returns the\n65|// verified agreement. A digest collision or same-ID/different-bytes\n66|// observation quarantines through the store owner; this package\n67|// adds no second write path.\n68|func InstallRawBlob(store *localstore.ObjectStore, descriptor []byte, source io.Reader) (BlobAgreement, error) {\n69|\tcalculated, field, err := canonicaljson.VerifyObjectIdentity(descriptor)\n70|\tif err != nil {\n71|\t\treturn BlobAgreement{}, invalid(\"blob descriptor identity fails: %v\", err)\n72|\t}\n73|\tif field != \"descriptor_id\" {\n74|\t\treturn BlobAgreement{}, invalid(\"blob descriptor self field is %q, want descriptor_id\", string(field))\n75|\t}\n76|\tvar members map[string]json.RawMessage\n77|\tif err := json.Unmarshal(descriptor, &members); err != nil {\n78|\t\treturn BlobAgreement{}, invalid(\"blob descriptor is not an object: %v\", err)\n79|\t}\n80|\tblobID, ok := checkDigest(members[\"blob_id\"])\n81|\tif !ok {\n82|\t\treturn BlobAgreement{}, invalid(\"blob descriptor blob_id is not a digest\")\n83|\t}\n84|\tsize, ok := rawUint53(members[\"size\"])\n85|\tif !ok {\n86|\t\treturn BlobAgreement{}, invalid(\"blob descriptor size is not a uint53\")\n87|\t}\n88|\tif store == nil {\n89|\t\treturn BlobAgreement{}, invalid(\"blob install requires an object store\")\n90|\t}\n91|\tif _, err := store.PutBlob(blobID, size, source); err != nil {\n92|\t\treturn BlobAgreement{}, invalid(\"blob install refused: %v\", err)\n93|\t}\n94|\treturn BlobAgreement{DescriptorID: calculated, BlobID: blobID, Size: size}, nil\n95|}","final_result":true}}}
