{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d81d","stream":{"kind":"session","id":"01a0b01d-7212-75f1-8296-534762977aff"},"sequence":2665,"recorded_at":1780531400005325,"record_type":"event","durability":"durable","causation_id":"663d949a-c622-460a-8733-e5cc483c026f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"663d949a-c622-460a-8733-e5cc483c026f","run_stream":{"kind":"run","id":"663d949a-c622-460a-8733-e5cc483c026f"},"task_stream":{"kind":"task","id":"01a0b03a-fe5a-72e3-9b9d-328f014efdc0"},"task_id":"01a0b03a-fe5a-72e3-9b9d-328f014efdc0","event":{"kind":"output","task_id":"01a0b03a-fe5a-72e3-9b9d-328f014efdc0","chunk":"edited\nchanged lines: lines 27-43\n--- original\n+++ updated\n@@\n-// VerifyDescriptorAgreement verifies one raw evidence descriptor:\n-// the bytes must be a closed valid Blob Descriptor 1.0.0 whose\n-// identity verifies, and the descriptor's blob ID and size must\n-// agree with the manifest entry's claim. Descriptor shape and\n-// identity verify through the canonicaljson owner, never a fork.\n-func VerifyDescriptorAgreement(descriptor []byte, wantBlobID scalar.Digest, wantSize uint64) error {\n-\t_, field, err := canonicaljson.VerifyObjectIdentity(descriptor)\n-\tif err != nil {\n-\t\treturn invalid(\"blob descriptor identity fails: %v\", err)\n-\t}\n-\tif field != \"descriptor_id\" {\n-\t\treturn invalid(\"blob descriptor self field is %q, want descriptor_id\", string(field))\n-\t}\n-\tvar members map[string]json.RawMessage\n-\tif err := json.Unmarshal(descriptor, &members); err != nil {\n-\t\treturn invalid(\"blob descriptor is not an object: %v\", err)\n-\t}\n+// VerifyDescriptorAgreement verifies one raw evidence descriptor:\n+// the bytes must be a closed valid Blob Descriptor 1.0.0 whose\n+// claimed identity equals the computed omit-self digest, and the\n+// descriptor's blob ID and size must agree with the manifest\n+// entry's claim. Shape validation and digest computation run\n+// through the canonicaljson owner, never a fork; the claim\n+// comparison is local, because binding attestation outside the\n+// session leaf is refused by the provhost no-attestation bound, so\n+// this package never calls the attesting entry.\n+func VerifyDescriptorAgreement(descriptor []byte, wantBlobID scalar.Digest, wantSize uint64) error {\n+\tcalculated, claimed, members, err := calculateDescriptorIdentity(descriptor)\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tif calculated != claimed {\n+\t\treturn invalid(\"blob descriptor claim %q does not match omit-self digest %q\", claimed.String(), calculated.String())\n+\t}\n+\t_ = members\n","final_result":true}}}
