{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c717","stream":{"kind":"session","id":"01a0b01d-7212-75f1-8296-534762977aff"},"sequence":486,"recorded_at":1780531400000967,"record_type":"event","durability":"durable","causation_id":"663d949a-c622-460a-8733-e5cc483c026f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"663d949a-c622-460a-8733-e5cc483c026f","run_stream":{"kind":"run","id":"663d949a-c622-460a-8733-e5cc483c026f"},"task_stream":{"kind":"task","id":"01a0b01e-a0df-7100-a522-c59986732f7c"},"task_id":"01a0b01e-a0df-7100-a522-c59986732f7c","event":{"kind":"output","task_id":"01a0b01e-a0df-7100-a522-c59986732f7c","chunk":"Read text file `internal/sessadapter/manifest.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|// This file validates the Section 7.8 Session Adapter Manifest: the\n12|// closed urn:ax:schema:session-adapter-manifest 1.0.0 object a\n13|// manifest operation returns as its success body. The manifest\n14|// declares possible surfaces, not runtime availability; every member\n15|// below is required and the object is closed.\n16|\n17|// manifestSchema is the exact schema identifier the manifest carries.\n18|const manifestSchema = \"urn:ax:schema:session-adapter-manifest\"\n19|\n20|// manifestSchemaVersion is the only manifest version this host accepts.\n21|const manifestSchemaVersion = \"1.0.0\"\n22|\n23|// capabilityOrder is the exact fifteen-name ordered capability\n24|// registry Section 7.8 shows. The manifest and every probe body\n25|// carry exactly these names in this order; a sixteenth name\n26|// advertises a surface the contract never defined, and a missing\n27|// name hides one it did.\n28|var capabilityOrder = []string{\n29|\t\"native_discovery\",\n30|\t\"stable_snapshot\",\n31|\t\"raw_capture\",\n32|\t\"canonical_read\",\n33|\t\"canonical_write\",\n34|\t\"native_read_back\",\n35|\t\"native_resume_plan\",\n36|\t\"official_import\",\n37|\t\"same_environment_lossless_clone\",\n38|\t\"tool_history\",\n39|\t\"usage_history\",\n40|\t\"compaction_history\",\n41|\t\"subagent_graph\",\n42|\t\"opaque_reasoning_roundtrip\",\n43|\t\"workspace_binding\",\n44|}\n45|\n46|// Capabilities returns the Section 7.8 capability registry in order.\n47|// The result is a copy; the registry cannot be mutated through it.\n48|func Capabilities() []string {\n49|\treturn append([]string(nil), capabilityOrder...)\n50|}\n51|\n52|// manifestMembers is the exact required member set DecodeManifest\n53|// accepts: the schema envelope, identity, versioning, platforms, the\n54|// Section 7.8 operation registry in section order, and the\n55|// capability registry above.\n56|var manifestMembers = map[string]bool{\n57|\t\"schema\":                    true,\n58|\t\"schema_version\":            true,\n59|\t\"provider_id\":               true,\n60|\t\"environment_id\":            true,\n61|\t\"display_name\":              true,\n62|\t\"adapter_version\":           true,\n63|\t\"environment_version_range\": true,\n64|\t\"platforms\":                 true,\n65|\t\"operations\":                true,\n66|\t\"capability_names\":          true,\n67|\t\"extensions\":                true,\n68|}\n69|\n70|// manifestRequired lists manifestMembers in a fixed order so a body\n71|// missing several members always names the same one.\n72|var manifestRequired = []string{\n73|\t\"schema\",\n74|\t\"schema_version\",\n75|\t\"provider_id\",\n76|\t\"environment_id\",\n77|\t\"display_name\",\n78|\t\"adapter_version\",\n79|\t\"environment_version_range\",\n80|\t\"platforms\",\n81|\t\"operations\",\n82|\t\"capability_names\",\n83|\t\"extensions\",\n84|}\n85|\n86|// Manifest is the validated Session Adapter Manifest 1.0.0: the\n87|// provider and environment identity plus the ordered registries the\n88|// probe and dispatch layers check. The canonical body is retained\n89|// for the host-computed digest.\n90|type Manifest struct {\n91|\tProviderID     string\n92|\tEnvironmentID  string\n93|\tAdapterVersion string\n94|\tPlatforms      []string\n95|\tOperations     []string\n96|\tCapabilities   []string\n97|\tcanonical      []byte\n98|}\n99|\n100|// Canonical returns the JCS bytes the digest was computed over.\n101|func (manifest Manifest) Canonical() []byte {\n102|\treturn append([]byte(nil), manifest.canonical...)\n103|}\n104|\n105|// DecodeManifest validates one manifest-operation success body as the\n106|// closed Section 7.8 Session Adapter Manifest. A manifest whose\n107|// operations differ from the dispatch registry, or whose capability\n108|// names differ from the registry above, advertises a surface the\n109|// host cannot invoke or hides one it must, so both are refused\n110|// outright.\n111|func DecodeManifest(body []byte) (Manifest, error) {\n112|\tmembers, fault := decodeStrictObject(body)\n113|\tif fault != nil {\n114|\t\tfailure, err := failProtocol(\"adapter manifest \"+fault.detail, fault.member)\n115|\t\tif err != nil {\n116|\t\t\treturn Manifest{}, err\n117|\t\t}\n118|\t\treturn Manifest{}, failure\n119|\t}\n120|\tif name, unknown := unknownMember(members, manifestMembers); unknown {\n121|\t\tfailure, err := failProtocol(\"adapter manifest carries unknown member\", name)\n122|\t\tif err != nil {\n123|\t\t\treturn Manifest{}, err\n124|\t\t}\n125|\t\treturn Manifest{}, failure\n126|\t}\n127|\tif name, missing := missingMember(members, manifestRequired); missing {\n128|\t\tfailure, err := failProtocol(\"adapter manifest misses a required member\", name)\n129|\t\tif err != nil {\n130|\t\t\treturn Manifest{}, err\n131|\t\t}\n132|\t\treturn Manifest{}, failure\n133|\t}\n134|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != manifestSchema {\n135|\t\tfailure, err := failProtocol(\"adapter manifest schema is not the session adapter manifest\", \"schema\")\n136|\t\tif err != nil {\n137|\t\t\treturn Manifest{}, err\n138|\t\t}\n139|\t\treturn Manifest{}, failure\n140|\t}\n141|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != manifestSchemaVersion {\n142|\t\tfailure, err := failProtocol(\"adapter manifest version is not 1.0.0\", \"schema_version\")\n143|\t\tif err != nil {\n144|\t\t\treturn Manifest{}, err\n145|\t\t}\n146|\t\treturn Manifest{}, failure\n147|\t}\n148|\tproviderID, ok := rawString(members[\"provider_id\"])\n149|\tif !ok || !providerIDPattern.MatchString(providerID) {\n150|\t\tfailure, err := failProtocol(\"adapter manifest provider identifier is not a provider-id\", \"provider_id\")\n151|\t\tif err != nil {\n152|\t\t\treturn Manifest{}, err\n153|\t\t}\n154|\t\treturn Manifest{}, failure\n155|\t}\n156|\tenvironmentID, ok := rawString(members[\"environment_id\"])\n157|\tif !ok || !environ.CheckEnvironmentID(environmentID) {\n158|\t\tfailure, err := failProtocol(\"adapter manifest environment identifier is not an environment-id\", \"environment_id\")\n159|\t\tif err != nil {\n160|\t\t\treturn Manifest{}, err\n161|\t\t}\n162|\t\treturn Manifest{}, failure\n163|\t}\n164|\tif _, ok := checkStringBounds(members[\"display_name\"], 1, 128); !ok {\n165|\t\tfailure, err := failProtocol(\"adapter manifest display name is not a string[1..128]\", \"display_name\")\n166|\t\tif err != nil {\n167|\t\t\treturn Manifest{}, err\n168|\t\t}\n169|\t\treturn Manifest{}, failure\n170|\t}\n171|\tadapterVersion, ok := rawString(members[\"adapter_version\"])\n172|\tif !ok || !environ.CheckSemver(adapterVersion) {\n173|\t\tfailure, err := failProtocol(\"adapter manifest adapter version is not SemVer\", \"adapter_version\")\n174|\t\tif err != nil {\n175|\t\t\treturn Manifest{}, err\n176|\t\t}\n177|\t\treturn Manifest{}, failure\n178|\t}\n179|\tif _, ok := checkStringBounds(members[\"environment_version_range\"], 1, 256); !ok {\n180|\t\tfailure, err := failProtocol(\"adapter manifest environment version range is not a non-empty string[1..256]\", \"environment_version_range\")\n181|\t\tif err != nil {\n182|\t\t\treturn Manifest{}, err\n183|\t\t}\n184|\t\treturn Manifest{}, failure\n185|\t}\n186|\tplatforms, ok := checkSortedUniqueStrings(members[\"platforms\"], 1, 16, 1, 4)\n187|\tif !ok {\n188|\t\tfailure, err := failProtocol(\"adapter manifest platforms are not a sorted unique non-empty subset\", \"platforms\")\n189|\t\tif err != nil {\n190|\t\t\treturn Manifest{}, err\n191|\t\t}\n192|\t\treturn Manifest{}, failure\n193|\t}\n194|\tfor _, platform := range platforms {\n195|\t\tif _, err := scalar.ParsePlatform(platform); err != nil {\n196|\t\t\tfailure, faultErr := failProtocol(\"adapter manifest platform is outside linux|macos|windows|wsl2\", \"platforms\")\n197|\t\t\tif faultErr != nil {\n198|\t\t\t\treturn Manifest{}, faultErr\n199|\t\t\t}\n200|\t\t\treturn Manifest{}, failure\n201|\t\t}\n202|\t}\n203|\toperations, ok := checkOperationRegistry(members[\"operations\"])\n204|\tif !ok {\n205|\t\tfailure, err := failProtocol(\"adapter manifest operations are not the complete ordered fourteen-name registry\", \"operations\")\n206|\t\tif err != nil {\n207|\t\t\treturn Manifest{}, err\n208|\t\t}\n209|\t\treturn Manifest{}, failure\n210|\t}\n211|\tcapabilities, ok := checkCapabilityRegistry(members[\"capability_names\"])\n212|\tif !ok {\n213|\t\tfailure, err := failProtocol(\"adapter manifest capability names are not the complete ordered fifteen-name registry\", \"capability_names\")\n214|\t\tif err != nil {\n215|\t\t\treturn Manifest{}, err\n216|\t\t}\n217|\t\treturn Manifest{}, failure\n218|\t}\n219|\tif !checkExtensions(members[\"extensions\"]) {\n220|\t\tfailure, err := failProtocol(\"adapter manifest extensions are not reverse-DNS keyed\", \"extensions\")\n221|\t\tif err != nil {\n222|\t\t\treturn Manifest{}, err\n223|\t\t}\n224|\t\treturn Manifest{}, failure\n225|\t}\n226|\tcanonical, err := canonicaljson.Canonicalize(body)\n227|\tif err != nil {\n228|\t\tfailure, faultErr := failProtocol(\"adapter manifest is not canonical JSON\", \"\")\n229|\t\tif faultErr != nil {\n230|\t\t\treturn Manifest{}, faultErr\n231|\t\t}\n232|\t\treturn Manifest{}, failure\n233|\t}\n234|\treturn Manifest{\n235|\t\tProviderID:     providerID,\n236|\t\tEnvironmentID:  environmentID,\n237|\t\tAdapterVersion: adapterVersion,\n238|\t\tPlatforms:      platforms,\n239|\t\tOperations:     operations,\n240|\t\tCapabilities:   capabilities,\n241|\t\tcanonical:      canonical,\n242|\t}, nil\n243|}\n244|\n245|// checkOperationRegistry reports whether the member is exactly the\n246|// dispatch registry in section order: same names, same positions,\n247|// same length. Sortedness is not the rule here — order is — so the\n248|// comparison is element-wise against operationOrder.\n249|func checkOperationRegistry(raw json.RawMessage) ([]string, bool) {\n250|\telements, ok := decodeArray(raw)\n251|\tif !ok || len(elements) != len(operationOrder) {\n252|\t\treturn nil, false\n253|\t}\n254|\toperations := make([]string, 0, len(elements))\n255|\tfor index, element := range elements {\n256|\t\tname, ok := rawString(element)\n257|\t\tif !ok || name != string(operationOrder[index]) {\n258|\t\t\treturn nil, false\n259|\t\t}\n260|\t\toperations = append(operations, name)\n261|\t}\n262|\treturn operations, true\n263|}\n264|\n265|// checkCapabilityRegistry reports whether the member is exactly the\n266|// fifteen-name capability registry in section order.\n267|func checkCapabilityRegistry(raw json.RawMessage) ([]string, bool) {\n268|\telements, ok := decodeArray(raw)\n269|\tif !ok || len(elements) != len(capabilityOrder) {\n270|\t\treturn nil, false\n271|\t}\n272|\tcapabilities := make([]string, 0, len(elements))\n273|\tfor index, element := range elements {\n274|\t\tname, ok := rawString(element)\n275|\t\tif !ok || name != capabilityOrder[index] {\n276|\t\t\treturn nil, false\n277|\t\t}\n278|\t\tcapabilities = append(capabilities, name)\n279|\t}\n280|\treturn capabilities, true\n281|}\n282|\n283|// ManifestDigest returns the host-computed JCS SHA-256 of the\n284|// validated manifest: the session_adapter_manifest_digest. It is\n285|// computed by the host, never embedded by the adapter, so a\n286|// manifest that names its own digest cannot mint trust.\n287|func ManifestDigest(manifest Manifest) scalar.Digest {\n288|\treturn scalar.SHA256Digest(manifest.canonical)\n289|}","final_result":true}}}
