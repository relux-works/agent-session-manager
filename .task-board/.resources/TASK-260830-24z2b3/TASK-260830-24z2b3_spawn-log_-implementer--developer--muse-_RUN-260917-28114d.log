{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca11","stream":{"kind":"session","id":"01a0b01d-7212-75f1-8296-534762977aff"},"sequence":867,"recorded_at":1780531400001729,"record_type":"event","durability":"durable","causation_id":"663d949a-c622-460a-8733-e5cc483c026f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"663d949a-c622-460a-8733-e5cc483c026f","run_stream":{"kind":"run","id":"663d949a-c622-460a-8733-e5cc483c026f"},"task_stream":{"kind":"task","id":"01a0b020-4fba-7ac1-ab45-1ea3540e5df9"},"task_id":"01a0b020-4fba-7ac1-ab45-1ea3540e5df9","event":{"kind":"output","task_id":"01a0b020-4fba-7ac1-ab45-1ea3540e5df9","chunk":"{\n  \"chunk_id\": \"exec-25-1\",\n  \"command\": \"sed -n '200,250p' internal/canonicaljson/canonical.go; echo \\\"===MAXUINT===\\\"; grep -n \\\"MaxUint53\\\" internal/scalar/*.go | head; echo \\\"===SELF===\\\"; grep -n \\\"clone-raw-object-manifest\\\\|clone-capture-manifest\\\\|canonical-session\\\\|canonical-event\\\" internal/catalog/catalog_gen.go | head; echo \\\"===REVERSE-DNS===\\\"; grep -n \\\"reverseDNSPattern\\\" internal/environ/*.go | head\",\n  \"description\": \"Check canonicalize, catalog, patterns\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"// fixture is quoted from the table row that declares that fixture:\\n//\\n//\\tSPEC.md:292 \\\"A decoder MUST reject a numeric literal at or beyond <code>2^53</code> even if its host language can represent it\\\"\\n//\\tSPEC.md:295 \\\"Implementations MUST NOT round a value and continue.\\\"\\n//\\tSPEC.md:301 NUM-UNSAFE-NUMBER \\\"Reject before identity calculation with <code>incompatible_schema</code>\\\"\\n//\\tSPEC.md:302 NUM-UNSAFE-ROUND \\\"Reject from the JSON number token before conversion to a host double; an implementation that first rounds it to 9007199254740992 is nonconforming\\\"\\n//\\n// NUM-UNSAFE-ROUND describes this implementation exactly: validateAXNumbers\\n// refuses the literal on the json.Number token, before any conversion to a host\\n// double, and it runs inside prepareObjectIdentity before any canonical bytes\\n// exist. It is reached from these exported entry points, each of which refuses\\n// all three literals above with a typed error:\\n//\\n//\\tCalculateObjectIdentity\\n//\\tVerifyObjectIdentity\\n//\\tValidateObservationEvent\\n//\\tValidateObservationStream\\n//\\n// Canonicalize itself carries no such guarantee. It is a byte transform over\\n// whatever RFC 8785 accepts, and this package exports no standalone AX number\\n// validator, so a caller that needs the AX number model must reach it through\\n// one of the entry points named above rather than by canonicalizing first.\\nfunc Canonicalize(input []byte) ([]byte, error) {\\n\\tvalue, err := decodeStrict(input)\\n\\tif err != nil {\\n\\t\\treturn nil, err\\n\\t}\\n\\t// Re-encode the parsed logical value before the JCS transform. This removes\\n\\t// leading/trailing whitespace around primitive top-level values without\\n\\t// changing json.Number tokens or string data.\\n\\tnormalized, err := json.Marshal(value)\\n\\tif err != nil {\\n\\t\\treturn nil, invalidJSON(\\\"serialize logical JSON value: %v\\\", err)\\n\\t}\\n\\tcanonical, err := jcs.Transform(normalized)\\n\\tif err != nil {\\n\\t\\treturn nil, invalidJSON(\\\"canonicalize RFC 8785 value: %v\\\", err)\\n\\t}\\n\\treturn canonical, nil\\n}\\n\\n// CalculateObjectIdentity validates the AX common logical number model,\\n// resolves the one self field from the object's trusted schema/version\\n// contract, omits that field, applies RFC 8785 JCS, and returns the SHA-256\\n// identity. Callers cannot select an arbitrary field to omit, which prevents\\n// self inclusion and digest cycles.\\n//\\n// This is where the AX safe-integer refusal lives, not in Canonicalize: a\\n// literal at or beyond 2^53, or any floating-point literal, is refused here\\n// with ErrInvalidIdentity before canonical bytes are produced. See the DIVISION\\n// OF GUARANTEES note on Canonicalize.\\n===MAXUINT===\\ninternal/scalar/integer.go:12:\\tMaxUint53      uint64 = 9_007_199_254_740_991\\ninternal/scalar/integer.go:59:\\tif value > MaxUint53 {\\ninternal/scalar/scalar_test.go:382:\\tif err := json.Unmarshal([]byte(\\\"9007199254740991\\\"), &uint53); err != nil || uint53.Uint64() != MaxUint53 {\\n===SELF===\\n49:\\t\\t\\t{Name: \\\"Clone Raw Object Manifest\\\", ID: \\\"urn:ax:schema:clone-raw-object-manifest\\\", Versions: []string{\\\"1.0.0\\\"}},\\n50:\\t\\t\\t{Name: \\\"Clone Capture Manifest\\\", ID: \\\"urn:ax:schema:clone-capture-manifest\\\", Versions: []string{\\\"1.0.0\\\"}},\\n52:\\t\\t\\t{Name: \\\"Canonical Session\\\", ID: \\\"urn:ax:schema:canonical-session\\\", Versions: []string{\\\"1.0.0\\\"}},\\n53:\\t\\t\\t{Name: \\\"Canonical Event\\\", ID: \\\"urn:ax:schema:canonical-event\\\", Versions: []string{\\\"1.0.0\\\"}},\\n111:\\t\\t\\t{Name: \\\"Clone Raw Object Manifest\\\", ID: \\\"urn:ax:schema:clone-raw-object-manifest\\\", Versions: []string{\\\"1.0.0\\\"}},\\n112:\\t\\t\\t{Name: \\\"Clone Capture Manifest\\\", ID: \\\"urn:ax:schema:clone-capture-manifest\\\", Versions: []string{\\\"1.0.0\\\"}},\\n114:\\t\\t\\t{Name: \\\"Canonical Session\\\", ID: \\\"urn:ax:schema:canonical-session\\\", Versions: []string{\\\"1.0.0\\\"}},\\n115:\\t\\t\\t{Name: \\\"Canonical Event\\\", ID: \\\"urn:ax:schema:canonical-event\\\", Versions: []string{\\\"1.0.0\\\"}},\\n175:\\t\\t\\t{Name: \\\"Clone Raw Object Manifest\\\", ID: \\\"urn:ax:schema:clone-raw-object-manifest\\\", Versions: []string{\\\"1.0.0\\\"}},\\n176:\\t\\t\\t{Name: \\\"Clone Capture Manifest\\\", ID: \\\"urn:ax:schema:clone-capture-manifest\\\", Versions: []string{\\\"1.0.0\\\"}},\\n===REVERSE-DNS===\\ninternal/environ/census_test.go:143:\\t\\\"reverseDNSPattern\\\":    \\\"extensions-grammar\\\",\\ninternal/environ/census_test.go:268:\\t\\\"extensions-grammar|environ|decode.go|reverseDNSPattern\\\":              true,\\ninternal/environ/census_test.go:269:\\t\\\"extensions-grammar|canonicaljson|closed_shapes.go|reverseDNSPattern\\\": true,\\ninternal/environ/census_test.go:270:\\t\\\"extensions-grammar|provhost|identity_create.go|reverseDNSPattern\\\":    true,\\ninternal/environ/decode.go:351:// reverseDNSPattern is the extensions-key grammar: at least two\\ninternal/environ/decode.go:353:var reverseDNSPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,62}(\\\\.[a-z][a-z0-9-]{0,62})+$`)\\ninternal/environ/decode.go:365:\\t\\tif len(name) < 3 || len(name) > 253 || !reverseDNSPattern.MatchString(name) {\\ninternal/environ/shape_census_test.go:988:\\t\\\"reverseDNSPattern\\\",\\n\",\n  \"original_output_bytes\": 4818,\n  \"original_output_tokens\": 1205,\n  \"truncated\": false\n}","final_result":true}}}
