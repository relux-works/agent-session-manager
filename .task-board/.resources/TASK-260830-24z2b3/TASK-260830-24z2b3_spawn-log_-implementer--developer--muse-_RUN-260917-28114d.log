{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c71f","stream":{"kind":"session","id":"01a0b01d-7212-75f1-8296-534762977aff"},"sequence":490,"recorded_at":1780531400000975,"record_type":"event","durability":"durable","causation_id":"663d949a-c622-460a-8733-e5cc483c026f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"663d949a-c622-460a-8733-e5cc483c026f","run_stream":{"kind":"run","id":"663d949a-c622-460a-8733-e5cc483c026f"},"call_id":"call_01a0b01e9bf9772c9b633e3fcb4b2827","text":"Read text file `internal/canonicaljson/closed_shapes.go`.\n1|package canonicaljson\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"fmt\"\n6|\t\"net/url\"\n7|\tpathpkg \"path\"\n8|\t\"regexp\"\n9|\t\"sort\"\n10|\t\"strconv\"\n11|\t\"strings\"\n12|\t\"unicode\"\n13|\t\"unicode/utf8\"\n14|\n15|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n17|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n18|)\n19|\n20|const (\n21|\tblobSchema             = \"urn:ax:schema:blob\"\n22|\ttransferManifestSchema = \"urn:ax:schema:transfer-manifest\"\n23|\tclosedSchemaVersion    = \"1.0.0\"\n24|\tmaxBlobChunks          = 32_768\n25|\tmaxChunkSize           = 4_194_304\n26|)\n27|\n28|var (\n29|\tmediaTypePattern = regexp.MustCompile(\"^[a-z0-9!#$&^_.+%'*`|~-]+/[a-z0-9!#$&^_.+%'*`|~-]+$\")\n30|\t// SemVer 2.0.0 in full. The pinned document types members `semver` without\n31|\t// spelling out a grammar, so the only defensible reading is the named\n32|\t// standard, which admits prerelease and build metadata. A core-triple-only\n33|\t// pattern would refuse `1.2.3-rc.1`, a version the standard declares valid\n34|\t// and the document never excludes.\n35|\tsemverPattern          = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n36|\treverseDNSPattern      = regexp.MustCompile(`^[a-z][a-z0-9-]{0,62}(\\.[a-z][a-z0-9-]{0,62})+$`)\n37|\tenvironmentNamePattern = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]{0,127}$`)\n38|\tenvironmentIDPattern   = regexp.MustCompile(`^[a-z][a-z0-9.-]{0,63}$`)\n39|\tboardLogicalIDPattern  = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$`)\n40|\tsessionNamePattern     = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$`)\n41|)\n42|\n43|// Subsumed UTF-8 re-checks.\n44|//\n45|// Several validators in this file re-check utf8.ValidString on a value they\n46|// received. Every one of those terms is subsumed: decodeStrict in canonical.go\n47|// refuses input that is not valid UTF-8 before it decodes any value, and it is\n48|// the only place in this package where bytes become Go values, so no decoded\n49|// string or object key can reach a validator here invalid.\n50|//\n51|// They are kept fail-closed rather than deleted because the argument is a\n52|// package-internal invariant, not a property of these functions: an exported\n53|// entry point that accepted an already-decoded map, or a second JSON decoder\n54|// anywhere in the package, would make every one of them false again.\n55|//\n56|// Both conditions are machine-checked in utf8_subsumption_test.go, over a call\n57|// graph derived from the AST. That check is bounded, and the bound is part of\n58|// the claim. It models direct calls, calls to methods declared in this package,\n59|// and dispatch through a function value, which is the shape\n60|// immutableObjectShapeValidators below uses. It models nothing about a callee\n61|// reached by reflection, by a function value handed to another package, or\n62|// through a func-typed struct field, and an entry point built one of those ways\n63|// would leave these guards live while the pin stayed green. The pin narrows how\n64|// such a change can arrive unnoticed; it does not make it impossible, which is\n65|// the reason these terms stay rather than being deleted.\n66|\n67|type immutableObjectShapeValidator func(map[string]any) error\n68|\n69|// immutableObjectShapeValidators is deliberately explicit. The self-identity\n70|// catalog selects the self field, but catalog membership alone does not prove\n71|// that this package implements a schema's complete closed shape. Every\n72|// registered schema/version therefore resolves either to a concrete validator\n73|// or to an explicit refusal. validateImmutableObjectShapeValidators binds this\n74|// table back to the generated registry so a newly registered row cannot fall\n75|// through to extension-only attestation.\n76|var immutableObjectShapeValidators = mustBuildImmutableObjectShapeValidators()\n77|\n78|func mustBuildImmutableObjectShapeValidators() map[schemaIdentityKey]immutableObjectShapeValidator {\n79|\tvalidators := make(map[schemaIdentityKey]immutableObjectShapeValidator)\n80|\tregister := func(schema string, validator immutableObjectShapeValidator, versions ...string) {\n81|\t\tfor _, version := range versions {\n82|\t\t\tkey := schemaIdentityKey{schema: schema, version: version}\n83|\t\t\tif _, duplicate := validators[key]; duplicate {\n84|\t\t\t\tpanic(fmt.Sprintf(\"duplicate immutable-object shape validator for %s@%s\", schema, version))\n85|\t\t\t}\n86|\t\t\tvalidators[key] = validator\n87|\t\t}\n88|\t}\n89|\n90|\t// Complete validators owned by the scoped Sections 10.1-10.4 gate.\n91|\tregister(\"urn:ax:schema:session-record\", validateSessionRecordV1, \"1.0.0\")\n92|\tregister(\"urn:ax:schema:session-record\", validateSessionRecordV2, \"2.0.0\")\n93|\tregister(\"urn:ax:schema:session-record\", validateSessionRecordV3, \"3.0.0\")\n94|\tregister(blobSchema, validateBlobDescriptor, closedSchemaVersion)\n95|\tregister(transferManifestSchema, validateTransferManifest, closedSchemaVersion)\n96|\n97|\t// Complete Section 5 and Section 10.1 core-record validators.\n98|\tregister(\"urn:ax:schema:lease\", validateLeaseRecord, \"1.0.0\")\n99|\tregister(\"urn:ax:schema:workspace-group\", validateWorkspaceGroupRecord, \"1.0.0\")\n100|\tregister(\"urn:ax:schema:provider-identity\", validateProviderIdentityRecord, \"1.0.0\")\n101|\tregister(\"urn:ax:schema:session-event\", validateSessionEventV1, \"1.0.0\")\n102|\tregister(\"urn:ax:schema:session-event\", validateSessionEventV2, \"2.0.0\")\n103|\tregister(\"urn:ax:schema:session-event\", validateSessionEventV3, \"3.0.0\")\n104|\tregister(\"urn:ax:schema:session-event\", validateSessionEventV4, \"4.0.0\")\n105|\tregister(\"urn:ax:schema:checkpoint\", validateCheckpointRecord, \"1.0.0\")\n106|\n107|\t// Remaining Section 10.1 records retain their common-envelope gate before\n108|\t// the public identity surface explicitly refuses an unsupported shape.\n109|\tregister(\"urn:ax:schema:tombstone\", validateUnsupportedRecordEnvelopeShape, \"1.0.0\")\n110|\tregister(\"urn:ax:schema:tombstone-ack\", validateUnsupportedRecordEnvelopeShape, \"1.0.0\")\n111|\n112|\t// The remaining registered identities are recognized for self-field\n113|\t// selection but their schema-specific closed shapes are outside this task.\n114|\t// Explicit refusal is safer and more honest than attesting an opaque object.\n115|\tregister(\"urn:ax:schema:canonical-event\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n116|\t// The three terminal closed schemas are owned by internal/terminalbackend:\n117|\t// this package reaches the owner through its production Parse entries\n118|\t// rather than re-implementing the shape, so the two validators for one\n119|\t// schema cannot drift. The owner's refusal is wrapped as an identity\n120|\t// refusal to keep this package's entry-point contract.\n121|\tregister(\"urn:ax:schema:terminal-backend-manifest\", validateTerminalBackendManifest, \"1.0.0\")\n122|\tregister(\"urn:ax:schema:session-clone-bundle\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n123|\tregister(\"urn:ax:schema:materialization-plan\", rejectUnsupportedImmutableObjectShape, \"1.0.0\", \"2.0.0\")\n124|\tregister(\"urn:ax:schema:session-continuation-plan\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n125|\tregister(\"urn:ax:schema:task-board-bundle\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n126|\tregister(\"urn:ax:schema:materialization-journal\", rejectUnsupportedImmutableObjectShape, \"2.0.0\")\n127|\tregister(\"urn:ax:schema:environment-observation\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n128|\tregister(\"urn:ax:schema:native-session-observation\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n129|\tregister(\"urn:ax:schema:session-inventory-batch\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n130|\tregister(\"urn:ax:schema:conversation-lineage-link\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n131|\tregister(\"urn:ax:schema:session-annotation\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n132|\tregister(\"urn:ax:schema:session-enrichment-profile\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n133|\tregister(\"urn:ax:schema:session-enrichment-job-request\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n134|\tregister(\"urn:ax:schema:session-enrichment-job-receipt\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n135|\tregister(\"urn:ax:schema:session-directory-operation-receipt\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n136|\tregister(\"urn:ax:schema:terminal-backend-probe\", validateTerminalBackendProbe, \"1.0.0\")\n137|\tregister(\"urn:ax:schema:terminal-instance-binding\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n138|\tregister(\"urn:ax:schema:terminal-capability-evidence\", validateTerminalCapabilityEvidence, \"1.0.0\")\n139|\tregister(\"urn:ax:schema:clone-raw-object-manifest\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n140|\tregister(\"urn:ax:schema:clone-capture-manifest\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n141|\tregister(\"urn:ax:schema:canonical-session\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n142|\tregister(\"urn:ax:schema:fidelity-report\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n143|\tregister(\"urn:ax:schema:projection-plan\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n144|\tregister(\"urn:ax:schema:clone-projected-object-manifest\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n145|\tregister(\"urn:ax:schema:clone-read-back-evidence-manifest\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n146|\tregister(\"urn:ax:schema:clone-validation-report\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n147|\tregister(\"urn:ax:schema:migration-checkpoint\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n148|\tregister(\"urn:ax:schema:clone-lineage-receipt\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n149|\tregister(\"urn:ax:schema:supported-environment-tuples\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n150|\n151|\tif err := validateImmutableObjectShapeValidators(validators, catalog.Current().SelfIdentities); err != nil {\n152|\t\tpanic(fmt.Sprintf(\"immutable-object shape validator registry is invalid: %v\", err))\n153|\t}\n154|\treturn validators\n155|}\n156|\n157|func validateImmutableObjectShapeValidators(\n158|\tvalidators map[schemaIdentityKey]immutableObjectShapeValidator,\n159|\tdefinitions []catalog.SelfIdentityContract,\n160|) error {\n161|\texpected := make(map[schemaIdentityKey]struct{})\n162|\tfor _, definition := range definitions {\n163|\t\tfor _, version := range definition.ContractVersions {\n164|\t\t\tkey := schemaIdentityKey{schema: string(definition.ContractID), version: version}\n165|\t\t\texpected[key] = struct{}{}\n166|\t\t\tvalidator, ok := validators[key]\n167|\t\t\tif !ok || validator == nil {\n168|\t\t\t\treturn fmt.Errorf(\"missing immutable-object shape validator for %s@%s\", key.schema, key.version)\n169|\t\t\t}\n170|\t\t}\n171|\t}\n172|\tif len(validators) != len(expected) {\n173|\t\treturn fmt.Errorf(\"immutable-object shape validator table has %d rows, generated registry has %d\", len(validators), len(expected))\n174|\t}\n175|\tfor key := range validators {\n176|\t\tif _, ok := expected[key]; !ok {\n177|\t\t\treturn fmt.Errorf(\"immutable-object shape validator for unregistered schema %s@%s\", key.schema, key.version)\n178|\t\t}\n179|\t}\n180|\treturn nil\n181|}\n182|\n183|// validateImmutableObjectShape is the total closed-shape gate used by both\n184|// object-identity production entries. Registry membership never creates an\n185|// extension-only fall-through: each schema/version has an explicit validator\n186|// or an explicit unsupported-shape refusal.\n187|func validateImmutableObjectShape(object map[string]any) error {\n188|\tschema, err := requiredStringMember(object, \"schema\")\n189|\tif err != nil {\n190|\t\treturn err\n191|\t}\n192|\tversion, err := requiredStringMember(object, \"schema_version\")\n193|\tif err != nil {\n194|\t\treturn err\n195|\t}\n196|\n197|\tvalidator, ok := immutableObjectShapeValidators[schemaIdentityKey{schema: schema, version: version}]\n198|\tif !ok || validator == nil {\n199|\t\treturn invalidIdentity(\"no immutable-object shape validator for %s@%s\", schema, version)\n200|\t}\n201|\treturn validator(object)\n202|}\n203|\n204|func validateSessionRecordV1(object map[string]any) error {\n205|\tif err := requireExactMembers(\"Session Record 1.0.0\", object,\n206|\t\t\"schema\", \"schema_version\", \"record_id\", \"subject_id\", \"session_id\", \"name\", \"kind\",\n207|\t\t\"created_at\", \"created_by_host_id\", \"provider_id\", \"workspace_group_id\", \"execution_profile\",\n208|\t\t\"launch_plan\", \"task_board\", \"fork_provenance\", \"extensions\"); err != nil {\n209|\t\treturn err\n210|\t}\n211|\tsessionID, _, _, err := validateSessionRecordCommon(object, \"1.0.0\")\n212|\tif err != nil {\n213|\t\treturn err\n214|\t}\n215|\treturn validateSessionForkProvenance(object, sessionID)\n216|}\n217|\n218|func validateSessionRecordV2(object map[string]any) error {\n219|\treturn validateSessionRecordWithDerivation(object, \"2.0.0\")\n220|}\n221|\n222|func validateSessionRecordV3(object map[string]any) error {\n223|\treturn validateSessionRecordWithDerivation(object, \"3.0.0\")\n224|}\n225|\n226|func validateSessionRecordWithDerivation(object map[string]any, version string) error {\n227|\tif err := requireExactMembers(\"Session Record 2.0.0 and 3.0.0\", object,\n228|\t\t\"schema\", \"schema_version\", \"record_id\", \"subject_id\", \"session_id\", \"name\", \"kind\",\n229|\t\t\"created_at\", \"created_by_host_id\", \"provider_id\", \"workspace_group_id\", \"execution_profile\",\n230|\t\t\"launch_plan\", \"task_board\", \"derivation_provenance\", \"extensions\"); err != nil {\n231|\t\treturn err\n232|\t}\n233|\tsessionID, providerID, _, err := validateSessionRecordCommon(object, version)\n234|\tif err != nil {\n235|\t\treturn err\n236|\t}\n237|\treturn validateSessionDerivationProvenance(object, version, sessionID, providerID)\n238|}\n239|\n240|func validateSessionRecordCommon(object map[string]any, version string) (string, string, string, error) {\n241|\tif err := requireExactString(object, \"schema\", \"urn:ax:schema:session-record\"); err != nil {\n242|\t\treturn \"\", \"\", \"\", err\n243|\t}\n244|\tif err := requireExactString(object, \"schema_version\", version); err != nil {\n245|\t\treturn \"\", \"\", \"\", err\n246|\t}\n247|\tif err := requireDigest(object, \"record_id\"); err != nil {\n248|\t\treturn \"\", \"\", \"\", err\n249|\t}\n250|\tif err := validateCommonRecordEnvelope(object); err != nil {\n251|\t\treturn \"\", \"\", \"\", err\n252|\t}\n253|\tsubjectID, err := requireUUIDv7(object, \"subject_id\")\n254|\tif err != nil {\n255|\t\treturn \"\", \"\", \"\", err\n256|\t}\n257|\tsessionID, err := requireUUIDv7(object, \"session_id\")\n258|\tif err != nil {\n259|\t\treturn \"\", \"\", \"\", err\n260|\t}\n261|\tif subjectID != sessionID {\n262|\t\treturn \"\", \"\", \"\", invalidIdentity(\"Session Record subject_id must equal session_id\")\n263|\t}\n264|\tname, err := requireString(object, \"name\")\n265|\tif err != nil {\n266|\t\treturn \"\", \"\", \"\", err\n267|\t}\n268|\tif !sessionNamePattern.MatchString(name) {\n269|\t\treturn \"\", \"\", \"\", invalidIdentity(\"Session Record name must match [A-Za-z0-9][A-Za-z0-9._-]{0,63}\")\n270|\t}\n271|\tkind, err := requireEnum(object, \"kind\", \"direct\", \"task_board\")\n272|\tif err != nil {\n273|\t\treturn \"\", \"\", \"\", err\n274|\t}\n275|\tproviderID, err := requireString(object, \"provider_id\")\n276|\tif err != nil {\n277|\t\treturn \"\", \"\", \"\", err\n278|\t}\n279|\tif _, err := scalar.ParseProviderID(providerID); err != nil {\n280|\t\treturn \"\", \"\", \"\", invalidIdentity(\"Session Record provider_id: %v\", err)\n281|\t}\n282|\tif _, err := requireUUIDv7(object, \"workspace_group_id\"); err != nil {\n283|\t\treturn \"\", \"\", \"\", err\n284|\t}\n285|\tif _, err := requireEnum(object, \"execution_profile\", \"standard\", \"yolo\"); err != nil {\n286|\t\treturn \"\", \"\", \"\", err\n287|\t}\n288|\tlaunchPlan, err := requireObject(object, \"launch_plan\")\n289|\tif err != nil {\n290|\t\treturn \"\", \"\", \"\", err\n291|\t}\n292|\tif err := validateSessionLaunchPlan(launchPlan); err != nil {\n293|\t\treturn \"\", \"\", \"\", err\n294|\t}\n295|\tif err := validateSessionTaskBoardReference(object, kind); err != nil {\n296|\t\treturn \"\", \"\", \"\", err\n297|\t}\n298|\treturn sessionID, providerID, kind, nil\n299|}\n300|\n301|func validateSessionLaunchPlan(object map[string]any) error {\n302|\tif err := requireExactMembers(\"Session Record Launch Plan\", object,\n303|\t\t\"argv\", \"cwd_workspace_id\", \"cwd_relative\", \"env_names\", \"env_literals\", \"contains_secrets\", \"extensions\"); err != nil {\n304|\t\treturn err\n305|\t}\n306|\targv, err := requireArray(object, \"argv\", 128)\n307|\tif err != nil {\n308|\t\treturn err\n309|\t}\n310|\tif len(argv) == 0 {\n311|\t\treturn invalidIdentity(\"Session Record Launch Plan argv must contain at least one element\")\n312|\t}\n313|\tfor index, value := range argv {\n314|\t\ttext, ok := value.(string)\n315|\t\t// !utf8.ValidString(text) is subsumed by decodeStrict; see the subsumed\n316|\t\t// UTF-8 re-check note above. The other three terms are reachable.\n317|\t\tif !ok || !utf8.ValidString(text) || len(text) == 0 || len(text) > 4096 {\n318|\t\t\treturn invalidIdentity(\"Session Record Launch Plan argv[%d] must contain 1..4096 UTF-8 bytes\", index)\n319|\t\t}\n320|\t}\n321|\tif err := canonicalByteBound(\"Session Record Launch Plan argv\", argv, 65_536); err != nil {\n322|\t\treturn err\n323|\t}\n324|\tif _, err := requireUUIDv7(object, \"cwd_workspace_id\"); err != nil {\n325|\t\treturn err\n326|\t}\n327|\tif err := requireDotOrRelativePath(object, \"cwd_relative\"); err != nil {\n328|\t\treturn err\n329|\t}\n330|\tenvNames, err := requireArray(object, \"env_names\", 64)\n331|\tif err != nil {\n332|\t\treturn err\n333|\t}\n334|\tseenNames := make(map[string]struct{}, len(envNames))\n335|\tprevious := \"\"\n336|\tfor index, value := range envNames {\n337|\t\tname, ok := value.(string)\n338|\t\tif !ok || !environmentNamePattern.MatchString(name) {\n339|\t\t\treturn invalidIdentity(\"Session Record Launch Plan env_names[%d] has invalid environment-name grammar\", index)\n340|\t\t}\n341|\t\tif index > 0 && name <= previous {\n342|\t\t\treturn invalidIdentity(\"Session Record Launch Plan env_names must be strictly sorted and unique\")\n343|\t\t}\n344|\t\tseenNames[name] = struct{}{}\n345|\t\tprevious = name\n346|\t}\n347|\tenvLiterals, err := requireObject(object, \"env_literals\")\n348|\tif err != nil {\n349|\t\treturn err\n350|\t}\n351|\tif len(envLiterals) > 64 {\n352|\t\treturn invalidIdentity(\"Session Record Launch Plan env_literals contains %d members, maximum is 64\", len(envLiterals))\n353|\t}\n354|\tfor name, value := range envLiterals {\n355|\t\tif !environmentNamePattern.MatchString(name) {\n356|\t\t\treturn invalidIdentity(\"Session Record Launch Plan env_literals key %q has invalid environment-name grammar\", name)\n357|\t\t}\n358|\t\tif _, duplicate := seenNames[name]; duplicate {\n359|\t\t\treturn invalidIdentity(\"Session Record Launch Plan environment name %q occurs in both env_names and env_literals\", name)\n360|\t\t}\n361|\t\ttext, ok := value.(string)\n362|\t\t// !utf8.ValidString(text) is subsumed by decodeStrict; see the subsumed\n363|\t\t// UTF-8 re-check note above. The other two terms are reachable.\n364|\t\tif !ok || !utf8.ValidString(text) || len(text) > 4096 {\n365|\t\t\treturn invalidIdentity(\"Session Record Launch Plan env_literals[%q] must contain at most 4096 UTF-8 bytes\", name)\n366|\t\t}\n367|\t}\n368|\tcontainsSecrets, err := requireBool(object, \"contains_secrets\")\n369|\tif err != nil {\n370|\t\treturn err\n371|\t}\n372|\tif containsSecrets {\n373|\t\treturn invalidIdentity(\"Session Record Launch Plan contains_secrets must be false\")\n374|\t}\n375|\textensions, err := requireObject(object, \"extensions\")\n376|\tif err != nil {\n377|\t\treturn err\n378|\t}\n379|\treturn validateExtensionsObject(extensions)\n380|}\n381|\n382|func validateSessionTaskBoardReference(parent map[string]any, kind string) error {\n383|\tvalue, ok := parent[\"task_board\"]\n384|\tif !ok {\n385|\t\treturn invalidIdentity(\"identity input requires member task_board\")\n386|\t}\n387|\tif kind == \"direct\" {\n388|\t\tif value != nil {\n389|\t\t\treturn invalidIdentity(\"direct Session Record task_board must be null\")\n390|\t\t}\n391|\t\treturn nil\n392|\t}\n393|\tobject, err := requireObjectValue(value, \"Session Record task_board\")\n394|\tif err != nil {\n395|\t\treturn err\n396|\t}\n397|\tif err := requireExactMembers(\"Session Record Task-board Reference\", object,\n398|\t\t\"bridge_protocol_version\", \"board\", \"task_element_id\", \"launch_mode\", \"manager_session_ref\",\n399|\t\t\"board_goal\", \"native_goal_binding\", \"extensions\"); err != nil {\n400|\t\treturn err\n401|\t}\n402|\tif err := requireExactString(object, \"bridge_protocol_version\", \"1.0.0\"); err != nil {\n403|\t\treturn err\n404|\t}\n405|\tboard, err := requireObject(object, \"board\")\n406|\tif err != nil {\n407|\t\treturn err\n408|\t}\n409|\tif err := validateSessionBoardIdentity(board); err != nil {\n410|\t\treturn err\n411|\t}\n412|\tif _, err := requirePrintableByteBoundedString(object, \"task_element_id\", 1, 128); err != nil {\n413|\t\treturn err\n414|\t}\n415|\tlaunchMode, err := requireEnum(object, \"launch_mode\", \"primary_owner\", \"tracked_prompt\")\n416|\tif err != nil {\n417|\t\treturn err\n418|\t}\n419|\tif value, ok := object[\"manager_session_ref\"]; !ok || value != nil {\n420|\t\treturn invalidIdentity(\"Session Record Task-board Reference manager_session_ref must be null at creation\")\n421|\t}\n422|\tbinding, err := requireEnum(object, \"native_goal_binding\", \"bound\", \"prompt\", \"none\")\n423|\tif err != nil {\n424|\t\treturn err\n425|\t}\n426|\tgoalValue, ok := object[\"board_goal\"]\n427|\tif !ok {\n428|\t\treturn invalidIdentity(\"identity input requires member board_goal\")\n429|\t}\n430|\tif launchMode == \"primary_owner\" {\n431|\t\tif goalValue == nil || binding != \"bound\" {\n432|\t\t\treturn invalidIdentity(\"primary_owner Task-board Reference requires a board goal and bound native goal\")\n433|\t\t}\n434|\t} else if binding == \"bound\" {\n435|\t\treturn invalidIdentity(\"tracked_prompt Task-board Reference native_goal_binding must be prompt or none\")\n436|\t}\n437|\tif goalValue != nil {\n438|\t\tgoal, err := requireObjectValue(goalValue, \"Session Record board_goal\")\n439|\t\tif err != nil {\n440|\t\t\treturn err\n441|\t\t}\n442|\t\tif err := validateSessionBoardGoal(goal); err != nil {\n443|\t\t\treturn err\n444|\t\t}\n445|\t}\n446|\textensions, err := requireObject(object, \"extensions\")\n447|\tif err != nil {\n448|\t\treturn err\n449|\t}\n450|\treturn validateExtensionsObject(extensions)\n451|}\n452|\n453|func validateSessionBoardIdentity(object map[string]any) error {\n454|\tif err := requireExactMembers(\"Session Record Board Identity\", object, \"kind\", \"logical_id\", \"remote_url\", \"extensions\"); err != nil {\n455|\t\treturn err\n456|\t}\n457|\tkind, err := requireEnum(object, \"kind\", \"local\", \"remote\")\n458|\tif err != nil {\n459|\t\treturn err\n460|\t}\n461|\tlogicalID, err := requireBoundedString(object, \"logical_id\", 1, 128)\n462|\tif err != nil {\n463|\t\treturn err\n464|\t}\n465|\tif !boardLogicalIDPattern.MatchString(logicalID) {\n466|\t\treturn invalidIdentity(\"Session Record Board Identity logical_id has invalid grammar\")\n467|\t}\n468|\tremoteValue, ok := object[\"remote_url\"]\n469|\tif !ok {\n470|\t\treturn invalidIdentity(\"identity input requires member remote_url\")\n471|\t}\n472|\tif kind == \"local\" {\n473|\t\tif remoteValue != nil {\n474|\t\t\treturn invalidIdentity(\"local Session Record Board Identity remote_url must be null\")\n475|\t\t}\n476|\t} else {\n477|\t\tremoteURL, ok := remoteValue.(string)\n478|\t\t// !utf8.ValidString(remoteURL) is subsumed by decodeStrict; see the\n479|\t\t// subsumed UTF-8 re-check note above. The !ok term is reachable.\n480|\t\tif !ok || !utf8.ValidString(remoteURL) {\n481|\t\t\treturn invalidIdentity(\"remote Session Record Board Identity remote_url must be a UTF-8 string\")\n482|\t\t}\n483|\t\tparsed, err := url.Parse(remoteURL)\n484|\t\tif err != nil || parsed.Scheme != \"https\" || parsed.Host == \"\" || parsed.User != nil || parsed.RawQuery != \"\" || parsed.Fragment != \"\" {\n485|\t\t\treturn invalidIdentity(\"remote Session Record Board Identity remote_url must be absolute HTTPS without userinfo, query, or fragment\")\n486|\t\t}\n487|\t}\n488|\textensions, err := requireObject(object, \"extensions\")\n489|\tif err != nil {\n490|\t\treturn err\n491|\t}\n492|\treturn validateExtensionsObject(extensions)\n493|}\n494|\n495|func validateSessionBoardGoal(object map[string]any) error {\n496|\tif err := requireExactMembers(\"Session Record Board Goal\", object, \"schema\", \"goal_id\", \"revision\", \"extensions\"); err != nil {\n497|\t\treturn err\n498|\t}\n499|\tif err := requireExactString(object, \"schema\", \"board-goal-v2\"); err != nil {\n500|\t\treturn err\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c721","stream":{"kind":"session","id":"01a0b01d-7212-75f1-8296-534762977aff"},"sequence":491,"recorded_at":1780531400000977,"record_type":"event","durability":"durable","causation_id":"663d949a-c622-460a-8733-e5cc483c026f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"663d949a-c622-460a-8733-e5cc483c026f","run_stream":{"kind":"run","id":"663d949a-c622-460a-8733-e5cc483c026f"},"call_id":"call_01a0b01e9dee778987b9251fe821d22c","text":"Read text file `internal/sessadapter/manifest.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|// This file validates the Section 7.8 Session Adapter Manifest: the\n12|// closed urn:ax:schema:session-adapter-manifest 1.0.0 object a\n13|// manifest operation returns as its success body. The manifest\n14|// declares possible surfaces, not runtime availability; every member\n15|// below is required and the object is closed.\n16|\n17|// manifestSchema is the exact schema identifier the manifest carries.\n18|const manifestSchema = \"urn:ax:schema:session-adapter-manifest\"\n19|\n20|// manifestSchemaVersion is the only manifest version this host accepts.\n21|const manifestSchemaVersion = \"1.0.0\"\n22|\n23|// capabilityOrder is the exact fifteen-name ordered capability\n24|// registry Section 7.8 shows. The manifest and every probe body\n25|// carry exactly these names in this order; a sixteenth name\n26|// advertises a surface the contract never defined, and a missing\n27|// name hides one it did.\n28|var capabilityOrder = []string{\n29|\t\"native_discovery\",\n30|\t\"stable_snapshot\",\n31|\t\"raw_capture\",\n32|\t\"canonical_read\",\n33|\t\"canonical_write\",\n34|\t\"native_read_back\",\n35|\t\"native_resume_plan\",\n36|\t\"official_import\",\n37|\t\"same_environment_lossless_clone\",\n38|\t\"tool_history\",\n39|\t\"usage_history\",\n40|\t\"compaction_history\",\n41|\t\"subagent_graph\",\n42|\t\"opaque_reasoning_roundtrip\",\n43|\t\"workspace_binding\",\n44|}\n45|\n46|// Capabilities returns the Section 7.8 capability registry in order.\n47|// The result is a copy; the registry cannot be mutated through it.\n48|func Capabilities() []string {\n49|\treturn append([]string(nil), capabilityOrder...)\n50|}\n51|\n52|// manifestMembers is the exact required member set DecodeManifest\n53|// accepts: the schema envelope, identity, versioning, platforms, the\n54|// Section 7.8 operation registry in section order, and the\n55|// capability registry above.\n56|var manifestMembers = map[string]bool{\n57|\t\"schema\":                    true,\n58|\t\"schema_version\":            true,\n59|\t\"provider_id\":               true,\n60|\t\"environment_id\":            true,\n61|\t\"display_name\":              true,\n62|\t\"adapter_version\":           true,\n63|\t\"environment_version_range\": true,\n64|\t\"platforms\":                 true,\n65|\t\"operations\":                true,\n66|\t\"capability_names\":          true,\n67|\t\"extensions\":                true,\n68|}\n69|\n70|// manifestRequired lists manifestMembers in a fixed order so a body\n71|// missing several members always names the same one.\n72|var manifestRequired = []string{\n73|\t\"schema\",\n74|\t\"schema_version\",\n75|\t\"provider_id\",\n76|\t\"environment_id\",\n77|\t\"display_name\",\n78|\t\"adapter_version\",\n79|\t\"environment_version_range\",\n80|\t\"platforms\",\n81|\t\"operations\",\n82|\t\"capability_names\",\n83|\t\"extensions\",\n84|}\n85|\n86|// Manifest is the validated Session Adapter Manifest 1.0.0: the\n87|// provider and environment identity plus the ordered registries the\n88|// probe and dispatch layers check. The canonical body is retained\n89|// for the host-computed digest.\n90|type Manifest struct {\n91|\tProviderID     string\n92|\tEnvironmentID  string\n93|\tAdapterVersion string\n94|\tPlatforms      []string\n95|\tOperations     []string\n96|\tCapabilities   []string\n97|\tcanonical      []byte\n98|}\n99|\n100|// Canonical returns the JCS bytes the digest was computed over.\n101|func (manifest Manifest) Canonical() []byte {\n102|\treturn append([]byte(nil), manifest.canonical...)\n103|}\n104|\n105|// DecodeManifest validates one manifest-operation success body as the\n106|// closed Section 7.8 Session Adapter Manifest. A manifest whose\n107|// operations differ from the dispatch registry, or whose capability\n108|// names differ from the registry above, advertises a surface the\n109|// host cannot invoke or hides one it must, so both are refused\n110|// outright.\n111|func DecodeManifest(body []byte) (Manifest, error) {\n112|\tmembers, fault := decodeStrictObject(body)\n113|\tif fault != nil {\n114|\t\tfailure, err := failProtocol(\"adapter manifest \"+fault.detail, fault.member)\n115|\t\tif err != nil {\n116|\t\t\treturn Manifest{}, err\n117|\t\t}\n118|\t\treturn Manifest{}, failure\n119|\t}\n120|\tif name, unknown := unknownMember(members, manifestMembers); unknown {\n121|\t\tfailure, err := failProtocol(\"adapter manifest carries unknown member\", name)\n122|\t\tif err != nil {\n123|\t\t\treturn Manifest{}, err\n124|\t\t}\n125|\t\treturn Manifest{}, failure\n126|\t}\n127|\tif name, missing := missingMember(members, manifestRequired); missing {\n128|\t\tfailure, err := failProtocol(\"adapter manifest misses a required member\", name)\n129|\t\tif err != nil {\n130|\t\t\treturn Manifest{}, err\n131|\t\t}\n132|\t\treturn Manifest{}, failure\n133|\t}\n134|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != manifestSchema {\n135|\t\tfailure, err := failProtocol(\"adapter manifest schema is not the session adapter manifest\", \"schema\")\n136|\t\tif err != nil {\n137|\t\t\treturn Manifest{}, err\n138|\t\t}\n139|\t\treturn Manifest{}, failure\n140|\t}\n141|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != manifestSchemaVersion {\n142|\t\tfailure, err := failProtocol(\"adapter manifest version is not 1.0.0\", \"schema_version\")\n143|\t\tif err != nil {\n144|\t\t\treturn Manifest{}, err\n145|\t\t}\n146|\t\treturn Manifest{}, failure\n147|\t}\n148|\tproviderID, ok := rawString(members[\"provider_id\"])\n149|\tif !ok || !providerIDPattern.MatchString(providerID) {\n150|\t\tfailure, err := failProtocol(\"adapter manifest provider identifier is not a provider-id\", \"provider_id\")\n151|\t\tif err != nil {\n152|\t\t\treturn Manifest{}, err\n153|\t\t}\n154|\t\treturn Manifest{}, failure\n155|\t}\n156|\tenvironmentID, ok := rawString(members[\"environment_id\"])\n157|\tif !ok || !environ.CheckEnvironmentID(environmentID) {\n158|\t\tfailure, err := failProtocol(\"adapter manifest environment identifier is not an environment-id\", \"environment_id\")\n159|\t\tif err != nil {\n160|\t\t\treturn Manifest{}, err\n161|\t\t}\n162|\t\treturn Manifest{}, failure\n163|\t}\n164|\tif _, ok := checkStringBounds(members[\"display_name\"], 1, 128); !ok {\n165|\t\tfailure, err := failProtocol(\"adapter manifest display name is not a string[1..128]\", \"display_name\")\n166|\t\tif err != nil {\n167|\t\t\treturn Manifest{}, err\n168|\t\t}\n169|\t\treturn Manifest{}, failure\n170|\t}\n171|\tadapterVersion, ok := rawString(members[\"adapter_version\"])\n172|\tif !ok || !environ.CheckSemver(adapterVersion) {\n173|\t\tfailure, err := failProtocol(\"adapter manifest adapter version is not SemVer\", \"adapter_version\")\n174|\t\tif err != nil {\n175|\t\t\treturn Manifest{}, err\n176|\t\t}\n177|\t\treturn Manifest{}, failure\n178|\t}\n179|\tif _, ok := checkStringBounds(members[\"environment_version_range\"], 1, 256); !ok {\n180|\t\tfailure, err := failProtocol(\"adapter manifest environment version range is not a non-empty string[1..256]\", \"environment_version_range\")\n181|\t\tif err != nil {\n182|\t\t\treturn Manifest{}, err\n183|\t\t}\n184|\t\treturn Manifest{}, failure\n185|\t}\n186|\tplatforms, ok := checkSortedUniqueStrings(members[\"platforms\"], 1, 16, 1, 4)\n187|\tif !ok {\n188|\t\tfailure, err := failProtocol(\"adapter manifest platforms are not a sorted unique non-empty subset\", \"platforms\")\n189|\t\tif err != nil {\n190|\t\t\treturn Manifest{}, err\n191|\t\t}\n192|\t\treturn Manifest{}, failure\n193|\t}\n194|\tfor _, platform := range platforms {\n195|\t\tif _, err := scalar.ParsePlatform(platform); err != nil {\n196|\t\t\tfailure, faultErr := failProtocol(\"adapter manifest platform is outside linux|macos|windows|wsl2\", \"platforms\")\n197|\t\t\tif faultErr != nil {\n198|\t\t\t\treturn Manifest{}, faultErr\n199|\t\t\t}\n200|\t\t\treturn Manifest{}, failure\n201|\t\t}\n202|\t}\n203|\toperations, ok := checkOperationRegistry(members[\"operations\"])\n204|\tif !ok {\n205|\t\tfailure, err := failProtocol(\"adapter manifest operations are not the complete ordered fourteen-name registry\", \"operations\")\n206|\t\tif err != nil {\n207|\t\t\treturn Manifest{}, err\n208|\t\t}\n209|\t\treturn Manifest{}, failure\n210|\t}\n211|\tcapabilities, ok := checkCapabilityRegistry(members[\"capability_names\"])\n212|\tif !ok {\n213|\t\tfailure, err := failProtocol(\"adapter manifest capability names are not the complete ordered fifteen-name registry\", \"capability_names\")\n214|\t\tif err != nil {\n215|\t\t\treturn Manifest{}, err\n216|\t\t}\n217|\t\treturn Manifest{}, failure\n218|\t}\n219|\tif !checkExtensions(members[\"extensions\"]) {\n220|\t\tfailure, err := failProtocol(\"adapter manifest extensions are not reverse-DNS keyed\", \"extensions\")\n221|\t\tif err != nil {\n222|\t\t\treturn Manifest{}, err\n223|\t\t}\n224|\t\treturn Manifest{}, failure\n225|\t}\n226|\tcanonical, err := canonicaljson.Canonicalize(body)\n227|\tif err != nil {\n228|\t\tfailure, faultErr := failProtocol(\"adapter manifest is not canonical JSON\", \"\")\n229|\t\tif faultErr != nil {\n230|\t\t\treturn Manifest{}, faultErr\n231|\t\t}\n232|\t\treturn Manifest{}, failure\n233|\t}\n234|\treturn Manifest{\n235|\t\tProviderID:     providerID,\n236|\t\tEnvironmentID:  environmentID,\n237|\t\tAdapterVersion: adapterVersion,\n238|\t\tPlatforms:      platforms,\n239|\t\tOperations:     operations,\n240|\t\tCapabilities:   capabilities,\n241|\t\tcanonical:      canonical,\n242|\t}, nil\n243|}\n244|\n245|// checkOperationRegistry reports whether the member is exactly the\n246|// dispatch registry in section order: same names, same positions,\n247|// same length. Sortedness is not the rule here — order is — so the\n248|// comparison is element-wise against operationOrder.\n249|func checkOperationRegistry(raw json.RawMessage) ([]string, bool) {\n250|\telements, ok := decodeArray(raw)\n251|\tif !ok || len(elements) != len(operationOrder) {\n252|\t\treturn nil, false\n253|\t}\n254|\toperations := make([]string, 0, len(elements))\n255|\tfor index, element := range elements {\n256|\t\tname, ok := rawString(element)\n257|\t\tif !ok || name != string(operationOrder[index]) {\n258|\t\t\treturn nil, false\n259|\t\t}\n260|\t\toperations = append(operations, name)\n261|\t}\n262|\treturn operations, true\n263|}\n264|\n265|// checkCapabilityRegistry reports whether the member is exactly the\n266|// fifteen-name capability registry in section order.\n267|func checkCapabilityRegistry(raw json.RawMessage) ([]string, bool) {\n268|\telements, ok := decodeArray(raw)\n269|\tif !ok || len(elements) != len(capabilityOrder) {\n270|\t\treturn nil, false\n271|\t}\n272|\tcapabilities := make([]string, 0, len(elements))\n273|\tfor index, element := range elements {\n274|\t\tname, ok := rawString(element)\n275|\t\tif !ok || name != capabilityOrder[index] {\n276|\t\t\treturn nil, false\n277|\t\t}\n278|\t\tcapabilities = append(capabilities, name)\n279|\t}\n280|\treturn capabilities, true\n281|}\n282|\n283|// ManifestDigest returns the host-computed JCS SHA-256 of the\n284|// validated manifest: the session_adapter_manifest_digest. It is\n285|// computed by the host, never embedded by the adapter, so a\n286|// manifest that names its own digest cannot mint trust.\n287|func ManifestDigest(manifest Manifest) scalar.Digest {\n288|\treturn scalar.SHA256Digest(manifest.canonical)\n289|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
