{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c75d","stream":{"kind":"session","id":"01a0b01d-7212-75f1-8296-534762977aff"},"sequence":521,"recorded_at":1780531400001037,"record_type":"event","durability":"durable","causation_id":"663d949a-c622-460a-8733-e5cc483c026f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"663d949a-c622-460a-8733-e5cc483c026f","run_stream":{"kind":"run","id":"663d949a-c622-460a-8733-e5cc483c026f"},"call_id":"call_01a0b01ec01b70a79031f7ee1a1269b3","text":"Read text file `internal/hosttrust/export.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"path\"\n6|\t\"path/filepath\"\n7|\t\"strings\"\n8|)\n9|\n10|// EnrollmentMaterial is the explicitly selected public enrollment material an\n11|// operator exchanges out of band. It carries no private key: only\n12|// certificate.pem and root.pem bytes leave the store, never private-key.pem,\n13|// trust internals, backups or authorization caches.\n14|type EnrollmentMaterial struct {\n15|\tHostID       string\n16|\tCredentialID string\n17|\tLeafDER      []byte\n18|\tRootDER      []byte\n19|\tFingerprints Fingerprints\n20|}\n21|\n22|// Formatting enrollment material redacts DER bytes by default; the operator\n23|// exports explicit fields, never a log line.\n24|func (EnrollmentMaterial) String() string   { return \"host enrollment material\" }\n25|func (EnrollmentMaterial) GoString() string { return \"host enrollment material\" }\n26|func (EnrollmentMaterial) Format(state fmt.State, verb rune) {\n27|\t_, _ = state.Write([]byte(\"host enrollment material\"))\n28|}\n29|\n30|// ExportEnrollment selects the public bytes of one non-revoked entry for\n31|// out-of-band exchange. Revoked tombstones never redistribute: exporting one\n32|// refuses.\n33|func ExportEnrollment(snapshot Snapshot, credentialID string) (EnrollmentMaterial, error) {\n34|\tentry, found := findEntry(snapshot.Trust, credentialID)\n35|\tif !found {\n36|\t\treturn EnrollmentMaterial{}, trustError(TrustError{Operation: \"export enrollment\", Err: ErrEnrollmentRefused})\n37|\t}\n38|\tif entry.State == EntryRevoked {\n39|\t\treturn EnrollmentMaterial{}, trustError(TrustError{Operation: \"export enrollment\", Err: ErrEnrollmentRefused})\n40|\t}\n41|\tfingerprints, err := FingerprintsOf(entry.LeafDER, entry.RootDER)\n42|\tif err != nil {\n43|\t\treturn EnrollmentMaterial{}, err\n44|\t}\n45|\treturn EnrollmentMaterial{\n46|\t\tHostID:       entry.HostID.String(),\n47|\t\tCredentialID: entry.CredentialID.String(),\n48|\t\tLeafDER:      append([]byte(nil), entry.LeafDER...),\n49|\t\tRootDER:      append([]byte(nil), entry.RootDER...),\n50|\t\tFingerprints: fingerprints,\n51|\t}, nil\n52|}\n53|\n54|// ExcludedFromReplication lists the STATE_DIR-relative paths that must never\n55|// enter replication, snapshots, cloning, Session Directory, logs or exported\n56|// diagnostic bundles. Credential, trust, backup, private-key and\n57|// authorization-cache material stays machine-local; operators exchange only\n58|// explicitly selected public enrollment material outside replication.\n59|func ExcludedFromReplication() []string {\n60|\treturn []string{\n61|\t\thostChannelDir + \"/trust.json\",\n62|\t\thostChannelDir + \"/config-binding.json\",\n63|\t\thostChannelDir + \"/pending-commit.json\",\n64|\t\thostChannelDir + \"/credentials/\",\n65|\t\thostChannelDir + \"/lock\",\n66|\t}\n67|}\n68|\n69|// MatchExcludedFromReplication reports whether a STATE_DIR-relative path\n70|// must stay out of replication, snapshots, cloning, Session Directory, logs\n71|// and exported diagnostic bundles. It covers the listed control paths plus\n72|// transient staging files, which carry the same material under rotating\n73|// names. Any path that escapes the state directory fails closed as\n74|// excluded. Every replication, snapshot, clone or diagnostic export surface\n75|// must consult this matcher (and ExcludedConfigDirName for configuration\n76|// directory files) and drop matches; ExportEnrollment material is\n77|// deliberately NOT excluded, since explicitly selected public bytes are the\n78|// only operator exchange outside replication.\n79|func MatchExcludedFromReplication(relative string) bool {\n80|\tif relative == \"\" || relative == \".\" {\n81|\t\treturn false\n82|\t}\n83|\tslash := filepath.ToSlash(relative)\n84|\tif path.IsAbs(slash) {\n85|\t\treturn true\n86|\t}\n87|\tfor _, segment := range strings.Split(slash, \"/\") {\n88|\t\tif segment == \"..\" {\n89|\t\t\treturn true\n90|\t\t}\n91|\t}\n92|\ttrimmed := path.Clean(slash)\n93|\tfor _, listed := range ExcludedFromReplication() {\n94|\t\tclean := path.Clean(listed)\n95|\t\tif trimmed == clean || strings.HasPrefix(trimmed, clean+\"/\") {\n96|\t\t\treturn true\n97|\t\t}\n98|\t}\n99|\tbase := path.Base(trimmed)\n100|\tfor _, prefix := range []string{stagePrefix, \".custody-stage-\", \"lock-stage-\"} {\n101|\t\tif strings.HasPrefix(base, prefix) {\n102|\t\t\treturn true\n103|\t\t}\n104|\t}\n105|\treturn false\n106|}\n107|\n108|// ExcludedConfigDirName reports whether a configuration-directory file name\n109|// carries trust-adjacent material that must stay out of replication: owner-only\n110|// backups, pre-rollback copies and transient migration staging files. Backup\n111|// names embed the source version (\".bak.<version>\"), so the match is by\n112|// infix, pinned against the names replaceDurably actually publishes.\n113|func ExcludedConfigDirName(base string) bool {\n114|\tname := path.Base(filepath.ToSlash(base))\n115|\tif strings.Contains(name, \".pre-rollback.\") {\n116|\t\treturn true\n117|\t}\n118|\tif strings.HasPrefix(name, \".ax-config-\") {\n119|\t\treturn true\n120|\t}\n121|\tif strings.Contains(name, \".ax-config-binding.\") {\n122|\t\treturn true\n123|\t}\n124|\tif strings.Contains(name, \".bak.\") {\n125|\t\treturn true\n126|\t}\n127|\treturn false\n128|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
