ted-print-b\\\")\\n\\t\\t\\t\\treturn encode(func(o map[string]any) {\\n\\t\\t\\t\\t\\to[\\\"repository_remote_fingerprints\\\"] = []any{high, low}\\n\\t\\t\\t\\t})\\n\\t\\t\\t}(), \\\"sorted unique\\\"},''')\\n\\n# refs unsorted\\ns = s.replace('''\\t\\t\\t{\\\"refs unsorted\\\", func(ev *EvidenceInput) {\\n\\t\\t\\t\\tev.RawRefs = []RawRefInput{\\n\\t\\t\\t\\t\\t{ManifestID: fixtureDigest(\\\"b\\\"), BlobDescriptorID: fixtureDigest(\\\"d\\\"), Offset: 0, Length: 1},\\n\\t\\t\\t\\t\\t{ManifestID: fixtureDigest(\\\"a\\\"), BlobDescriptorID: fixtureDigest(\\\"d\\\"), Offset: 0, Length: 1},\\n\\t\\t\\t\\t}\\n\\t\\t\\t}, \\\"sorted unique\\\"},''', '''\\t\\t\\t{\\\"refs unsorted\\\", func(ev *EvidenceInput) {\\n\\t\\t\\t\\thigh, low := unsortedPair(\\\"unsorted-ref-a\\\", \\\"unsorted-ref-b\\\")\\n\\t\\t\\t\\tev.RawRefs = []RawRefInput{\\n\\t\\t\\t\\t\\t{ManifestID: high, BlobDescriptorID: fixtureDigest(\\\"d\\\"), Offset: 0, Length: 1},\\n\\t\\t\\t\\t\\t{ManifestID: low, BlobDescriptorID: fixtureDigest(\\\"d\\\"), Offset: 0, Length: 1},\\n\\t\\t\\t\\t}\\n\\t\\t\\t}, \\\"sorted unique\\\"},''')\\n\\np.write_text(s)\\nprint(\\\"patched\\\")\\nEOF\\ngofmt -w internal/clonebundle/ && go test ./internal/clonebundle/ -count=1 2>&1 | tail -n 6\",\n  \"description\": \"Fix digest ordering in tests\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"patched\\nok  \\tgithub.com/relux-works/agent-session-manager/internal/clonebundle\\t0.509s\\n\",\n  \"original_output_bytes\": 86,\n  \"original_output_tokens\": 22,\n  \"truncated\": false\n}","final_result":true}}}
