{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8f5","stream":{"kind":"session","id":"01a0b01d-7212-75f1-8296-534762977aff"},"sequence":725,"recorded_at":1780531400001445,"record_type":"event","durability":"durable","causation_id":"663d949a-c622-460a-8733-e5cc483c026f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"663d949a-c622-460a-8733-e5cc483c026f","run_stream":{"kind":"run","id":"663d949a-c622-460a-8733-e5cc483c026f"},"task_stream":{"kind":"task","id":"01a0b01f-61d7-77d3-b6e4-cdb2833df037"},"task_id":"01a0b01f-61d7-77d3-b6e4-cdb2833df037","event":{"kind":"output","task_id":"01a0b01f-61d7-77d3-b6e4-cdb2833df037","chunk":"Read text file `internal/matjournal/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for internal/matjournal.\n3|\n4|Every gate ships a narrowing mutant: the gate stays present and is\n5|weakened to admit exactly one member of the class it must reject, and\n6|the named killer test must fail. A delete-only mutant proves only that\n7|the gate exists and is not accepted as evidence.\n8|\n9|Each row runs M (mutate one production file in place), R (run the\n10|scoped Go killer through the production entry point), V (verdict from\n11|the Go exit code plus a FAIL kill-line: KILLED iff R fails with a test\n12|failure line, SURVIVED iff R passes, ERROR for anything else —\n13|unapplied patches, build breaks, timeouts). M failures and R\n14|infrastructure errors are ERROR, never kills or survivals. The file is\n15|restored from its backup after every row, pass or fail.\n16|\n17|Row C-doc-comment is the harmless control: a comment-only edit that\n18|must SURVIVE, proving the harness observes test outcomes instead of\n19|hard-coding kills.\n20|\n21|Usage:\n22|  python3 internal/matjournal/mutant_harness.py            # all rows\n23|  python3 internal/matjournal/mutant_harness.py N-phase-table\n24|\"\"\"\n25|\n26|import shutil\n27|import subprocess\n28|import sys\n29|import tempfile\n30|from dataclasses import dataclass\n31|from pathlib import Path\n32|\n33|REPO = Path(__file__).resolve().parents[2]\n34|PACKAGE = \"internal/matjournal\"\n35|\n36|\n37|@dataclass(frozen=True)\n38|class Mutant:\n39|    name: str\n40|    path: str\n41|    find: str\n42|    replace: str\n43|    count: int\n44|    run: str\n45|    expect: str\n46|    note: str\n47|\n48|\n49|MUTANTS = [\n50|    Mutant(\n51|        name=\"N-phase-table\",\n52|        path=f\"{PACKAGE}/journal.go\",\n53|        find=\"\\tPhaseStaging:     {PhaseValidating, PhaseRollingBack, PhaseFailed},\\n\",\n54|        replace=\"\\tPhaseStaging:     {PhaseValidating, PhaseRollingBack, PhaseFailed, PhaseCommitted},\\n\",\n55|        count=1,\n56|        run=\"TestTransitionRefusesIllegalEdges\",\n57|        expect=\"KILLED\",\n58|        note=\"Admits exactly staging-to-committed; every phase literal is preserved, only the edge set changes.\",\n59|    ),\n60|    Mutant(\n61|        name=\"N-board-subtable\",\n62|        path=f\"{PACKAGE}/journal.go\",\n63|        find=\"\\tBoardNotStarted:       {BoardImported, BoardRolledBack, BoardFailed},\\n\",\n64|        replace=\"\\tBoardNotStarted:       {BoardImported, BoardOpened, BoardRolledBack, BoardFailed},\\n\",\n65|        count=1,\n66|        run=\"TestBoardNullabilityRefusals/subtable_refuses_skip\",\n67|        expect=\"KILLED\",\n68|        note=\"Admits exactly not_started-to-opened; literals preserved, edge added.\",\n69|    ),\n70|    Mutant(\n71|        name=\"N-provider-token\",\n72|        path=f\"{PACKAGE}/journal.go\",\n73|        find='''\tif provider.State == ProviderPrepared {\n74|\t\tif provider.RollbackToken == nil {\n75|\t\t\treturn invalid(\"provider prepared state requires a non-null rollback token\")\n76|\t\t}\n77|''',\n78|        replace='''\tif provider.State == ProviderPrepared {\n79|\t\tif provider.RollbackToken == nil && provider.State == ProviderUnknown {\n80|\t\t\treturn invalid(\"provider prepared state requires a non-null rollback token\")\n81|\t\t}\n82|''',\n83|        count=1,\n84|        run=\"TestProviderTokenAndIDRules/prepared_requires_token\",\n85|        expect=\"KILLED\",\n86|        note=\"Admits exactly prepared-without-token; the null check stays, gated on an impossible state.\",\n87|    ),\n88|    Mutant(\n89|        name=\"N-board-import\",\n90|        path=f\"{PACKAGE}/journal.go\",\n91|        find=\"\\tif board.ImportToken == nil || board.StagedManagerRef == nil || board.ImportExpiresAt == nil {\\n\\t\\treturn invalid(\\\"task-board imported requires the import token, staged reference, and expiry\\\")\\n\",\n92|        replace=\"\\tif board.ImportToken == nil || board.StagedManagerRef == nil {\\n\\t\\treturn invalid(\\\"task-board imported requires the import token, staged reference, and expiry\\\")\\n\",\n93|        count=1,\n94|        run=\"TestBoardNullabilityRefusals/imported_triple_incomplete\",\n95|        expect=\"KILLED\",\n96|        note=\"Admits exactly expiry-less imports; the token and reference checks stay.\",\n97|    ),\n98|    Mutant(\n99|        name=\"N-id-drift-adopt\",\n100|        path=f\"{PACKAGE}/journal.go\",\n101|        find=\"\"\"\tif board.ImportOperationID != bound.Import || board.OpenOperationID != bound.Open ||\n102|\t\tboard.AdoptOperationID != bound.Adopt || board.ResumeOperationID != bound.Resume {\n103|\"\"\",\n104|        replace=\"\"\"\tif board.ImportOperationID != bound.Import || board.OpenOperationID != bound.Open ||\n105|\t\tboard.ResumeOperationID != bound.Resume {\n106|\"\"\",\n107|        count=1,\n108|        run=\"TestBoardNullabilityRefusals/operation_drift_refuses\",\n109|        expect=\"KILLED\",\n110|        note=\"Admits exactly adopt-ID drift; import, open, and resume still bind.\",\n111|    ),\n112|    Mutant(\n113|        name=\"N-create-first-prepare\",\n114|        path=f\"{PACKAGE}/store.go\",\n115|        find=\"\\tif journal.PrepareOperationID != prepare {\\n\",\n116|        replace='\\tif journal.PrepareOperationID != prepare && journal.PrepareOperationID == \"\" {\\n',\n117|        count=1,\n118|        run=\"TestCreateReplayAndConflict\",\n119|        expect=\"KILLED\",\n120|        note=\"Admits exactly the different-operation same-body replay past the first-prepare check.\",\n121|    ),\n122|    Mutant(\n123|        name=\"N-rollback-adopt\",\n124|        path=f\"{PACKAGE}/journal.go\",\n125|        find=\"\"\"\t\tcase BoardAdopted, BoardResumed:\n126|\t\t\treturn invalid(\"byte rollback is forbidden after adopt: the manager is active authority\")\n127|\"\"\",\n128|        replace=\"\"\"\t\tcase BoardResumed:\n129|\t\t\treturn invalid(\"byte rollback is forbidden after adopt: the manager is active authority\")\n130|\"\"\",\n131|        count=1,\n132|        run=\"TestTransitionGuards/rollback_refused_after_adopt\",\n133|        expect=\"KILLED\",\n134|        note=\"Admits exactly adopted rollback; resumed still refuses.\",\n135|    ),\n136|    Mutant(\n137|        name=\"N-failed-null\",\n138|        path=f\"{PACKAGE}/journal.go\",\n139|        find=\"\\t\\tif len(opts.LastError) == 0 || isNull(opts.LastError) {\\n\",\n140|        replace=\"\\t\\tif len(opts.LastError) == 0 {\\n\",\n141|        count=1,\n142|        run=\"TestTransitionGuards/failed_requires_error\",\n143|        expect=\"KILLED\",\n144|        note=\"Admits exactly the explicit-null explaining error; missing and malformed still refuse.\",\n145|    ),\n146|    Mutant(\n147|        name=\"N-commit-marker\",\n148|        path=f\"{PACKAGE}/journal.go\",\n149|        find=\"\"\"\t\tif journal.ManagedReplicaID != nil {\n150|\t\t\tif len(opts.Marker) == 0 {\n151|\t\t\t\treturn invalid(\"committed workspace transaction requires the destination marker\")\n152|\t\t\t}\n153|\"\"\",\n154|        replace=\"\"\"\t\tif journal.ManagedReplicaID != nil && len(journal.AuthorityStates) == 0 {\n155|\t\t\tif len(opts.Marker) == 0 {\n156|\t\t\t\treturn invalid(\"committed workspace transaction requires the destination marker\")\n157|\t\t\t}\n158|\"\"\",\n159|        count=1,\n160|        run=\"TestTransitionGuards/committed_workspace_requires_marker\",\n161|        expect=\"KILLED\",\n162|        note=\"Admits exactly marker-less commits on journals with authorities; the killer asserts the guard message.\",\n163|    ),\n164|    Mutant(\n165|        name=\"N-recover-uncertain-floor\",\n166|        path=f\"{PACKAGE}/recover.go\",\n167|        find=\"\"\"\tif journal.Provider != nil {\n168|\t\treturn journal.Phase == PhasePrepared || journal.Phase == PhaseCommitting ||\n169|\t\t\tjournal.Phase == PhaseRollingBack\n170|\t}\n171|\treturn boundaryAtOrAfter(assessment.input.Boundary, BoundaryAfterPrepareOp)\n172|\"\"\",\n173|        replace=\"\"\"\tif journal.Provider != nil {\n174|\t\treturn journal.Phase == PhasePrepared || journal.Phase == PhaseCommitting ||\n175|\t\t\tjournal.Phase == PhaseRollingBack\n176|\t}\n177|\treturn boundaryAtOrAfter(assessment.input.Boundary, BoundaryAfterFinalize)\n178|\"\"\",\n179|        count=1,\n180|        run=\"TestParkedEvidenceIsDurable\",\n181|        expect=\"KILLED\",\n182|        note=\"Admits exactly unrecorded-prepare unknown probes at CR-MAT-05..07; the parked assessment must still refuse.\",\n183|    ),\n184|    Mutant(\n185|        name=\"N-token-length\",\n186|        path=f\"{PACKAGE}/journal.go\",\n187|        find=\"\\tif len(raw) < minTokenBytes || len(raw) > maxTokenBytes {\\n\",\n188|        replace=\"\\tif len(raw) < minTokenBytes && len(raw) != 3 || len(raw) > maxTokenBytes {\\n\",\n189|        count=1,\n190|        run=\"TestProviderTokenAndIDRules/short_token_refuses\",\n191|        expect=\"KILLED\",\n192|        note=\"Admits exactly 3-byte tokens; every other short or long token still refuses.\",\n193|    ),\n194|    Mutant(\n195|        name=\"C-doc-comment\",\n196|        path=f\"{PACKAGE}/doc.go\",\n197|        find=\"// Authority: relux-works/agent-session-manager-spec@v0.6.0, Section 10.6\\n\",\n198|        replace=\"// Authority: relux-works/agent-session-manager-spec@v0.6.0, Section 10.6 (control).\\n\",\n199|        count=1,\n200|        run=\"TestTokenFixturesAreWellFormed\",\n201|        expect=\"SURVIVED\",\n202|        note=\"Harmless control: a comment-only edit must survive.\",\n203|    ),\n204|]\n205|\n206|\n207|def run_mutant(mutant: Mutant) -> str:\n208|    target = REPO / mutant.path\n209|    original = target.read_text()\n210|    found = original.count(mutant.find)\n211|    if found != mutant.count:\n212|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\"\n213|    with tempfile.TemporaryDirectory() as staging:\n214|        backup = Path(staging) / \"backup\"\n215|        shutil.copy2(target, backup)\n216|        try:\n217|            target.write_text(original.replace(mutant.find, mutant.replace))\n218|            run = subprocess.run(\n219|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n220|                cwd=REPO,\n221|                capture_output=True,\n222|                text=True,\n223|                timeout=300,\n224|            )\n225|        finally:\n226|            shutil.copy2(backup, target)\n227|    output = (run.stdout + run.stderr).strip()\n228|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n229|        return f\"ERROR: {mutant.name}: build broke under the patch\"\n230|    if run.returncode == 0:\n231|        verdict = \"SURVIVED\"\n232|    elif '--- FAIL' in output or 'FAIL:' in output:\n233|        verdict = \"KILLED\"\n234|    else:\n235|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\"\n236|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n237|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note}\"\n238|\n239|\n240|def main(argv: list[str]) -> int:\n241|    selected = [m for m in MUTANTS if not argv or m.name in argv]\n242|    if argv and len(selected) != len(argv):\n243|        unknown = sorted(set(argv) - {m.name for m in selected})\n244|        print(f\"unknown mutants: {', '.join(unknown)}\")\n245|        return 2\n246|    failures = 0\n247|    for mutant in selected:\n248|        try:\n249|            line = run_mutant(mutant)\n250|        except subprocess.TimeoutExpired:\n251|            line = f\"ERROR: {mutant.name}: killer timed out\"\n252|        print(line, flush=True)\n253|        if not line.startswith(\"ok:\"):\n254|            failures += 1\n255|    return 1 if failures else 0\n256|\n257|\n258|if __name__ == \"__main__\":\n259|    sys.exit(main(sys.argv[1:]))","final_result":true}}}
