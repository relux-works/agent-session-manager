nd is checked on both edges. It delegates to the environ\n229|// gate.\n230|func checkSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n231|\treturn environ.CheckSortedUniqueStrings(raw, minimumLength, maximumLength, minimumCount, maximumCount)\n232|}\n233|\n234|// checkSortedUniqueDigests reports whether the member is a sorted\n235|// unique digest array in the count bound. It delegates to the\n236|// environ gate.\n237|func checkSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\n238|\treturn environ.CheckSortedUniqueDigests(raw, minimumCount, maximumCount)\n239|}\n240|\n241|// providerIDPattern is the Section 7.1 provider-id grammar the\n242|// manifest, context, and binding layers read:\n243|// [a-z][a-z0-9-]{0,31}. It is the one grammar copy this package\n244|// retains: scalar owns the provider-id rule and the one-language\n245|// battery pins every copy to its literal in both directions.\n246|var providerIDPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,31}$`)\n247|\n248|// checkExtensions reports whether the member is an object whose keys\n249|// are all reverse-DNS names. Values cross opaquely: extensions\n250|// cannot add operations, capabilities, or trust facts, and no member\n251|// of this package reads an extension value for any admission\n252|// decision. It delegates to the environ gate.\n253|func checkExtensions(raw json.RawMessage) bool {\n254|\treturn environ.CheckExtensions(raw)\n255|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
