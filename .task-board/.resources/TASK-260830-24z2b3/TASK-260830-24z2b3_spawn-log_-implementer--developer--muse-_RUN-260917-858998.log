{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc6f","stream":{"kind":"session","id":"01a0b0d3-448d-7fa1-9a80-daada0956017"},"sequence":1170,"recorded_at":1780531400002335,"record_type":"event","durability":"durable","causation_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","run_stream":{"kind":"run","id":"f02750e1-95aa-4722-a114-f72ebe5c150a"},"task_stream":{"kind":"task","id":"01a0b0db-1192-7411-8ce6-22774cebf3d2"},"task_id":"01a0b0db-1192-7411-8ce6-22774cebf3d2","event":{"kind":"output","task_id":"01a0b0db-1192-7411-8ce6-22774cebf3d2","chunk":"Read text file `internal/sessadapter/decode.go`.\n(144 line(s) above)\n145|\treturn value, true\n146|}\n147|\n148|// stringLength is the Section 1.6 string measure in characters, not\n149|// bytes: a bound of string[1..128] admits 128 characters of any\n150|// width. It delegates to the single environ measure so the two can\n151|// never drift; the delegation battery pins both directions.\n152|func stringLength(value string) int {\n153|\treturn environ.StringLength(value)\n154|}\n155|\n156|// checkStringBounds reports whether the member is a JSON string whose\n157|// character count falls in the inclusive bound. It delegates to the\n158|// environ gate.\n159|func checkStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n160|\treturn environ.CheckStringBounds(raw, minimum, maximum)\n161|}\n162|\n163|// checkUint53Bounds reports whether the member is a uint53 in the\n164|// inclusive bound. Both edges are checked: a one-sided check would\n165|// admit the open side. It delegates to the environ gate.\n166|func checkUint53Bounds(raw json.RawMessage, minimum, maximum uint64) (uint64, bool) {\n167|\treturn environ.CheckUint53Bounds(raw, minimum, maximum)\n168|}\n169|\n170|// checkDigest reports whether the member is a digest of the pinned\n171|// sha256 form. It delegates to the environ gate.\n172|func checkDigest(raw json.RawMessage) (scalar.Digest, bool) {\n173|\treturn environ.CheckDigest(raw)\n174|}\n175|\n176|// checkUUIDv7 reports whether the member is a lowercase UUIDv7. It\n177|// delegates to the environ gate.\n178|func checkUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n179|\treturn environ.CheckUUIDv7(raw)\n180|}\n181|\n182|// checkTimestamp reports whether the member is a pinned timestamp.\n183|// It delegates to the environ gate.\n184|func checkTimestamp(raw json.RawMessage) (scalar.Timestamp, bool) {\n185|\treturn environ.CheckTimestamp(raw)\n186|}\n187|\n188|// isNull reports whether the member is an explicit JSON null.\n189|func isNull(raw json.RawMessage) bool {\n190|\treturn string(bytes.TrimSpace(raw)) == \"null\"\n191|}\n192|\n193|// decodeArray reads a JSON array member into its raw elements. A\n194|// non-array — including null — is not an empty array.\n195|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n196|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n197|\ttoken, err := decoder.Token()\n198|\tif err != nil {\n199|\t\treturn nil, false\n200|\t}\n201|\tdelim, ok := token.(json.Delim)\n202|\tif !ok || delim != '[' {\n203|\t\treturn nil, false\n204|\t}\n205|\tvar elements []json.RawMessage\n206|\tfor decoder.More() {\n207|\t\tvar element json.RawMessage\n208|\t\tif err := decoder.Decode(&element); err != nil {\n209|\t\t\treturn nil, false\n210|\t\t}\n211|\t\telements = append(elements, element)\n212|\t}\n213|\tif token, err := decoder.Token(); err != nil {\n214|\t\treturn nil, false\n215|\t} else if delim, ok := token.(json.Delim); !ok || delim != ']' {\n216|\t\treturn nil, false\n217|\t}\n218|\tif _, err := decoder.Token(); err != io.EOF {\n219|\t\treturn nil, false\n220|\t}\n221|\treturn elements, true\n222|}\n223|\n224|// checkSortedUniqueStrings reports whether the member is an array of\n225|// strings in the item bound whose JCS encodings order strictly\n226|// increasingly with no duplicates. Bytewise JCS order over strings\n227|// is plain lexicographic order, so the check compares directly; the\n228|// count bound is checked on both edges. It delegates to the environ\n229|// gate.\n230|func checkSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n231|\treturn environ.CheckSortedUniqueStrings(raw, minimumLength, maximumLength, minimumCount, maximumCount)\n232|}\n233|\n234|// checkSortedUniqueDigests reports whether the member is a sorted\n235|// unique digest array in the count bound. It delegates to the\n236|// environ gate.\n237|func checkSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\n238|\treturn environ.CheckSortedUniqueDigests(raw, minimumCount, maximumCount)\n239|}\n240|\n241|// providerIDPattern is the Section 7.1 provider-id grammar the\n242|// manifest, context, and binding layers read:\n243|// [a-z][a-z0-9-]{0,31}. It is the one grammar copy this package\n244|// retains: scalar owns the provider-id rule and the one-language\n245|// battery pins every copy to its literal in both directions.\n246|var providerIDPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,31}$`)\n247|\n248|// checkExtensions reports whether the member is an object whose keys\n249|// are all reverse-DNS names. Values cross opaquely: extensions\n250|// cannot add operations, capabilities, or trust facts, and no member\n251|// of this package reads an extension value for any admission\n252|// decision. It delegates to the environ gate.\n253|func checkExtensions(raw json.RawMessage) bool {\n254|\treturn environ.CheckExtensions(raw)\n255|}","final_result":true}}}
