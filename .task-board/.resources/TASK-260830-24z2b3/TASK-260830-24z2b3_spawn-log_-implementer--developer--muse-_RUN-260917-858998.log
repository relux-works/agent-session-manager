{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c823","stream":{"kind":"session","id":"01a0b0d3-448d-7fa1-9a80-daada0956017"},"sequence":620,"recorded_at":1780531400001235,"record_type":"event","durability":"durable","causation_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","run_stream":{"kind":"run","id":"f02750e1-95aa-4722-a114-f72ebe5c150a"},"task_stream":{"kind":"task","id":"01a0b0d4-b874-7a83-8960-2dd022ddfa13"},"task_id":"01a0b0d4-b874-7a83-8960-2dd022ddfa13","event":{"kind":"output","task_id":"01a0b0d4-b874-7a83-8960-2dd022ddfa13","chunk":"Read text file `internal/clonebundle/session.go`.\n(499 line(s) above)\n500|\t\t\tmainCount++\n501|\t\t}\n502|\t\tactors = append(actors, actor)\n503|\t}\n504|\tif mainCount != 1 {\n505|\t\treturn nil, invalid(\"canonical session carries %d main actors, want exactly one\", mainCount)\n506|\t}\n507|\treturn actors, nil\n508|}\n509|\n510|// decodeOrderedUniqueDigests validates ordered unique digests: order\n511|// is the caller's (event order), uniqueness is exact.\n512|func decodeOrderedUniqueDigests(raw json.RawMessage, minimum, maximum int, name string) ([]scalar.Digest, error) {\n513|\telements, ok := decodeArray(raw)\n514|\tif !ok {\n515|\t\treturn nil, invalid(\"canonical session %s are not an array\", name)\n516|\t}\n517|\tif len(elements) < minimum || len(elements) > maximum {\n518|\t\treturn nil, invalid(\"canonical session %s carry %d IDs, want [%d..%d]\", name, len(elements), minimum, maximum)\n519|\t}\n520|\tids := make([]scalar.Digest, 0, len(elements))\n521|\tseen := map[string]bool{}\n522|\tfor index, element := range elements {\n523|\t\tid, ok := checkDigest(element)\n524|\t\tif !ok {\n525|\t\t\treturn nil, invalid(\"canonical session %s[%d] is not a digest\", name, index)\n526|\t\t}\n527|\t\tif seen[id.String()] {\n528|\t\t\treturn nil, invalid(\"canonical session %s are not unique\", name)\n529|\t\t}\n530|\t\tseen[id.String()] = true\n531|\t\tids = append(ids, id)\n532|\t}\n533|\treturn ids, nil\n534|}\n535|\n536|func parseOrderedUniqueDigests(values []string, minimum, maximum int, name string) ([]scalar.Digest, error) {\n537|\tif len(values) < minimum || len(values) > maximum {\n538|\t\treturn nil, invalid(\"canonical session %s carry %d IDs, want [%d..%d]\", name, len(values), minimum, maximum)\n539|\t}\n540|\tids := make([]scalar.Digest, 0, len(values))\n541|\tseen := map[string]bool{}\n542|\tfor index, value := range values {\n543|\t\tid, err := scalar.ParseDigest(value)\n544|\t\tif err != nil {\n545|\t\t\treturn nil, invalid(\"canonical session %s[%d] is not a digest: %v\", name, index, err)\n546|\t\t}\n547|\t\tif seen[id.String()] {\n548|\t\t\treturn nil, invalid(\"canonical session %s are not unique\", name)\n549|\t\t}\n550|\t\tseen[id.String()] = true\n551|\t\tids = append(ids, id)\n552|\t}\n553|\treturn ids, nil\n554|}\n555|\n556|func parseSortedUniqueDigestStrings(values []string, minimum, maximum int, name string) ([]scalar.Digest, error) {\n557|\tif len(values) < minimum || len(values) > maximum {\n558|\t\treturn nil, invalid(\"canonical session %s carry %d IDs, want [%d..%d]\", name, len(values), minimum, maximum)\n559|\t}\n560|\tids := make([]scalar.Digest, 0, len(values))\n561|\tprevious := \"\"\n562|\tfor index, value := range values {\n563|\t\tid, err := scalar.ParseDigest(value)\n564|\t\tif err != nil {\n565|\t\t\treturn nil, invalid(\"canonical session %s[%d] is not a digest: %v\", name, index, err)\n566|\t\t}\n567|\t\tif index > 0 && id.String() <= previous {\n568|\t\t\treturn nil, invalid(\"canonical session %s are not sorted unique\", name)\n569|\t\t}\n570|\t\tprevious = id.String()\n571|\t\tids = append(ids, id)\n572|\t}\n573|\treturn ids, nil\n574|}\n575|\n576|func parseNullableTimestamp(value *string, name string) (any, error) {\n577|\tif value == nil {\n578|\t\treturn nil, nil\n579|\t}\n580|\tstamp, err := scalar.ParseTimestamp(*value)\n581|\tif err != nil {\n582|\t\treturn nil, invalid(\"canonical session %s is not a timestamp: %v\", name, err)\n583|\t}\n584|\treturn stamp.String(), nil\n585|}\n586|\n587|func decodeNullableTimestamp(members map[string]json.RawMessage, name, owner string) (*scalar.Timestamp, error) {\n588|\traw, present := members[name]\n589|\tif !present {\n590|\t\treturn nil, invalid(\"%s misses a required member %q\", owner, name)\n591|\t}\n592|\tif isNull(raw) {\n593|\t\treturn nil, nil\n594|\t}\n595|\tstamp, ok := checkTimestamp(raw)\n596|\tif !ok {\n597|\t\treturn nil, invalid(\"%s %s is not a timestamp\", owner, name)\n598|\t}\n599|\treturn &stamp, nil\n600|}\n601|\n602|func digestStrings(ids []scalar.Digest) []any {\n603|\tvalues := make([]any, 0, len(ids))\n604|\tfor _, id := range ids {\n605|\t\tvalues = append(values, id.String())\n606|\t}\n607|\treturn values\n608|}","final_result":true}}}
