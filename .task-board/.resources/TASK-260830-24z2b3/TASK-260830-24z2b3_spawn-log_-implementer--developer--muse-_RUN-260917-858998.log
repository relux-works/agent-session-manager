{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d065","stream":{"kind":"session","id":"01a0b0d3-448d-7fa1-9a80-daada0956017"},"sequence":1677,"recorded_at":1780531400003349,"record_type":"event","durability":"durable","causation_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","run_stream":{"kind":"run","id":"f02750e1-95aa-4722-a114-f72ebe5c150a"},"call_id":"call_01a0b0e02f6375c09ac6961804fed1c1","text":"edited\nchanged lines: line 359\n--- original\n+++ updated\n@@\n-func excludedRowClasses(items []CaptureItem) []string {\n+// checkPlanItemMatch enforces the one-per-plan-candidate rule at\n+// construction: the sealed items must be exactly one per capture-plan\n+// candidate, no missing and no extra. An incomplete raw closure still\n+// seals (with raw_complete false), but an items/plan mismatch is a\n+// malformed manifest, never an archive object.\n+func checkPlanItemMatch(items []CaptureItem, planKeys []string) error {\n+\tif len(items) != len(planKeys) {\n+\t\treturn invalid(\"capture manifest carries %d items for %d plan candidates, want one per plan candidate\", len(items), len(planKeys))\n+\t}\n+\titemSet := map[string]bool{}\n+\tfor _, item := range items {\n+\t\titemSet[item.NativeItemKey] = true\n+\t}\n+\tfor _, key := range planKeys {\n+\t\tif !itemSet[key] {\n+\t\t\treturn invalid(\"capture manifest plan candidate %q has no item\", key)\n+\t\t}\n+\t}\n+\treturn nil\n+}\n+\n+func excludedRowClasses(items []CaptureItem) []string {\n","edit_facts":{"tool_name":"edit_file","path":"internal/clonebundle/capturebuild.go","added":22,"removed":1},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
