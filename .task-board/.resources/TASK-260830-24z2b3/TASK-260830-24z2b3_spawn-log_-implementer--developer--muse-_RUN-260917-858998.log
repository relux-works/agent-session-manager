{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca2b","stream":{"kind":"session","id":"01a0b0d3-448d-7fa1-9a80-daada0956017"},"sequence":880,"recorded_at":1780531400001755,"record_type":"event","durability":"durable","causation_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","run_stream":{"kind":"run","id":"f02750e1-95aa-4722-a114-f72ebe5c150a"},"call_id":"call_01a0b0d7284c76f18d13749b99721faa","text":"Read text file `internal/clonebundle/refusal_test.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|)\n9|\n10|// Negative tests for the raw manifest, capture items, source basis,\n11|// and capture boundary gates. Every row drives a production entry\n12|// point and asserts the refusal; rows that share a verdict shape\n13|// assert a message fragment so the firing gate is identified.\n14|\n15|func mustRawBytes(t *testing.T) []byte {\n16|\tt.Helper()\n17|\tidentity := fixtureNativeIdentity()\n18|\tdigest, err := IdentityDigest(identity, nil)\n19|\tif err != nil {\n20|\t\tt.Fatal(err)\n21|\t}\n22|\tbuilt, err := BuildRawObjectManifest(fixtureOperationID, []byte(fixtureTupleJSON()),\n23|\t\t\"native-session-alpha\", digest.String(), fixtureDigest(\"test-capture-plan\"), validEntryInputs(t), nil)\n24|\tif err != nil {\n25|\t\tt.Fatal(err)\n26|\t}\n27|\treturn built\n28|}\n29|\n30|func tamper(t *testing.T, data []byte, mutate func(map[string]any)) []byte {\n31|\tt.Helper()\n32|\tvar object map[string]any\n33|\tif err := json.Unmarshal(data, &object); err != nil {\n34|\t\tt.Fatal(err)\n35|\t}\n36|\tmutate(object)\n37|\tout, err := json.Marshal(object)\n38|\tif err != nil {\n39|\t\tt.Fatal(err)\n40|\t}\n41|\treturn out\n42|}\n43|\n44|func requireRefusal(t *testing.T, err error, fragment string) {\n45|\tt.Helper()\n46|\tif !errors.Is(err, ErrInvalid) {\n47|\t\tt.Fatalf(\"error = %v, want ErrInvalid\", err)\n48|\t}\n49|\tif fragment != \"\" && !strings.Contains(err.Error(), fragment) {\n50|\t\tt.Fatalf(\"error = %v, want fragment %q\", err, fragment)\n51|\t}\n52|}\n53|\n54|func TestRawManifestRefusals(t *testing.T) {\n55|\tidentity := fixtureNativeIdentity()\n56|\tidentityDigest, err := IdentityDigest(identity, nil)\n57|\tif err != nil {\n58|\t\tt.Fatal(err)\n59|\t}\n60|\tbuild := func(inputs []EntryInput) error {\n61|\t\t_, err := BuildRawObjectManifest(fixtureOperationID, []byte(fixtureTupleJSON()),\n62|\t\t\t\"native-session-alpha\", identityDigest.String(), fixtureDigest(\"test-capture-plan\"), inputs, nil)\n63|\t\treturn err\n64|\t}\n65|\tt.Run(\"build\", func(t *testing.T) {\n66|\t\tbase := validEntryInputs(t)\n67|\t\tclone := func() []EntryInput {\n68|\t\t\tout := make([]EntryInput, len(base))\n69|\t\t\tcopy(out, base)\n70|\t\t\treturn out\n71|\t\t}\n72|\t\tcases := []struct {\n73|\t\t\tname     string\n74|\t\t\tmutate   func([]EntryInput) []EntryInput\n75|\t\t\tfragment string\n76|\t\t}{\n77|\t\t\t{\"unknown class\", func(in []EntryInput) []EntryInput { in[0].Class = \"mystery\"; return in }, \"outside the raw subset\"},\n78|\t\t\t{\"credential forbidden\", func(in []EntryInput) []EntryInput { in[0].Class = \"credential\"; return in }, \"outside the raw subset\"},\n79|\t\t\t{\"machine_auth forbidden\", func(in []EntryInput) []EntryInput { in[0].Class = \"machine_auth\"; return in }, \"outside the raw subset\"},\n80|\t\t\t{\"runtime_state forbidden\", func(in []EntryInput) []EntryInput { in[0].Class = \"runtime_state\"; return in }, \"outside the raw subset\"},\n81|\t\t\t{\"transient_lock forbidden\", func(in []EntryInput) []EntryInput { in[0].Class = \"transient_lock\"; return in }, \"outside the raw subset\"},\n82|\t\t\t{\"unsorted entries\", func(in []EntryInput) []EntryInput { in[0], in[1] = in[1], in[0]; return in }, \"sorted unique\"},\n83|\t\t\t{\"duplicate entries\", func(in []EntryInput) []EntryInput { in[1].NativeItemKey = in[0].NativeItemKey; return in }, \"sorted unique\"},\n84|\t\t\t{\"absolute key\", func(in []EntryInput) []EntryInput { in[0].NativeItemKey = \"/etc/passwd\"; return in }, \"absolute source path\"},\n85|\t\t\t{\"uuid key\", func(in []EntryInput) []EntryInput { in[0].NativeItemKey = fixtureSessionID; return in }, \"fabricated AX\"},\n86|\t\t\t{\"control key\", func(in []EntryInput) []EntryInput { in[0].NativeItemKey = \"a\\x00b\"; return in }, \"control characters\"},\n87|\t\t\t{\"credential-url key\", func(in []EntryInput) []EntryInput { in[0].NativeItemKey = \"https://user:pass@host/x\"; return in }, \"embedded credentials\"},\n88|\t\t\t{\"ax-marker key\", func(in []EntryInput) []EntryInput { in[0].NativeItemKey = \"urn:ax:session:x\"; return in }, \"AX identity marker\"},\n89|\t\t\t{\"blob disagreement\", func(in []EntryInput) []EntryInput { in[0].BlobID = fixtureDigest(\"other-blob\"); return in }, \"disagrees\"},\n90|\t\t\t{\"size disagreement\", func(in []EntryInput) []EntryInput { in[0].ByteCount++; return in }, \"disagrees\"},\n91|\t\t\t{\"descriptor tampered\", func(in []EntryInput) []EntryInput {\n92|\t\t\t\tin[0].Descriptor = append([]byte(nil), in[0].Descriptor...)\n93|\t\t\t\tin[0].Descriptor[10] ^= 0xff\n94|\t\t\t\treturn in\n95|\t\t\t}, \"identity fails\"},\n96|\t\t\t{\"bad blob digest\", func(in []EntryInput) []EntryInput { in[0].BlobID = \"nope\"; return in }, \"not a digest\"},\n97|\t\t}\n98|\t\tfor _, tc := range cases {\n99|\t\t\tt.Run(tc.name, func(t *testing.T) {\n100|\t\t\t\trequireRefusal(t, build(cloneMutate(clone(), tc.mutate)), tc.fragment)\n101|\t\t\t})\n102|\t\t}\n103|\t})\n104|\tt.Run(\"decode\", func(t *testing.T) {\n105|\t\tvalid := mustRawBytes(t)\n106|\t\tcases := []struct {\n107|\t\t\tname     string\n108|\t\t\tbody     func(t *testing.T) []byte\n109|\t\t\tfragment string\n110|\t\t}{\n111|\t\t\t{\"unknown member\", func(t *testing.T) []byte {\n112|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"target\"] = \"x\" })\n113|\t\t\t}, \"unknown member\"},\n114|\t\t\t{\"missing member\", func(t *testing.T) []byte {\n115|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { delete(o, \"entries\") })\n116|\t\t\t}, \"misses\"},\n117|\t\t\t{\"bad schema\", func(t *testing.T) []byte {\n118|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"schema\"] = \"urn:ax:schema:blob\" })\n119|\t\t\t}, \"not the clone raw object manifest\"},\n120|\t\t\t{\"bad version\", func(t *testing.T) []byte {\n121|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"schema_version\"] = \"2.0.0\" })\n122|\t\t\t}, \"not 1.0.0\"},\n123|\t\t\t{\"total mismatch\", func(t *testing.T) []byte {\n124|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"total_bytes\"] = float64(1) })\n125|\t\t\t}, \"entries sum to\"},\n126|\t\t\t{\"excluded class entry\", func(t *testing.T) []byte {\n127|\t\t\t\treturn tamper(t, valid, func(o map[string]any) {\n128|\t\t\t\t\tentries := o[\"entries\"].([]any)\n129|\t\t\t\t\tentries[0].(map[string]any)[\"class\"] = \"credential\"\n130|\t\t\t\t})\n131|\t\t\t}, \"outside the raw subset\"},\n132|\t\t\t{\"unsorted entries\", func(t *testing.T) []byte {\n133|\t\t\t\treturn tamper(t, valid, func(o map[string]any) {\n134|\t\t\t\t\tentries := o[\"entries\"].([]any)\n135|\t\t\t\t\tentries[0], entries[1] = entries[1], entries[0]\n136|\t\t\t\t})\n137|\t\t\t}, \"sorted unique\"},\n138|\t\t\t{\"unsanitized source id\", func(t *testing.T) []byte {\n139|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"source_native_session_id\"] = \"/abs/path\" })\n140|\t\t\t}, \"absolute source path\"},\n141|\t\t\t{\"bad extensions\", func(t *testing.T) []byte {\n142|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"extensions\"] = map[string]any{\"no-dots\": 1} })\n143|\t\t\t}, \"reverse-DNS\"},\n144|\t\t\t{\"self digest mismatch\", func(t *testing.T) []byte {\n145|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"raw_object_manifest_id\"] = fixtureDigest(\"forged\") })\n146|\t\t\t}, \"omit-self digest\"},\n147|\t\t\t{\"not an object\", func(t *testing.T) []byte { return []byte(`[1,2]`) }, \"\"},\n148|\t\t\t{\"duplicate member\", func(t *testing.T) []byte {\n149|\t\t\t\treturn []byte(`{\"schema\":\"urn:ax:schema:clone-raw-object-manifest\",\"schema\":\"urn:ax:schema:blob\"}`)\n150|\t\t\t}, \"\"},\n151|\t\t}\n152|\t\tfor _, tc := range cases {\n153|\t\t\tt.Run(tc.name, func(t *testing.T) {\n154|\t\t\t\t_, err := DecodeRawObjectManifest(tc.body(t))\n155|\t\t\t\trequireRefusal(t, err, tc.fragment)\n156|\t\t\t})\n157|\t\t}\n158|\t})\n159|\tt.Run(\"operation and tuple\", func(t *testing.T) {\n160|\t\tinputs := validEntryInputs(t)\n161|\t\tif _, err := BuildRawObjectManifest(\"not-a-uuid\", []byte(fixtureTupleJSON()),\n162|\t\t\t\"native-session-alpha\", identityDigest.String(), fixtureDigest(\"test-capture-plan\"), inputs, nil); !errors.Is(err, ErrInvalid) {\n163|\t\t\tt.Fatalf(\"bad operation_id error = %v, want ErrInvalid\", err)\n164|\t\t}\n165|\t\tif _, err := BuildRawObjectManifest(fixtureOperationID, []byte(`{\"environment_id\":\"x\"}`),\n166|\t\t\t\"native-session-alpha\", identityDigest.String(), fixtureDigest(\"test-capture-plan\"), inputs, nil); !errors.Is(err, ErrInvalid) {\n167|\t\t\tt.Fatalf(\"bad tuple error = %v, want ErrInvalid\", err)\n168|\t\t}\n169|\t\tif _, err := BuildRawObjectManifest(fixtureOperationID, []byte(fixtureTupleJSON()),\n170|\t\t\t\"native-session-alpha\", \"nope\", fixtureDigest(\"test-capture-plan\"), inputs, nil); !errors.Is(err, ErrInvalid) {\n171|\t\t\tt.Fatalf(\"bad identity digest error = %v, want ErrInvalid\", err)\n172|\t\t}\n173|\t\tif _, err := BuildRawObjectManifest(fixtureOperationID, []byte(fixtureTupleJSON()),\n174|\t\t\t\"native-session-alpha\", identityDigest.String(), fixtureDigest(\"test-capture-plan\"), inputs,\n175|\t\t\tmap[string]any{\"no-dots\": 1}); !errors.Is(err, ErrInvalid) {\n176|\t\t\tt.Fatalf(\"bad extensions error = %v, want ErrInvalid\", err)\n177|\t\t}\n178|\t})\n179|}\n180|\n181|func cloneMutate(inputs []EntryInput, mutate func([]EntryInput) []EntryInput) []EntryInput {\n182|\treturn mutate(inputs)\n183|}\n184|\n185|func mustCaptureBytes(t *testing.T) []byte {\n186|\tt.Helper()\n187|\tbuilt, err := BuildCaptureManifest(validCaptureInput(t))\n188|\tif err != nil {\n189|\t\tt.Fatal(err)\n190|\t}\n191|\treturn built\n192|}\n193|\n194|func TestCaptureItemRefusals(t *testing.T) {\n195|\tcount := uint64(7)\n196|\tdescriptor := fixtureDigest(\"test-descriptor\")\n197|\treason := \"credential_excluded\"\n198|\tbuild := func(items []CaptureItemInput) error {\n199|\t\tinput := validCaptureInput(t)\n200|\t\tinput.Items = items\n201|\t\tkeys := make([]string, 0, len(items))\n202|\t\tfor _, item := range items {\n203|\t\t\tkeys = append(keys, item.NativeItemKey)\n204|\t\t}\n205|\t\tinput.PlanKeys = keys\n206|\t\traw := []string{}\n207|\t\tfor _, item := range items {\n208|\t\t\tif item.Disposition == \"included\" {\n209|\t\t\t\traw = append(raw, item.NativeItemKey)\n210|\t\t\t}\n211|\t\t}\n212|\t\tinput.RawKeys = raw\n213|\t\t_, err := BuildCaptureManifest(input)\n214|\t\treturn err\n215|\t}\n216|\tsingle := func(item CaptureItemInput) []CaptureItemInput { return []CaptureItemInput{item} }\n217|\tcases := []struct {\n218|\t\tname     string\n219|\t\titems    []CaptureItemInput\n220|\t\tfragment string\n221|\t}{\n222|\t\t{\"unknown class\", single(CaptureItemInput{NativeItemKey: \"a\", Class: \"mystery\", Disposition: \"excluded\", ExclusionReason: &reason}), \"nine-class\"},\n223|\t\t{\"included with reason\", single(CaptureItemInput{NativeItemKey: \"a\", Class: \"durable_payload\", Disposition: \"included\", BlobDescriptorID: &descriptor, ByteCount: &count, ExclusionReason: &reason}), \"carries an exclusion reason\"},\n224|\t\t{\"included missing descriptor\", single(CaptureItemInput{NativeItemKey: \"a\", Class: \"durable_payload\", Disposition: \"included\", ByteCount: &count}), \"non-null descriptor\"},\n225|\t\t{\"included missing count\", single(CaptureItemInput{NativeItemKey: \"a\", Class: \"durable_payload\", Disposition: \"included\", BlobDescriptorID: &descriptor}), \"non-null descriptor\"},\n226|\t\t{\"excluded with descriptor\", single(CaptureItemInput{NativeItemKey: \"a\", Class: \"credential\", Disposition: \"excluded\", BlobDescriptorID: &descriptor, ExclusionReason: &reason}), \"carries content\"},\n227|\t\t{\"excluded with count\", single(CaptureItemInput{NativeItemKey: \"a\", Class: \"credential\", Disposition: \"excluded\", ByteCount: &count, ExclusionReason: &reason}), \"carries content\"},\n228|\t\t{\"excluded missing reason\", single(CaptureItemInput{NativeItemKey: \"a\", Class: \"credential\", Disposition: \"excluded\"}), \"non-null exclusion reason\"},\n229|\t\t{\"credential included\", single(CaptureItemInput{NativeItemKey: \"a\", Class: \"credential\", Disposition: \"included\", BlobDescriptorID: &descriptor, ByteCount: &count}), \"always excluded\"},\n230|\t\t{\"machine_auth included\", single(CaptureItemInput{NativeItemKey: \"a\", Class: \"machine_auth\", Disposition: \"included\", BlobDescriptorID: &descriptor, ByteCount: &count}), \"always excluded\"},\n231|\t\t{\"runtime_state included\", single(CaptureItemInput{NativeItemKey: \"a\", Class: \"runtime_state\", Disposition: \"included\", BlobDescriptorID: &descriptor, ByteCount: &count}), \"always excluded\"},\n232|\t\t{\"transient_lock included\", single(CaptureItemInput{NativeItemKey: \"a\", Class: \"transient_lock\", Disposition: \"included\", BlobDescriptorID: &descriptor, ByteCount: &count}), \"always excluded\"},\n233|\t\t{\"bad disposition\", single(CaptureItemInput{NativeItemKey: \"a\", Class: \"unknown\", Disposition: \"maybe\", ExclusionReason: &reason}), \"included|excluded\"},\n234|\t\t{\"unsorted items\", []CaptureItemInput{\n235|\t\t\t{NativeItemKey: \"b\", Class: \"unknown\", Disposition: \"excluded\", ExclusionReason: &reason},\n236|\t\t\t{NativeItemKey: \"a\", Class: \"unknown\", Disposition: \"excluded\", ExclusionReason: &reason},\n237|\t\t}, \"sorted bytewise\"},\n238|\t\t{\"duplicate items\", []CaptureItemInput{\n239|\t\t\t{NativeItemKey: \"a\", Class: \"unknown\", Disposition: \"excluded\", ExclusionReason: &reason},\n240|\t\t\t{NativeItemKey: \"a\", Class: \"unknown\", Disposition: \"excluded\", ExclusionReason: &reason},\n241|\t\t}, \"sorted bytewise\"},\n242|\t\t{\"bad descriptor digest\", single(CaptureItemInput{NativeItemKey: \"a\", Class: \"durable_payload\", Disposition: \"included\", BlobDescriptorID: strptr(\"nope\"), ByteCount: &count}), \"not a digest\"},\n243|\t\t{\"empty reason\", single(CaptureItemInput{NativeItemKey: \"a\", Class: \"credential\", Disposition: \"excluded\", ExclusionReason: strptr(\"\")}), \"string[1..128]\"},\n244|\t}\n245|\tfor _, tc := range cases {\n246|\t\tt.Run(tc.name, func(t *testing.T) {\n247|\t\t\trequireRefusal(t, build(tc.items), tc.fragment)\n248|\t\t})\n249|\t}\n250|}\n251|\n252|func TestCaptureManifestRefusals(t *testing.T) {\n253|\tt.Run(\"decode\", func(t *testing.T) {\n254|\t\tvalid := mustCaptureBytes(t)\n255|\t\tcases := []struct {\n256|\t\t\tname     string\n257|\t\t\tbody     func(t *testing.T) []byte\n258|\t\t\tfragment string\n259|\t\t}{\n260|\t\t\t{\"unknown member\", func(t *testing.T) []byte {\n261|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"lease\"] = \"x\" })\n262|\t\t\t}, \"unknown member\"},\n263|\t\t\t{\"bad schema\", func(t *testing.T) []byte {\n264|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"schema\"] = \"urn:ax:schema:blob\" })\n265|\t\t\t}, \"not the clone capture manifest\"},\n266|\t\t\t{\"excluded classes extra\", func(t *testing.T) []byte {\n267|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"excluded_classes\"] = []any{\"credential\", \"unknown\"} })\n268|\t\t\t}, \"exactly the excluded-row classes\"},\n269|\t\t\t{\"excluded classes missing\", func(t *testing.T) []byte {\n270|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"excluded_classes\"] = []any{} })\n271|\t\t\t}, \"exactly the excluded-row classes\"},\n272|\t\t\t{\"excluded classes unsorted\", func(t *testing.T) []byte {\n273|\t\t\t\treturn tamper(t, valid, func(o map[string]any) {\n274|\t\t\t\t\titems := o[\"items\"].([]any)\n275|\t\t\t\t\titems[1].(map[string]any)[\"class\"] = \"credential\"\n276|\t\t\t\t\titems[1].(map[string]any)[\"disposition\"] = \"excluded\"\n277|\t\t\t\t\titems[1].(map[string]any)[\"blob_descriptor_id\"] = nil\n278|\t\t\t\t\titems[1].(map[string]any)[\"byte_count\"] = nil\n279|\t\t\t\t\titems[1].(map[string]any)[\"exclusion_reason\"] = \"operator_policy\"\n280|\t\t\t\t\to[\"excluded_classes\"] = []any{\"runtime_state\", \"credential\"}\n281|\t\t\t\t})\n282|\t\t\t}, \"sorted unique\"},\n283|\t\t\t{\"excluded classes unknown\", func(t *testing.T) []byte {\n284|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"excluded_classes\"] = []any{\"mystery\"} })\n285|\t\t\t}, \"unknown class\"},\n286|\t\t\t{\"raw_complete with unknown\", func(t *testing.T) []byte {\n287|\t\t\t\treturn tamper(t, valid, func(o map[string]any) {\n288|\t\t\t\t\titems := o[\"items\"].([]any)\n289|\t\t\t\t\titems[0].(map[string]any)[\"class\"] = \"unknown\"\n290|\t\t\t\t\to[\"raw_complete\"] = true\n291|\t\t\t\t})\n292|\t\t\t}, \"unknown-class item\"},\n293|\t\t\t{\"bad bundle\", func(t *testing.T) []byte {\n294|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"bundle_id\"] = \"nope\" })\n295|\t\t\t}, \"bundle_id\"},\n296|\t\t\t{\"bad created_at\", func(t *testing.T) []byte {\n297|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"created_at\"] = \"yesterday\" })\n298|\t\t\t}, \"created_at\"},\n299|\t\t\t{\"self mismatch\", func(t *testing.T) []byte {\n300|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"capture_manifest_id\"] = fixtureDigest(\"forged\") })\n301|\t\t\t}, \"omit-self digest\"},\n302|\t\t}\n303|\t\tfor _, tc := range cases {\n304|\t\t\tt.Run(tc.name, func(t *testing.T) {\n305|\t\t\t\t_, err := DecodeCaptureManifest(tc.body(t))\n306|\t\t\t\trequireRefusal(t, err, tc.fragment)\n307|\t\t\t})\n308|\t\t}\n309|\t})\n310|\tt.Run(\"reconciliation\", func(t *testing.T) {\n311|\t\tinput := validCaptureInput(t)\n312|\t\tbuilt, err := BuildCaptureManifest(input)\n313|\t\tif err != nil {\n314|\t\t\tt.Fatal(err)\n315|\t\t}\n316|\t\tmanifest, err := DecodeCaptureManifest(built)\n317|\t\tif err != nil {\n318|\t\t\tt.Fatal(err)\n319|\t\t}\n320|\t\tif err := VerifyCaptureReconciliation(manifest, []string{\"store/blob-a\"}, input.RawKeys); !errors.Is(err, ErrInvalid) {\n321|\t\t\tt.Fatalf(\"short plan error = %v, want ErrInvalid\", err)\n322|\t\t}\n323|\t\tif err := VerifyCaptureReconciliation(manifest, input.PlanKeys, []string{\"store/blob-a\"}); !errors.Is(err, ErrInvalid) {\n324|\t\t\tt.Fatalf(\"short raw error = %v, want ErrInvalid\", err)\n325|\t\t}\n326|\t\t// A manifest whose flag disagrees with the derivation is refused\n327|\t\t// even when the key sets reconcile.\n328|\t\tflipped := manifest\n329|\t\tflipped.RawComplete = false\n330|\t\tif err := VerifyCaptureReconciliation(flipped, input.PlanKeys, input.RawKeys); !errors.Is(err, ErrInvalid) {\n331|\t\t\tt.Fatalf(\"flipped flag error = %v, want ErrInvalid\", err)\n332|\t\t}\n333|\t\tincomplete := manifest\n334|\t\tincomplete.RawComplete = false\n335|\t\tif err := RefuseMaximalSafeUnlessComplete(incomplete); !errors.Is(err, ErrInvalid) {\n336|\t\t\tt.Fatalf(\"incomplete maximal_safe error = %v, want ErrInvalid\", err)\n337|\t\t}\n338|\t})\n339|\tt.Run(\"build envelope\", func(t *testing.T) {\n340|\t\tinput := validCaptureInput(t)\n341|\t\tinput.BundleID = \"nope\"\n342|\t\tif _, err := BuildCaptureManifest(input); !errors.Is(err, ErrInvalid) {\n343|\t\t\tt.Fatalf(\"bad bundle error = %v, want ErrInvalid\", err)\n344|\t\t}\n345|\t\tinput = validCaptureInput(t)\n346|\t\tinput.CreatedAt = \"yesterday\"\n347|\t\tif _, err := BuildCaptureManifest(input); !errors.Is(err, ErrInvalid) {\n348|\t\t\tt