{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c991","stream":{"kind":"session","id":"01a0b0d3-448d-7fa1-9a80-daada0956017"},"sequence":803,"recorded_at":1780531400001601,"record_type":"event","durability":"durable","causation_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","run_stream":{"kind":"run","id":"f02750e1-95aa-4722-a114-f72ebe5c150a"},"task_stream":{"kind":"task","id":"01a0b0d5-3588-7481-9d52-d3740f896ddb"},"task_id":"01a0b0d5-3588-7481-9d52-d3740f896ddb","event":{"kind":"output","task_id":"01a0b0d5-3588-7481-9d52-d3740f896ddb","chunk":"Read text file `internal/environ/decode.go`.\n(249 line(s) above)\n250|\tvar value uint64\n251|\tfor index := 0; index < len(literal); index++ {\n252|\t\tdigit := literal[index]\n253|\t\tif digit < '0' || digit > '9' {\n254|\t\t\treturn 0, false\n255|\t\t}\n256|\t\tvalue = value*10 + uint64(digit-'0')\n257|\t\tif value > maxUint53 {\n258|\t\t\treturn 0, false\n259|\t\t}\n260|\t}\n261|\treturn value, true\n262|}\n263|\n264|// StringLength is the Section 1.6 string measure in characters,\n265|// not bytes: a bound of string[1..128] admits 128 characters of\n266|// any width. Byte-counted exec rules (Provider SpawnPlan argv and\n267|// env literals, Section 5.1) do not go through here; the measure\n268|// battery ledgers that split.\n269|func StringLength(value string) int {\n270|\treturn utf8.RuneCountInString(value)\n271|}\n272|\n273|// CheckStringBounds reports whether the member is a JSON string\n274|// whose character count falls in the inclusive bound.\n275|func CheckStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n276|\tvalue, ok := rawString(raw)\n277|\tif !ok {\n278|\t\treturn \"\", false\n279|\t}\n280|\tlength := StringLength(value)\n281|\tif length < minimum || length > maximum {\n282|\t\treturn \"\", false\n283|\t}\n284|\treturn value, true\n285|}\n286|\n287|// CheckUint53Bounds reports whether the member is a uint53 in the\n288|// inclusive bound. Both edges are checked: a one-sided check\n289|// would admit the open side.\n290|func CheckUint53Bounds(raw json.RawMessage, minimum, maximum uint64) (uint64, bool) {\n291|\tvalue, ok := rawUint53(raw)\n292|\tif !ok {\n293|\t\treturn 0, false\n294|\t}\n295|\tif value < minimum || value > maximum {\n296|\t\treturn 0, false\n297|\t}\n298|\treturn value, true\n299|}\n300|\n301|// CheckDigest reports whether the member is a digest of the\n302|// pinned sha256 form.\n303|func CheckDigest(raw json.RawMessage) (scalar.Digest, bool) {\n304|\tvalue, ok := rawString(raw)\n305|\tif !ok {\n306|\t\treturn scalar.Digest{}, false\n307|\t}\n308|\tdigest, err := scalar.ParseDigest(value)\n309|\tif err != nil {\n310|\t\treturn scalar.Digest{}, false\n311|\t}\n312|\treturn digest, true\n313|}\n314|\n315|// CheckUUIDv7 reports whether the member is a lowercase UUIDv7.\n316|func CheckUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n317|\tvalue, ok := rawString(raw)\n318|\tif !ok {\n319|\t\treturn scalar.UUIDv7{}, false\n320|\t}\n321|\tidentifier, err := scalar.ParseUUIDv7(value)\n322|\tif err != nil {\n323|\t\treturn scalar.UUIDv7{}, false\n324|\t}\n325|\treturn identifier, true\n326|}\n327|\n328|// CheckTimestamp reports whether the member is a pinned\n329|// timestamp.\n330|func CheckTimestamp(raw json.RawMessage) (scalar.Timestamp, bool) {\n331|\tvalue, ok := rawString(raw)\n332|\tif !ok {\n333|\t\treturn scalar.Timestamp{}, false\n334|\t}\n335|\tinstant, err := scalar.ParseTimestamp(value)\n336|\tif err != nil {\n337|\t\treturn scalar.Timestamp{}, false\n338|\t}\n339|\treturn instant, true\n340|}\n341|\n342|// isNull reports whether the member is an explicit JSON null.\n343|func isNull(raw json.RawMessage) bool {\n344|\treturn string(bytes.TrimSpace(raw)) == \"null\"\n345|}\n346|\n347|func bytesTrimSpace(raw json.RawMessage) []byte {\n348|\treturn bytes.TrimSpace(raw)\n349|}\n350|\n351|// reverseDNSPattern is the extensions-key grammar: at least two\n352|// dot-separated labels, each starting with a lowercase letter.\n353|var reverseDNSPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,62}(\\.[a-z][a-z0-9-]{0,62})+$`)\n354|\n355|// CheckExtensions reports whether the member is an object whose\n356|// every key is reverse-DNS. Extensions never add operations,\n357|// capabilities, or trust facts; the key grammar is the part of\n358|// that rule decidable from one body.\n359|func CheckExtensions(raw json.RawMessage) bool {\n360|\tmembers, fault := DecodeStrictObject(bytesTrimSpace(raw))\n361|\tif fault != nil {\n362|\t\treturn false\n363|\t}\n364|\tfor name := range members {\n365|\t\tif len(name) < 3 || len(name) > 253 || !reverseDNSPattern.MatchString(name) {\n366|\t\t\treturn false\n367|\t\t}\n368|\t}\n369|\treturn true\n370|}\n371|\n372|// decodeArray reads a JSON array member into its raw elements. A\n373|// non-array — including null — is not an empty array.\n374|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n375|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n376|\ttoken, err := decoder.Token()\n377|\tif err != nil {\n378|\t\treturn nil, false\n379|\t}\n380|\tdelim, ok := token.(json.Delim)\n381|\tif !ok || delim != '[' {\n382|\t\treturn nil, false\n383|\t}\n384|\tvar elements []json.RawMessage\n385|\tfor decoder.More() {\n386|\t\tvar element json.RawMessage\n387|\t\tif err := decoder.Decode(&element); err != nil {\n388|\t\t\treturn nil, false\n389|\t\t}\n390|\t\telements = append(elements, element)\n391|\t}\n392|\tif token, err := decoder.Token(); err != nil {\n393|\t\treturn nil, false\n394|\t} else if delim, ok := token.(json.Delim); !ok || delim != ']' {\n395|\t\treturn nil, false\n396|\t}\n397|\tif _, err := decoder.Token(); err != io.EOF {\n398|\t\treturn nil, false\n399|\t}\n400|\treturn elements, true\n401|}\n402|\n403|// CheckSortedUniqueStrings reports whether the member is an array\n404|// of strings in the item bound whose JCS encodings order strictly\n405|// increasingly with no duplicates. Bytewise JCS order over\n406|// strings is plain lexicographic order, so the check compares\n407|// directly; the count bound is checked on both edges.\n408|//\n409|// Ordering and uniqueness are two obligations, not one: an\n410|// unsorted-but-unique vector and a sorted-but-duplicated vector\n411|// are separate rows in this package's sorted-strings battery\n412|// (TestCheckSortedUniqueStringsHalves drives this function\n413|// directly), so a check that enforced only one half could not\n414|// pass both. The observation battery covers the digest twin,\n415|// not this function.\n416|func CheckSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n417|\telements, ok := decodeArray(raw)\n418|\tif !ok {\n419|\t\treturn nil, false\n420|\t}\n421|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n422|\t\treturn nil, false\n423|\t}\n424|\tvalues := make([]string, 0, len(elements))\n425|\tfor _, element := range elements {\n426|\t\tvalue, ok := CheckStringBounds(element, minimumLength, maximumLength)\n427|\t\tif !ok {\n428|\t\t\treturn nil, false\n429|\t\t}\n430|\t\tvalues = append(values, value)\n431|\t}\n432|\tfor index := 1; index < len(values); index++ {\n433|\t\tif values[index-1] >= values[index] {\n434|\t\t\treturn nil, false\n435|\t\t}\n436|\t}\n437|\treturn values, true\n438|}\n439|\n440|// CheckSortedUniqueDigests reports whether the member is an array\n441|// of digests in the count bound, ordered strictly increasingly\n442|// with no duplicates.\n443|func CheckSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\n444|\telements, ok := decodeArray(raw)\n445|\tif !ok {\n446|\t\treturn nil, false\n447|\t}\n448|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n449|\t\treturn nil, false\n450|\t}\n451|\tvalues := make([]scalar.Digest, 0, len(elements))\n452|\tfor _, element := range elements {\n453|\t\tdigest, ok := CheckDigest(element)\n454|\t\tif !ok {\n455|\t\t\treturn nil, false\n456|\t\t}\n457|\t\tvalues = append(values, digest)\n458|\t}\n459|\tfor index := 1; index < len(values); index++ {\n460|\t\tif values[index-1].String() >= values[index].String() {\n461|\t\t\treturn nil, false\n462|\t\t}\n463|\t}\n464|\treturn values, true\n465|}\n466|\n467|// refuse builds the package error for one refused member: the\n468|// rule in human text automation must never branch on, naming the\n469|// member. Tests assert the full text, so a reworded rule fails\n(more lines below)","final_result":true}}}
