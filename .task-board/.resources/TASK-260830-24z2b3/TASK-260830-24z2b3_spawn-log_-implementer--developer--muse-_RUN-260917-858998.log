NativeIdentity(json.RawMessage(encoded)); err != nil {\n+\t\treturn scalar.Digest{}, invalid(\"native identity digest seals no undecodable identity: %v\", err)\n+\t}\n+\treturn scalar.SHA256Digest(encoded), nil\n+}\n","final_result":true}}}
