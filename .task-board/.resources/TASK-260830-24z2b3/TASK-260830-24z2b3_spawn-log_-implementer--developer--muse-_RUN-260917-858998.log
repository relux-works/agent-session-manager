+\t}\n+\treturn scalar.SHA256Digest(encoded), nil\n+}\n","edit_facts":{"tool_name":"edit_file","path":"internal/clonebundle/rawmanifest.go","added":18,"removed":12},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
