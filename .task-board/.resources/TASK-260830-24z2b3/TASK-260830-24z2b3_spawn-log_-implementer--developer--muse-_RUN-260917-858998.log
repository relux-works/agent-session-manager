{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb3f","stream":{"kind":"session","id":"01a0b0d3-448d-7fa1-9a80-daada0956017"},"sequence":1018,"recorded_at":1780531400002031,"record_type":"event","durability":"durable","causation_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","run_stream":{"kind":"run","id":"f02750e1-95aa-4722-a114-f72ebe5c150a"},"task_stream":{"kind":"task","id":"01a0b0d7-9914-7d83-be99-0a15311ea385"},"task_id":"01a0b0d7-9914-7d83-be99-0a15311ea385","event":{"kind":"output","task_id":"01a0b0d7-9914-7d83-be99-0a15311ea385","chunk":"Read text file `internal/canonicaljson/canonical.go`.\n(199 line(s) above)\n200|// fixture is quoted from the table row that declares that fixture:\n201|//\n202|//\tSPEC.md:292 \"A decoder MUST reject a numeric literal at or beyond <code>2^53</code> even if its host language can represent it\"\n203|//\tSPEC.md:295 \"Implementations MUST NOT round a value and continue.\"\n204|//\tSPEC.md:301 NUM-UNSAFE-NUMBER \"Reject before identity calculation with <code>incompatible_schema</code>\"\n205|//\tSPEC.md:302 NUM-UNSAFE-ROUND \"Reject from the JSON number token before conversion to a host double; an implementation that first rounds it to 9007199254740992 is nonconforming\"\n206|//\n207|// NUM-UNSAFE-ROUND describes this implementation exactly: validateAXNumbers\n208|// refuses the literal on the json.Number token, before any conversion to a host\n209|// double, and it runs inside prepareObjectIdentity before any canonical bytes\n210|// exist. It is reached from these exported entry points, each of which refuses\n211|// all three literals above with a typed error:\n212|//\n213|//\tCalculateObjectIdentity\n214|//\tVerifyObjectIdentity\n215|//\tValidateObservationEvent\n216|//\tValidateObservationStream\n217|//\n218|// Canonicalize itself carries no such guarantee. It is a byte transform over\n219|// whatever RFC 8785 accepts, and this package exports no standalone AX number\n220|// validator, so a caller that needs the AX number model must reach it through\n221|// one of the entry points named above rather than by canonicalizing first.\n222|func Canonicalize(input []byte) ([]byte, error) {\n223|\tvalue, err := decodeStrict(input)\n224|\tif err != nil {\n225|\t\treturn nil, err\n226|\t}\n227|\t// Re-encode the parsed logical value before the JCS transform. This removes\n228|\t// leading/trailing whitespace around primitive top-level values without\n229|\t// changing json.Number tokens or string data.\n230|\tnormalized, err := json.Marshal(value)\n231|\tif err != nil {\n232|\t\treturn nil, invalidJSON(\"serialize logical JSON value: %v\", err)\n233|\t}\n234|\tcanonical, err := jcs.Transform(normalized)\n235|\tif err != nil {\n236|\t\treturn nil, invalidJSON(\"canonicalize RFC 8785 value: %v\", err)\n237|\t}\n238|\treturn canonical, nil\n239|}\n240|\n241|// CalculateObjectIdentity validates the AX common logical number model,\n242|// resolves the one self field from the object's trusted schema/version\n243|// contract, omits that field, applies RFC 8785 JCS, and returns the SHA-256\n244|// identity. Callers cannot select an arbitrary field to omit, which prevents\n245|// self inclusion and digest cycles.\n246|//\n247|// This is where the AX safe-integer refusal lives, not in Canonicalize: a\n248|// literal at or beyond 2^53, or any floating-point literal, is refused here\n249|// with ErrInvalidIdentity before canonical bytes are produced. See the DIVISION\n250|// OF GUARANTEES note on Canonicalize.\n251|func CalculateObjectIdentity(input []byte) (scalar.Digest, SelfField, error) {\n252|\tobject, selfField, _, err := prepareObjectIdentity(input)\n253|\tif err != nil {\n254|\t\treturn scalar.Digest{}, \"\", err\n255|\t}\n256|\treturn calculatePreparedObjectIdentity(object, selfField)\n257|}\n258|\n259|func prepareObjectIdentity(input []byte) (map[string]any, SelfField, scalar.Digest, error) {\n260|\tif len(input) > 5_242_880 {\n261|\t\treturn nil, \"\", scalar.Digest{}, invalidIdentity(\"encoded identity object is %d bytes, maximum is 5242880\", len(input))\n262|\t}\n263|\tvalue, err := decodeStrict(input)\n264|\tif err != nil {\n265|\t\treturn nil, \"\", scalar.Digest{}, err\n266|\t}\n267|\tif err := validateAXNumbers(value); err != nil {\n268|\t\treturn nil, \"\", scalar.Digest{}, err\n269|\t}\n270|\tobject, ok := value.(map[string]any)\n271|\tif !ok {\n272|\t\treturn nil, \"\", scalar.Digest{}, invalidIdentity(\"identity input must be a JSON object\")\n273|\t}\n274|\n275|\tselfField, claimed, err := resolveSelfField(object)\n276|\tif err != nil {\n277|\t\treturn nil, \"\", scalar.Digest{}, err\n278|\t}\n279|\t// This is the composed production gate: closed contract validation happens\n280|\t// after trusted schema selection and before either calculation or attestation.\n281|\tif err := validateImmutableObjectShape(object); err != nil {\n282|\t\treturn nil, \"\", scalar.Digest{}, err\n283|\t}\n284|\treturn object, selfField, claimed, nil\n285|}\n286|\n287|func calculatePreparedObjectIdentity(object map[string]any, selfField SelfField) (scalar.Digest, SelfField, error) {\n288|\tomitted := make(map[string]any, len(object)-1)\n289|\tfor name, member := range object {\n290|\t\tif name != string(selfField) {\n291|\t\t\tomitted[name] = member\n292|\t\t}\n293|\t}\n294|\tserialized, err := json.Marshal(omitted)\n295|\tif err != nil {\n296|\t\treturn scalar.Digest{}, \"\", invalidIdentity(\"serialize omit-self object: %v\", err)\n297|\t}\n298|\tcanonical, err := jcs.Transform(serialized)\n299|\tif err != nil {\n300|\t\treturn scalar.Digest{}, \"\", invalidIdentity(\"canonicalize omit-self object: %v\", err)\n301|\t}\n302|\treturn scalar.SHA256Digest(canonical), selfField, nil\n303|}\n304|\n305|// VerifyObjectIdentity drives the same production calculation and refuses a\n306|// malformed, self-included, or otherwise mismatched claimed identity. It shares\n307|// prepareObjectIdentity with CalculateObjectIdentity, so it carries the same AX\n308|// safe-integer guarantee that Canonicalize does not.\n309|func VerifyObjectIdentity(input []byte) (scalar.Digest, SelfField, error) {\n310|\tobject, selfField, claimed, err := prepareObjectIdentity(input)\n311|\tif err != nil {\n312|\t\treturn scalar.Digest{}, \"\", err\n313|\t}\n314|\tcalculated, calculatedField, err := calculatePreparedObjectIdentity(object, selfField)\n315|\tif err != nil {\n316|\t\treturn scalar.Digest{}, \"\", err\n317|\t}\n318|\tif calculatedField != selfField || claimed != calculated {\n319|\t\treturn scalar.Digest{}, \"\", invalidIdentity(\n320|\t\t\t\"%s claim %q does not match omit-self digest %q\",\n321|\t\t\tselfField,\n322|\t\t\tclaimed,\n323|\t\t\tcalculated,\n324|\t\t)\n325|\t}\n326|\treturn calculated, selfField, nil\n327|}\n328|\n329|func resolveSelfField(object map[string]any) (SelfField, scalar.Digest, error) {\n330|\tschema, err := requiredStringMember(object, \"schema\")\n331|\tif err != nil {\n332|\t\treturn \"\", scalar.Digest{}, err\n333|\t}\n334|\tversion, err := requiredStringMember(object, \"schema_version\")\n335|\tif err != nil {\n336|\t\treturn \"\", scalar.Digest{}, err\n337|\t}\n338|\tcontract, ok := schemaIdentityContracts[schemaIdentityKey{schema: schema, version: version}]\n339|\tif !ok {\n(more lines below)","final_result":true}}}
