{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8ef","stream":{"kind":"session","id":"01a0b0d3-448d-7fa1-9a80-daada0956017"},"sequence":722,"recorded_at":1780531400001439,"record_type":"event","durability":"durable","causation_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","run_stream":{"kind":"run","id":"f02750e1-95aa-4722-a114-f72ebe5c150a"},"call_id":"call_01a0b0d5052575fc9897ec801a571f49","text":"Read text file `internal/clonebundle/boundary.go`.\n(499 line(s) above)\n500|\tForegroundIdle    bool\n501|\tBackgroundIdle    bool\n502|\tCore              bool\n503|}\n504|\n505|func buildBoundary(input BoundaryInput) (CaptureBoundary, map[string]any, error) {\n506|\tswitch input.Kind {\n507|\tcase \"stable\":\n508|\t\tproof, object, err := buildStableProof(input)\n509|\t\tif err != nil {\n510|\t\t\treturn CaptureBoundary{}, nil, err\n511|\t\t}\n512|\t\tboundary := CaptureBoundary{Kind: \"stable\", Proof: &proof}\n513|\t\treturn boundary, map[string]any{\n514|\t\t\t\"kind\":       \"stable\",\n515|\t\t\t\"proof\":      object,\n516|\t\t\t\"extensions\": map[string]any{},\n517|\t\t}, nil\n518|\tcase \"unstable_archive\":\n519|\t\tif !input.Core {\n520|\t\t\treturn CaptureBoundary{}, nil, invalid(\"capture boundary unstable_archive is core-created only\")\n521|\t\t}\n522|\t\tgeneration, err := ParseGeneration(input.Generation)\n523|\t\tif err != nil {\n524|\t\t\treturn CaptureBoundary{}, nil, err\n525|\t\t}\n526|\t\tpre, err := scalar.ParseDigest(input.PreCaptureDigest)\n527|\t\tif err != nil {\n528|\t\t\treturn CaptureBoundary{}, nil, invalid(\"capture boundary pre_capture_digest is not a digest: %v\", err)\n529|\t\t}\n530|\t\tpost, err := scalar.ParseDigest(input.PostCaptureDigest)\n531|\t\tif err != nil {\n532|\t\t\treturn CaptureBoundary{}, nil, invalid(\"capture boundary post_capture_digest is not a digest: %v\", err)\n533|\t\t}\n534|\t\tboundary := CaptureBoundary{\n535|\t\t\tKind:              \"unstable_archive\",\n536|\t\t\tSourceGeneration:  &generation,\n537|\t\t\tPreCaptureDigest:  &pre,\n538|\t\t\tPostCaptureDigest: &post,\n539|\t\t}\n540|\t\treturn boundary, map[string]any{\n541|\t\t\t\"kind\":                        \"unstable_archive\",\n542|\t\t\t\"source_generation\":           generation.String(),\n543|\t\t\t\"pre_capture_digest\":          pre.String(),\n544|\t\t\t\"post_capture_digest\":         post.String(),\n545|\t\t\t\"reason_code\":                 \"source_not_quiescent\",\n546|\t\t\t\"operator_explicit\":           true,\n547|\t\t\t\"target_projection_forbidden\": true,\n548|\t\t\t\"extensions\":                  map[string]any{},\n549|\t\t}, nil\n550|\tdefault:\n551|\t\treturn CaptureBoundary{}, nil, invalid(\"capture boundary kind is outside stable|unstable_archive\")\n552|\t}\n553|}\n554|\n555|func buildStableProof(input BoundaryInput) (StableSnapshotProof, map[string]any, error) {\n556|\tif !validProofKind(input.ProofKind) {\n557|\t\treturn StableSnapshotProof{}, nil, invalid(\"stable snapshot proof kind is outside the closed proof vocabulary\")\n558|\t}\n559|\tgeneration, err := ParseGeneration(input.Generation)\n560|\tif err != nil {\n561|\t\treturn StableSnapshotProof{}, nil, err\n562|\t}\n563|\tvar identity *scalar.Digest\n564|\tif input.SnapshotIdentity != nil {\n565|\t\tvalue, err := scalar.ParseDigest(*input.SnapshotIdentity)\n566|\t\tif err != nil {\n567|\t\t\treturn StableSnapshotProof{}, nil, invalid(\"stable snapshot proof snapshot_identity_digest is not a digest: %v\", err)\n568|\t\t}\n569|\t\tidentity = &value\n570|\t}\n571|\tpre, err := scalar.ParseDigest(input.PreCaptureDigest)\n572|\tif err != nil {\n573|\t\treturn StableSnapshotProof{}, nil, invalid(\"stable snapshot proof pre_capture_digest is not a digest: %v\", err)\n574|\t}\n575|\tpost, err := scalar.ParseDigest(input.PostCaptureDigest)\n576|\tif err != nil {\n577|\t\treturn StableSnapshotProof{}, nil, invalid(\"stable snapshot proof post_capture_digest is not a digest: %v\", err)\n578|\t}\n579|\tproof := StableSnapshotProof{\n580|\t\tProofKind:         input.ProofKind,\n581|\t\tSourceGeneration:  generation,\n582|\t\tSnapshotIdentity:  identity,\n583|\t\tPreCaptureDigest:  pre,\n584|\t\tPostCaptureDigest: post,\n585|\t\tInputBlocked:      input.InputBlocked,\n586|\t\tForegroundIdle:    input.ForegroundIdle,\n587|\t\tBackgroundIdle:    input.BackgroundIdle,\n588|\t}\n589|\tif err := checkProofCoupling(proof); err != nil {\n590|\t\treturn StableSnapshotProof{}, nil, err\n591|\t}\n592|\tvar identityValue any\n593|\tif identity != nil {\n594|\t\tidentityValue = identity.String()\n595|\t}\n596|\treturn proof, map[string]any{\n597|\t\t\"proof_kind\":               proof.ProofKind,\n598|\t\t\"source_generation\":        generation.String(),\n599|\t\t\"snapshot_identity_digest\": identityValue,\n600|\t\t\"pre_capture_digest\":       pre.String(),\n601|\t\t\"post_capture_digest\":      post.String(),\n602|\t\t\"input_blocked\":            proof.InputBlocked,\n603|\t\t\"foreground_idle\":          proof.ForegroundIdle,\n604|\t\t\"background_idle\":          proof.BackgroundIdle,\n605|\t\t\"extensions\":               map[string]any{},\n606|\t}, nil\n607|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8f1","stream":{"kind":"session","id":"01a0b0d3-448d-7fa1-9a80-daada0956017"},"sequence":723,"recorded_at":1780531400001441,"record_type":"event","durability":"durable","causation_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","run_stream":{"kind":"run","id":"f02750e1-95aa-4722-a114-f72ebe5c150a"},"call_id":"call_01a0b0d507d971419e8646b356f05fc3","text":"Read text file `internal/clonebundle/generation.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n7|)\n8|\n9|// This file owns the Section 13.14.1 immutable generations: the\n10|// source_generation strings carried by StableSnapshotProof and the\n11|// unstable-archive Capture Boundary, and the snapshot-identity digest\n12|// that pins an immutable snapshot. Generations are opaque immutable\n13|// tokens: a generation never mutates, and equality is exact string\n14|// equality. Capture digests that must agree (stable pre/post) are\n15|// compared by digest equality here so both boundary validators share\n16|// one comparison.\n17|\n18|// Generation is one validated immutable source generation token:\n19|// string[1..512], opaque to the core.\n20|type Generation struct {\n21|\tvalue string\n22|}\n23|\n24|// ParseGeneration validates one generation token. Empty and\n25|// over-long tokens are refused; every other byte content crosses\n26|// opaquely, because generations are native-store tokens the core\n27|// compares but never interprets.\n28|func ParseGeneration(value string) (Generation, error) {\n29|\tif len(value) < 1 || len(value) > 512 {\n30|\t\treturn Generation{}, invalid(\"source generation is not a string[1..512]\")\n31|\t}\n32|\treturn Generation{value: value}, nil\n33|}\n34|\n35|// MustParseGeneration validates one generation token and panics on\n36|// refusal. Tests and fixed fixtures use it; production paths use\n37|// ParseGeneration and return the refusal.\n38|func MustParseGeneration(value string) Generation {\n39|\tgeneration, err := ParseGeneration(value)\n40|\tif err != nil {\n41|\t\tpanic(err)\n42|\t}\n43|\treturn generation\n44|}\n45|\n46|func (generation Generation) String() string { return generation.value }\n47|\n48|// Equal reports exact generation equality. Generations are\n49|// immutable: two captures name the same source state if and only if\n50|// their tokens are byte-identical.\n51|func (generation Generation) Equal(other Generation) bool {\n52|\treturn generation.value == other.value\n53|}\n54|\n55|func checkGeneration(raw json.RawMessage) (Generation, bool) {\n56|\tvalue, ok := checkStringBounds(raw, 1, 512)\n57|\tif !ok {\n58|\t\treturn Generation{}, false\n59|\t}\n60|\tgeneration, err := ParseGeneration(value)\n61|\tif err != nil {\n62|\t\treturn Generation{}, false\n63|\t}\n64|\treturn generation, true\n65|}\n66|\n67|// CheckDigestsEqual refuses two capture digests that differ. Stable\n68|// capture requires equal pre/post digests; file-size equality is\n69|// never proof and is not consulted here.\n70|func CheckDigestsEqual(pre, post scalar.Digest) error {\n71|\tif pre != post {\n72|\t\treturn invalid(\"capture digests differ: pre %q, post %q\", pre.String(), post.String())\n73|\t}\n74|\treturn nil\n75|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8f3","stream":{"kind":"session","id":"01a0b0d3-448d-7fa1-9a80-daada0956017"},"sequence":724,"recorded_at":1780531400001443,"record_type":"event","durability":"durable","causation_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","run_stream":{"kind":"run","id":"f02750e1-95aa-4722-a114-f72ebe5c150a"},"call_id":"call_01a0b0d509cf77bdb1bb3d925b0ff781","text":"Read text file `internal/clonebundle/doc.go`.\n1|package clonebundle\n2|\n3|// This package implements the Section 13.14.1 clone capture contracts:\n4|// Clone Raw Object Manifest 1.0.0, Clone Capture Manifest 1.0.0 (with\n5|// Capture Items, Capture Source Basis, and Capture Boundary), Canonical\n6|// Session 1.0.0, Canonical Event 1.0.0 (with Source Evidence and raw\n7|// references), the NativeIdentity and WorkspaceBinding identities, raw\n8|// evidence descriptor agreement over Section 10.2 Blob Descriptors,\n9|// reverse-DNS extension keys, and immutable source generations.\n10|//\n11|// Authority: relux-works/agent-session-manager-spec@v0.6.0, Sections\n12|// 7.8, 10.2, and 13.14.1 (internal/specdoc/SPEC.v0.6.0.md).\n13|//\n14|// Every Decode entry validates a closed shape: exact members, bounded\n15|// scalars, closed vocabularies, sorted-unique order, and self-digest\n16|// agreement. Every Build entry constructs the same bytes\n17|// deterministically: identical inputs produce byte-identical outputs,\n18|// and every Build output decodes clean. Refusals name the offending\n19|// member and never admit a partial object.\n20|//\n21|// Reuse, not fork: Environment Tuples decode through\n22|// sessadapter.DecodeTuple, Blob Descriptors verify through\n23|// canonicaljson.CalculateObjectIdentity plus a local claim comparison\n24|// (never the attesting entry, per the provhost no-attestation bound),\n25|// extension keys admit through\n26|// environ.CheckExtensions, and blob bytes install through\n27|// localstore.ObjectStore.PutBlob. The canonicaljson closed-shape\n28|// registry keeps its rejectUnsupportedImmutableObjectShape rows for\n29|// these schemas (that table's census pins every row, so replacing\n30|// them would fork ownership); this package is the validating owner\n31|// and says so here and in TRACEABILITY.md.\n32|//\n33|// Stated bounds (sibling scope, not waived): per-kind Canonical Event\n34|// payload fact registries beyond the Section 13.14.1 envelope rules\n35|// enforced here; maximal_safe projection gating past the\n36|// raw_complete=false derivation; target-branch (G2) admission beyond\n37|// RefuseUnstableForTarget; capture-plan/capture/normalize adapter\n38|// operation wiring (Section 7.8 bodies stay owned by sessadapter).\n39|// This package performs no durable write itself: blob installation\n40|// delegates to the landed localstore no-replace discipline, and the\n41|// crash/idempotency evidence for that path is cited in\n42|// TRACEABILITY.md.","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
