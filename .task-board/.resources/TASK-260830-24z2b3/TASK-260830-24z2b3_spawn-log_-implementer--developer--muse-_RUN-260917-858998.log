":    filepath.Join(home, \"data\"),\n141|\t\t\t\"--state-dir\":   filepath.Join(home, \"state\"),\n142|\t\t\t\"--cache-dir\":   filepath.Join(home, \"cache\"),\n143|\t\t\t\"--runtime-dir\": filepath.Join(home, \"runtime\"),\n144|\t\t},\n145|\t\tEnvironment:  map[string]string{},\n146|\t\tHomeDir:      home,\n147|\t\tTemporaryDir: filepath.Join(home, \"temporary\"),\n148|\t})\n149|\tif err != nil {\n150|\t\tt.Fatalf(\"ResolvePaths() error = %v\", err)\n151|\t}\n152|\tstore, err := localstore.OpenObjectStore(resolved)\n153|\tif err != nil {\n154|\t\tt.Fatalf(\"OpenObjectStore() error = %v\", err)\n155|\t}\n156|\treturn store\n157|}\n158|\n159|func validEntryInputs(t *testing.T) []EntryInput {\n160|\tt.Helper()\n161|\tfirst, firstBlob, firstDescriptor, firstSize := makeDescriptor(t, []byte(\"first-raw-object\"))\n162|\tsecond, secondBlob, secondDescriptor, secondSize := makeDescriptor(t, []byte(\"second-raw-object\"))\n163|\treturn []EntryInput{\n164|\t\t{NativeItemKey: \"store/blob-a\", Class: \"durable_payload\", ByteCount: firstSize, BlobID: firstBlob, DescriptorID: firstDescriptor, Descriptor: first},\n165|\t\t{NativeItemKey: \"store/blob-b\", Class: \"durable_sidecar\", ByteCount: secondSize, BlobID: secondBlob, DescriptorID: secondDescriptor, Descriptor: second},\n166|\t}\n167|}\n168|\n169|func validCaptureItems(t *testing.T) []CaptureItemInput {\n170|\tt.Helper()\n171|\t_, _, firstDescriptor, firstSize := makeDescriptor(t, []byte(\"first-raw-object\"))\n172|\t_, _, secondDescriptor, secondSize := makeDescriptor(t, []byte(\"second-raw-object\"))\n173|\tfirstCount := firstSize\n174|\tsecondCount := secondSize\n175|\treturn []CaptureItemInput{\n176|\t\t{NativeItemKey: \"store/blob-a\", Class: \"durable_payload\", Disposition: \"included\", BlobDescriptorID: &firstDescriptor, ByteCount: &firstCount},\n177|\t\t{NativeItemKey: \"store/blob-b\", Class: \"durable_sidecar\", Disposition: \"included\", BlobDescriptorID: &secondDescriptor, ByteCount: &secondCount},\n178|\t\t{NativeItemKey: \"store/token-cache\", Class: \"credential\", Disposition: \"excluded\", ExclusionReason: strptr(\"credential_excluded\")},\n179|\t}\n180|}\n181|\n182|func validBoundaryInput() BoundaryInput {\n183|\treturn BoundaryInput{\n184|\t\tKind:              \"stable\",\n185|\t\tProofKind:         \"closed_store\",\n186|\t\tGeneration:        \"generation-42\",\n187|\t\tPreCaptureDigest:  fixtureDigest(\"test-pre-capture\"),\n188|\t\tPostCaptureDigest: fixtureDigest(\"test-pre-capture\"),\n189|\t\tInputBlocked:      true,\n190|\t\tForegroundIdle:    true,\n191|\t\tBackgroundIdle:    true,\n192|\t}\n193|}\n194|\n195|func validCaptureInput(t *testing.T) CaptureManifestInput {\n196|\tt.Helper()\n197|\treturn CaptureManifestInput{\n198|\t\tOperationID: fixtureOperationID,\n199|\t\tBundleID:    fixtureBundleID,\n200|\t\tSourceBasis: SourceBasisInput{\n201|\t\t\tKind:                     \"ax_session\",\n202|\t\t\tSourceSessionID:          fixtureSessionID,\n203|\t\t\tSourceSessionRecordID:    fixtureDigest(fixtureRecordSeed),\n204|\t\t\tSourceCheckpointID:       fixtureDigest(\"test-checkpoint\"),\n205|\t\t\tSourceProviderIdentityID: fixtureDigest(\"test-provider-identity\"),\n206|\t\t},\n207|\t\tSourceEnvironment:   []byte(fixtureTupleJSON()),\n208|\t\tSourceIdentity:      fixtureNativeIdentity(),\n209|\t\tCapturePlanDigest:   fixtureDigest(\"test-capture-plan\"),\n210|\t\tBoundary:            validBoundaryInput(),\n211|\t\tSourceRawManifestID: fixtureDigest(\"test-raw-manifest\"),\n212|\t\tItems:               validCaptureItems(t),\n213|\t\tPlanKeys:            []string{\"store/blob-a\", \"store/blob-b\", \"store/token-cache\"},\n214|\t\tRawKeys:             []string{\"store/blob-a\", \"store/blob-b\"},\n215|\t\tCreatedByHostID:     fixtureHostID,\n216|\t\tCreatedAt:           fixtureCreatedAt,\n217|\t}\n218|}\n219|\n220|func validSessionInput() CanonicalSessionInput {\n221|\treturn CanonicalSessionInput{\n222|\t\tLogicalSessionID:      fixtureSessionID,\n223|\t\tSourceEnvironment:     []byte(fixtureTupleJSON()),\n224|\t\tSourceNativeSessionID: \"native-session-alpha\",\n225|\t\tTitle:                 strptr(\"alpha session\"),\n226|\t\tWorkspace:             []byte(fixtureWorkspaceJSON()),\n227|\t\tActors: []ActorInput{\n228|\t\t\t{ActorID: fixtureActorMain, Kind: \"main\", Name: strptr(\"main\")},\n229|\t\t\t{ActorID: fixtureActorSub, Kind: \"subagent\", ParentActorID: strptr(fixtureActorMain)},\n230|\t\t},\n231|\t\tEventIDs:     []string{fixtureDigest(\"test-event-0\"), fixtureDigest(\"test-event-1\")},\n232|\t\tHeadEventIDs: []string{fixtureDigest(\"test-event-1\")},\n233|\t\tCreatedAt:    strptr(fixtureCreatedAt),\n234|\t}\n235|}\n236|\n237|func validEventInput(status string) CanonicalEventInput {\n238|\tinput := CanonicalEventInput{\n239|\t\tLogicalSessionID: fixtureSessionID,\n240|\t\tOrdinal:          0,\n241|\t\tActorID:          fixtureActorMain,\n242|\t\tKind:             \"user_message\",\n243|\t\tVisibility:       \"public\",\n244|\t\tPayload:          []byte(`{\"content_blocks\":[{\"type\":\"text\",\"content\":\"hello\"}],\"extensions\":{}}`),\n245|\t\tEvidence: EvidenceInput{\n246|\t\t\tEnvironment:     []byte(fixtureTupleJSON()),\n247|\t\t\tNativeSessionID: \"native-session-alpha\",\n248|\t\t\tNativeEventID:   strptr(\"native-event-1\"),\n249|\t\t\tNativeType:      strptr(\"chat.message\"),\n250|\t\t\tRawRefs: []RawRefInput{\n251|\t\t\t\t{ManifestID: fixtureDigest(\"test-raw-manifest\"), BlobDescriptorID: fixtureDigest(\"test-descriptor\"), Offset: 0, Length: 128},\n252|\t\t\t},\n253|\t\t\tCaptureStatus: status,\n254|\t\t\tReasonCodes:   []string{\"source_complete\"},\n255|\t\t},\n256|\t}\n257|\tif status == \"synthesized\" {\n258|\t\tinput.Evidence.NativeEventID = nil\n259|\t\tinput.Evidence.CoreOperationID = strptr(fixtureOperationID)\n260|\t}\n261|\treturn input\n262|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
