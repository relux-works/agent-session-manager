{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c857","stream":{"kind":"session","id":"01a0b0d3-448d-7fa1-9a80-daada0956017"},"sequence":646,"recorded_at":1780531400001287,"record_type":"event","durability":"durable","causation_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","run_stream":{"kind":"run","id":"f02750e1-95aa-4722-a114-f72ebe5c150a"},"task_stream":{"kind":"task","id":"01a0b0d4-f2c3-7473-a711-142fab87f197"},"task_id":"01a0b0d4-f2c3-7473-a711-142fab87f197","event":{"kind":"output","task_id":"01a0b0d4-f2c3-7473-a711-142fab87f197","chunk":"Read text file `internal/clonebundle/event.go`.\n(499 line(s) above)\n500|\t\treturn CanonicalEvent{}, invalid(\"canonical event schema is not the canonical event\")\n501|\t}\n502|\tversion, ok := rawString(members[\"schema_version\"])\n503|\tif !ok || version != canonicalEventVersion {\n504|\t\treturn CanonicalEvent{}, invalid(\"canonical event version is not 1.0.0\")\n505|\t}\n506|\teventID, ok := checkDigest(members[canonicalEventSelf])\n507|\tif !ok {\n508|\t\treturn CanonicalEvent{}, invalid(\"canonical event event_id is not a digest\")\n509|\t}\n510|\tlogical, ok := checkUUIDv7(members[\"logical_session_id\"])\n511|\tif !ok {\n512|\t\treturn CanonicalEvent{}, invalid(\"canonical event logical_session_id is not a UUIDv7\")\n513|\t}\n514|\tordinal, ok := rawUint53(members[\"ordinal\"])\n515|\tif !ok {\n516|\t\treturn CanonicalEvent{}, invalid(\"canonical event ordinal is not a uint53\")\n517|\t}\n518|\tparents, ok := checkSortedUniqueDigests(members[\"parents\"], 0, 64)\n519|\tif !ok {\n520|\t\treturn CanonicalEvent{}, invalid(\"canonical event parents are not sorted unique digest[0..64]\")\n521|\t}\n522|\tactorID, ok := checkUUIDv7(members[\"actor_id\"])\n523|\tif !ok {\n524|\t\treturn CanonicalEvent{}, invalid(\"canonical event actor_id is not a UUIDv7\")\n525|\t}\n526|\tvar turn *scalar.UUIDv7\n527|\tif !isNull(members[\"turn_id\"]) {\n528|\t\tvalue, ok := checkUUIDv7(members[\"turn_id\"])\n529|\t\tif !ok {\n530|\t\t\treturn CanonicalEvent{}, invalid(\"canonical event turn_id is not a UUIDv7\")\n531|\t\t}\n532|\t\tturn = &value\n533|\t}\n534|\tkind, ok := rawString(members[\"kind\"])\n535|\tif !ok || !ValidEventKind(kind) {\n536|\t\treturn CanonicalEvent{}, invalid(\"canonical event kind is outside the 26-kind vocabulary\")\n537|\t}\n538|\tvar stamp *scalar.Timestamp\n539|\tif !isNull(members[\"timestamp\"]) {\n540|\t\tvalue, ok := checkTimestamp(members[\"timestamp\"])\n541|\t\tif !ok {\n542|\t\t\treturn CanonicalEvent{}, invalid(\"canonical event timestamp is not a timestamp\")\n543|\t\t}\n544|\t\tstamp = &value\n545|\t}\n546|\tvisibility, ok := rawString(members[\"visibility\"])\n547|\tif !ok || !validVisibility(visibility) {\n548|\t\treturn CanonicalEvent{}, invalid(\"canonical event visibility is outside public|projection|internal|opaque\")\n549|\t}\n550|\tpayload, err := checkPayload(kind, members[\"payload\"])\n551|\tif err != nil {\n552|\t\treturn CanonicalEvent{}, err\n553|\t}\n554|\tevidence, err := DecodeSourceEvidence(members[\"source_evidence\"])\n555|\tif err != nil {\n556|\t\treturn CanonicalEvent{}, err\n557|\t}\n558|\tif !checkExtensions(members[\"extensions\"]) {\n559|\t\treturn CanonicalEvent{}, invalid(\"canonical event extensions are not reverse-DNS keyed\")\n560|\t}\n561|\tif err := verifySelfDigest(members, canonicalEventSelf, eventID); err != nil {\n562|\t\treturn CanonicalEvent{}, err\n563|\t}\n564|\treturn CanonicalEvent{\n565|\t\tEventID:          eventID,\n566|\t\tLogicalSessionID: logical,\n567|\t\tOrdinal:          ordinal,\n568|\t\tParents:          parents,\n569|\t\tActorID:          actorID,\n570|\t\tTurnID:           turn,\n571|\t\tKind:             kind,\n572|\t\tTimestamp:        stamp,\n573|\t\tVisibility:       visibility,\n574|\t\tPayload:          payload,\n575|\t\tEvidence:         evidence,\n576|\t}, nil\n577|}\n578|\n579|// checkPayload validates the kind-selected closed payload: every\n580|// payload is a strict (duplicate-free) object; message-like kinds\n581|// carry exactly content_blocks plus extensions; content blocks use\n582|// exactly the eight-type vocabulary with typed inline content\n583|// (at most 64 KiB) or Blob Descriptor references. Per-kind fact\n584|// registries beyond this envelope are sibling scope.\n585|func checkPayload(kind string, raw json.RawMessage) (map[string]any, error) {\n586|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n587|\tif fault != nil {\n588|\t\treturn nil, invalid(\"canonical event payload %s (%s)\", fault.detail, memberField(fault.member))\n589|\t}\n590|\tif messageLikeKind(kind) {\n591|\t\tallowed := map[string]bool{\"content_blocks\": true, \"extensions\": true}\n592|\t\tif name, unknown := unknownMember(members, allowed); unknown {\n593|\t\t\treturn nil, invalid(\"canonical event message payload carries unknown member %q\", name)\n594|\t\t}\n595|\t\tblocks, present := members[\"content_blocks\"]\n596|\t\tif !present {\n597|\t\t\treturn nil, invalid(\"canonical event message payload misses content_blocks\")\n598|\t\t}\n599|\t\tif err := checkContentBlocks(blocks); err != nil {\n600|\t\t\treturn nil, err\n601|\t\t}\n602|\t\tif extensions, present := members[\"extensions\"]; present {\n603|\t\t\tif !checkExtensions(extensions) {\n604|\t\t\t\treturn nil, invalid(\"canonical event message payload extensions are not reverse-DNS keyed\")\n605|\t\t\t}\n606|\t\t}\n607|\t} else if blocks, present := members[\"content_blocks\"]; present {\n608|\t\tif err := checkContentBlocks(blocks); err != nil {\n609|\t\t\treturn nil, err\n610|\t\t}\n611|\t}\n612|\tvar payload map[string]any\n613|\tif err := json.Unmarshal(bytesTrimSpace(raw), &payload); err != nil {\n614|\t\treturn nil, invalid(\"canonical event payload is not an object: %v\", err)\n615|\t}\n616|\treturn payload, nil\n617|}\n618|\n619|var 