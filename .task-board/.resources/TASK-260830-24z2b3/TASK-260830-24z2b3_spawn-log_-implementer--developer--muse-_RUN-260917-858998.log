{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8e7","stream":{"kind":"session","id":"01a0b0d3-448d-7fa1-9a80-daada0956017"},"sequence":718,"recorded_at":1780531400001431,"record_type":"event","durability":"durable","causation_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","run_stream":{"kind":"run","id":"f02750e1-95aa-4722-a114-f72ebe5c150a"},"task_stream":{"kind":"task","id":"01a0b0d5-0e89-7642-95c9-6bbcc11de96f"},"task_id":"01a0b0d5-0e89-7642-95c9-6bbcc11de96f","event":{"kind":"output","task_id":"01a0b0d5-0e89-7642-95c9-6bbcc11de96f","chunk":"Read text file `internal/clonebundle/generation.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n7|)\n8|\n9|// This file owns the Section 13.14.1 immutable generations: the\n10|// source_generation strings carried by StableSnapshotProof and the\n11|// unstable-archive Capture Boundary, and the snapshot-identity digest\n12|// that pins an immutable snapshot. Generations are opaque immutable\n13|// tokens: a generation never mutates, and equality is exact string\n14|// equality. Capture digests that must agree (stable pre/post) are\n15|// compared by digest equality here so both boundary validators share\n16|// one comparison.\n17|\n18|// Generation is one validated immutable source generation token:\n19|// string[1..512], opaque to the core.\n20|type Generation struct {\n21|\tvalue string\n22|}\n23|\n24|// ParseGeneration validates one generation token. Empty and\n25|// over-long tokens are refused; every other byte content crosses\n26|// opaquely, because generations are native-store tokens the core\n27|// compares but never interprets.\n28|func ParseGeneration(value string) (Generation, error) {\n29|\tif len(value) < 1 || len(value) > 512 {\n30|\t\treturn Generation{}, invalid(\"source generation is not a string[1..512]\")\n31|\t}\n32|\treturn Generation{value: value}, nil\n33|}\n34|\n35|// MustParseGeneration validates one generation token and panics on\n36|// refusal. Tests and fixed fixtures use it; production paths use\n37|// ParseGeneration and return the refusal.\n38|func MustParseGeneration(value string) Generation {\n39|\tgeneration, err := ParseGeneration(value)\n40|\tif err != nil {\n41|\t\tpanic(err)\n42|\t}\n43|\treturn generation\n44|}\n45|\n46|func (generation Generation) String() string { return generation.value }\n47|\n48|// Equal reports exact generation equality. Generations are\n49|// immutable: two captures name the same source state if and only if\n50|// their tokens are byte-identical.\n51|func (generation Generation) Equal(other Generation) bool {\n52|\treturn generation.value == other.value\n53|}\n54|\n55|func checkGeneration(raw json.RawMessage) (Generation, bool) {\n56|\tvalue, ok := checkStringBounds(raw, 1, 512)\n57|\tif !ok {\n58|\t\treturn Generation{}, false\n59|\t}\n60|\tgeneration, err := ParseGeneration(value)\n61|\tif err != nil {\n62|\t\treturn Generation{}, false\n63|\t}\n64|\treturn generation, true\n65|}\n66|\n67|// CheckDigestsEqual refuses two capture digests that differ. Stable\n68|// capture requires equal pre/post digests; file-size equality is\n69|// never proof and is not consulted here.\n70|func CheckDigestsEqual(pre, post scalar.Digest) error {\n71|\tif pre != post {\n72|\t\treturn invalid(\"capture digests differ: pre %q, post %q\", pre.String(), post.String())\n73|\t}\n74|\treturn nil\n75|}","final_result":true}}}
