{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6ef","stream":{"kind":"session","id":"01a0b0d3-448d-7fa1-9a80-daada0956017"},"sequence":466,"recorded_at":1780531400000927,"record_type":"event","durability":"durable","causation_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","run_stream":{"kind":"run","id":"f02750e1-95aa-4722-a114-f72ebe5c150a"},"task_stream":{"kind":"task","id":"01a0b0d4-5257-73c0-932b-5a2651061865"},"task_id":"01a0b0d4-5257-73c0-932b-5a2651061865","event":{"kind":"output","task_id":"01a0b0d4-5257-73c0-932b-5a2651061865","chunk":"Read text file `internal/clonebundle/testdata/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for internal/clonebundle.\n3|\n4|Every gate ships a narrowing mutant: the gate stays present and is\n5|weakened to admit exactly one member of the class it must reject, and\n6|the named killer test must fail. A delete-only mutant proves only that\n7|the gate exists and is not accepted as evidence.\n8|\n9|Each row runs M (mutate one production file in place), R (run the\n10|scoped Go killer through the production entry point), V (verdict from\n11|the Go exit code plus a FAIL kill-line: KILLED iff R fails with a test\n12|failure line, SURVIVED iff R passes, ERROR for anything else —\n13|unapplied patches, build breaks, timeouts). M failures and R\n14|infrastructure errors are ERROR, never kills or survivals. The file is\n15|restored from its backup after every row, pass or fail.\n16|\n17|Row C-doc-comment is the harmless control: a comment-only edit that\n18|must SURVIVE, proving the harness observes test outcomes instead of\n19|hard-coding kills.\n20|\n21|Usage:\n22|  PYTHONDONTWRITEBYTECODE=1 python3 internal/clonebundle/testdata/mutant_harness.py\n23|  PYTHONDONTWRITEBYTECODE=1 python3 internal/clonebundle/testdata/mutant_harness.py N-raw-class\n24|\"\"\"\n25|\n26|import shutil\n27|import subprocess\n28|import sys\n29|import tempfile\n30|from dataclasses import dataclass\n31|from pathlib import Path\n32|\n33|REPO = Path(__file__).resolve().parents[3]\n34|PACKAGE = \"internal/clonebundle\"\n35|\n36|\n37|@dataclass(frozen=True)\n38|class Mutant:\n39|    name: str\n40|    path: str\n41|    find: str\n42|    replace: str\n43|    count: int\n44|    run: str\n45|    expect: str\n46|    note: str\n47|\n48|\n49|MUTANTS = [\n50|    Mutant(\n51|        name=\"N-raw-class\",\n52|        path=f\"{PACKAGE}/rawmanifest.go\",\n53|        find='\\t\"derived_cache_optional\",\\n\\t\"unknown\",\\n',\n54|        replace='\\t\"derived_cache_optional\",\\n\\t\"credential\",\\n\\t\"unknown\",\\n',\n55|        count=1,\n56|        run=\"TestRawManifestRefusals/build/credential_forbidden\",\n57|        expect=\"KILLED\",\n58|        note=\"Admits exactly credential into the raw subset; every other excluded class still refuses.\",\n59|    ),\n60|    Mutant(\n61|        name=\"N-raw-order\",\n62|        path=f\"{PACKAGE}/rawmanifest.go\",\n63|        find=\"\\tif index > 0 && input.NativeItemKey <= previous {\\n\",\n64|        replace=\"\\tif index > 0 && input.NativeItemKey < previous {\\n\",\n65|        count=1,\n66|        run=\"TestRawManifestRefusals/build/duplicate_entries\",\n67|        expect=\"KILLED\",\n68|        note=\"Admits exactly duplicate keys; unsorted keys still refuse.\",\n69|    ),\n70|    Mutant(\n71|        name=\"N-exclusion-config\",\n72|        path=f\"{PACKAGE}/rawmanifest.go\",\n73|        find=\"\\tif hosttrust.ExcludedConfigDirName(key) {\\n\",\n74|        replace=\"\\tif hosttrust.ExcludedConfigDirName(key) && false {\\n\",\n75|        count=1,\n76|        run=\"TestRawManifestExcludesTrustMaterial\",\n77|        expect=\"KILLED\",\n78|        note=\"Admits exactly the trust-adjacent config class; the replication matcher arm stays. Token preserved.\",\n79|    ),\n80|    Mutant(\n81|        name=\"N-sanitize-uuid\",\n82|        path=f\"{PACKAGE}/identity.go\",\n83|        find=\"\\tif _, err := scalar.ParseUUIDv7(key); err == nil {\\n\",\n84|        replace='\\tif _, err := scalar.ParseUUIDv7(key); err == nil && key != \"0198f4c8-8e50-7f66-8f70-1234567890c2\" {\\n',\n85|        count=1,\n86|        run=\"TestIdentityRefusals/sanitizer\",\n87|        expect=\"KILLED\",\n88|        note=\"Admits exactly one UUIDv7 native key; every other UUIDv7 still refuses. Token preserved.\",\n89|    ),\n90|    Mutant(\n91|        name=\"N-always-excluded\",\n92|        path=f\"{PACKAGE}/captureitem.go\",\n93|        find='\\tcase \"credential\", \"machine_auth\", \"runtime_state\", \"transient_lock\":\\n',\n94|        replace='\\tcase \"machine_auth\", \"runtime_state\", \"transient_lock\":\\n',\n95|        count=1,\n96|        run=\"TestCaptureItemRefusals/credential_included\",\n97|        expect=\"KILLED\",\n98|        note=\"Admits exactly included credential rows; the other three always-excluded classes still refuse.\",\n99|    ),\n100|    Mutant(\n101|        name=\"N-included-reason\",\n102|        path=f\"{PACKAGE}/captureitem.go\",\n103|        find=\"\\t\\tif hasReason {\\n\",\n104|        replace='\\t\\tif hasReason && class == \"unknown\" {\\n',\n105|        count=1,\n106|        run=\"TestCaptureItemRefusals/included_with_reason\",\n107|        expect=\"KILLED\",\n108|        note=\"Admits exactly non-unknown included rows with a reason; the killer uses durable_payload.\",\n109|    ),\n110|    Mutant(\n111|        name=\"N-unknown-complete\",\n112|        path=f\"{PACKAGE}/capturebuild.go\",\n113|        find=\"\\tif hasUnknownClass(items) {\\n\",\n114|        replace=\"\\tif hasUnknownClass(items) && len(items) > 4 {\\n\",\n115|        count=1,\n116|        run=\"TestBuildCaptureManifestUnknownMakesIncomplete\",\n117|        expect=\"KILLED\",\n118|        note=\"Admits exactly small unknown-class manifests as complete; the 4-item killer derives true.\",\n119|    ),\n120|    Mutant(\n121|        name=\"N-excluded-exact\",\n122|        path=f\"{PACKAGE}/capturebuild.go\",\n123|        find=\"\\tif len(derived) != len(excluded) {\\n\",\n124|        replace=\"\\tif len(derived) > len(excluded) {\\n\",\n125|        count=1,\n126|        run=\"TestExcludedClassesExactGate\",\n127|        expect=\"KILLED\",\n128|        note=\"Admits exactly superset excluded_classes; missing classes still refuse.\",\n129|    ),\n130|    Mutant(\n131|        name=\"N-proof-identity\",\n132|        path=f\"{PACKAGE}/boundary.go\",\n133|        find=\"\\t\\tif proof.SnapshotIdentity != nil {\\n\",\n134|        replace='\\t\\tif proof.SnapshotIdentity != nil && proof.ProofKind != \"closed_store\" {\\n',\n135|        count=1,\n136|        run=\"TestBoundaryRefusals/decode_stable_proof/closed_store_with_identity\",\n137|        expect=\"KILLED\",\n138|        note=\"Admits exactly closed_store with an identity; provider_quiescence still refuses one.\",\n139|    ),\n140|    Mutant(\n141|        name=\"N-core-only\",\n142|        path=f\"{PACKAGE}/boundary.go\",\n143|        find=\"\\t\\tif !input.Core {\\n\",\n144|        replace='\\t\\tif !input.Core && input.Generation != \"g\" {\\n',\n145|        count=1,\n146|        run=\"TestBoundaryRefusals/build_core-only_unstable\",\n147|        expect=\"KILLED\",\n148|        note=\"Admits exactly non-core unstable with generation g, the killer's generation.\",\n149|    ),\n150|    Mutant(\n151|        name=\"N-g2-generation\",\n152|        path=f\"{PACKAGE}/boundary.go\",\n153|        find='''\\tif boundary.Kind == \"unstable_archive\" {\n154|\\t\\treturn invalid(\"capture boundary unstable_archive cannot enter a target branch\")\n155|\\t}\n156|''',\n157|        replace='''\\tif boundary.Kind == \"unstable_archive\" && boundary.SourceGeneration.String() != \"generation-9\" {\n158|\\t\\treturn invalid(\"capture boundary unstable_archive cannot enter a target branch\")\n159|\\t}\n160|\\tif boundary.Kind == \"unstable_archive\" {\n161|\\t\\treturn nil\n162|\\t}\n163|''',\n164|        count=1,\n165|        run=\"TestBuildCaptureManifestUnstableArchive\",\n166|        expect=\"KILLED\",\n167|        note=\"Admits exactly generation-9 unstable archives to the target branch; every other unstable still refuses.\",\n168|    ),\n169|    Mutant(\n170|        name=\"N-main-count\",\n171|        path=f\"{PACKAGE}/session.go\",\n172|        find=\"\\tif mainCount != 1 {\\n\",\n173|        replace=\"\\tif mainCount < 1 {\\n\",\n174|        count=2,\n175|        run=\"TestCanonicalSessionRefusals/build_actors/two_mains\",\n176|        expect=\"KILLED\",\n177|        note=\"Admits exactly multi-main sessions at both build and decode sites; zero-main still refuses.\",\n178|    ),\n179|    Mutant(\n180|        name=\"N-synth-operation\",\n181|        path=f\"{PACKAGE}/event.go\",\n182|        find=\"\\t\\tif !hasOperation {\\n\",\n183|        replace=\"\\t\\tif !hasOperation && hasNativeEvent {\\n\",\n184|        count=1,\n185|        run=\"TestCanonicalEventRefusals/evidence/synthesized_missing_operation\",\n186|        expect=\"KILLED\",\n187|        note=\"Admits exactly synthesized evidence with neither native event nor operation, the killer's shape.\",\n188|    ),\n189|    Mutant(\n190|        name=\"N-blob-size\",\n191|        path=f\"{PACKAGE}/blobref.go\",\n192|        find=\"\\tif size != wantSize {\\n\",\n193|        replace=\"\\tif size != wantSize && size+1 != wantSize {\\n\",\n194|        count=1,\n195|        run=\"TestBlobAgreementRefusals\",\n196|        expect=\"KILLED\",\n197|        note=\"Admits exactly off-by-one size claims; every other disagreement still refuses.\",\n198|    ),\n199|    Mutant(\n200|        name=\"N-self-digest\",\n201|        path=f\"{PACKAGE}/decode.go\",\n202|        find=\"\\tif calculated != claimed {\\n\",\n203|        replace='\\tif calculated != claimed && claimed.Hex() != \"ccdd35168ab474fa5764a526cfb83621351e23682c5075b2e18d56bddf96aa30\" {\\n',\n204|        count=1,\n205|        run=\"TestRawManifestRefusals/decode/self_digest_mismatch\",\n206|        expect=\"KILLED\",\n207|        note=\"Admits exactly the forged self digest sha256('forged'); every other mismatch still refuses.\",\n208|    ),\n209|    Mutant(\n210|        name=\"N-descriptor-claim\",\n211|        path=f\"{PACKAGE}/blobref.go\",\n212|        find=\"\\tif calculated != claimed {\\n\",\n213|        replace='\\tif calculated != claimed && claimed.Hex() != \"edb3da2954b883ebc2099da18edeac4e12f8f5d67aa5bb2dd80ba472b23481f2\" {\\n',\n214|        count=2,\n215|        run=\"TestBlobAgreementRefusals\",\n216|        expect=\"KILLED\",\n217|        note=\"Admits exactly the forged descriptor claim at both agreement and install sites; every other mismatch still refuses.\",\n218|    ),\n219|    Mutant(\n220|        name=\"N-maximal-incomplete\",\n221|        path=f\"{PACKAGE}/capturebuild.go\",\n222|        find=\"\\tif !manifest.RawComplete {\\n\",\n223|        replace=\"\\tif !manifest.RawComplete && hasUnknownClass(manifest.Items) {\\n\",\n224|        count=1,\n225|        run=\"TestCaptureManifestRefusals/reconciliation\",\n226|        expect=\"KILLED\",\n227|        note=\"Admits exactly incomplete known-class manifests to maximal_safe; unknown still blocks.\",\n228|    ),\n229|    Mutant(\n230|        name=\"C-doc-comment\",\n231|        path=f\"{PACKAGE}/doc.go\",\n232|        find=\"// Authority: relux-works/agent-session-manager-spec@v0.6.0, Sections\\n\",\n233|        replace=\"// Authority: relux-works/agent-session-manager-spec@v0.6.0, Sections (control).\\n\",\n234|        count=1,\n235|        run=\"TestCaptureClassVocabularyIsPinned\",\n236|        expect=\"SURVIVED\",\n237|        note=\"Harmless control: a comment-only edit must survive.\",\n238|    ),\n239|]\n240|\n241|\n242|def run_mutant(mutant: Mutant) -> str:\n243|    target = REPO / mutant.path\n244|    original = target.read_text()\n245|    found = original.count(mutant.find)\n246|    if found != mutant.count:\n247|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\"\n248|    with tempfile.TemporaryDirectory() as staging:\n249|        backup = Path(staging) / \"backup\"\n250|        shutil.copy2(target, backup)\n251|        try:\n252|            target.write_text(original.replace(mutant.find, mutant.replace))\n253|            run = subprocess.run(\n254|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n255|                cwd=REPO,\n256|                capture_output=True,\n257|                text=True,\n258|                timeout=300,\n259|            )\n260|        finally:\n261|            shutil.copy2(backup, target)\n262|    output = (run.stdout + run.stderr).strip()\n263|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n264|        return f\"ERROR: {mutant.name}: build broke under the patch\"\n265|    if run.returncode == 0:\n266|        verdict = \"SURVIVED\"\n267|    elif '--- FAIL' in output or 'FAIL:' in output:\n268|        verdict = \"KILLED\"\n269|    else:\n270|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\"\n271|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n272|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note}\"\n273|\n274|\n275|def main(argv: list[str]) -> int:\n276|    selected = [m for m in MUTANTS if not argv or m.name in argv]\n277|    if argv and len(selected) != len(argv):\n278|        unknown = sorted(set(argv) - {m.name for m in selected})\n279|        print(f\"unknown mutants: {', '.join(unknown)}\")\n280|        return 2\n281|    failures = 0\n282|    for mutant in selected:\n283|        try:\n284|            line = run_mutant(mutant)\n285|        except subprocess.TimeoutExpired:\n286|            line = f\"ERROR: {mutant.name}: killer timed out\"\n287|        print(line, flush=True)\n288|        if not line.startswith(\"ok:\"):\n289|            failures += 1\n290|    return 1 if failures else 0\n291|\n292|\n293|if __name__ == \"__main__\":\n294|    sys.exit(main(sys.argv[1:]))","final_result":true}}}
