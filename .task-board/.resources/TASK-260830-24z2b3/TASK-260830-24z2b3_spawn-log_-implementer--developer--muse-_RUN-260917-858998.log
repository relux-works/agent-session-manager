{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c775","stream":{"kind":"session","id":"01a0b0d3-448d-7fa1-9a80-daada0956017"},"sequence":533,"recorded_at":1780531400001061,"record_type":"event","durability":"durable","causation_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","run_stream":{"kind":"run","id":"f02750e1-95aa-4722-a114-f72ebe5c150a"},"call_id":"call_01a0b0d466bf7245a68c393acef0ed18","text":"Read text file `internal/clonebundle/decode.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"strings\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// This file holds parse-only helpers for every Section 13.14.1 closed\n15|// shape. Helpers report verdicts; every refusal is constructed at the\n16|// deciding site with a literal detail so each rule stays a distinct\n17|// gate. Strict object decoding and extension admission delegate to the\n18|// landed environ owner; tuple decoding delegates to sessadapter at the\n19|// call site.\n20|\n21|const maxUint53 = uint64(1<<53 - 1)\n22|\n23|type frameFault struct {\n24|\tdetail string\n25|\tmember string\n26|}\n27|\n28|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n29|\tmembers, fault := environ.DecodeStrictObject(data)\n30|\tif fault != nil {\n31|\t\treturn nil, &frameFault{detail: fault.Detail, member: fault.Member}\n32|\t}\n33|\treturn members, nil\n34|}\n35|\n36|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n37|\tfor name := range members {\n38|\t\tif !allowed[name] {\n39|\t\t\treturn name, true\n40|\t\t}\n41|\t}\n42|\treturn \"\", false\n43|}\n44|\n45|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n46|\tfor _, name := range required {\n47|\t\tif _, present := members[name]; !present {\n48|\t\t\treturn name, true\n49|\t\t}\n50|\t}\n51|\treturn \"\", false\n52|}\n53|\n54|func rawString(raw json.RawMessage) (string, bool) {\n55|\tvar value string\n56|\tif err := json.Unmarshal(raw, &value); err != nil {\n57|\t\treturn \"\", false\n58|\t}\n59|\treturn value, true\n60|}\n61|\n62|func rawBool(raw json.RawMessage) (bool, bool) {\n63|\tvar value bool\n64|\tif err := json.Unmarshal(raw, &value); err != nil {\n65|\t\treturn false, false\n66|\t}\n67|\treturn value, true\n68|}\n69|\n70|// rawUint53 reads an unsigned integral JSON number in [0, 2^53-1]. A\n71|// fraction, exponent, sign, or out-of-range magnitude is not a uint53.\n72|func rawUint53(raw json.RawMessage) (uint64, bool) {\n73|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n74|\tdecoder.UseNumber()\n75|\tvar value any\n76|\tif err := decoder.Decode(&value); err != nil {\n77|\t\treturn 0, false\n78|\t}\n79|\tif _, err := decoder.Token(); err != io.EOF {\n80|\t\treturn 0, false\n81|\t}\n82|\tnumber, ok := value.(json.Number)\n83|\tif !ok {\n84|\t\treturn 0, false\n85|\t}\n86|\tliteral := number.String()\n87|\tif literal == \"\" || strings.ContainsAny(literal, \".eE+-\") {\n88|\t\treturn 0, false\n89|\t}\n90|\treturn parseUint53Literal(literal)\n91|}\n92|\n93|func parseUint53Literal(literal string) (uint64, bool) {\n94|\tif literal == \"\" || (len(literal) > 1 && literal[0] == '0') {\n95|\t\treturn 0, false\n96|\t}\n97|\tvar value uint64\n98|\tfor i := 0; i < len(literal); i++ {\n99|\t\tdigit := literal[i]\n100|\t\tif digit < '0' || digit > '9' {\n101|\t\t\treturn 0, false\n102|\t\t}\n103|\t\tvalue = value*10 + uint64(digit-'0')\n104|\t\tif value > maxUint53 {\n105|\t\t\treturn 0, false\n106|\t\t}\n107|\t}\n108|\treturn value, true\n109|}\n110|\n111|// stringLength counts UTF-8 bytes, the unit every Section 13.14.1\n112|// string bound uses.\n113|func stringLength(value string) int {\n114|\treturn len(value)\n115|}\n116|\n117|func checkStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n118|\tvalue, ok := rawString(raw)\n119|\tif !ok {\n120|\t\treturn \"\", false\n121|\t}\n122|\tlength := stringLength(value)\n123|\tif length < minimum || length > maximum {\n124|\t\treturn \"\", false\n125|\t}\n126|\treturn value, true\n127|}\n128|\n129|func checkDigest(raw json.RawMessage) (scalar.Digest, bool) {\n130|\tvalue, ok := rawString(raw)\n131|\tif !ok {\n132|\t\treturn scalar.Digest{}, false\n133|\t}\n134|\tdigest, err := scalar.ParseDigest(value)\n135|\tif err != nil {\n136|\t\treturn scalar.Digest{}, false\n137|\t}\n138|\treturn digest, true\n139|}\n140|\n141|func checkUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n142|\tvalue, ok := rawString(raw)\n143|\tif !ok {\n144|\t\treturn scalar.UUIDv7{}, false\n145|\t}\n146|\tid, err := scalar.ParseUUIDv7(value)\n147|\tif err != nil {\n148|\t\treturn scalar.UUIDv7{}, false\n149|\t}\n150|\treturn id, true\n151|}\n152|\n153|func checkTimestamp(raw json.RawMessage) (scalar.Timestamp, bool) {\n154|\tvalue, ok := rawString(raw)\n155|\tif !ok {\n156|\t\treturn scalar.Timestamp{}, false\n157|\t}\n158|\tstamp, err := scalar.ParseTimestamp(value)\n159|\tif err != nil {\n160|\t\treturn scalar.Timestamp{}, false\n161|\t}\n162|\treturn stamp, true\n163|}\n164|\n165|func bytesTrimSpace(raw json.RawMessage) json.RawMessage {\n166|\treturn json.RawMessage(bytes.TrimSpace(raw))\n167|}\n168|\n169|func isNull(raw json.RawMessage) bool {\n170|\ttrimmed := bytes.TrimSpace(raw)\n171|\treturn string(trimmed) == \"null\"\n172|}\n173|\n174|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n175|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n176|\ttoken, err := decoder.Token()\n177|\tif err != nil {\n178|\t\treturn nil, false\n179|\t}\n180|\tdelimiter, ok := token.(json.Delim)\n181|\tif !ok || delimiter != '[' {\n182|\t\treturn nil, false\n183|\t}\n184|\tvar elements []json.RawMessage\n185|\tfor decoder.More() {\n186|\t\tvar element json.RawMessage\n187|\t\tif err := decoder.Decode(&element); err != nil {\n188|\t\t\treturn nil, false\n189|\t\t}\n190|\t\telements = append(elements, element)\n191|\t}\n192|\ttoken, err = decoder.Token()\n193|\tif err != nil {\n194|\t\treturn nil, false\n195|\t}\n196|\tdelimiter, ok = token.(json.Delim)\n197|\tif !ok || delimiter != ']' {\n198|\t\treturn nil, false\n199|\t}\n200|\tif _, err := decoder.Token(); err != io.EOF {\n201|\t\treturn nil, false\n202|\t}\n203|\tif elements == nil {\n204|\t\telements = []json.RawMessage{}\n205|\t}\n206|\treturn elements, true\n207|}\n208|\n209|// checkSortedUniqueStrings validates sorted unique string arrays with\n210|// per-item byte bounds and array count bounds. Bytewise order is Go\n211|// string order over UTF-8 bytes; strict increase proves sortedness\n212|// and uniqueness together.\n213|func checkSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n214|\telements, ok := decodeArray(raw)\n215|\tif !ok {\n216|\t\treturn nil, false\n217|\t}\n218|\tcount := uint64(len(elements))\n219|\tif count < minimumCount || count > maximumCount {\n220|\t\treturn nil, false\n221|\t}\n222|\tvalues := make([]string, 0, len(elements))\n223|\tprevious := \"\"\n224|\tfor index, element := range elements {\n225|\t\tvalue, ok := rawString(element)\n226|\t\tif !ok {\n227|\t\t\treturn nil, false\n228|\t\t}\n229|\t\tlength := stringLength(value)\n230|\t\tif length < minimumLength || length > maximumLength {\n231|\t\t\treturn nil, false\n232|\t\t}\n233|\t\tif index > 0 && value <= previous {\n234|\t\t\treturn nil, false\n235|\t\t}\n236|\t\tprevious = value\n237|\t\tvalues = append(values, value)\n238|\t}\n239|\treturn values, true\n240|}\n241|\n242|func checkSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\n243|\telements, ok := decodeArray(raw)\n244|\tif !ok {\n245|\t\treturn nil, false\n246|\t}\n247|\tcount := uint64(len(elements))\n248|\tif count < minimumCount || count > maximumCount {\n249|\t\treturn nil, false\n250|\t}\n251|\tvalues := make([]scalar.Digest, 0, len(elements))\n252|\tprevious := \"\"\n253|\tfor index, element := range elements {\n254|\t\tdigest, ok := checkDigest(element)\n255|\t\tif !ok {\n256|\t\t\treturn nil, false\n257|\t\t}\n258|\t\ttext := digest.String()\n259|\t\tif index > 0 && text <= previous {\n260|\t\t\treturn nil, false\n261|\t\t}\n262|\t\tprevious = text\n263|\t\tvalues = append(values, digest)\n264|\t}\n265|\treturn values, true\n266|}\n267|\n268|func checkExtensions(raw json.RawMessage) bool {\n269|\treturn environ.CheckExtensions(raw)\n270|}\n271|\n272|// canonicalizeObject renders one closed object deterministically: the\n273|// members marshal in any order and the JCS transform sorts them, so\n274|// identical logical inputs always produce identical bytes.\n275|func canonicalizeObject(object map[string]any) ([]byte, error) {\n276|\tplain, err := json.Marshal(object)\n277|\tif err != nil {\n278|\t\treturn nil, invalid(\"serialize clone bundle object: %v\", err)\n279|\t}\n280|\tcanonical, err := canonicaljson.Canonicalize(plain)\n281|\tif err != nil {\n282|\t\treturn nil, invalid(\"canonicalize clone bundle object: %v\", err)\n283|\t}\n284|\treturn canonical, nil\n285|}\n286|\n287|// omitSelfDigest computes the JCS SHA-256 identity of members with\n288|// only the self field omitted. It mirrors the canonicaljson\n289|// omit-self construction without routing through that package's\n290|// closed-shape registry, which refuses these schemas by design (see\n291|// doc.go).\n292|func omitSelfDigest(members map[string]json.RawMessage, selfField string) (scalar.Digest, error) {\n293|\tomitted := make(map[string]any, len(members))\n294|\tfor name, raw := range members {\n295|\t\tif name == selfField {\n296|\t\t\tcontinue\n297|\t\t}\n298|\t\tvar value any\n299|\t\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n300|\t\tdecoder.UseNumber()\n301|\t\tif err := decoder.Decode(&value); err != nil {\n302|\t\t\treturn scalar.Digest{}, invalid(\"identity input member %s is not JSON: %v\", name, err)\n303|\t\t}\n304|\t\tomitted[name] = value\n305|\t}\n306|\tplain, err := json.Marshal(omitted)\n307|\tif err != nil {\n308|\t\treturn scalar.Digest{}, invalid(\"serialize omit-self object: %v\", err)\n309|\t}\n310|\tcanonical, err := canonicaljson.Canonicalize(plain)\n311|\tif err != nil {\n312|\t\treturn scalar.Digest{}, invalid(\"canonicalize omit-self object: %v\", err)\n313|\t}\n314|\treturn scalar.SHA256Digest(canonical), nil\n315|}\n316|\n317|// verifySelfDigest recomputes the omit-self identity and refuses a\n318|// mismatch against the claimed self digest.\n319|func verifySelfDigest(members map[string]json.RawMessage, selfField string, claimed scalar.Digest) error {\n320|\tcalculated, err := omitSelfDigest(members, selfField)\n321|\tif err != nil {\n322|\t\treturn err\n323|\t}\n324|\tif calculated != claimed {\n325|\t\treturn invalid(\"%s claim %q does not match omit-self digest %q\", selfField, claimed.String(), calculated.String())\n326|\t}\n327|\treturn nil\n328|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c777","stream":{"kind":"session","id":"01a0b0d3-448d-7fa1-9a80-daada0956017"},"sequence":534,"recorded_at":1780531400001063,"record_type":"event","durability":"durable","causation_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","run_stream":{"kind":"run","id":"f02750e1-95aa-4722-a114-f72ebe5c150a"},"call_id":"call_01a0b0d468447572ba7819f7292066bc","text":"Read text file `internal/clonebundle/identity.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"strings\"\n6|\t\"unicode/utf8\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|// This file validates the Section 13.14.1 identities: NativeIdentity,\n12|// WorkspaceBinding, and the sanitized native-key admission shared by\n13|// every native key in this package. Sanitized means printable,\n14|// relative, and unambiguously native: never an absolute source path,\n15|// never an AX Session identity, never carrying embedded credentials.\n16|\n17|var nativeIdentityMembers = map[string]bool{\n18|\t\"native_session_id\":         true,\n19|\t\"identity_kind\":             true,\n20|\t\"logical_workspace_id\":      true,\n21|\t\"backend_realm_fingerprint\": true,\n22|\t\"opaque_identity\":           true,\n23|\t\"extensions\":                true,\n24|}\n25|\n26|var nativeIdentityRequired = []string{\n27|\t\"native_session_id\",\n28|\t\"identity_kind\",\n29|\t\"logical_workspace_id\",\n30|\t\"backend_realm_fingerprint\",\n31|\t\"opaque_identity\",\n32|\t\"extensions\",\n33|}\n34|\n35|var nativeIdentityKinds = []string{\n36|\t\"provider_native\",\n37|\t\"official_import\",\n38|\t\"continuation_context\",\n39|}\n40|\n41|func validNativeIdentityKind(kind string) bool {\n42|\tfor _, allowed := range nativeIdentityKinds {\n43|\t\tif kind == allowed {\n44|\t\t\treturn true\n45|\t\t}\n46|\t}\n47|\treturn false\n48|}\n49|\n50|// NativeIdentity is one validated sanitized native identity.\n51|type NativeIdentity struct {\n52|\tNativeSessionID         string\n53|\tIdentityKind            string\n54|\tLogicalWorkspaceID      scalar.UUIDv7\n55|\tBackendRealmFingerprint *scalar.Digest\n56|\tOpaqueIdentity          *string\n57|}\n58|\n59|// DecodeNativeIdentity validates one closed NativeIdentity: exact\n60|// members, the closed identity-kind vocabulary, a sanitized native\n61|// session ID, a UUIDv7 logical workspace, an optional digest realm\n62|// fingerprint, an optional sanitized opaque identity, and\n63|// reverse-DNS extensions. Credential, absolute-path, PID, socket,\n64|// token, and secret-environment material is refused by the shared\n65|// sanitizer, never laundered into an identity.\n66|func DecodeNativeIdentity(raw json.RawMessage) (NativeIdentity, error) {\n67|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n68|\tif fault != nil {\n69|\t\treturn NativeIdentity{}, invalid(\"native identity %s (%s)\", fault.detail, memberField(fault.member))\n70|\t}\n71|\tif name, unknown := unknownMember(members, nativeIdentityMembers); unknown {\n72|\t\treturn NativeIdentity{}, invalid(\"native identity carries unknown member %q\", name)\n73|\t}\n74|\tif name, missing := missingMember(members, nativeIdentityRequired); missing {\n75|\t\treturn NativeIdentity{}, invalid(\"native identity misses a required member %q\", name)\n76|\t}\n77|\tnativeID, ok := checkStringBounds(members[\"native_session_id\"], 1, 512)\n78|\tif !ok {\n79|\t\treturn NativeIdentity{}, invalid(\"native identity native_session_id is not a string[1..512]\")\n80|\t}\n81|\tif err := SanitizeNativeKey(nativeID); err != nil {\n82|\t\treturn NativeIdentity{}, err\n83|\t}\n84|\tkind, ok := rawString(members[\"identity_kind\"])\n85|\tif !ok || !validNativeIdentityKind(kind) {\n86|\t\treturn NativeIdentity{}, invalid(\"native identity kind is outside provider_native|official_import|continuation_context\")\n87|\t}\n88|\tworkspaceID, ok := checkUUIDv7(members[\"logical_workspace_id\"])\n89|\tif !ok {\n90|\t\treturn NativeIdentity{}, invalid(\"native identity logical_workspace_id is not a UUIDv7\")\n91|\t}\n92|\tvar fingerprint *scalar.Digest\n93|\tif !isNull(members[\"backend_realm_fingerprint\"]) {\n94|\t\tdigest, ok := checkDigest(members[\"backend_realm_fingerprint\"])\n95|\t\tif !ok {\n96|\t\t\treturn NativeIdentity{}, invalid(\"native identity backend_realm_fingerprint is not a digest\")\n97|\t\t}\n98|\t\tfingerprint = &digest\n99|\t}\n100|\tvar opaque *string\n101|\tif !isNull(members[\"opaque_identity\"]) {\n102|\t\tvalue, ok := checkStringBounds(members[\"opaque_identity\"], 1, 512)\n103|\t\tif !ok {\n104|\t\t\treturn NativeIdentity{}, invalid(\"native identity opaque_identity is not a string[1..512]\")\n105|\t\t}\n106|\t\tif err := SanitizeNativeKey(value); err != nil {\n107|\t\t\treturn NativeIdentity{}, err\n108|\t\t}\n109|\t\topaque = &value\n110|\t}\n111|\tif !checkExtensions(members[\"extensions\"]) {\n112|\t\treturn NativeIdentity{}, invalid(\"native identity extensions are not reverse-DNS keyed\")\n113|\t}\n114|\treturn NativeIdentity{\n115|\t\tNativeSessionID:         nativeID,\n116|\t\tIdentityKind:            kind,\n117|\t\tLogicalWorkspaceID:      workspaceID,\n118|\t\tBackendRealmFingerprint: fingerprint,\n119|\t\tOpaqueIdentity:          opaque,\n120|\t}, nil\n121|}\n122|\n123|// EncodeNativeIdentity renders one validated identity as canonical\n124|// bytes under the given already-validated extensions. The identity\n125|// must already be decoded; encoding never admits what decoding\n126|// refused. A nil extensions map encodes as the empty object.\n127|func EncodeNativeIdentity(identity NativeIdentity, extensions map[string]any) ([]byte, error) {\n128|\tvar fingerprint any\n129|\tif identity.BackendRealmFingerprint != nil {\n130|\t\tfingerprint = identity.BackendRealmFingerprint.String()\n131|\t}\n132|\tvar opaque any\n133|\tif identity.OpaqueIdentity != nil {\n134|\t\topaque = *identity.OpaqueIdentity\n135|\t}\n136|\tif extensions == nil {\n137|\t\textensions = map[string]any{}\n138|\t}\n139|\treturn canonicalizeObject(map[string]any{\n140|\t\t\"native_session_id\":         identity.NativeSessionID,\n141|\t\t\"identity_kind\":             identity.IdentityKind,\n142|\t\t\"logical_workspace_id\":      identity.LogicalWorkspaceID.String(),\n143|\t\t\"backend_realm_fingerprint\": fingerprint,\n144|\t\t\"opaque_identity\":           opaque,\n145|\t\t\"extensions\":                extensions,\n146|\t})\n147|}\n148|\n149|var workspaceBindingMembers = map[string]bool{\n150|\t\"logical_workspace_id\":           true,\n151|\t\"cwd_relative\":                   true,\n152|\t\"repository_remote_fingerprints\": true,\n153|\t\"branch\":                         true,\n154|\t\"head_digest\":                    true,\n155|\t\"index_digest\":                   true,\n156|\t\"working_tree_digest\":            true,\n157|\t\"extensions\":                     true,\n158|}\n159|\n160|var workspaceBindingRequired = []string{\n161|\t\"logical_workspace_id\",\n162|\t\"cwd_relative\",\n163|\t\"repository_remote_fingerprints\",\n164|\t\"branch\",\n165|\t\"head_digest\",\n166|\t\"index_digest\",\n167|\t\"working_tree_digest\",\n168|\t\"extensions\",\n169|}\n170|\n171|// WorkspaceBinding is one validated closed workspace binding. No\n172|// member grants filesystem authority: the cwd is a normalized\n173|// relative path beneath the Workspace Group root, never an absolute\n174|// path or an escape.\n175|type WorkspaceBinding struct {\n176|\tLogicalWorkspaceID scalar.UUIDv7\n177|\tCwdRelative        string\n178|\tRemoteFingerprints []scalar.Digest\n179|\tBranch             *string\n180|\tHeadDigest         *scalar.Digest\n181|\tIndexDigest        *scalar.Digest\n182|\tWorkingTreeDigest  *scalar.Digest\n183|}\n184|\n185|// DecodeWorkspaceBinding validates one closed WorkspaceBinding.\n186|func DecodeWorkspaceBinding(raw json.RawMessage) (WorkspaceBinding, error) {\n187|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n188|\tif fault != nil {\n189|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding %s (%s)\", fault.detail, memberField(fault.member))\n190|\t}\n191|\tif name, unknown := unknownMember(members, workspaceBindingMembers); unknown {\n192|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding carries unknown member %q\", name)\n193|\t}\n194|\tif name, missing := missingMember(members, workspaceBindingRequired); missing {\n195|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding misses a required member %q\", name)\n196|\t}\n197|\tworkspaceID, ok := checkUUIDv7(members[\"logical_workspace_id\"])\n198|\tif !ok {\n199|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding logical_workspace_id is not a UUIDv7\")\n200|\t}\n201|\tcwd, ok := checkStringBounds(members[\"cwd_relative\"], 1, 4096)\n202|\tif !ok {\n203|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding cwd_relative is not a string[1..4096]\")\n204|\t}\n205|\tif err := checkCwdRelative(cwd); err != nil {\n206|\t\treturn WorkspaceBinding{}, err\n207|\t}\n208|\tfingerprints, ok := checkSortedUniqueDigests(members[\"repository_remote_fingerprints\"], 0, 128)\n209|\tif !ok {\n210|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding repository_remote_fingerprints are not sorted unique digest[0..128]\")\n211|\t}\n212|\tvar branch *string\n213|\tif !isNull(members[\"branch\"]) {\n214|\t\tvalue, ok := checkStringBounds(members[\"branch\"], 1, 1024)\n215|\t\tif !ok {\n216|\t\t\treturn WorkspaceBinding{}, invalid(\"workspace binding branch is not a string[1..1024]\")\n217|\t\t}\n218|\t\tbranch = &value\n219|\t}\n220|\thead, err := checkNullableDigest(members, \"head_digest\", \"workspace binding\")\n221|\tif err != nil {\n222|\t\treturn WorkspaceBinding{}, err\n223|\t}\n224|\tindex, err := checkNullableDigest(members, \"index_digest\", \"workspace binding\")\n225|\tif err != nil {\n226|\t\treturn WorkspaceBinding{}, err\n227|\t}\n228|\ttree, err := checkNullableDigest(members, \"working_tree_digest\", \"workspace binding\")\n229|\tif err != nil {\n230|\t\treturn WorkspaceBinding{}, err\n231|\t}\n232|\tif !checkExtensions(members[\"extensions\"]) {\n233|\t\treturn WorkspaceBinding{}, invalid(\"workspace binding extensions are not reverse-DNS keyed\")\n234|\t}\n235|\treturn WorkspaceBinding{\n236|\t\tLogicalWorkspaceID: workspaceID,\n237|\t\tCwdRelative:        cwd,\n238|\t\tRemoteFingerprints: fingerprints,\n239|\t\tBranch:             branch,\n240|\t\tHeadDigest:         head,\n241|\t\tIndexDigest:        index,\n242|\t\tWorkingTreeDigest:  tree,\n243|\t}, nil\n244|}\n245|\n246|// checkCwdRelative admits exactly the normalized relative paths\n247|// beneath (or equal to) the Workspace Group root: scalar relative\n248|// paths plus the root itself (\".\"). Anything else — absolute,\n249|// escaped, backslashed, encoded-separator, or dot-segment forms —\n250|// would grant or smuggle filesystem authority and is refused.\n251|func checkCwdRelative(cwd string) error {\n252|\tif cwd == \".\" {\n253|\t\treturn nil\n254|\t}\n255|\tif _, err := scalar.ParseRelativePath(cwd); err != nil {\n256|\t\treturn invalid(\"workspace binding cwd_relative is not normalized beneath the workspace root: %v\", err)\n257|\t}\n258|\treturn nil\n259|}\n260|\n261|func checkNullableDigest(members map[string]json.RawMessage, name, owner string) (*scalar.Digest, error) {\n262|\traw, present := members[name]\n263|\tif !present {\n264|\t\treturn nil, invalid(\"%s misses a required member %q\", owner, name)\n265|\t}\n266|\tif isNull(raw) {\n267|\t\treturn nil, nil\n268|\t}\n269|\tdigest, ok := checkDigest(raw)\n270|\tif !ok {\n271|\t\treturn nil, invalid(\"%s %s is not a digest\", owner, name)\n272|\t}\n273|\treturn &digest, nil\n274|}\n275|\n276|// SanitizeNativeKey refuses every native key that is not sanitized:\n277|// empty values are refused here (over-long values by the caller's\n278|// bound check), and this gate refuses control characters,\n279|// absolute-path forms, a\n280|// UUIDv7 form (indistinguishable from a fabricated AX Session\n281|// identity), embedded-credential forms, and AX-schema markers. A\n282|// native key that survives is printable, relative, and\n283|// unambiguously native.\n284|func SanitizeNativeKey(key string) error {\n285|\tif key == \"\" {\n286|\t\treturn invalid(\"native key is empty\")\n287|\t}\n288|\tif !utf8.ValidString(key) {\n289|\t\treturn invalid(\"native key is not valid UTF-8\")\n290|\t}\n291|\tfor _, unit := range key {\n292|\t\tif unit < 0x20 || unit == 0x7f {\n293|\t\t\treturn invalid(\"native key carries control characters\")\n294|\t\t}\n295|\t}\n296|\tif strings.HasPrefix(key, \"/\") || strings.HasPrefix(key, `\\\\`) || hasDrivePrefix(key) {\n297|\t\treturn invalid(\"native key is an absolute source path, never a cross-host identity\")\n298|\t}\n299|\tif _, err := scalar.ParseUUIDv7(key); err == nil {\n300|\t\treturn invalid(\"native key %q is a UUIDv7, indistinguishable from a fabricated AX Session identity\", key)\n301|\t}\n302|\tif strings.Contains(key, \"urn:ax:\") {\n303|\t\treturn invalid(\"native key carries an AX identity marker\")\n304|\t}\n305|\tif at := strings.Index(key, \"@\"); at >= 0 {\n306|\t\tif scheme := strings.Index(key, \"://\"); scheme >= 0 && scheme < at {\n307|\t\t\tif slash := strings.Index(key[scheme+3:], \"/\"); slash < 0 || scheme+3+slash > at {\n308|\t\t\t\treturn invalid(\"native key carries embedded credentials\")\n309|\t\t\t}\n310|\t\t}\n311|\t}\n312|\treturn nil\n313|}\n314|\n315|func hasDrivePrefix(value string) bool {\n316|\treturn len(value) >= 3 && ((value[0] >= 'a' && value[0] <= 'z') || (value[0] >= 'A' && value[0] <= 'Z')) && value[1] == ':' && (value[2] == '/' || value[2] == '\\\\')\n317|}\n318|\n319|func memberField(member string) string {\n320|\tif member == \"\" {\n321|\t\treturn \"frame\"\n322|\t}\n323|\treturn \"member \" + member\n324|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
