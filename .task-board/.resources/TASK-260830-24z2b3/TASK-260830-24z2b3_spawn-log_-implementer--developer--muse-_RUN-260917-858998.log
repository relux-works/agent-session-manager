reDigest(\"some-other-descriptor\")\n37|\tbuilt, err := buildRaw(inputs, nil)\n38|\tverdict(\"P1 raw entry descriptor_id != descriptor's own id (build)\", err)\n39|\tif err == nil {\n40|\t\tm, derr := DecodeRawObjectManifest(built)\n41|\t\tverdict(\"P1b decode of that manifest\", derr)\n42|\t\tif derr == nil {\n43|\t\t\tverr := VerifyRawManifestDescriptors(m, func(id string) ([]byte, error) {\n44|\t\t\t\tfor _, in := range inputs {\n45|\t\t\t\t\tif in.DescriptorID == id {\n46|\t\t\t\t\t\treturn in.Descriptor, nil\n47|\t\t\t\t\t}\n48|\t\t\t\t}\n49|\t\t\t\treturn nil, fmt.Errorf(\"missing %s\", id)\n50|\t\t\t})\n51|\t\t\tverdict(\"P1c VerifyRawManifestDescriptors with mismatched id\", verr)\n52|\t\t}\n53|\t}\n54|\n55|\t// P2: AX number model inside extension values (float, unsafe int, exponent).\n56|\tvalid := mustRawBytes(t)\n57|\tfor _, lit := range []string{`1.5`, `9007199254740993`, `1e2`, `1E400`, `-0`} {\n58|\t\tbody := strings.Replace(string(valid), `\"extensions\":{}`, `\"extensions\":{\"com.example.n\":`+lit+`}`, 1)\n59|\t\tvar members map[string]json.RawMessage\n60|\t\t_ = json.Unmarshal([]byte(body), &members)\n61|\t\t_, derr := omitSelfDigest(members, rawManifestSelf)\n62|\t\tverdict(\"P2 omitSelfDigest over extension number \"+lit, derr)\n63|\t\t_, derr = DecodeRawObjectManifest([]byte(body))\n64|\t\tverdict(\"P2b DecodeRawObjectManifest ext number \"+lit+\" (unsealed)\", derr)\n65|\t}\n66|\tbuilt, err = buildRaw(validEntryInputs(t), map[string]any{\"com.example.f\": 1.5, \"com.example.big\": uint64(1) << 60})\n67|\tverdict(\"P2c Build raw manifest with float/unsafe-int extension\", err)\n68|\tif err == nil {\n69|\t\t_, derr := DecodeRawObjectManifest(built)\n70|\t\tverdict(\"P2d Decode of that manifest\", derr)\n71|\t\tfmt.Printf(\"PROBE P2e built extensions bytes: %s\\n\", extractMember(built, \"extensions\"))\n72|\t}\n73|\n74|\t// P3: sanitizer edges (C1 control, line separator, zero-width space, schemeless credential, case, backslash).\n75|\tc1 := string(rune(0x85))\n76|\tlsep := string(rune(0x2028))\n77|\tzwsp := string(rune(0x200b))\n78|\tfor _, key := range []string{\"a\" + c1 + \"b\", \"a\" + lsep + \"b\", \"a\" + zwsp + \"b\", \"user:secret@example.com/path\", \"URN:AX:session\", \"~/home\", \"host-channel\\\\trust.json\", \"HOST-CHANNEL/trust.json\", \"./host-channel/trust.json\", \"host-channel//trust.json\"} {\n79|\t\tverdict(fmt.Sprintf(\"P3 SanitizeNativeKey(%q)\", key), SanitizeNativeKey(key))\n80|\t\tverdict(fmt.Sprintf(\"P3x refuseExcludedMember(%q)\", key), refuseExcludedMember(\"probe\", key, 0))\n81|\t}\n82|\n83|\t// P4: reconciliation with duplicate raw keys hiding a missing included key.\n84|\titems := []CaptureItem{\n85|\t\t{NativeItemKey: \"a\", Class: \"durable_payload\", Disposition: \"included\"},\n86|\t\t{NativeItemKey: \"b\", Class: \"durable_payload\", Disposition: \"included\"},\n87|\t}\n88|\tfmt.Printf(\"PROBE P4 deriveRawComplete(items a,b included; rawKeys=[a,a]) = %v (want false)\\n\", deriveRawComplete(items, []string{\"a\", \"b\"}, []string{\"a\", \"a\"}))\n89|\tfmt.Printf(\"PROBE P4b deriveRawComplete(items a,b; planKeys=[a,b,b]) = %v (want false)\\n\", deriveRawComplete(items, []string{\"a\", \"b\", \"b\"}, []string{\"a\", \"b\"}))\n90|\n91|\t// P5: Build capture manifest with items != plan candidates.\n92|\tin := validCaptureInput(t)\n93|\tin.PlanKeys = append(in.PlanKeys, \"store/zz-missing-item\")\n94|\tbuilt, err = BuildCaptureManifest(in)\n95|\tverdict(\"P5 BuildCaptureManifest items != plan candidates\", err)\n96|\tif err == nil {\n97|\t\tm, _ := DecodeCaptureManifest(built)\n98|\t\tfmt.Printf(\"PROBE P5b raw_complete=%v (built with plan/item mismatch)\\n\", m.RawComplete)\n99|\t}\n100|\n101|\t// P6: payload for the wrong kind.\n102|\tev := validEventInput(\"exact\")\n103|\tev.Kind = \"usage\"\n104|\tev.Payload = []byte(`{\"content_blocks\":[{\"type\":\"text\",\"content\":\"hi\"}],\"input_tokens\":3}`)\n105|\t_, err = BuildCanonicalEvent(ev)\n106|\tverdict(\"P6 usage event with content_blocks + facts\", err)\n107|\tev = validEventInput(\"exact\")\n108|\tev.Kind = \"tool_call\"\n109|\tev.Payload = []byte(`{\"anything\":{\"goes\":true},\"transcript\":\"x\"}`)\n110|\t_, err = BuildCanonicalEvent(ev)\n111|\tverdict(\"P6b tool_call event with arbitrary payload members\", err)\n112|\tev = validEventInput(\"exact\")\n113|\tev.Payload = []byte(`{\"content_blocks\":[{\"type\":\"text\"}],\"extensions\":{}}`)\n114|\t_, err = BuildCanonicalEvent(ev)\n115|\tverdict(\"P7 message block with neither content nor descriptor\", err)\n116|\tev = validEventInput(\"exact\")\n117|\tev.Payload = []byte(`{\"content_blocks\":[{\"type\":\"text\",\"content\":\"x\",\"blob_descriptor_id\":\"` + fixtureDigest(\"d\") + `\"}],\"extensions\":{}}`)\n118|\t_, err = BuildCanonicalEvent(ev)\n119|\tverdict(\"P7b message block with BOTH content and descriptor\", err)\n120|\tev = validEventInput(\"exact\")\n121|\tev.Payload = []byte(`{\"content_blocks\":[{\"type\":\"text\",\"content\":\"x\"}]}`)\n122|\t_, err = BuildCanonicalEvent(ev)\n123|\tverdict(\"P7c message payload without extensions member\", err)\n124|\n125|\t// P8: subagent whose parent is not an actor of the session.\n126|\ts := validSessionInput()\n127|\ts.Actors[1].ParentActorID = strptr(fixtureTurnID)\n128|\t_, err = BuildCanonicalSession(s)\n129|\tverdict(\"P8 actor parent not in actors list\", err)\n130|\n131|\t// P9: IdentityDigest over an identity Decode would refuse.\n132|\tbad := fixtureNativeIdentity()\n133|\tbad.IdentityKind = \"bogus\"\n134|\t_, err = IdentityDigest(bad, nil)\n135|\tverdict(\"P9 IdentityDigest(identity_kind=bogus)\", err)\n136|\t_, err = IdentityDigest(fixtureNativeIdentity(), map[string]any{\"no-dots\": 1})\n137|\tverdict(\"P9b IdentityDigest(bad extension keys)\", err)\n138|\n139|\t// P10: decode-side gates that the suite never reaches (do they exist?).\n140|\tcap := mustCaptureBytes(t)\n141|\tfor _, tc := range []struct {\n142|\t\tname string\n143|\t\tmut  func(map[string]any)\n144|\t}{\n145|\t\t{\"P10 decode item class mystery\", func(o map[string]any) { o[\"items\"].([]any)[0].(map[string]any)[\"class\"] = \"mystery\" }},\n146|\t\t{\"P10b decode item disposition maybe\", func(o map[string]any) { o[\"items\"].([]any)[0].(map[string]any)[\"disposition\"] = \"maybe\" }},\n147|\t\t{\"P10c decode included item with reason\", func(o map[string]any) { o[\"items\"].([]any)[0].(map[string]any)[\"exclusion_reason\"] = \"r\" }},\n148|\t\t{\"P10d decode excluded item with content\", func(o map[string]any) { o[\"items\"].([]any)[2].(map[string]any)[\"byte_count\"] = float64(3) }},\n149|\t\t{\"P10e decode credential included\", func(o map[string]any) {\n150|\t\t\tit := o[\"items\"].([]any)[2].(map[string]any)\n151|\t\t\tit[\"disposition\"] = \"included\"\n152|\t\t\tit[\"blob_descriptor_id\"] = fixtureDigest(\"d\")\n153|\t\t\tit[\"byte_count\"] = float64(3)\n154|\t\t\tit[\"exclusion_reason\"] = nil\n155|\t\t\to[\"excluded_classes\"] = []any{}\n156|\t\t}},\n157|\t\t{\"P10f decode items duplicate key\", func(o map[string]any) {\n158|\t\t\tits := o[\"items\"].([]any)\n159|\t\t\tits[1].(map[string]any)[\"native_item_key\"] = its[0].(map[string]any)[\"native_item_key\"]\n160|\t\t}},\n161|\t\t{\"P10g decode raw_complete not bool\", func(o map[string]any) { o[\"raw_complete\"] = \"yes\" }},\n162|\t\t{\"P10h decode unstable boundary missing generation\", func(o map[string]any) {\n163|\t\t\to[\"capture_boundary\"] = map[string]any{\"kind\": \"unstable_archive\", \"pre_capture_digest\": fixtureDigest(\"a\"), \"post_capture_digest\": fixtureDigest(\"b\"), \"reason_code\": \"source_not_quiescent\", \"operator_explicit\": true, \"target_projection_forbidden\": true, \"extensions\": map[string]any{}}\n164|\t\t}},\n165|\t\t{\"P10i decode source_identity unsanitized\", func(o map[string]any) { o[\"source_identity\"].(map[string]any)[\"native_session_id\"] = \"/abs\" }},\n166|\t\t{\"P10j decode boundary proof unequal digests\", func(o map[string]any) {\n167|\t\t\to[\"capture_boundary\"].(map[string]any)[\"proof\"].(map[string]any)[\"post_capture_digest\"] = fixtureDigest(\"zzz\")\n168|\t\t}},\n169|\t} {\n170|\t\t_, derr := DecodeCaptureManifest(tamper(t, cap, tc.mut))\n171|\t\tverdict(tc.name, derr)\n172|\t}\n173|\tevb := mustEventBytes(t, \"exact\")\n174|\tfor _, tc := range []struct {\n175|\t\tname string\n176|\t\tmut  func(map[string]any)\n177|\t}{\n178|\t\t{\"P11 decode evidence status maybe\", func(o map[string]any) { o[\"source_evidence\"].(map[string]any)[\"capture_status\"] = \"maybe\" }},\n179|\t\t{\"P11b decode evidence raw_refs duplicate\", func(o map[string]any) {\n180|\t\t\te := o[\"source_evidence\"].(map[string]any)\n181|\t\t\tr := e[\"raw_refs\"].([]any)\n182|\t\t\te[\"raw_refs\"] = []any{r[0], r[0]}\n183|\t\t}},\n184|\t\t{\"P11c decode evidence reason_codes dup\", func(o map[string]any) { o[\"source_evidence\"].(map[string]any)[\"reason_codes\"] = []any{\"a\", \"a\"} }},\n185|\t\t{\"P11d decode parents dup\", func(o map[string]any) { o[\"parents\"] = []any{fixtureDigest(\"p\"), fixtureDigest(\"p\")} }},\n186|\t\t{\"P11e decode visibility secret\", func(o map[string]any) { o[\"visibility\"] = \"secret\" }},\n187|\t\t{\"P11f decode exact with core op\", func(o map[string]any) { o[\"source_evidence\"].(map[string]any)[\"core_operation_id\"] = fixtureOperationID }},\n188|\t} {\n189|\t\t_, derr := DecodeCanonicalEvent(tamper(t, evb, tc.mut))\n190|\t\tverdict(tc.name, derr)\n191|\t}\n192|\tsb := mustSessionBytes(t)\n193|\tfor _, tc := range []struct {\n194|\t\tname string\n195|\t\tmut  func(map[string]any)\n196|\t}{\n197|\t\t{\"P12 decode main actor with parent\", func(o map[string]any) { o[\"actors\"].([]any)[0].(map[string]any)[\"parent_actor_id\"] = fixtureActorSub }},\n198|\t\t{\"P12b decode subagent null parent\", func(o map[string]any) { o[\"actors\"].([]any)[1].(map[string]any)[\"parent_actor_id\"] = nil }},\n199|\t\t{\"P12c decode actor kind ghost\", func(o map[string]any) { o[\"actors\"].([]any)[1].(map[string]any)[\"kind\"] = \"ghost\" }},\n200|\t\t{\"P12d decode heads dup\", func(o map[string]any) { h := o[\"head_event_ids\"].([]any); o[\"head_event_ids\"] = []any{h[0], h[0]} }},\n201|\t\t{\"P12e decode title empty\", func(o map[string]any) { o[\"title\"] = \"\" }},\n202|\t} {\n203|\t\t_, derr := DecodeCanonicalSession(tamper(t, sb, tc.mut))\n204|\t\tverdict(tc.name, derr)\n205|\t}\n206|\n207|\t// P13: generation prefix comparison.\n208|\tg1 := MustParseGeneration(\"generation-1\")\n209|\tg10 := MustParseGeneration(\"generation-10\")\n210|\tfmt.Printf(\"PROBE P13 generation-1.Equal(generation-10) = %v (want false)\\n\", g1.Equal(g10))\n211|\n212|\t// P14: install with descriptor size disagreeing with supplied bytes.\n213|\tstore := openFixtureStore(t)\n214|\tdescriptor, _, _, _ := makeDescriptor(t, []byte(\"twelve-bytes\"))\n215|\t_, err = InstallRawBlob(store, descriptor, bytes.NewReader([]byte(\"short\")))\n216|\tverdict(\"P14 InstallRawBlob bytes shorter than descriptor size\", err)\n217|\t_, err = InstallRawBlob(store, descriptor, bytes.NewReader([]byte(\"twelve-bytes-and-more\")))\n218|\tverdict(\"P14b InstallRawBlob bytes longer than descriptor size\", err)\n219|\ttampered := tamper(t, descriptor, func(o map[string]any) { o[\"blob_id\"] = fixtureDigest(\"other\") })\n220|\t_, err = InstallRawBlob(store, tampered, bytes.NewReader([]byte(\"twelve-bytes\")))\n221|\tverdict(\"P14c InstallRawBlob descriptor blob_id != chunk digest (unsealed)\", err)\n222|\n223|\t// P15: VerifyRawManifestDescriptors negatives (positive-only in suite).\n224|\tm, _ := DecodeRawObjectManifest(mustRawBytes(t))\n225|\tverdict(\"P15 VerifyRawManifestDescriptors fetch error\", VerifyRawManifestDescriptors(m, func(string) ([]byte, error) { return nil, fmt.Errorf(\"boom\") }))\n226|\tverdict(\"P15b VerifyRawManifestDescriptors empty\", VerifyRawManifestDescriptors(m, func(string) ([]byte, error) { return nil, nil }))\n227|\twrong, _, _, _ := makeDescriptor(t, []byte(\"unrelated\"))\n228|\tverdict(\"P15c VerifyRawManifestDescriptors wrong descriptor\", VerifyRawManifestDescriptors(m, func(string) ([]byte, error) { return wrong, nil }))\n229|\n230|\t// P16: duplicate-key decode edge.\n231|\t_, err = DecodeRawObjectManifest([]byte(strings.Replace(string(valid), `\"schema_version\":\"1.0.0\"`, `\"schema_version\":\"1.0.0\",\"schema_version\":\"1.0.0\"`, 1)))\n232|\tverdict(\"P16 duplicate member at decode\", err)\n233|}\n234|\n235|func extractMember(data []byte, name string) string {\n236|\tvar m map[string]json.RawMessage\n237|\t_ = json.Unmarshal(data, &m)\n238|\treturn string(m[name])\n239|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c64d","stream":{"kind":"session","id":"01a0b0d3-448d-7fa1-9a80-daada0956017"},"sequence":385,"recorded_at":1780531400000765,"record_type":"event","durability":"durable","causation_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","run_stream":{"kind":"run","id":"f02750e1-95aa-4722-a114-f72ebe5c150a"},"task_stream":{"kind":"task","id":"01a0b0d4-2ca6-7bd3-b2b1-5bedca835fdb"},"task_id":"01a0b0d4-2ca6-7bd3-b2b1-5bedca835fdb","event":{"kind":"completed","task_id":"01a0b0d4-2ca6-7bd3-b2b1-5bedca835fdb"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c64f","stream":{"kind":"session","id":"01a0b0d3-448d-7fa1-9a80-daada0956017"},"sequence":386,"recorded_at":1780531400000767,"record_type":"event","durability":"durable","causation_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","run_stream":{"kind":"run","id":"f02750e1-95aa-4722-a114-f72ebe5c150a"},"call_id":"call_01a0b0d4283f779b9e65eeb28e5bfc36","text":"Read text file `/tmp/rev2ev/reviewer_mutants.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Reviewer mutation runner for TASK-260830-24z2b3 rev2.\n3|\n4|Loads the producer's MUTANTS table from the shipped harness (import, no\n5|copy), adds the reviewer's own plants, runs each plant N times against the\n6|isolated candidate copy, and writes one raw log per run with the subprocess\n7|exit code. Verdict rule mirrors the shipped harness: KILLED iff go test\n8|fails with a FAIL line, SURVIVED iff exit 0, ERROR otherwise.\n9|\"\"\"\n10|import importlib.util, os, shutil, subprocess, sys, tempfile, time\n11|from pathlib import Path\n12|\n13|HERE = Path(__file__).resolve().parent\n14|CANDIDATE = HERE.parent / \"candidate\"\n15|LOGDIR = HERE / \"logs\" / \"mutants\"\n16|LOGDIR.mkdir(parents=True, exist_ok=True)\n17|PACKAGE = \"internal/clonebundle\"\n18|\n19|spec = importlib.util.spec_from_file_location(\"mutant_harness\", CANDIDATE / PACKAGE / \"testdata\" / \"mutant_harness.py\")\n20|harness = importlib.util.module_from_spec(spec)\n21|spec.loader.exec_module(harness)\n22|Mutant = harness.Mutant\n23|PRODUCER = list(harness.MUTANTS)\n24|\n25|REVIEWER = [\n26|    # --- the four classes the reviewer brief names ---\n27|    Mutant(\"R-unknown-ignores-one\", f\"{PACKAGE}/capturebuild.go\",\n28|           '\\t\\tif item.Class == \"unknown\" {\\n',\n29|           '\\t\\tif item.Class == \"unknown\" && item.NativeItemKey != \"store/zz-unknown\" {\\n', 1,\n30|           \"TestBuildCaptureManifestUnknownMakesIncomplete\", \"KILLED\",\n31|           \"raw_complete derivation ignores exactly one unknown item (the killer's key).\"),\n32|    Mutant(\"R-excluded-set-missing-machine_auth\", f\"{PACKAGE}/captureitem.go\",\n33|           '\\tcase \"credential\", \"machine_auth\", \"runtime_state\", \"transient_lock\":\\n',\n34|           '\\tcase \"credential\", \"runtime_state\", \"transient_lock\":\\n', 1,\n35|           \"TestCaptureItemRefusals/machine_auth_included\", \"KILLED\",\n36|           \"always-excluded set missing machine_auth.\"),\n37|    Mutant(\"R-raw-subset-admits-machine_auth\", f\"{PACKAGE}/rawmanifest.go\",\n38|           '\\t\"derived_cache_optional\",\\n\\t\"unknown\",\\n',\n39|           '\\t\"derived_cache_optional\",\\n\\t\"machine_auth\",\\n\\t\"unknown\",\\n', 1,\n40|           \"TestRawManifestRefusals/build/machine_auth_forbidden\", \"KILLED\",\n41|           \"raw entry class subset admits machine_auth.\"),\n42|    Mutant(\"R-capture-items-dup-build\", f\"{PACKAGE}/capturebuild.go\",\n43|           \"\\t\\tif index > 0 && item.NativeItemKey <= previous {\\n\\t\\t\\treturn CaptureManifest{}, nil, invalid(\",\n44|           \"\\t\\tif index > 0 && item.NativeItemKey < previous {\\n\\t\\t\\treturn CaptureManifest{}, nil, invalid(\", 1,\n45|           \"TestCaptureItemRefusals/duplicate_items\", \"KILLED\",\n46|           \"capture items sorted-unique accepts an equal-key duplicate at BUILD.\"),\n47|    Mutant(\"R-capture-items-dup-decode\", f\"{PACKAGE}/capturebuild.go\",\n48|           \"\\t\\tif index > 0 && item.NativeItemKey <= previous {\\n\\t\\t\\treturn nil, invalid(\",\n49|           \"\\t\\tif index > 0 && item.NativeItemKey < previous {\\n\\t\\t\\treturn nil, invalid(\", 1,\n50|           \"Test\", \"KILLED\",\n51|           \"capture items sorted-unique accepts an equal-key duplicate at DECODE (whole suite as killer).\"),\n52|    Mutant(\"R-sorted-digests-dup-decode\", f\"{PACKAGE}/decode.go\",\n53|           \"\\t\\tif index > 0 && text <= previous {\\n\",\n54|           \"\\t\\tif index > 0 && text < previous {\\n\", 1,\n55|           \"Test\", \"KILLED\",\n56|           \"checkSortedUniqueDigests accepts an equal duplicate (heads/parents/fingerprints at decode).\"),\n57|    Mutant(\"R-sorted-strings-dup-decode\", f\"{PACKAGE}/decode.go\",\n58|           \"\\t\\tif index > 0 && value <= previous {\\n\",\n59|           \"\\t\\tif index > 0 && value < previous {\\n\", 1,\n60|           \"Test\", \"KILLED\",\n61|           \"checkSortedUniqueStrings accepts an equal duplicate (excluded_classes/reason_codes at decode).\"),\n62|    Mutant(\"R-rawrefs-dup-decode\", f\"{PACKAGE}/event.go\",\n63|           \"\\t\\tif index > 0 && bytes.Compare(canonical, previous) <= 0 {\\n\",\n64|           \"\\t\\tif index > 0 && bytes.Compare(canonical, previous) < 0 {\\n\", 1,\n65|           \"Test\", \"KILLED\",\n66|           \"raw_refs sorted-unique accepts an equal duplicate at DECODE.\"),\n67|    Mutant(\"R-sanitizer-admits-0x01\", f\"{PACKAGE}/identity.go\",\n68|           \"\\t\\tif unit < 0x20 || unit == 0x7f {\\n\",\n69|           \"\\t\\tif (unit < 0x20 && unit != 0x01) || unit == 0x7f {\\n\", 1,\n70|           \"Test\", \"KILLED\",\n71|           \"native-key sanitizer admits exactly U+0001.\"),\n72|    Mutant(\"R-sanitizer-admits-0x1f\", f\"{PACKAGE}/identity.go\",\n73|           \"\\t\\tif unit < 0x20 || unit == 0x7f {\\n\",\n74|           \"\\t\\tif (unit < 0x20 && unit != 0x1f) || unit == 0x7f {\\n\", 1,\n75|           \"TestIdentityRefusals/sanitizer\", \"KILLED\",\n76|           \"native-key sanitizer admits exactly U+001F (in the corpus).\"),\n77|    # --- decode-side duplicates of build-tested rules ---\n78|    Mutant(\"R-decode-item-class\", f\"{PACKAGE}/captureitem.go\",\n79|           '\\tif !ok || !ValidCaptureClass(class) {\\n\\t\\treturn CaptureItem{}, invalid(\"capture item[%d] class %q is outside the nine-class vocabulary\", index, class)\\n\\t}\\n\\tdisposition, ok := rawString(members[\"disposition\"])\\n',\n80|           '\\tif !ok || (!ValidCaptureClass(class) && class != \"mystery\") {\\n\\t\\treturn CaptureItem{}, invalid(\"capture item[%d] class %q is outside the nine-class vocabulary\", index, class)\\n\\t}\\n\\tdisposition, ok := rawString(members[\"disposition\"])\\n', 1,\n81|           \"Test\", \"KILLED\",\n82|           \"decodeCaptureItem admits exactly class mystery.\"),\n83|    Mutant(\"R-decode-actor-main-parent\", f\"{PACKAGE}/session.go\",\n84|           '\\tif kind == \"main\" && parent != nil {\\n',\n85|           '\\tif kind == \"main\" && parent != nil && index != 0 {\\n', 1,\n86|           \"Test\", \"KILLED\",\n87|           \"decodeActor admits exactly actor[0] main-with-parent.\"),\n88|    Mutant(\"R-decode-evidence-status\", f\"{PACKAGE}/event.go\",\n89|           '\\tstatus, ok := rawString(members[\"capture_status\"])\\n\\tif !ok || !validCaptureStatus(status) {\\n',\n90|           '\\tstatus, ok := rawString(members[\"capture_status\"])\\n\\tif !ok || (!validCaptureStatus(status) && status != \"maybe\") {\\n', 1,\n91|           \"Test\", \"KILLED\",\n92|           \"DecodeSourceEvidence admits exactly capture_status maybe.\"),\n93|    Mutant(\"R-decode-event-visibility\", f\"{PACKAGE}/event.go\",\n94|           '\\tif !ok || !validVisibility(visibility) {\\n\\t\\treturn CanonicalEvent{}, invalid(',\n95|           '\\tif !ok || (!validVisibility(visibility) && visibility != \"secret\") {\\n\\t\\treturn CanonicalEvent{}, invalid(', 1,\n96|           \"Test\", \"KILLED\",\n97|           \"DecodeCanonicalEvent admits exactly visibility secret.\"),\n98|    # --- verification entries with positive-only evidence ---\n99|    Mutant(\"R-verify-descriptors-skip-0\", f\"{PACKAGE}/rawmanifest.go\",\n100|           \"\\t\\tif err := VerifyDescriptorAgreement(descriptor, entry.BlobID, entry.ByteCount); err != nil {\\n\\t\\t\\treturn invalid(\\\"raw object entry[%d]: %v\\\", index, err)\\n\",\n101|           \"\\t\\tif err := VerifyDescriptorAgreement(descriptor, entry.BlobID, entry.ByteCount); err != nil && index != 0 {\\n\\t\\t\\treturn invalid(\\\"raw object entry[%d]: %v\\\", index, err)\\n\", 1,\n102|           \"Test\", \"KILLED\",\n103|           \"VerifyRawManifestDescriptors admits a disagreeing descriptor at entry 0.\"),\n104|    Mutant(\"R-install-site-claim\", f\"{PACKAGE}/blobref.go\",\n105|           \"\\tif calculated != claimed {\\n\\t\\treturn BlobAgreement{}, invalid(\",\n106|           \"\\tif calculated != claimed && false {\\n\\t\\treturn BlobAgreement{}, invalid(\", 1,\n107|           \"Test\", \"KILLED\",\n108|           \"InstallRawBlob install-site claim comparison disabled (the site N-descriptor-claim says it pins).\"),\n109|    Mutant(\"R-identity-digest-kind\", f\"{PACKAGE}/identity.go\",\n110|           \"func validNativeIdentityKind(kind string) bool {\\n\",\n111|           \"func validNativeIdentityKind(kind string) bool {\\n\\tif kind == \\\"imported\\\" {\\n\\t\\treturn true\\n\\t}\\n\", 1,\n112|           \"TestIdentityRefusals/native_identity/bad_kind\", \"KILLED\",\n113|           \"identity kind vocabulary admits exactly imported.\"),\n114|    Mutant(\"R-descriptor-id-unlinked2\", f\"{PACKAGE}/rawmanifest.go\",\n115|           \"\\t\\tif err := VerifyDescriptorAgreement(input.Descriptor, blobID, input.ByteCount); err != nil {\\n\\t\\t\\treturn nil, 0, invalid(\\\"raw object entry[%d]: %v\\\", index, err)\\n\\t\\t}\\n\",\n116|           \"\\t\\tif err := VerifyDescriptorAgreement(input.Descriptor, blobID, input.ByteCount); err != nil {\\n\\t\\t\\treturn nil, 0, invalid(\\\"raw object entry[%d]: %v\\\", index, err)\\n\\t\\t}\\n\\t\\tdescriptorID = scalar.SHA256Digest([]byte(input.DescriptorID))\\n\", 1,\n117|           \"Test\", \"KILLED\",\n118|           \"P1 witness: the sealed entry's blob_descriptor_id is replaced by an unrelated digest after agreement passes; no test notices.\"),\n119|    Mutant(\"C-review-comment\", f\"{PACKAGE}/generation.go\",\n120|           \"// This file owns the Section 13.14.1 immutable generations: the\\n\",\n121|           \"// This file owns the Section 13.14.1 immutable generations (control): the\\n\", 1,\n122|           \"Test\", \"SURVIVED\", \"Reviewer harmless control: comment-only edit must survive.\"),\n123|]\n124|\n125|\n126|def run_once(mutant, run_index):\n127|    target = CANDIDATE / mutant.path\n128|    original = target.read_text()\n129|    found = original.count(mutant.find)\n130|    log = LOGDIR / f\"{mutant.name}-run{run_index}.log\"\n131|    if found != mutant.count:\n132|        log.write_text(f\"NOT_APPLIED anchors={found} want={mutant.count}\\n\")\n133|        return \"NOT_APPLIED\", log\n134|    with tempfile.TemporaryDirectory() as staging:\n135|        backup = Path(staging) / \"backup\"\n136|        shutil.copy2(target, backup)\n137|        try:\n138|            target.write_text(original.replace(mutant.find, mutant.replace))\n139|            started = time.time()\n140|            proc = subprocess.run([\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n141|                                  cwd=CANDIDATE, capture_output=True, text=True, timeout=600,\n142|                                  env={**os.environ, \"PYTHONDONTWRITEBYTECODE\": \"1\"})\n143|            elapsed = time.time() - started\n144|        finally:\n145|            shutil.copy2(backup, target)\n146|    assert target.read_text() == original, \"restore failed\"\n147|    out = proc.stdout + proc.stderr\n148|    log.write_text(f\"# mutant={mutant.name} run={run_index} path={mutant.path} -run={mutant.run}\\n\"\n149|                   f\"# exit={proc.returncode} elapsed={elapsed:.1f}s\\n# find={mutant.find!r}\\n# replace={mutant.replace!r}\\n---\\n{out}\")\n150|    if \"build failed\" in out or \"\\n# \" in out or out.startswith(\"# \"):\n151|        return \"COMPILE_FAIL\", log\n152|    if proc.returncode == 0:\n153|        return \"SURVIVED\", log\n154|    if \"--- FAIL\" in out or \"FAIL:\" in out:\n155|        return \"KILLED\", log\n156|    return f\"ERROR(exit {proc.returncode})\", log\n157|\n158|\n159|def main(argv):\n160|    which = argv[0] if argv else \"all\"\n161|    repeats = int(argv[1]) if len(argv) > 1 else 1\n162|    table = {\"producer\": PRODUCER, \"reviewer\": REVIEWER, \"all\": PRODUCER + REVIEWER}[which]\n163|    print(f\"# runner={Path(__file__).name} candidate={CANDIDATE} set={which} repeats={repeats}\")\n164|    counts = {}\n165|    for m in table:\n166|        verdicts = []\n167|        for i in range(1, repeats + 1):\n168|            v, log = run_once(m, i)\n169|            verdicts.append(v)\n170|            print(f\"{m.name:44s} run{i} {v:14s} want={m.expect:9s} log={log.name}\", flush=True)\n171|        stable = len(set(verdicts)) == 1\n172|        mark = \"ok\" if stable and verdicts[0] == m.expect else \"MISMATCH\"\n173|        counts[mark] = counts.get(mark, 0) + 1\n174|        print(f\"  => {mark}: {m.name}: {'/'.join(verdicts)} :: {m.note}\", flush=True)\n175|    print(f\"# summary {counts}\")\n176|    return 0\n177|\n178|\n179|if __name__ == \"__main__\":\n180|    sys.exit(main(sys.argv[1:]))","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c651","stream":{"kind":"session","id":"01a0b0d3-448d-7fa1-9a80-daada0956017"},"sequence":387,"recorded_at":1780531400000769,"record_type":"event","durability":"durable","causation_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","run_stream":{"kind":"run","id":"f02750e1-95aa-4722-a114-f72ebe5c150a"},"call_id":"call_01a0b0d429c476be92a647f7a78e3356","text":"Read text file `/tmp/rev2ev/zz_review_probe_test.go.txt`.\n1|package clonebundle\n2|\n3|// Reviewer probes (TASK-260830-24z2b3 rev2). Test-only file in an isolated\n4|// candidate copy; every probe reports the production verdict, it never\n5|// asserts, so the log shows what each entry admits or refuses.\n6|\n7|import (\n8|\t\"bytes\"\n9|\t\"encoding/json\"\n10|\t\"fmt\"\n11|\t\"strings\"\n12|\t\"testing\"\n13|)\n14|\n15|func verdict(label string, err error) {\n16|\tif err == nil {\n17|\t\tfmt.Printf(\"PROBE %-58s ADMITTED\\n\", label)\n18|\t\treturn\n19|\t}\n20|\tfmt.Printf(\"PROBE %-58s REFUSED: %v\\n\", label, err)\n21|}\n22|\n23|func TestReviewProbes(t *testing.T) {\n24|\tidentity := fixtureNativeIdentity()\n25|\tidentityDigest, err := IdentityDigest(identity, nil)\n26|\tif err != nil {\n27|\t\tt.Fatal(err)\n28|\t}\n29|\tbuildRaw := func(inputs []EntryInput, ext map[string]any) ([]byte, error) {\n30|\t\treturn BuildRawObjectManifest(fixtureOperationID, []byte(fixtureTupleJSON()),\n31|\t\t\t\"native-session-alpha\", identityDigest.String(), fixtureDigest(\"test-capture-plan\"), inputs, ext)\n32|\t}\n33|\n34|\t// P1: entry blob_descriptor_id names a different descriptor than the bytes verified.\n35|\tinputs := validEntryInputs(t)\n36|\tinputs[0].DescriptorID = fixtureDigest(\"some-other-descriptor\")\n37|\tbuilt, err := buildRaw(inputs, nil)\n38|\tverdict(\"P1 raw entry descriptor_id != descriptor's own id (build)\", err)\n39|\tif err == nil {\n40|\t\tm, derr := DecodeRawObjectManifest(built)\n41|\t\tverdict(\"P1b decode of that manifest\", derr)\n42|\t\tif derr == nil {\n43|\t\t\tverr := VerifyRawManifestDescriptors(m, func(id string) ([]byte, error) {\n44|\t\t\t\tfor _, in := range inputs {\n45|\t\t\t\t\tif in.DescriptorID == id {\n46|\t\t\t\t\t\treturn in.Descriptor, nil\n47|\t\t\t\t\t}\n48|\t\t\t\t}\n49|\t\t\t\treturn nil, fmt.Errorf(\"missing %s\", id)\n50|\t\t\t})\n51|\t\t\tverdict(\"P1c VerifyRawManifestDescriptors with mismatched id\", verr)\n52|\t\t}\n53|\t}\n54|\n55|\t// P2: AX number model inside extension values (float, unsafe int, exponent).\n56|\tvalid := mustRawBytes(t)\n57|\tfor _, lit := range []string{`1.5`, `9007199254740993`, `1e2`, `1E400`, `-0`} {\n58|\t\tbody := strings.Replace(string(valid), `\"extensions\":{}`, `\"extensions\":{\"com.example.n\":`+lit+`}`, 1)\n59|\t\tvar members map[string]json.RawMessage\n60|\t\t_ = json.Unmarshal([]byte(body), &members)\n61|\t\t_, derr := omitSelfDigest(members, rawManifestSelf)\n62|\t\tverdict(\"P2 omitSelfDigest over extension number \"+lit, derr)\n63|\t\t_, derr = DecodeRawObjectManifest([]byte(body))\n64|\t\tverdict(\"P2b DecodeRawObjectManifest ext number \"+lit+\" (unsealed)\", derr)\n65|\t}\n66|\tbuilt, err = buildRaw(validEntryInputs(t), map[string]any{\"com.example.f\": 1.5, \"com.example.big\": uint64(1) << 60})\n67|\tverdict(\"P2c Build raw manifest with float/unsafe-int extension\", err)\n68|\tif err == nil {\n69|\t\t_, derr := DecodeRawObjectManifest(built)\n70|\t\tverdict(\"P2d Decode of that manifest\", derr)\n71|\t\tfmt.Printf(\"PROBE P2e built extensions bytes: %s\\n\", extractMember(built, \"extensions\"))\n72|\t}\n73|\n74|\t// P3: sanitizer edges (C1 control, line separator, zero-width space, schemeless credential, case, backslash).\n75|\tc1 := string(rune(0x85))\n76|\tlsep := string(rune(0x2028))\n77|\tzwsp := string(rune(0x200b))\n78|\tfor _, key := range []string{\"a\" + c1 + \"b\", \"a\" + lsep + \"b\", \"a\" + zwsp + \"b\", \"user:secret@example.com/path\", \"URN:AX:session\", \"~/home\", \"host-channel\\\\trust.json\", \"HOST-CHANNEL/trust.json\", \"./host-channel/trust.json\", \"host-channel//trust.json\"} {\n79|\t\tverdict(fmt.Sprintf(\"P3 SanitizeNativeKey(%q)\", key), SanitizeNativeKey(key))\n80|\t\tverdict(fmt.Sprintf(\"P3x refuseExcludedMember(%q)\", key), refuseExcludedMember(\"probe\", key, 0))\n81|\t}\n82|\n83|\t// P4: reconciliation with duplicate raw keys hiding a missing included key.\n84|\titems := []CaptureItem{\n85|\t\t{NativeItemKey: \"a\", Class: \"durable_payload\", Disposition: \"included\"},\n86|\t\t{NativeItemKey: \"b\", Class: \"durable_payload\", Disposition: \"included\"},\n87|\t}\n88|\tfmt.Printf(\"PROBE P4 deriveRawComplete(items a,b included; rawKeys=[a,a]) = %v (want false)\\n\", deriveRawComplete(items, []string{\"a\", \"b\"}, []string{\"a\", \"a\"}))\n89|\tfmt.Printf(\"PROBE P4b deriveRawComplete(items a,b; planKeys=[a,b,b]) = %v (want false)\\n\", deriveRawComplete(items, []string{\"a\", \"b\", \"b\"}, []string{\"a\", \"b\"}))\n90|\n91|\t// P5: Build capture manifest with items != plan candidates.\n92|\tin := validCaptureInput(t)\n93|\tin.PlanKeys = append(in.PlanKeys, \"store/zz-missing-item\")\n94|\tbuilt, err = BuildCaptureManifest(in)\n95|\tverdict(\"P5 BuildCaptureManifest items != plan candidates\", err)\n96|\tif err == nil {\n97|\t\tm, _ := DecodeCaptureManifest(built)\n98|\t\tfmt.Printf(\"PROBE P5b raw_complete=%v (built with plan/item mismatch)\\n\", m.RawComplete)\n99|\t}\n100|\n101|\t// P6: payload for the wrong kind.\n102|\tev := validEventInput(\"exact\")\n103|\tev.Kind = \"usage\"\n104|\tev.Payload = []byte(`{\"content_blocks\":[{\"type\":\"text\",\"content\":\"hi\"}],\"input_tokens\":3}`)\n105|\t_, err = BuildCanonicalEvent(ev)\n106|\tverdict(\"P6 usage event with content_blocks + facts\", err)\n107|\tev = validEventInput(\"exact\")\n108|\tev.Kind = \"tool_call\"\n109|\tev.Payload = []byte(`{\"anything\":{\"goes\":true},\"transcript\":\"x\"}`)\n110|\t_, err = BuildCanonicalEvent(ev)\n111|\tverdict(\"P6b tool_call event with arbitrary payload members\", err)\n112|\tev = validEventInput(\"exact\")\n113|\tev.Payload = []byte(`{\"content_blocks\":[{\"type\":\"text\"}],\"extensions\":{}}`)\n114|\t_, err = BuildCanonicalEvent(ev)\n115|\tverdict(\"P7 message block with neither content nor descriptor\", err)\n116|\tev = validEventInput(\"exact\")\n117|\tev.Payload = []byte(`{\"content_blocks\":[{\"type\":\"text\",\"content\":\"x\",\"blob_descriptor_id\":\"` + fixtureDigest(\"d\") + `\"}],\"extensions\":{}}`)\n118|\t_, err = BuildCanonicalEvent(ev)\n119|\tverdict(\"P7b message block with BOTH content and descriptor\", err)\n120|\tev = validEventInput(\"exact\")\n121|\tev.Payload = []byte(`{\"content_blocks\":[{\"type\":\"text\",\"content\":\"x\"}]}`)\n122|\t_, err = BuildCanonicalEvent(ev)\n123|\tverdict(\"P7c message payload without extensions member\", err)\n124|\n125|\t// P8: subagent whose parent is not an actor of the session.\n126|\ts := validSessionInput()\n127|\ts.Actors[1].ParentActorID = strptr(fixtureTurnID)\n128|\t_, err = BuildCanonicalSession(s)\n129|\tverdict(\"P8 actor parent not in actors list\", err)\n130|\n131|\t// P9: IdentityDigest over an identity Decode would refuse.\n132|\tbad := fixtureNativeIdentity()\n133|\tbad.IdentityKind = \"bogus\"\n134|\t_, err = IdentityDigest(bad, nil)\n135|\tverdict(\"P9 IdentityDigest(identity_kind=bogus)\", err)\n136|\t_, err = IdentityDigest(fixtureNativeIdentity(), map[string]any{\"no-dots\": 1})\n137|\tverdict(\"P9b IdentityDigest(bad extension keys)\", err)\n138|\n139|\t// P10: decode-side gates that the suite never reaches (do they exist?).\n140|\tcap := mustCaptureBytes(t)\n141|\tfor _, tc := range []struct {\n142|\t\tname string\n143|\t\tmut  func(map[string]any)\n144|\t}{\n145|\t\t{\"P10 decode item class mystery\", func(o map[string]any) { o[\"items\"].([]any)[0].(map[string]any)[\"class\"] = \"mystery\" }},\n146|\t\t{\"P10b decode item disposition maybe\", func(o map[string]any) { o[\"items\"].([]any)[0].(map[string]any)[\"disposition\"] = \"maybe\" }},\n147|\t\t{\"P10c decode included item with reason\", func(o map[string]any) { o[\"items\"].([]any)[0].(map[string]any)[\"exclusion_reason\"] = \"r\" }},\n148|\t\t{\"P10d decode excluded item with content\", func(o map[string]any) { o[\"items\"].([]any)[2].(map[string]any)[\"byte_count\"] = float64(3) }},\n149|\t\t{\"P10e decode credential included\", func(o map[string]any) {\n150|\t\t\tit := o[\"items\"].([]any)[2].(map[string]any)\n151|\t\t\tit[\"disposition\"] = \"included\"\n152|\t\t\tit[\"blob_descriptor_id\"] = fixtureDigest(\"d\")\n153|\t\t\tit[\"byte_count\"] = float64(3)\n154|\t\t\tit[\"exclusion_reason\"] = nil\n155|\t\t\to[\"excluded_classes\"] = []any{}\n156|\t\t}},\n157|\t\t{\"P10f decode items duplicate key\", func(o map[string]any) {\n158|\t\t\tits := o[\"items\"].([]any)\n159|\t\t\tits[1].(map[string]any)[\"native_item_key\"] = its[0].(map[string]any)[\"native_item_key\"]\n160|\t\t}},\n161|\t\t{\"P10g decode raw_complete not bool\", func(o map[string]any) { o[\"raw_complete\"] = \"yes\" }},\n162|\t\t{\"P10h decode unstable boundary missing generation\", func(o map[string]any) {\n163|\t\t\to[\"capture_boundary\"] = map[string]any{\"kind\": \"unstable_archive\", \"pre_capture_digest\": fixtureDigest(\"a\"), \"post_capture_digest\": fixtureDigest(\"b\"), \"reason_code\": \"source_not_quiescent\", \"operator_explicit\": true, \"target_projection_forbidden\": true, \"extensions\": map[string]any{}}\n164|\t\t}},\n165|\t\t{\"P10i decode source_identity unsanitized\", func(o map[string]any) { o[\"source_identity\"].(map[string]any)[\"native_session_id\"] = \"/abs\" }},\n166|\t\t{\"P10j decode boundary proof unequal digests\", func(o map[string]any) {\n167|\t\t\to[\"capture_boundary\"].(map[string]any)[\"proof\"].(map[string]any)[\"post_capture_digest\"] = fixtureDigest(\"zzz\")\n168|\t\t}},\n169|\t} {\n170|\t\t_, derr := DecodeCaptureManifest(tamper(t, cap, tc.mut))\n171|\t\tverdict(tc.name, derr)\n172|\t}\n173|\tevb := mustEventBytes(t, \"exact\")\n174|\tfor _, tc := range []struct {\n175|\t\tname string\n176|\t\tmut  func(map[string]any)\n177|\t}{\n178|\t\t{\"P11 decode evidence status maybe\", func(o map[string]any) { o[\"source_evidence\"].(map[string]any)[\"capture_status\"] = \"maybe\" }},\n179|\t\t{\"P11b decode evidence raw_refs duplicate\", func(o map[string]any) {\n180|\t\t\te := o[\"source_evidence\"].(map[string]any)\n181|\t\t\tr := e[\"raw_refs\"].([]any)\n182|\t\t\te[\"raw_refs\"] = []any{r[0], r[0]}\n183|\t\t}},\n184|\t\t{\"P11c decode evidence reason_codes dup\", func(o map[string]any) { o[\"source_evidence\"].(map[string]any)[\"reason_codes\"] = []any{\"a\", \"a\"} }},\n185|\t\t{\"P11d decode parents dup\", func(o map[string]any) { o[\"parents\"] = []any{fixtureDigest(\"p\"), fixtureDigest(\"p\")} }},\n186|\t\t{\"P11e decode visibility secret\", func(o map[string]any) { o[\"visibility\"] = \"secret\" }},\n187|\t\t{\"P11f decode exact with core op\", func(o map[string]any) { o[\"source_evidence\"].(map[string]any)[\"core_operation_id\"] = fixtureOperationID }},\n188|\t} {\n189|\t\t_, derr := DecodeCanonicalEvent(tamper(t, evb, tc.mut))\n190|\t\tverdict(tc.name, derr)\n191|\t}\n192|\tsb := mustSessionBytes(t)\n193|\tfor _, tc := range []struct {\n194|\t\tname string\n195|\t\tmut  func(map[string]any)\n196|\t}{\n197|\t\t{\"P12 decode main actor with parent\", func(o map[string]any) { o[\"actors\"].([]any)[0].(map[string]any)[\"parent_actor_id\"] = fixtureActorSub }},\n198|\t\t{\"P12b decode subagent null parent\", func(o map[string]any) { o[\"actors\"].([]any)[1].(map[string]any)[\"parent_actor_id\"] = nil }},\n199|\t\t{\"P12c decode actor kind ghost\", func(o map[string]any) { o[\"actors\"].([]any)[1].(map[string]any)[\"kind\"] = \"ghost\" }},\n200|\t\t{\"P12d decode heads dup\", func(o map[string]any) { h := o[\"head_event_ids\"].([]any); o[\"head_event_ids\"] = []any{h[0], h[0]} }},\n201|\t\t{\"P12e decode title empty\", func(o map[string]any) { o[\"title\"] = \"\" }},\n202|\t} {\n203|\t\t_, derr := DecodeCanonicalSession(tamper(t, sb, tc.mut))\n204|\t\tverdict(tc.name, derr)\n205|\t}\n206|\n207|\t// P13: generation prefix comparison.\n208|\tg1 := MustParseGeneration(\"generation-1\")\n209|\tg10 := MustParseGeneration(\"generation-10\")\n210|\tfmt.Printf(\"PROBE P13 generation-1.Equal(generation-10) = %v (want false)\\n\", g1.Equal(g10))\n211|\n212|\t// P14: install with descriptor size disagreeing with supplied bytes.\n213|\tstore := openFixtureStore(t)\n214|\tdescriptor, _, _, _ := makeDescriptor(t, []byte(\"twelve-bytes\"))\n215|\t_, err = InstallRawBlob(store, descriptor, bytes.NewReader([]byte(\"short\")))\n216|\tverdict(\"P14 InstallRawBlob bytes shorter than descriptor size\", err)\n217|\t_, err = InstallRawBlob(store, descriptor, bytes.NewReader([]byte(\"twelve-bytes-and-more\")))\n218|\tverdict(\"P14b InstallRawBlob bytes longer than descriptor size\", err)\n219|\ttampered := tamper(t, descriptor, func(o map[string]any) { o[\"blob_id\"] = fixtureDigest(\"other\") })\n220|\t_, err = InstallRawBlob(store, tampered, bytes.NewReader([]byte(\"twelve-bytes\")))\n221|\tverdict(\"P14c InstallRawBlob descriptor blob_id != chunk digest (unsealed)\", err)\n222|\n223|\t// P15: VerifyRawManifestDescriptors negatives (positive-only in suite).\n224|\tm, _ := DecodeRawObjectManifest(mustRawBytes(t))\n225|\tverdict(\"P15 VerifyRawManifestDescriptors fetch error\", VerifyRawManifestDescriptors(m, func(string) ([]byte, error) { return nil, fmt.Errorf(\"boom\") }))\n226|\tverdict(\"P15b VerifyRawManifestDescriptors empty\", VerifyRawManifestDescriptors(m, func(string) ([]byte, error) { return nil, nil }))\n227|\twrong, _, _, _ := makeDescriptor(t, []byte(\"unrelated\"))\n228|\tverdict(\"P15c VerifyRawManifestDescriptors wrong descriptor\", VerifyRawManifestDescriptors(m, func(string) ([]byte, error) { return wrong, nil }))\n229|\n230|\t// P16: duplicate-key decode edge.\n231|\t_, err = DecodeRawObjectManifest([]byte(strings.Replace(string(valid), `\"schema_version\":\"1.0.0\"`, `\"schema_version\":\"1.0.0\",\"schema_version\":\"1.0.0\"`, 1)))\n232|\tverdict(\"P16 duplicate member at decode\", err)\n233|}\n234|\n235|func extractMember(data []byte, name string) string {\n236|\tvar m map[string]json.RawMessage\n237|\t_ = json.Unmarshal(data, &m)\n238|\treturn string(m[name])\n239|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
