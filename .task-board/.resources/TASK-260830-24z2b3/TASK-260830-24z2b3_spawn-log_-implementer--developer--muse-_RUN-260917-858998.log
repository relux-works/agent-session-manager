{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb69","stream":{"kind":"session","id":"01a0b0d3-448d-7fa1-9a80-daada0956017"},"sequence":1039,"recorded_at":1780531400002073,"record_type":"event","durability":"durable","causation_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f02750e1-95aa-4722-a114-f72ebe5c150a","run_stream":{"kind":"run","id":"f02750e1-95aa-4722-a114-f72ebe5c150a"},"task_stream":{"kind":"task","id":"01a0b0d7-b36a-73e0-81bb-757c8d2fe335"},"task_id":"01a0b0d7-b36a-73e0-81bb-757c8d2fe335","event":{"kind":"output","task_id":"01a0b0d7-b36a-73e0-81bb-757c8d2fe335","chunk":"{\n  \"chunk_id\": \"exec-17-1\",\n  \"command\": \"grep -n \\\"func validateAXNumbers\\\" -A 60 internal/canonicaljson/canonical.go; echo =====; sed -n '420,480p' internal/canonicaljson/canonical.go\",\n  \"description\": \"Read AX number validation and strict decode\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"487:func validateAXNumbers(value any) error {\\n488-\\tswitch typed := value.(type) {\\n489-\\tcase json.Number:\\n490-\\t\\tliteral := typed.String()\\n491-\\t\\tif strings.ContainsAny(literal, \\\".eE\\\") {\\n492-\\t\\t\\treturn invalidIdentity(\\\"floating-point number %q is forbidden by the AX common model\\\", literal)\\n493-\\t\\t}\\n494-\\t\\tinteger, err := strconv.ParseInt(literal, 10, 64)\\n495-\\t\\tif err != nil || integer < -maxSafeInteger || integer > maxSafeInteger {\\n496-\\t\\t\\treturn invalidIdentity(\\\"integer %q is outside the AX safe-integer interval\\\", literal)\\n497-\\t\\t}\\n498-\\tcase []any:\\n499-\\t\\tfor _, element := range typed {\\n500-\\t\\t\\tif err := validateAXNumbers(element); err != nil {\\n501-\\t\\t\\t\\treturn err\\n502-\\t\\t\\t}\\n503-\\t\\t}\\n504-\\tcase map[string]any:\\n505-\\t\\tfor _, member := range typed {\\n506-\\t\\t\\tif err := validateAXNumbers(member); err != nil {\\n507-\\t\\t\\t\\treturn err\\n508-\\t\\t\\t}\\n509-\\t\\t}\\n510-\\t}\\n511-\\treturn nil\\n512-}\\n513-\\n514-func validateSurrogateEscapes(input []byte) error {\\n515-\\tfor index := 0; index < len(input); index++ {\\n516-\\t\\tif input[index] != '\\\"' {\\n517-\\t\\t\\tcontinue\\n518-\\t\\t}\\n519-\\t\\tfor index++; index < len(input); index++ {\\n520-\\t\\t\\tswitch input[index] {\\n521-\\t\\t\\tcase '\\\"':\\n522-\\t\\t\\t\\tgoto stringComplete\\n523-\\t\\t\\tcase '\\\\\\\\':\\n524-\\t\\t\\t\\tindex++\\n525-\\t\\t\\t\\tif index >= len(input) {\\n526-\\t\\t\\t\\t\\treturn invalidJSON(\\\"unterminated string escape\\\")\\n527-\\t\\t\\t\\t}\\n528-\\t\\t\\t\\tif input[index] != 'u' {\\n529-\\t\\t\\t\\t\\tcontinue\\n530-\\t\\t\\t\\t}\\n531-\\t\\t\\t\\tcodeUnit, end, err := readUTF16Escape(input, index-1)\\n532-\\t\\t\\t\\tif err != nil {\\n533-\\t\\t\\t\\t\\treturn err\\n534-\\t\\t\\t\\t}\\n535-\\t\\t\\t\\tindex = end - 1\\n536-\\t\\t\\t\\tswitch {\\n537-\\t\\t\\t\\tcase codeUnit >= 0xd800 && codeUnit <= 0xdbff:\\n538-\\t\\t\\t\\t\\tsecond, secondEnd, err := readUTF16Escape(input, end)\\n539-\\t\\t\\t\\t\\tif err != nil || second < 0xdc00 || second > 0xdfff {\\n540-\\t\\t\\t\\t\\t\\treturn invalidJSON(\\\"high surrogate escape must be followed by a low surrogate escape\\\")\\n541-\\t\\t\\t\\t\\t}\\n542-\\t\\t\\t\\t\\tindex = secondEnd - 1\\n543-\\t\\t\\t\\tcase codeUnit >= 0xdc00 && codeUnit <= 0xdfff:\\n544-\\t\\t\\t\\t\\treturn invalidJSON(\\\"lone low surrogate escape is forbidden\\\")\\n545-\\t\\t\\t\\t}\\n546-\\t\\t\\tcase 0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,\\n547-\\t\\t\\t\\t0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,\\n=====\\n// decodeValue decodes one logical JSON value. depth counts the containers\\n// already open around this value, so the top-level value is decoded at depth 0\\n// and a container at depth maxNestingDepth-1 is the last one allowed to open.\\nfunc decodeValue(decoder *json.Decoder, depth int) (any, error) {\\n\\ttoken, err