{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c799","stream":{"kind":"session","id":"01a0d536-7d14-7863-b4a5-d6cfb7bdb4fc"},"sequence":551,"recorded_at":1780531400001097,"record_type":"event","durability":"durable","causation_id":"f8f39da6-44fd-4b55-a795-0893d87482b7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f8f39da6-44fd-4b55-a795-0893d87482b7","run_stream":{"kind":"run","id":"f8f39da6-44fd-4b55-a795-0893d87482b7"},"task_stream":{"kind":"task","id":"01a0d538-dce1-73a3-acb9-062517bf093b"},"task_id":"01a0d538-dce1-73a3-acb9-062517bf093b","event":{"kind":"output","task_id":"01a0d538-dce1-73a3-acb9-062517bf093b","chunk":"Read text file `internal/clonereadback/decode.go`.\n1|package clonereadback\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"unicode/utf8\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|)\n14|\n15|// This file holds parse-only helpers for the two Section 13.14.2\n16|// validation closed shapes. Helpers report verdicts; every refusal\n17|// is constructed at the deciding site with a literal detail so each\n18|// rule stays a distinct gate. Strict object decoding, scalar\n19|// bounds, sorted-unique arrays, and the character measure delegate\n20|// to the landed environ owner; closed extension values and the\n21|// omit-self digest delegate to the clonebundle owner; tuples,\n22|// workspace bindings, and findings decode through their owners at\n23|// the call site.\n24|\n25|const maxUint53 = uint64(1<<53 - 1)\n26|\n27|type frameFault struct {\n28|\tdetail string\n29|\tmember string\n30|}\n31|\n32|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n33|\tmembers, fault := environ.DecodeStrictObject(data)\n34|\tif fault != nil {\n35|\t\treturn nil, &frameFault{detail: fault.Detail, member: fault.Member}\n36|\t}\n37|\treturn members, nil\n38|}\n39|\n40|func memberField(member string) string {\n41|\tif member == \"\" {\n42|\t\treturn \"frame\"\n43|\t}\n44|\treturn \"member \" + member\n45|}\n46|\n47|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n48|\tfor name := range members {\n49|\t\tif !allowed[name] {\n50|\t\t\treturn name, true\n51|\t\t}\n52|\t}\n53|\treturn \"\", false\n54|}\n55|\n56|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n57|\tfor _, name := range required {\n58|\t\tif _, present := members[name]; !present {\n59|\t\t\treturn name, true\n60|\t\t}\n61|\t}\n62|\treturn \"\", false\n63|}\n64|\n65|func rawString(raw json.RawMessage) (string, bool) {\n66|\t// encoding/json unmarshals null into a string without an error,\n67|\t// so null is rejected explicitly: every string member here is\n68|\t// required non-null.\n69|\tif isNull(raw) {\n70|\t\treturn \"\", false\n71|\t}\n72|\tvar value string\n73|\tif err := json.Unmarshal(raw, &value); err != nil {\n74|\t\treturn \"\", false\n75|\t}\n76|\treturn value, true\n77|}\n78|\n79|func rawBool(raw json.RawMessage) (bool, bool) {\n80|\t// encoding/json unmarshals null into a bool without an error,\n81|\t// so null is rejected explicitly: a missing boolean is never a\n82|\t// false one.\n83|\tif isNull(raw) {\n84|\t\treturn false, false\n85|\t}\n86|\tvar value bool\n87|\tif err := json.Unmarshal(raw, &value); err != nil {\n88|\t\treturn false, false\n89|\t}\n90|\treturn value, true\n91|}\n92|\n93|// stringLength is the Section 1.6 string measure in characters, not\n94|// bytes. It delegates to the single environ measure so the two can\n95|// never drift.\n96|func stringLength(value string) int {\n97|\treturn environ.StringLength(value)\n98|}\n99|\n100|// checkStringBounds reports whether the member is a JSON string\n101|// whose character count falls in the inclusive bound. It delegates\n102|// to the environ gate.\n103|func checkStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n104|\treturn environ.CheckStringBounds(raw, minimum, maximum)\n105|}\n106|\n107|// checkUint53Bounds reports whether the member is a uint53 in the\n108|// inclusive bound. It delegates to the environ gate.\n109|func checkUint53Bounds(raw json.RawMessage, minimum, maximum uint64) (uint64, bool) {\n110|\treturn environ.CheckUint53Bounds(raw, minimum, maximum)\n111|}\n112|\n113|// checkDigest reports whether the member is a digest of the pinned\n114|// sha256 form. It delegates to the environ gate.\n115|func checkDigest(raw json.RawMessage) (scalar.Digest, bool) {\n116|\treturn environ.CheckDigest(raw)\n117|}\n118|\n119|// checkUUIDv7 reports whether the member is a lowercase UUIDv7. It\n120|// delegates to the environ gate.\n121|func checkUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n122|\treturn environ.CheckUUIDv7(raw)\n123|}\n124|\n125|// checkSortedUniqueStrings reports whether the member is an array of\n126|// strings in the item bound whose order is strictly increasing with\n127|// no duplicates. It delegates to the environ gate.\n128|func checkSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n129|\treturn environ.CheckSortedUniqueStrings(raw, minimumLength, maximumLength, minimumCount, maximumCount)\n130|}\n131|\n132|func isNull(raw json.RawMessage) bool {\n133|\treturn string(bytes.TrimSpace(raw)) == \"null\"\n134|}\n135|\n136|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n137|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n138|\ttoken, err := decoder.Token()\n139|\tif err != nil {\n140|\t\treturn nil, false\n141|\t}\n142|\tdelimiter, ok := token.(json.Delim)\n143|\tif !ok || delimiter != '[' {\n144|\t\treturn nil, false\n145|\t}\n146|\tvar elements []json.RawMessage\n147|\tfor decoder.More() {\n148|\t\tvar element json.RawMessage\n149|\t\tif err := decoder.Decode(&element); err != nil {\n150|\t\t\treturn nil, false\n151|\t\t}\n152|\t\telements = append(elements, element)\n153|\t}\n154|\ttoken, err = decoder.Token()\n155|\tif err != nil {\n156|\t\treturn nil, false\n157|\t}\n158|\tdelimiter, ok = token.(json.Delim)\n159|\tif !ok || delimiter != ']' {\n160|\t\treturn nil, false\n161|\t}\n162|\tif _, err := decoder.Token(); err != io.EOF {\n163|\t\treturn nil, false\n164|\t}\n165|\tif elements == nil {\n166|\t\telements = []json.RawMessage{}\n167|\t}\n168|\treturn elements, true\n169|}\n170|\n171|// validText reports whether the value is valid UTF-8 text. Section\n172|// 1.6 requires text to be valid UTF-8, and encoding/json silently\n173|// rewrites invalid bytes to U+FFFD instead of failing — so every\n174|// Build-side string admission runs this gate BEFORE marshaling, and\n175|// refuses what it cannot seal byte-exactly.\n176|func validText(value string) bool {\n177|\treturn utf8.ValidString(value)\n178|}\n179|\n180|// checkExtensionsClosed enforces the full closed extensions rule via\n181|// the clonebundle owner: reverse-DNS keys and values inside the AX\n182|// common logical data model. It returns nil when the member is\n183|// closed, otherwise the refusal detail naming the failed rule.\n184|func checkExtensionsClosed(raw json.RawMessage) error {\n185|\treturn clonebundle.CheckExtensionsClosed(raw)\n186|}\n187|\n188|// canonicalizeObject renders one closed object deterministically:\n189|// the members marshal in any order and the JCS transform sorts\n190|// them, so identical logical inputs always produce identical bytes.\n191|func canonicalizeObject(object map[string]any) ([]byte, error) {\n192|\tplain, err := json.Marshal(object)\n193|\tif err != nil {\n194|\t\treturn nil, invalid(\"serialize validation object: %v\", err)\n195|\t}\n196|\tcanonical, err := canonicaljson.Canonicalize(plain)\n197|\tif err != nil {\n198|\t\treturn nil, invalid(\"canonicalize validation object: %v\", err)\n199|\t}\n200|\treturn canonical, nil\n201|}\n202|\n203|// verifySelfDigest recomputes the omit-self identity through the\n204|// clonebundle owner and refuses a mismatch against the claimed self\n205|// digest.\n206|func verifySelfDigest(members map[string]json.RawMessage, selfField string, claimed scalar.Digest) error {\n207|\tcalculated, err := clonebundle.OmitSelfDigest(members, selfField)\n208|\tif err != nil {\n209|\t\treturn err\n210|\t}\n211|\tif calculated != claimed {\n212|\t\treturn invalid(\"%s claim %q does not match omit-self digest %q\", selfField, claimed.String(), calculated.String())\n213|\t}\n214|\treturn nil\n215|}\n216|\n217|// checkSortedUniqueBoundedStrings reports whether the\n218|// caller-supplied Build input is sorted unique bounded strings in\n219|// the count bound. It mirrors the decode string-array gate for Go\n220|// inputs: UTF-8 first (so nothing seals rewritten), then character\n221|// bounds, then strict order.\n222|func checkSortedUniqueBoundedStrings(values []string, minimumLength, maximumLength int, minimumCount, maximumCount int, owner, member string) ([]string, error) {\n223|\tif len(values) < minimumCount || len(values) > maximumCount {\n224|\t\treturn nil, invalid(\"%s %s carries %d items, want [%d..%d]\", owner, member, len(values), minimumCount, maximumCount)\n225|\t}\n226|\tfor index, value := range values {\n227|\t\tif !validText(value) {\n228|\t\t\treturn nil, invalid(\"%s %s[%d] is not valid UTF-8\", owner, member, index)\n229|\t\t}\n230|\t\tif length := stringLength(value); length < minimumLength || length > maximumLength {\n231|\t\t\treturn nil, invalid(\"%s %s[%d] is not a string[%d..%d]\", owner, member, index, minimumLength, maximumLength)\n232|\t\t}\n233|\t\tif index > 0 && value <= values[index-1] {\n234|\t\t\treturn nil, invalid(\"%s %s are not sorted unique\", owner, member)\n235|\t\t}\n236|\t}\n237|\treturn append([]string(nil), values...), nil\n238|}\n239|\n240|// stringValues renders strings for the sealed object.\n241|func stringValues(values []string) []any {\n242|\trendered := make([]any, 0, len(values))\n243|\tfor _, value := range values {\n244|\t\trendered = append(rendered, value)\n245|\t}\n246|\treturn rendered\n247|}","final_result":true}}}
