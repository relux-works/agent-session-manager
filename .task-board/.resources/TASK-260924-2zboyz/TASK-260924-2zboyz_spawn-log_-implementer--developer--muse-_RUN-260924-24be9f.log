{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7a1","stream":{"kind":"session","id":"01a0d536-7d14-7863-b4a5-d6cfb7bdb4fc"},"sequence":555,"recorded_at":1780531400001105,"record_type":"event","durability":"durable","causation_id":"f8f39da6-44fd-4b55-a795-0893d87482b7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f8f39da6-44fd-4b55-a795-0893d87482b7","run_stream":{"kind":"run","id":"f8f39da6-44fd-4b55-a795-0893d87482b7"},"call_id":"call_01a0d538d7bd71e885f6fe63540a5edc","text":"Read text file `internal/clonereadback/decode.go`.\n1|package clonereadback\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"unicode/utf8\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|)\n14|\n15|// This file holds parse-only helpers for the two Section 13.14.2\n16|// validation closed shapes. Helpers report verdicts; every refusal\n17|// is constructed at the deciding site with a literal detail so each\n18|// rule stays a distinct gate. Strict object decoding, scalar\n19|// bounds, sorted-unique arrays, and the character measure delegate\n20|// to the landed environ owner; closed extension values and the\n21|// omit-self digest delegate to the clonebundle owner; tuples,\n22|// workspace bindings, and findings decode through their owners at\n23|// the call site.\n24|\n25|const maxUint53 = uint64(1<<53 - 1)\n26|\n27|type frameFault struct {\n28|\tdetail string\n29|\tmember string\n30|}\n31|\n32|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n33|\tmembers, fault := environ.DecodeStrictObject(data)\n34|\tif fault != nil {\n35|\t\treturn nil, &frameFault{detail: fault.Detail, member: fault.Member}\n36|\t}\n37|\treturn members, nil\n38|}\n39|\n40|func memberField(member string) string {\n41|\tif member == \"\" {\n42|\t\treturn \"frame\"\n43|\t}\n44|\treturn \"member \" + member\n45|}\n46|\n47|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n48|\tfor name := range members {\n49|\t\tif !allowed[name] {\n50|\t\t\treturn name, true\n51|\t\t}\n52|\t}\n53|\treturn \"\", false\n54|}\n55|\n56|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n57|\tfor _, name := range required {\n58|\t\tif _, present := members[name]; !present {\n59|\t\t\treturn name, true\n60|\t\t}\n61|\t}\n62|\treturn \"\", false\n63|}\n64|\n65|func rawString(raw json.RawMessage) (string, bool) {\n66|\t// encoding/json unmarshals null into a string without an error,\n67|\t// so null is rejected explicitly: every string member here is\n68|\t// required non-null.\n69|\tif isNull(raw) {\n70|\t\treturn \"\", false\n71|\t}\n72|\tvar value string\n73|\tif err := json.Unmarshal(raw, &value); err != nil {\n74|\t\treturn \"\", false\n75|\t}\n76|\treturn value, true\n77|}\n78|\n79|func rawBool(raw json.RawMessage) (bool, bool) {\n80|\t// encoding/json unmarshals null into a bool without an error,\n81|\t// so null is rejected explicitly: a missing boolean is never a\n82|\t// false one.\n83|\tif isNull(raw) {\n84|\t\treturn false, false\n85|\t}\n86|\tvar value bool\n87|\tif err := json.Unmarshal(raw, &value); err != nil {\n88|\t\treturn false, false\n89|\t}\n90|\treturn value, true\n91|}\n92|\n93|// stringLength is the Section 1.6 string measure in characters, not\n94|// bytes. It delegates to the single environ measure so the two can\n95|// never drift.\n96|func stringLength(value string) int {\n97|\treturn environ.StringLength(value)\n98|}\n99|\n100|// checkStringBounds reports whether the member is a JSON string\n101|// whose character count falls in the inclusive bound. It delegates\n102|// to the environ gate.\n103|func checkStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n104|\treturn environ.CheckStringBounds(raw, minimum, maximum)\n105|}\n106|\n107|// checkUint53Bounds reports whether the member is a uint53 in the\n108|// inclusive bound. It delegates to the environ gate.\n109|func checkUint53Bounds(raw json.RawMessage, minimum, maximum uint64) (uint64, bool) {\n110|\treturn environ.CheckUint53Bounds(raw, minimum, maximum)\n111|}\n112|\n113|// checkDigest reports whether the member is a digest of the pinned\n114|// sha256 form. It delegates to the environ gate.\n115|func checkDigest(raw json.RawMessage) (scalar.Digest, bool) {\n116|\treturn environ.CheckDigest(raw)\n117|}\n118|\n119|// checkUUIDv7 reports whether the member is a lowercase UUIDv7. It\n120|// delegates to the environ gate.\n121|func checkUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n122|\treturn environ.CheckUUIDv7(raw)\n123|}\n124|\n125|// checkSortedUniqueStrings reports whether the member is an array of\n126|// strings in the item bound whose order is strictly increasing with\n127|// no duplicates. It delegates to the environ gate.\n128|func checkSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n129|\treturn environ.CheckSortedUniqueStrings(raw, minimumLength, maximumLength, minimumCount, maximumCount)\n130|}\n131|\n132|func isNull(raw json.RawMessage) bool {\n133|\treturn string(bytes.TrimSpace(raw)) == \"null\"\n134|}\n135|\n136|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n137|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n138|\ttoken, err := decoder.Token()\n139|\tif err != nil {\n140|\t\treturn nil, false\n141|\t}\n142|\tdelimiter, ok := token.(json.Delim)\n143|\tif !ok || delimiter != '[' {\n144|\t\treturn nil, false\n145|\t}\n146|\tvar elements []json.RawMessage\n147|\tfor decoder.More() {\n148|\t\tvar element json.RawMessage\n149|\t\tif err := decoder.Decode(&element); err != nil {\n150|\t\t\treturn nil, false\n151|\t\t}\n152|\t\telements = append(elements, element)\n153|\t}\n154|\ttoken, err = decoder.Token()\n155|\tif err != nil {\n156|\t\treturn nil, false\n157|\t}\n158|\tdelimiter, ok = token.(json.Delim)\n159|\tif !ok || delimiter != ']' {\n160|\t\treturn nil, false\n161|\t}\n162|\tif _, err := decoder.Token(); err != io.EOF {\n163|\t\treturn nil, false\n164|\t}\n165|\tif elements == nil {\n166|\t\telements = []json.RawMessage{}\n167|\t}\n168|\treturn elements, true\n169|}\n170|\n171|// validText reports whether the value is valid UTF-8 text. Section\n172|// 1.6 requires text to be valid UTF-8, and encoding/json silently\n173|// rewrites invalid bytes to U+FFFD instead of failing — so every\n174|// Build-side string admission runs this gate BEFORE marshaling, and\n175|// refuses what it cannot seal byte-exactly.\n176|func validText(value string) bool {\n177|\treturn utf8.ValidString(value)\n178|}\n179|\n180|// checkExtensionsClosed enforces the full closed extensions rule via\n181|// the clonebundle owner: reverse-DNS keys and values inside the AX\n182|// common logical data model. It returns nil when the member is\n183|// closed, otherwise the refusal detail naming the failed rule.\n184|func checkExtensionsClosed(raw json.RawMessage) error {\n185|\treturn clonebundle.CheckExtensionsClosed(raw)\n186|}\n187|\n188|// canonicalizeObject renders one closed object deterministically:\n189|// the members marshal in any order and the JCS transform sorts\n190|// them, so identical logical inputs always produce identical bytes.\n191|func canonicalizeObject(object map[string]any) ([]byte, error) {\n192|\tplain, err := json.Marshal(object)\n193|\tif err != nil {\n194|\t\treturn nil, invalid(\"serialize validation object: %v\", err)\n195|\t}\n196|\tcanonical, err := canonicaljson.Canonicalize(plain)\n197|\tif err != nil {\n198|\t\treturn nil, invalid(\"canonicalize validation object: %v\", err)\n199|\t}\n200|\treturn canonical, nil\n201|}\n202|\n203|// verifySelfDigest recomputes the omit-self identity through the\n204|// clonebundle owner and refuses a mismatch against the claimed self\n205|// digest.\n206|func verifySelfDigest(members map[string]json.RawMessage, selfField string, claimed scalar.Digest) error {\n207|\tcalculated, err := clonebundle.OmitSelfDigest(members, selfField)\n208|\tif err != nil {\n209|\t\treturn err\n210|\t}\n211|\tif calculated != claimed {\n212|\t\treturn invalid(\"%s claim %q does not match omit-self digest %q\", selfField, claimed.String(), calculated.String())\n213|\t}\n214|\treturn nil\n215|}\n216|\n217|// checkSortedUniqueBoundedStrings reports whether the\n218|// caller-supplied Build input is sorted unique bounded strings in\n219|// the count bound. It mirrors the decode string-array gate for Go\n220|// inputs: UTF-8 first (so nothing seals rewritten), then character\n221|// bounds, then strict order.\n222|func checkSortedUniqueBoundedStrings(values []string, minimumLength, maximumLength int, minimumCount, maximumCount int, owner, member string) ([]string, error) {\n223|\tif len(values) < minimumCount || len(values) > maximumCount {\n224|\t\treturn nil, invalid(\"%s %s carries %d items, want [%d..%d]\", owner, member, len(values), minimumCount, maximumCount)\n225|\t}\n226|\tfor index, value := range values {\n227|\t\tif !validText(value) {\n228|\t\t\treturn nil, invalid(\"%s %s[%d] is not valid UTF-8\", owner, member, index)\n229|\t\t}\n230|\t\tif length := stringLength(value); length < minimumLength || length > maximumLength {\n231|\t\t\treturn nil, invalid(\"%s %s[%d] is not a string[%d..%d]\", owner, member, index, minimumLength, maximumLength)\n232|\t\t}\n233|\t\tif index > 0 && value <= values[index-1] {\n234|\t\t\treturn nil, invalid(\"%s %s are not sorted unique\", owner, member)\n235|\t\t}\n236|\t}\n237|\treturn append([]string(nil), values...), nil\n238|}\n239|\n240|// stringValues renders strings for the sealed object.\n241|func stringValues(values []string) []any {\n242|\trendered := make([]any, 0, len(values))\n243|\tfor _, value := range values {\n244|\t\trendered = append(rendered, value)\n245|\t}\n246|\treturn rendered\n247|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7a3","stream":{"kind":"session","id":"01a0d536-7d14-7863-b4a5-d6cfb7bdb4fc"},"sequence":556,"recorded_at":1780531400001107,"record_type":"event","durability":"durable","causation_id":"f8f39da6-44fd-4b55-a795-0893d87482b7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f8f39da6-44fd-4b55-a795-0893d87482b7","run_stream":{"kind":"run","id":"f8f39da6-44fd-4b55-a795-0893d87482b7"},"call_id":"call_01a0d538d9337128a8aa5d1e32c39a63","text":"Read text file `internal/clonereadback/sealed_test.go`.\n1|package clonereadback_test\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"reflect\"\n10|\t\"sort\"\n11|\t\"strings\"\n12|\t\"testing\"\n13|\n14|\tclonereadback \"github.com/relux-works/agent-session-manager/internal/clonereadback\"\n15|)\n16|\n17|// This file pins the sealed-sibling invariant (SPEC v0.7.0\n18|// §13.14.2 lines 10753-10763: the validation report aggregates\n19|// TWO DISTINCT validated staged and live read-back manifests): a\n20|// report entry cannot vouch for a sibling from a caller-minted\n21|// struct that merely repeats an ID and a mode label. The report\n22|// entries accept ONLY ValidatedReadBack — minted by the\n23|// read-back validator, unforgeable outside the package — and\n24|// refuse the zero value at both entries before any claim\n25|// comparison. A validated sibling from another plan admits here:\n26|// plan pairing is cross-input reconciliation and belongs to the\n27|// final leaf (see TestReportTupleMatchIsReconciliationBound).\n28|\n29|// unsealedPairs enumerates the sibling seal relation at one\n30|// report entry: both zero, staged zero, live zero. Every cell\n31|// refuses with the seal literal.\n32|func unsealedPairs() [][2]bool {\n33|\treturn [][2]bool{{false, false}, {false, true}, {true, false}}\n34|}\n35|\n36|// TestBuildReportRefusesUnsealedSiblings is the forged-sibling\n37|// regression at the Build entry: the zero ValidatedReadBack is\n38|// the only sibling value a caller can mint without the\n39|// validator, and every pair carrying one refuses with the seal\n40|// literal — the entry never reads the inner ID or mode of an\n41|// unsealed sibling.\n42|func TestBuildReportRefusesUnsealedSiblings(t *testing.T) {\n43|\tstaged, live := mustReadPair(t)\n44|\tvar zero clonereadback.ValidatedReadBack\n45|\tsealed := map[bool]clonereadback.ValidatedReadBack{true: staged, false: zero}\n46|\tliveSealed := map[bool]clonereadback.ValidatedReadBack{true: live, false: zero}\n47|\tfor _, pair := range unsealedPairs() {\n48|\t\tinput := validReportInput(staged, live)\n49|\t\t_, err := clonereadback.BuildValidationReport(input, sealed[pair[0]], liveSealed[pair[1]])\n50|\t\tif err == nil {\n51|\t\t\tt.Fatalf(\"Build admitted unsealed pair staged=%v live=%v\", pair[0], pair[1])\n52|\t\t}\n53|\t\trequireRefusal(t, err, \"clone validation report\", \"read-back sibling is not a validated read\")\n54|\t}\n55|}\n56|\n57|// TestDecodeReportRefusesUnsealedSiblings is the forged-sibling\n58|// regression at the Decode entry: the sealed document is valid,\n59|// yet every pair carrying a zero sibling refuses with the seal\n60|// literal — the seal gate fires before any document member is\n61|// read.\n62|func TestDecodeReportRefusesUnsealedSiblings(t *testing.T) {\n63|\tstaged, live := mustReadPair(t)\n64|\tsealed := mustBuildReport(t, validReportInput(staged, live), staged, live)\n65|\tvar zero clonereadback.ValidatedReadBack\n66|\tfirst := map[bool]clonereadback.ValidatedReadBack{true: staged, false: zero}\n67|\tsecond := map[bool]clonereadback.ValidatedReadBack{true: live, false: zero}\n68|\tfor _, pair := range unsealedPairs() {\n69|\t\t_, err := clonereadback.DecodeValidationReport(sealed, first[pair[0]], second[pair[1]])\n70|\t\tif err == nil {\n71|\t\t\tt.Fatalf(\"Decode admitted unsealed pair staged=%v live=%v\", pair[0], pair[1])\n72|\t\t}\n73|\t\trequireRefusal(t, err, \"clone validation report\", \"read-back sibling is not a validated read\")\n74|\t}\n75|}\n76|\n77|// mustOtherPlanStaged seals and decodes one staged read bound to\n78|// a different projection plan: a genuinely validated sibling\n79|// from another operation.\n80|func mustOtherPlanStaged(t *testing.T) clonereadback.ValidatedReadBack {\n81|\tt.Helper()\n82|\tinput := validReadBackInput()\n83|\tinput.ProjectionPlanID = fixtureDigest(\"other-plan\")\n84|\tother := mustDecodeReadBack(t, stagedAuthority(t), mustBuildReadBack(t, stagedAuthority(t), input))\n85|\tif other.Manifest().ProjectionPlanID.String() == fixtureDigest(\"plan\") {\n86|\t\tt.Fatal(\"other-plan sibling carries the report plan: the probe is not cross-plan\")\n87|\t}\n88|\tif other.Mode() != \"staged\" {\n89|\t\tt.Fatalf(\"other-plan sibling mode = %q, want staged\", other.Mode())\n90|\t}\n91|\treturn other\n92|}\n93|\n94|// TestBuildReportSiblingFromAnotherPlanIsBound pins the\n95|// sibling-scope bound at the Build entry: a validated staged\n96|// sibling from another plan admits here — the seal, slot, and\n97|// reference bindings hold — because plan pairing across shapes\n98|// needs the wider reconciliation inputs and belongs to the final\n99|// leaf. The probe fails if the sibling ever shares the report\n100|// plan, so the admission pins the bound, not a same-plan seal.\n101|func TestBuildReportSiblingFromAnotherPlanIsBound(t *testing.T) {\n102|\t_, live := mustReadPair(t)\n103|\tother := mustOtherPlanStaged(t)\n104|\tinput := validReportInput(other, live)\n105|\tif input.ProjectionPlanID == other.Manifest().ProjectionPlanID.String() {\n106|\t\tt.Fatal(\"report plan equals the sibling plan: the probe is not cross-plan\")\n107|\t}\n108|\tmustBuildReport(t, input, other, live)\n109|}\n110|\n111|// TestDecodeReportSiblingFromAnotherPlanIsBound pins the\n112|// sibling-scope bound at the Decode entry: the report sealed\n113|// over a validated other-plan staged sibling decodes with that\n114|// sibling — plan pairing stays reconciliation scope.\n115|func TestDecodeReportSiblingFromAnotherPlanIsBound(t *testing.T) {\n116|\t_, live := mustReadPair(t)\n117|\tother := mustOtherPlanStaged(t)\n118|\tsealed := mustBuildReport(t, validReportInput(other, live), other, live)\n119|\tmustDecodeReport(t, sealed, other, live)\n120|}\n121|\n122|// siblingBareType reports whether one parameter type spelling is\n123|// a caller-mintable sibling: the exported ReadBackManifest\n124|// value/pointer or a bare scalar digest value/pointer.\n125|func siblingBareType(expr ast.Expr) bool {\n126|\tif star, ok := expr.(*ast.StarExpr); ok {\n127|\t\texpr = star.X\n128|\t}\n129|\tif ident, ok := expr.(*ast.Ident); ok {\n130|\t\treturn ident.Name == \"ReadBackManifest\"\n131|\t}\n132|\tselector, ok := expr.(*ast.SelectorExpr)\n133|\tif !ok {\n134|\t\treturn false\n135|\t}\n136|\tpkg, ok := selector.X.(*ast.Ident)\n137|\treturn ok && pkg.Name == \"scalar\" && selector.Sel.Name == \"Digest\"\n138|}\n139|\n140|// TestReportEntriesTakeOnlySealedSiblings pins that no exported\n141|// entry takes a caller-mintable sibling: neither the exported\n142|// ReadBackManifest value/pointer nor a bare digest\n143|// value/pointer appears in any exported parameter list —\n144|// functions or methods. The report entries take ONLY\n145|// ValidatedReadBack. The P-seal-param-* harness rows plant one\n146|// violation each and must redden this test.\n147|func TestReportEntriesTakeOnlySealedSiblings(t *testing.T) {\n148|\tdir := packageDir(t)\n149|\tfiles, err := filepath.Glob(filepath.Join(dir, \"*.go\"))\n150|\tif err != nil {\n151|\t\tt.Fatalf(\"glob: %v\", err)\n152|\t}\n153|\tvar violations []string\n154|\tfor _, path := range files {\n155|\t\tif strings.HasSuffix(path, \"_test.go\") {\n156|\t\t\tcontinue\n157|\t\t}\n158|\t\tsource, err := os.ReadFile(path)\n159|\t\tif err != nil {\n160|\t\t\tt.Fatalf(\"read %s: %v\", path, err)\n161|\t\t}\n162|\t\tfset := token.NewFileSet()\n163|\t\tparsed, err := parser.ParseFile(fset, path, source, 0)\n164|\t\tif err != nil {\n165|\t\t\tt.Fatalf(\"parse %s: %v\", path, err)\n166|\t\t}\n167|\t\tfor _, decl := range parsed.Decls {\n168|\t\t\tfn, ok := decl.(*ast.FuncDecl)\n169|\t\t\tif !ok || !ast.IsExported(fn.Name.Name) {\n170|\t\t\t\tcontinue\n171|\t\t\t}\n172|\t\t\tif fn.Type.Params == nil {\n173|\t\t\t\tcontinue\n174|\t\t\t}\n175|\t\t\tfor _, field := range fn.Type.Params.List {\n176|\t\t\t\tif siblingBareType(field.Type) {\n177|\t\t\t\t\tviolations = append(violations, fn.Name.Name)\n178|\t\t\t\t\tbreak\n179|\t\t\t\t}\n180|\t\t\t}\n181|\t\t}\n182|\t}\n183|\tsort.Strings(violations)\n184|\tif len(violations) != 0 {\n185|\t\tt.Fatalf(\"exported entries taking a caller-mintable sibling = %v, want none: report siblings must be ValidatedReadBack\", violations)\n186|\t}\n187|}\n188|\n189|// sealedResultType reports whether one result type spelling is a\n190|// sealed read: ValidatedReadBack by value or pointer.\n191|func sealedResultType(expr ast.Expr) bool {\n192|\tif star, ok := expr.(*ast.StarExpr); ok {\n193|\t\texpr = star.X\n194|\t}\n195|\tident, ok := expr.(*ast.Ident)\n196|\treturn ok && ident.Name == \"ValidatedReadBack\"\n197|}\n198|\n199|// TestValidatedReadBackSealedConstruction pins that the seal is\n200|// unforgeable outside the package: the type carries no exported\n201|// field, the only exported constructors are the two read-back\n202|// validator entries, and the zero value refuses at both report\n203|// entries. The P-seal-ctor harness row plants a third\n204|// constructor and the P-seal-exported-field row plants an\n205|// exported field; both must redden this test.\n206|func TestValidatedReadBackSealedConstruction(t *testing.T) {\n207|\tsealed := reflect.TypeOf(clonereadback.ValidatedReadBack{})\n208|\tif sealed.NumField() == 0 {\n209|\t\tt.Fatal(\"ValidatedReadBack has no fields: the seal carries nothing\")\n210|\t}\n211|\tfor i := 0; i < sealed.NumField(); i++ {\n212|\t\tfield := sealed.Field(i)\n213|\t\tif field.PkgPath == \"\" {\n214|\t\t\tt.Errorf(\"ValidatedReadBack.%s is exported: callers can forge the seal field by field\", field.Name)\n215|\t\t}\n216|\t}\n217|\tdir := packageDir(t)\n218|\tfiles, err := filepath.Glob(filepath.Join(dir, \"*.go\"))\n219|\tif err != nil {\n220|\t\tt.Fatalf(\"glob: %v\", err)\n221|\t}\n222|\twant := map[string]bool{\n223|\t\t\"BuildReadBackEvidenceManifest\": true, \"DecodeReadBackEvidenceManifest\": true,\n224|\t}\n225|\tvar found []string\n226|\tfor _, path := range files {\n227|\t\tif strings.HasSuffix(path, \"_test.go\") {\n228|\t\t\tcontinue\n229|\t\t}\n230|\t\tsource, err := os.ReadFile(path)\n231|\t\tif err != nil {\n232|\t\t\tt.Fatalf(\"read %s: %v\", path, err)\n233|\t\t}\n234|\t\tfset := token.NewFileSet()\n235|\t\tparsed, err := parser.ParseFile(fset, path, source, 0)\n236|\t\tif err != nil {\n237|\t\t\tt.Fatalf(\"parse %s: %v\", path, err)\n238|\t\t}\n239|\t\tfor _, decl := range parsed.Decls {\n240|\t\t\tfn, ok := decl.(*ast.FuncDecl)\n241|\t\t\tif !ok || !ast.IsExported(fn.Name.Name) {\n242|\t\t\t\tcontinue\n243|\t\t\t}\n244|\t\t\tif fn.Type.Results == nil {\n245|\t\t\t\tcontinue\n246|\t\t\t}\n247|\t\t\tmints := false\n248|\t\t\tfor _, field := range fn.Type.Results.List {\n249|\t\t\t\tif sealedResultType(field.Type) {\n250|\t\t\t\t\tmints = true\n251|\t\t\t\t\tbreak\n252|\t\t\t\t}\n253|\t\t\t}\n254|\t\t\tif mints {\n255|\t\t\t\tfound = append(found, fn.Name.Name)\n256|\t\t\t}\n257|\t\t}\n258|\t}\n259|\tsort.Strings(found)\n260|\tif len(found) != len(want) {\n261|\t\tt.Fatalf(\"seal constructors = %v, want the two read-back entries: no third mint, no missing mint\", found)\n262|\t}\n263|\tfor _, name := range found {\n264|\t\tif !want[name] {\n265|\t\t\tt.Fatalf(\"seal constructors = %v, want the two read-back entries: %s mints outside the validator\", found, name)\n266|\t\t}\n267|\t}\n268|\t// The zero value is the only caller-mintable seal and both\n269|\t// report entries refuse it (the full unsealed grid rides the\n270|\t// dedicated per-entry regressions above).\n271|\tstaged, live := mustReadPair(t)\n272|\tvar zero clonereadback.ValidatedReadBack\n273|\t_, err = clonereadback.BuildValidationReport(validReportInput(staged, live), zero, zero)\n274|\trequireRefusal(t, err, \"clone validation report\", \"read-back sibling is not a validated read\")\n275|\tsealedDoc := mustBuildReport(t, validReportInput(staged, live), staged, live)\n276|\t_, err = clonereadback.DecodeValidationReport(sealedDoc, zero, zero)\n277|\trequireRefusal(t, err, \"clone validation report\", \"read-back sibling is not a validated read\")\n278|}\n279|\n280|// TestNoGeneratedBytecode pins that no generated Python bytecode\n281|// rides the package: the mutant harness must run with bytecode\n282|// writing disabled (python3 -B), so a __pycache__ blob can never\n283|// join the candidate again.\n284|func TestNoGeneratedBytecode(t *testing.T) {\n285|\tdir := packageDir(t)\n286|\tvar offenders []string\n287|\terr := filepath.Walk(dir, func(path string, info os.FileInfo, err error) error {\n288|\t\tif err != nil {\n289|\t\t\treturn err\n290|\t\t}\n291|\t\tif info.IsDir() {\n292|\t\t\tif info.Name() == \"__pycache__\" {\n293|\t\t\t\toffenders = append(offenders, path)\n294|\t\t\t}\n295|\t\t\treturn nil\n296|\t\t}\n297|\t\tif strings.HasSuffix(info.Name(), \".pyc\") {\n298|\t\t\toffenders = append(offenders, path)\n299|\t\t}\n300|\t\treturn nil\n301|\t})\n302|\tif err != nil {\n303|\t\tt.Fatalf(\"walk: %v\", err)\n304|\t}\n305|\tsort.Strings(offenders)\n306|\tif len(offenders) != 0 {\n307|\t\tt.Fatalf(\"generated bytecode present = %v: run the harness with python3 -B and remove it\", offenders)\n308|\t}\n309|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
