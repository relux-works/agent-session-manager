{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c765","stream":{"kind":"session","id":"01a0d536-7d14-7863-b4a5-d6cfb7bdb4fc"},"sequence":525,"recorded_at":1780531400001045,"record_type":"event","durability":"durable","causation_id":"f8f39da6-44fd-4b55-a795-0893d87482b7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f8f39da6-44fd-4b55-a795-0893d87482b7","run_stream":{"kind":"run","id":"f8f39da6-44fd-4b55-a795-0893d87482b7"},"call_id":"call_01a0d538c22676c7a9968afbe566b9a1","text":"Read text file `internal/clonereadback/readback.go`.\n(499 line(s) above)\n500|\tif !ok {\n501|\t\treturn ValidatedReadBack{}, invalid(\"%s evidence_objects are not an array\", owner)\n502|\t}\n503|\tif err := checkEvidenceCount(len(rawRows)); err != nil {\n504|\t\treturn ValidatedReadBack{}, err\n505|\t}\n506|\trows := make([]EvidenceObject, 0, len(rawRows))\n507|\tfor index, raw := range rawRows {\n508|\t\trow, err := decodeEvidenceObject(raw, index)\n509|\t\tif err != nil {\n510|\t\t\treturn ValidatedReadBack{}, err\n511|\t\t}\n512|\t\trows = append(rows, row)\n513|\t}\n514|\tif err := checkEvidenceOrder(rows); err != nil {\n515|\t\treturn ValidatedReadBack{}, err\n516|\t}\n517|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n518|\t\treturn ValidatedReadBack{}, invalid(\"%s extensions %s\", owner, extensionsFault)\n519|\t}\n520|\tif err := verifySelfDigest(members, readBackSelf, claimed); err != nil {\n521|\t\treturn ValidatedReadBack{}, err\n522|\t}\n523|\treturn sealReadBack(ReadBackManifest{\n524|\t\tManifestID:                  claimed,\n525|\t\tOperationID:                 operation,\n526|\t\tMode:                        mode,\n527|\t\tProjectionPlanID:            planID,\n528|\t\tProjectedObjectManifestID:   projectedID,\n529|\t\tExpectedTargetNativeSession: expected,\n530|\t\tObservedTargetNativeSession: observed,\n531|\t\tObservedEnvironment:         observedTuple,\n532|\t\tParsedEventCount:            parsedCount,\n533|\t\tParsedHeadIDs:               heads,\n534|\t\tWorkspaceBinding:            binding,\n535|\t\tStructuralDigest:            structural,\n536|\t\tEvidenceObjects:             rows,\n537|\t}), nil\n538|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c767","stream":{"kind":"session","id":"01a0d536-7d14-7863-b4a5-d6cfb7bdb4fc"},"sequence":526,"recorded_at":1780531400001047,"record_type":"event","durability":"durable","causation_id":"f8f39da6-44fd-4b55-a795-0893d87482b7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f8f39da6-44fd-4b55-a795-0893d87482b7","run_stream":{"kind":"run","id":"f8f39da6-44fd-4b55-a795-0893d87482b7"},"call_id":"call_01a0d538c424749cabda1fd196c03d81","text":"Read text file `internal/clonereadback/report.go`.\n1|package clonereadback\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n9|)\n10|\n11|// This file validates and constructs Clone Validation Report\n12|// 1.0.0: the closed 22-member report Section 13.14.2 states,\n13|// aggregating both read-back manifests, the seven check booleans,\n14|// the Fidelity Report reference, findings, and the valid result.\n15|// The report carries the two validated reads as trusted siblings:\n16|// the staged and live references must name those reads in their\n17|// own slots, so the same digest in both slots, a swapped pair, or\n18|// a twice-named read refuses. Valid is decided, never carried:\n19|// valid=true if and only if every check boolean is true, the\n20|// native Session IDs match, and no finding carries error severity.\n21|// The report tuple cross-match against the read manifests'\n22|// observed tuples belongs to the final reconciliation leaf.\n23|\n24|const (\n25|\tvalidationSchema  = \"urn:ax:schema:clone-validation-report\"\n26|\tvalidationVersion = \"1.0.0\"\n27|\tvalidationSelf    = \"validation_report_id\"\n28|\tmaxReportFindings = 4096\n29|)\n30|\n31|var validationMembers = map[string]bool{\n32|\t\"schema\": true, \"schema_version\": true,\n33|\t\"validation_report_id\": true, \"operation_id\": true,\n34|\t\"projection_plan_id\":                    true,\n35|\t\"projected_object_manifest_id\":          true,\n36|\t\"staged_read_back_evidence_manifest_id\": true,\n37|\t\"live_read_back_evidence_manifest_id\":   true,\n38|\t\"target_provider_manifest_id\":           true,\n39|\t\"fidelity_report_id\":                    true,\n40|\t\"expected_target_native_session_id\":     true,\n41|\t\"observed_target_native_session_id\":     true,\n42|\t\"target_environment\":                    true,\n43|\t\"staged_structural_valid\":               true,\n44|\t\"live_structural_valid\":                 true,\n45|\t\"semantic_marker_valid\":                 true,\n46|\t\"identity_valid\":                        true,\n47|\t\"workspace_binding_valid\":               true,\n48|\t\"resume_surface_valid\":                  true,\n49|\t\"source_generation_revalidated\":         true,\n50|\t\"findings\":                              true,\n51|\t\"valid\":                                 true, \"extensions\": true,\n52|}\n53|\n54|var validationRequired = []string{\n55|\t\"schema\", \"schema_version\",\n56|\t\"validation_report_id\", \"operation_id\",\n57|\t\"projection_plan_id\",\n58|\t\"projected_object_manifest_id\",\n59|\t\"staged_read_back_evidence_manifest_id\",\n60|\t\"live_read_back_evidence_manifest_id\",\n61|\t\"target_provider_manifest_id\",\n62|\t\"fidelity_report_id\",\n63|\t\"expected_target_native_session_id\",\n64|\t\"observed_target_native_session_id\",\n65|\t\"target_environment\",\n66|\t\"staged_structural_valid\",\n67|\t\"live_structural_valid\",\n68|\t\"semantic_marker_valid\",\n69|\t\"identity_valid\",\n70|\t\"workspace_binding_valid\",\n71|\t\"resume_surface_valid\",\n72|\t\"source_generation_revalidated\",\n73|\t\"findings\",\n74|\t\"valid\", \"extensions\",\n75|}\n76|\n77|// ValidationChecks carries the seven check booleans the valid rule\n78|// conjoins. Every check is always applicable in this schema: unlike\n79|// the adapter validate body, the report has no nullable checks, so\n80|// the oracle enumerates outcomes over all seven with applicability\n81|// fixed.\n82|type ValidationChecks struct {\n83|\tStagedStructuralValid       bool\n84|\tLiveStructuralValid         bool\n85|\tSemanticMarkerValid         bool\n86|\tIdentityValid               bool\n87|\tWorkspaceBindingValid       bool\n88|\tResumeSurfaceValid          bool\n89|\tSourceGenerationRevalidated bool\n90|}\n91|\n92|// ValidationReport is one validated Clone Validation Report 1.0.0.\n93|type ValidationReport struct {\n94|\tReportID                    scalar.Digest\n95|\tOperationID                 scalar.UUIDv7\n96|\tProjectionPlanID            scalar.Digest\n97|\tProjectedObjectManifestID   scalar.Digest\n98|\tStagedManifestID            scalar.Digest\n99|\tLiveManifestID              scalar.Digest\n100|\tProviderManifestID          scalar.Digest\n101|\tFidelityReportID            scalar.Digest\n102|\tExpectedTargetNativeSession string\n103|\tObservedTargetNativeSession string\n104|\tTargetEnvironment           sessadapter.Tuple\n105|\tChecks                      ValidationChecks\n106|\tFindings                    []sessadapter.Finding\n107|\tValid                       bool\n108|}\n109|\n110|// ValidationReportInput is the caller-supplied validation report\n111|// candidate for Build. Nested closed shapes (target tuple,\n112|// findings) arrive as raw JSON and decode through their owners;\n113|// extensions arrive as a Go map and seal through the\n114|// closed-extensions owner.\n115|type ValidationReportInput struct {\n116|\tOperationID                      string\n117|\tProjectionPlanID                 string\n118|\tProjectedObjectManifestID        string\n119|\tStagedReadBackEvidenceManifestID string\n120|\tLiveReadBackEvidenceManifestID   string\n121|\tTargetProviderManifestID         string\n122|\tFidelityReportID                 string\n123|\tExpectedTargetNativeSession      string\n124|\tObservedTargetNativeSession      string\n125|\tTargetEnvironment                []byte\n126|\tStagedStructuralValid            bool\n127|\tLiveStructuralValid              bool\n128|\tSemanticMarkerValid              bool\n129|\tIdentityValid                    bool\n130|\tWorkspaceBindingValid            bool\n131|\tResumeSurfaceValid               bool\n132|\tSourceGenerationRevalidated      bool\n133|\tFindings                         []byte\n134|\tValid                            bool\n135|\tExtensions                       map[string]any\n136|}\n137|\n138|// decideValid computes the pinned valid rule: every check boolean\n139|// true, matching native IDs, and no error-severity finding. Both\n140|// entries share this single decider, so the rule cannot drift\n141|// between Build and Decode.\n142|func decideValid(checks ValidationChecks, expected, observed string, findings []sessadapter.Finding) bool {\n143|\tif !checks.StagedStructuralValid {\n144|\t\treturn false\n145|\t}\n146|\tif !checks.LiveStructuralValid {\n147|\t\treturn false\n148|\t}\n149|\tif !checks.SemanticMarkerValid {\n150|\t\treturn false\n151|\t}\n152|\tif !checks.IdentityValid {\n153|\t\treturn false\n154|\t}\n155|\tif !checks.WorkspaceBindingValid {\n156|\t\treturn false\n157|\t}\n158|\tif !checks.ResumeSurfaceValid {\n159|\t\treturn false\n160|\t}\n161|\tif !checks.SourceGenerationRevalidated {\n162|\t\treturn false\n163|\t}\n164|\tif expected != observed {\n165|\t\treturn false\n166|\t}\n167|\tfor _, finding := range findings {\n168|\t\tif finding.Severity == \"error\" {\n169|\t\t\treturn false\n170|\t\t}\n171|\t}\n172|\treturn true\n173|}\n174|\n175|// checkValidAgreement enforces that the carried valid bit equals the\n176|// decided rule: a report claiming valid=true with a failed check is\n177|// refused, and a report claiming valid=false with every check\n178|// passing is refused. Both entries share this gate.\n179|func checkValidAgreement(owner string, claimed bool, checks ValidationChecks, expected, observed string, findings []sessadapter.Finding) error {\n180|\tif claimed != decideValid(checks, expected, observed, findings) {\n181|\t\treturn invalid(\"%s valid disagrees with the check outcome\", owner)\n182|\t}\n183|\treturn nil\n184|}\n185|\n186|// checkSiblingsSealed enforces that both aggregated reads are\n187|// sealed: each sibling must come from the read-back validator,\n188|// never from a caller-minted value. The zero value seals nothing\n189|// and refuses here, before any claim comparison reads its\n190|// fields. Both report entries call this gate first.\n191|func checkSiblingsSealed(owner string, staged, live ValidatedReadBack) error {\n192|\tif !staged.sealed || !live.sealed {\n193|\t\treturn invalid(\"%s read-back sibling is not a validated read\", owner)\n194|\t}\n195|\treturn nil\n196|}\n197|\n198|// checkReadRefs enforces that the report aggregates TWO distinct\n199|// sealed reads: the staged sibling is a staged manifest, the live\n200|// sibling is a live manifest, the two reads are distinct\n201|// documents, and the carried references name those reads in their\n202|// own slots. An equal pair, a swapped pair, or a mismatched\n203|// reference refuses. Both report entries share this gate; the\n204|// seal gate above runs first at each entry.\n205|func checkReadRefs(owner string, stagedClaim, liveClaim scalar.Digest, staged, live ValidatedReadBack) error {\n206|\tif staged.read.ManifestID == live.read.ManifestID {\n207|\t\treturn invalid(\"%s staged and live read-back references are not distinct\", owner)\n208|\t}\n209|\tif staged.read.Mode != \"staged\" {\n210|\t\treturn invalid(\"%s staged read is not a staged manifest\", owner)\n211|\t}\n212|\tif live.read.Mode != \"live\" {\n213|\t\treturn invalid(\"%s live read is not a live manifest\", owner)\n214|\t}\n215|\tif stagedClaim != staged.read.ManifestID {\n216|\t\treturn invalid(\"%s staged_read_back_evidence_manifest_id does not match the staged read\", owner)\n217|\t}\n218|\tif liveClaim != live.read.ManifestID {\n219|\t\treturn invalid(\"%s live_read_back_evidence_manifest_id does not match the live read\", owner)\n220|\t}\n221|\treturn nil\n222|}\n223|\n224|// BuildValidationReport constructs one closed Clone Validation\n225|// Report 1.0.0 as canonical bytes. Identical inputs produce\n226|// byte-identical outputs. The staged and live siblings are the\n227|// sealed reads the report aggregates: each must come from the\n228|// read-back validator, and the carried references must name them\n229|// in their own slots. Every closed-shape, scalar, finding, and\n230|// validity rule is a refusal, never a repair.\n231|func BuildValidationReport(input ValidationReportInput, staged ValidatedReadBack, live ValidatedReadBack) ([]byte, error) {\n232|\t_, object, err := buildValidationReport(input, staged, live)\n233|\tif err != nil {\n234|\t\treturn nil, err\n235|\t}\n236|\tomitted, err := canonicalizeObject(object)\n237|\tif err != nil {\n238|\t\treturn nil, err\n239|\t}\n240|\treportID := scalar.SHA256Digest(omitted)\n241|\tobject[validationSelf] = reportID.String()\n242|\treturn canonicalizeObject(object)\n243|}\n244|\n245|func buildValidationReport(input ValidationReportInput, staged ValidatedReadBack, live ValidatedReadBack) (ValidationReport, map[string]any, error) {\n246|\towner := \"clone validation report\"\n247|\tif err := checkSiblingsSealed(owner, staged, live); err != nil {\n248|\t\treturn ValidationReport{}, nil, err\n249|\t}\n250|\toperation, err := scalar.ParseUUIDv7(input.OperationID)\n251|\tif err != nil {\n252|\t\treturn ValidationReport{}, nil, invalid(\"%s operation_id is not a UUIDv7: %v\", owner, err)\n253|\t}\n254|\tplanID, err := scalar.ParseDigest(input.ProjectionPlanID)\n255|\tif err != nil {\n256|\t\treturn ValidationReport{}, nil, invalid(\"%s projection_plan_id is not a digest: %v\", owner, err)\n257|\t}\n258|\tprojectedID, err := scalar.ParseDigest(input.ProjectedObjectManifestID)\n259|\tif err != nil {\n260|\t\treturn ValidationReport{}, nil, invalid(\"%s projected_object_manifest_id is not a digest: %v\", owner, err)\n261|\t}\n262|\tstagedID, err := scalar.ParseDigest(input.StagedReadBackEvidenceManifestID)\n263|\tif err != nil {\n264|\t\treturn ValidationReport{}, nil, invalid(\"%s staged_read_back_evidence_manifest_id is not a digest: %v\", owner, err)\n265|\t}\n266|\tliveID, err := scalar.ParseDigest(input.LiveReadBackEvidenceManifestID)\n267|\tif err != nil {\n268|\t\treturn ValidationReport{}, nil, invalid(\"%s live_read_back_evidence_manifest_id is not a digest: %v\", owner, err)\n269|\t}\n270|\tif err := checkReadRefs(owner, stagedID, liveID, staged, live); err != nil {\n271|\t\treturn ValidationReport{}, nil, err\n272|\t}\n273|\tproviderID, err := scalar.ParseDigest(input.TargetProviderManifestID)\n274|\tif err != nil {\n275|\t\treturn ValidationReport{}, nil, invalid(\"%s target_provider_manifest_id is not a digest: %v\", owner, err)\n276|\t}\n277|\tfidelityID, err := scalar.ParseDigest(input.FidelityReportID)\n278|\tif err != nil {\n279|\t\treturn ValidationReport{}, nil, invalid(\"%s fidelity_report_id is not a digest: %v\", owner, err)\n280|\t}\n281|\tif !validText(input.ExpectedTargetNativeSession) {\n282|\t\treturn ValidationReport{}, nil, invalid(\"%s expected_target_native_session_id is not valid UTF-8\", owner)\n283|\t}\n284|\tif length := stringLength(input.ExpectedTargetNativeSession); length < 1 || length > 512 {\n285|\t\treturn ValidationReport{}, nil, invalid(\"%s expected_target_native_session_id is not a string[1..512]\", owner)\n286|\t}\n287|\tif !validText(input.ObservedTargetNativeSession) {\n288|\t\treturn ValidationReport{}, nil, invalid(\"%s observed_target_native_session_id is not valid UTF-8\", owner)\n289|\t}\n290|\tif length := stringLength(input.ObservedTargetNativeSession); length < 1 || length > 512 {\n291|\t\treturn ValidationReport{}, nil, invalid(\"%s observed_target_native_session_id is not a string[1..512]\", owner)\n292|\t}\n293|\ttargetTuple, err := sessadapter.DecodeTuple(json.RawMessage(input.TargetEnvironment))\n294|\tif err != nil {\n295|\t\treturn ValidationReport{}, nil, invalid(\"%s target_environment is not an Environment Tuple: %v\", owner, err)\n296|\t}\n297|\tchecks := ValidationChecks{\n298|\t\tStagedStructuralValid:       input.StagedStructuralValid,\n299|\t\tLiveStructuralValid:         input.LiveStructuralValid,\n300|\t\tSemanticMarkerValid:         input.SemanticMarkerValid,\n301|\t\tIdentityValid:               input.IdentityValid,\n302|\t\tWorkspaceBindingValid:       input.WorkspaceBindingValid,\n303|\t\tResumeSurfaceValid:          input.ResumeSurfaceValid,\n304|\t\tSourceGenerationRevalidated: input.SourceGenerationRevalidated,\n305|\t}\n306|\tfindings, err := sessadapter.DecodeFindings(json.RawMessage(input.Findings), maxReportFindings)\n307|\tif err != nil {\n308|\t\treturn ValidationReport{}, nil, invalid(\"%s findings are not AdapterFinding[0..4096]: %v\", owner, err)\n309|\t}\n310|\tif err := checkValidAgreement(owner, input.Valid, checks, input.ExpectedTargetNativeSession, input.ObservedTargetNativeSession, findings); err != nil {\n311|\t\treturn ValidationReport{}, nil, err\n312|\t}\n313|\textensions, err := clonebundle.EncodeExtensions(input.Extensions)\n314|\tif err != nil {\n315|\t\treturn ValidationReport{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n316|\t}\n317|\tvar extensionsValue any\n318|\tif err := json.Unmarshal(extensions, &extensionsValue); err != nil {\n319|\t\treturn ValidationReport{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n320|\t}\n321|\treport := ValidationReport{\n322|\t\tOperationID:                 operation,\n323|\t\tProjectionPlanID:            planID,\n324|\t\tProjectedObjectManifestID:   projectedID,\n325|\t\tStagedManifestID:            stagedID,\n326|\t\tLiveManifestID:              liveID,\n327|\t\tProviderManifestID:          providerID,\n328|\t\tFidelityReportID:            fidelityID,\n329|\t\tExpectedTargetNativeSession: input.ExpectedTargetNativeSession,\n330|\t\tObservedTargetNativeSession: input.ObservedTargetNativeSession,\n331|\t\tTargetEnvironment:           targetTuple,\n332|\t\tChecks:                      checks,\n333|\t\tFindings:                    findings,\n334|\t\tValid:                       input.Valid,\n335|\t}\n336|\tobject := map[string]any{\n337|\t\t\"schema\":                                validationSchema,\n338|\t\t\"schema_version\":                        validationVersion,\n339|\t\t\"operation_id\":                          operation.String(),\n340|\t\t\"projection_plan_id\":                    planID.String(),\n341|\t\t\"projected_object_manifest_id\":          projectedID.String(),\n342|\t\t\"staged_read_back_evidence_manifest_id\": stagedID.String(),\n343|\t\t\"live_read_back_evidence_manifest_id\":   liveID.String(),\n344|\t\t\"target_provider_manifest_id\":           providerID.String(),\n345|\t\t\"fidelity_report_id\":                    fidelityID.String(),\n346|\t\t\"expected_target_native_session_id\":     input.ExpectedTargetNativeSession,\n347|\t\t\"observed_target_native_session_id\":     input.ObservedTargetNativeSession,\n348|\t\t\"staged_structural_valid\":               input.StagedStructuralValid,\n349|\t\t\"live_structural_valid\":                 input.LiveStructuralValid,\n350|\t\t\"semantic_marker_valid\":                 input.SemanticMarkerValid,\n351|\t\t\"identity_valid\":                        input.IdentityValid,\n352|\t\t\"workspace_binding_valid\":               input.WorkspaceBindingValid,\n353|\t\t\"resume_surface_valid\":                  input.ResumeSurfaceValid,\n354|\t\t\"source_generation_revalidated\":         input.SourceGenerationRevalidated,\n355|\t\t\"valid\":                                 input.Valid,\n356|\t\t\"extensions\":                            extensionsValue,\n357|\t}\n358|\tvar tupleValue any\n359|\tif err := json.Unmarshal(input.TargetEnvironment, &tupleValue); err != nil {\n360|\t\treturn ValidationReport{}, nil, invalid(\"%s target_environment invalid: %v\", owner, err)\n361|\t}\n362|\tobject[\"target_environment\"] = tupleValue\n363|\tvar findingsValue any\n364|\tif err := json.Unmarshal(input.Findings, &findingsValue); err != nil {\n365|\t\treturn ValidationReport{}, nil, invalid(\"%s findings invalid: %v\", owner, err)\n366|\t}\n367|\tobject[\"findings\"] = findingsValue\n368|\treturn report, object, nil\n369|}\n370|\n371|// DecodeValidationReport validates one closed Clone Validation\n372|// Report 1.0.0: sealed staged and live siblings, exact members,\n373|// literal schema/version, read references bound to the two\n374|// sibling reads, owner-decoded tuple and findings, the decided\n375|// valid bit, and the omit-self identity.\n376|func DecodeValidationReport(data []byte, staged ValidatedReadBack, live ValidatedReadBack) (ValidationReport, error) {\n377|\towner := \"clone validation report\"\n378|\tif err := checkSiblingsSealed(owner, staged, live); err != nil {\n379|\t\treturn ValidationReport{}, err\n380|\t}\n381|\tmembers, fault := decodeStrictObject(data)\n382|\tif fault != nil {\n383|\t\treturn ValidationReport{}, invalid(\"%s %s (%s)\", owner, fault.detail, memberField(fault.member))\n384|\t}\n385|\tif name, unknown := unknownMember(members, validationMembers); unknown {\n386|\t\treturn ValidationReport{}, invalid(\"%s carries unknown member %q\", owner, name)\n387|\t}\n388|\tif name, missing := missingMember(members, validationRequired); missing {\n389|\t\treturn ValidationReport{}, invalid(\"%s misses a required member %q\", owner, name)\n390|\t}\n391|\tschema, ok := rawString(members[\"schema\"])\n392|\tif !ok || schema != validationSchema {\n393|\t\treturn ValidationReport{}, invalid(\"%s schema is not urn:ax:schema:clone-validation-report\", owner)\n394|\t}\n395|\tversion, ok := rawString(members[\"schema_version\"])\n396|\tif !ok || version != validationVersion {\n397|\t\treturn ValidationReport{}, invalid(\"%s schema_version is not 1.0.0\", owner)\n398|\t}\n399|\tclaimed, ok := checkDigest(members[validationSelf])\n400|\tif !ok {\n401|\t\treturn ValidationReport{}, invalid(\"%s validation_report_id is not a digest\", owner)\n402|\t}\n403|\toperation, ok := checkUUIDv7(members[\"operation_id\"])\n404|\tif !ok {\n405|\t\treturn ValidationReport{}, invalid(\"%s operation_id is not a UUIDv7\", owner)\n406|\t}\n407|\tplanID, ok := checkDigest(members[\"projection_plan_id\"])\n408|\tif !ok {\n409|\t\treturn ValidationReport{}, invalid(\"%s projection_plan_id is not a digest\", owner)\n410|\t}\n411|\tprojectedID, ok := checkDigest(members[\"projected_object_manifest_id\"])\n412|\tif !ok {\n413|\t\treturn ValidationReport{}, invalid(\"%s projected_object_manifest_id is not a digest\", owner)\n414|\t}\n415|\tstagedID, ok := checkDigest(members[\"staged_read_back_evidence_manifest_id\"])\n416|\tif !ok {\n417|\t\treturn ValidationReport{}, invalid(\"%s staged_read_back_evidence_manifest_id is not a digest\", owner)\n418|\t}\n419|\tliveID, ok := checkDigest(members[\"live_read_back_evidence_manifest_id\"])\n420|\tif !ok {\n421|\t\treturn ValidationReport{}, invalid(\"%s live_read_back_evidence_manifest_id is not a digest\", owner)\n422|\t}\n423|\tif err := checkReadRefs(owner, stagedID, liveID, staged, live); err != nil {\n424|\t\treturn ValidationReport{}, err\n425|\t}\n426|\tproviderID, ok := checkDigest(members[\"target_provider_manifest_id\"])\n427|\tif !ok {\n428|\t\treturn ValidationReport{}, invalid(\"%s target_provider_manifest_id is not a digest\", owner)\n429|\t}\n430|\tfidelityID, ok := checkDigest(members[\"fidelity_report_id\"])\n431|\tif !ok {\n432|\t\treturn ValidationReport{}, invalid(\"%s fidelity_report_id is not a digest\", owner)\n433|\t}\n434|\texpected, ok := checkStringBounds(members[\"expected_target_native_session_id\"], 1, 512)\n435|\tif !ok {\n436|\t\treturn ValidationReport{}, invalid(\"%s expected_target_native_session_id is not a string[1..512]\", owner)\n437|\t}\n438|\tobserved, ok := checkStringBounds(members[\"observed_target_native_session_id\"], 1, 512)\n439|\tif !ok {\n440|\t\treturn ValidationReport{}, invalid(\"%s observed_target_native_session_id is not a string[1..512]\", owner)\n441|\t}\n442|\ttargetTuple, err := sessadapter.DecodeTuple(members[\"target_environment\"])\n443|\tif err != nil {\n444|\t\treturn ValidationReport{}, invalid(\"%s target_environment is not an Environment Tuple: %v\", owner, err)\n445|\t}\n446|\tchecks, err := decodeValidationChecks(members)\n447|\tif err != nil {\n448|\t\treturn ValidationReport{}, err\n449|\t}\n450|\tfindings, err := sessadapter.DecodeFindings(members[\"findings\"], maxReportFindings)\n451|\tif err != nil {\n452|\t\treturn ValidationReport{}, invalid(\"%s findings are not AdapterFinding[0..4096]: %v\", owner, err)\n453|\t}\n454|\tvalid, ok := rawBool(members[\"valid\"])\n455|\tif !ok {\n456|\t\treturn ValidationReport{}, invalid(\"%s valid is not a boolean\", owner)\n457|\t}\n458|\tif err := checkValidAgreement(owner, valid, checks, expected, observed, findings); err != nil {\n459|\t\treturn ValidationReport{}, err\n460|\t}\n461|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n462|\t\treturn ValidationReport{}, invalid(\"%s extensions %s\", owner, extensionsFault)\n463|\t}\n464|\tif err := verifySelfDigest(members, validationSelf, claimed); err != nil {\n465|\t\treturn ValidationReport{}, err\n466|\t}\n467|\treturn ValidationReport{\n468|\t\tReportID:                    claimed,\n469|\t\tOperationID:                 operation,\n470|\t\tProjectionPlanID:            planID,\n471|\t\tProjectedObjectManifestID:   projectedID,\n472|\t\tStagedManifestID:            stagedID,\n473|\t\tLiveManifestID:              liveID,\n474|\t\tProviderManifestID:          providerID,\n475|\t\tFidelityReportID:            fidelityID,\n476|\t\tExpectedTargetNativeSession: expected,\n477|\t\tObservedTargetNativeSession: observed,\n478|\t\tTargetEnvironment:           targetTuple,\n479|\t\tChecks:                      checks,\n480|\t\tFindings:                    findings,\n481|\t\tValid:                       valid,\n482|\t}, nil\n483|}\n484|\n485|// decodeValidationChecks reads the seven check booleans. Each member\n486|// is required non-null; null is a wrong type, never false.\n487|func decodeValidationChecks(members map[string]json.RawMessage) (ValidationChecks, error) {\n488|\towner := \"clone validation report\"\n489|\tread := func(member string) (bool, error) {\n490|\t\tvalue, ok := rawBool(members[member])\n491|\t\tif !ok {\n492|\t\t\treturn false, invalid(\"%s %s is not a boolean\", owner, member)\n493|\t\t}\n494|\t\treturn value, nil\n495|\t}\n496|\tstaged, err := read(\"staged_structural_valid\")\n497|\tif err != nil {\n498|\t\treturn ValidationChecks{}, err\n499|\t}\n500|\tlive, err := read(\"live_structural_valid\")\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
