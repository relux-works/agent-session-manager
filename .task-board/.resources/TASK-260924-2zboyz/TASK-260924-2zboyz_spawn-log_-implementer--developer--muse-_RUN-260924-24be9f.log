{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ce3f","stream":{"kind":"session","id":"01a0d536-7d14-7863-b4a5-d6cfb7bdb4fc"},"sequence":1402,"recorded_at":1780531400002799,"record_type":"event","durability":"durable","causation_id":"f8f39da6-44fd-4b55-a795-0893d87482b7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f8f39da6-44fd-4b55-a795-0893d87482b7","run_stream":{"kind":"run","id":"f8f39da6-44fd-4b55-a795-0893d87482b7"},"task_stream":{"kind":"task","id":"01a0d553-6779-7a12-a595-5212b40a329c"},"task_id":"01a0d553-6779-7a12-a595-5212b40a329c","event":{"kind":"output","task_id":"01a0d553-6779-7a12-a595-5212b40a329c","chunk":"Read text file `internal/clonereadback/fixtures_test.go`.\n1|package clonereadback_test\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"encoding/json\"\n7|\t\"fmt\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\n11|\tclonereadback \"github.com/relux-works/agent-session-manager/internal/clonereadback\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n13|)\n14|\n15|// This file builds the valid baseline inputs every conformance test\n16|// mutates: deterministic digests, UUIDv7 operation IDs, owner-valid\n17|// tuple/binding/finding documents, and the must-build/must-decode\n18|// seams.\n19|\n20|// fixtureDigest renders a deterministic pinned-form digest for one\n21|// seed.\n22|func fixtureDigest(seed string) string {\n23|\tsum := sha256.Sum256([]byte(\"clonereadback:\" + seed))\n24|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n25|}\n26|\n27|// fixtureOperationID renders a deterministic lowercase UUIDv7: the\n28|// time field pins the seed hash, the version nibble pins 7, and the\n29|// variant bits pin 10.\n30|func fixtureOperationID(seed string) string {\n31|\tsum := sha256.Sum256([]byte(\"clonereadback-operation:\" + seed))\n32|\thexed := hex.EncodeToString(sum[:])\n33|\ttimeField := hexed[:12]\n34|\trandA := hexed[12:15]\n35|\trandB := hexed[16:28]\n36|\treturn timeField[:8] + \"-\" + timeField[8:12] + \"-7\" + randA + \"-8\" + randB[:3] + \"-\" + randB[3:12] + hexed[28:31]\n37|}\n38|\n39|// fixtureTuple is one owner-valid Environment Tuple document.\n40|func fixtureTuple() []byte {\n41|\treturn []byte(`{\"adapter_version\":\"1.2.3\",\"architecture\":\"arm64\",\"environment_id\":\"relux.target\",\"environment_version\":\"2026.09\",\"platform\":\"macos\",\"store_schema_fingerprint\":\"` + fixtureDigest(\"store-fingerprint\") + `\"}`)\n42|}\n43|\n44|// fixtureBinding is one owner-valid Workspace Binding document.\n45|func fixtureBinding() []byte {\n46|\tfirst, second := fixtureDigest(\"remote-a\"), fixtureDigest(\"remote-b\")\n47|\tif second < first {\n48|\t\tfirst, second = second, first\n49|\t}\n50|\treturn []byte(`{\"branch\":\"main\",\"cwd_relative\":\"work/session\",\"extensions\":{},\"head_digest\":\"` + fixtureDigest(\"head\") + `\",\"index_digest\":null,\"logical_workspace_id\":\"` + fixtureOperationID(\"workspace\") + `\",\"repository_remote_fingerprints\":[\"` + first + `\",\"` + second + `\"],\"working_tree_digest\":null}`)\n51|}\n52|\n53|// fixtureFinding renders one owner-valid Adapter Finding document\n54|// with the given severity.\n55|func fixtureFinding(severity, code string) string {\n56|\treturn `{\"code\":\"` + code + `\",\"extensions\":{},\"message\":\"finding ` + code + `\",\"remediation\":null,\"severity\":\"` + severity + `\"}`\n57|}\n58|\n59|// fixtureFindings renders one owner-valid findings array over the\n60|// given severities.\n61|func fixtureFindings(severities ...string) []byte {\n62|\tvar rows []string\n63|\tfor index, severity := range severities {\n64|\t\trows = append(rows, fixtureFinding(severity, fmt.Sprintf(\"probe-%04d\", index)))\n65|\t}\n66|\treturn []byte(\"[\" + strings.Join(rows, \",\") + \"]\")\n67|}\n68|\n69|// validEvidenceInput renders one valid evidence row candidate with a\n70|// caller-chosen kind and blob seed.\n71|func validEvidenceInput(kind, seed string) clonereadback.EvidenceObjectInput {\n72|\treturn clonereadback.EvidenceObjectInput{\n73|\t\tEvidenceKind:     kind,\n74|\t\tMediaType:        \"application/octet-stream\",\n75|\t\tByteCount:        64,\n76|\t\tBlobID:           fixtureDigest(\"blob-\" + seed),\n77|\t\tBlobDescriptorID: fixtureDigest(\"descriptor-\" + seed),\n78|\t}\n79|}\n80|\n81|// validReadBackInput renders one valid read-back manifest candidate:\n82|// staged mode, two evidence rows in (kind, blob) order.\n83|func validReadBackInput() clonereadback.ReadBackManifestInput {\n84|\tsecond := validEvidenceInput(\"parser_trace\", \"trace\")\n85|\tfirst := validEvidenceInput(\"native_sample\", \"sample\")\n86|\treturn clonereadback.ReadBackManifestInput{\n87|\t\tOperationID:                 fixtureOperationID(\"read-back\"),\n88|\t\tMode:                        \"staged\",\n89|\t\tProjectionPlanID:            fixtureDigest(\"plan\"),\n90|\t\tProjectedObjectManifestID:   fixtureDigest(\"projected\"),\n91|\t\tExpectedTargetNativeSession: \"target-native-session-1\",\n92|\t\tObservedTargetNativeSession: \"target-native-session-1\",\n93|\t\tObservedEnvironment:         fixtureTuple(),\n94|\t\tParsedEventCount:            41,\n95|\t\tParsedHeadIDs:               []string{\"head-a\", \"head-b\"},\n96|\t\tWorkspaceBinding:            fixtureBinding(),\n97|\t\tStructuralDigest:            fixtureDigest(\"structural\"),\n98|\t\tEvidenceObjects:             []clonereadback.EvidenceObjectInput{first, second},\n99|\t\tExtensions:                  map[string]any{},\n100|\t}\n101|}\n102|\n103|// fixtureAuthority decodes one owner-valid ReadAuthority carrying\n104|// the given purpose through the sessadapter owner: the fixtures\n105|// thread genuinely validated authorities, never hand-built\n106|// structs, mirroring how the caller chain mints them.\n107|func fixtureAuthority(t *testing.T, purpose string) sessadapter.ReadAuthority {\n108|\tt.Helper()\n109|\traw := []byte(`{\"authority_id\":\"` + fixtureOperationID(\"authority-\"+purpose) + `\",\"purpose\":\"` + purpose + `\",\"root_handle_names\":[\"handle-a\"],\"expires_at\":\"2026-09-24T00:00:00.000Z\",\"extensions\":{}}`)\n110|\tauthority, err := sessadapter.DecodeReadAuthority(raw)\n111|\tif err != nil {\n112|\t\tt.Fatalf(\"DecodeReadAuthority(%s): %v\", purpose, err)\n113|\t}\n114|\treturn authority\n115|}\n116|\n117|// stagedAuthority renders the trusted target_staged authority every\n118|// staged read-back case threads.\n119|func stagedAuthority(t *testing.T) sessadapter.ReadAuthority {\n120|\tt.Helper()\n121|\treturn fixtureAuthority(t, \"target_staged\")\n122|}\n123|\n124|// liveAuthority renders the trusted target_live authority every\n125|// live read-back case threads.\n126|func liveAuthority(t *testing.T) sessadapter.ReadAuthority {\n127|\tt.Helper()\n128|\treturn fixtureAuthority(t, \"target_live\")\n129|}\n130|\n131|// sourceAuthority renders the trusted source_native authority the\n132|// purpose grid refuses for target read-back.\n133|func sourceAuthority(t *testing.T) sessadapter.ReadAuthority {\n134|\tt.Helper()\n135|\treturn fixtureAuthority(t, \"source_native\")\n136|}\n137|\n138|// validLiveReadBackInput renders one valid live read-back manifest\n139|// candidate: the staged baseline claimed under live.\n140|func validLiveReadBackInput() clonereadback.ReadBackManifestInput {\n141|\tinput := validReadBackInput()\n142|\tinput.Mode = \"live\"\n143|\treturn input\n144|}\n145|\n146|// validReportInput renders one valid validation report candidate:\n147|// every check true, matching IDs, one info finding, valid true,\n148|// and read references naming the two trusted sibling reads.\n149|func validReportInput(staged, live clonereadback.ValidatedReadBack) clonereadback.ValidationReportInput {\n150|\treturn clonereadback.ValidationReportInput{\n151|\t\tOperationID:                      fixtureOperationID(\"report\"),\n152|\t\tProjectionPlanID:                 fixtureDigest(\"plan\"),\n153|\t\tProjectedObjectManifestID:        fixtureDigest(\"projected\"),\n154|\t\tStagedReadBackEvidenceManifestID: staged.ManifestID().String(),\n155|\t\tLiveReadBackEvidenceManifestID:   live.ManifestID().String(),\n156|\t\tTargetProviderManifestID:         fixtureDigest(\"provider\"),\n157|\t\tFidelityReportID:                 fixtureDigest(\"fidelity\"),\n158|\t\tExpectedTargetNativeSession:      \"target-native-session-1\",\n159|\t\tObservedTargetNativeSession:      \"target-native-session-1\",\n160|\t\tTargetEnvironment:                fixtureTuple(),\n161|\t\tStagedStructuralValid:            true,\n162|\t\tLiveStructuralValid:              true,\n163|\t\tSemanticMarkerValid:              true,\n164|\t\tIdentityValid:                    true,\n165|\t\tWorkspaceBindingValid:            true,\n166|\t\tResumeSurfaceValid:               true,\n167|\t\tSourceGenerationRevalidated:      true,\n168|\t\tFindings:                         fixtureFindings(\"info\"),\n169|\t\tValid:                            true,\n170|\t\tExtensions:                       map[string]any{},\n171|\t}\n172|}\n173|\n174|func mustBuildReadBack(t *testing.T, authority sessadapter.ReadAuthority, input clonereadback.ReadBackManifestInput) []byte {\n175|\tt.Helper()\n176|\t_, sealed, err := clonereadback.BuildReadBackEvidenceManifest(input, authority)\n177|\tif err != nil {\n178|\t\tt.Fatalf(\"BuildReadBackEvidenceManifest: %v\", err)\n179|\t}\n180|\treturn sealed\n181|}\n182|\n183|func mustDecodeReadBack(t *testing.T, authority sessadapter.ReadAuthority, sealed []byte) clonereadback.ValidatedReadBack {\n184|\tt.Helper()\n185|\tmanifest, err := clonereadback.DecodeReadBackEvidenceManifest(sealed, authority)\n186|\tif err != nil {\n187|\t\tt.Fatalf(\"DecodeReadBackEvidenceManifest: %v\", err)\n188|\t}\n189|\treturn manifest\n190|}\n191|\n192|// mustReadPair seals and decodes the staged and live reads the\n193|// report cases aggregate: one operation, two stages. The pair\n194|// rides the sealed decode path, so every report case aggregates\n195|// genuinely validated reads.\n196|func mustReadPair(t *testing.T) (clonereadback.ValidatedReadBack, clonereadback.ValidatedReadBack) {\n197|\tt.Helper()\n198|\tstaged := mustDecodeReadBack(t, stagedAuthority(t), mustBuildReadBack(t, stagedAuthority(t), validReadBackInput()))\n199|\tlive := mustDecodeReadBack(t, liveAuthority(t), mustBuildReadBack(t, liveAuthority(t), validLiveReadBackInput()))\n200|\tif staged.ManifestID() == live.ManifestID() {\n201|\t\tt.Fatal(\"staged and live reads share an id: the pair is not distinct\")\n202|\t}\n203|\treturn staged, live\n204|}\n205|\n206|func mustBuildReport(t *testing.T, input clonereadback.ValidationReportInput, staged, live clonereadback.ValidatedReadBack) []byte {\n207|\tt.Helper()\n208|\tsealed, err := clonereadback.BuildValidationReport(input, staged, live)\n209|\tif err != nil {\n210|\t\tt.Fatalf(\"BuildValidationReport: %v\", err)\n211|\t}\n212|\treturn sealed\n213|}\n214|\n215|func mustDecodeReport(t *testing.T, sealed []byte, staged, live clonereadback.ValidatedReadBack) clonereadback.ValidationReport {\n216|\tt.Helper()\n217|\treport, err := clonereadback.DecodeValidationReport(sealed, staged, live)\n218|\tif err != nil {\n219|\t\tt.Fatalf(\"DecodeValidationReport: %v\", err)\n220|\t}\n221|\treturn report\n222|}\n223|\n224|// decodeDocument parses sealed bytes into a generic document for\n225|// member surgery.\n226|func decodeDocument(t *testing.T, sealed []byte) map[string]any {\n227|\tt.Helper()\n228|\tvar document map[string]any\n229|\tif err := json.Unmarshal(sealed, &document); err != nil {\n230|\t\tt.Fatalf(\"unmarshal sealed: %v\", err)\n231|\t}\n232|\treturn document\n233|}\n234|\n235|// marshalDocument renders a surgered document back to bytes.\n236|func marshalDocument(t *testing.T, document map[string]any) []byte {\n237|\tt.Helper()\n238|\trendered, err := json.Marshal(document)\n239|\tif err != nil {\n240|\t\tt.Fatalf(\"marshal document: %v\", err)\n241|\t}\n242|\treturn rendered\n243|}\n244|\n245|// documentAt navigates a nested object member for row-level census\n246|// probes.\n247|func documentAt(t *testing.T, document map[string]any, member string, index int) map[string]any {\n248|\tt.Helper()\n249|\trows, ok := document[member].([]any)\n250|\tif !ok {\n251|\t\tt.Fatalf(\"member %s is not an array\", member)\n252|\t}\n253|\trow, ok := rows[index].(map[string]any)\n254|\tif !ok {\n255|\t\tt.Fatalf(\"member %s[%d] is not an object\", member, index)\n256|\t}\n257|\treturn row\n258|}","final_result":true}}}
