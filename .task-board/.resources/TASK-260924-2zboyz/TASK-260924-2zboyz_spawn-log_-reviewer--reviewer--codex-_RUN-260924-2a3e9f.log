+import pathlib
+import subprocess
+
+root = pathlib.Path(__file__).parent / "candidate"
+pkg = root / "internal/clonereadback"
+cases = [
+    ("case_alias", "decode.go", "\treturn members, nil\n", "\tif value, ok := members[\"Schema\"]; ok { delete(members, \"Schema\"); members[\"schema\"] = value }\n\treturn members, nil\n", "TestMemberCensusMiscased"),
+    ("mode_relabel", "authority.go", "if claimed != expected {", "if claimed != expected && claimed != \"live\" {", "TestBuildStagedAuthorityRefusesLiveClaim"),
+    ("valid_marker", "report.go", "if !checks.SemanticMarkerValid {", "if !checks.SemanticMarkerValid && !checks.LiveStructuralValid {", "TestValidWholeDomainOracle"),
+    ("owner_wrong_input", "report.go", 'checkExtensionsClosed(members["extensions"])', 'checkExtensionsClosed(json.RawMessage("{}"))', "TestExtensionsClosed"),
+    ("media_129", "readback.go", "length > 128 {", "length > 129 {", "TestMediaTypeStringEdges"),
+    ("neutral_control", "sealed.go", "package clonereadback\n", "package clonereadback\n// review neutral control\n", "TestBuildReportRefusesUnsealedSiblings"),
+]
+for name, filename, anchor, replacement, test in cases:
+    path = pkg / filename
+    original = path.read_text()
+    assert original.count(anchor) == 1, (name, original.count(anchor))
+    path.write_text(original.replace(anchor, replacement, 1))
+    try:
+        proc = subprocess.run(["go", "test", "-count=1", "./internal/clonereadback/", "-run", "^" + test + "$"], cwd=root, capture_output=True, text=True)
+        log = pathlib.Path(__file__).parent / (name + ".log")
+        log.write_text("exit_code=" + str(proc.returncode) + "\n" + proc.stdout + proc.stderr)
+        print(name, "exit_code=" + str(proc.returncode), "expected=" + ("0" if name == "neutral_control" else "1"), flush=True)
+    finally:
+        path.write_text(original)

