+package clonereadback_test
+
+import (
+    "fmt"
+    "testing"
+)
+
+func TestReviewPrintFixtures(t *testing.T) {
+    staged, live := mustReadPair(t)
+    read := mustBuildReadBack(t, stagedAuthority(t), validReadBackInput())
+    report := mustBuildReport(t, validReportInput(staged, live), staged, live)
+    fmt.Printf("REVIEW_READ=%s\n", read)
+    fmt.Printf("REVIEW_REPORT=%s\n", report)
+}
diff --git a//Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/review-scratch/RUN-260924-2a3e9f/review_plants.py b//Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/review-scratch/RUN-260924-2a3e9f/review_plants.py
new file mode 100644
