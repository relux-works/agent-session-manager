{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7f9","stream":{"kind":"session","id":"01a0d474-3d76-7560-9284-b023a445b4ff"},"sequence":599,"recorded_at":1780531400001193,"record_type":"event","durability":"durable","causation_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","run_stream":{"kind":"run","id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27"},"task_stream":{"kind":"task","id":"01a0d476-db02-7f32-b2c3-2379e827b3db"},"task_id":"01a0d476-db02-7f32-b2c3-2379e827b3db","event":{"kind":"output","task_id":"01a0d476-db02-7f32-b2c3-2379e827b3db","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/clonereadback/utf8_test.go`.\n1|package clonereadback_test\n2|\n3|import (\n4|\t\"reflect\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|\n8|\tclonereadback \"github.com/relux-works/agent-session-manager/internal/clonereadback\"\n9|)\n10|\n11|// This file proves by reflection that invalid UTF-8 is refused at\n12|// every Build-side string gate: the walker derives every string\n13|// field of the production input types (nested rows included) and\n14|// feeds each lone-invalid bytes plus trailing-invalid bytes. Raw\n15|// JSON members ride owner decoders; the owner suites pin their\n16|// UTF-8 behavior, and the delegation table pins the wiring.\n17|\n18|// stringField describes one derived Build-side string: a setter\n19|// over a fresh valid input plus the refusal literal.\n20|type stringField struct {\n21|\tlabel  string\n22|\tset    func(valid clonereadback.ReadBackManifestInput, validReport clonereadback.ValidationReportInput, value string) (clonereadback.ReadBackManifestInput, clonereadback.ValidationReportInput, bool)\n23|\tmember string\n24|}\n25|\n26|// buildUTF8Fields derives every string field of the two input\n27|// types by reflection. The derivation fails loudly on any field\n28|// kind it cannot classify; the inventory test pins the exact field\n29|// count so a silently skipped string is a red test, not a gap.\n30|func buildUTF8Fields(t *testing.T) []stringField {\n31|\tt.Helper()\n32|\tvar fields []stringField\n33|\tcollectStrings(t, reflect.TypeOf(clonereadback.ReadBackManifestInput{}), \"readback\", &fields)\n34|\tcollectStrings(t, reflect.TypeOf(clonereadback.EvidenceObjectInput{}), \"evidence\", &fields)\n35|\tcollectStrings(t, reflect.TypeOf(clonereadback.ValidationReportInput{}), \"report\", &fields)\n36|\treturn fields\n37|}\n38|\n39|func collectStrings(t *testing.T, typ reflect.Type, shape string, fields *[]stringField) {\n40|\tt.Helper()\n41|\tfor index := 0; index < typ.NumField(); index++ {\n42|\t\tfield := typ.Field(index)\n43|\t\tif field.PkgPath != \"\" {\n44|\t\t\tt.Fatalf(\"unexported field %s.%s: extend the walker\", shape, field.Name)\n45|\t\t}\n46|\t\tmember := snakeMember(field.Name)\n47|\t\tif irregular, ok := irregularMembers[field.Name]; ok {\n48|\t\t\tmember = irregular\n49|\t\t}\n50|\t\tswitch field.Type.Kind() {\n51|\t\tcase reflect.String:\n52|\t\t\tname := field.Name\n53|\t\t\tshapeName := shape\n54|\t\t\tmemberName := member\n55|\t\t\t*fields = append(*fields, stringField{\n56|\t\t\t\tlabel:  shapeName + \".\" + name,\n57|\t\t\t\tmember: memberName,\n58|\t\t\t\tset: func(valid clonereadback.ReadBackManifestInput, validReport clonereadback.ValidationReportInput, value string) (clonereadback.ReadBackManifestInput, clonereadback.ValidationReportInput, bool) {\n59|\t\t\t\t\tswitch shapeName {\n60|\t\t\t\t\tcase \"readback\":\n61|\t\t\t\t\t\treflect.ValueOf(&valid).Elem().FieldByName(name).SetString(value)\n62|\t\t\t\t\t\treturn valid, validReport, true\n63|\t\t\t\t\tcase \"report\":\n64|\t\t\t\t\t\treflect.ValueOf(&validReport).Elem().FieldByName(name).SetString(value)\n65|\t\t\t\t\t\treturn valid, validReport, false\n66|\t\t\t\t\tcase \"evidence\":\n67|\t\t\t\t\t\tvalid.EvidenceObjects = []clonereadback.EvidenceObjectInput{validEvidenceInput(\"native_sample\", \"utf8\")}\n68|\t\t\t\t\t\treflect.ValueOf(&valid.EvidenceObjects[0]).Elem().FieldByName(name).SetString(value)\n69|\t\t\t\t\t\treturn valid, validReport, true\n70|\t\t\t\t\t}\n71|\t\t\t\t\treturn valid, validReport, true\n72|\t\t\t\t},\n73|\t\t\t})\n74|\t\tcase reflect.Bool, reflect.Uint64, reflect.Map:\n75|\t\t\t// Non-string leaves: nothing to feed.\n76|\t\tcase reflect.Slice, reflect.Array:\n77|\t\t\telement := field.Type.Elem()\n78|\t\t\tswitch element.Kind() {\n79|\t\t\tcase reflect.Uint8, reflect.Struct:\n80|\t\t\t\t// Raw JSON and nested rows: rows are walked\n81|\t\t\t\t// as their own type above; raw JSON rides\n82|\t\t\t\t// owner decoders.\n83|\t\t\tcase reflect.String:\n84|\t\t\t\tif field.Name != \"ParsedHeadIDs\" {\n85|\t\t\t\t\tt.Fatalf(\"string slice %s.%s is not the heads member: extend the walker\", shape, field.Name)\n86|\t\t\t\t}\n87|\t\t\tdefault:\n88|\t\t\t\tt.Fatalf(\"unhandled slice element kind %s at %s.%s: extend the walker\", element.Kind(), shape, field.Name)\n89|\t\t\t}\n90|\t\tdefault:\n91|\t\t\tt.Fatalf(\"unhandled kind %s at %s.%s: extend the walker\", field.Type.Kind(), shape, field.Name)\n92|\t\t}\n93|\t}\n94|}\n95|\n96|// TestBuildUTF8Reflection feeds invalid UTF-8 to every derived\n97|// Build-side string field at the production Build entries: each\n98|// refuses with its member literal.\n99|func TestBuildUTF8Reflection(t *testing.T) {\n100|\tpoison := []string{string([]byte{0xff}), \"ok-prefix-\\xff\", \"\\xff-ok-suffix\"}\n101|\tfor _, field := range buildUTF8Fields(t) {\n102|\t\tfor _, value := range poison {\n103|\t\t\tinput, rinput, isReadBack := field.set(validReadBackInput(), validReportInput(), value)\n104|\t\t\tif isReadBack {\n105|\t\t\t\t_, err := clonereadback.BuildReadBackEvidenceManifest(input)\n106|\t\t\t\tif err == nil {\n107|\t\t\t\t\tt.Fatalf(\"field %s admits invalid UTF-8 at Build\", field.label)\n108|\t\t\t\t}\n109|\t\t\t\tif !strings.Contains(err.Error(), field.member) {\n110|\t\t\t\t\tt.Fatalf(\"field %s error %q misses member literal %q\", field.label, err.Error(), field.member)\n111|\t\t\t\t}\n112|\t\t\t} else {\n113|\t\t\t\t_, err := clonereadback.BuildValidationReport(rinput)\n114|\t\t\t\tif err == nil {\n115|\t\t\t\t\tt.Fatalf(\"field %s admits invalid UTF-8 at Build\", field.label)\n116|\t\t\t\t}\n117|\t\t\t\tif !strings.Contains(err.Error(), field.member) {\n118|\t\t\t\t\tt.Fatalf(\"field %s error %q misses member literal %q\", field.label, err.Error(), field.member)\n119|\t\t\t\t}\n120|\t\t\t}\n121|\t\t}\n122|\t}\n123|}\n124|\n125|// TestBuildUTF8HeadsAndExtensions feeds invalid UTF-8 to the heads\n126|// array items and one extension value at both production Build\n127|// entries.\n128|func TestBuildUTF8HeadsAndExtensions(t *testing.T) {\n129|\tinput := validReadBackInput()\n130|\tinput.ParsedHeadIDs = []string{\"head-a\", \"bad-\\xff\"}\n131|\t_, err := clonereadback.BuildReadBackEvidenceManifest(input)\n132|\trequireRefusal(t, err, \"read-back evidence manifest\", \"parsed_head_ids\")\n133|\tinput = validReadBackInput()\n134|\tinput.Extensions = map[string]any{\"com.example.note\": \"bad-\\xff\"}\n135|\t_, err = clonereadback.BuildReadBackEvidenceManifest(input)\n136|\trequireRefusal(t, err, \"read-back evidence manifest\", \"extensions invalid\")\n137|\trinput := validReportInput()\n138|\trinput.Extensions = map[string]any{\"com.example.note\": \"bad-\\xff\"}\n139|\t_, err = clonereadback.BuildValidationReport(rinput)\n140|\trequireRefusal(t, err, \"clone validation report\", \"extensions invalid\")\n141|}\n142|\n143|// TestUTF8FieldInventory pins the derivation count: 7 read-back\n144|// strings, 4 evidence strings, 9 report strings.\n145|func TestUTF8FieldInventory(t *testing.T) {\n146|\tfields := buildUTF8Fields(t)\n147|\tcounts := map[string]int{}\n148|\tfor _, field := range fields {\n149|\t\tshape := field.label[:strings.Index(field.label, \".\")]\n150|\t\tcounts[shape]++\n151|\t}\n152|\tif counts[\"readback\"] != 7 || counts[\"evidence\"] != 4 || counts[\"report\"] != 9 {\n153|\t\tt.Fatalf(\"utf8 fields = %v, want readback=7 evidence=4 report=9\", counts)\n154|\t}\n155|}","final_result":true}}}
