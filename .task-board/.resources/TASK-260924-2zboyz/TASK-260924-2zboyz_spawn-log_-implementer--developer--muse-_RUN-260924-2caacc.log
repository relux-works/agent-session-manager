{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6f7","stream":{"kind":"session","id":"01a0d474-3d76-7560-9284-b023a445b4ff"},"sequence":470,"recorded_at":1780531400000935,"record_type":"event","durability":"durable","causation_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","payload_type":"task.lifecycle.started","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","run_stream":{"kind":"run","id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27"},"task_stream":{"kind":"task","id":"01a0d476-9a3b-7cd3-aae8-c866f65b3844"},"task_id":"01a0d476-9a3b-7cd3-aae8-c866f65b3844","event":{"kind":"started","task_id":"01a0d476-9a3b-7cd3-aae8-c866f65b3844","span_id":"e700f92dfbcc6f7c"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6f9","stream":{"kind":"session","id":"01a0d474-3d76-7560-9284-b023a445b4ff"},"sequence":471,"recorded_at":1780531400000937,"record_type":"event","durability":"durable","causation_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","run_stream":{"kind":"run","id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27"},"task_stream":{"kind":"task","id":"01a0d476-99e4-7250-bc69-aecef8dbb936"},"task_id":"01a0d476-99e4-7250-bc69-aecef8dbb936","event":{"kind":"output","task_id":"01a0d476-99e4-7250-bc69-aecef8dbb936","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/clonereadback/fixtures_test.go`.\n1|package clonereadback_test\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"encoding/json\"\n7|\t\"fmt\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\n11|\tclonereadback \"github.com/relux-works/agent-session-manager/internal/clonereadback\"\n12|)\n13|\n14|// This file builds the valid baseline inputs every conformance test\n15|// mutates: deterministic digests, UUIDv7 operation IDs, owner-valid\n16|// tuple/binding/finding documents, and the must-build/must-decode\n17|// seams.\n18|\n19|// fixtureDigest renders a deterministic pinned-form digest for one\n20|// seed.\n21|func fixtureDigest(seed string) string {\n22|\tsum := sha256.Sum256([]byte(\"clonereadback:\" + seed))\n23|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n24|}\n25|\n26|// fixtureOperationID renders a deterministic lowercase UUIDv7: the\n27|// time field pins the seed hash, the version nibble pins 7, and the\n28|// variant bits pin 10.\n29|func fixtureOperationID(seed string) string {\n30|\tsum := sha256.Sum256([]byte(\"clonereadback-operation:\" + seed))\n31|\thexed := hex.EncodeToString(sum[:])\n32|\ttimeField := hexed[:12]\n33|\trandA := hexed[12:15]\n34|\trandB := hexed[16:28]\n35|\treturn timeField[:8] + \"-\" + timeField[8:12] + \"-7\" + randA + \"-8\" + randB[:3] + \"-\" + randB[3:12] + hexed[28:31]\n36|}\n37|\n38|// fixtureTuple is one owner-valid Environment Tuple document.\n39|func fixtureTuple() []byte {\n40|\treturn []byte(`{\"adapter_version\":\"1.2.3\",\"architecture\":\"arm64\",\"environment_id\":\"relux.target\",\"environment_version\":\"2026.09\",\"platform\":\"macos\",\"store_schema_fingerprint\":\"` + fixtureDigest(\"store-fingerprint\") + `\"}`)\n41|}\n42|\n43|// fixtureBinding is one owner-valid Workspace Binding document.\n44|func fixtureBinding() []byte {\n45|\tfirst, second := fixtureDigest(\"remote-a\"), fixtureDigest(\"remote-b\")\n46|\tif second < first {\n47|\t\tfirst, second = second, first\n48|\t}\n49|\treturn []byte(`{\"branch\":\"main\",\"cwd_relative\":\"work/session\",\"extensions\":{},\"head_digest\":\"` + fixtureDigest(\"head\") + `\",\"index_digest\":null,\"logical_workspace_id\":\"` + fixtureOperationID(\"workspace\") + `\",\"repository_remote_fingerprints\":[\"` + first + `\",\"` + second + `\"],\"working_tree_digest\":null}`)\n50|}\n51|\n52|// fixtureFinding renders one owner-valid Adapter Finding document\n53|// with the given severity.\n54|func fixtureFinding(severity, code string) string {\n55|\treturn `{\"code\":\"` + code + `\",\"extensions\":{},\"message\":\"finding ` + code + `\",\"remediation\":null,\"severity\":\"` + severity + `\"}`\n56|}\n57|\n58|// fixtureFindings renders one owner-valid findings array over the\n59|// given severities.\n60|func fixtureFindings(severities ...string) []byte {\n61|\tvar rows []string\n62|\tfor index, severity := range severities {\n63|\t\trows = append(rows, fixtureFinding(severity, fmt.Sprintf(\"probe-%04d\", index)))\n64|\t}\n65|\treturn []byte(\"[\" + strings.Join(rows, \",\") + \"]\")\n66|}\n67|\n68|// validEvidenceInput renders one valid evidence row candidate with a\n69|// caller-chosen kind and blob seed.\n70|func validEvidenceInput(kind, seed string) clonereadback.EvidenceObjectInput {\n71|\treturn clonereadback.EvidenceObjectInput{\n72|\t\tEvidenceKind:     kind,\n73|\t\tMediaType:        \"application/octet-stream\",\n74|\t\tByteCount:        64,\n75|\t\tBlobID:           fixtureDigest(\"blob-\" + seed),\n76|\t\tBlobDescriptorID: fixtureDigest(\"descriptor-\" + seed),\n77|\t}\n78|}\n79|\n80|// validReadBackInput renders one valid read-back manifest candidate:\n81|// staged mode, two evidence rows in (kind, blob) order.\n82|func validReadBackInput() clonereadback.ReadBackManifestInput {\n83|\tsecond := validEvidenceInput(\"parser_trace\", \"trace\")\n84|\tfirst := validEvidenceInput(\"native_sample\", \"sample\")\n85|\treturn clonereadback.ReadBackManifestInput{\n86|\t\tOperationID:                 fixtureOperationID(\"read-back\"),\n87|\t\tMode:                        \"staged\",\n88|\t\tProjectionPlanID:            fixtureDigest(\"plan\"),\n89|\t\tProjectedObjectManifestID:   fixtureDigest(\"projected\"),\n90|\t\tExpectedTargetNativeSession: \"target-native-session-1\",\n91|\t\tObservedTargetNativeSession: \"target-native-session-1\",\n92|\t\tObservedEnvironment:         fixtureTuple(),\n93|\t\tParsedEventCount:            41,\n94|\t\tParsedHeadIDs:               []string{\"head-a\", \"head-b\"},\n95|\t\tWorkspaceBinding:            fixtureBinding(),\n96|\t\tStructuralDigest:            fixtureDigest(\"structural\"),\n97|\t\tEvidenceObjects:             []clonereadback.EvidenceObjectInput{first, second},\n98|\t\tExtensions:                  map[string]any{},\n99|\t}\n100|}\n101|\n102|// validReportInput renders one valid validation report candidate:\n103|// every check true, matching IDs, one info finding, valid true.\n104|func validReportInput() clonereadback.ValidationReportInput {\n105|\treturn clonereadback.ValidationReportInput{\n106|\t\tOperationID:                      fixtureOperationID(\"report\"),\n107|\t\tProjectionPlanID:                 fixtureDigest(\"plan\"),\n108|\t\tProjectedObjectManifestID:        fixtureDigest(\"projected\"),\n109|\t\tStagedReadBackEvidenceManifestID: fixtureDigest(\"staged\"),\n110|\t\tLiveReadBackEvidenceManifestID:   fixtureDigest(\"live\"),\n111|\t\tTargetProviderManifestID:         fixtureDigest(\"provider\"),\n112|\t\tFidelityReportID:                 fixtureDigest(\"fidelity\"),\n113|\t\tExpectedTargetNativeSession:      \"target-native-session-1\",\n114|\t\tObservedTargetNativeSession:      \"target-native-session-1\",\n115|\t\tTargetEnvironment:                fixtureTuple(),\n116|\t\tStagedStructuralValid:            true,\n117|\t\tLiveStructuralValid:              true,\n118|\t\tSemanticMarkerValid:              true,\n119|\t\tIdentityValid:                    true,\n120|\t\tWorkspaceBindingValid:            true,\n121|\t\tResumeSurfaceValid:               true,\n122|\t\tSourceGenerationRevalidated:      true,\n123|\t\tFindings:                         fixtureFindings(\"info\"),\n124|\t\tValid:                            true,\n125|\t\tExtensions:                       map[string]any{},\n126|\t}\n127|}\n128|\n129|func mustBuildReadBack(t *testing.T, input clonereadback.ReadBackManifestInput) []byte {\n130|\tt.Helper()\n131|\tsealed, err := clonereadback.BuildReadBackEvidenceManifest(input)\n132|\tif err != nil {\n133|\t\tt.Fatalf(\"BuildReadBackEvidenceManifest: %v\", err)\n134|\t}\n135|\treturn sealed\n136|}\n137|\n138|func mustDecodeReadBack(t *testing.T, sealed []byte) clonereadback.ReadBackManifest {\n139|\tt.Helper()\n140|\tmanifest, err := clonereadback.DecodeReadBackEvidenceManifest(sealed)\n141|\tif err != nil {\n142|\t\tt.Fatalf(\"DecodeReadBackEvidenceManifest: %v\", err)\n143|\t}\n144|\treturn manifest\n145|}\n146|\n147|func mustBuildReport(t *testing.T, input clonereadback.ValidationReportInput) []byte {\n148|\tt.Helper()\n149|\tsealed, err := clonereadback.BuildValidationReport(input)\n150|\tif err != nil {\n151|\t\tt.Fatalf(\"BuildValidationReport: %v\", err)\n152|\t}\n153|\treturn sealed\n154|}\n155|\n156|func mustDecodeReport(t *testing.T, sealed []byte) clonereadback.ValidationReport {\n157|\tt.Helper()\n158|\treport, err := clonereadback.DecodeValidationReport(sealed)\n159|\tif err != nil {\n160|\t\tt.Fatalf(\"DecodeValidationReport: %v\", err)\n161|\t}\n162|\treturn report\n163|}\n164|\n165|// decodeDocument parses sealed bytes into a generic document for\n166|// member surgery.\n167|func decodeDocument(t *testing.T, sealed []byte) map[string]any {\n168|\tt.Helper()\n169|\tvar document map[string]any\n170|\tif err := json.Unmarshal(sealed, &document); err != nil {\n171|\t\tt.Fatalf(\"unmarshal sealed: %v\", err)\n172|\t}\n173|\treturn document\n174|}\n175|\n176|// marshalDocument renders a surgered document back to bytes.\n177|func marshalDocument(t *testing.T, document map[string]any) []byte {\n178|\tt.Helper()\n179|\trendered, err := json.Marshal(document)\n180|\tif err != nil {\n181|\t\tt.Fatalf(\"marshal document: %v\", err)\n182|\t}\n183|\treturn rendered\n184|}\n185|\n186|// documentAt navigates a nested object member for row-level census\n187|// probes.\n188|func documentAt(t *testing.T, document map[string]any, member string, index int) map[string]any {\n189|\tt.Helper()\n190|\trows, ok := document[member].([]any)\n191|\tif !ok {\n192|\t\tt.Fatalf(\"member %s is not an array\", member)\n193|\t}\n194|\trow, ok := rows[index].(map[string]any)\n195|\tif !ok {\n196|\t\tt.Fatalf(\"member %s[%d] is not an object\", member, index)\n197|\t}\n198|\treturn row\n199|}","final_result":true}}}
