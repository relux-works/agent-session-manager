pZone: topZone,\n236|\t\t\tdecode: func(data []byte) error {\n237|\t\t\t\t_, err := clonereadback.DecodeReadBackEvidenceManifest(data, stagedAuthority(t))\n238|\t\t\t\treturn err\n239|\t\t\t},\n240|\t\t},\n241|\t\t{\n242|\t\t\tlabel:   \"evidence\",\n243|\t\t\towner:   \"evidence object\",\n244|\t\t\tmembers: derived[\"evidence\"],\n245|\t\t\tseal:    func(t *testing.T) []byte { return mustBuildReadBack(t, stagedAuthority(t), validReadBackInput()) },\n246|\t\t\tnavigate: func(t *testing.T, document map[string]any) map[string]any {\n247|\t\t\t\treturn documentAt(t, document, \"evidence_objects\", 0)\n248|\t\t\t},\n249|\t\t\trewrite: rewriteDoc,\n250|\t\t\tdupZone: func(t *testing.T, sealed []byte) (int, int) {\n251|\t\t\t\tt.Helper()\n252|\t\t\t\treturn firstRowZone(t, sealed, \"evidence_objects\")\n253|\t\t\t},\n254|\t\t\tdecode: func(data []byte) error {\n255|\t\t\t\t_, err := clonereadback.DecodeReadBackEvidenceManifest(data, stagedAuthority(t))\n256|\t\t\t\treturn err\n257|\t\t\t},\n258|\t\t},\n259|\t\t{\n260|\t\t\tlabel:   \"report\",\n261|\t\t\towner:   \"clone validation report\",\n262|\t\t\tmembers: derived[\"report\"],\n263|\t\t\tseal:    func(t *testing.T) []byte { return mustBuildReport(t, XXSTAGEDLIVE validReportInput(staged, live)) },\n264|\t\t\tnavigate: func(t *testing.T, document map[string]any) map[string]any {\n265|\t\t\t\treturn document\n266|\t\t\t},\n267|\t\t\trewrite: rewriteDoc,\n268|\t\t\tdupZone: topZone,\n269|\t\t\tdecode: func(data []byte) error {\n270|\t\t\t\t_, err := clonereadback.DecodeValidationReport(data, staged, live)\n271|\t\t\t\treturn err\n272|\t\t\t},\n273|\t\t},\n274|\t}\n275|}\n(more lines below)","final_result":true}}}
