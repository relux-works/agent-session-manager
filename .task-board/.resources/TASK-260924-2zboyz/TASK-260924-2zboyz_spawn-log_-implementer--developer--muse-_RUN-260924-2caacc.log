n\": true,\n32|}\n33|\n34|// ValidEvidenceKind reports whether the kind is one of the three\n35|// closed evidence row kinds.\n36|func ValidEvidenceKind(kind string) bool {\n37|\treturn evidenceKinds[kind]\n38|}\n39|\n40|// EvidenceKinds lists the closed evidence row kinds in a fixed\n41|// order.\n42|func EvidenceKinds() []string {\n43|\treturn []string{\"native_sample\", \"parser_trace\", \"marker_observation\"}\n44|}","final_result":true}}}
