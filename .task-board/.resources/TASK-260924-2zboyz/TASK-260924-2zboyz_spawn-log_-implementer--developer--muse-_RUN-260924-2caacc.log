{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7b9","stream":{"kind":"session","id":"01a0d474-3d76-7560-9284-b023a445b4ff"},"sequence":567,"recorded_at":1780531400001129,"record_type":"event","durability":"durable","causation_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","run_stream":{"kind":"run","id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27"},"task_stream":{"kind":"task","id":"01a0d476-caae-76c1-9906-6d8a4fdb60ca"},"task_id":"01a0d476-caae-76c1-9906-6d8a4fdb60ca","event":{"kind":"output","task_id":"01a0d476-caae-76c1-9906-6d8a4fdb60ca","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/clonereadback/ownercensus_test.go`.\n1|package clonereadback_test\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"reflect\"\n10|\t\"runtime\"\n11|\t\"sort\"\n12|\t\"testing\"\n13|\n14|\tclonereadback \"github.com/relux-works/agent-session-manager/internal/clonereadback\"\n15|)\n16|\n17|// This file pins the single-owner rule structurally. The read-back\n18|// and validation shapes carry Fidelity Report, disposition/reason,\n19|// and Projection Plan data only as opaque digest references —\n20|// never as rows — so no clonefidelity or cloneplan validator is\n21|// reachable here by construction:\n22|//\n23|//   - the row census derives every exported entry whose parameters\n24|//     carry a disposition row, a fidelity report, or a projection\n25|//     plan from the real parameter types and asserts the set is\n26|//     empty;\n27|//   - the reachability pin proves every entry that DOES carry\n28|//     owner-shaped data (tuples, bindings, findings) reaches the\n29|//     landed owner decoder on the static call graph;\n30|//   - the no-import guard proves the package imports neither\n31|//     internal/clonefidelity nor internal/cloneplan.\n32|//\n33|// Behavior itself is proven by the owner-delegation table in\n34|// gates_test.go, which drives broken nested documents through the\n35|// production entries and asserts the owner detail surfaces.\n36|// Control plants (a new row-carrying entry, a removed owner call,\n37|// a re-added owner import) redden these tests; logs ride the\n38|// evidence tar.\n39|\n40|// structCarriesOwnerRow reports whether one struct type is a\n41|// fidelity/plan row: a disposition member (Disposition or\n42|// ExpectedDispos) paired with a reason-set member (Reasons or\n43|// ReasonCodes), a fidelity report member, or a projection plan\n44|// member.\n45|func structCarriesOwnerRow(typ reflect.Type) bool {\n46|\thasDisposition := false\n47|\thasReasons := false\n48|\tfor i := 0; i < typ.NumField(); i++ {\n49|\t\tswitch typ.Field(i).Name {\n50|\t\tcase \"Disposition\", \"ExpectedDispos\":\n51|\t\t\thasDisposition = true\n52|\t\tcase \"Reasons\", \"ReasonCodes\":\n53|\t\t\thasReasons = true\n54|\t\tcase \"FidelityReport\", \"ProjectionPlan\", \"DispositionRecord\", \"ItemMapping\":\n55|\t\t\treturn true\n56|\t\t}\n57|\t}\n58|\treturn hasDisposition && hasReasons\n59|}\n60|\n61|// reflectCarriesOwnerRow reports whether an owner row is reachable\n62|// from the type through fields, elements, keys, and pointees. Open\n63|// any-typed members do not count: an any carries no NAMED row.\n64|// Digest and UUID members are opaque references, never rows.\n65|func reflectCarriesOwnerRow(typ reflect.Type, visited map[reflect.Type]bool) bool {\n66|\tif typ == nil {\n67|\t\treturn false\n68|\t}\n69|\tswitch typ.Kind() {\n70|\tcase reflect.Pointer:\n71|\t\treturn reflectCarriesOwnerRow(typ.Elem(), visited)\n72|\tcase reflect.Slice, reflect.Array:\n73|\t\treturn reflectCarriesOwnerRow(typ.Elem(), visited)\n74|\tcase reflect.Map:\n75|\t\treturn reflectCarriesOwnerRow(typ.Key(), visited) || reflectCarriesOwnerRow(typ.Elem(), visited)\n76|\tcase reflect.Struct:\n77|\t\tif structCarriesOwnerRow(typ) {\n78|\t\t\treturn true\n79|\t\t}\n80|\t\tif visited[typ] {\n81|\t\t\treturn false\n82|\t\t}\n83|\t\tvisited[typ] = true\n84|\t\tfor i := 0; i < typ.NumField(); i++ {\n85|\t\t\tif reflectCarriesOwnerRow(typ.Field(i).Type, visited) {\n86|\t\t\t\treturn true\n87|\t\t\t}\n88|\t\t}\n89|\t\treturn false\n90|\tdefault:\n91|\t\treturn false\n92|\t}\n93|}\n94|\n95|// exportedEntries lists every exported production entry by name and\n96|// function value.\n97|func exportedEntries() map[string]any {\n98|\treturn map[string]any{\n99|\t\t\"BuildReadBackEvidenceManifest\":  clonereadback.BuildReadBackEvidenceManifest,\n100|\t\t\"DecodeReadBackEvidenceManifest\": clonereadback.DecodeReadBackEvidenceManifest,\n101|\t\t\"BuildValidationReport\":          clonereadback.BuildValidationReport,\n102|\t\t\"DecodeValidationReport\":         clonereadback.DecodeValidationReport,\n103|\t\t\"ValidReadBackMode\":              clonereadback.ValidReadBackMode,\n104|\t\t\"ReadBackModes\":                  clonereadback.ReadBackModes,\n105|\t\t\"ValidEvidenceKind\":              clonereadback.ValidEvidenceKind,\n106|\t\t\"EvidenceKinds\":                  clonereadback.EvidenceKinds,\n107|\t}\n108|}\n109|\n110|// TestExportedAPIInventory pins the exact exported production API:\n111|// four entries plus four vocabulary helpers. A ninth export — in\n112|// particular a new entry carrying owner-shaped data — reddens this\n113|// test before the row census extends to it; the P-census-entry\n114|// harness row plants exactly that.\n115|func TestExportedAPIInventory(t *testing.T) {\n116|\tdir := packageDir(t)\n117|\tfiles, err := filepath.Glob(filepath.Join(dir, \"*.go\"))\n118|\tif err != nil {\n119|\t\tt.Fatalf(\"glob: %v\", err)\n120|\t}\n121|\twant := map[string]bool{\n122|\t\t\"BuildReadBackEvidenceManifest\": true, \"DecodeReadBackEvidenceManifest\": true,\n123|\t\t\"BuildValidationReport\": true, \"DecodeValidationReport\": true,\n124|\t\t\"ValidReadBackMode\": true, \"ReadBackModes\": true,\n125|\t\t\"ValidEvidenceKind\": true, \"EvidenceKinds\": true,\n126|\t}\n127|\tfound := map[string]bool{}\n128|\tfor _, path := range files {\n129|\t\tif len(path) >= 8 && path[len(path)-8:] == \"_test.go\" {\n130|\t\t\tcontinue\n131|\t\t}\n132|\t\tsource, err := os.ReadFile(path)\n133|\t\tif err != nil {\n134|\t\t\tt.Fatalf(\"read %s: %v\", path, err)\n135|\t\t}\n136|\t\tfset := token.NewFileSet()\n137|\t\tparsed, err := parser.ParseFile(fset, path, source, 0)\n138|\t\tif err != nil {\n139|\t\t\tt.Fatalf(\"parse %s: %v\", path, err)\n140|\t\t}\n141|\t\tfor _, decl := range parsed.Decls {\n142|\t\t\tfn, ok := decl.(*ast.FuncDecl)\n143|\t\t\tif !ok || fn.Recv != nil || !ast.IsExported(fn.Name.Name) {\n144|\t\t\t\tcontinue\n145|\t\t\t}\n146|\t\t\tfound[fn.Name.Name] = true\n147|\t\t}\n148|\t}\n149|\tfor name := range want {\n150|\t\tif !found[name] {\n151|\t\t\tt.Errorf(\"exported API misses %s\", name)\n152|\t\t}\n153|\t}\n154|\tfor name := range found {\n155|\t\tif !want[name] {\n156|\t\t\tt.Errorf(\"exported API carries unexpected %s: extend the census before shipping it\", name)\n157|\t\t}\n158|\t}\n159|}\n160|\n161|// TestOwnerRowCensusIsEmpty pins that no exported entry carries a\n162|// fidelity/plan row in its parameters: the shapes reference those\n163|// owners by digest only.\n164|func TestOwnerRowCensusIsEmpty(t *testing.T) {\n165|\tvar carrying []string\n166|\tfor name, entry := range exportedEntries() {\n167|\t\ttyp := reflect.TypeOf(entry)\n168|\t\tfor i := 0; i < typ.NumIn(); i++ {\n169|\t\t\tif reflectCarriesOwnerRow(typ.In(i), map[reflect.Type]bool{}) {\n170|\t\t\t\tcarrying = append(carrying, name)\n171|\t\t\t\tbreak\n172|\t\t\t}\n173|\t\t}\n174|\t}\n175|\tsort.Strings(carrying)\n176|\tif len(carrying) != 0 {\n177|\t\tt.Fatalf(\"entries carrying fidelity/plan rows = %v, want empty: they must call the owner validators\", carrying)\n178|\t}\n179|\tt.Log(\"owner-row census: 8 entries, 0 carrying (references are digests)\")\n180|}\n181|\n182|// entryCalls collects the selector calls (package.Function) made by\n183|// one named function across the package production files.\n184|func entryCalls(t *testing.T, dir, function string) map[string]bool {\n185|\tt.Helper()\n186|\tcalls := map[string]bool{}\n187|\tfiles, err := filepath.Glob(filepath.Join(dir, \"*.go\"))\n188|\tif err != nil {\n189|\t\tt.Fatalf(\"glob: %v\", err)\n190|\t}\n191|\tfor _, path := range files {\n192|\t\tif len(path) >= 8 && path[len(path)-8:] == \"_test.go\" {\n193|\t\t\tcontinue\n194|\t\t}\n195|\t\tif len(filepath.Base(path)) >= 6 && filepath.Base(path)[:6] == \"plant_\" {\n196|\t\t\tcontinue\n197|\t\t}\n198|\t\tsource, err := os.ReadFile(path)\n199|\t\tif err != nil {\n200|\t\t\tt.Fatalf(\"read %s: %v\", path, err)\n201|\t\t}\n202|\t\tfset := token.NewFileSet()\n203|\t\tparsed, err := parser.ParseFile(fset, path, source, 0)\n204|\t\tif err != nil {\n205|\t\t\tt.Fatalf(\"parse %s: %v\", path, err)\n206|\t\t}\n207|\t\tfor _, decl := range parsed.Decls {\n208|\t\t\tfn, ok := decl.(*ast.FuncDecl)\n209|\t\t\tif !ok || fn.Name.Name != function {\n210|\t\t\t\tcontinue\n211|\t\t\t}\n212|\t\t\tast.Inspect(fn.Body, func(node ast.Node) bool {\n213|\t\t\t\tcall, ok := node.(*ast.CallExpr)\n214|\t\t\t\tif !ok {\n215|\t\t\t\t\treturn true\n216|\t\t\t\t}\n217|\t\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n218|\t\t\t\tif !ok {\n219|\t\t\t\t\treturn true\n220|\t\t\t\t}\n221|\t\t\t\tpkg, ok := selector.X.(*ast.Ident)\n222|\t\t\t\tif !ok {\n223|\t\t\t\t\treturn true\n224|\t\t\t\t}\n225|\t\t\t\tcalls[pkg.Name+\".\"+selector.Sel.Name] = true\n226|\t\t\t\treturn true\n227|\t\t\t})\n228|\t\t}\n229|\t}\n230|\treturn calls\n231|}\n232|\n233|// callGraphReachability expands one function through same-package\n234|// calls so the pin covers entries that reach the owner through a\n235|// shared build helper.\n236|func callGraphReachability(t *testing.T, dir, function string, depth int) map[string]bool {\n237|\tt.Helper()\n238|\treached := map[string]bool{}\n239|\tvar visit func(name string, remaining int)\n240|\tvisit = func(name string, remaining int) {\n241|\t\tif remaining < 0 {\n242|\t\t\treturn\n243|\t\t}\n244|\t\tfor call := range entryCalls(t, dir, name) {\n245|\t\t\treached[call] = true\n246|\t\t\tif dot := indexByte(call, '.'); dot >= 0 {\n247|\t\t\t\thead := call[:dot]\n248|\t\t\t\t_ = head\n249|\t\t\t}\n250|\t\t}\n251|\t\t// Same-package callees surface as bare identifiers, not\n252|\t\t// selectors; collect them with a second pass.\n253|\t\tfor _, callee := range localCallees(t, dir, name) {\n254|\t\t\tif !reached[\"local.\"+callee] {\n255|\t\t\t\treached[\"local.\"+callee] = true\n256|\t\t\t\tvisit(callee, remaining-1)\n257|\t\t\t}\n258|\t\t}\n259|\t}\n260|\tvisit(function, depth)\n261|\treturn reached\n262|}\n263|\n264|func indexByte(value string, char byte) int {\n265|\tfor i := 0; i < len(value); i++ {\n266|\t\tif value[i] == char {\n267|\t\t\treturn i\n268|\t\t}\n269|\t}\n270|\treturn -1\n271|}\n272|\n273|// localCallees lists the same-package functions one function calls.\n274|func localCallees(t *testing.T, dir, function string) []string {\n275|\tt.Helper()\n276|\tvar callees []string\n277|\tseen := map[string]bool{}\n278|\tfiles, err := filepath.Glob(filepath.Join(dir, \"*.go\"))\n279|\tif err != nil {\n280|\t\tt.Fatalf(\"glob: %v\", err)\n281|\t}\n282|\tfor _, path := range files {\n283|\t\tif len(path) >= 8 && path[len(path)-8:] == \"_test.go\" {\n284|\t\t\tcontinue\n285|\t\t}\n286|\t\tsource, err := os.ReadFile(path)\n287|\t\tif err != nil {\n288|\t\t\tt.Fatalf(\"read %s: %v\", path, err)\n289|\t\t}\n290|\t\tfset := token.NewFileSet()\n291|\t\tparsed, err := parser.ParseFile(fset, path, source, 0)\n292|\t\tif err != nil {\n293|\t\t\tt.Fatalf(\"parse %s: %v\", path, err)\n294|\t\t}\n295|\t\tfor _, decl := range parsed.Decls {\n296|\t\t\tfn, ok := decl.(*ast.FuncDecl)\n297|\t\t\tif !ok || fn.Name.Name != function || fn.Body == nil {\n298|\t\t\t\tcontinue\n299|\t\t\t}\n300|\t\t\tast.Inspect(fn.Body, func(node ast.Node) bool {\n301|\t\t\t\tcall, ok := node.(*ast.CallExpr)\n302|\t\t\t\tif !ok {\n303|\t\t\t\t\treturn true\n304|\t\t\t\t}\n305|\t\t\t\tident, ok := call.Fun.(*ast.Ident)\n306|\t\t\t\tif !ok {\n307|\t\t\t\t\treturn true\n308|\t\t\t\t}\n309|\t\t\t\tif !seen[ident.Name] {\n310|\t\t\t\t\tseen[ident.Name] = true\n311|\t\t\t\t\tcallees = append(callees, ident.Name)\n312|\t\t\t\t}\n313|\t\t\t\treturn true\n314|\t\t\t})\n315|\t\t}\n316|\t}\n317|\treturn callees\n318|}\n319|\n320|func packageDir(t *testing.T) string {\n321|\tt.Helper()\n322|\t_, file, _, ok := runtime.Caller(0)\n323|\tif !ok {\n324|\t\tt.Fatal(\"runtime.Caller failed\")\n325|\t}\n326|\treturn filepath.Dir(file)\n327|}\n328|\n329|// TestOwnerReachability pins that every entry carrying owner-shaped\n330|// data reaches the landed owner decoder on the static call graph:\n331|// tuples through sessadapter.DecodeTuple, bindings through\n332|// clonebundle.DecodeWorkspaceBinding, findings through\n333|// sessadapter.DecodeFindings, identities through\n334|// clonebundle.OmitSelfDigest, extensions through\n335|// clonebundle.CheckExtensionsClosed/EncodeExtensions.\n336|func TestOwnerReachability(t *testing.T) {\n337|\tdir := packageDir(t)\n338|\twant := map[string][]string{\n339|\t\t\"BuildReadBackEvidenceManifest\":  {\"sessadapter.DecodeTuple\", \"clonebundle.DecodeWorkspaceBinding\", \"clonebundle.EncodeExtensions\", \"scalar.SHA256Digest\"},\n340|\t\t\"DecodeReadBackEvidenceManifest\": {\"sessadapter.DecodeTuple\", \"clonebundle.DecodeWorkspaceBinding\", \"clonebundle.OmitSelfDigest\"},\n341|\t\t\"BuildValidationReport\":          {\"sessadapter.DecodeTuple\", \"sessadapter.DecodeFindings\", \"clonebundle.EncodeExtensions\", \"scalar.SHA256Digest\"},\n342|\t\t\"DecodeValidationReport\":         {\"sessadapter.DecodeTuple\", \"sessadapter.DecodeFindings\", \"clonebundle.OmitSelfDigest\"},\n343|\t}\n344|\tfor entry, owners := range want {\n345|\t\treached := callGraphReachability(t, dir, entry, 6)\n346|\t\tfor _, owner := range owners {\n347|\t\t\tif !reached[owner] {\n348|\t\t\t\tt.Errorf(\"entry %s does not reach %s on the static call graph\", entry, owner)\n349|\t\t\t}\n350|\t\t}\n351|\t}\n352|\t// The shared gates are reached by BOTH sibling entries: a rule\n353|\t// pinned at one entry only would leave the other unmeasured.\n354|\tfor _, gate := range []struct {\n355|\t\tentries []string\n356|\t\tcallee  string\n357|\t}{\n358|\t\t{[]string{\"BuildReadBackEvidenceManifest\", \"DecodeReadBackEvidenceManifest\"}, \"checkNativeIdentityMatch\"},\n359|\t\t{[]string{\"BuildReadBackEvidenceManifest\", \"DecodeReadBackEvidenceManifest\"}, \"checkEvidenceOrder\"},\n360|\t\t{[]string{\"BuildValidationReport\", \"DecodeValidationReport\"}, \"checkValidAgreement\"},\n361|\t} {\n362|\t\tfor _, entry := range gate.entries {\n363|\t\t\treached := callGraphReachability(t, dir, entry, 6)\n364|\t\t\tif !reached[\"local.\"+gate.callee] {\n365|\t\t\t\tt.Errorf(\"entry %s does not reach shared gate %s\", entry, gate.callee)\n366|\t\t\t}\n367|\t\t}\n368|\t}\n369|}\n370|\n371|// TestNoOwnerImports pins that production files import neither\n372|// internal/clonefidelity nor internal/cloneplan: with no row-shaped\n373|// data crossing the entries, any import would be a forked rule.\n374|func TestNoOwnerImports(t *testing.T) {\n375|\tdir := packageDir(t)\n376|\tfiles, err := filepath.Glob(filepath.Join(dir, \"*.go\"))\n377|\tif err != nil {\n378|\t\tt.Fatalf(\"glob: %v\", err)\n379|\t}\n380|\tfor _, path := range files {\n381|\t\tif len(path) >= 8 && path[len(path)-8:] == \"_test.go\" {\n382|\t\t\tcontinue\n383|\t\t}\n384|\t\tsource, err := os.ReadFile(path)\n385|\t\tif err != nil {\n386|\t\t\tt.Fatalf(\"read %s: %v\", path, err)\n387|\t\t}\n388|\t\tfset := token.NewFileSet()\n389|\t\tparsed, err := parser.ParseFile(fset, path, source, 0)\n390|\t\tif err != nil {\n391|\t\t\tt.Fatalf(\"parse %s: %v\", path, err)\n392|\t\t}\n393|\t\tfor _, spec := range parsed.Imports {\n394|\t\t\timported := spec.Path.Value\n395|\t\t\tif imported == `\"github.com/relux-works/agent-session-manager/internal/clonefidelity\"` ||\n396|\t\t\t\timported == `\"github.com/relux-works/agent-session-manager/internal/cloneplan\"` {\n397|\t\t\t\tt.Errorf(\"%s imports %s: entries carry no rows, so the import is a fork\", path, imported)\n398|\t\t\t}\n399|\t\t}\n400|\t}\n401|}","final_result":true}}}
