{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c779","stream":{"kind":"session","id":"01a0d474-3d76-7560-9284-b023a445b4ff"},"sequence":535,"recorded_at":1780531400001065,"record_type":"event","durability":"durable","causation_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","run_stream":{"kind":"run","id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27"},"call_id":"call_01a0d476b3a07378b9d1891f8a2bef99","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/clonereadback/oracle_test.go`.\n1|package clonereadback_test\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|\n7|\tclonereadback \"github.com/relux-works/agent-session-manager/internal/clonereadback\"\n8|)\n9|\n10|// This file proves the semantic gates by whole-domain oracles\n11|// written from the pinned text, never from the implementation: the\n12|// valid rule over every combination of check outcomes, the mode\n13|// vocabulary over its closed set and neighbors, and the native-ID\n14|// equality over equal/unequal pairs.\n15|\n16|// oracleChecks renders the seven check booleans for one combination\n17|// index: bit 0 is staged structural, 1 live structural, 2 semantic\n18|// marker, 3 identity, 4 workspace binding, 5 resume surface, 6\n19|// source generation. Every check is always applicable in this\n20|// schema — the report carries no nullable checks — so the oracle\n21|// enumerates outcomes with applicability fixed, and the wrong-type\n22|// census pins that a null check is a wrong type, never an\n23|// inapplicable one.\n24|func oracleChecks(combo int) (clonereadback.ValidationReportInput, bool) {\n25|\tinput := validReportInput()\n26|\tinput.StagedStructuralValid = combo&1 != 0\n27|\tinput.LiveStructuralValid = combo&2 != 0\n28|\tinput.SemanticMarkerValid = combo&4 != 0\n29|\tinput.IdentityValid = combo&8 != 0\n30|\tinput.WorkspaceBindingValid = combo&16 != 0\n31|\tinput.ResumeSurfaceValid = combo&32 != 0\n32|\tinput.SourceGenerationRevalidated = combo&64 != 0\n33|\treturn input, combo == 127\n34|}\n35|\n36|// TestValidWholeDomainOracle enumerates every combination of the\n37|// seven check outcomes (128) by native-ID equality (2) by finding\n38|// class (none, info, warning, error: 4): 1024 combinations. At the\n39|// production Build entry the decided valid bit seals and the\n40|// flipped bit refuses; at the production Decode entry the sealed\n41|// document decodes and the flipped-bit document (under a\n42|// recomputed independent id) refuses.\n43|func TestValidWholeDomainOracle(t *testing.T) {\n44|\tfindingClasses := [][]string{nil, {\"info\"}, {\"warning\"}, {\"info\", \"warning\"}, {\"error\"}, {\"info\", \"error\"}}\n45|\tchecked := 0\n46|\tfor combo := 0; combo < 128; combo++ {\n47|\t\tfor _, idsEqual := range []bool{true, false} {\n48|\t\t\tfor _, severities := range findingClasses {\n49|\t\t\t\tinput, allTrue := oracleChecks(combo)\n50|\t\t\t\tif !idsEqual {\n51|\t\t\t\t\tinput.ObservedTargetNativeSession = \"a-different-native-session\"\n52|\t\t\t\t}\n53|\t\t\t\tinput.Findings = fixtureFindings(severities...)\n54|\t\t\t\twant := allTrue && idsEqual && !hasErrorSeverity(severities)\n55|\t\t\t\tinput.Valid = want\n56|\t\t\t\tsealed, err := clonereadback.BuildValidationReport(input)\n57|\t\t\t\tif err != nil {\n58|\t\t\t\t\tt.Fatalf(\"combo=%d idsEqual=%v findings=%v: decided valid=%v refused: %v\", combo, idsEqual, severities, want, err)\n59|\t\t\t\t}\n60|\t\t\t\tif _, err := clonereadback.DecodeValidationReport(sealed); err != nil {\n61|\t\t\t\t\tt.Fatalf(\"combo=%d idsEqual=%v findings=%v: sealed doc refuses: %v\", combo, idsEqual, severities, err)\n62|\t\t\t\t}\n63|\t\t\t\tinput.Valid = !want\n64|\t\t\t\tif _, err := clonereadback.BuildValidationReport(input); err == nil {\n65|\t\t\t\t\tt.Fatalf(\"combo=%d idsEqual=%v findings=%v: flipped valid=%v admitted at Build\", combo, idsEqual, severities, !want)\n66|\t\t\t\t} else if !strings.Contains(err.Error(), \"valid disagrees with the check outcome\") {\n67|\t\t\t\t\tt.Fatalf(\"combo=%d: flipped-bit error %q misses the literal\", combo, err.Error())\n68|\t\t\t\t}\n69|\t\t\t\tdocument := decodeDocument(t, sealed)\n70|\t\t\t\tdocument[\"valid\"] = !want\n71|\t\t\t\tdocument[\"validation_report_id\"] = independentSelfDigest(t, marshalDocument(t, document), \"validation_report_id\")\n72|\t\t\t\tif _, err := clonereadback.DecodeValidationReport(marshalDocument(t, document)); err == nil {\n73|\t\t\t\t\tt.Fatalf(\"combo=%d idsEqual=%v findings=%v: flipped valid=%v admitted at Decode\", combo, idsEqual, severities, !want)\n74|\t\t\t\t} else if !strings.Contains(err.Error(), \"valid disagrees with the check outcome\") {\n75|\t\t\t\t\tt.Fatalf(\"combo=%d: flipped-bit decode error %q misses the literal\", combo, err.Error())\n76|\t\t\t\t}\n77|\t\t\t\tchecked++\n78|\t\t\t}\n79|\t\t}\n80|\t}\n81|\tt.Logf(\"valid oracle: %d combinations driven through Build+Decode\", checked)\n82|}\n83|\n84|func hasErrorSeverity(severities []string) bool {\n85|\tfor _, severity := range severities {\n86|\t\tif severity == \"error\" {\n87|\t\t\treturn true\n88|\t\t}\n89|\t}\n90|\treturn false\n91|}\n92|\n93|// TestNativeIdentityEqualityOracle pins \"equal expected and observed\n94|// native Session IDs\" at both read-back entries and both report\n95|// entries: equal pairs seal, and unequal pairs — including the\n96|// same-length neighbor the length-comparing narrowing would admit —\n97|// refuse with the literal.\n98|func TestNativeIdentityEqualityOracle(t *testing.T) {\n99|\tpairs := [][2]string{\n100|\t\t{\"session-a\", \"session-a\"},\n101|\t\t{\"session-a\", \"session-b\"},\n102|\t\t{\"session-a\", \"session-aa\"},\n103|\t\t{\"x\", \"y\"},\n104|\t\t{\"\", \"\"},\n105|\t}\n106|\tfor _, pair := range pairs {\n107|\t\twant := pair[0] == pair[1] && pair[0] != \"\"\n108|\t\tinput := validReadBackInput()\n109|\t\tinput.ExpectedTargetNativeSession = pair[0]\n110|\t\tinput.ObservedTargetNativeSession = pair[1]\n111|\t\t_, err := clonereadback.BuildReadBackEvidenceManifest(input)\n112|\t\tif want && err != nil {\n113|\t\t\tt.Fatalf(\"readback pair %q refused: %v\", pair, err)\n114|\t\t}\n115|\t\tif !want && err == nil {\n116|\t\t\tt.Fatalf(\"readback pair %q admitted at Build\", pair)\n117|\t\t}\n118|\t\t// The report decides valid from the equality: an unequal\n119|\t\t// pair seals with valid=false and refuses with\n120|\t\t// valid=true; an equal pair seals with valid=true.\n121|\t\t// Empty pairs refuse on bounds either way.\n122|\t\trinput := validReportInput()\n123|\t\trinput.ExpectedTargetNativeSession = pair[0]\n124|\t\trinput.ObservedTargetNativeSession = pair[1]\n125|\t\tif pair[0] == \"\" {\n126|\t\t\trinput.Valid = false\n127|\t\t\tif _, err := clonereadback.BuildValidationReport(rinput); err == nil {\n128|\t\t\t\tt.Fatalf(\"report pair %q admitted at Build\", pair)\n129|\t\t\t}\n130|\t\t\tcontinue\n131|\t\t}\n132|\t\trinput.Valid = false\n133|\t\tif _, err := clonereadback.BuildValidationReport(rinput); pair[0] == pair[1] {\n134|\t\t\tif err == nil {\n135|\t\t\t\tt.Fatalf(\"report equal pair %q with valid=false admitted at Build\", pair)\n136|\t\t\t}\n137|\t\t} else if err != nil {\n138|\t\t\tt.Fatalf(\"report unequal pair %q with valid=false refused: %v\", pair, err)\n139|\t\t}\n140|\t\trinput.Valid = true\n141|\t\tif _, err := clonereadback.BuildValidationReport(rinput); pair[0] == pair[1] {\n142|\t\t\tif err != nil {\n143|\t\t\t\tt.Fatalf(\"report equal pair %q with valid=true refused: %v\", pair, err)\n144|\t\t\t}\n145|\t\t} else if err == nil {\n146|\t\t\tt.Fatalf(\"report unequal pair %q with valid=true admitted at Build\", pair)\n147|\t\t}\n148|\t}\n149|\t// The decode-side equality gate refuses a doc whose IDs differ\n150|\t// even under a consistent resealed id: the gate reads members,\n151|\t// not bytes.\n152|\tsealed := mustBuildReadBack(t, validReadBackInput())\n153|\tdocument := decodeDocument(t, sealed)\n154|\tdocument[\"observed_target_native_session_id\"] = \"a-different-native-session\"\n155|\tdocument[\"read_back_evidence_manifest_id\"] = independentSelfDigest(t, marshalDocument(t, document), \"read_back_evidence_manifest_id\")\n156|\t_, err := clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document))\n157|\trequireRefusal(t, err, \"read-back evidence manifest\", \"expected and observed native Session IDs differ\")\n158|\trsealed := mustBuildReport(t, validReportInput())\n159|\trdocument := decodeDocument(t, rsealed)\n160|\trdocument[\"observed_target_native_session_id\"] = \"a-different-native-session\"\n161|\trdocument[\"valid\"] = false\n162|\trdocument[\"validation_report_id\"] = independentSelfDigest(t, marshalDocument(t, rdocument), \"validation_report_id\")\n163|\treport, err := clonereadback.DecodeValidationReport(marshalDocument(t, rdocument))\n164|\tif err != nil {\n165|\t\tt.Fatalf(\"differing IDs with valid=false refused: %v\", err)\n166|\t}\n167|\tif report.Valid {\n168|\t\tt.Fatal(\"differing IDs decoded valid=true\")\n169|\t}\n170|}\n171|\n172|// TestModeVocabularyOracle pins mode:staged|live at both read-back\n173|// entries: the two closed modes seal and every neighbor — case,\n174|// whitespace, empty, archived, both, and invalid UTF-8 — refuses\n175|// with the literal.\n176|func TestModeVocabularyOracle(t *testing.T) {\n177|\tfor _, mode := range []string{\"staged\", \"live\"} {\n178|\t\tinput := validReadBackInput()\n179|\t\tinput.Mode = mode\n180|\t\tmustBuildReadBack(t, input)\n181|\t\tif !clonereadback.ValidReadBackMode(mode) {\n182|\t\t\tt.Fatalf(\"ValidReadBackMode(%q) = false\", mode)\n183|\t\t}\n184|\t}\n185|\tneighbors := []struct {\n186|\t\tmode    string\n187|\t\tliteral string\n188|\t}{\n189|\t\t{\"\", \"mode is outside staged|live\"}, {\" \", \"mode is outside staged|live\"},\n190|\t\t{\"staged \", \"mode is outside staged|live\"}, {\" staged\", \"mode is outside staged|live\"},\n191|\t\t{\"STAGED\", \"mode is outside staged|live\"}, {\"Staged\", \"mode is outside staged|live\"},\n192|\t\t{\"live \", \"mode is outside staged|live\"}, {\"LIVE\", \"mode is outside staged|live\"},\n193|\t\t{\"archived\", \"mode is outside staged|live\"}, {\"both\", \"mode is outside staged|live\"},\n194|\t\t{\"staged,live\", \"mode is outside staged|live\"}, {\"null\", \"mode is outside staged|live\"},\n195|\t\t{\"dormant\", \"mode is outside staged|live\"}, {\"validated\", \"mode is outside staged|live\"},\n196|\t\t{\"stagged\", \"mode is outside staged|live\"}, {\"liv\", \"mode is outside staged|live\"},\n197|\t\t{\"stage\", \"mode is outside staged|live\"},\n198|\t\t{string([]byte{0xff}), \"mode is not valid UTF-8\"}, {\"staged\\xff\", \"mode is not valid UTF-8\"},\n199|\t}\n200|\tfor _, probe := range neighbors {\n201|\t\tinput := validReadBackInput()\n202|\t\tinput.Mode = probe.mode\n203|\t\t_, err := clonereadback.BuildReadBackEvidenceManifest(input)\n204|\t\trequireRefusal(t, err, \"read-back evidence manifest\", probe.literal)\n205|\t\tif clonereadback.ValidReadBackMode(probe.mode) {\n206|\t\t\tt.Fatalf(\"ValidReadBackMode(%q) = true\", probe.mode)\n207|\t\t}\n208|\t}\n209|\tsealed := mustBuildReadBack(t, validReadBackInput())\n210|\tfor _, probe := range neighbors {\n211|\t\tdocument := decodeDocument(t, sealed)\n212|\t\tif probe.mode == string([]byte{0xff}) || probe.mode == \"staged\\xff\" {\n213|\t\t\tcontinue // unmarshalable bytes cannot ride a JSON document; the Build row above pins them.\n214|\t\t}\n215|\t\tdocument[\"mode\"] = probe.mode\n216|\t\t_, err := clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document))\n217|\t\trequireRefusal(t, err, \"read-back evidence manifest\", \"mode is outside staged|live\")\n218|\t}\n219|\tif modes := clonereadback.ReadBackModes(); len(modes) != 2 || modes[0] != \"staged\" || modes[1] != \"live\" {\n220|\t\tt.Fatalf(\"ReadBackModes() = %q, want [staged live]\", modes)\n221|\t}\n222|}\n223|\n224|// TestEvidenceKindVocabularyOracle pins\n225|// evidence_kind:native_sample|parser_trace|marker_observation at\n226|// both read-back entries: the three closed kinds seal and every\n227|// neighbor refuses with the literal.\n228|func TestEvidenceKindVocabularyOracle(t *testing.T) {\n229|\tfor _, kind := range []string{\"native_sample\", \"parser_trace\", \"marker_observation\"} {\n230|\t\tinput := validReadBackInput()\n231|\t\tinput.EvidenceObjects = []clonereadback.EvidenceObjectInput{validEvidenceInput(kind, kind)}\n232|\t\tmustBuildReadBack(t, input)\n233|\t\tif !clonereadback.ValidEvidenceKind(kind) {\n234|\t\t\tt.Fatalf(\"ValidEvidenceKind(%q) = false\", kind)\n235|\t\t}\n236|\t}\n237|\tneighbors := []struct {\n238|\t\tkind    string\n239|\t\tliteral string\n240|\t}{\n241|\t\t{\"\", \"evidence_kind is outside native_sample|parser_trace|marker_observation\"},\n242|\t\t{\"native\", \"evidence_kind is outside native_sample|parser_trace|marker_observation\"},\n243|\t\t{\"sample\", \"evidence_kind is outside native_sample|parser_trace|marker_observation\"},\n244|\t\t{\"NATIVE_SAMPLE\", \"evidence_kind is outside native_sample|parser_trace|marker_observation\"},\n245|\t\t{\"Native_Sample\", \"evidence_kind is outside native_sample|parser_trace|marker_observation\"},\n246|\t\t{\"parser\", \"evidence_kind is outside native_sample|parser_trace|marker_observation\"},\n247|\t\t{\"trace\", \"evidence_kind is outside native_sample|parser_trace|marker_observation\"},\n248|\t\t{\"marker\", \"evidence_kind is outside native_sample|parser_trace|marker_observation\"},\n249|\t\t{\"observation\", \"evidence_kind is outside native_sample|parser_trace|marker_observation\"},\n250|\t\t{\"native-sample\", \"evidence_kind is outside native_sample|parser_trace|marker_observation\"},\n251|\t\t{\"blob\", \"evidence_kind is outside native_sample|parser_trace|marker_observation\"},\n252|\t\t{\"evidence\", \"evidence_kind is outside native_sample|parser_trace|marker_observation\"},\n253|\t\t{\"null\", \"evidence_kind is outside native_sample|parser_trace|marker_observation\"},\n254|\t\t{string([]byte{0xff}), \"evidence_kind is not valid UTF-8\"},\n255|\t}\n256|\tfor _, probe := range neighbors {\n257|\t\tinput := validReadBackInput()\n258|\t\tinput.EvidenceObjects = []clonereadback.EvidenceObjectInput{validEvidenceInput(probe.kind, \"neighbor\")}\n259|\t\t_, err := clonereadback.BuildReadBackEvidenceManifest(input)\n260|\t\trequireRefusal(t, err, \"evidence object\", probe.literal)\n261|\t\tif clonereadback.ValidEvidenceKind(probe.kind) {\n262|\t\t\tt.Fatalf(\"ValidEvidenceKind(%q) = true\", probe.kind)\n263|\t\t}\n264|\t}\n265|\tsealed := mustBuildReadBack(t, validReadBackInput())\n266|\tfor _, probe := range neighbors {\n267|\t\tif probe.kind == string([]byte{0xff}) {\n268|\t\t\tcontinue\n269|\t\t}\n270|\t\tdocument := decodeDocument(t, sealed)\n271|\t\tdocumentAt(t, document, \"evidence_objects\", 0)[\"evidence_kind\"] = probe.kind\n272|\t\t_, err := clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document))\n273|\t\trequireRefusal(t, err, \"evidence object\", \"evidence_kind is outside native_sample|parser_trace|marker_observation\")\n274|\t}\n275|\tif kinds := clonereadback.EvidenceKinds(); len(kinds) != 3 || kinds[0] != \"native_sample\" || kinds[1] != \"parser_trace\" || kinds[2] != \"marker_observation\" {\n276|\t\tt.Fatalf(\"EvidenceKinds() = %q\", kinds)\n277|\t}\n278|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c77b","stream":{"kind":"session","id":"01a0d474-3d76-7560-9284-b023a445b4ff"},"sequence":536,"recorded_at":1780531400001067,"record_type":"event","durability":"durable","causation_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","run_stream":{"kind":"run","id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27"},"call_id":"call_01a0d476b56e720c884a79914ffbfe76","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/clonereadback/identity_test.go`.\n1|package clonereadback_test\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"encoding/json\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/gowebpki/jcs\"\n10|\n11|\tclonereadback \"github.com/relux-works/agent-session-manager/internal/clonereadback\"\n12|)\n13|\n14|// independentSelfDigest recomputes the omit-self identity without\n15|// touching production: plain marshal, JCS transform, SHA-256. The\n16|// canonical-bytes path is shared infrastructure (JCS itself); the\n17|// omission choice and digest comparison are independent.\n18|func independentSelfDigest(t *testing.T, sealed []byte, self string) string {\n19|\tt.Helper()\n20|\tvar document map[string]any\n21|\tif err := json.Unmarshal(sealed, &document); err != nil {\n22|\t\tt.Fatalf(\"unmarshal sealed: %v\", err)\n23|\t}\n24|\tdelete(document, self)\n25|\tplain, err := json.Marshal(document)\n26|\tif err != nil {\n27|\t\tt.Fatalf(\"marshal omitted: %v\", err)\n28|\t}\n29|\tcanonical, err := jcs.Transform(plain)\n30|\tif err != nil {\n31|\t\tt.Fatalf(\"JCS transform: %v\", err)\n32|\t}\n33|\tsum := sha256.Sum256(canonical)\n34|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n35|}\n36|\n37|// TestReadBackIdentityIndependent pins that\n38|// read_back_evidence_manifest_id is the JCS digest with only itself\n39|// omitted: the independent recompute agrees, omitting a different\n40|// member disagrees, and a tampered claim refuses.\n41|func TestReadBackIdentityIndependent(t *testing.T) {\n42|\tsealed := mustBuildReadBack(t, validReadBackInput())\n43|\tdocument := decodeDocument(t, sealed)\n44|\tclaimed, ok := document[\"read_back_evidence_manifest_id\"].(string)\n45|\tif !ok {\n46|\t\tt.Fatal(\"read_back_evidence_manifest_id is not a string\")\n47|\t}\n48|\tif got := independentSelfDigest(t, sealed, \"read_back_evidence_manifest_id\"); got != claimed {\n49|\t\tt.Fatalf(\"independent digest = %s, sealed claim = %s\", got, claimed)\n50|\t}\n51|\tif got := independentSelfDigest(t, sealed, \"mode\"); got == claimed {\n52|\t\tt.Fatal(\"omitting mode instead of the id agrees: the omission rule is not pinned\")\n53|\t}\n54|\tdocument[\"read_back_evidence_manifest_id\"] = fixtureDigest(\"tampered-claim\")\n55|\t_, err := clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document))\n56|\trequireRefusal(t, err, \"read_back_evidence_manifest_id\", \"does not match omit-self digest\")\n57|\tdocument = decodeDocument(t, sealed)\n58|\tdocument[\"read_back_evidence_manifest_id\"] = \"not-a-digest\"\n59|\t_, err = clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document))\n60|\trequireRefusal(t, err, \"read_back_evidence_manifest_id\", \"is not a digest\")\n61|}\n62|\n63|// TestReportIdentityIndependent pins that validation_report_id is\n64|// the JCS digest with only itself omitted.\n65|func TestReportIdentityIndependent(t *testing.T) {\n66|\tsealed := mustBuildReport(t, validReportInput())\n67|\tdocument := decodeDocument(t, sealed)\n68|\tclaimed, ok := document[\"validation_report_id\"].(string)\n69|\tif !ok {\n70|\t\tt.Fatal(\"validation_report_id is not a string\")\n71|\t}\n72|\tif got := independentSelfDigest(t, sealed, \"validation_report_id\"); got != claimed {\n73|\t\tt.Fatalf(\"independent digest = %s, sealed claim = %s\", got, claimed)\n74|\t}\n75|\tif got := independentSelfDigest(t, sealed, \"valid\"); got == claimed {\n76|\t\tt.Fatal(\"omitting valid instead of the id agrees: the omission rule is not pinned\")\n77|\t}\n78|\tdocument[\"validation_report_id\"] = fixtureDigest(\"tampered-claim\")\n79|\t_, err := clonereadback.DecodeValidationReport(marshalDocument(t, document))\n80|\trequireRefusal(t, err, \"validation_report_id\", \"does not match omit-self digest\")\n81|\tdocument = decodeDocument(t, sealed)\n82|\tdocument[\"validation_report_id\"] = \"not-a-digest\"\n83|\t_, err = clonereadback.DecodeValidationReport(marshalDocument(t, document))\n84|\trequireRefusal(t, err, \"validation_report_id\", \"is not a digest\")\n85|}\n86|\n87|// TestModeRelabelRefused pins \"Modes cannot be relabeled\"\n88|// (SPEC v0.7.0 §13.14.2 line 10580 and line 10754): flipping the\n89|// mode under a sealed id refuses as an identity mismatch at the\n90|// production decode entry; the mode binds the identity, so the\n91|// relabeled bytes are a different document, never the same\n92|// manifest.\n93|func TestModeRelabelRefused(t *testing.T) {\n94|\tfor _, mode := range []string{\"staged\", \"live\"} {\n95|\t\tinput := validReadBackInput()\n96|\t\tinput.Mode = mode\n97|\t\tsealed := mustBuildReadBack(t, input)\n98|\t\tdocument := decodeDocument(t, sealed)\n99|\t\tflipped := \"live\"\n100|\t\tif mode == \"live\" {\n101|\t\t\tflipped = \"staged\"\n102|\t\t}\n103|\t\tdocument[\"mode\"] = flipped\n104|\t\t_, err := clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document))\n105|\t\trequireRefusal(t, err, \"read_back_evidence_manifest_id\", \"does not match omit-self digest\")\n106|\t}\n107|}\n108|\n109|// TestModeBindsIdentity pins the positive side of the relabel rule:\n110|// the same logical inputs sealed under staged and live carry\n111|// different ids, and resealing the flipped mode under its own\n112|// recomputed id decodes as the other mode — a distinct document,\n113|// never a relabeled one.\n114|func TestModeBindsIdentity(t *testing.T) {\n115|\tstagedInput := validReadBackInput()\n116|\tstagedInput.Mode = \"staged\"\n117|\tliveInput := validReadBackInput()\n118|\tliveInput.Mode = \"live\"\n119|\tstaged := mustBuildReadBack(t, stagedInput)\n120|\tlive := mustBuildReadBack(t, liveInput)\n121|\tstagedDoc := decodeDocument(t, staged)\n122|\tliveDoc := decodeDocument(t, live)\n123|\tif stagedDoc[\"read_back_evidence_manifest_id\"] == liveDoc[\"read_back_evidence_manifest_id\"] {\n124|\t\tt.Fatal(\"staged and live manifests share an id: modes do not bind identity\")\n125|\t}\n126|\trelabeled := decodeDocument(t, staged)\n127|\trelabeled[\"mode\"] = \"live\"\n128|\trelabeled[\"read_back_evidence_manifest_id\"] = independentSelfDigest(t, marshalDocument(t, relabeled), \"read_back_evidence_manifest_id\")\n129|\tmanifest := mustDecodeReadBack(t, marshalDocument(t, relabeled))\n130|\tif manifest.Mode != \"live\" {\n131|\t\tt.Fatalf(\"mode = %q, want live\", manifest.Mode)\n132|\t}\n133|\tif manifest.ManifestID.String() != liveDoc[\"read_back_evidence_manifest_id\"] {\n134|\t\tt.Fatal(\"recomputed relabel id disagrees with the live seal: identity is not a pure function of members\")\n135|\t}\n136|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
