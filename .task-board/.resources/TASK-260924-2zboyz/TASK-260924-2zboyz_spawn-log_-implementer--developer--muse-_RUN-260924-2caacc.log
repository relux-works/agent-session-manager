{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5c1","stream":{"kind":"session","id":"01a0d474-3d76-7560-9284-b023a445b4ff"},"sequence":315,"recorded_at":1780531400000625,"record_type":"event","durability":"durable","causation_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","run_stream":{"kind":"run","id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27"},"task_stream":{"kind":"task","id":"01a0d475-29b1-7443-a8a9-4ec5faa5fb20"},"task_id":"01a0d475-29b1-7443-a8a9-4ec5faa5fb20","event":{"kind":"output","task_id":"01a0d475-29b1-7443-a8a9-4ec5faa5fb20","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/clonereadback/readback.go`.\n1|package clonereadback\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"fmt\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n10|)\n11|\n12|// This file validates and constructs Clone Read-Back Evidence\n13|// Manifest 1.0.0: the closed 15-member manifest Section 13.14.2\n14|// states, binding operation, staged|live mode, plan and projected\n15|// manifest, equal expected/observed native Session IDs, observed\n16|// tuple, parsed count/heads, Workspace Binding, structural digest,\n17|// and sorted evidence blobs. The mode binds the JCS identity, so a\n18|// relabeled mode refuses as an identity mismatch; staged and live\n19|// manifests are distinct documents, never two readings of one.\n20|\n21|const (\n22|\treadBackSchema   = \"urn:ax:schema:clone-read-back-evidence-manifest\"\n23|\treadBackVersion  = \"1.0.0\"\n24|\treadBackSelf     = \"read_back_evidence_manifest_id\"\n25|\tmaxEvidenceRows  = 65536\n26|\tmaxParsedHeadIDs = 1024\n27|)\n28|\n29|var readBackMembers = map[string]bool{\n30|\t\"schema\": true, \"schema_version\": true,\n31|\t\"read_back_evidence_manifest_id\": true, \"operation_id\": true,\n32|\t\"mode\": true, \"projection_plan_id\": true,\n33|\t\"projected_object_manifest_id\":      true,\n34|\t\"expected_target_native_session_id\": true,\n35|\t\"observed_target_native_session_id\": true,\n36|\t\"observed_environment\":              true,\n37|\t\"parsed_event_count\":                true,\n38|\t\"parsed_head_ids\":                   true,\n39|\t\"workspace_binding\":                 true,\n40|\t\"structural_digest\":                 true,\n41|\t\"evidence_objects\":                  true, \"extensions\": true,\n42|}\n43|\n44|var readBackRequired = []string{\n45|\t\"schema\", \"schema_version\",\n46|\t\"read_back_evidence_manifest_id\", \"operation_id\",\n47|\t\"mode\", \"projection_plan_id\",\n48|\t\"projected_object_manifest_id\",\n49|\t\"expected_target_native_session_id\",\n50|\t\"observed_target_native_session_id\",\n51|\t\"observed_environment\",\n52|\t\"parsed_event_count\",\n53|\t\"parsed_head_ids\",\n54|\t\"workspace_binding\",\n55|\t\"structural_digest\",\n56|\t\"evidence_objects\", \"extensions\",\n57|}\n58|\n59|var evidenceMembers = map[string]bool{\n60|\t\"evidence_kind\": true, \"media_type\": true,\n61|\t\"byte_count\": true, \"blob_id\": true,\n62|\t\"blob_descriptor_id\": true,\n63|}\n64|\n65|var evidenceRequired = []string{\n66|\t\"evidence_kind\", \"media_type\",\n67|\t\"byte_count\", \"blob_id\",\n68|\t\"blob_descriptor_id\",\n69|}\n70|\n71|// EvidenceObject is one validated evidence row: the closed kind, a\n72|// media type, a byte count, and the blob pair.\n73|type EvidenceObject struct {\n74|\tEvidenceKind     string\n75|\tMediaType        string\n76|\tByteCount        uint64\n77|\tBlobID           scalar.Digest\n78|\tBlobDescriptorID scalar.Digest\n79|}\n80|\n81|// EvidenceObjectInput is the caller-supplied evidence row candidate\n82|// for Build.\n83|type EvidenceObjectInput struct {\n84|\tEvidenceKind     string\n85|\tMediaType        string\n86|\tByteCount        uint64\n87|\tBlobID           string\n88|\tBlobDescriptorID string\n89|}\n90|\n91|// ReadBackManifest is one validated Clone Read-Back Evidence\n92|// Manifest 1.0.0.\n93|type ReadBackManifest struct {\n94|\tManifestID                  scalar.Digest\n95|\tOperationID                 scalar.UUIDv7\n96|\tMode                        string\n97|\tProjectionPlanID            scalar.Digest\n98|\tProjectedObjectManifestID   scalar.Digest\n99|\tExpectedTargetNativeSession string\n100|\tObservedTargetNativeSession string\n101|\tObservedEnvironment         sessadapter.Tuple\n102|\tParsedEventCount            uint64\n103|\tParsedHeadIDs               []string\n104|\tWorkspaceBinding            clonebundle.WorkspaceBinding\n105|\tStructuralDigest            scalar.Digest\n106|\tEvidenceObjects             []EvidenceObject\n107|}\n108|\n109|// ReadBackManifestInput is the caller-supplied read-back manifest\n110|// candidate for Build. Nested closed shapes (observed tuple,\n111|// workspace binding) arrive as raw JSON and decode through their\n112|// owners; extensions arrive as a Go map and seal through the\n113|// closed-extensions owner.\n114|type ReadBackManifestInput struct {\n115|\tOperationID                 string\n116|\tMode                        string\n117|\tProjectionPlanID            string\n118|\tProjectedObjectManifestID   string\n119|\tExpectedTargetNativeSession string\n120|\tObservedTargetNativeSession string\n121|\tObservedEnvironment         []byte\n122|\tParsedEventCount            uint64\n123|\tParsedHeadIDs               []string\n124|\tWorkspaceBinding            []byte\n125|\tStructuralDigest            string\n126|\tEvidenceObjects             []EvidenceObjectInput\n127|\tExtensions                  map[string]any\n128|}\n129|\n130|// buildEvidenceObject validates one caller-supplied evidence row\n131|// and renders its closed object.\n132|func buildEvidenceObject(input EvidenceObjectInput, index int) (EvidenceObject, map[string]any, error) {\n133|\towner := fmt.Sprintf(\"evidence object[%d]\", index)\n134|\tif !validText(input.EvidenceKind) {\n135|\t\treturn EvidenceObject{}, nil, invalid(\"%s evidence_kind is not valid UTF-8\", owner)\n136|\t}\n137|\tif !ValidEvidenceKind(input.EvidenceKind) {\n138|\t\treturn EvidenceObject{}, nil, invalid(\"%s evidence_kind is outside native_sample|parser_trace|marker_observation\", owner)\n139|\t}\n140|\tif !validText(input.MediaType) {\n141|\t\treturn EvidenceObject{}, nil, invalid(\"%s media_type is not valid UTF-8\", owner)\n142|\t}\n143|\tif length := stringLength(input.MediaType); length < 1 || length > 128 {\n144|\t\treturn EvidenceObject{}, nil, invalid(\"%s media_type is not a string[1..128]\", owner)\n145|\t}\n146|\tif input.ByteCount > maxUint53 {\n147|\t\treturn EvidenceObject{}, nil, invalid(\"%s byte_count exceeds uint53\", owner)\n148|\t}\n149|\tblob, err := scalar.ParseDigest(input.BlobID)\n150|\tif err != nil {\n151|\t\treturn EvidenceObject{}, nil, invalid(\"%s blob_id is not a digest: %v\", owner, err)\n152|\t}\n153|\tdescriptor, err := scalar.ParseDigest(input.BlobDescriptorID)\n154|\tif err != nil {\n155|\t\treturn EvidenceObject{}, nil, invalid(\"%s blob_descriptor_id is not a digest: %v\", owner, err)\n156|\t}\n157|\trow := EvidenceObject{\n158|\t\tEvidenceKind:     input.EvidenceKind,\n159|\t\tMediaType:        input.MediaType,\n160|\t\tByteCount:        input.ByteCount,\n161|\t\tBlobID:           blob,\n162|\t\tBlobDescriptorID: descriptor,\n163|\t}\n164|\tobject := map[string]any{\n165|\t\t\"evidence_kind\":      input.EvidenceKind,\n166|\t\t\"media_type\":         input.MediaType,\n167|\t\t\"byte_count\":         input.ByteCount,\n168|\t\t\"blob_id\":            blob.String(),\n169|\t\t\"blob_descriptor_id\": descriptor.String(),\n170|\t}\n171|\treturn row, object, nil\n172|}\n173|\n174|// decodeEvidenceObject validates one closed EvidenceObject.\n175|func decodeEvidenceObject(raw json.RawMessage, index int) (EvidenceObject, error) {\n176|\towner := \"evidence object\"\n177|\tmembers, fault := decodeStrictObject(raw)\n178|\tif fault != nil {\n179|\t\treturn EvidenceObject{}, invalid(\"%s[%d] %s (%s)\", owner, index, fault.detail, memberField(fault.member))\n180|\t}\n181|\tif name, unknown := unknownMember(members, evidenceMembers); unknown {\n182|\t\treturn EvidenceObject{}, invalid(\"%s[%d] carries unknown member %q\", owner, index, name)\n183|\t}\n184|\tif name, missing := missingMember(members, evidenceRequired); missing {\n185|\t\treturn EvidenceObject{}, invalid(\"%s[%d] misses a required member %q\", owner, index, name)\n186|\t}\n187|\tkind, ok := rawString(members[\"evidence_kind\"])\n188|\tif !ok || !ValidEvidenceKind(kind) {\n189|\t\treturn EvidenceObject{}, invalid(\"%s[%d] evidence_kind is outside native_sample|parser_trace|marker_observation\", owner, index)\n190|\t}\n191|\tmedia, ok := checkStringBounds(members[\"media_type\"], 1, 128)\n192|\tif !ok {\n193|\t\treturn EvidenceObject{}, invalid(\"%s[%d] media_type is not a string[1..128]\", owner, index)\n194|\t}\n195|\tcount, ok := checkUint53Bounds(members[\"byte_count\"], 0, maxUint53)\n196|\tif !ok {\n197|\t\treturn EvidenceObject{}, invalid(\"%s[%d] byte_count is not a uint53\", owner, index)\n198|\t}\n199|\tblob, ok := checkDigest(members[\"blob_id\"])\n200|\tif !ok {\n201|\t\treturn EvidenceObject{}, invalid(\"%s[%d] blob_id is not a digest\", owner, index)\n202|\t}\n203|\tdescriptor, ok := checkDigest(members[\"blob_descriptor_id\"])\n204|\tif !ok {\n205|\t\treturn EvidenceObject{}, invalid(\"%s[%d] blob_descriptor_id is not a digest\", owner, index)\n206|\t}\n207|\treturn EvidenceObject{\n208|\t\tEvidenceKind:     kind,\n209|\t\tMediaType:        media,\n210|\t\tByteCount:        count,\n211|\t\tBlobID:           blob,\n212|\t\tBlobDescriptorID: descriptor,\n213|\t}, nil\n214|}\n215|\n216|// checkEvidenceOrder enforces \"sorted unique by evidence kind/blob\n217|// ID\": the (kind, blob ID) pairs are strictly increasing in\n218|// bytewise string order. Both entries share this gate over the\n219|// sealed row set.\n220|func checkEvidenceOrder(rows []EvidenceObject) error {\n221|\tfor index := 1; index < len(rows); index++ {\n222|\t\tprevious := rows[index-1]\n223|\t\tcurrent := rows[index]\n224|\t\tif current.EvidenceKind < previous.EvidenceKind ||\n225|\t\t\t(current.EvidenceKind == previous.EvidenceKind && current.BlobID.String() <= previous.BlobID.String()) {\n226|\t\t\treturn invalid(\"read-back evidence manifest evidence_objects are not sorted unique by evidence kind/blob ID\")\n227|\t\t}\n228|\t}\n229|\treturn nil\n230|}\n231|\n232|// checkEvidenceCount enforces the evidence cardinality bound\n233|// EvidenceObject[0..65536]. The gate is factored so the exact upper\n234|// edge pins at the gate while row reachability pins at both\n235|// entries.\n236|func checkEvidenceCount(count int) error {\n237|\tif count < 0 || count > maxEvidenceRows {\n238|\t\treturn invalid(\"read-back evidence manifest carries %d evidence_objects, want [0..65536]\", count)\n239|\t}\n240|\treturn nil\n241|}\n242|\n243|// checkNativeIdentityMatch enforces the pinned equality of the two\n244|// native Session IDs: the observed target session is the expected\n245|// one, never a neighbor. Both entries share this gate.\n246|func checkNativeIdentityMatch(expected, observed string) error {\n247|\tif expected != observed {\n248|\t\treturn invalid(\"read-back evidence manifest expected and observed native Session IDs differ\")\n249|\t}\n250|\treturn nil\n251|}\n252|\n253|// BuildReadBackEvidenceManifest constructs one closed Clone\n254|// Read-Back Evidence Manifest 1.0.0 as canonical bytes. Identical\n255|// inputs produce byte-identical outputs. Every closed-shape, mode,\n256|// equality, order, and vocabulary rule is a refusal, never a\n257|// repair.\n258|func BuildReadBackEvidenceManifest(input ReadBackManifestInput) ([]byte, error) {\n259|\t_, object, err := buildReadBackManifest(input)\n260|\tif err != nil {\n261|\t\treturn nil, err\n262|\t}\n263|\tomitted, err := canonicalizeObject(object)\n264|\tif err != nil {\n265|\t\treturn nil, err\n266|\t}\n267|\tmanifestID := scalar.SHA256Digest(omitted)\n268|\tobject[readBackSelf] = manifestID.String()\n269|\treturn canonicalizeObject(object)\n270|}\n271|\n272|func buildReadBackManifest(input ReadBackManifestInput) (ReadBackManifest, map[string]any, error) {\n273|\towner := \"read-back evidence manifest\"\n274|\toperation, err := scalar.ParseUUIDv7(input.OperationID)\n275|\tif err != nil {\n276|\t\treturn ReadBackManifest{}, nil, invalid(\"%s operation_id is not a UUIDv7: %v\", owner, err)\n277|\t}\n278|\tif !validText(input.Mode) {\n279|\t\treturn ReadBackManifest{}, nil, invalid(\"%s mode is not valid UTF-8\", owner)\n280|\t}\n281|\tif !ValidReadBackMode(input.Mode) {\n282|\t\treturn ReadBackManifest{}, nil, invalid(\"%s mode is outside staged|live\", owner)\n283|\t}\n284|\tplanID, err := scalar.ParseDigest(input.ProjectionPlanID)\n285|\tif err != nil {\n286|\t\treturn ReadBackManifest{}, nil, invalid(\"%s projection_plan_id is not a digest: %v\", owner, err)\n287|\t}\n288|\tmanifestID, err := scalar.ParseDigest(input.ProjectedObjectManifestID)\n289|\tif err != nil {\n290|\t\treturn ReadBackManifest{}, nil, invalid(\"%s projected_object_manifest_id is not a digest: %v\", owner, err)\n291|\t}\n292|\tif !validText(input.ExpectedTargetNativeSession) {\n293|\t\treturn ReadBackManifest{}, nil, invalid(\"%s expected_target_native_session_id is not valid UTF-8\", owner)\n294|\t}\n295|\tif length := stringLength(input.ExpectedTargetNativeSession); length < 1 || length > 512 {\n296|\t\treturn ReadBackManifest{}, nil, invalid(\"%s expected_target_native_session_id is not a string[1..512]\", owner)\n297|\t}\n298|\tif !validText(input.ObservedTargetNativeSession) {\n299|\t\treturn ReadBackManifest{}, nil, invalid(\"%s observed_target_native_session_id is not valid UTF-8\", owner)\n300|\t}\n301|\tif length := stringLength(input.ObservedTargetNativeSession); length < 1 || length > 512 {\n302|\t\treturn ReadBackManifest{}, nil, invalid(\"%s observed_target_native_session_id is not a string[1..512]\", owner)\n303|\t}\n304|\tif err := checkNativeIdentityMatch(input.ExpectedTargetNativeSession, input.ObservedTargetNativeSession); err != nil {\n305|\t\treturn ReadBackManifest{}, nil, err\n306|\t}\n307|\tobservedTuple, err := sessadapter.DecodeTuple(json.RawMessage(input.ObservedEnvironment))\n308|\tif err != nil {\n309|\t\treturn ReadBackManifest{}, nil, invalid(\"%s observed_environment is not an Environment Tuple: %v\", owner, err)\n310|\t}\n311|\tif input.ParsedEventCount > maxUint53 {\n312|\t\treturn ReadBackManifest{}, nil, invalid(\"%s parsed_event_count exceeds uint53\", owner)\n313|\t}\n314|\theads, err := checkSortedUniqueBoundedStrings(input.ParsedHeadIDs, 1, 512, 0, maxParsedHeadIDs, owner, \"parsed_head_ids\")\n315|\tif err != nil {\n316|\t\treturn ReadBackManifest{}, nil, err\n317|\t}\n318|\tbinding, err := clonebundle.DecodeWorkspaceBinding(json.RawMessage(input.WorkspaceBinding))\n319|\tif err != nil {\n320|\t\treturn ReadBackManifest{}, nil, invalid(\"%s workspace_binding is not a Workspace Binding: %v\", owner, err)\n321|\t}\n322|\tstructural, err := scalar.ParseDigest(input.StructuralDigest)\n323|\tif err != nil {\n324|\t\treturn ReadBackManifest{}, nil, invalid(\"%s structural_digest is not a digest: %v\", owner, err)\n325|\t}\n326|\tif err := checkEvidenceCount(len(input.EvidenceObjects)); err != nil {\n327|\t\treturn ReadBackManifest{}, nil, err\n328|\t}\n329|\trows := make([]EvidenceObject, 0, len(input.EvidenceObjects))\n330|\trowObjects := make([]any, 0, len(input.EvidenceObjects))\n331|\tfor index, candidate := range input.EvidenceObjects {\n332|\t\trow, object, err := buildEvidenceObject(candidate, index)\n333|\t\tif err != nil {\n334|\t\t\treturn ReadBackManifest{}, nil, err\n335|\t\t}\n336|\t\trows = append(rows, row)\n337|\t\trowObjects = append(rowObjects, object)\n338|\t}\n339|\tif err := checkEvidenceOrder(rows); err != nil {\n340|\t\treturn ReadBackManifest{}, nil, err\n341|\t}\n342|\textensions, err := clonebundle.EncodeExtensions(input.Extensions)\n343|\tif err != nil {\n344|\t\treturn ReadBackManifest{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n345|\t}\n346|\tvar extensionsValue any\n347|\tif err := json.Unmarshal(extensions, &extensionsValue); err != nil {\n348|\t\treturn ReadBackManifest{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n349|\t}\n350|\tmanifest := ReadBackManifest{\n351|\t\tOperationID:                 operation,\n352|\t\tMode:                        input.Mode,\n353|\t\tProjectionPlanID:            planID,\n354|\t\tProjectedObjectManifestID:   manifestID,\n355|\t\tExpectedTargetNativeSession: input.ExpectedTargetNativeSession,\n356|\t\tObservedTargetNativeSession: input.ObservedTargetNativeSession,\n357|\t\tObservedEnvironment:         observedTuple,\n358|\t\tParsedEventCount:            input.ParsedEventCount,\n359|\t\tParsedHeadIDs:               heads,\n360|\t\tWorkspaceBinding:            binding,\n361|\t\tStructuralDigest:            structural,\n362|\t\tEvidenceObjects:             rows,\n363|\t}\n364|\tobject := map[string]any{\n365|\t\t\"schema\":                            readBackSchema,\n366|\t\t\"schema_version\":                    readBackVersion,\n367|\t\t\"operation_id\":                      operation.String(),\n368|\t\t\"mode\":                              input.Mode,\n369|\t\t\"projection_plan_id\":                planID.String(),\n370|\t\t\"projected_object_manifest_id\":      manifestID.String(),\n371|\t\t\"expected_target_native_session_id\": input.ExpectedTargetNativeSession,\n372|\t\t\"observed_target_native_session_id\": input.ObservedTargetNativeSession,\n373|\t\t\"parsed_event_count\":                input.ParsedEventCount,\n374|\t\t\"parsed_head_ids\":                   stringValues(heads),\n375|\t\t\"structural_digest\":                 structural.String(),\n376|\t\t\"evidence_objects\":                  rowObjects,\n377|\t\t\"extensions\":                        extensionsValue,\n378|\t}\n379|\tvar tupleValue any\n380|\tif err := json.Unmarshal(input.ObservedEnvironment, &tupleValue); err != nil {\n381|\t\treturn ReadBackManifest{}, nil, invalid(\"%s observed_environment invalid: %v\", owner, err)\n382|\t}\n383|\tobject[\"observed_environment\"] = tupleValue\n384|\tvar bindingValue any\n385|\tif err := json.Unmarshal(input.WorkspaceBinding, &bindingValue); err != nil {\n386|\t\treturn ReadBackManifest{}, nil, invalid(\"%s workspace_binding invalid: %v\", owner, err)\n387|\t}\n388|\tobject[\"workspace_binding\"] = bindingValue\n389|\treturn manifest, object, nil\n390|}\n391|\n392|// DecodeReadBackEvidenceManifest validates one closed Clone\n393|// Read-Back Evidence Manifest 1.0.0: exact members, literal\n394|// schema/version, the closed mode, equal native IDs, owner-decoded\n395|// tuple and binding, sorted heads and rows, and the omit-self\n396|// identity. A relabeled mode refuses as an identity mismatch.\n397|func DecodeReadBackEvidenceManifest(data []byte) (ReadBackManifest, error) {\n398|\towner := \"read-back evidence manifest\"\n399|\tmembers, fault := decodeStrictObject(data)\n400|\tif fault != nil {\n401|\t\treturn ReadBackManifest{}, invalid(\"%s %s (%s)\", owner, fault.detail, memberField(fault.member))\n402|\t}\n403|\tif name, unknown := unknownMember(members, readBackMembers); unknown {\n404|\t\treturn ReadBackManifest{}, invalid(\"%s carries unknown member %q\", owner, name)\n405|\t}\n406|\tif name, missing := missingMember(members, readBackRequired); missing {\n407|\t\treturn ReadBackManifest{}, invalid(\"%s misses a required member %q\", owner, name)\n408|\t}\n409|\tschema, ok := rawString(members[\"schema\"])\n410|\tif !ok || schema != readBackSchema {\n411|\t\treturn ReadBackManifest{}, invalid(\"%s schema is not urn:ax:schema:clone-read-back-evidence-manifest\", owner)\n412|\t}\n413|\tversion, ok := rawString(members[\"schema_version\"])\n414|\tif !ok || version != readBackVersion {\n415|\t\treturn ReadBackManifest{}, invalid(\"%s schema_version is not 1.0.0\", owner)\n416|\t}\n417|\tclaimed, ok := checkDigest(members[readBackSelf])\n418|\tif !ok {\n419|\t\treturn ReadBackManifest{}, invalid(\"%s read_back_evidence_manifest_id is not a digest\", owner)\n420|\t}\n421|\toperation, ok := checkUUIDv7(members[\"operation_id\"])\n422|\tif !ok {\n423|\t\treturn ReadBackManifest{}, invalid(\"%s operation_id is not a UUIDv7\", owner)\n424|\t}\n425|\tmode, ok := rawString(members[\"mode\"])\n426|\tif !ok || !ValidReadBackMode(mode) {\n427|\t\treturn ReadBackManifest{}, invalid(\"%s mode is outside staged|live\", owner)\n428|\t}\n429|\tplanID, ok := checkDigest(members[\"projection_plan_id\"])\n430|\tif !ok {\n431|\t\treturn ReadBackManifest{}, invalid(\"%s projection_plan_id is not a digest\", owner)\n432|\t}\n433|\tprojectedID, ok := checkDigest(members[\"projected_object_manifest_id\"])\n434|\tif !ok {\n435|\t\treturn ReadBackManifest{}, invalid(\"%s projected_object_manifest_id is not a digest\", owner)\n436|\t}\n437|\texpected, ok := checkStringBounds(members[\"expected_target_native_session_id\"], 1, 512)\n438|\tif !ok {\n439|\t\treturn ReadBackManifest{}, invalid(\"%s expected_target_native_session_id is not a string[1..512]\", owner)\n440|\t}\n441|\tobserved, ok := checkStringBounds(members[\"observed_target_native_session_id\"], 1, 512)\n442|\tif !ok {\n443|\t\treturn ReadBackManifest{}, invalid(\"%s observed_target_native_session_id is not a string[1..512]\", owner)\n444|\t}\n445|\tif err := checkNativeIdentityMatch(expected, observed); err != nil {\n446|\t\treturn ReadBackManifest{}, err\n447|\t}\n448|\tobservedTuple, err := sessadapter.DecodeTuple(members[\"observed_environment\"])\n449|\tif err != nil {\n450|\t\treturn ReadBackManifest{}, invalid(\"%s observed_environment is not an Environment Tuple: %v\", owner, err)\n451|\t}\n452|\tparsedCount, ok := checkUint53Bounds(members[\"parsed_event_count\"], 0, maxUint53)\n453|\tif !ok {\n454|\t\treturn ReadBackManifest{}, invalid(\"%s parsed_event_count is not a uint53\", owner)\n455|\t}\n456|\theads, ok := checkSortedUniqueStrings(members[\"parsed_head_ids\"], 1, 512, 0, maxParsedHeadIDs)\n457|\tif !ok {\n458|\t\treturn ReadBackManifest{}, invalid(\"%s parsed_head_ids are not sorted unique string[1..512][0..1024]\", owner)\n459|\t}\n460|\tbinding, err := clonebundle.DecodeWorkspaceBinding(members[\"workspace_binding\"])\n461|\tif err != nil {\n462|\t\treturn ReadBackManifest{}, invalid(\"%s workspace_binding is not a Workspace Binding: %v\", owner, err)\n463|\t}\n464|\tstructural, ok := checkDigest(members[\"structural_digest\"])\n465|\tif !ok {\n466|\t\treturn ReadBackManifest{}, invalid(\"%s structural_digest is not a digest\", owner)\n467|\t}\n468|\trawRows, ok := decodeArray(members[\"evidence_objects\"])\n469|\tif !ok {\n470|\t\treturn ReadBackManifest{}, invalid(\"%s evidence_objects are not an array\", owner)\n471|\t}\n472|\tif err := checkEvidenceCount(len(rawRows)); err != nil {\n473|\t\treturn ReadBackManifest{}, err\n474|\t}\n475|\trows := make([]EvidenceObject, 0, len(rawRows))\n476|\tfor index, raw := range rawRows {\n477|\t\trow, err := decodeEvidenceObject(raw, index)\n478|\t\tif err != nil {\n479|\t\t\treturn ReadBackManifest{}, err\n480|\t\t}\n481|\t\trows = append(rows, row)\n482|\t}\n483|\tif err := checkEvidenceOrder(rows); err != nil {\n484|\t\treturn ReadBackManifest{}, err\n485|\t}\n486|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n487|\t\treturn ReadBackManifest{}, invalid(\"%s extensions %s\", owner, extensionsFault)\n488|\t}\n489|\tif err := verifySelfDigest(members, readBackSelf, claimed); err != nil {\n490|\t\treturn ReadBackManifest{}, err\n491|\t}\n492|\treturn ReadBackManifest{\n493|\t\tManifestID:                  claimed,\n494|\t\tOperationID:                 operation,\n495|\t\tMode:                        mode,\n496|\t\tProjectionPlanID:            planID,\n497|\t\tProjectedObjectManifestID:   projectedID,\n498|\t\tExpectedTargetNativeSession: expected,\n499|\t\tObservedTargetNativeSession: observed,\n500|\t\tObservedEnvironment:         observedTuple,\n(more lines below)","final_result":true}}}
