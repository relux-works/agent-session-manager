{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d01b","stream":{"kind":"session","id":"01a0d474-3d76-7560-9284-b023a445b4ff"},"sequence":1640,"recorded_at":1780531400003275,"record_type":"event","durability":"durable","causation_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","run_stream":{"kind":"run","id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27"},"task_stream":{"kind":"task","id":"01a0d47e-2d4b-7440-ba51-3061a958f3d7"},"task_id":"01a0d47e-2d4b-7440-ba51-3061a958f3d7","event":{"kind":"output","task_id":"01a0d47e-2d4b-7440-ba51-3061a958f3d7","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/clonereadback/identity_test.go`.\n(87 line(s) above)\n88|// TestModeRelabelRefused pins \"Modes cannot be relabeled\"\n89|// (SPEC v0.7.0 §13.14.2 line 10580 and line 10754): flipping the\n90|// mode under a sealed id refuses as an identity mismatch at the\n91|// production decode entry; the mode binds the identity, so the\n92|// relabeled bytes are a different document, never the same\n93|// manifest.\n94|func TestModeRelabelRefused(t *testing.T) {\n95|\tfor _, mode := range []string{\"staged\", \"live\"} {\n96|\t\tinput := validReadBackInput()\n97|\t\tinput.Mode = mode\n98|\t\tsealed := mustBuildReadBack(t, stagedAuthority(t), input)\n99|\t\tdocument := decodeDocument(t, sealed)\n100|\t\tflipped := \"live\"\n101|\t\tif mode == \"live\" {\n102|\t\t\tflipped = \"staged\"\n103|\t\t}\n104|\t\tdocument[\"mode\"] = flipped\n105|\t\t_, err := clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document), stagedAuthority(t))\n106|\t\trequireRefusal(t, err, \"read_back_evidence_manifest_id\", \"does not match omit-self digest\")\n107|\t}\n108|}\n109|\n110|// TestModeBindsIdentity pins the positive side of the relabel rule:\n111|// the same logical inputs sealed under staged and live carry\n112|// different ids, and resealing the flipped mode under its own\n113|// recomputed id decodes as the other mode — a distinct document,\n114|// never a relabeled one.\n115|func TestModeBindsIdentity(t *testing.T) {\n116|\tstagedInput := validReadBackInput()\n117|\tstagedInput.Mode = \"staged\"\n118|\tliveInput := validReadBackInput()\n119|\tliveInput.Mode = \"live\"\n120|\tstaged := mustBuildReadBack(t, stagedAuthority(t), stagedInput)\n121|\tlive := mustBuildReadBack(t, stagedAuthority(t), liveInput)\n122|\tstagedDoc := decodeDocument(t, staged)\n123|\tliveDoc := decodeDocument(t, live)\n124|\tif stagedDoc[\"read_back_evidence_manifest_id\"] == liveDoc[\"read_back_evidence_manifest_id\"] {\n125|\t\tt.Fatal(\"staged and live manifests share an id: modes do not bind identity\")\n126|\t}\n127|\trelabeled := decodeDocument(t, staged)\n128|\trelabeled[\"mode\"] = \"live\"\n129|\trelabeled[\"read_back_evidence_manifest_id\"] = independentSelfDigest(t, marshalDocument(t, relabeled), \"read_back_evidence_manifest_id\")\n130|\tmanifest := mustDecodeReadBack(t, stagedAuthority(t), marshalDocument(t, relabeled))\n131|\tif manifest.Mode != \"live\" {\n132|\t\tt.Fatalf(\"mode = %q, want live\", manifest.Mode)\n133|\t}\n134|\tif manifest.ManifestID.String() != liveDoc[\"read_back_evidence_manifest_id\"] {\n135|\t\tt.Fatal(\"recomputed relabel id disagrees with the live seal: identity is not a pure function of members\")\n136|\t}\n137|}","final_result":true}}}
