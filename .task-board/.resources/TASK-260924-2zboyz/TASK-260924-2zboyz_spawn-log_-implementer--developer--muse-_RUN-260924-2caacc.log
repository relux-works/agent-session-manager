{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c85b","stream":{"kind":"session","id":"01a0d474-3d76-7560-9284-b023a445b4ff"},"sequence":648,"recorded_at":1780531400001291,"record_type":"event","durability":"durable","causation_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","run_stream":{"kind":"run","id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27"},"task_stream":{"kind":"task","id":"01a0d476-f89e-7071-93f1-53c95f183c59"},"task_id":"01a0d476-f89e-7071-93f1-53c95f183c59","event":{"kind":"output","task_id":"01a0d476-f89e-7071-93f1-53c95f183c59","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/clonereadback/testdata/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant battery for internal/clonereadback.\n3|\n4|Every row weakens one production gate to admit exactly one member\n5|of the class it must reject (narrowing), applies the patch, runs\n6|the named killer test ALONE in a subprocess, records the raw log\n7|with the subprocess exit, and restores the tree. A row is KILLED\n8|when the killer exits non-zero and SURVIVED otherwise; the battery\n9|expects every narrowing KILLED and the single neutral control\n10|SURVIVED (proving the harness can report a survivor).\n11|\n12|Structural control plants (P-*) prove the census/guard tests\n13|redden: they patch production or test files and run the named\n14|structural test alone.\n15|\n16|Usage:\n17|  python3 testdata/mutant_harness.py run <run_dir> [row-id ...]\n18|  python3 testdata/mutant_harness.py list\n19|\"\"\"\n20|import os\n21|import subprocess\n22|import sys\n23|\n24|PKG = \"internal/clonereadback\"\n25|GO_TEST = [\"go\", \"test\", \"./\" + PKG + \"/\", \"-count=1\"]\n26|\n27|# Each row: id, kind (narrowing|control|plant), file (relative to\n28|# repo root, None for file-add plants), anchor (exact original\n29|# text, None for file-add), replacement, test (exact -run regex),\n30|# expect (killed|survived|red), note.\n31|ROWS = [\n32|    # --- vocabulary narrowings: admit exactly one neighbor ---\n33|    {\"id\": \"N-mode-archived\", \"kind\": \"narrowing\",\n34|     \"file\": PKG + \"/vocab.go\",\n35|     \"anchor\": 'var readBackModes = map[string]bool{\\n\\t\"staged\": true,\\n\\t\"live\":   true,\\n}',\n36|     \"replacement\": 'var readBackModes = map[string]bool{\\n\\t\"staged\": true,\\n\\t\"live\":   true,\\n\\t\"archived\": true,\\n}',\n37|     \"test\": \"TestModeVocabularyOracle$\",\n38|     \"expect\": \"killed\",\n39|     \"note\": \"mode gate admits archived only\"},\n40|    {\"id\": \"N-kind-native\", \"kind\": \"narrowing\",\n41|     \"file\": PKG + \"/vocab.go\",\n42|     \"anchor\": '\"native_sample\":      true,',\n43|     \"replacement\": '\"native_sample\":      true,\\n\\t\"native\": true,',\n44|     \"test\": \"TestEvidenceKindVocabularyOracle$\",\n45|     \"expect\": \"killed\",\n46|     \"note\": \"kind gate admits native only\"},\n47|    # --- equality narrowing: length equality admits\n48|    # same-length-differing IDs at both read-back entries ---\n49|    {\"id\": \"N-identity-len\", \"kind\": \"narrowing\",\n50|     \"file\": PKG + \"/readback.go\",\n51|     \"anchor\": \"func checkNativeIdentityMatch(expected, observed string) error {\\n\\tif expected != observed {\",\n52|     \"replacement\": \"func checkNativeIdentityMatch(expected, observed string) error {\\n\\tif len(expected) != len(observed) {\",\n53|     \"test\": \"TestNativeIdentityEqualityOracle$\",\n54|     \"expect\": \"killed\",\n55|     \"note\": \"equality gate admits same-length-differing IDs\"},\n56|    # --- validity narrowings: drop exactly one conjunct ---\n57|    {\"id\": \"N-valid-drop-staged\", \"kind\": \"narrowing\",\n58|     \"file\": PKG + \"/report.go\",\n59|     \"anchor\": \"\\tif !checks.StagedStructuralValid {\\n\\t\\treturn false\\n\\t}\\n\",\n60|     \"replacement\": \"\",\n61|     \"test\": \"TestValidWholeDomainOracle$\",\n62|     \"expect\": \"killed\",\n63|     \"note\": \"valid admits staged-structural-false reports\"},\n64|    {\"id\": \"N-valid-drop-live\", \"kind\": \"narrowing\",\n65|     \"file\": PKG + \"/report.go\",\n66|     \"anchor\": \"\\tif !checks.LiveStructuralValid {\\n\\t\\treturn false\\n\\t}\\n\",\n67|     \"replacement\": \"\",\n68|     \"test\": \"TestValidWholeDomainOracle$\",\n69|     \"expect\": \"killed\",\n70|     \"note\": \"valid admits live-structural-false reports\"},\n71|    {\"id\": \"N-valid-drop-marker\", \"kind\": \"narrowing\",\n72|     \"file\": PKG + \"/report.go\",\n73|     \"anchor\": \"\\tif !checks.SemanticMarkerValid {\\n\\t\\treturn false\\n\\t}\\n\",\n74|     \"replacement\": \"\",\n75|     \"test\": \"TestValidWholeDomainOracle$\",\n76|     \"expect\": \"killed\",\n77|     \"note\": \"valid admits marker-false reports\"},\n78|    {\"id\": \"N-valid-drop-identity\", \"kind\": \"narrowing\",\n79|     \"file\": PKG + \"/report.go\",\n80|     \"anchor\": \"\\tif !checks.IdentityValid {\\n\\t\\treturn false\\n\\t}\\n\",\n81|     \"replacement\": \"\",\n82|     \"test\": \"TestValidWholeDomainOracle$\",\n83|     \"expect\": \"killed\",\n84|     \"note\": \"valid admits identity-false reports\"},\n85|    {\"id\": \"N-valid-drop-binding\", \"kind\": \"narrowing\",\n86|     \"file\": PKG + \"/report.go\",\n87|     \"anchor\": \"\\tif !checks.WorkspaceBindingValid {\\n\\t\\treturn false\\n\\t}\\n\",\n88|     \"replacement\": \"\",\n89|     \"test\": \"TestValidWholeDomainOracle$\",\n90|     \"expect\": \"killed\",\n91|     \"note\": \"valid admits binding-false reports\"},\n92|    {\"id\": \"N-valid-drop-resume\", \"kind\": \"narrowing\",\n93|     \"file\": PKG + \"/report.go\",\n94|     \"anchor\": \"\\tif !checks.ResumeSurfaceValid {\\n\\t\\treturn false\\n\\t}\\n\",\n95|     \"replacement\": \"\",\n96|     \"test\": \"TestValidWholeDomainOracle$\",\n97|     \"expect\": \"killed\",\n98|     \"note\": \"valid admits resume-false reports\"},\n99|    {\"id\": \"N-valid-drop-generation\", \"kind\": \"narrowing\",\n100|     \"file\": PKG + \"/report.go\",\n101|     \"anchor\": \"\\tif !checks.SourceGenerationRevalidated {\\n\\t\\treturn false\\n\\t}\\n\",\n102|     \"replacement\": \"\",\n103|     \"test\": \"TestValidWholeDomainOracle$\",\n104|     \"expect\": \"killed\",\n105|     \"note\": \"valid admits generation-false reports\"},\n106|    {\"id\": \"N-valid-drop-ids\", \"kind\": \"narrowing\",\n107|     \"file\": PKG + \"/report.go\",\n108|     \"anchor\": \"\\tif expected != observed {\\n\\t\\treturn false\\n\\t}\\n\",\n109|     \"replacement\": \"\",\n110|     \"test\": \"TestValidWholeDomainOracle$\",\n111|     \"expect\": \"killed\",\n112|     \"note\": \"valid admits ID-mismatched reports\"},\n113|    {\"id\": \"N-valid-drop-error\", \"kind\": \"narrowing\",\n114|     \"file\": PKG + \"/report.go\",\n115|     \"anchor\": 'if finding.Severity == \"error\" {',\n116|     \"replacement\": 'if finding.Severity == \"fatal\" {',\n117|     \"test\": \"TestValidWholeDomainOracle$\",\n118|     \"expect\": \"killed\",\n119|     \"note\": \"valid admits error-finding reports\"},\n120|    # --- order narrowings: strict becomes lax, duplicates admit ---\n121|    {\"id\": \"N-heads-dup\", \"kind\": \"narrowing\",\n122|     \"file\": PKG + \"/decode.go\",\n123|     \"anchor\": \"if index > 0 && value <= values[index-1] {\",\n124|     \"replacement\": \"if index > 0 && value < values[index-1] {\",\n125|     \"test\": \"TestParsedHeadIDsSweep$\",\n126|     \"expect\": \"killed\",\n127|     \"note\": \"heads gate admits duplicates at Build\"},\n128|    {\"id\": \"N-evidence-dup\", \"kind\": \"narrowing\",\n129|     \"file\": PKG + \"/readback.go\",\n130|     \"anchor\": \"(current.EvidenceKind == previous.EvidenceKind && current.BlobID.String() <= previous.BlobID.String())\",\n131|     \"replacement\": \"(current.EvidenceKind == previous.EvidenceKind && current.BlobID.String() < previous.BlobID.String())\",\n132|     \"test\": \"TestEvidenceOrderSweep$\",\n133|     \"expect\": \"killed\",\n134|     \"note\": \"row order admits duplicated (kind, blob) pairs\"},\n135|    # --- count narrowings: edge+1 admits ---\n136|    {\"id\": \"N-evidence-count\", \"kind\": \"narrowing\",\n137|     \"file\": PKG + \"/readback.go\",\n138|     \"anchor\": \"if count < 0 || count > maxEvidenceRows {\",\n139|     \"replacement\": \"if count < 0 || count > maxEvidenceRows+1 {\",\n140|     \"test\": \"TestEvidenceCountEdges$\",\n141|     \"expect\": \"killed\",\n142|     \"note\": \"row count admits 65537 at both entries\"},\n143|    {\"id\": \"N-findings-count-build\", \"kind\": \"narrowing\",\n144|     \"file\": PKG + \"/report.go\",\n145|     \"anchor\": \"sessadapter.DecodeFindings(json.RawMessage(input.Findings), maxReportFindings)\",\n146|     \"replacement\": \"sessadapter.DecodeFindings(json.RawMessage(input.Findings), maxReportFindings+1)\",\n147|     \"test\": \"TestFindingsCountEdges$\",\n148|     \"expect\": \"killed\",\n149|     \"note\": \"findings count admits 4097 at Build\"},\n150|    {\"id\": \"N-findings-count-decode\", \"kind\": \"narrowing\",\n151|     \"file\": PKG + \"/report.go\",\n152|     \"anchor\": 'sessadapter.DecodeFindings(members[\"findings\"], maxReportFindings)',\n153|     \"replacement\": 'sessadapter.DecodeFindings(members[\"findings\"], maxReportFindings+1)',\n154|     \"test\": \"TestFindingsCountEdges$\",\n155|     \"expect\": \"killed\",\n156|     \"note\": \"findings count admits 4097 at Decode\"},\n157|    # --- closed-shape narrowings: admit exactly the probe member ---\n158|    {\"id\": \"N-closed-readback\", \"kind\": \"narrowing\",\n159|     \"file\": PKG + \"/readback.go\",\n160|     \"anchor\": '\"extensions\": true,\\n}',\n161|     \"replacement\": '\"extensions\": true, \"zz_extra_member\": true,\\n}',\n162|     \"test\": \"TestMemberCensusUnknownMissing$\",\n163|     \"expect\": \"killed\",\n164|     \"note\": \"read-back shape admits zz_extra_member at Decode\"},\n165|    {\"id\": \"N-closed-evidence\", \"kind\": \"narrowing\",\n166|     \"file\": PKG + \"/readback.go\",\n167|     \"anchor\": '\"blob_descriptor_id\": true,\\n}',\n168|     \"replacement\": '\"blob_descriptor_id\": true, \"zz_extra_member\": true,\\n}',\n169|     \"test\": \"TestMemberCensusUnknownMissing$\",\n170|     \"expect\": \"killed\",\n171|     \"note\": \"evidence shape admits zz_extra_member at Decode\"},\n172|    {\"id\": \"N-closed-report\", \"kind\": \"narrowing\",\n173|     \"file\": PKG + \"/report.go\",\n174|     \"anchor\": '\"extensions\": true,\\n}',\n175|     \"replacement\": '\"extensions\": true, \"zz_extra_member\": true,\\n}',\n176|     \"test\": \"TestMemberCensusUnknownMissing$\",\n177|     \"expect\": \"killed\",\n178|     \"note\": \"report shape admits zz_extra_member at Decode\"},\n179|    # --- envelope narrowings: admit exactly one neighbor literal ---\n180|    {\"id\": \"N-schema-neighbor\", \"kind\": \"narrowing\",\n181|     \"file\": PKG + \"/readback.go\",\n182|     \"anchor\": \"if !ok || schema != readBackSchema {\",\n183|     \"replacement\": 'if !ok || (schema != readBackSchema && schema != validationSchema) {',\n184|     \"test\": \"TestEnvelopeLiterals$\",\n185|     \"expect\": \"killed\",\n186|     \"note\": \"schema gate admits the sibling URN at Decode\"},\n187|    {\"id\": \"N-version-neighbor\", \"kind\": \"narrowing\",\n188|     \"file\": PKG + \"/readback.go\",\n189|     \"anchor\": \"if !ok || version != readBackVersion {\",\n190|     \"replacement\": 'if !ok || (version != readBackVersion && version != \"2.0.0\") {',\n191|     \"test\": \"TestEnvelopeLiterals$\",\n192|     \"expect\": \"killed\",\n193|     \"note\": \"version gate admits 2.0.0 at Decode\"},\n194|    # --- identity narrowing: admit exactly the relabeled class ---\n195|    {\"id\": \"N-relabel-admit\", \"kind\": \"narrowing\",\n196|     \"file\": PKG + \"/readback.go\",\n197|     \"anchor\": \"\\tif err := verifySelfDigest(members, readBackSelf, claimed); err != nil {\\n\\t\\treturn ReadBackManifest{}, err\\n\\t}\",\n198|     \"replacement\": \"\\tif err := verifySelfDigest(members, readBackSelf, claimed); err != nil {\\n\\t\\tmembers[\\\"mode\\\"] = json.RawMessage(`\\\"staged\\\"`)\\n\\t\\tif retryErr := verifySelfDigest(members, readBackSelf, claimed); retryErr != nil {\\n\\t\\t\\tmembers[\\\"mode\\\"] = json.RawMessage(`\\\"live\\\"`)\\n\\t\\t\\tif retryErr := verifySelfDigest(members, readBackSelf, claimed); retryErr != nil {\\n\\t\\t\\t\\treturn ReadBackManifest{}, err\\n\\t\\t\\t}\\n\\t\\t}\\n\\t}\",\n199|     \"test\": \"TestModeRelabelRefused$\",\n200|     \"expect\": \"killed\",\n201|     \"note\": \"identity admits docs valid under the other mode\"},\n202|    # --- scalar narrowings ---\n203|    {\"id\": \"N-parse-count-edge\", \"kind\": \"narrowing\",\n204|     \"file\": PKG + \"/readback.go\",\n205|     \"anchor\": \"if input.ParsedEventCount > maxUint53 {\",\n206|     \"replacement\": \"if input.ParsedEventCount > maxUint53+1 {\",\n207|     \"test\": \"TestScalarGates$\",\n208|     \"expect\": \"killed\",\n209|     \"note\": \"parsed count admits 2^53 at Build\"},\n210|    # NOTE: N-session-bound was withdrawn after it SURVIVED run1: the\n211|    # expected-ID widening is masked by the sibling observed-bound gate\n212|    # (the killer holds expected==observed). The edge is proven by\n213|    # TestNativeSessionStringEdges; the conjoining gate by\n214|    # N-identity-len. Log preserved in evidence under withdrawn/.\n215|    # --- neutral control: comment-only, must survive ---\n216|    {\"id\": \"N-control-neutral\", \"kind\": \"control\",\n217|     \"file\": PKG + \"/readback.go\",\n218|     \"anchor\": \"// BuildReadBackEvidenceManifest constructs one closed Clone\",\n219|     \"replacement\": \"// control: no semantic change.\\n// BuildReadBackEvidenceManifest constructs one closed Clone\",\n220|     \"test\": \"\",\n221|     \"expect\": \"survived\",\n222|     \"note\": \"comment-only; whole suite must stay green\"},\n223|    # --- structural control plants ---\n224|    {\"id\": \"P-census-entry\", \"kind\": \"plant\",\n225|     \"file\": None,\n226|     \"add_file\": PKG + \"/plant_entry.go\",\n227|     \"add_content\": \"package clonereadback\\n\\n// PlantRowEntry is a control plant: a ninth export carrying\\n// a disposition row. It must redden TestExportedAPIInventory.\\ntype PlantRow struct {\\n\\tDisposition string\\n\\tReasonCodes []string\\n}\\n\\nfunc PlantRowEntry(input PlantRow) error {\\n\\tif input.Disposition == \\\"\\\" {\\n\\t\\treturn invalid(\\\"plant\\\")\\n\\t}\\n\\treturn nil\\n}\\n\",\n228|     \"test\": \"TestExportedAPIInventory$\",\n229|     \"expect\": \"red\",\n230|     \"note\": \"ninth export must redden the API inventory\"},\n231|    {\"id\": \"P-owner-call-removed\", \"kind\": \"plant\",\n232|     \"file\": PKG + \"/readback.go\",\n233|     \"anchor\": \"\\tobservedTuple, err := sessadapter.DecodeTuple(json.RawMessage(input.ObservedEnvironment))\\n\\tif err != nil {\\n\\t\\treturn ReadBackManifest{}, nil, invalid(\\\"%s observed_environment is not an Environment Tuple: %v\\\", owner, err)\\n\\t}\\n\",\n234|     \"replacement\": \"\",\n235|     \"test\": \"TestOwnerReachability$\",\n236|     \"expect\": \"red\",\n237|     \"note\": \"removed owner call reddens reachability (build failure)\"},\n238|    {\"id\": \"P-forked-literal\", \"kind\": \"plant\",\n239|     \"file\": PKG + \"/readback.go\",\n240|     \"anchor\": \"\\toperation, err := scalar.ParseUUIDv7(input.OperationID)\",\n241|     \"replacement\": \"\\t_ = \\\"environment_id\\\"\\n\\toperation, err := scalar.ParseUUIDv7(input.OperationID)\",\n242|     \"test\": \"TestNoForkedLiterals$\",\n243|     \"expect\": \"red\",\n244|     \"note\": \"re-added owner literal reddens the fork guard\"},\n245|    {\"id\": \"P-severity-second\", \"kind\": \"plant\",\n246|     \"file\": PKG + \"/report.go\",\n247|     \"anchor\": \"\\tif err := checkValidAgreement(owner, input.Valid, checks, input.ExpectedTargetNativeSession, input.ObservedTargetNativeSession, findings); err != nil {\",\n248|     \"replacement\": \"\\tfor _, matched := range findings {\\n\\t\\tif matched.Severity == \\\"info\\\" {\\n\\t\\t\\tbreak\\n\\t\\t}\\n\\t}\\n\\tif err := checkValidAgreement(owner, input.Valid, checks, input.ExpectedTargetNativeSession, input.ObservedTargetNativeSession, findings); err != nil {\",\n249|     \"test\": \"TestErrorSeverityDecidedOnDecodedField$\",\n250|     \"expect\": \"red\",\n251|     \"note\": \"second Severity matcher reddens the decider pin\"},\n252|    {\"id\": \"P-guard-literal-list\", \"kind\": \"plant\",\n253|     \"file\": PKG + \"/members_test.go\",\n254|     \"anchor\": \"// TestCensusShapeInventory pins the census coverage itself: 3\",\n255|     \"replacement\": \"// plantMemberList is a control plant: a census-scale literal\\n// member list that must redden TestMemberCensusNoLiteralList.\\nvar plantMemberList = []string{\\\"operation_id\\\", \\\"mode\\\", \\\"projection_plan_id\\\", \\\"projected_object_manifest_id\\\", \\\"expected_target_native_session_id\\\", \\\"observed_target_native_session_id\\\", \\\"observed_environment\\\", \\\"parsed_event_count\\\", \\\"parsed_head_ids\\\", \\\"workspace_binding\\\"}\\n\\n// TestCensusShapeInventory pins the census coverage itself: 3\",\n256|     \"test\": \"TestMemberCensusNoLiteralList$\",\n257|     \"expect\": \"red\",\n258|     \"note\": \"10-name literal list reddens the derivation guard\"},\n259|]\n260|\n261|\n262|def find_root():\n263|    here = os.path.abspath(os.path.dirname(__file__))\n264|    # testdata/ -> package dir -> internal/ -> repo root\n265|    return os.path.dirname(os.path.dirname(os.path.dirname(here)))\n266|\n267|\n268|def run_row(root, row, run_dir):\n269|    pkg_dir = os.path.join(root, PKG)\n270|    added = None\n271|    original = None\n272|    target = None\n273|    if row.get(\"add_file\"):\n274|        added = os.path.join(root, row[\"add_file\"])\n275|        with open(added, \"w\") as handle:\n276|            handle.write(row[\"add_content\"])\n277|    else:\n278|        target = os.path.join(root, row[\"file\"])\n279|        with open(target) as handle:\n280|            original = handle.read()\n281|        anchor = row[\"anchor\"]\n282|        if original.count(anchor) != 1:\n283|            return (\"ERROR\", \"anchor found %d times, want 1\" % original.count(anchor), \"\")\n284|        with open(target, \"w\") as handle:\n285|            handle.write(original.replace(anchor, row[\"replacement\"]))\n286|    cmd = GO_TEST + ([\"-run\", row[\"test\"]] if row[\"test\"] else [])\n287|    proc = subprocess.run(cmd, cwd=root, capture_output=True, text=True, timeout=600)\n288|    raw = (\"$ %s\\nexit=%d\\n--- stdout ---\\n%s\\n--- stderr ---\\n%s\\n\"\n289|           % (\" \".join(cmd), proc.returncode, proc.stdout, proc.stderr))\n290|    log_path = os.path.join(run_dir, row[\"id\"] + \".log\")\n291|    with open(log_path, \"w\") as handle:\n292|        handle.write(\"row: %s\\nkind: %s\\nexpect: %s\\nnote: %s\\ntest: %s\\n%s\"\n293|                     % (row[\"id\"], row[\"kind\"], row[\"expect\"], row[\"note\"],\n294|                        row[\"test\"] or \"(full suite)\", raw))\n295|    verdict = \"SURVIVED\" if proc.returncode == 0 else \"KILLED\"\n296|    if row[\"kind\"] in (\"plant\",):\n297|        verdict = \"GREEN\" if proc.returncode == 0 else \"RED\"\n298|    try:\n299|        if added is not None:\n300|            os.remove(added)\n301|        elif target is not None:\n302|            with open(target, \"w\") as handle:\n303|                handle.write(original)\n304|    except OSError as exc:\n305|        return (\"ERROR\", \"restore failed: %s\" % exc, log_path)\n306|    # Verify the tree is clean after restore.\n307|    if added is None and target is not None:\n308|        with open(target) as handle:\n309|            if handle.read() != original:\n310|                return (\"ERROR\", \"restore mismatch\", log_path)\n311|    return (verdict, \"\", log_path)\n312|\n313|\n314|def main(argv):\n315|    if len(argv) < 2 or argv[1] not in (\"run\", \"list\"):\n316|        print(__doc__)\n317|        return 2\n318|    if argv[1] == \"list\":\n319|        for row in ROWS:\n320|            print(\"%s\\t%s\\t%s\\t%s\" % (row[\"id\"], row[\"kind\"], row[\"expect\"], row[\"test\"] or \"(full)\"))\n321|        return 0\n322|    run_dir = argv[2] if len(argv) > 2 else \"mutant_logs\"\n323|    only = set(argv[3:]) if len(argv) > 3 else None\n324|    root = find_root()\n325|    os.makedirs(run_dir, exist_ok=True)\n326|    failures = 0\n327|    for row in ROWS:\n328|        if only is not None and row[\"id\"] not in only:\n329|            continue\n330|        verdict, err, log_path = run_row(root, row, run_dir)\n331|        want_killed = row[\"expect\"] in (\"killed\", \"red\")\n332|        ok = (verdict in (\"KILLED\", \"RED\")) if want_killed else (verdict == \"SURVIVED\")\n333|        status = \"ok\" if ok else \"MISMATCH\"\n334|        if not ok:\n335|            failures += 1\n336|        print(\"%s\\t%s\\t want=%s\\t%s\\t%s\" % (row[\"id\"], verdict, row[\"expect\"], status, log_path or err))\n337|    print(\"failures=%d\" % failures)\n338|    return 1 if failures else 0\n339|\n340|\n341|if __name__ == \"__main__\":\n342|    sys.exit(main(sys.argv))","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c85d","stream":{"kind":"session","id":"01a0d474-3d76-7560-9284-b023a445b4ff"},"sequence":649,"recorded_at":1780531400001293,"record_type":"event","durability":"durable","causation_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","run_stream":{"kind":"run","id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27"},"task_stream":{"kind":"task","id":"01a0d476-f89e-7071-93f1-53c95f183c59"},"task_id":"01a0d476-f89e-7071-93f1-53c95f183c59","event":{"kind":"completed","task_id":"01a0d476-f89e-7071-93f1-53c95f183c59"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c85f","stream":{"kind":"session","id":"01a0d474-3d76-7560-9284-b023a445b4ff"},"sequence":650,"recorded_at":1780531400001295,"record_type":"event","durability":"durable","causation_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","run_stream":{"kind":"run","id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27"},"call_id":"call_01a0d476f37a76189ba15fc3aff8a645","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/clonereadback/testdata/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant battery for internal/clonereadback.\n3|\n4|Every row weakens one production gate to admit exactly one member\n5|of the class it must reject (narrowing), applies the patch, runs\n6|the named killer test ALONE in a subprocess, records the raw log\n7|with the subprocess exit, and restores the tree. A row is KILLED\n8|when the killer exits non-zero and SURVIVED otherwise; the battery\n9|expects every narrowing KILLED and the single neutral control\n10|SURVIVED (proving the harness can report a survivor).\n11|\n12|Structural control plants (P-*) prove the census/guard tests\n13|redden: they patch production or test files and run the named\n14|structural test alone.\n15|\n16|Usage:\n17|  python3 testdata/mutant_harness.py run <run_dir> [row-id ...]\n18|  python3 testdata/mutant_harness.py list\n19|\"\"\"\n20|import os\n21|import subprocess\n22|import sys\n23|\n24|PKG = \"internal/clonereadback\"\n25|GO_TEST = [\"go\", \"test\", \"./\" + PKG + \"/\", \"-count=1\"]\n26|\n27|# Each row: id, kind (narrowing|control|plant), file (relative to\n28|# repo root, None for file-add plants), anchor (exact original\n29|# text, None for file-add), replacement, test (exact -run regex),\n30|# expect (killed|survived|red), note.\n31|ROWS = [\n32|    # --- vocabulary narrowings: admit exactly one neighbor ---\n33|    {\"id\": \"N-mode-archived\", \"kind\": \"narrowing\",\n34|     \"file\": PKG + \"/vocab.go\",\n35|     \"anchor\": 'var readBackModes = map[string]bool{\\n\\t\"staged\": true,\\n\\t\"live\":   true,\\n}',\n36|     \"replacement\": 'var readBackModes = map[string]bool{\\n\\t\"staged\": true,\\n\\t\"live\":   true,\\n\\t\"archived\": true,\\n}',\n37|     \"test\": \"TestModeVocabularyOracle$\",\n38|     \"expect\": \"killed\",\n39|     \"note\": \"mode gate admits archived only\"},\n40|    {\"id\": \"N-kind-native\", \"kind\": \"narrowing\",\n41|     \"file\": PKG + \"/vocab.go\",\n42|     \"anchor\": '\"native_sample\":      true,',\n43|     \"replacement\": '\"native_sample\":      true,\\n\\t\"native\": true,',\n44|     \"test\": \"TestEvidenceKindVocabularyOracle$\",\n45|     \"expect\": \"killed\",\n46|     \"note\": \"kind gate admits native only\"},\n47|    # --- equality narrowing: length equality admits\n48|    # same-length-differing IDs at both read-back entries ---\n49|    {\"id\": \"N-identity-len\", \"kind\": \"narrowing\",\n50|     \"file\": PKG + \"/readback.go\",\n51|     \"anchor\": \"func checkNativeIdentityMatch(expected, observed string) error {\\n\\tif expected != observed {\",\n52|     \"replacement\": \"func checkNativeIdentityMatch(expected, observed string) error {\\n\\tif len(expected) != len(observed) {\",\n53|     \"test\": \"TestNativeIdentityEqualityOracle$\",\n54|     \"expect\": \"killed\",\n55|     \"note\": \"equality gate admits same-length-differing IDs\"},\n56|    # --- validity narrowings: drop exactly one conjunct ---\n57|    {\"id\": \"N-valid-drop-staged\", \"kind\": \"narrowing\",\n58|     \"file\": PKG + \"/report.go\",\n59|     \"anchor\": \"\\tif !checks.StagedStructuralValid {\\n\\t\\treturn false\\n\\t}\\n\",\n60|     \"replacement\": \"\",\n61|     \"test\": \"TestValidWholeDomainOracle$\",\n62|     \"expect\": \"killed\",\n63|     \"note\": \"valid admits staged-structural-false reports\"},\n64|    {\"id\": \"N-valid-drop-live\", \"kind\": \"narrowing\",\n65|     \"file\": PKG + \"/report.go\",\n66|     \"anchor\": \"\\tif !checks.LiveStructuralValid {\\n\\t\\treturn false\\n\\t}\\n\",\n67|     \"replacement\": \"\",\n68|     \"test\": \"TestValidWholeDomainOracle$\",\n69|     \"expect\": \"killed\",\n70|     \"note\": \"valid admits live-structural-false reports\"},\n71|    {\"id\": \"N-valid-drop-marker\", \"kind\": \"narrowing\",\n72|     \"file\": PKG + \"/report.go\",\n73|     \"anchor\": \"\\tif !checks.SemanticMarkerValid {\\n\\t\\treturn false\\n\\t}\\n\",\n74|     \"replacement\": \"\",\n75|     \"test\": \"TestValidWholeDomainOracle$\",\n76|     \"expect\": \"killed\",\n77|     \"note\": \"valid admits marker-false reports\"},\n78|    {\"id\": \"N-valid-drop-identity\", \"kind\": \"narrowing\",\n79|     \"file\": PKG + \"/report.go\",\n80|     \"anchor\": \"\\tif !checks.IdentityValid {\\n\\t\\treturn false\\n\\t}\\n\",\n81|     \"replacement\": \"\",\n82|     \"test\": \"TestValidWholeDomainOracle$\",\n83|     \"expect\": \"killed\",\n84|     \"note\": \"valid admits identity-false reports\"},\n85|    {\"id\": \"N-valid-drop-binding\", \"kind\": \"narrowing\",\n86|     \"file\": PKG + \"/report.go\",\n87|     \"anchor\": \"\\tif !checks.WorkspaceBindingValid {\\n\\t\\treturn false\\n\\t}\\n\",\n88|     \"replacement\": \"\",\n89|     \"test\": \"TestValidWholeDomainOracle$\",\n90|     \"expect\": \"killed\",\n91|     \"note\": \"valid admits binding-false reports\"},\n92|    {\"id\": \"N-valid-drop-resume\", \"kind\": \"narrowing\",\n93|     \"file\": PKG + \"/report.go\",\n94|     \"anchor\": \"\\tif !checks.ResumeSurfaceValid {\\n\\t\\treturn false\\n\\t}\\n\",\n95|     \"replacement\": \"\",\n96|     \"test\": \"TestValidWholeDomainOracle$\",\n97|     \"expect\": \"killed\",\n98|     \"note\": \"valid admits resume-false reports\"},\n99|    {\"id\": \"N-valid-drop-generation\", \"kind\": \"narrowing\",\n100|     \"file\": PKG + \"/report.go\",\n101|     \"anchor\": \"\\tif !checks.SourceGenerationRevalidated {\\n\\t\\treturn false\\n\\t}\\n\",\n102|     \"replacement\": \"\",\n103|     \"test\": \"TestValidWholeDomainOracle$\",\n104|     \"expect\": \"killed\",\n105|     \"note\": \"valid admits generation-false reports\"},\n106|    {\"id\": \"N-valid-drop-ids\", \"kind\": \"narrowing\",\n107|     \"file\": PKG + \"/report.go\",\n108|     \"anchor\": \"\\tif expected != observed {\\n\\t\\treturn false\\n\\t}\\n\",\n109|     \"replacement\": \"\",\n110|     \"test\": \"TestValidWholeDomainOracle$\",\n111|     \"expect\": \"killed\",\n112|     \"note\": \"valid admits ID-mismatched reports\"},\n113|    {\"id\": \"N-valid-drop-error\", \"kind\": \"narrowing\",\n114|     \"file\": PKG + \"/report.go\",\n115|     \"anchor\": 'if finding.Severity == \"error\" {',\n116|     \"replacement\": 'if finding.Severity == \"fatal\" {',\n117|     \"test\": \"TestValidWholeDomainOracle$\",\n118|     \"expect\": \"killed\",\n119|     \"note\": \"valid admits error-finding reports\"},\n120|    # --- order narrowings: strict becomes lax, duplicates admit ---\n121|    {\"id\": \"N-heads-dup\", \"kind\": \"narrowing\",\n122|     \"file\": PKG + \"/decode.go\",\n123|     \"anchor\": \"if index > 0 && value <= values[index-1] {\",\n124|     \"replacement\": \"if index > 0 && value < values[index-1] {\",\n125|     \"test\": \"TestParsedHeadIDsSweep$\",\n126|     \"expect\": \"killed\",\n127|     \"note\": \"heads gate admits duplicates at Build\"},\n128|    {\"id\": \"N-evidence-dup\", \"kind\": \"narrowing\",\n129|     \"file\": PKG + \"/readback.go\",\n130|     \"anchor\": \"(current.EvidenceKind == previous.EvidenceKind && current.BlobID.String() <= previous.BlobID.String())\",\n131|     \"replacement\": \"(current.EvidenceKind == previous.EvidenceKind && current.BlobID.String() < previous.BlobID.String())\",\n132|     \"test\": \"TestEvidenceOrderSweep$\",\n133|     \"expect\": \"killed\",\n134|     \"note\": \"row order admits duplicated (kind, blob) pairs\"},\n135|    # --- count narrowings: edge+1 admits ---\n136|    {\"id\": \"N-evidence-count\", \"kind\": \"narrowing\",\n137|     \"file\": PKG + \"/readback.go\",\n138|     \"anchor\": \"if count < 0 || count > maxEvidenceRows {\",\n139|     \"replacement\": \"if count < 0 || count > maxEvidenceRows+1 {\",\n140|     \"test\": \"TestEvidenceCountEdges$\",\n141|     \"expect\": \"killed\",\n142|     \"note\": \"row count admits 65537 at both entries\"},\n143|    {\"id\": \"N-findings-count-build\", \"kind\": \"narrowing\",\n144|     \"file\": PKG + \"/report.go\",\n145|     \"anchor\": \"sessadapter.DecodeFindings(json.RawMessage(input.Findings), maxReportFindings)\",\n146|     \"replacement\": \"sessadapter.DecodeFindings(json.RawMessage(input.Findings), maxReportFindings+1)\",\n147|     \"test\": \"TestFindingsCountEdges$\",\n148|     \"expect\": \"killed\",\n149|     \"note\": \"findings count admits 4097 at Build\"},\n150|    {\"id\": \"N-findings-count-decode\", \"kind\": \"narrowing\",\n151|     \"file\": PKG + \"/report.go\",\n152|     \"anchor\": 'sessadapter.DecodeFindings(members[\"findings\"], maxReportFindings)',\n153|     \"replacement\": 'sessadapter.DecodeFindings(members[\"findings\"], maxReportFindings+1)',\n154|     \"test\": \"TestFindingsCountEdges$\",\n155|     \"expect\": \"killed\",\n156|     \"note\": \"findings count admits 4097 at Decode\"},\n157|    # --- closed-shape narrowings: admit exactly the probe member ---\n158|    {\"id\": \"N-closed-readback\", \"kind\": \"narrowing\",\n159|     \"file\": PKG + \"/readback.go\",\n160|     \"anchor\": '\"extensions\": true,\\n}',\n161|     \"replacement\": '\"extensions\": true, \"zz_extra_member\": true,\\n}',\n162|     \"test\": \"TestMemberCensusUnknownMissing$\",\n163|     \"expect\": \"killed\",\n164|     \"note\": \"read-back shape admits zz_extra_member at Decode\"},\n165|    {\"id\": \"N-closed-evidence\", \"kind\": \"narrowing\",\n166|     \"file\": PKG + \"/readback.go\",\n167|     \"anchor\": '\"blob_descriptor_id\": true,\\n}',\n168|     \"replacement\": '\"blob_descriptor_id\": true, \"zz_extra_member\": true,\\n}',\n169|     \"test\": \"TestMemberCensusUnknownMissing$\",\n170|     \"expect\": \"killed\",\n171|     \"note\": \"evidence shape admits zz_extra_member at Decode\"},\n172|    {\"id\": \"N-closed-report\", \"kind\": \"narrowing\",\n173|     \"file\": PKG + \"/report.go\",\n174|     \"anchor\": '\"extensions\": true,\\n}',\n175|     \"replacement\": '\"extensions\": true, \"zz_extra_member\": true,\\n}',\n176|     \"test\": \"TestMemberCensusUnknownMissing$\",\n177|     \"expect\": \"killed\",\n178|     \"note\": \"report shape admits zz_extra_member at Decode\"},\n179|    # --- envelope narrowings: admit exactly one neighbor literal ---\n180|    {\"id\": \"N-schema-neighbor\", \"kind\": \"narrowing\",\n181|     \"file\": PKG + \"/readback.go\",\n182|     \"anchor\": \"if !ok || schema != readBackSchema {\",\n183|     \"replacement\": 'if !ok || (schema != readBackSchema && schema != validationSchema) {',\n184|     \"test\": \"TestEnvelopeLiterals$\",\n185|     \"expect\": \"killed\",\n186|     \"note\": \"schema gate admits the sibling URN at Decode\"},\n187|    {\"id\": \"N-version-neighbor\", \"kind\": \"narrowing\",\n188|     \"file\": PKG + \"/readback.go\",\n189|     \"anchor\": \"if !ok || version != readBackVersion {\",\n190|     \"replacement\": 'if !ok || (version != readBackVersion && version != \"2.0.0\") {',\n191|     \"test\": \"TestEnvelopeLiterals$\",\n192|     \"expect\": \"killed\",\n193|     \"note\": \"version gate admits 2.0.0 at Decode\"},\n194|    # --- identity narrowing: admit exactly the relabeled class ---\n195|    {\"id\": \"N-relabel-admit\", \"kind\": \"narrowing\",\n196|     \"file\": PKG + \"/readback.go\",\n197|     \"anchor\": \"\\tif err := verifySelfDigest(members, readBackSelf, claimed); err != nil {\\n\\t\\treturn ReadBackManifest{}, err\\n\\t}\",\n198|     \"replacement\": \"\\tif err := verifySelfDigest(members, readBackSelf, claimed); err != nil {\\n\\t\\tmembers[\\\"mode\\\"] = json.RawMessage(`\\\"staged\\\"`)\\n\\t\\tif retryErr := verifySelfDigest(members, readBackSelf, claimed); retryErr != nil {\\n\\t\\t\\tmembers[\\\"mode\\\"] = json.RawMessage(`\\\"live\\\"`)\\n\\t\\t\\tif retryErr := verifySelfDigest(members, readBackSelf, claimed); retryErr != nil {\\n\\t\\t\\t\\treturn ReadBackManifest{}, err\\n\\t\\t\\t}\\n\\t\\t}\\n\\t}\",\n199|     \"test\": \"TestModeRelabelRefused$\",\n200|     \"expect\": \"killed\",\n201|     \"note\": \"identity admits docs valid under the other mode\"},\n202|    # --- scalar narrowings ---\n203|    {\"id\": \"N-parse-count-edge\", \"kind\": \"narrowing\",\n204|     \"file\": PKG + \"/readback.go\",\n205|     \"anchor\": \"if input.ParsedEventCount > maxUint53 {\",\n206|     \"replacement\": \"if input.ParsedEventCount > maxUint53+1 {\",\n207|     \"test\": \"TestScalarGates$\",\n208|     \"expect\": \"killed\",\n209|     \"note\": \"parsed count admits 2^53 at Build\"},\n210|    # NOTE: N-session-bound was withdrawn after it SURVIVED run1: the\n211|    # expected-ID widening is masked by the sibling observed-bound gate\n212|    # (the killer holds expected==observed). The edge is proven by\n213|    # TestNativeSessionStringEdges; the conjoining gate by\n214|    # N-identity-len. Log preserved in evidence under withdrawn/.\n215|    # --- neutral control: comment-only, must survive ---\n216|    {\"id\": \"N-control-neutral\", \"kind\": \"control\",\n217|     \"file\": PKG + \"/readback.go\",\n218|     \"anchor\": \"// BuildReadBackEvidenceManifest constructs one closed Clone\",\n219|     \"replacement\": \"// control: no semantic change.\\n// BuildReadBackEvidenceManifest constructs one closed Clone\",\n220|     \"test\": \"\",\n221|     \"expect\": \"survived\",\n222|     \"note\": \"comment-only; whole suite must stay green\"},\n223|    # --- structural control plants ---\n224|    {\"id\": \"P-census-entry\", \"kind\": \"plant\",\n225|     \"file\": None,\n226|     \"add_file\": PKG + \"/plant_entry.go\",\n227|     \"add_content\": \"package clonereadback\\n\\n// PlantRowEntry is a control plant: a ninth export carrying\\n// a disposition row. It must redden TestExportedAPIInventory.\\ntype PlantRow struct {\\n\\tDisposition string\\n\\tReasonCodes []string\\n}\\n\\nfunc PlantRowEntry(input PlantRow) error {\\n\\tif input.Disposition == \\\"\\\" {\\n\\t\\treturn invalid(\\\"plant\\\")\\n\\t}\\n\\treturn nil\\n}\\n\",\n228|     \"test\": \"TestExportedAPIInventory$\",\n229|     \"expect\": \"red\",\n230|     \"note\": \"ninth export must redden the API inventory\"},\n231|    {\"id\": \"P-owner-call-removed\", \"kind\": \"plant\",\n232|     \"file\": PKG + \"/readback.go\",\n233|     \"anchor\": \"\\tobservedTuple, err := sessadapter.DecodeTuple(json.RawMessage(input.ObservedEnvironment))\\n\\tif err != nil {\\n\\t\\treturn ReadBackManifest{}, nil, invalid(\\\"%s observed_environment is not an Environment Tuple: %v\\\", owner, err)\\n\\t}\\n\",\n234|     \"replacement\": \"\",\n235|     \"test\": \"TestOwnerReachability$\",\n236|     \"expect\": \"red\",\n237|     \"note\": \"removed owner call reddens reachability (build failure)\"},\n238|    {\"id\": \"P-forked-literal\", \"kind\": \"plant\",\n239|     \"file\": PKG + \"/readback.go\",\n240|     \"anchor\": \"\\toperation, err := scalar.ParseUUIDv7(input.OperationID)\",\n241|     \"replacement\": \"\\t_ = \\\"environment_id\\\"\\n\\toperation, err := scalar.ParseUUIDv7(input.OperationID)\",\n242|     \"test\": \"TestNoForkedLiterals$\",\n243|     \"expect\": \"red\",\n244|     \"note\": \"re-added owner literal reddens the fork guard\"},\n245|    {\"id\": \"P-severity-second\", \"kind\": \"plant\",\n246|     \"file\": PKG + \"/report.go\",\n247|     \"anchor\": \"\\tif err := checkValidAgreement(owner, input.Valid, checks, input.ExpectedTargetNativeSession, input.ObservedTargetNativeSession, findings); err != nil {\",\n248|     \"replacement\": \"\\tfor _, matched := range findings {\\n\\t\\tif matched.Severity == \\\"info\\\" {\\n\\t\\t\\tbreak\\n\\t\\t}\\n\\t}\\n\\tif err := checkValidAgreement(owner, input.Valid, checks, input.ExpectedTargetNativeSession, input.ObservedTargetNativeSession, findings); err != nil {\",\n249|     \"test\": \"TestErrorSeverityDecidedOnDecodedField$\",\n250|     \"expect\": \"red\",\n251|     \"note\": \"second Severity matcher reddens the decider pin\"},\n252|    {\"id\": \"P-guard-literal-list\", \"kind\": \"plant\",\n253|     \"file\": PKG + \"/members_test.go\",\n254|     \"anchor\": \"// TestCensusShapeInventory pins the census coverage itself: 3\",\n255|     \"replacement\": \"// plantMemberList is a control plant: a census-scale literal\\n// member list that must redden TestMemberCensusNoLiteralList.\\nvar plantMemberList = []string{\\\"operation_id\\\", \\\"mode\\\", \\\"projection_plan_id\\\", \\\"projected_object_manifest_id\\\", \\\"expected_target_native_session_id\\\", \\\"observed_target_native_session_id\\\", \\\"observed_environment\\\", \\\"parsed_event_count\\\", \\\"parsed_head_ids\\\", \\\"workspace_binding\\\"}\\n\\n// TestCensusShapeInventory pins the census coverage itself: 3\",\n256|     \"test\": \"TestMemberCensusNoLiteralList$\",\n257|     \"expect\": \"red\",\n258|     \"note\": \"10-name literal list reddens the derivation guard\"},\n259|]\n260|\n261|\n262|def find_root():\n263|    here = os.path.abspath(os.path.dirname(__file__))\n264|    # testdata/ -> package dir -> internal/ -> repo root\n265|    return os.path.dirname(os.path.dirname(os.path.dirname(here)))\n266|\n267|\n268|def run_row(root, row, run_dir):\n269|    pkg_dir = os.path.join(root, PKG)\n270|    added = None\n271|    original = None\n272|    target = None\n273|    if row.get(\"add_file\"):\n274|        added = os.path.join(root, row[\"add_file\"])\n275|        with open(added, \"w\") as handle:\n276|            handle.write(row[\"add_content\"])\n277|    else:\n278|        target = os.path.join(root, row[\"file\"])\n279|        with open(target) as handle:\n280|            original = handle.read()\n281|        anchor = row[\"anchor\"]\n282|        if original.count(anchor) != 1:\n283|            return (\"ERROR\", \"anchor found %d times, want 1\" % original.count(anchor), \"\")\n284|        with open(target, \"w\") as handle:\n285|            handle.write(original.replace(anchor, row[\"replacement\"]))\n286|    cmd = GO_TEST + ([\"-run\", row[\"test\"]] if row[\"test\"] else [])\n287|    proc = subprocess.run(cmd, cwd=root, capture_output=True, text=True, timeout=600)\n288|    raw = (\"$ %s\\nexit=%d\\n--- stdout ---\\n%s\\n--- stderr ---\\n%s\\n\"\n289|           % (\" \".join(cmd), proc.returncode, proc.stdout, proc.stderr))\n290|    log_path = os.path.join(run_dir, row[\"id\"] + \".log\")\n291|    with open(log_path, \"w\") as handle:\n292|        handle.write(\"row: %s\\nkind: %s\\nexpect: %s\\nnote: %s\\ntest: %s\\n%s\"\n293|                     % (row[\"id\"], row[\"kind\"], row[\"expect\"], row[\"note\"],\n294|                        row[\"test\"] or \"(full suite)\", raw))\n295|    verdict = \"SURVIVED\" if proc.returncode == 0 else \"KILLED\"\n296|    if row[\"kind\"] in (\"plant\",):\n297|        verdict = \"GREEN\" if proc.returncode == 0 else \"RED\"\n298|    try:\n299|        if added is not None:\n300|            os.remove(added)\n301|        elif target is not None:\n302|            with open(target, \"w\") as handle:\n303|                handle.write(original)\n304|    except OSError as exc:\n305|        return (\"ERROR\", \"restore failed: %s\" % exc, log_path)\n306|    # Verify the tree is clean after restore.\n307|    if added is None and target is not None:\n308|        with open(target) as handle:\n309|            if handle.read() != original:\n310|                return (\"ERROR\", \"restore mismatch\", log_path)\n311|    return (verdict, \"\", log_path)\n312|\n313|\n314|def main(argv):\n315|    if len(argv) < 2 or argv[1] not in (\"run\", \"list\"):\n316|        print(__doc__)\n317|        return 2\n318|    if argv[1] == \"list\":\n319|        for row in ROWS:\n320|            print(\"%s\\t%s\\t%s\\t%s\" % (row[\"id\"], row[\"kind\"], row[\"expect\"], row[\"test\"] or \"(full)\"))\n321|        return 0\n322|    run_dir = argv[2] if len(argv) > 2 else \"mutant_logs\"\n323|    only = set(argv[3:]) if len(argv) > 3 else None\n324|    root = find_root()\n325|    os.makedirs(run_dir, exist_ok=True)\n326|    failures = 0\n327|    for row in ROWS:\n328|        if only is not None and row[\"id\"] not in only:\n329|            continue\n330|        verdict, err, log_path = run_row(root, row, run_dir)\n331|        want_killed = row[\"expect\"] in (\"killed\", \"red\")\n332|        ok = (verdict in (\"KILLED\", \"RED\")) if want_killed else (verdict == \"SURVIVED\")\n333|        status = \"ok\" if ok else \"MISMATCH\"\n334|        if not ok:\n335|            failures += 1\n336|        print(\"%s\\t%s\\t want=%s\\t%s\\t%s\" % (row[\"id\"], verdict, row[\"expect\"], status, log_path or err))\n337|    print(\"failures=%d\" % failures)\n338|    return 1 if failures else 0\n339|\n340|\n341|if __name__ == \"__main__\":\n342|    sys.exit(main(sys.argv))","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
