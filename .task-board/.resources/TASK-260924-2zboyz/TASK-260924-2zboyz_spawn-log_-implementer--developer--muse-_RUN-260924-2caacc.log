{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c801","stream":{"kind":"session","id":"01a0d474-3d76-7560-9284-b023a445b4ff"},"sequence":603,"recorded_at":1780531400001201,"record_type":"event","durability":"durable","causation_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","run_stream":{"kind":"run","id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27"},"call_id":"call_01a0d476d56c7370970caa885cddea44","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/clonereadback/utf8_test.go`.\n1|package clonereadback_test\n2|\n3|import (\n4|\t\"reflect\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|\n8|\tclonereadback \"github.com/relux-works/agent-session-manager/internal/clonereadback\"\n9|)\n10|\n11|// This file proves by reflection that invalid UTF-8 is refused at\n12|// every Build-side string gate: the walker derives every string\n13|// field of the production input types (nested rows included) and\n14|// feeds each lone-invalid bytes plus trailing-invalid bytes. Raw\n15|// JSON members ride owner decoders; the owner suites pin their\n16|// UTF-8 behavior, and the delegation table pins the wiring.\n17|\n18|// stringField describes one derived Build-side string: a setter\n19|// over a fresh valid input plus the refusal literal.\n20|type stringField struct {\n21|\tlabel  string\n22|\tset    func(valid clonereadback.ReadBackManifestInput, validReport clonereadback.ValidationReportInput, value string) (clonereadback.ReadBackManifestInput, clonereadback.ValidationReportInput, bool)\n23|\tmember string\n24|}\n25|\n26|// buildUTF8Fields derives every string field of the two input\n27|// types by reflection. The derivation fails loudly on any field\n28|// kind it cannot classify; the inventory test pins the exact field\n29|// count so a silently skipped string is a red test, not a gap.\n30|func buildUTF8Fields(t *testing.T) []stringField {\n31|\tt.Helper()\n32|\tvar fields []stringField\n33|\tcollectStrings(t, reflect.TypeOf(clonereadback.ReadBackManifestInput{}), \"readback\", &fields)\n34|\tcollectStrings(t, reflect.TypeOf(clonereadback.EvidenceObjectInput{}), \"evidence\", &fields)\n35|\tcollectStrings(t, reflect.TypeOf(clonereadback.ValidationReportInput{}), \"report\", &fields)\n36|\treturn fields\n37|}\n38|\n39|func collectStrings(t *testing.T, typ reflect.Type, shape string, fields *[]stringField) {\n40|\tt.Helper()\n41|\tfor index := 0; index < typ.NumField(); index++ {\n42|\t\tfield := typ.Field(index)\n43|\t\tif field.PkgPath != \"\" {\n44|\t\t\tt.Fatalf(\"unexported field %s.%s: extend the walker\", shape, field.Name)\n45|\t\t}\n46|\t\tmember := snakeMember(field.Name)\n47|\t\tif irregular, ok := irregularMembers[field.Name]; ok {\n48|\t\t\tmember = irregular\n49|\t\t}\n50|\t\tswitch field.Type.Kind() {\n51|\t\tcase reflect.String:\n52|\t\t\tname := field.Name\n53|\t\t\tshapeName := shape\n54|\t\t\tmemberName := member\n55|\t\t\t*fields = append(*fields, stringField{\n56|\t\t\t\tlabel:  shapeName + \".\" + name,\n57|\t\t\t\tmember: memberName,\n58|\t\t\t\tset: func(valid clonereadback.ReadBackManifestInput, validReport clonereadback.ValidationReportInput, value string) (clonereadback.ReadBackManifestInput, clonereadback.ValidationReportInput, bool) {\n59|\t\t\t\t\tswitch shapeName {\n60|\t\t\t\t\tcase \"readback\":\n61|\t\t\t\t\t\treflect.ValueOf(&valid).Elem().FieldByName(name).SetString(value)\n62|\t\t\t\t\t\treturn valid, validReport, true\n63|\t\t\t\t\tcase \"report\":\n64|\t\t\t\t\t\treflect.ValueOf(&validReport).Elem().FieldByName(name).SetString(value)\n65|\t\t\t\t\t\treturn valid, validReport, false\n66|\t\t\t\t\tcase \"evidence\":\n67|\t\t\t\t\t\tvalid.EvidenceObjects = []clonereadback.EvidenceObjectInput{validEvidenceInput(\"native_sample\", \"utf8\")}\n68|\t\t\t\t\t\treflect.ValueOf(&valid.EvidenceObjects[0]).Elem().FieldByName(name).SetString(value)\n69|\t\t\t\t\t\treturn valid, validReport, true\n70|\t\t\t\t\t}\n71|\t\t\t\t\treturn valid, validReport, true\n72|\t\t\t\t},\n73|\t\t\t})\n74|\t\tcase reflect.Bool, reflect.Uint64, reflect.Map:\n75|\t\t\t// Non-string leaves: nothing to feed.\n76|\t\tcase reflect.Slice, reflect.Array:\n77|\t\t\telement := field.Type.Elem()\n78|\t\t\tswitch element.Kind() {\n79|\t\t\tcase reflect.Uint8, reflect.Struct:\n80|\t\t\t\t// Raw JSON and nested rows: rows are walked\n81|\t\t\t\t// as their own type above; raw JSON rides\n82|\t\t\t\t// owner decoders.\n83|\t\t\tcase reflect.String:\n84|\t\t\t\tif field.Name != \"ParsedHeadIDs\" {\n85|\t\t\t\t\tt.Fatalf(\"string slice %s.%s is not the heads member: extend the walker\", shape, field.Name)\n86|\t\t\t\t}\n87|\t\t\tdefault:\n88|\t\t\t\tt.Fatalf(\"unhandled slice element kind %s at %s.%s: extend the walker\", element.Kind(), shape, field.Name)\n89|\t\t\t}\n90|\t\tdefault:\n91|\t\t\tt.Fatalf(\"unhandled kind %s at %s.%s: extend the walker\", field.Type.Kind(), shape, field.Name)\n92|\t\t}\n93|\t}\n94|}\n95|\n96|// TestBuildUTF8Reflection feeds invalid UTF-8 to every derived\n97|// Build-side string field at the production Build entries: each\n98|// refuses with its member literal.\n99|func TestBuildUTF8Reflection(t *testing.T) {\n100|\tpoison := []string{string([]byte{0xff}), \"ok-prefix-\\xff\", \"\\xff-ok-suffix\"}\n101|\tfor _, field := range buildUTF8Fields(t) {\n102|\t\tfor _, value := range poison {\n103|\t\t\tinput, rinput, isReadBack := field.set(validReadBackInput(), validReportInput(), value)\n104|\t\t\tif isReadBack {\n105|\t\t\t\t_, err := clonereadback.BuildReadBackEvidenceManifest(input)\n106|\t\t\t\tif err == nil {\n107|\t\t\t\t\tt.Fatalf(\"field %s admits invalid UTF-8 at Build\", field.label)\n108|\t\t\t\t}\n109|\t\t\t\tif !strings.Contains(err.Error(), field.member) {\n110|\t\t\t\t\tt.Fatalf(\"field %s error %q misses member literal %q\", field.label, err.Error(), field.member)\n111|\t\t\t\t}\n112|\t\t\t} else {\n113|\t\t\t\t_, err := clonereadback.BuildValidationReport(rinput)\n114|\t\t\t\tif err == nil {\n115|\t\t\t\t\tt.Fatalf(\"field %s admits invalid UTF-8 at Build\", field.label)\n116|\t\t\t\t}\n117|\t\t\t\tif !strings.Contains(err.Error(), field.member) {\n118|\t\t\t\t\tt.Fatalf(\"field %s error %q misses member literal %q\", field.label, err.Error(), field.member)\n119|\t\t\t\t}\n120|\t\t\t}\n121|\t\t}\n122|\t}\n123|}\n124|\n125|// TestBuildUTF8HeadsAndExtensions feeds invalid UTF-8 to the heads\n126|// array items and one extension value at both production Build\n127|// entries.\n128|func TestBuildUTF8HeadsAndExtensions(t *testing.T) {\n129|\tinput := validReadBackInput()\n130|\tinput.ParsedHeadIDs = []string{\"head-a\", \"bad-\\xff\"}\n131|\t_, err := clonereadback.BuildReadBackEvidenceManifest(input)\n132|\trequireRefusal(t, err, \"read-back evidence manifest\", \"parsed_head_ids\")\n133|\tinput = validReadBackInput()\n134|\tinput.Extensions = map[string]any{\"com.example.note\": \"bad-\\xff\"}\n135|\t_, err = clonereadback.BuildReadBackEvidenceManifest(input)\n136|\trequireRefusal(t, err, \"read-back evidence manifest\", \"extensions invalid\")\n137|\trinput := validReportInput()\n138|\trinput.Extensions = map[string]any{\"com.example.note\": \"bad-\\xff\"}\n139|\t_, err = clonereadback.BuildValidationReport(rinput)\n140|\trequireRefusal(t, err, \"clone validation report\", \"extensions invalid\")\n141|}\n142|\n143|// TestUTF8FieldInventory pins the derivation count: 7 read-back\n144|// strings, 4 evidence strings, 9 report strings.\n145|func TestUTF8FieldInventory(t *testing.T) {\n146|\tfields := buildUTF8Fields(t)\n147|\tcounts := map[string]int{}\n148|\tfor _, field := range fields {\n149|\t\tshape := field.label[:strings.Index(field.label, \".\")]\n150|\t\tcounts[shape]++\n151|\t}\n152|\tif counts[\"readback\"] != 7 || counts[\"evidence\"] != 4 || counts[\"report\"] != 9 {\n153|\t\tt.Fatalf(\"utf8 fields = %v, want readback=7 evidence=4 report=9\", counts)\n154|\t}\n155|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c803","stream":{"kind":"session","id":"01a0d474-3d76-7560-9284-b023a445b4ff"},"sequence":604,"recorded_at":1780531400001203,"record_type":"event","durability":"durable","causation_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","run_stream":{"kind":"run","id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27"},"call_id":"call_01a0d476d7677669a083636828f1430d","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/clonereadback/TRACEABILITY.md`.\n1|# TRACEABILITY — internal/clonereadback\n2|\n3|Fourth leaf of STORY-260830-21bxa3 (M4): Clone Read-Back Evidence\n4|Manifest 1.0.0 and Clone Validation Report 1.0.0 as closed schemas\n5|with JCS identities, pinned to SPEC v0.7.0 §13.14.2. Reconciliation\n6|completeness and the Story registry belong to the final leaf\n7|(TASK-260830-1esv6u); this package gates each shape closed and\n8|internally coherent, never across inputs.\n9|\n10|Authority quotes below come from\n11|`internal/specdoc/SPEC.v0.7.0.md` (pinned v0.7.0). Line numbers are\n12|1-based.\n13|\n14|## Axis inventory (written first)\n15|\n16|Every gate axis the conformance matrix walks, with its domain:\n17|\n18|| Axis | Domain | Oracle |\n19||---|---|---|\n20|| A1 shape members | every member of readback (16), evidence (5), report (23), derived by reflection over the input types | missing/extra/duplicated/miscased/wrong-type refused with the member literal at every entry |\n21|| A2 schema/version | the two literal pairs from the registry (lines 170-171) | sibling URNs, 2.0.0/1.0 versions refused |\n22|| A3 read-back mode | staged\\|live (line 10739) | 17 closed members + neighbors incl. invalid UTF-8 refused at Build, Decode, predicate |\n23|| A4 evidence kind | native_sample\\|parser_trace\\|marker_observation (lines 10748-10751) | 3 closed + 14 neighbors refused at Build, Decode, predicate |\n24|| A5 native-ID equality | equal vs unequal vs empty pairs | equal seals; unequal refuses (read-back) / decides valid=false (report) |\n25|| A6 valid rule | 2^7 check outcomes × ID eq/neq × 6 finding classes = 1536 combos | decided bit seals, flipped bit refuses, at Build and Decode |\n26|| A7 string bounds | [1..512] native IDs/heads, [1..128] media, chars not bytes | 0/1/512/513 and 127/128/129 ASCII + multibyte at edge |\n27|| A8 heads order | sorted unique [0..1024] | unsorted/dup/overlong refuse; 1024 admits, 1025 refuses |\n28|| A9 evidence order | sorted unique by (kind, blob) | 6 permutations admit 1; same-kind blob order; dup refuses |\n29|| A10 counts | evidence [0..65536], findings [0..4096] | 0/edge admit, edge+1 refuses at both entries |\n30|| A11 uint53/number | canonical integers, 2^53-1 max | 2^53, float, exponent, string, bool, null refuse |\n31|| A12 scalars | UUIDv7 operation, sha256 digests | v4/malformed refuse |\n32|| A13 owner nesting | tuple/binding/findings documents | broken nested docs refuse with owner detail at every entry |\n33|| A14 extensions | reverse-DNS closed | open keys refuse at every entry |\n34|| A15 identity | JCS digest omitting only the self member | independent recompute agrees; other-member omission disagrees; tamper refuses; relabel refuses |\n35|| A16 UTF-8 | every Build-side string (7+4+9 derived fields) + heads + extensions | lone/trailing invalid bytes refuse with the member literal |\n36|| A17 ownership | 8 exports, 0 carrying fidelity/plan rows | row census empty; reachability to landed owners; no fork literals/selectors/imports |\n37|\n38|## Clause map (spec sentence → gate → test)\n39|\n40|| # | Pinned clause | Gate | Production site | Test |\n41||---|---|---|---|---|\n42|| C1 | \"Clone Read-Back Evidence Manifest 1.0.0 contains exactly its schema/version\" + 15 members (10737-10747) | closed shape, 16 members | `DecodeReadBackEvidenceManifest`, `buildReadBackManifest` renders | `TestMemberCensus*` (readback/evidence) |\n43|| C2 | \"`read_back_evidence_manifest_id` under the omission rule\" (10738) | JCS identity | `Build…` seals, `verifySelfDigest` | `TestReadBackIdentityIndependent` |\n44|| C3 | \"`mode:staged\\|live`\" (10739) | closed mode | `ValidReadBackMode`, both entries | `TestModeVocabularyOracle` |\n45|| C4 | \"equal expected and observed native Session IDs\" (10741-10742) | equality | `checkNativeIdentityMatch`, both entries | `TestNativeIdentityEqualityOracle` |\n46|| C5 | \"`observed_environment:EnvironmentTuple`\" (10742) | owner tuple | `sessadapter.DecodeTuple` at both entries | `TestOwnerDelegation` |\n47|| C6 | \"`parsed_event_count:uint53`\" (10743) | uint53, no derivation (bound) | `checkUint53Bounds` / `> maxUint53` | `TestScalarGates`, `TestParsedCountAndStructuralDigestAreStatedBounds` |\n48|| C7 | \"`parsed_head_ids:sorted unique string[1..512][0..1024]`\" (10744) | sorted-unique | `checkSortedUniqueBoundedStrings` / environ | `TestParsedHeadIDsSweep` |\n49|| C8 | \"`workspace_binding:WorkspaceBinding`\" (10745) | owner binding | `clonebundle.DecodeWorkspaceBinding` | `TestOwnerDelegation` |\n50|| C9 | \"`structural_digest:digest`\" (10746) | digest, no derivation (bound) | `scalar.ParseDigest` / `checkDigest` | `TestScalarGates`, stated-bound test |\n51|| C10 | \"`evidence_objects:EvidenceObject[0..65536]`\" (10747) | count + row shape | `checkEvidenceCount`, row build/decode | `TestEvidenceCountEdges`, census |\n52|| C11 | \"`EvidenceObject` contains exactly…\" (10748-10751) | 5-member row, closed kind | `buildEvidenceObject`, `decodeEvidenceObject` | `TestMemberCensus*` (evidence), kind oracle |\n53|| C12 | \"Evidence rows are sorted unique by evidence kind/blob ID.\" (10752) | row order | `checkEvidenceOrder`, both entries | `TestEvidenceOrderSweep` |\n54|| C13 | \"Staged and live manifests are distinct and cannot be relabeled.\" (10753-10754) + \"Modes cannot be relabeled.\" (10580) | mode binds identity | identity covers mode | `TestModeRelabelRefused`, `TestModeBindsIdentity` |\n55|| C14 | \"`schema=urn:ax:schema:clone-validation-report`, `schema_version=1.0.0`\" (10756-10758) + 20 members (10758-10776) | closed shape, 23 members | `DecodeValidationReport`, `buildValidationReport` renders | `TestMemberCensus*` (report) |\n56|| C15 | \"`validation_report_id:digest` under the omission rule\" (10759) | JCS identity | `Build…` seals, `verifySelfDigest` | `TestReportIdentityIndependent` |\n57|| C16 | six manifest/fidelity digest refs + operation UUID (10760-10765) | opaque refs (no cross-check; reconciliation owns pairing) | scalar gates | `TestScalarGates` |\n58|| C17 | expected/observed IDs `string[1..512]` (10766-10767) | bounds; equality decides valid | bound gates + `decideValid` | string edges, valid oracle |\n59|| C18 | \"`target_environment:EnvironmentTuple`\" (10768) | owner tuple (cross-match is reconciliation) | `sessadapter.DecodeTuple` | `TestOwnerDelegation`, `TestReportTupleMatchIsReconciliationBound` |\n60|| C19 | seven check booleans (10769-10774) | required non-null booleans | `decodeValidationChecks` / Go bools | wrong-type census (null probe), oracle |\n61|| C20 | \"`findings:AdapterFinding[0..4096]`\" (10775) | owner findings + count | `sessadapter.DecodeFindings(·, 4096)` | `TestFindingsCountEdges`, delegation |\n62|| C21 | \"`valid=true` requires every boolean true, matching native IDs/tuple, and no error finding.\" (10776-10777) + \"every applicable check must pass\" (10582) | valid iff all-true ∧ IDs equal ∧ no error (tuple cross-match → reconciliation) | `decideValid` + `checkValidAgreement`, both entries | `TestValidWholeDomainOracle` (1536 combos) |\n63|| C22 | \"`extensions`\" on both shapes + registry URNs at 1.0.0 (170-171) | closed extensions, literal envelope | `clonebundle` extensions owner | `TestExtensionsClosed`, `TestEnvelopeLiterals` |\n64|\n65|Member-name derivation note: the pinned text states the\n66|read-back native-ID RULE (\"equal expected and observed native\n67|Session IDs\") without member names; the member names\n68|`expected/observed_target_native_session_id` follow the\n69|validation-report table (C17) and the read-back adapter success\n70|body (line 3843: `observed_target_native_session_id`), which spell\n71|both. The census exact-set test fails if production drifts from\n72|this spelling.\n73|\n74|## Gate × entry table\n75|\n76|Every production entry that reaches a gate is its own cell. B =\n77|Build refuses/admits, D = Decode refuses/admits, P = predicate.\n78|\n79|| Gate | BuildReadBack | DecodeReadBack | BuildReport | DecodeReport | Predicates |\n80||---|---|---|---|---|---|\n81|| closed members (A1) | renders exact¹ | refuses | renders exact¹ | refuses | — |\n82|| schema/version literals (A2) | renders | refuses | renders | refuses | — |\n83|| mode vocab (A3) | refuses | refuses | — | — | `ValidReadBackMode` |\n84|| evidence kind vocab (A4) | refuses | refuses | — | — | `ValidEvidenceKind` |\n85|| native-ID equality (A5) | refuses | refuses | decides | decides | — |\n86|| valid rule (A5/A6) | — | — | refuses flipped | refuses flipped | — |\n87|| string bounds chars (A7) | refuses | refuses | refuses | refuses | — |\n88|| heads order (A8) | refuses | refuses (owner) | — | — | — |\n89|| evidence order (A9) | refuses | refuses | — | — | — |\n90|| evidence count (A10) | refuses | refuses | — | — | — |\n91|| findings count (A10) | — | — | refuses (owner max) | refuses (owner max) | — |\n92|| uint53/number (A11) | refuses | refuses (owner) | — | — | — |\n93|| scalars (A12) | refuses | refuses | refuses | refuses | — |\n94|| owner nesting (A13) | refuses w/ owner detail | refuses w/ owner detail | refuses w/ owner detail | refuses w/ owner detail | — |\n95|| extensions (A14) | refuses | refuses | refuses | refuses | — |\n96|| identity (A15) | computes | verifies | computes | verifies | — |\n97|| UTF-8 (A16) | refuses | n/a (JSON) | refuses | n/a (JSON) | predicates return false |\n98|\n99|¹ \"renders exact\" is pinned by `TestMemberCensusExactSets`\n100|(derived set vs sealed bytes), not by a refusal.\n101|\n102|## Mutant table (narrowing per gate, killed alone)\n103|\n104|Harness: `testdata/mutant_harness.py`. One raw log per plant per\n105|run carries the subprocess exit; the battery runs twice. All rows\n106|below are NARROWING (the gate stays present and admits exactly one\n107|forbidden member) except the marked control. No arm-deletes.\n108|\n109|| Mutant | Gate | Admits exactly | Killer (run alone) | Run1 | Run2 |\n110||---|---|---|---|---|---|\n111|| N-mode-archived | A3 | `archived` mode | `TestModeVocabularyOracle` | KILLED | KILLED |\n112|| N-kind-native | A4 | `native` kind | `TestEvidenceKindVocabularyOracle` | KILLED | KILLED |\n113|| N-identity-len | A5 read-back | same-length-differing IDs | `TestNativeIdentityEqualityOracle` | KILLED | KILLED |\n114|| N-valid-drop-staged | A6 | staged-false + valid=true | `TestValidWholeDomainOracle` | KILLED | KILLED |\n115|| N-valid-drop-live | A6 | live-false + valid=true | `TestValidWholeDomainOracle` | KILLED | KILLED |\n116|| N-valid-drop-marker | A6 | marker-false + valid=true | `TestValidWholeDomainOracle` | KILLED | KILLED |\n117|| N-valid-drop-identity | A6 | identity-false + valid=true | `TestValidWholeDomainOracle` | KILLED | KILLED |\n118|| N-valid-drop-binding | A6 | binding-false + valid=true | `TestValidWholeDomainOracle` | KILLED | KILLED |\n119|| N-valid-drop-resume | A6 | resume-false + valid=true | `TestValidWholeDomainOracle` | KILLED | KILLED |\n120|| N-valid-drop-generation | A6 | generation-false + valid=true | `TestValidWholeDomainOracle` | KILLED | KILLED |\n121|| N-valid-drop-ids | A6 | ID-mismatch + valid=true | `TestValidWholeDomainOracle` | KILLED | KILLED |\n122|| N-valid-drop-error | A6 | error finding + valid=true | `TestValidWholeDomainOracle` | KILLED | KILLED |\n123|| N-heads-dup | A8 Build | duplicated heads | `TestParsedHeadIDsSweep` | KILLED | KILLED |\n124|| N-evidence-dup | A9 | duplicated (kind, blob) | `TestEvidenceOrderSweep` | KILLED | KILLED |\n125|| N-evidence-count | A10 | 65537 rows, both entries | `TestEvidenceCountEdges` | KILLED | KILLED |\n126|| N-findings-count-build | A10 | 4097 findings at Build | `TestFindingsCountEdges` | KILLED | KILLED |\n127|| N-findings-count-decode | A10 | 4097 findings at Decode | `TestFindingsCountEdges` | KILLED | KILLED |\n128|| N-closed-readback | A1 | `zz_extra_member` in shape | `TestMemberCensusUnknownMissing` | KILLED | KILLED |\n129|| N-closed-evidence | A1 | `zz_extra_member` in row | `TestMemberCensusUnknownMissing` | KILLED | KILLED |\n130|| N-closed-report | A1 | `zz_extra_member` in shape | `TestMemberCensusUnknownMissing` | KILLED | KILLED |\n131|| N-schema-neighbor | A2 | sibling URN as schema | `TestEnvelopeLiterals` | KILLED | KILLED |\n132|| N-version-neighbor | A2 | `2.0.0` as version | `TestEnvelopeLiterals` | KILLED | KILLED |\n133|| N-relabel-admit | A15/C13 | docs valid under the other mode | `TestModeRelabelRefused` | KILLED | KILLED |\n134|| N-parse-count-edge | A11 Build | 2^53 count | `TestScalarGates` | KILLED | KILLED |\n135|| N-control-neutral | control | nothing (comment-only) | full suite | SURVIVED | SURVIVED |\n136|| P-census-entry | A17 plant | ninth export carrying a row | `TestExportedAPIInventory` | RED | RED |\n137|| P-owner-call-removed | A17 plant | (removed owner call) | `TestOwnerReachability` | RED¹ | RED¹ |\n138|| P-forked-literal | A17 plant | re-added owner literal | `TestNoForkedLiterals` | RED | RED |\n139|| P-severity-second | A17 plant | second Severity matcher | `TestErrorSeverityDecidedOnDecodedField` | RED | RED |\n140|| P-guard-literal-list | A1 plant | 10-name literal list | `TestMemberCensusNoLiteralList` | RED | RED |\n141|\n142|¹ red via build failure (the removed call leaves the variable\n143|undefined): the pin depends on the call's presence.\n144|\n145|Kill-mechanism honesty: N-closed-*, N-schema-neighbor, and\n146|N-version-neighbor admit past the weakened gate and are then\n147|refused downstream by the identity gate; the killer fails on the\n148|changed refusal literal, which proves the weakened gate's presence\n149|and literal for the admitted member. N-valid-drop-* disagree with\n150|the spec-derived oracle (never with production), which is the kill.\n151|N-session-bound was WITHDRAWN after it survived the first battery:\n152|a single-member bound widening is masked by the sibling bound gate\n153|under the equality constraint; the edge is proven by\n154|`TestNativeSessionStringEdges` and the conjoining gate by\n155|N-identity-len. Its log rides the evidence tar under `withdrawn/`.\n156|\n157|## Importer outcome grid\n158|\n159|This leaf adds `internal/clonereadback` (new files only) and edits\n160|no landed file: the tracked tree equals the story tip (`5e40826`\n161|= trunk `6d3bff9` + the three signed story checkpoints), so the\n162|five reused owner packages are byte-identical between base and\n163|candidate and their suites are green on the candidate tree — no\n164|input class moved. The grid is keyed (package, entry, input).\n165|Base is the story tip; candidate is the uncommitted tree.\n166|\n167|| Package | Entry | Input classes through this leaf | Base | Candidate | Moved |\n168||---|---|---|---|---|---|\n169|| `internal/environ` | `DecodeStrictObject` | valid objects; dup-member / trailing-data / non-object docs | green | green | none |\n170|| `internal/environ` | `StringLength` | ASCII + multibyte at every bound | green | green | none |\n171|| `internal/environ` | `CheckStringBounds` | in-bound; over-max / under-min / non-string | green | green | none |\n172|| `internal/environ` | `CheckUint53Bounds` | in-bound; fraction / exponent / string / 2^53 | green | green | none |\n173|| `internal/environ` | `CheckDigest` | valid sha256; malformed | green | green | none |\n174|| `internal/environ` | `CheckUUIDv7` | valid v7; v4 / malformed | green | green | none |\n175|| `internal/environ` | `CheckSortedUniqueStrings` | sorted-unique; unsorted / dup / over-count | green | green | none |\n176|| `internal/scalar` | `ParseDigest` / `ParseUUIDv7` | valid; malformed | green | green | none |\n177|| `internal/scalar` | `SHA256Digest` | canonical omit-self bytes | green | green | none |\n178|| `internal/canonicaljson` | `Canonicalize` | manifest / report / row objects | green | green | none |\n179|| `internal/clonebundle` | `EncodeExtensions` | closed maps; bad keys / values | green | green | none |\n180|| `internal/clonebundle` | `CheckExtensionsClosed` | closed; open / nested-dup | green | green | none |\n181|| `internal/clonebundle` | `OmitSelfDigest` | member maps + self field; tampered claims | green | green | none |\n182|| `internal/clonebundle` | `DecodeWorkspaceBinding` | valid bindings; broken bindings | green | green | none |\n183|| `internal/sessadapter` | `DecodeTuple` | valid tuples; broken tuples | green | green | none |\n184|| `internal/sessadapter` | `DecodeFindings` | valid arrays; broken rows / over-count | green | green | none |\n185|| `internal/clonereadback` | `BuildReadBackEvidenceManifest` | valid manifest; every invalid class in the clause map | n/a (new) | green | none (new surface, no importer yet) |\n186|| `internal/clonereadback` | `DecodeReadBackEvidenceManifest` | sealed manifest; mutated / hand-built docs | n/a (new) | green | none |\n187|| `internal/clonereadback` | `BuildValidationReport` | valid report; every invalid class incl. flipped valid | n/a (new) | green | none |\n188|| `internal/clonereadback` | `DecodeValidationReport` | sealed report; mutated / hand-built docs | n/a (new) | green | none |\n189|| `internal/clonereadback` | 4 vocabulary helpers | in-vocabulary; neighbors incl. invalid UTF-8 | n/a (new) | green | none |\n190|\n191|No `internal/clonefidelity` or `internal/cloneplan` row: no entry\n192|carries their row shapes (references are digests), pinned by\n193|`TestOwnerRowCensusIsEmpty` + `TestNoOwnerImports`.\n194|\n195|## Stated bounds (sibling scope or spec-silent, not waived)\n196|\n197|- Report \"matching tuple\" needs the read manifests' observed\n198|  tuples as cross-inputs; only the single-tuple shape is gated\n199|  here. Owned by the final reconciliation leaf.\n200|- Cross-input pairing (plan/projected/staged/live/fidelity IDs\n201|  cohere) needs the sibling inputs; digests are opaque here. Final\n202|  leaf.\n203|- `parsed_event_count` carries no stated derivation from heads or\n204|  rows; any uint53 admits. Spec-silent.\n205|- `structural_digest` carries no stated preimage; any digest\n206|  admits. Spec-silent.\n207|- Blob descriptor agreement (descriptor vs blob ID + byte count)\n208|  needs an object store; these entries take no fetch. Unverified\n209|  here by construction.\n210|- `parsed_event_count` vs `parsed_head_ids` cardinality: no stated\n211|  relation; independent bounds only.\n212|- Single-member native-ID bound narrowings are masked by the\n213|  sibling bound under the equality constraint (see mutant table);\n214|  edges proven directly.","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
