{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c701","stream":{"kind":"session","id":"01a0d474-3d76-7560-9284-b023a445b4ff"},"sequence":475,"recorded_at":1780531400000945,"record_type":"event","durability":"durable","causation_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","run_stream":{"kind":"run","id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27"},"call_id":"call_01a0d476943c71a69ab622872acc7670","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/clonereadback/fixtures_test.go`.\n1|package clonereadback_test\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"encoding/json\"\n7|\t\"fmt\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\n11|\tclonereadback \"github.com/relux-works/agent-session-manager/internal/clonereadback\"\n12|)\n13|\n14|// This file builds the valid baseline inputs every conformance test\n15|// mutates: deterministic digests, UUIDv7 operation IDs, owner-valid\n16|// tuple/binding/finding documents, and the must-build/must-decode\n17|// seams.\n18|\n19|// fixtureDigest renders a deterministic pinned-form digest for one\n20|// seed.\n21|func fixtureDigest(seed string) string {\n22|\tsum := sha256.Sum256([]byte(\"clonereadback:\" + seed))\n23|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n24|}\n25|\n26|// fixtureOperationID renders a deterministic lowercase UUIDv7: the\n27|// time field pins the seed hash, the version nibble pins 7, and the\n28|// variant bits pin 10.\n29|func fixtureOperationID(seed string) string {\n30|\tsum := sha256.Sum256([]byte(\"clonereadback-operation:\" + seed))\n31|\thexed := hex.EncodeToString(sum[:])\n32|\ttimeField := hexed[:12]\n33|\trandA := hexed[12:15]\n34|\trandB := hexed[16:28]\n35|\treturn timeField[:8] + \"-\" + timeField[8:12] + \"-7\" + randA + \"-8\" + randB[:3] + \"-\" + randB[3:12] + hexed[28:31]\n36|}\n37|\n38|// fixtureTuple is one owner-valid Environment Tuple document.\n39|func fixtureTuple() []byte {\n40|\treturn []byte(`{\"adapter_version\":\"1.2.3\",\"architecture\":\"arm64\",\"environment_id\":\"relux.target\",\"environment_version\":\"2026.09\",\"platform\":\"macos\",\"store_schema_fingerprint\":\"` + fixtureDigest(\"store-fingerprint\") + `\"}`)\n41|}\n42|\n43|// fixtureBinding is one owner-valid Workspace Binding document.\n44|func fixtureBinding() []byte {\n45|\tfirst, second := fixtureDigest(\"remote-a\"), fixtureDigest(\"remote-b\")\n46|\tif second < first {\n47|\t\tfirst, second = second, first\n48|\t}\n49|\treturn []byte(`{\"branch\":\"main\",\"cwd_relative\":\"work/session\",\"extensions\":{},\"head_digest\":\"` + fixtureDigest(\"head\") + `\",\"index_digest\":null,\"logical_workspace_id\":\"` + fixtureOperationID(\"workspace\") + `\",\"repository_remote_fingerprints\":[\"` + first + `\",\"` + second + `\"],\"working_tree_digest\":null}`)\n50|}\n51|\n52|// fixtureFinding renders one owner-valid Adapter Finding document\n53|// with the given severity.\n54|func fixtureFinding(severity, code string) string {\n55|\treturn `{\"code\":\"` + code + `\",\"extensions\":{},\"message\":\"finding ` + code + `\",\"remediation\":null,\"severity\":\"` + severity + `\"}`\n56|}\n57|\n58|// fixtureFindings renders one owner-valid findings array over the\n59|// given severities.\n60|func fixtureFindings(severities ...string) []byte {\n61|\tvar rows []string\n62|\tfor index, severity := range severities {\n63|\t\trows = append(rows, fixtureFinding(severity, fmt.Sprintf(\"probe-%04d\", index)))\n64|\t}\n65|\treturn []byte(\"[\" + strings.Join(rows, \",\") + \"]\")\n66|}\n67|\n68|// validEvidenceInput renders one valid evidence row candidate with a\n69|// caller-chosen kind and blob seed.\n70|func validEvidenceInput(kind, seed string) clonereadback.EvidenceObjectInput {\n71|\treturn clonereadback.EvidenceObjectInput{\n72|\t\tEvidenceKind:     kind,\n73|\t\tMediaType:        \"application/octet-stream\",\n74|\t\tByteCount:        64,\n75|\t\tBlobID:           fixtureDigest(\"blob-\" + seed),\n76|\t\tBlobDescriptorID: fixtureDigest(\"descriptor-\" + seed),\n77|\t}\n78|}\n79|\n80|// validReadBackInput renders one valid read-back manifest candidate:\n81|// staged mode, two evidence rows in (kind, blob) order.\n82|func validReadBackInput() clonereadback.ReadBackManifestInput {\n83|\tsecond := validEvidenceInput(\"parser_trace\", \"trace\")\n84|\tfirst := validEvidenceInput(\"native_sample\", \"sample\")\n85|\treturn clonereadback.ReadBackManifestInput{\n86|\t\tOperationID:                 fixtureOperationID(\"read-back\"),\n87|\t\tMode:                        \"staged\",\n88|\t\tProjectionPlanID:            fixtureDigest(\"plan\"),\n89|\t\tProjectedObjectManifestID:   fixtureDigest(\"projected\"),\n90|\t\tExpectedTargetNativeSession: \"target-native-session-1\",\n91|\t\tObservedTargetNativeSession: \"target-native-session-1\",\n92|\t\tObservedEnvironment:         fixtureTuple(),\n93|\t\tParsedEventCount:            41,\n94|\t\tParsedHeadIDs:               []string{\"head-a\", \"head-b\"},\n95|\t\tWorkspaceBinding:            fixtureBinding(),\n96|\t\tStructuralDigest:            fixtureDigest(\"structural\"),\n97|\t\tEvidenceObjects:             []clonereadback.EvidenceObjectInput{first, second},\n98|\t\tExtensions:                  map[string]any{},\n99|\t}\n100|}\n101|\n102|// validReportInput renders one valid validation report candidate:\n103|// every check true, matching IDs, one info finding, valid true.\n104|func validReportInput() clonereadback.ValidationReportInput {\n105|\treturn clonereadback.ValidationReportInput{\n106|\t\tOperationID:                      fixtureOperationID(\"report\"),\n107|\t\tProjectionPlanID:                 fixtureDigest(\"plan\"),\n108|\t\tProjectedObjectManifestID:        fixtureDigest(\"projected\"),\n109|\t\tStagedReadBackEvidenceManifestID: fixtureDigest(\"staged\"),\n110|\t\tLiveReadBackEvidenceManifestID:   fixtureDigest(\"live\"),\n111|\t\tTargetProviderManifestID:         fixtureDigest(\"provider\"),\n112|\t\tFidelityReportID:                 fixtureDigest(\"fidelity\"),\n113|\t\tExpectedTargetNativeSession:      \"target-native-session-1\",\n114|\t\tObservedTargetNativeSession:      \"target-native-session-1\",\n115|\t\tTargetEnvironment:                fixtureTuple(),\n116|\t\tStagedStructuralValid:            true,\n117|\t\tLiveStructuralValid:              true,\n118|\t\tSemanticMarkerValid:              true,\n119|\t\tIdentityValid:                    true,\n120|\t\tWorkspaceBindingValid:            true,\n121|\t\tResumeSurfaceValid:               true,\n122|\t\tSourceGenerationRevalidated:      true,\n123|\t\tFindings:                         fixtureFindings(\"info\"),\n124|\t\tValid:                            true,\n125|\t\tExtensions:                       map[string]any{},\n126|\t}\n127|}\n128|\n129|func mustBuildReadBack(t *testing.T, input clonereadback.ReadBackManifestInput) []byte {\n130|\tt.Helper()\n131|\tsealed, err := clonereadback.BuildReadBackEvidenceManifest(input)\n132|\tif err != nil {\n133|\t\tt.Fatalf(\"BuildReadBackEvidenceManifest: %v\", err)\n134|\t}\n135|\treturn sealed\n136|}\n137|\n138|func mustDecodeReadBack(t *testing.T, sealed []byte) clonereadback.ReadBackManifest {\n139|\tt.Helper()\n140|\tmanifest, err := clonereadback.DecodeReadBackEvidenceManifest(sealed)\n141|\tif err != nil {\n142|\t\tt.Fatalf(\"DecodeReadBackEvidenceManifest: %v\", err)\n143|\t}\n144|\treturn manifest\n145|}\n146|\n147|func mustBuildReport(t *testing.T, input clonereadback.ValidationReportInput) []byte {\n148|\tt.Helper()\n149|\tsealed, err := clonereadback.BuildValidationReport(input)\n150|\tif err != nil {\n151|\t\tt.Fatalf(\"BuildValidationReport: %v\", err)\n152|\t}\n153|\treturn sealed\n154|}\n155|\n156|func mustDecodeReport(t *testing.T, sealed []byte) clonereadback.ValidationReport {\n157|\tt.Helper()\n158|\treport, err := clonereadback.DecodeValidationReport(sealed)\n159|\tif err != nil {\n160|\t\tt.Fatalf(\"DecodeValidationReport: %v\", err)\n161|\t}\n162|\treturn report\n163|}\n164|\n165|// decodeDocument parses sealed bytes into a generic document for\n166|// member surgery.\n167|func decodeDocument(t *testing.T, sealed []byte) map[string]any {\n168|\tt.Helper()\n169|\tvar document map[string]any\n170|\tif err := json.Unmarshal(sealed, &document); err != nil {\n171|\t\tt.Fatalf(\"unmarshal sealed: %v\", err)\n172|\t}\n173|\treturn document\n174|}\n175|\n176|// marshalDocument renders a surgered document back to bytes.\n177|func marshalDocument(t *testing.T, document map[string]any) []byte {\n178|\tt.Helper()\n179|\trendered, err := json.Marshal(document)\n180|\tif err != nil {\n181|\t\tt.Fatalf(\"marshal document: %v\", err)\n182|\t}\n183|\treturn rendered\n184|}\n185|\n186|// documentAt navigates a nested object member for row-level census\n187|// probes.\n188|func documentAt(t *testing.T, document map[string]any, member string, index int) map[string]any {\n189|\tt.Helper()\n190|\trows, ok := document[member].([]any)\n191|\tif !ok {\n192|\t\tt.Fatalf(\"member %s is not an array\", member)\n193|\t}\n194|\trow, ok := rows[index].(map[string]any)\n195|\tif !ok {\n196|\t\tt.Fatalf(\"member %s[%d] is not an object\", member, index)\n197|\t}\n198|\treturn row\n199|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c703","stream":{"kind":"session","id":"01a0d474-3d76-7560-9284-b023a445b4ff"},"sequence":476,"recorded_at":1780531400000947,"record_type":"event","durability":"durable","causation_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","run_stream":{"kind":"run","id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27"},"call_id":"call_01a0d4769661717393538f5bc5ee0bc9","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/clonereadback/members_test.go`.\n1|package clonereadback_test\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"reflect\"\n10|\t\"runtime\"\n11|\t\"sort\"\n12|\t\"strconv\"\n13|\t\"strings\"\n14|\t\"testing\"\n15|\t\"unicode\"\n16|\n17|\tclonereadback \"github.com/relux-works/agent-session-manager/internal/clonereadback\"\n18|)\n19|\n20|// TestReadBackRoundTrip seals a full read-back manifest and a full\n21|// validation report, decodes each, and asserts every field survived\n22|// with literal schema, mode, and kind values.\n23|func TestReadBackRoundTrip(t *testing.T) {\n24|\tsealed := mustBuildReadBack(t, validReadBackInput())\n25|\tmanifest := mustDecodeReadBack(t, sealed)\n26|\tif manifest.Mode != \"staged\" {\n27|\t\tt.Fatalf(\"mode = %q, want staged\", manifest.Mode)\n28|\t}\n29|\tif len(manifest.EvidenceObjects) != 2 {\n30|\t\tt.Fatalf(\"evidence_objects = %d, want 2\", len(manifest.EvidenceObjects))\n31|\t}\n32|\tif manifest.EvidenceObjects[0].EvidenceKind != \"native_sample\" {\n33|\t\tt.Fatalf(\"row[0] kind = %q, want native_sample\", manifest.EvidenceObjects[0].EvidenceKind)\n34|\t}\n35|\tif manifest.EvidenceObjects[1].EvidenceKind != \"parser_trace\" {\n36|\t\tt.Fatalf(\"row[1] kind = %q, want parser_trace\", manifest.EvidenceObjects[1].EvidenceKind)\n37|\t}\n38|\tif manifest.ExpectedTargetNativeSession != manifest.ObservedTargetNativeSession {\n39|\t\tt.Fatal(\"native Session IDs did not survive equal\")\n40|\t}\n41|\tdocument := decodeDocument(t, sealed)\n42|\tif document[\"schema\"] != \"urn:ax:schema:clone-read-back-evidence-manifest\" {\n43|\t\tt.Fatalf(\"schema = %v, want urn:ax:schema:clone-read-back-evidence-manifest\", document[\"schema\"])\n44|\t}\n45|\tif document[\"schema_version\"] != \"1.0.0\" {\n46|\t\tt.Fatalf(\"schema_version = %v, want 1.0.0\", document[\"schema_version\"])\n47|\t}\n48|\trsealed := mustBuildReport(t, validReportInput())\n49|\treport := mustDecodeReport(t, rsealed)\n50|\tif !report.Valid {\n51|\t\tt.Fatal(\"valid did not survive true\")\n52|\t}\n53|\tif len(report.Findings) != 1 || report.Findings[0].Severity != \"info\" {\n54|\t\tt.Fatal(\"findings did not survive\")\n55|\t}\n56|\trdocument := decodeDocument(t, rsealed)\n57|\tif rdocument[\"schema\"] != \"urn:ax:schema:clone-validation-report\" {\n58|\t\tt.Fatalf(\"schema = %v, want urn:ax:schema:clone-validation-report\", rdocument[\"schema\"])\n59|\t}\n60|\tif rdocument[\"schema_version\"] != \"1.0.0\" {\n61|\t\tt.Fatalf(\"schema_version = %v, want 1.0.0\", rdocument[\"schema_version\"])\n62|\t}\n63|}\n64|\n65|// memberProbe describes one shape member for the census grid: its\n66|// admitted JSON type and whether the shape carries it.\n67|type memberProbe struct {\n68|\tname string\n69|\ttyp  string // string, uint, boolean, array, object\n70|}\n71|\n72|// censusShape binds one closed shape to its DERIVED member list, a\n73|// baseline sealer, a navigator to the shape object inside the sealed\n74|// document, and the production decode entry.\n75|type censusShape struct {\n76|\tlabel   string\n77|\towner   string // error owner phrase\n78|\tmembers []memberProbe\n79|\tseal    func(t *testing.T) []byte\n80|\t// navigate returns the shape object and a rewriter that\n81|\t// remarshals the mutated document.\n82|\tnavigate func(t *testing.T, document map[string]any) map[string]any\n83|\trewrite  func(t *testing.T, document map[string]any) []byte\n84|\t// dupZone locates the byte zone (object body) where a member\n85|\t// pair is duplicated: top document or first evidence row.\n86|\tdupZone func(t *testing.T, sealed []byte) (start, end int)\n87|\tdecode  func([]byte) error\n88|}\n89|\n90|// irregularMembers maps the Go input fields whose JSON member names\n91|// do not follow the mechanical snake_case rule, each quoted from\n92|// pinned SPEC v0.7.0 §13.14.2: both top shapes carry\n93|// expected/observed_target_native_session_id (with the _id suffix\n94|// the Go field drops). Every other field maps mechanically. The\n95|// exact-set cross-check against the sealed bytes fails if this\n96|// table or the snake rule drifts from production.\n97|var irregularMembers = map[string]string{\n98|\t\"ExpectedTargetNativeSession\": \"expected_target_native_session_id\",\n99|\t\"ObservedTargetNativeSession\": \"observed_target_native_session_id\",\n100|}\n101|\n102|// snakeMember renders the mechanical member name for a Go input\n103|// field: a word boundary opens before every uppercase rune that\n104|// follows a lowercase rune or a digit, and the words join with\n105|// underscores in lowercase. Trailing acronym runs stay one word, so\n106|// OperationID becomes operation_id and ParsedHeadIDs becomes\n107|// parsed_head_ids.\n108|func snakeMember(field string) string {\n109|\tvar words []string\n110|\tstart := 0\n111|\trunes := []rune(field)\n112|\tfor index := 1; index < len(runes); index++ {\n113|\t\tif unicode.IsUpper(runes[index]) && (unicode.IsLower(runes[index-1]) || unicode.IsDigit(runes[index-1])) {\n114|\t\t\twords = append(words, string(runes[start:index]))\n115|\t\t\tstart = index\n116|\t\t}\n117|\t}\n118|\twords = append(words, string(runes[start:]))\n119|\treturn strings.ToLower(strings.Join(words, \"_\"))\n120|}\n121|\n122|// rowShapeOf maps a container field to the shape label its element\n123|// structs decode into.\n124|var rowShapeOf = map[string]string{\n125|\t\"EvidenceObjects\": \"evidence\",\n126|}\n127|\n128|// deriveReflectedCensus walks the two production input types by\n129|// reflection and returns every shape member with its JSON type.\n130|// Nested structs and slices of structs recurse; any field kind the\n131|// walker cannot classify fails loudly, so the set grows with the\n132|// types and never shrinks silently.\n133|func deriveReflectedCensus(t *testing.T) map[string][]memberProbe {\n134|\tt.Helper()\n135|\tcensus := map[string][]memberProbe{}\n136|\twalkCensusFields(t, reflect.TypeOf(clonereadback.ReadBackManifestInput{}), \"readback\", census)\n137|\twalkCensusFields(t, reflect.TypeOf(clonereadback.ValidationReportInput{}), \"report\", census)\n138|\treturn census\n139|}\n140|\n141|func walkCensusFields(t *testing.T, typ reflect.Type, shape string, census map[string][]memberProbe) {\n142|\tt.Helper()\n143|\tfor index := 0; index < typ.NumField(); index++ {\n144|\t\twalkCensusField(t, typ.Field(index), shape, census)\n145|\t}\n146|}\n147|\n148|func walkCensusField(t *testing.T, field reflect.StructField, shape string, census map[string][]memberProbe) {\n149|\tt.Helper()\n150|\tif field.PkgPath != \"\" {\n151|\t\tt.Fatalf(\"unexported field %s.%s: extend the walker before probing it\", shape, field.Name)\n152|\t}\n153|\tmember := snakeMember(field.Name)\n154|\tif irregular, ok := irregularMembers[field.Name]; ok {\n155|\t\tmember = irregular\n156|\t}\n157|\temit := func(typ string) {\n158|\t\tcensus[shape] = append(census[shape], memberProbe{name: member, typ: typ})\n159|\t}\n160|\tfieldType := field.Type\n161|\tswitch fieldType.Kind() {\n162|\tcase reflect.String:\n163|\t\temit(\"string\")\n164|\tcase reflect.Bool:\n165|\t\temit(\"boolean\")\n166|\tcase reflect.Uint64:\n167|\t\temit(\"uint\")\n168|\tcase reflect.Slice, reflect.Array:\n169|\t\telement := fieldType.Elem()\n170|\t\tswitch element.Kind() {\n171|\t\tcase reflect.Uint8:\n172|\t\t\t// Raw JSON members: tuples and bindings are\n173|\t\t\t// objects, findings are an array. The field\n174|\t\t\t// name disambiguates; anything else fails\n175|\t\t\t// loudly.\n176|\t\t\tswitch field.Name {\n177|\t\t\tcase \"Findings\":\n178|\t\t\t\temit(\"array\")\n179|\t\t\tcase \"ObservedEnvironment\", \"WorkspaceBinding\", \"TargetEnvironment\":\n180|\t\t\t\temit(\"object\")\n181|\t\t\tdefault:\n182|\t\t\t\tt.Fatalf(\"raw JSON field %s.%s is neither findings nor a known object: extend the walker\", shape, field.Name)\n183|\t\t\t}\n184|\t\tcase reflect.String:\n185|\t\t\temit(\"array\")\n186|\t\tcase reflect.Struct:\n187|\t\t\temit(\"array\")\n188|\t\t\trowShape, ok := rowShapeOf[field.Name]\n189|\t\t\tif !ok {\n190|\t\t\t\tt.Fatalf(\"slice of structs %s.%s has no row shape: extend the walker\", shape, field.Name)\n191|\t\t\t}\n192|\t\t\twalkCensusFields(t, element, rowShape, census)\n193|\t\tdefault:\n194|\t\t\tt.Fatalf(\"unhandled slice element kind %s at %s.%s: extend the walker\", element.Kind(), shape, field.Name)\n195|\t\t}\n196|\tcase reflect.Map:\n197|\t\tif fieldType.Key().Kind() != reflect.String {\n198|\t\t\tt.Fatalf(\"unhandled map key kind %s at %s.%s: extend the walker\", fieldType.Key().Kind(), shape, field.Name)\n199|\t\t}\n200|\t\tvalue := fieldType.Elem()\n201|\t\tif value.Kind() != reflect.Interface || value.NumMethod() != 0 {\n202|\t\t\tt.Fatalf(\"unhandled map value kind %s at %s.%s: extend the walker\", value.Kind(), shape, field.Name)\n203|\t\t}\n204|\t\temit(\"object\")\n205|\tdefault:\n206|\t\tt.Fatalf(\"unhandled kind %s at %s.%s: extend the walker\", fieldType.Kind(), shape, field.Name)\n207|\t}\n208|}\n209|\n210|// readBackCensusShapes binds the three derived shapes to their\n211|// sealers, navigators, byte zones, and production decode entries.\n212|// The member lists come from reflection; schema/version/self members\n213|// are the sealed-envelope delta the exact-set test reconciles.\n214|func readBackCensusShapes(t *testing.T) []censusShape {\n215|\tt.Helper()\n216|\tderived := deriveReflectedCensus(t)\n217|\trewriteDoc := func(t *testing.T, document map[string]any) []byte {\n218|\t\treturn marshalDocument(t, document)\n219|\t}\n220|\ttopZone := func(t *testing.T, sealed []byte) (int, int) {\n221|\t\tt.Helper()\n222|\t\treturn 0, len(sealed)\n223|\t}\n224|\treturn []censusShape{\n225|\t\t{\n226|\t\t\tlabel:   \"readback\",\n227|\t\t\towner:   \"read-back evidence manifest\",\n228|\t\t\tmembers: derived[\"readback\"],\n229|\t\t\tseal:    func(t *testing.T) []byte { return mustBuildReadBack(t, validReadBackInput()) },\n230|\t\t\tnavigate: func(t *testing.T, document map[string]any) map[string]any {\n231|\t\t\t\treturn document\n232|\t\t\t},\n233|\t\t\trewrite: rewriteDoc,\n234|\t\t\tdupZone: topZone,\n235|\t\t\tdecode: func(data []byte) error {\n236|\t\t\t\t_, err := clonereadback.DecodeReadBackEvidenceManifest(data)\n237|\t\t\t\treturn err\n238|\t\t\t},\n239|\t\t},\n240|\t\t{\n241|\t\t\tlabel:   \"evidence\",\n242|\t\t\towner:   \"evidence object\",\n243|\t\t\tmembers: derived[\"evidence\"],\n244|\t\t\tseal:    func(t *testing.T) []byte { return mustBuildReadBack(t, validReadBackInput()) },\n245|\t\t\tnavigate: func(t *testing.T, document map[string]any) map[string]any {\n246|\t\t\t\treturn documentAt(t, document, \"evidence_objects\", 0)\n247|\t\t\t},\n248|\t\t\trewrite: rewriteDoc,\n249|\t\t\tdupZone: func(t *testing.T, sealed []byte) (int, int) {\n250|\t\t\t\tt.Helper()\n251|\t\t\t\treturn firstRowZone(t, sealed, \"evidence_objects\")\n252|\t\t\t},\n253|\t\t\tdecode: func(data []byte) error {\n254|\t\t\t\t_, err := clonereadback.DecodeReadBackEvidenceManifest(data)\n255|\t\t\t\treturn err\n256|\t\t\t},\n257|\t\t},\n258|\t\t{\n259|\t\t\tlabel:   \"report\",\n260|\t\t\towner:   \"clone validation report\",\n261|\t\t\tmembers: derived[\"report\"],\n262|\t\t\tseal:    func(t *testing.T) []byte { return mustBuildReport(t, validReportInput()) },\n263|\t\t\tnavigate: func(t *testing.T, document map[string]any) map[string]any {\n264|\t\t\t\treturn document\n265|\t\t\t},\n266|\t\t\trewrite: rewriteDoc,\n267|\t\t\tdupZone: topZone,\n268|\t\t\tdecode: func(data []byte) error {\n269|\t\t\t\t_, err := clonereadback.DecodeValidationReport(data)\n270|\t\t\t\treturn err\n271|\t\t\t},\n272|\t\t},\n273|\t}\n274|}\n275|\n276|// requireRefusal asserts the production entry refused with the\n277|// owner phrase and the literal gate fragment.\n278|func requireRefusal(t *testing.T, err error, owner, fragment string) {\n279|\tt.Helper()\n280|\tif err == nil {\n281|\t\tt.Fatalf(\"entry admitted what it must refuse (want %q ... %q)\", owner, fragment)\n282|\t}\n283|\tif !strings.Contains(err.Error(), owner) {\n284|\t\tt.Fatalf(\"error %q misses owner phrase %q\", err.Error(), owner)\n285|\t}\n286|\tif !strings.Contains(err.Error(), fragment) {\n287|\t\tt.Fatalf(\"error %q misses literal %q\", err.Error(), fragment)\n288|\t}\n289|}\n290|\n291|// TestMemberCensusExactSets cross-checks the derived member set\n292|// against the sealed bytes: every derived member is present in the\n293|// sealed shape, and the sealed shape carries exactly the derived\n294|// members plus the envelope delta (schema, schema_version, and the\n295|// self id on top shapes).\n296|func TestMemberCensusExactSets(t *testing.T) {\n297|\tenvelope := map[string]map[string]bool{\n298|\t\t\"readback\": {\"schema\": true, \"schema_version\": true, \"read_back_evidence_manifest_id\": true},\n299|\t\t\"evidence\": {},\n300|\t\t\"report\":   {\"schema\": true, \"schema_version\": true, \"validation_report_id\": true},\n301|\t}\n302|\tfor _, shape := range readBackCensusShapes(t) {\n303|\t\tt.Run(shape.label, func(t *testing.T) {\n304|\t\t\tdocument := decodeDocument(t, shape.seal(t))\n305|\t\t\tobject := shape.navigate(t, document)\n306|\t\t\tderived := map[string]bool{}\n307|\t\t\tfor _, member := range shape.members {\n308|\t\t\t\tderived[member.name] = true\n309|\t\t\t\tif _, present := object[member.name]; !present {\n310|\t\t\t\t\tt.Errorf(\"derived member %q missing from sealed %s\", member.name, shape.label)\n311|\t\t\t\t}\n312|\t\t\t}\n313|\t\t\tfor name := range object {\n314|\t\t\t\tif derived[name] || envelope[shape.label][name] {\n315|\t\t\t\t\tcontinue\n316|\t\t\t\t}\n317|\t\t\t\tt.Errorf(\"sealed %s carries underived member %q\", shape.label, name)\n318|\t\t\t}\n319|\t\t\tfor name := range envelope[shape.label] {\n320|\t\t\t\tif _, present := object[name]; !present {\n321|\t\t\t\t\tt.Errorf(\"sealed %s misses envelope member %q\", shape.label, name)\n322|\t\t\t\t}\n323|\t\t\t}\n324|\t\t})\n325|\t}\n326|}\n327|\n328|// TestMemberCensusUnknownMissing drives every derived member\n329|// through the production decode entry twice: once deleted (missing\n330|// refusal naming the member) and once beside an extra member\n331|// (unknown refusal naming the extra).\n332|func TestMemberCensusUnknownMissing(t *testing.T) {\n333|\tfor _, shape := range readBackCensusShapes(t) {\n334|\t\tt.Run(shape.label, func(t *testing.T) {\n335|\t\t\tfor _, member := range shape.members {\n336|\t\t\t\tdocument := decodeDocument(t, shape.seal(t))\n337|\t\t\t\tobject := shape.navigate(t, document)\n338|\t\t\t\tsaved := object[member.name]\n339|\t\t\t\tdelete(object, member.name)\n340|\t\t\t\terr := shape.decode(shape.rewrite(t, document))\n341|\t\t\t\trequireRefusal(t, err, shape.owner, \"misses a required member \\\"\"+member.name+\"\\\"\")\n342|\t\t\t\tobject[member.name] = saved\n343|\t\t\t\tobject[\"zz_extra_member\"] = \"smuggled\"\n344|\t\t\t\terr = shape.decode(shape.rewrite(t, document))\n345|\t\t\t\trequireRefusal(t, err, shape.owner, \"carries unknown member \\\"zz_extra_member\\\"\")\n346|\t\t\t}\n347|\t\t})\n348|\t}\n349|\t// The envelope members are refused the same way at both top\n350|\t// entries: the census derives them from the sealed bytes, not\n351|\t// from the input types, so they are probed here by name.\n352|\tfor _, shape := range readBackCensusShapes(t) {\n353|\t\tif shape.label == \"evidence\" {\n354|\t\t\tcontinue\n355|\t\t}\n356|\t\tt.Run(shape.label+\"/envelope\", func(t *testing.T) {\n357|\t\t\tdocument := decodeDocument(t, shape.seal(t))\n358|\t\t\tvar names []string\n359|\t\t\tfor name := range document {\n360|\t\t\t\tnames = append(names, name)\n361|\t\t\t}\n362|\t\t\tsort.Strings(names)\n363|\t\t\tfor _, name := range names {\n364|\t\t\t\tprobe := decodeDocument(t, shape.seal(t))\n365|\t\t\t\tdelete(probe, name)\n366|\t\t\t\terr := shape.decode(shape.rewrite(t, probe))\n367|\t\t\t\tif err == nil {\n368|\t\t\t\t\tt.Fatalf(\"deleted envelope member %q admitted\", name)\n369|\t\t\t\t}\n370|\t\t\t}\n371|\t\t})\n372|\t}\n373|}\n374|\n375|// TestMemberCensusMiscased drives every derived member through the\n376|// production decode entry renamed with an uppercase initial: the\n377|// renamed member is unknown and the required member is missing.\n378|func TestMemberCensusMiscased(t *testing.T) {\n379|\tfor _, shape := range readBackCensusShapes(t) {\n380|\t\tt.Run(shape.label, func(t *testing.T) {\n381|\t\t\tfor _, member := range shape.members {\n382|\t\t\t\tdocument := decodeDocument(t, shape.seal(t))\n383|\t\t\t\tobject := shape.navigate(t, document)\n384|\t\t\t\tmiscased := strings.ToUpper(member.name[:1]) + member.name[1:]\n385|\t\t\t\tobject[miscased] = object[member.name]\n386|\t\t\t\tdelete(object, member.name)\n387|\t\t\t\terr := shape.decode(shape.rewrite(t, document))\n388|\t\t\t\trequireRefusal(t, err, shape.owner, \"carries unknown member \\\"\"+miscased+\"\\\"\")\n389|\t\t\t}\n390|\t\t})\n391|\t}\n392|}\n393|\n394|// wrongTypeProbes lists the JSON values that are never the probed\n395|// member type.\n396|func wrongTypeProbes(typ string) []any {\n397|\tswitch typ {\n398|\tcase \"string\":\n399|\t\treturn []any{float64(1), float64(1.5), true, nil, []any{}, map[string]any{}}\n400|\tcase \"uint\":\n401|\t\treturn []any{\"1\", float64(1.5), float64(-1), true, nil, []any{}, map[string]any{}}\n402|\tcase \"boolean\":\n403|\t\treturn []any{\"true\", float64(1), float64(0), nil, []any{}, map[string]any{}}\n404|\tcase \"array\":\n405|\t\treturn []any{\"x\", float64(1), true, nil, map[string]any{}}\n406|\tcase \"object\":\n407|\t\treturn []any{\"x\", float64(1), true, nil, []any{true}}\n408|\tdefault:\n409|\t\treturn nil\n410|\t}\n411|}\n412|\n413|// TestMemberCensusWrongTypes drives every derived member through\n414|// the production decode entry under six wrong JSON types: each is\n415|// refused with the member name in the literal.\n416|func TestMemberCensusWrongTypes(t *testing.T) {\n417|\tfor _, shape := range readBackCensusShapes(t) {\n418|\t\tt.Run(shape.label, func(t *testing.T) {\n419|\t\t\tfor _, member := range shape.members {\n420|\t\t\t\tprobes := wrongTypeProbes(member.typ)\n421|\t\t\t\tif len(probes) == 0 {\n422|\t\t\t\t\tt.Fatalf(\"member %s has unprobed type %q\", member.name, member.typ)\n423|\t\t\t\t}\n424|\t\t\t\tfor _, probe := range probes {\n425|\t\t\t\t\tdocument := decodeDocument(t, shape.seal(t))\n426|\t\t\t\t\tobject := shape.navigate(t, document)\n427|\t\t\t\t\tobject[member.name] = probe\n428|\t\t\t\t\terr := shape.decode(shape.rewrite(t, document))\n429|\t\t\t\t\tif err == nil {\n430|\t\t\t\t\t\tt.Fatalf(\"member %s admits wrong type %v\", member.name, probe)\n431|\t\t\t\t\t}\n432|\t\t\t\t\tif !strings.Contains(err.Error(), shape.owner) || !strings.Contains(err.Error(), member.name) {\n433|\t\t\t\t\t\tt.Fatalf(\"member %s wrong-type error %q misses owner or member literal\", member.name, err.Error())\n434|\t\t\t\t\t}\n435|\t\t\t\t}\n436|\t\t\t}\n437|\t\t})\n438|\t}\n439|}\n440|\n441|// scanJSONValue scans one JSON value starting at start (an object,\n442|// array, string, or scalar) and returns the index just past its\n443|// end.\n444|func scanJSONValue(t *testing.T, raw []byte, start int) int {\n445|\tt.Helper()\n446|\tdepth := 0\n447|\tinString := false\n448|\tescaped := false\n449|\tfor index := start; index < len(raw); index++ {\n450|\t\tchar := raw[index]\n451|\t\tif inString {\n452|\t\t\tif escaped {\n453|\t\t\t\tescaped = false\n454|\t\t\t\tcontinue\n455|\t\t\t}\n456|\t\t\tif char == '\\\\' {\n457|\t\t\t\tescaped = true\n458|\t\t\t\tcontinue\n459|\t\t\t}\n460|\t\t\tif char == '\"' {\n461|\t\t\t\tinString = false\n462|\t\t\t}\n463|\t\t\tcontinue\n464|\t\t}\n465|\t\tswitch char {\n466|\t\tcase '\"':\n467|\t\t\tinString = true\n468|\t\tcase '{', '[':\n469|\t\t\tdepth++\n470|\t\tcase '}', ']':\n471|\t\t\tif depth == 0 {\n472|\t\t\t\treturn index\n473|\t\t\t}\n474|\t\t\tdepth--\n475|\t\t\tif depth == 0 {\n476|\t\t\t\treturn index + 1\n477|\t\t\t}\n478|\t\tcase ',':\n479|\t\t\tif depth == 0 {\n480|\t\t\t\treturn index\n481|\t\t\t}\n482|\t\t}\n483|\t}\n484|\tt.Fatalf(\"unterminated JSON value at %d\", start)\n485|\treturn -1\n486|}\n487|\n488|// spliceDuplicateMember duplicates one member pair inside the shape\n489|// byte zone, producing a document whose strict decode must refuse\n490|// the duplicate. The duplicate carries the same bytes, so only the\n491|// duplication — never a changed value — triggers the refusal.\n492|func spliceDuplicateMember(t *testing.T, sealed []byte, zone func(t *testing.T, sealed []byte) (int, int), member string) []byte {\n493|\tt.Helper()\n494|\tstart, end := zone(t, sealed)\n495|\twindow := sealed[start:end]\n496|\tkey := `\"` + member + `\":`\n497|\tat := strings.Index(string(window), key)\n498|\tif at < 0 {\n499|\t\tt.Fatalf(\"member %q not found in dup zone\", member)\n500|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
