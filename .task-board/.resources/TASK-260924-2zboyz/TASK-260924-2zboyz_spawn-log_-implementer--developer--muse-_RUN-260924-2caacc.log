{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c73d","stream":{"kind":"session","id":"01a0d474-3d76-7560-9284-b023a445b4ff"},"sequence":505,"recorded_at":1780531400001005,"record_type":"event","durability":"durable","causation_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","run_stream":{"kind":"run","id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27"},"call_id":"call_01a0d476a71975d194bb6821cfc024a4","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/clonereadback/members_test.go`.\n(499 line(s) above)\n500|\t}\n501|\tvalueStart := start + at + len(key)\n502|\tvalueEnd := scanJSONValue(t, sealed, valueStart)\n503|\tpair := sealed[valueStart-len(key) : valueEnd]\n504|\tmutated := append([]byte{}, sealed[:valueEnd]...)\n505|\tmutated = append(mutated, ',')\n506|\tmutated = append(mutated, pair...)\n507|\tmutated = append(mutated, sealed[valueEnd:]...)\n508|\treturn mutated\n509|}\n510|\n511|// firstRowZone locates the first row object of an array member in\n512|// the sealed bytes.\n513|func firstRowZone(t *testing.T, sealed []byte, member string) (int, int) {\n514|\tt.Helper()\n515|\tkey := `\"` + member + `\":[{`\n516|\tat := strings.Index(string(sealed), key)\n517|\tif at < 0 {\n518|\t\tt.Fatalf(\"array member %q with a first row not found\", member)\n519|\t}\n520|\tstart := at + len(key) - 1\n521|\tend := scanJSONValue(t, sealed, start)\n522|\treturn start, end\n523|}\n524|\n525|// TestMemberCensusDuplicated drives every derived member through\n526|// the production decode entry duplicated at the byte level: strict\n527|// decoding refuses the duplicate.\n528|func TestMemberCensusDuplicated(t *testing.T) {\n529|\tfor _, shape := range readBackCensusShapes(t) {\n530|\t\tt.Run(shape.label, func(t *testing.T) {\n531|\t\t\tsealed := shape.seal(t)\n532|\t\t\tfor _, member := range shape.members {\n533|\t\t\t\tmutated := spliceDuplicateMember(t, sealed, shape.dupZone, member.name)\n534|\t\t\t\terr := shape.decode(mutated)\n535|\t\t\t\trequireRefusal(t, err, shape.owner, \"duplicate member\")\n536|\t\t\t}\n537|\t\t})\n538|\t}\n539|}\n540|\n541|// TestCensusShapeInventory pins the census coverage itself: 3\n542|// shapes and the exact member counts retyped from the spec.\n543|func TestCensusShapeInventory(t *testing.T) {\n544|\twant := map[string]int{\n545|\t\t\"readback\": 13, \"evidence\": 5, \"report\": 20,\n546|\t}\n547|\tshapes := readBackCensusShapes(t)\n548|\tif len(shapes) != len(want) {\n549|\t\tt.Fatalf(\"census shapes = %d, want %d\", len(shapes), len(want))\n550|\t}\n551|\tvar labels []string\n552|\tfor _, shape := range shapes {\n553|\t\tlabels = append(labels, shape.label)\n554|\t\tif len(shape.members) != want[shape.label] {\n555|\t\t\tt.Errorf(\"shape %s members = %d, want %d\", shape.label, len(shape.members), want[shape.label])\n556|\t\t}\n557|\t}\n558|\tsort.Strings(labels)\n559|\tt.Logf(\"census shapes (%d): %s\", len(labels), strings.Join(labels, \", \"))\n560|}\n561|\n562|// TestMemberCensusNoLiteralList guards the derivation itself: no\n563|// composite literal in the package test files may hold a\n564|// census-scale string-literal member list. A composite trips when it\n565|// carries at least 8 distinct derived-universe members at 40% or\n566|// higher member purity (member literals over all string literals).\n567|// Closure bodies are skipped: probe tables legitimately name one\n568|// member per row inside mutate closures. The N-guard-literal-list\n569|// harness row plants a 10-name list that must redden this test.\n570|func TestMemberCensusNoLiteralList(t *testing.T) {\n571|\tuniverse := map[string]bool{}\n572|\tfor _, shape := range readBackCensusShapes(t) {\n573|\t\tfor _, member := range shape.members {\n574|\t\t\tuniverse[member.name] = true\n575|\t\t}\n576|\t}\n577|\t// Envelope members count as universe too: a literal list could\n578|\t// smuggle them instead of the derived set.\n579|\tfor _, name := range []string{\"schema\", \"schema_version\", \"read_back_evidence_manifest_id\", \"validation_report_id\"} {\n580|\t\tuniverse[name] = true\n581|\t}\n582|\tif len(universe) == 0 {\n583|\t\tt.Fatal(\"derived member universe is empty\")\n584|\t}\n585|\t_, file, _, ok := runtime.Caller(0)\n586|\tif !ok {\n587|\t\tt.Fatal(\"runtime.Caller failed\")\n588|\t}\n589|\tfiles, err := filepath.Glob(filepath.Join(filepath.Dir(file), \"*_test.go\"))\n590|\tif err != nil {\n591|\t\tt.Fatalf(\"glob test files: %v\", err)\n592|\t}\n593|\tif len(files) == 0 {\n594|\t\tt.Fatal(\"no test files found\")\n595|\t}\n596|\tfor _, path := range files {\n597|\t\tsource, err := os.ReadFile(path)\n598|\t\tif err != nil {\n599|\t\t\tt.Fatalf(\"read %s: %v\", path, err)\n600|\t\t}\n601|\t\tfset := token.NewFileSet()\n602|\t\tparsed, err := parser.ParseFile(fset, path, source, 0)\n603|\t\tif err != nil {\n604|\t\t\tt.Fatalf(\"parse %s: %v\", path, err)\n605|\t\t}\n606|\t\tast.Inspect(parsed, func(node ast.Node) bool {\n607|\t\t\tcomposite, ok := node.(*ast.CompositeLit)\n608|\t\t\tif !ok {\n609|\t\t\t\treturn true\n610|\t\t\t}\n611|\t\t\tmembers := map[string]bool{}\n612|\t\t\tstringLiterals := 0\n613|\t\t\tvar walk func(node ast.Node)\n614|\t\t\twalk = func(node ast.Node) {\n615|\t\t\t\tif node == nil {\n616|\t\t\t\t\treturn\n617|\t\t\t\t}\n618|\t\t\t\tif _, isFunc := node.(*ast.FuncLit); isFunc {\n619|\t\t\t\t\treturn\n620|\t\t\t\t}\n621|\t\t\t\tif literal, isLit := node.(*ast.BasicLit); isLit && literal.Kind == token.STRING {\n622|\t\t\t\t\tif value, err := strconv.Unquote(literal.Value); err == nil {\n623|\t\t\t\t\t\tstringLiterals++\n624|\t\t\t\t\t\tif universe[value] {\n625|\t\t\t\t\t\t\tmembers[value] = true\n626|\t\t\t\t\t\t}\n627|\t\t\t\t\t}\n628|\t\t\t\t\treturn\n629|\t\t\t\t}\n630|\t\t\t\tfor _, child := range childNodes(node) {\n631|\t\t\t\t\twalk(child)\n632|\t\t\t\t}\n633|\t\t\t}\n634|\t\t\tfor _, element := range composite.Elts {\n635|\t\t\t\twalk(element)\n636|\t\t\t}\n637|\t\t\tif len(members) >= 8 && stringLiterals > 0 && float64(len(members))/float64(stringLiterals) >= 0.4 {\n638|\t\t\t\tt.Errorf(\"%s holds a census-scale member list (%d members): derive it, do not type it\", path, len(members))\n639|\t\t\t}\n640|\t\t\treturn true\n641|\t\t})\n642|\t}\n643|}\n644|\n645|// childNodes lists the child nodes of one AST node for the literal\n646|// walk.\n647|func childNodes(node ast.Node) []ast.Node {\n648|\tvar children []ast.Node\n649|\tast.Inspect(node, func(child ast.Node) bool {\n650|\t\tif child == node {\n651|\t\t\treturn true\n652|\t\t}\n653|\t\tchildren = append(children, child)\n654|\t\treturn false\n655|\t})\n656|\treturn children\n657|}\n658|\n659|// TestEnvelopeLiterals pins the literal schema/version/self member\n660|// names from the pinned registry at both production decode entries:\n661|// a swapped literal is a different schema, never this one.\n662|func TestEnvelopeLiterals(t *testing.T) {\n663|\tsealed := mustBuildReadBack(t, validReadBackInput())\n664|\tfor _, probe := range []struct {\n665|\t\tmember string\n666|\t\tvalue  string\n667|\t}{\n668|\t\t{\"schema\", \"urn:ax:schema:clone-validation-report\"},\n669|\t\t{\"schema\", \"urn:ax:schema:projection-plan\"},\n670|\t\t{\"schema_version\", \"2.0.0\"},\n671|\t\t{\"schema_version\", \"1.0\"},\n672|\t} {\n673|\t\tdocument := decodeDocument(t, sealed)\n674|\t\tdocument[probe.member] = probe.value\n675|\t\t_, err := clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document))\n676|\t\trequireRefusal(t, err, \"read-back evidence manifest\", probe.member)\n677|\t}\n678|\trsealed := mustBuildReport(t, validReportInput())\n679|\tfor _, probe := range []struct {\n680|\t\tmember string\n681|\t\tvalue  string\n682|\t}{\n683|\t\t{\"schema\", \"urn:ax:schema:clone-read-back-evidence-manifest\"},\n684|\t\t{\"schema\", \"urn:ax:schema:fidelity-report\"},\n685|\t\t{\"schema_version\", \"2.0.0\"},\n686|\t\t{\"schema_version\", \"1.0\"},\n687|\t} {\n688|\t\tdocument := decodeDocument(t, rsealed)\n689|\t\tdocument[probe.member] = probe.value\n690|\t\t_, err := clonereadback.DecodeValidationReport(marshalDocument(t, document))\n691|\t\trequireRefusal(t, err, \"clone validation report\", probe.member)\n692|\t}\n693|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c73f","stream":{"kind":"session","id":"01a0d474-3d76-7560-9284-b023a445b4ff"},"sequence":506,"recorded_at":1780531400001007,"record_type":"event","durability":"durable","causation_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","run_stream":{"kind":"run","id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27"},"call_id":"call_01a0d476a97a766fbbe4afe0c83143ab","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/clonereadback/gates_test.go`.\n1|package clonereadback_test\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"fmt\"\n6|\t\"sort\"\n7|\t\"strings\"\n8|\t\"testing\"\n9|\n10|\tclonereadback \"github.com/relux-works/agent-session-manager/internal/clonereadback\"\n11|)\n12|\n13|// This file pins the measure, order, count, delegation, and scalar\n14|// gates: character bounds at edge and edge+1, sorted-unique sweeps,\n15|// owner-decoded members refused with owner detail at both entries,\n16|// and the stated bounds the spec leaves underivable.\n17|\n18|// TestNativeSessionStringEdges pins string[1..512] in CHARACTERS at\n19|// both entries of both shapes: 1 and 512 admit, 0 and 513 refuse,\n20|// and 513 multibyte characters (1026 bytes) refuse — a byte\n21|// measure would admit a shorter character count at the same byte\n22|// length, so the multibyte edge at exactly 512 characters admits.\n23|func TestNativeSessionStringEdges(t *testing.T) {\n24|\tcases := []struct {\n25|\t\tlength int\n26|\t\tmulti  bool\n27|\t\twant   bool\n28|\t}{\n29|\t\t{1, false, true}, {512, false, true}, {0, false, false}, {513, false, false},\n30|\t\t{512, true, true}, {513, true, false},\n31|\t}\n32|\tfor _, probe := range cases {\n33|\t\tvalue := strings.Repeat(\"a\", probe.length)\n34|\t\tif probe.multi {\n35|\t\t\tvalue = strings.Repeat(\"é\", probe.length)\n36|\t\t}\n37|\t\tinput := validReadBackInput()\n38|\t\tinput.ExpectedTargetNativeSession = value\n39|\t\tinput.ObservedTargetNativeSession = value\n40|\t\t_, err := clonereadback.BuildReadBackEvidenceManifest(input)\n41|\t\tif probe.want && err != nil {\n42|\t\t\tt.Fatalf(\"readback length=%d multi=%v refused: %v\", probe.length, probe.multi, err)\n43|\t\t}\n44|\t\tif !probe.want && err == nil {\n45|\t\t\tt.Fatalf(\"readback length=%d multi=%v admitted at Build\", probe.length, probe.multi)\n46|\t\t}\n47|\t\trinput := validReportInput()\n48|\t\trinput.ExpectedTargetNativeSession = value\n49|\t\trinput.ObservedTargetNativeSession = value\n50|\t\t_, err = clonereadback.BuildValidationReport(rinput)\n51|\t\tif probe.want && err != nil {\n52|\t\t\tt.Fatalf(\"report length=%d multi=%v refused: %v\", probe.length, probe.multi, err)\n53|\t\t}\n54|\t\tif !probe.want && err == nil {\n55|\t\t\tt.Fatalf(\"report length=%d multi=%v admitted at Build\", probe.length, probe.multi)\n56|\t\t}\n57|\t}\n58|\tsealed := mustBuildReadBack(t, validReadBackInput())\n59|\tfor _, probe := range []struct {\n60|\t\tvalue string\n61|\t\twant  bool\n62|\t}{\n63|\t\t{\"a\", true}, {strings.Repeat(\"a\", 512), true},\n64|\t\t{\"\", false}, {strings.Repeat(\"a\", 513), false},\n65|\t\t{strings.Repeat(\"é\", 512), true}, {strings.Repeat(\"é\", 513), false},\n66|\t} {\n67|\t\tdocument := decodeDocument(t, sealed)\n68|\t\tdocument[\"expected_target_native_session_id\"] = probe.value\n69|\t\tdocument[\"observed_target_native_session_id\"] = probe.value\n70|\t\tdocument[\"read_back_evidence_manifest_id\"] = independentSelfDigest(t, marshalDocument(t, document), \"read_back_evidence_manifest_id\")\n71|\t\t_, err := clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document))\n72|\t\tif probe.want && err != nil {\n73|\t\t\tt.Fatalf(\"decode %d chars refused: %v\", len([]rune(probe.value)), err)\n74|\t\t}\n75|\t\tif !probe.want && err == nil {\n76|\t\t\tt.Fatalf(\"decode %d chars admitted\", len([]rune(probe.value)))\n77|\t\t}\n78|\t}\n79|}\n80|\n81|// TestMediaTypeStringEdges pins media_type:string[1..128] at both\n82|// read-back entries.\n83|func TestMediaTypeStringEdges(t *testing.T) {\n84|\tfor _, probe := range []struct {\n85|\t\tvalue string\n86|\t\twant  bool\n87|\t}{\n88|\t\t{\"a\", true}, {strings.Repeat(\"a\", 128), true}, {strings.Repeat(\"é\", 128), true},\n89|\t\t{\"\", false}, {strings.Repeat(\"a\", 129), false}, {strings.Repeat(\"é\", 129), false},\n90|\t} {\n91|\t\tinput := validReadBackInput()\n92|\t\trow := validEvidenceInput(\"native_sample\", \"media\")\n93|\t\trow.MediaType = probe.value\n94|\t\tinput.EvidenceObjects = []clonereadback.EvidenceObjectInput{row}\n95|\t\t_, err := clonereadback.BuildReadBackEvidenceManifest(input)\n96|\t\tif probe.want && err != nil {\n97|\t\t\tt.Fatalf(\"media %d chars refused: %v\", len([]rune(probe.value)), err)\n98|\t\t}\n99|\t\tif !probe.want && err == nil {\n100|\t\t\tt.Fatalf(\"media %d chars admitted at Build\", len([]rune(probe.value)))\n101|\t\t}\n102|\t}\n103|\tsealed := mustBuildReadBack(t, validReadBackInput())\n104|\tfor _, probe := range []struct {\n105|\t\tvalue string\n106|\t\twant  bool\n107|\t}{\n108|\t\t{\"a\", true}, {strings.Repeat(\"a\", 128), true},\n109|\t\t{\"\", false}, {strings.Repeat(\"a\", 129), false},\n110|\t} {\n111|\t\tdocument := decodeDocument(t, sealed)\n112|\t\tdocumentAt(t, document, \"evidence_objects\", 0)[\"media_type\"] = probe.value\n113|\t\tdocument[\"read_back_evidence_manifest_id\"] = independentSelfDigest(t, marshalDocument(t, document), \"read_back_evidence_manifest_id\")\n114|\t\t_, err := clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document))\n115|\t\tif probe.want && err != nil {\n116|\t\t\tt.Fatalf(\"decode media %d chars refused: %v\", len(probe.value), err)\n117|\t\t}\n118|\t\tif !probe.want && err == nil {\n119|\t\t\tt.Fatalf(\"decode media %d chars admitted\", len(probe.value))\n120|\t\t}\n121|\t}\n122|}\n123|\n124|// TestParsedHeadIDsSweep pins parsed_head_ids as sorted unique\n125|// string[1..512][0..1024] at both read-back entries: sorted admits,\n126|// unsorted/duplicated/overlong/overcount refuse with the literal,\n127|// and the count edge 1024 admits while 1025 refuses.\n128|func TestParsedHeadIDsSweep(t *testing.T) {\n129|\tinput := validReadBackInput()\n130|\tinput.ParsedHeadIDs = nil\n131|\tmustBuildReadBack(t, input)\n132|\tfor _, probe := range [][]string{\n133|\t\t{\"b\", \"a\"}, {\"a\", \"a\"}, {\"a\", \"b\", \"b\"}, {\"\"}, {strings.Repeat(\"a\", 513)},\n134|\t} {\n135|\t\tbad := validReadBackInput()\n136|\t\tbad.ParsedHeadIDs = probe\n137|\t\t_, err := clonereadback.BuildReadBackEvidenceManifest(bad)\n138|\t\trequireRefusal(t, err, \"read-back evidence manifest\", \"parsed_head_ids\")\n139|\t}\n140|\tedge := validReadBackInput()\n141|\tedge.ParsedHeadIDs = make([]string, 0, 1024)\n142|\tfor index := 0; index < 1024; index++ {\n143|\t\tedge.ParsedHeadIDs = append(edge.ParsedHeadIDs, fmt.Sprintf(\"head-%04d\", index))\n144|\t}\n145|\tmustBuildReadBack(t, edge)\n146|\tover := validReadBackInput()\n147|\tover.ParsedHeadIDs = append(append([]string{}, edge.ParsedHeadIDs...), \"zzz-overflow-tail\")\n148|\tsort.Strings(over.ParsedHeadIDs)\n149|\t_, err := clonereadback.BuildReadBackEvidenceManifest(over)\n150|\trequireRefusal(t, err, \"read-back evidence manifest\", \"parsed_head_ids carries 1025 items, want [0..1024]\")\n151|\tsealed := mustBuildReadBack(t, validReadBackInput())\n152|\tfor _, probe := range [][]string{{\"b\", \"a\"}, {\"a\", \"a\"}} {\n153|\t\tdocument := decodeDocument(t, sealed)\n154|\t\tdocument[\"parsed_head_ids\"] = probe\n155|\t\t_, err := clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document))\n156|\t\trequireRefusal(t, err, \"read-back evidence manifest\", \"parsed_head_ids are not sorted unique string[1..512][0..1024]\")\n157|\t}\n158|}\n159|\n160|// TestEvidenceOrderSweep pins \"sorted unique by evidence kind/blob\n161|// ID\" at both read-back entries: the six permutations of three rows\n162|// admit exactly the sorted one, same-kind rows order by blob ID,\n163|// and duplicated (kind, blob) pairs refuse with the literal.\n164|func TestEvidenceOrderSweep(t *testing.T) {\n165|\trows := []clonereadback.EvidenceObjectInput{\n166|\t\tvalidEvidenceInput(\"marker_observation\", \"order-c\"),\n167|\t\tvalidEvidenceInput(\"native_sample\", \"order-a\"),\n168|\t\tvalidEvidenceInput(\"parser_trace\", \"order-b\"),\n169|\t}\n170|\tsorted := append([]clonereadback.EvidenceObjectInput{}, rows...)\n171|\tsort.Slice(sorted, func(i, j int) bool {\n172|\t\tif sorted[i].EvidenceKind != sorted[j].EvidenceKind {\n173|\t\t\treturn sorted[i].EvidenceKind < sorted[j].EvidenceKind\n174|\t\t}\n175|\t\treturn sorted[i].BlobID < sorted[j].BlobID\n176|\t})\n177|\tadmitted := 0\n178|\tfor _, perm := range permutations3() {\n179|\t\tinput := validReadBackInput()\n180|\t\tinput.EvidenceObjects = []clonereadback.EvidenceObjectInput{rows[perm[0]], rows[perm[1]], rows[perm[2]]}\n181|\t\t_, err := clonereadback.BuildReadBackEvidenceManifest(input)\n182|\t\tisSorted := rows[perm[0]].EvidenceKind == sorted[0].EvidenceKind && rows[perm[1]].EvidenceKind == sorted[1].EvidenceKind && rows[perm[2]].EvidenceKind == sorted[2].EvidenceKind\n183|\t\tif isSorted {\n184|\t\t\tif err != nil {\n185|\t\t\t\tt.Fatalf(\"sorted permutation %v refused: %v\", perm, err)\n186|\t\t\t}\n187|\t\t\tadmitted++\n188|\t\t} else if err == nil {\n189|\t\t\tt.Fatalf(\"unsorted permutation %v admitted at Build\", perm)\n190|\t\t} else if !strings.Contains(err.Error(), \"evidence_objects are not sorted unique by evidence kind/blob ID\") {\n191|\t\t\tt.Fatalf(\"permutation %v error %q misses the literal\", perm, err.Error())\n192|\t\t}\n193|\t}\n194|\tif admitted != 1 {\n195|\t\tt.Fatalf(\"admitted permutations = %d, want 1\", admitted)\n196|\t}\n197|\t// Same-kind rows order by blob ID string order.\n198|\tlow := validEvidenceInput(\"native_sample\", \"same-kind-low\")\n199|\thigh := validEvidenceInput(\"native_sample\", \"same-kind-high\")\n200|\tpair := []clonereadback.EvidenceObjectInput{low, high}\n201|\tsort.Slice(pair, func(i, j int) bool { return pair[i].BlobID < pair[j].BlobID })\n202|\tordered := validReadBackInput()\n203|\tordered.EvidenceObjects = pair\n204|\tmustBuildReadBack(t, ordered)\n205|\tflipped := validReadBackInput()\n206|\tflipped.EvidenceObjects = []clonereadback.EvidenceObjectInput{pair[1], pair[0]}\n207|\t_, err := clonereadback.BuildReadBackEvidenceManifest(flipped)\n208|\trequireRefusal(t, err, \"read-back evidence manifest\", \"evidence_objects are not sorted unique by evidence kind/blob ID\")\n209|\t// Duplicated pairs refuse even when adjacent-sorted.\n210|\tdup := validReadBackInput()\n211|\tdup.EvidenceObjects = []clonereadback.EvidenceObjectInput{low, low}\n212|\t_, err = clonereadback.BuildReadBackEvidenceManifest(dup)\n213|\trequireRefusal(t, err, \"read-back evidence manifest\", \"evidence_objects are not sorted unique by evidence kind/blob ID\")\n214|\t// Decode pins the same gate over sealed bytes.\n215|\tsealed := mustBuildReadBack(t, ordered)\n216|\tdocument := decodeDocument(t, sealed)\n217|\trows2 := document[\"evidence_objects\"].([]any)\n218|\trows2[0], rows2[1] = rows2[1], rows2[0]\n219|\t_, err = clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document))\n220|\trequireRefusal(t, err, \"read-back evidence manifest\", \"evidence_objects are not sorted unique by evidence kind/blob ID\")\n221|}\n222|\n223|func permutations3() [][]int {\n224|\treturn [][]int{{0, 1, 2}, {0, 2, 1}, {1, 0, 2}, {1, 2, 0}, {2, 0, 1}, {2, 1, 0}}\n225|}\n226|\n227|// TestEvidenceCountEdges pins EvidenceObject[0..65536] at both\n228|// read-back entries: empty admits, 65536 admits, 65537 refuses with\n229|// the literal count.\n230|func TestEvidenceCountEdges(t *testing.T) {\n231|\tempty := validReadBackInput()\n232|\tempty.EvidenceObjects = nil\n233|\tmustBuildReadBack(t, empty)\n234|\tfull := validReadBackInput()\n235|\tfull.EvidenceObjects = make([]clonereadback.EvidenceObjectInput, 0, 65536)\n236|\tseen := map[string]bool{}\n237|\tfor counter := 0; len(full.EvidenceObjects) < 65536; counter++ {\n238|\t\trow := validEvidenceInput(\"native_sample\", fmt.Sprintf(\"edge-%d\", counter))\n239|\t\tif seen[row.BlobID] {\n240|\t\t\tcontinue\n241|\t\t}\n242|\t\tseen[row.BlobID] = true\n243|\t\tfull.EvidenceObjects = append(full.EvidenceObjects, row)\n244|\t}\n245|\tsort.Slice(full.EvidenceObjects, func(i, j int) bool {\n246|\t\treturn full.EvidenceObjects[i].BlobID < full.EvidenceObjects[j].BlobID\n247|\t})\n248|\tsealed := mustBuildReadBack(t, full)\n249|\tif _, err := clonereadback.DecodeReadBackEvidenceManifest(sealed); err != nil {\n250|\t\tt.Fatalf(\"65536 rows refused at Decode: %v\", err)\n251|\t}\n252|\tover := validReadBackInput()\n253|\tover.EvidenceObjects = append(append([]clonereadback.EvidenceObjectInput{}, full.EvidenceObjects...), validEvidenceInput(\"parser_trace\", \"overflow\"))\n254|\t_, err := clonereadback.BuildReadBackEvidenceManifest(over)\n255|\trequireRefusal(t, err, \"read-back evidence manifest\", \"carries 65537 evidence_objects, want [0..65536]\")\n256|\tdocument := decodeDocument(t, sealed)\n257|\trows := document[\"evidence_objects\"].([]any)\n258|\trows = append(rows, map[string]any{\n259|\t\t\"evidence_kind\": \"parser_trace\", \"media_type\": \"text/plain\", \"byte_count\": float64(1),\n260|\t\t\"blob_id\": fixtureDigest(\"overflow\"), \"blob_descriptor_id\": fixtureDigest(\"overflow-desc\"),\n261|\t})\n262|\tdocument[\"evidence_objects\"] = rows\n263|\tdocument[\"read_back_evidence_manifest_id\"] = independentSelfDigest(t, marshalDocument(t, document), \"read_back_evidence_manifest_id\")\n264|\t_, err = clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document))\n265|\trequireRefusal(t, err, \"read-back evidence manifest\", \"carries 65537 evidence_objects, want [0..65536]\")\n266|}\n267|\n268|// TestFindingsCountEdges pins AdapterFinding[0..4096] at both report\n269|// entries: 4096 admits, 4097 refuses.\n270|func TestFindingsCountEdges(t *testing.T) {\n271|\tseverities := make([]string, 0, 4096)\n272|\tfor index := 0; index < 4096; index++ {\n273|\t\tseverities = append(severities, \"info\")\n274|\t}\n275|\tfull := validReportInput()\n276|\tfull.Findings = fixtureFindings(severities...)\n277|\tsealed := mustBuildReport(t, full)\n278|\tif _, err := clonereadback.DecodeValidationReport(sealed); err != nil {\n279|\t\tt.Fatalf(\"4096 findings refused at Decode: %v\", err)\n280|\t}\n281|\tover := validReportInput()\n282|\tover.Findings = fixtureFindings(append(severities, \"info\")...)\n283|\t_, err := clonereadback.BuildValidationReport(over)\n284|\trequireRefusal(t, err, \"clone validation report\", \"findings are not AdapterFinding[0..4096]\")\n285|\t// Decode refuses the over-count document under a consistent\n286|\t// resealed id: the count gate reads members, not bytes.\n287|\toverDoc := decodeDocument(t, sealed)\n288|\tfindings := overDoc[\"findings\"].([]any)\n289|\tfindings = append(findings, map[string]any{\n290|\t\t\"code\": \"probe-overflow\", \"extensions\": map[string]any{},\n291|\t\t\"message\": \"overflow\", \"remediation\": nil, \"severity\": \"info\",\n292|\t})\n293|\toverDoc[\"findings\"] = findings\n294|\toverDoc[\"validation_report_id\"] = independentSelfDigest(t, marshalDocument(t, overDoc), \"validation_report_id\")\n295|\t_, err = clonereadback.DecodeValidationReport(marshalDocument(t, overDoc))\n296|\trequireRefusal(t, err, \"clone validation report\", \"findings are not AdapterFinding[0..4096]\")\n297|}\n298|\n299|// TestOwnerDelegation pins that tuple, binding, and finding members\n300|// decode through their landed owners at every entry: a broken\n301|// nested document refuses with the owner detail, never a local\n302|// re-implementation verdict.\n303|func TestOwnerDelegation(t *testing.T) {\n304|\tbrokenTuple := []byte(`{\"adapter_version\":\"1.2.3\",\"architecture\":\"arm64\",\"environment_id\":\"relux.target\",\"environment_version\":\"2026.09\",\"platform\":\"plan9\",\"store_schema_fingerprint\":\"` + fixtureDigest(\"store\") + `\"}`)\n305|\tbrokenBinding := []byte(`{\"branch\":\"main\",\"cwd_relative\":\"/absolute/escape\",\"extensions\":{},\"head_digest\":null,\"index_digest\":null,\"logical_workspace_id\":\"` + fixtureOperationID(\"ws\") + `\",\"repository_remote_fingerprints\":[],\"working_tree_digest\":null}`)\n306|\tbrokenFinding := []byte(`[{\"code\":\"x\",\"extensions\":{},\"message\":\"m\",\"remediation\":null,\"severity\":\"critical\"}]`)\n307|\tinput := validReadBackInput()\n308|\tinput.ObservedEnvironment = brokenTuple\n309|\t_, err := clonereadback.BuildReadBackEvidenceManifest(input)\n310|\trequireRefusal(t, err, \"read-back evidence manifest\", \"observed_environment is not an Environment Tuple\")\n311|\tinput = validReadBackInput()\n312|\tinput.WorkspaceBinding = brokenBinding\n313|\t_, err = clonereadback.BuildReadBackEvidenceManifest(input)\n314|\trequireRefusal(t, err, \"read-back evidence manifest\", \"workspace_binding is not a Workspace Binding\")\n315|\tsealed := mustBuildReadBack(t, validReadBackInput())\n316|\tdocument := decodeDocument(t, sealed)\n317|\tdocument[\"observed_environment\"] = decodeDocument(t, brokenTuple)\n318|\t_, err = clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document))\n319|\trequireRefusal(t, err, \"read-back evidence manifest\", \"observed_environment is not an Environment Tuple\")\n320|\tdocument = decodeDocument(t, sealed)\n321|\tdocument[\"workspace_binding\"] = decodeDocument(t, brokenBinding)\n322|\t_, err = clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document))\n323|\trequireRefusal(t, err, \"read-back evidence manifest\", \"workspace_binding is not a Workspace Binding\")\n324|\trinput := validReportInput()\n325|\trinput.TargetEnvironment = brokenTuple\n326|\t_, err = clonereadback.BuildValidationReport(rinput)\n327|\trequireRefusal(t, err, \"clone validation report\", \"target_environment is not an Environment Tuple\")\n328|\trinput = validReportInput()\n329|\trinput.Findings = brokenFinding\n330|\t_, err = clonereadback.BuildValidationReport(rinput)\n331|\trequireRefusal(t, err, \"clone validation report\", \"findings are not AdapterFinding[0..4096]\")\n332|\trsealed := mustBuildReport(t, validReportInput())\n333|\trdocument := decodeDocument(t, rsealed)\n334|\trdocument[\"target_environment\"] = decodeDocument(t, brokenTuple)\n335|\t_, err = clonereadback.DecodeValidationReport(marshalDocument(t, rdocument))\n336|\trequireRefusal(t, err, \"clone validation report\", \"target_environment is not an Environment Tuple\")\n337|\trdocument = decodeDocument(t, rsealed)\n338|\tvar findingDocs []any\n339|\tif err := json.Unmarshal(brokenFinding, &findingDocs); err != nil {\n340|\t\tt.Fatalf(\"unmarshal broken findings: %v\", err)\n341|\t}\n342|\trdocument[\"findings\"] = findingDocs\n343|\t_, err = clonereadback.DecodeValidationReport(marshalDocument(t, rdocument))\n344|\trequireRefusal(t, err, \"clone validation report\", \"findings are not AdapterFinding[0..4096]\")\n345|}\n346|\n347|// TestScalarGates pins digests, UUIDs, uint53, and the AX number\n348|// model at every entry: malformed scalars refuse, 2^53 refuses, and\n349|// float/exponent/string numbers refuse at decode.\n350|func TestScalarGates(t *testing.T) {\n351|\tinput := validReadBackInput()\n352|\tinput.OperationID = \"not-a-uuid\"\n353|\t_, err := clonereadback.BuildReadBackEvidenceManifest(input)\n354|\trequireRefusal(t, err, \"read-back evidence manifest\", \"operation_id is not a UUIDv7\")\n355|\tinput = validReadBackInput()\n356|\tinput.StructuralDigest = \"not-a-digest\"\n357|\t_, err = clonereadback.BuildReadBackEvidenceManifest(input)\n358|\trequireRefusal(t, err, \"read-back evidence manifest\", \"structural_digest is not a digest\")\n359|\tinput = validReadBackInput()\n360|\tinput.ParsedEventCount = 1 << 53\n361|\t_, err = clonereadback.BuildReadBackEvidenceManifest(input)\n362|\trequireRefusal(t, err, \"read-back evidence manifest\", \"parsed_event_count exceeds uint53\")\n363|\tinput = validReadBackInput()\n364|\tinput.ParsedEventCount = 1<<53 - 1\n365|\tmustBuildReadBack(t, input)\n366|\tsealed := mustBuildReadBack(t, validReadBackInput())\n367|\tfor _, probe := range []any{float64(1.5), \"41\", true, nil} {\n368|\t\tdocument := decodeDocument(t, sealed)\n369|\t\tdocument[\"parsed_event_count\"] = probe\n370|\t\t_, err := clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document))\n371|\t\trequireRefusal(t, err, \"read-back evidence manifest\", \"parsed_event_count is not a uint53\")\n372|\t}\n373|\tdocument := decodeDocument(t, sealed)\n374|\tdocument[\"parsed_event_count\"] = float64(1 << 53)\n375|\t_, err = clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document))\n376|\trequireRefusal(t, err, \"read-back evidence manifest\", \"parsed_event_count is not a uint53\")\n377|\t// Exponent form must refuse even when its value is integral:\n378|\t// the AX number model admits canonical integers only.\n379|\traw := strings.Replace(string(sealed), `\"parsed_event_count\":41`, `\"parsed_event_count\":4.1e1`, 1)\n380|\tif raw == string(sealed) {\n381|\t\tt.Fatal(\"could not splice exponent count: fixture changed\")\n382|\t}\n383|\t_, err = clonereadback.DecodeReadBackEvidenceManifest([]byte(raw))\n384|\trequireRefusal(t, err, \"read-back evidence manifest\", \"parsed_event_count is not a uint53\")\n385|\trinput := validReportInput()\n386|\trinput.OperationID = \"01935934-5b8a-4f3c-9e1d-2a4b6c8d0e1f\" // v4, not v7\n387|\t_, err = clonereadback.BuildValidationReport(rinput)\n388|\trequireRefusal(t, err, \"clone validation report\", \"operation_id is not a UUIDv7\")\n389|}\n390|\n391|// TestExtensionsClosed pins reverse-DNS-only extensions at every\n392|// entry: open keys refuse with the literal.\n393|func TestExtensionsClosed(t *testing.T) {\n394|\tinput := validReadBackInput()\n395|\tinput.Extensions = map[string]any{\"not-a-reverse-dns-key\": \"x\"}\n396|\t_, err := clonereadback.BuildReadBackEvidenceManifest(input)\n397|\trequireRefusal(t, err, \"read-back evidence manifest\", \"extensions invalid\")\n398|\tinput = validReadBackInput()\n399|\tinput.Extensions = map[string]any{\"com.example.note\": \"x\"}\n400|\tmustBuildReadBack(t, input)\n401|\tsealed := mustBuildReadBack(t, validReadBackInput())\n402|\tdocument := decodeDocument(t, sealed)\n403|\tdocument[\"extensions\"] = map[string]any{\"open\": \"x\"}\n404|\t_, err = clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document))\n405|\trequireRefusal(t, err, \"read-back evidence manifest\", \"extensions\")\n406|\trinput := validReportInput()\n407|\trinput.Extensions = map[string]any{\"not-a-reverse-dns-key\": \"x\"}\n408|\t_, err = clonereadback.BuildValidationReport(rinput)\n409|\trequireRefusal(t, err, \"clone validation report\", \"extensions invalid\")\n410|\trsealed := mustBuildReport(t, validReportInput())\n411|\trdocument := decodeDocument(t, rsealed)\n412|\trdocument[\"extensions\"] = map[string]any{\"open\": \"x\"}\n413|\t_, err = clonereadback.DecodeValidationReport(marshalDocument(t, rdocument))\n414|\trequireRefusal(t, err, \"clone validation report\", \"extensions\")\n415|}\n416|\n417|// TestParsedCountAndStructuralDigestAreStatedBounds pins what the\n418|// spec leaves underivable: parsed_event_count carries no stated\n419|// derivation from the heads or the rows, and structural_digest\n420|// carries no stated preimage, so any uint53 count and any digest\n421|// admit. A future derivation would be a spec change, not a gate\n422|// fix.\n423|func TestParsedCountAndStructuralDigestAreStatedBounds(t *testing.T) {\n424|\tinput := validReadBackInput()\n425|\tinput.ParsedEventCount = 0\n426|\tinput.ParsedHeadIDs = []string{\"head-a\", \"head-b\", \"head-c\"}\n427|\tmustBuildReadBack(t, input)\n428|\tinput.ParsedEventCount = 1<<53 - 1\n429|\tinput.StructuralDigest = fixtureDigest(\"unrelated-preimage\")\n430|\tmustBuildReadBack(t, input)\n431|}\n432|\n433|// TestReportTupleMatchIsReconciliationBound pins the sibling-scope\n434|// bound: the report carries one target tuple and the \"matching\n435|// tuple\" conjunct of the valid rule needs the read manifests'\n436|// observed tuples as cross-inputs, so any owner-valid tuple admits\n437|// here and the cross-match belongs to the final reconciliation\n438|// leaf.\n439|func TestReportTupleMatchIsReconciliationBound(t *testing.T) {\n440|\tother := []byte(`{\"adapter_version\":\"9.9.9\",\"architecture\":\"amd64\",\"environment_id\":\"relux.other\",\"environment_version\":\"1.0\",\"platform\":\"linux\",\"store_schema_fingerprint\":\"` + fixtureDigest(\"other-store\") + `\"}`)\n441|\tinput := validReportInput()\n442|\tinput.TargetEnvironment = other\n443|\tmustBuildReport(t, input)\n444|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
