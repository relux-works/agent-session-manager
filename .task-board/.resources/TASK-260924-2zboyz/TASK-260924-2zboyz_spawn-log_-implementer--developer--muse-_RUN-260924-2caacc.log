{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c605","stream":{"kind":"session","id":"01a0d474-3d76-7560-9284-b023a445b4ff"},"sequence":349,"recorded_at":1780531400000693,"record_type":"event","durability":"durable","causation_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","run_stream":{"kind":"run","id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27"},"call_id":"call_01a0d4753202752cb9c0605c32ee1b3c","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/clonereadback/report.go`.\n1|package clonereadback\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n9|)\n10|\n11|// This file validates and constructs Clone Validation Report\n12|// 1.0.0: the closed 22-member report Section 13.14.2 states,\n13|// aggregating both read-back manifests, the seven check booleans,\n14|// the Fidelity Report reference, findings, and the valid result.\n15|// Valid is decided, never carried: valid=true if and only if every\n16|// check boolean is true, the native Session IDs match, and no\n17|// finding carries error severity. The report tuple cross-match\n18|// against the read manifests' observed tuples needs the sibling\n19|// inputs and belongs to the final reconciliation leaf.\n20|\n21|const (\n22|\tvalidationSchema  = \"urn:ax:schema:clone-validation-report\"\n23|\tvalidationVersion = \"1.0.0\"\n24|\tvalidationSelf    = \"validation_report_id\"\n25|\tmaxReportFindings = 4096\n26|)\n27|\n28|var validationMembers = map[string]bool{\n29|\t\"schema\": true, \"schema_version\": true,\n30|\t\"validation_report_id\": true, \"operation_id\": true,\n31|\t\"projection_plan_id\":                    true,\n32|\t\"projected_object_manifest_id\":          true,\n33|\t\"staged_read_back_evidence_manifest_id\": true,\n34|\t\"live_read_back_evidence_manifest_id\":   true,\n35|\t\"target_provider_manifest_id\":           true,\n36|\t\"fidelity_report_id\":                    true,\n37|\t\"expected_target_native_session_id\":     true,\n38|\t\"observed_target_native_session_id\":     true,\n39|\t\"target_environment\":                    true,\n40|\t\"staged_structural_valid\":               true,\n41|\t\"live_structural_valid\":                 true,\n42|\t\"semantic_marker_valid\":                 true,\n43|\t\"identity_valid\":                        true,\n44|\t\"workspace_binding_valid\":               true,\n45|\t\"resume_surface_valid\":                  true,\n46|\t\"source_generation_revalidated\":         true,\n47|\t\"findings\":                              true,\n48|\t\"valid\":                                 true, \"extensions\": true,\n49|}\n50|\n51|var validationRequired = []string{\n52|\t\"schema\", \"schema_version\",\n53|\t\"validation_report_id\", \"operation_id\",\n54|\t\"projection_plan_id\",\n55|\t\"projected_object_manifest_id\",\n56|\t\"staged_read_back_evidence_manifest_id\",\n57|\t\"live_read_back_evidence_manifest_id\",\n58|\t\"target_provider_manifest_id\",\n59|\t\"fidelity_report_id\",\n60|\t\"expected_target_native_session_id\",\n61|\t\"observed_target_native_session_id\",\n62|\t\"target_environment\",\n63|\t\"staged_structural_valid\",\n64|\t\"live_structural_valid\",\n65|\t\"semantic_marker_valid\",\n66|\t\"identity_valid\",\n67|\t\"workspace_binding_valid\",\n68|\t\"resume_surface_valid\",\n69|\t\"source_generation_revalidated\",\n70|\t\"findings\",\n71|\t\"valid\", \"extensions\",\n72|}\n73|\n74|// ValidationChecks carries the seven check booleans the valid rule\n75|// conjoins. Every check is always applicable in this schema: unlike\n76|// the adapter validate body, the report has no nullable checks, so\n77|// the oracle enumerates outcomes over all seven with applicability\n78|// fixed.\n79|type ValidationChecks struct {\n80|\tStagedStructuralValid       bool\n81|\tLiveStructuralValid         bool\n82|\tSemanticMarkerValid         bool\n83|\tIdentityValid               bool\n84|\tWorkspaceBindingValid       bool\n85|\tResumeSurfaceValid          bool\n86|\tSourceGenerationRevalidated bool\n87|}\n88|\n89|// ValidationReport is one validated Clone Validation Report 1.0.0.\n90|type ValidationReport struct {\n91|\tReportID                    scalar.Digest\n92|\tOperationID                 scalar.UUIDv7\n93|\tProjectionPlanID            scalar.Digest\n94|\tProjectedObjectManifestID   scalar.Digest\n95|\tStagedManifestID            scalar.Digest\n96|\tLiveManifestID              scalar.Digest\n97|\tProviderManifestID          scalar.Digest\n98|\tFidelityReportID            scalar.Digest\n99|\tExpectedTargetNativeSession string\n100|\tObservedTargetNativeSession string\n101|\tTargetEnvironment           sessadapter.Tuple\n102|\tChecks                      ValidationChecks\n103|\tFindings                    []sessadapter.Finding\n104|\tValid                       bool\n105|}\n106|\n107|// ValidationReportInput is the caller-supplied validation report\n108|// candidate for Build. Nested closed shapes (target tuple,\n109|// findings) arrive as raw JSON and decode through their owners;\n110|// extensions arrive as a Go map and seal through the\n111|// closed-extensions owner.\n112|type ValidationReportInput struct {\n113|\tOperationID                      string\n114|\tProjectionPlanID                 string\n115|\tProjectedObjectManifestID        string\n116|\tStagedReadBackEvidenceManifestID string\n117|\tLiveReadBackEvidenceManifestID   string\n118|\tTargetProviderManifestID         string\n119|\tFidelityReportID                 string\n120|\tExpectedTargetNativeSession      string\n121|\tObservedTargetNativeSession      string\n122|\tTargetEnvironment                []byte\n123|\tStagedStructuralValid            bool\n124|\tLiveStructuralValid              bool\n125|\tSemanticMarkerValid              bool\n126|\tIdentityValid                    bool\n127|\tWorkspaceBindingValid            bool\n128|\tResumeSurfaceValid               bool\n129|\tSourceGenerationRevalidated      bool\n130|\tFindings                         []byte\n131|\tValid                            bool\n132|\tExtensions                       map[string]any\n133|}\n134|\n135|// decideValid computes the pinned valid rule: every check boolean\n136|// true, matching native IDs, and no error-severity finding. Both\n137|// entries share this single decider, so the rule cannot drift\n138|// between Build and Decode.\n139|func decideValid(checks ValidationChecks, expected, observed string, findings []sessadapter.Finding) bool {\n140|\tif !checks.StagedStructuralValid {\n141|\t\treturn false\n142|\t}\n143|\tif !checks.LiveStructuralValid {\n144|\t\treturn false\n145|\t}\n146|\tif !checks.SemanticMarkerValid {\n147|\t\treturn false\n148|\t}\n149|\tif !checks.IdentityValid {\n150|\t\treturn false\n151|\t}\n152|\tif !checks.WorkspaceBindingValid {\n153|\t\treturn false\n154|\t}\n155|\tif !checks.ResumeSurfaceValid {\n156|\t\treturn false\n157|\t}\n158|\tif !checks.SourceGenerationRevalidated {\n159|\t\treturn false\n160|\t}\n161|\tif expected != observed {\n162|\t\treturn false\n163|\t}\n164|\tfor _, finding := range findings {\n165|\t\tif finding.Severity == \"error\" {\n166|\t\t\treturn false\n167|\t\t}\n168|\t}\n169|\treturn true\n170|}\n171|\n172|// checkValidAgreement enforces that the carried valid bit equals the\n173|// decided rule: a report claiming valid=true with a failed check is\n174|// refused, and a report claiming valid=false with every check\n175|// passing is refused. Both entries share this gate.\n176|func checkValidAgreement(owner string, claimed bool, checks ValidationChecks, expected, observed string, findings []sessadapter.Finding) error {\n177|\tif claimed != decideValid(checks, expected, observed, findings) {\n178|\t\treturn invalid(\"%s valid disagrees with the check outcome\", owner)\n179|\t}\n180|\treturn nil\n181|}\n182|\n183|// BuildValidationReport constructs one closed Clone Validation\n184|// Report 1.0.0 as canonical bytes. Identical inputs produce\n185|// byte-identical outputs. Every closed-shape, scalar, finding, and\n186|// validity rule is a refusal, never a repair.\n187|func BuildValidationReport(input ValidationReportInput) ([]byte, error) {\n188|\t_, object, err := buildValidationReport(input)\n189|\tif err != nil {\n190|\t\treturn nil, err\n191|\t}\n192|\tomitted, err := canonicalizeObject(object)\n193|\tif err != nil {\n194|\t\treturn nil, err\n195|\t}\n196|\treportID := scalar.SHA256Digest(omitted)\n197|\tobject[validationSelf] = reportID.String()\n198|\treturn canonicalizeObject(object)\n199|}\n200|\n201|func buildValidationReport(input ValidationReportInput) (ValidationReport, map[string]any, error) {\n202|\towner := \"clone validation report\"\n203|\toperation, err := scalar.ParseUUIDv7(input.OperationID)\n204|\tif err != nil {\n205|\t\treturn ValidationReport{}, nil, invalid(\"%s operation_id is not a UUIDv7: %v\", owner, err)\n206|\t}\n207|\tplanID, err := scalar.ParseDigest(input.ProjectionPlanID)\n208|\tif err != nil {\n209|\t\treturn ValidationReport{}, nil, invalid(\"%s projection_plan_id is not a digest: %v\", owner, err)\n210|\t}\n211|\tprojectedID, err := scalar.ParseDigest(input.ProjectedObjectManifestID)\n212|\tif err != nil {\n213|\t\treturn ValidationReport{}, nil, invalid(\"%s projected_object_manifest_id is not a digest: %v\", owner, err)\n214|\t}\n215|\tstagedID, err := scalar.ParseDigest(input.StagedReadBackEvidenceManifestID)\n216|\tif err != nil {\n217|\t\treturn ValidationReport{}, nil, invalid(\"%s staged_read_back_evidence_manifest_id is not a digest: %v\", owner, err)\n218|\t}\n219|\tliveID, err := scalar.ParseDigest(input.LiveReadBackEvidenceManifestID)\n220|\tif err != nil {\n221|\t\treturn ValidationReport{}, nil, invalid(\"%s live_read_back_evidence_manifest_id is not a digest: %v\", owner, err)\n222|\t}\n223|\tproviderID, err := scalar.ParseDigest(input.TargetProviderManifestID)\n224|\tif err != nil {\n225|\t\treturn ValidationReport{}, nil, invalid(\"%s target_provider_manifest_id is not a digest: %v\", owner, err)\n226|\t}\n227|\tfidelityID, err := scalar.ParseDigest(input.FidelityReportID)\n228|\tif err != nil {\n229|\t\treturn ValidationReport{}, nil, invalid(\"%s fidelity_report_id is not a digest: %v\", owner, err)\n230|\t}\n231|\tif !validText(input.ExpectedTargetNativeSession) {\n232|\t\treturn ValidationReport{}, nil, invalid(\"%s expected_target_native_session_id is not valid UTF-8\", owner)\n233|\t}\n234|\tif length := stringLength(input.ExpectedTargetNativeSession); length < 1 || length > 512 {\n235|\t\treturn ValidationReport{}, nil, invalid(\"%s expected_target_native_session_id is not a string[1..512]\", owner)\n236|\t}\n237|\tif !validText(input.ObservedTargetNativeSession) {\n238|\t\treturn ValidationReport{}, nil, invalid(\"%s observed_target_native_session_id is not valid UTF-8\", owner)\n239|\t}\n240|\tif length := stringLength(input.ObservedTargetNativeSession); length < 1 || length > 512 {\n241|\t\treturn ValidationReport{}, nil, invalid(\"%s observed_target_native_session_id is not a string[1..512]\", owner)\n242|\t}\n243|\ttargetTuple, err := sessadapter.DecodeTuple(json.RawMessage(input.TargetEnvironment))\n244|\tif err != nil {\n245|\t\treturn ValidationReport{}, nil, invalid(\"%s target_environment is not an Environment Tuple: %v\", owner, err)\n246|\t}\n247|\tchecks := ValidationChecks{\n248|\t\tStagedStructuralValid:       input.StagedStructuralValid,\n249|\t\tLiveStructuralValid:         input.LiveStructuralValid,\n250|\t\tSemanticMarkerValid:         input.SemanticMarkerValid,\n251|\t\tIdentityValid:               input.IdentityValid,\n252|\t\tWorkspaceBindingValid:       input.WorkspaceBindingValid,\n253|\t\tResumeSurfaceValid:          input.ResumeSurfaceValid,\n254|\t\tSourceGenerationRevalidated: input.SourceGenerationRevalidated,\n255|\t}\n256|\tfindings, err := sessadapter.DecodeFindings(json.RawMessage(input.Findings), maxReportFindings)\n257|\tif err != nil {\n258|\t\treturn ValidationReport{}, nil, invalid(\"%s findings are not AdapterFinding[0..4096]: %v\", owner, err)\n259|\t}\n260|\tif err := checkValidAgreement(owner, input.Valid, checks, input.ExpectedTargetNativeSession, input.ObservedTargetNativeSession, findings); err != nil {\n261|\t\treturn ValidationReport{}, nil, err\n262|\t}\n263|\textensions, err := clonebundle.EncodeExtensions(input.Extensions)\n264|\tif err != nil {\n265|\t\treturn ValidationReport{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n266|\t}\n267|\tvar extensionsValue any\n268|\tif err := json.Unmarshal(extensions, &extensionsValue); err != nil {\n269|\t\treturn ValidationReport{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n270|\t}\n271|\treport := ValidationReport{\n272|\t\tOperationID:                 operation,\n273|\t\tProjectionPlanID:            planID,\n274|\t\tProjectedObjectManifestID:   projectedID,\n275|\t\tStagedManifestID:            stagedID,\n276|\t\tLiveManifestID:              liveID,\n277|\t\tProviderManifestID:          providerID,\n278|\t\tFidelityReportID:            fidelityID,\n279|\t\tExpectedTargetNativeSession: input.ExpectedTargetNativeSession,\n280|\t\tObservedTargetNativeSession: input.ObservedTargetNativeSession,\n281|\t\tTargetEnvironment:           targetTuple,\n282|\t\tChecks:                      checks,\n283|\t\tFindings:                    findings,\n284|\t\tValid:                       input.Valid,\n285|\t}\n286|\tobject := map[string]any{\n287|\t\t\"schema\":                                validationSchema,\n288|\t\t\"schema_version\":                        validationVersion,\n289|\t\t\"operation_id\":                          operation.String(),\n290|\t\t\"projection_plan_id\":                    planID.String(),\n291|\t\t\"projected_object_manifest_id\":          projectedID.String(),\n292|\t\t\"staged_read_back_evidence_manifest_id\": stagedID.String(),\n293|\t\t\"live_read_back_evidence_manifest_id\":   liveID.String(),\n294|\t\t\"target_provider_manifest_id\":           providerID.String(),\n295|\t\t\"fidelity_report_id\":                    fidelityID.String(),\n296|\t\t\"expected_target_native_session_id\":     input.ExpectedTargetNativeSession,\n297|\t\t\"observed_target_native_session_id\":     input.ObservedTargetNativeSession,\n298|\t\t\"staged_structural_valid\":               input.StagedStructuralValid,\n299|\t\t\"live_structural_valid\":                 input.LiveStructuralValid,\n300|\t\t\"semantic_marker_valid\":                 input.SemanticMarkerValid,\n301|\t\t\"identity_valid\":                        input.IdentityValid,\n302|\t\t\"workspace_binding_valid\":               input.WorkspaceBindingValid,\n303|\t\t\"resume_surface_valid\":                  input.ResumeSurfaceValid,\n304|\t\t\"source_generation_revalidated\":         input.SourceGenerationRevalidated,\n305|\t\t\"valid\":                                 input.Valid,\n306|\t\t\"extensions\":                            extensionsValue,\n307|\t}\n308|\tvar tupleValue any\n309|\tif err := json.Unmarshal(input.TargetEnvironment, &tupleValue); err != nil {\n310|\t\treturn ValidationReport{}, nil, invalid(\"%s target_environment invalid: %v\", owner, err)\n311|\t}\n312|\tobject[\"target_environment\"] = tupleValue\n313|\tvar findingsValue any\n314|\tif err := json.Unmarshal(input.Findings, &findingsValue); err != nil {\n315|\t\treturn ValidationReport{}, nil, invalid(\"%s findings invalid: %v\", owner, err)\n316|\t}\n317|\tobject[\"findings\"] = findingsValue\n318|\treturn report, object, nil\n319|}\n320|\n321|// DecodeValidationReport validates one closed Clone Validation\n322|// Report 1.0.0: exact members, literal schema/version, owner-decoded\n323|// tuple and findings, the decided valid bit, and the omit-self\n324|// identity.\n325|func DecodeValidationReport(data []byte) (ValidationReport, error) {\n326|\towner := \"clone validation report\"\n327|\tmembers, fault := decodeStrictObject(data)\n328|\tif fault != nil {\n329|\t\treturn ValidationReport{}, invalid(\"%s %s (%s)\", owner, fault.detail, memberField(fault.member))\n330|\t}\n331|\tif name, unknown := unknownMember(members, validationMembers); unknown {\n332|\t\treturn ValidationReport{}, invalid(\"%s carries unknown member %q\", owner, name)\n333|\t}\n334|\tif name, missing := missingMember(members, validationRequired); missing {\n335|\t\treturn ValidationReport{}, invalid(\"%s misses a required member %q\", owner, name)\n336|\t}\n337|\tschema, ok := rawString(members[\"schema\"])\n338|\tif !ok || schema != validationSchema {\n339|\t\treturn ValidationReport{}, invalid(\"%s schema is not urn:ax:schema:clone-validation-report\", owner)\n340|\t}\n341|\tversion, ok := rawString(members[\"schema_version\"])\n342|\tif !ok || version != validationVersion {\n343|\t\treturn ValidationReport{}, invalid(\"%s schema_version is not 1.0.0\", owner)\n344|\t}\n345|\tclaimed, ok := checkDigest(members[validationSelf])\n346|\tif !ok {\n347|\t\treturn ValidationReport{}, invalid(\"%s validation_report_id is not a digest\", owner)\n348|\t}\n349|\toperation, ok := checkUUIDv7(members[\"operation_id\"])\n350|\tif !ok {\n351|\t\treturn ValidationReport{}, invalid(\"%s operation_id is not a UUIDv7\", owner)\n352|\t}\n353|\tplanID, ok := checkDigest(members[\"projection_plan_id\"])\n354|\tif !ok {\n355|\t\treturn ValidationReport{}, invalid(\"%s projection_plan_id is not a digest\", owner)\n356|\t}\n357|\tprojectedID, ok := checkDigest(members[\"projected_object_manifest_id\"])\n358|\tif !ok {\n359|\t\treturn ValidationReport{}, invalid(\"%s projected_object_manifest_id is not a digest\", owner)\n360|\t}\n361|\tstagedID, ok := checkDigest(members[\"staged_read_back_evidence_manifest_id\"])\n362|\tif !ok {\n363|\t\treturn ValidationReport{}, invalid(\"%s staged_read_back_evidence_manifest_id is not a digest\", owner)\n364|\t}\n365|\tliveID, ok := checkDigest(members[\"live_read_back_evidence_manifest_id\"])\n366|\tif !ok {\n367|\t\treturn ValidationReport{}, invalid(\"%s live_read_back_evidence_manifest_id is not a digest\", owner)\n368|\t}\n369|\tproviderID, ok := checkDigest(members[\"target_provider_manifest_id\"])\n370|\tif !ok {\n371|\t\treturn ValidationReport{}, invalid(\"%s target_provider_manifest_id is not a digest\", owner)\n372|\t}\n373|\tfidelityID, ok := checkDigest(members[\"fidelity_report_id\"])\n374|\tif !ok {\n375|\t\treturn ValidationReport{}, invalid(\"%s fidelity_report_id is not a digest\", owner)\n376|\t}\n377|\texpected, ok := checkStringBounds(members[\"expected_target_native_session_id\"], 1, 512)\n378|\tif !ok {\n379|\t\treturn ValidationReport{}, invalid(\"%s expected_target_native_session_id is not a string[1..512]\", owner)\n380|\t}\n381|\tobserved, ok := checkStringBounds(members[\"observed_target_native_session_id\"], 1, 512)\n382|\tif !ok {\n383|\t\treturn ValidationReport{}, invalid(\"%s observed_target_native_session_id is not a string[1..512]\", owner)\n384|\t}\n385|\ttargetTuple, err := sessadapter.DecodeTuple(members[\"target_environment\"])\n386|\tif err != nil {\n387|\t\treturn ValidationReport{}, invalid(\"%s target_environment is not an Environment Tuple: %v\", owner, err)\n388|\t}\n389|\tchecks, err := decodeValidationChecks(members)\n390|\tif err != nil {\n391|\t\treturn ValidationReport{}, err\n392|\t}\n393|\tfindings, err := sessadapter.DecodeFindings(members[\"findings\"], maxReportFindings)\n394|\tif err != nil {\n395|\t\treturn ValidationReport{}, invalid(\"%s findings are not AdapterFinding[0..4096]: %v\", owner, err)\n396|\t}\n397|\tvalid, ok := rawBool(members[\"valid\"])\n398|\tif !ok {\n399|\t\treturn ValidationReport{}, invalid(\"%s valid is not a boolean\", owner)\n400|\t}\n401|\tif err := checkValidAgreement(owner, valid, checks, expected, observed, findings); err != nil {\n402|\t\treturn ValidationReport{}, err\n403|\t}\n404|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n405|\t\treturn ValidationReport{}, invalid(\"%s extensions %s\", owner, extensionsFault)\n406|\t}\n407|\tif err := verifySelfDigest(members, validationSelf, claimed); err != nil {\n408|\t\treturn ValidationReport{}, err\n409|\t}\n410|\treturn ValidationReport{\n411|\t\tReportID:                    claimed,\n412|\t\tOperationID:                 operation,\n413|\t\tProjectionPlanID:            planID,\n414|\t\tProjectedObjectManifestID:   projectedID,\n415|\t\tStagedManifestID:            stagedID,\n416|\t\tLiveManifestID:              liveID,\n417|\t\tProviderManifestID:          providerID,\n418|\t\tFidelityReportID:            fidelityID,\n419|\t\tExpectedTargetNativeSession: expected,\n420|\t\tObservedTargetNativeSession: observed,\n421|\t\tTargetEnvironment:           targetTuple,\n422|\t\tChecks:                      checks,\n423|\t\tFindings:                    findings,\n424|\t\tValid:                       valid,\n425|\t}, nil\n426|}\n427|\n428|// decodeValidationChecks reads the seven check booleans. Each member\n429|// is required non-null; null is a wrong type, never false.\n430|func decodeValidationChecks(members map[string]json.RawMessage) (ValidationChecks, error) {\n431|\towner := \"clone validation report\"\n432|\tread := func(member string) (bool, error) {\n433|\t\tvalue, ok := rawBool(members[member])\n434|\t\tif !ok {\n435|\t\t\treturn false, invalid(\"%s %s is not a boolean\", owner, member)\n436|\t\t}\n437|\t\treturn value, nil\n438|\t}\n439|\tstaged, err := read(\"staged_structural_valid\")\n440|\tif err != nil {\n441|\t\treturn ValidationChecks{}, err\n442|\t}\n443|\tlive, err := read(\"live_structural_valid\")\n444|\tif err != nil {\n445|\t\treturn ValidationChecks{}, err\n446|\t}\n447|\tmarker, err := read(\"semantic_marker_valid\")\n448|\tif err != nil {\n449|\t\treturn ValidationChecks{}, err\n450|\t}\n451|\tidentity, err := read(\"identity_valid\")\n452|\tif err != nil {\n453|\t\treturn ValidationChecks{}, err\n454|\t}\n455|\tbinding, err := read(\"workspace_binding_valid\")\n456|\tif err != nil {\n457|\t\treturn ValidationChecks{}, err\n458|\t}\n459|\tresume, err := read(\"resume_surface_valid\")\n460|\tif err != nil {\n461|\t\treturn ValidationChecks{}, err\n462|\t}\n463|\tgeneration, err := read(\"source_generation_revalidated\")\n464|\tif err != nil {\n465|\t\treturn ValidationChecks{}, err\n466|\t}\n467|\treturn ValidationChecks{\n468|\t\tStagedStructuralValid:       staged,\n469|\t\tLiveStructuralValid:         live,\n470|\t\tSemanticMarkerValid:         marker,\n471|\t\tIdentityValid:               identity,\n472|\t\tWorkspaceBindingValid:       binding,\n473|\t\tResumeSurfaceValid:          resume,\n474|\t\tSourceGenerationRevalidated: generation,\n475|\t}, nil\n476|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c607","stream":{"kind":"session","id":"01a0d474-3d76-7560-9284-b023a445b4ff"},"sequence":350,"recorded_at":1780531400000695,"record_type":"event","durability":"durable","causation_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27","run_stream":{"kind":"run","id":"e42e0c3d-9a3a-49fd-b4d5-0c8bade5fc27"},"call_id":"call_01a0d47533f87549b7dc6949c07f084e","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/clonereadback/vocab.go`.\n1|package clonereadback\n2|\n3|// This file owns the two closed vocabularies the read-back\n4|// contracts state: the manifest mode (staged|live) and the evidence\n5|// row kind (native_sample|parser_trace|marker_observation),\n6|// SPEC v0.7.0 Section 13.14.2 lines 10737-10754. Every other\n7|// vocabulary these shapes touch (platforms, severities, digests,\n8|// extension keys) stays with its landed owner.\n9|\n10|var readBackModes = map[string]bool{\n11|\t\"staged\": true,\n12|\t\"live\":   true,\n13|}\n14|\n15|// ValidReadBackMode reports whether the mode is one of the two\n16|// closed read-back modes. The mode binds the manifest identity, so\n17|// a relabeled mode is an identity mismatch, never a second reading\n18|// of the same manifest.\n19|func ValidReadBackMode(mode string) bool {\n20|\treturn readBackModes[mode]\n21|}\n22|\n23|// ReadBackModes lists the closed read-back modes in a fixed order.\n24|func ReadBackModes() []string {\n25|\treturn []string{\"staged\", \"live\"}\n26|}\n27|\n28|var evidenceKinds = map[string]bool{\n29|\t\"native_sample\":      true,\n30|\t\"parser_trace\":       true,\n31|\t\"marker_observation\": true,\n32|}\n33|\n34|// ValidEvidenceKind reports whether the kind is one of the three\n35|// closed evidence row kinds.\n36|func ValidEvidenceKind(kind string) bool {\n37|\treturn evidenceKinds[kind]\n38|}\n39|\n40|// EvidenceKinds lists the closed evidence row kinds in a fixed\n41|// order.\n42|func EvidenceKinds() []string {\n43|\treturn []string{\"native_sample\", \"parser_trace\", \"marker_observation\"}\n44|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
