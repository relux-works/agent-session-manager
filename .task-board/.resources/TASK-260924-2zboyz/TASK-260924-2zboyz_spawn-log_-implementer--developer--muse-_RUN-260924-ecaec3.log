{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c88f","stream":{"kind":"session","id":"01a0d4c8-c91a-7382-bd41-b29e82ff449b"},"sequence":674,"recorded_at":1780531400001343,"record_type":"event","durability":"durable","causation_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","run_stream":{"kind":"run","id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6"},"task_stream":{"kind":"task","id":"01a0d4cb-f3c3-73a3-ac34-ab47694959f9"},"task_id":"01a0d4cb-f3c3-73a3-ac34-ab47694959f9","event":{"kind":"output","task_id":"01a0d4cb-f3c3-73a3-ac34-ab47694959f9","chunk":"Read text file `internal/clonereadback/utf8_test.go`.\n1|package clonereadback_test\n2|\n3|import (\n4|\t\"reflect\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|\n8|\tclonereadback \"github.com/relux-works/agent-session-manager/internal/clonereadback\"\n9|)\n10|\n11|// This file proves by reflection that invalid UTF-8 is refused at\n12|// every Build-side string gate: the walker derives every string\n13|// field of the production input types (nested rows included) and\n14|// feeds each lone-invalid bytes plus trailing-invalid bytes. Raw\n15|// JSON members ride owner decoders; the owner suites pin their\n16|// UTF-8 behavior, and the delegation table pins the wiring.\n17|\n18|// stringField describes one derived Build-side string: a setter\n19|// over a fresh valid input plus the refusal literal.\n20|type stringField struct {\n21|\tlabel  string\n22|\tset    func(valid clonereadback.ReadBackManifestInput, validReport clonereadback.ValidationReportInput, value string) (clonereadback.ReadBackManifestInput, clonereadback.ValidationReportInput, bool)\n23|\tmember string\n24|}\n25|\n26|// buildUTF8Fields derives every string field of the two input\n27|// types by reflection. The derivation fails loudly on any field\n28|// kind it cannot classify; the inventory test pins the exact field\n29|// count so a silently skipped string is a red test, not a gap.\n30|func buildUTF8Fields(t *testing.T) []stringField {\n31|\tt.Helper()\n32|\tvar fields []stringField\n33|\tcollectStrings(t, reflect.TypeOf(clonereadback.ReadBackManifestInput{}), \"readback\", &fields)\n34|\tcollectStrings(t, reflect.TypeOf(clonereadback.EvidenceObjectInput{}), \"evidence\", &fields)\n35|\tcollectStrings(t, reflect.TypeOf(clonereadback.ValidationReportInput{}), \"report\", &fields)\n36|\treturn fields\n37|}\n38|\n39|func collectStrings(t *testing.T, typ reflect.Type, shape string, fields *[]stringField) {\n40|\tt.Helper()\n41|\tfor index := 0; index < typ.NumField(); index++ {\n42|\t\tfield := typ.Field(index)\n43|\t\tif field.PkgPath != \"\" {\n44|\t\t\tt.Fatalf(\"unexported field %s.%s: extend the walker\", shape, field.Name)\n45|\t\t}\n46|\t\tmember := snakeMember(field.Name)\n47|\t\tif irregular, ok := irregularMembers[field.Name]; ok {\n48|\t\t\tmember = irregular\n49|\t\t}\n50|\t\tswitch field.Type.Kind() {\n51|\t\tcase reflect.String:\n52|\t\t\tname := field.Name\n53|\t\t\tshapeName := shape\n54|\t\t\tmemberName := member\n55|\t\t\t*fields = append(*fields, stringField{\n56|\t\t\t\tlabel:  shapeName + \".\" + name,\n57|\t\t\t\tmember: memberName,\n58|\t\t\t\tset: func(valid clonereadback.ReadBackManifestInput, validReport clonereadback.ValidationReportInput, value string) (clonereadback.ReadBackManifestInput, clonereadback.ValidationReportInput, bool) {\n59|\t\t\t\t\tswitch shapeName {\n60|\t\t\t\t\tcase \"readback\":\n61|\t\t\t\t\t\treflect.ValueOf(&valid).Elem().FieldByName(name).SetString(value)\n62|\t\t\t\t\t\treturn valid, validReport, true\n63|\t\t\t\t\tcase \"report\":\n64|\t\t\t\t\t\treflect.ValueOf(&validReport).Elem().FieldByName(name).SetString(value)\n65|\t\t\t\t\t\treturn valid, validReport, false\n66|\t\t\t\t\tcase \"evidence\":\n67|\t\t\t\t\t\tvalid.EvidenceObjects = []clonereadback.EvidenceObjectInput{validEvidenceInput(\"native_sample\", \"utf8\")}\n68|\t\t\t\t\t\treflect.ValueOf(&valid.EvidenceObjects[0]).Elem().FieldByName(name).SetString(value)\n69|\t\t\t\t\t\treturn valid, validReport, true\n70|\t\t\t\t\t}\n71|\t\t\t\t\treturn valid, validReport, true\n72|\t\t\t\t},\n73|\t\t\t})\n74|\t\tcase reflect.Bool, reflect.Uint64, reflect.Map:\n75|\t\t\t// Non-string leaves: nothing to feed.\n76|\t\tcase reflect.Slice, reflect.Array:\n77|\t\t\telement := field.Type.Elem()\n78|\t\t\tswitch element.Kind() {\n79|\t\t\tcase reflect.Uint8, reflect.Struct:\n80|\t\t\t\t// Raw JSON and nested rows: rows are walked\n81|\t\t\t\t// as their own type above; raw JSON rides\n82|\t\t\t\t// owner decoders.\n83|\t\t\tcase reflect.String:\n84|\t\t\t\tif field.Name != \"ParsedHeadIDs\" {\n85|\t\t\t\t\tt.Fatalf(\"string slice %s.%s is not the heads member: extend the walker\", shape, field.Name)\n86|\t\t\t\t}\n87|\t\t\tdefault:\n88|\t\t\t\tt.Fatalf(\"unhandled slice element kind %s at %s.%s: extend the walker\", element.Kind(), shape, field.Name)\n89|\t\t\t}\n90|\t\tdefault:\n91|\t\t\tt.Fatalf(\"unhandled kind %s at %s.%s: extend the walker\", field.Type.Kind(), shape, field.Name)\n92|\t\t}\n93|\t}\n94|}\n95|\n96|// TestBuildUTF8Reflection feeds invalid UTF-8 to every derived\n97|// Build-side string field at the production Build entries: each\n98|// refuses with its member literal.\n99|func TestBuildUTF8Reflection(t *testing.T) {\n100|\tstaged, live := mustReadPair(t)\n101|\tpoison := []string{string([]byte{0xff}), \"ok-prefix-\\xff\", \"\\xff-ok-suffix\"}\n102|\tfor _, field := range buildUTF8Fields(t) {\n103|\t\tfor _, value := range poison {\n104|\t\t\tinput, rinput, isReadBack := field.set(validReadBackInput(), validReportInput(staged, live), value)\n105|\t\t\tif isReadBack {\n106|\t\t\t\t_, err := clonereadback.BuildReadBackEvidenceManifest(input, stagedAuthority(t))\n107|\t\t\t\tif err == nil {\n108|\t\t\t\t\tt.Fatalf(\"field %s admits invalid UTF-8 at Build\", field.label)\n109|\t\t\t\t}\n110|\t\t\t\tif !strings.Contains(err.Error(), field.member) {\n111|\t\t\t\t\tt.Fatalf(\"field %s error %q misses member literal %q\", field.label, err.Error(), field.member)\n112|\t\t\t\t}\n113|\t\t\t} else {\n114|\t\t\t\t_, err := clonereadback.BuildValidationReport(rinput, staged, live)\n115|\t\t\t\tif err == nil {\n116|\t\t\t\t\tt.Fatalf(\"field %s admits invalid UTF-8 at Build\", field.label)\n117|\t\t\t\t}\n118|\t\t\t\tif !strings.Contains(err.Error(), field.member) {\n119|\t\t\t\t\tt.Fatalf(\"field %s error %q misses member literal %q\", field.label, err.Error(), field.member)\n120|\t\t\t\t}\n121|\t\t\t}\n122|\t\t}\n123|\t}\n124|}\n125|\n126|// TestBuildUTF8HeadsAndExtensions feeds invalid UTF-8 to the heads\n127|// array items and one extension value at both production Build\n128|// entries.\n129|func TestBuildUTF8HeadsAndExtensions(t *testing.T) {\n130|\tstaged, live := mustReadPair(t)\n131|\tinput := validReadBackInput()\n132|\tinput.ParsedHeadIDs = []string{\"head-a\", \"bad-\\xff\"}\n133|\t_, err := clonereadback.BuildReadBackEvidenceManifest(input, stagedAuthority(t))\n134|\trequireRefusal(t, err, \"read-back evidence manifest\", \"parsed_head_ids\")\n135|\tinput = validReadBackInput()\n136|\tinput.Extensions = map[string]any{\"com.example.note\": \"bad-\\xff\"}\n137|\t_, err = clonereadback.BuildReadBackEvidenceManifest(input, stagedAuthority(t))\n138|\trequireRefusal(t, err, \"read-back evidence manifest\", \"extensions invalid\")\n139|\trinput := validReportInput(staged, live)\n140|\trinput.Extensions = map[string]any{\"com.example.note\": \"bad-\\xff\"}\n141|\t_, err = clonereadback.BuildValidationReport(rinput, staged, live)\n142|\trequireRefusal(t, err, \"clone validation report\", \"extensions invalid\")\n143|}\n144|\n145|// TestUTF8FieldInventory pins the derivation count: 7 read-back\n146|// strings, 4 evidence strings, 9 report strings.\n147|func TestUTF8FieldInventory(t *testing.T) {\n148|\tfields := buildUTF8Fields(t)\n149|\tcounts := map[string]int{}\n150|\tfor _, field := range fields {\n151|\t\tshape := field.label[:strings.Index(field.label, \".\")]\n152|\t\tcounts[shape]++\n153|\t}\n154|\tif counts[\"readback\"] != 7 || counts[\"evidence\"] != 4 || counts[\"report\"] != 9 {\n155|\t\tt.Fatalf(\"utf8 fields = %v, want readback=7 evidence=4 report=9\", counts)\n156|\t}\n157|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c891","stream":{"kind":"session","id":"01a0d4c8-c91a-7382-bd41-b29e82ff449b"},"sequence":675,"recorded_at":1780531400001345,"record_type":"event","durability":"durable","causation_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","run_stream":{"kind":"run","id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6"},"task_stream":{"kind":"task","id":"01a0d4cb-f3c3-73a3-ac34-ab47694959f9"},"task_id":"01a0d4cb-f3c3-73a3-ac34-ab47694959f9","event":{"kind":"completed","task_id":"01a0d4cb-f3c3-73a3-ac34-ab47694959f9"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c893","stream":{"kind":"session","id":"01a0d4c8-c91a-7382-bd41-b29e82ff449b"},"sequence":676,"recorded_at":1780531400001347,"record_type":"event","durability":"durable","causation_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","run_stream":{"kind":"run","id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6"},"task_stream":{"kind":"task","id":"01a0d4cb-f31e-7051-a412-a22dcd1d20fa"},"task_id":"01a0d4cb-f31e-7051-a412-a22dcd1d20fa","event":{"kind":"output","task_id":"01a0d4cb-f31e-7051-a412-a22dcd1d20fa","chunk":"Read text file `internal/clonereadback/identity_test.go`.\n1|package clonereadback_test\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"encoding/json\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/gowebpki/jcs\"\n10|\n11|\tclonereadback \"github.com/relux-works/agent-session-manager/internal/clonereadback\"\n12|)\n13|\n14|// independentSelfDigest recomputes the omit-self identity without\n15|// touching production: plain marshal, JCS transform, SHA-256. The\n16|// canonical-bytes path is shared infrastructure (JCS itself); the\n17|// omission choice and digest comparison are independent.\n18|func independentSelfDigest(t *testing.T, sealed []byte, self string) string {\n19|\tt.Helper()\n20|\tvar document map[string]any\n21|\tif err := json.Unmarshal(sealed, &document); err != nil {\n22|\t\tt.Fatalf(\"unmarshal sealed: %v\", err)\n23|\t}\n24|\tdelete(document, self)\n25|\tplain, err := json.Marshal(document)\n26|\tif err != nil {\n27|\t\tt.Fatalf(\"marshal omitted: %v\", err)\n28|\t}\n29|\tcanonical, err := jcs.Transform(plain)\n30|\tif err != nil {\n31|\t\tt.Fatalf(\"JCS transform: %v\", err)\n32|\t}\n33|\tsum := sha256.Sum256(canonical)\n34|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n35|}\n36|\n37|// TestReadBackIdentityIndependent pins that\n38|// read_back_evidence_manifest_id is the JCS digest with only itself\n39|// omitted: the independent recompute agrees, omitting a different\n40|// member disagrees, and a tampered claim refuses.\n41|func TestReadBackIdentityIndependent(t *testing.T) {\n42|\tsealed := mustBuildReadBack(t, stagedAuthority(t), validReadBackInput())\n43|\tdocument := decodeDocument(t, sealed)\n44|\tclaimed, ok := document[\"read_back_evidence_manifest_id\"].(string)\n45|\tif !ok {\n46|\t\tt.Fatal(\"read_back_evidence_manifest_id is not a string\")\n47|\t}\n48|\tif got := independentSelfDigest(t, sealed, \"read_back_evidence_manifest_id\"); got != claimed {\n49|\t\tt.Fatalf(\"independent digest = %s, sealed claim = %s\", got, claimed)\n50|\t}\n51|\tif got := independentSelfDigest(t, sealed, \"mode\"); got == claimed {\n52|\t\tt.Fatal(\"omitting mode instead of the id agrees: the omission rule is not pinned\")\n53|\t}\n54|\tdocument[\"read_back_evidence_manifest_id\"] = fixtureDigest(\"tampered-claim\")\n55|\t_, err := clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document), stagedAuthority(t))\n56|\trequireRefusal(t, err, \"read_back_evidence_manifest_id\", \"does not match omit-self digest\")\n57|\tdocument = decodeDocument(t, sealed)\n58|\tdocument[\"read_back_evidence_manifest_id\"] = \"not-a-digest\"\n59|\t_, err = clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document), stagedAuthority(t))\n60|\trequireRefusal(t, err, \"read_back_evidence_manifest_id\", \"is not a digest\")\n61|}\n62|\n63|// TestReportIdentityIndependent pins that validation_report_id is\n64|// the JCS digest with only itself omitted.\n65|func TestReportIdentityIndependent(t *testing.T) {\n66|\tstaged, live := mustReadPair(t)\n67|\tsealed := mustBuildReport(t, validReportInput(staged, live), staged, live)\n68|\tdocument := decodeDocument(t, sealed)\n69|\tclaimed, ok := document[\"validation_report_id\"].(string)\n70|\tif !ok {\n71|\t\tt.Fatal(\"validation_report_id is not a string\")\n72|\t}\n73|\tif got := independentSelfDigest(t, sealed, \"validation_report_id\"); got != claimed {\n74|\t\tt.Fatalf(\"independent digest = %s, sealed claim = %s\", got, claimed)\n75|\t}\n76|\tif got := independentSelfDigest(t, sealed, \"valid\"); got == claimed {\n77|\t\tt.Fatal(\"omitting valid instead of the id agrees: the omission rule is not pinned\")\n78|\t}\n79|\tdocument[\"validation_report_id\"] = fixtureDigest(\"tampered-claim\")\n80|\t_, err := clonereadback.DecodeValidationReport(marshalDocument(t, document), staged, live)\n81|\trequireRefusal(t, err, \"validation_report_id\", \"does not match omit-self digest\")\n82|\tdocument = decodeDocument(t, sealed)\n83|\tdocument[\"validation_report_id\"] = \"not-a-digest\"\n84|\t_, err = clonereadback.DecodeValidationReport(marshalDocument(t, document), staged, live)\n85|\trequireRefusal(t, err, \"validation_report_id\", \"is not a digest\")\n86|}\n87|\n88|// TestModeRelabelRefused pins \"Modes cannot be relabeled\"\n89|// (SPEC v0.7.0 §13.14.2 line 10580 and lines 10753-10754):\n90|// flipping the mode under a sealed id refuses at the production\n91|// decode entry; under the producing authority the refusal is the\n92|// authority mismatch (the gate reads the claim against trusted\n93|// purpose, not bytes), and under the flipped authority — where\n94|// the claim agrees — the stale id refuses as an identity\n95|// mismatch. Either way the relabeled bytes are a different\n96|// document, never the same manifest.\n97|func TestModeRelabelRefused(t *testing.T) {\n98|\tfor _, mode := range []string{\"staged\", \"live\"} {\n99|\t\tauthority := stagedAuthority(t)\n100|\t\tflippedAuthority := liveAuthority(t)\n101|\t\tflipped := \"live\"\n102|\t\tif mode == \"live\" {\n103|\t\t\tauthority = liveAuthority(t)\n104|\t\t\tflippedAuthority = stagedAuthority(t)\n105|\t\t\tflipped = \"staged\"\n106|\t\t}\n107|\t\tinput := validReadBackInput()\n108|\t\tinput.Mode = mode\n109|\t\tsealed := mustBuildReadBack(t, authority, input)\n110|\t\tdocument := decodeDocument(t, sealed)\n111|\t\tdocument[\"mode\"] = flipped\n112|\t\t_, err := clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document), authority)\n113|\t\trequireRefusal(t, err, \"read-back evidence manifest\", \"disagrees with read authority purpose\")\n114|\t\t_, err = clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document), flippedAuthority)\n115|\t\trequireRefusal(t, err, \"read_back_evidence_manifest_id\", \"does not match omit-self digest\")\n116|\t}\n117|}\n118|\n119|// TestModeBindsIdentity pins that the mode binds the authority,\n120|// not just the bytes (SPEC v0.7.0 §13.14.2 lines 10753-10754:\n121|// \"Staged and live manifests are distinct and cannot be\n122|// relabeled.\"): the same logical inputs sealed under staged and\n123|// live carry different ids, and resealing the flipped mode under\n124|// its own recomputed id REFUSES under the producing authority —\n125|// the digest alone does not carry the stage, so a recomputed\n126|// digest never authorizes the opposite mode.\n127|func TestModeBindsIdentity(t *testing.T) {\n128|\tstagedInput := validReadBackInput()\n129|\tstagedInput.Mode = \"staged\"\n130|\tliveInput := validReadBackInput()\n131|\tliveInput.Mode = \"live\"\n132|\tstaged := mustBuildReadBack(t, stagedAuthority(t), stagedInput)\n133|\tlive := mustBuildReadBack(t, liveAuthority(t), liveInput)\n134|\tstagedDoc := decodeDocument(t, staged)\n135|\tliveDoc := decodeDocument(t, live)\n136|\tif stagedDoc[\"read_back_evidence_manifest_id\"] == liveDoc[\"read_back_evidence_manifest_id\"] {\n137|\t\tt.Fatal(\"staged and live manifests share an id: modes do not bind identity\")\n138|\t}\n139|\trelabeled := decodeDocument(t, staged)\n140|\trelabeled[\"mode\"] = \"live\"\n141|\trelabeled[\"read_back_evidence_manifest_id\"] = independentSelfDigest(t, marshalDocument(t, relabeled), \"read_back_evidence_manifest_id\")\n142|\tif relabeled[\"read_back_evidence_manifest_id\"] != liveDoc[\"read_back_evidence_manifest_id\"] {\n143|\t\tt.Fatal(\"recomputed relabel id disagrees with the live seal: identity is not a pure function of members\")\n144|\t}\n145|\t_, err := clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, relabeled), stagedAuthority(t))\n146|\trequireRefusal(t, err, \"read-back evidence manifest\", \"disagrees with read authority purpose\")\n147|}","final_result":true}}}
