{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c619","stream":{"kind":"session","id":"01a0d4c8-c91a-7382-bd41-b29e82ff449b"},"sequence":359,"recorded_at":1780531400000713,"record_type":"event","durability":"durable","causation_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","run_stream":{"kind":"run","id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6"},"task_stream":{"kind":"task","id":"01a0d4c9-dfac-7d91-a872-320a61164211"},"task_id":"01a0d4c9-dfac-7d91-a872-320a61164211","event":{"kind":"output","task_id":"01a0d4c9-dfac-7d91-a872-320a61164211","chunk":"Read text file `internal/clonereadback/readback.go`.\n1|package clonereadback\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"fmt\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n10|)\n11|\n12|// This file validates and constructs Clone Read-Back Evidence\n13|// Manifest 1.0.0: the closed 15-member manifest Section 13.14.2\n14|// states, binding operation, staged|live mode, plan and projected\n15|// manifest, equal expected/observed native Session IDs, observed\n16|// tuple, parsed count/heads, Workspace Binding, structural digest,\n17|// and sorted evidence blobs. The mode is derived from the trusted\n18|// read authority the caller threads from its authority chain and\n19|// the manifest claim must agree with it: a resealed opposite mode\n20|// refuses as an authority mismatch even though its self-digest\n21|// recomputes, because the digest alone does not carry the stage.\n22|// Staged and live manifests are distinct documents, never two\n23|// readings of one.\n24|\n25|const (\n26|\treadBackSchema   = \"urn:ax:schema:clone-read-back-evidence-manifest\"\n27|\treadBackVersion  = \"1.0.0\"\n28|\treadBackSelf     = \"read_back_evidence_manifest_id\"\n29|\tmaxEvidenceRows  = 65536\n30|\tmaxParsedHeadIDs = 1024\n31|)\n32|\n33|var readBackMembers = map[string]bool{\n34|\t\"schema\": true, \"schema_version\": true,\n35|\t\"read_back_evidence_manifest_id\": true, \"operation_id\": true,\n36|\t\"mode\": true, \"projection_plan_id\": true,\n37|\t\"projected_object_manifest_id\":      true,\n38|\t\"expected_target_native_session_id\": true,\n39|\t\"observed_target_native_session_id\": true,\n40|\t\"observed_environment\":              true,\n41|\t\"parsed_event_count\":                true,\n42|\t\"parsed_head_ids\":                   true,\n43|\t\"workspace_binding\":                 true,\n44|\t\"structural_digest\":                 true,\n45|\t\"evidence_objects\":                  true, \"extensions\": true,\n46|}\n47|\n48|var readBackRequired = []string{\n49|\t\"schema\", \"schema_version\",\n50|\t\"read_back_evidence_manifest_id\", \"operation_id\",\n51|\t\"mode\", \"projection_plan_id\",\n52|\t\"projected_object_manifest_id\",\n53|\t\"expected_target_native_session_id\",\n54|\t\"observed_target_native_session_id\",\n55|\t\"observed_environment\",\n56|\t\"parsed_event_count\",\n57|\t\"parsed_head_ids\",\n58|\t\"workspace_binding\",\n59|\t\"structural_digest\",\n60|\t\"evidence_objects\", \"extensions\",\n61|}\n62|\n63|var evidenceMembers = map[string]bool{\n64|\t\"evidence_kind\": true, \"media_type\": true,\n65|\t\"byte_count\": true, \"blob_id\": true,\n66|\t\"blob_descriptor_id\": true,\n67|}\n68|\n69|var evidenceRequired = []string{\n70|\t\"evidence_kind\", \"media_type\",\n71|\t\"byte_count\", \"blob_id\",\n72|\t\"blob_descriptor_id\",\n73|}\n74|\n75|// EvidenceObject is one validated evidence row: the closed kind, a\n76|// media type, a byte count, and the blob pair.\n77|type EvidenceObject struct {\n78|\tEvidenceKind     string\n79|\tMediaType        string\n80|\tByteCount        uint64\n81|\tBlobID           scalar.Digest\n82|\tBlobDescriptorID scalar.Digest\n83|}\n84|\n85|// EvidenceObjectInput is the caller-supplied evidence row candidate\n86|// for Build.\n87|type EvidenceObjectInput struct {\n88|\tEvidenceKind     string\n89|\tMediaType        string\n90|\tByteCount        uint64\n91|\tBlobID           string\n92|\tBlobDescriptorID string\n93|}\n94|\n95|// ReadBackManifest is one validated Clone Read-Back Evidence\n96|// Manifest 1.0.0.\n97|type ReadBackManifest struct {\n98|\tManifestID                  scalar.Digest\n99|\tOperationID                 scalar.UUIDv7\n100|\tMode                        string\n101|\tProjectionPlanID            scalar.Digest\n102|\tProjectedObjectManifestID   scalar.Digest\n103|\tExpectedTargetNativeSession string\n104|\tObservedTargetNativeSession string\n105|\tObservedEnvironment         sessadapter.Tuple\n106|\tParsedEventCount            uint64\n107|\tParsedHeadIDs               []string\n108|\tWorkspaceBinding            clonebundle.WorkspaceBinding\n109|\tStructuralDigest            scalar.Digest\n110|\tEvidenceObjects             []EvidenceObject\n111|}\n112|\n113|// ReadBackManifestInput is the caller-supplied read-back manifest\n114|// candidate for Build. Nested closed shapes (observed tuple,\n115|// workspace binding) arrive as raw JSON and decode through their\n116|// owners; extensions arrive as a Go map and seal through the\n117|// closed-extensions owner.\n118|type ReadBackManifestInput struct {\n119|\tOperationID                 string\n120|\tMode                        string\n121|\tProjectionPlanID            string\n122|\tProjectedObjectManifestID   string\n123|\tExpectedTargetNativeSession string\n124|\tObservedTargetNativeSession string\n125|\tObservedEnvironment         []byte\n126|\tParsedEventCount            uint64\n127|\tParsedHeadIDs               []string\n128|\tWorkspaceBinding            []byte\n129|\tStructuralDigest            string\n130|\tEvidenceObjects             []EvidenceObjectInput\n131|\tExtensions                  map[string]any\n132|}\n133|\n134|// buildEvidenceObject validates one caller-supplied evidence row\n135|// and renders its closed object.\n136|func buildEvidenceObject(input EvidenceObjectInput, index int) (EvidenceObject, map[string]any, error) {\n137|\towner := fmt.Sprintf(\"evidence object[%d]\", index)\n138|\tif !validText(input.EvidenceKind) {\n139|\t\treturn EvidenceObject{}, nil, invalid(\"%s evidence_kind is not valid UTF-8\", owner)\n140|\t}\n141|\tif !ValidEvidenceKind(input.EvidenceKind) {\n142|\t\treturn EvidenceObject{}, nil, invalid(\"%s evidence_kind is outside native_sample|parser_trace|marker_observation\", owner)\n143|\t}\n144|\tif !validText(input.MediaType) {\n145|\t\treturn EvidenceObject{}, nil, invalid(\"%s media_type is not valid UTF-8\", owner)\n146|\t}\n147|\tif length := stringLength(input.MediaType); length < 1 || length > 128 {\n148|\t\treturn EvidenceObject{}, nil, invalid(\"%s media_type is not a string[1..128]\", owner)\n149|\t}\n150|\tif input.ByteCount > maxUint53 {\n151|\t\treturn EvidenceObject{}, nil, invalid(\"%s byte_count exceeds uint53\", owner)\n152|\t}\n153|\tblob, err := scalar.ParseDigest(input.BlobID)\n154|\tif err != nil {\n155|\t\treturn EvidenceObject{}, nil, invalid(\"%s blob_id is not a digest: %v\", owner, err)\n156|\t}\n157|\tdescriptor, err := scalar.ParseDigest(input.BlobDescriptorID)\n158|\tif err != nil {\n159|\t\treturn EvidenceObject{}, nil, invalid(\"%s blob_descriptor_id is not a digest: %v\", owner, err)\n160|\t}\n161|\trow := EvidenceObject{\n162|\t\tEvidenceKind:     input.EvidenceKind,\n163|\t\tMediaType:        input.MediaType,\n164|\t\tByteCount:        input.ByteCount,\n165|\t\tBlobID:           blob,\n166|\t\tBlobDescriptorID: descriptor,\n167|\t}\n168|\tobject := map[string]any{\n169|\t\t\"evidence_kind\":      input.EvidenceKind,\n170|\t\t\"media_type\":         input.MediaType,\n171|\t\t\"byte_count\":         input.ByteCount,\n172|\t\t\"blob_id\":            blob.String(),\n173|\t\t\"blob_descriptor_id\": descriptor.String(),\n174|\t}\n175|\treturn row, object, nil\n176|}\n177|\n178|// decodeEvidenceObject validates one closed EvidenceObject.\n179|func decodeEvidenceObject(raw json.RawMessage, index int) (EvidenceObject, error) {\n180|\towner := \"evidence object\"\n181|\tmembers, fault := decodeStrictObject(raw)\n182|\tif fault != nil {\n183|\t\treturn EvidenceObject{}, invalid(\"%s[%d] %s (%s)\", owner, index, fault.detail, memberField(fault.member))\n184|\t}\n185|\tif name, unknown := unknownMember(members, evidenceMembers); unknown {\n186|\t\treturn EvidenceObject{}, invalid(\"%s[%d] carries unknown member %q\", owner, index, name)\n187|\t}\n188|\tif name, missing := missingMember(members, evidenceRequired); missing {\n189|\t\treturn EvidenceObject{}, invalid(\"%s[%d] misses a required member %q\", owner, index, name)\n190|\t}\n191|\tkind, ok := rawString(members[\"evidence_kind\"])\n192|\tif !ok || !ValidEvidenceKind(kind) {\n193|\t\treturn EvidenceObject{}, invalid(\"%s[%d] evidence_kind is outside native_sample|parser_trace|marker_observation\", owner, index)\n194|\t}\n195|\tmedia, ok := checkStringBounds(members[\"media_type\"], 1, 128)\n196|\tif !ok {\n197|\t\treturn EvidenceObject{}, invalid(\"%s[%d] media_type is not a string[1..128]\", owner, index)\n198|\t}\n199|\tcount, ok := checkUint53Bounds(members[\"byte_count\"], 0, maxUint53)\n200|\tif !ok {\n201|\t\treturn EvidenceObject{}, invalid(\"%s[%d] byte_count is not a uint53\", owner, index)\n202|\t}\n203|\tblob, ok := checkDigest(members[\"blob_id\"])\n204|\tif !ok {\n205|\t\treturn EvidenceObject{}, invalid(\"%s[%d] blob_id is not a digest\", owner, index)\n206|\t}\n207|\tdescriptor, ok := checkDigest(members[\"blob_descriptor_id\"])\n208|\tif !ok {\n209|\t\treturn EvidenceObject{}, invalid(\"%s[%d] blob_descriptor_id is not a digest\", owner, index)\n210|\t}\n211|\treturn EvidenceObject{\n212|\t\tEvidenceKind:     kind,\n213|\t\tMediaType:        media,\n214|\t\tByteCount:        count,\n215|\t\tBlobID:           blob,\n216|\t\tBlobDescriptorID: descriptor,\n217|\t}, nil\n218|}\n219|\n220|// checkEvidenceOrder enforces \"sorted unique by evidence kind/blob\n221|// ID\": the (kind, blob ID) pairs are strictly increasing in\n222|// bytewise string order. Both entries share this gate over the\n223|// sealed row set.\n224|func checkEvidenceOrder(rows []EvidenceObject) error {\n225|\tfor index := 1; index < len(rows); index++ {\n226|\t\tprevious := rows[index-1]\n227|\t\tcurrent := rows[index]\n228|\t\tif current.EvidenceKind < previous.EvidenceKind ||\n229|\t\t\t(current.EvidenceKind == previous.EvidenceKind && current.BlobID.String() <= previous.BlobID.String()) {\n230|\t\t\treturn invalid(\"read-back evidence manifest evidence_objects are not sorted unique by evidence kind/blob ID\")\n231|\t\t}\n232|\t}\n233|\treturn nil\n234|}\n235|\n236|// checkEvidenceCount enforces the evidence cardinality bound\n237|// EvidenceObject[0..65536]. The gate is factored so the exact upper\n238|// edge pins at the gate while row reachability pins at both\n239|// entries.\n240|func checkEvidenceCount(count int) error {\n241|\tif count < 0 || count > maxEvidenceRows {\n242|\t\treturn invalid(\"read-back evidence manifest carries %d evidence_objects, want [0..65536]\", count)\n243|\t}\n244|\treturn nil\n245|}\n246|\n247|// checkNativeIdentityMatch enforces the pinned equality of the two\n248|// native Session IDs: the observed target session is the expected\n249|// one, never a neighbor. Both entries share this gate.\n250|func checkNativeIdentityMatch(expected, observed string) error {\n251|\tif expected != observed {\n252|\t\treturn invalid(\"read-back evidence manifest expected and observed native Session IDs differ\")\n253|\t}\n254|\treturn nil\n255|}\n256|\n257|// BuildReadBackEvidenceManifest constructs one closed Clone\n258|// Read-Back Evidence Manifest 1.0.0 as canonical bytes. Identical\n259|// inputs produce byte-identical outputs. The authority carries the\n260|// trusted read purpose from the caller chain; the claimed mode\n261|// must agree with the mode that purpose derives, or the build\n262|// refuses as a relabel. Every closed-shape, mode, equality,\n263|// order, and vocabulary rule is a refusal, never a repair.\n264|func BuildReadBackEvidenceManifest(input ReadBackManifestInput, authority sessadapter.ReadAuthority) ([]byte, error) {\n265|\t_, object, err := buildReadBackManifest(input, authority)\n266|\tif err != nil {\n267|\t\treturn nil, err\n268|\t}\n269|\tomitted, err := canonicalizeObject(object)\n270|\tif err != nil {\n271|\t\treturn nil, err\n272|\t}\n273|\tmanifestID := scalar.SHA256Digest(omitted)\n274|\tobject[readBackSelf] = manifestID.String()\n275|\treturn canonicalizeObject(object)\n276|}\n277|\n278|func buildReadBackManifest(input ReadBackManifestInput, authority sessadapter.ReadAuthority) (ReadBackManifest, map[string]any, error) {\n279|\towner := \"read-back evidence manifest\"\n280|\toperation, err := scalar.ParseUUIDv7(input.OperationID)\n281|\tif err != nil {\n282|\t\treturn ReadBackManifest{}, nil, invalid(\"%s operation_id is not a UUIDv7: %v\", owner, err)\n283|\t}\n284|\tif !validText(input.Mode) {\n285|\t\treturn ReadBackManifest{}, nil, invalid(\"%s mode is not valid UTF-8\", owner)\n286|\t}\n287|\tif !ValidReadBackMode(input.Mode) {\n288|\t\treturn ReadBackManifest{}, nil, invalid(\"%s mode is outside staged|live\", owner)\n289|\t}\n290|\texpectedMode, err := modeForAuthorityPurpose(authority.Purpose)\n291|\tif err != nil {\n292|\t\treturn ReadBackManifest{}, nil, err\n293|\t}\n294|\tif err := checkModeAuthority(owner, input.Mode, expectedMode, authority.Purpose); err != nil {\n295|\t\treturn ReadBackManifest{}, nil, err\n296|\t}\n297|\tplanID, err := scalar.ParseDigest(input.ProjectionPlanID)\n298|\tif err != nil {\n299|\t\treturn ReadBackManifest{}, nil, invalid(\"%s projection_plan_id is not a digest: %v\", owner, err)\n300|\t}\n301|\tmanifestID, err := scalar.ParseDigest(input.ProjectedObjectManifestID)\n302|\tif err != nil {\n303|\t\treturn ReadBackManifest{}, nil, invalid(\"%s projected_object_manifest_id is not a digest: %v\", owner, err)\n304|\t}\n305|\tif !validText(input.ExpectedTargetNativeSession) {\n306|\t\treturn ReadBackManifest{}, nil, invalid(\"%s expected_target_native_session_id is not valid UTF-8\", owner)\n307|\t}\n308|\tif length := stringLength(input.ExpectedTargetNativeSession); length < 1 || length > 512 {\n309|\t\treturn ReadBackManifest{}, nil, invalid(\"%s expected_target_native_session_id is not a string[1..512]\", owner)\n310|\t}\n311|\tif !validText(input.ObservedTargetNativeSession) {\n312|\t\treturn ReadBackManifest{}, nil, invalid(\"%s observed_target_native_session_id is not valid UTF-8\", owner)\n313|\t}\n314|\tif length := stringLength(input.ObservedTargetNativeSession); length < 1 || length > 512 {\n315|\t\treturn ReadBackManifest{}, nil, invalid(\"%s observed_target_native_session_id is not a string[1..512]\", owner)\n316|\t}\n317|\tif err := checkNativeIdentityMatch(input.ExpectedTargetNativeSession, input.ObservedTargetNativeSession); err != nil {\n318|\t\treturn ReadBackManifest{}, nil, err\n319|\t}\n320|\tobservedTuple, err := sessadapter.DecodeTuple(json.RawMessage(input.ObservedEnvironment))\n321|\tif err != nil {\n322|\t\treturn ReadBackManifest{}, nil, invalid(\"%s observed_environment is not an Environment Tuple: %v\", owner, err)\n323|\t}\n324|\tif input.ParsedEventCount > maxUint53 {\n325|\t\treturn ReadBackManifest{}, nil, invalid(\"%s parsed_event_count exceeds uint53\", owner)\n326|\t}\n327|\theads, err := checkSortedUniqueBoundedStrings(input.ParsedHeadIDs, 1, 512, 0, maxParsedHeadIDs, owner, \"parsed_head_ids\")\n328|\tif err != nil {\n329|\t\treturn ReadBackManifest{}, nil, err\n330|\t}\n331|\tbinding, err := clonebundle.DecodeWorkspaceBinding(json.RawMessage(input.WorkspaceBinding))\n332|\tif err != nil {\n333|\t\treturn ReadBackManifest{}, nil, invalid(\"%s workspace_binding is not a Workspace Binding: %v\", owner, err)\n334|\t}\n335|\tstructural, err := scalar.ParseDigest(input.StructuralDigest)\n336|\tif err != nil {\n337|\t\treturn ReadBackManifest{}, nil, invalid(\"%s structural_digest is not a digest: %v\", owner, err)\n338|\t}\n339|\tif err := checkEvidenceCount(len(input.EvidenceObjects)); err != nil {\n340|\t\treturn ReadBackManifest{}, nil, err\n341|\t}\n342|\trows := make([]EvidenceObject, 0, len(input.EvidenceObjects))\n343|\trowObjects := make([]any, 0, len(input.EvidenceObjects))\n344|\tfor index, candidate := range input.EvidenceObjects {\n345|\t\trow, object, err := buildEvidenceObject(candidate, index)\n346|\t\tif err != nil {\n347|\t\t\treturn ReadBackManifest{}, nil, err\n348|\t\t}\n349|\t\trows = append(rows, row)\n350|\t\trowObjects = append(rowObjects, object)\n351|\t}\n352|\tif err := checkEvidenceOrder(rows); err != nil {\n353|\t\treturn ReadBackManifest{}, nil, err\n354|\t}\n355|\textensions, err := clonebundle.EncodeExtensions(input.Extensions)\n356|\tif err != nil {\n357|\t\treturn ReadBackManifest{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n358|\t}\n359|\tvar extensionsValue any\n360|\tif err := json.Unmarshal(extensions, &extensionsValue); err != nil {\n361|\t\treturn ReadBackManifest{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n362|\t}\n363|\tmanifest := ReadBackManifest{\n364|\t\tOperationID:                 operation,\n365|\t\tMode:                        input.Mode,\n366|\t\tProjectionPlanID:            planID,\n367|\t\tProjectedObjectManifestID:   manifestID,\n368|\t\tExpectedTargetNativeSession: input.ExpectedTargetNativeSession,\n369|\t\tObservedTargetNativeSession: input.ObservedTargetNativeSession,\n370|\t\tObservedEnvironment:         observedTuple,\n371|\t\tParsedEventCount:            input.ParsedEventCount,\n372|\t\tParsedHeadIDs:               heads,\n373|\t\tWorkspaceBinding:            binding,\n374|\t\tStructuralDigest:            structural,\n375|\t\tEvidenceObjects:             rows,\n376|\t}\n377|\tobject := map[string]any{\n378|\t\t\"schema\":                            readBackSchema,\n379|\t\t\"schema_version\":                    readBackVersion,\n380|\t\t\"operation_id\":                      operation.String(),\n381|\t\t\"mode\":                              input.Mode,\n382|\t\t\"projection_plan_id\":                planID.String(),\n383|\t\t\"projected_object_manifest_id\":      manifestID.String(),\n384|\t\t\"expected_target_native_session_id\": input.ExpectedTargetNativeSession,\n385|\t\t\"observed_target_native_session_id\": input.ObservedTargetNativeSession,\n386|\t\t\"parsed_event_count\":                input.ParsedEventCount,\n387|\t\t\"parsed_head_ids\":                   stringValues(heads),\n388|\t\t\"structural_digest\":                 structural.String(),\n389|\t\t\"evidence_objects\":                  rowObjects,\n390|\t\t\"extensions\":                        extensionsValue,\n391|\t}\n392|\tvar tupleValue any\n393|\tif err := json.Unmarshal(input.ObservedEnvironment, &tupleValue); err != nil {\n394|\t\treturn ReadBackManifest{}, nil, invalid(\"%s observed_environment invalid: %v\", owner, err)\n395|\t}\n396|\tobject[\"observed_environment\"] = tupleValue\n397|\tvar bindingValue any\n398|\tif err := json.Unmarshal(input.WorkspaceBinding, &bindingValue); err != nil {\n399|\t\treturn ReadBackManifest{}, nil, invalid(\"%s workspace_binding invalid: %v\", owner, err)\n400|\t}\n401|\tobject[\"workspace_binding\"] = bindingValue\n402|\treturn manifest, object, nil\n403|}\n404|\n405|// DecodeReadBackEvidenceManifest validates one closed Clone\n406|// Read-Back Evidence Manifest 1.0.0: exact members, literal\n407|// schema/version, the closed mode bound to the trusted read\n408|// authority, equal native IDs, owner-decoded tuple and binding,\n409|// sorted heads and rows, and the omit-self identity. A relabeled\n410|// mode refuses as an authority mismatch even when the self-digest\n411|// recomputes.\n412|func DecodeReadBackEvidenceManifest(data []byte, authority sessadapter.ReadAuthority) (ReadBackManifest, error) {\n413|\towner := \"read-back evidence manifest\"\n414|\tmembers, fault := decodeStrictObject(data)\n415|\tif fault != nil {\n416|\t\treturn ReadBackManifest{}, invalid(\"%s %s (%s)\", owner, fault.detail, memberField(fault.member))\n417|\t}\n418|\tif name, unknown := unknownMember(members, readBackMembers); unknown {\n419|\t\treturn ReadBackManifest{}, invalid(\"%s carries unknown member %q\", owner, name)\n420|\t}\n421|\tif name, missing := missingMember(members, readBackRequired); missing {\n422|\t\treturn ReadBackManifest{}, invalid(\"%s misses a required member %q\", owner, name)\n423|\t}\n424|\tschema, ok := rawString(members[\"schema\"])\n425|\tif !ok || schema != readBackSchema {\n426|\t\treturn ReadBackManifest{}, invalid(\"%s schema is not urn:ax:schema:clone-read-back-evidence-manifest\", owner)\n427|\t}\n428|\tversion, ok := rawString(members[\"schema_version\"])\n429|\tif !ok || version != readBackVersion {\n430|\t\treturn ReadBackManifest{}, invalid(\"%s schema_version is not 1.0.0\", owner)\n431|\t}\n432|\tclaimed, ok := checkDigest(members[readBackSelf])\n433|\tif !ok {\n434|\t\treturn ReadBackManifest{}, invalid(\"%s read_back_evidence_manifest_id is not a digest\", owner)\n435|\t}\n436|\toperation, ok := checkUUIDv7(members[\"operation_id\"])\n437|\tif !ok {\n438|\t\treturn ReadBackManifest{}, invalid(\"%s operation_id is not a UUIDv7\", owner)\n439|\t}\n440|\tmode, ok := rawString(members[\"mode\"])\n441|\tif !ok || !ValidReadBackMode(mode) {\n442|\t\treturn ReadBackManifest{}, invalid(\"%s mode is outside staged|live\", owner)\n443|\t}\n444|\texpectedMode, err := modeForAuthorityPurpose(authority.Purpose)\n445|\tif err != nil {\n446|\t\treturn ReadBackManifest{}, err\n447|\t}\n448|\tif err := checkModeAuthority(owner, mode, expectedMode, authority.Purpose); err != nil {\n449|\t\treturn ReadBackManifest{}, err\n450|\t}\n451|\tplanID, ok := checkDigest(members[\"projection_plan_id\"])\n452|\tif !ok {\n453|\t\treturn ReadBackManifest{}, invalid(\"%s projection_plan_id is not a digest\", owner)\n454|\t}\n455|\tprojectedID, ok := checkDigest(members[\"projected_object_manifest_id\"])\n456|\tif !ok {\n457|\t\treturn ReadBackManifest{}, invalid(\"%s projected_object_manifest_id is not a digest\", owner)\n458|\t}\n459|\texpected, ok := checkStringBounds(members[\"expected_target_native_session_id\"], 1, 512)\n460|\tif !ok {\n461|\t\treturn ReadBackManifest{}, invalid(\"%s expected_target_native_session_id is not a string[1..512]\", owner)\n462|\t}\n463|\tobserved, ok := checkStringBounds(members[\"observed_target_native_session_id\"], 1, 512)\n464|\tif !ok {\n465|\t\treturn ReadBackManifest{}, invalid(\"%s observed_target_native_session_id is not a string[1..512]\", owner)\n466|\t}\n467|\tif err := checkNativeIdentityMatch(expected, observed); err != nil {\n468|\t\treturn ReadBackManifest{}, err\n469|\t}\n470|\tobservedTuple, err := sessadapter.DecodeTuple(members[\"observed_environment\"])\n471|\tif err != nil {\n472|\t\treturn ReadBackManifest{}, invalid(\"%s observed_environment is not an Environment Tuple: %v\", owner, err)\n473|\t}\n474|\tparsedCount, ok := checkUint53Bounds(members[\"parsed_event_count\"], 0, maxUint53)\n475|\tif !ok {\n476|\t\treturn ReadBackManifest{}, invalid(\"%s parsed_event_count is not a uint53\", owner)\n477|\t}\n478|\theads, ok := checkSortedUniqueStrings(members[\"parsed_head_ids\"], 1, 512, 0, maxParsedHeadIDs)\n479|\tif !ok {\n480|\t\treturn ReadBackManifest{}, invalid(\"%s parsed_head_ids are not sorted unique string[1..512][0..1024]\", owner)\n481|\t}\n482|\tbinding, err := clonebundle.DecodeWorkspaceBinding(members[\"workspace_binding\"])\n483|\tif err != nil {\n484|\t\treturn ReadBackManifest{}, invalid(\"%s workspace_binding is not a Workspace Binding: %v\", owner, err)\n485|\t}\n486|\tstructural, ok := checkDigest(members[\"structural_digest\"])\n487|\tif !ok {\n488|\t\treturn ReadBackManifest{}, invalid(\"%s structural_digest is not a digest\", owner)\n489|\t}\n490|\trawRows, ok := decodeArray(members[\"evidence_objects\"])\n491|\tif !ok {\n492|\t\treturn ReadBackManifest{}, invalid(\"%s evidence_objects are not an array\", owner)\n493|\t}\n494|\tif err := checkEvidenceCount(len(rawRows)); err != nil {\n495|\t\treturn ReadBackManifest{}, err\n496|\t}\n497|\trows := make([]EvidenceObject, 0, len(rawRows))\n498|\tfor index, raw := range rawRows {\n499|\t\trow, err := decodeEvidenceObject(raw, index)\n500|\t\tif err != nil {\n501|\t\t\treturn ReadBackManifest{}, err\n502|\t\t}\n503|\t\trows = append(rows, row)\n504|\t}\n505|\tif err := checkEvidenceOrder(rows); err != nil {\n506|\t\treturn ReadBackManifest{}, err\n507|\t}\n508|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n509|\t\treturn ReadBackManifest{}, invalid(\"%s extensions %s\", owner, extensionsFault)\n510|\t}\n511|\tif err := verifySelfDigest(members, readBackSelf, claimed); err != nil {\n512|\t\treturn ReadBackManifest{}, err\n513|\t}\n514|\treturn ReadBackManifest{\n515|\t\tManifestID:                  claimed,\n516|\t\tOperationID:                 operation,\n517|\t\tMode:                        mode,\n518|\t\tProjectionPlanID:            planID,\n519|\t\tProjectedObjectManifestID:   projectedID,\n520|\t\tExpectedTargetNativeSession: expected,\n521|\t\tObservedTargetNativeSession: observed,\n522|\t\tObservedEnvironment:         observedTuple,\n523|\t\tParsedEventCount:            parsedCount,\n524|\t\tParsedHeadIDs:               heads,\n525|\t\tWorkspaceBinding:            binding,\n526|\t\tStructuralDigest:            structural,\n527|\t\tEvidenceObjects:             rows,\n528|\t}, nil\n529|}","final_result":true}}}
