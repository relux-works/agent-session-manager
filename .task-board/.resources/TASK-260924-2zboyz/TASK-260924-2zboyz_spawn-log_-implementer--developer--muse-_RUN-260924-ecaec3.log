BackManifest{}, err\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\t}\\\",'\\nassert src.count(old_anchor) == 1, \\\"relabel anchor, got %d\\\" % src.count(old_anchor)\\nsrc = src.replace(old_anchor, old_anchor.replace('ReadBackManifest', 'ValidatedReadBack'))\\nold_ret = '\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\treturn ReadBackManifest{}, err\\\\\\\\\\\\\\\\n'\\nassert src.count(old_ret) == 1, \\\"relabel inner return\\\"\\nsrc = src.replace(old_ret, old_ret.replace('ReadBackManifest', 'ValidatedReadBack'))\\n\\n# 3. N-mode-auth-decode anchor\\nold_da = '\\\"anchor\\\": \\\"\\\\\\\\\\\\\\\\tif err := checkModeAuthority(owner, mode, expectedMode, authority.Purpose); err != nil {\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\treturn ReadBackManifest{}, err\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\t}\\\",'\\nassert src.count(old_da) == 1, \\\"decode-auth anchor\\\"\\nsrc = src.replace(old_da, old_da.replace('ReadBackManifest', 'ValidatedReadBack'))\\n\\nopen('mutant_harness.py', 'w').write(src)\\nprint(\\\"harness anchors updated\\\")\\nEOF\",\n  \"description\": \"Update harness usage and stale anchors\",\n  \"exit_code\": 1,\n  \"terminal_status\": \"failed\",\n  \"terminal_reason\": \"process exited with status 1\",\n  \"output\": \"Traceback (most recent call last):\\n  File \\\"<stdin>\\\", line 33, in <module>\\nAssertionError: relabel anchor, got 0\\n\",\n  \"original_output_bytes\": 112,\n  \"original_output_tokens\": 28,\n  \"truncated\": false\n}","final_result":true}}}
