{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6f9","stream":{"kind":"session","id":"01a0d4c8-c91a-7382-bd41-b29e82ff449b"},"sequence":471,"recorded_at":1780531400000937,"record_type":"event","durability":"durable","causation_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","run_stream":{"kind":"run","id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6"},"task_stream":{"kind":"task","id":"01a0d4cb-3f61-72b3-b12f-ad7ca14b8bd0"},"task_id":"01a0d4cb-3f61-72b3-b12f-ad7ca14b8bd0","event":{"kind":"output","task_id":"01a0d4cb-3f61-72b3-b12f-ad7ca14b8bd0","chunk":"Read text file `internal/clonereadback/readrefs_test.go`.\n1|package clonereadback_test\n2|\n3|import (\n4|\t\"testing\"\n5|\n6|\tclonereadback \"github.com/relux-works/agent-session-manager/internal/clonereadback\"\n7|)\n8|\n9|// This file pins that a Clone Validation Report aggregates TWO\n10|// DISTINCT reads (SPEC v0.7.0 §13.14.2 lines 10761-10762: the\n11|// staged and live read-back evidence manifest ids; lines\n12|// 10580-10582: two reads, every applicable check must pass): the\n13|// staged and live references must name the trusted sibling reads\n14|// in their own slots. The same digest in both slots, a swapped\n15|// pair, a missing reference, or a twice-named read refuses at\n16|// both entries.\n17|\n18|// TestBuildReportRefusesEqualReadRefs is the equal-references\n19|// regression at the Build entry: the same digest in both slots\n20|// refuses, and naming one read twice refuses as not distinct.\n21|func TestBuildReportRefusesEqualReadRefs(t *testing.T) {\n22|\tstaged, live := mustReadPair(t)\n23|\tsame := [][2]string{\n24|\t\t{staged.ManifestID.String(), staged.ManifestID.String()},\n25|\t\t{live.ManifestID.String(), live.ManifestID.String()},\n26|\t}\n27|\tfor _, pair := range same {\n28|\t\tinput := validReportInput(staged, live)\n29|\t\tinput.StagedReadBackEvidenceManifestID = pair[0]\n30|\t\tinput.LiveReadBackEvidenceManifestID = pair[1]\n31|\t\t_, err := clonereadback.BuildValidationReport(input, staged, live)\n32|\t\tif err == nil {\n33|\t\t\tt.Fatalf(\"Build admitted equal read refs %q\", pair)\n34|\t\t}\n35|\t\trequireRefusal(t, err, \"clone validation report\", \"does not match\")\n36|\t}\n37|\tinput := validReportInput(staged, live)\n38|\tinput.LiveReadBackEvidenceManifestID = input.StagedReadBackEvidenceManifestID\n39|\t_, err := clonereadback.BuildValidationReport(input, staged, staged)\n40|\trequireRefusal(t, err, \"clone validation report\", \"are not distinct\")\n41|}\n42|\n43|// TestDecodeReportRefusesEqualReadRefs is the equal-references\n44|// regression at the Decode entry: the same digest in both slots\n45|// refuses under a recomputed id, and naming one read twice\n46|// refuses as not distinct.\n47|func TestDecodeReportRefusesEqualReadRefs(t *testing.T) {\n48|\tstaged, live := mustReadPair(t)\n49|\tsealed := mustBuildReport(t, validReportInput(staged, live), staged, live)\n50|\tsame := [][2]string{\n51|\t\t{staged.ManifestID.String(), staged.ManifestID.String()},\n52|\t\t{live.ManifestID.String(), live.ManifestID.String()},\n53|\t}\n54|\tfor _, pair := range same {\n55|\t\tdocument := decodeDocument(t, sealed)\n56|\t\tdocument[\"staged_read_back_evidence_manifest_id\"] = pair[0]\n57|\t\tdocument[\"live_read_back_evidence_manifest_id\"] = pair[1]\n58|\t\tdocument[\"validation_report_id\"] = independentSelfDigest(t, marshalDocument(t, document), \"validation_report_id\")\n59|\t\t_, err := clonereadback.DecodeValidationReport(marshalDocument(t, document), staged, live)\n60|\t\tif err == nil {\n61|\t\t\tt.Fatalf(\"Decode admitted equal read refs %q\", pair)\n62|\t\t}\n63|\t\trequireRefusal(t, err, \"clone validation report\", \"does not match\")\n64|\t}\n65|\tdocument := decodeDocument(t, sealed)\n66|\tdocument[\"live_read_back_evidence_manifest_id\"] = document[\"staged_read_back_evidence_manifest_id\"]\n67|\tdocument[\"validation_report_id\"] = independentSelfDigest(t, marshalDocument(t, document), \"validation_report_id\")\n68|\t_, err := clonereadback.DecodeValidationReport(marshalDocument(t, document), staged, staged)\n69|\trequireRefusal(t, err, \"clone validation report\", \"are not distinct\")\n70|}\n71|\n72|// TestBuildReportRefusesSwappedReadRefs is the swapped-slots\n73|// regression at the Build entry: the live read id in the staged\n74|// slot (and vice versa) refuses.\n75|func TestBuildReportRefusesSwappedReadRefs(t *testing.T) {\n76|\tstaged, live := mustReadPair(t)\n77|\tinput := validReportInput(staged, live)\n78|\tinput.StagedReadBackEvidenceManifestID = live.ManifestID.String()\n79|\tinput.LiveReadBackEvidenceManifestID = staged.ManifestID.String()\n80|\t_, err := clonereadback.BuildValidationReport(input, staged, live)\n81|\trequireRefusal(t, err, \"clone validation report\", \"staged_read_back_evidence_manifest_id does not match the staged read\")\n82|}\n83|\n84|// TestDecodeReportRefusesSwappedReadRefs is the swapped-slots\n85|// regression at the Decode entry: the live read id in the staged\n86|// slot (and vice versa) refuses under a recomputed id.\n87|func TestDecodeReportRefusesSwappedReadRefs(t *testing.T) {\n88|\tstaged, live := mustReadPair(t)\n89|\tsealed := mustBuildReport(t, validReportInput(staged, live), staged, live)\n90|\tdocument := decodeDocument(t, sealed)\n91|\tdocument[\"staged_read_back_evidence_manifest_id\"] = live.ManifestID.String()\n92|\tdocument[\"live_read_back_evidence_manifest_id\"] = staged.ManifestID.String()\n93|\tdocument[\"validation_report_id\"] = independentSelfDigest(t, marshalDocument(t, document), \"validation_report_id\")\n94|\t_, err := clonereadback.DecodeValidationReport(marshalDocument(t, document), staged, live)\n95|\trequireRefusal(t, err, \"clone validation report\", \"staged_read_back_evidence_manifest_id does not match the staged read\")\n96|}\n97|\n98|// TestReportReadRefRelationOracle enumerates the whole reference\n99|// relation class at both report entries: claims over\n100|// {staged-id, live-id, unrelated} × {staged-id, live-id,\n101|// unrelated} admit exactly the (staged, live) cell; a missing\n102|// reference refuses; and the sibling relation (twice-named read,\n103|// swapped slots) refuses.\n104|func TestReportReadRefRelationOracle(t *testing.T) {\n105|\tstaged, live := mustReadPair(t)\n106|\tstageID := staged.ManifestID.String()\n107|\tliveID := live.ManifestID.String()\n108|\tother := fixtureDigest(\"unrelated-manifest\")\n109|\tpairs := []struct {\n110|\t\tstaged  string\n111|\t\tlive    string\n112|\t\twant    bool\n113|\t\tliteral string\n114|\t}{\n115|\t\t{stageID, liveID, true, \"\"},\n116|\t\t{stageID, stageID, false, \"does not match the live read\"},\n117|\t\t{liveID, liveID, false, \"does not match the staged read\"},\n118|\t\t{liveID, stageID, false, \"does not match the staged read\"},\n119|\t\t{stageID, other, false, \"does not match the live read\"},\n120|\t\t{other, liveID, false, \"does not match the staged read\"},\n121|\t\t{other, other, false, \"does not match the staged read\"},\n122|\t}\n123|\tchecked := 0\n124|\tsealed := mustBuildReport(t, validReportInput(staged, live), staged, live)\n125|\tfor _, pair := range pairs {\n126|\t\tinput := validReportInput(staged, live)\n127|\t\tinput.StagedReadBackEvidenceManifestID = pair.staged\n128|\t\tinput.LiveReadBackEvidenceManifestID = pair.live\n129|\t\t_, err := clonereadback.BuildValidationReport(input, staged, live)\n130|\t\tif pair.want && err != nil {\n131|\t\t\tt.Fatalf(\"claims (%s, %s) Build refused: %v\", shortDigest(pair.staged), shortDigest(pair.live), err)\n132|\t\t}\n133|\t\tif !pair.want {\n134|\t\t\trequireRefusal(t, err, \"clone validation report\", pair.literal)\n135|\t\t}\n136|\t\tdocument := decodeDocument(t, sealed)\n137|\t\tdocument[\"staged_read_back_evidence_manifest_id\"] = pair.staged\n138|\t\tdocument[\"live_read_back_evidence_manifest_id\"] = pair.live\n139|\t\tdocument[\"validation_report_id\"] = independentSelfDigest(t, marshalDocument(t, document), \"validation_report_id\")\n140|\t\t_, err = clonereadback.DecodeValidationReport(marshalDocument(t, document), staged, live)\n141|\t\tif pair.want && err != nil {\n142|\t\t\tt.Fatalf(\"claims (%s, %s) Decode refused: %v\", shortDigest(pair.staged), shortDigest(pair.live), err)\n143|\t\t}\n144|\t\tif !pair.want {\n145|\t\t\trequireRefusal(t, err, \"clone validation report\", pair.literal)\n146|\t\t}\n147|\t\tchecked++\n148|\t}\n149|\t// A missing reference refuses at Build as a malformed digest\n150|\t// and at Decode as a missing member (the census pins the\n151|\t// literal; the id staleness never reads first).\n152|\tfor _, member := range []string{\"staged_read_back_evidence_manifest_id\", \"live_read_back_evidence_manifest_id\"} {\n153|\t\tinput := validReportInput(staged, live)\n154|\t\tif member == \"staged_read_back_evidence_manifest_id\" {\n155|\t\t\tinput.StagedReadBackEvidenceManifestID = \"\"\n156|\t\t} else {\n157|\t\t\tinput.LiveReadBackEvidenceManifestID = \"\"\n158|\t\t}\n159|\t\t_, err := clonereadback.BuildValidationReport(input, staged, live)\n160|\t\trequireRefusal(t, err, \"clone validation report\", member+\" is not a digest\")\n161|\t\tdocument := decodeDocument(t, sealed)\n162|\t\tdelete(document, member)\n163|\t\t_, err = clonereadback.DecodeValidationReport(marshalDocument(t, document), staged, live)\n164|\t\trequireRefusal(t, err, \"clone validation report\", \"misses a required member \\\"\"+member+\"\\\"\")\n165|\t\tchecked++\n166|\t}\n167|\t// The sibling relation refuses at both entries: a twice-named\n168|\t// read is not two distinct reads, and siblings in swapped\n169|\t// slots fail their own slot mode.\n170|\tsiblings := []struct {\n171|\t\tlabel  string\n172|\t\tfirst  clonereadback.ReadBackManifest\n173|\t\tsecond clonereadback.ReadBackManifest\n174|\t\tclaims [2]string\n175|\t\twant   string\n176|\t}{\n177|\t\t{\"twice-staged\", staged, staged, [2]string{stageID, stageID}, \"are not distinct\"},\n178|\t\t{\"twice-live\", live, live, [2]string{liveID, liveID}, \"are not distinct\"},\n179|\t\t{\"swapped-siblings\", live, staged, [2]string{stageID, liveID}, \"staged read is not a staged manifest\"},\n180|\t}\n181|\tfor _, probe := range siblings {\n182|\t\tinput := validReportInput(staged, live)\n183|\t\tinput.StagedReadBackEvidenceManifestID = probe.claims[0]\n184|\t\tinput.LiveReadBackEvidenceManifestID = probe.claims[1]\n185|\t\t_, err := clonereadback.BuildValidationReport(input, probe.first, probe.second)\n186|\t\trequireRefusal(t, err, \"clone validation report\", probe.want)\n187|\t\tdocument := decodeDocument(t, sealed)\n188|\t\tdocument[\"staged_read_back_evidence_manifest_id\"] = probe.claims[0]\n189|\t\tdocument[\"live_read_back_evidence_manifest_id\"] = probe.claims[1]\n190|\t\tdocument[\"validation_report_id\"] = independentSelfDigest(t, marshalDocument(t, document), \"validation_report_id\")\n191|\t\t_, err = clonereadback.DecodeValidationReport(marshalDocument(t, document), probe.first, probe.second)\n192|\t\trequireRefusal(t, err, \"clone validation report\", probe.want)\n193|\t\tchecked++\n194|\t}\n195|\tt.Logf(\"read-ref relation oracle: %d cells × 2 entries driven\", checked)\n196|}\n197|\n198|// shortDigest abbreviates a digest for failure messages.\n199|func shortDigest(digest string) string {\n200|\tif len(digest) > 16 {\n201|\t\treturn digest[:16]\n202|\t}\n203|\treturn digest\n204|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6fb","stream":{"kind":"session","id":"01a0d4c8-c91a-7382-bd41-b29e82ff449b"},"sequence":472,"recorded_at":1780531400000939,"record_type":"event","durability":"durable","causation_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","run_stream":{"kind":"run","id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6"},"task_stream":{"kind":"task","id":"01a0d4cb-3f61-72b3-b12f-ad7ca14b8bd0"},"task_id":"01a0d4cb-3f61-72b3-b12f-ad7ca14b8bd0","event":{"kind":"completed","task_id":"01a0d4cb-3f61-72b3-b12f-ad7ca14b8bd0"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6fd","stream":{"kind":"session","id":"01a0d4c8-c91a-7382-bd41-b29e82ff449b"},"sequence":473,"recorded_at":1780531400000941,"record_type":"event","durability":"durable","causation_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","run_stream":{"kind":"run","id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6"},"call_id":"call_01a0d4cb39ef75408bcabf3d222a8c91","text":"Read text file `internal/clonereadback/fixtures_test.go`.\n1|package clonereadback_test\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"encoding/json\"\n7|\t\"fmt\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\n11|\tclonereadback \"github.com/relux-works/agent-session-manager/internal/clonereadback\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n13|)\n14|\n15|// This file builds the valid baseline inputs every conformance test\n16|// mutates: deterministic digests, UUIDv7 operation IDs, owner-valid\n17|// tuple/binding/finding documents, and the must-build/must-decode\n18|// seams.\n19|\n20|// fixtureDigest renders a deterministic pinned-form digest for one\n21|// seed.\n22|func fixtureDigest(seed string) string {\n23|\tsum := sha256.Sum256([]byte(\"clonereadback:\" + seed))\n24|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n25|}\n26|\n27|// fixtureOperationID renders a deterministic lowercase UUIDv7: the\n28|// time field pins the seed hash, the version nibble pins 7, and the\n29|// variant bits pin 10.\n30|func fixtureOperationID(seed string) string {\n31|\tsum := sha256.Sum256([]byte(\"clonereadback-operation:\" + seed))\n32|\thexed := hex.EncodeToString(sum[:])\n33|\ttimeField := hexed[:12]\n34|\trandA := hexed[12:15]\n35|\trandB := hexed[16:28]\n36|\treturn timeField[:8] + \"-\" + timeField[8:12] + \"-7\" + randA + \"-8\" + randB[:3] + \"-\" + randB[3:12] + hexed[28:31]\n37|}\n38|\n39|// fixtureTuple is one owner-valid Environment Tuple document.\n40|func fixtureTuple() []byte {\n41|\treturn []byte(`{\"adapter_version\":\"1.2.3\",\"architecture\":\"arm64\",\"environment_id\":\"relux.target\",\"environment_version\":\"2026.09\",\"platform\":\"macos\",\"store_schema_fingerprint\":\"` + fixtureDigest(\"store-fingerprint\") + `\"}`)\n42|}\n43|\n44|// fixtureBinding is one owner-valid Workspace Binding document.\n45|func fixtureBinding() []byte {\n46|\tfirst, second := fixtureDigest(\"remote-a\"), fixtureDigest(\"remote-b\")\n47|\tif second < first {\n48|\t\tfirst, second = second, first\n49|\t}\n50|\treturn []byte(`{\"branch\":\"main\",\"cwd_relative\":\"work/session\",\"extensions\":{},\"head_digest\":\"` + fixtureDigest(\"head\") + `\",\"index_digest\":null,\"logical_workspace_id\":\"` + fixtureOperationID(\"workspace\") + `\",\"repository_remote_fingerprints\":[\"` + first + `\",\"` + second + `\"],\"working_tree_digest\":null}`)\n51|}\n52|\n53|// fixtureFinding renders one owner-valid Adapter Finding document\n54|// with the given severity.\n55|func fixtureFinding(severity, code string) string {\n56|\treturn `{\"code\":\"` + code + `\",\"extensions\":{},\"message\":\"finding ` + code + `\",\"remediation\":null,\"severity\":\"` + severity + `\"}`\n57|}\n58|\n59|// fixtureFindings renders one owner-valid findings array over the\n60|// given severities.\n61|func fixtureFindings(severities ...string) []byte {\n62|\tvar rows []string\n63|\tfor index, severity := range severities {\n64|\t\trows = append(rows, fixtureFinding(severity, fmt.Sprintf(\"probe-%04d\", index)))\n65|\t}\n66|\treturn []byte(\"[\" + strings.Join(rows, \",\") + \"]\")\n67|}\n68|\n69|// validEvidenceInput renders one valid evidence row candidate with a\n70|// caller-chosen kind and blob seed.\n71|func validEvidenceInput(kind, seed string) clonereadback.EvidenceObjectInput {\n72|\treturn clonereadback.EvidenceObjectInput{\n73|\t\tEvidenceKind:     kind,\n74|\t\tMediaType:        \"application/octet-stream\",\n75|\t\tByteCount:        64,\n76|\t\tBlobID:           fixtureDigest(\"blob-\" + seed),\n77|\t\tBlobDescriptorID: fixtureDigest(\"descriptor-\" + seed),\n78|\t}\n79|}\n80|\n81|// validReadBackInput renders one valid read-back manifest candidate:\n82|// staged mode, two evidence rows in (kind, blob) order.\n83|func validReadBackInput() clonereadback.ReadBackManifestInput {\n84|\tsecond := validEvidenceInput(\"parser_trace\", \"trace\")\n85|\tfirst := validEvidenceInput(\"native_sample\", \"sample\")\n86|\treturn clonereadback.ReadBackManifestInput{\n87|\t\tOperationID:                 fixtureOperationID(\"read-back\"),\n88|\t\tMode:                        \"staged\",\n89|\t\tProjectionPlanID:            fixtureDigest(\"plan\"),\n90|\t\tProjectedObjectManifestID:   fixtureDigest(\"projected\"),\n91|\t\tExpectedTargetNativeSession: \"target-native-session-1\",\n92|\t\tObservedTargetNativeSession: \"target-native-session-1\",\n93|\t\tObservedEnvironment:         fixtureTuple(),\n94|\t\tParsedEventCount:            41,\n95|\t\tParsedHeadIDs:               []string{\"head-a\", \"head-b\"},\n96|\t\tWorkspaceBinding:            fixtureBinding(),\n97|\t\tStructuralDigest:            fixtureDigest(\"structural\"),\n98|\t\tEvidenceObjects:             []clonereadback.EvidenceObjectInput{first, second},\n99|\t\tExtensions:                  map[string]any{},\n100|\t}\n101|}\n102|\n103|// fixtureAuthority decodes one owner-valid ReadAuthority carrying\n104|// the given purpose through the sessadapter owner: the fixtures\n105|// thread genuinely validated authorities, never hand-built\n106|// structs, mirroring how the caller chain mints them.\n107|func fixtureAuthority(t *testing.T, purpose string) sessadapter.ReadAuthority {\n108|\tt.Helper()\n109|\traw := []byte(`{\"authority_id\":\"` + fixtureOperationID(\"authority-\"+purpose) + `\",\"purpose\":\"` + purpose + `\",\"root_handle_names\":[\"handle-a\"],\"expires_at\":\"2026-09-24T00:00:00.000Z\",\"extensions\":{}}`)\n110|\tauthority, err := sessadapter.DecodeReadAuthority(raw)\n111|\tif err != nil {\n112|\t\tt.Fatalf(\"DecodeReadAuthority(%s): %v\", purpose, err)\n113|\t}\n114|\treturn authority\n115|}\n116|\n117|// stagedAuthority renders the trusted target_staged authority every\n118|// staged read-back case threads.\n119|func stagedAuthority(t *testing.T) sessadapter.ReadAuthority {\n120|\tt.Helper()\n121|\treturn fixtureAuthority(t, \"target_staged\")\n122|}\n123|\n124|// liveAuthority renders the trusted target_live authority every\n125|// live read-back case threads.\n126|func liveAuthority(t *testing.T) sessadapter.ReadAuthority {\n127|\tt.Helper()\n128|\treturn fixtureAuthority(t, \"target_live\")\n129|}\n130|\n131|// sourceAuthority renders the trusted source_native authority the\n132|// purpose grid refuses for target read-back.\n133|func sourceAuthority(t *testing.T) sessadapter.ReadAuthority {\n134|\tt.Helper()\n135|\treturn fixtureAuthority(t, \"source_native\")\n136|}\n137|\n138|// validLiveReadBackInput renders one valid live read-back manifest\n139|// candidate: the staged baseline claimed under live.\n140|func validLiveReadBackInput() clonereadback.ReadBackManifestInput {\n141|\tinput := validReadBackInput()\n142|\tinput.Mode = \"live\"\n143|\treturn input\n144|}\n145|\n146|// validReportInput renders one valid validation report candidate:\n147|// every check true, matching IDs, one info finding, valid true,\n148|// and read references naming the two trusted sibling reads.\n149|func validReportInput(staged, live clonereadback.ReadBackManifest) clonereadback.ValidationReportInput {\n150|\treturn clonereadback.ValidationReportInput{\n151|\t\tOperationID:                      fixtureOperationID(\"report\"),\n152|\t\tProjectionPlanID:                 fixtureDigest(\"plan\"),\n153|\t\tProjectedObjectManifestID:        fixtureDigest(\"projected\"),\n154|\t\tStagedReadBackEvidenceManifestID: staged.ManifestID.String(),\n155|\t\tLiveReadBackEvidenceManifestID:   live.ManifestID.String(),\n156|\t\tTargetProviderManifestID:         fixtureDigest(\"provider\"),\n157|\t\tFidelityReportID:                 fixtureDigest(\"fidelity\"),\n158|\t\tExpectedTargetNativeSession:      \"target-native-session-1\",\n159|\t\tObservedTargetNativeSession:      \"target-native-session-1\",\n160|\t\tTargetEnvironment:                fixtureTuple(),\n161|\t\tStagedStructuralValid:            true,\n162|\t\tLiveStructuralValid:              true,\n163|\t\tSemanticMarkerValid:              true,\n164|\t\tIdentityValid:                    true,\n165|\t\tWorkspaceBindingValid:            true,\n166|\t\tResumeSurfaceValid:               true,\n167|\t\tSourceGenerationRevalidated:      true,\n168|\t\tFindings:                         fixtureFindings(\"info\"),\n169|\t\tValid:                            true,\n170|\t\tExtensions:                       map[string]any{},\n171|\t}\n172|}\n173|\n174|func mustBuildReadBack(t *testing.T, authority sessadapter.ReadAuthority, input clonereadback.ReadBackManifestInput) []byte {\n175|\tt.Helper()\n176|\tsealed, err := clonereadback.BuildReadBackEvidenceManifest(input, authority)\n177|\tif err != nil {\n178|\t\tt.Fatalf(\"BuildReadBackEvidenceManifest: %v\", err)\n179|\t}\n180|\treturn sealed\n181|}\n182|\n183|func mustDecodeReadBack(t *testing.T, authority sessadapter.ReadAuthority, sealed []byte) clonereadback.ReadBackManifest {\n184|\tt.Helper()\n185|\tmanifest, err := clonereadback.DecodeReadBackEvidenceManifest(sealed, authority)\n186|\tif err != nil {\n187|\t\tt.Fatalf(\"DecodeReadBackEvidenceManifest: %v\", err)\n188|\t}\n189|\treturn manifest\n190|}\n191|\n192|// mustReadPair seals and decodes the staged and live reads the\n193|// report cases aggregate: one operation, two stages.\n194|func mustReadPair(t *testing.T) (clonereadback.ReadBackManifest, clonereadback.ReadBackManifest) {\n195|\tt.Helper()\n196|\tstaged := mustDecodeReadBack(t, stagedAuthority(t), mustBuildReadBack(t, stagedAuthority(t), validReadBackInput()))\n197|\tlive := mustDecodeReadBack(t, liveAuthority(t), mustBuildReadBack(t, liveAuthority(t), validLiveReadBackInput()))\n198|\tif staged.ManifestID == live.ManifestID {\n199|\t\tt.Fatal(\"staged and live reads share an id: the pair is not distinct\")\n200|\t}\n201|\treturn staged, live\n202|}\n203|\n204|func mustBuildReport(t *testing.T, input clonereadback.ValidationReportInput, staged, live clonereadback.ReadBackManifest) []byte {\n205|\tt.Helper()\n206|\tsealed, err := clonereadback.BuildValidationReport(input, staged, live)\n207|\tif err != nil {\n208|\t\tt.Fatalf(\"BuildValidationReport: %v\", err)\n209|\t}\n210|\treturn sealed\n211|}\n212|\n213|func mustDecodeReport(t *testing.T, sealed []byte, staged, live clonereadback.ReadBackManifest) clonereadback.ValidationReport {\n214|\tt.Helper()\n215|\treport, err := clonereadback.DecodeValidationReport(sealed, staged, live)\n216|\tif err != nil {\n217|\t\tt.Fatalf(\"DecodeValidationReport: %v\", err)\n218|\t}\n219|\treturn report\n220|}\n221|\n222|// decodeDocument parses sealed bytes into a generic document for\n223|// member surgery.\n224|func decodeDocument(t *testing.T, sealed []byte) map[string]any {\n225|\tt.Helper()\n226|\tvar document map[string]any\n227|\tif err := json.Unmarshal(sealed, &document); err != nil {\n228|\t\tt.Fatalf(\"unmarshal sealed: %v\", err)\n229|\t}\n230|\treturn document\n231|}\n232|\n233|// marshalDocument renders a surgered document back to bytes.\n234|func marshalDocument(t *testing.T, document map[string]any) []byte {\n235|\tt.Helper()\n236|\trendered, err := json.Marshal(document)\n237|\tif err != nil {\n238|\t\tt.Fatalf(\"marshal document: %v\", err)\n239|\t}\n240|\treturn rendered\n241|}\n242|\n243|// documentAt navigates a nested object member for row-level census\n244|// probes.\n245|func documentAt(t *testing.T, document map[string]any, member string, index int) map[string]any {\n246|\tt.Helper()\n247|\trows, ok := document[member].([]any)\n248|\tif !ok {\n249|\t\tt.Fatalf(\"member %s is not an array\", member)\n250|\t}\n251|\trow, ok := rows[index].(map[string]any)\n252|\tif !ok {\n253|\t\tt.Fatalf(\"member %s[%d] is not an object\", member, index)\n254|\t}\n255|\treturn row\n256|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6ff","stream":{"kind":"session","id":"01a0d4c8-c91a-7382-bd41-b29e82ff449b"},"sequence":474,"recorded_at":1780531400000943,"record_type":"event","durability":"durable","causation_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","run_stream":{"kind":"run","id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6"},"call_id":"call_01a0d4cb3bfa731b9249caeda4128269","text":"Read text file `internal/clonereadback/readrefs_test.go`.\n1|package clonereadback_test\n2|\n3|import (\n4|\t\"testing\"\n5|\n6|\tclonereadback \"github.com/relux-works/agent-session-manager/internal/clonereadback\"\n7|)\n8|\n9|// This file pins that a Clone Validation Report aggregates TWO\n10|// DISTINCT reads (SPEC v0.7.0 §13.14.2 lines 10761-10762: the\n11|// staged and live read-back evidence manifest ids; lines\n12|// 10580-10582: two reads, every applicable check must pass): the\n13|// staged and live references must name the trusted sibling reads\n14|// in their own slots. The same digest in both slots, a swapped\n15|// pair, a missing reference, or a twice-named read refuses at\n16|// both entries.\n17|\n18|// TestBuildReportRefusesEqualReadRefs is the equal-references\n19|// regression at the Build entry: the same digest in both slots\n20|// refuses, and naming one read twice refuses as not distinct.\n21|func TestBuildReportRefusesEqualReadRefs(t *testing.T) {\n22|\tstaged, live := mustReadPair(t)\n23|\tsame := [][2]string{\n24|\t\t{staged.ManifestID.String(), staged.ManifestID.String()},\n25|\t\t{live.ManifestID.String(), live.ManifestID.String()},\n26|\t}\n27|\tfor _, pair := range same {\n28|\t\tinput := validReportInput(staged, live)\n29|\t\tinput.StagedReadBackEvidenceManifestID = pair[0]\n30|\t\tinput.LiveReadBackEvidenceManifestID = pair[1]\n31|\t\t_, err := clonereadback.BuildValidationReport(input, staged, live)\n32|\t\tif err == nil {\n33|\t\t\tt.Fatalf(\"Build admitted equal read refs %q\", pair)\n34|\t\t}\n35|\t\trequireRefusal(t, err, \"clone validation report\", \"does not match\")\n36|\t}\n37|\tinput := validReportInput(staged, live)\n38|\tinput.LiveReadBackEvidenceManifestID = input.StagedReadBackEvidenceManifestID\n39|\t_, err := clonereadback.BuildValidationReport(input, staged, staged)\n40|\trequireRefusal(t, err, \"clone validation report\", \"are not distinct\")\n41|}\n42|\n43|// TestDecodeReportRefusesEqualReadRefs is the equal-references\n44|// regression at the Decode entry: the same digest in both slots\n45|// refuses under a recomputed id, and naming one read twice\n46|// refuses as not distinct.\n47|func TestDecodeReportRefusesEqualReadRefs(t *testing.T) {\n48|\tstaged, live := mustReadPair(t)\n49|\tsealed := mustBuildReport(t, validReportInput(staged, live), staged, live)\n50|\tsame := [][2]string{\n51|\t\t{staged.ManifestID.String(), staged.ManifestID.String()},\n52|\t\t{live.ManifestID.String(), live.ManifestID.String()},\n53|\t}\n54|\tfor _, pair := range same {\n55|\t\tdocument := decodeDocument(t, sealed)\n56|\t\tdocument[\"staged_read_back_evidence_manifest_id\"] = pair[0]\n57|\t\tdocument[\"live_read_back_evidence_manifest_id\"] = pair[1]\n58|\t\tdocument[\"validation_report_id\"] = independentSelfDigest(t, marshalDocument(t, document), \"validation_report_id\")\n59|\t\t_, err := clonereadback.DecodeValidationReport(marshalDocument(t, document), staged, live)\n60|\t\tif err == nil {\n61|\t\t\tt.Fatalf(\"Decode admitted equal read refs %q\", pair)\n62|\t\t}\n63|\t\trequireRefusal(t, err, \"clone validation report\", \"does not match\")\n64|\t}\n65|\tdocument := decodeDocument(t, sealed)\n66|\tdocument[\"live_read_back_evidence_manifest_id\"] = document[\"staged_read_back_evidence_manifest_id\"]\n67|\tdocument[\"validation_report_id\"] = independentSelfDigest(t, marshalDocument(t, document), \"validation_report_id\")\n68|\t_, err := clonereadback.DecodeValidationReport(marshalDocument(t, document), staged, staged)\n69|\trequireRefusal(t, err, \"clone validation report\", \"are not distinct\")\n70|}\n71|\n72|// TestBuildReportRefusesSwappedReadRefs is the swapped-slots\n73|// regression at the Build entry: the live read id in the staged\n74|// slot (and vice versa) refuses.\n75|func TestBuildReportRefusesSwappedReadRefs(t *testing.T) {\n76|\tstaged, live := mustReadPair(t)\n77|\tinput := validReportInput(staged, live)\n78|\tinput.StagedReadBackEvidenceManifestID = live.ManifestID.String()\n79|\tinput.LiveReadBackEvidenceManifestID = staged.ManifestID.String()\n80|\t_, err := clonereadback.BuildValidationReport(input, staged, live)\n81|\trequireRefusal(t, err, \"clone validation report\", \"staged_read_back_evidence_manifest_id does not match the staged read\")\n82|}\n83|\n84|// TestDecodeReportRefusesSwappedReadRefs is the swapped-slots\n85|// regression at the Decode entry: the live read id in the staged\n86|// slot (and vice versa) refuses under a recomputed id.\n87|func TestDecodeReportRefusesSwappedReadRefs(t *testing.T) {\n88|\tstaged, live := mustReadPair(t)\n89|\tsealed := mustBuildReport(t, validReportInput(staged, live), staged, live)\n90|\tdocument := decodeDocument(t, sealed)\n91|\tdocument[\"staged_read_back_evidence_manifest_id\"] = live.ManifestID.String()\n92|\tdocument[\"live_read_back_evidence_manifest_id\"] = staged.ManifestID.String()\n93|\tdocument[\"validation_report_id\"] = independentSelfDigest(t, marshalDocument(t, document), \"validation_report_id\")\n94|\t_, err := clonereadback.DecodeValidationReport(marshalDocument(t, document), staged, live)\n95|\trequireRefusal(t, err, \"clone validation report\", \"staged_read_back_evidence_manifest_id does not match the staged read\")\n96|}\n97|\n98|// TestReportReadRefRelationOracle enumerates the whole reference\n99|// relation class at both report entries: claims over\n100|// {staged-id, live-id, unrelated} × {staged-id, live-id,\n101|// unrelated} admit exactly the (staged, live) cell; a missing\n102|// reference refuses; and the sibling relation (twice-named read,\n103|// swapped slots) refuses.\n104|func TestReportReadRefRelationOracle(t *testing.T) {\n105|\tstaged, live := mustReadPair(t)\n106|\tstageID := staged.ManifestID.String()\n107|\tliveID := live.ManifestID.String()\n108|\tother := fixtureDigest(\"unrelated-manifest\")\n109|\tpairs := []struct {\n110|\t\tstaged  string\n111|\t\tlive    string\n112|\t\twant    bool\n113|\t\tliteral string\n114|\t}{\n115|\t\t{stageID, liveID, true, \"\"},\n116|\t\t{stageID, stageID, false, \"does not match the live read\"},\n117|\t\t{liveID, liveID, false, \"does not match the staged read\"},\n118|\t\t{liveID, stageID, false, \"does not match the staged read\"},\n119|\t\t{stageID, other, false, \"does not match the live read\"},\n120|\t\t{other, liveID, false, \"does not match the staged read\"},\n121|\t\t{other, other, false, \"does not match the staged read\"},\n122|\t}\n123|\tchecked := 0\n124|\tsealed := mustBuildReport(t, validReportInput(staged, live), staged, live)\n125|\tfor _, pair := range pairs {\n126|\t\tinput := validReportInput(staged, live)\n127|\t\tinput.StagedReadBackEvidenceManifestID = pair.staged\n128|\t\tinput.LiveReadBackEvidenceManifestID = pair.live\n129|\t\t_, err := clonereadback.BuildValidationReport(input, staged, live)\n130|\t\tif pair.want && err != nil {\n131|\t\t\tt.Fatalf(\"claims (%s, %s) Build refused: %v\", shortDigest(pair.staged), shortDigest(pair.live), err)\n132|\t\t}\n133|\t\tif !pair.want {\n134|\t\t\trequireRefusal(t, err, \"clone validation report\", pair.literal)\n135|\t\t}\n136|\t\tdocument := decodeDocument(t, sealed)\n137|\t\tdocument[\"staged_read_back_evidence_manifest_id\"] = pair.staged\n138|\t\tdocument[\"live_read_back_evidence_manifest_id\"] = pair.live\n139|\t\tdocument[\"validation_report_id\"] = independentSelfDigest(t, marshalDocument(t, document), \"validation_report_id\")\n140|\t\t_, err = clonereadback.DecodeValidationReport(marshalDocument(t, document), staged, live)\n141|\t\tif pair.want && err != nil {\n142|\t\t\tt.Fatalf(\"claims (%s, %s) Decode refused: %v\", shortDigest(pair.staged), shortDigest(pair.live), err)\n143|\t\t}\n144|\t\tif !pair.want {\n145|\t\t\trequireRefusal(t, err, \"clone validation report\", pair.literal)\n146|\t\t}\n147|\t\tchecked++\n148|\t}\n149|\t// A missing reference refuses at Build as a malformed digest\n150|\t// and at Decode as a missing member (the census pins the\n151|\t// literal; the id staleness never reads first).\n152|\tfor _, member := range []string{\"staged_read_back_evidence_manifest_id\", \"live_read_back_evidence_manifest_id\"} {\n153|\t\tinput := validReportInput(staged, live)\n154|\t\tif member == \"staged_read_back_evidence_manifest_id\" {\n155|\t\t\tinput.StagedReadBackEvidenceManifestID = \"\"\n156|\t\t} else {\n157|\t\t\tinput.LiveReadBackEvidenceManifestID = \"\"\n158|\t\t}\n159|\t\t_, err := clonereadback.BuildValidationReport(input, staged, live)\n160|\t\trequireRefusal(t, err, \"clone validation report\", member+\" is not a digest\")\n161|\t\tdocument := decodeDocument(t, sealed)\n162|\t\tdelete(document, member)\n163|\t\t_, err = clonereadback.DecodeValidationReport(marshalDocument(t, document), staged, live)\n164|\t\trequireRefusal(t, err, \"clone validation report\", \"misses a required member \\\"\"+member+\"\\\"\")\n165|\t\tchecked++\n166|\t}\n167|\t// The sibling relation refuses at both entries: a twice-named\n168|\t// read is not two distinct reads, and siblings in swapped\n169|\t// slots fail their own slot mode.\n170|\tsiblings := []struct {\n171|\t\tlabel  string\n172|\t\tfirst  clonereadback.ReadBackManifest\n173|\t\tsecond clonereadback.ReadBackManifest\n174|\t\tclaims [2]string\n175|\t\twant   string\n176|\t}{\n177|\t\t{\"twice-staged\", staged, staged, [2]string{stageID, stageID}, \"are not distinct\"},\n178|\t\t{\"twice-live\", live, live, [2]string{liveID, liveID}, \"are not distinct\"},\n179|\t\t{\"swapped-siblings\", live, staged, [2]string{stageID, liveID}, \"staged read is not a staged manifest\"},\n180|\t}\n181|\tfor _, probe := range siblings {\n182|\t\tinput := validReportInput(staged, live)\n183|\t\tinput.StagedReadBackEvidenceManifestID = probe.claims[0]\n184|\t\tinput.LiveReadBackEvidenceManifestID = probe.claims[1]\n185|\t\t_, err := clonereadback.BuildValidationReport(input, probe.first, probe.second)\n186|\t\trequireRefusal(t, err, \"clone validation report\", probe.want)\n187|\t\tdocument := decodeDocument(t, sealed)\n188|\t\tdocument[\"staged_read_back_evidence_manifest_id\"] = probe.claims[0]\n189|\t\tdocument[\"live_read_back_evidence_manifest_id\"] = probe.claims[1]\n190|\t\tdocument[\"validation_report_id\"] = independentSelfDigest(t, marshalDocument(t, document), \"validation_report_id\")\n191|\t\t_, err = clonereadback.DecodeValidationReport(marshalDocument(t, document), probe.first, probe.second)\n192|\t\trequireRefusal(t, err, \"clone validation report\", probe.want)\n193|\t\tchecked++\n194|\t}\n195|\tt.Logf(\"read-ref relation oracle: %d cells × 2 entries driven\", checked)\n196|}\n197|\n198|// shortDigest abbreviates a digest for failure messages.\n199|func shortDigest(digest string) string {\n200|\tif len(digest) > 16 {\n201|\t\treturn digest[:16]\n202|\t}\n203|\treturn digest\n204|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
