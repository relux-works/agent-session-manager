odeAuthorityGrid(t *testing.T) {\n29|\tpurposes := []struct {\n30|\t\tname   string\n31|\t\texpect string // \"\" refuses every claim\n32|\t}{\n33|\t\t{\"target_staged\", \"staged\"},\n34|\t\t{\"target_live\", \"live\"},\n35|\t\t{\"source_native\", \"\"},\n36|\t}\n37|\tchecked := 0\n38|\tfor _, purpose := range purposes {\n39|\t\tauthority := fixtureAuthority(t, purpose.name)\n40|\t\tfor _, mode := range []string{\"staged\", \"live\"} {\n41|\t\t\twant := purpose.expect == mode\n42|\t\t\tinput := validReadBackInput()\n43|\t\t\tinput.Mode = mode\n44|\t\t\t_, err := clonereadback.BuildReadBackEvidenceManifest(input, authority)\n45|\t\t\tif want && err != nil {\n46|\t\t\t\tt.Fatalf(\"purpose=%s mode=%s Build refused: %v\", purpose.name, mode, err)\n47|\t\t\t}\n48|\t\t\tif !want {\n49|\t\t\t\tif err == nil {\n50|\t\t\t\t\tt.Fatalf(\"purpose=%s mode=%s Build admitted\", purpose.name, mode)\n51|\t\t\t\t}\n52|\t\t\t\twantLiteral := \"disagrees with read authority purpose\"\n53|\t\t\t\tif purpose.expect == \"\" {\n54|\t\t\t\t\twantLiteral = \"grants no target read-back\"\n55|\t\t\t\t}\n56|\t\t\t\trequireRefusal(t, err, \"read-back evidence manifest\", wantLiteral)\n57|\t\t\t}\n58|\t\t\tsealed := sealMode(t, mode)\n59|\t\t\tif got := independentSelfDigest(t, sealed, \"read_back_evidence_manifest_id\"); got != decodeDocument(t, sealed)[\"read_back_evidence_manifest_id\"] {\n60|\t\t\t\tt.Fatalf(\"purpose=%s mode=%s: sealed id does not recompute\", purpose.name, mode)\n61|\t\t\t}\n62|\t\t\tmanifest, err := clonereadback.DecodeReadBackEvidenceManifest(sealed, authority)\n63|\t\t\tif want && err != nil {\n64|\t\t\t\tt.Fatalf(\"purpose=%s mode=%s Decode refused: %v\", purpose.name, mode, err)\n65|\t\t\t}\n66|\t\t\tif want && manifest.Mode != mode {\n67|\t\t\t\tt.Fatalf(\"purpose=%s mode=%s decoded as %q\", purpose.name, mode, manifest.Mode)\n68|\t\t\t}\n69|\t\t\tif !want {\n70|\t\t\t\tif err == nil {\n71|\t\t\t\t\tt.Fatalf(\"purpose=%s mode=%s Decode admitted\", purpose.name, mode)\n72|\t\t\t\t}\n73|\t\t\t\twantLiteral := \"disagrees with read authority purpose\"\n74|\t\t\t\tif purpose.expect == \"\" {\n75|\t\t\t\t\twantLiteral = \"grants no target read-back\"\n76|\t\t\t\t}\n77|\t\t\t\trequireRefusal(t, err, \"read-back evidence manifest\", wantLiteral)\n78|\t\t\t}\n79|\t\t\tchecked++\n80|\t\t}\n81|\t}\n82|\t// An authority purpose outside the closed vocabulary refuses at\n83|\t// both entries even though no owner decoder runs here: the\n84|\t// mapping is total.\n85|\tbogus := sessadapter.ReadAuthority{AuthorityID: \"0193a5b7-4c2d-7e1f-8a3b-5c6d7e8f9012\", Purpose: \"target_archive\"}\n86|\tfor _, mode := range []string{\"staged\", \"live\"} {\n87|\t\tinput := validReadBackInput()\n88|\t\tinput.Mode = mode\n89|\t\t_, err := clonereadback.BuildReadBackEvidenceManifest(input, bogus)\n90|\t\trequireRefusal(t, err, \"read-back evidence manifest\", \"is outside source_native|target_staged|target_live\")\n91|\t\t_, err = clonereadback.DecodeReadBackEvidenceManifest(sealMode(t, mode), bogus)\n92|\t\trequireRefusal(t, err, \"read-back evidence manifest\", \"is outside source_native|target_staged|target_live\")\n93|\t\tchecked++\n94|\t}\n95|\tt.Logf(\"mode-authority grid: %d purpose/mode cells × 2 entries driven\", checked)\n96|}\n97|\n98|// sealMode seals one valid manifest claiming the given mode under\n99|// its matching authority.\n100|func sealMode(t *testing.T, mode string) []byte {\n101|\tt.Helper()\n102|\tauthority := stagedAuthority(t)\n103|\tif mode == \"live\" {\n104|\t\tauthority = liveAuthority(t)\n105|\t}\n106|\tinput := validReadBackInput()\n107|\tinput.Mode = mode\n108|\treturn mustBuildReadBack(t, authority, input)\n109|}\n110|\n111|// TestBuildStagedAuthorityRefusesLiveClaim is the staged→live\n112|// regression at the Build entry: a live claim under the staged\n113|// authority refuses as a relabel, never seals.\n114|func TestBuildStagedAuthorityRefusesLiveClaim(t *testing.T) {\n115|\tinput := validReadBackInput()\n116|\tinput.Mode = \"live\"\n117|\t_, err := clonereadback.BuildReadBackEvidenceManifest(input, stagedAuthority(t))\n118|\trequireRefusal(t, err, \"read-back evidence manifest\", `mode \"live\" disagrees with read authority purpose \"target_staged\"`)\n119|}\n120|\n121|// TestBuildLiveAuthorityRefusesStagedClaim is the live→staged\n122|// regression at the Build entry: a staged claim under the live\n123|// authority refuses as a relabel, never seals.\n124|func TestBuildLiveAuthorityRefusesStagedClaim(t *testing.T) {\n125|\tinput := validReadBackInput()\n126|\tinput.Mode = \"staged\"\n127|\t_, err := clonereadback.BuildReadBackEvidenceManifest(input, liveAuthority(t))\n128|\trequireRefusal(t, err, \"read-back evidence manifest\", `mode \"staged\" disagrees with read authority purpose \"target_live\"`)\n129|}\n130|\n131|// TestDecodeStagedAuthorityRefusesResealedLiveClaim is the\n132|// staged→live regression at the Decode entry: staged evidence\n133|// resealed with mode=live under a recomputed id refuses under the\n134|// staged authority even though the self-digest recomputes.\n135|func TestDecodeStagedAuthorityRefusesResealedLiveClaim(t *testing.T) {\n136|\tsealed := sealMode(t, \"staged\")\n137|\tdocument := decodeDocument(t, sealed)\n138|\tdocument[\"mode\"] = \"live\"\n139|\tdocument[\"read_back_evidence_manifest_id\"] = independentSelfDigest(t, marshalDocument(t, document), \"read_back_evidence_manifest_id\")\n140|\tresealed := marshalDocument(t, document)\n141|\tif got := independentSelfDigest(t, resealed, \"read_back_evidence_manifest_id\"); got != decodeDocument(t, resealed)[\"read_back_evidence_manifest_id\"] {\n142|\t\tt.Fatal(\"resealed id does not recompute: the probe is not a reseal\")\n143|\t}\n144|\t_, err := clonereadback.DecodeReadBackEvidenceManifest(resealed, stagedAuthority(t))\n145|\trequireRefusal(t, err, \"read-back evidence manifest\", `mode \"live\" disagrees with read authority purpose \"target_staged\"`)\n146|}\n147|\n148|// TestDecodeLiveAuthorityRefusesResealedStagedClaim is the\n149|// live→staged regression at the Decode entry: live evidence\n150|// resealed with mode=staged under a recomputed id refuses under\n151|// the live authority even though the self-digest recomputes.\n152|func TestDecodeLiveAuthorityRefusesResealedStagedClaim(t *testing.T) {\n153|\tsealed := sealMode(t, \"live\")\n154|\tdocument := decodeDocument(t, sealed)\n155|\tdocument[\"mode\"] = \"staged\"\n156|\tdocument[\"read_back_evidence_manifest_id\"] = independentSelfDigest(t, marshalDocument(t, document), \"read_back_evidence_manifest_id\")\n157|\tresealed := marshalDocument(t, document)\n158|\tif got := independentSelfDigest(t, resealed, \"read_back_evidence_manifest_id\"); got != decodeDocument(t, resealed)[\"read_back_evidence_manifest_id\"] {\n159|\t\tt.Fatal(\"resealed id does not recompute: the probe is not a reseal\")\n160|\t}\n161|\t_, err := clonereadback.DecodeReadBackEvidenceManifest(resealed, liveAuthority(t))\n162|\trequireRefusal(t, err, \"read-back evidence manifest\", `mode \"staged\" disagrees with read authority purpose \"target_live\"`)\n163|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7f9","stream":{"kind":"session","id":"01a0d4c8-c91a-7382-bd41-b29e82ff449b"},"sequence":599,"recorded_at":1780531400001193,"record_type":"event","durability":"durable","causation_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","run_stream":{"kind":"run","id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6"},"call_id":"call_01a0d4cbb75572a1b394df60d7d50af3","text":"Read text file `internal/clonereadback/structural_test.go`.\n1|package clonereadback_test\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|)\n13|\n14|// This file pins the no-second-implementation shape structurally:\n15|// production files name no owner-inner members and no\n16|// fidelity/plan vocabulary, and call no fidelity/plan predicate.\n17|// Any literal below appearing in production code is a forked rule.\n18|// Control plants (a re-added owner literal, a re-added vocabulary\n19|// call) redden this test; logs ride the evidence tar.\n20|\n21|// forkedLiterals lists owner-inner member names and owner\n22|// vocabulary tokens that must never appear as string literals in\n23|// production files. The package's own members (mode, evidence\n24|// kinds, tuple/binding/findings CONTAINER members) are excluded:\n25|// only the INNER names the owners gate are fork signals.\n26|var forkedLiterals = []string{\n27|\t// Environment Tuple inner members (sessadapter.DecodeTuple).\n28|\t\"environment_id\", \"environment_version\", \"store_schema_fingerprint\", \"adapter_version\",\n29|\t// Workspace Binding inner members\n30|\t// (clonebundle.DecodeWorkspaceBinding).\n31|\t\"logical_workspace_id\", \"cwd_relative\", \"repository_remote_fingerprints\",\n32|\t\"head_digest\", \"index_digest\", \"working_tree_digest\",\n33|\t// Adapter Finding inner members (sessadapter.DecodeFinding):\n34|\t// severity VALUES info|warning are decided only through the\n35|\t// decoded struct field, never matched as raw members.\n36|\t\"remediation\",\n37|\t// Fidelity disposition vocabulary (clonefidelity).\n38|\t\"exact\", \"semantic\", \"summarized\", \"opaque_preserved\", \"synthesized\", \"omitted\", \"unrecoverable\",\n39|\t// Fidelity reason vocabulary sample (clonefidelity): core\n40|\t// codes plus the extension grammar marker.\n41|\t\"target_no_equivalent\", \"source_not_persisted\", \"derived_index_rebuilt\",\n42|\t// Projection Plan vocabulary (cloneplan).\n43|\t\"same_environment_native_rewrite\", \"target_native_writer\", \"target_official_import\",\n44|\t\"continuation_context\", \"strict_exact\", \"maximal_safe\", \"compact\", \"messages_only\",\n45|\t\"create_directory\", \"write_blob\", \"write_native_record\", \"rebuild_index\",\n46|}\n47|\n48|// forkedSelectors lists owner predicates that must never be called\n49|// from production files.\n50|var forkedSelectors = []string{\n51|\t\"ValidDisposition\", \"ValidReasonCode\", \"IsCoreReasonCode\",\n52|\t\"ValidateDispositionRow\", \"BuildFidelityReport\", \"DecodeFidelityReport\",\n53|\t\"ValidPlanStrategy\", \"ValidPlanProfile\", \"ValidOperationAction\",\n54|\t\"ValidSynthesizedPurpose\", \"ValidResourceKind\",\n55|\t\"BuildProjectionPlan\", \"DecodeProjectionPlan\",\n56|\t\"BuildProjectedObjectManifest\", \"DecodeProjectedObjectManifest\",\n57|}\n58|\n59|// TestNoForkedLiterals pins that no production file carries an\n60|// owner-inner member literal or an owner vocabulary literal.\n61|func TestNoForkedLiterals(t *testing.T) {\n62|\tdir := packageDir(t)\n63|\tfiles, err := filepath.Glob(filepath.Join(dir, \"*.go\"))\n64|\tif err != nil {\n65|\t\tt.Fatalf(\"glob: %v\", err)\n66|\t}\n67|\tfor _, path := range files {\n68|\t\tif strings.HasSuffix(path, \"_test.go\") {\n69|\t\t\tcontinue\n70|\t\t}\n71|\t\tsource, err := os.ReadFile(path)\n72|\t\tif err != nil {\n73|\t\t\tt.Fatalf(\"read %s: %v\", path, err)\n74|\t\t}\n75|\t\tfset := token.NewFileSet()\n76|\t\tparsed, err := parser.ParseFile(fset, path, source, 0)\n77|\t\tif err != nil {\n78|\t\t\tt.Fatalf(\"parse %s: %v\", path, err)\n79|\t\t}\n80|\t\tast.Inspect(parsed, func(node ast.Node) bool {\n81|\t\t\tliteral, ok := node.(*ast.BasicLit)\n82|\t\t\tif !ok || literal.Kind != token.STRING {\n83|\t\t\t\treturn true\n84|\t\t\t}\n85|\t\t\tvalue, err := strconv.Unquote(literal.Value)\n86|\t\t\tif err != nil {\n87|\t\t\t\treturn true\n88|\t\t\t}\n89|\t\t\tfor _, forked := range forkedLiterals {\n90|\t\t\t\tif value == forked {\n91|\t\t\t\t\tt.Errorf(\"%s carries forked literal %q: the rule belongs to its owner\", path, forked)\n92|\t\t\t\t}\n93|\t\t\t}\n94|\t\t\treturn true\n95|\t\t})\n96|\t}\n97|}\n98|\n99|// TestNoForkedSelectors pins that no production file calls a\n100|// fidelity or plan owner predicate: with no row-shaped data, any\n101|// call would validate a re-implemented copy.\n102|func TestNoForkedSelectors(t *testing.T) {\n103|\tdir := packageDir(t)\n104|\tfiles, err := filepath.Glob(filepath.Join(dir, \"*.go\"))\n105|\tif err != nil {\n106|\t\tt.Fatalf(\"glob: %v\", err)\n107|\t}\n108|\tfor _, path := range files {\n109|\t\tif strings.HasSuffix(path, \"_test.go\") {\n110|\t\t\tcontinue\n111|\t\t}\n112|\t\tsource, err := os.ReadFile(path)\n113|\t\tif err != nil {\n114|\t\t\tt.Fatalf(\"read %s: %v\", path, err)\n115|\t\t}\n116|\t\tfset := token.NewFileSet()\n117|\t\tparsed, err := parser.ParseFile(fset, path, source, 0)\n118|\t\tif err != nil {\n119|\t\t\tt.Fatalf(\"parse %s: %v\", path, err)\n120|\t\t}\n121|\t\tast.Inspect(parsed, func(node ast.Node) bool {\n122|\t\t\tcall, ok := node.(*ast.CallExpr)\n123|\t\t\tif !ok {\n124|\t\t\t\treturn true\n125|\t\t\t}\n126|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n127|\t\t\tif !ok {\n128|\t\t\t\treturn true\n129|\t\t\t}\n130|\t\t\tfor _, forked := range forkedSelectors {\n131|\t\t\t\tif selector.Sel.Name == forked {\n132|\t\t\t\t\tt.Errorf(\"%s calls forked selector %s: the rule belongs to its owner\", path, forked)\n133|\t\t\t\t}\n134|\t\t\t}\n135|\t\t\treturn true\n136|\t\t})\n137|\t}\n138|}\n139|\n140|// TestErrorSeverityDecidedOnDecodedField pins that the no-error\n141|// finding rule reads the owner-decoded Finding struct field —\n142|// finding.Severity — exactly once, inside the shared decider:\n143|// never a raw member lookup, never a second matcher. A second\n144|// matcher would be a forked severity rule.\n145|func TestErrorSeverityDecidedOnDecodedField(t *testing.T) {\n146|\tdir := packageDir(t)\n147|\tsource, err := os.ReadFile(filepath.Join(dir, \"report.go\"))\n148|\tif err != nil {\n149|\t\tt.Fatalf(\"read report.go: %v\", err)\n150|\t}\n151|\tfset := token.NewFileSet()\n152|\tparsed, err := parser.ParseFile(fset, \"report.go\", source, 0)\n153|\tif err != nil {\n154|\t\tt.Fatalf(\"parse report.go: %v\", err)\n155|\t}\n156|\tcountSeverity := func(fn *ast.FuncDecl) int {\n157|\t\tmatches := 0\n158|\t\tif fn.Body == nil {\n159|\t\t\treturn 0\n160|\t\t}\n161|\t\tast.Inspect(fn.Body, func(node ast.Node) bool {\n162|\t\t\tbinary, ok := node.(*ast.BinaryExpr)\n163|\t\t\tif !ok {\n164|\t\t\t\treturn true\n165|\t\t\t}\n166|\t\t\tif isSeverityOperand(binary.X) || isSeverityOperand(binary.Y) {\n167|\t\t\t\tmatches++\n168|\t\t\t}\n169|\t\t\treturn true\n170|\t\t})\n171|\t\treturn matches\n172|\t}\n173|\tdeciderMatches := 0\n174|\totherMatches := 0\n175|\tfor _, decl := range parsed.Decls {\n176|\t\tfn, ok := decl.(*ast.FuncDecl)\n177|\t\tif !ok {\n178|\t\t\tcontinue\n179|\t\t}\n180|\t\tif fn.Name.Name == \"decideValid\" {\n181|\t\t\tdeciderMatches += countSeverity(fn)\n182|\t\t} else {\n183|\t\t\totherMatches += countSeverity(fn)\n184|\t\t}\n185|\t}\n186|\tif deciderMatches != 1 {\n187|\t\tt.Errorf(\"Severity matched %d times inside decideValid, want exactly 1\", deciderMatches)\n188|\t}\n189|\tif otherMatches != 0 {\n190|\t\tt.Errorf(\"Severity matched %d times outside decideValid: a second severity rule is a fork\", otherMatches)\n191|\t}\n192|}\n193|\n194|// isSeverityOperand reports whether one binary operand reads a\n195|// Severity struct field.\n196|func isSeverityOperand(expr ast.Expr) bool {\n197|\tselector, ok := expr.(*ast.SelectorExpr)\n198|\treturn ok && selector.Sel.Name == \"Severity\"\n199|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
