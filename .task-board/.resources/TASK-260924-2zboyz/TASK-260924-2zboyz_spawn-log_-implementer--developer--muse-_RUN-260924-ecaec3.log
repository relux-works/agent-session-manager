{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c851","stream":{"kind":"session","id":"01a0d4c8-c91a-7382-bd41-b29e82ff449b"},"sequence":643,"recorded_at":1780531400001281,"record_type":"event","durability":"durable","causation_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","run_stream":{"kind":"run","id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6"},"task_stream":{"kind":"task","id":"01a0d4cb-e2e5-71a1-a9f6-57bd49cca7fe"},"task_id":"01a0d4cb-e2e5-71a1-a9f6-57bd49cca7fe","event":{"kind":"output","task_id":"01a0d4cb-e2e5-71a1-a9f6-57bd49cca7fe","chunk":"Read text file `internal/clonereadback/oracle_test.go`.\n1|package clonereadback_test\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|\n7|\tclonereadback \"github.com/relux-works/agent-session-manager/internal/clonereadback\"\n8|)\n9|\n10|// This file proves the semantic gates by whole-domain oracles\n11|// written from the pinned text, never from the implementation: the\n12|// valid rule over every combination of check outcomes, the mode\n13|// vocabulary over its closed set and neighbors, and the native-ID\n14|// equality over equal/unequal pairs.\n15|\n16|// oracleChecks renders the seven check booleans for one combination\n17|// index: bit 0 is staged structural, 1 live structural, 2 semantic\n18|// marker, 3 identity, 4 workspace binding, 5 resume surface, 6\n19|// source generation. Every check is always applicable in this\n20|// schema — the report carries no nullable checks — so the oracle\n21|// enumerates outcomes with applicability fixed, and the wrong-type\n22|// census pins that a null check is a wrong type, never an\n23|// inapplicable one.\n24|func oracleChecks(staged, live clonereadback.ReadBackManifest, combo int) (clonereadback.ValidationReportInput, bool) {\n25|\tinput := validReportInput(staged, live)\n26|\tinput.StagedStructuralValid = combo&1 != 0\n27|\tinput.LiveStructuralValid = combo&2 != 0\n28|\tinput.SemanticMarkerValid = combo&4 != 0\n29|\tinput.IdentityValid = combo&8 != 0\n30|\tinput.WorkspaceBindingValid = combo&16 != 0\n31|\tinput.ResumeSurfaceValid = combo&32 != 0\n32|\tinput.SourceGenerationRevalidated = combo&64 != 0\n33|\treturn input, combo == 127\n34|}\n35|\n36|// TestValidWholeDomainOracle enumerates every combination of the\n37|// seven check outcomes (128) by native-ID equality (2) by finding\n38|// class (none, info, warning, error: 4): 1024 combinations. At the\n39|// production Build entry the decided valid bit seals and the\n40|// flipped bit refuses; at the production Decode entry the sealed\n41|// document decodes and the flipped-bit document (under a\n42|// recomputed independent id) refuses.\n43|func TestValidWholeDomainOracle(t *testing.T) {\n44|\tstaged, live := mustReadPair(t)\n45|\tfindingClasses := [][]string{nil, {\"info\"}, {\"warning\"}, {\"info\", \"warning\"}, {\"error\"}, {\"info\", \"error\"}}\n46|\tchecked := 0\n47|\tfor combo := 0; combo < 128; combo++ {\n48|\t\tfor _, idsEqual := range []bool{true, false} {\n49|\t\t\tfor _, severities := range findingClasses {\n50|\t\t\t\tinput, allTrue := oracleChecks(staged, live, combo)\n51|\t\t\t\tif !idsEqual {\n52|\t\t\t\t\tinput.ObservedTargetNativeSession = \"a-different-native-session\"\n53|\t\t\t\t}\n54|\t\t\t\tinput.Findings = fixtureFindings(severities...)\n55|\t\t\t\twant := allTrue && idsEqual && !hasErrorSeverity(severities)\n56|\t\t\t\tinput.Valid = want\n57|\t\t\t\tsealed, err := clonereadback.BuildValidationReport(input, staged, live)\n58|\t\t\t\tif err != nil {\n59|\t\t\t\t\tt.Fatalf(\"combo=%d idsEqual=%v findings=%v: decided valid=%v refused: %v\", combo, idsEqual, severities, want, err)\n60|\t\t\t\t}\n61|\t\t\t\tif _, err := clonereadback.DecodeValidationReport(sealed, staged, live); err != nil {\n62|\t\t\t\t\tt.Fatalf(\"combo=%d idsEqual=%v findings=%v: sealed doc refuses: %v\", combo, idsEqual, severities, err)\n63|\t\t\t\t}\n64|\t\t\t\tinput.Valid = !want\n65|\t\t\t\tif _, err := clonereadback.BuildValidationReport(input, staged, live); err == nil {\n66|\t\t\t\t\tt.Fatalf(\"combo=%d idsEqual=%v findings=%v: flipped valid=%v admitted at Build\", combo, idsEqual, severities, !want)\n67|\t\t\t\t} else if !strings.Contains(err.Error(), \"valid disagrees with the check outcome\") {\n68|\t\t\t\t\tt.Fatalf(\"combo=%d: flipped-bit error %q misses the literal\", combo, err.Error())\n69|\t\t\t\t}\n70|\t\t\t\tdocument := decodeDocument(t, sealed)\n71|\t\t\t\tdocument[\"valid\"] = !want\n72|\t\t\t\tdocument[\"validation_report_id\"] = independentSelfDigest(t, marshalDocument(t, document), \"validation_report_id\")\n73|\t\t\t\tif _, err := clonereadback.DecodeValidationReport(marshalDocument(t, document), staged, live); err == nil {\n74|\t\t\t\t\tt.Fatalf(\"combo=%d idsEqual=%v findings=%v: flipped valid=%v admitted at Decode\", combo, idsEqual, severities, !want)\n75|\t\t\t\t} else if !strings.Contains(err.Error(), \"valid disagrees with the check outcome\") {\n76|\t\t\t\t\tt.Fatalf(\"combo=%d: flipped-bit decode error %q misses the literal\", combo, err.Error())\n77|\t\t\t\t}\n78|\t\t\t\tchecked++\n79|\t\t\t}\n80|\t\t}\n81|\t}\n82|\tt.Logf(\"valid oracle: %d combinations driven through Build+Decode\", checked)\n83|}\n84|\n85|func hasErrorSeverity(severities []string) bool {\n86|\tfor _, severity := range severities {\n87|\t\tif severity == \"error\" {\n88|\t\t\treturn true\n89|\t\t}\n90|\t}\n91|\treturn false\n92|}\n93|\n94|// TestNativeIdentityEqualityOracle pins \"equal expected and observed\n95|// native Session IDs\" at both read-back entries and both report\n96|// entries: equal pairs seal, and unequal pairs — including the\n97|// same-length neighbor the length-comparing narrowing would admit —\n98|// refuse with the literal.\n99|func TestNativeIdentityEqualityOracle(t *testing.T) {\n100|\tstaged, live := mustReadPair(t)\n101|\tpairs := [][2]string{\n102|\t\t{\"session-a\", \"session-a\"},\n103|\t\t{\"session-a\", \"session-b\"},\n104|\t\t{\"session-a\", \"session-aa\"},\n105|\t\t{\"x\", \"y\"},\n106|\t\t{\"\", \"\"},\n107|\t}\n108|\tfor _, pair := range pairs {\n109|\t\twant := pair[0] == pair[1] && pair[0] != \"\"\n110|\t\tinput := validReadBackInput()\n111|\t\tinput.ExpectedTargetNativeSession = pair[0]\n112|\t\tinput.ObservedTargetNativeSession = pair[1]\n113|\t\t_, err := clonereadback.BuildReadBackEvidenceManifest(input, stagedAuthority(t))\n114|\t\tif want && err != nil {\n115|\t\t\tt.Fatalf(\"readback pair %q refused: %v\", pair, err)\n116|\t\t}\n117|\t\tif !want && err == nil {\n118|\t\t\tt.Fatalf(\"readback pair %q admitted at Build\", pair)\n119|\t\t}\n120|\t\t// The report decides valid from the equality: an unequal\n121|\t\t// pair seals with valid=false and refuses with\n122|\t\t// valid=true; an equal pair seals with valid=true.\n123|\t\t// Empty pairs refuse on bounds either way.\n124|\t\trinput := validReportInput(staged, live)\n125|\t\trinput.ExpectedTargetNativeSession = pair[0]\n126|\t\trinput.ObservedTargetNativeSession = pair[1]\n127|\t\tif pair[0] == \"\" {\n128|\t\t\trinput.Valid = false\n129|\t\t\tif _, err := clonereadback.BuildValidationReport(rinput, staged, live); err == nil {\n130|\t\t\t\tt.Fatalf(\"report pair %q admitted at Build\", pair)\n131|\t\t\t}\n132|\t\t\tcontinue\n133|\t\t}\n134|\t\trinput.Valid = false\n135|\t\tif _, err := clonereadback.BuildValidationReport(rinput, staged, live); pair[0] == pair[1] {\n136|\t\t\tif err == nil {\n137|\t\t\t\tt.Fatalf(\"report equal pair %q with valid=false admitted at Build\", pair)\n138|\t\t\t}\n139|\t\t} else if err != nil {\n140|\t\t\tt.Fatalf(\"report unequal pair %q with valid=false refused: %v\", pair, err)\n141|\t\t}\n142|\t\trinput.Valid = true\n143|\t\tif _, err := clonereadback.BuildValidationReport(rinput, staged, live); pair[0] == pair[1] {\n144|\t\t\tif err != nil {\n145|\t\t\t\tt.Fatalf(\"report equal pair %q with valid=true refused: %v\", pair, err)\n146|\t\t\t}\n147|\t\t} else if err == nil {\n148|\t\t\tt.Fatalf(\"report unequal pair %q with valid=true admitted at Build\", pair)\n149|\t\t}\n150|\t}\n151|\t// The decode-side equality gate refuses a doc whose IDs differ\n152|\t// even under a consistent resealed id: the gate reads members,\n153|\t// not bytes.\n154|\tsealed := mustBuildReadBack(t, stagedAuthority(t), validReadBackInput())\n155|\tdocument := decodeDocument(t, sealed)\n156|\tdocument[\"observed_target_native_session_id\"] = \"a-different-native-session\"\n157|\tdocument[\"read_back_evidence_manifest_id\"] = independentSelfDigest(t, marshalDocument(t, document), \"read_back_evidence_manifest_id\")\n158|\t_, err := clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document), stagedAuthority(t))\n159|\trequireRefusal(t, err, \"read-back evidence manifest\", \"expected and observed native Session IDs differ\")\n160|\trsealed := mustBuildReport(t, validReportInput(staged, live), staged, live)\n161|\trdocument := decodeDocument(t, rsealed)\n162|\trdocument[\"observed_target_native_session_id\"] = \"a-different-native-session\"\n163|\trdocument[\"valid\"] = false\n164|\trdocument[\"validation_report_id\"] = independentSelfDigest(t, marshalDocument(t, rdocument), \"validation_report_id\")\n165|\treport, err := clonereadback.DecodeValidationReport(marshalDocument(t, rdocument), staged, live)\n166|\tif err != nil {\n167|\t\tt.Fatalf(\"differing IDs with valid=false refused: %v\", err)\n168|\t}\n169|\tif report.Valid {\n170|\t\tt.Fatal(\"differing IDs decoded valid=true\")\n171|\t}\n172|}\n173|\n174|// TestModeVocabularyOracle pins mode:staged|live at both read-back\n175|// entries: the two closed modes seal under their matching\n176|// authorities and every neighbor — case, whitespace, empty,\n177|// archived, both, and invalid UTF-8 — refuses with the literal.\n178|func TestModeVocabularyOracle(t *testing.T) {\n179|\tfor _, mode := range []string{\"staged\", \"live\"} {\n180|\t\tinput := validReadBackInput()\n181|\t\tinput.Mode = mode\n182|\t\tauthority := stagedAuthority(t)\n183|\t\tif mode == \"live\" {\n184|\t\t\tauthority = liveAuthority(t)\n185|\t\t}\n186|\t\tmustBuildReadBack(t, authority, input)\n187|\t\tif !clonereadback.ValidReadBackMode(mode) {\n188|\t\t\tt.Fatalf(\"ValidReadBackMode(%q) = false\", mode)\n189|\t\t}\n190|\t}\n191|\tneighbors := []struct {\n192|\t\tmode    string\n193|\t\tliteral string\n194|\t}{\n195|\t\t{\"\", \"mode is outside staged|live\"}, {\" \", \"mode is outside staged|live\"},\n196|\t\t{\"staged \", \"mode is outside staged|live\"}, {\" staged\", \"mode is outside staged|live\"},\n197|\t\t{\"STAGED\", \"mode is outside staged|live\"}, {\"Staged\", \"mode is outside staged|live\"},\n198|\t\t{\"live \", \"mode is outside staged|live\"}, {\"LIVE\", \"mode is outside staged|live\"},\n199|\t\t{\"archived\", \"mode is outside staged|live\"}, {\"both\", \"mode is outside staged|live\"},\n200|\t\t{\"staged,live\", \"mode is outside staged|live\"}, {\"null\", \"mode is outside staged|live\"},\n201|\t\t{\"dormant\", \"mode is outside staged|live\"}, {\"validated\", \"mode is outside staged|live\"},\n202|\t\t{\"stagged\", \"mode is outside staged|live\"}, {\"liv\", \"mode is outside staged|live\"},\n203|\t\t{\"stage\", \"mode is outside staged|live\"},\n204|\t\t{string([]byte{0xff}), \"mode is not valid UTF-8\"}, {\"staged\\xff\", \"mode is not valid UTF-8\"},\n205|\t}\n206|\tfor _, probe := range neighbors {\n207|\t\tinput := validReadBackInput()\n208|\t\tinput.Mode = probe.mode\n209|\t\t_, err := clonereadback.BuildReadBackEvidenceManifest(input, stagedAuthority(t))\n210|\t\trequireRefusal(t, err, \"read-back evidence manifest\", probe.literal)\n211|\t\tif clonereadback.ValidReadBackMode(probe.mode) {\n212|\t\t\tt.Fatalf(\"ValidReadBackMode(%q) = true\", probe.mode)\n213|\t\t}\n214|\t}\n215|\tsealed := mustBuildReadBack(t, stagedAuthority(t), validReadBackInput())\n216|\tfor _, probe := range neighbors {\n217|\t\tdocument := decodeDocument(t, sealed)\n218|\t\tif probe.mode == string([]byte{0xff}) || probe.mode == \"staged\\xff\" {\n219|\t\t\tcontinue // unmarshalable bytes cannot ride a JSON document; the Build row above pins them.\n220|\t\t}\n221|\t\tdocument[\"mode\"] = probe.mode\n222|\t\t_, err := clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document), stagedAuthority(t))\n223|\t\trequireRefusal(t, err, \"read-back evidence manifest\", \"mode is outside staged|live\")\n224|\t}\n225|\tif modes := clonereadback.ReadBackModes(); len(modes) != 2 || modes[0] != \"staged\" || modes[1] != \"live\" {\n226|\t\tt.Fatalf(\"ReadBackModes() = %q, want [staged live]\", modes)\n227|\t}\n228|}\n229|\n230|// TestEvidenceKindVocabularyOracle pins\n231|// evidence_kind:native_sample|parser_trace|marker_observation at\n232|// both read-back entries: the three closed kinds seal and every\n233|// neighbor refuses with the literal.\n234|func TestEvidenceKindVocabularyOracle(t *testing.T) {\n235|\tfor _, kind := range []string{\"native_sample\", \"parser_trace\", \"marker_observation\"} {\n236|\t\tinput := validReadBackInput()\n237|\t\tinput.EvidenceObjects = []clonereadback.EvidenceObjectInput{validEvidenceInput(kind, kind)}\n238|\t\tmustBuildReadBack(t, stagedAuthority(t), input)\n239|\t\tif !clonereadback.ValidEvidenceKind(kind) {\n240|\t\t\tt.Fatalf(\"ValidEvidenceKind(%q) = false\", kind)\n241|\t\t}\n242|\t}\n243|\tneighbors := []struct {\n244|\t\tkind    string\n245|\t\tliteral string\n246|\t}{\n247|\t\t{\"\", \"evidence_kind is outside native_sample|parser_trace|marker_observation\"},\n248|\t\t{\"native\", \"evidence_kind is outside native_sample|parser_trace|marker_observation\"},\n249|\t\t{\"sample\", \"evidence_kind is outside native_sample|parser_trace|marker_observation\"},\n250|\t\t{\"NATIVE_SAMPLE\", \"evidence_kind is outside native_sample|parser_trace|marker_observation\"},\n251|\t\t{\"Native_Sample\", \"evidence_kind is outside native_sample|parser_trace|marker_observation\"},\n252|\t\t{\"parser\", \"evidence_kind is outside native_sample|parser_trace|marker_observation\"},\n253|\t\t{\"trace\", \"evidence_kind is outside native_sample|parser_trace|marker_observation\"},\n254|\t\t{\"marker\", \"evidence_kind is outside native_sample|parser_trace|marker_observation\"},\n255|\t\t{\"observation\", \"evidence_kind is outside native_sample|parser_trace|marker_observation\"},\n256|\t\t{\"native-sample\", \"evidence_kind is outside native_sample|parser_trace|marker_observation\"},\n257|\t\t{\"blob\", \"evidence_kind is outside native_sample|parser_trace|marker_observation\"},\n258|\t\t{\"evidence\", \"evidence_kind is outside native_sample|parser_trace|marker_observation\"},\n259|\t\t{\"null\", \"evidence_kind is outside native_sample|parser_trace|marker_observation\"},\n260|\t\t{string([]byte{0xff}), \"evidence_kind is not valid UTF-8\"},\n261|\t}\n262|\tfor _, probe := range neighbors {\n263|\t\tinput := validReadBackInput()\n264|\t\tinput.EvidenceObjects = []clonereadback.EvidenceObjectInput{validEvidenceInput(probe.kind, \"neighbor\")}\n265|\t\t_, err := clonereadback.BuildReadBackEvidenceManifest(input, stagedAuthority(t))\n266|\t\trequireRefusal(t, err, \"evidence object\", probe.literal)\n267|\t\tif clonereadback.ValidEvidenceKind(probe.kind) {\n268|\t\t\tt.Fatalf(\"ValidEvidenceKind(%q) = true\", probe.kind)\n269|\t\t}\n270|\t}\n271|\tsealed := mustBuildReadBack(t, stagedAuthority(t), validReadBackInput())\n272|\tfor _, probe := range neighbors {\n273|\t\tif probe.kind == string([]byte{0xff}) {\n274|\t\t\tcontinue\n275|\t\t}\n276|\t\tdocument := decodeDocument(t, sealed)\n277|\t\tdocumentAt(t, document, \"evidence_objects\", 0)[\"evidence_kind\"] = probe.kind\n278|\t\t_, err := clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document), stagedAuthority(t))\n279|\t\trequireRefusal(t, err, \"evidence object\", \"evidence_kind is outside native_sample|parser_trace|marker_observation\")\n280|\t}\n281|\tif kinds := clonereadback.EvidenceKinds(); len(kinds) != 3 || kinds[0] != \"native_sample\" || kinds[1] != \"parser_trace\" || kinds[2] != \"marker_observation\" {\n282|\t\tt.Fatalf(\"EvidenceKinds() = %q\", kinds)\n283|\t}\n284|}","final_result":true}}}
