{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8c7","stream":{"kind":"session","id":"01a0d4c8-c91a-7382-bd41-b29e82ff449b"},"sequence":702,"recorded_at":1780531400001399,"record_type":"event","durability":"durable","causation_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","run_stream":{"kind":"run","id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6"},"task_stream":{"kind":"task","id":"01a0d4cc-0413-76f3-a3f7-9f7288a79bba"},"task_id":"01a0d4cc-0413-76f3-a3f7-9f7288a79bba","event":{"kind":"output","task_id":"01a0d4cc-0413-76f3-a3f7-9f7288a79bba","chunk":"Read text file `internal/clonereadback/gates_test.go`.\n1|package clonereadback_test\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"fmt\"\n6|\t\"sort\"\n7|\t\"strings\"\n8|\t\"testing\"\n9|\n10|\tclonereadback \"github.com/relux-works/agent-session-manager/internal/clonereadback\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// This file pins the measure, order, count, delegation, and scalar\n15|// gates: character bounds at edge and edge+1, sorted-unique sweeps,\n16|// owner-decoded members refused with owner detail at both entries,\n17|// and the stated bounds the spec leaves underivable.\n18|\n19|// TestNativeSessionStringEdges pins string[1..512] in CHARACTERS at\n20|// both entries of both shapes: 1 and 512 admit, 0 and 513 refuse,\n21|// and 513 multibyte characters (1026 bytes) refuse — a byte\n22|// measure would admit a shorter character count at the same byte\n23|// length, so the multibyte edge at exactly 512 characters admits.\n24|func TestNativeSessionStringEdges(t *testing.T) {\n25|\tstaged, live := mustReadPair(t)\n26|\tcases := []struct {\n27|\t\tlength int\n28|\t\tmulti  bool\n29|\t\twant   bool\n30|\t}{\n31|\t\t{1, false, true}, {512, false, true}, {0, false, false}, {513, false, false},\n32|\t\t{512, true, true}, {513, true, false},\n33|\t}\n34|\tfor _, probe := range cases {\n35|\t\tvalue := strings.Repeat(\"a\", probe.length)\n36|\t\tif probe.multi {\n37|\t\t\tvalue = strings.Repeat(\"é\", probe.length)\n38|\t\t}\n39|\t\tinput := validReadBackInput()\n40|\t\tinput.ExpectedTargetNativeSession = value\n41|\t\tinput.ObservedTargetNativeSession = value\n42|\t\t_, err := clonereadback.BuildReadBackEvidenceManifest(input, stagedAuthority(t))\n43|\t\tif probe.want && err != nil {\n44|\t\t\tt.Fatalf(\"readback length=%d multi=%v refused: %v\", probe.length, probe.multi, err)\n45|\t\t}\n46|\t\tif !probe.want && err == nil {\n47|\t\t\tt.Fatalf(\"readback length=%d multi=%v admitted at Build\", probe.length, probe.multi)\n48|\t\t}\n49|\t\trinput := validReportInput(staged, live)\n50|\t\trinput.ExpectedTargetNativeSession = value\n51|\t\trinput.ObservedTargetNativeSession = value\n52|\t\t_, err = clonereadback.BuildValidationReport(rinput, staged, live)\n53|\t\tif probe.want && err != nil {\n54|\t\t\tt.Fatalf(\"report length=%d multi=%v refused: %v\", probe.length, probe.multi, err)\n55|\t\t}\n56|\t\tif !probe.want && err == nil {\n57|\t\t\tt.Fatalf(\"report length=%d multi=%v admitted at Build\", probe.length, probe.multi)\n58|\t\t}\n59|\t}\n60|\tsealed := mustBuildReadBack(t, stagedAuthority(t), validReadBackInput())\n61|\tfor _, probe := range []struct {\n62|\t\tvalue string\n63|\t\twant  bool\n64|\t}{\n65|\t\t{\"a\", true}, {strings.Repeat(\"a\", 512), true},\n66|\t\t{\"\", false}, {strings.Repeat(\"a\", 513), false},\n67|\t\t{strings.Repeat(\"é\", 512), true}, {strings.Repeat(\"é\", 513), false},\n68|\t} {\n69|\t\tdocument := decodeDocument(t, sealed)\n70|\t\tdocument[\"expected_target_native_session_id\"] = probe.value\n71|\t\tdocument[\"observed_target_native_session_id\"] = probe.value\n72|\t\tdocument[\"read_back_evidence_manifest_id\"] = independentSelfDigest(t, marshalDocument(t, document), \"read_back_evidence_manifest_id\")\n73|\t\t_, err := clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document), stagedAuthority(t))\n74|\t\tif probe.want && err != nil {\n75|\t\t\tt.Fatalf(\"decode %d chars refused: %v\", len([]rune(probe.value)), err)\n76|\t\t}\n77|\t\tif !probe.want && err == nil {\n78|\t\t\tt.Fatalf(\"decode %d chars admitted\", len([]rune(probe.value)))\n79|\t\t}\n80|\t}\n81|}\n82|\n83|// TestMediaTypeStringEdges pins media_type:string[1..128] at both\n84|// read-back entries.\n85|func TestMediaTypeStringEdges(t *testing.T) {\n86|\tfor _, probe := range []struct {\n87|\t\tvalue string\n88|\t\twant  bool\n89|\t}{\n90|\t\t{\"a\", true}, {strings.Repeat(\"a\", 128), true}, {strings.Repeat(\"é\", 128), true},\n91|\t\t{\"\", false}, {strings.Repeat(\"a\", 129), false}, {strings.Repeat(\"é\", 129), false},\n92|\t} {\n93|\t\tinput := validReadBackInput()\n94|\t\trow := validEvidenceInput(\"native_sample\", \"media\")\n95|\t\trow.MediaType = probe.value\n96|\t\tinput.EvidenceObjects = []clonereadback.EvidenceObjectInput{row}\n97|\t\t_, err := clonereadback.BuildReadBackEvidenceManifest(input, stagedAuthority(t))\n98|\t\tif probe.want && err != nil {\n99|\t\t\tt.Fatalf(\"media %d chars refused: %v\", len([]rune(probe.value)), err)\n100|\t\t}\n101|\t\tif !probe.want && err == nil {\n102|\t\t\tt.Fatalf(\"media %d chars admitted at Build\", len([]rune(probe.value)))\n103|\t\t}\n104|\t}\n105|\tsealed := mustBuildReadBack(t, stagedAuthority(t), validReadBackInput())\n106|\tfor _, probe := range []struct {\n107|\t\tvalue string\n108|\t\twant  bool\n109|\t}{\n110|\t\t{\"a\", true}, {strings.Repeat(\"a\", 128), true},\n111|\t\t{\"\", false}, {strings.Repeat(\"a\", 129), false},\n112|\t} {\n113|\t\tdocument := decodeDocument(t, sealed)\n114|\t\tdocumentAt(t, document, \"evidence_objects\", 0)[\"media_type\"] = probe.value\n115|\t\tdocument[\"read_back_evidence_manifest_id\"] = independentSelfDigest(t, marshalDocument(t, document), \"read_back_evidence_manifest_id\")\n116|\t\t_, err := clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document), stagedAuthority(t))\n117|\t\tif probe.want && err != nil {\n118|\t\t\tt.Fatalf(\"decode media %d chars refused: %v\", len(probe.value), err)\n119|\t\t}\n120|\t\tif !probe.want && err == nil {\n121|\t\t\tt.Fatalf(\"decode media %d chars admitted\", len(probe.value))\n122|\t\t}\n123|\t}\n124|}\n125|\n126|// TestParsedHeadIDsSweep pins parsed_head_ids as sorted unique\n127|// string[1..512][0..1024] at both read-back entries: sorted admits,\n128|// unsorted/duplicated/overlong/overcount refuse with the literal,\n129|// and the count edge 1024 admits while 1025 refuses.\n130|func TestParsedHeadIDsSweep(t *testing.T) {\n131|\tinput := validReadBackInput()\n132|\tinput.ParsedHeadIDs = nil\n133|\tmustBuildReadBack(t, stagedAuthority(t), input)\n134|\tfor _, probe := range [][]string{\n135|\t\t{\"b\", \"a\"}, {\"a\", \"a\"}, {\"a\", \"b\", \"b\"}, {\"\"}, {strings.Repeat(\"a\", 513)},\n136|\t} {\n137|\t\tbad := validReadBackInput()\n138|\t\tbad.ParsedHeadIDs = probe\n139|\t\t_, err := clonereadback.BuildReadBackEvidenceManifest(bad, stagedAuthority(t))\n140|\t\trequireRefusal(t, err, \"read-back evidence manifest\", \"parsed_head_ids\")\n141|\t}\n142|\tedge := validReadBackInput()\n143|\tedge.ParsedHeadIDs = make([]string, 0, 1024)\n144|\tfor index := 0; index < 1024; index++ {\n145|\t\tedge.ParsedHeadIDs = append(edge.ParsedHeadIDs, fmt.Sprintf(\"head-%04d\", index))\n146|\t}\n147|\tmustBuildReadBack(t, stagedAuthority(t), edge)\n148|\tover := validReadBackInput()\n149|\tover.ParsedHeadIDs = append(append([]string{}, edge.ParsedHeadIDs...), \"zzz-overflow-tail\")\n150|\tsort.Strings(over.ParsedHeadIDs)\n151|\t_, err := clonereadback.BuildReadBackEvidenceManifest(over, stagedAuthority(t))\n152|\trequireRefusal(t, err, \"read-back evidence manifest\", \"parsed_head_ids carries 1025 items, want [0..1024]\")\n153|\tsealed := mustBuildReadBack(t, stagedAuthority(t), validReadBackInput())\n154|\tfor _, probe := range [][]string{{\"b\", \"a\"}, {\"a\", \"a\"}} {\n155|\t\tdocument := decodeDocument(t, sealed)\n156|\t\tdocument[\"parsed_head_ids\"] = probe\n157|\t\t_, err := clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document), stagedAuthority(t))\n158|\t\trequireRefusal(t, err, \"read-back evidence manifest\", \"parsed_head_ids are not sorted unique string[1..512][0..1024]\")\n159|\t}\n160|\t// An overlong head and an over-count array refuse at Decode\n161|\t// under a consistent resealed id: the gate reads members, not\n162|\t// bytes. The over-count array stays sorted, so only the count\n163|\t// bound fires.\n164|\tdocument := decodeDocument(t, sealed)\n165|\tdocument[\"parsed_head_ids\"] = []string{strings.Repeat(\"a\", 513)}\n166|\tdocument[\"read_back_evidence_manifest_id\"] = independentSelfDigest(t, marshalDocument(t, document), \"read_back_evidence_manifest_id\")\n167|\t_, err = clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document), stagedAuthority(t))\n168|\trequireRefusal(t, err, \"read-back evidence manifest\", \"parsed_head_ids are not sorted unique string[1..512][0..1024]\")\n169|\tedgeSealed := mustBuildReadBack(t, stagedAuthority(t), edge)\n170|\tedgeDoc := decodeDocument(t, edgeSealed)\n171|\theads := edgeDoc[\"parsed_head_ids\"].([]any)\n172|\theads = append(heads, \"zzz-overflow-tail\")\n173|\trendered := make([]string, 0, len(heads))\n174|\tfor _, head := range heads {\n175|\t\trendered = append(rendered, head.(string))\n176|\t}\n177|\tsort.Strings(rendered)\n178|\tedgeDoc[\"parsed_head_ids\"] = rendered\n179|\tedgeDoc[\"read_back_evidence_manifest_id\"] = independentSelfDigest(t, marshalDocument(t, edgeDoc), \"read_back_evidence_manifest_id\")\n180|\t_, err = clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, edgeDoc), stagedAuthority(t))\n181|\trequireRefusal(t, err, \"read-back evidence manifest\", \"parsed_head_ids are not sorted unique string[1..512][0..1024]\")\n182|}\n183|\n184|// TestEvidenceOrderSweep pins \"sorted unique by evidence kind/blob\n185|// ID\" at both read-back entries: the six permutations of three rows\n186|// admit exactly the sorted one, same-kind rows order by blob ID,\n187|// and duplicated (kind, blob) pairs refuse with the literal.\n188|func TestEvidenceOrderSweep(t *testing.T) {\n189|\trows := []clonereadback.EvidenceObjectInput{\n190|\t\tvalidEvidenceInput(\"marker_observation\", \"order-c\"),\n191|\t\tvalidEvidenceInput(\"native_sample\", \"order-a\"),\n192|\t\tvalidEvidenceInput(\"parser_trace\", \"order-b\"),\n193|\t}\n194|\tsorted := append([]clonereadback.EvidenceObjectInput{}, rows...)\n195|\tsort.Slice(sorted, func(i, j int) bool {\n196|\t\tif sorted[i].EvidenceKind != sorted[j].EvidenceKind {\n197|\t\t\treturn sorted[i].EvidenceKind < sorted[j].EvidenceKind\n198|\t\t}\n199|\t\treturn sorted[i].BlobID < sorted[j].BlobID\n200|\t})\n201|\tadmitted := 0\n202|\tfor _, perm := range permutations3() {\n203|\t\tinput := validReadBackInput()\n204|\t\tinput.EvidenceObjects = []clonereadback.EvidenceObjectInput{rows[perm[0]], rows[perm[1]], rows[perm[2]]}\n205|\t\t_, err := clonereadback.BuildReadBackEvidenceManifest(input, stagedAuthority(t))\n206|\t\tisSorted := rows[perm[0]].EvidenceKind == sorted[0].EvidenceKind && rows[perm[1]].EvidenceKind == sorted[1].EvidenceKind && rows[perm[2]].EvidenceKind == sorted[2].EvidenceKind\n207|\t\tif isSorted {\n208|\t\t\tif err != nil {\n209|\t\t\t\tt.Fatalf(\"sorted permutation %v refused: %v\", perm, err)\n210|\t\t\t}\n211|\t\t\tadmitted++\n212|\t\t} else if err == nil {\n213|\t\t\tt.Fatalf(\"unsorted permutation %v admitted at Build\", perm)\n214|\t\t} else if !strings.Contains(err.Error(), \"evidence_objects are not sorted unique by evidence kind/blob ID\") {\n215|\t\t\tt.Fatalf(\"permutation %v error %q misses the literal\", perm, err.Error())\n216|\t\t}\n217|\t}\n218|\tif admitted != 1 {\n219|\t\tt.Fatalf(\"admitted permutations = %d, want 1\", admitted)\n220|\t}\n221|\t// Same-kind rows order by blob ID string order.\n222|\tlow := validEvidenceInput(\"native_sample\", \"same-kind-low\")\n223|\thigh := validEvidenceInput(\"native_sample\", \"same-kind-high\")\n224|\tpair := []clonereadback.EvidenceObjectInput{low, high}\n225|\tsort.Slice(pair, func(i, j int) bool { return pair[i].BlobID < pair[j].BlobID })\n226|\tordered := validReadBackInput()\n227|\tordered.EvidenceObjects = pair\n228|\tmustBuildReadBack(t, stagedAuthority(t), ordered)\n229|\tflipped := validReadBackInput()\n230|\tflipped.EvidenceObjects = []clonereadback.EvidenceObjectInput{pair[1], pair[0]}\n231|\t_, err := clonereadback.BuildReadBackEvidenceManifest(flipped, stagedAuthority(t))\n232|\trequireRefusal(t, err, \"read-back evidence manifest\", \"evidence_objects are not sorted unique by evidence kind/blob ID\")\n233|\t// Duplicated pairs refuse even when adjacent-sorted.\n234|\tdup := validReadBackInput()\n235|\tdup.EvidenceObjects = []clonereadback.EvidenceObjectInput{low, low}\n236|\t_, err = clonereadback.BuildReadBackEvidenceManifest(dup, stagedAuthority(t))\n237|\trequireRefusal(t, err, \"read-back evidence manifest\", \"evidence_objects are not sorted unique by evidence kind/blob ID\")\n238|\t// Decode pins the same gate over sealed bytes.\n239|\tsealed := mustBuildReadBack(t, stagedAuthority(t), ordered)\n240|\tdocument := decodeDocument(t, sealed)\n241|\trows2 := document[\"evidence_objects\"].([]any)\n242|\trows2[0], rows2[1] = rows2[1], rows2[0]\n243|\t_, err = clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document), stagedAuthority(t))\n244|\trequireRefusal(t, err, \"read-back evidence manifest\", \"evidence_objects are not sorted unique by evidence kind/blob ID\")\n245|}\n246|\n247|func permutations3() [][]int {\n248|\treturn [][]int{{0, 1, 2}, {0, 2, 1}, {1, 0, 2}, {1, 2, 0}, {2, 0, 1}, {2, 1, 0}}\n249|}\n250|\n251|// TestEvidenceCountEdges pins EvidenceObject[0..65536] at both\n252|// read-back entries: empty admits, 65536 admits, 65537 refuses with\n253|// the literal count.\n254|func TestEvidenceCountEdges(t *testing.T) {\n255|\tempty := validReadBackInput()\n256|\tempty.EvidenceObjects = nil\n257|\tmustBuildReadBack(t, stagedAuthority(t), empty)\n258|\tfull := validReadBackInput()\n259|\tfull.EvidenceObjects = make([]clonereadback.EvidenceObjectInput, 0, 65536)\n260|\tseen := map[string]bool{}\n261|\tfor counter := 0; len(full.EvidenceObjects) < 65536; counter++ {\n262|\t\trow := validEvidenceInput(\"native_sample\", fmt.Sprintf(\"edge-%d\", counter))\n263|\t\tif seen[row.BlobID] {\n264|\t\t\tcontinue\n265|\t\t}\n266|\t\tseen[row.BlobID] = true\n267|\t\tfull.EvidenceObjects = append(full.EvidenceObjects, row)\n268|\t}\n269|\tsort.Slice(full.EvidenceObjects, func(i, j int) bool {\n270|\t\treturn full.EvidenceObjects[i].BlobID < full.EvidenceObjects[j].BlobID\n271|\t})\n272|\tsealed := mustBuildReadBack(t, stagedAuthority(t), full)\n273|\tif _, err := clonereadback.DecodeReadBackEvidenceManifest(sealed, stagedAuthority(t)); err != nil {\n274|\t\tt.Fatalf(\"65536 rows refused at Decode: %v\", err)\n275|\t}\n276|\tover := validReadBackInput()\n277|\tover.EvidenceObjects = append(append([]clonereadback.EvidenceObjectInput{}, full.EvidenceObjects...), validEvidenceInput(\"parser_trace\", \"overflow\"))\n278|\t_, err := clonereadback.BuildReadBackEvidenceManifest(over, stagedAuthority(t))\n279|\trequireRefusal(t, err, \"read-back evidence manifest\", \"carries 65537 evidence_objects, want [0..65536]\")\n280|\tdocument := decodeDocument(t, sealed)\n281|\trows := document[\"evidence_objects\"].([]any)\n282|\trows = append(rows, map[string]any{\n283|\t\t\"evidence_kind\": \"parser_trace\", \"media_type\": \"text/plain\", \"byte_count\": float64(1),\n284|\t\t\"blob_id\": fixtureDigest(\"overflow\"), \"blob_descriptor_id\": fixtureDigest(\"overflow-desc\"),\n285|\t})\n286|\tdocument[\"evidence_objects\"] = rows\n287|\tdocument[\"read_back_evidence_manifest_id\"] = independentSelfDigest(t, marshalDocument(t, document), \"read_back_evidence_manifest_id\")\n288|\t_, err = clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document), stagedAuthority(t))\n289|\trequireRefusal(t, err, \"read-back evidence manifest\", \"carries 65537 evidence_objects, want [0..65536]\")\n290|}\n291|\n292|// TestFindingsCountEdges pins AdapterFinding[0..4096] at both report\n293|// entries: 4096 admits, 4097 refuses.\n294|func TestFindingsCountEdges(t *testing.T) {\n295|\tstaged, live := mustReadPair(t)\n296|\tseverities := make([]string, 0, 4096)\n297|\tfor index := 0; index < 4096; index++ {\n298|\t\tseverities = append(severities, \"info\")\n299|\t}\n300|\tfull := validReportInput(staged, live)\n301|\tfull.Findings = fixtureFindings(severities...)\n302|\tsealed := mustBuildReport(t, full, staged, live)\n303|\tif _, err := clonereadback.DecodeValidationReport(sealed, staged, live); err != nil {\n304|\t\tt.Fatalf(\"4096 findings refused at Decode: %v\", err)\n305|\t}\n306|\tover := validReportInput(staged, live)\n307|\tover.Findings = fixtureFindings(append(severities, \"info\")...)\n308|\t_, err := clonereadback.BuildValidationReport(over, staged, live)\n309|\trequireRefusal(t, err, \"clone validation report\", \"findings are not AdapterFinding[0..4096]\")\n310|\t// Decode refuses the over-count document under a consistent\n311|\t// resealed id: the count gate reads members, not bytes.\n312|\toverDoc := decodeDocument(t, sealed)\n313|\tfindings := overDoc[\"findings\"].([]any)\n314|\tfindings = append(findings, map[string]any{\n315|\t\t\"code\": \"probe-overflow\", \"extensions\": map[string]any{},\n316|\t\t\"message\": \"overflow\", \"remediation\": nil, \"severity\": \"info\",\n317|\t})\n318|\toverDoc[\"findings\"] = findings\n319|\toverDoc[\"validation_report_id\"] = independentSelfDigest(t, marshalDocument(t, overDoc), \"validation_report_id\")\n320|\t_, err = clonereadback.DecodeValidationReport(marshalDocument(t, overDoc), staged, live)\n321|\trequireRefusal(t, err, \"clone validation report\", \"findings are not AdapterFinding[0..4096]\")\n322|}\n323|\n324|// TestOwnerDelegation pins that tuple, binding, and finding members\n325|// decode through their landed owners at every entry: a broken\n326|// nested document refuses with the owner detail, never a local\n327|// re-implementation verdict.\n328|func TestOwnerDelegation(t *testing.T) {\n329|\tstaged, live := mustReadPair(t)\n330|\tbrokenTuple := []byte(`{\"adapter_version\":\"1.2.3\",\"architecture\":\"arm64\",\"environment_id\":\"relux.target\",\"environment_version\":\"2026.09\",\"platform\":\"plan9\",\"store_schema_fingerprint\":\"` + fixtureDigest(\"store\") + `\"}`)\n331|\tbrokenBinding := []byte(`{\"branch\":\"main\",\"cwd_relative\":\"/absolute/escape\",\"extensions\":{},\"head_digest\":null,\"index_digest\":null,\"logical_workspace_id\":\"` + fixtureOperationID(\"ws\") + `\",\"repository_remote_fingerprints\":[],\"working_tree_digest\":null}`)\n332|\tbrokenFinding := []byte(`[{\"code\":\"x\",\"extensions\":{},\"message\":\"m\",\"remediation\":null,\"severity\":\"critical\"}]`)\n333|\tinput := validReadBackInput()\n334|\tinput.ObservedEnvironment = brokenTuple\n335|\t_, err := clonereadback.BuildReadBackEvidenceManifest(input, stagedAuthority(t))\n336|\trequireRefusal(t, err, \"read-back evidence manifest\", \"observed_environment is not an Environment Tuple\")\n337|\tinput = validReadBackInput()\n338|\tinput.WorkspaceBinding = brokenBinding\n339|\t_, err = clonereadback.BuildReadBackEvidenceManifest(input, stagedAuthority(t))\n340|\trequireRefusal(t, err, \"read-back evidence manifest\", \"workspace_binding is not a Workspace Binding\")\n341|\tsealed := mustBuildReadBack(t, stagedAuthority(t), validReadBackInput())\n342|\tdocument := decodeDocument(t, sealed)\n343|\tdocument[\"observed_environment\"] = decodeDocument(t, brokenTuple)\n344|\t_, err = clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document), stagedAuthority(t))\n345|\trequireRefusal(t, err, \"read-back evidence manifest\", \"observed_environment is not an Environment Tuple\")\n346|\tdocument = decodeDocument(t, sealed)\n347|\tdocument[\"workspace_binding\"] = decodeDocument(t, brokenBinding)\n348|\t_, err = clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document), stagedAuthority(t))\n349|\trequireRefusal(t, err, \"read-back evidence manifest\", \"workspace_binding is not a Workspace Binding\")\n350|\trinput := validReportInput(staged, live)\n351|\trinput.TargetEnvironment = brokenTuple\n352|\t_, err = clonereadback.BuildValidationReport(rinput, staged, live)\n353|\trequireRefusal(t, err, \"clone validation report\", \"target_environment is not an Environment Tuple\")\n354|\trinput = validReportInput(staged, live)\n355|\trinput.Findings = brokenFinding\n356|\t_, err = clonereadback.BuildValidationReport(rinput, staged, live)\n357|\trequireRefusal(t, err, \"clone validation report\", \"findings are not AdapterFinding[0..4096]\")\n358|\trsealed := mustBuildReport(t, validReportInput(staged, live), staged, live)\n359|\trdocument := decodeDocument(t, rsealed)\n360|\trdocument[\"target_environment\"] = decodeDocument(t, brokenTuple)\n361|\t_, err = clonereadback.DecodeValidationReport(marshalDocument(t, rdocument), staged, live)\n362|\trequireRefusal(t, err, \"clone validation report\", \"target_environment is not an Environment Tuple\")\n363|\trdocument = decodeDocument(t, rsealed)\n364|\tvar findingDocs []any\n365|\tif err := json.Unmarshal(brokenFinding, &findingDocs); err != nil {\n366|\t\tt.Fatalf(\"unmarshal broken findings: %v\", err)\n367|\t}\n368|\trdocument[\"findings\"] = findingDocs\n369|\t_, err = clonereadback.DecodeValidationReport(marshalDocument(t, rdocument), staged, live)\n370|\trequireRefusal(t, err, \"clone validation report\", \"findings are not AdapterFinding[0..4096]\")\n371|}\n372|\n373|// TestScalarGates pins digests, UUIDs, uint53, and the AX number\n374|// model at every entry: malformed scalars refuse, 2^53 refuses, and\n375|// float/exponent/string numbers refuse at decode.\n376|func TestScalarGates(t *testing.T) {\n377|\tstaged, live := mustReadPair(t)\n378|\tinput := validReadBackInput()\n379|\tinput.OperationID = \"not-a-uuid\"\n380|\t_, err := clonereadback.BuildReadBackEvidenceManifest(input, stagedAuthority(t))\n381|\trequireRefusal(t, err, \"read-back evidence manifest\", \"operation_id is not a UUIDv7\")\n382|\tinput = validReadBackInput()\n383|\tinput.StructuralDigest = \"not-a-digest\"\n384|\t_, err = clonereadback.BuildReadBackEvidenceManifest(input, stagedAuthority(t))\n385|\trequireRefusal(t, err, \"read-back evidence manifest\", \"structural_digest is not a digest\")\n386|\tinput = validReadBackInput()\n387|\tinput.ParsedEventCount = 1 << 53\n388|\t_, err = clonereadback.BuildReadBackEvidenceManifest(input, stagedAuthority(t))\n389|\trequireRefusal(t, err, \"read-back evidence manifest\", \"parsed_event_count exceeds uint53\")\n390|\tinput = validReadBackInput()\n391|\tinput.ParsedEventCount = 1<<53 - 1\n392|\tmustBuildReadBack(t, stagedAuthority(t), input)\n393|\tsealed := mustBuildReadBack(t, stagedAuthority(t), validReadBackInput())\n394|\tfor _, probe := range []any{float64(1.5), \"41\", true, nil} {\n395|\t\tdocument := decodeDocument(t, sealed)\n396|\t\tdocument[\"parsed_event_count\"] = probe\n397|\t\t_, err := clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document), stagedAuthority(t))\n398|\t\trequireRefusal(t, err, \"read-back evidence manifest\", \"parsed_event_count is not a uint53\")\n399|\t}\n400|\tdocument := decodeDocument(t, sealed)\n401|\tdocument[\"parsed_event_count\"] = float64(1 << 53)\n402|\t_, err = clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document), stagedAuthority(t))\n403|\trequireRefusal(t, err, \"read-back evidence manifest\", \"parsed_event_count is not a uint53\")\n404|\t// Exponent form must refuse even when its value is integral:\n405|\t// the AX number model admits canonical integers only.\n406|\traw := strings.Replace(string(sealed), `\"parsed_event_count\":41`, `\"parsed_event_count\":4.1e1`, 1)\n407|\tif raw == string(sealed) {\n408|\t\tt.Fatal(\"could not splice exponent count: fixture changed\")\n409|\t}\n410|\t_, err = clonereadback.DecodeReadBackEvidenceManifest([]byte(raw), stagedAuthority(t))\n411|\trequireRefusal(t, err, \"read-back evidence manifest\", \"parsed_event_count is not a uint53\")\n412|\trinput := validReportInput(staged, live)\n413|\trinput.OperationID = \"01935934-5b8a-4f3c-9e1d-2a4b6c8d0e1f\" // v4, not v7\n414|\t_, err = clonereadback.BuildValidationReport(rinput, staged, live)\n415|\trequireRefusal(t, err, \"clone validation report\", \"operation_id is not a UUIDv7\")\n416|}\n417|\n418|// TestDecodeScalarStrings drives every sealed digest and UUID\n419|// member through the production decode entries with a malformed\n420|// string of the right JSON type: each refuses with its member\n421|// literal. Scalar members are classified from the sealed values —\n422|// \"sha256:\"-prefixed values are digests, owner-parseable UUIDs\n423|// are UUIDs — never from a hand-typed list; the per-shape counts\n424|// pin the classification itself.\n425|func TestDecodeScalarStrings(t *testing.T) {\n426|\twant := map[string]int{\"readback\": 5, \"evidence\": 2, \"report\": 8}\n427|\tfor _, shape := range readBackCensusShapes(t) {\n428|\t\tt.Run(shape.label, func(t *testing.T) {\n429|\t\t\tprobed := 0\n430|\t\t\tfor _, member := range shape.members {\n431|\t\t\t\tif member.typ != \"string\" {\n432|\t\t\t\t\tcontinue\n433|\t\t\t\t}\n434|\t\t\t\tdocument := decodeDocument(t, shape.seal(t))\n435|\t\t\t\tobject := shape.navigate(t, document)\n436|\t\t\t\tvalue, ok := object[member.name].(string)\n437|\t\t\t\tif !ok {\n438|\t\t\t\t\tt.Fatalf(\"member %s sealed a non-string %T\", member.name, object[member.name])\n439|\t\t\t\t}\n440|\t\t\t\tprobe := \"\"\n441|\t\t\t\tif strings.HasPrefix(value, \"sha256:\") {\n442|\t\t\t\t\tprobe = \"not-a-digest\"\n443|\t\t\t\t} else if _, err := scalar.ParseUUIDv7(value); err == nil {\n444|\t\t\t\t\tprobe = \"not-a-uuid\"\n445|\t\t\t\t} else {\n446|\t\t\t\t\tcontinue\n447|\t\t\t\t}\n448|\t\t\t\tmutated := decodeDocument(t, shape.seal(t))\n449|\t\t\t\tshape.navigate(t, mutated)[member.name] = probe\n450|\t\t\t\terr := shape.decode(shape.rewrite(t, mutated))\n451|\t\t\t\tif err == nil {\n452|\t\t\t\t\tt.Fatalf(\"member %s admits malformed scalar %q\", member.name, probe)\n453|\t\t\t\t}\n454|\t\t\t\tif !strings.Contains(err.Error(), shape.owner) || !strings.Contains(err.Error(), member.name) {\n455|\t\t\t\t\tt.Fatalf(\"member %s scalar error %q misses owner or member literal\", member.name, err.Error())\n456|\t\t\t\t}\n457|\t\t\t\tprobed++\n458|\t\t\t}\n459|\t\t\tif probed != want[shape.label] {\n460|\t\t\t\tt.Fatalf(\"shape %s probed %d scalar members, want %d\", shape.label, probed, want[shape.label])\n461|\t\t\t}\n462|\t\t})\n463|\t}\n464|}\n465|\n466|// TestExtensionsClosed pins reverse-DNS-only extensions at every\n467|// entry: open keys refuse with the literal.\n468|func TestExtensionsClosed(t *testing.T) {\n469|\tstaged, live := mustReadPair(t)\n470|\tinput := validReadBackInput()\n471|\tinput.Extensions = map[string]any{\"not-a-reverse-dns-key\": \"x\"}\n472|\t_, err := clonereadback.BuildReadBackEvidenceManifest(input, stagedAuthority(t))\n473|\trequireRefusal(t, err, \"read-back evidence manifest\", \"extensions invalid\")\n474|\tinput = validReadBackInput()\n475|\tinput.Extensions = map[string]any{\"com.example.note\": \"x\"}\n476|\tmustBuildReadBack(t, stagedAuthority(t), input)\n477|\tsealed := mustBuildReadBack(t, stagedAuthority(t), validReadBackInput())\n478|\tdocument := decodeDocument(t, sealed)\n479|\tdocument[\"extensions\"] = map[string]any{\"open\": \"x\"}\n480|\t_, err = clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document), stagedAuthority(t))\n481|\trequireRefusal(t, err, \"read-back evidence manifest\", \"extensions\")\n482|\trinput := validReportInput(staged, live)\n483|\trinput.Extensions = map[string]any{\"not-a-reverse-dns-key\": \"x\"}\n484|\t_, err = clonereadback.BuildValidationReport(rinput, staged, live)\n485|\trequireRefusal(t, err, \"clone validation report\", \"extensions invalid\")\n486|\trsealed := mustBuildReport(t, validReportInput(staged, live), staged, live)\n487|\trdocument := decodeDocument(t, rsealed)\n488|\trdocument[\"extensions\"] = map[string]any{\"open\": \"x\"}\n489|\t_, err = clonereadback.DecodeValidationReport(marshalDocument(t, rdocument), staged, live)\n490|\trequireRefusal(t, err, \"clone validation report\", \"extensions\")\n491|}\n492|\n493|// TestParsedCountAndStructuralDigestAreStatedBounds pins what the\n494|// spec leaves underivable: parsed_event_count carries no stated\n495|// derivation from the heads or the rows, and structural_digest\n496|// carries no stated preimage, so any uint53 count and any digest\n497|// admit. A future derivation would be a spec change, not a gate\n498|// fix.\n499|func TestParsedCountAndStructuralDigestAreStatedBounds(t *testing.T) {\n500|\tinput := validReadBackInput()\n501|\tinput.ParsedEventCount = 0\n502|\tinput.ParsedHeadIDs = []string{\"head-a\", \"head-b\", \"head-c\"}\n503|\tmustBuildReadBack(t, stagedAuthority(t), input)\n504|\tinput.ParsedEventCount = 1<<53 - 1\n505|\tinput.StructuralDigest = fixtureDigest(\"unrelated-preimage\")\n506|\tmustBuildReadBack(t, stagedAuthority(t), input)\n507|}\n508|\n509|// TestReportTupleMatchIsReconciliationBound pins the sibling-scope\n510|// bound: the report carries one target tuple and the \"matching\n511|// tuple\" conjunct of the valid rule needs the read manifests'\n512|// observed tuples as cross-inputs, so any owner-valid tuple admits\n513|// here and the cross-match belongs to the final reconciliation\n514|// leaf.\n515|func TestReportTupleMatchIsReconciliationBound(t *testing.T) {\n516|\tstaged, live := mustReadPair(t)\n517|\tother := []byte(`{\"adapter_version\":\"9.9.9\",\"architecture\":\"amd64\",\"environment_id\":\"relux.other\",\"environment_version\":\"1.0\",\"platform\":\"linux\",\"store_schema_fingerprint\":\"` + fixtureDigest(\"other-store\") + `\"}`)\n518|\tinput := validReportInput(staged, live)\n519|\tinput.TargetEnvironment = other\n520|\tmustBuildReport(t, input, staged, live)\n521|}","final_result":true}}}
