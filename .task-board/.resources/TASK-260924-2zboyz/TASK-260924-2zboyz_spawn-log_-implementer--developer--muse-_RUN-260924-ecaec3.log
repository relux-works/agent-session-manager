{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c669","stream":{"kind":"session","id":"01a0d4c8-c91a-7382-bd41-b29e82ff449b"},"sequence":399,"recorded_at":1780531400000793,"record_type":"event","durability":"durable","causation_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","run_stream":{"kind":"run","id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6"},"task_stream":{"kind":"task","id":"01a0d4ca-5f1c-7143-b430-a550b6f3390e"},"task_id":"01a0d4ca-5f1c-7143-b430-a550b6f3390e","event":{"kind":"output","task_id":"01a0d4ca-5f1c-7143-b430-a550b6f3390e","chunk":"Read text file `internal/clonereadback/authority.go`.\n1|package clonereadback\n2|\n3|// This file binds the read-back mode to the trusted read authority\n4|// (SPEC v0.7.0 lines 3796-3797: ReadAuthority carries\n5|// purpose:source_native|target_staged|target_live; Section 13.14.2\n6|// lines 10753-10754: \"Staged and live manifests are distinct and\n7|// cannot be relabeled.\"; line 10580: \"Modes cannot be relabeled.\").\n8|// The mode is DERIVED from the authority purpose the caller threads\n9|// from its authority chain — never parsed from the manifest being\n10|// validated. A resealed manifest carrying the opposite mode refuses\n11|// even though its self-digest recomputes, because the digest alone\n12|// does not carry the stage. source_native grants no target\n13|// read-back and refuses at every entry. Authority decoding and\n14|// freshness stay with the sessadapter owner and the caller chain;\n15|// these entries consume the Purpose of an already-validated\n16|// sessadapter.ReadAuthority only.\n17|\n18|// modeForAuthorityPurpose derives the expected read-back mode from\n19|// a trusted read authority purpose: target_staged seals staged,\n20|// target_live seals live. source_native is a source purpose, never\n21|// a target read-back, and any other purpose is outside the closed\n22|// vocabulary. Both read-back entries share this gate. The purpose\n23|// names repeat here because no exported owner predicate defines\n24|// the purpose-to-mode binding: sessadapter owns authority decoding\n25|// (DecodeReadAuthority, called where the chain mints the struct),\n26|// and this package owns the binding this leaf's invariant needs.\n27|func modeForAuthorityPurpose(purpose string) (string, error) {\n28|\tswitch purpose {\n29|\tcase \"target_staged\":\n30|\t\treturn \"staged\", nil\n31|\tcase \"target_live\":\n32|\t\treturn \"live\", nil\n33|\tcase \"source_native\":\n34|\t\treturn \"\", invalid(\"read-back evidence manifest read authority purpose source_native grants no target read-back\")\n35|\tdefault:\n36|\t\treturn \"\", invalid(\"read-back evidence manifest read authority purpose %q is outside source_native|target_staged|target_live\", purpose)\n37|\t}\n38|}\n39|\n40|// checkModeAuthority enforces that the claimed mode equals the mode\n41|// derived from the trusted read authority: a claim the authority\n42|// does not grant is a relabel, never a second reading. Both\n43|// read-back entries share this gate.\n44|func checkModeAuthority(owner, claimed, expected, purpose string) error {\n45|\tif claimed != expected {\n46|\t\treturn invalid(\"%s mode %q disagrees with read authority purpose %q\", owner, claimed, purpose)\n47|\t}\n48|\treturn nil\n49|}","final_result":true}}}
