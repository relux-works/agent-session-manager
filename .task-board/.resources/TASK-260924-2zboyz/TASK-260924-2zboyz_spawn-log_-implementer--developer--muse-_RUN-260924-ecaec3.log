{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c91f","stream":{"kind":"session","id":"01a0d4c8-c91a-7382-bd41-b29e82ff449b"},"sequence":746,"recorded_at":1780531400001487,"record_type":"event","durability":"durable","causation_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","run_stream":{"kind":"run","id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6"},"call_id":"call_01a0d4cc1d12746a802dd9a09340f4cd","text":"Read text file `internal/clonereadback/members_test.go`.\n(349 line(s) above)\n350|\t\t\tfor name := range object {\n351|\t\t\t\tif !derived[name] {\n352|\t\t\t\t\tt.Errorf(\"sealed %s carries underived member %q\", shape.label, name)\n353|\t\t\t\t}\n354|\t\t\t}\n355|\t\t})\n356|\t}\n357|}\n358|\n359|// TestMemberCensusUnknownMissing drives every derived member\n360|// through the production decode entry twice: once deleted (missing\n361|// refusal naming the member) and once beside an extra member\n362|// (unknown refusal naming the extra).\n363|func TestMemberCensusUnknownMissing(t *testing.T) {\n364|\tfor _, shape := range readBackCensusShapes(t) {\n365|\t\tt.Run(shape.label, func(t *testing.T) {\n366|\t\t\tfor _, member := range shape.members {\n367|\t\t\t\tdocument := decodeDocument(t, shape.seal(t))\n368|\t\t\t\tobject := shape.navigate(t, document)\n369|\t\t\t\tsaved := object[member.name]\n370|\t\t\t\tdelete(object, member.name)\n371|\t\t\t\terr := shape.decode(shape.rewrite(t, document))\n372|\t\t\t\trequireRefusal(t, err, shape.owner, \"misses a required member \\\"\"+member.name+\"\\\"\")\n373|\t\t\t\tobject[member.name] = saved\n374|\t\t\t\tobject[\"zz_extra_member\"] = \"smuggled\"\n375|\t\t\t\terr = shape.decode(shape.rewrite(t, document))\n376|\t\t\t\trequireRefusal(t, err, shape.owner, \"carries unknown member \\\"zz_extra_member\\\"\")\n377|\t\t\t}\n378|\t\t})\n379|\t}\n380|}\n381|\n382|// TestMemberCensusMiscased drives every derived member through the\n383|// production decode entry renamed with an uppercase initial: the\n384|// renamed member is unknown and the required member is missing.\n385|func TestMemberCensusMiscased(t *testing.T) {\n386|\tfor _, shape := range readBackCensusShapes(t) {\n387|\t\tt.Run(shape.label, func(t *testing.T) {\n388|\t\t\tfor _, member := range shape.members {\n389|\t\t\t\tdocument := decodeDocument(t, shape.seal(t))\n390|\t\t\t\tobject := shape.navigate(t, document)\n391|\t\t\t\tmiscased := strings.ToUpper(member.name[:1]) + member.name[1:]\n392|\t\t\t\tobject[miscased] = object[member.name]\n393|\t\t\t\tdelete(object, member.name)\n394|\t\t\t\terr := shape.decode(shape.rewrite(t, document))\n395|\t\t\t\trequireRefusal(t, err, shape.owner, \"carries unknown member \\\"\"+miscased+\"\\\"\")\n396|\t\t\t}\n397|\t\t})\n398|\t}\n399|}\n400|\n401|// wrongTypeProbes lists the JSON values that are never the probed\n402|// member type.\n403|func wrongTypeProbes(typ string) []any {\n404|\tswitch typ {\n405|\tcase \"string\":\n406|\t\treturn []any{float64(1), float64(1.5), true, nil, []any{}, map[string]any{}}\n407|\tcase \"uint\":\n408|\t\treturn []any{\"1\", float64(1.5), float64(-1), true, nil, []any{}, map[string]any{}}\n409|\tcase \"boolean\":\n410|\t\treturn []any{\"true\", float64(1), float64(0), nil, []any{}, map[string]any{}}\n411|\tcase \"array\":\n412|\t\treturn []any{\"x\", float64(1), true, nil, map[string]any{}}\n413|\tcase \"object\":\n414|\t\treturn []any{\"x\", float64(1), true, nil, []any{true}}\n415|\tdefault:\n416|\t\treturn nil\n417|\t}\n418|}\n419|\n420|// TestMemberCensusWrongTypes drives every derived member through\n421|// the production decode entry under six wrong JSON types: each is\n422|// refused with the member name in the literal.\n423|func TestMemberCensusWrongTypes(t *testing.T) {\n424|\tfor _, shape := range readBackCensusShapes(t) {\n425|\t\tt.Run(shape.label, func(t *testing.T) {\n426|\t\t\tfor _, member := range shape.members {\n427|\t\t\t\tprobes := wrongTypeProbes(member.typ)\n428|\t\t\t\tif len(probes) == 0 {\n429|\t\t\t\t\tt.Fatalf(\"member %s has unprobed type %q\", member.name, member.typ)\n430|\t\t\t\t}\n431|\t\t\t\tfor _, probe := range probes {\n432|\t\t\t\t\tdocument := decodeDocument(t, shape.seal(t))\n433|\t\t\t\t\tobject := shape.navigate(t, document)\n434|\t\t\t\t\tobject[member.name] = probe\n435|\t\t\t\t\terr := shape.decode(shape.rewrite(t, document))\n436|\t\t\t\t\tif err == nil {\n437|\t\t\t\t\t\tt.Fatalf(\"member %s admits wrong type %v\", member.name, probe)\n438|\t\t\t\t\t}\n439|\t\t\t\t\tif !strings.Contains(err.Error(), shape.owner) || !strings.Contains(err.Error(), member.name) {\n440|\t\t\t\t\t\tt.Fatalf(\"member %s wrong-type error %q misses owner or member literal\", member.name, err.Error())\n441|\t\t\t\t\t}\n442|\t\t\t\t}\n443|\t\t\t}\n444|\t\t})\n445|\t}\n446|}\n447|\n448|// scanJSONValue scans one JSON value starting at start (an object,\n449|// array, string, or scalar) and returns the index just past its\n450|// end.\n451|func scanJSONValue(t *testing.T, raw []byte, start int) int {\n452|\tt.Helper()\n453|\tdepth := 0\n454|\tinString := false\n455|\tescaped := false\n456|\tfor index := start; index < len(raw); index++ {\n457|\t\tchar := raw[index]\n458|\t\tif inString {\n459|\t\t\tif escaped {\n460|\t\t\t\tescaped = false\n461|\t\t\t\tcontinue\n462|\t\t\t}\n463|\t\t\tif char == '\\\\' {\n464|\t\t\t\tescaped = true\n465|\t\t\t\tcontinue\n466|\t\t\t}\n467|\t\t\tif char == '\"' {\n468|\t\t\t\tinString = false\n469|\t\t\t}\n470|\t\t\tcontinue\n471|\t\t}\n472|\t\tswitch char {\n473|\t\tcase '\"':\n474|\t\t\tinString = true\n475|\t\tcase '{', '[':\n476|\t\t\tdepth++\n477|\t\tcase '}', ']':\n478|\t\t\tif depth == 0 {\n479|\t\t\t\treturn index\n480|\t\t\t}\n481|\t\t\tdepth--\n482|\t\t\tif depth == 0 {\n483|\t\t\t\treturn index + 1\n484|\t\t\t}\n485|\t\tcase ',':\n486|\t\t\tif depth == 0 {\n487|\t\t\t\treturn index\n488|\t\t\t}\n489|\t\t}\n490|\t}\n491|\tt.Fatalf(\"unterminated JSON value at %d\", start)\n492|\treturn -1\n493|}\n494|\n495|// spliceDuplicateMember duplicates one member pair inside the shape\n496|// byte zone, producing a document whose strict decode must refuse\n497|// the duplicate. The duplicate carries the same bytes, so only the\n498|// duplication — never a changed value — triggers the refusal.\n499|func spliceDuplicateMember(t *testing.T, sealed []byte, zone func(t *testing.T, sealed []byte) (int, int), member string) []byte {\n500|\tt.Helper()\n501|\tstart, end := zone(t, sealed)\n502|\twindow := sealed[start:end]\n503|\tkey := `\"` + member + `\":`\n504|\tat := strings.Index(string(window), key)\n505|\tif at < 0 {\n506|\t\tt.Fatalf(\"member %q not found in dup zone\", member)\n507|\t}\n508|\tvalueStart := start + at + len(key)\n509|\tvalueEnd := scanJSONValue(t, sealed, valueStart)\n510|\tpair := sealed[valueStart-len(key) : valueEnd]\n511|\tmutated := append([]byte{}, sealed[:valueEnd]...)\n512|\tmutated = append(mutated, ',')\n513|\tmutated = append(mutated, pair...)\n514|\tmutated = append(mutated, sealed[valueEnd:]...)\n515|\treturn mutated\n516|}\n517|\n518|// firstRowZone locates the first row object of an array member in\n519|// the sealed bytes.\n520|func firstRowZone(t *testing.T, sealed []byte, member string) (int, int) {\n521|\tt.Helper()\n522|\tkey := `\"` + member + `\":[{`\n523|\tat := strings.Index(string(sealed), key)\n524|\tif at < 0 {\n525|\t\tt.Fatalf(\"array member %q with a first row not found\", member)\n526|\t}\n527|\tstart := at + len(key) - 1\n528|\tend := scanJSONValue(t, sealed, start)\n529|\treturn start, end\n530|}\n531|\n532|// TestMemberCensusDuplicated drives every derived member through\n533|// the production decode entry duplicated at the byte level: strict\n534|// decoding refuses the duplicate.\n535|func TestMemberCensusDuplicated(t *testing.T) {\n536|\tfor _, shape := range readBackCensusShapes(t) {\n537|\t\tt.Run(shape.label, func(t *testing.T) {\n538|\t\t\tsealed := shape.seal(t)\n539|\t\t\tfor _, member := range shape.members {\n540|\t\t\t\tmutated := spliceDuplicateMember(t, sealed, shape.dupZone, member.name)\n541|\t\t\t\terr := shape.decode(mutated)\n542|\t\t\t\trequireRefusal(t, err, shape.owner, \"duplicate member\")\n543|\t\t\t}\n544|\t\t})\n545|\t}\n546|}\n547|\n548|// TestCensusShapeInventory pins the census coverage itself: 3\n549|// shapes and the exact member counts retyped from the spec.\n550|func TestCensusShapeInventory(t *testing.T) {\n551|\twant := map[string]int{\n552|\t\t\"readback\": 16, \"evidence\": 5, \"report\": 23,\n553|\t}\n554|\tshapes := readBackCensusShapes(t)\n555|\tif len(shapes) != len(want) {\n556|\t\tt.Fatalf(\"census shapes = %d, want %d\", len(shapes), len(want))\n557|\t}\n558|\tvar labels []string\n559|\tfor _, shape := range shapes {\n560|\t\tlabels = append(labels, shape.label)\n561|\t\tif len(shape.members) != want[shape.label] {\n562|\t\t\tt.Errorf(\"shape %s members = %d, want %d\", shape.label, len(shape.members), want[shape.label])\n563|\t\t}\n564|\t}\n565|\tsort.Strings(labels)\n566|\tt.Logf(\"census shapes (%d): %s\", len(labels), strings.Join(labels, \", \"))\n567|}\n568|\n569|// TestMemberCensusNoLiteralList guards the derivation itself: no\n570|// composite literal in the package test files may hold a\n571|// census-scale string-literal member list. A composite trips when it\n572|// carries at least 8 distinct derived-universe members at 40% or\n573|// higher member purity (member literals over all string literals).\n574|// Closure bodies are skipped: probe tables legitimately name one\n575|// member per row inside mutate closures. The N-guard-literal-list\n576|// harness row plants a 10-name list that must redden this test.\n577|func TestMemberCensusNoLiteralList(t *testing.T) {\n578|\tuniverse := map[string]bool{}\n579|\tfor _, shape := range readBackCensusShapes(t) {\n580|\t\tfor _, member := range shape.members {\n581|\t\t\tuniverse[member.name] = true\n582|\t\t}\n583|\t}\n584|\tif len(universe) == 0 {\n585|\t\tt.Fatal(\"derived member universe is empty\")\n586|\t}\n587|\t_, file, _, ok := runtime.Caller(0)\n588|\tif !ok {\n589|\t\tt.Fatal(\"runtime.Caller failed\")\n590|\t}\n591|\tfiles, err := filepath.Glob(filepath.Join(filepath.Dir(file), \"*_test.go\"))\n592|\tif err != nil {\n593|\t\tt.Fatalf(\"glob test files: %v\", err)\n594|\t}\n595|\tif len(files) == 0 {\n596|\t\tt.Fatal(\"no test files found\")\n597|\t}\n598|\tfor _, path := range files {\n599|\t\tsource, err := os.ReadFile(path)\n600|\t\tif err != nil {\n601|\t\t\tt.Fatalf(\"read %s: %v\", path, err)\n602|\t\t}\n603|\t\tfset := token.NewFileSet()\n604|\t\tparsed, err := parser.ParseFile(fset, path, source, 0)\n605|\t\tif err != nil {\n606|\t\t\tt.Fatalf(\"parse %s: %v\", path, err)\n607|\t\t}\n608|\t\tast.Inspect(parsed, func(node ast.Node) bool {\n609|\t\t\tcomposite, ok := node.(*ast.CompositeLit)\n610|\t\t\tif !ok {\n611|\t\t\t\treturn true\n612|\t\t\t}\n613|\t\t\tmembers := map[string]bool{}\n614|\t\t\tstringLiterals := 0\n615|\t\t\tvar walk func(node ast.Node)\n616|\t\t\twalk = func(node ast.Node) {\n617|\t\t\t\tif node == nil {\n618|\t\t\t\t\treturn\n619|\t\t\t\t}\n620|\t\t\t\tif _, isFunc := node.(*ast.FuncLit); isFunc {\n621|\t\t\t\t\treturn\n622|\t\t\t\t}\n623|\t\t\t\tif literal, isLit := node.(*ast.BasicLit); isLit && literal.Kind == token.STRING {\n624|\t\t\t\t\tif value, err := strconv.Unquote(literal.Value); err == nil {\n625|\t\t\t\t\t\tstringLiterals++\n626|\t\t\t\t\t\tif universe[value] {\n627|\t\t\t\t\t\t\tmembers[value] = true\n628|\t\t\t\t\t\t}\n629|\t\t\t\t\t}\n630|\t\t\t\t\treturn\n631|\t\t\t\t}\n632|\t\t\t\tfor _, child := range childNodes(node) {\n633|\t\t\t\t\twalk(child)\n634|\t\t\t\t}\n635|\t\t\t}\n636|\t\t\tfor _, element := range composite.Elts {\n637|\t\t\t\twalk(element)\n638|\t\t\t}\n639|\t\t\tif len(members) >= 8 && stringLiterals > 0 && float64(len(members))/float64(stringLiterals) >= 0.4 {\n640|\t\t\t\tt.Errorf(\"%s holds a census-scale member list (%d members): derive it, do not type it\", path, len(members))\n641|\t\t\t}\n642|\t\t\treturn true\n643|\t\t})\n644|\t}\n645|}\n646|\n647|// childNodes lists the child nodes of one AST node for the literal\n648|// walk.\n649|func childNodes(node ast.Node) []ast.Node {\n650|\tvar children []ast.Node\n651|\tast.Inspect(node, func(child ast.Node) bool {\n652|\t\tif child == node {\n653|\t\t\treturn true\n654|\t\t}\n655|\t\tchildren = append(children, child)\n656|\t\treturn false\n657|\t})\n658|\treturn children\n659|}\n660|\n661|// TestEnvelopeLiterals pins the literal schema/version/self member\n662|// names from the pinned registry at both production decode entries:\n663|// a swapped literal is a different schema, never this one.\n664|func TestEnvelopeLiterals(t *testing.T) {\n665|\tstaged, live := mustReadPair(t)\n666|\tsealed := mustBuildReadBack(t, stagedAuthority(t), validReadBackInput())\n667|\tfor _, probe := range []struct {\n668|\t\tmember string\n669|\t\tvalue  string\n670|\t}{\n671|\t\t{\"schema\", \"urn:ax:schema:clone-validation-report\"},\n672|\t\t{\"schema\", \"urn:ax:schema:projection-plan\"},\n673|\t\t{\"schema_version\", \"2.0.0\"},\n674|\t\t{\"schema_version\", \"1.0\"},\n675|\t} {\n676|\t\tdocument := decodeDocument(t, sealed)\n677|\t\tdocument[probe.member] = probe.value\n678|\t\t_, err := clonereadback.DecodeReadBackEvidenceManifest(marshalDocument(t, document), stagedAuthority(t))\n679|\t\trequireRefusal(t, err, \"read-back evidence manifest\", probe.member)\n680|\t}\n681|\trsealed := mustBuildReport(t, validReportInput(staged, live), staged, live)\n682|\tfor _, probe := range []struct {\n683|\t\tmember string\n684|\t\tvalue  string\n685|\t}{\n686|\t\t{\"schema\", \"urn:ax:schema:clone-read-back-evidence-manifest\"},\n687|\t\t{\"schema\", \"urn:ax:schema:fidelity-report\"},\n688|\t\t{\"schema_version\", \"2.0.0\"},\n689|\t\t{\"schema_version\", \"1.0\"},\n690|\t} {\n691|\t\tdocument := decodeDocument(t, rsealed)\n692|\t\tdocument[probe.member] = probe.value\n693|\t\t_, err := clonereadback.DecodeValidationReport(marshalDocument(t, document), staged, live)\n694|\t\trequireRefusal(t, err, \"clone validation report\", probe.member)\n695|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
