{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8f5","stream":{"kind":"session","id":"01a0d4c8-c91a-7382-bd41-b29e82ff449b"},"sequence":725,"recorded_at":1780531400001445,"record_type":"event","durability":"durable","causation_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","run_stream":{"kind":"run","id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6"},"call_id":"call_01a0d4cc0d5e779da32ea10b2885bed4","text":"Read text file `internal/clonereadback/members_test.go`.\n1|package clonereadback_test\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"reflect\"\n10|\t\"runtime\"\n11|\t\"sort\"\n12|\t\"strconv\"\n13|\t\"strings\"\n14|\t\"testing\"\n15|\t\"unicode\"\n16|\n17|\tclonereadback \"github.com/relux-works/agent-session-manager/internal/clonereadback\"\n18|)\n19|\n20|// TestReadBackRoundTrip seals a full read-back manifest and a full\n21|// validation report, decodes each, and asserts every field survived\n22|// with literal schema, mode, and kind values.\n23|func TestReadBackRoundTrip(t *testing.T) {\n24|\tstaged, live := mustReadPair(t)\n25|\tsealed := mustBuildReadBack(t, stagedAuthority(t), validReadBackInput())\n26|\tmanifest := mustDecodeReadBack(t, stagedAuthority(t), sealed)\n27|\tif manifest.Mode != \"staged\" {\n28|\t\tt.Fatalf(\"mode = %q, want staged\", manifest.Mode)\n29|\t}\n30|\tif len(manifest.EvidenceObjects) != 2 {\n31|\t\tt.Fatalf(\"evidence_objects = %d, want 2\", len(manifest.EvidenceObjects))\n32|\t}\n33|\tif manifest.EvidenceObjects[0].EvidenceKind != \"native_sample\" {\n34|\t\tt.Fatalf(\"row[0] kind = %q, want native_sample\", manifest.EvidenceObjects[0].EvidenceKind)\n35|\t}\n36|\tif manifest.EvidenceObjects[1].EvidenceKind != \"parser_trace\" {\n37|\t\tt.Fatalf(\"row[1] kind = %q, want parser_trace\", manifest.EvidenceObjects[1].EvidenceKind)\n38|\t}\n39|\tif manifest.ExpectedTargetNativeSession != manifest.ObservedTargetNativeSession {\n40|\t\tt.Fatal(\"native Session IDs did not survive equal\")\n41|\t}\n42|\tdocument := decodeDocument(t, sealed)\n43|\tif document[\"schema\"] != \"urn:ax:schema:clone-read-back-evidence-manifest\" {\n44|\t\tt.Fatalf(\"schema = %v, want urn:ax:schema:clone-read-back-evidence-manifest\", document[\"schema\"])\n45|\t}\n46|\tif document[\"schema_version\"] != \"1.0.0\" {\n47|\t\tt.Fatalf(\"schema_version = %v, want 1.0.0\", document[\"schema_version\"])\n48|\t}\n49|\trsealed := mustBuildReport(t, validReportInput(staged, live), staged, live)\n50|\treport := mustDecodeReport(t, rsealed, staged, live)\n51|\tif !report.Valid {\n52|\t\tt.Fatal(\"valid did not survive true\")\n53|\t}\n54|\tif len(report.Findings) != 1 || report.Findings[0].Severity != \"info\" {\n55|\t\tt.Fatal(\"findings did not survive\")\n56|\t}\n57|\trdocument := decodeDocument(t, rsealed)\n58|\tif rdocument[\"schema\"] != \"urn:ax:schema:clone-validation-report\" {\n59|\t\tt.Fatalf(\"schema = %v, want urn:ax:schema:clone-validation-report\", rdocument[\"schema\"])\n60|\t}\n61|\tif rdocument[\"schema_version\"] != \"1.0.0\" {\n62|\t\tt.Fatalf(\"schema_version = %v, want 1.0.0\", rdocument[\"schema_version\"])\n63|\t}\n64|}\n65|\n66|// memberProbe describes one shape member for the census grid: its\n67|// admitted JSON type and whether the shape carries it.\n68|type memberProbe struct {\n69|\tname string\n70|\ttyp  string // string, uint, boolean, array, object\n71|}\n72|\n73|// censusShape binds one closed shape to its DERIVED member list, a\n74|// baseline sealer, a navigator to the shape object inside the sealed\n75|// document, and the production decode entry.\n76|type censusShape struct {\n77|\tlabel   string\n78|\towner   string // error owner phrase\n79|\tmembers []memberProbe\n80|\tseal    func(t *testing.T) []byte\n81|\t// navigate returns the shape object and a rewriter that\n82|\t// remarshals the mutated document.\n83|\tnavigate func(t *testing.T, document map[string]any) map[string]any\n84|\trewrite  func(t *testing.T, document map[string]any) []byte\n85|\t// dupZone locates the byte zone (object body) where a member\n86|\t// pair is duplicated: top document or first evidence row.\n87|\tdupZone func(t *testing.T, sealed []byte) (start, end int)\n88|\tdecode  func([]byte) error\n89|}\n90|\n91|// irregularMembers maps the Go input fields whose JSON member names\n92|// do not follow the mechanical snake_case rule, each quoted from\n93|// pinned SPEC v0.7.0 §13.14.2: both top shapes carry\n94|// expected/observed_target_native_session_id (with the _id suffix\n95|// the Go field drops). Every other field maps mechanically. The\n96|// exact-set cross-check against the sealed bytes fails if this\n97|// table or the snake rule drifts from production.\n98|var irregularMembers = map[string]string{\n99|\t\"ExpectedTargetNativeSession\": \"expected_target_native_session_id\",\n100|\t\"ObservedTargetNativeSession\": \"observed_target_native_session_id\",\n101|}\n102|\n103|// snakeMember renders the mechanical member name for a Go input\n104|// field: a word boundary opens before every uppercase rune that\n105|// follows a lowercase rune or a digit, and the words join with\n106|// underscores in lowercase. Trailing acronym runs stay one word, so\n107|// OperationID becomes operation_id and ParsedHeadIDs becomes\n108|// parsed_head_ids.\n109|func snakeMember(field string) string {\n110|\tvar words []string\n111|\tstart := 0\n112|\trunes := []rune(field)\n113|\tfor index := 1; index < len(runes); index++ {\n114|\t\tif unicode.IsUpper(runes[index]) && (unicode.IsLower(runes[index-1]) || unicode.IsDigit(runes[index-1])) {\n115|\t\t\twords = append(words, string(runes[start:index]))\n116|\t\t\tstart = index\n117|\t\t}\n118|\t}\n119|\twords = append(words, string(runes[start:]))\n120|\treturn strings.ToLower(strings.Join(words, \"_\"))\n121|}\n122|\n123|// rowShapeOf maps a container field to the shape label its element\n124|// structs decode into.\n125|var rowShapeOf = map[string]string{\n126|\t\"EvidenceObjects\": \"evidence\",\n127|}\n128|\n129|// deriveReflectedCensus walks the two production input types by\n130|// reflection and returns every shape member with its JSON type.\n131|// Nested structs and slices of structs recurse; any field kind the\n132|// walker cannot classify fails loudly, so the set grows with the\n133|// types and never shrinks silently.\n134|func deriveReflectedCensus(t *testing.T) map[string][]memberProbe {\n135|\tt.Helper()\n136|\tcensus := map[string][]memberProbe{}\n137|\twalkCensusFields(t, reflect.TypeOf(clonereadback.ReadBackManifestInput{}), \"readback\", census)\n138|\twalkCensusFields(t, reflect.TypeOf(clonereadback.ValidationReportInput{}), \"report\", census)\n139|\treturn census\n140|}\n141|\n142|func walkCensusFields(t *testing.T, typ reflect.Type, shape string, census map[string][]memberProbe) {\n143|\tt.Helper()\n144|\tfor index := 0; index < typ.NumField(); index++ {\n145|\t\twalkCensusField(t, typ.Field(index), shape, census)\n146|\t}\n147|}\n148|\n149|func walkCensusField(t *testing.T, field reflect.StructField, shape string, census map[string][]memberProbe) {\n150|\tt.Helper()\n151|\tif field.PkgPath != \"\" {\n152|\t\tt.Fatalf(\"unexported field %s.%s: extend the walker before probing it\", shape, field.Name)\n153|\t}\n154|\tmember := snakeMember(field.Name)\n155|\tif irregular, ok := irregularMembers[field.Name]; ok {\n156|\t\tmember = irregular\n157|\t}\n158|\temit := func(typ string) {\n159|\t\tcensus[shape] = append(census[shape], memberProbe{name: member, typ: typ})\n160|\t}\n161|\tfieldType := field.Type\n162|\tswitch fieldType.Kind() {\n163|\tcase reflect.String:\n164|\t\temit(\"string\")\n165|\tcase reflect.Bool:\n166|\t\temit(\"boolean\")\n167|\tcase reflect.Uint64:\n168|\t\temit(\"uint\")\n169|\tcase reflect.Slice, reflect.Array:\n170|\t\telement := fieldType.Elem()\n171|\t\tswitch element.Kind() {\n172|\t\tcase reflect.Uint8:\n173|\t\t\t// Raw JSON members: tuples and bindings are\n174|\t\t\t// objects, findings are an array. The field\n175|\t\t\t// name disambiguates; anything else fails\n176|\t\t\t// loudly.\n177|\t\t\tswitch field.Name {\n178|\t\t\tcase \"Findings\":\n179|\t\t\t\temit(\"array\")\n180|\t\t\tcase \"ObservedEnvironment\", \"WorkspaceBinding\", \"TargetEnvironment\":\n181|\t\t\t\temit(\"object\")\n182|\t\t\tdefault:\n183|\t\t\t\tt.Fatalf(\"raw JSON field %s.%s is neither findings nor a known object: extend the walker\", shape, field.Name)\n184|\t\t\t}\n185|\t\tcase reflect.String:\n186|\t\t\temit(\"array\")\n187|\t\tcase reflect.Struct:\n188|\t\t\temit(\"array\")\n189|\t\t\trowShape, ok := rowShapeOf[field.Name]\n190|\t\t\tif !ok {\n191|\t\t\t\tt.Fatalf(\"slice of structs %s.%s has no row shape: extend the walker\", shape, field.Name)\n192|\t\t\t}\n193|\t\t\twalkCensusFields(t, element, rowShape, census)\n194|\t\tdefault:\n195|\t\t\tt.Fatalf(\"unhandled slice element kind %s at %s.%s: extend the walker\", element.Kind(), shape, field.Name)\n196|\t\t}\n197|\tcase reflect.Map:\n198|\t\tif fieldType.Key().Kind() != reflect.String {\n199|\t\t\tt.Fatalf(\"unhandled map key kind %s at %s.%s: extend the walker\", fieldType.Key().Kind(), shape, field.Name)\n200|\t\t}\n201|\t\tvalue := fieldType.Elem()\n202|\t\tif value.Kind() != reflect.Interface || value.NumMethod() != 0 {\n203|\t\t\tt.Fatalf(\"unhandled map value kind %s at %s.%s: extend the walker\", value.Kind(), shape, field.Name)\n204|\t\t}\n205|\t\temit(\"object\")\n206|\tdefault:\n207|\t\tt.Fatalf(\"unhandled kind %s at %s.%s: extend the walker\", fieldType.Kind(), shape, field.Name)\n208|\t}\n209|}\n210|\n211|// deriveEnvelopeMembers derives the sealed-envelope set for one\n212|// shape: sealed members minus the reflection-derived input\n213|// members, with JSON types classified from the sealed values.\n214|// Every top-level envelope field the sealer renders — schema,\n215|// schema_version, the self id — joins the attack grid through\n216|// this derivation, never through a hand-typed list. A value kind\n217|// the classifier cannot type fails loudly.\n218|func deriveEnvelopeMembers(t *testing.T, object map[string]any, derived []memberProbe) []memberProbe {\n219|\tt.Helper()\n220|\tknown := map[string]bool{}\n221|\tfor _, member := range derived {\n222|\t\tknown[member.name] = true\n223|\t}\n224|\tvar names []string\n225|\tfor name := range object {\n226|\t\tif !known[name] {\n227|\t\t\tnames = append(names, name)\n228|\t\t}\n229|\t}\n230|\tsort.Strings(names)\n231|\tvar envelope []memberProbe\n232|\tfor _, name := range names {\n233|\t\tswitch object[name].(type) {\n234|\t\tcase string:\n235|\t\t\tenvelope = append(envelope, memberProbe{name: name, typ: \"string\"})\n236|\t\tdefault:\n237|\t\t\tt.Fatalf(\"envelope member %q has unclassified JSON type %T: extend the classifier\", name, object[name])\n238|\t\t}\n239|\t}\n240|\treturn envelope\n241|}\n242|\n243|// readBackCensusShapes binds the three derived shapes to their\n244|// sealers, navigators, byte zones, and production decode entries.\n245|// The member lists come from reflection over the input types plus\n246|// the derived sealed envelope, so every member — inputs and\n247|// envelope alike — rides the full attack grid.\n248|func readBackCensusShapes(t *testing.T) []censusShape {\n249|\tt.Helper()\n250|\tderived := deriveReflectedCensus(t)\n251|\tstagedAuth := stagedAuthority(t)\n252|\tstaged, live := mustReadPair(t)\n253|\treadbackSealed := mustBuildReadBack(t, stagedAuth, validReadBackInput())\n254|\treportSealed := mustBuildReport(t, validReportInput(staged, live), staged, live)\n255|\treadbackMembers := append(append([]memberProbe{}, derived[\"readback\"]...), deriveEnvelopeMembers(t, decodeDocument(t, readbackSealed), derived[\"readback\"])...)\n256|\tevidenceMembers := append(append([]memberProbe{}, derived[\"evidence\"]...), deriveEnvelopeMembers(t, documentAt(t, decodeDocument(t, readbackSealed), \"evidence_objects\", 0), derived[\"evidence\"])...)\n257|\treportMembers := append(append([]memberProbe{}, derived[\"report\"]...), deriveEnvelopeMembers(t, decodeDocument(t, reportSealed), derived[\"report\"])...)\n258|\trewriteDoc := func(t *testing.T, document map[string]any) []byte {\n259|\t\treturn marshalDocument(t, document)\n260|\t}\n261|\ttopZone := func(t *testing.T, sealed []byte) (int, int) {\n262|\t\tt.Helper()\n263|\t\treturn 0, len(sealed)\n264|\t}\n265|\treturn []censusShape{\n266|\t\t{\n267|\t\t\tlabel:   \"readback\",\n268|\t\t\towner:   \"read-back evidence manifest\",\n269|\t\t\tmembers: readbackMembers,\n270|\t\t\tseal:    func(t *testing.T) []byte { return mustBuildReadBack(t, stagedAuthority(t), validReadBackInput()) },\n271|\t\t\tnavigate: func(t *testing.T, document map[string]any) map[string]any {\n272|\t\t\t\treturn document\n273|\t\t\t},\n274|\t\t\trewrite: rewriteDoc,\n275|\t\t\tdupZone: topZone,\n276|\t\t\tdecode: func(data []byte) error {\n277|\t\t\t\t_, err := clonereadback.DecodeReadBackEvidenceManifest(data, stagedAuth)\n278|\t\t\t\treturn err\n279|\t\t\t},\n280|\t\t},\n281|\t\t{\n282|\t\t\tlabel:   \"evidence\",\n283|\t\t\towner:   \"evidence object\",\n284|\t\t\tmembers: evidenceMembers,\n285|\t\t\tseal:    func(t *testing.T) []byte { return mustBuildReadBack(t, stagedAuthority(t), validReadBackInput()) },\n286|\t\t\tnavigate: func(t *testing.T, document map[string]any) map[string]any {\n287|\t\t\t\treturn documentAt(t, document, \"evidence_objects\", 0)\n288|\t\t\t},\n289|\t\t\trewrite: rewriteDoc,\n290|\t\t\tdupZone: func(t *testing.T, sealed []byte) (int, int) {\n291|\t\t\t\tt.Helper()\n292|\t\t\t\treturn firstRowZone(t, sealed, \"evidence_objects\")\n293|\t\t\t},\n294|\t\t\tdecode: func(data []byte) error {\n295|\t\t\t\t_, err := clonereadback.DecodeReadBackEvidenceManifest(data, stagedAuth)\n296|\t\t\t\treturn err\n297|\t\t\t},\n298|\t\t},\n299|\t\t{\n300|\t\t\tlabel:   \"report\",\n301|\t\t\towner:   \"clone validation report\",\n302|\t\t\tmembers: reportMembers,\n303|\t\t\tseal:    func(t *testing.T) []byte { return mustBuildReport(t, validReportInput(staged, live), staged, live) },\n304|\t\t\tnavigate: func(t *testing.T, document map[string]any) map[string]any {\n305|\t\t\t\treturn document\n306|\t\t\t},\n307|\t\t\trewrite: rewriteDoc,\n308|\t\t\tdupZone: topZone,\n309|\t\t\tdecode: func(data []byte) error {\n310|\t\t\t\t_, err := clonereadback.DecodeValidationReport(data, staged, live)\n311|\t\t\t\treturn err\n312|\t\t\t},\n313|\t\t},\n314|\t}\n315|}\n316|\n317|// requireRefusal asserts the production entry refused with the\n318|// owner phrase and the literal gate fragment.\n319|func requireRefusal(t *testing.T, err error, owner, fragment string) {\n320|\tt.Helper()\n321|\tif err == nil {\n322|\t\tt.Fatalf(\"entry admitted what it must refuse (want %q ... %q)\", owner, fragment)\n323|\t}\n324|\tif !strings.Contains(err.Error(), owner) {\n325|\t\tt.Fatalf(\"error %q misses owner phrase %q\", err.Error(), owner)\n326|\t}\n327|\tif !strings.Contains(err.Error(), fragment) {\n328|\t\tt.Fatalf(\"error %q misses literal %q\", err.Error(), fragment)\n329|\t}\n330|}\n331|\n332|// TestMemberCensusExactSets cross-checks the derived member set\n333|// against the sealed bytes: every derived member — reflected\n334|// inputs and derived envelope alike — is present in the sealed\n335|// shape, and the sealed shape carries no underived member. The\n336|// inventory test pins the exact per-shape counts, so sealed bloat\n337|// beyond the derivation reddens there.\n338|func TestMemberCensusExactSets(t *testing.T) {\n339|\tfor _, shape := range readBackCensusShapes(t) {\n340|\t\tt.Run(shape.label, func(t *testing.T) {\n341|\t\t\tdocument := decodeDocument(t, shape.seal(t))\n342|\t\t\tobject := shape.navigate(t, document)\n343|\t\t\tderived := map[string]bool{}\n344|\t\t\tfor _, member := range shape.members {\n345|\t\t\t\tderived[member.name] = true\n346|\t\t\t\tif _, present := object[member.name]; !present {\n347|\t\t\t\t\tt.Errorf(\"derived member %q missing from sealed %s\", member.name, shape.label)\n348|\t\t\t\t}\n349|\t\t\t}\n350|\t\t\tfor name := range object {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
