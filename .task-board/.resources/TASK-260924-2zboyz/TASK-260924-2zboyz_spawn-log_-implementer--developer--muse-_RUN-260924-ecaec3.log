{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5e7","stream":{"kind":"session","id":"01a0d4c8-c91a-7382-bd41-b29e82ff449b"},"sequence":334,"recorded_at":1780531400000663,"record_type":"event","durability":"durable","causation_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","run_stream":{"kind":"run","id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6"},"task_stream":{"kind":"task","id":"01a0d4c9-cee7-77f3-a631-a3d803ad0cf2"},"task_id":"01a0d4c9-cee7-77f3-a631-a3d803ad0cf2","event":{"kind":"output","task_id":"01a0d4c9-cee7-77f3-a631-a3d803ad0cf2","chunk":"Read text file `internal/clonereadback/report.go`.\n1|package clonereadback\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n9|)\n10|\n11|// This file validates and constructs Clone Validation Report\n12|// 1.0.0: the closed 22-member report Section 13.14.2 states,\n13|// aggregating both read-back manifests, the seven check booleans,\n14|// the Fidelity Report reference, findings, and the valid result.\n15|// The report carries the two validated reads as trusted siblings:\n16|// the staged and live references must name those reads in their\n17|// own slots, so the same digest in both slots, a swapped pair, or\n18|// a twice-named read refuses. Valid is decided, never carried:\n19|// valid=true if and only if every check boolean is true, the\n20|// native Session IDs match, and no finding carries error severity.\n21|// The report tuple cross-match against the read manifests'\n22|// observed tuples belongs to the final reconciliation leaf.\n23|\n24|const (\n25|\tvalidationSchema  = \"urn:ax:schema:clone-validation-report\"\n26|\tvalidationVersion = \"1.0.0\"\n27|\tvalidationSelf    = \"validation_report_id\"\n28|\tmaxReportFindings = 4096\n29|)\n30|\n31|var validationMembers = map[string]bool{\n32|\t\"schema\": true, \"schema_version\": true,\n33|\t\"validation_report_id\": true, \"operation_id\": true,\n34|\t\"projection_plan_id\":                    true,\n35|\t\"projected_object_manifest_id\":          true,\n36|\t\"staged_read_back_evidence_manifest_id\": true,\n37|\t\"live_read_back_evidence_manifest_id\":   true,\n38|\t\"target_provider_manifest_id\":           true,\n39|\t\"fidelity_report_id\":                    true,\n40|\t\"expected_target_native_session_id\":     true,\n41|\t\"observed_target_native_session_id\":     true,\n42|\t\"target_environment\":                    true,\n43|\t\"staged_structural_valid\":               true,\n44|\t\"live_structural_valid\":                 true,\n45|\t\"semantic_marker_valid\":                 true,\n46|\t\"identity_valid\":                        true,\n47|\t\"workspace_binding_valid\":               true,\n48|\t\"resume_surface_valid\":                  true,\n49|\t\"source_generation_revalidated\":         true,\n50|\t\"findings\":                              true,\n51|\t\"valid\":                                 true, \"extensions\": true,\n52|}\n53|\n54|var validationRequired = []string{\n55|\t\"schema\", \"schema_version\",\n56|\t\"validation_report_id\", \"operation_id\",\n57|\t\"projection_plan_id\",\n58|\t\"projected_object_manifest_id\",\n59|\t\"staged_read_back_evidence_manifest_id\",\n60|\t\"live_read_back_evidence_manifest_id\",\n61|\t\"target_provider_manifest_id\",\n62|\t\"fidelity_report_id\",\n63|\t\"expected_target_native_session_id\",\n64|\t\"observed_target_native_session_id\",\n65|\t\"target_environment\",\n66|\t\"staged_structural_valid\",\n67|\t\"live_structural_valid\",\n68|\t\"semantic_marker_valid\",\n69|\t\"identity_valid\",\n70|\t\"workspace_binding_valid\",\n71|\t\"resume_surface_valid\",\n72|\t\"source_generation_revalidated\",\n73|\t\"findings\",\n74|\t\"valid\", \"extensions\",\n75|}\n76|\n77|// ValidationChecks carries the seven check booleans the valid rule\n78|// conjoins. Every check is always applicable in this schema: unlike\n79|// the adapter validate body, the report has no nullable checks, so\n80|// the oracle enumerates outcomes over all seven with applicability\n81|// fixed.\n82|type ValidationChecks struct {\n83|\tStagedStructuralValid       bool\n84|\tLiveStructuralValid         bool\n85|\tSemanticMarkerValid         bool\n86|\tIdentityValid               bool\n87|\tWorkspaceBindingValid       bool\n88|\tResumeSurfaceValid          bool\n89|\tSourceGenerationRevalidated bool\n90|}\n91|\n92|// ValidationReport is one validated Clone Validation Report 1.0.0.\n93|type ValidationReport struct {\n94|\tReportID                    scalar.Digest\n95|\tOperationID                 scalar.UUIDv7\n96|\tProjectionPlanID            scalar.Digest\n97|\tProjectedObjectManifestID   scalar.Digest\n98|\tStagedManifestID            scalar.Digest\n99|\tLiveManifestID              scalar.Digest\n100|\tProviderManifestID          scalar.Digest\n101|\tFidelityReportID            scalar.Digest\n102|\tExpectedTargetNativeSession string\n103|\tObservedTargetNativeSession string\n104|\tTargetEnvironment           sessadapter.Tuple\n105|\tChecks                      ValidationChecks\n106|\tFindings                    []sessadapter.Finding\n107|\tValid                       bool\n108|}\n109|\n110|// ValidationReportInput is the caller-supplied validation report\n111|// candidate for Build. Nested closed shapes (target tuple,\n112|// findings) arrive as raw JSON and decode through their owners;\n113|// extensions arrive as a Go map and seal through the\n114|// closed-extensions owner.\n115|type ValidationReportInput struct {\n116|\tOperationID                      string\n117|\tProjectionPlanID                 string\n118|\tProjectedObjectManifestID        string\n119|\tStagedReadBackEvidenceManifestID string\n120|\tLiveReadBackEvidenceManifestID   string\n121|\tTargetProviderManifestID         string\n122|\tFidelityReportID                 string\n123|\tExpectedTargetNativeSession      string\n124|\tObservedTargetNativeSession      string\n125|\tTargetEnvironment                []byte\n126|\tStagedStructuralValid            bool\n127|\tLiveStructuralValid              bool\n128|\tSemanticMarkerValid              bool\n129|\tIdentityValid                    bool\n130|\tWorkspaceBindingValid            bool\n131|\tResumeSurfaceValid               bool\n132|\tSourceGenerationRevalidated      bool\n133|\tFindings                         []byte\n134|\tValid                            bool\n135|\tExtensions                       map[string]any\n136|}\n137|\n138|// decideValid computes the pinned valid rule: every check boolean\n139|// true, matching native IDs, and no error-severity finding. Both\n140|// entries share this single decider, so the rule cannot drift\n141|// between Build and Decode.\n142|func decideValid(checks ValidationChecks, expected, observed string, findings []sessadapter.Finding) bool {\n143|\tif !checks.StagedStructuralValid {\n144|\t\treturn false\n145|\t}\n146|\tif !checks.LiveStructuralValid {\n147|\t\treturn false\n148|\t}\n149|\tif !checks.SemanticMarkerValid {\n150|\t\treturn false\n151|\t}\n152|\tif !checks.IdentityValid {\n153|\t\treturn false\n154|\t}\n155|\tif !checks.WorkspaceBindingValid {\n156|\t\treturn false\n157|\t}\n158|\tif !checks.ResumeSurfaceValid {\n159|\t\treturn false\n160|\t}\n161|\tif !checks.SourceGenerationRevalidated {\n162|\t\treturn false\n163|\t}\n164|\tif expected != observed {\n165|\t\treturn false\n166|\t}\n167|\tfor _, finding := range findings {\n168|\t\tif finding.Severity == \"error\" {\n169|\t\t\treturn false\n170|\t\t}\n171|\t}\n172|\treturn true\n173|}\n174|\n175|// checkValidAgreement enforces that the carried valid bit equals the\n176|// decided rule: a report claiming valid=true with a failed check is\n177|// refused, and a report claiming valid=false with every check\n178|// passing is refused. Both entries share this gate.\n179|func checkValidAgreement(owner string, claimed bool, checks ValidationChecks, expected, observed string, findings []sessadapter.Finding) error {\n180|\tif claimed != decideValid(checks, expected, observed, findings) {\n181|\t\treturn invalid(\"%s valid disagrees with the check outcome\", owner)\n182|\t}\n183|\treturn nil\n184|}\n185|\n186|// checkReadRefs enforces that the report aggregates TWO distinct\n187|// reads: the staged sibling is a staged manifest, the live sibling\n188|// is a live manifest, the two reads are distinct documents, and\n189|// the carried references name those reads in their own slots. An\n190|// equal pair, a swapped pair, or a mismatched reference refuses.\n191|// Both report entries share this gate.\n192|func checkReadRefs(owner string, stagedClaim, liveClaim scalar.Digest, staged, live ReadBackManifest) error {\n193|\tif staged.ManifestID == live.ManifestID {\n194|\t\treturn invalid(\"%s staged and live read-back references are not distinct\", owner)\n195|\t}\n196|\tif staged.Mode != \"staged\" {\n197|\t\treturn invalid(\"%s staged read is not a staged manifest\", owner)\n198|\t}\n199|\tif live.Mode != \"live\" {\n200|\t\treturn invalid(\"%s live read is not a live manifest\", owner)\n201|\t}\n202|\tif stagedClaim != staged.ManifestID {\n203|\t\treturn invalid(\"%s staged_read_back_evidence_manifest_id does not match the staged read\", owner)\n204|\t}\n205|\tif liveClaim != live.ManifestID {\n206|\t\treturn invalid(\"%s live_read_back_evidence_manifest_id does not match the live read\", owner)\n207|\t}\n208|\treturn nil\n209|}\n210|\n211|// BuildValidationReport constructs one closed Clone Validation\n212|// Report 1.0.0 as canonical bytes. Identical inputs produce\n213|// byte-identical outputs. The staged and live siblings are the\n214|// validated reads the report aggregates; the carried references\n215|// must name them in their own slots. Every closed-shape, scalar,\n216|// finding, and validity rule is a refusal, never a repair.\n217|func BuildValidationReport(input ValidationReportInput, staged ReadBackManifest, live ReadBackManifest) ([]byte, error) {\n218|\t_, object, err := buildValidationReport(input, staged, live)\n219|\tif err != nil {\n220|\t\treturn nil, err\n221|\t}\n222|\tomitted, err := canonicalizeObject(object)\n223|\tif err != nil {\n224|\t\treturn nil, err\n225|\t}\n226|\treportID := scalar.SHA256Digest(omitted)\n227|\tobject[validationSelf] = reportID.String()\n228|\treturn canonicalizeObject(object)\n229|}\n230|\n231|func buildValidationReport(input ValidationReportInput, staged ReadBackManifest, live ReadBackManifest) (ValidationReport, map[string]any, error) {\n232|\towner := \"clone validation report\"\n233|\toperation, err := scalar.ParseUUIDv7(input.OperationID)\n234|\tif err != nil {\n235|\t\treturn ValidationReport{}, nil, invalid(\"%s operation_id is not a UUIDv7: %v\", owner, err)\n236|\t}\n237|\tplanID, err := scalar.ParseDigest(input.ProjectionPlanID)\n238|\tif err != nil {\n239|\t\treturn ValidationReport{}, nil, invalid(\"%s projection_plan_id is not a digest: %v\", owner, err)\n240|\t}\n241|\tprojectedID, err := scalar.ParseDigest(input.ProjectedObjectManifestID)\n242|\tif err != nil {\n243|\t\treturn ValidationReport{}, nil, invalid(\"%s projected_object_manifest_id is not a digest: %v\", owner, err)\n244|\t}\n245|\tstagedID, err := scalar.ParseDigest(input.StagedReadBackEvidenceManifestID)\n246|\tif err != nil {\n247|\t\treturn ValidationReport{}, nil, invalid(\"%s staged_read_back_evidence_manifest_id is not a digest: %v\", owner, err)\n248|\t}\n249|\tliveID, err := scalar.ParseDigest(input.LiveReadBackEvidenceManifestID)\n250|\tif err != nil {\n251|\t\treturn ValidationReport{}, nil, invalid(\"%s live_read_back_evidence_manifest_id is not a digest: %v\", owner, err)\n252|\t}\n253|\tif err := checkReadRefs(owner, stagedID, liveID, staged, live); err != nil {\n254|\t\treturn ValidationReport{}, nil, err\n255|\t}\n256|\tproviderID, err := scalar.ParseDigest(input.TargetProviderManifestID)\n257|\tif err != nil {\n258|\t\treturn ValidationReport{}, nil, invalid(\"%s target_provider_manifest_id is not a digest: %v\", owner, err)\n259|\t}\n260|\tfidelityID, err := scalar.ParseDigest(input.FidelityReportID)\n261|\tif err != nil {\n262|\t\treturn ValidationReport{}, nil, invalid(\"%s fidelity_report_id is not a digest: %v\", owner, err)\n263|\t}\n264|\tif !validText(input.ExpectedTargetNativeSession) {\n265|\t\treturn ValidationReport{}, nil, invalid(\"%s expected_target_native_session_id is not valid UTF-8\", owner)\n266|\t}\n267|\tif length := stringLength(input.ExpectedTargetNativeSession); length < 1 || length > 512 {\n268|\t\treturn ValidationReport{}, nil, invalid(\"%s expected_target_native_session_id is not a string[1..512]\", owner)\n269|\t}\n270|\tif !validText(input.ObservedTargetNativeSession) {\n271|\t\treturn ValidationReport{}, nil, invalid(\"%s observed_target_native_session_id is not valid UTF-8\", owner)\n272|\t}\n273|\tif length := stringLength(input.ObservedTargetNativeSession); length < 1 || length > 512 {\n274|\t\treturn ValidationReport{}, nil, invalid(\"%s observed_target_native_session_id is not a string[1..512]\", owner)\n275|\t}\n276|\ttargetTuple, err := sessadapter.DecodeTuple(json.RawMessage(input.TargetEnvironment))\n277|\tif err != nil {\n278|\t\treturn ValidationReport{}, nil, invalid(\"%s target_environment is not an Environment Tuple: %v\", owner, err)\n279|\t}\n280|\tchecks := ValidationChecks{\n281|\t\tStagedStructuralValid:       input.StagedStructuralValid,\n282|\t\tLiveStructuralValid:         input.LiveStructuralValid,\n283|\t\tSemanticMarkerValid:         input.SemanticMarkerValid,\n284|\t\tIdentityValid:               input.IdentityValid,\n285|\t\tWorkspaceBindingValid:       input.WorkspaceBindingValid,\n286|\t\tResumeSurfaceValid:          input.ResumeSurfaceValid,\n287|\t\tSourceGenerationRevalidated: input.SourceGenerationRevalidated,\n288|\t}\n289|\tfindings, err := sessadapter.DecodeFindings(json.RawMessage(input.Findings), maxReportFindings)\n290|\tif err != nil {\n291|\t\treturn ValidationReport{}, nil, invalid(\"%s findings are not AdapterFinding[0..4096]: %v\", owner, err)\n292|\t}\n293|\tif err := checkValidAgreement(owner, input.Valid, checks, input.ExpectedTargetNativeSession, input.ObservedTargetNativeSession, findings); err != nil {\n294|\t\treturn ValidationReport{}, nil, err\n295|\t}\n296|\textensions, err := clonebundle.EncodeExtensions(input.Extensions)\n297|\tif err != nil {\n298|\t\treturn ValidationReport{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n299|\t}\n300|\tvar extensionsValue any\n301|\tif err := json.Unmarshal(extensions, &extensionsValue); err != nil {\n302|\t\treturn ValidationReport{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n303|\t}\n304|\treport := ValidationReport{\n305|\t\tOperationID:                 operation,\n306|\t\tProjectionPlanID:            planID,\n307|\t\tProjectedObjectManifestID:   projectedID,\n308|\t\tStagedManifestID:            stagedID,\n309|\t\tLiveManifestID:              liveID,\n310|\t\tProviderManifestID:          providerID,\n311|\t\tFidelityReportID:            fidelityID,\n312|\t\tExpectedTargetNativeSession: input.ExpectedTargetNativeSession,\n313|\t\tObservedTargetNativeSession: input.ObservedTargetNativeSession,\n314|\t\tTargetEnvironment:           targetTuple,\n315|\t\tChecks:                      checks,\n316|\t\tFindings:                    findings,\n317|\t\tValid:                       input.Valid,\n318|\t}\n319|\tobject := map[string]any{\n320|\t\t\"schema\":                                validationSchema,\n321|\t\t\"schema_version\":                        validationVersion,\n322|\t\t\"operation_id\":                          operation.String(),\n323|\t\t\"projection_plan_id\":                    planID.String(),\n324|\t\t\"projected_object_manifest_id\":          projectedID.String(),\n325|\t\t\"staged_read_back_evidence_manifest_id\": stagedID.String(),\n326|\t\t\"live_read_back_evidence_manifest_id\":   liveID.String(),\n327|\t\t\"target_provider_manifest_id\":           providerID.String(),\n328|\t\t\"fidelity_report_id\":                    fidelityID.String(),\n329|\t\t\"expected_target_native_session_id\":     input.ExpectedTargetNativeSession,\n330|\t\t\"observed_target_native_session_id\":     input.ObservedTargetNativeSession,\n331|\t\t\"staged_structural_valid\":               input.StagedStructuralValid,\n332|\t\t\"live_structural_valid\":                 input.LiveStructuralValid,\n333|\t\t\"semantic_marker_valid\":                 input.SemanticMarkerValid,\n334|\t\t\"identity_valid\":                        input.IdentityValid,\n335|\t\t\"workspace_binding_valid\":               input.WorkspaceBindingValid,\n336|\t\t\"resume_surface_valid\":                  input.ResumeSurfaceValid,\n337|\t\t\"source_generation_revalidated\":         input.SourceGenerationRevalidated,\n338|\t\t\"valid\":                                 input.Valid,\n339|\t\t\"extensions\":                            extensionsValue,\n340|\t}\n341|\tvar tupleValue any\n342|\tif err := json.Unmarshal(input.TargetEnvironment, &tupleValue); err != nil {\n343|\t\treturn ValidationReport{}, nil, invalid(\"%s target_environment invalid: %v\", owner, err)\n344|\t}\n345|\tobject[\"target_environment\"] = tupleValue\n346|\tvar findingsValue any\n347|\tif err := json.Unmarshal(input.Findings, &findingsValue); err != nil {\n348|\t\treturn ValidationReport{}, nil, invalid(\"%s findings invalid: %v\", owner, err)\n349|\t}\n350|\tobject[\"findings\"] = findingsValue\n351|\treturn report, object, nil\n352|}\n353|\n354|// DecodeValidationReport validates one closed Clone Validation\n355|// Report 1.0.0: exact members, literal schema/version, read\n356|// references bound to the two trusted sibling reads,\n357|// owner-decoded tuple and findings, the decided valid bit, and the\n358|// omit-self identity.\n359|func DecodeValidationReport(data []byte, staged ReadBackManifest, live ReadBackManifest) (ValidationReport, error) {\n360|\towner := \"clone validation report\"\n361|\tmembers, fault := decodeStrictObject(data)\n362|\tif fault != nil {\n363|\t\treturn ValidationReport{}, invalid(\"%s %s (%s)\", owner, fault.detail, memberField(fault.member))\n364|\t}\n365|\tif name, unknown := unknownMember(members, validationMembers); unknown {\n366|\t\treturn ValidationReport{}, invalid(\"%s carries unknown member %q\", owner, name)\n367|\t}\n368|\tif name, missing := missingMember(members, validationRequired); missing {\n369|\t\treturn ValidationReport{}, invalid(\"%s misses a required member %q\", owner, name)\n370|\t}\n371|\tschema, ok := rawString(members[\"schema\"])\n372|\tif !ok || schema != validationSchema {\n373|\t\treturn ValidationReport{}, invalid(\"%s schema is not urn:ax:schema:clone-validation-report\", owner)\n374|\t}\n375|\tversion, ok := rawString(members[\"schema_version\"])\n376|\tif !ok || version != validationVersion {\n377|\t\treturn ValidationReport{}, invalid(\"%s schema_version is not 1.0.0\", owner)\n378|\t}\n379|\tclaimed, ok := checkDigest(members[validationSelf])\n380|\tif !ok {\n381|\t\treturn ValidationReport{}, invalid(\"%s validation_report_id is not a digest\", owner)\n382|\t}\n383|\toperation, ok := checkUUIDv7(members[\"operation_id\"])\n384|\tif !ok {\n385|\t\treturn ValidationReport{}, invalid(\"%s operation_id is not a UUIDv7\", owner)\n386|\t}\n387|\tplanID, ok := checkDigest(members[\"projection_plan_id\"])\n388|\tif !ok {\n389|\t\treturn ValidationReport{}, invalid(\"%s projection_plan_id is not a digest\", owner)\n390|\t}\n391|\tprojectedID, ok := checkDigest(members[\"projected_object_manifest_id\"])\n392|\tif !ok {\n393|\t\treturn ValidationReport{}, invalid(\"%s projected_object_manifest_id is not a digest\", owner)\n394|\t}\n395|\tstagedID, ok := checkDigest(members[\"staged_read_back_evidence_manifest_id\"])\n396|\tif !ok {\n397|\t\treturn ValidationReport{}, invalid(\"%s staged_read_back_evidence_manifest_id is not a digest\", owner)\n398|\t}\n399|\tliveID, ok := checkDigest(members[\"live_read_back_evidence_manifest_id\"])\n400|\tif !ok {\n401|\t\treturn ValidationReport{}, invalid(\"%s live_read_back_evidence_manifest_id is not a digest\", owner)\n402|\t}\n403|\tif err := checkReadRefs(owner, stagedID, liveID, staged, live); err != nil {\n404|\t\treturn ValidationReport{}, err\n405|\t}\n406|\tproviderID, ok := checkDigest(members[\"target_provider_manifest_id\"])\n407|\tif !ok {\n408|\t\treturn ValidationReport{}, invalid(\"%s target_provider_manifest_id is not a digest\", owner)\n409|\t}\n410|\tfidelityID, ok := checkDigest(members[\"fidelity_report_id\"])\n411|\tif !ok {\n412|\t\treturn ValidationReport{}, invalid(\"%s fidelity_report_id is not a digest\", owner)\n413|\t}\n414|\texpected, ok := checkStringBounds(members[\"expected_target_native_session_id\"], 1, 512)\n415|\tif !ok {\n416|\t\treturn ValidationReport{}, invalid(\"%s expected_target_native_session_id is not a string[1..512]\", owner)\n417|\t}\n418|\tobserved, ok := checkStringBounds(members[\"observed_target_native_session_id\"], 1, 512)\n419|\tif !ok {\n420|\t\treturn ValidationReport{}, invalid(\"%s observed_target_native_session_id is not a string[1..512]\", owner)\n421|\t}\n422|\ttargetTuple, err := sessadapter.DecodeTuple(members[\"target_environment\"])\n423|\tif err != nil {\n424|\t\treturn ValidationReport{}, invalid(\"%s target_environment is not an Environment Tuple: %v\", owner, err)\n425|\t}\n426|\tchecks, err := decodeValidationChecks(members)\n427|\tif err != nil {\n428|\t\treturn ValidationReport{}, err\n429|\t}\n430|\tfindings, err := sessadapter.DecodeFindings(members[\"findings\"], maxReportFindings)\n431|\tif err != nil {\n432|\t\treturn ValidationReport{}, invalid(\"%s findings are not AdapterFinding[0..4096]: %v\", owner, err)\n433|\t}\n434|\tvalid, ok := rawBool(members[\"valid\"])\n435|\tif !ok {\n436|\t\treturn ValidationReport{}, invalid(\"%s valid is not a boolean\", owner)\n437|\t}\n438|\tif err := checkValidAgreement(owner, valid, checks, expected, observed, findings); err != nil {\n439|\t\treturn ValidationReport{}, err\n440|\t}\n441|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n442|\t\treturn ValidationReport{}, invalid(\"%s extensions %s\", owner, extensionsFault)\n443|\t}\n444|\tif err := verifySelfDigest(members, validationSelf, claimed); err != nil {\n445|\t\treturn ValidationReport{}, err\n446|\t}\n447|\treturn ValidationReport{\n448|\t\tReportID:                    claimed,\n449|\t\tOperationID:                 operation,\n450|\t\tProjectionPlanID:            planID,\n451|\t\tProjectedObjectManifestID:   projectedID,\n452|\t\tStagedManifestID:            stagedID,\n453|\t\tLiveManifestID:              liveID,\n454|\t\tProviderManifestID:          providerID,\n455|\t\tFidelityReportID:            fidelityID,\n456|\t\tExpectedTargetNativeSession: expected,\n457|\t\tObservedTargetNativeSession: observed,\n458|\t\tTargetEnvironment:           targetTuple,\n459|\t\tChecks:                      checks,\n460|\t\tFindings:                    findings,\n461|\t\tValid:                       valid,\n462|\t}, nil\n463|}\n464|\n465|// decodeValidationChecks reads the seven check booleans. Each member\n466|// is required non-null; null is a wrong type, never false.\n467|func decodeValidationChecks(members map[string]json.RawMessage) (ValidationChecks, error) {\n468|\towner := \"clone validation report\"\n469|\tread := func(member string) (bool, error) {\n470|\t\tvalue, ok := rawBool(members[member])\n471|\t\tif !ok {\n472|\t\t\treturn false, invalid(\"%s %s is not a boolean\", owner, member)\n473|\t\t}\n474|\t\treturn value, nil\n475|\t}\n476|\tstaged, err := read(\"staged_structural_valid\")\n477|\tif err != nil {\n478|\t\treturn ValidationChecks{}, err\n479|\t}\n480|\tlive, err := read(\"live_structural_valid\")\n481|\tif err != nil {\n482|\t\treturn ValidationChecks{}, err\n483|\t}\n484|\tmarker, err := read(\"semantic_marker_valid\")\n485|\tif err != nil {\n486|\t\treturn ValidationChecks{}, err\n487|\t}\n488|\tidentity, err := read(\"identity_valid\")\n489|\tif err != nil {\n490|\t\treturn ValidationChecks{}, err\n491|\t}\n492|\tbinding, err := read(\"workspace_binding_valid\")\n493|\tif err != nil {\n494|\t\treturn ValidationChecks{}, err\n495|\t}\n496|\tresume, err := read(\"resume_surface_valid\")\n497|\tif err != nil {\n498|\t\treturn ValidationChecks{}, err\n499|\t}\n500|\tgeneration, err := read(\"source_generation_revalidated\")\n501|\tif err != nil {\n502|\t\treturn ValidationChecks{}, err\n503|\t}\n504|\treturn ValidationChecks{\n505|\t\tStagedStructuralValid:       staged,\n506|\t\tLiveStructuralValid:         live,\n507|\t\tSemanticMarkerValid:         marker,\n508|\t\tIdentityValid:               identity,\n509|\t\tWorkspaceBindingValid:       binding,\n510|\t\tResumeSurfaceValid:          resume,\n511|\t\tSourceGenerationRevalidated: generation,\n512|\t}, nil\n513|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5e9","stream":{"kind":"session","id":"01a0d4c8-c91a-7382-bd41-b29e82ff449b"},"sequence":335,"recorded_at":1780531400000665,"record_type":"event","durability":"durable","causation_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","run_stream":{"kind":"run","id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6"},"task_stream":{"kind":"task","id":"01a0d4c9-cee7-77f3-a631-a3d803ad0cf2"},"task_id":"01a0d4c9-cee7-77f3-a631-a3d803ad0cf2","event":{"kind":"completed","task_id":"01a0d4c9-cee7-77f3-a631-a3d803ad0cf2"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5eb","stream":{"kind":"session","id":"01a0d4c8-c91a-7382-bd41-b29e82ff449b"},"sequence":336,"recorded_at":1780531400000667,"record_type":"event","durability":"durable","causation_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6","run_stream":{"kind":"run","id":"297f9a28-ff2a-4f3d-8e2c-f78b2b2814d6"},"call_id":"call_01a0d4c9cb8673ada366b29c8190b070","text":"Read text file `internal/clonereadback/report.go`.\n1|package clonereadback\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n9|)\n10|\n11|// This file validates and constructs Clone Validation Report\n12|// 1.0.0: the closed 22-member report Section 13.14.2 states,\n13|// aggregating both read-back manifests, the seven check booleans,\n14|// the Fidelity Report reference, findings, and the valid result.\n15|// The report carries the two validated reads as trusted siblings:\n16|// the staged and live references must name those reads in their\n17|// own slots, so the same digest in both slots, a swapped pair, or\n18|// a twice-named read refuses. Valid is decided, never carried:\n19|// valid=true if and only if every check boolean is true, the\n20|// native Session IDs match, and no finding carries error severity.\n21|// The report tuple cross-match against the read manifests'\n22|// observed tuples belongs to the final reconciliation leaf.\n23|\n24|const (\n25|\tvalidationSchema  = \"urn:ax:schema:clone-validation-report\"\n26|\tvalidationVersion = \"1.0.0\"\n27|\tvalidationSelf    = \"validation_report_id\"\n28|\tmaxReportFindings = 4096\n29|)\n30|\n31|var validationMembers = map[string]bool{\n32|\t\"schema\": true, \"schema_version\": true,\n33|\t\"validation_report_id\": true, \"operation_id\": true,\n34|\t\"projection_plan_id\":                    true,\n35|\t\"projected_object_manifest_id\":          true,\n36|\t\"staged_read_back_evidence_manifest_id\": true,\n37|\t\"live_read_back_evidence_manifest_id\":   true,\n38|\t\"target_provider_manifest_id\":           true,\n39|\t\"fidelity_report_id\":                    true,\n40|\t\"expected_target_native_session_id\":     true,\n41|\t\"observed_target_native_session_id\":     true,\n42|\t\"target_environment\":                    true,\n43|\t\"staged_structural_valid\":               true,\n44|\t\"live_structural_valid\":                 true,\n45|\t\"semantic_marker_valid\":                 true,\n46|\t\"identity_valid\":                        true,\n47|\t\"workspace_binding_valid\":               true,\n48|\t\"resume_surface_valid\":                  true,\n49|\t\"source_generation_revalidated\":         true,\n50|\t\"findings\":                              true,\n51|\t\"valid\":                                 true, \"extensions\": true,\n52|}\n53|\n54|var validationRequired = []string{\n55|\t\"schema\", \"schema_version\",\n56|\t\"validation_report_id\", \"operation_id\",\n57|\t\"projection_plan_id\",\n58|\t\"projected_object_manifest_id\",\n59|\t\"staged_read_back_evidence_manifest_id\",\n60|\t\"live_read_back_evidence_manifest_id\",\n61|\t\"target_provider_manifest_id\",\n62|\t\"fidelity_report_id\",\n63|\t\"expected_target_native_session_id\",\n64|\t\"observed_target_native_session_id\",\n65|\t\"target_environment\",\n66|\t\"staged_structural_valid\",\n67|\t\"live_structural_valid\",\n68|\t\"semantic_marker_valid\",\n69|\t\"identity_valid\",\n70|\t\"workspace_binding_valid\",\n71|\t\"resume_surface_valid\",\n72|\t\"source_generation_revalidated\",\n73|\t\"findings\",\n74|\t\"valid\", \"extensions\",\n75|}\n76|\n77|// ValidationChecks carries the seven check booleans the valid rule\n78|// conjoins. Every check is always applicable in this schema: unlike\n79|// the adapter validate body, the report has no nullable checks, so\n80|// the oracle enumerates outcomes over all seven with applicability\n81|// fixed.\n82|type ValidationChecks struct {\n83|\tStagedStructuralValid       bool\n84|\tLiveStructuralValid         bool\n85|\tSemanticMarkerValid         bool\n86|\tIdentityValid               bool\n87|\tWorkspaceBindingValid       bool\n88|\tResumeSurfaceValid          bool\n89|\tSourceGenerationRevalidated bool\n90|}\n91|\n92|// ValidationReport is one validated Clone Validation Report 1.0.0.\n93|type ValidationReport struct {\n94|\tReportID                    scalar.Digest\n95|\tOperationID                 scalar.UUIDv7\n96|\tProjectionPlanID            scalar.Digest\n97|\tProjectedObjectManifestID   scalar.Digest\n98|\tStagedManifestID            scalar.Digest\n99|\tLiveManifestID              scalar.Digest\n100|\tProviderManifestID          scalar.Digest\n101|\tFidelityReportID            scalar.Digest\n102|\tExpectedTargetNativeSession string\n103|\tObservedTargetNativeSession string\n104|\tTargetEnvironment           sessadapter.Tuple\n105|\tChecks                      ValidationChecks\n106|\tFindings                    []sessadapter.Finding\n107|\tValid                       bool\n108|}\n109|\n110|// ValidationReportInput is the caller-supplied validation report\n111|// candidate for Build. Nested closed shapes (target tuple,\n112|// findings) arrive as raw JSON and decode through their owners;\n113|// extensions arrive as a Go map and seal through the\n114|// closed-extensions owner.\n115|type ValidationReportInput struct {\n116|\tOperationID                      string\n117|\tProjectionPlanID                 string\n118|\tProjectedObjectManifestID        string\n119|\tStagedReadBackEvidenceManifestID string\n120|\tLiveReadBackEvidenceManifestID   string\n121|\tTargetProviderManifestID         string\n122|\tFidelityReportID                 string\n123|\tExpectedTargetNativeSession      string\n124|\tObservedTargetNativeSession      string\n125|\tTargetEnvironment                []byte\n126|\tStagedStructuralValid            bool\n127|\tLiveStructuralValid              bool\n128|\tSemanticMarkerValid              bool\n129|\tIdentityValid                    bool\n130|\tWorkspaceBindingValid            bool\n131|\tResumeSurfaceValid               bool\n132|\tSourceGenerationRevalidated      bool\n133|\tFindings                         []byte\n134|\tValid                            bool\n135|\tExtensions                       map[string]any\n136|}\n137|\n138|// decideValid computes the pinned valid rule: every check boolean\n139|// true, matching native IDs, and no error-severity finding. Both\n140|// entries share this single decider, so the rule cannot drift\n141|// between Build and Decode.\n142|func decideValid(checks ValidationChecks, expected, observed string, findings []sessadapter.Finding) bool {\n143|\tif !checks.StagedStructuralValid {\n144|\t\treturn false\n145|\t}\n146|\tif !checks.LiveStructuralValid {\n147|\t\treturn false\n148|\t}\n149|\tif !checks.SemanticMarkerValid {\n150|\t\treturn false\n151|\t}\n152|\tif !checks.IdentityValid {\n153|\t\treturn false\n154|\t}\n155|\tif !checks.WorkspaceBindingValid {\n156|\t\treturn false\n157|\t}\n158|\tif !checks.ResumeSurfaceValid {\n159|\t\treturn false\n160|\t}\n161|\tif !checks.SourceGenerationRevalidated {\n162|\t\treturn false\n163|\t}\n164|\tif expected != observed {\n165|\t\treturn false\n166|\t}\n167|\tfor _, finding := range findings {\n168|\t\tif finding.Severity == \"error\" {\n169|\t\t\treturn false\n170|\t\t}\n171|\t}\n172|\treturn true\n173|}\n174|\n175|// checkValidAgreement enforces that the carried valid bit equals the\n176|// decided rule: a report claiming valid=true with a failed check is\n177|// refused, and a report claiming valid=false with every check\n178|// passing is refused. Both entries share this gate.\n179|func checkValidAgreement(owner string, claimed bool, checks ValidationChecks, expected, observed string, findings []sessadapter.Finding) error {\n180|\tif claimed != decideValid(checks, expected, observed, findings) {\n181|\t\treturn invalid(\"%s valid disagrees with the check outcome\", owner)\n182|\t}\n183|\treturn nil\n184|}\n185|\n186|// checkReadRefs enforces that the report aggregates TWO distinct\n187|// reads: the staged sibling is a staged manifest, the live sibling\n188|// is a live manifest, the two reads are distinct documents, and\n189|// the carried references name those reads in their own slots. An\n190|// equal pair, a swapped pair, or a mismatched reference refuses.\n191|// Both report entries share this gate.\n192|func checkReadRefs(owner string, stagedClaim, liveClaim scalar.Digest, staged, live ReadBackManifest) error {\n193|\tif staged.ManifestID == live.ManifestID {\n194|\t\treturn invalid(\"%s staged and live read-back references are not distinct\", owner)\n195|\t}\n196|\tif staged.Mode != \"staged\" {\n197|\t\treturn invalid(\"%s staged read is not a staged manifest\", owner)\n198|\t}\n199|\tif live.Mode != \"live\" {\n200|\t\treturn invalid(\"%s live read is not a live manifest\", owner)\n201|\t}\n202|\tif stagedClaim != staged.ManifestID {\n203|\t\treturn invalid(\"%s staged_read_back_evidence_manifest_id does not match the staged read\", owner)\n204|\t}\n205|\tif liveClaim != live.ManifestID {\n206|\t\treturn invalid(\"%s live_read_back_evidence_manifest_id does not match the live read\", owner)\n207|\t}\n208|\treturn nil\n209|}\n210|\n211|// BuildValidationReport constructs one closed Clone Validation\n212|// Report 1.0.0 as canonical bytes. Identical inputs produce\n213|// byte-identical outputs. The staged and live siblings are the\n214|// validated reads the report aggregates; the carried references\n215|// must name them in their own slots. Every closed-shape, scalar,\n216|// finding, and validity rule is a refusal, never a repair.\n217|func BuildValidationReport(input ValidationReportInput, staged ReadBackManifest, live ReadBackManifest) ([]byte, error) {\n218|\t_, object, err := buildValidationReport(input, staged, live)\n219|\tif err != nil {\n220|\t\treturn nil, err\n221|\t}\n222|\tomitted, err := canonicalizeObject(object)\n223|\tif err != nil {\n224|\t\treturn nil, err\n225|\t}\n226|\treportID := scalar.SHA256Digest(omitted)\n227|\tobject[validationSelf] = reportID.String()\n228|\treturn canonicalizeObject(object)\n229|}\n230|\n231|func buildValidationReport(input ValidationReportInput, staged ReadBackManifest, live ReadBackManifest) (ValidationReport, map[string]any, error) {\n232|\towner := \"clone validation report\"\n233|\toperation, err := scalar.ParseUUIDv7(input.OperationID)\n234|\tif err != nil {\n235|\t\treturn ValidationReport{}, nil, invalid(\"%s operation_id is not a UUIDv7: %v\", owner, err)\n236|\t}\n237|\tplanID, err := scalar.ParseDigest(input.ProjectionPlanID)\n238|\tif err != nil {\n239|\t\treturn ValidationReport{}, nil, invalid(\"%s projection_plan_id is not a digest: %v\", owner, err)\n240|\t}\n241|\tprojectedID, err := scalar.ParseDigest(input.ProjectedObjectManifestID)\n242|\tif err != nil {\n243|\t\treturn ValidationReport{}, nil, invalid(\"%s projected_object_manifest_id is not a digest: %v\", owner, err)\n244|\t}\n245|\tstagedID, err := scalar.ParseDigest(input.StagedReadBackEvidenceManifestID)\n246|\tif err != nil {\n247|\t\treturn ValidationReport{}, nil, invalid(\"%s staged_read_back_evidence_manifest_id is not a digest: %v\", owner, err)\n248|\t}\n249|\tliveID, err := scalar.ParseDigest(input.LiveReadBackEvidenceManifestID)\n250|\tif err != nil {\n251|\t\treturn ValidationReport{}, nil, invalid(\"%s live_read_back_evidence_manifest_id is not a digest: %v\", owner, err)\n252|\t}\n253|\tif err := checkReadRefs(owner, stagedID, liveID, staged, live); err != nil {\n254|\t\treturn ValidationReport{}, nil, err\n255|\t}\n256|\tproviderID, err := scalar.ParseDigest(input.TargetProviderManifestID)\n257|\tif err != nil {\n258|\t\treturn ValidationReport{}, nil, invalid(\"%s target_provider_manifest_id is not a digest: %v\", owner, err)\n259|\t}\n260|\tfidelityID, err := scalar.ParseDigest(input.FidelityReportID)\n261|\tif err != nil {\n262|\t\treturn ValidationReport{}, nil, invalid(\"%s fidelity_report_id is not a digest: %v\", owner, err)\n263|\t}\n264|\tif !validText(input.ExpectedTargetNativeSession) {\n265|\t\treturn ValidationReport{}, nil, invalid(\"%s expected_target_native_session_id is not valid UTF-8\", owner)\n266|\t}\n267|\tif length := stringLength(input.ExpectedTargetNativeSession); length < 1 || length > 512 {\n268|\t\treturn ValidationReport{}, nil, invalid(\"%s expected_target_native_session_id is not a string[1..512]\", owner)\n269|\t}\n270|\tif !validText(input.ObservedTargetNativeSession) {\n271|\t\treturn ValidationReport{}, nil, invalid(\"%s observed_target_native_session_id is not valid UTF-8\", owner)\n272|\t}\n273|\tif length := stringLength(input.ObservedTargetNativeSession); length < 1 || length > 512 {\n274|\t\treturn ValidationReport{}, nil, invalid(\"%s observed_target_native_session_id is not a string[1..512]\", owner)\n275|\t}\n276|\ttargetTuple, err := sessadapter.DecodeTuple(json.RawMessage(input.TargetEnvironment))\n277|\tif err != nil {\n278|\t\treturn ValidationReport{}, nil, invalid(\"%s target_environment is not an Environment Tuple: %v\", owner, err)\n279|\t}\n280|\tchecks := ValidationChecks{\n281|\t\tStagedStructuralValid:       input.StagedStructuralValid,\n282|\t\tLiveStructuralValid:         input.LiveStructuralValid,\n283|\t\tSemanticMarkerValid:         input.SemanticMarkerValid,\n284|\t\tIdentityValid:               input.IdentityValid,\n285|\t\tWorkspaceBindingValid:       input.WorkspaceBindingValid,\n286|\t\tResumeSurfaceValid:          input.ResumeSurfaceValid,\n287|\t\tSourceGenerationRevalidated: input.SourceGenerationRevalidated,\n288|\t}\n289|\tfindings, err := sessadapter.DecodeFindings(json.RawMessage(input.Findings), maxReportFindings)\n290|\tif err != nil {\n291|\t\treturn ValidationReport{}, nil, invalid(\"%s findings are not AdapterFinding[0..4096]: %v\", owner, err)\n292|\t}\n293|\tif err := checkValidAgreement(owner, input.Valid, checks, input.ExpectedTargetNativeSession, input.ObservedTargetNativeSession, findings); err != nil {\n294|\t\treturn ValidationReport{}, nil, err\n295|\t}\n296|\textensions, err := clonebundle.EncodeExtensions(input.Extensions)\n297|\tif err != nil {\n298|\t\treturn ValidationReport{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n299|\t}\n300|\tvar extensionsValue any\n301|\tif err := json.Unmarshal(extensions, &extensionsValue); err != nil {\n302|\t\treturn ValidationReport{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n303|\t}\n304|\treport := ValidationReport{\n305|\t\tOperationID:                 operation,\n306|\t\tProjectionPlanID:            planID,\n307|\t\tProjectedObjectManifestID:   projectedID,\n308|\t\tStagedManifestID:            stagedID,\n309|\t\tLiveManifestID:              liveID,\n310|\t\tProviderManifestID:          providerID,\n311|\t\tFidelityReportID:            fidelityID,\n312|\t\tExpectedTargetNativeSession: input.ExpectedTargetNativeSession,\n313|\t\tObservedTargetNativeSession: input.ObservedTargetNativeSession,\n314|\t\tTargetEnvironment:           targetTuple,\n315|\t\tChecks:                      checks,\n316|\t\tFindings:                    findings,\n317|\t\tValid:                       input.Valid,\n318|\t}\n319|\tobject := map[string]any{\n320|\t\t\"schema\":                                validationSchema,\n321|\t\t\"schema_version\":                        validationVersion,\n322|\t\t\"operation_id\":                          operation.String(),\n323|\t\t\"projection_plan_id\":                    planID.String(),\n324|\t\t\"projected_object_manifest_id\":          projectedID.String(),\n325|\t\t\"staged_read_back_evidence_manifest_id\": stagedID.String(),\n326|\t\t\"live_read_back_evidence_manifest_id\":   liveID.String(),\n327|\t\t\"target_provider_manifest_id\":           providerID.String(),\n328|\t\t\"fidelity_report_id\":                    fidelityID.String(),\n329|\t\t\"expected_target_native_session_id\":     input.ExpectedTargetNativeSession,\n330|\t\t\"observed_target_native_session_id\":     input.ObservedTargetNativeSession,\n331|\t\t\"staged_structural_valid\":               input.StagedStructuralValid,\n332|\t\t\"live_structural_valid\":                 input.LiveStructuralValid,\n333|\t\t\"semantic_marker_valid\":                 input.SemanticMarkerValid,\n334|\t\t\"identity_valid\":                        input.IdentityValid,\n335|\t\t\"workspace_binding_valid\":               input.WorkspaceBindingValid,\n336|\t\t\"resume_surface_valid\":                  input.ResumeSurfaceValid,\n337|\t\t\"source_generation_revalidated\":         input.SourceGenerationRevalidated,\n338|\t\t\"valid\":                                 input.Valid,\n339|\t\t\"extensions\":                            extensionsValue,\n340|\t}\n341|\tvar tupleValue any\n342|\tif err := json.Unmarshal(input.TargetEnvironment, &tupleValue); err != nil {\n343|\t\treturn ValidationReport{}, nil, invalid(\"%s target_environment invalid: %v\", owner, err)\n344|\t}\n345|\tobject[\"target_environment\"] = tupleValue\n346|\tvar findingsValue any\n347|\tif err := json.Unmarshal(input.Findings, &findingsValue); err != nil {\n348|\t\treturn ValidationReport{}, nil, invalid(\"%s findings invalid: %v\", owner, err)\n349|\t}\n350|\tobject[\"findings\"] = findingsValue\n351|\treturn report, object, nil\n352|}\n353|\n354|// DecodeValidationReport validates one closed Clone Validation\n355|// Report 1.0.0: exact members, literal schema/version, read\n356|// references bound to the two trusted sibling reads,\n357|// owner-decoded tuple and findings, the decided valid bit, and the\n358|// omit-self identity.\n359|func DecodeValidationReport(data []byte, staged ReadBackManifest, live ReadBackManifest) (ValidationReport, error) {\n360|\towner := \"clone validation report\"\n361|\tmembers, fault := decodeStrictObject(data)\n362|\tif fault != nil {\n363|\t\treturn ValidationReport{}, invalid(\"%s %s (%s)\", owner, fault.detail, memberField(fault.member))\n364|\t}\n365|\tif name, unknown := unknownMember(members, validationMembers); unknown {\n366|\t\treturn ValidationReport{}, invalid(\"%s carries unknown member %q\", owner, name)\n367|\t}\n368|\tif name, missing := missingMember(members, validationRequired); missing {\n369|\t\treturn ValidationReport{}, invalid(\"%s misses a required member %q\", owner, name)\n370|\t}\n371|\tschema, ok := rawString(members[\"schema\"])\n372|\tif !ok || schema != validationSchema {\n373|\t\treturn ValidationReport{}, invalid(\"%s schema is not urn:ax:schema:clone-validation-report\", owner)\n374|\t}\n375|\tversion, ok := rawString(members[\"schema_version\"])\n376|\tif !ok || version != validationVersion {\n377|\t\treturn ValidationReport{}, invalid(\"%s schema_version is not 1.0.0\", owner)\n378|\t}\n379|\tclaimed, ok := checkDigest(members[validationSelf])\n380|\tif !ok {\n381|\t\treturn ValidationReport{}, invalid(\"%s validation_report_id is not a digest\", owner)\n382|\t}\n383|\toperation, ok := checkUUIDv7(members[\"operation_id\"])\n384|\tif !ok {\n385|\t\treturn ValidationReport{}, invalid(\"%s operation_id is not a UUIDv7\", owner)\n386|\t}\n387|\tplanID, ok := checkDigest(members[\"projection_plan_id\"])\n388|\tif !ok {\n389|\t\treturn ValidationReport{}, invalid(\"%s projection_plan_id is not a digest\", owner)\n390|\t}\n391|\tprojectedID, ok := checkDigest(members[\"projected_object_manifest_id\"])\n392|\tif !ok {\n393|\t\treturn ValidationReport{}, invalid(\"%s projected_object_manifest_id is not a digest\", owner)\n394|\t}\n395|\tstagedID, ok := checkDigest(members[\"staged_read_back_evidence_manifest_id\"])\n396|\tif !ok {\n397|\t\treturn ValidationReport{}, invalid(\"%s staged_read_back_evidence_manifest_id is not a digest\", owner)\n398|\t}\n399|\tliveID, ok := checkDigest(members[\"live_read_back_evidence_manifest_id\"])\n400|\tif !ok {\n401|\t\treturn ValidationReport{}, invalid(\"%s live_read_back_evidence_manifest_id is not a digest\", owner)\n402|\t}\n403|\tif err := checkReadRefs(owner, stagedID, liveID, staged, live); err != nil {\n404|\t\treturn ValidationReport{}, err\n405|\t}\n406|\tproviderID, ok := checkDigest(members[\"target_provider_manifest_id\"])\n407|\tif !ok {\n408|\t\treturn ValidationReport{}, invalid(\"%s target_provider_manifest_id is not a digest\", owner)\n409|\t}\n410|\tfidelityID, ok := checkDigest(members[\"fidelity_report_id\"])\n411|\tif !ok {\n412|\t\treturn ValidationReport{}, invalid(\"%s fidelity_report_id is not a digest\", owner)\n413|\t}\n414|\texpected, ok := checkStringBounds(members[\"expected_target_native_session_id\"], 1, 512)\n415|\tif !ok {\n416|\t\treturn ValidationReport{}, invalid(\"%s expected_target_native_session_id is not a string[1..512]\", owner)\n417|\t}\n418|\tobserved, ok := checkStringBounds(members[\"observed_target_native_session_id\"], 1, 512)\n419|\tif !ok {\n420|\t\treturn ValidationReport{}, invalid(\"%s observed_target_native_session_id is not a string[1..512]\", owner)\n421|\t}\n422|\ttargetTuple, err := sessadapter.DecodeTuple(members[\"target_environment\"])\n423|\tif err != nil {\n424|\t\treturn ValidationReport{}, invalid(\"%s target_environment is not an Environment Tuple: %v\", owner, err)\n425|\t}\n426|\tchecks, err := decodeValidationChecks(members)\n427|\tif err != nil {\n428|\t\treturn ValidationReport{}, err\n429|\t}\n430|\tfindings, err := sessadapter.DecodeFindings(members[\"findings\"], maxReportFindings)\n431|\tif err != nil {\n432|\t\treturn ValidationReport{}, invalid(\"%s findings are not AdapterFinding[0..4096]: %v\", owner, err)\n433|\t}\n434|\tvalid, ok := rawBool(members[\"valid\"])\n435|\tif !ok {\n436|\t\treturn ValidationReport{}, invalid(\"%s valid is not a boolean\", owner)\n437|\t}\n438|\tif err := checkValidAgreement(owner, valid, checks, expected, observed, findings); err != nil {\n439|\t\treturn ValidationReport{}, err\n440|\t}\n441|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n442|\t\treturn ValidationReport{}, invalid(\"%s extensions %s\", owner, extensionsFault)\n443|\t}\n444|\tif err := verifySelfDigest(members, validationSelf, claimed); err != nil {\n445|\t\treturn ValidationReport{}, err\n446|\t}\n447|\treturn ValidationReport{\n448|\t\tReportID:                    claimed,\n449|\t\tOperationID:                 operation,\n450|\t\tProjectionPlanID:            planID,\n451|\t\tProjectedObjectManifestID:   projectedID,\n452|\t\tStagedManifestID:            stagedID,\n453|\t\tLiveManifestID:              liveID,\n454|\t\tProviderManifestID:          providerID,\n455|\t\tFidelityReportID:            fidelityID,\n456|\t\tExpectedTargetNativeSession: expected,\n457|\t\tObservedTargetNativeSession: observed,\n458|\t\tTargetEnvironment:           targetTuple,\n459|\t\tChecks:                      checks,\n460|\t\tFindings:                    findings,\n461|\t\tValid:                       valid,\n462|\t}, nil\n463|}\n464|\n465|// decodeValidationChecks reads the seven check booleans. Each member\n466|// is required non-null; null is a wrong type, never false.\n467|func decodeValidationChecks(members map[string]json.RawMessage) (ValidationChecks, error) {\n468|\towner := \"clone validation report\"\n469|\tread := func(member string) (bool, error) {\n470|\t\tvalue, ok := rawBool(members[member])\n471|\t\tif !ok {\n472|\t\t\treturn false, invalid(\"%s %s is not a boolean\", owner, member)\n473|\t\t}\n474|\t\treturn value, nil\n475|\t}\n476|\tstaged, err := read(\"staged_structural_valid\")\n477|\tif err != nil {\n478|\t\treturn ValidationChecks{}, err\n479|\t}\n480|\tlive, err := read(\"live_structural_valid\")\n481|\tif err != nil {\n482|\t\treturn ValidationChecks{}, err\n483|\t}\n484|\tmarker, err := read(\"semantic_marker_valid\")\n485|\tif err != nil {\n486|\t\treturn ValidationChecks{}, err\n487|\t}\n488|\tidentity, err := read(\"identity_valid\")\n489|\tif err != nil {\n490|\t\treturn ValidationChecks{}, err\n491|\t}\n492|\tbinding, err := read(\"workspace_binding_valid\")\n493|\tif err != nil {\n494|\t\treturn ValidationChecks{}, err\n495|\t}\n496|\tresume, err := read(\"resume_surface_valid\")\n497|\tif err != nil {\n498|\t\treturn ValidationChecks{}, err\n499|\t}\n500|\tgeneration, err := read(\"source_generation_revalidated\")\n501|\tif err != nil {\n502|\t\treturn ValidationChecks{}, err\n503|\t}\n504|\treturn ValidationChecks{\n505|\t\tStagedStructuralValid:       staged,\n506|\t\tLiveStructuralValid:         live,\n507|\t\tSemanticMarkerValid:         marker,\n508|\t\tIdentityValid:               identity,\n509|\t\tWorkspaceBindingValid:       binding,\n510|\t\tResumeSurfaceValid:          resume,\n511|\t\tSourceGenerationRevalidated: generation,\n512|\t}, nil\n513|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
