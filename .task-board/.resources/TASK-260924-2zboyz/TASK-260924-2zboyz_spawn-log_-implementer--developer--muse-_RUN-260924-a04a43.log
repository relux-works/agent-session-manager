{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c67b","stream":{"kind":"session","id":"01a0d50d-b8e8-7b33-a45d-f1920e40d897"},"sequence":408,"recorded_at":1780531400000811,"record_type":"event","durability":"durable","causation_id":"16827b65-f82c-4989-a975-d74d7ed70709","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"16827b65-f82c-4989-a975-d74d7ed70709","run_stream":{"kind":"run","id":"16827b65-f82c-4989-a975-d74d7ed70709"},"task_stream":{"kind":"task","id":"01a0d50f-b061-7bc1-8578-46634f0261c6"},"task_id":"01a0d50f-b061-7bc1-8578-46634f0261c6","event":{"kind":"output","task_id":"01a0d50f-b061-7bc1-8578-46634f0261c6","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/clonereadback/report.go`.\n(184 line(s) above)\n185|\n186|// checkSiblingsSealed enforces that both aggregated reads are\n187|// sealed: each sibling must come from the read-back validator,\n188|// never from a caller-minted value. The zero value seals nothing\n189|// and refuses here, before any claim comparison reads its\n190|// fields. Both report entries call this gate first.\n191|func checkSiblingsSealed(owner string, staged, live ValidatedReadBack) error {\n192|\tif !staged.sealed || !live.sealed {\n193|\t\treturn invalid(\"%s read-back sibling is not a validated read\", owner)\n194|\t}\n195|\treturn nil\n196|}\n197|\n198|// checkReadRefs enforces that the report aggregates TWO distinct\n199|// sealed reads: the staged sibling is a staged manifest, the live\n200|// sibling is a live manifest, the two reads are distinct\n201|// documents, and the carried references name those reads in their\n202|// own slots. An equal pair, a swapped pair, or a mismatched\n203|// reference refuses. Both report entries share this gate; the\n204|// seal gate above runs first at each entry.\n205|func checkReadRefs(owner string, stagedClaim, liveClaim scalar.Digest, staged, live ValidatedReadBack) error {\n206|\tif staged.read.ManifestID == live.read.ManifestID {\n207|\t\treturn invalid(\"%s staged and live read-back references are not distinct\", owner)\n208|\t}\n209|\tif staged.read.Mode != \"staged\" {\n210|\t\treturn invalid(\"%s staged read is not a staged manifest\", owner)\n211|\t}\n212|\tif live.read.Mode != \"live\" {\n213|\t\treturn invalid(\"%s live read is not a live manifest\", owner)\n214|\t}\n215|\tif stagedClaim != staged.read.ManifestID {\n216|\t\treturn invalid(\"%s staged_read_back_evidence_manifest_id does not match the staged read\", owner)\n217|\t}\n218|\tif liveClaim != live.read.ManifestID {\n219|\t\treturn invalid(\"%s live_read_back_evidence_manifest_id does not match the live read\", owner)\n220|\t}\n221|\treturn nil\n222|}\n223|\n224|// BuildValidationReport constructs one closed Clone Validation\n225|// Report 1.0.0 as canonical bytes. Identical inputs produce\n226|// byte-identical outputs. The staged and live siblings are the\n227|// sealed reads the report aggregates: each must come from the\n228|// read-back validator, and the carried references must name them\n229|// in their own slots. Every closed-shape, scalar, finding, and\n230|// validity rule is a refusal, never a repair.\n231|func BuildValidationReport(input ValidationReportInput, staged ValidatedReadBack, live ValidatedReadBack) ([]byte, error) {\n232|\t_, object, err := buildValidationReport(input, staged, live)\n233|\tif err != nil {\n234|\t\treturn nil, err\n235|\t}\n236|\tomitted, err := canonicalizeObject(object)\n237|\tif err != nil {\n238|\t\treturn nil, err\n239|\t}\n240|\treportID := scalar.SHA256Digest(omitted)\n241|\tobject[validationSelf] = reportID.String()\n242|\treturn canonicalizeObject(object)\n243|}\n244|\n245|func buildValidationReport(input ValidationReportInput, staged ValidatedReadBack, live ValidatedReadBack) (ValidationReport, map[string]any, error) {\n246|\towner := \"clone validation report\"\n247|\tif err := checkSiblingsSealed(owner, staged, live); err != nil {\n248|\t\treturn ValidationReport{}, nil, err\n249|\t}\n250|\toperation, err := scalar.ParseUUIDv7(input.OperationID)\n251|\tif err != nil {\n252|\t\treturn ValidationReport{}, nil, invalid(\"%s operation_id is not a UUIDv7: %v\", owner, err)\n253|\t}\n254|\tplanID, err := scalar.ParseDigest(input.ProjectionPlanID)\n255|\tif err != nil {\n256|\t\treturn ValidationReport{}, nil, invalid(\"%s projection_plan_id is not a digest: %v\", owner, err)\n257|\t}\n258|\tprojectedID, err := scalar.ParseDigest(input.ProjectedObjectManifestID)\n259|\tif err != nil {\n260|\t\treturn ValidationReport{}, nil, invalid(\"%s projected_object_manifest_id is not a digest: %v\", owner, err)\n261|\t}\n262|\tstagedID, err := scalar.ParseDigest(input.StagedReadBackEvidenceManifestID)\n263|\tif err != nil {\n264|\t\treturn ValidationReport{}, nil, invalid(\"%s staged_read_back_evidence_manifest_id is not a digest: %v\", owner, err)\n(more lines below)","final_result":true}}}
