/     owner's vocabulary predicates and no switch on a\n33|//     Disposition in the validation closures.\n34|//\n35|// Behavior itself is proven by the rule x entry table in\n36|// session_test.go, which drives violating inputs through the\n37|// production entry and asserts the owner's literal codes. Control\n38|// plants (a new disposition-carrying entry, a removed PlanItem\n39|// self-check, a re-added vocabulary call, a disposition switch in\n40|// the closure) redden these tests; logs ride the evidence tar.\n41|\n42|// A parameter carries a disposition row when its transitive type\n43|// closure contains a struct pairing a disposition member\n44|// (Disposition or ExpectedDispos) with a reason-set member\n45|// (Reasons or ReasonCodes): exactly what the owner's row\n46|// validator consumes. A lone reason set without a disposition\n47|// sibling is not a validatable row — the seam needs both — so it\n48|// does not census. In particular ClassifyItem's event evidence\n49|// (SourceEvidence.ReasonCodes, validated by the landed decoder\n50|// and ignored by the classifier) is excluded by this rule, and\n51|// the exclusion is measured: the census pins the evidence shape\n52|// and the ignore test below proves adversarial evidence reasons\n53|// never change the item. Resolution and protection facts are\n54|// likewise not rows: they are closed-vocabulary classification\n55|// inputs with their own gates.\n56|func structCarriesDispositionRow(typ reflect.Type) bool {\n57|\thasDisposition := false\n58|\thasReasons := false\n59|\tfor i := 0; i < typ.NumField(); i++ {\n60|\t\tswitch typ.Field(i).Name {\n61|\t\tcase \"Disposition\", \"ExpectedDispos\":\n62|\t\t\thasDisposition = true\n63|\t\tcase \"Reasons\", \"ReasonCodes\":\n64|\t\t\thasReasons = true\n65|\t\t}\n66|\t}\n67|\treturn hasDisposition && hasReasons\n68|}\n69|\n70|// reflectCarriesDispositionRow reports whether a disposition row\n71|// is reachable from the type through fields, elements, keys, and\n72|// pointees. Open any-typed members do not count: an any carries\n73|// no NAMED row, and members the entry ignores (non-fact payload\n74|// keys) can never reach a decision by type — the all-kinds sweep\n75|// proves adversarial payload text cannot change the item, and\n76|// the closed-fact guard pins ClassifyItem to the two fact keys.\n77|func reflectCarriesDispositionRow(typ reflect.Type, visited map[reflect.Type]bool) bool {\n78|\tif typ == nil {\n79|\t\treturn false\n80|\t}\n81|\tswitch typ.Kind() {\n82|\tcase reflect.Pointer:\n83|\t\treturn reflectCarriesDispositionRow(typ.Elem(), visited)\n84|\tcase reflect.Slice, reflect.Array:\n85|\t\treturn reflectCarriesDispositionRow(typ.Elem(), visited)\n86|\tcase reflect.Map:\n87|\t\treturn reflectCarriesDispositionRow(typ.Key(), visited) || reflectCarriesDispositionRow(typ.Elem(), visited)\n88|\tcase reflect.Struct:\n89|\t\tif structCarriesDispositionRow(typ) {\n90|\t\t\treturn true\n91|\t\t}\n92|\t\tif visited[typ] {\n93|\t\t\treturn false\n94|\t\t}\n95|\t\tvisited[typ] = true\n96|\t\tfor i := 0; i < typ.NumField(); i++ {\n97|\t\t\tif reflectCarriesDispositionRow(typ.Field(i).Type, visited) {\n98|\t\t\t\treturn true\n99|\t\t\t}\n100|\t\t}\n101|\t\treturn false\n102|\tdefault:\n103|\t\treturn false\n104|\t}\n105|}\n106|\n107|// reflectEntryCarriesDispositionRow reports whether any parameter\n108|// of the function value carries a disposition row.\n109|func reflectEntryCarriesDispositionRow(value any) bool {\n110|\ttyp := reflect.TypeOf(value)\n111|\tfor i := 0; i < typ.NumIn(); i++ {\n112|\t\tif reflectCarriesDispositionRow(typ.In(i), map[reflect.Type]bool{}) {\n113|\t\t\treturn true\n114|\t\t}\n115|\t}\n116|\treturn false\n117|}\n118|\n119|// structFieldNames lists the field names of one struct type.\n120|func structFieldNames(value any) []string {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c635","stream":{"kind":"session","id":"01a0d3fe-e1c2-7983-a225-5975dcbb2845"},"sequence":373,"recorded_at":1780531400000741,"record_type":"event","durability":"durable","causation_id":"f45be434-9d55-4786-80d4-94e03d5e30b9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f45be434-9d55-4786-80d4-94e03d5e30b9","run_stream":{"kind":"run","id":"f45be434-9d55-4786-80d4-94e03d5e30b9"},"call_id":"call_01a0d400082676589e051609bacec67c","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/cloneplanning/structural_test.go`.\n1|package cloneplanning\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"testing\"\n8|)\n9|\n10|// This file pins the authority-by-type shape structurally: in\n11|// ProjectVisibleText the Authority field is assigned exactly once,\n12|// unconditionally, from the authorityUserContext constant (or the\n13|// literal \"user_context\" it quotes). No branch on text, kind,\n14|// ordinal, or event IDs can reach the authority decision, because\n15|// no branch reaches it at all. Control plants (a conditional\n16|// authority, a foreign literal) redden this test; logs ride the\n17|// evidence tar.\n18|\n19|// authorityShape describes the Authority assignments found in\n20|// ProjectVisibleText.\n21|type authorityShape struct {\n22|\tassignments int\n23|\tconditional int\n24|\tforeign     int\n25|}\n26|\n27|func inspectAuthorityShape(t *testing.T, path string) authorityShape {\n28|\tt.Helper()\n29|\tfset := token.NewFileSet()\n30|\tfile, err := parser.ParseFile(fset, path, nil, 0)\n31|\tif err != nil {\n32|\t\tt.Fatalf(\"parse %s: %v\", path, err)\n33|\t}\n34|\tvar shape authorityShape\n35|\tfor _, decl := range file.Decls {\n36|\t\tfn, ok := decl.(*ast.FuncDecl)\n37|\t\tif !ok || fn.Name.Name != \"ProjectVisibleText\" {\n38|\t\t\tcontinue\n39|\t\t}\n40|\t\tast.Inspect(fn.Body, func(node ast.Node) bool {\n41|\t\t\tswitch stmt := node.(type) {\n42|\t\t\tcase *ast.IfStmt, *ast.SwitchStmt, *ast.TypeSwitchStmt, *ast.ForStmt, *ast.RangeStmt, *ast.SelectStmt:\n43|\t\t\t\t// Any Authority assignment nested in a\n44|\t\t\t\t// branch or loop counts conditional.\n45|\t\t\t\tast.Inspect(stmt, func(inner ast.Node) bool {\n46|\t\t\t\t\tkv, ok := inner.(*ast.KeyValueExpr)\n47|\t\t\t\t\tif ok {\n48|\t\t\t\t\t\tcheckAuthorityValue(t, kv, &shape, true)\n49|\t\t\t\t\t}\n50|\t\t\t\t\tassign, ok := inner.(*ast.AssignStmt)\n51|\t\t\t\t\tif ok {\n52|\t\t\t\t\t\tcheckAuthorityAssign(t, assign, &shape, true)\n53|\t\t\t\t\t}\n54|\t\t\t\t\treturn true\n55|\t\t\t\t})\n56|\t\t\t\treturn false\n57|\t\t\tcase *ast.KeyValueExpr:\n58|\t\t\t\tcheckAuthorityValue(t, stmt, &shape, false)\n59|\t\t\tcase *ast.AssignStmt:\n60|\t\t\t\tcheckAuthorityAssign(t, stmt, &shape, false)\n61|\t\t\t}\n62|\t\t\treturn true\n63|\t\t})\n64|\t}\n65|\treturn shape\n66|}\n67|\n68|func isAuthorityKey(expr ast.Expr) bool {\n69|\tident, ok := expr.(*ast.Ident)\n70|\treturn ok && ident.Name == \"Authority\"\n71|}\n72|\n73|func isAuthoritySelector(expr ast.Expr) bool {\n74|\tsel, ok := expr.(*ast.SelectorExpr)\n75|\treturn ok && sel.Sel.Name == \"Authority\"\n76|}\n77|\n78|// checkAuthorityValue inspects one composite-literal Authority\n79|// field for the constant shape.\n80|func checkAuthorityValue(t *testing.T, kv *ast.KeyValueExpr, shape *authorityShape, conditional bool) {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
