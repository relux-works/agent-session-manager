{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c69d","stream":{"kind":"session","id":"01a0d3fe-e1c2-7983-a225-5975dcbb2845"},"sequence":425,"recorded_at":1780531400000845,"record_type":"event","durability":"durable","causation_id":"f45be434-9d55-4786-80d4-94e03d5e30b9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f45be434-9d55-4786-80d4-94e03d5e30b9","run_stream":{"kind":"run","id":"f45be434-9d55-4786-80d4-94e03d5e30b9"},"task_stream":{"kind":"task","id":"01a0d400-3328-7293-88f7-a571af454347"},"task_id":"01a0d400-3328-7293-88f7-a571af454347","event":{"kind":"output","task_id":"01a0d400-3328-7293-88f7-a571af454347","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/sessadapter/tuple.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"time\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|// This file validates the Environment Tuple and the Supported\n12|// Environment Tuple Registry entry admission Section 7.8 rests on:\n13|// the probe and every state-bearing call carry an exact six-member\n14|// tuple, and target writes and healthy doctor results require an\n15|// accepted non-revoked signed entry whose key equals the\n16|// host-observed execution facts.\n17|//\n18|// The registry publication rules — detached signature, monotonic\n19|// sequence, validity of the registry envelope itself — fail closed\n20|// at the registry owner, which does not exist yet; this package\n21|// admits single entries against caller-held registry facts and\n22|// states that bound in doc.go.\n23|\n24|// tupleMembers is the exact Environment Tuple member set Section 7.8\n25|// requires: environment_id, environment_version, platform,\n26|// architecture, store_schema_fingerprint, and adapter_version. The\n27|// tuple never contains executable provenance, and — unlike every\n28|// neighbouring closed type — it carries no extensions member, so\n29|// even a reverse-DNS extensions object is refused here.\n30|var tupleMembers = map[string]bool{\n31|\t\"environment_id\":           true,\n32|\t\"environment_version\":      true,\n33|\t\"platform\":                 true,\n34|\t\"architecture\":             true,\n35|\t\"store_schema_fingerprint\": true,\n36|\t\"adapter_version\":          true,\n37|}\n38|\n39|// tupleRequired lists tupleMembers in a fixed order.\n40|var tupleRequired = []string{\n41|\t\"environment_id\",\n42|\t\"environment_version\",\n43|\t\"platform\",\n44|\t\"architecture\",\n45|\t\"store_schema_fingerprint\",\n46|\t\"adapter_version\",\n47|}\n48|\n49|// Tuple is one validated Environment Tuple.\n50|type Tuple struct {\n51|\tEnvironmentID    string\n52|\tVersion          string\n53|\tPlatform         string\n54|\tArchitecture     string\n55|\tStoreFingerprint string\n56|\tAdapterVersion   string\n57|}\n58|\n59|// DecodeTuple validates one closed Environment Tuple: exact\n60|// members, the environment-id grammar, environment_version as\n61|// string[1..128] (the bound Section 10.8.1 states for the\n62|// observation that reuses this admission model), the closed\n63|// platform and architecture vocabularies, a digest store\n64|// fingerprint, and a SemVer adapter version. Any executable\n65|// provenance member is an unknown member, never a second identity.\n66|func DecodeTuple(raw json.RawMessage) (Tuple, error) {\n67|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n68|\tif fault != nil {\n69|\t\tfailure, err := failProtocol(\"environment tuple \"+fault.detail, fault.member)\n70|\t\tif err != nil {\n71|\t\t\treturn Tuple{}, err\n72|\t\t}\n73|\t\treturn Tuple{}, failure\n74|\t}\n75|\tif name, unknown := unknownMember(members, tupleMembers); unknown {\n76|\t\tfailure, err := failProtocol(\"environment tuple carries unknown member\", name)\n77|\t\tif err != nil {\n78|\t\t\treturn Tuple{}, err\n79|\t\t}\n80|\t\treturn Tuple{}, failure\n81|\t}\n82|\tif name, missing := missingMember(members, tupleRequired); missing {\n83|\t\tfailure, err := failProtocol(\"environment tuple misses a required member\", name)\n84|\t\tif err != nil {\n85|\t\t\treturn Tuple{}, err\n86|\t\t}\n87|\t\treturn Tuple{}, failure\n88|\t}\n89|\tenvironmentID, ok := rawString(members[\"environment_id\"])\n90|\tif !ok || !environ.CheckEnvironmentID(environmentID) {\n91|\t\tfailure, err := failProtocol(\"environment tuple environment identifier is not an environment-id\", \"environment_id\")\n92|\t\tif err != nil {\n93|\t\t\treturn Tuple{}, err\n94|\t\t}\n95|\t\treturn Tuple{}, failure\n96|\t}\n97|\tversion, ok := checkStringBounds(members[\"environment_version\"], 1, 128)\n98|\tif !ok {\n99|\t\tfailure, err := failProtocol(\"environment tuple environment version is not a string[1..128]\", \"environment_version\")\n100|\t\tif err != nil {\n101|\t\t\treturn Tuple{}, err\n102|\t\t}\n103|\t\treturn Tuple{}, failure\n104|\t}\n105|\tplatform, ok := rawString(members[\"platform\"])\n106|\tif !ok {\n107|\t\tfailure, err := failProtocol(\"environment tuple platform is not a string\", \"platform\")\n108|\t\tif err != nil {\n109|\t\t\treturn Tuple{}, err\n110|\t\t}\n111|\t\treturn Tuple{}, failure\n112|\t}\n113|\tif _, err := scalar.ParsePlatform(platform); err != nil {\n114|\t\tfailure, faultErr := failProtocol(\"environment tuple platform is outside linux|macos|windows|wsl2\", \"platform\")\n115|\t\tif faultErr != nil {\n116|\t\t\treturn Tuple{}, faultErr\n117|\t\t}\n118|\t\treturn Tuple{}, failure\n119|\t}\n120|\tarchitecture, ok := rawString(members[\"architecture\"])\n(more lines below)","final_result":true}}}
