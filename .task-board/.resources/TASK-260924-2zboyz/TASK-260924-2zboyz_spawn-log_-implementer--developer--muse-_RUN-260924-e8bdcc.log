{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8db","stream":{"kind":"session","id":"01a0d3fe-e1c2-7983-a225-5975dcbb2845"},"sequence":712,"recorded_at":1780531400001419,"record_type":"event","durability":"durable","causation_id":"f45be434-9d55-4786-80d4-94e03d5e30b9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f45be434-9d55-4786-80d4-94e03d5e30b9","run_stream":{"kind":"run","id":"f45be434-9d55-4786-80d4-94e03d5e30b9"},"call_id":"call_01a0d401c87471d89035552db785ff24","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-21bxa3/worktree/internal/cloneplan/manifest.go`.\n(114 line(s) above)\n115|// ProjectedManifestInput is the caller-supplied projected manifest\n116|// candidate for Build.\n117|type ProjectedManifestInput struct {\n118|\tOperationID                 string\n119|\tProjectionPlanID            string\n120|\tTargetEnvironment           []byte\n121|\tExpectedTargetNativeSession string\n122|\tEntries                     []ProjectedEntryInput\n123|\tTotalBytes                  uint64\n124|\tExtensions                  map[string]any\n125|}\n126|\n127|// checkEntryBranch enforces branch-exact entry membership: blob\n128|// entries carry byte count and both blob IDs, directory entries\n129|// carry none of the three. Both entries share this gate.\n130|func checkEntryBranch(owner, kind string, hasCount, hasBlob, hasDescriptor bool) error {\n131|\tif kind == \"blob\" {\n132|\t\tif !hasCount {\n133|\t\t\treturn invalid(\"%s byte_count is missing for blob\", owner)\n134|\t\t}\n135|\t\tif !hasBlob {\n136|\t\t\treturn invalid(\"%s blob_id is missing for blob\", owner)\n137|\t\t}\n138|\t\tif !hasDescriptor {\n139|\t\t\treturn invalid(\"%s blob_descriptor_id is missing for blob\", owner)\n140|\t\t}\n141|\t\treturn nil\n142|\t}\n143|\tif hasCount {\n144|\t\treturn invalid(\"%s byte_count is present for directory\", owner)\n145|\t}\n146|\tif hasBlob {\n147|\t\treturn invalid(\"%s blob_id is present for directory\", owner)\n148|\t}\n149|\tif hasDescriptor {\n150|\t\treturn invalid(\"%s blob_descriptor_id is present for directory\", owner)\n151|\t}\n152|\treturn nil\n153|}\n154|\n155|// buildProjectedEntry validates one caller-supplied entry and\n156|// renders its closed object. The rendered member set is branch-exact:\n157|// seven members for blob, four for directory.\n158|func buildProjectedEntry(input ProjectedEntryInput, index int) (ProjectedEntry, map[string]any, error) {\n159|\towner := fmt.Sprintf(\"projected object entry[%d]\", index)\n160|\tif input.OperationSequence == 0 || input.OperationSequence > maxUint53 {\n161|\t\treturn ProjectedEntry{}, nil, invalid(\"%s operation_sequence is not a uint53>0\", owner)\n162|\t}\n163|\tif !validText(input.ResourceKey) {\n164|\t\treturn ProjectedEntry{}, nil, invalid(\"%s resource_key is not valid UTF-8\", owner)\n165|\t}\n166|\tif length := stringLength(input.ResourceKey); length < 1 || length > 512 {\n167|\t\treturn ProjectedEntry{}, nil, invalid(\"%s resource_key is not a string[1..512]\", owner)\n168|\t}\n169|\tif !validText(input.Kind) {\n170|\t\treturn ProjectedEntry{}, nil, invalid(\"%s kind is not valid UTF-8\", owner)\n171|\t}\n172|\tif !ValidResourceKind(input.Kind) {\n173|\t\treturn ProjectedEntry{}, nil, invalid(\"%s kind is outside blob|directory\", owner)\n174|\t}\n175|\tmode, modeValue, err := checkBuildMode(input.Mode, owner)\n176|\tif err != nil {\n177|\t\treturn ProjectedEntry{}, nil, err\n178|\t}\n179|\tif err := checkEntryBranch(owner, input.Kind, input.ByteCount != nil, input.BlobID != nil, input.BlobDescriptorID != nil); err != nil {\n180|\t\treturn ProjectedEntry{}, nil, err\n181|\t}\n182|\tobject := map[string]any{\n183|\t\t\"operation_sequence\": input.OperationSequence,\n184|\t\t\"resource_key\":       input.ResourceKey,\n185|\t\t\"kind\":               input.Kind,\n186|\t\t\"mode\":               modeValue,\n187|\t}\n188|\tentry := ProjectedEntry{\n189|\t\tOperationSequence: input.OperationSequence,\n190|\t\tResourceKey:       input.ResourceKey,\n191|\t\tKind:              input.Kind,\n192|\t\tMode:              mode,\n193|\t}\n194|\tif input.Kind == \"blob\" {\n195|\t\tif *input.ByteCount > maxUint53 {\n196|\t\t\treturn ProjectedEntry{}, nil, invalid(\"%s byte_count exceeds uint53\", owner)\n197|\t\t}\n198|\t\tcount := *input.ByteCount\n199|\t\tblob, err := scalar.ParseDigest(*input.BlobID)\n200|\t\tif err != nil {\n201|\t\t\treturn ProjectedEntry{}, nil, invalid(\"%s blob_id is not a digest: %v\", owner, err)\n202|\t\t}\n203|\t\tdescriptor, err := scalar.ParseDigest(*input.BlobDescriptorID)\n204|\t\tif err != nil {\n205|\t\t\treturn ProjectedEntry{}, nil, invalid(\"%s blob_descriptor_id is not a digest: %v\", owner, err)\n206|\t\t}\n207|\t\tentry.ByteCount = &count\n208|\t\tentry.BlobID = &blob\n209|\t\tentry.BlobDescriptorID = &descriptor\n210|\t\tobject[\"byte_count\"] = count\n211|\t\tobject[\"blob_id\"] = blob.String()\n212|\t\tobject[\"blob_descriptor_id\"] = descriptor.String()\n213|\t}\n214|\treturn entry, object, nil\n215|}\n216|\n217|// decodeProjectedEntry validates one closed ProjectedObjectEntry,\n218|// dispatching on kind to the branch-exact member set.\n219|func decodeProjectedEntry(raw json.RawMessage, index int) (ProjectedEntry, error) {\n220|\towner := \"projected object entry\"\n221|\tmembers, fault := decodeStrictObject(raw)\n222|\tif fault != nil {\n223|\t\treturn ProjectedEntry{}, invalid(\"%s[%d] %s (%s)\", owner, index, fault.detail, memberField(fault.member))\n224|\t}\n225|\tkindMember, present := members[\"kind\"]\n226|\tif !present {\n227|\t\treturn ProjectedEntry{}, invalid(\"%s[%d] misses a required member %q\", owner, index, \"kind\")\n228|\t}\n229|\tkind, ok := rawString(kindMember)\n230|\tif !ok || !ValidResourceKind(kind) {\n231|\t\treturn ProjectedEntry{}, invalid(\"%s[%d] kind is outside blob|directory\", owner, index)\n232|\t}\n233|\tallowed, required := blobEntryMembers, blobEntryRequired\n234|\tif kind == \"directory\" {\n235|\t\tallowed, required = directoryEntryMembers, directoryEntryRequired\n236|\t}\n237|\tif name, unknown := unknownMember(members, allowed); unknown {\n238|\t\treturn ProjectedEntry{}, invalid(\"%s[%d] carries unknown member %q\", owner, index, name)\n239|\t}\n240|\tif name, missing := missingMember(members, required); missing {\n241|\t\treturn ProjectedEntry{}, invalid(\"%s[%d] misses a required member %q\", owner, index, name)\n242|\t}\n243|\tsequence, ok := checkUint53Bounds(members[\"operation_sequence\"], 1, maxUint53)\n244|\tif !ok {\n245|\t\treturn ProjectedEntry{}, invalid(\"%s[%d] operation_sequence is not a uint53>0\", owner, index)\n246|\t}\n247|\tkey, ok := checkStringBounds(members[\"resource_key\"], 1, 512)\n248|\tif !ok {\n249|\t\treturn ProjectedEntry{}, invalid(\"%s[%d] resource_key is not a string[1..512]\", owner, index)\n250|\t}\n251|\tvar mode *uint64\n252|\tif !isNull(members[\"mode\"]) {\n253|\t\tvalue, ok := checkUint53Bounds(members[\"mode\"], 0, maxMode)\n254|\t\tif !ok {\n255|\t\t\treturn ProjectedEntry{}, invalid(\"%s[%d] mode is not a uint32[0..4095] or null\", owner, index)\n256|\t\t}\n257|\t\tmode = &value\n258|\t}\n259|\tentry := ProjectedEntry{\n260|\t\tOperationSequence: sequence,\n261|\t\tResourceKey:       key,\n262|\t\tKind:              kind,\n263|\t\tMode:              mode,\n264|\t}\n265|\tif kind == \"blob\" {\n266|\t\tcount, ok := checkUint53Bounds(members[\"byte_count\"], 0, maxUint53)\n267|\t\tif !ok {\n268|\t\t\treturn ProjectedEntry{}, invalid(\"%s[%d] byte_count is not a uint53\", owner, index)\n269|\t\t}\n270|\t\tblob, ok := checkDigest(members[\"blob_id\"])\n271|\t\tif !ok {\n272|\t\t\treturn ProjectedEntry{}, invalid(\"%s[%d] blob_id is not a digest\", owner, index)\n273|\t\t}\n274|\t\tdescriptor, ok := checkDigest(members[\"blob_descriptor_id\"])\n275|\t\tif !ok {\n276|\t\t\treturn ProjectedEntry{}, invalid(\"%s[%d] blob_descriptor_id is not a digest\", owner, index)\n277|\t\t}\n278|\t\tentry.ByteCount = &count\n279|\t\tentry.BlobID = &blob\n280|\t\tentry.BlobDescriptorID = &descriptor\n281|\t}\n282|\treturn entry, nil\n283|}\n284|\n285|// checkProjectedEntryOrder enforces \"sorted unique by operation\n286|// sequence/resource key\": the (sequence, key) pairs are strictly\n287|// increasing. Both entries share this gate over the sealed entry\n288|// set.\n289|func checkProjectedEntryOrder(entries []ProjectedEntry) error {\n290|\tfor index := 1; index < len(entries); index++ {\n291|\t\tprevious := entries[index-1]\n292|\t\tcurrent := entries[index]\n293|\t\tif current.OperationSequence < previous.OperationSequence ||\n294|\t\t\t(current.OperationSequence == previous.OperationSequence && current.ResourceKey <= previous.ResourceKey) {\n295|\t\t\treturn invalid(\"projected object manifest entries are not sorted unique by operation sequence/resource key\")\n296|\t\t}\n297|\t}\n298|\treturn nil\n299|}\n300|\n301|// checkProjectedEntryCount enforces the entries cardinality bound\n302|// ProjectedObjectEntry[0..65536]. The gate is factored so the exact\n303|// upper edge pins at the gate while entry reachability pins at both\n304|// entries.\n305|func checkProjectedEntryCount(count int) error {\n306|\tif count < 0 || count > 65536 {\n307|\t\treturn invalid(\"projected object manifest carries %d entries, want [0..65536]\", count)\n308|\t}\n309|\treturn nil\n310|}\n311|\n312|// BuildProjectedObjectManifest constructs one closed Clone\n313|// Projected Object Manifest 1.0.0 as canonical bytes. Identical\n314|// inputs produce byte-identical outputs. Every closed-shape,\n315|// branch, order, and vocabulary rule is a refusal, never a repair.\n316|func BuildProjectedObjectManifest(input ProjectedManifestInput) ([]byte, error) {\n317|\t_, object, err := buildProjectedManifest(input)\n318|\tif err != nil {\n319|\t\treturn nil, err\n320|\t}\n321|\tomitted, err := canonicalizeObject(object)\n322|\tif err != nil {\n323|\t\treturn nil, err\n324|\t}\n325|\tmanifestID := scalar.SHA256Digest(omitted)\n326|\tobject[projectedManifestSelf] = manifestID.String()\n327|\treturn canonicalizeObject(object)\n328|}\n329|\n330|func buildProjectedManifest(input ProjectedManifestInput) (ProjectedManifest, map[string]any, error) {\n331|\towner := \"projected object manifest\"\n332|\toperation, err := scalar.ParseUUIDv7(input.OperationID)\n333|\tif err != nil {\n334|\t\treturn ProjectedManifest{}, nil, invalid(\"%s operation_id is not a UUIDv7: %v\", owner, err)\n335|\t}\n336|\tplanID, err := scalar.ParseDigest(input.ProjectionPlanID)\n337|\tif err != nil {\n338|\t\treturn ProjectedManifest{}, nil, invalid(\"%s projection_plan_id is not a digest: %v\", owner, err)\n339|\t}\n340|\ttargetTuple, err := sessadapter.DecodeTuple(json.RawMessage(input.TargetEnvironment))\n341|\tif err != nil {\n342|\t\treturn ProjectedManifest{}, nil, invalid(\"%s target_environment is not an Environment Tuple: %v\", owner, err)\n343|\t}\n344|\tif !validText(input.ExpectedTargetNativeSession) {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
