ied projected entry\n92|// candidate for Build. Nil Mode seals as null on both branches; the\n93|// blob-only members must be non-nil exactly for blob entries.\n94|type ProjectedEntryInput struct {\n95|\tOperationSequence uint64\n96|\tResourceKey       string\n97|\tKind              string\n98|\tMode              *uint64\n99|\tByteCount         *uint64\n100|\tBlobID            *string\n101|\tBlobDescriptorID  *string\n102|}\n103|\n104|// ProjectedManifest is one validated projected object manifest.\n105|type ProjectedManifest struct {\n106|\tManifestID                  scalar.Digest\n107|\tOperationID                 scalar.UUIDv7\n108|\tProjectionPlanID            scalar.Digest\n109|\tTargetEnvironment           sessadapter.Tuple\n110|\tExpectedTargetNativeSession string\n111|\tEntries                     []ProjectedEntry\n112|\tTotalBytes                  uint64\n113|}\n114|\n115|// ProjectedManifestInput is the caller-supplied projected manifest\n116|// candidate for Build.\n117|type ProjectedManifestInput struct {\n118|\tOperationID                 string\n119|\tProjectionPlanID            string\n120|\tTargetEnvironment           []byte\n(more lines below)","final_result":true}}}
