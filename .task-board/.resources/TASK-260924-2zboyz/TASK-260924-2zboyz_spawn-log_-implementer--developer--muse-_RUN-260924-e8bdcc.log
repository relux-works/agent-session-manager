ting\\n        run: |\\n          count=$(find internal -name '*.go' | wc -l | tr -d ' ')\\n          echo \\\"go files scanned: ${count}\\\"\\n          test \\\"${count}\\\" -gt 0\\n          set +e\\n          gofmt -l internal > gofmt.log 2>&1\\n          code=$?\\n          set -e\\n          cat gofmt.log\\n          test $code -eq 0\\n          test ! -s gofmt.log\\n\\n  test:\\n    name: Build and test (no cache)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 15\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n\",\n  \"original_output_bytes\": 1543,\n  \"original_output_tokens\": 386,\n  \"truncated\": false\n}","final_result":true}}}
