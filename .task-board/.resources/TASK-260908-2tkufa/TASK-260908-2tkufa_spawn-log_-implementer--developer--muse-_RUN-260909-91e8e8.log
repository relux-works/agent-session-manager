10.3\\\"},\\n    {\\\"contract_id\\\": \\\"urn:ax:schema:terminal-backend-manifest\\\", \\\"\\n===\\ninternal/catalog/catalog.go:2:// implementation metadata. Catalog membership defines a contract vocabulary;\\ninternal/catalog/catalog.go:22:// reviewed implementation metadata.\\ninternal/catalog/catalog.go:29:// overlap across independent contracts.\\ninternal/catalog/catalog.go:63:// immutable logical object. Membership is reviewed metadata from the pinned\\ninternal/catalog/catalog.go:183://go:generate go run ./cmd/cataloggen -metadata catalog.v0.5.0.json -contracts ../specpin/v0.5.0.lock.json -output catalog_gen.go\\ninternal/catalog/catalog.go:197:\\tcontracts, ok := generatedDefinition.Contracts[release]\\ninternal/catalog/catalog.go:202:\\tallowedVersions := make(map[ContractID]map[string]struct{}, len(contracts))\\ninternal/catalog/catalog.go:203:\\tfor _, contract := range contracts {\\ninternal/catalog/catalog.go:218:\\t\\tContracts:      cloneContracts(contracts),\\ninternal/catalog/catalog.go:297:func cloneContracts(contracts []Contract) []Contract {\\ninternal/catalog/catalog.go:298:\\tresult := make([]Contract, len(contracts))\\ninternal/catalog/catalog.go:299:\\tfor index, contract := range contracts {\\ninternal/catalog/catalog_test.go:45:\\t\\tt.Fatal(\\\"generated v0.5.0 contracts differ from the verified source pin\\\")\\ninternal/catalog/catalog_test.go:61:\\t\\tt.Errorf(\\\"self identity contracts = %d, want 40\\\", len(got.SelfIdentities))\\ninternal/catalog/catalog_test.go:108:\\t\\tt.Errorf(\\\"generated self identity catalog omitted reviewed contracts: %v\\\", wantAdditionalIdentities)\\ninternal/catalog/catalog_test.go:280:\\t\\tt.Fatal(\\\"generated v0.4.3 contracts differ from the verified compatibility projection\\\")\\ninternal/catalog/catalog_test.go:702:// exact `//go:generate` form the go tool recognizes. Rewriting it as\\ninternal/catalog/catalog_test.go:703:// `// go:generate` preserves the token while turning the directive into\\ninternal/catalog/catalog_test.go:717:\\t\\tif strings.HasPrefix(line, \\\"//go:generate\\\") {\\ninternal/catalog/catalog_test.go:720:\\t\\tif strings.HasPrefix(line, \\\"// go:generate\\\") {\\ninternal/catalog/catalog_test.go:725:\\t\\tt.Errorf(\\\"recognized //go:generate directives = %d, want exactly 1; update the CI freshness pin with any deliberate change\\\", directives)\\ninternal/catalog/catalog_test.go:729:func contractPins(contracts []catalog.Contract) []specpin.ContractPin {\\ninternal/catalog/catalog_test.go:730:\\tresult := make([]specpin.ContractPin, len(contracts))\\ninternal/catalog/catalog_test.go:731:\\tfor index, contract := range contracts {\\n===\\nci.yml\\n.github/workflows/ci.yml:36:        run: go run ./internal/traceability/cmd/tracecheck\\n.github/workflows/ci.yml:59:          go test ./internal/cigate -run 'TestVerifyContractPreservationLive|TestPinnedReleasesAgreeAcrossAuthorities|TestDerivedSetsAreComplete|TestCheckAgreementAdmitsIdenticalSets|TestCheckAgreementRefusals|TestCheckReleaseRootsRefusesDrift' -count=1 -v > cigate-contracts.log 2>&1\\n.github/workflows/ci.yml:62:          cat cigate-contracts.log\\n.github/workflows/ci.yml:65:            grep -q \\\"^--- PASS: ${gate}\\\" cigate-contracts.log\\n.github/workflows/ci.yml:266:      # The secconftest leg of that list must equal the cigate.FuzzTargets\\n.github/workflows/ci.yml:273:          go test ./internal/cigate -run 'TestListedTargetsMatchDerivation|TestFuzzTargetsAreDerivedSorted' -count=1 -v > cigate-targets.log 2>&1\\n.github/workflows/ci.yml:276:          cat cigate-targets.log\\n.github/workflows/ci.yml:279:            grep -q \\\"^--- PASS: ${gate}\\\" cigate-targets.log\\n.github/workflows/ci.yml:325:          go test ./internal/cigate -run 'TestRealREADMECarriesNoPositiveClaim|TestRealREADMEAdmitsWhenAllAvailable|TestCapabilityIDsAreDerivedSorted|TestPositiveClaimsAreRefused|TestNegatedClaimsAreAdmitted|TestUnclassifiedMentionIsRefused' -count=1 -v > cigate-claims.log 2>&1\\n.github/workflows/ci.yml:328:          cat cigate-claims.log\\n.github/workflows/ci.yml:331:            grep -q \\\"^--- PASS: ${gate}\\\" cigate-claims.log\\n\",\n  \"original_output_bytes\": 5892,\n  \"original_output_tokens\": 1473,\n  \"truncated\": false\n}"}}}
