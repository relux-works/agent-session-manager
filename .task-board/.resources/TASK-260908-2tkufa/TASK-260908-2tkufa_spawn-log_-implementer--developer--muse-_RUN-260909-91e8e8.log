{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d487","stream":{"kind":"session","id":"01a08707-ceef-7493-9b49-24effd76d285"},"sequence":2206,"recorded_at":1780531400004407,"record_type":"event","durability":"durable","causation_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","run_stream":{"kind":"run","id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3"},"task_stream":{"kind":"task","id":"a0ab2c29-9425-4108-8cee-7ad7e015a6b0"},"task_id":"a0ab2c29-9425-4108-8cee-7ad7e015a6b0","event":{"kind":"output","task_id":"a0ab2c29-9425-4108-8cee-7ad7e015a6b0","chunk":"{\n  \"chunk_id\": \"exec-89-1\",\n  \"command\": \"python3 << 'PYEOF'\\np = 'internal/traceability/ownership.v0.6.0.json'\\nsrc = open(p).read()\\n\\ndef rep(old, new, n=1):\\n    global src\\n    assert src.count(old) == n, (old[:80], src.count(old))\\n    src = src.replace(old, new)\\n\\n# I. three owned bindings for new sections with real layer owners (truthful gaps)\\nrep('''      ]\\n    }\\n  ],\\n  \\\"unowned_sections\\\": [''',\\n'''      ]\\n    },\\n    {\\n      \\\"kind\\\": \\\"section_binding\\\",\\n      \\\"keys\\\": [\\n        \\\"section:6.6\\\"\\n      ],\\n      \\\"production\\\": {\\n        \\\"path\\\": \\\"internal/config/migration.go\\\",\\n        \\\"declaration\\\": \\\"Migrate\\\"\\n      },\\n      \\\"acceptance_cases\\\": [\\n        \\\"config-versioned-readers\\\",\\n        \\\"config-durable-migration\\\",\\n        \\\"config-durable-migration-os-entry\\\"\\n      ],\\n      \\\"coverage\\\": \\\"unevidenced\\\",\\n      \\\"gap\\\": \\\"Migrate admits explicit migration targets up to 3.0.0 only; the Section 6.6 Config-4 host-channel migration with enrolled credentials, out-of-band peer exchange, previewed atomic replacement and dual-invocation refusal is unimplemented.\\\"\\n    },\\n    {\\n      \\\"kind\\\": \\\"section_binding\\\",\\n      \\\"keys\\\": [\\n        \\\"section:11.10\\\"\\n      ],\\n      \\\"production\\\": {\\n        \\\"path\\\": \\\"internal/catalog/catalog.go\\\",\\n        \\\"declaration\\\": \\\"ForRelease\\\"\\n      },\\n      \\\"acceptance_cases\\\": [\\n        \\\"catalog-v060-exact\\\"\\n      ],\\n      \\\"coverage\\\": \\\"unevidenced\\\",\\n      \\\"gap\\\": \\\"ForRelease projects the Section 11.10 RPC-5 operation vocabulary only; the TLS 1.3 handshake, certificate checks, credential store and SSH launch it requires are unimplemented.\\\"\\n    },\\n    {\\n      \\\"kind\\\": \\\"section_binding\\\",\\n      \\\"keys\\\": [\\n        \\\"section:14.7\\\"\\n      ],\\n      \\\"production\\\": {\\n        \\\"path\\\": \\\"internal/cliresult/output.go\\\",\\n        \\\"declaration\\\": \\\"Emit\\\"\\n      },\\n      \\\"acceptance_cases\\\": [\\n        \\\"cli-result-envelope-exact\\\"\\n      ],\\n      \\\"coverage\\\": \\\"unevidenced\\\",\\n      \\\"gap\\\": \\\"Emit formats historical CLI result envelopes only; the Section 14.7 literal first-at source-qualified selector resolution and the CLI Result 5.0.0 envelope are unimplemented.\\\"\\n    }\\n  ],\\n  \\\"unowned_sections\\\": [''')\\n\\n# J. ten unowned disclosures for sections with no implementation layer at all\\nrep('''      \\\"evidence\\\": \\\"internal/localstore/projection.go opens, rebuilds and recovers the SQLite projection and installs immutable blobs; it declares no retention, expiry or garbage-collection behaviour, and the binding this entry replaces named OpenProjection with the same two storage acceptance cases already used by the Section 3.3 binding.\\\"\\n    }\\n  ]\\n}''',\\n'''      \\\"evidence\\\": \\\"internal/localstore/projection.go opens, rebuilds and recovers the SQLite projection and installs immutable blobs; it declares no retention, expiry or garbage-collection behaviour, and the binding this entry replaces named OpenProjection with the same two storage acceptance cases already used by the Section 3.3 binding.\\\"\\n    },\\n    {\\n      \\\"key\\\": \\\"section:11.10.1\\\",\\n      \\\"gap\\\": \\\"Section 11.10.1 requires SSH host-channel launch with exclusive TLS 1.3, ALPN ax-host/1 and full mutual certificate authentication; no launcher, TLS endpoint or handshake exists.\\\",\\n      \\\"evidence\\\": \\\"The repository carries no TLS, X.509 or SSH-launch code: provhost speaks the provider-plugin protocol over stdio, secprim checks argv, environment and paths, and the mesh RPC layer is catalog vocabulary without a transport.\\\"\\n    },\\n    {\\n      \\\"key\\\": \\\"section:11.10.2\\\",\\n      \\\"gap\\\": \\\"Section 11.10.2 requires certificate issuance into a machine-local trust store with enrolled roots and exact leaf checks; no issuance, store or enrollment implementation exists.\\\",\\n      \\\"evidence\\\": \\\"No certificate, key custody or trust-store code exists: internal/config reads TOML only, internal/localstore keeps blobs and a SQLite projection, and the two new pin fixtures are byte identities without a Go consumer.\\\"\\n    },\\n    {\\n      \\\"key\\\": \\\"section:11.10.3\\\",\\n      \\\"gap\\\": \\\"Section 11.10.3 requires credential rotation, revocation and authorization generations that refuse stale trust; no rotation or revocation implementation exists.\\\",\\n      \\\"evidence\\\": \\\"Nothing in the tree rotates or revokes credentials: there is no credential store to rotate, no revocation list reader, and no authorization-generation check outside the specification text.\\\"\\n    },\\n    {\\n      \\\"key\\\": \\\"section:11.10.4\\\",\\n      \\\"gap\\\": \\\"Section 11.10.4 bounds host-channel assurance and executable fixture conformance; no assurance measurement or host-channel fixture runner exists.\\\",\\n      \\\"evidence\\\": \\\"The pinned host_channel_conformance fixture is a lock identity only: internal/secconftest runs crash, hostile and fuzz harnesses over local surfaces and reads no upstream conformance fixture.\\\"\\n    },\\n    {\\n      \\\"key\\\": \\\"section:11.10.5\\\",\\n      \\\"gap\\\": \\\"Section 11.10.5 requires a public admission validator reading the closed JSON policy from SPEC.md on every invocation; no admission policy reader or validator exists.\\\",\\n      \\\"evidence\\\": \\\"No JSON-policy admission code exists: authorization checks in the tree are closed Go predicates over local state, and nothing parses the Section 11.10.5 policy table.\\\"\\n    },\\n    {\\n      \\\"key\\\": \\\"section:14.7.1\\\",\\n      \\\"gap\\\": \\\"Section 14.7.1 requires literal first-at source-qualified selector grammar with configured source-index resolution; no selector parser or source index exists.\\\",\\n      \\\"evidence\\\": \\\"No CLI session commands exist at all: the tree builds no ax binary, sessadapter SourceSelector validates directory-protocol members rather than CLI selectors, and Section 2.3 name precedence is shape validation only.\\\"\\n    },\\n    {\\n      \\\"key\\\": \\\"section:14.7.2\\\",\\n      \\\"gap\\\": \\\"Section 14.7.2 requires resolve-once fact binding with revalidation before execution; no selection planner or bound-fact store exists.\\\",\\n      \\\"evidence\\\": \\\"Nothing binds selection facts to execution: there is no selector resolver whose output could go stale, and no plan revalidation reads a source index.\\\"\\n    },\\n    {\\n      \\\"key\\\": \\\"section:14.7.3\\\",\\n      \\\"gap\\\": \\\"Section 14.7.3 binds the five Structured Error 1.4.0 codes to exits exclusively inside CLI Result 5; no Go mapping carries those codes.\\\",\\n      \\\"evidence\\\": \\\"The axerror registry is closed over Structured Error 1.0.0 through 1.3.0 with 109 codes; the 1.4.0 code-to-exit mapping has no implementation and no emitter.\\\"\\n    },\\n    {\\n      \\\"key\\\": \\\"section:14.7.4\\\",\\n      \\\"gap\\\": \\\"Section 14.7.4 requires interrupted record-only creation with authoritative bootstrap recovery; no chooser, bootstrap creation or recovery flow exists.\\\",\\n      \\\"evidence\\\": \\\"No session creation path exists in the tree: there is no CLI create command, no chooser, and no bootstrap lease issuance that an interruption could leave record-only.\\\"\\n    },\\n    {\\n      \\\"key\\\": \\\"section:14.7.5\\\",\\n      \\\"gap\\\": \\\"Section 14.7.5 bounds publication conformance and assurance for selector behavior; no publication validator or selector assurance harness exists.\\\",\\n      \\\"evidence\\\": \\\"Nothing validates selector publication: there is no selector implementation to publish, no conformance runner for the selector fixture, and the pinned selector fixture is a lock identity only.\\\"\\n    }\\n  ]\\n}''')\\n\\nopen(p, 'w').write(src)\\n\\nimport json\\no = json.load(open(p))\\nprint('valid JSON; cases:', len(o['acceptance_cases']), 'groups:', len(o['ownership']), 'unowned:', len(o['unowned_sections']))\\nPYEOF\",\n  \"description\": \"Append new bindings and unowned disclosures\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"valid JSON; cases: 101 groups: 61 unowned: 12\\n\",\n  \"original_output_bytes\": 46,\n  \"original_output_tokens\": 12,\n  \"truncated\": false\n}"}}}
