ed Go output without rewriting it\\\")\\n\\tif err := flags.Parse(arguments); err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tif *metadataPath == \\\"\\\" || *contractsPath == \\\"\\\" || *outputPath == \\\"\\\" {\\n\\t\\treturn fmt.Errorf(\\\"-metadata, -contracts, and -output are required\\\")\\n\\t}\\n\\n\\tmetadata, err := os.ReadFile(*metadataPath)\\n\\tif err != nil {\\n\\t\\treturn fmt.Errorf(\\\"read metadata: %w\\\", err)\\n\\t}\\n\\tcontracts, err := os.ReadFile(*contractsPath)\\n\\tif err != nil {\\n\\t\\treturn fmt.Errorf(\\\"read contract lock: %w\\\", err)\\n\\t}\\n\\tgenerated, err := cataloggen.Generate(metadata, contracts)\\n\\tif err != nil {\\n\\t\\treturn fmt.Errorf(\\\"generate catalog: %w\\\", err)\\n\\t}\\n\\tif *check {\\n\\t\\tif err := checkUnchanged(*outputPath, generated); err != nil {\\n\\t\\t\\treturn fmt.Errorf(\\\"check catalog: %w\\\", err)\\n\\t\\t}\\n\\t\\treturn nil\\n\\t}\\n\\tif err := writeIfChanged(*outputPath, generated); err != nil {\\n\\t\\treturn fmt.Errorf(\\\"write catalog: %w\\\", err)\\n\\t}\\n\\treturn nil\\n}\\n\\nfunc checkUnchanged(path string, content []byte) error {\\n\\texisting, err := os.ReadFile(path)\\n===\\ninternal/specpin/sections.go:192:\\t// SectionInventorySHA256V060 pins the newline-delimited section\\ninternal/specpin/sections.go:193:\\t// identifiers extracted from the exact v0.6.0 SPEC.md identified by\\ninternal/specpin/sections.go:194:\\t// DocumentSHA256V060, using the same rule as the v0.5.0 inventory:\\ninternal/specpin/sections.go:199:\\tSectionInventorySHA256V060 = \\\"2ef110e0f87c5d174bceafb33a0db981f5dc74a384f8b599f12b87cb4af2eb94\\\"\\ninternal/specpin/sections.go:200:\\tsectionInventoryV060       = `1\\ninternal/specpin/sections.go:373:var sectionInventorySetV060 = func() map[string]struct{} {\\ninternal/specpin/sections.go:374:\\tsections := strings.Fields(sectionInventoryV060)\\ninternal/specpin/sections.go:382:// SectionInventoryV060 returns an isolated ordered copy of every real section\