{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5b9","stream":{"kind":"session","id":"01a08707-ceef-7493-9b49-24effd76d285"},"sequence":311,"recorded_at":1780531400000617,"record_type":"event","durability":"durable","causation_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","run_stream":{"kind":"run","id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3"},"task_stream":{"kind":"task","id":"e72586ee-8d8a-4cdd-97a2-c24822878677"},"task_id":"e72586ee-8d8a-4cdd-97a2-c24822878677","event":{"kind":"output","task_id":"e72586ee-8d8a-4cdd-97a2-c24822878677","chunk":"{\n  \"chunk_id\": \"exec-10-1\",\n  \"command\": \"ls internal/catalog/cmd internal/traceability/cmd 2>&1; echo ===; cat internal/catalog/cmd/*/main.go 2>/dev/null | head -n 60; echo ===; grep -rn \\\"V060\\\\|v0\\\\.6\\\\.0\\\\|ReleaseV060\\\\|CurrentV060\\\\|VerifyV060\\\\|LoadV060\\\" --include=\\\"*.go\\\" internal/ | grep -v _test | head -n 60\",\n  \"description\": \"Find V060 usages and generator commands\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"internal/catalog/cmd:\\ncataloggen\\n\\ninternal/traceability/cmd:\\ntracecheck\\n===\\npackage main\\n\\nimport (\\n\\t\\\"bytes\\\"\\n\\t\\\"flag\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"io\\\"\\n\\t\\\"os\\\"\\n\\t\\\"path/filepath\\\"\\n\\n\\t\\\"github.com/relux-works/agent-session-manager/internal/cataloggen\\\"\\n)\\n\\nfunc main() {\\n\\tif err := run(os.Args[1:]); err != nil {\\n\\t\\tfmt.Fprintln(os.Stderr, err)\\n\\t\\tos.Exit(1)\\n\\t}\\n}\\n\\nfunc run(arguments []string) error {\\n\\tflags := flag.NewFlagSet(\\\"cataloggen\\\", flag.ContinueOnError)\\n\\tflags.SetOutput(io.Discard)\\n\\tmetadataPath := flags.String(\\\"metadata\\\", \\\"\\\", \\\"reviewed catalog metadata JSON\\\")\\n\\tcontractsPath := flags.String(\\\"contracts\\\", \\\"\\\", \\\"verified normative contract lock\\\")\\n\\toutputPath := flags.String(\\\"output\\\", \\\"\\\", \\\"generated Go output\\\")\\n\\tcheck := flags.Bool(\\\"check\\\", false, \\\"verify generated Go output without rewriting it\\\")\\n\\tif err := flags.Parse(arguments); err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tif *metadataPath == \\\"\\\" || *contractsPath == \\\"\\\" || *outputPath == \\\"\\\" {\\n\\t\\treturn fmt.Errorf(\\\"-metadata, -contracts, and -output are required\\\")\\n\\t}\\n\\n\\tmetadata, err := os.ReadFile(*metadataPath)\\n\\tif err != nil {\\n\\t\\treturn fmt.Errorf(\\\"read metadata: %w\\\", err)\\n\\t}\\n\\tcontracts, err := os.ReadFile(*contractsPath)\\n\\tif err != nil {\\n\\t\\treturn fmt.Errorf(\\\"read contract lock: %w\\\", err)\\n\\t}\\n\\tgenerated, err := cataloggen.Generate(metadata, contracts)\\n\\tif err != nil {\\n\\t\\treturn fmt.Errorf(\\\"generate catalog: %w\\\", err)\\n\\t}\\n\\tif *check {\\n\\t\\tif err := checkUnchanged(*outputPath, generated); err != nil {\\n\\t\\t\\treturn fmt.Errorf(\\\"check catalog: %w\\\", err)\\n\\t\\t}\\n\\t\\treturn nil\\n\\t}\\n\\tif err := writeIfChanged(*outputPath, generated); err != nil {\\n\\t\\treturn fmt.Errorf(\\\"write catalog: %w\\\", err)\\n\\t}\\n\\treturn nil\\n}\\n\\nfunc checkUnchanged(path string, content []byte) error {\\n\\texisting, err := os.ReadFile(path)\\n===\\ninternal/specpin/sections.go:192:\\t// SectionInventorySHA256V060 pins the newline-delimited section\\ninternal/specpin/sections.go:193:\\t// identifiers extracted from the exact v0.6.0 SPEC.md identified by\\ninternal/specpin/sections.go:194:\\t// DocumentSHA256V060, using the same rule as the v0.5.0 inventory:\\ninternal/specpin/sections.go:199:\\tSectionInventorySHA256V060 = \\\"2ef110e0f87c5d174bceafb33a0db981f5dc74a384f8b599f12b87cb4af2eb94\\\"\\ninternal/specpin/sections.go:200:\\tsectionInventoryV060       = `1\\ninternal/specpin/sections.go:373:var sectionInventorySetV060 = func() map[string]struct{} {\\ninternal/specpin/sections.go:374:\\tsections := strings.Fields(sectionInventoryV060)\\ninternal/specpin/sections.go:382:// SectionInventoryV060 returns an isolated ordered copy of every real section\\ninternal/specpin/sections.go:383:// identifier extracted from the pinned v0.6.0 document headings.\\ninternal/specpin/sections.go:384:func SectionInventoryV060() []string {\\ninternal/specpin/sections.go:385:\\treturn strings.Fields(sectionInventoryV060)\\ninternal/specpin/sections.go:388:// IsSectionV060 reports whether identifier is a real heading identifier in\\ninternal/specpin/sections.go:389:// the exact pinned v0.6.0 document. Callers must canonicalize user input\\ninternal/specpin/sections.go:391:func IsSectionV060(identifier string) bool {\\ninternal/specpin/sections.go:392:\\t_, ok := sectionInventorySetV060[identifier]\\ninternal/specpin/pin.go:41:// The v0.6.0 constants below adopt the independently accepted signed release\\ninternal/specpin/pin.go:42:// agent-session-manager-spec v0.6.0 (annotated tag object\\ninternal/specpin/pin.go:50:\\tReleaseV060 = \\\"v0.6.0\\\"\\ninternal/specpin/pin.go:51:\\tTagV060     = \\\"v0.6.0\\\"\\ninternal/specpin/pin.go:52:\\t// TagObjectV060 is the verified annotated tag object; CommitV060 is the\\ninternal/specpin/pin.go:55:\\tTagObjectV060 = \\\"40c123eb8399efa8e05cbc009110940ed861a785\\\"\\ninternal/specpin/pin.go:56:\\tCommitV060    = \\\"0cbdf100dbf84df50c64f792b1f940e3a67859a6\\\"\\ninternal/specpin/pin.go:57:\\t// DocumentSHA256V060 is the SHA-256 of the 1150005-byte SPEC.md blob at\\ninternal/specpin/pin.go:59:\\tDocumentSHA256V060 = \\\"74504539fb43c28ae3450622bc1002e643f116cd3e14df4567a882231e90896b\\\"\\ninternal/specpin/pin.go:72:\\t// ManifestSHA256V060 pins the exact v0.6.0 lock bytes embedded below.\\ninternal/specpin/pin.go:73:\\tManifestSHA256V060 = \\\"005cd4ffb5aba6792786727bf7d9fa59305191c81b210aae8d3d564d80661fb3\\\"\\ninternal/specpin/pin.go:87://go:embed v0.6.0.lock.json\\ninternal/specpin/pin.go:88:var embeddedPinV060 []byte\\ninternal/specpin/pin.go:147:// BytesV060 returns an isolated copy of the exact embedded v0.6.0 lock bytes.\\ninternal/specpin/pin.go:148:func BytesV060() []byte {\\ninternal/specpin/pin.go:149:\\treturn bytes.Clone(embeddedPinV060)\\ninternal/specpin/pin.go:156:// until the owning follow-up task regenerates them against v0.6.0. Callers\\ninternal/specpin/pin.go:157:// that need the adopted v0.6.0 authority use CurrentV060.\\ninternal/specpin/pin.go:162:// CurrentV060 returns a newly decoded copy of the embedded, verified v0.6.0\\ninternal/specpin/pin.go:164:func CurrentV060() (Manifest, error) {\\ninternal/specpin/pin.go:165:\\treturn VerifyV060(embeddedPinV060)\\ninternal/specpin/pin.go:206:// VerifyV060 accepts only the exact embedded v0.6.0 release lock. The v0.5.0\\ninternal/specpin/pin.go:209:func VerifyV060(candidate []byte) (Manifest, error) {\\ninternal/specpin/pin.go:215:\\tif err := validateV060(manifest); err != nil {\\ninternal/specpin/pin.go:220:\\tif hex.EncodeToString(digest[:]) != ManifestSHA256V060 {\\ninternal/specpin/pin.go:221:\\t\\treturn Manifest{}, mismatch(\\\"lock digest is not %s\\\", ManifestSHA256V060)\\ninternal/specpin/pin.go:231:// it for v0.6.0 is refused, because a stale pin cannot authorize a release\\ninternal/specpin/pin.go:232:// it predates. A v0.6.0 manifest represents v0.6.0, and derives the exact\\ninternal/specpin/pin.go:234:// projection drops the three v0.6.0 rows and trims the four widened version\\ninternal/specpin/pin.go:239:\\tcase ReleaseV060:\\ninternal/specpin/pin.go:240:\\t\\tif manifest.Source.Release != ReleaseV060 {\\ninternal/specpin/pin.go:245:\\t\\tif manifest.Source.Release == ReleaseV060 {\\ninternal/specpin/pin.go:286:// v060OnlyContractKeys are the registry rows the prepared v0.6.0 revision\\ninternal/specpin/pin.go:303:// v050VersionCeilings pins the exact versions each widened v0.6.0 row carried\\ninternal/specpin/pin.go:307:// other v0.6.0 row is byte-identical to its v0.5.0 self.\\ninternal/specpin/pin.go:318:// a verified v0.6.0 manifest: drop the three v0.6.0-only rows, trim the four\\ninternal/specpin/pin.go:405:// validateV060 accepts only the exact adopted v0.6.0 source identity: the\\ninternal/specpin/pin.go:409:// contract-identifier rule additionally admits the two namespaces the v0.6.0\\ninternal/specpin/pin.go:412:func validateV060(manifest Manifest) error {\\ninternal/specpin/pin.go:418:\\tif source.Repository != Repository || source.Release != ReleaseV060 || source.Tag != TagV060 ||\\ninternal/specpin/pin.go:419:\\t\\tsource.TagObject != TagObjectV060 || source.Commit != CommitV060 ||\\ninternal/specpin/pin.go:420:\\t\\tsource.Document.Path != DocumentPath || source.Document.SHA256 != DocumentSHA256V060 ||\\ninternal/specpin/pin.go:421:\\t\\tsource.SectionInventorySHA256 != SectionInventorySHA256V060 {\\ninternal/specpin/pin.go:473:\\t\\t\\treturn mismatch(\\\"v0.6.0 delta row %q is missing or drifted\\\", contract.Name)\\ninternal/specpin/pin.go:481:\\tif !reflect.DeepEqual(compatibility.AbsentContracts, expectedAbsentContractsV060()) {\\n\",\n  \"original_output_bytes\": 7183,\n  \"original_output_tokens\": 1796,\n  \"truncated\": false\n}"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5bb","stream":{"kind":"session","id":"01a08707-ceef-7493-9b49-24effd76d285"},"sequence":312,"recorded_at":1780531400000619,"record_type":"event","durability":"durable","causation_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","run_stream":{"kind":"run","id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3"},"task_stream":{"kind":"task","id":"e72586ee-8d8a-4cdd-97a2-c24822878677"},"task_id":"e72586ee-8d8a-4cdd-97a2-c24822878677","event":{"kind":"completed","task_id":"e72586ee-8d8a-4cdd-97a2-c24822878677"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5bd","stream":{"kind":"session","id":"01a08707-ceef-7493-9b49-24effd76d285"},"sequence":313,"recorded_at":1780531400000621,"record_type":"event","durability":"durable","causation_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","run_stream":{"kind":"run","id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3"},"call_id":"call_01a0870867037d22abfd7642c55e836f","text":"Read text file `internal/catalog/catalog.go`.\n1|// Package catalog exposes generated, typed vocabularies from the reviewed AX\n2|// implementation metadata. Catalog membership defines a contract vocabulary;\n3|// it never advertises runtime availability or implementation support.\n4|package catalog\n5|\n6|import (\n7|\t\"errors\"\n8|\t\"fmt\"\n9|)\n10|\n11|const (\n12|\tFormat        = \"ax-implementation-catalog\"\n13|\tFormatVersion = 1\n14|\n15|\tReleaseV043 Release = \"v0.4.3\"\n16|\tReleaseV050 Release = \"v0.5.0\"\n17|)\n18|\n19|var ErrUnsupportedRelease = errors.New(\"unsupported catalog release\")\n20|\n21|// Release identifies a specification package release represented by the\n22|// reviewed implementation metadata.\n23|type Release string\n24|\n25|// ContractID is a registered AX schema or protocol identifier.\n26|type ContractID string\n27|\n28|// Family scopes operation, capability, and event names that may otherwise\n29|// overlap across independent contracts.\n30|type Family string\n31|\n32|// OperationName is one closed operation-registry member.\n33|type OperationName string\n34|\n35|// CapabilityName is one manifest/probe capability-vocabulary member. It does\n36|// not imply that the capability is available.\n37|type CapabilityName string\n38|\n39|// EventName is one closed Session Event or required Observation Event member.\n40|type EventName string\n41|\n42|// ErrorName is one stable Structured Error code.\n43|type ErrorName string\n44|\n45|// Source binds every generated definition to the immutable normative source.\n46|type Source struct {\n47|\tRepository     string\n48|\tRelease        Release\n49|\tCommit         string\n50|\tDocumentPath   string\n51|\tDocumentSHA256 string\n52|\tNormativeScope []string\n53|}\n54|\n55|// Contract is one independently versioned schema or protocol contract.\n56|type Contract struct {\n57|\tName     string\n58|\tID       ContractID\n59|\tVersions []string\n60|}\n61|\n62|// SelfIdentityContract defines the schema-directed JCS omit-self rule for an\n63|// immutable logical object. Membership is reviewed metadata from the pinned\n64|// specification; it does not imply that any wider schema behavior is\n65|// implemented.\n66|type SelfIdentityContract struct {\n67|\tContractID         ContractID\n68|\tContractVersions   []string\n69|\tSelfField          string\n70|\tDiscriminatorName  string\n71|\tDiscriminatorValue string\n72|\tNormativeSection   string\n73|}\n74|\n75|// OperationEffect classifies whether an operation mutates authoritative\n76|// durable state. Isolated output is restricted to caller-created sinks and is\n77|// not an authoritative state transition.\n78|type OperationEffect string\n79|\n80|const (\n81|\t// EffectNoDurableMutation makes no stronger read-only claim: an operation\n82|\t// may still plan work or control an ephemeral process.\n83|\tEffectNoDurableMutation OperationEffect = \"no_durable_mutation\"\n84|\tEffectIsolatedOutput    OperationEffect = \"isolated_output\"\n85|\tEffectDurableMutation   OperationEffect = \"durable_mutation\"\n86|)\n87|\n88|// Operation is a typed protocol/query operation definition. Durable mutations\n89|// always carry both an exact idempotency scope and recovery evidence.\n90|type Operation struct {\n91|\tFamily           Family\n92|\tName             OperationName\n93|\tContractID       ContractID\n94|\tContractVersions []string\n95|\tEffect           OperationEffect\n96|\tIdempotencyKey   string\n97|\tRecoveryEvidence []string\n98|\tNormativeSection string\n99|\tFixtureFamilies  []string\n100|}\n101|\n102|// Capability is a vocabulary definition only. Availability, status, enabled,\n103|// and support claims deliberately do not exist in this type.\n104|type Capability struct {\n105|\tFamily           Family\n106|\tName             CapabilityName\n107|\tContractID       ContractID\n108|\tContractVersions []string\n109|\tNormativeSection string\n110|\tFixtureFamilies  []string\n111|}\n112|\n113|// Event is a required event name and the exact contract versions that define\n114|// it. Session Events and Observation Events remain separate families.\n115|type Event struct {\n116|\tFamily           Family\n117|\tName             EventName\n118|\tContractID       ContractID\n119|\tContractVersions []string\n120|\tNormativeSection string\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5bf","stream":{"kind":"session","id":"01a08707-ceef-7493-9b49-24effd76d285"},"sequence":314,"recorded_at":1780531400000623,"record_type":"event","durability":"durable","causation_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","run_stream":{"kind":"run","id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3"},"call_id":"call_01a0870867b47da3bc3819151181a7d1","text":"Read text file `internal/cigate/contracts.go`.\n1|package cigate\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"sort\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/specpin\"\n9|)\n10|\n11|// ContractVersions is one pinned contract with its exact ordered versions.\n12|type ContractVersions struct {\n13|\tName     string\n14|\tID       string\n15|\tVersions []string\n16|}\n17|\n18|// ReleaseContracts binds one release to its full derived contract set.\n19|type ReleaseContracts struct {\n20|\tRelease   string\n21|\tContracts []ContractVersions\n22|}\n23|\n24|// PinnedReleases returns the releases both authorities represent, after\n25|// requiring the two packages to agree on the release roots themselves. It\n26|// lists no versions: every version below these roots is derived, never\n27|// retyped.\n28|func PinnedReleases() ([]string, error) {\n29|\treturn checkReleaseRoots(specpin.ReleaseV050, specpin.ReleaseV043,\n30|\t\tstring(catalog.ReleaseV050), string(catalog.ReleaseV043))\n31|}\n32|\n33|// checkReleaseRoots is the testable core of PinnedReleases: production passes\n34|// the two packages' release constants, tests pass synthetic roots. Either\n35|// side renaming a release without the other is drift, not a wider registry,\n36|// and is refused.\n37|func checkReleaseRoots(pinCurrent, pinHistorical, catalogCurrent, catalogHistorical string) ([]string, error) {\n38|\tif pinCurrent != catalogCurrent {\n39|\t\treturn nil, fmt.Errorf(\"cigate: current release root drift: specpin %q catalog %q\",\n40|\t\t\tpinCurrent, catalogCurrent)\n41|\t}\n42|\tif pinHistorical != catalogHistorical {\n43|\t\treturn nil, fmt.Errorf(\"cigate: historical release root drift: specpin %q catalog %q\",\n44|\t\t\tpinHistorical, catalogHistorical)\n45|\t}\n46|\tif pinCurrent == \"\" || pinHistorical == \"\" || pinCurrent == pinHistorical {\n47|\t\treturn nil, fmt.Errorf(\"cigate: release roots are empty or indistinct\")\n48|\t}\n49|\treturn []string{pinCurrent, pinHistorical}, nil\n50|}\n51|\n52|// PinContractSets derives every pinned (contract, version) set from the\n53|// embedded specification lock, keyed by release. The historical projection\n54|// comes from ContractsForRelease, so absent contracts and version overrides\n55|// are the lock's own, not a retyped copy.\n56|func PinContractSets() (map[string][]ContractVersions, error) {\n57|\tmanifest, err := specpin.Current()\n58|\tif err != nil {\n59|\t\treturn nil, fmt.Errorf(\"cigate: load pinned source: %w\", err)\n60|\t}\n61|\treturn pinContractSets(manifest)\n62|}\n63|\n64|// pinContractSets is the testable core over an explicit manifest: production\n65|// passes the embedded one, tests pass synthetic ones.\n66|func pinContractSets(manifest specpin.Manifest) (map[string][]ContractVersions, error) {\n67|\treleases, err := PinnedReleases()\n68|\tif err != nil {\n69|\t\treturn nil, err\n70|\t}\n71|\tsets := make(map[string][]ContractVersions, len(releases))\n72|\tfor _, release := range releases {\n73|\t\tcontracts, err := manifest.ContractsForRelease(release)\n74|\t\tif err != nil {\n75|\t\t\treturn nil, fmt.Errorf(\"cigate: derive pinned %s contracts: %w\", release, err)\n76|\t\t}\n77|\t\tsets[release] = fromPinContracts(contracts)\n78|\t}\n79|\treturn sets, nil\n80|}\n81|\n82|// CatalogContractSets derives every (contract, version) set from the\n83|// generated catalog projections, keyed by release.\n84|func CatalogContractSets() (map[string][]ContractVersions, error) {\n85|\treleases, err := PinnedReleases()\n86|\tif err != nil {\n87|\t\treturn nil, err\n88|\t}\n89|\tsets := make(map[string][]ContractVersions, len(releases))\n90|\tfor _, release := range releases {\n91|\t\tprojected, err := catalog.ForRelease(catalog.Release(release))\n92|\t\tif err != nil {\n93|\t\t\treturn nil, fmt.Errorf(\"cigate: derive catalog %s contracts: %w\", release, err)\n94|\t\t}\n95|\t\tconverted := make([]ContractVersions, 0, len(projected.Contracts))\n96|\t\tfor _, contract := range projected.Contracts {\n97|\t\t\tconverted = append(converted, ContractVersions{\n98|\t\t\t\tName:     contract.Name,\n99|\t\t\t\tID:       string(contract.ID),\n100|\t\t\t\tVersions: append([]string(nil), contract.Versions...),\n101|\t\t\t})\n102|\t\t}\n103|\t\tsets[release] = converted\n104|\t}\n105|\treturn sets, nil\n106|}\n107|\n108|// VerifyContractPreservation requires the pinned lock and the generated\n109|// catalog to agree exactly on every release: same contracts, same\n110|// identifiers, same ordered versions. A version either side cannot account\n111|// for is refused with its name, not averaged away. It reports the first\n112|// disagreement; CI reruns are cheap and deterministic.\n113|func VerifyContractPreservation() error {\n114|\tpinned, err := PinContractSets()\n115|\tif err != nil {\n116|\t\treturn err\n117|\t}\n118|\tprojected, err := CatalogContractSets()\n119|\tif err != nil {\n120|\t\treturn err\n121|\t}\n122|\treturn checkAgreement(pinned, projected)\n123|}\n124|\n125|// checkAgreement is the testable core over explicit sets: production passes\n126|// the derived ones, tests pass synthetic ones.\n127|func checkAgreement(pinned, projected map[string][]ContractVersions) error {\n128|\treleases, err := PinnedReleases()\n129|\tif err != nil {\n130|\t\treturn err\n131|\t}\n132|\tfor _, release := range releases {\n133|\t\twant, ok := pinned[release]\n134|\t\tif !ok {\n135|\t\t\treturn fmt.Errorf(\"cigate: pinned authority accounts for no %s set\", release)\n136|\t\t}\n137|\t\tgot, ok := projected[release]\n138|\t\tif !ok {\n139|\t\t\treturn fmt.Errorf(\"cigate: catalog authority accounts for no %s set\", release)\n140|\t\t}\n141|\t\tif err := checkReleaseSet(release, want, got); err != nil {\n142|\t\t\treturn err\n143|\t\t}\n144|\t}\n145|\treturn nil\n146|}\n147|\n148|func checkReleaseSet(release string, pinned, projected []ContractVersions) error {\n149|\twant := indexContracts(pinned)\n150|\tgot := indexContracts(projected)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
