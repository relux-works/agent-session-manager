{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c56f","stream":{"kind":"session","id":"01a08707-ceef-7493-9b49-24effd76d285"},"sequence":274,"recorded_at":1780531400000543,"record_type":"event","durability":"durable","causation_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","run_stream":{"kind":"run","id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3"},"task_stream":{"kind":"task","id":"74d4be55-3ecf-4d0f-8b00-a940f8b6a039"},"task_id":"74d4be55-3ecf-4d0f-8b00-a940f8b6a039","event":{"kind":"output","task_id":"74d4be55-3ecf-4d0f-8b00-a940f8b6a039","chunk":"Read text file `internal/cataloggen/generate.go`.\n1|// Package cataloggen validates reviewed AX implementation metadata and emits\n2|// the deterministic typed Go catalog consumed by internal/catalog.\n3|package cataloggen\n4|\n5|import (\n6|\t\"bytes\"\n7|\t\"crypto/sha256\"\n8|\t\"encoding/hex\"\n9|\t\"encoding/json\"\n10|\t\"errors\"\n11|\t\"fmt\"\n12|\t\"go/format\"\n13|\t\"io\"\n14|\t\"regexp\"\n15|\t\"strconv\"\n16|\t\"strings\"\n17|\n18|\t\"github.com/relux-works/agent-session-manager/internal/specpin\"\n19|)\n20|\n21|const (\n22|\tmetadataFormat                  = \"ax-implementation-catalog\"\n23|\tmetadataFormatVersion           = 1\n24|\treviewedMetadataCanonicalSHA256 = \"7bbc5172fbd77216ef4888126787a91a2aabea63b8aa308a9a8ac2ccbc1e5bab\"\n25|)\n26|\n27|var ErrInvalidMetadata = errors.New(\"invalid implementation catalog metadata\")\n28|\n29|type metadata struct {\n30|\tFormat             string                 `json:\"format\"`\n31|\tFormatVersion      int                    `json:\"format_version\"`\n32|\tSource             sourceMetadata         `json:\"source\"`\n33|\tNormativeScope     []string               `json:\"normative_scope\"`\n34|\tSelfIdentities     []selfIdentityContract `json:\"self_identity_contracts\"`\n35|\tOperationFamilies  []operationFamily      `json:\"operation_families\"`\n36|\tCapabilityFamilies []capabilityFamily     `json:\"capability_families\"`\n37|\tEventFamilies      []eventFamily          `json:\"event_families\"`\n38|\tErrorCatalog       errorCatalog           `json:\"error_catalog\"`\n39|}\n40|\n41|type selfIdentityContract struct {\n42|\tContractID         string   `json:\"contract_id\"`\n43|\tContractVersions   []string `json:\"contract_versions\"`\n44|\tSelfField          string   `json:\"self_field\"`\n45|\tReleases           []string `json:\"releases\"`\n46|\tDiscriminatorName  string   `json:\"discriminator_name,omitempty\"`\n47|\tDiscriminatorValue string   `json:\"discriminator_value,omitempty\"`\n48|\tNormativeSection   string   `json:\"normative_section\"`\n49|}\n50|\n51|type sourceMetadata struct {\n52|\tRepository     string `json:\"repository\"`\n53|\tRelease        string `json:\"release\"`\n54|\tCommit         string `json:\"commit\"`\n55|\tDocumentPath   string `json:\"document_path\"`\n56|\tDocumentSHA256 string `json:\"document_sha256\"`\n57|}\n58|\n59|type operationFamily struct {\n60|\tFamily           string          `json:\"family\"`\n61|\tContractID       string          `json:\"contract_id\"`\n62|\tContractVersions []string        `json:\"contract_versions\"`\n63|\tReleases         []string        `json:\"releases\"`\n64|\tNormativeSection string          `json:\"normative_section\"`\n65|\tFixtureFamilies  []string        `json:\"fixture_families\"`\n66|\tOperations       []string        `json:\"operations\"`\n67|\tIsolatedOutputs  []string        `json:\"isolated_outputs\"`\n68|\tMutationGroups   []mutationGroup `json:\"mutation_groups\"`\n69|}\n70|\n71|type mutationGroup struct {\n72|\tOperations       []string `json:\"operations\"`\n73|\tIdempotencyKey   string   `json:\"idempotency_key\"`\n74|\tRecoveryEvidence []string `json:\"recovery_evidence\"`\n75|}\n76|\n77|type capabilityFamily struct {\n78|\tFamily           string   `json:\"family\"`\n79|\tContractID       string   `json:\"contract_id\"`\n80|\tContractVersions []string `json:\"contract_versions\"`\n81|\tReleases         []string `json:\"releases\"`\n82|\tNormativeSection string   `json:\"normative_section\"`\n83|\tFixtureFamilies  []string `json:\"fixture_families\"`\n84|\tCapabilities     []string `json:\"capabilities\"`\n85|}\n86|\n87|type eventFamily struct {\n88|\tFamily           string       `json:\"family\"`\n89|\tContractID       string       `json:\"contract_id\"`\n90|\tReleases         []string     `json:\"releases\"`\n91|\tNormativeSection string       `json:\"normative_section\"`\n92|\tFixtureFamilies  []string     `json:\"fixture_families\"`\n93|\tGroups           []eventGroup `json:\"groups\"`\n94|}\n95|\n96|type eventGroup struct {\n97|\tContractVersions []string `json:\"contract_versions\"`\n98|\tEvents           []string `json:\"events\"`\n99|}\n100|\n101|type errorCatalog struct {\n102|\tContractID       string       `json:\"contract_id\"`\n103|\tContractVersions []string     `json:\"contract_versions\"`\n104|\tNormativeSection string       `json:\"normative_section\"`\n105|\tFixtureFamilies  []string     `json:\"fixture_families\"`\n106|\tGroups           []errorGroup `json:\"groups\"`\n107|}\n108|\n109|type errorGroup struct {\n110|\tIntroducedVersion string         `json:\"introduced_version\"`\n111|\tReleases          []string       `json:\"releases\"`\n112|\tMappings          []errorMapping `json:\"mappings\"`\n113|}\n114|\n115|type errorMapping struct {\n116|\tExitCode int      `json:\"exit_code\"`\n117|\tCodes    []string `json:\"codes\"`\n118|}\n119|\n120|type expandedOperation struct {\n121|\tFamily           string\n122|\tName             string\n123|\tContractID       string\n124|\tContractVersions []string\n125|\tEffect           string\n126|\tIdempotencyKey   string\n127|\tRecoveryEvidence []string\n128|\tNormativeSection string\n129|\tFixtureFamilies  []string\n130|\tReleases         []string\n131|}\n132|\n133|type expandedCapability struct {\n134|\tFamily           string\n135|\tName             string\n136|\tContractID       string\n137|\tContractVersions []string\n138|\tNormativeSection string\n139|\tFixtureFamilies  []string\n140|\tReleases         []string\n141|}\n142|\n143|type expandedEvent struct {\n144|\tFamily           string\n145|\tName             string\n146|\tContractID       string\n147|\tContractVersions []string\n148|\tNormativeSection string\n149|\tFixtureFamilies  []string\n150|\tReleases         []string\n151|}\n152|\n153|type expandedError struct {\n154|\tCode             string\n155|\tExitCode         int\n156|\tContractID       string\n157|\tContractVersions []string\n158|\tNormativeSection string\n159|\tFixtureFamilies  []string\n160|\tReleases         []string\n161|}\n162|\n163|var (\n164|\tnamePattern       = regexp.MustCompile(`^[a-z][a-z0-9_.-]*$`)\n165|\tcapabilityPattern = regexp.MustCompile(`^[a-z][a-z0-9_]*$`)\n166|\terrorPattern      = regexp.MustCompile(`^[a-z][a-z0-9_]*$`)\n167|)\n168|\n169|// Generate is the production generation entry point. It is pure: callers own\n170|// any output write and receive no partial artifact on validation failure.\n171|func Generate(metadataBytes, contractLock []byte) ([]byte, error) {\n172|\tmanifest, err := specpin.Verify(contractLock)\n173|\tif err != nil {\n174|\t\treturn nil, invalid(\"verify normative lock: %v\", err)\n175|\t}\n176|\tdecoded, err := decodeMetadata(metadataBytes)\n177|\tif err != nil {\n178|\t\treturn nil, err\n179|\t}\n180|\tif err := validateMetadata(decoded, manifest); err != nil {\n181|\t\treturn nil, err\n182|\t}\n183|\n184|\toperations := expandOperations(decoded.OperationFamilies)\n185|\tcapabilities := expandCapabilities(decoded.CapabilityFamilies)\n186|\tevents := expandEvents(decoded.EventFamilies)\n187|\terrorsCatalog := expandErrors(decoded.ErrorCatalog)\n188|\tdigest := sha256.Sum256(metadataBytes)\n189|\n190|\tvar output bytes.Buffer\n191|\toutput.WriteString(\"// Code generated by go generate ./internal/catalog; DO NOT EDIT.\\n\")\n192|\tfmt.Fprintf(&output, \"// Metadata SHA-256: %s\\n\\n\", hex.EncodeToString(digest[:]))\n193|\toutput.WriteString(\"package catalog\\n\\n\")\n194|\toutput.WriteString(\"var generatedDefinition = catalogDefinition{\\n\")\n195|\twriteSource(&output, decoded)\n196|\tfmt.Fprintf(&output, \"\\tMetadataSHA256: %q,\\n\", hex.EncodeToString(digest[:]))\n197|\twriteContracts(&output, manifest)\n198|\twriteSelfIdentities(&output, decoded.SelfIdentities)\n199|\twriteOperations(&output, operations)\n200|\twriteCapabilities(&output, capabilities)\n201|\twriteEvents(&output, events)\n202|\twriteErrors(&output, errorsCatalog)\n203|\toutput.WriteString(\"}\\n\")\n204|\n205|\tformatted, err := format.Source(output.Bytes())\n206|\tif err != nil {\n207|\t\treturn nil, invalid(\"format generated Go: %v\", err)\n208|\t}\n209|\treturn formatted, nil\n210|}\n211|\n212|func decodeMetadata(candidate []byte) (metadata, error) {\n213|\tvar decoded metadata\n214|\tdecoder := json.NewDecoder(bytes.NewReader(candidate))\n215|\tdecoder.DisallowUnknownFields()\n216|\tif err := decoder.Decode(&decoded); err != nil {\n217|\t\treturn metadata{}, invalid(\"decode metadata: %v\", err)\n218|\t}\n219|\tvar trailing any\n220|\tif err := decoder.Decode(&trailing); !errors.Is(err, io.EOF) {\n221|\t\tif err == nil {\n222|\t\t\treturn metadata{}, invalid(\"multiple JSON values\")\n223|\t\t}\n224|\t\treturn metadata{}, invalid(\"trailing JSON: %v\", err)\n225|\t}\n226|\treturn decoded, nil\n227|}\n228|\n229|func validateMetadata(value metadata, manifest specpin.Manifest) error {\n230|\tif value.Format != metadataFormat || value.FormatVersion != metadataFormatVersion {\n231|\t\treturn invalid(\"unsupported format %q version %d\", value.Format, value.FormatVersion)\n232|\t}\n233|\tif value.Source.Repository != manifest.Source.Repository ||\n234|\t\tvalue.Source.Release != manifest.Source.Release ||\n235|\t\tvalue.Source.Commit != manifest.Source.Commit ||\n236|\t\tvalue.Source.DocumentPath != manifest.Source.Document.Path ||\n237|\t\tvalue.Source.DocumentSHA256 != manifest.Source.Document.SHA256 {\n238|\t\treturn invalid(\"source identity differs from verified normative lock\")\n239|\t}\n240|\tif !equalStrings(value.NormativeScope, manifest.Source.NormativeScope) {\n241|\t\treturn invalid(\"normative scope differs from verified source pin\")\n242|\t}\n243|\tif len(value.OperationFamilies) == 0 || len(value.CapabilityFamilies) == 0 || len(value.EventFamilies) == 0 {\n244|\t\treturn invalid(\"operation, capability, and event catalogs must all be present\")\n245|\t}\n246|\n247|\tcontracts := make(map[string]map[string]struct{})\n248|\tfor _, contract := range manifest.Contracts {\n249|\t\tversions := contracts[contract.ID]\n250|\t\tif versions == nil {\n251|\t\t\tversions = make(map[string]struct{})\n252|\t\t\tcontracts[contract.ID] = versions\n253|\t\t}\n254|\t\tfor _, version := range contract.Versions {\n255|\t\t\tversions[version] = struct{}{}\n256|\t\t}\n257|\t}\n258|\treleaseContracts, err := releaseContractVersions(manifest)\n259|\tif err != nil {\n260|\t\treturn invalid(\"build release contract projections: %v\", err)\n261|\t}\n262|\tif len(value.SelfIdentities) == 0 {\n263|\t\treturn invalid(\"self-identity contract catalog must be present\")\n264|\t}\n265|\tseenSelfIdentities := make(map[string]struct{})\n266|\tfor index, identity := range value.SelfIdentities {\n267|\t\tif err := validateContractBinding(identity.ContractID, identity.ContractVersions, contracts); err != nil {\n268|\t\t\treturn invalid(\"self-identity contract %d: %v\", index, err)\n269|\t\t}\n270|\t\tif err := validateReleases(identity.Releases); err != nil {\n271|\t\t\treturn invalid(\"self-identity contract %d: %v\", index, err)\n272|\t\t}\n273|\t\tif err := validateReleaseBinding(identity.ContractID, identity.ContractVersions, identity.Releases, releaseContracts); err != nil {\n274|\t\t\treturn invalid(\"self-identity contract %d: %v\", index, err)\n275|\t\t}\n276|\t\tif !capabilityPattern.MatchString(identity.SelfField) || identity.NormativeSection == \"\" {\n277|\t\t\treturn invalid(\"self-identity contract %d has invalid self field or normative section\", index)\n278|\t\t}\n279|\t\tif (identity.DiscriminatorName == \"\") != (identity.DiscriminatorValue == \"\") ||\n280|\t\t\t(identity.DiscriminatorName != \"\" && !capabilityPattern.MatchString(identity.DiscriminatorName)) {\n281|\t\t\treturn invalid(\"self-identity contract %d has incomplete or invalid discriminator\", index)\n282|\t\t}\n283|\t\tfor _, version := range identity.ContractVersions {\n284|\t\t\tkey := identity.ContractID + \"\\x00\" + version\n285|\t\t\tif _, duplicate := seenSelfIdentities[key]; duplicate {\n286|\t\t\t\treturn invalid(\"self-identity catalog repeats contract %q version %q\", identity.ContractID, version)\n287|\t\t\t}\n288|\t\t\tseenSelfIdentities[key] = struct{}{}\n289|\t\t}\n290|\t}\n291|\n292|\tseenFamilies := make(map[string]struct{})\n293|\tfor index, family := range value.OperationFamilies {\n294|\t\tif err := validateFamilyHeader(\"operation\", index, family.Family, family.ContractID, family.ContractVersions, family.Releases, family.NormativeSection, family.FixtureFamilies, contracts, releaseContracts, seenFamilies); err != nil {\n295|\t\t\treturn err\n296|\t\t}\n297|\t\tif len(family.Operations) == 0 {\n298|\t\t\treturn invalid(\"operation family %q is empty\", family.Family)\n299|\t\t}\n300|\t\toperationSet, err := uniqueNames(\"operation \"+family.Family, family.Operations, namePattern)\n301|\t\tif err != nil {\n302|\t\t\treturn err\n303|\t\t}\n304|\t\tisolated, err := uniqueNames(\"isolated output \"+family.Family, family.IsolatedOutputs, namePattern)\n305|\t\tif err != nil {\n306|\t\t\treturn err\n307|\t\t}\n308|\t\tfor name := range isolated {\n309|\t\t\tif _, ok := operationSet[name]; !ok {\n310|\t\t\t\treturn invalid(\"operation family %q isolates unknown operation %q\", family.Family, name)\n311|\t\t\t}\n312|\t\t}\n313|\t\tmutations := make(map[string]struct{})\n314|\t\tfor groupIndex, group := range family.MutationGroups {\n315|\t\t\tif len(group.Operations) == 0 || group.IdempotencyKey == \"\" || len(group.RecoveryEvidence) == 0 {\n316|\t\t\t\treturn invalid(\"operation family %q mutation group %d lacks operations, idempotency, or recovery evidence\", family.Family, groupIndex)\n317|\t\t\t}\n318|\t\t\tif hasEmpty(group.RecoveryEvidence) {\n319|\t\t\t\treturn invalid(\"operation family %q mutation group %d has empty recovery evidence\", family.Family, groupIndex)\n320|\t\t\t}\n321|\t\t\tfor _, name := range group.Operations {\n322|\t\t\t\tif _, ok := operationSet[name]; !ok {\n323|\t\t\t\t\treturn invalid(\"operation family %q marks unknown operation %q durable\", family.Family, name)\n324|\t\t\t\t}\n325|\t\t\t\tif _, ok := isolated[name]; ok {\n326|\t\t\t\t\treturn invalid(\"operation family %q operation %q is both isolated and durable\", family.Family, name)\n327|\t\t\t\t}\n328|\t\t\t\tif _, duplicate := mutations[name]; duplicate {\n329|\t\t\t\t\treturn invalid(\"operation family %q repeats durable operation %q\", family.Family, name)\n330|\t\t\t\t}\n331|\t\t\t\tmutations[name] = struct{}{}\n332|\t\t\t}\n333|\t\t}\n334|\t}\n335|\n336|\tseenFamilies = make(map[string]struct{})\n337|\tfor index, family := range value.CapabilityFamilies {\n338|\t\tif err := validateFamilyHeader(\"capability\", index, family.Family, family.ContractID, family.ContractVersions, family.Releases, family.NormativeSection, family.FixtureFamilies, contracts, releaseContracts, seenFamilies); err != nil {\n339|\t\t\treturn err\n340|\t\t}\n341|\t\tif len(family.Capabilities) == 0 {\n342|\t\t\treturn invalid(\"capability family %q is empty\", family.Family)\n343|\t\t}\n344|\t\tif _, err := uniqueNames(\"capability \"+family.Family, family.Capabilities, capabilityPattern); err != nil {\n345|\t\t\treturn err\n346|\t\t}\n347|\t}\n348|\n349|\tseenFamilies = make(map[string]struct{})\n350|\tfor index, family := range value.EventFamilies {\n351|\t\tif family.Family == \"\" || family.ContractID == \"\" || family.NormativeSection == \"\" || len(family.FixtureFamilies) == 0 {\n352|\t\t\treturn invalid(\"event family %d has incomplete header\", index)\n353|\t\t}\n354|\t\tif _, duplicate := seenFamilies[family.Family]; duplicate {\n355|\t\t\treturn invalid(\"duplicate event family %q\", family.Family)\n356|\t\t}\n357|\t\tseenFamilies[family.Family] = struct{}{}\n358|\t\tif err := validateReleases(family.Releases); err != nil {\n359|\t\t\treturn invalid(\"event family %q: %v\", family.Family, err)\n360|\t\t}\n361|\t\tseenEvents := make(map[string]struct{})\n362|\t\tif len(family.Groups) == 0 {\n363|\t\t\treturn invalid(\"event family %q is empty\", family.Family)\n364|\t\t}\n365|\t\tfor groupIndex, group := range family.Groups {\n366|\t\t\tif err := validateContractBinding(family.ContractID, group.ContractVersions, contracts); err != nil {\n367|\t\t\t\treturn invalid(\"event family %q group %d: %v\", family.Family, groupIndex, err)\n368|\t\t\t}\n369|\t\t\tif err := validateReleaseBinding(family.ContractID, group.ContractVersions, family.Releases, releaseContracts); err != nil {\n370|\t\t\t\treturn invalid(\"event family %q group %d: %v\", family.Family, groupIndex, err)\n371|\t\t\t}\n372|\t\t\tif len(group.Events) == 0 {\n373|\t\t\t\treturn invalid(\"event family %q group %d is empty\", family.Family, groupIndex)\n374|\t\t\t}\n375|\t\t\tfor _, name := range group.Events {\n376|\t\t\t\tif !namePattern.MatchString(name) {\n377|\t\t\t\t\treturn invalid(\"event family %q has invalid event %q\", family.Family, name)\n378|\t\t\t\t}\n379|\t\t\t\tif _, duplicate := seenEvents[name]; duplicate {\n380|\t\t\t\t\treturn invalid(\"event family %q repeats event %q\", family.Family, name)\n381|\t\t\t\t}\n382|\t\t\t\tseenEvents[name] = struct{}{}\n383|\t\t\t}\n384|\t\t}\n385|\t}\n386|\n387|\tif value.ErrorCatalog.ContractID == \"\" || value.ErrorCatalog.NormativeSection == \"\" || len(value.ErrorCatalog.FixtureFamilies) == 0 {\n388|\t\treturn invalid(\"error catalog has incomplete header\")\n389|\t}\n390|\tif err := validateContractBinding(value.ErrorCatalog.ContractID, value.ErrorCatalog.ContractVersions, contracts); err != nil {\n391|\t\treturn invalid(\"error catalog: %v\", err)\n392|\t}\n393|\tversionIndex := make(map[string]int, len(value.ErrorCatalog.ContractVersions))\n394|\tfor index, version := range value.ErrorCatalog.ContractVersions {\n395|\t\tversionIndex[version] = index\n396|\t}\n397|\tif len(value.ErrorCatalog.Groups) != len(value.ErrorCatalog.ContractVersions) {\n398|\t\treturn invalid(\"error catalog must define one introduced-code group per contract version\")\n399|\t}\n400|\tseenCodes := make(map[string]struct{})\n401|\tfor groupIndex, group := range value.ErrorCatalog.Groups {\n402|\t\tif group.IntroducedVersion != value.ErrorCatalog.ContractVersions[groupIndex] {\n403|\t\t\treturn invalid(\"error group %d is not the ordered contract version %q\", groupIndex, value.ErrorCatalog.ContractVersions[groupIndex])\n404|\t\t}\n405|\t\tif _, ok := versionIndex[group.IntroducedVersion]; !ok {\n406|\t\t\treturn invalid(\"error group %d introduces unsupported version %q\", groupIndex, group.IntroducedVersion)\n407|\t\t}\n408|\t\tif err := validateReleases(group.Releases); err != nil {\n409|\t\t\treturn invalid(\"error group %d: %v\", groupIndex, err)\n410|\t\t}\n411|\t\tintroducedVersions := value.ErrorCatalog.ContractVersions[versionIndex[group.IntroducedVersion]:]\n412|\t\tif err := validateReleaseBinding(value.ErrorCatalog.ContractID, introducedVersions, group.Releases, releaseContracts); err != nil {\n413|\t\t\treturn invalid(\"error group %d: %v\", groupIndex, err)\n414|\t\t}\n415|\t\tif len(group.Mappings) == 0 {\n416|\t\t\treturn invalid(\"error group %d is empty\", groupIndex)\n417|\t\t}\n418|\t\tfor _, mapping := range group.Mappings {\n419|\t\t\tif mapping.ExitCode <= 0 || len(mapping.Codes) == 0 {\n420|\t\t\t\treturn invalid(\"error group %d has invalid exit mapping\", groupIndex)\n421|\t\t\t}\n422|\t\t\tfor _, code := range mapping.Codes {\n423|\t\t\t\tif !errorPattern.MatchString(code) {\n424|\t\t\t\t\treturn invalid(\"invalid error code %q\", code)\n425|\t\t\t\t}\n426|\t\t\t\tif _, duplicate := seenCodes[code]; duplicate {\n427|\t\t\t\t\treturn invalid(\"duplicate error code %q\", code)\n428|\t\t\t\t}\n429|\t\t\t\tseenCodes[code] = struct{}{}\n430|\t\t\t}\n431|\t\t}\n432|\t}\n433|\tcanonical, err := json.Marshal(value)\n434|\tif err != nil {\n435|\t\treturn invalid(\"encode canonical metadata: %v\", err)\n436|\t}\n437|\tdigest := sha256.Sum256(canonical)\n438|\tgotDigest := hex.EncodeToString(digest[:])\n439|\tif gotDigest != reviewedMetadataCanonicalSHA256 {\n440|\t\treturn invalid(\"metadata projection digest %s differs from reviewed %s\", gotDigest, reviewedMetadataCanonicalSHA256)\n441|\t}\n442|\treturn nil\n443|}\n444|\n445|func validateFamilyHeader(kind string, index int, family, contractID string, versions, releases []string, section string, fixtures []string, contracts map[string]map[string]struct{}, releaseContracts map[string]map[string]map[string]struct{}, seen map[string]struct{}) error {\n446|\tif family == \"\" || contractID == \"\" || section == \"\" || len(fixtures) == 0 {\n447|\t\treturn invalid(\"%s family %d has incomplete header\", kind, index)\n448|\t}\n449|\tif _, duplicate := seen[family]; duplicate {\n450|\t\treturn invalid(\"duplicate %s family %q\", kind, family)\n451|\t}\n452|\tseen[family] = struct{}{}\n453|\tif err := validateContractBinding(contractID, versions, contracts); err != nil {\n454|\t\treturn invalid(\"%s family %q: %v\", kind, family, err)\n455|\t}\n456|\tif err := validateReleases(releases); err != nil {\n457|\t\treturn invalid(\"%s family %q: %v\", kind, family, err)\n458|\t}\n459|\tif err := validateReleaseBinding(contractID, versions, releases, releaseContracts); err != nil {\n460|\t\treturn invalid(\"%s family %q: %v\", kind, family, err)\n461|\t}\n462|\tif hasEmpty(fixtures) {\n463|\t\treturn invalid(\"%s family %q has empty fixture reference\", kind, family)\n464|\t}\n465|\treturn nil\n466|}\n467|\n468|func releaseContractVersions(manifest specpin.Manifest) (map[string]map[string]map[string]struct{}, error) {\n469|\tresult := make(map[string]map[string]map[string]struct{}, 2)\n470|\tfor _, release := range []string{specpin.ReleaseV043, specpin.ReleaseV050} {\n471|\t\tcontracts, err := manifest.ContractsForRelease(release)\n472|\t\tif err != nil {\n473|\t\t\treturn nil, err\n474|\t\t}\n475|\t\tbyID := make(map[string]map[string]struct{})\n476|\t\tfor _, contract := range contracts {\n477|\t\t\tversions := byID[contract.ID]\n478|\t\t\tif versions == nil {\n479|\t\t\t\tversions = make(map[string]struct{})\n480|\t\t\t\tbyID[contract.ID] = versions\n481|\t\t\t}\n482|\t\t\tfor _, version := range contract.Versions {\n483|\t\t\t\tversions[version] = struct{}{}\n484|\t\t\t}\n485|\t\t}\n486|\t\tresult[release] = byID\n487|\t}\n488|\treturn result, nil\n489|}\n490|\n491|func validateReleaseBinding(contractID string, versions, releases []string, contracts map[string]map[string]map[string]struct{}) error {\n492|\tfor _, release := range releases {\n493|\t\tavailable := contracts[release][contractID]\n494|\t\tmatched := false\n495|\t\tfor _, version := range versions {\n496|\t\t\tif _, ok := available[version]; ok {\n497|\t\t\t\tmatched = true\n498|\t\t\t\tbreak\n499|\t\t\t}\n500|\t\t}\n(more lines below)"}}}
