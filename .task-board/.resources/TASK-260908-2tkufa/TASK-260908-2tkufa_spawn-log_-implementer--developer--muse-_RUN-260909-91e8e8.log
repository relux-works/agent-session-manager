, \"specpin\", \"v0.5.0.lock.json\"))\n+\tif err != nil {\n+\t\tt.Fatalf(\"read stale source lock: %v\", err)\n+\t}\n+\treturn metadata, lock\n+}\n+\n+// TestGenerateRefusesStaleV050Authority drives the production Generate entry\n+// point with the superseded v0.5.0 metadata and lock. Both the stale lock and\n+// the stale source identity inside the stale metadata must be refused with\n+// ErrInvalidMetadata: adopting v0.6.0 does not keep a quiet v0.5.0 path.\n+func TestGenerateRefusesStaleV050Authority(t *testing.T) {\n+\tt.Parallel()\n+\n+\tstaleMetadata, staleLock := staleAuthorityInputs(t)\n+\tif _, err := cataloggen.Generate(staleMetadata, staleLock); !errors.Is(err, cataloggen.ErrInvalidMetadata) {\n+\t\tt.Fatalf(\"Generate(stale v0.5.0 inputs) error = %v, want ErrInvalidMetadata\", err)\n+\t}\n+\tmetadata, _ := sourceInputs(t)\n+\tif _, err := cataloggen.Generate(metadata, staleLock); !errors.Is(err, cataloggen.ErrInvalidMetadata) {\n+\t\tt.Fatalf(\"Generate(v0.6.0 metadata, stale v0.5.0 lock) error = %v, want ErrInvalidMetadata\", err)\n+\t}\n+\t_, lock := sourceInputs(t)\n+\tif _, err := cataloggen.Generate(staleMetadata, lock); !errors.Is(err, cataloggen.ErrInvalidMetadata) {\n+\t\tt.Fatalf(\"Generate(stale v0.5.0 metadata, v0.6.0 lock) error = %v, want ErrInvalidMetadata\", err)\n+\t}\n+}\n","edit_facts":{"tool_name":"edit_file","path":"internal/cataloggen/generate_test.go","added":49,"removed":12},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
