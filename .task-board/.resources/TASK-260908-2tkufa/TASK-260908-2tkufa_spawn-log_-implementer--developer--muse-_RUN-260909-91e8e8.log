{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c62d","stream":{"kind":"session","id":"01a08707-ceef-7493-9b49-24effd76d285"},"sequence":369,"recorded_at":1780531400000733,"record_type":"event","durability":"durable","causation_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","run_stream":{"kind":"run","id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3"},"task_stream":{"kind":"task","id":"fc7f4024-8b64-4490-a5e8-4b466f85d112"},"task_id":"fc7f4024-8b64-4490-a5e8-4b466f85d112","event":{"kind":"output","task_id":"fc7f4024-8b64-4490-a5e8-4b466f85d112","chunk":"{\n  \"chunk_id\": \"exec-13-1\",\n  \"command\": \"grep -rn \\\"localstore\\\" --include=\\\"*.go\\\" internal/ | grep -iv test | head -n 20; echo ===; grep -rn \\\"specpin\\\\.\\\\|specdoc\\\\.\\\" --include=\\\"*.go\\\" internal/localstore/ internal/cigate/ | head -n 30; echo ===; cat .github/workflows/ci.yml | sed -n '1,120p'\",\n  \"description\": \"Find localstore pin binding and CI legs\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"internal/secprim/doc.go:29://     internal/localstore, which already implement AC-PATH-001.\\ninternal/localstore/paths.go:1:// Package localstore implements the AX owner-local path layout and immutable\\ninternal/localstore/paths.go:3:package localstore\\ninternal/localstore/atomic_rename_darwin.go:3:package localstore\\ninternal/localstore/projection_lock_unsupported.go:3:package localstore\\ninternal/localstore/atomic_rename_windows.go:3:package localstore\\ninternal/localstore/atomic_rename_linux.go:3:package localstore\\ninternal/localstore/ownership_unix.go:3:package localstore\\ninternal/localstore/blob_inspection.go:1:package localstore\\ninternal/localstore/projection_lock_unix.go:3:package localstore\\ninternal/localstore/object_store.go:1:package localstore\\ninternal/localstore/ownership_windows.go:3:package localstore\\ninternal/localstore/atomic_rename_unsupported.go:3:package localstore\\ninternal/localstore/projection.go:1:package localstore\\n===\\ninternal/localstore/paths.go:174:\\tmanifest, err := specpin.Current()\\ninternal/cigate/contracts.go:29:\\treturn checkReleaseRoots(specpin.ReleaseV050, specpin.ReleaseV043,\\ninternal/cigate/contracts.go:57:\\tmanifest, err := specpin.Current()\\ninternal/cigate/contracts.go:66:func pinContractSets(manifest specpin.Manifest) (map[string][]ContractVersions, error) {\\ninternal/cigate/contracts.go:187:func fromPinContracts(contracts []specpin.ContractPin) []ContractVersions {\\n===\\nname: CI\\n\\non:\\n  pull_request:\\n  push:\\n    branches:\\n      - main\\n\\npermissions:\\n  contents: read\\n\\n# What green means. Every job below proves its selection matched something:\\n# a grep, glob, file scan, matrix expansion, or test selector that finds\\n# nothing fails closed instead of passing on an empty result set. No job\\n# declares an `if:` condition, so no job can skip quietly; gates-verdict\\n# additionally refuses any skipped, failed, or cancelled dependency.\\n#\\n# GOOS=windows work is compile-and-vet only. A green windows-compile-only job\\n# proves the tree type-checks for Windows; it never implies executed\\n# behaviour. Coverage is reported as numbers, not enforced as a floor.\\njobs:\\n  contract-preservation:\\n    name: Contract preservation (v0.5.0 current, v0.4.3 historical)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 10\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      - name: Verify specification-to-code ownership\\n        run: go run ./internal/traceability/cmd/tracecheck\\n\\n      # The diff proves the committed catalog matches generator output, but\\n      # `go generate` runs nothing when its directive is disarmed: rewriting\\n      # `//go:generate` as `// go:generate` preserves the token while turning\\n      # the directive into a plain comment, so generation is skipped and the\\n      # diff stays clean. The anchored check refuses that token-preserving\\n      # rewrite; only the exact directive form counts. A new directive\\n      # without a pin update reddens here (and in\\n      # TestGenerateDirectiveStaysRecognizedForm) instead of going unchecked.\\n      - name: Verify generated catalog is current\\n        run: |\\n          test \\\"$(grep -c '^//go:generate' internal/catalog/catalog.go)\\\" -eq 1\\n          go generate ./internal/catalog\\n          git diff --exit-code -- internal/catalog/catalog_gen.go\\n\\n      # The release roots are derived from internal/specpin and\\n      # internal/catalog inside the gate, never retyped here. Each -- PASS\\n      # guard below must match: a selector that runs nothing fails here\\n      # instead of passing silently.\\n      - name: Run pinned contract-version gates\\n        run: |\\n          set +e\\n          go test ./internal/cigate -run 'TestVerifyContractPreservationLive|TestPinnedReleasesAgreeAcrossAuthorities|TestDerivedSetsAreComplete|TestCheckAgreementAdmitsIdenticalSets|TestCheckAgreementRefusals|TestCheckReleaseRootsRefusesDrift' -count=1 -v > cigate-contracts.log 2>&1\\n          code=$?\\n          set -e\\n          cat cigate-contracts.log\\n          test $code -eq 0\\n          for gate in TestVerifyContractPreservationLive TestPinnedReleasesAgreeAcrossAuthorities TestDerivedSetsAreComplete TestCheckAgreementAdmitsIdenticalSets TestCheckAgreementRefusals TestCheckReleaseRootsRefusesDrift; do\\n            grep -q \\\"^--- PASS: ${gate}\\\" cigate-contracts.log\\n          done\\n\\n  lint:\\n    name: Linters (vet, Windows vet, gofmt)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 10\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      - name: Vet\\n        run: go vet ./...\\n\\n      - name: Vet Windows build-tagged sources\\n        run: GOOS=windows go vet ./...\\n\\n      # gofmt lists only offending files, so a clean tree prints nothing.\\n      # The file count proves the scan was not empty; the log must then be.\\n      - name: Check formatting\\n        run: |\\n          count=$(find internal -name '*.go' | wc -l | tr -d ' ')\\n          echo \\\"go files scanned: ${count}\\\"\\n          test \\\"${count}\\\" -gt 0\\n          set +e\\n          gofmt -l internal > gofmt.log 2>&1\\n          code=$?\\n          set -e\\n          cat gofmt.log\\n          test $code -eq 0\\n          test ! -s gofmt.log\\n\\n  test:\\n    name: Build and test (no cache)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 15\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      - name: Build\\n        run: go build ./...\\n\\n      # Verbose on purpose: the --- SKIP lines are the suite-wide skip\\n      # datum. At least one package must report ok: a suite that matched\\n      # nothing is a failure, not a pass.\\n\",\n  \"original_output_bytes\": 5861,\n  \"original_output_tokens\": 1466,\n  \"truncated\": false\n}"}}}
