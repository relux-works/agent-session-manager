n:ax:protocol:rpc\\\",\\n      \\\"contract_versions\\\": [\\\"2.0.0\\\", \\\"3.0.0\\\", \\\"4.0.0\\\"],'''\\nnew_mesh = '''      \\\"family\\\": \\\"mesh_rpc\\\",\\n      \\\"contract_id\\\": \\\"urn:ax:protocol:rpc\\\",\\n      \\\"contract_versions\\\": [\\\"2.0.0\\\", \\\"3.0.0\\\", \\\"4.0.0\\\", \\\"5.0.0\\\"],'''\\nassert src.count(old_mesh) == 1\\nsrc = src.replace(old_mesh, new_mesh)\\n\\n# 4. Structured Error 1.4.0 versions + group (SPEC 14.7.3: exactly five codes)\\nold_err = '\\\"contract_versions\\\": [\\\"1.0.0\\\", \\\"1.1.0\\\", \\\"1.2.0\\\", \\\"1.3.0\\\"],'\\nassert src.count(old_err) == 1\\nsrc = src.replace(old_err, '\\\"contract_versions\\\": [\\\"1.0.0\\\", \\\"1.1.0\\\", \\\"1.2.0\\\", \\\"1.3.0\\\", \\\"1.4.0\\\"],')\\nanchor = '''          {\\\"exit_code\\\": 13, \\\"codes\\\": [\\\"terminal_backend_protocol_error\\\", \\\"terminal_backend_process_failed\\\", \\\"terminal_backend_timeout\\\"]}\\n        ]\\n      }'''\\nassert src.count(anchor) == 1\\ngroup140 = anchor + ''',\\n      {\\n        \\\"introduced_version\\\": \\\"1.4.0\\\",\\n        \\\"releases\\\": [\\\"v0.6.0\\\"],\\n        \\\"mappings\\\": [\\n          {\\\"exit_code\\\": 3, \\\"codes\\\": [\\\"selector_observation_unavailable\\\"]},\\n          {\\\"exit_code\\\": 4, \\\"codes\\\": [\\\"selector_source_not_found\\\"]},\\n          {\\\"exit_code\\\": 8, \\\"codes\\\": [\\\"selector_source_read_failed\\\"]},\\n          {\\\"exit_code\\\": 12, \\\"codes\\\": [\\\"selector_bootstrap_incomplete\\\"]},\\n          {\\\"exit_code\\\": 16, \\\"codes\\\": [\\\"selector_plan_stale\\\"]}\\n        ]\\n      }'''\\nsrc = src.replace(anchor, group140)\\n\\nopen('internal/catalog/catalog.v0.6.0.json', 'w').write(src)\\nprint('wrote compact catalog.v0.6.0.json')\\nEOF\\nls -la internal/catalog/*.json; git diff --stat 2>/dev/null | tail -3\",\n  \"description\": \"Author compact v0.6.0 metadata via textual delta\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"wrote compact catalog.v0.6.0.json\\n-rw-r--r--@ 1 iv  staff  30445 Sep  9 19:59 internal/catalog/catalog.v0.5.0.json\\n-rw-r--r--@ 1 iv  staff  31501 Sep  9 20:46 internal/catalog/catalog.v0.6.0.json\\n internal/specpin/pin.go | 26 +++++++++++++++++---------\\n 1 file changed, 17 insertions(+), 9 deletions(-)\\n\",\n  \"original_output_bytes\": 303,\n  \"original_output_tokens\": 76,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
