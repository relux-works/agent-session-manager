{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000daf3","stream":{"kind":"session","id":"01a08707-ceef-7493-9b49-24effd76d285"},"sequence":3028,"recorded_at":1780531400006051,"record_type":"event","durability":"durable","causation_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","run_stream":{"kind":"run","id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3"},"task_stream":{"kind":"task","id":"1af50258-4fdc-4aa1-96f8-45dde2bd51d7"},"task_id":"1af50258-4fdc-4aa1-96f8-45dde2bd51d7","event":{"kind":"output","task_id":"1af50258-4fdc-4aa1-96f8-45dde2bd51d7","chunk":"edited\nchanged lines: lines 95-121\n--- original\n+++ updated\n@@\n-// AssessCompatibility determines whether a known reader may open the document\n-// normally or must remain read-only. Newer documents are not decoded or\n-// rewritten, so fields unknown to the older reader remain untouched.\n-func AssessCompatibility(document []byte, readerVersion string) (CompatibilityAssessment, error) {\n-\treader, ok := knownConfigVersion(readerVersion)\n-\tif !ok {\n-\t\treturn CompatibilityAssessment{}, migrationError(MigrationError{Operation: \"assess reader\", Err: ErrCompatibilityReader})\n-\t}\n-\tvar envelope rawEnvelope\n-\tif err := decodeEnvelope(document, &envelope); err != nil {\n-\t\treturn CompatibilityAssessment{}, err\n-\t}\n-\tif envelope.Schema != SchemaID {\n-\t\treturn CompatibilityAssessment{}, configError(\"schema\", ErrConfigValidation)\n-\t}\n-\tsource, err := parseSemverCore(envelope.SchemaVersion)\n-\tif err != nil {\n-\t\treturn CompatibilityAssessment{}, configError(\"schema_version\", errors.Join(ErrCompatibilityAssessment, err))\n-\t}\n-\tmode := CompatibilityCompatible\n-\tif compareSemver(source, reader) > 0 {\n-\t\tmode = CompatibilityReadOnly\n-\t} else if _, known := knownConfigVersion(envelope.SchemaVersion); !known {\n-\t\treturn CompatibilityAssessment{}, configError(\"schema_version\", ErrUnsupportedConfigVersion)\n-\t}\n-\treturn CompatibilityAssessment{ReaderVersion: readerVersion, SourceVersion: envelope.SchemaVersion, Mode: mode}, nil\n-}\n+// AssessCompatibility determines whether a known reader may open the document\n+// normally or must remain read-only. Newer documents are not decoded or\n+// rewritten, so fields unknown to the older reader remain untouched.\n+func AssessCompatibility(document []byte, readerVersion string) (CompatibilityAssessment, error) {\n+\treader, ok := assessmentVersion(readerVersion)\n+\tif !ok {\n+\t\treturn CompatibilityAssessment{}, migrationError(MigrationError{Operation: \"assess reader\", Err: ErrCompatibilityReader})\n+\t}\n+\tvar envelope rawEnvelope\n+\tif err := decodeEnvelope(document, &envelope); err != nil {\n+\t\treturn CompatibilityAssessment{}, err\n+\t}\n+\tif envelope.Schema != SchemaID {\n+\t\treturn CompatibilityAssessment{}, configError(\"schema\", ErrConfigValidation)\n+\t}\n+\tsource, err := parseSemverCore(envelope.SchemaVersion)\n+\tif err != nil {\n+\t\treturn CompatibilityAssessment{}, configError(\"schema_version\", errors.Join(ErrCompatibilityAssessment, err))\n+\t}\n+\tmode := CompatibilityCompatible\n+\tif compareSemver(source, reader) > 0 {\n+\t\tmode = CompatibilityReadOnly\n+\t} else if _, known := assessmentVersion(envelope.SchemaVersion); !known {\n+\t\treturn CompatibilityAssessment{}, configError(\"schema_version\", ErrUnsupportedConfigVersion)\n+\t}\n+\treturn CompatibilityAssessment{ReaderVersion: readerVersion, SourceVersion: envelope.SchemaVersion, Mode: mode}, nil\n+}\n+\n+// assessmentVersion admits the Configuration versions the compatibility\n+// matrix reasons about, including the adopted 4.0.0 labels a Config-4\n+// installation would carry: it opens 4.0.0 documents normally and reads\n+// older documents for preview and migration, while older readers stay\n+// read-only on newer documents without decoding them. Admission here grants\n+// this binary no new capability: Decode still refuses 4.0.0 documents and\n+// Migrate still refuses 4.0.0 targets through knownConfigVersion, per\n+// SPEC 6.6, which makes unknown configuration a refusal, never legacy\n+// selection.\n+func assessmentVersion(value string) (semverCore, bool) {\n+\tswitch value {\n+\tcase Version1, Version2, CurrentVersion, Version4:\n+\t\tparsed, _ := parseSemverCore(value)\n+\t\treturn parsed, true\n+\tdefault:\n+\t\treturn semverCore{}, false\n+\t}\n+}\n"}}}
