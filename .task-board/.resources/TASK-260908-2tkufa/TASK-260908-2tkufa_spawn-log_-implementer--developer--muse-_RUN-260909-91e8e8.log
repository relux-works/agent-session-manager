{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c66d","stream":{"kind":"session","id":"01a08707-ceef-7493-9b49-24effd76d285"},"sequence":401,"recorded_at":1780531400000797,"record_type":"event","durability":"durable","causation_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","run_stream":{"kind":"run","id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3"},"call_id":"call_01a08708aedc76c1a871ff284af5c6d0","text":"Read text file `internal/localstore/paths.go`.\n(139 line(s) above)\n140|\n141|func PathDefinitions() ([]PathDefinition, error) {\n142|\tpathRegistryOnce.Do(loadPathDefinitions)\n143|\tif pathRegistryError != nil {\n144|\t\treturn nil, pathRegistryError\n145|\t}\n146|\treturn slices.Clone(pathRegistryDefinitions), nil\n147|}\n148|\n149|func loadPathDefinitions() {\n150|\tpathRegistryDefinitions, pathRegistryError = verifyPathRegistry(pathRegistryBytes)\n151|}\n152|\n153|// verifyPathRegistry accepts only the reviewed embedded registry bytes before\n154|// interpreting their rows. A structurally valid replacement must not be able\n155|// to mint its own path contract.\n156|func verifyPathRegistry(candidate []byte) ([]PathDefinition, error) {\n157|\tif digest := fmt.Sprintf(\"%x\", sha256.Sum256(candidate)); digest != PathRegistrySHA256 {\n158|\t\treturn nil, fmt.Errorf(\"%w: byte digest is %s, want %s\", ErrPathRegistry, digest, PathRegistrySHA256)\n159|\t}\n160|\treturn decodePathRegistry(candidate)\n161|}\n162|\n163|func decodePathRegistry(candidate []byte) ([]PathDefinition, error) {\n164|\tdecoder := json.NewDecoder(bytes.NewReader(candidate))\n165|\tdecoder.DisallowUnknownFields()\n166|\tvar registry pathRegistry\n167|\tif err := decoder.Decode(&registry); err != nil {\n168|\t\treturn nil, fmt.Errorf(\"%w: decode: %v\", ErrPathRegistry, err)\n169|\t}\n170|\tvar trailing any\n171|\tif err := decoder.Decode(&trailing); !errors.Is(err, io.EOF) {\n172|\t\treturn nil, fmt.Errorf(\"%w: trailing JSON\", ErrPathRegistry)\n173|\t}\n174|\tmanifest, err := specpin.Current()\n175|\tif err != nil {\n176|\t\treturn nil, fmt.Errorf(\"%w: verify source pin: %v\", ErrPathRegistry, err)\n177|\t}\n178|\tsource := registry.Source\n179|\tif registry.Format != \"ax-platform-path-registry\" || registry.FormatVersion != 1 || registry.RegistryVersion != \"1.0.0\" ||\n180|\t\tsource.Repository != manifest.Source.Repository || source.Release != manifest.Source.Release ||\n181|\t\tsource.Commit != manifest.Source.Commit || source.DocumentPath != manifest.Source.Document.Path ||\n182|\t\tsource.DocumentSHA256 != manifest.Source.Document.SHA256 || source.Section != \"3.2\" {\n183|\t\treturn nil, fmt.Errorf(\"%w: identity differs from pinned Section 3.2\", ErrPathRegistry)\n184|\t}\n185|\tif len(registry.Paths) != 5 {\n186|\t\treturn nil, fmt.Errorf(\"%w: v1.0.0 path count is %d, want 5\", ErrPathRegistry, len(registry.Paths))\n187|\t}\n188|\tseenClasses := make(map[PathClass]struct{}, len(registry.Paths))\n189|\tseenFlags := make(map[string]struct{}, len(registry.Paths))\n190|\tseenEnvironment := make(map[string]struct{}, len(registry.Paths))\n191|\tdefinitions := make([]PathDefinition, 0, len(registry.Paths))\n192|\tfor index, document := range registry.Paths {\n193|\t\tif !validPathClass(document.Class) || !validPathValueKind(document.Class, document.ValueKind) ||\n194|\t\t\t!strings.HasPrefix(document.Flag, \"--\") || !strings.HasPrefix(document.Environment, \"AX_\") {\n195|\t\t\treturn nil, fmt.Errorf(\"%w: malformed row %d\", ErrPathRegistry, index)\n196|\t\t}\n197|\t\tif _, duplicate := seenClasses[document.Class]; duplicate {\n198|\t\t\treturn nil, fmt.Errorf(\"%w: duplicate class %q\", ErrPathRegistry, document.Class)\n199|\t\t}\n200|\t\tif _, duplicate := seenFlags[document.Flag]; duplicate {\n201|\t\t\treturn nil, fmt.Errorf(\"%w: duplicate flag %q\", ErrPathRegistry, document.Flag)\n202|\t\t}\n203|\t\tif _, duplicate := seenEnvironment[document.Environment]; duplicate {\n204|\t\t\treturn nil, fmt.Errorf(\"%w: duplicate environment %q\", ErrPathRegistry, document.Environment)\n205|\t\t}\n206|\t\tseenClasses[document.Class] = struct{}{}\n207|\t\tseenFlags[document.Flag] = struct{}{}\n208|\t\tseenEnvironment[document.Environment] = struct{}{}\n209|\t\tdefinitions = append(definitions, PathDefinition(document))\n210|\t}\n211|\treturn definitions, nil\n212|}\n213|\n214|func validPathClass(class PathClass) bool {\n215|\tswitch class {\n216|\tcase PathConfig, PathData, PathState, PathCache, PathRuntime:\n217|\t\treturn true\n218|\tdefault:\n219|\t\treturn false\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
