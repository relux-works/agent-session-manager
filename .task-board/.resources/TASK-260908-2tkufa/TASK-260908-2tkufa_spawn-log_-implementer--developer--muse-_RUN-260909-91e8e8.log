{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5af","stream":{"kind":"session","id":"01a08707-ceef-7493-9b49-24effd76d285"},"sequence":306,"recorded_at":1780531400000607,"record_type":"event","durability":"durable","causation_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","run_stream":{"kind":"run","id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3"},"task_stream":{"kind":"task","id":"769aee4f-ba8b-420b-b63b-beaba9131c3d"},"task_id":"769aee4f-ba8b-420b-b63b-beaba9131c3d","event":{"kind":"output","task_id":"769aee4f-ba8b-420b-b63b-beaba9131c3d","chunk":"Read text file `internal/catalog/catalog.go`.\n1|// Package catalog exposes generated, typed vocabularies from the reviewed AX\n2|// implementation metadata. Catalog membership defines a contract vocabulary;\n3|// it never advertises runtime availability or implementation support.\n4|package catalog\n5|\n6|import (\n7|\t\"errors\"\n8|\t\"fmt\"\n9|)\n10|\n11|const (\n12|\tFormat        = \"ax-implementation-catalog\"\n13|\tFormatVersion = 1\n14|\n15|\tReleaseV043 Release = \"v0.4.3\"\n16|\tReleaseV050 Release = \"v0.5.0\"\n17|)\n18|\n19|var ErrUnsupportedRelease = errors.New(\"unsupported catalog release\")\n20|\n21|// Release identifies a specification package release represented by the\n22|// reviewed implementation metadata.\n23|type Release string\n24|\n25|// ContractID is a registered AX schema or protocol identifier.\n26|type ContractID string\n27|\n28|// Family scopes operation, capability, and event names that may otherwise\n29|// overlap across independent contracts.\n30|type Family string\n31|\n32|// OperationName is one closed operation-registry member.\n33|type OperationName string\n34|\n35|// CapabilityName is one manifest/probe capability-vocabulary member. It does\n36|// not imply that the capability is available.\n37|type CapabilityName string\n38|\n39|// EventName is one closed Session Event or required Observation Event member.\n40|type EventName string\n41|\n42|// ErrorName is one stable Structured Error code.\n43|type ErrorName string\n44|\n45|// Source binds every generated definition to the immutable normative source.\n46|type Source struct {\n47|\tRepository     string\n48|\tRelease        Release\n49|\tCommit         string\n50|\tDocumentPath   string\n51|\tDocumentSHA256 string\n52|\tNormativeScope []string\n53|}\n54|\n55|// Contract is one independently versioned schema or protocol contract.\n56|type Contract struct {\n57|\tName     string\n58|\tID       ContractID\n59|\tVersions []string\n60|}\n61|\n62|// SelfIdentityContract defines the schema-directed JCS omit-self rule for an\n63|// immutable logical object. Membership is reviewed metadata from the pinned\n64|// specification; it does not imply that any wider schema behavior is\n65|// implemented.\n66|type SelfIdentityContract struct {\n67|\tContractID         ContractID\n68|\tContractVersions   []string\n69|\tSelfField          string\n70|\tDiscriminatorName  string\n71|\tDiscriminatorValue string\n72|\tNormativeSection   string\n73|}\n74|\n75|// OperationEffect classifies whether an operation mutates authoritative\n76|// durable state. Isolated output is restricted to caller-created sinks and is\n77|// not an authoritative state transition.\n78|type OperationEffect string\n79|\n80|const (\n81|\t// EffectNoDurableMutation makes no stronger read-only claim: an operation\n82|\t// may still plan work or control an ephemeral process.\n83|\tEffectNoDurableMutation OperationEffect = \"no_durable_mutation\"\n84|\tEffectIsolatedOutput    OperationEffect = \"isolated_output\"\n85|\tEffectDurableMutation   OperationEffect = \"durable_mutation\"\n86|)\n87|\n88|// Operation is a typed protocol/query operation definition. Durable mutations\n89|// always carry both an exact idempotency scope and recovery evidence.\n90|type Operation struct {\n91|\tFamily           Family\n92|\tName             OperationName\n93|\tContractID       ContractID\n94|\tContractVersions []string\n95|\tEffect           OperationEffect\n96|\tIdempotencyKey   string\n97|\tRecoveryEvidence []string\n98|\tNormativeSection string\n99|\tFixtureFamilies  []string\n100|}\n101|\n102|// Capability is a vocabulary definition only. Availability, status, enabled,\n103|// and support claims deliberately do not exist in this type.\n104|type Capability struct {\n105|\tFamily           Family\n106|\tName             CapabilityName\n107|\tContractID       ContractID\n108|\tContractVersions []string\n109|\tNormativeSection string\n110|\tFixtureFamilies  []string\n111|}\n112|\n113|// Event is a required event name and the exact contract versions that define\n114|// it. Session Events and Observation Events remain separate families.\n115|type Event struct {\n116|\tFamily           Family\n117|\tName             EventName\n118|\tContractID       ContractID\n119|\tContractVersions []string\n120|\tNormativeSection string\n(more lines below)"}}}
