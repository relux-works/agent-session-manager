plicate := seenFlags[document.Flag]; duplicate {\n201|\t\t\treturn nil, fmt.Errorf(\"%w: duplicate flag %q\", ErrPathRegistry, document.Flag)\n202|\t\t}\n203|\t\tif _, duplicate := seenEnvironment[document.Environment]; duplicate {\n204|\t\t\treturn nil, fmt.Errorf(\"%w: duplicate environment %q\", ErrPathRegistry, document.Environment)\n205|\t\t}\n206|\t\tseenClasses[document.Class] = struct{}{}\n207|\t\tseenFlags[document.Flag] = struct{}{}\n208|\t\tseenEnvironment[document.Environment] = struct{}{}\n209|\t\tdefinitions = append(definitions, PathDefinition(document))\n210|\t}\n211|\treturn definitions, nil\n212|}\n213|\n214|func validPathClass(class PathClass) bool {\n215|\tswitch class {\n216|\tcase PathConfig, PathData, PathState, PathCache, PathRuntime:\n217|\t\treturn true\n218|\tdefault:\n219|\t\treturn false\n(more lines below)"}}}
