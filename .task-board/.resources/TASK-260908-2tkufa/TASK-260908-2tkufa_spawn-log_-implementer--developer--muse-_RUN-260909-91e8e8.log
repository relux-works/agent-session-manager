{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c627","stream":{"kind":"session","id":"01a08707-ceef-7493-9b49-24effd76d285"},"sequence":366,"recorded_at":1780531400000727,"record_type":"event","durability":"durable","causation_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","run_stream":{"kind":"run","id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3"},"task_stream":{"kind":"task","id":"08fe64ee-71a0-4138-8857-48cc61de9d9e"},"task_id":"08fe64ee-71a0-4138-8857-48cc61de9d9e","event":{"kind":"output","task_id":"08fe64ee-71a0-4138-8857-48cc61de9d9e","chunk":"Read text file `internal/catalog/catalog.go`.\n(119 line(s) above)\n120|\tNormativeSection string\n121|\tFixtureFamilies  []string\n122|}\n123|\n124|// ErrorCode is one stable Structured Error code-to-exit mapping.\n125|type ErrorCode struct {\n126|\tCode             ErrorName\n127|\tExitCode         int\n128|\tContractID       ContractID\n129|\tContractVersions []string\n130|\tNormativeSection string\n131|\tFixtureFamilies  []string\n132|}\n133|\n134|// Catalog is an isolated release projection of the generated definitions.\n135|type Catalog struct {\n136|\tSource         Source\n137|\tRelease        Release\n138|\tMetadataSHA256 string\n139|\tContracts      []Contract\n140|\tSelfIdentities []SelfIdentityContract\n141|\tOperations     []Operation\n142|\tCapabilities   []Capability\n143|\tEvents         []Event\n144|\tErrors         []ErrorCode\n145|}\n146|\n147|type catalogDefinition struct {\n148|\tSource         Source\n149|\tMetadataSHA256 string\n150|\tContracts      map[Release][]Contract\n151|\tSelfIdentities []scopedSelfIdentityContract\n152|\tOperations     []scopedOperation\n153|\tCapabilities   []scopedCapability\n154|\tEvents         []scopedEvent\n155|\tErrors         []scopedError\n156|}\n157|\n158|type scopedSelfIdentityContract struct {\n159|\tDefinition SelfIdentityContract\n160|\tReleases   []Release\n161|}\n162|\n163|type scopedOperation struct {\n164|\tDefinition Operation\n165|\tReleases   []Release\n166|}\n167|\n168|type scopedCapability struct {\n169|\tDefinition Capability\n170|\tReleases   []Release\n171|}\n172|\n173|type scopedEvent struct {\n174|\tDefinition Event\n175|\tReleases   []Release\n176|}\n177|\n178|type scopedError struct {\n179|\tDefinition ErrorCode\n180|\tReleases   []Release\n181|}\n182|\n183|//go:generate go run ./cmd/cataloggen -metadata catalog.v0.5.0.json -contracts ../specpin/v0.5.0.lock.json -output catalog_gen.go\n184|\n185|// Current returns an isolated v0.5.0 catalog.\n186|func Current() Catalog {\n187|\tcatalog, err := ForRelease(ReleaseV050)\n188|\tif err != nil {\n189|\t\tpanic(fmt.Sprintf(\"generated current catalog is invalid: %v\", err))\n190|\t}\n191|\treturn catalog\n192|}\n193|\n194|// ForRelease returns an isolated exact catalog projection for a represented\n195|// release. It never coerces or guesses an unsupported release.\n196|func ForRelease(release Release) (Catalog, error) {\n197|\tcontracts, ok := generatedDefinition.Contracts[release]\n198|\tif !ok {\n199|\t\treturn Catalog{}, fmt.Errorf(\"%w: %s\", ErrUnsupportedRelease, release)\n200|\t}\n201|\n202|\tallowedVersions := make(map[ContractID]map[string]struct{}, len(contracts))\n203|\tfor _, contract := range contracts {\n204|\t\tversions := allowedVersions[contract.ID]\n205|\t\tif versions == nil {\n206|\t\t\tversions = make(map[string]struct{}, len(contract.Versions))\n207|\t\t\tallowedVersions[contract.ID] = versions\n208|\t\t}\n209|\t\tfor _, version := range contract.Versions {\n210|\t\t\tversions[version] = struct{}{}\n211|\t\t}\n212|\t}\n213|\n214|\tresult := Catalog{\n215|\t\tSource:         cloneSource(generatedDefinition.Source),\n216|\t\tRelease:        release,\n217|\t\tMetadataSHA256: generatedDefinition.MetadataSHA256,\n218|\t\tContracts:      cloneContracts(contracts),\n219|\t}\n220|\tfor _, scoped := range generatedDefinition.SelfIdentities {\n221|\t\tif !containsRelease(scoped.Releases, release) {\n222|\t\t\tcontinue\n223|\t\t}\n224|\t\tdefinition := cloneSelfIdentityContract(scoped.Definition)\n225|\t\tdefinition.ContractVersions = filterVersions(definition.ContractVersions, allowedVersions[definition.ContractID])\n226|\t\tif len(definition.ContractVersions) != 0 {\n227|\t\t\tresult.SelfIdentities = append(result.SelfIdentities, definition)\n228|\t\t}\n229|\t}\n230|\tfor _, scoped := range generatedDefinition.Operations {\n231|\t\tif !containsRelease(scoped.Releases, release) {\n232|\t\t\tcontinue\n233|\t\t}\n234|\t\tdefinition := cloneOperation(scoped.Definition)\n235|\t\tdefinition.ContractVersions = filterVersions(definition.ContractVersions, allowedVersions[definition.ContractID])\n236|\t\tif len(definition.ContractVersions) != 0 {\n237|\t\t\tresult.Operations = append(result.Operations, definition)\n238|\t\t}\n239|\t}\n240|\tfor _, scoped := range generatedDefinition.Capabilities {\n241|\t\tif !containsRelease(scoped.Releases, release) {\n242|\t\t\tcontinue\n243|\t\t}\n244|\t\tdefinition := cloneCapability(scoped.Definition)\n245|\t\tdefinition.ContractVersions = filterVersions(definition.ContractVersions, allowedVersions[definition.ContractID])\n246|\t\tif len(definition.ContractVersions) != 0 {\n247|\t\t\tresult.Capabilities = append(result.Capabilities, definition)\n248|\t\t}\n249|\t}\n(more lines below)"}}}
