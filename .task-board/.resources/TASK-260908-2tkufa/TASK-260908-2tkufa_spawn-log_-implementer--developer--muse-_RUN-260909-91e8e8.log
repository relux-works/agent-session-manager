{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c631","stream":{"kind":"session","id":"01a08707-ceef-7493-9b49-24effd76d285"},"sequence":371,"recorded_at":1780531400000737,"record_type":"event","durability":"durable","causation_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","run_stream":{"kind":"run","id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3"},"call_id":"call_01a087088aa27511b25ad455adb26380","text":"Read text file `internal/catalog/catalog.go`.\n(119 line(s) above)\n120|\tNormativeSection string\n121|\tFixtureFamilies  []string\n122|}\n123|\n124|// ErrorCode is one stable Structured Error code-to-exit mapping.\n125|type ErrorCode struct {\n126|\tCode             ErrorName\n127|\tExitCode         int\n128|\tContractID       ContractID\n129|\tContractVersions []string\n130|\tNormativeSection string\n131|\tFixtureFamilies  []string\n132|}\n133|\n134|// Catalog is an isolated release projection of the generated definitions.\n135|type Catalog struct {\n136|\tSource         Source\n137|\tRelease        Release\n138|\tMetadataSHA256 string\n139|\tContracts      []Contract\n140|\tSelfIdentities []SelfIdentityContract\n141|\tOperations     []Operation\n142|\tCapabilities   []Capability\n143|\tEvents         []Event\n144|\tErrors         []ErrorCode\n145|}\n146|\n147|type catalogDefinition struct {\n148|\tSource         Source\n149|\tMetadataSHA256 string\n150|\tContracts      map[Release][]Contract\n151|\tSelfIdentities []scopedSelfIdentityContract\n152|\tOperations     []scopedOperation\n153|\tCapabilities   []scopedCapability\n154|\tEvents         []scopedEvent\n155|\tErrors         []scopedError\n156|}\n157|\n158|type scopedSelfIdentityContract struct {\n159|\tDefinition SelfIdentityContract\n160|\tReleases   []Release\n161|}\n162|\n163|type scopedOperation struct {\n164|\tDefinition Operation\n165|\tReleases   []Release\n166|}\n167|\n168|type scopedCapability struct {\n169|\tDefinition Capability\n170|\tReleases   []Release\n171|}\n172|\n173|type scopedEvent struct {\n174|\tDefinition Event\n175|\tReleases   []Release\n176|}\n177|\n178|type scopedError struct {\n179|\tDefinition ErrorCode\n180|\tReleases   []Release\n181|}\n182|\n183|//go:generate go run ./cmd/cataloggen -metadata catalog.v0.5.0.json -contracts ../specpin/v0.5.0.lock.json -output catalog_gen.go\n184|\n185|// Current returns an isolated v0.5.0 catalog.\n186|func Current() Catalog {\n187|\tcatalog, err := ForRelease(ReleaseV050)\n188|\tif err != nil {\n189|\t\tpanic(fmt.Sprintf(\"generated current catalog is invalid: %v\", err))\n190|\t}\n191|\treturn catalog\n192|}\n193|\n194|// ForRelease returns an isolated exact catalog projection for a represented\n195|// release. It never coerces or guesses an unsupported release.\n196|func ForRelease(release Release) (Catalog, error) {\n197|\tcontracts, ok := generatedDefinition.Contracts[release]\n198|\tif !ok {\n199|\t\treturn Catalog{}, fmt.Errorf(\"%w: %s\", ErrUnsupportedRelease, release)\n200|\t}\n201|\n202|\tallowedVersions := make(map[ContractID]map[string]struct{}, len(contracts))\n203|\tfor _, contract := range contracts {\n204|\t\tversions := allowedVersions[contract.ID]\n205|\t\tif versions == nil {\n206|\t\t\tversions = make(map[string]struct{}, len(contract.Versions))\n207|\t\t\tallowedVersions[contract.ID] = versions\n208|\t\t}\n209|\t\tfor _, version := range contract.Versions {\n210|\t\t\tversions[version] = struct{}{}\n211|\t\t}\n212|\t}\n213|\n214|\tresult := Catalog{\n215|\t\tSource:         cloneSource(generatedDefinition.Source),\n216|\t\tRelease:        release,\n217|\t\tMetadataSHA256: generatedDefinition.MetadataSHA256,\n218|\t\tContracts:      cloneContracts(contracts),\n219|\t}\n220|\tfor _, scoped := range generatedDefinition.SelfIdentities {\n221|\t\tif !containsRelease(scoped.Releases, release) {\n222|\t\t\tcontinue\n223|\t\t}\n224|\t\tdefinition := cloneSelfIdentityContract(scoped.Definition)\n225|\t\tdefinition.ContractVersions = filterVersions(definition.ContractVersions, allowedVersions[definition.ContractID])\n226|\t\tif len(definition.ContractVersions) != 0 {\n227|\t\t\tresult.SelfIdentities = append(result.SelfIdentities, definition)\n228|\t\t}\n229|\t}\n230|\tfor _, scoped := range generatedDefinition.Operations {\n231|\t\tif !containsRelease(scoped.Releases, release) {\n232|\t\t\tcontinue\n233|\t\t}\n234|\t\tdefinition := cloneOperation(scoped.Definition)\n235|\t\tdefinition.ContractVersions = filterVersions(definition.ContractVersions, allowedVersions[definition.ContractID])\n236|\t\tif len(definition.ContractVersions) != 0 {\n237|\t\t\tresult.Operations = append(result.Operations, definition)\n238|\t\t}\n239|\t}\n240|\tfor _, scoped := range generatedDefinition.Capabilities {\n241|\t\tif !containsRelease(scoped.Releases, release) {\n242|\t\t\tcontinue\n243|\t\t}\n244|\t\tdefinition := cloneCapability(scoped.Definition)\n245|\t\tdefinition.ContractVersions = filterVersions(definition.ContractVersions, allowedVersions[definition.ContractID])\n246|\t\tif len(definition.ContractVersions) != 0 {\n247|\t\t\tresult.Capabilities = append(result.Capabilities, definition)\n248|\t\t}\n249|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c633","stream":{"kind":"session","id":"01a08707-ceef-7493-9b49-24effd76d285"},"sequence":372,"recorded_at":1780531400000739,"record_type":"event","durability":"durable","causation_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","run_stream":{"kind":"run","id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3"},"call_id":"call_01a087088bac7ed1917dd8ba8c6578a2","text":"{\n  \"chunk_id\": \"exec-13-1\",\n  \"command\": \"grep -rn \\\"localstore\\\" --include=\\\"*.go\\\" internal/ | grep -iv test | head -n 20; echo ===; grep -rn \\\"specpin\\\\.\\\\|specdoc\\\\.\\\" --include=\\\"*.go\\\" internal/localstore/ internal/cigate/ | head -n 30; echo ===; cat .github/workflows/ci.yml | sed -n '1,120p'\",\n  \"description\": \"Find localstore pin binding and CI legs\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"internal/secprim/doc.go:29://     internal/localstore, which already implement AC-PATH-001.\\ninternal/localstore/paths.go:1:// Package localstore implements the AX owner-local path layout and immutable\\ninternal/localstore/paths.go:3:package localstore\\ninternal/localstore/atomic_rename_darwin.go:3:package localstore\\ninternal/localstore/projection_lock_unsupported.go:3:package localstore\\ninternal/localstore/atomic_rename_windows.go:3:package localstore\\ninternal/localstore/atomic_rename_linux.go:3:package localstore\\ninternal/localstore/ownership_unix.go:3:package localstore\\ninternal/localstore/blob_inspection.go:1:package localstore\\ninternal/localstore/projection_lock_unix.go:3:package localstore\\ninternal/localstore/object_store.go:1:package localstore\\ninternal/localstore/ownership_windows.go:3:package localstore\\ninternal/localstore/atomic_rename_unsupported.go:3:package localstore\\ninternal/localstore/projection.go:1:package localstore\\n===\\ninternal/localstore/paths.go:174:\\tmanifest, err := specpin.Current()\\ninternal/cigate/contracts.go:29:\\treturn checkReleaseRoots(specpin.ReleaseV050, specpin.ReleaseV043,\\ninternal/cigate/contracts.go:57:\\tmanifest, err := specpin.Current()\\ninternal/cigate/contracts.go:66:func pinContractSets(manifest specpin.Manifest) (map[string][]ContractVersions, error) {\\ninternal/cigate/contracts.go:187:func fromPinContracts(contracts []specpin.ContractPin) []ContractVersions {\\n===\\nname: CI\\n\\non:\\n  pull_request:\\n  push:\\n    branches:\\n      - main\\n\\npermissions:\\n  contents: read\\n\\n# What green means. Every job below proves its selection matched something:\\n# a grep, glob, file scan, matrix expansion, or test selector that finds\\n# nothing fails closed instead of passing on an empty result set. No job\\n# declares an `if:` condition, so no job can skip quietly; gates-verdict\\n# additionally refuses any skipped, failed, or cancelled dependency.\\n#\\n# GOOS=windows work is compile-and-vet only. A green windows-compile-only job\\n# proves the tree type-checks for Windows; it never implies executed\\n# behaviour. Coverage is reported as numbers, not enforced as a floor.\\njobs:\\n  contract-preservation:\\n    name: Contract preservation (v0.5.0 current, v0.4.3 historical)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 10\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      - name: Verify specification-to-code ownership\\n        run: go run ./internal/traceability/cmd/tracecheck\\n\\n      # The diff proves the committed catalog matches generator output, but\\n      # `go generate` runs nothing when its directive is disarmed: rewriting\\n      # `//go:generate` as `// go:generate` preserves the token while turning\\n      # the directive into a plain comment, so generation is skipped and the\\n      # diff stays clean. The anchored check refuses that token-preserving\\n      # rewrite; only the exact directive form counts. A new directive\\n      # without a pin update reddens here (and in\\n      # TestGenerateDirectiveStaysRecognizedForm) instead of going unchecked.\\n      - name: Verify generated catalog is current\\n        run: |\\n          test \\\"$(grep -c '^//go:generate' internal/catalog/catalog.go)\\\" -eq 1\\n          go generate ./internal/catalog\\n          git diff --exit-code -- internal/catalog/catalog_gen.go\\n\\n      # The release roots are derived from internal/specpin and\\n      # internal/catalog inside the gate, never retyped here. Each -- PASS\\n      # guard below must match: a selector that runs nothing fails here\\n      # instead of passing silently.\\n      - name: Run pinned contract-version gates\\n        run: |\\n          set +e\\n          go test ./internal/cigate -run 'TestVerifyContractPreservationLive|TestPinnedReleasesAgreeAcrossAuthorities|TestDerivedSetsAreComplete|TestCheckAgreementAdmitsIdenticalSets|TestCheckAgreementRefusals|TestCheckReleaseRootsRefusesDrift' -count=1 -v > cigate-contracts.log 2>&1\\n          code=$?\\n          set -e\\n          cat cigate-contracts.log\\n          test $code -eq 0\\n          for gate in TestVerifyContractPreservationLive TestPinnedReleasesAgreeAcrossAuthorities TestDerivedSetsAreComplete TestCheckAgreementAdmitsIdenticalSets TestCheckAgreementRefusals TestCheckReleaseRootsRefusesDrift; do\\n            grep -q \\\"^--- PASS: ${gate}\\\" cigate-contracts.log\\n          done\\n\\n  lint:\\n    name: Linters (vet, Windows vet, gofmt)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 10\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      - name: Vet\\n        run: go vet ./...\\n\\n      - name: Vet Windows build-tagged sources\\n        run: GOOS=windows go vet ./...\\n\\n      # gofmt lists only offending files, so a clean tree prints nothing.\\n      # The file count proves the scan was not empty; the log must then be.\\n      - name: Check formatting\\n        run: |\\n          count=$(find internal -name '*.go' | wc -l | tr -d ' ')\\n          echo \\\"go files scanned: ${count}\\\"\\n          test \\\"${count}\\\" -gt 0\\n          set +e\\n          gofmt -l internal > gofmt.log 2>&1\\n          code=$?\\n          set -e\\n          cat gofmt.log\\n          test $code -eq 0\\n          test ! -s gofmt.log\\n\\n  test:\\n    name: Build and test (no cache)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 15\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      - name: Build\\n        run: go build ./...\\n\\n      # Verbose on purpose: the --- SKIP lines are the suite-wide skip\\n      # datum. At least one package must report ok: a suite that matched\\n      # nothing is a failure, not a pass.\\n\",\n  \"original_output_bytes\": 5861,\n  \"original_output_tokens\": 1466,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
