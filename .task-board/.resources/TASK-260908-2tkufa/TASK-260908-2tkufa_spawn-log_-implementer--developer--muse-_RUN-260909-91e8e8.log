{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cd15","stream":{"kind":"session","id":"01a08707-ceef-7493-9b49-24effd76d285"},"sequence":1253,"recorded_at":1780531400002501,"record_type":"event","durability":"durable","causation_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","run_stream":{"kind":"run","id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3"},"task_stream":{"kind":"task","id":"b6d4cc6b-bbd9-4991-8896-3b775e9e1ddf"},"task_id":"b6d4cc6b-bbd9-4991-8896-3b775e9e1ddf","event":{"kind":"output","task_id":"b6d4cc6b-bbd9-4991-8896-3b775e9e1ddf","chunk":"{\n  \"chunk_id\": \"exec-60-1\",\n  \"command\": \"python3 << 'EOF'\\nsrc = open('internal/catalog/catalog.v0.5.0.json').read()\\n\\n# 1. source -> adopted v0.6.0 authority\\nold_source = '''    \\\"release\\\": \\\"v0.5.0\\\",\\n    \\\"commit\\\": \\\"28bf96d7dd7ebf3cd9e2ccd91d35b8660699dd5c\\\",\\n    \\\"document_path\\\": \\\"SPEC.md\\\",\\n    \\\"document_sha256\\\": \\\"562546d240f0fa3e71b47e6359a002f9892c0efd97e19eb55917527552ac484a\\\"'''\\nnew_source = '''    \\\"release\\\": \\\"v0.6.0\\\",\\n    \\\"commit\\\": \\\"0cbdf100dbf84df50c64f792b1f940e3a67859a6\\\",\\n    \\\"document_path\\\": \\\"SPEC.md\\\",\\n    \\\"document_sha256\\\": \\\"74504539fb43c28ae3450622bc1002e643f116cd3e14df4567a882231e90896b\\\"'''\\nassert src.count(old_source) == 1\\nsrc = src.replace(old_source, new_source)\\n\\n# 2. every releases array gains ordered v0.6.0 tail\\nassert src.count('\\\"releases\\\": [\\\"v0.5.0\\\"]') == 43\\nsrc = src.replace('\\\"releases\\\": [\\\"v0.5.0\\\"]', '\\\"releases\\\": [\\\"v0.5.0\\\", \\\"v0.6.0\\\"]')\\nassert src.count('\\\"releases\\\": [\\\"v0.4.3\\\", \\\"v0.5.0\\\"]') == 14\\nsrc = src.replace('\\\"releases\\\": [\\\"v0.4.3\\\", \\\"v0.5.0\\\"]', '\\\"releases\\\": [\\\"v0.4.3\\\", \\\"v0.5.0\\\", \\\"v0.6.0\\\"]')\\n\\n# 3. mesh_rpc family only (SPEC 11.10.1: RPC 5 carries the exact RPC-4 operations)\\nold_mesh = '''      \\\"family\\\": \\\"mesh_rpc\\\",\\n      \\\"contract_id\\\": \\\"urn:ax:protocol:rpc\\\",\\n      \\\"contract_versions\\\": [\\\"2.0.0\\\", \\\"3.0.0\\\", \\\"4.0.0\\\"],'''\\nnew_mesh = '''      \\\"family\\\": \\\"mesh_rpc\\\",\\n      \\\"contract_id\\\": \\\"urn:ax:protocol:rpc\\\",\\n      \\\"contract_versions\\\": [\\\"2.0.0\\\", \\\"3.0.0\\\", \\\"4.0.0\\\", \\\"5.0.0\\\"],'''\\nassert src.count(old_mesh) == 1\\nsrc = src.replace(old_mesh, new_mesh)\\n\\n# 4. Structured Error 1.4.0 versions + group (SPEC 14.7.3: exactly five codes)\\nold_err = '\\\"contract_versions\\\": [\\\"1.0.0\\\", \\\"1.1.0\\\", \\\"1.2.0\\\", \\\"1.3.0\\\"],'\\nassert src.count(old_err) == 1\\nsrc = src.replace(old_err, '\\\"contract_versions\\\": [\\\"1.0.0\\\", \\\"1.1.0\\\", \\\"1.2.0\\\", \\\"1.3.0\\\", \\\"1.4.0\\\"],')\\nanchor = '''          {\\\"exit_code\\\": 13, \\\"codes\\\": [\\\"terminal_backend_protocol_error\\\", \\\"terminal_backend_process_failed\\\", \\\"terminal_backend_timeout\\\"]}\\n        ]\\n      }'''\\nassert src.count(anchor) == 1\\ngroup140 = anchor + ''',\\n      {\\n        \\\"introduced_version\\\": \\\"1.4.0\\\",\\n        \\\"releases\\\": [\\\"v0.6.0\\\"],\\n        \\\"mappings\\\": [\\n          {\\\"exit_code\\\": 3, \\\"codes\\\": [\\\"selector_observation_unavailable\\\"]},\\n          {\\\"exit_code\\\": 4, \\\"codes\\\": [\\\"selector_source_not_found\\\"]},\\n          {\\\"exit_code\\\": 8, \\\"codes\\\": [\\\"selector_source_read_failed\\\"]},\\n          {\\\"exit_code\\\": 12, \\\"codes\\\": [\\\"selector_bootstrap_incomplete\\\"]},\\n          {\\\"exit_code\\\": 16, \\\"codes\\\": [\\\"selector_plan_stale\\\"]}\\n        ]\\n      }'''\\nsrc = src.replace(anchor, group140)\\n\\nopen('internal/catalog/catalog.v0.6.0.json', 'w').write(src)\\nprint('wrote compact catalog.v0.6.0.json')\\nEOF\\nls -la internal/catalog/*.json; git diff --stat 2>/dev/null | tail -3\",\n  \"description\": \"Author compact v0.6.0 metadata via textual delta\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"wrote compact catalog.v0.6.0.json\\n-rw-r--r--@ 1 iv  staff  30445 Sep  9 19:59 internal/catalog/catalog.v0.5.0.json\\n-rw-r--r--@ 1 iv  staff  31501 Sep  9 20:46 internal/catalog/catalog.v0.6.0.json\\n internal/specpin/pin.go | 26 +++++++++++++++++---------\\n 1 file changed, 17 insertions(+), 9 deletions(-)\\n\",\n  \"original_output_bytes\": 303,\n  \"original_output_tokens\": 76,\n  \"truncated\": false\n}"}}}
