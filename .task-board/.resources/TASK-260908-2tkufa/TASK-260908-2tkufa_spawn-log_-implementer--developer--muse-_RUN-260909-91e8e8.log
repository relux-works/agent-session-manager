{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5b3","stream":{"kind":"session","id":"01a08707-ceef-7493-9b49-24effd76d285"},"sequence":308,"recorded_at":1780531400000611,"record_type":"event","durability":"durable","causation_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","run_stream":{"kind":"run","id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3"},"task_stream":{"kind":"task","id":"4e482195-0d28-445c-8828-d0992ad3de7c"},"task_id":"4e482195-0d28-445c-8828-d0992ad3de7c","event":{"kind":"output","task_id":"4e482195-0d28-445c-8828-d0992ad3de7c","chunk":"Read text file `internal/cigate/contracts.go`.\n1|package cigate\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"sort\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/specpin\"\n9|)\n10|\n11|// ContractVersions is one pinned contract with its exact ordered versions.\n12|type ContractVersions struct {\n13|\tName     string\n14|\tID       string\n15|\tVersions []string\n16|}\n17|\n18|// ReleaseContracts binds one release to its full derived contract set.\n19|type ReleaseContracts struct {\n20|\tRelease   string\n21|\tContracts []ContractVersions\n22|}\n23|\n24|// PinnedReleases returns the releases both authorities represent, after\n25|// requiring the two packages to agree on the release roots themselves. It\n26|// lists no versions: every version below these roots is derived, never\n27|// retyped.\n28|func PinnedReleases() ([]string, error) {\n29|\treturn checkReleaseRoots(specpin.ReleaseV050, specpin.ReleaseV043,\n30|\t\tstring(catalog.ReleaseV050), string(catalog.ReleaseV043))\n31|}\n32|\n33|// checkReleaseRoots is the testable core of PinnedReleases: production passes\n34|// the two packages' release constants, tests pass synthetic roots. Either\n35|// side renaming a release without the other is drift, not a wider registry,\n36|// and is refused.\n37|func checkReleaseRoots(pinCurrent, pinHistorical, catalogCurrent, catalogHistorical string) ([]string, error) {\n38|\tif pinCurrent != catalogCurrent {\n39|\t\treturn nil, fmt.Errorf(\"cigate: current release root drift: specpin %q catalog %q\",\n40|\t\t\tpinCurrent, catalogCurrent)\n41|\t}\n42|\tif pinHistorical != catalogHistorical {\n43|\t\treturn nil, fmt.Errorf(\"cigate: historical release root drift: specpin %q catalog %q\",\n44|\t\t\tpinHistorical, catalogHistorical)\n45|\t}\n46|\tif pinCurrent == \"\" || pinHistorical == \"\" || pinCurrent == pinHistorical {\n47|\t\treturn nil, fmt.Errorf(\"cigate: release roots are empty or indistinct\")\n48|\t}\n49|\treturn []string{pinCurrent, pinHistorical}, nil\n50|}\n51|\n52|// PinContractSets derives every pinned (contract, version) set from the\n53|// embedded specification lock, keyed by release. The historical projection\n54|// comes from ContractsForRelease, so absent contracts and version overrides\n55|// are the lock's own, not a retyped copy.\n56|func PinContractSets() (map[string][]ContractVersions, error) {\n57|\tmanifest, err := specpin.Current()\n58|\tif err != nil {\n59|\t\treturn nil, fmt.Errorf(\"cigate: load pinned source: %w\", err)\n60|\t}\n61|\treturn pinContractSets(manifest)\n62|}\n63|\n64|// pinContractSets is the testable core over an explicit manifest: production\n65|// passes the embedded one, tests pass synthetic ones.\n66|func pinContractSets(manifest specpin.Manifest) (map[string][]ContractVersions, error) {\n67|\treleases, err := PinnedReleases()\n68|\tif err != nil {\n69|\t\treturn nil, err\n70|\t}\n71|\tsets := make(map[string][]ContractVersions, len(releases))\n72|\tfor _, release := range releases {\n73|\t\tcontracts, err := manifest.ContractsForRelease(release)\n74|\t\tif err != nil {\n75|\t\t\treturn nil, fmt.Errorf(\"cigate: derive pinned %s contracts: %w\", release, err)\n76|\t\t}\n77|\t\tsets[release] = fromPinContracts(contracts)\n78|\t}\n79|\treturn sets, nil\n80|}\n81|\n82|// CatalogContractSets derives every (contract, version) set from the\n83|// generated catalog projections, keyed by release.\n84|func CatalogContractSets() (map[string][]ContractVersions, error) {\n85|\treleases, err := PinnedReleases()\n86|\tif err != nil {\n87|\t\treturn nil, err\n88|\t}\n89|\tsets := make(map[string][]ContractVersions, len(releases))\n90|\tfor _, release := range releases {\n91|\t\tprojected, err := catalog.ForRelease(catalog.Release(release))\n92|\t\tif err != nil {\n93|\t\t\treturn nil, fmt.Errorf(\"cigate: derive catalog %s contracts: %w\", release, err)\n94|\t\t}\n95|\t\tconverted := make([]ContractVersions, 0, len(projected.Contracts))\n96|\t\tfor _, contract := range projected.Contracts {\n97|\t\t\tconverted = append(converted, ContractVersions{\n98|\t\t\t\tName:     contract.Name,\n99|\t\t\t\tID:       string(contract.ID),\n100|\t\t\t\tVersions: append([]string(nil), contract.Versions...),\n101|\t\t\t})\n102|\t\t}\n103|\t\tsets[release] = converted\n104|\t}\n105|\treturn sets, nil\n106|}\n107|\n108|// VerifyContractPreservation requires the pinned lock and the generated\n109|// catalog to agree exactly on every release: same contracts, same\n110|// identifiers, same ordered versions. A version either side cannot account\n111|// for is refused with its name, not averaged away. It reports the first\n112|// disagreement; CI reruns are cheap and deterministic.\n113|func VerifyContractPreservation() error {\n114|\tpinned, err := PinContractSets()\n115|\tif err != nil {\n116|\t\treturn err\n117|\t}\n118|\tprojected, err := CatalogContractSets()\n119|\tif err != nil {\n120|\t\treturn err\n121|\t}\n122|\treturn checkAgreement(pinned, projected)\n123|}\n124|\n125|// checkAgreement is the testable core over explicit sets: production passes\n126|// the derived ones, tests pass synthetic ones.\n127|func checkAgreement(pinned, projected map[string][]ContractVersions) error {\n128|\treleases, err := PinnedReleases()\n129|\tif err != nil {\n130|\t\treturn err\n131|\t}\n132|\tfor _, release := range releases {\n133|\t\twant, ok := pinned[release]\n134|\t\tif !ok {\n135|\t\t\treturn fmt.Errorf(\"cigate: pinned authority accounts for no %s set\", release)\n136|\t\t}\n137|\t\tgot, ok := projected[release]\n138|\t\tif !ok {\n139|\t\t\treturn fmt.Errorf(\"cigate: catalog authority accounts for no %s set\", release)\n140|\t\t}\n141|\t\tif err := checkReleaseSet(release, want, got); err != nil {\n142|\t\t\treturn err\n143|\t\t}\n144|\t}\n145|\treturn nil\n146|}\n147|\n148|func checkReleaseSet(release string, pinned, projected []ContractVersions) error {\n149|\twant := indexContracts(pinned)\n150|\tgot := indexContracts(projected)\n(more lines below)"}}}
