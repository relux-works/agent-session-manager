n  coverage:\\n    name: Coverage numbers (reported, no floor)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 15\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      # Coverage is a number, not a gate: this job reports per-package\\n      # percentages and refuses only an unreadable or empty result.\\n      - name: Test with coverage\\n        run: |\\n          set +e\\n          go test ./... -cover -count=1 > cover.log 2>&1\\n          code=$?\\n          set -e\\n          cat cover.log\\n          test $code -eq 0\\n          test \\\"$(grep -c 'coverage: ' cover.log)\\\" -gt 0\\n          {\\n            echo \\\"## Coverage\\\"\\n            echo \\\"\\\"\\n            echo \\\"| Package | Coverage |\\\"\\n            echo \\\"| --- | --- |\\\"\\n            grep 'coverage: ' cover.log | sed -E 's/^(ok|---)[[:space:]]+([^[:space:]]+).*coverage: ([0-9.]+% of statements)/| `\\\\2` | \\\\3 |/' || true\\n            echo \\\"\\\"\\n            echo \\\"Packages without test files (stated bounds, not failures):\\\"\\n            echo \\\"\\\"\\n            grep 'no test files' cover.log || echo \\\"none\\\"\\n          } >> \\\"$GITHUB_STEP_SUMMARY\\\"\\n\\n  fixture-matrix:\\n    name: Conformance fixtures (${{ matrix.os }}, ${{ matrix.package }})\\n    runs-on: ${{ matrix.os }}\\n    timeout-minutes: 15\\n    strategy:\\n      fail-fast: false\\n      matrix:\\n        os: [ubuntu-latest, macos-latest]\\n        package: [internal/secprim, internal/secconftest]\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      # Verbose on purpose: the --- SKIP lines are the skip datum, and the\\n      # secconftest capabilities line witnesses the probe counters after the\\n      # whole suite. Skips are loud here by construction.\\n      - name: Run fixture package\\n        run: |\\n          set +e\\n          go test ./${{ matrix.package }} -count=1 -v > fixture.log 2>&1\\n          code=$?\\n          set -e\\n          grep '^--- SKIP' fixture.log || echo \\\"no skipped tests\\\"\\n          grep 'secconftest capabilities on' fixture.log || true\\n          {\\n            echo \\\"## Fixture run ${{ matrix.os }} ${{ matrix.package }}\\\"\\n            echo \\\"\\\"\\n            echo \\\"Skipped: $(grep -c '^--- SKIP' fixture.log || true)\\\"\\n          } >> \\\"$GITHUB_STEP_SUMMARY\\\"\\n          test $code -eq 0\\n          test \\\"$(grep -c '^--- PASS' fixture.log)\\\" -gt 0\\n\\n  fuzz-smoke:\\n    name: Fuzz smoke (derived targets)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 15\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      # Targets are derived per package from the compiled test binaries,\\n      # never retyped: only names starting with Fuzz are fuzz targets. An\\n      # empty leg fails the total-count pin below: the grep sits in a\\n      # pipeline whose exit status the shell discards, so it refuses\\n      # nothing, and the non-empty-file check refuses only the\\n      # every-package-empty case — a single silently empty package dies\\n      # only at the pinned total. A new fuzz target without a CI update\\n      # reddens here instead of going unsmoked.\\n      - name: Derive fuzz targets\\n        run: |\\n          rm -f fuzz-targets.clean\\n          for pkg in internal/secconftest internal/canonicaljson internal/scalar; do\\n            go test \\\"./${pkg}\\\" -list '^Fuzz' > \\\"fuzz-targets-$(basename \\\"${pkg}\\\").log\\\" 2>&1\\n            grep '^Fuzz' \\\"fuzz-targets-$(basename \\\"${pkg}\\\").log\\\" | sed \\\"s|^|${pkg} |\\\" >> fuzz-targets.clean\\n          done\\n          test -s fuzz-targets.clean\\n          test \\\"$(wc -l < fuzz-targets.clean | tr -d ' ')\\\" -eq 13\\n          cat fuzz-targets.clean\\n\\n      # The secconftest leg of that list must equal the cigate.FuzzTargets\\n      # derivation, which maps each target to the production entry it\\n      # drives. Either side drifting — a target without an entry, or an\\n      # entry without a target — fails the diff before any smoke runs.\\n      - name: Check secconftest list matches the target derivation\\n        run: |\\n          set +e\\n          go test ./internal/cigate -run 'TestListedTargetsMatchDerivation|TestFuzzTargetsAreDerivedSorted' -count=1 -v > cigate-targets.log 2>&1\\n          code=$?\\n          set -e\\n          cat cigate-targets.log\\n          test $code -eq 0\\n          for gate in TestListedTargetsMatchDerivation TestFuzzTargetsAreDerivedSorted; do\\n            grep -q \\\"^--- PASS: ${gate}\\\" cigate-targets.log\\n          done\\n\\n      # A -fuzz selector that matches nothing exits 0 with \\\"no fuzz tests\\n      # to fuzz\\\", so exit status alone cannot prove execution. The\\n      # '^fuzz: elapsed' line proves the engine ran; its absence fails.\\n      # It does not prove the mutation phase: at -fuzztime=100x the\\n      # large-corpus targets (secconftest/FuzzRedactCorpus, all four\\n      # canonicaljson targets) spend the budget on baseline coverage and\\n      # never print 'now fuzzing'. Lengthening the budget or shrinking a\\n      # corpus changes that without reddening here.\\n      - name: Smoke each target\\n        run: |\\n          while read -r pkg target; do\\n            go test \\\"./${pkg}\\\" -run='^$' -fuzz=\\\"^${target}$\\\" -fuzztime=100x -parallel=1 -count=1 > \\\"fuzz-$(basename \\\"${pkg}\\\")-${target}.log\\\" 2>&1\\n            grep -q '^fuzz: elapsed' \\\"fuzz-$(basename \\\"${pkg}\\\")-${target}.log\\\"\\n          done < fuzz-targets.clean\\n\\n  capability-claims:\\n    name: Unsupported-capability claim check\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 10\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      # The vocabulary is secconftest's probe set; the gate scans the README\\n      # with every probe forced unavailable — the strongest posture, and\\n      # host-independent: a backticked capability mention that reads as a\\n      # positive availability claim is refused no matter what this host's\\n      # probes would report. CheckAdvertisements reads ProbeState.Available\\n      # from the states it is given, and both postures are driven\\n      # (TestRealREADMECarriesNoPositiveClaim forces all unavailable,\\n      # TestRealREADMEAdmitsWhenAllAvailable forces all available). What\\n      # reaches no availability reader is the live probe outcome:\\n      # ProbeStates feeds only CapabilityIDs, which keeps the IDs and\\n      # drops availability. README prose is never capability evidence\\n      # either way.\\n      - name: Check README with all probes forced unavailable\\n        run: |\\n          set +e\\n          go test ./internal/cigate -run 'TestRealREADMECarriesNoPositiveClaim|TestRealREADMEAdmitsWhenAllAvailable|TestCapabilityIDsAreDerivedSorted|TestPositiveClaimsAreRefused|TestNegatedClaimsAreAdmitted|TestUnclassifiedMentionIsRefused' -count=1 -v > cigate-claims.log 2>&1\\n          code=$?\\n          set -e\\n          cat cigate-claims.log\\n          test $code -eq 0\\n          for gate in TestRealREADMECarriesNoPositiveClaim TestRealREADMEAdmitsWhenAllAvailable TestCapabilityIDsAreDerivedSorted TestPositiveClaimsAreRefused TestNegatedClaimsAreAdmitted TestUnclassifiedMentionIsRefused; do\\n            grep -q \\\"^--- PASS: ${gate}\\\" cigate-claims.log\\n          done\\n\\n  windows-compile-only:\\n    name: Windows compile-only (no execution implied)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 10\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\",\n  \"original_output_bytes\": 8742,\n  \"original_output_tokens\": 2186,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
