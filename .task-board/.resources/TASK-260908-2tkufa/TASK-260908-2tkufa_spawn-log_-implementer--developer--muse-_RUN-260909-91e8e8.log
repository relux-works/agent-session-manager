{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb47","stream":{"kind":"session","id":"01a08707-ceef-7493-9b49-24effd76d285"},"sequence":1022,"recorded_at":1780531400002039,"record_type":"event","durability":"durable","causation_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","run_stream":{"kind":"run","id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3"},"task_stream":{"kind":"task","id":"948b2510-c241-4dd3-a495-dfd3cb3be922"},"task_id":"948b2510-c241-4dd3-a495-dfd3cb3be922","event":{"kind":"output","task_id":"948b2510-c241-4dd3-a495-dfd3cb3be922","chunk":"Read text file `internal/traceability/traceability.go`.\n(1227 line(s) above)\n1228|\t\tTotal:      len(inventory),\n1229|\t\tGap:        group.Gap,\n1230|\t}, nil\n1231|}\n1232|\n1233|// quoteBeginsAtLine reports whether the normalized excerpt occurs in the pinned\n1234|// document beginning on the given line. An excerpt matching elsewhere, or\n1235|// nowhere, is not a quote of the clause it claims.\n1236|func quoteBeginsAtLine(document *specdoc.Document, excerpt string, line int) bool {\n1237|\tfor _, candidate := range document.QuoteLines(excerpt) {\n1238|\t\tif candidate == line {\n1239|\t\t\treturn true\n1240|\t\t}\n1241|\t}\n1242|\treturn false\n1243|}\n1244|\n1245|// verifyUnownedSections checks the disclosed unimplemented sections. An entry\n1246|// must name a real section, must not also be owned, must not cover a section\n1247|// the generated catalog requires an owner for, and must state a gap and the\n1248|// evidence for it.\n1249|func verifyUnownedSections(\n1250|\tentries []unownedSection,\n1251|\tallowed map[string]struct{},\n1252|\trequiredByCatalog map[string]struct{},\n1253|\towned map[string]struct{},\n1254|) (map[string]unownedSection, error) {\n1255|\tresult := make(map[string]unownedSection, len(entries))\n1256|\tfor index, entry := range entries {\n1257|\t\tif entry.Key == \"\" {\n1258|\t\t\treturn nil, fail(\"unowned section %d has an empty key\", index)\n1259|\t\t}\n1260|\t\tif _, duplicate := result[entry.Key]; duplicate {\n1261|\t\t\treturn nil, fail(\"duplicate unowned section %q\", entry.Key)\n1262|\t\t}\n1263|\t\tif _, known := allowed[entry.Key]; !known {\n1264|\t\t\treturn nil, fail(\"unowned section %q is self-minted for an unknown section\", entry.Key)\n1265|\t\t}\n1266|\t\tif _, required := requiredByCatalog[entry.Key]; required {\n1267|\t\t\treturn nil, fail(\n1268|\t\t\t\t\"unowned section %q is required to have an implementation owner by the generated catalog\", entry.Key)\n1269|\t\t}\n1270|\t\tif _, conflict := owned[entry.Key]; conflict {\n1271|\t\t\treturn nil, fail(\"section %q is registered as both owned and unowned\", entry.Key)\n1272|\t\t}\n1273|\t\tdisplay, err := sectionDisplayName(entry.Key)\n1274|\t\tif err != nil {\n1275|\t\t\treturn nil, fail(\"unowned section %q: %v\", entry.Key, err)\n1276|\t\t}\n1277|\t\t// An unowned section has no production declaration by construction, so\n1278|\t\t// the gap is checked for length and a whole-identifier section mention\n1279|\t\t// only, and the separate evidence field carries the rest.\n1280|\t\tif err := verifyGapDiscloses(entry.Gap, display, \"\"); err != nil {\n1281|\t\t\treturn nil, fail(\"unowned section %q does not name what %s leaves unimplemented: %v\", entry.Key, display, err)\n1282|\t\t}\n1283|\t\tif len(entry.Evidence) < minimumGapLength {\n1284|\t\t\treturn nil, fail(\"unowned section %q states no evidence for its gap\", entry.Key)\n1285|\t\t}\n1286|\t\tresult[entry.Key] = entry\n1287|\t}\n1288|\treturn result, nil\n1289|}"}}}
