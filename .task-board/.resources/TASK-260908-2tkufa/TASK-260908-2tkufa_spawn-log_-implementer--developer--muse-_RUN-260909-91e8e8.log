{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca5d","stream":{"kind":"session","id":"01a08707-ceef-7493-9b49-24effd76d285"},"sequence":905,"recorded_at":1780531400001805,"record_type":"event","durability":"durable","causation_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","run_stream":{"kind":"run","id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3"},"call_id":"call_01a0870c8239770096585efcf7215f2b","text":"{\n  \"chunk_id\": \"exec-42-1\",\n  \"command\": \"python3 -c \\\"\\nimport json\\no=json.load(open('internal/traceability/ownership.v0.5.0.json'))\\nfor g in o['ownership']:\\n    if g['kind']=='section_binding':\\n        k=g['keys'][0]\\n        sec=k.split(':')[1].split('.')[0]\\n        if sec in ('6','11','14','15'):\\n            print(k,'|',g['production']['path']+':'+g['production']['declaration'],'|',g.get('coverage'),'|',len(g.get('clauses',[])),'|',g.get('acceptance_cases'))\\n\\\"\",\n  \"description\": \"List existing bindings for sections 6 11 14 15\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"section:6.1 | internal/config/loader.go:Load | unevidenced | 0 | ['config-versioned-readers']\\nsection:6.2 | internal/config/schema.go:Decode | full | 1 | ['config-versioned-readers']\\nsection:6.3 | internal/config/validation.go:validateConfiguration | unevidenced | 0 | ['config-versioned-readers', 'config-current-writer']\\nsection:6.4 | internal/config/migration.go:Migrate | unevidenced | 0 | ['config-versioned-readers', 'config-durable-migration', 'config-durable-migration-os-entry']\\nsection:6.5 | internal/config/validation.go:translateV3 | unevidenced | 0 | ['config-versioned-readers', 'config-current-writer', 'config-durable-migration', 'config-durable-migration-os-entry']\\nsection:11.2 | internal/catalog/catalog.go:ForRelease | unevidenced | 0 | ['catalog-v050-exact']\\nsection:11.3 | internal/catalog/catalog.go:ForRelease | unevidenced | 0 | ['catalog-v050-exact']\\nsection:11.8 | internal/catalog/catalog.go:ForRelease | unevidenced | 0 | ['catalog-v050-exact']\\nsection:11.9 | internal/catalog/catalog.go:ForRelease | unevidenced | 0 | ['catalog-v050-exact']\\nsection:15.1 | internal/axerror/axerror.go:New | partial | 5 | ['structured-error-exact-object', 'structured-error-shape-refusal', 'structured-error-detail-redaction', 'structured-error-detail-inertness', 'structured-error-static-binding', 'structured-error-unknown-code-reader', 'structured-error-local-untrusted', 'cli-result-message-independence', 'structured-error-historical-envelopes', 'structured-error-identity-precedence', 'structured-error-common-data-model']\\nsection:15.2 | internal/axerror/registry.go:ExitCodeFor | unmeasured | 0 | ['structured-error-code-exit-registry', 'cli-result-exit-status-mapping', 'structured-error-exit-status-fan-in']\\nsection:15.3 | internal/axerror/registry.go:ExitCodeFor | partial | 2 | ['structured-error-code-exit-registry', 'structured-error-unknown-code-reader', 'structured-error-typed-details', 'cli-result-historical-envelopes', 'structured-error-exit-status-fan-in']\\nsection:14.2 | internal/cliresult/output.go:Emit | partial | 8 | ['cli-result-envelope-exact', 'cli-result-envelope-refusal', 'cli-result-body-closure', 'cli-result-common-flags', 'cli-result-yes-admission', 'cli-result-json-one-document', 'cli-result-destructive-confirmation', 'cli-result-expectation-flags', 'cli-result-rpc-serve-rejects-json', 'cli-result-takeover-adoption', 'cli-result-exit-status-mapping', 'cli-result-unimplemented-surface-refusal', 'cli-result-machine-reading', 'cli-result-stderr-independence', 'cli-result-historical-envelopes', 'cli-result-message-independence', 'cli-result-identity-precedence']\\n\",\n  \"original_output_bytes\": 2615,\n  \"original_output_tokens\": 654,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
