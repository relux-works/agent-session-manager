(expression, \"-\")\n716|\t\t\tif len(parts) > 2 || len(parts) == 0 {\n717|\t\t\t\treturn fail(\"catalog normative section %q is not an exact section or range\", normativeSection)\n718|\t\t\t}\n719|\t\t\tstart := canonicalNumericSection(strings.TrimSpace(parts[0]))\n720|\t\t\tend := start\n721|\t\t\tif len(parts) == 2 {\n722|\t\t\t\tend = canonicalNumericSection(strings.TrimSpace(parts[1]))\n723|\t\t\t}\n724|\t\t\tidentifiers, err := expandV050SectionRange(start, end)\n725|\t\t\tif err != nil {\n726|\t\t\t\treturn fail(\"catalog normative section %q: %v\", normativeSection, err)\n727|\t\t\t}\n728|\t\t\tfor _, identifier := range identifiers {\n729|\t\t\t\tresult[sectionBindingKey(identifier)] = struct{}{}\n730|\t\t\t}\n731|\t\t}\n732|\t\tfor _, fixture := range fixtures {\n733|\t\t\tmatch := catalogAppendixPattern.FindStringSubmatch(fixture)\n734|\t\t\tif match != nil {\n735|\t\t\t\tresult[sectionBindingKey(\"appendix-\"+strings.ToLower(match[1]))] = struct{}{}\n736|\t\t\t}\n737|\t\t}\n738|\t\treturn nil\n739|\t}\n740|\tfor _, operation := range value.Operations {\n741|\t\tif err := addDefinition(operation.NormativeSection, operation.FixtureFamilies); err != nil {\n742|\t\t\treturn nil, err\n743|\t\t}\n744|\t}\n745|\tfor _, capability := range value.Capabilities {\n746|\t\tif err := addDefinition(capability.NormativeSection, capability.FixtureFamilies); err != nil {\n747|\t\t\treturn nil, err\n748|\t\t}\n749|\t}\n750|\tfor _, event := range value.Events {\n751|\t\tif err := addDefinition(event.NormativeSection, event.FixtureFamilies); err != nil {\n752|\t\t\treturn nil, err\n753|\t\t}\n754|\t}\n755|\tfor _, item := range value.Errors {\n756|\t\tif err := addDefinition(item.NormativeSection, item.FixtureFamilies); err != nil {\n757|\t\t\treturn nil, err\n758|\t\t}\n759|\t}\n760|\treturn result, nil\n761|}\n762|\n763|func canonicalNumericSection(identifier string) string {\n764|\tparts := strings.Split(identifier, \".\")\n765|\tfor index := 1; index < len(parts); index++ {\n766|\t\tif len(parts[index]) != 1 {\n767|\t\t\tcontinue\n768|\t\t}\n769|\t\tcharacter := parts[index][0]\n770|\t\tif (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z') {\n771|\t\t\tparts[index] = strings.ToUpper(parts[index])\n772|\t\t}\n773|\t}\n774|\treturn strings.Join(parts, \".\")\n775|}\n776|\n777|func cloneOwnershipSets(source map[ownershipKind]map[string]struct{}) map[ownershipKind]map[string]struct{} {\n778|\tresult := make(map[ownershipKind]map[string]struct{}, len(source))\n779|\tfor kind, values := range source {\n780|\t\tcloned := make(map[string]struct{}, len(values))\n781|\t\tfor value := range values {\n782|\t\t\tcloned[value] = struct{}{}\n783|\t\t}\n784|\t\tresult[kind] = cloned\n785|\t}\n786|\treturn result\n787|}\n788|\n789|func verifyCatalogContracts(want []specpin.ContractPin, got []catalog.Contract) error {\n790|\tif len(got) != len(want) {\n791|\t\treturn fail(\"current catalog has %d contracts, verified source has %d\", len(got), len(want))\n792|\t}\n793|\tfor index := range want {\n794|\t\tif got[index].Name != want[index].Name || string(got[index].ID) != want[index].ID ||\n795|\t\t\t!equalStrings(got[index].Versions, want[index].Versions) {\n796|\t\t\treturn fail(\"current catalog contract row %d differs from verified source\", index)\n797|\t\t}\n798|\t}\n799|\treturn nil\n800|}\n801|\n802|func expectedContracts(contracts []specpin.ContractPin) map[string]struct{} {\n803|\tresult := make(map[string]struct{}, len(contracts))\n804|\tfor _, contract := range contracts {\n805|\t\tresult[contractKey(contract.Name, contract.ID)] = struct{}{}\n806|\t}\n807|\treturn result\n808|}\n809|\n810|func contractKey(name, id string) string {\n811|\treturn name + \" [\" + id + \"]\"\n812|}\n813|\n814|func expectedNormativeSections(manifest specpin.Manifest, value catalog.Catalog) map[string]struct{} {\n815|\tresult := make(map[string]struct{})\n816|\tfor _, section := range manifest.Source.NormativeScope {\n817|\t\tresult[\"source:\"+section] = struct{}{}\n818|\t}\n819|\tfor _, operation := range value.Operations {\n820|\t\tresult[\"catalog:\"+operation.NormativeSection] = struct{}{}\n821|\t}\n822|\tfor _, capability := range value.Capabilities {\n823|\t\tresult[\"catalog:\"+capability.NormativeSection] = struct{}{}\n824|\t}\n825|\tfor _, event := range value.Events {\n826|\t\tresult[\"catalog:\"+event.NormativeSection] = struct{}{}\n827|\t}\n828|\tfor _, item := range value.Errors {\n829|\t\tresult[\"catalog:\"+item.NormativeSection] = struct{}{}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
