{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7e7","stream":{"kind":"session","id":"01a08707-ceef-7493-9b49-24effd76d285"},"sequence":590,"recorded_at":1780531400001175,"record_type":"event","durability":"durable","causation_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","run_stream":{"kind":"run","id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3"},"call_id":"call_01a0870a00ba7e73b75dd272b18a795a","text":"Read text file `internal/cataloggen/generate.go`.\n(499 line(s) above)\n500|\t\t}\n501|\t\tif !matched {\n502|\t\t\treturn fmt.Errorf(\"contract %q has no represented version in release %q\", contractID, release)\n503|\t\t}\n504|\t}\n505|\treturn nil\n506|}\n507|\n508|func validateContractBinding(contractID string, versions []string, contracts map[string]map[string]struct{}) error {\n509|\tavailable, ok := contracts[contractID]\n510|\tif !ok {\n511|\t\treturn fmt.Errorf(\"unknown contract %q\", contractID)\n512|\t}\n513|\tif len(versions) == 0 {\n514|\t\treturn fmt.Errorf(\"contract %q has no versions\", contractID)\n515|\t}\n516|\tseen := make(map[string]struct{}, len(versions))\n517|\tfor _, version := range versions {\n518|\t\tif _, ok := available[version]; !ok {\n519|\t\t\treturn fmt.Errorf(\"contract %q does not declare version %q\", contractID, version)\n520|\t\t}\n521|\t\tif _, duplicate := seen[version]; duplicate {\n522|\t\t\treturn fmt.Errorf(\"contract %q repeats version %q\", contractID, version)\n523|\t\t}\n524|\t\tseen[version] = struct{}{}\n525|\t}\n526|\treturn nil\n527|}\n528|\n529|func validateReleases(releases []string) error {\n530|\tif len(releases) == 0 {\n531|\t\treturn errors.New(\"release set is empty\")\n532|\t}\n533|\torder := map[string]int{specpin.ReleaseV043: 0, specpin.ReleaseV050: 1}\n534|\tprevious := -1\n535|\tfor _, release := range releases {\n536|\t\tposition, ok := order[release]\n537|\t\tif !ok {\n538|\t\t\treturn fmt.Errorf(\"unsupported release %q\", release)\n539|\t\t}\n540|\t\tif position <= previous {\n541|\t\t\treturn errors.New(\"release set is duplicated or out of order\")\n542|\t\t}\n543|\t\tprevious = position\n544|\t}\n545|\treturn nil\n546|}\n547|\n548|func uniqueNames(label string, names []string, pattern *regexp.Regexp) (map[string]struct{}, error) {\n549|\tresult := make(map[string]struct{}, len(names))\n550|\tfor _, name := range names {\n551|\t\tif !pattern.MatchString(name) {\n552|\t\t\treturn nil, invalid(\"%s has invalid name %q\", label, name)\n553|\t\t}\n554|\t\tif _, duplicate := result[name]; duplicate {\n555|\t\t\treturn nil, invalid(\"%s repeats %q\", label, name)\n556|\t\t}\n557|\t\tresult[name] = struct{}{}\n558|\t}\n559|\treturn result, nil\n560|}\n561|\n562|func expandOperations(families []operationFamily) []expandedOperation {\n563|\tvar result []expandedOperation\n564|\tfor _, family := range families {\n565|\t\tisolated := make(map[string]struct{}, len(family.IsolatedOutputs))\n566|\t\tfor _, name := range family.IsolatedOutputs {\n567|\t\t\tisolated[name] = struct{}{}\n568|\t\t}\n569|\t\tmutations := make(map[string]mutationGroup)\n570|\t\tfor _, group := range family.MutationGroups {\n571|\t\t\tfor _, name := range group.Operations {\n572|\t\t\t\tmutations[name] = group\n573|\t\t\t}\n574|\t\t}\n575|\t\tfor _, name := range family.Operations {\n576|\t\t\teffect := \"EffectNoDurableMutation\"\n577|\t\t\tvar idempotency string\n578|\t\t\tvar recovery []string\n579|\t\t\tif _, ok := isolated[name]; ok {\n580|\t\t\t\teffect = \"EffectIsolatedOutput\"\n581|\t\t\t}\n582|\t\t\tif mutation, ok := mutations[name]; ok {\n583|\t\t\t\teffect = \"EffectDurableMutation\"\n584|\t\t\t\tidempotency = mutation.IdempotencyKey\n585|\t\t\t\trecovery = mutation.RecoveryEvidence\n586|\t\t\t}\n587|\t\t\tresult = append(result, expandedOperation{\n588|\t\t\t\tFamily: family.Family, Name: name, ContractID: family.ContractID,\n589|\t\t\t\tContractVersions: family.ContractVersions, Effect: effect,\n590|\t\t\t\tIdempotencyKey: idempotency, RecoveryEvidence: recovery,\n591|\t\t\t\tNormativeSection: family.NormativeSection,\n592|\t\t\t\tFixtureFamilies:  family.FixtureFamilies, Releases: family.Releases,\n593|\t\t\t})\n594|\t\t}\n595|\t}\n596|\treturn result\n597|}\n598|\n599|func expandCapabilities(families []capabilityFamily) []expandedCapability {\n600|\tvar result []expandedCapability\n601|\tfor _, family := range families {\n602|\t\tfor _, name := range family.Capabilities {\n603|\t\t\tresult = append(result, expandedCapability{\n604|\t\t\t\tFamily: family.Family, Name: name, ContractID: family.ContractID,\n605|\t\t\t\tContractVersions: family.ContractVersions, NormativeSection: family.NormativeSection,\n606|\t\t\t\tFixtureFamilies: family.FixtureFamilies, Releases: family.Releases,\n607|\t\t\t})\n608|\t\t}\n609|\t}\n610|\treturn result\n611|}\n612|\n613|func expandEvents(families []eventFamily) []expandedEvent {\n614|\tvar result []expandedEvent\n615|\tfor _, family := range families {\n616|\t\tfor _, group := range family.Groups {\n617|\t\t\tfor _, name := range group.Events {\n618|\t\t\t\tresult = append(result, expandedEvent{\n619|\t\t\t\t\tFamily: family.Family, Name: name, ContractID: family.ContractID,\n620|\t\t\t\t\tContractVersions: group.ContractVersions, NormativeSection: family.NormativeSection,\n621|\t\t\t\t\tFixtureFamilies: family.FixtureFamilies, Releases: family.Releases,\n622|\t\t\t\t})\n623|\t\t\t}\n624|\t\t}\n625|\t}\n626|\treturn result\n627|}\n628|\n629|func expandErrors(value errorCatalog) []expandedError {\n630|\tindex := make(map[string]int, len(value.ContractVersions))\n631|\tfor position, version := range value.ContractVersions {\n632|\t\tindex[version] = position\n633|\t}\n634|\tvar result []expandedError\n635|\tfor _, group := range value.Groups {\n636|\t\tversions := append([]string(nil), value.ContractVersions[index[group.IntroducedVersion]:]...)\n637|\t\tfor _, mapping := range group.Mappings {\n638|\t\t\tfor _, code := range mapping.Codes {\n639|\t\t\t\tresult = append(result, expandedError{\n640|\t\t\t\t\tCode: code, ExitCode: mapping.ExitCode, ContractID: value.ContractID,\n641|\t\t\t\t\tContractVersions: versions, NormativeSection: value.NormativeSection,\n642|\t\t\t\t\tFixtureFamilies: value.FixtureFamilies, Releases: group.Releases,\n643|\t\t\t\t})\n644|\t\t\t}\n645|\t\t}\n646|\t}\n647|\treturn result\n648|}\n649|\n650|func writeSource(output *bytes.Buffer, value metadata) {\n651|\toutput.WriteString(\"\\tSource: Source{\\n\")\n652|\tfmt.Fprintf(output, \"\\t\\tRepository: %q,\\n\", value.Source.Repository)\n653|\tfmt.Fprintf(output, \"\\t\\tRelease: Release(%q),\\n\", value.Source.Release)\n654|\tfmt.Fprintf(output, \"\\t\\tCommit: %q,\\n\", value.Source.Commit)\n655|\tfmt.Fprintf(output, \"\\t\\tDocumentPath: %q,\\n\", value.Source.DocumentPath)\n656|\tfmt.Fprintf(output, \"\\t\\tDocumentSHA256: %q,\\n\", value.Source.DocumentSHA256)\n657|\tfmt.Fprintf(output, \"\\t\\tNormativeScope: %s,\\n\", stringSliceLiteral(value.NormativeScope))\n658|\toutput.WriteString(\"\\t},\\n\")\n659|}\n660|\n661|func writeContracts(output *bytes.Buffer, manifest specpin.Manifest) {\n662|\toutput.WriteString(\"\\tContracts: map[Release][]Contract{\\n\")\n663|\tfor _, release := range []string{specpin.ReleaseV043, specpin.ReleaseV050} {\n664|\t\tcontracts, err := manifest.ContractsForRelease(release)\n665|\t\tif err != nil {\n666|\t\t\tpanic(err)\n667|\t\t}\n668|\t\tfmt.Fprintf(output, \"\\t\\tRelease(%q): {\\n\", release)\n669|\t\tfor _, contract := range contracts {\n670|\t\t\tfmt.Fprintf(output, \"\\t\\t\\t{Name: %q, ID: %q, Versions: %s},\\n\", contract.Name, contract.ID, stringSliceLiteral(contract.Versions))\n671|\t\t}\n672|\t\toutput.WriteString(\"\\t\\t},\\n\")\n673|\t}\n674|\toutput.WriteString(\"\\t},\\n\")\n675|}\n676|\n677|func writeSelfIdentities(output *bytes.Buffer, values []selfIdentityContract) {\n678|\toutput.WriteString(\"\\tSelfIdentities: []scopedSelfIdentityContract{\\n\")\n679|\tfor _, value := range values {\n680|\t\tfmt.Fprintf(output, \"\\t\\t{Definition: SelfIdentityContract{ContractID: %q, ContractVersions: %s, SelfField: %q, DiscriminatorName: %q, DiscriminatorValue: %q, NormativeSection: %q}, Releases: %s},\\n\",\n681|\t\t\tvalue.ContractID, stringSliceLiteral(value.ContractVersions), value.SelfField,\n682|\t\t\tvalue.DiscriminatorName, value.DiscriminatorValue, value.NormativeSection,\n683|\t\t\treleaseSliceLiteral(value.Releases))\n684|\t}\n685|\toutput.WriteString(\"\\t},\\n\")\n686|}\n687|\n688|func writeOperations(output *bytes.Buffer, values []expandedOperation) {\n689|\toutput.WriteString(\"\\tOperations: []scopedOperation{\\n\")\n690|\tfor _, value := range values {\n691|\t\tfmt.Fprintf(output, \"\\t\\t{Definition: Operation{Family: %q, Name: %q, ContractID: %q, ContractVersions: %s, Effect: %s, IdempotencyKey: %q, RecoveryEvidence: %s, NormativeSection: %q, FixtureFamilies: %s}, Releases: %s},\\n\",\n692|\t\t\tvalue.Family, value.Name, value.ContractID, stringSliceLiteral(value.ContractVersions), value.Effect,\n693|\t\t\tvalue.IdempotencyKey, stringSliceLiteral(value.RecoveryEvidence), value.NormativeSection,\n694|\t\t\tstringSliceLiteral(value.FixtureFamilies), releaseSliceLiteral(value.Releases))\n695|\t}\n696|\toutput.WriteString(\"\\t},\\n\")\n697|}\n698|\n699|func writeCapabilities(output *bytes.Buffer, values []expandedCapability) {\n700|\toutput.WriteString(\"\\tCapabilities: []scopedCapability{\\n\")\n701|\tfor _, value := range values {\n702|\t\tfmt.Fprintf(output, \"\\t\\t{Definition: Capability{Family: %q, Name: %q, ContractID: %q, ContractVersions: %s, NormativeSection: %q, FixtureFamilies: %s}, Releases: %s},\\n\",\n703|\t\t\tvalue.Family, value.Name, value.ContractID, stringSliceLiteral(value.ContractVersions), value.NormativeSection,\n704|\t\t\tstringSliceLiteral(value.FixtureFamilies), releaseSliceLiteral(value.Releases))\n705|\t}\n706|\toutput.WriteString(\"\\t},\\n\")\n707|}\n708|\n709|func writeEvents(output *bytes.Buffer, values []expandedEvent) {\n710|\toutput.WriteString(\"\\tEvents: []scopedEvent{\\n\")\n711|\tfor _, value := range values {\n712|\t\tfmt.Fprintf(output, \"\\t\\t{Definition: Event{Family: %q, Name: %q, ContractID: %q, ContractVersions: %s, NormativeSection: %q, FixtureFamilies: %s}, Releases: %s},\\n\",\n713|\t\t\tvalue.Family, value.Name, value.ContractID, stringSliceLiteral(value.ContractVersions), value.NormativeSection,\n714|\t\t\tstringSliceLiteral(value.FixtureFamilies), releaseSliceLiteral(value.Releases))\n715|\t}\n716|\toutput.WriteString(\"\\t},\\n\")\n717|}\n718|\n719|func writeErrors(output *bytes.Buffer, values []expandedError) {\n720|\toutput.WriteString(\"\\tErrors: []scopedError{\\n\")\n721|\tfor _, value := range values {\n722|\t\tfmt.Fprintf(output, \"\\t\\t{Definition: ErrorCode{Code: %q, ExitCode: %d, ContractID: %q, ContractVersions: %s, NormativeSection: %q, FixtureFamilies: %s}, Releases: %s},\\n\",\n723|\t\t\tvalue.Code, value.ExitCode, value.ContractID, stringSliceLiteral(value.ContractVersions), value.NormativeSection,\n724|\t\t\tstringSliceLiteral(value.FixtureFamilies), releaseSliceLiteral(value.Releases))\n725|\t}\n726|\toutput.WriteString(\"\\t},\\n\")\n727|}\n728|\n729|func stringSliceLiteral(values []string) string {\n730|\tif len(values) == 0 {\n731|\t\treturn \"nil\"\n732|\t}\n733|\tquoted := make([]string, len(values))\n734|\tfor index, value := range values {\n735|\t\tquoted[index] = strconv.Quote(value)\n736|\t}\n737|\treturn \"[]string{\" + strings.Join(quoted, \", \") + \"}\"\n738|}\n739|\n740|func releaseSliceLiteral(values []string) string {\n741|\tquoted := make([]string, len(values))\n742|\tfor index, value := range values {\n743|\t\tquoted[index] = \"Release(\" + strconv.Quote(value) + \")\"\n744|\t}\n745|\treturn \"[]Release{\" + strings.Join(quoted, \", \") + \"}\"\n746|}\n747|\n748|func equalStrings(left, right []string) bool {\n749|\tif len(left) != len(right) {\n750|\t\treturn false\n751|\t}\n752|\tfor index := range left {\n753|\t\tif left[index] != right[index] {\n754|\t\t\treturn false\n755|\t\t}\n756|\t}\n757|\treturn true\n758|}\n759|\n760|func hasEmpty(values []string) bool {\n761|\tfor _, value := range values {\n762|\t\tif value == \"\" {\n763|\t\t\treturn true\n764|\t\t}\n765|\t}\n766|\treturn false\n767|}\n768|\n769|func invalid(format string, arguments ...any) error {\n770|\treturn fmt.Errorf(\"%w: %s\", ErrInvalidMetadata, fmt.Sprintf(format, arguments...))\n771|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7e9","stream":{"kind":"session","id":"01a08707-ceef-7493-9b49-24effd76d285"},"sequence":591,"recorded_at":1780531400001177,"record_type":"event","durability":"durable","causation_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","run_stream":{"kind":"run","id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3"},"call_id":"call_01a0870a01dd7590a993778f767ae63e","text":"Read text file `internal/specdoc/specdoc.go`.\n1|// Package specdoc exposes the exact pinned upstream AX specification document\n2|// to repository fidelity gates.\n3|//\n4|// The upstream specification remains normative. The embedded copy is a\n5|// verification input only: it is accepted solely when its SHA-256 equals the\n6|// document digest already pinned in internal/specpin, so a substituted,\n7|// truncated, edited, or partially read document is refused instead of being\n8|// silently compared against. Nothing here advertises runtime capabilities or\n9|// mutates durable state.\n10|//\n11|// The package exists so that enumeration artifacts and ownership claims can be\n12|// compared against the specification text itself rather than against the\n13|// implementation those artifacts are supposed to constrain. Only repository\n14|// gates import it: the test binaries that check enumeration artifacts, and\n15|// internal/traceability, which measures the normative clause inventory of a\n16|// bound section from this document. The embedded document never reaches the ax\n17|// command, and TestEmbeddedDocumentNeverReachesAProductBinary enforces that\n18|// from the module import graph rather than leaving it as a comment: only\n19|// tracecheck, the ownership gate, may reach this package from a main package.\n20|package specdoc\n21|\n22|import (\n23|\t\"bytes\"\n24|\t\"crypto/sha256\"\n25|\t_ \"embed\"\n26|\t\"encoding/hex\"\n27|\t\"errors\"\n28|\t\"fmt\"\n29|\t\"regexp\"\n30|\t\"strings\"\n31|\n32|\t\"github.com/relux-works/agent-session-manager/internal/specpin\"\n33|)\n34|\n35|//go:embed SPEC.md\n36|var embedded []byte\n37|\n38|//go:embed SPEC.v0.6.0.md\n39|var embeddedV060 []byte\n40|\n41|// ErrDocumentMismatch reports an absent, empty, or non-pinned document. A\n42|// failed or partial read is reported as a mismatch, never as an absence that\n43|// some caller could treat as satisfied.\n44|var ErrDocumentMismatch = errors.New(\"pinned specification document mismatch\")\n45|\n46|// Document is a verified pinned specification together with the single\n47|// whitespace-normalized projection used for excerpt comparison, an index from\n48|// normalized offsets back to 1-based SPEC.md line numbers, and an index of the\n49|// document's Markdown tables.\n50|//\n51|// The projection collapses each run of ASCII whitespace to one space, except at\n52|// a hard boundary, where it collapses to BlockSeparator instead. A normalized\n53|// excerpt can never contain BlockSeparator, so a quote cannot be satisfied by\n54|// stitching text across such a boundary. Two kinds of boundary are hard:\n55|//\n56|//   - a blank line, which separates a paragraph from the paragraph after it and\n57|//     a heading from its body;\n58|//   - the newline between two adjacent Markdown table rows, because a table row\n59|//     is a complete line by construction, so no honest excerpt spans two of\n60|//     them, while a stitched one silently imports the next row's constraint.\n61|//\n62|// Hard line wrapping and table indentation inside one block are still forgiven,\n63|// as is the newline between two adjacent list items or between two adjacent\n64|// lines of one paragraph.\n65|type Document struct {\n66|\traw            []byte\n67|\tlines          []string\n68|\tnormalized     string\n69|\tlineOf         []int\n70|\tsectionOfLine  []string\n71|\ttableRowOfLine []TableRow\n72|}\n73|\n74|// BlockSeparator marks a hard boundary in the normalized projection. It is a\n75|// newline, which Normalize never emits, so it is unmatchable by any excerpt.\n76|const BlockSeparator = '\\n'\n77|\n78|// TableRow describes one body row of a Markdown table in the pinned document:\n79|// the first-column header of the table it belongs to, and the text of its own\n80|// first cell. Together they say what the row declares — \"Field\"/\"reason\" is the\n81|// declaration of a member, \"Type\"/\"GitIndex\" the declaration of a type, and\n82|// \"Tag\"/\"kind = git\" the declaration of a variant.\n83|type TableRow struct {\n84|\t// Header is the trimmed text of the table's first column header.\n85|\tHeader string\n86|\t// FirstCell is the trimmed text of this row's first cell.\n87|\tFirstCell string\n88|\t// Identifier is FirstCell with a single enclosing <code> element removed,\n89|\t// which is how the pinned document writes every declaration.\n90|\tIdentifier string\n91|\t// Line is the 1-based SPEC.md line of the row.\n92|\tLine int\n93|}\n94|\n95|// Load returns the embedded pinned document after verifying its digest.\n96|func Load() (*Document, error) {\n97|\treturn Parse(embedded)\n98|}\n99|\n100|// LoadV060 returns the embedded adopted v0.6.0 document after verifying its\n101|// digest against specpin.DocumentSHA256V060. Load still serves the v0.5.0\n102|// document the traceability gate compares against, until the owning\n103|// follow-up task regenerates that gate.\n104|func LoadV060() (*Document, error) {\n105|\treturn ParseV060(embeddedV060)\n106|}\n107|\n108|// Bytes returns an isolated copy of the exact embedded document bytes.\n109|func Bytes() []byte {\n110|\treturn bytes.Clone(embedded)\n111|}\n112|\n113|// BytesV060 returns an isolated copy of the exact embedded v0.6.0 bytes.\n114|func BytesV060() []byte {\n115|\treturn bytes.Clone(embeddedV060)\n116|}\n117|\n118|// Parse accepts only a byte-exact copy of the pinned SPEC.md identified by\n119|// specpin.DocumentSHA256.\n120|func Parse(candidate []byte) (*Document, error) {\n121|\tif len(candidate) == 0 {\n122|\t\treturn nil, fmt.Errorf(\"%w: document is empty\", ErrDocumentMismatch)\n123|\t}\n124|\tdigest := sha256.Sum256(candidate)\n125|\tif got := hex.EncodeToString(digest[:]); got != specpin.DocumentSHA256 {\n126|\t\treturn nil, fmt.Errorf(\"%w: SHA-256 is %s, want %s\", ErrDocumentMismatch, got, specpin.DocumentSHA256)\n127|\t}\n128|\n129|\treturn buildDocument(candidate), nil\n130|}\n131|\n132|// ParseV060 accepts only a byte-exact copy of the adopted v0.6.0 SPEC.md\n133|// identified by specpin.DocumentSHA256V060. The v0.5.0 document, a partial\n134|// read, and any edited copy are refused, so a gate that has not been\n135|// deliberately re-pointed cannot silently compare against the new text.\n136|func ParseV060(candidate []byte) (*Document, error) {\n137|\tif len(candidate) == 0 {\n138|\t\treturn nil, fmt.Errorf(\"%w: document is empty\", ErrDocumentMismatch)\n139|\t}\n140|\tdigest := sha256.Sum256(candidate)\n141|\tif got := hex.EncodeToString(digest[:]); got != specpin.DocumentSHA256V060 {\n142|\t\treturn nil, fmt.Errorf(\"%w: SHA-256 is %s, want %s\", ErrDocumentMismatch, got, specpin.DocumentSHA256V060)\n143|\t}\n144|\n145|\treturn buildDocument(candidate), nil\n146|}\n147|\n148|func buildDocument(candidate []byte) *Document {\n149|\tdocument := &Document{raw: bytes.Clone(candidate)}\n150|\tdocument.lines = strings.Split(strings.ReplaceAll(string(document.raw), \"\\r\\n\", \"\\n\"), \"\\n\")\n151|\n152|\thardBoundary := indexHardBoundaries(document.lines)\n153|\n154|\tvar normalized strings.Builder\n155|\tnormalized.Grow(len(candidate))\n156|\tlineOf := make([]int, 0, len(candidate))\n157|\tline := 1\n158|\trunStartLine := 1\n159|\tpendingSeparator := false\n160|\twroteAny := false\n161|\tfor index := 0; index < len(document.raw); index++ {\n162|\t\tcharacter := document.raw[index]\n163|\t\tif isNormalizedWhitespace(character) {\n164|\t\t\tif wroteAny && !pendingSeparator {\n165|\t\t\t\trunStartLine = line\n166|\t\t\t\tpendingSeparator = true\n167|\t\t\t}\n168|\t\t\tif character == '\\n' {\n169|\t\t\t\tline++\n170|\t\t\t}\n171|\t\t\tcontinue\n172|\t\t}\n173|\t\tif pendingSeparator {\n174|\t\t\tseparator := byte(' ')\n175|\t\t\tif crossesHardBoundary(hardBoundary, runStartLine, line) {\n176|\t\t\t\tseparator = BlockSeparator\n177|\t\t\t}\n178|\t\t\tnormalized.WriteByte(separator)\n179|\t\t\tlineOf = append(lineOf, line)\n180|\t\t\tpendingSeparator = false\n181|\t\t}\n182|\t\tnormalized.WriteByte(character)\n183|\t\tlineOf = append(lineOf, line)\n184|\t\twroteAny = true\n185|\t}\n186|\tdocument.normalized = normalized.String()\n187|\tdocument.lineOf = lineOf\n188|\tdocument.sectionOfLine = indexSections(document.lines)\n189|\tdocument.tableRowOfLine = indexTableRows(document.lines)\n190|\treturn document\n191|}\n192|\n193|// indexHardBoundaries marks, for each 1-based line n, whether the newline\n194|// between line n and line n+1 is a hard boundary that no excerpt may cross.\n195|func indexHardBoundaries(lines []string) []bool {\n196|\thard := make([]bool, len(lines)+1)\n197|\tfor number := 1; number < len(lines); number++ {\n198|\t\tabove, below := lines[number-1], lines[number]\n199|\t\tif strings.TrimSpace(above) == \"\" || strings.TrimSpace(below) == \"\" {\n200|\t\t\thard[number] = true\n201|\t\t\tcontinue\n202|\t\t}\n203|\t\tif isTableLine(above) && isTableLine(below) {\n204|\t\t\thard[number] = true\n205|\t\t}\n206|\t}\n207|\treturn hard\n208|}\n209|\n210|// crossesHardBoundary reports whether a whitespace run that started on line\n211|// from and ended on line to crossed any hard boundary.\n212|func crossesHardBoundary(hard []bool, from, to int) bool {\n213|\tfor number := from; number < to && number < len(hard); number++ {\n214|\t\tif hard[number] {\n215|\t\t\treturn true\n216|\t\t}\n217|\t}\n218|\treturn false\n219|}\n220|\n221|func isTableLine(line string) bool {\n222|\treturn strings.HasPrefix(strings.TrimSpace(line), \"|\")\n223|}\n224|\n225|// tableSeparator matches the delimiter row that turns the line above it into a\n226|// Markdown table header.\n227|var tableSeparator = regexp.MustCompile(`^\\|[\\s:|-]*-{3,}[\\s:|-]*\\|?\\s*$`)\n228|\n229|// indexTableRows maps every 1-based line that is a body row of a Markdown table\n230|// to what that row declares. Header and delimiter lines map to nothing: they\n231|// declare no member, type, or variant of their own.\n232|func indexTableRows(lines []string) []TableRow {\n233|\trows := make([]TableRow, len(lines)+1)\n234|\tfor index := 0; index+1 < len(lines); index++ {\n235|\t\tif !isTableLine(lines[index]) || !tableSeparator.MatchString(strings.TrimSpace(lines[index+1])) {\n236|\t\t\tcontinue\n237|\t\t}\n238|\t\theader := firstTableCell(lines[index])\n239|\t\tfor body := index + 2; body < len(lines) && isTableLine(lines[body]); body++ {\n240|\t\t\tcell := firstTableCell(lines[body])\n241|\t\t\trows[body+1] = TableRow{\n242|\t\t\t\tHeader:     header,\n243|\t\t\t\tFirstCell:  cell,\n244|\t\t\t\tIdentifier: stripCodeElement(cell),\n245|\t\t\t\tLine:       body + 1,\n246|\t\t\t}\n247|\t\t}\n248|\t}\n249|\treturn rows\n250|}\n251|\n252|// firstTableCell returns the trimmed text of a table line's first cell.\n253|func firstTableCell(line string) string {\n254|\ttrimmed := strings.TrimSpace(line)\n255|\ttrimmed = strings.TrimPrefix(trimmed, \"|\")\n256|\tif index := strings.IndexByte(trimmed, '|'); index >= 0 {\n257|\t\ttrimmed = trimmed[:index]\n258|\t}\n259|\treturn strings.TrimSpace(trimmed)\n260|}\n261|\n262|var codeElement = regexp.MustCompile(`^<code>(.*)</code>$`)\n263|\n264|// stripCodeElement removes a single enclosing <code> element, which is how the\n265|// pinned document writes every declaration cell. Text that is not exactly one\n266|// such element is returned unchanged rather than partially rewritten.\n267|func stripCodeElement(cell string) string {\n268|\tif match := codeElement.FindStringSubmatch(cell); match != nil {\n269|\t\treturn match[1]\n270|\t}\n271|\treturn cell\n272|}\n273|\n274|// TableRowAt returns what the Markdown table body row at a 1-based SPEC.md line\n275|// declares. It reports false for every line that is not such a row, including\n276|// table headers and delimiters.\n277|func (document *Document) TableRowAt(number int) (TableRow, bool) {\n278|\tif number < 1 || number >= len(document.tableRowOfLine) {\n279|\t\treturn TableRow{}, false\n280|\t}\n281|\trow := document.tableRowOfLine[number]\n282|\tif row.Line == 0 {\n283|\t\treturn TableRow{}, false\n284|\t}\n285|\treturn row, true\n286|}\n287|\n288|// headingSectionID matches the numbered or appendix identifier of an ATX\n289|// heading: \"## 10.4 Transfer Manifest\" -> \"10.4\", \"#### 13.14.5 Events\" ->\n290|// \"13.14.5\", \"## Appendix A. Normative traceability\" -> \"A\",\n291|// \"### A.3 Task acceptance traceability\" -> \"A.3\".\n292|var (\n293|\tatxHeading      = regexp.MustCompile(`^(#{1,6})\\s+(.*)$`)\n294|\tnumberedSection = regexp.MustCompile(`^([0-9]+(?:\\.[0-9A-Z]+)*|[A-Z](?:\\.[0-9]+)+)\\.?\\s`)\n295|\tappendixSection = regexp.MustCompile(`^Appendix\\s+([A-Z])\\.`)\n296|)\n297|\n298|// indexSections maps every 1-based line to the identifier of the nearest\n299|// enclosing numbered clause. An unnumbered subheading — \"#### Managed Replica\n300|// Marker document\" — does not open a clause of its own; its lines stay\n301|// attributed to the numbered section above it, which is the clause a citation\n302|// belongs to.\n303|func indexSections(lines []string) []string {\n304|\tsections := make([]string, len(lines)+1)\n305|\tcurrent := \"\"\n306|\tfor index, line := range lines {\n307|\t\tif match := atxHeading.FindStringSubmatch(line); match != nil {\n308|\t\t\tif id, ok := headingSection(match[2]); ok {\n309|\t\t\t\tcurrent = id\n310|\t\t\t}\n311|\t\t}\n312|\t\tsections[index+1] = current\n313|\t}\n314|\treturn sections\n315|}\n316|\n317|func headingSection(text string) (string, bool) {\n318|\tif match := appendixSection.FindStringSubmatch(text); match != nil {\n319|\t\treturn match[1], true\n320|\t}\n321|\tif match := numberedSection.FindStringSubmatch(text); match != nil {\n322|\t\treturn match[1], true\n323|\t}\n324|\treturn \"\", false\n325|}\n326|\n327|// SectionID returns the identifier of the numbered clause containing a 1-based\n328|// SPEC.md line, so a citation can be held to the clause of the shape it\n329|// documents rather than only to the characters at the line.\n330|func (document *Document) SectionID(number int) (string, bool) {\n331|\tif number < 1 || number >= len(document.sectionOfLine) {\n332|\t\treturn \"\", false\n333|\t}\n334|\tid := document.sectionOfLine[number]\n335|\tif id == \"\" {\n336|\t\treturn \"\", false\n337|\t}\n338|\treturn id, true\n339|}\n340|\n341|// Normalize applies the single documented normalization rule to excerpt text:\n342|// every run of ASCII whitespace collapses to one space and leading/trailing\n343|// whitespace is removed. Nothing else is rewritten. Letter case, punctuation,\n344|// digits, and inline <code> markup are compared exactly, so the rule forgives\n345|// the specification's hard line wrapping and table indentation without letting\n346|// an excerpt match unrelated text.\n347|//\n348|// Normalize never emits BlockSeparator. The document projection does, at every\n349|// hard boundary — a blank line, and the newline between two adjacent table rows\n350|// — so a normalized excerpt cannot span one.\n351|func Normalize(text string) string {\n352|\tvar builder strings.Builder\n353|\tbuilder.Grow(len(text))\n354|\tpendingSeparator := false\n355|\twroteAny := false\n356|\tfor index := 0; index < len(text); index++ {\n357|\t\tcharacter := text[index]\n358|\t\tif isNormalizedWhitespace(character) {\n359|\t\t\tif wroteAny {\n360|\t\t\t\tpendingSeparator = true\n361|\t\t\t}\n362|\t\t\tcontinue\n363|\t\t}\n364|\t\tif pendingSeparator {\n365|\t\t\tbuilder.WriteByte(' ')\n366|\t\t\tpendingSeparator = false\n367|\t\t}\n368|\t\tbuilder.WriteByte(character)\n369|\t\twroteAny = true\n370|\t}\n371|\treturn builder.String()\n372|}\n373|\n374|func isNormalizedWhitespace(character byte) bool {\n375|\tswitch character {\n376|\tcase ' ', '\\t', '\\r', '\\n', '\\v', '\\f':\n377|\t\treturn true\n378|\tdefault:\n379|\t\treturn false\n380|\t}\n381|}\n382|\n383|// LineCount reports the number of lines in the pinned document.\n384|func (document *Document) LineCount() int {\n385|\treturn len(document.lines)\n386|}\n387|\n388|// Line returns the raw text of a 1-based SPEC.md line.\n389|func (document *Document) Line(number int) (string, bool) {\n390|\tif number < 1 || number > len(document.lines) {\n391|\t\treturn \"\", false\n392|\t}\n393|\treturn document.lines[number-1], true\n394|}\n395|\n396|// QuoteLines returns every 1-based SPEC.md line on which the normalized form\n397|// of text begins. An empty excerpt matches nothing: an empty quote would\n398|// otherwise be satisfied by any document. A match never spans a blank line,\n399|// because the projection separates blocks with the unmatchable BlockSeparator.\n400|func (document *Document) QuoteLines(text string) []int {\n401|\tneedle := Normalize(text)\n402|\tif needle == \"\" {\n403|\t\treturn nil\n404|\t}\n405|\tvar lines []int\n406|\tfor offset := 0; ; {\n407|\t\tindex := strings.Index(document.normalized[offset:], needle)\n408|\t\tif index < 0 {\n409|\t\t\treturn lines\n410|\t\t}\n411|\t\tstart := offset + index\n412|\t\tlines = append(lines, document.lineOf[start])\n413|\t\toffset = start + 1\n414|\t}\n415|}\n416|\n417|// Contains reports whether the normalized form of text occurs in the pinned\n418|// document at all.\n419|func (document *Document) Contains(text string) bool {\n420|\treturn len(document.QuoteLines(text)) != 0\n421|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
