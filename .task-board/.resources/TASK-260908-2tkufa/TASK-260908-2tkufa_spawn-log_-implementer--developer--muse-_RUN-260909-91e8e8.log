ror) {\n614|\tif assigned == nil {\n615|\t\treturn nil, nil\n616|\t}\n617|\tpinnedSet := make(map[string]struct{}, len(pinned))\n618|\tfor _, section := range pinned {\n619|\t\tpinnedSet[section] = struct{}{}\n620|\t}\n621|\tbindings := make([]assignedSectionBinding, 0, len(assigned))\n622|\tseen := make(map[string]struct{}, len(assigned))\n623|\tfor _, raw := range assigned {\n624|\t\tscope := strings.TrimSpace(strings.TrimPrefix(strings.TrimSpace(raw), \"§\"))\n625|\t\tif scope == \"\" {\n626|\t\t\treturn nil, fail(\"invalid assigned section %q\", raw)\n627|\t\t}\n628|\t\tcanonical := strings.ToLower(strings.Join(strings.Fields(scope), \"-\"))\n629|\t\troot := canonical\n630|\t\tidentifiers := []string{canonical}\n631|\t\tif strings.HasPrefix(canonical, \"appendix-\") {\n632|\t\t\tif !specpin.IsSectionV050(canonical) {\n633|\t\t\t\treturn nil, fail(\"assigned section %q is not a real v0.5.0 section identifier\", raw)\n634|\t\t\t}\n635|\t\t} else {\n636|\t\t\tmatches := assignedSectionPattern.FindStringSubmatch(scope)\n637|\t\t\tif matches == nil {\n638|\t\t\t\treturn nil, fail(\"invalid assigned section %q\", raw)\n639|\t\t\t}\n640|\t\t\tstart := canonicalNumericSection(matches[1])\n641|\t\t\tend := start\n642|\t\t\tif matches[2] != \"\" {\n643|\t\t\t\tend = canonicalNumericSection(matches[2])\n644|\t\t\t}\n645|\t\t\troot = strings.Split(start, \".\")[0]\n646|\t\t\tif strings.Split(end, \".\")[0] != root {\n647|\t\t\t\treturn nil, fail(\"invalid assigned section %q\", raw)\n648|\t\t\t}\n649|\t\t\tfor _, identifier := range []string{start, end} {\n650|\t\t\t\tif !specpin.IsSectionV050(identifier) {\n651|\t\t\t\t\treturn nil, fail(\"assigned section %q is not a real v0.5.0 section identifier\", raw)\n652|\t\t\t\t}\n653|\t\t\t}\n654|\t\t\texpanded, expandErr := expandV050SectionRange(start, end)\n655|\t\t\tif expandErr != nil {\n656|\t\t\t\treturn nil, fail(\"invalid assigned section %q: %v\", raw, expandErr)\n657|\t\t\t}\n658|\t\t\tidentifiers = expanded\n659|\t\t}\