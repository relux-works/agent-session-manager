{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc85","stream":{"kind":"session","id":"01a08707-ceef-7493-9b49-24effd76d285"},"sequence":1181,"recorded_at":1780531400002357,"record_type":"event","durability":"durable","causation_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","run_stream":{"kind":"run","id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3"},"task_stream":{"kind":"task","id":"a076c5c7-2668-46f0-836a-07b0eca0d645"},"task_id":"a076c5c7-2668-46f0-836a-07b0eca0d645","event":{"kind":"output","task_id":"a076c5c7-2668-46f0-836a-07b0eca0d645","chunk":"{\n  \"chunk_id\": \"exec-56-1\",\n  \"command\": \"python3 << 'EOF'\\nimport json, collections\\nm = json.load(open('internal/catalog/catalog.v0.5.0.json'))\\n\\n# 1. source -> adopted v0.6.0 authority (values from the verified v0.6.0 lock)\\nm['source'] = {\\n    \\\"repository\\\": \\\"relux-works/agent-session-manager-spec\\\",\\n    \\\"release\\\": \\\"v0.6.0\\\",\\n    \\\"commit\\\": \\\"0cbdf100dbf84df50c64f792b1f940e3a67859a6\\\",\\n    \\\"document_path\\\": \\\"SPEC.md\\\",\\n    \\\"document_sha256\\\": \\\"74504539fb43c28ae3450622bc1002e643f116cd3e14df4567a882231e90896b\\\"\\n}\\n\\n# 2. every releases array gains v0.6.0 (ordered tail; v0.6.0 supersedes per-contract)\\ndef add_v060(obj):\\n    if isinstance(obj, dict):\\n        for k, v in obj.items():\\n            if k == 'releases' and isinstance(v, list):\\n                assert v and v[-1] in ('v0.4.3', 'v0.5.0'), v\\n                if 'v0.6.0' not in v:\\n                    v.append('v0.6.0')\\n            else:\\n                add_v060(v)\\n    elif isinstance(obj, list):\\n        for i in obj:\\n            add_v060(i)\\nadd_v060(m)\\n\\n# 3. mesh_rpc operation family: RPC 5 carries the exact RPC-4 operations (SPEC 11.10.1)\\nfor f in m['operation_families']:\\n    if f['family'] == 'mesh_rpc':\\n        assert f['contract_id'] == 'urn:ax:protocol:rpc', f\\n        assert f['contract_versions'] == ['2.0.0', '3.0.0', '4.0.0'], f\\n        f['contract_versions'].append('5.0.0')\\n\\n# 4. Structured Error 1.4.0: exactly the five selector-capable CLI codes (SPEC 14.7.3)\\nerr = m['error_catalog']\\nassert err['contract_id'] == 'urn:ax:schema:error'\\nassert err['contract_versions'] == ['1.0.0', '1.1.0', '1.2.0', '1.3.0']\\nerr['contract_versions'].append('1.4.0')\\nerr['groups'].append({\\n    \\\"introduced_version\\\": \\\"1.4.0\\\",\\n    \\\"releases\\\": [\\\"v0.6.0\\\"],\\n    \\\"mappings\\\": [\\n        {\\\"exit_code\\\": 3, \\\"codes\\\": [\\\"selector_observation_unavailable\\\"]},\\n        {\\\"exit_code\\\": 4, \\\"codes\\\": [\\\"selector_source_not_found\\\"]},\\n        {\\\"exit_code\\\": 8, \\\"codes\\\": [\\\"selector_source_read_failed\\\"]},\\n        {\\\"exit_code\\\": 12, \\\"codes\\\": [\\\"selector_bootstrap_incomplete\\\"]},\\n        {\\\"exit_code\\\": 16, \\\"codes\\\": [\\\"selector_plan_stale\\\"]}\\n    ]\\n})\\n\\njson.dump(m, open('internal/catalog/catalog.v0.6.0.json', 'w'), indent=2, ensure_ascii=False)\\nopen('internal/catalog/catalog.v0.6.0.json', 'a').write('\\\\n')\\nprint('wrote catalog.v0.6.0.json')\\nEOF\\nls -la internal/catalog/\",\n  \"description\": \"Author v0.6.0 catalog metadata JSON\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"wrote catalog.v0.6.0.json\\ntotal 576\\ndrwxr-xr-x@  8 iv  staff     256 Sep  9 20:45 .\\ndrwxr-xr-x@ 23 iv  staff     736 Sep  9 19:59 ..\\n-rw-r--r--@  1 iv  staff   10318 Sep  9 19:59 catalog.go\\n-rw-r--r--@  1 iv  staff   30445 Sep  9 19:59 catalog.v0.5.0.json\\n-rw-r--r--@  1 iv  staff   44457 Sep  9 20:45 catalog.v0.6.0.json\\n-rw-r--r--@  1 iv  staff  164120 Sep  9 19:59 catalog_gen.go\\n-rw-r--r--@  1 iv  staff   35312 Sep  9 19:59 catalog_test.go\\ndrwxr-xr-x@  3 iv  staff      96 Sep  9 19:59 cmd\\n\",\n  \"original_output_bytes\": 495,\n  \"original_output_tokens\": 124,\n  \"truncated\": false\n}"}}}
