528|\tselectedSectionBindings map[string]struct{},\n529|) (map[ownershipKind]map[string]struct{}, error) {\n530|\towned := map[ownershipKind]map[string]struct{}{\n531|\t\townershipContract:         make(map[string]struct{}),\n532|\t\townershipNormativeSection: make(map[string]struct{}),\n533|\t\townershipSectionBinding:   make(map[string]struct{}),\n534|\t\townershipFixture:          make(map[string]struct{}),\n535|\t}\n536|\tif len(groups) == 0 {\n537|\t\treturn nil, fail(\"implementation ownership registry is empty\")\n538|\t}\n539|\tfor index, group := range groups {\n540|\t\tif _, ok := allowed[group.Kind]; !ok {\n541|\t\t\treturn nil, fail(\"ownership group %d has unknown kind %q\", index, group.Kind)\n542|\t\t}\n543|\t\tif group.Kind == ownershipSectionBinding && selectedSectionBindings != nil {\n544|\t\t\tselected := false\n545|\t\t\tfor _, key := range group.Keys {\n546|\t\t\t\tif _, ok := selectedSectionBindings[key]; ok {\n547|\t\t\t\t\tselected = true\n548|\t\t\t\t\tbreak\n549|\t\t\t\t}\n550|\t\t\t}\n551|\t\t\tif !selected {\n552|\t\t\t\tcontinue\n553|\t\t\t}\n554|\t\t}\n555|\t\tif group.Kind == ownershipSectionBinding && len(group.Keys) != 1 {\n556|\t\t\treturn nil, fail(\"section binding ownership group %d has %d keys, want exactly one\", index, len(group.Keys))\n557|\t\t}\n558|\t\tif len(group.Keys) == 0 {\n559|\t\t\treturn nil, fail(\"ownership group %d (%s) has no registered keys\", index, group.Kind)\n560|\t\t}\n561|\t\tif err := checker.verify(group.Production, false); err != nil {\n562|\t\t\tif group.Kind == ownershipSectionBinding {\n563|\t\t\t\treturn nil, fail(\"section binding %q production owner: %v\", group.Keys[0], err)\n564|\t\t\t}\n565|\t\t\treturn nil, fail(\"ownership group %d (%s) production owner: %v\", index, group.Kind, err)\n566|\t\t}\n567|\t\tif len(group.AcceptanceCases) == 0 {\n568|\t\t\tif group.Kind == ownershipSectionBinding {\n569|\t\t\t\treturn nil, fail(\"section binding %q has no scope-specific acceptance owner\", group.K