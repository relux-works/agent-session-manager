{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c78f","stream":{"kind":"session","id":"01a08707-ceef-7493-9b49-24effd76d285"},"sequence":546,"recorded_at":1780531400001087,"record_type":"event","durability":"durable","causation_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3","run_stream":{"kind":"run","id":"89c3b30b-a554-4b21-8bbd-183ab5ebf7c3"},"call_id":"call_01a087096a7c758091ff391d4bf4eb89","text":"Read text file `internal/traceability/traceability.go`.\n(828 line(s) above)\n829|\t\tresult[\"catalog:\"+item.NormativeSection] = struct{}{}\n830|\t}\n831|\treturn result\n832|}\n833|\n834|func expectedFixtures(manifest specpin.Manifest, value catalog.Catalog) map[string]struct{} {\n835|\tresult := make(map[string]struct{})\n836|\tfor _, fixture := range manifest.Fixtures {\n837|\t\tresult[\"pin:\"+fixture.ID] = struct{}{}\n838|\t}\n839|\tadd := func(fixtures []string) {\n840|\t\tfor _, fixture := range fixtures {\n841|\t\t\tresult[\"catalog:\"+fixture] = struct{}{}\n842|\t\t}\n843|\t}\n844|\tfor _, operation := range value.Operations {\n845|\t\tadd(operation.FixtureFamilies)\n846|\t}\n847|\tfor _, capability := range value.Capabilities {\n848|\t\tadd(capability.FixtureFamilies)\n849|\t}\n850|\tfor _, event := range value.Events {\n851|\t\tadd(event.FixtureFamilies)\n852|\t}\n853|\tfor _, item := range value.Errors {\n854|\t\tadd(item.FixtureFamilies)\n855|\t}\n856|\treturn result\n857|}\n858|\n859|type sourceChecker struct {\n860|\trepository fs.FS\n861|\tfiles      map[string]*ast.File\n862|}\n863|\n864|func newSourceChecker(repository fs.FS) *sourceChecker {\n865|\treturn &sourceChecker{repository: repository, files: make(map[string]*ast.File)}\n866|}\n867|\n868|func (checker *sourceChecker) verify(reference codeReference, test bool) error {\n869|\tif reference.Path == \"\" || reference.Declaration == \"\" {\n870|\t\treturn errors.New(\"code reference has an empty path or declaration\")\n871|\t}\n872|\tclean := path.Clean(reference.Path)\n873|\tif clean != reference.Path || clean == \".\" || path.IsAbs(clean) || strings.HasPrefix(clean, \"../\") {\n874|\t\treturn fmt.Errorf(\"unsafe code reference path %q\", reference.Path)\n875|\t}\n876|\tif path.Ext(clean) != \".go\" {\n877|\t\treturn fmt.Errorf(\"code reference %q is not a Go source file\", clean)\n878|\t}\n879|\tif test {\n880|\t\tif !strings.HasSuffix(clean, \"_test.go\") || !isExecutableTestName(reference.Declaration) {\n881|\t\t\treturn fmt.Errorf(\"test owner %s:%s is not an executable Go test reference\", clean, reference.Declaration)\n882|\t\t}\n883|\t} else if strings.HasSuffix(clean, \"_test.go\") {\n884|\t\treturn fmt.Errorf(\"production owner %s:%s points to test code\", clean, reference.Declaration)\n885|\t}\n886|\n887|\tfile, ok := checker.files[clean]\n888|\tif !ok {\n889|\t\tsource, err := fs.ReadFile(checker.repository, clean)\n890|\t\tif err != nil {\n891|\t\t\treturn fmt.Errorf(\"read %q: %w\", clean, err)\n892|\t\t}\n893|\t\tfile, err = parser.ParseFile(token.NewFileSet(), clean, source, parser.SkipObjectResolution)\n894|\t\tif err != nil {\n895|\t\t\treturn fmt.Errorf(\"parse %q: %w\", clean, err)\n896|\t\t}\n897|\t\tchecker.files[clean] = file\n898|\t}\n899|\tif !hasDeclaration(file, reference.Declaration, test) {\n900|\t\treturn fmt.Errorf(\"declaration %q is absent from %q\", reference.Declaration, clean)\n901|\t}\n902|\treturn nil\n903|}\n904|\n905|func isExecutableTestName(name string) bool {\n906|\tfor _, prefix := range []string{\"Test\", \"Fuzz\"} {\n907|\t\tif !strings.HasPrefix(name, prefix) {\n908|\t\t\tcontinue\n909|\t\t}\n910|\t\tsuffix := name[len(prefix):]\n911|\t\tif suffix == \"\" {\n912|\t\t\treturn true\n913|\t\t}\n914|\t\tfirst, _ := utf8.DecodeRuneInString(suffix)\n915|\t\treturn !unicode.IsLower(first)\n916|\t}\n917|\treturn false\n918|}\n919|\n920|func hasDeclaration(file *ast.File, name string, test bool) bool {\n921|\tfor _, declaration := range file.Decls {\n922|\t\tswitch value := declaration.(type) {\n923|\t\tcase *ast.FuncDecl:\n924|\t\t\tif value.Name.Name == name && (!test || value.Recv == nil) {\n925|\t\t\t\treturn true\n926|\t\t\t}\n927|\t\tcase *ast.GenDecl:\n928|\t\t\tif test {\n929|\t\t\t\tcontinue\n930|\t\t\t}\n931|\t\t\tfor _, specification := range value.Specs {\n932|\t\t\t\tswitch item := specification.(type) {\n933|\t\t\t\tcase *ast.TypeSpec:\n934|\t\t\t\t\tif item.Name.Name == name {\n935|\t\t\t\t\t\treturn true\n936|\t\t\t\t\t}\n937|\t\t\t\tcase *ast.ValueSpec:\n938|\t\t\t\t\tfor _, identifier := range item.Names {\n939|\t\t\t\t\t\tif identifier.Name == name {\n940|\t\t\t\t\t\t\treturn true\n941|\t\t\t\t\t\t}\n942|\t\t\t\t\t}\n943|\t\t\t\t}\n944|\t\t\t}\n945|\t\t}\n946|\t}\n947|\treturn false\n948|}\n949|\n950|func equalStrings(left, right []string) bool {\n951|\tif len(left) != len(right) {\n952|\t\treturn false\n953|\t}\n954|\tfor index := range left {\n955|\t\tif left[index] != right[index] {\n956|\t\t\treturn false\n957|\t\t}\n958|\t}\n959|\treturn true\n960|}\n961|\n962|func fail(format string, arguments ...any) error {\n963|\treturn fmt.Errorf(\"%w: %s\", ErrTraceability, fmt.Sprintf(format, arguments...))\n964|}\n965|\n966|// normativeKeywordPattern matches the RFC 2119 obligation keywords that make a\n967|// specification line a clause an implementation has to discharge. MAY and\n968|// SHOULD are deliberately absent: they create no obligation, so counting them\n969|// would inflate the denominator and make coverage look worse than it is.\n970|var normativeKeywordPattern = regexp.MustCompile(`\\b(MUST NOT|MUST|SHALL NOT|SHALL|REQUIRED)\\b`)\n971|\n972|// clauseIdentifierPattern matches the \"<section>#<index>\" form of a clause id.\n973|var clauseIdentifierPattern = regexp.MustCompile(`^(.+)#([1-9][0-9]*)$`)\n974|\n975|// minimumGapLength is the shortest gap sentence the gate accepts. A gap has to\n976|// say what is missing; \"n/a\", \"todo\" and an empty string are not disclosures.\n977|const minimumGapLength = 32\n978|\n979|// verifyGapDiscloses checks that a gap sentence is a disclosure rather than\n980|// padding. Length and a substring match alone were not enough: \"Section 9.2 is\n981|// not fully covered here yet.\" satisfied both while saying nothing. A real gap\n982|// says what the binding's own implementation does and does not reach, so it has\n983|// to name the production declaration the binding is registered to as well as\n984|// the section, and it has to name the section as a whole identifier so that a\n985|// gap about 6.55 cannot pass for a gap about 6.5.\n986|//\n987|// This is a tightening, not a proof: a sentence that names both and still says\n988|// nothing useful is admitted, and the gate cannot decide otherwise. That limit\n989|// is stated in README.md.\n990|func verifyGapDiscloses(gap, display, declaration string) error {\n991|\tif len(gap) < minimumGapLength {\n992|\t\treturn fmt.Errorf(\"gap %q is shorter than the %d characters a disclosure needs\", gap, minimumGapLength)\n993|\t}\n994|\tif !mentionsSection(gap, display) {\n995|\t\treturn fmt.Errorf(\"gap does not name section %s as a whole identifier\", display)\n996|\t}\n997|\tif declaration != \"\" && !strings.Contains(gap, declaration) {\n998|\t\treturn fmt.Errorf(\"gap does not name the production declaration %q the binding is registered to\", declaration)\n999|\t}\n1000|\treturn nil\n1001|}\n1002|\n1003|// mentionsSection reports whether text names the section display identifier as\n1004|// a whole identifier. A bare substring match accepts \"6.55\" as a mention of\n1005|// \"6.5\" and \"13.15\" as a mention of \"13.1\", which would let a gap about one\n1006|// section stand in for another.\n1007|func mentionsSection(text, display string) bool {\n1008|\tpattern, err := regexp.Compile(`(?:^|[^0-9.])` + regexp.QuoteMeta(display) + `(?:[^0-9]|$)`)\n1009|\tif err != nil {\n1010|\t\treturn false\n1011|\t}\n1012|\treturn pattern.MatchString(text)\n1013|}\n1014|\n1015|// sectionDocumentIdentifier maps an ownership key to the heading identifier the\n1016|// pinned document uses. \"section:10.3\" is heading 10.3; \"section:appendix-d\" is\n1017|// heading D.\n1018|func sectionDocumentIdentifier(key string) (string, error) {\n1019|\tidentifier := strings.TrimPrefix(key, \"section:\")\n1020|\tif identifier == key || identifier == \"\" {\n1021|\t\treturn \"\", fmt.Errorf(\"ownership key %q is not a section binding key\", key)\n1022|\t}\n1023|\tif rest, ok := strings.CutPrefix(identifier, \"appendix-\"); ok {\n1024|\t\tif len(rest) != 1 {\n1025|\t\t\treturn \"\", fmt.Errorf(\"ownership key %q is not a real appendix key\", key)\n1026|\t\t}\n1027|\t\treturn strings.ToUpper(rest), nil\n1028|\t}\n1029|\treturn identifier, nil\n1030|}\n1031|\n1032|// sectionDisplayName is how a gap sentence has to name the section it is about.\n1033|func sectionDisplayName(key string) (string, error) {\n1034|\tidentifier := strings.TrimPrefix(key, \"section:\")\n1035|\tif rest, ok := strings.CutPrefix(identifier, \"appendix-\"); ok {\n1036|\t\tif len(rest) != 1 {\n1037|\t\t\treturn \"\", fmt.Errorf(\"ownership key %q is not a real appendix key\", key)\n1038|\t\t}\n1039|\t\treturn \"Appendix \" + strings.ToUpper(rest), nil\n1040|\t}\n1041|\tif identifier == \"\" || identifier == key {\n1042|\t\treturn \"\", fmt.Errorf(\"ownership key %q is not a section binding key\", key)\n1043|\t}\n1044|\treturn identifier, nil\n1045|}\n1046|\n1047|// sectionClauseInventory measures every normative clause the pinned document\n1048|// carries under a heading, including its subheadings. A parent heading owns its\n1049|// children's obligations, so Appendix D is measured over D.1..D.n rather than\n1050|// over the two lines between its title and its first subheading.\n1051|func sectionClauseInventory(document *specdoc.Document, key string) ([]normativeClause, error) {\n1052|\tidentifier, err := sectionDocumentIdentifier(key)\n1053|\tif err != nil {\n1054|\t\treturn nil, err\n1055|\t}\n1056|\tprefix := identifier + \".\"\n1057|\tvar result []normativeClause\n1058|\tfor line := 1; line <= document.LineCount(); line++ {\n1059|\t\towner, ok := document.SectionID(line)\n1060|\t\tif !ok || (owner != identifier && !strings.HasPrefix(owner, prefix)) {\n1061|\t\t\tcontinue\n1062|\t\t}\n1063|\t\ttext, ok := document.Line(line)\n1064|\t\tif !ok {\n1065|\t\t\treturn nil, fmt.Errorf(\"pinned document line %d is unreadable\", line)\n1066|\t\t}\n1067|\t\tif !normativeKeywordPattern.MatchString(text) {\n1068|\t\t\tcontinue\n1069|\t\t}\n1070|\t\tresult = append(result, normativeClause{\n1071|\t\t\tID:   fmt.Sprintf(\"%s#%d\", identifier, len(result)+1),\n1072|\t\t\tLine: line,\n1073|\t\t\tText: strings.TrimSpace(text),\n1074|\t\t})\n1075|\t}\n1076|\treturn result, nil\n1077|}\n1078|\n1079|// coverageBucket is the measured coverage level. It is computed from the two\n1080|// counts and never read from the registry.\n1081|func coverageBucket(discharged, total int) coverageLevel {\n1082|\tswitch {\n1083|\tcase total == 0:\n1084|\t\treturn coverageUnmeasured\n1085|\tcase discharged == 0:\n1086|\t\treturn coverageUnevidenced\n1087|\tcase discharged >= total:\n1088|\t\treturn coverageFull\n1089|\tcase discharged*2 >= total:\n1090|\t\treturn coveragePartial\n1091|\tdefault:\n1092|\t\treturn coverageSliver\n1093|\t}\n1094|}\n1095|\n1096|// sectionCoverage is the measured result for one section binding.\n1097|type sectionCoverage struct {\n1098|\tKey        string\n1099|\tLevel      coverageLevel\n1100|\tDischarged int\n1101|\tTotal      int\n1102|\tGap        string\n1103|}\n1104|\n1105|// Ratio renders the measured coverage as the ratio it was computed from, so a\n1106|// report never has to describe coverage in prose.\n1107|func (coverage sectionCoverage) Ratio() string {\n1108|\treturn fmt.Sprintf(\"%d/%d\", coverage.Discharged, coverage.Total)\n1109|}\n1110|\n1111|// verifySectionBindingCoverage measures one section binding against the pinned\n1112|// document and refuses a declared level that differs from the measured one.\n1113|//\n1114|// This is the check that stops a binding from claiming a whole section while\n1115|// implementing a corner of it. It verifies what it can decide: that every\n1116|// enumerated clause is a real obligation of the claimed section, quoted\n1117|// verbatim at the line it occupies, and named by an acceptance case the binding\n1118|// itself registers; and that the declared level equals the measured ratio. It\n1119|// cannot decide that the named acceptance case exercises the clause's meaning —\n1120|// that residual is stated in README.md and in the coverage artifact.\n1121|func verifySectionBindingCoverage(\n1122|\tdocument *specdoc.Document,\n1123|\tgroup ownershipGroup,\n1124|\tacceptanceIDs map[string]struct{},\n1125|) (sectionCoverage, error) {\n1126|\tkey := group.Keys[0]\n1127|\tinventory, err := sectionClauseInventory(document, key)\n1128|\tif err != nil {\n1129|\t\treturn sectionCoverage{}, fail(\"section binding %q clause inventory: %v\", key, err)\n1130|\t}\n1131|\tbyIdentifier := make(map[string]normativeClause, len(inventory))\n1132|\tfor _, clause := range inventory {\n1133|\t\tbyIdentifier[clause.ID] = clause\n1134|\t}\n1135|\tgroupCases := make(map[string]struct{}, len(group.AcceptanceCases))\n1136|\tfor _, acceptanceID := range group.AcceptanceCases {\n1137|\t\tgroupCases[acceptanceID] = struct{}{}\n1138|\t}\n1139|\n1140|\tseen := make(map[string]struct{}, len(group.Clauses))\n1141|\tfor _, declared := range group.Clauses {\n1142|\t\tclause, known := byIdentifier[declared.ID]\n1143|\t\tif !known {\n1144|\t\t\treturn sectionCoverage{}, fail(\n1145|\t\t\t\t\"section binding %q discharges clause %q, which is not one of the %d normative clauses of the pinned section\",\n1146|\t\t\t\tkey, declared.ID, len(inventory))\n1147|\t\t}\n1148|\t\tif _, duplicate := seen[declared.ID]; duplicate {\n1149|\t\t\treturn sectionCoverage{}, fail(\"section binding %q repeats discharged clause %q\", key, declared.ID)\n1150|\t\t}\n1151|\t\tseen[declared.ID] = struct{}{}\n1152|\t\tif declared.Line != clause.Line {\n1153|\t\t\treturn sectionCoverage{}, fail(\n1154|\t\t\t\t\"section binding %q clause %q declares line %d, but the pinned clause is at line %d\",\n1155|\t\t\t\tkey, declared.ID, declared.Line, clause.Line)\n1156|\t\t}\n1157|\t\texcerpt := specdoc.Normalize(declared.Excerpt)\n1158|\t\tif excerpt == \"\" {\n1159|\t\t\treturn sectionCoverage{}, fail(\"section binding %q clause %q quotes an empty excerpt\", key, declared.ID)\n1160|\t\t}\n1161|\t\tif !normativeKeywordPattern.MatchString(excerpt) {\n1162|\t\t\treturn sectionCoverage{}, fail(\n1163|\t\t\t\t\"section binding %q clause %q quotes text that carries no RFC 2119 obligation\", key, declared.ID)\n1164|\t\t}\n1165|\t\tif !quoteBeginsAtLine(document, declared.Excerpt, clause.Line) {\n1166|\t\t\treturn sectionCoverage{}, fail(\n1167|\t\t\t\t\"section binding %q clause %q does not quote the pinned document verbatim at line %d\",\n1168|\t\t\t\tkey, declared.ID, clause.Line)\n1169|\t\t}\n1170|\t\tif len(declared.AcceptanceCases) == 0 {\n1171|\t\t\treturn sectionCoverage{}, fail(\n1172|\t\t\t\t\"section binding %q clause %q names no acceptance case that discharges it\", key, declared.ID)\n1173|\t\t}\n1174|\t\tcaseSeen := make(map[string]struct{}, len(declared.AcceptanceCases))\n1175|\t\tfor _, acceptanceID := range declared.AcceptanceCases {\n1176|\t\t\tif _, duplicate := caseSeen[acceptanceID]; duplicate {\n1177|\t\t\t\treturn sectionCoverage{}, fail(\n1178|\t\t\t\t\t\"section binding %q clause %q repeats acceptance case %q\", key, declared.ID, acceptanceID)\n1179|\t\t\t}\n1180|\t\t\tcaseSeen[acceptanceID] = struct{}{}\n1181|\t\t\tif _, registered := acceptanceIDs[acceptanceID]; !registered {\n1182|\t\t\t\treturn sectionCoverage{}, fail(\n1183|\t\t\t\t\t\"section binding %q clause %q references unregistered acceptance case %q\", key, declared.ID, acceptanceID)\n1184|\t\t\t}\n1185|\t\t\tif _, owned := groupCases[acceptanceID]; !owned {\n1186|\t\t\t\treturn sectionCoverage{}, fail(\n1187|\t\t\t\t\t\"section binding %q clause %q discharges through acceptance case %q, which the binding does not own\",\n1188|\t\t\t\t\tkey, declared.ID, acceptanceID)\n1189|\t\t\t}\n1190|\t\t}\n1191|\t}\n1192|\n1193|\tmeasured := coverageBucket(len(group.Clauses), len(inventory))\n1194|\tif group.Coverage == \"\" {\n1195|\t\treturn sectionCoverage{}, fail(\n1196|\t\t\t\"section binding %q declares no coverage level; the pinned section carries %d normative clauses and the binding enumerates %d\",\n1197|\t\t\tkey, len(inventory), len(group.Clauses))\n1198|\t}\n1199|\tif group.Coverage != measured {\n1200|\t\treturn sectionCoverage{}, fail(\n1201|\t\t\t\"section binding %q claims %s coverage but discharges %d of the %d normative clauses of the pinned section, which is %s coverage\",\n1202|\t\t\tkey, group.Coverage, len(group.Clauses), len(inventory), measured)\n1203|\t}\n1204|\tdisplay, err := sectionDisplayName(key)\n1205|\tif err != nil {\n1206|\t\treturn sectionCoverage{}, fail(\"section binding %q: %v\", key, err)\n1207|\t}\n1208|\t// Every level below full owes a gap, coverageUnmeasured included. Before\n1209|\t// this the gate refused a gap on the unmeasured bucket, so the bindings with\n1210|\t// the least evidence behind them were the only ones structurally forbidden\n1211|\t// from disclosing it.\n1212|\tswitch measured {\n1213|\tcase coverageFull:\n1214|\t\tif group.Gap != \"\" {\n1215|\t\t\treturn sectionCoverage{}, fail(\"section binding %q claims %s coverage and still names a gap\", key, measured)\n1216|\t\t}\n1217|\tdefault:\n1218|\t\tif err := verifyGapDiscloses(group.Gap, display, group.Production.Declaration); err != nil {\n1219|\t\t\treturn sectionCoverage{}, fail(\n1220|\t\t\t\t\"section binding %q claims %s coverage without naming what %s leaves unimplemented: %v\",\n1221|\t\t\t\tkey, measured, display, err)\n1222|\t\t}\n1223|\t}\n1224|\treturn sectionCoverage{\n1225|\t\tKey:        key,\n1226|\t\tLevel:      measured,\n1227|\t\tDischarged: len(group.Clauses),\n1228|\t\tTotal:      len(inventory),\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
