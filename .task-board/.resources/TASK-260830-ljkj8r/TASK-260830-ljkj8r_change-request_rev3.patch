+				// colon grammar (no 1-character URI carries
+				// a scheme), so the floor is proven with
+				// the shortest admittable URI rather than
+				// a 1-character literal.
+				below, atMin = `""`, `"a:b"`
+			}
+			if err := row.drive(t, below); err == nil {
