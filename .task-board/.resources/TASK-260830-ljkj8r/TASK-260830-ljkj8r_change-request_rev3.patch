+	t.Helper()
+	request, err := DecodeRequestFrame(fixtureRequestFrame("2.0.0", "manifest", fixtureRequestID, 5000, `{}`))
+	if err != nil {
+		t.Fatalf("reachRequest: %v", err)
+	}
+	return request
+}
