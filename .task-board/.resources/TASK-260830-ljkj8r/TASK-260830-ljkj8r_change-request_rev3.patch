+	// QuerySchema is the exact schema member a directory query
+	// carries.
+	QuerySchema = "urn:ax:schema:session-directory-query"
+	// QuerySchemaVersion is the only query schema_version this
+	// host accepts.
+	QuerySchemaVersion = "1.0.0"
+)
