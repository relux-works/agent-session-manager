{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c403","stream":{"kind":"session","id":"01a07545-b24a-7111-bd71-a49bf0fc5a97"},"sequence":92,"recorded_at":1780531400000179,"record_type":"event","durability":"durable","causation_id":"e61bb3fc-6388-408f-a265-e94b890e4ba1","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e61bb3fc-6388-408f-a265-e94b890e4ba1","run_stream":{"kind":"run","id":"e61bb3fc-6388-408f-a265-e94b890e4ba1"},"task_stream":{"kind":"task","id":"28c18d53-1a3a-4bca-b3d9-0e249cb6c06b"},"task_id":"28c18d53-1a3a-4bca-b3d9-0e249cb6c06b","event":{"kind":"output","task_id":"28c18d53-1a3a-4bca-b3d9-0e249cb6c06b","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/manifest.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|)\n9|\n10|// This file validates the Section 7.8 Session Adapter Manifest: the\n11|// closed urn:ax:schema:session-adapter-manifest 1.0.0 object a\n12|// manifest operation returns as its success body. The manifest\n13|// declares possible surfaces, not runtime availability; every member\n14|// below is required and the object is closed.\n15|\n16|// manifestSchema is the exact schema identifier the manifest carries.\n17|const manifestSchema = \"urn:ax:schema:session-adapter-manifest\"\n18|\n19|// manifestSchemaVersion is the only manifest version this host accepts.\n20|const manifestSchemaVersion = \"1.0.0\"\n21|\n22|// capabilityOrder is the exact fifteen-name ordered capability\n23|// registry Section 7.8 shows. The manifest and every probe body\n24|// carry exactly these names in this order; a sixteenth name\n25|// advertises a surface the contract never defined, and a missing\n26|// name hides one it did.\n27|var capabilityOrder = []string{\n28|\t\"native_discovery\",\n29|\t\"stable_snapshot\",\n30|\t\"raw_capture\",\n31|\t\"canonical_read\",\n32|\t\"canonical_write\",\n33|\t\"native_read_back\",\n34|\t\"native_resume_plan\",\n35|\t\"official_import\",\n36|\t\"same_environment_lossless_clone\",\n37|\t\"tool_history\",\n38|\t\"usage_history\",\n39|\t\"compaction_history\",\n40|\t\"subagent_graph\",\n41|\t\"opaque_reasoning_roundtrip\",\n42|\t\"workspace_binding\",\n43|}\n44|\n45|// Capabilities returns the Section 7.8 capability registry in order.\n46|// The result is a copy; the registry cannot be mutated through it.\n47|func Capabilities() []string {\n48|\treturn append([]string(nil), capabilityOrder...)\n49|}\n50|\n51|// manifestMembers is the exact required member set DecodeManifest\n52|// accepts: the schema envelope, identity, versioning, platforms, the\n53|// Section 7.8 operation registry in section order, and the\n54|// capability registry above.\n55|var manifestMembers = map[string]bool{\n56|\t\"schema\":                    true,\n57|\t\"schema_version\":            true,\n58|\t\"provider_id\":               true,\n59|\t\"environment_id\":            true,\n60|\t\"display_name\":              true,\n61|\t\"adapter_version\":           true,\n62|\t\"environment_version_range\": true,\n63|\t\"platforms\":                 true,\n64|\t\"operations\":                true,\n65|\t\"capability_names\":          true,\n66|\t\"extensions\":                true,\n67|}\n68|\n69|// manifestRequired lists manifestMembers in a fixed order so a body\n70|// missing several members always names the same one.\n71|var manifestRequired = []string{\n72|\t\"schema\",\n73|\t\"schema_version\",\n74|\t\"provider_id\",\n75|\t\"environment_id\",\n76|\t\"display_name\",\n77|\t\"adapter_version\",\n78|\t\"environment_version_range\",\n79|\t\"platforms\",\n80|\t\"operations\",\n81|\t\"capability_names\",\n82|\t\"extensions\",\n83|}\n84|\n85|// Manifest is the validated Session Adapter Manifest 1.0.0: the\n86|// provider and environment identity plus the ordered registries the\n87|// probe and dispatch layers check. The canonical body is retained\n88|// for the host-computed digest.\n89|type Manifest struct {\n90|\tProviderID     string\n91|\tEnvironmentID  string\n92|\tAdapterVersion string\n93|\tPlatforms      []string\n94|\tOperations     []string\n95|\tCapabilities   []string\n96|\tcanonical      []byte\n97|}\n98|\n99|// Canonical returns the JCS bytes the digest was computed over.\n100|func (manifest Manifest) Canonical() []byte {\n101|\treturn append([]byte(nil), manifest.canonical...)\n102|}\n103|\n104|// DecodeManifest validates one manifest-operation success body as the\n105|// closed Section 7.8 Session Adapter Manifest. A manifest whose\n106|// operations differ from the dispatch registry, or whose capability\n107|// names differ from the registry above, advertises a surface the\n108|// host cannot invoke or hides one it must, so both are refused\n109|// outright.\n110|func DecodeManifest(body []byte) (Manifest, error) {\n111|\tmembers, fault := decodeStrictObject(body)\n112|\tif fault != nil {\n113|\t\tfailure, err := failProtocol(\"adapter manifest \"+fault.detail, fault.member)\n114|\t\tif err != nil {\n115|\t\t\treturn Manifest{}, err\n116|\t\t}\n117|\t\treturn Manifest{}, failure\n118|\t}\n119|\tif name, unknown := unknownMember(members, manifestMembers); unknown {\n120|\t\tfailure, err := failProtocol(\"adapter manifest carries unknown member\", name)\n121|\t\tif err != nil {\n122|\t\t\treturn Manifest{}, err\n123|\t\t}\n124|\t\treturn Manifest{}, failure\n125|\t}\n126|\tif name, missing := missingMember(members, manifestRequired); missing {\n127|\t\tfailure, err := failProtocol(\"adapter manifest misses a required member\", name)\n128|\t\tif err != nil {\n129|\t\t\treturn Manifest{}, err\n130|\t\t}\n131|\t\treturn Manifest{}, failure\n132|\t}\n133|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != manifestSchema {\n134|\t\tfailure, err := failProtocol(\"adapter manifest schema is not the session adapter manifest\", \"schema\")\n135|\t\tif err != nil {\n136|\t\t\treturn Manifest{}, err\n137|\t\t}\n138|\t\treturn Manifest{}, failure\n139|\t}\n140|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != manifestSchemaVersion {\n141|\t\tfailure, err := failProtocol(\"adapter manifest version is not 1.0.0\", \"schema_version\")\n142|\t\tif err != nil {\n143|\t\t\treturn Manifest{}, err\n144|\t\t}\n145|\t\treturn Manifest{}, failure\n146|\t}\n147|\tproviderID, ok := rawString(members[\"provider_id\"])\n148|\tif !ok || !providerIDPattern.MatchString(providerID) {\n149|\t\tfailure, err := failProtocol(\"adapter manifest provider identifier is not a provider-id\", \"provider_id\")\n150|\t\tif err != nil {\n151|\t\t\treturn Manifest{}, err\n152|\t\t}\n153|\t\treturn Manifest{}, failure\n154|\t}\n155|\tenvironmentID, ok := rawString(members[\"environment_id\"])\n156|\tif !ok || !environmentIDPattern.MatchString(environmentID) {\n157|\t\tfailure, err := failProtocol(\"adapter manifest environment identifier is not an environment-id\", \"environment_id\")\n158|\t\tif err != nil {\n159|\t\t\treturn Manifest{}, err\n160|\t\t}\n161|\t\treturn Manifest{}, failure\n162|\t}\n163|\tif _, ok := checkStringBounds(members[\"display_name\"], 1, 128); !ok {\n164|\t\tfailure, err := failProtocol(\"adapter manifest display name is not a string[1..128]\", \"display_name\")\n165|\t\tif err != nil {\n166|\t\t\treturn Manifest{}, err\n167|\t\t}\n168|\t\treturn Manifest{}, failure\n169|\t}\n170|\tadapterVersion, ok := rawString(members[\"adapter_version\"])\n171|\tif !ok || !semverPattern.MatchString(adapterVersion) {\n172|\t\tfailure, err := failProtocol(\"adapter manifest adapter version is not SemVer\", \"adapter_version\")\n173|\t\tif err != nil {\n174|\t\t\treturn Manifest{}, err\n175|\t\t}\n176|\t\treturn Manifest{}, failure\n177|\t}\n178|\tif _, ok := checkStringBounds(members[\"environment_version_range\"], 1, 256); !ok {\n179|\t\tfailure, err := failProtocol(\"adapter manifest environment version range is not a non-empty string[1..256]\", \"environment_version_range\")\n180|\t\tif err != nil {\n181|\t\t\treturn Manifest{}, err\n182|\t\t}\n183|\t\treturn Manifest{}, failure\n184|\t}\n185|\tplatforms, ok := checkSortedUniqueStrings(members[\"platforms\"], 1, 16, 1, 4)\n186|\tif !ok {\n187|\t\tfailure, err := failProtocol(\"adapter manifest platforms are not a sorted unique non-empty subset\", \"platforms\")\n188|\t\tif err != nil {\n189|\t\t\treturn Manifest{}, err\n190|\t\t}\n191|\t\treturn Manifest{}, failure\n192|\t}\n193|\tfor _, platform := range platforms {\n194|\t\tif _, err := scalar.ParsePlatform(platform); err != nil {\n195|\t\t\tfailure, faultErr := failProtocol(\"adapter manifest platform is outside linux|macos|windows|wsl2\", \"platforms\")\n196|\t\t\tif faultErr != nil {\n197|\t\t\t\treturn Manifest{}, faultErr\n198|\t\t\t}\n199|\t\t\treturn Manifest{}, failure\n200|\t\t}\n201|\t}\n202|\toperations, ok := checkOperationRegistry(members[\"operations\"])\n203|\tif !ok {\n204|\t\tfailure, err := failProtocol(\"adapter manifest operations are not the complete ordered fourteen-name registry\", \"operations\")\n205|\t\tif err != nil {\n206|\t\t\treturn Manifest{}, err\n207|\t\t}\n208|\t\treturn Manifest{}, failure\n209|\t}\n210|\tcapabilities, ok := checkCapabilityRegistry(members[\"capability_names\"])\n211|\tif !ok {\n212|\t\tfailure, err := failProtocol(\"adapter manifest capability names are not the complete ordered fifteen-name registry\", \"capability_names\")\n213|\t\tif err != nil {\n214|\t\t\treturn Manifest{}, err\n215|\t\t}\n216|\t\treturn Manifest{}, failure\n217|\t}\n218|\tif !checkExtensions(members[\"extensions\"]) {\n219|\t\tfailure, err := failProtocol(\"adapter manifest extensions are not reverse-DNS keyed\", \"extensions\")\n220|\t\tif err != nil {\n221|\t\t\treturn Manifest{}, err\n222|\t\t}\n223|\t\treturn Manifest{}, failure\n224|\t}\n225|\tcanonical, err := canonicaljson.Canonicalize(body)\n226|\tif err != nil {\n227|\t\tfailure, faultErr := failProtocol(\"adapter manifest is not canonical JSON\", \"\")\n228|\t\tif faultErr != nil {\n229|\t\t\treturn Manifest{}, faultErr\n230|\t\t}\n231|\t\treturn Manifest{}, failure\n232|\t}\n233|\treturn Manifest{\n234|\t\tProviderID:     providerID,\n235|\t\tEnvironmentID:  environmentID,\n236|\t\tAdapterVersion: adapterVersion,\n237|\t\tPlatforms:      platforms,\n238|\t\tOperations:     operations,\n239|\t\tCapabilities:   capabilities,\n240|\t\tcanonical:      canonical,\n241|\t}, nil\n242|}\n243|\n244|// checkOperationRegistry reports whether the member is exactly the\n245|// dispatch registry in section order: same names, same positions,\n246|// same length. Sortedness is not the rule here — order is — so the\n247|// comparison is element-wise against operationOrder.\n248|func checkOperationRegistry(raw json.RawMessage) ([]string, bool) {\n249|\telements, ok := decodeArray(raw)\n250|\tif !ok || len(elements) != len(operationOrder) {\n251|\t\treturn nil, false\n252|\t}\n253|\toperations := make([]string, 0, len(elements))\n254|\tfor index, element := range elements {\n255|\t\tname, ok := rawString(element)\n256|\t\tif !ok || name != string(operationOrder[index]) {\n257|\t\t\treturn nil, false\n258|\t\t}\n259|\t\toperations = append(operations, name)\n260|\t}\n261|\treturn operations, true\n262|}\n263|\n264|// checkCapabilityRegistry reports whether the member is exactly the\n265|// fifteen-name capability registry in section order.\n266|func checkCapabilityRegistry(raw json.RawMessage) ([]string, bool) {\n267|\telements, ok := decodeArray(raw)\n268|\tif !ok || len(elements) != len(capabilityOrder) {\n269|\t\treturn nil, false\n270|\t}\n271|\tcapabilities := make([]string, 0, len(elements))\n272|\tfor index, element := range elements {\n273|\t\tname, ok := rawString(element)\n274|\t\tif !ok || name != capabilityOrder[index] {\n275|\t\t\treturn nil, false\n276|\t\t}\n277|\t\tcapabilities = append(capabilities, name)\n278|\t}\n279|\treturn capabilities, true\n280|}\n281|\n282|// ManifestDigest returns the host-computed JCS SHA-256 of the\n283|// validated manifest: the session_adapter_manifest_digest. It is\n284|// computed by the host, never embedded by the adapter, so a\n285|// manifest that names its own digest cannot mint trust.\n286|func ManifestDigest(manifest Manifest) scalar.Digest {\n287|\treturn scalar.SHA256Digest(manifest.canonical)\n288|}"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c405","stream":{"kind":"session","id":"01a07545-b24a-7111-bd71-a49bf0fc5a97"},"sequence":93,"recorded_at":1780531400000181,"record_type":"event","durability":"durable","causation_id":"e61bb3fc-6388-408f-a265-e94b890e4ba1","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e61bb3fc-6388-408f-a265-e94b890e4ba1","run_stream":{"kind":"run","id":"e61bb3fc-6388-408f-a265-e94b890e4ba1"},"task_stream":{"kind":"task","id":"28c18d53-1a3a-4bca-b3d9-0e249cb6c06b"},"task_id":"28c18d53-1a3a-4bca-b3d9-0e249cb6c06b","event":{"kind":"completed","task_id":"28c18d53-1a3a-4bca-b3d9-0e249cb6c06b"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c407","stream":{"kind":"session","id":"01a07545-b24a-7111-bd71-a49bf0fc5a97"},"sequence":94,"recorded_at":1780531400000183,"record_type":"event","durability":"durable","causation_id":"e61bb3fc-6388-408f-a265-e94b890e4ba1","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e61bb3fc-6388-408f-a265-e94b890e4ba1","run_stream":{"kind":"run","id":"e61bb3fc-6388-408f-a265-e94b890e4ba1"},"call_id":"call_01a07545e2797130804eb2cbe4072247","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/doc.go`.\n1|// Package sessadapter implements the ax host side of the companion\n2|// Session Adapter protocol of pinned specification Section 7.8: the\n3|// closed operation registry, envelope framing, manifest and probe\n4|// validation, call-context and authority gates, resource limits,\n5|// request-digest binding, discovery binding, and Environment Tuple\n6|// admission.\n7|//\n8|// The actor every Section 7.8 RFC 2119 keyword governs here is the ax\n9|// host (this repository). The session adapter is a child surface this\n10|// package never trusts: it runs in the same trusted\n11|// ax-provider-<id> executable as Provider Protocol 2.0.0 and is not a\n12|// separately discovered plugin, so discovery here means binding the\n13|// adapter to the independently observed provider candidate — the same\n14|// executable path, the same host-observed executable digest, the same\n15|// provider identifier, and the same manifest digest — before every\n16|// call and every target mutation. Every byte the adapter emits is\n17|// attacker-influenced, so every frame is validated before any member\n18|// is used.\n19|//\n20|// This package owns the closed-object decoders and the fail-closed\n21|// gates. Operation dispatch means the host maps an operation name to\n22|// one adapter invocation and refuses unknown names locally with\n23|// operation_unknown; an unavailable operation is refused with\n24|// capability_unavailable. A failed read is never an absence: a\n25|// partial, malformed, over-limit, or escaped result is a\n26|// session_adapter_protocol_error, never an empty result and never\n27|// fallback permission.\n28|//\n29|// The package mutates no durable state of its own and keeps no\n30|// cross-call cache: adapter mutations address fresh isolated sinks\n31|// the core creates per call, and candidate objects are addressed only\n32|// by their exact *_candidate_id in the request's sink. The core\n33|// retrieves, validates, rehashes, and seals them. Retry receipts live\n34|// in the core and the sink, not in the host: Section 7.8 defines no\n35|// (operation, operation_id) retry key — the pinned catalog carries an\n36|// empty mutation-group list for the session_adapter family — so the\n37|// idempotency this package enforces is the request-digest binding\n38|// (the adapter answers for exactly the canonical body the host sent)\n39|// and the byte-for-byte context echo, plus the fresh-sink authority\n40|// rule that keeps one call's writes out of every other call's sink.\n41|// Cross-crash durability of adapter results is the core document's\n42|// property, the same division the provider host records for its\n43|// transaction document.\n44|//\n45|// Stated bounds: transport process management (spawning the provider\n46|// executable, deadlines, stdio ownership) belongs to the caller, which\n47|// supplies frames this package validates as bytes; nested objects\n48|// owned by Sections 13.14 and 10.8 (CaptureBoundary, NativeIdentity,\n49|// StableSnapshotProof, CloneSourceSummary, FidelityCounts,\n50|// WorkspaceBinding, and the remaining clone-plan types) are checked\n51|// for presence and object shape only, never for content — their\n52|// content owners are the directory-node and boundary leaves of this\n53|// Story, and inventing their validation here would collide with that\n54|// ownership at integration. The tuple-registry signature, sequence\n55|// monotonicity, and publication rules of Section 13.14 fail closed at\n56|// the registry owner, which does not exist yet; this package admits\n57|// single entries against caller-held registry facts. Resume-smoke\n58|// family and secret checks on resume-plan argv rest on\n59|// ResumeSmokeEvidence (native_cli_family), which lives in the same\n60|// unowned registry scope: this package enforces the exact-once\n61|// identity occurrence and the argv shape, not the family name or the\n62|// absence of secrets.\n63|package sessadapter","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c409","stream":{"kind":"session","id":"01a07545-b24a-7111-bd71-a49bf0fc5a97"},"sequence":95,"recorded_at":1780531400000185,"record_type":"event","durability":"durable","causation_id":"e61bb3fc-6388-408f-a265-e94b890e4ba1","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e61bb3fc-6388-408f-a265-e94b890e4ba1","run_stream":{"kind":"run","id":"e61bb3fc-6388-408f-a265-e94b890e4ba1"},"call_id":"call_01a07545e3287b7286791346c8e8a1f9","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/protocol.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|// Wire constants of pinned specification Section 7.8. The protocol\n12|// identifier and version are exact: the adapter speaks 1.0.0 in the\n13|// same trusted executable as Provider Protocol 2.0.0, and anything\n14|// else on the wire is a session_adapter_protocol_error, never a\n15|// negotiation.\n16|const (\n17|\t// ProtocolID is the exact protocol member every request and\n18|\t// response envelope carries.\n19|\tProtocolID = \"urn:ax:protocol:session-adapter\"\n20|\t// ProtocolVersion is the exact protocol_version member this host\n21|\t// writes and the only one it accepts a response under.\n22|\tProtocolVersion = \"1.0.0\"\n23|\t// ProtocolMajor is the major this host implements. Section 7.8\n24|\t// defines no multi-major negotiation for the adapter, so a\n25|\t// different major is an invalid envelope, not a downgrade.\n26|\tProtocolMajor = 1\n27|\t// ErrorVersion is the Structured Error version every failure\n28|\t// envelope carries: Session Adapter 1.0 statically binds\n29|\t// Structured Error 1.1.0.\n30|\tErrorVersion = axerror.Version110\n31|\t// MaxFrameBytes bounds one JSONL line in either direction:\n32|\t// Section 7.8 inherits Section 7.2's rule that every line is one\n33|\t// complete UTF-8 JSON object no larger than 8 MiB.\n34|\tMaxFrameBytes = 8 << 20\n35|)\n36|\n37|// Operation names one Section 7.8 registry entry. The registry is\n38|// closed: dispatch refuses any other name locally, before any adapter\n39|// surface is touched.\n40|type Operation string\n41|\n42|// Section 7.8 operation registry in the section's table order. The\n43|// inventory test derives this list from the pinned specification\n44|// text and requires exact ordered equality, so a dropped, added, or\n45|// reordered entry reddens there rather than passing silently.\n46|const (\n47|\tOpManifest       Operation = \"manifest\"\n48|\tOpProbe          Operation = \"probe\"\n49|\tOpDiscover       Operation = \"discover\"\n50|\tOpInspect        Operation = \"inspect\"\n51|\tOpSnapshotProof  Operation = \"snapshot-proof\"\n52|\tOpCapturePlan    Operation = \"capture-plan\"\n53|\tOpCapture        Operation = \"capture\"\n54|\tOpNormalize      Operation = \"normalize\"\n55|\tOpProjectionPlan Operation = \"projection-plan\"\n56|\tOpProject        Operation = \"project\"\n57|\tOpReadBack       Operation = \"read-back\"\n58|\tOpValidate       Operation = \"validate\"\n59|\tOpResumePlan     Operation = \"resume-plan\"\n60|\tOpDoctor         Operation = \"doctor\"\n61|)\n62|\n63|// operationOrder is the single construction site of the dispatch\n64|// registry.\n65|var operationOrder = []Operation{\n66|\tOpManifest,\n67|\tOpProbe,\n68|\tOpDiscover,\n69|\tOpInspect,\n70|\tOpSnapshotProof,\n71|\tOpCapturePlan,\n72|\tOpCapture,\n73|\tOpNormalize,\n74|\tOpProjectionPlan,\n75|\tOpProject,\n76|\tOpReadBack,\n77|\tOpValidate,\n78|\tOpResumePlan,\n79|\tOpDoctor,\n80|}\n81|\n82|// Operations returns the dispatch registry in section order. The\n83|// result is a copy; the registry cannot be mutated through it.\n84|func Operations() []string {\n85|\tout := make([]string, 0, len(operationOrder))\n86|\tfor _, operation := range operationOrder {\n87|\t\tout = append(out, string(operation))\n88|\t}\n89|\treturn out\n90|}\n91|\n92|// validOperation reports whether the name is a registry member.\n93|func validOperation(name string) bool {\n94|\tfor _, operation := range operationOrder {\n95|\t\tif string(operation) == name {\n96|\t\t\treturn true\n97|\t\t}\n98|\t}\n99|\treturn false\n100|}\n101|\n102|// The refusal constructors below are declared as variables so the\n103|// inventory gate can observe every exercised refusal site. Each is\n104|// the single construction site for its failure class; production\n105|// code must not build *axerror.Error any other way.\n106|//\n107|// failInvalid reports a caller error caught before any adapter\n108|// surface is touched: a required set naming an unknown capability, a\n109|// binding the caller built from unobserved facts. failProtocol\n110|// reports an unusable adapter frame: an invalid envelope, a body\n111|// outside its closed shape, a digest mismatch, a partial,\n112|// malformed, over-limit, or escaped result. failUnknownOperation\n113|// reports a name outside the closed registry. failCapability\n114|// reports an operation the adapter does not implement.\n115|// failUnsupportedTuple reports an environment the signed registry\n116|// does not admit. failIntegrity reports a binding observation that\n117|// cannot be reconciled to trusted candidate facts: a failed or\n118|// partial read, or a before-call fact that no longer equals the\n119|// freshly read fact and the Journal binding.\n120|//\n121|// Every constructor takes the human detail first as a string literal\n122|// at the call site and the distinguishing wire fact second, so the\n123|// inventory derives one obligation per literal detail and every\n124|// witness can assert which arm fired through the code plus the\n125|// distinguishing detail, not merely that something refused.\n126|var failInvalid = func(detail string, field string) (*axerror.Error, error) {\n127|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"invalid_config\", Message: \"session adapter host refused the call: \" + detail, Details: axerror.Details{\"field\": field}})\n128|}\n129|\n130|var failProtocol = func(detail string, member string) (*axerror.Error, error) {\n131|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"session_adapter_protocol_error\", Message: \"session adapter host rejected the adapter frame: \" + detail, Details: axerror.Details{\"member\": member}})\n132|}\n133|\n134|var failUnknownOperation = func(detail string, operation string) (*axerror.Error, error) {\n135|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"operation_unknown\", Message: \"session adapter host refused an unknown operation: \" + detail, Details: axerror.Details{\"operation\": operation}})\n136|}\n137|\n138|var failCapability = func(detail string, capability string) (*axerror.Error, error) {\n139|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"capability_unavailable\", Message: \"session adapter host refused an unavailable operation: \" + detail, Details: axerror.Details{\"capability\": capability}})\n140|}\n141|\n142|// failUnavailable reports an operation the adapter does not\n143|// implement. The operation-to-capability mapping is not stated in\n144|// Section 7.8, so the refusal names the operation rather than\n145|// inventing a capability: the detail key is operation, never a\n146|// capability the contract never defined.\n147|var failUnavailable = func(detail string, operation string) (*axerror.Error, error) {\n148|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"capability_unavailable\", Message: \"session adapter host refused an unimplemented operation: \" + detail, Details: axerror.Details{\"operation\": operation}})\n149|}\n150|\n151|var failUnsupportedTuple = func(detail string, environment string) (*axerror.Error, error) {\n152|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"unsupported_environment_tuple\", Message: \"session adapter host refused an unadmitted environment: \" + detail, Details: axerror.Details{\"environment\": environment}})\n153|}\n154|\n155|var failIntegrity = func(detail string, subject string) (*axerror.Error, error) {\n156|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"integrity_failure\", Message: \"session adapter binding observation is not trusted state: \" + detail, Details: axerror.Details{\"subject\": subject}})\n157|}\n158|\n159|// requestMembers is the exact request envelope member set Section 7.8\n160|// requires: protocol, protocol_version, request_id, operation,\n161|// deadline, and body.\n162|var requestMembers = map[string]bool{\n163|\t\"protocol\":         true,\n164|\t\"protocol_version\": true,\n165|\t\"request_id\":       true,\n166|\t\"operation\":        true,\n167|\t\"deadline\":         true,\n168|\t\"body\":             true,\n169|}\n170|\n171|// requestRequired lists requestMembers in a fixed order so an\n172|// envelope missing several members always names the same one.\n173|var requestRequired = []string{\n174|\t\"protocol\",\n175|\t\"protocol_version\",\n176|\t\"request_id\",\n177|\t\"operation\",\n178|\t\"deadline\",\n179|\t\"body\",\n180|}\n181|\n182|// successMembers is the exact success envelope member set: the four\n183|// echoed identity fields, ok=true, and body, with no error member.\n184|var successMembers = map[string]bool{\n185|\t\"protocol\":         true,\n186|\t\"protocol_version\": true,\n187|\t\"request_id\":       true,\n188|\t\"operation\":        true,\n189|\t\"ok\":               true,\n190|\t\"body\":             true,\n191|}\n192|\n193|// successRequired lists successMembers in a fixed order.\n194|var successRequired = []string{\n195|\t\"protocol\",\n196|\t\"protocol_version\",\n197|\t\"request_id\",\n198|\t\"operation\",\n199|\t\"ok\",\n200|\t\"body\",\n201|}\n202|\n203|// failureMembers is the exact failure envelope member set: the four\n204|// echoed identity fields, ok=false, and error, with no body member.\n205|var failureMembers = map[string]bool{\n206|\t\"protocol\":         true,\n207|\t\"protocol_version\": true,\n208|\t\"request_id\":       true,\n209|\t\"operation\":        true,\n210|\t\"ok\":               true,\n211|\t\"error\":            true,\n212|}\n213|\n214|// failureRequired lists failureMembers in a fixed order.\n215|var failureRequired = []string{\n216|\t\"protocol\",\n217|\t\"protocol_version\",\n218|\t\"request_id\",\n219|\t\"operation\",\n220|\t\"ok\",\n221|\t\"error\",\n222|}\n223|\n224|// Request is one Section 7.8 request envelope as the host wrote it:\n225|// the identity fields plus the canonical body bytes. Responses are\n226|// checked against it, never trusted on their own echo.\n227|type Request struct {\n228|\tOperation Operation\n229|\tRequestID string\n230|\tBody      []byte\n231|}\n232|\n233|// DecodeRequestFrame validates one outbound request frame before it\n234|// reaches the adapter surface: one complete object within the frame\n235|// bound, the exact envelope members, the exact protocol identifier\n236|// and version, a UUIDv7 request identifier, a registry operation, a\n237|// timestamp deadline, and an object body. An unknown operation is\n238|// operation_unknown; every other envelope defect is\n239|// session_adapter_protocol_error. The returned body is the raw\n240|// canonical member for the operation-layer checks.\n241|func DecodeRequestFrame(frame []byte) (Request, error) {\n242|\tif len(frame) == 0 {\n243|\t\tfailure, err := failProtocol(\"request frame is empty\", \"\")\n244|\t\tif err != nil {\n245|\t\t\treturn Request{}, err\n246|\t\t}\n247|\t\treturn Request{}, failure\n248|\t}\n249|\tif len(frame) > MaxFrameBytes {\n250|\t\tfailure, err := failProtocol(\"request frame exceeds the 8 MiB bound\", \"\")\n251|\t\tif err != nil {\n252|\t\t\treturn Request{}, err\n253|\t\t}\n254|\t\treturn Request{}, failure\n255|\t}\n256|\tmembers, fault := decodeStrictObject(frame)\n257|\tif fault != nil {\n258|\t\tfailure, err := failProtocol(\"request envelope \"+fault.detail, fault.member)\n259|\t\tif err != nil {\n260|\t\t\treturn Request{}, err\n261|\t\t}\n262|\t\treturn Request{}, failure\n263|\t}\n264|\tif name, unknown := unknownMember(members, requestMembers); unknown {\n265|\t\tfailure, err := failProtocol(\"request envelope carries unknown member\", name)\n266|\t\tif err != nil {\n267|\t\t\treturn Request{}, err\n268|\t\t}\n269|\t\treturn Request{}, failure\n270|\t}\n271|\tif name, missing := missingMember(members, requestRequired); missing {\n272|\t\tfailure, err := failProtocol(\"request envelope misses a required member\", name)\n273|\t\tif err != nil {\n274|\t\t\treturn Request{}, err\n275|\t\t}\n276|\t\treturn Request{}, failure\n277|\t}\n278|\tif protocol, ok := rawString(members[\"protocol\"]); !ok || protocol != ProtocolID {\n279|\t\tfailure, err := failProtocol(\"request protocol is not the session adapter\", \"protocol\")\n280|\t\tif err != nil {\n281|\t\t\treturn Request{}, err\n282|\t\t}\n283|\t\treturn Request{}, failure\n284|\t}\n285|\tif version, ok := rawString(members[\"protocol_version\"]); !ok || version != ProtocolVersion {\n286|\t\tfailure, err := failProtocol(\"request protocol version is not 1.0.0\", \"protocol_version\")\n287|\t\tif err != nil {\n288|\t\t\treturn Request{}, err\n289|\t\t}\n290|\t\treturn Request{}, failure\n291|\t}\n292|\trequestID, ok := rawString(members[\"request_id\"])\n293|\tif !ok {\n294|\t\tfailure, err := failProtocol(\"request identifier is not a string\", \"request_id\")\n295|\t\tif err != nil {\n296|\t\t\treturn Request{}, err\n297|\t\t}\n298|\t\treturn Request{}, failure\n299|\t}\n300|\tif _, err := scalar.ParseUUIDv7(requestID); err != nil {\n301|\t\tfailure, err := failProtocol(\"request identifier is not a UUIDv7\", \"request_id\")\n302|\t\tif err != nil {\n303|\t\t\treturn Request{}, err\n304|\t\t}\n305|\t\treturn Request{}, failure\n306|\t}\n307|\toperation, ok := rawString(members[\"operation\"])\n308|\tif !ok {\n309|\t\tfailure, err := failProtocol(\"request operation is not a string\", \"operation\")\n310|\t\tif err != nil {\n311|\t\t\treturn Request{}, err\n312|\t\t}\n313|\t\treturn Request{}, failure\n314|\t}\n315|\tif !validOperation(operation) {\n316|\t\tfailure, err := failUnknownOperation(\"request names an operation outside the closed registry\", operation)\n317|\t\tif err != nil {\n318|\t\t\treturn Request{}, err\n319|\t\t}\n320|\t\treturn Request{}, failure\n321|\t}\n322|\tif _, ok := checkTimestamp(members[\"deadline\"]); !ok {\n323|\t\tfailure, err := failProtocol(\"request deadline is not a timestamp\", \"deadline\")\n324|\t\tif err != nil {\n325|\t\t\treturn Request{}, err\n326|\t\t}\n327|\t\treturn Request{}, failure\n328|\t}\n329|\tbody := bytesTrimSpace(members[\"body\"])\n330|\tif _, fault := decodeStrictObject(body); fault != nil {\n331|\t\tfailure, err := failProtocol(\"request body \"+fault.detail, \"body\")\n332|\t\tif err != nil {\n333|\t\t\treturn Request{}, err\n334|\t\t}\n335|\t\treturn Request{}, failure\n336|\t}\n337|\treturn Request{Operation: Operation(operation), RequestID: requestID, Body: body}, nil\n338|}\n339|\n340|// CheckSuccessEnvelope validates one inbound success frame against\n341|// the request that caused it: one complete object within the frame\n342|// bound, the exact success members, the four identity fields echoed\n343|// exactly, ok=true, an object body, and no error member. Body and\n344|// error are disjoint, never nullable sentinels: a frame carrying\n345|// both or neither is a protocol error. The returned body is the raw\n346|// member for the operation-layer checks.\n347|func CheckSuccessEnvelope(frame []byte, want Request) ([]byte, error) {\n348|\tif len(frame) == 0 {\n349|\t\tfailure, err := failProtocol(\"success frame is empty\", \"\")\n350|\t\tif err != nil {\n351|\t\t\treturn nil, err\n352|\t\t}\n353|\t\treturn nil, failure\n354|\t}\n355|\tif len(frame) > MaxFrameBytes {\n356|\t\tfailure, err := failProtocol(\"success frame exceeds the 8 MiB bound\", \"\")\n357|\t\tif err != nil {\n358|\t\t\treturn nil, err\n359|\t\t}\n360|\t\treturn nil, failure\n361|\t}\n362|\tmembers, fault := decodeStrictObject(frame)\n363|\tif fault != nil {\n364|\t\tfailure, err := failProtocol(\"success envelope \"+fault.detail, fault.member)\n365|\t\tif err != nil {\n366|\t\t\treturn nil, err\n367|\t\t}\n368|\t\treturn nil, failure\n369|\t}\n370|\tif name, unknown := unknownMember(members, successMembers); unknown {\n371|\t\tfailure, err := failProtocol(\"success envelope carries unknown member\", name)\n372|\t\tif err != nil {\n373|\t\t\treturn nil, err\n374|\t\t}\n375|\t\treturn nil, failure\n376|\t}\n377|\tif name, missing := missingMember(members, successRequired); missing {\n378|\t\tfailure, err := failProtocol(\"success envelope misses a required member\", name)\n379|\t\tif err != nil {\n380|\t\t\treturn nil, err\n381|\t\t}\n382|\t\treturn nil, failure\n383|\t}\n384|\tif protocol, ok := rawString(members[\"protocol\"]); !ok || protocol != ProtocolID {\n385|\t\tfailure, err := failProtocol(\"success protocol does not echo the request\", \"protocol\")\n386|\t\tif err != nil {\n387|\t\t\treturn nil, err\n388|\t\t}\n389|\t\treturn nil, failure\n390|\t}\n391|\tif version, ok := rawString(members[\"protocol_version\"]); !ok || version != ProtocolVersion {\n392|\t\tfailure, err := failProtocol(\"success protocol version does not echo the request\", \"protocol_version\")\n393|\t\tif err != nil {\n394|\t\t\treturn nil, err\n395|\t\t}\n396|\t\treturn nil, failure\n397|\t}\n398|\tif requestID, ok := rawString(members[\"request_id\"]); !ok || requestID != want.RequestID {\n399|\t\tfailure, err := failProtocol(\"success request identifier does not echo the request\", \"request_id\")\n400|\t\tif err != nil {\n401|\t\t\treturn nil, err\n402|\t\t}\n403|\t\treturn nil, failure\n404|\t}\n405|\tif operation, ok := rawString(members[\"operation\"]); !ok || operation != string(want.Operation) {\n406|\t\tfailure, err := failProtocol(\"success operation does not echo the request\", \"operation\")\n407|\t\tif err != nil {\n408|\t\t\treturn nil, err\n409|\t\t}\n410|\t\treturn nil, failure\n411|\t}\n412|\tpositive, ok := rawBool(members[\"ok\"])\n413|\tif !ok || !positive {\n414|\t\tfailure, err := failProtocol(\"success envelope does not carry ok=true\", \"ok\")\n415|\t\tif err != nil {\n416|\t\t\treturn nil, err\n417|\t\t}\n418|\t\treturn nil, failure\n419|\t}\n420|\tbody := bytesTrimSpace(members[\"body\"])\n421|\tif _, fault := decodeStrictObject(body); fault != nil {\n422|\t\tfailure, err := failProtocol(\"success body \"+fault.detail, \"body\")\n423|\t\tif err != nil {\n424|\t\t\treturn nil, err\n425|\t\t}\n426|\t\treturn nil, failure\n427|\t}\n428|\treturn body, nil\n429|}\n430|\n431|// CheckFailureEnvelope validates one inbound failure frame against\n432|// the request that caused it: the exact failure members, the four\n433|// identity fields echoed exactly, ok=false, a closed error object,\n434|// and no body member. The error object itself must decode as a\n435|// Structured Error under the adapter's bound version; a failure that\n436|// cannot be read is an integrity failure, never a retryable result.\n437|func CheckFailureEnvelope(frame []byte, want Request) (*axerror.Error, error) {\n438|\tif len(frame) == 0 {\n439|\t\tfailure, err := failProtocol(\"failure frame is empty\", \"\")\n440|\t\tif err != nil {\n441|\t\t\treturn nil, err\n442|\t\t}\n443|\t\treturn nil, failure\n444|\t}\n445|\tif len(frame) > MaxFrameBytes {\n446|\t\tfailure, err := failProtocol(\"failure frame exceeds the 8 MiB bound\", \"\")\n447|\t\tif err != nil {\n448|\t\t\treturn nil, err\n449|\t\t}\n450|\t\treturn nil, failure\n451|\t}\n452|\tmembers, fault := decodeStrictObject(frame)\n453|\tif fault != nil {\n454|\t\tfailure, err := failProtocol(\"failure envelope \"+fault.detail, fault.member)\n455|\t\tif err != nil {\n456|\t\t\treturn nil, err\n457|\t\t}\n458|\t\treturn nil, failure\n459|\t}\n460|\tif name, unknown := unknownMember(members, failureMembers); unknown {\n461|\t\tfailure, err := failProtocol(\"failure envelope carries unknown member\", name)\n462|\t\tif err != nil {\n463|\t\t\treturn nil, err\n464|\t\t}\n465|\t\treturn nil, failure\n466|\t}\n467|\tif name, missing := missingMember(members, failureRequired); missing {\n468|\t\tfailure, err := failProtocol(\"failure envelope misses a required member\", name)\n469|\t\tif err != nil {\n470|\t\t\treturn nil, err\n471|\t\t}\n472|\t\treturn nil, failure\n473|\t}\n474|\tif protocol, ok := rawString(members[\"protocol\"]); !ok || protocol != ProtocolID {\n475|\t\tfailure, err := failProtocol(\"failure protocol does not echo the request\", \"protocol\")\n476|\t\tif err != nil {\n477|\t\t\treturn nil, err\n478|\t\t}\n479|\t\treturn nil, failure\n480|\t}\n481|\tif version, ok := rawString(members[\"protocol_version\"]); !ok || version != ProtocolVersion {\n482|\t\tfailure, err := failProtocol(\"failure protocol version does not echo the request\", \"protocol_version\")\n483|\t\tif err != nil {\n484|\t\t\treturn nil, err\n485|\t\t}\n486|\t\treturn nil, failure\n487|\t}\n488|\tif requestID, ok := rawString(members[\"request_id\"]); !ok || requestID != want.RequestID {\n489|\t\tfailure, err := failProtocol(\"failure request identifier does not echo the request\", \"request_id\")\n490|\t\tif err != nil {\n491|\t\t\treturn nil, err\n492|\t\t}\n493|\t\treturn nil, failure\n494|\t}\n495|\tif operation, ok := rawString(members[\"operation\"]); !ok || operation != string(want.Operation) {\n496|\t\tfailure, err := failProtocol(\"failure operation does not echo the request\", \"operation\")\n497|\t\tif err != nil {\n498|\t\t\treturn nil, err\n499|\t\t}\n500|\t\treturn nil, failure\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c40b","stream":{"kind":"session","id":"01a07545-b24a-7111-bd71-a49bf0fc5a97"},"sequence":96,"recorded_at":1780531400000187,"record_type":"event","durability":"durable","causation_id":"e61bb3fc-6388-408f-a265-e94b890e4ba1","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e61bb3fc-6388-408f-a265-e94b890e4ba1","run_stream":{"kind":"run","id":"e61bb3fc-6388-408f-a265-e94b890e4ba1"},"call_id":"call_01a07545e3f47c3394fe3641d78676cb","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/manifest.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|)\n9|\n10|// This file validates the Section 7.8 Session Adapter Manifest: the\n11|// closed urn:ax:schema:session-adapter-manifest 1.0.0 object a\n12|// manifest operation returns as its success body. The manifest\n13|// declares possible surfaces, not runtime availability; every member\n14|// below is required and the object is closed.\n15|\n16|// manifestSchema is the exact schema identifier the manifest carries.\n17|const manifestSchema = \"urn:ax:schema:session-adapter-manifest\"\n18|\n19|// manifestSchemaVersion is the only manifest version this host accepts.\n20|const manifestSchemaVersion = \"1.0.0\"\n21|\n22|// capabilityOrder is the exact fifteen-name ordered capability\n23|// registry Section 7.8 shows. The manifest and every probe body\n24|// carry exactly these names in this order; a sixteenth name\n25|// advertises a surface the contract never defined, and a missing\n26|// name hides one it did.\n27|var capabilityOrder = []string{\n28|\t\"native_discovery\",\n29|\t\"stable_snapshot\",\n30|\t\"raw_capture\",\n31|\t\"canonical_read\",\n32|\t\"canonical_write\",\n33|\t\"native_read_back\",\n34|\t\"native_resume_plan\",\n35|\t\"official_import\",\n36|\t\"same_environment_lossless_clone\",\n37|\t\"tool_history\",\n38|\t\"usage_history\",\n39|\t\"compaction_history\",\n40|\t\"subagent_graph\",\n41|\t\"opaque_reasoning_roundtrip\",\n42|\t\"workspace_binding\",\n43|}\n44|\n45|// Capabilities returns the Section 7.8 capability registry in order.\n46|// The result is a copy; the registry cannot be mutated through it.\n47|func Capabilities() []string {\n48|\treturn append([]string(nil), capabilityOrder...)\n49|}\n50|\n51|// manifestMembers is the exact required member set DecodeManifest\n52|// accepts: the schema envelope, identity, versioning, platforms, the\n53|// Section 7.8 operation registry in section order, and the\n54|// capability registry above.\n55|var manifestMembers = map[string]bool{\n56|\t\"schema\":                    true,\n57|\t\"schema_version\":            true,\n58|\t\"provider_id\":               true,\n59|\t\"environment_id\":            true,\n60|\t\"display_name\":              true,\n61|\t\"adapter_version\":           true,\n62|\t\"environment_version_range\": true,\n63|\t\"platforms\":                 true,\n64|\t\"operations\":                true,\n65|\t\"capability_names\":          true,\n66|\t\"extensions\":                true,\n67|}\n68|\n69|// manifestRequired lists manifestMembers in a fixed order so a body\n70|// missing several members always names the same one.\n71|var manifestRequired = []string{\n72|\t\"schema\",\n73|\t\"schema_version\",\n74|\t\"provider_id\",\n75|\t\"environment_id\",\n76|\t\"display_name\",\n77|\t\"adapter_version\",\n78|\t\"environment_version_range\",\n79|\t\"platforms\",\n80|\t\"operations\",\n81|\t\"capability_names\",\n82|\t\"extensions\",\n83|}\n84|\n85|// Manifest is the validated Session Adapter Manifest 1.0.0: the\n86|// provider and environment identity plus the ordered registries the\n87|// probe and dispatch layers check. The canonical body is retained\n88|// for the host-computed digest.\n89|type Manifest struct {\n90|\tProviderID     string\n91|\tEnvironmentID  string\n92|\tAdapterVersion string\n93|\tPlatforms      []string\n94|\tOperations     []string\n95|\tCapabilities   []string\n96|\tcanonical      []byte\n97|}\n98|\n99|// Canonical returns the JCS bytes the digest was computed over.\n100|func (manifest Manifest) Canonical() []byte {\n101|\treturn append([]byte(nil), manifest.canonical...)\n102|}\n103|\n104|// DecodeManifest validates one manifest-operation success body as the\n105|// closed Section 7.8 Session Adapter Manifest. A manifest whose\n106|// operations differ from the dispatch registry, or whose capability\n107|// names differ from the registry above, advertises a surface the\n108|// host cannot invoke or hides one it must, so both are refused\n109|// outright.\n110|func DecodeManifest(body []byte) (Manifest, error) {\n111|\tmembers, fault := decodeStrictObject(body)\n112|\tif fault != nil {\n113|\t\tfailure, err := failProtocol(\"adapter manifest \"+fault.detail, fault.member)\n114|\t\tif err != nil {\n115|\t\t\treturn Manifest{}, err\n116|\t\t}\n117|\t\treturn Manifest{}, failure\n118|\t}\n119|\tif name, unknown := unknownMember(members, manifestMembers); unknown {\n120|\t\tfailure, err := failProtocol(\"adapter manifest carries unknown member\", name)\n121|\t\tif err != nil {\n122|\t\t\treturn Manifest{}, err\n123|\t\t}\n124|\t\treturn Manifest{}, failure\n125|\t}\n126|\tif name, missing := missingMember(members, manifestRequired); missing {\n127|\t\tfailure, err := failProtocol(\"adapter manifest misses a required member\", name)\n128|\t\tif err != nil {\n129|\t\t\treturn Manifest{}, err\n130|\t\t}\n131|\t\treturn Manifest{}, failure\n132|\t}\n133|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != manifestSchema {\n134|\t\tfailure, err := failProtocol(\"adapter manifest schema is not the session adapter manifest\", \"schema\")\n135|\t\tif err != nil {\n136|\t\t\treturn Manifest{}, err\n137|\t\t}\n138|\t\treturn Manifest{}, failure\n139|\t}\n140|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != manifestSchemaVersion {\n141|\t\tfailure, err := failProtocol(\"adapter manifest version is not 1.0.0\", \"schema_version\")\n142|\t\tif err != nil {\n143|\t\t\treturn Manifest{}, err\n144|\t\t}\n145|\t\treturn Manifest{}, failure\n146|\t}\n147|\tproviderID, ok := rawString(members[\"provider_id\"])\n148|\tif !ok || !providerIDPattern.MatchString(providerID) {\n149|\t\tfailure, err := failProtocol(\"adapter manifest provider identifier is not a provider-id\", \"provider_id\")\n150|\t\tif err != nil {\n151|\t\t\treturn Manifest{}, err\n152|\t\t}\n153|\t\treturn Manifest{}, failure\n154|\t}\n155|\tenvironmentID, ok := rawString(members[\"environment_id\"])\n156|\tif !ok || !environmentIDPattern.MatchString(environmentID) {\n157|\t\tfailure, err := failProtocol(\"adapter manifest environment identifier is not an environment-id\", \"environment_id\")\n158|\t\tif err != nil {\n159|\t\t\treturn Manifest{}, err\n160|\t\t}\n161|\t\treturn Manifest{}, failure\n162|\t}\n163|\tif _, ok := checkStringBounds(members[\"display_name\"], 1, 128); !ok {\n164|\t\tfailure, err := failProtocol(\"adapter manifest display name is not a string[1..128]\", \"display_name\")\n165|\t\tif err != nil {\n166|\t\t\treturn Manifest{}, err\n167|\t\t}\n168|\t\treturn Manifest{}, failure\n169|\t}\n170|\tadapterVersion, ok := rawString(members[\"adapter_version\"])\n171|\tif !ok || !semverPattern.MatchString(adapterVersion) {\n172|\t\tfailure, err := failProtocol(\"adapter manifest adapter version is not SemVer\", \"adapter_version\")\n173|\t\tif err != nil {\n174|\t\t\treturn Manifest{}, err\n175|\t\t}\n176|\t\treturn Manifest{}, failure\n177|\t}\n178|\tif _, ok := checkStringBounds(members[\"environment_version_range\"], 1, 256); !ok {\n179|\t\tfailure, err := failProtocol(\"adapter manifest environment version range is not a non-empty string[1..256]\", \"environment_version_range\")\n180|\t\tif err != nil {\n181|\t\t\treturn Manifest{}, err\n182|\t\t}\n183|\t\treturn Manifest{}, failure\n184|\t}\n185|\tplatforms, ok := checkSortedUniqueStrings(members[\"platforms\"], 1, 16, 1, 4)\n186|\tif !ok {\n187|\t\tfailure, err := failProtocol(\"adapter manifest platforms are not a sorted unique non-empty subset\", \"platforms\")\n188|\t\tif err != nil {\n189|\t\t\treturn Manifest{}, err\n190|\t\t}\n191|\t\treturn Manifest{}, failure\n192|\t}\n193|\tfor _, platform := range platforms {\n194|\t\tif _, err := scalar.ParsePlatform(platform); err != nil {\n195|\t\t\tfailure, faultErr := failProtocol(\"adapter manifest platform is outside linux|macos|windows|wsl2\", \"platforms\")\n196|\t\t\tif faultErr != nil {\n197|\t\t\t\treturn Manifest{}, faultErr\n198|\t\t\t}\n199|\t\t\treturn Manifest{}, failure\n200|\t\t}\n201|\t}\n202|\toperations, ok := checkOperationRegistry(members[\"operations\"])\n203|\tif !ok {\n204|\t\tfailure, err := failProtocol(\"adapter manifest operations are not the complete ordered fourteen-name registry\", \"operations\")\n205|\t\tif err != nil {\n206|\t\t\treturn Manifest{}, err\n207|\t\t}\n208|\t\treturn Manifest{}, failure\n209|\t}\n210|\tcapabilities, ok := checkCapabilityRegistry(members[\"capability_names\"])\n211|\tif !ok {\n212|\t\tfailure, err := failProtocol(\"adapter manifest capability names are not the complete ordered fifteen-name registry\", \"capability_names\")\n213|\t\tif err != nil {\n214|\t\t\treturn Manifest{}, err\n215|\t\t}\n216|\t\treturn Manifest{}, failure\n217|\t}\n218|\tif !checkExtensions(members[\"extensions\"]) {\n219|\t\tfailure, err := failProtocol(\"adapter manifest extensions are not reverse-DNS keyed\", \"extensions\")\n220|\t\tif err != nil {\n221|\t\t\treturn Manifest{}, err\n222|\t\t}\n223|\t\treturn Manifest{}, failure\n224|\t}\n225|\tcanonical, err := canonicaljson.Canonicalize(body)\n226|\tif err != nil {\n227|\t\tfailure, faultErr := failProtocol(\"adapter manifest is not canonical JSON\", \"\")\n228|\t\tif faultErr != nil {\n229|\t\t\treturn Manifest{}, faultErr\n230|\t\t}\n231|\t\treturn Manifest{}, failure\n232|\t}\n233|\treturn Manifest{\n234|\t\tProviderID:     providerID,\n235|\t\tEnvironmentID:  environmentID,\n236|\t\tAdapterVersion: adapterVersion,\n237|\t\tPlatforms:      platforms,\n238|\t\tOperations:     operations,\n239|\t\tCapabilities:   capabilities,\n240|\t\tcanonical:      canonical,\n241|\t}, nil\n242|}\n243|\n244|// checkOperationRegistry reports whether the member is exactly the\n245|// dispatch registry in section order: same names, same positions,\n246|// same length. Sortedness is not the rule here — order is — so the\n247|// comparison is element-wise against operationOrder.\n248|func checkOperationRegistry(raw json.RawMessage) ([]string, bool) {\n249|\telements, ok := decodeArray(raw)\n250|\tif !ok || len(elements) != len(operationOrder) {\n251|\t\treturn nil, false\n252|\t}\n253|\toperations := make([]string, 0, len(elements))\n254|\tfor index, element := range elements {\n255|\t\tname, ok := rawString(element)\n256|\t\tif !ok || name != string(operationOrder[index]) {\n257|\t\t\treturn nil, false\n258|\t\t}\n259|\t\toperations = append(operations, name)\n260|\t}\n261|\treturn operations, true\n262|}\n263|\n264|// checkCapabilityRegistry reports whether the member is exactly the\n265|// fifteen-name capability registry in section order.\n266|func checkCapabilityRegistry(raw json.RawMessage) ([]string, bool) {\n267|\telements, ok := decodeArray(raw)\n268|\tif !ok || len(elements) != len(capabilityOrder) {\n269|\t\treturn nil, false\n270|\t}\n271|\tcapabilities := make([]string, 0, len(elements))\n272|\tfor index, element := range elements {\n273|\t\tname, ok := rawString(element)\n274|\t\tif !ok || name != capabilityOrder[index] {\n275|\t\t\treturn nil, false\n276|\t\t}\n277|\t\tcapabilities = append(capabilities, name)\n278|\t}\n279|\treturn capabilities, true\n280|}\n281|\n282|// ManifestDigest returns the host-computed JCS SHA-256 of the\n283|// validated manifest: the session_adapter_manifest_digest. It is\n284|// computed by the host, never embedded by the adapter, so a\n285|// manifest that names its own digest cannot mint trust.\n286|func ManifestDigest(manifest Manifest) scalar.Digest {\n287|\treturn scalar.SHA256Digest(manifest.canonical)\n288|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
