put.Reset()\\n\\terr := run([]string{\\\"-root\\\", t.TempDir()}, &output)\\n\\tif err == nil || !strings.Contains(err.Error(), \\\"read required evidence\\\") {\\n\\t\\tt.Fatalf(\\\"run(missing repository) error = %v, want required-evidence refusal\\\", err)\\n\\t}\\n\\tif output.Len() != 0 {\\n\\t\\tt.Fatalf(\\\"failed run emitted success output %q\\\", output.String())\\n\\t}\\n\\n\\tif err := run([]string{\\\"unexpected\\\"}, &output); err == nil {\\n\\t\\tt.Fatal(\\\"run(positional argument) error = nil, want refusal\\\")\\n\\t}\\n\\tif err := run([]string{\\\"-unknown\\\"}, io.Discard); err == nil {\\n\\t\\tt.Fatal(\\\"run(unknown flag) error = nil, want refusal\\\")\\n\\t}\\n\\n\\twriteErr := errors.New(\\\"write failed\\\")\\n\\terr = run([]string{\\\"-root\\\", repositoryRoot}, failingWriter{err: writeErr})\\n\\tif !errors.Is(err, writeErr) {\\n\\t\\tt.Fatalf(\\\"run(failing writer) error = %v, want %v\\\", err, writeErr)\\n\\t}\\n\\n\\toutput.Reset()\\n\\terr = run([]string{\\\"-root\\\", repositoryRoot, \\\"-section\\\", \\\"6.2\\\"}, &output)\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"run(assigned sections) error = %v\\\", err)\\n\\t}\\n\\twant = \\\"traceability ok: contracts=60 normative_sections=36 acceptance_cases=88 fixtures=30 compatibility_contracts=55 assigned_scopes=1\\\\n\\\" +\\n\\t\\t\\\"section coverage: bindings=53 full=1 partial=3 sliver=1 unevidenced=45 unmeasured=3 unowned=2 clauses_discharged=17/428\\\\n\\\"\\n\\tif output.String() != want {\\n===README sessadapter===\\n579:statement of it is the Session Adapter Manifest row of a different schema, and\\n585:SemVer word on `adapter_version` belongs to the Session Adapter Manifest row of\\n2161:The Session Adapter host surface lives in\\n2162:[`internal/sessadapter`](internal/sessadapter): discovery binding\\n\",\n  \"original_output_bytes\": 2412,\n  \"original_output_tokens\": 603,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
