5|        },\n356|        {\n357|          \"path\": \"internal/config/migration_test.go\",\n358|          \"declaration\": \"TestAssessCompatibilityRefusesMalformedEnvelopeFacts\"\n359|        },\n360|        {\n361|          \"path\": \"internal/config/migration_test.go\",\n362|          \"declaration\": \"TestAssessCompatibilityPinsEveryPinnedVersionPairAtTheProductionEntry\"\n363|        }\n364|      ]\n365|    },\n366|    {\n367|      \"id\": \"catalog-v050-exact\",\n368|      \"production\": {\n369|        \"path\": \"internal/catalog/catalog.go\",\n370|        \"declaration\": \"Current\"\n371|      },\n372|      \"tests\": [\n373|        {\n374|          \"path\": \"internal/catalog/catalog_test.go\",\n375|          \"declaration\": \"TestCurrentMatchesReviewedV050Catalog\"\n376|        }\n377|      ]\n378|    },\n379|    {\n380|      \"id\": \"catalog-v043-compatibility\",\n381|      \"production\": {\n382|        \"path\": \"internal/catalog/catalog.go\",\n383|        \"declaration\": \"ForRelease\"\n384|      },\n385|      \"tests\": [\n386|        {\n387|          \"path\": \"internal/catalog/catalog_test.go\",\n388|          \"declaration\": \"TestV043CompatibilityProjection\"\n389|        }\n390|      ]\n391|    },\n392|    {\n393|      \"id\": \"catalog-traceability-refusal\",\n394|      \"production\": {\n395|        \"path\": \"internal/cataloggen/generate.go\",\n396|        \"declaration\": \"Generate\"\n397|      },\n398|      \"tests\": [\n399|        {\n400|          \"path\": \"internal/catalog/catalog_test.go\",\n401|          \"declaration\": \"TestTraceabilityMatchesReviewedSourceAnchors\"\n402|        },\n403|        {\n404|          \"path\": \"internal/cataloggen/generate_test.go\",\n405|          \"declaration\": \"TestGenerateRejectsForgedNonEmptyTraceability\"\n406|        }\n407|      ]\n408|    },\n409|    {\n410|      \"id\": \"catalog-durable-recovery\",\n411|      \"production\": {\n412|        \"path\": \"internal/catalog/catalog