{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c62f","stream":{"kind":"session","id":"01a07573-a73b-7be0-abe2-6029bca74ffd"},"sequence":370,"recorded_at":1780531400000735,"record_type":"event","durability":"durable","causation_id":"65c281d8-14aa-4def-b705-62e70b4fce66","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"65c281d8-14aa-4def-b705-62e70b4fce66","run_stream":{"kind":"run","id":"65c281d8-14aa-4def-b705-62e70b4fce66"},"task_stream":{"kind":"task","id":"29f340fe-aa06-4cd1-9cc9-1662614b0f54"},"task_id":"29f340fe-aa06-4cd1-9cc9-1662614b0f54","event":{"kind":"output","task_id":"29f340fe-aa06-4cd1-9cc9-1662614b0f54","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/dirnode/inventory_test.go`.\n1|package dirnode\n2|\n3|import (\n4|\t\"os\"\n5|\t\"path/filepath\"\n6|\t\"sort\"\n7|\t\"strconv\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n12|)\n13|\n14|// This file derives the closed registries from the pinned\n15|// specification text rather than listing them: a dropped, added,\n16|// or reordered registry member reddens here rather than passing\n17|// silently. Every derivation fails closed — an empty scan, a\n18|// missing window, or an ambiguous marker is a test failure, never\n19|// a vacuous pass — because a domain that silently derives nothing\n20|// is not a measurement.\n21|//\n22|// The refusal-arm inventory lives in census_test.go; the import\n23|// census pinning the identifier match lives below.\n24|\n25|// specText loads the pinned document bytes the derivations scan.\n26|// specdoc.Load verifies the digest first, so a substituted,\n27|// truncated, or partially read document is refused instead of\n28|// being silently compared against.\n29|func specText(t *testing.T) string {\n30|\tt.Helper()\n31|\tif _, err := specdoc.Load(); err != nil {\n32|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n33|\t}\n34|\treturn string(specdoc.Bytes())\n35|}\n36|\n37|// specWindow returns the document text between the marker and the\n38|// terminator. Both must be present exactly once and in order;\n39|// otherwise the window is untrusted and the derivation fails\n40|// closed.\n41|func specWindow(t *testing.T, text, marker, terminator string) string {\n42|\tt.Helper()\n43|\tif strings.Count(text, marker) != 1 {\n44|\t\tt.Fatalf(\"marker %q occurs %d times, want exactly once\", marker, strings.Count(text, marker))\n45|\t}\n46|\tif strings.Count(text, terminator) != 1 {\n47|\t\tt.Fatalf(\"terminator %q occurs %d times, want exactly once\", terminator, strings.Count(text, terminator))\n48|\t}\n49|\tstart := strings.Index(text, marker)\n50|\tend := strings.Index(text, terminator)\n51|\tif start >= end {\n52|\t\tt.Fatalf(\"marker %q does not precede terminator %q\", marker, terminator)\n53|\t}\n54|\treturn text[start:end]\n55|}\n56|\n57|// specCodeTokens extracts every <code>...</code> token from the\n58|// window in order. An empty extraction fails closed.\n59|func specCodeTokens(t *testing.T, window string) []string {\n60|\tt.Helper()\n61|\tvar tokens []string\n62|\tfor {\n63|\t\topen := strings.Index(window, \"<code>\")\n64|\t\tif open < 0 {\n65|\t\t\tbreak\n66|\t\t}\n67|\t\trest := window[open+len(\"<code>\"):]\n68|\t\tclose := strings.Index(rest, \"</code>\")\n69|\t\tif close < 0 {\n70|\t\t\tt.Fatal(\"unbalanced <code> span in spec window\")\n71|\t\t}\n72|\t\ttokens = append(tokens, rest[:close])\n73|\t\twindow = rest[close+len(\"</code>\"):]\n74|\t}\n75|\tif len(tokens) == 0 {\n76|\t\tt.Fatal(\"derived zero code tokens; the scan is broken, not the registry\")\n77|\t}\n78|\treturn tokens\n79|}\n80|\n81|// TestOperationRegistryDerivedFromSpec requires the production\n82|// dispatch registry to equal the Section 7.9 operation table in\n83|// order: every table row appears in production at the same\n84|// position, and nothing else does.\n85|func TestOperationRegistryDerivedFromSpec(t *testing.T) {\n86|\ttext := specText(t)\n87|\ttable := specWindow(t, text, \"The exact operation registry and bodies are:\", \"Each displayed body is closed\")\n88|\tvar operations []string\n89|\tfor _, line := range strings.Split(table, \"\\n\") {\n90|\t\tif !strings.HasPrefix(line, \"| <code>\") {\n91|\t\t\tcontinue\n92|\t\t}\n93|\t\tcells := strings.Split(line, \"|\")\n94|\t\tif len(cells) < 2 {\n95|\t\t\tt.Fatalf(\"malformed table row %q\", line)\n96|\t\t}\n97|\t\tname := strings.TrimSpace(cells[1])\n98|\t\tname = strings.TrimPrefix(name, \"<code>\")\n99|\t\tname = strings.TrimSuffix(name, \"</code>\")\n100|\t\tif !validOperation(name) {\n(more lines below)"}}}
