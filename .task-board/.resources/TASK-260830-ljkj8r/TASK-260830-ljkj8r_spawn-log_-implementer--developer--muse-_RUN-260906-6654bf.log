{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c485","stream":{"kind":"session","id":"01a07573-a73b-7be0-abe2-6029bca74ffd"},"sequence":157,"recorded_at":1780531400000309,"record_type":"event","durability":"durable","causation_id":"65c281d8-14aa-4def-b705-62e70b4fce66","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"65c281d8-14aa-4def-b705-62e70b4fce66","run_stream":{"kind":"run","id":"65c281d8-14aa-4def-b705-62e70b4fce66"},"task_stream":{"kind":"task","id":"1f645442-95ef-464c-989c-5bb55e8e0c89"},"task_id":"1f645442-95ef-464c-989c-5bb55e8e0c89","event":{"kind":"output","task_id":"1f645442-95ef-464c-989c-5bb55e8e0c89","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/dirnode/query.go`.\n1|package dirnode\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"regexp\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|)\n9|\n10|// This file validates the Section 10.8.5 Session Directory Query:\n11|// the closed request envelope, the caller context shape, the\n12|// seventeen-operation registry with its name-matched parameter\n13|// union, the field/preset projection rules, the read/mutation flag\n14|// rules, and the cursor binding.\n15|//\n16|// The parser rejects the whole batch before execution on unknown\n17|// syntax, operation, parameter, field, preset, filter, sort key, or\n18|// bound: every check below runs before any operation is admitted,\n19|// and DecodeQuery returns either a fully validated batch or one\n20|// refusal. CallerContext is shape-checked here and authenticated\n21|// server-side by the caller; it is never accepted from an\n22|// unverified body alone.\n23|\n24|const (\n25|\t// QuerySchema is the exact schema member a directory query\n26|\t// carries.\n27|\tQuerySchema = \"urn:ax:schema:session-directory-query\"\n28|\t// QuerySchemaVersion is the only query schema_version this\n29|\t// host accepts.\n30|\tQuerySchemaVersion = \"1.0.0\"\n31|)\n32|\n33|// queryMembers is the exact Session Directory Query member set.\n34|var queryMembers = map[string]bool{\n35|\t\"schema\":         true,\n36|\t\"schema_version\": true,\n37|\t\"query_id\":       true,\n38|\t\"operations\":     true,\n39|\t\"caller\":         true,\n40|\t\"extensions\":     true,\n41|}\n42|\n43|// queryRequired lists queryMembers in a fixed order.\n44|var queryRequired = []string{\n45|\t\"schema\",\n46|\t\"schema_version\",\n47|\t\"query_id\",\n48|\t\"operations\",\n49|\t\"caller\",\n50|\t\"extensions\",\n51|}\n52|\n53|// callerMembers is the exact CallerContext member set.\n54|var callerMembers = map[string]bool{\n55|\t\"caller_id\":                true,\n56|\t\"authentication_subject\":   true,\n57|\t\"origin_host_id\":           true,\n58|\t\"interaction\":              true,\n59|\t\"scopes\":                   true,\n60|\t\"disclosure_policy_digest\": true,\n61|\t\"extensions\":               true,\n62|}\n63|\n64|// callerRequired lists callerMembers in a fixed order.\n65|var callerRequired = []string{\n66|\t\"caller_id\",\n67|\t\"authentication_subject\",\n68|\t\"origin_host_id\",\n69|\t\"interaction\",\n70|\t\"scopes\",\n71|\t\"disclosure_policy_digest\",\n72|\t\"extensions\",\n73|}\n74|\n75|// operationMembers is the exact QueryOperation member set.\n76|var operationMembers = map[string]bool{\n77|\t\"operation_index\":    true,\n78|\t\"name\":               true,\n79|\t\"parameters\":         true,\n80|\t\"fields\":             true,\n81|\t\"preset\":             true,\n82|\t\"skip\":               true,\n83|\t\"take\":               true,\n84|\t\"sort\":               true,\n85|\t\"dry_run\":            true,\n86|\t\"confirm\":            true,\n87|\t\"expectation_digest\": true,\n88|\t\"idempotency_key\":    true,\n89|\t\"extensions\":         true,\n90|}\n91|\n92|// operationRequired lists operationMembers in a fixed order.\n93|var operationRequired = []string{\n94|\t\"operation_index\",\n95|\t\"name\",\n96|\t\"parameters\",\n97|\t\"fields\",\n98|\t\"preset\",\n99|\t\"skip\",\n100|\t\"take\",\n101|\t\"sort\",\n102|\t\"dry_run\",\n103|\t\"confirm\",\n104|\t\"expectation_digest\",\n105|\t\"idempotency_key\",\n106|\t\"extensions\",\n107|}\n108|\n109|// filterMembers is the exact DirectoryFilters member set.\n110|var filterMembers = map[string]bool{\n111|\t\"kinds\":             true,\n112|\t\"lineage_anchors\":   true,\n113|\t\"provider_ids\":      true,\n114|\t\"host_ids\":          true,\n115|\t\"workspace_ids\":     true,\n116|\t\"states\":            true,\n117|\t\"management_states\": true,\n118|\t\"reachability\":      true,\n119|\t\"freshness\":         true,\n120|\t\"warnings\":          true,\n121|\t\"updated_before\":    true,\n122|\t\"updated_after\":     true,\n123|\t\"extensions\":        true,\n124|}\n125|\n126|// filterRequired lists filterMembers in a fixed order.\n127|var filterRequired = []string{\n128|\t\"kinds\",\n129|\t\"lineage_anchors\",\n130|\t\"provider_ids\",\n131|\t\"host_ids\",\n132|\t\"workspace_ids\",\n133|\t\"states\",\n134|\t\"management_states\",\n135|\t\"reachability\",\n136|\t\"freshness\",\n137|\t\"warnings\",\n138|\t\"updated_before\",\n139|\t\"updated_after\",\n140|\t\"extensions\",\n141|}\n142|\n143|// sortMembers is the exact QuerySort member set.\n144|var sortMembers = map[string]bool{\n145|\t\"field\":      true,\n146|\t\"direction\":  true,\n147|\t\"extensions\": true,\n148|}\n149|\n150|// sortRequired lists sortMembers in a fixed order.\n151|var sortRequired = []string{\n152|\t\"field\",\n153|\t\"direction\",\n154|\t\"extensions\",\n155|}\n156|\n157|// readOperations is the closed read registry of Section 10.8.5 in\n158|// the section's listed order.\n159|var readOperations = []string{\n160|\t\"schema\",\n161|\t\"sessions\",\n162|\t\"session\",\n163|\t\"lineage\",\n164|\t\"hosts\",\n165|\t\"environments\",\n166|\t\"jobs\",\n167|\t\"plans\",\n168|\t\"count\",\n169|\t\"distinct\",\n170|\t\"directory_summary\",\n171|}\n172|\n173|// mutationOperations is the closed mutation registry in the\n174|// section's listed order.\n175|var mutationOperations = []string{\n176|\t\"set_title\",\n177|\t\"set_tags\",\n178|\t\"set_pin\",\n179|\t\"enrich\",\n180|\t\"plan_continue\",\n181|\t\"execute_plan\",\n182|}\n183|\n184|// queryOperationKind names which half of the registry an operation\n185|// belongs to. Reads and mutations carry different flag,\n186|// projection, and pagination rules.\n187|type queryOperationKind string\n188|\n189|const (\n190|\tqueryKindRead     queryOperationKind = \"read\"\n191|\tqueryKindMutation queryOperationKind = \"mutation\"\n192|)\n193|\n194|// queryOperationKindOf reports the registry half a name belongs to.\n195|// Both registries are table loops so the census derives them: an\n196|// inline chain would hide a widened vocabulary from the inventory.\n197|func queryOperationKindOf(name string) (queryOperationKind, bool) {\n198|\tfor _, allowed := range readOperations {\n199|\t\tif name == allowed {\n200|\t\t\treturn queryKindRead, true\n201|\t\t}\n202|\t}\n203|\tfor _, allowed := range mutationOperations {\n204|\t\tif name == allowed {\n205|\t\t\treturn queryKindMutation, true\n206|\t\t}\n207|\t}\n208|\treturn \"\", false\n209|}\n210|\n211|// listOperations names the read operations that may use nonzero\n212|// skip or take other than 1: the entity-listing reads. The\n213|// singular, schema, and aggregate reads require skip=0 and take=1.\n214|// The section states the rule without enumerating the set, so the\n215|// choice is recorded here: schema, session, count, distinct, and\n216|// directory_summary address one object, one registry, or one number\n217|// and have no list to page. A different reading would move lineage\n218|// or distinct across the line; the refusal detail names the\n219|// operation either way.\n220|var listOperations = []string{\n221|\t\"sessions\",\n222|\t\"lineage\",\n223|\t\"hosts\",\n224|\t\"environments\",\n225|\t\"jobs\",\n226|\t\"plans\",\n227|}\n228|\n229|// isListOperation reports whether the read operation pages a list.\n230|func isListOperation(name string) bool {\n231|\tfor _, allowed := range listOperations {\n232|\t\tif name == allowed {\n233|\t\t\treturn true\n234|\t\t}\n235|\t}\n236|\treturn false\n237|}\n238|\n239|// annotationMutations names the mutations that require an\n240|// expectation digest and idempotency key when confirmed.\n241|var annotationMutations = []string{\n242|\t\"set_title\",\n243|\t\"set_tags\",\n244|\t\"set_pin\",\n245|}\n246|\n247|// isAnnotationMutation reports whether the mutation is an\n248|// annotation mutation.\n249|func isAnnotationMutation(name string) bool {\n250|\tfor _, allowed := range annotationMutations {\n251|\t\tif name == allowed {\n252|\t\t\treturn true\n253|\t\t}\n254|\t}\n255|\treturn false\n256|}\n257|\n258|// queryParameterMembers maps each operation to its exact\n259|// parameters member set in Section 10.8.5 table order. The schema\n260|// and directory_summary bodies carry extensions only: there is no\n261|// untyped parameter bag.\n262|var queryParameterMembers = map[string][]string{\n263|\t\"schema\":            {\"extensions\"},\n264|\t\"directory_summary\": {\"extensions\"},\n265|\t\"sessions\":          {\"filters\", \"extensions\"},\n266|\t\"count\":             {\"filters\", \"extensions\"},\n267|\t\"session\":           {\"subject_kind\", \"subject_id\", \"extensions\"},\n268|\t\"lineage\":           {\"anchor_id\", \"include_suggestions\", \"extensions\"},\n269|\t\"hosts\":             {\"host_ids\", \"reachable\", \"extensions\"},\n270|\t\"environments\":      {\"host_ids\", \"environment_ids\", \"authentication_status\", \"extensions\"},\n271|\t\"jobs\":              {\"job_ids\", \"profile_ids\", \"states\", \"extensions\"},\n272|\t\"plans\":             {\"plan_ids\", \"operation_ids\", \"include_expired\", \"extensions\"},\n273|\t\"distinct\":          {\"field\", \"filters\", \"extensions\"},\n274|\t\"set_title\":         {\"subject_kind\", \"subject_id\", \"title\", \"supersedes_annotation_ids\", \"extensions\"},\n275|\t\"set_tags\":          {\"subject_kind\", \"subject_id\", \"tags\", \"supersedes_annotation_ids\", \"extensions\"},\n276|\t\"set_pin\":           {\"subject_kind\", \"subject_id\", \"value\", \"supersedes_annotation_ids\", \"extensions\"},\n277|\t\"enrich\":            {\"subject_kind\", \"subject_id\", \"profile_id\", \"kinds\", \"expected_head_digest\", \"extensions\"},\n278|\t\"plan_continue\":     {\"subject_kind\", \"subject_id\", \"source_instance_id\", \"to_host_id\", \"to_installation_id\", \"intent\", \"workspace_policy\", \"source_after_success\", \"extensions\"},\n279|\t\"execute_plan\":      {\"plan_id\", \"operation_id\", \"confirmations\", \"extensions\"},\n280|}\n281|\n282|// queryFields is the closed directory-field registry: the\n283|// twenty-four projection fields plus the three explicitly lazy\n284|// ones. Fields and presets apply only to the projecting reads;\n285|// other operations require both null.\n286|var queryFields = []string{\n287|\t\"id\",\n288|\t\"kind\",\n289|\t\"lineage_anchor\",\n290|\t\"management_state\",\n291|\t\"display_title\",\n292|\t\"title_source\",\n293|\t\"provider\",\n294|\t\"host\",\n295|\t\"workspace\",\n296|\t\"state\",\n297|\t\"owner\",\n298|\t\"local_role\",\n299|\t\"updated_at\",\n300|\t\"summary\",\n301|\t\"recent_activity\",\n302|\t\"last_user_intent\",\n303|\t\"open_loops\",\n304|\t\"annotation_freshness\",\n305|\t\"inventory_freshness\",\n306|\t\"reachability\",\n307|\t\"branch_count\",\n308|\t\"clone_count\",\n309|\t\"warnings\",\n310|\t\"available_intents\",\n311|\t\"lineage_graph\",\n312|\t\"live_runtime\",\n313|\t\"preview\",\n314|}\n315|\n316|// validQueryField reports whether the field is a registry member.\n317|func validQueryField(field string) bool {\n318|\tfor _, allowed := range queryFields {\n319|\t\tif field == allowed {\n320|\t\t\treturn true\n321|\t\t}\n322|\t}\n323|\treturn false\n324|}\n325|\n326|// queryPresets is the closed preset registry.\n327|var queryPresets = []string{\n328|\t\"minimal\",\n329|\t\"overview\",\n330|\t\"activity\",\n331|\t\"routing\",\n332|\t\"full\",\n333|}\n334|\n335|// validQueryPreset reports whether the preset is a registry member.\n336|func validQueryPreset(preset string) bool {\n337|\tfor _, allowed := range queryPresets {\n338|\t\tif preset == allowed {\n339|\t\t\treturn true\n340|\t\t}\n341|\t}\n342|\treturn false\n343|}\n344|\n345|// querySortFields is the closed QuerySort field registry.\n346|var querySortFields = []string{\n347|\t\"display_title\",\n348|\t\"provider\",\n349|\t\"host\",\n350|\t\"workspace\",\n351|\t\"state\",\n352|\t\"updated_at\",\n353|\t\"annotation_freshness\",\n354|\t\"inventory_freshness\",\n355|\t\"reachability\",\n356|\t\"stable_id\",\n357|}\n358|\n359|// queryScopes is the closed CallerContext scope registry.\n360|var queryScopes = []string{\n361|\t\"directory.read\",\n362|\t\"directory.preview\",\n363|\t\"directory.mutate\",\n364|\t\"directory.execute\",\n365|\t\"directory.admin\",\n366|}\n367|\n368|// providerIDPattern is the provider-id grammar:\n369|// [a-z][a-z0-9-]{0,31}.\n370|var providerIDPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,31}$`)\n371|\n372|// CallerContext is one validated query caller: the shape-checked\n373|// identity the caller authenticates server-side.\n374|type CallerContext struct {\n375|\tCallerID         string\n376|\tAuthSubject      string\n377|\tOriginHostID     string\n378|\tInteraction      string\n379|\tScopes           []string\n380|\tDisclosurePolicy string\n381|}\n382|\n383|// QueryOperation is one validated batch operation: its position,\n384|// registry name, and half.\n385|type QueryOperation struct {\n386|\tIndex int\n387|\tName  string\n388|\tKind  queryOperationKind\n389|}\n390|\n391|// Query is one validated Session Directory Query: the batch\n392|// identifier, the position-indexed operations, and the caller.\n393|type Query struct {\n394|\tQueryID    string\n395|\tOperations []QueryOperation\n396|\tCaller     CallerContext\n397|}\n398|\n399|// DecodeQuery validates one Session Directory Query body as the\n400|// closed Section 10.8.5 contract and rejects the whole batch\n401|// before execution on the first defect: unknown syntax, operation,\n402|// parameter, field, preset, filter, sort key, or bound. For a\n403|// batch of N operations each operation_index must equal its\n404|// zero-based array position; duplicate, sparse, reordered, or\n405|// position-mismatched indexes invalidate the whole query.\n406|func DecodeQuery(body []byte) (Query, error) {\n407|\tmembers, fault := decodeStrictObject(bytesTrimSpace(body))\n408|\tif fault != nil {\n409|\t\tfailure, err := failQuery(\"directory query \"+fault.detail, fault.member)\n410|\t\tif err != nil {\n411|\t\t\treturn Query{}, err\n412|\t\t}\n413|\t\treturn Query{}, failure\n414|\t}\n415|\tif name, unknown := unknownMember(members, queryMembers); unknown {\n416|\t\tfailure, err := failQuery(\"directory query carries unknown member\", name)\n417|\t\tif err != nil {\n418|\t\t\treturn Query{}, err\n419|\t\t}\n420|\t\treturn Query{}, failure\n421|\t}\n422|\tif name, missing := missingMember(members, queryRequired); missing {\n423|\t\tfailure, err := failQuery(\"directory query misses a required member\", name)\n424|\t\tif err != nil {\n425|\t\t\treturn Query{}, err\n426|\t\t}\n427|\t\treturn Query{}, failure\n428|\t}\n429|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != QuerySchema {\n430|\t\tfailure, err := failQuery(\"directory query schema is not the session directory query\", \"schema\")\n431|\t\tif err != nil {\n432|\t\t\treturn Query{}, err\n433|\t\t}\n434|\t\treturn Query{}, failure\n435|\t}\n436|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != QuerySchemaVersion {\n437|\t\tfailure, err := failQuery(\"directory query version is not 1.0.0\", \"schema_version\")\n438|\t\tif err != nil {\n439|\t\t\treturn Query{}, err\n440|\t\t}\n441|\t\treturn Query{}, failure\n442|\t}\n443|\tqueryID, ok := checkUUIDv7(members[\"query_id\"])\n444|\tif !ok {\n445|\t\tfailure, err := failQuery(\"directory query identifier is not a UUIDv7\", \"query_id\")\n446|\t\tif err != nil {\n447|\t\t\treturn Query{}, err\n448|\t\t}\n449|\t\treturn Query{}, failure\n450|\t}\n451|\telements, ok := decodeArray(members[\"operations\"])\n452|\tif !ok || len(elements) < 1 || len(elements) > 64 {\n453|\t\tfailure, err := failQuery(\"directory query operations are not QueryOperation[1..64]\", \"operations\")\n454|\t\tif err != nil {\n455|\t\t\treturn Query{}, err\n456|\t\t}\n457|\t\treturn Query{}, failure\n458|\t}\n459|\tcaller, ok := checkCaller(members[\"caller\"])\n460|\tif !ok {\n461|\t\tfailure, err := failQuery(\"directory query caller is not a closed CallerContext\", \"caller\")\n462|\t\tif err != nil {\n463|\t\t\treturn Query{}, err\n464|\t\t}\n465|\t\treturn Query{}, failure\n466|\t}\n467|\tif !checkExtensions(members[\"extensions\"]) {\n468|\t\tfailure, err := failQuery(\"directory query extensions are not reverse-DNS keyed\", \"extensions\")\n469|\t\tif err != nil {\n470|\t\t\treturn Query{}, err\n471|\t\t}\n472|\t\treturn Query{}, failure\n473|\t}\n474|\toperations := make([]QueryOperation, 0, len(elements))\n475|\tfor position, element := range elements {\n476|\t\toperation, ok := checkQueryOperation(element, position)\n477|\t\tif !ok {\n478|\t\t\tfailure, err := failQuery(\"directory query operation is not a closed QueryOperation\", \"operations\")\n479|\t\t\tif err != nil {\n480|\t\t\t\treturn Query{}, err\n481|\t\t\t}\n482|\t\t\treturn Query{}, failure\n483|\t\t}\n484|\t\toperations = append(operations, operation)\n485|\t}\n486|\treturn Query{QueryID: queryID.String(), Operations: operations, Caller: caller}, nil\n487|}\n488|\n489|// checkCaller validates one CallerContext object.\n490|func checkCaller(raw json.RawMessage) (CallerContext, bool) {\n491|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n492|\tif fault != nil {\n493|\t\treturn CallerContext{}, false\n494|\t}\n495|\tif name, unknown := unknownMember(members, callerMembers); unknown {\n496|\t\t_ = name\n497|\t\treturn CallerContext{}, false\n498|\t}\n499|\tif name, missing := missingMember(members, callerRequired); missing {\n500|\t\t_ = name\n(more lines below)"}}}
