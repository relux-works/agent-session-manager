{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c489","stream":{"kind":"session","id":"01a07573-a73b-7be0-abe2-6029bca74ffd"},"sequence":159,"recorded_at":1780531400000313,"record_type":"event","durability":"durable","causation_id":"65c281d8-14aa-4def-b705-62e70b4fce66","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"65c281d8-14aa-4def-b705-62e70b4fce66","run_stream":{"kind":"run","id":"65c281d8-14aa-4def-b705-62e70b4fce66"},"task_stream":{"kind":"task","id":"7c4b197e-e044-46d0-b517-989db109d2f2"},"task_id":"7c4b197e-e044-46d0-b517-989db109d2f2","event":{"kind":"output","task_id":"7c4b197e-e044-46d0-b517-989db109d2f2","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/dirnode/manifest.go`.\n1|package dirnode\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"sort\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// This file validates the Section 7.9 Directory Node Manifest\n13|// 1.0.0: the closed seventeen-member object a manifest operation\n14|// returns as its success body under either major. The manifest\n15|// declares possible surfaces, not runtime availability; a status of\n16|// conditional, unavailable, or unknown is never reported as\n17|// available, and unknown is never rewritten as unsupported.\n18|\n19|// capabilityOrder is the exact eight-name directory-capability\n20|// registry Section 7.9 shows. The manifest capabilities map carries\n21|// exactly these keys; a ninth key advertises a surface the contract\n22|// never defined, and a missing key hides one it did.\n23|var capabilityOrder = []string{\n24|\t\"directory_discovery\",\n25|\t\"directory_incremental_scan\",\n26|\t\"directory_head_digest\",\n27|\t\"directory_tail_preview\",\n28|\t\"native_title_read\",\n29|\t\"native_runtime_observation\",\n30|\t\"existing_session_adoption\",\n31|\t\"native_resume\",\n32|}\n33|\n34|// Capabilities returns the Section 7.9 capability registry in\n35|// order. The result is a copy; the registry cannot be mutated\n36|// through it.\n37|func Capabilities() []string {\n38|\treturn append([]string(nil), capabilityOrder...)\n39|}\n40|\n41|// validCapability reports whether the name is a registry member. It\n42|// is a table loop so the census derives it like every other closed\n43|// vocabulary: an inline comparison chain here would be invisible to\n44|// the census.\n45|func validCapability(name string) bool {\n46|\tfor _, allowed := range capabilityOrder {\n47|\t\tif name == allowed {\n48|\t\t\treturn true\n49|\t\t}\n50|\t}\n51|\treturn false\n52|}\n53|\n54|// capabilityStatuses is the closed CapabilityResult status\n55|// vocabulary. Section 8.1 labels are not aliases: unknown must not\n56|// be rewritten as unsupported, and conditional must not be\n57|// advertised as available.\n58|var capabilityStatuses = []string{\n59|\t\"available\",\n60|\t\"conditional\",\n61|\t\"unavailable\",\n62|\t\"unknown\",\n63|}\n64|\n65|// validCapabilityStatus reports whether the status is a registry\n66|// member.\n67|func validCapabilityStatus(status string) bool {\n68|\tfor _, allowed := range capabilityStatuses {\n69|\t\tif status == allowed {\n70|\t\t\treturn true\n71|\t\t}\n72|\t}\n73|\treturn false\n74|}\n75|\n76|// manifestMembers is the exact required member set DecodeManifest\n77|// accepts: the schema envelope, node identity, the three façade\n78|// executable/module bindings, the supported versions, the operation\n79|// and schema registries, the tuple registry binding, the eight\n80|// capabilities, the policy bindings, the limits, and extensions.\n81|var manifestMembers = map[string]bool{\n82|\t\"schema\":                          true,\n83|\t\"schema_version\":                  true,\n84|\t\"node_id\":                         true,\n85|\t\"node_version\":                    true,\n86|\t\"host_id\":                         true,\n87|\t\"executable_sha256\":               true,\n88|\t\"provider_manifest_digest\":        true,\n89|\t\"session_adapter_manifest_digest\": true,\n90|\t\"supported_protocol_versions\":     true,\n91|\t\"operations\":                      true,\n92|\t\"schemas\":                         true,\n93|\t\"environment_tuple_registry_id\":   true,\n94|\t\"capabilities\":                    true,\n95|\t\"redaction_policy_ids\":            true,\n96|\t\"enrichment_profile_ids\":          true,\n97|\t\"limits\":                          true,\n98|\t\"extensions\":                      true,\n99|}\n100|\n101|// manifestRequired lists manifestMembers in a fixed order so a body\n102|// missing several members always names the same one.\n103|var manifestRequired = []string{\n104|\t\"schema\",\n105|\t\"schema_version\",\n106|\t\"node_id\",\n107|\t\"node_version\",\n108|\t\"host_id\",\n109|\t\"executable_sha256\",\n110|\t\"provider_manifest_digest\",\n111|\t\"session_adapter_manifest_digest\",\n112|\t\"supported_protocol_versions\",\n113|\t\"operations\",\n114|\t\"schemas\",\n115|\t\"environment_tuple_registry_id\",\n116|\t\"capabilities\",\n117|\t\"redaction_policy_ids\",\n118|\t\"enrichment_profile_ids\",\n119|\t\"limits\",\n120|\t\"extensions\",\n121|}\n122|\n123|// capabilityMembers is the exact CapabilityResult member set.\n124|var capabilityMembers = map[string]bool{\n125|\t\"status\":       true,\n126|\t\"reason_code\":  true,\n127|\t\"evidence_ids\": true,\n128|\t\"observed_at\":  true,\n129|\t\"extensions\":   true,\n130|}\n131|\n132|// capabilityRequired lists capabilityMembers in a fixed order.\n133|var capabilityRequired = []string{\n134|\t\"status\",\n135|\t\"reason_code\",\n136|\t\"evidence_ids\",\n137|\t\"observed_at\",\n138|\t\"extensions\",\n139|}\n140|\n141|// limitsMembers is the exact DirectoryNodeLimits member set.\n142|var limitsMembers = map[string]bool{\n143|\t\"max_frame_bytes\":       true,\n144|\t\"max_scan_instances\":    true,\n145|\t\"max_inventory_take\":    true,\n146|\t\"max_excerpt_count\":     true,\n147|\t\"max_excerpt_bytes\":     true,\n148|\t\"max_enrichment_events\": true,\n149|\t\"max_enrichment_bytes\":  true,\n150|\t\"extensions\":            true,\n151|}\n152|\n153|// limitsRequired lists limitsMembers in a fixed order.\n154|var limitsRequired = []string{\n155|\t\"max_frame_bytes\",\n156|\t\"max_scan_instances\",\n157|\t\"max_inventory_take\",\n158|\t\"max_excerpt_count\",\n159|\t\"max_excerpt_bytes\",\n160|\t\"max_enrichment_events\",\n161|\t\"max_enrichment_bytes\",\n162|\t\"extensions\",\n163|}\n164|\n165|// assertionMembers is the exact ContractAssertion member set.\n166|var assertionMembers = map[string]bool{\n167|\t\"contract_id\":   true,\n168|\t\"exact_version\": true,\n169|\t\"extensions\":    true,\n170|}\n171|\n172|// assertionRequired lists assertionMembers in a fixed order.\n173|var assertionRequired = []string{\n174|\t\"contract_id\",\n175|\t\"exact_version\",\n176|\t\"extensions\",\n177|}\n178|\n179|// Capability is one validated CapabilityResult: the status, the\n180|// reason coherence (available carries a null reason; every other\n181|// status requires one), the evidence digests, and the observation\n182|// time.\n183|type Capability struct {\n184|\tStatus     string\n185|\tReasonCode string\n186|\tHasReason  bool\n187|\tEvidence   []string\n188|\tObservedAt string\n189|}\n190|\n191|// Limits is one validated DirectoryNodeLimits.\n192|type Limits struct {\n193|\tMaxFrameBytes      uint64\n194|\tMaxScanInstances   uint64\n195|\tMaxInventoryTake   uint64\n196|\tMaxExcerptCount    uint64\n197|\tMaxExcerptBytes    uint64\n198|\tMaxEnrichmentEvent uint64\n199|\tMaxEnrichmentBytes uint64\n200|}\n201|\n202|// ContractAssertion is one validated schemas entry: the asserted\n203|// contract identifier and its exact version.\n204|type ContractAssertion struct {\n205|\tContractID   string\n206|\tExactVersion string\n207|}\n208|\n209|// Manifest is the validated Directory Node Manifest 1.0.0: the node\n210|// identity, the façade bindings, the ordered registries, the\n211|// capability map, and the limits. The canonical body is retained\n212|// for the host-computed digest.\n213|type Manifest struct {\n214|\tNodeID                 string\n215|\tNodeVersion            string\n216|\tHostID                 string\n217|\tExecutableSHA256       string\n218|\tProviderManifestDigest string\n219|\tAdapterManifestDigest  string\n220|\tSupportedVersions      []string\n221|\tOperations             []string\n222|\tSchemas                []ContractAssertion\n223|\tTupleRegistryID        string\n224|\tCapabilities           map[string]Capability\n225|\tRedactionPolicyIDs     []string\n226|\tEnrichmentProfileIDs   []string\n227|\tLimits                 Limits\n228|\tcanonical              []byte\n229|}\n230|\n231|// Canonical returns the JCS bytes the digest was computed over.\n232|func (manifest Manifest) Canonical() []byte {\n233|\treturn append([]byte(nil), manifest.canonical...)\n234|}\n235|\n236|// Supports reports whether the manifest's\n237|// supported_protocol_versions contains the exact selected version.\n238|// Membership is exact: a manifest that names only 1.0.0 does not\n239|// support a 2.0.0 attempt, and no coercion across majors is\n240|// performed here or anywhere else.\n241|func (manifest Manifest) Supports(version string) bool {\n242|\tfor _, supported := range manifest.SupportedVersions {\n243|\t\tif supported == version {\n244|\t\t\treturn true\n245|\t\t}\n246|\t}\n247|\treturn false\n248|}\n249|\n250|// DecodeManifest validates one manifest-operation success body as\n251|// the closed Section 7.9 Directory Node Manifest. A manifest whose\n252|// operations are not the complete sorted eleven-name registry, or\n253|// whose capabilities are not the exact eight-name map, advertises a\n254|// surface the host cannot invoke or hides one it must, so both are\n255|// refused outright. The three façade bindings are checked for shape\n256|// here and for agreement with observed facts in\n257|// CheckManifestBindings; a contradiction there is an integrity\n258|// failure.\n259|func DecodeManifest(body []byte) (Manifest, error) {\n260|\tmembers, fault := decodeStrictObject(body)\n261|\tif fault != nil {\n262|\t\tfailure, err := failViolation(\"node manifest \"+fault.detail, fault.member)\n263|\t\tif err != nil {\n264|\t\t\treturn Manifest{}, err\n265|\t\t}\n266|\t\treturn Manifest{}, failure\n267|\t}\n268|\tif name, unknown := unknownMember(members, manifestMembers); unknown {\n269|\t\tfailure, err := failViolation(\"node manifest carries unknown member\", name)\n270|\t\tif err != nil {\n271|\t\t\treturn Manifest{}, err\n272|\t\t}\n273|\t\treturn Manifest{}, failure\n274|\t}\n275|\tif name, missing := missingMember(members, manifestRequired); missing {\n276|\t\tfailure, err := failViolation(\"node manifest misses a required member\", name)\n277|\t\tif err != nil {\n278|\t\t\treturn Manifest{}, err\n279|\t\t}\n280|\t\treturn Manifest{}, failure\n281|\t}\n282|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != ManifestSchema {\n283|\t\tfailure, err := failViolation(\"node manifest schema is not the directory node manifest\", \"schema\")\n284|\t\tif err != nil {\n285|\t\t\treturn Manifest{}, err\n286|\t\t}\n287|\t\treturn Manifest{}, failure\n288|\t}\n289|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != ManifestSchemaVersion {\n290|\t\tfailure, err := failViolation(\"node manifest version is not 1.0.0\", \"schema_version\")\n291|\t\tif err != nil {\n292|\t\t\treturn Manifest{}, err\n293|\t\t}\n294|\t\treturn Manifest{}, failure\n295|\t}\n296|\tnodeID, ok := checkStringBounds(members[\"node_id\"], 1, 128)\n297|\tif !ok {\n298|\t\tfailure, err := failViolation(\"node manifest node identifier is not a string[1..128]\", \"node_id\")\n299|\t\tif err != nil {\n300|\t\t\treturn Manifest{}, err\n301|\t\t}\n302|\t\treturn Manifest{}, failure\n303|\t}\n304|\tnodeVersion, ok := rawString(members[\"node_version\"])\n305|\tif !ok || !checkSemver(nodeVersion) {\n306|\t\tfailure, err := failViolation(\"node manifest node version is not SemVer\", \"node_version\")\n307|\t\tif err != nil {\n308|\t\t\treturn Manifest{}, err\n309|\t\t}\n310|\t\treturn Manifest{}, failure\n311|\t}\n312|\thostID, ok := checkUUIDv7(members[\"host_id\"])\n313|\tif !ok {\n314|\t\tfailure, err := failViolation(\"node manifest host identifier is not a UUIDv7\", \"host_id\")\n315|\t\tif err != nil {\n316|\t\t\treturn Manifest{}, err\n317|\t\t}\n318|\t\treturn Manifest{}, failure\n319|\t}\n320|\texecutable, ok := checkDigest(members[\"executable_sha256\"])\n321|\tif !ok {\n322|\t\tfailure, err := failViolation(\"node manifest executable binding is not a digest\", \"executable_sha256\")\n323|\t\tif err != nil {\n324|\t\t\treturn Manifest{}, err\n325|\t\t}\n326|\t\treturn Manifest{}, failure\n327|\t}\n328|\tproviderDigest, ok := checkDigest(members[\"provider_manifest_digest\"])\n329|\tif !ok {\n330|\t\tfailure, err := failViolation(\"node manifest provider binding is not a digest\", \"provider_manifest_digest\")\n331|\t\tif err != nil {\n332|\t\t\treturn Manifest{}, err\n333|\t\t}\n334|\t\treturn Manifest{}, failure\n335|\t}\n336|\tadapterDigest, ok := checkDigest(members[\"session_adapter_manifest_digest\"])\n337|\tif !ok {\n338|\t\tfailure, err := failViolation(\"node manifest adapter binding is not a digest\", \"session_adapter_manifest_digest\")\n339|\t\tif err != nil {\n340|\t\t\treturn Manifest{}, err\n341|\t\t}\n342|\t\treturn Manifest{}, failure\n343|\t}\n344|\tsupported, ok := checkSupportedVersions(members[\"supported_protocol_versions\"])\n345|\tif !ok {\n346|\t\tfailure, err := failViolation(\"node manifest supported versions are not sorted unique SemVer[1..16]\", \"supported_protocol_versions\")\n347|\t\tif err != nil {\n348|\t\t\treturn Manifest{}, err\n349|\t\t}\n350|\t\treturn Manifest{}, failure\n351|\t}\n352|\toperations, ok := checkManifestOperations(members[\"operations\"])\n353|\tif !ok {\n354|\t\tfailure, err := failViolation(\"node manifest operations are not the complete sorted eleven-name registry\", \"operations\")\n355|\t\tif err != nil {\n356|\t\t\treturn Manifest{}, err\n357|\t\t}\n358|\t\treturn Manifest{}, failure\n359|\t}\n360|\tschemas, ok := checkContractAssertions(members[\"schemas\"])\n361|\tif !ok {\n362|\t\tfailure, err := failViolation(\"node manifest schemas are not sorted unique ContractAssertion[15..64]\", \"schemas\")\n363|\t\tif err != nil {\n364|\t\t\treturn Manifest{}, err\n365|\t\t}\n366|\t\treturn Manifest{}, failure\n367|\t}\n368|\ttupleRegistry, ok := checkDigest(members[\"environment_tuple_registry_id\"])\n369|\tif !ok {\n370|\t\tfailure, err := failViolation(\"node manifest tuple registry binding is not a digest\", \"environment_tuple_registry_id\")\n371|\t\tif err != nil {\n372|\t\t\treturn Manifest{}, err\n373|\t\t}\n374|\t\treturn Manifest{}, failure\n375|\t}\n376|\tcapabilities, ok := checkCapabilities(members[\"capabilities\"])\n377|\tif !ok {\n378|\t\tfailure, err := failViolation(\"node manifest capabilities are not the exact eight-name result map\", \"capabilities\")\n379|\t\tif err != nil {\n380|\t\t\treturn Manifest{}, err\n381|\t\t}\n382|\t\treturn Manifest{}, failure\n383|\t}\n384|\tredaction, ok := checkSortedUniqueDigests(members[\"redaction_policy_ids\"], 1, 64)\n385|\tif !ok {\n386|\t\tfailure, err := failViolation(\"node manifest redaction policies are not sorted unique digest[1..64]\", \"redaction_policy_ids\")\n387|\t\tif err != nil {\n388|\t\t\treturn Manifest{}, err\n389|\t\t}\n390|\t\treturn Manifest{}, failure\n391|\t}\n392|\tenrichment, ok := checkSortedUniqueDigests(members[\"enrichment_profile_ids\"], 0, 256)\n393|\tif !ok {\n394|\t\tfailure, err := failViolation(\"node manifest enrichment profiles are not sorted unique digest[0..256]\", \"enrichment_profile_ids\")\n395|\t\tif err != nil {\n396|\t\t\treturn Manifest{}, err\n397|\t\t}\n398|\t\treturn Manifest{}, failure\n399|\t}\n400|\tlimits, ok := checkLimits(members[\"limits\"])\n401|\tif !ok {\n402|\t\tfailure, err := failViolation(\"node manifest limits are not the closed DirectoryNodeLimits\", \"limits\")\n403|\t\tif err != nil {\n404|\t\t\treturn Manifest{}, err\n405|\t\t}\n406|\t\treturn Manifest{}, failure\n407|\t}\n408|\tif !checkExtensions(members[\"extensions\"]) {\n409|\t\tfailure, err := failViolation(\"node manifest extensions are not reverse-DNS keyed\", \"extensions\")\n410|\t\tif err != nil {\n411|\t\t\treturn Manifest{}, err\n412|\t\t}\n413|\t\treturn Manifest{}, failure\n414|\t}\n415|\tcanonical, err := canonicaljson.Canonicalize(body)\n416|\tif err != nil {\n417|\t\tfailure, faultErr := failViolation(\"node manifest is not canonical JSON\", \"\")\n418|\t\tif faultErr != nil {\n419|\t\t\treturn Manifest{}, faultErr\n420|\t\t}\n421|\t\treturn Manifest{}, failure\n422|\t}\n423|\treturn Manifest{\n424|\t\tNodeID:                 nodeID,\n425|\t\tNodeVersion:            nodeVersion,\n426|\t\tHostID:                 hostID.String(),\n427|\t\tExecutableSHA256:       executable.String(),\n428|\t\tProviderManifestDigest: providerDigest.String(),\n429|\t\tAdapterManifestDigest:  adapterDigest.String(),\n430|\t\tSupportedVersions:      supported,\n431|\t\tOperations:             operations,\n432|\t\tSchemas:                schemas,\n433|\t\tTupleRegistryID:        tupleRegistry.String(),\n434|\t\tCapabilities:           capabilities,\n435|\t\tRedactionPolicyIDs:     digestStrings(redaction),\n436|\t\tEnrichmentProfileIDs:   digestStrings(enrichment),\n437|\t\tLimits:                 limits,\n438|\t\tcanonical:              canonical,\n439|\t}, nil\n440|}\n441|\n442|// checkSupportedVersions reports whether the member is a sorted\n443|// unique SemVer array in the count bound. Ordering is bytewise over\n444|// the version strings, the same rule every sorted-unique check in\n445|// this package applies: no member type gets its own comparison.\n446|func checkSupportedVersions(raw json.RawMessage) ([]string, bool) {\n447|\tversions, ok := checkSortedUniqueStrings(raw, 5, 64, 1, 16)\n448|\tif !ok {\n449|\t\treturn nil, false\n450|\t}\n451|\tfor _, version := range versions {\n452|\t\tif !checkSemver(version) {\n453|\t\t\treturn nil, false\n454|\t\t}\n455|\t}\n456|\treturn versions, true\n457|}\n458|\n459|// checkManifestOperations reports whether the member is exactly the\n460|// eleven-name operation registry in sorted unique order. Sortedness\n461|// is the rule here — the manifest carries the registry sorted, not\n462|// in section table order — so the comparison sorts a copy of the\n463|// table and matches element-wise.\n464|func checkManifestOperations(raw json.RawMessage) ([]string, bool) {\n465|\telements, ok := decodeArray(raw)\n466|\tif !ok || len(elements) != len(operationOrder) {\n467|\t\treturn nil, false\n468|\t}\n469|\twant := Operations()\n470|\tsort.Strings(want)\n471|\toperations := make([]string, 0, len(elements))\n472|\tfor index, element := range elements {\n473|\t\tname, ok := rawString(element)\n474|\t\tif !ok || name != want[index] {\n475|\t\t\treturn nil, false\n476|\t\t}\n477|\t\toperations = append(operations, name)\n478|\t}\n479|\treturn operations, true\n480|}\n481|\n482|// checkContractAssertions reports whether the member is a sorted\n483|// unique ContractAssertion array in the count bound. Uniqueness is\n484|// over the canonical encoding of each entry, so two entries that\n485|// differ only in key order or duplicate members still collide.\n486|func checkContractAssertions(raw json.RawMessage) ([]ContractAssertion, bool) {\n487|\telements, ok := decodeArray(raw)\n488|\tif !ok || len(elements) < 15 || len(elements) > 64 {\n489|\t\treturn nil, false\n490|\t}\n491|\tassertions := make([]ContractAssertion, 0, len(elements))\n492|\tencodings := make([]string, 0, len(elements))\n493|\tfor _, element := range elements {\n494|\t\tmembers, fault := decodeStrictObject(bytesTrimSpace(element))\n495|\t\tif fault != nil {\n496|\t\t\treturn nil, false\n497|\t\t}\n498|\t\tif name, unknown := unknownMember(members, assertionMembers); unknown {\n499|\t\t\t_ = name\n500|\t\t\treturn nil, false\n(more lines below)"}}}
