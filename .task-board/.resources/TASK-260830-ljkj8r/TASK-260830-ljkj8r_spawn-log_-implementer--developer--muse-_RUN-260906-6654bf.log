the member is an object with\n533|// exactly the eight registry keys, each a closed CapabilityResult\n534|// with coherent reason: available carries a null reason and every\n535|// other status requires one. The coherence runs both ways: a null\n536|// reason on a non-available status and a set reason on an\n537|// available status both refuse.\n538|func checkCapabilities(raw json.RawMessage) (map[string]Capability, bool) {\n539|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n540|\tif fault != nil {\n541|\t\treturn nil, false\n542|\t}\n543|\tif len(members) != len(capabilityOrder) {\n544|\t\treturn nil, false\n545|\t}\n546|\tcapabilities := make(map[string]Capability, len(capabilityOrder))\n547|\tfor _, name := range capabilityOrder {\n548|\t\tmember, present := members[name]\n549|\t\tif !present {\n550|\t\t\treturn nil, false\n551|\t\t}\n552|\t\tcapability, ok := checkCapability(member)\n553|\t\tif !ok {\n554|\t\t\treturn nil, false\n555|\t\t}\n556|\t\tcapabilities[name] = capability\n557|\t}\n558|\treturn capabilities, true\n559|}\n560|\n561|// checkCapability validates one CapabilityResult object.\n562|func checkCapability(raw json.RawMessage) (Capability, bool) {\n563|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n564|\tif fault != nil {\n565|\t\treturn Capability{}, false\n566|\t}\n567|\tif name, unknown := unknownMember(members, capabilityMembers); unknown {\n568|\t\t_ = name\n569|\t\treturn Capability{}, false\n570|\t}\n571|\tif name, missing := missingMember(members, capabilityRequired); missing {\n572|\t\t_ = name\n573|\t\treturn Capability{}, false\n574|\t}\n575|\tstatus, ok := rawString(members[\"status\"])\n576|\tif !ok || !validCapabilityStatus(status) {\n577|\t\treturn Capability{}, false\n578|\t}\n579|\treason, reasonNull := members[\"reason_code\"]\n580|\thasReason := false\n581|\tvar reasonCode string\n582|\tif reasonNull && isNull(reason) {\n583|\t\thasReason = false\n584|\t} else {\n585|\t\tvalue, ok := checkStringBounds(reason, 1, 128)\n586|\t\tif !ok {\n587|\t\t\treturn Capability{}, false\n588|\t\t}\n589|\t\thasReason = true\n590|\t\treasonCode = value\n591|\t}\n592|\tif status == \"available\" && hasReason {\n593|\t\treturn Capability{}, false\n594|\t}\n595|\tif status != \"available\" && !hasReason {\n596|\t\treturn Capability{}, false\n597|\t}\n598|\tevidence, ok := checkSortedUniqueDigests(members[\"evidence_ids\"], 0, 64)\n599|\tif !ok {\n600|\t\treturn Capability{}, false\n601|\t}\n602|\tobserved, ok := checkTimestamp(members[\"observed_at\"])\n603|\tif !ok {\n604|\t\treturn Capability{}, false\n605|\t}\n606|\tif !checkExtensions(members[\"extensions\"]) {\n607|\t\treturn Capability{}, false\n608|\t}\n609|\treturn Capability{\n610|\t\tStatus:     status,\n611|\t\tReasonCode: reasonCode,\n612|\t\tHasReason:  hasReason,\n613|\t\tEvidence:   digestStrings(evidence),\n614|\t\tObservedAt: observed.String(),\n615|\t}, true\n616|}\n617|\n618|// checkLimits validates one DirectoryNodeLimits object against the\n619|// seven manifest bounds plus the frame ceiling: a limits object\n620|// admitting frames larger than the 8 MiB transport bound would\n621|// license an oversize line.\n622|func checkLimits(raw json.RawMessage) (Limits, bool) {\n623|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n624|\tif fault != nil {\n625|\t\treturn Limits{}, false\n626|\t}\n627|\tif name, unknown := unknownMember(members, limitsMembers); unknown {\n628|\t\t_ = name\n629|\t\treturn Limits{}, false\n630|\t}\n631|\tif name, missing := missingMember(members, limitsRequired); missing {\n632|\t\t_ = name\n633|\t\treturn Limits{}, false\n634|\t}\n635|\tframe, ok := checkUint53Bounds(members[\"max_frame_bytes\"], 1, MaxFrameBytes)\n636|\tif !ok {\n637|\t\treturn Limits{}, false\n638|\t}\n639|\tinstances, ok := checkUint53Bounds(members[\"max_scan_instances\"], 1, 65536)\n640|\tif !ok {\n641|\t\treturn Limits{}, false\n642|\t}\n643|\ttake, ok := checkUint53Bounds(members[\"max_inventory_take\"], 1, 1000)\n644|\tif !ok {\n645|\t\treturn Limits{}, false\n646|\t}\n647|\texcerptCount, ok := checkUint53Bounds(members[\"max_excerpt_count\"], 0, 20)\n648|\tif !ok {\n649|\t\treturn Limits{}, false\n650|\t}\n651|\texcerptBytes, ok := checkUint53Bounds(members[\"max_excerpt_bytes\"], 0, 4096)\n652|\tif !ok {\n653|\t\treturn Limits{}, false\n654|\t}\n655|\tenrichmentEvents, ok := checkUint53Bounds(members[\"max_enrichment_events\"], 1, 5000)\n656|\tif !ok {\n657|\t\treturn Limits{}, false\n658|\t}\n659|\tenrichmentBytes, ok := checkUint53Bounds(members[\"max_enrichment_bytes\"], 1, 4194304)\n660|\tif !ok {\n661|\t\treturn Limits{}, false\n662|\t}\n663|\tif !checkExtensions(members[\"extensions\"]) {\n664|\t\treturn Limits{}, false\n665|\t}\n666|\treturn Limits{\n667|\t\tMaxFrameBytes:      frame,\n668|\t\tMaxScanInstances:   instances,\n669|\t\tMaxInventoryTake:   take,\n670|\t\tMaxExcerptCount:    excerptCount,\n671|\t\tMaxExcerptBytes:    excerptBytes,\n672|\t\tMaxEnrichmentEvent: enrichmentEvents,\n673|\t\tMaxEnrichmentBytes: enrichmentBytes,\n674|\t}, true\n675|}\n676|\n677|// digestStrings renders validated digests in order.\n678|func digestStrings(digests []scalar.Digest) []string {\n679|\tout := make([]string, 0, len(digests))\n680|\tfor _, digest := range digests {\n681|\t\tout = append(out, digest.String())\n682|\t}\n683|\treturn out\n684|}\n685|\n686|// bytesTrimSpace trims JSON-insignificant whitespace around a raw\n687|// member. Members arrive untrimmed from the strict decoder; object\n688|// and array checks below accept surrounding whitespace, but the\n689|// canonicalizer and the duplicate scan need the exact span, so the\n690|// trim happens at each nested-object entry point, never by\n691|// rewriting the parent frame.\n692|func bytesTrimSpace(raw json.RawMessage) []byte {\n693|\treturn bytes.TrimSpace(raw)\n694|}\n695|\n696|// ManifestDigest returns the host-computed JCS SHA-256 of the\n697|// validated manifest. It is computed by the host, never embedded by\n698|// the node, so a manifest that names its own digest cannot mint\n699|// trust.\n700|func ManifestDigest(manifest Manifest) scalar.Digest {\n701|\treturn scalar.SHA256Digest(manifest.canonical)\n702|}\n703|\n704|// ObservedFacade is the independently observed executable facts the\n705|// manifest bindings must agree with: the host-observed executable\n706|// digest and the provider and adapter manifest digests from their\n707|// own discovery, never from the node.\n708|type ObservedFacade struct {\n709|\tExecutableSHA256       string\n710|\tProviderManifestDigest string\n711|\tSessionAdapterDigest   string\n712|}\n713|\n714|// CheckManifestBindings requires the manifest's three façade\n715|// bindings to equal the independently observed facts. A\n716|// contradiction is an integrity failure, not a usable node: the\n717|// three façade executable/module bindings and the tuple\n718|// declarations must agree, and agreement with observed facts is\n719|// what makes the manifest this node's. A failed or partial\n720|// observation never means the candidate is absent.\n721|func CheckManifestBindings(manifest Manifest, observed ObservedFacade) error {\n722|\tif _, ok := checkDigestString(observed.ExecutableSHA256); !ok {\n723|\t\tfailure, err := failInvalid(\"observed executable digest is not a digest\", \"executable_sha256\")\n724|\t\tif err != nil {\n725|\t\t\treturn err\n726|\t\t}\n727|\t\treturn failure\n728|\t}\n729|\tif _, ok := checkDigestString(observed.ProviderManifestDigest); !ok {\n730|\t\tfailure, err := failInvalid(\"observed provider manifest digest is not a digest\", \"provider_manifest_digest\")\n731|\t\tif err != nil {\n732|\t\t\treturn err\n733|\t\t}\n734|\t\treturn failure\n735|\t}\n736|\tif _, ok := checkDigestString(observed.SessionAdapterDigest); !ok {\n737|\t\tfailure, err := failInvalid(\"observed adapter manifest digest is not a digest\", \"session_adapter_manifest_digest\")\n738|\t\tif err != nil {\n739|\t\t\treturn err\n740|\t\t}\n741|\t\treturn failure\n742|\t}\n743|\tif manifest.ExecutableSHA256 != observed.ExecutableSHA256 {\n744|\t\tfailure, err := failIntegrity(\"node manifest executable binding contradicts the observed executable\", \"executable_sha256\")\n745|\t\tif err != nil {\n746|\t\t\treturn err\n747|\t\t}\n748|\t\treturn failure\n749|\t}\n750|\tif manifest.ProviderManifestDigest != observed.ProviderManifestDigest {\n751|\t\tfailure, err := failIntegrity(\"node manifest provider binding contradicts the observed manifest\", \"provider_manifest_digest\")\n752|\t\tif err != nil {\n753|\t\t\treturn err\n754|\t\t}\n755|\t\treturn failure\n756|\t}\n757|\tif manifest.AdapterManifestDigest != observed.SessionAdapterDigest {\n758|\t\tfailure, err := failIntegrity(\"node manifest adapter binding contradicts the observed manifest\", \"session_adapter_manifest_digest\")\n759|\t\tif err != nil {\n760|\t\t\treturn err\n761|\t\t}\n762|\t\treturn failure\n763|\t}\n764|\treturn nil\n765|}\n766|\n767|// AvailableCapabilities returns the manifest capabilities with\n768|// status available, in registry order. Conditional, unavailable,\n769|// and unknown are never upgraded: the Section 8.1 labels are not\n770|// aliases, so a non-available status is reported by omission, and\n771|// a caller that needs the reason reads the manifest map.\n772|func AvailableCapabilities(manifest Manifest) []string {\n773|\tvar out []string\n774|\tfor _, name := range capabilityOrder {\n775|\t\tif capability, present := manifest.Capabilities[name]; present && capability.Status == \"available\" {\n776|\t\t\tout = append(out, name)\n777|\t\t}\n778|\t}\n779|\treturn out\n(more lines below)"}}}
