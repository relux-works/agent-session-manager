\",\"message\":\"m\",\"remediation\":null,\"extensions\":{}}`\n1378|\n1379|// findingArray builds n valid findings as a JSON array.\n1380|func findingArray(n int) string {\n1381|\treturn `[` + strings.Join(repeatLiteral(validFindingLiteral, n), \",\") + `]`\n1382|}\n1383|\n1384|func repeatLiteral(literal string, n int) []string {\n1385|\tout := make([]string, 0, n)\n1386|\tfor i := 0; i < n; i++ {\n1387|\t\tout = append(out, literal)\n1388|\t}\n1389|\treturn out\n1390|}\n1391|\n1392|// TestFindingsCapEdges drives every DecodeFindings cap\n1393|// instantiation at its edge through the production entry: the\n1394|// cap admits, cap+1 refuses naming the count bound. The four\n1395|// instantiations share one generic guard; each value is pinned\n1396|// where it is passed.\n1397|func TestFindingsCapEdges(t *testing.T) {\n1398|\tmanifestDigest := fixtureManifestDigestText(t)\n1399|\tt.Run(\"inspect ambiguities 1024\", func(t *testing.T) {\n1400|\t\t_, facts := successFactsFor(t, OpInspect, manifestDigest)\n1401|\t\tdrive := func(t *testing.T, value string) error {\n1402|\t\t\trequest := fixtureRequestBody(t, OpInspect, manifestDigest)\n1403|\t\t\tdecoded, err := CheckRequestBody(OpInspect, request)\n1404|\t\t\tif err != nil {\n1405|\t\t\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n1406|\t\t\t}\n1407|\t\t\tlocal := facts\n1408|\t\t\tlocal.Context = decoded\n1409|\t\t\tbase := fixtureSuccessBody(t, OpInspect, requestContextOf(t, request), manifestDigest)\n1410|\t\t\treturn CheckSuccessBody(OpInspect, mutateMember(t, base, \"ambiguities\", value), local)\n1411|\t\t}\n1412|\t\tif err := drive(t, findingArray(1025)); err == nil {\n1413|\t\t\tt.Fatal(\"admitted 1025 ambiguities past the 1024 cap\")\n1414|\t\t} else {\n1415|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"findings\", \"exceed the count bound\")\n1416|\t\t}\n1417|\t\tif err := drive(t, findingArray(1024)); err != nil {\n1418|\t\t\tt.Fatalf(\"refused 1024 ambiguities at the cap: %v\",