91|\tfor _, row := range srows {\n992|\t\trow := row\n993|\t\tname := string(row.operation) + \"/\" + row.member\n994|\t\tt.Run(name, func(t *testing.T) {\n995|\t\t\tdrive := func(literal string) error {\n996|\t\t\t\tbody := fixtureRequestBody(t, row.operation, manifestDigest)\n997|\t\t\t\t_, err := CheckRequestBody(row.operation, mutateMember(t, body, row.member, literal))\n998|\t\t\t\treturn err\n999|\t\t\t}\n1000|\t\t\tif err := drive(quotedRepeat(row.min - 1)); err == nil {\n1001|\t\t\t\tt.Fatalf(\"%s admitted length %d below the %d minimum\", name, row.min-1, row.min)\n1002|\t\t\t} else {\n1003|\t\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", row.member, \"outside its bound\")\n1004|\t\t\t}\n1005|\t\t\tif err := drive(quotedRepeat(row.min)); err != nil {\n1006|\t\t\t\tt.Fatalf(\"%s refused length %d at the minimum: %v\", name, row.min, err)\n1007|\t\t\t}\n1008|\t\t\tif err := drive(quotedRepeat(row.max)); err != nil {\n1009|\t\t\t\tt.Fatalf(\"%s refused length %d at the maximum: %v\", name, row.max, err)\n1010|\t\t\t}\n1011|\t\t\tif err := drive(quotedRepeat(row.max + 1)); err == nil {\n1012|\t\t\t\tt.Fatalf(\"%s admitted length %d past the %d maximum\", name, row.max+1, row.max)\n1013|\t\t\t} else {\n1014|\t\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", row.member, \"outside its bound\")\n1015|\t\t\t}\n1016|\t\t})\n1017|\t}\n1018|\tuints := []struct {\n1019|\t\toperation Operation\n1020|\t\tmember    string\n1021|\t\tmin       uint64\n1022|\t\tmax       uint64\n1023|\t\tfiniteMax bool\n1024|\t}{\n1025|\t\t{OpDiscover, \"limit\", 1, 65536, true},\n1026|\t\t{OpCapturePlan, \"max_items\", 1, 65536, true},\n1027|\t\t{OpCapturePlan, \"max_total_bytes\", 1, maxUint53, false},\n1028|\t}\n1029|\tfor _, row := range uints {\n1030|\t\trow := row\n1031|\t\tname := string(row.operation) + \"/\" + row.member\n1032|\t\tt.Run(name, func(t *testing.T) {\n1033|\t\t\tdrive := func(literal string) error {\n1034|\t\t\t\t