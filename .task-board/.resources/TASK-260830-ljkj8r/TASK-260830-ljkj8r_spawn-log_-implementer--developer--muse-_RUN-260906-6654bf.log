{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c57d","stream":{"kind":"session","id":"01a07573-a73b-7be0-abe2-6029bca74ffd"},"sequence":281,"recorded_at":1780531400000557,"record_type":"event","durability":"durable","causation_id":"65c281d8-14aa-4def-b705-62e70b4fce66","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"65c281d8-14aa-4def-b705-62e70b4fce66","run_stream":{"kind":"run","id":"65c281d8-14aa-4def-b705-62e70b4fce66"},"task_stream":{"kind":"task","id":"b6ac22cc-0e15-4749-add0-f490dccc386f"},"task_id":"b6ac22cc-0e15-4749-add0-f490dccc386f","event":{"kind":"output","task_id":"b6ac22cc-0e15-4749-add0-f490dccc386f","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/dirnode/fixtures_test.go`.\n1|package dirnode\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"fmt\"\n7|\t\"sort\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n12|)\n13|\n14|// Shared fixtures for the dirnode suite. Every builder emits\n15|// hand-written JSON with independently chosen literals: no builder\n16|// derives its probe points from production constants, so a mutated\n17|// production constant cannot take its fixture with it. The verdict\n18|// always comes from production; the vectors never do. In\n19|// particular the schema URNs, protocol URN, version strings,\n20|// operation names, and member names below are retyped from the\n21|// pinned specification, not referenced from the package under\n22|// test.\n23|\n24|// Fixed fixture identities. The UUIDs carry a 7 version nibble;\n25|// the digests are syntactically pinned sha256 hex.\n26|const (\n27|\tfixtureNodeID      = \"test-directory-node\"\n28|\tfixtureNodeVersion = \"2.4.1\"\n29|\tfixtureHostID      = \"0198f4c8-8e50-7f66-8f70-1234567890ab\"\n30|\tfixtureRequestID   = \"0198f4c8-8e50-7f66-8f70-1234567890ac\"\n31|\tfixtureOperationID = \"0198f4c8-8e50-7f66-8f70-1234567890ad\"\n32|\tfixtureQueryID     = \"0198f4c8-8e50-7f66-8f70-1234567890ae\"\n33|\tfixtureOriginHost  = \"0198f4c8-8e50-7f66-8f70-1234567890af\"\n34|\tfixtureObservedAt  = \"2026-08-19T04:05:00.000Z\"\n35|)\n36|\n37|// fixtureDigest returns the pinned digest of one seed.\n38|func fixtureDigest(seed string) string {\n39|\tsum := sha256.Sum256([]byte(seed))\n40|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n41|}\n42|\n43|// Standard fixture digests, each naming its seed.\n44|var (\n45|\tfixtureExecutableDigest = fixtureDigest(\"test-node-executable\")\n46|\tfixtureProviderDigest   = fixtureDigest(\"test-provider-manifest\")\n47|\tfixtureAdapterDigest    = fixtureDigest(\"test-adapter-manifest\")\n48|\tfixtureTupleRegistry    = fixtureDigest(\"test-tuple-registry\")\n49|\tfixturePolicyDigest     = fixtureDigest(\"test-policy\")\n50|\tfixtureRedactionDigest  = fixtureDigest(\"test-redaction-policy\")\n51|\tfixtureEnrichmentDigest = fixtureDigest(\"test-enrichment-profile\")\n52|\tfixtureEvidenceDigest   = fixtureDigest(\"test-evidence\")\n53|\tfixtureInstallDigestA   = fixtureDigest(\"test-install-a\")\n54|\tfixtureInstallDigestB   = fixtureDigest(\"test-install-b\")\n55|\tfixtureBatchDigest      = fixtureDigest(\"test-batch\")\n56|\tfixtureNativeDigestA    = fixtureDigest(\"test-native-a\")\n57|\tfixtureHeadDigest       = fixtureDigest(\"test-head\")\n58|\tfixturePlanDigest       = fixtureDigest(\"test-plan\")\n59|)\n60|\n61|// fixtureRequestFrame builds one hand-written request envelope for\n62|// the given wire version string, operation, and body.\n63|func fixtureRequestFrame(version, operation, requestID string, deadline uint64, body string) []byte {\n64|\treturn []byte(fmt.Sprintf(`{\"schema\":\"urn:ax:schema:session-directory-node-request\",\"schema_version\":%q,\"protocol\":\"urn:ax:protocol:session-directory-node\",\"protocol_version\":%q,\"request_id\":%q,\"operation\":%q,\"deadline_ms\":%d,\"body\":%s}`,\n65|\t\tversion, version, requestID, operation, deadline, body))\n66|}\n67|\n68|// fixtureManifestJSON builds one complete valid manifest. The\n69|// supported versions name both majors; the operations list is the\n70|// sorted eleven-name registry; the schemas list carries fifteen\n71|// minimal assertions; every capability is available with null\n72|// reason except conditional and unknown rows that prove the\n73|// reason-coherence rule in the positive direction.\n74|func fixtureManifestJSON() string {\n75|\tvar assertions []string\n76|\tfor index := 0; index < 15; index++ {\n77|\t\tassertions = append(assertions, fmt.Sprintf(`{\"contract_id\":\"urn:ax:schema:contract-%02d\",\"exact_version\":\"1.0.%d\",\"extensions\":{}}`, index, index))\n78|\t}\n79|\toperations := []string{\n80|\t\t\"continuation-inspect\", \"doctor\", \"enrichment-plan\", \"enrichment-run\",\n81|\t\t\"enrichment-status\", \"inventory\", \"manifest\", \"preview\", \"probe\",\n82|\t\t\"runtime-observe\", \"scan\",\n83|\t}\n84|\tops := make([]string, 0, len(operations))\n85|\tfor _, name := range operations {\n86|\t\tops = append(ops, fmt.Sprintf(\"%q\", name))\n87|\t}\n88|\tcapabilities := []string{\n89|\t\t`\"directory_discovery\":{\"status\":\"available\",\"reason_code\":null,\"evidence_ids\":[],\"observed_at\":\"2026-08-19T04:05:00.000Z\",\"extensions\":{}}`,\n90|\t\tfmt.Sprintf(`\"directory_incremental_scan\":{\"status\":\"available\",\"reason_code\":null,\"evidence_ids\":[%q],\"observed_at\":\"2026-08-19T04:05:00.000Z\",\"extensions\":{}}`, fixtureEvidenceDigest),\n91|\t\t`\"directory_head_digest\":{\"status\":\"conditional\",\"reason_code\":\"needs-quiesce\",\"evidence_ids\":[],\"observed_at\":\"2026-08-19T04:05:00.000Z\",\"extensions\":{}}`,\n92|\t\t`\"directory_tail_preview\":{\"status\":\"unavailable\",\"reason_code\":\"not-probed\",\"evidence_ids\":[],\"observed_at\":\"2026-08-19T04:05:00.000Z\",\"extensions\":{}}`,\n93|\t\t`\"native_title_read\":{\"status\":\"available\",\"reason_code\":null,\"evidence_ids\":[],\"observed_at\":\"2026-08-19T04:05:00.000Z\",\"extensions\":{}}`,\n94|\t\t`\"native_runtime_observation\":{\"status\":\"unknown\",\"reason_code\":\"no-evidence\",\"evidence_ids\":[],\"observed_at\":\"2026-08-19T04:05:00.000Z\",\"extensions\":{}}`,\n95|\t\t`\"existing_session_adoption\":{\"status\":\"available\",\"reason_code\":null,\"evidence_ids\":[],\"observed_at\":\"2026-08-19T04:05:00.000Z\",\"extensions\":{}}`,\n96|\t\t`\"native_resume\":{\"status\":\"available\",\"reason_code\":null,\"evidence_ids\":[],\"observed_at\":\"2026-08-19T04:05:00.000Z\",\"extensions\":{}}`,\n97|\t}\n98|\treturn fmt.Sprintf(`{\"schema\":\"urn:ax:schema:session-directory-node-manifest\",\"schema_version\":\"1.0.0\",\"node_id\":%q,\"node_version\":%q,\"host_id\":%q,\"executable_sha256\":%q,\"provider_manifest_digest\":%q,\"session_adapter_manifest_digest\":%q,\"supported_protocol_versions\":[\"1.0.0\",\"2.0.0\"],\"operations\":[%s],\"schemas\":[%s],\"environment_tuple_registry_id\":%q,\"capabilities\":{%s},\"redaction_policy_ids\":[%q],\"enrichment_profile_ids\":[%q],\"limits\":{\"max_frame_bytes\":8388608,\"max_scan_instances\":65536,\"max_inventory_take\":1000,\"max_excerpt_count\":20,\"max_excerpt_bytes\":4096,\"max_enrichment_events\":5000,\"max_enrichment_bytes\":4194304,\"extensions\":{}},\"extensions\":{}}`,\n99|\t\tfixtureNodeID, fixtureNodeVersion, fixtureHostID,\n100|\t\tfixtureExecutableDigest, fixtureProviderDigest, fixtureAdapterDigest,\n101|\t\tstrings.Join(ops, \",\"), strings.Join(assertions, \",\"),\n102|\t\tfixtureTupleRegistry, strings.Join(capabilities, \",\"),\n103|\t\tfixtureRedactionDigest, fixtureEnrichmentDigest)\n104|}\n105|\n106|// fixtureObservedFacade returns the observed facts matching the\n107|// fixture manifest bindings.\n108|func fixtureObservedFacade() ObservedFacade {\n109|\treturn ObservedFacade{\n110|\t\tExecutableSHA256:       fixtureExecutableDigest,\n111|\t\tProviderManifestDigest: fixtureProviderDigest,\n112|\t\tSessionAdapterDigest:   fixtureAdapterDigest,\n113|\t}\n114|}\n115|\n116|// fixtureSuccessFrame wraps a body in a hand-written success\n117|// envelope echoing the given request identity.\n118|func fixtureSuccessFrame(version, operation, requestID, body string) []byte {\n119|\treturn []byte(fmt.Sprintf(`{\"schema\":\"urn:ax:schema:session-directory-node-response\",\"schema_version\":\"1.0.0\",\"protocol\":\"urn:ax:protocol:session-directory-node\",\"protocol_version\":%q,\"request_id\":%q,\"operation\":%q,\"ok\":true,\"body\":%s}`,\n120|\t\tversion, requestID, operation, body))\n121|}\n122|\n123|// fixtureErrorObject builds one hand-written Structured Error 1.2.0\n124|// object with independently chosen literals.\n125|func fixtureErrorObject(code string, exit int, retryable bool) string {\n126|\treturn fmt.Sprintf(`{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.2.0\",\"code\":%q,\"message\":\"fixture %s\",\"exit_code\":%d,\"retryable\":%v,\"details\":{}}`,\n127|\t\tcode, code, exit, retryable)\n128|}\n129|\n130|// fixtureFailureFrame wraps an error object in a hand-written\n131|// failure envelope echoing the given request identity.\n132|func fixtureFailureFrame(version, operation, requestID, errorObject string) []byte {\n133|\treturn []byte(fmt.Sprintf(`{\"schema\":\"urn:ax:schema:session-directory-node-response\",\"schema_version\":\"1.0.0\",\"protocol\":\"urn:ax:protocol:session-directory-node\",\"protocol_version\":%q,\"request_id\":%q,\"operation\":%q,\"ok\":false,\"error\":%s}`,\n134|\t\tversion, requestID, operation, errorObject))\n135|}\n136|\n137|// fixtureDowngradeFrame is the exact downgrade tuple for the given\n138|// major: failure echo plus incompatible_protocol, exit 6,\n139|// retryable=false.\n140|func fixtureDowngradeFrame(version, requestID string) []byte {\n141|\treturn fixtureFailureFrame(version, \"manifest\", requestID, fixtureErrorObject(\"incompatible_protocol\", 6, false))\n142|}\n143|\n144|// fixtureProbeRequestV2 is one valid Request 2.0.0 probe body.\n145|func fixtureProbeRequestV2() string {\n146|\treturn `{\"platform\":\"linux\",\"architecture\":\"amd64\",\"requested_environment_ids\":[],\"requested_capabilities\":[\"directory_discovery\"],\"extensions\":{}}`\n147|}\n148|\n149|// fixtureProbeRequestV1 is one valid Request 1.0.0 probe body.\n150|func fixtureProbeRequestV1() string {\n151|\treturn `{\"platform\":\"darwin\",\"architecture\":\"arm64\",\"requested_environment_ids\":[],\"requested_capabilities\":[],\"extensions\":{}}`\n152|}\n153|\n154|// fixtureProbeResponseJSON is one valid probe success body whose\n155|// node build equals the fixture manifest.\n156|func fixtureProbeResponseJSON() string {\n157|\treturn fmt.Sprintf(`{\"host_id\":%q,\"node_build\":{\"node_id\":%q,\"node_version\":%q,\"executable_sha256\":%q,\"provider_manifest_digest\":%q,\"session_adapter_manifest_digest\":%q,\"extensions\":{}},\"policy_digest\":%q,\"environments\":[{\"environment_id\":\"test.env\"}],\"findings\":[{\"severity\":\"info\",\"code\":\"probe-ok\",\"message\":\"probe completed\",\"remediation\":null,\"extensions\":{}}],\"extensions\":{}}`,\n158|\t\tfixtureHostID, fixtureNodeID, fixtureNodeVersion,\n159|\t\tfixtureExecutableDigest, fixtureProviderDigest, fixtureAdapterDigest,\n160|\t\tfixturePolicyDigest)\n161|}\n162|\n163|// fixtureScanRequestJSON is one valid scan request body. The\n164|// installation pair emits in sorted order: the sortedness verdict\n165|// belongs to production, and the builder arranges a valid vector\n166|// without retyping production's table.\n167|func fixtureScanRequestJSON() string {\n168|\tpair := []string{fixtureInstallDigestA, fixtureInstallDigestB}\n169|\tsort.Strings(pair)\n170|\treturn fmt.Sprintf(`{\"operation_id\":%q,\"installation_ids\":[%q,%q],\"prior_batch_id\":null,\"cursor\":null,\"max_instances\":100,\"extensions\":{}}`,\n171|\t\tfixtureOperationID, pair[0], pair[1])\n172|}\n173|\n174|// fixtureScanResponseJSON is one valid scan success body.\n175|func fixtureScanResponseJSON() string {\n176|\treturn fmt.Sprintf(`{\"batch\":{\"batch_id\":%q},\"environment_observation_ids\":[%q],\"native_observation_ids\":[%q],\"next_cursor\":null,\"extensions\":{}}`,\n177|\t\tfixtureBatchDigest, fixtureEvidenceDigest, fixtureNativeDigestA)\n178|}\n179|\n180|// fixtureCallerJSON is one valid CallerContext.\n181|func fixtureCallerJSON() string {\n182|\treturn fmt.Sprintf(`{\"caller_id\":\"test-caller\",\"authentication_subject\":\"test-subject\",\"origin_host_id\":%q,\"interaction\":\"non_interactive\",\"scopes\":[\"directory.read\"],\"disclosure_policy_digest\":%q,\"extensions\":{}}`,\n183|\t\tfixtureOriginHost, fixturePolicyDigest)\n184|}\n185|\n186|// fixtureQueryJSON is one valid two-operation batch: a schema read\n187|// and a sessions read with filters.\n188|func fixtureQueryJSON() string {\n189|\treturn fmt.Sprintf(`{\"schema\":\"urn:ax:schema:session-directory-query\",\"schema_version\":\"1.0.0\",\"query_id\":%q,\"operations\":[{\"operation_index\":0,\"name\":\"schema\",\"parameters\":{\"extensions\":{}},\"fields\":null,\"preset\":null,\"skip\":0,\"take\":1,\"sort\":[],\"dry_run\":false,\"confirm\":false,\"expectation_digest\":null,\"idempotency_key\":null,\"extensions\":{}},{\"operation_index\":1,\"name\":\"sessions\",\"parameters\":{\"filters\":{\"kinds\":[],\"lineage_anchors\":[],\"provider_ids\":[],\"host_ids\":[],\"workspace_ids\":[],\"states\":[],\"management_states\":[],\"reachability\":[],\"freshness\":[],\"warnings\":[],\"updated_before\":null,\"updated_after\":null,\"extensions\":{}},\"extensions\":{}},\"fields\":null,\"preset\":\"overview\",\"skip\":0,\"take\":10,\"sort\":[{\"field\":\"stable_id\",\"direction\":\"asc\",\"extensions\":{}}],\"dry_run\":false,\"confirm\":false,\"expectation_digest\":null,\"idempotency_key\":null,\"extensions\":{}}],\"caller\":%s,\"extensions\":{}}`,\n190|\t\tfixtureQueryID, fixtureCallerJSON())\n191|}\n192|\n193|// replaceOnce substitutes the first occurrence like strings.Replace,\n194|// but fails the test when the needle is absent or the count is not\n195|// one: a fixture-surgery vector that mutates nothing would otherwise\n196|// pass vacuously against a still-valid body, measuring the scanner\n197|// instead of the gate.\n198|func replaceOnce(t *testing.T, haystack, needle, replacement string, n int) string {\n199|\tt.Helper()\n200|\tif n != 1 {\n201|\t\tt.Fatalf(\"replaceOnce: count %d is not 1\", n)\n202|\t}\n203|\tif !strings.Contains(haystack, needle) {\n204|\t\tt.Fatalf(\"replaceOnce: needle %q absent; the vector mutates nothing\", needle)\n205|\t}\n206|\treturn strings.Replace(haystack, needle, replacement, n)\n207|}\n208|\n209|// requireAxError unwraps a production refusal into its Structured\n210|// Error, failing the test when the value is a transport-level Go\n211|// error instead of a wire refusal.\n212|func requireAxError(t *testing.T, err error) *axerror.Error {\n213|\tt.Helper()\n214|\tif err == nil {\n215|\t\tt.Fatal(\"want refusal, got nil error\")\n216|\t}\n217|\tfailure, ok := err.(*axerror.Error)\n218|\tif !ok {\n219|\t\tt.Fatalf(\"want *axerror.Error, got %T (%v)\", err, err)\n220|\t}\n221|\treturn failure\n222|}\n223|\n224|// requireCode asserts the refusal code and returns the failure for\n225|// further assertions.\n226|func requireCode(t *testing.T, err error, code axerror.Code) *axerror.Error {\n227|\tt.Helper()\n228|\tfailure := requireAxError(t, err)\n229|\tif failure.Code() != code {\n230|\t\tt.Fatalf(\"refusal code = %q, want %q (detail keys %v)\", failure.Code(), code, failure.DetailKeys())\n231|\t}\n232|\treturn failure\n233|}"}}}
