!= `null` {\n1116|\t\t\t\t\tmutated = mutateMember(t, mutated, \"partial\", `true`)\n1117|\t\t\t\t}\n1118|\t\t\t\tif row.operation == OpResumePlan && row.member == \"target_native_session_id\" && (literal == quotedRepeat(row.min) || literal == quotedRepeat(row.max)) {\n1119|\t\t\t\t\tidentity := strings.Trim(literal, `\"`)\n1120|\t\t\t\t\tmutated = mutateMember(t, mutated, \"argv\", `[\"ax\",\"open\",`+strconv.Quote(identity)+`]`)\n1121|\t\t\t\t\tlocal.ResumeTargetID = identity\n1122|\t\t\t\t}\n1123|\t\t\t\treturn CheckSuccessBody(row.operation, mutated, local)\n1124|\t\t\t}\n1125|\t\t\tif err := drive(t, quotedRepeat(row.min-1)); err == nil {\n1126|\t\t\t\tt.Fatalf(\"%s admitted length %d below the %d minimum\", name, row.min-1, row.min)\n1127|\t\t\t} else {\n1128|\t\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", row.member, \"outside its bound\")\n1129|\t\t\t}\n1130|\t\t\tif err := drive(t, quotedRepeat(row.min)); err != nil {\n1131|\t\t\t\tt.Fatalf(\"%s refused length %d at the minimum: %v\", name, row.min, err)\n1132|\t\t\t}\n1133|\t\t\tif err := drive(t, quotedRepeat(row.max)); err != nil {\n1134|\t\t\t\tt.Fatalf(\"%s refused length %d at the maximum: %v\", name, row.max, err)\n1135|\t\t\t}\n1136|\t\t\tif err := drive(t, quotedRepeat(row.max+1)); err == nil {\n1137|\t\t\t\tt.Fatalf(\"%s admitted length %d past the %d maximum\", name, row.max+1, row.max)\n1138|\t\t\t} else {\n1139|\t\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", row.member, \"outside its bound\")\n1140|\t\t\t}\n1141|\t\t})\n1142|\t}\n1143|\tuints := []struct {\n1144|\t\toperation Operation\n1145|\t\tmember    string\n1146|\t\tfiniteMax bool\n1147|\t}{\n1148|\t\t{OpCapturePlan, \"candidate_count\", true},\n1149|\t\t{OpCapture, \"item_count\", true},\n1150|\t\t{OpReadBack, \"parsed_event_count\", false},\n1151|\t}\n1152|\tfor _, row := range uints {\n1153|\t\trow := row\n1154|\t\tname := string(row.operation) + \"/\" + row.member\n1155|\t\