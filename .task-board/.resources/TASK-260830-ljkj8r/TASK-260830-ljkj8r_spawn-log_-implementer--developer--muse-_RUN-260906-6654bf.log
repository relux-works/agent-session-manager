r_protocol_error\", \"member\", \"warnings\", \"sorted unique string[0..2048][0..1024]\")\n1344|\t\t}\n1345|\t\tif err := drive(sortedStrings(\"w-%05d\", 1024)); err != nil {\n1346|\t\t\tt.Fatalf(\"refused 1024 warnings at the maximum: %v\", err)\n1347|\t\t}\n1348|\t})\n1349|\tt.Run(\"root handle names\", func(t *testing.T) {\n1350|\t\tdrive := func(value string) error {\n1351|\t\t\t_, err := DecodeReadAuthority(mutateMember(t, []byte(fixtureReadAuthorityJSON()), \"root_handle_names\", value))\n1352|\t\t\treturn err\n1353|\t\t}\n1354|\t\tif err := drive(`[\"\"]`); err == nil {\n1355|\t\t\tt.Fatal(\"admitted an empty handle name\")\n1356|\t\t} else {\n1357|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"root_handle_names\", \"sorted unique string[1..128][1..128]\")\n1358|\t\t}\n1359|\t\tif err := drive(`[` + quotedRepeat(129) + `]`); err == nil {\n1360|\t\t\tt.Fatal(\"admitted a 129-character handle name\")\n1361|\t\t} else {\n1362|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"root_handle_names\", \"sorted unique string[1..128][1..128]\")\n1363|\t\t}\n1364|\t\tif err := drive(sortedStrings(\"h-%03d\", 129)); err == nil {\n1365|\t\t\tt.Fatal(\"admitted 129 handle names past the 128 maximum\")\n1366|\t\t} else {\n1367|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"root_handle_names\", \"sorted unique string[1..128][1..128]\")\n1368|\t\t}\n1369|\t\tif err := drive(sortedStrings(\"h-%03d\", 128)); err != nil {\n1370|\t\t\tt.Fatalf(\"refused 128 handle names at the maximum: %v\", err)\n1371|\t\t}\n1372|\t})\n1373|}\n1374|\n1375|// validFindingLiteral is one closed AdapterFinding used to fill\n1376|// count-bound arrays without tripping element gates.\n1377|const validFindingLiteral = `{\"severity\":\"info\",\"code\":\"c\",\"message\":\"m\",\"remediation\":null,\"extensions\":{}}`\n1378|\n1379|// findingArray builds n valid findings as a JSON array.\n1380|func findingArray(n int) string {\n1381|\treturn `[` + strings.Join(repeatLiteral(validFindingLiteral, n), \",\") + `]`\n1382|}\n1383|\n1384|func repeatLiteral(literal string, n int) []string {\n1385|\tout := make([]string, 0, n)\n1386|\tfor i := 0; i < n; i++ {\n1387|\t\tout = append(out, literal)\n1388|\t}\n1389|\treturn out\n1390|}\n1391|\n1392|// TestFindingsCapEdges drives every DecodeFindings cap\n1393|// instantiation at its edge through the production entry: the\n1394|// cap admits, cap+1 refuses naming the count bound. The four\n1395|// instantiations share one generic guard; each value is pinned\n1396|// where it is passed.\n1397|func TestFindingsCapEdges(t *testing.T) {\n1398|\tmanifestDigest := fixtureManifestDigestText(t)\n1399|\tt.Run(\"inspect ambiguities 1024\", func(t *testing.T) {\n1400|\t\t_, facts := successFactsFor(t, OpInspect, manifestDigest)\n1401|\t\tdrive := func(t *testing.T, value string) error {\n1402|\t\t\trequest := fixtureRequestBody(t, OpInspect, manifestDigest)\n1403|\t\t\tdecoded, err := CheckRequestBody(OpInspect, request)\n1404|\t\t\tif err != nil {\n1405|\t\t\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n1406|\t\t\t}\n1407|\t\t\tlocal := facts\n1408|\t\t\tlocal.Context = decoded\n1409|\t\t\tbase := fixtureSuccessBody(t, OpInspect, requestContextOf(t, request), manifestDigest)\n1410|\t\t\treturn CheckSuccessBody(OpInspect, mutateMember(t, base, \"ambiguities\", value), local)\n1411|\t\t}\n1412|\t\tif err := drive(t, findingArray(1025)); err == nil {\n1413|\t\t\tt.Fatal(\"admitted 1025 ambiguities past the 1024 cap\")\n1414|\t\t} else {\n1415|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"findings\", \"exceed the count bound\")\n1416|\t\t}\n1417|\t\tif err := drive(t, findingArray(1024)); err != nil {\n1418|\t\t\tt.Fatalf(\"refused 1024 ambiguities at the cap: %v\", err)\n1419|\t\t}\n1420|\t})\n1421|\tfor _, operation := range []Operation{OpProjectionPlan, OpValidate, OpDoctor} {\n1422|\t\toperation := operation\n1423|\t\tt.Run(string(operation)+\" findings 4096\", func(t *testing.T) {\n1424|\t\t\t_, facts := successFactsFor(t, operation, manifestDigest)\n1425|\t\t\tif operation == OpValidate {\n1426|\t\t\t\tfacts.ValidateMode = \"staged\"\n1427|\t\t\t}\n1428|\t\t\tif operation == OpDoctor {\n1429|\t\t\t\tfacts.DoctorDirection = DirectionSourceRead\n1430|\t\t\t}\n1431|\t\t\tdrive := func(t *testing.T, value string) error {\n1432|\t\t\t\trequest := fixtureRequestBody(t, operation, manifestDigest)\n1433|\t\t\t\tdecoded, err := CheckRequestBody(operation, request)\n1434|\t\t\t\tif err != nil {\n1435|\t\t\t\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n1436|\t\t\t\t}\n1437|\t\t\t\tlocal := facts\n1438|\t\t\t\tlocal.Context = decoded\n1439|\t\t\t\tbase := fixtureSuccessBody(t, operation, requestContextOf(t, request), manifestDigest)\n1440|\t\t\t\treturn CheckSuccessBody(operation, mutateMember(t, base, \"findings\", value), local)\n1441|\t\t\t}\n1442|\t\t\tif err := drive(t, findingArray(4097)); err == nil {\n1443|\t\t\t\tt.Fatalf(\"%s admitted 4097 findings past the 4096 cap\", operation)\n1444|\t\t\t} else {\n1445|\t\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"findings\", \"exceed the count bound\")\n1446|\t\t\t}\n1447|\t\t\tif err := drive(t, findingArray(4096)); err != nil {\n1448|\t\t\t\tt.Fatalf(\"%s refused 4096 findings at the cap: %v\", operation, err)\n1449|\t\t\t}\n1450|\t\t})\n1451|\t}\n1452|}\n1453|\n1454|// TestExtensionKeyBoundEdges drives the reverse-DNS extension key\n1455|// bounds at both edges through DecodeManifest: 2 refuses, 3\n1456|// admits, 253 admits, 254 refuses.\n1457|func TestExtensionKeyBoundEdges(t *testing.T) {\n1458|\tvalid253 := \"a\" + strings.Repeat(\".b\", 126)\n1459|\tif len(valid253) != 253 {\n1460|\t\tt.Fatalf(\"scaffold key = %d chars, want 253\", len(valid253))\n1461|\t}\n1462|\tdrive := func(value string) error {\n1463|\t\t_, err := DecodeManifest(mutateMember(t, []byte(fixtureManifestJSON()), \"extensions\", value