 + `,` + quote(pair[0]) + `]`\n+\tif pair[0] == pair[1] {\n+\t\tt.Fatal(\"fixture installation digests collide; the unsorted vector is unbuildable\")\n+\t}\n+\trows := []struct {\n+\t\tname   string\n+\t\toperation string\n+\t\tparams string\n+\t\tbatch  string\n+\t}{\n+\t\t{\"schema extra parameter\", \"schema\", `{\"extensions\":{},\"extra\":1}`, \"\"},\n+\t\t{\"directory summary extra parameter\", \"directory_summary\", `{\"extensions\":{},\"extra\":1}`, \"\"},\n+\t\t{\"sessions bad reachability\", \"sessions\", \"\", \"\"},\n+\t\t{\"sessions bad provider id\", \"sessions\", \"\", \"\"},\n+\t\t{\"sessions bad kind\", \"sessions\", \"\", \"\"},\n+\t\t{\"sessions bad management state\", \"sessions\", \"\", \"\"},\n+\t\t{\"sessions bad freshness\", \"sessions\", \"\", \"\"},\n+\t\t{\"sessions bad lineage anchor\", \"sessions\", \"\", \"\"},\n+\t\t{\"sessions warning past element bound\", \"sessions\", \"\", \"\"},\n+\t\t{\"count fields require null\", \"count\", \"\", \"\"},\n+\t\t{\"count take requires one\", \"count\", \"\", \"\"},\n+\t\t{\"session lineage kind refused\", \"session\", \"\", \"\"},\n+\t\t{\"session bad subject id\", \"session\", \"\", \"\"},\n+\t\t{\"lineage bad anchor\", \"lineage\", \"\", \"\"},\n+\t\t{\"lineage non-bool suggestions\", \"lineage\", \"\", \"\"},\n+\t\t{\"hosts bad host id\", \"hosts\", \"\", \"\"},\n+\t\t{\"hosts non-bool reachable\", \"hosts\", \"\", \"\"},\n+\t\t{\"environments root status refused\", \"environments\", \"\", \"\"},\n+\t\t{\"environments bad environment id\", \"environments\", \"\", \"\"},\n+\t\t{\"environments unsorted environment ids\", \"environments\", \"\", \"\"},\n+\t\t{\"jobs pwned state refused\", \"jobs\", \"\", \"\"},\n+\t\t{\"jobs bad job id\", \"jobs\", \"\", \"\"},\n+\t\t{\"jobs bad profile id\", \"jobs\", \"\", \"\"},\n+\t\t{\"plans non-bool include expired\", \"plans\", \"\", \"\"},\n+\t\t{\"plans bad plan id\", \"plans\", \"\", \"\"},\n+\t\t{\"plans bad operation id\", \"plans\", \"\", \"\"},\n+\t\