mum at\n37|// max-1/min/max/max+1 through its production entry point.\n38|func TestStringBoundEdges(t *testing.T) {\n39|\trows := []stringBoundRow{\n40|\t\t{\n41|\t\t\tname: \"manifest environment_version_range\", min: 1, max: 256,\n42|\t\t\tmember: \"environment_version_range\", text: \"string[1..256]\",\n43|\t\t\tdrive: func(t *testing.T, literal string) error {\n44|\t\t\t\t_, err := DecodeManifest(mutateMember(t, []byte(fixtureManifestJSON()), \"environment_version_range\", literal))\n45|\t\t\t\treturn err\n46|\t\t\t},\n47|\t\t},\n48|\t\t{\n49|\t\t\tname: \"source native_session_id\", min: 1, max: 512,\n50|\t\t\tmember: \"native_session_id\", text: \"string[1..512]\",\n51|\t\t\tdrive: func(t *testing.T, literal string) error {\n52|\t\t\t\t_, err := DecodeSourceSelector([]byte(`{\"native_session_id\":` + literal + `,\"logical_workspace_id\":null,\"opaque_source_ref\":null}`))\n53|\t\t\t\treturn err\n54|\t\t\t},\n55|\t\t},\n56|\t\t{\n57|\t\t\tname: \"source opaque_source_ref\", min: 1, max: 512,\n58|\t\t\tmember: \"opaque_source_ref\", text: \"string[1..512]\",\n59|\t\t\tdrive: func(t *testing.T, literal string) error {\n60|\t\t\t\t_, err := DecodeSourceSelector([]byte(`{\"native_session_id\":null,\"logical_workspace_id\":null,\"opaque_source_ref\":` + literal + `}`))\n61|\t\t\t\treturn err\n62|\t\t\t},\n63|\t\t},\n64|\t\t{\n65|\t\t\tname: \"finding code\", min: 1, max: 128,\n66|\t\t\tmember: \"code\", text: \"string[1..128]\",\n67|\t\t\tdrive: func(t *testing.T, literal string) error {\n68|\t\t\t\tvalid := `{\"severity\":\"warning\",\"code\":\"cap-1\",\"message\":\"a warning\",\"remediation\":null,\"extensions\":{}}`\n69|\t\t\t\t_, err := DecodeFinding(mutateMember(t, []byte(valid), \"code\", literal))\n70|\t\t\t\treturn err\n71|\t\t\t},\n72|\t\t},\n73|\t\t{\n74|\t\t\tname: \"finding message\", min: 1, max: 4096,\n75|\t\t\tmember: \"message\", text: \"string[1..4096]\",\n76|\t\t\tdrive: func(t *testing.T, literal string) error {\n77|\t\t\t\tvalid := `{\"severity\":\"warning\",\"code\":\"cap-1\",\"message\":\"a warning\",\"remediation\":null,\"extensions\":{}}`\n78|\t\t\t\t_, err := DecodeFinding(mutateMember(t, []byte(valid), \"message\", literal))\n79|\t\t\t\treturn err\n80|\t\t\t},\n81|\t\t},\n82|\t\t{\n83|\t\t\tname: \"finding remediation\", min: 1, max: 4096,\n84|\t\t\tmember: \"remediation\", text: \"string[1..4096]\",\n85|\t\t\tdrive: func(t *testing.T, literal string) error {\n86|\t\t\t\tvalid := `{\"severity\":\"warning\",\"code\":\"cap-1\",\"message\":\"a warning\",\"remediation\":null,\"extensions\":{}}`\n87|\t\t\t\t_, err := DecodeFinding(mutateMember(t, []byte(valid), \"remediation\", literal))\n88|\t\t\t\treturn err\n89|\t\t\t},\n90|\t\t},\n91|\t\t{\n92|\t\t\tname: \"capture native_item_key\", min: 1, max: 512,\n93|\t\t\tmember: \"native_item_key\", text: \"string[1..512]\",\n94|\t\t\tdrive: func(t *testing.T, literal string) error {\n95|\t\t\t\tvalid := `{\"native_item_key\":\"item-1\",\"class\":\"durable_payload\",\"byte_count\":12,\"required\":true,\"extensions\":{}}`\n96|\t\t\t\t_, err := DecodeCapturePlanItem(mutateMember(t, []byte(valid), \"native_item_key\", literal))\n97|\t\t\t\treturn err\n98|\t\t\t},\n99|\t\t},\n100|\t\t{\n101|\t\t\tname: \"resume argv word\", min: 1, max: 4096,\n102|\t\t\tmember: \"argv\", text: \"string[1..4096]\",\n103|\t\t\tdrive: func(t *testing.T, literal string) error {\n104|\t\t\t\treturn checkResumeArgv(t, `[\"target-1\",`+literal+`]`)\n105|\t\t\t},\n106|\t\t},\n107|\t\t{\n108|\t\t\tname: \"tuple environment_version\", min: 1, max: 128,\n109|\t\t\tmember: \"environment_version\", text: \"string[1..128]\",\n110|\t\t\tdrive: func(t *testing.T, literal string) error {\n111|\t\t\t\t_, err := DecodeTuple(mutateMember(t, []byte(fixtureTupleJSON()), \"environment_version\", literal))\n112|\t\t\t\treturn err\n113|\t\t\t},\n114|\t\t},\n115|\t\t{\n116|\t\t\tname: \"tuple suite_revision\", min: 1, max: 128,\n117|\t\t\tmember: \"suite_revision\", text: \"string[1..128]\",\n118|\t\t\tdrive: func(t *testing.T, literal string) error {\n119|\t\t\t\t_, err := DecodeTupleEntry(mutateNested(t, []byte(fixtureEntryJSON(DirectionTargetWrite)), \"fixture_evidence\", \"suite_revision\", literal))\n120|\t\t\t\treturn err\n121|\t\t\t},\n122|\t\t},\n123|\t\t{\n124|\t\t\tname: \"tuple native_cli_family\", min: 1, max: 128,\n125|\t\t\tmember: \"native_cli_family\", text: \"string[1..128]\",\n126|\t\t\tdrive: func(t *testing.T, literal string) error {\n127|\t\t\t\t_, err := DecodeTupleEntry(mutateNested(t, []byte(fixtureEntryJSON(DirectionTargetWrite)), \"resume_smoke_evidence\", \"native_cli_family\", literal))\n128|\t\t\t\treturn err\n129|\t\t\t},\n130|\t\t},\n131|\t\t{\n132|\t\t\tname: \"fidelity code\", min: 1, max: 128,\n133|\t\t\tmember: \"code\", text: \"string[1..128]\",\n134|\t\t\tdrive: func(t *testing.T, literal string) error {\n135|\t\t\t\t_, err := DecodeTupleEntry(withFidelityLimits(t, `[`+fidelityRow(literal, `\"c\"`, `\"d\"`)+`]`, DirectionTargetWrite))\n136|\t\t\t\treturn err\n137|\t\t\t},\n138|\t\t},\n139|\t\t{\n140|\t\t\tname: \"fidelity affected_class\", min: 1, max: 128,\n141|\t\t\tmember: \"affected_class\", text: \"string[1..128]\",\n142|\t\t\tdrive: func(t *testing.T, literal string) error {\n143|\t\t\t\t_, err := DecodeTupleEntry(withFidelityLimits(t, `[`+fidelityRow(`\"c\"`, literal, `\"d\"`)+`]`, DirectionTargetWrite))\n144|\t\t\t\treturn err\n145|\t\t\t},\n146|\t\t},\n147|\t\t{\n148|\t\t\tname: \"fidelity detail\", min: 1, max: 4096,\n149|\t\t\tmember: \"detail\", text: \"string[1..4096]\",\n150|\t\t\tdrive: func(t *testing.T, literal string) error {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c53b","stream":{"kind":"session","id":"01a07573-a73b-7be0-abe2-6029bca74ffd"},"sequence":248,"recorded_at":1780531400000491,"record_type":"event","durability":"durable","causation_id":"65c281d8-14aa-4def-b705-62e70b4fce66","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"65c281d8-14aa-4def-b705-62e70b4fce66","run_stream":{"kind":"run","id":"65c281d8-14aa-4def-b705-62e70b4fce66"},"call_id":"call_01a075742a2573e19d91fbd982c0dc16","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/dirnode/census_test.go`.\n1|package dirnode\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"sort\"\n10|\t\"strconv\"\n11|\t\"strings\"\n12|\t\"testing\"\n13|)\n14|\n15|// This file is the derived refusal-arm inventory. It exists\n16|// because a new refusal through an existing site — a widened\n17|// member set, a new detail literal, a dropped check that slides\n18|// to a lower arm — leaves the whole suite green unless the arm\n19|// set is derived from production source by parsing it, never by\n20|// listing it.\n21|//\n22|// Derivation (deriveRefusalArms): every call to one of the eight\n23|// refusal constructors with a string-literal first argument\n24|// yields ctor|<constructor>|<detail>; a call whose first argument\n25|// is a binary expression yields\n26|// ctor|<constructor>|expr|<function>|<rendered>, where the render\n27|// keeps literal text, identifier names, and selector paths, so a\n28|// context-prefixed envelope arm and a fault-detail conduit never\n29|// merge with each other or with a literal arm; every\n30|// &frameFault{...} literal yields frame|<detail>. A constructor\n31|// call with any other first-argument shape is a derivation\n32|// violation, not a silent pass. Constructor references outside\n33|// direct-call position fail the derivation outright: an aliased\n34|// constructor hides every arm it builds. All alias spellings are\n35|// caught — `alias := failX`, `var alias = failX` at package\n36|// level, `var alias = failX` inside a function body, arguments,\n37|// returns, struct fields, assignments — because the gate exempts\n38|// only the definition's own Name in its ValueSpec, never a\n39|// constructor identifier appearing anywhere else. The\n40|// constructors of this package are themselves declared as\n41|// `var failX = func...`, so their definition Names stay exempt\n42|// while any other reference fails. A refusal call inside any\n43|// function literal that is not a registered constructor body\n44|// fails: an arm that fires only when a closure runs is not a\n45|// call-site arm.\n46|//\n47|// The constructor denominator is itself derived, not listed on\n48|// trust: TestRefusalConstructorsMatchProduction requires the\n49|// registered set to equal the eight named constructors, every\n50|// axerror.New site in production to sit inside one registered\n51|// body, and no func-value indirection of axerror.New anywhere.\n52|// A ninth constructor, an inline axerror.New refusal, or a\n53|// `var newFault = axerror.New` indirection carries an additive\n54|// arm the derivation never observes, and fails there instead of\n55|// passing silently.\n56|//\n57|// Both directions are checked:\n58|// TestDerivedRefusalArmsAreAllWitnessed (every derived arm\n59|// carries a witness) and TestWitnessedArmsAreAllDerived (every\n60|// witness names a derived arm, so a truncated derivation reddens\n61|// on the orphaned witnesses instead of passing vacuously).\n62|// TestEveryArmWitnessRefusesAtTheProductionEntry is intentionally\n63|// a resolve-and-run check rather than prose: every witness names\n64|// test functions that exist in this package's test files, and\n65|// those tests drive the production entries with negative vectors\n66|// asserting code plus distinguishing detail. Empty, single-file,\n67|// or unparseable derivations fail closed: a domain that silently\n68|// derives nothing is not a measurement.\n69|//\n70|// Shape space. An error construction in this package can only be\n71|// carried by these AST shapes; the census derives or refuses each\n72|// one:\n73|//\n74|//  1. A direct `failX(\"literal\", ...)` call — DERIVED as an arm\n75|//     keyed by the literal detail.\n76|//  2. A direct `failX(<binary>, ...)` call — DERIVED as an arm\n77|//     keyed by function and rendered expression. The two\n78|//     sub-shapes in production are the fault-detail conduit\n79|//     (`\"prefix \"+fault.detail`, eleven sites) and the\n80|//     envelope-branch prefix (`context+\" suffix\"`, eleven\n81|//     sites in checkResponseIdentity); both render distinctly,\n82|//     so neither merges.\n83|//  3. A direct `failX(<other>, ...)` call — REFUSED as a\n84|//     derivation violation (zero such sites exist; the first\n85|//     one fails the census instead of passing silently).\n86|//  4. A package-level `var failY = func...` literal whose body\n87|//     calls axerror.New — DERIVED as a constructor: the\n88|//     produced set must equal refusalConstructors exactly, so\n89|//     a ninth constructor fails as unregistered.\n90|//  5. An axerror.New call outside every registered literal —\n91|//     REFUSED as a construction site outside the registered\n92|//     bodies.\n93|//  6. An axerror.New selector in non-call position (alias var,\n94|//     returned constructor, argument, struct field) — REFUSED\n95|//     as a func-value indirection (the import census pins the\n96|//     `axerror` binding it matches on).\n97|//  7. A failX identifier in non-call, non-definition position\n98|//     (alias var/:=, assignment, argument, return, struct\n99|//     field) — REFUSED as a constructor alias that would bury\n100|//     every arm built through it.\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c53d","stream":{"kind":"session","id":"01a07573-a73b-7be0-abe2-6029bca74ffd"},"sequence":249,"recorded_at":1780531400000493,"record_type":"event","durability":"durable","causation_id":"65c281d8-14aa-4def-b705-62e70b4fce66","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"65c281d8-14aa-4def-b705-62e70b4fce66","run_stream":{"kind":"run","id":"65c281d8-14aa-4def-b705-62e70b4fce66"},"call_id":"call_01a075742b1478d3bb45df54b13a12ab","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/dirnode/query_test.go`.\n1|package dirnode\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|)\n7|\n8|// TestDecodeQueryAcceptsFixture drives the production query entry\n9|// with the exact contract vector: the batch identifier, the two\n10|// position-indexed operations with their halves, and the caller.\n11|func TestDecodeQueryAcceptsFixture(t *testing.T) {\n12|\tt.Parallel()\n13|\tquery, err := DecodeQuery([]byte(fixtureQueryJSON()))\n14|\tif err != nil {\n15|\t\tt.Fatalf(\"DecodeQuery error = %v\", err)\n16|\t}\n17|\tif query.QueryID != fixtureQueryID {\n18|\t\tt.Fatalf(\"query id = %q\", query.QueryID)\n19|\t}\n20|\tif len(query.Operations) != 2 {\n21|\t\tt.Fatalf(\"operations = %d, want 2\", len(query.Operations))\n22|\t}\n23|\tif query.Operations[0].Index != 0 || query.Operations[0].Name != \"schema\" || query.Operations[0].Kind != queryKindRead {\n24|\t\tt.Fatalf(\"operation 0 = %+v\", query.Operations[0])\n25|\t}\n26|\tif query.Operations[1].Index != 1 || query.Operations[1].Name != \"sessions\" || query.Operations[1].Kind != queryKindRead {\n27|\t\tt.Fatalf(\"operation 1 = %+v\", query.Operations[1])\n28|\t}\n29|\tif query.Caller.CallerID != \"test-caller\" || query.Caller.Interaction != \"non_interactive\" || len(query.Caller.Scopes) != 1 {\n30|\t\tt.Fatalf(\"caller = %+v\", query.Caller)\n31|\t}\n32|}\n33|\n34|// TestDecodeQueryIndexRules drives the production query entry\n35|// with index defects: duplicate, sparse, reordered, and\n36|// position-mismatched indexes invalidate the whole batch before\n37|// any operation executes.\n38|func TestDecodeQueryIndexRules(t *testing.T) {\n39|\tt.Parallel()\n40|\tgood := fixtureQueryJSON()\n41|\tschemaOp := `{\"operation_index\":0,\"name\":\"schema\",\"parameters\":{\"extensions\":{}},\"fields\":null,\"preset\":null,\"skip\":0,\"take\":1,\"sort\":[],\"dry_run\":false,\"confirm\":false,\"expectation_digest\":null,\"idempotency_key\":null,\"extensions\":{}}`\n42|\tduplicate := replaceOnce(t, good, `\"operation_index\":1`, `\"operation_index\":0`, 1)\n43|\tsparse := replaceOnce(t, good, `\"operation_index\":1`, `\"operation_index\":2`, 1)\n44|\treordered := replaceOnce(t, good, `\"operations\":[`+schemaOp+`,`, `\"operations\":[`, 1)\n45|\treordered = replaceOnce(t, reordered, `],\"caller\"`, `,`+schemaOp+`],\"caller\"`, 1)\n46|\tempty := `{\"schema\":\"urn:ax:schema:session-directory-query\",\"schema_version\":\"1.0.0\",\"query_id\":\"` + fixtureQueryID + `\",\"operations\":[],\"caller\":` + fixtureCallerJSON() + `,\"extensions\":{}}`\n47|\tfor _, probe := range []struct {\n48|\t\tname string\n49|\t\tbody string\n50|\t}{\n51|\t\t{\"duplicate index\", duplicate},\n52|\t\t{\"sparse index\", sparse},\n53|\t\t{\"reordered operations\", reordered},\n54|\t\t{\"dropped first operation\", replaceOnce(t, good, `\"operations\":[`+schemaOp+`,`, `\"operations\":[`, 1)},\n55|\t\t{\"empty batch\", empty},\n56|\t} {\n57|\t\tt.Run(probe.name, func(t *testing.T) {\n58|\t\t\tt.Parallel()\n59|\t\t\tif _, err := DecodeQuery([]byte(probe.body)); requireCode(t, err, \"query_invalid\") == nil {\n60|\t\t\t\tt.Fatal(\"must refuse\")\n61|\t\t\t}\n62|\t\t})\n63|\t}\n64|}\n65|\n66|// TestDecodeQueryEnvelopeRules drives the production query entry\n67|// with one envelope vector per rule.\n68|func TestDecodeQueryEnvelopeRules(t *testing.T) {\n69|\tt.Parallel()\n70|\tgood := fixtureQueryJSON()\n71|\tfor _, probe := range []struct {\n72|\t\tname string\n73|\t\tbody string\n74|\t}{\n75|\t\t{\"unknown member\", replaceOnce(t, good, `\"extensions\":{}}`, `\"extensions\":{},\"extra\":1}`, 1)},\n76|\t\t{\"missing caller\", replaceOnce(t, good, `,\"caller\":`, `,\"callerX\":`, 1)},\n77|\t\t{\"wrong schema\", replaceOnce(t, good, \"session-directory-query\", \"session-directory-node-request\", 1)},\n78|\t\t{\"wrong version\", replaceOnce(t, good, `\"schema_version\":\"1.0.0\"`, `\"schema_version\":\"2.0.0\"`, 1)},\n79|\t\t{\"bad query id\", replaceOnce(t, good, fixtureQueryID, \"not-a-uuid\", 1)},\n80|\t\t{\"bad caller scope\", replaceOnce(t, good, `\"directory.read\"`, `\"directory.root\"`, 1)},\n81|\t\t{\"empty scopes\", replaceOnce(t, good, `\"scopes\":[\"directory.read\"]`, `\"scopes\":[]`, 1)},\n82|\t\t{\"bad interaction\", replaceOnce(t, good, `\"non_interactive\"`, `\"whenever\"`, 1)},\n83|\t\t{\"bad origin host\", replaceOnce(t, good, fixtureOriginHost, \"not-a-uuid\", 1)},\n84|\t\t{\"non object\", `[]`},\n85|\t} {\n86|\t\tt.Run(probe.name, func(t *testing.T) {\n87|\t\t\tt.Parallel()\n88|\t\t\tif _, err := DecodeQuery([]byte(probe.body)); requireCode(t, err, \"query_invalid\") == nil {\n89|\t\t\t\tt.Fatal(\"must refuse\")\n90|\t\t\t}\n91|\t\t})\n92|\t}\n93|}\n94|\n95|// TestDecodeQueryRegistryRules drives the production query entry\n96|// with unknown operations, unknown parameters, and unknown\n97|// filters: the parser rejects the whole batch on unknown syntax,\n98|// operation, parameter, field, preset, filter, sort key, or\n99|// bound.\n100|func TestDecodeQueryRegistryRules(t *testing.T) {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
