\", replaceOnce(t, good, `\"code\":\"probe-ok\"`, `\"code\":\"\"`, 1)},\n151|\t\t{\"empty finding message\", replaceOnce(t, good, `\"message\":\"probe completed\"`, `\"message\":\"\"`, 1)},\n152|\t\t{\"non string remediation\", replaceOnce(t, good, `\"remediation\":null`, `\"remediation\":0`, 1)},\n153|\t\t{\"non object\", `[]`},\n154|\t} {\n155|\t\tt.Run(probe.name, func(t *testing.T) {\n156|\t\t\tt.Parallel()\n157|\t\t\tif _, err := CheckProbeResponse([]byte(probe.body)); requireCode(t, err, \"adapter_protocol_violation\") == nil {\n158|\t\t\t\tt.Fatal(\"must refuse\")\n159|\t\t\t}\n160|\t\t})\n161|\t}\n162|}\n163|\n164|// TestProbeResponseFindingBound drives the production probe\n(more lines below)"}}}
