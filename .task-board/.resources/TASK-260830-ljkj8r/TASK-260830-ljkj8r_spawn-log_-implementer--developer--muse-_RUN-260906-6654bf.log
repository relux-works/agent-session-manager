{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc17","stream":{"kind":"session","id":"01a07573-a73b-7be0-abe2-6029bca74ffd"},"sequence":1126,"recorded_at":1780531400002247,"record_type":"event","durability":"durable","causation_id":"65c281d8-14aa-4def-b705-62e70b4fce66","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"65c281d8-14aa-4def-b705-62e70b4fce66","run_stream":{"kind":"run","id":"65c281d8-14aa-4def-b705-62e70b4fce66"},"task_stream":{"kind":"task","id":"4536f793-b5b4-45f8-86e5-e583304faa3c"},"task_id":"4536f793-b5b4-45f8-86e5-e583304faa3c","event":{"kind":"output","task_id":"4536f793-b5b4-45f8-86e5-e583304faa3c","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/dirnode/manifest_test.go`.\n(99 line(s) above)\n100|}\n101|\n102|// deepExtensionsSwap replaces the manifest top-level extensions\n103|// object with a deeply nested one.\n104|func deepExtensionsSwap(t *testing.T, good, nested string) string {\n105|\tt.Helper()\n106|\tneedle := `\"extensions\":{}},\"extensions\":{}}`\n107|\tif !strings.Contains(good, needle) {\n108|\t\tt.Fatalf(\"manifest tail needle absent\")\n109|\t}\n110|\treturn replaceOnce(t, good, `\"extensions\":{}},\"extensions\":{}}`, `\"extensions\":{}},\"extensions\":{\"com.example.deep\":`+nested+`}}`, 1)\n111|}\n112|\n113|// TestDecodeManifestRegistryRules drives the production manifest\n114|// entry against the registry members: reordered, dropped, padded,\n115|// and mis-sorted registries refuse, as do out-of-bound schema\n116|// counts and malformed assertions.\n117|func TestDecodeManifestRegistryRules(t *testing.T) {\n118|\tt.Parallel()\n119|\tgood := fixtureManifestJSON()\n120|\tswapped := replaceOnce(t, good, `\"operations\":[\"continuation-inspect\",\"doctor\"`, `\"operations\":[\"doctor\",\"continuation-inspect\"`, 1)\n121|\tdropped := replaceOnce(t, good, `,\"scan\"`, ``, 1)\n122|\tpadded := replaceOnce(t, good, `,\"scan\"]`, `,\"scan\",\"query\"]`, 1)\n123|\tunsortedSchemas := replaceOnce(t, good, `schema:contract-00`, `schema:contract-zz`, 1)\n124|\tfewSchemas := replaceOnce(t, good, `{\"contract_id\":\"urn:ax:schema:contract-00\",\"exact_version\":\"1.0.0\",\"extensions\":{}},`, ``, 1)\n125|\tbadAssertion := replaceOnce(t, good, `\"exact_version\":\"1.0.0\"`, `\"exact_version\":\"one\"`, 1)\n126|\textraAssertionMember := replaceOnce(t, good, `\"exact_version\":\"1.0.1\"`, `\"exact_version\":\"1.0.1\",\"tier\":\"gold\"`, 1)\n127|\tfor _, probe := range []struct {\n128|\t\tname string\n129|\t\tbody string\n130|\t}{\n131|\t\t{\"reordered operations\", swapped},\n132|\t\t{\"dropped operation\", dropped},\n133|\t\t{\"padded operation\", padded},\n134|\t\t{\"unsorted schemas\", unsortedSchemas},\n135|\t\t{\"fourteen schemas\", fewSchemas},\n136|\t\t{\"non semver assertion\", badAssertion},\n137|\t\t{\"assertion extra member\", extraAssertionMember},\n138|\t\t{\"empty versions\", replaceOnce(t, good, `\"supported_protocol_versions\":[\"1.0.0\",\"2.0.0\"]`, `\"supported_protocol_versions\":[]`, 1)},\n139|\t\t{\"unsorted versions\", replaceOnce(t, good, `\"supported_protocol_versions\":[\"1.0.0\",\"2.0.0\"]`, `\"supported_protocol_versions\":[\"2.0.0\",\"1.0.0\"]`, 1)},\n140|\t\t{\"non semver version\", replaceOnce(t, good, `\"supported_protocol_versions\":[\"1.0.0\",\"2.0.0\"]`, `\"supported_protocol_versions\":[\"1.0.0\",\"two\"]`, 1)},\n141|\t} {\n142|\t\tt.Run(probe.name, func(t *testing.T) {\n143|\t\t\tt.Parallel()\n144|\t\t\tif _, err := DecodeManifest([]byte(probe.body)); requireCode(t, err, \"adapter_protocol_violation\") == nil {\n145|\t\t\t\tt.Fatal(\"must refuse\")\n146|\t\t\t}\n147|\t\t})\n148|\t}\n149|}\n150|\n151|// TestManifestCapabilityReasonCoherence drives the production\n152|// manifest entry through the reason-coherence rule in both\n153|// directions: available with a reason refuses, and every\n154|// non-available status without a reason refuses.\n155|func TestManifestCapabilityReasonCoherence(t *testing.T) {\n156|\tt.Parallel()\n157|\tgood := fixtureManifestJSON()\n158|\tavailableWithReason := replaceOnce(t, good, `\"directory_discovery\":{\"status\":\"available\",\"reason_code\":null`, `\"directory_discovery\":{\"status\":\"available\",\"reason_code\":\"x\"`, 1)\n159|\tconditionalWithoutReason := replaceOnce(t, good, `\"directory_head_digest\":{\"status\":\"conditional\",\"reason_code\":\"needs-quiesce\"`, `\"directory_head_digest\":{\"status\":\"conditional\",\"reason_code\":null`, 1)\n160|\tunavailableWithoutReason := replaceOnce(t, good, `\"directory_tail_preview\":{\"status\":\"unavailable\",\"reason_code\":\"not-probed\"`, `\"directory_tail_preview\":{\"status\":\"unavailable\",\"reason_code\":null`, 1)\n161|\tunknownStatus := replaceOnce(t, good, `\"native_runtime_observation\":{\"status\":\"unknown\"`, `\"native_runtime_observation\":{\"status\":\"maybe\"`, 1)\n162|\tninthCapability := replaceOnce(t, good, `\"native_resume\":{\"status\":\"available\"`, `\"native_resume\":{\"status\":\"available\"},\"directory_time_travel\":{\"status\":\"available\",\"reason_code\":null,\"evidence_ids\":[],\"observed_at\":\"2026-08-19T04:05:00.000Z\",\"extensions\":{}}`, 1)\n163|\tmissingCapability := replaceOnce(t, good, `,\"native_resume\":{\"status\":\"available\",\"reason_code\":null,\"evidence_ids\":[],\"observed_at\":\"2026-08-19T04:05:00.000Z\",\"extensions\":{}}`, ``, 1)\n164|\tfor _, probe := range []struct {\n165|\t\tname string\n166|\t\tbody string\n167|\t}{\n168|\t\t{\"available with reason\", availableWithReason},\n169|\t\t{\"conditional without reason\", conditionalWithoutReason},\n170|\t\t{\"unavailable without reason\", unavailableWithoutReason},\n171|\t\t{\"unknown status token\", unknownStatus},\n172|\t\t{\"ninth capability\", ninthCapability},\n173|\t\t{\"missing capability\", missingCapability},\n174|\t} {\n175|\t\tt.Run(probe.name, func(t *testing.T) {\n176|\t\t\tt.Parallel()\n177|\t\t\tif _, err := DecodeManifest([]byte(probe.body)); requireCode(t, err, \"adapter_protocol_violation\") == nil {\n178|\t\t\t\tt.Fatal(\"must refuse\")\n179|\t\t\t}\n180|\t\t})\n181|\t}\n182|}\n183|\n184|// TestManifestLimitsBounds drives the production manifest entry\n185|// through the DirectoryNodeLimits bounds: each bound refuses past\n186|// its edge in both directions, and a frame ceiling above the 8\n187|// MiB transport bound refuses.\n188|func TestManifestLimitsBounds(t *testing.T) {\n189|\tt.Parallel()\n190|\tgood := fixtureManifestJSON()\n191|\tlimit := `\"max_frame_bytes\":8388608,\"max_scan_instances\":65536,\"max_inventory_take\":1000,\"max_excerpt_count\":20,\"max_excerpt_bytes\":4096,\"max_enrichment_events\":5000,\"max_enrichment_bytes\":4194304`\n192|\tfor _, probe := range []struct {\n193|\t\tname   string\n194|\t\tlimits string\n195|\t}{\n196|\t\t{\"frame above transport\", `\"max_frame_bytes\":8388609,\"max_scan_instances\":65536,\"max_inventory_take\":1000,\"max_excerpt_count\":20,\"max_excerpt_bytes\":4096,\"max_enrichment_events\":5000,\"max_enrichment_bytes\":4194304`},\n197|\t\t{\"zero frame\", `\"max_frame_bytes\":0,\"max_scan_instances\":65536,\"max_inventory_take\":1000,\"max_excerpt_count\":20,\"max_excerpt_bytes\":4096,\"max_enrichment_events\":5000,\"max_enrichment_bytes\":4194304`},\n198|\t\t{\"zero scan instances\", `\"max_frame_bytes\":8388608,\"max_scan_instances\":0,\"max_inventory_take\":1000,\"max_excerpt_count\":20,\"max_excerpt_bytes\":4096,\"max_enrichment_events\":5000,\"max_enrichment_bytes\":4194304`},\n199|\t\t{\"take past bound\", `\"max_frame_bytes\":8388608,\"max_scan_instances\":65536,\"max_inventory_take\":1001,\"max_excerpt_count\":20,\"max_excerpt_bytes\":4096,\"max_enrichment_events\":5000,\"max_enrichment_bytes\":4194304`},\n200|\t\t{\"excerpt count past bound\", `\"max_frame_bytes\":8388608,\"max_scan_instances\":65536,\"max_inventory_take\":1000,\"max_excerpt_count\":21,\"max_excerpt_bytes\":4096,\"max_enrichment_events\":5000,\"max_enrichment_bytes\":4194304`},\n201|\t\t{\"excerpt bytes past bound\", `\"max_frame_bytes\":8388608,\"max_scan_instances\":65536,\"max_inventory_take\":1000,\"max_excerpt_count\":20,\"max_excerpt_bytes\":4097,\"max_enrichment_events\":5000,\"max_enrichment_bytes\":4194304`},\n202|\t\t{\"enrichment events past bound\", `\"max_frame_bytes\":8388608,\"max_scan_instances\":65536,\"max_inventory_take\":1000,\"max_excerpt_count\":20,\"max_excerpt_bytes\":4096,\"max_enrichment_events\":5001,\"max_enrichment_bytes\":4194304`},\n203|\t\t{\"enrichment bytes past bound\", `\"max_frame_bytes\":8388608,\"max_scan_instances\":65536,\"max_inventory_take\":1000,\"max_excerpt_count\":20,\"max_excerpt_bytes\":4096,\"max_enrichment_events\":5000,\"max_enrichment_bytes\":4194305`},\n204|\t} {\n205|\t\tt.Run(probe.name, func(t *testing.T) {\n206|\t\t\tt.Parallel()\n207|\t\t\tbody := replaceOnce(t, good, limit, probe.limits, 1)\n208|\t\t\tif _, err := DecodeManifest([]byte(body)); requireCode(t, err, \"adapter_protocol_violation\") == nil {\n209|\t\t\t\tt.Fatal(\"must refuse\")\n210|\t\t\t}\n211|\t\t})\n212|\t}\n213|}\n214|\n215|// TestAvailableCapabilitiesNeverUpgrades drives the production\n216|// advertisement entry: only available capabilities list, and\n217|// conditional, unavailable, and unknown never appear no matter\n218|// their reasons or evidence.\n219|func TestAvailableCapabilitiesNeverUpgrades(t *testing.T) {\n220|\tt.Parallel()\n221|\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n222|\tif err != nil {\n223|\t\tt.Fatalf(\"DecodeManifest error = %v\", err)\n224|\t}\n225|\tavailable := AvailableCapabilities(manifest)\n226|\twant := map[string]bool{\n227|\t\t\"directory_discovery\":        true,\n228|\t\t\"directory_incremental_scan\": true,\n229|\t\t\"native_title_read\":          true,\n(more lines below)"}}}
