.go|checkSuccessScalars|requireUint53Bounds|\"item_count\"|0`, driver: \"TestSuccessScalarBoundEdges\", reason: \"item count 0..65536\"},\n666|\t{id: `operations.go|checkSuccessScalars|requireUint53Bounds|\"parsed_event_count\"|0`, driver: \"TestSuccessScalarBoundEdges\", reason: \"parsed event count minimum 0; maximum maxUint53 pinned by TestUint53RepresentabilityCeiling\"},\n667|\t{id: `operations.go|checkValidateResult|DecodeFindings|\"findings\"|0`, driver: \"TestFindingsCapEdges\", reason: \"validate findings cap 4096\"},\n668|\t// The two transparent wrappers over the shared checkers.\n669|\t{id: `operations.go|requireStringBounds|checkStringBounds|members[name]|0`, driver: \"TestRequestScalarBoundEdges\", exempt: true, reason: \"mechanism: transparent bound forwarder; values pinned at the 13 caller rows\"},\n670|\t{id: `operations.go|requireUint53Bounds|checkUint53Bounds|members[name]|0`, driver: \"TestRequestScalarBoundEdges\", exempt: true, reason: \"mechanism: transparent bound forwarder; values pinned at the 6 caller rows\"},\n671|\t// probe.go.\n672|\t{id: `probe.go|DecodeDoctorResult|DecodeFindings|\"findings\"|0`, driver: \"TestFindingsCapEdges\", reason: \"doctor findings cap 4096\"},\n673|\t{id: `probe.go|DecodeDoctorResult|checkUint53Bounds|\"registry_sequence\"|0`, driver: \"TestDoctorSequenceMinimum\", reason: \"registry sequence minimum 0; maximum maxUint53 pinned by TestUint53RepresentabilityCeiling\"},\n674|\t{id: `probe.go|DecodeProbe|checkSortedUniqueStrings|\"warnings\"|0`, driver: \"TestSortedUniqueBoundEdges\", reason: \"warnings count 0..1024; element 2048 pinned by TestDecodeProbeClosedRules\"},\n675|\t{id: `probe.go|decodeCapabilities|len|len(members) != len(capabilityOrder)|0`, driver: \"TestDecodeProbeClosedRules\", reason: \"fifteen-entry capability map; zero pinned by TestRegistryLengthEmptyRefuses\"},\n676|\t{id: `probe.go|decodeCapabilityValue|checkStringBounds|\"detail\"|0`, driver: \"TestStringBoundEdges\", reason: \"capability detail 0..2048\"},\n677|\t// protocol.go frame bounds and trim plumbing.\n678|\t{id: `protocol.go|CheckFailureEnvelope|len|len(frame) == N|0`, driver: \"TestEmptyFramesRefuse\", reason: \"failure empty frame\"},\n679|\t{id: `protocol.go|CheckFailureEnvelope|len|len(frame) > MaxFrameBytes|0`, driver: \"TestFrameBoundEdges\", reason: \"failure 8 MiB frame\"},\n680|\t{id: `protocol.go|CheckSuccessEnvelope|len|len(frame) == N|0`, driver: \"TestEmptyFramesRefuse\", reason: \"success empty frame\"},\n681|\t{id: `protocol.go|CheckSuccessEnvelope|len|len(frame) > MaxFrameBytes|0`, driver: \"TestFrameBoundEdges\", reason: \"success 8 MiB frame\"},\n682|\t{id: `protocol.go|DecodeRequestFrame|len|len(frame) == N|0`, driver: \"TestEmptyFramesRefuse\", reason: \"request empty frame\"},\n683|\t{id: `protocol.go|DecodeRequestFrame|len|len(frame) > MaxFrameBytes|0`, driver: \"TestFrameBoundEdges\", reason: \"request 8 MiB frame\"},\n684|\t{id: `protocol.go|bytesTrimSpace|len|len(trimmed) == N|0`, exempt: true, reason: \"plumbing: empty trim returns its input; no refusal, no bound\"},\n685|\t// tuple.go.\n686|\t{id: `tuple.go|CheckTupleAdmission|len|len(entry.Strategies) != N|0`, driver: \"TestCheckTupleAdmissionRefusals\", reason: \"source strategies exact shape\"},\n687|\t{id: `tuple.go|DecodeTuple|checkStringBounds|\"environment_version\"|0`, driver: \"TestStringBoundEdges\", reason: \"tuple version 1..128\"},\n688|\t{id: `tuple.go|DecodeTupleEntry|checkStringBounds|\"revocation_reason\"|0`, driver: \"TestStringBoundEdges\", reason: \"revocation reason 1..4096\"},\n689|\t{id: `tuple.go|DecodeTupleEntry|checkUint53Bounds|\"entry_sequence\"|0`, driver: \"TestEveryArmWitnessRefusesAtTheProductionEntry\", reason: \"entry sequence above zero via entry_sequence=0 witness\"},\n690|\t{id: `tuple.go|checkContractsShape|checkStringBounds|identifier|0`, driver: \"TestStringBoundEdges\", reason: \"contract identifier 1..256\"},\n691|\t{id: `tuple.go|checkContractsShape|len|len(elements) == N|0`, driver: \"TestArrayBoundEdges\", reason: \"contracts lower edge\"},\n692|\t{id: `tuple.go|checkContractsShape|len|len(elements) > N|0`, driver: \"TestArrayBoundEdges\", reason: \"contracts cap 64\"},\n693|\t{id: `tuple.go|checkContractsShape|len|len(members) != N|0`, driver: \"TestEveryArmWitnessRefusesAtTheProductionEntry\", reason: \"contract row shape via three-member_row witness\"},\n694|\t{id: `tuple.go|checkContractsShape|len|len(versions) == N|0`, driver: \"TestArrayBoundEdges\", reason: \"versions lower edge\"},\n695|\t{id: `tuple.go|checkContractsShape|len|len(versions) > N|0`, driver: \"TestArrayBoundEdges\", reason: \"versions cap 32\"},\n696|\t{id: `tuple.go|decodeFidelityLimits|checkStringBounds|\"affected_class\"|0`, driver: \"TestStringBoundEdges\", reason: \"fidelity class 1..128\"},\n697|\t{id: `tuple.go|decodeFidelityLimits|checkStringBounds|\"code\"|0`, driver: \"TestStringBoundEdges\", reason: \"fidelity code 1..128\"},\n698|\t{id: `tuple.go|decodeFidelityLimits|checkStringBounds|\"detail\"|0`, driver: \"TestStringBoundEdges\", reason: \"fidelity detail 1..4096\"},\n699|\t{id: `tuple.go|decodeFidelityLimits|len|index < len(limits)|0`, driver: \"TestEveryArmWitnessRefusesAtTheProductionEntry\", exempt: true, reason: \"plumbing: pairwise sortedness scan index, not a domain bound; count edge pinned at the caller row\"},\n700|\t{id: `tuple.go|decodeFidelityLimits|len|uint64(len(elements)) > N|0`, driver: \"TestEveryArmWitnessRefusesAtTheProductionEntry\", reason: \"fidelity cap via 1025_rows witness\"},\n701|\t{id: `tuple.go|decodeFixtureEvidence|checkStringBounds|\"suite_revision\"|0`, driver: \"TestStringBoundEdges\", reason: \"suite revision 1..128\"},\n702|\t{id: `tuple.go|decodeFixtureEvidence|checkUint53Bounds|\"fixture_count\"|0`, driver: \"TestEveryArmWitnessRefusesAtTheProductionEntry\", reason: \"fixture count above zero via fixture_count=0 witness\"},\n703|\t{id: `tuple.go|decodeSmokeEvidence|checkStringBounds|\"native_cli_family\"|0`, driver: \"TestStringBoundEdges\", reason: \"CLI family 1..128\"},\n704|\t{id: `tuple.go|decodeStrategies|len|index < len(strategies)|0`, driver: \"TestStrategiesEmptyRefuses\", exempt: true, reason: \"plumbing: pairwise sortedness scan index, not a domain bound; lower edge pinned at the caller row\"},\n705|\t{id: `tuple.go|decodeStrategies|len|len(elements) == N|0`, driver: \"TestStrategiesEmptyRefuses\", reason: \"strategies lower edge\"},\n706|}\n707|\n708|// boundCensusCanaries are survivor sites from the review traversal\n709|// that the scanner must see. If any is absent from the derived\n710|// set, the scanner is blind in exactly the direction the census\n711|// exists to measure, and the census fails rather than reporting\n712|// a short denominator as complete.\n713|var boundCensusCanaries = []string{\n714|\t`operations.go|checkRequestScalars|requireStringBounds|\"cursor\"`,\n715|\t`operations.go|checkSuccessScalars|requireStringBounds|\"cwd_relative\"`,\n716|\t`operations.go|checkRequestScalars|requireStringBounds|\"expected_target_native_session_id\"`,\n717|\t`operations.go|checkSuccessScalars|requireUint53Bounds|\"candidate_count\"`,\n718|\t`probe.go|DecodeProbe|checkSortedUniqueStrings|\"warnings\"`,\n719|\t`decode.go|checkExtensions|len|len(name) > N`,\n720|\t`tuple.go|decodeStrategies|len|index < len(strategies)`,\n721|\t`decode.go|parseUint53Literal|len|index < len(literal)`,\n722|\t`decode.go|checkStringBounds|len|length < minimum`,\n723|}\n724|\n725|// TestBoundGuardsAreCensused is the bound census: the derived\n726|// production site multiset must equal the registration multiset.\n727|// An unregistered site fails as unrostered; an orphaned\n728|// registration fails as stale. Every non-exempt row must name a\n729|// driver and every exempt row a rationale.\n730|func TestBoundGuardsAreCensused(t *testing.T) {\n731|\tdirectory, err := os.Getwd()\n732|\tif err != nil {\n733|\t\tt.Fatalf(\"bound census: %v\", err)\n734|\t}\n735|\tderived := scanBoundSiteIDs(t, directory)\n736|\tif len(derived) == 0 {\n737|\t\tt.Fatal(\"bound census derived zero sites; the scanner is broken, not the package\")\n738|\t}\n739|\tderivedCounts := map[string]int{}\n740|\tfor _, id := range derived {\n741|\t\tderivedCounts[id]++\n742|\t}\n743|\tfor _, canary := range boundCensusCanaries {\n744|\t\tfound := false\n745|\t\tfor id := range derivedCounts {\n746|\t\t\tif strings.HasPrefix(id, canary) {\n747|\t\t\t\tfound = true\n748|\t\t\t\tbreak\n749|\t\t\t}\n750|\t\t}\n751|\t\tif !found {\n752|\t\t\tt.Errorf(\"bound census blind to canary %q; the scanner misses the class it must roster\", canary)\n753|\t\t}\n754|\t}\n755|\tregisteredCounts := map[string]int{}\n756|\tseen := map[string]bool{}\n757|\tfor _, row := range boundRegistrations {\n758|\t\tif seen[row.id] {\n759|\t\t\tt.Errorf(\"bound census registers %q twice\", row.id)\n760|\t\t}\n761|\t\tseen[row.id] = true\n762|\t\tregisteredCounts[row.id]++\n763|\t\tif row.driver == \"\" && !row.exempt {\n764|\t\t\tt.Errorf(\"bound census row %q names no driver and no exemption\", row.id)\n765|\t\t}\n766|\t\tif row.exempt && row.reason == \"\" {\n767|\t\t\tt.Errorf(\"bound census exemption %q states no rationale\", row.id)\n768|\t\t}\n769|\t}\n770|\tvar unregistered []string\n771|\tfor id, count := range derivedCounts {\n772|\t\tfor i := registeredCounts[id]; i < count; i++ {\n773|\t\t\tunregistered = append(unregistered, id)\n774|\t\t}\n775|\t}\n776|\tvar orphaned []string\n777|\tfor id, count := range registeredCounts {\n778|\t\tfor i := derivedCounts[id]; i < count; i++ {\n779|\t\t\torphaned = append(orphaned, id)\n780|\t\t}\n781|\t}\n782|\tsort.Strings(unregistered)\n783|\tsort.Strings(orphaned)\n784|\tif len(unregistered) > 0 {\n785|\t\tt.Fatalf(\"production bound site(s) with no census row:\\n  %s\", strings.Join(unregistered, \"\\n  \"))\n786|\t}\n787|\tif len(orphaned) > 0 {\n788|\t\tt.Fatalf(\"census row(s) naming no production site:\\n  %s\", strings.Join(orphaned, \"\\n  \"))\n789|\t}\n790|\tdriven, exempt := 0, 0\n791|\tfor _, row := range boundRegistrations {\n792|\t\tif row.exempt {\n793|\t\t\texempt++\n794|\t\t} else {\n795|\t\t\tdriven++\n796|\t\t}\n797|\t}\n798|\tt.Logf(\"bound census: %d sites rostered (%d driven, %d exempt) across production\", len(derived), driven, exempt)\n799|}\n800|\n801|// TestBoundHelperIndirectionReports proves the indirection half\n802|// of the bound census against synthetic files: a package-level\n803|// `var f = requireStringBounds` and a function-local alias both\n804|// report, while a direct helper call and the helper definition\n805|// itself stay exempt. The vectors are synthetic on purpose: they\n806|// prove the gate, not production. This is the regression test\n807|// for review rev5/F2 (repeat of rev4/N8): the alias plant passed\n808|// the whole suite because the scanner matched `call.Fun` only.\n809|func TestBoundHelperIndirectionReports(t *testing.T) {\n810|\tparse := func(source string) *ast.File {\n811|\t\tt.Helper()\n812|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), \"probe.go\", []byte(source), 0)\n813|\t\tif err != nil {\n814|\t\t\tt.Fatalf(\"parse synthetic source: %v\", err)\n815|\t\t}\n816|\t\treturn syntax\n817|\t}\n818|\tt.Run(\"package-level alias reports\", func(t *testing.T) {\n819|\t\tsyntax := parse(\"package probe\\nvar zzprobeIndirect = requireStringBounds\\nfunc f(m map[string]json.RawMessage) error {\\nreturn zzprobeIndirect(m, \\\"zz_probe_member\\\", 1, 4096)\\n}\\n\")\n820|\t\tif violations := boundHelperIndirections(syntax); len(violations) != 1 {\n821|\t\t\tt.Fatalf(\"violations = %v, want the single indirection report\", violations)\n822|\t\t}\n823|\t})\n824|\tt.Run(\"function-local alias reports\", func(t *testing.T) {\n825|\t\tsyntax := parse(\"package probe\\nfunc f() {\\nindirect := requireStringBounds\\n_ = indirect\\n}\\n\")\n826|\t\tif violations := boundHelperIndirections(syntax); len(violations) != 1 {\n827|\t\t\tt.Fatalf(\"violations = %v, want the single indirection report\", violations)\n828|\t\t}\n829|\t})\n830|\tt.Run(\"direct call stays exempt\", func(t *testing.T) {\n831|\t\tsyntax := parse(\"package probe\\nfunc f(m map[string]json.RawMessage) error {\\nreturn requireStringBounds(m, \\\"zz_probe_member\\\", 1, 4096)\\n}\\n\")\n832|\t\tif violations := boundHelperIndirections(syntax); len(violations) != 0 {\n833|\t\t\tt.Fatalf(\"violations = %v, want none for a direct call\", violations)\n834|\t\t}\n835|\t})\n836|\tt.Run(\"helper definition stays exempt\", func(t *testing.T) {\n837|\t\tsyntax := parse(\"package probe\\nfunc requireStringBounds(m map[string]json.RawMessage, name string, minimum, maximum int) error {\\nreturn nil\\n}\\n\")\n838|\t\tif violations := boundHelperIndirections(syntax); len(violations) != 0 {\n839|\t\t\tt.Fatalf(\"violations = %v, want none for the definition spelling\", violations)\n840|\t\t}\n841|\t})\n842|}\n843|\n844|// TestBoundLenScanSeesNonIfContexts proves the context half of\n845|// the bound census against a synthetic file: len guards in a\n846|// return, a for condition, a switch condition, and an assignment\n847|// all derive, while a boundless len use (a slice length passed\n848|// to make) does not claim a guard. The vectors are synthetic on\n849|// purpose: they prove the gate, not production. This is the\n850|// regression test for the second and third plants of review\n851|// rev5/F2, which hid in return and for positions the if-only\n852|// walk never visited.\n853|func TestBoundLenScanSeesNonIfContexts(t *testing.T) {\n854|\tsource := \"package probe\\nfunc zzReturnBound(value string) bool {\\nreturn len(value) >= 1 && len(value) <= 512\\n}\\n\" +\n855|\t\t\"func zzForBound(values []string) int {\\nn := 0\\nfor i := 0; len(values) > 128 && i < 1; i++ {\\nn++\\n}\\nreturn n\\n}\\n\" +\n856|\t\t\"func zzSwitchBound(values []string) int {\\nswitch {\\ncase len(values) == 0:\\nreturn 0\\ndefault:\\nreturn 1\\n}\\n}\\n\" +\n857|\t\t\"func zzAssignBound(values []string) int {\\nover := len(values) > 64\\nif over {\\nreturn 1\\n}\\nreturn 0\\n}\\n\" +\n858|\t\t\"func zzBoundless(values []string) []string {\\nreturn make([]string, 0, len(values))\\n}\\n\"\n859|\tsyntax, err := parser.ParseFile(token.NewFileSet(), \"probe.go\", []byte(source), 0)\n860|\tif err != nil {\n861|\t\tt.Fatalf(\"parse synthetic source: %v\", err)\n862|\t}\n863|\tsites, violations := boundSitesInSyntax(syntax, \"probe.go\")\n864|\tif len(violations) != 0 {\n865|\t\tt.Fatalf(\"violations = %v, want none\", violations)\n866|\t}\n867|\tcontains := func(want string) bool {\n868|\t\tfor _, id := range sites {\n869|\t\t\tif strings.HasPrefix(id, want) {\n870|\t\t\t\treturn true\n871|\t\t\t}\n872|\t\t}\n873|\t\treturn false\n874|\t}\n875|\tfor _, want := range []string{\n876|\t\t\"probe.go|zzReturnBound|len|\",\n877|\t\t\"probe.go|zzForBound|len|\",\n878|\t\t\"probe.go|zzSwitchBound|len|\",\n879|\t\t\"probe.go|zzAssignBound|len|\",\n880|\t} {\n881|\t\tif !contains(want) {\n882|\t\t\tt.Errorf(\"sites = %v, want a site under %q\", sites, want)\n883|\t\t}\n884|\t}\n885|\tif contains(\"probe.go|zzBoundless|len|\") {\n886|\t\tt.Errorf(\"sites = %v, want no guard for the boundless make length\", sites)\n887|\t}\n888|}\n889|\n890|// TestBoundLenScanSeesLengthVariables proves the length-variable\n891|// half of the bound census against a synthetic file: a guard over\n892|// a variable bound from len(...) derives, a guard over a\n893|// variable bound from stringLength(...) derives, a guard holding\n894|// a direct stringLength(...) call derives, and a bound inside a\n895|// package-level func literal derives under its variable name —\n896|// while a comparison over a plain numeric parameter, a direct\n897|// cap(...) or utf8.RuneCountInString(...) comparison, and an\n898|// element comparison over a slice built with a len capacity do\n899|// not. The vectors are synthetic on purpose: they prove the\n900|// gate, not production. This is the regression test for the\n901|// rev6 G-B plants (`length := len(value); if length > 4096` and\n902|// the package-literal bound passed the whole suite unrostered),\n903|// and the negatives pin the stated residue: shapes 9 and 10 of\n904|// the census header.\n905|func TestBoundLenScanSeesLengthVariables(t *testing.T) {\n906|\tsource := \"package probe\\nfunc zzLenVariable(value string) error {\\nlength := len(value)\\nif length < 1 || length > 4096 { return nil }\\nreturn nil\\n}\\n\" +\n907|\t\t\"func zzRuneVariable(value string) error {\\nlength := stringLength(value)\\nif length < 1 || length > 4096 { return nil }\\nreturn nil\\n}\\n\" +\n908|\t\t\"func zzRuneDirect(value string) error {\\nif stringLength(value) > 4096 { return nil }\\nreturn nil\\n}\\n\" +\n909|\t\t\"func zzConverted(value string) error {\\nn := uint64(len(value))\\nif n > 4096 { return nil }\\nreturn nil\\n}\\n\" +\n910|\t\t\"func zzPlainParam(count int) error {\\nif count < 1 || count > 4096 { return nil }\\nreturn nil\\n}\\n\" +\n911|\t\t\"func zzCapBound(values []string) error {\\nif cap(values) > 4096 { return nil }\\nreturn nil\\n}\\n\" +\n912|\t\t\"func zzCapacitySlice(elements []string) error {\\nvalues := make([]string, 0, len(elements))\\nif values[0] == values[1] { return nil }\\nreturn nil\\n}\\n\" +\n913|\t\t\"var zzProbeLiteralBound = func(observed string) error {\\nif len(observed) > 4096 { return nil }\\nlength := len(observed)\\nif length < 1 { return nil }\\nreturn nil\\n}\\n\"\n914|\tsyntax, err := parser.ParseFile(token.NewFileSet(), \"probe.go\", []byte(source), 0)\n915|\tif err != nil {\n916|\t\tt.Fatalf(\"parse synthetic source: %v\", err)\n917|\t}\n918|\tsites, violations := boundSitesInSyntax(syntax, \"probe.go\")\n919|\tif len(violations) != 0 {\n920|\t\tt.Fatalf(\"violations = %v, want none\", violations)\n921|\t}\n922|\tcontains := func(want string) bool {\n923|\t\tfor _, id := range sites {\n924|\t\t\tif strings.HasPrefix(id, want) {\n925|\t\t\t\treturn true\n926|\t\t\t}\n927|\t\t}\n928|\t\tre