gistry, \"null\", 1), true},\n71|\t\t{\"duplicate member\", good[:len(good)-1] + `,\"node_id\":\"x\"}`, true},\n72|\t\t{\"non object\", `[]`, true},\n73|\t\t{\"empty redaction policies\", replaceOnce(t, good, `\"redaction_policy_ids\":[`+quote(fixtureRedactionDigest)+`]`, `\"redaction_policy_ids\":[]`, 1), true},\n74|\t\t{\"bad enrichment profile\", replaceOnce(t, good, fixtureEnrichmentDigest, \"sha256:zzz\", 1), true},\n75|\t\t{\"bad top-level extensions\", replaceOnce(t, good, `\"extensions\":{}},\"extensions\":{}}`, `\"extensions\":{}},\"extensions\":{\"x\":1}}`, 1), true},\n76|\t\t{\"deep nesting past canonical bound\", deepExtensionsManifest(t, good), true},\n77|\t} {\n78|\t\tt.Run(probe.name, func(t *testing.T) {\n79|\t\t\tt.Parallel()\n80|\t\t\tif _, err := DecodeManifest([]byte(probe.body)); requireCode(t, err, \"adapter_protocol_violation\") == nil {\n81|\t\t\t\tt.Fatal(\"must refuse\")\n82|\t\t\t}\n83|\t\t})\n84|\t}\n(more lines below)"}}}
