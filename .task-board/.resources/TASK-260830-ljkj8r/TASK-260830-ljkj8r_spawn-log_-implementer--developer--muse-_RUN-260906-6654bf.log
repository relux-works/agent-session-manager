rameFault literal with unquotable detail\")\n527|\t\t\treturn\n528|\t\t}\n529|\t\tdetail = unquoted\n530|\t\tfound = true\n531|\t}\n532|\tif !found {\n533|\t\tscan.derived.violations = append(scan.derived.violations, scan.name+\": frameFault literal with no detail\")\n534|\t\treturn\n535|\t}\n536|\tscan.derived.arms[\"frame|\"+detail] = true\n537|}\n538|\n539|// defensiveArms names derived arms no public input can fire:\n540|// encoder-produced values that cannot fail encoding. Each stays\n541|// in production as fail-closed handling of a theoretically\n542|// fallible call, and each is recorded here rather than witnessed\n543|// by a refusal test that cannot exist. A new defensive arm must\n544|// extend this map with its rationale; an arm missing from both\n545|// this map and the witness table fails\n546|// TestDerivedRefusalArmsAreAllWitnessed.\n547|var defensiveArms = map[string]string{\n548|\t\"ctor|failViolation|request frame is not encodable\":        \"json.Marshal over validated strings, integers, and raw JSON cannot fail; the arm stays so a future member type cannot fail silently\",\n549|\t\"ctor|failIntegrity|idempotency journal is not exportable\": \"Canonicalize over encoder-produced bytes cannot fail short of memory corruption; the arm stays so export never returns a partial journal\",\n550|}\n551|\n552|// armWitnesses maps every derived arm to the test functions that\n553|// drive it through a production entry with a negative vector\n554|// asserting code plus distinguishing detail. Shared arms list\n555|// every branch test: the context-prefixed envelope arms fire on\n556|// both the success and failure paths, so both refusal tests are\n557|// named. The table is verified in both directions against the\n558|// derivation; behavioural proof stays with the named tests,\n559|// which run as part of the suite.\n560|var armWitnesses = map[string][]string{\n561|\t\"ctor|failInvalid|request major is outside the locally supported registry\":                              {\"TestEncodeRequestRefusals\"},\n562|\t\"ctor|failInvalid|request identifier is not a UUIDv7\":                                                   {\"TestEncodeRequestRefusals\"},\n563|\t\"ctor|failInvalid|request deadline is outside uint53[1..3600000]\":                                       {\"TestEncodeRequestRefusals\"},\n564|\t\"ctor|failInvalid|probe request major is outside the locally supported registry\":                        {\"TestProbeRequestRefusals\"},\n565|\t\"ctor|failInvalid|observed executable digest is not a digest\":                                           {\"TestCheckManifestBindings\"},\n566|\t\"ctor|failInvalid|observed provider manifest digest is not a digest\":                                    {\"TestCheckManifestBindings\"},\n567|\t\"ctor|failInvalid|observed adapter manifest digest is not a digest\":                                     {\"TestCheckManifestBindings\"},\n568|\t\"ctor|failInvalid|idempotency operation identifier is not a UUIDv7\":                                     {\"TestJournalScopesKeysByOperation\"},\n569|\t\"ctor|failInvalid|bootstrap attempt does not carry operation manifest\":                                  {\"TestBootstrapRefusesNonManifestAttempt\"},\n570|\t\"ctor|failInvalid|bootstrap process token is empty\":                                                     {\"TestProcessGuardRefusesReuse\"},\n571|\t\"ctor|failInvalid|bootstrap process was already used for an attempt\":                                    {\"TestProcessGuardRefusesReuse\"},\n572|\t\"ctor|failViolation|request frame is empty\":                                                             {\"TestDecodeRequestFrameRefusals\"},\n573|\t\"ctor|failViolation|request frame exceeds the 8 MiB bound\":                                              {\"TestDecodeRequestFrameRefusals\"},\n574|\t\"ctor|failViolation|request envelope carries unknown member\":                                            {\"TestDecodeRequestFrameRefusals\"},\n5