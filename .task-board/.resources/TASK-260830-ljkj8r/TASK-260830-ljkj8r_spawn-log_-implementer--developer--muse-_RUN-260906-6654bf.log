{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4df","stream":{"kind":"session","id":"01a07573-a73b-7be0-abe2-6029bca74ffd"},"sequence":202,"recorded_at":1780531400000399,"record_type":"event","durability":"durable","causation_id":"65c281d8-14aa-4def-b705-62e70b4fce66","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"65c281d8-14aa-4def-b705-62e70b4fce66","run_stream":{"kind":"run","id":"65c281d8-14aa-4def-b705-62e70b4fce66"},"call_id":"call_01a0757416d27922985f91a2335e718b","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/dirnode/query.go`.\n(499 line(s) above)\n500|\t\t_ = name\n501|\t\treturn CallerContext{}, false\n502|\t}\n503|\tcallerID, ok := checkStringBounds(members[\"caller_id\"], 1, 256)\n504|\tif !ok {\n505|\t\treturn CallerContext{}, false\n506|\t}\n507|\tsubject, ok := checkStringBounds(members[\"authentication_subject\"], 1, 512)\n508|\tif !ok {\n509|\t\treturn CallerContext{}, false\n510|\t}\n511|\torigin, ok := checkUUIDv7(members[\"origin_host_id\"])\n512|\tif !ok {\n513|\t\treturn CallerContext{}, false\n514|\t}\n515|\tinteraction, ok := rawString(members[\"interaction\"])\n516|\tif !ok || (interaction != \"interactive\" && interaction != \"non_interactive\") {\n517|\t\treturn CallerContext{}, false\n518|\t}\n519|\tscopes, ok := checkSortedUniqueStrings(members[\"scopes\"], 1, 64, 1, 5)\n520|\tif !ok {\n521|\t\treturn CallerContext{}, false\n522|\t}\n523|\tfor _, scope := range scopes {\n524|\t\tallowed := false\n525|\t\tfor _, candidate := range queryScopes {\n526|\t\t\tif scope == candidate {\n527|\t\t\t\tallowed = true\n528|\t\t\t\tbreak\n529|\t\t\t}\n530|\t\t}\n531|\t\tif !allowed {\n532|\t\t\treturn CallerContext{}, false\n533|\t\t}\n534|\t}\n535|\tpolicy, ok := checkDigest(members[\"disclosure_policy_digest\"])\n536|\tif !ok {\n537|\t\treturn CallerContext{}, false\n538|\t}\n539|\tif !checkExtensions(members[\"extensions\"]) {\n540|\t\treturn CallerContext{}, false\n541|\t}\n542|\treturn CallerContext{\n543|\t\tCallerID:         callerID,\n544|\t\tAuthSubject:      subject,\n545|\t\tOriginHostID:     origin.String(),\n546|\t\tInteraction:      interaction,\n547|\t\tScopes:           scopes,\n548|\t\tDisclosurePolicy: policy.String(),\n549|\t}, true\n550|}\n551|\n552|// checkQueryOperation validates one batch element against its\n553|// position: the exact closed members, the index equal to the\n554|// zero-based array position, a registry name, the name-matched\n555|// parameter union, the projection rules, the pagination rule, and\n556|// the read/mutation flag rules.\n557|func checkQueryOperation(raw json.RawMessage, position int) (QueryOperation, bool) {\n558|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n559|\tif fault != nil {\n560|\t\treturn QueryOperation{}, false\n561|\t}\n562|\tif name, unknown := unknownMember(members, operationMembers); unknown {\n563|\t\t_ = name\n564|\t\treturn QueryOperation{}, false\n565|\t}\n566|\tif name, missing := missingMember(members, operationRequired); missing {\n567|\t\t_ = name\n568|\t\treturn QueryOperation{}, false\n569|\t}\n570|\tindex, ok := rawUint53(members[\"operation_index\"])\n571|\tif !ok || index > 63 || int(index) != position {\n572|\t\treturn QueryOperation{}, false\n573|\t}\n574|\tname, ok := rawString(members[\"name\"])\n575|\tif !ok {\n576|\t\treturn QueryOperation{}, false\n577|\t}\n578|\tkind, ok := queryOperationKindOf(name)\n579|\tif !ok {\n580|\t\treturn QueryOperation{}, false\n581|\t}\n582|\tif !checkQueryParameters(name, members[\"parameters\"]) {\n583|\t\treturn QueryOperation{}, false\n584|\t}\n585|\tif !checkQueryProjection(name, kind, members[\"fields\"], members[\"preset\"]) {\n586|\t\treturn QueryOperation{}, false\n587|\t}\n588|\tif !checkQueryPagination(name, members[\"skip\"], members[\"take\"]) {\n589|\t\treturn QueryOperation{}, false\n590|\t}\n591|\tif !checkQuerySort(members[\"sort\"]) {\n592|\t\treturn QueryOperation{}, false\n593|\t}\n594|\tif !checkQueryFlags(name, kind, members) {\n595|\t\treturn QueryOperation{}, false\n596|\t}\n597|\tif !checkExtensions(members[\"extensions\"]) {\n598|\t\treturn QueryOperation{}, false\n599|\t}\n600|\treturn QueryOperation{Index: position, Name: name, Kind: kind}, true\n601|}\n602|\n603|// checkQueryParameters validates the name-matched parameter union:\n604|// the exact member set for the operation plus the per-member\n605|// shapes. There is no untyped parameter bag.\n606|func checkQueryParameters(name string, raw json.RawMessage) bool {\n607|\twant, known := queryParameterMembers[name]\n608|\tif !known {\n609|\t\treturn false\n610|\t}\n611|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n612|\tif fault != nil {\n613|\t\treturn false\n614|\t}\n615|\tallowed := map[string]bool{}\n616|\tfor _, member := range want {\n617|\t\tallowed[member] = true\n618|\t}\n619|\tif member, unknown := unknownMember(members, allowed); unknown {\n620|\t\t_ = member\n621|\t\treturn false\n622|\t}\n623|\tif member, missing := missingMember(members, want); missing {\n624|\t\t_ = member\n625|\t\treturn false\n626|\t}\n627|\tif !checkExtensions(members[\"extensions\"]) {\n628|\t\treturn false\n629|\t}\n630|\tswitch name {\n631|\tcase \"sessions\", \"count\":\n632|\t\treturn checkFilters(members[\"filters\"])\n633|\tcase \"session\":\n634|\t\treturn checkSubject(members[\"subject_kind\"], members[\"subject_id\"], false)\n635|\tcase \"lineage\":\n636|\t\treturn checkLineageParameters(members)\n637|\tcase \"hosts\":\n638|\t\treturn checkHostsParameters(members)\n639|\tcase \"environments\":\n640|\t\treturn checkEnvironmentsParameters(members)\n641|\tcase \"jobs\":\n642|\t\treturn checkJobsParameters(members)\n643|\tcase \"plans\":\n644|\t\treturn checkPlansParameters(members)\n645|\tcase \"distinct\":\n646|\t\treturn checkDistinctParameters(members)\n647|\tcase \"set_title\":\n648|\t\treturn checkSubject(members[\"subject_kind\"], members[\"subject_id\"], true) &&\n649|\t\t\tcheckTitleParameter(members) &&\n650|\t\t\tcheckSupersedes(members[\"supersedes_annotation_ids\"])\n651|\tcase \"set_tags\":\n652|\t\treturn checkSubject(members[\"subject_kind\"], members[\"subject_id\"], true) &&\n653|\t\t\tcheckTagsParameter(members) &&\n654|\t\t\tcheckSupersedes(members[\"supersedes_annotation_ids\"])\n655|\tcase \"set_pin\":\n656|\t\treturn checkSubject(members[\"subject_kind\"], members[\"subject_id\"], true) &&\n657|\t\t\tcheckPinParameter(members) &&\n658|\t\t\tcheckSupersedes(members[\"supersedes_annotation_ids\"])\n659|\tcase \"enrich\":\n660|\t\treturn checkSubject(members[\"subject_kind\"], members[\"subject_id\"], true) &&\n661|\t\t\tcheckEnrichParameters(members)\n662|\tcase \"plan_continue\":\n663|\t\treturn checkSubject(members[\"subject_kind\"], members[\"subject_id\"], true) &&\n664|\t\t\tcheckPlanContinueParameters(members)\n665|\tcase \"execute_plan\":\n666|\t\treturn checkExecutePlanParameters(members)\n667|\tdefault:\n668|\t\treturn true\n669|\t}\n670|}\n671|\n672|// checkSubject validates a subject_kind/subject_id pair. Mutations\n673|// additionally admit the lineage kind.\n674|func checkSubject(kindRaw, idRaw json.RawMessage, mutation bool) bool {\n675|\tkind, ok := rawString(kindRaw)\n676|\tif !ok {\n677|\t\treturn false\n678|\t}\n679|\tswitch kind {\n680|\tcase \"ax_session\", \"native_instance\":\n681|\tcase \"lineage\":\n682|\t\tif !mutation {\n683|\t\t\treturn false\n684|\t\t}\n685|\tdefault:\n686|\t\treturn false\n687|\t}\n688|\tidentifier, ok := rawString(idRaw)\n689|\tif !ok {\n690|\t\treturn false\n691|\t}\n692|\tif _, err := scalar.ParseUUIDv7(identifier); err == nil {\n693|\t\treturn true\n694|\t}\n695|\t_, digestErr := checkDigestString(identifier)\n696|\treturn digestErr\n697|}\n698|\n699|// checkLineageParameters validates the lineage parameter union\n700|// member.\n701|func checkLineageParameters(members map[string]json.RawMessage) bool {\n702|\tanchor, ok := rawString(members[\"anchor_id\"])\n703|\tif !ok {\n704|\t\treturn false\n705|\t}\n706|\tif _, err := scalar.ParseUUIDv7(anchor); err != nil {\n707|\t\tif _, digestErr := checkDigestString(anchor); !digestErr {\n708|\t\t\treturn false\n709|\t\t}\n710|\t}\n711|\t_, ok = rawBool(members[\"include_suggestions\"])\n712|\treturn ok\n713|}\n714|\n715|// checkHostsParameters validates the hosts parameter union member.\n716|func checkHostsParameters(members map[string]json.RawMessage) bool {\n717|\tif _, ok := checkSortedUniqueUUIDv7(members[\"host_ids\"], 0, 256); !ok {\n718|\t\treturn false\n719|\t}\n720|\tif isNull(members[\"reachable\"]) {\n721|\t\treturn true\n722|\t}\n723|\t_, ok := rawBool(members[\"reachable\"])\n724|\treturn ok\n725|}\n726|\n727|// checkEnvironmentsParameters validates the environments parameter\n728|// union member.\n729|func checkEnvironmentsParameters(members map[string]json.RawMessage) bool {\n730|\tif _, ok := checkSortedUniqueUUIDv7(members[\"host_ids\"], 0, 256); !ok {\n731|\t\treturn false\n732|\t}\n733|\tenvironments, ok := checkSortedUniqueStrings(members[\"environment_ids\"], 1, 64, 0, 64)\n734|\tif !ok {\n735|\t\treturn false\n736|\t}\n737|\tfor _, environment := range environments {\n738|\t\tif !environmentIDPattern.MatchString(environment) {\n739|\t\t\treturn false\n740|\t\t}\n741|\t}\n742|\tstatuses, ok := checkSortedUniqueStrings(members[\"authentication_status\"], 1, 32, 0, 4)\n743|\tif !ok {\n744|\t\treturn false\n745|\t}\n746|\tfor _, status := range statuses {\n747|\t\tswitch status {\n748|\t\tcase \"available\", \"missing\", \"expired\", \"unknown\":\n749|\t\tdefault:\n750|\t\t\treturn false\n751|\t\t}\n752|\t}\n753|\treturn true\n754|}\n755|\n756|// checkJobsParameters validates the jobs parameter union member.\n757|func checkJobsParameters(members map[string]json.RawMessage) bool {\n758|\tif _, ok := checkSortedUniqueUUIDv7(members[\"job_ids\"], 0, 256); !ok {\n759|\t\treturn false\n760|\t}\n761|\tif _, ok := checkSortedUniqueDigests(members[\"profile_ids\"], 0, 256); !ok {\n762|\t\treturn false\n763|\t}\n764|\tstates, ok := checkSortedUniqueStrings(members[\"states\"], 1, 32, 0, 7)\n765|\tif !ok {\n766|\t\treturn false\n767|\t}\n768|\tfor _, state := range states {\n769|\t\tswitch state {\n770|\t\tcase \"queued\", \"claimed\", \"running\", \"succeeded\", \"superseded\", \"failed\", \"canceled\":\n771|\t\tdefault:\n772|\t\t\treturn false\n773|\t\t}\n774|\t}\n775|\treturn true\n776|}\n777|\n778|// checkPlansParameters validates the plans parameter union member.\n779|func checkPlansParameters(members map[string]json.RawMessage) bool {\n780|\tif _, ok := checkSortedUniqueDigests(members[\"plan_ids\"], 0, 256); !ok {\n781|\t\treturn false\n782|\t}\n783|\tif _, ok := checkSortedUniqueUUIDv7(members[\"operation_ids\"], 0, 256); !ok {\n784|\t\treturn false\n785|\t}\n786|\t_, ok := rawBool(members[\"include_expired\"])\n787|\treturn ok\n788|}\n789|\n790|// checkDistinctParameters validates the distinct parameter union\n791|// member.\n792|func checkDistinctParameters(members map[string]json.RawMessage) bool {\n793|\tfield, ok := rawString(members[\"field\"])\n794|\tif !ok {\n795|\t\treturn false\n796|\t}\n797|\tswitch field {\n798|\tcase \"kind\", \"lineage_anchor\", \"provider\", \"host\", \"workspace\", \"state\", \"management_state\", \"reachability\", \"freshness\", \"warning\":\n799|\tdefault:\n800|\t\treturn false\n801|\t}\n802|\treturn checkFilters(members[\"filters\"])\n803|}\n804|\n805|// checkTitleParameter validates the set_title title member.\n806|func checkTitleParameter(members map[string]json.RawMessage) bool {\n807|\t_, ok := checkStringBounds(members[\"title\"], 1, 512)\n808|\treturn ok\n809|}\n810|\n811|// checkTagsParameter validates the set_tags tags member: a sorted\n812|// unique string array in the count bound. The section bounds the\n813|// count, not the items, so items cross as strings.\n814|func checkTagsParameter(members map[string]json.RawMessage) bool {\n815|\telements, ok := decodeArray(members[\"tags\"])\n816|\tif !ok || len(elements) > 256 {\n817|\t\treturn false\n818|\t}\n819|\tvar previous string\n820|\tfor index, element := range elements {\n821|\t\ttag, ok := rawString(element)\n822|\t\tif !ok {\n823|\t\t\treturn false\n824|\t\t}\n825|\t\tif index > 0 && previous >= tag {\n826|\t\t\treturn false\n827|\t\t}\n828|\t\tprevious = tag\n829|\t}\n830|\treturn true\n831|}\n832|\n833|// checkPinParameter validates the set_pin value member.\n834|func checkPinParameter(members map[string]json.RawMessage) bool {\n835|\t_, ok := rawBool(members[\"value\"])\n836|\treturn ok\n837|}\n838|\n839|// checkSupersedes validates a supersedes_annotation_ids member.\n840|func checkSupersedes(raw json.RawMessage) bool {\n841|\t_, ok := checkSortedUniqueDigests(raw, 0, 1024)\n842|\treturn ok\n843|}\n844|\n845|// checkEnrichParameters validates the enrich parameter union\n846|// member beyond the subject pair.\n847|func checkEnrichParameters(members map[string]json.RawMessage) bool {\n848|\tif _, ok := checkDigest(members[\"profile_id\"]); !ok {\n849|\t\treturn false\n850|\t}\n851|\tkinds, ok := checkSortedUniqueStrings(members[\"kinds\"], 1, 64, 1, 3)\n852|\tif !ok {\n853|\t\treturn false\n854|\t}\n855|\tfor _, kind := range kinds {\n856|\t\tswitch kind {\n857|\t\tcase \"generated_title\", \"summary\", \"recent_activity\":\n858|\t\tdefault:\n859|\t\t\treturn false\n860|\t\t}\n861|\t}\n862|\t_, ok = checkDigest(members[\"expected_head_digest\"])\n863|\treturn ok\n864|}\n865|\n866|// checkPlanContinueParameters validates the plan_continue\n867|// parameter union member beyond the subject pair.\n868|func checkPlanContinueParameters(members map[string]json.RawMessage) bool {\n869|\tif _, ok := checkDigest(members[\"source_instance_id\"]); !ok {\n870|\t\treturn false\n871|\t}\n872|\tif _, ok := checkUUIDv7(members[\"to_host_id\"]); !ok {\n873|\t\treturn false\n874|\t}\n875|\tif _, ok := checkDigest(members[\"to_installation_id\"]); !ok {\n876|\t\treturn false\n877|\t}\n878|\tintent, ok := rawString(members[\"intent\"])\n879|\tif !ok {\n880|\t\treturn false\n881|\t}\n882|\tswitch intent {\n883|\tcase \"attach\", \"resume\", \"takeover\", \"fork\", \"adopt\", \"clone\", \"move\", \"open_unmanaged\", \"archive_context\":\n884|\tdefault:\n885|\t\treturn false\n886|\t}\n887|\tpolicy, ok := rawString(members[\"workspace_policy\"])\n888|\tif !ok {\n889|\t\treturn false\n890|\t}\n891|\tswitch policy {\n892|\tcase \"refuse\", \"exact_checkpoint\", \"materialize_copy\":\n893|\tdefault:\n894|\t\treturn false\n895|\t}\n896|\tafter, ok := rawString(members[\"source_after_success\"])\n897|\tif !ok {\n898|\t\treturn false\n899|\t}\n900|\tswitch after {\n901|\tcase \"retain\", \"stop_and_release\":\n902|\tdefault:\n903|\t\treturn false\n904|\t}\n905|\treturn true\n906|}\n907|\n908|// checkExecutePlanParameters validates the execute_plan parameter\n909|// union member.\n910|func checkExecutePlanParameters(members map[string]json.RawMessage) bool {\n911|\tif _, ok := checkDigest(members[\"plan_id\"]); !ok {\n912|\t\treturn false\n913|\t}\n914|\tif _, ok := checkUUIDv7(members[\"operation_id\"]); !ok {\n915|\t\treturn false\n916|\t}\n917|\telements, ok := decodeArray(members[\"confirmations\"])\n918|\tif !ok || len(elements) > 64 {\n919|\t\treturn false\n920|\t}\n921|\tvar previous string\n922|\tfor index, element := range elements {\n923|\t\tconfirmation, ok := rawString(element)\n924|\t\tif !ok {\n925|\t\t\treturn false\n926|\t\t}\n927|\t\tif index > 0 && previous >= confirmation {\n928|\t\t\treturn false\n929|\t\t}\n930|\t\tprevious = confirmation\n931|\t}\n932|\treturn true\n933|}\n934|\n935|// checkFilters validates one DirectoryFilters object: the exact\n936|// closed members with per-member shapes.\n937|func checkFilters(raw json.RawMessage) bool {\n938|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n939|\tif fault != nil {\n940|\t\treturn false\n941|\t}\n942|\tif name, unknown := unknownMember(members, filterMembers); unknown {\n943|\t\t_ = name\n944|\t\treturn false\n945|\t}\n946|\tif name, missing := missingMember(members, filterRequired); missing {\n947|\t\t_ = name\n948|\t\treturn false\n949|\t}\n950|\tif !checkEnumSubset(members[\"kinds\"], []string{\"lineage\", \"managed_session\", \"native_instance\"}, 1, 64, 0, 3) {\n951|\t\treturn false\n952|\t}\n953|\tif !checkUUIDv7DigestSubset(members[\"lineage_anchors\"], 0, 256) {\n954|\t\treturn false\n955|\t}\n956|\tproviders, ok := checkSortedUniqueStrings(members[\"provider_ids\"], 1, 32, 0, 64)\n957|\tif !ok {\n958|\t\treturn false\n959|\t}\n960|\tfor _, provider := range providers {\n961|\t\tif !providerIDPattern.MatchString(provider) {\n962|\t\t\treturn false\n963|\t\t}\n964|\t}\n965|\tif _, ok := checkSortedUniqueUUIDv7(members[\"host_ids\"], 0, 256); !ok {\n966|\t\treturn false\n967|\t}\n968|\tif _, ok := checkSortedUniqueUUIDv7(members[\"workspace_ids\"], 0, 256); !ok {\n969|\t\treturn false\n970|\t}\n971|\tif _, ok := checkSortedUniqueStrings(members[\"states\"], 1, 128, 0, 64); !ok {\n972|\t\treturn false\n973|\t}\n974|\tif !checkEnumSubset(members[\"management_states\"], []string{\"managed\", \"unmanaged\", \"conflicted\"}, 1, 32, 0, 3) {\n975|\t\treturn false\n976|\t}\n977|\tif !checkEnumSubset(members[\"reachability\"], []string{\"local\", \"reachable\", \"unreachable\", \"unknown\"}, 1, 32, 0, 4) {\n978|\t\treturn false\n979|\t}\n980|\tif !checkEnumSubset(members[\"freshness\"], []string{\"current\", \"aging\", \"stale\", \"offline\", \"partial\", \"conflicted\", \"unknown\"}, 1, 32, 0, 7) {\n981|\t\treturn false\n982|\t}\n983|\tif _, ok := checkSortedUniqueStrings(members[\"warnings\"], 1, 256, 0, 128); !ok {\n984|\t\treturn false\n985|\t}\n986|\tif !isNull(members[\"updated_before\"]) {\n987|\t\tif _, ok := checkTimestamp(members[\"updated_before\"]); !ok {\n988|\t\t\treturn false\n989|\t\t}\n990|\t}\n991|\tif !isNull(members[\"updated_after\"]) {\n992|\t\tif _, ok := checkTimestamp(members[\"updated_after\"]); !ok {\n993|\t\t\treturn false\n994|\t\t}\n995|\t}\n996|\treturn checkExtensions(members[\"extensions\"])\n997|}\n998|\n999|// checkEnumSubset reports whether the member is a sorted unique\n1000|// subset of the vocabulary table in the item and count bounds.\n1001|func checkEnumSubset(raw json.RawMessage, vocabulary []string, minimumLength, maximumLength int, minimumCount, maximumCount uint64) bool {\n1002|\tvalues, ok := checkSortedUniqueStrings(raw, minimumLength, maximumLength, minimumCount, maximumCount)\n1003|\tif !ok {\n1004|\t\treturn false\n1005|\t}\n1006|\tfor _, value := range values {\n1007|\t\tallowed := false\n1008|\t\tfor _, candidate := range vocabulary {\n1009|\t\t\tif value == candidate {\n1010|\t\t\t\tallowed = true\n1011|\t\t\t\tbreak\n1012|\t\t\t}\n1013|\t\t}\n1014|\t\tif !allowed {\n1015|\t\t\treturn false\n1016|\t\t}\n1017|\t}\n1018|\treturn true\n1019|}\n1020|\n1021|// checkUUIDv7DigestSubset reports whether the member is a sorted\n1022|// unique array of UUIDv7|digest unions in the count bound.\n1023|func checkUUIDv7DigestSubset(raw json.RawMessage, minimumCount, maximumCount uint64) bool {\n1024|\telements, ok := decodeArray(raw)\n1025|\tif !ok {\n1026|\t\treturn false\n1027|\t}\n1028|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n1029|\t\treturn false\n1030|\t}\n1031|\tvar previous string\n1032|\tfor index, element := range elements {\n1033|\t\tidentifier, ok := rawString(element)\n1034|\t\tif !ok {\n1035|\t\t\treturn false\n1036|\t\t}\n1037|\t\tif _, err := scalar.ParseUUIDv7(identifier); err != nil {\n1038|\t\t\tif _, digestErr := checkDigestString(identifier); !digestErr {\n1039|\t\t\t\treturn false\n1040|\t\t\t}\n1041|\t\t}\n1042|\t\tif index > 0 && previous >= identifier {\n1043|\t\t\treturn false\n1044|\t\t}\n1045|\t\tprevious = identifier\n1046|\t}\n1047|\treturn true\n1048|}\n1049|\n1050|// checkQueryProjection validates the fields/preset rules: the two\n1051|// are mutually exclusive; both are null for mutations and count;\n1052|// projecting reads carry a sorted unique field subset or a\n1053|// registry preset, never both.\n1054|func checkQueryProjection(name string, kind queryOperationKind, fieldsRaw, presetRaw json.RawMessage) bool {\n1055|\tfieldsNull := isNull(fieldsRaw)\n1056|\tpresetNull := isNull(presetRaw)\n1057|\tif kind == queryKindMutation || name == \"count\" {\n1058|\t\treturn fieldsNull && presetNull\n1059|\t}\n1060|\tif !fieldsNull && !presetNull {\n1061|\t\treturn false\n1062|\t}\n1063|\tif !fieldsNull {\n1064|\t\tfields, ok := checkSortedUniqueStrings(fieldsRaw, 1, 64, 0, 128)\n1065|\t\tif !ok {\n1066|\t\t\treturn false\n1067|\t\t}\n1068|\t\tfor _, field := range fields {\n1069|\t\t\tif !validQueryField(field) {\n1070|\t\t\t\treturn false\n1071|\t\t\t}\n1072|\t\t}\n1073|\t\treturn true\n1074|\t}\n1075|\tif !presetNull {\n1076|\t\tpreset, ok := rawString(presetRaw)\n1077|\t\tif !ok || !validQueryPreset(preset) {\n1078|\t\t\treturn false\n1079|\t\t}\n1080|\t}\n1081|\treturn true\n1082|}\n1083|\n1084|// checkQueryPagination validates the skip/take rules: only list\n1085|// operations may use nonzero skip or take other than 1.\n1086|func checkQueryPagination(name string, skipRaw, takeRaw json.RawMessage) bool {\n1087|\tskip, ok := rawUint53(skipRaw)\n1088|\tif !ok || skip > 1000000 {\n1089|\t\treturn false\n1090|\t}\n1091|\ttake, ok := rawUint53(takeRaw)\n1092|\tif !ok || take < 1 || take > 1000 {\n1093|\t\treturn false\n1094|\t}\n1095|\tif isListOperation(name) {\n1096|\t\treturn true\n1097|\t}\n1098|\treturn skip == 0 && take == 1\n1099|}\n1100|\n1101|// checkQuerySort validates the sort tuple array: QuerySort[0..8]\n1102|// with registry fields and directions.\n1103|func checkQuerySort(raw json.RawMessage) bool {\n1104|\telements, ok := decodeArray(raw)\n1105|\tif !ok || len(elements) > 8 {\n1106|\t\treturn false\n1107|\t}\n1108|\tfor _, element := range elements {\n1109|\t\tmembers, fault := decodeStrictObject(bytesTrimSpace(element))\n1110|\t\tif fault != nil {\n1111|\t\t\treturn false\n1112|\t\t}\n1113|\t\tif name, unknown := unknownMember(members, sortMembers); unknown {\n1114|\t\t\t_ = name\n1115|\t\t\treturn false\n1116|\t\t}\n1117|\t\tif name, missing := missingMember(members, sortRequired); missing {\n1118|\t\t\t_ = name\n1119|\t\t\treturn false\n1120|\t\t}\n1121|\t\tfield, ok := rawString(members[\"field\"])\n1122|\t\tif !ok {\n1123|\t\t\treturn false\n1124|\t\t}\n1125|\t\tallowed := false\n1126|\t\tfor _, candidate := range querySortFields {\n1127|\t\t\tif field == candidate {\n1128|\t\t\t\tallowed = true\n1129|\t\t\t\tbreak\n1130|\t\t\t}\n1131|\t\t}\n1132|\t\tif !allowed {\n1133|\t\t\treturn false\n1134|\t\t}\n1135|\t\tdirection, ok := rawString(members[\"direction\"])\n1136|\t\tif !ok || (direction != \"asc\" && direction != \"desc\") {\n1137|\t\t\treturn false\n1138|\t\t}\n1139|\t\tif !checkExtensions(members[\"extensions\"]) {\n1140|\t\t\treturn false\n1141|\t\t}\n1142|\t}\n1143|\treturn true\n1144|}\n1145|\n1146|// checkQueryFlags validates the read/mutation flag rules. Read\n1147|// operations require dry_run=false, confirm=false, and null\n1148|// expectation and idempotency. Mutations require dry_run=true or\n1149|// confirm=true, never both; execute_plan requires confirm,\n1150|// expectation digest, and idempotency key; annotation mutations\n1151|// require expectation and idempotency when confirmed; planning is\n1152|// pure and uses dry run with no confirmation.\n1153|func checkQueryFlags(name string, kind queryOperationKind, members map[string]json.RawMessage) bool {\n1154|\tdryRun, ok := rawBool(members[\"dry_run\"])\n1155|\tif !ok {\n1156|\t\treturn false\n1157|\t}\n1158|\tconfirm, ok := rawBool(members[\"confirm\"])\n1159|\tif !ok {\n1160|\t\treturn false\n1161|\t}\n1162|\t_, expectationNull := optionalDigestNull(members[\"expectation_digest\"])\n1163|\t_, idempotencyNull := optionalDigestNull(members[\"idempotency_key\"])\n1164|\tif kind == queryKindRead {\n1165|\t\treturn !dryRun && !confirm && expectationNull && idempotencyNull\n1166|\t}\n1167|\tif dryRun == confirm {\n1168|\t\treturn false\n1169|\t}\n1170|\tswitch {\n1171|\tcase name == \"execute_plan\":\n1172|\t\treturn confirm && !dryRun && !expectationNull && !idempotencyNull\n1173|\tcase name == \"plan_continue\":\n1174|\t\treturn dryRun && !confirm\n1175|\tcase isAnnotationMutation(name):\n1176|\t\tif confirm {\n1177|\t\t\treturn !expectationNull && !idempotencyNull\n1178|\t\t}\n1179|\t\treturn true\n1180|\tdefault:\n1181|\t\treturn true\n1182|\t}\n1183|}\n1184|\n1185|// optionalDigestNull reports whether the member is an explicit\n1186|// null; otherwise it must be a digest. The second result is false\n1187|// for any other shape.\n1188|func optionalDigestNull(raw json.RawMessage) (string, bool) {\n1189|\tif isNull(raw) {\n1190|\t\treturn \"\", true\n1191|\t}\n1192|\tdigest, ok := checkDigest(raw)\n1193|\tif !ok {\n1194|\t\treturn \"\", false\n1195|\t}\n1196|\treturn digest.String(), false\n1197|}\n1198|\n1199|// CheckCursorReuse validates one returned cursor against the query\n1200|// bounds it was issued under. A cursor is an opaque\n1201|// string[1..1024] integrity-bound to query schema version, caller,\n1202|// disclosure policy, operation name, parameters, projection, sort\n1203|// tuple, and last stable key; reuse after any bound value changes\n1204|// is refused with query_invalid, never a best-effort continuation.\n1205|// The pinned error registry does not register the\n1206|// query_cursor_mismatch code the Section 10.8.5 prose names, so the\n1207|// refusal carries query_invalid with a cursor-mismatch detail —\n1208|// the divergence is recorded here, not hidden.\n1209|func CheckCursorReuse(cursor string, boundsChanged bool) error {\n1210|\tif stringLength(cursor) < 1 || stringLength(cursor) > 1024 {\n1211|\t\tfailure, err := failQuery(\"directory cursor is not a string[1..1024]\", \"cursor\")\n1212|\t\tif err != nil {\n1213|\t\t\treturn err\n1214|\t\t}\n1215|\t\treturn failure\n1216|\t}\n1217|\tif boundsChanged {\n1218|\t\tfailure, err := failQuery(\"directory cursor is bound to a changed query\", \"cursor\")\n1219|\t\tif err != nil {\n1220|\t\t\treturn err\n1221|\t\t}\n1222|\t\treturn failure\n1223|\t}\n1224|\treturn nil\n1225|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e1","stream":{"kind":"session","id":"01a07573-a73b-7be0-abe2-6029bca74ffd"},"sequence":203,"recorded_at":1780531400000401,"record_type":"event","durability":"durable","causation_id":"65c281d8-14aa-4def-b705-62e70b4fce66","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"65c281d8-14aa-4def-b705-62e70b4fce66","run_stream":{"kind":"run","id":"65c281d8-14aa-4def-b705-62e70b4fce66"},"call_id":"call_01a0757417ff7d009522f36bc2678c8b","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/dirnode/decode.go`.\n(199 line(s) above)\n200|\tvar value any\n201|\tif err := decoder.Decode(&value); err != nil {\n202|\t\treturn 0, false\n203|\t}\n204|\tnumber, ok := value.(json.Number)\n205|\tif !ok {\n206|\t\treturn 0, false\n207|\t}\n208|\tliteral := number.String()\n209|\tif literal == \"\" || strings.ContainsAny(literal, \".eE+-\") {\n210|\t\treturn 0, false\n211|\t}\n212|\treturn parseUint53Literal(literal)\n213|}\n214|\n215|// parseUint53Literal reads a digit-only literal without trusting a\n216|// float conversion: the magnitude bound is checked on the digit\n217|// string, so 2^53 is refused even on platforms that could hold it.\n218|func parseUint53Literal(literal string) (uint64, bool) {\n219|\tvar value uint64\n220|\tfor index := 0; index < len(literal); index++ {\n221|\t\tdigit := literal[index]\n222|\t\tif digit < '0' || digit > '9' {\n223|\t\t\treturn 0, false\n224|\t\t}\n225|\t\tvalue = value*10 + uint64(digit-'0')\n226|\t\tif value > maxUint53 {\n227|\t\t\treturn 0, false\n228|\t\t}\n229|\t}\n230|\treturn value, true\n231|}\n232|\n233|// stringLength is the Section 1.6 string measure in characters, not\n234|// bytes.\n235|func stringLength(value string) int {\n236|\treturn utf8.RuneCountInString(value)\n237|}\n238|\n239|// checkStringBounds reports whether the member is a JSON string whose\n240|// character count falls in the inclusive bound.\n241|func checkStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n242|\tvalue, ok := rawString(raw)\n243|\tif !ok {\n244|\t\treturn \"\", false\n245|\t}\n246|\tlength := stringLength(value)\n247|\tif length < minimum || length > maximum {\n248|\t\treturn \"\", false\n249|\t}\n250|\treturn value, true\n251|}\n252|\n253|// checkUint53Bounds reports whether the member is a uint53 in the\n254|// inclusive bound. Both edges are checked: a one-sided check would\n255|// admit the open side.\n256|func checkUint53Bounds(raw json.RawMessage, minimum, maximum uint64) (uint64, bool) {\n257|\tvalue, ok := rawUint53(raw)\n258|\tif !ok {\n259|\t\treturn 0, false\n260|\t}\n261|\tif value < minimum || value > maximum {\n262|\t\treturn 0, false\n263|\t}\n264|\treturn value, true\n265|}\n266|\n267|// checkDigest reports whether the member is a digest of the pinned\n268|// sha256 form.\n269|func checkDigest(raw json.RawMessage) (scalar.Digest, bool) {\n270|\tvalue, ok := rawString(raw)\n271|\tif !ok {\n272|\t\treturn scalar.Digest{}, false\n273|\t}\n274|\tdigest, err := scalar.ParseDigest(value)\n275|\tif err != nil {\n276|\t\treturn scalar.Digest{}, false\n277|\t}\n278|\treturn digest, true\n279|}\n280|\n281|// checkUUIDv7 reports whether the member is a lowercase UUIDv7.\n282|func checkUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n283|\tvalue, ok := rawString(raw)\n284|\tif !ok {\n285|\t\treturn scalar.UUIDv7{}, false\n286|\t}\n287|\tidentifier, err := scalar.ParseUUIDv7(value)\n288|\tif err != nil {\n289|\t\treturn scalar.UUIDv7{}, false\n290|\t}\n291|\treturn identifier, true\n292|}\n293|\n294|// checkTimestamp reports whether the member is a pinned timestamp.\n295|func checkTimestamp(raw json.RawMessage) (scalar.Timestamp, bool) {\n296|\tvalue, ok := rawString(raw)\n297|\tif !ok {\n298|\t\treturn scalar.Timestamp{}, false\n299|\t}\n300|\tinstant, err := scalar.ParseTimestamp(value)\n301|\tif err != nil {\n302|\t\treturn scalar.Timestamp{}, false\n303|\t}\n304|\treturn instant, true\n305|}\n306|\n307|// checkDigestString reports whether the value parses as a digest of\n308|// the pinned form.\n309|func checkDigestString(value string) (string, bool) {\n310|\tdigest, err := scalar.ParseDigest(value)\n311|\tif err != nil {\n312|\t\treturn \"\", false\n313|\t}\n314|\treturn digest.String(), true\n315|}\n316|\n317|// isNull reports whether the member is an explicit JSON null.\n318|func isNull(raw json.RawMessage) bool {\n319|\treturn string(bytes.TrimSpace(raw)) == \"null\"\n320|}\n321|\n322|// decodeArray reads a JSON array member into its raw elements. A\n323|// non-array — including null — is not an empty array.\n324|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n325|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n326|\ttoken, err := decoder.Token()\n327|\tif err != nil {\n328|\t\treturn nil, false\n329|\t}\n330|\tdelim, ok := token.(json.Delim)\n331|\tif !ok || delim != '[' {\n332|\t\treturn nil, false\n333|\t}\n334|\tvar elements []json.RawMessage\n335|\tfor decoder.More() {\n336|\t\tvar element json.RawMessage\n337|\t\tif err := decoder.Decode(&element); err != nil {\n338|\t\t\treturn nil, false\n339|\t\t}\n340|\t\telements = append(elements, element)\n341|\t}\n342|\tif token, err := decoder.Token(); err != nil {\n343|\t\treturn nil, false\n344|\t} else if delim, ok := token.(json.Delim); !ok || delim != ']' {\n345|\t\treturn nil, false\n346|\t}\n347|\tif _, err := decoder.Token(); err != io.EOF {\n348|\t\treturn nil, false\n349|\t}\n350|\treturn elements, true\n351|}\n352|\n353|// checkSortedUniqueStrings reports whether the member is an array of\n354|// strings in the item bound whose encodings order strictly\n355|// increasingly with no duplicates, in the count bound.\n356|func checkSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n357|\telements, ok := decodeArray(raw)\n358|\tif !ok {\n359|\t\treturn nil, false\n360|\t}\n361|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n362|\t\treturn nil, false\n363|\t}\n364|\tvalues := make([]string, 0, len(elements))\n365|\tfor _, element := range elements {\n366|\t\tvalue, ok := rawString(element)\n367|\t\tif !ok {\n368|\t\t\treturn nil, false\n369|\t\t}\n370|\t\tlength := stringLength(value)\n371|\t\tif length < minimumLength || length > maximumLength {\n372|\t\t\treturn nil, false\n373|\t\t}\n374|\t\tvalues = append(values, value)\n375|\t}\n376|\tfor index := 1; index < len(values); index++ {\n377|\t\tif values[index-1] >= values[index] {\n378|\t\t\treturn nil, false\n379|\t\t}\n380|\t}\n381|\treturn values, true\n382|}\n383|\n384|// checkSortedUniqueDigests reports whether the member is a sorted\n385|// unique digest array in the count bound.\n386|func checkSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\n387|\telements, ok := decodeArray(raw)\n388|\tif !ok {\n389|\t\treturn nil, false\n390|\t}\n391|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n392|\t\treturn nil, false\n393|\t}\n394|\tvalues := make([]scalar.Digest, 0, len(elements))\n395|\tfor _, element := range elements {\n396|\t\tdigest, ok := checkDigest(element)\n397|\t\tif !ok {\n398|\t\t\treturn nil, false\n399|\t\t}\n400|\t\tvalues = append(values, digest)\n401|\t}\n402|\tfor index := 1; index < len(values); index++ {\n403|\t\tif values[index-1].String() >= values[index].String() {\n404|\t\t\treturn nil, false\n405|\t\t}\n406|\t}\n407|\treturn values, true\n408|}\n409|\n410|// checkSortedUniqueUUIDv7 reports whether the member is a sorted\n411|// unique UUIDv7 array in the count bound.\n412|func checkSortedUniqueUUIDv7(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.UUIDv7, bool) {\n413|\telements, ok := decodeArray(raw)\n414|\tif !ok {\n415|\t\treturn nil, false\n416|\t}\n417|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n418|\t\treturn nil, false\n419|\t}\n420|\tvalues := make([]scalar.UUIDv7, 0, len(elements))\n421|\tfor _, element := range elements {\n422|\t\tidentifier, ok := checkUUIDv7(element)\n423|\t\tif !ok {\n424|\t\t\treturn nil, false\n425|\t\t}\n426|\t\tvalues = append(values, identifier)\n427|\t}\n428|\tfor index := 1; index < len(values); index++ {\n429|\t\tif values[index-1].String() >= values[index].String() {\n430|\t\t\treturn nil, false\n431|\t\t}\n432|\t}\n433|\treturn values, true\n434|}\n435|\n436|// checkOptionalDigest reads a digest|null member: null is the only\n437|// accepted absence, and any other non-digest is not an absence.\n438|func checkOptionalDigest(raw json.RawMessage) (scalar.Digest, bool, bool) {\n439|\tif isNull(raw) {\n440|\t\treturn scalar.Digest{}, true, true\n441|\t}\n442|\tdigest, ok := checkDigest(raw)\n443|\tif !ok {\n444|\t\treturn scalar.Digest{}, false, false\n445|\t}\n446|\treturn digest, true, false\n447|}\n448|\n449|// checkOptionalString reads a bounded string|null member with the\n450|// same absence rule.\n451|func checkOptionalString(raw json.RawMessage, minimum, maximum int) (string, bool, bool) {\n452|\tif isNull(raw) {\n453|\t\treturn \"\", true, true\n454|\t}\n455|\tvalue, ok := checkStringBounds(raw, minimum, maximum)\n456|\tif !ok {\n457|\t\treturn \"\", false, false\n458|\t}\n459|\treturn value, true, false\n460|}\n461|\n462|// semverPattern is the SemVer grammar versions satisfy: three\n463|// dot-separated non-negative integers with no leading zeros, an\n464|// optional pre-release, and optional build metadata.\n465|var semverPattern = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n466|\n467|// environmentIDPattern is the environment-id grammar:\n468|// [a-z][a-z0-9.-]{0,63}.\n469|var environmentIDPattern = regexp.MustCompile(`^[a-z][a-z0-9.-]{0,63}$`)\n470|\n471|// reverseDNSPattern is the Section 1.6 extension-key grammar:\n472|// dot-separated lowercase labels.\n473|var reverseDNSPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,62}(\\.[a-z][a-z0-9-]{0,62})+$`)\n474|\n475|// checkSemver reports whether the value is a SemVer string.\n476|func checkSemver(value string) bool {\n477|\treturn semverPattern.MatchString(value)\n478|}\n479|\n480|// checkExtensions reports whether the member is an object whose keys\n481|// are all reverse-DNS names. Values cross opaquely: extensions\n482|// cannot add operations, capabilities, or trust facts, and no member\n483|// of this package reads an extension value for any admission\n484|// decision.\n485|func checkExtensions(raw json.RawMessage) bool {\n486|\tmembers, fault := decodeStrictObject(raw)\n487|\tif fault != nil {\n488|\t\treturn false\n489|\t}\n490|\tfor name := range members {\n491|\t\tif len(name) < 3 || len(name) > 253 || !reverseDNSPattern.MatchString(name) {\n492|\t\t\treturn false\n493|\t\t}\n494|\t}\n495|\treturn true\n496|}\n497|\n498|// checkURI reports whether the value is a URI reference of 1..512\n499|// characters: no whitespace or control characters, with a scheme\n500|// prefix. Contract identifiers in this contract family are URNs, so\n501|// the check requires the colon form rather than accepting any\n502|// relative string.\n503|func checkURI(value string) bool {\n504|\tlength := stringLength(value)\n505|\tif length < 1 || length > 512 {\n506|\t\treturn false\n507|\t}\n508|\tfor _, point := range value {\n509|\t\tif point < 0x21 || point > 0x7E {\n510|\t\t\treturn false\n511|\t\t}\n512|\t}\n513|\tcolon := strings.Index(value, \":\")\n514|\treturn colon > 0\n515|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e3","stream":{"kind":"session","id":"01a07573-a73b-7be0-abe2-6029bca74ffd"},"sequence":204,"recorded_at":1780531400000403,"record_type":"event","durability":"durable","causation_id":"65c281d8-14aa-4def-b705-62e70b4fce66","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"65c281d8-14aa-4def-b705-62e70b4fce66","run_stream":{"kind":"run","id":"65c281d8-14aa-4def-b705-62e70b4fce66"},"call_id":"call_01a07574193d73c1a41eabdd33166bfa","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/dirnode/protocol.go`.\n(199 line(s) above)\n200|// incompatible_protocol. failIntegrity reports a binding observation\n201|// that cannot be reconciled to trusted facts: a failed or partial\n202|// read, or façade bindings that contradict the observed candidate.\n203|// failIdempotency reports a changed body under a recorded\n204|// (operation, operation_id). failQuery reports a Session Directory\n205|// Query outside its closed shape; cursor reuse after a bound change\n206|// lands here because the pinned error registry does not register\n207|// the query_cursor_mismatch code the Section 10.8.5 prose names.\n208|// failTransport reports a missing response: timeout, signal, or exit\n209|// without one valid frame.\n210|//\n211|// Every constructor takes the human detail first as a string literal\n212|// at the call site and the distinguishing wire fact second, so the\n213|// inventory derives one obligation per literal detail and every\n214|// witness can assert which arm fired through the code plus the\n215|// distinguishing detail, not merely that something refused.\n216|var failInvalid = func(detail string, field string) (*axerror.Error, error) {\n217|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"invalid_config\", Message: \"directory node host refused the call: \" + detail, Details: axerror.Details{\"field\": field}})\n218|}\n219|\n220|var failViolation = func(detail string, member string) (*axerror.Error, error) {\n221|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"adapter_protocol_violation\", Message: \"directory node host rejected the node frame: \" + detail, Details: axerror.Details{\"member\": member}})\n222|}\n223|\n224|var failUnknownOperation = func(detail string, operation string) (*axerror.Error, error) {\n225|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"operation_unknown\", Message: \"directory node host refused an unknown operation: \" + detail, Details: axerror.Details{\"operation\": operation}})\n226|}\n227|\n228|var failDowngrade = func(detail string, subject string) (*axerror.Error, error) {\n229|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"incompatible_protocol\", Message: \"directory node host found no common major: \" + detail, Details: axerror.Details{\"subject\": subject}})\n230|}\n231|\n232|var failIntegrity = func(detail string, subject string) (*axerror.Error, error) {\n233|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"integrity_failure\", Message: \"directory node binding observation is not trusted state: \" + detail, Details: axerror.Details{\"subject\": subject}})\n234|}\n235|\n236|var failIdempotency = func(detail string, operation string) (*axerror.Error, error) {\n237|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"idempotency_mismatch\", Message: \"directory node host refused a changed idempotent body: \" + detail, Details: axerror.Details{\"operation\": operation}})\n238|}\n239|\n240|var failQuery = func(detail string, member string) (*axerror.Error, error) {\n241|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"query_invalid\", Message: \"directory node host refused the directory query: \" + detail, Details: axerror.Details{\"member\": member}})\n242|}\n243|\n244|var failTransport = func(detail string, subject string) (*axerror.Error, error) {\n245|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"transport_failure\", Message: \"directory node attempt produced no usable response: \" + detail, Details: axerror.Details{\"subject\": subject}})\n246|}\n247|\n248|// RefuseUnknownOperation refuses a dispatch name outside the closed\n249|// registry with operation_unknown. Dispatch refuses locally, before\n250|// any node surface is touched.\n251|func RefuseUnknownOperation(name string) error {\n252|\tfailure, err := failUnknownOperation(\"dispatch names an operation outside the closed registry\", name)\n253|\tif err != nil {\n254|\t\treturn err\n255|\t}\n256|\treturn failure\n257|}\n258|\n259|// requestMembers is the exact request envelope member set Section\n260|// 7.9 requires: schema, schema_version, protocol, protocol_version,\n261|// request_id, operation, deadline_ms, and body.\n262|var requestMembers = map[string]bool{\n263|\t\"schema\":           true,\n264|\t\"schema_version\":   true,\n265|\t\"protocol\":         true,\n266|\t\"protocol_version\": true,\n267|\t\"request_id\":       true,\n268|\t\"operation\":        true,\n269|\t\"deadline_ms\":      true,\n270|\t\"body\":             true,\n271|}\n272|\n273|// requestRequired lists requestMembers in a fixed order so an\n274|// envelope missing several members always names the same one.\n275|var requestRequired = []string{\n276|\t\"schema\",\n277|\t\"schema_version\",\n278|\t\"protocol\",\n279|\t\"protocol_version\",\n280|\t\"request_id\",\n281|\t\"operation\",\n282|\t\"deadline_ms\",\n283|\t\"body\",\n284|}\n285|\n286|// responseMembers is the exact response envelope member set both\n287|// success and failure carry: the response schema identity, the four\n288|// echoed request fields, ok, and exactly one of body or error.\n289|var responseMembers = map[string]bool{\n290|\t\"schema\":           true,\n291|\t\"schema_version\":   true,\n292|\t\"protocol\":         true,\n293|\t\"protocol_version\": true,\n294|\t\"request_id\":       true,\n295|\t\"operation\":        true,\n296|\t\"ok\":               true,\n297|\t\"body\":             true,\n298|\t\"error\":            true,\n299|}\n300|\n301|// responseRequired lists the members every response carries\n302|// regardless of branch.\n303|var responseRequired = []string{\n304|\t\"schema\",\n305|\t\"schema_version\",\n306|\t\"protocol\",\n307|\t\"protocol_version\",\n308|\t\"request_id\",\n309|\t\"operation\",\n310|\t\"ok\",\n311|}\n312|\n313|// Request is one Section 7.9 request envelope as the host wrote it:\n314|// the negotiated major, the identity fields, and the canonical body\n315|// bytes. Responses are checked against it, never trusted on their\n316|// own echo.\n317|type Request struct {\n318|\tMajor     int\n319|\tOperation Operation\n320|\tRequestID string\n321|\tBody      []byte\n322|}\n323|\n324|// EncodeRequest builds one manifest-attempt-style request frame for\n325|// the negotiated major: protocol_version and request schema_version\n326|// both bind the exact attempted N.0.0 version, and the body must be\n327|// one complete object. A major outside the local registry is an\n328|// invalid caller request, not a peer downgrade.\n329|func EncodeRequest(major int, operation Operation, requestID string, deadlineMS uint64, body []byte) ([]byte, error) {\n330|\tversion, ok := VersionForMajor(major)\n331|\tif !ok {\n332|\t\tfailure, err := failInvalid(\"request major is outside the locally supported registry\", \"protocol_version\")\n333|\t\tif err != nil {\n334|\t\t\treturn nil, err\n335|\t\t}\n336|\t\treturn nil, failure\n337|\t}\n338|\tif !validOperation(string(operation)) {\n339|\t\tfailure, err := failUnknownOperation(\"request names an operation outside the closed registry\", string(operation))\n340|\t\tif err != nil {\n341|\t\t\treturn nil, err\n342|\t\t}\n343|\t\treturn nil, failure\n344|\t}\n345|\tif _, err := scalar.ParseUUIDv7(requestID); err != nil {\n346|\t\tfailure, err := failInvalid(\"request identifier is not a UUIDv7\", \"request_id\")\n347|\t\tif err != nil {\n348|\t\t\treturn nil, err\n349|\t\t}\n350|\t\treturn nil, failure\n351|\t}\n352|\tif deadlineMS < MinDeadlineMS || deadlineMS > MaxDeadlineMS {\n353|\t\tfailure, err := failInvalid(\"request deadline is outside uint53[1..3600000]\", \"deadline_ms\")\n354|\t\tif err != nil {\n355|\t\t\treturn nil, err\n356|\t\t}\n357|\t\treturn nil, failure\n358|\t}\n359|\ttrimmed := bytes.TrimSpace(body)\n360|\tif _, fault := decodeStrictObject(trimmed); fault != nil {\n361|\t\tfailure, err := failViolation(\"request body \"+fault.detail, \"body\")\n362|\t\tif err != nil {\n363|\t\t\treturn nil, err\n364|\t\t}\n365|\t\treturn nil, failure\n366|\t}\n367|\tframe, err := json.Marshal(map[string]any{\n368|\t\t\"schema\":           RequestSchema,\n369|\t\t\"schema_version\":   version,\n370|\t\t\"protocol\":         ProtocolID,\n371|\t\t\"protocol_version\": version,\n372|\t\t\"request_id\":       requestID,\n373|\t\t\"operation\":        string(operation),\n374|\t\t\"deadline_ms\":      deadlineMS,\n375|\t\t\"body\":             json.RawMessage(trimmed),\n376|\t})\n377|\tif err != nil {\n378|\t\tfailure, faultErr := failViolation(\"request frame is not encodable\", \"\")\n379|\t\tif faultErr != nil {\n380|\t\t\treturn nil, faultErr\n381|\t\t}\n382|\t\treturn nil, failure\n383|\t}\n384|\treturn frame, nil\n385|}\n386|\n387|// DecodeRequestFrame validates one outbound request frame before it\n388|// reaches the node surface: one complete object within the frame\n389|// bound, the exact envelope members, the exact schema and protocol\n390|// identifiers, protocol_version and schema_version bound together to\n391|// one supported N.0.0, a UUIDv7 request identifier, a registry\n392|// operation, a deadline_ms in uint53[1..3600000], and an object\n393|// body. An unknown operation is operation_unknown; a version pair\n394|// that relabels one major as another is an\n395|// adapter_protocol_violation; every other envelope defect is an\n396|// adapter_protocol_violation. The returned body is the raw member\n397|// for the operation-layer checks.\n398|func DecodeRequestFrame(frame []byte) (Request, error) {\n399|\tif len(frame) == 0 {\n400|\t\tfailure, err := failViolation(\"request frame is empty\", \"\")\n401|\t\tif err != nil {\n402|\t\t\treturn Request{}, err\n403|\t\t}\n404|\t\treturn Request{}, failure\n405|\t}\n406|\tif len(frame) > MaxFrameBytes {\n407|\t\tfailure, err := failViolation(\"request frame exceeds the 8 MiB bound\", \"\")\n408|\t\tif err != nil {\n409|\t\t\treturn Request{}, err\n410|\t\t}\n411|\t\treturn Request{}, failure\n412|\t}\n413|\tmembers, fault := decodeStrictObject(frame)\n414|\tif fault != nil {\n415|\t\tfailure, err := failViolation(\"request envelope \"+fault.detail, fault.member)\n416|\t\tif err != nil {\n417|\t\t\treturn Request{}, err\n418|\t\t}\n419|\t\treturn Request{}, failure\n420|\t}\n421|\tif name, unknown := unknownMember(members, requestMembers); unknown {\n422|\t\tfailure, err := failViolation(\"request envelope carries unknown member\", name)\n423|\t\tif err != nil {\n424|\t\t\treturn Request{}, err\n425|\t\t}\n426|\t\treturn Request{}, failure\n427|\t}\n428|\tif name, missing := missingMember(members, requestRequired); missing {\n429|\t\tfailure, err := failViolation(\"request envelope misses a required member\", name)\n430|\t\tif err != nil {\n431|\t\t\treturn Request{}, err\n432|\t\t}\n433|\t\treturn Request{}, failure\n434|\t}\n435|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != RequestSchema {\n436|\t\tfailure, err := failViolation(\"request schema is not the directory node request\", \"schema\")\n437|\t\tif err != nil {\n438|\t\t\treturn Request{}, err\n439|\t\t}\n440|\t\treturn Request{}, failure\n441|\t}\n442|\tprotocolVersion, ok := rawString(members[\"protocol_version\"])\n443|\tif !ok {\n444|\t\tfailure, err := failViolation(\"request protocol version is not a string\", \"protocol_version\")\n445|\t\tif err != nil {\n446|\t\t\treturn Request{}, err\n447|\t\t}\n448|\t\treturn Request{}, failure\n449|\t}\n450|\tschemaVersion, ok := rawString(members[\"schema_version\"])\n451|\tif !ok {\n452|\t\tfailure, err := failViolation(\"request schema version is not a string\", \"schema_version\")\n453|\t\tif err != nil {\n454|\t\t\treturn Request{}, err\n455|\t\t}\n456|\t\treturn Request{}, failure\n457|\t}\n458|\tmajor, ok := MajorForVersion(protocolVersion)\n459|\tif !ok || schemaVersion != protocolVersion {\n460|\t\tfailure, err := failViolation(\"request versions do not bind one supported major\", \"protocol_version\")\n461|\t\tif err != nil {\n462|\t\t\treturn Request{}, err\n463|\t\t}\n464|\t\treturn Request{}, failure\n465|\t}\n466|\tif protocol, ok := rawString(members[\"protocol\"]); !ok || protocol != ProtocolID {\n467|\t\tfailure, err := failViolation(\"request protocol is not the directory node\", \"protocol\")\n468|\t\tif err != nil {\n469|\t\t\treturn Request{}, err\n470|\t\t}\n471|\t\treturn Request{}, failure\n472|\t}\n473|\trequestID, ok := rawString(members[\"request_id\"])\n474|\tif !ok {\n475|\t\tfailure, err := failViolation(\"request identifier is not a string\", \"request_id\")\n476|\t\tif err != nil {\n477|\t\t\treturn Request{}, err\n478|\t\t}\n479|\t\treturn Request{}, failure\n480|\t}\n481|\tif _, err := scalar.ParseUUIDv7(requestID); err != nil {\n482|\t\tfailure, err := failViolation(\"request identifier is not a UUIDv7\", \"request_id\")\n483|\t\tif err != nil {\n484|\t\t\treturn Request{}, err\n485|\t\t}\n486|\t\treturn Request{}, failure\n487|\t}\n488|\toperation, ok := rawString(members[\"operation\"])\n489|\tif !ok {\n490|\t\tfailure, err := failViolation(\"request operation is not a string\", \"operation\")\n491|\t\tif err != nil {\n492|\t\t\treturn Request{}, err\n493|\t\t}\n494|\t\treturn Request{}, failure\n495|\t}\n496|\tif !validOperation(operation) {\n497|\t\tfailure, err := failUnknownOperation(\"request names an operation outside the closed registry\", operation)\n498|\t\tif err != nil {\n499|\t\t\treturn Request{}, err\n500|\t\t}\n501|\t\treturn Request{}, failure\n502|\t}\n503|\tif _, ok := checkUint53Bounds(members[\"deadline_ms\"], MinDeadlineMS, MaxDeadlineMS); !ok {\n504|\t\tfailure, err := failViolation(\"request deadline is not uint53[1..3600000]\", \"deadline_ms\")\n505|\t\tif err != nil {\n506|\t\t\treturn Request{}, err\n507|\t\t}\n508|\t\treturn Request{}, failure\n509|\t}\n510|\tbody := bytes.TrimSpace(members[\"body\"])\n511|\tif _, fault := decodeStrictObject(body); fault != nil {\n512|\t\tfailure, err := failViolation(\"request body \"+fault.detail, \"body\")\n513|\t\tif err != nil {\n514|\t\t\treturn Request{}, err\n515|\t\t}\n516|\t\treturn Request{}, failure\n517|\t}\n518|\treturn Request{Major: major, Operation: Operation(operation), RequestID: requestID, Body: body}, nil\n519|}\n520|\n521|// checkResponseIdentity validates one inbound response frame\n522|// against the request that caused it: one complete object within\n523|// the frame bound, no unknown member, every required member\n524|// present, the response schema identity exact, and the four\n525|// identity fields echoed exactly. It returns the members for the\n526|// branch checks. ok and the branch member are validated by the\n527|// caller: a frame carrying neither branch is incomplete, and one\n528|// carrying both claims two outcomes at once.\n529|func checkResponseIdentity(frame []byte, want Request, context string) (map[string]json.RawMessage, error) {\n530|\tif len(frame) == 0 {\n531|\t\tfailure, err := failViolation(context+\" frame is empty\", \"\")\n532|\t\tif err != nil {\n533|\t\t\treturn nil, err\n534|\t\t}\n535|\t\treturn nil, failure\n536|\t}\n537|\tif len(frame) > MaxFrameBytes {\n538|\t\tfailure, err := failViolation(context+\" frame exceeds the 8 MiB bound\", \"\")\n539|\t\tif err != nil {\n540|\t\t\treturn nil, err\n541|\t\t}\n542|\t\treturn nil, failure\n543|\t}\n544|\tmembers, fault := decodeStrictObject(frame)\n545|\tif fault != nil {\n546|\t\tfailure, err := failViolation(context+\" envelope \"+fault.detail, fault.member)\n547|\t\tif err != nil {\n548|\t\t\treturn nil, err\n549|\t\t}\n550|\t\treturn nil, failure\n551|\t}\n552|\tif name, unknown := unknownMember(members, responseMembers); unknown {\n553|\t\tfailure, err := failViolation(context+\" envelope carries unknown member\", name)\n554|\t\tif err != nil {\n555|\t\t\treturn nil, err\n556|\t\t}\n557|\t\treturn nil, failure\n558|\t}\n559|\tif name, missing := missingMember(members, responseRequired); missing {\n560|\t\tfailure, err := failViolation(context+\" envelope misses a required member\", name)\n561|\t\tif err != nil {\n562|\t\t\treturn nil, err\n563|\t\t}\n564|\t\treturn nil, failure\n565|\t}\n566|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != ResponseSchema {\n567|\t\tfailure, err := failViolation(context+\" schema is not the directory node response\", \"schema\")\n568|\t\tif err != nil {\n569|\t\t\treturn nil, err\n570|\t\t}\n571|\t\treturn nil, failure\n572|\t}\n573|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != ResponseSchemaVersion {\n574|\t\tfailure, err := failViolation(context+\" schema version is not the bound 1.0.0\", \"schema_version\")\n575|\t\tif err != nil {\n576|\t\t\treturn nil, err\n577|\t\t}\n578|\t\treturn nil, failure\n579|\t}\n580|\tversion, _ := VersionForMajor(want.Major)\n581|\tif protocol, ok := rawString(members[\"protocol\"]); !ok || protocol != ProtocolID {\n582|\t\tfailure, err := failViolation(context+\" protocol does not echo the request\", \"protocol\")\n583|\t\tif err != nil {\n584|\t\t\treturn nil, err\n585|\t\t}\n586|\t\treturn nil, failure\n587|\t}\n588|\tif protocolVersion, ok := rawString(members[\"protocol_version\"]); !ok || protocolVersion != version {\n589|\t\tfailure, err := failViolation(context+\" protocol version does not echo the request\", \"protocol_version\")\n590|\t\tif err != nil {\n591|\t\t\treturn nil, err\n592|\t\t}\n593|\t\treturn nil, failure\n594|\t}\n595|\tif requestID, ok := rawString(members[\"request_id\"]); !ok || requestID != want.RequestID {\n596|\t\tfailure, err := failViolation(context+\" request identifier does not echo the request\", \"request_id\")\n597|\t\tif err != nil {\n598|\t\t\treturn nil, err\n599|\t\t}\n600|\t\treturn nil, failure\n601|\t}\n602|\tif operation, ok := rawString(members[\"operation\"]); !ok || operation != string(want.Operation) {\n603|\t\tfailure, err := failViolation(context+\" operation does not echo the request\", \"operation\")\n604|\t\tif err != nil {\n605|\t\t\treturn nil, err\n606|\t\t}\n607|\t\treturn nil, failure\n608|\t}\n609|\treturn members, nil\n610|}\n611|\n612|// CheckSuccessEnvelope validates one inbound success frame against\n613|// the request that caused it: exact identity echo, ok=true, an\n614|// object body, and no error member. Body and error are disjoint,\n615|// never nullable sentinels: a frame carrying both or neither is a\n616|// protocol violation. The returned body is the raw member for the\n617|// operation-layer checks.\n618|func CheckSuccessEnvelope(frame []byte, want Request) ([]byte, error) {\n619|\tmembers, err := checkResponseIdentity(frame, want, \"success\")\n620|\tif err != nil {\n621|\t\treturn nil, err\n622|\t}\n623|\tpositive, ok := rawBool(members[\"ok\"])\n624|\tif !ok || !positive {\n625|\t\tfailure, faultErr := failViolation(\"success envelope does not carry ok=true\", \"ok\")\n626|\t\tif faultErr != nil {\n627|\t\t\treturn nil, faultErr\n628|\t\t}\n629|\t\treturn nil, failure\n630|\t}\n631|\tif _, present := members[\"error\"]; present {\n632|\t\tfailure, faultErr := failViolation(\"success envelope carries both body and error\", \"error\")\n633|\t\tif faultErr != nil {\n634|\t\t\treturn nil, faultErr\n635|\t\t}\n636|\t\treturn nil, failure\n637|\t}\n638|\traw, present := members[\"body\"]\n639|\tif !present {\n640|\t\tfailure, faultErr := failViolation(\"success envelope carries neither body nor error\", \"body\")\n641|\t\tif faultErr != nil {\n642|\t\t\treturn nil, faultErr\n643|\t\t}\n644|\t\treturn nil, failure\n645|\t}\n646|\tbody := bytes.TrimSpace(raw)\n647|\tif _, fault := decodeStrictObject(body); fault != nil {\n648|\t\tfailure, faultErr := failViolation(\"success body \"+fault.detail, \"body\")\n649|\t\tif faultErr != nil {\n650|\t\t\treturn nil, faultErr\n651|\t\t}\n652|\t\treturn nil, failure\n653|\t}\n654|\treturn body, nil\n655|}\n656|\n657|// CheckFailureEnvelope validates one inbound failure frame against\n658|// the request that caused it: exact identity echo, ok=false, a\n659|// closed Structured Error 1.2.0 object in error, and no body\n660|// member. The error object itself must decode under the bound\n661|// version; a failure that cannot be read is an integrity failure,\n662|// never a retryable result.\n663|func CheckFailureEnvelope(frame []byte, want Request) (*axerror.Error, error) {\n664|\tmembers, err := checkResponseIdentity(frame, want, \"failure\")\n665|\tif err != nil {\n666|\t\treturn nil, err\n667|\t}\n668|\tpositive, ok := rawBool(members[\"ok\"])\n669|\tif !ok || positive {\n670|\t\tfailure, faultErr := failViolation(\"failure envelope does not carry ok=false\", \"ok\")\n671|\t\tif faultErr != nil {\n672|\t\t\treturn nil, faultErr\n673|\t\t}\n674|\t\treturn nil, failure\n675|\t}\n676|\tif _, present := members[\"body\"]; present {\n677|\t\tfailure, faultErr := failViolation(\"failure envelope carries both body and error\", \"body\")\n678|\t\tif faultErr != nil {\n679|\t\t\treturn nil, faultErr\n680|\t\t}\n681|\t\treturn nil, failure\n682|\t}\n683|\traw, present := members[\"error\"]\n684|\tif !present {\n685|\t\tfailure, faultErr := failViolation(\"failure envelope carries neither body nor error\", \"error\")\n686|\t\tif faultErr != nil {\n687|\t\t\treturn nil, faultErr\n688|\t\t}\n689|\t\treturn nil, failure\n690|\t}\n691|\tdecoded, decodeErr := axerror.Decode(ErrorVersion, bytes.TrimSpace(raw))\n692|\tif decodeErr != nil {\n693|\t\tfailure, faultErr := failIntegrity(\"failure error is not a Structured Error 1.2.0\", \"error\")\n694|\t\tif faultErr != nil {\n695|\t\t\treturn nil, faultErr\n696|\t\t}\n697|\t\treturn nil, failure\n698|\t}\n699|\treturn decoded, nil\n700|}\n701|\n702|// requestVersion reports the exact N.0.0 version a Request was\n703|// issued under. It cannot fail: DecodeRequestFrame and\n704|// EncodeRequest admit only the two closed bindings.\n705|func requestVersion(want Request) string {\n706|\tversion, _ := VersionForMajor(want.Major)\n707|\treturn version\n708|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
