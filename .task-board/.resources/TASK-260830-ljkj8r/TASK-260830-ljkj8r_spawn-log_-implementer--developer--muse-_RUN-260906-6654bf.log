{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c579","stream":{"kind":"session","id":"01a07573-a73b-7be0-abe2-6029bca74ffd"},"sequence":279,"recorded_at":1780531400000553,"record_type":"event","durability":"durable","causation_id":"65c281d8-14aa-4def-b705-62e70b4fce66","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"65c281d8-14aa-4def-b705-62e70b4fce66","run_stream":{"kind":"run","id":"65c281d8-14aa-4def-b705-62e70b4fce66"},"task_stream":{"kind":"task","id":"80d38b3f-4fe1-4012-b747-f13af796252a"},"task_id":"80d38b3f-4fe1-4012-b747-f13af796252a","event":{"kind":"output","task_id":"80d38b3f-4fe1-4012-b747-f13af796252a","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/bound_census_test.go`.\n(149 line(s) above)\n150|// from len(...) or stringLength(...) and guards holding a direct\n151|// stringLength(...) call (review rev6). Scopes are FuncDecl\n152|// bodies and package-level var initializers under their variable\n153|// name. Values are deliberately not part of the identity. A\n154|// func-value indirection of any helper (`var f =\n155|// requireStringBounds`, at package or function scope) is a\n156|// census violation, not a missed site: refusals built through\n157|// the alias hide from this derivation exactly the way\n158|// axerror.New aliases hid from the constructor census (review\n159|// rev4/N8), and the import-census shape applies here — the alias\n160|// itself fails rather than each hidden call. The synthetic\n161|// TestBoundHelperIndirectionReports,\n162|// TestBoundLenScanSeesNonIfContexts, and\n163|// TestBoundLenScanSeesLengthVariables prove the halves.\n164|func scanBoundSiteIDs(t *testing.T, directory string) []string {\n165|\tt.Helper()\n166|\tentries, err := os.ReadDir(directory)\n167|\tif err != nil {\n168|\t\tt.Fatalf(\"bound census: %v\", err)\n169|\t}\n170|\tvar ids []string\n171|\tscanned := 0\n172|\tfor _, entry := range entries {\n173|\t\tname := entry.Name()\n174|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n175|\t\t\tcontinue\n176|\t\t}\n177|\t\tscanned++\n178|\t\tpath := filepath.Join(directory, name)\n179|\t\tsource, err := os.ReadFile(path)\n180|\t\tif err != nil {\n181|\t\t\tt.Fatalf(\"bound census: %v\", err)\n182|\t\t}\n183|\t\tfileSet := token.NewFileSet()\n184|\t\tsyntax, err := parser.ParseFile(fileSet, path, source, 0)\n185|\t\tif err != nil {\n186|\t\t\tt.Fatalf(\"bound census: %v\", err)\n187|\t\t}\n188|\t\tsites, violations := boundSitesInSyntax(syntax, name)\n189|\t\tfor _, violation := range violations {\n190|\t\t\tt.Errorf(\"bound census: %s: %s\", name, violation)\n191|\t\t}\n192|\t\tids = append(ids, sites...)\n193|\t}\n194|\tif scanned == 0 {\n195|\t\tt.Fatal(\"bound census scanned zero production files; the scanner is broken, not the package\")\n196|\t}\n197|\treturn ids\n198|}\n199|\n200|// boundSitesInSyntax derives the bound site identities of one\n201|// parsed production file and reports every helper indirection.\n202|// Direct helper calls claim file|function|helper|member|ordinal;\n203|// DecodeFindings instantiations claim their member; every len\n204|// comparison in any statement context claims\n205|// file|function|len|rendered|ordinal — including comparisons over\n206|// length variables (idents bound from len(...) or\n207|// stringLength(...)) and comparisons holding a direct\n208|// stringLength(...) call (review rev6). Scopes are FuncDecl\n209|// bodies and package-level var initializers under their variable\n210|// name; the per-scope ordinal keeps every existing FuncDecl row\n211|// identical. A use of a helper name that is neither a direct\n212|// call nor one of the six function definitions is an indirection\n213|// violation.\n214|func boundSitesInSyntax(syntax *ast.File, name string) (sites []string, violations []string) {\n215|\tfor _, declaration := range syntax.Decls {\n216|\t\tswitch declaration := declaration.(type) {\n217|\t\tcase *ast.FuncDecl:\n218|\t\t\tif declaration.Body == nil {\n219|\t\t\t\tcontinue\n220|\t\t\t}\n221|\t\t\tsites = append(sites, boundSitesInScope(declaration.Body, name, declaration.Name.Name)...)\n222|\t\tcase *ast.GenDecl:\n223|\t\t\tif declaration.Tok != token.VAR {\n224|\t\t\t\tcontinue\n225|\t\t\t}\n226|\t\t\tfor _, specification := range declaration.Specs {\n227|\t\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n228|\t\t\t\tif !ok {\n229|\t\t\t\t\tcontinue\n230|\t\t\t\t}\n231|\t\t\t\tfor _, ident := range value.Names {\n232|\t\t\t\t\tfor _, expr := range value.Values {\n233|\t\t\t\t\t\tsites = append(sites, boundSitesInScope(expr, name, ident.Name)...)\n234|\t\t\t\t\t}\n235|\t\t\t\t}\n236|\t\t\t}\n237|\t\t}\n238|\t}\n239|\tviolations = append(violations, boundHelperIndirections(syntax)...)\n240|\treturn sites, violations\n241|}\n242|\n243|// boundSitesInScope derives the bound site identities of one\n244|// scope body: helper calls and DecodeFindings instantiations by\n245|// member, len comparisons by rendered shape. Length variables\n246|// are collected first over the same body, so a guard written\n247|// through a variable claims the same len site the direct\n248|// spelling would.\n249|func boundSitesInScope(body ast.Node, name, scope string) []string {\n250|\tvar sites []string\n251|\tordinal := map[string]int{}\n252|\tclaim := func(base string) {\n253|\t\tsites = append(sites, base+\"|\"+strconv.Itoa(ordinal[base]))\n254|\t\tordinal[base]++\n255|\t}\n256|\tast.Inspect(body, func(node ast.Node) bool {\n257|\t\tcall, ok := node.(*ast.CallExpr)\n258|\t\tif !ok {\n259|\t\t\treturn true\n260|\t\t}\n261|\t\tident, ok := call.Fun.(*ast.Ident)\n262|\t\tif !ok {\n263|\t\t\treturn true\n264|\t\t}\n265|\t\tswitch {\n266|\t\tcase boundHelpers[ident.Name]:\n267|\t\t\tclaim(name + \"|\" + scope + \"|\" + ident.Name + \"|\" + boundMemberOf(call, ident.Name))\n268|\t\tcase ident.Name == \"DecodeFindings\":\n269|\t\t\tmember := renderBoundExpr(call.Args[0])\n270|\t\t\tif index, ok := call.Args[0].(*ast.IndexExpr); ok {\n271|\t\t\t\tif literal, ok := index.Index.(*ast.BasicLit); ok && literal.Kind == token.STRING {\n272|\t\t\t\t\tmember = literal.Value\n273|\t\t\t\t}\n274|\t\t\t}\n275|\t\t\tclaim(name + \"|\" + scope + \"|DecodeFindings|\" + member)\n276|\t\t}\n277|\t\treturn true\n278|\t})\n279|\tlengthVars := lengthVarsInScope(body)\n280|\tast.Inspect(body, func(node ast.Node) bool {\n281|\t\tcomparison, ok := node.(*ast.BinaryExpr)\n282|\t\tif !ok {\n283|\t\t\treturn true\n284|\t\t}\n285|\t\tswitch comparison.Op {\n286|\t\tcase token.GTR, token.GEQ, token.LSS, token.LEQ, token.EQL, token.NEQ:\n287|\t\tdefault:\n288|\t\t\treturn true\n289|\t\t}\n290|\t\tif !hasLengthCall(comparison) && !mentionsLengthVar(comparison, lengthVars) {\n291|\t\t\treturn true\n292|\t\t}\n293|\t\tclaim(name + \"|\" + scope + \"|len|\" + normalizeBoundNumbers(renderBoundExpr(comparison)))\n294|\t\treturn true\n295|\t})\n296|\treturn sites\n297|}\n298|\n299|// lengthSourceNames are the package's two length measures: byte\n300|// length and the Section 1.6 character measure. A variable bound\n301|// from either is a length variable for the len-guard derivation.\n302|// cap(...) and a direct utf8.RuneCountInString(...) call are not\n303|// sources (shape 10 of the census header): neither is used as a\n304|// bound in production.\n305|var lengthSourceNames = map[string]bool{\"len\": true, \"stringLength\": true}\n306|\n307|// isLengthSourceCall reports whether the expression calls one of\n308|// the length measures.\n309|func isLengthSourceCall(expr ast.Expr) bool {\n310|\tcall, ok := expr.(*ast.CallExpr)\n311|\tif !ok {\n312|\t\treturn false\n313|\t}\n314|\tident, ok := call.Fun.(*ast.Ident)\n315|\treturn ok && lengthSourceNames[ident.Name]\n316|}\n317|\n318|// numericConversions are the builtin conversions a length may be\n319|// wrapped in at the binding (`n := uint64(len(v))`) without\n320|// stopping being a length.\n321|var numericConversions = map[string]bool{\n322|\t\"int\": true, \"int8\": true, \"int16\": true, \"int32\": true, \"int64\": true,\n323|\t\"uint\": true, \"uint8\": true, \"uint16\": true, \"uint32\": true, \"uint64\": true,\n324|\t\"float32\": true, \"float64\": true, \"byte\": true, \"rune\": true, \"uintptr\": true,\n325|}\n326|\n327|// lengthBoundValue reports whether the right-hand side binds a\n328|// length: a length-source call, possibly through parentheses or\n329|// one builtin numeric conversion. Anything else — a slice built\n330|// with a len capacity (`values := make([]T, 0, len(x))`), a\n331|// length combined arithmetically before binding, a decoded\n332|// value — binds no length variable, so element comparisons over\n333|// such names never claim a len site.\n334|func lengthBoundValue(rhs ast.Expr) bool {\n335|\tfor {\n336|\t\tparen, ok := rhs.(*ast.ParenExpr)\n337|\t\tif !ok {\n338|\t\t\tbreak\n339|\t\t}\n340|\t\trhs = paren.X\n341|\t}\n342|\tif isLengthSourceCall(rhs) {\n343|\t\treturn true\n344|\t}\n345|\tcall, ok := rhs.(*ast.CallExpr)\n346|\tif !ok || len(call.Args) != 1 {\n347|\t\treturn false\n348|\t}\n349|\tident, ok := call.Fun.(*ast.Ident)\n350|\treturn ok && numericConversions[ident.Name] && isLengthSourceCall(call.Args[0])\n351|}\n352|\n353|// hasLengthCall reports whether the subtree calls a length\n354|// measure: len(...) or stringLength(...).\n355|func hasLengthCall(node ast.Node) bool {\n356|\tfound := false\n357|\tast.Inspect(node, func(inner ast.Node) bool {\n358|\t\tif expr, ok := inner.(ast.Expr); ok && isLengthSourceCall(expr) {\n359|\t\t\tfound = true\n360|\t\t\treturn false\n361|\t\t}\n362|\t\treturn true\n363|\t})\n364|\treturn found\n365|}\n366|\n367|// lengthVarsInScope collects the idents bound from a length\n368|// measure anywhere in one scope body: `n := len(v)`, `n =\n369|// len(v)`, and `var n = len(v)` (and the same through\n370|// stringLength). Only a direct binding counts (see\n371|// lengthBoundValue): the rule is deliberately scope-wide and\n372|// sticky — a variable bound from a length stays a length\n373|// variable even if later reassigned, and shadowing is not\n374|// tracked. That can only over-derive — a repurposed length name\n375|// claims a site that needs a row — never silently miss the\n376|// review-rev6 plant shape.\n377|func lengthVarsInScope(body ast.Node) map[string]bool {\n378|\tvars := map[string]bool{}\n379|\tbindIdents := func(names []*ast.Ident, values []ast.Expr) {\n380|\t\tfor index, ident := range names {\n381|\t\t\tif ident == nil || ident.Name == \"_\" {\n382|\t\t\t\tcontinue\n383|\t\t\t}\n384|\t\t\tvar rhs ast.Expr\n385|\t\t\tswitch {\n386|\t\t\tcase len(values) == 1:\n387|\t\t\t\trhs = values[0]\n388|\t\t\tcase index < len(values):\n389|\t\t\t\trhs = values[index]\n390|\t\t\t}\n391|\t\t\tif rhs != nil && lengthBoundValue(rhs) {\n392|\t\t\t\tvars[ident.Name] = true\n393|\t\t\t}\n394|\t\t}\n395|\t}\n396|\tast.Inspect(body, func(node ast.Node) bool {\n397|\t\tswitch node := node.(type) {\n398|\t\tcase *ast.AssignStmt:\n399|\t\t\tnames := make([]*ast.Ident, len(node.Lhs))\n400|\t\t\tfor index, lhs := range node.Lhs {\n401|\t\t\t\t// A non-ident target (a selector, an index)\n402|\t\t\t\t// holds no variable; its paired value is\n403|\t\t\t\t// simply unattributed.\n404|\t\t\t\tident, _ := lhs.(*ast.Ident)\n405|\t\t\t\tnames[index] = ident\n406|\t\t\t}\n407|\t\t\tbindIdents(names, node.Rhs)\n408|\t\tcase *ast.ValueSpec:\n409|\t\t\tbindIdents(node.Names, node.Values)\n410|\t\t}\n411|\t\treturn true\n412|\t})\n413|\treturn vars\n414|}\n415|\n416|// mentionsLengthVar reports whether the subtree reads one of the\n417|// collected length variables.\n418|func mentionsLengthVar(node ast.Node, vars map[string]bool) bool {\n419|\tfound := false\n420|\tast.Inspect(node, func(inner ast.Node) bool {\n421|\t\tif ident, ok := inner.(*ast.Ident); ok && vars[ident.Name] {\n422|\t\t\tfound = true\n423|\t\t\treturn false\n424|\t\t}\n425|\t\treturn true\n426|\t})\n427|\treturn found\n428|}\n429|\n430|// boundHelperIndirections reports every func-value indirection\n431|// of the six bound helpers in one parsed file: any use of a\n432|// helper name that is neither a direct call (the identifier is\n433|// the Fun of its enclosing call) nor one of the six function\n434|// definitions. The rule is positional, so it covers var and :=\n435|// bindings at package and function scope, plain assignments,\n436|// arguments, and return values uniformly — the same shape as the\n437|// constructor census indirection check it is ported from.\n438|func boundHelperIndirections(syntax *ast.File) []string {\n439|\tdefinitions := map[*ast.Ident]bool{}\n440|\tfor _, declaration := range syntax.Decls {\n441|\t\tfunction, ok := declaration.(*ast.FuncDecl)\n442|\t\tif !ok || !boundHelpers[function.Name.Name] {\n443|\t\t\tcontinue\n444|\t\t}\n445|\t\tdefinitions[function.Name] = true\n446|\t}\n447|\tvar violations []string\n448|\tvar stack []ast.Node\n449|\tast.Inspect(syntax, func(node ast.Node) bool {\n(more lines below)"}}}
