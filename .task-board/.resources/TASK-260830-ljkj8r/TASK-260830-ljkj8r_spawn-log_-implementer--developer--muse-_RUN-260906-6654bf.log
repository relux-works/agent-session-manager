{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c495","stream":{"kind":"session","id":"01a07573-a73b-7be0-abe2-6029bca74ffd"},"sequence":165,"recorded_at":1780531400000325,"record_type":"event","durability":"durable","causation_id":"65c281d8-14aa-4def-b705-62e70b4fce66","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"65c281d8-14aa-4def-b705-62e70b4fce66","run_stream":{"kind":"run","id":"65c281d8-14aa-4def-b705-62e70b4fce66"},"call_id":"call_01a0757405e27360a4629d9ddbb5947d","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/dirnode/query.go`.\n1|package dirnode\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"regexp\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|)\n9|\n10|// This file validates the Section 10.8.5 Session Directory Query:\n11|// the closed request envelope, the caller context shape, the\n12|// seventeen-operation registry with its name-matched parameter\n13|// union, the field/preset projection rules, the read/mutation flag\n14|// rules, and the cursor binding.\n15|//\n16|// The parser rejects the whole batch before execution on unknown\n17|// syntax, operation, parameter, field, preset, filter, sort key, or\n18|// bound: every check below runs before any operation is admitted,\n19|// and DecodeQuery returns either a fully validated batch or one\n20|// refusal. CallerContext is shape-checked here and authenticated\n21|// server-side by the caller; it is never accepted from an\n22|// unverified body alone.\n23|\n24|const (\n25|\t// QuerySchema is the exact schema member a directory query\n26|\t// carries.\n27|\tQuerySchema = \"urn:ax:schema:session-directory-query\"\n28|\t// QuerySchemaVersion is the only query schema_version this\n29|\t// host accepts.\n30|\tQuerySchemaVersion = \"1.0.0\"\n31|)\n32|\n33|// queryMembers is the exact Session Directory Query member set.\n34|var queryMembers = map[string]bool{\n35|\t\"schema\":         true,\n36|\t\"schema_version\": true,\n37|\t\"query_id\":       true,\n38|\t\"operations\":     true,\n39|\t\"caller\":         true,\n40|\t\"extensions\":     true,\n41|}\n42|\n43|// queryRequired lists queryMembers in a fixed order.\n44|var queryRequired = []string{\n45|\t\"schema\",\n46|\t\"schema_version\",\n47|\t\"query_id\",\n48|\t\"operations\",\n49|\t\"caller\",\n50|\t\"extensions\",\n51|}\n52|\n53|// callerMembers is the exact CallerContext member set.\n54|var callerMembers = map[string]bool{\n55|\t\"caller_id\":                true,\n56|\t\"authentication_subject\":   true,\n57|\t\"origin_host_id\":           true,\n58|\t\"interaction\":              true,\n59|\t\"scopes\":                   true,\n60|\t\"disclosure_policy_digest\": true,\n61|\t\"extensions\":               true,\n62|}\n63|\n64|// callerRequired lists callerMembers in a fixed order.\n65|var callerRequired = []string{\n66|\t\"caller_id\",\n67|\t\"authentication_subject\",\n68|\t\"origin_host_id\",\n69|\t\"interaction\",\n70|\t\"scopes\",\n71|\t\"disclosure_policy_digest\",\n72|\t\"extensions\",\n73|}\n74|\n75|// operationMembers is the exact QueryOperation member set.\n76|var operationMembers = map[string]bool{\n77|\t\"operation_index\":    true,\n78|\t\"name\":               true,\n79|\t\"parameters\":         true,\n80|\t\"fields\":             true,\n81|\t\"preset\":             true,\n82|\t\"skip\":               true,\n83|\t\"take\":               true,\n84|\t\"sort\":               true,\n85|\t\"dry_run\":            true,\n86|\t\"confirm\":            true,\n87|\t\"expectation_digest\": true,\n88|\t\"idempotency_key\":    true,\n89|\t\"extensions\":         true,\n90|}\n91|\n92|// operationRequired lists operationMembers in a fixed order.\n93|var operationRequired = []string{\n94|\t\"operation_index\",\n95|\t\"name\",\n96|\t\"parameters\",\n97|\t\"fields\",\n98|\t\"preset\",\n99|\t\"skip\",\n100|\t\"take\",\n101|\t\"sort\",\n102|\t\"dry_run\",\n103|\t\"confirm\",\n104|\t\"expectation_digest\",\n105|\t\"idempotency_key\",\n106|\t\"extensions\",\n107|}\n108|\n109|// filterMembers is the exact DirectoryFilters member set.\n110|var filterMembers = map[string]bool{\n111|\t\"kinds\":             true,\n112|\t\"lineage_anchors\":   true,\n113|\t\"provider_ids\":      true,\n114|\t\"host_ids\":          true,\n115|\t\"workspace_ids\":     true,\n116|\t\"states\":            true,\n117|\t\"management_states\": true,\n118|\t\"reachability\":      true,\n119|\t\"freshness\":         true,\n120|\t\"warnings\":          true,\n121|\t\"updated_before\":    true,\n122|\t\"updated_after\":     true,\n123|\t\"extensions\":        true,\n124|}\n125|\n126|// filterRequired lists filterMembers in a fixed order.\n127|var filterRequired = []string{\n128|\t\"kinds\",\n129|\t\"lineage_anchors\",\n130|\t\"provider_ids\",\n131|\t\"host_ids\",\n132|\t\"workspace_ids\",\n133|\t\"states\",\n134|\t\"management_states\",\n135|\t\"reachability\",\n136|\t\"freshness\",\n137|\t\"warnings\",\n138|\t\"updated_before\",\n139|\t\"updated_after\",\n140|\t\"extensions\",\n141|}\n142|\n143|// sortMembers is the exact QuerySort member set.\n144|var sortMembers = map[string]bool{\n145|\t\"field\":      true,\n146|\t\"direction\":  true,\n147|\t\"extensions\": true,\n148|}\n149|\n150|// sortRequired lists sortMembers in a fixed order.\n151|var sortRequired = []string{\n152|\t\"field\",\n153|\t\"direction\",\n154|\t\"extensions\",\n155|}\n156|\n157|// readOperations is the closed read registry of Section 10.8.5 in\n158|// the section's listed order.\n159|var readOperations = []string{\n160|\t\"schema\",\n161|\t\"sessions\",\n162|\t\"session\",\n163|\t\"lineage\",\n164|\t\"hosts\",\n165|\t\"environments\",\n166|\t\"jobs\",\n167|\t\"plans\",\n168|\t\"count\",\n169|\t\"distinct\",\n170|\t\"directory_summary\",\n171|}\n172|\n173|// mutationOperations is the closed mutation registry in the\n174|// section's listed order.\n175|var mutationOperations = []string{\n176|\t\"set_title\",\n177|\t\"set_tags\",\n178|\t\"set_pin\",\n179|\t\"enrich\",\n180|\t\"plan_continue\",\n181|\t\"execute_plan\",\n182|}\n183|\n184|// queryOperationKind names which half of the registry an operation\n185|// belongs to. Reads and mutations carry different flag,\n186|// projection, and pagination rules.\n187|type queryOperationKind string\n188|\n189|const (\n190|\tqueryKindRead     queryOperationKind = \"read\"\n191|\tqueryKindMutation queryOperationKind = \"mutation\"\n192|)\n193|\n194|// queryOperationKindOf reports the registry half a name belongs to.\n195|// Both registries are table loops so the census derives them: an\n196|// inline chain would hide a widened vocabulary from the inventory.\n197|func queryOperationKindOf(name string) (queryOperationKind, bool) {\n198|\tfor _, allowed := range readOperations {\n199|\t\tif name == allowed {\n200|\t\t\treturn queryKindRead, true\n201|\t\t}\n202|\t}\n203|\tfor _, allowed := range mutationOperations {\n204|\t\tif name == allowed {\n205|\t\t\treturn queryKindMutation, true\n206|\t\t}\n207|\t}\n208|\treturn \"\", false\n209|}\n210|\n211|// listOperations names the read operations that may use nonzero\n212|// skip or take other than 1: the entity-listing reads. The\n213|// singular, schema, and aggregate reads require skip=0 and take=1.\n214|// The section states the rule without enumerating the set, so the\n215|// choice is recorded here: schema, session, count, distinct, and\n216|// directory_summary address one object, one registry, or one number\n217|// and have no list to page. A different reading would move lineage\n218|// or distinct across the line; the refusal detail names the\n219|// operation either way.\n220|var listOperations = []string{\n221|\t\"sessions\",\n222|\t\"lineage\",\n223|\t\"hosts\",\n224|\t\"environments\",\n225|\t\"jobs\",\n226|\t\"plans\",\n227|}\n228|\n229|// isListOperation reports whether the read operation pages a list.\n230|func isListOperation(name string) bool {\n231|\tfor _, allowed := range listOperations {\n232|\t\tif name == allowed {\n233|\t\t\treturn true\n234|\t\t}\n235|\t}\n236|\treturn false\n237|}\n238|\n239|// annotationMutations names the mutations that require an\n240|// expectation digest and idempotency key when confirmed.\n241|var annotationMutations = []string{\n242|\t\"set_title\",\n243|\t\"set_tags\",\n244|\t\"set_pin\",\n245|}\n246|\n247|// isAnnotationMutation reports whether the mutation is an\n248|// annotation mutation.\n249|func isAnnotationMutation(name string) bool {\n250|\tfor _, allowed := range annotationMutations {\n251|\t\tif name == allowed {\n252|\t\t\treturn true\n253|\t\t}\n254|\t}\n255|\treturn false\n256|}\n257|\n258|// queryParameterMembers maps each operation to its exact\n259|// parameters member set in Section 10.8.5 table order. The schema\n260|// and directory_summary bodies carry extensions only: there is no\n261|// untyped parameter bag.\n262|var queryParameterMembers = map[string][]string{\n263|\t\"schema\":            {\"extensions\"},\n264|\t\"directory_summary\": {\"extensions\"},\n265|\t\"sessions\":          {\"filters\", \"extensions\"},\n266|\t\"count\":             {\"filters\", \"extensions\"},\n267|\t\"session\":           {\"subject_kind\", \"subject_id\", \"extensions\"},\n268|\t\"lineage\":           {\"anchor_id\", \"include_suggestions\", \"extensions\"},\n269|\t\"hosts\":             {\"host_ids\", \"reachable\", \"extensions\"},\n270|\t\"environments\":      {\"host_ids\", \"environment_ids\", \"authentication_status\", \"extensions\"},\n271|\t\"jobs\":              {\"job_ids\", \"profile_ids\", \"states\", \"extensions\"},\n272|\t\"plans\":             {\"plan_ids\", \"operation_ids\", \"include_expired\", \"extensions\"},\n273|\t\"distinct\":          {\"field\", \"filters\", \"extensions\"},\n274|\t\"set_title\":         {\"subject_kind\", \"subject_id\", \"title\", \"supersedes_annotation_ids\", \"extensions\"},\n275|\t\"set_tags\":          {\"subject_kind\", \"subject_id\", \"tags\", \"supersedes_annotation_ids\", \"extensions\"},\n276|\t\"set_pin\":           {\"subject_kind\", \"subject_id\", \"value\", \"supersedes_annotation_ids\", \"extensions\"},\n277|\t\"enrich\":            {\"subject_kind\", \"subject_id\", \"profile_id\", \"kinds\", \"expected_head_digest\", \"extensions\"},\n278|\t\"plan_continue\":     {\"subject_kind\", \"subject_id\", \"source_instance_id\", \"to_host_id\", \"to_installation_id\", \"intent\", \"workspace_policy\", \"source_after_success\", \"extensions\"},\n279|\t\"execute_plan\":      {\"plan_id\", \"operation_id\", \"confirmations\", \"extensions\"},\n280|}\n281|\n282|// queryFields is the closed directory-field registry: the\n283|// twenty-four projection fields plus the three explicitly lazy\n284|// ones. Fields and presets apply only to the projecting reads;\n285|// other operations require both null.\n286|var queryFields = []string{\n287|\t\"id\",\n288|\t\"kind\",\n289|\t\"lineage_anchor\",\n290|\t\"management_state\",\n291|\t\"display_title\",\n292|\t\"title_source\",\n293|\t\"provider\",\n294|\t\"host\",\n295|\t\"workspace\",\n296|\t\"state\",\n297|\t\"owner\",\n298|\t\"local_role\",\n299|\t\"updated_at\",\n300|\t\"summary\",\n301|\t\"recent_activity\",\n302|\t\"last_user_intent\",\n303|\t\"open_loops\",\n304|\t\"annotation_freshness\",\n305|\t\"inventory_freshness\",\n306|\t\"reachability\",\n307|\t\"branch_count\",\n308|\t\"clone_count\",\n309|\t\"warnings\",\n310|\t\"available_intents\",\n311|\t\"lineage_graph\",\n312|\t\"live_runtime\",\n313|\t\"preview\",\n314|}\n315|\n316|// validQueryField reports whether the field is a registry member.\n317|func validQueryField(field string) bool {\n318|\tfor _, allowed := range queryFields {\n319|\t\tif field == allowed {\n320|\t\t\treturn true\n321|\t\t}\n322|\t}\n323|\treturn false\n324|}\n325|\n326|// queryPresets is the closed preset registry.\n327|var queryPresets = []string{\n328|\t\"minimal\",\n329|\t\"overview\",\n330|\t\"activity\",\n331|\t\"routing\",\n332|\t\"full\",\n333|}\n334|\n335|// validQueryPreset reports whether the preset is a registry member.\n336|func validQueryPreset(preset string) bool {\n337|\tfor _, allowed := range queryPresets {\n338|\t\tif preset == allowed {\n339|\t\t\treturn true\n340|\t\t}\n341|\t}\n342|\treturn false\n343|}\n344|\n345|// querySortFields is the closed QuerySort field registry.\n346|var querySortFields = []string{\n347|\t\"display_title\",\n348|\t\"provider\",\n349|\t\"host\",\n350|\t\"workspace\",\n351|\t\"state\",\n352|\t\"updated_at\",\n353|\t\"annotation_freshness\",\n354|\t\"inventory_freshness\",\n355|\t\"reachability\",\n356|\t\"stable_id\",\n357|}\n358|\n359|// queryScopes is the closed CallerContext scope registry.\n360|var queryScopes = []string{\n361|\t\"directory.read\",\n362|\t\"directory.preview\",\n363|\t\"directory.mutate\",\n364|\t\"directory.execute\",\n365|\t\"directory.admin\",\n366|}\n367|\n368|// providerIDPattern is the provider-id grammar:\n369|// [a-z][a-z0-9-]{0,31}.\n370|var providerIDPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,31}$`)\n371|\n372|// CallerContext is one validated query caller: the shape-checked\n373|// identity the caller authenticates server-side.\n374|type CallerContext struct {\n375|\tCallerID         string\n376|\tAuthSubject      string\n377|\tOriginHostID     string\n378|\tInteraction      string\n379|\tScopes           []string\n380|\tDisclosurePolicy string\n381|}\n382|\n383|// QueryOperation is one validated batch operation: its position,\n384|// registry name, and half.\n385|type QueryOperation struct {\n386|\tIndex int\n387|\tName  string\n388|\tKind  queryOperationKind\n389|}\n390|\n391|// Query is one validated Session Directory Query: the batch\n392|// identifier, the position-indexed operations, and the caller.\n393|type Query struct {\n394|\tQueryID    string\n395|\tOperations []QueryOperation\n396|\tCaller     CallerContext\n397|}\n398|\n399|// DecodeQuery validates one Session Directory Query body as the\n400|// closed Section 10.8.5 contract and rejects the whole batch\n401|// before execution on the first defect: unknown syntax, operation,\n402|// parameter, field, preset, filter, sort key, or bound. For a\n403|// batch of N operations each operation_index must equal its\n404|// zero-based array position; duplicate, sparse, reordered, or\n405|// position-mismatched indexes invalidate the whole query.\n406|func DecodeQuery(body []byte) (Query, error) {\n407|\tmembers, fault := decodeStrictObject(bytesTrimSpace(body))\n408|\tif fault != nil {\n409|\t\tfailure, err := failQuery(\"directory query \"+fault.detail, fault.member)\n410|\t\tif err != nil {\n411|\t\t\treturn Query{}, err\n412|\t\t}\n413|\t\treturn Query{}, failure\n414|\t}\n415|\tif name, unknown := unknownMember(members, queryMembers); unknown {\n416|\t\tfailure, err := failQuery(\"directory query carries unknown member\", name)\n417|\t\tif err != nil {\n418|\t\t\treturn Query{}, err\n419|\t\t}\n420|\t\treturn Query{}, failure\n421|\t}\n422|\tif name, missing := missingMember(members, queryRequired); missing {\n423|\t\tfailure, err := failQuery(\"directory query misses a required member\", name)\n424|\t\tif err != nil {\n425|\t\t\treturn Query{}, err\n426|\t\t}\n427|\t\treturn Query{}, failure\n428|\t}\n429|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != QuerySchema {\n430|\t\tfailure, err := failQuery(\"directory query schema is not the session directory query\", \"schema\")\n431|\t\tif err != nil {\n432|\t\t\treturn Query{}, err\n433|\t\t}\n434|\t\treturn Query{}, failure\n435|\t}\n436|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != QuerySchemaVersion {\n437|\t\tfailure, err := failQuery(\"directory query version is not 1.0.0\", \"schema_version\")\n438|\t\tif err != nil {\n439|\t\t\treturn Query{}, err\n440|\t\t}\n441|\t\treturn Query{}, failure\n442|\t}\n443|\tqueryID, ok := checkUUIDv7(members[\"query_id\"])\n444|\tif !ok {\n445|\t\tfailure, err := failQuery(\"directory query identifier is not a UUIDv7\", \"query_id\")\n446|\t\tif err != nil {\n447|\t\t\treturn Query{}, err\n448|\t\t}\n449|\t\treturn Query{}, failure\n450|\t}\n451|\telements, ok := decodeArray(members[\"operations\"])\n452|\tif !ok || len(elements) < 1 || len(elements) > 64 {\n453|\t\tfailure, err := failQuery(\"directory query operations are not QueryOperation[1..64]\", \"operations\")\n454|\t\tif err != nil {\n455|\t\t\treturn Query{}, err\n456|\t\t}\n457|\t\treturn Query{}, failure\n458|\t}\n459|\tcaller, ok := checkCaller(members[\"caller\"])\n460|\tif !ok {\n461|\t\tfailure, err := failQuery(\"directory query caller is not a closed CallerContext\", \"caller\")\n462|\t\tif err != nil {\n463|\t\t\treturn Query{}, err\n464|\t\t}\n465|\t\treturn Query{}, failure\n466|\t}\n467|\tif !checkExtensions(members[\"extensions\"]) {\n468|\t\tfailure, err := failQuery(\"directory query extensions are not reverse-DNS keyed\", \"extensions\")\n469|\t\tif err != nil {\n470|\t\t\treturn Query{}, err\n471|\t\t}\n472|\t\treturn Query{}, failure\n473|\t}\n474|\toperations := make([]QueryOperation, 0, len(elements))\n475|\tfor position, element := range elements {\n476|\t\toperation, ok := checkQueryOperation(element, position)\n477|\t\tif !ok {\n478|\t\t\tfailure, err := failQuery(\"directory query operation is not a closed QueryOperation\", \"operations\")\n479|\t\t\tif err != nil {\n480|\t\t\t\treturn Query{}, err\n481|\t\t\t}\n482|\t\t\treturn Query{}, failure\n483|\t\t}\n484|\t\toperations = append(operations, operation)\n485|\t}\n486|\treturn Query{QueryID: queryID.String(), Operations: operations, Caller: caller}, nil\n487|}\n488|\n489|// checkCaller validates one CallerContext object.\n490|func checkCaller(raw json.RawMessage) (CallerContext, bool) {\n491|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n492|\tif fault != nil {\n493|\t\treturn CallerContext{}, false\n494|\t}\n495|\tif name, unknown := unknownMember(members, callerMembers); unknown {\n496|\t\t_ = name\n497|\t\treturn CallerContext{}, false\n498|\t}\n499|\tif name, missing := missingMember(members, callerRequired); missing {\n500|\t\t_ = name\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c497","stream":{"kind":"session","id":"01a07573-a73b-7be0-abe2-6029bca74ffd"},"sequence":166,"recorded_at":1780531400000327,"record_type":"event","durability":"durable","causation_id":"65c281d8-14aa-4def-b705-62e70b4fce66","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"65c281d8-14aa-4def-b705-62e70b4fce66","run_stream":{"kind":"run","id":"65c281d8-14aa-4def-b705-62e70b4fce66"},"call_id":"call_01a0757406ae7c309f5eb8df264a85a4","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/dirnode/manifest.go`.\n1|package dirnode\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"sort\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// This file validates the Section 7.9 Directory Node Manifest\n13|// 1.0.0: the closed seventeen-member object a manifest operation\n14|// returns as its success body under either major. The manifest\n15|// declares possible surfaces, not runtime availability; a status of\n16|// conditional, unavailable, or unknown is never reported as\n17|// available, and unknown is never rewritten as unsupported.\n18|\n19|// capabilityOrder is the exact eight-name directory-capability\n20|// registry Section 7.9 shows. The manifest capabilities map carries\n21|// exactly these keys; a ninth key advertises a surface the contract\n22|// never defined, and a missing key hides one it did.\n23|var capabilityOrder = []string{\n24|\t\"directory_discovery\",\n25|\t\"directory_incremental_scan\",\n26|\t\"directory_head_digest\",\n27|\t\"directory_tail_preview\",\n28|\t\"native_title_read\",\n29|\t\"native_runtime_observation\",\n30|\t\"existing_session_adoption\",\n31|\t\"native_resume\",\n32|}\n33|\n34|// Capabilities returns the Section 7.9 capability registry in\n35|// order. The result is a copy; the registry cannot be mutated\n36|// through it.\n37|func Capabilities() []string {\n38|\treturn append([]string(nil), capabilityOrder...)\n39|}\n40|\n41|// validCapability reports whether the name is a registry member. It\n42|// is a table loop so the census derives it like every other closed\n43|// vocabulary: an inline comparison chain here would be invisible to\n44|// the census.\n45|func validCapability(name string) bool {\n46|\tfor _, allowed := range capabilityOrder {\n47|\t\tif name == allowed {\n48|\t\t\treturn true\n49|\t\t}\n50|\t}\n51|\treturn false\n52|}\n53|\n54|// capabilityStatuses is the closed CapabilityResult status\n55|// vocabulary. Section 8.1 labels are not aliases: unknown must not\n56|// be rewritten as unsupported, and conditional must not be\n57|// advertised as available.\n58|var capabilityStatuses = []string{\n59|\t\"available\",\n60|\t\"conditional\",\n61|\t\"unavailable\",\n62|\t\"unknown\",\n63|}\n64|\n65|// validCapabilityStatus reports whether the status is a registry\n66|// member.\n67|func validCapabilityStatus(status string) bool {\n68|\tfor _, allowed := range capabilityStatuses {\n69|\t\tif status == allowed {\n70|\t\t\treturn true\n71|\t\t}\n72|\t}\n73|\treturn false\n74|}\n75|\n76|// manifestMembers is the exact required member set DecodeManifest\n77|// accepts: the schema envelope, node identity, the three façade\n78|// executable/module bindings, the supported versions, the operation\n79|// and schema registries, the tuple registry binding, the eight\n80|// capabilities, the policy bindings, the limits, and extensions.\n81|var manifestMembers = map[string]bool{\n82|\t\"schema\":                          true,\n83|\t\"schema_version\":                  true,\n84|\t\"node_id\":                         true,\n85|\t\"node_version\":                    true,\n86|\t\"host_id\":                         true,\n87|\t\"executable_sha256\":               true,\n88|\t\"provider_manifest_digest\":        true,\n89|\t\"session_adapter_manifest_digest\": true,\n90|\t\"supported_protocol_versions\":     true,\n91|\t\"operations\":                      true,\n92|\t\"schemas\":                         true,\n93|\t\"environment_tuple_registry_id\":   true,\n94|\t\"capabilities\":                    true,\n95|\t\"redaction_policy_ids\":            true,\n96|\t\"enrichment_profile_ids\":          true,\n97|\t\"limits\":                          true,\n98|\t\"extensions\":                      true,\n99|}\n100|\n101|// manifestRequired lists manifestMembers in a fixed order so a body\n102|// missing several members always names the same one.\n103|var manifestRequired = []string{\n104|\t\"schema\",\n105|\t\"schema_version\",\n106|\t\"node_id\",\n107|\t\"node_version\",\n108|\t\"host_id\",\n109|\t\"executable_sha256\",\n110|\t\"provider_manifest_digest\",\n111|\t\"session_adapter_manifest_digest\",\n112|\t\"supported_protocol_versions\",\n113|\t\"operations\",\n114|\t\"schemas\",\n115|\t\"environment_tuple_registry_id\",\n116|\t\"capabilities\",\n117|\t\"redaction_policy_ids\",\n118|\t\"enrichment_profile_ids\",\n119|\t\"limits\",\n120|\t\"extensions\",\n121|}\n122|\n123|// capabilityMembers is the exact CapabilityResult member set.\n124|var capabilityMembers = map[string]bool{\n125|\t\"status\":       true,\n126|\t\"reason_code\":  true,\n127|\t\"evidence_ids\": true,\n128|\t\"observed_at\":  true,\n129|\t\"extensions\":   true,\n130|}\n131|\n132|// capabilityRequired lists capabilityMembers in a fixed order.\n133|var capabilityRequired = []string{\n134|\t\"status\",\n135|\t\"reason_code\",\n136|\t\"evidence_ids\",\n137|\t\"observed_at\",\n138|\t\"extensions\",\n139|}\n140|\n141|// limitsMembers is the exact DirectoryNodeLimits member set.\n142|var limitsMembers = map[string]bool{\n143|\t\"max_frame_bytes\":       true,\n144|\t\"max_scan_instances\":    true,\n145|\t\"max_inventory_take\":    true,\n146|\t\"max_excerpt_count\":     true,\n147|\t\"max_excerpt_bytes\":     true,\n148|\t\"max_enrichment_events\": true,\n149|\t\"max_enrichment_bytes\":  true,\n150|\t\"extensions\":            true,\n151|}\n152|\n153|// limitsRequired lists limitsMembers in a fixed order.\n154|var limitsRequired = []string{\n155|\t\"max_frame_bytes\",\n156|\t\"max_scan_instances\",\n157|\t\"max_inventory_take\",\n158|\t\"max_excerpt_count\",\n159|\t\"max_excerpt_bytes\",\n160|\t\"max_enrichment_events\",\n161|\t\"max_enrichment_bytes\",\n162|\t\"extensions\",\n163|}\n164|\n165|// assertionMembers is the exact ContractAssertion member set.\n166|var assertionMembers = map[string]bool{\n167|\t\"contract_id\":   true,\n168|\t\"exact_version\": true,\n169|\t\"extensions\":    true,\n170|}\n171|\n172|// assertionRequired lists assertionMembers in a fixed order.\n173|var assertionRequired = []string{\n174|\t\"contract_id\",\n175|\t\"exact_version\",\n176|\t\"extensions\",\n177|}\n178|\n179|// Capability is one validated CapabilityResult: the status, the\n180|// reason coherence (available carries a null reason; every other\n181|// status requires one), the evidence digests, and the observation\n182|// time.\n183|type Capability struct {\n184|\tStatus     string\n185|\tReasonCode string\n186|\tHasReason  bool\n187|\tEvidence   []string\n188|\tObservedAt string\n189|}\n190|\n191|// Limits is one validated DirectoryNodeLimits.\n192|type Limits struct {\n193|\tMaxFrameBytes      uint64\n194|\tMaxScanInstances   uint64\n195|\tMaxInventoryTake   uint64\n196|\tMaxExcerptCount    uint64\n197|\tMaxExcerptBytes    uint64\n198|\tMaxEnrichmentEvent uint64\n199|\tMaxEnrichmentBytes uint64\n200|}\n201|\n202|// ContractAssertion is one validated schemas entry: the asserted\n203|// contract identifier and its exact version.\n204|type ContractAssertion struct {\n205|\tContractID   string\n206|\tExactVersion string\n207|}\n208|\n209|// Manifest is the validated Directory Node Manifest 1.0.0: the node\n210|// identity, the façade bindings, the ordered registries, the\n211|// capability map, and the limits. The canonical body is retained\n212|// for the host-computed digest.\n213|type Manifest struct {\n214|\tNodeID                 string\n215|\tNodeVersion            string\n216|\tHostID                 string\n217|\tExecutableSHA256       string\n218|\tProviderManifestDigest string\n219|\tAdapterManifestDigest  string\n220|\tSupportedVersions      []string\n221|\tOperations             []string\n222|\tSchemas                []ContractAssertion\n223|\tTupleRegistryID        string\n224|\tCapabilities           map[string]Capability\n225|\tRedactionPolicyIDs     []string\n226|\tEnrichmentProfileIDs   []string\n227|\tLimits                 Limits\n228|\tcanonical              []byte\n229|}\n230|\n231|// Canonical returns the JCS bytes the digest was computed over.\n232|func (manifest Manifest) Canonical() []byte {\n233|\treturn append([]byte(nil), manifest.canonical...)\n234|}\n235|\n236|// Supports reports whether the manifest's\n237|// supported_protocol_versions contains the exact selected version.\n238|// Membership is exact: a manifest that names only 1.0.0 does not\n239|// support a 2.0.0 attempt, and no coercion across majors is\n240|// performed here or anywhere else.\n241|func (manifest Manifest) Supports(version string) bool {\n242|\tfor _, supported := range manifest.SupportedVersions {\n243|\t\tif supported == version {\n244|\t\t\treturn true\n245|\t\t}\n246|\t}\n247|\treturn false\n248|}\n249|\n250|// DecodeManifest validates one manifest-operation success body as\n251|// the closed Section 7.9 Directory Node Manifest. A manifest whose\n252|// operations are not the complete sorted eleven-name registry, or\n253|// whose capabilities are not the exact eight-name map, advertises a\n254|// surface the host cannot invoke or hides one it must, so both are\n255|// refused outright. The three façade bindings are checked for shape\n256|// here and for agreement with observed facts in\n257|// CheckManifestBindings; a contradiction there is an integrity\n258|// failure.\n259|func DecodeManifest(body []byte) (Manifest, error) {\n260|\tmembers, fault := decodeStrictObject(body)\n261|\tif fault != nil {\n262|\t\tfailure, err := failViolation(\"node manifest \"+fault.detail, fault.member)\n263|\t\tif err != nil {\n264|\t\t\treturn Manifest{}, err\n265|\t\t}\n266|\t\treturn Manifest{}, failure\n267|\t}\n268|\tif name, unknown := unknownMember(members, manifestMembers); unknown {\n269|\t\tfailure, err := failViolation(\"node manifest carries unknown member\", name)\n270|\t\tif err != nil {\n271|\t\t\treturn Manifest{}, err\n272|\t\t}\n273|\t\treturn Manifest{}, failure\n274|\t}\n275|\tif name, missing := missingMember(members, manifestRequired); missing {\n276|\t\tfailure, err := failViolation(\"node manifest misses a required member\", name)\n277|\t\tif err != nil {\n278|\t\t\treturn Manifest{}, err\n279|\t\t}\n280|\t\treturn Manifest{}, failure\n281|\t}\n282|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != ManifestSchema {\n283|\t\tfailure, err := failViolation(\"node manifest schema is not the directory node manifest\", \"schema\")\n284|\t\tif err != nil {\n285|\t\t\treturn Manifest{}, err\n286|\t\t}\n287|\t\treturn Manifest{}, failure\n288|\t}\n289|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != ManifestSchemaVersion {\n290|\t\tfailure, err := failViolation(\"node manifest version is not 1.0.0\", \"schema_version\")\n291|\t\tif err != nil {\n292|\t\t\treturn Manifest{}, err\n293|\t\t}\n294|\t\treturn Manifest{}, failure\n295|\t}\n296|\tnodeID, ok := checkStringBounds(members[\"node_id\"], 1, 128)\n297|\tif !ok {\n298|\t\tfailure, err := failViolation(\"node manifest node identifier is not a string[1..128]\", \"node_id\")\n299|\t\tif err != nil {\n300|\t\t\treturn Manifest{}, err\n301|\t\t}\n302|\t\treturn Manifest{}, failure\n303|\t}\n304|\tnodeVersion, ok := rawString(members[\"node_version\"])\n305|\tif !ok || !checkSemver(nodeVersion) {\n306|\t\tfailure, err := failViolation(\"node manifest node version is not SemVer\", \"node_version\")\n307|\t\tif err != nil {\n308|\t\t\treturn Manifest{}, err\n309|\t\t}\n310|\t\treturn Manifest{}, failure\n311|\t}\n312|\thostID, ok := checkUUIDv7(members[\"host_id\"])\n313|\tif !ok {\n314|\t\tfailure, err := failViolation(\"node manifest host identifier is not a UUIDv7\", \"host_id\")\n315|\t\tif err != nil {\n316|\t\t\treturn Manifest{}, err\n317|\t\t}\n318|\t\treturn Manifest{}, failure\n319|\t}\n320|\texecutable, ok := checkDigest(members[\"executable_sha256\"])\n321|\tif !ok {\n322|\t\tfailure, err := failViolation(\"node manifest executable binding is not a digest\", \"executable_sha256\")\n323|\t\tif err != nil {\n324|\t\t\treturn Manifest{}, err\n325|\t\t}\n326|\t\treturn Manifest{}, failure\n327|\t}\n328|\tproviderDigest, ok := checkDigest(members[\"provider_manifest_digest\"])\n329|\tif !ok {\n330|\t\tfailure, err := failViolation(\"node manifest provider binding is not a digest\", \"provider_manifest_digest\")\n331|\t\tif err != nil {\n332|\t\t\treturn Manifest{}, err\n333|\t\t}\n334|\t\treturn Manifest{}, failure\n335|\t}\n336|\tadapterDigest, ok := checkDigest(members[\"session_adapter_manifest_digest\"])\n337|\tif !ok {\n338|\t\tfailure, err := failViolation(\"node manifest adapter binding is not a digest\", \"session_adapter_manifest_digest\")\n339|\t\tif err != nil {\n340|\t\t\treturn Manifest{}, err\n341|\t\t}\n342|\t\treturn Manifest{}, failure\n343|\t}\n344|\tsupported, ok := checkSupportedVersions(members[\"supported_protocol_versions\"])\n345|\tif !ok {\n346|\t\tfailure, err := failViolation(\"node manifest supported versions are not sorted unique SemVer[1..16]\", \"supported_protocol_versions\")\n347|\t\tif err != nil {\n348|\t\t\treturn Manifest{}, err\n349|\t\t}\n350|\t\treturn Manifest{}, failure\n351|\t}\n352|\toperations, ok := checkManifestOperations(members[\"operations\"])\n353|\tif !ok {\n354|\t\tfailure, err := failViolation(\"node manifest operations are not the complete sorted eleven-name registry\", \"operations\")\n355|\t\tif err != nil {\n356|\t\t\treturn Manifest{}, err\n357|\t\t}\n358|\t\treturn Manifest{}, failure\n359|\t}\n360|\tschemas, ok := checkContractAssertions(members[\"schemas\"])\n361|\tif !ok {\n362|\t\tfailure, err := failViolation(\"node manifest schemas are not sorted unique ContractAssertion[15..64]\", \"schemas\")\n363|\t\tif err != nil {\n364|\t\t\treturn Manifest{}, err\n365|\t\t}\n366|\t\treturn Manifest{}, failure\n367|\t}\n368|\ttupleRegistry, ok := checkDigest(members[\"environment_tuple_registry_id\"])\n369|\tif !ok {\n370|\t\tfailure, err := failViolation(\"node manifest tuple registry binding is not a digest\", \"environment_tuple_registry_id\")\n371|\t\tif err != nil {\n372|\t\t\treturn Manifest{}, err\n373|\t\t}\n374|\t\treturn Manifest{}, failure\n375|\t}\n376|\tcapabilities, ok := checkCapabilities(members[\"capabilities\"])\n377|\tif !ok {\n378|\t\tfailure, err := failViolation(\"node manifest capabilities are not the exact eight-name result map\", \"capabilities\")\n379|\t\tif err != nil {\n380|\t\t\treturn Manifest{}, err\n381|\t\t}\n382|\t\treturn Manifest{}, failure\n383|\t}\n384|\tredaction, ok := checkSortedUniqueDigests(members[\"redaction_policy_ids\"], 1, 64)\n385|\tif !ok {\n386|\t\tfailure, err := failViolation(\"node manifest redaction policies are not sorted unique digest[1..64]\", \"redaction_policy_ids\")\n387|\t\tif err != nil {\n388|\t\t\treturn Manifest{}, err\n389|\t\t}\n390|\t\treturn Manifest{}, failure\n391|\t}\n392|\tenrichment, ok := checkSortedUniqueDigests(members[\"enrichment_profile_ids\"], 0, 256)\n393|\tif !ok {\n394|\t\tfailure, err := failViolation(\"node manifest enrichment profiles are not sorted unique digest[0..256]\", \"enrichment_profile_ids\")\n395|\t\tif err != nil {\n396|\t\t\treturn Manifest{}, err\n397|\t\t}\n398|\t\treturn Manifest{}, failure\n399|\t}\n400|\tlimits, ok := checkLimits(members[\"limits\"])\n401|\tif !ok {\n402|\t\tfailure, err := failViolation(\"node manifest limits are not the closed DirectoryNodeLimits\", \"limits\")\n403|\t\tif err != nil {\n404|\t\t\treturn Manifest{}, err\n405|\t\t}\n406|\t\treturn Manifest{}, failure\n407|\t}\n408|\tif !checkExtensions(members[\"extensions\"]) {\n409|\t\tfailure, err := failViolation(\"node manifest extensions are not reverse-DNS keyed\", \"extensions\")\n410|\t\tif err != nil {\n411|\t\t\treturn Manifest{}, err\n412|\t\t}\n413|\t\treturn Manifest{}, failure\n414|\t}\n415|\tcanonical, err := canonicaljson.Canonicalize(body)\n416|\tif err != nil {\n417|\t\tfailure, faultErr := failViolation(\"node manifest is not canonical JSON\", \"\")\n418|\t\tif faultErr != nil {\n419|\t\t\treturn Manifest{}, faultErr\n420|\t\t}\n421|\t\treturn Manifest{}, failure\n422|\t}\n423|\treturn Manifest{\n424|\t\tNodeID:                 nodeID,\n425|\t\tNodeVersion:            nodeVersion,\n426|\t\tHostID:                 hostID.String(),\n427|\t\tExecutableSHA256:       executable.String(),\n428|\t\tProviderManifestDigest: providerDigest.String(),\n429|\t\tAdapterManifestDigest:  adapterDigest.String(),\n430|\t\tSupportedVersions:      supported,\n431|\t\tOperations:             operations,\n432|\t\tSchemas:                schemas,\n433|\t\tTupleRegistryID:        tupleRegistry.String(),\n434|\t\tCapabilities:           capabilities,\n435|\t\tRedactionPolicyIDs:     digestStrings(redaction),\n436|\t\tEnrichmentProfileIDs:   digestStrings(enrichment),\n437|\t\tLimits:                 limits,\n438|\t\tcanonical:              canonical,\n439|\t}, nil\n440|}\n441|\n442|// checkSupportedVersions reports whether the member is a sorted\n443|// unique SemVer array in the count bound. Ordering is bytewise over\n444|// the version strings, the same rule every sorted-unique check in\n445|// this package applies: no member type gets its own comparison.\n446|func checkSupportedVersions(raw json.RawMessage) ([]string, bool) {\n447|\tversions, ok := checkSortedUniqueStrings(raw, 5, 64, 1, 16)\n448|\tif !ok {\n449|\t\treturn nil, false\n450|\t}\n451|\tfor _, version := range versions {\n452|\t\tif !checkSemver(version) {\n453|\t\t\treturn nil, false\n454|\t\t}\n455|\t}\n456|\treturn versions, true\n457|}\n458|\n459|// checkManifestOperations reports whether the member is exactly the\n460|// eleven-name operation registry in sorted unique order. Sortedness\n461|// is the rule here — the manifest carries the registry sorted, not\n462|// in section table order — so the comparison sorts a copy of the\n463|// table and matches element-wise.\n464|func checkManifestOperations(raw json.RawMessage) ([]string, bool) {\n465|\telements, ok := decodeArray(raw)\n466|\tif !ok || len(elements) != len(operationOrder) {\n467|\t\treturn nil, false\n468|\t}\n469|\twant := Operations()\n470|\tsort.Strings(want)\n471|\toperations := make([]string, 0, len(elements))\n472|\tfor index, element := range elements {\n473|\t\tname, ok := rawString(element)\n474|\t\tif !ok || name != want[index] {\n475|\t\t\treturn nil, false\n476|\t\t}\n477|\t\toperations = append(operations, name)\n478|\t}\n479|\treturn operations, true\n480|}\n481|\n482|// checkContractAssertions reports whether the member is a sorted\n483|// unique ContractAssertion array in the count bound. Uniqueness is\n484|// over the canonical encoding of each entry, so two entries that\n485|// differ only in key order or duplicate members still collide.\n486|func checkContractAssertions(raw json.RawMessage) ([]ContractAssertion, bool) {\n487|\telements, ok := decodeArray(raw)\n488|\tif !ok || len(elements) < 15 || len(elements) > 64 {\n489|\t\treturn nil, false\n490|\t}\n491|\tassertions := make([]ContractAssertion, 0, len(elements))\n492|\tencodings := make([]string, 0, len(elements))\n493|\tfor _, element := range elements {\n494|\t\tmembers, fault := decodeStrictObject(bytesTrimSpace(element))\n495|\t\tif fault != nil {\n496|\t\t\treturn nil, false\n497|\t\t}\n498|\t\tif name, unknown := unknownMember(members, assertionMembers); unknown {\n499|\t\t\t_ = name\n500|\t\t\treturn nil, false\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c499","stream":{"kind":"session","id":"01a07573-a73b-7be0-abe2-6029bca74ffd"},"sequence":167,"recorded_at":1780531400000329,"record_type":"event","durability":"durable","causation_id":"65c281d8-14aa-4def-b705-62e70b4fce66","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"65c281d8-14aa-4def-b705-62e70b4fce66","run_stream":{"kind":"run","id":"65c281d8-14aa-4def-b705-62e70b4fce66"},"call_id":"call_01a0757407977080a07c3a9b6ea901fb","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/dirnode/probe.go`.\n1|package dirnode\n2|\n3|import (\n4|\t\"encoding/json\"\n5|)\n6|\n7|// This file validates the Section 7.9 probe operation in both\n8|// majors: the closed request body with its per-major platform\n9|// vocabulary, and the closed success body with the node-build\n10|// equality gate against the validated manifest.\n11|//\n12|// The probe row the operation table shows is the Request 2.0.0\n13|// form; Request 1.0.0 differs only in its closed legacy platform\n14|// vocabulary from the major-binding table. A v1 darwin request\n15|// denotes the macOS host class of that published major, but darwin\n16|// is not a valid v2 wire value and never appears in an Environment\n17|// Observation; a v1 request cannot express WSL2. The host validates\n18|// the vocabulary belonging to the negotiated major and never\n19|// relabels, reinterprets, or coerces a token across majors.\n20|\n21|// platformV1 is the closed Request 1.0.0 platform vocabulary.\n22|var platformV1 = []string{\n23|\t\"darwin\",\n24|\t\"linux\",\n25|\t\"windows\",\n26|}\n27|\n28|// platformV2 is the closed Request 2.0.0 platform vocabulary.\n29|var platformV2 = []string{\n30|\t\"macos\",\n31|\t\"linux\",\n32|\t\"wsl2\",\n33|\t\"windows\",\n34|}\n35|\n36|// architectures is the closed probe architecture vocabulary under\n37|// either major.\n38|var architectures = []string{\n39|\t\"amd64\",\n40|\t\"arm64\",\n41|}\n42|\n43|// validPlatformForMajor reports whether the platform token belongs\n44|// to the negotiated major's vocabulary. Both vocabularies are table\n45|// loops so the census derives them like every other closed\n46|// vocabulary: an inline chain here would be invisible to the\n47|// census, and a widened chain would silently admit a cross-major\n48|// token.\n49|func validPlatformForMajor(major int, platform string) bool {\n50|\tswitch major {\n51|\tcase MajorV1:\n52|\t\tfor _, allowed := range platformV1 {\n53|\t\t\tif platform == allowed {\n54|\t\t\t\treturn true\n55|\t\t\t}\n56|\t\t}\n57|\t\treturn false\n58|\tcase MajorV2:\n59|\t\tfor _, allowed := range platformV2 {\n60|\t\t\tif platform == allowed {\n61|\t\t\t\treturn true\n62|\t\t\t}\n63|\t\t}\n64|\t\treturn false\n65|\tdefault:\n66|\t\treturn false\n67|\t}\n68|}\n69|\n70|// validArchitecture reports whether the architecture token is a\n71|// registry member.\n72|func validArchitecture(architecture string) bool {\n73|\tfor _, allowed := range architectures {\n74|\t\tif architecture == allowed {\n75|\t\t\treturn true\n76|\t\t}\n77|\t}\n78|\treturn false\n79|}\n80|\n81|// probeRequestMembers is the exact probe request-body member set\n82|// under either major.\n83|var probeRequestMembers = map[string]bool{\n84|\t\"platform\":                  true,\n85|\t\"architecture\":              true,\n86|\t\"requested_environment_ids\": true,\n87|\t\"requested_capabilities\":    true,\n88|\t\"extensions\":                true,\n89|}\n90|\n91|// probeRequestRequired lists probeRequestMembers in a fixed order.\n92|var probeRequestRequired = []string{\n93|\t\"platform\",\n94|\t\"architecture\",\n95|\t\"requested_environment_ids\",\n96|\t\"requested_capabilities\",\n97|\t\"extensions\",\n98|}\n99|\n100|// ProbeRequest is one validated probe request body: the platform\n101|// and architecture tokens plus the sorted unique environment and\n102|// capability filters.\n103|type ProbeRequest struct {\n104|\tMajor                 int\n105|\tPlatform              string\n106|\tArchitecture          string\n107|\tRequestedEnvironments []string\n108|\tRequestedCapabilities []string\n109|}\n110|\n111|// CheckProbeRequest validates one probe-operation request body\n112|// under the negotiated major: the exact closed members, the\n113|// platform token from the major's own vocabulary, a registry\n114|// architecture, sorted unique environment identifiers in the count\n115|// bound, and a sorted unique subset of the capability registry in\n116|// the count bound. A v2 token on a v1 attempt — or the reverse —\n117|// is a violation, never a relabeling.\n118|func CheckProbeRequest(major int, body []byte) (ProbeRequest, error) {\n119|\tif _, ok := VersionForMajor(major); !ok {\n120|\t\tfailure, err := failInvalid(\"probe request major is outside the locally supported registry\", \"protocol_version\")\n121|\t\tif err != nil {\n122|\t\t\treturn ProbeRequest{}, err\n123|\t\t}\n124|\t\treturn ProbeRequest{}, failure\n125|\t}\n126|\tmembers, fault := decodeStrictObject(bytesTrimSpace(body))\n127|\tif fault != nil {\n128|\t\tfailure, err := failViolation(\"probe request \"+fault.detail, fault.member)\n129|\t\tif err != nil {\n130|\t\t\treturn ProbeRequest{}, err\n131|\t\t}\n132|\t\treturn ProbeRequest{}, failure\n133|\t}\n134|\tif name, unknown := unknownMember(members, probeRequestMembers); unknown {\n135|\t\tfailure, err := failViolation(\"probe request carries unknown member\", name)\n136|\t\tif err != nil {\n137|\t\t\treturn ProbeRequest{}, err\n138|\t\t}\n139|\t\treturn ProbeRequest{}, failure\n140|\t}\n141|\tif name, missing := missingMember(members, probeRequestRequired); missing {\n142|\t\tfailure, err := failViolation(\"probe request misses a required member\", name)\n143|\t\tif err != nil {\n144|\t\t\treturn ProbeRequest{}, err\n145|\t\t}\n146|\t\treturn ProbeRequest{}, failure\n147|\t}\n148|\tplatform, ok := rawString(members[\"platform\"])\n149|\tif !ok || !validPlatformForMajor(major, platform) {\n150|\t\tfailure, err := failViolation(\"probe request platform is outside the negotiated major vocabulary\", \"platform\")\n151|\t\tif err != nil {\n152|\t\t\treturn ProbeRequest{}, err\n153|\t\t}\n154|\t\treturn ProbeRequest{}, failure\n155|\t}\n156|\tarchitecture, ok := rawString(members[\"architecture\"])\n157|\tif !ok || !validArchitecture(architecture) {\n158|\t\tfailure, err := failViolation(\"probe request architecture is outside amd64|arm64\", \"architecture\")\n159|\t\tif err != nil {\n160|\t\t\treturn ProbeRequest{}, err\n161|\t\t}\n162|\t\treturn ProbeRequest{}, failure\n163|\t}\n164|\tenvironments, ok := checkSortedUniqueStrings(members[\"requested_environment_ids\"], 1, 64, 0, 64)\n165|\tif !ok {\n166|\t\tfailure, err := failViolation(\"probe request environment identifiers are not sorted unique strings[0..64]\", \"requested_environment_ids\")\n167|\t\tif err != nil {\n168|\t\t\treturn ProbeRequest{}, err\n169|\t\t}\n170|\t\treturn ProbeRequest{}, failure\n171|\t}\n172|\tfor _, environment := range environments {\n173|\t\tif !environmentIDPattern.MatchString(environment) {\n174|\t\t\tfailure, err := failViolation(\"probe request environment identifier is not an environment-id\", \"requested_environment_ids\")\n175|\t\t\tif err != nil {\n176|\t\t\t\treturn ProbeRequest{}, err\n177|\t\t\t}\n178|\t\t\treturn ProbeRequest{}, failure\n179|\t\t}\n180|\t}\n181|\tcapabilities, ok := checkSortedUniqueStrings(members[\"requested_capabilities\"], 1, 64, 0, 8)\n182|\tif !ok {\n183|\t\tfailure, err := failViolation(\"probe request capabilities are not sorted unique strings[0..8]\", \"requested_capabilities\")\n184|\t\tif err != nil {\n185|\t\t\treturn ProbeRequest{}, err\n186|\t\t}\n187|\t\treturn ProbeRequest{}, failure\n188|\t}\n189|\tfor _, capability := range capabilities {\n190|\t\tif !validCapability(capability) {\n191|\t\t\tfailure, err := failViolation(\"probe request capability is outside the directory registry\", \"requested_capabilities\")\n192|\t\t\tif err != nil {\n193|\t\t\t\treturn ProbeRequest{}, err\n194|\t\t\t}\n195|\t\t\treturn ProbeRequest{}, failure\n196|\t\t}\n197|\t}\n198|\tif !checkExtensions(members[\"extensions\"]) {\n199|\t\tfailure, err := failViolation(\"probe request extensions are not reverse-DNS keyed\", \"extensions\")\n200|\t\tif err != nil {\n201|\t\t\treturn ProbeRequest{}, err\n202|\t\t}\n203|\t\treturn ProbeRequest{}, failure\n204|\t}\n205|\treturn ProbeRequest{\n206|\t\tMajor:                 major,\n207|\t\tPlatform:              platform,\n208|\t\tArchitecture:          architecture,\n209|\t\tRequestedEnvironments: environments,\n210|\t\tRequestedCapabilities: capabilities,\n211|\t}, nil\n212|}\n213|\n214|// probeResponseMembers is the exact probe success-body member set.\n215|var probeResponseMembers = map[string]bool{\n216|\t\"host_id\":       true,\n217|\t\"node_build\":    true,\n218|\t\"policy_digest\": true,\n219|\t\"environments\":  true,\n220|\t\"findings\":      true,\n221|\t\"extensions\":    true,\n222|}\n223|\n224|// probeResponseRequired lists probeResponseMembers in a fixed order.\n225|var probeResponseRequired = []string{\n226|\t\"host_id\",\n227|\t\"node_build\",\n228|\t\"policy_digest\",\n229|\t\"environments\",\n230|\t\"findings\",\n231|\t\"extensions\",\n232|}\n233|\n234|// nodeBuildMembers is the exact DirectoryNodeBuild member set.\n235|var nodeBuildMembers = map[string]bool{\n236|\t\"node_id\":                         true,\n237|\t\"node_version\":                    true,\n238|\t\"executable_sha256\":               true,\n239|\t\"provider_manifest_digest\":        true,\n240|\t\"session_adapter_manifest_digest\": true,\n241|\t\"extensions\":                      true,\n242|}\n243|\n244|// nodeBuildRequired lists nodeBuildMembers in a fixed order.\n245|var nodeBuildRequired = []string{\n246|\t\"node_id\",\n247|\t\"node_version\",\n248|\t\"executable_sha256\",\n249|\t\"provider_manifest_digest\",\n250|\t\"session_adapter_manifest_digest\",\n251|\t\"extensions\",\n252|}\n253|\n254|// findingMembers is the exact AdapterFinding member set.\n255|var findingMembers = map[string]bool{\n256|\t\"severity\":    true,\n257|\t\"code\":        true,\n258|\t\"message\":     true,\n259|\t\"remediation\": true,\n260|\t\"extensions\":  true,\n261|}\n262|\n263|// findingRequired lists findingMembers in a fixed order.\n264|var findingRequired = []string{\n265|\t\"severity\",\n266|\t\"code\",\n267|\t\"message\",\n268|\t\"remediation\",\n269|\t\"extensions\",\n270|}\n271|\n272|// findingSeverities is the closed AdapterFinding severity\n273|// vocabulary.\n274|var findingSeverities = []string{\n275|\t\"info\",\n276|\t\"warning\",\n277|\t\"error\",\n278|}\n279|\n280|// validFindingSeverity reports whether the severity is a registry\n281|// member.\n282|func validFindingSeverity(severity string) bool {\n283|\tfor _, allowed := range findingSeverities {\n284|\t\tif severity == allowed {\n285|\t\t\treturn true\n286|\t\t}\n287|\t}\n288|\treturn false\n289|}\n290|\n291|// NodeBuild is one validated DirectoryNodeBuild: the five identity\n292|// values CheckNodeBuildEqualsManifest compares against the current\n293|// manifest.\n294|type NodeBuild struct {\n295|\tNodeID                 string\n296|\tNodeVersion            string\n297|\tExecutableSHA256       string\n298|\tProviderManifestDigest string\n299|\tAdapterManifestDigest  string\n300|}\n301|\n302|// Finding is one validated AdapterFinding.\n303|type Finding struct {\n304|\tSeverity    string\n305|\tCode        string\n306|\tMessage     string\n307|\tRemediation string\n308|\tHasRemedy   bool\n309|}\n310|\n311|// ProbeResponse is one validated probe success body. Environment\n312|// observations cross as validated array bounds of present objects:\n313|// their content belongs to the shared-environment leaf of this\n314|// Story, so checkProbeEnvironments requires each element to be an\n315|// object and never inspects further — the one place that bound is\n316|// enforced.\n317|type ProbeResponse struct {\n318|\tHostID       string\n319|\tBuild        NodeBuild\n320|\tPolicyDigest string\n321|\tEnvironments int\n322|\tFindings     []Finding\n323|}\n324|\n325|// CheckProbeResponse validates one probe-operation success body:\n326|// the exact closed members, the host identifier, the closed node\n327|// build, the policy digest, the bounded environment and finding\n328|// arrays, and extensions.\n329|func CheckProbeResponse(body []byte) (ProbeResponse, error) {\n330|\tmembers, fault := decodeStrictObject(bytesTrimSpace(body))\n331|\tif fault != nil {\n332|\t\tfailure, err := failViolation(\"probe response \"+fault.detail, fault.member)\n333|\t\tif err != nil {\n334|\t\t\treturn ProbeResponse{}, err\n335|\t\t}\n336|\t\treturn ProbeResponse{}, failure\n337|\t}\n338|\tif name, unknown := unknownMember(members, probeResponseMembers); unknown {\n339|\t\tfailure, err := failViolation(\"probe response carries unknown member\", name)\n340|\t\tif err != nil {\n341|\t\t\treturn ProbeResponse{}, err\n342|\t\t}\n343|\t\treturn ProbeResponse{}, failure\n344|\t}\n345|\tif name, missing := missingMember(members, probeResponseRequired); missing {\n346|\t\tfailure, err := failViolation(\"probe response misses a required member\", name)\n347|\t\tif err != nil {\n348|\t\t\treturn ProbeResponse{}, err\n349|\t\t}\n350|\t\treturn ProbeResponse{}, failure\n351|\t}\n352|\thostID, ok := checkUUIDv7(members[\"host_id\"])\n353|\tif !ok {\n354|\t\tfailure, err := failViolation(\"probe response host identifier is not a UUIDv7\", \"host_id\")\n355|\t\tif err != nil {\n356|\t\t\treturn ProbeResponse{}, err\n357|\t\t}\n358|\t\treturn ProbeResponse{}, failure\n359|\t}\n360|\tbuild, ok := checkNodeBuild(members[\"node_build\"])\n361|\tif !ok {\n362|\t\tfailure, err := failViolation(\"probe response node build is not the closed DirectoryNodeBuild\", \"node_build\")\n363|\t\tif err != nil {\n364|\t\t\treturn ProbeResponse{}, err\n365|\t\t}\n366|\t\treturn ProbeResponse{}, failure\n367|\t}\n368|\tpolicy, ok := checkDigest(members[\"policy_digest\"])\n369|\tif !ok {\n370|\t\tfailure, err := failViolation(\"probe response policy digest is not a digest\", \"policy_digest\")\n371|\t\tif err != nil {\n372|\t\t\treturn ProbeResponse{}, err\n373|\t\t}\n374|\t\treturn ProbeResponse{}, failure\n375|\t}\n376|\tenvironments, ok := checkNestedObjects(members[\"environments\"], 0, 256)\n377|\tif !ok {\n378|\t\tfailure, err := failViolation(\"probe response environments are not EnvironmentObservation[0..256] by shape\", \"environments\")\n379|\t\tif err != nil {\n380|\t\t\treturn ProbeResponse{}, err\n381|\t\t}\n382|\t\treturn ProbeResponse{}, failure\n383|\t}\n384|\tfindings, ok := checkFindings(members[\"findings\"])\n385|\tif !ok {\n386|\t\tfailure, err := failViolation(\"probe response findings are not AdapterFinding[0..4096]\", \"findings\")\n387|\t\tif err != nil {\n388|\t\t\treturn ProbeResponse{}, err\n389|\t\t}\n390|\t\treturn ProbeResponse{}, failure\n391|\t}\n392|\tif !checkExtensions(members[\"extensions\"]) {\n393|\t\tfailure, err := failViolation(\"probe response extensions are not reverse-DNS keyed\", \"extensions\")\n394|\t\tif err != nil {\n395|\t\t\treturn ProbeResponse{}, err\n396|\t\t}\n397|\t\treturn ProbeResponse{}, failure\n398|\t}\n399|\treturn ProbeResponse{\n400|\t\tHostID:       hostID.String(),\n401|\t\tBuild:        build,\n402|\t\tPolicyDigest: policy.String(),\n403|\t\tEnvironments: environments,\n404|\t\tFindings:     findings,\n405|\t}, nil\n406|}\n407|\n408|// checkNodeBuild validates one DirectoryNodeBuild object.\n409|func checkNodeBuild(raw json.RawMessage) (NodeBuild, bool) {\n410|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n411|\tif fault != nil {\n412|\t\treturn NodeBuild{}, false\n413|\t}\n414|\tif name, unknown := unknownMember(members, nodeBuildMembers); unknown {\n415|\t\t_ = name\n416|\t\treturn NodeBuild{}, false\n417|\t}\n418|\tif name, missing := missingMember(members, nodeBuildRequired); missing {\n419|\t\t_ = name\n420|\t\treturn NodeBuild{}, false\n421|\t}\n422|\tnodeID, ok := checkStringBounds(members[\"node_id\"], 1, 128)\n423|\tif !ok {\n424|\t\treturn NodeBuild{}, false\n425|\t}\n426|\tnodeVersion, ok := rawString(members[\"node_version\"])\n427|\tif !ok || !checkSemver(nodeVersion) {\n428|\t\treturn NodeBuild{}, false\n429|\t}\n430|\texecutable, ok := checkDigest(members[\"executable_sha256\"])\n431|\tif !ok {\n432|\t\treturn NodeBuild{}, false\n433|\t}\n434|\tproviderDigest, ok := checkDigest(members[\"provider_manifest_digest\"])\n435|\tif !ok {\n436|\t\treturn NodeBuild{}, false\n437|\t}\n438|\tadapterDigest, ok := checkDigest(members[\"session_adapter_manifest_digest\"])\n439|\tif !ok {\n440|\t\treturn NodeBuild{}, false\n441|\t}\n442|\tif !checkExtensions(members[\"extensions\"]) {\n443|\t\treturn NodeBuild{}, false\n444|\t}\n445|\treturn NodeBuild{\n446|\t\tNodeID:                 nodeID,\n447|\t\tNodeVersion:            nodeVersion,\n448|\t\tExecutableSHA256:       executable.String(),\n449|\t\tProviderManifestDigest: providerDigest.String(),\n450|\t\tAdapterManifestDigest:  adapterDigest.String(),\n451|\t}, true\n452|}\n453|\n454|// checkNestedObjects reports the element count when the member is\n455|// an array of objects in the count bound. Elements are required to\n456|// be objects and are never inspected further here: their content\n457|// owner is the shared-environment leaf, and inventing its\n458|// validation here would collide with that ownership at\n459|// integration.\n460|func checkNestedObjects(raw json.RawMessage, minimumCount, maximumCount uint64) (int, bool) {\n461|\telements, ok := decodeArray(raw)\n462|\tif !ok {\n463|\t\treturn 0, false\n464|\t}\n465|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n466|\t\treturn 0, false\n467|\t}\n468|\tfor _, element := range elements {\n469|\t\tif _, fault := decodeStrictObject(bytesTrimSpace(element)); fault != nil {\n470|\t\t\treturn 0, false\n471|\t\t}\n472|\t}\n473|\treturn len(elements), true\n474|}\n475|\n476|// checkFindings validates an AdapterFinding array in the count\n477|// bound.\n478|func checkFindings(raw json.RawMessage) ([]Finding, bool) {\n479|\telements, ok := decodeArray(raw)\n480|\tif !ok || len(elements) > 4096 {\n481|\t\treturn nil, false\n482|\t}\n483|\tfindings := make([]Finding, 0, len(elements))\n484|\tfor _, element := range elements {\n485|\t\tfinding, ok := checkFinding(element)\n486|\t\tif !ok {\n487|\t\t\treturn nil, false\n488|\t\t}\n489|\t\tfindings = append(findings, finding)\n490|\t}\n491|\treturn findings, true\n492|}\n493|\n494|// checkFinding validates one AdapterFinding object.\n495|func checkFinding(raw json.RawMessage) (Finding, bool) {\n496|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n497|\tif fault != nil {\n498|\t\treturn Finding{}, false\n499|\t}\n500|\tif name, unknown := unknownMember(members, findingMembers); unknown {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
