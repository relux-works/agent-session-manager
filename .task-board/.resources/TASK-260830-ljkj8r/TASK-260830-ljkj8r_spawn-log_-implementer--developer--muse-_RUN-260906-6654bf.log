UniqueStrings(members[\\\"requested_capabilities\\\"], 1, 64, 0, 9)',\\n  \\\"TestSortedUniqueStringsEdges/requested_capabilities\\\", \\\"equiv\\\", \\\"9th registry capability unbuildable; count masked behind closed vocabulary\\\")'''),\\n ('''M(\\\"M144\\\", \\\"query.go\\\", None,\\n  'fields, ok := checkSortedUniqueStrings(fieldsRaw, 1, 64, 0, 128)',\\n  'fields, ok := checkSortedUniqueStrings(fieldsRaw, 1, 64, 0, 129)',\\n  \\\"TestDecodeQueryProjectionFields\\\", \\\"kill\\\", \\\"fields count ceiling\\\")''',\\n  '''M(\\\"M144\\\", \\\"query.go\\\", None,\\n  'fields, ok := checkSortedUniqueStrings(fieldsRaw, 1, 64, 0, 128)',\\n  'fields, ok := checkSortedUniqueStrings(fieldsRaw, 1, 64, 0, 129)',\\n  \\\"TestDecodeQueryProjectionFields\\\", \\\"equiv\\\", \\\"129 valid fields unbuildable (27 in registry); count masked behind field registry\\\")'''),\\n]\\nfor old, new in fixes:\\n    assert src.count(old) == 1, old[:60]\\n    src = src.replace(old, new)\\nopen(path, \\\"w\\\").write(src)\\nprint(\\\"battery expectations fixed\\\")\\nEOF\",\n  \"description\": \"Fix battery expectations for M28 M39 M144\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"battery expectations fixed\\n\",\n  \"original_output_bytes\": 27,\n  \"original_output_tokens\": 7,\n  \"truncated\": false\n}"}}}
