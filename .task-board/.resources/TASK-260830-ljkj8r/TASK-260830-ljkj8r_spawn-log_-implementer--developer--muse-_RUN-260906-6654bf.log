{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc1b","stream":{"kind":"session","id":"01a07573-a73b-7be0-abe2-6029bca74ffd"},"sequence":1128,"recorded_at":1780531400002251,"record_type":"event","durability":"durable","causation_id":"65c281d8-14aa-4def-b705-62e70b4fce66","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"65c281d8-14aa-4def-b705-62e70b4fce66","run_stream":{"kind":"run","id":"65c281d8-14aa-4def-b705-62e70b4fce66"},"task_stream":{"kind":"task","id":"137207e9-a758-48fd-8e89-e292544936b8"},"task_id":"137207e9-a758-48fd-8e89-e292544936b8","event":{"kind":"output","task_id":"137207e9-a758-48fd-8e89-e292544936b8","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/dirnode/probe_test.go`.\n(163 line(s) above)\n164|// TestProbeResponseFindingBound drives the production probe\n165|// response entry against the finding count bound: more than 4096\n166|// findings refuse no matter how small each one is.\n167|func TestProbeResponseFindingBound(t *testing.T) {\n168|\tt.Parallel()\n169|\tone := `{\"severity\":\"info\",\"code\":\"c\",\"message\":\"m\",\"remediation\":null,\"extensions\":{}}`\n170|\tmany := strings.Repeat(one+`,`, 4096) + one\n171|\tbody := replaceOnce(t, fixtureProbeResponseJSON(), `\"findings\":[{`, `\"findings\":[`+many+`,{`, 1)\n172|\tif _, err := CheckProbeResponse([]byte(body)); requireCode(t, err, \"adapter_protocol_violation\") == nil {\n173|\t\tt.Fatal(\"4098 findings must refuse\")\n174|\t}\n175|\tedge := replaceOnce(t, fixtureProbeResponseJSON(), `\"findings\":[{`, `\"findings\":[`+strings.Repeat(one+`,`, 4094)+one+`,{`, 1)\n176|\tif _, err := CheckProbeResponse([]byte(edge)); err != nil {\n177|\t\tt.Fatalf(\"4096 findings must admit: %v\", err)\n178|\t}\n179|}\n180|\n181|// TestNodeBuildEqualityRefusesDrift drives the production\n182|// node-build equality gate with one drifted value per binding:\n183|// any divergence from the manifest is an integrity failure.\n184|func TestNodeBuildEqualityRefusesDrift(t *testing.T) {\n185|\tt.Parallel()\n186|\tresponse, err := CheckProbeResponse([]byte(fixtureProbeResponseJSON()))\n187|\tif err != nil {\n188|\t\tt.Fatalf(\"CheckProbeResponse error = %v\", err)\n189|\t}\n190|\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n191|\tif err != nil {\n192|\t\tt.Fatalf(\"DecodeManifest error = %v\", err)\n193|\t}\n194|\tfor _, probe := range []struct {\n195|\t\tname  string\n196|\t\tapply func(*NodeBuild)\n197|\t}{\n198|\t\t{\"node id\", func(build *NodeBuild) { build.NodeID = \"other-node\" }},\n199|\t\t{\"node version\", func(build *NodeBuild) { build.NodeVersion = \"9.9.9\" }},\n200|\t\t{\"executable\", func(build *NodeBuild) { build.ExecutableSHA256 = fixtureDigest(\"other\") }},\n201|\t\t{\"provider binding\", func(build *NodeBuild) { build.ProviderManifestDigest = fixtureDigest(\"other\") }},\n202|\t\t{\"adapter binding\", func(build *NodeBuild) { build.AdapterManifestDigest = fixtureDigest(\"other\") }},\n203|\t} {\n204|\t\tt.Run(probe.name, func(t *testing.T) {\n205|\t\t\tt.Parallel()\n206|\t\t\tbuild := response.Build\n207|\t\t\tprobe.apply(&build)\n208|\t\t\trequireCode(t, CheckNodeBuildEqualsManifest(build, manifest), \"integrity_failure\")\n209|\t\t})\n210|\t}\n211|}"}}}
