ntegrity|failure error is not a Structured Error 1.2.0\":                                      {\"TestCheckFailureEnvelopeRefusals\"},\n654|\t\"ctor|failIntegrity|node manifest executable binding contradicts the observed executable\":               {\"TestCheckManifestBindings\"},\n655|\t\"ctor|failIntegrity|node manifest provider binding contradicts the observed manifest\":                   {\"TestCheckManifestBindings\"},\n656|\t\"ctor|failIntegrity|node manifest adapter binding contradicts the observed manifest\":                    {\"TestCheckManifestBindings\"},\n657|\t\"ctor|failIntegrity|probe node build node identifier differs from the manifest\":                         {\"TestNodeBuildEqualityRefusesDrift\"},\n658|\t\"ctor|failIntegrity|probe node build node version differs from the manifest\":                            {\"TestNodeBuildEqualityRefusesDrift\"},\n659|\t\"ctor|failIntegrity|probe node build executable binding differs from the manifest\":                      {\"TestNodeBuildEqualityRefusesDrift\"},\n660|\t\"ctor|failIntegrity|probe node build provider binding differs from the manifest\":                        {\"TestNodeBuildEqualityRefusesDrift\"},\n661|\t\"ctor|failIntegrity|probe node build adapter binding differs from the manifest\":                         {\"TestNodeBuildEqualityRefusesDrift\"},\n662|\t\"ctor|failIdempotency|idempotent body changed under a recorded operation identifier\":                    {\"TestJournalRefusesChangedBody\", \"TestJournalSurvivesRestart\"},\n663|\t\"ctor|failQuery|directory query carries unknown member\":                                                 {\"TestDecodeQueryEnvelopeRules\"},\n664|\t\"ctor|failQuery|directory query misses a required member\":                                               {\"TestDecodeQueryEnvelopeRules\"},\n665|\t\"ctor|failQuery|directory query schema is not the session directory query\":                              {\"TestDecodeQueryEnvelopeRules\"},\n666|\t\"ctor|failQuery|directory query version is not 1.0.0\":                                                   {\"TestDecodeQueryEnvelopeRules\"},\n667|\t\"ctor|failQuery|directory query identifier is not a UUIDv7\":                                             {\"TestDecodeQueryEnvelopeRules\"},\n668|\t\"ctor|failQuery|directory query operations are not QueryOperation[1..64]\":                               {\"TestDecodeQueryIndexRules\"},\n669|\t\"ctor|failQuery|directory query caller is not a closed CallerContext\":                                   {\"TestDecodeQueryEnvelopeRules\"},\n670|\t\"ctor|failQuery|directory query extensions are not reverse-DNS keyed\":                                   {\"TestDecodeQueryEnvelopeRules\"},\n671|\t\"ctor|failQuery|directory query operation is not a closed QueryOperation\":                               {\"TestDecodeQueryIndexRules\", \"TestDecodeQueryRegistryRules\", \"TestDecodeQueryMutationFlagRules\", \"TestDecodeQueryPaginationRules\"},\n672|\t\"ctor|failQuery|directory cursor is not a string[1..1024]\":                                              {\"TestCheckCursorReuse\"},\n673|\t\"ctor|failQuery|directory cursor is bound to a changed query\":                                           {\"TestCheckCursorReuse\"},\n674|\t`ctor|failViolation|expr|EncodeRequest|\"request body \"+fault.detail`:                                    {\"TestEncodeRequestRefusals\"},\n675|\t`ctor|failViolation|expr|DecodeRequestFrame|\"request envelope \"+fault.detail`:                           {\"TestDecodeRequestFrameRefusals\", \"TestDecodeRequestFrameStrictFaults\"},\n676|\t`ctor|failViolation|expr|DecodeRequestFrame|\"request body \"+fault.detail`:                               {\"TestDecodeRequestFrameRefusals\"},\n677|\t`ctor|failViolation|expr|CheckSuccessEnvelope|\"success body \"+fault.detail`:                             {\"TestCheckSuccessEnvelopeRefusals\"},\n678|\t`ctor|failViolation|expr|DecodeManifest|\"node manifest \"+fault.detail`:                                  {\"TestDecodeManifestClosedMemberRules\"},\n679|\t`ctor|failViolation|expr|CheckProbeRequest|\"probe request \"+fault.detail`:                               {\"TestProbeRequestRefusals\"},\n680|\t`ctor|failViolation|expr|CheckProbeResponse|\"probe response \"+fault.detail`:                             {\"TestProbeResponseRefusals\"},\n681|\t`ctor|failViolation|expr|CheckScanRequest|\"scan request \"+fault.detail`:                                 {\"TestCheckScanRequestRefusals\"},\n682|\t`ctor|failViolation|expr|CheckScanResponse|\"scan response \"+fault.detail`:                               {\"TestCheckScanResponseRefusals\"},\n683|\t`ctor|failIntegrity|expr|Import|\"idempotency journal \"+fault.detail`:                                    {\"TestJournalSurvivesRestart\"},\n684|\t\"ctor|failIntegrity|idempotency journal schema is not the journal export\":                               {\"TestJournalSurvivesRestart\"},\n685|\t\"ctor|failIntegrity|idempotency journal version is not 1\":                                               {\"TestJournalSurvivesRestart\"},\n686|\t\"ctor|failIntegrity|idempotency journal records are not an array\":                                       {\"TestJournalSurvivesRestart\"},\n687|\t\"ctor|failIntegrity|idempotency journal record is not a keyed digest binding\":                           {\"TestJournalSurvivesRestart\", \"TestJournalImportRefusesUnsortedRecords\"},\n688|\t\"ctor|failIntegrity|idempotency journal records are not sorted unique\":                                  {\"TestJournalImportRefusesUnsortedRecords\"},\n689|\t`ctor|failQuery|expr|DecodeQuery|\"directory query \"+fault.detail`:                                       {\"TestDecodeQueryEnvelopeRules\"},\n690|\t`ctor|failViolation|expr|checkResponseIdentity|context+\" frame is empty\"`:                               {\"TestResponseIdentitySharedArms\"},\n691|\t`ctor|failViolation|expr|checkResponseIdentity|context+\" frame exceeds the 8 MiB bound\"`:                {\"TestResponseIdentitySharedArms\"},\n692|\t`ctor|failViolation|expr|checkResponseIdentity|context+\" envelope \"+fault.detail`:                       {\"TestResponseIdentitySharedArms\"},\n693|\t`ctor|failViolation|expr|checkResponseIdentity|context+\" envelope carries unknown member\"`:              {\"TestCheckSuccessEnvelopeRefusals\", \"TestCheckFailureEnvelopeRefusals\"},\n694|\t`ctor|failViolation|expr|checkResponseIdentity|context+\" envelope misses a required member\"`:            {\"TestCheckSuccessEnvelopeRefusals\", \"TestCheckFailureEnvelopeRefusals\"},\n695|\t`ctor|failViolation|expr|checkResponseIdentity|context+\" schema is not the directory node response\"`:    {\"TestCheckSuccessEnvelopeRefusals\", \"TestCheckFailureEnvelopeRefusals\"},\n696|\t`ctor|failViolation|expr|checkResponseIdentity|context+\" schema version is not the bound 1.0.0\"`:        {\"TestCheckSuccessEnvelopeRefusals\", \"TestCheckFailureEnvelopeRefusals\"},\n697|\t`ctor|failViolation|expr|checkResponseIdentity|context+\" protocol does not echo the request\"`:           {\"TestCheckSuccessEnvelopeRefusals\", \"TestCheckFailureEnvelopeRefusals\"},\n698|\t`ctor|failViolation|expr|checkResponseIdentity|context+\" protocol version does not echo the request\"`:   {\"TestCheckSuccessEnvelopeRefusals\", \"TestCheckFailureEnvelopeRefusals\"},\n699|\t`ctor|failViolation|expr|checkResponseIdentity|context+\" request identifier does not echo the request\"`: {\"TestCheckSuccessEnvelopeRefusals\", \"TestCheckFailureEnvelopeRefusals\"},\n700|\t`ctor|failViolation|expr|checkResponseIdentity|context+\" operation does not echo the request\"`:          {\"TestCheckSuccessEnvelopeRefusals\", \"TestCheckFailureEnvelopeRefusals\"},\n701|\t\"frame|not valid UTF-8\":                {\"TestDecodeRequestFrameStrictFaults\"},\n702|\t\"frame|lone surrogate escape\":          {\"TestDecodeRequestFrameStrictFaults\"},\n703|\t\"frame|not a JSON object\":              {\"TestDecodeRequestFrameStrictFaults\", \"TestDecodeRequestFrameRefusals\"},\n704|\t\"frame|duplicate member\":               {\"TestDecodeRequestFrameRefusals\"},\n705|\t\"frame|trailing data after the object\": {\"TestDecodeRequestFrameStrictFaults\"},\n706|}\n707|\n708|// TestRefusalConstructorsMatchProduction requires the registered\n709|// constructor set to equal the derived one and every axerror.New\n710|// site to sit inside a registered body with no violations: the\n711|// denominator is derived from production, not from the test\n712|// file. Any violation fails the census instead of passing\n713|// silently.\n714|func TestRefusalConstructorsMatchProduction(t *testing.T) {\n715|\tderived := deriveRefusalArms(t)\n716|\tif len(derived.violations) > 0 {\n717|\t\tsort.Strings(derived.violations)\n718|\t\tt.Fatalf(\"census violations:\\n  %s\", strings.Join(derived.violations, \"\\n  \"))\n719|\t}\n720|\tvar got []string\n721|\tfor name := range derived.ctors {\n722|\t\tgot = append(got, name)\n723|\t}\n724|\tsort.Strings(got)\n725|\twant := append([]string(nil), refusalConstructors...)\n726|\tsort.Strings(want)\n727|\tif strings.Join(got, \"\\x00\") != strings.Join(want, \"\\x00\") {\n728|\t\tt.Fatalf(\"derived constructors = %v, want registered %v\", got, want)\n729|\t}\n730|}\n731|\n732|// TestCensusScansEveryProductionFile requires the scanned set to\n733|// equal the package's production files: a production file the\n734|// census never opens is a file whose arms never derive.\n735|func TestCensusScansEveryProductionFile(t *testing.T) {\n736|\tfiles := productionFiles(t)\n737|\tnames := map[string]bool{\n738|\t\t\"bootstrap.go\": true,\n739|\t\t\"decode.go\":    true,\n740|\t\t\"doc.go\":       true,\n741|\t\t\"manifest.go\":  true,\n742|\t\t\"probe.go\":     true,\n743|\t\t\"protocol.go\":  true,\n744|\t\t\"query.go\":     true,\n745|\t\t\"scan.go\":      true,\n746|\t}\n747|\tif len(files) != len(names) {\n748|\t\tt.Fatalf(\"scanned %d files %v, want %d named files\", len(files), files, len(names))\n749|\t}\n750|\tfor _, path := range files {\n751|\t\tif !names[filepath.Base(path)] {\n752|\t\t\tt.Fatalf(\"unexpected production file %q: register it here or the census ignores it\", path)\n753|\t\t}\n754|\t}\n755|}\n756|\n757|// TestDerivedRefusalArmsAreAllWitnessed requires every derived\n758|// arm to carry a witness or a recorded defensive rationale: an\n759|// arm nobody drives is next round's finding, stated here instead.\n760|func TestDerivedRefusalArmsAreAllWitnessed(t *testing.T) {\n761|\tderived := deriveRefusalArms(t)\n762|\tif len(derived.violations) > 0 {\n763|\t\tsort.Strings(derived.violations)\n764|\t\tt.Fatalf(\"census violations:\\n  %s\", strings.Join(derived.violations, \"\\n  \"))\n765|\t}\n766|\tvar missing []string\n767|\tfor arm := range derived.arms {\n768|\t\tif _, witnessed := armWitnesses[arm]; witnessed {\n769|\t\t\tcontinue\n770|\t\t}\n771|\t\tif _, defensive := defensiveArms[arm]; defensive {\n772|\t\t\tcontinue\n773|\t\t}\n774|\t\tmissing = append(missing, arm)\n775|\t}\n776|\tsort.Strings(missing)\n777|\tif len(missing) > 0 {\n778|\t\tt.Fatalf(\"unwitnessed arms:\\n  %s\", strings.Join(missing, \"\\n  \"))\n779|\t}\n780|\tt.Logf(\"census: %d arms witnessed, %d defensive, %d constructors\", len(armWitnesses), len(defensiveArms), len(derived.ctors))\n781|}\n782|\n783|// TestWitnessedArmsAreAllDerived requires every witness row to\n784|// name a derived arm: a truncated derivation reddens on the\n785|// orphaned witnesses instead of passing vacuously.\n786|func TestWitnessedArmsAreAllDerived(t *testing.T) {\n787|\tderived := deriveRefusalArms(t)\n788|\tif len(derived.violations) > 0 {\n789|\t\tsort.Strings(derived.violations)\n790|\t\tt.Fatalf(\"census violations:\\n  %s\", strings.Join(derived.violations, \"\\n  \"))\n791|\t}\n792|\tvar orphaned []string\n793|\tfor arm := range armWitnesses {\n794|\t\tif !derived.arms[arm] {\n795|\t\t\torphaned = append(orphaned, arm)\n796|\t\t}\n797|\t}\n798|\tfor arm := range defensiveArms {\n799|\t\tif !derived.arms[arm] {\n800|\t\t\torphaned = append(orphaned, arm+\" (defensive)\")\n801|\t\t}\n802|\t}\n803|\tsort.Strings(orphaned)\n804|\tif len(orphaned) > 0 {\n805|\t\tt.Fatalf(\"orphaned witness rows:\\n  %s\", strings.Join(orphaned, \"\\n  \"))\n806|\t}\n807|}\n808|\n809|// TestWitnessesResolve requires every named witness to exist as\n810|// a test function in this package's test files: a witness that\n811|// names nothing proves nothing.\n812|func TestWitnessesResolve(t *testing.T) {\n813|\tdefined := map[string]bool{}\n814|\tentries, err := os.ReadDir(\".\")\n815|\tif err != nil {\n816|\t\tt.Fatalf(\"witness resolve: %v\", err)\n817|\t}\n818|\tfor _, entry := range entries {\n819|\t\tname := entry.Name()\n820|\t\tif entry.IsDir() || !strings.HasSuffix(name, \"_test.go\") {\n821|\t\t\tcontinue\n822|\t\t}\n823|\t\tsource, err := os.ReadFile(name)\n824|\t\tif err != nil {\n825|\t\t\tt.Fatalf(\"witness resolve: %v\", err)\n826|\t\t}\n827|\t\tsyntax, err := parseGoFile(name, source)\n828|\t\tif err != nil {\n829|\t\t\tt.Fatalf(\"witness resolve: %v\", err)\n830|\t\t}\n831|\t\tfor _, declaration := range syntax.Decls {\n832|\t\t\tfunction, ok := declaration.(*ast.FuncDecl)\n833|\t\t\tif !ok || function.Recv != nil {\n834|\t\t\t\tcontinue\n835|\t\t\t}\n836|\t\t\tdefined[function.Name.Name] = true\n837|\t\t}\n838|\t}\n839|\tvar missing []string\n840|\tseen := map[string]bool{}\n841|\tfor _, witnesses := range armWitnesses {\n842|\t\tfor _, witness := range witnesses {\n843|\t\t\tif seen[witness] {\n844|\t\t\t\tcontinue\n845|\t\t\t}\n846|\t\t\tseen[witness] = true\n847|\t\t\tif !defined[witness] {\n848|\t\t\t\tmissing = append(missing, witness)\n849|\t\t\t}\n850|\t\t}\n851|\t}\n852|\tsort.Strings(missing)\n853|\tif len(missing) > 0 {\n854|\t\tt.Fatalf(\"unresolved witnesses:\\n  %s\", strings.Join(missing, \"\\n  \"))\n855|\t}\n856|}\n857|\n858|// TestConstructorAliasSpellingsFailDerivation proves the alias\n859|// shapes against synthetic setters: a package-level var alias, a\n860|// function-local := alias, and a constructor passed as an\n861|// argument all fail the derivation, while the definition Name\n862|// itself stays exempt. The vectors are synthetic on purpose:\n863|// they prove the gate, not production.\n864|func TestConstructorAliasSpellingsFailDerivation(t *testing.T) {\n865|\tscan := &fileScan{derived: &armDerivation{arms: map[string]bool{}, ctors: map[string]bool{}}, name: \"synthetic.go\"}\n866|\t_ = scan\n867|\tfor _, probe := range []struct {\n868|\t\tname   string\n869|\t\tsource string\n870|\t\twant   int\n871|\t}{\n872|\t\t{\"definition name exempt\", \"package probe\\nvar failInvalid = func(detail string, field string) {}\\n\", 0},\n873|\t\t{\"package var alias fails\", \"package probe\\nvar alias = failInvalid\\n\", 1},\n874|\t\t{\"local alias fails\", \"package probe\\nfunc f() { alias := failInvalid; _ = alias }\\n\", 1},\n875|\t\t{\"argument alias fails\", \"package probe\\nfunc f() { g(failInvalid) }\\nfunc g(v any) {}\\n\", 1},\n876|\t\t{\"return alias fails\", \"package probe\\nfunc f() any { return failInvalid }\\n\", 1},\n877|\t\t{\"assignment alias fails\", \"package probe\\nfunc f() { var v any; v = failInvalid; _ = v }\\n\", 1},\n878|\t} {\n879|\t\tt.Run(probe.name, func(t *testing.T) {\n880|\t\t\tsyntax, err := parseGoFile(\"synthetic.go\", []byte(probe.source))\n881|\t\t\tif err != nil {\n882|\t\t\t\tt.Fatalf(\"parse synthetic source: %v\", err)\n883|\t\t\t}\n884|\t\t\tderived := &armDerivation{arms: map[string]bool{}, ctors: map[string]bool{}}\n885|\t\t\tinner := &fileScan{derived: derived, name: \"synthetic.go\"}\n886|\t\t\tvar stack []ast.Node\n887|\t\t\tast.Inspect(syntax, func(node ast.Node) bool {\n888|\t\t\t\tif node == nil {\n889|\t\t\t\t\tstack = stack[:len(stack)-1]\n890|\t\t\t\t\treturn true\n891|\t\t\t\t}\n892|\t\t\t\tvar parent ast.Node\n893|\t\t\t\tif len(stack) > 0 {\n894|\t\t\t\t\tparent = stack[len(stack)-1]\n895|\t\t\t\t}\n896|\t\t\t\tinner.visit(node, parent, 0)\n897|\t\t\t\tstack = append(stack, node)\n898|\t\t\t\treturn true\n899|\t\t\t})\n900|\t\t\tif len(derived.violations) != probe.want {\n901|\t\t\t\tt.Fatalf(\"violations = %v, want %d\", derived.violations, probe.want)\n902|\t\t\t}\n903|\t\t})\n904|\t}\n905|}"}}}
