{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d45b","stream":{"kind":"session","id":"01a07573-a73b-7be0-abe2-6029bca74ffd"},"sequence":2184,"recorded_at":1780531400004363,"record_type":"event","durability":"durable","causation_id":"65c281d8-14aa-4def-b705-62e70b4fce66","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"65c281d8-14aa-4def-b705-62e70b4fce66","run_stream":{"kind":"run","id":"65c281d8-14aa-4def-b705-62e70b4fce66"},"task_stream":{"kind":"task","id":"5c26e6be-bf37-4fb4-9f40-ad46b8614ade"},"task_id":"5c26e6be-bf37-4fb4-9f40-ad46b8614ade","event":{"kind":"output","task_id":"5c26e6be-bf37-4fb4-9f40-ad46b8614ade","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/dirnode/protocol_test.go`.\n(61 line(s) above)\n62|\t\t{\"relabeled major pair\", fixtureRequestFrame(\"1.0.0\", \"manifest\", fixtureRequestID, 1, `{}`)[:0:0], \"adapter_protocol_violation\", \"\"},\n63|\t\t{\"unknown operation\", fixtureRequestFrame(\"2.0.0\", \"query\", fixtureRequestID, 1, `{}`), \"operation_unknown\", \"\"},\n64|\t\t{\"bad request id\", fixtureRequestFrame(\"2.0.0\", \"manifest\", \"not-a-uuid\", 1, `{}`), \"adapter_protocol_violation\", \"request_id\"},\n65|\t\t{\"zero deadline\", fixtureRequestFrame(\"2.0.0\", \"manifest\", fixtureRequestID, 0, `{}`), \"adapter_protocol_violation\", \"deadline_ms\"},\n66|\t\t{\"deadline past bound\", fixtureRequestFrame(\"2.0.0\", \"manifest\", fixtureRequestID, 3600001, `{}`), \"adapter_protocol_violation\", \"deadline_ms\"},\n67|\t\t{\"non object body\", fixtureRequestFrame(\"2.0.0\", \"manifest\", fixtureRequestID, 1, `[]`), \"adapter_protocol_violation\", \"body\"},\n68|\t} {\n69|\t\tframe := probe.frame\n70|\t\tif probe.name == \"relabeled major pair\" {\n71|\t\t\traw := string(fixtureRequestFrame(\"2.0.0\", \"manifest\", fixtureRequestID, 1, `{}`))\n72|\t\t\traw = replaceOnce(t, raw, `\"protocol_version\":\"2.0.0\"`, `\"protocol_version\":\"1.0.0\"`, 1)\n73|\t\t\tframe = []byte(raw)\n74|\t\t}\n75|\t\tt.Run(probe.name, func(t *testing.T) {\n76|\t\t\tt.Parallel()\n77|\t\t\t_, err := DecodeRequestFrame(frame)\n78|\t\t\tfailure := requireCode(t, err, probe.code)\n79|\t\t\tif probe.member != \"\" {\n80|\t\t\t\tdetail, _ := failure.Detail(\"member\")\n81|\t\t\t\tif detail != probe.member {\n82|\t\t\t\t\tt.Fatalf(\"refusal detail member = %v, want %q\", detail, probe.member)\n83|\t\t\t\t}\n84|\t\t\t}\n85|\t\t})\n86|\t}\n87|}\n88|\n89|// TestEncodeRequestRoundTrip drives the production request builder\n90|// and requires its output to validate through the production\n91|// decoder with identical fields.\n92|func TestEncodeRequestRoundTrip(t *testing.T) {\n93|\tt.Parallel()\n94|\tfor _, major := range SupportedMajors() {\n95|\t\tframe, err := EncodeRequest(major, OpProbe, fixtureRequestID, 1000, []byte(fixtureProbeRequestV2()))\n96|\t\tif err != nil {\n97|\t\t\tt.Fatalf(\"EncodeRequest(%d) error = %v\", major, err)\n98|\t\t}\n99|\t\trequest, err := DecodeRequestFrame(frame)\n100|\t\tif err != nil {\n101|\t\t\tt.Fatalf(\"DecodeRequestFrame(EncodeRequest(%d)) error = %v\", major, err)\n102|\t\t}\n103|\t\tif request.Major != major || request.Operation != OpProbe || request.RequestID != fixtureRequestID {\n104|\t\t\tt.Fatalf(\"round trip(%d) = %+v\", major, request)\n105|\t\t}\n106|\t}\n107|}\n108|\n109|// TestEncodeRequestRefusals drives the production builder with\n110|// caller defects: an unsupported major is invalid_config, an\n111|// unknown operation is operation_unknown, and bound defects refuse\n112|// before any byte is emitted.\n113|func TestEncodeRequestRefusals(t *testing.T) {\n114|\tt.Parallel()\n115|\tif _, err := EncodeRequest(3, OpManifest, fixtureRequestID, 1, []byte(`{}`)); requireCode(t, err, \"invalid_config\") == nil {\n116|\t\tt.Fatal(\"EncodeRequest(3) must refuse\")\n117|\t}\n118|\tif _, err := EncodeRequest(MajorV2, \"query\", fixtureRequestID, 1, []byte(`{}`)); requireCode(t, err, \"operation_unknown\") == nil {\n119|\t\tt.Fatal(\"EncodeRequest(query) must refuse\")\n120|\t}\n121|\tif _, err := EncodeRequest(MajorV2, OpManifest, \"bad\", 1, []byte(`{}`)); requireCode(t, err, \"invalid_config\") == nil {\n122|\t\tt.Fatal(\"EncodeRequest(bad id) must refuse\")\n123|\t}\n124|\tif _, err := EncodeRequest(MajorV2, OpManifest, fixtureRequestID, 0, []byte(`{}`)); requireCode(t, err, \"invalid_config\") == nil {\n125|\t\tt.Fatal(\"EncodeRequest(zero deadline) must refuse\")\n126|\t}\n127|\tif _, err := EncodeRequest(MajorV2, OpManifest, fixtureRequestID, 1, []byte(`[]`)); requireCode(t, err, \"adapter_protocol_violation\") == nil {\n128|\t\tt.Fatal(\"EncodeRequest(non-object body) must refuse\")\n129|\t}\n130|}\n131|\n132|// TestDecodeRequestFrameStrictFaults drives the production\n133|// request entry through the strict-decoder faults: invalid\n134|// UTF-8, a lone surrogate escape, trailing data, and a lone\n135|// top-level value are faults, never partial objects.\n136|func TestDecodeRequestFrameStrictFaults(t *testing.T) {\n137|\tt.Parallel()\n138|\tgood := string(fixtureRequestFrame(\"2.0.0\", \"manifest\", fixtureRequestID, 1, `{}`))\n139|\tfor _, probe := range []struct {\n140|\t\tname  string\n141|\t\tframe []byte\n142|\t}{\n143|\t\t{\"invalid utf8\", []byte{0xff, 0xfe}},\n144|\t\t{\"lone surrogate\", []byte(replaceOnce(t, good, `\"manifest\"`, `mani\\ud800fest`, 1))},\n145|\t\t{\"trailing data\", []byte(good + \" {}\")},\n146|\t\t{\"empty after trim\", []byte(\"   \")},\n(more lines below)"}}}
