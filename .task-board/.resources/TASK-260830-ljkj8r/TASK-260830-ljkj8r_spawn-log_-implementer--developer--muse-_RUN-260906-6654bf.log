{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c575","stream":{"kind":"session","id":"01a07573-a73b-7be0-abe2-6029bca74ffd"},"sequence":277,"recorded_at":1780531400000549,"record_type":"event","durability":"durable","causation_id":"65c281d8-14aa-4def-b705-62e70b4fce66","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"65c281d8-14aa-4def-b705-62e70b4fce66","run_stream":{"kind":"run","id":"65c281d8-14aa-4def-b705-62e70b4fce66"},"task_stream":{"kind":"task","id":"ee00c114-1805-44f9-a0c5-f54f055a4b9a"},"task_id":"ee00c114-1805-44f9-a0c5-f54f055a4b9a","event":{"kind":"output","task_id":"ee00c114-1805-44f9-a0c5-f54f055a4b9a","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/dirnode/query_test.go`.\n(99 line(s) above)\n100|func TestDecodeQueryRegistryRules(t *testing.T) {\n101|\tt.Parallel()\n102|\tgood := fixtureQueryJSON()\n103|\tfor _, probe := range []struct {\n104|\t\tname string\n105|\t\tbody string\n106|\t}{\n107|\t\t{\"unknown operation\", replaceOnce(t, good, `\"name\":\"sessions\"`, `\"name\":\"search\"`, 1)},\n108|\t\t{\"unknown parameter\", replaceOnce(t, good, `\"filters\":{\"kinds\"`, `\"filters\":{\"kindsX\"`, 1)},\n109|\t\t{\"unknown filter\", replaceOnce(t, good, `\"freshness\":[]`, `\"freshness\":[],\"fuzz\":[]`, 1)},\n110|\t\t{\"unknown field\", replaceOnce(t, good, `\"preset\":\"overview\"`, `\"fields\":[\"nope\"],\"preset\":null`, 1)},\n111|\t\t{\"unknown preset\", replaceOnce(t, good, `\"preset\":\"overview\"`, `\"preset\":\"everything\"`, 1)},\n112|\t\t{\"unknown sort field\", replaceOnce(t, good, `\"field\":\"stable_id\"`, `\"field\":\"vibes\"`, 1)},\n113|\t\t{\"unknown sort direction\", replaceOnce(t, good, `\"direction\":\"asc\"`, `\"direction\":\"sideways\"`, 1)},\n114|\t\t{\"fields and preset together\", replaceOnce(t, good, `\"fields\":null,\"preset\":\"overview\"`, `\"fields\":[\"id\"],\"preset\":\"overview\"`, 1)},\n115|\t\t{\"bad filter enum\", replaceOnce(t, good, `\"reachability\":[]`, `\"reachability\":[\"everywhere\"]`, 1)},\n116|\t\t{\"bad provider id\", replaceOnce(t, good, `\"provider_ids\":[]`, `\"provider_ids\":[\"BAD\"]`, 1)},\n117|\t} {\n118|\t\tt.Run(probe.name, func(t *testing.T) {\n119|\t\t\tt.Parallel()\n120|\t\t\tif _, err := DecodeQuery([]byte(probe.body)); requireCode(t, err, \"query_invalid\") == nil {\n121|\t\t\t\tt.Fatal(\"must refuse\")\n122|\t\t\t}\n123|\t\t})\n124|\t}\n125|}\n126|\n127|// mutationBatch builds a one-operation mutation batch with the\n128|// given parameters, flags, and digests for the flag-rule tests.\n129|func mutationBatch(name, parameters string, dryRun, confirm bool, expectation, idempotency string) string {\n130|\treturn `{\"schema\":\"urn:ax:schema:session-directory-query\",\"schema_version\":\"1.0.0\",\"query_id\":\"` + fixtureQueryID + `\",\"operations\":[{\"operation_index\":0,\"name\":\"` + name + `\",\"parameters\":` + parameters + `,\"fields\":null,\"preset\":null,\"skip\":0,\"take\":1,\"sort\":[],\"dry_run\":` + boolString(dryRun) + `,\"confirm\":` + boolString(confirm) + `,\"expectation_digest\":` + expectation + `,\"idempotency_key\":` + idempotency + `,\"extensions\":{}}],\"caller\":` + fixtureCallerJSON() + `,\"extensions\":{}}`\n131|}\n132|\n133|func boolString(value bool) string {\n134|\tif value {\n135|\t\treturn \"true\"\n136|\t}\n137|\treturn \"false\"\n138|}\n139|\n140|// TestDecodeQueryMutationFlagRules drives the production query\n141|// entry through the mutation flag rules: dry run xor confirm,\n142|// execute_plan requiring confirm plus both digests, annotation\n143|// mutations requiring both digests when confirmed, and\n144|// plan_continue requiring pure dry run.\n145|func TestDecodeQueryMutationFlagRules(t *testing.T) {\n146|\tt.Parallel()\n147|\ttitle := `{\"subject_kind\":\"ax_session\",\"subject_id\":\"` + fixtureQueryID + `\",\"title\":\"T\",\"supersedes_annotation_ids\":[],\"extensions\":{}}`\n148|\tdigest := `\"` + fixtureBatchDigest + `\"`\n149|\texecute := `{\"plan_id\":` + digest + `,\"operation_id\":\"` + fixtureOperationID + `\",\"confirmations\":[],\"extensions\":{}}`\n150|\tcontinueParams := `{\"subject_kind\":\"ax_session\",\"subject_id\":\"` + fixtureQueryID + `\",\"source_instance_id\":` + digest + `,\"to_host_id\":\"` + fixtureOriginHost + `\",\"to_installation_id\":` + digest + `,\"intent\":\"resume\",\"workspace_policy\":\"exact_checkpoint\",\"source_after_success\":\"retain\",\"extensions\":{}}`\n151|\tfor _, probe := range []struct {\n152|\t\tname    string\n153|\t\tbody    string\n154|\t\trefuses bool\n155|\t}{\n156|\t\t{\"dry run title plans\", mutationBatch(\"set_title\", title, true, false, \"null\", \"null\"), false},\n157|\t\t{\"confirmed title without digests\", mutationBatch(\"set_title\", title, false, true, \"null\", \"null\"), true},\n158|\t\t{\"confirmed title with digests\", mutationBatch(\"set_title\", title, false, true, digest, digest), false},\n159|\t\t{\"both flags\", mutationBatch(\"set_title\", title, true, true, digest, digest), true},\n160|\t\t{\"neither flag\", mutationBatch(\"set_title\", title, false, false, \"null\", \"null\"), true},\n161|\t\t{\"execute plan confirmed with digests\", mutationBatch(\"execute_plan\", execute, false, true, digest, digest), false},\n162|\t\t{\"execute plan dry run\", mutationBatch(\"execute_plan\", execute, true, false, \"null\", \"null\"), true},\n163|\t\t{\"execute plan missing digests\", mutationBatch(\"execute_plan\", execute, false, true, \"null\", digest), true},\n164|\t\t{\"plan continue dry run\", mutationBatch(\"plan_continue\", continueParams, true, false, \"null\", \"null\"), false},\n165|\t\t{\"plan continue confirmed\", mutationBatch(\"plan_continue\", continueParams, false, true, \"null\", \"null\"), true},\n166|\t\t{\"read with dry run\", replaceOnce(t, fixtureQueryJSON(), `\"dry_run\":false,\"confirm\":false`, `\"dry_run\":true,\"confirm\":false`, 1), true},\n167|\t} {\n168|\t\tt.Run(probe.name, func(t *testing.T) {\n169|\t\t\tt.Parallel()\n170|\t\t\t_, err := DecodeQuery([]byte(probe.body))\n171|\t\t\tif probe.refuses && err == nil {\n172|\t\t\t\tt.Fatal(\"must refuse\")\n173|\t\t\t}\n174|\t\t\tif !probe.refuses && err != nil {\n175|\t\t\t\tt.Fatalf(\"must admit: %v\", err)\n176|\t\t\t}\n177|\t\t\tif probe.refuses {\n178|\t\t\t\trequireCode(t, err, \"query_invalid\")\n179|\t\t\t}\n180|\t\t})\n181|\t}\n182|}\n183|\n184|// TestDecodeQueryPaginationRules drives the production query\n185|// entry through the skip/take rule: list operations page, while\n186|// the schema read requires skip=0 and take=1.\n187|func TestDecodeQueryPaginationRules(t *testing.T) {\n188|\tt.Parallel()\n189|\tpaged := replaceOnce(t, fixtureQueryJSON(), `\"skip\":0,\"take\":10`, `\"skip\":5,\"take\":10`, 1)\n190|\tif _, err := DecodeQuery([]byte(paged)); err != nil {\n191|\t\tt.Fatalf(\"paged sessions must admit: %v\", err)\n192|\t}\n193|\tunpaged := replaceOnce(t, fixtureQueryJSON(), `\"skip\":0,\"take\":1,\"sort\":[],\"dry_run\":false,\"confirm\":false,\"expectation_digest\":null,\"idempotency_key\":null,\"extensions\":{}},{\"operation_index\":1`, `\"skip\":1,\"take\":1,\"sort\":[],\"dry_run\":false,\"confirm\":false,\"expectation_digest\":null,\"idempotency_key\":null,\"extensions\":{}},{\"operation_index\":1`, 1)\n194|\tif _, err := DecodeQuery([]byte(unpaged)); requireCode(t, err, \"query_invalid\") == nil {\n195|\t\tt.Fatal(\"schema read with skip must refuse\")\n196|\t}\n197|}\n198|\n199|// TestCheckCursorReuse drives the production cursor entry: a\n200|// well-formed cursor admits under unchanged bounds, reuse after\n201|// any bound change refuses with query_invalid, and a malformed\n202|// cursor refuses before any bound is consulted.\n203|func TestCheckCursorReuse(t *testing.T) {\n204|\tt.Parallel()\n205|\tif err := CheckCursorReuse(\"opaque-cursor\", false); err != nil {\n206|\t\tt.Fatalf(\"CheckCursorReuse(unchanged) error = %v\", err)\n207|\t}\n208|\trequireCode(t, CheckCursorReuse(\"opaque-cursor\", true), \"query_invalid\")\n209|\trequireCode(t, CheckCursorReuse(\"\", false), \"query_invalid\")\n210|\trequireCode(t, CheckCursorReuse(strings.Repeat(\"x\", 1025), false), \"query_invalid\")\n211|}"}}}
