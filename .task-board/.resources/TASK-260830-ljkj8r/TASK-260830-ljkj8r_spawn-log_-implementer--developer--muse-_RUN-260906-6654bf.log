{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7c3","stream":{"kind":"session","id":"01a07573-a73b-7be0-abe2-6029bca74ffd"},"sequence":572,"recorded_at":1780531400001139,"record_type":"event","durability":"durable","causation_id":"65c281d8-14aa-4def-b705-62e70b4fce66","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"65c281d8-14aa-4def-b705-62e70b4fce66","run_stream":{"kind":"run","id":"65c281d8-14aa-4def-b705-62e70b4fce66"},"call_id":"call_01a0757506437ed397d5367a0a181957","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/dirnode/manifest.go`.\n(499 line(s) above)\n500|\t\t\treturn nil, false\n501|\t\t}\n502|\t\tif name, missing := missingMember(members, assertionRequired); missing {\n503|\t\t\t_ = name\n504|\t\t\treturn nil, false\n505|\t\t}\n506|\t\tidentifier, ok := rawString(members[\"contract_id\"])\n507|\t\tif !ok || !checkURI(identifier) {\n508|\t\t\treturn nil, false\n509|\t\t}\n510|\t\tversion, ok := rawString(members[\"exact_version\"])\n511|\t\tif !ok || !checkSemver(version) {\n512|\t\t\treturn nil, false\n513|\t\t}\n514|\t\tif !checkExtensions(members[\"extensions\"]) {\n515|\t\t\treturn nil, false\n516|\t\t}\n517|\t\tcanonical, err := canonicaljson.Canonicalize(bytesTrimSpace(element))\n518|\t\tif err != nil {\n519|\t\t\treturn nil, false\n520|\t\t}\n521|\t\tassertions = append(assertions, ContractAssertion{ContractID: identifier, ExactVersion: version})\n522|\t\tencodings = append(encodings, string(canonical))\n523|\t}\n524|\tfor index := 1; index < len(encodings); index++ {\n525|\t\tif encodings[index-1] >= encodings[index] {\n526|\t\t\treturn nil, false\n527|\t\t}\n528|\t}\n529|\treturn assertions, true\n530|}\n531|\n532|// checkCapabilities reports whether the member is an object with\n533|// exactly the eight registry keys, each a closed CapabilityResult\n534|// with coherent reason: available carries a null reason and every\n535|// other status requires one. The coherence runs both ways: a null\n536|// reason on a non-available status and a set reason on an\n537|// available status both refuse.\n538|func checkCapabilities(raw json.RawMessage) (map[string]Capability, bool) {\n539|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n540|\tif fault != nil {\n541|\t\treturn nil, false\n542|\t}\n543|\tif len(members) != len(capabilityOrder) {\n544|\t\treturn nil, false\n545|\t}\n546|\tcapabilities := make(map[string]Capability, len(capabilityOrder))\n547|\tfor _, name := range capabilityOrder {\n548|\t\tmember, present := members[name]\n549|\t\tif !present {\n550|\t\t\treturn nil, false\n551|\t\t}\n552|\t\tcapability, ok := checkCapability(member)\n553|\t\tif !ok {\n554|\t\t\treturn nil, false\n555|\t\t}\n556|\t\tcapabilities[name] = capability\n557|\t}\n558|\treturn capabilities, true\n559|}\n560|\n561|// checkCapability validates one CapabilityResult object.\n562|func checkCapability(raw json.RawMessage) (Capability, bool) {\n563|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n564|\tif fault != nil {\n565|\t\treturn Capability{}, false\n566|\t}\n567|\tif name, unknown := unknownMember(members, capabilityMembers); unknown {\n568|\t\t_ = name\n569|\t\treturn Capability{}, false\n570|\t}\n571|\tif name, missing := missingMember(members, capabilityRequired); missing {\n572|\t\t_ = name\n573|\t\treturn Capability{}, false\n574|\t}\n575|\tstatus, ok := rawString(members[\"status\"])\n576|\tif !ok || !validCapabilityStatus(status) {\n577|\t\treturn Capability{}, false\n578|\t}\n579|\treason, reasonNull := members[\"reason_code\"]\n580|\thasReason := false\n581|\tvar reasonCode string\n582|\tif reasonNull && isNull(reason) {\n583|\t\thasReason = false\n584|\t} else {\n585|\t\tvalue, ok := checkStringBounds(reason, 1, 128)\n586|\t\tif !ok {\n587|\t\t\treturn Capability{}, false\n588|\t\t}\n589|\t\thasReason = true\n590|\t\treasonCode = value\n591|\t}\n592|\tif status == \"available\" && hasReason {\n593|\t\treturn Capability{}, false\n594|\t}\n595|\tif status != \"available\" && !hasReason {\n596|\t\treturn Capability{}, false\n597|\t}\n598|\tevidence, ok := checkSortedUniqueDigests(members[\"evidence_ids\"], 0, 64)\n599|\tif !ok {\n600|\t\treturn Capability{}, false\n601|\t}\n602|\tobserved, ok := checkTimestamp(members[\"observed_at\"])\n603|\tif !ok {\n604|\t\treturn Capability{}, false\n605|\t}\n606|\tif !checkExtensions(members[\"extensions\"]) {\n607|\t\treturn Capability{}, false\n608|\t}\n609|\treturn Capability{\n610|\t\tStatus:     status,\n611|\t\tReasonCode: reasonCode,\n612|\t\tHasReason:  hasReason,\n613|\t\tEvidence:   digestStrings(evidence),\n614|\t\tObservedAt: observed.String(),\n615|\t}, true\n616|}\n617|\n618|// checkLimits validates one DirectoryNodeLimits object against the\n619|// seven manifest bounds plus the frame ceiling: a limits object\n620|// admitting frames larger than the 8 MiB transport bound would\n621|// license an oversize line.\n622|func checkLimits(raw json.RawMessage) (Limits, bool) {\n623|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n624|\tif fault != nil {\n625|\t\treturn Limits{}, false\n626|\t}\n627|\tif name, unknown := unknownMember(members, limitsMembers); unknown {\n628|\t\t_ = name\n629|\t\treturn Limits{}, false\n630|\t}\n631|\tif name, missing := missingMember(members, limitsRequired); missing {\n632|\t\t_ = name\n633|\t\treturn Limits{}, false\n634|\t}\n635|\tframe, ok := checkUint53Bounds(members[\"max_frame_bytes\"], 1, MaxFrameBytes)\n636|\tif !ok {\n637|\t\treturn Limits{}, false\n638|\t}\n639|\tinstances, ok := checkUint53Bounds(members[\"max_scan_instances\"], 1, 65536)\n640|\tif !ok {\n641|\t\treturn Limits{}, false\n642|\t}\n643|\ttake, ok := checkUint53Bounds(members[\"max_inventory_take\"], 1, 1000)\n644|\tif !ok {\n645|\t\treturn Limits{}, false\n646|\t}\n647|\texcerptCount, ok := checkUint53Bounds(members[\"max_excerpt_count\"], 0, 20)\n648|\tif !ok {\n649|\t\treturn Limits{}, false\n650|\t}\n651|\texcerptBytes, ok := checkUint53Bounds(members[\"max_excerpt_bytes\"], 0, 4096)\n652|\tif !ok {\n653|\t\treturn Limits{}, false\n654|\t}\n655|\tenrichmentEvents, ok := checkUint53Bounds(members[\"max_enrichment_events\"], 1, 5000)\n656|\tif !ok {\n657|\t\treturn Limits{}, false\n658|\t}\n659|\tenrichmentBytes, ok := checkUint53Bounds(members[\"max_enrichment_bytes\"], 1, 4194304)\n660|\tif !ok {\n661|\t\treturn Limits{}, false\n662|\t}\n663|\tif !checkExtensions(members[\"extensions\"]) {\n664|\t\treturn Limits{}, false\n665|\t}\n666|\treturn Limits{\n667|\t\tMaxFrameBytes:      frame,\n668|\t\tMaxScanInstances:   instances,\n669|\t\tMaxInventoryTake:   take,\n670|\t\tMaxExcerptCount:    excerptCount,\n671|\t\tMaxExcerptBytes:    excerptBytes,\n672|\t\tMaxEnrichmentEvent: enrichmentEvents,\n673|\t\tMaxEnrichmentBytes: enrichmentBytes,\n674|\t}, true\n675|}\n676|\n677|// digestStrings renders validated digests in order.\n678|func digestStrings(digests []scalar.Digest) []string {\n679|\tout := make([]string, 0, len(digests))\n680|\tfor _, digest := range digests {\n681|\t\tout = append(out, digest.String())\n682|\t}\n683|\treturn out\n684|}\n685|\n686|// bytesTrimSpace trims JSON-insignificant whitespace around a raw\n687|// member. Members arrive untrimmed from the strict decoder; object\n688|// and array checks below accept surrounding whitespace, but the\n689|// canonicalizer and the duplicate scan need the exact span, so the\n690|// trim happens at each nested-object entry point, never by\n691|// rewriting the parent frame.\n692|func bytesTrimSpace(raw json.RawMessage) []byte {\n693|\treturn bytes.TrimSpace(raw)\n694|}\n695|\n696|// ManifestDigest returns the host-computed JCS SHA-256 of the\n697|// validated manifest. It is computed by the host, never embedded by\n698|// the node, so a manifest that names its own digest cannot mint\n699|// trust.\n700|func ManifestDigest(manifest Manifest) scalar.Digest {\n701|\treturn scalar.SHA256Digest(manifest.canonical)\n702|}\n703|\n704|// ObservedFacade is the independently observed executable facts the\n705|// manifest bindings must agree with: the host-observed executable\n706|// digest and the provider and adapter manifest digests from their\n707|// own discovery, never from the node.\n708|type ObservedFacade struct {\n709|\tExecutableSHA256       string\n710|\tProviderManifestDigest string\n711|\tSessionAdapterDigest   string\n712|}\n713|\n714|// CheckManifestBindings requires the manifest's three façade\n715|// bindings to equal the independently observed facts. A\n716|// contradiction is an integrity failure, not a usable node: the\n717|// three façade executable/module bindings and the tuple\n718|// declarations must agree, and agreement with observed facts is\n719|// what makes the manifest this node's. A failed or partial\n720|// observation never means the candidate is absent.\n721|func CheckManifestBindings(manifest Manifest, observed ObservedFacade) error {\n722|\tif _, ok := checkDigestString(observed.ExecutableSHA256); !ok {\n723|\t\tfailure, err := failInvalid(\"observed executable digest is not a digest\", \"executable_sha256\")\n724|\t\tif err != nil {\n725|\t\t\treturn err\n726|\t\t}\n727|\t\treturn failure\n728|\t}\n729|\tif _, ok := checkDigestString(observed.ProviderManifestDigest); !ok {\n730|\t\tfailure, err := failInvalid(\"observed provider manifest digest is not a digest\", \"provider_manifest_digest\")\n731|\t\tif err != nil {\n732|\t\t\treturn err\n733|\t\t}\n734|\t\treturn failure\n735|\t}\n736|\tif _, ok := checkDigestString(observed.SessionAdapterDigest); !ok {\n737|\t\tfailure, err := failInvalid(\"observed adapter manifest digest is not a digest\", \"session_adapter_manifest_digest\")\n738|\t\tif err != nil {\n739|\t\t\treturn err\n740|\t\t}\n741|\t\treturn failure\n742|\t}\n743|\tif manifest.ExecutableSHA256 != observed.ExecutableSHA256 {\n744|\t\tfailure, err := failIntegrity(\"node manifest executable binding contradicts the observed executable\", \"executable_sha256\")\n745|\t\tif err != nil {\n746|\t\t\treturn err\n747|\t\t}\n748|\t\treturn failure\n749|\t}\n750|\tif manifest.ProviderManifestDigest != observed.ProviderManifestDigest {\n751|\t\tfailure, err := failIntegrity(\"node manifest provider binding contradicts the observed manifest\", \"provider_manifest_digest\")\n752|\t\tif err != nil {\n753|\t\t\treturn err\n754|\t\t}\n755|\t\treturn failure\n756|\t}\n757|\tif manifest.AdapterManifestDigest != observed.SessionAdapterDigest {\n758|\t\tfailure, err := failIntegrity(\"node manifest adapter binding contradicts the observed manifest\", \"session_adapter_manifest_digest\")\n759|\t\tif err != nil {\n760|\t\t\treturn err\n761|\t\t}\n762|\t\treturn failure\n763|\t}\n764|\treturn nil\n765|}\n766|\n767|// AvailableCapabilities returns the manifest capabilities with\n768|// status available, in registry order. Conditional, unavailable,\n769|// and unknown are never upgraded: the Section 8.1 labels are not\n770|// aliases, so a non-available status is reported by omission, and\n771|// a caller that needs the reason reads the manifest map.\n772|func AvailableCapabilities(manifest Manifest) []string {\n773|\tvar out []string\n774|\tfor _, name := range capabilityOrder {\n775|\t\tif capability, present := manifest.Capabilities[name]; present && capability.Status == \"available\" {\n776|\t\t\tout = append(out, name)\n777|\t\t}\n778|\t}\n779|\treturn out\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7c5","stream":{"kind":"session","id":"01a07573-a73b-7be0-abe2-6029bca74ffd"},"sequence":573,"recorded_at":1780531400001141,"record_type":"event","durability":"durable","causation_id":"65c281d8-14aa-4def-b705-62e70b4fce66","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"65c281d8-14aa-4def-b705-62e70b4fce66","run_stream":{"kind":"run","id":"65c281d8-14aa-4def-b705-62e70b4fce66"},"call_id":"call_01a0757507aa79e3a0a4fe52687a000e","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/bound_census_test.go`.\n(399 line(s) above)\n400|\t\t\tfor index, lhs := range node.Lhs {\n401|\t\t\t\t// A non-ident target (a selector, an index)\n402|\t\t\t\t// holds no variable; its paired value is\n403|\t\t\t\t// simply unattributed.\n404|\t\t\t\tident, _ := lhs.(*ast.Ident)\n405|\t\t\t\tnames[index] = ident\n406|\t\t\t}\n407|\t\t\tbindIdents(names, node.Rhs)\n408|\t\tcase *ast.ValueSpec:\n409|\t\t\tbindIdents(node.Names, node.Values)\n410|\t\t}\n411|\t\treturn true\n412|\t})\n413|\treturn vars\n414|}\n415|\n416|// mentionsLengthVar reports whether the subtree reads one of the\n417|// collected length variables.\n418|func mentionsLengthVar(node ast.Node, vars map[string]bool) bool {\n419|\tfound := false\n420|\tast.Inspect(node, func(inner ast.Node) bool {\n421|\t\tif ident, ok := inner.(*ast.Ident); ok && vars[ident.Name] {\n422|\t\t\tfound = true\n423|\t\t\treturn false\n424|\t\t}\n425|\t\treturn true\n426|\t})\n427|\treturn found\n428|}\n429|\n430|// boundHelperIndirections reports every func-value indirection\n431|// of the six bound helpers in one parsed file: any use of a\n432|// helper name that is neither a direct call (the identifier is\n433|// the Fun of its enclosing call) nor one of the six function\n434|// definitions. The rule is positional, so it covers var and :=\n435|// bindings at package and function scope, plain assignments,\n436|// arguments, and return values uniformly — the same shape as the\n437|// constructor census indirection check it is ported from.\n438|func boundHelperIndirections(syntax *ast.File) []string {\n439|\tdefinitions := map[*ast.Ident]bool{}\n440|\tfor _, declaration := range syntax.Decls {\n441|\t\tfunction, ok := declaration.(*ast.FuncDecl)\n442|\t\tif !ok || !boundHelpers[function.Name.Name] {\n443|\t\t\tcontinue\n444|\t\t}\n445|\t\tdefinitions[function.Name] = true\n446|\t}\n447|\tvar violations []string\n448|\tvar stack []ast.Node\n449|\tast.Inspect(syntax, func(node ast.Node) bool {\n450|\t\tif node == nil {\n451|\t\t\tstack = stack[:len(stack)-1]\n452|\t\t\treturn true\n453|\t\t}\n454|\t\tif ident, ok := node.(*ast.Ident); ok && boundHelpers[ident.Name] {\n455|\t\t\tif !definitions[ident] && !isDirectBoundCall(stack, ident) {\n456|\t\t\t\tviolations = append(violations, \"func-value indirection of \"+ident.Name+\"; bounds built through it hide from the bound census\")\n457|\t\t\t}\n458|\t\t}\n459|\t\tstack = append(stack, node)\n460|\t\treturn true\n461|\t})\n462|\treturn violations\n463|}\n464|\n465|// isDirectBoundCall reports whether the identifier is the\n466|// function of the call enclosing it: the stack top is a call\n467|// whose Fun is this identifier. Anything else holding the name\n468|// — a value spec, an assignment, an argument, a return — is an\n469|// alias, not a bound.\n470|func isDirectBoundCall(stack []ast.Node, ident *ast.Ident) bool {\n471|\tif len(stack) == 0 {\n472|\t\treturn false\n473|\t}\n474|\tcall, ok := stack[len(stack)-1].(*ast.CallExpr)\n475|\treturn ok && call.Fun == ast.Expr(ident)\n476|}\n477|\n478|// boundMemberOf names the bounded member of one helper call: the\n479|// string-literal member for the require wrappers, the indexed\n480|// member name for direct checks, or the rendered expression when\n481|// the call bounds a computed value (element, identifier,\n482|// members[name]).\n483|func boundMemberOf(call *ast.CallExpr, helper string) string {\n484|\tif len(call.Args) == 0 {\n485|\t\treturn \"noargs\"\n486|\t}\n487|\tvar first ast.Expr\n488|\tif helper == \"requireStringBounds\" || helper == \"requireUint53Bounds\" {\n489|\t\tif len(call.Args) < 2 {\n490|\t\t\treturn \"short\"\n491|\t\t}\n492|\t\tfirst = call.Args[1]\n493|\t} else {\n494|\t\tfirst = call.Args[0]\n495|\t}\n496|\tif literal, ok := first.(*ast.BasicLit); ok && literal.Kind == token.STRING {\n497|\t\treturn literal.Value\n498|\t}\n499|\tif index, ok := first.(*ast.IndexExpr); ok {\n500|\t\tif literal, ok := index.Index.(*ast.BasicLit); ok && literal.Kind == token.STRING {\n501|\t\t\treturn literal.Value\n502|\t\t}\n503|\t}\n504|\treturn renderBoundExpr(first)\n505|}\n506|\n507|// renderBoundExpr renders one bound expression deterministically.\n508|func renderBoundExpr(node ast.Node) string {\n509|\tvar buffer bytes.Buffer\n510|\tif err := printer.Fprint(&buffer, token.NewFileSet(), node); err != nil {\n511|\t\treturn \"RENDER-ERR\"\n512|\t}\n513|\treturn buffer.String()\n514|}\n515|\n516|// normalizeBoundNumbers replaces standalone integer literals in\n517|// a rendered len guard with N, so the census rosters the guard\n518|// shape rather than its bound values: a moved bound keeps its\n519|// identity and must redden its behavioral driver. Identifiers\n520|// holding digits (uint64, MaxFrameBytes) are untouched.\n521|func normalizeBoundNumbers(rendered string) string {\n522|\tvar out strings.Builder\n523|\tfor i := 0; i < len(rendered); {\n524|\t\tc := rendered[i]\n525|\t\tif c >= '0' && c <= '9' && (i == 0 || !isBoundIdentChar(rendered[i-1])) {\n526|\t\t\tj := i\n527|\t\t\tfor j < len(rendered) && rendered[j] >= '0' && rendered[j] <= '9' {\n528|\t\t\t\tj++\n529|\t\t\t}\n530|\t\t\tif j >= len(rendered) || !isBoundIdentChar(rendered[j]) {\n531|\t\t\t\tout.WriteString(\"N\")\n532|\t\t\t\ti = j\n533|\t\t\t\tcontinue\n534|\t\t\t}\n535|\t\t}\n536|\t\tout.WriteByte(c)\n537|\t\ti++\n538|\t}\n539|\treturn out.String()\n540|}\n541|\n542|// isBoundIdentChar reports whether the byte continues a Go\n543|// identifier.\n544|func isBoundIdentChar(c byte) bool {\n545|\treturn c == '_' || c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9'\n546|}\n547|\n548|// hasLenCall reports whether the subtree calls len.\n549|func hasLenCall(node ast.Node) bool {\n550|\tfound := false\n551|\tast.Inspect(node, func(inner ast.Node) bool {\n552|\t\tcall, ok := inner.(*ast.CallExpr)\n553|\t\tif ok {\n554|\t\t\tif ident, ok := call.Fun.(*ast.Ident); ok && ident.Name == \"len\" {\n555|\t\t\t\tfound = true\n556|\t\t\t\treturn false\n557|\t\t\t}\n558|\t\t}\n559|\t\treturn true\n560|\t})\n561|\treturn found\n562|}\n563|\n564|// boundRegistrations rosters every derived site. driver names the\n565|// committed test proving the edges at the production entry;\n566|// exempt rows carry the rationale instead. Ordinals disambiguate\n567|// repeated members in one function: checkRequestScalars carries\n568|// four expected_target_native_session_id bounds (ordinal 0\n569|// projection-plan, 1 read-back, 2 validate-nullable, 3\n570|// resume-plan) and checkSuccessScalars three\n571|// source_store_generation bounds (ordinal 0 inspect, 1\n572|// capture-plan, 2 capture).\n573|var boundRegistrations = []boundRegistration{\n574|\t// context.go: direct checks with existing drivers.\n575|\t{id: `context.go|DecodeCapturePlanItem|checkStringBounds|\"native_item_key\"|0`, driver: \"TestStringBoundEdges\", reason: \"capture item key 1..512\"},\n576|\t{id: `context.go|DecodeFinding|checkStringBounds|\"code\"|0`, driver: \"TestStringBoundEdges\", reason: \"finding code 1..128\"},\n577|\t{id: `context.go|DecodeFinding|checkStringBounds|\"message\"|0`, driver: \"TestStringBoundEdges\", reason: \"finding message 1..4096\"},\n578|\t{id: `context.go|DecodeFinding|checkStringBounds|\"remediation\"|0`, driver: \"TestStringBoundEdges\", reason: \"finding remediation 1..4096\"},\n579|\t{id: `context.go|DecodeSourceSelector|checkStringBounds|\"native_session_id\"|0`, driver: \"TestStringBoundEdges\", reason: \"selector session id 1..512\"},\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
