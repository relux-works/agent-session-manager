{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c52b","stream":{"kind":"session","id":"01a07573-a73b-7be0-abe2-6029bca74ffd"},"sequence":240,"recorded_at":1780531400000475,"record_type":"event","durability":"durable","causation_id":"65c281d8-14aa-4def-b705-62e70b4fce66","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"65c281d8-14aa-4def-b705-62e70b4fce66","run_stream":{"kind":"run","id":"65c281d8-14aa-4def-b705-62e70b4fce66"},"task_stream":{"kind":"task","id":"59bf932d-7246-41f9-91c2-970b9c276dbe"},"task_id":"59bf932d-7246-41f9-91c2-970b9c276dbe","event":{"kind":"output","task_id":"59bf932d-7246-41f9-91c2-970b9c276dbe","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/dirnode/query_test.go`.\n1|package dirnode\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|)\n7|\n8|// TestDecodeQueryAcceptsFixture drives the production query entry\n9|// with the exact contract vector: the batch identifier, the two\n10|// position-indexed operations with their halves, and the caller.\n11|func TestDecodeQueryAcceptsFixture(t *testing.T) {\n12|\tt.Parallel()\n13|\tquery, err := DecodeQuery([]byte(fixtureQueryJSON()))\n14|\tif err != nil {\n15|\t\tt.Fatalf(\"DecodeQuery error = %v\", err)\n16|\t}\n17|\tif query.QueryID != fixtureQueryID {\n18|\t\tt.Fatalf(\"query id = %q\", query.QueryID)\n19|\t}\n20|\tif len(query.Operations) != 2 {\n21|\t\tt.Fatalf(\"operations = %d, want 2\", len(query.Operations))\n22|\t}\n23|\tif query.Operations[0].Index != 0 || query.Operations[0].Name != \"schema\" || query.Operations[0].Kind != queryKindRead {\n24|\t\tt.Fatalf(\"operation 0 = %+v\", query.Operations[0])\n25|\t}\n26|\tif query.Operations[1].Index != 1 || query.Operations[1].Name != \"sessions\" || query.Operations[1].Kind != queryKindRead {\n27|\t\tt.Fatalf(\"operation 1 = %+v\", query.Operations[1])\n28|\t}\n29|\tif query.Caller.CallerID != \"test-caller\" || query.Caller.Interaction != \"non_interactive\" || len(query.Caller.Scopes) != 1 {\n30|\t\tt.Fatalf(\"caller = %+v\", query.Caller)\n31|\t}\n32|}\n33|\n34|// TestDecodeQueryIndexRules drives the production query entry\n35|// with index defects: duplicate, sparse, reordered, and\n36|// position-mismatched indexes invalidate the whole batch before\n37|// any operation executes.\n38|func TestDecodeQueryIndexRules(t *testing.T) {\n39|\tt.Parallel()\n40|\tgood := fixtureQueryJSON()\n41|\tschemaOp := `{\"operation_index\":0,\"name\":\"schema\",\"parameters\":{\"extensions\":{}},\"fields\":null,\"preset\":null,\"skip\":0,\"take\":1,\"sort\":[],\"dry_run\":false,\"confirm\":false,\"expectation_digest\":null,\"idempotency_key\":null,\"extensions\":{}}`\n42|\tduplicate := replaceOnce(t, good, `\"operation_index\":1`, `\"operation_index\":0`, 1)\n43|\tsparse := replaceOnce(t, good, `\"operation_index\":1`, `\"operation_index\":2`, 1)\n44|\treordered := replaceOnce(t, good, `\"operations\":[`+schemaOp+`,`, `\"operations\":[`, 1)\n45|\treordered = replaceOnce(t, reordered, `],\"caller\"`, `,`+schemaOp+`],\"caller\"`, 1)\n46|\tempty := `{\"schema\":\"urn:ax:schema:session-directory-query\",\"schema_version\":\"1.0.0\",\"query_id\":\"` + fixtureQueryID + `\",\"operations\":[],\"caller\":` + fixtureCallerJSON() + `,\"extensions\":{}}`\n47|\tfor _, probe := range []struct {\n48|\t\tname string\n49|\t\tbody string\n50|\t}{\n51|\t\t{\"duplicate index\", duplicate},\n52|\t\t{\"sparse index\", sparse},\n53|\t\t{\"reordered operations\", reordered},\n54|\t\t{\"dropped first operation\", replaceOnce(t, good, `\"operations\":[`+schemaOp+`,`, `\"operations\":[`, 1)},\n55|\t\t{\"empty batch\", empty},\n56|\t} {\n57|\t\tt.Run(probe.name, func(t *testing.T) {\n58|\t\t\tt.Parallel()\n59|\t\t\tif _, err := DecodeQuery([]byte(probe.body)); requireCode(t, err, \"query_invalid\") == nil {\n60|\t\t\t\tt.Fatal(\"must refuse\")\n61|\t\t\t}\n62|\t\t})\n63|\t}\n64|}\n65|\n66|// TestDecodeQueryEnvelopeRules drives the production query entry\n67|// with one envelope vector per rule.\n68|func TestDecodeQueryEnvelopeRules(t *testing.T) {\n69|\tt.Parallel()\n70|\tgood := fixtureQueryJSON()\n71|\tfor _, probe := range []struct {\n72|\t\tname string\n73|\t\tbody string\n74|\t}{\n75|\t\t{\"unknown member\", replaceOnce(t, good, `\"extensions\":{}}`, `\"extensions\":{},\"extra\":1}`, 1)},\n76|\t\t{\"missing caller\", replaceOnce(t, good, `,\"caller\":`, `,\"callerX\":`, 1)},\n77|\t\t{\"wrong schema\", replaceOnce(t, good, \"session-directory-query\", \"session-directory-node-request\", 1)},\n78|\t\t{\"wrong version\", replaceOnce(t, good, `\"schema_version\":\"1.0.0\"`, `\"schema_version\":\"2.0.0\"`, 1)},\n79|\t\t{\"bad query id\", replaceOnce(t, good, fixtureQueryID, \"not-a-uuid\", 1)},\n80|\t\t{\"bad caller scope\", replaceOnce(t, good, `\"directory.read\"`, `\"directory.root\"`, 1)},\n81|\t\t{\"empty scopes\", replaceOnce(t, good, `\"scopes\":[\"directory.read\"]`, `\"scopes\":[]`, 1)},\n82|\t\t{\"bad interaction\", replaceOnce(t, good, `\"non_interactive\"`, `\"whenever\"`, 1)},\n83|\t\t{\"bad origin host\", replaceOnce(t, good, fixtureOriginHost, \"not-a-uuid\", 1)},\n84|\t\t{\"non object\", `[]`},\n85|\t} {\n86|\t\tt.Run(probe.name, func(t *testing.T) {\n87|\t\t\tt.Parallel()\n88|\t\t\tif _, err := DecodeQuery([]byte(probe.body)); requireCode(t, err, \"query_invalid\") == nil {\n89|\t\t\t\tt.Fatal(\"must refuse\")\n90|\t\t\t}\n91|\t\t})\n92|\t}\n93|}\n94|\n95|// TestDecodeQueryRegistryRules drives the production query entry\n96|// with unknown operations, unknown parameters, and unknown\n97|// filters: the parser rejects the whole batch on unknown syntax,\n98|// operation, parameter, field, preset, filter, sort key, or\n99|// bound.\n100|func TestDecodeQueryRegistryRules(t *testing.T) {\n(more lines below)"}}}
