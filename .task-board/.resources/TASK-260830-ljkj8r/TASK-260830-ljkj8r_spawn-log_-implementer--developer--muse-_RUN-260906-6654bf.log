1504|\t\t\tif err == nil {\n1505|\t\t\t\tt.Fatalf(\"admitted %s=0 below the one minimum\", member)\n1506|\t\t\t} else {\n1507|\t\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", member, \"above zero\")\n1508|\t\t\t}\n1509|\t\t})\n1510|\t}\n1511|}\n1512|\n1513|// TestUint53RepresentabilityCeiling pins the shared uint53\n1514|// ceiling once: 2^53-1 admits, 2^53 refuses. Every maxUint53\n1515|// maximum in the roster points here instead of repeating the\n1516|// literal per site.\n1517|func TestUint53RepresentabilityCeiling(t *testing.T) {\n1518|\tif _, ok := rawUint53(json.RawMessage(`9007199254740991`)); !ok {\n1519|\t\tt.Fatal(\"rawUint53 refused 2^53-1 at the ceiling\")\n1520|\t}\n1521|\tif _, ok := rawUint53(json.RawMessage(`9007199254740992`)); ok {\n1522|\t\tt.Fatal(\"rawUint53 admitted 2^53 past the ceiling\")\n1523|\t}\n1524|\tif _, ok := checkUint53Bounds(json.RawMessage(`9007199254740992`), 0, maxUint53); ok {\n1525|\t\tt.Fatal(\"checkUint53Bounds admitted 2^53 past the ceiling\")\n1526|\t}\n1527|}\n1528|\n1529|// TestDoctorSequenceMinimum drives the registry sequence lower\n1530|// edge: -1 refuses, 0 admits.\n1531|func TestDoctorSequenceMinimum(t *testing.T) {\n1532|\tmanifestDigest := fixtureManifestDigestText(t)\n1533|\trequest := fixtureRequestBody(t, OpDoctor, manifestDigest)\n1534|\tdecoded, err := CheckRequestBody(OpDoctor, request)\n1535|\tif err != nil {\n1536|\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n1537|\t}\n1538|\tdrive := func(value string) error {\n1539|\t\tbase := fixtureSuccessBody(t, OpDoctor, requestContextOf(t, request), manifestDigest)\n1540|\t\t_, err := DecodeDoctorResult(mutateMember(t, base, \"registry_sequence\", value), decoded, DirectionSourceRead)\n1541|\t\treturn err\n1542|\t}\n1543|\tif err := drive(`-1`); err == nil {\n1544|\t\tt.Fatal(\"admitted registry_sequence=-1 below the zero minimum\")\n1545|\t} else {\n1546|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"regi