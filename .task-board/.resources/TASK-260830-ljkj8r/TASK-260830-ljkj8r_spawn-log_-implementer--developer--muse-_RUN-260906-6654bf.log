{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c601","stream":{"kind":"session","id":"01a07573-a73b-7be0-abe2-6029bca74ffd"},"sequence":347,"recorded_at":1780531400000689,"record_type":"event","durability":"durable","causation_id":"65c281d8-14aa-4def-b705-62e70b4fce66","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"65c281d8-14aa-4def-b705-62e70b4fce66","run_stream":{"kind":"run","id":"65c281d8-14aa-4def-b705-62e70b4fce66"},"call_id":"call_01a075746cf37910889d5b0234d9e3f9","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/dirnode/inventory_test.go`.\n(99 line(s) above)\n100|\t\tif !validOperation(name) {\n101|\t\t\tt.Fatalf(\"derived operation %q is not a production registry member\", name)\n102|\t\t}\n103|\t\toperations = append(operations, name)\n104|\t}\n105|\tif len(operations) != 11 {\n106|\t\tt.Fatalf(\"derived %d operation rows, want 11; the table scan is broken, not the registry\", len(operations))\n107|\t}\n108|\tgot := Operations()\n109|\tif strings.Join(got, \"\\x00\") != strings.Join(operations, \"\\x00\") {\n110|\t\tt.Fatalf(\"Operations() = %v, want spec table %v\", got, operations)\n111|\t}\n112|}\n113|\n114|// TestCapabilityRegistryDerivedFromSpec requires the production\n115|// capability registry to equal the Section 7.9 capability\n116|// sentence in order.\n117|func TestCapabilityRegistryDerivedFromSpec(t *testing.T) {\n118|\ttext := specText(t)\n119|\twindow := specWindow(t, text, \"The capability\\nregistry is exactly\", \"and <code>native_resume</code>.\")\n120|\ttokens := specCodeTokens(t, window)\n121|\ttokens = append(tokens, \"native_resume\")\n122|\tif len(tokens) != 8 {\n123|\t\tt.Fatalf(\"derived %d capability names, want 8\", len(tokens))\n124|\t}\n125|\tgot := Capabilities()\n126|\tif strings.Join(got, \"\\x00\") != strings.Join(tokens, \"\\x00\") {\n127|\t\tt.Fatalf(\"Capabilities() = %v, want spec sentence %v\", got, tokens)\n128|\t}\n129|}\n130|\n131|// TestQueryRegistryDerivedFromSpec requires the production query\n132|// registries to equal the Section 10.8.5 read/mutation sentences\n133|// in order: eleven reads, then six mutations.\n134|func TestQueryRegistryDerivedFromSpec(t *testing.T) {\n135|\ttext := specText(t)\n136|\twindow := specWindow(t, text, \"Read operations are exactly\", \"there is no delete.\")\n137|\ttokens := specCodeTokens(t, window)\n138|\tsplit := -1\n139|\tfor index, token := range tokens {\n140|\t\tif token == \"set_title\" {\n141|\t\t\tsplit = index\n142|\t\t\tbreak\n143|\t\t}\n144|\t}\n145|\tif split < 0 {\n146|\t\tt.Fatal(\"mutation registry not found in query window\")\n147|\t}\n148|\treads, mutations := tokens[:split], tokens[split:]\n149|\tif strings.Join(reads, \"\\x00\") != strings.Join(readOperations, \"\\x00\") {\n150|\t\tt.Fatalf(\"read registry = %v, want spec %v\", readOperations, reads)\n151|\t}\n152|\tif strings.Join(mutations, \"\\x00\") != strings.Join(mutationOperations, \"\\x00\") {\n153|\t\tt.Fatalf(\"mutation registry = %v, want spec %v\", mutationOperations, mutations)\n154|\t}\n155|}\n156|\n157|// TestFramedSubsetIsExact pins the deliverable boundary: the\n158|// framed subset is exactly manifest, probe, and scan, and the\n159|// unframed remainder is exactly the eight named registry members\n160|// whose nested content owners are the sibling leaves. A fourth\n161|// framed operation, or a ninth unframed one, reddens here.\n162|func TestFramedSubsetIsExact(t *testing.T) {\n163|\tt.Parallel()\n164|\tframed := FramedOperations()\n165|\twant := []string{\"manifest\", \"probe\", \"scan\"}\n166|\tif strings.Join(framed, \"\\x00\") != strings.Join(want, \"\\x00\") {\n167|\t\tt.Fatalf(\"FramedOperations() = %v, want %v\", framed, want)\n168|\t}\n169|\tframedSet := map[string]bool{}\n170|\tfor _, name := range framed {\n171|\t\tframedSet[name] = true\n172|\t}\n173|\tvar unframed []string\n174|\tfor _, name := range Operations() {\n175|\t\tif !framedSet[name] {\n176|\t\t\tunframed = append(unframed, name)\n177|\t\t}\n178|\t}\n179|\twantUnframed := []string{\"inventory\", \"preview\", \"enrichment-plan\", \"enrichment-run\", \"enrichment-status\", \"continuation-inspect\", \"runtime-observe\", \"doctor\"}\n180|\tsort.Strings(unframed)\n181|\tsort.Strings(wantUnframed)\n182|\tif strings.Join(unframed, \"\\x00\") != strings.Join(wantUnframed, \"\\x00\") {\n183|\t\tt.Fatalf(\"unframed operations = %v, want %v\", unframed, wantUnframed)\n184|\t}\n185|}\n186|\n187|// axerrorImportPath is the only import path the constructor census\n188|// resolves. It is spelled here rather than derived because the\n189|// census must pin production, not follow it: a moved package with\n190|// no row here fails the zero-importer guard below.\n191|const axerrorImportPath = \"github.com/relux-works/agent-session-manager/internal/axerror\"\n192|\n193|// TestAxerrorImportsAreUnaliased pins the import spelling every\n194|// identifier-matched census in this package relies on. A\n195|// production file importing the error package under any other\n196|// name hides every refusal it builds from both the constructor\n197|// census and the arm derivation at once. An empty scan, or a tree\n198|// with no production importer at all, fails closed.\n199|func TestAxerrorImportsAreUnaliased(t *testing.T) {\n200|\tdirectory, err := os.Getwd()\n201|\tif err != nil {\n202|\t\tt.Fatalf(\"import census: %v\", err)\n203|\t}\n204|\tentries, err := os.ReadDir(directory)\n205|\tif err != nil {\n206|\t\tt.Fatalf(\"import census: %v\", err)\n207|\t}\n208|\tscanned := 0\n209|\timporting := 0\n210|\tvar violations []string\n211|\tfor _, entry := range entries {\n212|\t\tname := entry.Name()\n213|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n214|\t\t\tcontinue\n215|\t\t}\n216|\t\tscanned++\n217|\t\tpath := filepath.Join(directory, name)\n218|\t\tsource, err := os.ReadFile(path)\n219|\t\tif err != nil {\n220|\t\t\tt.Fatalf(\"import census: %v\", err)\n221|\t\t}\n222|\t\tsyntax, err := parseGoFile(path, source)\n223|\t\tif err != nil {\n224|\t\t\tt.Fatalf(\"import census: %v\", err)\n225|\t\t}\n226|\t\tfor _, declaration := range syntax.Imports {\n227|\t\t\ttarget, err := strconv.Unquote(declaration.Path.Value)\n228|\t\t\tif err != nil || target != axerrorImportPath {\n229|\t\t\t\tcontinue\n230|\t\t\t}\n231|\t\t\timporting++\n232|\t\t\tif declaration.Name != nil && declaration.Name.Name != \"axerror\" {\n233|\t\t\t\tviolations = append(violations, name+\": imports the error package as \"+declaration.Name.Name)\n234|\t\t\t}\n235|\t\t}\n236|\t}\n237|\tif scanned == 0 {\n238|\t\tt.Fatal(\"import census scanned zero production files; the scanner is broken, not the package\")\n239|\t}\n240|\tif importing == 0 {\n241|\t\tt.Fatal(\"import census found zero production importers of the error package; the census is vacuous, not green\")\n242|\t}\n243|\tsort.Strings(violations)\n244|\tif len(violations) > 0 {\n245|\t\tt.Fatalf(\"aliased error-package import(s) hide constructions from the constructor census:\\n  %s\", strings.Join(violations, \"\\n  \"))\n246|\t}\n247|\tt.Logf(\"import census: %d production importer(s) bind axerror across %d files\", importing, scanned)\n248|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c603","stream":{"kind":"session","id":"01a07573-a73b-7be0-abe2-6029bca74ffd"},"sequence":348,"recorded_at":1780531400000691,"record_type":"event","durability":"durable","causation_id":"65c281d8-14aa-4def-b705-62e70b4fce66","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"65c281d8-14aa-4def-b705-62e70b4fce66","run_stream":{"kind":"run","id":"65c281d8-14aa-4def-b705-62e70b4fce66"},"call_id":"call_01a075746e3f7d00850e74c8d51cb392","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/dirnode/census_test.go`.\n(99 line(s) above)\n100|//     every arm built through it.\n101|//  8. A failX call inside a non-constructor function literal —\n102|//     REFUSED as a closure-hidden arm.\n103|//  9. An import of the error package path under any other name\n104|//     — REFUSED by the import census\n105|//     (TestAxerrorImportsAreUnaliased pins the `axerror`\n106|//     binding every identifier match above relies on).\n107|//  10. A &frameFault{...} literal — DERIVED as a frame arm by\n108|//     its literal detail.\n109|//\n110|// 10 of 10 shapes derived-or-refused. The residue, stated here\n111|// rather than left silent: a frameFault built through a type\n112|// alias (`type ff = frameFault`) would hide from shape 10 — no\n113|// such alias exists in production (the derivation fails on any\n114|// CompositeLit it cannot classify, but an alias retypes the\n115|// node it matches, so this bound is textual: grep finds no\n116|// `frameFault` alias); a construction via assembly, linkname,\n117|// or reflect would hide from shapes 5-6 — the package uses none\n118|// of those mechanisms; files outside the package directory and\n119|// _test.go files, which the census never scans, must not carry\n120|// production refusals — TestCensusScansEveryProductionFile\n121|// requires the scanned set to equal the production file list\n122|// the package build sees; a second argument that smuggles the\n123|// distinguishing fact while the first stays constant would make\n124|// two arms share one key — the constructors' second parameters\n125|// are wire facts asserted selectively by the entry tests, never\n126|// the arm identity, and the witness table records the\n127|// code-plus-detail pair per arm.\n128|//\n129|// Census-only kills score separately from behavioural ones:\n130|// every arm the derivation observes reddens the census by\n131|// construction when its site is edited, and that reddening\n132|// proves the census runs, not that the gate refuses. Behavioural\n133|// proof stays with each row's named witness, which the inventory\n134|// resolves textually and runs as part of the suite.\n135|\n136|// refusalConstructors is the exact registered constructor set.\n137|// Each must be a package-level `var failX = func...` whose body\n138|// calls axerror.New; the derivation verifies both halves.\n139|var refusalConstructors = []string{\n140|\t\"failInvalid\",\n141|\t\"failViolation\",\n142|\t\"failUnknownOperation\",\n143|\t\"failDowngrade\",\n144|\t\"failIntegrity\",\n145|\t\"failIdempotency\",\n146|\t\"failQuery\",\n147|\t\"failTransport\",\n148|}\n149|\n150|// parseGoFile parses one Go source file for the censuses.\n151|func parseGoFile(path string, source []byte) (*ast.File, error) {\n152|\treturn parser.ParseFile(token.NewFileSet(), path, source, 0)\n153|}\n154|\n155|// productionFiles returns the production file paths of this\n156|// package directory: every non-test Go file. Test files are\n157|// never scanned: a refusal built in a test helper is not a\n158|// production arm.\n159|func productionFiles(t *testing.T) []string {\n160|\tt.Helper()\n161|\tdirectory, err := os.Getwd()\n162|\tif err != nil {\n163|\t\tt.Fatalf(\"census: %v\", err)\n164|\t}\n165|\tentries, err := os.ReadDir(directory)\n166|\tif err != nil {\n167|\t\tt.Fatalf(\"census: %v\", err)\n168|\t}\n169|\tvar files []string\n170|\tfor _, entry := range entries {\n171|\t\tname := entry.Name()\n172|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n173|\t\t\tcontinue\n174|\t\t}\n175|\t\tfiles = append(files, filepath.Join(directory, name))\n176|\t}\n177|\tsort.Strings(files)\n178|\tif len(files) == 0 {\n179|\t\tt.Fatal(\"census scanned zero production files; the scanner is broken, not the package\")\n180|\t}\n181|\treturn files\n182|}\n183|\n184|// armDerivation is the derived inventory plus every shape\n185|// violation found along the way.\n186|type armDerivation struct {\n187|\tarms       map[string]bool\n188|\tctors      map[string]bool\n189|\tviolations []string\n190|}\n191|\n192|// deriveRefusalArms parses every production file and derives the\n193|// constructor set, the arm set, and the violation list.\n194|func deriveRefusalArms(t *testing.T) armDerivation {\n195|\tt.Helper()\n196|\tderived := armDerivation{arms: map[string]bool{}, ctors: map[string]bool{}}\n197|\tfor _, path := range productionFiles(t) {\n198|\t\tsource, err := os.ReadFile(path)\n199|\t\tif err != nil {\n200|\t\t\tt.Fatalf(\"census: %v\", err)\n201|\t\t}\n202|\t\tsyntax, err := parseGoFile(path, source)\n203|\t\tif err != nil {\n204|\t\t\tt.Fatalf(\"census: %v\", err)\n205|\t\t}\n206|\t\tscan := fileScan{derived: &derived, name: filepath.Base(path)}\n207|\t\tscan.registerConstructors(syntax)\n208|\t\tscan.walkFile(syntax)\n209|\t}\n210|\tif len(derived.ctors) == 0 {\n211|\t\tt.Fatal(\"census derived zero constructors; the scanner is broken, not the package\")\n212|\t}\n213|\tif len(derived.arms) == 0 {\n214|\t\tt.Fatal(\"census derived zero arms; the scanner is broken, not the package\")\n215|\t}\n216|\treturn derived\n217|}\n218|\n219|// fileScan holds per-file census state.\n220|type fileScan struct {\n221|\tderived   *armDerivation\n222|\tname      string\n223|\tctors     map[string]bool\n224|\tfunctions []string\n225|}\n226|\n227|// callFunction names the function enclosing the call under\n228|// visit: the nearest function declaration, the closure marker\n229|// for a non-constructor literal, or the package marker for a\n230|// package-level initializer. A closure-hidden arm carries a key\n231|// no witness table row can match by accident, so the first one\n232|// fails the witnessed-direction test instead of passing\n233|// silently.\n234|func (scan *fileScan) callFunction() string {\n235|\tif len(scan.functions) == 0 {\n236|\t\treturn \"package\"\n237|\t}\n238|\treturn scan.functions[len(scan.functions)-1]\n239|}\n240|\n241|// registerConstructors records every package-level\n242|// `var failX = func...` literal whose body calls axerror.New.\n243|func (scan *fileScan) registerConstructors(syntax *ast.File) {\n244|\tfor _, declaration := range syntax.Decls {\n245|\t\tgeneral, ok := declaration.(*ast.GenDecl)\n246|\t\tif !ok || general.Tok != token.VAR {\n247|\t\t\tcontinue\n248|\t\t}\n249|\t\tfor _, specification := range general.Specs {\n250|\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n251|\t\t\tif !ok || len(value.Names) != 1 || len(value.Values) != 1 {\n252|\t\t\t\tcontinue\n253|\t\t\t}\n254|\t\t\tliteral, ok := value.Values[0].(*ast.FuncLit)\n255|\t\t\tif !ok {\n256|\t\t\t\tcontinue\n257|\t\t\t}\n258|\t\t\tif !containsAxerrorNew(literal.Body) {\n259|\t\t\t\tcontinue\n260|\t\t\t}\n261|\t\t\tscan.derived.ctors[value.Names[0].Name] = true\n262|\t\t}\n263|\t}\n264|}\n265|\n266|// containsAxerrorNew reports whether the body calls axerror.New.\n267|func containsAxerrorNew(body *ast.BlockStmt) bool {\n268|\tfound := false\n269|\tast.Inspect(body, func(node ast.Node) bool {\n270|\t\tcall, ok := node.(*ast.CallExpr)\n271|\t\tif !ok {\n272|\t\t\treturn true\n273|\t\t}\n274|\t\tif selector, ok := call.Fun.(*ast.SelectorExpr); ok {\n275|\t\t\tif identifier, ok := selector.X.(*ast.Ident); ok && identifier.Name == \"axerror\" && selector.Sel.Name == \"New\" {\n276|\t\t\t\tfound = true\n277|\t\t\t\treturn false\n278|\t\t\t}\n279|\t\t}\n280|\t\treturn true\n281|\t})\n282|\treturn found\n283|}\n284|\n285|// walkFile derives arms and violations with parent tracking: the\n286|// stack top is the parent of the node under visit.\n287|func (scan *fileScan) walkFile(syntax *ast.File) {\n288|\tvar stack []ast.Node\n289|\tctorDepth := 0\n290|\tctorLiterals := map[*ast.FuncLit]bool{}\n291|\tfor _, declaration := range syntax.Decls {\n292|\t\tif general, ok := declaration.(*ast.GenDecl); ok && general.Tok == token.VAR {\n293|\t\t\tfor _, specification := range general.Specs {\n294|\t\t\t\tif value, ok := specification.(*ast.ValueSpec); ok && len(value.Values) == 1 {\n295|\t\t\t\t\tif literal, ok := value.Values[0].(*ast.FuncLit); ok && scan.derived.ctors[value.Names[0].Name] {\n296|\t\t\t\t\t\tctorLiterals[literal] = true\n297|\t\t\t\t\t}\n298|\t\t\t\t}\n299|\t\t\t}\n300|\t\t}\n301|\t}\n302|\tast.Inspect(syntax, func(node ast.Node) bool {\n303|\t\tif node == nil {\n304|\t\t\tpopped := stack[len(stack)-1]\n305|\t\t\tstack = stack[:len(stack)-1]\n306|\t\t\tif literal, ok := popped.(*ast.FuncLit); ok && ctorLiterals[literal] {\n307|\t\t\t\tctorDepth--\n308|\t\t\t}\n309|\t\t\tswitch popped.(type) {\n310|\t\t\tcase *ast.FuncDecl, *ast.FuncLit:\n311|\t\t\t\tscan.functions = scan.functions[:len(scan.functions)-1]\n312|\t\t\t}\n313|\t\t\treturn true\n314|\t\t}\n315|\t\tvar parent ast.Node\n316|\t\tif len(stack) > 0 {\n317|\t\t\tparent = stack[len(stack)-1]\n318|\t\t}\n319|\t\tif literal, ok := node.(*ast.FuncLit); ok && ctorLiterals[literal] {\n320|\t\t\tctorDepth++\n321|\t\t}\n322|\t\tswitch node := node.(type) {\n323|\t\tcase *ast.FuncDecl:\n324|\t\t\tscan.functions = append(scan.functions, node.Name.Name)\n325|\t\tcase *ast.FuncLit:\n326|\t\t\tif ctorLiterals[node] {\n327|\t\t\t\tscan.functions = append(scan.functions, \"ctor\")\n328|\t\t\t} else {\n329|\t\t\t\tscan.functions = append(scan.functions, \"closure\")\n330|\t\t\t}\n331|\t\t}\n332|\t\tscan.visit(node, parent, ctorDepth)\n333|\t\tstack = append(stack, node)\n334|\t\treturn true\n335|\t})\n336|}\n337|\n338|// visit derives or refuses one node.\n339|func (scan *fileScan) visit(node, parent ast.Node, ctorDepth int) {\n340|\tswitch node := node.(type) {\n341|\tcase *ast.CallExpr:\n342|\t\tscan.visitCall(node, parent, ctorDepth)\n343|\tcase *ast.Ident:\n344|\t\tscan.visitIdent(node, parent)\n345|\tcase *ast.SelectorExpr:\n346|\t\tscan.visitSelector(node, parent)\n347|\tcase *ast.CompositeLit:\n348|\t\tscan.visitComposite(node, parent)\n349|\t}\n350|}\n351|\n352|// visitCall handles constructor calls and axerror.New calls.\n353|func (scan *fileScan) visitCall(call *ast.CallExpr, parent ast.Node, ctorDepth int) {\n354|\tif identifier, ok := call.Fun.(*ast.Ident); ok && isConstructorName(identifier.Name) {\n355|\t\tscan.visitConstructorCall(call, identifier.Name)\n356|\t\treturn\n357|\t}\n358|\tif selector, ok := call.Fun.(*ast.SelectorExpr); ok {\n359|\t\tif identifier, ok := selector.X.(*ast.Ident); ok && identifier.Name == \"axerror\" && selector.Sel.Name == \"New\" {\n360|\t\t\tif ctorDepth == 0 {\n361|\t\t\t\tscan.derived.violations = append(scan.derived.violations, scan.name+\": axerror.New call outside every registered constructor body\")\n362|\t\t\t}\n363|\t\t}\n364|\t}\n365|}\n366|\n367|// isConstructorName reports whether the identifier names a\n368|// derived constructor. The import census pins the axerror\n369|// binding; the constructor census pins this set against the\n370|// registered table, so matching on the name cannot drift from\n371|// either without reddening its own gate first.\n372|func isConstructorName(name string) bool {\n373|\tfor _, registered := range refusalConstructors {\n374|\t\tif name == registered {\n375|\t\t\treturn true\n376|\t\t}\n377|\t}\n378|\treturn false\n379|}\n380|\n381|// visitConstructorCall derives one constructor-call arm. A call\n382|// inside a non-constructor function literal is refused outright:\n383|// an arm that fires only when a closure runs is not a call-site\n384|// arm, and keying it would pretend otherwise.\n385|func (scan *fileScan) visitConstructorCall(call *ast.CallExpr, name string) {\n386|\tif scan.callFunction() == \"closure\" {\n387|\t\tscan.derived.violations = append(scan.derived.violations, scan.name+\": \"+name+\" call inside a function literal\")\n388|\t\treturn\n389|\t}\n390|\tif len(call.Args) == 0 {\n391|\t\tscan.derived.violations = append(scan.derived.violations, scan.name+\": \"+name+\" call with no arguments\")\n392|\t\treturn\n393|\t}\n394|\tswitch first := call.Args[0].(type) {\n395|\tcase *ast.BasicLit:\n396|\t\tif first.Kind != token.STRING {\n397|\t\t\tscan.derived.violations = append(scan.derived.violations, scan.name+\": \"+name+\" call with non-string literal first argument\")\n398|\t\t\treturn\n399|\t\t}\n400|\t\tdetail, err := strconv.Unquote(first.Value)\n401|\t\tif err != nil {\n402|\t\t\tscan.derived.violations = append(scan.derived.violations, scan.name+\": \"+name+\" call with unquotable detail\")\n403|\t\t\treturn\n404|\t\t}\n405|\t\tscan.derived.arms[\"ctor|\"+name+\"|\"+detail] = true\n406|\tcase *ast.BinaryExpr:\n407|\t\trendered, ok := renderExpr(first)\n408|\t\tif !ok {\n409|\t\t\tscan.derived.violations = append(scan.derived.violations, scan.name+\": \"+name+\" call with unrenderable first argument\")\n410|\t\t\treturn\n411|\t\t}\n412|\t\tscan.derived.arms[\"ctor|\"+name+\"|expr|\"+scan.callFunction()+\"|\"+rendered] = true\n413|\tdefault:\n414|\t\tscan.derived.violations = append(scan.derived.violations, scan.name+\": \"+name+\" call with non-literal, non-binary first argument\")\n415|\t}\n416|}\n417|\n418|// renderExpr renders a first-argument expression into a stable\n419|// key: string literals by value, identifiers and selectors by\n420|// path. Only + compositions render; anything else is a\n421|// violation, not a silent bucket.\n422|func renderExpr(node ast.Expr) (string, bool) {\n423|\tswitch node := node.(type) {\n424|\tcase *ast.BasicLit:\n425|\t\tif node.Kind != token.STRING {\n426|\t\t\treturn \"\", false\n427|\t\t}\n428|\t\tdetail, err := strconv.Unquote(node.Value)\n429|\t\tif err != nil {\n430|\t\t\treturn \"\", false\n431|\t\t}\n432|\t\treturn strconv.Quote(detail), true\n433|\tcase *ast.Ident:\n434|\t\treturn node.Name, true\n435|\tcase *ast.SelectorExpr:\n436|\t\tidentifier, ok := node.X.(*ast.Ident)\n437|\t\tif !ok {\n438|\t\t\treturn \"\", false\n439|\t\t}\n440|\t\treturn identifier.Name + \".\" + node.Sel.Name, true\n441|\tcase *ast.BinaryExpr:\n442|\t\tif node.Op != token.ADD {\n443|\t\t\treturn \"\", false\n444|\t\t}\n445|\t\tleft, ok := renderExpr(node.X)\n446|\t\tif !ok {\n447|\t\t\treturn \"\", false\n448|\t\t}\n449|\t\tright, ok := renderExpr(node.Y)\n450|\t\tif !ok {\n451|\t\t\treturn \"\", false\n452|\t\t}\n453|\t\treturn left + \"+\" + right, true\n454|\tdefault:\n455|\t\treturn \"\", false\n456|\t}\n457|}\n458|\n459|// visitIdent refuses constructor aliases: any constructor\n460|// identifier outside direct-call position and outside its own\n461|// definition Name.\n462|func (scan *fileScan) visitIdent(identifier *ast.Ident, parent ast.Node) {\n463|\tif !isConstructorName(identifier.Name) {\n464|\t\treturn\n465|\t}\n466|\tif call, ok := parent.(*ast.CallExpr); ok {\n467|\t\tif fun, ok := call.Fun.(*ast.Ident); ok && fun == identifier {\n468|\t\t\treturn\n469|\t\t}\n470|\t}\n471|\tif specification, ok := parent.(*ast.ValueSpec); ok {\n472|\t\tfor _, name := range specification.Names {\n473|\t\t\tif name == identifier {\n474|\t\t\t\treturn\n475|\t\t\t}\n476|\t\t}\n477|\t}\n478|\tscan.derived.violations = append(scan.derived.violations, scan.name+\": constructor alias of \"+identifier.Name)\n479|}\n480|\n481|// visitSelector refuses axerror.New in non-call position.\n482|func (scan *fileScan) visitSelector(selector *ast.SelectorExpr, parent ast.Node) {\n483|\tidentifier, ok := selector.X.(*ast.Ident)\n484|\tif !ok || identifier.Name != \"axerror\" || selector.Sel.Name != \"New\" {\n485|\t\treturn\n486|\t}\n487|\tif call, ok := parent.(*ast.CallExpr); ok {\n488|\t\tif fun, ok := call.Fun.(*ast.SelectorExpr); ok && fun == selector {\n489|\t\t\treturn\n490|\t\t}\n491|\t}\n492|\tscan.derived.violations = append(scan.derived.violations, scan.name+\": axerror.New in non-call position\")\n493|}\n494|\n495|// visitComposite derives &frameFault{...} literals by their\n496|// literal detail. A composite literal that names frameFault\n497|// through any other shape is a violation.\n498|func (scan *fileScan) visitComposite(literal *ast.CompositeLit, parent ast.Node) {\n499|\tidentifier, ok := literal.Type.(*ast.Ident)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
