{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c581","stream":{"kind":"session","id":"01a07573-a73b-7be0-abe2-6029bca74ffd"},"sequence":283,"recorded_at":1780531400000561,"record_type":"event","durability":"durable","causation_id":"65c281d8-14aa-4def-b705-62e70b4fce66","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"65c281d8-14aa-4def-b705-62e70b4fce66","run_stream":{"kind":"run","id":"65c281d8-14aa-4def-b705-62e70b4fce66"},"call_id":"call_01a0757431637f52b9a2cef994c49fb4","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/dirnode/query_test.go`.\n(99 line(s) above)\n100|func TestDecodeQueryRegistryRules(t *testing.T) {\n101|\tt.Parallel()\n102|\tgood := fixtureQueryJSON()\n103|\tfor _, probe := range []struct {\n104|\t\tname string\n105|\t\tbody string\n106|\t}{\n107|\t\t{\"unknown operation\", replaceOnce(t, good, `\"name\":\"sessions\"`, `\"name\":\"search\"`, 1)},\n108|\t\t{\"unknown parameter\", replaceOnce(t, good, `\"filters\":{\"kinds\"`, `\"filters\":{\"kindsX\"`, 1)},\n109|\t\t{\"unknown filter\", replaceOnce(t, good, `\"freshness\":[]`, `\"freshness\":[],\"fuzz\":[]`, 1)},\n110|\t\t{\"unknown field\", replaceOnce(t, good, `\"preset\":\"overview\"`, `\"fields\":[\"nope\"],\"preset\":null`, 1)},\n111|\t\t{\"unknown preset\", replaceOnce(t, good, `\"preset\":\"overview\"`, `\"preset\":\"everything\"`, 1)},\n112|\t\t{\"unknown sort field\", replaceOnce(t, good, `\"field\":\"stable_id\"`, `\"field\":\"vibes\"`, 1)},\n113|\t\t{\"unknown sort direction\", replaceOnce(t, good, `\"direction\":\"asc\"`, `\"direction\":\"sideways\"`, 1)},\n114|\t\t{\"fields and preset together\", replaceOnce(t, good, `\"fields\":null,\"preset\":\"overview\"`, `\"fields\":[\"id\"],\"preset\":\"overview\"`, 1)},\n115|\t\t{\"bad filter enum\", replaceOnce(t, good, `\"reachability\":[]`, `\"reachability\":[\"everywhere\"]`, 1)},\n116|\t\t{\"bad provider id\", replaceOnce(t, good, `\"provider_ids\":[]`, `\"provider_ids\":[\"BAD\"]`, 1)},\n117|\t} {\n118|\t\tt.Run(probe.name, func(t *testing.T) {\n119|\t\t\tt.Parallel()\n120|\t\t\tif _, err := DecodeQuery([]byte(probe.body)); requireCode(t, err, \"query_invalid\") == nil {\n121|\t\t\t\tt.Fatal(\"must refuse\")\n122|\t\t\t}\n123|\t\t})\n124|\t}\n125|}\n126|\n127|// mutationBatch builds a one-operation mutation batch with the\n128|// given parameters, flags, and digests for the flag-rule tests.\n129|func mutationBatch(name, parameters string, dryRun, confirm bool, expectation, idempotency string) string {\n130|\treturn `{\"schema\":\"urn:ax:schema:session-directory-query\",\"schema_version\":\"1.0.0\",\"query_id\":\"` + fixtureQueryID + `\",\"operations\":[{\"operation_index\":0,\"name\":\"` + name + `\",\"parameters\":` + parameters + `,\"fields\":null,\"preset\":null,\"skip\":0,\"take\":1,\"sort\":[],\"dry_run\":` + boolString(dryRun) + `,\"confirm\":` + boolString(confirm) + `,\"expectation_digest\":` + expectation + `,\"idempotency_key\":` + idempotency + `,\"extensions\":{}}],\"caller\":` + fixtureCallerJSON() + `,\"extensions\":{}}`\n131|}\n132|\n133|func boolString(value bool) string {\n134|\tif value {\n135|\t\treturn \"true\"\n136|\t}\n137|\treturn \"false\"\n138|}\n139|\n140|// TestDecodeQueryMutationFlagRules drives the production query\n141|// entry through the mutation flag rules: dry run xor confirm,\n142|// execute_plan requiring confirm plus both digests, annotation\n143|// mutations requiring both digests when confirmed, and\n144|// plan_continue requiring pure dry run.\n145|func TestDecodeQueryMutationFlagRules(t *testing.T) {\n146|\tt.Parallel()\n147|\ttitle := `{\"subject_kind\":\"ax_session\",\"subject_id\":\"` + fixtureQueryID + `\",\"title\":\"T\",\"supersedes_annotation_ids\":[],\"extensions\":{}}`\n148|\tdigest := `\"` + fixtureBatchDigest + `\"`\n149|\texecute := `{\"plan_id\":` + digest + `,\"operation_id\":\"` + fixtureOperationID + `\",\"confirmations\":[],\"extensions\":{}}`\n150|\tcontinueParams := `{\"subject_kind\":\"ax_session\",\"subject_id\":\"` + fixtureQueryID + `\",\"source_instance_id\":` + digest + `,\"to_host_id\":\"` + fixtureOriginHost + `\",\"to_installation_id\":` + digest + `,\"intent\":\"resume\",\"workspace_policy\":\"exact_checkpoint\",\"source_after_success\":\"retain\",\"extensions\":{}}`\n151|\tfor _, probe := range []struct {\n152|\t\tname    string\n153|\t\tbody    string\n154|\t\trefuses bool\n155|\t}{\n156|\t\t{\"dry run title plans\", mutationBatch(\"set_title\", title, true, false, \"null\", \"null\"), false},\n157|\t\t{\"confirmed title without digests\", mutationBatch(\"set_title\", title, false, true, \"null\", \"null\"), true},\n158|\t\t{\"confirmed title with digests\", mutationBatch(\"set_title\", title, false, true, digest, digest), false},\n159|\t\t{\"both flags\", mutationBatch(\"set_title\", title, true, true, digest, digest), true},\n160|\t\t{\"neither flag\", mutationBatch(\"set_title\", title, false, false, \"null\", \"null\"), true},\n161|\t\t{\"execute plan confirmed with digests\", mutationBatch(\"execute_plan\", execute, false, true, digest, digest), false},\n162|\t\t{\"execute plan dry run\", mutationBatch(\"execute_plan\", execute, true, false, \"null\", \"null\"), true},\n163|\t\t{\"execute plan missing digests\", mutationBatch(\"execute_plan\", execute, false, true, \"null\", digest), true},\n164|\t\t{\"plan continue dry run\", mutationBatch(\"plan_continue\", continueParams, true, false, \"null\", \"null\"), false},\n165|\t\t{\"plan continue confirmed\", mutationBatch(\"plan_continue\", continueParams, false, true, \"null\", \"null\"), true},\n166|\t\t{\"read with dry run\", replaceOnce(t, fixtureQueryJSON(), `\"dry_run\":false,\"confirm\":false`, `\"dry_run\":true,\"confirm\":false`, 1), true},\n167|\t} {\n168|\t\tt.Run(probe.name, func(t *testing.T) {\n169|\t\t\tt.Parallel()\n170|\t\t\t_, err := DecodeQuery([]byte(probe.body))\n171|\t\t\tif probe.refuses && err == nil {\n172|\t\t\t\tt.Fatal(\"must refuse\")\n173|\t\t\t}\n174|\t\t\tif !probe.refuses && err != nil {\n175|\t\t\t\tt.Fatalf(\"must admit: %v\", err)\n176|\t\t\t}\n177|\t\t\tif probe.refuses {\n178|\t\t\t\trequireCode(t, err, \"query_invalid\")\n179|\t\t\t}\n180|\t\t})\n181|\t}\n182|}\n183|\n184|// TestDecodeQueryPaginationRules drives the production query\n185|// entry through the skip/take rule: list operations page, while\n186|// the schema read requires skip=0 and take=1.\n187|func TestDecodeQueryPaginationRules(t *testing.T) {\n188|\tt.Parallel()\n189|\tpaged := replaceOnce(t, fixtureQueryJSON(), `\"skip\":0,\"take\":10`, `\"skip\":5,\"take\":10`, 1)\n190|\tif _, err := DecodeQuery([]byte(paged)); err != nil {\n191|\t\tt.Fatalf(\"paged sessions must admit: %v\", err)\n192|\t}\n193|\tunpaged := replaceOnce(t, fixtureQueryJSON(), `\"skip\":0,\"take\":1,\"sort\":[],\"dry_run\":false,\"confirm\":false,\"expectation_digest\":null,\"idempotency_key\":null,\"extensions\":{}},{\"operation_index\":1`, `\"skip\":1,\"take\":1,\"sort\":[],\"dry_run\":false,\"confirm\":false,\"expectation_digest\":null,\"idempotency_key\":null,\"extensions\":{}},{\"operation_index\":1`, 1)\n194|\tif _, err := DecodeQuery([]byte(unpaged)); requireCode(t, err, \"query_invalid\") == nil {\n195|\t\tt.Fatal(\"schema read with skip must refuse\")\n196|\t}\n197|}\n198|\n199|// TestCheckCursorReuse drives the production cursor entry: a\n200|// well-formed cursor admits under unchanged bounds, reuse after\n201|// any bound change refuses with query_invalid, and a malformed\n202|// cursor refuses before any bound is consulted.\n203|func TestCheckCursorReuse(t *testing.T) {\n204|\tt.Parallel()\n205|\tif err := CheckCursorReuse(\"opaque-cursor\", false); err != nil {\n206|\t\tt.Fatalf(\"CheckCursorReuse(unchanged) error = %v\", err)\n207|\t}\n208|\trequireCode(t, CheckCursorReuse(\"opaque-cursor\", true), \"query_invalid\")\n209|\trequireCode(t, CheckCursorReuse(\"\", false), \"query_invalid\")\n210|\trequireCode(t, CheckCursorReuse(strings.Repeat(\"x\", 1025), false), \"query_invalid\")\n211|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c583","stream":{"kind":"session","id":"01a07573-a73b-7be0-abe2-6029bca74ffd"},"sequence":284,"recorded_at":1780531400000563,"record_type":"event","durability":"durable","causation_id":"65c281d8-14aa-4def-b705-62e70b4fce66","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"65c281d8-14aa-4def-b705-62e70b4fce66","run_stream":{"kind":"run","id":"65c281d8-14aa-4def-b705-62e70b4fce66"},"call_id":"call_01a07574327175338b3e37cccae3ff39","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/dirnode/fixtures_test.go`.\n1|package dirnode\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"fmt\"\n7|\t\"sort\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n12|)\n13|\n14|// Shared fixtures for the dirnode suite. Every builder emits\n15|// hand-written JSON with independently chosen literals: no builder\n16|// derives its probe points from production constants, so a mutated\n17|// production constant cannot take its fixture with it. The verdict\n18|// always comes from production; the vectors never do. In\n19|// particular the schema URNs, protocol URN, version strings,\n20|// operation names, and member names below are retyped from the\n21|// pinned specification, not referenced from the package under\n22|// test.\n23|\n24|// Fixed fixture identities. The UUIDs carry a 7 version nibble;\n25|// the digests are syntactically pinned sha256 hex.\n26|const (\n27|\tfixtureNodeID      = \"test-directory-node\"\n28|\tfixtureNodeVersion = \"2.4.1\"\n29|\tfixtureHostID      = \"0198f4c8-8e50-7f66-8f70-1234567890ab\"\n30|\tfixtureRequestID   = \"0198f4c8-8e50-7f66-8f70-1234567890ac\"\n31|\tfixtureOperationID = \"0198f4c8-8e50-7f66-8f70-1234567890ad\"\n32|\tfixtureQueryID     = \"0198f4c8-8e50-7f66-8f70-1234567890ae\"\n33|\tfixtureOriginHost  = \"0198f4c8-8e50-7f66-8f70-1234567890af\"\n34|\tfixtureObservedAt  = \"2026-08-19T04:05:00.000Z\"\n35|)\n36|\n37|// fixtureDigest returns the pinned digest of one seed.\n38|func fixtureDigest(seed string) string {\n39|\tsum := sha256.Sum256([]byte(seed))\n40|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n41|}\n42|\n43|// Standard fixture digests, each naming its seed.\n44|var (\n45|\tfixtureExecutableDigest = fixtureDigest(\"test-node-executable\")\n46|\tfixtureProviderDigest   = fixtureDigest(\"test-provider-manifest\")\n47|\tfixtureAdapterDigest    = fixtureDigest(\"test-adapter-manifest\")\n48|\tfixtureTupleRegistry    = fixtureDigest(\"test-tuple-registry\")\n49|\tfixturePolicyDigest     = fixtureDigest(\"test-policy\")\n50|\tfixtureRedactionDigest  = fixtureDigest(\"test-redaction-policy\")\n51|\tfixtureEnrichmentDigest = fixtureDigest(\"test-enrichment-profile\")\n52|\tfixtureEvidenceDigest   = fixtureDigest(\"test-evidence\")\n53|\tfixtureInstallDigestA   = fixtureDigest(\"test-install-a\")\n54|\tfixtureInstallDigestB   = fixtureDigest(\"test-install-b\")\n55|\tfixtureBatchDigest      = fixtureDigest(\"test-batch\")\n56|\tfixtureNativeDigestA    = fixtureDigest(\"test-native-a\")\n57|\tfixtureHeadDigest       = fixtureDigest(\"test-head\")\n58|\tfixturePlanDigest       = fixtureDigest(\"test-plan\")\n59|)\n60|\n61|// fixtureRequestFrame builds one hand-written request envelope for\n62|// the given wire version string, operation, and body.\n63|func fixtureRequestFrame(version, operation, requestID string, deadline uint64, body string) []byte {\n64|\treturn []byte(fmt.Sprintf(`{\"schema\":\"urn:ax:schema:session-directory-node-request\",\"schema_version\":%q,\"protocol\":\"urn:ax:protocol:session-directory-node\",\"protocol_version\":%q,\"request_id\":%q,\"operation\":%q,\"deadline_ms\":%d,\"body\":%s}`,\n65|\t\tversion, version, requestID, operation, deadline, body))\n66|}\n67|\n68|// fixtureManifestJSON builds one complete valid manifest. The\n69|// supported versions name both majors; the operations list is the\n70|// sorted eleven-name registry; the schemas list carries fifteen\n71|// minimal assertions; every capability is available with null\n72|// reason except conditional and unknown rows that prove the\n73|// reason-coherence rule in the positive direction.\n74|func fixtureManifestJSON() string {\n75|\tvar assertions []string\n76|\tfor index := 0; index < 15; index++ {\n77|\t\tassertions = append(assertions, fmt.Sprintf(`{\"contract_id\":\"urn:ax:schema:contract-%02d\",\"exact_version\":\"1.0.%d\",\"extensions\":{}}`, index, index))\n78|\t}\n79|\toperations := []string{\n80|\t\t\"continuation-inspect\", \"doctor\", \"enrichment-plan\", \"enrichment-run\",\n81|\t\t\"enrichment-status\", \"inventory\", \"manifest\", \"preview\", \"probe\",\n82|\t\t\"runtime-observe\", \"scan\",\n83|\t}\n84|\tops := make([]string, 0, len(operations))\n85|\tfor _, name := range operations {\n86|\t\tops = append(ops, fmt.Sprintf(\"%q\", name))\n87|\t}\n88|\tcapabilities := []string{\n89|\t\t`\"directory_discovery\":{\"status\":\"available\",\"reason_code\":null,\"evidence_ids\":[],\"observed_at\":\"2026-08-19T04:05:00.000Z\",\"extensions\":{}}`,\n90|\t\tfmt.Sprintf(`\"directory_incremental_scan\":{\"status\":\"available\",\"reason_code\":null,\"evidence_ids\":[%q],\"observed_at\":\"2026-08-19T04:05:00.000Z\",\"extensions\":{}}`, fixtureEvidenceDigest),\n91|\t\t`\"directory_head_digest\":{\"status\":\"conditional\",\"reason_code\":\"needs-quiesce\",\"evidence_ids\":[],\"observed_at\":\"2026-08-19T04:05:00.000Z\",\"extensions\":{}}`,\n92|\t\t`\"directory_tail_preview\":{\"status\":\"unavailable\",\"reason_code\":\"not-probed\",\"evidence_ids\":[],\"observed_at\":\"2026-08-19T04:05:00.000Z\",\"extensions\":{}}`,\n93|\t\t`\"native_title_read\":{\"status\":\"available\",\"reason_code\":null,\"evidence_ids\":[],\"observed_at\":\"2026-08-19T04:05:00.000Z\",\"extensions\":{}}`,\n94|\t\t`\"native_runtime_observation\":{\"status\":\"unknown\",\"reason_code\":\"no-evidence\",\"evidence_ids\":[],\"observed_at\":\"2026-08-19T04:05:00.000Z\",\"extensions\":{}}`,\n95|\t\t`\"existing_session_adoption\":{\"status\":\"available\",\"reason_code\":null,\"evidence_ids\":[],\"observed_at\":\"2026-08-19T04:05:00.000Z\",\"extensions\":{}}`,\n96|\t\t`\"native_resume\":{\"status\":\"available\",\"reason_code\":null,\"evidence_ids\":[],\"observed_at\":\"2026-08-19T04:05:00.000Z\",\"extensions\":{}}`,\n97|\t}\n98|\treturn fmt.Sprintf(`{\"schema\":\"urn:ax:schema:session-directory-node-manifest\",\"schema_version\":\"1.0.0\",\"node_id\":%q,\"node_version\":%q,\"host_id\":%q,\"executable_sha256\":%q,\"provider_manifest_digest\":%q,\"session_adapter_manifest_digest\":%q,\"supported_protocol_versions\":[\"1.0.0\",\"2.0.0\"],\"operations\":[%s],\"schemas\":[%s],\"environment_tuple_registry_id\":%q,\"capabilities\":{%s},\"redaction_policy_ids\":[%q],\"enrichment_profile_ids\":[%q],\"limits\":{\"max_frame_bytes\":8388608,\"max_scan_instances\":65536,\"max_inventory_take\":1000,\"max_excerpt_count\":20,\"max_excerpt_bytes\":4096,\"max_enrichment_events\":5000,\"max_enrichment_bytes\":4194304,\"extensions\":{}},\"extensions\":{}}`,\n99|\t\tfixtureNodeID, fixtureNodeVersion, fixtureHostID,\n100|\t\tfixtureExecutableDigest, fixtureProviderDigest, fixtureAdapterDigest,\n101|\t\tstrings.Join(ops, \",\"), strings.Join(assertions, \",\"),\n102|\t\tfixtureTupleRegistry, strings.Join(capabilities, \",\"),\n103|\t\tfixtureRedactionDigest, fixtureEnrichmentDigest)\n104|}\n105|\n106|// fixtureObservedFacade returns the observed facts matching the\n107|// fixture manifest bindings.\n108|func fixtureObservedFacade() ObservedFacade {\n109|\treturn ObservedFacade{\n110|\t\tExecutableSHA256:       fixtureExecutableDigest,\n111|\t\tProviderManifestDigest: fixtureProviderDigest,\n112|\t\tSessionAdapterDigest:   fixtureAdapterDigest,\n113|\t}\n114|}\n115|\n116|// fixtureSuccessFrame wraps a body in a hand-written success\n117|// envelope echoing the given request identity.\n118|func fixtureSuccessFrame(version, operation, requestID, body string) []byte {\n119|\treturn []byte(fmt.Sprintf(`{\"schema\":\"urn:ax:schema:session-directory-node-response\",\"schema_version\":\"1.0.0\",\"protocol\":\"urn:ax:protocol:session-directory-node\",\"protocol_version\":%q,\"request_id\":%q,\"operation\":%q,\"ok\":true,\"body\":%s}`,\n120|\t\tversion, requestID, operation, body))\n121|}\n122|\n123|// fixtureErrorObject builds one hand-written Structured Error 1.2.0\n124|// object with independently chosen literals.\n125|func fixtureErrorObject(code string, exit int, retryable bool) string {\n126|\treturn fmt.Sprintf(`{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.2.0\",\"code\":%q,\"message\":\"fixture %s\",\"exit_code\":%d,\"retryable\":%v,\"details\":{}}`,\n127|\t\tcode, code, exit, retryable)\n128|}\n129|\n130|// fixtureFailureFrame wraps an error object in a hand-written\n131|// failure envelope echoing the given request identity.\n132|func fixtureFailureFrame(version, operation, requestID, errorObject string) []byte {\n133|\treturn []byte(fmt.Sprintf(`{\"schema\":\"urn:ax:schema:session-directory-node-response\",\"schema_version\":\"1.0.0\",\"protocol\":\"urn:ax:protocol:session-directory-node\",\"protocol_version\":%q,\"request_id\":%q,\"operation\":%q,\"ok\":false,\"error\":%s}`,\n134|\t\tversion, requestID, operation, errorObject))\n135|}\n136|\n137|// fixtureDowngradeFrame is the exact downgrade tuple for the given\n138|// major: failure echo plus incompatible_protocol, exit 6,\n139|// retryable=false.\n140|func fixtureDowngradeFrame(version, requestID string) []byte {\n141|\treturn fixtureFailureFrame(version, \"manifest\", requestID, fixtureErrorObject(\"incompatible_protocol\", 6, false))\n142|}\n143|\n144|// fixtureProbeRequestV2 is one valid Request 2.0.0 probe body.\n145|func fixtureProbeRequestV2() string {\n146|\treturn `{\"platform\":\"linux\",\"architecture\":\"amd64\",\"requested_environment_ids\":[],\"requested_capabilities\":[\"directory_discovery\"],\"extensions\":{}}`\n147|}\n148|\n149|// fixtureProbeRequestV1 is one valid Request 1.0.0 probe body.\n150|func fixtureProbeRequestV1() string {\n151|\treturn `{\"platform\":\"darwin\",\"architecture\":\"arm64\",\"requested_environment_ids\":[],\"requested_capabilities\":[],\"extensions\":{}}`\n152|}\n153|\n154|// fixtureProbeResponseJSON is one valid probe success body whose\n155|// node build equals the fixture manifest.\n156|func fixtureProbeResponseJSON() string {\n157|\treturn fmt.Sprintf(`{\"host_id\":%q,\"node_build\":{\"node_id\":%q,\"node_version\":%q,\"executable_sha256\":%q,\"provider_manifest_digest\":%q,\"session_adapter_manifest_digest\":%q,\"extensions\":{}},\"policy_digest\":%q,\"environments\":[{\"environment_id\":\"test.env\"}],\"findings\":[{\"severity\":\"info\",\"code\":\"probe-ok\",\"message\":\"probe completed\",\"remediation\":null,\"extensions\":{}}],\"extensions\":{}}`,\n158|\t\tfixtureHostID, fixtureNodeID, fixtureNodeVersion,\n159|\t\tfixtureExecutableDigest, fixtureProviderDigest, fixtureAdapterDigest,\n160|\t\tfixturePolicyDigest)\n161|}\n162|\n163|// fixtureScanRequestJSON is one valid scan request body. The\n164|// installation pair emits in sorted order: the sortedness verdict\n165|// belongs to production, and the builder arranges a valid vector\n166|// without retyping production's table.\n167|func fixtureScanRequestJSON() string {\n168|\tpair := []string{fixtureInstallDigestA, fixtureInstallDigestB}\n169|\tsort.Strings(pair)\n170|\treturn fmt.Sprintf(`{\"operation_id\":%q,\"installation_ids\":[%q,%q],\"prior_batch_id\":null,\"cursor\":null,\"max_instances\":100,\"extensions\":{}}`,\n171|\t\tfixtureOperationID, pair[0], pair[1])\n172|}\n173|\n174|// fixtureScanResponseJSON is one valid scan success body.\n175|func fixtureScanResponseJSON() string {\n176|\treturn fmt.Sprintf(`{\"batch\":{\"batch_id\":%q},\"environment_observation_ids\":[%q],\"native_observation_ids\":[%q],\"next_cursor\":null,\"extensions\":{}}`,\n177|\t\tfixtureBatchDigest, fixtureEvidenceDigest, fixtureNativeDigestA)\n178|}\n179|\n180|// fixtureCallerJSON is one valid CallerContext.\n181|func fixtureCallerJSON() string {\n182|\treturn fmt.Sprintf(`{\"caller_id\":\"test-caller\",\"authentication_subject\":\"test-subject\",\"origin_host_id\":%q,\"interaction\":\"non_interactive\",\"scopes\":[\"directory.read\"],\"disclosure_policy_digest\":%q,\"extensions\":{}}`,\n183|\t\tfixtureOriginHost, fixturePolicyDigest)\n184|}\n185|\n186|// fixtureQueryJSON is one valid two-operation batch: a schema read\n187|// and a sessions read with filters.\n188|func fixtureQueryJSON() string {\n189|\treturn fmt.Sprintf(`{\"schema\":\"urn:ax:schema:session-directory-query\",\"schema_version\":\"1.0.0\",\"query_id\":%q,\"operations\":[{\"operation_index\":0,\"name\":\"schema\",\"parameters\":{\"extensions\":{}},\"fields\":null,\"preset\":null,\"skip\":0,\"take\":1,\"sort\":[],\"dry_run\":false,\"confirm\":false,\"expectation_digest\":null,\"idempotency_key\":null,\"extensions\":{}},{\"operation_index\":1,\"name\":\"sessions\",\"parameters\":{\"filters\":{\"kinds\":[],\"lineage_anchors\":[],\"provider_ids\":[],\"host_ids\":[],\"workspace_ids\":[],\"states\":[],\"management_states\":[],\"reachability\":[],\"freshness\":[],\"warnings\":[],\"updated_before\":null,\"updated_after\":null,\"extensions\":{}},\"extensions\":{}},\"fields\":null,\"preset\":\"overview\",\"skip\":0,\"take\":10,\"sort\":[{\"field\":\"stable_id\",\"direction\":\"asc\",\"extensions\":{}}],\"dry_run\":false,\"confirm\":false,\"expectation_digest\":null,\"idempotency_key\":null,\"extensions\":{}}],\"caller\":%s,\"extensions\":{}}`,\n190|\t\tfixtureQueryID, fixtureCallerJSON())\n191|}\n192|\n193|// replaceOnce substitutes the first occurrence like strings.Replace,\n194|// but fails the test when the needle is absent or the count is not\n195|// one: a fixture-surgery vector that mutates nothing would otherwise\n196|// pass vacuously against a still-valid body, measuring the scanner\n197|// instead of the gate.\n198|func replaceOnce(t *testing.T, haystack, needle, replacement string, n int) string {\n199|\tt.Helper()\n200|\tif n != 1 {\n201|\t\tt.Fatalf(\"replaceOnce: count %d is not 1\", n)\n202|\t}\n203|\tif !strings.Contains(haystack, needle) {\n204|\t\tt.Fatalf(\"replaceOnce: needle %q absent; the vector mutates nothing\", needle)\n205|\t}\n206|\treturn strings.Replace(haystack, needle, replacement, n)\n207|}\n208|\n209|// requireAxError unwraps a production refusal into its Structured\n210|// Error, failing the test when the value is a transport-level Go\n211|// error instead of a wire refusal.\n212|func requireAxError(t *testing.T, err error) *axerror.Error {\n213|\tt.Helper()\n214|\tif err == nil {\n215|\t\tt.Fatal(\"want refusal, got nil error\")\n216|\t}\n217|\tfailure, ok := err.(*axerror.Error)\n218|\tif !ok {\n219|\t\tt.Fatalf(\"want *axerror.Error, got %T (%v)\", err, err)\n220|\t}\n221|\treturn failure\n222|}\n223|\n224|// requireCode asserts the refusal code and returns the failure for\n225|// further assertions.\n226|func requireCode(t *testing.T, err error, code axerror.Code) *axerror.Error {\n227|\tt.Helper()\n228|\tfailure := requireAxError(t, err)\n229|\tif failure.Code() != code {\n230|\t\tt.Fatalf(\"refusal code = %q, want %q (detail keys %v)\", failure.Code(), code, failure.DetailKeys())\n231|\t}\n232|\treturn failure\n233|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c585","stream":{"kind":"session","id":"01a07573-a73b-7be0-abe2-6029bca74ffd"},"sequence":285,"recorded_at":1780531400000565,"record_type":"event","durability":"durable","causation_id":"65c281d8-14aa-4def-b705-62e70b4fce66","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"65c281d8-14aa-4def-b705-62e70b4fce66","run_stream":{"kind":"run","id":"65c281d8-14aa-4def-b705-62e70b4fce66"},"call_id":"call_01a0757433547250857a22f84aea949b","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/bound_census_test.go`.\n(149 line(s) above)\n150|// from len(...) or stringLength(...) and guards holding a direct\n151|// stringLength(...) call (review rev6). Scopes are FuncDecl\n152|// bodies and package-level var initializers under their variable\n153|// name. Values are deliberately not part of the identity. A\n154|// func-value indirection of any helper (`var f =\n155|// requireStringBounds`, at package or function scope) is a\n156|// census violation, not a missed site: refusals built through\n157|// the alias hide from this derivation exactly the way\n158|// axerror.New aliases hid from the constructor census (review\n159|// rev4/N8), and the import-census shape applies here — the alias\n160|// itself fails rather than each hidden call. The synthetic\n161|// TestBoundHelperIndirectionReports,\n162|// TestBoundLenScanSeesNonIfContexts, and\n163|// TestBoundLenScanSeesLengthVariables prove the halves.\n164|func scanBoundSiteIDs(t *testing.T, directory string) []string {\n165|\tt.Helper()\n166|\tentries, err := os.ReadDir(directory)\n167|\tif err != nil {\n168|\t\tt.Fatalf(\"bound census: %v\", err)\n169|\t}\n170|\tvar ids []string\n171|\tscanned := 0\n172|\tfor _, entry := range entries {\n173|\t\tname := entry.Name()\n174|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n175|\t\t\tcontinue\n176|\t\t}\n177|\t\tscanned++\n178|\t\tpath := filepath.Join(directory, name)\n179|\t\tsource, err := os.ReadFile(path)\n180|\t\tif err != nil {\n181|\t\t\tt.Fatalf(\"bound census: %v\", err)\n182|\t\t}\n183|\t\tfileSet := token.NewFileSet()\n184|\t\tsyntax, err := parser.ParseFile(fileSet, path, source, 0)\n185|\t\tif err != nil {\n186|\t\t\tt.Fatalf(\"bound census: %v\", err)\n187|\t\t}\n188|\t\tsites, violations := boundSitesInSyntax(syntax, name)\n189|\t\tfor _, violation := range violations {\n190|\t\t\tt.Errorf(\"bound census: %s: %s\", name, violation)\n191|\t\t}\n192|\t\tids = append(ids, sites...)\n193|\t}\n194|\tif scanned == 0 {\n195|\t\tt.Fatal(\"bound census scanned zero production files; the scanner is broken, not the package\")\n196|\t}\n197|\treturn ids\n198|}\n199|\n200|// boundSitesInSyntax derives the bound site identities of one\n201|// parsed production file and reports every helper indirection.\n202|// Direct helper calls claim file|function|helper|member|ordinal;\n203|// DecodeFindings instantiations claim their member; every len\n204|// comparison in any statement context claims\n205|// file|function|len|rendered|ordinal — including comparisons over\n206|// length variables (idents bound from len(...) or\n207|// stringLength(...)) and comparisons holding a direct\n208|// stringLength(...) call (review rev6). Scopes are FuncDecl\n209|// bodies and package-level var initializers under their variable\n210|// name; the per-scope ordinal keeps every existing FuncDecl row\n211|// identical. A use of a helper name that is neither a direct\n212|// call nor one of the six function definitions is an indirection\n213|// violation.\n214|func boundSitesInSyntax(syntax *ast.File, name string) (sites []string, violations []string) {\n215|\tfor _, declaration := range syntax.Decls {\n216|\t\tswitch declaration := declaration.(type) {\n217|\t\tcase *ast.FuncDecl:\n218|\t\t\tif declaration.Body == nil {\n219|\t\t\t\tcontinue\n220|\t\t\t}\n221|\t\t\tsites = append(sites, boundSitesInScope(declaration.Body, name, declaration.Name.Name)...)\n222|\t\tcase *ast.GenDecl:\n223|\t\t\tif declaration.Tok != token.VAR {\n224|\t\t\t\tcontinue\n225|\t\t\t}\n226|\t\t\tfor _, specification := range declaration.Specs {\n227|\t\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n228|\t\t\t\tif !ok {\n229|\t\t\t\t\tcontinue\n230|\t\t\t\t}\n231|\t\t\t\tfor _, ident := range value.Names {\n232|\t\t\t\t\tfor _, expr := range value.Values {\n233|\t\t\t\t\t\tsites = append(sites, boundSitesInScope(expr, name, ident.Name)...)\n234|\t\t\t\t\t}\n235|\t\t\t\t}\n236|\t\t\t}\n237|\t\t}\n238|\t}\n239|\tviolations = append(violations, boundHelperIndirections(syntax)...)\n240|\treturn sites, violations\n241|}\n242|\n243|// boundSitesInScope derives the bound site identities of one\n244|// scope body: helper calls and DecodeFindings instantiations by\n245|// member, len comparisons by rendered shape. Length variables\n246|// are collected first over the same body, so a guard written\n247|// through a variable claims the same len site the direct\n248|// spelling would.\n249|func boundSitesInScope(body ast.Node, name, scope string) []string {\n250|\tvar sites []string\n251|\tordinal := map[string]int{}\n252|\tclaim := func(base string) {\n253|\t\tsites = append(sites, base+\"|\"+strconv.Itoa(ordinal[base]))\n254|\t\tordinal[base]++\n255|\t}\n256|\tast.Inspect(body, func(node ast.Node) bool {\n257|\t\tcall, ok := node.(*ast.CallExpr)\n258|\t\tif !ok {\n259|\t\t\treturn true\n260|\t\t}\n261|\t\tident, ok := call.Fun.(*ast.Ident)\n262|\t\tif !ok {\n263|\t\t\treturn true\n264|\t\t}\n265|\t\tswitch {\n266|\t\tcase boundHelpers[ident.Name]:\n267|\t\t\tclaim(name + \"|\" + scope + \"|\" + ident.Name + \"|\" + boundMemberOf(call, ident.Name))\n268|\t\tcase ident.Name == \"DecodeFindings\":\n269|\t\t\tmember := renderBoundExpr(call.Args[0])\n270|\t\t\tif index, ok := call.Args[0].(*ast.IndexExpr); ok {\n271|\t\t\t\tif literal, ok := index.Index.(*ast.BasicLit); ok && literal.Kind == token.STRING {\n272|\t\t\t\t\tmember = literal.Value\n273|\t\t\t\t}\n274|\t\t\t}\n275|\t\t\tclaim(name + \"|\" + scope + \"|DecodeFindings|\" + member)\n276|\t\t}\n277|\t\treturn true\n278|\t})\n279|\tlengthVars := lengthVarsInScope(body)\n280|\tast.Inspect(body, func(node ast.Node) bool {\n281|\t\tcomparison, ok := node.(*ast.BinaryExpr)\n282|\t\tif !ok {\n283|\t\t\treturn true\n284|\t\t}\n285|\t\tswitch comparison.Op {\n286|\t\tcase token.GTR, token.GEQ, token.LSS, token.LEQ, token.EQL, token.NEQ:\n287|\t\tdefault:\n288|\t\t\treturn true\n289|\t\t}\n290|\t\tif !hasLengthCall(comparison) && !mentionsLengthVar(comparison, lengthVars) {\n291|\t\t\treturn true\n292|\t\t}\n293|\t\tclaim(name + \"|\" + scope + \"|len|\" + normalizeBoundNumbers(renderBoundExpr(comparison)))\n294|\t\treturn true\n295|\t})\n296|\treturn sites\n297|}\n298|\n299|// lengthSourceNames are the package's two length measures: byte\n300|// length and the Section 1.6 character measure. A variable bound\n301|// from either is a length variable for the len-guard derivation.\n302|// cap(...) and a direct utf8.RuneCountInString(...) call are not\n303|// sources (shape 10 of the census header): neither is used as a\n304|// bound in production.\n305|var lengthSourceNames = map[string]bool{\"len\": true, \"stringLength\": true}\n306|\n307|// isLengthSourceCall reports whether the expression calls one of\n308|// the length measures.\n309|func isLengthSourceCall(expr ast.Expr) bool {\n310|\tcall, ok := expr.(*ast.CallExpr)\n311|\tif !ok {\n312|\t\treturn false\n313|\t}\n314|\tident, ok := call.Fun.(*ast.Ident)\n315|\treturn ok && lengthSourceNames[ident.Name]\n316|}\n317|\n318|// numericConversions are the builtin conversions a length may be\n319|// wrapped in at the binding (`n := uint64(len(v))`) without\n320|// stopping being a length.\n321|var numericConversions = map[string]bool{\n322|\t\"int\": true, \"int8\": true, \"int16\": true, \"int32\": true, \"int64\": true,\n323|\t\"uint\": true, \"uint8\": true, \"uint16\": true, \"uint32\": true, \"uint64\": true,\n324|\t\"float32\": true, \"float64\": true, \"byte\": true, \"rune\": true, \"uintptr\": true,\n325|}\n326|\n327|// lengthBoundValue reports whether the right-hand side binds a\n328|// length: a length-source call, possibly through parentheses or\n329|// one builtin numeric conversion. Anything else — a slice built\n330|// with a len capacity (`values := make([]T, 0, len(x))`), a\n331|// length combined arithmetically before binding, a decoded\n332|// value — binds no length variable, so element comparisons over\n333|// such names never claim a len site.\n334|func lengthBoundValue(rhs ast.Expr) bool {\n335|\tfor {\n336|\t\tparen, ok := rhs.(*ast.ParenExpr)\n337|\t\tif !ok {\n338|\t\t\tbreak\n339|\t\t}\n340|\t\trhs = paren.X\n341|\t}\n342|\tif isLengthSourceCall(rhs) {\n343|\t\treturn true\n344|\t}\n345|\tcall, ok := rhs.(*ast.CallExpr)\n346|\tif !ok || len(call.Args) != 1 {\n347|\t\treturn false\n348|\t}\n349|\tident, ok := call.Fun.(*ast.Ident)\n350|\treturn ok && numericConversions[ident.Name] && isLengthSourceCall(call.Args[0])\n351|}\n352|\n353|// hasLengthCall reports whether the subtree calls a length\n354|// measure: len(...) or stringLength(...).\n355|func hasLengthCall(node ast.Node) bool {\n356|\tfound := false\n357|\tast.Inspect(node, func(inner ast.Node) bool {\n358|\t\tif expr, ok := inner.(ast.Expr); ok && isLengthSourceCall(expr) {\n359|\t\t\tfound = true\n360|\t\t\treturn false\n361|\t\t}\n362|\t\treturn true\n363|\t})\n364|\treturn found\n365|}\n366|\n367|// lengthVarsInScope collects the idents bound from a length\n368|// measure anywhere in one scope body: `n := len(v)`, `n =\n369|// len(v)`, and `var n = len(v)` (and the same through\n370|// stringLength). Only a direct binding counts (see\n371|// lengthBoundValue): the rule is deliberately scope-wide and\n372|// sticky — a variable bound from a length stays a length\n373|// variable even if later reassigned, and shadowing is not\n374|// tracked. That can only over-derive — a repurposed length name\n375|// claims a site that needs a row — never silently miss the\n376|// review-rev6 plant shape.\n377|func lengthVarsInScope(body ast.Node) map[string]bool {\n378|\tvars := map[string]bool{}\n379|\tbindIdents := func(names []*ast.Ident, values []ast.Expr) {\n380|\t\tfor index, ident := range names {\n381|\t\t\tif ident == nil || ident.Name == \"_\" {\n382|\t\t\t\tcontinue\n383|\t\t\t}\n384|\t\t\tvar rhs ast.Expr\n385|\t\t\tswitch {\n386|\t\t\tcase len(values) == 1:\n387|\t\t\t\trhs = values[0]\n388|\t\t\tcase index < len(values):\n389|\t\t\t\trhs = values[index]\n390|\t\t\t}\n391|\t\t\tif rhs != nil && lengthBoundValue(rhs) {\n392|\t\t\t\tvars[ident.Name] = true\n393|\t\t\t}\n394|\t\t}\n395|\t}\n396|\tast.Inspect(body, func(node ast.Node) bool {\n397|\t\tswitch node := node.(type) {\n398|\t\tcase *ast.AssignStmt:\n399|\t\t\tnames := make([]*ast.Ident, len(node.Lhs))\n400|\t\t\tfor index, lhs := range node.Lhs {\n401|\t\t\t\t// A non-ident target (a selector, an index)\n402|\t\t\t\t// holds no variable; its paired value is\n403|\t\t\t\t// simply unattributed.\n404|\t\t\t\tident, _ := lhs.(*ast.Ident)\n405|\t\t\t\tnames[index] = ident\n406|\t\t\t}\n407|\t\t\tbindIdents(names, node.Rhs)\n408|\t\tcase *ast.ValueSpec:\n409|\t\t\tbindIdents(node.Names, node.Values)\n410|\t\t}\n411|\t\treturn true\n412|\t})\n413|\treturn vars\n414|}\n415|\n416|// mentionsLengthVar reports whether the subtree reads one of the\n417|// collected length variables.\n418|func mentionsLengthVar(node ast.Node, vars map[string]bool) bool {\n419|\tfound := false\n420|\tast.Inspect(node, func(inner ast.Node) bool {\n421|\t\tif ident, ok := inner.(*ast.Ident); ok && vars[ident.Name] {\n422|\t\t\tfound = true\n423|\t\t\treturn false\n424|\t\t}\n425|\t\treturn true\n426|\t})\n427|\treturn found\n428|}\n429|\n430|// boundHelperIndirections reports every func-value indirection\n431|// of the six bound helpers in one parsed file: any use of a\n432|// helper name that is neither a direct call (the identifier is\n433|// the Fun of its enclosing call) nor one of the six function\n434|// definitions. The rule is positional, so it covers var and :=\n435|// bindings at package and function scope, plain assignments,\n436|// arguments, and return values uniformly — the same shape as the\n437|// constructor census indirection check it is ported from.\n438|func boundHelperIndirections(syntax *ast.File) []string {\n439|\tdefinitions := map[*ast.Ident]bool{}\n440|\tfor _, declaration := range syntax.Decls {\n441|\t\tfunction, ok := declaration.(*ast.FuncDecl)\n442|\t\tif !ok || !boundHelpers[function.Name.Name] {\n443|\t\t\tcontinue\n444|\t\t}\n445|\t\tdefinitions[function.Name] = true\n446|\t}\n447|\tvar violations []string\n448|\tvar stack []ast.Node\n449|\tast.Inspect(syntax, func(node ast.Node) bool {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
