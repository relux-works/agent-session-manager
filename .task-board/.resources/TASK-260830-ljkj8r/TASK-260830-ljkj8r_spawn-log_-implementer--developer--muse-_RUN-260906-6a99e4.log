{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c81b","stream":{"kind":"session","id":"01a075af-a7c5-7382-ae46-5efb02855e33"},"sequence":616,"recorded_at":1780531400001227,"record_type":"event","durability":"durable","causation_id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589","run_stream":{"kind":"run","id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589"},"task_stream":{"kind":"task","id":"9e3691e8-ec22-4353-8039-15ff0e3db06a"},"task_id":"9e3691e8-ec22-4353-8039-15ff0e3db06a","event":{"kind":"output","task_id":"9e3691e8-ec22-4353-8039-15ff0e3db06a","chunk":"Read text file `internal/dirnode/query_operations_test.go`.\n1|package dirnode\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"sort\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|)\n9|\n10|// This file derives the Section 10.8.5 operation obligation set\n11|// (review round 2, B2): DecodeQuery reports every operation-level\n12|// defect through the single checkQueryOperation arm (\"directory\n13|// query operation is not a closed QueryOperation\"), so the census\n14|// stays green while individual parameter validators sit at zero\n15|// coverage. The obligation set is the seventeen-operation union of\n16|// queryParameterMembers — eleven reads plus six mutations — and\n17|// every member is driven below through the production DecodeQuery\n18|// entry, both admitted in its valid shape and refused with a\n19|// validator-specific defect. An operation missing from the\n20|// admission table fails TestDecodeQueryAllOperationsAdmit; a\n21|// validator admitting its probe fails the refusal table. The\n22|// three review-named narrowing probes are rows here:\n23|// environments authentication_status [\"root\"], jobs states\n24|// [\"pwned\"], and distinct field \"secret\" must all refuse.\n25|\n26|// validFiltersJSON is one valid DirectoryFilters body shared by\n27|// the filter-carrying operations.\n28|var validFiltersJSON = `{\"kinds\":[],\"lineage_anchors\":[],\"provider_ids\":[],\"host_ids\":[],\"workspace_ids\":[],\"states\":[],\"management_states\":[],\"reachability\":[],\"freshness\":[],\"warnings\":[],\"updated_before\":null,\"updated_after\":null,\"extensions\":{}}`\n29|\n30|// queryOperationJSON renders one closed QueryOperation element.\n31|func queryOperationJSON(index int, name, params, fields, preset string, skip, take int, sort, dryRun, confirm, expectation, idempotency string) string {\n32|\treturn fmt.Sprintf(`{\"operation_index\":%d,\"name\":%q,\"parameters\":%s,\"fields\":%s,\"preset\":%s,\"skip\":%d,\"take\":%d,\"sort\":%s,\"dry_run\":%s,\"confirm\":%s,\"expectation_digest\":%s,\"idempotency_key\":%s,\"extensions\":{}}`,\n33|\t\tindex, name, params, fields, preset, skip, take, sort, dryRun, confirm, expectation, idempotency)\n34|}\n35|\n36|// singleOperationBatch wraps one operation in a valid query batch.\n37|func singleOperationBatch(name, params, fields, preset string, skip, take int, sort, dryRun, confirm, expectation, idempotency string) string {\n38|\treturn `{\"schema\":\"urn:ax:schema:session-directory-query\",\"schema_version\":\"1.0.0\",\"query_id\":` + quote(fixtureQueryID) + `,\"operations\":[` + queryOperationJSON(0, name, params, fields, preset, skip, take, sort, dryRun, confirm, expectation, idempotency) + `],\"caller\":` + fixtureCallerJSON() + `,\"extensions\":{}}`\n39|}\n40|\n41|// readBatch builds a valid read batch: list operations page,\n42|// singular reads require skip=0 and take=1.\n43|func readBatch(name, params string, list bool) string {\n44|\ttake := 1\n45|\tif list {\n46|\t\ttake = 10\n47|\t}\n48|\treturn singleOperationBatch(name, params, \"null\", \"null\", 0, take, \"[]\", \"false\", \"false\", \"null\", \"null\")\n49|}\n50|\n51|// sessionSubjectParams builds subject parameters for the named\n52|// subject kind with a UUIDv7 identifier.\n53|func sessionSubjectParams(kind string) string {\n54|\treturn `{\"subject_kind\":` + quote(kind) + `,\"subject_id\":` + quote(fixtureQueryID) + `,\"extensions\":{}}`\n55|}\n56|\n57|// operationParams builds the valid parameter body per operation in\n58|// Section 10.8.5 table order. Every literal is retyped from the\n59|// contract, never referenced from production constants.\n60|func operationParams(name string) string {\n61|\tdigest := quote(fixtureBatchDigest)\n62|\tuuid := quote(fixtureQueryID)\n63|\thost := quote(fixtureOriginHost)\n64|\tswitch name {\n65|\tcase \"schema\", \"directory_summary\":\n66|\t\treturn `{\"extensions\":{}}`\n67|\tcase \"sessions\", \"count\":\n68|\t\treturn `{\"filters\":` + validFiltersJSON + `,\"extensions\":{}}`\n69|\tcase \"session\":\n70|\t\treturn sessionSubjectParams(\"ax_session\")\n71|\tcase \"lineage\":\n72|\t\treturn `{\"anchor_id\":` + uuid + `,\"include_suggestions\":false,\"extensions\":{}}`\n73|\tcase \"hosts\":\n74|\t\treturn `{\"host_ids\":[],\"reachable\":null,\"extensions\":{}}`\n75|\tcase \"environments\":\n76|\t\treturn `{\"host_ids\":[],\"environment_ids\":[],\"authentication_status\":[],\"extensions\":{}}`\n77|\tcase \"jobs\":\n78|\t\treturn `{\"job_ids\":[],\"profile_ids\":[],\"states\":[],\"extensions\":{}}`\n79|\tcase \"plans\":\n80|\t\treturn `{\"plan_ids\":[],\"operation_ids\":[],\"include_expired\":false,\"extensions\":{}}`\n81|\tcase \"distinct\":\n82|\t\treturn `{\"field\":\"kind\",\"filters\":` + validFiltersJSON + `,\"extensions\":{}}`\n83|\tcase \"set_title\":\n84|\t\treturn `{\"subject_kind\":\"ax_session\",\"subject_id\":` + uuid + `,\"title\":\"T\",\"supersedes_annotation_ids\":[],\"extensions\":{}}`\n85|\tcase \"set_tags\":\n86|\t\treturn `{\"subject_kind\":\"ax_session\",\"subject_id\":` + uuid + `,\"tags\":[],\"supersedes_annotation_ids\":[],\"extensions\":{}}`\n87|\tcase \"set_pin\":\n88|\t\treturn `{\"subject_kind\":\"ax_session\",\"subject_id\":` + uuid + `,\"value\":true,\"supersedes_annotation_ids\":[],\"extensions\":{}}`\n89|\tcase \"enrich\":\n90|\t\treturn `{\"subject_kind\":\"ax_session\",\"subject_id\":` + uuid + `,\"profile_id\":` + digest + `,\"kinds\":[\"summary\"],\"expected_head_digest\":` + digest + `,\"extensions\":{}}`\n91|\tcase \"plan_continue\":\n92|\t\treturn `{\"subject_kind\":\"ax_session\",\"subject_id\":` + uuid + `,\"source_instance_id\":` + digest + `,\"to_host_id\":` + host + `,\"to_installation_id\":` + digest + `,\"intent\":\"resume\",\"workspace_policy\":\"exact_checkpoint\",\"source_after_success\":\"retain\",\"extensions\":{}}`\n93|\tcase \"execute_plan\":\n94|\t\treturn `{\"plan_id\":` + digest + `,\"operation_id\":` + quote(fixtureOperationID) + `,\"confirmations\":[],\"extensions\":{}}`\n95|\tdefault:\n96|\t\treturn \"\"\n97|\t}\n98|}\n99|\n100|// refuseBatch wraps caller-supplied parameters in the valid\n101|// framing for the named operation, so the refusal is attributable\n102|// to the parameters rather than the envelope.\n103|func refuseBatch(name, params string) string {\n104|\tswitch name {\n105|\tcase \"sessions\", \"lineage\", \"hosts\", \"environments\", \"jobs\", \"plans\":\n106|\t\treturn readBatch(name, params, true)\n107|\tcase \"schema\", \"session\", \"count\", \"distinct\", \"directory_summary\":\n108|\t\treturn readBatch(name, params, false)\n109|\tcase \"execute_plan\":\n110|\t\tdigest := quote(fixtureBatchDigest)\n111|\t\treturn mutationBatch(name, params, false, true, digest, digest)\n112|\tdefault:\n113|\t\treturn mutationBatch(name, params, true, false, \"null\", \"null\")\n114|\t}\n115|}\n116|\n117|// operationBatch builds the valid single-operation batch for the\n118|// named operation with its pagination and flag rules.\n119|func operationBatch(name string) string {\n120|\treturn refuseBatch(name, operationParams(name))\n121|}\n122|\n123|// badParams substitutes one needle inside the valid parameters of\n124|// the named operation, failing when the needle is absent so the\n125|// vector cannot pass vacuously against a still-valid body.\n126|func badParams(t *testing.T, name, needle, replacement string) string {\n127|\tt.Helper()\n128|\tgood := operationParams(name)\n129|\tif !strings.Contains(good, needle) {\n130|\t\tt.Fatalf(\"badParams(%s): needle %q absent; the vector mutates nothing\", name, needle)\n131|\t}\n132|\treturn strings.Replace(good, needle, replacement, 1)\n133|}\n134|\n135|// sortedLiterals builds n sorted unique JSON string literals with\n136|// zero-padded numeric suffixes, so the sortedness gate stays\n137|// green while the count sweeps.\n138|func sortedLiterals(prefix string, n int) string {\n139|\tparts := make([]string, 0, n)\n140|\tfor i := 0; i < n; i++ {\n141|\t\tparts = append(parts, fmt.Sprintf(\"%q\", fmt.Sprintf(\"%s-%05d\", prefix, i)))\n142|\t}\n143|\treturn `[` + strings.Join(parts, \",\") + `]`\n144|}\n145|\n146|// TestDecodeQueryAllOperationsAdmit drives every member of the\n147|// seventeen-operation union through the production DecodeQuery\n148|// entry in its valid shape. The table is checked against the\n149|// production registry union, so an operation with no row fails\n150|// here rather than sitting at zero coverage behind the shared\n151|// operation arm.\n152|func TestDecodeQueryAllOperationsAdmit(t *testing.T) {\n153|\tt.Parallel()\n154|\tunion := append(append([]string(nil), readOperations...), mutationOperations...)\n155|\tif len(union) != 17 {\n156|\t\tt.Fatalf(\"query union = %d operations, want 17; the derivation is broken, not the registry\", len(union))\n157|\t}\n158|\tfor _, name := range union {\n159|\t\tname := name\n160|\t\tt.Run(name, func(t *testing.T) {\n161|\t\t\tt.Parallel()\n162|\t\t\tbatch := operationBatch(name)\n163|\t\t\tif batch == \"\" {\n164|\t\t\t\tt.Fatalf(\"no parameter builder for %q; the obligation set is short, not the registry\", name)\n165|\t\t\t}\n166|\t\t\tquery, err := DecodeQuery([]byte(batch))\n167|\t\t\tif err != nil {\n168|\t\t\t\tt.Fatalf(\"DecodeQuery(%s) error = %v\", name, err)\n169|\t\t\t}\n170|\t\t\tif len(query.Operations) != 1 || query.Operations[0].Name != name || query.Operations[0].Index != 0 {\n171|\t\t\t\tt.Fatalf(\"operations = %+v, want the single %q operation at index 0\", query.Operations, name)\n172|\t\t\t}\n173|\t\t\tkind, known := queryOperationKindOf(name)\n174|\t\t\tif !known {\n175|\t\t\t\tt.Fatalf(\"%q is not a registry member\", name)\n176|\t\t\t}\n177|\t\t\tif query.Operations[0].Kind != kind {\n178|\t\t\t\tt.Fatalf(\"kind = %q, want %q\", query.Operations[0].Kind, kind)\n179|\t\t\t}\n180|\t\t})\n181|\t}\n182|}\n183|\n184|// TestDecodeQueryOperationValidatorsRefuse drives one\n185|// validator-specific defect per row through the production\n186|// DecodeQuery entry. Every row must refuse with query_invalid: a\n187|// validator admitting its probe — including the three\n188|// review-named narrowing probes \"root\", \"pwned\", and \"secret\" —\n189|// fails here.\n190|func TestDecodeQueryOperationValidatorsRefuse(t *testing.T) {\n191|\tt.Parallel()\n192|\tpair := []string{fixtureInstallDigestA, fixtureInstallDigestB}\n193|\tsort.Strings(pair)\n194|\tif pair[0] == pair[1] {\n195|\t\tt.Fatal(\"fixture installation digests collide; the unsorted vector is unbuildable\")\n196|\t}\n197|\tunsortedSupersedes := `[` + quote(pair[1]) + `,` + quote(pair[0]) + `]`\n198|\t// filterWith substitutes one needle inside the valid filters\n199|\t// body of the sessions parameters.\n200|\tfilterWith := func(t *testing.T, needle, replacement string) string {\n201|\t\tt.Helper()\n202|\t\tparams := operationParams(\"sessions\")\n203|\t\tif !strings.Contains(params, needle) {\n204|\t\t\tt.Fatalf(\"filter needle %q absent; the vector mutates nothing\", needle)\n205|\t\t}\n206|\t\treturn refuseBatch(\"sessions\", strings.Replace(params, needle, replacement, 1))\n207|\t}\n208|\trows := []struct {\n209|\t\tname  string\n210|\t\tbuild func(t *testing.T) string\n211|\t}{\n212|\t\t{\"schema extra parameter\", func(t *testing.T) string {\n213|\t\t\treturn refuseBatch(\"schema\", `{\"extensions\":{},\"extra\":1}`)\n214|\t\t}},\n215|\t\t{\"directory summary extra parameter\", func(t *testing.T) string {\n216|\t\t\treturn refuseBatch(\"directory_summary\", `{\"extensions\":{},\"extra\":1}`)\n217|\t\t}},\n218|\t\t{\"sessions bad reachability\", func(t *testing.T) string {\n219|\t\t\treturn filterWith(t, `\"reachability\":[]`, `\"reachability\":[\"everywhere\"]`)\n220|\t\t}},\n221|\t\t{\"sessions bad provider id\", func(t *testing.T) string {\n222|\t\t\treturn filterWith(t, `\"provider_ids\":[]`, `\"provider_ids\":[\"BAD\"]`)\n223|\t\t}},\n224|\t\t{\"sessions bad kind\", func(t *testing.T) string {\n225|\t\t\treturn filterWith(t, `\"kinds\":[]`, `\"kinds\":[\"bogus\"]`)\n226|\t\t}},\n227|\t\t{\"sessions bad management state\", func(t *testing.T) string {\n228|\t\t\treturn filterWith(t, `\"management_states\":[]`, `\"management_states\":[\"bogus\"]`)\n229|\t\t}},\n230|\t\t{\"sessions bad freshness\", func(t *testing.T) string {\n231|\t\t\treturn filterWith(t, `\"freshness\":[]`, `\"freshness\":[\"bogus\"]`)\n232|\t\t}},\n233|\t\t{\"sessions bad lineage anchor\", func(t *testing.T) string {\n234|\t\t\treturn filterWith(t, `\"lineage_anchors\":[]`, `\"lineage_anchors\":[\"zzz\"]`)\n235|\t\t}},\n236|\t\t{\"sessions warning past element bound\", func(t *testing.T) string {\n237|\t\t\treturn filterWith(t, `\"warnings\":[]`, `\"warnings\":[`+quote(strings.Repeat(\"w\", 257))+`]`)\n238|\t\t}},\n239|\t\t{\"sessions bad timestamp\", func(t *testing.T) string {\n240|\t\t\treturn filterWith(t, `\"updated_before\":null`, `\"updated_before\":\"yesterday\"`)\n(more lines below)"}}}
