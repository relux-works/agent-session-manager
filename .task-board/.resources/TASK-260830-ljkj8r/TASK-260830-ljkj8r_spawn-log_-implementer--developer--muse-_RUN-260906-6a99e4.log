{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000dfa7","stream":{"kind":"session","id":"01a075af-a7c5-7382-ae46-5efb02855e33"},"sequence":3630,"recorded_at":1780531400007255,"record_type":"event","durability":"durable","causation_id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589","run_stream":{"kind":"run","id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589"},"task_stream":{"kind":"task","id":"dbba7b62-bb98-4ac7-bbcc-f1e3a22f6840"},"task_id":"dbba7b62-bb98-4ac7-bbcc-f1e3a22f6840","event":{"kind":"output","task_id":"dbba7b62-bb98-4ac7-bbcc-f1e3a22f6840","chunk":"{\n  \"chunk_id\": \"exec-119-1\",\n  \"command\": \"python3 - <<'PYEOF'\\npath = 'internal/dirnode/arm_reachability_test.go'\\ntext = open(path).read()\\n\\n# 1. struct comment + rowName + site-count derivation after the struct block\\nstruct_block = 'type armReachRow struct {\\\\n\\\\tarm   string\\\\n\\\\tname  string\\\\n\\\\tdrive func(t *testing.T) error\\\\n\\\\talso  string\\\\n}\\\\n'\\nassert text.count(struct_block) == 1\\nhelpers = struct_block + '''\\n// rowName renders the subtest name for one row: the arm key,\\n// entry-suffixed for the one key emitted at two production sites.\\nfunc (row armReachRow) rowName() string {\\n\\\\tif row.name != \\\"\\\" {\\n\\\\t\\\\treturn row.name\\n\\\\t}\\n\\\\treturn row.arm\\n}\\n\\n// deriveLiteralArmSiteCounts counts production call sites per\\n// literal arm key. Most literals are emitted once; a literal\\n// emitted at two sites shares one arm key, and the roster below\\n// requires one firing vector per emitting site — a row driving\\n// the other site cannot redden when this one is removed.\\nfunc deriveLiteralArmSiteCounts(t *testing.T) map[string]int {\\n\\\\tt.Helper()\\n\\\\tregistered := map[string]bool{}\\n\\\\tfor _, name := range refusalConstructors {\\n\\\\t\\\\tregistered[name] = true\\n\\\\t}\\n\\\\tcounts := map[string]int{}\\n\\\\tfor _, path := range productionFiles(t) {\\n\\\\t\\\\tsource, err := os.ReadFile(path)\\n\\\\t\\\\tif err != nil {\\n\\\\t\\\\t\\\\tt.Fatalf(\\\"site counts: %v\\\", err)\\n\\\\t\\\\t}\\n\\\\t\\\\tsyntax, err := parseGoFile(path, source)\\n\\\\t\\\\tif err != nil {\\n\\\\t\\\\t\\\\tt.Fatalf(\\\"site counts: %v\\\", err)\\n\\\\t\\\\t}\\n\\\\t\\\\tast.Inspect(syntax, func(node ast.Node) bool {\\n\\\\t\\\\t\\\\tfunction, ok := node.(*ast.FuncDecl)\\n\\\\t\\\\t\\\\tif !ok || function.Body == nil {\\n\\\\t\\\\t\\\\t\\\\treturn true\\n\\\\t\\\\t\\\\t}\\n\\\\t\\\\t\\\\tast.Inspect(function.Body, func(inner ast.Node) bool {\\n\\\\t\\\\t\\\\t\\\\tcall, ok := inner.(*ast.CallExpr)\\n\\\\t\\\\t\\\\t\\\\tif !ok {\\n\\\\t\\\\t\\\\t\\\\t\\\\treturn true\\n\\\\t\\\\t\\\\t\\\\t}\\n\\\\t\\\\t\\\\t\\\\ttarget, ok := call.Fun.(*ast.Ident)\\n\\\\t\\\\t\\\\t\\\\tif !ok || !registered[target.Name] || len(call.Args) == 0 {\\n\\\\t\\\\t\\\\t\\\\t\\\\treturn true\\n\\\\t\\\\t\\\\t\\\\t}\\n\\\\t\\\\t\\\\t\\\\tliteral, ok := call.Args[0].(*ast.BasicLit)\\n\\\\t\\\\t\\\\t\\\\tif !ok {\\n\\\\t\\\\t\\\\t\\\\t\\\\treturn true\\n\\\\t\\\\t\\\\t\\\\t}\\n\\\\t\\\\t\\\\t\\\\tcounts[target.Name+\\\"|\\\"+strings.Trim(literal.Value, `\\\"`)]++\\n\\\\t\\\\t\\\\t\\\\treturn true\\n\\\\t\\\\t\\\\t})\\n\\\\t\\\\t\\\\treturn false\\n\\\\t\\\\t})\\n\\\\t}\\n\\\\treturn counts\\n}\\n\\n// literalSubkey renders the site-count lookup key for one derived\\n// literal arm key.\\nfunc literalSubkey(key string) (string, bool) {\\n\\\\trest, ok := strings.CutPrefix(key, \\\"ctor|\\\")\\n\\\\tif !ok {\\n\\\\t\\\\treturn \\\"\\\", false\\n\\\\t}\\n\\\\tseparator := strings.Index(rest, \\\"|\\\")\\n\\\\tif separator < 0 || rest[separator+1:] == \\\"\\\" {\\n\\\\t\\\\treturn \\\"\\\", false\\n\\\\t}\\n\\\\treturn rest[:separator] + \\\"|\\\" + rest[separator+1:], true\\n}\\n'''\\ntext = text.replace(struct_block, helpers, 1)\\n\\n# 2. roster: per-key row counts with literal site-count requirement\\nold_roster = '''\\tseen := map[string]bool{}\\n\\tfor _, row := range rows {\\n\\t\\tif !derived.arms[row.arm] {\\n\\t\\t\\tt.Fatalf(\\\"orphaned reachability row %q: production derives no such arm\\\", row.arm)\\n\\t\\t}\\n\\t\\tif row.also != \\\"\\\" && !derived.arms[row.also] {\\n\\t\\t\\tt.Fatalf(\\\"orphaned reachability carrier %q for row %q\\\", row.also, row.arm)\\n\\t\\t}\\n\\t\\tif _, _, ok := classifyArmKey(row.arm); !ok {\\n\\t\\t\\tt.Fatalf(\\\"unmatchable reachability row %q: unknown key shape\\\", row.arm)\\n\\t\\t}\\n\\t\\tif seen[row.arm] {\\n\\t\\t\\tt.Fatalf(\\\"duplicate reachability row %q: one vector per arm keeps the witness narrow\\\", row.arm)\\n\\t\\t}\\n\\t\\tseen[row.arm] = true\\n\\t}'''\\nassert text.count(old_roster) == 1, 'roster anchor'\\nnew_roster = '''\\tsiteCounts := deriveLiteralArmSiteCounts(t)\\n\\trowsPerKey := map[string]int{}\\n\\tfor _, row := range rows {\\n\\t\\tif !derived.arms[row.arm] {\\n\\t\\t\\tt.Fatalf(\\\"orphaned reachability row %q: production derives no such arm\\\", row.arm)\\n\\t\\t}\\n\\t\\tif row.also != \\\"\\\" && !derived.arms[row.also] {\\n\\t\\t\\tt.Fatalf(\\\"orphaned reachability carrier %q for row %q\\\", row.also, row.arm)\\n\\t\\t}\\n\\t\\tshape, _, ok := classifyArmKey(row.arm)\\n\\t\\tif !ok {\\n\\t\\t\\tt.Fatalf(\\\"unmatchable reachability row %q: unknown key shape\\\", row.arm)\\n\\t\\t}\\n\\t\\tif shape == armShapeFrame {\\n\\t\\t\\tt.Fatalf(\\\"frame row %q: frame faults pin their carrier conduit and carry no vector of their own\\\", row.arm)\\n\\t\\t}\\n\\t\\trowsPerKey[row.arm]++\\n\\t}\\n\\tseen := map[string]bool{}\\n\\tfor key := range derived.arms {\\n\\t\\tshape, _, ok := classifyArmKey(key)\\n\\t\\tif !ok {\\n\\t\\t\\tt.Fatalf(\\\"unmatchable derived arm %q: unknown key shape\\\", key)\\n\\t\\t}\\n\\t\\tif _, defensive := defensiveArms[key]; defensive {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\twant := 1\\n\\t\\tif shape == armShapeLiteral {\\n\\t\\t\\tsubkey, ok := literalSubkey(key)\\n\\t\\t\\tif !ok {\\n\\t\\t\\t\\tt.Fatalf(\\\"unkeyable derived arm %q\\\", key)\\n\\t\\t\\t}\\n\\t\\t\\tsites, ok := siteCounts[subkey]\\n\\t\\t\\tif !ok || sites < 1 {\\n\\t\\t\\t\\tt.Fatalf(\\\"derived arm %q has no counted production site; the counter is broken, not the package\\\", key)\\n\\t\\t\\t}\\n\\t\\t\\twant = sites\\n\\t\\t}\\n\\t\\tif rowsPerKey[key] != want {\\n\\t\\t\\tt.Fatalf(\\\"derived arm %q carries %d rows, want one per emitting site (%d)\\\", key, rowsPerKey[key], want)\\n\\t\\t}\\n\\t\\tseen[key] = true\\n\\t}'''\\ntext = text.replace(old_roster, new_roster, 1)\\n\\n# 3. missing-check uses seen; keep compatible (seen now marks all derived non-defensive keys)\\n# 4. subtest name\\nold_run = '''\\tfor _, row := range rows {\\n\\t\\trow := row\\n\\t\\tt.Run(row.arm, func(t *testing.T) {'''\\nassert text.count(old_run) == 1, 'run anchor'\\ntext = text.replace(old_run, '''\\tfor _, row := range rows {\\n\\t\\trow := row\\n\\t\\tt.Run(row.rowName(), func(t *testing.T) {''', 1)\\n\\nopen(path, 'w').write(text)\\nprint('gate updated')\\nPYEOF\\ngofmt -l internal/dirnode/; go vet ./internal/dirnode/ 2>&1 | head -n 5; echo DONE\",\n  \"description\": \"Add site-count roster and row names\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"gate updated\\nDONE\\n\",\n  \"original_output_bytes\": 18,\n  \"original_output_tokens\": 5,\n  \"truncated\": false\n}"}}}
