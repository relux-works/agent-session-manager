{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5f9","stream":{"kind":"session","id":"01a075af-a7c5-7382-ae46-5efb02855e33"},"sequence":343,"recorded_at":1780531400000681,"record_type":"event","durability":"durable","causation_id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589","run_stream":{"kind":"run","id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589"},"task_stream":{"kind":"task","id":"37763d23-f923-4d35-a6f1-ed69e80335bd"},"task_id":"37763d23-f923-4d35-a6f1-ed69e80335bd","event":{"kind":"output","task_id":"37763d23-f923-4d35-a6f1-ed69e80335bd","chunk":"Read text file `internal/dirnode/arm_identity_test.go`.\n1|package dirnode\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|)\n8|\n9|// This file pins vector reachability against the arm-slide shape\n10|// (review round 2, B3): a negative vector carrying two defects is\n11|// satisfied by whichever arm fires first, and when both arms share\n12|// the same code the code assertion cannot tell them apart. The\n13|// unknown_field vector did exactly this — it inserted a duplicate\n14|// \"fields\" member, so decodeStrictObject refused on the duplicate\n15|// before the field registry ever ran, with the same code and the\n16|// same detail either path reports.\n17|//\n18|// The audit covered every fixture-surgery vector in this package\n19|// that claims a \"missing\" or \"unknown\" outcome:\n20|//\n21|//   - query \"missing caller\", manifest \"missing member\", and probe\n22|//     response \"missing member\" all renamed the member (\",\\\"x\\\":\" to\n23|//     \",\\\"xX\\\":\"). Renaming fires the unknown-member arm first\n24|//     because every envelope checks unknownMember before\n25|//     missingMember, so the missing arm carried a witness that\n26|//     never fired it. All three now delete the member instead, and\n27|//     TestMissingVectorsDriveTheMissingArm asserts the\n28|//     misses-a-required-member message, which a rename vector\n29|//     cannot produce.\n30|//   - scan request/response \"missing member\" vectors already\n31|//     delete, probe request \"missing member\" already deletes, and\n32|//     every \"unknown member\" vector adds exactly one member, so\n33|//     those reach the arm they name.\n34|//   - the operation-level query vectors (unknown operation,\n35|//     parameter, filter, field, preset, sort, flag, pagination)\n36|//     all collapse to the single checkQueryOperation arm by\n37|//     construction; their obligation set is derived and driven\n38|//     member-by-member in query_operations_test.go rather than\n39|//     distinguished by a detail production does not emit.\n40|\n41|// TestMissingVectorsDriveTheMissingArm requires the three\n42|// deletion-built missing vectors to refuse with the missing-member\n43|// message through the production entry. A rename-built vector\n44|// would report \"carries unknown member\" here and fail, so this\n45|// test pins the construction, not just the code.\n46|func TestMissingVectorsDriveTheMissingArm(t *testing.T) {\n47|\tt.Parallel()\n48|\tt.Run(\"query missing caller\", func(t *testing.T) {\n49|\t\tt.Parallel()\n50|\t\tbody := replaceOnce(t, fixtureQueryJSON(), `,\"caller\":`+fixtureCallerJSON(), ``, 1)\n51|\t\t_, err := DecodeQuery([]byte(body))\n52|\t\tfailure := requireCode(t, err, \"query_invalid\")\n53|\t\tif !strings.Contains(failure.Message(), \"misses a required member\") {\n54|\t\t\tt.Fatalf(\"message = %q, want the missing-member arm, not the unknown-member arm\", failure.Message())\n55|\t\t}\n56|\t})\n57|\tt.Run(\"manifest missing member\", func(t *testing.T) {\n58|\t\tt.Parallel()\n59|\t\tbody := replaceOnce(t, fixtureManifestJSON(), `\"node_version\":\"2.4.1\",`, ``, 1)\n60|\t\t_, err := DecodeManifest([]byte(body))\n61|\t\tfailure := requireCode(t, err, \"adapter_protocol_violation\")\n62|\t\tif !strings.Contains(failure.Message(), \"misses a required member\") {\n63|\t\t\tt.Fatalf(\"message = %q, want the missing-member arm, not the unknown-member arm\", failure.Message())\n64|\t\t}\n65|\t})\n66|\tt.Run(\"probe response missing member\", func(t *testing.T) {\n67|\t\tt.Parallel()\n68|\t\tbody := replaceOnce(t, fixtureProbeResponseJSON(), `\"policy_digest\":`+quote(fixturePolicyDigest)+`,`, ``, 1)\n69|\t\t_, err := CheckProbeResponse([]byte(body))\n70|\t\tfailure := requireCode(t, err, \"adapter_protocol_violation\")\n71|\t\tif !strings.Contains(failure.Message(), \"misses a required member\") {\n72|\t\t\tt.Fatalf(\"message = %q, want the missing-member arm, not the unknown-member arm\", failure.Message())\n73|\t\t}\n74|\t})\n75|}\n76|\n77|// TestUnknownFieldVectorReachesTheFieldRegistry requires the\n78|// unknown-field vector to carry exactly one \"fields\" member when\n79|// it reaches production: the strict decoder must accept the\n80|// operation object, so the refusal comes from the field registry\n81|// and not from the duplicate-member gate in front of it. Both\n82|// gates report the same code and detail through DecodeQuery, so\n83|// the single-member construction is the proof of reachability.\n84|func TestUnknownFieldVectorReachesTheFieldRegistry(t *testing.T) {\n85|\tt.Parallel()\n86|\tbody := replaceOnce(t, fixtureQueryJSON(), `\"fields\":null,\"preset\":\"overview\"`, `\"fields\":[\"nope\"],\"preset\":null`, 1)\n87|\tvar envelope struct {\n88|\t\tOperations []json.RawMessage `json:\"operations\"`\n89|\t}\n90|\tif err := json.Unmarshal([]byte(body), &envelope); err != nil {\n91|\t\tt.Fatalf(\"vector is not JSON: %v\", err)\n92|\t}\n93|\tif len(envelope.Operations) != 2 {\n94|\t\tt.Fatalf(\"operations = %d, want 2\", len(envelope.Operations))\n95|\t}\n96|\tmembers, fault := decodeStrictObject(bytesTrimSpace(envelope.Operations[1]))\n97|\tif fault != nil {\n98|\t\tt.Fatalf(\"vector operation carries a strict fault %v; the duplicate gate would fire first\", fault)\n99|\t}\n100|\tfields, present := members[\"fields\"]\n101|\tif !present {\n102|\t\tt.Fatal(\"vector operation carries no fields member; the vector mutates nothing\")\n103|\t}\n104|\tvar names []string\n105|\tif err := json.Unmarshal(fields, &names); err != nil || len(names) != 1 || names[0] != \"nope\" {\n106|\t\tt.Fatalf(\"fields = %s, want exactly [\\\"nope\\\"]\", string(fields))\n107|\t}\n108|\tif _, err := DecodeQuery([]byte(body)); requireCode(t, err, \"query_invalid\") == nil {\n109|\t\tt.Fatal(\"must refuse the unknown field\")\n110|\t}\n111|}"}}}
