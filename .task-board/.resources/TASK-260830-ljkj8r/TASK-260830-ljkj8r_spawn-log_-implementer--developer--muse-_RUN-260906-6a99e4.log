rm)\n796|\t\t}\n797|\t}\n798|\tfor arm := range defensiveArms {\n799|\t\tif !derived.arms[arm] {\n800|\t\t\torphaned = append(orphaned, arm+\" (defensive)\")\n801|\t\t}\n802|\t}\n803|\tsort.Strings(orphaned)\n804|\tif len(orphaned) > 0 {\n805|\t\tt.Fatalf(\"orphaned witness rows:\\n  %s\", strings.Join(orphaned, \"\\n  \"))\n806|\t}\n807|}\n808|\n809|// TestWitnessesResolve requires every named witness to exist as\n810|// a test function in this package's test files: a witness that\n811|// names nothing proves nothing.\n812|func TestWitnessesResolve(t *testing.T) {\n813|\tdefined := map[string]bool{}\n814|\tentries, err := os.ReadDir(\".\")\n815|\tif err != nil {\n816|\t\tt.Fatalf(\"witness resolve: %v\", err)\n817|\t}\n818|\tfor _, entry := range entries {\n819|\t\tname := entry.Name()\n820|\t\tif entry.IsDir() || !strings.HasSuffix(name, \"_test.go\") {\n821|\t\t\tcontinue\n822|\t\t}\n823|\t\tsource, err := os.ReadFile(name)\n824|\t\tif err != nil {\n825|\t\t\tt.Fatalf(\"witness resolve: %v\", err)\n826|\t\t}\n827|\t\tsyntax, err := parseGoFile(name, source)\n828|\t\tif err != nil {\n829|\t\t\tt.Fatalf(\"witness resolve: %v\", err)\n830|\t\t}\n831|\t\tfor _, declaration := range syntax.Decls {\n832|\t\t\tfunction, ok := declaration.(*ast.FuncDecl)\n833|\t\t\tif !ok || function.Recv != nil {\n834|\t\t\t\tcontinue\n835|\t\t\t}\n836|\t\t\tdefined[function.Name.Name] = true\n837|\t\t}\n838|\t}\n839|\tvar missing []string\n840|\tseen := map[string]bool{}\n841|\tfor _, witnesses := range armWitnesses {\n842|\t\tfor _, witness := range witnesses {\n843|\t\t\tif seen[witness] {\n844|\t\t\t\tcontinue\n845|\t\t\t}\n846|\t\t\tseen[witness] = true\n847|\t\t\tif !defined[witness] {\n848|\t\t\t\tmissing = append(missing, witness)\n849|\t\t\t}\n850|\t\t}\n851|\t}\n852|\tsort.Strings(missing)\n853|\tif len(missing) > 0 {\n854|\t\tt.Fatalf(\"unresolved witnesses:\\n  %s\", strings.Join(missing, \"\\n  \"))\n855|\t}\n856|}\n857|\n858|// TestConstructorAliasSpellingsFailDerivation proves the alias\n859|// shapes against synthetic setters: a package-level var alias, a\n860|// function-local := alias, and a constructor passed as an\n861|// argument all fail the derivation, while the definition Name\n862|// itself stays exempt. The vectors are synthetic on purpose:\n863|// they prove the gate, not production.\n864|func TestConstructorAliasSpellingsFailDerivation(t *testing.T) {\n865|\tscan := &fileScan{derived: &armDerivation{arms: map[string]bool{}, ctors: map[string]bool{}}, name: \"synthetic.go\"}\n866|\t_ = scan\n867|\tfor _, probe := range []struct {\n868|\t\tname   string\n869|\t\tsource string\n870|\t\twant   int\n871|\t}{\n872|\t\t{\"definition name exempt\", \"package probe\\nvar failInvalid = func(detail string, field string) {}\\n\", 0},\n873|\t\t{\"package var alias fails\", \"package probe\\nvar alias = failInvalid\\n\", 1},\n874|\t\t{\"local alias fails\", \"package probe\\nfunc f() { alias := failInvalid; _ = alias }\\n\", 1},\n875|\t\t{\"argument alias fails\", \"package probe\\nfunc f() { g(failInvalid) }\\nfunc g(v any) {}\\n\", 1},\n876|\t\t{\"return alias fails\", \"package probe\\nfunc f() any { return failInvalid }\\n\", 1},\n877|\t\t{\"assignment alias fails\", \"package probe\\nfunc f() { var v any; v = failInvalid; _ = v }\\n\", 1},\n878|\t} {\n879|\t\tt.Run(probe.name, func(t *testing.T) {\n880|\t\t\tsyntax, err := parseGoFile(\"synthetic.go\", []byte(probe.source))\n881|\t\t\tif err != nil {\n882|\t\t\t\tt.Fatalf(\"parse synthetic source: %v\", err)\n883|\t\t\t}\n884|\t\t\tderived := &armDerivation{arms: map[string]bool{}, ctors: map[string]bool{}}\n885|\t\t\tinner := &fileScan{derived: derived, name: \"synthetic.go\"}\n886|\t\t\tvar stack []ast.Node\n887|\t\t\tast.Inspect(syntax, func(node ast.Node) bool {\n888|\t\t\t\tif node == nil {\n889|\t\t\t\t\tstack = stack[:len(stack)-1]\n890|\t\t\t\t\treturn true\n891|\t\t\t\t}\n892|\t\t\t\tvar parent ast.Node\n893|\t\t\t\tif len(stack) > 0 {\n894|\t\t\t\t\tparent = stack[len(stack)-1]\n895|\t\t\t\t}\n896|\t\t\t\tinner.visit(node, parent, 0)\n897|\t\t\t\tstack = append(stack, node)\n898|\t\t\t\treturn true\n899|\t\t\t})\n900|\t\t\tif len(derived.violations) != probe.want {\n901|\t\t\t\tt.Fatalf(\"violations = %v, want %d\", derived.violations, probe.want)\n902|\t\t\t}\n903|\t\t})\n904|\t}\n905|}"}}}
