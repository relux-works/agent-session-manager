{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c69b","stream":{"kind":"session","id":"01a075af-a7c5-7382-ae46-5efb02855e33"},"sequence":424,"recorded_at":1780531400000843,"record_type":"event","durability":"durable","causation_id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589","run_stream":{"kind":"run","id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589"},"task_stream":{"kind":"task","id":"52abc0ed-580b-4d6e-b454-3eea9d314bd7"},"task_id":"52abc0ed-580b-4d6e-b454-3eea9d314bd7","event":{"kind":"output","task_id":"52abc0ed-580b-4d6e-b454-3eea9d314bd7","chunk":"Read text file `internal/dirnode/manifest.go`.\n(229 line(s) above)\n230|\n231|// Canonical returns the JCS bytes the digest was computed over.\n232|func (manifest Manifest) Canonical() []byte {\n233|\treturn append([]byte(nil), manifest.canonical...)\n234|}\n235|\n236|// Supports reports whether the manifest's\n237|// supported_protocol_versions contains the exact selected version.\n238|// Membership is exact: a manifest that names only 1.0.0 does not\n239|// support a 2.0.0 attempt, and no coercion across majors is\n240|// performed here or anywhere else.\n241|func (manifest Manifest) Supports(version string) bool {\n242|\tfor _, supported := range manifest.SupportedVersions {\n243|\t\tif supported == version {\n244|\t\t\treturn true\n245|\t\t}\n246|\t}\n247|\treturn false\n248|}\n249|\n250|// DecodeManifest validates one manifest-operation success body as\n251|// the closed Section 7.9 Directory Node Manifest. A manifest whose\n252|// operations are not the complete sorted eleven-name registry, or\n253|// whose capabilities are not the exact eight-name map, advertises a\n254|// surface the host cannot invoke or hides one it must, so both are\n255|// refused outright. The three façade bindings are checked for shape\n256|// here and for agreement with observed facts in\n257|// CheckManifestBindings; a contradiction there is an integrity\n258|// failure.\n259|func DecodeManifest(body []byte) (Manifest, error) {\n260|\tmembers, fault := decodeStrictObject(body)\n261|\tif fault != nil {\n262|\t\tfailure, err := failViolation(\"node manifest \"+fault.detail, fault.member)\n263|\t\tif err != nil {\n264|\t\t\treturn Manifest{}, err\n265|\t\t}\n266|\t\treturn Manifest{}, failure\n267|\t}\n268|\tif name, unknown := unknownMember(members, manifestMembers); unknown {\n269|\t\tfailure, err := failViolation(\"node manifest carries unknown member\", name)\n270|\t\tif err != nil {\n271|\t\t\treturn Manifest{}, err\n272|\t\t}\n273|\t\treturn Manifest{}, failure\n274|\t}\n275|\tif name, missing := missingMember(members, manifestRequired); missing {\n276|\t\tfailure, err := failViolation(\"node manifest misses a required member\", name)\n277|\t\tif err != nil {\n278|\t\t\treturn Manifest{}, err\n279|\t\t}\n280|\t\treturn Manifest{}, failure\n281|\t}\n282|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != ManifestSchema {\n283|\t\tfailure, err := failViolation(\"node manifest schema is not the directory node manifest\", \"schema\")\n284|\t\tif err != nil {\n285|\t\t\treturn Manifest{}, err\n286|\t\t}\n287|\t\treturn Manifest{}, failure\n288|\t}\n289|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != ManifestSchemaVersion {\n290|\t\tfailure, err := failViolation(\"node manifest version is not 1.0.0\", \"schema_version\")\n291|\t\tif err != nil {\n292|\t\t\treturn Manifest{}, err\n293|\t\t}\n294|\t\treturn Manifest{}, failure\n(more lines below)"}}}
