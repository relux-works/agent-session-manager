{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cdd5","stream":{"kind":"session","id":"01a075af-a7c5-7382-ae46-5efb02855e33"},"sequence":1349,"recorded_at":1780531400002693,"record_type":"event","durability":"durable","causation_id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589","run_stream":{"kind":"run","id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589"},"task_stream":{"kind":"task","id":"012538f9-b805-4f0c-84b8-85ee7d136c72"},"task_id":"012538f9-b805-4f0c-84b8-85ee7d136c72","event":{"kind":"output","task_id":"012538f9-b805-4f0c-84b8-85ee7d136c72","chunk":"edited\nchanged lines: lines 140-183\n--- original\n+++ updated\n@@\n-// reachDecision computes which derived arm a refusal message\n-// reaches. It returns the reached key and whether the outcome is\n-// determined: exactly one literal match determines a literal arm;\n-// otherwise the match set may hold the named non-literal arm plus\n-// at most one frame fault on the same conduit.\n-func reachDecision(named string, message string, match func(key string) bool) (string, bool) {\n-\tshape, _, ok := classifyArmKey(named)\n-\tif !ok {\n-\t\treturn \"\", false\n-\t}\n-\tif shape == armShapeLiteral {\n-\t\treturn named, match(named)\n-\t}\n-\treturn named, match(named)\n-}\n-\n-// validNonLiteralSet reports whether the full match set is\n-// consistent with the named non-literal arm carrying the refusal:\n-// no literal fires, the named arm fires, and anything else firing\n-// is at most one frame fault travelling the same conduit.\n-func validNonLiteralSet(named string, matches map[string]bool) bool {\n-\tif !matches[named] {\n-\t\treturn false\n-\t}\n-\tframes := 0\n-\tfor key := range matches {\n-\t\tif key == named {\n-\t\t\tcontinue\n-\t\t}\n-\t\tshape, _, ok := classifyArmKey(key)\n-\t\tif !ok {\n-\t\t\treturn false\n-\t\t}\n-\t\tif shape == armShapeLiteral {\n-\t\t\treturn false\n-\t\t}\n-\t\tif shape == armShapeFrame {\n-\t\t\tframes++\n-\t\t\tcontinue\n-\t\t}\n-\t\treturn false\n-\t}\n-\treturn frames <= 1\n-}\n+// reachedArm computes which derived arm a refusal message\n+// reaches and whether that outcome is determined:\n+//\n+//   - a literal arm is reached only when exactly it matches among\n+//     all literal keys: a vector sliding to a sibling arm, or to\n+//     the strict conduit, names a key outside the match and fails;\n+//   - a conduit or context arm is reached when it matches, no\n+//     literal matches, and anything else matching is at most one\n+//     frame fault travelling the same conduit;\n+//   - a frame fault is reached when its detail matches, no literal\n+//     matches, and the carrier conduit named by the row's also key\n+//     matches alongside it.\n+//\n+// Anything else — no match, an ambiguous match, or a match the\n+// shapes above do not account for — returns ok=false, and the row\n+// fails instead of passing.\n+func reachedArm(named string, matches map[string]bool, also string) (string, bool) {\n+\tshape, _, ok := classifyArmKey(named)\n+\tif !ok {\n+\t\treturn \"\", false\n+\t}\n+\tswitch shape {\n+\tcase armShapeLiteral:\n+\t\tliterals := 0\n+\t\tfor key := range matches {\n+\t\t\tkeyShape, _, ok := classifyArmKey(key)\n+\t\t\tif !ok {\n+\t\t\t\treturn \"\", false\n+\t\t\t}\n+\t\t\tif keyShape == armShapeLiteral {\n+\t\t\t\tliterals++\n+\t\t\t}\n+\t\t}\n+\t\tif literals == 1 && matches[named] {\n+\t\t\treturn named, true\n+\t\t}\n+\t\tfor key := range matches {\n+\t\t\tkeyShape, _, ok := classifyArmKey(key)\n+\t\t\tif ok && keyShape == armShapeLiteral {\n+\t\t\t\treturn key, false\n+\t\t\t}\n+\t\t}\n+\t\treturn \"\", false\n+\tcase armShapeFrame:\n+\t\tif also == \"\" || !matches[also] {\n+\t\t\treturn \"\", false\n+\t\t}\n+\t\tfor key := range matches {\n+\t\t\tkeyShape, _, ok := classifyArmKey(key)\n+\t\t\tif !ok {\n+\t\t\t\treturn \"\", false\n+\t\t\t}\n+\t\t\tif keyShape == armShapeLiteral {\n+\t\t\t\treturn key, false\n+\t\t\t}\n+\t\t\tif key != named && key != also {\n+\t\t\t\treturn key, false\n+\t\t\t}\n+\t\t}\n+\t\tif matches[named] {\n+\t\t\treturn named, true\n+\t\t}\n+\t\treturn \"\", false\n+\tdefault:\n+\t\tif !matches[named] {\n+\t\t\tfor key := range matches {\n+\t\t\t\tkeyShape, _, ok := classifyArmKey(key)\n+\t\t\t\tif ok && (keyShape == armShapeLiteral || keyShape == armShapeFrame) {\n+\t\t\t\t\treturn key, keyShape == armShapeFrame\n+\t\t\t\t}\n+\t\t\t}\n+\t\t\treturn \"\", false\n+\t\t}\n+\t\tframes := 0\n+\t\tfor key := range matches {\n+\t\t\tif key == named {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tkeyShape, _, ok := classifyArmKey(key)\n+\t\t\tif !ok {\n+\t\t\t\treturn \"\", false\n+\t\t\t}\n+\t\t\tif keyShape == armShapeLiteral {\n+\t\t\t\treturn key, false\n+\t\t\t}\n+\t\t\tif keyShape == armShapeFrame {\n+\t\t\t\tframes++\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\treturn key, false\n+\t\t}\n+\t\tif frames <= 1 {\n+\t\t\treturn named, true\n+\t\t}\n+\t\treturn \"\", false\n+\t}\n+}\n"}}}
