rams(t, \"execute_plan\", `\"confirmations\":[]`, `\"confirmations\":`+sortedLiterals(\"c\", 65)))\n344|\t\t}},\n345|\t\t{\"sessions unknown projection field\", func(t *testing.T) string {\n346|\t\t\treturn singleOperationBatch(\"sessions\", operationParams(\"sessions\"), `[\"id\",\"nope\"]`, \"null\", 0, 10, \"[]\", \"false\", \"false\", \"null\", \"null\")\n347|\t\t}},\n348|\t}\n349|\tfor _, row := range rows {\n350|\t\trow := row\n351|\t\tt.Run(row.name, func(t *testing.T) {\n352|\t\t\tt.Parallel()\n353|\t\t\tif _, err := DecodeQuery([]byte(row.build(t))); requireCode(t, err, \"query_invalid\") == nil {\n354|\t\t\t\tt.Fatal(\"must refuse\")\n355|\t\t\t}\n356|\t\t})\n357|\t}\n358|}\n359|\n360|// TestDecodeQueryProjectionFields drives the field projection\n361|// registry through the production DecodeQuery entry: a sorted\n362|// registry subset admits, an unknown field refuses, and a\n363|// duplicate field refuses on sortedness. The validQueryField gate\n364|// sat at zero coverage behind the shared operation arm; these\n365|// rows pin it.\n366|func TestDecodeQueryProjectionFields(t *testing.T) {\n367|\tt.Parallel()\n368|\tadmitted := singleOperationBatch(\"sessions\", operationParams(\"sessions\"), `[\"display_title\",\"state\"]`, \"null\", 0, 10, \"[]\", \"false\", \"false\", \"null\", \"null\")\n369|\tquery, err := DecodeQuery([]byte(admitted))\n370|\tif err != nil {\n371|\t\tt.Fatalf(\"registry field subset must admit: %v\", err)\n372|\t}\n373|\tif len(query.Operations) != 1 || query.Operations[0].Name != \"sessions\" {\n374|\t\tt.Fatalf(\"operations = %+v, want the single sessions operation\", query.Operations)\n375|\t}\n376|\tfor _, fields := range []string{`[\"nope\"]`, `[\"id\",\"id\"]`, `[\"state\",\"id\"]`} {\n377|\t\tbody := singleOperationBatch(\"sessions\", operationParams(\"sessions\"), fields, \"null\", 0, 10, \"[]\", \"false\", \"false\", \"null\", \"null\")\n378|\t\tif _, err := DecodeQuery([]byte(body)); requireCode(t, err, \"query_invalid\") == nil {\n379|\t\t\tt.Fatalf(\"fields %s must refuse\", fields)\n380|\t\t}\n381|\t}\n382|\t// Bound edges for the projection array (element 1..64,\n383|\t// count 0..128): the empty selection admits, a 65-character\n384|\t// field refuses on length, and 129 fields refuse on count.\n385|\tdrive := func(fields string) error {\n386|\t\tbody := singleOperationBatch(\"sessions\", operationParams(\"sessions\"), fields, \"null\", 0, 10, \"[]\", \"false\", \"false\", \"null\", \"null\")\n387|\t\t_, err := DecodeQuery([]byte(body))\n388|\t\treturn err\n389|\t}\n390|\tif err := drive(`[]`); err != nil {\n391|\t\tt.Fatalf(\"empty fields must admit: %v\", err)\n392|\t}\n393|\tlongField := strings.Repeat(\"f\", 65)\n394|\tif err := drive(`[\"` + longField + `\"]`); err == nil {\n395|\t\tt.Fatal(\"65-character field must refuse past the element maximum\")\n396|\t}\n397|\tmany := make([]string, 0, 129)\n398|\tfor i := 0; i < 129; i++ {\n399|\t\tmany = append(many, fmt.Sprintf(`\"f-%05d\"`, i))\n400|\t}\n401|\tif err := drive(`[` + strings.Join(many, \",\") + `]`); err == nil {\n402|\t\tt.Fatal(\"129 fields must refuse past the count maximum\")\n403|\t}\n404|}\n405|\n406|// TestDecodeQueryMutationLineageSubject drives the lineage subject\n407|// through the production DecodeQuery entry: mutations admit the\n408|// lineage kind while the session read refuses it.\n409|func TestDecodeQueryMutationLineageSubject(t *testing.T) {\n410|\tt.Parallel()\n411|\tmutation := badParams(t, \"set_title\", `\"subject_kind\":\"ax_session\"`, `\"subject_kind\":\"lineage\"`)\n412|\tif _, err := DecodeQuery([]byte(refuseBatch(\"set_title\", mutation))); err != nil {\n413|\t\tt.Fatalf(\"mutation lineage subject must admit: %v\", err)\n414|\t}\n415|}\n416|\n417|// TestDecodeQueryCountBoundAdmissions pins the count ceilings\n418|// from below through the production DecodeQuery entry: 256 tags\n419|// and 64 confirmations admit, so a mutant tightening either\n420|// ceiling reddens here while the refusal rows pin widening.\n421|func TestDecodeQueryCountBoundAdmissions(t *testing.T) {\n422|\tt.Parallel()\n423|\ttags := badParams(t, \"set_tags\", `\"tags\":[]`, `\"tags\":`+sortedLiterals(\"tag\", 256))\n424|\tif _, err := DecodeQuery([]byte(refuseBatch(\"set_tags\", tags))); err != nil {\n425|\t\tt.Fatalf(\"256 tags at the maximum must admit: %v\", err)\n426|\t}\n427|\tconfirmations := badParams(t, \"execute_plan\", `\"confirmations\":[]`, `\"confirmations\":`+sortedLiterals(\"c\", 64))\n428|\tdigest := quote(fixtureBatchDigest)\n429|\tbatch := mutationBatch(\"execute_plan\", confirmations, false, true, digest, digest)\n430|\tif _, err := DecodeQuery([]byte(batch)); err != nil {\n431|\t\tt.Fatalf(\"64 confirmations at the maximum must admit: %v\", err)\n432|\t}\n433|}"}}}
