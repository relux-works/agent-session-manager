{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c769","stream":{"kind":"session","id":"01a075af-a7c5-7382-ae46-5efb02855e33"},"sequence":527,"recorded_at":1780531400001049,"record_type":"event","durability":"durable","causation_id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589","run_stream":{"kind":"run","id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589"},"call_id":"call_01a075b17b6e7d13b664a47de2fbf78d","text":"Read text file `internal/dirnode/bounds_edge_test.go`.\n(237 line(s) above)\n238|func TestUint53BoundEdges(t *testing.T) {\n239|\tt.Parallel()\n240|\trows := []uint53BoundRow{\n241|\t\t{\n242|\t\t\tname: \"scan max_instances\", min: 1, max: 65536,\n243|\t\t\tdrive: func(t *testing.T, literal string) error {\n244|\t\t\t\t_, err := CheckScanRequest([]byte(spliceBound(t, fixtureScanRequestJSON(), `\"max_instances\":100`, `\"max_instances\":`+literal)))\n245|\t\t\t\treturn err\n246|\t\t\t},\n247|\t\t},\n248|\t\t{\n249|\t\t\t// Both entries enforce the shared constants, so\n250|\t\t\t// one row pins the decode site and the stated\n251|\t\t\t// encode half together: a refusal from either\n252|\t\t\t// entry fails the row.\n253|\t\t\tname: \"request deadline_ms\", min: 1, max: 3600000,\n254|\t\t\tdrive: func(t *testing.T, literal string) error {\n255|\t\t\t\tif _, err := DecodeRequestFrame(fixtureRequestFrame(\"2.0.0\", \"manifest\", fixtureRequestID, mustUint53(t, literal), `{}`)); err != nil {\n256|\t\t\t\t\treturn err\n257|\t\t\t\t}\n258|\t\t\t\t_, err := EncodeRequest(MajorV2, OpManifest, fixtureRequestID, mustUint53(t, literal), []byte(`{}`))\n259|\t\t\t\treturn err\n260|\t\t\t},\n261|\t\t},\n262|\t}\n263|\tif want := boundCensusDriverCount(\"TestUint53BoundEdges\"); len(rows) != want {\n264|\t\tt.Fatalf(\"uint53 bound rows = %d, want %d; the table is short, not the package\", len(rows), want)\n265|\t}\n266|\tfor _, row := range rows {\n267|\t\trow := row\n268|\t\tt.Run(row.name, func(t *testing.T) {\n269|\t\t\tt.Parallel()\n270|\t\t\tbelow := strconv.FormatUint(row.min-1, 10)\n271|\t\t\tif err := row.drive(t, below); err == nil {\n272|\t\t\t\tt.Fatalf(\"%s admitted %s below the %d minimum\", row.name, below, row.min)\n273|\t\t\t}\n274|\t\t\tif err := row.drive(t, strconv.FormatUint(row.min, 10)); err != nil {\n275|\t\t\t\tt.Fatalf(\"%s refused %d at the minimum: %v\", row.name, row.min, err)\n276|\t\t\t}\n277|\t\t\tif err := row.drive(t, strconv.FormatUint(row.max, 10)); err != nil {\n278|\t\t\t\tt.Fatalf(\"%s refused %d at the maximum: %v\", row.name, row.max, err)\n279|\t\t\t}\n280|\t\t\tif err := row.drive(t, strconv.FormatUint(row.max+1, 10)); err == nil {\n281|\t\t\t\tt.Fatalf(\"%s admitted %d past the %d maximum\", row.name, row.max+1, row.max)\n282|\t\t\t}\n283|\t\t})\n284|\t}\n285|}\n286|\n287|// mustUint53 renders one decimal literal back to uint64 for the\n288|// deadline driver, which builds frames rather than splicing text.\n289|func mustUint53(t *testing.T, literal string) uint64 {\n290|\tt.Helper()\n291|\tvalue, err := strconv.ParseUint(literal, 10, 64)\n292|\tif err != nil {\n293|\t\tt.Fatalf(\"mustUint53(%q): %v\", literal, err)\n294|\t}\n295|\treturn value\n296|}\n297|\n298|// TestUint53RepresentabilityCeiling pins the shared uint53\n299|// ceiling once: 2^53-1 admits, 2^53 refuses. Every maxUint53\n300|// maximum in the roster points here instead of repeating the\n301|// literal per site.\n302|func TestUint53RepresentabilityCeiling(t *testing.T) {\n303|\tt.Parallel()\n304|\tif _, ok := rawUint53([]byte(`9007199254740991`)); !ok {\n305|\t\tt.Fatal(\"rawUint53 refused 2^53-1 at the ceiling\")\n306|\t}\n307|\tif _, ok := rawUint53([]byte(`9007199254740992`)); ok {\n308|\t\tt.Fatal(\"rawUint53 admitted 2^53 past the ceiling\")\n309|\t}\n310|\tif _, ok := checkUint53Bounds([]byte(`9007199254740992`), 0, 9007199254740991); ok {\n311|\t\tt.Fatal(\"checkUint53Bounds admitted 2^53 past the ceiling\")\n312|\t}\n313|}\n314|\n315|// TestManifestLimitsBoundEdges drives every DirectoryNodeLimits\n316|// bound at min-1/min/max/max+1 through the production\n317|// DecodeManifest entry. The fixture sits at every maximum, so\n318|// max admission is the fixture decode itself.\n319|func TestManifestLimitsBoundEdges(t *testing.T) {\n320|\tt.Parallel()\n321|\tgood := fixtureManifestJSON()\n322|\trows := []struct {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c76b","stream":{"kind":"session","id":"01a075af-a7c5-7382-ae46-5efb02855e33"},"sequence":528,"recorded_at":1780531400001051,"record_type":"event","durability":"durable","causation_id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589","run_stream":{"kind":"run","id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589"},"call_id":"call_01a075b17c817831904036fef01775bd","text":"Read text file `internal/dirnode/scan_test.go`.\n1|package dirnode\n2|\n3|import (\n4|\t\"sort\"\n5|\t\"testing\"\n6|)\n7|\n8|// TestCheckScanRequestAcceptsFixture drives the production scan\n9|// request entry with the exact contract vector.\n10|func TestCheckScanRequestAcceptsFixture(t *testing.T) {\n11|\tt.Parallel()\n12|\trequest, err := CheckScanRequest([]byte(fixtureScanRequestJSON()))\n13|\tif err != nil {\n14|\t\tt.Fatalf(\"CheckScanRequest error = %v\", err)\n15|\t}\n16|\tif request.OperationID != fixtureOperationID || len(request.Installations) != 2 {\n17|\t\tt.Fatalf(\"CheckScanRequest = %+v\", request)\n18|\t}\n19|\tif request.HasPriorBatch || request.HasCursor || request.MaxInstances != 100 {\n20|\t\tt.Fatalf(\"CheckScanRequest optionals = %+v\", request)\n21|\t}\n22|}\n23|\n24|// TestCheckScanRequestRefusals drives the production scan request\n25|// entry with one structural vector per rule.\n26|func TestCheckScanRequestRefusals(t *testing.T) {\n27|\tt.Parallel()\n28|\tgood := fixtureScanRequestJSON()\n29|\tsortedPair := []string{fixtureInstallDigestA, fixtureInstallDigestB}\n30|\tsort.Strings(sortedPair)\n31|\tunsorted := replaceOnce(t, good, `\"installation_ids\":[`+quote(sortedPair[0])+`,`+quote(sortedPair[1])+`]`, `\"installation_ids\":[`+quote(sortedPair[1])+`,`+quote(sortedPair[0])+`]`, 1)\n32|\tfor _, probe := range []struct {\n33|\t\tname string\n34|\t\tbody string\n35|\t}{\n36|\t\t{\"unknown member\", replaceOnce(t, good, `\"extensions\":{}}`, `\"extensions\":{},\"extra\":1}`, 1)},\n37|\t\t{\"missing member\", replaceOnce(t, good, `\"cursor\":null,`, ``, 1)},\n38|\t\t{\"bad operation id\", replaceOnce(t, good, fixtureOperationID, \"not-a-uuid\", 1)},\n39|\t\t{\"empty installations\", replaceOnce(t, good, `\"installation_ids\":[`+quote(sortedPair[0])+`,`+quote(sortedPair[1])+`]`, `\"installation_ids\":[]`, 1)},\n40|\t\t{\"unsorted installations\", unsorted},\n41|\t\t{\"bad installation digest\", replaceOnce(t, good, fixtureInstallDigestA, \"sha256:zzz\", 1)},\n42|\t\t{\"bad prior batch\", replaceOnce(t, good, `\"prior_batch_id\":null`, `\"prior_batch_id\":0`, 1)},\n43|\t\t{\"empty cursor\", replaceOnce(t, good, `\"cursor\":null`, `\"cursor\":\"\"`, 1)},\n44|\t\t{\"non string cursor\", replaceOnce(t, good, `\"cursor\":null`, `\"cursor\":0`, 1)},\n45|\t\t{\"bad extensions\", replaceOnce(t, good, `\"extensions\":{}}`, `\"extensions\":{\"x\":1}}`, 1)},\n46|\t\t{\"non object\", `[]`},\n47|\t\t{\"zero max instances\", replaceOnce(t, good, `\"max_instances\":100`, `\"max_instances\":0`, 1)},\n48|\t\t{\"max instances past bound\", replaceOnce(t, good, `\"max_instances\":100`, `\"max_instances\":65537`, 1)},\n49|\t} {\n50|\t\tt.Run(probe.name, func(t *testing.T) {\n51|\t\t\tt.Parallel()\n52|\t\t\tif _, err := CheckScanRequest([]byte(probe.body)); requireCode(t, err, \"adapter_protocol_violation\") == nil {\n53|\t\t\t\tt.Fatal(\"must refuse\")\n54|\t\t\t}\n55|\t\t})\n56|\t}\n57|}\n58|\n59|// quote renders one JSON string literal for fixture surgery.\n60|func quote(value string) string {\n61|\treturn `\"` + value + `\"`\n62|}\n63|\n64|// TestCheckScanRequestNullableOptions drives the production scan\n65|// request entry through the nullable members: a digest prior\n66|// batch and a bounded cursor admit, while wrong-typed values are\n67|// not absences.\n68|func TestCheckScanRequestNullableOptions(t *testing.T) {\n69|\tt.Parallel()\n70|\tbody := replaceOnce(t, fixtureScanRequestJSON(), `\"prior_batch_id\":null`, `\"prior_batch_id\":`+quote(fixtureBatchDigest), 1)\n71|\tbody = replaceOnce(t, body, `\"cursor\":null`, `\"cursor\":\"abc\"`, 1)\n72|\trequest, err := CheckScanRequest([]byte(body))\n73|\tif err != nil {\n74|\t\tt.Fatalf(\"CheckScanRequest(optionals) error = %v\", err)\n75|\t}\n76|\tif !request.HasPriorBatch || request.PriorBatchID != fixtureBatchDigest || !request.HasCursor || request.Cursor != \"abc\" {\n77|\t\tt.Fatalf(\"CheckScanRequest(optionals) = %+v\", request)\n78|\t}\n79|}\n80|\n81|// TestCheckScanResponseAcceptsFixture drives the production scan\n82|// response entry with the exact contract vector.\n83|func TestCheckScanResponseAcceptsFixture(t *testing.T) {\n84|\tt.Parallel()\n85|\tresponse, err := CheckScanResponse([]byte(fixtureScanResponseJSON()))\n86|\tif err != nil {\n87|\t\tt.Fatalf(\"CheckScanResponse error = %v\", err)\n88|\t}\n89|\tif !response.HasBatch || len(response.EnvironmentIDs) != 1 || len(response.NativeIDs) != 1 || response.HasNextCursor {\n90|\t\tt.Fatalf(\"CheckScanResponse = %+v\", response)\n91|\t}\n92|}\n93|\n94|// TestCheckScanResponseRefusals drives the production scan\n95|// response entry with one structural vector per rule.\n96|func TestCheckScanResponseRefusals(t *testing.T) {\n97|\tt.Parallel()\n98|\tgood := fixtureScanResponseJSON()\n99|\tnativePair := []string{fixtureNativeDigestA, fixtureEvidenceDigest}\n100|\tsort.Strings(nativePair)\n101|\tunsortedNatives := replaceOnce(t, good, `\"native_observation_ids\":[`+quote(fixtureNativeDigestA)+`]`, `\"native_observation_ids\":[`+quote(nativePair[1])+`,`+quote(nativePair[0])+`]`, 1)\n102|\tfor _, probe := range []struct {\n103|\t\tname string\n104|\t\tbody string\n105|\t}{\n106|\t\t{\"unknown member\", replaceOnce(t, good, `\"extensions\":{}}`, `\"extensions\":{},\"extra\":1}`, 1)},\n107|\t\t{\"missing member\", replaceOnce(t, good, `\"next_cursor\":null,`, ``, 1)},\n108|\t\t{\"non object batch\", replaceOnce(t, good, `\"batch\":{\"batch_id\":`+quote(fixtureBatchDigest)+`}`, `\"batch\":[]`, 1)},\n109|\t\t{\"empty environment ids\", replaceOnce(t, good, `\"environment_observation_ids\":[`+quote(fixtureEvidenceDigest)+`]`, `\"environment_observation_ids\":[]`, 1)},\n110|\t\t{\"unsorted natives\", unsortedNatives},\n111|\t\t{\"bad next cursor type\", replaceOnce(t, good, `\"next_cursor\":null`, `\"next_cursor\":0`, 1)},\n112|\t\t{\"empty next cursor\", replaceOnce(t, good, `\"next_cursor\":null`, `\"next_cursor\":\"\"`, 1)},\n113|\t\t{\"bad native digest\", replaceOnce(t, good, quote(fixtureNativeDigestA), `\"zzz\"`, 1)},\n114|\t\t{\"bad extensions\", replaceOnce(t, good, `\"extensions\":{}}`, `\"extensions\":{\"x\":1}}`, 1)},\n115|\t\t{\"non object\", `[]`},\n116|\t} {\n117|\t\tt.Run(probe.name, func(t *testing.T) {\n118|\t\t\tt.Parallel()\n119|\t\t\tif _, err := CheckScanResponse([]byte(probe.body)); requireCode(t, err, \"adapter_protocol_violation\") == nil {\n120|\t\t\t\tt.Fatal(\"must refuse\")\n121|\t\t\t}\n122|\t\t})\n123|\t}\n124|}\n125|\n126|// journalBody renders one canonical scan request body for the\n127|// journal tests with independently chosen literals.\n128|func journalBody(operationID string) []byte {\n129|\treturn []byte(`{\"cursor\":null,\"extensions\":{},\"installation_ids\":[\"` + fixtureInstallDigestA + `\"],\"max_instances\":100,\"operation_id\":\"` + operationID + `\",\"prior_batch_id\":null}`)\n130|}\n131|\n132|// TestJournalReplaysIdenticalBody drives the production\n133|// idempotency entry for the first-seen path and the\n134|// canonical-identical retry: the first call stores, the repeat\n135|// replays the recorded bytes with no new record.\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
