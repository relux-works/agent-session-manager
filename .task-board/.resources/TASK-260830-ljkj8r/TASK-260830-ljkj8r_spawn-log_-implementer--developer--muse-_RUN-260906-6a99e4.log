{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c63f","stream":{"kind":"session","id":"01a075af-a7c5-7382-ae46-5efb02855e33"},"sequence":378,"recorded_at":1780531400000751,"record_type":"event","durability":"durable","causation_id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589","run_stream":{"kind":"run","id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589"},"task_stream":{"kind":"task","id":"646c2b52-ce8d-463f-af00-666bd60596ca"},"task_id":"646c2b52-ce8d-463f-af00-666bd60596ca","event":{"kind":"output","task_id":"646c2b52-ce8d-463f-af00-666bd60596ca","chunk":"Read text file `internal/dirnode/manifest_test.go`.\n1|package dirnode\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n8|)\n9|\n10|// TestDecodeManifestAcceptsFixture drives the production manifest\n11|// entry with the exact contract vector: every retained field must\n12|// match the fixture literals, and the host-computed digest must be\n13|// stable across decodes.\n14|func TestDecodeManifestAcceptsFixture(t *testing.T) {\n15|\tt.Parallel()\n16|\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n17|\tif err != nil {\n18|\t\tt.Fatalf(\"DecodeManifest error = %v\", err)\n19|\t}\n20|\tif manifest.NodeID != fixtureNodeID || manifest.NodeVersion != fixtureNodeVersion || manifest.HostID != fixtureHostID {\n21|\t\tt.Fatalf(\"manifest identity = %q %q %q\", manifest.NodeID, manifest.NodeVersion, manifest.HostID)\n22|\t}\n23|\tif manifest.ExecutableSHA256 != fixtureExecutableDigest || manifest.ProviderManifestDigest != fixtureProviderDigest || manifest.AdapterManifestDigest != fixtureAdapterDigest {\n24|\t\tt.Fatal(\"manifest façade bindings do not match the fixture\")\n25|\t}\n26|\tif manifest.TupleRegistryID != fixtureTupleRegistry {\n27|\t\tt.Fatal(\"manifest tuple registry binding does not match the fixture\")\n28|\t}\n29|\tif len(manifest.Operations) != 11 || len(manifest.Schemas) != 15 {\n30|\t\tt.Fatalf(\"manifest registries = %d ops %d schemas\", len(manifest.Operations), len(manifest.Schemas))\n31|\t}\n32|\tif len(manifest.Capabilities) != 8 {\n33|\t\tt.Fatalf(\"manifest capabilities = %d, want 8\", len(manifest.Capabilities))\n34|\t}\n35|\tif !manifest.Supports(\"1.0.0\") || !manifest.Supports(\"2.0.0\") || manifest.Supports(\"3.0.0\") {\n36|\t\tt.Fatal(\"manifest version support is wrong\")\n37|\t}\n38|\tagain, err := DecodeManifest([]byte(fixtureManifestJSON()))\n39|\tif err != nil {\n40|\t\tt.Fatalf(\"DecodeManifest again error = %v\", err)\n41|\t}\n42|\tif ManifestDigest(manifest) != ManifestDigest(again) {\n43|\t\tt.Fatal(\"manifest digest is not stable across decodes\")\n44|\t}\n45|\tif len(manifest.Canonical()) == 0 {\n46|\t\tt.Fatal(\"manifest canonical bytes are empty\")\n47|\t}\n48|}\n49|\n50|// TestDecodeManifestClosedMemberRules drives the production\n51|// manifest entry with one structural vector per rule: unknown\n52|// members, missing members, wrong schema identity, and shape\n53|// defects in every member class.\n54|func TestDecodeManifestClosedMemberRules(t *testing.T) {\n55|\tt.Parallel()\n56|\tgood := fixtureManifestJSON()\n57|\tfor _, probe := range []struct {\n58|\t\tname  string\n59|\t\tbody  string\n60|\t\tfatal bool\n61|\t}{\n62|\t\t{\"unknown member\", replaceOnce(t, good, `\"limits\":{`, `\"limits\":{},\"extra\":1,`, 1), true},\n63|\t\t{\"missing member\", replaceOnce(t, good, `\"node_version\":\"2.4.1\",`, ``, 1), true},\n64|\t\t{\"wrong schema\", replaceOnce(t, good, \"session-directory-node-manifest\", \"session-directory-node-response\", 1), true},\n65|\t\t{\"wrong version\", replaceOnce(t, good, `\"schema_version\":\"1.0.0\"`, `\"schema_version\":\"2.0.0\"`, 1), true},\n66|\t\t{\"empty node id\", replaceOnce(t, good, `\"node_id\":\"test-directory-node\"`, `\"node_id\":\"\"`, 1), true},\n67|\t\t{\"bad node version\", replaceOnce(t, good, `\"node_version\":\"2.4.1\"`, `\"node_version\":\"2.4\"`, 1), true},\n68|\t\t{\"bad host id\", replaceOnce(t, good, fixtureHostID, \"not-a-uuid\", 1), true},\n69|\t\t{\"bad executable digest\", replaceOnce(t, good, fixtureExecutableDigest, \"sha256:zzz\", 1), true},\n70|\t\t{\"bad tuple registry\", replaceOnce(t, good, fixtureTupleRegistry, \"null\", 1), true},\n71|\t\t{\"duplicate member\", good[:len(good)-1] + `,\"node_id\":\"x\"}`, true},\n72|\t\t{\"non object\", `[]`, true},\n73|\t\t{\"empty redaction policies\", replaceOnce(t, good, `\"redaction_policy_ids\":[`+quote(fixtureRedactionDigest)+`]`, `\"redaction_policy_ids\":[]`, 1), true},\n74|\t\t{\"bad enrichment profile\", replaceOnce(t, good, fixtureEnrichmentDigest, \"sha256:zzz\", 1), true},\n75|\t\t{\"bad top-level extensions\", replaceOnce(t, good, `\"extensions\":{}},\"extensions\":{}}`, `\"extensions\":{}},\"extensions\":{\"x\":1}}`, 1), true},\n76|\t\t{\"deep nesting past canonical bound\", deepExtensionsManifest(t, good), true},\n77|\t} {\n78|\t\tt.Run(probe.name, func(t *testing.T) {\n79|\t\t\tt.Parallel()\n80|\t\t\tif _, err := DecodeManifest([]byte(probe.body)); requireCode(t, err, \"adapter_protocol_violation\") == nil {\n81|\t\t\t\tt.Fatal(\"must refuse\")\n82|\t\t\t}\n83|\t\t})\n84|\t}\n85|}\n86|\n87|// deepExtensionsManifest nests one extensions value past the\n88|// canonicalizer's depth bound: the member checks cross extensions\n89|// values opaquely, so the body validates structurally and then\n90|// fails the host-computed canonicalization — the \"not canonical\n91|// JSON\" arm fires through the production entry, not only in\n92|// theory.\n93|func deepExtensionsManifest(t *testing.T, good string) string {\n94|\tt.Helper()\n95|\tnested := `{\"a\":0}`\n96|\tfor range 300 {\n97|\t\tnested = `{\"a\":` + nested + `}`\n98|\t}\n99|\treturn deepExtensionsSwap(t, good, nested)\n100|}\n101|\n102|// deepExtensionsSwap replaces the manifest top-level extensions\n103|// object with a deeply nested one.\n104|func deepExtensionsSwap(t *testing.T, good, nested string) string {\n105|\tt.Helper()\n106|\tneedle := `\"extensions\":{}},\"extensions\":{}}`\n107|\tif !strings.Contains(good, needle) {\n108|\t\tt.Fatalf(\"manifest tail needle absent\")\n109|\t}\n110|\treturn replaceOnce(t, good, `\"extensions\":{}},\"extensions\":{}}`, `\"extensions\":{}},\"extensions\":{\"com.example.deep\":`+nested+`}}`, 1)\n111|}\n112|\n113|// TestDecodeManifestRegistryRules drives the production manifest\n114|// entry against the registry members: reordered, dropped, padded,\n115|// and mis-sorted registries refuse, as do out-of-bound schema\n116|// counts and malformed assertions.\n117|func TestDecodeManifestRegistryRules(t *testing.T) {\n118|\tt.Parallel()\n119|\tgood := fixtureManifestJSON()\n120|\tswapped := replaceOnce(t, good, `\"operations\":[\"continuation-inspect\",\"doctor\"`, `\"operations\":[\"doctor\",\"continuation-inspect\"`, 1)\n(more lines below)"}}}
