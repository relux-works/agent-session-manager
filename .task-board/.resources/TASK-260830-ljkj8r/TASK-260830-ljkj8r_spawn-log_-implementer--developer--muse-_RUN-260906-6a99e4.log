{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c647","stream":{"kind":"session","id":"01a075af-a7c5-7382-ae46-5efb02855e33"},"sequence":382,"recorded_at":1780531400000759,"record_type":"event","durability":"durable","causation_id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589","run_stream":{"kind":"run","id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589"},"call_id":"call_01a075b0e41a70b38321b1f11f9009a3","text":"Read text file `internal/dirnode/manifest_test.go`.\n1|package dirnode\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n8|)\n9|\n10|// TestDecodeManifestAcceptsFixture drives the production manifest\n11|// entry with the exact contract vector: every retained field must\n12|// match the fixture literals, and the host-computed digest must be\n13|// stable across decodes.\n14|func TestDecodeManifestAcceptsFixture(t *testing.T) {\n15|\tt.Parallel()\n16|\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n17|\tif err != nil {\n18|\t\tt.Fatalf(\"DecodeManifest error = %v\", err)\n19|\t}\n20|\tif manifest.NodeID != fixtureNodeID || manifest.NodeVersion != fixtureNodeVersion || manifest.HostID != fixtureHostID {\n21|\t\tt.Fatalf(\"manifest identity = %q %q %q\", manifest.NodeID, manifest.NodeVersion, manifest.HostID)\n22|\t}\n23|\tif manifest.ExecutableSHA256 != fixtureExecutableDigest || manifest.ProviderManifestDigest != fixtureProviderDigest || manifest.AdapterManifestDigest != fixtureAdapterDigest {\n24|\t\tt.Fatal(\"manifest façade bindings do not match the fixture\")\n25|\t}\n26|\tif manifest.TupleRegistryID != fixtureTupleRegistry {\n27|\t\tt.Fatal(\"manifest tuple registry binding does not match the fixture\")\n28|\t}\n29|\tif len(manifest.Operations) != 11 || len(manifest.Schemas) != 15 {\n30|\t\tt.Fatalf(\"manifest registries = %d ops %d schemas\", len(manifest.Operations), len(manifest.Schemas))\n31|\t}\n32|\tif len(manifest.Capabilities) != 8 {\n33|\t\tt.Fatalf(\"manifest capabilities = %d, want 8\", len(manifest.Capabilities))\n34|\t}\n35|\tif !manifest.Supports(\"1.0.0\") || !manifest.Supports(\"2.0.0\") || manifest.Supports(\"3.0.0\") {\n36|\t\tt.Fatal(\"manifest version support is wrong\")\n37|\t}\n38|\tagain, err := DecodeManifest([]byte(fixtureManifestJSON()))\n39|\tif err != nil {\n40|\t\tt.Fatalf(\"DecodeManifest again error = %v\", err)\n41|\t}\n42|\tif ManifestDigest(manifest) != ManifestDigest(again) {\n43|\t\tt.Fatal(\"manifest digest is not stable across decodes\")\n44|\t}\n45|\tif len(manifest.Canonical()) == 0 {\n46|\t\tt.Fatal(\"manifest canonical bytes are empty\")\n47|\t}\n48|}\n49|\n50|// TestDecodeManifestClosedMemberRules drives the production\n51|// manifest entry with one structural vector per rule: unknown\n52|// members, missing members, wrong schema identity, and shape\n53|// defects in every member class.\n54|func TestDecodeManifestClosedMemberRules(t *testing.T) {\n55|\tt.Parallel()\n56|\tgood := fixtureManifestJSON()\n57|\tfor _, probe := range []struct {\n58|\t\tname  string\n59|\t\tbody  string\n60|\t\tfatal bool\n61|\t}{\n62|\t\t{\"unknown member\", replaceOnce(t, good, `\"limits\":{`, `\"limits\":{},\"extra\":1,`, 1), true},\n63|\t\t{\"missing member\", replaceOnce(t, good, `\"node_version\":\"2.4.1\",`, ``, 1), true},\n64|\t\t{\"wrong schema\", replaceOnce(t, good, \"session-directory-node-manifest\", \"session-directory-node-response\", 1), true},\n65|\t\t{\"wrong version\", replaceOnce(t, good, `\"schema_version\":\"1.0.0\"`, `\"schema_version\":\"2.0.0\"`, 1), true},\n66|\t\t{\"empty node id\", replaceOnce(t, good, `\"node_id\":\"test-directory-node\"`, `\"node_id\":\"\"`, 1), true},\n67|\t\t{\"bad node version\", replaceOnce(t, good, `\"node_version\":\"2.4.1\"`, `\"node_version\":\"2.4\"`, 1), true},\n68|\t\t{\"bad host id\", replaceOnce(t, good, fixtureHostID, \"not-a-uuid\", 1), true},\n69|\t\t{\"bad executable digest\", replaceOnce(t, good, fixtureExecutableDigest, \"sha256:zzz\", 1), true},\n70|\t\t{\"bad tuple registry\", replaceOnce(t, good, fixtureTupleRegistry, \"null\", 1), true},\n71|\t\t{\"duplicate member\", good[:len(good)-1] + `,\"node_id\":\"x\"}`, true},\n72|\t\t{\"non object\", `[]`, true},\n73|\t\t{\"empty redaction policies\", replaceOnce(t, good, `\"redaction_policy_ids\":[`+quote(fixtureRedactionDigest)+`]`, `\"redaction_policy_ids\":[]`, 1), true},\n74|\t\t{\"bad enrichment profile\", replaceOnce(t, good, fixtureEnrichmentDigest, \"sha256:zzz\", 1), true},\n75|\t\t{\"bad top-level extensions\", replaceOnce(t, good, `\"extensions\":{}},\"extensions\":{}}`, `\"extensions\":{}},\"extensions\":{\"x\":1}}`, 1), true},\n76|\t\t{\"deep nesting past canonical bound\", deepExtensionsManifest(t, good), true},\n77|\t} {\n78|\t\tt.Run(probe.name, func(t *testing.T) {\n79|\t\t\tt.Parallel()\n80|\t\t\tif _, err := DecodeManifest([]byte(probe.body)); requireCode(t, err, \"adapter_protocol_violation\") == nil {\n81|\t\t\t\tt.Fatal(\"must refuse\")\n82|\t\t\t}\n83|\t\t})\n84|\t}\n85|}\n86|\n87|// deepExtensionsManifest nests one extensions value past the\n88|// canonicalizer's depth bound: the member checks cross extensions\n89|// values opaquely, so the body validates structurally and then\n90|// fails the host-computed canonicalization — the \"not canonical\n91|// JSON\" arm fires through the production entry, not only in\n92|// theory.\n93|func deepExtensionsManifest(t *testing.T, good string) string {\n94|\tt.Helper()\n95|\tnested := `{\"a\":0}`\n96|\tfor range 300 {\n97|\t\tnested = `{\"a\":` + nested + `}`\n98|\t}\n99|\treturn deepExtensionsSwap(t, good, nested)\n100|}\n101|\n102|// deepExtensionsSwap replaces the manifest top-level extensions\n103|// object with a deeply nested one.\n104|func deepExtensionsSwap(t *testing.T, good, nested string) string {\n105|\tt.Helper()\n106|\tneedle := `\"extensions\":{}},\"extensions\":{}}`\n107|\tif !strings.Contains(good, needle) {\n108|\t\tt.Fatalf(\"manifest tail needle absent\")\n109|\t}\n110|\treturn replaceOnce(t, good, `\"extensions\":{}},\"extensions\":{}}`, `\"extensions\":{}},\"extensions\":{\"com.example.deep\":`+nested+`}}`, 1)\n111|}\n112|\n113|// TestDecodeManifestRegistryRules drives the production manifest\n114|// entry against the registry members: reordered, dropped, padded,\n115|// and mis-sorted registries refuse, as do out-of-bound schema\n116|// counts and malformed assertions.\n117|func TestDecodeManifestRegistryRules(t *testing.T) {\n118|\tt.Parallel()\n119|\tgood := fixtureManifestJSON()\n120|\tswapped := replaceOnce(t, good, `\"operations\":[\"continuation-inspect\",\"doctor\"`, `\"operations\":[\"doctor\",\"continuation-inspect\"`, 1)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c649","stream":{"kind":"session","id":"01a075af-a7c5-7382-ae46-5efb02855e33"},"sequence":383,"recorded_at":1780531400000761,"record_type":"event","durability":"durable","causation_id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589","run_stream":{"kind":"run","id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589"},"call_id":"call_01a075b0e4f27061b2ec6d70682b0076","text":"Read text file `internal/dirnode/query_test.go`.\n1|package dirnode\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|)\n7|\n8|// TestDecodeQueryAcceptsFixture drives the production query entry\n9|// with the exact contract vector: the batch identifier, the two\n10|// position-indexed operations with their halves, and the caller.\n11|func TestDecodeQueryAcceptsFixture(t *testing.T) {\n12|\tt.Parallel()\n13|\tquery, err := DecodeQuery([]byte(fixtureQueryJSON()))\n14|\tif err != nil {\n15|\t\tt.Fatalf(\"DecodeQuery error = %v\", err)\n16|\t}\n17|\tif query.QueryID != fixtureQueryID {\n18|\t\tt.Fatalf(\"query id = %q\", query.QueryID)\n19|\t}\n20|\tif len(query.Operations) != 2 {\n21|\t\tt.Fatalf(\"operations = %d, want 2\", len(query.Operations))\n22|\t}\n23|\tif query.Operations[0].Index != 0 || query.Operations[0].Name != \"schema\" || query.Operations[0].Kind != queryKindRead {\n24|\t\tt.Fatalf(\"operation 0 = %+v\", query.Operations[0])\n25|\t}\n26|\tif query.Operations[1].Index != 1 || query.Operations[1].Name != \"sessions\" || query.Operations[1].Kind != queryKindRead {\n27|\t\tt.Fatalf(\"operation 1 = %+v\", query.Operations[1])\n28|\t}\n29|\tif query.Caller.CallerID != \"test-caller\" || query.Caller.Interaction != \"non_interactive\" || len(query.Caller.Scopes) != 1 {\n30|\t\tt.Fatalf(\"caller = %+v\", query.Caller)\n31|\t}\n32|}\n33|\n34|// TestDecodeQueryIndexRules drives the production query entry\n35|// with index defects: duplicate, sparse, reordered, and\n36|// position-mismatched indexes invalidate the whole batch before\n37|// any operation executes.\n38|func TestDecodeQueryIndexRules(t *testing.T) {\n39|\tt.Parallel()\n40|\tgood := fixtureQueryJSON()\n41|\tschemaOp := `{\"operation_index\":0,\"name\":\"schema\",\"parameters\":{\"extensions\":{}},\"fields\":null,\"preset\":null,\"skip\":0,\"take\":1,\"sort\":[],\"dry_run\":false,\"confirm\":false,\"expectation_digest\":null,\"idempotency_key\":null,\"extensions\":{}}`\n42|\tduplicate := replaceOnce(t, good, `\"operation_index\":1`, `\"operation_index\":0`, 1)\n43|\tsparse := replaceOnce(t, good, `\"operation_index\":1`, `\"operation_index\":2`, 1)\n44|\treordered := replaceOnce(t, good, `\"operations\":[`+schemaOp+`,`, `\"operations\":[`, 1)\n45|\treordered = replaceOnce(t, reordered, `],\"caller\"`, `,`+schemaOp+`],\"caller\"`, 1)\n46|\tempty := `{\"schema\":\"urn:ax:schema:session-directory-query\",\"schema_version\":\"1.0.0\",\"query_id\":\"` + fixtureQueryID + `\",\"operations\":[],\"caller\":` + fixtureCallerJSON() + `,\"extensions\":{}}`\n47|\tfor _, probe := range []struct {\n48|\t\tname string\n49|\t\tbody string\n50|\t}{\n51|\t\t{\"duplicate index\", duplicate},\n52|\t\t{\"sparse index\", sparse},\n53|\t\t{\"reordered operations\", reordered},\n54|\t\t{\"dropped first operation\", replaceOnce(t, good, `\"operations\":[`+schemaOp+`,`, `\"operations\":[`, 1)},\n55|\t\t{\"empty batch\", empty},\n56|\t} {\n57|\t\tt.Run(probe.name, func(t *testing.T) {\n58|\t\t\tt.Parallel()\n59|\t\t\tif _, err := DecodeQuery([]byte(probe.body)); requireCode(t, err, \"query_invalid\") == nil {\n60|\t\t\t\tt.Fatal(\"must refuse\")\n61|\t\t\t}\n62|\t\t})\n63|\t}\n64|}\n65|\n66|// TestDecodeQueryEnvelopeRules drives the production query entry\n67|// with one envelope vector per rule.\n68|func TestDecodeQueryEnvelopeRules(t *testing.T) {\n69|\tt.Parallel()\n70|\tgood := fixtureQueryJSON()\n71|\tfor _, probe := range []struct {\n72|\t\tname string\n73|\t\tbody string\n74|\t}{\n75|\t\t{\"unknown member\", replaceOnce(t, good, `\"extensions\":{}}`, `\"extensions\":{},\"extra\":1}`, 1)},\n76|\t\t{\"missing caller\", replaceOnce(t, good, `,\"caller\":`+fixtureCallerJSON(), ``, 1)},\n77|\t\t{\"wrong schema\", replaceOnce(t, good, \"session-directory-query\", \"session-directory-node-request\", 1)},\n78|\t\t{\"wrong version\", replaceOnce(t, good, `\"schema_version\":\"1.0.0\"`, `\"schema_version\":\"2.0.0\"`, 1)},\n79|\t\t{\"bad query id\", replaceOnce(t, good, fixtureQueryID, \"not-a-uuid\", 1)},\n80|\t\t{\"bad caller scope\", replaceOnce(t, good, `\"directory.read\"`, `\"directory.root\"`, 1)},\n81|\t\t{\"empty scopes\", replaceOnce(t, good, `\"scopes\":[\"directory.read\"]`, `\"scopes\":[]`, 1)},\n82|\t\t{\"bad interaction\", replaceOnce(t, good, `\"non_interactive\"`, `\"whenever\"`, 1)},\n83|\t\t{\"bad origin host\", replaceOnce(t, good, fixtureOriginHost, \"not-a-uuid\", 1)},\n84|\t\t{\"non object\", `[]`},\n85|\t} {\n86|\t\tt.Run(probe.name, func(t *testing.T) {\n87|\t\t\tt.Parallel()\n88|\t\t\tif _, err := DecodeQuery([]byte(probe.body)); requireCode(t, err, \"query_invalid\") == nil {\n89|\t\t\t\tt.Fatal(\"must refuse\")\n90|\t\t\t}\n91|\t\t})\n92|\t}\n93|}\n94|\n95|// TestDecodeQueryRegistryRules drives the production query entry\n96|// with unknown operations, unknown parameters, and unknown\n97|// filters: the parser rejects the whole batch on unknown syntax,\n98|// operation, parameter, field, preset, filter, sort key, or\n99|// bound.\n100|func TestDecodeQueryRegistryRules(t *testing.T) {\n101|\tt.Parallel()\n102|\tgood := fixtureQueryJSON()\n103|\tfor _, probe := range []struct {\n104|\t\tname string\n105|\t\tbody string\n106|\t}{\n107|\t\t{\"unknown operation\", replaceOnce(t, good, `\"name\":\"sessions\"`, `\"name\":\"search\"`, 1)},\n108|\t\t{\"unknown parameter\", replaceOnce(t, good, `\"filters\":{\"kinds\"`, `\"filters\":{\"kindsX\"`, 1)},\n109|\t\t{\"unknown filter\", replaceOnce(t, good, `\"freshness\":[]`, `\"freshness\":[],\"fuzz\":[]`, 1)},\n110|\t\t{\"unknown field\", replaceOnce(t, good, `\"fields\":null,\"preset\":\"overview\"`, `\"fields\":[\"nope\"],\"preset\":null`, 1)},\n111|\t\t{\"unknown preset\", replaceOnce(t, good, `\"preset\":\"overview\"`, `\"preset\":\"everything\"`, 1)},\n112|\t\t{\"unknown sort field\", replaceOnce(t, good, `\"field\":\"stable_id\"`, `\"field\":\"vibes\"`, 1)},\n113|\t\t{\"unknown sort direction\", replaceOnce(t, good, `\"direction\":\"asc\"`, `\"direction\":\"sideways\"`, 1)},\n114|\t\t{\"fields and preset together\", replaceOnce(t, good, `\"fields\":null,\"preset\":\"overview\"`, `\"fields\":[\"id\"],\"preset\":\"overview\"`, 1)},\n115|\t\t{\"bad filter enum\", replaceOnce(t, good, `\"reachability\":[]`, `\"reachability\":[\"everywhere\"]`, 1)},\n116|\t\t{\"bad provider id\", replaceOnce(t, good, `\"provider_ids\":[]`, `\"provider_ids\":[\"BAD\"]`, 1)},\n117|\t} {\n118|\t\tt.Run(probe.name, func(t *testing.T) {\n119|\t\t\tt.Parallel()\n120|\t\t\tif _, err := DecodeQuery([]byte(probe.body)); requireCode(t, err, \"query_invalid\") == nil {\n121|\t\t\t\tt.Fatal(\"must refuse\")\n122|\t\t\t}\n123|\t\t})\n124|\t}\n125|}\n126|\n127|// mutationBatch builds a one-operation mutation batch with the\n128|// given parameters, flags, and digests for the flag-rule tests.\n129|func mutationBatch(name, parameters string, dryRun, confirm bool, expectation, idempotency string) string {\n130|\treturn `{\"schema\":\"urn:ax:schema:session-directory-query\",\"schema_version\":\"1.0.0\",\"query_id\":\"` + fixtureQueryID + `\",\"operations\":[{\"operation_index\":0,\"name\":\"` + name + `\",\"parameters\":` + parameters + `,\"fields\":null,\"preset\":null,\"skip\":0,\"take\":1,\"sort\":[],\"dry_run\":` + boolString(dryRun) + `,\"confirm\":` + boolString(confirm) + `,\"expectation_digest\":` + expectation + `,\"idempotency_key\":` + idempotency + `,\"extensions\":{}}],\"caller\":` + fixtureCallerJSON() + `,\"extensions\":{}}`\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c64b","stream":{"kind":"session","id":"01a075af-a7c5-7382-ae46-5efb02855e33"},"sequence":384,"recorded_at":1780531400000763,"record_type":"event","durability":"durable","causation_id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589","run_stream":{"kind":"run","id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589"},"call_id":"call_01a075b0e5af77b1ba1cf6e70f6275da","text":"Read text file `internal/dirnode/probe_test.go`.\n1|package dirnode\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|)\n7|\n8|// TestProbeRequestMajorVocabularies drives the production probe\n9|// request entry across both majors: each major admits its own\n10|// vocabulary and refuses the other's exclusive tokens, and no\n11|// token is coerced across majors.\n12|func TestProbeRequestMajorVocabularies(t *testing.T) {\n13|\tt.Parallel()\n14|\tv2, err := CheckProbeRequest(MajorV2, []byte(fixtureProbeRequestV2()))\n15|\tif err != nil {\n16|\t\tt.Fatalf(\"CheckProbeRequest(v2) error = %v\", err)\n17|\t}\n18|\tif v2.Platform != \"linux\" || v2.Architecture != \"amd64\" || len(v2.RequestedCapabilities) != 1 {\n19|\t\tt.Fatalf(\"CheckProbeRequest(v2) = %+v\", v2)\n20|\t}\n21|\tv1, err := CheckProbeRequest(MajorV1, []byte(fixtureProbeRequestV1()))\n22|\tif err != nil {\n23|\t\tt.Fatalf(\"CheckProbeRequest(v1) error = %v\", err)\n24|\t}\n25|\tif v1.Platform != \"darwin\" || v1.Architecture != \"arm64\" {\n26|\t\tt.Fatalf(\"CheckProbeRequest(v1) = %+v\", v1)\n27|\t}\n28|\tfor _, probe := range []struct {\n29|\t\tname  string\n30|\t\tmajor int\n31|\t\tbody  string\n32|\t}{\n33|\t\t{\"v1 refuses macos\", MajorV1, `{\"platform\":\"macos\",\"architecture\":\"amd64\",\"requested_environment_ids\":[],\"requested_capabilities\":[],\"extensions\":{}}`},\n34|\t\t{\"v1 refuses wsl2\", MajorV1, `{\"platform\":\"wsl2\",\"architecture\":\"amd64\",\"requested_environment_ids\":[],\"requested_capabilities\":[],\"extensions\":{}}`},\n35|\t\t{\"v2 refuses darwin\", MajorV2, `{\"platform\":\"darwin\",\"architecture\":\"amd64\",\"requested_environment_ids\":[],\"requested_capabilities\":[],\"extensions\":{}}`},\n36|\t\t{\"v2 accepts wsl2\", MajorV2, `{\"platform\":\"wsl2\",\"architecture\":\"arm64\",\"requested_environment_ids\":[],\"requested_capabilities\":[],\"extensions\":{}}`},\n37|\t\t{\"v2 accepts macos\", MajorV2, `{\"platform\":\"macos\",\"architecture\":\"amd64\",\"requested_environment_ids\":[],\"requested_capabilities\":[],\"extensions\":{}}`},\n38|\t\t{\"v1 accepts windows\", MajorV1, `{\"platform\":\"windows\",\"architecture\":\"amd64\",\"requested_environment_ids\":[],\"requested_capabilities\":[],\"extensions\":{}}`},\n39|\t\t{\"unknown token\", MajorV2, `{\"platform\":\"plan9\",\"architecture\":\"amd64\",\"requested_environment_ids\":[],\"requested_capabilities\":[],\"extensions\":{}}`},\n40|\t} {\n41|\t\tt.Run(probe.name, func(t *testing.T) {\n42|\t\t\tt.Parallel()\n43|\t\t\t_, err := CheckProbeRequest(probe.major, []byte(probe.body))\n44|\t\t\trefuses := strings.Contains(probe.name, \"refuses\") || probe.name == \"unknown token\"\n45|\t\t\tif refuses && err == nil {\n46|\t\t\t\tt.Fatalf(\"CheckProbeRequest(%s) must refuse\", probe.name)\n47|\t\t\t}\n48|\t\t\tif !refuses && err != nil {\n49|\t\t\t\tt.Fatalf(\"CheckProbeRequest(%s) error = %v\", probe.name, err)\n50|\t\t\t}\n51|\t\t\tif refuses {\n52|\t\t\t\trequireCode(t, err, \"adapter_protocol_violation\")\n53|\t\t\t}\n54|\t\t})\n55|\t}\n56|}\n57|\n58|// TestProbeRequestRefusals drives the production probe request\n59|// entry with one structural vector per rule.\n60|func TestProbeRequestRefusals(t *testing.T) {\n61|\tt.Parallel()\n62|\tgood := fixtureProbeRequestV2()\n63|\tfor _, probe := range []struct {\n64|\t\tname string\n65|\t\tbody string\n66|\t}{\n67|\t\t{\"unknown member\", replaceOnce(t, good, `\"extensions\":{}}`, `\"extensions\":{},\"extra\":1}`, 1)},\n68|\t\t{\"missing member\", replaceOnce(t, good, `\"architecture\":\"amd64\",`, ``, 1)},\n69|\t\t{\"bad architecture\", replaceOnce(t, good, `\"amd64\"`, `\"riscv\"`, 1)},\n70|\t\t{\"non string platform\", replaceOnce(t, good, `\"platform\":\"linux\"`, `\"platform\":1`, 1)},\n71|\t\t{\"unsorted environments\", replaceOnce(t, good, `\"requested_environment_ids\":[]`, `\"requested_environment_ids\":[\"b.env\",\"a.env\"]`, 1)},\n72|\t\t{\"bad environment id\", replaceOnce(t, good, `\"requested_environment_ids\":[]`, `\"requested_environment_ids\":[\"BAD\"]`, 1)},\n73|\t\t{\"too many capabilities\", replaceOnce(t, good, `\"requested_capabilities\":[\"directory_discovery\"]`, `\"requested_capabilities\":[\"directory_discovery\",\"directory_head_digest\",\"directory_incremental_scan\",\"directory_tail_preview\",\"existing_session_adoption\",\"native_resume\",\"native_runtime_observation\",\"native_title_read\",\"extra\"]`, 1)},\n74|\t\t{\"unknown capability\", replaceOnce(t, good, `\"requested_capabilities\":[\"directory_discovery\"]`, `\"requested_capabilities\":[\"directory_time_travel\"]`, 1)},\n75|\t\t{\"bad extensions\", replaceOnce(t, good, `\"extensions\":{}}`, `\"extensions\":{\"not-reversedns\":1}}`, 1)},\n76|\t\t{\"non object\", `[]`},\n77|\t} {\n78|\t\tt.Run(probe.name, func(t *testing.T) {\n79|\t\t\tt.Parallel()\n80|\t\t\tif _, err := CheckProbeRequest(MajorV2, []byte(probe.body)); requireCode(t, err, \"adapter_protocol_violation\") == nil {\n81|\t\t\t\tt.Fatal(\"must refuse\")\n82|\t\t\t}\n83|\t\t})\n84|\t}\n85|\tif _, err := CheckProbeRequest(3, []byte(good)); requireCode(t, err, \"invalid_config\") == nil {\n86|\t\tt.Fatal(\"CheckProbeRequest(3) must refuse\")\n87|\t}\n88|}\n89|\n90|// TestProbeResponseAcceptsFixture drives the production probe\n91|// response entry with the exact contract vector and requires the\n92|// node-build equality gate to accept the fixture build against\n93|// the fixture manifest.\n94|func TestProbeResponseAcceptsFixture(t *testing.T) {\n95|\tt.Parallel()\n96|\tresponse, err := CheckProbeResponse([]byte(fixtureProbeResponseJSON()))\n97|\tif err != nil {\n98|\t\tt.Fatalf(\"CheckProbeResponse error = %v\", err)\n99|\t}\n100|\tif response.HostID != fixtureHostID || response.PolicyDigest != fixturePolicyDigest {\n101|\t\tt.Fatalf(\"probe response identity = %q %q\", response.HostID, response.PolicyDigest)\n102|\t}\n103|\tif response.Environments != 1 || len(response.Findings) != 1 {\n104|\t\tt.Fatalf(\"probe response counts = %d env %d findings\", response.Environments, len(response.Findings))\n105|\t}\n106|\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n107|\tif err != nil {\n108|\t\tt.Fatalf(\"DecodeManifest error = %v\", err)\n109|\t}\n110|\tif err := CheckNodeBuildEqualsManifest(response.Build, manifest); err != nil {\n111|\t\tt.Fatalf(\"CheckNodeBuildEqualsManifest error = %v\", err)\n112|\t}\n113|}\n114|\n115|// TestProbeResponseAdmitsOpaqueEnvironments drives the production\n116|// probe response entry with content-free environment objects: the\n117|// entry checks presence and object shape only, never content —\n118|// the shared-environment leaf owns that content, and this test\n119|// pins the boundary so a future content check fails loudly here\n120|// instead of arriving silently.\n121|func TestProbeResponseAdmitsOpaqueEnvironments(t *testing.T) {\n122|\tt.Parallel()\n123|\tbody := replaceOnce(t, fixtureProbeResponseJSON(), `[{\"environment_id\":\"test.env\"}]`, `[{},{}]`, 1)\n124|\tresponse, err := CheckProbeResponse([]byte(body))\n125|\tif err != nil {\n126|\t\tt.Fatalf(\"CheckProbeResponse(opaque) error = %v\", err)\n127|\t}\n128|\tif response.Environments != 2 {\n129|\t\tt.Fatalf(\"environments = %d, want 2\", response.Environments)\n130|\t}\n131|}\n132|\n133|// TestProbeResponseRefusals drives the production probe response\n134|// entry with one structural vector per rule.\n135|func TestProbeResponseRefusals(t *testing.T) {\n136|\tt.Parallel()\n137|\tgood := fixtureProbeResponseJSON()\n138|\tfor _, probe := range []struct {\n139|\t\tname string\n140|\t\tbody string\n141|\t}{\n142|\t\t{\"unknown member\", replaceOnce(t, good, `\"extensions\":{}}`, `\"extensions\":{},\"extra\":1}`, 1)},\n143|\t\t{\"missing member\", replaceOnce(t, good, `\"policy_digest\":`+quote(fixturePolicyDigest)+`,`, ``, 1)},\n144|\t\t{\"bad host id\", replaceOnce(t, good, fixtureHostID, \"not-a-uuid\", 1)},\n145|\t\t{\"bad policy digest\", replaceOnce(t, good, fixturePolicyDigest, \"sha256:zzz\", 1)},\n146|\t\t{\"node build extra member\", replaceOnce(t, good, `\"session_adapter_manifest_digest\":`, `\"session_adapter_manifest_digestX\":`, 1)},\n147|\t\t{\"non object environment\", replaceOnce(t, good, `[{\"environment_id\":\"test.env\"}]`, `[1]`, 1)},\n148|\t\t{\"too many environments\", replaceOnce(t, good, `[{\"environment_id\":\"test.env\"}]`, `[`+strings.Repeat(`{},`, 257)+`{}]`, 1)},\n149|\t\t{\"bad severity\", replaceOnce(t, good, `\"severity\":\"info\"`, `\"severity\":\"fatal\"`, 1)},\n150|\t\t{\"empty finding code\", replaceOnce(t, good, `\"code\":\"probe-ok\"`, `\"code\":\"\"`, 1)},\n151|\t\t{\"empty finding message\", replaceOnce(t, good, `\"message\":\"probe completed\"`, `\"message\":\"\"`, 1)},\n152|\t\t{\"non string remediation\", replaceOnce(t, good, `\"remediation\":null`, `\"remediation\":0`, 1)},\n153|\t\t{\"non object\", `[]`},\n154|\t} {\n155|\t\tt.Run(probe.name, func(t *testing.T) {\n156|\t\t\tt.Parallel()\n157|\t\t\tif _, err := CheckProbeResponse([]byte(probe.body)); requireCode(t, err, \"adapter_protocol_violation\") == nil {\n158|\t\t\t\tt.Fatal(\"must refuse\")\n159|\t\t\t}\n160|\t\t})\n161|\t}\n162|}\n163|\n164|// TestProbeResponseFindingBound drives the production probe\n165|// response entry against the finding count bound: more than 4096\n166|// findings refuse no matter how small each one is.\n167|func TestProbeResponseFindingBound(t *testing.T) {\n168|\tt.Parallel()\n169|\tone := `{\"severity\":\"info\",\"code\":\"c\",\"message\":\"m\",\"remediation\":null,\"extensions\":{}}`\n170|\tmany := strings.Repeat(one+`,`, 4096) + one\n171|\tbody := replaceOnce(t, fixtureProbeResponseJSON(), `\"findings\":[{`, `\"findings\":[`+many+`,{`, 1)\n172|\tif _, err := CheckProbeResponse([]byte(body)); requireCode(t, err, \"adapter_protocol_violation\") == nil {\n173|\t\tt.Fatal(\"4098 findings must refuse\")\n174|\t}\n175|\t// Exactly one past the ceiling: a mutant widening the cap by\n176|\t// one still refuses 4098, so only the 4097 case reddens it.\n177|\tplusOne := replaceOnce(t, fixtureProbeResponseJSON(), `\"findings\":[{`, `\"findings\":[`+strings.Repeat(one+`,`, 4095)+one+`,{`, 1)\n178|\tif _, err := CheckProbeResponse([]byte(plusOne)); requireCode(t, err, \"adapter_protocol_violation\") == nil {\n179|\t\tt.Fatal(\"4097 findings must refuse\")\n180|\t}\n181|\tedge := replaceOnce(t, fixtureProbeResponseJSON(), `\"findings\":[{`, `\"findings\":[`+strings.Repeat(one+`,`, 4094)+one+`,{`, 1)\n182|\tif _, err := CheckProbeResponse([]byte(edge)); err != nil {\n183|\t\tt.Fatalf(\"4096 findings must admit: %v\", err)\n184|\t}\n185|}\n186|\n187|// TestNodeBuildEqualityRefusesDrift drives the production\n188|// node-build equality gate with one drifted value per binding:\n189|// any divergence from the manifest is an integrity failure.\n190|func TestNodeBuildEqualityRefusesDrift(t *testing.T) {\n191|\tt.Parallel()\n192|\tresponse, err := CheckProbeResponse([]byte(fixtureProbeResponseJSON()))\n193|\tif err != nil {\n194|\t\tt.Fatalf(\"CheckProbeResponse error = %v\", err)\n195|\t}\n196|\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n197|\tif err != nil {\n198|\t\tt.Fatalf(\"DecodeManifest error = %v\", err)\n199|\t}\n200|\tfor _, probe := range []struct {\n201|\t\tname  string\n202|\t\tapply func(*NodeBuild)\n203|\t}{\n204|\t\t{\"node id\", func(build *NodeBuild) { build.NodeID = \"other-node\" }},\n205|\t\t{\"node version\", func(build *NodeBuild) { build.NodeVersion = \"9.9.9\" }},\n206|\t\t{\"executable\", func(build *NodeBuild) { build.ExecutableSHA256 = fixtureDigest(\"other\") }},\n207|\t\t{\"provider binding\", func(build *NodeBuild) { build.ProviderManifestDigest = fixtureDigest(\"other\") }},\n208|\t\t{\"adapter binding\", func(build *NodeBuild) { build.AdapterManifestDigest = fixtureDigest(\"other\") }},\n209|\t} {\n210|\t\tt.Run(probe.name, func(t *testing.T) {\n211|\t\t\tt.Parallel()\n212|\t\t\tbuild := response.Build\n213|\t\t\tprobe.apply(&build)\n214|\t\t\trequireCode(t, CheckNodeBuildEqualsManifest(build, manifest), \"integrity_failure\")\n215|\t\t})\n216|\t}\n217|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
