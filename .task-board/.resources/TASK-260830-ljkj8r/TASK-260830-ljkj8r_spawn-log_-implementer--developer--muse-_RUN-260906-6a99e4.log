{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cbe7","stream":{"kind":"session","id":"01a075af-a7c5-7382-ae46-5efb02855e33"},"sequence":1102,"recorded_at":1780531400002199,"record_type":"event","durability":"durable","causation_id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589","run_stream":{"kind":"run","id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589"},"task_stream":{"kind":"task","id":"4cc96fe2-7b3c-46bb-b3be-f92706476f2a"},"task_id":"4cc96fe2-7b3c-46bb-b3be-f92706476f2a","event":{"kind":"output","task_id":"4cc96fe2-7b3c-46bb-b3be-f92706476f2a","chunk":"Read text file `internal/dirnode/bootstrap.go`.\n1|package dirnode\n2|\n3|import (\n4|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n5|)\n6|\n7|// This file owns the Section 7.9 major bootstrap decision: the\n8|// caller enumerates its locally supported majors in strictly\n9|// descending order with one manifest request each, each attempt on a\n10|// fresh process, and only the exact downgrade tuple authorizes the\n11|// next lower attempt.\n12|//\n13|// The decision is a pure function over the attempt outcome, so it is\n14|// testable without spawning processes: DecideBootstrapStep takes the\n15|// request the attempt was issued under, the single response frame if\n16|// the process produced one, and the process exit status, and returns\n17|// exactly one of success (with the validated manifest), authorized\n18|// downgrade (with the next lower major to attempt on a fresh\n19|// process the caller claims in its guard), or a terminal refusal. Process lifecycle —\n20|// launching, terminating, reaping — belongs to the caller; the\n21|// ProcessGuard below is the host check that a returned or failed\n22|// process is never reused for a lower major.\n23|\n24|// BootstrapDecision is one DecideBootstrapStep outcome. Exactly one\n25|// of Manifest, Downgrade, or Terminal carries the verdict: Done\n26|// with a validated manifest whose supported versions contain the\n27|// selected one, Downgrade with the next lower major to attempt on a\n28|// fresh process, or a terminal refusal that must not cause a\n29|// lower-major attempt.\n30|type BootstrapDecision struct {\n31|\tDone      bool\n32|\tManifest  Manifest\n33|\tDowngrade bool\n34|\tNextMajor int\n35|\tTerminal  error\n36|}\n37|\n38|// NextLowerMajor reports the next lower locally supported major to\n39|// attempt. The second result is false when no lower major remains:\n40|// the caller then terminates with its own incompatible_protocol,\n41|// never with a relabeled envelope.\n42|func NextLowerMajor(major int) (int, bool) {\n43|\tfor index, supported := range supportedMajors {\n44|\t\tif supported != major {\n45|\t\t\tcontinue\n46|\t\t}\n47|\t\tif index+1 < len(supportedMajors) {\n48|\t\t\treturn supportedMajors[index+1], true\n49|\t\t}\n50|\t\treturn 0, false\n51|\t}\n52|\treturn 0, false\n53|}\n54|\n55|// isExactDowngradeError reports whether the decoded failure is the\n56|// exact downgrade trigger: Structured Error 1.2\n57|// incompatible_protocol with exit 6 and retryable=false. The\n58|// envelope half of the tuple — one well-framed failure echoing\n59|// protocol, protocol_version, request_id, and operation=manifest\n60|// with response schema_version 1.0.0 — is already established by\n61|// CheckFailureEnvelope before this runs; the process-exit half is\n62|// checked by DecideBootstrapStep against the reaped status. Every\n63|// field is compared: a tuple that names another code, another exit,\n64|// or claims retry permission is an ordinary failure, never\n65|// negotiation evidence.\n66|func isExactDowngradeError(failure *axerror.Error) bool {\n67|\tif failure == nil {\n68|\t\treturn false\n69|\t}\n70|\tif failure.Code() != \"incompatible_protocol\" {\n71|\t\treturn false\n72|\t}\n73|\tif failure.ExitCode() != 6 {\n74|\t\treturn false\n75|\t}\n76|\tif failure.Retryable() {\n77|\t\treturn false\n78|\t}\n79|\treturn true\n80|}\n81|\n82|// ProcessGuard is the host check that a process which returned or\n83|// failed an attempt is never reused for a lower major. The caller\n84|// claims one opaque token per launched process before issuing the\n85|// attempt; claiming the same token twice is a caller error caught\n86|// before any node surface is touched. The zero value is unusable: a\n87|// guard must come from NewProcessGuard so the seen set exists.\n88|type ProcessGuard struct {\n89|\tseen map[string]bool\n90|}\n91|\n92|// NewProcessGuard returns an empty attempt-process guard.\n93|func NewProcessGuard() ProcessGuard {\n94|\treturn ProcessGuard{seen: map[string]bool{}}\n95|}\n96|\n97|// Claim records one attempt process. A token claimed before — a\n98|// returned or failed process offered for a lower major — is\n99|// refused with invalid_config.\n100|func (guard ProcessGuard) Claim(token string) error {\n101|\tif token == \"\" {\n102|\t\tfailure, err := failInvalid(\"bootstrap process token is empty\", \"process\")\n103|\t\tif err != nil {\n104|\t\t\treturn err\n105|\t\t}\n106|\t\treturn failure\n107|\t}\n108|\tif guard.seen[token] {\n109|\t\tfailure, err := failInvalid(\"bootstrap process was already used for an attempt\", \"process\")\n110|\t\tif err != nil {\n111|\t\t\treturn err\n112|\t\t}\n113|\t\treturn failure\n114|\t}\n115|\tguard.seen[token] = true\n116|\treturn nil\n117|}\n118|\n119|// DecideBootstrapStep decides one manifest attempt. frame carries\n120|// the process's single response line, or is empty when the attempt\n121|// produced no valid response (timeout, signal, exit without one\n122|// valid frame, authentication/allowlist failure at the transport).\n123|// exitStatus is the reaped process status.\n124|//\n125|// Success requires a well-framed success response with every echo\n126|// exact, a complete schema-valid manifest whose\n127|// supported_protocol_versions contains the exact attempted version,\n128|// and process exit 0. The exact downgrade tuple — one well-framed\n129|// failure with incompatible_protocol, exit 6, retryable=false, and\n130|// process exit 6 — authorizes the next lower major when one\n131|// remains, and terminates with the caller's own\n132|// incompatible_protocol when none remains. A wrong or missing echo,\n133|// malformed/partial/extra frame, invalid manifest, timeout, signal,\n134|// nonmatching exit status, or any error other than the exact tuple\n135|// is terminal and never causes a lower-major attempt.\n136|func DecideBootstrapStep(want Request, frame []byte, exitStatus int) BootstrapDecision {\n137|\tif want.Operation != OpManifest {\n138|\t\tfailure, err := failInvalid(\"bootstrap attempt does not carry operation manifest\", \"operation\")\n139|\t\tif err != nil {\n140|\t\t\treturn BootstrapDecision{Terminal: err}\n141|\t\t}\n142|\t\treturn BootstrapDecision{Terminal: failure}\n143|\t}\n144|\tif len(frame) == 0 {\n145|\t\tfailure, err := failTransport(\"bootstrap attempt produced no response frame\", \"response\")\n146|\t\tif err != nil {\n147|\t\t\treturn BootstrapDecision{Terminal: err}\n148|\t\t}\n149|\t\treturn BootstrapDecision{Terminal: failure}\n150|\t}\n151|\tif body, err := CheckSuccessEnvelope(frame, want); err == nil {\n152|\t\tmanifest, err := DecodeManifest(body)\n153|\t\tif err != nil {\n154|\t\t\treturn BootstrapDecision{Terminal: err}\n155|\t\t}\n156|\t\tif !manifest.Supports(requestVersion(want)) {\n157|\t\t\tfailure, faultErr := failViolation(\"bootstrap manifest does not contain the attempted version\", \"supported_protocol_versions\")\n158|\t\t\tif faultErr != nil {\n159|\t\t\t\treturn BootstrapDecision{Terminal: faultErr}\n160|\t\t\t}\n161|\t\t\treturn BootstrapDecision{Terminal: failure}\n162|\t\t}\n163|\t\tif exitStatus != 0 {\n164|\t\t\tfailure, faultErr := failViolation(\"bootstrap success carries a nonmatching exit status\", \"exit_status\")\n165|\t\t\tif faultErr != nil {\n166|\t\t\t\treturn BootstrapDecision{Terminal: faultErr}\n167|\t\t\t}\n168|\t\t\treturn BootstrapDecision{Terminal: failure}\n169|\t\t}\n170|\t\treturn BootstrapDecision{Done: true, Manifest: manifest}\n171|\t}\n172|\tfailure, err := CheckFailureEnvelope(frame, want)\n173|\tif err != nil {\n174|\t\treturn BootstrapDecision{Terminal: err}\n175|\t}\n176|\tif !isExactDowngradeError(failure) {\n177|\t\tterminal, terminalErr := failViolation(\"bootstrap failure is not the exact downgrade tuple\", \"error\")\n178|\t\tif terminalErr != nil {\n179|\t\t\treturn BootstrapDecision{Terminal: terminalErr}\n180|\t\t}\n181|\t\treturn BootstrapDecision{Terminal: terminal}\n182|\t}\n183|\tif exitStatus != 6 {\n184|\t\tterminal, terminalErr := failViolation(\"bootstrap downgrade response carries a nonmatching exit status\", \"exit_status\")\n185|\t\tif terminalErr != nil {\n186|\t\t\treturn BootstrapDecision{Terminal: terminalErr}\n187|\t\t}\n188|\t\treturn BootstrapDecision{Terminal: terminal}\n189|\t}\n190|\tnext, ok := NextLowerMajor(want.Major)\n191|\tif !ok {\n192|\t\tterminal, terminalErr := failDowngrade(\"no lower locally supported major remains\", \"protocol_version\")\n193|\t\tif terminalErr != nil {\n194|\t\t\treturn BootstrapDecision{Terminal: terminalErr}\n195|\t\t}\n196|\t\treturn BootstrapDecision{Terminal: terminal}\n197|\t}\n198|\treturn BootstrapDecision{Downgrade: true, NextMajor: next}\n199|}"}}}
