 \"1\"))\n+    hi = int(os.environ.get(\"TO\", str(total)))\n+    print(f\"mode={mode} total={total} range={lo}..{hi}\", flush=True)\n+    # warm compile\n+    run_suite()\n+    for i in range(lo - 1, min(hi, total)):\n+        path, lineno, _ = sites[i]\n+        with open(path) as f:\n+            text = f.read()\n+        lines = text.split(\"\\n\")\n+        cur = lines[lineno - 1]\n+        if kind == \"FALSE2TRUE\":\n+            assert cur.strip() == \"return false\", (path, lineno, cur)\n+            indent = cur[: len(cur) - len(cur.lstrip())]\n+            lines[lineno - 1] = indent + \"return true\"\n+        else:\n+            assert re.match(r\"^\\s*if\\b.*\\{\\s*$\", cur), (path, lineno, cur)\n+            lines[lineno - 1] = cur.rstrip()[:-1].rstrip() + \" && false {\"\n+        with open(path, \"w\") as f:\n+            f.write(\"\\n\".join(lines))\n+        code, fails, build_failed = run_suite()\n+        # restore\n+        with open(path, \"w\") as f:\n+            f.write(text)\n+        if code != 0 and not fails and build_failed:\n+            verdict = \"COMPILE_FAIL\"\n+        else:\n+            verdict = \"KILLED\" if code != 0 else \"SURVIVED\"\n+        extra = (\" \" + \",\".join(fails[:4])) if fails else \"\"\n+        print(f\"ROW {i+1}/{total} {path}:{lineno} {verdict}{extra}\", flush=True)\n+    # verify restore\n+    print(\"restore-ok\", flush=True)\n"}}}
