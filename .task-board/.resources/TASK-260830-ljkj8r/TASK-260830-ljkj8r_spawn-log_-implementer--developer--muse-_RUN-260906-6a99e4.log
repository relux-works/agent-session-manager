{}\", probe.version, request.Body)\n32|\t\t}\n33|\t}\n34|}\n35|\n36|// TestDecodeRequestFrameRefusals drives the production request\n37|// entry with one negative vector per envelope rule. Each vector\n38|// names the production call site (DecodeRequestFrame) and the\n39|// expected code; the detail member is asserted only where the\n40|// envelope names one deterministically.\n41|func TestDecodeRequestFrameRefusals(t *testing.T) {\n42|\tt.Parallel()\n43|\toversize := append(fixtureRequestFrame(\"2.0.0\", \"manifest\", fixtureRequestID, 1, `{}`), make([]byte, frameBoundBytes)...)\n44|\tfor _, probe := range []struct {\n45|\t\tname   string\n46|\t\tframe  []byte\n47|\t\tcode   axerror.Code\n48|\t\tmember string\n49|\t}{\n50|\t\t{\"empty frame\", []byte{}, \"adapter_protocol_violation\", \"\"},\n51|\t\t{\"oversize frame\", oversize, \"adapter_protocol_violation\", \"\"},\n52|\t\t{\"non object\", []byte(`[]`), \"adapter_protocol_violation\", \"\"},\n53|\t\t{\"duplicate member\", []byte(`{\"schema\":\"urn:ax:schema:session-directory-node-request\",\"schema_version\":\"2.0.0\",\"protocol\":\"urn:ax:protocol:session-directory-node\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + fixtureRequestID + `\",\"operation\":\"manifest\",\"deadline_ms\":1,\"body\":{},\"body\":{}}`), \"adapter_protocol_violation\", \"body\"},\n54|\t\t{\"unknown member\", []byte(replaceOnce(t, string(fixtureRequestFrame(\"2.0.0\", \"manifest\", fixtureRequestID, 1, `{}`)), `\"deadline_ms\":1`, `\"deadline_ms\":1,\"extra\":1`, 1)), \"adapter_protocol_violation\", \"extra\"},\n55|\t\t{\"missing member\", []byte(`{\"schema\":\"urn:ax:schema:session-directory-node-request\",\"schema_version\":\"2.0.0\",\"protocol\":\"urn:ax:protocol:session-directory-node\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + fixtureRequestID + `\",\"operation\":\"manifest\",\"body\":{}}`), \"adapter_protocol_violation\", \"deadline_ms\"},\n56|\t\t{\"wrong schema\", []byte(replaceOnce(t, string(fixtureRequestFrame(\"2.0.0\", \"manifest\", fixtureRequestID, 1, `{}`)), \"session-directory-node-request\", \"session-directory-node-response\", 1)), \"adapter_protocol_violation\", \"schema\"},\n57|\t\t{\"non string protocol version\", []byte(replaceOnce(t, string(fixtureRequestFrame(\"2.0.0\", \"manifest\", fixtureRequestID, 1, `{}`)), `\"protocol_version\":\"2.0.0\"`, `\"protocol_version\":2`, 1)), \"adapter_protocol_violation\", \"protocol_version\"},\n58|\t\t{\"non string schema version\", []byte(replaceOnce(t, string(fixtureRequestFrame(\"2.0.0\", \"manifest\", fixtureRequestID, 1, `{}`)), `\"schema_version\":\"2.0.0\"`, `\"schema_version\":2`, 1)), \"adapter_protocol_violation\", \"schema_version\"},\n59|\t\t{\"wrong protocol\", []byte(replaceOnce(t, string(fixtureRequestFrame(\"2.0.0\", \"manifest\", fixtureRequestID, 1, `{}`)), `\"protocol\":\"urn:ax:protocol:session-directory-node\"`, `\"protocol\":\"urn:ax:protocol:provider\"`, 1)), \"adapter_protocol_violation\", \"protocol\"},\n60|\t\t{\"non string request id\", []byte(replaceOnce(t, string(fixtureRequestFrame(\"2.0.0\", \"manifest\", fixtureRequestID, 1, `{}`)), `\"request_id\":\"`+fixtureRequestID+`\"`, `\"request_id\":7`, 1)), \"adapter_protocol_violation\", \"request_id\"},\n61|\t\t{\"non string operation\", []byte(replaceOnce(t, string(fixtureRequestFrame(\"2.0.0\", \"manifest\", fixtureRequestID, 1, `{}`)), `\"operation\":\"manifest\"`, `\"operation\":7`, 1)), \"adapter_protocol_violation\", \"operation\"},\n62|\t\t{\"relabeled major pair\", fixtureRequestFrame(\"1.0.0\", \"manifest\", fixtureRequestID, 1, `{}`)[:0:0], \"adapter_protocol_violation\", \"\"},\n63|\t\t{\"unknown operation\", fixtureRequestFrame(\"2.0.0\", \"query\", fixtureRequestID, 1, `{}`), \"operation_unknown\", \"\"},\n64|\t\t{\"bad request id\", fixtureRequestFrame(\"2.0.0\", \"manifest\", \"not-a-uuid\", 1, `{}`), \"adapter_protocol_violation\", \"request_id\"},\n65|\t\t{\"zero deadline\", fixtureRequestFrame(\"2.0.0\", \"manifest\", fixtureRequestID, 0, `{}`), \"adapter_protocol_violation\", \"deadline_ms\"},\n66|\t\t{\"deadline past bound\", fixtureRequestFrame(\"2.0.0\", \"manifest\", fixtureRequestID, 3600001, `{}`), \"adapter_protocol_violation\", \"deadline_ms\"},\n67|\t\t{\"non object body\", fixtureRequestFrame(\"2.0.0\", \"manifest\", fixtureRequestID, 1, `[]`), \"adapter_protocol_violation\", \"body\"},\n68|\t} {\n69|\t\tframe := probe.frame\n70|\t\tif probe.name == \"relabeled major pair\" {\n71|\t\t\traw := string(fixtureRequestFrame(\"2.0.0\", \"manifest\", fixtureRequestID, 1, `{}`))\n72|\t\t\traw = replaceOnce(t, raw, `\"protocol_version\":\"2.0.0\"`, `\"protocol_version\":\"1.0.0\"`, 1)\n73|\t\t\tframe = []byte(raw)\n74|\t\t}\n75|\t\tt.Run(probe.name, func(t *testing.T) {\n76|\t\t\tt.Parallel()\n77|\t\t\t_, err := DecodeRequestFrame(frame)\n78|\t\t\tfailure := requireCode(t, err, probe.code)\n79|\t\t\tif probe.member != \"\" {\n80|\t\t\t\tdetail, _ := failure.Detail(\"member\")\n81|\t\t\t\tif detail != probe.member {\n82|\t\t\t\t\tt.Fatalf(\"refusal detail member = %v, want %q\", detail, probe.member)\n83|\t\t\t\t}\n84|\t\t\t}\n85|\t\t})\n86|\t}\n87|}\n88|\n89|// TestEncodeRequestRoundTrip drives the production request builder\n90|// and requires its output to validate through the production\n91|// decoder with identical fields.\n92|func TestEncodeRequestRoundTrip(t *testing.T) {\n93|\tt.Parallel()\n94|\tfor _, major := range SupportedMajors() {\n95|\t\tframe, err := EncodeRequest(major, OpProbe, fixtureRequestID, 1000, []byte(fixtureProbeRequestV2()))\n96|\t\tif err != nil {\n97|\t\t\tt.Fatalf(\"EncodeRequest(%d) error = %v\", major, err)\n98|\t\t}\n99|\t\trequest, err := DecodeRequestFrame(frame)\n100|\t\tif err != nil {\n101|\t\t\tt.Fatalf(\"DecodeRequestFrame(EncodeRequest(%d)) error = %v\", major, err)\n102|\t\t}\n103|\t\tif request.Major != major || request.Operation != OpProbe || request.RequestID != fixtureRequestID {\n104|\t\t\tt.Fatalf(\"round trip(%d) = %+v\", major, request)\n105|\t\t}\n106|\t}\n107|}\n108|\n109|// TestEncodeRequestRefusals drives the production builder with\n110|// caller defects: an unsupported major is invalid_config, an\n111|// unknown operation is operation_unknown, and bound defects refuse\n112|// before any byte is emitted.\n113|func TestEncodeRequestRefusals(t *testing.T) {\n114|\tt.Parallel()\n115|\tif _, err := EncodeRequest(3, OpManifest, fixtureRequestID, 1, []byte(`{}`)); requireCode(t, err, \"invalid_config\") == nil {\n116|\t\tt.Fatal(\"EncodeRequest(3) must refuse\")\n117|\t}\n118|\tif _, err := EncodeRequest(MajorV2, \"query\", fixtureRequestID, 1, []byte(`{}`)); requireCode(t, err, \"operation_unknown\") == nil {\n119|\t\tt.Fatal(\"EncodeRequest(query) must refuse\")\n120|\t}\n121|\tif _, err := EncodeRequest(MajorV2, OpManifest, \"bad\", 1, []byte(`{}`)); requireCode(t, err, \"invalid_config\") == nil {\n122|\t\tt.Fatal(\"EncodeRequest(bad id) must refuse\")\n123|\t}\n124|\tif _, err := EncodeRequest(MajorV2, OpManifest, fixtureRequestID, 0, []byte(`{}`)); requireCode(t, err, \"invalid_config\") == nil {\n125|\t\tt.Fatal(\"EncodeRequest(zero deadline) must refuse\")\n126|\t}\n127|\tif _, err := EncodeRequest(MajorV2, OpManifest, fixtureRequestID, 1, []byte(`[]`)); requireCode(t, err, \"adapter_protocol_violation\") == nil {\n128|\t\tt.Fatal(\"EncodeRequest(non-object body) must refuse\")\n129|\t}\n130|}\n131|\n132|// TestDecodeRequestFrameStrictFaults drives the production\n133|// request entry through the strict-decoder faults: invalid\n134|// UTF-8, a lone surrogate escape, trailing data, and a lone\n135|// top-level value are faults, never partial objects.\n136|func TestDecodeRequestFrameStrictFaults(t *testing.T) {\n137|\tt.Parallel()\n138|\tgood := string(fixtureRequestFrame(\"2.0.0\", \"manifest\", fixtureRequestID, 1, `{}`))\n139|\tfor _, probe := range []struct {\n140|\t\tname  string\n141|\t\tframe []byte\n142|\t}{\n143|\t\t{\"invalid utf8\", []byte{0xff, 0xfe}},\n144|\t\t{\"lone surrogate\", []byte(replaceOnce(t, good, `\"manifest\"`, `mani\\ud800fest`, 1))},\n145|\t\t{\"trailing data\", []byte(good + \" {}\")},\n146|\t\t{\"empty after trim\", []byte(\"   \")},\n147|\t} {\n148|\t\tt.Run(probe.name, func(t *testing.T) {\n149|\t\t\tt.Parallel()\n150|\t\t\tif _, err := DecodeRequestFrame(probe.frame); requireCode(t, err, \"adapter_protocol_violation\") == nil {\n151|\t\t\t\tt.Fatal(\"must refuse\")\n152|\t\t\t}\n153|\t\t})\n154|\t}\n155|}\n156|\n157|// TestCheckSuccessEnvelopeAcceptsExactEcho drives the production\n158|// success entry with an exact contract vector.\n159|func TestCheckSuccessEnvelopeAcceptsExactEcho(t *testing.T) {\n160|\tt.Parallel()\n161|\trequest, err := DecodeRequestFrame(fixtureRequestFrame(\"2.0.0\", \"manifest\", fixtureRequestID, 1, `{}`))\n162|\tif err != nil {\n163|\t\tt.Fatalf(\"DecodeRequestFrame error = %v\", err)\n164|\t}\n165|\tbody, err := CheckSuccessEnvelope(fixtureSuccessFrame(\"2.0.0\", \"manifest\", fixtureRequestID, fixtureManifestJSON()), request)\n166|\tif err != nil {\n167|\t\tt.Fatalf(\"CheckSuccessEnvelope error = %v\", err)\n168|\t}\n169|\tif _, err := DecodeManifest(body); err != nil {\n170|\t\tt.Fatalf(\"DecodeManifest(success body) error = %v\", err)\n171|\t}\n172|}\n173|\n174|// TestCheckSuccessEnvelopeRefusals drives the production success\n175|// entry with one negative vector per branch rule.\n176|func TestCheckSuccessEnvelopeRefusals(t *testing.T) {\n177|\tt.Parallel()\n178|\trequest, err := DecodeRequestFrame(fixtureRequestFrame(\"2.0.0\", \"manifest\", fixtureRequestID, 1, `{}`))\n179|\tif err != nil {\n180|\t\tt.Fatalf(\"DecodeRequestFrame error = %v\", err)\n181|\t}\n182|\tmanifest := fixtureManifestJSON()\n183|\tfor _, probe := range []struct {\n184|\t\tname  string\n185|\t\tframe []byte\n186|\t}{\n187|\t\t{\"wrong protocol version echo\", fixtureSuccessFrame(\"1.0.0\", \"manifest\", fixtureRequestID, manifest)},\n188|\t\t{\"wrong request echo\", fixtureSuccessFrame(\"2.0.0\", \"manifest\", fixtureRequestID[:len(fixtureRequestID)-1]+\"0\", manifest)},\n189|\t\t{\"wrong operation echo\", fixtureSuccessFrame(\"2.0.0\", \"probe\", fixtureRequestID, manifest)},\n190|\t\t{\"relabeled response schema\", []byte(replaceOnce(t, string(fixtureSuccessFrame(\"2.0.0\", \"manifest\", fixtureRequestID, manifest)), `\"schema_version\":\"1.0.0\"`, `\"schema_version\":\"2.0.0\"`, 1))},\n191|\t\t{\"ok false\", []byte(replaceOnce(t, string(fixtureSuccessFrame(\"2.0.0\", \"manifest\", fixtureRequestID, manifest)), `\"ok\":true`, `\"ok\":false`, 1))},\n192|\t\t{\"both branches\", []byte(replaceOnce(t, string(fixtureSuccessFrame(\"2.0.0\", \"manifest\", fixtureRequestID, manifest)), `\"ok\":true,`, `\"ok\":true,\"error\":`+fixtureErrorObject(\"incompatible_protocol\", 6, false)+`,`, 1))},\n193|\t\t{\"neither branch\", []byte(replaceOnce(t, string(fixtureSuccessFrame(\"2.0.0\", \"manifest\", fixtureRequestID, manifest)), `,\"body\":`, `,\"nobody\":`, 1))},\n194|\t\t{\"non object body\", fixtureSuccessFrame(\"2.0.0\", \"manifest\", fixtureRequestID, `[]`)},\n195|\t\t{\"unknown member\", []byte(replaceOnce(t, string(fixtureSuccessFrame(\"2.0.0\", \"manifest\", fixtureRequestID, manifest)), `\"ok\":true`, `\"ok\":true,\"extra\":1`, 1))},\n196|\t\t{\"missing member\", []byte(replaceOnce(t, string(fixtureSuccessFrame(\"2.0.0\", \"manifest\", fixtureRequestID, manifest)), `,\"ok\":true`, ``, 1))},\n197|\t\t{\"wrong schema\", []byte(replaceOnce(t, string(fixtureSuccessFrame(\"2.0.0\", \"manifest\", fixtureRequestID, manifest)), \"session-directory-node-response\", \"session-directory-node-request\", 1))},\n198|\t\t{\"wrong protocol\", []byte(replaceOnce(t, string(fixtureSuccessFrame(\"2.0.0\", \"manifest\", fixtureRequestID, manifest)), `\"protocol\":\"urn:ax:protocol:session-directory-node\"`, `\"protocol\":\"urn:ax:protocol:provider\"`, 1))},\n199|\t} {\n200|\t\tt.Run(probe.name, func(t *testing.T) {\n201|\t\t\tt.Parallel()\n202|\t\t\tif _, err := CheckSuccessEnvelope(probe.frame, request); requireCode(t, err, \"adapter_protocol_violation\") == nil {\n203|\t\t\t\tt.Fatal(\"must refuse\")\n204|\t\t\t}\n205|\t\t})\n206|\t}\n207|}\n208|\n209|// TestCheckFailureEnvelopeAcceptsExactEcho drives the production\n210|// failure entry and requires the decoded Structured Error to\n211|// carry the exact code, exit, and retryable bit.\n212|func TestCheckFailureEnvelopeAcceptsExactEcho(t *testing.T) {\n213|\tt.Parallel()\n214|\trequest, err := DecodeRequestFrame(fixtureRequestFrame(\"2.0.0\", \"manifest\", fixtureRequestID, 1, `{}`))\n215|\tif err != nil {\n216|\t\tt.Fatalf(\"DecodeRequestFrame error = %v\", err)\n217|\t}\n218|\tdecoded, err := CheckFailureEnvelope(fixtureDowngradeFrame(\"2.0.0\", fixtureRequestID), request)\n219|\tif err != nil {\n220|\t\tt.Fatalf(\"CheckFailureEnvelope error = %v\", err)\n221|\t}\n222|\tif decoded.Code() != \"incompatible_protocol\" || decoded.ExitCode() != 6 || decoded.Retryable() {\n223|\t\tt.Fatalf(\"decoded downgrade = %q exit %d retryable %v\", decoded.Code(), decoded.ExitCode(), decoded.Retryable())\n224|\t}\n225|}\n226|\n227|// TestCheckFailureEnvelopeRefusals drives the production failure\n228|// entry with one negative vector per branch rule: a failure that\n229|// cannot be read as Structured Error 1.2.0 is an integrity\n230|// failure, never a retryable result.\n231|func TestCheckFailureEnvelopeRefusals(t *testing.T) {\n232|\tt.Parallel()\n233|\trequest, err := DecodeRequestFrame(fixtureRequestFrame(\"2.0.0\", \"manifest\", fixtureRequestID, 1, `{}`))\n234|\tif err != nil {\n235|\t\tt.Fatalf(\"DecodeRequestFrame error = %v\", err)\n236|\t}\n237|\tdowngrade := string(fixtureDowngradeFrame(\"2.0.0\", fixtureRequestID))\n238|\tfor _, probe := range []struct {\n239|\t\tname  string\n240|\t\tframe []byte\n241|\t\tcode  axerror.Code\n242|\t}{\n243|\t\t{\"ok true\", []byte(replaceOnce(t, downgrade, `\"ok\":false`, `\"ok\":true`, 1)), \"adapter_protocol_violation\"},\n244|\t\t{\"both branches\", []byte(replaceOnce(t, downgrade, `\"ok\":false,`, `\"ok\":false,\"body\":{},`, 1)), \"adapter_protocol_violation\"},\n245|\t\t{\"neither branch\", []byte(replaceOnce(t, downgrade, `,\"error\":`, `,\"nerror\":`, 1)), \"adapter_protocol_violation\"},\n246|\t\t{\"wrong version echo\", fixtureFailureFrame(\"1.0.0\", \"manifest\", fixtureRequestID, fixtureErrorObject(\"incompatible_protocol\", 6, false)), \"adapter_protocol_violation\"},\n247|\t\t{\"unreadable error\", fixtureFailureFrame(\"2.0.0\", \"manifest\", fixtureRequestID, `{\"schema\":\"urn:ax:schema:error\"}`), \"integrity_failure\"},\n248|\t\t{\"wrong error version\", fixtureFailureFrame(\"2.0.0\", \"manifest\", fixtureRequestID, replaceOnce(t, fixtureErrorObject(\"incompatible_protocol\", 6, false), `\"schema_version\":\"1.2.0\"`, `\"schema_version\":\"1.1.0\"`, 1)), \"integrity_failure\"},\n249|\t\t{\"unknown member\", []byte(replaceOnce(t, downgrade, `\"ok\":false`, `\"ok\":false,\"extra\":1`, 1)), \"adapter_protocol_violation\"},\n250|\t\t{\"missing member\", []byte(replaceOnce(t, downgrade, `,\"ok\":false`, ``, 1)), \"adapter_protocol_violation\"},\n251|\t\t{\"wrong operation echo\", fixtureFailureFrame(\"2.0.0\", \"probe\", fixtureRequestID, fixtureErrorObject(\"incompatible_protocol\", 6, false)), \"adapter_protocol_violation\"},\n252|\t\t{\"wrong schema\", []byte(replaceOnce(t, downgrade, \"session-directory-node-response\", \"session-directory-node-request\", 1)), \"adapter_protocol_violation\"},\n253|\t\t{\"relabeled schema version\", []byte(replaceOnce(t, downgrade, `\"schema_version\":\"1.0.0\"`, `\"schema_version\":\"2.0.0\"`, 1)), \"adapter_protocol_violation\"},\n254|\t\t{\"wrong protocol\", []byte(replaceOnce(t, downgrade, `\"protocol\":\"urn:ax:protocol:session-directory-node\"`, `\"protocol\":\"urn:ax:protocol:provider\"`, 1)), \"adapter_protocol_violation\"},\n255|\t\t{\"wrong request echo\", fixtureFailureFrame(\"2.0.0\", \"manifest\", fixtureRequestID[:len(fixtureRequestID)-1]+\"0\", fixtureErrorObject(\"incompatible_protocol\", 6, false)), \"adapter_protocol_violation\"},\n256|\t} {\n257|\t\tt.Run(probe.name, func(t *testing.T) {\n258|\t\t\tt.Parallel()\n259|\t\t\tif _, err := CheckFailureEnvelope(probe.frame, request); requireCode(t, err, probe.code) == nil {\n260|\t\t\t\tt.Fatal(\"must refuse\")\n261|\t\t\t}\n262|\t\t})\n263|\t}\n264|}\n265|\n266|// TestResponseIdentitySharedArms drives the two production\n267|// response entries through the shared identity arms both\n268|// branches carry: an empty frame, an oversize frame, and a\n269|// truncated frame refuse identically on the success and failure\n270|// paths, proving the context-prefixed arms fire in both.\n271|func TestResponseIdentitySharedArms(t *testing.T) {\n272|\tt.Parallel()\n273|\trequest, err := DecodeRequestFrame(fixtureRequestFrame(\"2.0.0\", \"manifest\", fixtureRequestID, 1, `{}`))\n274|\tif err != nil {\n275|\t\tt.Fatalf(\"DecodeRequestFrame error = %v\", err)\n276|\t}\n277|\toversize := append(fixtureSuccessFrame(\"2.0.0\", \"manifest\", fixtureRequestID, `{}`), make([]byte, frameBoundBytes)...)\n278|\tfor _, probe := range []struct {\n279|\t\tname  string\n280|\t\tframe []byte\n281|\t}{\n282|\t\t{\"empty frame\", []byte{}},\n283|\t\t{\"oversize frame\", oversize},\n284|\t\t{\"truncated frame\", []byte(`{\"schema\":`)},\n285|\t} {\n286|\t\tt.Run(probe.name, func(t *testing.T) {\n287|\t\t\tt.Parallel()\n288|\t\t\tif _, err := CheckSuccessEnvelope(probe.frame, request); requireCode(t, err, \"adapter_protocol_violation\") == nil {\n289|\t\t\t\tt.Fatal(\"success must refuse\")\n290|\t\t\t}\n291|\t\t\tif _, err := CheckFailureEnvelope(probe.frame, request); requireCode(t, err, \"adapter_protocol_violation\") == nil {\n292|\t\t\t\tt.Fatal(\"failure must refuse\")\n293|\t\t\t}\n294|\t\t})\n295|\t}\n296|}\n297|\n298|// TestRefuseUnknownOperation drives the production dispatch entry:\n299|// a name outside the closed registry refuses with\n300|// operation_unknown naming the operation.\n301|func TestRefuseUnknownOperation(t *testing.T) {\n302|\tt.Parallel()\n303|\terr := RefuseUnknownOperation(\"query\")\n304|\tfailure := requireCode(t, err, \"operation_unknown\")\n305|\tif operation, _ := failure.Detail(\"operation\"); operation != \"query\" {\n306|\t\tt.Fatalf(\"refusal detail operation = %v, want query\", operation)\n307|\t}\n308|\tif err := RefuseUnknownOperation(\"\"); err == nil {\n309|\t\tt.Fatal(\"RefuseUnknownOperation(empty) must refuse\")\n310|\t}\n311|}"}}}
