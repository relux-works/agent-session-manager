{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc77","stream":{"kind":"session","id":"01a075af-a7c5-7382-ae46-5efb02855e33"},"sequence":1174,"recorded_at":1780531400002343,"record_type":"event","durability":"durable","causation_id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589","run_stream":{"kind":"run","id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589"},"task_stream":{"kind":"task","id":"190e9c91-fdf6-499e-95a6-2ac414507495"},"task_id":"190e9c91-fdf6-499e-95a6-2ac414507495","event":{"kind":"output","task_id":"190e9c91-fdf6-499e-95a6-2ac414507495","chunk":"Read text file `internal/dirnode/scan_test.go`.\n(135 line(s) above)\n136|func TestJournalReplaysIdenticalBody(t *testing.T) {\n137|\tt.Parallel()\n138|\tjournal := NewJournal()\n139|\tbody := journalBody(fixtureOperationID)\n140|\tresult := []byte(`{\"batch\":\"first\"}`)\n141|\tstored, prior, err := journal.CheckAndRecord(OpScan, fixtureOperationID, body, result)\n142|\tif err != nil || !stored || prior != nil {\n143|\t\tt.Fatalf(\"CheckAndRecord(first) = %v %q %v\", stored, prior, err)\n144|\t}\n145|\tstored, prior, err = journal.CheckAndRecord(OpScan, fixtureOperationID, body, []byte(`{\"batch\":\"second\"}`))\n146|\tif err != nil || stored || string(prior) != string(result) {\n147|\t\tt.Fatalf(\"CheckAndRecord(repeat) = %v %q %v, want replay of first\", stored, prior, err)\n148|\t}\n149|}\n150|\n151|// TestJournalRefusesChangedBody drives the production idempotency\n152|// entry with a changed body under a recorded key: the retry is an\n153|// idempotency_mismatch and records nothing — the prior result\n154|// still replays afterwards.\n155|func TestJournalRefusesChangedBody(t *testing.T) {\n156|\tt.Parallel()\n157|\tjournal := NewJournal()\n158|\tbody := journalBody(fixtureOperationID)\n159|\tresult := []byte(`{\"batch\":\"first\"}`)\n160|\tif _, _, err := journal.CheckAndRecord(OpScan, fixtureOperationID, body, result); err != nil {\n161|\t\tt.Fatalf(\"CheckAndRecord(first) error = %v\", err)\n162|\t}\n163|\tchanged := journalBody(fixtureOperationID)\n164|\tchanged = []byte(replaceOnce(t, string(changed), `\"max_instances\":100`, `\"max_instances\":101`, 1))\n165|\tif _, _, err := journal.CheckAndRecord(OpScan, fixtureOperationID, changed, []byte(`{\"batch\":\"evil\"}`)); requireCode(t, err, \"idempotency_mismatch\") == nil {\n166|\t\tt.Fatal(\"changed body must refuse\")\n167|\t}\n168|\t_, prior, err := journal.CheckAndRecord(OpScan, fixtureOperationID, body, nil)\n169|\tif err != nil || string(prior) != string(result) {\n170|\t\tt.Fatalf(\"prior result after mismatch = %q %v\", prior, err)\n171|\t}\n172|}\n173|\n174|// TestJournalScopesKeysByOperation drives the production\n175|// idempotency entry across operations: one operation's\n176|// operation_id never authorizes another operation's retry, and\n177|// non-registry operations and non-UUID identifiers refuse before\n178|// any record is touched.\n179|func TestJournalScopesKeysByOperation(t *testing.T) {\n180|\tt.Parallel()\n181|\tjournal := NewJournal()\n182|\tbody := journalBody(fixtureOperationID)\n183|\tif _, _, err := journal.CheckAndRecord(OpScan, fixtureOperationID, body, []byte(`{}`)); err != nil {\n184|\t\tt.Fatalf(\"CheckAndRecord(scan) error = %v\", err)\n185|\t}\n186|\tstored, _, err := journal.CheckAndRecord(OpEnrichmentRun, fixtureOperationID, body, []byte(`{}`))\n187|\tif err != nil || !stored {\n188|\t\tt.Fatalf(\"CheckAndRecord(enrichment-run) = %v %v, want fresh store\", stored, err)\n189|\t}\n190|\tif _, _, err := journal.CheckAndRecord(\"query\", fixtureOperationID, body, []byte(`{}`)); requireCode(t, err, \"operation_unknown\") == nil {\n191|\t\tt.Fatal(\"unknown operation must refuse\")\n192|\t}\n193|\tif _, _, err := journal.CheckAndRecord(OpScan, \"bad\", body, []byte(`{}`)); requireCode(t, err, \"invalid_config\") == nil {\n194|\t\tt.Fatal(\"bad identifier must refuse\")\n195|\t}\n196|\tif _, _, err := journal.CheckAndRecord(OpScan, fixtureOperationID, []byte(`{`), []byte(`{}`)); requireCode(t, err, \"adapter_protocol_violation\") == nil {\n197|\t\tt.Fatal(\"non-canonical body must refuse\")\n198|\t}\n199|}\n200|\n201|// TestJournalSurvivesRestart drives the production journal export\n202|// and import entries for crash recovery: a restarted host\n203|// recovers the same record, replays the identical body, still\n204|// refuses a changed body, and refuses corrupt bytes as an\n205|// integrity failure rather than an empty journal.\n206|func TestJournalSurvivesRestart(t *testing.T) {\n207|\tt.Parallel()\n208|\tjournal := NewJournal()\n209|\tbody := journalBody(fixtureOperationID)\n210|\tresult := []byte(`{\"batch\":\"durable\"}`)\n211|\tif _, _, err := journal.CheckAndRecord(OpScan, fixtureOperationID, body, result); err != nil {\n212|\t\tt.Fatalf(\"CheckAndRecord error = %v\", err)\n213|\t}\n214|\texported, err := journal.Export()\n215|\tif err != nil {\n216|\t\tt.Fatalf(\"Export error = %v\", err)\n217|\t}\n218|\trestarted := NewJournal()\n219|\tif err := restarted.Import(exported); err != nil {\n220|\t\tt.Fatalf(\"Import error = %v\", err)\n221|\t}\n222|\tstored, replayed, err := restarted.CheckAndRecord(OpScan, fixtureOperationID, body, nil)\n223|\tif err != nil || stored || string(replayed) != string(result) {\n224|\t\tt.Fatalf(\"replay after restart = %v %q %v\", stored, replayed, err)\n225|\t}\n226|\tchanged := []byte(replaceOnce(t, string(body), `\"max_instances\":100`, `\"max_instances\":101`, 1))\n227|\tif _, _, err := restarted.CheckAndRecord(OpScan, fixtureOperationID, changed, nil); requireCode(t, err, \"idempotency_mismatch\") == nil {\n228|\t\tt.Fatal(\"changed body after restart must refuse\")\n229|\t}\n230|\tempty := NewJournal()\n231|\trequireCode(t, empty.Import([]byte(`{\"schema\":\"urn:ax:internal:dirnode-journal\",\"version\":2,\"records\":[]}`)), \"integrity_failure\")\n232|\trequireCode(t, empty.Import([]byte(`{\"schema\":\"urn:ax:other\",\"version\":1,\"records\":[]}`)), \"integrity_failure\")\n233|\trequireCode(t, empty.Import([]byte(`{\"schema\":\"urn:ax:internal:dirnode-journal\",\"version\":1}`)), \"integrity_failure\")\n234|\trequireCode(t, empty.Import([]byte(`{\"schema\":\"urn:ax:internal:dirnode-journal\",\"version\":1,\"records\":{}}`)), \"integrity_failure\")\n235|\trequireCode(t, empty.Import([]byte(`{\"schema\":\"urn:ax:internal:dirnode-journal\",\"version\":1,\"records\":[{\"key\":1,\"body_digest\":\"eA==\",\"result\":\"e30=\"}]}`)), \"integrity_failure\")\n236|\trequireCode(t, empty.Import([]byte(`not json`)), \"integrity_failure\")\n237|\trequireCode(t, empty.Import([]byte(`{\"schema\":\"urn:ax:internal:dirnode-journal\",\"version\":1,\"records\":[{\"key\":\"k\",\"body_digest\":\"sha256:zzz\",\"result\":\"e30=\"}]}`)), \"integrity_failure\")\n238|\tif err := empty.Import([]byte(`{\"schema\":\"urn:ax:internal:dirnode-journal\",\"version\":1,\"records\":[]}`)); err != nil {\n239|\t\tt.Fatalf(\"Import(empty valid) error = %v\", err)\n240|\t}\n241|}\n242|\n243|// TestJournalImportRefusesUnsortedRecords drives the production\n244|// import entry with a two-record document in decreasing key\n245|// order: the import refuses rather than silently accepting an\n246|// order the exporter never emits.\n247|func TestJournalImportRefusesUnsortedRecords(t *testing.T) {\n248|\tt.Parallel()\n249|\tlow := `{\"key\":\"scan\\u00000198f4c8-8e50-7f66-8f70-1234567890ac\",\"body_digest\":` + quote(fixtureBatchDigest) + `,\"result\":\"e30=\"}`\n250|\thigh := `{\"key\":\"scan\\u00000198f4c8-8e50-7f66-8f70-1234567890ae\",\"body_digest\":` + quote(fixtureBatchDigest) + `,\"result\":\"e30=\"}`\n251|\tsorted := `{\"schema\":\"urn:ax:internal:dirnode-journal\",\"version\":1,\"records\":[` + low + `,` + high + `]}`\n252|\treversed := `{\"schema\":\"urn:ax:internal:dirnode-journal\",\"version\":1,\"records\":[` + high + `,` + low + `]}`\n253|\tjournal := NewJournal()\n254|\tif err := journal.Import([]byte(sorted)); err != nil {\n255|\t\tt.Fatalf(\"Import(sorted) error = %v\", err)\n256|\t}\n257|\trequireCode(t, NewJournal().Import([]byte(reversed)), \"integrity_failure\")\n258|}\n259|\n260|// TestJournalExportIsDeterministic drives the production export\n261|// entry twice and requires identical bytes: recovery evidence\n262|// must not depend on map iteration order.\n263|func TestJournalExportIsDeterministic(t *testing.T) {\n264|\tt.Parallel()\n265|\tjournal := NewJournal()\n266|\tfor _, id := range []string{fixtureOperationID, fixtureQueryID} {\n267|\t\tif _, _, err := journal.CheckAndRecord(OpScan, id, journalBody(id), []byte(`{}`)); err != nil {\n268|\t\t\tt.Fatalf(\"CheckAndRecord(%s) error = %v\", id, err)\n269|\t\t}\n270|\t}\n271|\tfirst, err := journal.Export()\n272|\tif err != nil {\n273|\t\tt.Fatalf(\"Export error = %v\", err)\n274|\t}\n275|\tfor range 20 {\n276|\t\tagain, err := journal.Export()\n277|\t\tif err != nil {\n278|\t\t\tt.Fatalf(\"Export error = %v\", err)\n279|\t\t}\n280|\t\tif string(again) != string(first) {\n281|\t\t\tt.Fatal(\"export bytes differ across calls: map iteration leaks into recovery evidence\")\n282|\t\t}\n283|\t}\n284|}"}}}
