utCommonMajor(t *testing.T) {\n76|\tt.Parallel()\n77|\tv2 := bootstrapRequest(t, \"2.0.0\")\n78|\tfirst := DecideBootstrapStep(v2, fixtureDowngradeFrame(\"2.0.0\", fixtureRequestID), 6)\n79|\tif !first.Downgrade {\n80|\t\tt.Fatalf(\"first step = %+v, want Downgrade\", first)\n81|\t}\n82|\tv1 := bootstrapRequest(t, \"1.0.0\")\n83|\tlast := DecideBootstrapStep(v1, fixtureDowngradeFrame(\"1.0.0\", fixtureRequestID), 6)\n84|\tif last.Done || last.Downgrade || last.Terminal == nil {\n85|\t\tt.Fatalf(\"last step = %+v, want terminal\", last)\n86|\t}\n87|\tfailure := requireCode(t, last.Terminal, \"incompatible_protocol\")\n88|\tif failure.ExitCode() != 6 {\n89|\t\tt.Fatalf(\"terminal exit = %d, want 6\", failure.ExitCode())\n90|\t}\n91|}\n92|\n93|// TestBootstrapRefusesNonExactDowngradeTuple drives the production\n94|// bootstrap entry with one near-tuple per downgrade field: a\n95|// tuple that names another code, another exit class field, claims\n96|// retry permission, carries the wrong exit status, or mislabels\n97|// the envelope is an ordinary terminal failure, never negotiation\n98|// evidence and never a lower-major attempt.\n99|func TestBootstrapRefusesNonExactDowngradeTuple(t *testing.T) {\n100|\tt.Parallel()\n101|\trequest := bootstrapRequest(t, \"2.0.0\")\n102|\tgood := string(fixtureDowngradeFrame(\"2.0.0\", fixtureRequestID))\n103|\tfor _, probe := range []struct {\n104|\t\tname  string\n105|\t\tframe []byte\n106|\t\texit  int\n107|\t}{\n108|\t\t{\"other code\", []byte(replaceOnce(t, good, `\"code\":\"incompatible_protocol\"`, `\"code\":\"capability_unavailable\"`, 1)), 6},\n109|\t\t{\"retryable claim\", []byte(replaceOnce(t, good, `\"retryable\":false`, `\"retryable\":true`, 1)), 6},\n110|\t\t{\"wrong process exit\", []byte(good), 0},\n111|\t\t{\"wrong envelope version\", fixtureDowngradeFrame(\"1.0.0\", fixtureRequestID), 6},\n112|\t\t{\"wrong request echo\", fixtureDowngradeFrame(\"2.0.0\", fixtureRequestID[:len(fixtureRequestID)-1]+\"0\"), 6},\n113|\t\t{\"relabeled schema version\", []byte(replaceOnce(t, good, `\"schema_version\":\"1.0.0\"`, `\"schema_version\":\"2.0.0\"`, 1)), 6},\n114|\t\t{\"ordinary operation failure\", fixtureFailureFrame(\"2.0.0\", \"manifest\", fixtureRequestID, fixtureErrorObject(\"capability_unavailable\", 6, false)), 6},\n115|\t} {\n116|\t\tt.Run(probe.name, func(t *testing.T) {\n117|\t\t\tt.Parallel()\n118|\t\t\tdecision := DecideBootstrapStep(request, probe.frame, probe.exit)\n119|\t\t\tif decision.Done || decision.Downgrade {\n120|\t\t\t\tt.Fatalf(\"DecideBootstrapStep(%s) = %+v, want terminal\", probe.name, decision)\n121|\t\t\t}\n122|\t\t\tif decision.Terminal == nil {\n123|\t\t\t\tt.Fatalf(\"DecideBootstrapStep(%s) has nil terminal\", probe.name)\n124|\t\t\t}\n125|\t\t})\n126|\t}\n127|}\n128|\n129|// TestBootstrapTerminalFailuresNeverDowngrade drives the production\n130|// bootstrap entry with terminal attempt outcomes: no response, an\n131|// unreadable frame, a success whose manifest omits the attempted\n132|// version, and a success with a nonmatching exit status. None\n133|// authorizes a lower-major attempt.\n134|func TestBootstrapTerminalFailuresNeverDowngrade(t *testing.T) {\n135|\tt.Parallel()\n136|\trequest := bootstrapRequest(t, \"2.0.0\")\n137|\tv1only := replaceOnce(t, fixtureManifestJSON(), `\"supported_protocol_versions\":[\"1.0.0\",\"2.0.0\"]`, `\"supported_protocol_versions\":[\"1.0.0\"]`, 1)\n138|\tfor _, probe := range []struct {\n139|\t\tname  string\n140|\t\tframe []byte\n141|\t\texit  int\n142|\t}{\n143|\t\t{\"no response frame\", nil, 6},\n144|\t\t{\"unreadable frame\", []byte(`{\"schema\":`), 6},\n145|\t\t{\"manifest omits attempted version\", fixtureSuccessFrame(\"2.0.0\", \"manifest\", fixtureRequestID, v1only), 0},\n146|\t\t{\"success with failing exit\", fixtureSuccessFrame(\"2.0.0\", \"manifest\", fixtureRequestID, fixtureManifestJSON()), 1},\n147|\t\t{\"malformed manifest body\", fixtureSuccessFrame(\"2.0.0\", \"manifest\", fixtureRequestID, `{\"schema\":\"urn:ax:schema:session-directory-node-manifest\"}`), 0},\n148|\t} {\n149|\t\tt.Run(probe.name, func(t *testing.T) {\n150|\t\t\tt.Parallel()\n151|\t\t\tdecision := DecideBootstrapStep(request, probe.frame, probe.exit)\n152|\t\t\tif decision.Done || decision.Downgrade {\n153|\t\t\t\tt.Fatalf(\"DecideBootstrapStep(%s) = %+v, want terminal\", probe.name, decision)\n154|\t\t\t}\n155|\t\t\tif decision.Terminal == nil {\n156|\t\t\t\tt.Fatalf(\"DecideBootstrapStep(%s) has nil terminal\", probe.name)\n157|\t\t\t}\n158|\t\t})\n159|\t}\n160|}\n161|\n162|// TestBootstrapRefusesNonManifestAttempt drives the production\n163|// bootstrap entry with a non-manifest request: bootstrap decides\n164|// manifest attempts only.\n165|func TestBootstrapRefusesNonManifestAttempt(t *testing.T) {\n166|\tt.Parallel()\n167|\trequest, err := DecodeRequestFrame(fixtureRequestFrame(\"2.0.0\", \"probe\", fixtureRequestID, 1, fixtureProbeRequestV2()))\n168|\tif err != nil {\n169|\t\tt.Fatalf(\"DecodeRequestFrame error = %v\", err)\n170|\t}\n171|\tdecision := DecideBootstrapStep(request, fixtureSuccessFrame(\"2.0.0\", \"probe\", fixtureRequestID, fixtureProbeResponseJSON()), 0)\n172|\tif decision.Done || decision.Downgrade {\n173|\t\tt.Fatalf(\"DecideBootstrapStep(probe) = %+v, want terminal\", decision)\n174|\t}\n175|\trequireCode(t, decision.Terminal, \"invalid_config\")\n176|}\n177|\n178|// TestProcessGuardRefusesReuse drives the production process\n179|// guard: a fresh token claims cleanly, a reused token refuses, and\n180|// an empty token refuses before any set is touched.\n181|func TestProcessGuardRefusesReuse(t *testing.T) {\n182|\tt.Parallel()\n183|\tguard := NewProcessGuard()\n184|\tif err := guard.Claim(\"process-a\"); err != nil {\n185|\t\tt.Fatalf(\"Claim(fresh) error = %v\", err)\n186|\t}\n187|\tif err := guard.Claim(\"process-b\"); err != nil {\n188|\t\tt.Fatalf(\"Claim(second fresh) error = %v\", err)\n189|\t}\n190|\trequireCode(t, guard.Claim(\"process-a\"), \"invalid_config\")\n191|\trequireCode(t, guard.Claim(\"\"), \"invalid_config\")\n192|}\n193|\n194|// TestNextLowerMajorBounds drives the production major registry:\n195|// majors descend 2 to 1, nothing lies below 1, and unknown majors\n196|// have no lower attempt.\n197|func TestNextLowerMajorBounds(t *testing.T) {\n198|\tt.Parallel()\n199|\tif next, ok := NextLowerMajor(MajorV2); !ok || next != MajorV1 {\n200|\t\tt.Fatalf(\"NextLowerMajor(2) = %d,%v, want 1,true\", next, ok)\n201|\t}\n202|\tif _, ok := NextLowerMajor(MajorV1); ok {\n203|\t\tt.Fatal(\"NextLowerMajor(1) must report no lower major\")\n204|\t}\n205|\tif _, ok := NextLowerMajor(3); ok {\n206|\t\tt.Fatal(\"NextLowerMajor(3) must report no lower major\")\n207|\t}\n208|\tif majors := SupportedMajors(); len(majors) != 2 || majors[0] != 2 || majors[1] != 1 {\n209|\t\tt.Fatalf(\"SupportedMajors() = %v, want [2 1]\", majors)\n210|\t}\n211|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
