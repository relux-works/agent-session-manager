 line and \"internal/dirnode\" in line for line in out)\n+    return p.returncode, sorted(set(fails)), build_failed\n+\n+\n+def main():\n+    mode = sys.argv[1]\n+    if mode == \"obligations\":\n+        sites = [(p, n, None) for (p, n, _) in return_false_sites()]\n+        kind = \"FALSE2TRUE\"\n+    elif mode == \"arms\":\n+        sites = [(p, n, None) for (p, n) in arm_if_sites()]\n+        kind = \"IFFALSE\"\n+    else:\n+        print(\"unknown mode\", mode)\n+        sys.exit(2)\n","edit_facts":{"tool_name":"edit_file","path":"/tmp/ljkj8r/battery.py","added":39,"removed":21},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
