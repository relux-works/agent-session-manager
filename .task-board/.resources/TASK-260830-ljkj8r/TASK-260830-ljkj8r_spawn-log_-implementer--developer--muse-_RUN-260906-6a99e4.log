{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d4c5","stream":{"kind":"session","id":"01a075af-a7c5-7382-ae46-5efb02855e33"},"sequence":2237,"recorded_at":1780531400004469,"record_type":"event","durability":"durable","causation_id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589","run_stream":{"kind":"run","id":"f1bef9f3-46dc-4d65-b0f2-5e22216e1589"},"task_stream":{"kind":"task","id":"74f53fbe-647e-45d0-9542-cd6642b73382"},"task_id":"74f53fbe-647e-45d0-9542-cd6642b73382","event":{"kind":"output","task_id":"74f53fbe-647e-45d0-9542-cd6642b73382","chunk":"Read text file `internal/dirnode/query.go`.\n(224 line(s) above)\n225|\t\"jobs\",\n226|\t\"plans\",\n227|}\n228|\n229|// isListOperation reports whether the read operation pages a list.\n230|func isListOperation(name string) bool {\n231|\tfor _, allowed := range listOperations {\n232|\t\tif name == allowed {\n233|\t\t\treturn true\n234|\t\t}\n235|\t}\n236|\treturn false\n237|}\n238|\n239|// annotationMutations names the mutations that require an\n240|// expectation digest and idempotency key when confirmed.\n241|var annotationMutations = []string{\n242|\t\"set_title\",\n243|\t\"set_tags\",\n244|\t\"set_pin\",\n245|}\n246|\n247|// isAnnotationMutation reports whether the mutation is an\n248|// annotation mutation.\n249|func isAnnotationMutation(name string) bool {\n250|\tfor _, allowed := range annotationMutations {\n251|\t\tif name == allowed {\n252|\t\t\treturn true\n253|\t\t}\n254|\t}\n255|\treturn false\n256|}\n257|\n258|// queryParameterMembers maps each operation to its exact\n259|// parameters member set in Section 10.8.5 table order. The schema\n260|// and directory_summary bodies carry extensions only: there is no\n261|// untyped parameter bag.\n262|var queryParameterMembers = map[string][]string{\n263|\t\"schema\":            {\"extensions\"},\n264|\t\"directory_summary\": {\"extensions\"},\n265|\t\"sessions\":          {\"filters\", \"extensions\"},\n266|\t\"count\":             {\"filters\", \"extensions\"},\n267|\t\"session\":           {\"subject_kind\", \"subject_id\", \"extensions\"},\n268|\t\"lineage\":           {\"anchor_id\", \"include_suggestions\", \"extensions\"},\n269|\t\"hosts\":             {\"host_ids\", \"reachable\", \"extensions\"},\n270|\t\"environments\":      {\"host_ids\", \"environment_ids\", \"authentication_status\", \"extensions\"},\n271|\t\"jobs\":              {\"job_ids\", \"profile_ids\", \"states\", \"extensions\"},\n272|\t\"plans\":             {\"plan_ids\", \"operation_ids\", \"include_expired\", \"extensions\"},\n273|\t\"distinct\":          {\"field\", \"filters\", \"extensions\"},\n274|\t\"set_title\":         {\"subject_kind\", \"subject_id\", \"title\", \"supersedes_annotation_ids\", \"extensions\"},\n275|\t\"set_tags\":          {\"subject_kind\", \"subject_id\", \"tags\", \"supersedes_annotation_ids\", \"extensions\"},\n276|\t\"set_pin\":           {\"subject_kind\", \"subject_id\", \"value\", \"supersedes_annotation_ids\", \"extensions\"},\n277|\t\"enrich\":            {\"subject_kind\", \"subject_id\", \"profile_id\", \"kinds\", \"expected_head_digest\", \"extensions\"},\n278|\t\"plan_continue\":     {\"subject_kind\", \"subject_id\", \"source_instance_id\", \"to_host_id\", \"to_installation_id\", \"intent\", \"workspace_policy\", \"source_after_success\", \"extensions\"},\n279|\t\"execute_plan\":      {\"plan_id\", \"operation_id\", \"confirmations\", \"extensions\"},\n280|}\n281|\n282|// queryFields is the closed directory-field registry: the\n283|// twenty-four projection fields plus the three explicitly lazy\n284|// ones. Fields and presets apply only to the projecting reads;\n285|// other operations require both null.\n286|var queryFields = []string{\n287|\t\"id\",\n288|\t\"kind\",\n289|\t\"lineage_anchor\",\n290|\t\"management_state\",\n291|\t\"display_title\",\n292|\t\"title_source\",\n293|\t\"provider\",\n294|\t\"host\",\n295|\t\"workspace\",\n296|\t\"state\",\n297|\t\"owner\",\n298|\t\"local_role\",\n299|\t\"updated_at\",\n300|\t\"summary\",\n301|\t\"recent_activity\",\n302|\t\"last_user_intent\",\n303|\t\"open_loops\",\n304|\t\"annotation_freshness\",\n305|\t\"inventory_freshness\",\n306|\t\"reachability\",\n307|\t\"branch_count\",\n308|\t\"clone_count\",\n309|\t\"warnings\",\n310|\t\"available_intents\",\n311|\t\"lineage_graph\",\n312|\t\"live_runtime\",\n313|\t\"preview\",\n314|}\n315|\n316|// validQueryField reports whether the field is a registry member.\n317|func validQueryField(field string) bool {\n318|\tfor _, allowed := range queryFields {\n319|\t\tif field == allowed {\n320|\t\t\treturn true\n321|\t\t}\n322|\t}\n323|\treturn false\n324|}\n325|\n326|// queryPresets is the closed preset registry.\n327|var queryPresets = []string{\n328|\t\"minimal\",\n329|\t\"overview\",\n330|\t\"activity\",\n331|\t\"routing\",\n332|\t\"full\",\n333|}\n334|\n335|// validQueryPreset reports whether the preset is a registry member.\n336|func validQueryPreset(preset string) bool {\n337|\tfor _, allowed := range queryPresets {\n338|\t\tif preset == allowed {\n339|\t\t\treturn true\n(more lines below)"}}}
