+	"ctor|failViolation|request deadline is not uint53[1..3600000]":                                         {"TestDecodeRequestFrameRefusals"},
+	"ctor|failViolation|success envelope does not carry ok=true":                                            {"TestCheckSuccessEnvelopeRefusals"},
