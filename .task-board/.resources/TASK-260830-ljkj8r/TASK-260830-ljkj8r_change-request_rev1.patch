+		t.Run(probe.name, func(t *testing.T) {
+			t.Parallel()
+			if _, err := CheckSuccessEnvelope(probe.frame, request); requireCode(t, err, "adapter_protocol_violation") == nil {
+				t.Fatal("success must refuse")
