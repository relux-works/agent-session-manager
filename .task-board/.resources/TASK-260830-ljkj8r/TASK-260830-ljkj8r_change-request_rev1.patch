+	limit := `"max_frame_bytes":8388608,"max_scan_instances":65536,"max_inventory_take":1000,"max_excerpt_count":20,"max_excerpt_bytes":4096,"max_enrichment_events":5000,"max_enrichment_bytes":4194304`
