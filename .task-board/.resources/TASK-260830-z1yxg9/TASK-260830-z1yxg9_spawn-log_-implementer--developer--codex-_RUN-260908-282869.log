// Package canonicaljson implements the RFC 8785 JSON Canonicalization Scheme
// and the AX omit-self-field identity boundary for immutable logical objects.
package canonicaljson

import (
	"bytes"
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"strconv"
	"strings"
	"unicode/utf8"

