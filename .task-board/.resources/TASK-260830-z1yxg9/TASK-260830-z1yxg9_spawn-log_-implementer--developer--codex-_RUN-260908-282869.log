name: CI

on:
  pull_request:
  push:
    branches:
      - main

permissions:
  contents: read

# What green means. Every job below proves its selection matched something:
# a grep, glob, file scan, matrix expansion, or test selector that finds
# nothing fails closed instead of passing on an empty result set. No job
# declares an `if:` condition, so no job can skip quietly; gates-verdict
# additionally refuses any skipped, failed, or cancelled dependency.
#
# GOOS=windows work is compile-and-vet only. A green windows-compile-only job
# proves the tree type-checks for Windows; it never implies executed
# behaviour. Coverage is reported as numbers, not enforced as a floor.
jobs:
  contract-preservation:
    name: Contract preservation (v0.5.0 current, v0.4.3 historical)
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Check out repository
        uses: actions/checkout@v7

      - name: Set up Go
        uses: actions/setup-go@v7
        with:
          go-version-file: go.mod

      - name: Verify specification-to-code ownership
        run: go run ./internal/traceability/cmd/tracecheck

      # The diff proves the committed catalog matches generator output, but
      # `go generate` runs nothing when its directive is disarmed: rewriting
      # `//go:generate` as `// go:generate` preserves the token while turning
      # the directive into a plain comment, so generation is skipped and the
      # diff stays clean. The anchored check refuses that token-preserving
      # rewrite; only the exact directive form counts. A new directive
      # without a pin update reddens here (and in
      # TestGenerateDirectiveStaysRecognizedForm) instead of going unchecked.
      - name: Verify generated catalog is current
        run: |
          test "$(grep -c '^//go:generate' internal/catalog/catalog.go)" -eq 1
          go generate ./internal/catalog
          git diff --exit-code -- internal/catalog/catalog_gen.go

      # The release roots are derived from internal/specpin and
      # internal/catalog inside the gate, never retyped here. Each -- PASS
      # guard below must match: a selector that runs nothing fails here
      # instead of passing silently.
      - name: Run pinned contract-version gates
        run: |
          set +e
          go test ./internal/cigate -run 'TestVerifyContractPreservationLive|TestPinnedReleasesAgreeAcrossAuthorities|TestDerivedSetsAreComplete|TestCheckAgreementAdmitsIdenticalSets|TestCheckAgreementRefusals|TestCheckReleaseRootsRefusesDrift' -count=1 -v > cigate-contracts.log 2>&1
          code=$?
          set -e
          cat cigate-contracts.log
          test $code -eq 0
          for gate in TestVerifyContractPreservationLive TestPinnedReleasesAgreeAcrossAuthorities TestDerivedSetsAreComplete TestCheckAgreementAdmitsIdenticalSets TestCheckAgreementRefusals TestCheckReleaseRootsRefusesDrift; do
            grep -q "^--- PASS: ${gate}" cigate-contracts.log
          done

  lint:
    name: Linters (vet, Windows vet, gofmt)
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Check out repository
        uses: actions/checkout@v7

      - name: Set up Go
        uses: actions/setup-go@v7
        with:
          go-version-file: go.mod

      - name: Vet
        run: go vet ./...

      - name: Vet Windows build-tagged sources
        run: GOOS=windows go vet ./...

      # gofmt lists only offending files, so a clean tree prints nothing.
      # The file count proves the scan was not empty; the log must then be.
      - name: Check formatting
        run: |
          count=$(find internal -name '*.go' | wc -l | tr -d ' ')
          echo "go files scanned: ${count}"
          test "${count}" -gt 0
          set +e
          gofmt -l internal > gofmt.log 2>&1
          code=$?
          set -e
          cat gofmt.log
          test $code -eq 0
          test ! -s gofmt.log

  test:
    name: Build and test (no cache)
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Check out repository
        uses: actions/checkout@v7

      - name: Set up Go

