{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d7cf","stream":{"kind":"session","id":"01a0addc-f5a7-7d72-82bc-9d078a927129"},"sequence":2626,"recorded_at":1780531400005247,"record_type":"event","durability":"durable","causation_id":"05ccea39-0df0-456b-a475-42ee00a3a1b7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"05ccea39-0df0-456b-a475-42ee00a3a1b7","run_stream":{"kind":"run","id":"05ccea39-0df0-456b-a475-42ee00a3a1b7"},"task_stream":{"kind":"task","id":"01a0adfc-0f27-72b1-a611-b033862364f7"},"task_id":"01a0adfc-0f27-72b1-a611-b033862364f7","event":{"kind":"output","task_id":"01a0adfc-0f27-72b1-a611-b033862364f7","chunk":"edited\nchanged lines: lines 429-444\n--- original\n+++ updated\n@@\n-func classifyHandshakeError(err error) error {\n-\tif err == nil {\n-\t\treturn nil\n-\t}\n-\tif errors.Is(err, ErrTransportFailure) {\n-\t\treturn err\n-\t}\n-\tvar netErr net.Error\n-\tif errors.As(err, &netErr) {\n-\t\treturn fmt.Errorf(\"%w: %v\", ErrTransportFailure, err)\n-\t}\n-\tif errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) || errors.Is(err, io.ErrClosedPipe) {\n-\t\treturn fmt.Errorf(\"%w: %v\", ErrTransportFailure, err)\n-\t}\n-\treturn fmt.Errorf(\"%w: %v\", ErrAuthenticationFailed, err)\n-}\n+func classifyHandshakeError(err error) error {\n+\tif err == nil {\n+\t\treturn nil\n+\t}\n+\tif errors.Is(err, ErrTransportFailure) {\n+\t\treturn err\n+\t}\n+\t// A received TLS alert unwraps to an OpError whose Op is \"remote\n+\t// error\": that is peer authentication, never transport I/O. Every\n+\t// other OpError, a timeout, a closed conn, or an EOF variant is the\n+\t// transport failing underneath the handshake.\n+\tvar opErr *net.OpError\n+\tif errors.As(err, &opErr) && opErr.Op != \"remote error\" {\n+\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n+\t}\n+\tvar netErr net.Error\n+\tif errors.As(err, &netErr) && netErr.Timeout() {\n+\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n+\t}\n+\tif errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) || errors.Is(err, io.ErrClosedPipe) || errors.Is(err, net.ErrClosed) {\n+\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n+\t}\n+\treturn fmt.Errorf(\"%w: %w\", ErrAuthenticationFailed, err)\n+}\n","final_result":true}}}
