{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d58f","stream":{"kind":"session","id":"01a0addc-f5a7-7d72-82bc-9d078a927129"},"sequence":2338,"recorded_at":1780531400004671,"record_type":"event","durability":"durable","causation_id":"05ccea39-0df0-456b-a475-42ee00a3a1b7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"05ccea39-0df0-456b-a475-42ee00a3a1b7","run_stream":{"kind":"run","id":"05ccea39-0df0-456b-a475-42ee00a3a1b7"},"call_id":"call_01a0adf361ec705795459c4225a34d8d","text":"edited\nchanged lines: lines 184-192\n--- original\n+++ updated\n@@\n-func expectClose(t *testing.T, conn net.Conn) {\n-\tt.Helper()\n-\tif err := conn.SetReadDeadline(time.Now().Add(10 * time.Second)); err != nil {\n-\t\tt.Fatalf(\"SetReadDeadline: %v\", err)\n-\t}\n-\tif _, err := hostchannel.ReadLine(conn); !errors.Is(err, io.EOF) {\n-\t\tt.Fatalf(\"stream did not close: %v\", err)\n-\t}\n-}\n+func expectClose(t *testing.T, conn net.Conn) {\n+\tt.Helper()\n+\t_ = conn.SetReadDeadline(time.Now().Add(10 * time.Second))\n+\tif _, err := hostchannel.ReadLine(conn); !errors.Is(err, io.EOF) {\n+\t\tt.Fatalf(\"stream did not close: %v\", err)\n+\t}\n+}\n+\n+// expectRogueExchangeFails proves a rogue cannot complete an exchange\n+// against a refusing server. A TLS 1.3 client may report handshake success\n+// before the server validates its flight, so the assertion is on the hello\n+// round trip, not on the handshake call.\n+func expectRogueExchangeFails(t *testing.T, rogue *tls.Conn) {\n+\tt.Helper()\n+\t_ = rogue.SetWriteDeadline(time.Now().Add(10 * time.Second))\n+\t_ = rogue.SetReadDeadline(time.Now().Add(10 * time.Second))\n+\t_, line, _ := rogueHello(t, hostA, nil)\n+\tif _, err := rogue.Write(append(line, '\\n')); err != nil {\n+\t\treturn\n+\t}\n+\tif _, err := hostchannel.ReadLine(rogue); err == nil {\n+\t\tt.Fatal(\"rogue hello completed against a refusing server\")\n+\t}\n+}\n","edit_facts":{"tool_name":"edit_file","path":"internal/hostchannel/refusal_test.go","added":24,"removed":9},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d591","stream":{"kind":"session","id":"01a0addc-f5a7-7d72-82bc-9d078a927129"},"sequence":2339,"recorded_at":1780531400004673,"record_type":"event","durability":"durable","causation_id":"05ccea39-0df0-456b-a475-42ee00a3a1b7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"05ccea39-0df0-456b-a475-42ee00a3a1b7","run_stream":{"kind":"run","id":"05ccea39-0df0-456b-a475-42ee00a3a1b7"},"call_id":"call_01a0adf36d2276f386cb1a8b12d8d97e","text":"edited\nchanged lines: lines 299-304\n--- original\n+++ updated\n@@\n-\trogue := tls.Client(clientConn, rogueClientConfig(t, f, f.certA, \"\", func(config *tls.Config) {\n-\t\tconfig.NextProtos = nil\n-\t}))\n-\tif err := rogue.Handshake(); err == nil {\n-\t\tt.Fatal(\"missing-ALPN handshake succeeded\")\n-\t}\n+\trogue := tls.Client(clientConn, rogueClientConfig(t, f, f.certA, \"\", func(config *tls.Config) {\n+\t\tconfig.NextProtos = nil\n+\t}))\n+\t_ = rogue.Handshake()\n+\texpectRogueExchangeFails(t, rogue)\n","edit_facts":{"tool_name":"edit_file","path":"internal/hostchannel/refusal_test.go","added":5,"removed":6},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d593","stream":{"kind":"session","id":"01a0addc-f5a7-7d72-82bc-9d078a927129"},"sequence":2340,"recorded_at":1780531400004675,"record_type":"event","durability":"durable","causation_id":"05ccea39-0df0-456b-a475-42ee00a3a1b7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"05ccea39-0df0-456b-a475-42ee00a3a1b7","run_stream":{"kind":"run","id":"05ccea39-0df0-456b-a475-42ee00a3a1b7"},"call_id":"call_01a0adf3716b746a9ba709f9ae03a610","text":"edited\nchanged lines: lines 353-365\n--- original\n+++ updated\n@@\n-\tif _, err := clientConn.Write([]byte(\"GET / HTTP/1.0\\r\\n\\r\\n\")); err != nil {\n-\t\tt.Fatalf(\"rogue write: %v\", err)\n-\t}\n-\tif err := clientConn.SetReadDeadline(time.Now().Add(10 * time.Second)); err != nil {\n-\t\tt.Fatalf(\"SetReadDeadline: %v\", err)\n-\t}\n-\tprefix := make([]byte, 2)\n-\tif _, err := io.ReadFull(clientConn, prefix); err != nil {\n-\t\tt.Fatalf(\"rogue read: %v\", err)\n-\t}\n-\tif prefix[0] != 0x15 || prefix[1] != 0x03 {\n-\t\tt.Fatalf(\"preface reply = %x, want a TLS alert\", prefix)\n-\t}\n+\tif _, err := clientConn.Write([]byte(\"GET / HTTP/1.0\\r\\n\\r\\n\")); err != nil {\n+\t\tt.Fatalf(\"rogue write: %v\", err)\n+\t}\n+\t_ = clientConn.SetReadDeadline(time.Now().Add(10 * time.Second))\n+\tfirst := make([]byte, 1)\n+\t_, err := clientConn.Read(first)\n+\tswitch {\n+\tcase errors.Is(err, io.EOF) || errors.Is(err, io.ErrClosedPipe):\n+\t\t// Closed without sending: permitted, only JSON is forbidden.\n+\tcase err != nil:\n+\t\tt.Fatalf(\"rogue read: %v\", err)\n+\tcase first[0] == '{':\n+\t\tt.Fatal(\"JSON sent before TLS completed\")\n+\tcase first[0] != 0x15:\n+\t\tt.Fatalf(\"preface reply = %x, want a TLS alert or close\", first)\n+\t}\n","edit_facts":{"tool_name":"edit_file","path":"internal/hostchannel/refusal_test.go","added":16,"removed":13},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
