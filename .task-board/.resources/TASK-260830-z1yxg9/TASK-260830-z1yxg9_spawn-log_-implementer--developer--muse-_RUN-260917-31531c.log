ed := &VerifiedPeer{}\n+\tverify := func(state tls.ConnectionState) error {\n+\t\tif state.NegotiatedProtocol != ALPN {\n+\t\t\treturn ErrALPNMismatch\n+\t\t}\n+\t\tif state.DidResume {\n","final_result":true}}}
