4 || backupLoaded.SourceVersion != backupVersion {\\ninternal/config/migration_v4.go:173:\\treplacement, err := EncodeVersion4(next, context)\\ninternal/config/migration.go:142:\\tcase Version1, Version2, CurrentVersion, Version4:\\ninternal/config/migration.go:200:\\tif !targetKnown || options.TargetVersion == Version1 {\\ninternal/config/migration.go:203:\\tif options.TargetVersion == Version4 {\\ninternal/config/migration.go:222:\\tif loaded.SourceVersion == Version1 {\\ninternal/config/migration.go:231:\\tcase Version2:\\ninternal/config/migration.go:232:\\t\\treplacement, err = encodeVersion2(loaded.Value, context)\\n=== LoadedConfiguration ===\\ninternal/config/schema.go:57:type LoadedConfiguration struct {\\ninternal/config/schema.go-58-\\tSourceVersion string\\ninternal/config/schema.go-59-\\tValue         Configuration\\ninternal/config/schema.go-60-}\\ninternal/config/schema.go-61-\\ninternal/config/schema.go-62-// DocumentError preserves machine-actionable error identity while rendering\\ninternal/config/schema.go-63-// only a static schema clause. Parser/validator details remain unwrap-able and\\ninternal/config/schema.go-64-// cannot echo TOML values, paths, endpoints, or other machine-local data.\\ninternal/config/schema.go-65-type DocumentError struct {\\ninternal/config/schema.go-66-\\tClause string\\ninternal/config/schema.go-67-\\tErr    error\\n=== Peer ===\\n116:type Peer struct {\\n117-\\tHostID         string\\n118-\\tName           string\\n119-\\tEndpoint       string\\n120-\\tPlatform       scalar.Platform\\n121-\\tSSHArgs        []string\\n122-\\tWorkspaceRoots []WorkspaceRoot\\n123-}\\n124-\\n125-type WorkspaceRoot struct {\\n126-\\tLogicalRoot string\\n127-\\tPath        string\\n128-}\\n129-\\n130-type Providers struct {\\n131-\\tPluginDirs           []string\\n\",\n  \"original_output_bytes\": 2443,\n  \"original_output_tokens\": 611,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
