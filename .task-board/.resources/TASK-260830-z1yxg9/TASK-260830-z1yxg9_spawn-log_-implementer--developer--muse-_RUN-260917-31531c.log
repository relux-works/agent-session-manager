{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c52d","stream":{"kind":"session","id":"01a0addc-f5a7-7d72-82bc-9d078a927129"},"sequence":241,"recorded_at":1780531400000477,"record_type":"event","durability":"durable","causation_id":"05ccea39-0df0-456b-a475-42ee00a3a1b7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"05ccea39-0df0-456b-a475-42ee00a3a1b7","run_stream":{"kind":"run","id":"05ccea39-0df0-456b-a475-42ee00a3a1b7"},"call_id":"call_01a0addd9cc476c0b13f9097d31878a2","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/TASK-260830-z1yxg9/preserved-before-credentials-260910/files/internal/rpcwire/envelope.go`.\n1|// Package rpcwire encodes and inspects untrusted Mesh RPC frames. Structural\n2|// validity and correlation are never authentication, handshake completion or\n3|// permission to dispatch. No connection, responder or operation executor lives\n4|// here. The eventual bilateral admission consumer must supply those boundaries.\n5|package rpcwire\n6|\n7|import (\n8|\t\"bytes\"\n9|\t\"encoding/json\"\n10|\t\"errors\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/sshtransport\"\n16|)\n17|\n18|const Protocol = \"urn:ax:protocol:rpc\"\n19|const MaxLineBytes = sshtransport.MaxLineBytes\n20|const MinObjectBytes = 5 * 1024 * 1024\n21|\n22|var (\n23|\tErrFrame       = errors.New(\"invalid RPC frame\")\n24|\tErrVersion     = errors.New(\"unsupported RPC wire version\")\n25|\tErrCorrelation = errors.New(\"RPC response does not match request\")\n26|\tErrHello       = errors.New(\"incompatible RPC hello structure\")\n27|\tErrInventory   = errors.New(\"invalid RPC inventory structure\")\n28|)\n29|\n30|// Request retains an isolated envelope. Body bytes for operations other than\n31|// hello and inventory.roots are opaque: their operation owners must validate\n32|// them. A zero Request cannot be encoded or used as a response expectation.\n33|type Request struct {\n34|\tversion, id, operation string\n35|\tbody                   json.RawMessage\n36|}\n37|\n38|func (r Request) Version() string       { return r.version }\n39|func (r Request) ID() string            { return r.id }\n40|func (r Request) Operation() string     { return r.operation }\n41|func (r Request) Body() json.RawMessage { return bytes.Clone(r.body) }\n42|\n43|// Response is correlated but still untrusted. A success body has the same\n44|// operation-validation bounds as Request. A failure uses the containing major's\n45|// static Structured Error binding, never a version supplied by its body.\n46|type Response struct {\n47|\trequest Request\n48|\tbody    json.RawMessage\n49|\tfailure *axerror.Error\n50|}\n51|\n52|func (r Response) OK() bool                { return r.failure == nil && r.body != nil }\n53|func (r Response) Body() json.RawMessage   { return bytes.Clone(r.body) }\n54|func (r Response) Failure() *axerror.Error { return r.failure }\n55|\n56|func major(version string) (int, error) {\n57|\tswitch version {\n58|\tcase \"2.0.0\":\n59|\t\treturn 2, nil\n60|\tcase \"3.0.0\":\n61|\t\treturn 3, nil\n62|\tcase \"4.0.0\":\n63|\t\treturn 4, nil\n64|\tdefault:\n65|\t\treturn 0, ErrVersion\n66|\t}\n67|}\n68|\n69|// object refuses duplicate members, non-integral numbers and other\n70|// non-I-JSON input using the existing common data-model owner. Keep original\n71|// bytes; canonicalization must not launder invalid numeric lexical forms.\n72|func object(data []byte) (map[string]json.RawMessage, error) {\n73|\tif _, err := canonicaljson.Canonicalize(data); err != nil {\n74|\t\treturn nil, ErrFrame\n75|\t}\n76|\tvar m map[string]json.RawMessage\n77|\tif json.Unmarshal(data, &m) != nil || m == nil {\n78|\t\treturn nil, ErrFrame\n79|\t}\n80|\treturn m, nil\n81|}\n82|func exact(m map[string]json.RawMessage, keys ...string) bool {\n83|\tif len(m) != len(keys) {\n84|\t\treturn false\n85|\t}\n86|\tfor _, k := range keys {\n87|\t\tif _, ok := m[k]; !ok {\n88|\t\t\treturn false\n89|\t\t}\n90|\t}\n91|\treturn true\n92|}\n93|func stringValue(raw json.RawMessage) string {\n94|\tvar value string\n95|\tif json.Unmarshal(raw, &value) != nil {\n96|\t\treturn \"\"\n97|\t}\n98|\treturn value\n99|}\n100|func envelope(data []byte) (map[string]json.RawMessage, string, string, error) {\n101|\tif len(data) == 0 || len(data) > MaxLineBytes || bytes.ContainsAny(data, \"\\n\") {\n102|\t\treturn nil, \"\", \"\", ErrFrame\n103|\t}\n104|\tm, err := object(data)\n105|\tif err != nil {\n106|\t\treturn nil, \"\", \"\", err\n107|\t}\n108|\tif stringValue(m[\"protocol\"]) != Protocol {\n109|\t\treturn nil, \"\", \"\", ErrFrame\n110|\t}\n111|\tversion := stringValue(m[\"protocol_version\"])\n112|\tif !semver.MatchString(version) {\n113|\t\treturn nil, \"\", \"\", ErrFrame\n114|\t}\n115|\tif _, err = major(version); err != nil {\n116|\t\treturn nil, \"\", \"\", err\n117|\t}\n118|\tid := stringValue(m[\"request_id\"])\n119|\tif _, err = scalar.ParseUUIDv7(id); err != nil {\n120|\t\treturn nil, \"\", \"\", ErrFrame\n121|\t}\n122|\treturn m, version, id, nil\n123|}\n124|\n125|// DecodeRequest inspects one LF-free line, as returned by SSH Session.Receive.\n126|// It never marks a hello successful or opens an operation-dispatch path.\n127|func DecodeRequest(line []byte) (Request, error) {\n128|\tm, version, id, err := envelope(line)\n129|\tif err != nil {\n130|\t\treturn Request{}, err\n131|\t}\n132|\tif !exact(m, \"protocol\", \"protocol_version\", \"request_id\", \"operation\", \"body\") {\n133|\t\treturn Request{}, ErrFrame\n134|\t}\n135|\top := stringValue(m[\"operation\"])\n136|\tif op == \"\" {\n137|\t\treturn Request{}, ErrFrame\n138|\t}\n139|\tif _, err = object(m[\"body\"]); err != nil {\n140|\t\treturn Request{}, err\n141|\t}\n142|\tif op == \"hello\" {\n143|\t\t_, err = decodeHello(version, m[\"body\"], false)\n144|\t}\n145|\tif op == \"inventory.roots\" {\n146|\t\t_, err = decodeNamespaces(version, m[\"body\"])\n147|\t}\n148|\tif err != nil {\n149|\t\treturn Request{}, err\n150|\t}\n151|\treturn Request{version, id, op, bytes.Clone(m[\"body\"])}, nil\n152|}\n153|\n154|// EncodeRequest validates the same structural surface as DecodeRequest and\n155|// returns one line without LF for SSH Session.Send. It does not send it.\n156|func EncodeRequest(version, id, operation string, body json.RawMessage) ([]byte, error) {\n157|\tline, err := json.Marshal(map[string]any{\"protocol\": Protocol, \"protocol_version\": version, \"request_id\": id, \"operation\": operation, \"body\": body})\n158|\tif err != nil {\n159|\t\treturn nil, ErrFrame\n160|\t}\n161|\tif _, err = DecodeRequest(line); err != nil {\n162|\t\treturn nil, err\n163|\t}\n164|\treturn line, nil\n165|}\n166|\n167|// DecodeResponse compares identity/version before examining the success or\n168|// error payload. It does not consume a pending request or provide replay\n169|// protection; connection sequencing remains the admission consumer's job.\n170|func DecodeResponse(line []byte, request Request) (Response, error) {\n171|\tif request.id == \"\" {\n172|\t\treturn Response{}, ErrCorrelation\n173|\t}\n174|\tm, version, id, err := envelope(line)\n175|\tif err != nil {\n176|\t\treturn Response{}, err\n177|\t}\n178|\tif version != request.version {\n179|\t\treturn Response{}, ErrVersion\n180|\t}\n181|\tif id != request.id {\n182|\t\treturn Response{}, ErrCorrelation\n183|\t}\n184|\tswitch string(m[\"ok\"]) {\n185|\tcase \"true\":\n186|\t\tif !exact(m, \"protocol\", \"protocol_version\", \"request_id\", \"ok\", \"body\") {\n187|\t\t\treturn Response{}, ErrFrame\n188|\t\t}\n189|\t\tif _, err = object(m[\"body\"]); err != nil {\n190|\t\t\treturn Response{}, err\n191|\t\t}\n192|\t\tif request.operation == \"hello\" {\n193|\t\t\tvar h Hello\n194|\t\t\th, err = decodeHello(version, m[\"body\"], true)\n195|\t\t\tif err == nil {\n196|\t\t\t\tsent, _ := request.Hello()\n197|\t\t\t\tif h.NonceEcho != sent.Nonce {\n198|\t\t\t\t\terr = ErrCorrelation\n199|\t\t\t\t}\n200|\t\t\t}\n201|\t\t}\n202|\t\tif request.operation == \"inventory.roots\" {\n203|\t\t\terr = validateRoots(version, m[\"body\"], request.body)\n204|\t\t}\n205|\t\tif err != nil {\n206|\t\t\treturn Response{}, err\n207|\t\t}\n208|\t\treturn Response{request: request, body: bytes.Clone(m[\"body\"])}, nil\n209|\tcase \"false\":\n210|\t\tif !exact(m, \"protocol\", \"protocol_version\", \"request_id\", \"ok\", \"error\") {\n211|\t\t\treturn Response{}, ErrFrame\n212|\t\t}\n213|\t\tn, _ := major(version)\n214|\t\tfailure, err := axerror.DecodeBound(axerror.ContainingContract{ID: Protocol, Major: n}, m[\"error\"])\n215|\t\tif err != nil {\n216|\t\t\treturn Response{}, err\n217|\t\t}\n218|\t\treturn Response{request: request, failure: failure}, nil\n219|\tdefault:\n220|\t\treturn Response{}, ErrFrame\n221|\t}\n222|}\n223|\n224|func EncodeSuccess(request Request, body json.RawMessage) ([]byte, error) {\n225|\treturn encodeResponse(request, true, \"body\", body)\n226|}\n227|func EncodeFailure(request Request, failure *axerror.Error) ([]byte, error) {\n228|\treturn encodeResponse(request, false, \"error\", failure)\n229|}\n230|func encodeResponse(request Request, ok bool, key string, payload any) ([]byte, error) {\n231|\tline, err := json.Marshal(map[string]any{\"protocol\": Protocol, \"protocol_version\": request.version, \"request_id\": request.id, \"ok\": ok, key: payload})\n232|\tif err != nil {\n233|\t\treturn nil, ErrFrame\n234|\t}\n235|\tif _, err = DecodeResponse(line, request); err != nil {\n236|\t\treturn nil, err\n237|\t}\n238|\treturn line, nil\n239|}\n240|\n241|// EncodeRejection frames a failure for a parseable supported-version request,\n242|// even when its operation or body is invalid (Section 15.1 bootstrap framing).\n243|// Missing/invalid protocol, version or request ID and unparseable lines return\n244|// no frame. This only encodes bytes: the eventual responder must choose the\n245|// correct failure and close after its one pre-handshake rejection. It never\n246|// returns a Request that could be mistaken for a validated hello.\n247|func EncodeRejection(line []byte, failure *axerror.Error) ([]byte, error) {\n248|\tm, version, id, err := envelope(line)\n249|\tif err != nil {\n250|\t\treturn nil, err\n251|\t}\n252|\t// A response or arbitrary object is not a request to which we may reply.\n253|\tif _, ok := m[\"operation\"]; !ok {\n254|\t\treturn nil, ErrFrame\n255|\t}\n256|\treturn EncodeFailure(Request{version: version, id: id}, failure)\n257|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c52f","stream":{"kind":"session","id":"01a0addc-f5a7-7d72-82bc-9d078a927129"},"sequence":242,"recorded_at":1780531400000479,"record_type":"event","durability":"durable","causation_id":"05ccea39-0df0-456b-a475-42ee00a3a1b7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"05ccea39-0df0-456b-a475-42ee00a3a1b7","run_stream":{"kind":"run","id":"05ccea39-0df0-456b-a475-42ee00a3a1b7"},"call_id":"call_01a0addd9e4175d7a2e083f8ef02a56d","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/TASK-260830-z1yxg9/preserved-before-credentials-260910/files/internal/rpcwire/hello.go`.\n1|package rpcwire\n2|\n3|import (\n4|\t\"crypto/rand\"\n5|\t\"encoding/base64\"\n6|\t\"encoding/json\"\n7|\t\"regexp\"\n8|\t\"slices\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|)\n12|\n13|var semver = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n14|\n15|// Hello is a structural claim, including the untrusted HostID and limits.\n16|// Received nonce randomness and freshness cannot be established by a codec.\n17|type Hello struct {\n18|\tHostID         string              `json:\"host_id\"`\n19|\tPlatform       string              `json:\"platform\"`\n20|\tAXVersion      string              `json:\"ax_version\"`\n21|\tNonce          string              `json:\"nonce\"`\n22|\tNonceEcho      string              `json:\"nonce_echo,omitempty\"`\n23|\tContracts      map[string][]string `json:\"contracts\"`\n24|\tMaxLineBytes   scalar.Uint53       `json:\"max_line_bytes\"`\n25|\tMaxObjectBytes scalar.Uint53       `json:\"max_object_bytes\"`\n26|}\n27|\n28|// NewNonce produces 256 random bits without accepting caller-supplied entropy.\n29|func NewNonce() string {\n30|\tvar nonce [32]byte\n31|\t_, _ = rand.Read(nonce[:]) // crypto/rand.Read is infallible in Go 1.25.\n32|\treturn base64.RawURLEncoding.EncodeToString(nonce[:])\n33|}\n34|\n35|// ContractProfile describes the pinned wire shape, not installed capabilities.\n36|// Returning a fresh map prevents one caller from changing another's validator.\n37|func ContractProfile(version string) (map[string][]string, error) {\n38|\tn, err := major(version)\n39|\tif err != nil {\n40|\t\treturn nil, err\n41|\t}\n42|\tm := map[string][]string{}\n43|\tfor _, key := range []string{\"rpc\", \"session_record\", \"session_event\", \"lease\", \"checkpoint\", \"workspace_group\", \"provider_identity\", \"blob\", \"transfer_manifest\", \"chunk\", \"materialization_plan\", \"tombstone\", \"tombstone_ack\", \"task_board_bundle\"} {\n44|\t\tm[key] = []string{\"1.0.0\"}\n45|\t}\n46|\tm[\"rpc\"] = []string{version}\n47|\tif n >= 3 {\n48|\t\tm[\"session_record\"] = []string{\"1.0.0\", \"2.0.0\", \"3.0.0\"}\n49|\t\tm[\"session_event\"] = []string{\"1.0.0\", \"2.0.0\", \"3.0.0\"}\n50|\t\tm[\"materialization_plan\"] = []string{\"1.0.0\", \"2.0.0\"}\n51|\t\tfor _, key := range []string{\"environment_observation\", \"native_session_observation\", \"session_inventory_batch\", \"conversation_lineage_link\", \"session_annotation\", \"session_enrichment_profile\", \"session_enrichment_job_request\", \"session_enrichment_job_receipt\", \"session_continuation_plan\", \"session_directory_operation_receipt\"} {\n52|\t\t\tm[key] = []string{\"1.0.0\"}\n53|\t\t}\n54|\t}\n55|\tif n == 4 {\n56|\t\tm[\"session_event\"] = append(m[\"session_event\"], \"4.0.0\")\n57|\t\tm[\"terminal_backend_evidence\"] = []string{\"1.0.0\"}\n58|\t}\n59|\treturn m, nil\n60|}\n61|\n62|func validNonce(s string) bool {\n63|\tb, err := base64.RawURLEncoding.Strict().DecodeString(s)\n64|\treturn err == nil && len(b) >= 16 && base64.RawURLEncoding.EncodeToString(b) == s\n65|}\n66|func decodeHello(version string, data []byte, response bool) (Hello, error) {\n67|\tm, err := object(data)\n68|\tif err != nil {\n69|\t\treturn Hello{}, ErrHello\n70|\t}\n71|\tkeys := []string{\"host_id\", \"platform\", \"ax_version\", \"nonce\", \"contracts\", \"max_line_bytes\", \"max_object_bytes\"}\n72|\tif response {\n73|\t\tkeys = append(keys, \"nonce_echo\")\n74|\t}\n75|\tif !exact(m, keys...) {\n76|\t\treturn Hello{}, ErrHello\n77|\t}\n78|\tvar h Hello\n79|\tif json.Unmarshal(data, &h) != nil {\n80|\t\treturn Hello{}, ErrHello\n81|\t}\n82|\tif _, err = scalar.ParseUUIDv7(h.HostID); err != nil {\n83|\t\treturn Hello{}, ErrHello\n84|\t}\n85|\tif _, err = scalar.ParsePlatform(h.Platform); err != nil {\n86|\t\treturn Hello{}, ErrHello\n87|\t}\n88|\tif !semver.MatchString(h.AXVersion) || !validNonce(h.Nonce) || (response && !validNonce(h.NonceEcho)) {\n89|\t\treturn Hello{}, ErrHello\n90|\t}\n91|\tif h.MaxLineBytes.Uint64() < MaxLineBytes || h.MaxObjectBytes.Uint64() < MinObjectBytes {\n92|\t\treturn Hello{}, ErrHello\n93|\t}\n94|\tprofile, _ := ContractProfile(version)\n95|\tif len(h.Contracts) != len(profile) {\n96|\t\treturn Hello{}, ErrHello\n97|\t}\n98|\tfor key, expected := range profile {\n99|\t\tversions := h.Contracts[key]\n100|\t\tif len(versions) < 1 || len(versions) > 16 {\n101|\t\t\treturn Hello{}, ErrHello\n102|\t\t}\n103|\t\tfor i, v := range versions {\n104|\t\t\tif !semver.MatchString(v) || (i > 0 && versions[i-1] >= v) {\n105|\t\t\t\treturn Hello{}, ErrHello\n106|\t\t\t}\n107|\t\t}\n108|\t\t// v2 permits 1..16 supported versions for every required key; later\n109|\t\t// pinned maps specify exact arrays. Selecting a common minor is separate.\n110|\t\tif version != \"2.0.0\" && !slices.Equal(versions, expected) {\n111|\t\t\treturn Hello{}, ErrHello\n112|\t\t}\n113|\t}\n114|\treturn h, nil\n115|}\n116|\n117|func (r Request) Hello() (Hello, error) {\n118|\tif r.operation != \"hello\" {\n119|\t\treturn Hello{}, ErrHello\n120|\t}\n121|\treturn decodeHello(r.version, r.body, false)\n122|}\n123|func (r Response) Hello() (Hello, error) {\n124|\tif !r.OK() || r.request.operation != \"hello\" {\n125|\t\treturn Hello{}, ErrHello\n126|\t}\n127|\treturn decodeHello(r.request.version, r.body, true)\n128|}\n129|\n130|// Limits is only the smaller pair of structural offers. It is not a negotiated\n131|// or authenticated connection. The transport's fixed 8 MiB cap still applies.\n132|type Limits struct{ LineBytes, ObjectBytes uint64 }\n133|\n134|func OfferedLimits(request Request, response Response) (Limits, error) {\n135|\ta, err := request.Hello()\n136|\tif err != nil {\n137|\t\treturn Limits{}, err\n138|\t}\n139|\tb, err := response.Hello()\n140|\tif err != nil {\n141|\t\treturn Limits{}, err\n142|\t}\n143|\tif response.request.id != request.id || response.request.version != request.version || a.Nonce != b.NonceEcho {\n144|\t\treturn Limits{}, ErrCorrelation\n145|\t}\n146|\treturn Limits{min(a.MaxLineBytes.Uint64(), b.MaxLineBytes.Uint64()), min(a.MaxObjectBytes.Uint64(), b.MaxObjectBytes.Uint64())}, nil\n147|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c531","stream":{"kind":"session","id":"01a0addc-f5a7-7d72-82bc-9d078a927129"},"sequence":243,"recorded_at":1780531400000481,"record_type":"event","durability":"durable","causation_id":"05ccea39-0df0-456b-a475-42ee00a3a1b7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"05ccea39-0df0-456b-a475-42ee00a3a1b7","run_stream":{"kind":"run","id":"05ccea39-0df0-456b-a475-42ee00a3a1b7"},"call_id":"call_01a0addd9fdb73e69472ac3032b4f558","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/TASK-260830-z1yxg9/preserved-before-credentials-260910/files/internal/rpcwire/inventory.go`.\n1|package rpcwire\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"slices\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|)\n9|\n10|// Namespaces is the wire vocabulary for an explicitly chosen pinned version.\n11|// It does not advertise support, compute inventory or authorize object exchange.\n12|func Namespaces(version string) ([]string, error) {\n13|\tn, err := major(version)\n14|\tif err != nil {\n15|\t\treturn nil, err\n16|\t}\n17|\tnames := []string{\"blob\", \"event\", \"manifest\", \"record\", \"tombstone\", \"tombstone_ack\"}\n18|\tif n >= 3 {\n19|\t\tnames = append(names, \"directory_record\")\n20|\t}\n21|\tif n == 4 {\n22|\t\tnames = append(names, \"terminal_backend_evidence\")\n23|\t}\n24|\tslices.Sort(names)\n25|\treturn names, nil\n26|}\n27|func decodeNamespaces(version string, data []byte) ([]string, error) {\n28|\tm, err := object(data)\n29|\tif err != nil || !exact(m, \"namespaces\") {\n30|\t\treturn nil, ErrInventory\n31|\t}\n32|\tvar names []string\n33|\tif json.Unmarshal(m[\"namespaces\"], &names) != nil {\n34|\t\treturn nil, ErrInventory\n35|\t}\n36|\tallowed, _ := Namespaces(version)\n37|\tif len(names) < 1 || len(names) > len(allowed) {\n38|\t\treturn nil, ErrInventory\n39|\t}\n40|\tfor i, name := range names {\n41|\t\tif !slices.Contains(allowed, name) || (i > 0 && names[i-1] >= name) {\n42|\t\t\treturn nil, ErrInventory\n43|\t\t}\n44|\t}\n45|\treturn names, nil\n46|}\n47|\n48|// Root carries a claimed digest/count, not a verified Merkle root. Merkle\n49|// verification and schema-to-namespace membership belong to object exchange.\n50|type Root struct {\n51|\tNamespace string        `json:\"namespace\"`\n52|\tCount     scalar.Uint53 `json:\"count\"`\n53|\tRootID    scalar.Digest `json:\"root_id\"`\n54|}\n55|\n56|func validateRoots(version string, data, request []byte) error {\n57|\tnames, err := decodeNamespaces(version, request)\n58|\tif err != nil {\n59|\t\treturn err\n60|\t}\n61|\tm, err := object(data)\n62|\tif err != nil || !exact(m, \"roots\") {\n63|\t\treturn ErrInventory\n64|\t}\n65|\tvar roots []json.RawMessage\n66|\tif json.Unmarshal(m[\"roots\"], &roots) != nil || len(roots) != len(names) {\n67|\t\treturn ErrInventory\n68|\t}\n69|\tfor i, raw := range roots {\n70|\t\titem, err := object(raw)\n71|\t\tif err != nil || !exact(item, \"namespace\", \"count\", \"root_id\") {\n72|\t\t\treturn ErrInventory\n73|\t\t}\n74|\t\tvar root Root\n75|\t\tif json.Unmarshal(raw, &root) != nil || root.Namespace != names[i] {\n76|\t\t\treturn ErrInventory\n77|\t\t}\n78|\t}\n79|\treturn nil\n80|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
