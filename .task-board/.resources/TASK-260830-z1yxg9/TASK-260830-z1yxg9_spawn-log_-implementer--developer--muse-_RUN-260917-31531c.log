s public codec and hostchannel consumes them in the authenticated handshake (Serve/Dial), while BindingFor stays a static table with no negotiation path; the clause itself is still not enumerated against an acceptance case.\\\")\\n        n+=1\\n    if keys==['section:15.3']:\\n        e['gap']=e['gap'].replace(\\\"No RPC hello frame is built anywhere in this repository, and the closed 16-capability admission registry\\\", \\\"rpcwire builds structural hello frames and rejects an error map key (TestHelloRefusals/error-key), hostchannel frames failures only as Error envelopes and never as hello keys, and the closed 16-capability admission registry\\\")\\n        e['gap']=e['gap'].replace(\\\"carries no Structured Error code, so Section 15.3 keeps that clause unimplemented.\\\", \\\"carries no Structured Error code; the clause itself is still not enumerated against an acceptance case.\\\")\\n        n+=1\\nprint('updated', n)\\njson.dump(reg, open(p,'w'), indent=1, sort_keys=True)\\nprint('wrote')\\nEOF\\ngo test ./internal/traceability/ -count=1 2>&1 | grep -E \\\"differs|FAIL|ok \\\" | head -4\",\n  \"description\": \"Update ownership gaps, check hash\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"updated 7\\nwrote\\n--- FAIL: TestAdoptedSectionsHavePendingOwnersAndRefuseRuntimeAdmission (0.14s)\\n--- FAIL: TestVerifyRepositoryRefusesMissingSelectorContract (0.30s)\\n--- FAIL: TestVerifyRepositoryAcceptsExactOwnership (0.34s)\\n--- FAIL: TestVerifyRepositoryRejectsAbsentOwnershipGroupProductionDeclaration (0.36s)\\n\",\n  \"original_output_bytes\": 312,\n  \"original_output_tokens\": 78,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
