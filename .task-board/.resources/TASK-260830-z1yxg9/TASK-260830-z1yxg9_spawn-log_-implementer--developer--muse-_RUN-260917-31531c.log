{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d93b","stream":{"kind":"session","id":"01a0addc-f5a7-7d72-82bc-9d078a927129"},"sequence":2808,"recorded_at":1780531400005611,"record_type":"event","durability":"durable","causation_id":"05ccea39-0df0-456b-a475-42ee00a3a1b7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"05ccea39-0df0-456b-a475-42ee00a3a1b7","run_stream":{"kind":"run","id":"05ccea39-0df0-456b-a475-42ee00a3a1b7"},"call_id":"call_01a0adfd0961749888d0d2cea342a1d8","text":"edited\nchanged lines: lines 199-214\n--- original\n+++ updated\n@@\n-// expectRogueExchangeFails proves a rogue cannot complete an exchange\n-// against a refusing server. A TLS 1.3 client may report handshake success\n-// before the server validates its flight, so the assertion is on the hello\n-// round trip, not on the handshake call.\n-func expectRogueExchangeFails(t *testing.T, rogue *tls.Conn) {\n-\tt.Helper()\n-\t_ = rogue.SetWriteDeadline(time.Now().Add(10 * time.Second))\n-\t_ = rogue.SetReadDeadline(time.Now().Add(10 * time.Second))\n-\t_, line, _ := rogueHello(t, hostA, nil)\n-\tif _, err := rogue.Write(append(line, '\\n')); err != nil {\n-\t\treturn\n-\t}\n-\tif _, err := hostchannel.ReadLine(rogue); err == nil {\n-\t\tt.Fatal(\"rogue hello completed against a refusing server\")\n-\t}\n-}\n+// expectRogueHandshakeFails proves a rogue cannot complete a handshake\n+// against a refusing server. A TLS 1.3 client may report handshake success\n+// before the server validates its flight, so the rogue reads next: the\n+// read drains the server alert (which also releases the rendezvous pipe)\n+// and must fail. Nothing is written: the server never reaches hello.\n+func expectRogueHandshakeFails(t *testing.T, rogue *tls.Conn) {\n+\tt.Helper()\n+\t_ = rogue.SetReadDeadline(time.Now().Add(10 * time.Second))\n+\tif _, err := rogue.Read(make([]byte, 4096)); err == nil {\n+\t\tt.Fatal(\"rogue read succeeded against a refusing server\")\n+\t}\n+}\n","edit_facts":{"tool_name":"edit_file","path":"internal/hostchannel/refusal_test.go","added":12,"removed":16},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
