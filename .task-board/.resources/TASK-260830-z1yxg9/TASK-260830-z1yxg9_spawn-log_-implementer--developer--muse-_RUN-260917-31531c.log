otocol:rpc\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + id + `\",\"operation\":\"health.get\",\"body\":{}}`))\n531|\tf.Add([]byte(`{\"protocol_version\":\"5.0.0\",\"error\":{\"retryable\":true}}`))\n532|\tf.Fuzz(func(t *testing.T, b []byte) {\n533|\t\tr, e := rpcwire.DecodeRequest(b)\n534|\t\tif e != nil {\n535|\t\t\treturn\n536|\t\t}\n537|\t\tround, e := rpcwire.EncodeRequest(r.Version(), r.ID(), r.Operation(), r.Body())\n538|\t\tif e != nil {\n539|\t\t\tt.Fatal(e)\n540|\t\t}\n541|\t\tif _, e = rpcwire.DecodeRequest(round); e != nil {\n542|\t\t\tt.Fatal(e)\n543|\t\t}\n544|\t\t_, _ = rpcwire.DecodeResponse(b, r)\n545|\t})\n546|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
