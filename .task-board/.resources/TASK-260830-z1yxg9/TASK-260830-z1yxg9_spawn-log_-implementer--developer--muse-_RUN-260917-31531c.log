{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d589","stream":{"kind":"session","id":"01a0addc-f5a7-7d72-82bc-9d078a927129"},"sequence":2335,"recorded_at":1780531400004665,"record_type":"event","durability":"durable","causation_id":"05ccea39-0df0-456b-a475-42ee00a3a1b7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"05ccea39-0df0-456b-a475-42ee00a3a1b7","run_stream":{"kind":"run","id":"05ccea39-0df0-456b-a475-42ee00a3a1b7"},"task_stream":{"kind":"task","id":"01a0adf3-9fee-71d1-866a-c46612dc7fc4"},"task_id":"01a0adf3-9fee-71d1-866a-c46612dc7fc4","event":{"kind":"output","task_id":"01a0adf3-9fee-71d1-866a-c46612dc7fc4","chunk":"edited\nchanged lines: lines 792-805\n--- original\n+++ updated\n@@\n-\t\tif err := rogue.Handshake(); err != nil {\n-\t\t\tt.Fatalf(\"handshake: %v\", err)\n-\t\t}\n-\t\tselect {\n-\t\tcase err := <-dialed:\n-\t\t\tif !errors.Is(err, hostchannel.ErrTransportFailure) {\n-\t\t\t\tt.Fatalf(\"Dial = %v\", err)\n-\t\t\t}\n-\t\t\tif !strings.Contains(err.Error(), \"deadline\") {\n-\t\t\t\tt.Fatalf(\"Dial = %v, want the deadline refusal\", err)\n-\t\t\t}\n-\t\tcase <-time.After(30 * time.Second):\n-\t\t\tt.Fatal(\"Dial did not return\")\n-\t\t}\n+\t\tif err := rogue.Handshake(); err != nil {\n+\t\t\tt.Fatalf(\"handshake: %v\", err)\n+\t\t}\n+\t\t// The silent server still drains the hello; it just never answers.\n+\t\tif _, err := hostchannel.ReadLine(rogue); err != nil {\n+\t\t\tt.Fatalf(\"ReadLine(hello): %v\", err)\n+\t\t}\n+\t\tselect {\n+\t\tcase err := <-dialed:\n+\t\t\tif !errors.Is(err, hostchannel.ErrTransportFailure) {\n+\t\t\t\tt.Fatalf(\"Dial = %v\", err)\n+\t\t\t}\n+\t\t\tif !strings.Contains(err.Error(), \"deadline\") {\n+\t\t\t\tt.Fatalf(\"Dial = %v, want the deadline refusal\", err)\n+\t\t\t}\n+\t\tcase <-time.After(30 * time.Second):\n+\t\t\tt.Fatal(\"Dial did not return\")\n+\t\t}\n","final_result":true}}}
