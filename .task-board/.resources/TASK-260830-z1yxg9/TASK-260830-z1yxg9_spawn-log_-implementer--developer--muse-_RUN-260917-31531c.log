s[8] => go test ./internal/canonicaljson -run=^$ -fuzz=^FuzzObjectIdentityRepresentationInvariant$ -fuzztime=100x -parallel=1\\n/spawn/worktree_isolation/validation/commands[9] => go test ./internal/canonicaljson -run=^$ -fuzz=^FuzzClosedIdentityShapeRefusal$ -fuzztime=100x -parallel=1\\n/spawn/worktree_isolation/validation/commands[10] => go test ./internal/canonicaljson -run=^$ -fuzz=^FuzzObservationEventRefusal$ -fuzztime=100x -parallel=1\\n/spawn/worktree_isolation/validation/commands[11] => go test ./internal/secconftest -run=^$ -fuzz=^FuzzCheckArgv$ -fuzztime=100x -parallel=1\\n/spawn/worktree_isolation/validation/commands[12] => go test ./internal/secconftest -run=^$ -fuzz=^FuzzCheckMemberPath$ -fuzztime=100x -parallel=1\\n/spawn/worktree_isolation/validation/commands[13] => go test ./internal/secconftest -run=^$ -fuzz=^FuzzIsEnvName$ -fuzztime=100x -parallel=1\\n/spawn/worktree_isolation/validation/commands[14] => go test ./internal/secconftest -run=^$ -fuzz=^FuzzRedactCorpus$ -fuzztime=100x -parallel=1\\n/spawn/worktree_isolation/validation/commands[15] => go test ./internal/secconftest -run=^$ -fuzz=^FuzzEscapeForTerminal$ -fuzztime=100x -parallel=1\\n/spawn/worktree_isolation/validation/commands[16] => go test ./internal/secconftest -run=^$ -fuzz=^FuzzRenderForTerminal$ -fuzztime=100x -parallel=1\\n/spawn/worktree_isolation/validation/commands[17] => go test ./internal/secconftest -run=^$ -fuzz=^FuzzGuardResolve$ -fuzztime=100x -parallel=1\\n/spawn/worktree_isolation/validation/commands[18] => go test ./internal/secconftest -run=^$ -fuzz=^FuzzDetectCaseCollision$ -fuzztime=100x -parallel=1\\n\",\n  \"original_output_bytes\": 2398,\n  \"original_output_tokens\": 600,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
