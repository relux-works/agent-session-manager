{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c529","stream":{"kind":"session","id":"01a0addc-f5a7-7d72-82bc-9d078a927129"},"sequence":239,"recorded_at":1780531400000473,"record_type":"event","durability":"durable","causation_id":"05ccea39-0df0-456b-a475-42ee00a3a1b7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"05ccea39-0df0-456b-a475-42ee00a3a1b7","run_stream":{"kind":"run","id":"05ccea39-0df0-456b-a475-42ee00a3a1b7"},"task_stream":{"kind":"task","id":"01a0addd-a32d-7f60-9c8d-5f0d10c7c3a9"},"task_id":"01a0addd-a32d-7f60-9c8d-5f0d10c7c3a9","event":{"kind":"output","task_id":"01a0addd-a32d-7f60-9c8d-5f0d10c7c3a9","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/TASK-260830-z1yxg9/preserved-before-credentials-260910/files/internal/rpcwire/envelope.go`.\n1|// Package rpcwire encodes and inspects untrusted Mesh RPC frames. Structural\n2|// validity and correlation are never authentication, handshake completion or\n3|// permission to dispatch. No connection, responder or operation executor lives\n4|// here. The eventual bilateral admission consumer must supply those boundaries.\n5|package rpcwire\n6|\n7|import (\n8|\t\"bytes\"\n9|\t\"encoding/json\"\n10|\t\"errors\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/sshtransport\"\n16|)\n17|\n18|const Protocol = \"urn:ax:protocol:rpc\"\n19|const MaxLineBytes = sshtransport.MaxLineBytes\n20|const MinObjectBytes = 5 * 1024 * 1024\n21|\n22|var (\n23|\tErrFrame       = errors.New(\"invalid RPC frame\")\n24|\tErrVersion     = errors.New(\"unsupported RPC wire version\")\n25|\tErrCorrelation = errors.New(\"RPC response does not match request\")\n26|\tErrHello       = errors.New(\"incompatible RPC hello structure\")\n27|\tErrInventory   = errors.New(\"invalid RPC inventory structure\")\n28|)\n29|\n30|// Request retains an isolated envelope. Body bytes for operations other than\n31|// hello and inventory.roots are opaque: their operation owners must validate\n32|// them. A zero Request cannot be encoded or used as a response expectation.\n33|type Request struct {\n34|\tversion, id, operation string\n35|\tbody                   json.RawMessage\n36|}\n37|\n38|func (r Request) Version() string       { return r.version }\n39|func (r Request) ID() string            { return r.id }\n40|func (r Request) Operation() string     { return r.operation }\n41|func (r Request) Body() json.RawMessage { return bytes.Clone(r.body) }\n42|\n43|// Response is correlated but still untrusted. A success body has the same\n44|// operation-validation bounds as Request. A failure uses the containing major's\n45|// static Structured Error binding, never a version supplied by its body.\n46|type Response struct {\n47|\trequest Request\n48|\tbody    json.RawMessage\n49|\tfailure *axerror.Error\n50|}\n51|\n52|func (r Response) OK() bool                { return r.failure == nil && r.body != nil }\n53|func (r Response) Body() json.RawMessage   { return bytes.Clone(r.body) }\n54|func (r Response) Failure() *axerror.Error { return r.failure }\n55|\n56|func major(version string) (int, error) {\n57|\tswitch version {\n58|\tcase \"2.0.0\":\n59|\t\treturn 2, nil\n60|\tcase \"3.0.0\":\n61|\t\treturn 3, nil\n62|\tcase \"4.0.0\":\n63|\t\treturn 4, nil\n64|\tdefault:\n65|\t\treturn 0, ErrVersion\n66|\t}\n67|}\n68|\n69|// object refuses duplicate members, non-integral numbers and other\n70|// non-I-JSON input using the existing common data-model owner. Keep original\n71|// bytes; canonicalization must not launder invalid numeric lexical forms.\n72|func object(data []byte) (map[string]json.RawMessage, error) {\n73|\tif _, err := canonicaljson.Canonicalize(data); err != nil {\n74|\t\treturn nil, ErrFrame\n75|\t}\n76|\tvar m map[string]json.RawMessage\n77|\tif json.Unmarshal(data, &m) != nil || m == nil {\n78|\t\treturn nil, ErrFrame\n79|\t}\n80|\treturn m, nil\n81|}\n82|func exact(m map[string]json.RawMessage, keys ...string) bool {\n83|\tif len(m) != len(keys) {\n84|\t\treturn false\n85|\t}\n86|\tfor _, k := range keys {\n87|\t\tif _, ok := m[k]; !ok {\n88|\t\t\treturn false\n89|\t\t}\n90|\t}\n91|\treturn true\n92|}\n93|func stringValue(raw json.RawMessage) string {\n94|\tvar value string\n95|\tif json.Unmarshal(raw, &value) != nil {\n96|\t\treturn \"\"\n97|\t}\n98|\treturn value\n99|}\n100|func envelope(data []byte) (map[string]json.RawMessage, string, string, error) {\n101|\tif len(data) == 0 || len(data) > MaxLineBytes || bytes.ContainsAny(data, \"\\n\") {\n102|\t\treturn nil, \"\", \"\", ErrFrame\n103|\t}\n104|\tm, err := object(data)\n105|\tif err != nil {\n106|\t\treturn nil, \"\", \"\", err\n107|\t}\n108|\tif stringValue(m[\"protocol\"]) != Protocol {\n109|\t\treturn nil, \"\", \"\", ErrFrame\n110|\t}\n111|\tversion := stringValue(m[\"protocol_version\"])\n112|\tif !semver.MatchString(version) {\n113|\t\treturn nil, \"\", \"\", ErrFrame\n114|\t}\n115|\tif _, err = major(version); err != nil {\n116|\t\treturn nil, \"\", \"\", err\n117|\t}\n118|\tid := stringValue(m[\"request_id\"])\n119|\tif _, err = scalar.ParseUUIDv7(id); err != nil {\n120|\t\treturn nil, \"\", \"\", ErrFrame\n121|\t}\n122|\treturn m, version, id, nil\n123|}\n124|\n125|// DecodeRequest inspects one LF-free line, as returned by SSH Session.Receive.\n126|// It never marks a hello successful or opens an operation-dispatch path.\n127|func DecodeRequest(line []byte) (Request, error) {\n128|\tm, version, id, err := envelope(line)\n129|\tif err != nil {\n130|\t\treturn Request{}, err\n131|\t}\n132|\tif !exact(m, \"protocol\", \"protocol_version\", \"request_id\", \"operation\", \"body\") {\n133|\t\treturn Request{}, ErrFrame\n134|\t}\n135|\top := stringValue(m[\"operation\"])\n136|\tif op == \"\" {\n137|\t\treturn Request{}, ErrFrame\n138|\t}\n139|\tif _, err = object(m[\"body\"]); err != nil {\n140|\t\treturn Request{}, err\n141|\t}\n142|\tif op == \"hello\" {\n143|\t\t_, err = decodeHello(version, m[\"body\"], false)\n144|\t}\n145|\tif op == \"inventory.roots\" {\n146|\t\t_, err = decodeNamespaces(version, m[\"body\"])\n147|\t}\n148|\tif err != nil {\n149|\t\treturn Request{}, err\n150|\t}\n151|\treturn Request{version, id, op, bytes.Clone(m[\"body\"])}, nil\n152|}\n153|\n154|// EncodeRequest validates the same structural surface as DecodeRequest and\n155|// returns one line without LF for SSH Session.Send. It does not send it.\n156|func EncodeRequest(version, id, operation string, body json.RawMessage) ([]byte, error) {\n157|\tline, err := json.Marshal(map[string]any{\"protocol\": Protocol, \"protocol_version\": version, \"request_id\": id, \"operation\": operation, \"body\": body})\n158|\tif err != nil {\n159|\t\treturn nil, ErrFrame\n160|\t}\n161|\tif _, err = DecodeRequest(line); err != nil {\n162|\t\treturn nil, err\n163|\t}\n164|\treturn line, nil\n165|}\n166|\n167|// DecodeResponse compares identity/version before examining the success or\n168|// error payload. It does not consume a pending request or provide replay\n169|// protection; connection sequencing remains the admission consumer's job.\n170|func DecodeResponse(line []byte, request Request) (Response, error) {\n171|\tif request.id == \"\" {\n172|\t\treturn Response{}, ErrCorrelation\n173|\t}\n174|\tm, version, id, err := envelope(line)\n175|\tif err != nil {\n176|\t\treturn Response{}, err\n177|\t}\n178|\tif version != request.version {\n179|\t\treturn Response{}, ErrVersion\n180|\t}\n181|\tif id != request.id {\n182|\t\treturn Response{}, ErrCorrelation\n183|\t}\n184|\tswitch string(m[\"ok\"]) {\n185|\tcase \"true\":\n186|\t\tif !exact(m, \"protocol\", \"protocol_version\", \"request_id\", \"ok\", \"body\") {\n187|\t\t\treturn Response{}, ErrFrame\n188|\t\t}\n189|\t\tif _, err = object(m[\"body\"]); err != nil {\n190|\t\t\treturn Response{}, err\n191|\t\t}\n192|\t\tif request.operation == \"hello\" {\n193|\t\t\tvar h Hello\n194|\t\t\th, err = decodeHello(version, m[\"body\"], true)\n195|\t\t\tif err == nil {\n196|\t\t\t\tsent, _ := request.Hello()\n197|\t\t\t\tif h.NonceEcho != sent.Nonce {\n198|\t\t\t\t\terr = ErrCorrelation\n199|\t\t\t\t}\n200|\t\t\t}\n201|\t\t}\n202|\t\tif request.operation == \"inventory.roots\" {\n203|\t\t\terr = validateRoots(version, m[\"body\"], request.body)\n204|\t\t}\n205|\t\tif err != nil {\n206|\t\t\treturn Response{}, err\n207|\t\t}\n208|\t\treturn Response{request: request, body: bytes.Clone(m[\"body\"])}, nil\n209|\tcase \"false\":\n210|\t\tif !exact(m, \"protocol\", \"protocol_version\", \"request_id\", \"ok\", \"error\") {\n211|\t\t\treturn Response{}, ErrFrame\n212|\t\t}\n213|\t\tn, _ := major(version)\n214|\t\tfailure, err := axerror.DecodeBound(axerror.ContainingContract{ID: Protocol, Major: n}, m[\"error\"])\n215|\t\tif err != nil {\n216|\t\t\treturn Response{}, err\n217|\t\t}\n218|\t\treturn Response{request: request, failure: failure}, nil\n219|\tdefault:\n220|\t\treturn Response{}, ErrFrame\n221|\t}\n222|}\n223|\n224|func EncodeSuccess(request Request, body json.RawMessage) ([]byte, error) {\n225|\treturn encodeResponse(request, true, \"body\", body)\n226|}\n227|func EncodeFailure(request Request, failure *axerror.Error) ([]byte, error) {\n228|\treturn encodeResponse(request, false, \"error\", failure)\n229|}\n230|func encodeResponse(request Request, ok bool, key string, payload any) ([]byte, error) {\n231|\tline, err := json.Marshal(map[string]any{\"protocol\": Protocol, \"protocol_version\": request.version, \"request_id\": request.id, \"ok\": ok, key: payload})\n232|\tif err != nil {\n233|\t\treturn nil, ErrFrame\n234|\t}\n235|\tif _, err = DecodeResponse(line, request); err != nil {\n236|\t\treturn nil, err\n237|\t}\n238|\treturn line, nil\n239|}\n240|\n241|// EncodeRejection frames a failure for a parseable supported-version request,\n242|// even when its operation or body is invalid (Section 15.1 bootstrap framing).\n243|// Missing/invalid protocol, version or request ID and unparseable lines return\n244|// no frame. This only encodes bytes: the eventual responder must choose the\n245|// correct failure and close after its one pre-handshake rejection. It never\n246|// returns a Request that could be mistaken for a validated hello.\n247|func EncodeRejection(line []byte, failure *axerror.Error) ([]byte, error) {\n248|\tm, version, id, err := envelope(line)\n249|\tif err != nil {\n250|\t\treturn nil, err\n251|\t}\n252|\t// A response or arbitrary object is not a request to which we may reply.\n253|\tif _, ok := m[\"operation\"]; !ok {\n254|\t\treturn nil, ErrFrame\n255|\t}\n256|\treturn EncodeFailure(Request{version: version, id: id}, failure)\n257|}","final_result":true}}}
