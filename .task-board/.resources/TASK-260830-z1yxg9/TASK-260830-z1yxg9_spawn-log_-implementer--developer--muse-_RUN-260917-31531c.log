{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c575","stream":{"kind":"session","id":"01a0addc-f5a7-7d72-82bc-9d078a927129"},"sequence":277,"recorded_at":1780531400000549,"record_type":"event","durability":"durable","causation_id":"05ccea39-0df0-456b-a475-42ee00a3a1b7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"05ccea39-0df0-456b-a475-42ee00a3a1b7","run_stream":{"kind":"run","id":"05ccea39-0df0-456b-a475-42ee00a3a1b7"},"call_id":"call_01a0adddaab373c88f8b5ad21c41be6d","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/TASK-260830-z1yxg9/preserved-before-credentials-260910/files/internal/rpcwire/envelope_test.go`.\n1|package rpcwire_test\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/base64\"\n6|\t\"encoding/json\"\n7|\t\"errors\"\n8|\t\"fmt\"\n9|\t\"os\"\n10|\t\"slices\"\n11|\t\"strings\"\n12|\t\"testing\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/rpcwire\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n17|)\n18|\n19|const id = \"0198f4c8-a070-7188-9172-1234567890ab\"\n20|const otherID = \"0198f4c8-a070-7188-9172-2234567890ab\"\n21|\n22|func wire(t *testing.T, v any) []byte {\n23|\tt.Helper()\n24|\tb, e := json.Marshal(v)\n25|\tif e != nil {\n26|\t\tt.Fatal(e)\n27|\t}\n28|\treturn b\n29|}\n30|func fixture(t *testing.T, name string) map[string]any {\n31|\tt.Helper()\n32|\tb, e := os.ReadFile(\"testdata/\" + name + \".json\")\n33|\tif e != nil {\n34|\t\tt.Fatal(e)\n35|\t}\n36|\tvar m map[string]any\n37|\tif e = json.Unmarshal(b, &m); e != nil {\n38|\t\tt.Fatal(e)\n39|\t}\n40|\treturn m\n41|}\n42|func hello(t *testing.T, version string, response bool) map[string]any {\n43|\tname := \"hello-request-v2\"\n44|\tif response {\n45|\t\tname = \"hello-response-v2\"\n46|\t}\n47|\tm := fixture(t, name)\n48|\tm[\"protocol_version\"] = version\n49|\tif version != \"2.0.0\" {\n50|\t\tm[\"body\"].(map[string]any)[\"contracts\"] = fixture(t, \"contracts-v\"+version[:1])\n51|\t}\n52|\treturn m\n53|}\n54|func request(t *testing.T, m map[string]any) rpcwire.Request {\n55|\tt.Helper()\n56|\tr, e := rpcwire.DecodeRequest(wire(t, m))\n57|\tif e != nil {\n58|\t\tt.Fatal(e)\n59|\t}\n60|\treturn r\n61|}\n62|func TestPinnedHelloProfiles(t *testing.T) {\n63|\tfor _, v := range []string{\"2.0.0\", \"3.0.0\", \"4.0.0\"} {\n64|\t\tt.Run(v, func(t *testing.T) {\n65|\t\t\tq := hello(t, v, false)\n66|\t\t\tr := request(t, q)\n67|\t\t\tif r.ID() != id || r.Version() != v || r.Operation() != \"hello\" {\n68|\t\t\t\tt.Fatal(\"wrong envelope\")\n69|\t\t\t}\n70|\t\t\th, e := r.Hello()\n71|\t\t\tif e != nil {\n72|\t\t\t\tt.Fatal(e)\n73|\t\t\t}\n74|\t\t\tprofile, e := rpcwire.ContractProfile(v)\n75|\t\t\tif e != nil {\n76|\t\t\t\tt.Fatal(e)\n77|\t\t\t}\n78|\t\t\tif !bytes.Equal(wire(t, profile), wire(t, h.Contracts)) {\n79|\t\t\t\tt.Fatal(\"profile differs from normative fixture\")\n80|\t\t\t}\n81|\t\t\tencoded, e := rpcwire.EncodeRequest(v, id, \"hello\", r.Body())\n82|\t\t\tif e != nil {\n83|\t\t\t\tt.Fatal(e)\n84|\t\t\t}\n85|\t\t\tif !bytes.Equal(encoded, wire(t, q)) {\n86|\t\t\t\tt.Fatal(\"request fixture roundtrip\")\n87|\t\t\t}\n88|\t\t\tp := hello(t, v, true)\n89|\t\t\tresp, e := rpcwire.DecodeResponse(wire(t, p), r)\n90|\t\t\tif e != nil {\n91|\t\t\t\tt.Fatal(e)\n92|\t\t\t}\n93|\t\t\tif !resp.OK() || resp.Failure() != nil {\n94|\t\t\t\tt.Fatal(\"success shape\")\n95|\t\t\t}\n96|\t\t\tbody, e := resp.Hello()\n97|\t\t\tif e != nil || body.HostID == h.HostID {\n98|\t\t\t\tt.Fatal(\"response identity\")\n99|\t\t\t}\n100|\t\t\tencoded, e = rpcwire.EncodeSuccess(r, resp.Body())\n101|\t\t\tif e != nil || !bytes.Equal(encoded, wire(t, p)) {\n102|\t\t\t\tt.Fatal(\"response fixture roundtrip\", e)\n103|\t\t\t}\n104|\t\t\tlimits, e := rpcwire.OfferedLimits(r, resp)\n105|\t\t\tif e != nil || limits.LineBytes != 8388608 || limits.ObjectBytes != 5242880 {\n106|\t\t\t\tt.Fatal(limits, e)\n107|\t\t\t}\n108|\t\t\t// Copies are not live capability or identity handles.\n109|\t\t\th.Contracts[\"rpc\"][0] = \"9.0.0\"\n110|\t\t\tprofile[\"rpc\"][0] = \"8.0.0\"\n111|\t\t\tb := r.Body()\n112|\t\t\tb[0] = '!'\n113|\t\t\tb = resp.Body()\n114|\t\t\tb[0] = '!'\n115|\t\t\tif _, e = r.Hello(); e != nil {\n116|\t\t\t\tt.Fatal(\"request alias\", e)\n117|\t\t\t}\n118|\t\t\tif _, e = resp.Hello(); e != nil {\n119|\t\t\t\tt.Fatal(\"response alias\", e)\n120|\t\t\t}\n121|\t\t})\n122|\t}\n123|}\n124|func TestRequestRefusals(t *testing.T) {\n125|\ttests := []struct {\n126|\t\tname string\n127|\t\tedit func(map[string]any)\n128|\t}{\n129|\t\t{\"protocol\", func(m map[string]any) { m[\"protocol\"] = \"urn:other\" }},\n130|\t\t{\"missing-version\", func(m map[string]any) { delete(m, \"protocol_version\") }},\n131|\t\t{\"major\", func(m map[string]any) { m[\"protocol_version\"] = \"5.0.0\" }},\n132|\t\t{\"unknown-minor\", func(m map[string]any) { m[\"protocol_version\"] = \"2.1.0\" }},\n133|\t\t{\"uuid\", func(m map[string]any) { m[\"request_id\"] = \"0198f4c8-a070-4188-9172-1234567890ab\" }},\n134|\t\t{\"missing-id\", func(m map[string]any) { delete(m, \"request_id\") }},\n135|\t\t{\"extra\", func(m map[string]any) { m[\"extra\"] = true }},\n136|\t\t{\"case-alias\", func(m map[string]any) { m[\"Operation\"] = \"hello\"; delete(m, \"operation\") }},\n137|\t\t{\"null-operation\", func(m map[string]any) { m[\"operation\"] = nil }},\n138|\t\t{\"missing-body\", func(m map[string]any) { delete(m, \"body\") }},\n139|\t\t{\"array-body\", func(m map[string]any) { m[\"body\"] = []any{} }},\n140|\t}\n141|\tfor _, tt := range tests {\n142|\t\tt.Run(tt.name, func(t *testing.T) {\n143|\t\t\tm := hello(t, \"2.0.0\", false)\n144|\t\t\ttt.edit(m)\n145|\t\t\tif _, e := rpcwire.DecodeRequest(wire(t, m)); e == nil {\n146|\t\t\t\tt.Fatal(\"admitted invalid request\")\n147|\t\t\t}\n148|\t\t})\n149|\t}\n150|}\n151|func TestFrameRefusals(t *testing.T) {\n152|\tgood := wire(t, hello(t, \"2.0.0\", false))\n153|\ttests := map[string][]byte{\n154|\t\t\"duplicate\": append([]byte(`{\"protocol\":\"urn:other\",`), good[1:]...),\n155|\t\t\"newline\":   append(bytes.Clone(good), '\\n'), \"empty\": {}, \"null\": []byte(\"null\"),\n156|\t\t\"trailing\": append(bytes.Clone(good), []byte(\" {}\")...),\n157|\t\t\"utf8\":     bytes.Replace(good, []byte(\"macos\"), []byte{'m', 0xff}, 1),\n158|\t\t\"float\":    bytes.Replace(good, []byte(\"8388608\"), []byte(\"8388608.0\"), 1),\n159|\t\t\"oversize\": append(good, bytes.Repeat([]byte(\" \"), rpcwire.MaxLineBytes+1-len(good))...),\n160|\t}\n161|\tfor name, line := range tests {\n162|\t\tt.Run(name, func(t *testing.T) {\n163|\t\t\tif _, e := rpcwire.DecodeRequest(line); e == nil {\n164|\t\t\t\tt.Fatal(\"admitted invalid frame\")\n165|\t\t\t}\n166|\t\t})\n167|\t}\n168|\texact := append(bytes.Clone(good), bytes.Repeat([]byte(\" \"), rpcwire.MaxLineBytes-len(good))...)\n169|\tif _, e := rpcwire.DecodeRequest(exact); e != nil {\n170|\t\tt.Fatal(\"exact line boundary\", e)\n171|\t}\n172|\tif _, e := rpcwire.DecodeRequest(append(good, '\\r')); e != nil {\n173|\t\tt.Fatal(\"CRLF transport compatibility\", e)\n174|\t}\n175|}\n176|func TestHelloRefusals(t *testing.T) {\n177|\ttests := []struct {\n178|\t\tname string\n179|\t\tedit func(map[string]any)\n180|\t}{\n181|\t\t{\"host\", func(b map[string]any) { b[\"host_id\"] = otherID[:8] }},\n182|\t\t{\"platform\", func(b map[string]any) { b[\"platform\"] = \"ios\" }},\n183|\t\t{\"ax-version\", func(b map[string]any) { b[\"ax_version\"] = \"01.0.0\" }},\n184|\t\t{\"nonce-short\", func(b map[string]any) { b[\"nonce\"] = base64.RawURLEncoding.EncodeToString(make([]byte, 15)) }},\n185|\t\t{\"nonce-padding\", func(b map[string]any) { b[\"nonce\"] = \"YWJjZGVmZ2hpamtsbW5vcA==\" }},\n186|\t\t{\"nonce-pad-bits\", func(b map[string]any) { b[\"nonce\"] = \"YWJjZGVmZ2hpamtsbW5vcB\" }},\n187|\t\t{\"line-floor\", func(b map[string]any) { b[\"max_line_bytes\"] = 8388607 }},\n188|\t\t{\"object-floor\", func(b map[string]any) { b[\"max_object_bytes\"] = 5242879 }},\n189|\t\t{\"null-limit\", func(b map[string]any) { b[\"max_line_bytes\"] = nil }},\n190|\t\t{\"extra-body\", func(b map[string]any) { b[\"extra\"] = true }},\n191|\t\t{\"request-echo\", func(b map[string]any) { b[\"nonce_echo\"] = b[\"nonce\"] }},\n192|\t\t{\"error-key\", func(b map[string]any) { b[\"contracts\"].(map[string]any)[\"error\"] = []string{\"1.0.0\"} }},\n193|\t\t{\"missing-key\", func(b map[string]any) { delete(b[\"contracts\"].(map[string]any), \"lease\") }},\n194|\t\t{\"replace-key\", func(b map[string]any) {\n195|\t\t\tc := b[\"contracts\"].(map[string]any)\n196|\t\t\tdelete(c, \"lease\")\n197|\t\t\tc[\"config\"] = []string{\"1.0.0\"}\n198|\t\t}},\n199|\t\t{\"empty-versions\", func(b map[string]any) { b[\"contracts\"].(map[string]any)[\"lease\"] = []string{} }},\n200|\t\t{\"duplicate-versions\", func(b map[string]any) { b[\"contracts\"].(map[string]any)[\"lease\"] = []string{\"1.0.0\", \"1.0.0\"} }},\n201|\t\t{\"unsorted-versions\", func(b map[string]any) { b[\"contracts\"].(map[string]any)[\"lease\"] = []string{\"2.0.0\", \"1.0.0\"} }},\n202|\t\t{\"invalid-version\", func(b map[string]any) { b[\"contracts\"].(map[string]any)[\"lease\"] = []string{\"v1.0.0\"} }},\n203|\t\t{\"seventeen-versions\", func(b map[string]any) {\n204|\t\t\tvs := []string{}\n205|\t\t\tfor i := 0; i < 17; i++ {\n206|\t\t\t\tvs = append(vs, fmt.Sprintf(\"1.%d.0\", i))\n207|\t\t\t}\n208|\t\t\tslices.Sort(vs)\n209|\t\t\tb[\"contracts\"].(map[string]any)[\"lease\"] = vs\n210|\t\t}},\n211|\t}\n212|\tfor _, tt := range tests {\n213|\t\tt.Run(tt.name, func(t *testing.T) {\n214|\t\t\tm := hello(t, \"2.0.0\", false)\n215|\t\t\ttt.edit(m[\"body\"].(map[string]any))\n216|\t\t\tif _, e := rpcwire.DecodeRequest(wire(t, m)); e == nil {\n217|\t\t\t\tt.Fatal(\"admitted invalid hello\")\n218|\t\t\t}\n219|\t\t})\n220|\t}\n221|\tfor _, v := range []string{\"3.0.0\", \"4.0.0\"} {\n222|\t\tt.Run(\"exact-map-\"+v, func(t *testing.T) {\n223|\t\t\tm := hello(t, v, false)\n224|\t\t\tm[\"body\"].(map[string]any)[\"contracts\"].(map[string]any)[\"lease\"] = []string{\"1.0.0\", \"1.1.0\"}\n225|\t\t\tif _, e := rpcwire.DecodeRequest(wire(t, m)); e == nil {\n226|\t\t\t\tt.Fatal(\"nonexact map\")\n227|\t\t\t}\n228|\t\t})\n229|\t}\n230|}\n231|func TestResponseRefusals(t *testing.T) {\n232|\tr := request(t, hello(t, \"2.0.0\", false))\n233|\ttests := []struct {\n234|\t\tname string\n235|\t\tedit func(map[string]any)\n236|\t}{\n237|\t\t{\"id\", func(m map[string]any) { m[\"request_id\"] = otherID }},\n238|\t\t{\"version\", func(m map[string]any) { m[\"protocol_version\"] = \"3.0.0\"; m[\"body\"] = hello(t, \"3.0.0\", true)[\"body\"] }},\n239|\t\t{\"major-before-error\", func(m map[string]any) {\n240|\t\t\tm[\"protocol_version\"] = \"5.0.0\"\n241|\t\t\tm[\"ok\"] = false\n242|\t\t\tm[\"error\"] = map[string]any{\"retryable\": true, \"code\": \"anything\"}\n243|\t\t}},\n244|\t\t{\"nonce-echo\", func(m map[string]any) { m[\"body\"].(map[string]any)[\"nonce_echo\"] = \"cXJzdHV2d3h5ejAxMjM0NQ\" }},\n245|\t\t{\"missing-echo\", func(m map[string]any) { delete(m[\"body\"].(map[string]any), \"nonce_echo\") }},\n246|\t\t{\"response-nonce\", func(m map[string]any) { m[\"body\"].(map[string]any)[\"nonce\"] = \"bad\" }},\n247|\t\t{\"ok-null\", func(m map[string]any) { m[\"ok\"] = nil }},\n248|\t\t{\"ok-string\", func(m map[string]any) { m[\"ok\"] = \"true\" }},\n249|\t\t{\"success-error\", func(m map[string]any) { m[\"error\"] = nil }},\n250|\t\t{\"failure-body\", func(m map[string]any) { m[\"ok\"] = false; m[\"error\"] = nil }},\n251|\t\t{\"body-null\", func(m map[string]any) { m[\"body\"] = nil }},\n252|\t}\n253|\tfor _, tt := range tests {\n254|\t\tt.Run(tt.name, func(t *testing.T) {\n255|\t\t\tm := hello(t, \"2.0.0\", true)\n256|\t\t\ttt.edit(m)\n257|\t\t\t_, e := rpcwire.DecodeResponse(wire(t, m), r)\n258|\t\t\tif e == nil {\n259|\t\t\t\tt.Fatal(\"admitted invalid response\")\n260|\t\t\t}\n261|\t\t\tif tt.name == \"major-before-error\" && !errors.Is(e, rpcwire.ErrVersion) {\n262|\t\t\t\tt.Fatal(\"read foreign payload\", e)\n263|\t\t\t}\n264|\t\t})\n265|\t}\n266|\tif _, e := rpcwire.DecodeResponse(wire(t, hello(t, \"2.0.0\", true)), rpcwire.Request{}); e == nil {\n267|\t\tt.Fatal(\"zero expectation\")\n268|\t}\n269|\tif _, e := rpcwire.EncodeSuccess(r, json.RawMessage(`null`)); e == nil {\n270|\t\tt.Fatal(\"encoded null\")\n271|\t}\n272|}\n273|func TestHistoricalFailureBindings(t *testing.T) {\n274|\tfor i, v := range []string{\"2.0.0\", \"3.0.0\", \"4.0.0\"} {\n275|\t\tt.Run(v, func(t *testing.T) {\n276|\t\t\tr := request(t, hello(t, v, false))\n277|\t\t\tbound := []axerror.Version{axerror.Version100, axerror.Version120, axerror.Version130}[i]\n278|\t\t\tf, e := axerror.New(axerror.Spec{Version: bound, Code: \"incompatible_protocol\", Message: \"incompatible\", Details: axerror.Details{}, IDs: axerror.NoIDs(), Cause: errors.New(\"secret cause\")})\n279|\t\t\tif e != nil {\n280|\t\t\t\tt.Fatal(e)\n281|\t\t\t}\n282|\t\t\tline, e := rpcwire.EncodeFailure(r, f)\n283|\t\t\tif e != nil {\n284|\t\t\t\tt.Fatal(e)\n285|\t\t\t}\n286|\t\t\tif bytes.Contains(line, []byte(\"secret cause\")) || bytes.Contains(line, []byte(`\"body\"`)) {\n287|\t\t\t\tt.Fatal(\"failure leak/shape\")\n288|\t\t\t}\n289|\t\t\tresp, e := rpcwire.DecodeResponse(line, r)\n290|\t\t\tif e != nil || resp.OK() || resp.Failure().Version() != bound {\n291|\t\t\t\tt.Fatal(resp, e)\n292|\t\t\t}\n293|\t\t\tfor _, wrong := range []axerror.Version{axerror.Version100, axerror.Version110, axerror.Version120, axerror.Version130} {\n294|\t\t\t\tif wrong == bound {\n295|\t\t\t\t\tcontinue\n296|\t\t\t\t}\n297|\t\t\t\tf, e = axerror.New(axerror.Spec{Version: wrong, Code: \"incompatible_protocol\", Message: \"wrong\", Details: axerror.Details{}})\n298|\t\t\t\tif e != nil {\n299|\t\t\t\t\tt.Fatal(e)\n300|\t\t\t\t}\n301|\t\t\t\tif _, e = rpcwire.EncodeFailure(r, f); e == nil {\n302|\t\t\t\t\tt.Fatal(\"wrong historical binding\")\n303|\t\t\t\t}\n304|\t\t\t}\n305|\t\t\tif _, e = rpcwire.EncodeFailure(r, nil); e == nil {\n306|\t\t\t\tt.Fatal(\"nil failure\")\n307|\t\t\t}\n308|\t\t})\n309|\t}\n310|}\n311|func TestLimitsAndUntrustedIsolation(t *testing.T) {\n312|\tq := hello(t, \"2.0.0\", false)\n313|\tb := q[\"body\"].(map[string]any)\n314|\tb[\"max_line_bytes\"] = 10 * 1024 * 1024\n315|\tb[\"max_object_bytes\"] = 7 * 1024 * 1024\n316|\tvs := []string{}\n317|\tfor i := 0; i < 16; i++ {\n318|\t\tvs = append(vs, fmt.Sprintf(\"1.%d.0\", i))\n319|\t}\n320|\tslices.Sort(vs)\n321|\tb[\"contracts\"].(map[string]any)[\"lease\"] = vs\n322|\tr := request(t, q)\n323|\tp := hello(t, \"2.0.0\", true)\n324|\tp[\"body\"].(map[string]any)[\"max_object_bytes\"] = 6 * 1024 * 1024\n325|\tresp, e := rpcwire.DecodeResponse(wire(t, p), r)\n326|\tif e != nil {\n327|\t\tt.Fatal(e)\n328|\t}\n329|\tlimits, e := rpcwire.OfferedLimits(r, resp)\n330|\tif e != nil || limits.LineBytes != 8388608 || limits.ObjectBytes != 6*1024*1024 {\n331|\t\tt.Fatal(limits, e)\n332|\t}\n333|\tq[\"request_id\"] = otherID\n334|\tr2 := request(t, q)\n335|\tif _, e = rpcwire.OfferedLimits(r2, resp); e == nil {\n336|\t\tt.Fatal(\"cross-request limits\")\n337|\t}\n338|\t// No authentication claim: arbitrary structurally valid claimed host is retained.\n339|\tb[\"host_id\"] = otherID\n340|\tr = request(t, q)\n341|\th, e := r.Hello()\n342|\tif e != nil || h.HostID != otherID {\n343|\t\tt.Fatal(\"untrusted host retention\")\n344|\t}\n345|\tn := rpcwire.NewNonce()\n346|\tdecoded, e := base64.RawURLEncoding.DecodeString(n)\n347|\tif e != nil || len(decoded) != 32 {\n348|\t\tt.Fatal(\"nonce generation\")\n349|\t}\n350|\tif _, e = rpcwire.ContractProfile(\"5.0.0\"); e == nil {\n351|\t\tt.Fatal(\"unknown profile\")\n352|\t}\n353|\tif _, e = rpcwire.Namespaces(\"5.0.0\"); e == nil {\n354|\t\tt.Fatal(\"unknown namespace profile\")\n355|\t}\n356|}\n357|func TestInventoryNamespacesAndCardinality(t *testing.T) {\n358|\tfor _, v := range []string{\"2.0.0\", \"3.0.0\", \"4.0.0\"} {\n359|\t\tt.Run(v, func(t *testing.T) {\n360|\t\t\tnames, e := rpcwire.Namespaces(v)\n361|\t\t\tif e != nil {\n362|\t\t\t\tt.Fatal(e)\n363|\t\t\t}\n364|\t\t\tif len(names) != int(v[0]-'0')+4 {\n365|\t\t\t\tt.Fatal(\"wrong cardinality\")\n366|\t\t\t}\n367|\t\t\tq := map[string]any{\"protocol\": rpcwire.Protocol, \"protocol_version\": v, \"request_id\": id, \"operation\": \"inventory.roots\", \"body\": map[string]any{\"namespaces\": names}}\n368|\t\t\tr := request(t, q)\n369|\t\t\troots := []any{}\n370|\t\t\tfor _, name := range names {\n371|\t\t\t\troots = append(roots, map[string]any{\"namespace\": name, \"count\": 0, \"root_id\": \"sha256:\" + strings.Repeat(\"0\", 64)})\n372|\t\t\t}\n373|\t\t\tif _, e = rpcwire.EncodeSuccess(r, wire(t, map[string]any{\"roots\": roots})); e != nil {\n374|\t\t\t\tt.Fatal(e)\n375|\t\t\t}\n376|\t\t\tfor _, bad := range [][]string{{}, {\"blob\", \"blob\"}, {\"event\", \"blob\"}, {\"credential\"}, append(slices.Clone(names), \"zzz\")} {\n377|\t\t\t\tq[\"body\"] = map[string]any{\"namespaces\": bad}\n378|\t\t\t\tif _, e = rpcwire.DecodeRequest(wire(t, q)); e == nil {\n379|\t\t\t\t\tt.Fatal(\"invalid namespaces\", bad)\n380|\t\t\t\t}\n381|\t\t\t}\n382|\t\t\tfor name, bad := range map[string]any{\"missing\": roots[:len(roots)-1], \"extra\": append(slices.Clone(roots), roots[0]), \"null\": nil} {\n383|\t\t\t\tt.Run(name, func(t *testing.T) {\n384|\t\t\t\t\tif _, e = rpcwire.EncodeSuccess(r, wire(t, map[string]any{\"roots\": bad})); e == nil {\n385|\t\t\t\t\t\tt.Fatal(\"invalid cardinality\")\n386|\t\t\t\t\t}\n387|\t\t\t\t})\n388|\t\t\t}\n389|\t\t\troot := roots[0].(map[string]any)\n390|\t\t\tfor _, field := range []string{\"namespace\", \"count\", \"root_id\"} {\n391|\t\t\t\told := root[field]\n392|\t\t\t\troot[field] = nil\n393|\t\t\t\tif _, e = rpcwire.EncodeSuccess(r, wire(t, map[string]any{\"roots\": roots})); e == nil {\n394|\t\t\t\t\tt.Fatal(\"null root field\", field)\n395|\t\t\t\t}\n396|\t\t\t\troot[field] = old\n397|\t\t\t}\n398|\t\t\troot[\"namespace\"] = \"event\"\n399|\t\t\tif _, e = rpcwire.EncodeSuccess(r, wire(t, map[string]any{\"roots\": roots})); e == nil {\n400|\t\t\t\tt.Fatal(\"wrong namespace\")\n401|\t\t\t}\n402|\t\t\troot[\"namespace\"] = names[0]\n403|\t\t\troot[\"extra\"] = true\n404|\t\t\tif _, e = rpcwire.EncodeSuccess(r, wire(t, map[string]any{\"roots\": roots})); e == nil {\n405|\t\t\t\tt.Fatal(\"extra root field\")\n406|\t\t\t}\n407|\t\t\tdelete(root, \"extra\")\n408|\t\t\troot[\"count\"] = scalar.MaxUint53\n409|\t\t\tif _, e = rpcwire.EncodeSuccess(r, wire(t, map[string]any{\"roots\": roots})); e != nil {\n410|\t\t\t\tt.Fatal(\"uint53 max\", e)\n411|\t\t\t}\n412|\t\t\troot[\"count\"] = scalar.MaxUint53 + 1\n413|\t\t\tif _, e = rpcwire.EncodeSuccess(r, wire(t, map[string]any{\"roots\": roots})); e == nil {\n414|\t\t\t\tt.Fatal(\"uint53 overflow\")\n415|\t\t\t}\n416|\t\t\t// An explicit one-namespace subset is valid in every major; it is not a\n417|\t\t\t// complete inventory and is never reported as one by this codec.\n418|\t\t\tq[\"body\"] = map[string]any{\"namespaces\": []string{\"blob\"}}\n419|\t\t\tr = request(t, q)\n420|\t\t\tif _, e = rpcwire.EncodeSuccess(r, []byte(`{\"roots\":[{\"namespace\":\"blob\",\"count\":0,\"root_id\":\"sha256:`+strings.Repeat(\"0\", 64)+`\"}]}`)); e != nil {\n421|\t\t\t\tt.Fatal(e)\n422|\t\t\t}\n423|\t\t})\n424|\t}\n425|}\n426|func TestOpaqueOperationBoundary(t *testing.T) {\n427|\tbody := json.RawMessage(`{\"extensions\":{\"vendor.example\":{\"future\":\"retained\"}}}`)\n428|\tline, e := rpcwire.EncodeRequest(\"2.0.0\", id, \"future.operation\", body)\n429|\tif e != nil {\n430|\t\tt.Fatal(e)\n431|\t}\n432|\tr, e := rpcwire.DecodeRequest(line)\n433|\tif e != nil || !bytes.Equal(r.Body(), body) {\n434|\t\tt.Fatal(\"opaque body altered\", e)\n435|\t}\n436|\tif _, e = r.Hello(); e == nil {\n437|\t\tt.Fatal(\"opaque operation is not hello\")\n438|\t}\n439|\tif _, e = rpcwire.EncodeSuccess(r, body); e != nil {\n440|\t\tt.Fatal(e)\n441|\t}\n442|\tif _, e = rpcwire.EncodeRequest(\"2.0.0\", id, \"future.operation\", []byte(\"{\")); e == nil {\n443|\t\tt.Fatal(\"malformed outbound\")\n444|\t}\n445|}\n446|\n447|func TestBootstrapRejectionFraming(t *testing.T) {\n448|\tf, e := axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"incompatible_protocol\", Message: \"hello required\", Details: axerror.Details{}})\n449|\tif e != nil {\n450|\t\tt.Fatal(e)\n451|\t}\n452|\texpectation := request(t, hello(t, \"2.0.0\", false))\n453|\tfor _, kind := range []string{\"non-hello\", \"missing-contract\", \"invalid-body\"} {\n454|\t\tt.Run(kind, func(t *testing.T) {\n455|\t\t\tm := hello(t, \"2.0.0\", false)\n456|\t\t\tswitch kind {\n457|\t\t\tcase \"non-hello\":\n458|\t\t\t\tm[\"operation\"] = \"health.get\"\n459|\t\t\t\tm[\"body\"] = map[string]any{}\n460|\t\t\tcase \"missing-contract\":\n461|\t\t\t\tdelete(m[\"body\"].(map[string]any)[\"contracts\"].(map[string]any), \"lease\")\n462|\t\t\tcase \"invalid-body\":\n463|\t\t\t\tm[\"body\"] = nil\n464|\t\t\t}\n465|\t\t\tline, e := rpcwire.EncodeRejection(wire(t, m), f)\n466|\t\t\tif e != nil {\n467|\t\t\t\tt.Fatal(e)\n468|\t\t\t}\n469|\t\t\tresult, e := rpcwire.DecodeResponse(line, expectation)\n470|\t\t\tif e != nil || result.OK() || result.Failure().Version() != axerror.Version100 {\n471|\t\t\t\tt.Fatal(\"bootstrap failure\", e)\n472|\t\t\t}\n473|\t\t})\n474|\t}\n475|\tfor _, kind := range []string{\"major\", \"protocol\", \"id\", \"json\", \"oversize\", \"response\"} {\n476|\t\tt.Run(kind, func(t *testing.T) {\n477|\t\t\tm := hello(t, \"2.0.0\", false)\n478|\t\t\tswitch kind {\n479|\t\t\tcase \"major\":\n480|\t\t\t\tm[\"protocol_version\"] = \"5.0.0\"\n481|\t\t\tcase \"protocol\":\n482|\t\t\t\tdelete(m, \"protocol\")\n483|\t\t\tcase \"id\":\n484|\t\t\t\tdelete(m, \"request_id\")\n485|\t\t\tcase \"response\":\n486|\t\t\t\tdelete(m, \"operation\")\n487|\t\t\t}\n488|\t\t\tb := wire(t, m)\n489|\t\t\tif kind == \"json\" {\n490|\t\t\t\tb = []byte(\"{\")\n491|\t\t\t}\n492|\t\t\tif kind == \"oversize\" {\n493|\t\t\t\tb = append(b, bytes.Repeat([]byte(\" \"), rpcwire.MaxLineBytes+1-len(b))...)\n494|\t\t\t}\n495|\t\t\tb, e = rpcwire.EncodeRejection(b, f)\n496|\t\t\tif e == nil || b != nil {\n497|\t\t\t\tt.Fatal(\"unframeable rejection emitted\", e)\n498|\t\t\t}\n499|\t\t})\n500|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
