rr, net.ErrClosed) {\n+\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n+\t}\n+\treturn fmt.Errorf(\"%w: %w\", ErrAuthenticationFailed, err)\n+}\n","edit_facts":{"tool_name":"edit_file","path":"internal/hostchannel/channel.go","added":24,"removed":16},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
