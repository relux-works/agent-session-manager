{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d9a9","stream":{"kind":"session","id":"01a0addc-f5a7-7d72-82bc-9d078a927129"},"sequence":2863,"recorded_at":1780531400005721,"record_type":"event","durability":"durable","causation_id":"05ccea39-0df0-456b-a475-42ee00a3a1b7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"05ccea39-0df0-456b-a475-42ee00a3a1b7","run_stream":{"kind":"run","id":"05ccea39-0df0-456b-a475-42ee00a3a1b7"},"task_stream":{"kind":"task","id":"01a0adfd-74dd-7183-b569-814c145afc9e"},"task_id":"01a0adfd-74dd-7183-b569-814c145afc9e","event":{"kind":"output","task_id":"01a0adfd-74dd-7183-b569-814c145afc9e","chunk":"edited\nchanged lines: lines 762-803\n--- original\n+++ updated\n@@\n-func TestHandshakeByteCapEndToEnd(t *testing.T) {\n-\tf := newFixture(t)\n-\tkey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)\n-\tif err != nil {\n-\t\tt.Fatalf(\"GenerateKey: %v\", err)\n-\t}\n-\tchain := [][]byte{f.issuedA.LeafDER}\n-\tfiller := bytes.Repeat([]byte{0xAB}, 4096)\n-\tfor total := len(f.issuedA.LeafDER); total <= hostchannel.MaxHandshakeBytes; {\n-\t\ttemplate := &x509.Certificate{\n-\t\t\tSerialNumber:          big.NewInt(int64(len(chain))),\n-\t\t\tSubject:               pkix.Name{CommonName: \"filler\"},\n-\t\t\tNotBefore:             time.Now().Add(-time.Hour),\n-\t\t\tNotAfter:              time.Now().Add(time.Hour),\n-\t\t\tKeyUsage:              x509.KeyUsageDigitalSignature,\n-\t\t\tBasicConstraintsValid: true,\n-\t\t\tExtraExtensions: []pkix.Extension{{\n-\t\t\t\tId:    asn1.ObjectIdentifier{1, 2, 3, 4, 5},\n-\t\t\t\tValue: filler,\n-\t\t\t}},\n-\t\t}\n-\t\tder, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)\n-\t\tif err != nil {\n-\t\t\tt.Fatalf(\"CreateCertificate: %v\", err)\n-\t\t}\n-\t\tchain = append(chain, der)\n-\t\ttotal += len(der)\n-\t}\n-\tgiant := tls.Certificate{Certificate: chain, PrivateKey: f.certA.PrivateKey,