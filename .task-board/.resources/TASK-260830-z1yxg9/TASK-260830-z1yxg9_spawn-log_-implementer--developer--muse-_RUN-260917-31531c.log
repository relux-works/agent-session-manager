{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c521","stream":{"kind":"session","id":"01a0addc-f5a7-7d72-82bc-9d078a927129"},"sequence":235,"recorded_at":1780531400000465,"record_type":"event","durability":"durable","causation_id":"05ccea39-0df0-456b-a475-42ee00a3a1b7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"05ccea39-0df0-456b-a475-42ee00a3a1b7","run_stream":{"kind":"run","id":"05ccea39-0df0-456b-a475-42ee00a3a1b7"},"task_stream":{"kind":"task","id":"01a0addd-a366-78d0-ad5a-15c01b70e19c"},"task_id":"01a0addd-a366-78d0-ad5a-15c01b70e19c","event":{"kind":"output","task_id":"01a0addd-a366-78d0-ad5a-15c01b70e19c","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/TASK-260830-z1yxg9/preserved-before-credentials-260910/files/internal/rpcwire/hello.go`.\n1|package rpcwire\n2|\n3|import (\n4|\t\"crypto/rand\"\n5|\t\"encoding/base64\"\n6|\t\"encoding/json\"\n7|\t\"regexp\"\n8|\t\"slices\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|)\n12|\n13|var semver = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n14|\n15|// Hello is a structural claim, including the untrusted HostID and limits.\n16|// Received nonce randomness and freshness cannot be established by a codec.\n17|type Hello struct {\n18|\tHostID         string              `json:\"host_id\"`\n19|\tPlatform       string              `json:\"platform\"`\n20|\tAXVersion      string              `json:\"ax_version\"`\n21|\tNonce          string              `json:\"nonce\"`\n22|\tNonceEcho      string              `json:\"nonce_echo,omitempty\"`\n23|\tContracts      map[string][]string `json:\"contracts\"`\n24|\tMaxLineBytes   scalar.Uint53       `json:\"max_line_bytes\"`\n25|\tMaxObjectBytes scalar.Uint53       `json:\"max_object_bytes\"`\n26|}\n27|\n28|// NewNonce produces 256 random bits without accepting caller-supplied entropy.\n29|func NewNonce() string {\n30|\tvar nonce [32]byte\n31|\t_, _ = rand.Read(nonce[:]) // crypto/rand.Read is infallible in Go 1.25.\n32|\treturn base64.RawURLEncoding.EncodeToString(nonce[:])\n33|}\n34|\n35|// ContractProfile describes the pinned wire shape, not installed capabilities.\n36|// Returning a fresh map prevents one caller from changing another's validator.\n37|func ContractProfile(version string) (map[string][]string, error) {\n38|\tn, err := major(version)\n39|\tif err != nil {\n40|\t\treturn nil, err\n41|\t}\n42|\tm := map[string][]string{}\n43|\tfor _, key := range []string{\"rpc\", \"session_record\", \"session_event\", \"lease\", \"checkpoint\", \"workspace_group\", \"provider_identity\", \"blob\", \"transfer_manifest\", \"chunk\", \"materialization_plan\", \"tombstone\", \"tombstone_ack\", \"task_board_bundle\"} {\n44|\t\tm[key] = []string{\"1.0.0\"}\n45|\t}\n46|\tm[\"rpc\"] = []string{version}\n47|\tif n >= 3 {\n48|\t\tm[\"session_record\"] = []string{\"1.0.0\", \"2.0.0\", \"3.0.0\"}\n49|\t\tm[\"session_event\"] = []string{\"1.0.0\", \"2.0.0\", \"3.0.0\"}\n50|\t\tm[\"materialization_plan\"] = []string{\"1.0.0\", \"2.0.0\"}\n51|\t\tfor _, key := range []string{\"environment_observation\", \"native_session_observation\", \"session_inventory_batch\", \"conversation_lineage_link\", \"session_annotation\", \"session_enrichment_profile\", \"session_enrichment_job_request\", \"session_enrichment_job_receipt\", \"session_continuation_plan\", \"session_directory_operation_receipt\"} {\n52|\t\t\tm[key] = []string{\"1.0.0\"}\n53|\t\t}\n54|\t}\n55|\tif n == 4 {\n56|\t\tm[\"session_event\"] = append(m[\"session_event\"], \"4.0.0\")\n57|\t\tm[\"terminal_backend_evidence\"] = []string{\"1.0.0\"}\n58|\t}\n59|\treturn m, nil\n60|}\n61|\n62|func validNonce(s string) bool {\n63|\tb, err := base64.RawURLEncoding.Strict().DecodeString(s)\n64|\treturn err == nil && len(b) >= 16 && base64.RawURLEncoding.EncodeToString(b) == s\n65|}\n66|func decodeHello(version string, data []byte, response bool) (Hello, error) {\n67|\tm, err := object(data)\n68|\tif err != nil {\n69|\t\treturn Hello{}, ErrHello\n70|\t}\n71|\tkeys := []string{\"host_id\", \"platform\", \"ax_version\", \"nonce\", \"contracts\", \"max_line_bytes\", \"max_object_bytes\"}\n72|\tif response {\n73|\t\tkeys = append(keys, \"nonce_echo\")\n74|\t}\n75|\tif !exact(m, keys...) {\n76|\t\treturn Hello{}, ErrHello\n77|\t}\n78|\tvar h Hello\n79|\tif json.Unmarshal(data, &h) != nil {\n80|\t\treturn Hello{}, ErrHello\n81|\t}\n82|\tif _, err = scalar.ParseUUIDv7(h.HostID); err != nil {\n83|\t\treturn Hello{}, ErrHello\n84|\t}\n85|\tif _, err = scalar.ParsePlatform(h.Platform); err != nil {\n86|\t\treturn Hello{}, ErrHello\n87|\t}\n88|\tif !semver.MatchString(h.AXVersion) || !validNonce(h.Nonce) || (response && !validNonce(h.NonceEcho)) {\n89|\t\treturn Hello{}, ErrHello\n90|\t}\n91|\tif h.MaxLineBytes.Uint64() < MaxLineBytes || h.MaxObjectBytes.Uint64() < MinObjectBytes {\n92|\t\treturn Hello{}, ErrHello\n93|\t}\n94|\tprofile, _ := ContractProfile(version)\n95|\tif len(h.Contracts) != len(profile) {\n96|\t\treturn Hello{}, ErrHello\n97|\t}\n98|\tfor key, expected := range profile {\n99|\t\tversions := h.Contracts[key]\n100|\t\tif len(versions) < 1 || len(versions) > 16 {\n101|\t\t\treturn Hello{}, ErrHello\n102|\t\t}\n103|\t\tfor i, v := range versions {\n104|\t\t\tif !semver.MatchString(v) || (i > 0 && versions[i-1] >= v) {\n105|\t\t\t\treturn Hello{}, ErrHello\n106|\t\t\t}\n107|\t\t}\n108|\t\t// v2 permits 1..16 supported versions for every required key; later\n109|\t\t// pinned maps specify exact arrays. Selecting a common minor is separate.\n110|\t\tif version != \"2.0.0\" && !slices.Equal(versions, expected) {\n111|\t\t\treturn Hello{}, ErrHello\n112|\t\t}\n113|\t}\n114|\treturn h, nil\n115|}\n116|\n117|func (r Request) Hello() (Hello, error) {\n118|\tif r.operation != \"hello\" {\n119|\t\treturn Hello{}, ErrHello\n120|\t}\n121|\treturn decodeHello(r.version, r.body, false)\n122|}\n123|func (r Response) Hello() (Hello, error) {\n124|\tif !r.OK() || r.request.operation != \"hello\" {\n125|\t\treturn Hello{}, ErrHello\n126|\t}\n127|\treturn decodeHello(r.request.version, r.body, true)\n128|}\n129|\n130|// Limits is only the smaller pair of structural offers. It is not a negotiated\n131|// or authenticated connection. The transport's fixed 8 MiB cap still applies.\n132|type Limits struct{ LineBytes, ObjectBytes uint64 }\n133|\n134|func OfferedLimits(request Request, response Response) (Limits, error) {\n135|\ta, err := request.Hello()\n136|\tif err != nil {\n137|\t\treturn Limits{}, err\n138|\t}\n139|\tb, err := response.Hello()\n140|\tif err != nil {\n141|\t\treturn Limits{}, err\n142|\t}\n143|\tif response.request.id != request.id || response.request.version != request.version || a.Nonce != b.NonceEcho {\n144|\t\treturn Limits{}, ErrCorrelation\n145|\t}\n146|\treturn Limits{min(a.MaxLineBytes.Uint64(), b.MaxLineBytes.Uint64()), min(a.MaxObjectBytes.Uint64(), b.MaxObjectBytes.Uint64())}, nil\n147|}","final_result":true}}}
