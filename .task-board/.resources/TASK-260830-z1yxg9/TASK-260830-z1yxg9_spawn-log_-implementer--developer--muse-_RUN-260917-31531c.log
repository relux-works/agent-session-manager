     Remove dependency\\n  check_item(ID, item=N)              Check checklist item\\n  uncheck_item(ID, item=N)            Uncheck checklist item\\n  add_checklist_item(ID, text=...)     Add checklist item\\n  remove_checklist_item(ID, item=N)    Remove obsolete checklist item (destructive)\\n  set_notes(ID, text=..., set=bool?)   Append/set notes\\n  set_parent(ID, parent=...)           Move to new parent\\n  accept_cr(ID, revision=N, evidence=...) Record a reviewer acceptance of a Change Request revision (local board only)\\n  integrate_external(ID, evidence=...)     Close accepted empty-delta external work by evidence (local board only)\\n  withdraw_cr(ID, revision=N, reason=...) Retire an unintegrated revision (local board only)\\n  defer_cr(ID, revision=N, reason=...)    Mark an accepted revision deferred by human decision (local board only)\\n  undefer_cr(ID, revision=N)              Clear the deferral marker (local board only)\\n  add_resource(ID, name=..., content=..., type=..., description=...)\\n  update_resource(ID, name=..., content=..., type=..., description=...)\\n{\\\"defaultFields\\\":[\\\"id\\\",\\\"name\\\",\\\"status\\\"],\\\"fields\\\":[\\\"id\\\",\\\"type\\\",\\\"name\\\",\\\"title\\\",\\\"status\\\",\\\"integrationCheckpointed\\\",\\\"review\\\",\\\"task_class\\\",\\\"estimate\\\",\\\"observability\\\",\\\"parent\\\",\\\"assignee\\\",\\\"description\\\",\\\"scope\\\",\\\"ac\\\",\\\"blockedBy\\\",\\\"blocks\\\",\\\"derivedBlockedBy\\\",\\\"derivedBlocks\\\",\\\"checklist\\\",\\\"notes\\\",\\\"created\\\",\\\"updated\\\",\\\"isBlocked\\\",\\\"isAdvisoryBlocked\\\",\\\"children\\\",\\\"preconditionResources\\\",\\\"outcomeResources\\\",\\\"identity\\\",\\\"binding\\\",\\\"lineage\\\",\\\"lifecycle\\\",\\\"freshness\\\",\\\"actualization\\\",\\\"security\\\",\\\"payload\\\"],\\\"grammar\\\":{\\\"statement\\\":\\\"OPERATION(ARGUMENTS) { PROJECTION }; the projection block is optional\\\",\\\"batch\\\":\\\"STATEMENT; STATEMENT — statements separated by ';', results keep source order\\\",\\\"arguments\\\":\\\"comma-separated arguments: the first bare positional value is the element/identifier argument; remaining arguments use key=value; no operators or lists (not key in [a,b], not key!=value)\\\",\\\"values\\\":\\\"a bare identifier (letters, digits, '_', '-', '.', '/'), an int, a bool (true|false), or a \\\\\\\"double-quoted string\\\\\\\"; quote any value containing spaces, commas or parentheses\\\",\\\"escapes\\\":[\\\"\\\\\\\\\\\\\\\"\\\",\\\"\\\\\\\\\\\\\\\\\\\",\\\"\\\\\\\\n\\\",\\\"\\\\\\\\t\\\"],\\\"projection\\\":\\\"field projection: { field preset ... } — space-separated field names and preset names inside braces; omitted means the default fields\\\",\\\"tokens\\\":[\\\"identifier\\\",\\\"string\\\",\\\"'('\\\",\\\"')'\\\",\\\"'{'\\\",\\\"'}'\\\",\\\"'='\\\",\\\"','\\\",\\\"';'\\\",\\\"end of input\\\"],\\\"examples\\\":[\\\"op()\\\",\\\"op(key=value)\\\",\\\"op(key=value, other=42, flag=true)\\\",\\\"op(key=\\\\\\\"quoted value with \\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\\ \\\\\\\\n \\\\\\\\t\\\\\\\")\\\",\\\"op(positional)\\\",\\\"op() { field preset }\\\",\\\"op(\",\n  \"original_output_bytes\": 3553,\n  \"original_output_tokens\": 889,\n  \"truncated\": false\n}","final_result":true}}}
