orm')\n31|probe('hello-version',H,'!semver.MatchString(h.AXVersion)','(!semver.MatchString(h.AXVersion) && h.AXVersion != \"01.0.0\")','Admits one leading-zero version','TestHelloRefusals/ax-version')\n32|probe('nonce-short',H,'len(b) >= 16','len(b) >= 15','Admits exactly 120 nonce bits','TestHelloRefusals/nonce-short')\n33|probe('line-floor',H,'h.MaxLineBytes.Uint64() < MaxLineBytes','h.MaxLineBytes.Uint64() < MaxLineBytes-1','Admits line floor minus one','TestHelloRefusals/line-floor')\n34|probe('object-floor',H,'h.MaxObjectBytes.Uint64() < MinObjectBytes','h.MaxObjectBytes.Uint64() < MinObjectBytes-1','Admits object floor minus one','TestHelloRefusals/object-floor')\n35|probe('contract-extra',H,'len(h.Contracts) != len(profile)','len(h.Contracts) != len(profile) && !(len(h.Contracts)==len(profile)+1 && h.Contracts[\"error\"] != nil)','Admits one forbidden error map key','TestHelloRefusals/error-key')\n36|probe('contract-seventeen',H,'len(versions) > 16','len(versions) > 17','Admits exactly 17 versions','TestHelloRefusals/seventeen-versions')\n37|probe('contract-empty',H,'len(versions) < 1','len(versions) < 1 && versions == nil','Admits present empty version array','TestHelloRefusals/empty-versions')\n38|probe('contract-duplicate',H,'versions[i-1] >= v','versions[i-1] > v','Admits duplicate adjacent versions','TestHelloRefusals/duplicate-versions')\n39|probe('contract-unsorted',H,'versions[i-1] >= v','(versions[i-1] >= v && !(versions[i-1] == \"2.0.0\" && v == \"1.0.0\"))','Admits one descending adjacent pair','TestHelloRefusals/unsorted-versions')\n40|probe('contract-semver',H,'!semver.MatchString(v)','(!semver.MatchString(v) && v != \"v1.0.0\")','Admits v1.0.0 version string only','TestHelloRefusals/invalid-version')\n41|probe('v3-exact',H,'version != \"2.0.0\" && !slices.Equal(versions, expected)','version != \"2.0.0\" && !slices.Equal(versions, expected) && !(version == \"3.0.0\" && key == \"lease\")','Admits nonexact v3 lease array','TestHelloRefusals/exact-map-3.0.0')\n42|probe('v4-exact',H,'version != \"2.0.0\" && !slices.Equal(versions, expected)','version != \"2.0.0\" && !slices.Equal(versions, expected) && !(version == \"4.0.0\" && key == \"lease\")','Admits nonexact v4 lease array','TestHelloRefusals/exact-map-4.0.0')\n43|probe('offered-pair',H,'response.request.id != request.id','(response.request.id != request.id && request.id != \"0198f4c8-a070-7188-9172-2234567890ab\")','Admits one cross-request limit pair','TestLimitsAndUntrustedIsolation')\n44|probe('namespace-empty',I,'len(names) < 1','len(names) < 1 && names == nil','Admits nonnil empty namespace array','TestInventoryNamespacesAndCardinality/2.0.0')\n45|probe('namespace-member',I,'!slices.Contains(allowed, name)','(!slices.Contains(allowed, name) && name != \"credential\")','Admits credential namespace only','TestInventoryNamespacesAndCardinality/2.0.0')\n46|probe('namespace-duplicate',I,'names[i-1] >= name','names[i-1] > name','Admits duplicate namespaces','TestInventoryNamespacesAndCardinality/2.0.0')\n47|probe('namespace-sort',I,'names[i-1] >= name','(names[i-1] >= name && !(names[i-1] == \"event\" && name == \"blob\"))','Admits event/blob descending pair','TestInventoryNamespacesAndCardinality/2.0.0')\n48|probe('roots-missing',I,'len(roots) != len(names)','len(roots) != len(names) && len(roots) != len(names)-1','Admits one missing requested root','TestInventoryNamespacesAndCardinality/2.0.0/missing')\n49|probe('root-association',I,'root.Namespace != names[i]','root.Namespace != names[i] && !(i==0 && root.Namespace==\"event\")','Admits event root in blob slot','TestInventoryNamespacesAndCardinality/2.0.0')\n50|\n51|probe('common-data-model',E,'canonicaljson.Canonicalize(data); err != nil','canonicaljson.Canonicalize(data); err != nil && !bytes.HasPrefix(data, []byte(`{\"protocol\":\"urn:other\",`))','Admits the duplicate protocol fixture while retaining the canonicalization call','TestFrameRefusals/duplicate')\n52|\n53|def main():\n54|    parser = argparse.ArgumentParser(description=__doc__)\n55|    parser.add_argument(\"--output\", required=True)\n56|    parser.add_argument(\"--only\", help=\"Comma-separated probe names for a bounded follow-up\")\n57|    opts = parser.parse_args()\n58|    if opts.only and not set(opts.only.split(\",\")).issubset({p[0] for p in PROBES}):\n59|        parser.error(\"--only contains an unknown probe\")\n60|    out = Path(opts.output).resolve()\n61|    out.mkdir(parents=True, exist_ok=True)\n62|    results = []\n63|    unexpected = False\n64|    for name, path, old, new, narrows, expected_test in PROBES:\n65|        if opts.only and name not in opts.only.split(\",\"):\n66|            continue\n67|        source = ROOT / path\n68|        original = source.read_bytes()\n69|        text = original.decode()\n70|        if text.count(old) != 1:\n71|            raise RuntimeError(f\"{name}: plant must match exactly once, got {text.count(old)}\")\n72|        folder = out / name\n73|        folder.mkdir(exist_ok=True)\n74|        replacement = folder / source.name\n75|        replacement.write_text(text.replace(old, new, 1))\n76|        overlay = folder / \"overlay.json\"\n77|        overlay.write_text(json.dumps({\"Replace\": {str(source): str(replacement)}}))\n78|        command = [\"go\", \"test\", \"-overlay\", str(overlay), \"./internal/rpcwire\", \"-count=1\", \"-json\", \"-timeout=20s\", \"-run\", TESTS]\n79|        proc = subprocess.run(command, cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=120)\n80|        (folder / \"test.log\").write_bytes(proc.stdout)\n81|        events = []\n82|        for line in proc.stdout.decode(errors=\"replace\").splitlines():\n83|            try:\n84|                events.append(json.loads(line))\n85|            except json.JSONDecodeError:\n86|                pass\n87|        failed = [e[\"Test\"] for e in events if e.get(\"Action\") == \"fail\" and \"Test\" in e]\n88|        passed = [e[\"Test\"] for e in events if e.get(\"Action\") == \"pass\" and \"Test\" in e]\n89|        killed = proc.returncode != 0 and bool(failed) and (expected_test is None or expected_test in failed)\n90|        if name == \"neutral\":\n91|            valid = proc.returncode == 0 and bool(passed)\n92|            state = \"neutral passed\" if valid else \"invalid control\"\n93|        elif name in BOUNDS:\n94|            valid = proc.returncode == 0 and bool(passed)\n95|            state = \"survived\" if valid else \"unexpected result\"\n96|        else:\n97|            valid = killed\n98|            state = \"killed\" if killed else \"survived\" if proc.returncode == 0 and passed else \"invalid instrument/compile failure\"\n99|        if not valid:\n100|            unexpected = True\n101|        if source.read_bytes() != original:\n102|            raise RuntimeError(f\"{name}: source changed during overlay run\")\n103|        row = {\"mutant\": name, \"narrowing\": narrows, \"exit_code\": proc.returncode, \"result\": state,\n104|               \"named_failing_tests\": failed, \"expected_test\": expected_test,\n105|               \"bound\": BOUNDS.get(name, \"\" if killed or name == \"neutral\" else \"No named failing test established; this gate member is unproven.\"),\n106|               \"command\": command}\n107|        results.append(row)\n108|        print(f\"{name}: {state}, exit={proc.returncode}, tests={','.join(failed)}\", flush=True)\n109|        (out / \"results.json\").write_text(json.dumps(results, indent=2) + \"\\n\")\n110|    rows = [\"| Mutant | What the gate is narrowed to admit | Named failing test | Exit | Result / surviving bound |\",\n111|            \"| --- | --- | --- | ---: | --- |\"]\n112|    for r in results:\n113|        tests = r[\"expected_test\"] if r[\"expected_test\"] in r[\"named_failing_tests\"] else \", \".join(r[\"named_failing_tests\"])\n114|        rows.append(f'| {r[\"mutant\"]} | {r[\"narrowing\"]} | {tests or \"none\"} | {r[\"exit_code\"]} | {r[\"result\"]}: {r[\"bound\"]} |')\n115|    (out / \"table.md\").write_text(\"\\n\".join(rows)+\"\\n\")\n116|    return int(unexpected)\n117|\n118|\n119|if __name__ == \"__main__\":\n120|    sys.exit(main())","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
