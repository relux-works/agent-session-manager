{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000e391","stream":{"kind":"session","id":"01a0addc-f5a7-7d72-82bc-9d078a927129"},"sequence":4131,"recorded_at":1780531400008257,"record_type":"event","durability":"durable","causation_id":"05ccea39-0df0-456b-a475-42ee00a3a1b7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"05ccea39-0df0-456b-a475-42ee00a3a1b7","run_stream":{"kind":"run","id":"05ccea39-0df0-456b-a475-42ee00a3a1b7"},"task_stream":{"kind":"task","id":"01a0ae15-a248-7f53-9f16-72b4ec090bc5"},"task_id":"01a0ae15-a248-7f53-9f16-72b4ec090bc5","event":{"kind":"output","task_id":"01a0ae15-a248-7f53-9f16-72b4ec090bc5","chunk":"{\n  \"chunk_id\": \"exec-99-1\",\n  \"command\": \"python3 -c \\\"\\nimport json\\nreg=json.load(open('internal/traceability/ownership.v0.6.0.json'))\\nkinds={}\\nfor e in reg['ownership']:\\n    kinds[e.get('kind')]=kinds.get(e.get('kind'),0)+1\\nprint(kinds)\\nfor e in reg['ownership']:\\n    if '15.1' in json.dumps(e)[:2000] and e.get('kind')=='section_binding':\\n        print('KEYS:', list(e.keys())); print(json.dumps(e, indent=1)[:2500]); break\\n\\\"\",\n  \"description\": \"Find section binding key shape\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"{'contract': 1, 'normative_section': 2, 'section_binding': 56, 'fixture': 2}\\nKEYS: ['kind', 'keys', 'production', 'acceptance_cases', 'coverage', 'gap', 'clauses']\\n{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:15.1\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/axerror/axerror.go\\\",\\n  \\\"declaration\\\": \\\"New\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"structured-error-exact-object\\\",\\n  \\\"structured-error-shape-refusal\\\",\\n  \\\"structured-error-detail-redaction\\\",\\n  \\\"structured-error-detail-inertness\\\",\\n  \\\"structured-error-static-binding\\\",\\n  \\\"structured-error-unknown-code-reader\\\",\\n  \\\"structured-error-local-untrusted\\\",\\n  \\\"cli-result-message-independence\\\",\\n  \\\"structured-error-historical-envelopes\\\",\\n  \\\"structured-error-identity-precedence\\\",\\n  \\\"structured-error-common-data-model\\\"\\n ],\\n \\\"coverage\\\": \\\"partial\\\",\\n \\\"gap\\\": \\\"Two of the seven Section 15.1 clauses stay unimplemented here. Clause 15.1#5 is the RPC hello obligation - an error contract key must never be advertised or negotiated in a hello frame - and New builds a failure object rather than a hello frame; this repository contains no RPC hello builder at all, so BindingFor is a static table with no negotiation path rather than a refusal of one. Clause 15.1#6 is the Provider JSON-over-stdio bootstrap row, whose only RFC 2119 sentence is that the plugin MUST NOT masquerade a different-major object as v2; that obligation binds the provider plugin and this repository builds no provider plugin, only the cataloggen and tracecheck binaries. LocalFromUntrusted implements the host half of the same row, but that half states no RFC 2119 keyword, so it discharges nothing the clause scanner measures and is claimed for clause 15.1#7 instead.\\\",\\n \\\"clauses\\\": [\\n  {\\n   \\\"id\\\": \\\"15.1#1\\\",\\n   \\\"line\\\": 14741,\\n   \\\"excerpt\\\": \\\"MUST be present when known. Messages are for humans; automation MUST branch on\\\",\\n   \\\"acceptance_cases\\\": [\\n    \\\"structured-error-exact-object\\\",\\n    \\\"structured-error-detail-inertness\\\",\\n    \\\"cli-result-message-independence\\\",\\n    \\\"structured-error-historical-envelopes\\\"\\n   ]\\n  },\\n  {\\n   \\\"id\\\": \\\"15.1#2\\\",\\n   \\\"line\\\": 14742,\\n   \\\"excerpt\\\": \\\"<code>code</code> and <code>exit_code</code>. Details MUST be redacted and\\\",\\n   \\\"acceptance_cases\\\": [\\n    \\\"structured-error-detail-redaction\\\"\\n   ]\\n  },\\n  {\\n   \\\"id\\\": \\\"15.1#3\\\",\\n   \\\"line\\\": 14749,\\n   \\\"excerpt\\\": \\\"maximum canonical size 16 KiB. Readers MAY ignore unknown detail keys and MUST\\\",\\n   \\\"acceptance_cases\\\": [\\n    \\\"structured-error-shape-refusal\\\",\\n    \\\"structured-error-detail-inertness\\\"\\n   ]\\n  },\\n  {\\n   \\\"id\\\": \\\"15.1#4\\\",\\n   \\\"line\\\": 14758,\\n   \\\"excerpt\\\": \\\"supported-major failure MUST use that exact object; the containing protocol\\\",\\n   \\\"acceptance_cases\\\": [\\n    \\\"structured-erro\\n\",\n  \"original_output_bytes\": 2665,\n  \"original_output_tokens\": 667,\n  \"truncated\": false\n}","final_result":true}}}
