      "workspace_group": ["1.0.0"],
      "provider_identity": ["1.0.0"],
      "blob": ["1.0.0"],
      "transfer_manifest": ["1.0.0"],
      "chunk": ["1.0.0"],
      "materialization_plan": ["1.0.0"],
      "tombstone": ["1.0.0"],
      "tombstone_ack": ["1.0.0"],
