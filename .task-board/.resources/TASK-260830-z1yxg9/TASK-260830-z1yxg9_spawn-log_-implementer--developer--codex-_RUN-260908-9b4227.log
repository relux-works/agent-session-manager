 \"trailing\":append(bytes.Clone(good),[]byte(\" {}\")...),
 \"utf8\":bytes.Replace(good,[]byte(\"macos\"),[]byte{'m',0xff},1),
 \"float\":bytes.Replace(good,[]byte(\"8388608\"),[]byte(\"8388608.0\"),1),
