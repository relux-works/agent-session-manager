{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7b3","stream":{"kind":"session","id":"01a0ae3f-54f0-7453-97f2-3b7774743ad2"},"sequence":564,"recorded_at":1780531400001123,"record_type":"event","durability":"durable","causation_id":"932cad06-180f-40c2-8da9-e768b00b3c3d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"932cad06-180f-40c2-8da9-e768b00b3c3d","run_stream":{"kind":"run","id":"932cad06-180f-40c2-8da9-e768b00b3c3d"},"call_id":"call_01a0ae4169b3702b938e98b7196610ae","text":"Read text file `internal/hostchannel/channel.go`.\n(199 line(s) above)\n200|\t\tif entry.State == hosttrust.EntryRevoked {\n201|\t\t\tcontinue\n202|\t\t}\n203|\t\tif err := hosttrust.VerifyProfile(entry.LeafDER, entry.RootDER, entry.HostID.String(), now); err != nil {\n204|\t\t\tcontinue\n205|\t\t}\n206|\t\troot, err := x509.ParseCertificate(entry.RootDER)\n207|\t\tif err != nil {\n208|\t\t\tcontinue\n209|\t\t}\n210|\t\tpool.AddCert(root)\n211|\t\tsubjects = append(subjects, root.RawSubject)\n212|\t}\n213|\tif AuthorityListOverflow(subjects) {\n214|\t\treturn nil, fmt.Errorf(\"%w: enrolled authority list exceeds the TLS bound\", ErrInvalidConfig)\n215|\t}\n216|\treturn pool, nil\n217|}\n218|\n219|// VerifiedPeer is the uniquely verified enrolled identity of a TLS peer.\n220|// DER bytes stay unexported so status and error paths cannot log them.\n221|type VerifiedPeer struct {\n222|\tHostID       string\n223|\tCredentialID string\n224|\tleafDER      []byte\n225|\trootDER      []byte\n226|}\n227|\n228|// VerifyFunc supplements a successful standard TLS verification with the\n229|// enrolled-identity checks. It never replaces standard verification.\n230|type VerifyFunc func(tls.ConnectionState) error\n231|\n232|// VerifyPeer returns the supplement plus the record it fills on success.\n233|// The TLS version is enforced once, by the tls.Config both builders share\n234|// below. The supplement requires the exact negotiated ALPN (configuration\n235|// alone cannot refuse a missing negotiation), no resumption, a\n236|// standard-verified chain, exactly one exact enrolled leaf/root/key match,\n237|// current profile validity, and an admitting trust state. UUID/SAN binding\n238|// comes from the profile check against the matched entry.\n239|func VerifyPeer(snapshot hosttrust.Snapshot, now time.Time) (VerifyFunc, *VerifiedPeer) {\n240|\tverified := &VerifiedPeer{}\n241|\tverify := func(state tls.ConnectionState) error {\n242|\t\tif state.NegotiatedProtocol != ALPN {\n243|\t\t\treturn ErrALPNMismatch\n244|\t\t}\n245|\t\tif state.DidResume {\n246|\t\t\treturn ErrUnexpectedResume\n247|\t\t}\n248|\t\tif len(state.VerifiedChains) == 0 || len(state.PeerCertificates) == 0 {\n249|\t\t\treturn ErrUnverifiedChain\n250|\t\t}\n251|\t\tleaf := state.PeerCertificates[0]\n252|\t\tchain := state.VerifiedChains[0]\n253|\t\troot := chain[len(chain)-1]\n254|\t\tspki := scalar.SHA256Digest(leaf.RawSubjectPublicKeyInfo).String()\n255|\t\tvar matched []hosttrust.CredentialEntry\n256|\t\tfor _, entry := range snapshot.Trust.Entries {\n257|\t\t\tif !bytes.Equal(entry.LeafDER, leaf.Raw) {\n258|\t\t\t\tcontinue\n259|\t\t\t}\n260|\t\t\tif !bytes.Equal(entry.RootDER, root.Raw) {\n261|\t\t\t\tcontinue\n262|\t\t\t}\n263|\t\t\tif entry.SPKIID.String() != spki {\n264|\t\t\t\tcontinue\n265|\t\t\t}\n266|\t\t\tmatched = append(matched, entry)\n267|\t\t}\n268|\t\tif len(matched) != 1 {\n269|\t\t\treturn ErrNoEnrolledMatch\n270|\t\t}\n271|\t\tentry := matched[0]\n272|\t\tif err := hosttrust.VerifyProfile(entry.LeafDER, entry.RootDER, entry.HostID.String(), now); err != nil {\n273|\t\t\treturn fmt.Errorf(\"%w: %w\", ErrPeerProfile, err)\n274|\t\t}\n275|\t\tswitch entry.State {\n276|\t\tcase hosttrust.EntryActive:\n277|\t\tcase hosttrust.EntryRetiring:\n278|\t\t\tif entry.RetireAt == nil {\n279|\t\t\t\treturn ErrPeerTrustState\n280|\t\t\t}\n281|\t\t\tretireAt, err := entry.RetireAt.Time()\n282|\t\t\tif err != nil || !now.Before(retireAt) {\n283|\t\t\t\treturn ErrPeerTrustState\n284|\t\t\t}\n285|\t\tdefault:\n286|\t\t\treturn ErrPeerTrustState\n287|\t\t}\n288|\t\tverified.HostID = entry.HostID.String()\n289|\t\tverified.CredentialID = entry.CredentialID.String()\n290|\t\tverified.leafDER = bytes.Clone(leaf.Raw)\n291|\t\tverified.rootDER = bytes.Clone(root.Raw)\n292|\t\treturn nil\n293|\t}\n294|\treturn verify, verified\n295|}\n296|\n297|// baseTLS carries the single shared enforcement of the TLS version floor\n298|// and ceiling, the exact ALPN, and mandatory verification. Both roles\n299|// build on it so no role can drift from the profile.\n300|func baseTLS() *tls.Config {\n301|\treturn &tls.Config{\n302|\t\tMinVersion:         tls.VersionTLS13,\n303|\t\tMaxVersion:         tls.VersionTLS13,\n304|\t\tNextProtos:         alpnProtocols(),\n305|\t\tInsecureSkipVerify: false,\n306|\t}\n307|}\n308|\n309|func alpnProtocols() []string { return []string{ALPN} }\n310|\n311|// ClientTLS builds the initiator TLS 1.3 client configuration: enrolled\n312|// roots only, no session cache, the exact ALPN, and the destination SAN as\n313|// server name. The supplement runs inside VerifyConnection.\n314|func ClientTLS(certificate tls.Certificate, pool *x509.CertPool, serverName string, verify VerifyFunc) *tls.Config {\n315|\tconfig := baseTLS()\n316|\tconfig.Certificates = []tls.Certificate{certificate}\n317|\tconfig.RootCAs = pool\n318|\tconfig.ServerName = serverName\n319|\tconfig.ClientSessionCache = nil\n320|\tconfig.VerifyConnection = verify\n321|\treturn config\n322|}\n323|\n324|// ServerTLS builds the responder TLS 1.3 server configuration: enrolled\n325|// roots only, mandatory verified client certificates, no session tickets,\n326|// the exact ALPN, and the supplement inside VerifyConnection.\n327|func ServerTLS(certificate tls.Certificate, pool *x509.CertPool, verify VerifyFunc) *tls.Config {\n328|\tconfig := baseTLS()\n329|\tconfig.Certificates = []tls.Certificate{certificate}\n330|\tconfig.ClientAuth = tls.RequireAndVerifyClientCert\n331|\tconfig.ClientCAs = pool\n332|\tconfig.SessionTicketsDisabled = true\n333|\tconfig.VerifyConnection = verify\n334|\treturn config\n335|}\n336|\n337|// HandshakeLimiter caps incoming handshake bytes while armed. The channel\n338|// disarms it immediately after local handshake success, so application\n339|// records never count against the handshake budget.\n340|type HandshakeLimiter struct {\n341|\treader io.Reader\n342|\tcount  int64\n343|\tarmed  atomic.Bool\n344|\texceed atomic.Bool\n345|\tlimit  int64\n346|}\n347|\n348|// NewHandshakeLimiter arms a 1 MiB incoming cap over the handshake stream.\n349|func NewHandshakeLimiter(reader io.Reader) *HandshakeLimiter {\n350|\tlimiter := &HandshakeLimiter{reader: reader, limit: MaxHandshakeBytes}\n351|\tlimiter.armed.Store(true)\n352|\treturn limiter\n353|}\n354|\n355|// Disarm ends handshake byte accounting after local handshake success.\n356|func (limiter *HandshakeLimiter) Disarm() { limiter.armed.Store(false) }\n357|\n358|// Exceeded reports whether the cap fired.\n359|func (limiter *HandshakeLimiter) Exceeded() bool { return limiter.exceed.Load() }\n360|\n361|func (limiter *HandshakeLimiter) Read(data []byte) (int, error) {\n362|\tn, err := limiter.reader.Read(data)\n363|\tif !limiter.armed.Load() {\n364|\t\treturn n, err\n365|\t}\n366|\tlimiter.count += int64(n)\n367|\tif limiter.count > limiter.limit {\n368|\t\tlimiter.exceed.Store(true)\n369|\t\treturn n, fmt.Errorf(\"%w: handshake byte cap exceeded\", ErrTransportFailure)\n370|\t}\n371|\treturn n, err\n372|}\n373|\n374|// streamConn adapts a Stream to the net.Conn shape crypto/tls requires.\n375|// Addresses are static pipe labels; deadlines are unsupported because the\n376|// channel enforces its bounds by closing the stream.\n377|type streamConn struct {\n378|\tStream\n379|}\n380|\n381|type pipeAddr string\n382|\n383|func (addr pipeAddr) Network() string { return \"pipe\" }\n384|func (addr pipeAddr) String() string  { return string(addr) }\n385|\n386|func (conn streamConn) LocalAddr() net.Addr  { return pipeAddr(\"local\") }\n387|func (conn streamConn) RemoteAddr() net.Addr { return pipeAddr(\"remote\") }\n388|func (conn streamConn) SetDeadline(_ time.Time) error {\n389|\treturn errors.New(\"host channel deadlines close the stream\")\n390|}\n391|func (conn streamConn) SetReadDeadline(_ time.Time) error {\n392|\treturn errors.New(\"host channel deadlines close the stream\")\n393|}\n394|func (conn streamConn) SetWriteDeadline(_ time.Time) error {\n395|\treturn errors.New(\"host channel deadlines close the stream\")\n396|}\n397|\n398|// RunHandshake completes the TLS handshake under a wall-clock deadline,\n399|// enforced by closing the stream even when the peer sends nothing. A fired\n400|// deadline, an exceeded byte cap, or a transport read failure maps to\n401|// ErrTransportFailure; every other handshake failure is peer\n402|// authentication. No application bytes may move before this returns nil.\n403|func RunHandshake(conn *tls.Conn, stream Stream, limiter *HandshakeLimiter, timeout time.Duration) error {\n404|\tdone := make(chan error, 1)\n405|\tgo func() { done <- conn.Handshake() }()\n406|\ttimer := time.NewTimer(timeout)\n407|\tdefer timer.Stop()\n408|\tselect {\n409|\tcase err := <-done:\n410|\t\tif err == nil {\n411|\t\t\treturn nil\n412|\t\t}\n413|\t\tif limiter != nil && limiter.Exceeded() {\n414|\t\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n415|\t\t}\n416|\t\treturn classifyHandshakeError(err)\n417|\tcase <-timer.C:\n418|\t\t_ = stream.Close()\n419|\t\terr := <-done\n420|\t\tif limiter != nil && limiter.Exceeded() {\n421|\t\t\treturn fmt.Errorf(\"%w: handshake deadline exceeded\", ErrTransportFailure)\n422|\t\t}\n423|\t\tif err == nil {\n424|\t\t\treturn fmt.Errorf(\"%w: handshake deadline exceeded\", ErrTransportFailure)\n425|\t\t}\n426|\t\treturn fmt.Errorf(\"%w: handshake deadline exceeded: %v\", ErrTransportFailure, classifyHandshakeError(err))\n427|\t}\n428|}\n429|\n430|func classifyHandshakeError(err error) error {\n431|\tif err == nil {\n432|\t\treturn nil\n433|\t}\n434|\tif errors.Is(err, ErrTransportFailure) {\n435|\t\treturn err\n436|\t}\n437|\t// A received TLS alert unwraps to an OpError whose Op is \"remote\n438|\t// error\": that is peer authentication, never transport I/O. Every\n439|\t// other OpError, a timeout, a closed conn, or an EOF variant is the\n440|\t// transport failing underneath the handshake.\n441|\tvar opErr *net.OpError\n442|\tif errors.As(err, &opErr) && opErr.Op != \"remote error\" {\n443|\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n444|\t}\n445|\tvar netErr net.Error\n446|\tif errors.As(err, &netErr) && netErr.Timeout() {\n447|\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n448|\t}\n449|\tif errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) || errors.Is(err, io.ErrClosedPipe) || errors.Is(err, net.ErrClosed) {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
