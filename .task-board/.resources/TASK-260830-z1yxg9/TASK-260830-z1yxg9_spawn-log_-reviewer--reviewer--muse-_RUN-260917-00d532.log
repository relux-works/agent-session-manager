{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c929","stream":{"kind":"session","id":"01a0ae3f-54f0-7453-97f2-3b7774743ad2"},"sequence":751,"recorded_at":1780531400001497,"record_type":"event","durability":"durable","causation_id":"932cad06-180f-40c2-8da9-e768b00b3c3d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"932cad06-180f-40c2-8da9-e768b00b3c3d","run_stream":{"kind":"run","id":"932cad06-180f-40c2-8da9-e768b00b3c3d"},"task_stream":{"kind":"task","id":"01a0ae41-d123-7a83-af26-3a0b3ea8f506"},"task_id":"01a0ae41-d123-7a83-af26-3a0b3ea8f506","event":{"kind":"output","task_id":"01a0ae41-d123-7a83-af26-3a0b3ea8f506","chunk":"Read text file `internal/hostchannel/census_test.go`.\n1|package hostchannel_test\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"context\"\n6|\t\"encoding/json\"\n7|\t\"go/ast\"\n8|\t\"go/parser\"\n9|\t\"go/token\"\n10|\t\"io/fs\"\n11|\t\"net\"\n12|\t\"os\"\n13|\t\"path/filepath\"\n14|\t\"runtime\"\n15|\t\"strings\"\n16|\t\"testing\"\n17|\n18|\t\"github.com/relux-works/agent-session-manager/internal/hostchannel\"\n19|\t\"github.com/relux-works/agent-session-manager/internal/rpcwire\"\n20|)\n21|\n22|// forbiddenCalls pins the no-durable-write, no-launch, no-listen contract\n23|// at the source level. A channel run opens no files for writing, starts no\n24|// processes, accepts no sockets, and never consults the system trust pool.\n25|// The runtime census below proves the same property behaviorally; a mutant\n26|// that evades this token list must still face that suite.\n27|var forbiddenCalls = map[string][]string{\n28|\t\"os\":      {\"WriteFile\", \"Create\", \"OpenFile\", \"Mkdir\", \"MkdirAll\", \"MkdirTemp\", \"CreateTemp\", \"Remove\", \"RemoveAll\", \"Rename\", \"Chmod\", \"Chtimes\", \"Truncate\", \"NewFile\"},\n29|\t\"io\":      {\"WriteFile\"},\n30|\t\"os/exec\": {\"Command\", \"CommandContext\"},\n31|\t\"net\":     {\"Listen\", \"ListenPacket\", \"Dial\", \"DialTimeout\", \"DialContext\"},\n32|\t\"syscall\": {\"Open\", \"Creat\", \"Write\", \"Mkdir\", \"Rename\", \"Unlink\"},\n33|\t\"x509\":    {\"SystemCertPool\"},\n34|}\n35|\n36|func TestStaticWriteCensus(t *testing.T) {\n37|\t_, self, _, ok := runtime.Caller(0)\n38|\tif !ok {\n39|\t\tt.Fatal(\"runtime.Caller failed\")\n40|\t}\n41|\tentries, err := os.ReadDir(filepath.Dir(self))\n42|\tif err != nil {\n43|\t\tt.Fatalf(\"ReadDir: %v\", err)\n44|\t}\n45|\tfor _, entry := range entries {\n46|\t\tname := entry.Name()\n47|\t\tif !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n48|\t\t\tcontinue\n49|\t\t}\n50|\t\tpath := filepath.Join(filepath.Dir(self), name)\n51|\t\tfile, err := parser.ParseFile(token.NewFileSet(), path, nil, 0)\n52|\t\tif err != nil {\n53|\t\t\tt.Fatalf(\"ParseFile(%s): %v\", name, err)\n54|\t\t}\n55|\t\tast.Inspect(file, func(node ast.Node) bool {\n56|\t\t\tcall, ok := node.(*ast.CallExpr)\n57|\t\t\tif !ok {\n58|\t\t\t\treturn true\n59|\t\t\t}\n60|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n61|\t\t\tif !ok {\n62|\t\t\t\treturn true\n63|\t\t\t}\n64|\t\t\treceiver, ok := selector.X.(*ast.Ident)\n65|\t\t\tif !ok {\n66|\t\t\t\treturn true\n67|\t\t\t}\n68|\t\t\tfor _, banned := range forbiddenCalls[receiver.Name] {\n69|\t\t\t\tif selector.Sel.Name == banned {\n70|\t\t\t\t\tt.Errorf(\"%s calls forbidden %s.%s\", name, receiver.Name, banned)\n71|\t\t\t\t}\n72|\t\t\t}\n73|\t\t\treturn true\n74|\t\t})\n75|\t}\n76|}\n77|\n78|func snapshotTree(t *testing.T, root string) map[string][]byte {\n79|\tt.Helper()\n80|\ttree := map[string][]byte{}\n81|\tif err := filepath.WalkDir(root, func(path string, entry fs.DirEntry, err error) error {\n82|\t\tif err != nil || entry.IsDir() {\n83|\t\t\treturn err\n84|\t\t}\n85|\t\tbytes, err := os.ReadFile(path)\n86|\t\tif err != nil {\n87|\t\t\treturn err\n88|\t\t}\n89|\t\trel, err := filepath.Rel(root, path)\n90|\t\tif err != nil {\n91|\t\t\treturn err\n92|\t\t}\n93|\t\ttree[rel] = bytes\n94|\t\treturn nil\n95|\t}); err != nil {\n96|\t\tt.Fatalf(\"WalkDir: %v\", err)\n97|\t}\n98|\treturn tree\n99|}\n100|\n101|func tempHCEntries(t *testing.T) map[string]struct{} {\n102|\tt.Helper()\n103|\tentries, err := os.ReadDir(os.TempDir())\n104|\tif err != nil {\n105|\t\tt.Fatalf(\"ReadDir(temp): %v\", err)\n106|\t}\n107|\tnames := map[string]struct{}{}\n108|\tfor _, entry := range entries {\n109|\t\tif strings.HasPrefix(entry.Name(), \"hc-\") {\n110|\t\t\tnames[entry.Name()] = struct{}{}\n111|\t\t}\n112|\t}\n113|\treturn names\n114|}\n115|\n116|func TestRuntimeWriteCensus(t *testing.T) {\n117|\tf := newFixture(t)\n118|\t// A stale tripwire from an earlier mutant run must not poison this one.\n119|\tevict := filepath.Join(os.TempDir(), \"hc-evict\")\n120|\t_ = os.Remove(evict)\n121|\tbeforeA := snapshotTree(t, f.dirA)\n122|\tbeforeB := snapshotTree(t, f.dirB)\n123|\tbeforeTemp := tempHCEntries(t)\n124|\ttrustBefore, err := os.ReadFile(f.storeB.TrustPath())\n125|\tif err != nil {\n126|\t\tt.Fatalf(\"ReadFile(trust): %v\", err)\n127|\t}\n128|\n129|\tvar ran int\n130|\thandler := func(_ context.Context, _ rpcwire.Request, _ hostchannel.Binding, mutate func(func() error) error) (json.RawMessage, error) {\n131|\t\tif err := mutate(func() error { ran++; return nil }); err != nil {\n132|\t\t\treturn nil, err\n133|\t\t}\n134|\t\treturn json.RawMessage(`{}`), nil\n135|\t}\n136|\tclientConn, serverConn := net.Pipe()\n137|\tserved := serveAsync(serverConn, f.serverConfig(handler))\n138|\tclient, err := hostchannel.Dial(clientConn, f.clientConfig())\n139|\tif err != nil {\n140|\t\tt.Fatalf(\"Dial: %v\", err)\n141|\t}\n142|\tfor i := 0; i < 2; i++ {\n143|\t\tresponse, err := client.Call(\"health.get\", json.RawMessage(`{}`))\n144|\t\tif err != nil || !response.OK() {\n145|\t\t\tt.Fatalf(\"Call %d = %+v, %v\", i, response, err)\n146|\t\t}\n147|\t}\n148|\tif ran != 2 {\n149|\t\tt.Fatalf(\"boundary ran %d times\", ran)\n150|\t}\n151|\tif err := client.Close(); err != nil {\n152|\t\tt.Fatalf(\"Close: %v\", err)\n153|\t}\n154|\t_ = awaitErr(t, served)\n155|\tclientConn.Close()\n156|\tserverConn.Close()\n157|\n158|\tfor name, before := range beforeA {\n159|\t\tafter, err := os.ReadFile(filepath.Join(f.dirA, name))\n160|\t\tif err != nil || !bytes.Equal(after, before) {\n161|\t\t\tt.Fatalf(\"state A file %s changed\", name)\n162|\t\t}\n163|\t}\n164|\tfor name, before := range beforeB {\n165|\t\tafter, err := os.ReadFile(filepath.Join(f.dirB, name))\n166|\t\tif err != nil || !bytes.Equal(after, before) {\n167|\t\t\tt.Fatalf(\"state B file %s changed\", name)\n168|\t\t}\n169|\t}\n170|\tif after := snapshotTree(t, f.dirA); len(after) != len(beforeA) {\n171|\t\tt.Fatal(\"state A file set changed\")\n172|\t}\n173|\tif after := snapshotTree(t, f.dirB); len(after) != len(beforeB) {\n174|\t\tt.Fatal(\"state B file set changed\")\n175|\t}\n176|\ttrustAfter, err := os.ReadFile(f.storeB.TrustPath())\n177|\tif err != nil {\n178|\t\tt.Fatalf(\"ReadFile(trust): %v\", err)\n179|\t}\n180|\tif !bytes.Equal(trustAfter, trustBefore) {\n181|\t\tt.Fatal(\"trust store changed during the session\")\n182|\t}\n183|\tfor name := range tempHCEntries(t) {\n184|\t\tif _, ok := beforeTemp[name]; !ok {\n185|\t\t\tt.Fatalf(\"channel created temp entry %s\", name)\n186|\t\t}\n187|\t}\n188|\tif _, err := os.Stat(evict); !os.IsNotExist(err) {\n189|\t\tt.Fatalf(\"channel created the eviction tripwire: %v\", err)\n190|\t}\n191|}","final_result":true}}}
