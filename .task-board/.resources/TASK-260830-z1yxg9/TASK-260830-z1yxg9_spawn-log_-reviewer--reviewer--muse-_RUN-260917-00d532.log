{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c83d","stream":{"kind":"session","id":"01a0ae3f-54f0-7453-97f2-3b7774743ad2"},"sequence":633,"recorded_at":1780531400001261,"record_type":"event","durability":"durable","causation_id":"932cad06-180f-40c2-8da9-e768b00b3c3d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"932cad06-180f-40c2-8da9-e768b00b3c3d","run_stream":{"kind":"run","id":"932cad06-180f-40c2-8da9-e768b00b3c3d"},"task_stream":{"kind":"task","id":"01a0ae41-915d-7400-b763-fc3f46fe59f2"},"task_id":"01a0ae41-915d-7400-b763-fc3f46fe59f2","event":{"kind":"output","task_id":"01a0ae41-915d-7400-b763-fc3f46fe59f2","chunk":"Read text file `internal/hostchannel/client.go`.\n1|package hostchannel\n2|\n3|import (\n4|\t\"crypto/tls\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"fmt\"\n8|\t\"time\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/hosttrust\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/rpcwire\"\n13|)\n14|\n15|// ClientConfig activates one initiator stream. ExpectedRemoteHostID is the\n16|// selected configured destination; the TLS server name and the hello\n17|// identity must both equal it. LocalHostID, LocalCredentialID, and\n18|// Allowlisted come from Configuration 4 like the server side. Zero\n19|// HandshakeTimeout, HelloTimeout, and RequestTimeout select the specified\n20|// defaults; nonzero values override them for tests. A nil Now selects the\n21|// UTC clock.\n22|type ClientConfig struct {\n23|\tStore                *hosttrust.Store\n24|\tCredential           tls.Certificate\n25|\tLocalHostID          string\n26|\tLocalCredentialID    string\n27|\tExpectedRemoteHostID string\n28|\tAllowlisted          []string\n29|\tPlatform             string\n30|\tAXVersion            string\n31|\tHandshakeTimeout     time.Duration\n32|\tHelloTimeout         time.Duration\n33|\tRequestTimeout       time.Duration\n34|\tNow                  func() time.Time\n35|}\n36|\n37|func (config ClientConfig) clock() func() time.Time {\n38|\tif config.Now != nil {\n39|\t\treturn config.Now\n40|\t}\n41|\treturn func() time.Time { return time.Now().UTC() }\n42|}\n43|\n44|func (config ClientConfig) handshakeTimeout() time.Duration {\n45|\tif config.HandshakeTimeout > 0 {\n46|\t\treturn config.HandshakeTimeout\n47|\t}\n48|\treturn DefaultHandshakeTimeout\n49|}\n50|\n51|func (config ClientConfig) helloTimeout() time.Duration {\n52|\tif config.HelloTimeout > 0 {\n53|\t\treturn config.HelloTimeout\n54|\t}\n55|\treturn DefaultHelloTimeout\n56|}\n57|\n58|func (config ClientConfig) requestTimeout() time.Duration {\n59|\tif config.RequestTimeout > 0 {\n60|\t\treturn config.RequestTimeout\n61|\t}\n62|\treturn DefaultRequestTimeout\n63|}\n64|\n65|// Client is one mutually authenticated initiator stream past hello\n66|// success. Calls recheck the current authorization generation before\n67|// sending; a moved generation refuses without transmitting.\n68|type Client struct {\n69|\tconn     *tls.Conn\n70|\tstream   Stream\n71|\tframes   *FrameReader\n72|\tstore    *hosttrust.Store\n73|\tbinding  Binding\n74|\tallow    []string\n75|\texpected string\n76|\ttimeout  time.Duration\n77|\tnow      func() time.Time\n78|}\n79|\n80|// Dial opens the initiator side over one stream: mutual TLS 1.3 against\n81|// the destination SAN, one hello, and current-generation authorization.\n82|// The hello success is validated before Dial returns; no other operation\n83|// moves first.\n84|func Dial(stream Stream, config ClientConfig) (*Client, error) {\n85|\tif stream == nil || config.Store == nil {\n86|\t\t_ = closeQuietly(stream)\n87|\t\treturn nil, ErrInvalidConfig\n88|\t}\n89|\tserverName, err := ServerName(config.ExpectedRemoteHostID)\n90|\tif err != nil {\n91|\t\t_ = closeQuietly(stream)\n92|\t\treturn nil, err\n93|\t}\n94|\tnow := config.clock()\n95|\tcurrent := now()\n96|\tsnapshot, err := config.Store.ReadSnapshot()\n97|\tif err != nil {\n98|\t\t_ = closeQuietly(stream)\n99|\t\treturn nil, fmt.Errorf(\"%w: trust snapshot unreadable: %v\", ErrInvalidConfig, err)\n100|\t}\n101|\tif err := checkLocalCredential(snapshot, config.Credential, config.LocalHostID, config.LocalCredentialID, current); err != nil {\n102|\t\t_ = closeQuietly(stream)\n103|\t\treturn nil, err\n104|\t}\n105|\tpool, err := EnrollmentPool(snapshot, current)\n106|\tif err != nil {\n107|\t\t_ = closeQuietly(stream)\n108|\t\treturn nil, err\n109|\t}\n110|\tif err := validateHelloTemplate(config.LocalHostID, config.Platform, config.AXVersion); err != nil {\n111|\t\t_ = closeQuietly(stream)\n112|\t\treturn nil, err\n113|\t}\n114|\tverify, verified := VerifyPeer(snapshot, current)\n115|\tlimiter := NewHandshakeLimiter(stream)\n116|\tconn := tls.Client(streamConn{Stream: cappedStream{Stream: stream, limiter: limiter}}, ClientTLS(config.Credential, pool, serverName, verify))\n117|\tif err := RunHandshake(conn, stream, limiter, config.handshakeTimeout()); err != nil {\n118|\t\t_ = stream.Close()\n119|\t\treturn nil, err\n120|\t}\n121|\tlimiter.Disarm()\n122|\n123|\tbody, err := helloBody(config.LocalHostID, config.Platform, config.AXVersion, rpcwire.NewNonce(), \"\")\n124|\tif err != nil {\n125|\t\t_ = stream.Close()\n126|\t\treturn nil, fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n127|\t}\n128|\trequestID, err := NewRequestID()\n129|\tif err != nil {\n130|\t\t_ = stream.Close()\n131|\t\treturn nil, err\n132|\t}\n133|\tline, err := rpcwire.EncodeRequest(ProtocolVersion, requestID, \"hello\", body)\n134|\tif err != nil {\n135|\t\t_ = stream.Close()\n136|\t\treturn nil, fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n137|\t}\n138|\trequest, err := rpcwire.DecodeRequest(line)\n139|\tif err != nil {\n140|\t\t_ = stream.Close()\n141|\t\treturn nil, fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n142|\t}\n143|\tframes := NewFrameReader(conn)\n144|\tif err := writeLineBounded(conn, stream, line, config.helloTimeout()); err != nil {\n145|\t\t_ = stream.Close()\n146|\t\treturn nil, err\n147|\t}\n148|\tresponseLine, err := readLineBounded(frames, stream, config.helloTimeout())\n149|\tif err != nil {\n150|\t\t_ = stream.Close()\n151|\t\treturn nil, err\n152|\t}\n153|\tresponse, err := rpcwire.DecodeResponse(responseLine, request)\n154|\tif err != nil {\n155|\t\t_ = stream.Close()\n156|\t\tif errors.Is(err, rpcwire.ErrVersion) || errors.Is(err, rpcwire.ErrFrame) {\n157|\t\t\treturn nil, fmt.Errorf(\"%w: peer hello reply is unframeable: %v\", ErrTransportFailure, err)\n158|\t\t}\n159|\t\treturn nil, fmt.Errorf(\"%w: %w\", ErrProtocol, err)\n160|\t}\n161|\tif !response.OK() {\n162|\t\t_ = stream.Close()\n163|\t\treturn nil, helloRefusal(response.Failure())\n164|\t}\n165|\thello, err := response.Hello()\n166|\tif err != nil {\n167|\t\t_ = stream.Close()\n168|\t\treturn nil, fmt.Errorf(\"%w: %w\", ErrProtocol, err)\n169|\t}\n170|\tfresh, err := config.Store.ReadSnapshot()\n171|\tif err != nil {\n172|\t\t_ = stream.Close()\n173|\t\treturn nil, fmt.Errorf(\"%w: generation read failed: %v\", ErrTransportFailure, err)\n174|\t}\n175|\tif fresh.Generation != snapshot.Generation {\n176|\t\t_ = stream.Close()\n177|\t\treturn nil, fmt.Errorf(\"authorization generation moved during hello: %w\", hosttrust.ErrStaleGeneration)\n178|\t}\n179|\tbinding := Binding{\n180|\t\tGeneration:         fresh.Generation,\n181|\t\tLocalHostID:        config.LocalHostID,\n182|\t\tLocalCredentialID:  config.LocalCredentialID,\n183|\t\tRemoteHostID:       verified.HostID,\n184|\t\tRemoteCredentialID: verified.CredentialID,\n185|\t\tHelloHostID:        hello.HostID,\n186|\t\tremoteLeafDER:      verified.leafDER,\n187|\t\tremoteRootDER:      verified.rootDER,\n188|\t}\n189|\tif err := config.Store.AuthorizeDispatch(fresh, binding.authRequest(config.Allowlisted, config.ExpectedRemoteHostID, now())); err != nil {\n190|\t\t_ = stream.Close()\n191|\t\treturn nil, fmt.Errorf(\"%w: %w\", ErrAuthenticationFailed, err)\n192|\t}\n193|\treturn &Client{\n194|\t\tconn:     conn,\n195|\t\tstream:   stream,\n196|\t\tframes:   frames,\n197|\t\tstore:    config.Store,\n198|\t\tbinding:  binding,\n199|\t\tallow:    append([]string(nil), config.Allowlisted...),\n200|\t\texpected: config.ExpectedRemoteHostID,\n201|\t\ttimeout:  config.requestTimeout(),\n202|\t\tnow:      now,\n203|\t}, nil\n204|}\n205|\n206|// helloRefusal maps a correlated hello failure frame to the initiator\n207|// error. Identity and allowlist refusals are authentication failures; a\n208|// contract refusal is a protocol mismatch.\n209|func helloRefusal(failure *axerror.Error) error {\n210|\tswitch failure.Code() {\n211|\tcase axerror.Code(\"host_identity_mismatch\"):\n212|\t\treturn fmt.Errorf(\"%w: peer refused hello identity\", hosttrust.ErrHostIdentityMismatch)\n213|\tcase axerror.Code(\"peer_not_allowlisted\"):\n214|\t\treturn fmt.Errorf(\"%w: peer is not allowlisted\", hosttrust.ErrNotAllowlisted)\n215|\tdefault:\n216|\t\treturn fmt.Errorf(\"%w: peer refused hello\", ErrProtocol)\n217|\t}\n218|}\n219|\n220|func closeQuietly(stream Stream) error {\n221|\tif stream == nil {\n222|\t\treturn nil\n223|\t}\n224|\treturn stream.Close()\n225|}\n226|\n227|// Binding reports the stream's authorization binding.\n228|func (client *Client) Binding() Binding { return client.binding }\n229|\n230|// PeerHostID reports the verified enrolled UUID of the responder.\n231|func (client *Client) PeerHostID() string { return client.binding.RemoteHostID }\n232|\n233|// ConnectionState exposes the negotiated TLS parameters for resumption\n234|// and version assertions.\n235|func (client *Client) ConnectionState() tls.ConnectionState { return client.conn.ConnectionState() }\n236|\n237|// Close ends the stream.\n238|func (client *Client) Close() error { return client.stream.Close() }\n239|\n240|// Call sends one post-hello request and returns the correlated response.\n241|// The current generation is rechecked before sending; a moved generation\n242|// refuses without transmitting. Framed failure responses return with a nil\n243|// error so the caller inspects the exact Error class and exit status. A\n244|// failed Call closes the stream: the exchange cannot resume mid-frame.\n245|func (client *Client) Call(operation string, body json.RawMessage) (rpcwire.Response, error) {\n246|\tfresh, err := client.store.ReadSnapshot()\n247|\tif err != nil {\n248|\t\treturn rpcwire.Response{}, fmt.Errorf(\"%w: generation read failed: %v\", ErrTransportFailure, err)\n249|\t}\n250|\tif fresh.Generation != client.binding.Generation {\n251|\t\treturn rpcwire.Response{}, fmt.Errorf(\"authorization generation moved: %w\", hosttrust.ErrStaleGeneration)\n252|\t}\n253|\trequestID, err := NewRequestID()\n254|\tif err != nil {\n255|\t\treturn rpcwire.Response{}, err\n256|\t}\n257|\tline, err := rpcwire.EncodeRequest(ProtocolVersion, requestID, operation, body)\n258|\tif err != nil {\n259|\t\treturn rpcwire.Response{}, err\n260|\t}\n261|\trequest, err := rpcwire.DecodeRequest(line)\n262|\tif err != nil {\n263|\t\treturn rpcwire.Response{}, err\n264|\t}\n265|\tif err := writeLineBounded(client.conn, client.stream, line, client.timeout); err != nil {\n266|\t\t_ = client.stream.Close()\n267|\t\treturn rpcwire.Response{}, err\n268|\t}\n269|\tresponseLine, err := readLineBounded(client.frames, client.stream, client.timeout)\n270|\tif err != nil {\n271|\t\t_ = client.stream.Close()\n272|\t\treturn rpcwire.Response{}, err\n273|\t}\n274|\tresponse, err := rpcwire.DecodeResponse(responseLine, request)\n275|\tif err != nil {\n276|\t\tif errors.Is(err, rpcwire.ErrVersion) || errors.Is(err, rpcwire.ErrFrame) {\n277|\t\t\treturn rpcwire.Response{}, fmt.Errorf(\"%w: peer reply is unframeable: %v\", ErrTransportFailure, err)\n278|\t\t}\n279|\t\treturn rpcwire.Response{}, fmt.Errorf(\"%w: %w\", ErrProtocol, err)\n280|\t}\n281|\treturn response, nil\n282|}","final_result":true}}}
