{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c80b","stream":{"kind":"session","id":"01a0ae3f-54f0-7453-97f2-3b7774743ad2"},"sequence":608,"recorded_at":1780531400001211,"record_type":"event","durability":"durable","causation_id":"932cad06-180f-40c2-8da9-e768b00b3c3d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"932cad06-180f-40c2-8da9-e768b00b3c3d","run_stream":{"kind":"run","id":"932cad06-180f-40c2-8da9-e768b00b3c3d"},"task_stream":{"kind":"task","id":"01a0ae41-869e-7563-9fe5-44bd08a36806"},"task_id":"01a0ae41-869e-7563-9fe5-44bd08a36806","event":{"kind":"output","task_id":"01a0ae41-869e-7563-9fe5-44bd08a36806","chunk":"Read text file `internal/hostchannel/server.go`.\n1|package hostchannel\n2|\n3|import (\n4|\t\"context\"\n5|\t\"crypto/tls\"\n6|\t\"crypto/x509\"\n7|\t\"encoding/json\"\n8|\t\"errors\"\n9|\t\"fmt\"\n10|\t\"time\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/hosttrust\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/rpcwire\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n16|)\n17|\n18|// Handler answers one authorized post-hello call. The binding carries the\n19|// authenticated peer and hello identities the dispatch was admitted under.\n20|// The handler returns the success body, or an error that the server frames\n21|// as an incompatible_protocol failure and continues from:\n22|// operation-specific failures belong to the operation owners, and this\n23|// channel mints no new Error enum. A boundary reports a side effect\n24|// through mutate, which rechecks the current authorization generation\n25|// under the exclusive lock before running it; a stale generation closes\n26|// the stream without a frame instead.\n27|type Handler func(ctx context.Context, request rpcwire.Request, binding Binding, mutate func(boundary func() error) error) (json.RawMessage, error)\n28|\n29|// ServerConfig activates one responder stream. LocalHostID and\n30|// LocalCredentialID come from Configuration 4 (host ID and\n31|// mesh.host_channel credential); Allowlisted is the configured mesh peer\n32|// set. Zero HandshakeTimeout, HelloTimeout, and RequestTimeout select the\n33|// specified defaults; nonzero values override them for tests. A nil Now\n34|// selects the UTC clock.\n35|type ServerConfig struct {\n36|\tStore             *hosttrust.Store\n37|\tCredential        tls.Certificate\n38|\tLocalHostID       string\n39|\tLocalCredentialID string\n40|\tAllowlisted       []string\n41|\tPlatform          string\n42|\tAXVersion         string\n43|\tHandler           Handler\n44|\tHandshakeTimeout  time.Duration\n45|\tHelloTimeout      time.Duration\n46|\tRequestTimeout    time.Duration\n47|\tNow               func() time.Time\n48|}\n49|\n50|func (config ServerConfig) clock() func() time.Time {\n51|\tif config.Now != nil {\n52|\t\treturn config.Now\n53|\t}\n54|\treturn func() time.Time { return time.Now().UTC() }\n55|}\n56|\n57|func (config ServerConfig) handshakeTimeout() time.Duration {\n58|\tif config.HandshakeTimeout > 0 {\n59|\t\treturn config.HandshakeTimeout\n60|\t}\n61|\treturn DefaultHandshakeTimeout\n62|}\n63|\n64|func (config ServerConfig) helloTimeout() time.Duration {\n65|\tif config.HelloTimeout > 0 {\n66|\t\treturn config.HelloTimeout\n67|\t}\n68|\treturn DefaultHelloTimeout\n69|}\n70|\n71|func (config ServerConfig) requestTimeout() time.Duration {\n72|\tif config.RequestTimeout > 0 {\n73|\t\treturn config.RequestTimeout\n74|\t}\n75|\treturn DefaultRequestTimeout\n76|}\n77|\n78|// checkLocalCredential validates the activation identity: the leaf parses,\n79|// its SAN is the local host, its digest is the configured credential, and\n80|// the snapshot carries it as an active profile-valid entry.\n81|func checkLocalCredential(snapshot hosttrust.Snapshot, certificate tls.Certificate, hostID, credentialID string, now time.Time) error {\n82|\tif len(certificate.Certificate) == 0 {\n83|\t\treturn fmt.Errorf(\"%w: local credential carries no leaf\", ErrInvalidConfig)\n84|\t}\n85|\tleaf, err := x509.ParseCertificate(certificate.Certificate[0])\n86|\tif err != nil {\n87|\t\treturn fmt.Errorf(\"%w: %w\", ErrInvalidConfig, err)\n88|\t}\n89|\tparsed, err := scalar.ParseUUIDv7(hostID)\n90|\tif err != nil {\n91|\t\treturn fmt.Errorf(\"%w: %w\", ErrInvalidConfig, err)\n92|\t}\n93|\tif len(leaf.DNSNames) != 1 || leaf.DNSNames[0] != parsed.String()+HostSuffix {\n94|\t\treturn fmt.Errorf(\"%w: local leaf SAN differs from the configured host\", ErrInvalidConfig)\n95|\t}\n96|\tif scalar.SHA256Digest(certificate.Certificate[0]).String() != credentialID {\n97|\t\treturn fmt.Errorf(\"%w: local leaf digest differs from the configured credential\", ErrInvalidConfig)\n98|\t}\n99|\tfor _, entry := range snapshot.Trust.Entries {\n100|\t\tif entry.CredentialID.String() != credentialID {\n101|\t\t\tcontinue\n102|\t\t}\n103|\t\tif entry.HostID.String() != parsed.String() || entry.State != hosttrust.EntryActive {\n104|\t\t\treturn fmt.Errorf(\"%w: local credential entry is not active\", ErrInvalidConfig)\n105|\t\t}\n106|\t\tif err := hosttrust.VerifyProfile(entry.LeafDER, entry.RootDER, parsed.String(), now); err != nil {\n107|\t\t\treturn fmt.Errorf(\"%w: %w\", ErrInvalidConfig, err)\n108|\t\t}\n109|\t\treturn nil\n110|\t}\n111|\treturn fmt.Errorf(\"%w: local credential is not enrolled\", ErrInvalidConfig)\n112|}\n113|\n114|// helloBody builds one local hello map: the configured host ID, fresh\n115|// nonce material supplied by the caller, and the exact RPC-5 contract\n116|// profile at the specified limit floors. No authentication, trust,\n117|// configuration, error, or transport key is added.\n118|func helloBody(hostID, platform, axVersion, nonce, nonceEcho string) (json.RawMessage, error) {\n119|\tcontracts, err := rpcwire.ContractProfile(ProtocolVersion)\n120|\tif err != nil {\n121|\t\treturn nil, err\n122|\t}\n123|\tlineBytes, err := scalar.NewUint53(rpcwire.MaxLineBytes)\n124|\tif err != nil {\n125|\t\treturn nil, err\n126|\t}\n127|\tobjectBytes, err := scalar.NewUint53(rpcwire.MinObjectBytes)\n128|\tif err != nil {\n129|\t\treturn nil, err\n130|\t}\n131|\tbody, err := json.Marshal(rpcwire.Hello{\n132|\t\tHostID:         hostID,\n133|\t\tPlatform:       platform,\n134|\t\tAXVersion:      axVersion,\n135|\t\tNonce:          nonce,\n136|\t\tNonceEcho:      nonceEcho,\n137|\t\tContracts:      contracts,\n138|\t\tMaxLineBytes:   lineBytes,\n139|\t\tMaxObjectBytes: objectBytes,\n140|\t})\n141|\tif err != nil {\n142|\t\treturn nil, err\n143|\t}\n144|\treturn body, nil\n145|}\n146|\n147|// validateHelloTemplate proves the configured platform and version shape a\n148|// structurally valid RPC-5 hello before the stream opens, through the same\n149|// encoder the handshake uses.\n150|func validateHelloTemplate(hostID, platform, axVersion string) error {\n151|\tbody, err := helloBody(hostID, platform, axVersion, rpcwire.NewNonce(), \"\")\n152|\tif err != nil {\n153|\t\treturn fmt.Errorf(\"%w: %w\", ErrInvalidConfig, err)\n154|\t}\n155|\tif _, err := rpcwire.EncodeRequest(ProtocolVersion, hostID, \"hello\", body); err != nil {\n156|\t\treturn fmt.Errorf(\"%w: %w\", ErrInvalidConfig, err)\n157|\t}\n158|\treturn nil\n159|}\n160|\n161|func failure13(code axerror.Code, message string, cause error) (*axerror.Error, error) {\n162|\treturn axerror.New(axerror.Spec{\n163|\t\tVersion: axerror.Version130,\n164|\t\tCode:    code,\n165|\t\tMessage: message,\n166|\t\tIDs:     axerror.NoIDs(),\n167|\t\tDetails: axerror.Details{},\n168|\t\tCause:   cause,\n169|\t})\n170|}\n171|\n172|// Serve runs the responder core over one stream: mutual TLS 1.3, one\n173|// authorized hello, then the dispatch loop. It returns when the stream\n174|// closes. Pre-hello refusals send at most one encrypted Error 1.3.0\n175|// failure and close; unframeable input and foreign majors close without a\n176|// frame. Before TLS completes it sends nothing but standard TLS alerts.\n177|func Serve(stream Stream, config ServerConfig) error {\n178|\tif stream == nil || config.Store == nil || config.Handler == nil {\n179|\t\treturn ErrInvalidConfig\n180|\t}\n181|\tnow := config.clock()\n182|\tcurrent := now()\n183|\tsnapshot, err := config.Store.ReadSnapshot()\n184|\tif err != nil {\n185|\t\treturn fmt.Errorf(\"%w: trust snapshot unreadable: %v\", ErrInvalidConfig, err)\n186|\t}\n187|\tif err := checkLocalCredential(snapshot, config.Credential, config.LocalHostID, config.LocalCredentialID, current); err != nil {\n188|\t\treturn err\n189|\t}\n190|\tpool, err := EnrollmentPool(snapshot, current)\n191|\tif err != nil {\n192|\t\treturn err\n193|\t}\n194|\tif err := validateHelloTemplate(config.LocalHostID, config.Platform, config.AXVersion); err != nil {\n195|\t\treturn err\n196|\t}\n197|\tverify, verified := VerifyPeer(snapshot, current)\n198|\tlimiter := NewHandshakeLimiter(stream)\n199|\tconn := tls.Server(streamConn{Stream: cappedStream{Stream: stream, limiter: limiter}}, ServerTLS(config.Credential, pool, verify))\n200|\tif err := RunHandshake(conn, stream, limiter, config.handshakeTimeout()); err != nil {\n201|\t\t_ = stream.Close()\n202|\t\treturn err\n203|\t}\n204|\tlimiter.Disarm()\n205|\tbound := snapshot.Generation\n206|\tpeerLeaf, peerRoot := verified.leafDER, verified.rootDER\n207|\tpeerHost, peerCredential := verified.HostID, verified.CredentialID\n208|\tframes := NewFrameReader(conn)\n209|\n210|\tline, err := readLineBounded(frames, stream, config.helloTimeout())\n211|\tif err != nil {\n212|\t\t_ = stream.Close()\n213|\t\treturn err\n214|\t}\n215|\trequest, err := rpcwire.DecodeRequest(line)\n216|\tif err != nil {\n217|\t\treturn refuseHello(stream, conn, line, err, config.helloTimeout())\n218|\t}\n219|\tif request.Version() != ProtocolVersion {\n220|\t\t_ = stream.Close()\n221|\t\treturn fmt.Errorf(\"%w: foreign RPC major on the channel\", ErrUnframeableInput)\n222|\t}\n223|\tif request.Operation() != \"hello\" {\n224|\t\treturn sendHelloFailure(stream, conn, request, line, axerror.Code(\"incompatible_protocol\"), ErrHelloRequired, config.helloTimeout())\n225|\t}\n226|\thello, err := request.Hello()\n227|\tif err != nil {\n228|\t\treturn refuseHello(stream, conn, line, err, config.helloTimeout())\n229|\t}\n230|\tfresh, err := config.Store.ReadSnapshot()\n231|\tif err != nil {\n232|\t\t_ = stream.Close()\n233|\t\treturn fmt.Errorf(\"%w: generation read failed: %v\", ErrTransportFailure, err)\n234|\t}\n235|\tif fresh.Generation != bound {\n236|\t\t_ = stream.Close()\n237|\t\treturn fmt.Errorf(\"authorization generation moved during hello: %w\", hosttrust.ErrStaleGeneration)\n238|\t}\n239|\tbinding := Binding{\n240|\t\tGeneration:         fresh.Generation,\n241|\t\tLocalHostID:        config.LocalHostID,\n242|\t\tLocalCredentialID:  config.LocalCredentialID,\n243|\t\tRemoteHostID:       peerHost,\n244|\t\tRemoteCredentialID: peerCredential,\n245|\t\tHelloHostID:        hello.HostID,\n246|\t\tremoteLeafDER:      peerLeaf,\n247|\t\tremoteRootDER:      peerRoot,\n248|\t}\n249|\tif err := config.Store.AuthorizeDispatch(fresh, binding.authRequest(config.Allowlisted, peerHost, now())); err != nil {\n250|\t\tswitch {\n251|\t\tcase errors.Is(err, hosttrust.ErrHostIdentityMismatch):\n252|\t\t\treturn sendHelloFailure(stream, conn, request, line, axerror.Code(\"host_identity_mismatch\"), err, config.helloTimeout())\n253|\t\tcase errors.Is(err, hosttrust.ErrNotAllowlisted):\n254|\t\t\treturn sendHelloFailure(stream, conn, request, line, axerror.Code(\"peer_not_allowlisted\"), err, config.helloTimeout())\n255|\t\tdefault:\n256|\t\t\t_ = stream.Close()\n257|\t\t\treturn err\n258|\t\t}\n259|\t}\n260|\tresponseBody, err := helloBody(config.LocalHostID, config.Platform, config.AXVersion, rpcwire.NewNonce(), hello.Nonce)\n261|\tif err != nil {\n262|\t\t_ = stream.Close()\n263|\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n264|\t}\n265|\tsuccess, err := rpcwire.EncodeSuccess(request, responseBody)\n266|\tif err != nil {\n267|\t\t_ = stream.Close()\n268|\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n269|\t}\n270|\tif err := writeLineBounded(conn, stream, success, config.helloTimeout()); err != nil {\n271|\t\t_ = stream.Close()\n272|\t\treturn err\n273|\t}\n274|\treturn serveLoop(frames, stream, conn, config, binding)\n275|}\n276|\n277|// refuseHello frames one Error 1.3.0 failure for a structurally invalid\n278|// RPC-5 hello and closes. Unframeable input closes without a frame.\n279|func refuseHello(stream Stream, conn *tls.Conn, line []byte, decodeErr error, timeout time.Duration) error {\n280|\tdefer func() { _ = stream.Close() }()\n281|\tif errors.Is(decodeErr, rpcwire.ErrVersion) || errors.Is(decodeErr, rpcwire.ErrFrame) {\n282|\t\treturn fmt.Errorf(\"%w: %w\", ErrUnframeableInput, decodeErr)\n283|\t}\n284|\tfailure, err := failure13(\"incompatible_protocol\", \"host channel hello refused\", decodeErr)\n285|\tif err != nil {\n286|\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n287|\t}\n288|\tframe, err := rpcwire.EncodeRejection(line, failure)\n289|\tif err != nil {\n290|\t\treturn fmt.Errorf(\"%w: %w\", ErrUnframeableInput, err)\n291|\t}\n292|\tif err := writeLineBounded(conn, stream, frame, timeout); err != nil {\n293|\t\treturn err\n294|\t}\n295|\treturn fmt.Errorf(\"%w: %w\", ErrProtocol, decodeErr)\n296|}\n297|\n298|// sendHelloFailure sends at most one encrypted hello refusal and closes.\n299|func sendHelloFailure(stream Stream, conn *tls.Conn, request rpcwire.Request, line []byte, code axerror.Code, cause error, timeout time.Duration) error {\n300|\tdefer func() { _ = stream.Close() }()\n301|\tfailure, err := failure13(code, \"host channel hello refused\", cause)\n302|\tif err != nil {\n303|\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n304|\t}\n305|\tframe, err := rpcwire.EncodeRejection(line, failure)\n306|\tif err != nil {\n307|\t\treturn fmt.Errorf(\"%w: %w\", ErrUnframeableInput, err)\n308|\t}\n309|\tif err := writeLineBounded(conn, stream, frame, timeout); err != nil {\n310|\t\treturn err\n311|\t}\n312|\tif code == axerror.Code(\"incompatible_protocol\") && !errors.Is(cause, ErrHelloRequired) {\n313|\t\treturn fmt.Errorf(\"%w: %w\", ErrProtocol, cause)\n314|\t}\n315|\treturn cause\n316|}\n317|\n318|// serveLoop dispatches authorized post-hello calls until the stream ends.\n319|// Every dispatch rechecks the current generation under the authorization\n320|// lock; a moved generation or failed check closes without a frame.\n321|func serveLoop(frames *FrameReader, stream Stream, conn *tls.Conn, config ServerConfig, binding Binding) error {\n322|\tnow := config.clock()\n323|\tfor {\n324|\t\tline, err := readLineBounded(frames, stream, config.requestTimeout())\n325|\t\tif err != nil {\n326|\t\t\t_ = stream.Close()\n327|\t\t\treturn err\n328|\t\t}\n329|\t\trequest, err := rpcwire.DecodeRequest(line)\n330|\t\tif err != nil {\n331|\t\t\t_ = stream.Close()\n332|\t\t\treturn fmt.Errorf(\"%w: %w\", ErrUnframeableInput, err)\n333|\t\t}\n334|\t\tif request.Version() != ProtocolVersion {\n335|\t\t\t_ = stream.Close()\n336|\t\t\treturn fmt.Errorf(\"%w: foreign RPC major on the channel\", ErrUnframeableInput)\n337|\t\t}\n338|\t\tfresh, err := config.Store.ReadSnapshot()\n339|\t\tif err != nil {\n340|\t\t\t_ = stream.Close()\n341|\t\t\treturn fmt.Errorf(\"%w: generation read failed: %v\", ErrTransportFailure, err)\n342|\t\t}\n343|\t\tif fresh.Generation != binding.Generation {\n344|\t\t\t_ = stream.Close()\n345|\t\t\treturn fmt.Errorf(\"authorization generation moved: %w\", hosttrust.ErrStaleGeneration)\n346|\t\t}\n347|\t\tif err := config.Store.AuthorizeDispatch(fresh, binding.authRequest(config.Allowlisted, binding.RemoteHostID, now())); err != nil {\n348|\t\t\t_ = stream.Close()\n349|\t\t\treturn err\n350|\t\t}\n351|\t\tmutate := func(boundary func() error) error {\n352|\t\t\treturn config.Store.WithMutationAuthorization(binding.authRequest(config.Allowlisted, binding.RemoteHostID, now()), boundary)\n353|\t\t}\n354|\t\tbody, err := config.Handler(context.Background(), request, binding, mutate)\n355|\t\tif err != nil {\n356|\t\t\tif errors.Is(err, hosttrust.ErrStaleGeneration) {\n357|\t\t\t\t_ = stream.Close()\n358|\t\t\t\treturn err\n359|\t\t\t}\n360|\t\t\tfailure, buildErr := failure13(\"incompatible_protocol\", \"host channel operation refused\", err)\n361|\t\t\tif buildErr != nil {\n362|\t\t\t\t_ = stream.Close()\n363|\t\t\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, buildErr)\n364|\t\t\t}\n365|\t\t\tframe, buildErr := rpcwire.EncodeFailure(request, failure)\n366|\t\t\tif buildErr != nil {\n367|\t\t\t\t_ = stream.Close()\n368|\t\t\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, buildErr)\n369|\t\t\t}\n370|\t\t\tif writeErr := writeLineBounded(conn, stream, frame, config.requestTimeout()); writeErr != nil {\n371|\t\t\t\t_ = stream.Close()\n372|\t\t\t\treturn writeErr\n373|\t\t\t}\n374|\t\t\tcontinue\n375|\t\t}\n376|\t\tsuccess, err := rpcwire.EncodeSuccess(request, body)\n377|\t\tif err != nil {\n378|\t\t\t_ = stream.Close()\n379|\t\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n380|\t\t}\n381|\t\tif err := writeLineBounded(conn, stream, success, config.requestTimeout()); err != nil {\n382|\t\t\t_ = stream.Close()\n383|\t\t\treturn err\n384|\t\t}\n385|\t}\n386|}\n387|\n388|// cappedStream routes TLS reads through the handshake limiter.\n389|type cappedStream struct {\n390|\tStream\n391|\tlimiter *HandshakeLimiter\n392|}\n393|\n394|func (stream cappedStream) Read(data []byte) (int, error) { return stream.limiter.Read(data) }","final_result":true}}}
