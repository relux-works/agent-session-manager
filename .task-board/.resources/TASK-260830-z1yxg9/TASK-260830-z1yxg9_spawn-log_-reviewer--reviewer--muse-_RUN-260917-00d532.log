{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7e5","stream":{"kind":"session","id":"01a0ae3f-54f0-7453-97f2-3b7774743ad2"},"sequence":589,"recorded_at":1780531400001173,"record_type":"event","durability":"durable","causation_id":"932cad06-180f-40c2-8da9-e768b00b3c3d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"932cad06-180f-40c2-8da9-e768b00b3c3d","run_stream":{"kind":"run","id":"932cad06-180f-40c2-8da9-e768b00b3c3d"},"call_id":"call_01a0ae417b0070a2bb99720102aef5ad","text":"Read text file `internal/hostchannel/channel.go`.\n(448 line(s) above)\n449|\tif errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) || errors.Is(err, io.ErrClosedPipe) || errors.Is(err, net.ErrClosed) {\n450|\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n451|\t}\n452|\treturn fmt.Errorf(\"%w: %w\", ErrAuthenticationFailed, err)\n453|}\n454|\n455|// WriteLine sends one LF-terminated frame. The payload must already be a\n456|// single LF-free line within the wire bound; the check here is defensive.\n457|func WriteLine(writer io.Writer, line []byte) error {\n458|\tif len(line) == 0 || len(line) > rpcwire.MaxLineBytes || bytes.IndexByte(line, '\\n') >= 0 {\n459|\t\treturn ErrUnframeableInput\n460|\t}\n461|\tframe := make([]byte, 0, len(line)+1)\n462|\tframe = append(frame, line...)\n463|\tframe = append(frame, '\\n')\n464|\tif _, err := writer.Write(frame); err != nil {\n465|\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n466|\t}\n467|\treturn nil\n468|}\n469|\n470|// FrameReader decodes successive LF-terminated frames from one stream. It\n471|// must be the only reader on its stream: buffering may hold bytes past\n472|// the current frame. One FrameReader serves a whole connection.\n473|type FrameReader struct {\n474|\tbuffered *bufio.Reader\n475|}\n476|\n477|// NewFrameReader buffers one stream for successive frame reads.\n478|func NewFrameReader(reader io.Reader) *FrameReader {\n479|\treturn &FrameReader{buffered: bufio.NewReader(reader)}\n480|}\n481|\n482|// ReadLine reads one LF-terminated frame without the terminator. An\n483|// over-bound line or mid-line truncation is unframeable and must close\n484|// without a frame. A stream that ends with no frame bytes surfaces as\n485|// io.EOF for the transport mapping, including an abrupt end: zero bytes\n486|// is never a truncated frame.\n487|func (frames *FrameReader) ReadLine() ([]byte, error) {\n488|\tvar line []byte\n489|\tfor {\n490|\t\tchunk, err := frames.buffered.ReadSlice('\\n')\n491|\t\tif len(chunk) > 0 {\n492|\t\t\tif len(line)+len(chunk) > rpcwire.MaxLineBytes+1 {\n493|\t\t\t\treturn nil, ErrUnframeableInput\n494|\t\t\t}\n495|\t\t\tline = append(line, chunk...)\n496|\t\t}\n497|\t\tswitch {\n498|\t\tcase err == nil:\n499|\t\t\treturn line[:len(line)-1], nil\n500|\t\tcase errors.Is(err, bufio.ErrBufferFull):\n501|\t\t\tcontinue\n502|\t\tcase len(line) == 0 && (errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) || errors.Is(err, io.ErrClosedPipe)):\n503|\t\t\treturn nil, io.EOF\n504|\t\tdefault:\n505|\t\t\treturn nil, ErrUnframeableInput\n506|\t\t}\n507|\t}\n508|}\n509|\n510|// ReadLine reads a single frame from a stream no other reader shares. It\n511|// is a one-shot convenience for tests and single-frame peers; a\n512|// connection that reads more than one frame must use NewFrameReader.\n513|func ReadLine(reader io.Reader) ([]byte, error) {\n514|\treturn NewFrameReader(reader).ReadLine()\n515|}\n516|\n517|// writeLineBounded sends one frame under a wall-clock deadline enforced by\n518|// closing the stream. A peer that never reads cannot stall the exchange\n519|// past its bound. A fired deadline maps to ErrTransportFailure.\n520|func writeLineBounded(writer io.Writer, stream Stream, line []byte, timeout time.Duration) error {\n521|\tdone := make(chan error, 1)\n522|\tgo func() { done <- WriteLine(writer, line) }()\n523|\ttimer := time.NewTimer(timeout)\n524|\tdefer timer.Stop()\n525|\tselect {\n526|\tcase err := <-done:\n527|\t\treturn err\n528|\tcase <-timer.C:\n529|\t\t_ = stream.Close()\n530|\t\t<-done\n531|\t\treturn fmt.Errorf(\"%w: frame deadline exceeded\", ErrTransportFailure)\n532|\t}\n533|}\n534|\n535|// readLineBounded reads one frame under a wall-clock deadline enforced by\n536|// closing the stream. A fired deadline maps to ErrTransportFailure.\n537|func readLineBounded(frames *FrameReader, stream Stream, timeout time.Duration) ([]byte, error) {\n538|\ttype result struct {\n539|\t\tline []byte\n540|\t\terr  error\n541|\t}\n542|\tdone := make(chan result, 1)\n543|\tgo func() {\n544|\t\tline, err := frames.ReadLine()\n545|\t\tdone <- result{line: line, err: err}\n546|\t}()\n547|\ttimer := time.NewTimer(timeout)\n548|\tdefer timer.Stop()\n549|\tselect {\n550|\tcase outcome := <-done:\n551|\t\tif errors.Is(outcome.err, io.EOF) {\n552|\t\t\treturn nil, fmt.Errorf(\"%w: peer closed the stream\", ErrTransportFailure)\n553|\t\t}\n554|\t\treturn outcome.line, outcome.err\n555|\tcase <-timer.C:\n556|\t\t_ = stream.Close()\n557|\t\t<-done\n558|\t\treturn nil, fmt.Errorf(\"%w: frame deadline exceeded\", ErrTransportFailure)\n559|\t}\n560|}\n561|\n562|// Binding ties an admitted stream to its authorization facts: the snapshot\n563|// generation it was bound under, the local credential, and the verified\n564|// remote credential with its authenticated hello identity.\n565|type Binding struct {\n566|\tGeneration         uint64\n567|\tLocalHostID        string\n568|\tLocalCredentialID  string\n569|\tRemoteHostID       string\n570|\tRemoteCredentialID string\n571|\tHelloHostID        string\n572|\tremoteLeafDER      []byte\n573|\tremoteRootDER      []byte\n574|}\n575|\n576|// Formatting a binding never exposes identities, digests, or key material.\n577|func (Binding) String() string   { return \"host channel binding\" }\n578|func (Binding) GoString() string { return \"host channel binding\" }\n579|func (Binding) Format(state fmt.State, verb rune) {\n580|\t_, _ = state.Write([]byte(\"host channel binding\"))\n581|}\n582|\n583|func (binding Binding) authRequest(allowlisted []string, expected string, now time.Time) hosttrust.AuthRequest {\n584|\treturn hosttrust.AuthRequest{\n585|\t\tSnapshotGeneration:   binding.Generation,\n586|\t\tLocalHostID:          binding.LocalHostID,\n587|\t\tLocalCredentialID:    binding.LocalCredentialID,\n588|\t\tRemoteLeafDER:        bytes.Clone(binding.remoteLeafDER),\n589|\t\tRemoteRootDER:        bytes.Clone(binding.remoteRootDER),\n590|\t\tExpectedRemoteHostID: expected,\n591|\t\tAllowlisted:          append([]string(nil), allowlisted...),\n592|\t\tHelloHostID:          binding.HelloHostID,\n593|\t\tNow:                  now,\n594|\t}\n595|}\n596|\n597|// CredentialFromIssued builds the TLS leaf credential from issued material:\n598|// the leaf DER plus its PKCS#8 private key. The root private key never\n599|// exists here; issuance destroyed it.\n600|func CredentialFromIssued(issued hosttrust.IssuedCredential) (tls.Certificate, error) {\n601|\tkey, err := x509.ParsePKCS8PrivateKey(issued.LeafKeyDER)\n602|\tif err != nil {\n603|\t\treturn tls.Certificate{}, fmt.Errorf(\"%w: %w\", ErrInvalidConfig, err)\n604|\t}\n605|\tleaf, err := x509.ParseCertificate(issued.LeafDER)\n606|\tif err != nil {\n607|\t\treturn tls.Certificate{}, fmt.Errorf(\"%w: %w\", ErrInvalidConfig, err)\n608|\t}\n609|\tswitch key := key.(type) {\n610|\tcase *ecdsa.PrivateKey:\n611|\t\tif !key.PublicKey.Equal(leaf.PublicKey) {\n612|\t\t\treturn tls.Certificate{}, fmt.Errorf(\"%w: leaf key mismatch\", ErrInvalidConfig)\n613|\t\t}\n614|\tdefault:\n615|\t\treturn tls.Certificate{}, fmt.Errorf(\"%w: unexpected leaf key type\", ErrInvalidConfig)\n616|\t}\n617|\treturn tls.Certificate{Certificate: [][]byte{bytes.Clone(issued.LeafDER)}, PrivateKey: key, Leaf: leaf}, nil\n618|}\n619|\n620|// WatchGeneration blocks until the committed generation moves past the\n621|// bound one, the snapshot becomes unreadable, or the context ends. A moved\n622|// generation returns hosttrust.ErrStaleGeneration: the caller must close\n623|// the bound stream. Filesystem notifications alone never satisfy this\n624|// watch; only committed reads do. A nil error is never returned: context\n625|// expiry surfaces as the context error.\n626|func WatchGeneration(ctx context.Context, store *hosttrust.Store, bound uint64, poll time.Duration) error {\n627|\tif ctx == nil || store == nil {\n628|\t\treturn ErrInvalidConfig\n629|\t}\n630|\tif poll <= 0 {\n631|\t\tpoll = DefaultWatchPoll\n632|\t}\n633|\tticker := time.NewTicker(poll)\n634|\tdefer ticker.Stop()\n635|\tfor {\n636|\t\tselect {\n637|\t\tcase <-ctx.Done():\n638|\t\t\treturn ctx.Err()\n639|\t\tcase <-ticker.C:\n640|\t\t\tsnapshot, err := store.ReadSnapshot()\n641|\t\t\tif err != nil {\n642|\t\t\t\treturn fmt.Errorf(\"%w: generation read failed: %v\", ErrTransportFailure, err)\n643|\t\t\t}\n644|\t\t\tif snapshot.Generation != bound {\n645|\t\t\t\treturn fmt.Errorf(\"host channel generation moved: %w\", hosttrust.ErrStaleGeneration)\n646|\t\t\t}\n647|\t\t}\n648|\t}\n649|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
