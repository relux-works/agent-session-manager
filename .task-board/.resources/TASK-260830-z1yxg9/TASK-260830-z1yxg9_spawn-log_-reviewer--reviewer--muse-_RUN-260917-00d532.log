{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c88f","stream":{"kind":"session","id":"01a0ae3f-54f0-7453-97f2-3b7774743ad2"},"sequence":674,"recorded_at":1780531400001343,"record_type":"event","durability":"durable","causation_id":"932cad06-180f-40c2-8da9-e768b00b3c3d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"932cad06-180f-40c2-8da9-e768b00b3c3d","run_stream":{"kind":"run","id":"932cad06-180f-40c2-8da9-e768b00b3c3d"},"task_stream":{"kind":"task","id":"01a0ae41-9f37-76b1-acbe-1a5fa901a185"},"task_id":"01a0ae41-9f37-76b1-acbe-1a5fa901a185","event":{"kind":"output","task_id":"01a0ae41-9f37-76b1-acbe-1a5fa901a185","chunk":"Read text file `internal/rpcwire/envelope.go`.\n1|// Package rpcwire encodes and inspects untrusted Mesh RPC frames. Structural\n2|// validity and correlation are never authentication, handshake completion or\n3|// permission to dispatch. No connection, responder or operation executor lives\n4|// here. The eventual bilateral admission consumer must supply those boundaries.\n5|package rpcwire\n6|\n7|import (\n8|\t\"bytes\"\n9|\t\"encoding/json\"\n10|\t\"errors\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/sshtransport\"\n16|)\n17|\n18|const Protocol = \"urn:ax:protocol:rpc\"\n19|const MaxLineBytes = sshtransport.MaxLineBytes\n20|const MinObjectBytes = 5 * 1024 * 1024\n21|\n22|var (\n23|\tErrFrame       = errors.New(\"invalid RPC frame\")\n24|\tErrVersion     = errors.New(\"unsupported RPC wire version\")\n25|\tErrCorrelation = errors.New(\"RPC response does not match request\")\n26|\tErrHello       = errors.New(\"incompatible RPC hello structure\")\n27|\tErrInventory   = errors.New(\"invalid RPC inventory structure\")\n28|)\n29|\n30|// Request retains an isolated envelope. Body bytes for operations other than\n31|// hello and inventory.roots are opaque: their operation owners must validate\n32|// them. A zero Request cannot be encoded or used as a response expectation.\n33|type Request struct {\n34|\tversion, id, operation string\n35|\tbody                   json.RawMessage\n36|}\n37|\n38|func (r Request) Version() string       { return r.version }\n39|func (r Request) ID() string            { return r.id }\n40|func (r Request) Operation() string     { return r.operation }\n41|func (r Request) Body() json.RawMessage { return bytes.Clone(r.body) }\n42|\n43|// Response is correlated but still untrusted. A success body has the same\n44|// operation-validation bounds as Request. A failure uses the containing major's\n45|// static Structured Error binding, never a version supplied by its body.\n46|type Response struct {\n47|\trequest Request\n48|\tbody    json.RawMessage\n49|\tfailure *axerror.Error\n50|}\n51|\n52|func (r Response) OK() bool                { return r.failure == nil && r.body != nil }\n53|func (r Response) Body() json.RawMessage   { return bytes.Clone(r.body) }\n54|func (r Response) Failure() *axerror.Error { return r.failure }\n55|\n56|func major(version string) (int, error) {\n57|\tswitch version {\n58|\tcase \"2.0.0\":\n59|\t\treturn 2, nil\n60|\tcase \"3.0.0\":\n61|\t\treturn 3, nil\n62|\tcase \"4.0.0\":\n63|\t\treturn 4, nil\n64|\tcase \"5.0.0\":\n65|\t\treturn 5, nil\n66|\tdefault:\n67|\t\treturn 0, ErrVersion\n68|\t}\n69|}\n70|\n71|// object refuses duplicate members, non-integral numbers and other\n72|// non-I-JSON input using the existing common data-model owner. Keep original\n73|// bytes; canonicalization must not launder invalid numeric lexical forms.\n74|func object(data []byte) (map[string]json.RawMessage, error) {\n75|\tif _, err := canonicaljson.Canonicalize(data); err != nil {\n76|\t\treturn nil, ErrFrame\n77|\t}\n78|\tvar m map[string]json.RawMessage\n79|\tif json.Unmarshal(data, &m) != nil || m == nil {\n80|\t\treturn nil, ErrFrame\n81|\t}\n82|\treturn m, nil\n83|}\n84|func exact(m map[string]json.RawMessage, keys ...string) bool {\n85|\tif len(m) != len(keys) {\n86|\t\treturn false\n87|\t}\n88|\tfor _, k := range keys {\n89|\t\tif _, ok := m[k]; !ok {\n90|\t\t\treturn false\n91|\t\t}\n92|\t}\n93|\treturn true\n94|}\n95|func stringValue(raw json.RawMessage) string {\n96|\tvar value string\n97|\tif json.Unmarshal(raw, &value) != nil {\n98|\t\treturn \"\"\n99|\t}\n100|\treturn value\n101|}\n102|func envelope(data []byte) (map[string]json.RawMessage, string, string, error) {\n103|\tif len(data) == 0 || len(data) > MaxLineBytes || bytes.ContainsAny(data, \"\\n\") {\n104|\t\treturn nil, \"\", \"\", ErrFrame\n105|\t}\n106|\tm, err := object(data)\n107|\tif err != nil {\n108|\t\treturn nil, \"\", \"\", err\n109|\t}\n110|\tif stringValue(m[\"protocol\"]) != Protocol {\n111|\t\treturn nil, \"\", \"\", ErrFrame\n112|\t}\n113|\tversion := stringValue(m[\"protocol_version\"])\n114|\tif !semver.MatchString(version) {\n115|\t\treturn nil, \"\", \"\", ErrFrame\n116|\t}\n117|\tif _, err = major(version); err != nil {\n118|\t\treturn nil, \"\", \"\", err\n119|\t}\n120|\tid := stringValue(m[\"request_id\"])\n121|\tif _, err = scalar.ParseUUIDv7(id); err != nil {\n122|\t\treturn nil, \"\", \"\", ErrFrame\n123|\t}\n124|\treturn m, version, id, nil\n125|}\n126|\n127|// DecodeRequest inspects one LF-free line, as returned by SSH Session.Receive.\n128|// It never marks a hello successful or opens an operation-dispatch path.\n129|func DecodeRequest(line []byte) (Request, error) {\n130|\tm, version, id, err := envelope(line)\n131|\tif err != nil {\n132|\t\treturn Request{}, err\n133|\t}\n134|\tif !exact(m, \"protocol\", \"protocol_version\", \"request_id\", \"operation\", \"body\") {\n135|\t\treturn Request{}, ErrFrame\n136|\t}\n137|\top := stringValue(m[\"operation\"])\n138|\tif op == \"\" {\n139|\t\treturn Request{}, ErrFrame\n140|\t}\n141|\tif _, err = object(m[\"body\"]); err != nil {\n142|\t\treturn Request{}, err\n143|\t}\n144|\tif op == \"hello\" {\n145|\t\t_, err = decodeHello(version, m[\"body\"], false)\n146|\t}\n147|\tif op == \"inventory.roots\" {\n148|\t\t_, err = decodeNamespaces(version, m[\"body\"])\n149|\t}\n150|\tif err != nil {\n151|\t\treturn Request{}, err\n152|\t}\n153|\treturn Request{version, id, op, bytes.Clone(m[\"body\"])}, nil\n154|}\n155|\n156|// EncodeRequest validates the same structural surface as DecodeRequest and\n157|// returns one line without LF for SSH Session.Send. It does not send it.\n158|func EncodeRequest(version, id, operation string, body json.RawMessage) ([]byte, error) {\n159|\tline, err := json.Marshal(map[string]any{\"protocol\": Protocol, \"protocol_version\": version, \"request_id\": id, \"operation\": operation, \"body\": body})\n160|\tif err != nil {\n161|\t\treturn nil, ErrFrame\n162|\t}\n163|\tif _, err = DecodeRequest(line); err != nil {\n164|\t\treturn nil, err\n165|\t}\n166|\treturn line, nil\n167|}\n168|\n169|// DecodeResponse compares identity/version before examining the success or\n170|// error payload. It does not consume a pending request or provide replay\n171|// protection; connection sequencing remains the admission consumer's job.\n172|func DecodeResponse(line []byte, request Request) (Response, error) {\n173|\tif request.id == \"\" {\n174|\t\treturn Response{}, ErrCorrelation\n175|\t}\n176|\tm, version, id, err := envelope(line)\n177|\tif err != nil {\n178|\t\treturn Response{}, err\n179|\t}\n180|\tif version != request.version {\n181|\t\treturn Response{}, ErrVersion\n182|\t}\n183|\tif id != request.id {\n184|\t\treturn Response{}, ErrCorrelation\n185|\t}\n186|\tswitch string(m[\"ok\"]) {\n187|\tcase \"true\":\n188|\t\tif !exact(m, \"protocol\", \"protocol_version\", \"request_id\", \"ok\", \"body\") {\n189|\t\t\treturn Response{}, ErrFrame\n190|\t\t}\n191|\t\tif _, err = object(m[\"body\"]); err != nil {\n192|\t\t\treturn Response{}, err\n193|\t\t}\n194|\t\tif request.operation == \"hello\" {\n195|\t\t\tvar h Hello\n196|\t\t\th, err = decodeHello(version, m[\"body\"], true)\n197|\t\t\tif err == nil {\n198|\t\t\t\tsent, _ := request.Hello()\n199|\t\t\t\tif h.NonceEcho != sent.Nonce {\n200|\t\t\t\t\terr = ErrCorrelation\n201|\t\t\t\t}\n202|\t\t\t}\n203|\t\t}\n204|\t\tif request.operation == \"inventory.roots\" {\n205|\t\t\terr = validateRoots(version, m[\"body\"], request.body)\n206|\t\t}\n207|\t\tif err != nil {\n208|\t\t\treturn Response{}, err\n209|\t\t}\n210|\t\treturn Response{request: request, body: bytes.Clone(m[\"body\"])}, nil\n211|\tcase \"false\":\n212|\t\tif !exact(m, \"protocol\", \"protocol_version\", \"request_id\", \"ok\", \"error\") {\n213|\t\t\treturn Response{}, ErrFrame\n214|\t\t}\n215|\t\tn, _ := major(version)\n216|\t\tfailure, err := axerror.DecodeBound(axerror.ContainingContract{ID: Protocol, Major: n}, m[\"error\"])\n217|\t\tif err != nil {\n218|\t\t\treturn Response{}, err\n219|\t\t}\n220|\t\treturn Response{request: request, failure: failure}, nil\n221|\tdefault:\n222|\t\treturn Response{}, ErrFrame\n223|\t}\n224|}\n225|\n226|func EncodeSuccess(request Request, body json.RawMessage) ([]byte, error) {\n227|\treturn encodeResponse(request, true, \"body\", body)\n228|}\n229|func EncodeFailure(request Request, failure *axerror.Error) ([]byte, error) {\n230|\treturn encodeResponse(request, false, \"error\", failure)\n231|}\n232|func encodeResponse(request Request, ok bool, key string, payload any) ([]byte, error) {\n233|\tline, err := json.Marshal(map[string]any{\"protocol\": Protocol, \"protocol_version\": request.version, \"request_id\": request.id, \"ok\": ok, key: payload})\n234|\tif err != nil {\n235|\t\treturn nil, ErrFrame\n236|\t}\n237|\tif _, err = DecodeResponse(line, request); err != nil {\n238|\t\treturn nil, err\n239|\t}\n240|\treturn line, nil\n241|}\n242|\n243|// EncodeRejection frames a failure for a parseable supported-version request,\n244|// even when its operation or body is invalid (Section 15.1 bootstrap framing).\n245|// Missing/invalid protocol, version or request ID and unparseable lines return\n246|// no frame. This only encodes bytes: the eventual responder must choose the\n247|// correct failure and close after its one pre-handshake rejection. It never\n248|// returns a Request that could be mistaken for a validated hello.\n249|func EncodeRejection(line []byte, failure *axerror.Error) ([]byte, error) {\n250|\tm, version, id, err := envelope(line)\n251|\tif err != nil {\n252|\t\treturn nil, err\n253|\t}\n254|\t// A response or arbitrary object is not a request to which we may reply.\n255|\tif _, ok := m[\"operation\"]; !ok {\n256|\t\treturn nil, ErrFrame\n257|\t}\n258|\treturn EncodeFailure(Request{version: version, id: id}, failure)\n259|}","final_result":true}}}
