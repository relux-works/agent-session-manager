{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c92f","stream":{"kind":"session","id":"01a0ae3f-54f0-7453-97f2-3b7774743ad2"},"sequence":754,"recorded_at":1780531400001503,"record_type":"event","durability":"durable","causation_id":"932cad06-180f-40c2-8da9-e768b00b3c3d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"932cad06-180f-40c2-8da9-e768b00b3c3d","run_stream":{"kind":"run","id":"932cad06-180f-40c2-8da9-e768b00b3c3d"},"call_id":"call_01a0ae41cec770b7821e32ac581da3c4","text":"Read text file `internal/hostchannel/gates_test.go`.\n1|package hostchannel_test\n2|\n3|import (\n4|\t\"testing\"\n5|)\n6|\n7|// hcGates is the Section 11.10.4 closed gate registry as executable\n8|// fixture families. Each family names its positive vectors (admit exactly\n9|// the specified peer) and negative vectors (refuse exactly one hostile\n10|// deviation) driven through the production entries. The conformance matrix\n11|// in the task outcome traces every gate to these tests.\n12|var hcGates = map[string]struct {\n13|\tpositives []string\n14|\tnegatives []string\n15|}{\n16|\t\"HC-TLS\": {\n17|\t\tpositives: []string{\"TestFullHandshakeHelloAndOperation\"},\n18|\t\tnegatives: []string{\n19|\t\t\t\"TestRefusesTLS12Offer/server\", \"TestRefusesTLS12Offer/client\",\n20|\t\t\t\"TestRefusesWrongALPN/server\", \"TestRefusesWrongALPN/client\",\n21|\t\t\t\"TestRefusesMissingALPN\", \"TestRefusesResumption\",\n22|\t\t\t\"TestRefusesPlaintextPreface\", \"TestVerifyPeerRefusals/alpn\",\n23|\t\t\t\"TestVerifyPeerRefusals/missing-alpn\", \"TestVerifyPeerRefusals/resumed\",\n24|\t\t\t\"TestSilentPeerHandshakeDeadline\", \"TestHandshakeLimiterBounds\",\n25|\t\t\t\"TestHandshakeIntakeIsBounded\",\n26|\t\t},\n27|\t},\n28|\t\"HC-CERT\": {\n29|\t\tpositives: []string{\"TestVerifyPeerAdmitsEnrolled\", \"TestFullHandshakeHelloAndOperation\", \"TestCredentialFromIssued\", \"TestEnrollmentPoolExcludesRevoked\"},\n30|\t\tnegatives: []string{\n31|\t\t\t\"TestRefusesUnenrolledRoot\", \"TestRefusesRevokedLeaf\",\n32|\t\t\t\"TestRefusesRetiredPastRetireAt\", \"TestRefusesExpiredLeaf\",\n33|\t\t\t\"TestVerifyPeerRefusals/no-chains\", \"TestVerifyPeerRefusals/no-certificates\",\n34|\t\t\t\"TestVerifyPeerRefusals/unknown-leaf\", \"TestVerifyPeerRefusals/expired\",\n35|\t\t\t\"TestVerifyPeerRefusals/revoked\", \"TestVerifyPeerRefusals/retiring-past\",\n36|\t\t\t\"TestVerifyPeerRefusals/retiring-nil\", \"TestCredentialFromIssuedRefusals\",\n37|\t\t\t\"TestEnrollmentPoolRefusesOverflow\",\n38|\t\t},\n39|\t},\n40|\t\"HC-MAP\": {\n41|\t\tpositives: []string{\"TestVerifyPeerAdmitsEnrolled\", \"TestServerNameMatchesIssuedLeaf\"},\n42|\t\tnegatives: []string{\n43|\t\t\t\"TestVerifyPeerRefusals/double-match\", \"TestVerifyPeerRefusals/leaf-flipped\",\n44|\t\t\t\"TestVerifyPeerRefusals/root-flipped\", \"TestVerifyPeerRefusals/spki-zero\",\n45|\t\t\t\"TestRefusesWrongServerName\",\n46|\t\t},\n47|\t},\n48|\t\"HC-HELLO\": {\n49|\t\tpositives: []string{\"TestFullHandshakeHelloAndOperation\", \"TestInventoryRootsThroughChannel\", \"TestNewRequestID\", \"TestLocalFailureMapping\"},\n50|\t\tnegatives: []string{\n51|\t\t\t\"TestRefusesHelloUUIDMismatch\", \"TestRefusesServerHelloUUIDMismatch\",\n52|\t\t\t\"TestRefusesDestinationMismatch\", \"TestRefusesNotAllowlisted\",\n53|\t\t\t\"TestRefusesInvalidHello/contract\", \"TestRefusesInvalidHello/missing-key\",\n54|\t\t\t\"TestRefusesInvalidHello/nonce\", \"TestHelloResponseCorrelation\",\n55|\t\t\t\"TestHelloFailureMapping/host_identity_mismatch\", \"TestHelloFailureMapping/peer_not_allowlisted\",\n56|\t\t\t\"TestHelloFailureMapping/incompatible_protocol\", \"TestHelloDeadline/server\",\n57|\t\t\t\"TestHelloDeadline/client\", \"TestHelloWriteDeadline\",\n58|\t\t},\n59|\t},\n60|\t\"HC-DISPATCH\": {\n61|\t\tpositives: []string{\"TestFullHandshakeHelloAndOperation\", \"TestHandlerErrorFramedAndContinues\"},\n62|\t\tnegatives: []string{\n63|\t\t\t\"TestRefusesNonHelloBeforeHello\", \"TestForeignMajorClosesSilently/2.0.0\",\n64|\t\t\t\"TestForeignMajorClosesSilently/4.0.0\", \"TestUnframeableHelloClosesSilently\",\n65|\t\t\t\"TestOversizeHelloLine\", \"TestDispatchTimeout\", \"TestDispatchExpiryClosesWithoutFrame\",\n66|\t\t\t\"TestCallRefusesInvalidBody\", \"TestHandlerGarbageBodyCloses\",\n67|\t\t},\n68|\t},\n69|\t\"HC-MIGRATE\": {\n70|\t\tpositives: []string{\"TestLaunchForConfig\", \"TestServeArgvPinsChannelVersion\"},\n71|\t\tnegatives: []string{\n72|\t\t\t\"TestLaunchForConfigRefusesLegacy\", \"TestLaunchForConfigEmptySnapshot\",\n73|\t\t\t\"TestForeignMajorClosesSilently/2.0.0\", \"TestForeignMajorClosesSilently/4.0.0\",\n74|\t\t\t\"TestInvalidActivation\", \"TestLocalCredentialRefusals\",\n75|\t\t},\n76|\t},\n77|\t\"HC-LIFECYCLE\": {\n78|\t\tpositives: []string{\"TestRetiringCredentialAdmitsWithinBound\", \"TestMutationBoundaryRunsFresh\"},\n79|\t\tnegatives: []string{\"TestRefusesRevokedLeaf\", \"TestRefusesRetiredPastRetireAt\", \"TestRefusesExpiredLeaf\"},\n80|\t},\n81|\t\"HC-GENERATION\": {\n82|\t\tpositives: []string{\"TestMutationBoundaryRunsFresh\", \"TestFullHandshakeHelloAndOperation\", \"TestAuthorityListOverflow\"},\n83|\t\tnegatives: []string{\n84|\t\t\t\"TestStaleGenerationAtDispatch/server_closes\", \"TestStaleGenerationAtDispatch/client_refuses_to_send\",\n85|\t\t\t\"TestStaleGenerationAtMutation\", \"TestWatchGeneration\",\n86|\t\t},\n87|\t},\n88|\t\"HC-EXCLUDE\": {\n89|\t\tpositives: []string{\"TestRuntimeWriteCensus\", \"TestStaticWriteCensus\", \"TestBindingRedaction\"},\n90|\t\tnegatives: []string{\"census-evasion mutant (killed by TestRuntimeWriteCensus)\"},\n91|\t},\n92|\t\"HC-PARITY\": {\n93|\t\tpositives: []string{\"TestFullHandshakeHelloAndOperation (transport-agnostic Stream)\"},\n94|\t\tnegatives: []string{\"stated bound: no SSH-implementation branch exists in the package; the same TLS profile runs over any ordered binary Stream\"},\n95|\t},\n96|}\n97|\n98|func TestHCGateRegistryIsComplete(t *testing.T) {\n99|\twant := []string{\"HC-TLS\", \"HC-CERT\", \"HC-MAP\", \"HC-HELLO\", \"HC-DISPATCH\", \"HC-MIGRATE\", \"HC-LIFECYCLE\", \"HC-GENERATION\", \"HC-EXCLUDE\", \"HC-PARITY\"}\n100|\tif len(hcGates) != len(want) {\n101|\t\tt.Fatalf(\"registry carries %d gates, Section 11.10.4 defines %d\", len(hcGates), len(want))\n102|\t}\n103|\tfor _, gate := range want {\n104|\t\tfamily, ok := hcGates[gate]\n105|\t\tif !ok {\n106|\t\t\tt.Fatalf(\"gate %s missing\", gate)\n107|\t\t}\n108|\t\tif len(family.positives) == 0 || len(family.negatives) == 0 {\n109|\t\t\tt.Fatalf(\"gate %s lacks a positive or negative family\", gate)\n110|\t\t}\n111|\t}\n112|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
