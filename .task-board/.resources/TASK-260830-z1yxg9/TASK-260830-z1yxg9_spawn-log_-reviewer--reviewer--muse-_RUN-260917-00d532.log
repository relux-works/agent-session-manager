\t\tt.Fatalf(\"ParseTimestamp: %v\", err)\n33|\t\t}\n34|\t\tretireStamp = &parsed\n35|\t}\n36|\treturn hosttrust.CredentialEntry{\n37|\t\tHostID:       issued.HostID,\n38|\t\tCredentialID: scalar.SHA256Digest(issued.LeafDER),\n39|\t\tSPKIID:       scalar.SHA256Digest(leaf.RawSubjectPublicKeyInfo),\n40|\t\tRootID:       scalar.SHA256Digest(issued.RootDER),\n41|\t\tLeafDER:      bytes.Clone(issued.LeafDER),\n42|\t\tRootDER:      bytes.Clone(issued.RootDER),\n43|\t\tState:        state,\n44|\t\tEnrolledAt:   stamp,\n45|\t\tRetireAt:     retireStamp,\n46|\t}\n47|}\n48|\n49|func verifySnapshot(entries ...hosttrust.CredentialEntry) hosttrust.Snapshot {\n50|\treturn hosttrust.Snapshot{\n51|\t\tGeneration: 7,\n52|\t\tTrust:      hosttrust.TrustStore{Generation: 7, Entries: entries},\n53|\t}\n54|}\n55|\n56|func verifyState(t *testing.T, leafDER, rootDER []byte) tls.ConnectionState {\n57|\tt.Helper()\n58|\tleaf, err := x509.ParseCertificate(leafDER)\n59|\tif err != nil {\n60|\t\tt.Fatalf(\"parse leaf: %v\", err)\n61|\t}\n62|\troot, err := x509.ParseCertificate(rootDER)\n63|\tif err != nil {\n64|\t\tt.Fatalf(\"parse root: %v\", err)\n65|\t}\n66|\treturn tls.ConnectionState{\n67|\t\tVersion:            tls.VersionTLS13,\n68|\t\tNegotiatedProtocol: \"ax-host/1\",\n69|\t\tPeerCertificates:   []*x509.Certificate{leaf},\n70|\t\tVerifiedChains:     [][]*x509.Certificate{{leaf, root}},\n71|\t}\n72|}\n73|\n74|func TestVerifyPeerAdmitsEnrolled(t *testing.T) {\n75|\tnow := time.Now().UTC()\n76|\tissued, err := hosttrust.IssueCredential(hostA, now, nil)\n77|\tif err != nil {\n78|\t\tt.Fatalf(\"IssueCredential: %v\", err)\n79|\t}\n80|\tsnapshot := verifySnapshot(verifyEntry(t, issued, hosttrust.EntryActive, now, nil))\n81|\tverify, verified := hostchannel.VerifyPeer(snapshot, now)\n82|\tif err := verify(verifyState(t, issued.LeafDER, issued.RootDER)); err != nil {\n83|\t\tt.Fatalf(\"VerifyPeer: %v\", err)\n84|\t}\n85|\tif verified.HostID != hostA {\n86|\t\tt.Fatalf(\"verified host = %q\", verified.HostID)\n87|\t}\n88|\tif verified.CredentialID != scalar.SHA256Digest(issued.LeafDER).String() {\n89|\t\tt.Fatalf(\"verified credential = %q\", verified.CredentialID)\n90|\t}\n91|}\n92|\n93|func TestVerifyPeerRefusals(t *testing.T) {\n94|\tnow := time.Now().UTC()\n95|\tissued, err := hosttrust.IssueCredential(hostA, now, nil)\n96|\tif err != nil {\n97|\t\tt.Fatalf(\"IssueCredential: %v\", err)\n98|\t}\n99|\tattacker, err := hosttrust.IssueCredential(hostC, now, nil)\n100|\tif err != nil {\n101|\t\tt.Fatalf(\"IssueCredential: %v\", err)\n102|\t}\n103|\taged, err := hosttrust.IssueCredential(hostC, now.Add(-100*24*time.Hour), nil)\n104|\tif err != nil {\n105|\t\tt.Fatalf(\"IssueCredential: %v\", err)\n106|\t}\n107|\tentry := verifyEntry(t, issued, hosttrust.EntryActive, now, nil)\n108|\tzeroSPKI := \"sha256:\" + string(bytes.Repeat([]byte(\"0\"), 64))\n109|\n110|\tcases := []struct {\n111|\t\tname     string\n112|\t\tsnapshot hosttrust.Snapshot\n113|\t\tstate    func() tls.ConnectionState\n114|\t\twant     error\n115|\t}{\n(more lines below)","final_result":true}}}
