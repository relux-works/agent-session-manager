{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c789","stream":{"kind":"session","id":"01a0ae3f-54f0-7453-97f2-3b7774743ad2"},"sequence":543,"recorded_at":1780531400001081,"record_type":"event","durability":"durable","causation_id":"932cad06-180f-40c2-8da9-e768b00b3c3d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"932cad06-180f-40c2-8da9-e768b00b3c3d","run_stream":{"kind":"run","id":"932cad06-180f-40c2-8da9-e768b00b3c3d"},"call_id":"call_01a0ae415bec72cc91a62ce832e67f93","text":"Read text file `internal/hostchannel/channel.go`.\n1|// Package hostchannel implements AX Section 11.10 Host Channel 1.0.0 over\n2|// Mesh RPC 5.0.0: mutual TLS 1.3 host authentication over an ordered binary\n3|// duplex stream, followed by an RPC-5 hello that is authorized against the\n4|// current hosttrust generation before any dispatch.\n5|//\n6|// The package owns the TLS profile, the hello exchange, per-dispatch and\n7|// per-mutation authorization boundaries, and the specified refusal framing.\n8|// It owns no SSH process, no CLI, no operation semantics beyond admission,\n9|// and no durable state: a channel run performs no file writes. Operation\n10|// bodies stay opaque; the caller-supplied Handler answers post-hello calls.\n11|package hostchannel\n12|\n13|import (\n14|\t\"bufio\"\n15|\t\"bytes\"\n16|\t\"context\"\n17|\t\"crypto/ecdsa\"\n18|\t\"crypto/rand\"\n19|\t\"crypto/tls\"\n20|\t\"crypto/x509\"\n21|\t\"encoding/binary\"\n22|\t\"errors\"\n23|\t\"fmt\"\n24|\t\"io\"\n25|\t\"net\"\n26|\t\"strings\"\n27|\t\"sync/atomic\"\n28|\t\"time\"\n29|\n30|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n31|\t\"github.com/relux-works/agent-session-manager/internal/hosttrust\"\n32|\t\"github.com/relux-works/agent-session-manager/internal/rpcwire\"\n33|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n34|)\n35|\n36|const (\n37|\t// ProtocolVersion is the only RPC major this channel frames.\n38|\tProtocolVersion = \"5.0.0\"\n39|\t// ALPN is the exact Section 11.10.1 application protocol identifier.\n40|\tALPN = \"ax-host/1\"\n41|\t// DefaultHandshakeTimeout and DefaultHelloTimeout are the specified\n42|\t// fixed 10-second wall-clock bounds. Configuration structs select them\n43|\t// with a zero duration; tests use small overrides.\n44|\tDefaultHandshakeTimeout = 10 * time.Second\n45|\tDefaultHelloTimeout     = 10 * time.Second\n46|\t// DefaultRequestTimeout is the Section 6.2 default RPC timeout used\n47|\t// when the caller supplies no configured value.\n48|\tDefaultRequestTimeout = 300 * time.Second\n49|\t// MaxHandshakeBytes caps incoming handshake bytes per side.\n50|\tMaxHandshakeBytes = 1024 * 1024\n51|\t// MaxAuthorityBytes is the TLS CertificateRequest authority-list bound\n52|\t// the encoded CA distinguished-name list must fit.\n53|\tMaxAuthorityBytes = 65535\n54|\t// HostSuffix is the only permitted DNS SAN parent. It is asserted\n55|\t// against issued leaf certificates by test, not trusted by spelling.\n56|\tHostSuffix = \".host.ax.invalid\"\n57|\t// DefaultWatchPoll is the generation-watch sampling interval.\n58|\tDefaultWatchPoll = 50 * time.Millisecond\n59|)\n60|\n61|var (\n62|\t// ErrInvalidConfig reports a local configuration, credential-store or\n63|\t// activation failure before launch. The initiator maps it to the\n64|\t// invalid_config Error (exit 3).\n65|\tErrInvalidConfig = errors.New(\"host channel configuration is invalid\")\n66|\t// ErrAuthenticationFailed reports a known peer certificate or\n67|\t// handshake authentication failure. The initiator maps it to the\n68|\t// authentication_failed Error (exit 7).\n69|\tErrAuthenticationFailed = errors.New(\"host channel peer authentication failed\")\n70|\t// ErrTransportFailure reports transport I/O, a deadline, a byte cap,\n71|\t// or an unclassified EOF. The initiator maps it to the\n72|\t// transport_failure Error (exit 8).\n73|\tErrTransportFailure = errors.New(\"host channel transport failed\")\n74|\t// ErrProtocol reports a contract mismatch the peer actually framed:\n75|\t// a structurally invalid hello, a pre-hello non-hello request, or a\n76|\t// correlated failure the peer chose. It maps to the\n77|\t// incompatible_protocol Error (exit 6) and is never inferred from EOF.\n78|\tErrProtocol = errors.New(\"host channel protocol mismatch\")\n79|\t// ErrUnframeableInput reports input that must close without a frame:\n80|\t// unparseable bytes, an oversize line, or a foreign RPC major.\n81|\tErrUnframeableInput = errors.New(\"host channel input is unframeable\")\n82|\t// ErrHelloRequired reports a valid pre-hello non-hello request. It maps\n83|\t// to the incompatible_protocol Error (exit 6) like every framed\n84|\t// pre-hello contract refusal, but keeps its own identity so tests can\n85|\t// tell the sequencing gate from a malformed hello.\n86|\tErrHelloRequired = errors.New(\"host channel requires hello first\")\n87|\t// ErrALPNMismatch reports a negotiated ALPN other than the host\n88|\t// channel, including a missing negotiation. The tls.Config selects the\n89|\t// advertisement; this check enforces presence, which configuration\n90|\t// alone cannot.\n91|\tErrALPNMismatch = errors.New(\"host channel ALPN mismatch\")\n92|\t// ErrUnexpectedResume reports a resumed TLS connection, which the\n93|\t// channel forbids even when the peer negotiates one.\n94|\tErrUnexpectedResume = errors.New(\"host channel resumed connection refused\")\n95|\t// ErrUnverifiedChain reports a handshake that reached the supplement\n96|\t// without a standard-verified chain. The supplement never replaces\n97|\t// standard chain/name/time/EKU verification.\n98|\tErrUnverifiedChain = errors.New(\"host channel chain verification missing\")\n99|\t// ErrNoEnrolledMatch reports a peer certificate with zero or multiple\n100|\t// exact enrolled leaf/root/key matches. SAN or CA membership alone\n101|\t// never suffices.\n102|\tErrNoEnrolledMatch = errors.New(\"host channel peer has no unique enrolled match\")\n103|\t// ErrPeerTrustState reports a uniquely matched entry that is revoked\n104|\t// or past its retire_at bound.\n105|\tErrPeerTrustState = errors.New(\"host channel peer trust state refuses admission\")\n106|\t// ErrPeerProfile reports a matched entry whose certificates fail the\n107|\t// Host Credential Profile 1 checks at handshake time.\n108|\tErrPeerProfile = errors.New(\"host channel peer credential profile refused\")\n109|)\n110|\n111|// LocalFailure maps a channel error to the initiator-local Structured Error\n112|// code and exit status of Section 11.10.1. The second result is false when\n113|// the error carries no initiator mapping.\n114|func LocalFailure(err error) (axerror.Code, int, bool) {\n115|\tswitch {\n116|\tcase errors.Is(err, ErrInvalidConfig):\n117|\t\treturn axerror.Code(\"invalid_config\"), 3, true\n118|\tcase errors.Is(err, ErrAuthenticationFailed),\n119|\t\terrors.Is(err, ErrALPNMismatch),\n120|\t\terrors.Is(err, hosttrust.ErrHostIdentityMismatch),\n121|\t\terrors.Is(err, hosttrust.ErrNotAllowlisted),\n122|\t\terrors.Is(err, hosttrust.ErrStaleGeneration),\n123|\t\terrors.Is(err, hosttrust.ErrAuthorizationRefused):\n124|\t\treturn axerror.Code(\"authentication_failed\"), 7, true\n125|\tcase errors.Is(err, ErrProtocol),\n126|\t\terrors.Is(err, ErrHelloRequired):\n127|\t\treturn axerror.Code(\"incompatible_protocol\"), 6, true\n128|\tcase errors.Is(err, ErrTransportFailure),\n129|\t\terrors.Is(err, ErrUnframeableInput):\n130|\t\treturn axerror.Code(\"transport_failure\"), 8, true\n131|\tdefault:\n132|\t\treturn \"\", 0, false\n133|\t}\n134|}\n135|\n136|// Stream is the ordered binary stdin/stdout carrier the TLS session runs\n137|// over. It is deliberately narrower than net.Conn: no listener, no PTY, no\n138|// deadlines. Timeouts are enforced by closing the stream.\n139|type Stream interface {\n140|\tio.Reader\n141|\tio.Writer\n142|\tClose() error\n143|}\n144|\n145|// ServerName derives the expected UUID-derived DNS SAN of a configured\n146|// destination. The SSH endpoint is never a name here.\n147|func ServerName(hostID string) (string, error) {\n148|\tparsed, err := scalar.ParseUUIDv7(hostID)\n149|\tif err != nil {\n150|\t\treturn \"\", fmt.Errorf(\"%w: %w\", ErrInvalidConfig, err)\n151|\t}\n152|\treturn parsed.String() + HostSuffix, nil\n153|}\n154|\n155|// NewRequestID mints one fresh UUIDv7 request correlator.\n156|func NewRequestID() (string, error) {\n157|\tvar id [16]byte\n158|\tbinary.BigEndian.PutUint64(id[:8], uint64(time.Now().UnixMilli())<<16)\n159|\tif _, err := rand.Read(id[8:]); err != nil {\n160|\t\treturn \"\", fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n161|\t}\n162|\tid[6] = id[6]&0x0f | 0x70\n163|\tid[8] = id[8]&0x3f | 0x80\n164|\tvar text strings.Builder\n165|\tconst digits = \"0123456789abcdef\"\n166|\tfor i, b := range id {\n167|\t\tif i == 4 || i == 6 || i == 8 || i == 10 {\n168|\t\t\ttext.WriteByte('-')\n169|\t\t}\n170|\t\ttext.WriteByte(digits[b>>4])\n171|\t\ttext.WriteByte(digits[b&0x0f])\n172|\t}\n173|\tparsed, err := scalar.ParseUUIDv7(text.String())\n174|\tif err != nil {\n175|\t\treturn \"\", fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n176|\t}\n177|\treturn parsed.String(), nil\n178|}\n179|\n180|// AuthorityListOverflow reports whether the encoded CA distinguished-name\n181|// list of the given subjects exceeds the TLS authority-list bound. The\n182|// encoding is the 2-byte vector length plus one 2-byte length prefix per\n183|// name. Activation refuses an overflowing pool instead of truncating it.\n184|func AuthorityListOverflow(subjects [][]byte) bool {\n185|\ttotal := 2\n186|\tfor _, subject := range subjects {\n187|\t\ttotal += 2 + len(subject)\n188|\t}\n189|\treturn total > MaxAuthorityBytes\n190|}\n191|\n192|// EnrollmentPool builds the TLS trust pool from exactly the enrolled,\n193|// non-revoked, currently profile-valid roots of the snapshot. The system\n194|// pool is never consulted. Revoked or expired entries are excluded;\n195|// activation refuses when the remaining authority list overflows.\n196|func EnrollmentPool(snapshot hosttrust.Snapshot, now time.Time) (*x509.CertPool, error) {\n197|\tpool := x509.NewCertPool()\n198|\tvar subjects [][]byte\n199|\tfor _, entry := range snapshot.Trust.Entries {\n200|\t\tif entry.State == hosttrust.EntryRevoked {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
