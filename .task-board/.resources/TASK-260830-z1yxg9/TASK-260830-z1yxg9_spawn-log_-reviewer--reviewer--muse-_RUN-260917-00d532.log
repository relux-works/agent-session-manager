{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c887","stream":{"kind":"session","id":"01a0ae3f-54f0-7453-97f2-3b7774743ad2"},"sequence":670,"recorded_at":1780531400001335,"record_type":"event","durability":"durable","causation_id":"932cad06-180f-40c2-8da9-e768b00b3c3d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"932cad06-180f-40c2-8da9-e768b00b3c3d","run_stream":{"kind":"run","id":"932cad06-180f-40c2-8da9-e768b00b3c3d"},"task_stream":{"kind":"task","id":"01a0ae41-9ec9-74f3-bfb8-5494bbaa6474"},"task_id":"01a0ae41-9ec9-74f3-bfb8-5494bbaa6474","event":{"kind":"output","task_id":"01a0ae41-9ec9-74f3-bfb8-5494bbaa6474","chunk":"Read text file `internal/hostchannel/launch.go`.\n1|package hostchannel\n2|\n3|import (\n4|\t\"fmt\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/config\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/peeridentity\"\n8|)\n9|\n10|// ServeArgv is the exact remote responder invocation of Section 11.10.1.\n11|// The version member must equal config.HostChannelVersion; a test pins\n12|// that equality so the two cannot drift.\n13|var ServeArgv = []string{\"ax\", \"rpc\", \"serve\", \"--stdio\", \"--host-channel\", \"1.0.0\"}\n14|\n15|// LaunchArgv extends the Section 11.1 fixed SSH command of a configured\n16|// target with the explicit host-channel flag. It starts no process.\n17|func LaunchArgv(target peeridentity.Target) ([]string, error) {\n18|\targv, err := target.RPCArgv()\n19|\tif err != nil {\n20|\t\treturn nil, err\n21|\t}\n22|\treturn append(argv, \"--host-channel\", \"1.0.0\"), nil\n23|}\n24|\n25|// LaunchForConfig selects the host-channel launch for one configured peer\n26|// under Configuration 4 only: the snapshot must be a version-4 document\n27|// carrying a host-channel credential binding. Older documents refuse;\n28|// there is no legacy fallback on this path.\n29|func LaunchForConfig(snapshot config.Snapshot, selector string) ([]string, error) {\n30|\tloaded, ok := snapshot.Configuration()\n31|\tif !ok {\n32|\t\treturn nil, fmt.Errorf(\"%w: no configuration selected\", ErrInvalidConfig)\n33|\t}\n34|\tif loaded.SourceVersion != config.Version4 {\n35|\t\treturn nil, fmt.Errorf(\"%w: host channel requires Configuration 4\", ErrInvalidConfig)\n36|\t}\n37|\tif loaded.Value.Mesh.HostChannel == nil {\n38|\t\treturn nil, fmt.Errorf(\"%w: Configuration 4 carries no host-channel binding\", ErrInvalidConfig)\n39|\t}\n40|\tdirectory, err := peeridentity.FromSnapshot(snapshot)\n41|\tif err != nil {\n42|\t\treturn nil, err\n43|\t}\n44|\ttarget, err := directory.Resolve(selector)\n45|\tif err != nil {\n46|\t\treturn nil, err\n47|\t}\n48|\treturn LaunchArgv(target)\n49|}","final_result":true}}}
