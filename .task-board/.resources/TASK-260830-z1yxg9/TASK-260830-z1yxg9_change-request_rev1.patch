+func loadSnapshot(t *testing.T, document string) config.Snapshot {
+	t.Helper()
+	directory := t.TempDir()
+	filename := filepath.Join(directory, "config.toml")
+	if err := os.WriteFile(filename, []byte(document), 0o600); err != nil {
+		t.Fatalf("WriteFile: %v", err)
