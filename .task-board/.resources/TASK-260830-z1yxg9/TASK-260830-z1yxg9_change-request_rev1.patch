+// countingStream measures hostile-path intake.
+type countingStream struct {
+	net.Conn
+	reads atomic.Int64
+}
+
+func (s *countingStream) Read(data []byte) (int, error) {
+	n, err := s.Conn.Read(data)
+	s.reads.Add(int64(n))
+	return n, err
+}
