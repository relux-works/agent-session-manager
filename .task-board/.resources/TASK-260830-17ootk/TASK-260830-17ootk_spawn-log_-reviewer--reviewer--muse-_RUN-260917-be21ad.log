{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ce8d","stream":{"kind":"session","id":"01a0ae83-44da-79a0-be6d-cdb96bee744a"},"sequence":1441,"recorded_at":1780531400002877,"record_type":"event","durability":"durable","causation_id":"43909339-e6a4-48a8-9111-b9f3b1e533e8","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"43909339-e6a4-48a8-9111-b9f3b1e533e8","run_stream":{"kind":"run","id":"43909339-e6a4-48a8-9111-b9f3b1e533e8"},"call_id":"call_01a0ae8816bd763c867f6270931559b9","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-2rqigd/worktree/internal/crashgate/conformance_test.go`.\n(362 line(s) above)\n363|func driveJournalPrepareOp(t *testing.T, boundary, path, recoverPath, variant string) ConformanceRecord {\n364|\tt.Helper()\n365|\tconst closure = \"composite\"\n366|\tstore, dataDir := journalDirs(t)\n367|\tmustCreate(t, store, compositeInputs())\n368|\tinterrupted := errors.New(\"crash after the prepare operation\")\n369|\tswitch variant {\n370|\tcase \"provider_half\":\n371|\t\tstore.AfterJournal = func() error { return interrupted }\n372|\t\tif _, err := store.UpdateProvider(testMatID, preparedProvider()); !errors.Is(err, interrupted) {\n373|\t\t\tt.Fatalf(\"UpdateProvider fault = %v, want the interior fault\", err)\n374|\t\t}\n375|\t\trestarted := reopenJournal(t, dataDir)\n376|\t\tloaded, _, err := restarted.Get(testMatID)\n377|\t\tif err != nil {\n378|\t\t\tt.Fatal(err)\n379|\t\t}\n380|\t\tif loaded.Provider == nil || loaded.Provider.State != matjournal.ProviderPrepared || loaded.Provider.RollbackToken == nil {\n381|\t\t\tt.Fatalf(\"provider = %+v, want the durable prepared token\", loaded.Provider)\n382|\t\t}\n383|\t\tevidence := recoverMust(t, restarted, matjournal.BoundaryAfterPrepareOp, recoverPath, nil, matjournal.OutcomeSafeRetry, \"Recover(\"+boundary+\")\")\n384|\t\treturn recordFromEvidence(boundary, path, matjournal.BoundaryAfterPrepareOp, closure, variant, DriverJournalPrepareOp, evidence)\n385|\tcase \"bridge_half\":\n386|\t\tstore.AfterJournal = func() error { return interrupted }\n387|\t\tif _, err := store.UpdateTaskBoard(testMatID, importedBoard()); !errors.Is(err, interrupted) {\n388|\t\t\tt.Fatalf(\"UpdateTaskBoard fault = %v, want the interior fault\", err)\n389|\t\t}\n390|\t\trestarted := reopenJournal(t, dataDir)\n391|\t\tloaded, _, err := restarted.Get(testMatID)\n392|\t\tif err != nil {\n393|\t\t\tt.Fatal(err)\n394|\t\t}\n395|\t\tif loaded.TaskBoard.State != matjournal.BoardImported || loaded.TaskBoard.ImportToken == nil {\n396|\t\t\tt.Fatalf(\"task-board = %+v, want the durable imported state\", loaded.TaskBoard)\n397|\t\t}\n398|\t\tevidence := recoverMust(t, restarted, matjournal.BoundaryAfterPrepareOp, recoverPath, func(input *matjournal.RecoveryInput) {\n399|\t\t\tinput.Bridge.State = matjournal.BoardImported\n400|\t\t}, matjournal.OutcomeSafeRetry, \"Recover(\"+boundary+\")\")\n401|\t\treturn recordFromEvidence(boundary, path, matjournal.BoundaryAfterPrepareOp, closure, variant, DriverJournalPrepareOp, evidence)\n402|\tcase \"rollback_failed\":\n403|\t\tif _, err := store.UpdateProvider(testMatID, preparedProvider()); err != nil {\n404|\t\t\tt.Fatal(err)\n405|\t\t}\n406|\t\tif _, err := store.UpdateTaskBoard(testMatID, importedBoard()); err != nil {\n407|\t\t\tt.Fatal(err)\n408|\t\t}\n409|\t\trestarted := reopenJournal(t, dataDir)\n410|\t\tevidence := recoverMust(t, restarted, matjournal.BoundaryAfterPrepareOp, recoverPath, func(input *matjournal.RecoveryInput) {\n411|\t\t\tinput.Bridge.State = matjournal.BoardFailed\n412|\t\t\tinput.Bridge.Failed = true\n413|\t\t\tinput.Bridge.LeaseActive = false\n414|\t\t}, matjournal.OutcomeExplicitRollback, \"Recover(\"+boundary+\")\")\n415|\t\tloaded, _, err := restarted.Get(testMatID)\n416|\t\tif err != nil {\n417|\t\t\tt.Fatal(err)\n418|\t\t}\n419|\t\tif loaded.Phase != matjournal.PhaseRolledBack || len(loaded.LastError) == 0 {\n420|\t\t\tt.Fatalf(\"phase = %q last_error = %s, want the terminal rollback\", loaded.Phase, loaded.LastError)\n421|\t\t}\n422|\t\treturn recordFromEvidence(boundary, path, matjournal.BoundaryAfterPrepareOp, closure, variant, DriverJournalPrepareOp, evidence)\n423|\tdefault:\n424|\t\tt.Fatalf(\"unknown prepare-op variant %q\", variant)\n425|\t\treturn ConformanceRecord{}\n426|\t}\n427|}\n428|\n429|// walkCompositeToValidating drives a composite journal through\n430|// provider prepared, both authorities prepared, bridge imported and\n431|// opened, and the staging-to-validating transition.\n432|func walkCompositeToValidating(t *testing.T, store *matjournal.Store) {\n433|\tt.Helper()\n434|\tif _, err := store.UpdateProvider(testMatID, preparedProvider()); err != nil {\n435|\t\tt.Fatalf(\"UpdateProvider error = %v\", err)\n436|\t}\n437|\tproviderRoot := testTxRoot + \"/backups/codex_sessions\"\n438|\tif _, err := store.UpdateAuthority(testMatID, \"codex_sessions\", matjournal.AuthorityState{\n439|\t\tRootPath: testRootProvider, CompletedSequences: []uint64{2}, RollbackRoot: &providerRoot, State: matjournal.AuthorityPrepared,\n440|\t}); err != nil {\n441|\t\tt.Fatalf(\"UpdateAuthority error = %v\", err)\n442|\t}\n443|\tworkspaceRoot := \"/home/ivan/.local/state/ax/materializations/\" + testMatID + \"/workspace_relux\"\n444|\tif _, err := store.UpdateAuthority(testMatID, \"workspace_relux\", matjournal.AuthorityState{\n445|\t\tRootPath: testRootWorkspace, CompletedSequences: []uint64{1}, RollbackRoot: &workspaceRoot, State: matjournal.AuthorityPrepared,\n446|\t}); err != nil {\n447|\t\tt.Fatalf(\"UpdateAuthority error = %v\", err)\n448|\t}\n449|\tif _, err := store.UpdateTaskBoard(testMatID, importedBoard()); err != nil {\n450|\t\tt.Fatalf(\"UpdateTaskBoard error = %v\", err)\n451|\t}\n452|\tif _, err := store.UpdateTaskBoard(testMatID, openedBoard()); err != nil {\n453|\t\tt.Fatalf(\"UpdateTaskBoard error = %v\", err)\n454|\t}\n455|\tif _, err := store.Transition(testMatID, matjournal.PhaseValidating, matjournal.TransitionOpts{}); err != nil {\n456|\t\tt.Fatalf(\"Transition error = %v\", err)\n457|\t}\n458|}\n459|\n460|// walkDirectProviderToValidating drives a direct closure with a\n461|// provider branch through provider prepared, both authorities\n462|// prepared, and the staging-to-validating transition.\n463|func walkDirectProviderToValidating(t *testing.T, store *matjournal.Store) {\n464|\tt.Helper()\n465|\tif _, err := store.UpdateProvider(testMatID, preparedProvider()); err != nil {\n466|\t\tt.Fatalf(\"UpdateProvider error = %v\", err)\n467|\t}\n468|\tproviderRoot := testTxRoot + \"/backups/codex_sessions\"\n469|\tif _, err := store.UpdateAuthority(testMatID, \"codex_sessions\", matjournal.AuthorityState{\n470|\t\tRootPath: testRootProvider, CompletedSequences: []uint64{2}, RollbackRoot: &providerRoot, State: matjournal.AuthorityPrepared,\n471|\t}); err != nil {\n472|\t\tt.Fatalf(\"UpdateAuthority error = %v\", err)\n473|\t}\n474|\tworkspaceRoot := \"/home/ivan/.local/state/ax/materializations/\" + testMatID + \"/workspace_relux\"\n475|\tif _, err := store.UpdateAuthority(testMatID, \"workspace_relux\", matjournal.AuthorityState{\n476|\t\tRootPath: testRootWorkspace, CompletedSequences: []uint64{1}, RollbackRoot: &workspaceRoot, State: matjournal.AuthorityPrepared,\n477|\t}); err != nil {\n478|\t\tt.Fatalf(\"UpdateAuthority error = %v\", err)\n479|\t}\n480|\tif _, err := store.Transition(testMatID, matjournal.PhaseValidating, matjournal.TransitionOpts{}); err != nil {\n481|\t\tt.Fatalf(\"Transition error = %v\", err)\n482|\t}\n483|}\n484|\n485|// driveJournalToPrepared crashes after the bridge open or after the\n486|// host commit enters prepared.\n487|func driveJournalToPrepared(t *testing.T, boundary, path, recoverPath, closure, variant string) ConformanceRecord {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
