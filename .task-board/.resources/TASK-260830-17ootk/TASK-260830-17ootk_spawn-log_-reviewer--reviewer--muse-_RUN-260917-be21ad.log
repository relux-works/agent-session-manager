 || durable.Remediation == \"\" {\n32|\t\tt.Fatalf(\"%s durable evidence = %+v, want the parked refusal with reason and remediation\", what, durable)\n33|\t}\n34|\tif durable.Boundary != evidence.Boundary || durable.Reason != evidence.Reason {\n35|\t\tt.Fatalf(\"%s durable evidence diverges from the returned evidence\", what)\n36|\t}\n37|\tloaded, _, err := mustOpenJournal(t, dataDir).Get(testMatID)\n38|\tif err != nil {\n39|\t\tt.Fatal(err)\n40|\t}\n41|\tif loaded.Phase != beforePhase {\n42|\t\tt.Fatalf(\"%s phase = %q, want the frozen %q\", what, loaded.Phase, beforePhase)\n43|\t}\n44|\tif len(loaded.LastError) == 0 || string(loaded.LastError) == \"null\" {\n45|\t\tt.Fatalf(\"%s last_error is empty, want the blocking reason recorded\", what)\n46|\t}\n47|\tif loaded.PrepareOperationID != testPrepareOp {\n48|\t\tt.Fatalf(\"%s prepare operation drifted to %q\", what, loaded.PrepareOperationID)\n49|\t}\n50|}\n51|\n52|// mustOpenJournal opens a read handle over a data directory.\n53|func mustOpenJournal(t *testing.T, dataDir string) *matjournal.Store {\n54|\tt.Helper()\n55|\tstore, err := matjournal.Open(dataDir)\n56|\tif err != nil {\n57|\t\tt.Fatal(err)\n58|\t}\n59|\tstore.Now = fixedClock\n60|\treturn store\n61|}\n62|\n63|// TestCrashGateRejections proves the gate refuses every forbidden\n64|// recovery as any successful outcome: two live authorities, an\n65|// unfenced external continuation, and every substitution shape\n66|// (new-session launch, fresh native handle, relabelled blank\n67|// state, different realm, moved lease) fail closed to\n68|// recoverable_parked_state through the production Recover entry,\n69|// never to safe_retry or explicit_rollback.\n70|func TestCrashGateRejections(t *testing.T) {\n71|\tstagingComposite := func(t *testing.T) (string, string) {\n72|\t\tstore, dataDir := journalDirs(t)\n73|\t\tmustCreate(t, store, compositeInputs())\n74|\t\tif _, err := store.UpdateProvider(testMatID, preparedProvider()); err != nil {\n75|\t\t\tt.Fatal(err)\n76|\t\t}\n77|\t\treturn dataDir, matjournal.PhaseStaging\n78|\t}\n79|\tcommittingAdopted := func(t *testing.T) (string, string) {\n80|\t\tstore, dataDir := activationSetup(t)\n81|\t\tif _, err := store.UpdateTaskBoard(testMatID, adoptedBoard()); err != nil {\n82|\t\t\tt.Fatal(err)\n83|\t\t}\n84|\t\treturn dataDir, matjournal.PhaseCommitting\n85|\t}\n86|\tfreshSession := \"tbm:manager:0198f4c8-9f60-7a11-8b3c-9999999999ab:\" + testLeaseID\n87|\tfreshHandle := \"tbm:manager:0198f4c8-7a10-7b22-8b3c-2234567890ac:\" + testLeaseID\n88|\totherRealm := \"tbm:manager:0198f4c8-7a10-7b22-8b3c-2234567890ab:\" + testLeaseB\n89|\tcases := []struct {\n90|\t\tname     string\n91|\t\tsetup    func(t *testing.T) (string, string)\n92|\t\tboundary string\n93|\t\tmutate   func(*matjournal.RecoveryInput)\n94|\t\treason   string\n95|\t}{\n96|\t\t{\"two_live_authorities\", stagingComposite, matjournal.BoundaryAfterPrepareOp, func(input *matjournal.RecoveryInput) {\n97|\t\t\tinput.Provider.State = matjournal.ProviderCommitted\n98|\t\t\tinput.Bridge.Live = true\n99|\t\t\tinput.Bridge.BindingMatches = false\n100|\t\t}, \"two live authorities\"},\n101|\t\t{\"unfenced_continuation\", committingAdopted, matjournal.BoundaryAfterActivation, func(input *matjournal.RecoveryInput) {\n102|\t\t\tinput.Bridge.State = matjournal.BoardAdopted\n103|\t\t\tinput.Bridge.Live = true\n104|\t\t\tinput.Bridge.LeaseActive = false\n105|\t\t\tinput.Bridge.BindingMatches = true\n106|\t\t\tinput.Bridge.ManagerMatches = true\n107|\t\t\tinput.NativeKnown = true\n108|\t\t\tinput.NativeBefore, input.NativeAfter = testNative, testNative\n109|\t\t}, \"unfenced continuation\"},\n110|\t\t{\"unfenced_state_liveness\", committingAdopted, matjournal.BoundaryAfterActivation, func(input *matjournal.RecoveryInput) {\n111|\t\t\tinput.Bridge.State = \"running\"\n112|\t\t\tinput.Bridge.Live = false\n113|\t\t\tinput.Bridge.LeaseActive = false\n114|\t\t\tinput.Bridge.BindingMatches = true\n115|\t\t\tinput.Bridge.ManagerMatches = true\n116|\t\t\tinput.NativeKnown = true\n117|\t\t\tinput.NativeBefore, input.NativeAfter = testNative, testNative\n118|\t\t}, \"unfenced continuation\"},\n119|\t\t{\"new_session_launch\", committingAdopted, matjournal.BoundaryAfterActivation, func(input *matjournal.RecoveryInput) {\n120|\t\t\tinput.Bridge.State = matjournal.BoardAdopted\n121|\t\t\tinput.Bridge.LeaseActive = true\n122|\t\t\tinput.Bridge.BindingMatches = true\n123|\t\t\tinput.Bridge.ManagerMatches = true\n124|\t\t\tinput.NativeKnown = true\n125|\t\t\tinput.NativeBefore, input.NativeAfter = testNative, freshSession\n126|\t\t}, \"substitution\"},\n127|\t\t{\"fresh_native_handle\", committingAdopted, matjournal.BoundaryAfterActivation, func(input *matjournal.RecoveryInput) {\n128|\t\t\tinput.Bridge.State = matjournal.BoardAdopted\n129|\t\t\tinput.Bridge.LeaseActive = true\n130|\t\t\tinput.Bridge.BindingMatches = true\n131|\t\t\tinput.Bridge.ManagerMatches = true\n132|\t\t\tinput.NativeKnown = true\n133|\t\t\tinput.NativeBefore, input.NativeAfter = testNative, freshHandle\n134|\t\t}, \"substitution\"},\n135|\t\t{\"blank_relabel\", committingAdopted, matjournal.BoundaryAfterActivation, func(input *matjournal.RecoveryInput) {\n136|\t\t\tinput.Bridge.State = matjournal.BoardAdopted\n137|\t\t\tinput.Bridge.LeaseActive = true\n138|\t\t\tinput.Bridge.BindingMatches = true\n139|\t\t\tinput.Bridge.ManagerMatches = true\n140|\t\t\tinput.NativeKnown = true\n141|\t\t\tinput.NativeBefore, input.NativeAfter = testNative, \"\"\n142|\t\t}, \"substitution\"},\n143|\t\t{\"different_realm\", committingAdopted, matjournal.BoundaryAfterActivation, func(input *matjournal.RecoveryInput) {\n144|\t\t\tinput.Bridge.State = matjournal.BoardAdopted\n145|\t\t\tinput.Bridge.LeaseActive = true\n146|\t\t\tinput.Bridge.BindingMatches = true\n147|\t\t\tinput.Bridge.ManagerMatches = true\n148|\t\t\tinput.NativeKnown = true\n149|\t\t\tinput.NativeBefore, input.NativeAfter = testNative, otherRealm\n150|\t\t}, \"substitution\"},\n151|\t\t{\"lease_moved_forward\", stagingComposite, matjournal.BoundaryAfterPrepareOp, func(input *matjournal.RecoveryInput) {\n152|\t\t\tinput.LeaseAfter = matjournal.LeaseIdentity{Epoch: 5, ID: testLeaseID}\n153|\t\t}, \"winning lease moved\"},\n154|\t\t{\"lease_moved_backward\", stagingComposite, matjournal.BoundaryAfterPrepareOp, func(input *matjournal.RecoveryInput) {\n155|\t\t\tinput.LeaseAfter = matjournal.LeaseIdentity{Epoch: 3, ID: testLeaseID}\n156|\t\t}, \"winning lease moved\"},\n157|\t\t{\"lease_moved_id\", stagingComposite, matjournal.BoundaryAfterPrepareOp, func(input *matjournal.RecoveryInput) {\n158|\t\t\tinput.LeaseAfter = matjournal.LeaseIdentity{Epoch: 4, ID: testLeaseB}\n159|\t\t}, \"winning lease moved\"},\n160|\t}\n161|\tfor _, tc := range cases {\n162|\t\tt.Run(tc.name, func(t *testing.T) {\n163|\t\t\tdataDir, phase := tc.setup(t)\n164|\t\t\trestarted := reopenJournal(t, dataDir)\n165|\t\t\tinput := baseRecoveryInput()\n166|\t\t\tinput.Boundary = tc.boundary\n167|\t\t\tinput.Path = matjournal.PathOwnerResume\n168|\t\t\ttc.mutate(&input)\n169|\t\t\toutcome, evidence, err := restarted.Recover(testMatID, input)\n170|\t\t\tif err != nil {\n171|\t\t\t\tt.Fatalf(\"Recover error = %v\", err)\n172|\t\t\t}\n173|\t\t\tmustOutcome(t, outcome, matjournal.OutcomeRecoverableParked, \"Recover(\"+tc.name+\")\")\n174|\t\t\tmustJournalEvidenceComplete(t, evidence, \"Recover(\"+tc.name+\")\")\n175|\t\t\tif !strings.Contains(evidence.Reason, tc.reason) {\n176|\t\t\t\tt.Fatalf(\"reason = %q, want %q\", evidence.Reason, tc.reason)\n177|\t\t\t}\n178|\t\t\tif strings.Contains(tc.reason, \"substitution\") && !strings.Contains(evidence.Remediation, \"fresh handle\") {\n179|\t\t\t\tt.Fatalf(\"remediation = %q, want the fresh-handle prohibition\", evidence.Remediation)\n180|\t\t\t}\n181|\t\t\tparkedMustFailClosed(t, dataDir, phase, evidence, \"Recover(\"+tc.name+\")\")\n182|\t\t\tloaded, _, err := restarted.Get(testMatID)\n183|\t\t\tif err != nil {\n184|\t\t\t\tt.Fatal(err)\n185|\t\t\t}\n186|\t\t\tif tc.setup != nil && loaded.TaskBoard != nil && loaded.TaskBoard.State == matjournal.BoardAdopted {\n187|\t\t\t\tif loaded.TaskBoard.ManagerSessionRef == nil || *loaded.TaskBoard.ManagerSessionRef != \"tbm:manager:0198f4c8-7a10-7b22-8b3c-2234567890ab\" {\n188|\t\t\t\t\tt.Fatalf(\"manager reference moved: %+v\", loaded.TaskBoard.ManagerSessionRef)\n189|\t\t\t\t}\n190|\t\t\t}\n191|\t\t})\n192|\t}\n193|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
