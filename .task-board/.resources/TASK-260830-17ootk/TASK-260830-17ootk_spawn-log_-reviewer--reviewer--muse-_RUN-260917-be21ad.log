{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cfaf","stream":{"kind":"session","id":"01a0ae83-44da-79a0-be6d-cdb96bee744a"},"sequence":1586,"recorded_at":1780531400003167,"record_type":"event","durability":"durable","causation_id":"43909339-e6a4-48a8-9111-b9f3b1e533e8","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"43909339-e6a4-48a8-9111-b9f3b1e533e8","run_stream":{"kind":"run","id":"43909339-e6a4-48a8-9111-b9f3b1e533e8"},"task_stream":{"kind":"task","id":"01a0ae88-a223-7081-8ede-263fe223dc5c"},"task_id":"01a0ae88-a223-7081-8ede-263fe223dc5c","event":{"kind":"output","task_id":"01a0ae88-a223-7081-8ede-263fe223dc5c","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-2rqigd/worktree/internal/crashgate/conformance_test.go`.\n(486 line(s) above)\n487|func driveJournalToPrepared(t *testing.T, boundary, path, recoverPath, closure, variant string) ConformanceRecord {\n488|\tt.Helper()\n489|\tstore, dataDir := journalDirs(t)\n490|\tmustCreate(t, store, closureInputs(t, closure))\n491|\tinterrupted := errors.New(\"crash entering prepared\")\n492|\tswitch variant {\n493|\tcase \"bridge_open\", \"bridge_open_uncertain\":\n494|\t\tif _, err := store.UpdateTaskBoard(testMatID, importedBoard()); err != nil {\n495|\t\t\tt.Fatal(err)\n496|\t\t}\n497|\t\tstore.AfterJournal = func() error { return interrupted }\n498|\t\tif _, err := store.UpdateTaskBoard(testMatID, openedBoard()); !errors.Is(err, interrupted) {\n499|\t\t\tt.Fatalf(\"UpdateTaskBoard fault = %v, want the interior fault\", err)\n500|\t\t}\n501|\t\trestarted := reopenJournal(t, dataDir)\n502|\t\tloaded, _, err := restarted.Get(testMatID)\n503|\t\tif err != nil {\n504|\t\t\tt.Fatal(err)\n505|\t\t}\n506|\t\tif loaded.TaskBoard.State != matjournal.BoardOpened {\n507|\t\t\tt.Fatalf(\"task-board = %q\", loaded.TaskBoard.State)\n508|\t\t}\n509|\t\tif variant == \"bridge_open_uncertain\" {\n510|\t\t\t// The provider prepare may have executed unrecorded\n511|\t\t\t// and its status is unknown: recovery parks\n512|\t\t\t// instead of guessing.\n513|\t\t\tevidence := recoverMust(t, restarted, matjournal.BoundaryAfterOpen, recoverPath, func(input *matjournal.RecoveryInput) {\n514|\t\t\t\tinput.Provider.State = matjournal.ProviderUnknown\n515|\t\t\t\tinput.Bridge.State = matjournal.BoardOpened\n516|\t\t\t}, matjournal.OutcomeRecoverableParked, \"Recover(\"+boundary+\")\")\n517|\t\t\treturn recordFromEvidence(boundary, path, matjournal.BoundaryAfterOpen, closure, variant, DriverJournalToPrepared, evidence)\n518|\t\t}\n519|\t\tevidence := recoverMust(t, restarted, matjournal.BoundaryAfterOpen, recoverPath, func(input *matjournal.RecoveryInput) {\n520|\t\t\tinput.Bridge.State = matjournal.BoardOpened\n521|\t\t}, matjournal.OutcomeSafeRetry, \"Recover(\"+boundary+\")\")\n522|\t\treturn recordFromEvidence(boundary, path, matjournal.BoundaryAfterOpen, closure, variant, DriverJournalToPrepared, evidence)\n523|\tcase \"host_prepared\", \"direct_host\", \"direct_provider_host\":\n524|\t\tswitch closure {\n525|\t\tcase \"composite\":\n526|\t\t\twalkCompositeToValidating(t, store)\n527|\t\tcase \"direct_provider\":\n528|\t\t\twalkDirectProviderToValidating(t, store)\n529|\t\tdefault:\n530|\t\t\tif _, err := store.Transition(testMatID, matjournal.PhaseValidating, matjournal.TransitionOpts{}); err != nil {\n531|\t\t\t\tt.Fatal(err)\n532|\t\t\t}\n533|\t\t}\n534|\t\tstore.AfterJournal = func() error { return interrupted }\n535|\t\tif _, err := store.Transition(testMatID, matjournal.PhasePrepared, matjournal.TransitionOpts{}); !errors.Is(err, interrupted) {\n536|\t\t\tt.Fatalf(\"Transition fault = %v, want the interior fault\", err)\n537|\t\t}\n538|\t\trestarted := reopenJournal(t, dataDir)\n539|\t\tloaded, _, err := restarted.Get(testMatID)\n540|\t\tif err != nil {\n541|\t\t\tt.Fatal(err)\n542|\t\t}\n543|\t\tif loaded.Phase != matjournal.PhasePrepared {\n544|\t\t\tt.Fatalf(\"phase = %q, want prepared\", loaded.Phase)\n545|\t\t}\n546|\t\tevidence := recoverMust(t, restarted, matjournal.BoundaryAfterOpen, recoverPath, func(input *matjournal.RecoveryInput) {\n547|\t\t\tswitch closure {\n548|\t\t\tcase \"composite\":\n549|\t\t\t\tinput.Bridge.State = matjournal.BoardOpened\n550|\t\t\tcase \"direct\":\n551|\t\t\t\tinput.Provider.State = matjournal.ProviderUnknown\n552|\t\t\t}\n553|\t\t}, matjournal.OutcomeSafeRetry, \"Recover(\"+boundary+\")\")\n554|\t\treturn recordFromEvidence(boundary, path, matjournal.BoundaryAfterOpen, closure, variant, DriverJournalToPrepared, evidence)\n555|\tdefault:\n556|\t\tt.Fatalf(\"unknown to-prepared variant %q\", variant)\n557|\t\treturn ConformanceRecord{}\n558|\t}\n559|}\n560|\n561|// activationSetup drives a composite journal to the committing\n562|// phase: the pre-activation durable state.\n563|func activationSetup(t *testing.T) (*matjournal.Store, string) {\n564|\tt.Helper()\n565|\tstore, dataDir := journalDirs(t)\n566|\tmustCreate(t, store, compositeInputs())\n(more lines below)","final_result":true}}}
