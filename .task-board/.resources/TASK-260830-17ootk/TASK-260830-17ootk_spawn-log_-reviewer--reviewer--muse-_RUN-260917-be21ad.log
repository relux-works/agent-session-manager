nstalled file %s does not attest: %v\", entry.Name(), err)\n313|\t\t}\n314|\t}\n315|}\n316|\n317|// journalFilesExist reports whether the journal and at least one\n318|// prepare receipt exist for the test materialization.\n319|func journalFilesExist(t *testing.T, dataDir string) (journal, receipt bool) {\n320|\tt.Helper()\n321|\tmatDir := filepath.Join(dataDir, \"materializations\", testMatID)\n322|\tif _, err := os.Stat(filepath.Join(matDir, \"journal.json\")); err == nil {\n323|\t\tjournal = true\n324|\t}\n325|\tentries, err := os.ReadDir(filepath.Join(matDir, \"operations\"))\n326|\tif err == nil && len(entries) > 0 {\n327|\t\treceipt = true\n328|\t}\n329|\treturn journal, receipt\n330|}\n331|\n332|func testRequestBody() []byte {\n333|\treturn []byte(`{\"materialization_id\":\"` + testMatID + `\",\"operation_id\":\"` + testPrepareOp + `\",\"plan_id\":\"` + testPlanID + `\"}`)\n334|}\n335|\n336|// directInputs returns the workspace-only prepare closure: no\n337|// provider branch, no bridge.\n338|func directInputs() matjournal.CreateInputs {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cf2d","stream":{"kind":"session","id":"01a0ae83-44da-79a0-be6d-cdb96bee744a"},"sequence":1521,"recorded_at":1780531400003037,"record_type":"event","durability":"durable","causation_id":"43909339-e6a4-48a8-9111-b9f3b1e533e8","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"43909339-e6a4-48a8-9111-b9f3b1e533e8","run_stream":{"kind":"run","id":"43909339-e6a4-48a8-9111-b9f3b1e533e8"},"call_id":"call_01a0ae88500d71a5a12f47eeb832b240","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-2rqigd/worktree/internal/crashgate/helpers_test.go`.\n(596 line(s) above)\n597|func testLease() matjournal.LeaseIdentity {\n598|\treturn matjournal.LeaseIdentity{Epoch: 4, ID: testLeaseID}\n599|}\n600|\n601|// baseRecoveryInput returns the consistent probe closure: prepared\n602|// provider status with agreement, no bridge effect, no marker, a\n603|// healthy host, and the unchanged winning lease.\n604|func baseRecoveryInput() matjournal.RecoveryInput {\n605|\tlease := testLease()\n606|\treturn matjournal.RecoveryInput{\n607|\t\tBoundary:    matjournal.BoundaryAfterPrepare,\n608|\t\tPath:        matjournal.PathOwnerResume,\n609|\t\tProvider:    matjournal.ProviderProbe{State: matjournal.ProviderPrepared, IDsMatch: true, PlanMatches: true, TokenMatches: true},\n610|\t\tBridge:      matjournal.BridgeProbe{State: matjournal.BoardNotStarted},\n611|\t\tMarker:      matjournal.MarkerAbsent,\n612|\t\tHost:        matjournal.HostOK,\n613|\t\tLeaseKnown:  true,\n614|\t\tLeaseBefore: lease,\n615|\t\tLeaseAfter:  lease,\n616|\t}\n617|}\n618|\n619|// mustOutcome asserts the exact outcome and the never-fourth-outcome\n620|// rule.\n621|func mustOutcome(t *testing.T, got, want matjournal.Outcome, what string) {\n622|\tt.Helper()\n623|\tswitch got {\n624|\tcase matjournal.OutcomeSafeRetry, matjournal.OutcomeExplicitRollback, matjournal.OutcomeRecoverableParked:\n625|\tdefault:\n626|\t\tt.Fatalf(\"%s outcome = %q, want one of the three Section 13.13 outcomes\", what, got)\n627|\t}\n628|\tif got != want {\n629|\t\tt.Fatalf(\"%s outcome = %q, want %q\", what, got, want)\n630|\t}\n631|}\n632|\n633|// mustJournalEvidenceComplete asserts the Section 13.13 evidence\n634|// record names every required fact: boundary ID, path, pre/post\n635|// durable facts, external effect and status probe, winning lease\n636|// before/after, selected outcome, and the satisfying evidence. The\n637|// CR-MAT-01 record carries no operation IDs or phases because no\n638|// journal exists; every other record must name them.\n639|func mustJournalEvidenceComplete(t *testing.T, evidence matjournal.Evidence, what string) {\n640|\tt.Helper()\n641|\tif evidence.Boundary == \"\" || evidence.Path == \"\" {\n642|\t\tt.Fatalf(\"%s evidence lacks boundary or path: %+v\", what, evidence)\n643|\t}\n644|\tif evidence.Boundary != matjournal.BoundaryBeforeCreate && len(evidence.OperationIDs) == 0 {\n645|\t\tt.Fatalf(\"%s evidence lacks operation IDs: %+v\", what, evidence)\n646|\t}\n647|\tif evidence.Boundary != matjournal.BoundaryBeforeCreate && (evidence.PhaseBefore == \"\" || evidence.PhaseAfter == \"\") {\n648|\t\tt.Fatalf(\"%s evidence lacks pre/post durable facts: %+v\", what, evidence)\n649|\t}\n650|\tif evidence.Reason == \"\" || evidence.Remediation == \"\" || evidence.DecidedAt == \"\" {\n651|\t\tt.Fatalf(\"%s evidence lacks reason, remediation, or decided_at: %+v\", what, evidence)\n652|\t}\n653|\tif evidence.LeaseBefore.Epoch == 0 || evidence.LeaseAfter.Epoch == 0 {\n654|\t\tt.Fatalf(\"%s evidence lacks the winning lease before/after: %+v\", what, evidence)\n655|\t}\n656|\tswitch evidence.Selected {\n657|\tcase matjournal.OutcomeSafeRetry, matjournal.OutcomeExplicitRollback, matjournal.OutcomeRecoverableParked:\n658|\tdefault:\n659|\t\tt.Fatalf(\"%s evidence selects %q, want one of the three outcomes\", what, evidence.Selected)\n660|\t}\n661|}\n662|\n663|// mustCrashFault fails unless err is the injected fault for the\n664|// armed point.\n665|func mustCrashFault(t *testing.T, err error, what string) {\n666|\tt.Helper()\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
