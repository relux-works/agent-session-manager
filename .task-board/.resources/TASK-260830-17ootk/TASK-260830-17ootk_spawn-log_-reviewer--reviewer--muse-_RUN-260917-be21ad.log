UpdateTaskBoard(testMatID, adoptedBoard()); !errors.Is(err, interrupted) {\n586|\t\t\tt.Fatalf(\"UpdateTaskBoard fault = %v, want the interior fault\", err)\n587|\t\t}\n588|\t\trestarted := reopenJournal(t, dataDir)\n589|\t\tevidence := recoverMust(t, restarted, matjournal.BoundaryAfterActivation, recoverPath, func(input *matjournal.RecoveryInput) {\n590|\t\t\tinput.Bridge.State = matjournal.BoardAdopted\n591|\t\t\tinput.Bridge.LeaseActive = true\n592|\t\t\tinput.Bridge.BindingMatches = true\n593|\t\t\tinput.Bridge.ManagerMatches = true\n594|\t\t\tinput.NativeKnown = true\n595|\t\t\tinput.NativeBefore, input.NativeAfter = testNative, testNative\n596|\t\t}, matjournal.OutcomeSafeRetry, \"Recover(\"+boundary+\")\")\n597|\t\tif evidence.OperationIDs[\"adopt_operation_id\"] != testAdoptOp {\n598|\t\t\tt.Fatalf(\"operation IDs = %+v\", evidence.OperationIDs)\n599|\t\t}\n600|\t\treturn recordFromEvidence(boundary, path, matjournal.BoundaryAfterActivation, closure, variant, DriverJournalActivation, evidence)\n601|\tcase \"activation_uncertain\":\n602|\t\trestarted := reopenJournal(t, dataDir)\n603|\t\tevidence := recoverMust(t, restarted, matjournal.BoundaryAfterActivation, recoverPath, func(input *matjournal.RecoveryInput) {\n604|\t\t\tinput.Bridge.State = matjournal.ProviderUnknown\n605|\t\t}, matjournal.OutcomeRecoverableParked, \"Recover(\"+boundary+\")\")\n606|\t\treturn recordFromEvidence(boundary, path, matjournal.BoundaryAfterActivation, closure, variant, DriverJournalActivation, evidence)\n607|\tdefault:\n608|\t\tt.Fatalf(\"unknown activation variant %q\", variant)\n609|\t\treturn ConformanceRecord{}\n610|\t}\n611|}\n612|\n613|// ownershipSetup drives a task-board-only ownership journal to the\n614|// committing phase with its authority converged.\n615|func ownershipSetup(t *testing.T) (*matjournal.Store, string) {\n616|\tt.Helper()\n617|\tstore, dataDir := journalDirs(t)\n618|\tmustCreate(t, store, boardOwnershipInputs())\n619|\tif _, err := store.UpdateTaskBoard(testMatID, importedBoard()); err != nil {\n620|\t\tt.Fatal(err)\n(more lines below)","final_result":true}}}
