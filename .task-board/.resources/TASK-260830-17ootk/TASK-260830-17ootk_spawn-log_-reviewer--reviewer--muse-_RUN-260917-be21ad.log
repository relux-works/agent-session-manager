{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d125","stream":{"kind":"session","id":"01a0ae83-44da-79a0-be6d-cdb96bee744a"},"sequence":1773,"recorded_at":1780531400003541,"record_type":"event","durability":"durable","causation_id":"43909339-e6a4-48a8-9111-b9f3b1e533e8","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"43909339-e6a4-48a8-9111-b9f3b1e533e8","run_stream":{"kind":"run","id":"43909339-e6a4-48a8-9111-b9f3b1e533e8"},"call_id":"call_01a0ae8950c971b1ba281bced9cb5d9c","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-2rqigd/worktree/internal/matjournal/recover.go`.\n(395 line(s) above)\n396|\tif err := writeRecoveryLocked(matDir, evidence); err != nil {\n397|\t\treturn \"\", Evidence{}, err\n398|\t}\n399|\treturn OutcomeRecoverableParked, evidence, nil\n400|}\n401|\n402|// recoveryAssessment carries one recovery decision with its durable\n403|// facts and modeled probes. pendingMarker holds the validated\n404|// destination marker once commitProvable proves the commit.\n405|type recoveryAssessment struct {\n406|\tstore          *Store\n407|\tmatDir         string\n408|\tjournal        *Journal\n409|\tview           planView\n410|\tinput          RecoveryInput\n411|\treceiptPresent bool\n412|\tpendingMarker  *Marker\n413|}\n414|\n415|// decide applies the gate chain and returns the single outcome.\n416|func (assessment *recoveryAssessment) decide() (Outcome, Evidence, error) {\n417|\tjournal := assessment.journal\n418|\tinput := assessment.input\n419|\tterminal := terminalPhase(journal.Phase)\n420|\n421|\t// Rejection gates that park even on a terminal journal: two live\n422|\t// authorities, substitution, and unfenced continuation are never a\n423|\t// successful recovery.\n424|\tif input.LeaseKnown && (input.LeaseAfter.Epoch != input.LeaseBefore.Epoch || input.LeaseAfter.ID != input.LeaseBefore.ID) {\n425|\t\treturn assessment.park(\"lease_conflict\", \"winning lease moved across the crash; reconcile the deterministic winner before any retry\",\n426|\t\t\t\"recompute the winning lease, fence the loser, then re-run recovery with the unchanged winner\")\n427|\t}\n428|\tif assessment.nativeRequired() {\n429|\t\tif !input.NativeKnown {\n430|\t\t\treturn assessment.park(\"operation_uncertain\", \"native identity/binding evidence is missing for an adopted transaction\",\n431|\t\t\t\t\"reconcile the exact persisted provider identity or task-board binding, then re-run recovery\")\n432|\t\t}\n433|\t\tif input.NativeAfter != input.NativeBefore {\n434|\t\t\treturn assessment.park(\"lease_conflict\", \"native identity/binding differs across the crash: substitution is never a successful recovery\",\n435|\t\t\t\t\"restore the exact persisted identity or binding; a fresh handle, blank state, or different realm never recovers this operation\")\n436|\t\t}\n437|\t}\n438|\tif input.Provider.State == ProviderCommitted && input.Provider.PlanMatches && input.Provider.IDsMatch &&\n439|\t\tassessment.bridgeLive() && !input.Bridge.BindingMatches {\n440|\t\treturn assessment.park(\"lease_conflict\", \"two live authorities: the provider committed while a differently bound manager is live\",\n441|\t\t\t\"fence one authority with visible divergent-history evidence, then re-run recovery\")\n442|\t}\n443|\tif assessment.bridgeLive() && !input.Bridge.LeaseActive && assessment.bridgeAdopted() {\n444|\t\treturn assessment.park(\"stale_owner\", \"unfenced continuation: an adopted manager is live without the winning lease\",\n445|\t\t\t\"fence or stop the losing manager with visible evidence, then re-run recovery\")\n446|\t}\n447|\t// Terminal journals return their recorded result once the\n448|\t// authority gates pass: probes cannot reopen them.\n449|\tif terminal {\n450|\t\treturn assessment.completeSafeRetry(\"journal is terminal in %s: returning the recorded result\", journal.Phase)\n451|\t}\n452|\t// Authority and evidence gates for non-terminal journals.\n453|\tif !input.LeaseKnown {\n454|\t\treturn assessment.park(\"operation_uncertain\", \"winning lease evidence is missing\",\n455|\t\t\t\"reconcile the winning lease, then re-run recovery\")\n456|\t}\n457|\tswitch input.Host {\n458|\tcase HostDiskFull:\n459|\t\treturn assessment.park(\"staging_incomplete\", \"destination disk full: existing destination retained, staging partial\",\n460|\t\t\t\"free space, then resume the same operation\")\n461|\tcase HostRenameBlocked:\n462|\t\treturn assessment.park(\"staging_incomplete\", \"atomic rename blocked: staging retained, never overwritten in place\",\n463|\t\t\t\"close the blocking handles, then retry the same operation\")\n464|\t}\n465|\tswitch input.Marker {\n466|\tcase MarkerMismatch:\n467|\t\treturn assessment.park(\"integrity_failure\", \"destination marker disagrees with the journal (MJ-CRASH-MARKER-MISMATCH): quarantined, nothing further mutates\",\n468|\t\t\t\"quarantine the transaction, reconcile the marker against the plan and checkpoint, then re-run recovery\")\n469|\tcase MarkerInvalid:\n470|\t\treturn assessment.park(\"integrity_failure\", \"destination marker is invalid: quarantined, nothing further mutates\",\n471|\t\t\t\"quarantine the transaction, reconcile the marker bytes, then re-run recovery\")\n472|\t}\n473|\tif input.Provider.State == ProviderUnknown && assessment.providerEffectUncertain() {\n474|\t\treturn assessment.park(\"operation_uncertain\", \"provider status is unknown after a possibly executed effect\",\n475|\t\t\t\"call materialize-status with the same IDs until the state is known, then re-run recovery\")\n476|\t}\n477|\tif journal.TaskBoard != nil && input.Bridge.State == ProviderUnknown && assessment.bridgeEffectUncertain() {\n478|\t\treturn assessment.park(\"operation_uncertain\", \"bridge status is unknown after a possibly executed effect\",\n479|\t\t\t\"query bridge status by reference and binding, then re-run recovery\")\n480|\t}\n481|\tif journal.Provider != nil && journal.Provider.State == ProviderPrepared &&\n482|\t\tinput.Provider.State == ProviderPrepared && !input.Provider.TokenMatches {\n483|\t\treturn assessment.park(\"integrity_failure\", \"provider token disagrees between the journal and the status probe\",\n484|\t\t\t\"reconcile the prepared token from the plugin root without allocating a second transaction, then re-run recovery\")\n485|\t}\n486|\tif journal.TaskBoard != nil && (journal.TaskBoard.State == BoardAdopted || journal.TaskBoard.State == BoardResumed) &&\n487|\t\t(assessment.bridgeLive() || input.Bridge.State == BoardAdopted || input.Bridge.State == BoardResumed) &&\n488|\t\t(!input.Bridge.BindingMatches || !input.Bridge.ManagerMatches) {\n489|\t\treturn assessment.park(\"lease_conflict\", \"bridge reports another session, epoch, lease, or manager (TB-TXN-BINDING-MISMATCH): evidence preserved, nothing further mutates\",\n490|\t\t\t\"reconcile the exact Ax Binding and manager reference, then re-run recovery\")\n491|\t}\n492|\tif (journal.Phase == PhaseRollingBack || journal.Phase == PhaseRolledBack) &&\n493|\t\t((journal.TaskBoard != nil && (journal.TaskBoard.State == BoardAdopted || journal.TaskBoard.State == BoardResumed)) ||\n494|\t\t\t(journal.Provider != nil && journal.Provider.State == ProviderCommitted)) {\n495|\t\treturn assessment.park(\"integrity_failure\", \"journal contradicts itself: rollback phase with an activated sub-state\",\n496|\t\t\t\"inspect the torn journal progression, restore a verified copy, then re-run recovery\")\n497|\t}\n498|\tif (journal.Phase == PhaseStaging || journal.Phase == PhaseValidating || journal.Phase == PhasePrepared) &&\n499|\t\tassessment.activatedEarly() {\n500|\t\treturn assessment.park(\"integrity_failure\", \"journal contradicts itself: an activated sub-state before the committing phase\",\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
