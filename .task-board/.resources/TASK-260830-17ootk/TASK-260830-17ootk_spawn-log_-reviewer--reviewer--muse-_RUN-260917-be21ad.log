{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc13","stream":{"kind":"session","id":"01a0ae83-44da-79a0-be6d-cdb96bee744a"},"sequence":1124,"recorded_at":1780531400002243,"record_type":"event","durability":"durable","causation_id":"43909339-e6a4-48a8-9111-b9f3b1e533e8","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"43909339-e6a4-48a8-9111-b9f3b1e533e8","run_stream":{"kind":"run","id":"43909339-e6a4-48a8-9111-b9f3b1e533e8"},"task_stream":{"kind":"task","id":"01a0ae87-3fe0-7511-a645-0e31a1d0b46d"},"task_id":"01a0ae87-3fe0-7511-a645-0e31a1d0b46d","event":{"kind":"output","task_id":"01a0ae87-3fe0-7511-a645-0e31a1d0b46d","chunk":"{\n  \"chunk_id\": \"exec-41-1\",\n  \"command\": \"python3 - <<'EOF'\\nimport re\\nsrc = open('internal/crashgate/registry.go').read()\\nblocks = re.split(r'\\\\{ID: \\\"', src)[1:]\\nn_reach_paths = 0; n_na_paths = 0; n_reach_ids = set(); n_na_ids = set()\\nsuspicious = []\\nfor b in blocks:\\n    m = re.match(r'([^\\\"]+)\\\", Family: \\\"([^\\\"]+)\\\", Phase: \\\"([^\\\"]+)\\\", DurableWrite: (\\\\w+)', b)\\n    if not m: continue\\n    bid, fam, phase, dw = m.groups()\\n    has_reach = 'Reachable: true' in b.split('{ID: \\\"')[0]\\n    drivers = re.findall(r'Driver: (\\\\w+)', b)\\n    owners = re.findall(r'Owner: \\\"([^\\\"]*)\\\"', b)\\n    n_reach_paths += len(drivers); n_na_paths += len(owners)\\n    if drivers: n_reach_ids.add(bid)\\n    if owners and not drivers: n_na_ids.add(bid)\\n    if dw in ('WriteCheckpoint','WriteJournal') and owners and not drivers:\\n        suspicious.append((bid, dw, owners))\\nprint(\\\"reachable paths:\\\", n_reach_paths, \\\"na paths:\\\", n_na_paths)\\nprint(\\\"reachable ids:\\\", len(n_reach_ids), \\\"na-only ids:\\\", len(n_na_ids))\\nprint(\\\"journal/checkpoint boundaries with zero drivers:\\\", suspicious if suspicious else \\\"NONE\\\")\\nEOF\",\n  \"description\": \"Audit N/A classification against durable-write class\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"reachable paths: 48 na paths: 121\\nreachable ids: 31 na-only ids: 63\\njournal/checkpoint boundaries with zero drivers: NONE\\n\",\n  \"original_output_bytes\": 122,\n  \"original_output_tokens\": 31,\n  \"truncated\": false\n}","final_result":true}}}
