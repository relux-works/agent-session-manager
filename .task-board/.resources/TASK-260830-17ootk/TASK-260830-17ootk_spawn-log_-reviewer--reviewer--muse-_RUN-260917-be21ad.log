{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cdfb","stream":{"kind":"session","id":"01a0ae83-44da-79a0-be6d-cdb96bee744a"},"sequence":1368,"recorded_at":1780531400002731,"record_type":"event","durability":"durable","causation_id":"43909339-e6a4-48a8-9111-b9f3b1e533e8","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"43909339-e6a4-48a8-9111-b9f3b1e533e8","run_stream":{"kind":"run","id":"43909339-e6a4-48a8-9111-b9f3b1e533e8"},"task_stream":{"kind":"task","id":"01a0ae87-ef1e-7b71-8bbb-5c6fb84ee673"},"task_id":"01a0ae87-ef1e-7b71-8bbb-5c6fb84ee673","event":{"kind":"output","task_id":"01a0ae87-ef1e-7b71-8bbb-5c6fb84ee673","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-2rqigd/worktree/internal/crashgate/conformance_test.go`.\n(236 line(s) above)\n237|func driveJournalCreate(t *testing.T, boundary, evaluatedVia, path, recoverPath, closure, seam string) ConformanceRecord {\n238|\tt.Helper()\n239|\tstore, dataDir := journalDirs(t)\n240|\tinputs := closureInputs(t, closure)\n241|\tagree := closure == \"composite\" || closure == \"direct_provider\"\n242|\tswitch seam {\n243|\tcase \"before_write\":\n244|\t\tinterrupted := errors.New(\"crash before the first durable byte\")\n245|\t\tstore.BeforeWrite = func() error { return interrupted }\n246|\t\t_, _, err := store.Create(inputs)\n247|\t\tif !errors.Is(err, interrupted) {\n248|\t\t\tt.Fatalf(\"Create(prepare fault) = %v, want the interior fault\", err)\n249|\t\t}\n250|\t\tif journal, receipt := journalFilesExist(t, dataDir); journal || receipt {\n251|\t\t\tt.Fatalf(\"after prepare fault: journal = %v, receipt = %v, want no durable state\", journal, receipt)\n252|\t\t}\n253|\t\trestarted := reopenJournal(t, dataDir)\n254|\t\tevidence := recoverMust(t, restarted, evaluatedVia, recoverPath, func(input *matjournal.RecoveryInput) {\n255|\t\t\tinput.Provider.State = matjournal.ProviderUnknown\n256|\t\t}, matjournal.OutcomeSafeRetry, \"Recover(\"+boundary+\")\")\n257|\t\tref, _ := mustCreate(t, restarted, inputs)\n258|\t\tif ref.PrepareOperationID != testPrepareOp {\n259|\t\t\tt.Fatalf(\"retry PrepareOperationID = %q\", ref.PrepareOperationID)\n260|\t\t}\n261|\t\tif journal, receipt := journalFilesExist(t, dataDir); !journal || !receipt {\n262|\t\t\tt.Fatalf(\"after retry: journal = %v, receipt = %v, want both durable\", journal, receipt)\n263|\t\t}\n264|\t\treturn recordFromEvidence(boundary, path, evaluatedVia, closure, seam, DriverJournalCreate, evidence)\n265|\tcase \"after_journal\", \"after_commit\":\n266|\t\tinterrupted := errors.New(\"crash at the \" + seam + \" seam\")\n267|\t\tif seam == \"after_journal\" {\n268|\t\t\tstore.AfterJournal = func() error { return interrupted }\n269|\t\t} else {\n270|\t\t\tstore.AfterCommit = func() error { return interrupted }\n271|\t\t}\n272|\t\t_, _, err := store.Create(inputs)\n273|\t\tif !errors.Is(err, interrupted) {\n274|\t\t\tt.Fatalf(\"Create(%s fault) = %v, want the interior fault\", seam, err)\n275|\t\t}\n276|\t\tjournal, receipt := journalFilesExist(t, dataDir)\n277|\t\tif !journal || (receipt != (seam == \"after_commit\")) {\n278|\t\t\tt.Fatalf(\"after %s fault: journal = %v, receipt = %v\", seam, journal, receipt)\n279|\t\t}\n280|\t\trestarted := reopenJournal(t, dataDir)\n281|\t\tref, _ := mustCreate(t, restarted, inputs)\n282|\t\tif ref.PrepareOperationID != testPrepareOp {\n283|\t\t\tt.Fatalf(\"replay PrepareOperationID = %q\", ref.PrepareOperationID)\n284|\t\t}\n285|\t\tif journal, receipt := journalFilesExist(t, dataDir); !journal || !receipt {\n286|\t\t\tt.Fatalf(\"after replay: journal = %v, receipt = %v, want both durable\", journal, receipt)\n287|\t\t}\n288|\t\tevidence := recoverMust(t, restarted, evaluatedVia, recoverPath, func(input *matjournal.RecoveryInput) {\n289|\t\t\tif !agree {\n290|\t\t\t\tinput.Provider.State = matjournal.ProviderUnknown\n291|\t\t\t}\n292|\t\t}, matjournal.OutcomeSafeRetry, \"Recover(\"+boundary+\")\")\n293|\t\treturn recordFromEvidence(boundary, path, evaluatedVia, closure, seam, DriverJournalCreate, evidence)\n294|\tdefault:\n295|\t\tt.Fatalf(\"unknown create seam %q\", seam)\n296|\t\treturn ConformanceRecord{}\n297|\t}\n298|}\n299|\n300|// driveJournalTransfer crashes after transfer progress and proves\n301|// the resume requests only absent indexes under the same IDs.\n302|func driveJournalTransfer(t *testing.T, boundary, path, recoverPath, closure string) ConformanceRecord {\n303|\tt.Helper()\n304|\tstore, dataDir := journalDirs(t)\n305|\tmustCreate(t, store, closureInputs(t, closure))\n306|\tif _, err := store.RecordProgress(testMatID, map[string][]uint32{testBlobA: {0}}, nil); err != nil {\n307|\t\tt.Fatal(err)\n308|\t}\n309|\trestarted := reopenJournal(t, dataDir)\n310|\tloaded, _, err := restarted.Get(testMatID)\n311|\tif err != nil {\n312|\t\tt.Fatal(err)\n313|\t}\n314|\tif len(loaded.CompletedBlobChunks[testBlobA]) != 1 || len(loaded.VerifiedBlobIDs) != 0 {\n315|\t\tt.Fatalf(\"staged facts = %+v\", loaded.CompletedBlobChunks)\n316|\t}\n317|\tevidence := recoverMust(t, restarted, matjournal.BoundaryAfterTransfer, recoverPath, func(input *matjournal.RecoveryInput) {\n318|\t\tif closure != \"composite\" {\n319|\t\t\tinput.Provider.State = matjournal.ProviderUnknown\n320|\t\t}\n321|\t}, matjournal.OutcomeSafeRetry, \"Recover(\"+boundary+\")\")\n322|\tupdated, err := restarted.RecordProgress(testMatID, map[string][]uint32{testBlobA: {1}}, nil)\n323|\tif err != nil {\n324|\t\tt.Fatalf(\"resume RecordProgress error = %v\", err)\n325|\t}\n326|\tif len(updated.CompletedBlobChunks[testBlobA]) != 2 {\n327|\t\tt.Fatalf(\"chunks = %+v\", updated.CompletedBlobChunks)\n328|\t}\n329|\treturn recordFromEvidence(boundary, path, matjournal.BoundaryAfterTransfer, closure, \"after_transfer\", DriverJournalTransfer, evidence)\n330|}\n331|\n332|// driveJournalValidate crashes after validation-phase facts and\n333|// proves they survive the restart.\n334|func driveJournalValidate(t *testing.T, boundary, path, recoverPath, closure string) ConformanceRecord {\n335|\tt.Helper()\n336|\tstore, dataDir := journalDirs(t)\n337|\tmustCreate(t, store, closureInputs(t, closure))\n338|\tif _, err := store.RecordProgress(testMatID, map[string][]uint32{testBlobA: {0}}, []string{testBlobA}); err != nil {\n339|\t\tt.Fatal(err)\n340|\t}\n341|\tif _, err := store.Transition(testMatID, matjournal.PhaseValidating, matjournal.TransitionOpts{}); err != nil {\n342|\t\tt.Fatal(err)\n343|\t}\n344|\trestarted := reopenJournal(t, dataDir)\n345|\tevidence := recoverMust(t, restarted, matjournal.BoundaryAfterValidation, recoverPath, func(input *matjournal.RecoveryInput) {\n346|\t\tif closure != \"composite\" {\n347|\t\t\tinput.Provider.State = matjournal.ProviderUnknown\n348|\t\t}\n349|\t}, matjournal.OutcomeSafeRetry, \"Recover(\"+boundary+\")\")\n350|\tloaded, _, err := restarted.Get(testMatID)\n351|\tif err != nil {\n352|\t\tt.Fatal(err)\n353|\t}\n354|\tif loaded.Phase != matjournal.PhaseValidating || len(loaded.VerifiedBlobIDs) != 1 {\n355|\t\tt.Fatalf(\"phase = %q verified = %+v\", loaded.Phase, loaded.VerifiedBlobIDs)\n356|\t}\n357|\treturn recordFromEvidence(boundary, path, matjournal.BoundaryAfterValidation, closure, \"after_validation\", DriverJournalValidate, evidence)\n358|}\n359|\n360|// driveJournalPrepareOp crashes after the provider prepare or the\n361|// bridge import, or executes the allowed rollback when the bridge\n362|// failed before the new lease.\n363|func driveJournalPrepareOp(t *testing.T, boundary, path, recoverPath, variant string) ConformanceRecord {\n364|\tt.Helper()\n365|\tconst closure = \"composite\"\n366|\tstore, dataDir := journalDirs(t)\n(more lines below)","final_result":true}}}
