{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7f5","stream":{"kind":"session","id":"01a0ae83-44da-79a0-be6d-cdb96bee744a"},"sequence":597,"recorded_at":1780531400001189,"record_type":"event","durability":"durable","causation_id":"43909339-e6a4-48a8-9111-b9f3b1e533e8","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"43909339-e6a4-48a8-9111-b9f3b1e533e8","run_stream":{"kind":"run","id":"43909339-e6a4-48a8-9111-b9f3b1e533e8"},"call_id":"call_01a0ae84850772fbbf6be98ac583c919","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-2rqigd/worktree/internal/crashgate/registry.go`.\n1|package crashgate\n2|\n3|// Path names the Section 13.13 direct/task-board dimension. Every\n4|// boundary lists its applicable paths; a boundary that applies to one\n5|// path only (for example the CR-FORCE-D direct-force rows) lists\n6|// that path only.\n7|const (\n8|\tPathDirect    = \"direct\"\n9|\tPathTaskBoard = \"task_board\"\n10|)\n11|\n12|// Durable-write classes. The first four are the story's reachable\n13|// classes (checkpoint capture, journal transition, operation\n14|// receipt, managed-replica marker); the rest name the unlanded\n15|// owner class of the boundary's durable fact.\n16|const (\n17|\tWriteCheckpoint = \"checkpoint\"\n18|\tWriteJournal    = \"journal\"\n19|\tWriteExternal   = \"external\"\n20|)\n21|\n22|// Driver keys name the conformance driver (test-side) that injects\n23|// the crash and runs the recovery for a reachable path.\n24|const (\n25|\tDriverCheckpointCapture = \"checkpoint-capture\"\n26|\tDriverJournalCreate     = \"journal-create\"\n27|\tDriverJournalTransfer   = \"journal-transfer\"\n28|\tDriverJournalValidate   = \"journal-validate\"\n29|\tDriverJournalPrepareOp  = \"journal-prepare-op\"\n30|\tDriverJournalToPrepared = \"journal-to-prepared\"\n31|\tDriverJournalActivation = \"journal-activation\"\n32|\tDriverJournalFinalize   = \"journal-finalize\"\n33|\tDriverJournalDormant    = \"journal-dormant\"\n34|)\n35|\n36|// BoundaryPath classifies one direct/task-board path of one crash\n37|// boundary. Exactly one of Driver (reachable) and Owner (not\n38|// applicable) is set; Note carries the honest why.\n39|type BoundaryPath struct {\n40|\tName      string\n41|\tReachable bool\n42|\tDriver    string\n43|\tOwner     string\n44|\tNote      string\n45|}\n46|\n47|// Boundary is one crash boundary of the Section 13.13 registry:\n48|// its ID, family, phase, durable-write class, and per-path\n49|// classification.\n50|type Boundary struct {\n51|\tID           string\n52|\tFamily       string\n53|\tPhase        string\n54|\tDurableWrite string\n55|\tPaths        []BoundaryPath\n56|}\n57|\n58|// Path returns the named path classification of the boundary.\n59|func (boundary Boundary) Path(name string) (BoundaryPath, bool) {\n60|\tfor _, path := range boundary.Paths {\n61|\t\tif path.Name == name {\n62|\t\t\treturn path, true\n63|\t\t}\n64|\t}\n65|\treturn BoundaryPath{}, false\n66|}\n67|\n68|// Reachable reports whether any path of the boundary is reachable\n69|// through the landed owners.\n70|func (boundary Boundary) Reachable() bool {\n71|\tfor _, path := range boundary.Paths {\n72|\t\tif path.Reachable {\n73|\t\t\treturn true\n74|\t\t}\n75|\t}\n76|\treturn false\n77|}\n78|\n79|// registry is the classified Section 13.13 boundary table in\n80|// specification order: the twelve registry-table ranges plus the\n81|// CR-CLONE prose range. The ID set is verified against the pinned\n82|// text by the derivation test; the per-path classification is the\n83|// harness's explicit, reviewed mapping.\n84|var registry = []Boundary{\n85|\t// CR-LAUNCH-D-01..05: direct bootstrap (Section 13.1). No\n86|\t// boundary writes a checkpoint, journal, receipt, or marker:\n87|\t// the first checkpoint is published by the next phase after\n88|\t// CR-LAUNCH-D-05.\n89|\t{ID: \"CR-LAUNCH-D-01\", Family: \"CR-LAUNCH-D\", Phase: \"session/lease/event persistence\", DurableWrite: WriteExternal, Paths: []BoundaryPath{\n90|\t\t{Name: PathDirect, Owner: \"sessrepo session/lease/event persistence (Section 13.1 bootstrap; out of checkpoint/journal story boundary)\", Note: \"durable write is Session/Lease/Event records, not a checkpoint or journal\"},\n91|\t}},\n92|\t{ID: \"CR-LAUNCH-D-02\", Family: \"CR-LAUNCH-D\", Phase: \"terminal creation\", DurableWrite: WriteExternal, Paths: []BoundaryPath{\n93|\t\t{Name: PathDirect, Owner: \"terminal lifecycle runtime (terminalbackend manifest/probe/conformance landed; creation runtime unlanded)\", Note: \"durable fact is terminal creation, not a checkpoint or journal\"},\n94|\t}},\n95|\t{ID: \"CR-LAUNCH-D-03\", Family: \"CR-LAUNCH-D\", Phase: \"provider process start\", DurableWrite: WriteExternal, Paths: []BoundaryPath{\n96|\t\t{Name: PathDirect, Owner: \"provider plugin/process runtime (Section 7/13.1; process start unlanded)\", Note: \"external effect with no checkpoint/journal durable write\"},\n97|\t}},\n98|\t{ID: \"CR-LAUNCH-D-04\", Family: \"CR-LAUNCH-D\", Phase: \"Provider Identity persistence\", DurableWrite: WriteExternal, Paths: []BoundaryPath{\n99|\t\t{Name: PathDirect, Owner: \"provider identity persistence (canonical shape landed; durable persistence runtime unlanded)\", Note: \"durable write is the Provider Identity Record, not a checkpoint or journal\"},\n100|\t}},\n101|\t{ID: \"CR-LAUNCH-D-05\", Family: \"CR-LAUNCH-D\", Phase: \"capture/object validation\", DurableWrite: WriteExternal, Paths: []BoundaryPath{\n102|\t\t{Name: PathDirect, Owner: \"direct bootstrap validation (Section 13.1; validation gate unlanded)\", Note: \"validation produces no durable bytes; the first-checkpoint publication that follows is a future lifecycle boundary, not this one\"},\n103|\t}},\n104|\t// CR-LAUNCH-TB-01..03: task-board bootstrap (Section 13.2).\n105|\t{ID: \"CR-LAUNCH-TB-01\", Family: \"CR-LAUNCH-TB\", Phase: \"session/lease/event persistence\", DurableWrite: WriteExternal, Paths: []BoundaryPath{\n106|\t\t{Name: PathTaskBoard, Owner: \"sessrepo session/lease/event persistence (Section 13.2 bootstrap; out of checkpoint/journal story boundary)\", Note: \"durable write is Session/Lease/Event records, not a checkpoint or journal\"},\n107|\t}},\n108|\t{ID: \"CR-LAUNCH-TB-02\", Family: \"CR-LAUNCH-TB\", Phase: \"bridge launch may have returned a manager reference\", DurableWrite: WriteExternal, Paths: []BoundaryPath{\n109|\t\t{Name: PathTaskBoard, Owner: \"task-board bridge runtime (Section 9/13.2; launch execution unlanded)\", Note: \"external effect with no checkpoint/journal durable write\"},\n110|\t}},\n111|\t{ID: \"CR-LAUNCH-TB-03\", Family: \"CR-LAUNCH-TB\", Phase: \"bridge export may have returned a bundle/proof\", DurableWrite: WriteExternal, Paths: []BoundaryPath{\n112|\t\t{Name: PathTaskBoard, Owner: \"task-board bridge runtime (Section 9/13.2; export execution unlanded)\", Note: \"durable fact is the bridge bundle/proof, consumed by checkpoint closure as input but written by the bridge\"},\n113|\t}},\n114|\t// CR-SYNC-01..07: sync (Section 13.3). The passive\n115|\t// materialization rows are journal-observable through the\n116|\t// dormant walk; transfer staging and commit belong to the\n117|\t// sync/transfer flow.\n118|\t{ID: \"CR-SYNC-01\", Family: \"CR-SYNC\", Phase: \"inventory exchange\", DurableWrite: WriteExternal, Paths: []BoundaryPath{\n119|\t\t{Name: PathDirect, Owner: \"sync transfer flow (Section 13.3; inventory exchange unlanded)\", Note: \"no checkpoint/journal durable write\"},\n120|\t\t{Name: PathTaskBoard, Owner: \"sync transfer flow (Section 13.3; inventory exchange unlanded)\", Note: \"no checkpoint/journal durable write\"},\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
