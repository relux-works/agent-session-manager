{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cdd1","stream":{"kind":"session","id":"01a0ae83-44da-79a0-be6d-cdb96bee744a"},"sequence":1347,"recorded_at":1780531400002689,"record_type":"event","durability":"durable","causation_id":"43909339-e6a4-48a8-9111-b9f3b1e533e8","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"43909339-e6a4-48a8-9111-b9f3b1e533e8","run_stream":{"kind":"run","id":"43909339-e6a4-48a8-9111-b9f3b1e533e8"},"task_stream":{"kind":"task","id":"01a0ae87-c95f-7c32-936f-a7a3502bea85"},"task_id":"01a0ae87-c95f-7c32-936f-a7a3502bea85","event":{"kind":"output","task_id":"01a0ae87-c95f-7c32-936f-a7a3502bea85","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-2rqigd/worktree/internal/crashgate/conformance_test.go`.\n(120 line(s) above)\n121|func driveCheckpointCapture(t *testing.T, boundary, path, seam string) ConformanceRecord {\n122|\tt.Helper()\n123|\trepoDir, created := chainFixture(t)\n124|\tstore, dataDir := checkpointDirs(t)\n125|\tvar inputs sessckpt.Inputs\n126|\tif path == PathTaskBoard {\n127|\t\tinputs = captureInputsBoard([]string{created}, testOpA)\n128|\t} else {\n129|\t\tinputs = captureInputs([]string{created}, testOpA)\n130|\t}\n131|\tif seam == \"before_write\" {\n132|\t\tinjector := &secconftest.Injector{}\n133|\t\tstore.BeforeWrite = func() error { return injector.MaybeFail(secconftest.PointPrepareEnter) }\n134|\t\tinjector.Arm(secconftest.PointPrepareEnter)\n135|\t\t_, _, err := store.Capture(mustOpenRepo(t, repoDir), inputs)\n136|\t\tvar fault *secconftest.Fault\n137|\t\tif !errors.As(err, &fault) || fault.Point() != secconftest.PointPrepareEnter {\n138|\t\t\tt.Fatalf(\"Capture(prepare fault) = %v, want the injected fault\", err)\n139|\t\t}\n140|\t\tif blobs, receipts := countCheckpointFiles(t, dataDir); blobs != 0 || receipts != 0 {\n141|\t\t\tt.Fatalf(\"after prepare fault: blobs = %d, receipts = %d, want 0, 0\", blobs, receipts)\n142|\t\t}\n143|\t} else {\n144|\t\tinterrupted := errors.New(\"crash at the \" + seam + \" seam\")\n145|\t\tif seam == \"after_blob\" {\n146|\t\t\tstore.AfterBlob = func() error { return interrupted }\n147|\t\t} else {\n148|\t\t\tstore.AfterCommit = func() error { return interrupted }\n149|\t\t}\n150|\t\t_, _, err := store.Capture(mustOpenRepo(t, repoDir), inputs)\n151|\t\tif !errors.Is(err, interrupted) {\n152|\t\t\tt.Fatalf(\"Capture(%s fault) = %v, want the interior fault\", seam, err)\n153|\t\t}\n154|\t\twantBlobs, wantReceipts := 1, 0\n155|\t\tif seam == \"after_commit\" {\n156|\t\t\twantReceipts = 1\n157|\t\t}\n158|\t\tif blobs, receipts := countCheckpointFiles(t, dataDir); blobs != wantBlobs || receipts != wantReceipts {\n159|\t\t\tt.Fatalf(\"after %s fault: blobs = %d, receipts = %d, want %d, %d\", seam, blobs, receipts, wantBlobs, wantReceipts)\n160|\t\t}\n161|\t\teveryCheckpointVerifies(t, dataDir)\n162|\t}\n163|\tpreBlobs, preReceipts := countCheckpointFiles(t, dataDir)\n164|\t// Clean restart: fresh handles over the same directories; hooks\n165|\t// never survive.\n166|\trestarted := reopenCheckpoint(t, dataDir)\n167|\tchain := mustOpenRepo(t, repoDir)\n168|\tevents, err := chain.ListEvents(testSessionID)\n169|\tif err != nil || len(events) != 1 {\n170|\t\tt.Fatalf(\"chain after restart lists %d events, want the single bootstrap event\", len(events))\n171|\t}\n172|\tref, raw, err := restarted.Capture(chain, inputs)\n173|\tif err != nil {\n174|\t\tt.Fatalf(\"retry Capture error = %v\", err)\n175|\t}\n176|\tif _, _, err := sessrepo.AttestCheckpointRecord(raw); err != nil {\n177|\t\tt.Fatalf(\"retry bytes do not attest: %v\", err)\n178|\t}\n179|\tstored, err := restarted.Get(ref.CheckpointID)\n180|\tif err != nil {\n181|\t\tt.Fatalf(\"Get after retry error = %v\", err)\n182|\t}\n183|\tif string(stored) != string(raw) {\n184|\t\tt.Fatalf(\"retry bytes differ from stored bytes\")\n185|\t}\n186|\tif blobs, receipts := countCheckpointFiles(t, dataDir); blobs != 1 || receipts != 1 {\n187|\t\tt.Fatalf(\"after retry: blobs = %d, receipts = %d, want 1, 1\", blobs, receipts)\n188|\t}\n189|\tif seam == \"after_commit\" {\n190|\t\tagain, againRaw, err := restarted.Capture(chain, inputs)\n191|\t\tif err != nil {\n192|\t\t\tt.Fatalf(\"replay Capture error = %v\", err)\n193|\t\t}\n194|\t\tif again != ref || string(againRaw) != string(raw) {\n195|\t\t\tt.Fatalf(\"receipt replay diverged from the recorded result\")\n196|\t\t}\n197|\t}\n198|\tnative := testProviderManifest\n199|\tif path == PathTaskBoard {\n200|\t\tnative = testBoardBundle\n201|\t}\n202|\tlease := leaseString(matjournal.LeaseIdentity{Epoch: 1, ID: testLeaseID})\n203|\treturn ConformanceRecord{\n204|\t\tBoundary:       boundary,\n205|\t\tRegistryPath:   path,\n206|\t\tEvaluatedVia:   \"capture-blob-receipt-seam\",\n207|\t\tClosure:        path,\n208|\t\tVariant:        seam,\n209|\t\tDriver:         DriverCheckpointCapture,\n210|\t\tOperationIDs:   map[string]string{\"capture_operation_id\": testOpA},\n211|\t\tPhaseBefore:    fmt.Sprintf(\"blobs=%d receipts=%d\", preBlobs, preReceipts),\n212|\t\tPhaseAfter:     fmt.Sprintf(\"blobs=1 receipts=1 checkpoint=%s\", ref.CheckpointID),\n213|\t\tReceiptPresent: true,\n214|\t\tExternalEffect: \"none (capture performs no provider or task-board I/O)\",\n215|\t\tStatusProbe:    \"n/a (no external effect to reconcile)\",\n216|\t\tLeaseBefore:    lease,\n217|\t\tLeaseAfter:     lease,\n218|\t\tNativeBefore:   native,\n219|\t\tNativeAfter:    native,\n220|\t\tSelected:       string(matjournal.OutcomeSafeRetry),\n221|\t\tReason:         fmt.Sprintf(\"identical retry converged on checkpoint %s with its receipt; no second identity\", ref.CheckpointID),\n222|\t\tRemediation:    \"retry the same capture operation with byte-identical inputs\",\n223|\t}\n224|}\n225|\n(more lines below)","final_result":true}}}
