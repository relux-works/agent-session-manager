{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cf23","stream":{"kind":"session","id":"01a0ae83-44da-79a0-be6d-cdb96bee744a"},"sequence":1516,"recorded_at":1780531400003027,"record_type":"event","durability":"durable","causation_id":"43909339-e6a4-48a8-9111-b9f3b1e533e8","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"43909339-e6a4-48a8-9111-b9f3b1e533e8","run_stream":{"kind":"run","id":"43909339-e6a4-48a8-9111-b9f3b1e533e8"},"task_stream":{"kind":"task","id":"01a0ae88-5316-7a22-8333-6719cb91338c"},"task_id":"01a0ae88-5316-7a22-8333-6719cb91338c","event":{"kind":"output","task_id":"01a0ae88-5316-7a22-8333-6719cb91338c","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-2rqigd/worktree/internal/crashgate/helpers_test.go`.\n(273 line(s) above)\n274|func countCheckpointFiles(t *testing.T, dataDir string) (blobs, receipts int) {\n275|\tt.Helper()\n276|\troot := filepath.Join(dataDir, \"checkpoints\")\n277|\tentries, err := os.ReadDir(root)\n278|\tif err != nil {\n279|\t\tt.Fatal(err)\n280|\t}\n281|\tfor _, entry := range entries {\n282|\t\tif !entry.IsDir() {\n283|\t\t\tblobs++\n284|\t\t}\n285|\t}\n286|\treceiptEntries, err := os.ReadDir(filepath.Join(root, \"operations\"))\n287|\tif err != nil {\n288|\t\tt.Fatal(err)\n289|\t}\n290|\treturn blobs, len(receiptEntries)\n291|}\n292|\n293|// everyCheckpointVerifies fails when any installed blob does not\n294|// attest through the canonical owner: an interrupted capture must\n295|// leave no partial record behind.\n296|func everyCheckpointVerifies(t *testing.T, dataDir string) {\n297|\tt.Helper()\n298|\troot := filepath.Join(dataDir, \"checkpoints\")\n299|\tentries, err := os.ReadDir(root)\n300|\tif err != nil {\n301|\t\tt.Fatal(err)\n302|\t}\n303|\tfor _, entry := range entries {\n304|\t\tif entry.IsDir() {\n305|\t\t\tcontinue\n306|\t\t}\n307|\t\traw, err := os.ReadFile(filepath.Join(root, entry.Name()))\n308|\t\tif err != nil {\n309|\t\t\tt.Fatal(err)\n310|\t\t}\n311|\t\tif _, _, err := sessrepo.AttestCheckpointRecord(raw); err != nil {\n312|\t\t\tt.Fatalf(\"installed file %s does not attest: %v\", entry.Name(), err)\n313|\t\t}\n314|\t}\n315|}\n316|\n317|// journalFilesExist reports whether the journal and at least one\n318|// prepare receipt exist for the test materialization.\n319|func journalFilesExist(t *testing.T, dataDir string) (journal, receipt bool) {\n320|\tt.Helper()\n321|\tmatDir := filepath.Join(dataDir, \"materializations\", testMatID)\n322|\tif _, err := os.Stat(filepath.Join(matDir, \"journal.json\")); err == nil {\n323|\t\tjournal = true\n324|\t}\n325|\tentries, err := os.ReadDir(filepath.Join(matDir, \"operations\"))\n326|\tif err == nil && len(entries) > 0 {\n327|\t\treceipt = true\n328|\t}\n329|\treturn journal, receipt\n330|}\n331|\n332|func testRequestBody() []byte {\n333|\treturn []byte(`{\"materialization_id\":\"` + testMatID + `\",\"operation_id\":\"` + testPrepareOp + `\",\"plan_id\":\"` + testPlanID + `\"}`)\n334|}\n335|\n336|// directInputs returns the workspace-only prepare closure: no\n337|// provider branch, no bridge.\n338|func directInputs() matjournal.CreateInputs {\n(more lines below)","final_result":true}}}
