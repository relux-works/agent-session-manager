{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d36b","stream":{"kind":"session","id":"01a0ae83-44da-79a0-be6d-cdb96bee744a"},"sequence":2064,"recorded_at":1780531400004123,"record_type":"event","durability":"durable","causation_id":"43909339-e6a4-48a8-9111-b9f3b1e533e8","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"43909339-e6a4-48a8-9111-b9f3b1e533e8","run_stream":{"kind":"run","id":"43909339-e6a4-48a8-9111-b9f3b1e533e8"},"call_id":"call_01a0ae8aaa157120a9357186a52d695d","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-2rqigd/worktree/internal/crashgate/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for the Section 13.13 crash gate.\n3|\n4|Every plant weakens one gate to admit exactly one member of the\n5|class it must reject; the gate stays present. Delete-only mutants\n6|are not accepted as evidence. One plant (N-registry-grace11)\n7|preserves the searched-for boundary token and changes behavior: the\n8|static ID-set derivation still passes while the behavioral suite\n9|fails, so the harness runs the behavioral suite for every plant,\n10|not only the static checker.\n11|\n12|Targets: internal/crashgate/registry.go (the applicability\n13|classifier) and internal/matjournal/recover.go (the recovery\n14|evaluator the gate drives). Cross-package mutation is deliberate:\n15|the gate's classification predicates live in the evaluator.\n16|\n17|Usage:\n18|    PYTHONDONTWRITEBYTECODE=1 python3 internal/crashgate/mutant_harness.py --log-dir .temp/TASK-260830-17ootk/mutants\n19|\n20|Exit status is 0 only when every narrowing mutant is KILLED and the\n21|harmless control SURVIVES.\n22|\"\"\"\n23|\n24|import argparse\n25|import json\n26|import subprocess\n27|import sys\n28|from pathlib import Path\n29|\n30|REPO = Path(__file__).resolve().parents[2]\n31|GO_TEST = [\"go\", \"test\", \"./internal/crashgate/\", \"-count=1\"]\n32|STATIC_RUN = GO_TEST + [\"-run\", \"TestRegistryDerivesFromPinnedSpec|TestRegistryStructure\"]\n33|BEHAVIOR_RUN = GO_TEST + [\"-run\", \"TestCrashGate\"]\n34|TIMEOUT = 300\n35|\n36|PLANTS = [\n37|    {\n38|        \"id\": \"N-registry-grace11\",\n39|        \"kind\": \"narrowing\",\n40|        \"file\": \"internal/crashgate/registry.go\",\n41|        \"weakening\": \"GRACE-11 task-board path flipped reachable:true to NOT APPLICABLE with an owner; the CR-GRACE-11 token is preserved\",\n42|        \"killer\": \"TestCrashGateConformance coverage + TestCrashGateNotApplicable (behavioral); static derivation must still pass\",\n43|        \"find\": '{Name: PathTaskBoard, Reachable: true, Driver: DriverJournalActivation, Note: \"task-board activation through the journal-activation seam, evaluated with the graceful_takeover path\"},',\n44|        \"replace\": '{Name: PathTaskBoard, Reachable: false, Owner: \"task-board bridge runtime (Section 9/13.2; launch/export/adopt execution unlanded)\", Note: \"task-board activation through the journal-activation seam, evaluated with the graceful_takeover path\"},',\n45|        \"expect_static\": \"pass\",\n46|        \"expect_behavior\": \"fail\",\n47|    },\n48|    {\n49|        \"id\": \"N-recover-lease-backward\",\n50|        \"kind\": \"narrowing\",\n51|        \"file\": \"internal/matjournal/recover.go\",\n52|        \"weakening\": \"lease-moved gate admits a backward epoch move (epoch != becomes epoch >)\",\n53|        \"killer\": \"TestCrashGateRejections/lease_moved_backward\",\n54|        \"find\": \"if input.LeaseKnown && (input.LeaseAfter.Epoch != input.LeaseBefore.Epoch || input.LeaseAfter.ID != input.LeaseBefore.ID) {\",\n55|        \"replace\": \"if input.LeaseKnown && (input.LeaseAfter.Epoch > input.LeaseBefore.Epoch || input.LeaseAfter.ID != input.LeaseBefore.ID) {\",\n56|        \"expect_static\": \"any\",\n57|        \"expect_behavior\": \"fail\",\n58|    },\n59|    {\n60|        \"id\": \"N-recover-native-blank\",\n61|        \"kind\": \"narrowing\",\n62|        \"file\": \"internal/matjournal/recover.go\",\n63|        \"weakening\": \"substitution gate admits the relabelled blank state (empty native-after)\",\n64|        \"killer\": \"TestCrashGateRejections/blank_relabel\",\n65|        \"find\": \"if input.NativeAfter != input.NativeBefore {\",\n66|        \"replace\": 'if input.NativeAfter != input.NativeBefore && input.NativeAfter != \"\" {',\n67|        \"expect_static\": \"any\",\n68|        \"expect_behavior\": \"fail\",\n69|    },\n70|    {\n71|        \"id\": \"N-recover-two-auth-manager\",\n72|        \"kind\": \"narrowing\",\n73|        \"file\": \"internal/matjournal/recover.go\",\n74|        \"weakening\": \"two-live-authorities gate admits the manager-mismatched member (additionally requires ManagerMatches)\",\n75|        \"killer\": \"TestCrashGateRejections/two_live_authorities\",\n76|        \"find\": \"assessment.bridgeLive() && !input.Bridge.BindingMatches {\",\n77|        \"replace\": \"assessment.bridgeLive() && !input.Bridge.BindingMatches && input.Bridge.ManagerMatches {\",\n78|        \"expect_static\": \"any\",\n79|        \"expect_behavior\": \"fail\",\n80|    },\n81|    {\n82|        \"id\": \"N-recover-unfenced-live\",\n83|        \"kind\": \"narrowing\",\n84|        \"file\": \"internal/matjournal/recover.go\",\n85|        \"weakening\": \"unfenced-continuation gate admits state-derived liveness (explicit Live flag only)\",\n86|        \"killer\": \"TestCrashGateRejections/unfenced_state_liveness\",\n87|        \"find\": \"if assessment.bridgeLive() && !input.Bridge.LeaseActive && assessment.bridgeAdopted() {\",\n88|        \"replace\": \"if input.Bridge.Live && !input.Bridge.LeaseActive && assessment.bridgeAdopted() {\",\n89|        \"expect_static\": \"any\",\n90|        \"expect_behavior\": \"fail\",\n91|    },\n92|    {\n93|        \"id\": \"N-recover-host-rename\",\n94|        \"kind\": \"narrowing\",\n95|        \"file\": \"internal/matjournal/recover.go\",\n96|        \"weakening\": \"host-condition gate keeps disk_full and admits exactly rename_blocked\",\n97|        \"killer\": \"TestCrashGateSection1312/rename_blocked_probe_parks\",\n98|        \"find\": '\\tcase HostRenameBlocked:\\n\\t\\treturn assessment.park(\"staging_incomplete\", \"atomic rename blocked: staging retained, never overwritten in place\",\\n\\t\\t\\t\"close the blocking handles, then retry the same operation\")\\n',\n99|        \"replace\": \"\",\n100|        \"expect_static\": \"any\",\n101|        \"expect_behavior\": \"fail\",\n102|    },\n103|    {\n104|        \"id\": \"N-recover-marker-mismatch\",\n105|        \"kind\": \"narrowing\",\n106|        \"file\": \"internal/matjournal/recover.go\",\n107|        \"weakening\": \"marker gate keeps invalid and admits exactly mismatch\",\n108|        \"killer\": \"TestCrashGateMutualExclusion/marker_mismatch_parks\",\n109|        \"find\": '\\tcase MarkerMismatch:\\n\\t\\treturn assessment.park(\"integrity_failure\", \"destination marker disagrees with the journal (MJ-CRASH-MARKER-MISMATCH): quarantined, nothing further mutates\",\\n\\t\\t\\t\"quarantine the transaction, reconcile the marker against the plan and checkpoint, then re-run recovery\")\\n',\n110|        \"replace\": \"\",\n111|        \"expect_static\": \"any\",\n112|        \"expect_behavior\": \"fail\",\n113|    },\n114|    {\n115|        \"id\": \"N-recover-provider-floor\",\n116|        \"kind\": \"narrowing\",\n117|        \"file\": \"internal/matjournal/recover.go\",\n118|        \"weakening\": \"unrecorded-prepare uncertainty floor raised from CR-MAT-05 to CR-MAT-06 (admits unknown provider status at CR-MAT-05)\",\n119|        \"killer\": \"TestCrashGateMutualExclusion/unknown_unrecorded_prepare_parks\",\n120|        \"find\": \"\\tif journal.Provider != nil {\\n\\t\\treturn journal.Phase == PhasePrepared || journal.Phase == PhaseCommitting ||\\n\\t\\t\\tjournal.Phase == PhaseRollingBack\\n\\t}\\n\\treturn boundaryAtOrAfter(assessment.input.Boundary, BoundaryAfterPrepareOp)\",\n121|        \"replace\": \"\\tif journal.Provider != nil {\\n\\t\\treturn journal.Phase == PhasePrepared || journal.Phase == PhaseCommitting ||\\n\\t\\t\\tjournal.Phase == PhaseRollingBack\\n\\t}\\n\\treturn boundaryAtOrAfter(assessment.input.Boundary, BoundaryAfterOpen)\",\n122|        \"expect_static\": \"any\",\n123|        \"expect_behavior\": \"fail\",\n124|    },\n125|    {\n126|        \"id\": \"N-recover-bridge-floor\",\n127|        \"kind\": \"narrowing\",\n128|        \"file\": \"internal/matjournal/recover.go\",\n129|        \"weakening\": \"unrecorded-import uncertainty floor raised from CR-MAT-05 to CR-MAT-06 (admits unknown bridge status at CR-MAT-05)\",\n130|        \"killer\": \"TestCrashGateMutualExclusion/unknown_unrecorded_import_parks\",\n131|        \"find\": \"\\tcase BoardNotStarted:\\n\\t\\treturn boundaryAtOrAfter(assessment.input.Boundary, BoundaryAfterPrepareOp)\",\n132|        \"replace\": \"\\tcase BoardNotStarted:\\n\\t\\treturn boundaryAtOrAfter(assessment.input.Boundary, BoundaryAfterOpen)\",\n133|        \"expect_static\": \"any\",\n134|        \"expect_behavior\": \"fail\",\n135|    },\n136|    {\n137|        \"id\": \"C-harmless-comment\",\n138|        \"kind\": \"control\",\n139|        \"file\": \"internal/crashgate/registry.go\",\n140|        \"weakening\": \"comment-only edit (harmless control)\",\n141|        \"killer\": \"none (behavioral suite must pass)\",\n142|        \"find\": \"// Registry returns an isolated copy of the classified boundary\\n// table in specification order.\",\n143|        \"replace\": \"// Registry returns an isolated copy of the classified boundary\\n// table in specification order. Harmless control edit.\",\n144|        \"expect_static\": \"pass\",\n145|        \"expect_behavior\": \"pass\",\n146|    },\n147|]\n148|\n149|\n150|def run(cmd):\n151|    proc = subprocess.run(\n152|        cmd, cwd=REPO, capture_output=True, text=True, timeout=TIMEOUT\n153|    )\n154|    return proc.returncode, proc.stdout + proc.stderr\n155|\n156|\n157|def main():\n158|    parser = argparse.ArgumentParser()\n159|    parser.add_argument(\"--log-dir\", required=True)\n160|    args = parser.parse_args()\n161|    log_dir = Path(args.log_dir)\n162|    if not log_dir.is_absolute():\n163|        log_dir = REPO / log_dir\n164|    log_dir.mkdir(parents=True, exist_ok=True)\n165|\n166|    originals = {}\n167|    for plant in PLANTS:\n168|        path = REPO / plant[\"file\"]\n169|        if plant[\"file\"] not in originals:\n170|            originals[plant[\"file\"]] = path.read_text()\n171|    for path_text in originals.values():\n172|        if not path_text.endswith(\"\\n\"):\n173|            print(\"target file lacks trailing newline; aborting\")\n174|            return 2\n175|\n176|    def restore():\n177|        for name, text in originals.items():\n178|            (REPO / name).write_text(text)\n179|\n180|    log_lines = []\n181|    log_lines.append(\"pre-flight: behavioral suite on the clean tree\")\n182|    code, out = run(BEHAVIOR_RUN)\n183|    log_lines.append(f\"$ {' '.join(BEHAVIOR_RUN)}\\nreturncode={code}\\n{out}\")\n184|    if code != 0:\n185|        (log_dir / \"preflight.log\").write_text(\"\\n\".join(log_lines) + \"\\n\")\n186|        print(\"pre-flight behavioral suite fails on the clean tree; aborting\")\n187|        return 2\n188|\n189|    results = []\n190|    try:\n191|        for plant in PLANTS:\n192|            pid = plant[\"id\"]\n193|            path = REPO / plant[\"file\"]\n194|            current = path.read_text()\n195|            occurrences = current.count(plant[\"find\"])\n196|            entry = {\n197|                \"id\": pid,\n198|                \"kind\": plant[\"kind\"],\n199|                \"file\": plant[\"file\"],\n200|                \"weakening\": plant[\"weakening\"],\n201|                \"killer\": plant[\"killer\"],\n202|            }\n203|            plant_log = [f\"plant {pid} ({plant['kind']}): {plant['weakening']}\", f\"file: {plant['file']}\"]\n204|            if occurrences != 1:\n205|                entry[\"verdict\"] = \"NOT_APPLIED\"\n206|                entry[\"detail\"] = f\"pattern occurs {occurrences} times, want exactly 1\"\n207|                plant_log.append(entry[\"detail\"])\n208|                (log_dir / f\"{pid}.log\").write_text(\"\\n\".join(plant_log) + \"\\n\")\n209|                results.append(entry)\n210|                continue\n211|            path.write_text(current.replace(plant[\"find\"], plant[\"replace\"]))\n212|            static_code, static_out = run(STATIC_RUN)\n213|            behavior_code, behavior_out = run(BEHAVIOR_RUN)\n214|            plant_log.append(f\"$ {' '.join(STATIC_RUN)}\\nreturncode={static_code}\\n{static_out}\")\n215|            plant_log.append(f\"$ {' '.join(BEHAVIOR_RUN)}\\nreturncode={behavior_code}\\n{behavior_out}\")\n216|            entry[\"static\"] = \"pass\" if static_code == 0 else \"fail\"\n217|            entry[\"behavior\"] = \"pass\" if behavior_code == 0 else \"fail\"\n218|            if plant[\"kind\"] == \"control\":\n219|                entry[\"verdict\"] = \"SURVIVED\" if behavior_code == 0 else \"UNEXPECTED_KILL\"\n220|            else:\n221|                entry[\"verdict\"] = \"KILLED\" if behavior_code != 0 else \"SURVIVED\"\n222|                if plant.get(\"expect_static\") == \"pass\" and static_code != 0:\n223|                    entry[\"verdict\"] = \"STATIC_KILL\"\n224|                    entry[\"detail\"] = \"static checker failed: the token-preserving claim does not hold\"\n225|            (log_dir / f\"{pid}.log\").write_text(\"\\n\".join(plant_log) + \"\\n\")\n226|            results.append(entry)\n227|            restore()\n228|    finally:\n229|        restore()\n230|\n231|    for name, text in originals.items():\n232|        if (REPO / name).read_text() != text:\n233|            print(f\"restore failed for {name}\")\n234|            return 2\n235|    diff = subprocess.run(\n236|        [\"git\", \"diff\", \"--quiet\", \"--\"] + list(originals.keys()),\n237|        cwd=REPO,\n238|    )\n239|    summary = {\n240|        \"plants\": results,\n241|        \"killed\": sum(1 for r in results if r[\"verdict\"] == \"KILLED\"),\n242|        \"survived\": sum(1 for r in results if r[\"verdict\"] == \"SURVIVED\"),\n243|        \"not_applied\": sum(1 for r in results if r[\"verdict\"] == \"NOT_APPLIED\"),\n244|        \"anomalies\": [r for r in results if r[\"verdict\"] not in (\"KILLED\", \"SURVIVED\")],\n245|        \"tree_restored\": diff.returncode == 0,\n246|    }\n247|    (log_dir / \"summary.json\").write_text(json.dumps(summary, indent=2) + \"\\n\")\n248|    narrowing = [r for r in results if r[\"kind\"] == \"narrowing\"]\n249|    controls = [r for r in results if r[\"kind\"] == \"control\"]\n250|    ok = (\n251|        all(r[\"verdict\"] == \"KILLED\" for r in narrowing)\n252|        and all(r[\"verdict\"] == \"SURVIVED\" for r in controls)\n253|        and diff.returncode == 0\n254|    )\n255|    print(\n256|        f\"mutants: {summary['killed']} killed, {summary['survived']} survived, \"\n257|        f\"{summary['not_applied']} not applied, anomalies={len(summary['anomalies'])}\"\n258|    )\n259|    return 0 if ok else 1\n260|\n261|\n262|if __name__ == \"__main__\":\n263|    sys.exit(main())","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
