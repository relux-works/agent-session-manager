{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb5f","stream":{"kind":"session","id":"01a0ae83-44da-79a0-be6d-cdb96bee744a"},"sequence":1034,"recorded_at":1780531400002063,"record_type":"event","durability":"durable","causation_id":"43909339-e6a4-48a8-9111-b9f3b1e533e8","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"43909339-e6a4-48a8-9111-b9f3b1e533e8","run_stream":{"kind":"run","id":"43909339-e6a4-48a8-9111-b9f3b1e533e8"},"call_id":"call_01a0ae86f0d97424ae653f4d8fef432d","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-2rqigd/worktree/internal/crashgate/exclusion_test.go`.\n1|package crashgate\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"strings\"\n8|\t\"testing\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/matjournal\"\n11|)\n12|\n13|// recoveryJSONExists reports whether the parked/rollback evidence\n14|// file is durable for the test materialization.\n15|func recoveryJSONExists(t *testing.T, dataDir string) bool {\n16|\tt.Helper()\n17|\t_, err := os.Stat(filepath.Join(dataDir, \"materializations\", testMatID, \"recovery.json\"))\n18|\treturn err == nil\n19|}\n20|\n21|// TestCrashGateMutualExclusion proves the outcomes mutually exclusive\n22|// and collectively exhaustive through the production Recover entry:\n23|// contradictory, missing, torn, and ambiguous evidence all select\n24|// recoverable_parked_state; safe_retry establishes no new durable\n25|// fact beyond the journal and receipt it returns (no recovery.json),\n26|// while every parked assessment persists its blocking evidence; no\n27|// run invents a fourth outcome or reports an unclassified\n28|// successful restart.\n29|func TestCrashGateMutualExclusion(t *testing.T) {\n30|\tt.Run(\"contradictory_early_activation_parks\", func(t *testing.T) {\n31|\t\tstore, dataDir := journalDirs(t)\n32|\t\tmustCreate(t, store, compositeInputs())\n33|\t\t// The sub-table is phase-agnostic, so the store admits an\n34|\t\t// adopted bridge at staging through the production\n35|\t\t// entries; recovery quarantines the contradiction.\n36|\t\tif _, err := store.UpdateTaskBoard(testMatID, importedBoard()); err != nil {\n37|\t\t\tt.Fatal(err)\n38|\t\t}\n39|\t\tif _, err := store.UpdateTaskBoard(testMatID, openedBoard()); err != nil {\n40|\t\t\tt.Fatal(err)\n41|\t\t}\n42|\t\tif _, err := store.UpdateTaskBoard(testMatID, adoptedBoard()); err != nil {\n43|\t\t\tt.Fatal(err)\n44|\t\t}\n45|\t\trestarted := reopenJournal(t, dataDir)\n46|\t\tevidence := recoverMust(t, restarted, matjournal.BoundaryAfterActivation, matjournal.PathOwnerResume, func(input *matjournal.RecoveryInput) {\n47|\t\t\tinput.Bridge.State = matjournal.BoardAdopted\n48|\t\t\tinput.Bridge.LeaseActive = true\n49|\t\t\tinput.Bridge.BindingMatches = true\n50|\t\t\tinput.Bridge.ManagerMatches = true\n51|\t\t\tinput.NativeKnown = true\n52|\t\t\tinput.NativeBefore, input.NativeAfter = testNative, testNative\n53|\t\t}, matjournal.OutcomeRecoverableParked, \"Recover(contradictory)\")\n54|\t\tif !strings.Contains(evidence.Reason, \"contradicts\") {\n55|\t\t\tt.Fatalf(\"reason = %q\", evidence.Reason)\n56|\t\t}\n57|\t\tparkedMustFailClosed(t, dataDir, matjournal.PhaseStaging, evidence, \"Recover(contradictory)\")\n58|\t})\n59|\tt.Run(\"contradictory_rollback_with_activation_parks\", func(t *testing.T) {\n60|\t\tstore, dataDir := journalDirs(t)\n61|\t\tmustCreate(t, store, compositeInputs())\n62|\t\tconvergePrepared(t, store)\n63|\t\tif _, err := store.Transition(testMatID, matjournal.PhaseCommitting, matjournal.TransitionOpts{}); err != nil {\n64|\t\t\tt.Fatal(err)\n65|\t\t}\n66|\t\tif _, err := store.UpdateTaskBoard(testMatID, adoptedBoard()); err != nil {\n67|\t\t\tt.Fatal(err)\n68|\t\t}\n69|\t\t// A rollback phase with an activated sub-state contradicts\n70|\t\t// the progression; no production entry writes it (rollback\n71|\t\t// refuses past activation), so the test plants the torn\n72|\t\t// progression bytes directly and recovery quarantines\n73|\t\t// them instead of trusting them.\n74|\t\tjournalPath := filepath.Join(dataDir, \"materializations\", testMatID, \"journal.json\")\n75|\t\traw, err := os.ReadFile(journalPath)\n76|\t\tif err != nil {\n77|\t\t\tt.Fatal(err)\n78|\t\t}\n79|\t\tvar document map[string]any\n80|\t\tif err := json.Unmarshal(raw, &document); err != nil {\n81|\t\t\tt.Fatal(err)\n82|\t\t}\n83|\t\tdocument[\"phase\"] = matjournal.PhaseRollingBack\n84|\t\tplanted, err := json.Marshal(document)\n85|\t\tif err != nil {\n86|\t\t\tt.Fatal(err)\n87|\t\t}\n88|\t\tif err := os.WriteFile(journalPath, planted, 0o600); err != nil {\n89|\t\t\tt.Fatal(err)\n90|\t\t}\n91|\t\trestarted := reopenJournal(t, dataDir)\n92|\t\tevidence := recoverMust(t, restarted, matjournal.BoundaryAfterActivation, matjournal.PathOwnerResume, func(input *matjournal.RecoveryInput) {\n93|\t\t\tinput.Bridge.State = matjournal.BoardAdopted\n94|\t\t\tinput.Bridge.LeaseActive = true\n95|\t\t\tinput.Bridge.BindingMatches = true\n96|\t\t\tinput.Bridge.ManagerMatches = true\n97|\t\t\tinput.NativeKnown = true\n98|\t\t\tinput.NativeBefore, input.NativeAfter = testNative, testNative\n99|\t\t}, matjournal.OutcomeRecoverableParked, \"Recover(contradictory rollback)\")\n100|\t\tif !strings.Contains(evidence.Reason, \"contradicts\") {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
