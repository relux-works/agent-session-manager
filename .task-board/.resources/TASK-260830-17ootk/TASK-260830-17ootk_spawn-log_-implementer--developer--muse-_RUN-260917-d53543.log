-4ccc-8ddd-eeeeeeeeeeee\"\n33|\ttestLeaseB     = \"bbbbbbbb-cccc-4ddd-8eee-ffffffffffff\"\n34|)\n35|\n36|// Fixed digests. Well-formed content hashes the journal never\n37|// resolves: resolution belongs to the manifest owners.\n38|const (\n39|\ttestPlanID       = \"sha256:64644a5ad573d36c0c13f44f56ef25ab93cff33001ff2a3371b082603910f2dd\"\n40|\ttestCheckpointID = \"sha256:e051996f51f13ace4f5cdebe1e30fd26fd5fe104cfd6e6a7f9f1206ba3819656\"\n41|\ttestBundleID     = \"sha256:0af7b44e7063375a0f06e546fd820438c72607f191c14be78d35c8ffa109844f\"\n42|\ttestPriorID      = \"sha256:2222222222222222222222222222222222222222222222222222222222222222\"\n43|\ttestBlobA        = \"sha256:0e442b07e3772e8f5622478242ddf5f9f197bbd6a0402cd71471db4081abb291\"\n44|\ttestBlobB        = \"sha256:444e0fffbd825e9610ff5b199485707a0c895339ae80c15cc8a8aee41b106fda\"\n45|\ttestGroupRecord  = \"sha256:3b366ca989681c63323c5de6db28198796aa913947ad3cd9456fc6dcee62b743\"\n46|\ttestWsManifest   = \"sha256:a98ca90522b4de30e4aaaf9bf50529d09e15a817ffa67f94552fb313d1a1ad2e\"\n47|)\n48|\n49|// Fixed tokens: the spec provider/open vectors plus a derived import\n50|// token. Each decodes to at least 32 bytes of canonical base64url.\n51|const (\n52|\ttestProviderToken = \"YWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXowMTIzNDU2Nzg5QUI\"\n53|\ttestOpenToken     = \"b3duZXItb25seS1vcGVuLXRva2VuLTAxMjM0NTY3ODlhYmNkZWY\"\n54|\ttestImportToken   = \"aW1wb3J0LW9ubHktYnJpZGdlLXRva2VuLTAxMjM0NTY3ODk\"\n55|)\n56|\n57|const (\n58|\ttestRootWorkspace = \"/srv/relux\"\n59|\ttestRootProvider  = \"/home/ivan/.codex/sessions\"\n60|\ttestTxRoot        = \"/home/ivan/.local/state/ax/provider-transactions/codex/0198f4c8-f5c0-76dd-9677-1234567890ab\"\n61|\ttestStagingRoot   = \"/home/ivan/.local/state/ax/staging/0198f4c8-c290-73aa-9374-1234567890ab\"\n62|)\n63|\n64|// fixedClock pins store time to one instant.\n65|func fixedClock() time.Time {\n66|\treturn time.Date(2026, time.August, 19, 4, 12, 0, 0, time.UTC)\n67|}\n68|\n69|// openTestStore binds an empty journal store in a temp dir with a\n70|// fixed clock.\n71|func openTestStore(t *testing.T) *Store {\n72|\tt.Helper()\n73|\tstore, err := Open(t.TempDir())\n74|\tif err != nil {\n75|\t\tt.Fatal(err)\n76|\t}\n77|\tstore.Now = fixedClock\n78|\treturn store\n79|}\n80|\n81|// testRequestBody returns the complete prepare request body carrying\n82|// both caller-stable IDs.\n83|func testRequestBody() []byte {\n84|\treturn []byte(`{\"materialization_id\":\"` + testMatID + `\",\"operation_id\":\"` + testPrepareOp + `\",\"plan_id\":\"` + testPlanID + `\"}`)\n85|}\n86|\n87|// testInputs returns the workspace prepare closure over one workspace\n88|// authority with no provider or bridge.\n89|func testInputs() CreateInputs {\n90|\treturn CreateInputs{\n91|\t\tMaterializationID:  testMatID,\n92|\t\tPrepareOperationID: testPrepareOp,\n93|\t\tRequestBody:        testRequestBody(),\n94|\t\tTransferID:         testTransfer,\n95|\t\tPlanID:             testPlanID,\n96|\t\tSourceCheckpointID: testCheckpointID,\n97|\t\tManagedReplicaID:   testReplicaID,\n98|\t\tPlan: []PlanAuthority{\n99|\t\t\t{ID: \"workspace_relux\", Kind: PlanKindWorkspace, Platform: \"linux\", RootPath: testRootWorkspace},\n100|\t\t},\n101|\t\tHostPlatform:              \"linux\",\n102|\t\tExpectedPriorCheckpointID: testPriorID,\n103|\t\tExtensions:                map[string]string{},\n104|\t}\n105|}\n106|\n107|// testInputsComposite returns the composite prepare closure: a\n108|// workspace authority, a provider-store authority, and a task-board\n109|// bridge in ownership_transfer mode.\n110|func testInputsComposite() CreateInputs {\n111|\tinputs := testInputs()\n112|\tinputs.Plan = []PlanAuthority{\n113|\t\t{ID: \"codex_sessions\", Kind: PlanKindProviderStore, Platform: \"linux\", RootPath: testRootProvider},\n114|\t\t{ID: \"workspace_relux\", Kind: PlanKindWorkspace, Platform: \"linux\", RootPath: testRootWorkspace},\n115|\t}\n116|\tinputs.BundleID = testBundleID\n117|\tinputs.ActivationMode = ModeOwnershipTransfer\n118|\tinputs.ImportOperationID = testImportOp\n119|\tinputs.OpenOperationID = testOpenOp\n120|\tinputs.AdoptOperationID = testAdoptOp\n121|\tinputs.ResumeOperationID = testResumeOp\n122|\treturn inputs\n123|}\n124|\n125|// testInputsBoardOnly returns the task-board-only closure: one staging\n126|// authority, no workspace bytes, dormant activation.\n127|func testInputsBoardOnly() CreateInputs {\n128|\tinputs := CreateInputs{\n129|\t\tMaterializationID:  testMatID,\n130|\t\tPrepareOperationID: testPrepareOp,\n131|\t\tRequestBody:        testRequestBody(),\n132|\t\tPlanID:             testPlanID,\n133|\t\tSourceCheckpointID: testCheckpointID,\n134|\t\tPlan: []PlanAuthority{\n135|\t\t\t{ID: \"board_staging\", Kind: PlanKindTaskBoardStaging, Platform: \"linux\", RootPath: testStagingRoot},\n136|\t\t},\n137|\t\tHostPlatform:      \"linux\",\n138|\t\tBundleID:          testBundleID,\n139|\t\tActivationMode:    ModeDormantReplica,\n140|\t\tImportOperationID: testImportOp,\n141|\t\tOpenOperationID:   testOpenOp,\n142|\t\tAdoptOperationID:  testAdoptOp,\n143|\t\tResumeOperationID: testResumeOp,\n144|\t\tExtensions:        map[string]string{},\n145|\t}\n146|\treturn inputs\n147|}\n148|\n149|// mustCreate creates through the production entry or fails.\n150|func mustCreate(t *testing.T, store *Store, inputs CreateInputs) (JournalRef, Journal) {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
