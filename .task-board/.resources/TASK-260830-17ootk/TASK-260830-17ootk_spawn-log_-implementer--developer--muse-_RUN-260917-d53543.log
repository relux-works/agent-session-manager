want the interior fault\", err)\n198|\t}\n199|\trestarted := reopen(t, store)\n200|\tloaded, _, err := restarted.Get(testMatID)\n201|\tif err != nil {\n202|\t\tt.Fatal(err)\n203|\t}\n204|\tif loaded.Provider == nil || loaded.Provider.State != ProviderPrepared || loaded.Provider.RollbackToken == nil {\n205|\t\tt.Fatalf(\"provider = %+v, want the durable prepared token\", loaded.Provider)\n206|\t}\n207|\t// Status agrees with the durable token: the operation continues\n208|\t// to commit under the same IDs.\n209|\tinput := baseRecoveryInput()\n210|\tinput.Boundary = BoundaryAfterPrepareOp\n211|\tinput.Bridge.State = BoardNotStarted\n212|\toutcome, _, err := restarted.Recover(testMatID, input)\n213|\tif err != nil {\n214|\t\tt.Fatalf(\"Recover error = %v\", err)\n215|\t}\n216|\tmustOutcome(t, outcome, OutcomeSafeRetry, \"Recover(CR-MAT-05 provider)\")\n217|}\n218|\n219|func TestCrashAfterBridgeImportPersists(t *testing.T) {\n220|\tstore := openTestStore(t)\n221|\tmustCreate(t, store, testInputsComposite())\n222|\tinterrupted := errors.New(\"crash after bridge import\")\n223|\tstore.AfterJournal = func() error { return interrupted }\n224|\t// CR-MAT-05, bridge half: the imported state is durable.\n225|\t_, err := store.UpdateTaskBoard(testMatID, testBoardImported())\n226|\tif !errors.Is(err, interrupted) {\n227|\t\tt.Fatalf(\"UpdateTaskBoard fault = %v, want the interior fault\", err)\n228|\t}\n229|\trestarted := reopen(t, store)\n230|\tloaded, _, err := restarted.Get(testMatID)\n231|\tif err != nil {\n232|\t\tt.Fatal(err)\n233|\t}\n234|\tif loaded.TaskBoard.State != BoardImported || loaded.TaskBoard.ImportToken == nil {\n235|\t\tt.Fatalf(\"task-board = %+v, want the durable imported state\", loaded.TaskBoard)\n236|\t}\n237|\tinput := baseRecoveryInput()\n238|\tinput.Boundary = BoundaryAfterPrepareOp\n239|\tinput.Provider.State = ProviderPrepared\n240|\tinput.Bridge.State = BoardImported\n241|\toutcome, _, err := restarted.Recover(testMatID, input)\n242|\tif err != nil {\n243|\t\tt.Fatalf(\"Recover error = %v\", err)\n244|\t}\n245|\tmustOutcome(t, outcome, OutcomeSafeRetry, \"Recover(CR-MAT-05 bridge)\")\n246|}\n247|\n248|func TestCrashAfterOpenOrPreparedContinues(t *testing.T) {\n249|\tt.Run(\"open\", func(t *testing.T) {\n250|\t\tstore := openTestStore(t)\n251|\t\tmustCreate(t, store, testInputsComposite())\n252|\t\tif _, err := store.UpdateTaskBoard(testMatID, testBoardImported()); err != nil {\n253|\t\t\tt.Fatal(err)\n254|\t\t}\n255|\t\tinterrupted := errors.New(\"crash after bridge open\")\n256|\t\tstore.AfterJournal = func() error { return interrupted }\n257|\t\t// CR-MAT-06, bridge half: the opened state is durable.\n258|\t\t_, err := store.UpdateTaskBoard(testMatID, testBoardOpened())\n259|\t\tif !errors.Is(err, interrupted) {\n260|\t\t\tt.Fatalf(\"UpdateTaskBoard fault = %v, want the interior fault\", err)\n261|\t\t}\n262|\t\trestarted := reopen(t, store)\n263|\t\tloaded, _, err := restarted.Get(testMatID)\n264|\t\tif err != nil {\n265|\t\t\tt.Fatal(err)\n266|\t\t}\n267|\t\tif loaded.TaskBoard.State != BoardOpened {\n268|\t\t\tt.Fatalf(\"task-board = %q\", loaded.TaskBoard.State)\n269|\t\t}\n270|\t\tinput := baseRecoveryInput()\n271|\t\tinput.Boundary = BoundaryAfterOpen\n272|\t\tinput.Provider.State = ProviderPrepared\n273|\t\tinput.Bridge.State = BoardOpened\n274|\t\toutcome, _, err := restarted.Recover(testMatID, input)\n275|\t\tif err != nil {\n276|\t\t\tt.Fatalf(\"Recover error = %v\", err)\n277|\t\t}\n278|\t\tmustOutcome(t, outcome, OutcomeSafeRetry, \"Recover(CR-MAT-06 open)\")\n279|\t})\n280|\tt.Run(\"prepared\", func(t *testing.T) {\n281|\t\tstore := openTestStore(t)\n282|\t\tmustCreate(t, store, testInputsComposite())\n283|\t\tmustConvergePrepared(t, store)\n284|\t\t// CR-MAT-06, host half: the prepared journal survives the\n285|\t\t// restart and continues under the same IDs.\n286|\t\trestarted := reopen(t, store)\n287|\t\tinput := baseRecoveryInput()\n288|\t\tinput.Boundary = BoundaryAfterOpen\n289|\t\tinput.Bridge.State = BoardOpened\n290|\t\toutcome, _, err := restarted.Recover(testMatID, input)\n291|\t\tif err != nil {\n292|\t\t\tt.Fatalf(\"Recover error = %v\", err)\n293|\t\t}\n294|\t\tmustOutcome(t, outcome, OutcomeSafeRetry, \"Recover(CR-MAT-06 prepared)\")\n295|\t})\n296|}\n297|\n298|func TestCrashAfterActivationReconciles(t *testing.T) {\n299|\tsetup := func(t *testing.T) *Store {\n300|\t\tstore := openTestStore(t)\n301|\t\tmustCreate(t, store, testInputsComposite())\n302|\t\tmustConvergePrepared(t, store)\n303|\t\tif _, err := store.Transition(testMatID, PhaseCommitting, TransitionOpts{}); err != nil {\n304|\t\t\tt.Fatal(err)\n305|\t\t}\n306|\t\treturn store\n307|\t}\n308|\tnative := \"tbm:manager:0198f4c8-7a10-7b22-8b3c-2234567890ab:\" + testLeaseID\n309|\tt.Run(\"adopted_finalizes\", func(t *testing.T) {\n310|\t\tstore := setup(t)\n311|\t\tinterrupted := errors.New(\"crash after adopt recorded\")\n312|\t\tstore.AfterJournal = func() error { return interrupted }\n313|\t\t// CR-MAT-07: owner activation may have occurred; the\n314|\t\t// adopted binding is durable and status agrees.\n315|\t\t_, err := store.UpdateTaskBoard(testMatID, testBoardAdopted())\n316|\t\tif !errors.Is(err, interrupted) {\n317|\t\t\tt.Fatalf(\"UpdateTaskBoard fault = %v, want the interior fault\", err)\n318|\t\t}\n319|\t\trestarted := reopen(t, store)\n320|\t\tinput := baseRecoveryInput()\n321|\t\tinput.Boundary = BoundaryAfterActivation\n322|\t\tinput.Bridge.State = BoardAdopted\n323|\t\tinput.Bridge.LeaseActive = true\n324|\t\tinput.Bridge.BindingMatches = true\n325|\t\tinput.Bridge.ManagerMatches = true\n326|\t\tinput.NativeKnown = true\n327|\t\tinput.NativeBefore, input.NativeAfter = native, native\n328|\t\toutcome, evidence, err := restarted.Recover(testMatID, input)\n329|\t\tif err != nil {\n330|\t\t\tt.Fatalf(\"Recover error = %v\", err)\n331|\t\t}\n332|\t\tmustOutcome(t, outcome, OutcomeSafeRetry, \"Recover(CR-MAT-07 adopted)\")\n333|\t\tif evidence.OperationIDs[\"adopt_operation_id\"] != testAdoptOp {\n334|\t\t\tt.Fatalf(\"operation IDs = %+v\", evidence.OperationIDs)\n335|\t\t}\n336|\t})\n337|\tt.Run(\"ambiguous_parks\", func(t *testing.T) {\n338|\t\tstore := setup(t)\n339|\t\trestarted := reopen(t, store)\n340|\t\t// CR-MAT-07 with an unreachable bridge: adoption is\n341|\t\t// uncertain, so recovery parks instead of guessing.\n342|\t\tinput := baseRecoveryInput()\n343|\t\tinput.Boundary = BoundaryAfterActivation\n344|\t\tinput.Bridge.State = ProviderUnknown\n345|\t\toutcome, _, err := restarted.Recover(testMatID, input)\n346|\t\tif err != nil {\n347|\t\t\tt.Fatalf(\"Recover error = %v\", err)\n348|\t\t}\n349|\t\tmustOutcome(t, outcome, OutcomeRecoverableParked, \"Recover(CR-MAT-07 ambiguous)\")\n350|\t})\n351|}\n352|\n353|func TestCrashAfterFinalizeCloses(t *testing.T) {\n354|\tt.Run(\"resumed_commits\", func(t *testing.T) {\n355|\t\tstore := openTestStore(t)\n356|\t\tmustCreate(t, store, testInputsBoardOnlyOwnership())\n357|\t\tif _, err := store.UpdateTaskBoard(testMatID, testBoardImported()); err != nil {\n358|\t\t\tt.Fatal(err)\n359|\t\t}\n360|\t\tif _, err := store.UpdateTaskBoard(testMatID, testBoardOpened()); err != nil {\n361|\t\t\tt.Fatal(err)\n362|\t\t}\n363|\t\tstagingBackup := \"/home/ivan/.local/state/ax/materializations/\" + testMatID + \"/board_staging\"\n364|\t\tif _, err := store.UpdateAuthority(testMatID, \"board_staging\", AuthorityState{\n365|\t\t\tRootPath: testStagingRoot, CompletedSequences: []uint64{1},\n366|\t\t\tRollbackRoot: &stagingBackup, State: AuthorityPrepared,\n367|\t\t}); err != nil {\n368|\t\t\tt.Fatal(err)\n369|\t\t}\n370|\t\tif _, err := store.UpdateAuthority(testMatID, \"board_staging\", AuthorityState{\n371|\t\t\tRootPath: testStagingRoot, CompletedSequences: []uint64{1}, State: AuthorityCommitted,\n372|\t\t}); err != nil {\n373|\t\t\tt.Fatal(err)\n374|\t\t}\n375|\t\tif _, err := store.Transition(testMatID, PhaseValidating, TransitionOpts{}); err != nil {\n376|\t\t\tt.Fatal(err)\n377|\t\t}\n378|\t\tif _, err := store.Transition(testMatID, PhasePrepared, TransitionOpts{}); err != nil {\n379|\t\t\tt.Fatal(err)\n380|\t\t}\n381|\t\tif _, err := store.Transition(testMatID, PhaseCommitting, TransitionOpts{}); err != nil {\n382|\t\t\tt.Fatal(err)\n383|\t\t}\n384|\t\tif _, err := store.UpdateTaskBoard(testMatID, testBoardAdopted()); err != nil {\n385|\t\t\tt.Fatal(err)\n386|\t\t}\n387|\t\tinterrupted := errors.New(\"crash after resume recorded\")\n388|\t\tstore.AfterJournal = func() error { return interrupted }\n389|\t\t// CR-MAT-08: finalize may have occurred; the resumed state\n390|\t\t// is durable.\n391|\t\t_, err := store.UpdateTaskBoard(testMatID, testBoardResumed())\n392|\t\tif !errors.Is(err, interrupted) {\n393|\t\t\tt.Fatalf(\"UpdateTaskBoard fault = %v, want the interior fault\", err)\n394|\t\t}\n395|\t\trestarted := reopen(t, store)\n396|\t\tinput := baseRecoveryInput()\n397|\t\tinput.Boundary = BoundaryAfterFinalize\n398|\t\tinput.Provider.State = ProviderUnknown\n399|\t\tinput.Bridge.State = \"running\"\n400|\t\tinput.Bridge.LeaseActive = true\n401|\t\tinput.Bridge.BindingMatches = true\n402|\t\tinput.Bridge.ManagerMatches = true\n403|\t\tinput.NativeKnown = true\n404|\t\tinput.NativeBefore = \"tbm:manager:0198f4c8-7a10-7b22-8b3c-2234567890ab:\" + testLeaseID\n405|\t\tinput.NativeAfter = input.NativeBefore\n406|\t\toutcome, _, err := restarted.Recover(testMatID, input)\n407|\t\tif err != nil {\n408|\t\t\tt.Fatalf(\"Recover error = %v\", err)\n409|\t\t}\n410|\t\tmustOutcome(t, outcome, OutcomeSafeRetry, \"Recover(CR-MAT-08 resumed)\")\n411|\t\tloaded, _, err := restarted.Get(testMatID)\n412|\t\tif err != nil {\n413|\t\t\tt.Fatal(err)\n414|\t\t}\n415|\t\tif loaded.Phase != PhaseCommitted {\n416|\t\t\tt.Fatalf(\"phase = %q, want the completed commit\", loaded.Phase)\n417|\t\t}\n418|\t})\n419|\tt.Run(\"ambiguous_parks\", func(t *testing.T) {\n420|\t\tstore := openTestStore(t)\n421|\t\tmustCreate(t, store, testInputsBoardOnlyOwnership())\n422|\t\tif _, err := store.UpdateTaskBoard(testMatID, testBoardImported()); err != nil {\n423|\t\t\tt.Fatal(err)\n424|\t\t}\n425|\t\tif _, err := store.UpdateTaskBoard(testMatID, testBoardOpened()); err != nil {\n426|\t\t\tt.Fatal(err)\n427|\t\t}\n428|\t\tif _, err := store.Transition(testMatID, PhaseValidating, TransitionOpts{}); err != nil {\n429|\t\t\tt.Fatal(err)\n430|\t\t}\n431|\t\tif _, err := store.Transition(testMatID, PhasePrepared, TransitionOpts{}); err != nil {\n432|\t\t\tt.Fatal(err)\n433|\t\t}\n434|\t\tif _, err := store.Transition(testMatID, PhaseCommitting, TransitionOpts{}); err != nil {\n435|\t\t\tt.Fatal(err)\n436|\t\t}\n437|\t\trestarted := reopen(t, store)\n438|\t\t// CR-MAT-08 with finalize unproven: recovery parks with\n439|\t\t// the blocking reason durable.\n440|\t\tinput := baseRecoveryInput()\n441|\t\tinput.Boundary = BoundaryAfterFinalize\n442|\t\tinput.Provider.State = ProviderUnknown\n443|\t\tinput.Bridge.State = ProviderUnknown\n444|\t\toutcome, _, err := restarted.Recover(testMatID, input)\n445|\t\tif err != nil {\n446|\t\t\tt.Fatalf(\"Recover error = %v\", err)\n447|\t\t}\n448|\t\tmustOutcome(t, outcome, OutcomeRecoverableParked, \"Recover(CR-MAT-08 ambiguous)\")\n449|\t})\n450|}\n451|\n452|// testInputsBoardOnlyOwnership returns the task-board-only closure in\n453|// ownership_transfer mode: no provider branch, no workspace bytes.\n454|func testInputsBoardOnlyOwnership() CreateInputs {\n455|\tinputs := testInputsBoardOnly()\n456|\tinputs.ActivationMode = ModeOwnershipTransfer\n457|\treturn inputs\n458|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
