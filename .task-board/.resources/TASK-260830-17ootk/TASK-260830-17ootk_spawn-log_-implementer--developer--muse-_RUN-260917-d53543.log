    run: |\\n          set +e\\n          go test ./internal/cigate -run 'TestListedTargetsMatchDerivation|TestFuzzTargetsAreDerivedSorted' -count=1 -v > cigate-targets.log 2>&1\\n          code=$?\\n          set -e\\n          cat cigate-targets.log\\n          test $code -eq 0\\n          for gate in TestListedTargetsMatchDerivation TestFuzzTargetsAreDerivedSorted; do\\n            grep -q \\\"^--- PASS: ${gate}\\\" cigate-targets.log\\n          done\\n\\n      # A -fuzz selector that matches nothing exits 0 with \\\"no fuzz tests\\n      # to fuzz\\\", so exit status alone cannot prove execution. The\\n      # '^fuzz: elapsed' line proves the engine ran; its absence fails.\\n      # It does not prove the mutation phase: at -fuzztime=100x the\\n      # large-corpus targets (secconftest/FuzzRedactCorpus, all four\\n      # canonicaljson targets) spend the budget on baseline coverage and\\n      # never print 'now fuzzing'. Lengthening the budget or shrinking a\\n      # corpus changes that without reddening here.\\n      - name: Smoke each target\\n        run: |\\n          while read -r pkg target; do\\n            go test \\\"./${pkg}\\\" -run='^$' -fuzz=\\\"^${target}$\\\" -fuzztime=100x -parallel=1 -count=1 > \\\"fuzz-$(basename \\\"${pkg}\\\")-${target}.log\\\" 2>&1\\n            grep -q '^fuzz: elapsed' \\\"fuzz-$(basename \\\"${pkg}\\\")-${target}.log\\\"\\n          done < fuzz-targets.clean\\n\\n  capability-claims:\\n    name: Unsupported-capability claim check\\n\",\n  \"original_output_bytes\": 4398,\n  \"original_output_tokens\": 1100,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
