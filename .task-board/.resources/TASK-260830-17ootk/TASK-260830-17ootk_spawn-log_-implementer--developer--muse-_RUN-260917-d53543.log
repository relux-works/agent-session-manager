{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000caed","stream":{"kind":"session","id":"01a0ae2b-f4bb-7310-a5c5-e45123d43dca"},"sequence":977,"recorded_at":1780531400001949,"record_type":"event","durability":"durable","causation_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","run_stream":{"kind":"run","id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3"},"task_stream":{"kind":"task","id":"01a0ae30-7e8c-7d30-be52-1c32ccd877d5"},"task_id":"01a0ae30-7e8c-7d30-be52-1c32ccd877d5","event":{"kind":"output","task_id":"01a0ae30-7e8c-7d30-be52-1c32ccd877d5","chunk":"Read text file `internal/traceability/traceability.go`.\n(1213 line(s) above)\n1214|\tif group.Coverage != measured {\n1215|\t\treturn sectionCoverage{}, fail(\n1216|\t\t\t\"section binding %q claims %s coverage but discharges %d of the %d normative clauses of the pinned section, which is %s coverage\",\n1217|\t\t\tkey, group.Coverage, len(group.Clauses), len(inventory), measured)\n1218|\t}\n1219|\tdisplay, err := sectionDisplayName(key)\n1220|\tif err != nil {\n1221|\t\treturn sectionCoverage{}, fail(\"section binding %q: %v\", key, err)\n1222|\t}\n1223|\t// Every level below full owes a gap, coverageUnmeasured included. Before\n1224|\t// this the gate refused a gap on the unmeasured bucket, so the bindings with\n1225|\t// the least evidence behind them were the only ones structurally forbidden\n1226|\t// from disclosing it.\n1227|\tswitch measured {\n1228|\tcase coverageFull:\n1229|\t\tif group.Gap != \"\" {\n1230|\t\t\treturn sectionCoverage{}, fail(\"section binding %q claims %s coverage and still names a gap\", key, measured)\n1231|\t\t}\n1232|\tdefault:\n1233|\t\tif err := verifyGapDiscloses(group.Gap, display, group.Production.Declaration); err != nil {\n1234|\t\t\treturn sectionCoverage{}, fail(\n1235|\t\t\t\t\"section binding %q claims %s coverage without naming what %s leaves unimplemented: %v\",\n1236|\t\t\t\tkey, measured, display, err)\n1237|\t\t}\n1238|\t}\n1239|\treturn sectionCoverage{\n1240|\t\tKey:        key,\n1241|\t\tLevel:      measured,\n1242|\t\tDischarged: len(group.Clauses),\n1243|\t\tTotal:      len(inventory),\n1244|\t\tGap:        group.Gap,\n1245|\t}, nil\n1246|}\n1247|\n1248|// quoteBeginsAtLine reports whether the normalized excerpt occurs in the pinned\n1249|// document beginning on the given line. An excerpt matching elsewhere, or\n1250|// nowhere, is not a quote of the clause it claims.\n1251|func quoteBeginsAtLine(document *specdoc.Document, excerpt string, line int) bool {\n1252|\tfor _, candidate := range document.QuoteLines(excerpt) {\n1253|\t\tif candidate == line {\n1254|\t\t\treturn true\n1255|\t\t}\n1256|\t}\n1257|\treturn false\n1258|}\n1259|\n1260|// verifyUnownedSections checks the disclosed unimplemented sections. An entry\n1261|// must name a real section, must not also be owned, must not cover a section\n1262|// the generated catalog requires an owner for, and must state a gap and the\n1263|// evidence for it.\n1264|func verifyUnownedSections(\n1265|\tentries []unownedSection,\n1266|\tallowed map[string]struct{},\n1267|\trequiredByCatalog map[string]struct{},\n1268|\towned map[string]struct{},\n1269|) (map[string]unownedSection, error) {\n1270|\tresult := make(map[string]unownedSection, len(entries))\n1271|\tfor index, entry := range entries {\n1272|\t\tif entry.Key == \"\" {\n1273|\t\t\treturn nil, fail(\"unowned section %d has an empty key\", index)\n1274|\t\t}\n1275|\t\tif _, duplicate := result[entry.Key]; duplicate {\n1276|\t\t\treturn nil, fail(\"duplicate unowned section %q\", entry.Key)\n1277|\t\t}\n1278|\t\tif _, known := allowed[entry.Key]; !known {\n1279|\t\t\treturn nil, fail(\"unowned section %q is self-minted for an unknown section\", entry.Key)\n1280|\t\t}\n1281|\t\tif _, required := requiredByCatalog[entry.Key]; required {\n1282|\t\t\treturn nil, fail(\n1283|\t\t\t\t\"unowned section %q is required to have an implementation owner by the generated catalog\", entry.Key)\n1284|\t\t}\n1285|\t\tif _, conflict := owned[entry.Key]; conflict {\n1286|\t\t\treturn nil, fail(\"section %q is registered as both owned and unowned\", entry.Key)\n1287|\t\t}\n1288|\t\tdisplay, err := sectionDisplayName(entry.Key)\n1289|\t\tif err != nil {\n1290|\t\t\treturn nil, fail(\"unowned section %q: %v\", entry.Key, err)\n1291|\t\t}\n1292|\t\t// An unowned section has no production declaration by construction, so\n1293|\t\t// the gap is checked for length and a whole-identifier section mention\n1294|\t\t// only, and the separate evidence field carries the rest.\n1295|\t\tif err := verifyGapDiscloses(entry.Gap, display, \"\"); err != nil {\n1296|\t\t\treturn nil, fail(\"unowned section %q does not name what %s leaves unimplemented: %v\", entry.Key, display, err)\n1297|\t\t}\n1298|\t\tif len(entry.Evidence) < minimumGapLength {\n1299|\t\t\treturn nil, fail(\"unowned section %q states no evidence for its gap\", entry.Key)\n1300|\t\t}\n1301|\t\tresult[entry.Key] = entry\n1302|\t}\n1303|\treturn result, nil\n1304|}","final_result":true}}}
