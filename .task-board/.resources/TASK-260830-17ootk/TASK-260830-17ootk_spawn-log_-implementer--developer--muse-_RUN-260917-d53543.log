{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5b5","stream":{"kind":"session","id":"01a0ae2b-f4bb-7310-a5c5-e45123d43dca"},"sequence":309,"recorded_at":1780531400000613,"record_type":"event","durability":"durable","causation_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","run_stream":{"kind":"run","id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3"},"task_stream":{"kind":"task","id":"01a0ae2c-e8a6-7bd3-8ca2-990ddb7f609d"},"task_id":"01a0ae2c-e8a6-7bd3-8ca2-990ddb7f609d","event":{"kind":"output","task_id":"01a0ae2c-e8a6-7bd3-8ca2-990ddb7f609d","chunk":"Read text file `internal/matjournal/recover.go`.\n1|package matjournal\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"fmt\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|)\n12|\n13|// Recovery outcomes (SPEC Section 13.13): exactly one classifies every\n14|// crash boundary. They are mutually exclusive and collectively\n15|// exhaustive; missing, stale, contradictory, unreachable, or ambiguous\n16|// evidence selects recoverable_parked_state, and no fourth outcome\n17|// exists.\n18|type Outcome string\n19|\n20|const (\n21|\t// OutcomeSafeRetry means the same logical operation can continue\n22|\t// or return its recorded result with every caller-stable ID and a\n23|\t// byte-identical immutable input, after reconciling any uncertain\n24|\t// external effect and allocating no second process, manager,\n25|\t// handle, lease, authority, or transaction root.\n26|\tOutcomeSafeRetry Outcome = \"safe_retry\"\n27|\t// OutcomeExplicitRollback means recovery executed an allowed\n28|\t// abort, rollback, or proven closure before owner activation,\n29|\t// restoring every affected predecessor or removing only inert\n30|\t// fresh staging, with the terminal result durable and visible.\n31|\tOutcomeExplicitRollback Outcome = \"explicit_rollback\"\n32|\t// OutcomeRecoverableParked means recovery cannot yet prove safe\n33|\t// replay or legal rollback, so it fails closed with the lease,\n34|\t// IDs, checkpoint/native identity, phase, and blocking reason\n35|\t// recoverable and input blocked.\n36|\tOutcomeRecoverableParked Outcome = \"recoverable_parked_state\"\n37|)\n38|\n39|// Crash boundaries for every materialization (SPEC Section 13.13\n40|// CR-MAT-01..08): before journal creation; after journal/prepare\n41|// receipt; after transfer; after validation; after provider prepare or\n42|// bridge import; after bridge open or host commit enters prepared;\n43|// after owner activation may have occurred; after finalize/cleanup may\n44|// have occurred but before its result is durable.\n45|const (\n46|\tBoundaryBeforeCreate    = \"CR-MAT-01\"\n47|\tBoundaryAfterPrepare    = \"CR-MAT-02\"\n48|\tBoundaryAfterTransfer   = \"CR-MAT-03\"\n49|\tBoundaryAfterValidation = \"CR-MAT-04\"\n50|\tBoundaryAfterPrepareOp  = \"CR-MAT-05\"\n51|\tBoundaryAfterOpen       = \"CR-MAT-06\"\n52|\tBoundaryAfterActivation = \"CR-MAT-07\"\n53|\tBoundaryAfterFinalize   = \"CR-MAT-08\"\n54|)\n55|\n56|// validBoundary reports whether the boundary names the registry.\n57|func validBoundary(boundary string) bool {\n58|\tswitch boundary {\n59|\tcase BoundaryBeforeCreate, BoundaryAfterPrepare, BoundaryAfterTransfer,\n60|\t\tBoundaryAfterValidation, BoundaryAfterPrepareOp, BoundaryAfterOpen,\n61|\t\tBoundaryAfterActivation, BoundaryAfterFinalize:\n62|\t\treturn true\n63|\tdefault:\n64|\t\treturn false\n65|\t}\n66|}\n67|\n68|// Recovery paths the CR-MAT row applies to independently.\n69|const (\n70|\tPathGracefulTakeover = \"graceful_takeover\"\n71|\tPathForceTakeover    = \"force_takeover\"\n72|\tPathPassiveSync      = \"passive_sync\"\n73|\tPathOwnerResume      = \"owner_resume\"\n74|\tPathFork             = \"fork\"\n75|)\n76|\n77|func validPath(path string) bool {\n78|\tswitch path {\n79|\tcase PathGracefulTakeover, PathForceTakeover, PathPassiveSync, PathOwnerResume, PathFork:\n80|\t\treturn true\n81|\tdefault:\n82|\t\treturn false\n83|\t}\n84|}\n85|\n86|// Host conditions (SPEC Section 13.12): destination disk full and\n87|// atomic rename blocked. Either parks with its remediation; neither\n88|// overwrites in place.\n89|const (\n90|\tHostOK            = \"none\"\n91|\tHostDiskFull      = \"disk_full\"\n92|\tHostRenameBlocked = \"rename_blocked\"\n93|)\n94|\n95|// Marker probe states: absent, a valid marker matching the journal, a\n96|// mismatching marker, or an invalid marker.\n97|const (\n98|\tMarkerAbsent     = \"absent\"\n99|\tMarkerValidMatch = \"valid_match\"\n100|\tMarkerMismatch   = \"mismatch\"\n101|\tMarkerInvalid    = \"invalid\"\n102|)\n103|\n104|// ProviderProbe is the modeled materialize-status reading: the plugin\n105|// state with ID, plan, and token agreement against the journal.\n106|type ProviderProbe struct {\n107|\tState        string\n108|\tIDsMatch     bool\n109|\tPlanMatches  bool\n110|\tTokenMatches bool\n111|}\n112|\n113|// BridgeProbe is the modeled bridge-status reading: the manager state\n114|// with binding and reference agreement, lease authority for adopt,\n115|// liveness, and token expiry.\n116|type BridgeProbe struct {\n117|\tState          string\n118|\tBindingMatches bool\n119|\tManagerMatches bool\n120|\tLeaseActive    bool\n121|\tLive           bool\n122|\tTokenExpired   bool\n123|\tFailed         bool\n124|}\n125|\n126|// LeaseIdentity is the winning-lease observation before or after the\n127|// crash: epoch plus fencing token.\n128|type LeaseIdentity struct {\n129|\tEpoch uint64 `json:\"epoch\"`\n130|\tID    string `json:\"lease_id\"`\n131|}\n132|\n133|// RecoveryInput is the status-first recovery closure: the crash\n134|// boundary and path, one status probe per possibly executed external\n135|// effect, the host condition, the winning lease and native\n136|// identity/binding before and after, and the rollback-closure proofs.\n137|// Durable facts (journal, receipt, plan view) are read first from the\n138|// store; these modeled inputs stand in for the provider plugin,\n139|// bridge process, replica files, and lease arbitration this package\n140|// never drives.\n141|type RecoveryInput struct {\n142|\tBoundary    string\n143|\tPath        string\n144|\tProvider    ProviderProbe\n145|\tBridge      BridgeProbe\n146|\tMarker      string\n147|\tHost        string\n148|\tLeaseKnown  bool\n149|\tLeaseBefore LeaseIdentity\n150|\tLeaseAfter  LeaseIdentity\n(more lines below)","final_result":true}}}
