{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cd9f","stream":{"kind":"session","id":"01a0ae2b-f4bb-7310-a5c5-e45123d43dca"},"sequence":1322,"recorded_at":1780531400002639,"record_type":"event","durability":"durable","causation_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","run_stream":{"kind":"run","id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3"},"task_stream":{"kind":"task","id":"01a0ae37-06c0-7be3-b99d-c625e0c63731"},"task_id":"01a0ae37-06c0-7be3-b99d-c625e0c63731","event":{"kind":"output","task_id":"01a0ae37-06c0-7be3-b99d-c625e0c63731","chunk":"Read text file `internal/sessckpt/capture_test.go`.\n(296 line(s) above)\n297|func TestCaptureTaskBoardVariantInstalls(t *testing.T) {\n298|\tchain, created := chainFixture(t)\n299|\tstore := openTestStore(t)\n300|\tinputs := testInputs([]string{created}, testOpA)\n301|\tinputs.SessionKind = SessionKindTaskBoard\n302|\tinputs.ProviderManifestID = \"\"\n303|\tinputs.TaskBoardBundleID = testBoardBundle\n304|\tref, raw := mustCapture(t, store, chain, inputs)\n305|\tif _, _, err := sessrepo.AttestCheckpointRecord(raw); err != nil {\n306|\t\tt.Fatalf(\"AttestCheckpointRecord error = %v\", err)\n307|\t}\n308|\tvar value map[string]any\n309|\tif err := json.Unmarshal(raw, &value); err != nil {\n310|\t\tt.Fatal(err)\n311|\t}\n312|\tif value[\"provider_manifest_id\"] != nil {\n313|\t\tt.Fatalf(\"task_board record provider_manifest_id = %v, want null\", value[\"provider_manifest_id\"])\n314|\t}\n315|\tif value[\"task_board_bundle_id\"] == nil {\n316|\t\tt.Fatalf(\"task_board record task_board_bundle_id is null, want %q\", testBoardBundle)\n317|\t}\n318|\tif ref.CheckpointID == \"\" {\n319|\t\tt.Fatalf(\"empty checkpoint id\")\n320|\t}\n321|}\n322|\n323|func TestSpecExampleAttestsThroughConsumerOwner(t *testing.T) {\n324|\t// The verbatim SPEC Section 5.4 normative example attests\n325|\t// through the same sessrepo owner the capture entry uses, so\n326|\t// the exact contract fixture and the implementation agree on\n327|\t// the closed shape.\n328|\tdigest, field, err := sessrepo.AttestCheckpointRecord([]byte(specCheckpointExample))\n329|\tif err != nil {\n330|\t\tt.Fatalf(\"AttestCheckpointRecord(spec example) error = %v\", err)\n331|\t}\n332|\tif field != canonicaljson.SelfCheckpointID {\n333|\t\tt.Fatalf(\"example identity field = %q, want checkpoint_id\", string(field))\n334|\t}\n335|\tif digest.String() != \"sha256:e051996f51f13ace4f5cdebe1e30fd26fd5fe104cfd6e6a7f9f1206ba3819656\" {\n336|\t\tt.Fatalf(\"example digest = %q\", digest)\n337|\t}\n338|}\n339|\n340|func TestCaptureIdenticalClosuresShareIdentity(t *testing.T) {\n341|\tchain, created := chainFixture(t)\n342|\tstore := openTestStore(t)\n343|\tfirst, _ := mustCapture(t, store, chain, testInputs([]string{created}, testOpA))\n344|\t// A different operation over the identical closure mints no\n345|\t// second identity: the checkpoint digest is a pure function\n346|\t// of the closure.\n347|\tsecond, _ := mustCapture(t, store, chain, testInputs([]string{created}, testOpB))\n348|\tif first.CheckpointID != second.CheckpointID {\n349|\t\tt.Fatalf(\"identical closures share no identity: %q vs %q\", first.CheckpointID, second.CheckpointID)\n350|\t}\n351|\tif first.OperationID == second.OperationID {\n352|\t\tt.Fatalf(\"operations collide: %q\", first.OperationID)\n353|\t}\n354|}\n355|\n356|func TestCaptureMovedInputsChangeIdentity(t *testing.T) {\n357|\tchain, created := chainFixture(t)\n358|\tstore := openTestStore(t)\n359|\tfirst, _ := mustCapture(t, store, chain, testInputs([]string{created}, testOpA))\n360|\t// The same checkpoint with different inputs is a different\n361|\t// checkpoint: moving one manifest leg changes the digest.\n362|\tmoved := testInputs([]string{created}, testOpB)\n363|\tmoved.WorkspaceManifestID = testOtherManifest\n364|\tsecond, _ := mustCapture(t, store, chain, moved)\n365|\tif first.CheckpointID == second.CheckpointID {\n366|\t\tt.Fatalf(\"moved inputs kept identity %q\", first.CheckpointID)\n367|\t}\n368|}\n369|\n370|func TestCaptureReplayIsIdempotent(t *testing.T) {\n371|\tchain, created := chainFixture(t)\n372|\tstore := openTestStore(t)\n373|\tinputs := testInputs([]string{created}, testOpA)\n374|\tfirst, firstRaw := mustCapture(t, store, chain, inputs)\n375|\tsecond, secondRaw, err := store.Capture(chain, inputs)\n376|\tif err != nil {\n377|\t\tt.Fatalf(\"replay Capture error = %v\", err)\n378|\t}\n379|\tif first != second {\n380|\t\tt.Fatalf(\"replay ref = %+v, want %+v\", second, first)\n381|\t}\n382|\tif string(firstRaw) != string(secondRaw) {\n383|\t\tt.Fatalf(\"replay returned different bytes\")\n384|\t}\n385|\t// Exactly one blob and one receipt exist: the replay wrote\n386|\t// nothing.\n387|\tblobs, err := filepath.Glob(filepath.Join(store.root, \"*.json\"))\n388|\tif err != nil {\n389|\t\tt.Fatal(err)\n390|\t}\n391|\tif len(blobs) != 1 {\n392|\t\tt.Fatalf(\"blobs = %d, want 1\", len(blobs))\n393|\t}\n394|\treceipts, err := filepath.Glob(filepath.Join(store.root, \"operations\", \"*.json\"))\n395|\tif err != nil {\n396|\t\tt.Fatal(err)\n397|\t}\n398|\tif len(receipts) != 1 {\n399|\t\tt.Fatalf(\"receipts = %d, want 1\", len(receipts))\n400|\t}\n401|}\n402|\n403|func TestCaptureAdmitsThroughWinningLeaseConsumer(t *testing.T) {\n404|\tchain, created := chainFixture(t)\n405|\tstore := openTestStore(t)\n406|\tref, raw := mustCapture(t, store, chain, testInputs([]string{created}, testOpA))\n(more lines below)","final_result":true}}}
