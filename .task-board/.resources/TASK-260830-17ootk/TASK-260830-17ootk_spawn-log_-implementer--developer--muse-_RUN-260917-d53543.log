ex_sessions\"},\n226|\t\t},\n227|\t\tLastStatusAt: \"2026-08-19T04:12:10.000Z\",\n228|\t}\n229|}\n230|\n231|// testBoardImported returns the imported bridge transaction.\n232|func testBoardImported() TaskBoardTransaction {\n233|\treturn TaskBoardTransaction{\n234|\t\tBundleID:          testBundleID,\n235|\t\tActivationMode:    ModeOwnershipTransfer,\n236|\t\tImportOperationID: testImportOp,\n237|\t\tOpenOperationID:   testOpenOp,\n238|\t\tAdoptOperationID:  testAdoptOp,\n239|\t\tResumeOperationID: testResumeOp,\n240|\t\tState:             BoardImported,\n241|\t\tImportToken:       str(testImportToken),\n242|\t\tStagedManagerRef:  str(\"tbm:staged:0198f4c8-7a10-7b22-8b3c-2234567890ab\"),\n243|\t\tImportExpiresAt:   str(\"2026-08-19T04:22:10.000Z\"),\n244|\t\tLastBridgeState:   str(\"stopped\"),\n245|\t\tLastStatusAt:      str(\"2026-08-19T04:12:10.000Z\"),\n246|\t\tCleanupState:      \"not_started\",\n247|\t}\n248|}\n249|\n250|// testBoardOpened returns the opened bridge transaction matching the\n251|// MJ-TASK-BOARD-OPENED-POS fixture members.\n252|func testBoardOpened() TaskBoardTransaction {\n253|\treturn TaskBoardTransaction{\n254|\t\tBundleID:          testBundleID,\n255|\t\tActivationMode:    ModeOwnershipTransfer,\n256|\t\tImportOperationID: testImportOp,\n257|\t\tOpenOperationID:   testOpenOp,\n258|\t\tAdoptOperationID:  testAdoptOp,\n259|\t\tResumeOperationID: testResumeOp,\n260|\t\tState:             BoardOpened,\n261|\t\tOpenToken:         str(testOpenToken),\n262|\t\tDormantManagerRef: str(\"tbm:dormant:0198f4c8-7a10-7b22-8b3c-2234567890ab\"),\n263|\t\tOpenExpiresAt:     str(\"2026-08-19T04:22:10.000Z\"),\n264|\t\tLastBridgeState:   str(\"dormant\"),\n265|\t\tLastStatusAt:      str(\"2026-08-19T04:12:10.000Z\"),\n266|\t\tCleanupState:      \"not_started\",\n267|\t}\n268|}\n269|\n270|// testBoardAdopted returns the adopted bridge transaction.\n271|func testBoardAdopted() TaskBoardTransaction {\n272|\treturn TaskBoardTransaction{\n273|\t\tBundleID:          testBundleID,\n274|\t\tActivationMode:    ModeOwnershipTransfer,\n275|\t\tImportOperationID: testImportOp,\n276|\t\tOpenOperationID:   testOpenOp,\n277|\t\tAdoptOperationID:  testAdoptOp,\n278|\t\tResumeOperationID: testResumeOp,\n279|\t\tState:             BoardAdopted,\n280|\t\tManagerSessionRef: str(\"tbm:manager:0198f4c8-7a10-7b22-8b3c-2234567890ab\"),\n281|\t\tAxBinding:         &AxBinding{AxSessionID: testSessionID, LeaseEpoch: 4, LeaseID: testLeaseID},\n282|\t\tLastBridgeState:   str(\"stopped\"),\n283|\t\tLastStatusAt:      str(\"2026-08-19T04:12:10.000Z\"),\n284|\t\tCleanupState:      \"retained_active\",\n285|\t}\n286|}\n287|\n288|// testBoardResumed returns the resumed bridge transaction.\n289|func testBoardResumed() TaskBoardTransaction {\n290|\tboard := testBoardAdopted()\n291|\tboard.State = BoardResumed\n292|\tboard.LastBridgeState = str(\"running\")\n293|\treturn board\n294|}\n295|\n296|// mustFailure builds one Structured Error through the axerror owner.\n297|func mustFailure(t *testing.T, code axerror.Code, message string) *axerror.Error {\n298|\tt.Helper()\n299|\toperation, err := scalar.ParseUUIDv7(testPrepareOp)\n300|\tif err != nil {\n301|\t\tt.Fatal(err)\n302|\t}\n303|\tfailure, err := axerror.New(axerror.Spec{\n304|\t\tVersion:   lastErrorVersion,\n305|\t\tCode:      code,\n306|\t\tMessage:   message,\n307|\t\tRetryable: false,\n308|\t\tIDs:       axerror.NoIDs().WithOperation(operation),\n309|\t\tDetails:   axerror.Details{},\n310|\t})\n311|\tif err != nil {\n312|\t\tt.Fatalf(\"axerror.New(%s) error = %v\", code, err)\n313|\t}\n314|\treturn failure\n315|}\n316|\n317|// mustFrame marshals one Structured Error to its wire bytes.\n318|func mustFrame(t *testing.T, failure *axerror.Error) json.RawMessage {\n319|\tt.Helper()\n320|\tframed, err := failure.MarshalJSON()\n321|\tif err != nil {\n322|\t\tt.Fatal(err)\n323|\t}\n324|\treturn framed\n325|}\n326|\n327|func TestTokenFixturesAreWellFormed(t *testing.T) {\n328|\tfor name, token := range map[string]string{\n329|\t\t\"provider\": testProviderToken,\n330|\t\t\"open\":     testOpenToken,\n331|\t\t\"import\":   testImportToken,\n332|\t} {\n333|\t\traw, err := base64.RawURLEncoding.DecodeString(token)\n334|\t\tif err != nil {\n335|\t\t\tt.Fatalf(\"%s token decodes: %v\", name, err)\n336|\t\t}\n337|\t\tif len(raw) < 32 || len(raw) > 512 {\n338|\t\t\tt.Fatalf(\"%s token decodes to %d bytes\", name, len(raw))\n339|\t\t}\n340|\t\tif base64.RawURLEncoding.EncodeToString(raw) != token {\n341|\t\t\tt.Fatalf(\"%s token is not a canonical fixpoint\", name)\n342|\t\t}\n343|\t}\n344|}\n(more lines below)","final_result":true}}}
