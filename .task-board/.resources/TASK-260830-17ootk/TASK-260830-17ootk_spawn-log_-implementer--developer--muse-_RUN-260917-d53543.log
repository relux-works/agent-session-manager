Layout                             string   `json:\\\"layout\\\"`\\n179-\\tAccess                             string   `json:\\\"access\\\"`\\n180-\\tMaterializationID                  string   `json:\\\"materialization_id\\\"`\\n181-\\tProviderID                         string   `json:\\\"provider_id\\\"`\\n182-\\tTransactionID                      string   `json:\\\"transaction_id\\\"`\\n183-\\tPlanID                             string   `json:\\\"plan_id\\\"`\\n184-\\tSameFilesystemProviderAuthorityIDs []string `json:\\\"same_filesystem_provider_authority_ids\\\"`\\n185-}\\n186-\\n187-// TaskBoardTransaction is the closed Task-board Journal Transaction\\n188-// object: the exact 19-member shape of SPEC Section 10.6.\\n189:type TaskBoardTransaction struct {\\n190-\\tBundleID          string     `json:\\\"bundle_id\\\"`\\n191-\\tActivationMode    string     `json:\\\"activation_mode\\\"`\\n192-\\tImportOperationID string     `json:\\\"import_operation_id\\\"`\\n193-\\tOpenOperationID   string     `json:\\\"open_operation_id\\\"`\\n194-\\tAdoptOperationID  string     `json:\\\"adopt_operation_id\\\"`\\n195-\\tResumeOperationID string     `json:\\\"resume_operation_id\\\"`\\n196-\\tState             string     `json:\\\"state\\\"`\\n197-\\tImportToken       *string    `json:\\\"import_token\\\"`\\n198-\\tStagedManagerRef  *string    `json:\\\"staged_manager_ref\\\"`\\n199-\\tImportExpiresAt   *string    `json:\\\"import_expires_at\\\"`\\n200-\\tOpenToken         *string    `json:\\\"open_token\\\"`\\n201-\\tDormantManagerRef *string    `json:\\\"dormant_manager_ref\\\"`\\n202-\\tOpenExpiresAt     *string    `json:\\\"open_expires_at\\\"`\\n203-\\tManagerSessionRef *string    `json:\\\"manager_session_ref\\\"`\\n204-\\tAxBinding         *AxBinding `json:\\\"ax_binding\\\"`\\n205-\\tLastBridgeState   *string    `json:\\\"last_bridge_state\\\"`\\n206-\\tLastStatusAt      *string    `json:\\\"last_status_at\\\"`\\n207-\\tCleanupState      string     `json:\\\"cleanup_state\\\"`\\n208-\\tCleanupAfter      *string    `json:\\\"cleanup_after\\\"`\\n209-}\\n210-\\n211-// AxBinding is the exact closed bridge shape.\\n212-type AxBinding struct {\\n213-\\tAxSessionID string `json:\\\"ax_session_id\\\"`\\n214-\\tLeaseEpoch  uint64 `json:\\\"lease_epoch\\\"`\\n215-\\tLeaseID     string `json:\\\"lease_id\\\"`\\n216-}\\n217-\\n218-// AuthorityState is the closed Authority Journal State object.\\n219:type AuthorityState struct {\\n220-\\tRootPath            string   `json:\\\"root_path\\\"`\\n221-\\tCompletedSequences  []uint64 `json:\\\"completed_sequences\\\"`\\n222-\\tObservedPriorDigest *string  `json:\\\"observed_prior_digest\\\"`\\n223-\\tRollbackRoot        *string  `json:\\\"rollback_root\\\"`\\n224-\\tState               string   `json:\\\"state\\\"`\\n225-}\\n226-\\n227-// PlanAuthority is the routing view of one plan RootAuthority (SPEC\\n228-// Section 10.5): the kind, platform, and root path the journal\\n229-// cross-checks its authority states against. The full plan stays an\\n230-// opaque digest input owned by the shape owner; this view carries only\\n231-// the routing facts the journal rules name.\\n232:type PlanAuthority struct {\\n233-\\tID       string\\n234-\\tKind     string\\n235-\\tPlatform string\\n236-\\tRootPath string\\n237-}\\n238-\\n239-// planView is the durably installed routing view: the executing host\\n240-// platform, one entry per plan RootAuthority, and the bound bridge\\n241-// operation keys when a bridge participates.\\n242-type planView struct {\\n243-\\tHostPlatform string                   `json:\\\"host_platform\\\"`\\n244-\\tAuthorities  map[string]PlanAuthority `json:\\\"authorities\\\"`\\n245-\\tBridge       *bridgeIDs               `json:\\\"bridge_operation_ids\\\"`\\n246-}\\n247-\\n248-// CreateInputs is the typed materialize.prepare closure: caller-stable\\n249-// IDs allocated before the first request, the complete canonical\\n250-// request body, the plan/checkpoint digests, the plan authority routing\\n251-// view, and the bridge key set (allocated with the materialization ID\\n252-// when a task-board bridge participates, empty otherwise).\\n253:type CreateInputs struct {\\n254-\\tMaterializationID         string\\n255-\\tPrepareOperationID        string\\n256-\\tRequestBody               []byte\\n257-\\tTransferID                string\\n258-\\tPlanID                    string\\n259-\\tSourceCheckpointID        string\\n260-\\tManagedReplicaID          string\\n261-\\tPlan                      []PlanAuthority\\n262-\\tHostPlatform              string\\n263-\\tExpectedPriorCheckpointID string\\n264-\\tBundleID                  string\\n265-\\tActivationMode            string\\n266-\\tImportOperationID         string\\n267-\\tOpenOperationID           string\\n268-\\tAdoptOperationID          string\\n269-\\tResumeOperationID         string\\n270-\\tExtensions                map[string]string\\n271-}\\n272-\\n273-// invalid refuses a journal shape or transition with the package\\n274-// sentinel. It is a function, not a method, so every gate site reads\\n275-// identically.\\n276-func invalid(format string, arguments ...any) error {\\n\",\n  \"original_output_bytes\": 7346,\n  \"original_output_tokens\": 1837,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
