{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cabb","stream":{"kind":"session","id":"01a0ae2b-f4bb-7310-a5c5-e45123d43dca"},"sequence":952,"recorded_at":1780531400001899,"record_type":"event","durability":"durable","causation_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","run_stream":{"kind":"run","id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3"},"task_stream":{"kind":"task","id":"01a0ae30-6d23-79b0-a46f-36f08b81167a"},"task_id":"01a0ae30-6d23-79b0-a46f-36f08b81167a","event":{"kind":"output","task_id":"01a0ae30-6d23-79b0-a46f-36f08b81167a","chunk":"Read text file `internal/traceability/traceability.go`.\n(974 line(s) above)\n975|}\n976|\n977|func fail(format string, arguments ...any) error {\n978|\treturn fmt.Errorf(\"%w: %s\", ErrTraceability, fmt.Sprintf(format, arguments...))\n979|}\n980|\n981|// normativeKeywordPattern matches the RFC 2119 obligation keywords that make a\n982|// specification line a clause an implementation has to discharge. MAY and\n983|// SHOULD are deliberately absent: they create no obligation, so counting them\n984|// would inflate the denominator and make coverage look worse than it is.\n985|var normativeKeywordPattern = regexp.MustCompile(`\\b(MUST NOT|MUST|SHALL NOT|SHALL|REQUIRED)\\b`)\n986|\n987|// clauseIdentifierPattern matches the \"<section>#<index>\" form of a clause id.\n988|var clauseIdentifierPattern = regexp.MustCompile(`^(.+)#([1-9][0-9]*)$`)\n989|\n990|// minimumGapLength is the shortest gap sentence the gate accepts. A gap has to\n991|// say what is missing; \"n/a\", \"todo\" and an empty string are not disclosures.\n992|const minimumGapLength = 32\n993|\n994|// verifyGapDiscloses checks that a gap sentence is a disclosure rather than\n995|// padding. Length and a substring match alone were not enough: \"Section 9.2 is\n996|// not fully covered here yet.\" satisfied both while saying nothing. A real gap\n997|// says what the binding's own implementation does and does not reach, so it has\n998|// to name the production declaration the binding is registered to as well as\n999|// the section, and it has to name the section as a whole identifier so that a\n1000|// gap about 6.55 cannot pass for a gap about 6.5.\n1001|//\n1002|// This is a tightening, not a proof: a sentence that names both and still says\n1003|// nothing useful is admitted, and the gate cannot decide otherwise. That limit\n1004|// is stated in README.md.\n1005|func verifyGapDiscloses(gap, display, declaration string) error {\n1006|\tif len(gap) < minimumGapLength {\n1007|\t\treturn fmt.Errorf(\"gap %q is shorter than the %d characters a disclosure needs\", gap, minimumGapLength)\n1008|\t}\n1009|\tif !mentionsSection(gap, display) {\n1010|\t\treturn fmt.Errorf(\"gap does not name section %s as a whole identifier\", display)\n1011|\t}\n1012|\tif declaration != \"\" && !strings.Contains(gap, declaration) {\n1013|\t\treturn fmt.Errorf(\"gap does not name the production declaration %q the binding is registered to\", declaration)\n1014|\t}\n1015|\treturn nil\n1016|}\n1017|\n1018|// mentionsSection reports whether text names the section display identifier as\n1019|// a whole identifier. A bare substring match accepts \"6.55\" as a mention of\n1020|// \"6.5\" and \"13.15\" as a mention of \"13.1\", which would let a gap about one\n1021|// section stand in for another.\n1022|func mentionsSection(text, display string) bool {\n1023|\tpattern, err := regexp.Compile(`(?:^|[^0-9.])` + regexp.QuoteMeta(display) + `(?:[^0-9]|$)`)\n1024|\tif err != nil {\n1025|\t\treturn false\n1026|\t}\n1027|\treturn pattern.MatchString(text)\n1028|}\n1029|\n1030|// sectionDocumentIdentifier maps an ownership key to the heading identifier the\n1031|// pinned document uses. \"section:10.3\" is heading 10.3; \"section:appendix-d\" is\n1032|// heading D.\n1033|func sectionDocumentIdentifier(key string) (string, error) {\n1034|\tidentifier := strings.TrimPrefix(key, \"section:\")\n1035|\tif identifier == key || identifier == \"\" {\n1036|\t\treturn \"\", fmt.Errorf(\"ownership key %q is not a section binding key\", key)\n1037|\t}\n1038|\tif rest, ok := strings.CutPrefix(identifier, \"appendix-\"); ok {\n1039|\t\tif len(rest) != 1 {\n1040|\t\t\treturn \"\", fmt.Errorf(\"ownership key %q is not a real appendix key\", key)\n1041|\t\t}\n1042|\t\treturn strings.ToUpper(rest), nil\n1043|\t}\n1044|\treturn identifier, nil\n1045|}\n1046|\n1047|// sectionDisplayName is how a gap sentence has to name the section it is about.\n1048|func sectionDisplayName(key string) (string, error) {\n1049|\tidentifier := strings.TrimPrefix(key, \"section:\")\n1050|\tif rest, ok := strings.CutPrefix(identifier, \"appendix-\"); ok {\n1051|\t\tif len(rest) != 1 {\n1052|\t\t\treturn \"\", fmt.Errorf(\"ownership key %q is not a real appendix key\", key)\n1053|\t\t}\n1054|\t\treturn \"Appendix \" + strings.ToUpper(rest), nil\n1055|\t}\n1056|\tif identifier == \"\" || identifier == key {\n1057|\t\treturn \"\", fmt.Errorf(\"ownership key %q is not a section binding key\", key)\n1058|\t}\n1059|\treturn identifier, nil\n1060|}\n1061|\n1062|// sectionClauseInventory measures every normative clause the pinned document\n1063|// carries under a heading, including its subheadings. A parent heading owns its\n1064|// children's obligations, so Appendix D is measured over D.1..D.n rather than\n1065|// over the two lines between its title and its first subheading.\n1066|func sectionClauseInventory(document *specdoc.Document, key string) ([]normativeClause, error) {\n1067|\tidentifier, err := sectionDocumentIdentifier(key)\n1068|\tif err != nil {\n1069|\t\treturn nil, err\n1070|\t}\n1071|\tprefix := identifier + \".\"\n1072|\tvar result []normativeClause\n1073|\tfor line := 1; line <= document.LineCount(); line++ {\n1074|\t\towner, ok := document.SectionID(line)\n1075|\t\tif !ok || (owner != identifier && !strings.HasPrefix(owner, prefix)) {\n1076|\t\t\tcontinue\n1077|\t\t}\n1078|\t\ttext, ok := document.Line(line)\n1079|\t\tif !ok {\n1080|\t\t\treturn nil, fmt.Errorf(\"pinned document line %d is unreadable\", line)\n1081|\t\t}\n1082|\t\tif !normativeKeywordPattern.MatchString(text) {\n1083|\t\t\tcontinue\n1084|\t\t}\n1085|\t\tresult = append(result, normativeClause{\n1086|\t\t\tID:   fmt.Sprintf(\"%s#%d\", identifier, len(result)+1),\n1087|\t\t\tLine: line,\n1088|\t\t\tText: strings.TrimSpace(text),\n1089|\t\t})\n1090|\t}\n1091|\treturn result, nil\n1092|}\n1093|\n1094|// coverageBucket is the measured coverage level. It is computed from the two\n1095|// counts and never read from the registry.\n1096|func coverageBucket(discharged, total int) coverageLevel {\n1097|\tswitch {\n1098|\tcase total == 0:\n1099|\t\treturn coverageUnmeasured\n1100|\tcase discharged == 0:\n1101|\t\treturn coverageUnevidenced\n1102|\tcase discharged >= total:\n1103|\t\treturn coverageFull\n1104|\tcase discharged*2 >= total:\n1105|\t\treturn coveragePartial\n1106|\tdefault:\n1107|\t\treturn coverageSliver\n1108|\t}\n1109|}\n1110|\n1111|// sectionCoverage is the measured result for one section binding.\n1112|type sectionCoverage struct {\n1113|\tKey        string\n1114|\tLevel      coverageLevel\n1115|\tDischarged int\n1116|\tTotal      int\n1117|\tGap        string\n1118|}\n1119|\n1120|// Ratio renders the measured coverage as the ratio it was computed from, so a\n1121|// report never has to describe coverage in prose.\n1122|func (coverage sectionCoverage) Ratio() string {\n1123|\treturn fmt.Sprintf(\"%d/%d\", coverage.Discharged, coverage.Total)\n1124|}\n1125|\n1126|// verifySectionBindingCoverage measures one section binding against the pinned\n1127|// document and refuses a declared level that differs from the measured one.\n1128|//\n1129|// This is the check that stops a binding from claiming a whole section while\n1130|// implementing a corner of it. It verifies what it can decide: that every\n1131|// enumerated clause is a real obligation of the claimed section, quoted\n1132|// verbatim at the line it occupies, and named by an acceptance case the binding\n1133|// itself registers; and that the declared level equals the measured ratio. It\n1134|// cannot decide that the named acceptance case exercises the clause's meaning —\n1135|// that residual is stated in README.md and in the coverage artifact.\n1136|func verifySectionBindingCoverage(\n1137|\tdocument *specdoc.Document,\n1138|\tgroup ownershipGroup,\n1139|\tacceptanceIDs map[string]struct{},\n1140|) (sectionCoverage, error) {\n1141|\tkey := group.Keys[0]\n1142|\tinventory, err := sectionClauseInventory(document, key)\n1143|\tif err != nil {\n1144|\t\treturn sectionCoverage{}, fail(\"section binding %q clause inventory: %v\", key, err)\n1145|\t}\n1146|\tbyIdentifier := make(map[string]normativeClause, len(inventory))\n1147|\tfor _, clause := range inventory {\n1148|\t\tbyIdentifier[clause.ID] = clause\n1149|\t}\n1150|\tgroupCases := make(map[string]struct{}, len(group.AcceptanceCases))\n1151|\tfor _, acceptanceID := range group.AcceptanceCases {\n1152|\t\tgroupCases[acceptanceID] = struct{}{}\n1153|\t}\n1154|\n1155|\tseen := make(map[string]struct{}, len(group.Clauses))\n1156|\tfor _, declared := range group.Clauses {\n1157|\t\tclause, known := byIdentifier[declared.ID]\n1158|\t\tif !known {\n1159|\t\t\treturn sectionCoverage{}, fail(\n1160|\t\t\t\t\"section binding %q discharges clause %q, which is not one of the %d normative clauses of the pinned section\",\n1161|\t\t\t\tkey, declared.ID, len(inventory))\n1162|\t\t}\n1163|\t\tif _, duplicate := seen[declared.ID]; duplicate {\n1164|\t\t\treturn sectionCoverage{}, fail(\"section binding %q repeats discharged clause %q\", key, declared.ID)\n1165|\t\t}\n1166|\t\tseen[declared.ID] = struct{}{}\n1167|\t\tif declared.Line != clause.Line {\n1168|\t\t\treturn sectionCoverage{}, fail(\n1169|\t\t\t\t\"section binding %q clause %q declares line %d, but the pinned clause is at line %d\",\n1170|\t\t\t\tkey, declared.ID, declared.Line, clause.Line)\n1171|\t\t}\n1172|\t\texcerpt := specdoc.Normalize(declared.Excerpt)\n1173|\t\tif excerpt == \"\" {\n1174|\t\t\treturn sectionCoverage{}, fail(\"section binding %q clause %q quotes an empty excerpt\", key, declared.ID)\n1175|\t\t}\n1176|\t\tif !normativeKeywordPattern.MatchString(excerpt) {\n1177|\t\t\treturn sectionCoverage{}, fail(\n1178|\t\t\t\t\"section binding %q clause %q quotes text that carries no RFC 2119 obligation\", key, declared.ID)\n1179|\t\t}\n1180|\t\tif !quoteBeginsAtLine(document, declared.Excerpt, clause.Line) {\n1181|\t\t\treturn sectionCoverage{}, fail(\n1182|\t\t\t\t\"section binding %q clause %q does not quote the pinned document verbatim at line %d\",\n1183|\t\t\t\tkey, declared.ID, clause.Line)\n1184|\t\t}\n1185|\t\tif len(declared.AcceptanceCases) == 0 {\n1186|\t\t\treturn sectionCoverage{}, fail(\n1187|\t\t\t\t\"section binding %q clause %q names no acceptance case that discharges it\", key, declared.ID)\n1188|\t\t}\n1189|\t\tcaseSeen := make(map[string]struct{}, len(declared.AcceptanceCases))\n1190|\t\tfor _, acceptanceID := range declared.AcceptanceCases {\n1191|\t\t\tif _, duplicate := caseSeen[acceptanceID]; duplicate {\n1192|\t\t\t\treturn sectionCoverage{}, fail(\n1193|\t\t\t\t\t\"section binding %q clause %q repeats acceptance case %q\", key, declared.ID, acceptanceID)\n1194|\t\t\t}\n1195|\t\t\tcaseSeen[acceptanceID] = struct{}{}\n1196|\t\t\tif _, registered := acceptanceIDs[acceptanceID]; !registered {\n1197|\t\t\t\treturn sectionCoverage{}, fail(\n1198|\t\t\t\t\t\"section binding %q clause %q references unregistered acceptance case %q\", key, declared.ID, acceptanceID)\n1199|\t\t\t}\n1200|\t\t\tif _, owned := groupCases[acceptanceID]; !owned {\n1201|\t\t\t\treturn sectionCoverage{}, fail(\n1202|\t\t\t\t\t\"section binding %q clause %q discharges through acceptance case %q, which the binding does not own\",\n1203|\t\t\t\t\tkey, declared.ID, acceptanceID)\n1204|\t\t\t}\n1205|\t\t}\n1206|\t}\n1207|\n1208|\tmeasured := coverageBucket(len(group.Clauses), len(inventory))\n1209|\tif group.Coverage == \"\" {\n1210|\t\treturn sectionCoverage{}, fail(\n1211|\t\t\t\"section binding %q declares no coverage level; the pinned section carries %d normative clauses and the binding enumerates %d\",\n1212|\t\t\tkey, len(inventory), len(group.Clauses))\n1213|\t}\n1214|\tif group.Coverage != measured {\n(more lines below)","final_result":true}}}
