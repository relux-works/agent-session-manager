{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cbf3","stream":{"kind":"session","id":"01a0ae2b-f4bb-7310-a5c5-e45123d43dca"},"sequence":1108,"recorded_at":1780531400002211,"record_type":"event","durability":"durable","causation_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","run_stream":{"kind":"run","id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3"},"task_stream":{"kind":"task","id":"01a0ae32-6f10-7062-8a91-fa96c571b954"},"task_id":"01a0ae32-6f10-7062-8a91-fa96c571b954","event":{"kind":"output","task_id":"01a0ae32-6f10-7062-8a91-fa96c571b954","chunk":"Read text file `internal/matjournal/recover_test.go`.\n1|package matjournal\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|)\n11|\n12|// testLease returns the winning-lease observation.\n13|func testLease() LeaseIdentity {\n14|\treturn LeaseIdentity{Epoch: 4, ID: testLeaseID}\n15|}\n16|\n17|// baseRecoveryInput returns the consistent probe closure: prepared\n18|// provider status with agreement, no bridge effect, no marker, a\n19|// healthy host, and the unchanged winning lease.\n20|func baseRecoveryInput() RecoveryInput {\n21|\treturn RecoveryInput{\n22|\t\tBoundary:    BoundaryAfterPrepare,\n23|\t\tPath:        PathOwnerResume,\n24|\t\tProvider:    ProviderProbe{State: ProviderPrepared, IDsMatch: true, PlanMatches: true, TokenMatches: true},\n25|\t\tBridge:      BridgeProbe{State: BoardNotStarted},\n26|\t\tMarker:      MarkerAbsent,\n27|\t\tHost:        HostOK,\n28|\t\tLeaseKnown:  true,\n29|\t\tLeaseBefore: testLease(),\n30|\t\tLeaseAfter:  testLease(),\n31|\t}\n32|}\n33|\n34|// mustOutcome asserts the exact outcome and the never-fourth-outcome\n35|// rule.\n36|func mustOutcome(t *testing.T, got, want Outcome, what string) {\n37|\tt.Helper()\n38|\tswitch got {\n39|\tcase OutcomeSafeRetry, OutcomeExplicitRollback, OutcomeRecoverableParked:\n40|\tdefault:\n41|\t\tt.Fatalf(\"%s outcome = %q, want one of the three Section 13.13 outcomes\", what, got)\n42|\t}\n43|\tif got != want {\n44|\t\tt.Fatalf(\"%s outcome = %q, want %q\", what, got, want)\n45|\t}\n46|}\n47|\n48|// mustEvidenceComplete asserts the Section 13.13 evidence record names\n49|// every required fact.\n50|func mustEvidenceComplete(t *testing.T, evidence Evidence, what string) {\n51|\tt.Helper()\n52|\tif evidence.Boundary == \"\" || evidence.Path == \"\" || len(evidence.OperationIDs) == 0 {\n53|\t\tt.Fatalf(\"%s evidence lacks boundary, path, or operation IDs: %+v\", what, evidence)\n54|\t}\n55|\tif evidence.PhaseBefore == \"\" || evidence.PhaseAfter == \"\" {\n56|\t\tt.Fatalf(\"%s evidence lacks pre/post durable facts: %+v\", what, evidence)\n57|\t}\n58|\tif evidence.Reason == \"\" || evidence.Remediation == \"\" || evidence.DecidedAt == \"\" {\n59|\t\tt.Fatalf(\"%s evidence lacks reason, remediation, or decided_at: %+v\", what, evidence)\n60|\t}\n61|\tif evidence.LeaseBefore.Epoch == 0 || evidence.LeaseAfter.Epoch == 0 {\n62|\t\tt.Fatalf(\"%s evidence lacks the winning lease before/after: %+v\", what, evidence)\n63|\t}\n64|}\n65|\n66|func TestRecoverBeforeCreate(t *testing.T) {\n67|\tstore := openTestStore(t)\n68|\tinput := baseRecoveryInput()\n69|\tinput.Boundary = BoundaryBeforeCreate\n70|\tinput.Provider.State = ProviderUnknown\n71|\toutcome, evidence, err := store.Recover(testMatID, input)\n72|\tif err != nil {\n73|\t\tt.Fatalf(\"Recover error = %v\", err)\n74|\t}\n75|\tmustOutcome(t, outcome, OutcomeSafeRetry, \"Recover(CR-MAT-01)\")\n76|\tif evidence.PhaseBefore != \"\" || evidence.ReceiptPresent {\n77|\t\tt.Fatalf(\"evidence = %+v, want no durable facts\", evidence)\n78|\t}\n79|\t// Any other boundary with no journal is absence, not a\n80|\t// classification.\n81|\tinput.Boundary = BoundaryAfterPrepare\n82|\t_, _, err = store.Recover(testMatID, input)\n83|\tif !errors.Is(err, ErrUnknownJournal) {\n84|\t\tt.Fatalf(\"Recover(absent) = %v, want ErrUnknownJournal\", err)\n85|\t}\n86|}\n87|\n88|func TestRecoverRefusesBadBoundary(t *testing.T) {\n89|\tstore := openTestStore(t)\n90|\tmustCreate(t, store, testInputs())\n91|\tcases := []struct {\n92|\t\tname   string\n93|\t\tmutate func(*RecoveryInput)\n94|\t}{\n95|\t\t{\"bad_boundary\", func(i *RecoveryInput) { i.Boundary = \"CR-MAT-09\" }},\n96|\t\t{\"bad_path\", func(i *RecoveryInput) { i.Path = \"migration\" }},\n97|\t\t{\"bad_provider\", func(i *RecoveryInput) { i.Provider.State = \"preparing\" }},\n98|\t\t{\"bad_bridge\", func(i *RecoveryInput) { i.Bridge.State = \"launched\" }},\n99|\t\t{\"bad_marker\", func(i *RecoveryInput) { i.Marker = \"present\" }},\n100|\t\t{\"bad_host\", func(i *RecoveryInput) { i.Host = \"on_fire\" }},\n101|\t\t{\"bad_lease_epoch\", func(i *RecoveryInput) { i.LeaseAfter.Epoch = 0 }},\n102|\t\t{\"bad_lease_id\", func(i *RecoveryInput) { i.LeaseAfter.ID = \"nope\" }},\n103|\t\t{\"bad_materialization\", func(i *RecoveryInput) {}},\n104|\t}\n105|\tfor _, tc := range cases {\n106|\t\tt.Run(tc.name, func(t *testing.T) {\n107|\t\t\tinput := baseRecoveryInput()\n108|\t\t\ttc.mutate(&input)\n109|\t\t\tid := testMatID\n110|\t\t\tif tc.name == \"bad_materialization\" {\n111|\t\t\t\tid = \"not-a-uuid\"\n112|\t\t\t}\n113|\t\t\t_, _, err := store.Recover(id, input)\n114|\t\t\tmustInvalid(t, err, \"Recover(boundary)\")\n115|\t\t})\n116|\t}\n117|}\n118|\n119|func TestRecoverTornJournalParks(t *testing.T) {\n120|\tstore := openTestStore(t)\n(more lines below)","final_result":true}}}
