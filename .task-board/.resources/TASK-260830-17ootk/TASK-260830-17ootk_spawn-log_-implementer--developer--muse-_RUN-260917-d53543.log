{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cd6d","stream":{"kind":"session","id":"01a0ae2b-f4bb-7310-a5c5-e45123d43dca"},"sequence":1297,"recorded_at":1780531400002589,"record_type":"event","durability":"durable","causation_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","run_stream":{"kind":"run","id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3"},"task_stream":{"kind":"task","id":"01a0ae35-5e44-7bc3-9d69-6aa1a917bfcd"},"task_id":"01a0ae35-5e44-7bc3-9d69-6aa1a917bfcd","event":{"kind":"output","task_id":"01a0ae35-5e44-7bc3-9d69-6aa1a917bfcd","chunk":"{\n  \"chunk_id\": \"exec-30-1\",\n  \"command\": \"sed -n '275,352p' internal/matjournal/store.go\\necho ===ROLLBACK-REQUIRED===\\ngrep -n \\\"func (assessment \\\\*recoveryAssessment) rollbackRequired\\\" -A 60 internal/matjournal/recover.go | head -n 80\",\n  \"description\": \"Check transition hooks and rollback triggers\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"func (store *Store) update(materializationID string, apply func(*Journal, planView) error) (Journal, error) {\\n\\tid, err := scalar.ParseUUIDv7(materializationID)\\n\\tif err != nil {\\n\\t\\treturn Journal{}, invalid(\\\"materialization id %q: %v\\\", materializationID, err)\\n\\t}\\n\\tstore.mutex.Lock()\\n\\tdefer store.mutex.Unlock()\\n\\treturn store.updateLocked(id.String(), apply)\\n}\\n\\n// updateLocked is the mutex-held core of update. Callers hold the\\n// store mutex (public entries and Recover).\\nfunc (store *Store) updateLocked(materializationID string, apply func(*Journal, planView) error) (Journal, error) {\\n\\tmatDir := filepath.Join(store.root, materializationID)\\n\\traw, err := readJournalFile(filepath.Join(matDir, \\\"journal.json\\\"))\\n\\tif err != nil {\\n\\t\\tif os.IsNotExist(err) {\\n\\t\\t\\treturn Journal{}, fmt.Errorf(\\\"%w: %s\\\", ErrUnknownJournal, materializationID)\\n\\t\\t}\\n\\t\\treturn Journal{}, err\\n\\t}\\n\\tview, err := store.readPlanViewLocked(matDir)\\n\\tif err != nil {\\n\\t\\treturn Journal{}, err\\n\\t}\\n\\tjournal, err := decodeJournal(raw, view)\\n\\tif err != nil {\\n\\t\\treturn Journal{}, err\\n\\t}\\n\\tif terminalPhase(journal.Phase) {\\n\\t\\treturn Journal{}, invalid(\\\"journal is terminal in %s\\\", journal.Phase)\\n\\t}\\n\\tif store.BeforeWrite != nil {\\n\\t\\tif err := store.BeforeWrite(); err != nil {\\n\\t\\t\\treturn Journal{}, err\\n\\t\\t}\\n\\t}\\n\\tif err := apply(&journal, view); err != nil {\\n\\t\\treturn Journal{}, err\\n\\t}\\n\\tupdated, err := checkTimestamp(store.now(), \\\"updated_at\\\")\\n\\tif err != nil {\\n\\t\\treturn Journal{}, err\\n\\t}\\n\\tjournal.UpdatedAt = updated\\n\\tif err := checkJournalGrammar(&journal); err != nil {\\n\\t\\treturn Journal{}, err\\n\\t}\\n\\tif err := checkJournalCrossReferences(&journal, view); err != nil {\\n\\t\\treturn Journal{}, err\\n\\t}\\n\\tnext, err := encodeJournal(&journal)\\n\\tif err != nil {\\n\\t\\treturn Journal{}, err\\n\\t}\\n\\tif err := replaceAtomic(filepath.Join(matDir, \\\"journal.json\\\"), next); err != nil {\\n\\t\\treturn Journal{}, err\\n\\t}\\n\\tif err := syncDirectory(matDir); err != nil {\\n\\t\\treturn Journal{}, err\\n\\t}\\n\\tif store.AfterJournal != nil {\\n\\t\\tif err := store.AfterJournal(); err != nil {\\n\\t\\t\\treturn Journal{}, err\\n\\t\\t}\\n\\t}\\n\\tif store.AfterCommit != nil {\\n\\t\\tif err := store.AfterCommit(); err != nil {\\n\\t\\t\\treturn Journal{}, err\\n\\t\\t}\\n\\t}\\n\\treturn journal, nil\\n}\\n\\n// Transition moves one journal along the phase table, enforcing the\\n// phase-entry guards. A workspace commit carries its destination\\n// marker evidence; a failure carries its explaining Structured Error.\\nfunc (store *Store) Transition(materializationID, to string, opts TransitionOpts) (Journal, error) {\\n===ROLLBACK-REQUIRED===\\n620:func (assessment *recoveryAssessment) rollbackRequired() (bool, axerror.Code, string, string) {\\n621-\\tjournal := assessment.journal\\n622-\\tinput := assessment.input\\n623-\\tpreActivation := true\\n624-\\tif journal.TaskBoard != nil && (journal.TaskBoard.State == BoardAdopted || journal.TaskBoard.State == BoardResumed) {\\n625-\\t\\tpreActivation = false\\n626-\\t}\\n627-\\tif journal.Provider != nil && journal.Provider.State == ProviderCommitted {\\n628-\\t\\tpreActivation = false\\n629-\\t}\\n630-\\tif journal.TaskBoard != nil && preActivation && !input.Bridge.LeaseActive &&\\n631-\\t\\t(input.Bridge.Failed || input.Bridge.TokenExpired) {\\n632-\\t\\tif input.Bridge.TokenExpired {\\n633-\\t\\t\\treturn true, \\\"staging_incomplete\\\", \\\"bridge token expired before lease activation: rolling back the dormant import\\\",\\n634-\\t\\t\\t\\t\\\"re-run prepare from the same checkpoint with fresh operation IDs after the rollback\\\"\\n635-\\t\\t}\\n636-\\t\\treturn true, \\\"task_board_bridge_unavailable\\\", \\\"bridge import, open, or adopt failed before the new lease: rolling back the dormant import\\\",\\n637-\\t\\t\\t\\\"retry the same operation after the rollback, or inspect the bridge failure\\\"\\n638-\\t}\\n639-\\tif journal.Provider != nil && journal.Phase == PhasePrepared &&\\n640-\\t\\tinput.Provider.State == ProviderRolledBack && preActivation {\\n641-\\t\\treturn true, \\\"rollback_failed\\\", \\\"provider rolled back underneath a prepared journal: converging the journal\\\",\\n642-\\t\\t\\t\\\"inspect the provider rollback, then retry the same operation from the recorded checkpoint\\\"\\n643-\\t}\\n644-\\tif journal.Phase == PhaseRollingBack && input.Provider.State == ProviderPrepared && journal.Provider != nil {\\n645-\\t\\treturn true, \\\"operation_uncertain\\\", \\\"journal is rolling_back with the provider still prepared: retrying the rollback\\\",\\n646-\\t\\t\\t\\\"no operator action: the rollback retries under the same IDs\\\"\\n647-\\t}\\n648-\\treturn false, \\\"\\\", \\\"\\\", \\\"\\\"\\n649-}\\n650-\\n651-// tryComplete applies provable terminal completions: a committing\\n652-// journal with committed provider status plus the exact destination\\n653-// marker commits; a dormant finalize closes; a rolling_back journal\\n654-// with rolled_back status plus restored predecessors closes. It\\n655-// reports done=false when nothing completes.\\n656-func (assessment *recoveryAssessment) tryComplete() (bool, Outcome, Evidence, error) {\\n657-\\tjournal := assessment.journal\\n658-\\tinput := assessment.input\\n659-\\tif journal.Phase == PhaseCommitting {\\n660-\\t\\tprovable, contradictory := assessment.commitProvable()\\n661-\\t\\tif contradictory {\\n662-\\t\\t\\toutcome, evidence, err := assessment.park(\\\"integrity_failure\\\", \\\"destination marker evidence contradicts the valid-match probe\\\",\\n663-\\t\\t\\t\\t\\\"reconcile the marker bytes against the journal and plan, then re-run recovery\\\")\\n664-\\t\\t\\treturn true, outcome, evidence, err\\n665-\\t\\t}\\n666-\\t\\tif provable {\\n667-\\t\\t\\tif journal.TaskBoard != nil && journal.TaskBoard.State == BoardOpened &&\\n668-\\t\\t\\t\\tjournal.TaskBoard.ActivationMode == ModeDormantReplica && assessment.dormantProvable() {\\n669-\\t\\t\\t\\tif err := assessment.applyDormantFinalize(); err != nil {\\n670-\\t\\t\\t\\t\\treturn true, \\\"\\\", Evidence{}, err\\n671-\\t\\t\\t\\t}\\n672-\\t\\t\\t}\\n673-\\t\\t\\tif err := assessment.applyCommit(); err != nil {\\n674-\\t\\t\\t\\treturn true, \\\"\\\", Evidence{}, err\\n675-\\t\\t\\t}\\n676-\\t\\t\\toutcome, evidence, err := assessment.completeSafeRetry(\\\"committing journal completed to committed on exact status plus destination evidence\\\")\\n677-\\t\\t\\treturn true, outcome, evidence, err\\n678-\\t\\t}\\n679-\\t\\tif assessment.commitConverged() && journal.ManagedReplicaID != nil {\\n680-\\t\\t\\toutcome, evidence, err := assessment.park(\\\"operation_uncertain\\\", \\\"committing journal converged but the exact destination marker is unproven\\\",\\n\",\n  \"original_output_bytes\": 6061,\n  \"original_output_tokens\": 1516,\n  \"truncated\": false\n}","final_result":true}}}
