{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5ad","stream":{"kind":"session","id":"01a0ae2b-f4bb-7310-a5c5-e45123d43dca"},"sequence":305,"recorded_at":1780531400000605,"record_type":"event","durability":"durable","causation_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","run_stream":{"kind":"run","id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3"},"task_stream":{"kind":"task","id":"01a0ae2c-e8fd-7bf1-8b61-7759dc8698a4"},"task_id":"01a0ae2c-e8fd-7bf1-8b61-7759dc8698a4","event":{"kind":"output","task_id":"01a0ae2c-e8fd-7bf1-8b61-7759dc8698a4","chunk":"Read text file `internal/matjournal/crash_test.go`.\n1|package matjournal\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/secconftest\"\n10|)\n11|\n12|// reopen loads a fresh store over the same data root: the simulated\n13|// clean restart after a crash. Hooks never survive the restart.\n14|func reopen(t *testing.T, store *Store) *Store {\n15|\tt.Helper()\n16|\troot := store.root\n17|\tdataRoot := filepath.Dir(root)\n18|\tfresh, err := Open(dataRoot)\n19|\tif err != nil {\n20|\t\tt.Fatal(err)\n21|\t}\n22|\tfresh.Now = fixedClock\n23|\treturn fresh\n24|}\n25|\n26|// mustCrashFault fails unless err is the injected fault for the armed\n27|// point carrying the expected outcome.\n28|func mustCrashFault(t *testing.T, err error, point string, outcome secconftest.Outcome, what string) {\n29|\tt.Helper()\n30|\tif err == nil {\n31|\t\tt.Fatalf(\"%s error = nil, want injected fault at %s\", what, point)\n32|\t}\n33|\tvar fault *secconftest.Fault\n34|\tif !errors.As(err, &fault) {\n35|\t\tt.Fatalf(\"%s error = %v, want *secconftest.Fault\", what, err)\n36|\t}\n37|\tif fault.Point() != point {\n38|\t\tt.Fatalf(\"%s point = %q, want %q\", what, fault.Point(), point)\n39|\t}\n40|\tif fault.Outcome() != outcome {\n41|\t\tt.Fatalf(\"%s outcome = %q, want %q\", what, fault.Outcome(), outcome)\n42|\t}\n43|}\n44|\n45|// journalFilesExist reports whether the journal and receipt exist.\n46|func journalFilesExist(t *testing.T, store *Store) (journal, receipt bool) {\n47|\tt.Helper()\n48|\tmatDir := filepath.Join(store.root, testMatID)\n49|\tif _, err := os.Stat(filepath.Join(matDir, \"journal.json\")); err == nil {\n50|\t\tjournal = true\n51|\t}\n52|\tentries, err := os.ReadDir(filepath.Join(matDir, \"operations\"))\n53|\tif err == nil && len(entries) > 0 {\n54|\t\treceipt = true\n55|\t}\n56|\treturn journal, receipt\n57|}\n58|\n59|func TestCrashBeforeCreateIsSafeRetry(t *testing.T) {\n60|\tstore := openTestStore(t)\n61|\tinjector := &secconftest.Injector{}\n62|\tstore.BeforeWrite = func() error { return injector.MaybeFail(secconftest.PointPrepareEnter) }\n63|\tinjector.Arm(secconftest.PointPrepareEnter)\n64|\t// CR-MAT-01: the crash lands before journal creation.\n65|\t_, _, err := store.Create(testInputsComposite())\n66|\tmustCrashFault(t, err, secconftest.PointPrepareEnter, secconftest.OutcomeSafeRetry, \"Create(prepare fault)\")\n67|\tif journal, receipt := journalFilesExist(t, store); journal || receipt {\n68|\t\tt.Fatalf(\"after prepare fault: journal = %v, receipt = %v, want no durable state\", journal, receipt)\n69|\t}\n70|\tif remaining := injector.RemainingArmed(); len(remaining) != 0 {\n71|\t\tt.Fatalf(\"armed points remain: %q\", remaining)\n72|\t}\n73|\t// After the clean restart, recovery classifies safe_retry and the\n74|\t// identical retry creates exactly one journal.\n75|\trestarted := reopen(t, store)\n76|\tinput := baseRecoveryInput()\n77|\tinput.Boundary = BoundaryBeforeCreate\n78|\tinput.Provider.State = ProviderUnknown\n79|\toutcome, _, err := restarted.Recover(testMatID, input)\n80|\tif err != nil {\n81|\t\tt.Fatalf(\"Recover error = %v\", err)\n82|\t}\n83|\tmustOutcome(t, outcome, OutcomeSafeRetry, \"Recover(CR-MAT-01)\")\n84|\tref, _ := mustCreate(t, restarted, testInputsComposite())\n85|\tif ref.Phase != PhaseStaging {\n86|\t\tt.Fatalf(\"retry phase = %q\", ref.Phase)\n87|\t}\n88|\tif journal, receipt := journalFilesExist(t, restarted); !journal || !receipt {\n89|\t\tt.Fatalf(\"after retry: journal = %v, receipt = %v, want both durable\", journal, receipt)\n90|\t}\n91|}\n92|\n93|func TestCrashBetweenJournalAndReceiptReplays(t *testing.T) {\n94|\tstore := openTestStore(t)\n95|\tinterrupted := errors.New(\"crash after journal before receipt\")\n96|\tstore.AfterJournal = func() error { return interrupted }\n97|\t// CR-MAT-02: the journal is durable but the prepare receipt never\n98|\t// installed.\n99|\t_, _, err := store.Create(testInputsComposite())\n100|\tif !errors.Is(err, interrupted) {\n101|\t\tt.Fatalf(\"Create(journal fault) = %v, want the interior fault\", err)\n102|\t}\n103|\tif journal, receipt := journalFilesExist(t, store); !journal || receipt {\n104|\t\tt.Fatalf(\"after journal fault: journal = %v, receipt = %v, want journal only\", journal, receipt)\n105|\t}\n106|\t// MJ-RPC-PREPARE-LOST: the retry carries the caller-retained IDs\n107|\t// and the identical body, completes the receipt, and creates no\n108|\t// second journal.\n109|\trestarted := reopen(t, store)\n110|\tref, journal := mustCreate(t, restarted, testInputsComposite())\n111|\tif ref.Phase != PhaseStaging || journal.PrepareOperationID != testPrepareOp {\n112|\t\tt.Fatalf(\"replay = %+v\", ref)\n113|\t}\n114|\tinput := baseRecoveryInput()\n115|\tinput.Boundary = BoundaryAfterPrepare\n116|\toutcome, evidence, err := restarted.Recover(testMatID, input)\n117|\tif err != nil {\n118|\t\tt.Fatalf(\"Recover error = %v\", err)\n119|\t}\n120|\tmustOutcome(t, outcome, OutcomeSafeRetry, \"Recover(CR-MAT-02)\")\n(more lines below)","final_result":true}}}
