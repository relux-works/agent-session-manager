{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c95b","stream":{"kind":"session","id":"01a0ae2b-f4bb-7310-a5c5-e45123d43dca"},"sequence":776,"recorded_at":1780531400001547,"record_type":"event","durability":"durable","causation_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","run_stream":{"kind":"run","id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3"},"call_id":"call_01a0ae2fbe367477b97a8006c848103d","text":"Read text file `internal/matjournal/recover.go`.\n(339 line(s) above)\n340|func (store *Store) recoverBeforeCreateLocked(id string, input RecoveryInput) (Outcome, Evidence, error) {\n341|\tdecided, err := checkTimestamp(store.now(), \"decided_at\")\n342|\tif err != nil {\n343|\t\treturn \"\", Evidence{}, err\n344|\t}\n345|\tevidence := Evidence{\n346|\t\tMaterializationID: id,\n347|\t\tBoundary:          input.Boundary,\n348|\t\tPath:              input.Path,\n349|\t\tOperationIDs:      map[string]string{},\n350|\t\tPhaseBefore:       \"\",\n351|\t\tPhaseAfter:        \"\",\n352|\t\tReceiptPresent:    false,\n353|\t\tProviderState:     \"\",\n354|\t\tBridgeState:       \"\",\n355|\t\tExternalEffect:    input.ExternalEffect,\n356|\t\tStatusProbe:       statusSummary(input),\n357|\t\tLeaseBefore:       input.LeaseBefore,\n358|\t\tLeaseAfter:        input.LeaseAfter,\n359|\t\tNativeBefore:      input.NativeBefore,\n360|\t\tNativeAfter:       input.NativeAfter,\n361|\t\tSelected:          OutcomeSafeRetry,\n362|\t\tReason:            \"no journal exists: nothing durable mutated, the same prepare IDs retry fresh\",\n363|\t\tRemediation:       \"retry materialize.prepare with the caller-retained operation and materialization IDs and the identical body\",\n364|\t\tDecidedAt:         decided,\n365|\t}\n366|\treturn OutcomeSafeRetry, evidence, nil\n367|}\n368|\n369|// parkTornLocked parks a torn journal: the bytes fail validation, so\n370|// recovery quarantines with integrity_failure and persists the\n371|// evidence. The torn bytes are never repaired or trusted.\n372|func (store *Store) parkTornLocked(id, matDir string, input RecoveryInput, cause error) (Outcome, Evidence, error) {\n373|\tdecided, err := checkTimestamp(store.now(), \"decided_at\")\n374|\tif err != nil {\n375|\t\treturn \"\", Evidence{}, err\n376|\t}\n377|\tevidence := Evidence{\n378|\t\tMaterializationID: id,\n379|\t\tBoundary:          input.Boundary,\n380|\t\tPath:              input.Path,\n381|\t\tOperationIDs:      map[string]string{},\n382|\t\tPhaseBefore:       \"unknown\",\n383|\t\tPhaseAfter:        \"unknown\",\n384|\t\tReceiptPresent:    false,\n385|\t\tExternalEffect:    input.ExternalEffect,\n386|\t\tStatusProbe:       statusSummary(input),\n387|\t\tLeaseBefore:       input.LeaseBefore,\n388|\t\tLeaseAfter:        input.LeaseAfter,\n389|\t\tNativeBefore:      input.NativeBefore,\n390|\t\tNativeAfter:       input.NativeAfter,\n391|\t\tSelected:          OutcomeRecoverableParked,\n392|\t\tReason:            fmt.Sprintf(\"journal bytes fail validation, quarantined: %v\", cause),\n393|\t\tRemediation:       \"inspect the torn journal, restore the materialization directory from a verified copy, then re-run recovery\",\n394|\t\tDecidedAt:         decided,\n395|\t}\n396|\tif err := writeRecoveryLocked(matDir, evidence); err != nil {\n397|\t\treturn \"\", Evidence{}, err\n398|\t}\n399|\treturn OutcomeRecoverableParked, evidence, nil\n400|}\n401|\n402|// recoveryAssessment carries one recovery decision with its durable\n403|// facts and modeled probes. pendingMarker holds the validated\n404|// destination marker once commitProvable proves the commit.\n405|type recoveryAssessment struct {\n406|\tstore          *Store\n407|\tmatDir         string\n408|\tjournal        *Journal\n409|\tview           planView\n410|\tinput          RecoveryInput\n411|\treceiptPresent bool\n412|\tpendingMarker  *Marker\n413|}\n414|\n415|// decide applies the gate chain and returns the single outcome.\n416|func (assessment *recoveryAssessment) decide() (Outcome, Evidence, error) {\n417|\tjournal := assessment.journal\n418|\tinput := assessment.input\n419|\tterminal := terminalPhase(journal.Phase)\n420|\n421|\t// Rejection gates that park even on a terminal journal: two live\n422|\t// authorities, substitution, and unfenced continuation are never a\n423|\t// successful recovery.\n424|\tif input.LeaseKnown && (input.LeaseAfter.Epoch != input.LeaseBefore.Epoch || input.LeaseAfter.ID != input.LeaseBefore.ID) {\n425|\t\treturn assessment.park(\"lease_conflict\", \"winning lease moved across the crash; reconcile the deterministic winner before any retry\",\n426|\t\t\t\"recompute the winning lease, fence the loser, then re-run recovery with the unchanged winner\")\n427|\t}\n428|\tif assessment.nativeRequired() {\n429|\t\tif !input.NativeKnown {\n430|\t\t\treturn assessment.park(\"operation_uncertain\", \"native identity/binding evidence is missing for an adopted transaction\",\n431|\t\t\t\t\"reconcile the exact persisted provider identity or task-board binding, then re-run recovery\")\n432|\t\t}\n433|\t\tif input.NativeAfter != input.NativeBefore {\n434|\t\t\treturn assessment.park(\"lease_conflict\", \"native identity/binding differs across the crash: substitution is never a successful recovery\",\n435|\t\t\t\t\"restore the exact persisted identity or binding; a fresh handle, blank state, or different realm never recovers this operation\")\n436|\t\t}\n437|\t}\n438|\tif input.Provider.State == ProviderCommitted && input.Provider.PlanMatches && input.Provider.IDsMatch &&\n439|\t\tassessment.bridgeLive() && !input.Bridge.BindingMatches {\n440|\t\treturn assessment.park(\"lease_conflict\", \"two live authorities: the provider committed while a differently bound manager is live\",\n441|\t\t\t\"fence one authority with visible divergent-history evidence, then re-run recovery\")\n442|\t}\n443|\tif assessment.bridgeLive() && !input.Bridge.LeaseActive && assessment.bridgeAdopted() {\n444|\t\treturn assessment.park(\"stale_owner\", \"unfenced continuation: an adopted manager is live without the winning lease\",\n445|\t\t\t\"fence or stop the losing manager with visible evidence, then re-run recovery\")\n446|\t}\n447|\t// Terminal journals return their recorded result once the\n448|\t// authority gates pass: probes cannot reopen them.\n449|\tif terminal {\n450|\t\treturn assessment.completeSafeRetry(\"journal is terminal in %s: returning the recorded result\", journal.Phase)\n451|\t}\n452|\t// Authority and evidence gates for non-terminal journals.\n453|\tif !input.LeaseKnown {\n454|\t\treturn assessment.park(\"operation_uncertain\", \"winning lease evidence is missing\",\n455|\t\t\t\"reconcile the winning lease, then re-run recovery\")\n456|\t}\n457|\tswitch input.Host {\n458|\tcase HostDiskFull:\n459|\t\treturn assessment.park(\"staging_incomplete\", \"destination disk full: existing destination retained, staging partial\",\n460|\t\t\t\"free space, then resume the same operation\")\n461|\tcase HostRenameBlocked:\n462|\t\treturn assessment.park(\"staging_incomplete\", \"atomic rename blocked: staging retained, never overwritten in place\",\n463|\t\t\t\"close the blocking handles, then retry the same operation\")\n464|\t}\n465|\tswitch input.Marker {\n466|\tcase MarkerMismatch:\n467|\t\treturn assessment.park(\"integrity_failure\", \"destination marker disagrees with the journal (MJ-CRASH-MARKER-MISMATCH): quarantined, nothing further mutates\",\n468|\t\t\t\"quarantine the transaction, reconcile the marker against the plan and checkpoint, then re-run recovery\")\n469|\tcase MarkerInvalid:\n470|\t\treturn assessment.park(\"integrity_failure\", \"destination marker is invalid: quarantined, nothing further mutates\",\n471|\t\t\t\"quarantine the transaction, reconcile the marker bytes, then re-run recovery\")\n472|\t}\n473|\tif input.Provider.State == ProviderUnknown && assessment.providerEffectUncertain() {\n474|\t\treturn assessment.park(\"operation_uncertain\", \"provider status is unknown after a possibly executed effect\",\n475|\t\t\t\"call materialize-status with the same IDs until the state is known, then re-run recovery\")\n476|\t}\n477|\tif journal.TaskBoard != nil && input.Bridge.State == ProviderUnknown && assessment.bridgeEffectUncertain() {\n478|\t\treturn assessment.park(\"operation_uncertain\", \"bridge status is unknown after a possibly executed effect\",\n479|\t\t\t\"query bridge status by reference and binding, then re-run recovery\")\n480|\t}\n481|\tif journal.Provider != nil && journal.Provider.State == ProviderPrepared &&\n482|\t\tinput.Provider.State == ProviderPrepared && !input.Provider.TokenMatches {\n483|\t\treturn assessment.park(\"integrity_failure\", \"provider token disagrees between the journal and the status probe\",\n484|\t\t\t\"reconcile the prepared token from the plugin root without allocating a second transaction, then re-run recovery\")\n485|\t}\n486|\tif journal.TaskBoard != nil && (journal.TaskBoard.State == BoardAdopted || journal.TaskBoard.State == BoardResumed) &&\n487|\t\t(assessment.bridgeLive() || input.Bridge.State == BoardAdopted || input.Bridge.State == BoardResumed) &&\n488|\t\t(!input.Bridge.BindingMatches || !input.Bridge.ManagerMatches) {\n489|\t\treturn assessment.park(\"lease_conflict\", \"bridge reports another session, epoch, lease, or manager (TB-TXN-BINDING-MISMATCH): evidence preserved, nothing further mutates\",\n490|\t\t\t\"reconcile the exact Ax Binding and manager reference, then re-run recovery\")\n491|\t}\n492|\tif (journal.Phase == PhaseRollingBack || journal.Phase == PhaseRolledBack) &&\n493|\t\t((journal.TaskBoard != nil && (journal.TaskBoard.State == BoardAdopted || journal.TaskBoard.State == BoardResumed)) ||\n494|\t\t\t(journal.Provider != nil && journal.Provider.State == ProviderCommitted)) {\n495|\t\treturn assessment.park(\"integrity_failure\", \"journal contradicts itself: rollback phase with an activated sub-state\",\n496|\t\t\t\"inspect the torn journal progression, restore a verified copy, then re-run recovery\")\n497|\t}\n498|\tif (journal.Phase == PhaseStaging || journal.Phase == PhaseValidating || journal.Phase == PhasePrepared) &&\n499|\t\tassessment.activatedEarly() {\n500|\t\treturn assessment.park(\"integrity_failure\", \"journal contradicts itself: an activated sub-state before the committing phase\",\n501|\t\t\t\"inspect the torn journal progression, restore a verified copy, then re-run recovery\")\n502|\t}\n503|\t// Rollback-required facts execute the allowed abort.\n504|\tif rollback, code, reason, remediation := assessment.rollbackRequired(); rollback {\n505|\t\treturn assessment.executeRollback(code, reason, remediation)\n506|\t}\n507|\t// Provable terminal completions apply and return safe_retry.\n508|\tif done, outcome, evidence, err := assessment.tryComplete(); done {\n509|\t\treturn outcome, evidence, err\n510|\t}\n511|\t// Every other consistent assessment resumes or replays.\n512|\treturn assessment.completeSafeRetry(\"%s\", assessment.resumeReason())\n513|}\n514|\n515|// nativeRequired reports whether a native identity/binding comparison\n516|// exists: a committed provider transaction (live native handles) or an\n517|// adopted bridge binding. A merely prepared transaction has no live\n518|// identity to substitute, so no comparison exists yet.\n519|func (assessment *recoveryAssessment) nativeRequired() bool {\n520|\tif assessment.journal.Provider != nil && assessment.journal.Provider.State == ProviderCommitted {\n521|\t\treturn true\n522|\t}\n523|\tboard := assessment.journal.TaskBoard\n524|\treturn board != nil && (board.State == BoardAdopted || board.State == BoardResumed)\n525|}\n526|\n527|// bridgeLive reports a live manager from the probe.\n528|func (assessment *recoveryAssessment) bridgeLive() bool {\n529|\tif assessment.input.Bridge.Live {\n530|\t\treturn true\n531|\t}\n532|\tswitch assessment.input.Bridge.State {\n533|\tcase \"running\", \"idle\":\n534|\t\treturn true\n535|\tdefault:\n536|\t\treturn false\n537|\t}\n538|}\n539|\n540|// bridgeAdopted reports whether the journal or the probe names an\n541|// adopted manager.\n542|func (assessment *recoveryAssessment) bridgeAdopted() bool {\n543|\tboard := assessment.journal.TaskBoard\n544|\tif board != nil && (board.State == BoardAdopted || board.State == BoardResumed) {\n545|\t\treturn true\n546|\t}\n547|\tswitch assessment.input.Bridge.State {\n548|\tcase BoardAdopted, BoardResumed:\n549|\t\treturn true\n550|\tdefault:\n551|\t\treturn false\n552|\t}\n553|}\n554|\n555|// providerEffectUncertain reports whether an unknown provider probe\n556|// leaves a possibly executed effect unreconciled: a commit or rollback\n557|// may have executed once the journal reached prepared, or a prepare\n558|// may have executed unrecorded from CR-MAT-05 on. A recorded prepared\n559|// token at staging or validating stands on its own: the commit is\n560|// impossible there, so the unknown probe is vacuous.\n561|func (assessment *recoveryAssessment) providerEffectUncertain() bool {\n562|\tjournal := assessment.journal\n563|\tif !assessment.providerParticipates() {\n564|\t\treturn false\n565|\t}\n566|\tif journal.Provider != nil {\n567|\t\treturn journal.Phase == PhasePrepared || journal.Phase == PhaseCommitting ||\n568|\t\t\tjournal.Phase == PhaseRollingBack\n569|\t}\n570|\treturn boundaryAtOrAfter(assessment.input.Boundary, BoundaryAfterPrepareOp)\n571|}\n572|\n573|// providerParticipates reports whether a provider branch exists: a\n574|// recorded transaction or a provider-store plan authority. Plans\n575|// without one leave the provider probe vacuous.\n576|func (assessment *recoveryAssessment) providerParticipates() bool {\n577|\tif assessment.journal.Provider != nil {\n578|\t\treturn true\n579|\t}\n580|\tfor _, authority := range assessment.view.Authorities {\n581|\t\tif authority.Kind == PlanKindProviderStore {\n582|\t\t\treturn true\n583|\t\t}\n584|\t}\n585|\treturn false\n586|}\n587|\n588|// bridgeEffectUncertain reports whether an unknown bridge probe leaves\n589|// a possibly executed effect unreconciled: an adopted manager may have\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
