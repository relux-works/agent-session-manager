string\\n136:\\t// coverageFull means every normative clause the pinned section carries is\\n137:\\t// enumerated with a verified excerpt and an acceptance owner.\\n138:\\tcoverageFull coverageLevel = \\\"full\\\"\\n139:\\t// coveragePartial means at least half of them are.\\n140:\\tcoveragePartial coverageLevel = \\\"partial\\\"\\n141:\\t// coverageSliver means fewer than half are: the binding implements a corner\\n143:\\tcoverageSliver coverageLevel = \\\"sliver\\\"\\n144:\\t// coverageUnevidenced means the binding enumerates no clause at all. It says\\n145:\\t// the registry makes no clause-level claim, not that the implementation\\n147:\\tcoverageUnevidenced coverageLevel = \\\"unevidenced\\\"\\n148:\\t// coverageUnmeasured means normativeKeywordPattern finds no clause line\\n162:\\tcoverageUnmeasured coverageLevel = \\\"unmeasured\\\"\\n165:// dischargedClause binds one normative clause of the pinned section to the\\n167:// hash-verified document: the identifier must index the section's own clause\\n168:// inventory, the line must be the line that clause occupies, and the excerpt\\n169:// must be that clause's text quoted verbatim, so a clause cannot be claimed\\n174:\\tExcerpt         string   `json:\\\"excerpt\\\"`\\n178:// normativeClause is one RFC 2119 clause line of the pinned specification,\\n200:// inputs, stale generated output, compatibility coverage, and every registered\\n202:func VerifyRepository(repository fs.FS) (Report, error) {\\n210:func VerifyAssignedSections(repository fs.FS, sections []string) (Report, error) {\\n292:\\t\\t\\t\\\"verified normative lock document digest %s differs from the pinned clause source %s\\\",\\n382:\\tcoverage, err := verifySectionCoverage(document, registry.Ownership, acceptanceIDs)\\n386:\\townedSections := make(map[string]struct{}, len(coverage))\\n387:\\tfor key := range coverage {\\n410:\\t\\t\\t// Admission requires full and nothing else. coverageUnmeasured is\\n414:\\t\\t\\t// gate exists to refuse. Absence of a scanner-visible clause is a\\n416:\\t\\t\\tmeasured := coverage[key]\\n417:\\t\\t\\tif measured.Level != coverageFull {\\n419:\\t\\t\\t\\t\\t\\\"assigned section %q binding %q discharges %s normative clauses, which is %s coverage; assigned-scope admission requires full: %s\\\",\\n448:\\t\\tSectionBindings:        len(coverage),\\n451:\\tfor _, measured := range coverage {\\n455:\\t\\tcase coverageFull:\\n457:\\t\\tcase coveragePartial:\\n459:\\t\\tcase coverageSliver:\\n461:\\t\\tcase coverageUnevidenced:\\n463:\\t\\tcase coverageUnmeasured:\\n471:// pinned document and refuses a coverage claim on any other ownership kind. A\\n473:// coverage field there would be a claim the gate cannot check.\\n484:\\t\\t\\t\\t\\t\\\"ownership group %d (%s) claims section coverage, which only a section binding can be measured for\\\",\\n497:\\t\\t\\treturn nil, fail(\\\"duplicate section_binding implementation owner for %q\\\", measured.Key)\\n504:func verifyAcceptanceCases(checker *sourceChecker, cases []acceptanceCase) (map[string]struct{}, error) {\\n982:// specification line a clause an implementation has to discharge. MAY and\\n984:// would inflate the denominator and make coverage look worse than it is.\\n987:// clauseIdentifierPattern matches the \\\"<section>#<index>\\\" form of a clause id.\\n988:var clauseIdentifierPattern = regexp.MustCompile(`^(.+)#([1-9][0-9]*)$`)\\n1062:// sectionClauseInventory measures every normative clause the pinned document\\n1094:// coverageBucket is the measured coverage level. It is computed from the two\\n1096:func coverageBucket(discharged, total int) coverageLevel {\\n1099:\\t\\treturn coverageUnmeasured\\n1101:\\t\\treturn coverageUnevidenced\\n1103:\\t\\treturn coverageFull\\n1105:\\t\\treturn coveragePartial\\n1107:\\t\\treturn coverageSliver\\n1114:\\tLevel      coverageLevel\\n1120:// Ratio renders the measured coverage as the ratio it was computed from, so a\\n1121:// report never has to describe coverage in prose.\\n1122:func (coverage sectionCoverage) Ratio() string {\\n1123:\\treturn fmt.Sprintf(\\\"%d/%d\\\", coverage.Discharged, coverage.Total)\\n1131:// enumerated clause is a real obligation of the claimed section, quoted\\n1134:// cannot decide that the named acceptance case exercises the clause's meaning —\\n1135:// that residual is stated in README.md and in the coverage artifact.\\n1144:\\t\\treturn sectionCoverage{}, fail(\\\"section binding %q clause inventory: %v\\\", key, err)\\n1147:\\tfor _, clause := range inventory {\\n1148:\\t\\tbyIdentifier[clause.ID] = clause\\n1157:\\t\\tclause, known := byIdentifier[declared.ID]\\n1160:\\t\\t\\t\\t\\\"section binding %q discharges clause %q, which is not one of the %d normative clauses of the pinned section\\\",\\n\",\n  \"original_output_bytes\": 5255,\n  \"original_output_tokens\": 1314,\n  \"truncated\": false\n}","final_result":true}}}
