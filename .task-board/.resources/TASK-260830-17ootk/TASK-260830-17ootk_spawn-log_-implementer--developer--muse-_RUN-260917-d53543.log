{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c63d","stream":{"kind":"session","id":"01a0ae2b-f4bb-7310-a5c5-e45123d43dca"},"sequence":377,"recorded_at":1780531400000749,"record_type":"event","durability":"durable","causation_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","run_stream":{"kind":"run","id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3"},"task_stream":{"kind":"task","id":"01a0ae2d-3e34-7550-9e90-6f21f0723066"},"task_id":"01a0ae2d-3e34-7550-9e90-6f21f0723066","event":{"kind":"output","task_id":"01a0ae2d-3e34-7550-9e90-6f21f0723066","chunk":"Read text file `internal/matjournal/recover.go`.\n(140 line(s) above)\n141|type RecoveryInput struct {\n142|\tBoundary    string\n143|\tPath        string\n144|\tProvider    ProviderProbe\n145|\tBridge      BridgeProbe\n146|\tMarker      string\n147|\tHost        string\n148|\tLeaseKnown  bool\n149|\tLeaseBefore LeaseIdentity\n150|\tLeaseAfter  LeaseIdentity\n151|\t// NativeKnown gates the native identity/binding comparison. It is\n152|\t// required only when the journal carries a provider transaction\n153|\t// or an adopted bridge binding; otherwise no native identity\n154|\t// exists to compare.\n155|\tNativeKnown  bool\n156|\tNativeBefore string\n157|\tNativeAfter  string\n158|\t// ExternalEffect describes the possibly executed external effect\n159|\t// the probes reconcile (for example \"bridge adopt may have\n160|\t// adopted the dormant manager\").\n161|\tExternalEffect string\n162|\t// MarkerBytes carries the probe-attested destination marker for\n163|\t// a workspace commit completion; PriorMarkerBytes carries its\n164|\t// predecessor link when non-null. Both validate through the\n165|\t// closed marker shape before anything binds them.\n166|\tMarkerBytes      []byte\n167|\tPriorMarkerBytes []byte\n168|\t// PredecessorsRestored and StagingRemoved are the probe-verified\n169|\t// rollback-closure facts.\n170|\tPredecessorsRestored bool\n171|\tStagingRemoved       bool\n172|}\n173|\n174|// Evidence is the Section 13.13 conformance record for one recovery\n175|// assessment: boundary ID, path, operation IDs, pre/post durable\n176|// facts, external effect and status probe, winning lease and native\n177|// identity before/after, the selected outcome, and the reason and\n178|// remediation satisfying that outcome. Parked and rollback assessments\n179|// persist durably as recovery.json; safe_retry establishes no new\n180|// durable fact beyond the journal and receipt it returns.\n181|type Evidence struct {\n182|\tMaterializationID string            `json:\"materialization_id\"`\n183|\tBoundary          string            `json:\"boundary\"`\n184|\tPath              string            `json:\"path\"`\n185|\tOperationIDs      map[string]string `json:\"operation_ids\"`\n186|\tPhaseBefore       string            `json:\"phase_before\"`\n187|\tPhaseAfter        string            `json:\"phase_after\"`\n188|\tReceiptPresent    bool              `json:\"receipt_present\"`\n189|\tProviderState     string            `json:\"provider_state\"`\n190|\tBridgeState       string            `json:\"bridge_state\"`\n191|\tExternalEffect    string            `json:\"external_effect\"`\n192|\tStatusProbe       string            `json:\"status_probe\"`\n193|\tLeaseBefore       LeaseIdentity     `json:\"lease_before\"`\n194|\tLeaseAfter        LeaseIdentity     `json:\"lease_after\"`\n195|\tNativeBefore      string            `json:\"native_before\"`\n196|\tNativeAfter       string            `json:\"native_after\"`\n197|\tSelected          Outcome           `json:\"selected\"`\n198|\tReason            string            `json:\"reason\"`\n199|\tRemediation       string            `json:\"remediation\"`\n200|\tDecidedAt         string            `json:\"decided_at\"`\n201|}\n202|\n203|// parkedFailure builds the blocking-reason Structured Error for a\n204|// parked assessment: the named code with retryable false (parked\n205|// ambiguity is never retry permission).\n206|func parkedFailure(code axerror.Code, message string, operation string) (*axerror.Error, error) {\n207|\tids := axerror.NoIDs()\n208|\tif operation != \"\" {\n209|\t\tparsed, err := scalar.ParseUUIDv7(operation)\n210|\t\tif err == nil {\n211|\t\t\tids = ids.WithOperation(parsed)\n212|\t\t}\n213|\t}\n214|\treturn axerror.New(axerror.Spec{\n215|\t\tVersion:   lastErrorVersion,\n216|\t\tCode:      code,\n217|\t\tMessage:   message,\n218|\t\tRetryable: false,\n219|\t\tIDs:       ids,\n220|\t\tDetails:   axerror.Details{},\n221|\t})\n222|}\n223|\n224|// rollbackFailure builds the terminal-reason Structured Error for an\n225|// executed rollback.\n226|func rollbackFailure(code axerror.Code, message string, operation string) (*axerror.Error, error) {\n227|\treturn parkedFailure(code, message, operation)\n228|}\n229|\n230|// Recover classifies one crashed materialization after a clean restart\n231|// into exactly one Section 13.13 outcome. It reads durable facts first\n232|// (journal, receipt, plan view), then applies the rejection gates in\n233|// order: unknown or moved authority, substitution, two live\n234|// authorities, unfenced continuation, host conditions, marker\n235|// integrity, unknown decisive status, and contradictory probes all\n236|// park. Rollback-required facts execute the allowed abort and return\n237|// explicit_rollback; provable terminal completions (commit, dormant\n238|// finalize, rollback close) apply and return safe_retry; every other\n239|// consistent assessment resumes or replays with safe_retry.\n240|//\n241|// Parked assessments record the blocking reason as last_error (except\n242|// on a terminal journal, which stays frozen) and persist the evidence\n243|// as recovery.json. Rollback assessments persist the terminal journal\n244|// and the evidence. Safe_retry assessments mutate nothing: the journal\n245|// and receipt they return are the evidence.\n246|func (store *Store) Recover(materializationID string, input RecoveryInput) (Outcome, Evidence, error) {\n247|\tid, err := checkUUIDv7(materializationID, \"materialization_id\")\n248|\tif err != nil {\n249|\t\treturn \"\", Evidence{}, err\n250|\t}\n251|\tif !validBoundary(input.Boundary) {\n252|\t\treturn \"\", Evidence{}, invalid(\"recovery boundary %q is outside CR-MAT-01..08\", input.Boundary)\n253|\t}\n254|\tif !validPath(input.Path) {\n255|\t\treturn \"\", Evidence{}, invalid(\"recovery path %q is outside the CR-MAT path set\", input.Path)\n256|\t}\n257|\tif err := checkRecoveryProbes(&input); err != nil {\n258|\t\treturn \"\", Evidence{}, err\n259|\t}\n260|\tstore.mutex.Lock()\n261|\tdefer store.mutex.Unlock()\n262|\tmatDir := filepath.Join(store.root, id)\n263|\traw, err := readJournalFile(filepath.Join(matDir, \"journal.json\"))\n264|\tif err != nil {\n265|\t\tif os.IsNotExist(err) {\n266|\t\t\tif input.Boundary != BoundaryBeforeCreate {\n267|\t\t\t\treturn \"\", Evidence{}, fmt.Errorf(\"%w: %s\", ErrUnknownJournal, id)\n268|\t\t\t}\n269|\t\t\treturn store.recoverBeforeCreateLocked(id, input)\n270|\t\t}\n271|\t\treturn \"\", Evidence{}, err\n272|\t}\n273|\tview, err := store.readPlanViewLocked(matDir)\n274|\tif err != nil {\n275|\t\treturn \"\", Evidence{}, err\n276|\t}\n277|\tjournal, err := decodeJournal(raw, view)\n278|\tif err != nil {\n279|\t\treturn store.parkTornLocked(id, matDir, input, err)\n280|\t}\n281|\t_, receiptPresent, err := store.readReceiptLocked(matDir, journal.PrepareOperationID)\n282|\tif err != nil {\n283|\t\treturn \"\", Evidence{}, err\n284|\t}\n285|\tassessment := recoveryAssessment{\n286|\t\tstore:          store,\n287|\t\tmatDir:         matDir,\n288|\t\tjournal:        &journal,\n289|\t\tview:           view,\n290|\t\tinput:          input,\n291|\t\treceiptPresent: receiptPresent,\n292|\t}\n293|\treturn assessment.decide()\n294|}\n295|\n296|// checkRecoveryProbes validates the modeled probe enums and the lease\n297|// observations.\n298|func checkRecoveryProbes(input *RecoveryInput) error {\n299|\tswitch input.Provider.State {\n300|\tcase ProviderUnknown, ProviderPrepared, ProviderCommitted, ProviderRolledBack:\n301|\tdefault:\n302|\t\treturn invalid(\"provider probe state %q is outside the closed enum\", input.Provider.State)\n303|\t}\n304|\tswitch input.Bridge.State {\n305|\tcase ProviderUnknown, BoardNotStarted, BoardImported, BoardOpened, BoardAdopted,\n306|\t\tBoardResumed, BoardDormantFinalized, BoardRolledBack, BoardFailed,\n307|\t\t\"dormant\", \"quiesced\", \"stopped\", \"running\", \"idle\":\n308|\tdefault:\n309|\t\treturn invalid(\"bridge probe state %q is outside the closed vocabulary\", input.Bridge.State)\n310|\t}\n311|\tswitch input.Marker {\n312|\tcase MarkerAbsent, MarkerValidMatch, MarkerMismatch, MarkerInvalid:\n313|\tdefault:\n314|\t\treturn invalid(\"marker probe %q is outside the closed vocabulary\", input.Marker)\n315|\t}\n316|\tswitch input.Host {\n317|\tcase HostOK, HostDiskFull, HostRenameBlocked:\n318|\tdefault:\n319|\t\treturn invalid(\"host condition %q is outside the closed vocabulary\", input.Host)\n320|\t}\n321|\tif input.LeaseKnown {\n322|\t\tif input.LeaseBefore.Epoch < 1 || input.LeaseBefore.Epoch > uint53Max {\n323|\t\t\treturn invalid(\"recovery winning lease epoch %d is outside 1..2^53-1\", input.LeaseBefore.Epoch)\n324|\t\t}\n325|\t\tif _, err := scalar.ParseUUIDv4(input.LeaseBefore.ID); err != nil {\n326|\t\t\treturn invalid(\"recovery winning lease id: %v\", err)\n327|\t\t}\n328|\t\tif input.LeaseAfter.Epoch < 1 || input.LeaseAfter.Epoch > uint53Max {\n329|\t\t\treturn invalid(\"recovery winning lease epoch %d is outside 1..2^53-1\", input.LeaseAfter.Epoch)\n330|\t\t}\n331|\t\tif _, err := scalar.ParseUUIDv4(input.LeaseAfter.ID); err != nil {\n332|\t\t\treturn invalid(\"recovery winning lease id: %v\", err)\n333|\t\t}\n334|\t}\n335|\treturn nil\n336|}\n337|\n338|// recoverBeforeCreateLocked classifies CR-MAT-01 with no journal:\n339|// nothing durable exists, so the same IDs retry fresh.\n340|func (store *Store) recoverBeforeCreateLocked(id string, input RecoveryInput) (Outcome, Evidence, error) {\n(more lines below)","final_result":true}}}
