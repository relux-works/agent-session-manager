81|\tdefault:\n82|\t\treturn false\n83|\t}\n84|}\n85|\n86|// Host conditions (SPEC Section 13.12): destination disk full and\n87|// atomic rename blocked. Either parks with its remediation; neither\n88|// overwrites in place.\n89|const (\n90|\tHostOK            = \"none\"\n91|\tHostDiskFull      = \"disk_full\"\n92|\tHostRenameBlocked = \"rename_blocked\"\n93|)\n94|\n95|// Marker probe states: absent, a valid marker matching the journal, a\n96|// mismatching marker, or an invalid marker.\n97|const (\n98|\tMarkerAbsent     = \"absent\"\n99|\tMarkerValidMatch = \"valid_match\"\n100|\tMarkerMismatch   = \"mismatch\"\n101|\tMarkerInvalid    = \"invalid\"\n102|)\n103|\n104|// ProviderProbe is the modeled materialize-status reading: the plugin\n105|// state with ID, plan, and token agreement against the journal.\n106|type ProviderProbe struct {\n107|\tState        string\n108|\tIDsMatch     bool\n109|\tPlanMatches  bool\n110|\tTokenMatches bool\n111|}\n112|\n113|// BridgeProbe is the modeled bridge-status reading: the manager state\n114|// with binding and reference agreement, lease authority for adopt,\n115|// liveness, and token expiry.\n116|type BridgeProbe struct {\n117|\tState          string\n118|\tBindingMatches bool\n119|\tManagerMatches bool\n120|\tLeaseActive    bool\n121|\tLive           bool\n122|\tTokenExpired   bool\n123|\tFailed         bool\n124|}\n125|\n126|// LeaseIdentity is the winning-lease observation before or after the\n127|// crash: epoch plus fencing token.\n128|type LeaseIdentity struct {\n129|\tEpoch uint64 `json:\"epoch\"`\n130|\tID    string `json:\"lease_id\"`\n131|}\n132|\n133|// RecoveryInput is the status-first recovery closure: the crash\n134|// boundary and path, one status probe per possibly executed external\n135|// effect, the host condition, the winning lease and native\n136|// identity/binding before and after, and the rollback-closure proofs.\n137|// Durable facts (journal, receipt, plan view) are read first from the\n138|// store