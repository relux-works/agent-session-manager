{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000dc81","stream":{"kind":"session","id":"01a0ae2b-f4bb-7310-a5c5-e45123d43dca"},"sequence":3227,"recorded_at":1780531400006449,"record_type":"event","durability":"durable","causation_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","run_stream":{"kind":"run","id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3"},"call_id":"call_01a0ae4e1529718eb1df48fc7696f1b8","text":"edited\nchanged lines: lines 763-775\n--- original\n+++ updated\n@@\n-// conformanceDir returns the directory conformance records are\n-// written to: CRASHGATE_CONFORMANCE_DIR when set (the evidence\n-// collection run), otherwise a per-test temp directory.\n-func conformanceDir(t *testing.T) string {\n-\tt.Helper()\n-\tif dir := os.Getenv(\"CRASHGATE_CONFORMANCE_DIR\"); dir != \"\" {\n-\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n-\t\t\tt.Fatal(err)\n-\t\t}\n-\t\treturn dir\n-\t}\n-\treturn t.TempDir()\n-}\n+// conformanceDir returns the directory conformance records are\n+// written to: CRASHGATE_CONFORMANCE_DIR when set (the evidence\n+// collection run), otherwise a per-test temp directory. A relative\n+// directory resolves against the module root (tests run with the\n+// package directory as the working directory), so\n+// CRASHGATE_CONFORMANCE_DIR=.temp/... lands under the repository\n+// .temp tree as the evidence contract requires.\n+func conformanceDir(t *testing.T) string {\n+\tt.Helper()\n+\tdir := os.Getenv(\"CRASHGATE_CONFORMANCE_DIR\")\n+\tif dir == \"\" {\n+\t\treturn t.TempDir()\n+\t}\n+\tif !filepath.IsAbs(dir) {\n+\t\tdir = filepath.Join(moduleRoot(t), dir)\n+\t}\n+\tif err := os.MkdirAll(dir, 0o755); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\treturn dir\n+}\n+\n+// moduleRoot walks up from the test working directory to the\n+// directory carrying go.mod.\n+func moduleRoot(t *testing.T) string {\n+\tt.Helper()\n+\tcurrent, err := os.Getwd()\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tfor {\n+\t\tif _, err := os.Stat(filepath.Join(current, \"go.mod\")); err == nil {\n+\t\t\treturn current\n+\t\t}\n+\t\tparent := filepath.Dir(current)\n+\t\tif parent == current {\n+\t\t\tt.Fatal(\"go.mod not found above the test working directory\")\n+\t\t}\n+\t\tcurrent = parent\n+\t}\n+}\n","edit_facts":{"tool_name":"edit_file","path":"internal/crashgate/helpers_test.go","added":41,"removed":13},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
