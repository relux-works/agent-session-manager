{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc73","stream":{"kind":"session","id":"01a0ae2b-f4bb-7310-a5c5-e45123d43dca"},"sequence":1172,"recorded_at":1780531400002339,"record_type":"event","durability":"durable","causation_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","run_stream":{"kind":"run","id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3"},"task_stream":{"kind":"task","id":"01a0ae32-b325-70b3-b832-0218daed4054"},"task_id":"01a0ae32-b325-70b3-b832-0218daed4054","event":{"kind":"output","task_id":"01a0ae32-b325-70b3-b832-0218daed4054","chunk":"Read text file `internal/matjournal/journal_test.go`.\n(404 line(s) above)\n405|func TestSpecExampleShapeDrivesThroughProduction(t *testing.T) {\n406|\tstore := openTestStore(t)\n407|\tmustCreate(t, store, testInputsComposite())\n408|\t// The provider prepares with its rollback token durable.\n409|\tprovider := testProvider()\n410|\tif _, err := store.UpdateProvider(testMatID, provider); err != nil {\n411|\t\tt.Fatalf(\"UpdateProvider error = %v\", err)\n412|\t}\n413|\t// Both authorities prepare with their rollback roots: the\n414|\t// provider authority references the plugin backup, the workspace\n415|\t// authority its host staging root.\n416|\tproviderRoot := testTxRoot + \"/backups/codex_sessions\"\n417|\tif _, err := store.UpdateAuthority(testMatID, \"codex_sessions\", AuthorityState{\n418|\t\tRootPath:            testRootProvider,\n419|\t\tCompletedSequences:  []uint64{2},\n420|\t\tObservedPriorDigest: nil,\n421|\t\tRollbackRoot:        &providerRoot,\n422|\t\tState:               AuthorityPrepared,\n423|\t}); err != nil {\n424|\t\tt.Fatalf(\"UpdateAuthority(codex_sessions) error = %v\", err)\n425|\t}\n426|\tworkspaceRoot := \"/home/ivan/.local/state/ax/materializations/\" + testMatID + \"/workspace_relux\"\n427|\tif _, err := store.UpdateAuthority(testMatID, \"workspace_relux\", AuthorityState{\n428|\t\tRootPath:            testRootWorkspace,\n429|\t\tCompletedSequences:  []uint64{1},\n430|\t\tObservedPriorDigest: str(\"sha256:3333333333333333333333333333333333333333333333333333333333333333\"),\n431|\t\tRollbackRoot:        &workspaceRoot,\n432|\t\tState:               AuthorityPrepared,\n433|\t}); err != nil {\n434|\t\tt.Fatalf(\"UpdateAuthority(workspace_relux) error = %v\", err)\n435|\t}\n436|\t// The bridge imports and opens; commit then enters prepared.\n437|\tif _, err := store.UpdateTaskBoard(testMatID, testBoardImported()); err != nil {\n438|\t\tt.Fatalf(\"UpdateTaskBoard(imported) error = %v\", err)\n439|\t}\n440|\tif _, err := store.UpdateTaskBoard(testMatID, testBoardOpened()); err != nil {\n441|\t\tt.Fatalf(\"UpdateTaskBoard(opened) error = %v\", err)\n442|\t}\n443|\tif _, err := store.Transition(testMatID, PhaseValidating, TransitionOpts{}); err != nil {\n444|\t\tt.Fatalf(\"Transition(validating) error = %v\", err)\n445|\t}\n446|\tprepared, err := store.Transition(testMatID, PhasePrepared, TransitionOpts{})\n447|\tif err != nil {\n448|\t\tt.Fatalf(\"Transition(prepared) error = %v\", err)\n449|\t}\n450|\t// The prepared journal matches the normative example members:\n451|\t// phase, provider prepared token, authority states, opened\n452|\t// bridge with its open capability.\n453|\tif prepared.Phase != PhasePrepared {\n454|\t\tt.Fatalf(\"phase = %q\", prepared.Phase)\n455|\t}\n456|\tif prepared.Provider.State != ProviderPrepared || prepared.Provider.RollbackToken == nil {\n457|\t\tt.Fatalf(\"provider = %+v\", prepared.Provider)\n458|\t}\n459|\tif prepared.TaskBoard.State != BoardOpened || prepared.TaskBoard.OpenToken == nil {\n460|\t\tt.Fatalf(\"task-board = %+v\", prepared.TaskBoard)\n461|\t}\n462|\tif prepared.AuthorityStates[\"codex_sessions\"].State != AuthorityPrepared ||\n463|\t\tprepared.AuthorityStates[\"workspace_relux\"].State != AuthorityPrepared {\n464|\t\tt.Fatalf(\"authorities = %+v\", prepared.AuthorityStates)\n465|\t}\n466|}\n467|\n468|// specOpenedFixture is the verbatim MJ-TASK-BOARD-OPENED-POS fixture.\n469|const specOpenedFixture = `{\n470|  \"bundle_id\": \"sha256:0af7b44e7063375a0f06e546fd820438c72607f191c14be78d35c8ffa109844f\",\n471|  \"activation_mode\": \"ownership_transfer\",\n472|  \"import_operation_id\": \"0198f4c8-0a10-71aa-8111-1234567890ab\",\n473|  \"open_operation_id\": \"0198f4c8-0a20-72bb-8222-1234567890ab\",\n474|  \"adopt_operation_id\": \"0198f4c8-0a30-73cc-8333-1234567890ab\",\n475|  \"resume_operation_id\": \"0198f4c8-0a40-74dd-8444-1234567890ab\",\n476|  \"state\": \"opened\",\n477|  \"import_token\": null,\n478|  \"staged_manager_ref\": null,\n479|  \"import_expires_at\": null,\n480|  \"open_token\": \"b3duZXItb25seS1vcGVuLXRva2VuLTAxMjM0NTY3ODlhYmNkZWY\",\n481|  \"dormant_manager_ref\": \"tbm:dormant:0198f4c8-7a10-7b22-8b3c-2234567890ab\",\n482|  \"open_expires_at\": \"2026-08-19T04:22:10.000Z\",\n483|  \"manager_session_ref\": null,\n484|  \"ax_binding\": null,\n485|  \"last_bridge_state\": \"dormant\",\n486|  \"last_status_at\": \"2026-08-19T04:12:10.000Z\",\n487|  \"cleanup_state\": \"not_started\",\n488|  \"cleanup_after\": null\n489|}`\n490|\n491|func TestOpenedFixtureMatchesProduction(t *testing.T) {\n492|\tstore := openTestStore(t)\n493|\tmustCreate(t, store, testInputsComposite())\n494|\tif _, err := store.UpdateTaskBoard(testMatID, testBoardImported()); err != nil {\n495|\t\tt.Fatalf(\"UpdateTaskBoard(imported) error = %v\", err)\n496|\t}\n497|\tupdated, err := store.UpdateTaskBoard(testMatID, testBoardOpened())\n498|\tif err != nil {\n499|\t\tt.Fatalf(\"UpdateTaskBoard(opened) error = %v\", err)\n500|\t}\n501|\tframed, err := json.Marshal(updated.TaskBoard)\n502|\tif err != nil {\n503|\t\tt.Fatal(err)\n504|\t}\n505|\tvar got, want map[string]any\n506|\tif err := json.Unmarshal(framed, &got); err != nil {\n507|\t\tt.Fatal(err)\n508|\t}\n509|\tif err := json.Unmarshal([]byte(specOpenedFixture), &want); err != nil {\n510|\t\tt.Fatal(err)\n511|\t}\n512|\twantBytes, _ := json.Marshal(want)\n513|\tgotBytes, _ := json.Marshal(got)\n514|\tif string(gotBytes) != string(wantBytes) {\n515|\t\tt.Fatalf(\"opened board = %s, want %s\", gotBytes, wantBytes)\n516|\t}\n517|}\n518|\n519|func TestRecordProgressMergesPerBlob(t *testing.T) {\n520|\tstore := openTestStore(t)\n521|\tmustCreate(t, store, testInputs())\n522|\t// MJ-MULTIBLOB-POS: chunk zero for two blobs is two independent\n523|\t// facts, recorded separately and merged by union.\n524|\tif _, err := store.RecordProgress(testMatID, map[string][]uint32{testBlobA: {0}}, nil); err != nil {\n525|\t\tt.Fatalf(\"RecordProgress(A0) error = %v\", err)\n526|\t}\n527|\tupdated, err := store.RecordProgress(testMatID, map[string][]uint32{testBlobB: {0}}, []string{testBlobA})\n528|\tif err != nil {\n529|\t\tt.Fatalf(\"RecordProgress(B0) error = %v\", err)\n530|\t}\n531|\tif len(updated.CompletedBlobChunks[testBlobA]) != 1 || len(updated.CompletedBlobChunks[testBlobB]) != 1 {\n532|\t\tt.Fatalf(\"chunks = %+v\", updated.CompletedBlobChunks)\n533|\t}\n534|\tif len(updated.VerifiedBlobIDs) != 1 || updated.VerifiedBlobIDs[0] != testBlobA {\n535|\t\tt.Fatalf(\"verified = %+v\", updated.VerifiedBlobIDs)\n536|\t}\n537|\t// A union merge keeps both sets sorted and unique.\n538|\tupdated, err = store.RecordProgress(testMatID, map[string][]uint32{testBlobA: {2, 1, 1}}, []string{testBlobB, testBlobA})\n539|\tif err != nil {\n540|\t\tt.Fatalf(\"RecordProgress(merge) error = %v\", err)\n541|\t}\n542|\tgot := updated.CompletedBlobChunks[testBlobA]\n543|\tif len(got) != 3 || got[0] != 0 || got[1] != 1 || got[2] != 2 {\n544|\t\tt.Fatalf(\"blob A chunks = %+v\", got)\n545|\t}\n546|\tif len(updated.VerifiedBlobIDs) != 2 {\n547|\t\tt.Fatalf(\"verified = %+v\", updated.VerifiedBlobIDs)\n548|\t}\n549|\t// Progress closes once the journal leaves validation.\n550|\tif _, err := store.Transition(testMatID, PhaseValidating, TransitionOpts{}); err != nil {\n551|\t\tt.Fatal(err)\n552|\t}\n553|\tif _, err := store.Transition(testMatID, PhasePrepared, TransitionOpts{}); err != nil {\n554|\t\tt.Fatal(err)\n555|\t}\n556|\tif _, err := store.RecordProgress(testMatID, map[string][]uint32{testBlobA: {3}}, nil); err == nil {\n557|\t\tt.Fatalf(\"RecordProgress(prepared) error = nil, want refusal\")\n558|\t} else {\n559|\t\tmustInvalid(t, err, \"RecordProgress(prepared)\")\n560|\t}\n561|}\n562|\n563|func TestFullDormantWalkCommits(t *testing.T) {\n564|\tstore := openTestStore(t)\n565|\tmustCreate(t, store, testInputsBoardOnly())\n566|\t// TB-TXN-PASSIVE: a passive replica stops at opened without\n567|\t// adopt or resume; the managed replica stays non-executable.\n568|\tif _, err := store.UpdateTaskBoard(testMatID, testBoardImportedDormant()); err != nil {\n569|\t\tt.Fatalf(\"UpdateTaskBoard(imported) error = %v\", err)\n570|\t}\n571|\tif _, err := store.UpdateTaskBoard(testMatID, testBoardOpenedDormant()); err != nil {\n572|\t\tt.Fatalf(\"UpdateTaskBoard(opened) error = %v\", err)\n573|\t}\n574|\tif _, err := store.Transition(testMatID, PhaseValidating, TransitionOpts{}); err != nil {\n575|\t\tt.Fatal(err)\n576|\t}\n577|\tif _, err := store.Transition(testMatID, PhasePrepared, TransitionOpts{}); err != nil {\n578|\t\tt.Fatal(err)\n579|\t}\n580|\tif _, err := store.Transition(testMatID, PhaseCommitting, TransitionOpts{}); err != nil {\n581|\t\tt.Fatal(err)\n582|\t}\n583|\t// Finalize destroys the open token copy and records\n584|\t// dormant_finalized with cleanup pending the consumed expiry.\n585|\tboard := testBoardOpenedDormant()\n586|\tdormant := \"dormant\"\n587|\tfinalized := TaskBoardTransaction{\n588|\t\tBundleID:          board.BundleID,\n589|\t\tActivationMode:    board.ActivationMode,\n590|\t\tImportOperationID: board.ImportOperationID,\n591|\t\tOpenOperationID:   board.OpenOperationID,\n592|\t\tAdoptOperationID:  board.AdoptOperationID,\n593|\t\tResumeOperationID: board.ResumeOperationID,\n594|\t\tState:             BoardDormantFinalized,\n595|\t\tDormantManagerRef: board.DormantManagerRef,\n596|\t\tLastBridgeState:   &dormant,\n597|\t\tLastStatusAt:      board.LastStatusAt,\n598|\t\tCleanupState:      \"pending_expiry\",\n599|\t\tCleanupAfter:      board.OpenExpiresAt,\n600|\t}\n601|\tif _, err := store.UpdateTaskBoard(testMatID, finalized); err != nil {\n602|\t\tt.Fatalf(\"UpdateTaskBoard(dormant_finalized) error = %v\", err)\n603|\t}\n604|\tstagingBackup := \"/home/ivan/.local/state/ax/materializations/\" + testMatID + \"/board_staging\"\n605|\tif _, err := store.UpdateAuthority(testMatID, \"board_staging\", AuthorityState{\n606|\t\tRootPath:            testStagingRoot,\n607|\t\tCompletedSequences:  []uint64{1},\n608|\t\tObservedPriorDigest: nil,\n609|\t\tRollbackRoot:        &stagingBackup,\n610|\t\tState:               AuthorityPrepared,\n611|\t}); err != nil {\n612|\t\tt.Fatalf(\"UpdateAuthority(prepared) error = %v\", err)\n613|\t}\n614|\t// Cleanup consumes the rollback root before the committed\n615|\t// terminal state.\n616|\tif _, err := store.UpdateAuthority(testMatID, \"board_staging\", AuthorityState{\n617|\t\tRootPath:            testStagingRoot,\n618|\t\tCompletedSequences:  []uint64{1},\n619|\t\tObservedPriorDigest: nil,\n620|\t\tRollbackRoot:        nil,\n621|\t\tState:               AuthorityCommitted,\n622|\t}); err != nil {\n623|\t\tt.Fatalf(\"UpdateAuthority(committed) error = %v\", err)\n624|\t}\n625|\tcommitted, err := store.Transition(testMatID, PhaseCommitted, TransitionOpts{})\n626|\tif err != nil {\n627|\t\tt.Fatalf(\"Transition(committed) error = %v\", err)\n628|\t}\n629|\tif committed.Phase != PhaseCommitted || committed.DestinationMarkerID != nil {\n630|\t\tt.Fatalf(\"committed = %+v\", committed.Phase)\n631|\t}\n632|\tif committed.TaskBoard.State != BoardDormantFinalized || committed.TaskBoard.OpenToken != nil {\n633|\t\tt.Fatalf(\"dormant token survives commit: %+v\", committed.TaskBoard)\n634|\t}\n635|}\n636|\n637|// testBoardImportedDormant returns the imported bridge in dormant mode.\n638|func testBoardImportedDormant() TaskBoardTransaction {\n639|\tboard := testBoardImported()\n640|\tboard.ActivationMode = ModeDormantReplica\n641|\treturn board\n642|}\n643|\n644|// testBoardOpenedDormant returns the opened bridge in dormant mode.\n645|func testBoardOpenedDormant() TaskBoardTransaction {\n646|\tboard := testBoardOpened()\n647|\tboard.ActivationMode = ModeDormantReplica\n648|\treturn board\n649|}\n650|\n651|func TestLastErrorIsRedactedStructuredError(t *testing.T) {\n652|\tstore := openTestStore(t)\n653|\tmustCreate(t, store, testInputsComposite())\n654|\tif _, err := store.UpdateProvider(testMatID, testProvider()); err != nil {\n655|\t\tt.Fatal(err)\n656|\t}\n657|\tupdated, err := store.RecordError(testMatID, mustFailure(t, \"staging_incomplete\", \"destination disk full: staging partial\"))\n658|\tif err != nil {\n659|\t\tt.Fatalf(\"RecordError error = %v\", err)\n660|\t}\n661|\t// The member decodes through the axerror owner at the bound\n662|\t// version, and carries no token material anywhere in its bytes.\n663|\tdecoded, err := axerror.Decode(lastErrorVersion, updated.LastError)\n664|\tif err != nil {\n(more lines below)","final_result":true}}}
