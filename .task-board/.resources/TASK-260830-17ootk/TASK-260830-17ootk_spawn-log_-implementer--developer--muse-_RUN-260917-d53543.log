pinned heading the obligation scanner scores at zero still has\n1127|// a substantive body, so not one of them is a heading with nothing to\n1128|// discharge. The scanner is blind to them because they state their obligations\n1129|// as tables, not because the obligations are absent.\n1130|func TestUnmeasuredCoverageIsAScannerBlindSpotNotAnAbsenceOfObligation(t *testing.T) {\n1131|\tt.Parallel()\n1132|\n1133|\tdocument, err := specdoc.Load()\n1134|\tif err != nil {\n1135|\t\tt.Fatalf(\"specdoc.Load() error = %v\", err)\n1136|\t}\n1137|\tidentifiers := specpin.SectionInventoryV050()\n1138|\tif len(identifiers) != 157 {\n1139|\t\tt.Fatalf(\"pinned heading inventory = %d, want 157\", len(identifiers))\n1140|\t}\n1141|\tvar blind []string\n1142|\tfor _, identifier := range identifiers {\n1143|\t\tkey := sectionBindingKey(identifier)\n1144|\t\tinventory, err := sectionClauseInventory(document, key)\n1145|\t\tif err != nil {\n1146|\t\t\tt.Fatalf(\"sectionClauseInventory(%q) error = %v\", key, err)\n1147|\t\t}\n1148|\t\tif len(inventory) != 0 {\n1149|\t\t\tcontinue\n1150|\t\t}\n1151|\t\tblind = append(blind, identifier)\n1152|\t\tif body := sectionBodyLineCount(t, document, key); body < 8 {\n1153|\t\t\tt.Errorf(\"heading %s scores zero clauses and has only %d body lines; it may genuinely carry nothing\", identifier, body)\n1154|\t\t}\n1155|\t}\n1156|\twant := []string{\n1157|\t\t\"7.3\", \"10.8.1\", \"13.5\", \"13.12\", \"13.14.1\", \"13.14.2\", \"13.14.3\", \"13.14.4\", \"13.14.5\",\n1158|\t\t\"14.3\", \"14.6\", \"15.2\", \"16.6\", \"16.7\", \"18.2\", \"19.4\", \"appendix-a\", \"appendix-b\", \"appendix-c\",\n1159|\t}\n1160|\tsort.Strings(blind)\n1161|\tsortedWant := append([]string(nil), want...)\n1162|\tsort.Strings(sortedWant)\n1163|\tif !reflect.DeepEqual(blind, sortedWant) {\n1164|\t\tt.Fatalf(\"scanner-blind headings = %v, want %v\", blind, sortedWant)\n1165|\t}\n1166|\tif len(blind) != 19 {\n1167|\t\tt.Fatalf(\"scanner-blind headings = %d, want 19 of 157\", len(blind))\n1168|\t}\n1169|}\n1170|\n1171|// sectionBodyLineCount counts the non-blank lines the pinned document carries\n1172|// under a heading and its subheadings.\n1173|func sectionBodyLineCount(t *testing.T, document *specdoc.Document, key string) int {\n1174|\tt.Helper()\n1175|\tidentifier, err := sectionDocumentIdentifier(key)\n1176|\tif err != nil {\n1177|\t\tt.Fatalf(\"sectionDocumentIdentifier(%q) error = %v\", key, err)\n1178|\t}\n1179|\tprefix := identifier + \".\"\n(more lines below)","final_result":true}}}
