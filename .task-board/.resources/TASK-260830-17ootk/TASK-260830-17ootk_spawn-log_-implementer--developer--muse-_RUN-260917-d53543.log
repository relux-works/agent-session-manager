{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9e3","stream":{"kind":"session","id":"01a0ae2b-f4bb-7310-a5c5-e45123d43dca"},"sequence":844,"recorded_at":1780531400001683,"record_type":"event","durability":"durable","causation_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","run_stream":{"kind":"run","id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3"},"task_stream":{"kind":"task","id":"01a0ae2f-f89b-70a1-8f8d-606f592467ac"},"task_id":"01a0ae2f-f89b-70a1-8f8d-606f592467ac","event":{"kind":"output","task_id":"01a0ae2f-f89b-70a1-8f8d-606f592467ac","chunk":"Read text file `internal/sessckpt/capture_test.go`.\n1|package sessckpt\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"path/filepath\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/sessquery\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n13|)\n14|\n15|// Fixed identities shared by every fixture. UUIDv7 grammar carries\n16|// the version nibble; the lease tokens are UUIDv4.\n17|const (\n18|\ttestSessionID = \"0198f4c8-3e70-7a11-8a2b-1234567890ab\"\n19|\ttestHostA     = \"0198f4c8-4a10-7b22-8b3c-1234567890ab\"\n20|\ttestHostB     = \"0198f4c8-4a10-7b22-8b3c-1234567890ac\"\n21|\ttestLease     = \"aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee\"\n22|\ttestLeaseB    = \"bbbbbbbb-cccc-4ddd-8eee-ffffffffffff\"\n23|\ttestOpA       = \"0198f4c8-0a10-71aa-8111-1234567890ab\"\n24|\ttestOpB       = \"0198f4c8-0a20-72bb-8222-1234567890ab\"\n25|\ttestCreatedAt = \"2026-08-19T04:09:30.000Z\"\n26|)\n27|\n28|// Fixed manifest legs. Well-formed digests the capture entry never\n29|// resolves: resolution belongs to the manifest owners, not to the\n30|// checkpoint closure.\n31|const (\n32|\ttestWorkspaceManifest = \"sha256:a98ca90522b4de30e4aaaf9bf50529d09e15a817ffa67f94552fb313d1a1ad2e\"\n33|\ttestProviderManifest  = \"sha256:1e817955dcc529e282ab31f91c99561d03b3c5642282d2e0a0e05b0f60dd0f91\"\n34|\ttestBoardBundle       = \"sha256:0af7b44e7063375a0f06e546fd820438c72607f191c14be78d35c8ffa109844f\"\n35|\ttestOtherManifest     = \"sha256:2222222222222222222222222222222222222222222222222222222222222222\"\n36|)\n37|\n38|// specCheckpointExample is the verbatim SPEC Section 5.4 normative\n39|// example.\n40|const specCheckpointExample = `{\n41|  \"schema\": \"urn:ax:schema:checkpoint\",\n42|  \"schema_version\": \"1.0.0\",\n43|  \"checkpoint_id\": \"sha256:e051996f51f13ace4f5cdebe1e30fd26fd5fe104cfd6e6a7f9f1206ba3819656\",\n44|  \"subject_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\",\n45|  \"session_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\",\n46|  \"lease_epoch\": 4,\n47|  \"lease_id\": \"aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee\",\n48|  \"safe_boundary\": {\n49|    \"provider_id\": \"codex\",\n50|    \"provider_version\": \"0.147.0\",\n51|    \"evidence\": \"accepted_test\",\n52|    \"input_blocked\": true,\n53|    \"foreground_idle\": true,\n54|    \"background_idle\": true,\n55|    \"open_processes\": 0,\n56|    \"open_database_handles\": 0\n57|  },\n58|  \"event_heads\": [\n59|    \"sha256:7777777777777777777777777777777777777777777777777777777777777777\"\n60|  ],\n61|  \"workspace_manifest_id\": \"sha256:a98ca90522b4de30e4aaaf9bf50529d09e15a817ffa67f94552fb313d1a1ad2e\",\n62|  \"provider_manifest_id\": \"sha256:1e817955dcc529e282ab31f91c99561d03b3c5642282d2e0a0e05b0f60dd0f91\",\n63|  \"task_board_bundle_id\": null,\n64|  \"created_by_host_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890ab\",\n65|  \"created_at\": \"2026-08-19T04:09:30.000Z\",\n66|  \"status\": \"validated\",\n67|  \"extensions\": {}\n68|}`\n69|\n70|// specSessionRecord is the Section 5.1 fixture shape with the test\n71|// session identity, identified through the canonical owner.\n72|const specSessionRecord = `{\n73|  \"schema\": \"urn:ax:schema:session-record\",\n74|  \"schema_version\": \"1.0.0\",\n75|  \"record_id\": \"sha256:d61701066a7f5dd37bf35fea0e85e7f154251355ad24a49976532d7f79ddc772\",\n76|  \"subject_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\",\n77|  \"session_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\",\n78|  \"name\": \"payments-api\",\n79|  \"kind\": \"direct\",\n80|  \"created_at\": \"2026-08-19T04:00:00.000Z\",\n81|  \"created_by_host_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890ab\",\n82|  \"provider_id\": \"codex\",\n83|  \"workspace_group_id\": \"0198f4c8-5b20-7c33-8c4d-1234567890ab\",\n84|  \"execution_profile\": \"yolo\",\n85|  \"launch_plan\": {\n86|    \"argv\": [\"codex\"],\n87|    \"cwd_workspace_id\": \"0198f4c8-6c30-7d44-8d5e-1234567890ab\",\n88|    \"cwd_relative\": \"src\",\n89|    \"env_names\": [\"OPENAI_API_KEY\"],\n90|    \"env_literals\": {},\n91|    \"contains_secrets\": false,\n92|    \"extensions\": {}\n93|  },\n94|  \"task_board\": null,\n95|  \"fork_provenance\": null,\n96|  \"extensions\": {}\n97|}`\n98|\n99|// identify stamps the omit-self digest through the canonical owner.\n100|// A fixture failure surfaces here, never as a production admission.\n101|func identify(t *testing.T, value map[string]any, field string) []byte {\n102|\tt.Helper()\n103|\tvalue[field] = zeroDigest\n104|\traw, err := json.Marshal(value)\n105|\tif err != nil {\n106|\t\tt.Fatal(err)\n107|\t}\n108|\tdigest, _, err := canonicaljson.CalculateObjectIdentity(raw)\n109|\tif err != nil {\n110|\t\tt.Fatal(err)\n111|\t}\n112|\tvalue[field] = digest.String()\n113|\traw, err = json.Marshal(value)\n114|\tif err != nil {\n115|\t\tt.Fatal(err)\n116|\t}\n117|\treturn raw\n118|}\n119|\n120|func decodeObject(t *testing.T, raw string) map[string]any {\n121|\tt.Helper()\n122|\tvar value map[string]any\n123|\tif err := json.Unmarshal([]byte(raw), &value); err != nil {\n124|\t\tt.Fatal(err)\n125|\t}\n126|\treturn value\n127|}\n128|\n129|// testBoundary returns the all-quiescent terminal evidence leg.\n130|func testBoundary() SafeBoundary {\n131|\treturn SafeBoundary{\n132|\t\tProviderID:          \"codex\",\n133|\t\tProviderVersion:     \"0.147.0\",\n134|\t\tEvidence:            EvidenceAcceptedTest,\n135|\t\tInputBlocked:        true,\n136|\t\tForegroundIdle:      true,\n137|\t\tBackgroundIdle:      true,\n138|\t\tOpenProcesses:       0,\n139|\t\tOpenDatabaseHandles: 0,\n140|\t}\n141|}\n142|\n143|// testInputs returns the direct-kind closure over the given heads\n144|// and operation.\n145|func testInputs(heads []string, operation string) Inputs {\n146|\treturn Inputs{\n147|\t\tOperationID:         operation,\n148|\t\tSessionID:           testSessionID,\n149|\t\tSessionKind:         SessionKindDirect,\n150|\t\tLeaseEpoch:          1,\n151|\t\tLeaseID:             testLease,\n152|\t\tCreatorHostID:       testHostA,\n153|\t\tWorkspaceManifestID: testWorkspaceManifest,\n154|\t\tProviderManifestID:  testProviderManifest,\n155|\t\tTaskBoardBundleID:   \"\",\n156|\t\tBoundary:            testBoundary(),\n157|\t\tEventHeads:          heads,\n158|\t\tCreatedAt:           testCreatedAt,\n159|\t\tExtensions:          map[string]string{},\n160|\t}\n161|}\n162|\n163|// openTestStore binds an empty checkpoint store in a temp dir.\n164|func openTestStore(t *testing.T) *Store {\n165|\tt.Helper()\n166|\tstore, err := Open(t.TempDir())\n167|\tif err != nil {\n168|\t\tt.Fatal(err)\n169|\t}\n170|\treturn store\n171|}\n172|\n173|// chainFixture persists a session with its bootstrap event and\n174|// returns the repository with the created event digest.\n175|func chainFixture(t *testing.T) (*sessrepo.Repository, string) {\n176|\tt.Helper()\n177|\trepo, err := sessrepo.Open(t.TempDir())\n178|\tif err != nil {\n179|\t\tt.Fatal(err)\n180|\t}\n181|\trecord := decodeObject(t, specSessionRecord)\n182|\trecord[\"session_id\"], record[\"subject_id\"], record[\"name\"] = testSessionID, testSessionID, \"alpha\"\n183|\tref, err := repo.CreateSession(identify(t, record, \"record_id\"))\n184|\tif err != nil {\n185|\t\tt.Fatal(err)\n186|\t}\n187|\tcreated := appendChainEvent(t, repo, \"session.created\", 1, testLease, 1, ref.RecordID, map[string]any{\n188|\t\t\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": testHostA, \"first_checkpoint_operation_id\": testHostB,\n189|\t})\n190|\treturn repo, created\n191|}\n192|\n193|// appendChainEvent chains one session event under an explicit\n194|// envelope lease and returns its digest.\n195|func appendChainEvent(t *testing.T, repo *sessrepo.Repository, typ string, epoch uint64, leaseID string, sequence int, predecessor string, payload map[string]any) string {\n196|\tt.Helper()\n197|\tvalue := map[string]any{\n198|\t\t\"schema\": \"urn:ax:schema:session-event\", \"schema_version\": \"1.0.0\", \"event_id\": zeroDigest,\n199|\t\t\"subject_id\": testSessionID, \"session_id\": testSessionID, \"event_type\": typ, \"created_by_host_id\": testHostA,\n200|\t\t\"lease_epoch\": epoch, \"lease_id\": leaseID, \"lease_sequence\": sequence, \"predecessors\": []string{predecessor},\n201|\t\t\"created_at\": \"2026-08-19T04:00:00.000Z\", \"payload\": payload, \"extensions\": map[string]any{},\n202|\t}\n203|\tref, err := repo.AppendEvent(testSessionID, identify(t, value, \"event_id\"))\n204|\tif err != nil {\n205|\t\tt.Fatal(err)\n206|\t}\n207|\treturn ref.EventID\n208|}\n209|\n210|// leaseRecordBytes builds one epoch-1 lease naming the given\n211|// checkpoint, identified through the canonical owner.\n212|func leaseRecordBytes(t *testing.T, leaseID, holder, checkpoint string) []byte {\n213|\tt.Helper()\n214|\tvalue := map[string]any{\n215|\t\t\"schema\": \"urn:ax:schema:lease\", \"schema_version\": \"1.0.0\", \"record_id\": zeroDigest,\n216|\t\t\"subject_id\": testSessionID, \"session_id\": testSessionID, \"lease_id\": leaseID, \"epoch\": float64(1),\n217|\t\t\"holder_host_id\": holder, \"predecessor_lease_id\": nil, \"reason\": \"recovery\",\n218|\t\t\"checkpoint_id\": checkpoint, \"issued_by_host_id\": holder, \"created_by_host_id\": holder,\n219|\t\t\"created_at\": \"2026-08-19T04:09:00.000Z\", \"extensions\": map[string]any{},\n220|\t}\n221|\treturn identify(t, value, \"record_id\")\n222|}\n223|\n224|// mustCapture captures through the production entry or fails.\n225|func mustCapture(t *testing.T, store *Store, chain *sessrepo.Repository, inputs Inputs) (CheckpointRef, []byte) {\n226|\tt.Helper()\n227|\tref, raw, err := store.Capture(chain, inputs)\n228|\tif err != nil {\n229|\t\tt.Fatalf(\"Capture error = %v\", err)\n230|\t}\n231|\treturn ref, raw\n232|}\n233|\n234|// mustInvalid asserts the incompatible_schema refusal class on\n235|// both layers: the package sentinel and the owner sentinel the\n236|// SPEC CP-N1..CP-N4 language requires.\n237|func mustInvalid(t *testing.T, err error, what string) {\n238|\tt.Helper()\n239|\tif err == nil {\n240|\t\tt.Fatalf(\"%s error = nil, want invalid checkpoint closure\", what)\n241|\t}\n242|\tif !errors.Is(err, ErrInvalidCheckpoint) {\n243|\t\tt.Fatalf(\"%s error = %v, want ErrInvalidCheckpoint\", what, err)\n244|\t}\n245|\tif !errors.Is(err, canonicaljson.ErrInvalidIdentity) {\n246|\t\tt.Fatalf(\"%s error = %v, want incompatible_schema (ErrInvalidIdentity)\", what, err)\n247|\t}\n248|}\n249|\n250|func TestCaptureDirectInstallsAttestedRecord(t *testing.T) {\n(more lines below)","final_result":true}}}
