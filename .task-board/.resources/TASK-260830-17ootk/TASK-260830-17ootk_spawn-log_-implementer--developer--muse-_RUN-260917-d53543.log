{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c639","stream":{"kind":"session","id":"01a0ae2b-f4bb-7310-a5c5-e45123d43dca"},"sequence":375,"recorded_at":1780531400000745,"record_type":"event","durability":"durable","causation_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","run_stream":{"kind":"run","id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3"},"task_stream":{"kind":"task","id":"01a0ae2d-3e81-7250-940c-e5be99a7158a"},"task_id":"01a0ae2d-3e81-7250-940c-e5be99a7158a","event":{"kind":"output","task_id":"01a0ae2d-3e81-7250-940c-e5be99a7158a","chunk":"Read text file `internal/matjournal/crash_unix_test.go`.\n1|//go:build darwin || linux\n2|\n3|package matjournal\n4|\n5|import (\n6|\t\"context\"\n7|\t\"errors\"\n8|\t\"os\"\n9|\t\"os/exec\"\n10|\t\"syscall\"\n11|\t\"testing\"\n12|\t\"time\"\n13|)\n14|\n15|// Real process-termination evidence for the CR-MAT-02 boundary: the\n16|// child runs the genuine production Create entry and SIGKILLs itself\n17|// between the journal install and the prepare receipt. The parent then\n18|// proves the interrupted prepare left one complete journal with no\n19|// receipt behind, and the identical retry converges with its receipt\n20|// and a safe_retry classification.\n21|//\n22|// The child rebuilds nothing: it opens the parent's data directory\n23|// from the environment, so its closure inputs are byte-identical to\n24|// the parent's retry by construction.\n25|const (\n26|\tcrashChildEnv   = \"AX_MATJOURNAL_CRASH_CHILD\"\n27|\tcrashChildStore = \"AX_MATJOURNAL_CRASH_STORE\"\n28|)\n29|\n30|func TestCreateCrashChildSelfTerminates(t *testing.T) {\n31|\tif os.Getenv(crashChildEnv) == \"1\" {\n32|\t\tcreateCrashChild()\n33|\t\treturn\n34|\t}\n35|\tstoreDir := t.TempDir()\n36|\tif _, err := Open(storeDir); err != nil {\n37|\t\tt.Fatal(err)\n38|\t}\n39|\t// A bounded context keeps a hung child a test failure,\n40|\t// never a hung suite: the child must die at the boundary or\n41|\t// not return at all.\n42|\tctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)\n43|\tdefer cancel()\n44|\tchild := exec.CommandContext(ctx, os.Args[0],\n45|\t\t\"-test.run=^TestCreateCrashChildSelfTerminates$\",\n46|\t\t\"-test.count=1\",\n47|\t)\n48|\tchild.Env = append(os.Environ(),\n49|\t\tcrashChildEnv+\"=1\",\n50|\t\tcrashChildStore+\"=\"+storeDir,\n51|\t)\n52|\trunErr := child.Run()\n53|\tvar exitErr *exec.ExitError\n54|\tif !errors.As(runErr, &exitErr) {\n55|\t\tt.Fatalf(\"child run = %v, want a signal-kill exit\", runErr)\n56|\t}\n57|\tstatus, ok := exitErr.Sys().(syscall.WaitStatus)\n58|\tif !ok || !status.Signaled() || status.Signal() != syscall.SIGKILL {\n59|\t\tt.Fatalf(\"child status = %v, want killed by SIGKILL\", exitErr)\n60|\t}\n61|\t// The kill landed between the journal and the receipt: one\n62|\t// complete journal that verifies, no receipt, no partial bytes.\n63|\tparent, err := Open(storeDir)\n64|\tif err != nil {\n65|\t\tt.Fatal(err)\n66|\t}\n67|\tparent.Now = fixedClock\n68|\tif journal, receipt := journalFilesExist(t, parent); !journal || receipt {\n69|\t\tt.Fatalf(\"after SIGKILL: journal = %v, receipt = %v, want true, false\", journal, receipt)\n70|\t}\n71|\tloaded, _, err := parent.Get(testMatID)\n72|\tif err != nil {\n73|\t\tt.Fatalf(\"Get after SIGKILL error = %v\", err)\n74|\t}\n75|\tif loaded.Phase != PhaseStaging {\n76|\t\tt.Fatalf(\"phase = %q\", loaded.Phase)\n77|\t}\n78|\t// The identical retry converges on the recorded journal with\n79|\t// its receipt: the interrupted prepare is resumed, not\n80|\t// duplicated. Recovery then classifies safe_retry.\n81|\tref, _ := mustCreate(t, parent, testInputsComposite())\n82|\tif ref.PrepareOperationID != testPrepareOp {\n83|\t\tt.Fatalf(\"retry PrepareOperationID = %q\", ref.PrepareOperationID)\n84|\t}\n85|\tif journal, receipt := journalFilesExist(t, parent); !journal || !receipt {\n86|\t\tt.Fatalf(\"after retry: journal = %v, receipt = %v, want true, true\", journal, receipt)\n87|\t}\n88|\tinput := baseRecoveryInput()\n89|\tinput.Boundary = BoundaryAfterPrepare\n90|\toutcome, _, err := parent.Recover(testMatID, input)\n91|\tif err != nil {\n92|\t\tt.Fatalf(\"Recover error = %v\", err)\n93|\t}\n94|\tmustOutcome(t, outcome, OutcomeSafeRetry, \"Recover(CR-MAT-02 SIGKILL)\")\n95|}\n96|\n97|// createCrashChild runs the production Create entry and kills its own\n98|// process at the AfterJournal boundary. It never returns.\n99|func createCrashChild() {\n100|\tstore, err := Open(os.Getenv(crashChildStore))\n101|\tif err != nil {\n102|\t\tos.Exit(66)\n103|\t}\n104|\tstore.AfterJournal = func() error {\n105|\t\t_ = syscall.Kill(syscall.Getpid(), syscall.SIGKILL)\n106|\t\t// The kill is asynchronous under instrumentation: block\n107|\t\t// here so a delivered SIGKILL always wins the race\n108|\t\t// against process exit. If the kill failed, the parent\n109|\t\t// context times out and fails the test instead of\n110|\t\t// passing on a wrong exit.\n111|\t\tselect {}\n112|\t}\n113|\t_, _, _ = store.Create(testInputsComposite())\n114|\t// The hook must have fired: reaching here means the boundary\n115|\t// was skipped, so fail the parent with a clean exit.\n116|\tos.Exit(0)\n117|}","final_result":true}}}
