{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cf01","stream":{"kind":"session","id":"01a0ae2b-f4bb-7310-a5c5-e45123d43dca"},"sequence":1499,"recorded_at":1780531400002993,"record_type":"event","durability":"durable","causation_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","run_stream":{"kind":"run","id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3"},"call_id":"call_01a0ae3a9976749ca7d49c0aa229e6d5","text":"Read text file `internal/matjournal/recover.go`.\n(587 line(s) above)\n588|// bridgeEffectUncertain reports whether an unknown bridge probe leaves\n589|// a possibly executed effect unreconciled: an adopted manager may have\n590|// acted, a recorded import or open may have advanced once the journal\n591|// reached prepared, or an import may have executed unrecorded from\n592|// CR-MAT-05 on. Recorded dormant, rolled-back, and failed states stand\n593|// on their own.\n594|func (assessment *recoveryAssessment) bridgeEffectUncertain() bool {\n595|\tjournal := assessment.journal\n596|\tstate := journal.TaskBoard.State\n597|\tswitch state {\n598|\tcase BoardAdopted, BoardResumed:\n599|\t\treturn true\n600|\tcase BoardImported, BoardOpened:\n601|\t\treturn journal.Phase == PhasePrepared || journal.Phase == PhaseCommitting ||\n602|\t\t\tjournal.Phase == PhaseRollingBack\n603|\tcase BoardNotStarted:\n604|\t\treturn boundaryAtOrAfter(assessment.input.Boundary, BoundaryAfterPrepareOp)\n605|\tdefault:\n606|\t\treturn false\n607|\t}\n608|}\n609|\n610|// boundaryAtOrAfter orders the CR-MAT registry: boundaries sort\n611|// lexicographically from CR-MAT-01 to CR-MAT-08.\n612|func boundaryAtOrAfter(boundary, floor string) bool {\n613|\treturn boundary >= floor\n614|}\n615|\n616|// rollbackRequired decides whether the durable facts plus probes\n617|// require the allowed abort: bridge failure or token expiry before\n618|// activation, a provider that rolled back underneath a prepared\n619|// journal, and the rolling_back retry/close rules.\n620|func (assessment *recoveryAssessment) rollbackRequired() (bool, axerror.Code, string, string) {\n621|\tjournal := assessment.journal\n622|\tinput := assessment.input\n623|\tpreActivation := true\n624|\tif journal.TaskBoard != nil && (journal.TaskBoard.State == BoardAdopted || journal.TaskBoard.State == BoardResumed) {\n625|\t\tpreActivation = false\n626|\t}\n627|\tif journal.Provider != nil && journal.Provider.State == ProviderCommitted {\n628|\t\tpreActivation = false\n629|\t}\n630|\tif journal.TaskBoard != nil && preActivation && !input.Bridge.LeaseActive &&\n631|\t\t(input.Bridge.Failed || input.Bridge.TokenExpired) {\n632|\t\tif input.Bridge.TokenExpired {\n633|\t\t\treturn true, \"staging_incomplete\", \"bridge token expired before lease activation: rolling back the dormant import\",\n634|\t\t\t\t\"re-run prepare from the same checkpoint with fresh operation IDs after the rollback\"\n635|\t\t}\n636|\t\treturn true, \"task_board_bridge_unavailable\", \"bridge import, open, or adopt failed before the new lease: rolling back the dormant import\",\n637|\t\t\t\"retry the same operation after the rollback, or inspect the bridge failure\"\n638|\t}\n639|\tif journal.Provider != nil && journal.Phase == PhasePrepared &&\n640|\t\tinput.Provider.State == ProviderRolledBack && preActivation {\n641|\t\treturn true, \"rollback_failed\", \"provider rolled back underneath a prepared journal: converging the journal\",\n642|\t\t\t\"inspect the provider rollback, then retry the same operation from the recorded checkpoint\"\n643|\t}\n644|\tif journal.Phase == PhaseRollingBack && input.Provider.State == ProviderPrepared && journal.Provider != nil {\n645|\t\treturn true, \"operation_uncertain\", \"journal is rolling_back with the provider still prepared: retrying the rollback\",\n646|\t\t\t\"no operator action: the rollback retries under the same IDs\"\n647|\t}\n648|\treturn false, \"\", \"\", \"\"\n649|}\n650|\n651|// tryComplete applies provable terminal completions: a committing\n652|// journal with committed provider status plus the exact destination\n653|// marker commits; a dormant finalize closes; a rolling_back journal\n654|// with rolled_back status plus restored predecessors closes. It\n655|// reports done=false when nothing completes.\n656|func (assessment *recoveryAssessment) tryComplete() (bool, Outcome, Evidence, error) {\n657|\tjournal := assessment.journal\n658|\tinput := assessment.input\n659|\tif journal.Phase == PhaseCommitting {\n660|\t\tprovable, contradictory := assessment.commitProvable()\n661|\t\tif contradictory {\n662|\t\t\toutcome, evidence, err := assessment.park(\"integrity_failure\", \"destination marker evidence contradicts the valid-match probe\",\n663|\t\t\t\t\"reconcile the marker bytes against the journal and plan, then re-run recovery\")\n664|\t\t\treturn true, outcome, evidence, err\n665|\t\t}\n666|\t\tif provable {\n667|\t\t\tif journal.TaskBoard != nil && journal.TaskBoard.State == BoardOpened &&\n668|\t\t\t\tjournal.TaskBoard.ActivationMode == ModeDormantReplica && assessment.dormantProvable() {\n669|\t\t\t\tif err := assessment.applyDormantFinalize(); err != nil {\n670|\t\t\t\t\treturn true, \"\", Evidence{}, err\n671|\t\t\t\t}\n672|\t\t\t}\n673|\t\t\tif err := assessment.applyCommit(); err != nil {\n674|\t\t\t\treturn true, \"\", Evidence{}, err\n675|\t\t\t}\n676|\t\t\toutcome, evidence, err := assessment.completeSafeRetry(\"committing journal completed to committed on exact status plus destination evidence\")\n677|\t\t\treturn true, outcome, evidence, err\n678|\t\t}\n679|\t\tif assessment.commitConverged() && journal.ManagedReplicaID != nil {\n680|\t\t\toutcome, evidence, err := assessment.park(\"operation_uncertain\", \"committing journal converged but the exact destination marker is unproven\",\n681|\t\t\t\t\"revalidate every plan authority, predecessor, installed manifest byte, and transaction, then re-run recovery with the marker evidence\")\n682|\t\t\treturn true, outcome, evidence, err\n683|\t\t}\n684|\t}\n685|\tif journal.Phase == PhaseRollingBack && input.Provider.State == ProviderRolledBack {\n686|\t\tif journal.Provider == nil {\n687|\t\t\treturn false, \"\", Evidence{}, nil\n688|\t\t}\n689|\t\tif !input.PredecessorsRestored && !input.StagingRemoved {\n690|\t\t\toutcome, evidence, err := assessment.park(\"operation_uncertain\", \"provider rolled back but predecessor restoration is unproven\",\n691|\t\t\t\t\"verify predecessor restoration or inert staging removal, then re-run recovery\")\n692|\t\t\treturn true, outcome, evidence, err\n693|\t\t}\n694|\t\tfailure, err := rollbackFailure(\"operation_uncertain\", \"rollback response lost; provider rolled back and predecessors verified\", journal.PrepareOperationID)\n695|\t\tif err != nil {\n696|\t\t\treturn true, \"\", Evidence{}, err\n697|\t\t}\n698|\t\tframed, err := failure.MarshalJSON()\n699|\t\tif err != nil {\n700|\t\t\treturn true, \"\", Evidence{}, err\n701|\t\t}\n702|\t\trolled, err := assessment.store.rollbackLocked(journal.MaterializationID, framed)\n703|\t\tif err != nil {\n704|\t\t\treturn true, \"\", Evidence{}, err\n705|\t\t}\n706|\t\tassessment.journal = &rolled\n707|\t\toutcome, evidence, err := assessment.completeRollback(\"rolling_back journal closed to rolled_back on rolled_back status plus verified restoration\",\n708|\t\t\t\"no operator action: the terminal rollback is durable and visible\")\n709|\t\treturn true, outcome, evidence, err\n710|\t}\n711|\treturn false, \"\", Evidence{}, nil\n712|}\n713|\n714|// commitProvable reports whether the committing journal may complete:\n715|// every participating transaction converged and the destination\n716|// evidence is exact (a validated binding marker for workspace\n717|// transactions). Contradictory marker evidence (a valid-match probe\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
