{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000de3f","stream":{"kind":"session","id":"01a0ae2b-f4bb-7310-a5c5-e45123d43dca"},"sequence":3450,"recorded_at":1780531400006895,"record_type":"event","durability":"durable","causation_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3","run_stream":{"kind":"run","id":"f3ccc2af-522d-4b28-99ba-3a506c9bdcb3"},"task_stream":{"kind":"task","id":"01a0ae52-7c48-7641-af7a-ec39c587721e"},"task_id":"01a0ae52-7c48-7641-af7a-ec39c587721e","event":{"kind":"output","task_id":"01a0ae52-7c48-7641-af7a-ec39c587721e","chunk":"Read text file `internal/traceability/cmd/tracecheck/main_test.go`.\n1|package main\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"io\"\n8|\t\"os\"\n9|\t\"os/exec\"\n10|\t\"path/filepath\"\n11|\t\"strings\"\n12|\t\"testing\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/traceability\"\n15|)\n16|\n17|func TestRunReportsExactCoverageAndFailsClosed(t *testing.T) {\n18|\tt.Parallel()\n19|\n20|\trepositoryRoot := filepath.Join(\"..\", \"..\", \"..\", \"..\")\n21|\tvar output bytes.Buffer\n22|\tif err := run([]string{\"-root\", repositoryRoot}, &output); err != nil {\n23|\t\tt.Fatalf(\"run() error = %v\", err)\n24|\t}\n25|\twant := \"traceability ok: contracts=63 normative_sections=36 acceptance_cases=105 fixtures=32 compatibility_contracts=55 assigned_scopes=0\\n\" +\n26|\t\t\"section coverage: bindings=59 full=1 partial=3 sliver=1 unevidenced=50 unmeasured=4 unowned=12 clauses_discharged=17/489\\n\"\n27|\tif output.String() != want {\n28|\t\tt.Fatalf(\"run() output = %q, want %q\", output.String(), want)\n29|\t}\n30|\n31|\toutput.Reset()\n32|\terr := run([]string{\"-root\", t.TempDir()}, &output)\n33|\tif err == nil || !strings.Contains(err.Error(), \"read required evidence\") {\n34|\t\tt.Fatalf(\"run(missing repository) error = %v, want required-evidence refusal\", err)\n35|\t}\n36|\tif output.Len() != 0 {\n37|\t\tt.Fatalf(\"failed run emitted success output %q\", output.String())\n38|\t}\n39|\n40|\tif err := run([]string{\"unexpected\"}, &output); err == nil {\n41|\t\tt.Fatal(\"run(positional argument) error = nil, want refusal\")\n42|\t}\n43|\tif err := run([]string{\"-unknown\"}, io.Discard); err == nil {\n44|\t\tt.Fatal(\"run(unknown flag) error = nil, want refusal\")\n45|\t}\n46|\n47|\twriteErr := errors.New(\"write failed\")\n48|\terr = run([]string{\"-root\", repositoryRoot}, failingWriter{err: writeErr})\n49|\tif !errors.Is(err, writeErr) {\n50|\t\tt.Fatalf(\"run(failing writer) error = %v, want %v\", err, writeErr)\n51|\t}\n52|\n53|\toutput.Reset()\n54|\terr = run([]string{\"-root\", repositoryRoot, \"-section\", \"6.2\"}, &output)\n55|\tif err != nil {\n56|\t\tt.Fatalf(\"run(assigned sections) error = %v\", err)\n57|\t}\n58|\twant = \"traceability ok: contracts=63 normative_sections=36 acceptance_cases=105 fixtures=32 compatibility_contracts=55 assigned_scopes=1\\n\" +\n59|\t\t\"section coverage: bindings=59 full=1 partial=3 sliver=1 unevidenced=50 unmeasured=4 unowned=12 clauses_discharged=17/489\\n\"\n60|\tif output.String() != want {\n61|\t\tt.Fatalf(\"run(assigned sections) output = %q, want %q\", output.String(), want)\n62|\t}\n63|\n64|\t// This invocation used to exit 0. Section 13.14.5 was admitted because the\n65|\t// obligation scanner measured zero clauses under it, which the gate read as\n66|\t// \"carries no obligation\". It reads as \"cannot be measured\" now, and the\n67|\t// command refuses the whole scope and emits no success line.\n68|\toutput.Reset()\n69|\terr = run([]string{\"-root\", repositoryRoot, \"-section\", \"6.2\", \"-section\", \"13.14.5\"}, &output)\n70|\tif err == nil || !errors.Is(err, traceability.ErrTraceability) ||\n71|\t\t!strings.Contains(err.Error(), \"discharges 0/0 normative clauses, which is unmeasured coverage\") {\n72|\t\tt.Fatalf(\"run(-section 6.2 -section 13.14.5) error = %v, want unmeasured refusal\", err)\n73|\t}\n74|\tif output.Len() != 0 {\n75|\t\tt.Fatalf(\"refused run emitted success output %q\", output.String())\n76|\t}\n77|}\n78|\n79|// TestRunAdmitsOnlyAssignedSectionsWhoseBindingDischargesTheWholeSection is the\n80|// admitted arm of the coverage gate at the command entry point. Section 6.2\n81|// discharges the one normative clause its pinned section carries. It is the\n82|// only section in the shipped registry the command admits.\n83|//\n84|// Section 13.14.5 was admitted here too, on the ground that its pinned section\n85|// \"carries none of its own\". That was an artefact of the obligation scanner\n86|// matching uppercase keywords only, not a fact about the section, so the\n87|// assertion moved to TestRunRefusesEveryAssignedSectionThatOnlySlivers with its\n88|// measured 0/0 ratio rather than being deleted.\n89|func TestRunAdmitsOnlyAssignedSectionsWhoseBindingDischargesTheWholeSection(t *testing.T) {\n90|\tt.Parallel()\n91|\n92|\trepositoryRoot := filepath.Join(\"..\", \"..\", \"..\", \"..\")\n93|\tfor _, section := range []string{\"6.2\"} {\n94|\t\tvar output bytes.Buffer\n95|\t\tif err := run([]string{\"-root\", repositoryRoot, \"-section\", section}, &output); err != nil {\n96|\t\t\tt.Errorf(\"run(-section %s) error = %v\", section, err)\n97|\t\t\tcontinue\n98|\t\t}\n99|\t\tif !strings.Contains(output.String(), \"assigned_scopes=1\") {\n100|\t\t\tt.Errorf(\"run(-section %s) output = %q, want assigned_scopes=1\", section, output.String())\n101|\t\t}\n102|\t}\n103|}\n104|\n105|// TestRunRefusesEveryAssignedSectionThatOnlySlivers is the disclosure this bug\n106|// exists to produce. Every section listed here was admitted by the command\n107|// before the coverage gate, and the README documented the whole list as the\n108|// Story-scope validation command. Each binding names a real Go declaration and\n109|// an executable acceptance case, and none of them discharges the section it is\n110|// registered against, so a Story assigned one could do nothing and stay green.\n111|// The command now refuses each with the measured ratio; the expectations below\n112|// are the shipped state, so a section that becomes covered has to leave this\n113|// table deliberately.\n114|func TestRunRefusesEveryAssignedSectionThatOnlySlivers(t *testing.T) {\n115|\tt.Parallel()\n116|\n117|\trepositoryRoot := filepath.Join(\"..\", \"..\", \"..\", \"..\")\n118|\tfor _, test := range []struct {\n119|\t\tsection string\n120|\t\twant    string\n121|\t}{\n122|\t\t{\"1.6\", \"discharges 0/31 normative clauses, which is unevidenced coverage\"},\n123|\t\t{\"2.1\", \"discharges 0/1 normative clauses, which is unevidenced coverage\"},\n124|\t\t{\"2.2\", `binding \"section:2.2\" is recorded unowned:`},\n125|\t\t{\"2.3\", \"discharges 0/7 normative clauses, which is unevidenced coverage\"},\n126|\t\t{\"2.4\", \"discharges 0/4 normative clauses, which is unevidenced coverage\"},\n127|\t\t{\"3.2\", \"discharges 0/13 normative clauses, which is unevidenced coverage\"},\n128|\t\t{\"3.3\", \"discharges 0/4 normative clauses, which is unevidenced coverage\"},\n129|\t\t{\"5.1\", \"discharges 0/9 normative clauses, which is unevidenced coverage\"},\n130|\t\t{\"6.1\", \"discharges 0/2 normative clauses, which is unevidenced coverage\"},\n131|\t\t{\"6.3\", \"discharges 0/11 normative clauses, which is unevidenced coverage\"},\n132|\t\t{\"6.4\", \"discharges 0/2 normative clauses, which is unevidenced coverage\"},\n133|\t\t{\"6.5\", \"discharges 0/3 normative clauses, which is unevidenced coverage\"},\n134|\t\t{\"7.3\", \"discharges 0/0 normative clauses, which is unmeasured coverage\"},\n135|\t\t{\"7.9\", \"discharges 0/8 normative clauses, which is unevidenced coverage\"},\n136|\t\t{\"9.2\", \"discharges 0/35 normative clauses, which is unevidenced coverage\"},\n137|\t\t{\"10.1\", \"discharges 0/3 normative clauses, which is unevidenced coverage\"},\n138|\t\t{\"10.2\", \"discharges 0/5 normative clauses, which is unevidenced coverage\"},\n139|\t\t{\"10.3\", \"discharges 1/3 normative clauses, which is sliver coverage\"},\n140|\t\t{\"10.4\", \"discharges 0/25 normative clauses, which is unevidenced coverage\"},\n141|\t\t{\"13.14.5\", \"discharges 0/0 normative clauses, which is unmeasured coverage\"},\n142|\t\t{\"14.2\", \"discharges 8/9 normative clauses, which is partial coverage\"},\n143|\t\t{\"15.1\", \"discharges 5/7 normative clauses, which is partial coverage\"},\n144|\t\t{\"15.2\", \"discharges 0/0 normative clauses, which is unmeasured coverage\"},\n145|\t\t{\"15.3\", \"discharges 2/3 normative clauses, which is partial coverage\"},\n146|\t\t{\"17.1\", \"discharges 0/6 normative clauses, which is unevidenced coverage\"},\n147|\t\t{\"17.2\", \"discharges 0/1 normative clauses, which is unevidenced coverage\"},\n148|\t\t{\"17.3\", \"discharges 0/3 normative clauses, which is unevidenced coverage\"},\n149|\t\t{\"18.1\", \"discharges 0/5 normative clauses, which is unevidenced coverage\"},\n150|\t\t{\"18.4\", `binding \"section:18.4\" is recorded unowned:`},\n151|\t} {\n152|\t\tvar output bytes.Buffer\n153|\t\terr := run([]string{\"-root\", repositoryRoot, \"-section\", test.section}, &output)\n154|\t\tif err == nil || !errors.Is(err, traceability.ErrTraceability) || !strings.Contains(err.Error(), test.want) {\n155|\t\t\tt.Errorf(\"run(-section %s) error = %v, want ErrTraceability containing %q\", test.section, err, test.want)\n156|\t\t}\n157|\t\tif output.Len() != 0 {\n158|\t\t\tt.Errorf(\"run(-section %s) emitted success output %q\", test.section, output.String())\n159|\t\t}\n160|\t}\n161|}\n162|\n163|// TestMainRejectsRenamedScalarSectionOwnerDeclarations attacks each assigned\n164|// scalar binding through main -> run -> VerifyAssignedSections. Each mutant\n165|// renames the real Go declaration while leaving the reviewed registry intact.\n166|func TestMainRejectsRenamedScalarSectionOwnerDeclarations(t *testing.T) {\n167|\tif testing.Short() {\n168|\t\tt.Skip(\"builds isolated tracecheck binaries\")\n169|\t}\n170|\n171|\ttests := []struct {\n172|\t\tsection     string\n173|\t\tpath        string\n174|\t\tdeclaration string\n175|\t\tfrom        string\n176|\t\tto          string\n177|\t}{\n178|\t\t{\"1.6\", \"internal/scalar/scalar.go\", \"ErrInvalidScalar\", \"var ErrInvalidScalar\", \"var RenamedErrInvalidScalar\"},\n179|\t\t{\"2.1\", \"internal/canonicaljson/closed_shapes.go\", \"validateSessionRecordCommon\", \"func validateSessionRecordCommon(\", \"func renamedValidateSessionRecordCommon(\"},\n180|\t\t{\"2.3\", \"internal/canonicaljson/closed_shapes.go\", \"validateSessionRecordCommon\", \"func validateSessionRecordCommon(\", \"func renamedValidateSessionRecordCommon(\"},\n181|\t\t{\"2.4\", \"internal/canonicaljson/closed_shapes.go\", \"validateSessionRecordCommon\", \"func validateSessionRecordCommon(\", \"func renamedValidateSessionRecordCommon(\"},\n182|\t\t{\"3.2\", \"internal/localstore/paths.go\", \"ResolvePaths\", \"func ResolvePaths(\", \"func RenamedResolvePaths(\"},\n183|\t\t{\"3.3\", \"internal/localstore/projection.go\", \"OpenProjection\", \"func OpenProjection(\", \"func RenamedOpenProjection(\"},\n184|\t\t{\"5.1\", \"internal/canonicaljson/closed_shapes.go\", \"validateSessionRecordWithDerivation\", \"func validateSessionRecordWithDerivation(\", \"func renamedValidateSessionRecordWithDerivation(\"},\n185|\t\t{\"10.1\", \"internal/canonicaljson/closed_shapes.go\", \"validateImmutableObjectShape\", \"func validateImmutableObjectShape(\", \"func renamedValidateImmutableObjectShape(\"},\n186|\t\t{\"10.2\", \"internal/canonicaljson/closed_shapes.go\", \"validateBlobDescriptor\", \"func validateBlobDescriptor\", \"func renamedValidateBlobDescriptor\"},\n187|\t\t{\"10.3\", \"internal/canonicaljson/closed_shapes.go\", \"validateBlobDescriptor\", \"func validateBlobDescriptor\", \"func renamedValidateBlobDescriptor\"},\n188|\t\t{\"10.4\", \"internal/canonicaljson/closed_shapes.go\", \"validateTransferManifest\", \"func validateTransferManifest\", \"func renamedValidateTransferManifest\"},\n189|\t\t{\"17.3\", \"internal/canonicaljson/closed_shapes.go\", \"validateMigrationProvenance\", \"func validateMigrationProvenance\", \"func renamedValidateMigrationProvenance\"},\n190|\t}\n191|\n192|\tfor _, test := range tests {\n193|\t\tt.Run(test.section, func(t *testing.T) {\n194|\t\t\tfixtureRoot := isolatedTracecheckFixture(t)\n195|\t\t\trenameGoDeclaration(t, filepath.Join(fixtureRoot, test.path), test.from, test.to)\n196|\n197|\t\t\toutput, err := runTracecheck(t, fixtureRoot, \"-section\", test.section)\n198|\t\t\twant := `section binding \"section:` + test.section + `\" production owner: declaration \"` + test.declaration + `\" is absent`\n199|\t\t\tif test.declaration == \"OpenProjection\" {\n200|\t\t\t\twant = `acceptance case \"localstore-sqlite-projection\" production owner: declaration \"OpenProjection\" is absent`\n201|\t\t\t}\n202|\t\t\tif err == nil || !strings.Contains(output, want) || strings.Contains(output, \"traceability ok:\") {\n203|\t\t\t\tt.Fatalf(\"tracecheck -section %s error = %v output = %q, want refusal %q\", test.section, err, output, want)\n204|\t\t\t}\n205|\t\t})\n206|\t}\n207|}\n208|\n209|// TestMainRejectsRenamedCanonicalIdentityEntryPoint proves that the assigned\n210|// Section 1.6 gate reaches the production omit-self verifier through its\n211|// executable acceptance case. A registry link without the call site must not\n212|// satisfy traceability.\n213|func TestMainRejectsRenamedCanonicalIdentityEntryPoint(t *testing.T) {\n214|\tif testing.Short() {\n215|\t\tt.Skip(\"builds an isolated tracecheck binary\")\n216|\t}\n217|\n218|\tfixtureRoot := isolatedTracecheckFixture(t)\n219|\trenameGoDeclaration(\n220|\t\tt,\n221|\t\tfilepath.Join(fixtureRoot, \"internal/canonicaljson/canonical.go\"),\n222|\t\t\"func VerifyObjectIdentity\",\n223|\t\t\"func RenamedVerifyObjectIdentity\",\n224|\t)\n225|\n226|\toutput, err := runTracecheck(t, fixtureRoot, \"-section\", \"1.6\")\n227|\twant := `acceptance case \"canonical-identity-refusal\" production owner: declaration \"VerifyObjectIdentity\" is absent`\n228|\tif err == nil || !strings.Contains(output, want) || strings.Contains(output, \"traceability ok:\") {\n229|\t\tt.Fatalf(\"tracecheck -section 1.6 error = %v output = %q, want refusal %q\", err, output, want)\n230|\t}\n231|}\n232|\n233|// TestMainRejectsOneNarrowedAssignedSectionBinding drives the production\n234|// main -> run -> traceability.VerifyAssignedSections call chain in an isolated\n235|// module. It re-pins the intentionally narrowed registry so the section:9.2\n236|// refusal, rather than the existing digest gate, is what makes the test red.\n237|// The unrelated section:6.2 binding must remain executable and green.\n238|func TestMainRejectsOneNarrowedAssignedSectionBinding(t *testing.T) {\n239|\tif testing.Short() {\n240|\t\tt.Skip(\"builds an isolated tracecheck binary\")\n241|\t}\n242|\n243|\trepositoryRoot := filepath.Join(\"..\", \"..\", \"..\", \"..\")\n244|\tfixtureRoot := t.TempDir()\n245|\tcopyFile(t, filepath.Join(repositoryRoot, \"go.mod\"), filepath.Join(fixtureRoot, \"go.mod\"))\n246|\tif err := os.CopyFS(\n247|\t\tfilepath.Join(fixtureRoot, \"internal\"),\n248|\t\tos.DirFS(filepath.Join(repositoryRoot, \"internal\")),\n249|\t); err != nil {\n250|\t\tt.Fatalf(\"copy repository fixture: %v\", err)\n251|\t}\n252|\n253|\tregistryPath := filepath.Join(fixtureRoot, \"internal\", \"traceability\", \"ownership.v0.6.0.json\")\n254|\tremoveOwnershipKey(t, registryPath, \"section:9.2\")\n255|\n256|\toutput, err := runTracecheck(t, fixtureRoot, \"-section\", \"6.2\")\n257|\tif err == nil || !strings.Contains(output, \"projection digest \") {\n258|\t\tt.Fatalf(\"unrepinned narrowed tracecheck error = %v output = %q, want projection digest refusal\", err, output)\n259|\t}\n260|\trepinOwnershipDigest(t, fixtureRoot, output)\n261|\n262|\toutput, err = runTracecheck(t, fixtureRoot, \"-section\", \"9.2\")\n263|\twant := `assigned section \"9.2\" binding \"section:9.2\" has no scoped implementation owner`\n264|\tif err == nil || !strings.Contains(output, want) || strings.Contains(output, \"traceability ok:\") {\n265|\t\tt.Fatalf(\"narrowed assigned tracecheck error = %v output = %q, want refusal %q and no success output\", err, output, want)\n266|\t}\n267|\n268|\toutput, err = runTracecheck(t, fixtureRoot, \"-section\", \"6.2\")\n269|\tif err != nil || !strings.Contains(output, \"assigned_scopes=1\") {\n270|\t\tt.Fatalf(\"unrelated assigned tracecheck error = %v output = %q, want green section:6.2 binding\", err, output)\n271|\t}\n272|}\n273|\n274|// TestMainRejectsDetachedScopeSpecificAcceptanceCase drives the production\n275|// main -> run -> traceability.VerifyAssignedSections call chain after removing\n276|// only Section 9.2's executable acceptance link. Section 6.2 must stay green.\n277|func TestMainRejectsDetachedScopeSpecificAcceptanceCase(t *testing.T) {\n278|\tif testing.Short() {\n279|\t\tt.Skip(\"builds an isolated tracecheck binary\")\n280|\t}\n281|\n282|\tfixtureRoot := isolatedTracecheckFixture(t)\n283|\tregistryPath := filepath.Join(fixtureRoot, \"internal\", \"traceability\", \"ownership.v0.6.0.json\")\n284|\tremoveOwnershipAcceptanceCases(t, registryPath, \"section:9.2\")\n285|\n286|\toutput, err := runTracecheck(t, fixtureRoot, \"-section\", \"6.2\")\n287|\tif err == nil || !strings.Contains(output, \"projection digest \") {\n288|\t\tt.Fatalf(\"unrepinned detached-case tracecheck error = %v output = %q, want projection digest refusal\", err, output)\n289|\t}\n290|\trepinOwnershipDigest(t, fixtureRoot, output)\n291|\n292|\toutput, err = runTracecheck(t, fixtureRoot, \"-section\", \"9.2\")\n293|\twant := `section binding \"section:9.2\" has no scope-specific acceptance owner`\n294|\tif err == nil || !strings.Contains(output, want) || strings.Contains(output, \"traceability ok:\") {\n295|\t\tt.Fatalf(\"detached-case tracecheck error = %v output = %q, want refusal %q and no success output\", err, output, want)\n296|\t}\n297|\n298|\toutput, err = runTracecheck(t, fixtureRoot, \"-section\", \"6.2\")\n299|\tif err != nil || !strings.Contains(output, \"assigned_scopes=1\") {\n300|\t\tt.Fatalf(\"unrelated assigned tracecheck error = %v output = %q, want green section:6.2 binding\", err, output)\n301|\t}\n302|}\n303|\n304|// TestMainRejectsMissingScopeSpecificProductionDeclaration drives the\n305|// production entry point after detaching only Section 9.2 from its concrete Go\n306|// declaration. Section 6.2 must remain independently executable and green.\n307|func TestMainRejectsMissingScopeSpecificProductionDeclaration(t *testing.T) {\n308|\tif testing.Short() {\n309|\t\tt.Skip(\"builds an isolated tracecheck binary\")\n310|\t}\n311|\n312|\tfixtureRoot := isolatedTracecheckFixture(t)\n313|\tregistryPath := filepath.Join(fixtureRoot, \"internal\", \"traceability\", \"ownership.v0.6.0.json\")\n314|\treplaceOwnershipProductionDeclaration(t, registryPath, \"section:9.2\", \"MissingSectionNineTwoImplementation\")\n315|\n316|\toutput, err := runTracecheck(t, fixtureRoot, \"-section\", \"6.2\")\n317|\tif err == nil || !strings.Contains(output, \"projection digest \") {\n318|\t\tt.Fatalf(\"unrepinned missing-production tracecheck error = %v output = %q, want projection digest refusal\", err, output)\n319|\t}\n320|\trepinOwnershipDigest(t, fixtureRoot, output)\n321|\n322|\toutput, err = runTracecheck(t, fixtureRoot, \"-section\", \"9.2\")\n323|\twant := `section binding \"section:9.2\" production owner: declaration \"MissingSectionNineTwoImplementation\" is absent`\n324|\tif err == nil || !strings.Contains(output, want) || strings.Contains(output, \"traceability ok:\") {\n325|\t\tt.Fatalf(\"missing-production tracecheck error = %v output = %q, want refusal containing %q and no success output\", err, output, want)\n326|\t}\n327|\n328|\toutput, err = runTracecheck(t, fixtureRoot, \"-section\", \"6.2\")\n329|\tif err != nil || !strings.Contains(output, \"assigned_scopes=1\") {\n330|\t\tt.Fatalf(\"unrelated assigned tracecheck error = %v output = %q, want green section:6.2 binding\", err, output)\n331|\t}\n332|}\n333|\n334|// TestMainRejectsSyntacticallyValidNonexistentV060Section drives the production\n335|// main -> run -> traceability.VerifyAssignedSections call chain. A plausible\n336|// subsection must not inherit the top-level owner unless that exact identifier\n337|// exists in the immutable v0.6.0 inventory. A real but still unowned section\n338|// remains a separate refusal shape.\n339|func TestMainRejectsSyntacticallyValidNonexistentV060Section(t *testing.T) {\n340|\tif testing.Short() {\n341|\t\tt.Skip(\"launches the production tracecheck entry point\")\n342|\t}\n343|\n344|\trepositoryRoot := filepath.Join(\"..\", \"..\", \"..\", \"..\")\n345|\toutput, err := runTracecheck(t, repositoryRoot, \"-section\", \"10.999\")\n346|\twant := `assigned section \"10.999\" is not a real v0.6.0 section identifier`\n347|\tif err == nil || !strings.Contains(output, want) || strings.Contains(output, \"traceability ok:\") {\n348|\t\tt.Fatalf(\"tracecheck -section 10.999 error = %v output = %q, want refusal %q and no success output\", err, output, want)\n349|\t}\n350|\n351|\toutput, err = runTracecheck(t, repositoryRoot, \"-section\", \"10.5\")\n352|\twant = `assigned section \"10.5\" binding \"section:10.5\" has no scoped implementation owner`\n353|\tif err == nil || !strings.Contains(output, want) || strings.Contains(output, \"traceability ok:\") {\n354|\t\tt.Fatalf(\"tracecheck -section 10.5 error = %v output = %q, want refusal %q and no success output\", err, output, want)\n355|\t}\n356|}\n357|\n358|func TestRunRejectsRegisteredContractWithoutImplementationOwner(t *testing.T) {\n359|\tt.Parallel()\n360|\n361|\trepositoryRoot := filepath.Join(\"..\", \"..\", \"..\", \"..\")\n362|\tfixtureRoot := t.TempDir()\n363|\tif err := os.CopyFS(\n364|\t\tfilepath.Join(fixtureRoot, \"internal\"),\n365|\t\tos.DirFS(filepath.Join(repositoryRoot, \"internal\")),\n366|\t); err != nil {\n367|\t\tt.Fatalf(\"copy repository fixture: %v\", err)\n368|\t}\n369|\n370|\tregistryPath := filepath.Join(fixtureRoot, \"internal\", \"traceability\", \"ownership.v0.6.0.json\")\n371|\tregistry, err := os.ReadFile(registryPath)\n372|\tif err != nil {\n373|\t\tt.Fatalf(\"read ownership registry fixture: %v\", err)\n374|\t}\n375|\tconst contract = \"Session Directory Query [urn:ax:schema:session-directory-query]\"\n376|\towner := []byte(\",\\n        \\\"\" + contract + \"\\\"\")\n377|\tif count := bytes.Count(registry, owner); count != 1 {\n378|\t\tt.Fatalf(\"ownership registry contains contract owner %q %d times, want exactly once\", contract, count)\n379|\t}\n380|\tif err := os.WriteFile(registryPath, bytes.Replace(registry, owner, nil, 1), 0o644); err != nil {\n381|\t\tt.Fatalf(\"write narrowed ownership registry fixture: %v\", err)\n382|\t}\n383|\n384|\tvar output bytes.Buffer\n385|\terr = run([]string{\"-root\", fixtureRoot}, &output)\n386|\twant := \"registered contract \\\"\" + contract + \"\\\" has no implementation owner\"\n387|\tif err == nil || !errors.Is(err, traceability.ErrTraceability) || !strings.Contains(err.Error(), want) {\n388|\t\tt.Fatalf(\"run(missing contract owner) error = %v, want ErrTraceability containing %q\", err, want)\n389|\t}\n390|\tif output.Len() != 0 {\n391|\t\tt.Fatalf(\"failed ownership run emitted success output %q\", output.String())\n392|\t}\n393|}\n394|\n395|type failingWriter struct {\n396|\terr error\n397|}\n398|\n399|func copyFile(t *testing.T, source, destination string) {\n400|\tt.Helper()\n401|\tvalue, err := os.ReadFile(source)\n402|\tif err != nil {\n403|\t\tt.Fatalf(\"read %q: %v\", source, err)\n404|\t}\n405|\tif err := os.WriteFile(destination, value, 0o644); err != nil {\n406|\t\tt.Fatalf(\"write %q: %v\", destination, err)\n407|\t}\n408|}\n409|\n410|func renameGoDeclaration(t *testing.T, filename, from, to string) {\n411|\tt.Helper()\n412|\tvalue, err := os.ReadFile(filename)\n413|\tif err != nil {\n414|\t\tt.Fatalf(\"read %q: %v\", filename, err)\n415|\t}\n416|\tif count := bytes.Count(value, []byte(from)); count != 1 {\n417|\t\tt.Fatalf(\"%q contains declaration marker %q %d times, want exactly once\", filename, from, count)\n418|\t}\n419|\tvalue = bytes.Replace(value, []byte(from), []byte(to), 1)\n420|\tif err := os.WriteFile(filename, value, 0o644); err != nil {\n421|\t\tt.Fatalf(\"write %q: %v\", filename, err)\n422|\t}\n423|}\n424|\n425|func isolatedTracecheckFixture(t *testing.T) string {\n426|\tt.Helper()\n427|\trepositoryRoot := filepath.Join(\"..\", \"..\", \"..\", \"..\")\n428|\tfixtureRoot := t.TempDir()\n429|\tcopyFile(t, filepath.Join(repositoryRoot, \"go.mod\"), filepath.Join(fixtureRoot, \"go.mod\"))\n430|\tif err := os.CopyFS(filepath.Join(fixtureRoot, \"internal\"), os.DirFS(filepath.Join(repositoryRoot, \"internal\"))); err != nil {\n431|\t\tt.Fatalf(\"copy repository fixture: %v\", err)\n432|\t}\n433|\treturn fixtureRoot\n434|}\n435|\n436|func mutateOwnershipGroup(t *testing.T, filename, target string, mutate func(map[string]any)) {\n437|\tt.Helper()\n438|\tvalue, err := os.ReadFile(filename)\n439|\tif err != nil {\n440|\t\tt.Fatalf(\"read ownership registry: %v\", err)\n441|\t}\n442|\tvar document map[string]any\n443|\tif err := json.Unmarshal(value, &document); err != nil {\n444|\t\tt.Fatalf(\"decode ownership registry: %v\", err)\n445|\t}\n446|\tmatched := 0\n447|\tfor _, rawGroup := range document[\"ownership\"].([]any) {\n448|\t\tgroup := rawGroup.(map[string]any)\n449|\t\tfor _, key := range group[\"keys\"].([]any) {\n450|\t\t\tif key == target {\n451|\t\t\t\tmatched++\n452|\t\t\t\tmutate(group)\n453|\t\t\t}\n454|\t\t}\n455|\t}\n456|\tif matched != 1 {\n457|\t\tt.Fatalf(\"matched ownership key %q %d times, want exactly once\", target, matched)\n458|\t}\n459|\tvalue, err = json.MarshalIndent(document, \"\", \"  \")\n460|\tif err != nil {\n461|\t\tt.Fatalf(\"encode mutated ownership registry: %v\", err)\n462|\t}\n463|\tif err := os.WriteFile(filename, value, 0o644); err != nil {\n464|\t\tt.Fatalf(\"write mutated ownership registry: %v\", err)\n465|\t}\n466|}\n467|\n468|func removeOwnershipAcceptanceCases(t *testing.T, filename, target string) {\n469|\tt.Helper()\n470|\tmutateOwnershipGroup(t, filename, target, func(group map[string]any) {\n471|\t\tgroup[\"acceptance_cases\"] = []any{}\n472|\t})\n473|}\n474|\n475|// replaceOwnershipProductionDeclaration narrows the mutant to exactly one\n476|// thing: the binding names a Go declaration that does not exist. The gap\n477|// sentence is rewritten to name the replacement too, because a gap has to name\n478|// the declaration its binding is registered to, and leaving the old name there\n479|// would make the coverage disclosure check red instead of the production-owner\n480|// check this mutant exists to reach.\n481|func replaceOwnershipProductionDeclaration(t *testing.T, filename, target, declaration string) {\n482|\tt.Helper()\n483|\tmutateOwnershipGroup(t, filename, target, func(group map[string]any) {\n484|\t\tproduction := group[\"production\"].(map[string]any)\n485|\t\tprevious, _ := production[\"declaration\"].(string)\n486|\t\tproduction[\"declaration\"] = declaration\n487|\t\tif gap, ok := group[\"gap\"].(string); ok && previous != \"\" {\n488|\t\t\tgroup[\"gap\"] = strings.ReplaceAll(gap, previous, declaration)\n489|\t\t}\n490|\t})\n491|}\n492|\n493|func removeOwnershipKey(t *testing.T, filename, target string) {\n494|\tt.Helper()\n495|\tvalue, err := os.ReadFile(filename)\n496|\tif err != nil {\n497|\t\tt.Fatalf(\"read ownership registry: %v\", err)\n498|\t}\n499|\tvar document map[string]any\n500|\tif err := json.Unmarshal(value, &document); err != nil {\n(more lines below)","final_result":true}}}
