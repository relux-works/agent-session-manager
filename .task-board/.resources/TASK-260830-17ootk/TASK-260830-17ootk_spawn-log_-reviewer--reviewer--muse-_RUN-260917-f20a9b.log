{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8a3","stream":{"kind":"session","id":"01a0aeea-0371-7222-a2de-305ea9e57fab"},"sequence":684,"recorded_at":1780531400001363,"record_type":"event","durability":"durable","causation_id":"7588bb01-2c7e-40b5-9895-e75b02229259","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7588bb01-2c7e-40b5-9895-e75b02229259","run_stream":{"kind":"run","id":"7588bb01-2c7e-40b5-9895-e75b02229259"},"task_stream":{"kind":"task","id":"01a0aeec-6802-7653-9704-00f5b1d89503"},"task_id":"01a0aeec-6802-7653-9704-00f5b1d89503","event":{"kind":"output","task_id":"01a0aeec-6802-7653-9704-00f5b1d89503","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-2rqigd/worktree/internal/crashgate/registry_derive_test.go`.\n1|package crashgate\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"regexp\"\n6|\t\"sort\"\n7|\t\"strconv\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n12|)\n13|\n14|// rangeToken matches one Section 13.13 boundary range token such as\n15|// CR-MAT-01..08 or CR-FORCE-TB-01..04: the CR- family prefix with\n16|// its zero-padded start and end indexes.\n17|var rangeToken = regexp.MustCompile(`(CR-[A-Z-]+?)-(\\d+)\\.\\.(\\d+)`)\n18|\n19|// expandRange expands one parsed range token into its boundary IDs.\n20|// The indexes are zero-padded two-digit, as the registry writes\n21|// them.\n22|func expandRange(prefix string, start, end int) []string {\n23|\tids := make([]string, 0, end-start+1)\n24|\tfor index := start; index <= end; index++ {\n25|\t\tids = append(ids, fmt.Sprintf(\"%s-%02d\", prefix, index))\n26|\t}\n27|\treturn ids\n28|}\n29|\n30|// TestRegistryDerivesFromPinnedSpec proves the registry enumerates\n31|// exactly the Section 13.13 crash boundaries: every boundary ID is\n32|// parsed from the pinned specification text (the twelve registry\n33|// table ranges plus the CR-CLONE prose range) and compared against\n34|// the registry with no hand-typed ID on either side. A specification\n35|// revision that adds, removes, or renumbers a boundary fails here\n36|// until the registry classification is deliberately updated.\n37|func TestRegistryDerivesFromPinnedSpec(t *testing.T) {\n38|\tdocument, err := specdoc.LoadV060()\n39|\tif err != nil {\n40|\t\tt.Fatalf(\"LoadV060 error = %v (the pinned text is unreadable or digest-drifted)\", err)\n41|\t}\n42|\tvar tableIDs, proseIDs []string\n43|\tvar tableRanges, proseRanges int\n44|\tfor line := 1; line <= document.LineCount(); line++ {\n45|\t\tsection, ok := document.SectionID(line)\n46|\t\tif !ok || section != \"13.13\" {\n47|\t\t\tcontinue\n48|\t\t}\n49|\t\ttext, ok := document.Line(line)\n50|\t\tif !ok {\n51|\t\t\tt.Fatalf(\"pinned document line %d is unreadable\", line)\n52|\t\t}\n53|\t\ttrimmed := strings.TrimSpace(text)\n54|\t\tif !strings.Contains(trimmed, \"..\") {\n55|\t\t\tcontinue\n56|\t\t}\n57|\t\tfor _, match := range rangeToken.FindAllStringSubmatch(trimmed, -1) {\n58|\t\t\tstart, startErr := strconv.Atoi(match[2])\n59|\t\t\tend, endErr := strconv.Atoi(match[3])\n60|\t\t\tif startErr != nil || endErr != nil || start < 1 || end < start {\n61|\t\t\t\tt.Fatalf(\"line %d carries a malformed range token %q\", line, match[0])\n62|\t\t\t}\n63|\t\t\tif strings.HasPrefix(trimmed, \"|\") {\n64|\t\t\t\ttableRanges++\n65|\t\t\t\ttableIDs = append(tableIDs, expandRange(match[1], start, end)...)\n66|\t\t\t} else {\n67|\t\t\t\tproseRanges++\n68|\t\t\t\tproseIDs = append(proseIDs, expandRange(match[1], start, end)...)\n69|\t\t\t}\n70|\t\t}\n71|\t}\n72|\tif tableRanges == 0 {\n73|\t\tt.Fatalf(\"no registry-table range token parsed from Section 13.13\")\n74|\t}\n75|\tif proseRanges == 0 {\n76|\t\tt.Fatalf(\"no prose range token parsed from Section 13.13 (the CR-CLONE range)\")\n77|\t}\n78|\tparsed := append(append([]string{}, tableIDs...), proseIDs...)\n79|\tparsedSet := make(map[string]struct{}, len(parsed))\n80|\tfor _, id := range parsed {\n81|\t\tif _, duplicate := parsedSet[id]; duplicate {\n82|\t\t\tt.Fatalf(\"specification parses boundary %s twice\", id)\n83|\t\t}\n84|\t\tparsedSet[id] = struct{}{}\n85|\t}\n86|\tregistered := Registry()\n87|\tregisteredSet := make(map[string]struct{}, len(registered))\n88|\tfor _, boundary := range registered {\n89|\t\tif _, duplicate := registeredSet[boundary.ID]; duplicate {\n90|\t\t\tt.Fatalf(\"registry lists boundary %s twice\", boundary.ID)\n91|\t\t}\n92|\t\tregisteredSet[boundary.ID] = struct{}{}\n93|\t}\n94|\tvar missing, extra []string\n95|\tfor id := range parsedSet {\n96|\t\tif _, ok := registeredSet[id]; !ok {\n97|\t\t\tmissing = append(missing, id)\n98|\t\t}\n99|\t}\n100|\tfor id := range registeredSet {\n101|\t\tif _, ok := parsedSet[id]; !ok {\n102|\t\t\textra = append(extra, id)\n103|\t\t}\n104|\t}\n105|\tsort.Strings(missing)\n106|\tsort.Strings(extra)\n107|\tif len(missing) != 0 || len(extra) != 0 {\n108|\t\tt.Fatalf(\"registry drifts from the pinned Section 13.13 table: missing %q, extra %q\", missing, extra)\n109|\t}\n110|\tt.Logf(\"derived %d table IDs in %d ranges and %d prose IDs in %d ranges; registry matches exactly\",\n111|\t\tlen(tableIDs), tableRanges, len(proseIDs), proseRanges)\n112|}\n113|\n114|// TestRegistryStructure audits the classification shape: every\n115|// boundary carries its family prefix, a phase, a durable-write\n116|// class, and at least one path; every path names the direct or\n117|// task-board vocabulary; reachable paths name exactly a driver and\n118|// not-applicable paths name exactly an owner; every path carries\n119|// its honest note.\n120|func TestRegistryStructure(t *testing.T) {\n(more lines below)","final_result":true}}}
