{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cf9b","stream":{"kind":"session","id":"01a0aeea-0371-7222-a2de-305ea9e57fab"},"sequence":1576,"recorded_at":1780531400003147,"record_type":"event","durability":"durable","causation_id":"7588bb01-2c7e-40b5-9895-e75b02229259","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7588bb01-2c7e-40b5-9895-e75b02229259","run_stream":{"kind":"run","id":"7588bb01-2c7e-40b5-9895-e75b02229259"},"task_stream":{"kind":"task","id":"01a0aef2-4db5-7180-8f01-2f4c07d27195"},"task_id":"01a0aef2-4db5-7180-8f01-2f4c07d27195","event":{"kind":"output","task_id":"01a0aef2-4db5-7180-8f01-2f4c07d27195","chunk":"{\n  \"chunk_id\": \"exec-60-1\",\n  \"command\": \"task-board --help 2>&1 | head -n 40; echo \\\"===\\\"; task-board m 'schema(mutation=add_resource)' 2>&1 | python3 -c \\\"import sys,json; s=sys.stdin.read(); i=s.find('\\\\\\\"content\\\\\\\"'); print(s[i-200:i+1200])\\\"\",\n  \"description\": \"Find file attachment mechanism\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Manage a file-based task board with epics, stories, tasks, and bugs.\\n\\nUsage:\\n  task-board [command]\\n\\nAvailable Commands:\\n  admin                  Server administration (users, tokens, access)\\n  boards                 List boards accessible to the current user (remote mode)\\n  claude                 Launch Claude through the Task-board Session Manager\\n  codex                  Attach Codex to the Task-board Session Manager\\n  completion             Generate the autocompletion script for the specified shell\\n  export                 Export current board into a tar.gz archive\\n  goal                   Read and align the board-scoped parent primary goal\\n  grep                   Full-text search across board files\\n  handoff                Verify role handoff evidence and move to the role end status\\n  help                   Help about any command\\n  import                 Import a tar.gz archive into the current board\\n  init                   Install task-board project integrations\\n  limits                 Inspect and control provider rate-limit state\\n  login                  Store a token for the current remote\\n  logout                 Remove active user's token for current remote\\n  m                      Execute a mutation (write operation)\\n  migrate-keychain       Import legacy remote credentials into macOS Keychain\\n  migrate-project-config Preview or apply guarded deprecated project-config alias migration\\n  plan                   Show execution plan with phases and critical path\\n  q                      Query the board with a mini DSL\\n  repair-links           List or remove unsupported container dependency links\\n  resource               Upload, update, download, and delete board resources\\n  self-update            Update task-board to the latest version\\n  session                Inspect and stop Task-board Session Manager sessions\\n  spawn                  Queue an agent spawn run for a board task\\n  switch-user            Switch active user for current remote\\n  tree                   Show board as hierarchical tree\\n  tui                    Launch interactive TUI\\n  validate               Validate board structure\\n  whoami                 Show current remote and active user\\n  worktree               Inspect and repair managed Story workspaces\\n\\nFlags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n===\\n,\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\",\\\"required\\\":true},{\\\"name\\\":\\\"name\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Resource name (e.g. research.md)\\\",\\\"required\\\":true},{\\\"name\\\":\\\"content\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Resource content (text); required if path is not provided\\\"},{\\\"name\\\":\\\"path\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Client-local file path (remote CLI inlines content; board-server rejects raw paths)\\\"},{\\\"name\\\":\\\"type\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"default\\\":\\\"outcome\\\",\\\"description\\\":\\\"Resource type\\\",\\\"enum\\\":[\\\"precondition\\\",\\\"outcome\\\"]},{\\\"name\\\":\\\"description\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"One-line description\\\"}],\\\"examples\\\":[\\\"add_resource(TASK-260218-abc123, name=\\\\\\\"research.md\\\\\\\", content=\\\\\\\"...\\\\\\\", type=outcome)\\\",\\\"add_resource(TASK-260218-abc123, name=\\\\\\\"spec.md\\\\\\\", path=\\\\\\\".temp/spec.md\\\\\\\", type=precondition)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false},\\\"assign\\\":{\\\"description\\\":\\\"Assign an agent to an element\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\",\\\"required\\\":true},{\\\"name\\\":\\\"agent\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Agent name\\\",\\\"required\\\":true}],\\\"examples\\\":[\\\"assign(TASK-260218-abc123, agent=claude-opus)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":true},\\\"audit_context_validation\\\":{\\\"description\\\":\\\"Run one no-model validation audit over a ready context and apply its consequ\\n\",\n  \"original_output_bytes\": 3820,\n  \"original_output_tokens\": 955,\n  \"truncated\": false\n}","final_result":true}}}
