{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ce8f","stream":{"kind":"session","id":"01a0aeea-0371-7222-a2de-305ea9e57fab"},"sequence":1442,"recorded_at":1780531400002879,"record_type":"event","durability":"durable","causation_id":"7588bb01-2c7e-40b5-9895-e75b02229259","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7588bb01-2c7e-40b5-9895-e75b02229259","run_stream":{"kind":"run","id":"7588bb01-2c7e-40b5-9895-e75b02229259"},"task_stream":{"kind":"task","id":"01a0aef1-b9f1-72c1-9ba5-3718bac4ee27"},"task_id":"01a0aef1-b9f1-72c1-9ba5-3718bac4ee27","event":{"kind":"output","task_id":"01a0aef1-b9f1-72c1-9ba5-3718bac4ee27","chunk":"{\n  \"chunk_id\": \"exec-54-1\",\n  \"command\": \"python3 - <<'EOF'\\nimport json, glob, re\\nsrc = open('internal/crashgate/registry.go').read()\\nreg = set(re.findall(r'\\\"(CR-[A-Z]+(?:-[A-Z]+)?-\\\\d+)\\\"', src))\\nrecs = glob.glob('/tmp/cg-records/*.json')\\nneed = [\\\"boundary\\\",\\\"path\\\",\\\"operation_ids\\\",\\\"phase_before\\\",\\\"phase_after\\\",\\\"external_effect\\\",\\\"status_probe\\\",\\\"lease_before\\\",\\\"lease_after\\\",\\\"native_before\\\",\\\"native_after\\\",\\\"selected\\\"]\\nok, bad, sel = 0, [], {}\\nfor f in recs:\\n    d = json.load(open(f))\\n    missing = [k for k in need if k not in d]\\n    if missing or d[\\\"boundary\\\"] not in reg or d[\\\"selected\\\"] not in (\\\"safe_retry\\\",\\\"explicit_rollback\\\",\\\"recoverable_parked_state\\\"):\\n        bad.append((f.split('/')[-1], missing, d.get(\\\"selected\\\")))\\n    else:\\n        ok += 1; sel[d[\\\"selected\\\"]] = sel.get(d[\\\"selected\\\"], 0) + 1\\nprint(f\\\"valid={ok} total={len(recs)} outcomes={sel}\\\")\\nprint(\\\"bad:\\\", bad[:5] if bad else \\\"NONE\\\")\\nEOF\",\n  \"description\": \"Validate records with correct schema\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"valid=72 total=72 outcomes={'recoverable_parked_state': 11, 'safe_retry': 60, 'explicit_rollback': 1}\\nbad: NONE\\n\",\n  \"original_output_bytes\": 112,\n  \"original_output_tokens\": 28,\n  \"truncated\": false\n}","final_result":true}}}
