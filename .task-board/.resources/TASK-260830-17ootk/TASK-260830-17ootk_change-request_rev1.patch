+		{"bad_prior", func(i *CreateInputs) { i.ExpectedPriorCheckpointID = "not-a-digest" }},
+		{"bad_extension_key", func(i *CreateInputs) { i.Extensions = map[string]string{"pid": "4242"} }},
+		{"duplicate_authority", func(i *CreateInputs) {
