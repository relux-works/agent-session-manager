+		t.Fatalf("example identity field = %q, want checkpoint_id", string(field))
+	}
+	if digest.String() != "sha256:e051996f51f13ace4f5cdebe1e30fd26fd5fe104cfd6e6a7f9f1206ba3819656" {
+		t.Fatalf("example digest = %q", digest)
