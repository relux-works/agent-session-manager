nce(tv,list) else '?'}\\\")\\n    else:\\n        print(f\\\"{k}: equal={hv==tv}\\\")\\n# case ids\\ndef ids(arr):\\n    out=[]\\n    for e in arr:\\n        out.append(e.get(\\\"id\\\", json.dumps(e)[:60]))\\n    return out\\nhids, tids = ids(h[\\\"acceptance_cases\\\"]), ids(t[\\\"acceptance_cases\\\"])\\nprint(\\\"HEAD-only case ids:\\\", [i for i in hids if i not in tids])\\nprint(\\\"THEIRS-only case ids:\\\", [i for i in tids if i not in hids])\\n# ownership entries: compare by serialized form\\nhs = set(json.dumps(e, sort_keys=True) for e in h[\\\"ownership\\\"])\\nts = set(json.dumps(e, sort_keys=True) for e in t[\\\"ownership\\\"])\\nprint(\\\"ownership HEAD-only count:\\\", len(hs-ts), \\\"THEIRS-only count:\\\", len(ts-hs))\\nfor e in sorted(ts-hs)[:6]:\\n    print(\\\"  THEIRS+:\\\", e[:200])\\nfor e in sorted(hs-ts)[:6]:\\n    print(\\\"  HEAD+:\\\", e[:200])\\nEOF\",\n  \"description\": \"Structurally diff HEAD vs theirs ownership JSON\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"top-level keys: ['format', 'format_version', 'source', 'acceptance_cases', 'ownership', 'unowned_sections']\\nformat: equal=True\\nformat_version: equal=True\\nsource: equal=True\\nacceptance_cases: HEAD len=113 THEIRS len=105\\nownership: HEAD len=64 THEIRS len=64\\nunowned_sections: HEAD len=12 THEIRS len=12\\nHEAD-only case ids: ['sessprofile-derive', 'sessprofile-derive-heads', 'sessprofile-fork-pair', 'provhost-mapping-resolution', 'provhost-launch-projection', 'provhost-identity-create', 'provhost-identity-check', 'provhost-resume-tuple-gate', 'resumesmoke-matrix', 'resumesmoke-run', 'resumesmoke-record', 'resumesmoke-store']\\nTHEIRS-only case ids: ['workspace-checkpoint-capture', 'workspace-checkpoint-admission', 'materialization-journal-lifecycle', 'materialization-journal-recovery']\\nownership HEAD-only count: 0 THEIRS-only count: 0\\n\",\n  \"original_output_bytes\": 838,\n  \"original_output_tokens\": 210,\n  \"truncated\": false