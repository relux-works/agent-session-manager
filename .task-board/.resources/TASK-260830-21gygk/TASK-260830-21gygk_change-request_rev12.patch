+repo_base = repo_source.read_text()
+results = []
+
+IDA = '0198f4c8-3e70-7a11-8a2b-1234567890ab'
+IDB = '0198f4c8-3e70-7a11-8a2b-1234567890ac'
+HOSTA = '0198f4c8-4a10-7b22-8b3c-1234567890ab'
