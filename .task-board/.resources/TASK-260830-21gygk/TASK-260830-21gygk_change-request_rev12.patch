+	case "bad_unknown_head":
+		extra = rev7Replace(t, checkpoint(t, idA, 1, lease, hostA), "checkpoint_id", map[string]any{"event_heads": []string{zeroDigest}})
+		reference = checkpointDigestOf(t, extra)
