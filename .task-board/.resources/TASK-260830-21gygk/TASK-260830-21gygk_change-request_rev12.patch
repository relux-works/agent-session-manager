+func TestResolveExactNamesAndASCIICollisions(t *testing.T) {
+	for _, peers := range []bool{false, true} {
+		t.Run(map[bool]string{false: "local", true: "peers"}[peers], func(t *testing.T) {
+			local, _ := repository(t)
