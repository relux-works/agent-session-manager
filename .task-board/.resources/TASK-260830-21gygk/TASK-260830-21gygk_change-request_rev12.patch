+				r.AllowlistedPeerIDs = []string{hostA}
+				r.Peers = []PeerIndex{{hostA, source}}
+			}
+			create(t, source, idA, "Az-09._")
+			for _, query := range []string{"az-09._", "AZ-09._", "Ａz-09._", "no-such-session", "host/Name"} {
