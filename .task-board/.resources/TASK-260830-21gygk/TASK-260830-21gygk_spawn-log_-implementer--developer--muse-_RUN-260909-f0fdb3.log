{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9c9","stream":{"kind":"session","id":"01a087b3-56b9-7060-8f60-96db20969afb"},"sequence":831,"recorded_at":1780531400001657,"record_type":"event","durability":"durable","causation_id":"b50cb893-1a9e-463b-98b6-7c1306fa57ef","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b50cb893-1a9e-463b-98b6-7c1306fa57ef","run_stream":{"kind":"run","id":"b50cb893-1a9e-463b-98b6-7c1306fa57ef"},"call_id":"call_01a087b6ab607a3180a3de583f916946","text":"{\n  \"chunk_id\": \"exec-24-1\",\n  \"command\": \"git status --short -- . ':!.task-board' 2>&1 | head -n 50; echo \\\"===\\\"; TASK_BOARD_DIR=/Users/iv/Developer/ReluxWorks/agent-session-manager/.task-board task-board worktree --help 2>&1 | head -n 60\",\n  \"description\": \"Check worktree changes and worktree help\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \" M LOGBOOK.md\\n M README.md\\n M internal/catalog/catalog.go\\n M internal/catalog/catalog_gen.go\\n M internal/catalog/catalog_test.go\\n M internal/catalog/cmd/cataloggen/main_test.go\\n M internal/cataloggen/generate.go\\n M internal/cataloggen/generate_test.go\\n M internal/cigate/contracts.go\\n M internal/cigate/contracts_test.go\\n M internal/config/compatibility_regression_test.go\\n M internal/config/migration_refusal_test.go\\n M internal/config/migration_test.go\\n M internal/config/schema_test.go\\n M internal/localstore/paths.go\\n M internal/sessrepo/sessrepo_test.go\\n M internal/sessrepo/store.go\\n M internal/specdoc/specdoc.go\\n M internal/specpin/pin.go\\n M internal/specpin/pin_test.go\\n M internal/specpin/sections.go\\n M internal/traceability/cmd/tracecheck/main_test.go\\n M internal/traceability/traceability.go\\n M internal/traceability/traceability_test.go\\n M task-board.config.json\\n?? internal/catalog/catalog.v0.6.0.json\\n?? internal/sessquery/\\n?? internal/specdoc/SPEC.v0.6.0.md\\n?? internal/specdoc/specdoc060_test.go\\n?? internal/specpin/pin060_test.go\\n?? internal/specpin/sections060_test.go\\n?? internal/specpin/v0.6.0.lock.json\\n?? internal/traceability/adoption-v0.6.0.md\\n?? internal/traceability/ownership.v0.6.0.json\\n===\\nInspect and repair the Story-scoped Git workspaces that repository-mutating\\nspawns run in.\\n\\nEach Story gets one managed worktree under .temp/<STORY-ID>/worktree on a\\nshort-lived task-board/story/<STORY-ID> branch forked from trunk. Trunk is\\nspawn.worktree_isolation.integration_base_branch when configured, and otherwise\\nresolves from refs/remotes/origin/HEAD and then the current branch.\\n\\nThese commands require a local authoritative board. On a remote board they\\nrefuse with worktree_isolation_requires_local_board and do nothing else.\\n\\nUsage:\\n  task-board worktree [command]\\n\\nAvailable Commands:\\n  abort                 Stop using a Story workspace, preserving its work by default\\n  checkpoint            Commit an accepted leaf onto its Story branch while preserving integrating\\n  complete              Prove an accepted Story's code landed on its own repository, then record its board state in the board repository\\n  gc                    Release Story leases whose holding runs are provably terminal\\n  integrate             Land an accepted Story candidate on trunk and commit its board state\\n  invalidate-acceptance Release an element whose acceptance §6.2 already invalidated back to rework\\n  prepare-landed-review Export a signed current-default tree for a new producer handoff and exact-tree review\\n  refresh-candidate     Refresh a rework candidate base while preserving uncommitted files\\n  repair                Re-materialize a recorded workspace whose worktree is missing\\n  start-landed-rework   Reprove a landed-review export and durably authorize normal producer rework\\n  status                Report managed Story workspaces and what blocks their cleanup\\n  transaction           Inspect and dispose of a refused or abandoned integration transaction\\n\\nFlags:\\n  -h, --help   help for worktree\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\\nUse \\\"task-board worktree [command] --help\\\" for more information about a command.\\n\",\n  \"original_output_bytes\": 3715,\n  \"original_output_tokens\": 929,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
