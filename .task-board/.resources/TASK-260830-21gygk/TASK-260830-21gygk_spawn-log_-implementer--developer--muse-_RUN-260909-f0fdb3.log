f err != nil || got.SessionID != idA || got.PeerHostID != \"\" {\n38|\t\tt.Fatalf(\"local priority: %+v %v\", got, err)\n39|\t}\n40|\t// A local UUID-shaped name also wins over the UUID identity.\n41|\tlocal2, _ := repository(t)\n42|\tcreate(t, local2, idA, \"Original\")\n43|\tcreate(t, local2, idB, idA)\n44|\tgot, err = (&Reader{Local: local2}).Resolve(idA)\n45|\tif err != nil || got.SessionID != idB {\n46|\t\tt.Fatalf(\"local name before UUID: %+v %v\", got, err)\n47|\t}\n48|}\n49|\n50|func TestResolveExactNamesAndASCIICollisions(t *testing.T) {\n51|\tfor _, peers := range []bool{false, true} {\n52|\t\tt.Run(map[bool]string{false: \"local\", true: \"peers\"}[peers], func(t *testing.T) {\n53|\t\t\tlocal, _ := repository(t)\n54|\t\t\tsource := local\n55|\t\t\tr := &Reader{Local: local}\n56|\t\t\tif peers {\n57|\t\t\t\tsource, _ = repository(t)\n58|\t\t\t\tr.AllowlistedPeerIDs = []string{hostA}\n59|\t\t\t\tr.Peers = []PeerIndex{{hostA, source}}\n60|\t\t\t}\n61|\t\t\tcreate(t, source, idA, \"Az-09._\")\n62|\t\t\tfor _, query := range []string{\"az-09._\", \"AZ-09._\", \"Ａz-09._\", \"no-such-session\", \"host/Name\"} {\n63|\t\t\t\tif _, err := r.Resolve(query); !errors.Is(err, ErrNotFound) {\n64|\t\t\t\t\tt.Fatalf(\"%q: %v\", query, err)\n65|\t\t\t\t}\n66|\t\t\t}\n67|\t\t\t// v0.6.0 Section 14.7.1 decides the qualified-selector\n68|\t\t\t// grammar the partial leaf left open: \"Name@host\" is a\n69|\t\t\t// qualified selector with an unknown source, and the empty\n70|\t\t\t// argument carries no key, so both are invalid arguments,\n71|\t\t\t// never silent names. \"host/Name\" carries no \"@\" and stays\n72|\t\t\t// not found.\n73|\t\t\tfor _, query := range []string{\"Name@host\", \"\", \"Az-09._@unknown\", \"Az-09._@\", \"@local\"} {\n74|\t\t\t\tif _, err := r.Resolve(query); !errors.Is(err, ErrInvalidArgument) {\n75|\t\t\t\t\tt.Fatalf(\"%q: %v\", query, err)\n76|\t\t\t\t}\n77|\t\t\t}\n78|\t\t\tif _, err := r.Resolve(\"Az-09._\"); err != nil {\n79|\t\t\t\tt.Fatal(err)\n80|\t\t\t}\n81|\t\t\tcreate(t, source, idB, \"aZ-09._\")\n82|\t\t\tfor _, query := range []string{\"Az-09._\", \"aZ-09._\", \"AZ-09._\"} {\n83|\t\t\t\tif _, err := r.Resolve(query); !errors.Is(err, ErrAmbiguous) {\n84|\t\t\t\t\tt.Fatalf(\"%q: %v\", query, err)\n85|\t\t\t\t}\n86|\t\t\t\tif _, err := r.Status(query); !errors.Is(err, ErrAmbiguous) {\n87|\t\t\t\t\tt.Fatalf(\"status %q: %v\", query, err)\n88|\t\t\t\t}\n89|\t\t\t}\n90|\t\t})\n91|\t}\n92|}\n93|\n94|func TestResolveAllowlistAndReadFailures(t *testing.T) {\n95|\tlocal, root := repository(t)\n96|\tpeer, peerRoot := repository(t)\n97|\tcreate(t, local, idA, \"Local\")\n98|\tcreate(t, peer, idB, idA)\n99|\tr := &Reader{Local: local, Peers: []PeerIndex{{hostA, peer}}}\n100|\tgot, err := r.Resolve(idA)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
