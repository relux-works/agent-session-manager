{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb4f","stream":{"kind":"session","id":"01a087b3-56b9-7060-8f60-96db20969afb"},"sequence":1026,"recorded_at":1780531400002047,"record_type":"event","durability":"durable","causation_id":"b50cb893-1a9e-463b-98b6-7c1306fa57ef","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b50cb893-1a9e-463b-98b6-7c1306fa57ef","run_stream":{"kind":"run","id":"b50cb893-1a9e-463b-98b6-7c1306fa57ef"},"task_stream":{"kind":"task","id":"01a087b7-ffa1-7bb3-ac5f-ff072a825c68"},"task_id":"01a087b7-ffa1-7bb3-ac5f-ff072a825c68","event":{"kind":"output","task_id":"01a087b7-ffa1-7bb3-ac5f-ff072a825c68","chunk":"Read text file `internal/sessquery/query_test.go`.\n1|package sessquery\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"reflect\"\n8|\t\"testing\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n12|)\n13|\n14|func TestResolvePinnedPrecedence(t *testing.T) {\n15|\tlocal, _ := repository(t)\n16|\tpeer, _ := repository(t)\n17|\tcreate(t, local, idA, \"Local\")\n18|\tcreate(t, peer, idB, idA)\n19|\treader := &Reader{Local: local, AllowlistedPeerIDs: []string{hostA}, Peers: []PeerIndex{{hostA, peer}}}\n20|\tfor _, row := range []struct{ selector, id, peer string }{\n21|\t\t{\"Local\", idA, \"\"}, {idA, idB, hostA}, {idB, idB, hostA},\n22|\t} {\n23|\t\tgot, err := reader.Resolve(row.selector)\n24|\t\tif err != nil || got.SessionID != row.id || got.PeerHostID != row.peer {\n25|\t\t\tt.Fatalf(\"Resolve(%q) = %+v, %v\", row.selector, got, err)\n26|\t\t}\n27|\t\tstatus, err := reader.Status(row.selector)\n28|\t\tif err != nil || status.Projection.SessionID != row.id {\n29|\t\t\tt.Fatalf(\"Status(%q) = %+v, %v\", row.selector, status, err)\n30|\t\t}\n31|\t}\n32|\t// Local exact name wins even if a peer learned the same name for another ID.\n33|\tother, _ := repository(t)\n34|\tcreate(t, other, idB, \"Local\")\n35|\treader.Peers = []PeerIndex{{hostA, other}}\n36|\tgot, err := reader.Resolve(\"Local\")\n37|\tif err != nil || got.SessionID != idA || got.PeerHostID != \"\" {\n38|\t\tt.Fatalf(\"local priority: %+v %v\", got, err)\n39|\t}\n40|\t// A local UUID-shaped name also wins over the UUID identity.\n41|\tlocal2, _ := repository(t)\n42|\tcreate(t, local2, idA, \"Original\")\n43|\tcreate(t, local2, idB, idA)\n44|\tgot, err = (&Reader{Local: local2}).Resolve(idA)\n45|\tif err != nil || got.SessionID != idB {\n46|\t\tt.Fatalf(\"local name before UUID: %+v %v\", got, err)\n47|\t}\n48|}\n49|\n50|func TestResolveExactNamesAndASCIICollisions(t *testing.T) {\n51|\tfor _, peers := range []bool{false, true} {\n52|\t\tt.Run(map[bool]string{false: \"local\", true: \"peers\"}[peers], func(t *testing.T) {\n53|\t\t\tlocal, _ := repository(t)\n54|\t\t\tsource := local\n55|\t\t\tr := &Reader{Local: local}\n56|\t\t\tif peers {\n57|\t\t\t\tsource, _ = repository(t)\n58|\t\t\t\tr.AllowlistedPeerIDs = []string{hostA}\n59|\t\t\t\tr.Peers = []PeerIndex{{hostA, source}}\n60|\t\t\t}\n61|\t\t\tcreate(t, source, idA, \"Az-09._\")\n62|\t\t\tfor _, query := range []string{\"az-09._\", \"AZ-09._\", \"Ａz-09._\", \"no-such-session\", \"host/Name\"} {\n63|\t\t\t\tif _, err := r.Resolve(query); !errors.Is(err, ErrNotFound) {\n64|\t\t\t\t\tt.Fatalf(\"%q: %v\", query, err)\n65|\t\t\t\t}\n66|\t\t\t}\n67|\t\t\t// v0.6.0 Section 14.7.1 decides the qualified-selector\n68|\t\t\t// grammar the partial leaf left open: \"Name@host\" is a\n69|\t\t\t// qualified selector with an unknown source, and the empty\n70|\t\t\t// argument carries no key, so both are invalid arguments,\n71|\t\t\t// never silent names. \"host/Name\" carries no \"@\" and stays\n72|\t\t\t// not found.\n73|\t\t\tfor _, query := range []string{\"Name@host\", \"\", \"Az-09._@unknown\", \"Az-09._@\", \"@local\"} {\n74|\t\t\t\tif _, err := r.Resolve(query); !errors.Is(err, ErrInvalidArgument) {\n75|\t\t\t\t\tt.Fatalf(\"%q: %v\", query, err)\n76|\t\t\t\t}\n77|\t\t\t}\n78|\t\t\tif _, err := r.Resolve(\"Az-09._\"); err != nil {\n79|\t\t\t\tt.Fatal(err)\n80|\t\t\t}\n81|\t\t\tcreate(t, source, idB, \"aZ-09._\")\n82|\t\t\tfor _, query := range []string{\"Az-09._\", \"aZ-09._\", \"AZ-09._\"} {\n83|\t\t\t\tif _, err := r.Resolve(query); !errors.Is(err, ErrAmbiguous) {\n84|\t\t\t\t\tt.Fatalf(\"%q: %v\", query, err)\n85|\t\t\t\t}\n86|\t\t\t\tif _, err := r.Status(query); !errors.Is(err, ErrAmbiguous) {\n87|\t\t\t\t\tt.Fatalf(\"status %q: %v\", query, err)\n88|\t\t\t\t}\n89|\t\t\t}\n90|\t\t})\n91|\t}\n92|}\n93|\n94|func TestResolveAllowlistAndReadFailures(t *testing.T) {\n95|\tlocal, root := repository(t)\n96|\tpeer, peerRoot := repository(t)\n97|\tcreate(t, local, idA, \"Local\")\n98|\tcreate(t, peer, idB, idA)\n99|\tr := &Reader{Local: local, Peers: []PeerIndex{{hostA, peer}}}\n100|\tgot, err := r.Resolve(idA)\n(more lines below)","final_result":true}}}
