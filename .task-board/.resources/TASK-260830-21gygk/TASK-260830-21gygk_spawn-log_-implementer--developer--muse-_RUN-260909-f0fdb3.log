{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cbad","stream":{"kind":"session","id":"01a087b3-56b9-7060-8f60-96db20969afb"},"sequence":1073,"recorded_at":1780531400002141,"record_type":"event","durability":"durable","causation_id":"b50cb893-1a9e-463b-98b6-7c1306fa57ef","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b50cb893-1a9e-463b-98b6-7c1306fa57ef","run_stream":{"kind":"run","id":"b50cb893-1a9e-463b-98b6-7c1306fa57ef"},"task_stream":{"kind":"task","id":"01a087b8-2ea1-7fc0-affa-e5936610c073"},"task_id":"01a087b8-2ea1-7fc0-affa-e5936610c073","event":{"kind":"output","task_id":"01a087b8-2ea1-7fc0-affa-e5936610c073","chunk":"Read text file `internal/sessrepo/sessrepo_test.go`.\n(839 line(s) above)\n840|\trepository := openTestRepository(t)\n841|\treference := createTestSession(t, repository)\n842|\tfirst, firstBytes := appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n843|\tstored, err := repository.GetEvent(testSessionID, first.EventID)\n844|\tif err != nil {\n845|\t\tt.Fatal(err)\n846|\t}\n847|\tif string(stored) != string(firstBytes) {\n848|\t\tt.Fatal(\"GetEvent bytes differ from appended bytes\")\n849|\t}\n850|\t_, err = repository.GetEvent(testSessionID, \"not-a-digest\")\n851|\tmustErrorIs(t, err, ErrUnknownEvent, \"GetEvent(malformed)\")\n852|\t_, err = repository.GetEvent(testSessionID, zeroDigest)\n853|\tmustErrorIs(t, err, ErrUnknownEvent, \"GetEvent(absent)\")\n854|}\n855|\n856|func TestResolveLocalNameAndUUID(t *testing.T) {\n857|\trepository := openTestRepository(t)\n858|\tcreateTestSession(t, repository)\n859|\tsummary, err := repository.Resolve(\"payments-api\")\n860|\tif err != nil {\n861|\t\tt.Fatalf(\"Resolve(exact) error = %v\", err)\n862|\t}\n863|\tif summary.SessionID != testSessionID {\n864|\t\tt.Fatalf(\"resolved = %q, want %q\", summary.SessionID, testSessionID)\n865|\t}\n866|\t// Section 2.3 uses folding for uniqueness, but requires exact names.\n867|\t_, err = repository.Resolve(\"Payments-API\")\n868|\tmustErrorIs(t, err, ErrNameNotFound, \"Resolve(non-exact case variant)\")\n869|\tbyUUID, err := repository.Resolve(testSessionID)\n870|\tif err != nil {\n871|\t\tt.Fatalf(\"Resolve(uuid) error = %v\", err)\n872|\t}\n873|\tif byUUID.RecordID != summary.RecordID {\n874|\t\tt.Fatalf(\"uuid resolve = %+v, want %+v\", byUUID, summary)\n875|\t}\n876|\t_, err = repository.Resolve(\"no-such-session\")\n877|\tmustErrorIs(t, err, ErrNameNotFound, \"Resolve(absent)\")\n878|\t// A UUID-shaped query with no session is not found, not ambiguous.\n879|\t_, err = repository.Resolve(testSessionIDB)\n880|\tmustErrorIs(t, err, ErrNameNotFound, \"Resolve(absent uuid)\")\n881|}\n882|\n883|func TestResolveRefusesCaseFoldCollision(t *testing.T) {\n884|\trepository := openTestRepository(t)\n885|\tcreateTestSession(t, repository)\n886|\t// The colliding name carries Y, past T: a narrowed fold that stops at\n887|\t// T would miss this collision, so the vector witnesses the full A-Z\n888|\t// range rather than only its head.\n889|\tother := buildRecord(t, func(object map[string]any) {\n890|\t\tobject[\"session_id\"] = testSessionIDB\n891|\t\tobject[\"subject_id\"] = testSessionIDB\n892|\t\tobject[\"name\"] = \"PAYMENTS-API\"\n893|\t})\n894|\tif _, err := repository.CreateSession(other); err != nil {\n895|\t\tt.Fatal(err)\n896|\t}\n897|\t_, err := repository.Resolve(\"payments-api\")\n898|\tmustErrorIs(t, err, ErrNameAmbiguous, \"Resolve(collision)\")\n899|\t_, err = repository.Resolve(\"PAYMENTS-API\")\n(more lines below)","final_result":true}}}
