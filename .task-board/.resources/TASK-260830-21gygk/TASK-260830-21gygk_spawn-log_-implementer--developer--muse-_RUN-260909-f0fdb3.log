{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc15","stream":{"kind":"session","id":"01a087b3-56b9-7060-8f60-96db20969afb"},"sequence":1125,"recorded_at":1780531400002245,"record_type":"event","durability":"durable","causation_id":"b50cb893-1a9e-463b-98b6-7c1306fa57ef","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b50cb893-1a9e-463b-98b6-7c1306fa57ef","run_stream":{"kind":"run","id":"b50cb893-1a9e-463b-98b6-7c1306fa57ef"},"task_stream":{"kind":"task","id":"01a087b8-50bd-76c1-be67-e24f7eae825d"},"task_id":"01a087b8-50bd-76c1-be67-e24f7eae825d","event":{"kind":"output","task_id":"01a087b8-50bd-76c1-be67-e24f7eae825d","chunk":"Read text file `internal/sessquery/testdata/mutate.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Run isolated behavioral mutants; never modify the managed Story checkout.\n3|Usage: python3 internal/sessquery/testdata/mutate.py /absolute/evidence/directory\n4|Every subprocess runs directly, logs its real exit, and has a bounded timeout.\n5|The battery proves each gate by narrowing, never by deletion: every N-\n6|mutant keeps its gate present and weakens it to admit exactly one member\n7|of the class the gate must reject, and a named behavioral test must fail.\n8|Grammar mutants preserve the searched-for token while changing behavior,\n9|and the harness always executes the behavioral suites.\n10|\"\"\"\n11|import hashlib\n12|import json\n13|from pathlib import Path\n14|import re\n15|import shutil\n16|import subprocess\n17|import sys\n18|\n19|root = Path(__file__).resolve().parents[3]\n20|output = Path(sys.argv[1]).resolve()\n21|output.mkdir(parents=True, exist_ok=True)\n22|copy = output / 'mutation-source'\n23|if copy.exists():\n24|    raise SystemExit('refusing to overwrite an existing mutation source')\n25|copy.mkdir()\n26|shutil.copytree(root / 'internal', copy / 'internal')\n27|for name in ('go.mod', 'go.sum', 'README.md', 'LOGBOOK.md'):\n28|    shutil.copy2(root / name, copy / name)\n29|source = copy / 'internal/sessquery/query.go'\n30|base = source.read_text()\n31|selector_source = copy / 'internal/sessquery/selector.go'\n32|selector_base = selector_source.read_text()\n33|revalidate_source = copy / 'internal/sessquery/revalidate.go'\n34|revalidate_base = revalidate_source.read_text()\n35|repo_source = copy / 'internal/sessrepo/store.go'\n36|repo_base = repo_source.read_text()\n37|results = []\n38|\n39|def run(name, path, old, new, narrow):\n40|    original = path.read_text()\n41|    if original.count(old) != 1:\n42|        results.append(dict(mutant=name, classification='NOT_APPLIED', count=original.count(old), bound=narrow))\n43|        return\n44|    path.write_text(original.replace(old, new))\n45|    command = ['go', 'test', './internal/sessquery', './internal/sessrepo', '-count=1', '-v']\n46|    try:\n47|        with (output / (name + '.log')).open('w') as log:\n48|            process = subprocess.run(command, cwd=copy, stdout=log, stderr=subprocess.STDOUT, timeout=180)\n49|        text = (output / (name + '.log')).read_text()\n50|        failures = re.findall(r'^\\s*--- FAIL: ([^ ]+)', text, re.M)\n51|        classification = 'SURVIVED' if process.returncode == 0 else ('KILLED' if failures else 'COMPILE_OR_HARNESS_FAILURE')\n52|        results.append(dict(mutant=name, classification=classification, exit=process.returncode, failed_tests=failures, bound=narrow, command=command))\n53|        print(name, classification, process.returncode, ', '.join(failures), flush=True)\n54|    finally:\n55|        path.write_text(original)\n56|        assert hashlib.sha256(path.read_bytes()).digest() == hashlib.sha256(original.encode()).digest()\n57|\n58|with (output / 'control-before.log').open('w') as log:\n59|    before = subprocess.run(['go','test','./internal/sessquery','./internal/sessrepo','-count=1'],cwd=copy,stdout=log,stderr=subprocess.STDOUT,timeout=180)\n60|results.append(dict(mutant='control-before', classification='CONTROL', exit=before.returncode))\n61|if before.returncode:\n62|    raise SystemExit('baseline failed')\n63|run('N-collision-pair',source,'if len(ids) > 1 {','if len(ids) > 2 {','Allow exactly a two-identity folded bucket; larger buckets still refuse.')\n64|run('N-case-variant',source,'if item.summary.Projection.Name == selector && exact == nil {','if (item.summary.Projection.Name == selector || selector == \"az-09._\") && exact == nil {','Allow the sole non-exact query az-09._ within its folded bucket.')\n65|run('N-parked-id',source,'if row.Projection.Parked != nil || row.Projection.State == sessstate.StateTombstoned {','if (row.Projection.Parked != nil && row.Projection.SessionID != \"0198f4c8-3e70-7a11-8a2b-1234567890ab\") || row.Projection.State == sessstate.StateTombstoned {','Allow one parked session identity into live resolution.')\n66|run('N-tombstoned-id',source,'if row.Projection.Parked != nil || row.Projection.State == sessstate.StateTombstoned {','if row.Projection.Parked != nil || (row.Projection.State == sessstate.StateTombstoned && row.Projection.SessionID != \"0198f4c8-3e70-7a11-8a2b-1234567890ab\") {','Allow one tombstoned session identity into live resolution.')\n67|run('N-unlisted-peer',source,'sort.Strings(ids)','ids = append(ids, \"0198f4c8-4a10-7b22-8b3c-1234567890ab\"); sort.Strings(ids)','Read one peer outside the allowlist; all other peer identities still filtered.')\n68|run('N-duplicate-peer',source,'if found {','if found && id != \"0198f4c8-4a10-7b22-8b3c-1234567890ab\" {','Permit duplicate sources for one peer identity, retain duplicate refusal for other identities.')\n69|run('N-read-failure-fallback',source,'rows, err := repo.ListSessions()\\n\\tif err != nil {\\n\\t\\treturn nil, err\\n\\t}', 'rows, err := repo.ListSessions()\\n\\tif err != nil {\\n\\t\\tif errors.Is(err, sessrepo.ErrRepositoryPath) { return []Summary{}, nil }; return nil, err\\n\\t}', 'Treat repository-path read failure as empty, while retaining other read refusals.')\n70|run('N-projection-failure-fallback',source,'projection, err := projector.Project(row.SessionID)\\n\\t\\tif err != nil {\\n\\t\\t\\treturn nil, err\\n\\t\\t}', 'projection, err := projector.Project(row.SessionID)\\n\\t\\tif err != nil {\\n\\t\\t\\tif row.SessionID == \"0198f4c8-3e70-7a11-8a2b-1234567890ab\" { continue }; return nil, err\\n\\t\\t}', 'Omit one identity on failed projection instead of propagating its failure.')\n71|run('N-repository-case-variant',repo_source,'if len(folded) == 1 && folded[0].Name == query {','if len(folded) == 1 && (folded[0].Name == query || query == \"Payments-API\") {','Allow one non-exact query at the retained repository Resolve entry.')\n72|run('N-first-at-split',selector_source,'key, source, qualified := strings.Cut(argument, \"@\")','key, source, qualified := argument, \"\", false\\n\\tif at := strings.LastIndexByte(argument, \\'@\\'); at >= 0 {\\n\\t\\tkey, source, qualified = argument[:at], argument[at+1:], true\\n\\t}','Split at the last @ while keeping the @ token; an alias containing @ then misroutes.')\n73|run('N-local-prefix',selector_source,'\\tcase source == \"local\":','\\tcase strings.HasPrefix(source, \"local\"):','Admit local-prefixed sources while keeping the local token; localX then selects local.')\n74|run('N-id-case',selector_source,'\\tif id, ok := strings.CutPrefix(key, \"id:\"); ok {\\n\\t\\tif _, err := scalar.ParseUUIDv7(id); err != nil {','\\tlowered := strings.ToLower(key)\\n\\tif id, ok := strings.CutPrefix(lowered, \"id:\"); ok {\\n\\t\\tif _, err := scalar.ParseUUIDv7(id); err != nil {','Fold the id: key prefix while keeping its token; ID: then bypasses names.')\n75|run('N-peer-alias-fold',selector_source,'if config.aliasOf[peer.HostID] == alias && alias != \"\" {','if asciiFold(config.aliasOf[peer.HostID]) == asciiFold(alias) && alias != \"\" {','Fold alias comparison while keeping exact mapping storage; WORK then selects Work.')\n76|run('N-id-through-names',source,'\\treturn selectIdentity(strings.TrimPrefix(parsed.Key, \"id:\"), live, config)','\\tif match, found, err := matchName(live, strings.TrimPrefix(parsed.Key, \"id:\")); found || err != nil {\\n\\t\\treturn match, err\\n\\t}\\n\\treturn selectIdentity(strings.TrimPrefix(parsed.Key, \"id:\"), live, config)','Route one explicit id: key through the name tier first; a UUID-shaped name then shadows the identity.')\n77|run('N-explicit-fallback',source,'\\treturn Selection{}, fmt.Errorf(\"%w: no live session named %q in source %s\", ErrNotFound, parsed.Key, describeSource(parsed))','\\treturn reader.resolveBare(Selector{Raw: parsed.Raw, Key: parsed.Key, UUIDShaped: parsed.UUIDShaped, Source: SourceBare}, config)','Fall back to the bare union on exactly an explicit-source miss; a locally present name then resolves.')\n78|run('N-unknown-alias-local',source,'\\t\\t\\treturn nil, \"\", fmt.Errorf(\"%w: no configured source for alias %q\", ErrSourceNotFound, parsed.SourceValue)','\\t\\t\\treturn reader.Local, \"\", nil','Treat exactly an unknown alias as the local source; a locally present name then resolves.')\n79|run('N-disallowed-admit',source,'\\t\\t\\treturn nil, \"\", fmt.Errorf(\"%w: peer %s is not allowlisted\", ErrPeerNotAllowlisted, host)','\\t\\t\\treturn reader.peerRepo(host)','Admit exactly one disallowed peer past the allowlist into its index read.')\n80|run('N-dup-alias',selector_source,'\\t\\t\\treturn config, fmt.Errorf(\"%w: duplicate source mapping for alias %q\", ErrInvalidConfig, alias)','\\t\\t\\tseenAliases[alias] = struct{}{}','Admit exactly duplicate alias mappings with last-write-wins instead of refusing them.')\n81|run('N-rev-revocation',revalidate_source,'\\t\\tif _, allowed := config.allowed[peerHost]; !allowed {','\\t\\tif _, allowed := config.allowed[peerHost]; !allowed && false {','Skip exactly the revocation check; a revoked plan then fails as stale configuration instead of peer_not_allowlisted.')\n82|run('N-rev-config',revalidate_source,'\\tif configuration != plan.ConfigurationDigest {','\\tif configuration != plan.ConfigurationDigest && false {','Skip exactly the configuration digest compare; an unrelated mapping change then validates.')\n83|run('N-rev-binding',revalidate_source,'\\tif !bindingHolds(plan, config, reader) {','\\tif !bindingHolds(plan, config, reader) && false {','Skip exactly the source binding compare; a remapped alias over identical copies then validates.')\n84|run('N-rev-index',revalidate_source,'\\tif index != plan.SourceIndexDigest {','\\tif index != plan.SourceIndexDigest && false {','Skip exactly the index digest compare; an unrelated session change then validates.')\n85|run('N-rev-record',revalidate_source,'\\tif recordID != plan.SessionRecordID {','\\tif recordID != plan.SessionRecordID && false {','Skip exactly the record compare; a replaced record then reports the lease reason instead.')\n86|run('N-rev-lease',revalidate_source,'\\tif projection.Winner.Epoch != plan.LeaseEpoch || projection.Winner.LeaseID != plan.LeaseID || projection.OwnerHostID != plan.OwnerHostID {','\\tif (projection.Winner.Epoch != plan.LeaseEpoch || projection.Winner.LeaseID != plan.LeaseID || projection.OwnerHostID != plan.OwnerHostID) && false {','Skip exactly the lease compare; a successor lease then reports the heads reason instead.')\n87|run('N-rev-heads',revalidate_source,'\\tif !equalStrings(heads, plan.AuthorityHeads) {','\\tif !equalStrings(heads, plan.AuthorityHeads) && false {','Skip exactly the heads compare; a same-lease event then reports the index reason instead.')\n88|run('N-rev-absent-substitute',revalidate_source,'\\tif absent {','\\tif absent && len(rows) > 0 {\\n\\t\\trecordID = rows[0].Projection.RecordID\\n\\t\\tplan.SessionID = rows[0].Projection.SessionID\\n\\t}\\n\\tif absent && len(rows) == 0 {','Substitute the first listed sibling for exactly a deleted selection instead of reporting its absence.')\n89|run('B-peer-order',source,'sort.Strings(ids)','sort.Sort(sort.Reverse(sort.StringSlice(ids)))','Reverse peer-source tie ordering; behavioral determinism fixture must fail.')\n90|run('B-session-order',source,'return out[i].Projection.SessionID < out[j].Projection.SessionID','return out[i].Projection.SessionID > out[j].Projection.SessionID','Reverse session output order; behavioral list fixture must fail.')\n91|run('B-tie-break',source,') < holderHost(best.selection',') > holderHost(best.selection','Reverse the identical-copy host tie break; the deterministic selection fixture must fail.')\n92|run('C-not-applied',source,'TOKEN_THAT_IS_NOT_PRESENT','replacement','Application control: missing patch is not a killed mutant.')\n93|run('C-compile-failure',source,'package sessquery','package sessquery\\nthis is invalid Go','Compilation control: no named failed behavioral test is not a kill.')\n94|with (output / 'control-after.log').open('w') as log:\n95|    after = subprocess.run(['go','test','./internal/sessquery','./internal/sessrepo','-count=1'],cwd=copy,stdout=log,stderr=subprocess.STDOUT,timeout=180)\n96|results.append(dict(mutant='control-after',classification='CONTROL', exit=after.returncode))\n97|assert source.read_text() == base and selector_source.read_text() == selector_base and revalidate_source.read_text() == revalidate_base and repo_source.read_text() == repo_base\n98|(output / 'mutants.json').write_text(json.dumps(results,indent=2)+'\\n')\n99|# Controls are reported separately from the applied behavioral denominator.\n100|bad = [row for row in results if row['mutant'].startswith(('N-','B-')) and row['classification'] != 'KILLED']\n101|raise SystemExit(1 if bad or after.returncode else 0)","final_result":true}}}
