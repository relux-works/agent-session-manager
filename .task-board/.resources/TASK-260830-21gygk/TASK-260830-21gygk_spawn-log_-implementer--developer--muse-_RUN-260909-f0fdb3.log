'N-rev-binding',revalidate_source,'\\tif !bindingHolds(plan, config, reader) {','\\tif !bindingHolds(plan, config, reader) && false {','Skip exactly the source binding compare; a remapped alias over identical copies then validates.')\n84|run('N-rev-index',revalidate_source,'\\tif index != plan.SourceIndexDigest {','\\tif index != plan.SourceIndexDigest && false {','Skip exactly the index digest compare; an unrelated session change then validates.')\n85|run('N-rev-record',revalidate_source,'\\tif recordID != plan.SessionRecordID {','\\tif recordID != plan.SessionRecordID && false {','Skip exactly the record compare; a replaced record then reports the lease reason instead.')\n86|run('N-rev-lease',revalidate_source,'\\tif projection.Winner.Epoch != plan.LeaseEpoch || projection.Winner.LeaseID != plan.LeaseID || projection.OwnerHostID != plan.OwnerHostID {','\\tif (projection.Winner.Epoch != plan.LeaseEpoch || projection.Winner.LeaseID != plan.LeaseID || projection.OwnerHostID != plan.OwnerHostID) && false {','Skip exactly the lease compare; a successor lease then reports the heads reason instead.')\n87|run('N-rev-heads',revalidate_source,'\\tif !equalStrings(heads, plan.AuthorityHeads) {','\\tif !equalStrings(heads, plan.AuthorityHeads) && false {','Skip exactly the heads compare; a same-lease event then reports the index reason instead.')\n88|run('N-rev-absent-substitute',revalidate_source,'\\tif absent {','\\tif absent && len(rows) > 0 {\\n\\t\\trecordID = rows[0].Projection.RecordID\\n\\t\\tplan.SessionID = rows[0].Projection.SessionID\\n\\t}\\n\\tif absent && len(rows) == 0 {','Substitute the first listed sibling for exactly a deleted selection instead of reporting its absence.')\n89|run('B-peer-order',source,'sort.Strings(ids)','sort.Sort(sort.Reverse(sort.StringSlice(ids)))','Reverse peer-source tie ordering; behavioral determinism fixture must fail.')\n90|run('B-session-order',source,'return out[i].Projection.SessionID < out[j].Projection.SessionID','return out[